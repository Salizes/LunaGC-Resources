    "talks": [
        {
            "id": "7508701",
            "objective": "魂附暝视龙，追踪奇妙的气息",
            "dialogues": []
        },
        {
            "id": "7508708",
            "objective": "到高处观察一下情况",
            "dialogues": []
        },
        {
            "id": "7508709",
            "objective": "调查附近的线索",
            "dialogues": [
                {
                    "id": "750870901",
                    "speaker": "派蒙",
                    "text": "怎么又是龙龙饼干？而且旁边的信是…"
                },
                {
                    "id": "750870902",
                    "speaker": "派蒙",
                    "text": "果然就是葵莉娅在后面捣鬼！不过没想到居然是出于这种理由…帕朗也真够倒霉的。"
                },
                {
                    "id": "750870903",
                    "speaker": "派蒙",
                    "text": "但是想到塔卢加和奥伯龙说不定就被关在前面的营地里，不管的话也有点良心难安…而且说到底，他们又没错。"
                },
                {
                    "id": "750870904",
                    "speaker": "派蒙",
                    "text": "#唔…{NICKNAME}，我们还是想办法把他们救出来吧？"
                },
                {
                    "id": "750870905",
                    "speaker": "派蒙",
                    "text": "如果能<color=#00E1FFFF>混进暝视龙的巡逻队伍</color>里，说不定能很轻松地潜入进去呢！"
                }
            ]
        },
        {
            "id": "7508702",
            "objective": "进行伪装，跟随暝视龙的巡逻队伍潜入营地",
            "dialogues": []
        },
        {
            "id": "7508703",
            "objective": "调查营地内部",
            "dialogues": [
                {
                    "id": "750870301",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀！"
                },
                {
                    "id": "750870302",
                    "speaker": "奥伯龙",
                    "text": "呜？"
                },
                {
                    "id": "750870303",
                    "speaker": "派蒙",
                    "text": "难道…难道是奥伯龙？"
                },
                {
                    "id": "750870304",
                    "speaker": "奥伯龙",
                    "text": "啊呜！"
                },
                {
                    "id": "750870305",
                    "speaker": "派蒙",
                    "text": "呃，一会儿不见，你成长了很多呢…"
                },
                {
                    "id": "750870306",
                    "speaker": "派蒙",
                    "text": "塔卢加说它容易发胖，真的一点不假。对了，他人呢？怎么没和你在一起？"
                },
                {
                    "id": "750870307",
                    "speaker": "奥伯龙",
                    "text": "呜…呜呜…"
                },
                {
                    "id": "750870308",
                    "speaker": "派蒙",
                    "text": "唔，总之先带它离开这里吧！"
                },
                {
                    "id": "750870309",
                    "speaker": "派蒙",
                    "text": "说起来，反正已经找到奥伯龙了，我们也不用东躲西藏了吧？塔卢加的下落也很叫人担心…得快些才行！"
                }
            ]
        },
        {
            "id": "7508704",
            "objective": "设法离开",
            "dialogues": []
        },
        {
            "id": "7508705",
            "objective": "击败对手",
            "dialogues": [
                {
                    "id": "750870501",
                    "speaker": "葵莉娅",
                    "text": "既然你们都找到这里了，那我也不用再扮演什么善良的商人了吧？我已经受够了和笨蛋打交道，是时候透透气了。"
                },
                {
                    "id": "750870502",
                    "speaker": "派蒙",
                    "text": "你这家伙，居然把自己干的坏事说成是别人干的！害我们被白白误会！"
                },
                {
                    "id": "750870503",
                    "speaker": "葵莉娅",
                    "text": "我是坏人，当然要干坏事。再说了，你们被那三个笨蛋误会，不正说明我的坏事干得不错？"
                },
                {
                    "id": "750870504",
                    "speaker": "葵莉娅",
                    "text": "呵呵，现在我要干更坏的事了，你们可别逃跑哦。"
                },
                {
                    "id": "750870505",
                    "speaker": "葵莉娅",
                    "text": "上吧！毛球！"
                },
                {
                    "id": "750870506",
                    "speaker": "毛球",
                    "text": "吼——"
                },
                {
                    "id": "750870507",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750870508",
                    "speaker": "Player",
                    "text": "#上吧！{REALNAME[ID(2)|SHOWHOST(true)]}！"
                },
                {
                    "id": "750870509",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}！居然要挑战比自己大得多的对手！"
                },
                {
                    "id": "750870510",
                    "speaker": "奥伯龙",
                    "text": "呜呜…"
                },
                {
                    "id": "750870511",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀呀！"
                },
                {
                    "id": "750870512",
                    "speaker": "派蒙",
                    "text": "奥伯龙没什么精神的样子，也不知道是因为和塔卢加分开而感到不安，还是单纯的龙龙饼干吃得太多…"
                },
                {
                    "id": "750870513",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}会不会是想给它打气，所以才勇敢地站出来保护我们？"
                },
                {
                    "id": "750870514",
                    "speaker": "葵莉娅",
                    "text": "这世上多得是光靠勇气无可奈何的事，比起那些虚无缥缈的东西，还是绝对的支配力更可靠。"
                },
                {
                    "id": "750870515",
                    "speaker": "葵莉娅",
                    "text": "攻击！"
                },
                {
                    "id": "750870516",
                    "speaker": "派蒙",
                    "text": "#居然！{REALNAME[ID(2)|SHOWHOST(true)]}躲过了对方的攻击！这正是嵴锋龙的特长，就算是天空的王者也拿它没有办法！",
                    "choices": [
                        {
                            "id": "750870517",
                            "text": "攻击。",
                            "response": [
                                {
                                    "id": "750870518",
                                    "speaker": "派蒙",
                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}摆出了进攻的架势！"
                                },
                                {
                                    "id": "750870530",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750870531",
                                    "speaker": "派蒙",
                                    "text": "攻击命中了！并且造成了…造成了微量伤害？"
                                },
                                {
                                    "id": "750870532",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀呀！"
                                },
                                {
                                    "id": "750870533",
                                    "speaker": "派蒙",
                                    "text": "好好，没有被对方闪避而是成功命中已经很了不起了！呼——虽然才进行了一回合，但是已经觉得很累了，怎么回事…"
                                },
                                {
                                    "id": "750870534",
                                    "speaker": "葵莉娅",
                                    "text": "那么接下来轮到我的回合了吧？攻击！"
                                },
                                {
                                    "id": "750870535",
                                    "speaker": "派蒙",
                                    "text": "#面对对手凌厉的进攻，{REALNAME[ID(2)|SHOWHOST(true)]}紧急采取防御态势！它防住了！"
                                },
                                {
                                    "id": "750870536",
                                    "speaker": "葵莉娅",
                                    "text": "居然在进攻之后又自主选择了防御，可恶的规则破坏者…"
                                },
                                {
                                    "id": "750870537",
                                    "speaker": "Player",
                                    "text": "回合制取胜的方法就是不要回合制！"
                                },
                                {
                                    "id": "750870538",
                                    "speaker": "派蒙",
                                    "text": "接下来该怎么做呢？"
                                },
                                {
                                    "id": "750870539",
                                    "speaker": "奥伯龙",
                                    "text": "…呜！"
                                },
                                {
                                    "id": "750870540",
                                    "speaker": "派蒙",
                                    "text": "欸？奥伯龙好像振作起来了？"
                                },
                                {
                                    "id": "750870541",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！呀呀！"
                                },
                                {
                                    "id": "750870542",
                                    "speaker": "派蒙",
                                    "text": "虽然听不懂这是在说什么，但是看样子，它们之间好像达成了某种默契…",
                                    "choices": [
                                        {
                                            "id": "750870543",
                                            "text": "协同攻击。",
                                            "response": [
                                                {
                                                    "id": "750870544",
                                                    "speaker": "派蒙",
                                                    "text": "哦！也让我们见识一下飞行学校明日之星的本领吧！"
                                                },
                                                {
                                                    "id": "750870552",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "750870553",
                                                    "speaker": "派蒙",
                                                    "text": "#哦！奥伯龙封住了向空中躲避的路线，再由{REALNAME[ID(2)|SHOWHOST(true)]}发起主动进攻，一次漂亮的协同攻击！"
                                                },
                                                {
                                                    "id": "750870554",
                                                    "speaker": "派蒙",
                                                    "text": "对毛球造成了不小的伤害！是打到脚了吗？想象一下脚趾撞到桌角的感受！对手看起来陷入了动摇状态，无法继续行动！",
                                                    "choices": [
                                                        {
                                                            "id": "750870555",
                                                            "text": "攻击，但是由我发起。",
                                                            "response": [
                                                                {
                                                                    "id": "750870556",
                                                                    "speaker": "派蒙",
                                                                    "text": "#虽然也是一种选择…但是难得有{REALNAME[ID(2)|SHOWHOST(true)]}表现的机会，就让给它嘛！别这么小孩子气了！"
                                                                },
                                                                {
                                                                    "id": "750870565",
                                                                    "speaker": "奥伯龙",
                                                                    "text": "呜！"
                                                                },
                                                                {
                                                                    "id": "750870566",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "呀呀！"
                                                                },
                                                                {
                                                                    "id": "750870567",
                                                                    "speaker": "派蒙",
                                                                    "text": "#嗯？{REALNAME[ID(2)|SHOWHOST(true)]}和奥伯龙好像有什么计划的样子…"
                                                                },
                                                                {
                                                                    "id": "750870568",
                                                                    "speaker": "派蒙",
                                                                    "text": "龙龙饼干！哪里来的龙龙饼干！"
                                                                },
                                                                {
                                                                    "id": "750870569",
                                                                    "speaker": "奥伯龙",
                                                                    "text": "呜！啊呜！"
                                                                },
                                                                {
                                                                    "id": "750870570",
                                                                    "speaker": "派蒙",
                                                                    "text": "难、难道是藏在翅膀下带出来的？真是只狡猾小龙…塔卢加要应付你也真的很不容易呢。"
                                                                },
                                                                {
                                                                    "id": "750870571",
                                                                    "speaker": "奥伯龙",
                                                                    "text": "呜呜…"
                                                                },
                                                                {
                                                                    "id": "750870572",
                                                                    "speaker": "葵莉娅",
                                                                    "text": "现在还不是时候！喂！停下！"
                                                                },
                                                                {
                                                                    "id": "750870573",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯？毛球无视了指令，径直朝龙龙饼干走去！恢复5点体力的诱惑实在太大了！"
                                                                },
                                                                {
                                                                    "id": "750870574",
                                                                    "speaker": "派蒙",
                                                                    "text": "它没有察觉到！真正被放上餐碟的龙龙就是它自己！"
                                                                },
                                                                {
                                                                    "id": "750870575",
                                                                    "speaker": "Black Screen",
                                                                    "text": "#总而言之，之后也进行了如此这般你来我往的战斗。\\n{REALNAME[ID(2)|SHOWHOST(true)]}自然是表现得十分英勇，像是要证明自己，虽然不能在飞行学校取得优秀学员的称号，也能靠其他本领为伙伴派上用场。\\n令人意外的是，就连奥伯龙在体重上的意外成长也并非没有作用，靠着较普通小绒翼龙稍大的体型，成功封锁了空中的战场，并且对毛球进行了沉重的打击…"
                                                                },
                                                                {
                                                                    "id": "750870576",
                                                                    "speaker": "Black Screen",
                                                                    "text": "葵莉娅本人似乎并没有任何战斗能力，在毛球丧失战意后，她也不得不退场。\\n「可恶的规则破坏者，下次…下次我不会让你赢得这么轻松！给我洗干净脖子等着吧！」\\n说完廉价反派退场时一定要说的台词后，带着负伤的毛球逃跑了。"
                                                                },
                                                                {
                                                                    "id": "750870577",
                                                                    "speaker": "派蒙",
                                                                    "text": "哎呀！刚才忘记问她塔卢加在哪里了…"
                                                                },
                                                                {
                                                                    "id": "750870578",
                                                                    "speaker": "奥伯龙",
                                                                    "text": "呜呜…"
                                                                },
                                                                {
                                                                    "id": "750870579",
                                                                    "speaker": "派蒙",
                                                                    "text": "哇，你先别难过，塔卢加那么聪明，肯定不会有事的！"
                                                                },
                                                                {
                                                                    "id": "750870580",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "呀！呀呀！"
                                                                },
                                                                {
                                                                    "id": "750870581",
                                                                    "speaker": "派蒙",
                                                                    "text": "#嗯嗯，{REALNAME[ID(2)|SHOWHOST(true)]}也是这么觉得的，对不对？现在我们先把奥伯龙送回飞行学校吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750870557",
                                                            "text": "说服对方投降。",
                                                            "response": [
                                                                {
                                                                    "id": "750870558",
                                                                    "speaker": "派蒙",
                                                                    "text": "如果光靠对话就能解决问题，这个世界上为什么还会有这么多纷争？"
                                                                },
                                                                {
                                                                    "id": "750870559",
                                                                    "speaker": "派蒙",
                                                                    "text": "咳…我的意思是，成功的概率应该很低啦。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750870560",
                                                            "text": "使用神奇道具收服。",
                                                            "response": [
                                                                {
                                                                    "id": "750870561",
                                                                    "speaker": "派蒙",
                                                                    "text": "？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750870562",
                                                            "text": "趁现在逃跑吧！",
                                                            "response": [
                                                                {
                                                                    "id": "750870563",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "呜…呜呜…"
                                                                },
                                                                {
                                                                    "id": "750870564",
                                                                    "speaker": "派蒙",
                                                                    "text": "#哇，{REALNAME[ID(2)|SHOWHOST(true)]}都泄气了！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750870545",
                                            "text": "防御。",
                                            "response": [
                                                {
                                                    "id": "750870546",
                                                    "speaker": "派蒙",
                                                    "text": "明明是二对一却选择防御，对方应该也不能同时攻击到两个对象，这不是会浪费掉一个回合吗？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750870547",
                                            "text": "道具。",
                                            "response": [
                                                {
                                                    "id": "750870548",
                                                    "speaker": "派蒙",
                                                    "text": "使用龙龙饼干恢复了5点体力！"
                                                },
                                                {
                                                    "id": "750870549",
                                                    "speaker": "派蒙",
                                                    "text": "…根本没这种必要吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750870550",
                                            "text": "逃跑。",
                                            "response": [
                                                {
                                                    "id": "750870551",
                                                    "speaker": "派蒙",
                                                    "text": "现在明明形势大好，你怎么还惦记着逃跑啊！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750870519",
                            "text": "防御。",
                            "response": [
                                {
                                    "id": "750870520",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜…呀！"
                                },
                                {
                                    "id": "750870521",
                                    "speaker": "派蒙",
                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}似乎认为防御的策略太过保守，会浪费大好机会，于是摆出了进攻的架势！"
                                }
                            ]
                        },
                        {
                            "id": "750870522",
                            "text": "道具。",
                            "response": [
                                {
                                    "id": "750870523",
                                    "speaker": "派蒙",
                                    "text": "我们哪有可以现在用的道具啊！就算是想要设置捕兽夹也太晚了吧？"
                                },
                                {
                                    "id": "750870524",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜…呀！"
                                },
                                {
                                    "id": "750870525",
                                    "speaker": "派蒙",
                                    "text": "#哦！{REALNAME[ID(2)|SHOWHOST(true)]}摆出了进攻的架势！"
                                }
                            ]
                        },
                        {
                            "id": "750870526",
                            "text": "逃跑。",
                            "response": [
                                {
                                    "id": "750870527",
                                    "speaker": "派蒙",
                                    "text": "现在不是逃跑的时候吧！"
                                },
                                {
                                    "id": "750870528",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呜呜…呀！"
                                },
                                {
                                    "id": "750870529",
                                    "speaker": "派蒙",
                                    "text": "#就连{REALNAME[ID(2)|SHOWHOST(true)]}都知道呢，看，它摆出了进攻的架势！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7508706",
            "objective": "返回飞行学校",
            "dialogues": []
        },
        {
            "id": "7508707",
            "objective": "与塔卢加对话",
            "dialogues": [
                {
                    "id": "750870701",
                    "speaker": "派蒙",
                    "text": "欸？塔卢加！你已经回来了！"
                },
                {
                    "id": "750870702",
                    "speaker": "塔卢加",
                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}！幸好你们也没事…我已经向姐姐他们说明情况了，拉密萨纳就跟我想的一样，是个笨蛋…"
                },
                {
                    "id": "750870703",
                    "speaker": "奥伯龙",
                    "text": "啊呜…"
                },
                {
                    "id": "750870704",
                    "speaker": "塔卢加",
                    "text": "是啊，比你还要笨呢！"
                },
                {
                    "id": "750870705",
                    "speaker": "奥伯龙",
                    "text": "呜呜…"
                },
                {
                    "id": "750870706",
                    "speaker": "派蒙",
                    "text": "#好啦好啦，它和你分开这么久肯定也很不安。而且刚才它和{REALNAME[ID(2)|SHOWHOST(true)]}的配合也很不错呢！"
                },
                {
                    "id": "750870707",
                    "speaker": "Player",
                    "text": "还有教化的余地。"
                },
                {
                    "id": "750870708",
                    "speaker": "派蒙",
                    "text": "嗯，它还是只小龙嘛，只要塔卢加好好和它相处，之后肯定能成长为一只出色的绒翼龙！"
                },
                {
                    "id": "750870709",
                    "speaker": "奥伯龙",
                    "text": "呜！"
                },
                {
                    "id": "750870710",
                    "speaker": "派蒙",
                    "text": "说起来你是怎么回来的？是其他人找到你，先把你救出来了吗？"
                },
                {
                    "id": "750870711",
                    "speaker": "塔卢加",
                    "text": "我是自己逃出来的。本来想带奥伯龙一起走，但它贪吃龙龙饼干，怎么劝都不肯动，我太生气了就自己一个人走了。"
                },
                {
                    "id": "750870712",
                    "speaker": "派蒙",
                    "text": "欸？这么容易吗？"
                },
                {
                    "id": "750870713",
                    "speaker": "塔卢加",
                    "text": "摸清看守龙的行动路线之后，我发现还是有可趁之机，很顺利就逃出来了。"
                },
                {
                    "id": "750870714",
                    "speaker": "派蒙",
                    "text": "搞不好塔卢加才是这里最可靠的一个…"
                },
                {
                    "id": "750870715",
                    "speaker": "拉密萨纳",
                    "text": "你们怎么来了！我正准备去找那个骗子算账…还有、还有向你们正式道歉…是我太武断了，险些诬陷了好人。",
                    "choices": [
                        {
                            "id": "750870716",
                            "text": "太晚了。",
                            "response": [
                                {
                                    "id": "750870717",
                                    "speaker": "派蒙",
                                    "text": "就是！事情都结束了才现身，不是抢功又是什么？"
                                },
                                {
                                    "id": "750870720",
                                    "speaker": "拉密萨纳",
                                    "text": "我无话可说。之前约定的报酬也好现在的赔偿也好，我都不会吝啬。对了，如果这样能让你们解气，给我一拳也行！"
                                },
                                {
                                    "id": "750870721",
                                    "speaker": "拉密萨纳",
                                    "text": "我也是个男子汉，该负责任的时候不会推脱。",
                                    "choices": [
                                        {
                                            "id": "750870722",
                                            "text": "#让{REALNAME[ID(2)|SHOWHOST(true)]}给你一拳。",
                                            "response": [
                                                {
                                                    "id": "750870723",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "750870726",
                                                    "speaker": "拉密萨纳",
                                                    "text": "好痛！还没挨到但是已经觉得很痛了！唯独这点还请高抬贵手…也请高抬贵脚！"
                                                },
                                                {
                                                    "id": "750870727",
                                                    "speaker": "派蒙",
                                                    "text": "刚才还说自己是男子汉不会推脱呢，真是没出息啊。"
                                                },
                                                {
                                                    "id": "750870728",
                                                    "speaker": "派蒙",
                                                    "text": "#算了，我们也不是这么小心眼的人物，对吧，{NICKNAME}，{REALNAME[ID(2)|SHOWHOST(true)]}？"
                                                },
                                                {
                                                    "id": "750870729",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "750870730",
                                                    "speaker": "拉密萨纳",
                                                    "text": "感谢你们的宽容，飞行学校…呃虽然没有大门，但是还请意会一下，大门随时向你们敞开。"
                                                },
                                                {
                                                    "id": "750870731",
                                                    "speaker": "塔卢加",
                                                    "text": "#嗯，看到你们和{REALNAME[ID(2)|SHOWHOST(true)]}关系这么好，我也想要请教和小龙融洽相处的诀窍呢！"
                                                },
                                                {
                                                    "id": "750870732",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，好喔，如果之后有空的话，我们会再来的！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750870724",
                                            "text": "#让{REALNAME[ID(2)|SHOWHOST(true)]}踢你脚趾。",
                                            "response": [
                                                {
                                                    "id": "750870725",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750870718",
                            "text": "我要申请赔偿金！还有参与奖。",
                            "response": [
                                {
                                    "id": "750870719",
                                    "speaker": "派蒙",
                                    "text": "原来你还记得参与奖啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7508712",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750871221",
                    "speaker": "<UNKNOWN>",
                    "text": "在被发现之前小心地退回到之前的位置，下次要更加谨慎一些…"
                }
            ]
        },
        {
            "id": "7508759",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750875901",
                    "speaker": "特马乔",
                    "text": "我们这儿还有几项飞行挑战，具体内容都写在告示牌上了，如果你感兴趣不妨试试，当然也会有对应的奖励。",
                    "choices": [
                        {
                            "id": "750875902",
                            "text": "关于帕帕卡飞行学校…",
                            "response": [
                                {
                                    "id": "750875903",
                                    "speaker": "特马乔",
                                    "text": "其实我也不知道为什么会叫这个名字，说起帕帕卡…你听过昆图尔和坏巫师茹米的故事吗？"
                                },
                                {
                                    "id": "750875904",
                                    "speaker": "特马乔",
                                    "text": "部族的战士输给了坏巫师茹米，被他变成了帕帕卡…听起来好像不是什么好事？可能帕帕卡真的飞得很快吧，谁知道呢。"
                                }
                            ]
                        },
                        {
                            "id": "750875905",
                            "text": "关于拉密萨纳…",
                            "response": [
                                {
                                    "id": "750875906",
                                    "speaker": "特马乔",
                                    "text": "哈哈…他是个好手，但不擅长教人。当飞行竞赛的对手…还算说得过去？"
                                },
                                {
                                    "id": "750875907",
                                    "speaker": "特马乔",
                                    "text": "要不是飞得不好，谁会来这里呢？这时候如果太过严厉…唉，以前可不是没发生过这种事。"
                                },
                                {
                                    "id": "750875908",
                                    "speaker": "特马乔",
                                    "text": "所以现在的方针已经改成鼓励为主了，相信多夸夸也能有进步的。"
                                }
                            ]
                        },
                        {
                            "id": "750875909",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "750875910",
                                    "speaker": "特马乔",
                                    "text": "再见，也欢迎你随时回来。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7508763",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750876301",
                    "speaker": "琪希可",
                    "text": "欢迎来到帕帕卡飞行学校！",
                    "choices": [
                        {
                            "id": "750876302",
                            "text": "你在这里做什么？",
                            "response": [
                                {
                                    "id": "750876304",
                                    "speaker": "琪希可",
                                    "text": "给学员必要的指引和帮助。现在和以前可真不一样了，要知道以前可是没有这些贴心的服务的。"
                                },
                                {
                                    "id": "750876305",
                                    "speaker": "琪希可",
                                    "text": "但是有一次因为教练在指导时言辞有些…严厉？偏偏那个学员也是个脾气火爆的人物…唉，当时的场面我都不愿再提。"
                                },
                                {
                                    "id": "750876306",
                                    "speaker": "琪希可",
                                    "text": "总之自那之后飞行学校就改变了指导的方针。伸手不打笑脸人，谁也不会讨厌被夸吧？"
                                }
                            ]
                        },
                        {
                            "id": "750876303",
                            "text": "先走了。",
                            "response": [
                                {
                                    "id": "750876307",
                                    "speaker": "琪希可",
                                    "text": "祝你度过愉快的一天！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}