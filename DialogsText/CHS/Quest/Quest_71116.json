    "talks": [
        {
            "id": "7111601",
            "objective": "协助击退来犯者$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7111602",
            "objective": "与铁豆儿交谈",
            "dialogues": [
                {
                    "id": "711160202",
                    "speaker": "铁豆儿",
                    "text": "合字上的朋友，大恩不讲谢，有什么需要的，招呼一声就成！"
                },
                {
                    "id": "711160203",
                    "speaker": "派蒙",
                    "text": "喔！你这个人还怪客气的。",
                    "choices": [
                        {
                            "id": "711160204",
                            "text": "那我就直说了，最近手头有点紧。",
                            "response": [
                                {
                                    "id": "711160205",
                                    "speaker": "铁豆儿",
                                    "text": "需要摩拉？哈哈，这倒是好说。就是办起来还有点小小的麻烦——"
                                },
                                {
                                    "id": "711160206",
                                    "speaker": "铁豆儿",
                                    "text": "俺们的摩拉，全被瓢把子带走了。现在这土窝已经成黄草窑子了。"
                                },
                                {
                                    "id": "711160210",
                                    "speaker": "Player",
                                    "text": "瓢把子？"
                                },
                                {
                                    "id": "711160211",
                                    "speaker": "铁豆儿",
                                    "text": "就是俺们铁盐帮的老大，他在那边的山崖底下，跟一伙枫丹佬走砂，留下俺们守着窝。"
                                },
                                {
                                    "id": "711160212",
                                    "speaker": "铁豆儿",
                                    "text": "但是刚刚朋友也瞧见了吧？那些枫丹皮娃子，居然趁着瓢把子在谈事儿，偷偷摸了来，捅屁股！"
                                },
                                {
                                    "id": "711160213",
                                    "speaker": "派蒙",
                                    "text": "呜哇…捅屁股…！"
                                },
                                {
                                    "id": "711160214",
                                    "speaker": "Player",
                                    "text": "呜哇…！"
                                },
                                {
                                    "id": "711160215",
                                    "speaker": "铁豆儿",
                                    "text": "好崽子，这是把俺们当羊牯了？"
                                },
                                {
                                    "id": "711160216",
                                    "speaker": "铁豆儿",
                                    "text": "现在这边水漫了，瓢把子指不定也要吃暗青子。好朋友，话说帮人帮到底，还请再帮俺们一把？"
                                },
                                {
                                    "id": "711160217",
                                    "speaker": "铁豆儿",
                                    "text": "若瓢把子没事，保准有你们吃香喝辣。"
                                },
                                {
                                    "id": "711160218",
                                    "speaker": "Player",
                                    "text": "在哪里？我先去看看。"
                                },
                                {
                                    "id": "711160219",
                                    "speaker": "铁豆儿",
                                    "text": "就在那边山崖底下的海滩，你们过去指定能瞧见。"
                                },
                                {
                                    "id": "711160220",
                                    "speaker": "铁豆儿",
                                    "text": "两位朋友，托你们先走一步，俺收拾收拾就来。"
                                }
                            ]
                        },
                        {
                            "id": "711160207",
                            "text": "路见不平，拔刀相助而已。",
                            "response": [
                                {
                                    "id": "711160208",
                                    "speaker": "铁豆儿",
                                    "text": "义薄云天！义薄云天啊！既然这样，两位朋友，俺正好有个事儿想说说。"
                                },
                                {
                                    "id": "711160209",
                                    "speaker": "铁豆儿",
                                    "text": "俺觉得瓢把子那边，搞不好也得遭事，得去帮忙。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7111603",
            "objective": "前往山崖下的海滩",
            "dialogues": []
        },
        {
            "id": "7111604",
            "objective": "介入双方的交谈",
            "dialogues": [
                {
                    "id": "711160401",
                    "speaker": "铁明",
                    "text": "尊尼老大，你我朋友一场，我呢，也明白你们近来有难处。"
                },
                {
                    "id": "711160402",
                    "speaker": "铁明",
                    "text": "有什么问题当面和我商量就好，搞成这样…未免有点伤感情了吧？"
                },
                {
                    "id": "711160403",
                    "speaker": "尊尼",
                    "text": "嘿，朋友…你知道，我们这边的生意不同往常了。「刺玫会」近来得了势，我们的兄弟颇有些成了干货，落了水…"
                },
                {
                    "id": "711160404",
                    "speaker": "尊尼",
                    "text": "小鸟儿们都还嗷嗷待哺呢。再这样下去，我们恐怕连鸟嘴都沾不湿了…"
                },
                {
                    "id": "711160405",
                    "speaker": "尊尼",
                    "text": "我们的生意很好，很合理，如果多给我们一点…将来感谢的机会，我想朋友们会更能体会到我的诚意。"
                },
                {
                    "id": "711160406",
                    "speaker": "尊尼",
                    "text": "不然…哈哈，大海这样广阔，铁明先生，你们也不是不好找到新朋友！"
                },
                {
                    "id": "711160407",
                    "speaker": "铁明",
                    "text": "这样说，尊尼老大，这个报价，就是你的意思了？"
                },
                {
                    "id": "711160408",
                    "speaker": "尊尼",
                    "text": "这样的价格有什么问题吗？"
                },
                {
                    "id": "711160409",
                    "speaker": "铁船儿",
                    "text": "枫丹佬！招子放亮点！这点钱打发谁呢？！放那么多的屁干什么！"
                },
                {
                    "id": "711160410",
                    "speaker": "铁明",
                    "text": "多嘴！"
                },
                {
                    "id": "711160411",
                    "speaker": "铁明",
                    "text": "尊尼老大，我的货卖给唐佩西家族，一箱五万八。卖给德尼禄家族，一箱七万。他们都是柔灯港地下响当当的帮会，这不必我说。"
                },
                {
                    "id": "711160412",
                    "speaker": "铁明",
                    "text": "我的货卖给你，三箱只要十万，专人接，专人送…为什么？为的是珍惜你这个朋友。"
                },
                {
                    "id": "711160413",
                    "speaker": "铁明",
                    "text": "大道理我就不多说了…我相信尊尼老大还是欠考虑了！我们找个地方喝一杯，再聊聊怎么样！"
                },
                {
                    "id": "711160414",
                    "speaker": "尊尼",
                    "text": "呵呵，没那个必要。我知道璃月人最讲究契约，契约最在乎公平。可没听说过情理能大于公平的说法。"
                },
                {
                    "id": "711160415",
                    "speaker": "铁明",
                    "text": "呵呵，尊尼老大！如此注重契约精神，我的小弟们也该多多向你学习，哈哈！"
                },
                {
                    "id": "711160416",
                    "speaker": "铁明",
                    "text": "只不过，在这件事上，我要首先看到你们对契约的尊重。"
                },
                {
                    "id": "711160417",
                    "speaker": "尊尼",
                    "text": "当然，当然！您的话再有道理不过了，璃月的古老契约真是令人崇敬，看来我必须要展示一下我的敬意。"
                },
                {
                    "id": "711160418",
                    "speaker": "尊尼",
                    "text": "沃克，你觉得给每件货的报价再提高…一摩拉，怎么样？"
                },
                {
                    "id": "711160419",
                    "speaker": "沃克",
                    "text": "十分恰当，尊尼先生。这些璃月人如此辛劳，理应再获得每件货一摩拉的报酬。"
                },
                {
                    "id": "711160420",
                    "speaker": "铁船儿",
                    "text": "枫丹佬！你们到底什么意思？！"
                },
                {
                    "id": "711160421",
                    "speaker": "尊尼",
                    "text": "朋友，你们还感受不到这份远道而来的诚意吗？"
                },
                {
                    "id": "711160422",
                    "speaker": "铁明",
                    "text": "尊尼老大，你们这是执意要违背约定了？"
                },
                {
                    "id": "711160423",
                    "speaker": "尊尼",
                    "text": "哦？是吗？沃克，你觉得是这样吗？"
                },
                {
                    "id": "711160424",
                    "speaker": "沃克",
                    "text": "尊尼先生，若您问我的意思…大海如此广阔，是虾米就该有点自知之明。"
                },
                {
                    "id": "711160425",
                    "speaker": "尊尼",
                    "text": "沃克，我为你羞愧，你怎能如此侮辱我们的璃月朋友？"
                },
                {
                    "id": "711160426",
                    "speaker": "尊尼",
                    "text": "毕竟稍后就要收下他们的地盘，我们不该心怀感恩吗？"
                },
                {
                    "id": "711160427",
                    "speaker": "沃克",
                    "text": "对不起，尊尼先生。"
                },
                {
                    "id": "711160428",
                    "speaker": "铁船儿",
                    "text": "你们！混账东西！你们居然打着这个主意…"
                },
                {
                    "id": "711160429",
                    "speaker": "Player",
                    "text": "怎么还骂起人了？"
                },
                {
                    "id": "711160430",
                    "speaker": "尊尼",
                    "text": "哦？这两位小朋友是…？"
                },
                {
                    "id": "711160431",
                    "speaker": "尊尼",
                    "text": "呵呵，可真是有趣啊，璃月的小朋友都这么有胆色吗？沃克。"
                },
                {
                    "id": "711160432",
                    "speaker": "沃克",
                    "text": "喂！哪来的小鬼，赏你们点摩拉，赶紧滚去买奶喝吧！"
                },
                {
                    "id": "711160433",
                    "speaker": "派蒙",
                    "text": "你！你们这些人也太没礼貌了吧？"
                },
                {
                    "id": "711160434",
                    "speaker": "铁明",
                    "text": "你们两位是…？",
                    "choices": [
                        {
                            "id": "711160435",
                            "text": "我们是来吃香喝辣的。",
                            "response": [
                                {
                                    "id": "711160437",
                                    "speaker": "尊尼",
                                    "text": "哈哈哈哈！这样说来…你们是铁明先生请来的帮手了？"
                                },
                                {
                                    "id": "711160438",
                                    "speaker": "尊尼",
                                    "text": "原来铁明先生也早就对我们有想法了啊？哼，我们也不是毫无准备。沃克！"
                                },
                                {
                                    "id": "711160439",
                                    "speaker": "沃克",
                                    "text": "出来吧！兄弟们！到时候了！"
                                },
                                {
                                    "id": "711160440",
                                    "speaker": "铁船儿",
                                    "text": "什么？！"
                                },
                                {
                                    "id": "711160441",
                                    "speaker": "尊尼",
                                    "text": "哎呀，哎呀，怎么回事？好像还是我们的人比较多呢。"
                                },
                                {
                                    "id": "711160442",
                                    "speaker": "尊尼",
                                    "text": "铁明先生，真遗憾，我事先给手下安排了一些活，现在您留在营地的人，应该已经被清理干净了。"
                                },
                                {
                                    "id": "711160443",
                                    "speaker": "尊尼",
                                    "text": "请安心的去吧，您的生意我们会好好打理的。"
                                },
                                {
                                    "id": "711160444",
                                    "speaker": "铁明",
                                    "text": "尊尼老大…想淌我们铁盐帮的线，没那么简单！"
                                },
                                {
                                    "id": "711160445",
                                    "speaker": "尊尼",
                                    "text": "希望您的命和嘴一样硬，动手！"
                                }
                            ]
                        },
                        {
                            "id": "711160436",
                            "text": "我们是来送某些人回家喝奶的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7111605",
            "objective": "击败尊尼",
            "dialogues": []
        },
        {
            "id": "7111606",
            "objective": "与铁明交谈",
            "dialogues": [
                {
                    "id": "711160601",
                    "speaker": "铁明",
                    "text": "两位豪侠！多谢了！"
                },
                {
                    "id": "711160602",
                    "speaker": "派蒙",
                    "text": "不用谢不用谢！不管在哪里交易，都要遵守契约才行！"
                },
                {
                    "id": "711160603",
                    "speaker": "铁明",
                    "text": "呵呵，这位小豪侠说的是。不过这样看，两位似乎对我们的交易很清楚嘛。"
                },
                {
                    "id": "711160604",
                    "speaker": "派蒙",
                    "text": "是铁豆儿告诉我们的啦，她说你们在这里走砂什么的…"
                },
                {
                    "id": "711160605",
                    "speaker": "派蒙",
                    "text": "不过走砂是什么意思？"
                },
                {
                    "id": "711160606",
                    "speaker": "Player",
                    "text": "好像不是什么正规的交易。"
                },
                {
                    "id": "711160607",
                    "speaker": "铁明",
                    "text": "既然这样，那我必须得要好好感谢两位豪侠了。"
                },
                {
                    "id": "711160608",
                    "speaker": "铁明",
                    "text": "来人！把他们绑好咯，丢去海里！"
                },
                {
                    "id": "711160609",
                    "speaker": "铁明",
                    "text": "记得多绑几块石头，这两位对我们铁盐帮有恩，别叫他们多遭了罪！"
                },
                {
                    "id": "711160610",
                    "speaker": "派蒙",
                    "text": "什么？！你…你要对我们做什么？"
                },
                {
                    "id": "711160611",
                    "speaker": "铁明",
                    "text": "这位小豪侠，你刚才不是还很明白吗？璃月是讲究契约的国度。"
                },
                {
                    "id": "711160612",
                    "speaker": "铁明",
                    "text": "撞破了非法团伙的交易，自然就会被灭口，这不是人尽皆知的契约吗？"
                },
                {
                    "id": "711160613",
                    "speaker": "派蒙",
                    "text": "哪有这种契约啊！你这种恩将仇报才是不讲契约！！"
                },
                {
                    "id": "711160614",
                    "speaker": "铁明",
                    "text": "不要白白浪费我的好意，等我亲自动手，你们就有苦头吃了。",
                    "choices": [
                        {
                            "id": "711160615",
                            "text": "你知道我是谁吗？",
                            "response": [
                                {
                                    "id": "711160617",
                                    "speaker": "铁明",
                                    "text": "少废话！铁豆儿！铁船儿！还不动手？！"
                                },
                                {
                                    "id": "711160618",
                                    "speaker": "铁船儿",
                                    "text": "铁明老大，你果然还是这么不仁不义啊。"
                                },
                                {
                                    "id": "711160619",
                                    "speaker": "铁豆儿",
                                    "text": "也不枉我们费一番功夫，绝对不能再放你这样的人在璃月为非作歹了。"
                                },
                                {
                                    "id": "711160626",
                                    "speaker": "铁豆儿",
                                    "text": "收网！"
                                },
                                {
                                    "id": "711160620",
                                    "speaker": "铁明",
                                    "text": "什…什么？"
                                },
                                {
                                    "id": "711160621",
                                    "speaker": "铁豆儿",
                                    "text": "贼人铁明！睁大你的眼睛再好好看看！我们是谁？！"
                                },
                                {
                                    "id": "711160622",
                                    "speaker": "铁明",
                                    "text": "千…千岩军？！"
                                },
                                {
                                    "id": "711160623",
                                    "speaker": "派蒙",
                                    "text": "喂喂！怎么回事？！怎么突然…"
                                },
                                {
                                    "id": "711160624",
                                    "speaker": "铁明",
                                    "text": "我只当你们几个是新上了跳板，没想到是该死的鹰爪孙…"
                                },
                                {
                                    "id": "711160625",
                                    "speaker": "铁明",
                                    "text": "别以为我会束手就擒！我跟你们拼了！"
                                }
                            ]
                        },
                        {
                            "id": "711160616",
                            "text": "喔唷！我好怕怕！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7111607",
            "objective": "击败铁明",
            "dialogues": []
        },
        {
            "id": "7111608",
            "objective": "与千岩军交谈",
            "dialogues": [
                {
                    "id": "711160801",
                    "speaker": "铁船儿",
                    "text": "真是不虚此行！没想到这次行动既抓到了人，还遇见了大名鼎鼎的旅行者。"
                },
                {
                    "id": "711160802",
                    "speaker": "Player",
                    "text": "你们认识我们啊？"
                },
                {
                    "id": "711160803",
                    "speaker": "铁豆儿",
                    "text": "那当然，旅行者，我有亲戚住在璃月港，你们的事我都听了好多遍呢，所以前面一早就认出你们了。"
                },
                {
                    "id": "711160804",
                    "speaker": "铁豆儿",
                    "text": "只不过那时候人多口杂，我怕走漏风声，让这伙人跑了。所以没有明说，真是不好意思啦。"
                },
                {
                    "id": "711160805",
                    "speaker": "派蒙",
                    "text": "原来我们不是撞上了非法团伙的交易，而是撞上了千岩军抓坏蛋的行动啊！"
                },
                {
                    "id": "711160806",
                    "speaker": "铁船儿",
                    "text": "哈哈，没错，我们盯上这伙私自贩盐的家伙有一阵子了，前阵子恰好得到帮助，才成功打入了内部。"
                },
                {
                    "id": "711160807",
                    "speaker": "铁船儿",
                    "text": "差不多等了一个多月呢，今天终于等到机会，把这伙铁盐帮和枫丹那边的大鱼一网捞上来。"
                },
                {
                    "id": "711160808",
                    "speaker": "铁豆儿",
                    "text": "别说了，前面差点还被大鱼拖下了水，那伙人下手真黑，多亏了旅行者来帮忙。"
                },
                {
                    "id": "711160809",
                    "speaker": "铁豆儿",
                    "text": "总而言之，旅行者，前面答应你们吃香的喝辣的，可能没法兑现了，但是这里有一些摩拉，请你们收好。"
                },
                {
                    "id": "711160810",
                    "speaker": "铁豆儿",
                    "text": "不用推脱哦，两位。帮助别人就该得到回报，大家都要遵守这条契约才行。否则未来愿意伸出援手的人会越来越少。"
                },
                {
                    "id": "711160811",
                    "speaker": "铁船儿",
                    "text": "好了，我们也该去处理剩下的事了，就不再耽误两位时间了。"
                },
                {
                    "id": "711160812",
                    "speaker": "铁船儿",
                    "text": "祝你们前路顺利！"
                }
            ]
        },
        {
            "id": "7111651",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711165101",
                    "speaker": "铁豆儿",
                    "text": "芽儿们！给俺扒了这些皮娃子的衣裳！大通衫、小罗考，一件不留！"
                }
            ]
        },
        {
            "id": "7111652",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711165201",
                    "speaker": "铁船儿",
                    "text": "旅行者！你们也来了啊。"
                },
                {
                    "id": "711165202",
                    "speaker": "铁豆儿",
                    "text": "你们放心吧，后事我们会处理好的，不会再让这些歹徒危害璃月了。"
                }
            ]
        },
        {
            "id": "7111653",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711165301",
                    "speaker": "青夜",
                    "text": "给我的这件好像不太合身啊…"
                },
                {
                    "id": "711165302",
                    "speaker": "红鱼",
                    "text": "哪那么多事，我这件这么臭不是照样穿了？"
                },
                {
                    "id": "711165303",
                    "speaker": "红鱼",
                    "text": "赶紧的！这些盗宝团的衣服没你想的那么好弄，别挑三拣四了。"
                }
            ]
        },
        {
            "id": "7111654",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711165401",
                    "speaker": "凌霄",
                    "text": "最近此地不太平，往来旅客请绕行。"
                },
                {
                    "id": "711165402",
                    "speaker": "Player",
                    "text": "离开"
                }
            ]
        },
        {
            "id": "7111656",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711165601",
                    "speaker": "毅钧",
                    "text": "依照那个商人的消息，应该就是最近几天了。"
                },
                {
                    "id": "711165602",
                    "speaker": "Player",
                    "text": "最近几天怎么了？"
                },
                {
                    "id": "711165603",
                    "speaker": "毅钧",
                    "text": "咦？你们两位…？抱歉，没什么，只是一些…商会里的小事。"
                },
                {
                    "id": "711165604",
                    "speaker": "毅钧",
                    "text": "你们应该是旅客吧？沉玉谷风光很不错，你们来了个好地方。"
                },
                {
                    "id": "711165605",
                    "speaker": "毅钧",
                    "text": "去别处看看如何，可别在这种犄角旮旯浪费了大好时光啊，哈哈。"
                }
            ]
        },
        {
            "id": "7111660",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711166001",
                    "speaker": "铁船儿",
                    "text": "两位朋友，你们是来游览风景的吗？"
                },
                {
                    "id": "711166002",
                    "speaker": "铁船儿",
                    "text": "这附近没什么可看的，我建议你们去别处转转。"
                }
            ]
        },
        {
            "id": "7111661",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711166101",
                    "speaker": "铁锤儿",
                    "text": "嗯…？唔…？啊…？你们俩有点面生啊…是不是小偷？"
                },
                {
                    "id": "711166102",
                    "speaker": "铁锤儿",
                    "text": "不递个门坎，我可要喊人了啊…"
                }
            ]
        },
        {
            "id": "7111662",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711166201",
                    "speaker": "铁瓜儿",
                    "text": "走走走，走远点！"
                },
                {
                    "id": "711166202",
                    "speaker": "铁瓜儿",
                    "text": "这场子有人包了，别来凑热闹。"
                }
            ]
        },
        {
            "id": "7111690",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711169001",
                    "speaker": "派蒙",
                    "text": "哎呀！那边是怎么回事？好像有人打起来了！"
                }
            ]
        },
        {
            "id": "7111691",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711169101",
                    "speaker": "派蒙",
                    "text": "快看！那个海滩有好多人啊！"
                },
                {
                    "id": "711169102",
                    "speaker": "派蒙",
                    "text": "一定就是铁豆儿的瓢把子他们！"
                }
            ]
        },
        {
            "id": "7111693",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711169301",
                    "speaker": "铁扇儿",
                    "text": "水漫来咧！叫鞭土咧！"
                }
            ]
        },
        {
            "id": "7111694",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711169401",
                    "speaker": "铁门儿",
                    "text": "该死的枫丹小指会，不讲规矩！快来人去通知瓢把子！事情有诈！"
                }
            ]
        },
        {
            "id": "7111695",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711169501",
                    "speaker": "毅钧",
                    "text": "依照消息…"
                },
                {
                    "id": "711169502",
                    "speaker": "铁扇儿",
                    "text": "水漫来咧…"
                }
            ]
        },
        {
            "id": "7111699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "711169905",
                    "speaker": "派蒙",
                    "text": "快看！那个海滩有好多人啊！"
                },
                {
                    "id": "711169906",
                    "speaker": "派蒙",
                    "text": "一定就是铁豆儿的瓢把子他们！"
                }
            ]
        }
    ]
}