    "talks": [
        {
            "id": "7015301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "701530101",
                    "speaker": "戴帽子的霜精",
                    "text": "呀吼！呀吼！"
                },
                {
                    "id": "701530102",
                    "speaker": "派蒙",
                    "text": "哦…这家伙还举着个牌子，让我看看上面写了什么？"
                },
                {
                    "id": "701530103",
                    "speaker": "戴帽子的霜精",
                    "text": "「帽子，游戏，玩？」"
                },
                {
                    "id": "701530104",
                    "speaker": "派蒙",
                    "text": "嗯，这应该也是余兴活动之一吧…像是什么和帽子有关的游戏？"
                },
                {
                    "id": "701530105",
                    "speaker": "派蒙",
                    "text": "难道是要把一顶顶帽子都戴在头上的游戏吗？"
                },
                {
                    "id": "701530106",
                    "speaker": "Player",
                    "text": "听上去可真是危险啊…"
                },
                {
                    "id": "701530107",
                    "speaker": "派蒙",
                    "text": "什么危险？你应该是在说…帽子叠起来很高，掉落时砸到人很危险的意思吧…"
                },
                {
                    "id": "701530108",
                    "speaker": "戴帽子的霜精",
                    "text": "呀吼？"
                },
                {
                    "id": "701530109",
                    "speaker": "派蒙",
                    "text": "看上去好像不是这样玩的，真是让人松了一口气。"
                },
                {
                    "id": "701530110",
                    "speaker": "派蒙",
                    "text": "可是，那应该是怎么玩的呢？"
                },
                {
                    "id": "701530111",
                    "speaker": "戴帽子的霜精",
                    "text": "「霜精跑，人类抓！」"
                },
                {
                    "id": "701530112",
                    "speaker": "派蒙",
                    "text": "呃…霜精跑…然后我们来抓？"
                },
                {
                    "id": "701530113",
                    "speaker": "戴帽子的霜精",
                    "text": "呀吼呀吼！"
                },
                {
                    "id": "701530114",
                    "speaker": "戴帽子的霜精",
                    "text": "「颜色，数，霜精！」"
                },
                {
                    "id": "701530115",
                    "speaker": "派蒙",
                    "text": "啊？什么叫帽子，数，霜精啊…难道是根据我们抓到的数量算分？"
                },
                {
                    "id": "701530116",
                    "speaker": "戴帽子的霜精",
                    "text": "呀吼…"
                },
                {
                    "id": "701530117",
                    "speaker": "戴帽子的霜精",
                    "text": "「蓝色，两个，人类，赢！」"
                },
                {
                    "id": "701530118",
                    "speaker": "戴帽子的霜精",
                    "text": "「抓错，人类，输！」"
                },
                {
                    "id": "701530119",
                    "speaker": "派蒙",
                    "text": "哦，懂了，原来是抓到两只戴蓝色帽子的就赢…但是但凡抓错就会输的意思…"
                },
                {
                    "id": "701530120",
                    "speaker": "派蒙",
                    "text": "#听上去好像很有意思，{NICKNAME}，要试试吗？",
                    "choices": [
                        {
                            "id": "701530121",
                            "text": "那就来试试看吧！",
                            "response": [
                                {
                                    "id": "701530122",
                                    "speaker": "戴帽子的霜精",
                                    "text": "呀吼呀吼！"
                                }
                            ]
                        },
                        {
                            "id": "701530123",
                            "text": "不是很想玩呢…",
                            "response": [
                                {
                                    "id": "701530124",
                                    "speaker": "派蒙",
                                    "text": "抱歉哦…"
                                },
                                {
                                    "id": "701530125",
                                    "speaker": "戴帽子的霜精",
                                    "text": "呀吼呀吼…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
