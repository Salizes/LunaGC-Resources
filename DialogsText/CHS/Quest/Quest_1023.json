    "talks": [
        {
            "id": "102301",
            "objective": "前往「黄金屋」",
            "dialogues": []
        },
        {
            "id": "102303",
            "objective": "(test)黄金屋对话$HIDDEN",
            "dialogues": [
                {
                    "id": "10230301",
                    "speaker": "派蒙",
                    "text": "哇啊——这里就是<color=#00E1FFFF>「黄金屋」</color>？"
                },
                {
                    "id": "10230302",
                    "speaker": "派蒙",
                    "text": "外面看起来就已经很气派了，没想到里面更加豪华！而且…而且满地都是摩拉！！！"
                },
                {
                    "id": "10230303",
                    "speaker": "派蒙",
                    "text": "既然整个提瓦特的摩拉，都是在这里造出来的，那…是不是多一点少一点，都很不容易被发现？",
                    "choices": [
                        {
                            "id": "10230304",
                            "text": "莫伸手，伸手必被抓。",
                            "response": [
                                {
                                    "id": "10230306",
                                    "speaker": "派蒙",
                                    "text": "原来是诱饵式陷阱，好险好险！幸亏有你提醒！"
                                },
                                {
                                    "id": "10230307",
                                    "speaker": "派蒙",
                                    "text": "但就算不能拿，近距离看看应该没问题吧？"
                                },
                                {
                                    "id": "10230308",
                                    "speaker": "派蒙",
                                    "text": "可以的话，我还想躺在里面睡一觉！用摩拉当被子，做梦也会更香，嘿嘿嘿…",
                                    "choices": [
                                        {
                                            "id": "10230309",
                                            "text": "还是先去确认「仙祖法蜕」的情况吧。",
                                            "response": [
                                                {
                                                    "id": "10230311",
                                                    "speaker": "派蒙",
                                                    "text": "哦，对了对了，正事要紧。"
                                                },
                                                {
                                                    "id": "10230312",
                                                    "speaker": "派蒙",
                                                    "text": "这里…是不是太安静了？「仙祖法蜕」这么重要的东西，肯定不会没人看管吧？"
                                                },
                                                {
                                                    "id": "10230313",
                                                    "speaker": "派蒙",
                                                    "text": "#——欸？！{NICKNAME}，你看，那是什么！",
                                                    "choices": [
                                                        {
                                                            "id": "10230314",
                                                            "text": "是千岩军。",
                                                            "response": [
                                                                {
                                                                    "id": "10230315",
                                                                    "speaker": "Player",
                                                                    "text": "好像都晕倒了。"
                                                                },
                                                                {
                                                                    "id": "10230316",
                                                                    "speaker": "派蒙",
                                                                    "text": "…唔，感觉情况很不妙了！"
                                                                },
                                                                {
                                                                    "id": "10230317",
                                                                    "speaker": "派蒙",
                                                                    "text": "我们赶紧去确认一下「仙祖法蜕」有没有异常吧？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "10230315",
                                                            "text": "好像都晕倒了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10230310",
                                            "text": "这里的气氛好像…有点奇怪。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10230305",
                            "text": "如果真这么简单，那早就乱套了吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "102302",
            "objective": "调查仙祖法蜕",
            "dialogues": [
                {
                    "id": "10230201",
                    "speaker": "？？？",
                    "text": "作为「引路人」，你们的使命明明已经完成，为什么还要来自找麻烦呢？"
                },
                {
                    "id": "10230202",
                    "speaker": "派蒙",
                    "text": "嗯？是谁！"
                },
                {
                    "id": "10230203",
                    "speaker": "「公子」",
                    "text": "如果你们是「愚人众」，或许能够拿到一笔来自女皇的丰厚奖赏。"
                },
                {
                    "id": "10230204",
                    "speaker": "「公子」",
                    "text": "但可惜现在，就只是毫无价值的碍事者而已。",
                    "choices": [
                        {
                            "id": "10230205",
                            "text": "你是怎么知道这里的？",
                            "response": [
                                {
                                    "id": "10230206",
                                    "speaker": "「公子」",
                                    "text": "该从何说起呢？本来绕远路也不是我的风格，但谁知道一到璃月，岩之神就离奇死亡，「仙祖法蜕」还被藏了起来。"
                                },
                                {
                                    "id": "10230207",
                                    "speaker": "「公子」",
                                    "text": "要不是借你们筹办「送仙典仪」的机会，得到了一些消息，只怕会更加麻烦。"
                                },
                                {
                                    "id": "10230211",
                                    "speaker": "「公子」",
                                    "text": "嘿…不惜停止摩拉的铸造，也要隐藏「仙祖法蜕」…七星还真是下了血本呢。"
                                },
                                {
                                    "id": "10230212",
                                    "speaker": "派蒙",
                                    "text": "原、原来你真的是想要在「仙祖法蜕」里找出「神之心」？"
                                },
                                {
                                    "id": "10230213",
                                    "speaker": "「公子」",
                                    "text": "作为愚人众的十一执行官，必须贯彻冰之女皇的意旨。"
                                },
                                {
                                    "id": "10230214",
                                    "speaker": "「公子」",
                                    "text": "女皇想要，我们就来取。",
                                    "choices": [
                                        {
                                            "id": "10230215",
                                            "text": "我不允许。",
                                            "response": [
                                                {
                                                    "id": "10230217",
                                                    "speaker": "「公子」",
                                                    "text": "问题不在于谁会允许我，而是谁能阻止我。"
                                                },
                                                {
                                                    "id": "10230218",
                                                    "speaker": "「公子」",
                                                    "text": "交易和算计的时间，终于全都过去了…其实我也很讨厌那些小手段，不过为了女皇，我可以忍。"
                                                },
                                                {
                                                    "id": "10230219",
                                                    "speaker": "「公子」",
                                                    "text": "接下来，我们可以享受一些单纯的、快乐的事…"
                                                },
                                                {
                                                    "id": "10230220",
                                                    "speaker": "「公子」",
                                                    "text": "那就是「争斗」。"
                                                },
                                                {
                                                    "id": "10230221",
                                                    "speaker": "派蒙",
                                                    "text": "争斗？你是那种喜欢找人打架的类型？"
                                                },
                                                {
                                                    "id": "10230222",
                                                    "speaker": "「公子」",
                                                    "text": "哈哈哈，可以这么说吧。"
                                                },
                                                {
                                                    "id": "10230223",
                                                    "speaker": "「公子」",
                                                    "text": "在蒙德，「女士」在教堂外冒犯神灵，得手以后就急匆匆地离开。"
                                                },
                                                {
                                                    "id": "10230224",
                                                    "speaker": "「公子」",
                                                    "text": "她宁愿靠冰雪暂时封住所有人的行动，也不想当场与你一战，这是为了避免战斗时的动静引来骑士。"
                                                },
                                                {
                                                    "id": "10230225",
                                                    "speaker": "「公子」",
                                                    "text": "面对强者，她只会优先盘算利益、考虑胜负、考虑出手以后的影响…"
                                                },
                                                {
                                                    "id": "10230226",
                                                    "speaker": "「公子」",
                                                    "text": "但我成为「执行官」以后最大的快乐，就是可以向更多强者挥拳。"
                                                },
                                                {
                                                    "id": "10230227",
                                                    "speaker": "派蒙",
                                                    "text": "蒙德发生过的事，不会再发生一次了！"
                                                },
                                                {
                                                    "id": "10230228",
                                                    "speaker": "「公子」",
                                                    "text": "好，那就来试试吧？我不会杀死你，旅行者。我只是想享受战斗的乐趣，所以请你陪我玩而已。"
                                                },
                                                {
                                                    "id": "10230229",
                                                    "speaker": "「公子」",
                                                    "text": "你打不赢我，所以不用赢，只要和我一样，也享受战斗的乐趣就好。我这么说，你应该能明白吧？"
                                                },
                                                {
                                                    "id": "10230230",
                                                    "speaker": "Player",
                                                    "text": "我打不赢你？不明白你在说什么。"
                                                },
                                                {
                                                    "id": "10230231",
                                                    "speaker": "「公子」",
                                                    "text": "哈哈哈哈哈哈！"
                                                },
                                                {
                                                    "id": "10230232",
                                                    "speaker": "「公子」",
                                                    "text": "好吧！既然你也很想玩，那可别让我扫兴啊。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10230216",
                                            "text": "不会让你靠近「仙祖法蜕」的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10230208",
                            "text": "我现在追来也不算晚。",
                            "response": [
                                {
                                    "id": "10230209",
                                    "speaker": "「公子」",
                                    "text": "虽然感谢你们让我没怎么费工夫，就找到了这藏匿之所…"
                                },
                                {
                                    "id": "10230210",
                                    "speaker": "「公子」",
                                    "text": "但现在想要阻止我？还是别白费力气了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "102304",
            "objective": "与「公子」作战",
            "dialogues": []
        },
        {
            "id": "102305",
            "objective": "(test)BOSS战后接剧情对话$HIDDEN",
            "dialogues": [
                {
                    "id": "10230501",
                    "speaker": "「公子」",
                    "text": "呼…"
                },
                {
                    "id": "10230502",
                    "speaker": "派蒙",
                    "text": "啊，他变回了原来的样子。"
                },
                {
                    "id": "10230546",
                    "speaker": "「公子」",
                    "text": "也该…冷静下来了。"
                },
                {
                    "id": "10230503",
                    "speaker": "「公子」",
                    "text": "刚才那身「魔王武装」，对身体的负担果然很大，让我没机会停下来思考…"
                },
                {
                    "id": "10230504",
                    "speaker": "「公子」",
                    "text": "但仔细一想，你们确实没有比我抢先一步得到「神之心」的可能性。"
                },
                {
                    "id": "10230505",
                    "speaker": "「公子」",
                    "text": "无论「神之心」去了哪里…都应该与你们无关吧。"
                },
                {
                    "id": "10230506",
                    "speaker": "派蒙",
                    "text": "是啊，都说了不是我们拿的！"
                },
                {
                    "id": "10230507",
                    "speaker": "「公子」",
                    "text": "旅者，你今天展现出的实力，比「女士」在蒙德对你的评价更强，这是为什么呢？",
                    "choices": [
                        {
                            "id": "10230508",
                            "text": "（是因为正在收集七种元素…）",
                            "response": [
                                {
                                    "id": "10230510",
                                    "speaker": "「公子」",
                                    "text": "看你的样子，心里好像是有答案的？"
                                },
                                {
                                    "id": "10230511",
                                    "speaker": "「公子」",
                                    "text": "唉，但如果是不能对我说的秘密，那我也只能勉强压抑一下自己的好奇心啦。"
                                },
                                {
                                    "id": "10230512",
                                    "speaker": "「公子」",
                                    "text": "有这场战斗，我已经很满足了。"
                                },
                                {
                                    "id": "10230513",
                                    "speaker": "「公子」",
                                    "text": "同样追求变强的人，都是朋友，尽管这种友谊的形式，只能是互相争斗…"
                                },
                                {
                                    "id": "10230514",
                                    "speaker": "派蒙",
                                    "text": "真是奇怪的朋友观。"
                                },
                                {
                                    "id": "10230515",
                                    "speaker": "「公子」",
                                    "text": "但现在，也不得不暂时搁置知己间的交流，回到我的任务中去了。"
                                },
                                {
                                    "id": "10230516",
                                    "speaker": "「公子」",
                                    "text": "——既然「神之心」不是被人拿走，那会不会是…从一开始，就不在「仙祖法蜕」里呢？"
                                },
                                {
                                    "id": "10230517",
                                    "speaker": "「公子」",
                                    "text": "更进一步地想，「仙祖法蜕」本身，会不会也只是一种障眼法？"
                                },
                                {
                                    "id": "10230518",
                                    "speaker": "派蒙",
                                    "text": "啊，你是想说…",
                                    "choices": [
                                        {
                                            "id": "10230519",
                                            "text": "岩王帝君没死？",
                                            "response": [
                                                {
                                                    "id": "10230521",
                                                    "speaker": "「公子」",
                                                    "text": "恐怕正是如此。那可…真有意思。"
                                                },
                                                {
                                                    "id": "10230522",
                                                    "speaker": "「公子」",
                                                    "text": "不愧是商业之都的守护神，对「契约之外的小手段」也非常精通呢。"
                                                },
                                                {
                                                    "id": "10230523",
                                                    "speaker": "「公子」",
                                                    "text": "这样一来，就只能发动「备用方案」了。"
                                                },
                                                {
                                                    "id": "10230524",
                                                    "speaker": "派蒙",
                                                    "text": "备用方案？"
                                                },
                                                {
                                                    "id": "10230525",
                                                    "speaker": "「公子」",
                                                    "text": "本来不想用这个方案的，因为会波及弱者。"
                                                },
                                                {
                                                    "id": "10230526",
                                                    "speaker": "「公子」",
                                                    "text": "说到底，世界属于我们这些追求变强的人。对于无聊无趣的弱者，我平常都不怎么愿意去理会。"
                                                },
                                                {
                                                    "id": "10230527",
                                                    "speaker": "「公子」",
                                                    "text": "可惜身为愚人众执行官，是不能对「手段」挑三拣四的。这就像小孩子有时也得学着去吃自己不喜欢的胡萝卜一样吧。"
                                                },
                                                {
                                                    "id": "10230528",
                                                    "speaker": "派蒙",
                                                    "text": "所以…你究竟想做什么？"
                                                },
                                                {
                                                    "id": "10230529",
                                                    "speaker": "「公子」",
                                                    "text": "我要唤醒「孤云阁」下沉睡的魔神。"
                                                },
                                                {
                                                    "id": "10230530",
                                                    "speaker": "派蒙",
                                                    "text": "魔神？！"
                                                },
                                                {
                                                    "id": "10230531",
                                                    "speaker": "「公子」",
                                                    "text": "<color=#00E1FFFF>「漩涡之魔神」，奥赛尔</color>。在魔神战争时败于「岩之魔神」摩拉克斯，被岩枪镇压在海中。"
                                                },
                                                {
                                                    "id": "10230532",
                                                    "speaker": "「公子」",
                                                    "text": "如果让一位昔日的魔神，去进攻失去了神灵镇守的璃月港…"
                                                },
                                                {
                                                    "id": "10230533",
                                                    "speaker": "「公子」",
                                                    "text": "你们觉得，那位把我们都耍了一通的岩王帝君大人，还能安稳地躲在一边看戏吗？"
                                                },
                                                {
                                                    "id": "10230534",
                                                    "speaker": "派蒙",
                                                    "text": "可…可是，魔神战争都结束了两千年！在世上只有七神的今天，你要怎么把远古的魔神…"
                                                },
                                                {
                                                    "id": "10230535",
                                                    "speaker": "「公子」",
                                                    "text": "当然是，已经准备好了「唤醒」的手段。"
                                                },
                                                {
                                                    "id": "10230536",
                                                    "speaker": "派蒙",
                                                    "text": "啊！那是「百无禁忌箓」！"
                                                },
                                                {
                                                    "id": "10230537",
                                                    "speaker": "派蒙",
                                                    "text": "我…我想起来了！我们确实有发现「愚人众」在研究它…",
                                                    "choices": [
                                                        {
                                                            "id": "10230538",
                                                            "text": "我亲眼见过研究的现场。",
                                                            "response": [
                                                                {
                                                                    "id": "10230540",
                                                                    "speaker": "「公子」",
                                                                    "text": "没错，给你们的那张，只是这场研究的副产物而已。"
                                                                },
                                                                {
                                                                    "id": "10230541",
                                                                    "speaker": "「公子」",
                                                                    "text": "这么多「百无禁忌箓」的力量聚集在一起，再加上女皇赐予「执行官」的力量…暂时解封岩枪镇压之力，也不是什么办不到的事。"
                                                                },
                                                                {
                                                                    "id": "10230544",
                                                                    "speaker": "「公子」",
                                                                    "text": "原本对我来说，走到这一步，动用远古魔神的力量，已经很无趣了，也不符合我的信条。"
                                                                },
                                                                {
                                                                    "id": "10230545",
                                                                    "speaker": "「公子」",
                                                                    "text": "不过，一想到不仅是那位岩神，连你们也必须为此作出应对…倒也还挺有意思的。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "10230539",
                                                            "text": "而且你们还在尝试「复制」。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10230520",
                                            "text": "死去的仙体是假的？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10230509",
                            "text": "（是因为正在逐渐恢复曾经的力量…）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "102306",
            "objective": "(test)剧情对话后接CS$HIDDEN",
            "dialogues": [
                {
                    "id": "10230601",
                    "speaker": "「公子」",
                    "text": "拭目以待吧，失去神明的国度，会不会被远古的恶意重新吞没？"
                }
            ]
        },
        {
            "id": "102307",
            "objective": "(test)离开地城（隐藏显示，玩家不进行操作）",
            "dialogues": []
        }
    ]
