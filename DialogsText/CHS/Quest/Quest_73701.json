    "talks": [
        {
            "id": "7370101",
            "objective": "与祖尔宛对话",
            "dialogues": [
                {
                    "id": "737010101",
                    "speaker": "祖尔宛",
                    "text": "啊呀，斯露莎看起来没什么精神的样子，是训练遇到什么阻碍了吗？"
                },
                {
                    "id": "737010102",
                    "speaker": "派蒙",
                    "text": "该说是阻碍呢还是困惑呢…"
                },
                {
                    "id": "737010103",
                    "speaker": "Black Screen",
                    "text": "向祖尔宛说明了此前的对话内容…"
                },
                {
                    "id": "737010104",
                    "speaker": "祖尔宛",
                    "text": "原来是这样，不过，人类记录下来的东西与实情并不相符倒也不是什么新鲜事了，毕竟是健忘又偏执的种类。"
                },
                {
                    "id": "737010105",
                    "speaker": "祖尔宛",
                    "text": "想来世事大抵如此，旁观者虽能纵览全局但却无法体察其中忽微，亲历者虽置身其中但又难免囿于己见。"
                },
                {
                    "id": "737010106",
                    "speaker": "派蒙",
                    "text": "哦…"
                },
                {
                    "id": "737010107",
                    "speaker": "Player",
                    "text": "感觉没起到什么安慰的作用。"
                },
                {
                    "id": "737010108",
                    "speaker": "祖尔宛",
                    "text": "原来你们是想让我来说些暖心的话宽慰斯露莎吗？别忘了，这可是她的训练内容。"
                },
                {
                    "id": "737010109",
                    "speaker": "祖尔宛",
                    "text": "遇到困难时自己想办法解决困难，这才是训练的目的吧？"
                },
                {
                    "id": "737010110",
                    "speaker": "派蒙",
                    "text": "好像是这个道理…"
                },
                {
                    "id": "737010111",
                    "speaker": "祖尔宛",
                    "text": "如果斯露莎连这点小事也做不好，那只能说她愧对花灵勇者的名号，也担不起「双角的花冠」的重量。"
                },
                {
                    "id": "737010112",
                    "speaker": "祖尔宛",
                    "text": "到时候，就算是仁慈如我，也只好狠下心来…"
                },
                {
                    "id": "737010113",
                    "speaker": "斯露莎",
                    "text": "会、会没收花冠吗？"
                },
                {
                    "id": "737010114",
                    "speaker": "祖尔宛",
                    "text": "惩罚的内容嘛，就等到真的失败时再揭晓吧。"
                },
                {
                    "id": "737010115",
                    "speaker": "派蒙",
                    "text": "呜…斯露莎也不想头顶凉飕飕吧，之后得加倍努力才行！"
                }
            ]
        },
        {
            "id": "7370102",
            "objective": "前往指定地点并完成试炼",
            "dialogues": []
        },
        {
            "id": "7370103",
            "objective": "完成训练任务",
            "dialogues": []
        },
        {
            "id": "7370104",
            "objective": "前往指定地点并完成试炼",
            "dialogues": []
        },
        {
            "id": "7370105",
            "objective": "见证斯露莎回顾过往",
            "dialogues": []
        },
        {
            "id": "7370106",
            "objective": "与斯露莎对话",
            "dialogues": [
                {
                    "id": "737010601",
                    "speaker": "斯露莎",
                    "text": "明明是看惯了的景色，现在却只觉得心情复杂…"
                },
                {
                    "id": "737010602",
                    "speaker": "派蒙",
                    "text": "呃…往好处想，这说明斯露莎比起从前有成长了？"
                },
                {
                    "id": "737010603",
                    "speaker": "斯露莎",
                    "text": "究竟是成长还是退化而不自知…"
                },
                {
                    "id": "737010604",
                    "speaker": "派蒙",
                    "text": "打起精神来呀斯露莎，这么灰心丧气的样子，一点都不像你。"
                },
                {
                    "id": "737010605",
                    "speaker": "派蒙",
                    "text": "对了，既然来都来了，不如斯露莎给我们讲讲矫论团最初的历史？"
                },
                {
                    "id": "737010606",
                    "speaker": "派蒙",
                    "text": "虽然现在是这副模样…但是建立之初一定还是有可取之处的吧？否则祖尔宛也不会帮助他们，斯露莎也不会被他们所吸引了。"
                },
                {
                    "id": "737010607",
                    "speaker": "斯露莎",
                    "text": "好吧，既然你们想听…不过，你们知道的，我的诞生是在矫论团建立之后，所以在那之前的事我也只是听说。"
                },
                {
                    "id": "737010608",
                    "speaker": "斯露莎",
                    "text": "据说，在一切发生以前，就有纯白的一群试图将灾难即将发生的消息传递出去。"
                },
                {
                    "id": "737010609",
                    "speaker": "斯露莎",
                    "text": "但只是传递消息，并不能阻止灾厄降临。很快，漆黑的浪潮席卷了大地，万物众生悚惧不已。"
                },
                {
                    "id": "737010610",
                    "speaker": "斯露莎",
                    "text": "就像我们之前见到的风蚀沙虫的结晶，就连那样强壮的生灵也在最初的劫祸中罹难了。"
                },
                {
                    "id": "737010611",
                    "speaker": "斯露莎",
                    "text": "相比之下，人类这样柔弱的生物，就算作鸟兽散也不是什么值得苛责的事吧。"
                },
                {
                    "id": "737010612",
                    "speaker": "斯露莎",
                    "text": "但偏偏有些人，却奔着灾厄涡旋的正中而来。"
                },
                {
                    "id": "737010613",
                    "speaker": "派蒙",
                    "text": "这些人就是最初的矫论团吗？"
                },
                {
                    "id": "737010614",
                    "speaker": "斯露莎",
                    "text": "嗯。其中为首的正是那伽朱那，他们原本是深林之中的学者，但却为了平息灾厄的余波而扎根此地。"
                },
                {
                    "id": "737010615",
                    "speaker": "斯露莎",
                    "text": "对了，还有个金发的…前辈虽然对他言及不多，但是应该至少是个「有趣」的人吧？"
                },
                {
                    "id": "737010616",
                    "speaker": "派蒙",
                    "text": "#唔…可惜是几百年前的人物，不然真想让{NICKNAME}和他见见，当面比一比谁更「有趣」。",
                    "choices": [
                        {
                            "id": "737010617",
                            "text": "这有什么好比的…",
                            "response": [
                                {
                                    "id": "737010619",
                                    "speaker": "斯露莎",
                                    "text": "接着说，在我诞生之后，灾厄的余波也已经平息得差不多了。"
                                },
                                {
                                    "id": "737010620",
                                    "speaker": "派蒙",
                                    "text": "所以斯露莎已经没什么可做的了？"
                                },
                                {
                                    "id": "737010621",
                                    "speaker": "斯露莎",
                                    "text": "唔…也不是完全无事可做，毕竟污秽没有完全根除的一天。只是…像神鸟「西摩格」那样壮烈灿然的牺牲不再是必须的了。"
                                },
                                {
                                    "id": "737010622",
                                    "speaker": "斯露莎",
                                    "text": "更何况在我之前，米希尔、拉沙鲁这些花灵早就各司其职了。"
                                },
                                {
                                    "id": "737010623",
                                    "speaker": "斯露莎",
                                    "text": "在那伽朱那之后，前辈就渐渐不和矫论团的人类往来了，但是对方显然还是对我们花灵十分在意。"
                                },
                                {
                                    "id": "737010624",
                                    "speaker": "斯露莎",
                                    "text": "这也不奇怪，毕竟对他们来说，吾辈花灵就是颂诗的主角嘛，会有钦慕之情也是理所应当。"
                                },
                                {
                                    "id": "737010625",
                                    "speaker": "斯露莎",
                                    "text": "那时我常常听他们高声诵读诗篇，久而久之，神鸟献身的景象也似乎变得愈发鲜明了。前辈说起这些时却是轻描淡写…"
                                },
                                {
                                    "id": "737010626",
                                    "speaker": "派蒙",
                                    "text": "听起来像是…"
                                },
                                {
                                    "id": "737010627",
                                    "speaker": "Player",
                                    "text": "被人类的花言巧语给…"
                                },
                                {
                                    "id": "737010628",
                                    "speaker": "斯露莎",
                                    "text": "怎么会？我明明是被神鸟的慈爱与意志所打动才决心效法的。"
                                },
                                {
                                    "id": "737010629",
                                    "speaker": "斯露莎",
                                    "text": "跟矫论团的人类交好也只是因为，他们会毫无保留地对我讲述过去发生的事…当、当然，适度的赞美也不是完全没有。"
                                },
                                {
                                    "id": "737010630",
                                    "speaker": "派蒙",
                                    "text": "同样一个故事，用夸张的讲法来讲会比较吸引人嘛，我也喜欢听精彩的故事！"
                                },
                                {
                                    "id": "737010631",
                                    "speaker": "派蒙",
                                    "text": "哦！不过初衷是为了记录真实的历史的话，这样就有大麻烦了。"
                                },
                                {
                                    "id": "737010632",
                                    "speaker": "斯露莎",
                                    "text": "对啊，无论是我还是矫论团的人类，渐渐习惯了将夸张变成普通，这才会变成现在的样子吧。"
                                },
                                {
                                    "id": "737010633",
                                    "speaker": "斯露莎",
                                    "text": "矫论团的文献典籍里不再只是简单的事实记录，而是充满了各种言辞的修饰与主观的注解。"
                                },
                                {
                                    "id": "737010634",
                                    "speaker": "斯露莎",
                                    "text": "…而我也不知不觉重视声名而胜过行动本身。"
                                },
                                {
                                    "id": "737010635",
                                    "speaker": "派蒙",
                                    "text": "斯露莎好像想明白了？"
                                },
                                {
                                    "id": "737010636",
                                    "speaker": "Player",
                                    "text": "至少比来时看起来有精神了。"
                                },
                                {
                                    "id": "737010637",
                                    "speaker": "派蒙",
                                    "text": "这不是好事么，嘿嘿，这下就算是祖尔宛也不会说出要把花冠没收这种话了吧？"
                                },
                                {
                                    "id": "737010638",
                                    "speaker": "派蒙",
                                    "text": "斯露莎的训练还剩最后一点就结束了，肯定可以得到祖尔宛的认可的！"
                                }
                            ]
                        },
                        {
                            "id": "737010618",
                            "text": "那我赢定了。"
                        }
                    ]
                }
            ]
        }
    ]
}