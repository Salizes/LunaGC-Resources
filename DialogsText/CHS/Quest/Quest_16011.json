        {
            "id": "1601107",
            "objective": "继续前进",
            "dialogues": [
                {
                    "id": "160110701",
                    "speaker": "法尔伽",
                    "text": "这里…就是狼的「心」中？"
                },
                {
                    "id": "160110702",
                    "speaker": "法尔伽",
                    "text": "……！「罗兰」！"
                }
            ]
        },
        {
            "id": "1601108",
            "objective": "与「染血骑士」对峙",
            "dialogues": []
        },
        {
            "id": "1601109",
            "objective": "与「染血骑士」对峙",
            "dialogues": [
                {
                    "id": "160110901",
                    "speaker": "「罗兰」",
                    "text": "…如你所愿，「北风骑士」。"
                },
                {
                    "id": "160110902",
                    "speaker": "法尔伽",
                    "text": "哈，跟我想象的不太一样，你看起来好像没有「碎片」里记忆得那么疯狂。"
                },
                {
                    "id": "160110903",
                    "speaker": "「罗兰」",
                    "text": "我从未偏离过正确的道路。而你，现在的你不像是能屠龙的英雄，倒像个落魄骑士…流浪了太久。"
                },
                {
                    "id": "160110904",
                    "speaker": "法尔伽",
                    "text": "彼此彼此。看来咱们都不在自己最强的时刻。"
                },
                {
                    "id": "160110905",
                    "speaker": "「罗兰」",
                    "text": "「猎月人」的军势已经被击败，由深渊拟造出的「我」，自然也只是不完整的倒影。"
                },
                {
                    "id": "160110906",
                    "speaker": "「罗兰」",
                    "text": "力量已臻「罗兰」的极致，心境却依然停滞于染血的时刻。"
                },
                {
                    "id": "160110907",
                    "speaker": "「罗兰」",
                    "text": "因此，「我」也同样不正确…而骑士不能容忍自身止步不前。"
                },
                {
                    "id": "160110908",
                    "speaker": "「罗兰」",
                    "text": "将你从不公中救赎、引领你投效深渊后，我便会将自身匡正，继续践行骑士之道。"
                },
                {
                    "id": "160110909",
                    "speaker": "法尔伽",
                    "text": "哈，这外头可经不起你继续折腾了…你的这份偏执倒是跟我想象的一样，看来我是没机会说服你了？"
                },
                {
                    "id": "160110910",
                    "speaker": "「罗兰」",
                    "text": "骑士信奉的美德不会为言语玷染，无论那言语多么高贵。你我都无法说服彼此，你也早已知晓这一点。"
                },
                {
                    "id": "160110911",
                    "speaker": "「罗兰」",
                    "text": "否则，你们又何必将一切希望，都系在玻瑞亚斯的「一念」之间？"
                },
                {
                    "id": "160110912",
                    "speaker": "「罗兰」",
                    "text": "但如今你用以承载狼灵的剑刃早已崩毁，手中所执的不过是徒具其形的幻影。"
                },
                {
                    "id": "160110913",
                    "speaker": "「罗兰」",
                    "text": "你已没有手段改变一切，也再无援军可以期待…此地即是你的「末路」，孤独的远征者。"
                },
                {
                    "id": "160110914",
                    "speaker": "法尔伽",
                    "text": "呵，手段姑且不论，援军的话…这里不是还有一位吗？"
                },
                {
                    "id": "160110915",
                    "speaker": "「罗兰」",
                    "text": "…什么？"
                },
                {
                    "id": "160110916",
                    "speaker": "法尔伽",
                    "text": "——我要说服的对象，从始至终就只有那一位。"
                },
                {
                    "id": "160110917",
                    "speaker": "法尔伽",
                    "text": "这里是北风之魔神——安德留斯的「心」中，对吧？"
                },
                {
                    "id": "160110918",
                    "speaker": "安德留斯",
                    "text": "……"
                },
                {
                    "id": "160110919",
                    "speaker": "法尔伽",
                    "text": "——喂！听见了吗！安德留斯！"
                },
                {
                    "id": "160110920",
                    "speaker": "法尔伽",
                    "text": "快醒醒吧！堂堂北风之魔神，还要被深渊控制多久！"
                },
                {
                    "id": "160110921",
                    "speaker": "安德留斯",
                    "text": "……"
                },
                {
                    "id": "160110922",
                    "speaker": "「罗兰」",
                    "text": "如果这就是你最后的挣扎，那我很失望，「北风骑士」。"
                },
                {
                    "id": "160110923",
                    "speaker": "「罗兰」",
                    "text": "气势和愿望唤不来奇迹，这世界从不会那样仁慈。"
                },
                {
                    "id": "160110924",
                    "speaker": "安德留斯",
                    "text": "…归去…"
                },
                {
                    "id": "160110925",
                    "speaker": "安德留斯",
                    "text": "…归于…地脉…"
                },
                {
                    "id": "160110926",
                    "speaker": "「罗兰」",
                    "text": "……！"
                },
                {
                    "id": "160110927",
                    "speaker": "安德留斯",
                    "text": "…这就是「我」的选择…「我」的记忆…"
                },
                {
                    "id": "160110928",
                    "speaker": "安德留斯",
                    "text": "…是「我」在旅途终点…找到的答案吗？"
                },
                {
                    "id": "160110929",
                    "speaker": "法尔伽",
                    "text": "「安德{RUBY#[D]玻瑞亚斯}留斯」…你的信，我可好好送回到「你」心里了。"
                },
                {
                    "id": "160110930",
                    "speaker": "安德留斯",
                    "text": "呵…「北风骑士」吗，看着吧…"
                },
                {
                    "id": "160110931",
                    "speaker": "安德留斯",
                    "text": "…这就是「狼{RUBY#[S]我}」…唯一能为「人{RUBY#[S]你们}」做的事了…"
                },
                {
                    "id": "160110932",
                    "speaker": "法尔伽",
                    "text": "…代表地上的人类，向您致谢，群狼的领主。"
                },
                {
                    "id": "160110933",
                    "speaker": "「罗兰」",
                    "text": "玻瑞亚斯…正在回归地脉。为什么？你的剑已经破碎，你明明已经没有任何承载灵魂的手段了。不，莫非…"
                },
                {
                    "id": "160110934",
                    "speaker": "法尔伽",
                    "text": "气势和愿望唤不来奇迹…这种事情我当然知道。"
                },
                {
                    "id": "160110935",
                    "speaker": "法尔伽",
                    "text": "…但从一开始，寄托灵魂的手段——就不止有「剑」！"
                },
                {
                    "id": "160110936",
                    "speaker": "温迪",
                    "text": "…奔狼的领主，曾将灵魂的力量赋予麾下的群狼，强壮它们的心脏，锋利它们的爪牙。"
                },
                {
                    "id": "160110937",
                    "speaker": "玻瑞亚斯",
                    "text": "…即便「我」无意于此，凡人的「心」，也将会被王狼的灵魂撕咬、吞噬、同化…一如强行混合的人群与狼群。"
                },
                {
                    "id": "160110938",
                    "speaker": "「队长」",
                    "text": "…以凡人的心脏，承载魔神的灵魂…这将会是一条无法回还的道路，但我不会劝阻一名骑士，踏上自己的征途。"
                },
                {
                    "id": "160110939",
                    "speaker": "「罗兰」",
                    "text": "你的心脏、你的灵魂…也在一同崩解？…原来如此。"
                },
                {
                    "id": "160110940",
                    "speaker": "法尔伽",
                    "text": "「羔羊怎么将铃铛系到狼的心口」…你曾经这么问过对吧？"
                },
                {
                    "id": "160110941",
                    "speaker": "法尔伽",
                    "text": "这就是我的答案——让狼自行吞下这颗「心脏」。"
                },
                {
                    "id": "160110942",
                    "speaker": "「罗兰」",
                    "text": "托付于剑上那部分狼灵不过是佯攻，真正的念想与记忆，是由你的心脏承载…"
                },
                {
                    "id": "160110943",
                    "speaker": "「罗兰」",
                    "text": "为了不被我察觉，故意让王狼的灵魂与你同化，再被我吞噬…迄今为止，你都是承受着这样的重荷在战斗的吗？"
                },
                {
                    "id": "160110944",
                    "speaker": "法尔伽",
                    "text": "比起王狼的决意…这点付出可算不了什么啊。"
                },
                {
                    "id": "160110945",
                    "speaker": "「罗兰」",
                    "text": "顽强的意志，优秀的策略…但这不是骑士应有的战斗方式。正因如此，你的选择是错误的。"
                },
                {
                    "id": "160110946",
                    "speaker": "「罗兰」",
                    "text": "你的灵魂已同安德留斯融为一体。待它彻底将自身汇入地脉，你也会与它一同坠入其中。"
                },
                {
                    "id": "160110947",
                    "speaker": "「罗兰」",
                    "text": "届时，无论是巴巴托斯，还是你身边那位旅人，都已无法从地脉中锚定你的灵魂，更遑论将你救出。"
                },
                {
                    "id": "160110948",
                    "speaker": "「罗兰」",
                    "text": "你输了，我也是。很遗憾，现在我已经无法拯救你。"
                },
                {
                    "id": "160110949",
                    "speaker": "「罗兰」",
                    "text": "…愿你的灵魂随北风安息，孤独的远征者。"
                },
                {
                    "id": "160110950",
                    "speaker": "法尔伽",
                    "text": "…哈哈，孤独吗…"
                },
                {
                    "id": "160110951",
                    "speaker": "法尔伽",
                    "text": "抱歉啊——虽然我也曾经想过，和你同归于地脉的结局，是不是已经挺圆满了。"
                },
                {
                    "id": "160110952",
                    "speaker": "法尔伽",
                    "text": "但可惜呀，跟当年的罗兰不一样，外面可还有美酒跟朋友，在盼着我凯旋呢，所以…"
                },
                {
                    "id": "160110953",
                    "speaker": "法尔伽",
                    "text": "——我还没打算认命！"
                },
                {
                    "id": "160110954",
                    "speaker": "温迪",
                    "text": "叮铃——有你的来信~"
                }
            ]
        },
        {
            "id": "1601110",
            "objective": "杀出地脉",
            "dialogues": []
        },
        {
            "id": "1601111",
            "objective": "凯旋而归",
            "dialogues": [
                {
                    "id": "160111101",
                    "speaker": "法尔伽",
                    "text": "……"
                },
                {
                    "id": "160111102",
                    "speaker": "安德留斯",
                    "text": "…向前走，不必回头。"
                },
                {
                    "id": "160111103",
                    "speaker": "雷泽",
                    "text": "「法尔伽，我，名字的意义…已经知道了。」"
                },
                {
                    "id": "160111104",
                    "speaker": "罗莎莉亚",
                    "text": "「…给大家添了这么多麻烦，等回来，要好好道谢啊。」"
                },
                {
                    "id": "160111105",
                    "speaker": "凯亚",
                    "text": "「哟，虽然有很多事想报告，不过嘛…回来了就好。」"
                },
                {
                    "id": "160111106",
                    "speaker": "迪卢克",
                    "text": "「我不打算回骑士团，所以…还是请您自己撑着吧。」"
                },
                {
                    "id": "160111107",
                    "speaker": "琴",
                    "text": "「…大团长，我们都在等您。」"
                },
                {
                    "id": "160111108",
                    "speaker": "法尔伽",
                    "text": "……"
                },
                {
                    "id": "160111109",
                    "speaker": "法尔伽",
                    "text": "嗯？…呵。"
                },
                {
                    "id": "160111110",
                    "speaker": "法尔伽",
                    "text": "我这大团长，当得应该还不赖吧？…各位。"
                },
                {
                    "id": "160111111",
                    "speaker": "法尔伽",
                    "text": "…那我就当你们是默认咯。"
                },
                {
                    "id": "160111112",
                    "speaker": "法尔伽",
                    "text": "你们那时誓死拯救下来的事物…现在也都好好在那呢。"
                },
                {
                    "id": "160111113",
                    "speaker": "法尔伽",
                    "text": "嗯，骑士团、蒙德…还有骑士的誓言，我都会守护好。"
                },
                {
                    "id": "160111114",
                    "speaker": "法尔伽",
                    "text": "所以…那封信，我会替你们送到。"
                },
                {
                    "id": "160111115",
                    "speaker": "法尔伽",
                    "text": "…虽然只是「他」的倒影，但还有空的话，就替「他」读一读吧？"
                },
                {
                    "id": "160111116",
                    "speaker": "法尔伽",
                    "text": "——鲁斯坦和艾伦德林，都没忘记过你。"
                },
                {
                    "id": "160111117",
                    "speaker": "法尔伽",
                    "text": "哈…这一趟走得还真远啊。"
                },
                {
                    "id": "160111118",
                    "speaker": "法尔伽",
                    "text": "剩下的就…"
                },
                {
                    "id": "160111119",
                    "speaker": "法尔伽",
                    "text": "…「听凭风引」吧。"
                },
                {
                    "id": "160111122",
                    "speaker": "众骑士",
                    "text": "……！"
                },
                {
                    "id": "160111130",
                    "speaker": "法尔伽",
                    "text": "…哟，好久不见，诸位。"
                },
                {
                    "id": "160111131",
                    "speaker": "法尔伽",
                    "text": "…能再见到你们，真是太好了。"
                },
                {
                    "id": "160111132",
                    "speaker": "Player",
                    "text": "欢迎凯旋——大团长。"
                },
                {
                    "id": "160111133",
                    "speaker": "法尔伽",
                    "text": "…嗯，我回来了。"
                },
                {
                    "id": "160111123",
                    "speaker": "法尔伽",
                    "text": "……"
                },
                {
                    "id": "160111124",
                    "speaker": "法尔伽",
                    "text": "……"
                },
                {
                    "id": "160111125",
                    "speaker": "法尔伽",
                    "text": "……"
                },
                {
                    "id": "160111126",
                    "speaker": "法尔伽",
                    "text": "……"
                }
            ]
        },
        {
            "id": "1601112",
            "objective": "与法尔伽聊聊",
            "dialogues": [
                {
                    "id": "160111201",
                    "speaker": "法尔伽",
                    "text": "呼——好久没吹过这儿的风了，还是老样子啊。有什么事想聊吗？趁着我还没被抓回办公室。",
                    "choices": [
                        {
                            "id": "160111202",
                            "text": "关于你的计划…",
                            "response": [
                                {
                                    "id": "160111203",
                                    "speaker": "法尔伽",
                                    "text": "以剑刃作为佯攻，以心脏承载灵魂…是我当初认为最可行的计划。"
                                },
                                {
                                    "id": "160111204",
                                    "speaker": "法尔伽",
                                    "text": "不过计划的后半部分…靠思念的牵引杀出地脉…我倒也确实没几成把握，哈哈。"
                                },
                                {
                                    "id": "160111205",
                                    "speaker": "派蒙",
                                    "text": "#说真的，要是那时候{NICKNAME}分离罗兰杂质的实验没成功，你打算怎么办啊？"
                                },
                                {
                                    "id": "160111206",
                                    "speaker": "法尔伽",
                                    "text": "嗯…这一步最初是准备交给巴巴托斯执行的，但他听完之后，马上向我举荐了更合适的人选…「捕风的异乡人」。"
                                },
                                {
                                    "id": "160111207",
                                    "speaker": "法尔伽",
                                    "text": "#事实证明，我们的信任没有错。多谢你了，{NICKNAME}。"
                                },
                                {
                                    "id": "160111208",
                                    "speaker": "Player",
                                    "text": "那万一我也没成功呢？"
                                },
                                {
                                    "id": "160111209",
                                    "speaker": "法尔伽",
                                    "text": "——那可能就得辛苦巴巴托斯，把我从狼的那一头，吹回人的这一头了？"
                                },
                                {
                                    "id": "160111210",
                                    "speaker": "法尔伽",
                                    "text": "…但无论如何，代价都不会小，成功的概率也未必会高…而我更不希望他去耗用这种力量。",
                                    "choices": [
                                        {
                                            "id": "160111211",
                                            "text": "…动用神明的力量…",
                                            "response": [
                                                {
                                                    "id": "160111213",
                                                    "speaker": "法尔伽",
                                                    "text": "嗯，问得好——一杯上好的蒲公英酒，就拿我藏在办公桌抽屉里的私房钱付账。"
                                                },
                                                {
                                                    "id": "160111214",
                                                    "speaker": "派蒙",
                                                    "text": "——哪有这么便宜的事啊！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "160111212",
                                            "text": "…要支付什么代价？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "160111215",
                            "text": "关于远征军…",
                            "response": [
                                {
                                    "id": "160111216",
                                    "speaker": "法尔伽",
                                    "text": "嗯，这次击败罗兰倒影之后，狂猎在短时间内应该无力再组织反扑了。"
                                },
                                {
                                    "id": "160111217",
                                    "speaker": "法尔伽",
                                    "text": "除了一部分留在挪德卡莱的据点里轮值的人，剩下的都会分波次陆续返回。"
                                },
                                {
                                    "id": "160111218",
                                    "speaker": "法尔伽",
                                    "text": "阿贝多跟杜林也会跟第一波远征军一起回来，你们应该过不久就能再见到他们了。"
                                }
                            ]
                        },
                        {
                            "id": "160111219",
                            "text": "关于你的未来…",
                            "response": [
                                {
                                    "id": "160111220",
                                    "speaker": "法尔伽",
                                    "text": "我的未来吗…没准你也已经从巴巴托斯或者魔女会之类的地方了解过了，我曾在水占盘里窥见一些未来的倒影。"
                                },
                                {
                                    "id": "160111221",
                                    "speaker": "Player",
                                    "text": "「来自北方的深渊灾厄」？"
                                },
                                {
                                    "id": "160111222",
                                    "speaker": "法尔伽",
                                    "text": "对，如今看来…这个未来，大概算是已经改变了吧，托你的福。"
                                },
                                {
                                    "id": "160111223",
                                    "speaker": "法尔伽",
                                    "text": "但等我办完骑士团里的琐事，还是得回北边一趟…挪德卡莱的新据点里还有很多工作要处理。"
                                },
                                {
                                    "id": "160111224",
                                    "speaker": "法尔伽",
                                    "text": "第一批自愿留守的骑士们都还没换班回来，我又怎么能放下他们不管呢？"
                                },
                                {
                                    "id": "160111225",
                                    "speaker": "派蒙",
                                    "text": "说得这么好听，该不会就是为了把蒙德的工作继续丢给琴吧！"
                                },
                                {
                                    "id": "160111226",
                                    "speaker": "法尔伽",
                                    "text": "……"
                                },
                                {
                                    "id": "160111227",
                                    "speaker": "派蒙",
                                    "text": "…不会吧！",
                                    "choices": [
                                        {
                                            "id": "160111228",
                                            "text": "不要在这种时候沉默啊！",
                                            "response": [
                                                {
                                                    "id": "160111230",
                                                    "speaker": "法尔伽",
                                                    "text": "哈哈——开玩笑的，以后你们在蒙德也能经常见到我的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "160111229",
                                            "text": "不要在这种时候微笑啊！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "160111231",
                            "text": "没问题了。",
                            "response": [
                                {
                                    "id": "160111232",
                                    "speaker": "法尔伽",
                                    "text": "嗯，那我就自己再吹上一会儿吧——最醉人的酒，还得是老家的风啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1601199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "160119906",
                    "speaker": "「罗兰」",
                    "text": "…无论什么时代，世间总是充斥着污浊与不公。"
                },
                {
                    "id": "160119907",
                    "speaker": "「罗兰」",
                    "text": "纵是最无畏的勇士，也战胜不了被注定的命{RUBY#[S]死}运。"
                },
                {
                    "id": "160119908",
                    "speaker": "「罗兰」",
                    "text": "纵是最圣洁的神明，也摆脱不了被强加的枷{RUBY#[S]爱}锁。"
                },
                {
                    "id": "160119909",
                    "speaker": "「罗兰」",
                    "text": "王狼啊，若你依然心怀对人的爱，那你应当心知肚明…"
                },
                {
                    "id": "160119910",
                    "speaker": "「罗兰」",
                    "text": "将他们从不公中拯救的方法，从始至终，只有一种。"
                },
                {
                    "id": "160119911",
                    "speaker": "安德留斯",
                    "text": "…投入…深渊…？"
                }
            ]
        }
    ]
}