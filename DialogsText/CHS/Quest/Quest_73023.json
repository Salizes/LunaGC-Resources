    "talks": [
        {
            "id": "7302301",
            "objective": "(test)(隐藏)到达须弥$HIDDEN",
            "dialogues": [
                {
                    "id": "730230101",
                    "speaker": "谢夫凯特",
                    "text": "啊，刚刚狩猎了那只背上长蘑菇的山猪的那位…能过来一下吗，我有件事和你商量！"
                }
            ]
        },
        {
            "id": "7302302",
            "objective": "(test)(隐藏)击杀特定香菇猪$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7302303",
            "objective": "(test)(隐藏)与出现的巡林员对话$HIDDEN",
            "dialogues": [
                {
                    "id": "730230301",
                    "speaker": "？？？",
                    "text": "哎呀，两位啊，打扰你们真是不好意思，但是在下有一事相商…"
                },
                {
                    "id": "730230302",
                    "speaker": "？？？",
                    "text": "不知道你们刚才狩猎蕈猪之后得到的猪肉能不能给我一份啊？"
                },
                {
                    "id": "730230303",
                    "speaker": "派蒙",
                    "text": "蕈猪…你是说刚才那种背上长蘑菇的山猪吗？"
                },
                {
                    "id": "730230304",
                    "speaker": "？？？",
                    "text": "对对对，就是这种背上长蘑菇的山猪。这种山猪经常在须弥的泥塘中打滚，就会有孢子粘在它们的毛发上，长成蘑菇。"
                },
                {
                    "id": "730230305",
                    "speaker": "？？？",
                    "text": "哈哈，也有传言说蘑菇在生长的过程中逐渐掏空了山猪的身子…而蕈猪的猪肉因此有了特殊的蘑菇香气，价格高昂…",
                    "choices": [
                        {
                            "id": "730230306",
                            "text": "有点渗人。",
                            "response": [
                                {
                                    "id": "730230308",
                                    "speaker": "？？？",
                                    "text": "哈哈，不过只是一种传言而已啦，蕈猪背上的蘑菇可供它们在冬天或者无食物时互相啃食充饥。"
                                },
                                {
                                    "id": "730230309",
                                    "speaker": "？？？",
                                    "text": "而蘑菇则可以通过移动的山猪，将孢子传到更多的地方…其实是这样健康的共生关系…"
                                },
                                {
                                    "id": "730230310",
                                    "speaker": "谢夫凯特",
                                    "text": "啊啊，不好意思，我好像还没有进行自我介绍，我叫谢夫凯特，两位是？"
                                },
                                {
                                    "id": "730230311",
                                    "speaker": "派蒙",
                                    "text": "我叫派蒙！"
                                },
                                {
                                    "id": "730230312",
                                    "speaker": "Player",
                                    "text": "#我叫{NICKNAME}。"
                                },
                                {
                                    "id": "730230313",
                                    "speaker": "谢夫凯特",
                                    "text": "#原来如此，{NICKNAME}和派蒙，我记住了。刚才看到两位狩猎蕈猪的身姿那般矫捷，我就知道并非常人…"
                                },
                                {
                                    "id": "730230314",
                                    "speaker": "谢夫凯特",
                                    "text": "实不相瞒，我正在做一些野外生物相关的研究，但是呢，唉，我根本抓不到那些蕈猪。"
                                },
                                {
                                    "id": "730230315",
                                    "speaker": "谢夫凯特",
                                    "text": "我只要一靠近，这些家伙要不就是立刻跑远，要不就是把我一头撞倒在地…这样下去，研究还没开始，我的腰就要先报销了…"
                                },
                                {
                                    "id": "730230316",
                                    "speaker": "谢夫凯特",
                                    "text": "所以，看到两位如此轻松就解决了蕈猪，我就斗胆打扰，能不能收购被打倒的蕈猪的肉呢？"
                                },
                                {
                                    "id": "730230317",
                                    "speaker": "派蒙",
                                    "text": "这个肉有什么特殊吗，看上去和普通的山猪肉也没什么差别…"
                                },
                                {
                                    "id": "730230318",
                                    "speaker": "谢夫凯特",
                                    "text": "哎呀，有没有差别，肯定得要进行调查之后才能知道！卖给我吧，我肯定能给出足够的报偿。"
                                },
                                {
                                    "id": "730230319",
                                    "speaker": "Player",
                                    "text": "（将蕈猪的肉交出…）"
                                },
                                {
                                    "id": "730230320",
                                    "speaker": "谢夫凯特",
                                    "text": "啊，这真是太感谢你了，这样我就能继续我的调查了！"
                                },
                                {
                                    "id": "730230321",
                                    "speaker": "派蒙",
                                    "text": "谢夫凯特在进行的，究竟是什么样的调查啊？"
                                },
                                {
                                    "id": "730230322",
                                    "speaker": "谢夫凯特",
                                    "text": "只是些普通的生态调查，有的时候会捕猎一些动物，调查那些动物的生长状况…"
                                },
                                {
                                    "id": "730230323",
                                    "speaker": "谢夫凯特",
                                    "text": "有时候仅仅一个个体，就能够看出一段时间内整个群体的生长状态，是非常神奇的事…"
                                },
                                {
                                    "id": "730230324",
                                    "speaker": "派蒙",
                                    "text": "看出来了，谢夫凯特真的很喜欢动物呢！"
                                },
                                {
                                    "id": "730230325",
                                    "speaker": "谢夫凯特",
                                    "text": "对，我…我一直都很喜欢它们，我花了很长时间研究它们呢，须弥森林里的生态，是非常令人着迷的…"
                                },
                                {
                                    "id": "730230326",
                                    "speaker": "谢夫凯特",
                                    "text": "好，蕈猪的肉解决了，下面就是「暝彩鸟」了。"
                                },
                                {
                                    "id": "730230327",
                                    "speaker": "谢夫凯特",
                                    "text": "#{NICKNAME}，你们见过暝彩鸟吗，那是一种经常出没在<color=#00E1FFFF>水天丛林南部</color>的非常漂亮的鸟。"
                                },
                                {
                                    "id": "730230328",
                                    "speaker": "谢夫凯特",
                                    "text": "那也是须弥特有的鸟类，就连教令院的学者也经常用它们传递信息…虽然能长途飞行，却讨厌雨水，下雨天的时候就会躲起来。"
                                },
                                {
                                    "id": "730230329",
                                    "speaker": "谢夫凯特",
                                    "text": "好了，我也该走了。暝彩鸟啊，希望我自己一个人就能抓住一只吧…哈哈，总依赖别人可不算个事啊。"
                                },
                                {
                                    "id": "730230330",
                                    "speaker": "谢夫凯特",
                                    "text": "不过，如果你们愿意的话，咳咳，也希望能帮我留意一下吧，如果能捉到暝彩鸟，我也愿意收购。"
                                }
                            ]
                        },
                        {
                            "id": "730230307",
                            "text": "有点可怕。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302306",
            "objective": "于水天丛林南部狩猎暝彩鸟",
            "dialogues": []
        },
        {
            "id": "7302318",
            "objective": "(test)与坏调查员对话",
            "dialogues": [
                {
                    "id": "730231801",
                    "speaker": "谢夫凯特",
                    "text": "(test)哎！好巧又是你们"
                },
                {
                    "id": "730231802",
                    "speaker": "派蒙",
                    "text": "(test)啊啊小心后面"
                }
            ]
        },
        {
            "id": "7302307",
            "objective": "击败出现的镀金旅团",
            "dialogues": []
        },
        {
            "id": "7302308",
            "objective": "与谢夫凯特对话",
            "dialogues": [
                {
                    "id": "730230801",
                    "speaker": "派蒙",
                    "text": "咦，你是那个，「调查人」！"
                },
                {
                    "id": "730230802",
                    "speaker": "谢夫凯特",
                    "text": "调查人是什么呀…哈哈，我的名字是谢夫凯特，之前不是见过一面吗，你还把蕈猪的肉卖给我了。",
                    "choices": [
                        {
                            "id": "730230803",
                            "text": "是吗？",
                            "response": [
                                {
                                    "id": "730230804",
                                    "speaker": "派蒙",
                                    "text": "对！他还给了我们比普通山猪肉多了很多的报偿呢…"
                                },
                                {
                                    "id": "730230807",
                                    "speaker": "派蒙",
                                    "text": "说起来，谢夫凯特，你怎么在这儿呢？"
                                },
                                {
                                    "id": "730230808",
                                    "speaker": "谢夫凯特",
                                    "text": "哈哈哈说来惭愧，我这不是还在继续我的调查嘛…"
                                },
                                {
                                    "id": "730230809",
                                    "speaker": "谢夫凯特",
                                    "text": "我的调查需要暝彩鸟，但是一只都没有抓住…调查进度真是堪忧。抓不住鸟也就算了，没想到还…"
                                },
                                {
                                    "id": "730230810",
                                    "speaker": "派蒙",
                                    "text": "没想到还？"
                                },
                                {
                                    "id": "730230811",
                                    "speaker": "谢夫凯特",
                                    "text": "还遇到了镀金旅团，那些人二话不说就拿着武器向我招呼过来…"
                                },
                                {
                                    "id": "730230812",
                                    "speaker": "派蒙",
                                    "text": "是嘛，这么说来之前镀金旅团的家伙好像把我们认作了你…"
                                },
                                {
                                    "id": "730230813",
                                    "speaker": "谢夫凯特",
                                    "text": "欸？是嘛…哈哈，还有这种事，想必是因为…对，肯定是因为我保护暝彩鸟的行为不被他们理解…"
                                },
                                {
                                    "id": "730230814",
                                    "speaker": "谢夫凯特",
                                    "text": "哎呀，镀金旅团那些人肯定将这片森林里的暝彩鸟视作他们自己的财富了吧，才会敌视我这样采集样本的调查行为。"
                                },
                                {
                                    "id": "730230815",
                                    "speaker": "谢夫凯特",
                                    "text": "毕竟暝彩鸟的羽毛也是价格相当昂贵的商品…"
                                },
                                {
                                    "id": "730230816",
                                    "speaker": "谢夫凯特",
                                    "text": "对了，你们知道吗，暝彩鸟啊，是为了能够在森林中潜藏起自己的身形，所以才会生长出这样斑斓的颜色…"
                                },
                                {
                                    "id": "730230817",
                                    "speaker": "谢夫凯特",
                                    "text": "结果，很多人都为了这绚烂多彩的羽毛捕猎它，真是可悲。"
                                },
                                {
                                    "id": "730230818",
                                    "speaker": "派蒙",
                                    "text": "真是可怜…"
                                },
                                {
                                    "id": "730230819",
                                    "speaker": "谢夫凯特",
                                    "text": "面对镀金旅团的时候，我可没办法像你们那么勇敢…唉…"
                                },
                                {
                                    "id": "730230820",
                                    "speaker": "谢夫凯特",
                                    "text": "对了，关于你们打下来的暝彩鸟的羽毛，能够卖给我吗？"
                                },
                                {
                                    "id": "730230821",
                                    "speaker": "谢夫凯特",
                                    "text": "跟上次一样，我会给出足够丰厚的报偿的！"
                                },
                                {
                                    "id": "730230822",
                                    "speaker": "Player",
                                    "text": "（将暝彩鸟的羽毛交出……）"
                                },
                                {
                                    "id": "730230823",
                                    "speaker": "谢夫凯特",
                                    "text": "哈哈，暝彩鸟的羽毛也到手了…这下子，这下子我的调查已经完成了大半了。"
                                },
                                {
                                    "id": "730230824",
                                    "speaker": "谢夫凯特",
                                    "text": "不过，这羽毛…"
                                },
                                {
                                    "id": "730230825",
                                    "speaker": "派蒙",
                                    "text": "怎么了，难道这羽毛有什么问题吗？"
                                },
                                {
                                    "id": "730230826",
                                    "speaker": "谢夫凯特",
                                    "text": "不，这羽毛没有问题，只是品相有点差…哦我是说，能够看得出来，在这个区域的暝彩鸟生长状况似乎不是很好。"
                                },
                                {
                                    "id": "730230827",
                                    "speaker": "谢夫凯特",
                                    "text": "看来得去不同的地方，多收集一些暝彩鸟的羽毛，这样才能知道暝彩鸟整体的种群到底发生了什么…"
                                },
                                {
                                    "id": "730230828",
                                    "speaker": "谢夫凯特",
                                    "text": "听说<color=#00E1FFFF>水天丛林北部</color>有不同的暝彩鸟族群，看来还得去那里看看有没有暝彩鸟的踪迹啊…"
                                },
                                {
                                    "id": "730230829",
                                    "speaker": "谢夫凯特",
                                    "text": "#嗯，看来我又得出发了！有缘再见吧，{NICKNAME}和派蒙！"
                                }
                            ]
                        },
                        {
                            "id": "730230805",
                            "text": "好像确实有这么回事…",
                            "response": [
                                {
                                    "id": "730230806",
                                    "speaker": "派蒙",
                                    "text": "嗯，想起来了，喜欢动物的谢夫凯特！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302311",
            "objective": "于水天丛林北部狩猎暝彩鸟",
            "dialogues": []
        },
        {
            "id": "7302312",
            "objective": "与镀金旅团对话",
            "dialogues": [
                {
                    "id": "730231201",
                    "speaker": "奥尔罕",
                    "text": "住手！住手！你们怎么又在这里随意狩猎暝彩鸟！"
                },
                {
                    "id": "730231202",
                    "speaker": "奥尔罕",
                    "text": "好啊，果然！你们就是最近流窜作案的盗猎者！你们又狩猎我的暝彩鸟！"
                },
                {
                    "id": "730231203",
                    "speaker": "派蒙",
                    "text": "哼，暝彩鸟才不是你的呢？难道是你饲养了这些暝彩鸟吗？"
                },
                {
                    "id": "730231204",
                    "speaker": "奥尔罕",
                    "text": "倒也不是，但是，我的暝彩鸟，那就是我的暝彩鸟。"
                },
                {
                    "id": "730231205",
                    "speaker": "奥尔罕",
                    "text": "那是我负责看守的暝彩鸟啊！"
                },
                {
                    "id": "730231206",
                    "speaker": "派蒙",
                    "text": "负责看守？"
                },
                {
                    "id": "730231207",
                    "speaker": "奥尔罕",
                    "text": "是啊，我叫奥尔罕，可是奉三十人团之命，在这里看守暝彩鸟的聚集地免受偷猎者侵扰的看守！"
                },
                {
                    "id": "730231208",
                    "speaker": "奥尔罕",
                    "text": "不信？不信就看看这个三十人团治安官签署的命令书。"
                },
                {
                    "id": "730231209",
                    "speaker": "Black Screen",
                    "text": "奥尔罕展示了凭信，确实由三十人团所签署。"
                },
                {
                    "id": "730231210",
                    "speaker": "派蒙",
                    "text": "咦，这和听说的可不一样…最近不是有捕获暝彩鸟进行生态调查的活动吗？"
                },
                {
                    "id": "730231211",
                    "speaker": "奥尔罕",
                    "text": "哪有这种活动…"
                },
                {
                    "id": "730231212",
                    "speaker": "派蒙",
                    "text": "…难道谢夫凯特骗了我们吗？"
                },
                {
                    "id": "730231213",
                    "speaker": "奥尔罕",
                    "text": "谢夫凯特…怎么又是谢夫凯特。小草神在上，你们啊，完完全全被这家伙骗了。"
                },
                {
                    "id": "730231214",
                    "speaker": "奥尔罕",
                    "text": "这家伙，经常穿成巡林员的样子骗人，实际上是个和盗宝团合作的混蛋，联手倒卖珍稀动物身上的素材…"
                },
                {
                    "id": "730231215",
                    "speaker": "派蒙",
                    "text": "怎么会这样…",
                    "choices": [
                        {
                            "id": "730231216",
                            "text": "事到如今不得不承认…",
                            "response": [
                                {
                                    "id": "730231218",
                                    "speaker": "奥尔罕",
                                    "text": "被他骗的冒险家也不是一个两个了，这家伙一直唆使冒险家出手，自己却躲在他们身后，就跟陆鳗鳗一样难抓…"
                                },
                                {
                                    "id": "730231219",
                                    "speaker": "派蒙",
                                    "text": "#怎么办，{NICKNAME}，我们好像已经狩猎了好几只暝彩鸟了…",
                                    "choices": [
                                        {
                                            "id": "730231220",
                                            "text": "希望牢饭营养均衡…",
                                            "response": [
                                                {
                                                    "id": "730231221",
                                                    "speaker": "派蒙",
                                                    "text": "不要啊，我才不要被三十人团关起来！"
                                                },
                                                {
                                                    "id": "730231222",
                                                    "speaker": "奥尔罕",
                                                    "text": "…没那么严重啦。毕竟暝彩鸟族群还是很庞大，不是什么特别的稀有种，你们也不知情，所以不会严重到会被关起来的程度。"
                                                },
                                                {
                                                    "id": "730231228",
                                                    "speaker": "派蒙",
                                                    "text": "原来是这样…"
                                                },
                                                {
                                                    "id": "730231229",
                                                    "speaker": "奥尔罕",
                                                    "text": "「不过该有的罚款可是一分也不能少」…虽然本来想这么说，但是，咳咳，眼下正有一个给两位的戴罪立功的机会！"
                                                },
                                                {
                                                    "id": "730231230",
                                                    "speaker": "派蒙",
                                                    "text": "戴罪立功的机会？"
                                                },
                                                {
                                                    "id": "730231231",
                                                    "speaker": "奥尔罕",
                                                    "text": "对，虽然不知道为什么，但是谢夫凯特似乎大量需求暝彩鸟的羽毛…我们可以把他引出来…"
                                                },
                                                {
                                                    "id": "730231232",
                                                    "speaker": "奥尔罕",
                                                    "text": "比如我们散布…「在<color=#00E1FFFF>水天丛林东边</color>的山上，有大量暝彩鸟栖息」的消息，他一定会上钩。"
                                                },
                                                {
                                                    "id": "730231233",
                                                    "speaker": "奥尔罕",
                                                    "text": "但是这人极其狡猾，我们稍有行动就容易打草惊蛇，这个时候就需要二位啦！"
                                                },
                                                {
                                                    "id": "730231234",
                                                    "speaker": "奥尔罕",
                                                    "text": "#嗯…刚才好像听到，金发的叫{NICKNAME}吧，小飞人呢…"
                                                },
                                                {
                                                    "id": "730231235",
                                                    "speaker": "派蒙",
                                                    "text": "我叫派蒙。"
                                                },
                                                {
                                                    "id": "730231236",
                                                    "speaker": "奥尔罕",
                                                    "text": "#嗯，{NICKNAME}和派蒙，我需要你们帮忙，去接触谢夫凯特。"
                                                },
                                                {
                                                    "id": "730231237",
                                                    "speaker": "派蒙",
                                                    "text": "我懂了，他看见我们以后就会稍微放松警惕…"
                                                },
                                                {
                                                    "id": "730231238",
                                                    "speaker": "奥尔罕",
                                                    "text": "正是如此。我们会提前埋伏好，就靠你来把他拖住了。"
                                                },
                                                {
                                                    "id": "730231239",
                                                    "speaker": "奥尔罕",
                                                    "text": "你遇到他以后…这样，就大声说「你做的一切我们都知道了！」就以这个为暗号，我们就出来把他抓住！"
                                                },
                                                {
                                                    "id": "730231240",
                                                    "speaker": "奥尔罕",
                                                    "text": "怎么样？"
                                                },
                                                {
                                                    "id": "730231241",
                                                    "speaker": "Player",
                                                    "text": "没有问题。"
                                                },
                                                {
                                                    "id": "730231242",
                                                    "speaker": "奥尔罕",
                                                    "text": "说干就干，我们这就去传播消息。须弥城就交给我，菲利特，你去化城郭，正好可以试探一下那边是不是有人和盗宝团勾结。"
                                                },
                                                {
                                                    "id": "730231243",
                                                    "speaker": "奥尔罕",
                                                    "text": "帕慕克，维摩庄附近…"
                                                },
                                                {
                                                    "id": "730231244",
                                                    "speaker": "帕慕克",
                                                    "text": "我知道了，头儿，我散布假消息，您放心！"
                                                },
                                                {
                                                    "id": "730231245",
                                                    "speaker": "奥尔罕",
                                                    "text": "好啊，这次，一定能把那个偷猎的混蛋绳之于法！"
                                                },
                                                {
                                                    "id": "730231246",
                                                    "speaker": "奥尔罕",
                                                    "text": "#拜托你了，{NICKNAME}，我们一定要把那个家伙给引出来。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730231223",
                                            "text": "现在逃出须弥还来得及？",
                                            "response": [
                                                {
                                                    "id": "730231224",
                                                    "speaker": "派蒙",
                                                    "text": "没办法了，还没有探索的须弥的区域，只能以后再来了。"
                                                },
                                                {
                                                    "id": "730231225",
                                                    "speaker": "奥尔罕",
                                                    "text": "我可不能眼睁睁看着两位从我面前逃走，更何况，为了应对最近变得愈加猖狂的盗猎行为，这附近已经全是三十人团的人啦！"
                                                },
                                                {
                                                    "id": "730231226",
                                                    "speaker": "Player",
                                                    "text": "不要啊，我才不要被三十人团关起来！"
                                                },
                                                {
                                                    "id": "730231227",
                                                    "speaker": "奥尔罕",
                                                    "text": "…没必要那么紧张。毕竟暝彩鸟族群还是很庞大，不是什么特别的稀有种，你们也不知情，所以不会严重到会被关起来的程度。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730231217",
                            "text": "果然被谢夫凯特骗了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302313",
            "objective": "前往水天丛林东边的山上狩猎暝彩鸟",
            "dialogues": []
        },
        {
            "id": "7302314",
            "objective": "与谢夫凯特对话",
            "dialogues": [
                {
                    "id": "730231401",
                    "speaker": "谢夫凯特",
                    "text": "#哎呀，这不是{NICKNAME}和派蒙嘛…你们出现在了这里，一定也听说了附近有暝彩鸟栖息地的消息吧。"
                },
                {
                    "id": "730231402",
                    "speaker": "谢夫凯特",
                    "text": "这并不是常见的暝彩鸟会喜欢的环境，到底为什么会在这里栖息…这说不定是值得研究的课题呢。"
                },
                {
                    "id": "730231403",
                    "speaker": "派蒙",
                    "text": "谢夫凯特…"
                },
                {
                    "id": "730231404",
                    "speaker": "谢夫凯特",
                    "text": "哈哈，怎么了？对了，你们肯定是想问我还收不收暝彩鸟的羽毛吧，当然了，暝彩鸟的羽毛可是很珍贵的。"
                },
                {
                    "id": "730231405",
                    "speaker": "Player",
                    "text": "「你做的一切我们都知道了！」"
                },
                {
                    "id": "730231406",
                    "speaker": "谢夫凯特",
                    "text": "……？"
                },
                {
                    "id": "730231407",
                    "speaker": "谢夫凯特",
                    "text": "为什么突然说这个，怎么了，是为我进行这些调查感到辛苦吗？"
                },
                {
                    "id": "730231408",
                    "speaker": "派蒙",
                    "text": "#（咦怎么回事，怎么镀金旅团的人没出来，之前明明跟奥尔罕说好了…{NICKNAME}，不如我来试一试吧。）"
                },
                {
                    "id": "730231409",
                    "speaker": "派蒙",
                    "text": "「你做的一切我们都知道了！」"
                },
                {
                    "id": "730231410",
                    "speaker": "谢夫凯特",
                    "text": "怎么连派蒙也…欸呀，没关系，这都是我应该做的，更何况，过程中，你们也帮助了我许多。"
                },
                {
                    "id": "730231411",
                    "speaker": "谢夫凯特",
                    "text": "虽然调查的过程确实很艰难，但是这一切都是有意义的，这都是为了森林里的动物们…"
                },
                {
                    "id": "730231412",
                    "speaker": "派蒙",
                    "text": "这才不是为了森林里的动物们，是为了你自己吧！"
                },
                {
                    "id": "730231413",
                    "speaker": "Player",
                    "text": "你做的一切我们都已经知道了！"
                },
                {
                    "id": "730231414",
                    "speaker": "Black Screen",
                    "text": "话音刚落，奥尔罕便从林间匆忙走出…"
                },
                {
                    "id": "730231415",
                    "speaker": "奥尔罕",
                    "text": "对，谢夫凯特，三十人团正式以假冒巡林员，唆使不明情况冒险家盗猎，与盗宝团勾结等等罪名，将你逮捕！"
                },
                {
                    "id": "730231416",
                    "speaker": "派蒙",
                    "text": "什么呀，奥尔罕，你怎么才来，刚才我们暗号喊得嗓子都哑了！"
                },
                {
                    "id": "730231417",
                    "speaker": "奥尔罕",
                    "text": "这个，出了点意外…"
                },
                {
                    "id": "730231418",
                    "speaker": "谢夫凯特",
                    "text": "镀金旅团的人怎么会出现在这？暗号？"
                },
                {
                    "id": "730231419",
                    "speaker": "谢夫凯特",
                    "text": "「我做的一切你们都知道了！」原来是这个意思，亏我刚才还有点感动呢！"
                },
                {
                    "id": "730231420",
                    "speaker": "派蒙",
                    "text": "大骗子！"
                },
                {
                    "id": "730231421",
                    "speaker": "Player",
                    "text": "束手就擒吧！"
                },
                {
                    "id": "730231422",
                    "speaker": "谢夫凯特",
                    "text": "啊，我该想到的，你们早就和镀金旅团…哼，这里有暝彩鸟的消息，也是你们放出来的吧。"
                },
                {
                    "id": "730231423",
                    "speaker": "奥尔罕",
                    "text": "正是如此，你中计了谢夫凯特，整天骗人的你没想到会有被骗的一天吧！三十人团会好好惩罚你的！"
                },
                {
                    "id": "730231424",
                    "speaker": "谢夫凯特",
                    "text": "…唉，事到如今，也没什么好狡辩的了。我很喜欢须弥的动物，但是有的时候只有喜欢是没有什么用的。"
                },
                {
                    "id": "730231425",
                    "speaker": "谢夫凯特",
                    "text": "我没能进入教令院，每天做些不着调的调查。到最后，在旁人眼里，也只不过是个总在森林里游荡的怪人罢了。"
                },
                {
                    "id": "730231426",
                    "speaker": "谢夫凯特",
                    "text": "我需要摩拉…不管是为了调查，还是为了封住那些背后说我闲话的人的嘴…"
                },
                {
                    "id": "730231427",
                    "speaker": "奥尔罕",
                    "text": "所以就对自己最了解的这些动物下手了？哼，因为了解这些动物，反而造成了更大的损伤，还真是了不起啊！"
                },
                {
                    "id": "730231428",
                    "speaker": "谢夫凯特",
                    "text": "这些都是不得已而为之…"
                },
                {
                    "id": "730231429",
                    "speaker": "奥尔罕",
                    "text": "你就不用在这里卖弄你的唇舌了！我是不会相信你的鬼话的。"
                },
                {
                    "id": "730231430",
                    "speaker": "派蒙",
                    "text": "大骗子终于落入法网啦。"
                },
                {
                    "id": "730231431",
                    "speaker": "派蒙",
                    "text": "说起来，奥尔罕，你之前为什么来得那么晚…"
                },
                {
                    "id": "730231432",
                    "speaker": "奥尔罕",
                    "text": "啊，这个…菲利特和帕慕克一直没有回来，我去找也找不到，思前想后，我就一个人先到这里来了，哈哈…"
                },
                {
                    "id": "730231433",
                    "speaker": "奥尔罕",
                    "text": "这不是时机刚好嘛，这就是所谓的来得早不如来得巧。",
                    "choices": [
                        {
                            "id": "730231434",
                            "text": "听上去真不靠谱…",
                            "response": [
                                {
                                    "id": "730231436",
                                    "speaker": "谢夫凯特",
                                    "text": "哼哼…什么呀，我还以为有很多镀金旅团的人埋伏在附近呢。原来就只来了一个人啊。"
                                },
                                {
                                    "id": "730231437",
                                    "speaker": "谢夫凯特",
                                    "text": "本来还想佯装被捕，再伺机逃走，呵，现在看来根本没有这个必要嘛。"
                                },
                                {
                                    "id": "730231438",
                                    "speaker": "派蒙",
                                    "text": "咦？"
                                },
                                {
                                    "id": "730231439",
                                    "speaker": "谢夫凯特",
                                    "text": "不会吧，你们不会以为就靠你们和…这么一个镀金旅团的小卒子，就能抓住我？"
                                },
                                {
                                    "id": "730231440",
                                    "speaker": "谢夫凯特",
                                    "text": "算你们运气不好，今天正好是我和盗宝团约定交货的日子，所以他们就埋伏在旁边。可不只有你们会喊人！"
                                },
                                {
                                    "id": "730231441",
                                    "speaker": "谢夫凯特",
                                    "text": "快，把这些人给解决了！"
                                }
                            ]
                        },
                        {
                            "id": "730231435",
                            "text": "再晚点就不用你登场了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302315",
            "objective": "与盗宝团战斗",
            "dialogues": []
        },
        {
            "id": "7302316",
            "objective": "与奥尔罕对话",
            "dialogues": [
                {
                    "id": "730231601",
                    "speaker": "Black Screen",
                    "text": "你们干净利落地解决了盗宝团。\\n菲利特和帕慕克也赶到了…"
                },
                {
                    "id": "730231602",
                    "speaker": "菲利特",
                    "text": "头儿！"
                },
                {
                    "id": "730231603",
                    "speaker": "帕慕克",
                    "text": "不好意思，我们稍微来迟了一会儿…"
                },
                {
                    "id": "730231604",
                    "speaker": "派蒙",
                    "text": "什么叫来迟了一会儿啊，事情都结束了…"
                },
                {
                    "id": "730231605",
                    "speaker": "菲利特",
                    "text": "哎呀…"
                },
                {
                    "id": "730231606",
                    "speaker": "奥尔罕",
                    "text": "你们到底跑到哪里去了！找也找不到…哇，怎么还满身酒气…"
                },
                {
                    "id": "730231607",
                    "speaker": "菲利特",
                    "text": "嘿嘿，这个，传播消息最好的方法，不就是假装喝醉酒…"
                },
                {
                    "id": "730231608",
                    "speaker": "帕慕克",
                    "text": "然后再说出假消息嘛。"
                },
                {
                    "id": "730231609",
                    "speaker": "Player",
                    "text": "根本就是真的喝醉了…"
                },
                {
                    "id": "730231610",
                    "speaker": "奥尔罕",
                    "text": "#你们两个…要不是有{NICKNAME}在，说不定我就得被盗宝团胖揍一顿了。"
                },
                {
                    "id": "730231611",
                    "speaker": "奥尔罕",
                    "text": "#不过没想到，{NICKNAME}居然这么轻松就把盗宝团的人全都打倒了…"
                },
                {
                    "id": "730231612",
                    "speaker": "派蒙",
                    "text": "#那是当然了，{NICKNAME}可是很厉害的！"
                },
                {
                    "id": "730231613",
                    "speaker": "奥尔罕",
                    "text": "怪不得，虽然之前想要阻止你们的时候也被你们轻松撂倒，但是这…可有点超出我的想象了。",
                    "choices": [
                        {
                            "id": "730231614",
                            "text": "过奖了！",
                            "response": [
                                {
                                    "id": "730231616",
                                    "speaker": "奥尔罕",
                                    "text": "#好了，谢夫凯特，现在你倚仗的盗宝团已经被我们…被{NICKNAME}打趴下了，你现在还有什么话说？"
                                },
                                {
                                    "id": "730231617",
                                    "speaker": "谢夫凯特",
                                    "text": "我、我…其实我现在盗猎这么多的动物，都是因为一次儿时的心理创伤。"
                                },
                                {
                                    "id": "730231618",
                                    "speaker": "谢夫凯特",
                                    "text": "你们听我说…那是在我还是个小男孩的时候…",
                                    "choices": [
                                        {
                                            "id": "730231619",
                                            "text": "谁要听你说啊！",
                                            "response": [
                                                {
                                                    "id": "730231621",
                                                    "speaker": "奥尔罕",
                                                    "text": "好了，把这家伙抓住，你们被蛊惑狩猎暝彩鸟的事就一笔勾销啦。下次啊，还是好好选择听信的对象吧！"
                                                },
                                                {
                                                    "id": "730231622",
                                                    "speaker": "奥尔罕",
                                                    "text": "要是当时一开始能听我说话…"
                                                },
                                                {
                                                    "id": "730231623",
                                                    "speaker": "派蒙",
                                                    "text": "什么呀，你当时直接就打过来了！"
                                                },
                                                {
                                                    "id": "730231624",
                                                    "speaker": "奥尔罕",
                                                    "text": "说的也是…我一着急就会那样，看来下次还是得冷静一点。"
                                                },
                                                {
                                                    "id": "730231625",
                                                    "speaker": "奥尔罕",
                                                    "text": "不过我可不希望还有下次了，你们也得小心一些，也不能谁说的话都相信…"
                                                },
                                                {
                                                    "id": "730231626",
                                                    "speaker": "Player",
                                                    "text": "知道啦！"
                                                },
                                                {
                                                    "id": "730231627",
                                                    "speaker": "派蒙",
                                                    "text": "我们以后会注意的！"
                                                },
                                                {
                                                    "id": "730231628",
                                                    "speaker": "Black Screen",
                                                    "text": "奥尔罕押着谢夫凯特离开了…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730231620",
                                            "text": "别编故事了！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730231615",
                            "text": "再夸我就要得意忘形了！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302317",
            "objective": "(test)废弃",
            "dialogues": []
        },
        {
