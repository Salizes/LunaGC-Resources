    "talks": [
        {
            "id": "7082201",
            "objective": "与小安对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7082202",
            "objective": "安抚弗莱琪姐弟",
            "dialogues": [
                {
                    "id": "708220201",
                    "speaker": "杰里",
                    "text": "姐姐，我们还是回蒙德去吧…"
                },
                {
                    "id": "708220202",
                    "speaker": "弗莱琪",
                    "text": "哎呀，以后你不去吃中原杂碎就好了，不用担心。"
                },
                {
                    "id": "708220203",
                    "speaker": "杰里",
                    "text": "不是啊，我…我不是说这个，当然也有这部分的原因…"
                },
                {
                    "id": "708220204",
                    "speaker": "杰里",
                    "text": "而且现在连「请仙典仪」都出了事啊！姐姐，你想想，「请仙典仪」就相当于教会为巴巴托斯大人举办的仪式。"
                },
                {
                    "id": "708220205",
                    "speaker": "杰里",
                    "text": "连这种仪式都能出事，璃月港压根就不安全啦，我们还是赶紧回蒙德城比较好啦！",
                    "choices": [
                        {
                            "id": "708220206",
                            "text": "璃月港很安全。",
                            "response": [
                                {
                                    "id": "708220207",
                                    "speaker": "弗莱琪",
                                    "text": "对啊杰里，不止我一个人说对吧？还有这位…"
                                },
                                {
                                    "id": "708220208",
                                    "speaker": "弗莱琪",
                                    "text": "咦？你是…那位「荣誉骑士」吧！我听说过你，解决了龙灾的那位！"
                                },
                                {
                                    "id": "708220209",
                                    "speaker": "弗莱琪",
                                    "text": "你看杰里，这可是「荣誉骑士」的意见喔，璃月港可是很安全的，我们就继续安心追寻美食吧。"
                                },
                                {
                                    "id": "708220215",
                                    "speaker": "杰里",
                                    "text": "就算你这么说，可是璃月港里怕不是都是中原杂碎这种…可怕的菜…"
                                },
                                {
                                    "id": "708220216",
                                    "speaker": "弗莱琪",
                                    "text": "怎么可能，璃月港里可是有很多名菜的，是你还没吃到合自己胃口的菜而已。"
                                },
                                {
                                    "id": "708220217",
                                    "speaker": "弗莱琪",
                                    "text": "比如那道「翡玉什锦袋」，一定很合你的胃口，我们下一道菜就去吃那个好了。"
                                },
                                {
                                    "id": "708220218",
                                    "speaker": "杰里",
                                    "text": "可是姐姐，现在璃月港里这么个情况，哪里去找能做这道菜的人啊？",
                                    "choices": [
                                        {
                                            "id": "708220219",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "708220220",
                                                    "speaker": "弗莱琪",
                                                    "text": "真的吗？不愧是「荣誉骑士」，真是无所不能啊，那就拜托你啦。"
                                                },
                                                {
                                                    "id": "708220221",
                                                    "speaker": "弗莱琪",
                                                    "text": "好了杰里，你也打起精神来，我们俩的美食之旅，可不能在这里结束啊。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "708220222",
                                            "text": "我可以去找找。",
                                            "response": [
                                                {
                                                    "id": "708220223",
                                                    "speaker": "弗莱琪",
                                                    "text": "你愿意帮忙吗？那太好了，连龙灾都可以解决，一道菜而已，肯定也不在话下啦。"
                                                },
                                                {
                                                    "id": "708220224",
                                                    "speaker": "弗莱琪",
                                                    "text": "你也打起精神来，杰里，这位「荣誉骑士」都来帮忙了，我们俩的美食之旅，可不能在这里结束啊。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "708220210",
                            "text": "蒙德城也差不多…",
                            "response": [
                                {
                                    "id": "708220211",
                                    "speaker": "弗莱琪",
                                    "text": "对啊杰里，蒙德城也被龙灾啦，最后还不是被西风骑士团解决了吗？"
                                },
                                {
                                    "id": "708220212",
                                    "speaker": "弗莱琪",
                                    "text": "我们就…咦？你是…那位「荣誉骑士」吧！我听说过你，你和骑士团联手解决了龙灾对吧？"
                                },
                                {
                                    "id": "708220213",
                                    "speaker": "弗莱琪",
                                    "text": "你看杰里，连这位「荣誉骑士」都来璃月港了喔，没什么好怕的啦。"
                                },
                                {
                                    "id": "708220214",
                                    "speaker": "弗莱琪",
                                    "text": "而且，我们的美食之旅才刚刚开始，可不能在这里中断了啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7082203",
            "objective": "制作「美味的翡玉什锦袋」",
            "dialogues": [
                {
                    "id": "708220301",
                    "speaker": "弗莱琪",
                    "text": "怎么样，你拿到「翡玉什锦袋」了吗？"
                },
                {
                    "id": "708220302",
                    "speaker": "Player",
                    "text": "拿到了。"
                },
                {
                    "id": "708220303",
                    "speaker": "弗莱琪",
                    "text": "哇，这道菜…杰里，你来看看，肯定很合你的胃口。"
                },
                {
                    "id": "708220304",
                    "speaker": "杰里",
                    "text": "是这样吗？那我等会好好尝尝。唔，这个气味…确实不错…"
                },
                {
                    "id": "708220305",
                    "speaker": "弗莱琪",
                    "text": "哈哈哈，看来杰里已经完全被这道菜吸引了。"
                },
                {
                    "id": "708220306",
                    "speaker": "弗莱琪",
                    "text": "这样子，他也不会闹着要回蒙德城了吧，谢谢你，荣誉骑士，这下我们的美食之旅又可以继续了。"
                }
            ]
        },
        {
            "id": "7082204",
            "objective": "向弗莱琪姐弟回报",
            "dialogues": []
        },
        {
            "id": "7082205",
            "objective": "安抚伊凡诺维奇",
            "dialogues": [
                {
                    "id": "708220401",
                    "speaker": "伊凡诺维奇",
                    "text": "不然，还是想点别的办法吧…"
                },
                {
                    "id": "708220402",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "708220403",
                    "speaker": "伊凡诺维奇",
                    "text": "我？哦…你是说最近璃月港里的那些事吧，我倒是没什么感觉。"
                },
                {
                    "id": "708220404",
                    "speaker": "伊凡诺维奇",
                    "text": "不过，原本在至冬国内负责给我供货，也偶尔收购石珀的人反倒是很不安。"
                },
                {
                    "id": "708220405",
                    "speaker": "伊凡诺维奇",
                    "text": "虽然我说璃月港不会有什么问题，但他们还是坚持过几个月再来，这段时间先看看情况。"
                },
                {
                    "id": "708220406",
                    "speaker": "伊凡诺维奇",
                    "text": "好在我之前新进了几批货物，能够支持一段时间，我正好趁着这时候再收一波石珀。"
                },
                {
                    "id": "708220407",
                    "speaker": "伊凡诺维奇",
                    "text": "我在这里理理货，你能帮我去找博来先生问问，他那里还有没有要出手的石珀吗？",
                    "choices": [
                        {
                            "id": "708220408",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "708220409",
                                    "speaker": "伊凡诺维奇",
                                    "text": "那就拜托你了。"
                                }
                            ]
                        },
                        {
                            "id": "708220410",
                            "text": "你还挺冷静的。",
                            "response": [
                                {
                                    "id": "708220411",
                                    "speaker": "伊凡诺维奇",
                                    "text": "在我看来，这确实不算什么大事。而且现在璃月港里的正常秩序也没有乱，也没什么好慌的。"
                                },
                                {
                                    "id": "708220412",
                                    "speaker": "伊凡诺维奇",
                                    "text": "再说了…人家都慌了，我不慌，那我不就比人家抢先一步了吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7082206",
            "objective": "与博来谈谈",
            "dialogues": [
                {
                    "id": "708220501",
                    "speaker": "博来",
                    "text": "您这…都这时候了，还有空来关照我生意？"
                },
                {
                    "id": "708220502",
                    "speaker": "Player",
                    "text": "关于伊凡诺维奇…"
                },
                {
                    "id": "708220503",
                    "speaker": "博来",
                    "text": "哦，那位在港口那边做生意的外国人啊，他还要收我的石珀？"
                },
                {
                    "id": "708220504",
                    "speaker": "博来",
                    "text": "行啊，送上门的生意，我可不能放过了。"
                },
                {
                    "id": "708220505",
                    "speaker": "博来",
                    "text": "我这里正好还有一批石珀，本来是给另外一个客人预备的，但是那位说最近璃月港不安全，先不要了。"
                },
                {
                    "id": "708220506",
                    "speaker": "博来",
                    "text": "如果那位先生愿意收，那我也乐得出手，您先回去告诉他吧，我在这先把货给点好。"
                }
            ]
        },
        {
            "id": "7082207",
            "objective": "向伊凡诺维奇回报",
            "dialogues": [
                {
                    "id": "708220601",
                    "speaker": "伊凡诺维奇",
                    "text": "怎么样，博来先生怎么说的？"
                },
                {
                    "id": "708220602",
                    "speaker": "Player",
                    "text": "他说会把货备好。"
                },
                {
                    "id": "708220603",
                    "speaker": "伊凡诺维奇",
                    "text": "那就太好了，这位先生我是信得过的。"
                },
                {
                    "id": "708220604",
                    "speaker": "伊凡诺维奇",
                    "text": "等我那些胆小的商业伙伴们再来璃月港的时候，我又可以大赚一笔了。"
                }
            ]
        },
        {
            "id": "7082208",
            "objective": "安抚竺子",
            "dialogues": [
                {
                    "id": "708220701",
                    "speaker": "竺子",
                    "text": "哎呀，这可怎么办…"
                },
                {
                    "id": "708220702",
                    "speaker": "竺子",
                    "text": "幸会！啊不对，应该是…你好，对吧。"
                },
                {
                    "id": "708220703",
                    "speaker": "竺子",
                    "text": "我还不太熟悉本地人打招呼的方式，璃月和稻妻真的完全不一样呢…",
                    "choices": [
                        {
                            "id": "708220704",
                            "text": "你是稻妻人？",
                            "response": [
                                {
                                    "id": "708220705",
                                    "speaker": "竺子",
                                    "text": "嗯嗯，为了来璃月，我可费了不少周折。"
                                },
                                {
                                    "id": "708220707",
                                    "speaker": "竺子",
                                    "text": "哎呀，因为我一直想要环游世界，但是我家乡那边的氛围…怎么说呢，紧张？危险？"
                                },
                                {
                                    "id": "708220708",
                                    "speaker": "竺子",
                                    "text": "别说是环游世界了，就算是想要出海也是困难重重，一般人连「勘定奉行」的多重审批都通不过。"
                                },
                                {
                                    "id": "708220709",
                                    "speaker": "竺子",
                                    "text": "所以，我就自己扎了条木筏，偷偷跑到璃月来啦。"
                                },
                                {
                                    "id": "708220710",
                                    "speaker": "竺子",
                                    "text": "我本来是想在码头上找一份水手的工作，但是…连怎么找工作都不知道。"
                                },
                                {
                                    "id": "708220711",
                                    "speaker": "竺子",
                                    "text": "而且璃月又不知道发生了什么，街上一下子紧张了起来。"
                                },
                                {
                                    "id": "708220712",
                                    "speaker": "竺子",
                                    "text": "我这个外国人，想必也没有什么地方肯给一份工作吧…",
                                    "choices": [
                                        {
                                            "id": "708220713",
                                            "text": "你擅长什么？",
                                            "response": [
                                                {
                                                    "id": "708220714",
                                                    "speaker": "竺子",
                                                    "text": "我在家乡的时候一直在家里的店铺帮忙…"
                                                },
                                                {
                                                    "id": "708220715",
                                                    "speaker": "竺子",
                                                    "text": "要说擅长的话，那肯定是送货啦。不过，我是一直想要当水手来着…"
                                                },
                                                {
                                                    "id": "708220720",
                                                    "speaker": "竺子",
                                                    "text": "咦？你要帮我找工作吗！太谢谢你了，哎呀…璃月好人真多啊…"
                                                },
                                                {
                                                    "id": "708220721",
                                                    "speaker": "竺子",
                                                    "text": "对了，之前为了找工作，我也做了点准备，到处找人打听了一下。"
                                                },
                                                {
                                                    "id": "708220722",
                                                    "speaker": "竺子",
                                                    "text": "那些人说，如果想找到…靠谱…的工作，可以去找…那个…我看看…我记下来了的。"
                                                },
                                                {
                                                    "id": "708220723",
                                                    "speaker": "竺子",
                                                    "text": "啊，找到了，嗯…可以去找阿宽、小昭和小安…"
                                                },
                                                {
                                                    "id": "708220724",
                                                    "speaker": "竺子",
                                                    "text": "虽然是记下来了，但我不太熟悉本地人的交流方式，就一直没有敢去问他们。"
                                                },
                                                {
                                                    "id": "708220725",
                                                    "speaker": "竺子",
                                                    "text": "如果你真愿意帮忙的话，就帮我去问问他们吧，希望他们愿意给我一份工作…",
                                                    "choices": [
                                                        {
                                                            "id": "708220726",
                                                            "text": "交给我吧。",
                                                            "response": [
                                                                {
                                                                    "id": "708220727",
                                                                    "speaker": "竺子",
                                                                    "text": "那就拜托你啦。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "708220728",
                                                            "text": "如果不是水手的工作…",
                                                            "response": [
                                                                {
                                                                    "id": "708220729",
                                                                    "speaker": "竺子",
                                                                    "text": "没关系啦，我也没有指望一来璃月港就能找到水手的工作，总之慢慢来吧。"
                                                                },
                                                                {
                                                                    "id": "708220730",
                                                                    "speaker": "竺子",
                                                                    "text": "那么，就拜托你啦。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "708220716",
                                            "text": "想要做什么工作？",
                                            "response": [
                                                {
                                                    "id": "708220717",
                                                    "speaker": "竺子",
                                                    "text": "当然是水手最好啦！不过，肯定不可能一开始就做水手…"
                                                },
                                                {
                                                    "id": "708220718",
                                                    "speaker": "竺子",
                                                    "text": "只要有工作的地方，我就已经很满足啦。"
                                                },
                                                {
                                                    "id": "708220719",
                                                    "speaker": "竺子",
                                                    "text": "别看我这样，在家乡那边我一直在家里的店铺帮忙，对于送货可是很擅长的喔。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "708220706",
                            "text": "你来璃月做什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7082212",
            "objective": "与阿宽、小昭和小安谈谈",
            "dialogues": [
                {
                    "id": "708221401",
                    "speaker": "阿宽",
                    "text": "唉，怎么还没有个准信…"
                },
                {
                    "id": "708221402",
                    "speaker": "Player",
                    "text": "关于工作…"
                },
                {
                    "id": "708221403",
                    "speaker": "阿宽",
                    "text": "找工作？那你找错人了，总务司把层岩巨渊都封了，黑岩厂也停了工。"
                },
                {
                    "id": "708221404",
                    "speaker": "阿宽",
                    "text": "厂里一堆人闲着，每天只能做点小活计糊口，暂时不招新人来工作了。"
                },
                {
                    "id": "708221405",
                    "speaker": "阿宽",
                    "text": "哼，再这么停下去，我看这几百号人真去街上找工作，总务司怎么办…"
                }
            ]
        },
        {
            "id": "7082213",
            "objective": "与阿宽、小昭和小安谈谈",
            "dialogues": [
                {
                    "id": "708221501",
                    "speaker": "小安",
                    "text": "你回来了，事情怎么样了？"
                },
                {
                    "id": "708221502",
                    "speaker": "Player",
                    "text": "关于竺子…"
                },
                {
                    "id": "708221503",
                    "speaker": "小安",
                    "text": "哦，你说那位稻妻的女士啊，她一直在码头上打听工作的事，我对她有印象。"
                },
                {
                    "id": "708221504",
                    "speaker": "小安",
                    "text": "不过，我这边还真没有合适她做的工作，你也看到了，我这边的表单和数据都必须要熟手来做。"
                },
                {
                    "id": "708221505",
                    "speaker": "小安",
                    "text": "就算是从总务司借调文员过来，也要培训一段时间才能上手，不然只能帮倒忙。"
                },
                {
                    "id": "708221506",
                    "speaker": "小安",
                    "text": "特别是在这个时候，我更不敢招个生手了，所以很抱歉，我这里暂时没有适合那位女士的工作。"
                }
            ]
        },
        {
            "id": "7082209",
            "objective": "与阿宽、小昭和小安谈谈",
            "dialogues": [
                {
                    "id": "708220801",
                    "speaker": "小昭",
                    "text": "这个结不掉…这个结不掉…这个又要延期…"
                },
                {
                    "id": "708220802",
                    "speaker": "小昭",
                    "text": "这些单子是要我亲自去催他们才做吗？！"
                },
                {
                    "id": "708220803",
                    "speaker": "Player",
                    "text": "你怎么了…"
                },
                {
                    "id": "708220804",
                    "speaker": "小昭",
                    "text": "没什么，就是一堆单子没人做，我不去把单子拍到他们面前去催，他们就一直延期。"
                },
                {
                    "id": "708220805",
                    "speaker": "小昭",
                    "text": "现在璃月港里出了那么大的事，我还有一堆事要处理，怎么可能腾出手来去一个个催他们！"
                },
                {
                    "id": "708220806",
                    "speaker": "小昭",
                    "text": "总务司又抽不出人手来，这些单子我真是看着就烦！"
                },
                {
                    "id": "708220807",
                    "speaker": "Player",
                    "text": "催单…需要什么技术吗？"
                },
                {
                    "id": "708220808",
                    "speaker": "小昭",
                    "text": "技术？不需要，具体的需求和截止时间我都已经写在表上了，只需要送到对应的人面前就行。"
                },
                {
                    "id": "708220809",
                    "speaker": "小昭",
                    "text": "如果单子送到了，那些人还是没按规定结掉手上的活，或者是再延期，导致工作不能按期完成…"
                },
                {
                    "id": "708220810",
                    "speaker": "小昭",
                    "text": "哼，那就自己来总务司解释原因吧。"
                },
                {
                    "id": "708220811",
                    "speaker": "小昭",
                    "text": "怎么，你是想要帮忙，还是有愿意来帮忙的人，我都欢迎。",
                    "choices": [
                        {
                            "id": "708220812",
                            "text": "我有一位朋友可以帮忙。",
                            "response": [
                                {
                                    "id": "708220813",
                                    "speaker": "小昭",
                                    "text": "那太好了，快点让你的那位朋友来报道，这些单子越快结掉越好。"
                                }
                            ]
                        },
                        {
                            "id": "708220814",
                            "text": "稻妻人可以吗？",
                            "response": [
                                {
                                    "id": "708220815",
                                    "speaker": "小昭",
                                    "text": "都可以，只要够认真，够负责就好。"
                                },
                                {
                                    "id": "708220816",
                                    "speaker": "小昭",
                                    "text": "你是有朋友愿意来帮忙吗？那太好了，让你的朋友直接过来报道吧，这些单子越快结掉越好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7082210",
            "objective": "向竺子回报",
            "dialogues": [
                {
                    "id": "708220901",
                    "speaker": "竺子",
                    "text": "怎么样，他们有回复吗？"
                },
                {
                    "id": "708220902",
                    "speaker": "Player",
                    "text": "小昭说可以让你去工作…"
                },
                {
                    "id": "708220903",
                    "speaker": "竺子",
                    "text": "太好了！具体是做什么？催单…在稻妻没听说过这种工作…"
                },
                {
                    "id": "708220904",
                    "speaker": "竺子",
                    "text": "璃月果然和稻妻完全不一样啊。"
                },
                {
                    "id": "708220905",
                    "speaker": "竺子",
                    "text": "不过，无论是什么工作，我都会全力以赴的！"
                },
                {
                    "id": "708220906",
                    "speaker": "竺子",
                    "text": "谢谢你，我准备准备就过去报道啦。"
                },
                {
                    "id": "708220907",
                    "speaker": "竺子",
                    "text": "这下子，总算可以迈出新生活的第一步啦。"
                }
            ]
        },
        {
            "id": "7082211",
            "objective": "向小安回报",
            "dialogues": [
                {
                    "id": "708221001",
                    "speaker": "小安",
                    "text": "怎么样，事情办好了吗？"
                },
                {
                    "id": "708221002",
                    "speaker": "Player",
                    "text": "已经办好了。"
                },
                {
                    "id": "708221003",
                    "speaker": "小安",
                    "text": "谢谢你，剩下的事就由我来办吧，除了这些外国客人，总务司对璃月港市民们的安抚工作也已经在快速推进了。"
                },
                {
                    "id": "708221004",
                    "speaker": "小安",
                    "text": "虽然不知道这样效果如何，但总之，在这种风波里，能尽一份力就尽一份力吧。"
                },
                {
                    "id": "708221005",
                    "speaker": "小安",
                    "text": "这些给你，就算是谢礼吧，你也算是外来的客人，但来的时间实在是不巧…"
                },
                {
                    "id": "708221006",
                    "speaker": "小安",
                    "text": "希望这一切都快点过去…"
                }
            ]
        },
        {
            "id": "7082213",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708221301",
                    "speaker": "弗莱琪",
                    "text": "杰里看来确实不太能接受中原杂碎这种菜色呢。"
                },
                {
                    "id": "708221302",
                    "speaker": "弗莱琪",
                    "text": "哈哈哈，这道菜对他来说，似乎比「请仙典仪」发生意外还可怕呢。"
                },
                {
                    "id": "708221303",
                    "speaker": "弗莱琪",
                    "text": "希望翡玉什锦袋能让他对璃月的美食重新恢复信心。"
                }
            ]
        },
        {
            "id": "7082216",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708221601",
                    "speaker": "杰里",
                    "text": "唉，我还是想回蒙德城，就算是吃份满足沙拉也好啊…"
                }
            ]
        },
        {
            "id": "7082217",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708221701",
                    "speaker": "博来",
                    "text": "哼，怎么说呢，做生意这件事吧…撑死大胆的，饿死胆小的。"
                }
            ]
        },
        {
            "id": "7082218",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708221801",
                    "speaker": "伊凡诺维奇",
                    "text": "哼，做生意的人，可不能太胆小了。"
                }
            ]
        },
        {
            "id": "7082219",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708221901",
                    "speaker": "竺子",
                    "text": "璃月港可真是一座繁忙的城市啊，虽然稻妻也很繁忙…"
                },
                {
                    "id": "708221902",
                    "speaker": "竺子",
                    "text": "但是…两座城市的「繁忙」，给人的感觉完全不一样呢。"
                },
                {
                    "id": "708221903",
                    "speaker": "竺子",
                    "text": "我这么说你也没法体会啦，如果你有机会去稻妻的话，就自己感受一下吧。"
                },
                {
                    "id": "708221904",
                    "speaker": "竺子",
                    "text": "哎呀，算了…要我说，你最好还是别去稻妻了。并不是我想说我家乡的坏话，现在的稻妻可不太适合去旅行。"
                }
            ]
        },
        {
            "id": "7082220",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708222001",
                    "speaker": "杰里",
                    "text": "…这道菜的味道可真不错，璃月港这地方也太神奇了。居然会同时存在中原杂碎这种可怕的菜，和这种美味…"
                },
                {
                    "id": "708222002",
                    "speaker": "弗莱琪",
                    "text": "这哪里叫神奇，我说过了，璃月港里有很多名菜，我们还远远没有尝试完呢。"
                }
            ]
        },
        {
            "id": "7082223",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708222301",
                    "speaker": "伊凡诺维奇",
                    "text": "不知道这些货能撑多久，真是受不了那群胆小的家伙，白白放跑了商机…"
                }
            ]
        },
        {
            "id": "7082224",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708222401",
                    "speaker": "小安",
                    "text": "事情都堆在一起了，真是一团糟…"
                }
            ]
        },
        {
            "id": "7082225",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708222501",
                    "speaker": "小安",
                    "text": "唉，什么时候才能恢复正常啊…"
                }
            ]
        },
        {
            "id": "7082226",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708222601",
                    "speaker": "小昭",
                    "text": "必须快点把这些事情都处理好…"
                }
            ]
        },
        {
            "id": "7082227",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708222701",
                    "speaker": "阿宽",
                    "text": "唉，到底什么时候才能完全复工啊…"
                }
            ]
        },
        {
            "id": "7082228",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "708222801",
                    "speaker": "竺子",
                    "text": "希望有人愿意给我一份工作…"
                }
            ]
        }
    ]
}