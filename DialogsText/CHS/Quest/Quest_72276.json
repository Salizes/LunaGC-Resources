        {
            "id": "7227609",
            "objective": "放置最后的石板",
            "dialogues": [
                {
                    "id": "722760901",
                    "speaker": "小柳",
                    "text": "你们鬼鬼祟祟地，又在干什么？"
                }
            ]
        },
        {
            "id": "7227625",
            "objective": "再次启动装置",
            "dialogues": []
        },
        {
            "id": "7227610",
            "objective": "前往下方的房间",
            "dialogues": [
                {
                    "id": "722761001",
                    "speaker": "小柳",
                    "text": "怎么…怎么会这样…"
                },
                {
                    "id": "722761002",
                    "speaker": "派蒙",
                    "text": "发生了什么？"
                },
                {
                    "id": "722761003",
                    "speaker": "小柳",
                    "text": "我居然对我的朋友下手了…"
                },
                {
                    "id": "722761004",
                    "speaker": "小柳",
                    "text": "一定是文谷布下的怨灵上了我的身，控制了我的神智…"
                },
                {
                    "id": "722761005",
                    "speaker": "小柳",
                    "text": "这么点秘宝，如何能比得上我和他的友谊。我、我绝对不会因为这么点财宝就动了歹念的。"
                },
                {
                    "id": "722761006",
                    "speaker": "小柳",
                    "text": "他那么信任我，找到了文谷之宝都会约我一同前来见证…我…"
                },
                {
                    "id": "722761007",
                    "speaker": "小柳",
                    "text": "我不是这样的人…"
                },
                {
                    "id": "722761008",
                    "speaker": "派蒙",
                    "text": "唔，所以最后一块碎片掩盖了这个真相吗？"
                },
                {
                    "id": "722761009",
                    "speaker": "Player",
                    "text": "让他自己静一静吧。"
                },
                {
                    "id": "722761010",
                    "speaker": "派蒙",
                    "text": "说的也是呢。"
                },
                {
                    "id": "722761011",
                    "speaker": "派蒙",
                    "text": "我们回去和矢部说一声吧。"
                }
            ]
        },
        {
            "id": "7227613",
            "objective": "击败出现的秽灵",
            "dialogues": []
        },
        {
            "id": "7227611",
            "objective": "与小柳的残影对话",
            "dialogues": []
        },
        {
            "id": "7227612",
            "objective": "与矢部对话",
            "dialogues": [
                {
                    "id": "722761201",
                    "speaker": "矢部",
                    "text": "你们回来啦。"
                },
                {
                    "id": "722761202",
                    "speaker": "Player",
                    "text": "你好，什么来着…"
                },
                {
                    "id": "722761203",
                    "speaker": "矢部",
                    "text": "矢部啊矢部！我叫矢部！"
                },
                {
                    "id": "722761204",
                    "speaker": "矢部",
                    "text": "唉，好好把我名字记住啊。我说，你该不会把我委托的事情忘了吧？"
                },
                {
                    "id": "722761205",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}在开玩笑啦。我们已经找到了文谷秘宝的真相了。"
                },
                {
                    "id": "722761206",
                    "speaker": "Black Screen",
                    "text": "和矢部讲述了整个事情的经过…"
                },
                {
                    "id": "722761207",
                    "speaker": "矢部",
                    "text": "所以说，阳炎幻法和宝藏密室确有其事？但是中途还发生过别的故事？"
                },
                {
                    "id": "722761208",
                    "speaker": "矢部",
                    "text": "怨灵和污秽也确有其事，还能控制人的心智。哎哟，吓坏我了。还好没和你们一起去。"
                },
                {
                    "id": "722761209",
                    "speaker": "Player",
                    "text": "害怕伤害我们？"
                },
                {
                    "id": "722761210",
                    "speaker": "矢部",
                    "text": "害怕被你们摁在地上打。"
                },
                {
                    "id": "722761211",
                    "speaker": "矢部",
                    "text": "总之有点满足又有点遗憾，谢谢你们啦。虽然确实很玄乎，但是好像也都是元素力能解释的，有点不带劲儿啊。"
                },
                {
                    "id": "722761212",
                    "speaker": "矢部",
                    "text": "文谷的迷案终于可以结掉了，我回去就让全世界知道。"
                }
            ]
        },
        {
            "id": "7227611",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722761101",
                    "speaker": "小柳",
                    "text": "呵呵哈哈哈——反正现在是百年一次的三界交汇天象。只要藏起来，藏起来就能把它变成迷案了…"
                },
                {
                    "id": "722761102",
                    "speaker": "小柳",
                    "text": "我，我不是…"
                }
            ]
        }
    ]
