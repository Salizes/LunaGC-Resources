    "talks": [
        {
            "id": "7227601",
            "objective": "与矢部对话",
            "dialogues": [
                {
                    "id": "722760101",
                    "speaker": "矢部",
                    "text": "#嘿，你是叫{NICKNAME}对吧。"
                },
                {
                    "id": "722760102",
                    "speaker": "矢部",
                    "text": "不知道你有没有记住我的名字。我叫做矢部。"
                },
                {
                    "id": "722760103",
                    "speaker": "Player",
                    "text": "你好，矢部。"
                },
                {
                    "id": "722760104",
                    "speaker": "矢部",
                    "text": "你好你好，嘿嘿嘿。"
                },
                {
                    "id": "722760105",
                    "speaker": "矢部",
                    "text": "说来，你应该身手挺厉害的吧。又是直面雷电将军又是纵横渊下宫的。"
                },
                {
                    "id": "722760106",
                    "speaker": "Player",
                    "text": "确有其事。"
                },
                {
                    "id": "722760107",
                    "speaker": "矢部",
                    "text": "那太好了。我这里有个关于宝藏的线索，但是可能很危险。你有兴趣吗？"
                },
                {
                    "id": "722760108",
                    "speaker": "矢部",
                    "text": "我虽然天生喜欢一些神神叨叨的东西，但是终究还是爱惜这条小命的。"
                },
                {
                    "id": "722760109",
                    "speaker": "Player",
                    "text": "有兴趣，讲讲。"
                },
                {
                    "id": "722760110",
                    "speaker": "矢部",
                    "text": "我在大日御舆趁着巡查之便，找到了这个。"
                },
                {
                    "id": "722760111",
                    "speaker": "矢部",
                    "text": "看起来只是一个石板。但是我觉得它应该就是找到「文谷秘宝」的关键。"
                },
                {
                    "id": "722760112",
                    "speaker": "Player",
                    "text": "文谷秘宝？"
                },
                {
                    "id": "722760113",
                    "speaker": "矢部",
                    "text": "白夜国具体的历史在海祇岛是不怎么流传的。我也不是很清楚啦。"
                },
                {
                    "id": "722760114",
                    "speaker": "矢部",
                    "text": "有个故事说，文谷是第二任宰相，和「太阳之子」一起横征暴敛。然后他把财宝藏在了大日御舆的秘密房间里。"
                },
                {
                    "id": "722760115",
                    "speaker": "矢部",
                    "text": "最后他利用阳炎幻法把宝藏密室藏起来了，还召唤了地脉里的秽鬼和怨念看守财宝。"
                },
                {
                    "id": "722760116",
                    "speaker": "矢部",
                    "text": "照理来说，文谷应该也有个什么忒什么斯的古代名字。但是小人和佞臣的故事也没谁去记录得这么清楚。"
                },
                {
                    "id": "722760117",
                    "speaker": "Player",
                    "text": "说回石板吧。"
                },
                {
                    "id": "722760118",
                    "speaker": "矢部",
                    "text": "这个石板应该就是解锁文谷藏宝室的关键。我对怪谈传说、神秘案件之类的事情，可是有着长年累月的积累——"
                },
                {
                    "id": "722760119",
                    "speaker": "矢部",
                    "text": "这一块石板上面的…呃…就是那个…"
                },
                {
                    "id": "722760120",
                    "speaker": "Player",
                    "text": "说实话。"
                },
                {
                    "id": "722760121",
                    "speaker": "矢部",
                    "text": "其实我在大日御舆储藏间找到这块石板的时候，旁边就有双语写的说明纸条。"
                },
                {
                    "id": "722760122",
                    "speaker": "矢部",
                    "text": "过渡时期归档的文物好像都会用双语进行说明登记。而说明就写了，这个石板和「文谷案」直接相关。"
                },
                {
                    "id": "722760123",
                    "speaker": "矢部",
                    "text": "说明还提到了石板的总数是八块，目前只回收了这一个。文谷密室根据记载也就在附近的那个位置。"
                },
                {
                    "id": "722760124",
                    "speaker": "矢部",
                    "text": "那就麻烦你们过去看看了。宝藏我倒是真的无所谓，能见证「文谷案」的结局我就很开心了。"
                }
            ]
        },
        {
            "id": "7227602",
            "objective": "根据矢部指示的方向，寻找线索",
            "dialogues": [
                {
                    "id": "722760201",
                    "speaker": "矢部",
                    "text": "那就麻烦你们过去看看了。千万别勉强自己啊，这种玄乎的事情还挺危险的。"
                }
            ]
        },
        {
            "id": "7227617",
            "objective": "调查该区域，寻找线索",
            "dialogues": []
        },
        {
            "id": "7227618",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "722760301",
                    "speaker": "派蒙",
                    "text": "咦，你听到了吗？上面似乎传来了什么奇怪的声音。"
                },
                {
                    "id": "722760302",
                    "speaker": "派蒙",
                    "text": "顺着声音的方向抬头看，天花板上还有个奇怪的纹路。"
                },
                {
                    "id": "722760303",
                    "speaker": "派蒙",
                    "text": "唔，我们去上面看看吧。"
                }
            ]
        },
        {
            "id": "7227619",
            "objective": "前往声音源头，寻找线索",
            "dialogues": []
        },
        {
            "id": "7227603",
            "objective": "调查前方的秘密通道",
            "dialogues": [
                {
                    "id": "722760401",
                    "speaker": "派蒙",
                    "text": "看起来，通向藏宝室的关键就是这个了。"
                },
                {
                    "id": "722760402",
                    "speaker": "派蒙",
                    "text": "石板的大小也还算合适。刚好是…唔，三分之一？"
                },
                {
                    "id": "722760403",
                    "speaker": "Player",
                    "text": "九分之一。"
                },
                {
                    "id": "722760404",
                    "speaker": "派蒙",
                    "text": "哎呀，我就是这个意思啦。你明白就好。"
                },
                {
                    "id": "722760405",
                    "speaker": "派蒙",
                    "text": "也就是只要再找到八个石板放进这里就行了吧。",
                    "choices": [
                        {
                            "id": "722760406",
                            "text": "再找七个。",
                            "response": [
                                {
                                    "id": "722760408",
                                    "speaker": "派蒙",
                                    "text": "烦欸，知道了啦！"
                                },
                                {
                                    "id": "722760409",
                                    "speaker": "派蒙",
                                    "text": "那我们多留心一点，看到了这样的石板就收起来吧。"
                                },
                                {
                                    "id": "722760410",
                                    "speaker": "派蒙",
                                    "text": "不过现在没有一点线索，找起来完全没有头绪啊。",
                                    "choices": [
                                        {
                                            "id": "722760411",
                                            "text": "回去问问矢部吧。",
                                            "response": [
                                                {
                                                    "id": "722760412",
                                                    "speaker": "派蒙",
                                                    "text": "有道理。既然说明提到确定的石板有八块，应该不会一点记载都没有吧。"
                                                },
                                                {
                                                    "id": "722760416",
                                                    "speaker": "派蒙",
                                                    "text": "那我们就回去再找矢部问问吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722760413",
                                            "text": "托付给命运吧。",
                                            "response": [
                                                {
                                                    "id": "722760414",
                                                    "speaker": "派蒙",
                                                    "text": "放弃太早了吧！我觉得可以找矢部再问问。"
                                                },
                                                {
                                                    "id": "722760415",
                                                    "speaker": "派蒙",
                                                    "text": "既然说明都提到了八块石板，不至于一点线索都没有吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722760407",
                            "text": "一共八个。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7227626",
            "objective": "(test)(hide)检查是否已经集齐$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7227620",
            "objective": "与矢部对话",
            "dialogues": [
                {
                    "id": "722760501",
                    "speaker": "矢部",
                    "text": "你们回来了，有什么发现吗？"
                },
                {
                    "id": "722760502",
                    "speaker": "Player",
                    "text": "确实有个密室。"
                },
                {
                    "id": "722760503",
                    "speaker": "矢部",
                    "text": "哦哦，那看起来确有其事咯？"
                },
                {
                    "id": "722760504",
                    "speaker": "矢部",
                    "text": "根据说明上的描述，剩下的石板都被集中放在了三个区域里。"
                },
                {
                    "id": "722760505",
                    "speaker": "矢部",
                    "text": "你手上有阿祇小姐的简易地图吧？我来给你指指。"
                },
                {
                    "id": "722760506",
                    "speaker": "Player",
                    "text": "你为什么刚才不说？"
                },
                {
                    "id": "722760507",
                    "speaker": "矢部",
                    "text": "这不是因为这三片地都位于险境之中嘛？要是密室本身就是无稽之谈，后面当然就不用看了。"
                },
                {
                    "id": "722760508",
                    "speaker": "矢部",
                    "text": "如果这只是先祖大人们留下的恶作剧，我哪好意思让你深入黑雾呢。"
                },
                {
                    "id": "722760509",
                    "speaker": "矢部",
                    "text": "好了，就是这些地方。"
                },
                {
                    "id": "722760510",
                    "speaker": "矢部",
                    "text": "希、希望我没理解错吧…"
                }
            ]
        },
        {
            "id": "7227604",
