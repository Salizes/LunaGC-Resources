    "talks": [
        {
            "id": "4133814",
            "objective": "（活动接取任务）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4133801",
            "objective": "与甜甜对话",
            "dialogues": [
                {
                    "id": "413380101",
                    "speaker": "甜甜",
                    "text": "呃…怎么都没有人来…"
                },
                {
                    "id": "413380102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "413380103",
                    "speaker": "甜甜",
                    "text": "旅行者！请、请听我说…最近不是海灯节吗？协会想要借着节日的氛围宣传一下，然后试着招募冒险家。"
                },
                {
                    "id": "413380104",
                    "speaker": "甜甜",
                    "text": "我听说小千想出了一个什么…什么图的新玩法，我也不能落后！"
                },
                {
                    "id": "413380105",
                    "speaker": "甜甜",
                    "text": "所以我也构想了一套活动方案，叫…「冒险行动初体验」。"
                },
                {
                    "id": "413380106",
                    "speaker": "甜甜",
                    "text": "简单来说，就是我想要以霄灯做标识，标记出一条空中的飞行道路来。"
                },
                {
                    "id": "413380107",
                    "speaker": "甜甜",
                    "text": "然后，想要体验这个活动的人，就可以展开「风之翼」，顺着霄灯一路飞过去…"
                },
                {
                    "id": "413380108",
                    "speaker": "甜甜",
                    "text": "既能体验冒险的刺激感，又能俯瞰璃月的美景，还有霄灯在旁边，是不是感觉很不错？"
                },
                {
                    "id": "413380109",
                    "speaker": "甜甜",
                    "text": "我本来设计了两条赛道，但我跟千岩军报备的时候，他们却要求我事先找人评估安全性，就是先找人试飞一下…"
                },
                {
                    "id": "413380110",
                    "speaker": "甜甜",
                    "text": "你应该很有冒险经验吧？如、如果你愿意的话，能帮我去「评估」一下吗？"
                },
                {
                    "id": "413380111",
                    "speaker": "Player",
                    "text": "没问题。"
                },
                {
                    "id": "413380112",
                    "speaker": "甜甜",
                    "text": "谢谢你愿意帮忙，那我们快去天衡山吧，我布置的第一条赛道是从那里开始的。"
                }
            ]
        },
        {
            "id": "4133802",
            "objective": "前往天衡山寻找甜甜",
            "dialogues": [
                {
                    "id": "413380203",
                    "speaker": "Player",
                    "text": "开始吧。"
                }
            ]
        },
        {
            "id": "4133803",
            "objective": "收集霄灯",
            "dialogues": [
                {
                    "id": "413380301",
                    "speaker": "甜甜",
                    "text": "这里就是终点啦。你飞得很熟练嘛…这条路给你的感觉怎么样？",
                    "choices": [
                        {
                            "id": "413380302",
                            "text": "很有节日的氛围…",
                            "response": [
                                {
                                    "id": "413380304",
                                    "speaker": "甜甜",
                                    "text": "嘿嘿，那当然了，这些可都是我特意布置的。"
                                },
                                {
                                    "id": "413380305",
                                    "speaker": "甜甜",
                                    "text": "那我们接着去下一条赛道吧。"
                                }
                            ]
                        },
                        {
                            "id": "413380303",
                            "text": "霄灯挺好看的…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4133804",
            "objective": "收集霄灯",
            "dialogues": [
                {
                    "id": "413380401",
                    "speaker": "甜甜",
                    "text": "唔，这里就是这条赛道的起点了，我在这里也布置了霄灯。"
                },
                {
                    "id": "413380402",
                    "speaker": "甜甜",
                    "text": "你准备好了就开始吧，还是一样，一边搜集霄灯，一边飞到终点吧。"
                }
            ]
        },
        {
            "id": "4133805",
            "objective": "收集霄灯",
            "dialogues": [
                {
                    "id": "413380501",
                    "speaker": "甜甜",
                    "text": "两条赛道体验下来的感觉如何？"
                },
                {
                    "id": "413380502",
                    "speaker": "Player",
                    "text": "还不错。"
                },
                {
                    "id": "413380503",
                    "speaker": "甜甜",
                    "text": "那就太好了， 这下我就可以正式去跟千岩军申报了。"
                },
                {
                    "id": "413380504",
                    "speaker": "甜甜",
                    "text": "这么有趣的冒险活动，肯定会有很多人想要加入冒险家协会的。"
                },
                {
                    "id": "413380505",
                    "speaker": "甜甜",
                    "text": "对了，这是你帮我评估赛道的报酬，请收下吧。"
                }
            ]
        },
