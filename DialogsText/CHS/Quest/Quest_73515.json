    "talks": [
        {
            "id": "7351502",
            "objective": "等待至次日（8-12点）",
            "dialogues": []
        },
        {
            "id": "7351501",
            "objective": "与两位学者对话",
            "dialogues": [
                {
                    "id": "735150101",
                    "speaker": "维纳亚克",
                    "text": "你来了啊，冒险家。我们正打算安装呢。"
                },
                {
                    "id": "735150102",
                    "speaker": "维纳亚克",
                    "text": "要是一切顺利的话，今天就能给那家伙来一记狠的了！"
                },
                {
                    "id": "735150103",
                    "speaker": "施芮娅",
                    "text": "在正式的充能过程中，可能也会有魔物过来侵扰。届时就得麻烦您多留意装置充能跟破损的情况了。",
                    "choices": [
                        {
                            "id": "735150104",
                            "text": "交给我。",
                            "response": [
                                {
                                    "id": "735150106",
                                    "speaker": "施芮娅",
                                    "text": "多谢你了，冒险家。"
                                },
                                {
                                    "id": "735150107",
                                    "speaker": "维纳亚克",
                                    "text": "啊——我想到一个好主意！你都为「对沙虫用杀虫炮」忙前忙后了这么久，这首次试射的荣耀…干脆就交给你吧！",
                                    "choices": [
                                        {
                                            "id": "735150108",
                                            "text": "你不打算自己来吗？",
                                            "response": [
                                                {
                                                    "id": "735150109",
                                                    "speaker": "维纳亚克",
                                                    "text": "我只要看着它落地就已经心满意足啦！何况让别人去点火，我们才能欣赏到它开火时的全貌嘛…咳！总之！"
                                                },
                                                {
                                                    "id": "735150112",
                                                    "speaker": "维纳亚克",
                                                    "text": "你只需要从魔物手里保护好充能装置，等待能量蓄满之后，看准沙虫露出破绽的瞬间——再狠狠地往炮台上敲上一记就好啦！"
                                                },
                                                {
                                                    "id": "735150113",
                                                    "speaker": "维纳亚克",
                                                    "text": "剩下的事情，点火装置和自动修正机关会帮你搞定！"
                                                },
                                                {
                                                    "id": "735150114",
                                                    "speaker": "派蒙",
                                                    "text": "#听起来好厉害…{NICKNAME}！我也想看看！"
                                                },
                                                {
                                                    "id": "735150115",
                                                    "speaker": "Player",
                                                    "text": "行吧，我来操作。"
                                                },
                                                {
                                                    "id": "735150116",
                                                    "speaker": "维纳亚克",
                                                    "text": "嘿嘿，那就这么说定了！我来给你讲讲具体的操作流程…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735150110",
                                            "text": "我不知道怎么操作…",
                                            "response": [
                                                {
                                                    "id": "735150111",
                                                    "speaker": "维纳亚克",
                                                    "text": "你放心！我设计它的时候可是完美遵循了简单易用的交互原则。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735150105",
                            "text": "没问题。"
                        }
                    ]
                }
            ]
        }
    ]
}