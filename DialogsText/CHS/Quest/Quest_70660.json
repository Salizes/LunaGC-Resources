    "talks": [
        {
            "id": "7066001",
            "objective": "与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "706600101",
                    "speaker": "凯瑟琳",
                    "text": "你好，冒险家，最近的冒险行动还顺利吗？",
                    "choices": [
                        {
                            "id": "706600102",
                            "text": "还算顺利。",
                            "response": [
                                {
                                    "id": "706600103",
                                    "speaker": "凯瑟琳",
                                    "text": "顺利就好，继续这么磨炼下去，你一定能成为一名伟大的冒险家。"
                                },
                                {
                                    "id": "706600104",
                                    "speaker": "凯瑟琳",
                                    "text": "对了，如果你有兴趣的话，可以去吉盖克斯先生那边，试玩一下最新的「风行迷踪」。"
                                },
                                {
                                    "id": "706600108",
                                    "speaker": "Player",
                                    "text": "这…和冒险家协会有关系吗？"
                                },
                                {
                                    "id": "706600109",
                                    "speaker": "凯瑟琳",
                                    "text": "这个啊…因为吉盖克斯先生在协会这边挂了一个委托，拜托我们帮他招募试玩「风行迷踪」的人…"
                                },
                                {
                                    "id": "706600110",
                                    "speaker": "凯瑟琳",
                                    "text": "从这方面说…勉强算是有些关系吧。"
                                },
                                {
                                    "id": "706600111",
                                    "speaker": "凯瑟琳",
                                    "text": "总之，如果你愿意的话，就过去试玩一下吧。据试玩过的冒险家们说，「风行迷踪」玩起来还挺有意思的…"
                                }
                            ]
                        },
                        {
                            "id": "706600105",
                            "text": "有什么新委托吗？",
                            "response": [
                                {
                                    "id": "706600106",
                                    "speaker": "凯瑟琳",
                                    "text": "委托…倒是没有。"
                                },
                                {
                                    "id": "706600107",
                                    "speaker": "凯瑟琳",
                                    "text": "但如果你有兴趣的话，可以去吉盖克斯先生那边，试玩一下最新的「风行迷踪」。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7066005",
            "objective": "(test)与吉盖克斯对话$HIDDEN",
            "dialogues": [
                {
                    "id": "706600201",
                    "speaker": "吉盖克斯",
                    "text": "你好，想试试「风行迷踪」吗？",
                    "choices": [
                        {
                            "id": "706600202",
                            "text": "「风行迷踪」是什么？",
                            "response": [
                                {
                                    "id": "706600203",
                                    "speaker": "吉盖克斯",
                                    "text": "啊哈，问得好，「风行迷踪」是一款承载着蒙德城历史的游戏！"
                                },
                                {
                                    "id": "706600204",
                                    "speaker": "吉盖克斯",
                                    "text": "你应该知道，在之前的蒙德城里有一群「贵族」吧？"
                                },
                                {
                                    "id": "706600205",
                                    "speaker": "吉盖克斯",
                                    "text": "他们在蒙德城里暴行不断，让不少人都苦不堪言…"
                                },
                                {
                                    "id": "706600206",
                                    "speaker": "吉盖克斯",
                                    "text": "为了反抗贵族们的种种暴行，有一群勇敢的蒙德人聚集了起来，形成了一个秘密的反抗组织。"
                                },
                                {
                                    "id": "706600207",
                                    "speaker": "吉盖克斯",
                                    "text": "这群游侠们不断在蒙德各处展开行动，让贵族们颇吃了些苦头。"
                                },
                                {
                                    "id": "706600208",
                                    "speaker": "吉盖克斯",
                                    "text": "但是，那些贵族们也很快训练出了一群用来镇压游侠们的爪牙。"
                                },
                                {
                                    "id": "706600209",
                                    "speaker": "吉盖克斯",
                                    "text": "于是，游侠们和贵族们的爪牙们，就这样在蒙德各处展开了一场又一场的对决。"
                                },
                                {
                                    "id": "706600210",
                                    "speaker": "吉盖克斯",
                                    "text": "「风行迷踪」，正是取材于这样史诗一般的真实历史事件！曾经也是很受欢迎的…"
                                },
                                {
                                    "id": "706600211",
                                    "speaker": "Player",
                                    "text": "曾经？"
                                },
                                {
                                    "id": "706600212",
                                    "speaker": "吉盖克斯",
                                    "text": "是啊，现在城里的年轻人们对于「风行迷踪」可没多少兴趣了…"
                                },
                                {
                                    "id": "706600213",
                                    "speaker": "吉盖克斯",
                                    "text": "但我可不想让「风行迷踪」就此失传，所以，我对它原来的规则做了些调整，让游戏规则更容易被理解，也更有趣。"
                                },
                                {
                                    "id": "706600214",
                                    "speaker": "吉盖克斯",
                                    "text": "除此之外，我还特意添加了好几张全新的游戏地图。我觉得，这样应该会有更多的人来玩吧…"
                                }
                            ]
                        },
                        {
                            "id": "706600217",
                            "text": "关于「风行迷踪」的情况…",
                            "response": [
                                {
                                    "id": "706600218",
                                    "speaker": "吉盖克斯",
                                    "text": "我之前就招募过一次试玩「风行迷踪」的人，那些人里有几个技术很出众，让我印象很深。"
                                },
                                {
                                    "id": "706600219",
                                    "speaker": "吉盖克斯",
                                    "text": "但除了他们之外，还是有不少人和我说这个游戏很难，要么游侠很难跑掉，要么猎手找不到人。"
                                },
                                {
                                    "id": "706600220",
                                    "speaker": "吉盖克斯",
                                    "text": "还有人向我抱怨，如果想要玩好这游戏，就必须熟悉每张图的每个细节，实在是太麻烦了，希望我简化游戏的玩法。"
                                },
                                {
                                    "id": "706600221",
                                    "speaker": "吉盖克斯",
                                    "text": "唉，我也不知道他们说的对不对，所以我就想再招募一批人来试玩，听听他们的意见。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
