    "talks": [
        {
            "id": "7566601",
            "objective": "与普萨科对话",
            "dialogues": [
                {
                    "id": "756660101",
                    "speaker": "普萨科",
                    "text": "好嘞！这样就准备好了。不过…总感觉差点什么…"
                },
                {
                    "id": "756660102",
                    "speaker": "普萨科",
                    "text": "#{NICKNAME}！你来得正好，想不想痛痛快快地玩一场喷涂游戏？",
                    "choices": [
                        {
                            "id": "756660103",
                            "text": "喷涂游戏？",
                            "response": [
                                {
                                    "id": "756660105",
                                    "speaker": "普萨科",
                                    "text": "哈哈哈哈哈，别这么紧张嘛。真的就只是一场游戏而已。"
                                },
                                {
                                    "id": "756660106",
                                    "speaker": "普萨科",
                                    "text": "我保证，一点危险性都没有。最大的风险，也就是会把你衣服弄脏。"
                                },
                                {
                                    "id": "756660107",
                                    "speaker": "Player",
                                    "text": "我不是很擅长喷涂…"
                                },
                                {
                                    "id": "756660108",
                                    "speaker": "普萨科",
                                    "text": "放心放心，这场喷涂游戏由我亲自设计，不需要任何喷涂基础也能玩个开心。"
                                },
                                {
                                    "id": "756660109",
                                    "speaker": "普萨科",
                                    "text": "虽然我被拉过来的时候，是被要求做一个够大，够酷，够有气势的喷涂对象…"
                                },
                                {
                                    "id": "756660110",
                                    "speaker": "普萨科",
                                    "text": "不过嘛，从事实上来看，虽然我把那个够酷的喷涂对象造出来了，但并不是每一个人都能够把它喷好。"
                                },
                                {
                                    "id": "756660111",
                                    "speaker": "普萨科",
                                    "text": "所以，我就把它给简化了一下，把有趣的重点放在了喷涂的「过程」上。"
                                },
                                {
                                    "id": "756660112",
                                    "speaker": "普萨科",
                                    "text": "简单来说就是…呃，我也不知道怎么简单来说，但总之你玩玩就知道了。"
                                },
                                {
                                    "id": "756660113",
                                    "speaker": "普萨科",
                                    "text": "好了，说再多也不如自己亲手试试，上场上场！"
                                }
                            ]
                        },
                        {
                            "id": "756660104",
                            "text": "难道是什么战斗训练？"
                        }
                    ]
                }
            ]
        }
    ]
}