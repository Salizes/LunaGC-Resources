    "talks": [
        {
            "id": "7608501",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760850101",
                    "speaker": "「少女」",
                    "text": "……"
                },
                {
                    "id": "760850102",
                    "speaker": "派蒙",
                    "text": "哎呀，她明明蒙着眼睛，我却能感觉出她在盯着你呢。"
                },
                {
                    "id": "760850103",
                    "speaker": "「少女」",
                    "text": "唔…想尝尝酒馆里其他口味饮品了。"
                }
            ]
        },
        {
            "id": "7608502",
            "objective": "调制饮品",
            "dialogues": [
                {
