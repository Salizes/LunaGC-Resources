    "talks": [
        {
            "id": "7413801",
            "objective": "与基肖恩对话",
            "dialogues": [
                {
                    "id": "741380101",
                    "speaker": "基肖恩",
                    "text": "嘿，回来了吗？你们刚才可错过了一场好戏啊。"
                },
                {
                    "id": "741380102",
                    "speaker": "派蒙",
                    "text": "好戏？发生什么事了？"
                },
                {
                    "id": "741380103",
                    "speaker": "基肖恩",
                    "text": "刚刚我带着回收来的水母，在这里等奥格劳先生核查。结果奥格劳先生还没来，之前的买家倒是找上门了。"
                },
                {
                    "id": "741380104",
                    "speaker": "基肖恩",
                    "text": "他们说自从放生了前几批水母，这人也精神了，生意也顺畅了，一定是做了好事，有神明眷顾！所以就想找我再买一批去放生。",
                    "choices": [
                        {
                            "id": "741380105",
                            "text": "我这边还在抓…",
                            "response": [
                                {
                                    "id": "741380107",
                                    "speaker": "派蒙",
                                    "text": "#唔唔…{NICKNAME}抓，基肖恩先生卖，买家再去放生…喂！你难道是在用这个方法赚钱吗？！"
                                },
                                {
                                    "id": "741380108",
                                    "speaker": "基肖恩",
                                    "text": "没有！没有！怎么可能！？我可不想再被警备队的人找麻烦了！"
                                },
                                {
                                    "id": "741380109",
                                    "speaker": "基肖恩",
                                    "text": "咳咳…我跟他们说明了好久，放生这些水母有害无益，可他们就是不听！"
                                },
                                {
                                    "id": "741380110",
                                    "speaker": "基肖恩",
                                    "text": "愣是觉得自己最近走了好运，就是因为做了这种…他们所认为的好事。"
                                },
                                {
                                    "id": "741380111",
                                    "speaker": "基肖恩",
                                    "text": "还觉得我接连倒霉，也是囚禁水母带给我的报应。唉…这帮人到底在想什么…"
                                },
                                {
                                    "id": "741380112",
                                    "speaker": "基肖恩",
                                    "text": "我们还在争辩着呢，奥格劳先生就来了，直接把这群人扣了回去。",
                                    "choices": [
                                        {
                                            "id": "741380113",
                                            "text": "好运到头了。",
                                            "response": [
                                                {
                                                    "id": "741380115",
                                                    "speaker": "基肖恩",
                                                    "text": "…说到底，不去了解生物的习性和生态就胡乱放生，为的究竟是这些生命，还是自己的好运呢？"
                                                },
                                                {
                                                    "id": "741380116",
                                                    "speaker": "派蒙",
                                                    "text": "最后还被警备队抓走了…看起来也没多少好运嘛？"
                                                },
                                                {
                                                    "id": "741380117",
                                                    "speaker": "基肖恩",
                                                    "text": "哈，顺带一提，警备队已经免了我的牢狱之灾，多亏有你们帮忙了。"
                                                },
                                                {
                                                    "id": "741380118",
                                                    "speaker": "基肖恩",
                                                    "text": "除了之前说好的报酬，我还准备了一点纪念品，请不要客气。"
                                                },
                                                {
                                                    "id": "741380119",
                                                    "speaker": "Black Screen",
                                                    "text": "基肖恩取出了一只水母球…"
                                                },
                                                {
                                                    "id": "741380120",
                                                    "speaker": "派蒙",
                                                    "text": "欸…这个是？「荧光紫水母」？看着比之前的小好多…"
                                                },
                                                {
                                                    "id": "741380121",
                                                    "speaker": "基肖恩",
                                                    "text": "没错，昨天我从库存的水母苗里挑了一些合适的样本，挨个记录编号后又多出了几只，我想…不如就送给你们，做个纪念吧。"
                                                },
                                                {
                                                    "id": "741380122",
                                                    "speaker": "基肖恩",
                                                    "text": "剩下的水母我会带回去继续培育，看看怎么让它们在自然环境下野化。"
                                                },
                                                {
                                                    "id": "741380123",
                                                    "speaker": "基肖恩",
                                                    "text": "而且我也打算留下一些「荧光紫水母」的样本，研究研究聚集发光的成因…",
                                                    "choices": [
                                                        {
                                                            "id": "741380124",
                                                            "text": "看起来还挺可爱的…",
                                                            "response": [
                                                                {
                                                                    "id": "741380126",
                                                                    "speaker": "基肖恩",
                                                                    "text": "等、等等——你可千万别再把它们放生了啊！！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741380125",
                                                            "text": "放水里游起来会不会更可爱…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741380114",
                                            "text": "自作自受呢。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741380106",
                            "text": "你居然还在卖…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7413899",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741389901",
                    "speaker": "派蒙",
                    "text": "这段时间我们抓了不少水母呢，不知道基肖恩说的生态恢复得怎么样了…"
                },
                {
                    "id": "741389902",
                    "speaker": "派蒙",
                    "text": "现在就去找他看看吧，希望他还没被警备队抓走…"
                }
            ]
        }
    ]
}