    "talks": [
        {
            "id": "7054501",
            "objective": "(test)彩蛋对话2$HIDDEN",
            "dialogues": [
                {
                    "id": "705450101",
                    "speaker": "安柏",
                    "text": "喵，喵喵——喵——"
                },
                {
                    "id": "705450102",
                    "speaker": "「兔叽」",
                    "text": "喵！喵喵喵！"
                },
                {
                    "id": "705450103",
                    "speaker": "派蒙",
                    "text": "嗯…「兔叽」和安柏都说得很有道理…"
                },
                {
                    "id": "705450104",
                    "speaker": "派蒙",
                    "text": "喔，原来如此啊…",
                    "choices": [
                        {
                            "id": "705450105",
                            "text": "确实，说得是呢…",
                            "response": [
                                {
                                    "id": "705450107",
                                    "speaker": "派蒙",
                                    "text": "其实我也不太明白啦，但我明显感觉到，安柏和「兔叽」达成了共识！"
                                },
                                {
                                    "id": "705450108",
                                    "speaker": "安柏",
                                    "text": "#{NICKNAME}和派蒙啊！你们来啦，我刚想着去找你们呢。"
                                },
                                {
                                    "id": "705450109",
                                    "speaker": "安柏",
                                    "text": "你们协助运营这家「猫茸茸城堡」的事，我已经听瓦乐瑞娜小姐说了。"
                                },
                                {
                                    "id": "705450110",
                                    "speaker": "安柏",
                                    "text": "#不愧是{NICKNAME}，一回蒙德就帮了这么大的忙。",
                                    "choices": [
                                        {
                                            "id": "705450111",
                                            "text": "毕竟我是什么任务都干的荣誉骑士。",
                                            "response": [
                                                {
                                                    "id": "705450113",
                                                    "speaker": "派蒙",
                                                    "text": "说起来，刚才安柏和「兔叽」正在聊什么呢？好像聊得很开心的样子。"
                                                },
                                                {
                                                    "id": "705450114",
                                                    "speaker": "「兔叽」",
                                                    "text": "喵，喵喵？"
                                                },
                                                {
                                                    "id": "705450115",
                                                    "speaker": "安柏",
                                                    "text": "嗯…我正在问「兔叽」今天的天气怎么样，会不会下雨呢。"
                                                },
                                                {
                                                    "id": "705450116",
                                                    "speaker": "派蒙",
                                                    "text": "欸？小猫还擅长做这种事吗？"
                                                },
                                                {
                                                    "id": "705450117",
                                                    "speaker": "安柏",
                                                    "text": "嘿嘿，我也是听丽莎小姐说的啦。"
                                                },
                                                {
                                                    "id": "705450118",
                                                    "speaker": "安柏",
                                                    "text": "丽莎小姐看过的一本书里写着，小猫们对湿气很敏感，而且也不太喜欢湿漉漉的感觉。"
                                                },
                                                {
                                                    "id": "705450119",
                                                    "speaker": "安柏",
                                                    "text": "所以，如果感觉到空气中的湿气突然增大，就会焦躁不安地不断开始揉脸和舔毛。"
                                                },
                                                {
                                                    "id": "705450120",
                                                    "speaker": "安柏",
                                                    "text": "小猫们一旦作出这样的举动，就预示到可能会有大雨来到。"
                                                },
                                                {
                                                    "id": "705450121",
                                                    "speaker": "派蒙",
                                                    "text": "原来还有这种神奇的道理…无意中学到了很特别的知识！"
                                                },
                                                {
                                                    "id": "705450122",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，以后我们旅行的时候，可以多多观察猫猫，这样就不至于…老是被乌云倒下来的大雨浇得一身湿了！",
                                                    "choices": [
                                                        {
                                                            "id": "705450123",
                                                            "text": "那以后还真得多注意注意了。",
                                                            "response": [
                                                                {
                                                                    "id": "705450125",
                                                                    "speaker": "安柏",
                                                                    "text": "本来我今天是来向瓦乐瑞娜小姐打听一件事的。"
                                                                },
                                                                {
                                                                    "id": "705450126",
                                                                    "speaker": "安柏",
                                                                    "text": "我正在和她聊着呢，这只小猫就凑过来，趴在我旁边打了大大的一个哈欠，太可爱了！"
                                                                },
                                                                {
                                                                    "id": "705450127",
                                                                    "speaker": "安柏",
                                                                    "text": "她都对我这么亲近了，那…那我也得表示一下友好呀。"
                                                                },
                                                                {
                                                                    "id": "705450128",
                                                                    "speaker": "安柏",
                                                                    "text": "然后，我就想起了丽莎小姐告诉我的事，就顺便向「兔叽」问问天气啦。"
                                                                },
                                                                {
                                                                    "id": "705450129",
                                                                    "speaker": "安柏",
                                                                    "text": "但是「兔叽」一会揉脸，一会摇尾巴，一会又趴在地上蹭我的手…"
                                                                },
                                                                {
                                                                    "id": "705450130",
                                                                    "speaker": "安柏",
                                                                    "text": "唔，未来几天，到底会不会下雨呢…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705450124",
                                                            "text": "我本来就很关注路边的猫猫！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705450112",
                                            "text": "守护蒙德城的小猫也是职责之一嘛。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705450106",
                            "text": "慢着，我没懂呢！"
                        }
                    ]
                }
            ]
        }
    ]
}