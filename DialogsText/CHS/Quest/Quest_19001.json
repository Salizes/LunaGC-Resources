            "objective": "与维多利亚修女对话",
            "dialogues": [
                {
                    "id": "190010101",
                    "speaker": "维多利亚",
                    "text": "芭芭拉小姐…不会出了什么事吧…"
                },
                {
                    "id": "190010102",
                    "speaker": "Player",
                    "text": "芭芭拉怎么了？"
                },
                {
                    "id": "190010103",
                    "speaker": "维多利亚",
                    "text": "芭芭拉小姐说自己要外出采药，但是到现在还没回来。"
                },
                {
                    "id": "190010104",
                    "speaker": "维多利亚",
                    "text": "难道要向西风骑士团报告吗…"
                },
                {
                    "id": "190010105",
                    "speaker": "Player",
                    "text": "我去找芭芭拉。"
                },
                {
                    "id": "190010106",
                    "speaker": "维多利亚",
                    "text": "你？哦…你这位「荣誉骑士」确实很合适…"
                },
                {
                    "id": "190010107",
                    "speaker": "维多利亚",
                    "text": "这样的话，倒也免了向骑士团报告后的一堆麻烦事…"
                },
                {
                    "id": "190010108",
                    "speaker": "维多利亚",
                    "text": "那就拜托你了，芭芭拉小姐在离开之前说，她准备去奔狼领附近采药。"
                },
                {
                    "id": "190010109",
                    "speaker": "维多利亚",
                    "text": "你可以去那边找找她。"
                }
            ]
        },
        {
            "id": "1900102",
            "objective": "寻找芭芭拉",
            "dialogues": [
                {
                    "id": "190010201",
                    "speaker": "维多利亚",
                    "text": "芭芭拉小姐…到底去哪了呢…"
