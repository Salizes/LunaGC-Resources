        {
            "id": "1010119",
            "objective": "寻找元素痕迹",
            "dialogues": []
        },
        {
            "id": "1010120",
            "objective": "(test)与丽莎对话（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "101012001",
                    "speaker": "丽莎",
                    "text": "应该就在这附近。"
                },
                {
                    "id": "101012002",
                    "speaker": "丽莎",
                    "text": "在<color=#00E1FFFF>「元素视野」</color>下甚至都能看到<color=#00E1FFFF>魔力</color>的流动了。"
                },
                {
                    "id": "101012003",
                    "speaker": "丽莎",
                    "text": "顺着<color=#00E1FFFF>魔力</color>流动的方向，去把书本找出来吧。"
                }
            ]
        },
        {
            "id": "1010101",
            "objective": "搜索元素痕迹指向的方向",
            "dialogues": []
        },
        {
            "id": "1010102",
            "objective": "(test)到达目标点1（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "101010201",
                    "speaker": "丽莎",
                    "text": "这里的元素痕迹很重，不过似乎只是偷书人在这儿<color=#00E1FFFF>短暂停留</color>过。"
                }
            ]
        },
        {
            "id": "1010103",
            "objective": "(test)到达目标点2（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1010104",
            "objective": "(test)到达目标点3（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1010105",
            "objective": "(test)到达目标点4（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1010106",
            "objective": "(test)到达目标点5（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1010114",
            "objective": "(test)发现副本后让丽莎消失（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "101010701",
                    "speaker": "派蒙",
                    "text": "居然是住在<color=#00E1FFFF>遗迹</color>里的吗？蒙德人偶尔也有奇怪的癖好呢。"
                },
                {
                    "id": "101010702",
                    "speaker": "丽莎",
                    "text": "请不要这么随意揣测蒙德人的居住习惯。"
                },
                {
                    "id": "101010703",
                    "speaker": "丽莎",
                    "text": "我倒是觉得更像那些不讨人喜欢的「捣乱分子」的作风呢。",
                    "choices": [
                        {
                            "id": "101010704",
                            "text": "是丘丘人？",
                            "response": [
                                {
                                    "id": "101010705",
                                    "speaker": "丽莎",
                                    "text": "偷盗书本的事可不太适合丘丘人呢。"
                                },
                                {
                                    "id": "101010706",
                                    "speaker": "丽莎",
                                    "text": "毕竟它们大概只会把书本点着来取暖。"
                                },
                                {
                                    "id": "101010712",
                                    "speaker": "丽莎",
                                    "text": "还是<color=#00E1FFFF>深渊教团</color>作案的可能性大一些，毕竟本来就是些神出鬼没的家伙。"
                                },
                                {
                                    "id": "101010713",
                                    "speaker": "丽莎",
                                    "text": "况且…这遗迹入口的元素封印，也像是深渊法师留下的魔力痕迹。"
                                },
                                {
                                    "id": "101010714",
                                    "speaker": "派蒙",
                                    "text": "是封印吗，那要怎么解开呢…该不会又要花很多功夫吧…"
                                },
                                {
                                    "id": "101010715",
                                    "speaker": "丽莎",
                                    "text": "如果这点程度的元素力，就想把我拒之门外，那还真是小瞧人了。"
                                },
                                {
                                    "id": "101010716",
                                    "speaker": "派蒙",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "101010717",
                                    "speaker": "丽莎",
                                    "text": "我们进去吧。"
                                },
                                {
                                    "id": "101010718",
                                    "speaker": "派蒙",
                                    "text": "呜…哇…"
                                },
                                {
                                    "id": "101010719",
                                    "speaker": "派蒙",
                                    "text": "这就是工作中的丽莎小姐吗…"
                                }
                            ]
                        },
                        {
                            "id": "101010707",
                            "text": "是深渊教团？",
                            "response": [
                                {
                                    "id": "101010708",
                                    "speaker": "丽莎",
                                    "text": "不愧是你，跟我心有灵犀哦。"
                                }
                            ]
                        },
                        {
                            "id": "101010709",
                            "text": "是冒险家协会？",
                            "response": [
                                {
                                    "id": "101010710",
                                    "speaker": "丽莎",
                                    "text": "嗯…从总是在地下遗迹钻来钻去的角度上确实…"
                                },
                                {
                                    "id": "101010711",
                                    "speaker": "丽莎",
                                    "text": "但他们不会随便拿别人的东西…唔，更正一下，至少不会拿活着的人的东西。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1010121",
            "objective": "(test)开启地城入口（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1010107",
            "objective": "进入偷书者的藏身处",
            "dialogues": []
        },
        {
            "id": "1010111",
            "objective": "击败来袭的敌人",
            "dialogues": [
                {
                    "id": "101011101",
                    "speaker": "派蒙",
                    "text": "这里面出人意料地宽敞呢…"
                }
            ]
        },
        {
            "id": "1010113",
            "objective": "击败深渊教团的敌人",
            "dialogues": []
        },
        {
            "id": "1010112",
            "objective": "(test)击败深渊法师后的对话（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "101011201",
                    "speaker": "深渊法师",
                    "text": "你们…是怎么…找到这里，明明已经…刻意隐藏…"
                },
                {
                    "id": "101011202",
                    "speaker": "丽莎",
                    "text": "我对你们这些家伙藏在哪里可没兴趣，只是来要回书本。"
                },
                {
                    "id": "101011203",
                    "speaker": "丽莎",
                    "text": "有时间隐藏据点，布设封印…却没时间办出借手续吗？"
                },
                {
                    "id": "101011204",
                    "speaker": "丽莎",
                    "text": "真是不懂得尊重他人工作的家伙。"
                },
                {
                    "id": "101011205",
                    "speaker": "深渊法师",
                    "text": "原来是…为了<color=#00E1FFFF>那本书</color>…"
                },
                {
                    "id": "101011206",
                    "speaker": "深渊法师",
                    "text": "没想到蒙德这种地方…居然也有人…参透书中的秘密…"
                },
                {
                    "id": "101011207",
                    "speaker": "深渊法师",
                    "text": "你…到底是谁？"
                },
                {
                    "id": "101011208",
                    "speaker": "丽莎",
                    "text": "图书馆的管理员。说了这么多，还要问吗？"
                },
                {
                    "id": "101011209",
                    "speaker": "丽莎",
                    "text": "请归还书本，这是最后通牒哦。"
                },
                {
                    "id": "101011210",
                    "speaker": "深渊法师",
                    "text": "哼…居然想…隐藏身份…"
                },
                {
                    "id": "101011211",
                    "speaker": "深渊法师",
                    "text": "既然如此…就更不能把书拿出来了…"
                },
                {
                    "id": "101011212",
                    "speaker": "深渊法师",
                    "text": "毕竟…那可是关乎…「那个秘密」…"
                },
                {
                    "id": "101011213",
                    "speaker": "深渊法师",
                    "text": "咦？！啊…你…你想做什么！这种量级的元素力…你难道要——"
                },
                {
                    "id": "101011214",
                    "speaker": "深渊法师",
                    "text": "啊啊啊啊啊———————！！！",
                    "choices": [
                        {
                            "id": "101011215",
                            "text": "好、好强！！",
                            "response": [
                                {
                                    "id": "101011217",
                                    "speaker": "丽莎",
                                    "text": "呼…不好好听人说话的家伙，就应该受一点惩罚。",
                                    "choices": [
                                        {
                                            "id": "101011218",
                                            "text": "丽莎也没有听他把话说完吧…",
                                            "response": [
                                                {
                                                    "id": "101011220",
                                                    "speaker": "丽莎",
                                                    "text": "所以说，真是麻烦的工作。"
                                                },
                                                {
                                                    "id": "101011221",
                                                    "speaker": "丽莎",
                                                    "text": "好了，现在我们自己把书找出来吧，应该就在这附近才对。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101011219",
                                            "text": "这好像不只是一点点惩罚吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101011216",
                            "text": "好、好可怕！！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1010116",
            "objective": "寻找藏匿的书籍",
            "dialogues": []
        },
        {
            "id": "1010108",
            "objective": "(test)找到书本后的对话(隐藏)$HIDDEN",
            "dialogues": [
                {
                    "id": "101010801",
                    "speaker": "派蒙",
                    "text": "是<color=#00E1FFFF>《白之公主与六侏儒》</color>！我记得这个名字，应该就是它了吧？"
                },
                {
                    "id": "101010802",
                    "speaker": "丽莎",
                    "text": "是的哦，好在书本没有受到什么损坏呢，不然的话…"
                },
                {
                    "id": "101010803",
                    "speaker": "派蒙",
                    "text": "不然的话？难道丽莎还有什么更厉害的惩罚方式…"
                },
                {
                    "id": "101010804",
                    "speaker": "丽莎",
                    "text": "呵呵，那大概就要运用一些我在药剂学上的成果了呢。"
                },
                {
                    "id": "101010805",
                    "speaker": "派蒙",
                    "text": "呜！"
                },
                {
                    "id": "101010806",
                    "speaker": "丽莎",
                    "text": "不过话说回来，这本书根本不是「禁书区」的书，所以才会放心借给一般市民啊…"
                },
                {
                    "id": "101010807",
                    "speaker": "丽莎",
                    "text": "除了我做的标记之外，也没有任何异常的元素波动。"
                },
                {
                    "id": "101010808",
                    "speaker": "派蒙",
                    "text": "是喔。感觉完完全全只是一本普通的童话书而已嘛。",
                    "choices": [
                        {
                            "id": "101010809",
                            "text": "但为什么深渊教团…",
                            "response": [
                                {
                                    "id": "101010810",
                                    "speaker": "Player",
                                    "text": "（很神秘，令人好奇…）"
                                },
                                {
                                    "id": "101010811",
                                    "speaker": "丽莎",
                                    "text": "从图书管理员的角度来看，麻烦的工作已经做完啦。"
                                },
                                {
                                    "id": "101010812",
                                    "speaker": "丽莎",
                                    "text": "既然对这本书这么感兴趣，不如转借给你？",
                                    "choices": [
                                        {
                                            "id": "101010813",
                                            "text": "那…那还书期限是…？",
                                            "response": [
                                                {
                                                    "id": "101010814",
                                                    "speaker": "Player",
                                                    "text": "我可不想受到「惩罚」…"
                                                },
                                                {
                                                    "id": "101010815",
                                                    "speaker": "丽莎",
                                                    "text": "期限是无限期哦。我会把你登记为「保管人」而不是「出借人」的。"
                                                },
                                                {
                                                    "id": "101010816",
                                                    "speaker": "丽莎",
                                                    "text": "这是对值得信赖的好市民的特殊福利。"
                                                },
                                                {
                                                    "id": "101010817",
                                                    "speaker": "派蒙",
                                                    "text": "说是福利…怎么感觉只是把麻烦甩给了别人的样子？"
                                                },
                                                {
                                                    "id": "101010818",
                                                    "speaker": "丽莎",
                                                    "text": "哦~？对我的工作有什么不满吗？",
                                                    "choices": [
                                                        {
                                                            "id": "101010819",
                                                            "text": "没、没有！",
                                                            "response": [
                                                                {
                                                                    "id": "101010820",
                                                                    "speaker": "Player",
                                                                    "text": "我会好好珍惜书本的…"
                                                                },
                                                                {
                                                                    "id": "101010821",
                                                                    "speaker": "丽莎",
                                                                    "text": "唔嗯，果然通情达理，真想把你当成助手留在身边呢。"
                                                                },
                                                                {
                                                                    "id": "101010822",
                                                                    "speaker": "丽莎",
                                                                    "text": "那么今天的工作就到这里吧，我要先回去了。"
                                                                },
                                                                {
                                                                    "id": "101010823",
                                                                    "speaker": "丽莎",
                                                                    "text": "你也要记得来图书馆做一下登记啊。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "101010820",
                                                            "text": "我会好好珍惜书本的…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101010814",
                                            "text": "我可不想受到「惩罚」…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101010810",
                            "text": "（很神秘，令人好奇…）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1010122",
            "objective": "(test)删除试用角色（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1010109",
            "objective": "与丽莎对话",
            "dialogues": []
        },
        {
            "id": "1010110",
            "objective": "(test)与丽莎对话（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "101011001",
                    "speaker": "丽莎",
                    "text": "嗯？你们回来啦。书的保管手续已经办好了。"
                },
                {
                    "id": "101011002",
                    "speaker": "派蒙",
                    "text": "谢谢丽莎小姐！"
                },
                {
                    "id": "101011003",
                    "speaker": "派蒙",
                    "text": "嗯…不过总感觉还忘记了什么事…",
                    "choices": [
                        {
                            "id": "101011004",
                            "text": "是《提瓦特游览指南》！",
                            "response": [
                                {
                                    "id": "101011007",
                                    "speaker": "派蒙",
                                    "text": "——啊！那边架子上放着的…不就是<color=#00E1FFFF>《提瓦特游览指南》</color>吗？"
                                },
                                {
                                    "id": "101011008",
                                    "speaker": "派蒙",
                                    "text": "而且有好多本的样子！"
                                },
                                {
                                    "id": "101011009",
                                    "speaker": "丽莎",
                                    "text": "呵呵呵…其实<color=#00E1FFFF>《提瓦特游览指南》</color>是一种期刊，也不算是正式的馆藏…"
                                },
                                {
                                    "id": "101011010",
                                    "speaker": "派蒙",
                                    "text": "唔…唔？！"
                                },
                                {
                                    "id": "101011011",
                                    "speaker": "丽莎",
                                    "text": "拿一本去吧，算是今天作为我助手的酬劳。"
                                },
                                {
                                    "id": "101011012",
                                    "speaker": "丽莎",
                                    "text": "今天有你陪同，麻烦的工作稍微变得不那么枯燥了呢。"
                                },
                                {
                                    "id": "101011013",
                                    "speaker": "派蒙",
                                    "text": "原来《提瓦特游览指南》只是抓人打工的鱼饵吗！"
                                },
                                {
                                    "id": "101011014",
                                    "speaker": "丽莎",
                                    "text": "顺便，出城到地下遗迹去找书的事…真是始料未及的情况。"
                                },
                                {
                                    "id": "101011015",
                                    "speaker": "丽莎",
                                    "text": "为了补偿被卷进来的你，把这些「纪念品」也送给你吧。"
                                },
                                {
                                    "id": "101011016",
                                    "speaker": "派蒙",
                                    "text": "哇，是丽莎姐姐专门准备的吗？"
                                },
                                {
                                    "id": "101011017",
                                    "speaker": "丽莎",
                                    "text": "本想下次出去的时候再给你的…算了，下次的事就下次再说吧，敬请期待哦。"
                                },
                                {
                                    "id": "101011018",
                                    "speaker": "丽莎",
                                    "text": "呵欠…"
                                }
                            ]
                        },
                        {
                            "id": "101011005",
                            "text": "是酬劳！",
                            "response": [
                                {
                                    "id": "101011006",
                                    "speaker": "丽莎",
                                    "text": "呵呵，真是贪心呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1010115",
            "objective": "取得《提瓦特游览指南》",
            "dialogues": [
                {
                    "id": "101011501",
                    "speaker": "丽莎",
                    "text": "<color=#00E1FFFF>《提瓦特游览指南》</color>就在旁边的书架上"
                },
                {
                    "id": "101011502",
                    "speaker": "丽莎",
                    "text": "你去找找看吧~"
                },
                {
                    "id": "101011503",
                    "speaker": "丽莎",
                    "text": "不用归还的哦~"
                }
            ]
        }
    ]
}