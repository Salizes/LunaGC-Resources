    "talks": [
        {
            "id": "7617002",
            "objective": "(隐藏)点击按钮完成领取任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7617001",
            "objective": "前往「斯佩兰扎」",
            "dialogues": [
                {
                    "id": "761700101",
                    "speaker": "米科",
                    "text": "没想到不光是月萤虫，就连小猫也会被吃掉！"
                },
                {
                    "id": "761700102",
                    "speaker": "玫熙",
                    "text": "呜…尤尔瓦哥哥，下次带巴甫洛夫散步的时候，千万要保护好它呀。"
                },
                {
                    "id": "761700174",
                    "speaker": "尤尔瓦",
                    "text": "别担心啦，巴甫洛夫可比普通的小猫大多了，而且不过是植物而已嘛，不会有事的。"
                },
                {
                    "id": "761700103",
                    "speaker": "莉奈娅",
                    "text": "我记得哪个刚入行的新人冒险家在遇到十六倍曼陀草之前也说过类似的话呢。"
                },
                {
                    "id": "761700104",
                    "speaker": "尤尔瓦",
                    "text": "欸…"
                },
                {
                    "id": "761700105",
                    "speaker": "米科",
                    "text": "十六倍曼陀草…好酷！"
                },
                {
                    "id": "761700106",
                    "speaker": "露米",
                    "text": "呀吼！"
                },
                {
                    "id": "761700107",
                    "speaker": "派蒙",
                    "text": "远远就看到这边热闹的样子啦！你们在说什么有趣的…欸？是在上课吗？"
                },
                {
                    "id": "761700108",
                    "speaker": "玫熙",
                    "text": "嗯，莉奈娅姐姐在给我们讲她最近的调查发现呢。"
                },
                {
                    "id": "761700109",
                    "speaker": "Player",
                    "text": "听起来很有意思，我们也能参加吗？"
                },
                {
                    "id": "761700110",
                    "speaker": "莉奈娅",
                    "text": "当然可以，请坐。"
                },
                {
                    "id": "761700111",
                    "speaker": "莉奈娅",
                    "text": "既然说到了十六倍曼陀草，在虚海望，还有一种特色植物…"
                },
                {
                    "id": "761700112",
                    "speaker": "尤尔瓦",
                    "text": "是冬凌草吧。"
                },
                {
                    "id": "761700113",
                    "speaker": "莉奈娅",
                    "text": "嗯嗯！没错，就是冬凌草。"
                },
                {
                    "id": "761700114",
                    "speaker": "米科",
                    "text": "欸——尤尔瓦哥哥作弊！莉奈娅还没问呢！"
                },
                {
                    "id": "761700115",
                    "speaker": "尤尔瓦",
                    "text": "啊，抱歉抱歉，一不留神就抢答了。你别着急，后面还有回答的机会，对吧？"
                },
                {
                    "id": "761700116",
                    "speaker": "莉奈娅",
                    "text": "我准备了好多问题呢！只要积极回答，就有机会拿到糖雕的奖励哦。"
                },
                {
                    "id": "761700117",
                    "speaker": "派蒙",
                    "text": "#原来还有奖励！{NICKNAME}，那我们也要加油啦！",
                    "choices": [
                        {
                            "id": "761700118",
                            "text": "就算对手是小孩我也不会手下留情。",
                            "response": [
                                {
                                    "id": "761700122",
                                    "speaker": "莉奈娅",
                                    "text": "说回正题，关于冬凌草，其实有一个很有趣的故事呢。"
                                },
                                {
                                    "id": "761700123",
                                    "speaker": "莉奈娅",
                                    "text": "传说，冬凌草与「冬凌王」有关，而这位「冬凌王」有一位兄弟，他的象征植物是你们都很熟悉的…是什么呢？",
                                    "choices": [
                                        {
                                            "id": "761700124",
                                            "text": "…甜甜花？",
                                            "response": [
                                                {
                                                    "id": "761700125",
                                                    "speaker": "派蒙",
                                                    "text": "要说熟悉的确是很熟悉！不过应该不是正确答案吧？"
                                                },
                                                {
                                                    "id": "761700126",
                                                    "speaker": "莉奈娅",
                                                    "text": "答错咯！正确答案是：夏槲果。"
                                                },
                                                {
                                                    "id": "761700132",
                                                    "speaker": "米科",
                                                    "text": "夏槲果！我只知道卡嘉和爱诺做的夏槲蛋糕都很好吃…"
                                                },
                                                {
                                                    "id": "761700133",
                                                    "speaker": "莉奈娅",
                                                    "text": "夏槲果正是「冬凌王」的兄弟「夏槲王」的象征，传说这对孪生兄弟自出生起就争斗不休…"
                                                },
                                                {
                                                    "id": "761700134",
                                                    "speaker": "莉奈娅",
                                                    "text": "他们交替杀死对方，又交替复活，统治属于他们各自的季节，就这么循环往复，直到世界的终结。"
                                                },
                                                {
                                                    "id": "761700135",
                                                    "speaker": "玫熙",
                                                    "text": "好可怜…明明是有血缘的亲兄弟…"
                                                },
                                                {
                                                    "id": "761700136",
                                                    "speaker": "米科",
                                                    "text": "这个我知道，卡嘉说过，关系好不好和有没有血缘没关系，而且有时候就是因为有血缘关系才会有争斗。"
                                                },
                                                {
                                                    "id": "761700137",
                                                    "speaker": "Player",
                                                    "text": "这个故事其实讲的是季节更替吧。"
                                                },
                                                {
                                                    "id": "761700138",
                                                    "speaker": "莉奈娅",
                                                    "text": "你很敏锐呢！没错，至冬的学者们也是这么认为的。"
                                                },
                                                {
                                                    "id": "761700139",
                                                    "speaker": "莉奈娅",
                                                    "text": "不过，因为冬凌草耐寒的特性，在这个故事之外，也常被认为是执灯人的象征。"
                                                },
                                                {
                                                    "id": "761700140",
                                                    "speaker": "Player",
                                                    "text": "「纵然花朵败落…」"
                                                },
                                                {
                                                    "id": "761700141",
                                                    "speaker": "派蒙",
                                                    "text": "「叶片也会信守承诺」！之前听说过呢，关于冬凌草的谚语。"
                                                },
                                                {
                                                    "id": "761700142",
                                                    "speaker": "莉奈娅",
                                                    "text": "这是一句很古老的谚语呢，现在很少有人提起了，没想到你们连这个都知道！"
                                                },
                                                {
                                                    "id": "761700143",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，我们可是资深冒险家，就是所谓的…「见多识广」！"
                                                },
                                                {
                                                    "id": "761700144",
                                                    "speaker": "米科",
                                                    "text": "执灯人，就是那些穿着黑色衣服的人吧？"
                                                },
                                                {
                                                    "id": "761700145",
                                                    "speaker": "米科",
                                                    "text": "他们也耐寒？可是他们的衣服看起来都好暖和，难道不是穿得越少才越能证明自己耐寒吗？"
                                                },
                                                {
                                                    "id": "761700146",
                                                    "speaker": "玫熙",
                                                    "text": "不对不对，莉奈娅姐姐的意思应该是，执灯人就像冬凌草，面对寒风一样的困难也不屈服。"
                                                },
                                                {
                                                    "id": "761700147",
                                                    "speaker": "莉奈娅",
                                                    "text": "哦！的确是这样，不过玫熙是怎么想到这一点的呢？"
                                                },
                                                {
                                                    "id": "761700148",
                                                    "speaker": "玫熙",
                                                    "text": "嘿嘿，因为之前收到过赫卡从枫丹寄回来的画册，上面说枫丹的花都有花语。"
                                                },
                                                {
                                                    "id": "761700149",
                                                    "speaker": "玫熙",
                                                    "text": "我想，如果冬凌草也有花语的话，「不屈」和「坚持到底的勇气」就很合适呢。"
                                                },
                                                {
                                                    "id": "761700150",
                                                    "speaker": "莉奈娅",
                                                    "text": "玫熙已经学会举一反三了，真了不起！"
                                                },
                                                {
                                                    "id": "761700151",
                                                    "speaker": "莉奈娅",
                                                    "text": "米科的想法虽然和一般的见解不太一样，不过也很有意思呢。"
                                                },
                                                {
                                                    "id": "761700152",
                                                    "speaker": "Player",
                                                    "text": "老师老师，那我和派蒙呢？"
                                                },
                                                {
                                                    "id": "761700153",
                                                    "speaker": "莉奈娅",
                                                    "text": "唔，如果两位能答出接下来的难题…"
                                                },
                                                {
                                                    "id": "761700154",
                                                    "speaker": "派蒙",
                                                    "text": "#不管是什么难题你尽管问好啦，肯定难不倒{NICKNAME}的！"
                                                },
                                                {
                                                    "id": "761700155",
                                                    "speaker": "莉奈娅",
                                                    "text": "这么有自信啊，那我可要拿出压箱底的问题咯：宿影花的花朵为什么是一红一蓝呢？",
                                                    "choices": [
                                                        {
                                                            "id": "761700156",
                                                            "text": "因为「玫瑰殷红，堇花湛蓝」…",
                                                            "response": [
                                                                {
                                                                    "id": "761700157",
                                                                    "speaker": "派蒙",
                                                                    "text": "？"
                                                                },
                                                                {
                                                                    "id": "761700160",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔…到底为什么呢？不光宿影花，我们在挪德卡莱也见过其他红色和蓝色的东西吧？欸，这么一想，好像还挺多的。"
                                                                },
                                                                {
                                                                    "id": "761700161",
                                                                    "speaker": "派蒙",
                                                                    "text": "要说挪德卡莱和其他地方有什么不同的话…"
                                                                },
                                                                {
                                                                    "id": "761700162",
                                                                    "speaker": "Player",
                                                                    "text": "原来是神奇的月矩力啊。"
                                                                },
                                                                {
                                                                    "id": "761700163",
                                                                    "speaker": "派蒙",
                                                                    "text": "我说你呀，别什么都想着用月矩力来解释啦。既然是压箱底的难题，肯定有更复杂的原因…"
                                                                },
                                                                {
                                                                    "id": "761700164",
                                                                    "speaker": "莉奈娅",
                                                                    "text": "答对了！"
                                                                },
                                                                {
                                                                    "id": "761700165",
                                                                    "speaker": "露米",
                                                                    "text": "呀吼吼！"
                                                                },
                                                                {
                                                                    "id": "761700166",
                                                                    "speaker": "派蒙",
                                                                    "text": "原来还真是啊！"
                                                                },
                                                                {
                                                                    "id": "761700167",
                                                                    "speaker": "莉奈娅",
                                                                    "text": "对生活在挪德卡莱的人来说是常识，但对远道而来的冒险家而言却并非如此，所以也可以称得上是难题？"
                                                                },
                                                                {
                                                                    "id": "761700168",
                                                                    "speaker": "莉奈娅",
                                                                    "text": "#不过{NICKNAME}完全没有被问题的表象蒙蔽呢，真的太适合当冒险家了！"
                                                                },
                                                                {
                                                                    "id": "761700169",
                                                                    "speaker": "莉奈娅",
                                                                    "text": "好啦，今天就差不多到这里吧。刚才回答过问题的同学都有糖雕哦！"
                                                                },
                                                                {
                                                                    "id": "761700170",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸？等一下，该不会只有我没有糖雕吧！早知道哪怕答错也应该多试试…"
                                                                },
                                                                {
                                                                    "id": "761700171",
                                                                    "speaker": "莉奈娅",
                                                                    "text": "#没关系没关系，派蒙也有份！你和{NICKNAME}是一队嘛，就像我和露米一样。"
                                                                },
                                                                {
                                                                    "id": "761700172",
                                                                    "speaker": "Player",
                                                                    "text": "真是太好了，派蒙同学。"
                                                                },
                                                                {
                                                                    "id": "761700173",
                                                                    "speaker": "派蒙",
                                                                    "text": "哇，莉奈娅老师最好了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "761700158",
                                                            "text": "难道是人工培育的品种？",
                                                            "response": [
                                                                {
                                                                    "id": "761700159",
                                                                    "speaker": "莉奈娅",
                                                                    "text": "是个好着眼点！不过真可惜，不是正确答案。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "761700127",
                                            "text": "一定是薄荷吧！",
                                            "response": [
                                                {
                                                    "id": "761700128",
                                                    "speaker": "派蒙",
                                                    "text": "毕竟薄荷跟冬凌草一样都是绿色的…那卷心菜也可以是冬凌草的亲戚啦！"
                                                },
                                                {
                                                    "id": "761700129",
                                                    "speaker": "莉奈娅",
                                                    "text": "答错咯！正确答案是：夏槲果。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "761700130",
                                            "text": "难道是夏槲果。",
                                            "response": [
                                                {
                                                    "id": "761700131",
                                                    "speaker": "莉奈娅",
                                                    "text": "答对了！就是夏槲果。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "761700119",
                            "text": "和小孩抢糖吃啊…",
                            "response": [
                                {
                                    "id": "761700120",
                                    "speaker": "莉奈娅",
                                    "text": "没关系的，偷偷告诉你们，卡嘉给每个人都准备了糖雕。"
                                },
                                {
                                    "id": "761700121",
                                    "speaker": "派蒙",
                                    "text": "哦！既然是这样，那我们可要拿出真本领了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7617003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761700301",
                    "speaker": "莉奈娅",
                    "text": "其实也有传说认为宿影花不同颜色的花朵代表了霜月之子的一对姐妹…"
                },
                {
                    "id": "761700302",
                    "speaker": "米科",
                    "text": "她们该不会也闹得你死我活的？我发现故事里的兄弟姐妹好多都这样，什么嘛，不如我们海螺帮。"
                },
                {
                    "id": "761700303",
                    "speaker": "玫熙",
                    "text": "你让莉奈娅姐姐讲完嘛，那对姐妹最后一定和好了吧？"
                },
                {
                    "id": "761700304",
                    "speaker": "玫熙",
                    "text": "不然就不会用两朵花贴在一起的宿影花来说她们了，对不对？我希望她们最后和好了…"
                }
            ]
        },
        {
            "id": "7617004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761700401",
                    "speaker": "尤尔瓦",
                    "text": "莉奈娅平时东奔西走的，却还是不时抽空来和我们分享她的见闻…我也学到了很多，真的很感谢她。"
                }
            ]
        }
    ]
}