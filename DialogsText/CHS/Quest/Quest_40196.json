    "talks": [
        {
            "id": "4019601",
            "objective": "等待到两天后的上午（8点-10点）",
            "dialogues": [
                {
                    "id": "401960101",
                    "speaker": "派蒙",
                    "text": "几位好！我们没来晚吧？"
                },
                {
                    "id": "401960102",
                    "speaker": "那维莱特",
                    "text": "不，刚刚好。休息得如何？"
                },
                {
                    "id": "401960103",
                    "speaker": "Player",
                    "text": "忙碌使人精神焕发。"
                },
                {
                    "id": "401960104",
                    "speaker": "基尼奇",
                    "text": "的确是保持活力的好方法。"
                },
                {
                    "id": "401960105",
                    "speaker": "Player",
                    "text": "各位已经在着手准备了吗？"
                },
                {
                    "id": "401960106",
                    "speaker": "莱欧斯利",
                    "text": "昨天从阿让托先生处得到消息，确定了交易的时间与地点。"
                },
                {
                    "id": "401960107",
                    "speaker": "莱欧斯利",
                    "text": "说起来，是大家都知道的地方呢。「今日下午，映影欢乐城餐厅见。」"
                },
                {
                    "id": "401960108",
                    "speaker": "派蒙",
                    "text": "欸？他还真是对那个地方情有独钟呢！"
                },
                {
                    "id": "401960109",
                    "speaker": "Player",
                    "text": "这…"
                },
                {
                    "id": "401960110",
                    "speaker": "基尼奇",
                    "text": "#看来{NICKNAME}和我们产生了同样的担忧。"
                },
                {
                    "id": "401960111",
                    "speaker": "那维莱特",
                    "text": "是的，比起空旷的地段，人流量高的活动场地会给抓捕行动造成额外的困难。"
                },
                {
                    "id": "401960112",
                    "speaker": "那维莱特",
                    "text": "犯人可能会混入人群，甚至利用人质逃脱。"
                },
                {
                    "id": "401960113",
                    "speaker": "那维莱特",
                    "text": "为此我们需要做更多的提前准备，所以从昨天接到消息起，这边就已经开始安排逐影庭与特巡队的工作了。"
                },
                {
                    "id": "401960114",
                    "speaker": "莱欧斯利",
                    "text": "嗯，现场会安插很多便衣人员。如果事情进展不顺，我们会优先保障市民的人身安全。"
                },
                {
                    "id": "401960115",
                    "speaker": "莱欧斯利",
                    "text": "当然，还是祝我们一切顺利比较好。"
                },
                {
                    "id": "401960116",
                    "speaker": "基尼奇",
                    "text": "参与人员中有不少我在上起案件中见过的熟悉面孔，比如特巡队队长夏沃蕾小姐。所以，我持乐观态度哦。"
                },
                {
                    "id": "401960117",
                    "speaker": "莱欧斯利",
                    "text": "那就借纳塔的大英雄吉言了。"
                },
                {
                    "id": "401960118",
                    "speaker": "莱欧斯利",
                    "text": "哦，乐平波琳小姐和娜维娅小姐那边，我们也都进行了沟通与安排。"
                },
                {
                    "id": "401960119",
                    "speaker": "那维莱特",
                    "text": "刺玫会会在可控范围内进行支援，不必担心。"
                },
                {
                    "id": "401960120",
                    "speaker": "莱欧斯利",
                    "text": "唯一的问题…可能就是爱可菲小姐那边吧。",
                    "choices": [
                        {
                            "id": "401960121",
                            "text": "她不想接待犯过罪的顾客吗？",
                            "response": [
                                {
                                    "id": "401960122",
                                    "speaker": "莱欧斯利",
                                    "text": "哈哈，要是这样反而简单了。"
                                },
                                {
                                    "id": "401960125",
                                    "speaker": "那维莱特",
                                    "text": "咳…"
                                },
                                {
                                    "id": "401960126",
                                    "speaker": "莱欧斯利",
                                    "text": "不开玩笑了。爱可菲小姐提出，希望自己的餐厅不要因为本次行动蒙受任何损失。"
                                },
                                {
                                    "id": "401960127",
                                    "speaker": "莱欧斯利",
                                    "text": "哈哈…我有种预感，肯定不会如愿的。"
                                },
                                {
                                    "id": "401960128",
                                    "speaker": "Player",
                                    "text": "需要我做些什么吗？"
                                },
                                {
                                    "id": "401960129",
                                    "speaker": "莱欧斯利",
                                    "text": "说实话，这件事本就与你无关，发展到这一步已经给你添了很多麻烦。剩下的应该全权交由枫丹官方处理即可。"
                                },
                                {
                                    "id": "401960130",
                                    "speaker": "莱欧斯利",
                                    "text": "不过我猜，你应该也想知道事件的结局吧。"
                                },
                                {
                                    "id": "401960131",
                                    "speaker": "Player",
                                    "text": "请务必。"
                                },
                                {
                                    "id": "401960132",
                                    "speaker": "莱欧斯利",
                                    "text": "嗯，那就请你在现场见机行事吧。不一定需要你出手，只是以防万一。"
                                },
                                {
                                    "id": "401960133",
                                    "speaker": "基尼奇",
                                    "text": "我会尽量不让事情发展到那一步的。"
                                },
                                {
                                    "id": "401960134",
                                    "speaker": "Player",
                                    "text": "基尼奇也要加入？"
                                },
                                {
                                    "id": "401960135",
                                    "speaker": "基尼奇",
                                    "text": "当然。"
                                },
                                {
                                    "id": "401960136",
                                    "speaker": "基尼奇",
                                    "text": "虽然我心中还有很多疑问，但从已有信息来看，犯人来自纳塔。"
                                },
                                {
                                    "id": "401960137",
                                    "speaker": "基尼奇",
                                    "text": "再说，我也算是证人之一，不能放任不管。"
                                },
                                {
                                    "id": "401960138",
                                    "speaker": "派蒙",
                                    "text": "很有基尼奇的风范呢！"
                                },
                                {
                                    "id": "401960139",
                                    "speaker": "Black Screen",
                                    "text": "众人又就行动细节和注意事项进行了一些讨论。"
                                },
                                {
                                    "id": "401960140",
                                    "speaker": "Black Screen",
                                    "text": "对话难得进行得非常高效…可能是因为阿乔和咔库库都没有出现。"
                                },
                                {
                                    "id": "401960141",
                                    "speaker": "Black Screen",
                                    "text": "转念一想，如果阿乔突然现身对那维莱特口出狂言，场面一定会很尴尬吧…"
                                }
                            ]
                        },
                        {
                            "id": "401960123",
                            "text": "她想给犯罪分子喂叉子吗？",
                            "response": [
                                {
                                    "id": "401960124",
                                    "speaker": "莱欧斯利",
                                    "text": "哦，你别说，是个不错的思路…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4019602",
            "objective": "前往沫芒宫附近",
            "dialogues": []
        },
        {
            "id": "4019603",
            "objective": "前往行动地点",
            "dialogues": [
                {
                    "id": "401960201",
                    "speaker": "派蒙",
                    "text": "几天过去，这片沙滩好像变热闹了呢！"
                },
                {
                    "id": "401960202",
                    "speaker": "Player",
                    "text": "（嗯，也可能是因为其中有不少便衣警卫吧。）"
                },
                {
                    "id": "401960203",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，那个…"
                },
                {
                    "id": "401960204",
                    "speaker": "派蒙",
                    "text": "咳咳！派蒙有些饿了，我们去餐厅看看菜单吧！"
                },
                {
                    "id": "401960205",
                    "speaker": "Player",
                    "text": "（拿着这个箱子的人，应该就是前来交易的家伙了吧。）"
                },
                {
                    "id": "401960206",
                    "speaker": "Player",
                    "text": "（那么，接下来就是正题了。）"
                },
                {
                    "id": "401960207",
                    "speaker": "安格尔望",
                    "text": "可恶，就这么把人拖过来…这是轻视生命的举动！我要去审判庭告你！"
                },
                {
                    "id": "401960208",
                    "speaker": "基尼奇",
                    "text": "是吗。"
                },
                {
                    "id": "401960209",
                    "speaker": "基尼奇",
                    "text": "我倒是觉得，我好心将你从「观众」面前带走，是在维护你的面子。"
                },
                {
                    "id": "401960210",
                    "speaker": "基尼奇",
                    "text": "至于你在途中是头朝上还是头朝下，不是你自己的选择吗？"
                },
                {
                    "id": "401960211",
                    "speaker": "安格尔望",
                    "text": "你…！"
                },
                {
                    "id": "401960212",
                    "speaker": "安格尔望",
                    "text": "……"
                },
                {
                    "id": "401960213",
                    "speaker": "安格尔望",
                    "text": "好吧，好吧，我承认，是我不对。"
                },
                {
                    "id": "401960214",
                    "speaker": "安格尔望",
                    "text": "唉…我当然知道什么是对什么是错，但实在没办法，因为我真的很需要这笔钱。"
                },
                {
                    "id": "401960215",
                    "speaker": "安格尔望",
                    "text": "我本来是研究古遗迹的专家，家庭美满，工作顺利。"
                },
                {
                    "id": "401960216",
                    "speaker": "安格尔望",
                    "text": "但谁能想到，自己的儿子竟然被人蛊惑，陷入了赌博的泥沼…家里本来有些积蓄，但架不住钱就像瀑布一样流走…"
                },
                {
                    "id": "401960217",
                    "speaker": "安格尔望",
                    "text": "欠债以后，他时常遭到债主威胁恐吓，我作为亲生父亲，又怎么能眼睁睁看着他遭遇这种事呢。"
                },
                {
                    "id": "401960218",
                    "speaker": "安格尔望",
                    "text": "唉，我儿子就像你这般年纪，如果他也能像你一样健康成长就好了…所以我才需要钱！"
                },
                {
                    "id": "401960219",
                    "speaker": "基尼奇",
                    "text": "……"
                },
                {
                    "id": "401960220",
                    "speaker": "安格尔望",
                    "text": "你…"
                },
                {
                    "id": "401960221",
                    "speaker": "安格尔望",
                    "text": "求求你了，小伙子，帮帮忙吧！"
                },
                {
                    "id": "401960222",
                    "speaker": "安格尔望",
                    "text": "看在我们都是纳塔同胞的份上，饶我一命！"
                },
                {
                    "id": "401960223",
                    "speaker": "安格尔望",
                    "text": "如果我回去，还有机会管教好我那不争气的儿子。但如果我被抓，他可能只有死路一条了！"
                },
                {
                    "id": "401960224",
                    "speaker": "安格尔望",
                    "text": "作为家人，理应为了更好的未来一起战斗的，对吧？"
                },
                {
                    "id": "401960225",
                    "speaker": "安格尔望",
                    "text": "我们全家的机会都在你的手上了，求求你，高抬贵手吧！"
                },
                {
                    "id": "401960226",
                    "speaker": "基尼奇",
                    "text": "……"
                },
                {
                    "id": "401960227",
                    "speaker": "阿乔",
                    "text": "哈哈，基尼奇，基尼奇，怎么不说话？难道心软了？"
                },
                {
                    "id": "401960228",
                    "speaker": "基尼奇",
                    "text": "哼。"
                },
                {
                    "id": "401960229",
                    "speaker": "基尼奇",
                    "text": "我不会相信你说的任何一句话。"
                },
                {
                    "id": "401960230",
                    "speaker": "基尼奇",
                    "text": "莱欧斯利还真是猜对了八成，你就是一个彻头彻尾的赌徒。"
                },
                {
                    "id": "401960231",
                    "speaker": "安格尔望",
                    "text": "呃，赌徒？我？怎么可能，都说了是我儿子…"
                },
                {
                    "id": "401960232",
                    "speaker": "基尼奇",
                    "text": "首先，你真的是纳塔人吗？"
                },
                {
                    "id": "401960233",
                    "speaker": "基尼奇",
                    "text": "如果你一直关注着那把枪的动向，应该不会连一个熟悉的面孔都认不出。"
                },
                {
                    "id": "401960234",
                    "speaker": "基尼奇",
                    "text": "而比起这个，说「审判庭」的时候倒是顺口得很。"
                },
                {
                    "id": "401960235",
                    "speaker": "安格尔望",
                    "text": "什么啊，就凭这个…"
                },
                {
                    "id": "401960236",
                    "speaker": "安格尔望",
                    "text": "我，我可以解释的！我…我其实是从小生活在…"
                },
                {
                    "id": "401960237",
                    "speaker": "基尼奇",
                    "text": "啧，真是一句话都不想再听了。"
                },
                {
                    "id": "401960238",
                    "speaker": "基尼奇",
                    "text": "阿乔，给你一个堵别人嘴的机会，怎么样？"
                },
                {
                    "id": "401960239",
                    "speaker": "阿乔",
                    "text": "哈哈哈，等你这句话好久了！"
                },
                {
                    "id": "401960240",
                    "speaker": "阿乔",
                    "text": "没脸皮的老东西，吃我一拳！"
                },
                {
                    "id": "401960241",
                    "speaker": "基尼奇",
                    "text": "赌徒的特征之一就是谎话连篇。"
                },
                {
                    "id": "401960242",
                    "speaker": "基尼奇",
                    "text": "我猜你只是假扮成纳塔人的枫丹人罢了，身边也没有什么家人朋友。即便有，他们也早就因为你的不知廉耻离去了。"
                },
                {
                    "id": "401960243",
                    "speaker": "基尼奇",
                    "text": "当然，我也有猜错的可能。"
                },
                {
                    "id": "401960244",
                    "speaker": "基尼奇",
                    "text": "——但那又如何？"
                },
                {
                    "id": "401960245",
                    "speaker": "基尼奇",
                    "text": "我只负责抓人，既不是你的代理人，也不是你的贴心听众。"
                },
                {
                    "id": "401960246",
                    "speaker": "基尼奇",
                    "text": "而从你口中挖出真相，是你最喜欢的审判庭的职责。对吧？"
                },
                {
                    "id": "401960247",
                    "speaker": "夏沃蕾",
                    "text": "没错。"
                },
                {
                    "id": "401960248",
                    "speaker": "夏沃蕾",
                    "text": "基尼奇先生，好久不见。这名犯人就由特巡队接管了。"
                },
                {
                    "id": "401960249",
                    "speaker": "基尼奇",
                    "text": "啊，辛苦你们了。"
                },
                {
                    "id": "401960250",
                    "speaker": "夏沃蕾",
                    "text": "哪里，还是要再次感谢你的鼎力协助。"
                },
                {
                    "id": "401960251",
                    "speaker": "阿乔",
                    "text": "我的呢？我的呢？无礼！难道不应该向伟大圣龙表达诚挚感谢吗！"
                },
                {
                    "id": "401960252",
                    "speaker": "夏沃蕾",
                    "text": "那好吧，谢谢你和咔库库先生的精彩演出。"
                },
                {
                    "id": "401960253",
                    "speaker": "阿乔",
                    "text": "啊——什么意思啊你，站住——"
                },
                {
                    "id": "401960254",
                    "speaker": "Player",
                    "text": "基尼奇，你还好吗？"
                },
                {
                    "id": "401960255",
                    "speaker": "基尼奇",
                    "text": "被一路拖行的人又不是我，放心吧。"
                },
                {
                    "id": "401960256",
                    "speaker": "Player",
                    "text": "感觉你刚刚心情不好。"
                },
                {
                    "id": "401960257",
                    "speaker": "阿乔",
                    "text": "噗噗，小小基尼奇，是想起小小小小基尼奇的事情了吧？"
                },
                {
                    "id": "401960258",
                    "speaker": "阿乔",
                    "text": "可别哭鼻子哦！伟大圣龙要是有这么懦弱的下仆，也是会没面子的！"
                },
                {
                    "id": "401960259",
                    "speaker": "基尼奇",
                    "text": "什么跟什么…"
                },
                {
                    "id": "401960260",
                    "speaker": "Player",
                    "text": "阿乔，坏。"
                },
                {
                    "id": "401960261",
                    "speaker": "基尼奇",
                    "text": "也没有瞒你的必要，简单来讲，我确实很讨厌赌徒。"
                },
                {
                    "id": "401960262",
                    "speaker": "基尼奇",
                    "text": "他们是世界上最没有责任心，最不尊重付出与回报的人。"
                },
                {
                    "id": "401960263",
                    "speaker": "基尼奇",
                    "text": "为了一枚硬币，他们可以编出千万个谎言，再妄图通过这枚硬币，赌出千万的财富。"
                },
                {
                    "id": "401960264",
                    "speaker": "基尼奇",
                    "text": "但我们都清楚，凭空得到的东西，背后总暗藏着无法想象的代价。"
                },
                {
                    "id": "401960265",
                    "speaker": "基尼奇",
                    "text": "我从前的生活已经是我父亲赌输代价的一部分了。如果可以，我不希望有其他人陷入类似的境遇。"
                },
                {
                    "id": "401960266",
                    "speaker": "Player",
                    "text": "基尼奇…"
                },
                {
                    "id": "401960267",
                    "speaker": "基尼奇",
                    "text": "不用为我难过，我自己也并不觉得难过。"
                },
                {
                    "id": "401960268",
                    "speaker": "基尼奇",
                    "text": "都说人是由过去组成。而既然我能走到现在这一步，那说明我一定做对了很多很多事情。"
                },
                {
                    "id": "401960269",
                    "speaker": "基尼奇",
                    "text": "不要因他人的过失惩戒自己。"
                },
                {
                    "id": "401960270",
                    "speaker": "基尼奇",
                    "text": "我的话，会选择记得那些让我成长的瞬间。"
                },
                {
                    "id": "401960271",
                    "speaker": "基尼奇",
                    "text": "就像我第一次学会使用钩索——"
                },
                {
                    "id": "401960272",
                    "speaker": "基尼奇",
                    "text": "第一次渴求知识的时候。"
                },
                {
                    "id": "401960273",
                    "speaker": "Player",
                    "text": "我明白了。"
                },
                {
                    "id": "401960274",
                    "speaker": "基尼奇",
                    "text": "嗯，我相信你。"
                },
                {
                    "id": "401960275",
                    "speaker": "基尼奇",
                    "text": "走吧。再不回去，会有更多人产生不必要的担心。"
                }
            ]
        },
        {
            "id": "4019604",
            "objective": "与基尼奇一同返回",
            "dialogues": [
                {
                    "id": "401960301",
                    "speaker": "派蒙",
                    "text": "#喔，{NICKNAME}，基尼奇，你们回来啦！"
                },
                {
                    "id": "401960302",
                    "speaker": "派蒙",
                    "text": "刚刚看夏沃蕾带着犯人离开了，好像心情不错的样子呢。",
                    "choices": [
                        {
                            "id": "401960303",
                            "text": "比预想的顺利。",
                            "response": [
                                {
                                    "id": "401960305",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，让我们绕了好大的圈子，结果也只是一个没什么战斗力，只会逃跑的家伙嘛！"
                                },
                                {
                                    "id": "401960306",
                                    "speaker": "派蒙",
                                    "text": "哦对了，莱欧斯利让我告诉你们，他已经去沫芒宫汇报结果了。"
                                },
                                {
                                    "id": "401960307",
                                    "speaker": "派蒙",
                                    "text": "他说接下来，逐影庭将深入调查灰色赌博产业，有得忙了。"
                                },
                                {
                                    "id": "401960308",
                                    "speaker": "派蒙",
                                    "text": "但无论如何，那些都是沫芒宫的工作，和我们关系不大啦。"
                                },
                                {
                                    "id": "401960309",
                                    "speaker": "夏洛蒂",
                                    "text": "我看这位公爵大人跑得这么快，是为了躲避记者的镜头吧！"
                                },
                                {
                                    "id": "401960310",
                                    "speaker": "夏洛蒂",
                                    "text": "哎，不过也习惯了。"
                                },
                                {
                                    "id": "401960311",
                                    "speaker": "派蒙",
                                    "text": "竟然这么轻易地放弃了！"
                                },
                                {
                                    "id": "401960312",
                                    "speaker": "夏洛蒂",
                                    "text": "哼哼，反正刚刚已经拍到了超多精彩瞬间，足够我出一篇头条新闻了！"
                                },
                                {
                                    "id": "401960313",
                                    "speaker": "夏洛蒂",
                                    "text": "所以说，由于公务缠身，忙碌的记者先行告退，回去冲洗画片啦！"
                                },
                                {
                                    "id": "401960314",
                                    "speaker": "派蒙",
                                    "text": "要给派蒙选最帅的角度哦！"
                                },
                                {
                                    "id": "401960315",
                                    "speaker": "派蒙",
                                    "text": "啊，跑得好快，希望她听到了…"
                                },
                                {
                                    "id": "401960316",
                                    "speaker": "Player",
                                    "text": "相信专业摄影师的审美吧。"
                                },
                                {
                                    "id": "401960317",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，也是哦！"
                                },
                                {
                                    "id": "401960318",
                                    "speaker": "派蒙",
                                    "text": "不过刚刚你们怎么花了这么久才过来，是遇到什么问题了吗？",
                                    "choices": [
                                        {
                                            "id": "401960319",
                                            "text": "阿乔撞到了头，在哭鼻子。",
                                            "response": [
                                                {
                                                    "id": "401960320",
                                                    "speaker": "阿乔",
                                                    "text": "什么？！"
                                                },
                                                {
                                                    "id": "401960321",
                                                    "speaker": "阿乔",
                                                    "text": "你这家伙，怎么张嘴就来！"
                                                },
                                                {
                                                    "id": "401960322",
                                                    "speaker": "阿乔",
                                                    "text": "我伟大圣龙，「库胡勒阿乔」，何时有过此等丑态！"
                                                },
                                                {
                                                    "id": "401960323",
                                                    "speaker": "基尼奇",
                                                    "text": "还少吗。"
                                                },
                                                {
                                                    "id": "401960329",
                                                    "speaker": "Player",
                                                    "text": "接下来有什么打算？"
                                                },
                                                {
                                                    "id": "401960330",
                                                    "speaker": "基尼奇",
                                                    "text": "嗯…说实话，还没想好。"
                                                },
                                                {
                                                    "id": "401960331",
                                                    "speaker": "基尼奇",
                                                    "text": "也没什么急事，搞不好审判庭还要再叫我去作证。"
                                                },
                                                {
                                                    "id": "401960332",
                                                    "speaker": "基尼奇",
                                                    "text": "至于那把来自纳塔的枪，作为关键物证，可能也得等案件审理完成后再带回纳塔了。"
                                                },
                                                {
                                                    "id": "401960333",
                                                    "speaker": "基尼奇",
                                                    "text": "总之，就让我再享受一阵沙滩与大海吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401960324",
                                            "text": "基尼奇磕到了头，在哭鼻子。",
                                            "response": [
                                                {
                                                    "id": "401960325",
                                                    "speaker": "基尼奇",
                                                    "text": "你说是就是。"
                                                },
                                                {
                                                    "id": "401960326",
                                                    "speaker": "阿乔",
                                                    "text": "啊哈哈哈哈哈，小小基尼奇，没人给他摸摸头，只好自己哭鼻子！"
                                                },
                                                {
                                                    "id": "401960327",
                                                    "speaker": "派蒙",
                                                    "text": "真的假的？总觉得阿乔哭鼻子倒是更有可能…"
                                                },
                                                {
                                                    "id": "401960328",
                                                    "speaker": "阿乔",
                                                    "text": "喂——"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401960304",
                            "text": "敌人很弱欸。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4019699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "401969901",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，那维莱特一早派人来联系我们了呢！"
                },
                {
                    "id": "401969902",
                    "speaker": "派蒙",
                    "text": "一定是事情有了进展，事不宜迟，我们出发吧！"
                }
            ]
        }
    ]
