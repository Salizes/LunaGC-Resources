    "talks": [
        {
            "id": "7221101",
            "objective": "test 与寝子对话 隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "722110801",
                    "speaker": "「寝子」",
                    "text": "是汝啊，来得正好。正好奴家有事情要人帮忙。"
                },
                {
                    "id": "722110802",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "722110803",
                    "speaker": "「寝子」",
                    "text": "多亏了汝，现在神社也比以前好了。很快很快就会有很多很多人来神社了。"
                },
                {
                    "id": "722110804",
                    "speaker": "「寝子」",
                    "text": "奴家叮嘱小家伙们，到时候可不能像现在这样，一定要在人类面前保持风度。"
                },
                {
                    "id": "722110805",
                    "speaker": "「寝子」",
                    "text": "但它们已经疯惯了，不爱听奴家的话。"
                },
                {
                    "id": "722110806",
                    "speaker": "「寝子」",
                    "text": "不过奴家想到了一个办法。"
                },
                {
                    "id": "722110807",
                    "speaker": "Player",
                    "text": "办法？"
                },
                {
                    "id": "722110808",
                    "speaker": "「寝子」",
                    "text": "奴家还很小很小的时候，也喜欢到处玩。那时候，阿响为了让奴家和别的猫乖乖听话，会做很好吃的饭。"
                },
                {
                    "id": "722110809",
                    "speaker": "派蒙",
                    "text": "好、好吃的！"
                },
                {
                    "id": "722110810",
                    "speaker": "「寝子」",
                    "text": "那时候呀，只要那锅饭一端出来，猫们马上就会从树上、屋顶上下来。就算饭好烫好烫、舌头好热好热，也忍不住。"
                },
                {
                    "id": "722110811",
                    "speaker": "「寝子」",
                    "text": "阿响每次都会做好大一锅，分给猫和人类一起吃，来神社的人也有份。"
                },
                {
                    "id": "722110812",
                    "speaker": "「寝子」",
                    "text": "不过，百目鬼的食量可大了，每次吃好多好多。不像奴家这样有风度。",
                    "choices": [
                        {
                            "id": "722110813",
                            "text": "所以说…",
                            "response": [
                                {
                                    "id": "722110815",
                                    "speaker": "「寝子」",
                                    "text": "不错，很有悟性嘛。奴家要请汝等做饭。"
                                },
                                {
                                    "id": "722110816",
                                    "speaker": "Player",
                                    "text": "我不是怀疑寝子的智慧…"
                                },
                                {
                                    "id": "722110817",
                                    "speaker": "派蒙",
                                    "text": "不过寝子真的知道饭要怎么做吗？"
                                },
                                {
                                    "id": "722110818",
                                    "speaker": "「寝子」",
                                    "text": "喵喵？"
                                },
                                {
                                    "id": "722110819",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "722110820",
                                    "speaker": "「寝子」",
                                    "text": "这、这种东西，就交给汝等想办法了！难道什么都要奴家自己做吗？"
                                },
                                {
                                    "id": "722110821",
                                    "speaker": "「寝子」",
                                    "text": "哎呀，不过那个饭，真是太好吃了哪。那个味道，就算走了好远好远、过了好久好久，都可以闻到…"
                                },
                                {
                                    "id": "722110822",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我觉得我们还是应该努力一下！毕竟，为了神社嘛！",
                                    "choices": [
                                        {
                                            "id": "722110823",
                                            "text": "饭里有什么？",
                                            "response": [
                                                {
                                                    "id": "722110826",
                                                    "speaker": "「寝子」",
                                                    "text": "奴家当然记得。有鱼的肉、动物的肉、水里长的草，还有白米。"
                                                },
                                                {
                                                    "id": "722110827",
                                                    "speaker": "派蒙",
                                                    "text": "唔，就是鱼肉、兽肉、海草和稻米对吧…怎么做的还记得吗？"
                                                },
                                                {
                                                    "id": "722110828",
                                                    "speaker": "「寝子」",
                                                    "text": "不记得。",
                                                    "choices": [
                                                        {
                                                            "id": "722110829",
                                                            "text": "看来得找个厨师问问。",
                                                            "response": [
                                                                {
                                                                    "id": "722110830",
                                                                    "speaker": "派蒙",
                                                                    "text": "但是，哪个厨师会做猫饭呢…不如我们去问问大祐和悦子吧，他们说不定知道要怎么办。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722110831",
                                                            "text": "去找那两个冒险家问问看。",
                                                            "response": [
                                                                {
                                                                    "id": "722110832",
                                                                    "speaker": "派蒙",
                                                                    "text": "对喔，大祐和悦子是冒险家，说不定他们会知道些什么。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722110824",
                                            "text": "派蒙真好懂。",
                                            "response": [
                                                {
                                                    "id": "722110825",
                                                    "speaker": "派蒙",
                                                    "text": "什么嘛，我可是热心助猫！寝子，饭里有什么材料，还记得吗？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722110814",
                            "text": "我们帮你做饭？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221102",
            "objective": "与大祐和悦子对话",
            "dialogues": [
                {
                    "id": "722110101",
                    "speaker": "大祐",
                    "text": "悦子小姐，我们接着去哪里探索？"
                },
                {
                    "id": "722110102",
                    "speaker": "悦子",
                    "text": "呼…先歇一歇吧…"
                },
                {
                    "id": "722110103",
                    "speaker": "悦子",
                    "text": "嗯？是你们啊，你们找我们有事吗？"
                },
                {
                    "id": "722110104",
                    "speaker": "Player",
                    "text": "关于可靠的厨师…"
                },
                {
                    "id": "722110105",
                    "speaker": "大祐",
                    "text": "在清籁岛的地方找厨师？"
                },
                {
                    "id": "722110106",
                    "speaker": "派蒙",
                    "text": "事情是这样的。寝子她…"
                },
                {
                    "id": "722110107",
                    "speaker": "大祐",
                    "text": "你说…寝子大人拜托你们帮忙准备食物吗？"
                },
                {
                    "id": "722110108",
                    "speaker": "大祐",
                    "text": "啊…可恶！要是我有烹饪的才能就好了！"
                },
                {
                    "id": "722110109",
                    "speaker": "悦子",
                    "text": "这么说，你们是想要找一个能帮你们搞明白…「怎么用这些食材，做出猫会喜欢的饭」的厨师，对吧？"
                },
                {
                    "id": "722110110",
                    "speaker": "悦子",
                    "text": "我想想…厨师…厨师…"
                },
                {
                    "id": "722110111",
                    "speaker": "悦子",
                    "text": "喔，你们不如去稻妻城，去找「木南料亭」的木南杏奈小姐吧。"
                },
                {
                    "id": "722110112",
                    "speaker": "悦子",
                    "text": "木南小姐人很好，厨艺也很不错，应该能帮你们这个忙。"
                },
                {
                    "id": "722110113",
                    "speaker": "Player",
                    "text": "谢谢，我们这就去看看。"
                },
                {
                    "id": "722110114",
                    "speaker": "悦子",
                    "text": "不用谢，快点去吧，我和大祐还要继续制订探索计划。"
                },
                {
                    "id": "722110115",
                    "speaker": "悦子",
                    "text": "呵呵，希望这个神社真的可以热闹起来。"
                },
                {
                    "id": "722110116",
                    "speaker": "悦子",
                    "text": "这样，也不枉你和那位寝子忙前忙后这么长时间。"
                }
            ]
        },
        {
            "id": "7221103",
            "objective": "向木南杏奈请教",
            "dialogues": [
                {
                    "id": "722110201",
                    "speaker": "木南杏奈",
                    "text": "你好，欢迎光临「木南料亭」，请问你们有什么需要的吗？"
                },
                {
                    "id": "722110203",
                    "speaker": "Player",
                    "text": "关于寝子的饭…"
                },
                {
                    "id": "722110204",
                    "speaker": "木南杏奈",
                    "text": "「寝子」？这个名字，难不成是猫吗？"
                },
                {
                    "id": "722110205",
                    "speaker": "派蒙",
                    "text": "你认识寝子吗？"
                },
                {
                    "id": "722110206",
                    "speaker": "木南杏奈",
                    "text": "哎呀，不是。我只是觉得，这个名字很适合猫呢。"
                },
                {
                    "id": "722110207",
                    "speaker": "Player",
                    "text": "真是强大的直觉…"
                },
                {
                    "id": "722110208",
                    "speaker": "派蒙",
                    "text": "先不说这些，事情是这样的…"
                },
                {
                    "id": "722110209",
                    "speaker": "木南杏奈",
                    "text": "清籁岛上…有一座浅濑神社，神社里有一只会说话的猫？！那只猫还拜托你们做一道菜给它？"
                },
                {
                    "id": "722110210",
                    "speaker": "木南杏奈",
                    "text": "欸？欸！真的吗？我从来都没听说过！",
                    "choices": [
                        {
                            "id": "722110211",
                            "text": "是、是真的…",
                            "response": [
                                {
                                    "id": "722110213",
                                    "speaker": "木南杏奈",
                                    "text": "在清籁岛上对吧？等有机会，我一定要自己去看看…"
                                },
                                {
                                    "id": "722110214",
                                    "speaker": "Player",
                                    "text": "那个…寝子的饭…"
                                },
                                {
                                    "id": "722110215",
                                    "speaker": "木南杏奈",
                                    "text": "啊…对哦，差点忘了正事…我想想。"
                                },
                                {
                                    "id": "722110216",
                                    "speaker": "木南杏奈",
                                    "text": "唔…猫也会喜欢的饭吗…"
                                },
                                {
                                    "id": "722110217",
                                    "speaker": "派蒙",
                                    "text": "很难吗？"
                                },
                                {
                                    "id": "722110218",
                                    "speaker": "木南杏奈",
                                    "text": "……"
                                },
                                {
                                    "id": "722110219",
                                    "speaker": "Player",
                                    "text": "很、很难吗？"
                                },
                                {
                                    "id": "722110220",
                                    "speaker": "木南杏奈",
                                    "text": "这是对「木南」家名的挑战！我一定要克服！"
                                },
                                {
                                    "id": "722110221",
                                    "speaker": "木南杏奈",
                                    "text": "用鱼肉、兽肉、海草、稻米做出能让猫趋之若鹜的美食，就交给我吧。"
                                },
                                {
                                    "id": "722110222",
                                    "speaker": "派蒙",
                                    "text": "我、我也想吃！",
                                    "choices": [
                                        {
                                            "id": "722110223",
                                            "text": "我也想吃…",
                                            "response": [
                                                {
                                                    "id": "722110225",
                                                    "speaker": "木南杏奈",
                                                    "text": "没问题！"
                                                },
                                                {
                                                    "id": "722110226",
                                                    "speaker": "木南杏奈",
                                                    "text": "我先构思一下食谱，你们先帮我准备三份海草。",
                                                    "choices": [
                                                        {
                                                            "id": "722110227",
                                                            "text": "我知道了。",
                                                            "response": [
                                                                {
                                                                    "id": "722110228",
                                                                    "speaker": "木南杏奈",
                                                                    "text": "那就拜托你们了，只要三份海草就好，找到之后就拿来给我吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722110229",
                                                            "text": "你已经知道怎么做了？",
                                                            "response": [
                                                                {
                                                                    "id": "722110230",
                                                                    "speaker": "木南杏奈",
                                                                    "text": "有了一点想法，但还没有完全想好…"
                                                                },
                                                                {
                                                                    "id": "722110231",
                                                                    "speaker": "木南杏奈",
                                                                    "text": "你先去帮我找三份海草过来吧，拜托你们了。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722110224",
                                            "text": "那就交给你了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722110212",
                            "text": "你可以自己过去看看。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221104",
            "objective": "将三份海草带给木南杏奈",
            "dialogues": [
                {
                    "id": "722110401",
                    "speaker": "「寝子」",
                    "text": "好香…汝等，做好饭了吗？"
                },
                {
                    "id": "722110402",
                    "speaker": "Player",
                    "text": "做好了。"
                },
                {
                    "id": "722110403",
                    "speaker": "「寝子」",
                    "text": "喵喵！真厉害，快给奴家尝尝看。"
                },
                {
                    "id": "722110404",
                    "speaker": "「寝子」",
                    "text": "……"
                },
                {
                    "id": "722110405",
                    "speaker": "「寝子」",
                    "text": "看起来，和阿响做的饭有些不一样…"
                },
                {
                    "id": "722110406",
                    "speaker": "派蒙",
                    "text": "应、应该很好吃的，我们先一起尝尝看吧！"
                },
                {
                    "id": "722110407",
                    "speaker": "派蒙",
                    "text": "真好吃！"
                },
                {
                    "id": "722110408",
                    "speaker": "「寝子」",
                    "text": "……喵。"
                },
                {
                    "id": "722110409",
                    "speaker": "派蒙",
                    "text": "（寝子是因为饭和「阿响」做得不一样，不开心吗…）"
                },
                {
                    "id": "722110410",
                    "speaker": "「寝子」",
                    "text": "很好吃，汝等，很可靠呢。"
                },
                {
                    "id": "722110411",
                    "speaker": "Player",
                    "text": "那就好。"
                },
                {
                    "id": "722110412",
                    "speaker": "「寝子」",
                    "text": "虽然，汝等做的饭，和阿响做的饭味道不一样。"
                },
                {
                    "id": "722110413",
                    "speaker": "「寝子」",
                    "text": "但是，和汝等一起吃饭时的感觉，和之前奴家和阿响一起吃饭时的感觉，一模一样。"
                },
                {
                    "id": "722110414",
                    "speaker": "「寝子」",
                    "text": "人类啊，这是为什么呢？汝等人类，难道会什么妖法不成？",
                    "choices": [
                        {
                            "id": "722110415",
                            "text": "很久没人给你做饭了吧。",
                            "response": [
                                {
                                    "id": "722110417",
                                    "speaker": "「寝子」",
                                    "text": "…无论如何，谢谢汝等。好久没吃过这样好吃的饭了。"
                                },
                                {
                                    "id": "722110418",
                                    "speaker": "「寝子」",
                                    "text": "小家伙们肯定会喜欢的。汝再跑一趟，把这饭带给它们。"
                                },
                                {
                                    "id": "722110419",
                                    "speaker": "「寝子」",
                                    "text": "既然奴家喜欢，那它们肯定会喜欢。然后，吃了这么好吃的饭，一定也会愿意听奴家的了。"
                                }
                            ]
                        },
                        {
                            "id": "722110416",
                            "text": "因为做的人很热心吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221108",
            "objective": "将三份海草带给木南杏奈",
            "dialogues": [
                {
                    "id": "722110702",
                    "speaker": "木南杏奈",
                    "text": "太好了，你们稍等一下，我对于怎么做这道菜…已经有思路了！"
                },
                {
                    "id": "722110703",
                    "speaker": "木南杏奈",
                    "text": "完成了！"
                },
                {
                    "id": "722110704",
                    "speaker": "派蒙",
                    "text": "闻着好香啊！唔唔，好想尝尝看…"
                },
                {
                    "id": "722110705",
                    "speaker": "木南杏奈",
                    "text": "名字就叫做…嗯…既然这道饭是给一只会说话的猫做的，那这道饭就叫做「活力喵饭」吧！"
                },
                {
                    "id": "722110706",
                    "speaker": "木南杏奈",
                    "text": "总之，这份饭你们拿好。"
                },
                {
                    "id": "722110707",
                    "speaker": "木南杏奈",
                    "text": "对了，食谱我也抄一份给你。"
                },
                {
                    "id": "722110708",
                    "speaker": "派蒙",
                    "text": "#太好了，那{NICKNAME}也能随时给我做…做「喵饭」了！",
                    "choices": [
                        {
                            "id": "722110709",
                            "text": "你是猫吗？",
                            "response": [
                                {
                                    "id": "722110710",
                                    "speaker": "派蒙",
                                    "text": "真没礼貌！美食是全世界共通的，是我和寝子的共同语言。"
                                },
                                {
                                    "id": "722110711",
                                    "speaker": "派蒙",
                                    "text": "对了！要感谢木南小姐才行。"
                                },
                                {
                                    "id": "722110713",
                                    "speaker": "木南杏奈",
                                    "text": "不用谢啦，这道饭和食谱，就当做给那位寝子的礼物啦。"
                                },
                                {
                                    "id": "722110714",
                                    "speaker": "木南杏奈",
                                    "text": "等我有空了，一定会去那座「浅濑神社」拜访的。"
                                },
                                {
                                    "id": "722110715",
                                    "speaker": "木南杏奈",
                                    "text": "好了，你们快回去吧，别让寝子等急啦。"
                                }
                            ]
                        },
                        {
                            "id": "722110712",
                            "text": "谢谢。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221105",
            "objective": "向寝子回报",
            "dialogues": []
        },
        {
            "id": "7221106",
            "objective": "将「美味的活力喵饭」带给小猫们",
            "dialogues": [
                {
                    "id": "722110601",
                    "speaker": "「寝子」",
                    "text": "做饭的事就交给汝等了。"
                },
                {
                    "id": "722110602",
                    "speaker": "「寝子」",
                    "text": "然后，做好了以后，和奴家、还有小家伙们一起吃吧。"
                }
            ]
        },
        {
            "id": "7221109",
            "objective": "将「美味的活力喵饭」带给小猫们",
            "dialogues": [
                {
                    "id": "722110901",
                    "speaker": "悦子",
                    "text": "怎么了？快去城里找木南杏奈小姐吧。"
                }
            ]
        },
        {
            "id": "7221110",
            "objective": "将「美味的活力喵饭」带给小猫们",
            "dialogues": [
                {
                    "id": "722111001",
                    "speaker": "大祐",
                    "text": "唉，要是我有烹饪的才能就好了…"
                }
            ]
        },
        {
            "id": "7221111",
            "objective": "test 回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "722111101",
                    "speaker": "木南杏奈",
                    "text": "你好，欢迎光临「木南料亭」，请问你们有什么需要的吗？"
                },
                {
                    "id": "722111102",
                    "speaker": "木南杏奈",
                    "text": "你好…哎呀，是神里小姐的朋友！快请进，有什么我可以帮你们的吗？"
                },
                {
                    "id": "722111103",
                    "speaker": "Player",
                    "text": "关于寝子的饭…"
                },
                {
                    "id": "722111104",
                    "speaker": "木南杏奈",
                    "text": "「寝子」？这个名字，难不成是猫吗？"
                },
                {
                    "id": "722111105",
                    "speaker": "派蒙",
                    "text": "你认识寝子吗？"
                },
                {
                    "id": "722111106",
                    "speaker": "木南杏奈",
                    "text": "哎呀，不是。我只是觉得，这个名字很适合猫呢。"
                },
                {
                    "id": "722111107",
                    "speaker": "Player",
                    "text": "真是强大的直觉…"
                },
                {
                    "id": "722111108",
                    "speaker": "派蒙",
                    "text": "先不说这些，事情是这样的…"
                },
                {
                    "id": "722111109",
                    "speaker": "木南杏奈",
                    "text": "清籁岛上…有一座浅濑神社，神社里有一只会说话的猫？！那只猫还拜托你们做一道菜给它？"
                },
                {
                    "id": "722111110",
                    "speaker": "木南杏奈",
                    "text": "欸？欸！真的吗？我从来都没听说过！"
                },
                {
                    "id": "722111111",
                    "speaker": "Player",
                    "text": "是、是真的…"
                },
                {
                    "id": "722111113",
                    "speaker": "木南杏奈",
                    "text": "在清籁岛上对吧？等有机会，我一定要自己去看看…"
                },
                {
                    "id": "722111114",
                    "speaker": "Player",
                    "text": "那个…寝子的饭…"
                },
                {
                    "id": "722111115",
                    "speaker": "木南杏奈",
                    "text": "啊…对哦，差点忘了正事…我想想。"
                },
                {
                    "id": "722111116",
                    "speaker": "木南杏奈",
                    "text": "唔…猫也会喜欢的饭吗…"
                },
                {
                    "id": "722111117",
                    "speaker": "派蒙",
                    "text": "很难吗？"
                },
                {
                    "id": "722111118",
                    "speaker": "木南杏奈",
                    "text": "……"
                },
                {
                    "id": "722111119",
                    "speaker": "Player",
                    "text": "很、很难吗？"
                },
                {
                    "id": "722111120",
                    "speaker": "木南杏奈",
                    "text": "这是对「木南」家名的挑战！我一定要克服！"
                },
                {
                    "id": "722111121",
                    "speaker": "木南杏奈",
                    "text": "用鱼肉、兽肉、海草、稻米做出能让猫趋之若鹜的美食，就交给我吧。"
                },
                {
                    "id": "722111122",
                    "speaker": "派蒙",
                    "text": "我、我也想吃！",
                    "choices": [
                        {
                            "id": "722111123",
                            "text": "我也想吃…",
                            "response": [
                                {
                                    "id": "722111125",
                                    "speaker": "木南杏奈",
                                    "text": "没问题！"
                                },
                                {
                                    "id": "722111126",
                                    "speaker": "木南杏奈",
                                    "text": "我先构思一下食谱，你们先帮我准备三份海草。",
                                    "choices": [
                                        {
                                            "id": "722111127",
                                            "text": "我知道了。",
                                            "response": [
                                                {
                                                    "id": "722111128",
                                                    "speaker": "木南杏奈",
                                                    "text": "那就拜托你们了，只要三份海草就好，找到之后就拿来给我吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722111129",
                                            "text": "你已经知道怎么做了？",
                                            "response": [
                                                {
                                                    "id": "722111130",
                                                    "speaker": "木南杏奈",
                                                    "text": "有了一点想法，但还没有完全想好…"
                                                },
                                                {
                                                    "id": "722111131",
                                                    "speaker": "木南杏奈",
                                                    "text": "你先去帮我找三份海草过来吧，拜托你们了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722111124",
                            "text": "那就交给你了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7221112",
            "objective": "test 回滚隔离$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7221107",
            "objective": "向寝子回报",
            "dialogues": [
                {
                    "id": "722110501",
                    "speaker": "「寝子」",
                    "text": "汝等已经把饭带给那些小家伙了吗？"
                },
                {
                    "id": "722110502",
                    "speaker": "Player",
                    "text": "都吃得很开心。"
                },
                {
                    "id": "722110503",
                    "speaker": "「寝子」",
                    "text": "是吗？那样就好了，喵喵…"
                },
                {
                    "id": "722110504",
                    "speaker": "「寝子」",
                    "text": "奴家已经很久没有吃过这样好吃的饭了。"
                },
                {
                    "id": "722110505",
                    "speaker": "「寝子」",
                    "text": "喵喵喵…虽然奴家现在也不需要吃饭、不需要喝水了，但饭的滋味，真是让奴家欲罢不能呢…"
                },
                {
                    "id": "722110506",
                    "speaker": "「寝子」",
                    "text": "有个小家伙叫「阿饭」，就是因为奴家想要用世界上最好的东西给她起名。"
                },
                {
                    "id": "722110507",
                    "speaker": "Player",
                    "text": "阿响做的饭叫什么名字？"
                },
                {
                    "id": "722110508",
                    "speaker": "「寝子」",
                    "text": "名字？饭还能有名字？"
                },
                {
                    "id": "722110509",
                    "speaker": "Player",
                    "text": "这个饭叫「活力喵饭」。"
                },
                {
                    "id": "722110510",
                    "speaker": "「寝子」",
                    "text": "名字好复杂。不过奴家不讨厌。"
                },
                {
                    "id": "722110511",
                    "speaker": "「寝子」",
                    "text": "…汝说得也对。毕竟，饭是好东西。好东西都应该有名字才对。"
                },
                {
                    "id": "722110512",
                    "speaker": "「寝子」",
                    "text": "喵喵，等阿响回来了，奴家再问她吧。然后，汝也可以做汝的饭给她吃…"
                },
                {
                    "id": "722110513",
                    "speaker": "「寝子」",
                    "text": "然后，她再做她的饭给汝吃。然后，奴家可以吃两种不同的，又都很好吃的饭。"
                },
                {
                    "id": "722110514",
                    "speaker": "「寝子」",
                    "text": "所以说，奴家得把神社打理得更好。等她回来了，就一起吃饭。"
                },
                {
                    "id": "722110515",
                    "speaker": "「寝子」",
                    "text": "谢谢。很好吃。喵喵。"
                }
            ]
        },
        {
            "id": "7221103",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722110301",
                    "speaker": "木南杏奈",
                    "text": "怎么样，你们找到三份海草了吗？"
                }
            ]
        }
    ]
}