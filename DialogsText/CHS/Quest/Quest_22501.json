            "dialogues": []
        },
        {
            "id": "2250116",
            "objective": "搜集霓裳花对话$HIDDEN",
            "dialogues": [
                {
                    "id": "225011401",
                    "speaker": "Player",
                    "text": "霓裳花。"
                },
                {
                    "id": "225011402",
                    "speaker": "清昼",
                    "text": "嗯，倒也不错。现在天有异象，霓裳花倒一如往常地盛开。"
                },
                {
                    "id": "225011403",
                    "speaker": "清昼",
                    "text": "两相对比，说不定也会有些趣味…"
                },
                {
                    "id": "225011404",
                    "speaker": "清昼",
                    "text": "能拜托你去采三朵霓裳花回来吗？有了实物，或许我就能有思路了。"
                },
                {
                    "id": "225011405",
                    "speaker": "Player",
                    "text": "我知道了。"
                },
                {
                    "id": "225011406",
                    "speaker": "清昼",
                    "text": "那就拜托你了。"
                }
            ]
        },
        {
            "id": "2250117",
            "objective": "搜集冰雾花对话$HIDDEN",
            "dialogues": [
                {
                    "id": "225011501",
                    "speaker": "Player",
                    "text": "冰雾花。"
                },
                {
                    "id": "225011502",
                    "speaker": "清昼",
                    "text": "冰雾花，嗯…假如能将天降的陨石与冰雾花两相对比，说不定能出一首好诗。"
                },
                {
                    "id": "225011503",
                    "speaker": "清昼",
                    "text": "能拜托你去采三朵冰雾花回来吗？有了实物，或许我就能有思路了。"
                },
                {
                    "id": "225011504",
                    "speaker": "Player",
                    "text": "我知道了。"
                },
                {
                    "id": "225011505",
                    "speaker": "清昼",
                    "text": "那就拜托你了。"
                }
            ]
        },
        {
            "id": "2250118",
            "objective": "采摘3朵霓裳花",
            "dialogues": [
                {
                    "id": "225011801",
                    "speaker": "清昼",
                    "text": "这就是陨石吗…怪了，怪了…"
                },
                {
                    "id": "225011802",
                    "speaker": "Player",
                    "text": "别去摸陨石。"
                },
                {
                    "id": "225011803",
                    "speaker": "清昼",
                    "text": "啊？是您啊…我知道了，您就放心吧，我心里自然有数。"
                },
                {
                    "id": "225011804",
                    "speaker": "清昼",
                    "text": "辛苦您了，这几份小小礼物，聊表心意，还请收下。"
                },
                {
                    "id": "225011805",
                    "speaker": "清昼",
                    "text": "这陨石还真是奇异…嗯…"
                },
                {
                    "id": "225011806",
                    "speaker": "派蒙",
                    "text": "呜哇…他已经完全进入状态了。"
                },
                {
                    "id": "225011807",
                    "speaker": "派蒙",
                    "text": "不过，他真的把话听进去了吗？真让人担心…"
                }
            ]
        },
        {
            "id": "2250119",
            "objective": "采摘3朵冰雾花",
            "dialogues": []
        },
        {
            "id": "2250120",
