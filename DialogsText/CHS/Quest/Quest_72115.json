    "talks": [
        {
            "id": "7211501",
            "objective": "（test）隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "721150101",
                    "speaker": "泽维尔",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYC|INFO_FEMALE_PRONOUN_GIRLC]}，真是幸会！关于「御影炉心」，我有一个好消息和一个坏消息，您想先听哪一个？",
                    "choices": [
                        {
                            "id": "721150102",
                            "text": "好消息。",
                            "response": [
                                {
                                    "id": "721150103",
                                    "speaker": "泽维尔",
                                    "text": "好消息是，炉心的损毁似乎并不严重，还在我可以处理的范围内。"
                                },
                                {
                                    "id": "721150104",
                                    "speaker": "泽维尔",
                                    "text": "但坏消息是，正在里面折腾的那群愚人众并不太乐意接受这个好消息。"
                                },
                                {
                                    "id": "721150105",
                                    "speaker": "泽维尔",
                                    "text": "他们似乎还在不断寻找染指「祟神」核心的方法。"
                                },
                                {
                                    "id": "721150111",
                                    "speaker": "泽维尔",
                                    "text": "再让他们这么折腾下去，「祟神」的力量迟早会真的失去控制，然后把这座岛，还有岛上的我们一起炸上天。"
                                },
                                {
                                    "id": "721150112",
                                    "speaker": "泽维尔",
                                    "text": "但如果我们只把注意力放在愚人众这边，那护罩中积累的「祟神」，迟早也会抵达临界点…"
                                },
                                {
                                    "id": "721150113",
                                    "speaker": "Player",
                                    "text": "所以，我们要同时对付两边？"
                                },
                                {
                                    "id": "721150114",
                                    "speaker": "泽维尔",
                                    "text": "嗯…通俗地来说，从学术的观点，客观地来讲…"
                                },
                                {
                                    "id": "721150115",
                                    "speaker": "泽维尔",
                                    "text": "现在的情况就是，我们面前摆着愚人众和「祟神」两个问题。"
                                },
                                {
                                    "id": "721150116",
                                    "speaker": "泽维尔",
                                    "text": "但鉴于「御影炉心」里的现状，假如我们想要解决其中某一个问题，那在实践过程中，我们大概率也必须面对另一个。"
                                },
                                {
                                    "id": "721150117",
                                    "speaker": "泽维尔",
                                    "text": "所以，我们面对的现实情况就是…"
                                },
                                {
                                    "id": "721150118",
                                    "speaker": "Player",
                                    "text": "你是说「没错」。"
                                },
                                {
                                    "id": "721150119",
                                    "speaker": "泽维尔",
                                    "text": "呃，是的，没错。我们就是要同时对付两边。"
                                },
                                {
                                    "id": "721150120",
                                    "speaker": "泽维尔",
                                    "text": "但我们还是一步步来吧，璃月人不是常说「心急吃不了热豆腐」嘛。"
                                },
                                {
                                    "id": "721150121",
                                    "speaker": "Player",
                                    "text": "你还知道璃月谚语？"
                                },
                                {
                                    "id": "721150122",
                                    "speaker": "泽维尔",
                                    "text": "之前我们也去过璃月，这是一点旅途的小纪念品。"
                                },
                                {
                                    "id": "721150123",
                                    "speaker": "泽维尔",
                                    "text": "这样的纪念品我还有很多，但蒙德的纪念品我已经喝干净了…味道非常不错。"
                                },
                                {
                                    "id": "721150124",
                                    "speaker": "泽维尔",
                                    "text": "好了，我们还是说正事吧。为了搞定这个「御影炉心」，我有一个小计划，想要请您帮帮忙。",
                                    "choices": [
                                        {
                                            "id": "721150125",
                                            "text": "没问题。",
                                            "response": [
                                                {
                                                    "id": "721150126",
                                                    "speaker": "泽维尔",
                                                    "text": "啊哈！我就是喜欢您这样…直爽的性格，太棒了！"
                                                },
                                                {
                                                    "id": "721150131",
                                                    "speaker": "泽维尔",
                                                    "text": "咳，我们说回正题。这些「侦测信标」请拿好了。"
                                                },
                                                {
                                                    "id": "721150132",
                                                    "speaker": "泽维尔",
                                                    "text": "我想拜托您，把这些「侦测信标」放在几个位置上。"
                                                },
                                                {
                                                    "id": "721150133",
                                                    "speaker": "泽维尔",
                                                    "text": "这些信标能搜集「御影炉心」内「祟神」力量的浓度与分布数据，只要有这些数据，我就能制订更详细的计划。",
                                                    "choices": [
                                                        {
                                                            "id": "721150134",
                                                            "text": "交给我吧。",
                                                            "response": [
                                                                {
                                                                    "id": "721150135",
                                                                    "speaker": "泽维尔",
                                                                    "text": "那就拜托您了。"
                                                                },
                                                                {
                                                                    "id": "721150141",
                                                                    "speaker": "泽维尔",
                                                                    "text": "我把那些放置点给您标记在地图上，就拜托您了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "721150136",
                                                            "text": "这信标到底是什么原理…",
                                                            "response": [
                                                                {
                                                                    "id": "721150137",
                                                                    "speaker": "泽维尔",
                                                                    "text": "简单来说…就是一种基于元素力原理，对于各类能量进行量化测算的仪器。"
                                                                },
                                                                {
                                                                    "id": "721150138",
                                                                    "speaker": "泽维尔",
                                                                    "text": "「简单来说」…虽然我想这么说，但它的运作也没办法简单地讲明白。对了，就从七大元素说起吧！是这样的…"
                                                                },
                                                                {
                                                                    "id": "721150139",
                                                                    "speaker": "Player",
                                                                    "text": "不、不用说了。"
                                                                },
                                                                {
                                                                    "id": "721150140",
                                                                    "speaker": "泽维尔",
                                                                    "text": "好吧，如您所愿。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721150127",
                                            "text": "我能得到什么好处？",
                                            "response": [
                                                {
                                                    "id": "721150128",
                                                    "speaker": "泽维尔",
                                                    "text": "好处嘛…当然是这座岛上那些还没被发现的宝藏，和「御影炉心」里的一些「边角料」。"
                                                },
                                                {
                                                    "id": "721150129",
                                                    "speaker": "泽维尔",
                                                    "text": "您瞧，作为稻妻最大的冶炼设施，「御影炉心」里肯定还有些…嗯…值得一看的好东西。"
                                                },
                                                {
                                                    "id": "721150130",
                                                    "speaker": "泽维尔",
                                                    "text": "当然！作为一个没有「神之眼」的人，我现在可没办法进入「御影炉心」，那里面的情况，我也无从知晓啦。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721150106",
                            "text": "坏消息。",
                            "response": [
                                {
                                    "id": "721150107",
                                    "speaker": "泽维尔",
                                    "text": "坏消息是，那群愚人众还在「御影炉心」内部折腾。"
                                },
                                {
                                    "id": "721150108",
                                    "speaker": "泽维尔",
                                    "text": "他们似乎还在不断寻找染指「祟神」核心的方法。"
                                },
                                {
                                    "id": "721150109",
                                    "speaker": "泽维尔",
                                    "text": "虽然好消息是，现在炉心的损毁似乎并不严重，还在我可以处理的范围内…"
                                },
                                {
                                    "id": "721150110",
                                    "speaker": "泽维尔",
                                    "text": "但很明显，愚人众并不太乐意接受这个好消息。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7211502",
            "objective": "与泽维尔对话",
            "dialogues": []
        },
        {
            "id": "7211503",
            "objective": "放置信标",
            "dialogues": [
                {
                    "id": "721150301",
                    "speaker": "泽维尔",
                    "text": "您放好信标了吗？"
                },
                {
                    "id": "721150302",
                    "speaker": "Player",
                    "text": "已经放好了。"
                },
                {
                    "id": "721150303",
                    "speaker": "泽维尔",
                    "text": "多谢您了，就让它们慢慢地搜集数据吧。",
                    "choices": [
                        {
                            "id": "721150304",
                            "text": "你为什么会知道那些地点？",
                            "response": [
                                {
                                    "id": "721150305",
                                    "speaker": "泽维尔",
                                    "text": "这个「御影炉心」我也参与了设计，在那几个点上放置信标，基本上就可以搜集「御影炉心」内大部分区域的数据。"
                                },
                                {
                                    "id": "721150306",
                                    "speaker": "泽维尔",
                                    "text": "唉，要是能直接在那几个点上设置净化仪器的话，睡一觉这事就基本上结束了。"
                                },
                                {
                                    "id": "721150307",
                                    "speaker": "泽维尔",
                                    "text": "现在这个情况…要是弗洛瓦先生知道的话，他非疯了不可…"
                                },
                                {
                                    "id": "721150311",
                                    "speaker": "泽维尔",
                                    "text": "好了，谢谢您帮忙，这些东西请先收下吧。"
                                },
                                {
                                    "id": "721150312",
                                    "speaker": "泽维尔",
                                    "text": "咳，那个…过段时间，说不定还得麻烦您把那些信标拿回来。"
                                },
                                {
                                    "id": "721150313",
                                    "speaker": "泽维尔",
                                    "text": "毕竟我泽维尔没有「神之眼」，没办法自由进出「祟神」能量如此浓厚的区域。"
                                },
                                {
                                    "id": "721150314",
                                    "speaker": "泽维尔",
                                    "text": "更何况，里面还有那些…行事粗暴的愚人众。我想，这座岛上应该也只有您能同时对付这两者了。"
                                }
                            ]
                        },
                        {
                            "id": "721150308",
                            "text": "这信标卖吗？",
                            "response": [
                                {
                                    "id": "721150309",
                                    "speaker": "泽维尔",
                                    "text": "您别开玩笑了，先不论这信标本身多少钱，要是我卖给您了，我用什么去…"
                                },
                                {
                                    "id": "721150310",
                                    "speaker": "泽维尔",
                                    "text": "要是您以后去了枫丹，我倒是能给您介绍几个卖这种信标的人，价钱一定公道。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7211504",
            "objective": "放置信标",
            "dialogues": [
                {
                    "id": "721150401",
                    "speaker": "泽维尔",
                    "text": "希望这件事能就此结束…再这么下去，非得变成外交问题不可…"
                }
