    },
    "talks": [
        {
            "id": "7180201",
            "objective": "",
            "dialogues": [
                {
                    "id": "718020101",
                    "speaker": "派蒙",
                    "text": "(test)喂，我们要不要再去留云仙人那里拜访下，给他带点好吃的？"
                },
                {
                    "id": "718020102",
                    "speaker": "派蒙",
                    "text": "(test)虽说上次见他，他好像脾气不太好的样子。"
                },
                {
                    "id": "718020103",
                    "speaker": "留云借风真君",
                    "text": "(test)我猜应该是还没吃饱的缘故吧…"
                }
            ]
        },
        {
            "id": "7180202",
            "objective": "供奉「美味的珍珠翡翠白玉汤」",
            "dialogues": [
                {
                    "id": "718020201",
                    "speaker": "留云借风真君",
                    "text": "不错，确实是我造「云中仙居」时所著的图纸。"
                },
                {
                    "id": "718020202",
                    "speaker": "Player",
                    "text": "您到底拿这图纸…"
                },
                {
                    "id": "718020203",
                    "speaker": "留云借风真君",
                    "text": "你怎么还在问？算了，看在你供奉于我的份上…"
                },
                {
                    "id": "718020204",
                    "speaker": "留云借风真君",
                    "text": "我听说，这璃月港里的凡人也造了一座能浮于空中的楼阁「群玉阁」。"
                },
                {
                    "id": "718020205",
                    "speaker": "留云借风真君",
                    "text": "我还听人说，凡人只凭大小，就断定这「群玉阁」举世无双。"
                },
                {
                    "id": "718020206",
                    "speaker": "留云借风真君",
                    "text": "哼，真是凡人眼界，不识得仙家巧妙。"
                },
                {
                    "id": "718020207",
                    "speaker": "留云借风真君",
                    "text": "区区「群玉阁」…本仙略展机巧，就让它黯然失色！"
                },
                {
                    "id": "718020208",
                    "speaker": "Player",
                    "text": "您是…不服气？"
                },
                {
                    "id": "718020209",
                    "speaker": "留云借风真君",
                    "text": "不服气？你说什么怪话，本仙只是可怜凡人不识得仙家巧妙，被一些凡间拙技蒙了眼目。"
                },
                {
                    "id": "718020210",
                    "speaker": "留云借风真君",
                    "text": "长此以往，只怕凡间机关之术要走上歧途，本仙是准备亲自点拨他们一番罢了。"
                },
                {
                    "id": "718020211",
                    "speaker": "留云借风真君",
                    "text": "好了，此事已了，你们赶紧离开吧，莫再扰本仙的清净。"
                }
            ]
        },
        {
            "id": "7180207",
            "objective": "拜见「留云借风真君」",
            "dialogues": [
                {
                    "id": "718020301",
                    "speaker": "留云借风真君",
                    "text": "有什么事，快点说，还有诸多事宜等着本仙去筹备，莫要再耽误时间了！"
                },
                {
                    "id": "718020302",
                    "speaker": "Player",
                    "text": "只是向您问好。"
                },
                {
                    "id": "718020303",
                    "speaker": "留云借风真君",
                    "text": "……"
                },
                {
                    "id": "718020304",
                    "speaker": "留云借风真君",
                    "text": "你们倒是新奇…不为许愿，只是想问个好？"
                },
                {
                    "id": "718020305",
                    "speaker": "留云借风真君",
                    "text": "罢了，随你们的愿吧，凡人的心思，我向来是懒得揣测的。"
                },
                {
                    "id": "718020306",
                    "speaker": "留云借风真君",
                    "text": "如果你们真的如此之闲，不如就来帮本仙个忙怎么样？"
                },
                {
                    "id": "718020307",
                    "speaker": "留云借风真君",
                    "text": "昔日，我研习机关术略有小成时，曾造了一座「云中仙居」浮于空中。"
                },
                {
                    "id": "718020308",
                    "speaker": "留云借风真君",
                    "text": "这「云中仙居」以浮生石为材，辅以万般机巧，最妙的是其中…算了，和你们说了你们也不懂。"
                },
                {
                    "id": "718020309",
                    "speaker": "留云借风真君",
                    "text": "我在造好「云中仙居」之后，也把图纸留在了上面。"
                },
                {
                    "id": "718020310",
                    "speaker": "留云借风真君",
                    "text": "本仙在上面略施封印，本来想的是有缘者得之，但这么久了，封印也没被触动过。"
                },
                {
                    "id": "718020311",
                    "speaker": "留云借风真君",
                    "text": "本仙也懒得将这图纸放在那了，你们就帮我去「云中仙居」把这图纸拿回来吧。",
                    "choices": [
                        {
                            "id": "718020312",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "718020313",
                                    "speaker": "留云借风真君",
                                    "text": "你倒是爽快，那就快去吧。拿到了就送进洞府来，本仙就在洞府里等着你们。"
                                }
                            ]
                        },
                        {
                            "id": "718020314",
                            "text": "您拿这图纸做什么？",
                            "response": [
                                {
                                    "id": "718020315",
                                    "speaker": "留云借风真君",
                                    "text": "我自有用意，和你说了你也不明白。"
                                },
                                {
                                    "id": "718020316",
                                    "speaker": "留云借风真君",
                                    "text": "快去吧。拿到了就送进洞府来，本仙就在洞府里等着你们。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7180203",
            "objective": "前往云中仙居寻找图纸",
            "dialogues": []
        },
        {
            "id": "7180204",
            "objective": "将图纸交给「留云借风真君」",
            "dialogues": [
                {
                    "id": "718020501",
                    "speaker": "留云借风真君",
                    "text": "看来你们拿到图纸了，行了，快点进来把图纸送过来吧。"
                }
            ]
        },
        {
            "id": "7180205",
            "objective": "进入仙府$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7180206",
            "objective": "将图纸送至「留云借风真君」面前",
            "dialogues": []
        },
        {
            "id": "7180204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718020401",
                    "speaker": "留云借风真君",
                    "text": "你们还没拿到图纸吗？就在「云中仙居」上…"
                },
                {
                    "id": "718020402",
                    "speaker": "派蒙",
                    "text": "咦，她怎么知道我们还没拿到图纸的…"
                },
                {
                    "id": "718020403",
                    "speaker": "留云借风真君",
                    "text": "那图纸是本仙亲著，在不在近前本仙难道不知道吗？快点去拿图纸吧。"
                }
            ]
        },
        {
            "id": "7180210",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718021001",
                    "speaker": "留云借风真君…？",
                    "text": "绝云访仙，绝非易事。汝等来此叩访…"
                },
                {
                    "id": "718021002",
                    "speaker": "派蒙",
                    "text": "呜哇！她、她不是已经去璃月港了吗？难道是又悄悄回来了？"
                },
                {
                    "id": "718021003",
                    "speaker": "Player",
                    "text": "感觉…声音不太对？"
                },
                {
                    "id": "718021004",
                    "speaker": "派蒙",
                    "text": "那个…仙君，我们就是担心有人去你家偷东西，没有打扰你的意思…"
                },
                {
                    "id": "718021005",
                    "speaker": "留云借风真君…？",
                    "text": "…本仙有善务一件，如能妥善处之，便可入得仙府。",
                    "choices": [
                        {
                            "id": "718021006",
                            "text": "自顾自地说下去了…",
                            "response": [
                                {
                                    "id": "718021008",
                                    "speaker": "派蒙",
                                    "text": "欸？你是说，现在和我们说话的不是留云真君，而是她留下的机关？"
                                },
                                {
                                    "id": "718021009",
                                    "speaker": "留云借风真君…？",
                                    "text": "昔日，我研习机关术略有小成时，曾造了一座「云中仙居」浮于空中。"
                                },
                                {
                                    "id": "718021010",
                                    "speaker": "留云借风真君…？",
                                    "text": "「云中仙居」善成后，本仙念在仙缘难得，便将图纸留于其上，有缘者自取之。"
                                },
                                {
                                    "id": "718021011",
                                    "speaker": "留云借风真君…？",
                                    "text": "你且去取来图纸，再入仙府详述。"
                                },
                                {
                                    "id": "718021012",
                                    "speaker": "Player",
                                    "text": "仙君？"
                                },
                                {
                                    "id": "718021013",
                                    "speaker": "派蒙",
                                    "text": "留云真君？闲…闲云小姐？"
                                },
                                {
                                    "id": "718021014",
                                    "speaker": "留云借风真君…？",
                                    "text": "你且去取来图纸，了此善务，再入仙府详述。"
                                },
                                {
                                    "id": "718021015",
                                    "speaker": "派蒙",
                                    "text": "完全不搭理我们嘛，还是自顾自地说个没完…",
                                    "choices": [
                                        {
                                            "id": "718021016",
                                            "text": "绝对是机关。",
                                            "response": [
                                                {
                                                    "id": "718021018",
                                                    "speaker": "派蒙",
                                                    "text": "可是，一般守卫洞府的不应该是那种…会砰砰砰打人的机关吗？",
                                                    "choices": [
                                                        {
                                                            "id": "718021019",
                                                            "text": "也许她有自己的考量吧。",
                                                            "response": [
                                                                {
                                                                    "id": "718021021",
                                                                    "speaker": "派蒙",
                                                                    "text": "不然，我们去把那个图纸拿到手吧，然后再进洞府看看。"
                                                                },
                                                                {
                                                                    "id": "718021022",
                                                                    "speaker": "派蒙",
                                                                    "text": "嘿嘿，我也有点好奇，她到底在洞府里放了什么机关。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "718021020",
                                                            "text": "有点在意那个图纸…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "718021017",
                                            "text": "开始复述最后一句了呢…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "718021007",
                            "text": "难道这声音是什么机关…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7180211",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718021101",
                    "speaker": "留云借风真君…？",
                    "text": "昔日，我研习机关术略有小成时，曾造了一座「云中仙居」浮于空中。"
                },
                {
                    "id": "718021102",
                    "speaker": "留云借风真君…？",
                    "text": "「云中仙居」善成后，本仙念在仙缘难得，便将图纸留于其上，有缘者自取之。"
                },
                {
                    "id": "718021103",
                    "speaker": "留云借风真君…？",
                    "text": "你且去取来图纸，再入仙府详述。"
                }
            ]
        },
        {
            "id": "7180212",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718021201",
                    "speaker": "留云借风真君…？",
                    "text": "能取来图纸，确有仙缘。上前来见吧。"
                }
            ]
        },
        {
            "id": "7180213",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718021301",
                    "speaker": "派蒙",
                    "text": "…这是什么，一张桌子上面…放了一个匣子。周围什么都没有。",
                    "choices": [
                        {
                            "id": "718021302",
                            "text": "是仙人桌子。",
                            "response": [
                                {
                                    "id": "718021304",
                                    "speaker": "留云借风真君…？",
                                    "text": "能到达此地，本仙已知你本心…"
                                },
                                {
                                    "id": "718021305",
                                    "speaker": "派蒙",
                                    "text": "又说话了！"
                                },
                                {
                                    "id": "718021306",
                                    "speaker": "留云借风真君…？",
                                    "text": "记述所愿，纳入匣内。本仙自会定夺。"
                                },
                                {
                                    "id": "718021307",
                                    "speaker": "留云借风真君…？",
                                    "text": "…履难历险，矢志不移，心志坚韧实为难得。这些宝货可自取走。"
                                },
                                {
                                    "id": "718021308",
                                    "speaker": "派蒙",
                                    "text": "好欸！嘿嘿，我就知道仙君不会让我们白跑嘛。"
                                },
                                {
                                    "id": "718021309",
                                    "speaker": "派蒙",
                                    "text": "不过，这个声音说「记述所愿，纳入匣内」…是要我们把愿望写下来放进匣子里？",
                                    "choices": [
                                        {
                                            "id": "718021310",
                                            "text": "还是不要随便向仙人许愿啦…",
                                            "response": [
                                                {
                                                    "id": "718021312",
                                                    "speaker": "派蒙",
                                                    "text": "好吧…也对，要是我们有什么事，直接去找留…闲云小姐商量就好了，嘿嘿。"
                                                },
                                                {
                                                    "id": "718021313",
                                                    "speaker": "派蒙",
                                                    "text": "那我们就把图纸放进匣子里，然后离开这里吧。"
                                                },
                                                {
                                                    "id": "718021314",
                                                    "speaker": "派蒙",
                                                    "text": "但周围空荡荡的，什么也没有。应该是真君把东西都拿走了吧。"
                                                },
                                                {
                                                    "id": "718021315",
                                                    "speaker": "Player",
                                                    "text": "这些机关是为了应对什么情况呢…"
                                                },
                                                {
                                                    "id": "718021316",
                                                    "speaker": "派蒙",
                                                    "text": "我也不明白…"
                                                },
                                                {
                                                    "id": "718021317",
                                                    "speaker": "派蒙",
                                                    "text": "总之，等我们下次见到真君的时候，再向她问问洞府的事吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "718021311",
                                            "text": "向熟人许愿，总觉得…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "718021303",
                            "text": "和仙人匣子。"
                        }
                    ]
                }
            ]
        }
    ]
}