    },
    "talks": [
        {
            "id": "4142101",
            "objective": "前往蒙德冒险家协会找凯瑟琳",
            "dialogues": [
                {
                    "id": "414210101",
                    "speaker": "凯瑟琳",
                    "text": "旅行者，你好啊。最近可别来无恙？"
                },
                {
                    "id": "414210102",
                    "speaker": "派蒙",
                    "text": "又发生了什么奇怪的事情了吗，凯瑟琳？"
                },
                {
                    "id": "414210103",
                    "speaker": "凯瑟琳",
                    "text": "和之前那些大事件相比，这件事有些不足为奇。不过因为它事关蒙德的经济，还是挺头疼的。",
                    "choices": [
                        {
                            "id": "414210104",
                            "text": "是什么事情呢？",
                            "response": [
                                {
                                    "id": "414210106",
                                    "speaker": "凯瑟琳",
                                    "text": "最近啊，酒庄附近的水源毫无征兆的变苦了。这样下去，未来几年的酿酒业会遭受灭顶之灾。"
                                },
                                {
                                    "id": "414210107",
                                    "speaker": "凯瑟琳",
                                    "text": "具体的事情，就请你和酒庄的康纳谈一谈吧。"
                                }
                            ]
                        },
                        {
                            "id": "414210105",
                            "text": "蒙德的经济？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4142102",
            "objective": "前往晨曦酒庄询问康纳",
            "dialogues": [
                {
                    "id": "414210201",
                    "speaker": "康纳",
                    "text": "协会派来协助的人员就是你们吗？"
                },
                {
                    "id": "414210202",
                    "speaker": "派蒙",
                    "text": "是我们。"
                },
                {
                    "id": "414210203",
                    "speaker": "康纳",
                    "text": "那我就放心了。关于这件事，比起让我来说，你们还是自己体验一下比较好。"
                },
                {
                    "id": "414210204",
                    "speaker": "康纳",
                    "text": "这瓶水是就近取用的。它已经经过了所有的净水工序，绝对卫生。你可以放心尝尝看。"
                },
                {
                    "id": "414210205",
                    "speaker": "派蒙",
                    "text": "我也要我也要！我也想试试。"
                },
                {
                    "id": "414210206",
                    "speaker": "Player",
                    "text": "（尝一口…）"
                },
                {
                    "id": "414210207",
                    "speaker": "派蒙",
                    "text": "呜啊，呸呸呸。这个苦味…"
                },
                {
                    "id": "414210208",
                    "speaker": "康纳",
                    "text": "这个苦味用传统的净水手段根本去不掉，不是成分上的问题。应该又是神奇元素力引发的现象吧。"
                },
                {
                    "id": "414210209",
                    "speaker": "康纳",
                    "text": "这样的水可根本无法酿酒啊。"
                },
                {
                    "id": "414210210",
                    "speaker": "派蒙",
                    "text": "那附近的鱼最近生活也很艰难吧。"
                },
                {
                    "id": "414210211",
                    "speaker": "康纳",
                    "text": "我们试过了，那些被苦得翻肚皮的鱼，做成菜都是苦的。"
                },
                {
                    "id": "414210212",
                    "speaker": "派蒙",
                    "text": "…我都没想这么远！"
                },
                {
                    "id": "414210213",
                    "speaker": "康纳",
                    "text": "总之，事情就是这样。如果你问我有什么头绪没有的话，我直觉认为应该向北去调查。不知璃月碧水河和轻策庄的水现在味道如何？"
                }
            ]
        },
        {
            "id": "4142103",
            "objective": "沿着水域向西北调查",
            "dialogues": []
        },
        {
            "id": "4142104",
            "objective": "击败出现的水史莱姆",
            "dialogues": []
        },
        {
            "id": "4142105",
            "objective": "与奇怪的生物对话",
            "dialogues": [
                {
                    "id": "414210501",
                    "speaker": "派蒙",
                    "text": "唔啊，居然掉下来了一个…"
                },
                {
                    "id": "414210502",
                    "speaker": "奇怪的生物",
                    "text": "嫣朵拉，没有水，快死了…"
                },
                {
                    "id": "414210503",
                    "speaker": "派蒙",
                    "text": "嫣朵拉，是你的名字吗？"
                },
                {
                    "id": "414210504",
                    "speaker": "嫣朵拉",
                    "text": "苦味，是敌意。会杀掉嫣朵拉。"
                },
                {
                    "id": "414210505",
                    "speaker": "派蒙",
                    "text": "虽然不知道怎么办。要怎么样才能拯救你呢？"
                },
                {
                    "id": "414210506",
                    "speaker": "嫣朵拉",
                    "text": "要去，有甜甜水的地方。要去，清泉。"
                },
                {
                    "id": "414210507",
                    "speaker": "嫣朵拉",
                    "text": "嫣朵拉，寄宿水团子，代步。没水。嫣朵拉，无处栖身。"
                },
                {
                    "id": "414210508",
                    "speaker": "派蒙",
                    "text": "我们要怎么把它带去有清泉的地方呢？"
                },
                {
                    "id": "414210509",
                    "speaker": "Player",
                    "text": "这里倒是有一瓶水。"
                },
                {
                    "id": "414210510",
                    "speaker": "派蒙",
                    "text": "可是这瓶水也是苦味的啊。"
                },
                {
                    "id": "414210511",
                    "speaker": "嫣朵拉",
                    "text": "嫣朵拉，可以忍耐。但是，不能很久。"
                },
                {
                    "id": "414210512",
                    "speaker": "派蒙",
                    "text": "哦哦，那事不宜迟。赶紧出发前往有清泉的地方吧。"
                },
                {
                    "id": "414210513",
                    "speaker": "派蒙",
                    "text": "不过这个家伙靠着水史莱姆旅行了这么远，和我们的关系很像呢。"
                }
            ]
        },
        {
            "id": "4142106",
            "objective": "返回清泉镇",
            "dialogues": [
                {
                    "id": "414210601",
                    "speaker": "嫣朵拉",
                    "text": "这里，水是甜的。嫣朵拉发现了，是同类。"
                },
                {
                    "id": "414210602",
                    "speaker": "嫣朵拉",
                    "text": "嫣朵拉，同类，把水变好喝。也变苦，是洛蒂娅干的。"
                },
                {
                    "id": "414210603",
                    "speaker": "派蒙",
                    "text": "这么说来，清泉镇似乎的确有泉水精灵的传说来着？"
                },
                {
                    "id": "414210604",
                    "speaker": "派蒙",
                    "text": "不过我们还是赶紧先去泉水边把瓶子里苦味的水换掉吧。"
                }
            ]
        },
        {
            "id": "4142107",
            "objective": "靠近清泉镇的泉水",
            "dialogues": [
                {
                    "id": "414210701",
                    "speaker": "老芬奇",
                    "text": "…你是？"
                },
                {
                    "id": "414210702",
                    "speaker": "派蒙",
                    "text": "哇啊啊，嫣朵拉你怎么自己跑出来了！"
                },
                {
                    "id": "414210703",
                    "speaker": "嫣朵拉",
                    "text": "我是嫣朵拉。纯水的精灵。"
                },
                {
                    "id": "414210704",
                    "speaker": "派蒙",
                    "text": "这么说来，这位老爷爷似乎就是深信着清泉精灵存在的人来着。"
                },
                {
                    "id": "414210705",
                    "speaker": "老芬奇",
                    "text": "…嗯。"
                },
                {
                    "id": "414210706",
                    "speaker": "老芬奇",
                    "text": "你和她简直一模一样。不过你要小多了啊。"
                },
                {
                    "id": "414210707",
                    "speaker": "嫣朵拉",
                    "text": "嫣朵拉，还小！嫣朵拉，在学习。"
                },
                {
                    "id": "414210708",
                    "speaker": "老芬奇",
                    "text": "不过，你出现在我的面前，至少证明了那场相识不是我的白日梦。"
                },
                {
                    "id": "414210709",
                    "speaker": "嫣朵拉",
                    "text": "她还在。名字，不知道。不知道，也不回答嫣朵拉。"
                },
                {
                    "id": "414210710",
                    "speaker": "嫣朵拉",
                    "text": "嫣朵拉，要联系她。嫣朵拉，能带话。你要说什么？"
                },
                {
                    "id": "414210711",
                    "speaker": "老芬奇",
                    "text": "你是说，她一直都在吗？你可以帮我向她带话？"
                },
                {
                    "id": "414210712",
                    "speaker": "嫣朵拉",
                    "text": "是的，是的。"
                },
                {
                    "id": "414210713",
                    "speaker": "老芬奇",
                    "text": "…嗯。"
                },
                {
                    "id": "414210714",
                    "speaker": "老芬奇",
                    "text": "我已经很老了。我…"
                },
                {
                    "id": "414210715",
                    "speaker": "老芬奇",
                    "text": "帮我向她问声好吧。"
                }
            ]
        },
        {
            "id": "4142108",
            "objective": "与嫣朵拉对话",
            "dialogues": [
                {
                    "id": "414210801",
                    "speaker": "嫣朵拉",
                    "text": "…"
                },
                {
                    "id": "414210802",
                    "speaker": "嫣朵拉",
                    "text": "她说了一些奇怪的话，不懂。"
                },
                {
                    "id": "414210803",
                    "speaker": "嫣朵拉",
                    "text": "馋…缠…什么的，看不懂。问也不回答。"
                },
                {
                    "id": "414210804",
                    "speaker": "Player",
                    "text": "识字数和词汇量不足啊。"
                },
                {
                    "id": "414210805",
                    "speaker": "派蒙",
                    "text": "大概是有不能和大家见面的理由吧。"
                },
                {
                    "id": "414210806",
                    "speaker": "嫣朵拉",
                    "text": "不明白。纯水精灵，我们，喜欢融合在一起。"
                },
                {
                    "id": "414210807",
                    "speaker": "嫣朵拉",
                    "text": "她，一个意识，孤独。"
                },
                {
                    "id": "414210808",
                    "speaker": "派蒙",
                    "text": "我想大概是因为其他生物和你们没办法融合吧。"
                },
                {
                    "id": "414210809",
                    "speaker": "嫣朵拉",
                    "text": "诶，没办法吗？"
                },
                {
                    "id": "414210810",
                    "speaker": "派蒙",
                    "text": "会在你们的身体里淹死的！"
                },
                {
                    "id": "414210811",
                    "speaker": "嫣朵拉",
                    "text": "你们真孤独。我们，所有人，爱所有人。"
                },
                {
                    "id": "414210812",
                    "speaker": "嫣朵拉",
                    "text": "啊！"
                },
                {
                    "id": "414210813",
                    "speaker": "派蒙",
                    "text": "突然怎么了？"
                },
                {
                    "id": "414210814",
                    "speaker": "嫣朵拉",
                    "text": "石门附近，洛蒂娅的眼线！水的小动物。是，侦察兵。"
                },
                {
                    "id": "414210815",
                    "speaker": "派蒙",
                    "text": "这么说来似乎的确在附近看到过纯水小动物来着？",
                    "choices": [
                        {
                            "id": "414210816",
                            "text": "好像是见过。",
                            "response": [
                                {
                                    "id": "414210818",
                                    "speaker": "嫣朵拉",
                                    "text": "强大的水，幻化，小动物。很危险。但是，和它们融合，可以学到东西。"
                                },
                                {
                                    "id": "414210819",
                                    "speaker": "嫣朵拉",
                                    "text": "带我去。那边那边。洛蒂娅很不安。洛蒂娅把水变苦了。嫣朵拉学习说话，和洛蒂娅说清楚。"
                                },
                                {
                                    "id": "414210820",
                                    "speaker": "Player",
                                    "text": "你是说你能帮助我们？"
                                },
                                {
                                    "id": "414210821",
                                    "speaker": "嫣朵拉",
                                    "text": "是的，是的。"
                                },
                                {
                                    "id": "414210822",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我觉得还是值得一试的，毕竟我们目前也没有别的线索了。"
                                }
                            ]
                        },
                        {
                            "id": "414210817",
                            "text": "是吗，没注意到诶。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4142109",
            "objective": "帮助嫣朵拉捕获纯水动物",
            "dialogues": []
        },
        {
            "id": "4142110",
            "objective": "与嫣朵拉对话",
            "dialogues": [
                {
                    "id": "414211001",
                    "speaker": "嫣朵拉",
                    "text": "嫣朵拉我发现了！"
                },
                {
                    "id": "414211002",
                    "speaker": "派蒙",
                    "text": "呜啊，突然说话变利索了！"
                },
                {
                    "id": "414211003",
                    "speaker": "嫣朵拉",
                    "text": "通过和纯水小动物结合，词汇量增加了。明白了清泉镇的信息。"
                },
                {
                    "id": "414211004",
                    "speaker": "嫣朵拉",
                    "text": "「生命的溪水潺潺向前」，有一点点悲伤。是看不懂的小诗。不明白。"
                },
                {
                    "id": "414211005",
                    "speaker": "Player",
                    "text": "或许以后就会明白了。"
                },
                {
                    "id": "414211006",
                    "speaker": "嫣朵拉",
                    "text": "嫣朵拉我还需要学习。"
                },
                {
                    "id": "414211007",
                    "speaker": "嫣朵拉",
                    "text": "洛蒂娅最近很狂躁。如果能直面它，或许就可以解决问题了。"
                }
            ]
        },
        {
            "id": "4142152",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "414215201",
                    "speaker": "康纳",
                    "text": "雪山源头的水和清泉镇的水倒是没什么问题。问题应该出自璃月那边吧。"
                }
            ]
        },
        {
            "id": "4142157",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "414215701",
                    "speaker": "老芬奇",
                    "text": "她真的存在。可是为什么不再说话了呢？"
                }
            ]
        }
    ]
}