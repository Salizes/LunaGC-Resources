        }
    },
    "talks": [
        {
            "id": "7467501",
            "objective": "与工作人员对话",
            "dialogues": [
                {
                    "id": "746750101",
                    "speaker": "小露米埃尔",
                    "text": "美好的一天，不是吗？"
                },
                {
                    "id": "746750102",
                    "speaker": "小露米埃尔",
                    "text": "出名到你们这种程度，应该不断会有人向你们递名片吧。"
                },
                {
                    "id": "746750103",
                    "speaker": "派蒙",
                    "text": "#唔…你认识我们？{NICKNAME}，这个孩子好老成啊。"
                },
                {
                    "id": "746750104",
                    "speaker": "小露米埃尔",
                    "text": "仅仅因为对面年纪尚轻就轻视别人，是无知者才会犯的毛病，我想两位不至于如此肤浅。"
                },
                {
                    "id": "746750105",
                    "speaker": "小露米埃尔",
                    "text": "尽管我无意自夸，但我和兄长是本地小有名气的映影导演，大家更习惯称呼我为小露米埃尔先生。",
                    "choices": [
                        {
                            "id": "746750106",
                            "text": "你好。",
                            "response": [
                                {
                                    "id": "746750108",
                                    "speaker": "小露米埃尔",
                                    "text": "没错，我对你们的冒险经历很感兴趣。在我们这行里，非凡的故事永远都会受到追捧。"
                                },
                                {
                                    "id": "746750109",
                                    "speaker": "小露米埃尔",
                                    "text": "既然你们还不认识我，那我就先做个自我介绍吧。"
                                },
                                {
                                    "id": "746750110",
                                    "speaker": "小露米埃尔",
                                    "text": "我和我的兄长已经合作拍摄映影很久了，也有过几部比较出名的片子，或许你们看过《工厂大门》…？"
                                },
                                {
                                    "id": "746750111",
                                    "speaker": "Player",
                                    "text": "没有。"
                                },
                                {
                                    "id": "746750112",
                                    "speaker": "小露米埃尔",
                                    "text": "哦，没关系，那么《进站》呢？"
                                },
                                {
                                    "id": "746750113",
                                    "speaker": "派蒙",
                                    "text": "也没有。"
                                },
                                {
                                    "id": "746750114",
                                    "speaker": "小露米埃尔",
                                    "text": "……"
                                },
                                {
                                    "id": "746750115",
                                    "speaker": "小露米埃尔",
                                    "text": "啊，这样啊。"
                                },
                                {
                                    "id": "746750116",
                                    "speaker": "小露米埃尔",
                                    "text": "…那也不足为奇，我们兄弟作为影人的道路还很长，以后会拍出更多家喻户晓的映影。"
                                },
                                {
                                    "id": "746750117",
                                    "speaker": "小露米埃尔",
                                    "text": "映影的制作，从构思故事、演员表演、摄影师和导演合作拍摄，再到处理成片，都是相当有趣的过程。"
                                },
                                {
                                    "id": "746750118",
                                    "speaker": "小露米埃尔",
                                    "text": "在这其中，我认为拍摄过程是最具有技术性的部分。"
                                },
                                {
                                    "id": "746750119",
                                    "speaker": "小露米埃尔",
                                    "text": "拍摄重点的取舍，决定了观者将得到怎样的信息、感受到怎样的氛围…"
                                },
                                {
                                    "id": "746750120",
                                    "speaker": "小露米埃尔",
                                    "text": "虽然旁白也很重要，但我们不能指望只靠旁白来构成一个故事。"
                                },
                                {
                                    "id": "746750121",
                                    "speaker": "小露米埃尔",
                                    "text": "四个镜头！我一直相信，只要四个镜头就可以构成一个最小的叙事单元。"
                                },
                                {
                                    "id": "746750122",
                                    "speaker": "小露米埃尔",
                                    "text": "在这四个镜头之内，天才可以创造奇迹。"
                                },
                                {
                                    "id": "746750123",
                                    "speaker": "小露米埃尔",
                                    "text": "两位想试试看吗？借这个机会，来感受一下映影的魅力吧！"
                                },
                                {
                                    "id": "746750124",
                                    "speaker": "派蒙",
                                    "text": "那我们该怎么做？"
                                },
                                {
                                    "id": "746750125",
                                    "speaker": "小露米埃尔",
                                    "text": "很简单。我可以为你们提供一些已经成形的短幅情节作为拍摄主题。"
                                },
                                {
                                    "id": "746750126",
                                    "speaker": "小露米埃尔",
                                    "text": "重点是尝试镜头与旁白的多种处理方式，从而完成几部短篇映影的拍摄。二位有兴趣吗？"
                                },
                                {
                                    "id": "746750127",
                                    "speaker": "Player",
                                    "text": "听起来很有趣。"
                                },
                                {
                                    "id": "746750128",
                                    "speaker": "小露米埃尔",
                                    "text": "太好了！那么二位准备好之后，随时可以前往我挑好的拍摄地点尝试拍摄，我也会针对拍摄好的成片提出反馈。"
                                }
                            ]
                        },
                        {
                            "id": "746750107",
                            "text": "你也要给我们名片吗？"
                        }
                    ]
                }
            ]
        }
    ]
}