        {
            "id": "7329801",
            "objective": "(test)前置中间特殊权限检查$HIDDEN",
            "dialogues": [
                {
                    "id": "683300101",
                    "speaker": "派蒙",
                    "text": "咦，这里居然留下了这样的记录…留下记录的人居然是哲伯莱勒！"
                },
                {
                    "id": "683300102",
                    "speaker": "派蒙",
                    "text": "哲伯莱勒，好熟悉的名字，咦，那不是…",
                    "choices": [
                        {
                            "id": "683300103",
                            "text": "是婕德的父亲…",
                            "response": [
                                {
                                    "id": "683300105",
                                    "speaker": "派蒙",
                                    "text": "从这里面来看，感觉这时候哲伯莱勒和萨梅尔关系还不错呢，毕竟以前是同一个部落的人，或许是一起到过这里。"
                                },
                                {
                                    "id": "683300106",
                                    "speaker": "派蒙",
                                    "text": "唔…难道这个放在边上的石头，就是他们在记录里留下的钥石…"
                                },
                                {
                                    "id": "683300107",
                                    "speaker": "派蒙",
                                    "text": "#真不知道有什么作用…嗯，{NICKNAME}，你有想到什么吗？"
                                },
                                {
                                    "id": "683300108",
                                    "speaker": "Player",
                                    "text": "是那块石板…"
                                },
                                {
                                    "id": "683300109",
                                    "speaker": "派蒙",
                                    "text": "石板上的符号，亮起来了！"
                                }
                            ]
                        },
                        {
                            "id": "683300104",
                            "text": "还提到了萨梅尔…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7329802",
            "objective": "(test)播放cs$HIDDEN",
            "dialogues": [
                {
                    "id": "732980201",
                    "speaker": "Black Screen",
                    "text": "在激活石板上的符号之后，钥石迅速沙化消失了…"
                },
                {
                    "id": "732980202",
                    "speaker": "派蒙",
                    "text": "呜哇，没想到那个钥石一下子变成了沙子。"
                },
                {
                    "id": "732980203",
                    "speaker": "派蒙",
                    "text": "看来这块钥石其实是和石板有关呢…居然在这里也会发现和石板相关的事，之后有空的话就告诉提尔扎德吧！"
                }
