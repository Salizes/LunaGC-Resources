        },
        {
            "id": "7305804",
            "objective": "和兰迦鲁对话",
            "dialogues": [
                {
                    "id": "730580201",
                    "speaker": "兰迦鲁",
                    "text": "怎么样，有发现什么吗？"
                },
                {
                    "id": "730580202",
                    "speaker": "派蒙",
                    "text": "唔…只发现了语焉不详的命令，还有这个！一朵风干的花！"
                },
                {
                    "id": "730580203",
                    "speaker": "兰迦鲁",
                    "text": "欸…！这个，可以给我吗？"
                },
                {
                    "id": "730580204",
                    "speaker": "派蒙",
                    "text": "这个是坏人留下的，你就不怕有毒…什么的吗？"
                },
                {
                    "id": "730580205",
                    "speaker": "兰迦鲁",
                    "text": "不需要担心，我见过这朵花…那个人，我应该见过…请你交给我，好吗？"
                },
                {
                    "id": "730580206",
                    "speaker": "Player",
                    "text": "请你拿去吧。"
                },
                {
                    "id": "730580207",
                    "speaker": "兰迦鲁",
                    "text": "#谢谢你！那菈{NICKNAME}和白飞飞！"
                },
                {
                    "id": "730580208",
                    "speaker": "Black Screen",
                    "text": "兰迦鲁将风干的小花带去了无郁稠林…"
                }
            ]
        },
        {
            "id": "7305807",
            "objective": "（test）调查点三$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7305804",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730580401",
                    "speaker": "兰迦鲁",
                    "text": "去看看坏蛋那菈的营地吧！一定能知道他们是来做什么的！"
                },
                {
                    "id": "730580402",
                    "speaker": "Player",
                    "text": "你是怎么分辨坏蛋的？"
                },
                {
                    "id": "730580403",
                    "speaker": "兰迦鲁",
                    "text": "#唔…不知道，说不清楚！但是我知道，那菈{NICKNAME}和白飞飞一定不是坏人！兰迦鲁相信！"
                }
            ]
        }
