    "talks": [
        {
            "id": "7305801",
            "objective": "击败山洞里的镀金旅团$HIDDEN",
            "dialogues": [
                {
                    "id": "730580101",
                    "speaker": "兰迦鲁",
                    "text": "金色的那菈，白色的飞飞！又见到你们啦！"
                },
                {
                    "id": "730580102",
                    "speaker": "派蒙",
                    "text": "呜哇，下次突然出现请打声招呼啦！又吓我一跳！",
                    "choices": [
                        {
                            "id": "730580103",
                            "text": "我们不是坏人。",
                            "response": [
                                {
                                    "id": "730580105",
                                    "speaker": "兰迦鲁",
                                    "text": "哼…你们说的有道理啦…所以，看起来不像坏蛋的金色那菈和白飞飞，可以再帮我一个忙吗？"
                                },
                                {
                                    "id": "730580106",
                                    "speaker": "Player",
                                    "text": "#乐意效劳，我是{NICKNAME}。"
                                },
                                {
                                    "id": "730580107",
                                    "speaker": "派蒙",
                                    "text": "我是派蒙，这次可别忘啦！"
                                },
                                {
                                    "id": "730580108",
                                    "speaker": "兰迦鲁",
                                    "text": "这次…？呃…咳咳，我是兰迦鲁！"
                                },
                                {
                                    "id": "730580109",
                                    "speaker": "派蒙",
                                    "text": "#我们和你一起来过这里哦，但是你忘记啦…唔，好难解释！{NICKNAME}，我们一起给他讲讲吧？"
                                },
                                {
                                    "id": "730580110",
                                    "speaker": "Black Screen",
                                    "text": "你们具言了与兰迦鲁冒险的所见所闻。"
                                },
                                {
                                    "id": "730580111",
                                    "speaker": "兰迦鲁",
                                    "text": "这样吗…虽然我不记得了，但不知为什么，我愿意相信你们…而且你们有我送的花，我能感知到她在。"
                                },
                                {
                                    "id": "730580112",
                                    "speaker": "兰迦鲁",
                                    "text": "啊，对了！坏蛋那菈留下了营地，我们去找找看他们留下了什么东西，说不定能知道他们在盘算什么！"
                                }
                            ]
                        },
                        {
                            "id": "730580104",
                            "text": "我们帮你打跑了坏人。"
                        }
                    ]
                }
            ]
        },
