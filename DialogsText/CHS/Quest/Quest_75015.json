        ],
        "rewards_formatted": "冒险阅历 x150, 原石 x20, 摩拉 x25000",
        "chapter": {
            "icon": "UI_ChapterIcon_LittleDrillhead",
            "id": "10204",
            "num": "",
            "title": "龙选者的旅迹"
        },
        "total_dialogue_lines": 66,
        "total_speaker_counts": {
            "#{REALNAME[ID(2)|SHOWHOST(true)]}": 12,
            "Black Screen": 5,
            "Player": 10,
            "派蒙": 39
        }
    },
    "talks": [
        {
            "id": "7501501",
            "objective": "(test)触发关卡演出完成剧情$HIDDEN",
            "dialogues": [
                {
                    "id": "750150101",
                    "speaker": "派蒙",
                    "text": "这条鱼的力气好大，刚才和我们拉扯了那么久，居然还能游得这么快。"
                },
                {
                    "id": "750150102",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀呀…"
                },
                {
                    "id": "750150103",
                    "speaker": "派蒙",
                    "text": "#嗯嗯，没关系，{NICKNAME}一定会把鱼抓回来的。"
                }
            ]
        },
        {
            "id": "7501506",
            "objective": "与龙伙伴对话",
            "dialogues": [
                {
                    "id": "750150601",
                    "speaker": "派蒙",
                    "text": "这片浅水海滩很不错呢！又暖和又明亮，还有人在这里支着钓竿，说不定这是个很好的钓点呢！"
                },
                {
                    "id": "750150602",
                    "speaker": "派蒙",
                    "text": "不如我们在这里钓钓看吧！"
                },
                {
                    "id": "750150603",
                    "speaker": "Player",
                    "text": "说不定能钓上另一个向导…"
                },
                {
                    "id": "750150604",
                    "speaker": "派蒙",
                    "text": "不许钓，而且世上哪有那么多的我能给你钓上来啦！"
                },
                {
                    "id": "750150605",
                    "speaker": "派蒙",
                    "text": "#还是钓点鱼吧，我们好像有段时间没吃{NICKNAME}做的鱼了，就让{REALNAME[ID(2)|SHOWHOST(true)]}也尝尝你的手艺嘛！"
                },
                {
                    "id": "750150606",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750150607",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，都是为了{REALNAME[ID(2)|SHOWHOST(true)]}嘛。"
                },
                {
                    "id": "750150608",
                    "speaker": "Player",
                    "text": "那派蒙也为它做点什么吧…"
                },
                {
                    "id": "750150609",
                    "speaker": "Player",
                    "text": "不如这次就由派蒙来钓鱼！"
                },
                {
                    "id": "750150610",
                    "speaker": "派蒙",
                    "text": "欸，我…我来钓鱼？"
                },
                {
                    "id": "750150611",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀！"
                },
                {
                    "id": "750150612",
                    "speaker": "Player",
                    "text": "#都是为了{REALNAME[ID(2)|SHOWHOST(true)]}嘛。"
                },
                {
                    "id": "750150613",
                    "speaker": "派蒙",
                    "text": "唔…居然拿我说的话来堵我！"
                },
                {
                    "id": "750150614",
                    "speaker": "派蒙",
                    "text": "那好吧…不过先说好了，我都不知道自己能钓起来什么东西！"
                },
                {
                    "id": "750150615",
                    "speaker": "派蒙",
                    "text": "以及在那之前…大钓手派蒙需要一个干净的钓鱼环境，你看水面上有这么多东西，要是把线勾住了怎么办！"
                },
                {
                    "id": "750150616",
                    "speaker": "派蒙",
                    "text": "还是先收拾一下吧！"
                }
            ]
        },
        {
            "id": "7501502",
            "objective": "清理附近的水域",
            "dialogues": []
        },
        {
            "id": "7501505",
            "objective": "等待派蒙钓鱼",
            "dialogues": [
                {
                    "id": "750150501",
                    "speaker": "派蒙",
                    "text": "呼，总算清理完了，那、那我就要开始钓鱼了！"
                },
                {
                    "id": "750150502",
                    "speaker": "派蒙",
                    "text": "唔，我一定要钓上条大鱼给你们看看！"
                },
                {
                    "id": "750150503",
                    "speaker": "Black Screen",
                    "text": "但可惜水面一动不动，没有波澜。"
                },
                {
                    "id": "750150504",
                    "speaker": "派蒙",
                    "text": "唔…是不是这里的水质太好了？鱼儿根本不想从里面出来嘛！",
                    "choices": [
                        {
                            "id": "750150505",
                            "text": "胜利就在眼前，嘿嘿~",
                            "response": [
                                {
                                    "id": "750150506",
                                    "speaker": "派蒙",
                                    "text": "就是这样，「胜利就在眼前！」…不对，这才刚开始，离胜利还早着呢！"
                                },
                                {
                                    "id": "750150507",
                                    "speaker": "派蒙",
                                    "text": "不要在这种时候胡乱鼓励啦！"
                                },
                                {
                                    "id": "750150511",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔…"
                                },
                                {
                                    "id": "750150512",
                                    "speaker": "Player",
                                    "text": "要成功了，要成功了！"
                                },
                                {
                                    "id": "750150513",
                                    "speaker": "派蒙",
                                    "text": "哎呀，你别在这个时候说话啦…真是的！"
                                },
                                {
                                    "id": "750150514",
                                    "speaker": "派蒙",
                                    "text": "怎么了怎么了？哇！鱼竿动了，让我看看是什么好东西？"
                                },
                                {
                                    "id": "750150515",
                                    "speaker": "派蒙",
                                    "text": "#什么嘛，不是鱼，是个漂流瓶，而且还用线绑在了钓点的木板上…说起来，{NICKNAME}也经常钓上来奇怪的东西。"
                                },
                                {
                                    "id": "750150516",
                                    "speaker": "Player",
                                    "text": "钓鱼的什么都能钓到，除了鱼…"
                                },
                                {
                                    "id": "750150517",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}不也经常钓到些奇怪的东西嘛，毕竟是钓上来的，让我看看里面塞了什么…"
                                },
                                {
                                    "id": "750150518",
                                    "speaker": "派蒙",
                                    "text": "沉迷钓鱼的人，好可怕，难道刚才那堆乱七八糟的东西都是这两个人留下的？"
                                },
                                {
                                    "id": "750150519",
                                    "speaker": "派蒙",
                                    "text": "我们还是把这个瓶子扔回去吧，看来这就是他们互相联络的工具了…"
                                },
                                {
                                    "id": "750150520",
                                    "speaker": "派蒙",
                                    "text": "唔，我有预感，下次肯定能够钓到鱼的！"
                                },
                                {
                                    "id": "750150521",
                                    "speaker": "Black Screen",
                                    "text": "鱼竿猛地一沉，剧烈地抖动了起来，\\n水底下是个分量不轻的「大家伙」，恶狠狠地咬上了钩。"
                                },
                                {
                                    "id": "750150522",
                                    "speaker": "派蒙",
                                    "text": "终于吃钩了！这回一定是大鱼，给我上来——啊！"
                                },
                                {
                                    "id": "750150523",
                                    "speaker": "Player",
                                    "text": "给我上来——啊！"
                                },
                                {
                                    "id": "750150524",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀呀！！"
                                },
                                {
                                    "id": "750150525",
                                    "speaker": "Black Screen",
                                    "text": "#看到派蒙很吃力。\\n你和{REALNAME[ID(2)|SHOWHOST(true)]}一起抱住了派蒙…\\n但是，钓竿对面传来了巨大的拉力！"
                                },
                                {
                                    "id": "750150526",
                                    "speaker": "Black Screen",
                                    "text": "「砰」的一声，鱼脱钩了…"
                                },
                                {
                                    "id": "750150527",
                                    "speaker": "派蒙",
                                    "text": "呜呜！这一定是一条好大的鱼，鱼钩才会脱钩啦！"
                                },
                                {
                                    "id": "750150528",
                                    "speaker": "派蒙",
                                    "text": "真是气死了…啊，它居然还在水面上游来游去，岂有此理！"
                                },
                                {
                                    "id": "750150529",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀呀——"
                                },
                                {
                                    "id": "750150530",
                                    "speaker": "派蒙",
                                    "text": "不行不行，海里太危险了，你游得也没有鱼快啦…"
                                },
                                {
                                    "id": "750150531",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "唔…"
                                },
                                {
                                    "id": "750150532",
                                    "speaker": "派蒙",
                                    "text": "#要是有什么办法抓住那条鱼就好了，{NICKNAME}…"
                                }
                            ]
                        },
                        {
                            "id": "750150508",
                            "text": "快了快了，沉住气哦！",
                            "response": [
                                {
                                    "id": "750150509",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，鱼儿吃钩的时机，像甜甜花里蹿出来一朵骗骗花一样突然，完全没法预测…"
                                },
                                {
                                    "id": "750150510",
                                    "speaker": "派蒙",
                                    "text": "只能专注地等待——再等待——"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7501503",
            "objective": "追回逃跑的鱼",
            "dialogues": []
        },
        {
            "id": "7501504",
            "objective": "将鱼带回岸边",
            "dialogues": [
                {
                    "id": "750150401",
                    "speaker": "派蒙",
                    "text": "#锵锵！真不愧是{NICKNAME}，把这条嚣张的鱼抓到咯！"
                },
                {
                    "id": "750150402",
                    "speaker": "派蒙",
                    "text": "说起来，如果一次把饵全部洒进去，让鱼吃到翻肚皮，自动漂上来，是不是也算一种「钓鱼」呢？"
                },
                {
                    "id": "750150403",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "啊…啊呜…"
                },
                {
                    "id": "750150404",
                    "speaker": "派蒙",
                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}也觉得这样可以吗？看你的眼神很期待呢！嘿嘿，下次我们一起试试呀…"
                },
                {
                    "id": "750150405",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "啊呜…"
                },
                {
                    "id": "750150406",
                    "speaker": "派蒙",
                    "text": "#哇！还没有烤呢，得等{NICKNAME}做好才能吃啦！"
                },
                {
                    "id": "750150407",
                    "speaker": "Black Screen",
                    "text": "做完了烤鱼，大家一起饱餐了一顿。"
                },
                {
                    "id": "750150408",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750150409",
                    "speaker": "派蒙",
                    "text": "总觉得这顿烤鱼格外的香呢，不愧是我钓起来的鱼！"
                },
                {
                    "id": "750150410",
                    "speaker": "Player",
                    "text": "不愧是派蒙，以后都交给你了！"
                },
                {
                    "id": "750150411",
                    "speaker": "派蒙",
                    "text": "哎…"
                },
                {
                    "id": "750150412",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750150413",
                    "speaker": "派蒙",
                    "text": "#别想着不劳而获，如果要吃到鱼，那{REALNAME[ID(2)|SHOWHOST(true)]}你下次也得帮忙才行！"
                },
                {
                    "id": "750150414",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔嗯？"
                },
                {
                    "id": "750150415",
                    "speaker": "派蒙",
                    "text": "这种时候就开始装傻了，你这家伙！"
                }
            ]
        }
    ]
}