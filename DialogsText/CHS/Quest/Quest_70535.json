    "talks": [
        {
            "id": "7053502",
            "objective": "前往骑士团的图书馆",
            "dialogues": [
                {
                    "id": "705350201",
                    "speaker": "可莉",
                    "text": "嗯嗯！可莉知道了！"
                },
                {
                    "id": "705350202",
                    "speaker": "可莉",
                    "text": "但是…鱼还是刚刚炸上来的最新鲜嘛，放火上烤一烤，又脆又香又好吃！"
                },
                {
                    "id": "705350203",
                    "speaker": "丽莎",
                    "text": "不用担心，小可莉，琴早就和我叮嘱过了。"
                },
                {
                    "id": "705350204",
                    "speaker": "丽莎",
                    "text": "我已经向「猎鹿人」下单了，这几天，大厨会挑选刚从湖里钓上来的好鱼，快快入锅烹饪。"
                },
                {
                    "id": "705350205",
                    "speaker": "丽莎",
                    "text": "配上可莉最喜欢的调味粉和酱料，还有我准备的特制茶点，肯定和你炸鱼时的收获一样美味~"
                },
                {
                    "id": "705350206",
                    "speaker": "可莉",
                    "text": "好！那就听丽莎阿…丽莎姐姐的！"
                },
                {
                    "id": "705350207",
                    "speaker": "可莉",
                    "text": "这几天，可莉一定专心在城里玩「嘟嘟可轰轰奇遇记」，不去炸鱼，不给阿贝多哥哥的朋友添麻烦！"
                },
                {
                    "id": "705350208",
                    "speaker": "可莉",
                    "text": "#那可莉出发去找荣誉骑士{M#哥哥}{F#姐姐}和小派蒙了！"
                },
                {
                    "id": "705350209",
                    "speaker": "派蒙",
                    "text": "嘿嘿，谁要找我们呀？",
                    "choices": [
                        {
                            "id": "705350210",
                            "text": "难得看见你们两个待在一起。",
                            "response": [
                                {
                                    "id": "705350212",
                                    "speaker": "可莉",
                                    "text": "#荣誉骑士{M#哥哥}{F#姐姐}！还有小派蒙！"
                                },
                                {
                                    "id": "705350213",
                                    "speaker": "可莉",
                                    "text": "可莉刚刚在想你们，你们就出现了，是有什么魔法帮可莉把消息传给了你们吗？"
                                },
                                {
                                    "id": "705350214",
                                    "speaker": "丽莎",
                                    "text": "啊呀？小可爱和派蒙，你们来得可真是时候，都不用辛苦我写信了。",
                                    "choices": [
                                        {
                                            "id": "705350215",
                                            "text": "是可莉的心意召来了我们！",
                                            "response": [
                                                {
                                                    "id": "705350217",
                                                    "speaker": "派蒙",
                                                    "text": "我们俩比较闲，原本想来图书馆找书看…但「嘟嘟可轰轰奇遇记」是怎么回事？听着比普通的书有趣多了！"
                                                },
                                                {
                                                    "id": "705350218",
                                                    "speaker": "可莉",
                                                    "text": "是丽莎姐姐给我做的新游戏哦，名字是我们一起想的。小派蒙一下子就记住了，好聪明！"
                                                },
                                                {
                                                    "id": "705350219",
                                                    "speaker": "派蒙",
                                                    "text": "原来丽莎还会设计游戏啊！我还以为丽莎的博学…是书看得多的那种！"
                                                },
                                                {
                                                    "id": "705350220",
                                                    "speaker": "丽莎",
                                                    "text": "呵呵，我只是参考了学生时期用来消遣的一款游戏「滚滚炸炸菇」，改进了它的设计，没有花费多少心力…"
                                                },
                                                {
                                                    "id": "705350221",
                                                    "speaker": "丽莎",
                                                    "text": "只要能让小可莉开开心心地度过这段「特殊时期」，要我再多设计几种也没问题。"
                                                },
                                                {
                                                    "id": "705350222",
                                                    "speaker": "Player",
                                                    "text": "「特殊时期」？"
                                                },
                                                {
                                                    "id": "705350223",
                                                    "speaker": "派蒙",
                                                    "text": "对哦，我想起来了。刚刚你们好像还提到了阿贝多的朋友？最近蒙德发生了什么事吗？"
                                                },
                                                {
                                                    "id": "705350224",
                                                    "speaker": "丽莎",
                                                    "text": "这次的意外嘛，说来不大不小，但确实要谨慎处理——"
                                                },
                                                {
                                                    "id": "705350225",
                                                    "speaker": "丽莎",
                                                    "text": "近期，果酒湖里出现了来自须弥的鱼类，放任它们肆意繁殖的话，有可能威胁到蒙德水域的生态。"
                                                },
                                                {
                                                    "id": "705350226",
                                                    "speaker": "丽莎",
                                                    "text": "还好小可莉悄悄溜出去玩的时候，发现了没见过的鱼，嗯…抓了两条上来，问了问凯亚。"
                                                },
                                                {
                                                    "id": "705350227",
                                                    "speaker": "丽莎",
                                                    "text": "不然，等到一般人发现它们的时候，说不定湖里的原住民已经被赶到不起眼的角落里去了。"
                                                },
                                                {
                                                    "id": "705350228",
                                                    "speaker": "丽莎",
                                                    "text": "假如水下的生物群体发生了变化，影响到果酒湖的水质，进而影响酒业…这就是关乎蒙德经济的大问题了。"
                                                },
                                                {
                                                    "id": "705350229",
                                                    "speaker": "可莉",
                                                    "text": "嘿嘿，这一次可莉有功！琴团长知道了以后，还特别表扬了可莉哦！",
                                                    "choices": [
                                                        {
                                                            "id": "705350230",
                                                            "text": "可莉立大功！",
                                                            "response": [
                                                                {
                                                                    "id": "705350232",
                                                                    "speaker": "派蒙",
                                                                    "text": "居然还有这种事？真是好险！"
                                                                },
                                                                {
                                                                    "id": "705350233",
                                                                    "speaker": "丽莎",
                                                                    "text": "目前，调查小队派出了一些队员，正对果酒湖进行勘测，找出这些鱼类「入侵者」的老巢。"
                                                                },
                                                                {
                                                                    "id": "705350234",
                                                                    "speaker": "丽莎",
                                                                    "text": "这段时间，为防惊扰「入侵者」，可莉就不能带着她的「宝物」到处跑了。"
                                                                },
                                                                {
                                                                    "id": "705350235",
                                                                    "speaker": "丽莎",
                                                                    "text": "调查小队使用的仪器非常灵敏，湖边一定距离内的爆炸也会对勘测造成影响。"
                                                                },
                                                                {
                                                                    "id": "705350236",
                                                                    "speaker": "丽莎",
                                                                    "text": "琴说，一直让小可莉闷在城里，她肯定会觉得无聊。"
                                                                },
                                                                {
                                                                    "id": "705350237",
                                                                    "speaker": "丽莎",
                                                                    "text": "阿贝多正忙着改进游击小队的实验型装备，凯亚刚好也去出差了，照看她的任务，就落在了姐姐我的肩上…"
                                                                },
                                                                {
                                                                    "id": "705350238",
                                                                    "speaker": "可莉",
                                                                    "text": "#现在不无聊啦！丽莎姐姐发明了「嘟嘟可轰轰奇遇记」，可莉很期待！想跟荣誉骑士{M#哥哥}{F#姐姐}和小派蒙一起玩！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705350239",
                                                                            "text": "一起玩吧！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705350241",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "嗯，「嘟嘟可轰轰奇遇记」的游戏桌就放在花园那边，我在「猎鹿人」下的订单，也会送到那里。"
                                                                                },
                                                                                {
                                                                                    "id": "705350242",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "一边享受美食、花香和清风，一边和小可莉玩游戏，这么难得的机会，可要好好享受一番哦~"
                                                                                },
                                                                                {
                                                                                    "id": "705350243",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "咦，丽莎这话的意思…是不和我们一起去吗？"
                                                                                },
                                                                                {
                                                                                    "id": "705350244",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "作为游戏的设计者，我参与的话未免有点犯规啦，会影响到你们游玩时的惊喜哦…"
                                                                                },
                                                                                {
                                                                                    "id": "705350245",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "而且，我这个图书管理员还是要待在岗位上，尽到我最基本的职责嘛。"
                                                                                },
                                                                                {
                                                                                    "id": "705350246",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "听着像是你又在找理由不出门…"
                                                                                },
                                                                                {
                                                                                    "id": "705350247",
                                                                                    "speaker": "丽莎",
                                                                                    "text": "乖，你们安心陪着小可莉去玩就好~",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705350248",
                                                                                            "text": "好耶，丽莎姐姐放心！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705350250",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "好吧，那我们回头再见哦，丽莎！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705350249",
                                                                                            "text": "呜呜，辛苦丽莎姐姐！"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705350240",
                                                                            "text": "玩到天黑！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705350231",
                                                            "text": "琴团长夸夸！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705350216",
                                            "text": "是巧合的魔法找来了我们！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705350211",
                            "text": "好像达成了什么重要的约定？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7053503",
            "objective": "前往花园",
            "dialogues": [
                {
                    "id": "705350301",
                    "speaker": "可莉",
                    "text": "#就是这里了，荣誉骑士{M#哥哥}{F#姐姐}，这就是「嘟嘟可轰轰奇遇记」的游戏桌！"
                },
                {
                    "id": "705350302",
                    "speaker": "派蒙",
                    "text": "嗯！这里的环境确实很好，游玩的体验肯定很不错，丽莎选起地方来真是没得挑呢！"
                },
                {
                    "id": "705350303",
                    "speaker": "派蒙",
                    "text": "那就拜托小可莉教我们基本的玩法了！",
                    "choices": [
                        {
                            "id": "705350304",
                            "text": "嘟嘟奇遇！",
                            "response": [
                                {
                                    "id": "705350306",
                                    "speaker": "可莉",
                                    "text": "嘿嘿，那我们就开始吧！"
                                }
                            ]
                        },
                        {
                            "id": "705350305",
                            "text": "轰轰开玩！"
                        }
                    ]
                }
            ]
        }
    ]
}