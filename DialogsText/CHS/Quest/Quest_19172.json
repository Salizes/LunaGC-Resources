            "id": "1917208",
            "objective": "前往发布会现场",
            "dialogues": [
                {
                    "id": "191720801",
                    "speaker": "阿尼斯",
                    "text": "马姆杜，我推荐的那位前辈已经来了！"
                },
                {
                    "id": "191720802",
                    "speaker": "马姆杜",
                    "text": "哦？您就是珐露珊…前辈？"
                },
                {
                    "id": "191720803",
                    "speaker": "珐露珊",
                    "text": "嗯，没错，就是我。"
                }
            ]
        },
        {
            "id": "1917203",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191720398",
                    "speaker": "Player",
                    "text": "尽可能简单有趣一些？"
                },
                {
                    "id": "191720399",
                    "speaker": "Player",
                    "text": "尽可能详实准确一些？"
                }
            ]
        },
        {
            "id": "1917251",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191725101",
                    "speaker": "娜德瓦",
                    "text": "总算能给上头一个交代了，真是多谢你们了。"
                },
                {
                    "id": "191725102",
                    "speaker": "娜德瓦",
                    "text": "要不然，还真不知道要怎么说动这位老前辈…"
                }
            ]
        },
        {
            "id": "1917252",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191725201",
                    "speaker": "阿尼斯",
                    "text": "珐露珊前辈，居然真的愿意指导我了？真是太荣幸了！"
                },
                {
                    "id": "191725202",
                    "speaker": "阿尼斯",
                    "text": "啊，不过她肯定会说，「协助绘制不算指导」…你可不要随便跟她说啊。"
                }
            ]
        },
        {
            "id": "1917253",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191725301",
                    "speaker": "马姆杜",
                    "text": "不愧是教令院的老前辈，刚见面的时候，我还在想她看着这么年轻，会不会不太靠谱…"
                },
                {
                    "id": "191725302",
                    "speaker": "马姆杜",
                    "text": "啊，这话可不能让她听见，阿尼斯她嘱咐过我的…"
                }
            ]
        },
        {
            "id": "1917254",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191725401",
                    "speaker": "卡西特",
                    "text": "要等整整两天才能见到新玩具啊…"
                },
                {
                    "id": "191725402",
                    "speaker": "鲁希",
                    "text": "说不定还只是图册呢，想玩到成品，又得等好长一段时间。"
                },
                {
                    "id": "191725403",
                    "speaker": "阿利娅",
                    "text": "这段时间里，只能先玩玩《七圣召唤》解闷了吧…"
                }
            ]
        },
        {
            "id": "1917255",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191725501",
                    "speaker": "提纳里",
                    "text": "#{NICKNAME}，你已经见过珐露珊前辈了吗？",
                    "choices": [
                        {
                            "id": "191725502",
                            "text": "是，她还有点事…",
                            "response": [
                                {
                                    "id": "191725504",
                                    "speaker": "提纳里",
                                    "text": "没事的，柯莱已经和我说了事情的大致经过。"
                                },
                                {
                                    "id": "191725505",
                                    "speaker": "提纳里",
                                    "text": "我这边的问题…现在也算是想办法缓解了一些，应该可以等到前辈事了。"
                                },
                                {
                                    "id": "191725506",
                                    "speaker": "提纳里",
                                    "text": "能麻烦你两天之后，再去看看前辈的情况吗？"
                                }
                            ]
                        },
                        {
                            "id": "191725503",
                            "text": "大概还需要两天…"
                        }
                    ]
                }
            ]
        }
    ]
