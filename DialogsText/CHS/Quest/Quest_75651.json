    "talks": [
        {
            "id": "7565101",
            "objective": "和派蒙一起走走",
            "dialogues": [
                {
                    "id": "756510101",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}最近做委托很辛苦吧，我都看在眼里了。"
                },
                {
                    "id": "756510102",
                    "speaker": "派蒙",
                    "text": "作为一个贴心称职的向导，我有责任帮你放松一下，当当——快看这是什么地方！",
                    "choices": [
                        {
                            "id": "756510103",
                            "text": "招牌上写着呢，达莫维百货。",
                            "response": [
                                {
                                    "id": "756510104",
                                    "speaker": "布希柯",
                                    "text": "你们好，欢迎来到达莫维百货。"
                                },
                                {
                                    "id": "756510107",
                                    "speaker": "派蒙",
                                    "text": "这可不是一家普通的商店，这里是辛苦的劳动者通过消费获得精神放松的好地方。"
                                },
                                {
                                    "id": "756510108",
                                    "speaker": "布希柯",
                                    "text": "说的没错，我们最近还推出了买一送一促销活动！欢迎所有顾客参加！"
                                },
                                {
                                    "id": "756510109",
                                    "speaker": "布希柯",
                                    "text": "买了我吃亏，不买你吃亏！"
                                },
                                {
                                    "id": "756510110",
                                    "speaker": "派蒙",
                                    "text": "之前路过的时候，看到达莫维百货的活动海报，我就记住了。"
                                },
                                {
                                    "id": "756510111",
                                    "speaker": "派蒙",
                                    "text": "花一份钱，能买两份货，怎么看怎么划算。"
                                },
                                {
                                    "id": "756510112",
                                    "speaker": "派蒙",
                                    "text": "#总有种不在这里消费，我的人生就有点缺憾的感觉…我今天就要带上{NICKNAME}一起弥补这份缺憾。",
                                    "choices": [
                                        {
                                            "id": "756510113",
                                            "text": "派蒙想买什么？",
                                            "response": [
                                                {
                                                    "id": "756510115",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，这个先不告诉你。"
                                                },
                                                {
                                                    "id": "756510116",
                                                    "speaker": "Player",
                                                    "text": "那我可不付钱。"
                                                },
                                                {
                                                    "id": "756510117",
                                                    "speaker": "派蒙",
                                                    "text": "哼哼，今天不需要你来付，我自己带钱来了。"
                                                },
                                                {
                                                    "id": "756510118",
                                                    "speaker": "派蒙",
                                                    "text": "#老板，预订商品到货了吗？预订人的姓名是派蒙和{NICKNAME}。"
                                                },
                                                {
                                                    "id": "756510119",
                                                    "speaker": "布希柯",
                                                    "text": "有的，稍等。"
                                                },
                                                {
                                                    "id": "756510120",
                                                    "speaker": "Black Screen",
                                                    "text": "店主布希柯取出了一件被过度包装得看不出是什么的商品，在一旁的派蒙掏出了一大堆零钱。眼看这一大堆零钱就这么离开了自己，派蒙的脸上流露出一丝不舍。"
                                                },
                                                {
                                                    "id": "756510121",
                                                    "speaker": "Black Screen",
                                                    "text": "和派蒙一起拆开厚厚的包装后，你意识到这是两本留影册。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756510114",
                                            "text": "派蒙想怎么弥补缺憾？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756510105",
                            "text": "摩拉小偷的住所，钱包坟场。",
                            "response": [
                                {
                                    "id": "756510106",
                                    "speaker": "布希柯",
                                    "text": "顾客，这么说就不妥了。达莫维百货主打的一直是价廉物美，你们可以看看价格嘛。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}