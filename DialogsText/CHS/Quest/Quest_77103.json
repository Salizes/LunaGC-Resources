    "talks": [
        {
            "id": "7710301",
            "objective": "(test)与派蒙对话",
            "dialogues": [
                {
                    "id": "771030101",
                    "speaker": "「灰眸」",
                    "text": "…检测到，周围的能量反应…"
                },
                {
                    "id": "771030102",
                    "speaker": "派蒙",
                    "text": "#呃…这、这是哪儿？{NICKNAME}，你还好吗！"
                },
                {
                    "id": "771030103",
                    "speaker": "Player",
                    "text": "放心，我还好。"
                },
                {
                    "id": "771030104",
                    "speaker": "派蒙",
                    "text": "刚刚那个可怕的大鸟不会就是娜斯佳说的扎拉吧…一言不合就开打，它怎么这样！"
                },
                {
                    "id": "771030105",
                    "speaker": "派蒙",
                    "text": "可恶啊，我还期待了好久，没想到娜斯佳竟然骗我们。",
                    "choices": [
                        {
                            "id": "771030106",
                            "text": "也许娜斯佳并没有骗我们…",
                            "response": [
                                {
                                    "id": "771030107",
                                    "speaker": "派蒙",
                                    "text": "你的意思是说…扎拉只对我们这样？不会就因为我们没有像娜斯佳一样长出树枝吧…"
                                },
                                {
                                    "id": "771030110",
                                    "speaker": "「灰眸」",
                                    "text": "但对于将「维持此处的力量」作为守护对象的那只合成魔兽来说，我们的接近是一种危险。"
                                },
                                {
                                    "id": "771030111",
                                    "speaker": "派蒙",
                                    "text": "咦，这是为什么…我们来这里只是为了拿回「眼镜」身躯的部分…"
                                },
                                {
                                    "id": "771030112",
                                    "speaker": "派蒙",
                                    "text": "啊！我懂了，所以让这个镇子变得这么温暖，还变得那么奇怪的原因其实就是「眼镜」的力量？"
                                },
                                {
                                    "id": "771030113",
                                    "speaker": "「灰眸」",
                                    "text": "是的，您得出了正确的结论。"
                                },
                                {
                                    "id": "771030114",
                                    "speaker": "「灰眸」",
                                    "text": "…不管是那只半人半鸟的合成魔物「扎拉」…还是此地的居民身躯与意志被转变的方式，都让我…感到十分熟悉。"
                                },
                                {
                                    "id": "771030115",
                                    "speaker": "「灰眸」",
                                    "text": "我能想起…我在某个实验的密所被制造而出，打造出我身躯的四位大人之一，是至冬现在已然隐没的生物炼金学派的翘楚。"
                                },
                                {
                                    "id": "771030116",
                                    "speaker": "「灰眸」",
                                    "text": "…「不死魔」卡谢伊。"
                                },
                                {
                                    "id": "771030117",
                                    "speaker": "「灰眸」",
                                    "text": "很像是他处理「生命」的方式。"
                                },
                                {
                                    "id": "771030118",
                                    "speaker": "派蒙",
                                    "text": "唔，所以我们要的东西，就在那个叫「卡谢伊」的人手里？"
                                },
                                {
                                    "id": "771030119",
                                    "speaker": "派蒙",
                                    "text": "嘶，总感觉镇子变得更加奇怪了…"
                                },
                                {
                                    "id": "771030120",
                                    "speaker": "派蒙",
                                    "text": "总之，我们要先把娜斯佳送回家，然后去找那个叫「卡谢伊」的人咯？"
                                },
                                {
                                    "id": "771030121",
                                    "speaker": "派蒙",
                                    "text": "要做的事好多呢。"
                                },
                                {
                                    "id": "771030122",
                                    "speaker": "Player",
                                    "text": "先想办法回到地面吧。"
                                },
                                {
                                    "id": "771030123",
                                    "speaker": "派蒙",
                                    "text": "是哦，呆在这里肯定什么东西都找不到…我们还是快点从这个破破烂烂的地方出去！"
                                },
                                {
                                    "id": "771030124",
                                    "speaker": "派蒙",
                                    "text": "等找到娜斯佳，再好好问问她吧！"
                                }
                            ]
                        },
                        {
                            "id": "771030108",
                            "text": "我们应该被定义成了「坏虫」。",
                            "response": [
                                {
                                    "id": "771030109",
                                    "speaker": "派蒙",
                                    "text": "可我们明明没做坏事，甚至还做了好事——我们在送娜斯佳回家呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
