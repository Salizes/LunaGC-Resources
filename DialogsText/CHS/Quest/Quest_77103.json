        {
            "id": "7710307",
            "objective": "调查下水道的控制室",
            "dialogues": [
                {
                    "id": "771580401",
                    "speaker": "操作指南·其一",
                    "text": "…须获得三重许可…取<color=#00E1FFFF>金、银、铁所制成【钥匙】</color>…分别置于三处…需插入凹槽内…"
                },
                {
                    "id": "771580402",
                    "speaker": "派蒙",
                    "text": "找到了！这个破破的封面上好像还写着名字…「莫罗医生」？呃啊，那个好心医生的手记？"
                },
                {
                    "id": "771580403",
                    "speaker": "派蒙",
                    "text": "不管了，所以只要去三个地方找到<color=#00E1FFFF>金、银、铁三种【钥匙】</color>…"
                },
                {
                    "id": "771580404",
                    "speaker": "派蒙",
                    "text": "…再插到这三个凹槽里，应该就可以出去了吧！"
                }
            ]
        },
