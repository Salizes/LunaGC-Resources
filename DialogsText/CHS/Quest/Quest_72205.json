    "talks": [
        {
            "id": "7220501",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050101",
                    "speaker": "木户",
                    "text": "唔，奇怪呀…明明就在口袋里的…",
                    "choices": [
                        {
                            "id": "722050102",
                            "text": "你好。",
                            "response": [
                                {
                                    "id": "722050104",
                                    "speaker": "木奈",
                                    "text": "没有的话可不行呀…是要带给宇奈婆婆的哟…"
                                },
                                {
                                    "id": "722050105",
                                    "speaker": "木户",
                                    "text": "宇奈婆婆岁数大了，好多事情都记不清了…最近又开始念叨起了年轻时的事情。"
                                },
                                {
                                    "id": "722050106",
                                    "speaker": "木奈",
                                    "text": "她呀，总是在说着「花」呀「花」的…还说，那是雾海外的花，颜色不同的好看的花…"
                                },
                                {
                                    "id": "722050107",
                                    "speaker": "木户",
                                    "text": "然后有一天，我做了一个梦…我梦见岛上的雾「哇」地一下全都消散了，海的另一边立起了高高大大好漂亮的屋子…不是木头的，也不是金子的…"
                                },
                                {
                                    "id": "722050108",
                                    "speaker": "木奈",
                                    "text": "我也是呢，我也是呢！"
                                },
                                {
                                    "id": "722050109",
                                    "speaker": "木户",
                                    "text": "在那个梦里面呀，我登上高高的山，爬上大大的树，摘了好多好多好看的花…虽然没有见过，但我知道那就是宇奈婆婆想要的花…"
                                },
                                {
                                    "id": "722050110",
                                    "speaker": "木户",
                                    "text": "可是花太多太重，我就从树上掉了下来，一直掉呀，一直掉呀…然后，梦就醒了。"
                                },
                                {
                                    "id": "722050111",
                                    "speaker": "木奈",
                                    "text": "哼，还不是因为你太贪心！我都说了好多遍足够啦、足够啦！结果连累我也一同掉了下去…"
                                },
                                {
                                    "id": "722050112",
                                    "speaker": "木户",
                                    "text": "口袋里空空的…什么都没有了…就这样怎么回去见宇奈婆婆呀…"
                                }
                            ]
                        },
                        {
                            "id": "722050103",
                            "text": "需要帮忙吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220502",
            "objective": "跟孙女对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722050201",
                    "speaker": "木户",
                    "text": "怎么办才好…"
                },
                {
                    "id": "722050202",
                    "speaker": "木奈",
                    "text": "想想办法呀…"
                }
            ]
        },
        {
            "id": "7220503",
            "objective": "跟孙女对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722051301",
                    "speaker": "木户",
                    "text": "就是这些花！和我梦里一模一样呢！"
                },
                {
                    "id": "722051302",
                    "speaker": "木奈",
                    "text": "#谢谢你，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！"
                },
                {
                    "id": "722051303",
                    "speaker": "木奈",
                    "text": "木户哥哥，等看完宇奈奶奶，我们去东边的海滩玩吧！在那边能看见青来神祠呢！"
                },
                {
                    "id": "722051304",
                    "speaker": "木户",
                    "text": "是「千来神祠」啦…"
                }
            ]
        },
        {
            "id": "7220512",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050301",
                    "speaker": "木户",
                    "text": "#你好，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}!",
                    "choices": [
                        {
                            "id": "722050302",
                            "text": "你好呀。",
                            "response": [
                                {
                                    "id": "722050304",
                                    "speaker": "木户",
                                    "text": "谢谢你上次帮我采来那些花朵！只不过呀…我感觉身边一直怪怪的…"
                                },
                                {
                                    "id": "722050305",
                                    "speaker": "木奈",
                                    "text": "我也是呢，一直都怪怪的…"
                                },
                                {
                                    "id": "722050306",
                                    "speaker": "木户",
                                    "text": "每次去到不同的地方，都只会遇到不开心的人…大家都听不到别人说话的样子…"
                                },
                                {
                                    "id": "722050307",
                                    "speaker": "木奈",
                                    "text": "而且呀，每次看到漂亮的花朵，摘下放进口袋里之后，就很快不见了…",
                                    "choices": [
                                        {
                                            "id": "722050308",
                                            "text": "那是因为…",
                                            "response": [
                                                {
                                                    "id": "722050310",
                                                    "speaker": "木户",
                                                    "text": "这样吗…我不太明白呢。"
                                                },
                                                {
                                                    "id": "722050311",
                                                    "speaker": "木奈",
                                                    "text": "要离开了吗…？"
                                                },
                                                {
                                                    "id": "722050312",
                                                    "speaker": "木户",
                                                    "text": "那个金色的叔叔也说了类似的话…但是我们还不能跟他走。"
                                                },
                                                {
                                                    "id": "722050313",
                                                    "speaker": "木奈",
                                                    "text": "我们还要给宇奈婆婆带去好看的花呢！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722050309",
                                            "text": "是时候离开了吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722050303",
                            "text": "精神不错嘛。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220504",
            "objective": "跟孙女对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722050401",
                    "speaker": "木户",
                    "text": "我还不能离开哦。"
                },
                {
                    "id": "722050402",
                    "speaker": "木奈",
                    "text": "木户哥哥要留下的话，我也不想离开呢。"
                }
            ]
        },
        {
            "id": "7220505",
            "objective": "跟孙女对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722051501",
                    "speaker": "木户",
                    "text": "谢谢你！我们这就把花带去给宇奈婆婆！"
                },
                {
                    "id": "722051502",
                    "speaker": "木奈",
                    "text": "木户哥哥也分我一半啦！"
                },
                {
                    "id": "722051503",
                    "speaker": "木户",
                    "text": "我们去山的另一边吧！西南边的逢岳之野…我知道那里有个好玩的地方！"
                },
                {
                    "id": "722051504",
                    "speaker": "木奈",
                    "text": "会惹知世大人生气吧…不过我也要去！"
                }
            ]
        },
        {
            "id": "7220513",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050501",
                    "speaker": "木户",
                    "text": "在这里又见面了！"
                },
                {
                    "id": "722050502",
                    "speaker": "木奈",
                    "text": "又见面啦！",
                    "choices": [
                        {
                            "id": "722050503",
                            "text": "你好！",
                            "response": [
                                {
                                    "id": "722050505",
                                    "speaker": "木户",
                                    "text": "#嘿嘿，我还在这里呢！说起来，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}知道这些大石头是做什么的吗？"
                                },
                                {
                                    "id": "722050506",
                                    "speaker": "木奈",
                                    "text": "哼哼，木户哥哥什么都知道哦！",
                                    "choices": [
                                        {
                                            "id": "722050507",
                                            "text": "不知道呢。",
                                            "response": [
                                                {
                                                    "id": "722050509",
                                                    "speaker": "木户",
                                                    "text": "听又爷爷讲，这是用来招引亡灵的墓碑呢…那些死后迷失的、伫留的灵总会被这些大石头吸引，在这里从梦中醒来。"
                                                },
                                                {
                                                    "id": "722050510",
                                                    "speaker": "木户",
                                                    "text": "然后在岛上各处徘徊…寻找能够满足他们心愿的人。一旦找到，他就会缠上那人…直到自己的愿望被满足，被那撑船的人接走为止…"
                                                },
                                                {
                                                    "id": "722050511",
                                                    "speaker": "木户",
                                                    "text": "他们有的是好的灵，有的是坏的…所以呀，在雾中走夜路的人，一定要在这种大石头前，大声报出自己的氏名！"
                                                },
                                                {
                                                    "id": "722050512",
                                                    "speaker": "木户",
                                                    "text": "牢记祖先的人，总是比孤魂野鬼更有底气。而那些死去的灵得知了生人的血脉，便会自惭形秽地离去，不再要求什么啦。"
                                                },
                                                {
                                                    "id": "722050513",
                                                    "speaker": "木户",
                                                    "text": "#只可惜大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}是外人呢…没有响当当的氏名可报…"
                                                },
                                                {
                                                    "id": "722050514",
                                                    "speaker": "木奈",
                                                    "text": "#唔…要是坏的灵来了，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}要怎么办呢…"
                                                },
                                                {
                                                    "id": "722050515",
                                                    "speaker": "木户",
                                                    "text": "嘿嘿，没关系的。不用怕啦，我可以保护你呀！"
                                                },
                                                {
                                                    "id": "722050516",
                                                    "speaker": "木奈",
                                                    "text": "木奈也要一起，吓走坏蛋灵！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722050508",
                                            "text": "是做什么的？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722050504",
                            "text": "你还在岛上呀。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220506",
            "objective": "跟孙女对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722050601",
                    "speaker": "木户",
                    "text": "在别的岛上，也有荧光色的大蘑菇吗？"
                },
                {
                    "id": "722050602",
                    "speaker": "木奈",
                    "text": "一定没有我们家种的蘑菇好看！"
                }
            ]
        },
        {
            "id": "7220507",
            "objective": "跟孙女对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722051701",
                    "speaker": "木户",
                    "text": "原来你还记得！谢谢你！"
                },
                {
                    "id": "722051702",
                    "speaker": "木奈",
                    "text": "谢谢你！"
                },
                {
                    "id": "722051703",
                    "speaker": "木奈",
                    "text": "我们要去南边的河里摸贝壳啦！再见！"
                },
                {
                    "id": "722051704",
                    "speaker": "木户",
                    "text": "木奈不要下河哦！很危险的！"
                }
            ]
        },
        {
            "id": "7220514",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050701",
                    "speaker": "木户",
                    "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，又见面了。"
                },
                {
                    "id": "722050702",
                    "speaker": "木奈",
                    "text": "木户哥哥今天不想说话呢…",
                    "choices": [
                        {
                            "id": "722050703",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "722050705",
                                    "speaker": "木户",
                                    "text": "没事啦…我自己玩就好，不要理我了。"
                                },
                                {
                                    "id": "722050706",
                                    "speaker": "木奈",
                                    "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}你看，他又这样了…自己一个人生气。",
                                    "choices": [
                                        {
                                            "id": "722050707",
                                            "text": "发生什么事了？",
                                            "response": [
                                                {
                                                    "id": "722050709",
                                                    "speaker": "木奈",
                                                    "text": "木户哥哥，不要和外人生气嘛…"
                                                },
                                                {
                                                    "id": "722050710",
                                                    "speaker": "木户",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "722050711",
                                                    "speaker": "木户",
                                                    "text": "…对不起，我不该和你生气的。",
                                                    "choices": [
                                                        {
                                                            "id": "722050712",
                                                            "text": "没关系的。",
                                                            "response": [
                                                                {
                                                                    "id": "722050714",
                                                                    "speaker": "木户",
                                                                    "text": "金色的叔叔又在催我们登船了…还说要去没有雾的金闪闪屋子。我才不要去，我还要陪宇奈婆婆呢！"
                                                                },
                                                                {
                                                                    "id": "722050715",
                                                                    "speaker": "木奈",
                                                                    "text": "也不和我们玩，也不会说有意思的话，只是一个劲催我们走…让人毛毛的…"
                                                                },
                                                                {
                                                                    "id": "722050716",
                                                                    "speaker": "木户",
                                                                    "text": "再说我们又不是不会走…只是怕宇奈婆婆会担心而已…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722050713",
                                                            "text": "请告诉我发生了什么。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722050708",
                                            "text": "我可以帮得上忙吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722050704",
                            "text": "你看起来不太高兴？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220508",
            "objective": "跟孙女对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722050801",
                    "speaker": "木户",
                    "text": "我没关系的啦，自己玩也没问题的。"
                },
                {
                    "id": "722050802",
                    "speaker": "木奈",
                    "text": "嘿嘿，还有我呢！"
                }
            ]
        },
        {
            "id": "7220509",
            "objective": "跟孙女对话（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722051901",
                    "speaker": "木户",
                    "text": "#谢谢你！辛苦大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}了！"
                },
                {
                    "id": "722051902",
                    "speaker": "木奈",
                    "text": "辛苦你啦！"
                },
                {
                    "id": "722051903",
                    "speaker": "木奈",
                    "text": "木户哥哥，我知道一个冒险的好地方哦！就在尖命山北边的山窝窝里，很隐秘的！"
                },
                {
                    "id": "722051904",
                    "speaker": "木户",
                    "text": "是「菅名山」啦…"
                }
            ]
        },
        {
            "id": "7220515",
            "objective": "",
            "dialogues": [
                {
                    "id": "722050901",
                    "speaker": "木户",
                    "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！你好呀！"
                },
                {
                    "id": "722050902",
                    "speaker": "木奈",
                    "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你好！",
                    "choices": [
                        {
                            "id": "722050903",
                            "text": "你好呀，木户、木奈！",
                            "response": [
                                {
                                    "id": "722050905",
                                    "speaker": "木户",
                                    "text": "谢谢你，但这次我不需要什么啦…我们就要离开这里了，去没有迷雾的地方。"
                                },
                                {
                                    "id": "722050906",
                                    "speaker": "木奈",
                                    "text": "去金闪闪的大屋子！坐船去哦！"
                                },
                                {
                                    "id": "722050907",
                                    "speaker": "木户",
                                    "text": "不过在走之前，还是要谢谢你…顺便，请把这个交给宇奈婆婆吧。"
                                },
                                {
                                    "id": "722050908",
                                    "speaker": "木奈",
                                    "text": "把这个放在她手里，她就会放心随我们一起来的！"
                                },
                                {
                                    "id": "722050909",
                                    "speaker": "木户",
                                    "text": "#最后一次拜托你了，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}。"
                                },
                                {
                                    "id": "722050910",
                                    "speaker": "木奈",
                                    "text": "#谢谢你，大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}。"
                                }
                            ]
                        },
                        {
                            "id": "722050904",
                            "text": "还需要绯樱绣球吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220510",
            "objective": "test 废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7220511",
            "objective": "test 废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7220512",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722051201",
                    "speaker": "木户",
                    "text": "#大{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！你又来啦？"
                },
                {
                    "id": "722051202",
                    "speaker": "Player",
                    "text": "这些花足够吗？"
                }
            ]
        },
        {
            "id": "7220514",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722051401",
                    "speaker": "木户",
                    "text": "还不能离开呢…"
                },
                {
                    "id": "722051402",
                    "speaker": "Player",
                    "text": "你要的是这些花吗？"
                }
            ]
        },
        {
            "id": "7220516",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722051601",
                    "speaker": "木户",
                    "text": "河的另一边呀…是金的橡树、金的…什么来着…"
                },
                {
                    "id": "722051602",
                    "speaker": "木奈",
                    "text": "金的…鱼儿？因为鱼很好吃…"
                },
                {
                    "id": "722051603",
                    "speaker": "Player",
                    "text": "我带来了你想要的花。"
                }
            ]
        },
        {
            "id": "7220518",
            "objective": "Additional",
            "dialogues": [
                {
