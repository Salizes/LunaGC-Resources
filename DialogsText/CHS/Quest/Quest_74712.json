    "talks": [
        {
            "id": "7471201",
            "objective": "与希格雯对话",
            "dialogues": [
                {
                    "id": "747120101",
                    "speaker": "希格雯",
                    "text": "#和你们分享最好的消息，{NICKNAME}和派蒙——问题都搞定了哦。"
                },
                {
                    "id": "747120102",
                    "speaker": "希格雯",
                    "text": "暴躁鱼儿救助行动，大获成功~"
                },
                {
                    "id": "747120103",
                    "speaker": "希格雯",
                    "text": "等到潜水员那边搞定了所有水下杂物，这些病患鱼儿再平静一些，就能让鱼儿们回到原本的环境去了。"
                },
                {
                    "id": "747120104",
                    "speaker": "Player",
                    "text": "真是辛苦大家了。"
                },
                {
                    "id": "747120105",
                    "speaker": "派蒙",
                    "text": "嘿嘿，是我们和希格雯一起努力的成果。"
                },
                {
                    "id": "747120106",
                    "speaker": "希格雯",
                    "text": "我把这次的事件写成了报告，交给了沫芒宫。应该很快就会有专员拟定相关的规则，通知对应机构…"
                },
                {
                    "id": "747120107",
                    "speaker": "希格雯",
                    "text": "另外，我听说还有一些记者和导演，也对相关的题材很感兴趣。"
                },
                {
                    "id": "747120108",
                    "speaker": "希格雯",
                    "text": "说不定，今后我们还能看到以保护水域环境为主题的映影？"
                },
                {
                    "id": "747120109",
                    "speaker": "派蒙",
                    "text": "嗯，只是普普通通讲道理，一些顽固的…或者粗心大意的家伙，根本听不进去。"
                },
                {
                    "id": "747120110",
                    "speaker": "派蒙",
                    "text": "干脆拍得吓人点…就说，环境被严重破坏后…鱼儿们会变异成超级无敌大怪兽，到处破坏！"
                },
                {
                    "id": "747120111",
                    "speaker": "派蒙",
                    "text": "让习惯往水里丢东西的人做噩梦，教育效果肯定超级棒！"
                },
                {
                    "id": "747120112",
                    "speaker": "希格雯",
                    "text": "那就太好啦。"
                }
            ]
        }
    ]
}