    "talks": [
        {
            "id": "7450801",
            "objective": "与摊位旁的两人对话",
            "dialogues": [
                {
                    "id": "745080101",
                    "speaker": "Black Screen",
                    "text": "一段时间后，你与派蒙来到了「小小灵蕈大幻戏」的摊位前…"
                },
                {
                    "id": "745080102",
                    "speaker": "昂吉安妮",
                    "text": "哼哼！滑滑弹弹软软嫩嫩的蕈兽真是太棒了！我还要继续玩这个游戏！"
                },
                {
                    "id": "745080103",
                    "speaker": "Player",
                    "text": "这位是？"
                },
                {
                    "id": "745080104",
                    "speaker": "昂吉安妮",
                    "text": "本小姐是昂吉安妮，蒂蕾娜进入特巡队之前的教官！"
                },
                {
                    "id": "745080105",
                    "speaker": "昂吉安妮",
                    "text": "我和蒂蕾娜不一样，不一样哦！不会因为你们是「超天顶领队级战力」就对你们畏畏缩缩！"
                },
                {
                    "id": "745080106",
                    "speaker": "派蒙",
                    "text": "这个很嚣张的美露莘…居然是蒂蕾娜以前的教官？"
                },
                {
                    "id": "745080107",
                    "speaker": "海妮耶",
                    "text": "别紧张，「黄金流星」和「白银伴星」。"
                },
                {
                    "id": "745080108",
                    "speaker": "海妮耶",
                    "text": "不久前，蒂蕾娜小姐接到了别的任务，回到特巡队的驻地去了。"
                },
                {
                    "id": "745080109",
                    "speaker": "海妮耶",
                    "text": "昂吉安妮小姐是蒂蕾娜小姐请来，代替她负责活动场地安保的专业人士。"
                },
                {
                    "id": "745080110",
                    "speaker": "海妮耶",
                    "text": "她也非常喜欢「小小灵蕈大幻戏」，和我玩得很开心。"
                },
                {
                    "id": "745080111",
                    "speaker": "昂吉安妮",
                    "text": "没错，无论是桌上的游戏，还是现实里圆圆的蕈兽！"
                },
                {
                    "id": "745080112",
                    "speaker": "昂吉安妮",
                    "text": "滑滑弹弹软软嫩嫩，就像汐藻一样…嘿嘿嘿…",
                    "choices": [
                        {
                            "id": "745080113",
                            "text": "你怎么流口水了？",
                            "response": [
                                {
                                    "id": "745080115",
                                    "speaker": "昂吉安妮",
                                    "text": "才不会吃！抱着蹭一下也没关系吧！海妮耶都不介意我捏捏「欢腾之火」呢！"
                                },
                                {
                                    "id": "745080116",
                                    "speaker": "派蒙",
                                    "text": "#那，那你也只能捏捏「欢腾之火」！「咚咚小圆帽」只有我和{NICKNAME}才能抱！"
                                },
                                {
                                    "id": "745080117",
                                    "speaker": "昂吉安妮",
                                    "text": "干嘛这么小气！我全都要！"
                                },
                                {
                                    "id": "745080118",
                                    "speaker": "昂吉安妮",
                                    "text": "海妮耶说过，你们是这个游戏的专家，那不如就和我比划比划？"
                                },
                                {
                                    "id": "745080119",
                                    "speaker": "昂吉安妮",
                                    "text": "如果我赢了，我也要揉捏「咚咚小圆帽」！"
                                },
                                {
                                    "id": "745080120",
                                    "speaker": "派蒙",
                                    "text": "可恶，被她瞧不起了！"
                                },
                                {
                                    "id": "745080121",
                                    "speaker": "派蒙",
                                    "text": "#{NICKNAME}，我们上吧，让她见识一下「小小灵蕈大幻戏」的第一代玩家的力量！",
                                    "choices": [
                                        {
                                            "id": "745080122",
                                            "text": "还有「月莲杯初代冠军」！",
                                            "response": [
                                                {
                                                    "id": "745080124",
                                                    "speaker": "派蒙",
                                                    "text": "对对对！我们那么多威风的外号可不是白白得来的呢，哪有随便就被打败的道理！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745080123",
                                            "text": "还有「智巧勇武双连星」！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745080114",
                            "text": "不许吃蕈兽伙伴！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7450802",
            "objective": "等待到第二天上午（6-12点）",
            "dialogues": []
        }
    ]
