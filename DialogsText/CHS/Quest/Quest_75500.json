        }
    },
    "talks": [
        {
            "id": "7550001",
            "objective": "前往观看「回声之子」的舞蹈活动",
            "dialogues": [
                {
                    "id": "755000101",
                    "speaker": "派蒙",
                    "text": "呜哇…"
                },
                {
                    "id": "755000102",
                    "speaker": "派蒙",
                    "text": "仔细看的时候才发现，台上这些「回声之子」跳的舞真厉害哇！人的身体居然能做出这么夸张的动作…"
                },
                {
                    "id": "755000103",
                    "speaker": "派蒙",
                    "text": "配合节奏感超强的音乐，还有刺激的火光，相比其他国家的艺术，有着完全不同的气质！"
                },
                {
                    "id": "755000104",
                    "speaker": "「炫彩呆子」",
                    "text": "#这位容光焕发的{M#少年}{F#少女}，还有飘浮着的哇音玩偶。"
                },
                {
                    "id": "755000105",
                    "speaker": "「炫彩呆子」",
                    "text": "我看你们感官敏锐，气质不凡，肯定能成为前卫艺术的先锋，涂鸦画师的超新星！"
                },
                {
                    "id": "755000106",
                    "speaker": "「炫彩呆子」",
                    "text": "要跟着我「炫彩呆子」一起混，把握最新潮的艺术理念吗？"
                },
                {
                    "id": "755000107",
                    "speaker": "派蒙",
                    "text": "哇啊，又是奇怪的外号！",
                    "choices": [
                        {
                            "id": "755000108",
                            "text": "你还在哇。",
                            "response": [
                                {
                                    "id": "755000110",
                                    "speaker": "派蒙",
                                    "text": "这次我可不会被带偏了——重点不在于哇不哇，或者新外号，而是这个「炫彩呆子」说的话。"
                                },
                                {
                                    "id": "755000111",
                                    "speaker": "派蒙",
                                    "text": "「前卫的理念」，听起来好像是…纳塔艺术与众不同的关键点？"
                                },
                                {
                                    "id": "755000112",
                                    "speaker": "「炫彩呆子」",
                                    "text": "好悟性~"
                                },
                                {
                                    "id": "755000113",
                                    "speaker": "「炫彩呆子」",
                                    "text": "如你所见，富有张力的舞姿、律动跳脱的音乐、还有色彩鲜明的涂鸦，这些都离不开前卫理念的熏陶。"
                                },
                                {
                                    "id": "755000114",
                                    "speaker": "「炫彩呆子」",
                                    "text": "在纳塔人的口中，时尚、潮流、新奇之类的说法，全都是前卫理念的同义词。"
                                },
                                {
                                    "id": "755000115",
                                    "speaker": "「炫彩呆子」",
                                    "text": "而我「炫彩呆子」作为「涂鸦联盟」的中流砥柱，正尝试让更多人理解前卫，践行前卫，用前卫把世界碾一遍…"
                                },
                                {
                                    "id": "755000116",
                                    "speaker": "「炫彩呆子」",
                                    "text": "从而让更多艺术不断进步，创造出非同凡响的美学产物，画出更狂猛的大尺寸涂鸦稿！",
                                    "choices": [
                                        {
                                            "id": "755000117",
                                            "text": "好难懂。",
                                            "response": [
                                                {
                                                    "id": "755000119",
                                                    "speaker": "「炫彩呆子」",
                                                    "text": "那就说点具体的，比如舞台背景的那幅大型涂鸦，我也参与了它的绘制。"
                                                },
                                                {
                                                    "id": "755000120",
                                                    "speaker": "「炫彩呆子」",
                                                    "text": "假如背景换成一幅写实的风景画、枫丹的唯美油画，或是须弥的壁画…"
                                                },
                                                {
                                                    "id": "755000121",
                                                    "speaker": "「炫彩呆子」",
                                                    "text": "你觉得搭调吗？"
                                                },
                                                {
                                                    "id": "755000122",
                                                    "speaker": "派蒙",
                                                    "text": "这个比方倒是很直白，我好像有点明白了…"
                                                },
                                                {
                                                    "id": "755000123",
                                                    "speaker": "派蒙",
                                                    "text": "如果背景的图形和配色没现在的涂鸦这么夸张，音乐和舞蹈，好像确实也少了点劲头？"
                                                },
                                                {
                                                    "id": "755000124",
                                                    "speaker": "「炫彩呆子」",
                                                    "text": "当然，我并不是说风景画、油画或壁画就不好。只是它们在需要强调张力和锐气的场合，不如前卫的涂鸦那么合适！"
                                                },
                                                {
                                                    "id": "755000125",
                                                    "speaker": "「炫彩呆子」",
                                                    "text": "要我说，不管纳塔的哪个部族，都有一种向上冲击，追求锐势的气魄，因此，前卫也可以说是纳塔的主调！"
                                                },
                                                {
                                                    "id": "755000126",
                                                    "speaker": "派蒙",
                                                    "text": "明明名字里有「呆子」这个词，懂的道理却挺多的嘛，你好厉害！",
                                                    "choices": [
                                                        {
                                                            "id": "755000127",
                                                            "text": "你要收我们为徒吗？",
                                                            "response": [
                                                                {
                                                                    "id": "755000129",
                                                                    "speaker": "「炫彩呆子」",
                                                                    "text": "嘿！你这反应，挺老辣啊？"
                                                                },
                                                                {
                                                                    "id": "755000130",
                                                                    "speaker": "「炫彩呆子」",
                                                                    "text": "不用紧张，我们不拘泥于死板的师徒关系，不在乎钱和名分，我们注重的是分享经验，期待分享之物到处开花结果。"
                                                                },
                                                                {
                                                                    "id": "755000131",
                                                                    "speaker": "「炫彩呆子」",
                                                                    "text": "只要你能洞察到前卫艺术的精髓，并创作出相应的涂鸦作品，我就非常满意了。"
                                                                },
                                                                {
                                                                    "id": "755000132",
                                                                    "speaker": "「炫彩呆子」",
                                                                    "text": "甚至会大把大把倒贴你摩拉和物资，帮助你迅速成长为可靠的涂鸦高手…"
                                                                },
                                                                {
                                                                    "id": "755000133",
                                                                    "speaker": "「炫彩呆子」",
                                                                    "text": "然后来帮我画稿。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "755000134",
                                                                            "text": "啊？我来画稿？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "755000136",
                                                                                    "speaker": "「炫彩呆子」",
                                                                                    "text": "或者帮我把涂鸦艺术宣传到其他地方，吸引更多人才加入涂鸦联盟。"
                                                                                },
                                                                                {
                                                                                    "id": "755000137",
                                                                                    "speaker": "「炫彩呆子」",
                                                                                    "text": "毕竟我们的目标是给纳塔的每座山画上无比前卫的涂鸦，只凭寥寥十几个人肯定忙不过来。"
                                                                                },
                                                                                {
                                                                                    "id": "755000138",
                                                                                    "speaker": "「炫彩呆子」",
                                                                                    "text": "我的背，我的腰…哎呀…成天举着染料罐画来画去，说不定骨头都歪了，肩膀和大腿都错位了。"
                                                                                },
                                                                                {
                                                                                    "id": "755000139",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "本来想说事出反常必有妖，换成其他人，我甚至有点担心是不是骗子…"
                                                                                },
                                                                                {
                                                                                    "id": "755000140",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "不过看你说得这么诚实，好像确实没什么可疑的地方。"
                                                                                },
                                                                                {
                                                                                    "id": "755000141",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#学一手涂鸦的本领，说不定以后还能派上用场，比如…画一面「{NICKNAME}和派蒙领地之墙」，吓跑魔物和坏人！"
                                                                                },
                                                                                {
                                                                                    "id": "755000142",
                                                                                    "speaker": "「炫彩呆子」",
                                                                                    "text": "不愧是我看中的人选，痛快！那我们就进入正题了——"
                                                                                },
                                                                                {
                                                                                    "id": "755000143",
                                                                                    "speaker": "「炫彩呆子」",
                                                                                    "text": "涂鸦这门手艺，对画技的要求并不严苛，在我看来，与其先练画，不如先去找准前卫理念的准绳。"
                                                                                },
                                                                                {
                                                                                    "id": "755000144",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "准绳？是…原则的意思吗？"
                                                                                },
                                                                                {
                                                                                    "id": "755000145",
                                                                                    "speaker": "「炫彩呆子」",
                                                                                    "text": "差不多吧！总之要找到超脱拘束的灵感，并将其自由自在地表达出来。"
                                                                                },
                                                                                {
                                                                                    "id": "755000146",
                                                                                    "speaker": "「炫彩呆子」",
                                                                                    "text": "为此，你们可以像我一样，在竞速挑战中捕捉风景扭曲形变的样貌，在近身搏斗中找寻人体动作的极限…"
                                                                                },
                                                                                {
                                                                                    "id": "755000147",
                                                                                    "speaker": "「炫彩呆子」",
                                                                                    "text": "如此一来，就能构思涂鸦所需要的夸张线条。"
                                                                                },
                                                                                {
                                                                                    "id": "755000148",
                                                                                    "speaker": "「炫彩呆子」",
                                                                                    "text": "至于色彩方案，将多种自然界的物品混搭，综合它们的配色，往往能获得意想不到的惊喜…"
                                                                                },
                                                                                {
                                                                                    "id": "755000149",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "听起来有点熟悉…又不太对劲。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "755000150",
                                                                                            "text": "在竞速和打架中观察线条。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "755000152",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "这种研究「艺术理念」的方法还真不一样，果然，纳塔人思考的方式真的很特别…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755000153",
                                                                                                    "speaker": "「炫彩呆子」",
                                                                                                    "text": "那么，收下我的这份涂鸦指南，带上这台留影机，在纳塔各处大闹一番，顺带好好感受这个国家独特之气的熏陶吧…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "755000154",
                                                                                                    "speaker": "「炫彩呆子」",
                                                                                                    "text": "等到你们归来的时候，我就能根据你们的见闻，帮你们总结出最能让你们理解的前卫理念！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "755000151",
                                                                                            "text": "收集各种物产，研究色彩。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "755000135",
                                                                            "text": "吔？这样抓助手？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "755000128",
                                                            "text": "学你的本事多少摩拉？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755000118",
                                            "text": "太抽象了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755000109",
                            "text": "哇音派蒙。"
                        }
                    ]
                }
            ]
        }
    ]
}