    },
    "talks": [
        {
            "id": "7166501",
            "objective": "找到委托人",
            "dialogues": [
                {
                    "id": "716650101",
                    "speaker": "兰吉特",
                    "text": "哎哟，可算来了，你就是「主角」吗？",
                    "choices": [
                        {
                            "id": "716650102",
                            "text": "我就是主角。",
                            "response": [
                                {
                                    "id": "716650103",
                                    "speaker": "派蒙",
                                    "text": "呃，完全搞不懂你提问的意图…"
                                },
                                {
                                    "id": "716650105",
                                    "speaker": "兰吉特",
                                    "text": "啊，抱歉抱歉，瞧我这急性子，明明发布委托的时候也被告知过应该用简洁的语言说明委托内容来着。"
                                },
                                {
                                    "id": "716650106",
                                    "speaker": "兰吉特",
                                    "text": "事情是这样，我叫兰吉特，是个创意料理厨子，我想和爆炎树搞好关系，但是它好像不大乐意…"
                                },
                                {
                                    "id": "716650107",
                                    "speaker": "兰吉特",
                                    "text": "又是吐火球又是撞地，我真拿它没辙了，所以需要一个能当故事主角的冒险家来帮帮我。",
                                    "choices": [
                                        {
                                            "id": "716650108",
                                            "text": "好的，交给我吧。",
                                            "response": [
                                                {
                                                    "id": "716650109",
                                                    "speaker": "派蒙",
                                                    "text": "不要随便答应这种荒唐的委托啦！"
                                                },
                                                {
                                                    "id": "716650111",
                                                    "speaker": "派蒙",
                                                    "text": "你是认真的吗？创意料理厨子和爆炎树交朋友…怎么想都很奇怪吧！"
                                                },
                                                {
                                                    "id": "716650112",
                                                    "speaker": "兰吉特",
                                                    "text": "是吗？它作为植物来说确实脾气有些过于暴躁了，不过凡事总得试试！"
                                                },
                                                {
                                                    "id": "716650113",
                                                    "speaker": "兰吉特",
                                                    "text": "除了爆炎树，之后我还打算试试挑战古岩龙蜥、翠翎恐蕈，还有千年珍珠骏麟！"
                                                },
                                                {
                                                    "id": "716650114",
                                                    "speaker": "派蒙",
                                                    "text": "呃，总觉得越说越离谱了。真不知道你这想法是从哪里来的。"
                                                },
                                                {
                                                    "id": "716650115",
                                                    "speaker": "兰吉特",
                                                    "text": "其实是因为我前阵子跑了趟纳塔…"
                                                },
                                                {
                                                    "id": "716650116",
                                                    "speaker": "兰吉特",
                                                    "text": "纳塔真是个神奇的地方，那种新奇的感觉，要说有什么能比的，恐怕就是第一次吃超辣咖喱时满头大汗的感觉了吧。"
                                                },
                                                {
                                                    "id": "716650117",
                                                    "speaker": "兰吉特",
                                                    "text": "明明已经到了口舌能够承受的刺激的极限，但却忍不住一勺又一勺地继续吃下去…"
                                                },
                                                {
                                                    "id": "716650118",
                                                    "speaker": "兰吉特",
                                                    "text": "…话说回来，当时我在纳塔结识了很多朋友，他们都是很好的人，有的教我攀岩，有的带我泡温泉。"
                                                },
                                                {
                                                    "id": "716650119",
                                                    "speaker": "兰吉特",
                                                    "text": "你知道吗？纳塔人，特别是战士，会在着装上模仿他们的龙。那一身行头打扮下来，看着真就和龙一样勇猛！"
                                                },
                                                {
                                                    "id": "716650120",
                                                    "speaker": "兰吉特",
                                                    "text": "我照着纳塔朋友的帽子给自己也做了一顶，你瞧，很不错吧？"
                                                },
                                                {
                                                    "id": "716650121",
                                                    "speaker": "派蒙",
                                                    "text": "唔…的确是很有特色的帽子，不过光看一顶帽子也看不出来什么。"
                                                },
                                                {
                                                    "id": "716650122",
                                                    "speaker": "兰吉特",
                                                    "text": "这倒也是，因为没有龙伙伴嘛！"
                                                },
                                                {
                                                    "id": "716650123",
                                                    "speaker": "兰吉特",
                                                    "text": "唉，要是我也能有龙伙伴就好了。但我又不是纳塔人，让我在纳塔长住我也安分不下来。"
                                                },
                                                {
                                                    "id": "716650124",
                                                    "speaker": "兰吉特",
                                                    "text": "于是我就想能不能在纳塔之外的地方找到能代替龙的伙伴，不管能不能成，之后回纳塔我也好把这段经历讲给纳塔朋友听！"
                                                },
                                                {
                                                    "id": "716650125",
                                                    "speaker": "派蒙",
                                                    "text": "就算是这样，你也应该挑选一下挑战的对象吧…"
                                                },
                                                {
                                                    "id": "716650126",
                                                    "speaker": "兰吉特",
                                                    "text": "欸？你不觉得它们都是合适的对象吗？和纳塔的龙也很像，然后也很强！"
                                                },
                                                {
                                                    "id": "716650127",
                                                    "speaker": "兰吉特",
                                                    "text": "毕竟有个驮兽伙伴可算不上本事，既然要给纳塔朋友讲冒险故事，当然得选些有挑战性的目标。"
                                                },
                                                {
                                                    "id": "716650128",
                                                    "speaker": "兰吉特",
                                                    "text": "比较可惜的是我自己当不了「主角」…要让这些不分白天黑夜都怒气冲冲的家伙们冷静下来可真不容易啊。"
                                                },
                                                {
                                                    "id": "716650129",
                                                    "speaker": "兰吉特",
                                                    "text": "不过经验丰富的冒险家应该很擅长应对这种事吧？当然，我也会从旁辅助的，不管是网子还是料理，就交给我好了。"
                                                },
                                                {
                                                    "id": "716650130",
                                                    "speaker": "兰吉特",
                                                    "text": "和潜在伙伴们正面「交涉」的工作就拜托你啦，「主角」！"
                                                },
                                                {
                                                    "id": "716650131",
                                                    "speaker": "派蒙",
                                                    "text": "你怎么把危险的工作都交给主角啊！",
                                                    "choices": [
                                                        {
                                                            "id": "716650132",
                                                            "text": "你的报酬最好是配得上我的劳动…",
                                                            "response": [
                                                                {
                                                                    "id": "716650133",
                                                                    "speaker": "兰吉特",
                                                                    "text": "那当然了！好说好说。"
                                                                },
                                                                {
                                                                    "id": "716650136",
                                                                    "speaker": "兰吉特",
                                                                    "text": "好！既然都谈妥了，那我们这就出发？锅已经支好了，装备也调试过了，应该没问题！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "716650137",
                                                                            "text": "出发吧。"
                                                                        },
                                                                        {
                                                                            "id": "716650138",
                                                                            "text": "还有别的事，稍候。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "716650139",
                                                                                    "speaker": "兰吉特",
                                                                                    "text": "没问题，我就在这儿等你。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "716650134",
                                                            "text": "先以理服人，再好好聊聊。了解。",
                                                            "response": [
                                                                {
                                                                    "id": "716650135",
                                                                    "speaker": "兰吉特",
                                                                    "text": "对，你说的对，是这个道理。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716650110",
                                            "text": "够简洁，但完全听不懂。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716650104",
                            "text": "听不懂你在说什么…"
                        }
                    ]
                }
            ]
        }
    ]
}