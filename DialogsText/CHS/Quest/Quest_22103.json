{
    "quest": {
        "id": "22103",
        "title": "客从远方来",
        "description": "望舒客栈周围似乎有奇怪的响动，菲尔戈黛特正在发愁…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 24,
        "total_speaker_counts": {
            "Player": 5,
            "菲尔戈黛特": 19
        }
    },
    "talks": [
        {
            "id": "2210301",
            "objective": "与菲尔戈黛特对话",
            "dialogues": [
                {
                    "id": "221030101",
                    "speaker": "菲尔戈黛特",
                    "text": "真麻烦…"
                },
                {
                    "id": "221030102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "221030103",
                    "speaker": "菲尔戈黛特",
                    "text": "咦？是客人吗？抱歉，最近客栈周围很奇怪…"
                },
                {
                    "id": "221030104",
                    "speaker": "菲尔戈黛特",
                    "text": "有好几位客人在附近被怪物袭击，弄得有些客人都不敢来做生意了…"
                },
                {
                    "id": "221030105",
                    "speaker": "菲尔戈黛特",
                    "text": "这样下去，迟早会惹出大麻烦来。"
                },
                {
                    "id": "221030106",
                    "speaker": "菲尔戈黛特",
                    "text": "唔，看你的打扮，是旅行者吧…您愿意帮忙去周围看看吗？",
                    "choices": [
                        {
                            "id": "221030107",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "221030109",
                                    "speaker": "菲尔戈黛特",
                                    "text": "谢谢您愿意帮忙。"
                                },
                                {
                                    "id": "221030113",
                                    "speaker": "菲尔戈黛特",
                                    "text": "总之，就拜托您了，我会准备好报酬的。"
                                }
                            ]
                        },
                        {
                            "id": "221030108",
                            "text": "是怪物很危险吗？",
                            "response": [
                                {
                                    "id": "221030110",
                                    "speaker": "菲尔戈黛特",
                                    "text": ""
                                },
                                {
                                    "id": "221030111",
                                    "speaker": "菲尔戈黛特",
                                    "text": "主要是…怕哪个怪物触了那位的霉头…"
                                },
                                {
                                    "id": "221030112",
                                    "speaker": "菲尔戈黛特",
                                    "text": "他对付怪物，可从来不看场合和在场的人等…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2210302",
            "objective": "前往可疑地点查看",
            "dialogues": [
                {
                    "id": "221030201",
                    "speaker": "菲尔戈黛特",
                    "text": "都处理好了吗？"
                },
                {
                    "id": "221030202",
                    "speaker": "Player",
                    "text": "还没有…"
                },
                {
                    "id": "221030203",
                    "speaker": "菲尔戈黛特",
                    "text": "请您快些吧，那位来无影去无踪的…指不定什么时候就会回来。"
                },
                {
                    "id": "221030204",
                    "speaker": "菲尔戈黛特",
                    "text": "要是他真动起手来，这客栈又要歇业了。"
                }
            ]
        },
        {
            "id": "2210303",
            "objective": "消灭所有魔物",
            "dialogues": [
                {
                    "id": "221030301",
                    "speaker": "菲尔戈黛特",
                    "text": "都处理好了吗？"
                },
                {
                    "id": "221030302",
                    "speaker": "Player",
                    "text": "处理好了。"
                },
                {
                    "id": "221030303",
                    "speaker": "菲尔戈黛特",
                    "text": "太好了…总算能安心做会生意了。"
                },
                {
                    "id": "221030304",
                    "speaker": "菲尔戈黛特",
                    "text": "这是给您的报酬，收下吧。"
                },
                {
                    "id": "221030305",
                    "speaker": "菲尔戈黛特",
                    "text": "「那位」是谁？嗯…你没见过他吗？"
                },
                {
                    "id": "221030306",
                    "speaker": "菲尔戈黛特",
                    "text": "他有时候会在客栈顶上休息，您说不定看见过呢。"
                },
                {
                    "id": "221030307",
                    "speaker": "菲尔戈黛特",
                    "text": "不过，就算您见到他了，最好也别轻易去打扰他，他喜欢一个人呆着。"
                }
            ]
        },
        {
            "id": "2210304",
            "objective": "向菲尔戈黛特回报",
            "dialogues": []
        }
    ]
}