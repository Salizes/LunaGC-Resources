    "talks": [
        {
            "id": "7650801",
            "objective": "前往「流泉之众」",
            "dialogues": [
                {
                    "id": "765080101",
                    "speaker": "派蒙",
                    "text": "最近「流泉之众」是在举办什么活动吗？好像多了一些游客？"
                },
                {
                    "id": "765080102",
                    "speaker": "派蒙",
                    "text": "那边有一位须弥客人…在给大家表演舞蹈？"
                },
                {
                    "id": "765080103",
                    "speaker": "努斯妲",
                    "text": "啊呀呀，闪亮亮的大英雄和可爱的派蒙参谋也来了！"
                },
                {
                    "id": "765080104",
                    "speaker": "努斯妲",
                    "text": "向您致以最真挚的问候，我最敬重的战士、武力和舞力的双重勇者，以及生活享受家！"
                },
                {
                    "id": "765080105",
                    "speaker": "派蒙",
                    "text": "咦，这位小姐有点眼熟欸…"
                },
                {
                    "id": "765080106",
                    "speaker": "派蒙",
                    "text": "#而且，你怎么知道{NICKNAME}跳起舞来很开心？"
                },
                {
                    "id": "765080107",
                    "speaker": "努斯妲",
                    "text": "#当然是在圣火竞技场前看过{M#他}{F#她}欢快的舞姿啦！"
                },
                {
                    "id": "765080108",
                    "speaker": "努斯妲",
                    "text": "#合过影后，我找了个不那么显眼的地方，一边吃龙龙饼干，一边看完了{NICKNAME}的祝福舞蹈。"
                },
                {
                    "id": "765080109",
                    "speaker": "努斯妲",
                    "text": "#跳舞就是要轻轻松松，释放自我嘛！我都想上去为{NICKNAME}伴舞了！",
                    "choices": [
                        {
                            "id": "765080110",
                            "text": "想起来了！",
                            "response": [
                                {
                                    "id": "765080111",
                                    "speaker": "努斯妲",
                                    "text": "我的荣幸！"
                                },
                                {
                                    "id": "765080114",
                                    "speaker": "努斯妲",
                                    "text": "言归正传，如您所见，最近有些须弥朋友盛情来访。"
                                },
                                {
                                    "id": "765080115",
                                    "speaker": "努斯妲",
                                    "text": "经过穆托塔、阿米娜、帕加尔和玛拉妮的商量，我们「花羽会」决定联合「回声之子」与「流泉之众」，好好招待他们。"
                                },
                                {
                                    "id": "765080116",
                                    "speaker": "派蒙",
                                    "text": "看起来，有不少「镀金旅团」的佣兵呢…"
                                },
                                {
                                    "id": "765080117",
                                    "speaker": "派蒙",
                                    "text": "让我猜猜，是不是在沙漠旅行时，不打不相识，打成了朋友？"
                                },
                                {
                                    "id": "765080118",
                                    "speaker": "努斯妲",
                                    "text": "哎，八九不离十了！不过，不是我们之间互斗。"
                                },
                                {
                                    "id": "765080119",
                                    "speaker": "努斯妲",
                                    "text": "我们在千壑沙地南边大办烤肉聚会时，引来了一群凶狠的赤鹫，它们专挑我们吃撑喝撑，跑不动道的时机下手…"
                                },
                                {
                                    "id": "765080120",
                                    "speaker": "努斯妲",
                                    "text": "打法还十分狡猾，我们一番苦斗无果，被它们利用熟悉地形的优势打得疲惫不堪，只能先撤离。"
                                },
                                {
                                    "id": "765080121",
                                    "speaker": "努斯妲",
                                    "text": "没想到，一队佣兵出现在我们后退的路上，对着赤鹫们跳起了神秘的战舞…"
                                },
                                {
                                    "id": "765080122",
                                    "speaker": "努斯妲",
                                    "text": "结果那些赤鹫好像和他们达成了共识，退了回去！"
                                },
                                {
                                    "id": "765080123",
                                    "speaker": "派蒙",
                                    "text": "用，用战舞让赤鹫离开了？",
                                    "choices": [
                                        {
                                            "id": "765080124",
                                            "text": "是舞姿怪异吓退了它们…",
                                            "response": [
                                                {
                                                    "id": "765080126",
                                                    "speaker": "努斯妲",
                                                    "text": "特别神奇，对不对？我们也很好奇那种舞蹈的奥秘！"
                                                },
                                                {
                                                    "id": "765080127",
                                                    "speaker": "努斯妲",
                                                    "text": "收拾好营地后，我们一起大口吃肉大桶喝酒，等到酒足饭饱，就开始交流舞蹈的技巧…"
                                                },
                                                {
                                                    "id": "765080128",
                                                    "speaker": "努斯妲",
                                                    "text": "要是中途还有别的魔物和野兽来打搅我们的兴致，我们就一起抄家伙上！"
                                                },
                                                {
                                                    "id": "765080129",
                                                    "speaker": "努斯妲",
                                                    "text": "不出两个礼拜，我们就成了过命的战友和舞友！"
                                                },
                                                {
                                                    "id": "765080130",
                                                    "speaker": "努斯妲",
                                                    "text": "分别前，我们约好，以后还要正式造访各自的营地，继续「舞术交流」，这次就是开头了。"
                                                },
                                                {
                                                    "id": "765080131",
                                                    "speaker": "派蒙",
                                                    "text": "#你别说，{NICKNAME}，好像以前我们还没参加过这种…须弥和纳塔朋友互相交流跳舞的活动？",
                                                    "choices": [
                                                        {
                                                            "id": "765080132",
                                                            "text": "确实新奇。",
                                                            "response": [
                                                                {
                                                                    "id": "765080134",
                                                                    "speaker": "努斯妲",
                                                                    "text": "这可是难得的好机会，来为我们指导一番，如何？"
                                                                },
                                                                {
                                                                    "id": "765080135",
                                                                    "speaker": "努斯妲",
                                                                    "text": "玛拉妮也在场哦，她算是我们之中最为欢乐的舞蹈代言人。"
                                                                },
                                                                {
                                                                    "id": "765080136",
                                                                    "speaker": "努斯妲",
                                                                    "text": "而且，「镀金旅团」的朋友还花重金邀请了当地有名的舞者，来作为须弥方的领队和顾问。"
                                                                },
                                                                {
                                                                    "id": "765080137",
                                                                    "speaker": "努斯妲",
                                                                    "text": "我想，你们肯定也认识那位舞者！"
                                                                },
                                                                {
                                                                    "id": "765080138",
                                                                    "speaker": "派蒙",
                                                                    "text": "好像已经猜到是谁了，嘿嘿，待会儿我们给她一个大惊喜…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "765080139",
                                                                            "text": "好啊好啊，我要加入！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "765080141",
                                                                                    "speaker": "努斯妲",
                                                                                    "text": "哈哈哈哈！这下更热闹了，用玛拉妮的话来说，气氛达到了最嗨点！"
                                                                                },
                                                                                {
                                                                                    "id": "765080142",
                                                                                    "speaker": "努斯妲",
                                                                                    "text": "走吧，我们去找塔拉内小妹！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "765080140",
                                                                            "text": "这种活动，不能错过！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765080133",
                                                            "text": "想要看看。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765080125",
                                            "text": "还是两边本来就认识？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765080112",
                            "text": "以后肯定记住。",
                            "response": [
                                {
                                    "id": "765080113",
                                    "speaker": "努斯妲",
                                    "text": "那说明我干活还不够卖力，没留下什么亮眼的成就，仍需努力！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650802",
            "objective": "和塔拉内对话",
            "dialogues": [
                {
                    "id": "765080301",
                    "speaker": "塔拉内",
                    "text": "#啊呀，啊呀呀！这不是大名人{NICKNAME}嘛？"
                },
                {
                    "id": "765080302",
                    "speaker": "塔拉内",
                    "text": "我以为请到妮露小姐已经是万幸中的万幸了，没想到，还有高手中的高手！"
                },
                {
                    "id": "765080303",
                    "speaker": "努斯妲",
                    "text": "#多夸夸{NICKNAME}，我爱听！"
                },
                {
                    "id": "765080304",
                    "speaker": "派蒙",
                    "text": "欸？这不是我的台词吗？"
                },
                {
                    "id": "765080305",
                    "speaker": "努斯妲",
                    "text": "没错！同样的字词由派蒙参谋说出来，听感灵巧轻盈，好比悠可琴的音轨，软软弹弹可可爱爱。"
                },
                {
                    "id": "765080306",
                    "speaker": "努斯妲",
                    "text": "而由我来说，听感就像是…鼓手喝了半桶酒后打出来的段子，顿挫管够，劲道踏实。"
                },
                {
                    "id": "765080307",
                    "speaker": "努斯妲",
                    "text": "当然，按伊安珊大师的教诲，底鼓的双踩也多多益善，最好像自动枪一样连绵不停。"
                },
                {
                    "id": "765080308",
                    "speaker": "努斯妲",
                    "text": "这样，就算我们说了一样的台词，也不嫌重复啰嗦，而是互相补全了多个声部，还能让你卡准节奏。"
                },
                {
                    "id": "765080309",
                    "speaker": "派蒙",
                    "text": "还，还有这种事？被你说晕了…"
                },
                {
                    "id": "765080310",
                    "speaker": "塔拉内",
                    "text": "努斯妲大姐聊到点子上了——节奏。"
                },
                {
                    "id": "765080311",
                    "speaker": "塔拉内",
                    "text": "我们的舞蹈自由而张扬，但也不能完全无拘无束，至少，最关键的动作需要精准卡点。"
                },
                {
                    "id": "765080312",
                    "speaker": "塔拉内",
                    "text": "最近的新舞已经编排好动作了，但前来体验的新人和…新龙们，都不太擅长找准节奏。"
                },
                {
                    "id": "765080313",
                    "speaker": "塔拉内",
                    "text": "#正好，就由{NICKNAME}来给出节奏的指导吧？"
                },
                {
                    "id": "765080314",
                    "speaker": "塔拉内",
                    "text": "有你在场的话，新人和新龙们肯定都会全神贯注，不出几下就学个透彻！",
                    "choices": [
                        {
                            "id": "765080315",
                            "text": "好！我的节拍打得又稳又准。",
                            "response": [
                                {
                                    "id": "765080317",
                                    "speaker": "派蒙",
                                    "text": "那那那，我就在一边给你加油打气…"
                                },
                                {
                                    "id": "765080318",
                                    "speaker": "派蒙",
                                    "text": "嗯…还有，鼓励被你指挥的大家！"
                                }
                            ]
                        },
                        {
                            "id": "765080316",
                            "text": "虽然不专业，但我有信心。"
                        }
                    ]
                }
            ]
        }
    ]
}