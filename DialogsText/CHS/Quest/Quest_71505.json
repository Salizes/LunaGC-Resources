    "talks": [
        {
            "id": "7150503",
            "objective": "等到一天后",
            "dialogues": []
        },
        {
            "id": "7150501",
            "objective": "与胡塞尼对话",
            "dialogues": [
                {
                    "id": "715050101",
                    "speaker": "胡塞尼",
                    "text": "#{NICKNAME}，你总算来了。"
                },
                {
                    "id": "715050102",
                    "speaker": "Player",
                    "text": "调试得还顺利吗？"
                },
                {
                    "id": "715050103",
                    "speaker": "胡塞尼",
                    "text": "已经调试完毕，虽然有些担心，不过现在也只能暂时把光钉放在矿道深处。"
                },
                {
                    "id": "715050104",
                    "speaker": "胡塞尼",
                    "text": "我还拜托海迪夫做了药，会给老图和阿昊也送过去的。"
                },
                {
                    "id": "715050105",
                    "speaker": "胡塞尼",
                    "text": "#{NICKNAME}，启动光钉，然后封闭掉地脉喷涌黑泥的出口…一定要做到啊。"
                },
                {
                    "id": "715050106",
                    "speaker": "胡塞尼",
                    "text": "原本只是海迪夫叫我过来帮个忙而已，那个时候我心里想着，要是我解决不了这个问题，大不了就带着光钉直接回须弥。"
                },
                {
                    "id": "715050107",
                    "speaker": "胡塞尼",
                    "text": "反正关于「普尔希娜光钉」的实验也已经做得够多，要完成一篇数据详实的报告根本就是绰绰有余。"
                },
                {
                    "id": "715050108",
                    "speaker": "胡塞尼",
                    "text": "但是老图和阿昊呢，这些生活在这里的人…他们可就只能终身和这些危险的黑泥为伴了。"
                },
                {
                    "id": "715050109",
                    "speaker": "胡塞尼",
                    "text": "如果我的研究无法真的帮助到他们，只是为了一篇报告的话，我想，恐怕这研究也意义不大。"
                },
                {
                    "id": "715050110",
                    "speaker": "胡塞尼",
                    "text": "所以我才决定，要想办法解决地脉喷涌黑泥的问题，更何况，接触这些黑泥…对作为须弥学者的我来说也是一种警醒…"
                },
                {
                    "id": "715050111",
                    "speaker": "胡塞尼",
                    "text": "#我相信你的实力，但是黑泥涌出的地方还是很危险，要小心啊，{NICKNAME}…",
                    "choices": [
                        {
                            "id": "715050112",
                            "text": "知道了。",
                            "response": [
                                {
                                    "id": "715050114",
                                    "speaker": "胡塞尼",
                                    "text": "哈哈哈呃咳、咳咳…咳咳…"
                                },
                                {
                                    "id": "715050115",
                                    "speaker": "胡塞尼",
                                    "text": "#我是说你，{NICKNAME}，「普尔希娜光钉」在喷口处启动，虽然能够减轻黑泥对怪物的影响。"
                                },
                                {
                                    "id": "715050116",
                                    "speaker": "胡塞尼",
                                    "text": "但那里之前被黑泥招来的怪物数量还是太多了…"
                                },
                                {
                                    "id": "715050117",
                                    "speaker": "胡塞尼",
                                    "text": "你一定要小心自己的安全。"
                                }
                            ]
                        },
                        {
                            "id": "715050113",
                            "text": "我会小心光钉的…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7150502",
            "objective": "启动「普尔希娜光钉」以封闭地脉喷口",
            "dialogues": []
        }
    ]
