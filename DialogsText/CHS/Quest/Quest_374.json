    "talks": [
        {
            "id": "37408",
            "objective": "(test)位置保护尝试$HIDDEN",
            "dialogues": []
        },
        {
            "id": "37407",
            "objective": "跟随温迪前往大教堂",
            "dialogues": [
                {
                    "id": "3740701",
                    "speaker": "派蒙",
                    "text": "所以你说的「天空」，到底是…"
                },
                {
                    "id": "3740702",
                    "speaker": "温迪",
                    "text": "蒙德的至宝，风神巴巴托斯曾经弹奏的竖琴。"
                },
                {
                    "id": "3740703",
                    "speaker": "温迪",
                    "text": "只要有了天空之琴，我就能从噩梦中唤回特瓦林的本性。"
                },
                {
                    "id": "3740704",
                    "speaker": "派蒙",
                    "text": "这样…真的可以让风魔龙停止破坏吗？"
                },
                {
                    "id": "3740705",
                    "speaker": "温迪",
                    "text": "当然，因为我可是天下最好的诗人。"
                },
                {
                    "id": "3740706",
                    "speaker": "温迪",
                    "text": "过去、未来与现在，没有我不知道的歌谣。"
                },
                {
                    "id": "3740707",
                    "speaker": "温迪",
                    "text": "看着我的眼睛，你不觉得我很值得信任吗？",
                    "choices": [
                        {
                            "id": "3740708",
                            "text": "…可疑。",
                            "response": [
                                {
                                    "id": "3740711",
                                    "speaker": "温迪",
                                    "text": "哈哈哈，这一招对吟游诗人是无效的。"
                                },
                                {
                                    "id": "3740712",
                                    "speaker": "派蒙",
                                    "text": "那么，该怎么拿到天空之琴呢？"
                                },
                                {
                                    "id": "3740713",
                                    "speaker": "温迪",
                                    "text": "据说它被供奉在大教堂深处，某个安全的地方。"
                                },
                                {
                                    "id": "3740714",
                                    "speaker": "温迪",
                                    "text": "我会去探查一下情况，你有兴趣的话也可以跟来看看。"
                                }
                            ]
                        },
                        {
                            "id": "3740709",
                            "text": "有限地相信一下也没坏处…"
                        },
                        {
                            "id": "3740710",
                            "text": "你眼睛的颜色像我故乡的天空。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "37401",
            "objective": "到温迪附近",
            "dialogues": []
        },
        {
            "id": "37402",
            "objective": "观看温迪的借琴之道",
            "dialogues": [
                {
                    "id": "3740201",
                    "speaker": "温迪",
                    "text": "看我的吧——"
                },
                {
                    "id": "3740202",
                    "speaker": "温迪",
                    "text": "你好，修女姐姐。"
                },
                {
                    "id": "3740203",
                    "speaker": "歌特琳德",
                    "text": "风神祝福你，年轻的诗人。有什么事吗？"
                },
                {
                    "id": "3740204",
                    "speaker": "温迪",
                    "text": "其实，我掌握了一个秘密，能够解救蒙德城遇到的危机。"
                },
                {
                    "id": "3740205",
                    "speaker": "歌特琳德",
                    "text": "哦？那可真是风神保佑。"
                },
                {
                    "id": "3740206",
                    "speaker": "歌特琳德",
                    "text": "但这件事你应该对骑士团报告。我这样一个无关的修女能帮到你什么呢？"
                },
                {
                    "id": "3740207",
                    "speaker": "温迪",
                    "text": "啊哈哈，姐姐你当然是有能帮忙的地方了。"
                },
                {
                    "id": "3740208",
                    "speaker": "温迪",
                    "text": "比如说…天空之琴。借助它的力量，我可以让风魔龙——"
                },
                {
                    "id": "3740209",
                    "speaker": "歌特琳德",
                    "text": "请回吧。"
                },
                {
                    "id": "3740210",
                    "speaker": "温迪",
                    "text": "咦？"
                },
                {
                    "id": "3740211",
                    "speaker": "歌特琳德",
                    "text": "虽然那条龙非常凶恶，但只要代理团长下定决心，就没有不能讨伐的道理。"
                },
                {
                    "id": "3740212",
                    "speaker": "温迪",
                    "text": "那可不行，那样的话风魔龙不就会死掉了吗？"
                },
                {
                    "id": "3740213",
                    "speaker": "歌特琳德",
                    "text": "背离东风的愚兽，即便是风神本尊降临，也不会轻易原谅它！"
                },
                {
                    "id": "3740214",
                    "speaker": "温迪",
                    "text": "唔…"
                },
                {
                    "id": "3740215",
                    "speaker": "温迪",
                    "text": "呃…那个，大姐姐~~"
                },
                {
                    "id": "3740216",
                    "speaker": "歌特琳德",
                    "text": "不行就是不行哟，小诗人。"
                },
                {
                    "id": "3740217",
                    "speaker": "歌特琳德",
                    "text": "（嘶…被这孩子叫大姐姐，心里怎么会泛起一种不可思议的高兴…真荒谬…）"
                },
                {
                    "id": "3740218",
                    "speaker": "温迪",
                    "text": "呼…真没办法。"
                },
                {
                    "id": "3740219",
                    "speaker": "温迪",
                    "text": "我已经不能再隐瞒了！"
                },
                {
                    "id": "3740220",
                    "speaker": "温迪",
                    "text": "我虔诚的信徒啊，喜悦吧！在你面前的，正是<color=#00E1FFFF>风神巴巴托斯</color>本人——"
                },
                {
                    "id": "3740221",
                    "speaker": "温迪",
                    "text": "是不是很震惊？是不是震惊得想哭？终于见到了侍奉的神明，怎样？很感动吧？"
                },
                {
                    "id": "3740222",
                    "speaker": "歌特琳德",
                    "text": "没别的事情的话，我回去继续处理教堂的文件了。"
                },
                {
                    "id": "3740223",
                    "speaker": "温迪",
                    "text": "呀——"
                }
            ]
        },
        {
            "id": "37403",
            "objective": "等待温迪的“借”琴之道$HIDDEN",
            "dialogues": [
                {
                    "id": "3740301",
                    "speaker": "温迪",
                    "text": "欸嘿，修女她头也不回地走了。"
                },
                {
                    "id": "3740302",
                    "speaker": "温迪",
                    "text": "不过呢，其实我也已经达到了预定的目的。"
                },
                {
                    "id": "3740303",
                    "speaker": "温迪",
                    "text": "至少她没有否认——大教堂里收藏着天空之琴。"
                },
                {
                    "id": "3740304",
                    "speaker": "温迪",
                    "text": "#那么，{NICKNAME}。既然你是骑士团正当红的新人…"
                },
                {
                    "id": "3740305",
                    "speaker": "温迪",
                    "text": "要不然，你也来试试？"
                }
            ]
        },
        {
            "id": "37404",
            "objective": "与温迪对话",
            "dialogues": []
        },
        {
            "id": "37405",
            "objective": "主动寻找修女$HIDDEN",
            "dialogues": []
        },
        {
            "id": "37406",
            "objective": "与修女对话",
            "dialogues": [
                {
                    "id": "3740401",
                    "speaker": "歌特琳德",
                    "text": "风神祝福你。",
                    "choices": [
                        {
                            "id": "3740402",
                            "text": "你好。",
                            "response": [
                                {
                                    "id": "3740403",
                                    "speaker": "歌特琳德",
                                    "text": "啊，你是…骑士团的那位新成员吧？"
                                },
                                {
                                    "id": "3740406",
                                    "speaker": "歌特琳德",
                                    "text": "为什么来这里？是代理团长大人交待的公务吗？"
                                },
                                {
                                    "id": "3740411",
                                    "speaker": "Player",
                                    "text": "嗯，骑士团，要借用天空之琴…"
                                },
                                {
                                    "id": "3740412",
                                    "speaker": "歌特琳德",
                                    "text": "真的吗…"
                                },
                                {
                                    "id": "3740413",
                                    "speaker": "歌特琳德",
                                    "text": "倒不是怀疑你。但早些时候有个可疑的诗人也来借琴。"
                                },
                                {
                                    "id": "3740414",
                                    "speaker": "歌特琳德",
                                    "text": "他满口胡言，竟敢自称巴巴托斯，一定没安好心。"
                                },
                                {
                                    "id": "3740415",
                                    "speaker": "歌特琳德",
                                    "text": "天空之琴的使用是有规定的。目前只有羽球节期间才会用到。"
                                },
                                {
                                    "id": "3740416",
                                    "speaker": "歌特琳德",
                                    "text": "出借时需要团长、主教，还有民众代表协商同意，签署文件。"
                                },
                                {
                                    "id": "3740417",
                                    "speaker": "歌特琳德",
                                    "text": "那么，骑士团的文件呢？",
                                    "choices": [
                                        {
                                            "id": "3740418",
                                            "text": "好像没听团长提起…",
                                            "response": [
                                                {
                                                    "id": "3740422",
                                                    "speaker": "歌特琳德",
                                                    "text": "总而言之文件是必须的。"
                                                },
                                                {
                                                    "id": "3740423",
                                                    "speaker": "歌特琳德",
                                                    "text": "没其他事的话，恕我失陪了。最近真的很忙啊。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "3740419",
                                            "text": "对不起，我忘了拿。"
                                        },
                                        {
                                            "id": "3740420",
                                            "text": "在路上被派蒙吃掉了。",
                                            "response": [
                                                {
                                                    "id": "3740421",
                                                    "speaker": "派蒙",
                                                    "text": "喂！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "3740404",
                            "text": "#我是荣誉骑士{NICKNAME}。",
                            "response": [
                                {
                                    "id": "3740405",
                                    "speaker": "歌特琳德",
                                    "text": "嗯，我认识你。那天你跟安柏一起拯救了蒙德呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "37309",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3730901",
                    "speaker": "歌特琳德",
                    "text": "最近教会的事务真是又多又乱，主教大人偏偏又不在…哎呀。"
                }
            ]
        },
        {
            "id": "37502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "3750202",
                    "speaker": "奥特",
                    "text": "麻烦啊，这地下室入口真的需要在整个<color=#00E1FFFF>白天</color>一直守卫吗…\\n喂！你站住，这里禁止通行！"
                },
                {
                    "id": "3750203",
                    "speaker": "派蒙",
                    "text": "看来只能等到<color=#00E1FFFF>晚上</color>再悄悄溜进去了。"
                }
            ]
        }
    ]
}