    "talks": [
        {
            "id": "7723801",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772380101",
                    "speaker": "？？？",
                    "text": "该死的，怎么、怎么会有人在野外的温泉偷…"
                },
                {
                    "id": "772380102",
                    "speaker": "？？？",
                    "text": "等我拿回了衣服，我一定要把那个臭小偷大卸八块！"
                },
                {
                    "id": "772380103",
                    "speaker": "派蒙",
                    "text": "咦，怎么有人在、在木桶里面？"
                },
                {
                    "id": "772380104",
                    "speaker": "？？？",
                    "text": "外、外面有人吗，难道也是来泡温泉的客人？"
                },
                {
                    "id": "772380105",
                    "speaker": "？？？",
                    "text": "唉…我能不能拜托你们一件事，我刚才泡温泉结束，却发现衣服不见了，又听到有人来…"
                },
                {
                    "id": "772380106",
                    "speaker": "？？？",
                    "text": "才不得不躲进木桶里，能不能…帮我把我的衣服找回来？"
                },
                {
                    "id": "772380107",
                    "speaker": "派蒙",
                    "text": "唔，好吧，我们尽量在周围找找…"
                }
            ]
        },
        {
            "id": "7723802",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772380201",
                    "speaker": "？？？",
                    "text": "气死我了，气死我了…"
                },
                {
                    "id": "772380202",
                    "speaker": "？？？",
                    "text": "该死的、该死的，偷衣服的小贼！"
                }
            ]
        },
        {
            "id": "7723803",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772380301",
                    "speaker": "派蒙",
                    "text": "啊，果然，刚才你就在翻什么，果然是在翻别人的衣服！"
                },
                {
                    "id": "772380302",
                    "speaker": "派蒙",
                    "text": "你…唉，你把别人的衣服偷走干什么啦！"
                },
                {
                    "id": "772380303",
                    "speaker": "偷东西霜精",
                    "text": "呜呜…呀吼！呀吼！"
                },
                {
                    "id": "772380304",
                    "speaker": "Black Screen",
                    "text": "在霜精的手舞足蹈下，终于明白了它的意思…"
                },
                {
                    "id": "772380305",
                    "speaker": "派蒙",
                    "text": "呃，你是说，看到雪人没有衣服，感到很可怜。"
                },
                {
                    "id": "772380306",
                    "speaker": "派蒙",
                    "text": "…被偷衣服的人也很可怜啦！再怎么样也不能偷别人的衣服给雪人穿上！"
                },
                {
                    "id": "772380307",
                    "speaker": "偷东西霜精",
                    "text": "呜呜…"
                },
                {
                    "id": "772380308",
                    "speaker": "派蒙",
                    "text": "快，把偷走的衣服还回来！"
                },
                {
                    "id": "772380309",
                    "speaker": "偷东西霜精",
                    "text": "呀吼…"
                },
                {
                    "id": "772380310",
                    "speaker": "Black Screen",
                    "text": "偷走衣服的霜精将衣服递到了你们手上。\\n但这件衣服让你觉得有点奇怪…"
                },
                {
                    "id": "772380311",
                    "speaker": "派蒙",
                    "text": "好，我们去把衣服还给木桶里的人吧，那个人在木桶里一定等急了。"
                }
            ]
        },
        {
            "id": "7723804",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "772380401",
                    "speaker": "？？？",
                    "text": "怎么样？"
                },
                {
                    "id": "772380402",
                    "speaker": "派蒙",
                    "text": "我们找到偷你衣服的家伙啦，还有，还有你的衣服！"
                },
                {
                    "id": "772380403",
                    "speaker": "？？？",
                    "text": "我要看看是哪个胆大包天的家伙，呜，不过得先穿好衣服才行，好、好冷…"
                },
                {
                    "id": "772380404",
                    "speaker": "派蒙",
                    "text": "那我们要怎么把衣服给你…"
                },
                {
                    "id": "772380405",
                    "speaker": "？？？",
                    "text": "放在桶边上就好，谢谢。然后、还、还请几位转过身去…"
                },
                {
                    "id": "772380406",
                    "speaker": "Player",
                    "text": "（将衣服放在桶边…）"
                },
                {
                    "id": "772380407",
                    "speaker": "Black Screen",
                    "text": "你转过身去，然后听到身后传来穿衣服的窸窸窣窣声…\\n毛发摩擦的声音有些多，这你之前就有所察觉。\\n丢失了衣服的其实是…"
                },
                {
                    "id": "772380408",
                    "speaker": "派蒙",
                    "text": "啊…原来是兽怪。"
                },
                {
                    "id": "772380409",
                    "speaker": "克列娃",
                    "text": "是的，我是这个温泉的管理人克列娃…其实也就是老板啦，不过这边倒也不收摩拉就是了。"
                },
                {
                    "id": "772380410",
                    "speaker": "克列娃",
                    "text": "欢迎两位尽情享受这个温泉…虽然温泉其实是克什尼克之炬的地暖管道泄露产生的，这点还请不要举报给能源协会…"
                },
                {
                    "id": "772380411",
                    "speaker": "克列娃",
                    "text": "啊，对了，你、你就是偷走我衣服的家伙！！"
                },
                {
                    "id": "772380412",
                    "speaker": "偷东西霜精",
                    "text": "呀吼…呀吼…"
                },
                {
                    "id": "772380413",
                    "speaker": "克列娃",
                    "text": "唉，这一脸蠢像！居然把我的衣服拿去给雪人穿？雪人会感冒吗？"
                },
                {
                    "id": "772380414",
                    "speaker": "偷东西霜精",
                    "text": "呜呜…呀吼！"
                },
                {
                    "id": "772380415",
                    "speaker": "克列娃",
                    "text": "装无辜也没有用，你…你要给我留下来干活！给我洗满一百件衣服才能走！"
                },
                {
                    "id": "772380416",
                    "speaker": "偷东西霜精",
                    "text": "哇？呀吼！"
                }
            ]
        },
        {
            "id": "7723805",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7723806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "772380601",
                    "speaker": "偷东西霜精",
                    "text": "呀吼？"
                },
                {
                    "id": "772380602",
                    "speaker": "克列娃",
                    "text": "呃，真是气死我了，你要说多少遍才懂啊！"
                },
                {
                    "id": "772380603",
                    "speaker": "克列娃",
                    "text": "别在这里发呆了！快点快点，手动起来啦！"
                },
                {
                    "id": "772380604",
                    "speaker": "偷东西霜精",
                    "text": "呀吼…呀吼…"
                }
            ]
        }
    ]
}