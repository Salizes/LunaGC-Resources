    "talks": [
        {
            "id": "7116001",
            "objective": "霄灯-莱依拉$HIDDEN",
            "dialogues": [
                {
                    "id": "711600301",
                    "speaker": "莱依拉",
                    "text": "这样编霄灯，然后放飞出去，真的能愿望成真吗…"
                },
                {
                    "id": "711600302",
                    "speaker": "Player",
                    "text": "莱依拉？"
                },
                {
                    "id": "711600303",
                    "speaker": "莱依拉",
                    "text": "#欸？{NICKNAME}，你也在璃月啊，海灯节快乐…",
                    "choices": [
                        {
                            "id": "711600316",
                            "text": "我也放好霄灯啦。",
                            "response": [
                                {
                                    "id": "711600317",
                                    "speaker": "莱依拉",
                                    "text": "呜哇…你放飞的霄灯飞得好高。但话说回来，霄灯究竟能飞多高呢…"
                                },
                                {
                                    "id": "711600318",
                                    "speaker": "莱依拉",
                                    "text": "对了，只要套用那道公式应该就能算出来，草稿纸…草稿纸…"
                                },
                                {
                                    "id": "711600304",
                                    "speaker": "Player",
                                    "text": "莱依拉是来璃月玩的？"
                                },
                                {
                                    "id": "711600306",
                                    "speaker": "莱依拉",
                                    "text": "嗯，是导师让我过来的，说多参与民俗活动，也许可以找到一些学术研究上的灵感。"
                                },
                                {
                                    "id": "711600307",
                                    "speaker": "莱依拉",
                                    "text": "不过，我做的不是星图么？和民俗活动应该没什么关系吧…"
                                },
                                {
                                    "id": "711600308",
                                    "speaker": "莱依拉",
                                    "text": "但我还没来得及说，导师就给我买好了票，还亲自把我送到了船上…"
                                },
                                {
                                    "id": "711600309",
                                    "speaker": "莱依拉",
                                    "text": "我刚下船，就被一个大姐姐叫住了，说可以免费送我一架霄灯骨架，还说放霄灯可以带来一整年的好运。"
                                },
                                {
                                    "id": "711600310",
                                    "speaker": "莱依拉",
                                    "text": "唉，我也不用一整年都交好运，只需要在提交论文的那段时间里有点好运气就行…"
                                },
                                {
                                    "id": "711600311",
                                    "speaker": "莱依拉",
                                    "text": "所以，我就按照那个姐姐教的方法，自己做了一盏霄灯…"
                                },
                                {
                                    "id": "711600313",
                                    "speaker": "Player",
                                    "text": "莱依拉一定会有好运气的！"
                                },
                                {
                                    "id": "711600314",
                                    "speaker": "莱依拉",
                                    "text": "谢谢你。接下来我是不是该去放飞霄灯了？对了，还要写上心愿…"
                                },
                                {
                                    "id": "711600315",
                                    "speaker": "Black Screen",
                                    "text": "与莱依拉一同放飞了霄灯…"
                                }
                            ]
                        },
                        {
                            "id": "711600304",
                            "text": "莱依拉是来璃月玩的？"
                        }
                    ]
                }
            ]
        },
