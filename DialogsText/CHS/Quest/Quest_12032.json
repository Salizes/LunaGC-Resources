{
    "quest": {
        "id": "12032",
        "title": "(TEST)雷军二大世界残留对话$HIDDEN",
        "description": "",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "UI_ChapterIcon_Shougun",
            "id": "2027",
            "num": "天下人之章 第二幕",
            "title": "须臾百梦"
        },
        "total_dialogue_lines": 28,
        "total_speaker_counts": {
            "Player": 6,
            "八重神子": 7,
            "影": 15
        }
    },
    "talks": [
        {
            "id": "1203201",
            "objective": "",
            "dialogues": [
                {
                    "id": "120320101",
                    "speaker": "影",
                    "text": "接下来，稻妻一定会迎来更多挑战，不过我已经做好准备了。",
                    "choices": [
                        {
                            "id": "120320102",
                            "text": "关于「挑战」…",
                            "response": [
                                {
                                    "id": "120320103",
                                    "speaker": "影",
                                    "text": "解除锁国令难免牵连众多，不能说只有积极效应而毫无损害。"
                                },
                                {
                                    "id": "120320104",
                                    "speaker": "影",
                                    "text": "比如可预见的，外界对稻妻商业造成冲击等问题。这些都是接下来我会着手处理的事。"
                                },
                                {
                                    "id": "120320105",
                                    "speaker": "八重神子",
                                    "text": "影真是认真啊。我考虑的只有，以后鸣神大社是不是可以卖门票了之类的事。"
                                },
                                {
                                    "id": "120320106",
                                    "speaker": "影",
                                    "text": "你啊…"
                                }
                            ]
                        },
                        {
                            "id": "120320107",
                            "text": "关于神明的注视…",
                            "response": [
                                {
                                    "id": "120320108",
                                    "speaker": "影",
                                    "text": "真的视线一直在稻妻人民身上。我曾以为，这是她的责任。"
                                },
                                {
                                    "id": "120320109",
                                    "speaker": "影",
                                    "text": "可现在看来，这种注视饱含了赏识与期待，除了责任，她一定也乐在其中。她是非常爱人的。"
                                },
                                {
                                    "id": "120320110",
                                    "speaker": "八重神子",
                                    "text": "过去的人值得注视，现在与未来的人亦如此。"
                                },
                                {
                                    "id": "120320111",
                                    "speaker": "影",
                                    "text": "嗯，我不会再忽视他们的热情与梦想了。"
                                }
                            ]
                        },
                        {
                            "id": "120320112",
                            "text": "关于几百年的战斗…",
                            "response": [
                                {
                                    "id": "120320113",
                                    "speaker": "影",
                                    "text": "坦白说，那是一场看不到尽头的折磨。"
                                },
                                {
                                    "id": "120320114",
                                    "speaker": "影",
                                    "text": "面对无尽的战斗，必须时刻集中注意力。稍有松懈，将军的刀就会要了我的命。"
                                },
                                {
                                    "id": "120320115",
                                    "speaker": "影",
                                    "text": "可以说，若是没有此前的经历与见闻，没有刀中之力，我定会落败。"
                                },
                                {
                                    "id": "120320116",
                                    "speaker": "影",
                                    "text": "这之中，也有你的功劳。"
                                }
                            ]
                        },
                        {
                            "id": "120320117",
                            "text": "关于神樱树的伤痕…",
                            "response": [
                                {
                                    "id": "120320118",
                                    "speaker": "影",
                                    "text": "放心吧，我没有忘记，我会叮嘱天领奉行与社奉行。"
                                },
                                {
                                    "id": "120320119",
                                    "speaker": "影",
                                    "text": "除了魔物的威胁，我还在担心，神樱树中会不会逸散出其他东西。"
                                },
                                {
                                    "id": "120320120",
                                    "speaker": "八重神子",
                                    "text": "那可不好说，除了回忆，地脉里的东西还多着呢。"
                                },
                                {
                                    "id": "120320121",
                                    "speaker": "影",
                                    "text": "你也清楚的话，就不要偷懒。"
                                }
                            ]
                        },
                        {
                            "id": "120320122",
                            "text": "八重神子说她的神明就…",
                            "response": [
                                {
                                    "id": "120320123",
                                    "speaker": "八重神子",
                                    "text": "哎呀？是谁在胡言乱语当面造谣？"
                                },
                                {
                                    "id": "120320124",
                                    "speaker": "八重神子",
                                    "text": "有些话，是不可以随便复述的哦。"
                                },
                                {
                                    "id": "120320125",
                                    "speaker": "八重神子",
                                    "text": "出卖我要付出什么代价，你不会想知道的。把我说的话当成我和你的秘密就好，明白了吗？"
                                },
                                {
                                    "id": "120320126",
                                    "speaker": "影",
                                    "text": "你们在讨论什么？"
                                },
                                {
                                    "id": "120320127",
                                    "speaker": "八重神子",
                                    "text": "没什么，想吃油豆腐了。"
                                }
                            ]
                        },
                        {
                            "id": "120320128",
                            "text": "没其他想问的了。"
                        }
                    ]
                }
            ]
        }
    ]
}