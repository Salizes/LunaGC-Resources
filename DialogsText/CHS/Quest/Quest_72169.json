    "talks": [
        {
            "id": "7216901",
            "objective": "（test）接取料理王二阶段$HIDDEN",
            "dialogues": [
                {
                    "id": "721690101",
                    "speaker": "旭东",
                    "text": "这道菜的名字还真是，很有朱莉的风格。"
                },
                {
                    "id": "721690102",
                    "speaker": "芭尔瓦涅",
                    "text": "嗯，第一次看的时候，我还以为是蒙德的菜，没想到居然是稻妻本土的特色菜…"
                },
                {
                    "id": "721690103",
                    "speaker": "朱莉",
                    "text": "名字都这么好听，肯定也很好吃，旭东，拜托啦！",
                    "choices": [
                        {
                            "id": "721690104",
                            "text": "又见面了。",
                            "response": [
                                {
                                    "id": "721690106",
                                    "speaker": "旭东",
                                    "text": "喔！旅行者，嘿嘿，我就说嘛，我们肯定还会再见面的。"
                                },
                                {
                                    "id": "721690107",
                                    "speaker": "朱莉",
                                    "text": "旭东刚从城里拿到的一份新食谱喔！叫做「蟹黄壳壳烧」，怎么样，名字很好听吧？"
                                },
                                {
                                    "id": "721690108",
                                    "speaker": "旭东",
                                    "text": "这道菜做起来倒也不复杂。但这道菜需要很多螃蟹…"
                                },
                                {
                                    "id": "721690109",
                                    "speaker": "旭东",
                                    "text": "我已经准备了一些普通的螃蟹，正准备找一些…特别的螃蟹。"
                                },
                                {
                                    "id": "721690110",
                                    "speaker": "Player",
                                    "text": "特别的螃蟹？"
                                },
                                {
                                    "id": "721690111",
                                    "speaker": "旭东",
                                    "text": "没错，就是盘踞在那棵雷樱树下的螃蟹！"
                                },
                                {
                                    "id": "721690112",
                                    "speaker": "芭尔瓦涅",
                                    "text": "你不如直接说…被雷劈过的螃蟹…"
                                },
                                {
                                    "id": "721690113",
                                    "speaker": "旭东",
                                    "text": "哈哈哈，总之我很好奇啦，生活在这种环境下的螃蟹…吃起来会是什么口感。"
                                },
                                {
                                    "id": "721690114",
                                    "speaker": "旭东",
                                    "text": "不过…因为那棵雷樱树旁边落雷不断，我们也不敢靠近…"
                                },
                                {
                                    "id": "721690115",
                                    "speaker": "芭尔瓦涅",
                                    "text": "我的那本书上说…和之前一样，要先去触摸一下「雷樱枝条」，让一种叫做「雷种子」的东西附着在你身上…"
                                },
                                {
                                    "id": "721690116",
                                    "speaker": "芭尔瓦涅",
                                    "text": "这样的话，你就不会被雷樱树旁边的落雷劈到…"
                                },
                                {
                                    "id": "721690117",
                                    "speaker": "芭尔瓦涅",
                                    "text": "但那棵树旁边落雷的声势你也看见了，就凭这么粗略的记录，我可不敢去尝试…"
                                },
                                {
                                    "id": "721690118",
                                    "speaker": "旭东",
                                    "text": "但只要跑得够快，应该就没问题了吧？"
                                },
                                {
                                    "id": "721690119",
                                    "speaker": "芭尔瓦涅",
                                    "text": "我说你啊…你跑得再快，能有雷落下来的速度快吗？！"
                                },
                                {
                                    "id": "721690120",
                                    "speaker": "朱莉",
                                    "text": "那我们就在外面，用树枝什么的把螃蟹夹出来…"
                                },
                                {
                                    "id": "721690121",
                                    "speaker": "芭尔瓦涅",
                                    "text": "要我说，我们干脆直接在旁边挖一条沟渠，把水和螃蟹一起引出来好了。"
                                },
                                {
                                    "id": "721690122",
                                    "speaker": "旭东",
                                    "text": "哈哈哈…大家都在各抒己见，不错不错。"
                                },
                                {
                                    "id": "721690123",
                                    "speaker": "旭东",
                                    "text": "旅行者，如果你愿意的话，也去试试抓一下那棵雷樱树旁的螃蟹吧。"
                                },
                                {
                                    "id": "721690124",
                                    "speaker": "旭东",
                                    "text": "如果抓到的话，就拿来给我，我会做一顿大餐好好感谢你的。"
                                },
                                {
                                    "id": "721690125",
                                    "speaker": "旭东",
                                    "text": "哦对了，稍等一下…这些诱饵你拿好。"
                                },
                                {
                                    "id": "721690126",
                                    "speaker": "旭东",
                                    "text": "如果你要去那边抓螃蟹的话，就先用这些诱饵来吸引它们吧。"
                                },
                                {
                                    "id": "721690127",
                                    "speaker": "旭东",
                                    "text": "这样的话，你抓螃蟹的时候应该也会省事一些。"
                                },
                                {
                                    "id": "721690128",
                                    "speaker": "旭东",
                                    "text": "在雷樱树旁生活的螃蟹…唔，不知道味道到底如何…"
                                }
                            ]
                        },
                        {
                            "id": "721690105",
                            "text": "又是什么好吃的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7216905",
            "objective": "在雷樱树旁放置诱饵",
            "dialogues": [
                {
                    "id": "721690501",
                    "speaker": "芭尔瓦涅",
                    "text": "我的那本书上说，只要去触摸一下「雷樱枝条」，就不会被雷樱树旁边的落雷劈到…"
                },
                {
                    "id": "721690502",
                    "speaker": "芭尔瓦涅",
                    "text": "但那棵树旁边落雷的声势你也看见了，就凭这么粗略的记录，我可不敢去尝试…"
                }
            ]
        },
        {
            "id": "7216902",
            "objective": "在雷樱树旁捕捉螃蟹",
            "dialogues": [
                {
                    "id": "721690201",
                    "speaker": "旭东",
                    "text": "怎么样旅行者，你的收获如何？"
                },
                {
                    "id": "721690202",
                    "speaker": "旭东",
                    "text": "喔！这只螃蟹看起来不错，你挺厉害的嘛。"
                },
                {
                    "id": "721690203",
                    "speaker": "旭东",
                    "text": "好了，既然材料都齐全了，那就开始准备烹饪吧。"
                },
                {
                    "id": "721690204",
                    "speaker": "旭东",
                    "text": "我先准备一下，旅行者，你再稍等一会吧。"
                }
            ]
        },
        {
            "id": "7216903",
            "objective": "将捕捉到的螃蟹交给旭东",
            "dialogues": []
        },
        {
            "id": "7216904",
            "objective": "与旭东对话",
            "dialogues": [
                {
                    "id": "721690301",
                    "speaker": "旭东",
                    "text": "壳壳烧…为什么要叫壳壳烧呢…"
                },
                {
                    "id": "721690302",
                    "speaker": "旭东",
                    "text": "算了，还是先做出来再说吧。"
                },
                {
                    "id": "721690303",
                    "speaker": "旭东",
                    "text": "完成了！这就是「蟹黄壳壳烧」了。"
                },
                {
                    "id": "721690304",
                    "speaker": "朱莉",
                    "text": "我要一个！嗯…就这个好了！"
                },
                {
                    "id": "721690305",
                    "speaker": "芭尔瓦涅",
                    "text": "给我个小一点的，太大的我可吃不完…"
                },
                {
                    "id": "721690306",
                    "speaker": "旭东",
                    "text": "喏，这一份是你的，旅行者。"
                },
                {
                    "id": "721690307",
                    "speaker": "旭东",
                    "text": "还有这份「蟹黄壳壳烧」的制作方法，我也给你抄了一份。"
                },
                {
                    "id": "721690308",
                    "speaker": "旭东",
                    "text": "这道菜做起来倒还算简单，你有空的话也自己试试看吧。"
                },
                {
                    "id": "721690311",
                    "speaker": "旭东",
                    "text": "接下来我们准备去<color=#00E1FFFF>八酝岛</color>附近转转，如果你有空的话，可以来找我们。"
                },
                {
                    "id": "721690309",
                    "speaker": "旭东",
                    "text": "好了，我也得去吃一点了…"
                },
                {
                    "id": "721690310",
                    "speaker": "旭东",
                    "text": "喂！朱莉！给我留一个，别吃完了啊！"
                }
            ]
        },
        {
            "id": "7216904",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721690401",
                    "speaker": "芭尔瓦涅",
                    "text": "雷种子怎么有这么多用途呢…真是奇怪…"
                }
            ]
        },
        {
            "id": "7216906",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721690601",
                    "speaker": "朱莉",
                    "text": "「蟹黄壳壳烧」…到底是什么味道呢…"
                }
            ]
        },
        {
            "id": "7216907",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721690701",
                    "speaker": "朱莉",
                    "text": "这附近有没有比较硬的树枝呢…"
                }
            ]
        },
        {
            "id": "7216908",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721690801",
                    "speaker": "旭东",
                    "text": "唔…挖一条沟渠是不是费时太长了点呢…"
                }
            ]
        }
    ]
}