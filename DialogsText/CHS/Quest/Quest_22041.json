    "talks": [
        {
            "id": "2204101",
            "objective": "与寝子对话",
            "dialogues": [
                {
                    "id": "220410101",
                    "speaker": "「寝子」",
                    "text": "汝等来了啊，来得正好，奴家正在发愁呢。"
                },
                {
                    "id": "220410102",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "220410103",
                    "speaker": "「寝子」",
                    "text": "汝等还记得「昆布丸」这个孩子吧？"
                },
                {
                    "id": "220410104",
                    "speaker": "「寝子」",
                    "text": "这孩子去附近玩了之后，到现在也没有回来，奴家很担心。"
                },
                {
                    "id": "220410105",
                    "speaker": "「寝子」",
                    "text": "拜托汝等，去附近找找「昆布丸」，再把它带回来吧。",
                    "choices": [
                        {
                            "id": "220410106",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "220410107",
                                    "speaker": "「寝子」",
                                    "text": "那就拜托汝了，快点找到「昆布丸」，把它带回神社来吧。"
                                }
                            ]
                        },
                        {
                            "id": "220410108",
                            "text": "只有它跑出去了吗？",
                            "response": [
                                {
                                    "id": "220410109",
                                    "speaker": "「寝子」",
                                    "text": "只有这孩子…也许是上次奴家训斥了它，让它不高兴了吧。"
                                },
                                {
                                    "id": "220410110",
                                    "speaker": "「寝子」",
                                    "text": "这孩子，为什么总是这么不听话呢…"
                                },
                                {
                                    "id": "220410111",
                                    "speaker": "「寝子」",
                                    "text": "拜托汝了，快点找到「昆布丸」，把它带回神社来吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2204102",
            "objective": "寻找「昆布丸」",
            "dialogues": [
                {
                    "id": "220410201",
                    "speaker": "「寝子」",
                    "text": "拜托汝了，找到「昆布丸」后，就把它带回神社来吧。"
                }
            ]
        },
        {
            "id": "2204103",
            "objective": "与寝子对话",
            "dialogues": [
                {
                    "id": "220410301",
                    "speaker": "「寝子」",
                    "text": "怎么样，汝等找到昆布丸了吗？"
                },
                {
                    "id": "220410302",
                    "speaker": "Player",
                    "text": "已经找到了。"
                },
                {
                    "id": "220410303",
                    "speaker": "派蒙",
                    "text": "欸！它又跑不见了！",
                    "choices": [
                        {
                            "id": "220410304",
                            "text": "我这就接着抓它回来！",
                            "response": [
                                {
                                    "id": "220410306",
                                    "speaker": "「寝子」",
                                    "text": "汝等，不用去找它了。"
                                },
                                {
                                    "id": "220410307",
                                    "speaker": "「寝子」",
                                    "text": "这孩子果然还在和奴家赌气…等会奴家自己再去教训一下那孩子。"
                                },
                                {
                                    "id": "220410308",
                                    "speaker": "「寝子」",
                                    "text": "明明都快成为一只大猫了，怎么还是这么任性，到时候要是惊到了来神社的人类可怎么办。"
                                },
                                {
                                    "id": "220410309",
                                    "speaker": "「寝子」",
                                    "text": "喔，这些东西给汝等，谢谢汝等帮忙了。"
                                },
                                {
                                    "id": "220410310",
                                    "speaker": "「寝子」",
                                    "text": "唉，为什么这孩子不能和「阿饭」一样听话呢…"
                                }
                            ]
                        },
                        {
                            "id": "220410305",
                            "text": "我今天还不信了…"
                        }
                    ]
                }
            ]
        }
    ]
}