    "talks": [
        {
            "id": "2051101",
            "objective": "与安东尼对话",
            "dialogues": [
                {
                    "id": "205110101",
                    "speaker": "安东尼",
                    "text": "这药方，真会管用吗…"
                },
                {
                    "id": "205110102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "205110103",
                    "speaker": "安东尼",
                    "text": "旅行者！你来得正好，我正发愁呢，"
                },
                {
                    "id": "205110104",
                    "speaker": "安东尼",
                    "text": "是这样，你还记得我妹妹安娜吧，她一直生着病，之前怎么治也没起色…"
                },
                {
                    "id": "205110105",
                    "speaker": "安东尼",
                    "text": "但是我听说璃月港里有一位神医，很擅长解决疑难杂症，就托人去求他开药方。"
                },
                {
                    "id": "205110106",
                    "speaker": "安东尼",
                    "text": "虽然药方里的材料都很奇怪…但也只有试一试了…"
                },
                {
                    "id": "205110107",
                    "speaker": "安东尼",
                    "text": "呃，我看看…你能帮我去找一份「被草史莱姆吞下去过的树莓」吗？",
                    "choices": [
                        {
                            "id": "205110108",
                            "text": "真的有这种东西吗？",
                            "response": [
                                {
                                    "id": "205110109",
                                    "speaker": "安东尼",
                                    "text": "我也不知道啊！草史莱姆真的会吃树莓吗…"
                                },
                                {
                                    "id": "205110110",
                                    "speaker": "安东尼",
                                    "text": "就，就拜托你了！我知道一个地方有草史莱姆出没，也长着树莓。"
                                },
                                {
                                    "id": "205110111",
                                    "speaker": "安东尼",
                                    "text": "拜托你去看看吧，希望能找到…"
                                }
                            ]
                        },
                        {
                            "id": "205110112",
                            "text": "庸医误事。",
                            "response": [
                                {
                                    "id": "205110113",
                                    "speaker": "安东尼",
                                    "text": "果然你也这么觉得吗？但是，我也是真的没办法了。"
                                },
                                {
                                    "id": "205110114",
                                    "speaker": "安东尼",
                                    "text": "我知道一个地方有很多草史莱姆，也长着树莓，拜托你去看看吧。"
                                },
                                {
                                    "id": "205110115",
                                    "speaker": "安东尼",
                                    "text": "然后，做出来的药我会先吃下去试试。无论如何，不能让安娜的身体再坏下去了…"
                                }
                            ]
                        },
                        {
                            "id": "205110116",
                            "text": "找不到的话，我就抓个草史莱姆给你。",
                            "response": [
                                {
                                    "id": "205110117",
                                    "speaker": "安东尼",
                                    "text": "咦…咦？你是要我亲手把树莓塞给草史莱姆吃吗…"
                                },
                                {
                                    "id": "205110118",
                                    "speaker": "安东尼",
                                    "text": "你就饶了我吧，我上次给安娜采药的时候，被一群草史莱姆一直追到了清泉镇里…"
                                },
                                {
                                    "id": "205110119",
                                    "speaker": "安东尼",
                                    "text": "我知道一个地方有很多草史莱姆，也长着树莓，拜托你去看看吧，希望会有发现…"
                                },
                                {
                                    "id": "205110120",
                                    "speaker": "安东尼",
                                    "text": "但是…如，如果实在不行，为了安娜…你，你就抓个草史莱姆回来吧！我能行！我一定能行…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2051102",
            "objective": "查看树莓的状况",
            "dialogues": [
                {
                    "id": "205110201",
                    "speaker": "安东尼",
                    "text": "你找到东西了吗？"
                },
                {
                    "id": "205110202",
                    "speaker": "Player",
                    "text": "还没有。"
                },
                {
                    "id": "205110203",
                    "speaker": "安东尼",
                    "text": "拜托你了，请尽快找到吧，安娜的病不能再耽搁了…"
                }
            ]
        },
