        {
            "id": "7306307",
            "objective": "使用「苦舍桓」开辟通路",
            "dialogues": []
        },
        {
            "id": "7306308",
            "objective": "击败蕈兽",
            "dialogues": []
        },
        {
            "id": "7306309",
            "objective": "探索山洞",
            "dialogues": []
        },
        {
            "id": "7306335",
            "objective": "继续探索山洞",
            "dialogues": [
                {
                    "id": "730633501",
                    "speaker": "派蒙",
                    "text": "呜哇！噗…咳咳！咳咳咳！！怎么…怎么突然冲出好多水！差点就被淹死啦！！",
                    "choices": [
                        {
                            "id": "730633502",
                            "text": "好冷。",
                            "response": [
                                {
                                    "id": "730633506",
                                    "speaker": "兰迦鲁",
                                    "text": "因为「呿波境」是「钵参花」的梦，当「钵参花」醒来，梦就会散入空气里啦。"
                                },
                                {
                                    "id": "730633507",
                                    "speaker": "兰迦鲁",
                                    "text": "所以承受不住水的重量，水就会冲出来！呜！哗啦啦！！清清凉凉的。"
                                },
                                {
                                    "id": "730633508",
                                    "speaker": "派蒙",
                                    "text": "哼…要是被冲走就回不来了，看你还会不会说这种风凉话啦！"
                                },
                                {
                                    "id": "730633509",
                                    "speaker": "兰迦鲁",
                                    "text": "嘿嘿，兰迦鲁知道那菈和白飞飞在哪里，草木也可以告诉我你们去了哪，不会回不来的！"
                                },
                                {
                                    "id": "730633510",
                                    "speaker": "兰迦鲁",
                                    "text": "既然已经有了「钵参花」，接下来还需要找到「须罗蕈」和「耶然草」，才可以拜托兰纳迦配制「兰赫玛」！",
                                    "choices": [
                                        {
                                            "id": "730633511",
                                            "text": "我们已经拿到了「须罗蕈」。",
                                            "response": [
                                                {
                                                    "id": "730633512",
                                                    "speaker": "兰迦鲁",
                                                    "text": "#嗯，谢谢那菈{NICKNAME}和白飞飞！如果是兰纳迦的话，一定会说：「很像，和那菈法留纳…」"
                                                },
                                                {
                                                    "id": "730633513",
                                                    "speaker": "兰迦鲁",
                                                    "text": "#嘿嘿，就是说，那菈{NICKNAME}和白飞飞很厉害！"
                                                },
                                                {
                                                    "id": "730633514",
                                                    "speaker": "兰迦鲁",
                                                    "text": "那就去找到伙伴兰纳迦吧，他一定还有事情要托付给你！他就在无郁稠林那边！"
                                                },
                                                {
                                                    "id": "730633515",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯！我们明白啦！"
                                                },
                                                {
                                                    "id": "730633521",
                                                    "speaker": "兰迦鲁",
                                                    "text": "接下来…我也要去无郁稠林，准备「兰赫玛」的仪式啦，我们在那里再见吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730633516",
                                            "text": "关于兰纳迦",
                                            "response": [
                                                {
                                                    "id": "730633517",
                                                    "speaker": "兰迦鲁",
                                                    "text": "兰纳迦是我们三个里面岁数最大，也是最有意思的伙伴！他会说好多好玩的话，知道好多那菈的事情。"
                                                },
                                                {
                                                    "id": "730633518",
                                                    "speaker": "兰迦鲁",
                                                    "text": "唔，不过他也忘记了很多那菈的事情就是啦…我们三个都有很多记不住的事情。有的像风中的花粉一样散掉了，有的模糊了…"
                                                },
                                                {
                                                    "id": "730633519",
                                                    "speaker": "兰迦鲁",
                                                    "text": "但是，兰纳迦知道的，兰纳迦能记住的，总是最多的。所以我们都喜欢找他玩。"
                                                },
                                                {
                                                    "id": "730633520",
                                                    "speaker": "兰迦鲁",
                                                    "text": "他就在无郁稠林的花园里，在那里看守着「无郁夷摩」。去那里一定能找到他的！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730633503",
                            "text": "好湿。"
                        },
                        {
                            "id": "730633504",
                            "text": "好吵…",
                            "response": [
                                {
                                    "id": "730633505",
                                    "speaker": "派蒙",
                                    "text": "喂！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7306310",
            "objective": "击败蕈兽",
            "dialogues": []
        },
        {
            "id": "7306311",
            "objective": "调查蕈兽围绕的符文",
            "dialogues": [
                {
                    "id": "730631101",
                    "speaker": "兰迦鲁",
                    "text": "就在这里啦，你看！"
                },
                {
                    "id": "730631102",
                    "speaker": "派蒙",
                    "text": "这是什么呀…看起来像是小孩子画的呢…看不明白…"
                },
                {
                    "id": "730631103",
                    "speaker": "兰迦鲁",
                    "text": "这是记忆呀！兰那罗的记忆可以存在块茎里，存在种子里，可以在叶脉里流动…但那菈的记忆是刻在石头里的！"
                },
                {
                    "id": "730631104",
                    "speaker": "兰迦鲁",
                    "text": "嘿嘿，每当月亮爬到天上最高的地方，我们三个兰那罗就会来到这里，然后让自己像那菈一样记得过去的「故事」！"
                },
                {
                    "id": "730631105",
                    "speaker": "派蒙",
                    "text": "唔…那你说，这上面画的是什么呀？"
                },
                {
                    "id": "730631106",
                    "speaker": "兰迦鲁",
                    "text": "不是画，是符文啦…是流光的河，上面是盛开着星星的花茎。河与星星为我们送来了那菈中的勇者们。"
                },
                {
                    "id": "730631107",
                    "speaker": "兰迦鲁",
                    "text": "草木的大主人让勇者那菈心中生出智慧的芽，又让兰那罗引导他们…去往水光闪闪的洞穴。"
                },
                {
                    "id": "730631108",
                    "speaker": "兰迦鲁",
                    "text": "嗯…就这些啦。附近还有其他的符文，我们边走边看吧。"
                }
            ]
        },
