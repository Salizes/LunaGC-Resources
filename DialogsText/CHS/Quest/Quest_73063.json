    "talks": [
        {
            "id": "7306330",
            "objective": "寻找兰迦鲁",
            "dialogues": []
        },
        {
            "id": "7306305",
            "objective": "与突然相遇的兰那罗对话",
            "dialogues": [
                {
                    "id": "730630501",
                    "speaker": "？？？",
                    "text": "金色的那菈和白色的飞飞，你们来啦！我是兰迦鲁！"
                },
                {
                    "id": "730630502",
                    "speaker": "兰迦鲁",
                    "text": "草木和蘑菇告诉我你们会来，我已经等了很久啦！"
                },
                {
                    "id": "730630503",
                    "speaker": "派蒙",
                    "text": "咦…？你认识我们吗…？你有什么事情找我们呀？"
                },
                {
                    "id": "730630504",
                    "speaker": "兰迦鲁",
                    "text": "有事情！有很大很大的事情哦！！"
                },
                {
                    "id": "730630505",
                    "speaker": "派蒙",
                    "text": "哇，别激动啦，跟我们慢慢说吧。"
                },
                {
                    "id": "730630506",
                    "speaker": "兰迦鲁",
                    "text": "嗯，「无留陀」在长大，越长越大，森林都不敢说话，不敢呼吸…因为「无留陀」在，「无留陀」会吃掉他们…"
                },
                {
                    "id": "730630507",
                    "speaker": "兰迦鲁",
                    "text": "为了阻止「无留陀」，兰纳迦在忙「兰赫玛」的仪式。但是「兰赫玛」…还缺少「钵参花」呢。"
                },
                {
                    "id": "730630508",
                    "speaker": "派蒙",
                    "text": "这样啊…可是，「钵参花」从哪里找呢？",
                    "choices": [
                        {
                            "id": "730630509",
                            "text": "派蒙这次居然没念错名字。",
                            "response": [
                                {
                                    "id": "730630510",
                                    "speaker": "派蒙",
                                    "text": "哼哼，钵！参！花！厉害吧！"
                                },
                                {
                                    "id": "730630512",
                                    "speaker": "兰迦鲁",
                                    "text": "「钵参花」在生着蘑菇的地方，很多很多个月亮升起和落下之前，那里曾是那菈的家。"
                                },
                                {
                                    "id": "730630513",
                                    "speaker": "兰迦鲁",
                                    "text": "但是后来…湿湿的土掩埋了那菈的梦，他们的记忆生出了新的草木，一代又一代地干枯又复生…我们要去的，就是这样的地方呀。"
                                },
                                {
                                    "id": "730630514",
                                    "speaker": "派蒙",
                                    "text": "唔…虽然听不太明白，但总觉得很可怕。"
                                },
                                {
                                    "id": "730630515",
                                    "speaker": "兰迦鲁",
                                    "text": "不可怕，不可怕。那菈害怕的地方，草木喜欢。所以那里很多草木。"
                                },
                                {
                                    "id": "730630516",
                                    "speaker": "兰迦鲁",
                                    "text": "那里有那菈们和兰那罗一起留下来的符文，为了不忘记，为了忘记后可以查看。去那里，可以找到「钵参花」！"
                                },
                                {
                                    "id": "730630517",
                                    "speaker": "派蒙",
                                    "text": "唔…那我们就一起去他说的地方吧！"
                                },
                                {
                                    "id": "730630518",
                                    "speaker": "兰迦鲁",
                                    "text": "对了、对了！还有，「苦舍桓」呀！"
                                },
                                {
                                    "id": "730630519",
                                    "speaker": "兰迦鲁",
                                    "text": "有「苦舍桓」的话，兰那罗就有力气，有力气，就能给大家开路！兰迦鲁可以打碎石块！哈！哈！轰！"
                                },
                                {
                                    "id": "730630520",
                                    "speaker": "派蒙",
                                    "text": "兰迦鲁个子小小，力气大大呢！"
                                },
                                {
                                    "id": "730630521",
                                    "speaker": "兰迦鲁",
                                    "text": "嘿嘿，没错，力气大大！嗯…不过要是有绿色藤蔓的石块才行啦，一整个的话…没有裂隙，就没有力气打破。",
                                    "choices": [
                                        {
                                            "id": "730630522",
                                            "text": "「苦舍桓」是什么？",
                                            "response": [
                                                {
                                                    "id": "730630523",
                                                    "speaker": "兰迦鲁",
                                                    "text": "「苦舍桓」是记忆和梦的容器，胖胖的，苦苦的，里面满是力量。是开花的植物结出的果，也是新的种子，有全新的生命。"
                                                },
                                                {
                                                    "id": "730630524",
                                                    "speaker": "兰迦鲁",
                                                    "text": "这个，给你。请好好珍惜。兰那罗只会把它托付给重要的对方，所以…唔，你们不要吃掉啦！"
                                                },
                                                {
                                                    "id": "730630527",
                                                    "speaker": "兰迦鲁",
                                                    "text": "唔…月亮来了又去，已经不剩下很多了…会走的蕈类一直在里面，越来越多…很不好，我们要尽快才行。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730630525",
                                            "text": "「钵参花」是什么？",
                                            "response": [
                                                {
                                                    "id": "730630526",
                                                    "speaker": "兰迦鲁",
                                                    "text": "「钵参花」是兰那罗的好伙伴，是为了成就「兰赫玛」而生的花朵，是灵药的源泉。唔…只有牺牲汁液，才能提炼「兰赫玛」。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730630511",
                            "text": "应该很不好找。"
                        }
                    ]
                }
            ]
        },
