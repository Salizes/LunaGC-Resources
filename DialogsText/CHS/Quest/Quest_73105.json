    "talks": [
        {
            "id": "7310501",
            "objective": "与妮露法对话$HIDDEN",
            "dialogues": [
                {
                    "id": "731050101",
                    "speaker": "妮露法",
                    "text": "爱拉尼…你到底跑到哪里去了…"
                },
                {
                    "id": "731050102",
                    "speaker": "Player",
                    "text": "爱拉尼？"
                },
                {
                    "id": "731050103",
                    "speaker": "派蒙",
                    "text": "欸？这名字…我记得，是那个总是在写论文的大姐姐？我们在海祇岛见过的那位。"
                },
                {
                    "id": "731050104",
                    "speaker": "派蒙",
                    "text": "对喔！她说过她是从教令院出去取材的，现在应该已经回去了吧。"
                },
                {
                    "id": "731050105",
                    "speaker": "派蒙",
                    "text": "不过…那个人好像很焦急的样子…我们过去问问她发生了什么吧。"
                },
                {
                    "id": "731050106",
                    "speaker": "派蒙",
                    "text": "如果爱拉尼真的回了教令院，我们也正好过去打个招呼呢。"
                },
                {
                    "id": "731050107",
                    "speaker": "Player",
                    "text": "你好，关于爱拉尼…"
                },
                {
                    "id": "731050108",
                    "speaker": "妮露法",
                    "text": "你是冒险家协会派来的冒险家吗？！请问你找到爱拉尼的下落了吗？"
                },
                {
                    "id": "731050109",
                    "speaker": "妮露法",
                    "text": "我知道我催了好多次，真的很不好意思，但我真的很担心她，我…"
                },
                {
                    "id": "731050110",
                    "speaker": "派蒙",
                    "text": "呜哇，你冷静点，我们不是冒险家协会派来的啦，我们只是路过…"
                },
                {
                    "id": "731050111",
                    "speaker": "Player",
                    "text": "请问您是…"
                },
                {
                    "id": "731050112",
                    "speaker": "妮露法",
                    "text": "你们不是冒险家吗？抱歉，因为协会那边一直没消息，我…我太着急了…"
                },
                {
                    "id": "731050149",
                    "speaker": "Black Screen",
                    "text": "讲述了至今为止与爱拉尼一同经历的事…"
                },
                {
                    "id": "731050113",
                    "speaker": "妮露法",
                    "text": "原来您就是爱拉尼一直提到的那位旅行者…"
                },
                {
                    "id": "731050114",
                    "speaker": "妮露法",
                    "text": "我叫妮露法，是教令院的学者…你们应该也能看出来，对吧？"
                },
                {
                    "id": "731050115",
                    "speaker": "妮露法",
                    "text": "虽然说是学者，但我现在大部分精力都放在了领着学生做研究上。"
                },
                {
                    "id": "731050116",
                    "speaker": "妮露法",
                    "text": "爱拉尼就是我的学生之一，这孩子的论文一直都写得很艰难…"
                },
                {
                    "id": "731050117",
                    "speaker": "Player",
                    "text": "你，你就是爱拉尼的那位导师？"
                },
                {
                    "id": "731050118",
                    "speaker": "派蒙",
                    "text": "爱拉尼小姐说，她的好多篇论文都被导师说不合格，不得不重写…"
                },
                {
                    "id": "731050119",
                    "speaker": "派蒙",
                    "text": "不对不对，现在不是说这些的时候，爱拉尼小姐怎么了呀？"
                },
                {
                    "id": "731050120",
                    "speaker": "妮露法",
                    "text": "这孩子…这孩子失踪了。"
                },
                {
                    "id": "731050121",
                    "speaker": "妮露法",
                    "text": "前段时间，爱拉尼从稻妻带着一篇论文兴冲冲地回来，论文的内容是研究海祇岛的民俗文化…",
                    "choices": [
                        {
                            "id": "731050122",
                            "text": "爱拉尼研究得很认真。",
                            "response": [
                                {
                                    "id": "731050124",
                                    "speaker": "妮露法",
                                    "text": "我能看出来，这篇论文写得很好，各方面都是高水准…"
                                },
                                {
                                    "id": "731050125",
                                    "speaker": "妮露法",
                                    "text": "但是…但是她回来得太晚了啊！之前我让她把初稿提前寄给我，却一直都没收到回信。"
                                },
                                {
                                    "id": "731050126",
                                    "speaker": "妮露法",
                                    "text": "等她带着全版论文回来的时候，早就有人提交了和她研究内容一模一样的论文，都已经通过预审了！"
                                },
                                {
                                    "id": "731050127",
                                    "speaker": "妮露法",
                                    "text": "我虽然拼命去帮她争取机会，但她的论文还是…还是没通过…"
                                },
                                {
                                    "id": "731050128",
                                    "speaker": "派蒙",
                                    "text": "不对啊，爱拉尼小姐很早就开始取材了呀？怎么可能拖到现在才…"
                                },
                                {
                                    "id": "731050129",
                                    "speaker": "派蒙",
                                    "text": "等等，说到稻妻…难道…"
                                },
                                {
                                    "id": "731050130",
                                    "speaker": "Player",
                                    "text": "锁，锁国令！"
                                },
                                {
                                    "id": "731050131",
                                    "speaker": "派蒙",
                                    "text": "怎么这样…"
                                },
                                {
                                    "id": "731050132",
                                    "speaker": "妮露法",
                                    "text": "我根本不知道怎么告诉她这个消息…本来打算过几天，想个委婉的方式和她沟通。"
                                },
                                {
                                    "id": "731050133",
                                    "speaker": "妮露法",
                                    "text": "结果不知道哪个大嘴巴，直接把这个消息告诉她。"
                                },
                                {
                                    "id": "731050134",
                                    "speaker": "妮露法",
                                    "text": "然后她就不见了，我找遍了教令院也没有找到，只能去冒险家协会发布了委托。"
                                },
                                {
                                    "id": "731050135",
                                    "speaker": "妮露法",
                                    "text": "但冒险家也只是在一个地方发现了爱拉尼的笔记本，没有发现她的人影。"
                                },
                                {
                                    "id": "731050136",
                                    "speaker": "妮露法",
                                    "text": "现在，冒险家们应该还在到处找爱拉尼的下落…"
                                },
                                {
                                    "id": "731050137",
                                    "speaker": "妮露法",
                                    "text": "我，我真的不知道怎么办才好，呜…",
                                    "choices": [
                                        {
                                            "id": "731050138",
                                            "text": "我也去帮忙找爱拉尼。",
                                            "response": [
                                                {
                                                    "id": "731050139",
                                                    "speaker": "派蒙",
                                                    "text": "对，我们也来帮忙！先从…先从那个笔记本的位置开始找好了！"
                                                },
                                                {
                                                    "id": "731050142",
                                                    "speaker": "妮露法",
                                                    "text": "您愿意帮忙吗？太感谢您了，真是太感谢您了！"
                                                },
                                                {
                                                    "id": "731050143",
                                                    "speaker": "妮露法",
                                                    "text": "我这就把发现笔记本的位置给您标在地图上。"
                                                },
                                                {
                                                    "id": "731050144",
                                                    "speaker": "妮露法",
                                                    "text": "对了，还有报酬…",
                                                    "choices": [
                                                        {
                                                            "id": "731050145",
                                                            "text": "这个之后再说吧。",
                                                            "response": [
                                                                {
                                                                    "id": "731050147",
                                                                    "speaker": "妮露法",
                                                                    "text": "欸？那就拜托您了，我在这里接着等冒险家协会的消息。"
                                                                },
                                                                {
                                                                    "id": "731050148",
                                                                    "speaker": "妮露法",
                                                                    "text": "爱拉尼，你可千万要平安啊…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731050146",
                                                            "text": "我去找爱拉尼要。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731050140",
                                            "text": "笔记本的位置在哪？",
                                            "response": [
                                                {
                                                    "id": "731050141",
                                                    "speaker": "派蒙",
                                                    "text": "我们也来帮忙找爱拉尼小姐！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731050123",
                            "text": "爱拉尼研究得很拼命。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310502",
            "objective": "寻找爱拉尼",
            "dialogues": []
        },
        {
            "id": "7310504",
            "objective": "拦住盗宝团$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7310503",
            "objective": "拦住盗宝团",
            "dialogues": []
        },
        {
            "id": "7310505",
            "objective": "与盗宝团对话",
            "dialogues": [
                {
                    "id": "731050501",
                    "speaker": "戈布利",
                    "text": "英雄！好汉，别打了，别打了！都是误会啊！",
                    "choices": [
                        {
                            "id": "731050502",
                            "text": "没什么误会。",
                            "response": [
                                {
                                    "id": "731050503",
                                    "speaker": "派蒙",
                                    "text": "你们对爱拉尼小姐做了什么？老实交代！"
                                },
                                {
                                    "id": "731050504",
                                    "speaker": "派蒙",
                                    "text": "不然…不然我们就揍你喔！"
                                },
                                {
                                    "id": "731050507",
                                    "speaker": "戈布利",
                                    "text": "别，别别别，英雄您听我说完，这真的是误会…"
                                },
                                {
                                    "id": "731050508",
                                    "speaker": "戈布利",
                                    "text": "那位小姑奶奶我们哪敢惹啊，我们根本就折腾不过她啊！",
                                    "choices": [
                                        {
                                            "id": "731050509",
                                            "text": "什么意思？",
                                            "response": [
                                                {
                                                    "id": "731050511",
                                                    "speaker": "戈布利",
                                                    "text": "您听我慢慢说…"
                                                },
                                                {
                                                    "id": "731050512",
                                                    "speaker": "戈布利",
                                                    "text": "前段时间，我们兄弟正好缺了点钱，就跟着大姐去周围想找点发财的路子。"
                                                },
                                                {
                                                    "id": "731050513",
                                                    "speaker": "派蒙",
                                                    "text": "呸！肯定又是抢劫偷东西这种事。"
                                                },
                                                {
                                                    "id": "731050514",
                                                    "speaker": "戈布利",
                                                    "text": "那…那我们都做了盗宝团，日常发财还不就靠那几样事物…"
                                                },
                                                {
                                                    "id": "731050515",
                                                    "speaker": "戈布利",
                                                    "text": "我们正在营地里做计划的时候，突然看见旁边有一个小姑娘背着一个大包往营地这边走了过来。"
                                                },
                                                {
                                                    "id": "731050516",
                                                    "speaker": "戈布利",
                                                    "text": "她一副失魂落魄的样子，把我们都吓了一跳。"
                                                },
                                                {
                                                    "id": "731050517",
                                                    "speaker": "戈布利",
                                                    "text": "我们正准备抄家伙的时候，那个小姑娘突然一屁股坐在篝火旁边，一边哭一边噼里啪啦地把一堆书都甩进火里…"
                                                },
                                                {
                                                    "id": "731050518",
                                                    "speaker": "戈布利",
                                                    "text": "兄弟们是真的被这丫头给吓住了…",
                                                    "choices": [
                                                        {
                                                            "id": "731050519",
                                                            "text": "你们还能被她给吓住…",
                                                            "response": [
                                                                {
                                                                    "id": "731050521",
                                                                    "speaker": "戈布利",
                                                                    "text": "哎哟，我们虽然是盗宝团，但我们也没真正害过人命啊，顶多就是偷点东西，拿点宝物什么的…"
                                                                },
                                                                {
                                                                    "id": "731050522",
                                                                    "speaker": "戈布利",
                                                                    "text": "我们还没反应过来，她突然又甩过来一袋摩拉，让我们把她给关起来。"
                                                                },
                                                                {
                                                                    "id": "731050523",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸，欸…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "731050524",
                                                                            "text": "这都是什么乱七八糟的…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "731050526",
                                                                                    "speaker": "戈布利",
                                                                                    "text": "一开始…也没人敢上去碰她啊。但她一直不吃不喝，就一个劲要被关起来。"
                                                                                },
                                                                                {
                                                                                    "id": "731050527",
                                                                                    "speaker": "戈布利",
                                                                                    "text": "最后还是大姐让我们去削了几根树枝，做了个笼子让她坐进去了。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "731050528",
                                                                                            "text": "你们的这位大姐还挺好的…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "731050530",
                                                                                                    "speaker": "戈布利",
                                                                                                    "text": "谁叫我们大姐一直就尊敬有学问的人呢，她一直说，要是有机会她也想上学…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "731050531",
                                                                                                    "speaker": "戈布利",
                                                                                                    "text": "咳，您要是不信…那位姑奶奶就在那边，您自己去看看吧，大姐现在肯定还在劝她…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "731050532",
                                                                                                    "speaker": "戈布利",
                                                                                                    "text": "您要是能把那位姑奶奶劝走，我们绝对有大礼奉上！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "731050529",
                                                                                            "text": "你们对爱拉尼还挺好的…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "731050525",
                                                                            "text": "那你们把她关起来了吗？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731050520",
                                                            "text": "你们不是盗宝团吗…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731050510",
                                            "text": "爱拉尼果然在你们那。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731050505",
                            "text": "你们把爱拉尼怎么了！",
                            "response": [
                                {
                                    "id": "731050506",
                                    "speaker": "派蒙",
                                    "text": "老实交代！不然…不然我们就揍你喔！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310506",
            "objective": "前往寻找爱拉尼",
            "dialogues": []
        },
        {
            "id": "7310507",
            "objective": "与爱拉尼对话",
            "dialogues": [
                {
                    "id": "731050701",
                    "speaker": "？？？",
                    "text": "爱拉尼！你到底出不出来！？"
                },
                {
                    "id": "731050702",
                    "speaker": "爱拉尼",
                    "text": "就是不出来！我不做学者了！我也不想上学了！"
                },
                {
                    "id": "731050703",
                    "speaker": "爱拉尼",
                    "text": "反正我都付给你那么多钱了，你就让我一个人待着不行吗？！"
                },
                {
                    "id": "731050704",
                    "speaker": "？？？",
                    "text": "死丫头，油盐不进是吧…",
                    "choices": [
                        {
                            "id": "731050705",
                            "text": "那个…",
                            "response": [
                                {
                                    "id": "731050707",
                                    "speaker": "派蒙",
                                    "text": "你，你们好…"
                                },
                                {
                                    "id": "731050708",
                                    "speaker": "？？？",
                                    "text": "嗯？你们是…"
                                },
                                {
                                    "id": "731050709",
                                    "speaker": "爱拉尼",
                                    "text": "旅，旅行者！呜…"
                                },
                                {
                                    "id": "731050710",
                                    "speaker": "派蒙",
                                    "text": "爱拉尼小姐，你真的在这里呀…",
                                    "choices": [
                                        {
                                            "id": "731050711",
                                            "text": "你没事就好…",
                                            "response": [
                                                {
                                                    "id": "731050713",
                                                    "speaker": "爱拉尼",
                                                    "text": "呜…呜…他们…他们欺负人！那篇论文明明是我先写的！我先写的！"
                                                },
                                                {
                                                    "id": "731050714",
                                                    "speaker": "爱拉尼",
                                                    "text": "要不是在稻妻耽误那么久，我的论文早就通过了！呜呜…"
                                                },
                                                {
                                                    "id": "731050715",
                                                    "speaker": "派蒙",
                                                    "text": "冷静一点啦…那你现在还要继续写论文吗？"
                                                },
                                                {
                                                    "id": "731050716",
                                                    "speaker": "爱拉尼",
                                                    "text": "呼…呼…"
                                                },
                                                {
                                                    "id": "731050717",
                                                    "speaker": "爱拉尼",
                                                    "text": "我，我才不写了呢…傻子才写论文！我不要上学了！教令院爱怎么样就怎么样！"
                                                },
                                                {
                                                    "id": "731050718",
                                                    "speaker": "爱拉尼",
                                                    "text": "反正我付钱雇了娜赞保护我，谁也别想把我再抓回去写论文！"
                                                },
                                                {
                                                    "id": "731050719",
                                                    "speaker": "？？？",
                                                    "text": "哼…"
                                                },
                                                {
                                                    "id": "731050720",
                                                    "speaker": "Player",
                                                    "text": "您是…"
                                                },
                                                {
                                                    "id": "731050721",
                                                    "speaker": "娜赞",
                                                    "text": "我就是娜赞，我的本职工作…哼，你应该也已经知道了，我就不说废话了。"
                                                },
                                                {
                                                    "id": "731050722",
                                                    "speaker": "娜赞",
                                                    "text": "我知道你，最近在这周围很活跃的「旅行者」。"
                                                },
                                                {
                                                    "id": "731050723",
                                                    "speaker": "娜赞",
                                                    "text": "如果你是接到了谁的委托，要把这丫头带回去的话，你可以先试试说服她，我不会阻止你。"
                                                },
                                                {
                                                    "id": "731050724",
                                                    "speaker": "爱拉尼",
                                                    "text": "喂！我可是付了钱的！"
                                                },
                                                {
                                                    "id": "731050725",
                                                    "speaker": "娜赞",
                                                    "text": "你付的那么点钱够干什么的？再买几天吃喝就要花光了。"
                                                },
                                                {
                                                    "id": "731050726",
                                                    "speaker": "爱拉尼",
                                                    "text": "反正…反正我不回去，回去了之后又要想论文的题目，又要到处去田野调查，吃不好睡不好…"
                                                },
                                                {
                                                    "id": "731050727",
                                                    "speaker": "爱拉尼",
                                                    "text": "说不定，还会被莫名其妙的人抓起来，或者是遇见乱七八糟的魔物。最后论文一个字没动，答辩日又过了…"
                                                },
                                                {
                                                    "id": "731050728",
                                                    "speaker": "爱拉尼",
                                                    "text": "呜呜呜…我不要…我不要…我还不如被盗宝团抓起来…呜呜…"
                                                },
                                                {
                                                    "id": "731050729",
                                                    "speaker": "爱拉尼",
                                                    "text": "旅行者，你…你帮我给妮露法老师带个话…我…我给你写个便签…我真的不想回去了，饶了我吧…"
                                                },
                                                {
                                                    "id": "731050738",
                                                    "speaker": "Black Screen",
                                                    "text": "爱拉尼抽泣着开始写起了便签…"
                                                },
                                                {
                                                    "id": "731050730",
                                                    "speaker": "爱拉尼",
                                                    "text": "给你…呜呜呜…呜呜…为什么世界上有论文这种东西…呜呜…"
                                                },
                                                {
                                                    "id": "731050731",
                                                    "speaker": "娜赞",
                                                    "text": "…行了，冷静点，没人带得走你。"
                                                },
                                                {
                                                    "id": "731050732",
                                                    "speaker": "派蒙",
                                                    "text": "爱拉尼小姐…现在的情绪好像很不稳定…"
                                                },
                                                {
                                                    "id": "731050733",
                                                    "speaker": "派蒙",
                                                    "text": "就让她先待在这里，我们先把便签带回去给妮露法小姐吧。",
                                                    "choices": [
                                                        {
                                                            "id": "731050734",
                                                            "text": "但是…",
                                                            "response": [
                                                                {
                                                                    "id": "731050736",
                                                                    "speaker": "娜赞",
                                                                    "text": "不用担心我会对爱拉尼不利，就如她所说，她已经付过钱了。"
                                                                },
                                                                {
                                                                    "id": "731050737",
                                                                    "speaker": "娜赞",
                                                                    "text": "而且…哼，总算是找到了一个懂点学问的人了，我留着她可有大用处。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731050735",
                                                            "text": "盗宝团…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731050712",
                                            "text": "事情我都听妮露法说了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731050706",
                            "text": "打扰了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310508",
            "objective": "向妮露法回报",
            "dialogues": [
                {
                    "id": "731050801",
                    "speaker": "妮露法",
                    "text": "旅行者！怎么样，你找到爱拉尼了吗？"
                },
                {
                    "id": "731050802",
                    "speaker": "派蒙",
                    "text": "找到是找到了…"
                },
                {
                    "id": "731050823",
                    "speaker": "Black Screen",
                    "text": "向妮露法讲述了事情的经过，并把爱拉尼的便签给了她…"
                },
                {
                    "id": "731050803",
                    "speaker": "妮露法",
                    "text": "娜赞？怎么会是她…"
                },
                {
                    "id": "731050804",
                    "speaker": "派蒙",
                    "text": "你认识她吗？"
                },
                {
                    "id": "731050805",
                    "speaker": "妮露法",
                    "text": "嗯…也谈不上认识，但我听人提起过，她是一个很奇怪的盗宝团成员。"
                },
                {
                    "id": "731050806",
                    "speaker": "妮露法",
                    "text": "据说，她劫掠行人的时候，会向被劫掠的人提一个问题。"
                },
                {
                    "id": "731050807",
                    "speaker": "妮露法",
                    "text": "问题的范围从文学到元素，乱七八糟的什么都有，甚至…甚至还有那种「头脑急转弯」…"
                },
                {
                    "id": "731050808",
                    "speaker": "妮露法",
                    "text": "无论如何，只要能解出娜赞的问题，那她不仅会把劫掠的东西全部奉还，还会亲自护送你回城里。"
                },
                {
                    "id": "731050809",
                    "speaker": "派蒙",
                    "text": "她原来是这种怪人吗…",
                    "choices": [
                        {
                            "id": "731050810",
                            "text": "这是什么谜语大盗…",
                            "response": [
                                {
                                    "id": "731050812",
                                    "speaker": "妮露法",
                                    "text": "没人知道她是什么目的。我之所以知道这件事，也是因为我的导师曾经在野外遇见过娜赞。"
                                },
                                {
                                    "id": "731050813",
                                    "speaker": "妮露法",
                                    "text": "当时娜赞的问题是：「用什么东西能够迅速填满一间空荡荡的屋子。」"
                                },
                                {
                                    "id": "731050814",
                                    "speaker": "派蒙",
                                    "text": "唔…"
                                },
                                {
                                    "id": "731050815",
                                    "speaker": "派蒙",
                                    "text": "风！对吗？肯定对吧！"
                                },
                                {
                                    "id": "731050816",
                                    "speaker": "Player",
                                    "text": "呃…烛光？"
                                },
                                {
                                    "id": "731050817",
                                    "speaker": "妮露法",
                                    "text": "我导师的回答是：「元素力始终无处不在。」"
                                },
                                {
                                    "id": "731050818",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "731050819",
                                    "speaker": "派蒙",
                                    "text": "耍赖！"
                                },
                                {
                                    "id": "731050820",
                                    "speaker": "妮露法",
                                    "text": "哈哈哈…总之，娜赞是把我的导师送回了城里，还和他礼貌地道别。"
                                },
                                {
                                    "id": "731050821",
                                    "speaker": "妮露法",
                                    "text": "如果是她和爱拉尼在一起，我反倒不那么担心了。"
                                },
                                {
                                    "id": "731050822",
                                    "speaker": "妮露法",
                                    "text": "但爱拉尼那孩子一直待在那里也不行，我得想个办法，帮她把论文的问题解决了…"
                                }
                            ]
                        },
                        {
                            "id": "731050811",
                            "text": "她到底是什么目的？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310530",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731053001",
                    "speaker": "妮露法",
                    "text": "爱拉尼，你可千万要平安啊…",
                    "choices": [
                        {
                            "id": "731053002",
                            "text": "爱拉尼在教令院怎么样？",
                            "response": [
                                {
                                    "id": "731053003",
                                    "speaker": "妮露法",
                                    "text": "爱拉尼是一个很勤奋的孩子，虽然有时候…总是会在奇怪的地方钻牛角尖…"
                                },
                                {
                                    "id": "731053004",
                                    "speaker": "妮露法",
                                    "text": "但她绝对是一个合格的学生，我也相信她绝对会成为一个合格的学者。"
                                }
                            ]
                        },
                        {
                            "id": "731053005",
                            "text": "教令院论文很难通过吗？",
                            "response": [
                                {
                                    "id": "731053006",
                                    "speaker": "妮露法",
                                    "text": "老实说，是的。"
                                },
                                {
                                    "id": "731053007",
                                    "speaker": "妮露法",
                                    "text": "论文的审核是一件…很复杂的事，除了考虑自己的研究方向，文献的充足程度…"
                                },
                                {
                                    "id": "731053008",
                                    "speaker": "妮露法",
                                    "text": "还要注意同类型论文的数量，研究课题有没有和别人冲突。开题之后，也会遇见各种各样的困难。"
                                },
                                {
                                    "id": "731053009",
                                    "speaker": "妮露法",
                                    "text": "唉，但爱拉尼那孩子的运气也太差了点…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310531",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731053101",
                    "speaker": "娜赞",
                    "text": "还有什么事？",
                    "choices": [
                        {
                            "id": "731053102",
                            "text": "你为什么对她这么…",
                            "response": [
                                {
                                    "id": "731053103",
                                    "speaker": "娜赞",
                                    "text": "对爱拉尼这么「好」？"
                                },
                                {
                                    "id": "731053104",
                                    "speaker": "娜赞",
                                    "text": "你误会了。我这么做理由很简单。第一，爱拉尼付过钱了。"
                                },
                                {
                                    "id": "731053105",
                                    "speaker": "娜赞",
                                    "text": "第二，我从来只取财，不害人，如果我把她拽出来，丢去荒郊野岭，那我在道上的名声就要坏透了。"
                                },
                                {
                                    "id": "731053106",
                                    "speaker": "娜赞",
                                    "text": "第三，她是一个有知识的人，有着远大的未来。"
                                },
                                {
                                    "id": "731053107",
                                    "speaker": "娜赞",
                                    "text": "能帮上她的忙，我这个在泥巴里打滚的盗宝团，也许…算是能沾点光了？哼…"
                                }
                            ]
                        },
                        {
                            "id": "731053108",
                            "text": "她付了你多少钱？",
                            "response": [
                                {
                                    "id": "731053109",
                                    "speaker": "娜赞",
                                    "text": "不是一个小数目。她说是帮人做什么「肥料」赚来的钱，我不明白，也懒得管。"
                                },
                                {
                                    "id": "731053110",
                                    "speaker": "娜赞",
                                    "text": "总归她付了钱，我就会暂时帮她的忙，就这么简单。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7310532",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731053201",
                    "speaker": "爱拉尼",
                    "text": "呜呜呜…呜呜…为什么世界上有论文这种东西…呜呜…"
                }
            ]
        }
    ]
}