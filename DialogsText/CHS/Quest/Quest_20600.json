        },
        "total_dialogue_lines": 85,
        "total_speaker_counts": {
            "Player": 15,
            "派蒙": 2,
            "维克多": 68
        }
    },
    "talks": [
        {
            "id": "2060001",
            "objective": "与维克多对话",
            "dialogues": [
                {
                    "id": "206000101",
                    "speaker": "维克多",
                    "text": "这里，旅行者，我注意你很久了。"
                },
                {
                    "id": "206000102",
                    "speaker": "Player",
                    "text": "找我有什么事吗？"
                },
                {
                    "id": "206000103",
                    "speaker": "维克多",
                    "text": "怎么这么一副提防的语气，我可是有件好事告诉你。"
                },
                {
                    "id": "206000104",
                    "speaker": "维克多",
                    "text": "怎么样，你有没有兴趣加入「愚人众」？"
                },
                {
                    "id": "206000105",
                    "speaker": "派蒙",
                    "text": "哼，我们才没兴趣呢！对吧？",
                    "choices": [
                        {
                            "id": "206000106",
                            "text": "我考虑考虑。",
                            "response": [
                                {
                                    "id": "206000107",
                                    "speaker": "派蒙",
                                    "text": "喂！怎么这种事情你也要考虑呀，直接拒绝才对吧！？"
                                },
                                {
                                    "id": "206000108",
                                    "speaker": "维克多",
                                    "text": "眼力不错啊，想要成就一番事业，加入咱们「愚人众」当然是不二之选。"
                                },
                                {
                                    "id": "206000111",
                                    "speaker": "维克多",
                                    "text": "咦，看你的表情，是有问题想问？"
                                }
                            ]
                        },
                        {
                            "id": "206000109",
                            "text": "这里可是蒙德城。",
                            "response": [
                                {
                                    "id": "206000110",
                                    "speaker": "维克多",
                                    "text": "蒙德城怎么了？咱们「愚人众」可是全大陆公开征募，绝对公平公正，西风骑士也管不着。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2060002",
            "objective": "丘丘人选项（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "206000201",
                    "speaker": "Player",
                    "text": "关于「愚人众」…"
                },
                {
                    "id": "206000202",
                    "speaker": "维克多",
                    "text": "哦唷，单刀直入啊，哼哼，那讲起来可就长咯。"
                },
                {
                    "id": "206000203",
                    "speaker": "维克多",
                    "text": "不过，你还不是「愚人众」的正式成员，我也不能白告诉你…"
                },
                {
                    "id": "206000204",
                    "speaker": "维克多",
                    "text": "我听说，这蒙德城周围有很多丘丘人，有的还聚在一起抱起了团。"
                },
                {
                    "id": "206000205",
                    "speaker": "维克多",
                    "text": "你帮我去走一趟，从领头的「丘丘人暴徒」那拿点战利品回来，然后，我就给你讲点新鲜故事，怎么样？",
                    "choices": [
                        {
                            "id": "206000206",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "206000207",
                                    "speaker": "维克多",
                                    "text": "哟，还挺爽快的，难得在蒙德城里能遇见这种人。"
                                },
                                {
                                    "id": "206000208",
                                    "speaker": "维克多",
                                    "text": "那你快点去吧，我就在这等你，记得快去快回。"
                                }
                            ]
                        },
                        {
                            "id": "206000209",
                            "text": "就只要这个？",
                            "response": [
                                {
                                    "id": "206000210",
                                    "speaker": "维克多",
                                    "text": "怎么，你还嫌这个不带劲？行了，再厉害点的怪物你搞得定吗？"
                                },
                                {
                                    "id": "206000211",
                                    "speaker": "维克多",
                                    "text": "快去快回吧，我就在这等着你。"
                                },
                                {
                                    "id": "206000212",
                                    "speaker": "维克多",
                                    "text": "哈…要是再磨蹭一会，我非得被这风给吹睡着了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2060003",
            "objective": "盗宝团选项（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "206000301",
                    "speaker": "Player",
                    "text": "关于「邪眼」…"
                },
                {
                    "id": "206000302",
                    "speaker": "维克多",
                    "text": "嘿…我说，你是真不会说话，还是假装糊涂？"
                },
                {
                    "id": "206000303",
                    "speaker": "维克多",
                    "text": "你又不是「愚人众」的正式成员，这么直挺挺一句「『邪眼』是什么？」戳过来。"
                },
                {
                    "id": "206000304",
                    "speaker": "维克多",
                    "text": "你觉得我会直接一五一十地全部告诉你吗？我又不是那两个看门的西风骑士。"
                },
                {
                    "id": "206000305",
                    "speaker": "维克多",
                    "text": "不过…「邪眼」可是咱「愚人众」的宝物，让你了解一下，也不是不行。"
                },
                {
                    "id": "206000306",
                    "speaker": "维克多",
                    "text": "这样吧，你再去跑一趟。你见过蒙德城周围的那些「盗宝团」吧？"
                },
                {
                    "id": "206000307",
                    "speaker": "维克多",
                    "text": "虽然是一群偷偷摸摸的小毛贼，但偶尔还真能让他们撞到宝贝。"
                },
                {
                    "id": "206000308",
                    "speaker": "维克多",
                    "text": "你去帮我跑一趟，从「盗宝团」的手上拿点东西回来，作为交换，我就给你讲讲「邪眼」的事。",
                    "choices": [
                        {
                            "id": "206000309",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "206000310",
                                    "speaker": "维克多",
                                    "text": "我就喜欢爽快的人，那你就快点去吧。"
                                }
                            ]
                        },
                        {
                            "id": "206000311",
                            "text": "你缺钱了？",
                            "response": [
                                {
                                    "id": "206000312",
                                    "speaker": "维克多",
                                    "text": "缺钱？哈哈哈，你以为我们是西风骑士团吗？"
                                },
                                {
                                    "id": "206000313",
                                    "speaker": "维克多",
                                    "text": "我就是想看看，盗宝团能在蒙德挖出什么东西来。"
                                },
                                {
                                    "id": "206000314",
                                    "speaker": "维克多",
                                    "text": "不过…嘿嘿，想来他们也挖不出来什么值得一提的宝贝吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2060004",
            "objective": "遗迹守卫选项（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "206000401",
                    "speaker": "Player",
                    "text": "关于「女皇陛下」…"
                },
                {
                    "id": "206000402",
                    "speaker": "维克多",
                    "text": "怎么，你想找我打听女皇陛下？"
                },
                {
                    "id": "206000403",
                    "speaker": "维克多",
                    "text": "你不会是因为女皇陛下，才考虑加入愚人众的吧？"
                },
                {
                    "id": "206000404",
                    "speaker": "维克多",
                    "text": "哼，不是我说你，你自己掂量掂量你这个念头…"
                },
                {
                    "id": "206000405",
                    "speaker": "维克多",
                    "text": "不过，关于女皇陛下的消息，我更不能白告诉你。"
                },
                {
                    "id": "206000406",
                    "speaker": "维克多",
                    "text": "你去跑一趟，从遗迹守卫身上找点宝贝回来吧，我突然想收藏来玩玩。",
                    "choices": [
                        {
                            "id": "206000407",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "206000408",
                                    "speaker": "维克多",
                                    "text": "哦，那你快去吧，我就在这等着你。"
                                }
                            ]
                        },
                        {
                            "id": "206000409",
                            "text": "你要这个做什么？",
                            "response": [
                                {
                                    "id": "206000410",
                                    "speaker": "维克多",
                                    "text": "啊？做个收藏不行吗？怎么，蒙德人连个遗迹守卫都不敢试试吗？"
                                },
                                {
                                    "id": "206000411",
                                    "speaker": "维克多",
                                    "text": "哼，对「愚人众」来说，也就是一抬手的功夫。"
                                },
                                {
                                    "id": "206000412",
                                    "speaker": "维克多",
                                    "text": "不过，哈…这股风吹得我只想睡觉，实在提不起劲，所以这件小事就交给你了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2060005",
            "objective": "获得丘丘人暴徒战利品",
            "dialogues": [
                {
                    "id": "206000501",
                    "speaker": "维克多",
                    "text": "别忘了啊，是「丘丘人暴徒」身上的战利品，拿到了就赶紧回来。"
                },
                {
                    "id": "206000502",
                    "speaker": "维克多",
                    "text": "具体是什么？就是…一个号角。哎呀，你拿到了之后给我就是了。"
                }
            ]
        },
        {
            "id": "2060006",
            "objective": "与维克多对话",
            "dialogues": [
                {
                    "id": "206000601",
                    "speaker": "维克多",
                    "text": "东西拿到了吗？"
                },
                {
                    "id": "206000602",
                    "speaker": "Player",
                    "text": "拿到了。"
                },
                {
                    "id": "206000603",
                    "speaker": "维克多",
                    "text": "我看看，嗯…勉强还行，凑合吧。"
                },
                {
                    "id": "206000604",
                    "speaker": "维克多",
                    "text": "那我就和你们讲讲「愚人众」的事。"
                },
                {
                    "id": "206000605",
                    "speaker": "维克多",
                    "text": "我们「愚人众」来自「至冬宫」，听从女皇陛下的命令，秉承着女皇陛下的意志，在世界各地活动。"
                },
                {
                    "id": "206000606",
                    "speaker": "维克多",
                    "text": "在其中有十一位最强的人，被女皇陛下赐予了「执行官」之名。"
                },
                {
                    "id": "206000607",
                    "speaker": "维克多",
                    "text": "比起我们这些无名小卒，那十一位「执行官」才是有着赫赫威名的大人物。"
                },
                {
                    "id": "206000608",
                    "speaker": "维克多",
                    "text": "如果你加入了「愚人众」，实力也够强，说不定还会被哪位大人挑中。"
                },
                {
                    "id": "206000609",
                    "speaker": "维克多",
                    "text": "那样的话，你就飞黄腾达咯…"
                },
                {
                    "id": "206000610",
                    "speaker": "维克多",
                    "text": "我？被挑中倒是谈不上，我就是在这给「女士」大人办点小事。"
                },
                {
                    "id": "206000611",
                    "speaker": "维克多",
                    "text": "呃…如果非要选的话，我其实更想跟着「队长」大人啊…"
                }
            ]
        },
        {
            "id": "2060007",
            "objective": "获得盗宝团战利品",
            "dialogues": [
                {
                    "id": "206000701",
                    "speaker": "维克多",
                    "text": "记住了，是从「盗宝团」那拿点东西回来。"
                },
                {
                    "id": "206000702",
                    "speaker": "维克多",
                    "text": "你要是拿乱七八糟的东西糊弄我，那我们俩的交易就告吹了。"
                }
            ]
        },
        {
            "id": "2060008",
            "objective": "与维克多对话",
            "dialogues": [
                {
                    "id": "206000801",
                    "speaker": "维克多",
                    "text": "东西拿到了吗？"
                },
                {
                    "id": "206000802",
                    "speaker": "Player",
                    "text": "拿到了。"
                },
                {
                    "id": "206000803",
                    "speaker": "维克多",
                    "text": "我看看，啧，果然不是什么好宝贝，什么破地方…"
                },
                {
                    "id": "206000804",
                    "speaker": "维克多",
                    "text": "好了好了，和你讲讲「邪眼」的事。我想想啊…"
                },
                {
                    "id": "206000805",
                    "speaker": "维克多",
                    "text": "「邪眼」是由女皇陛下亲自赐予的宝物，有着强大的力量，只要有了它，无论是信仰还是「神之眼」，都是哄小孩的把戏。"
                },
                {
                    "id": "206000806",
                    "speaker": "维克多",
                    "text": "不过，「邪眼」也不是人人都能持有，「愚人众」里除了那十一位「执行官」之外，能拿到「邪眼」的人也不多。"
                },
                {
                    "id": "206000807",
                    "speaker": "维克多",
                    "text": "不过就算这样，对于我这种普通人来说，比起由神恩赐而来的「神之眼」，还是「邪眼」更具有现实感。"
                },
                {
                    "id": "206000808",
                    "speaker": "维克多",
                    "text": "嘿嘿，我看你也没有「神之眼」，怎么样？考不考虑加入我们「愚人众」，说不定运气好，真能拿到「邪眼」喔。"
                },
                {
                    "id": "206000809",
                    "speaker": "维克多",
                    "text": "呃…好了，关于「邪眼」就说到这吧，西风骑士团对这东西很敏感，可别把他们招来了。"
                }
            ]
        },
        {
            "id": "2060009",
            "objective": "获得遗迹守卫战利品",
            "dialogues": [
                {
                    "id": "206000901",
                    "speaker": "维克多",
                    "text": "记住了啊，是遗迹守卫身上的战利品，可别偷懒，随便找点东西来糊弄我。"
                },
                {
                    "id": "206000902",
                    "speaker": "维克多",
                    "text": "哈…越来越想睡觉了…"
                }
            ]
        },
        {
            "id": "2060010",
            "objective": "与维克多对话",
            "dialogues": [
                {
                    "id": "206001001",
                    "speaker": "维克多",
                    "text": "东西拿到了吗？"
                },
                {
                    "id": "206001002",
                    "speaker": "Player",
                    "text": "拿到了。"
                },
                {
                    "id": "206001003",
                    "speaker": "维克多",
                    "text": "哦！这个东西不错啊，你手脚还挺利索的嘛。"
                },
                {
                    "id": "206001004",
                    "speaker": "维克多",
                    "text": "你想打听和「女皇陛下」有关的事对吧？我想想从哪开始说。"
                },
                {
                    "id": "206001005",
                    "speaker": "维克多",
                    "text": "嗯…如果简短概括，那么就是「女皇陛下是神」。"
                },
                {
                    "id": "206001006",
                    "speaker": "维克多",
                    "text": "这并不是什么抽象形容，而是具体的事实。女皇陛下就是当今「尘世七执政」中的「冰之神」。"
                },
                {
                    "id": "206001007",
                    "speaker": "维克多",
                    "text": "不过，对我们「愚人众」来说，「女皇」的意义更甚于「神」的身份。"
                },
                {
                    "id": "206001008",
                    "speaker": "维克多",
                    "text": "至于原因…和你说了你也不会明白，或者说，不会理解。"
                },
                {
                    "id": "206001009",
                    "speaker": "维克多",
                    "text": "如果你想要理解的话，就加入我们吧。加入了之后，自然而然地就会理解了，咱们的女皇陛下…"
                },
                {
                    "id": "206001010",
                    "speaker": "维克多",
                    "text": "啧…得了得了，就说到这吧，旁边的修女又在瞪我了…"
                }
            ]
        }
    ]
}