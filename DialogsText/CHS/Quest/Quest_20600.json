{
    "quest": {
        "id": "20600",
        "title": "来自冬天的故事",
        "description": "在蒙德城里的「愚人众」成员维克多，正想要招募人加入「愚人众」。 这似乎是探听「愚人众」情报的好机会…",
        "rewards": [
            {
                "itemId": 202,
                "count": 2000
            }
        ],
        "rewards_formatted": "摩拉 x2000",
        "chapter": {
            "icon": "",
