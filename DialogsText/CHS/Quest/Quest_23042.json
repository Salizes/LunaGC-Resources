            "里夫": 17,
            "阿扎莱": 4
        }
    },
    "talks": [
        {
            "id": "2304201",
            "objective": "与内尔敏对话",
            "dialogues": [
                {
                    "id": "230420101",
                    "speaker": "内尔敏",
                    "text": "这样一定可以给里夫一个惊喜…嘿嘿…"
                },
                {
                    "id": "230420102",
                    "speaker": "Player",
                    "text": "什么惊喜？"
                },
                {
                    "id": "230420103",
                    "speaker": "内尔敏",
                    "text": "呜哇！别吓我啊旅行者！"
                },
                {
                    "id": "230420104",
                    "speaker": "Player",
                    "text": "我是从你正面走过来的…"
                },
                {
                    "id": "230420105",
                    "speaker": "内尔敏",
                    "text": "我在想事情嘛，完全没有注意到你。"
                },
                {
                    "id": "230420106",
                    "speaker": "内尔敏",
                    "text": "旅行者，我问你啊…你听说过「香水」这种东西吗？"
                },
                {
                    "id": "230420107",
                    "speaker": "内尔敏",
                    "text": "贾瓦希尔奶奶告诉我，她年轻的时候经常自制「香水」…"
                },
                {
                    "id": "230420108",
                    "speaker": "内尔敏",
                    "text": "「香水」的气味不仅能够遮盖住人身上的汗味，而且某些特别的「香水」还有着提神的功效…"
                },
                {
                    "id": "230420109",
                    "speaker": "内尔敏",
                    "text": "里夫一直在村口做守卫，每天热得满身大汗，回来的时候也总是说自己被晒得头晕…"
                },
                {
                    "id": "230420110",
                    "speaker": "内尔敏",
                    "text": "所以，我就想做一瓶「薄荷香水」送给他。"
                },
                {
                    "id": "230420111",
                    "speaker": "内尔敏",
                    "text": "贾瓦希尔奶奶把制作香水的方法写给了我，还帮我去买了很多材料…"
                },
                {
                    "id": "230420112",
                    "speaker": "内尔敏",
                    "text": "但制作香水真是出乎意料的麻烦…光是悄悄处理材料我就花了好长时间，还做出了不少失败品…"
                },
                {
                    "id": "230420113",
                    "speaker": "内尔敏",
                    "text": "再这么拖下去，里夫就要发现我做香水的事了！"
                },
                {
                    "id": "230420114",
                    "speaker": "内尔敏",
                    "text": "所以旅行者，能请你帮我去置办一些材料吗？一定要悄悄地，不能让里夫发现！",
                    "choices": [
                        {
                            "id": "230420115",
                            "text": "告诉他也没问题吧…",
                            "response": [
                                {
                                    "id": "230420116",
                                    "speaker": "内尔敏",
                                    "text": "不行不行，这可是我准备了好久的惊喜，绝不能这么轻易就告诉他。"
                                },
                                {
                                    "id": "230420119",
                                    "speaker": "内尔敏",
                                    "text": "其实我想拜托你准备的材料也不多啦，你先去找阿扎莱先生，拿到我订的货，然后再帮我取一小桶水来就好啦。"
                                },
                                {
                                    "id": "230420120",
                                    "speaker": "内尔敏",
                                    "text": "记住，一定要悄悄的喔，绝对不能让里夫察觉到！"
                                }
                            ]
                        },
                        {
                            "id": "230420117",
                            "text": "唉…交给我吧。",
                            "response": [
                                {
                                    "id": "230420118",
                                    "speaker": "内尔敏",
                                    "text": "那就拜托你啦，放心，我一定会准备好报酬的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2304202",
            "objective": "与阿扎莱对话",
            "dialogues": [
                {
                    "id": "230420301",
                    "speaker": "阿扎莱",
                    "text": "欢迎，客人需要点什么？"
                },
                {
                    "id": "230420302",
                    "speaker": "Player",
                    "text": "关于内尔敏的「货物」…"
                },
                {
                    "id": "230420303",
                    "speaker": "阿扎莱",
                    "text": "你说那个啊…已经准备好了。这些都是质量很不错的香料，价格也不贵。"
                },
                {
                    "id": "230420304",
                    "speaker": "阿扎莱",
                    "text": "内尔敏是准备拿这些香料制作「香水」，对吧？"
                },
                {
                    "id": "230420305",
                    "speaker": "阿扎莱",
                    "text": "唉，虽然有活力是件好事，但内尔敏也得注意一下自己的身体啊…"
                }
            ]
        },
        {
            "id": "2304203",
            "objective": "取得一桶水",
            "dialogues": []
        },
        {
            "id": "2304204",
            "objective": "向内尔敏回报",
            "dialogues": []
        },
        {
            "id": "2304205",
            "objective": "向内尔敏回报",
            "dialogues": [
                {
                    "id": "230420501",
                    "speaker": "内尔敏",
                    "text": "太好了，之前的材料还剩下一些，加上你带来的这些，我可以再试做几次了…"
                },
                {
                    "id": "230420502",
                    "speaker": "内尔敏",
                    "text": "呼…我再多看看笔记，这次一定要成功！"
                },
                {
                    "id": "230420503",
                    "speaker": "内尔敏",
                    "text": "对了，我还得去摘几片花瓣…"
                },
                {
                    "id": "230420504",
                    "speaker": "Black Screen",
                    "text": "内尔敏开始紧张地制作起了「香水」…"
                },
                {
                    "id": "230420505",
                    "speaker": "内尔敏",
                    "text": "完成了！气味闻起来还不错…也没有变得黏黏糊糊的…"
                },
                {
                    "id": "230420506",
                    "speaker": "内尔敏",
                    "text": "这样应该就算是成功了吧…",
                    "choices": [
                        {
                            "id": "230420507",
                            "text": "感觉上算是成功了。",
                            "response": [
                                {
                                    "id": "230420509",
                                    "speaker": "内尔敏",
                                    "text": "嗯！我还特意买了一个瓶子呢，先让我把香水装进去…"
                                },
                                {
                                    "id": "230420510",
                                    "speaker": "内尔敏",
                                    "text": "旅行者，我们一起去把香水送给里夫吧，希望他会喜欢…"
                                }
                            ]
                        },
                        {
                            "id": "230420508",
                            "text": "至少不算是失败嘛。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2304206",
            "objective": "把「香水」送给里夫",
            "dialogues": [
                {
                    "id": "230420601",
                    "speaker": "里夫",
                    "text": "内尔敏，还有旅行者…你们怎么来了？是遇见什么麻烦了吗？"
                },
                {
                    "id": "230420602",
                    "speaker": "里夫",
                    "text": "不会是那盆花有什么问题吧？我还在值班呢，等我值完班之后，再…"
                },
                {
                    "id": "230420603",
                    "speaker": "Player",
                    "text": "内尔敏有东西送给你。"
                },
                {
                    "id": "230420604",
                    "speaker": "内尔敏",
                    "text": "这瓶「香水」送给你！是薄荷味的喔。"
                },
                {
                    "id": "230420605",
                    "speaker": "内尔敏",
                    "text": "我本来想做「墩墩桃」味的，但不知道为什么，我只要加入墩墩桃，香水就会变得黏糊糊的…"
                },
                {
                    "id": "230420606",
                    "speaker": "里夫",
                    "text": "谢…谢谢，但「香水」是用来做什么的？驱虫？还是做标记…"
                },
                {
                    "id": "230420607",
                    "speaker": "内尔敏",
                    "text": "是帮你提神啦，还有盖住你身上的汗味，你每天闻着那么重的汗味不会头晕吗？"
                },
                {
                    "id": "230420608",
                    "speaker": "里夫",
                    "text": "这个，闻习惯了倒也还好，突然闻不到了反而有些不自在…"
                },
                {
                    "id": "230420609",
                    "speaker": "内尔敏",
                    "text": "那「香水」我拿走了，你别用了。"
                },
                {
                    "id": "230420610",
                    "speaker": "里夫",
                    "text": "欸！别啊，我开玩笑的！"
                },
                {
                    "id": "230420611",
                    "speaker": "里夫",
                    "text": "快，快把「香水」给我，我头现在就开始晕了…"
                },
                {
                    "id": "230420612",
                    "speaker": "内尔敏",
                    "text": "给你，涂在胳膊上就行了，贾瓦希尔奶奶是这么说的。"
                },
                {
                    "id": "230420613",
                    "speaker": "里夫",
                    "text": "这气味闻起来还不错，确实很提神。涂上去还感觉冰凉凉的，挺舒服…"
                },
                {
                    "id": "230420614",
                    "speaker": "内尔敏",
                    "text": "哼哼，这可是贾瓦希尔奶奶的秘方。"
                },
                {
                    "id": "230420615",
                    "speaker": "内尔敏",
                    "text": "多亏了旅行者帮忙，我才能做出这么好的「香水」。"
                },
                {
                    "id": "230420616",
                    "speaker": "Player",
                    "text": "就是帮了点小忙。"
                },
                {
                    "id": "230420617",
                    "speaker": "里夫",
                    "text": "麻烦了你这么多次，真是不好意思…"
                },
                {
                    "id": "230420618",
                    "speaker": "里夫",
                    "text": "这些东西给你，就当做是报酬吧，真是多谢了。"
                },
                {
                    "id": "230420619",
                    "speaker": "里夫",
                    "text": "这「香水」用起来倒还真是不错…"
                },
                {
                    "id": "230420620",
                    "speaker": "里夫",
                    "text": "就是…呃…内尔敏，为什么我涂上香水的地方，起了这么多疹子…"
                }
            ]
        },
        {
            "id": "2304207",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230420701",
                    "speaker": "内尔敏",
                    "text": "这道工序是怎么做的来着？笔记…笔记在哪…"
                }
            ]
        },
        {
            "id": "2304208",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230420801",
                    "speaker": "里夫",
                    "text": "旅行者，你又在忙什么呢？跑来跑去的…"
                },
                {
                    "id": "230420802",
                    "speaker": "里夫",
                    "text": "对了，你最近有没有帮内尔敏办过什么事？或者…是听过什么和她有关的传闻？"
                },
                {
                    "id": "230420803",
                    "speaker": "里夫",
                    "text": "总感觉她最近忙忙碌碌的，但我又不知道她在忙什么…",
                    "choices": [
                        {
                            "id": "230420804",
                            "text": "她…她忙着种花啊。",
                            "response": [
                                {
                                    "id": "230420805",
                                    "speaker": "里夫",
                                    "text": "是这样吗？但是我也没看见她屋子里多几盆花啊…"
                                }
                            ]
                        },
                        {
                            "id": "230420806",
                            "text": "她…她忙着做菜啊。",
                            "response": [
                                {
                                    "id": "230420807",
                                    "speaker": "里夫",
                                    "text": "哈？难道是希尔米他们又缠着内尔敏做「薄荷豆汤」了？"
                                },
                                {
                                    "id": "230420808",
                                    "speaker": "里夫",
                                    "text": "这群孩子…我有空一定要去说说他们。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2304209",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230420901",
                    "speaker": "内尔敏",
                    "text": "咳…咳咳…这气味…这样也不对…"
                },
                {
                    "id": "230420902",
                    "speaker": "Player",
                    "text": "你没事吧？"
                },
                {
                    "id": "230420903",
                    "speaker": "内尔敏",
                    "text": "没事没事，我刚才不小心做错了一道工序，做出的「香水」废掉了…"
                },
                {
                    "id": "230420904",
                    "speaker": "内尔敏",
                    "text": "不说这些，你帮我拿到那些材料了吗？"
                },
                {
                    "id": "230420905",
                    "speaker": "Player",
                    "text": "拿到了。"
                }
            ]
        },
        {
            "id": "2304299",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "230429901",
                    "speaker": "派蒙",
                    "text": "这些水应该够用了，我们回去找内尔敏吗？"
                }
            ]
        }
    ]
}