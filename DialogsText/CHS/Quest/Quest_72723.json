    "talks": [
        {
            "id": "7272301",
            "objective": "",
            "dialogues": [
                {
                    "id": "726870101",
                    "speaker": "柴染",
                    "text": "你们好，有缘人。"
                },
                {
                    "id": "726870102",
                    "speaker": "柴染",
                    "text": "两位举手投足间散发着一股馨香，必定经受过风雅之物的熏陶…"
                },
                {
                    "id": "726870103",
                    "speaker": "派蒙",
                    "text": "#咦，我们身上香香的？让我闻闻你，{NICKNAME}。"
                },
                {
                    "id": "726870104",
                    "speaker": "派蒙",
                    "text": "真的诶，你身上有股松茸酿肉卷的香味！这个姐姐看人真准！",
                    "choices": [
                        {
                            "id": "726870105",
                            "text": "她说的应该不是这种香味…",
                            "response": [
                                {
                                    "id": "726870107",
                                    "speaker": "派蒙",
                                    "text": "也对哦，这种熟悉的展开…我明白了！这位姐姐果然也需要我们帮忙吗？"
                                },
                                {
                                    "id": "726870108",
                                    "speaker": "柴染",
                                    "text": "两位是尽职尽责的向导，的确能为我招徕更多客人，但我希望你们也能以客人的身份享受这场祭典。"
                                },
                                {
                                    "id": "726870109",
                                    "speaker": "柴染",
                                    "text": "如果两位有空，要来试试看吗？构筑专属你们的「花影瑶庭」。"
                                },
                                {
                                    "id": "726870110",
                                    "speaker": "派蒙",
                                    "text": "「花影瑶庭」是什么啊？"
                                },
                                {
                                    "id": "726870111",
                                    "speaker": "Player",
                                    "text": "我也想了解一下。"
                                },
                                {
                                    "id": "726870112",
                                    "speaker": "柴染",
                                    "text": "如你所见，我是一名花匠。我身边这些花架上陈列着的，是以「插花」之道所构筑的「花庭」。"
                                },
                                {
                                    "id": "726870113",
                                    "speaker": "柴染",
                                    "text": "将精心修剪的花卉置入花器，辅以各色饰物，构建桌上庭院般的景致。这便是「花影瑶庭」，花艺的结晶。"
                                },
                                {
                                    "id": "726870114",
                                    "speaker": "柴染",
                                    "text": "在社奉行的支持下，我携多座「花影瑶庭」参与容彩祭，希望能让客人们领略到花艺的美好。"
                                },
                                {
                                    "id": "726870115",
                                    "speaker": "柴染",
                                    "text": "要是对「花影瑶庭」感兴趣，现在就可以来体验一番。"
                                },
                                {
                                    "id": "726870116",
                                    "speaker": "派蒙",
                                    "text": "确实…这些花艺作品都好漂亮，听起来也好高雅啊。不过，总觉得这种事情好难好难…我们能做到吗？",
                                    "choices": [
                                        {
                                            "id": "726870117",
                                            "text": "派蒙有点手笨。",
                                            "response": [
                                                {
                                                    "id": "726870119",
                                                    "speaker": "柴染",
                                                    "text": "请别担心。"
                                                },
                                                {
                                                    "id": "726870120",
                                                    "speaker": "柴染",
                                                    "text": "为了让客人们充分体验花艺的魅力，我预先制作了许多部件，适当简化了「花影瑶庭」的制作步骤。"
                                                },
                                                {
                                                    "id": "726870121",
                                                    "speaker": "柴染",
                                                    "text": "只需要选择「主花」「花景」和「茵席」，将它们适当组合，就能完成「花影瑶庭」。"
                                                },
                                                {
                                                    "id": "726870122",
                                                    "speaker": "柴染",
                                                    "text": "当然，重要的是品味花艺的「表达」，因此，我会为你们提出四道「花题」，考验你们的构图思维。"
                                                },
                                                {
                                                    "id": "726870123",
                                                    "speaker": "柴染",
                                                    "text": "完成每天的「花题」后，就能将相应的「花庭」和花材带走留念，还可以获得额外的奖品。"
                                                },
                                                {
                                                    "id": "726870124",
                                                    "speaker": "派蒙",
                                                    "text": "真的吗！还有这种好事！"
                                                },
                                                {
                                                    "id": "726870125",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}，这位姐姐这么尽心尽力地推崇花艺，我们就帮帮她吧！",
                                                    "choices": [
                                                        {
                                                            "id": "726870126",
                                                            "text": "为了优美的花艺…",
                                                            "response": [
                                                                {
                                                                    "id": "726870128",
                                                                    "speaker": "派蒙",
                                                                    "text": "我们现在就要试试…什么来着？对！制作我们的「花影瑶庭」！"
                                                                },
                                                                {
                                                                    "id": "726870129",
                                                                    "speaker": "柴染",
                                                                    "text": "两位愿意对花艺投入心意和热情，实在感激不尽…"
                                                                },
                                                                {
                                                                    "id": "726870130",
                                                                    "speaker": "柴染",
                                                                    "text": "那我们现在就开始吧。今日的「花题」是「紫樱扶疏，澄砂薄香」。"
                                                                },
                                                                {
                                                                    "id": "726870131",
                                                                    "speaker": "柴染",
                                                                    "text": "请两位领会题中的深意，专注于花材与花器，开始构筑你们的「花影瑶庭」吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "726870127",
                                                            "text": "为了额外的奖品…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726870118",
                                            "text": "派蒙习惯大开大合。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726870106",
                            "text": "重点错了啦，派蒙…"
                        }
                    ]
                }
            ]
        }
    ]
}