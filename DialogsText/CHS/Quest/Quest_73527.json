    },
    "talks": [
        {
            "id": "7352701",
            "objective": "与工程师对话",
            "dialogues": [
                {
                    "id": "735270101",
                    "speaker": "？？？",
                    "text": "没想到啊，被警告后，你们两位不是直接离开，而是顺着广播的声音找过来了吗？"
                },
                {
                    "id": "735270102",
                    "speaker": "？？？",
                    "text": "不好意思，这个游乐项目还没正式启动，要麻烦你们再等一会儿了，几分钟就好，我正在做最后的调试…",
                    "choices": [
                        {
                            "id": "735270103",
                            "text": "你在谋划什么？",
                            "response": [
                                {
                                    "id": "735270105",
                                    "speaker": "派蒙",
                                    "text": "我们听见了很危险的词——水炮！应该就是那边的大东西…"
                                },
                                {
                                    "id": "735270106",
                                    "speaker": "派蒙",
                                    "text": "呜哇！单看外形就很吓人！"
                                },
                                {
                                    "id": "735270107",
                                    "speaker": "派蒙",
                                    "text": "你想在这里搞什么名堂？我们不能坐视不理！"
                                },
                                {
                                    "id": "735270108",
                                    "speaker": "沙蒂永",
                                    "text": "不不不，两位误会了！"
                                },
                                {
                                    "id": "735270109",
                                    "speaker": "沙蒂永",
                                    "text": "我是游乐项目「飞迸湍流大作战」的负责人沙蒂永，这个项目只是个以海上大战为背景的，轻松愉快的游戏。"
                                },
                                {
                                    "id": "735270110",
                                    "speaker": "沙蒂永",
                                    "text": "「飞迸湍流大作战」得到了伊迪娅女士的批准，安全性你们大可放心！"
                                },
                                {
                                    "id": "735270111",
                                    "speaker": "沙蒂永",
                                    "text": "要是不信我，可以看看伊迪娅女士签字的文件！"
                                },
                                {
                                    "id": "735270112",
                                    "speaker": "Black Screen",
                                    "text": "可疑的工程师沙蒂永找来了相关证明，均为用词相当严谨正式的文书，每一份都可见伊迪娅字迹灵动的签名。\\n旁边还附上了几句祝福，单论字迹和语言风格，的确是伊迪娅本人没错…"
                                },
                                {
                                    "id": "735270113",
                                    "speaker": "派蒙",
                                    "text": "原来是伊迪娅允许的游乐项目啊…吓我们一大跳…"
                                },
                                {
                                    "id": "735270114",
                                    "speaker": "派蒙",
                                    "text": "那你提到过的水炮，是怎么回事？"
                                },
                                {
                                    "id": "735270115",
                                    "speaker": "沙蒂永",
                                    "text": "只是一个简单的比方而已，游乐装置的全名实在太长了，一般人肯定会根据外形，直接叫它们水炮。"
                                },
                                {
                                    "id": "735270116",
                                    "speaker": "沙蒂永",
                                    "text": "不过，这种装置发射的水球是无害的，只不过打中靶标后，飞溅的水可能把附近游客全身弄湿。"
                                },
                                {
                                    "id": "735270117",
                                    "speaker": "沙蒂永",
                                    "text": "有的人喜欢被水打湿后冰凉凉的感觉，有的人却很讨厌湿漉漉的衣服贴在身上，不能让后者心情不好。"
                                },
                                {
                                    "id": "735270118",
                                    "speaker": "沙蒂永",
                                    "text": "如果有余力，我还想在附近布置一些警告牌呢！"
                                },
                                {
                                    "id": "735270119",
                                    "speaker": "派蒙",
                                    "text": "没想到你还挺贴心的嘛，说得很有道理！",
                                    "choices": [
                                        {
                                            "id": "735270120",
                                            "text": "我也有点好奇了…",
                                            "response": [
                                                {
                                                    "id": "735270122",
                                                    "speaker": "沙蒂永",
                                                    "text": "其实是「鳄型涡流聚引原理鳄式外甲海战用重型舰炮式娱乐水球发射炮」，兼顾了原理和外形的准确命名！"
                                                },
                                                {
                                                    "id": "735270123",
                                                    "speaker": "派蒙",
                                                    "text": "真的好长！完全没记住，没理解…"
                                                },
                                                {
                                                    "id": "735270124",
                                                    "speaker": "派蒙",
                                                    "text": "但简称成水炮，好像又缺少了一点气势？那不如就叫它…「鳄鳄炮炮」！"
                                                },
                                                {
                                                    "id": "735270125",
                                                    "speaker": "沙蒂永",
                                                    "text": "这种叠词的名字…"
                                                },
                                                {
                                                    "id": "735270126",
                                                    "speaker": "沙蒂永",
                                                    "text": "很形象！既简单好记，又模拟了海战过程中，炮弹飞掠而过的声音，我觉得好！"
                                                },
                                                {
                                                    "id": "735270127",
                                                    "speaker": "沙蒂永",
                                                    "text": "鳄鳄~炮弹来袭！"
                                                },
                                                {
                                                    "id": "735270128",
                                                    "speaker": "派蒙",
                                                    "text": "鳄鳄~水球发射！",
                                                    "choices": [
                                                        {
                                                            "id": "735270129",
                                                            "text": "你认真的吗…",
                                                            "response": [
                                                                {
                                                                    "id": "735270131",
                                                                    "speaker": "沙蒂永",
                                                                    "text": "总而言之，我觉得我们很合拍！你们肯定也能在这个游乐项目中找到独一无二的乐趣！"
                                                                },
                                                                {
                                                                    "id": "735270132",
                                                                    "speaker": "沙蒂永",
                                                                    "text": "不如，就由你们两位来当「飞迸湍流大作战」的第一批顾客吧？"
                                                                },
                                                                {
                                                                    "id": "735270133",
                                                                    "speaker": "沙蒂永",
                                                                    "text": "游戏的原理很简单！调整「鳄鳄炮炮」的指向，打中各种气球标靶，就能获得相应的积分，得分够高时还能获得一些奖励！"
                                                                },
                                                                {
                                                                    "id": "735270134",
                                                                    "speaker": "派蒙",
                                                                    "text": "也对，聊了这么久，我也想试试看了，操纵「鳄鳄炮炮」的感觉究竟是什么样的呢？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "735270135",
                                                                            "text": "那好吧，我也来！",
                                                                            "response": [
                                                                                {
                                                                                    "id": "735270137",
                                                                                    "speaker": "沙蒂永",
                                                                                    "text": "完美！我这就把最后一点设备调试完毕，你们马上就可以开始游戏了！"
                                                                                },
                                                                                {
                                                                                    "id": "735270138",
                                                                                    "speaker": "沙蒂永",
                                                                                    "text": "希望你们玩得开心！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "735270136",
                                                                            "text": "鳄鳄炮炮~开火！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "735270130",
                                                            "text": "不准敷衍派蒙哦…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735270121",
                                            "text": "它的本名是什么？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735270104",
                            "text": "赶快住手吧！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7352799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735279901",
                    "speaker": "？？？",
                    "text": "下方游客请注意，下方游客请注意！你们进入了水炮的射界，正处于弹着区内，还请速速离开！"
                },
                {
                    "id": "735279902",
                    "speaker": "派蒙",
                    "text": "这个广播的声音…是在警告我们吗？他提到了什么…水炮？听起来很不妙！"
                },
                {
                    "id": "735279903",
                    "speaker": "派蒙",
                    "text": "声音是从那边传来的，我们去看看到底是怎么回事吧！"
                }
            ]
        }
    ]
}