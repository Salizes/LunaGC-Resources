    "talks": [
        {
            "id": "7350101",
            "objective": "与工匠和拉齐对话",
            "dialogues": [
                {
                    "id": "735010201",
                    "speaker": "拉齐",
                    "text": "犯了错的兰那罗父亲，主动承认错误，获得了兰那罗儿子的原谅吗…"
                },
                {
                    "id": "735010202",
                    "speaker": "拉齐",
                    "text": "嗯，我觉得小朋友们会喜欢这个故事的，但是这个兰那罗父亲主动认错的原因，好像还是太简单了。"
                },
                {
                    "id": "735010203",
                    "speaker": "丹吉尔",
                    "text": "要不要在故事里让兰那罗父子一起面对什么困境？这样他们会互相体谅，兰那罗父亲看着儿子努力的样子，也会心生愧疚。"
                },
                {
                    "id": "735010204",
                    "speaker": "拉齐",
                    "text": "那么，兰那罗父亲在心生愧疚的时候，说话是快一点好还是慢一点好呢？"
                },
                {
                    "id": "735010205",
                    "speaker": "丹吉尔",
                    "text": "这个其实就要取决于兰那罗儿子了，让他们说话速度不一样会更有趣一点。"
                },
                {
                    "id": "735010206",
                    "speaker": "派蒙",
                    "text": "丹吉尔先生，拉齐，你们好！你们在干什么呀？"
                },
                {
                    "id": "735010207",
                    "speaker": "拉齐",
                    "text": "嗯，我在和爸爸讨论新童话的内容，这一次，就会由我自己来向大家讲述童话啦。"
                },
                {
                    "id": "735010208",
                    "speaker": "拉齐",
                    "text": "不过一想到要在很多人面前讲自己的故事，我还是有点紧张，所以想要知道有哪些需要注意的。"
                },
                {
                    "id": "735010209",
                    "speaker": "派蒙",
                    "text": "噢！须弥要多一位年纪不大的童话作者了。"
                },
                {
                    "id": "735010210",
                    "speaker": "丹吉尔",
                    "text": "谢谢你们，如果不是你们及时出现，拉齐恐怕真的会离我而去了。"
                },
                {
                    "id": "735010211",
                    "speaker": "派蒙",
                    "text": "真不错，看起来一切都解决了！"
                },
                {
                    "id": "735010212",
                    "speaker": "派蒙",
                    "text": "不过，我突然想起来，有一件事还是很可疑！"
                },
                {
                    "id": "735010213",
                    "speaker": "柯莱",
                    "text": "嗯？什么事？需要我帮忙吗？"
                },
                {
                    "id": "735010214",
                    "speaker": "派蒙",
                    "text": "为什么道成林的那个树洞里，会有蒙德人留下的纸条呢？"
                },
                {
                    "id": "735010215",
                    "speaker": "柯莱",
                    "text": "为…为什么到现在还想着这件事，我觉得单纯就是巧合啦，巧合！"
                },
                {
                    "id": "735010216",
                    "speaker": "柯莱",
                    "text": "把秘密写到纸条上再贴到树洞里也是很常见的习惯啦。我觉得这件事没什么好在意的…",
                    "choices": [
                        {
                            "id": "735010217",
                            "text": "柯莱突然好激动。",
                            "response": [
                                {
                                    "id": "735010219",
                                    "speaker": "柯莱",
                                    "text": "呜…呜呜呜…好吧。"
                                },
                                {
                                    "id": "735010220",
                                    "speaker": "柯莱",
                                    "text": "其实，我也有秘密，一些烦恼。我也有向着树洞说出秘密的习惯。"
                                },
                                {
                                    "id": "735010221",
                                    "speaker": "柯莱",
                                    "text": "不过，看到现在的拉齐和丹吉尔先生，我有了一个想法："
                                },
                                {
                                    "id": "735010222",
                                    "speaker": "柯莱",
                                    "text": "#{NICKNAME}，你可以成为我的树洞吗？",
                                    "choices": [
                                        {
                                            "id": "735010223",
                                            "text": "乐意之至。"
                                        },
                                        {
                                            "id": "735010224",
                                            "text": "可以。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735010218",
                            "text": "真的很常见吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7350101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735010101",
                    "speaker": "卡西特",
                    "text": "唔…怎么今天买到的还是这一种，我明明想要那个最圆嘟嘟，看起来最弹弹的。"
                },
                {
                    "id": "735010102",
                    "speaker": "卡西特",
                    "text": "算了，再攒一点零花钱吧，我一定要收集全。"
                },
                {
                    "id": "735010103",
                    "speaker": "阿利娅",
                    "text": "欸…我记得你最近每天都有来买吧？还没有收集全？"
                },
                {
                    "id": "735010104",
                    "speaker": "阿利娅",
                    "text": "不如买那个兰那罗木刻套装，一套里面有七个不重复的。"
                },
                {
                    "id": "735010105",
                    "speaker": "卡西特",
                    "text": "那就没有惊喜了…"
                },
                {
                    "id": "735010106",
                    "speaker": "阿利娅",
                    "text": "我不想要惊喜，就只想每一种都要有，这才是用心的表现！"
                },
                {
                    "id": "735010107",
                    "speaker": "阿利娅",
                    "text": "今天我就是攒齐了钱，特意来买木刻套装的。"
                },
                {
                    "id": "735010108",
                    "speaker": "马姆杜",
                    "text": "啊，非常抱歉，刚刚卖给卡西特小朋友的是最后一件，今天本店的货物已经卖完了。"
                },
                {
                    "id": "735010128",
                    "speaker": "马姆杜",
                    "text": "我们正在招募新的雕刻师，还请明天再次光临。"
                },
                {
                    "id": "735010109",
                    "speaker": "阿利娅",
                    "text": "好吧…那我明天再来。等等，你怎么能称呼兰那罗木刻叫做货物！"
                },
                {
                    "id": "735010110",
                    "speaker": "卡西特",
                    "text": "就是就是！"
                },
                {
                    "id": "735010111",
                    "speaker": "马姆杜",
                    "text": "好好好，我错了，我错了…"
                },
                {
                    "id": "735010112",
                    "speaker": "法伊兹",
                    "text": "抱歉，今天本店的兰那罗木刻已经全都卖完了。"
                },
                {
                    "id": "735010113",
                    "speaker": "鲁希",
                    "text": "卖完了？这可怎么办…我还打算多买几个，送给明天来玩的表弟呢。"
                },
                {
                    "id": "735010114",
                    "speaker": "法伊兹",
                    "text": "那这样吧，小朋友，我记得你家是住在拉齐家附近吧？明天一早我们就把新雕好的木刻送到你家里去。"
                },
                {
                    "id": "735010115",
                    "speaker": "鲁希",
                    "text": "谢谢你，法伊兹叔叔！千万不要忘了哦。"
                },
                {
                    "id": "735010116",
                    "speaker": "法伊兹",
                    "text": "不会的，我们阿折罗造像，从不辜负小朋友们的期待。"
                },
                {
                    "id": "735010117",
                    "speaker": "法伊兹",
                    "text": "啊，又有新的客人来了。抱歉，今天本店的兰那罗木刻…"
                },
                {
                    "id": "735010118",
                    "speaker": "法伊兹",
                    "text": "原来是你们，谢谢你们的帮助。本来我们还想专程道谢，但是如你们所见，最近实在是太忙了…"
                },
                {
                    "id": "735010119",
                    "speaker": "法伊兹",
                    "text": "没有你们，阿折罗造像的二十年庆可能就是另外一副样子了。",
                    "choices": [
                        {
                            "id": "735010120",
                            "text": "看起来生意非常好。",
                            "response": [
                                {
                                    "id": "735010122",
                                    "speaker": "法伊兹",
                                    "text": "这些都是托拉齐的福，没想到小小年纪就能有那么多奇思妙想。"
                                },
                                {
                                    "id": "735010123",
                                    "speaker": "法伊兹",
                                    "text": "哦对了，为了表示感谢，本店还打算把「试作兰那罗」赠送给你们，当做纪念。"
                                },
                                {
                                    "id": "735010124",
                                    "speaker": "柯莱",
                                    "text": "哇这是什么…让人觉得很…很…"
                                },
                                {
                                    "id": "735010125",
                                    "speaker": "Player",
                                    "text": "震撼。"
                                },
                                {
                                    "id": "735010126",
                                    "speaker": "柯莱",
                                    "text": "对对对，震撼，看起来很神秘。"
                                },
                                {
                                    "id": "735010127",
                                    "speaker": "派蒙",
                                    "text": "唔，到底要不要接收这份礼物，请等我们再仔细考虑考虑。"
                                }
                            ]
                        },
                        {
                            "id": "735010121",
                            "text": "兰那罗真的很受欢迎。"
                        }
                    ]
                },
                {
                    "id": "735010129",
                    "speaker": "Black Screen",
                    "text": "阿折罗造像的危机已经解决。接下来的拜访对象是拉齐与丹吉尔。"
                }
            ]
        },
