        },
        {
            "id": "7350199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "735019901",
                    "speaker": "派蒙",
                    "text": "快要到阿折罗造像二十周年店庆了，也不知道小朋友们到底喜不喜欢我们辛苦准备的木刻，一起去看看吧？"
                },
                {
                    "id": "735019902",
                    "speaker": "派蒙",
                    "text": "阿折罗造像的危机已经解决啦。接下来我们再去看看丹吉尔先生和拉齐怎么样？"
                }
            ]
        }
