    "talks": [
        {
            "id": "7152301",
            "objective": "与廷稚对话",
            "dialogues": [
                {
                    "id": "715230101",
                    "speaker": "廷稚",
                    "text": "唔，这样应该就不会太困难了…"
                },
                {
                    "id": "715230102",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "715230103",
                    "speaker": "廷稚",
                    "text": "我正在布置我所负责的这种游戏呢…您听说过「百步礼掷」吗？"
                },
                {
                    "id": "715230104",
                    "speaker": "Player",
                    "text": "我是要隔着很远，礼貌地丢东西吗？"
                },
                {
                    "id": "715230105",
                    "speaker": "廷稚",
                    "text": "您…非常敏锐，已经说对了大半，这种游戏的核心正是「丢掷」。但「礼」字可不是如此解法。"
                },
                {
                    "id": "715230106",
                    "speaker": "廷稚",
                    "text": "这种玩法我也是从一本古书里看来的，让我为您简单介绍一下…"
                },
                {
                    "id": "715230107",
                    "speaker": "廷稚",
                    "text": "按照最传统的游戏规则，玩这种名为「礼掷」的游戏时，所有参与者都需要静坐下来。"
                },
                {
                    "id": "715230108",
                    "speaker": "廷稚",
                    "text": "呃，静坐的时候还需要保持一个特别的姿势，我就不为您示范了，这里没垫子…"
                },
                {
                    "id": "715230109",
                    "speaker": "廷稚",
                    "text": "静坐之后，游玩者需要遵循着某种特定音乐的节奏，将手里的「掷箭」投向远处的「容壶」。"
                },
                {
                    "id": "715230110",
                    "speaker": "廷稚",
                    "text": "「掷箭」入壶的各种方式，也有着各自的特别命名。"
                },
                {
                    "id": "715230111",
                    "speaker": "廷稚",
                    "text": "比如第一支被投入壶中的箭，被叫做「有初」，如果第二箭也投进去了，那就叫做「连中」。"
                },
                {
                    "id": "715230112",
                    "speaker": "廷稚",
                    "text": "投出去的箭击中了壶耳，那就被称为「贯耳」。一支箭本来已经投入壶中，却又跳出来，则被叫做「骁箭」…",
                    "choices": [
                        {
                            "id": "715230113",
                            "text": "太、太复杂了！",
                            "response": [
                                {
                                    "id": "715230114",
                                    "speaker": "廷稚",
                                    "text": "您别担心啊，我刚才不都说了，这只是「最传统的游戏规则」。"
                                },
                                {
                                    "id": "715230115",
                                    "speaker": "廷稚",
                                    "text": "为了方便大家游玩，我已经将规则简化了许多。"
                                },
                                {
                                    "id": "715230118",
                                    "speaker": "廷稚",
                                    "text": "咳，总之，您只需要记住，在一定的时间内，往那个壶里投入越多的「掷箭」越好，其余的…就交给我！"
                                },
                                {
                                    "id": "715230119",
                                    "speaker": "Player",
                                    "text": "好简化的规则！"
                                },
                                {
                                    "id": "715230120",
                                    "speaker": "廷稚",
                                    "text": "哎呀…那本书上写的游戏规则中，本来也写着谁投入壶中的箭越多，谁就获胜嘛。"
                                },
                                {
                                    "id": "715230121",
                                    "speaker": "廷稚",
                                    "text": "至于输的人要饮酒作诗之类的…我总不能真让玩游戏的人输了就作诗吧，那多少有些难为人了。"
                                },
                                {
                                    "id": "715230122",
                                    "speaker": "廷稚",
                                    "text": "总之！场地我差不多已经布置好了，「容壶」就在那边，我等会再把「掷箭」拿过来。"
                                },
                                {
                                    "id": "715230123",
                                    "speaker": "廷稚",
                                    "text": "有兴趣的话，您现在就可以去试玩一下了。"
                                }
                            ]
                        },
                        {
                            "id": "715230116",
                            "text": "记、记不住！",
                            "response": [
                                {
                                    "id": "715230117",
                                    "speaker": "廷稚",
                                    "text": "别担心，您不需要记住这么多名词，这是…呃，这是我应该记住的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}