    "talks": [
        {
            "id": "7212301",
            "objective": "",
            "dialogues": [
                {
                    "id": "721230101",
                    "speaker": "阿幸",
                    "text": "嗯？是旅行者啊，怎么这种时候又在这里见面了…你啊，运气未免太差了吧？"
                },
                {
                    "id": "721230102",
                    "speaker": "阿幸",
                    "text": "如果你是来赏樱的，现在可完全不是时候，还是别抱什么期待为好。"
                },
                {
                    "id": "721230103",
                    "speaker": "阿幸",
                    "text": "以前到这里赏樱的游客也不少，但现在已经没人会到这种争端频发的地方游玩了。",
                    "choices": [
                        {
                            "id": "721230104",
                            "text": "不是来看雷樱树的。",
                            "response": [
                                {
                                    "id": "721230105",
                                    "speaker": "阿幸",
                                    "text": "正巧路过的么？那我得提醒你，雷樱树遭到了破坏，我之前来查看的时候，它们的状态…不太对劲。"
                                },
                                {
                                    "id": "721230109",
                                    "speaker": "阿幸",
                                    "text": "不小心靠近雷樱树的话，有可能遇到危险，请千万注意。",
                                    "choices": [
                                        {
                                            "id": "721230110",
                                            "text": "雷樱树是什么？",
                                            "response": [
                                                {
                                                    "id": "721230112",
                                                    "speaker": "阿幸",
                                                    "text": "看来你还完全不了解情况啊，也难怪，你毕竟不是神社的人。"
                                                },
                                                {
                                                    "id": "721230113",
                                                    "speaker": "阿幸",
                                                    "text": "不知道你有没有见过鸣神大社中供奉的神樱树，那是鸣神大人力量的象征，鸣神大人永恒常在，神樱花也永远繁茂美丽。"
                                                },
                                                {
                                                    "id": "721230114",
                                                    "speaker": "阿幸",
                                                    "text": "在神社之外，神无冢上还生长着与神樱树同源的雷樱树，它们也拥有着类似于神樱树的力量。"
                                                },
                                                {
                                                    "id": "721230115",
                                                    "speaker": "阿幸",
                                                    "text": "但是最近，雷樱树遭到了破坏，花朵不再绽放，这恐怕是不好的征兆。"
                                                },
                                                {
                                                    "id": "721230116",
                                                    "speaker": "阿幸",
                                                    "text": "连神子大人都被这件事惊动了，所以才会派我到神无冢来调查情况。"
                                                },
                                                {
                                                    "id": "721230117",
                                                    "speaker": "阿幸",
                                                    "text": "就我目前的调查结果来看，有一伙盗宝团经常绕着雷樱树转悠，非常可疑，我一定要弄明白他们和这件事间的关联。"
                                                },
                                                {
                                                    "id": "721230118",
                                                    "speaker": "阿幸",
                                                    "text": "不过，那个…我就直说了，我不会打架，盗宝团的那些家伙看起来又很凶恶…"
                                                },
                                                {
                                                    "id": "721230119",
                                                    "speaker": "阿幸",
                                                    "text": "旅行者，我想委托你去那些家伙的营地里调查一下，看看他们到底想做什么。"
                                                },
                                                {
                                                    "id": "721230120",
                                                    "speaker": "阿幸",
                                                    "text": "我原本以为自己一个人来调查是绰绰有余，现在看来…情况有点复杂，只能请你帮忙了。"
                                                },
                                                {
                                                    "id": "721230121",
                                                    "speaker": "阿幸",
                                                    "text": "拜托了，旅行者。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721230111",
                                            "text": "雷樱树怎么了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721230106",
                            "text": "那太可惜了。",
                            "response": [
                                {
                                    "id": "721230107",
                                    "speaker": "阿幸",
                                    "text": "岂止可惜？简直令人愤怒。雷樱树受到破坏之后的状态，实在太让人心痛了。"
                                },
                                {
                                    "id": "721230108",
                                    "speaker": "阿幸",
                                    "text": "而且我之前来查看的时候，它们的状态…不太对劲。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7212302",
            "objective": "和阿幸对话",
            "dialogues": []
        },
        {
            "id": "7212303",
            "objective": "调查盗宝团营地",
            "dialogues": [
                {
                    "id": "721230301",
                    "speaker": "阿幸",
                    "text": "你有什么发现吗？"
                },
                {
                    "id": "721230302",
                    "speaker": "Player",
                    "text": "关于秀秋…"
                },
                {
                    "id": "721230303",
                    "speaker": "阿幸",
                    "text": "居然有这么一回事？但盗宝团动的那点小手脚真能引起这么严重的后果吗？"
                },
                {
                    "id": "721230304",
                    "speaker": "阿幸",
                    "text": "雷樱树的凋零说不定还有其他原因…我有些猜想，不知道准不准确…"
                },
                {
                    "id": "721230305",
                    "speaker": "Player",
                    "text": "什么意思？"
                },
                {
                    "id": "721230306",
                    "speaker": "阿幸",
                    "text": "这里是神无冢啊，不论是稻妻人的信仰，还是珊瑚宫人的信仰，都无法照耀的地方。"
                },
                {
                    "id": "721230307",
                    "speaker": "阿幸",
                    "text": "眼狩令颁布之后，幕府军和叛军经常在这里发生冲突，军队的人可不会在乎是否波及到了雷樱树。"
                },
                {
                    "id": "721230308",
                    "speaker": "阿幸",
                    "text": "用神子大人的话来说，那都是些「满脑子只有功勋的家伙」，没法讲道理。"
                },
                {
                    "id": "721230309",
                    "speaker": "阿幸",
                    "text": "我们神社对这一点早就有心理准备，但是没想到，雷樱树的状况已经糟到这个地步了…"
                },
                {
                    "id": "721230310",
                    "speaker": "阿幸",
                    "text": "总之，当务之急是把盗宝团动的那些小手脚清理掉，旅行者，我能再次拜托你吗？",
                    "choices": [
                        {
                            "id": "721230311",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "721230312",
                                    "speaker": "阿幸",
                                    "text": "请千万不要掉以轻心，正因为雷樱树变得脆弱了情况才会变危险，毕竟树下还镇守着那位大人的…"
                                },
                                {
                                    "id": "721230315",
                                    "speaker": "阿幸",
                                    "text": "啊，我不该多嘴的，你、你就当没听见吧。总之，一定要小心。"
                                },
                                {
                                    "id": "721230316",
                                    "speaker": "阿幸",
                                    "text": "我也需要点时间整理状况，毕竟这件事现在还有疑点：到底是谁在背后指点盗宝团？"
                                },
                                {
                                    "id": "721230317",
                                    "speaker": "阿幸",
                                    "text": "事情变得复杂起来了，真是棘手…"
                                }
                            ]
                        },
                        {
                            "id": "721230313",
                            "text": "清理应该很容易吧。",
                            "response": [
                                {
                                    "id": "721230314",
                                    "speaker": "阿幸",
                                    "text": "恐怕没那么简单，正因为雷樱树变得脆弱了情况才会变危险，毕竟树下还镇守着那位大人的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7212304",
            "objective": "调查盗宝团营地",
            "dialogues": [
                {
                    "id": "721230401",
                    "speaker": "阿幸",
                    "text": "雷樱树怎么样了？"
                },
                {
                    "id": "721230402",
                    "speaker": "Player",
                    "text": "「小手脚」已经全被清理掉了。"
                },
                {
                    "id": "721230403",
                    "speaker": "阿幸",
                    "text": "太好了，这样雷樱树的状况也会稳定下来，神子大人应该也能安心了。"
                },
                {
                    "id": "721230404",
                    "speaker": "阿幸",
                    "text": "这些胆大妄为的家伙，竟敢盗窃雷樱树的力量用来牟利，简直罪无可恕。"
                },
                {
                    "id": "721230405",
                    "speaker": "阿幸",
                    "text": "而且你提到，盗宝团营地里有一颗聚集雷樱树力量的结晶？那也太危险了，一定要尽快处理。"
                },
                {
                    "id": "721230406",
                    "speaker": "阿幸",
                    "text": "之前麻烦你帮了我那么多，这次我实在不好意思再让你一个人行动了，我也会去一起处理的。"
                },
                {
                    "id": "721230407",
                    "speaker": "阿幸",
                    "text": "事不宜迟，我们现在就走吧。"
                }
            ]
        },
        {
            "id": "7212305",
            "objective": "盘问剩下的盗宝团成员",
            "dialogues": [
                {
                    "id": "721230204",
                    "speaker": "秀秋",
                    "text": "别、别杀我，雷樱树的事情跟我一点关系都没有。"
                },
                {
                    "id": "721230205",
                    "speaker": "派蒙",
                    "text": "你怎么知道我们是为了雷樱树的事情来的？你果然做了亏心事！"
                },
                {
                    "id": "721230206",
                    "speaker": "派蒙",
                    "text": "恐怕这个和无相之雷一样的东西，也是你们从不正当渠道弄来的吧。"
                },
                {
                    "id": "721230207",
                    "speaker": "秀秋",
                    "text": "我…你们…这关你们什么事！"
                },
                {
                    "id": "721230208",
                    "speaker": "Player",
                    "text": "我受人之托。"
                },
                {
                    "id": "721230209",
                    "speaker": "派蒙",
                    "text": "对，我们受人之托，代行正义！盗宝团到底对雷樱树做了什么，这东西是哪里来的，快老实交待。"
                },
                {
                    "id": "721230210",
                    "speaker": "派蒙",
                    "text": "不乖乖交待的话，哼哼，旅行者的剑可是很厉害的。"
                },
                {
                    "id": "721230211",
                    "speaker": "秀秋",
                    "text": "我说我说！那什么，这几棵树反正也没人管，我带弟兄几个借它们的力量赚一笔也没什么吧。"
                },
                {
                    "id": "721230212",
                    "speaker": "秀秋",
                    "text": "有个厉害的买家对雷樱树有点兴趣，而且对方连导出雷樱树力量的方法和工具都提供好了。"
                },
                {
                    "id": "721230213",
                    "speaker": "秀秋",
                    "text": "只要我们按照买家说的，在树上开个口子，嘿嘿，要用工具汲取雷樱树的力量就轻轻松松了。"
                },
                {
                    "id": "721230214",
                    "speaker": "秀秋",
                    "text": "然后再把力量导入到这座结晶里去，咱就赚到了能抵三座天领奉行大宅的宝贝。"
                },
                {
                    "id": "721230215",
                    "speaker": "秀秋",
                    "text": "买家可是提供了一大笔报酬，你这种小角色一辈子也花不完。"
                },
                {
                    "id": "721230216",
                    "speaker": "秀秋",
                    "text": "你愿意放过我的话，我还能勉为其难算你一份，到时候一九分账，你一我们九。怎么样？",
                    "choices": [
                        {
                            "id": "721230217",
                            "text": "太少了吧。",
                            "response": [
                                {
                                    "id": "721230219",
                                    "speaker": "秀秋",
                                    "text": "什么？可恶，我可是好心给你们提供生路，等买主到了，你们都得哭着来求我秀秋大爷的原谅！"
                                },
                                {
                                    "id": "721230220",
                                    "speaker": "派蒙",
                                    "text": "口气也太大了吧。"
                                },
                                {
                                    "id": "721230221",
                                    "speaker": "秀秋",
                                    "text": "小东西，你嚣张什么，我的兄弟们马上就会找到帮手回来救我。"
                                },
                                {
                                    "id": "721230222",
                                    "speaker": "派蒙",
                                    "text": "哪怕你们再叫一百个人来，也碰不到派蒙我的一根头发，旅行者会把你们统统打跑。"
                                },
                                {
                                    "id": "721230223",
                                    "speaker": "秀秋",
                                    "text": "山田，这小东西说你们根本伤不着她，你还不出手？"
                                },
                                {
                                    "id": "721230224",
                                    "speaker": "派蒙",
                                    "text": "山田？那是谁呀…不好！旅行者快！"
                                },
                                {
                                    "id": "721230225",
                                    "speaker": "派蒙",
                                    "text": "欸？根本什么人都没有嘛…"
                                }
                            ]
                        },
                        {
                            "id": "721230218",
                            "text": "在做梦吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7212306",
            "objective": "向阿幸回报",
            "dialogues": []
        },
        {
            "id": "7212307",
            "objective": "清理盗宝团留在雷樱树上的「小手脚」",
            "dialogues": [
                {
                    "id": "721230701",
                    "speaker": "秀秋",
                    "text": "别…别追了，已经绕了三圈又绕回原地了，我实在跑不动了…"
                },
                {
                    "id": "721230702",
                    "speaker": "阿幸",
                    "text": "为了利益不惜与外人勾结，你这家伙十恶不赦！就算让我再跑十圈我也绝对不会饶了你。"
                },
                {
                    "id": "721230703",
                    "speaker": "阿幸",
                    "text": "呼…旅行者，看你一脸轻松，刚才的麻烦已经都解决掉了吧，感谢你帮了我这么多忙。"
                },
                {
                    "id": "721230704",
                    "speaker": "阿幸",
                    "text": "雷樱树的力量绝对不能落入这种家伙的手里，更何况这件事背后还有愚人众作祟。"
                },
                {
                    "id": "721230705",
                    "speaker": "阿幸",
                    "text": "很难说愚人众到底打了什么鬼主意，我既然逮住了这家伙，就一定会问个明白。"
                },
                {
                    "id": "721230706",
                    "speaker": "阿幸",
                    "text": "后续的处理就交给我吧，幕府军驻扎的地方我也认识，这家伙是跑不掉了。"
                }
            ]
        },
        {
            "id": "7212308",
            "objective": "清理盗宝团留在雷樱树上的「小手脚」",
            "dialogues": [
                {
                    "id": "721230801",
                    "speaker": "阿幸",
                    "text": "雷樱树遭到破坏，实在是有损神社的颜面，得赶快查清这件事才行。"
                }
            ]
        },
        {
            "id": "7212309",
            "objective": "清理盗宝团留在雷樱树上的「小手脚」",
            "dialogues": [
                {
                    "id": "721230901",
                    "speaker": "阿幸",
                    "text": "说起来，雷樱树的位置你应该都知道吧？"
                },
                {
                    "id": "721230902",
                    "speaker": "阿幸",
                    "text": "…看你的反应，我明白了，你应该还不清楚雷樱树的位置。也难怪，你毕竟是外来的旅行者，是我想当然了。"
                },
                {
                    "id": "721230903",
                    "speaker": "阿幸",
                    "text": "那五棵雷樱树并不难找，只要沿着<color=#00E1FFFF>西侧的海岸线</color>，从九条阵屋所在岛屿的<color=#00E1FFFF>最北端</color>一路走到<color=#00E1FFFF>踏鞴砂的最北端</color>，就能发现其中三棵。"
                },
                {
                    "id": "721230904",
                    "speaker": "阿幸",
                    "text": "另外两棵雷樱树，一棵长在<color=#00E1FFFF>踏鞴砂西北面</color>的山崖上，一棵长在<color=#00E1FFFF>踏鞴砂西南面</color>的山崖上。"
                },
                {
                    "id": "721230905",
                    "speaker": "阿幸",
                    "text": "现在我给你指明了方向，事情应该容易些了。那么，雷樱树的事情就拜托你了，路上还请小心。"
                }
            ]
        },
        {
            "id": "7212310",
            "objective": "清理盗宝团留在雷樱树上的「小手脚」",
            "dialogues": []
        },
        {
            "id": "7212311",
            "objective": "清理盗宝团留在雷樱树上的「小手脚」",
            "dialogues": []
        },
        {
            "id": "7212314",
            "objective": "向阿幸回报",
            "dialogues": []
        },
        {
            "id": "7212315",
            "objective": "再次前往盗宝团营地调查",
            "dialogues": [
                {
                    "id": "721230501",
                    "speaker": "秀秋",
                    "text": "哼，原来是你这个女人要妨碍我赚钱。"
                },
                {
                    "id": "721230502",
                    "speaker": "阿幸",
                    "text": "你们真是不知好歹，雷樱树的主意也敢打，神子大人不会让你们好过的。"
                },
                {
                    "id": "721230503",
                    "speaker": "秀秋",
                    "text": "少说大话了，你们也不看看惹到的是谁！"
                },
                {
                    "id": "721230504",
                    "speaker": "秀秋",
                    "text": "大爷，妨碍您生意的就是那边那个旅行者，您不出手咱们的买卖就悬了。"
                },
                {
                    "id": "721230505",
                    "speaker": "愚人众先遣队",
                    "text": "呵呵，就凭这弱不禁风的身板，也敢在我面前逞威风？"
                }
            ]
        },
        {
            "id": "7212316",
            "objective": "击退来袭的愚人众",
            "dialogues": []
        },
        {
            "id": "7212317",
            "objective": "与阿幸对话",
            "dialogues": [
                {
                    "id": "721230602",
                    "speaker": "秀秋",
                    "text": "晦气，我这是碰上了什么硬骨头。"
                },
                {
                    "id": "721230603",
                    "speaker": "阿幸",
