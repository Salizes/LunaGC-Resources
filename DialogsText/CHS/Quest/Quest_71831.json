        {
            "id": "7183102",
            "objective": "回到铜雀雕像所在地",
            "dialogues": [
                {
                    "id": "718310201",
                    "speaker": "王平安",
                    "text": "香炉就在那边，您要敬香的话就过去吧。"
                }
            ]
        },
        {
            "id": "7183103",
            "objective": "与王平安对话",
            "dialogues": [
                {
                    "id": "718310301",
                    "speaker": "王平安",
                    "text": "这庙看着还算不错…"
                },
                {
                    "id": "718310302",
                    "speaker": "Player",
                    "text": "确实很不错。"
                },
                {
                    "id": "718310303",
                    "speaker": "王平安",
                    "text": "欸？您来得倒是刚刚好，这庙才修好不久，我刚给工匠们结完钱呢。"
                },
                {
                    "id": "718310304",
                    "speaker": "王平安",
                    "text": "唉…没想到居然花了这么多钱，我辛苦赚的那些钱，已经全部砸里面了…"
                },
                {
                    "id": "718310305",
                    "speaker": "王平安",
                    "text": "不过无论如何，这庙建好了就行。"
                },
                {
                    "id": "718310306",
                    "speaker": "王平安",
                    "text": "您想去庙里敬敬香吗？我还专门托人做了一个新香炉呢。",
                    "choices": [
                        {
                            "id": "718310307",
                            "text": "好。",
                            "response": [
                                {
                                    "id": "718310310",
                                    "speaker": "王平安",
                                    "text": "这几柱香您拿着，香炉就在那边。"
                                }
                            ]
                        },
                        {
                            "id": "718310308",
                            "text": "你也敬香了？",
                            "response": [
                                {
                                    "id": "718310309",
                                    "speaker": "王平安",
                                    "text": "那当然。庙刚建好之后，我可是敬了一柱上好的香，刚刚才烧完了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7183104",
            "objective": "向铜雀敬香",
            "dialogues": []
        },
        {
            "id": "7183105",
            "objective": "与王平安对话",
            "dialogues": [
                {
                    "id": "718310501",
                    "speaker": "王平安",
                    "text": "您敬好香了吧，感觉怎么样？"
                },
                {
                    "id": "718310502",
                    "speaker": "Player",
                    "text": "还不错。"
                },
                {
                    "id": "718310503",
                    "speaker": "王平安",
                    "text": "那就好。希望这座庙以后香火会盛一点…"
                },
                {
                    "id": "718310504",
                    "speaker": "王平安",
                    "text": "我会暂时待在这里一段时间。这里很清静，是个进行编写工作的好地方。"
                },
                {
                    "id": "718310505",
                    "speaker": "王平安",
                    "text": "我得尽快整理一下我之前搜集的那些资料，然后继续编写那本有关「护法夜叉」的书。"
                },
                {
                    "id": "718310506",
                    "speaker": "王平安",
                    "text": "您以后有空的话，也可以多来这庙里看看。"
                },
                {
                    "id": "718310507",
                    "speaker": "王平安",
                    "text": "想要敬香的话，直接找我拿香就好了。"
                },
                {
                    "id": "718310508",
                    "speaker": "王平安",
                    "text": "唉，其实我还想把周围也再整修一下…"
                },
                {
                    "id": "718310509",
                    "speaker": "王平安",
                    "text": "路得重新铺一遍，两边要加上围栏，旁边还要再做个花圃…"
                }
            ]
        },
        {
            "id": "7183003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718300301",
                    "speaker": "王平安",
                    "text": "慢点拆，慢点拆！别把雕像给碰坏了！"
                },
                {
                    "id": "718300302",
                    "speaker": "王平安",
                    "text": "唉，看来还得建一段时间啊…"
                }
            ]
        }
    ]
