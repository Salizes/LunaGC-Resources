    "talks": [
        {
            "id": "37901",
            "objective": "将天空之琴带回酒馆",
            "dialogues": []
        },
        {
            "id": "37902",
            "objective": "与温迪对话",
            "dialogues": [
                {
                    "id": "3790201",
                    "speaker": "温迪",
                    "text": "哟，欢迎回来，我忠实的听众们。"
                },
                {
                    "id": "3790202",
                    "speaker": "温迪",
                    "text": "啊，那是…天空之琴！看来你们搞定了呢。"
                },
                {
                    "id": "3790203",
                    "speaker": "温迪",
                    "text": "流风纹的蔷薇木、微凉的星铁弦，真是怀念的感觉…"
                },
                {
                    "id": "3790204",
                    "speaker": "琴",
                    "text": "怎么样，温迪？可以用它来呼唤特瓦林了吗？"
                },
                {
                    "id": "3790205",
                    "speaker": "温迪",
                    "text": "嗯…虽然是如假包换的风神至宝，但现在恐怕还不行。"
                },
                {
                    "id": "3790206",
                    "speaker": "温迪",
                    "text": "——如你们所见，历经千年的时光，「风」的力量早就枯竭了呢。"
                },
                {
                    "id": "3790207",
                    "speaker": "温迪",
                    "text": "这个状态的话，要在迪卢克家的酒馆驻唱，也许还行…"
                },
                {
                    "id": "3790208",
                    "speaker": "迪卢克",
                    "text": "酒馆的演出位也是有一大堆歌手竞标的，你别太想当然了。"
                },
                {
                    "id": "3790209",
                    "speaker": "派蒙",
                    "text": "迪卢克老爷应该批评更重要的地方吧！"
                },
                {
                    "id": "3790210",
                    "speaker": "派蒙",
                    "text": "喂，歌手！你把天空之琴借出来，就是为了弹给醉鬼听的吗？"
                },
                {
                    "id": "3790211",
                    "speaker": "温迪",
                    "text": "欸嘿。"
                },
                {
                    "id": "3790212",
                    "speaker": "派蒙",
                    "text": "「欸嘿」是什么意思啊…！！"
                },
                {
                    "id": "3790213",
                    "speaker": "温迪",
                    "text": "总而言之，想要与特瓦林沟通，这还远远不够。"
                },
                {
                    "id": "3790214",
                    "speaker": "温迪",
                    "text": "不过，并不是琴的问题，而是琴弦——"
                },
                {
                    "id": "3790215",
                    "speaker": "温迪",
                    "text": "到你出马的时候了，异乡人！",
                    "choices": [
                        {
                            "id": "3790216",
                            "text": "我？",
                            "response": [
                                {
                                    "id": "3790218",
                                    "speaker": "温迪",
                                    "text": "放心，我不是说让你去维修这珍贵的竖琴。"
                                },
                                {
                                    "id": "3790219",
                                    "speaker": "温迪",
                                    "text": "而是这些琴弦上附着的「风」之元素，浓度还远远不够。"
                                },
                                {
                                    "id": "3790220",
                                    "speaker": "温迪",
                                    "text": "#{NICKNAME}，你有好好保存特瓦林的泪水结晶吧？"
                                },
                                {
                                    "id": "3790221",
                                    "speaker": "Player",
                                    "text": "（点头）"
                                }
                            ]
                        },
                        {
                            "id": "3790217",
                            "text": "我对乐器的修理没有什么心得。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "37903",
            "objective": "将特瓦林的泪水结晶滴在天空之琴上",
            "dialogues": [
                {
                    "id": "3790301",
                    "speaker": "温迪",
                    "text": "事不宜迟，赶紧把泪滴结晶滴在天空之琴上吧！"
                }
            ]
        },
        {
            "id": "37904",
            "objective": "与琴对话",
            "dialogues": [
                {
                    "id": "3790401",
                    "speaker": "温迪",
                    "text": "哦呼。不出所料。"
                },
                {
                    "id": "3790402",
                    "speaker": "琴",
                    "text": "琴似乎有种…青春焕发的感觉？"
                },
                {
                    "id": "3790403",
                    "speaker": "派蒙",
                    "text": "团长在夸奖自己耶。"
                },
                {
                    "id": "3790404",
                    "speaker": "琴",
                    "text": "…我是说天空之琴啦。"
                },
                {
                    "id": "3790405",
                    "speaker": "温迪",
                    "text": "#全靠{NICKNAME}净化结晶，天空之琴的「风」之元素才没有继续枯竭。"
                },
                {
                    "id": "3790406",
                    "speaker": "温迪",
                    "text": "但距离重新满溢也还有一些距离呢。如果能再多得到一些特瓦林的泪滴…",
                    "choices": [
                        {
                            "id": "3790407",
                            "text": "我们会帮忙的。",
                            "response": [
                                {
                                    "id": "3790408",
                                    "speaker": "派蒙",
                                    "text": "但要怎么收集泪水结晶呢？"
                                },
                                {
                                    "id": "3790411",
                                    "speaker": "温迪",
                                    "text": "即使是现在，特瓦林也正在哭泣吧。"
                                },
                                {
                                    "id": "3790412",
                                    "speaker": "温迪",
                                    "text": "承受着痛苦，在人迹罕至的地方…"
                                },
                                {
                                    "id": "3790413",
                                    "speaker": "琴",
                                    "text": "特瓦林…"
                                },
                                {
                                    "id": "3790414",
                                    "speaker": "派蒙",
                                    "text": "真是个可怜的大家伙…"
                                },
                                {
                                    "id": "3790415",
                                    "speaker": "琴",
                                    "text": "这不是荣誉骑士一个人的事，我们都会立刻开始行动。"
                                },
                                {
                                    "id": "3790416",
                                    "speaker": "琴",
                                    "text": "#得到泪滴结晶以后，就再拜托{NICKNAME}来净化了。"
                                },
                                {
                                    "id": "3790417",
                                    "speaker": "Player",
                                    "text": "交给我吧。"
                                },
                                {
                                    "id": "3790418",
                                    "speaker": "温迪",
                                    "text": "嗯…真好啊。英雄们相互托付、携手启程的桥段，总是那么迷人呢。"
                                },
                                {
                                    "id": "3790419",
                                    "speaker": "温迪",
                                    "text": "就让我用这一曲来为你们送行吧…"
                                },
                                {
                                    "id": "3790420",
                                    "speaker": "派蒙",
                                    "text": "咦？你这是想偷懒…想只出一张嘴吗？"
                                },
                                {
                                    "id": "3790421",
                                    "speaker": "温迪",
                                    "text": "弹琴需要用到手呢。"
                                },
                                {
                                    "id": "3790422",
                                    "speaker": "派蒙",
                                    "text": "呜啊，好生气。我决定给你起一个难听的绰号。"
                                },
                                {
                                    "id": "3790423",
                                    "speaker": "派蒙",
                                    "text": "唔…决定了，以后就叫你「<color=#00E1FFFF>卖唱的</color>」好了！"
                                }
                            ]
                        },
                        {
                            "id": "3790409",
                            "text": "要怎么收集泪水结晶呢？"
                        },
                        {
                            "id": "3790410",
                            "text": "要怎么让它哭？打就可以了吗？"
                        }
                    ]
                }
            ]
        }
    ]
}