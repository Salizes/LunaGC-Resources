    "talks": [
        {
            "id": "7403101",
            "objective": "与尼扎米对话$HIDDEN",
            "dialogues": [
                {
                    "id": "740318001",
                    "speaker": "Player",
                    "text": "正合我意！"
                },
                {
                    "id": "740318002",
                    "speaker": "尼扎米",
                    "text": "#哈哈，好！看来是个豪爽的{M#小弟}{F#小妹}。"
                },
                {
                    "id": "740318003",
                    "speaker": "尼扎米",
                    "text": "这里不方便，我们去宽敞地方！"
                }
            ]
        },
        {
            "id": "7403104",
            "objective": "与尼扎米对话",
            "dialogues": [
                {
                    "id": "740310401",
                    "speaker": "尼扎米",
                    "text": "#真是让我好等！金发的{M#小弟}{F#小妹}，咱们还没比划完呢！"
                },
                {
                    "id": "740310402",
                    "speaker": "尼扎米",
                    "text": "话不多说，我们这就开始吧！"
                }
            ]
        },
        {
            "id": "7403102",
            "objective": "和尼扎米切磋切磋",
            "dialogues": [
                {
                    "id": "740310201",
                    "speaker": "尼扎米",
                    "text": "#金发的{M#小弟}{F#妹妹}，现在有空了吗？陪我切磋一下？"
                }
            ]
        },
        {
            "id": "7403103",
            "objective": "与尼扎米对话",
            "dialogues": [
                {
                    "id": "740310301",
                    "speaker": "尼扎米",
                    "text": "哈哈，痛快！痛快！"
                },
                {
                    "id": "740310302",
                    "speaker": "尼扎米",
                    "text": "#我就知道没看走眼，金发的{M#小弟}{F#小妹}果然是值得一战的对手！",
                    "choices": [
                        {
                            "id": "740310303",
                            "text": "你也不赖。",
                            "response": [
                                {
                                    "id": "740310304",
                                    "speaker": "尼扎米",
                                    "text": "哈哈，我还有得练呢！"
                                },
                                {
                                    "id": "740310307",
                                    "speaker": "尼扎米",
                                    "text": "不是我自夸，我也是个爽快人。说好的特许券，拿好了。有机会咱们再比划比划！"
                                }
                            ]
                        },
                        {
                            "id": "740310305",
                            "text": "你还差得远呢。",
                            "response": [
                                {
                                    "id": "740310306",
                                    "speaker": "尼扎米",
                                    "text": "#咳，{M#小弟}{F#小妹}有话直说，好！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7403100",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740310001",
                    "speaker": "Black Screen",
                    "text": "随尼扎米来到了「拳力斗技场」…"
                }
            ]
        },
        {
            "id": "7403101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740310101",
                    "speaker": "尼扎米",
                    "text": "年轻的战士，和我比试一下吧！"
                },
                {
                    "id": "740310102",
                    "speaker": "派蒙",
                    "text": "好唐突！"
                },
                {
                    "id": "740310103",
                    "speaker": "尼扎米",
                    "text": "#随你怎么说。金发的{M#小弟}{F#妹妹}，我一眼就看出，你也是久经历练的强者。"
                },
                {
                    "id": "740310104",
                    "speaker": "尼扎米",
                    "text": "这阵子没人陪我比试，我可是无聊得很哪。你要是肯陪我练练，我出特许券！之前从罗西莫夫那儿赢了不少，正愁没处花呢。"
                },
                {
                    "id": "740310105",
                    "speaker": "尼扎米",
                    "text": "怎么样，和我比试一下吧！"
                }
            ]
        },
        {
            "id": "7403181",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740318101",
                    "speaker": "Player",
                    "text": "我是个和平主义者，不愿和人争斗。"
                },
                {
                    "id": "740318102",
                    "speaker": "尼扎米",
                    "text": "你奉行的是以暴止暴的和平主义？嗯，人各有志。"
                },
                {
                    "id": "740318103",
                    "speaker": "尼扎米",
                    "text": "但这不是争斗，是切磋。切磋的目的是为了更好地守护和平，你是和平主义者，那就更应该和我切磋一下了！"
                },
                {
                    "id": "740318104",
                    "speaker": "Player",
                    "text": "有道理，我们去切磋切磋！"
                },
                {
                    "id": "740318105",
                    "speaker": "尼扎米",
                    "text": "哈哈，好！"
                },
                {
                    "id": "740318106",
                    "speaker": "尼扎米",
                    "text": "这里不方便，我们去宽敞地方！"
                }
            ]
        },
        {
            "id": "7403182",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740318201",
                    "speaker": "Player",
                    "text": "现在不方便，晚点再说。"
                },
                {
                    "id": "740318202",
                    "speaker": "尼扎米",
                    "text": "好！在能跟你过招以前，我会一直在这里等你。"
                }
            ]
        },
        {
            "id": "7403190",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740319001",
                    "speaker": "Player",
                    "text": "我们走！"
                },
                {
                    "id": "740319002",
                    "speaker": "尼扎米",
                    "text": "爽快！但是这里不方便，我们去宽敞地方！"
                }
            ]
        },
        {
            "id": "7403191",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "740319101",
                    "speaker": "Player",
                    "text": "再等我一下…"
                },
                {
                    "id": "740319102",
                    "speaker": "尼扎米",
                    "text": "你啊…好吧，我在这里等你。"
                }
            ]
        }
    ]
