    "talks": [
        {
            "id": "7509701",
            "objective": "(test)玩家还没做主线$HIDDEN",
            "dialogues": [
                {
                    "id": "750970101",
                    "speaker": "派蒙",
                    "text": "嗯？总觉得纳塔的七天神像有些怪怪的。"
                },
                {
                    "id": "750970102",
                    "speaker": "派蒙",
                    "text": "摸到第一次摸到的神像，不是应该更强烈一点吗…有「嗡」地一下的那种感觉？",
                    "choices": [
                        {
                            "id": "750970103",
                            "text": "我觉得还好？",
                            "response": [
                                {
                                    "id": "750970104",
                                    "speaker": "派蒙",
                                    "text": "可是真的有点奇怪啦…"
                                },
                                {
                                    "id": "750970108",
                                    "speaker": "派蒙",
                                    "text": "唔，我想想该怎么说，总觉得以前在摸其他神像的时候，能建立更稳固的联系…"
                                },
                                {
                                    "id": "750970109",
                                    "speaker": "派蒙",
                                    "text": "这次感觉就像是碰到了什么开关一样，你碰一下它才亮一下。"
                                },
                                {
                                    "id": "750970110",
                                    "speaker": "派蒙",
                                    "text": "对了，对了，你之前摸到神像，就能感受到元素的力量，这次呢…"
                                },
                                {
                                    "id": "750970111",
                                    "speaker": "派蒙",
                                    "text": "有没有火元素那种，很活泼，很热烈的感觉？",
                                    "choices": [
                                        {
                                            "id": "750970112",
                                            "text": "（仔细感受了身躯之内…）",
                                            "response": [
                                                {
                                                    "id": "750970114",
                                                    "speaker": "派蒙",
                                                    "text": "咦，一点也没有吗…"
                                                },
                                                {
                                                    "id": "750970115",
                                                    "speaker": "派蒙",
                                                    "text": "总觉得有点奇怪…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750970113",
                                            "text": "（没有预想的炽热感…）"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750970105",
                            "text": "其实之前都是我「嗡」的。",
                            "response": [
                                {
                                    "id": "750970106",
                                    "speaker": "派蒙",
                                    "text": "原来是这样，是这次忘了「嗡」呀，下次一定得注意了…"
                                },
                                {
                                    "id": "750970107",
                                    "speaker": "派蒙",
                                    "text": "才不是啦！你最好每次摸七天神像的时候自己都会配声音！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7509702",
            "objective": "(test)玩家正在做主线$HIDDEN",
            "dialogues": [
                {
                    "id": "750970201",
                    "speaker": "派蒙",
                    "text": "…嗯，感觉还是很不习惯，你现在还是没有办法从七天神像获得元素力？"
                },
                {
                    "id": "750970202",
                    "speaker": "派蒙",
                    "text": "哎呀，七天神像到底出了什么问题呀。",
                    "choices": [
                        {
                            "id": "750970203",
                            "text": "可能是年久失修。",
                            "response": [
                                {
                                    "id": "750970204",
                                    "speaker": "派蒙",
                                    "text": "明明摸上去的时候有好好发光。"
                                },
                                {
                                    "id": "750970205",
                                    "speaker": "派蒙",
                                    "text": "唔，七天神像…你有在好好干活吗？"
                                },
                                {
                                    "id": "750970208",
                                    "speaker": "派蒙",
                                    "text": "感觉一点头绪都没有…"
                                }
                            ]
                        },
                        {
                            "id": "750970206",
                            "text": "可能是纳塔比较特殊…",
                            "response": [
                                {
                                    "id": "750970207",
                                    "speaker": "派蒙",
                                    "text": "这么说来，纳塔好像一直在受到深渊的影响，难道是因为这个？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7509703",
            "objective": "(test)玩家做完了主线$HIDDEN",
            "dialogues": [
                {
                    "id": "750970301",
                    "speaker": "派蒙",
                    "text": "哦哦，这样才正常嘛…那种和七天神像建立稳固联系的感觉。"
                },
                {
                    "id": "750970302",
                    "speaker": "派蒙",
                    "text": "所以之前七天神像不正常，果然是因为夜神之国里有那个坏家伙！看来七天神像之前也很辛苦呢…你很努力了，七天神像！"
                },
                {
                    "id": "750970303",
                    "speaker": "派蒙",
                    "text": "虽然和火元素共鸣的力量也不是你给的…"
                },
                {
                    "id": "750970304",
                    "speaker": "Player",
                    "text": "嗯，是和火神共同战斗时候…"
                },
                {
                    "id": "750970305",
                    "speaker": "派蒙",
                    "text": "#是呀，那个时候我可担心了…不过果然还是{NICKNAME}更强！"
                },
                {
                    "id": "750970306",
                    "speaker": "派蒙",
                    "text": "解决了深渊的怪物，七天神像也恢复了正常，真是太好了！"
                }
            ]
        },
