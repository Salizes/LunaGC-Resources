    "talks": [
        {
            "id": "7108001",
            "objective": "隐藏判断任务存在$HIDDEN",
            "dialogues": [
                {
                    "id": "710800101",
                    "speaker": "塔列辛",
                    "text": "#哈，你好！是收服了东风之龙、拯救我家乡的大英雄{NICKNAME}呀！"
                }
            ]
        },
        {
            "id": "7108002",
            "objective": "上层封印解除$HIDDEN",
            "dialogues": [
                {
                    "id": "710800607",
                    "speaker": "Player",
                    "text": "讲述有关如何解除「七星阵法」的故事…"
                },
                {
                    "id": "710800608",
                    "speaker": "Black Screen",
                    "text": "你为塔列辛讲述了此前的经历…"
                },
                {
                    "id": "710800609",
                    "speaker": "塔列辛",
                    "text": "哦哦…「就这样，就这样…在忠诚的仆人…」不对不对…！"
                },
                {
                    "id": "710800610",
                    "speaker": "塔列辛",
                    "text": "#「…在忠诚的友伴指引下，{NICKNAME}打通了前往矿坑的道路…！」"
                },
                {
                    "id": "710800611",
                    "speaker": "派蒙",
                    "text": "哇…这样不太好吧，我们毕竟没有经过人家允许就…"
                },
                {
                    "id": "710800612",
                    "speaker": "塔列辛",
                    "text": "欸~不用担心！英雄不为常人所为之事，不循常人所拘之道！大家不会在意这点小小问题的！"
                }
            ]
        },
        {
            "id": "7108003",
            "objective": "解开黑雾$HIDDEN",
            "dialogues": [
                {
                    "id": "710800613",
                    "speaker": "Player",
                    "text": "讲述有关黑雾与深渊怪物的故事…"
                },
                {
                    "id": "710800614",
                    "speaker": "Black Screen",
                    "text": "你为塔列辛讲述了此前的经历…"
                },
                {
                    "id": "710800615",
                    "speaker": "塔列辛",
                    "text": "哇…这个很好！这个很好！请让我记录下来！"
                },
                {
                    "id": "710800616",
                    "speaker": "塔列辛",
                    "text": "「…深黑的雾气如雪崩压至，倏而离析，来自深渊的两位使徒消失不见，正如来时一般…」"
                }
            ]
        },
        {
            "id": "7108004",
            "objective": "大碎片完成$HIDDEN",
            "dialogues": [
                {
                    "id": "710800617",
                    "speaker": "Player",
                    "text": "讲述有关巨渊深处湛蓝晶石的故事…"
                },
                {
                    "id": "710800618",
                    "speaker": "Black Screen",
                    "text": "你为塔列辛讲述了此前的经历…"
                },
                {
                    "id": "710800619",
                    "speaker": "塔列辛",
                    "text": "「…天与水的颜色重又在晶石表面流动，紫红色的溃斑就此褪去…」"
                },
                {
                    "id": "710800620",
                    "speaker": "塔列辛",
                    "text": "#「…古老遗迹中的构装巨兽，其头上正挨了{NICKNAME}的铁拳，昏昏沉沉之时…利箭救星顷刻而至！」"
                },
                {
                    "id": "710800621",
                    "speaker": "塔列辛",
                    "text": "「…那相助旅者的神秘客消失无踪，再看蛇行的构装巨兽，却已被晶石砸得七零八落…」"
                }
            ]
        },
        {
            "id": "7108005",
            "objective": "大蘑菇任务完成$HIDDEN",
            "dialogues": [
                {
                    "id": "710800622",
                    "speaker": "Player",
                    "text": "讲述有关岩洞中巨大荧光菌类的故事…"
                },
                {
                    "id": "710800623",
                    "speaker": "Black Screen",
                    "text": "你为塔列辛讲述了此前的经历…"
                },
                {
                    "id": "710800624",
                    "speaker": "塔列辛",
                    "text": "有趣…这个实在令人意想不到呀…请容我好好构思一下再开口吧。"
                },
                {
                    "id": "710800625",
                    "speaker": "塔列辛",
                    "text": "「…虽是高可参天的巨蘑，面临黑暗侵袭之时，亦是难以自救的弱者…」"
                },
                {
                    "id": "710800626",
                    "speaker": "塔列辛",
                    "text": "#「…{NICKNAME}应呼唤而来，为其净化土地，排忧解难…」"
                }
            ]
        },
        {
            "id": "7108006",
            "objective": "黑蛇骑士完成$HIDDEN",
            "dialogues": [
                {
                    "id": "710800629",
                    "speaker": "Player",
                    "text": "讲述有关九位黑蛇骑士的故事…"
                },
                {
                    "id": "710800630",
                    "speaker": "Black Screen",
                    "text": "你为塔列辛讲述了此前的经历…"
                },
                {
                    "id": "710800631",
                    "speaker": "塔列辛",
                    "text": "这个好呀，这个好！「…于是，命运的旅人言道：『漫说一个一个接踵而至，就是九个一同攻来，一并击破又有何难？』…」"
                },
                {
                    "id": "710800632",
                    "speaker": "Player",
                    "text": "唔…也没有这么夸张就是了…"
                },
                {
                    "id": "710800633",
                    "speaker": "塔列辛",
                    "text": "没关系的…请容我现编…不，编纂一下九位剑士的家世…"
                }
            ]
        },
        {
            "id": "7108007",
            "objective": "双子线完成$HIDDEN",
            "dialogues": [
                {
                    "id": "710800634",
                    "speaker": "Player",
                    "text": "讲述追寻血亲的进展…"
                },
                {
                    "id": "710800635",
                    "speaker": "Black Screen",
                    "text": "你为塔列辛讲述了此前的经历…"
                },
                {
                    "id": "710800636",
                    "speaker": "塔列辛",
                    "text": "有趣，有趣…被遗忘的古国，不被认同的牺牲…落于愚昧的不公惩罚…十分宏大的主题，十分宏大的故事呀…"
                },
                {
                    "id": "710800637",
                    "speaker": "塔列辛",
                    "text": "而这样的故事，乃是你冒险途中所经历的事件，与你的目标也息息相关…"
                },
                {
                    "id": "710800638",
                    "speaker": "塔列辛",
                    "text": "谢谢你让我知道这些，我会记录下来的。但我暂时不会编撰成诗…因为这只是属于你的史诗的小小碎片而已。"
                },
                {
                    "id": "710800639",
                    "speaker": "塔列辛",
                    "text": "我不会以有限的才能亵渎你的故事…但请你完成自己的旅途后，一定要讲与我听。"
                },
                {
                    "id": "710800640",
                    "speaker": "塔列辛",
                    "text": "我有预感，待到那一天，我将有幸听到最为伟大的英雄史诗…出自你自己的口舌与双脚。"
                }
            ]
        },
        {
            "id": "7108008",
            "objective": "愚人众任务完成$HIDDEN",
            "dialogues": [
                {
                    "id": "710800641",
                    "speaker": "Player",
                    "text": "讲述有关陷入困境的愚人众的故事…"
                },
                {
                    "id": "710800642",
                    "speaker": "Black Screen",
                    "text": "你为塔列辛讲述了此前的经历…"
                },
                {
                    "id": "710800643",
                    "speaker": "塔列辛",
                    "text": "哈哈，这个故事很有意思呀！「…『日暮途穷的苦涩今日，竟被大敌所搭救！』安东上士如是叹息…」"
                },
                {
                    "id": "710800644",
                    "speaker": "塔列辛",
                    "text": "「今日暂时的友人，难保来日会不会重新为敌！」"
                }
            ]
        },
        {
            "id": "7108013",
            "objective": "人物故事判断$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7108012",
            "objective": "层岩故事判断$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7108009",
            "objective": "回滚隔离点$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7108010",
            "objective": "计时经过1天$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7108011",
            "objective": "与塔列辛对话获得诗篇$HIDDEN",
            "dialogues": [
                {
                    "id": "710800701",
                    "speaker": "塔列辛",
                    "text": "感谢你帮我完成这部史诗，对了，这份手稿是我的谢礼。请收下吧。"
                },
                {
                    "id": "710800702",
                    "speaker": "塔列辛",
                    "text": "呼…这是史诗的初稿，承载了我情感与抱负。我今天将它交付与你，作为一点小小的回报。"
                }
            ]
        },
        {
            "id": "7108002",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710800201",
                    "speaker": "塔列辛",
                    "text": "#你来了，{NICKNAME}，直面「愚人众」执行官，从海魔面前拯救了璃月的英雄！"
                }
            ]
        },
        {
            "id": "7108003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710800301",
                    "speaker": "塔列辛",
                    "text": "#啊啊，是在遥远晨雾中的雷霆之国兴云吐雾的大人物！{NICKNAME}，请到这来，请到这来！"
                }
            ]
        },
        {
            "id": "7108004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710800401",
                    "speaker": "塔列辛",
                    "text": "#你好呀！你好呀！{NICKNAME}！曾徒步登上龙脊雪山的大冒险家！"
                }
            ]
        },
        {
            "id": "7108005",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710800501",
                    "speaker": "塔列辛",
                    "text": "#你好啊！令「愚人众」执行官在异国俯首败伏的旅人！{NICKNAME}！"
                }
            ]
        },
        {
            "id": "7108006",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710800601",
                    "speaker": "塔列辛",
                    "text": "虽然有点唐突…但不知可否请向英雄讨教故事一二，以便我编纂成诗歌，传唱后世？",
                    "choices": [
                        {
                            "id": "710800602",
                            "text": "如果只是讲故事的话…",
                            "response": [
                                {
                                    "id": "710800604",
                                    "speaker": "塔列辛",
                                    "text": "您能够答应的话就太好了！我在此洗耳恭听！"
                                }
                            ]
                        },
                        {
                            "id": "710800603",
                            "text": "我可有得是故事。"
                        }
                    ]
                },
                {
                    "id": "710800605",
                    "speaker": "Player",
                    "text": "讲述关于层岩巨渊本身的故事。"
                },
                {
                    "id": "710800606",
                    "speaker": "塔列辛",
                    "text": "好的，请你讲述吧！"
                },
                {
                    "id": "710800627",
                    "speaker": "Player",
                    "text": "讲述关于所见所闻之人与物的故事。"
                },
                {
                    "id": "710800628",
                    "speaker": "塔列辛",
                    "text": "还请您知无不言，我洗耳恭听。"
                },
                {
                    "id": "710800645",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "710800646",
                    "speaker": "塔列辛",
                    "text": "#愿你平安。非常感谢您能停留，流誉七国的大英雄{NICKNAME}！"
                }
            ]
        }
    ]
}