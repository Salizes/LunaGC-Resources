            "dialogues": [
                {
                    "id": "718120201",
                    "speaker": "岚姐",
                    "text": "怎么样，有什么发现吗？"
                },
                {
                    "id": "718120202",
                    "speaker": "Player",
                    "text": "发现了这个。"
                },
                {
                    "id": "718120203",
                    "speaker": "岚姐",
                    "text": "这是…我从来没见过这种东西，这是在哪里发现的？"
                },
                {
                    "id": "718120205",
                    "speaker": "Player",
                    "text": "在遁玉陵附近…"
                },
                {
                    "id": "718120206",
                    "speaker": "岚姐",
                    "text": "遁玉陵？那里怎么还有这种东西…"
                },
                {
                    "id": "718120207",
                    "speaker": "岚姐",
                    "text": "谢谢你帮忙解开了那条线索，按照冒险家的规矩，这件东西就归你了，这些报酬也请收下。"
                },
                {
                    "id": "718120208",
                    "speaker": "岚姐",
                    "text": "我也会尽快安排人，去遁玉陵那边进行更细致的搜索。"
                },
                {
                    "id": "718120209",
                    "speaker": "岚姐",
                    "text": "真奇怪…遁玉陵那一带都搜索过好几次了，怎么还会有遗漏的地方…"
                }
            ]
        },
        {
            "id": "7181203",
            "objective": "根据藏宝图上的线索搜寻宝藏",
            "dialogues": [
                {
                    "id": "718120301",
                    "speaker": "派蒙",
                    "text": "这是…一张纸条？上面写着什么，快点看看。"
                },
                {
                    "id": "718120302",
                    "speaker": "派蒙",
                    "text": "唔…这看上去好像是在说…"
                },
                {
                    "id": "718120303",
                    "speaker": "派蒙",
                    "text": "要我们去一棵特别大的树下，一条道路的中间，还有…台阶的下面去找宝藏呢…"
                }
            ]
