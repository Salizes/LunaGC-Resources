        {
            "id": "4006717",
            "objective": "在破碎的空间中前进",
            "dialogues": []
        },
        {
            "id": "4006710",
            "objective": "与渔船上的船夫对话",
            "dialogues": []
        },
        {
            "id": "4006711",
            "objective": "在破碎的空间中前进",
            "dialogues": []
        },
        {
            "id": "4006715",
            "objective": "聆听码头上的声音",
            "dialogues": [
                {
                    "id": "400671001",
                    "speaker": "海龙",
                    "text": "喂老弟！你没事吧！要不要上来避避难？"
                },
                {
                    "id": "400671002",
                    "speaker": "枫原万叶",
                    "text": "海盗？"
                },
                {
                    "id": "400671003",
                    "speaker": "海龙",
                    "text": "哈，没错，就是海盗！你就说，要不要来？"
                }
            ]
        },
        {
            "id": "4006716",
            "objective": "(test)(hide)对话中刷死兆星号$HIDDEN",
            "dialogues": []
        },
        {
            "id": "4006712",
            "objective": "登上「死兆星号」",
            "dialogues": []
        },
        {
            "id": "4006713",
            "objective": "返回营地",
            "dialogues": [
                {
                    "id": "400671301",
                    "speaker": "派蒙",
                    "text": "呼啊，走了不少路，都有点困了…"
                },
                {
                    "id": "400671302",
                    "speaker": "辛焱",
                    "text": "大家都辛苦了，今天要不早点休息吧。"
                },
                {
                    "id": "400671303",
                    "speaker": "菲谢尔",
                    "text": "……"
                },
                {
                    "id": "400671304",
                    "speaker": "莫娜",
                    "text": "嗯？怎么了，你脸色不太好看。"
                },
                {
                    "id": "400671305",
                    "speaker": "菲谢尔",
                    "text": "没什么。本皇女感到疲惫，或许是今日舟车劳顿。"
                },
                {
                    "id": "400671306",
                    "speaker": "奥兹",
                    "text": "……"
                },
                {
                    "id": "400671307",
                    "speaker": "奥兹",
                    "text": "小姐，您还好吗？"
                },
                {
                    "id": "400671308",
                    "speaker": "菲谢尔",
                    "text": "奥兹，不要多事。"
                },
                {
                    "id": "400671309",
                    "speaker": "奥兹",
                    "text": "是。"
                },
                {
                    "id": "400671310",
                    "speaker": "莫娜",
                    "text": "……？"
                },
                {
                    "id": "400671311",
                    "speaker": "辛焱",
                    "text": "我去找找有没有可以吃的东西，你们要是累了就先坐一会儿，还有精力的可以来帮我。"
                },
                {
                    "id": "400671312",
                    "speaker": "枫原万叶",
                    "text": "我来吧。"
                },
                {
                    "id": "400671313",
                    "speaker": "莫娜",
                    "text": "我也可以帮忙。"
                },
                {
                    "id": "400671314",
                    "speaker": "派蒙",
                    "text": "别人都那么积极，我们也去吧！"
                },
                {
                    "id": "400671315",
                    "speaker": "Player",
                    "text": "那我和派蒙也来帮你。"
                },
                {
                    "id": "400671316",
                    "speaker": "辛焱",
                    "text": "不至于不至于，而且…"
                },
                {
                    "id": "400671317",
                    "speaker": "辛焱",
                    "text": "我看皇女殿下有些忧郁，莫娜，你跟她比较熟，不如陪她出去散散心吧。"
                },
                {
                    "id": "400671318",
                    "speaker": "莫娜",
                    "text": "原来你也发现了。我刚想着趁准备食物的时候跟你们提一下这事呢。既然如此，那边就交给我了。"
                },
                {
                    "id": "400671319",
                    "speaker": "辛焱",
                    "text": "好嘞，那我们几个来准备食物。"
                },
                {
                    "id": "400671320",
                    "speaker": "Black Screen",
                    "text": "莫娜对我们眨眨眼，跑去陪伴菲谢尔了。剩下的人一起找了些能烹饪成佳肴的食材…"
                },
                {
                    "id": "400671321",
                    "speaker": "辛焱",
                    "text": "嗯，这些就够了，一会儿烤着吃吧。下回要是走过那些没人的营地，可以找找有没有炖锅，这样还能做菜。"
                },
                {
                    "id": "400671322",
                    "speaker": "派蒙",
                    "text": "真周到呀！明明不是厨师，却这么会照顾人。"
                },
                {
                    "id": "400671323",
                    "speaker": "辛焱",
                    "text": "嘿嘿，做些力所能及的小事而已，不值得你这么夸啦。"
                },
                {
                    "id": "400671324",
                    "speaker": "枫原万叶",
                    "text": "辛焱是连「死兆星号」的兄弟们都认可的好伙伴。"
                },
                {
                    "id": "400671325",
                    "speaker": "派蒙",
                    "text": "嗯！我们眼里万叶也是这么可靠的人哦！"
                },
                {
                    "id": "400671326",
                    "speaker": "辛焱",
                    "text": "哈哈哈，说得好。"
                },
                {
                    "id": "400671327",
                    "speaker": "枫原万叶",
                    "text": "嗯…既然如此，我作为可靠的伙伴，刚巧有些话想说。"
                },
                {
                    "id": "400671328",
                    "speaker": "枫原万叶",
                    "text": "听你们说的，那片不可思议的幻境，根本是依照「枫原万叶」迄今为止的人生创建而成。"
                },
                {
                    "id": "400671329",
                    "speaker": "枫原万叶",
                    "text": "…简直像是我的一场梦。"
                },
                {
                    "id": "400671330",
                    "speaker": "Player",
                    "text": "或许就是代表着「梦」呢。"
                },
                {
                    "id": "400671331",
                    "speaker": "辛焱",
                    "text": "万叶，你是不是…一直也想要完成属于你的「盆景」？"
                },
                {
                    "id": "400671332",
                    "speaker": "枫原万叶",
                    "text": "是吗…到头来，居然是实现了我的愿望吗…"
                },
                {
                    "id": "400671333",
                    "speaker": "枫原万叶",
                    "text": "既然我会遇到这种情况，那是不是意味着，我们大家都有这种可能？"
                },
                {
                    "id": "400671334",
                    "speaker": "Player",
                    "text": "嗯，我也这么想。"
                },
                {
                    "id": "400671335",
                    "speaker": "辛焱",
                    "text": "我也同意。只是，不知道下一个类似的场所会是跟谁有关的幻境。"
                },
                {
                    "id": "400671336",
                    "speaker": "辛焱",
                    "text": "哈，这么一说，要是我也能有这样的美梦该多好。"
                },
                {
                    "id": "400671337",
                    "speaker": "派蒙",
                    "text": "你居然很想要这样的东西吗？"
                },
                {
                    "id": "400671338",
                    "speaker": "辛焱",
                    "text": "如果我能拥有这样的领域，应该会是跟音乐有关的东西吧。嗯哼哼，到时候就能一展身手啦！"
                },
                {
                    "id": "400671339",
                    "speaker": "派蒙",
                    "text": "不会是要突然演奏吧！"
                },
                {
                    "id": "400671340",
                    "speaker": "辛焱",
                    "text": "很正常吧？任何搞音乐的人来到这片群岛，面对如此美景，不想来点音乐才奇怪。"
                },
                {
                    "id": "400671341",
                    "speaker": "派蒙",
                    "text": "好强健的心智，好乐观的精神，我有点佩服了…"
                },
                {
                    "id": "400671342",
                    "speaker": "派蒙",
                    "text": "#啊对了！{NICKNAME}，我想吃山崖边的水果，陪我去摘好吗？"
                },
                {
                    "id": "400671343",
                    "speaker": "Player",
                    "text": "（嗯？莫非…）"
                },
                {
                    "id": "400671344",
                    "speaker": "Player",
                    "text": "二位先忙，我陪派蒙。"
                }
            ]
        },
        {
            "id": "4006714",
            "objective": "到隐蔽地点联络温迪",
            "dialogues": []
        },
        {
            "id": "4006712",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400671201",
                    "speaker": "派蒙",
                    "text": "万叶，找到你了。"
                },
                {
                    "id": "400671202",
                    "speaker": "枫原万叶",
                    "text": "来得不快也不慢，刚刚好，容我想完了迄今为止的人生。"
                },
                {
                    "id": "400671203",
                    "speaker": "枫原万叶",
                    "text": "枫原家的盆景，你感觉如何？",
                    "choices": [
                        {
                            "id": "400671204",
                            "text": "古老，又有沉淀。",
                            "response": [
                                {
                                    "id": "400671205",
                                    "speaker": "枫原万叶",
                                    "text": "古老的东西，往往都伴随着遗憾。枫原亦是如此。"
                                },
                                {
                                    "id": "400671206",
                                    "speaker": "枫原万叶",
                                    "text": "但无妨，散也是聚。不在此处，便是在他乡。"
                                },
                                {
                                    "id": "400671209",
                                    "speaker": "莫娜",
                                    "text": "这片秘境很有趣，像戏剧一样，每一出都比上一出更特别，更震撼人心。"
                                },
                                {
                                    "id": "400671210",
                                    "speaker": "枫原万叶",
                                    "text": "占星术士都是见多识广的人。能让你这样说，这片幻境也不枉存在了。"
                                },
                                {
                                    "id": "400671211",
                                    "speaker": "菲谢尔",
                                    "text": "喂，汝…心情如何？"
                                },
                                {
                                    "id": "400671212",
                                    "speaker": "奥兹",
                                    "text": "小姐的意思是问候万叶卿，希望你心情别太低落。"
                                },
                                {
                                    "id": "400671213",
                                    "speaker": "派蒙",
                                    "text": "回忆这样的经历，不可能高兴的吧…"
                                },
                                {
                                    "id": "400671214",
                                    "speaker": "枫原万叶",
                                    "text": "哈哈，说得也是。感谢各位的关心。幸好，这些事对我而言都是过去了。"
                                },
                                {
                                    "id": "400671215",
                                    "speaker": "枫原万叶",
                                    "text": "第一眼看见盆景，我就想到了这种可能性…我在等你们，或许这正是我被独自留在终点的理由。"
                                }
                            ]
                        },
                        {
                            "id": "400671207",
                            "text": "并不完满，但你也无愧于它。",
                            "response": [
                                {
                                    "id": "400671208",
                                    "speaker": "枫原万叶",
                                    "text": "是啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "4006714",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400671401",
                    "speaker": "派蒙",
                    "text": "今天这些奇怪的房子，幻境一样的…呃…盆景？总之就是那堆怪事啦！我觉得，是不是应该告诉温迪？",
                    "choices": [
                        {
                            "id": "400671402",
                            "text": "我猜就是这件事。",
                            "response": [
                                {
                                    "id": "400671404",
                                    "speaker": "嘟嘟通讯仪",
                                    "text": "嘟嘟可——嘟嘟可——"
                                },
                                {
                                    "id": "400671405",
                                    "speaker": "嘟嘟通讯仪",
                                    "text": "嘟嘟可——嘟嘟可——嘟嘟可——"
                                },
                                {
                                    "id": "400671406",
                                    "speaker": "派蒙",
                                    "text": "没有回应…奇怪，他怎么不理我们？"
                                },
                                {
                                    "id": "400671407",
                                    "speaker": "Player",
                                    "text": "不应该这样…"
                                },
                                {
                                    "id": "400671408",
                                    "speaker": "派蒙",
                                    "text": "难道说，温迪又走神了？还是演出期间没把炸弹带在身边？又或者是喝醉了，正在大树底下打盹…"
                                },
                                {
                                    "id": "400671409",
                                    "speaker": "派蒙",
                                    "text": "唔…好奇怪，要不然…要不然明天再联系他吧。"
                                },
                                {
                                    "id": "400671410",
                                    "speaker": "莫娜",
                                    "text": "旅行者，派蒙，你们在这儿啊。"
                                },
                                {
                                    "id": "400671411",
                                    "speaker": "派蒙",
                                    "text": "是莫娜！你跟菲谢尔聊完了？"
                                },
                                {
                                    "id": "400671412",
                                    "speaker": "莫娜",
                                    "text": "啊哈哈，算是吧…她有点忧郁，我猜…可能是跟今天遇到的幻境有关。"
                                },
                                {
                                    "id": "400671413",
                                    "speaker": "莫娜",
                                    "text": "菲谢尔对这次旅行非常积极，但我有种感觉，她似乎并不想见到属于自己的幻境…"
                                },
                                {
                                    "id": "400671414",
                                    "speaker": "派蒙",
                                    "text": "为什么？她不是应该最向往这些事吗？"
                                },
                                {
                                    "id": "400671415",
                                    "speaker": "莫娜",
                                    "text": "…还不能下结论，不过我会多留意。"
                                },
                                {
                                    "id": "400671416",
                                    "speaker": "莫娜",
                                    "text": "我是想跟你们说另一件事。刚才我在海边又做了一次占卜。"
                                },
                                {
                                    "id": "400671417",
                                    "speaker": "莫娜",
                                    "text": "水占盘依然浑浊，但不同的是，隐约能从中感觉到某股力量。我无法看清它的位置，但能感受到，它在变化。"
                                },
                                {
                                    "id": "400671418",
                                    "speaker": "派蒙",
                                    "text": "看不见要怎么感受啊…"
                                },
                                {
                                    "id": "400671419",
                                    "speaker": "莫娜",
                                    "text": "该怎么给外行解释呢…啊！你就理解成，屋里有条裂缝，我们不知道它在哪里，但有风漏了进来。"
                                },
                                {
                                    "id": "400671420",
                                    "speaker": "莫娜",
                                    "text": "不仅如此，屋里的温度也一直在下降。"
                                },
                                {
                                    "id": "400671421",
                                    "speaker": "派蒙",
                                    "text": "哦！这么说的话，我好像明白了。你是想找出那条裂缝在哪里对吗？"
                                },
                                {
                                    "id": "400671422",
                                    "speaker": "莫娜",
                                    "text": "可以这么说。我需要先看到那条墙缝，才能决定接下来怎么做。"
                                }
                            ]
                        },
                        {
                            "id": "400671403",
                            "text": "那我们来联系他。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "4006799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400679901",
                    "speaker": "老仆",
                    "text": "少爷，我们是最后的家仆了啊！您当真要遣散大家？那往后，谁来…"
                },
                {
                    "id": "400679902",
                    "speaker": "枫原万叶",
                    "text": "不必担心，我会照顾好自己。"
                },
                {
                    "id": "400679903",
                    "speaker": "老仆",
                    "text": "唉，夫人走得早，老爷又离你而去，如今这个名存实亡的家，只剩你一人…"
                },
                {
                    "id": "400679904",
                    "speaker": "老仆",
                    "text": "老仆这一走，此生应是不会再见了。少爷，请多保重。"
                },
                {
                    "id": "400679905",
                    "speaker": "水手",
                    "text": "喂——！要开船了！"
                },
                {
                    "id": "400679906",
                    "speaker": "枫原万叶",
                    "text": "再会了。"
                },
                {
                    "id": "400679907",
                    "speaker": "枫原万叶",
                    "text": "枫原家终于还是在我手上解散了。"
                },
                {
                    "id": "400679908",
                    "speaker": "枫原万叶",
                    "text": "但正如父亲所说，不能让生活束缚了我。像这样四处漂泊，或许才更适合我。"
                },
                {
                    "id": "400679909",
                    "speaker": "枫原万叶",
                    "text": "据说，「神之眼」意味着神明的视线。"
                },
                {
                    "id": "400679910",
                    "speaker": "友人",
                    "text": "嗯，这个我也有。可被神明注视，一定就是好事吗？"
                },
                {
                    "id": "400679911",
                    "speaker": "枫原万叶",
                    "text": "…或许吧。"
                },
                {
                    "id": "400679912",
                    "speaker": "幕府足轻",
                    "text": "眼狩令！拥有神之眼的人，全部老实上交！"
                },
                {
                    "id": "400679913",
                    "speaker": "友人",
                    "text": "喂，这边，快走！"
                },
                {
                    "id": "400679914",
                    "speaker": "枫原万叶",
                    "text": "不必问原因。我很明白人们为什么抗拒眼狩令。"
                },
                {
                    "id": "400679915",
                    "speaker": "枫原万叶",
                    "text": "人不能失去愿望，那是我们心底最纯正的力量。"
                },
                {
                    "id": "400679916",
                    "speaker": "枫原万叶",
                    "text": "到了万不得已的时刻，我会离开。"
                },
                {
                    "id": "400679924",
                    "speaker": "枫原万叶",
                    "text": "祖父生前曾去璃月观光，父亲则从书中读到蒙德风景。我…又该去哪里？"
                },
                {
                    "id": "400679925",
                    "speaker": "枫原万叶",
                    "text": "…天色转阴，是要下雨了吧。"
                },
                {
                    "id": "400679926",
                    "speaker": "枫原万叶",
                    "text": "这场雨，还会停吗？"
                }
            ]
        }
    ]
}