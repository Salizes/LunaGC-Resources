    "talks": [
        {
            "id": "4006701",
            "objective": "调查四周寻找所需道具",
            "dialogues": [
                {
                    "id": "400670101",
                    "speaker": "莫娜",
                    "text": "…似乎每次跟你见面都是这种情况呢。占卜、解读、锁定目标，再解决问题。"
                },
                {
                    "id": "400670102",
                    "speaker": "莫娜",
                    "text": "你身边围绕着各种各样的朋友、秘密和命运，真不可思议。"
                },
                {
                    "id": "400670103",
                    "speaker": "派蒙",
                    "text": "对哦，莱纳德事件也是跟莫娜和菲谢尔一起解决的呢。"
                },
                {
                    "id": "400670104",
                    "speaker": "Player",
                    "text": "对占星术士来说是好事吧？"
                },
                {
                    "id": "400670105",
                    "speaker": "莫娜",
                    "text": "勉强算是啦。但愿这一回我们也能强强联手，尽快解决问题。"
                },
                {
                    "id": "400670106",
                    "speaker": "派蒙",
                    "text": "强强联手，是说你们俩，还是说我们三个？"
                },
                {
                    "id": "400670107",
                    "speaker": "莫娜",
                    "text": "噗…"
                },
                {
                    "id": "400670108",
                    "speaker": "莫娜",
                    "text": "好啦好啦，不会排挤你的。有时候派蒙的眼光独到又锐利，对我帮助很大。"
                },
                {
                    "id": "400670109",
                    "speaker": "派蒙",
                    "text": "真的？我有点开始欣赏你了，天才莫娜！"
                },
                {
                    "id": "400670110",
                    "speaker": "莫娜",
                    "text": "对吧对吧？像我这样聪明又迷人的占星术士，世界上再也找不出第二个了，哦呵呵！"
                },
                {
                    "id": "400670111",
                    "speaker": "派蒙",
                    "text": "你什么都好，就是能不能…不要学菲谢尔笑…"
                },
                {
                    "id": "400670112",
                    "speaker": "莫娜",
                    "text": "咳！不好意思…跟朋友相处久了，难免受影响…哈哈…"
                },
                {
                    "id": "400670113",
                    "speaker": "莫娜",
                    "text": "#之后的日子里，我会继续观测星象。保持联系，{NICKNAME}。"
                }
            ]
        },
        {
            "id": "4006702",
            "objective": "将山石放入盆景",
            "dialogues": [
                {
                    "id": "400670201",
                    "speaker": "莫娜",
                    "text": "…没想到，会在景色如此美妙的地方处理这种不可思议的事件。"
                },
                {
                    "id": "400670202",
                    "speaker": "Player",
                    "text": "感觉如何？"
                },
                {
                    "id": "400670203",
                    "speaker": "莫娜",
                    "text": "还行。如果你能帮上我的忙就更好了。"
                },
                {
                    "id": "400670204",
                    "speaker": "派蒙",
                    "text": "那具体需要我们做些什么呢？"
                },
                {
                    "id": "400670205",
                    "speaker": "莫娜",
                    "text": "唔…"
                },
                {
                    "id": "400670206",
                    "speaker": "莫娜",
                    "text": "唔…唔…好像也没什么？"
                },
                {
                    "id": "400670207",
                    "speaker": "派蒙",
                    "text": "你、你小看我们？！"
                },
                {
                    "id": "400670208",
                    "speaker": "莫娜",
                    "text": "不，我是刚刚才意识到，虽然你话不多，却总是把事情办得很漂亮，悄悄地为大家做了很多事。"
                },
                {
                    "id": "400670209",
                    "speaker": "莫娜",
                    "text": "你这样的人，应该是大家最需要的同伴。只要你在，好像就能放心许多。"
                },
                {
                    "id": "400670210",
                    "speaker": "莫娜",
                    "text": "虽然擅自期待或许会给对方带去压力，但我认为…占星术士要有观察力，而发现他人的优点，也是一种观察。"
                },
                {
                    "id": "400670211",
                    "speaker": "派蒙",
                    "text": "所以你只是想夸我们？"
                },
                {
                    "id": "400670212",
                    "speaker": "莫娜",
                    "text": "只是陈述事实而已，没在夸你。"
                },
                {
                    "id": "400670213",
                    "speaker": "Player",
                    "text": "原来如此，莫娜不肯承认…"
                },
                {
                    "id": "400670214",
                    "speaker": "派蒙",
                    "text": "不肯承认她在夸奖别人！"
                },
                {
                    "id": "400670215",
                    "speaker": "莫娜",
                    "text": "你、你笑什么，都说了是客观评价，没在夸你！没——在——夸你！"
                },
                {
                    "id": "400670216",
                    "speaker": "莫娜",
                    "text": "#之后的日子里，我会继续观测星象。保持联系，{NICKNAME}。"
                }
            ]
        },
        {
            "id": "4006703",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "400670301",
                    "speaker": "派蒙",
                    "text": "这里怎么搞的，碎成这样…"
                },
                {
                    "id": "400670302",
                    "speaker": "菲谢尔",
                    "text": "…没落的权贵之家，就是如此吗。"
                },
                {
                    "id": "400670303",
                    "speaker": "莫娜",
                    "text": "支离破碎，而且空无一人。应该是已经走到末尾了吧。"
                },
                {
                    "id": "400670304",
                    "speaker": "辛焱",
                    "text": "走吧。"
                }
            ]
        },
        {
            "id": "4006704",
            "objective": "在破碎的空间中前进",
            "dialogues": [
                {
                    "id": "400670401",
                    "speaker": "船夫",
                    "text": "你是枫原？快上船，我送你走！"
                },
                {
                    "id": "400670402",
                    "speaker": "枫原万叶",
                    "text": "您…为什么要帮我？我可是通缉犯。"
                },
                {
                    "id": "400670403",
                    "speaker": "船夫",
                    "text": "当然是社奉…啊咳咳！是有人付了钱，说要把你安全送出稻妻。"
                },
                {
                    "id": "400670404",
                    "speaker": "船夫",
                    "text": "不过，别人能帮的实在有限，后面的路还得靠你自己。"
                }
            ]
        },
        {
            "id": "4006705",
            "objective": "在破碎的空间中前进",
            "dialogues": [
                {
                    "id": "400670501",
                    "speaker": "枫原万叶",
                    "text": "那只瓷盆里，应该有棵枯死的植物才对。但在这里，枯木没有出现。"
                },
                {
                    "id": "400670502",
                    "speaker": "枫原万叶",
                    "text": "…你们不在的时候，我想了许多，总算是明白过来了。"
                },
                {
                    "id": "400670503",
                    "speaker": "枫原万叶",
                    "text": "这里是我的幻境，盆景中空无一物，意味着它即是我的心境。"
                },
                {
                    "id": "400670504",
                    "speaker": "枫原万叶",
                    "text": "心中「净」澈，万物天地皆为「净」；心至「空」处，天地万物皆为「空」。"
                },
                {
                    "id": "400670505",
                    "speaker": "枫原万叶",
                    "text": "净与空，便是我如今的心境了。"
                },
                {
                    "id": "400670506",
                    "speaker": "枫原万叶",
                    "text": "不过，那也未必不是遗憾。心中缺损，亦作「空」。"
                },
                {
                    "id": "400670507",
                    "speaker": "枫原万叶",
                    "text": "所以这盆景才出现在我的幻想之中，给我机会完成心愿。"
                },
                {
                    "id": "400670508",
                    "speaker": "枫原万叶",
                    "text": "真没想到，在我内心深处，竟然也想制作属于自己的盆景…如此，才算是真正继承了枫原的传统吧。"
                }
            ]
        },
        {
            "id": "4006706",
            "objective": "在破碎的空间中前进",
            "dialogues": [
                {
                    "id": "400670601",
                    "speaker": "派蒙",
                    "text": "那万叶想做的事，应该已经完成了吧？"
                },
                {
                    "id": "400670602",
                    "speaker": "枫原万叶",
                    "text": "嗯，可以这么说。"
                },
                {
                    "id": "400670603",
                    "speaker": "枫原万叶",
                    "text": "你们见证了过去的我，还与他告别。等你们亲眼看完属于我的一切，它们才真正成为历史。"
                },
                {
                    "id": "400670604",
                    "speaker": "枫原万叶",
                    "text": "人一生最重要的是与他人的牵绊，而非对自己的苛责。驻足过去的人，不会有未来。"
                },
                {
                    "id": "400670605",
                    "speaker": "枫原万叶",
                    "text": "所以请你们相信，我走到了这里，也将继续走下去。将来，就请各位多关照了。"
                }
            ]
        },
        {
            "id": "4006707",
            "objective": "在破碎的空间中前进",
            "dialogues": []
        },
