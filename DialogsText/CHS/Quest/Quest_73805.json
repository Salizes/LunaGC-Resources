            "id": "7380501",
            "objective": "与玛亚姆对话",
            "dialogues": [
                {
                    "id": "738050101",
                    "speaker": "玛亚姆",
                    "text": "旅行者，稍等一下，这里有一封信给你。"
                },
                {
                    "id": "738050102",
                    "speaker": "Player",
                    "text": "给我的信？"
                },
                {
                    "id": "738050103",
                    "speaker": "玛亚姆",
                    "text": "是那个叫「旭东」的璃月人留给你的。",
                    "choices": [
                        {
                            "id": "738050104",
                            "text": "他在哪里？",
                            "response": [
                                {
                                    "id": "738050106",
                                    "speaker": "玛亚姆",
                                    "text": "那我可就不知道了。前段时间，他匆匆忙忙地过来，交给我了这封信。"
                                },
                                {
                                    "id": "738050107",
                                    "speaker": "玛亚姆",
                                    "text": "说什么…请务必转交给你，还给了我一笔钱呢。"
                                },
                                {
                                    "id": "738050108",
                                    "speaker": "派蒙",
                                    "text": "旭东…匆匆忙忙的？有什么事会让他这么着急呀？"
                                },
                                {
                                    "id": "738050109",
                                    "speaker": "派蒙",
                                    "text": "难道…是那个坏蛋又捣乱了？",
                                    "choices": [
                                        {
                                            "id": "738050110",
                                            "text": "还是先看看信吧。",
                                            "response": [
                                                {
                                                    "id": "738050112",
                                                    "speaker": "派蒙",
                                                    "text": "好吧…那我们就先读读这封信吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "738050111",
                                            "text": "也许他会在信里说明白。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "738050105",
                            "text": "他为什么要留信给我…"
                        }
                    ]
                }
            ]
        }
    ]
