    "talks": [
        {
            "id": "7050901",
            "objective": "与卢卡对话，进入酒馆",
            "dialogues": [
                {
                    "id": "705090101",
                    "speaker": "申鹤",
                    "text": "#{NICKNAME}，你好。"
                },
                {
                    "id": "705090102",
                    "speaker": "派蒙",
                    "text": "你好呀！唉，要不是连续见了那么多朋友，我肯定会很惊讶，连你都来了呢…"
                },
                {
                    "id": "705090103",
                    "speaker": "派蒙",
                    "text": "不…不对，这不是申鹤嘛！我果然还是被惊讶到了！"
                },
                {
                    "id": "705090104",
                    "speaker": "申鹤",
                    "text": "嗯…这里确实不好找。「天使的馈赠」…名字拗口。"
                },
                {
                    "id": "705090105",
                    "speaker": "申鹤",
                    "text": "多亏热心的钟离先生帮忙指路。"
                },
                {
                    "id": "705090106",
                    "speaker": "派蒙",
                    "text": "还让人指路了啊…我猜猜看，你是专程赶来喝东西的？"
                },
                {
                    "id": "705090107",
                    "speaker": "申鹤",
                    "text": "嗯。"
                },
                {
                    "id": "705090108",
                    "speaker": "申鹤",
                    "text": "因为是…朋友。"
                },
                {
                    "id": "705090109",
                    "speaker": "Player",
                    "text": "想喝点什么？"
                },
                {
                    "id": "705090110",
                    "speaker": "派蒙",
                    "text": "来，这里有菜单！"
                },
                {
                    "id": "705090111",
                    "speaker": "申鹤",
                    "text": "北风之望…北风，是凉嗖嗖的吗？"
                },
                {
                    "id": "705090112",
                    "speaker": "派蒙",
                    "text": "唔，这个名字里的北风应该是指北风狼吧？冷…的确挺冷的…"
                },
                {
                    "id": "705090113",
                    "speaker": "申鹤",
                    "text": "焦糖松果…为什么能拿来喝？"
                },
                {
                    "id": "705090114",
                    "speaker": "派蒙",
                    "text": "啊，这个我尝过。是焦糖味的咖啡，松果…松果说的应该是颜色！"
                },
                {
                    "id": "705090115",
                    "speaker": "申鹤",
                    "text": "……"
                },
                {
                    "id": "705090116",
                    "speaker": "申鹤",
                    "text": "看名字，完全无法理解。"
                },
                {
                    "id": "705090117",
                    "speaker": "申鹤",
                    "text": "交给你们吧。类似清心、琉璃袋…那种味道的就好。"
                },
                {
                    "id": "705090118",
                    "speaker": "派蒙",
                    "text": "这里的土壤不长这些药材啦，想喝苦的东西，就只有咖啡…"
                },
                {
                    "id": "705090119",
                    "speaker": "Player",
                    "text": "要不要试试甜味的？"
                },
                {
                    "id": "705090120",
                    "speaker": "申鹤",
                    "text": "…好。"
                },
                {
                    "id": "705090121",
                    "speaker": "派蒙",
                    "text": "也对，修行久了是该换换口味！"
                },
                {
                    "id": "705090122",
                    "speaker": "派蒙",
                    "text": "我们给申鹤来一杯覆雪之吻吧！看名字就跟她很搭。"
                }
            ]
        },
        {
            "id": "7050905",
            "objective": "前往吧台并完成营业准备",
            "dialogues": []
        },
        {
            "id": "7050904",
            "objective": "与申鹤对话",
            "dialogues": []
        },
        {
            "id": "7050902",
            "objective": "为申鹤调制指定饮品",
            "dialogues": [
                {
                    "id": "705090201",
                    "speaker": "申鹤",
                    "text": "很甜，口感顺滑，不苦涩。这是什么？"
                },
                {
                    "id": "705090202",
                    "speaker": "派蒙",
                    "text": "它叫「覆雪之吻」！把牛奶打成细密的奶泡轻轻倒在果汁上，看起来就像是覆盖着积雪一样哦。"
                },
                {
                    "id": "705090203",
                    "speaker": "派蒙",
                    "text": "至于为什么要叫吻什么的…我也不懂…可能是商家的花招吧，为了让它更好卖！"
                },
                {
                    "id": "705090204",
                    "speaker": "申鹤",
                    "text": "更好卖？"
                },
                {
                    "id": "705090205",
                    "speaker": "派蒙",
                    "text": "欸？不是吗？我、我乱说的…那、那它是一种…浪漫的形容！"
                },
                {
                    "id": "705090206",
                    "speaker": "申鹤",
                    "text": "浪漫…？"
                },
                {
                    "id": "705090207",
                    "speaker": "派蒙",
                    "text": "呜…好难解释啊！不要逼我编故事。",
                    "choices": [
                        {
                            "id": "705090208",
                            "text": "奶泡没有太多味道…",
                            "response": [
                                {
                                    "id": "705090210",
                                    "speaker": "派蒙",
                                    "text": "是这样没错…",
                                    "choices": [
                                        {
                                            "id": "705090211",
                                            "text": "喝到果汁的那一刻很甜…",
                                            "response": [
                                                {
                                                    "id": "705090213",
                                                    "speaker": "申鹤",
                                                    "text": "…啊。"
                                                },
                                                {
                                                    "id": "705090214",
                                                    "speaker": "申鹤",
                                                    "text": "这样啊…我似乎明白了。"
                                                },
                                                {
                                                    "id": "705090215",
                                                    "speaker": "派蒙",
                                                    "text": "欸？欸——"
                                                },
                                                {
                                                    "id": "705090216",
                                                    "speaker": "派蒙",
                                                    "text": "等一下，为什么啊！现在换我不明白了！"
                                                },
                                                {
                                                    "id": "705090217",
                                                    "speaker": "申鹤",
                                                    "text": "我在山间走动时，偶尔会嚼食仙草，也曾亲眼目睹幼芽破土的刹那。"
                                                },
                                                {
                                                    "id": "705090218",
                                                    "speaker": "申鹤",
                                                    "text": "心中那份悸动…的确，与此刻很是相似。"
                                                },
                                                {
                                                    "id": "705090219",
                                                    "speaker": "申鹤",
                                                    "text": "#{NICKNAME}，谢谢你能让我明白这些…难懂的名字。"
                                                },
                                                {
                                                    "id": "705090220",
                                                    "speaker": "申鹤",
                                                    "text": "往后，或许也要麻烦你了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705090212",
                                            "text": "如同嫩芽破冰，亲吻了你…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705090209",
                            "text": "就像山顶的积雪…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050903",
            "objective": "将饮品交给申鹤",
            "dialogues": []
        },
        {
            "id": "7050999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705099901",
                    "speaker": "派蒙",
                    "text": "好像不是对方想要的饮品…再重做一杯吧，这杯我来解决！"
                }
            ]
        }
    ]
}