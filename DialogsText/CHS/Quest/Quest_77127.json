        {
            "id": "7712705",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771270301",
                    "speaker": "派蒙",
                    "text": "喂，你怎么了？"
                },
                {
                    "id": "771270302",
                    "speaker": "失落的霜精",
                    "text": "呜呜…呀吼…"
                },
                {
                    "id": "771270303",
                    "speaker": "Black Screen",
                    "text": "失落的霜精指了指自己的头…"
                },
                {
                    "id": "771270304",
                    "speaker": "派蒙",
                    "text": "啊…我懂了，你不开心，是因为别人都有帽子，你没有！"
                },
                {
                    "id": "771270305",
                    "speaker": "失落的霜精",
                    "text": "呀吼，呀吼…",
                    "choices": [
                        {
                            "id": "771270306",
                            "text": "好可怜哦…",
                            "response": [
                                {
                                    "id": "771270307",
                                    "speaker": "派蒙",
                                    "text": "是呢…"
                                },
                                {
                                    "id": "771270310",
                                    "speaker": "派蒙",
                                    "text": "我想想…如果这家伙是因为没有帽子才不开心，那么我们给它找到一顶帽子不就行了！"
                                },
                                {
                                    "id": "771270311",
                                    "speaker": "失落的霜精",
                                    "text": "呀吼呀吼！"
                                },
                                {
                                    "id": "771270312",
                                    "speaker": "派蒙",
                                    "text": "可是要去哪里呢…"
                                },
                                {
                                    "id": "771270313",
                                    "speaker": "失落的霜精",
                                    "text": "呀吼，呀吼！"
                                },
                                {
                                    "id": "771270314",
                                    "speaker": "派蒙",
                                    "text": "哦，你知道哪里有帽子…"
                                },
                                {
                                    "id": "771270315",
                                    "speaker": "失落的霜精",
                                    "text": "呀吼…"
                                },
                                {
                                    "id": "771270316",
                                    "speaker": "派蒙",
                                    "text": "啊…原来如此，<color=#00E1FFFF>那口井下面</color>有帽子…呃，不如说就是掉到井下面去的吧…"
                                },
                                {
                                    "id": "771270317",
                                    "speaker": "派蒙",
                                    "text": "我们下去帮你拿哦！"
                                },
                                {
                                    "id": "771270318",
                                    "speaker": "失落的霜精",
                                    "text": "呀吼！呀吼！"
                                }
                            ]
                        },
                        {
                            "id": "771270308",
                            "text": "不要有无缘无故的攀比之心。",
                            "response": [
                                {
                                    "id": "771270309",
                                    "speaker": "派蒙",
                                    "text": "它最好能听懂你这些了不起的道理。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
