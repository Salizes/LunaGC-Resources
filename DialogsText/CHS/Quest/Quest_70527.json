    "talks": [
        {
            "id": "7052701",
            "objective": "前往猎鹿人餐馆",
            "dialogues": [
                {
                    "id": "705270101",
                    "speaker": "派蒙",
                    "text": "你们好呀！是在聊什么好吃的吗？",
                    "choices": [
                        {
                            "id": "705270102",
                            "text": "你们好，莎拉、娜扎法琳。",
                            "response": [
                                {
                                    "id": "705270107",
                                    "speaker": "莎拉",
                                    "text": "又见面了，二位。确实我们聊的也算是和吃的有关系吧，不过…唉…"
                                },
                                {
                                    "id": "705270108",
                                    "speaker": "派蒙",
                                    "text": "发生什么事情了呀，快说吧，说不定我们能帮上忙呢？"
                                },
                                {
                                    "id": "705270109",
                                    "speaker": "派蒙",
                                    "text": "#既然事关好吃的，那我们一定不会袖手旁观的！嘿嘿，对吧，{NICKNAME}？",
                                    "choices": [
                                        {
                                            "id": "705270110",
                                            "text": "没错，为了好吃的！",
                                            "response": [
                                                {
                                                    "id": "705270112",
                                                    "speaker": "娜扎法琳",
                                                    "text": "噢，草王在上。二位大人还是一如既往，非常热心。"
                                                },
                                                {
                                                    "id": "705270113",
                                                    "speaker": "娜扎法琳",
                                                    "text": "是这样子的，上次二位大人救我于水火之中后，我回到须弥，整理出了一份璃月调料市场调研报告。"
                                                },
                                                {
                                                    "id": "705270114",
                                                    "speaker": "娜扎法琳",
                                                    "text": "没想到被鼎鼎有名的桑歌玛哈巴依老爷给看上了，她表示希望买断我研究出来的调料配方。"
                                                },
                                                {
                                                    "id": "705270115",
                                                    "speaker": "娜扎法琳",
                                                    "text": "这位善良好心的大商人甚至愿意出资支持我后续的调研！噢，多么幸运！我毫不犹豫地答应了下来。"
                                                },
                                                {
                                                    "id": "705270116",
                                                    "speaker": "娜扎法琳",
                                                    "text": "我给好朋友芭尔瓦涅写了信，告诉了她这件事情，她也非常支持我的决定。"
                                                },
                                                {
                                                    "id": "705270117",
                                                    "speaker": "派蒙",
                                                    "text": "所以你现在是在蒙德展开你的调料调研吗？"
                                                },
                                                {
                                                    "id": "705270118",
                                                    "speaker": "娜扎法琳",
                                                    "text": "噢，派蒙阁下真是说到点子上了。我本来应该已经展开了我的蒙德调料调研，只是…"
                                                },
                                                {
                                                    "id": "705270119",
                                                    "speaker": "莎拉",
                                                    "text": "只是，娜扎法琳想要和猎鹿人合作，在猎鹿人的菜肴里加入她所谓的秘制调料，再让我们的客人食用。"
                                                },
                                                {
                                                    "id": "705270120",
                                                    "speaker": "莎拉",
                                                    "text": "但猎鹿人身为餐厅，出餐是有标准的，没办法加入新的调料，要不然恐怕会有很多老客人投诉…"
                                                },
                                                {
                                                    "id": "705270121",
                                                    "speaker": "莎拉",
                                                    "text": "唉，说实话，其实在你们来之前，我们聊了很久，都没有什么比较好的方法。"
                                                },
                                                {
                                                    "id": "705270122",
                                                    "speaker": "莎拉",
                                                    "text": "甚至还在想，要不要找琴团长帮忙解决，她一定能完美解决这种棘手的问题吧…"
                                                },
                                                {
                                                    "id": "705270123",
                                                    "speaker": "派蒙",
                                                    "text": "呜哇！琴团长那么忙，这种小事情就不用打扰她啦！都交给我们吧！"
                                                },
                                                {
                                                    "id": "705270124",
                                                    "speaker": "娜扎法琳",
                                                    "text": "噢，瞧瞧，我之前说什么来着。二位大人果然是拯救娜扎法琳的大英雄！"
                                                },
                                                {
                                                    "id": "705270125",
                                                    "speaker": "娜扎法琳",
                                                    "text": "太好了，那么事不宜迟，这口锅请收下吧。"
                                                },
                                                {
                                                    "id": "705270126",
                                                    "speaker": "娜扎法琳",
                                                    "text": "就按我们之前那样吧，制作调料，加入料理中，再邀请您的朋友们试吃。"
                                                },
                                                {
                                                    "id": "705270127",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，就按我们之前那样吧，最好的伙伴派蒙来当您的第一位试吃员。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705270111",
                                            "text": "好吧，就当是为了派蒙。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705270103",
                            "text": "你们好，请问这位是…",
                            "response": [
                                {
                                    "id": "705270104",
                                    "speaker": "娜扎法琳",
                                    "text": "噢，您好，我的小吉祥草王啊。大人您不记得我了吗？"
                                },
                                {
                                    "id": "705270105",
                                    "speaker": "娜扎法琳",
                                    "text": "可能我的存在感，就像是一粒沙尘，风一吹就消散了…"
                                },
                                {
                                    "id": "705270106",
                                    "speaker": "娜扎法琳",
                                    "text": "不过二位大人之前在璃月，帮忙制作调料，又邀请大家试吃，大恩大德，我一直铭记于心呢！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7052702",
            "objective": "与莎拉对话",
            "dialogues": []
        },
        {
            "id": "7052799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705279901",
                    "speaker": "派蒙",
                    "text": "咦？你看那边，莎拉是在和谁聊天吗？难道是在聊什么好吃的？"
                },
                {
                    "id": "705279902",
                    "speaker": "派蒙",
                    "text": "快点，快点，我们过去看看吧！我可不想错过任何好吃的！"
                }
            ]
        }
    ]
}