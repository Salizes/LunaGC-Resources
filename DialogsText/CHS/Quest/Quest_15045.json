        },
        {
            "id": "1504503",
            "objective": "返回度假屋休息",
            "dialogues": [
                {
                    "id": "150459101",
                    "speaker": "Player",
                    "text": "那就休息吧。"
                }
            ]
        },
        {
            "id": "1504504",
            "objective": "返回度假屋休息",
            "dialogues": [
                {
                    "id": "150450401",
                    "speaker": "玛拉妮",
                    "text": "#{NICKNAME}，派蒙！我带着豚豚球来跟你们问早哦！"
                },
                {
                    "id": "150450402",
                    "speaker": "派蒙",
                    "text": "早啊，玛拉妮，你怎么那么有精神？昨晚玩得最疯的不就是你吗？"
                },
                {
                    "id": "150450403",
                    "speaker": "玛拉妮",
                    "text": "那已经是昨晚的事啦！睡一觉，疲劳就统统扫清！"
                },
                {
                    "id": "150450404",
                    "speaker": "玛拉妮",
                    "text": "喏，收下这个。是纪念册的奖励，我帮你一起领回来了，免得你多跑一趟。"
                },
                {
                    "id": "150450405",
                    "speaker": "派蒙",
                    "text": "噢噢！真贴心啊玛拉妮！"
                },
                {
                    "id": "150450406",
                    "speaker": "玛拉妮",
                    "text": "急人所急，想人所想，才算是个好向导，对吧？"
                },
                {
                    "id": "150450407",
                    "speaker": "玛拉妮",
                    "text": "说到工作，算算时间，假期差不多要结束了。再不回家，我怕我家小狗都要认不出我了。"
                },
                {
                    "id": "150450408",
                    "speaker": "玛拉妮",
                    "text": "我问了问其他人，大家也有各自的牵挂。"
                },
                {
                    "id": "150450409",
                    "speaker": "玛拉妮",
                    "text": "想念家人的，想念蒲公英酒味道的…"
                },
                {
                    "id": "150450410",
                    "speaker": "玛拉妮",
                    "text": "就连恰斯卡嘴上没说什么，一到傍晚，她就翘着腿坐在树梢上，往「花羽会」的方向望了又望。"
                },
                {
                    "id": "150450411",
                    "speaker": "Player",
                    "text": "能够理解…"
                },
                {
                    "id": "150450412",
                    "speaker": "玛拉妮",
                    "text": "所以呀，在这个美妙的夏天结束之前，让我们再做一些有纪念意义的事情吧！"
                },
                {
                    "id": "150450413",
                    "speaker": "玛拉妮",
                    "text": "比如…再拍一张合照！"
                },
                {
                    "id": "150450414",
                    "speaker": "派蒙",
                    "text": "要在这里拍吗？住了那么久，还挺有感情的。"
                },
                {
                    "id": "150450415",
                    "speaker": "玛拉妮",
                    "text": "采纳！再把墙面装饰一番吧，我喊大家过来集合…广场见！"
                }
            ]
        },
        {
            "id": "1504502",
            "objective": "根据同伴们的想法进行喷绘",
            "dialogues": []
        },
        {
            "id": "1504505",
            "objective": "根据同伴们的想法进行喷绘",
            "dialogues": []
        },
        {
            "id": "1504506",
            "objective": "与众人对话",
            "dialogues": [
                {
                    "id": "150450601",
                    "speaker": "班尼特",
                    "text": "噢，真好看！"
                },
                {
                    "id": "150450602",
                    "speaker": "玛拉妮",
                    "text": "各位，来我这里集合！要拍照啦！"
                },
                {
                    "id": "150450603",
                    "speaker": "玛拉妮",
                    "text": "嗯…不错嘛！所有人的精神状态都很饱满，没有黏答答的刘海或者熬夜的黑眼圈。"
                },
                {
                    "id": "150450604",
                    "speaker": "派蒙",
                    "text": "你拍照前还会帮忙检查这些？"
                },
                {
                    "id": "150450605",
                    "speaker": "玛拉妮",
                    "text": "拍照不够细心还怎么声称自己是好向导？"
                },
                {
                    "id": "150450606",
                    "speaker": "温迪",
                    "text": "爱喝酒的吟游诗人才能成为好旅伴？"
                },
                {
                    "id": "150450607",
                    "speaker": "派蒙",
                    "text": "这话到底是怎么接上的…"
                },
                {
                    "id": "150450608",
                    "speaker": "班尼特",
                    "text": "哈哈，但气氛很好。"
                },
                {
                    "id": "150450609",
                    "speaker": "Player",
                    "text": "大家变成一起说胡话的朋友了。"
                },
                {
                    "id": "150450610",
                    "speaker": "派蒙",
                    "text": "这真的是个好方向吗？你也跟班尼特一样在惯着卖唱的吧？"
                },
                {
                    "id": "150450611",
                    "speaker": "恰斯卡",
                    "text": "至少不坏。"
                },
                {
                    "id": "150450612",
                    "speaker": "玛拉妮",
                    "text": "#来，{NICKNAME}，把这个阿夏头箍带上。这是大家一起为你买的纪念礼物噢！"
                },
                {
                    "id": "150450613",
                    "speaker": "Player",
                    "text": "谢谢。"
                },
                {
                    "id": "150450614",
                    "speaker": "班尼特",
                    "text": "嗯，很适合你！"
                },
                {
                    "id": "150450615",
                    "speaker": "玛拉妮",
                    "text": "那么…"
                },
                {
                    "id": "150450616",
                    "speaker": "玛拉妮",
                    "text": "三、二、一——"
                },
                {
                    "id": "150450617",
                    "speaker": "派蒙",
                    "text": "……"
                },
                {
                    "id": "150450618",
                    "speaker": "班尼特",
                    "text": "派蒙？"
                },
                {
                    "id": "150450619",
                    "speaker": "派蒙",
                    "text": "…不好意思，胡话听多了之后脑袋突然卡壳了，没想出要说什么词…"
                },
                {
                    "id": "150450620",
                    "speaker": "恰斯卡",
                    "text": "再加上还有点舍不得大家？"
                },
                {
                    "id": "150450621",
                    "speaker": "恰斯卡",
                    "text": "觉得当自己这么说出来的时候，仿佛就是在给假期画上句号了？"
                },
                {
                    "id": "150450622",
                    "speaker": "派蒙",
                    "text": "你…！你还说「调停人」不会读心术！"
                },
                {
                    "id": "150450623",
                    "speaker": "玛拉妮",
                    "text": "哈哈，派蒙…"
                },
                {
                    "id": "150450624",
                    "speaker": "班尼特",
                    "text": "没事的，派蒙。"
                },
                {
                    "id": "150450625",
                    "speaker": "班尼特",
                    "text": "夏天一定还会到来，就像你和火神大人许愿的那样。"
                },
                {
                    "id": "150450626",
                    "speaker": "班尼特",
                    "text": "大家的旅程都在继续。但只要我们都珍惜着彼此，总有一天还会相聚。"
                },
                {
                    "id": "150450627",
                    "speaker": "玛拉妮",
                    "text": "班尼特是不是变得相当能说啊，温迪老师？"
                },
                {
                    "id": "150450628",
                    "speaker": "温迪",
                    "text": "啊呀，不是我教的哦。"
                },
                {
                    "id": "150450629",
                    "speaker": "派蒙",
                    "text": "不是你教的你语气那么得意干嘛呀！真是的，我好不容易有点感动…"
                },
                {
                    "id": "150450630",
                    "speaker": "玛拉妮",
                    "text": "那我们重新来一次？"
                },
                {
                    "id": "150450631",
                    "speaker": "班尼特",
                    "text": "大家一起吧？"
                },
                {
                    "id": "150450632",
                    "speaker": "恰斯卡",
                    "text": "喊什么？"
                },
                {
                    "id": "150450633",
                    "speaker": "Player",
                    "text": "幸运之星？"
                },
                {
                    "id": "150450634",
                    "speaker": "派蒙",
                    "text": "好！"
                },
                {
                    "id": "150450635",
                    "speaker": "玛拉妮",
                    "text": "三、二、一——"
                },
                {
                    "id": "150450636",
                    "speaker": "众人",
                    "text": "幸运之星！"
                },
                {
                    "id": "150450641",
                    "speaker": "Black Screen",
                    "text": "和朋友们共度了一段愉快的时光…"
                },
                {
                    "id": "150450642",
                    "speaker": "恰斯卡",
                    "text": "…班尼特之后有什么打算？"
                },
                {
                    "id": "150450643",
                    "speaker": "玛拉妮",
                    "text": "对啊，如果现在不好做决定的话，可以来我们「流泉之众」坐坐，想待多久都行。"
                },
                {
                    "id": "150450644",
                    "speaker": "班尼特",
                    "text": "…嗯，谢谢你的好意，玛拉妮。"
                },
                {
                    "id": "150450645",
                    "speaker": "班尼特",
                    "text": "在这之前，我去见了火神大人，向她郑重表达了我的感谢。"
                },
                {
                    "id": "150450646",
                    "speaker": "班尼特",
                    "text": "她告诉我，那片空间是由深渊拟态而成的烬寂海，空间本身极不稳定，现在已经彻底消失了。"
                },
                {
                    "id": "150450647",
                    "speaker": "班尼特",
                    "text": "后面聊到我的事之后，火神大人欢迎我留在纳塔，但也说会尊重我的决定。"
                },
                {
                    "id": "150450648",
                    "speaker": "班尼特",
                    "text": "我思考再三…还是决定回蒙德。"
                },
                {
                    "id": "150450649",
                    "speaker": "恰斯卡",
                    "text": "放心不下老爹们？"
                },
                {
                    "id": "150450650",
                    "speaker": "班尼特",
                    "text": "这也是原因之一。我答应要把收获的故事讲给老爹们听，不能失约。"
                },
                {
                    "id": "150450651",
                    "speaker": "班尼特",
                    "text": "其余的嘛…"
                },
                {
                    "id": "150450652",
                    "speaker": "班尼特",
                    "text": "告别的时候，我对爸妈说了，我一定会成为提瓦特最伟大的传奇冒险家。"
                },
                {
                    "id": "150450653",
                    "speaker": "班尼特",
                    "text": "冒险家，可不能只待在一个地方啊。"
                },
                {
                    "id": "150450654",
                    "speaker": "玛拉妮",
                    "text": "班尼特…"
                },
                {
                    "id": "150450655",
                    "speaker": "派蒙",
                    "text": "要是你在离开纳塔之后，又变得不幸起来…那要怎么办？"
                },
                {
                    "id": "150450656",
                    "speaker": "班尼特",
                    "text": "哈哈，这也没关系。"
                },
                {
                    "id": "150450657",
                    "speaker": "班尼特",
                    "text": "在这次旅程中获得的温暖，足以让我面对未来的所有挑战。"
                },
                {
                    "id": "150450658",
                    "speaker": "班尼特",
                    "text": "我想把握自己的命运。我想将这份家人和朋友带给我的温暖，继续传递下去。这个想法一直没变。"
                },
                {
                    "id": "150450659",
                    "speaker": "恰斯卡",
                    "text": "敬我们的团长！"
                },
                {
                    "id": "150450660",
                    "speaker": "温迪",
                    "text": "敬班尼特团长！"
                },
                {
                    "id": "150450661",
                    "speaker": "玛拉妮",
                    "text": "干杯干杯——！"
                },
                {
                    "id": "150450662",
                    "speaker": "派蒙",
                    "text": "呃…竟然快要通宵了…"
                },
                {
                    "id": "150450663",
                    "speaker": "玛拉妮",
                    "text": "玩得尽兴嘛！接下去轮到谁表演？"
                },
                {
                    "id": "150450664",
                    "speaker": "恰斯卡",
                    "text": "我看班尼特好几次要睡着了。"
                },
                {
                    "id": "150450665",
                    "speaker": "班尼特",
                    "text": "没有，没有…我还可以…"
                },
                {
                    "id": "150450666",
                    "speaker": "恰斯卡",
                    "text": "大家都回去休息吧，玛拉妮，这么有力气就交给你收拾场地了。"
                },
                {
                    "id": "150450667",
                    "speaker": "玛拉妮",
                    "text": "欸？为什么是我——"
                },
                {
                    "id": "150450668",
                    "speaker": "温迪",
                    "text": "#{NICKNAME}，再陪我散散步？"
                },
                {
                    "id": "150450669",
                    "speaker": "温迪",
                    "text": "我知道一个风景不错的地方。"
                }
            ]
        },
        {
            "id": "1504507",
            "objective": "前往温迪所说的地点",
            "dialogues": [
                {
                    "id": "150450701",
                    "speaker": "派蒙",
                    "text": "卖唱的，你还是那么会挑地方…"
                },
                {
                    "id": "150450702",
                    "speaker": "温迪",
                    "text": "很高兴你能喜欢。有些故事不适合飞鸟，只能说给高处的星辰听呢。"
                },
                {
                    "id": "150450703",
                    "speaker": "Player",
                    "text": "要讲睡前故事了吗？"
                },
                {
                    "id": "150450704",
                    "speaker": "温迪",
                    "text": "哈哈，这篇故事，要从「时间」开始说起。"
                },
                {
                    "id": "150450705",
                    "speaker": "温迪",
                    "text": "很久很久以前，「时{RUBY#[D]伊斯塔露}间」开始记录这个世界。"
                },
                {
                    "id": "150450706",
                    "speaker": "温迪",
                    "text": "她对栖息在尘世的生灵一视同仁，与此同时，这些生灵在她心中也是同等的无足轻重。"
                },
                {
                    "id": "150450707",
                    "speaker": "温迪",
                    "text": "她就好像一张古老的卷轴，将所有人、所有事、所有的相遇与别离都刻印在自己的记忆中。"
                },
                {
                    "id": "150450708",
                    "speaker": "温迪",
                    "text": "那时还是风精灵的我，在千风神殿与「时间」偶遇。"
                },
                {
                    "id": "150450709",
                    "speaker": "温迪",
                    "text": "她聆听我的愿望，将部分力量与权能的碎片出让给了我…",
                    "choices": [
                        {
                            "id": "150450710",
                            "text": "风带来了种子…",
                            "response": [
                                {
                                    "id": "150450712",
                                    "speaker": "温迪",
                                    "text": "看来这不是你第一次听说「时间与风」的故事。"
                                },
                                {
                                    "id": "150450713",
                                    "speaker": "温迪",
                                    "text": "这不是很有韵味吗？"
                                },
                                {
                                    "id": "150450714",
                                    "speaker": "温迪",
                                    "text": "靠着铭刻在祭礼、诗歌、遗迹和古籍中的记忆，被视作微不足道的生灵们一次次「见」到了时间。"
                                },
                                {
                                    "id": "150450715",
                                    "speaker": "派蒙",
                                    "text": "这就是你要说的故事？"
                                },
                                {
                                    "id": "150450716",
                                    "speaker": "温迪",
                                    "text": "嗯…只能算是故事的「序章」。"
                                },
                                {
                                    "id": "150450717",
                                    "speaker": "温迪",
                                    "text": "烬寂海的污染是具有时间特性的，换句话说，它的灾害存在于时间的每一处。"
                                },
                                {
                                    "id": "150450718",
                                    "speaker": "温迪",
                                    "text": "不同于「时间」本身，我的心中，一直存在诸多愿望。"
                                },
                                {
                                    "id": "150450719",
                                    "speaker": "温迪",
                                    "text": "五百年前，为了防止烬寂海的污染继续扩散，影响特诺奇兹托克以外的更多区域…"
                                },
                                {
                                    "id": "150450720",
                                    "speaker": "温迪",
                                    "text": "我将烬寂海从时间轴上吹了出去，让它成为了「无风之地」。"
                                },
                                {
                                    "id": "150450721",
                                    "speaker": "Player",
                                    "text": "这就是烬寂海消失之谜的真相吗…"
                                },
                                {
                                    "id": "150450722",
                                    "speaker": "温迪",
                                    "text": "哎呀，好像让你弄混了呢。"
                                },
                                {
                                    "id": "150450723",
                                    "speaker": "温迪",
                                    "text": "如果你问的是二三十年前，烬寂海从特诺奇兹托克消失的事，或许存在比我更适合的讲述人。"
                                },
                                {
                                    "id": "150450724",
                                    "speaker": "温迪",
                                    "text": "烬寂海承载了太多不应属于它的故事…我仅参与了其中一个篇章。"
                                },
                                {
                                    "id": "150450725",
                                    "speaker": "温迪",
                                    "text": "而我在五百年前做出的选择，也有代价。"
                                },
                                {
                                    "id": "150450726",
                                    "speaker": "温迪",
                                    "text": "有些灵魂因此无法返回蒙德…另有些灵魂沉淀在这块土地上，和幻写灵结合，成为了你我所见的阿夏。"
                                },
                                {
                                    "id": "150450727",
                                    "speaker": "派蒙",
                                    "text": "所以，你这次来特诺奇兹托克是为了…"
                                },
                                {
                                    "id": "150450728",
                                    "speaker": "温迪",
                                    "text": "没错，我需要和现任火神玛薇卡合作。"
                                },
                                {
                                    "id": "150450729",
                                    "speaker": "Player",
                                    "text": "是在点燃蜡烛的时候吗？"
                                },
                                {
                                    "id": "150450730",
                                    "speaker": "温迪",
                                    "text": "猜对咯，火光是我们的暗号。"
                                },
                                {
                                    "id": "150450731",
                                    "speaker": "温迪",
                                    "text": "由玛薇卡从那片空间中开启通往真正烬寂海的裂隙，我才能悄悄钻进去，把所有愿意回家的灵魂都接送回去。"
                                },
                                {
                                    "id": "150450732",
                                    "speaker": "温迪",
                                    "text": "至于带回记忆这种小把戏…欸嘿，也不是第一次了吧。"
                                },
                                {
                                    "id": "150450733",
                                    "speaker": "温迪",
                                    "text": "玛薇卡还和我提到了你想帮忙引荐的事…没想到还是被我抢先了。"
                                },
                                {
                                    "id": "150450734",
                                    "speaker": "温迪",
                                    "text": "很高兴看到她也热爱着美酒与自由…我们很聊得来。",
                                    "choices": [
                                        {
                                            "id": "150450735",
                                            "text": "真有你的…",
                                            "response": [
                                                {
                                                    "id": "150450737",
                                                    "speaker": "温迪",
                                                    "text": "我可是累了好几天，差点就要再度沉睡过去啦。"
                                                },
                                                {
                                                    "id": "150450738",
                                                    "speaker": "派蒙",
                                                    "text": "真的吗？"
                                                },
                                                {
                                                    "id": "150450739",
                                                    "speaker": "温迪",
                                                    "text": "但想到蜜酿和蒲公英酒都没喝够，说什么都得再多撑一下吧？"
                                                },
                                                {
                                                    "id": "150450740",
                                                    "speaker": "派蒙",
                                                    "text": "我看你还不够累，只用这点理由别想让我们请客。"
                                                },
                                                {
                                                    "id": "150450741",
                                                    "speaker": "温迪",
                                                    "text": "哎——太严格了吧？"
                                                },
                                                {
                                                    "id": "150450742",
                                                    "speaker": "Player",
                                                    "text": "温迪…"
                                                },
                                                {
                                                    "id": "150450743",
                                                    "speaker": "温迪",
                                                    "text": "#{NICKNAME}，你会接济美酒给我的，对吗？",
                                                    "choices": [
                                                        {
                                                            "id": "150450744",
                                                            "text": "我有些好奇。",
                                                            "response": [
                                                                {
                                                                    "id": "150450746",
                                                                    "speaker": "温迪",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "150450747",
                                                                    "speaker": "温迪",
                                                                    "text": "或许就是守护蒙德这个地方，让所有愿意在蒙德驻足的人都有选择的自由吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "150450745",
                                                            "text": "你现在的愿望是什么呢？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "150450736",
                                            "text": "做了那么大一件事…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "150450711",
                            "text": "时间使其发芽…"
                        }
                    ]
                }
            ]
        },
        {
