            "dialogues": [
                {
                    "id": "190560901",
                    "speaker": "鹿野院平藏",
                    "text": "让我看看是哪位仁兄在投诉我…"
                }
            ]
        },
        {
            "id": "1905610",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "190561001",
                    "speaker": "上杉",
                    "text": "真是怪事，连平藏前辈也能被投诉，这同心真不好当啊。"
                }
            ]
        },
        {
            "id": "1905611",
            "objective": "Additional",
            "dialogues": [
