        {
            "id": "1905603",
            "objective": "查看卷宗",
            "dialogues": [
                {
                    "id": "190561201",
                    "speaker": "关于「鹿说诈骗」的同意批复",
                    "text": "奉行所：你所申请「鹿说诈骗」宣传活动计划案已收悉，经研究，同意你所操办，由鹿野院同心主持相关工作。——天领奉行府。"
                },
                {
                    "id": "190561202",
                    "speaker": "派蒙",
                    "text": "「鹿说诈骗」？这是什么东西，听起来还挺有意思的。"
                }
            ]
        },
        {
            "id": "1905604",
            "objective": "查看卷宗",
            "dialogues": [
                {
                    "id": "190561301",
                    "speaker": "「东方快车失踪案」",
                    "text": "名为「东方快车」的宠物犬深夜失踪，主人发现院落出现十二枚不同大小的犬类足迹，初步推断为团伙作案…"
                },
                {
                    "id": "190561302",
                    "speaker": "派蒙",
                    "text": "怎么会有狗狗叫这么奇怪的名字啊。"
                }
            ]
        },
        {
            "id": "1905605",
            "objective": "查看卷宗",
            "dialogues": [
                {
                    "id": "190561401",
                    "speaker": "「花见坂的混世魔王」",
                    "text": "花见坂出没自称「混世魔王」的闲散分子，据查，似乎有孩童出现财物损失，多为鬼兜虫、七圣召唤卡牌等…"
                },
                {
                    "id": "190561402",
                    "speaker": "派蒙",
                    "text": "好嘛！不会又是那个家伙吧…"
                }
            ]
        },
        {
            "id": "1905608",
            "objective": "与平藏交谈",
            "dialogues": []
        },
        {
            "id": "1905609",
