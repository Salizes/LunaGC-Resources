    "talks": [
        {
            "id": "2050301",
            "objective": "(test)和铁匠瓦格纳交谈$HIDDEN",
            "dialogues": [
                {
                    "id": "205030101",
                    "speaker": "派蒙",
                    "text": "接下来的冒险可能会越来越危险，我们先做好准备吧。"
                }
            ]
        },
        {
            "id": "2050302",
            "objective": "和铁匠瓦格纳交谈",
            "dialogues": [
                {
                    "id": "205030201",
                    "speaker": "瓦格纳",
                    "text": "什么事？",
                    "choices": [
                        {
                            "id": "205030202",
                            "text": "想看看武器。",
                            "response": [
                                {
                                    "id": "205030203",
                                    "speaker": "瓦格纳",
                                    "text": "都在那边，自己挑吧。想要更称手的，我也能定做。"
                                },
                                {
                                    "id": "205030207",
                                    "speaker": "派蒙",
                                    "text": "原来还能定做…"
                                },
                                {
                                    "id": "205030208",
                                    "speaker": "瓦格纳",
                                    "text": "当然。贩卖，定做，精炼，都是铁匠铺的生意。"
                                },
                                {
                                    "id": "205030209",
                                    "speaker": "瓦格纳",
                                    "text": "只要你有矿石就行。",
                                    "choices": [
                                        {
                                            "id": "205030210",
                                            "text": "在哪里能找到矿石？",
                                            "response": [
                                                {
                                                    "id": "205030211",
                                                    "speaker": "瓦格纳",
                                                    "text": "哪里都有。"
                                                },
                                                {
                                                    "id": "205030214",
                                                    "speaker": "瓦格纳",
                                                    "text": "这样吧，看你迷迷糊糊的，我把附近铁块比较多的地方告诉你。"
                                                },
                                                {
                                                    "id": "205030215",
                                                    "speaker": "瓦格纳",
                                                    "text": "如果你能把铁块带回来，我就帮你锻造。"
                                                },
                                                {
                                                    "id": "205030216",
                                                    "speaker": "Player",
                                                    "text": "好的，谢谢。"
                                                },
                                                {
                                                    "id": "205030217",
                                                    "speaker": "瓦格纳",
                                                    "text": "用不着。那我继续忙了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "205030212",
                                            "text": "你这里卖吗？",
                                            "response": [
                                                {
                                                    "id": "205030213",
                                                    "speaker": "瓦格纳",
                                                    "text": "找别人去，我自己都不够用。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "205030204",
                            "text": "想帮派蒙看看武器。",
                            "response": [
                                {
                                    "id": "205030205",
                                    "speaker": "派蒙",
                                    "text": "没听说这回事啊！要让我打头阵吗？"
                                },
                                {
                                    "id": "205030206",
                                    "speaker": "瓦格纳",
                                    "text": "这么小一只，嗯，那要定做了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2050303",
            "objective": "(test)和铁匠瓦格纳交谈$HIDDEN",
            "dialogues": [
                {
                    "id": "205030301",
                    "speaker": "派蒙",
                    "text": "铁匠铺就在那边！"
                }
            ]
        },
        {
            "id": "2050304",
            "objective": "收集3个铁块带给瓦格纳",
            "dialogues": [
                {
                    "id": "205030401",
                    "speaker": "派蒙",
                    "text": "感觉他有点不耐烦…打扰到他了吗？"
                }
            ]
        },
        {
            "id": "2050305",
            "objective": "和铁匠瓦格纳交谈",
            "dialogues": [
                {
                    "id": "205030501",
                    "speaker": "瓦格纳",
                    "text": "干嘛？",
                    "choices": [
                        {
                            "id": "205030502",
                            "text": "采到铁块了。",
                            "response": [
                                {
                                    "id": "205030504",
                                    "speaker": "瓦格纳",
                                    "text": "哦对，好像有这么回事，我都忙忘了。"
                                },
                                {
                                    "id": "205030505",
                                    "speaker": "瓦格纳",
                                    "text": "还行吧，看这成色，不是不能用。"
                                },
                                {
                                    "id": "205030506",
                                    "speaker": "瓦格纳",
                                    "text": "想委托锻造"
                                }
                            ]
                        },
                        {
                            "id": "205030503",
                            "text": "你之前让我去采铁块…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2050306",
            "objective": "(test)继续与瓦格纳对话$HIDDEN",
            "dialogues": [
                {
                    "id": "205030601",
                    "speaker": "瓦格纳",
                    "text": "以后找到了矿石，都可以来找我。"
                },
                {
                    "id": "205030602",
                    "speaker": "瓦格纳",
                    "text": "当然，最好是在我不忙的时候。"
                },
                {
                    "id": "205030603",
                    "speaker": "Player",
                    "text": "感觉你心情不好。"
                },
                {
                    "id": "205030604",
                    "speaker": "瓦格纳",
                    "text": "打铁要全神贯注，我不喜欢和客人闲聊。"
                },
                {
                    "id": "205030605",
                    "speaker": "瓦格纳",
                    "text": "手艺好，生意就好，做其他的都是投机取巧。"
                },
                {
                    "id": "205030606",
                    "speaker": "瓦格纳",
                    "text": "没事的话，我就继续忙了。"
                }
            ]
        }
    ]
}