    "talks": [
        {
            "id": "7007302",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "700730101",
                    "speaker": "Player",
                    "text": "我想和这个大家伙切磋。"
                },
                {
                    "id": "700730102",
                    "speaker": "摩答伐",
                    "text": "善哉！吾主亦须时刻舒展神躯，落下的蕈片口感才会更美味！还请全力以赴，切莫手下留情！"
                }
            ]
        },
        {
            "id": "7007303",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "700730301",
                    "speaker": "Player",
                    "text": "这是什么玩意儿…？"
                },
                {
                    "id": "700730302",
                    "speaker": "摩答伐",
                    "text": "善哉斯问！此为吾等所供奉的赐生世{RUBY#[S]比夫茏}尊神之嗣，道成正味之蕈子！"
                },
                {
                    "id": "700730303",
                    "speaker": "摩答伐",
                    "text": "龙呼常念草木之主与花{RUBY#[D]浮槃婆梨袈}圃之主，玛卡尼哈冈总向赤砂之神祷告——汝可问问他们，那三位尊神，有哪一位比吾主更美味？"
                },
                {
                    "id": "700730304",
                    "speaker": "摩答伐",
                    "text": "须知不害即是正业。若非吾主的神躯，吾等亦要取鸟兽草木之命以维生…呜呼，何等可哀！"
                },
                {
                    "id": "700730305",
                    "speaker": "摩答伐",
                    "text": "所幸，空之主将吾带离大地时，吾主的耆{RUBY#[D]孢子}婆亦与吾同行。如是汝观，今已生长至此，赐吾等无上妙味。"
                }
            ]
        },
        {
            "id": "7007301",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7007302",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700730201",
                    "speaker": "摩答伐",
                    "text": "吾主摩诃婆苏{RUBY#[D]赐生世尊之嗣}提婆耶弗啊，愿汝的耆婆{RUBY#[D]命根}提耶深入这岩地的基石，愿汝的美味胜过世间一切神明…"
                }
            ]
        },
        {
            "id": "7007304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "700730401",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "700730402",
                    "speaker": "摩答伐",
                    "text": "随意所往，蕈自护持。"
                }
            ]
        },
