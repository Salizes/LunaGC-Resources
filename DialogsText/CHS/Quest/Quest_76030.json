    "talks": [
        {
            "id": "7603001",
            "objective": "同「少女」见面",
            "dialogues": [
                {
                    "id": "760300101",
                    "speaker": "派蒙",
                    "text": "哦~今天这里的氛围有些不寻常嘛，哥伦比娅你在装点这处花田吗？"
                },
                {
                    "id": "760300102",
                    "speaker": "「少女」",
                    "text": "不是我，是它们。"
                },
                {
                    "id": "760300103",
                    "speaker": "派蒙",
                    "text": "它们…月灵？"
                },
                {
                    "id": "760300104",
                    "speaker": "「少女」",
                    "text": "这种石头在吸收了月矩力之后会泛出微光，月灵们很喜欢。"
                },
                {
                    "id": "760300105",
                    "speaker": "派蒙",
                    "text": "所以它们就…把石头放在地上玩？"
                },
                {
                    "id": "760300106",
                    "speaker": "「少女」",
                    "text": "你们到这里来。"
                },
                {
                    "id": "760300107",
                    "speaker": "派蒙",
                    "text": "嗯？"
                },
                {
                    "id": "760300108",
                    "speaker": "派蒙",
                    "text": "哦！原来从高处看的话是一幅画欸！"
                },
                {
                    "id": "760300109",
                    "speaker": "Player",
                    "text": "但好像缺了一块…"
                },
                {
                    "id": "760300110",
                    "speaker": "「少女」",
                    "text": "有些不够了，我去采一点吧。"
                },
                {
                    "id": "760300111",
                    "speaker": "派蒙",
                    "text": "咦？你要出去采？"
                },
                {
                    "id": "760300112",
                    "speaker": "「少女」",
                    "text": "我知道一处不错的地方，那里月光照拂，有很多这样的石头。"
                },
                {
                    "id": "760300113",
                    "speaker": "Player",
                    "text": "要我们陪你吗？"
                },
                {
                    "id": "760300114",
                    "speaker": "「少女」",
                    "text": "好啊。"
                },
                {
                    "id": "760300115",
                    "speaker": "派蒙",
                    "text": "嗯，那就多采一些吧，我们也想看看完整的画呢。"
                }
            ]
        },
        {
            "id": "7603006",
            "objective": "前往指定地点采集矿石",
            "dialogues": []
        },
        {
            "id": "7603002",
            "objective": "采集矿石",
            "dialogues": []
        },
        {
            "id": "7603003",
            "objective": "同「少女」对话",
            "dialogues": [
                {
                    "id": "760300301",
                    "speaker": "派蒙",
                    "text": "这样就够了吧。总觉得已经采了好多好多。"
                },
                {
                    "id": "760300302",
                    "speaker": "派蒙",
                    "text": "我们回去吧，也不能老让那画缺一块。"
                },
                {
                    "id": "760300303",
                    "speaker": "莉洁卡",
                    "text": "呜呜…呜呜…"
                },
                {
                    "id": "760300304",
                    "speaker": "派蒙",
                    "text": "呀！有人过来了，先躲起来！"
                },
                {
                    "id": "760300305",
                    "speaker": "莉洁卡",
                    "text": "呜呜…这里是哪里呀…妈妈…我想回家…"
                },
                {
                    "id": "760300306",
                    "speaker": "派蒙",
                    "text": "看起来是「霜月之子」的人欸，她迷路了吗？"
                },
                {
                    "id": "760300307",
                    "speaker": "Player",
                    "text": "我去帮帮她吧…"
                },
                {
                    "id": "760300308",
                    "speaker": "「少女」",
                    "text": "真的吗？"
                },
                {
                    "id": "760300309",
                    "speaker": "派蒙",
                    "text": "啊？这怎么看都得帮吧！"
                },
                {
                    "id": "760300310",
                    "speaker": "「少女」",
                    "text": "我记得「霜月之子」对「外来者」很戒备。这么晚了，你头上没有角冠，如果她反倒被吓跑…"
                },
                {
                    "id": "760300311",
                    "speaker": "派蒙",
                    "text": "你…你说得倒的确有可能，但也不能就这么不管吧！"
                },
                {
                    "id": "760300312",
                    "speaker": "「少女」",
                    "text": "唔…跟我来。"
                },
                {
                    "id": "760300313",
                    "speaker": "派蒙",
                    "text": "欸？"
                }
            ]
        },
        {
            "id": "7603007",
            "objective": "帮助迷路的孩子",
            "dialogues": []
        },
        {
            "id": "7603004",
            "objective": "利用矿石搭建道路的指引",
            "dialogues": []
        },
        {
            "id": "7603005",
            "objective": "同「少女」对话",
            "dialogues": [
                {
                    "id": "760300501",
                    "speaker": "莉洁卡",
                    "text": "呜呜…咦？这是…"
                },
                {
                    "id": "760300502",
                    "speaker": "莉洁卡",
                    "text": "好漂亮…"
                },
                {
                    "id": "760300503",
                    "speaker": "「少女」",
                    "text": "这样就好了。"
                },
                {
                    "id": "760300504",
                    "speaker": "派蒙",
                    "text": "哦~她一路捡着石头回去了，那边是「霜月之坊」的方向呢。"
                },
                {
                    "id": "760300505",
                    "speaker": "Player",
                    "text": "（哥伦比娅…虽说自己不想被当作「神明」，但还是会帮助遇到困难的人…）"
                },
                {
                    "id": "760300506",
                    "speaker": "派蒙",
                    "text": "啊，但这么一来，那幅画是不是就…"
                },
                {
                    "id": "760300507",
                    "speaker": "「少女」",
                    "text": "没关系。"
                },
                {
                    "id": "760300508",
                    "speaker": "「少女」",
                    "text": "残缺的画可以之后再添上。"
                },
                {
                    "id": "760300509",
                    "speaker": "「少女」",
                    "text": "我喜欢看人们找到「回家」的路，回到属于他们的「家」。"
                }
            ]
        },
        {
            "id": "7603099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760309907",
                    "speaker": "「少女」",
                    "text": "往左边一点。"
                },
                {
                    "id": "760309908",
                    "speaker": "「少女」",
                    "text": "那边往右一些。"
                },
                {
                    "id": "760309909",
                    "speaker": "「少女」",
                    "text": "嗯，不错。"
                }
            ]
        }
    ]
}