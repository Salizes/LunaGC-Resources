    "talks": [
        {
            "id": "7715801",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771580101",
                    "speaker": "泛黄的记录簿",
                    "text": "「…没想到妖精（…）的适应性仍然很高，是因为从前亥珀波瑞亚在制造妖精时就留下了什么接口吗…」"
                },
                {
                    "id": "771580102",
                    "speaker": "泛黄的记录簿",
                    "text": "「树木构成的身躯能够在破坏中重新生长，也能让受试者获得远超原本躯体的力量，只不过语言功能会退化…」"
                },
                {
                    "id": "771580103",
                    "speaker": "泛黄的记录簿",
                    "text": "「毕竟，已没有那么多痛苦需要述说。」"
                },
                {
                    "id": "771580104",
                    "speaker": "泛黄的记录簿",
                    "text": "「在下水道进行的实验已经收集到了足够的数据，接下来就是逐渐让镇子上的人接受这一点…」"
                },
                {
                    "id": "771580105",
                    "speaker": "泛黄的记录簿",
                    "text": "「不过，当他们看到弗瑞奥萨完成的『治疗』，总有被病痛折磨的可怜人想要尝试一下的吧…」"
                },
                {
                    "id": "771580106",
                    "speaker": "派蒙",
                    "text": "患者的名字是…弗瑞奥萨？！这不就是刚刚桥上的那个…"
                },
                {
                    "id": "771580107",
                    "speaker": "派蒙",
                    "text": "这么看，这家伙就是罪魁祸首！先在下水道试着改造弗瑞奥萨，再把其他人都变成树妖…不对，变成什么「完全树」！"
                },
                {
                    "id": "771580108",
                    "speaker": "派蒙",
                    "text": "等见到他了，一定要狠狠揍他一顿！"
                }
            ]
        },
        {
            "id": "7715802",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7715803",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771580301",
                    "speaker": "操作指南·其二",
                    "text": "…将【铁钥匙】与【银钥匙】其一插入凹槽可降低水面…将【铁钥匙】与【银钥匙】同时插入凹槽则可完全排空积水…"
                },
                {
                    "id": "771580302",
                    "speaker": "派蒙",
                    "text": "唔…这里一直在讲怎么降低水面，那下面肯定藏着什么东西。"
                },
                {
                    "id": "771580303",
                    "speaker": "派蒙",
                    "text": "那这里也要<color=#00E1FFFF>【铁钥匙】</color>！还得想想办法把里面的那把拿出来…"
                },
                {
                    "id": "771580304",
                    "speaker": "派蒙",
                    "text": "呃啊…好麻烦，为什么要在下水道设置这么这么复杂的机关呢…"
                }
            ]
        },
        {
            "id": "7715804",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7715807",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "771580701",
                    "speaker": "《下水道出入指南》",
                    "text": "…于下端深挖主干渠…搭建中空舱室…取金、银、铁所制钥匙分控蓄水池…以排谷内积水…"
                }
            ]
        }
    ]
}