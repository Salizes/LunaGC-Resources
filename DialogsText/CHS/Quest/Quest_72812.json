    "talks": [
        {
            "id": "7281201",
            "objective": "与顺吉对话",
            "dialogues": [
                {
                    "id": "728120101",
                    "speaker": "顺吉",
                    "text": "…我这次的构思就是这样。"
                },
                {
                    "id": "728120102",
                    "speaker": "顺吉",
                    "text": "身怀绝技的忍者，用各种绝技潜入敌方的堡垒，偷取到自己想要的情报…"
                },
                {
                    "id": "728120103",
                    "speaker": "阿茂",
                    "text": "唉…那你准备给这个忍者多少种「绝技」？"
                },
                {
                    "id": "728120104",
                    "speaker": "顺吉",
                    "text": "这、这个…当然是要视情况而定啦。"
                },
                {
                    "id": "728120105",
                    "speaker": "阿茂",
                    "text": "也就说，你完全没有想好这件事吧？"
                },
                {
                    "id": "728120106",
                    "speaker": "顺吉",
                    "text": "没关系！要是事先把设定写死了，那后面的剧情也不好展开了嘛…"
                },
                {
                    "id": "728120107",
                    "speaker": "阿茂",
                    "text": "你又来了…要是你不定好这些设定，写着写着又会变得乱七八糟了！"
                },
                {
                    "id": "728120108",
                    "speaker": "顺吉",
                    "text": "我、我有我自己的创作方式！故事当然是要以剧情为主，怎么能被设定束缚！"
                },
                {
                    "id": "728120109",
                    "speaker": "阿茂",
                    "text": "这观点也太不负责了，我说你啊…"
                },
                {
                    "id": "728120110",
                    "speaker": "Player",
                    "text": "你们在吵什么呢？"
                },
                {
                    "id": "728120111",
                    "speaker": "顺吉",
                    "text": "喔！是你啊，我正在构思一部以忍者为主题的小说呢。"
                },
                {
                    "id": "728120112",
                    "speaker": "顺吉",
                    "text": "可是，阿茂又觉得我的构思不好了…"
                },
                {
                    "id": "728120113",
                    "speaker": "阿茂",
                    "text": "我没有觉得你的构思不好…我是说你要脚踏实地，在动笔之前，先把设定全都定下来…"
                },
                {
                    "id": "728120114",
                    "speaker": "顺吉",
                    "text": "不行，不行…我才不要先写一大堆设定，再根据设定来想剧情，那样也太死板了。"
                },
                {
                    "id": "728120115",
                    "speaker": "顺吉",
                    "text": "剧情是小说里最重要的东西，小说里的一切都要为剧情服务，设定也是…"
                },
                {
                    "id": "728120116",
                    "speaker": "阿茂",
                    "text": "你…"
                },
                {
                    "id": "728120117",
                    "speaker": "顺吉",
                    "text": "我…",
                    "choices": [
                        {
                            "id": "728120118",
                            "text": "你们俩别吵了！",
                            "response": [
                                {
                                    "id": "728120120",
                                    "speaker": "阿茂",
                                    "text": "算了，这样肯定说服不了你…"
                                },
                                {
                                    "id": "728120121",
                                    "speaker": "顺吉",
                                    "text": "无论你怎么说，我也不会放弃我的创作原则。"
                                },
                                {
                                    "id": "728120122",
                                    "speaker": "阿茂",
                                    "text": "真是…旅行者，既然你在这里，不如就由你来判断一下这件事吧。",
                                    "choices": [
                                        {
                                            "id": "728120123",
                                            "text": "我怎么判断…",
                                            "response": [
                                                {
                                                    "id": "728120125",
                                                    "speaker": "阿茂",
                                                    "text": "唔，你只需要在这里听顺吉说说他最新构思的那一段剧情。"
                                                },
                                                {
                                                    "id": "728120126",
                                                    "speaker": "阿茂",
                                                    "text": "再根据你自己的判断，来想想他笔下的那位「忍者」会如何行动。"
                                                },
                                                {
                                                    "id": "728120127",
                                                    "speaker": "阿茂",
                                                    "text": "这样，就能让顺吉这家伙见识到不写好设定就开始写剧情的后果了。"
                                                },
                                                {
                                                    "id": "728120128",
                                                    "speaker": "顺吉",
                                                    "text": "哼，这样也好。旅行者，那就拜托你了。"
                                                },
                                                {
                                                    "id": "728120129",
                                                    "speaker": "顺吉",
                                                    "text": "我等会就把故事讲给你听，你就根据自己的判断来行动吧。"
                                                },
                                                {
                                                    "id": "728120130",
                                                    "speaker": "顺吉",
                                                    "text": "然后，让阿茂这家伙看看，没有设定束缚的故事到底有多有趣。"
                                                },
                                                {
                                                    "id": "728120131",
                                                    "speaker": "阿茂",
                                                    "text": "你…"
                                                },
                                                {
                                                    "id": "728120132",
                                                    "speaker": "顺吉",
                                                    "text": "我…",
                                                    "choices": [
                                                        {
                                                            "id": "728120133",
                                                            "text": "我们快点开始吧…",
                                                            "response": [
                                                                {
                                                                    "id": "728120135",
                                                                    "speaker": "顺吉",
                                                                    "text": "那我们现在就开始吧，旅行者。"
                                                                },
                                                                {
                                                                    "id": "728120136",
                                                                    "speaker": "顺吉",
                                                                    "text": "我要写的这段剧情是，一个忍者独自潜入敌方堡垒，准备偷取重要的情报。"
                                                                },
                                                                {
                                                                    "id": "728120137",
                                                                    "speaker": "顺吉",
                                                                    "text": "嘿嘿，旅行者，你准备好扮演忍者了吗？"
                                                                },
                                                                {
                                                                    "id": "728120138",
                                                                    "speaker": "顺吉",
                                                                    "text": "这名忍者已经做好了一切准备，悄悄地潜入了堡垒之中…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "728120134",
                                                            "text": "创作真是件麻烦事…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "728120124",
                                            "text": "我要在这里看小说吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "728120119",
                            "text": "你俩停一下！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7281204",
            "objective": "与顺吉对话",
            "dialogues": []
        },
        {
            "id": "7281202",
            "objective": "感受顺吉的「故事」",
            "dialogues": [
                {
                    "id": "728120201",
                    "speaker": "顺吉",
                    "text": "好了，故事就到此结束了。"
                },
                {
                    "id": "728120202",
                    "speaker": "顺吉",
                    "text": "我从来没这么累过，这故事真的有这么复杂吗…"
                },
                {
                    "id": "728120203",
                    "speaker": "阿茂",
                    "text": "这就是你不事先定好设定的下场。没有设定束缚，故事里的所有元素都会乱七八糟地撞来撞去。"
                },
                {
                    "id": "728120204",
                    "speaker": "阿茂",
                    "text": "在这种情况下，你对故事压根没有任何掌控力，无论写什么剧情都会累个半死。"
                },
                {
                    "id": "728120205",
                    "speaker": "顺吉",
                    "text": "唉，我没力气和你争了…旅行者，谢谢您做出的这些…判断。"
                },
                {
                    "id": "728120206",
                    "speaker": "顺吉",
                    "text": "这些判断实在是让我…获益匪浅。"
                },
                {
                    "id": "728120207",
                    "speaker": "顺吉",
                    "text": "这些谢礼请您收下，我等会就回去接着写小说去。"
                },
                {
                    "id": "728120208",
                    "speaker": "顺吉",
                    "text": "设定和剧情，唉…到底哪个比较重要呢…"
                }
            ]
        },
        {
            "id": "7281203",
            "objective": "向顺吉回报",
            "dialogues": []
        }
    ]
}