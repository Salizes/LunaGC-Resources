    "talks": [
        {
            "id": "7412701",
            "objective": "前往枫丹科学院",
            "dialogues": [
                {
                    "id": "741270101",
                    "speaker": "舒瓦瑟尔",
                    "text": "…就像我之前强调的那样，亲爱的复律官，规定如此，我也没有办法。"
                },
                {
                    "id": "741270102",
                    "speaker": "舒瓦瑟尔",
                    "text": "洛耶茨先生确实已经寄来了所需文件的清单，我也准备好了那些文件。"
                },
                {
                    "id": "741270103",
                    "speaker": "舒瓦瑟尔",
                    "text": "但是，你不能就这么走过来「取走文件」，这不符合寄送信函的规定。",
                    "choices": [
                        {
                            "id": "741270104",
                            "text": "欸？艾尤恩！",
                            "response": [
                                {
                                    "id": "741270107",
                                    "speaker": "派蒙",
                                    "text": "你好呀，艾尤恩。看起来你状态不错嘛，嘿嘿。"
                                },
                                {
                                    "id": "741270108",
                                    "speaker": "艾尤恩",
                                    "text": "您也好。这都是多亏了洛耶茨先生和瑟米安先生帮忙。"
                                },
                                {
                                    "id": "741270109",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "#咦？艾尤恩，你和{NICKNAME}认识吗？"
                                },
                                {
                                    "id": "741270110",
                                    "speaker": "艾尤恩",
                                    "text": "#当然，{NICKNAME}之前帮了我很大的忙，要是少了{M#他}{F#她}，我肯定不会继续在复律庭工作了。"
                                },
                                {
                                    "id": "741270111",
                                    "speaker": "舒瓦瑟尔",
                                    "text": "#竟然还有这种事？{NICKNAME}不愧是我们枫丹科学院的荣誉高级研究员啊，哈哈哈哈哈哈！",
                                    "choices": [
                                        {
                                            "id": "741270112",
                                            "text": "我很擅长提供精神支持的。",
                                            "response": [
                                                {
                                                    "id": "741270114",
                                                    "speaker": "艾尤恩",
                                                    "text": "无论如何，要是当初没了您的支持，我肯定…肯定没法撑下去…"
                                                },
                                                {
                                                    "id": "741270115",
                                                    "speaker": "艾尤恩",
                                                    "text": "我刚才听舒瓦瑟尔先生说，您是枫丹科学院的「荣誉高级研究员」？"
                                                },
                                                {
                                                    "id": "741270116",
                                                    "speaker": "Player",
                                                    "text": "可不是，我还有奖状呢。"
                                                },
                                                {
                                                    "id": "741270117",
                                                    "speaker": "派蒙",
                                                    "text": "还拍了画片呢！画片里还有我，可惜我没有奖状…"
                                                },
                                                {
                                                    "id": "741270118",
                                                    "speaker": "舒瓦瑟尔",
                                                    "text": "#没错，为了表彰{NICKNAME}之前所作出的功绩，我院已为{M#他}{F#她}授予了荣誉高级研究员称号。"
                                                },
                                                {
                                                    "id": "741270119",
                                                    "speaker": "舒瓦瑟尔",
                                                    "text": "#至于这「功绩」是什么…就让{NICKNAME}自己告诉你吧，我们还是继续谈正事。"
                                                },
                                                {
                                                    "id": "741270120",
                                                    "speaker": "舒瓦瑟尔",
                                                    "text": "那份文件，我的确无法现在就交给你，艾尤恩。"
                                                },
                                                {
                                                    "id": "741270121",
                                                    "speaker": "舒瓦瑟尔",
                                                    "text": "但你之前说，想要请一位研究员为你引路，去枫丹科学院附近留影…这件事毫无问题！"
                                                },
                                                {
                                                    "id": "741270122",
                                                    "speaker": "舒瓦瑟尔",
                                                    "text": "#我认为{NICKNAME}完全堪当此任，{M#他}{F#她}对这周围的地形再熟悉不过了，一定能胜任这份工作。"
                                                },
                                                {
                                                    "id": "741270123",
                                                    "speaker": "舒瓦瑟尔",
                                                    "text": "#您怎么说？{NICKNAME}{M#先生}{F#小姐}。",
                                                    "choices": [
                                                        {
                                                            "id": "741270124",
                                                            "text": "没问题，交给我了。",
                                                            "response": [
                                                                {
                                                                    "id": "741270126",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "您心真好，有您同行我就放心了。我来的时候看见这周围又是失控的机关，又是魔物…"
                                                                },
                                                                {
                                                                    "id": "741270127",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "但留影这件事并不是重点…说真的，舒瓦瑟尔先生…"
                                                                },
                                                                {
                                                                    "id": "741270128",
                                                                    "speaker": "舒瓦瑟尔",
                                                                    "text": "艾尤恩，我也想帮你，但规定如此，我也是有心无力啊。你就别为难我这个只会盖章的事务官啦。"
                                                                },
                                                                {
                                                                    "id": "741270129",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "好吧，好吧…我回去和洛耶茨先生再商量商量这件事…"
                                                                },
                                                                {
                                                                    "id": "741270130",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "再见，舒瓦瑟尔先生，祝您有愉快的一天。"
                                                                },
                                                                {
                                                                    "id": "741270131",
                                                                    "speaker": "舒瓦瑟尔",
                                                                    "text": "谢谢你，在枫丹科学院里，也祝你愉快。"
                                                                },
                                                                {
                                                                    "id": "741270132",
                                                                    "speaker": "艾尤恩",
                                                                    "text": "#{NICKNAME}，那么引路的事就拜托您了，我们先去「玛丽安纪念公园」吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741270125",
                                                            "text": "很高兴能帮上艾尤恩的忙。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741270113",
                                            "text": "我只是修了一下自动盖章机啦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741270105",
                            "text": "那等会我带着你再飞过来。",
                            "response": [
                                {
                                    "id": "741270106",
                                    "speaker": "艾尤恩",
                                    "text": "#{NICKNAME}！我真高兴能在这里见到你，真是太巧了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7412706",
            "objective": "前往「玛丽安纪念公园」",
            "dialogues": []
        },
        {
            "id": "7412707",
            "objective": "打倒所有失控的机关",
            "dialogues": []
        },
        {
            "id": "7412702",
            "objective": "与艾尤恩对话",
            "dialogues": [
                {
                    "id": "741270201",
                    "speaker": "艾尤恩",
                    "text": "呃…这里就是「玛丽安纪念公园」吗？完全看不出来公园的样子…"
                },
                {
                    "id": "741270202",
                    "speaker": "艾尤恩",
                    "text": "洛耶茨先生肯定要失望了，他还打算请人来这里做个演讲呢。"
                },
                {
                    "id": "741270203",
                    "speaker": "艾尤恩",
                    "text": "看看这环境，演讲应该是做不成了…而且连标志性建筑都没有，合影也合不成。"
                },
                {
                    "id": "741270204",
                    "speaker": "Player",
                    "text": "可以抓点机关回去做纪念品。"
                },
                {
                    "id": "741270205",
                    "speaker": "艾尤恩",
                    "text": "哈哈哈，您真幽默。但复律庭里可没地方放这种东西。"
                },
                {
                    "id": "741270206",
                    "speaker": "艾尤恩",
                    "text": "而且就算抓回去了，我还得把这机关拿去估价、备案、分类、然后再封存…"
                },
                {
                    "id": "741270207",
                    "speaker": "派蒙",
                    "text": "喂！我们就是开个玩笑，不要突然这么认真地开始思考工作的事啊！"
                },
                {
                    "id": "741270208",
                    "speaker": "艾尤恩",
                    "text": "说起备案…我还是没把那份文件拿到，洛耶茨先生肯定又要叹气了…",
                    "choices": [
                        {
                            "id": "741270209",
                            "text": "舒瓦瑟尔为难你了吗？",
                            "response": [
                                {
                                    "id": "741270210",
                                    "speaker": "艾尤恩",
                                    "text": "也谈不上为难，我…我的请求确实有些违反规定了，他不答应是很正常的事。"
                                },
                                {
                                    "id": "741270212",
                                    "speaker": "艾尤恩",
                                    "text": "事情是这样的。枫丹科学院不是正在筹划重建工作吗？一些物资和人员调配需要通过复律庭来沟通…"
                                },
                                {
                                    "id": "741270213",
                                    "speaker": "艾尤恩",
                                    "text": "复律庭很重视这件事，于是就让洛耶茨先生组织一支考察队，准备来科学院附近实地考察一下。"
                                },
                                {
                                    "id": "741270214",
                                    "speaker": "艾尤恩",
                                    "text": "于是，洛耶茨先生留在复律庭里统计人员，我则来科学院协调接待事宜。"
                                },
                                {
                                    "id": "741270215",
                                    "speaker": "艾尤恩",
                                    "text": "正好科学院要寄一份信函回复律庭，我就想着，既然我都来这边了，就顺便把信带回去吧…"
                                },
                                {
                                    "id": "741270216",
                                    "speaker": "艾尤恩",
                                    "text": "但舒瓦瑟尔先生却说，这种行为不符合规定，怎么说都不给我。"
                                },
                                {
                                    "id": "741270217",
                                    "speaker": "派蒙",
                                    "text": "不符合规定？又是不符合哪一条规定呀？"
                                },
                                {
                                    "id": "741270218",
                                    "speaker": "Player",
                                    "text": "取一个文件都有规定？"
                                },
                                {
                                    "id": "741270219",
                                    "speaker": "派蒙",
                                    "text": "呜哇，难道又是那些跑来跑去盖章、到处签字、最后听人啰啰嗦嗦之类的事情吗？"
                                },
                                {
                                    "id": "741270220",
                                    "speaker": "艾尤恩",
                                    "text": "简单来说，复律庭内大部分的公务信函往来，都必须要使用「信件投递」的模式。"
                                },
                                {
                                    "id": "741270221",
                                    "speaker": "派蒙",
                                    "text": "欸？那…那假如要寄信的部门，相距就一条街，或者干脆就是对门呢？"
                                },
                                {
                                    "id": "741270222",
                                    "speaker": "艾尤恩",
                                    "text": "…那也要用信件投递。这是为了保证复律庭内所有公务函件的「可追溯性」。"
                                },
                                {
                                    "id": "741270223",
                                    "speaker": "Player",
                                    "text": "他们是真不嫌麻烦。"
                                },
                                {
                                    "id": "741270224",
                                    "speaker": "艾尤恩",
                                    "text": "我猜想，大家应该已经麻烦惯了吧…"
                                },
                                {
                                    "id": "741270225",
                                    "speaker": "艾尤恩",
                                    "text": "算了，先不谈这些。我们去下一个地方吧，让我看看洛耶茨先生写给我的备忘录…呃…"
                                },
                                {
                                    "id": "741270226",
                                    "speaker": "艾尤恩",
                                    "text": "这个地方叫…枫丹科学院的「学术会堂」。真奇怪，我来的时候没见到挂这牌子的建筑啊。"
                                },
                                {
                                    "id": "741270227",
                                    "speaker": "Player",
                                    "text": "我知道在哪，你跟着我走吧。"
                                },
                                {
                                    "id": "741270228",
                                    "speaker": "艾尤恩",
                                    "text": "您真是可靠！一如既往的可靠，没了您我还怎么工作呀。"
                                },
                                {
                                    "id": "741270229",
                                    "speaker": "艾尤恩",
                                    "text": "那咱们就快点出发吧，说不定这周围还有更多失控的机关呢…"
                                }
                            ]
                        },
                        {
                            "id": "741270211",
                            "text": "你和舒瓦瑟尔讨论什么呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7412703",
            "objective": "前往「学术会堂」",
            "dialogues": [
                {
                    "id": "741270301",
                    "speaker": "艾尤恩",
                    "text": "这就是枫丹科学院的「学术会堂」？"
                },
                {
                    "id": "741270302",
                    "speaker": "艾尤恩",
                    "text": "我承认，这建筑看上去确实挺像「会堂」的，但学术在哪里？",
                    "choices": [
                        {
                            "id": "741270303",
                            "text": "学术在研究员们的脑子里。",
                            "response": [
                                {
                                    "id": "741270305",
                                    "speaker": "艾尤恩",
                                    "text": "好吧，幸好我今天不是为了学术而来的。无论如何，这个建筑看着还挺…完整。"
                                },
                                {
                                    "id": "741270306",
                                    "speaker": "Player",
                                    "text": "也就剩下完整了。"
                                },
                                {
                                    "id": "741270307",
                                    "speaker": "艾尤恩",
                                    "text": "咳！来吧，咱们去周围逛逛，我觉得这里肯定很适合来一张合影。"
                                },
                                {
                                    "id": "741270308",
                                    "speaker": "艾尤恩",
                                    "text": "我得先去找个好角度，免得到时候洛耶茨先生问起来，我又手忙脚乱。"
                                },
                                {
                                    "id": "741270309",
                                    "speaker": "艾尤恩",
                                    "text": "#{NICKNAME}，请您也帮我去拍几张画片吧。我听说您很擅长留影，拍得肯定比我好！"
                                },
                                {
                                    "id": "741270310",
                                    "speaker": "Player",
                                    "text": "交给我了。"
                                }
                            ]
                        },
                        {
                            "id": "741270304",
                            "text": "反正肯定不在这些石头里。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7412708",
            "objective": "去周围拍摄画片，并交给艾尤恩",
            "dialogues": []
        },
        {
            "id": "7412709",
            "objective": "去周围拍摄画片，并交给艾尤恩",
            "dialogues": [
                {
                    "id": "741270901",
                    "speaker": "艾尤恩",
                    "text": "这张还行…欸，您已经拍好画片了吗？",
                    "choices": [
                        {
                            "id": "741270902",
                            "text": "拍好了。"
                        },
                        {
                            "id": "741270903",
                            "text": "马上就好。",
                            "response": [
                                {
                                    "id": "741270904",
                                    "speaker": "艾尤恩",
                                    "text": "您拍好画片之后，就请拿来给我吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7412704",
            "objective": "和艾尤恩对话",
            "dialogues": [
                {
                    "id": "741270401",
                    "speaker": "艾尤恩",
                    "text": "天哪…真是太高了，太高了！"
                },
                {
                    "id": "741270402",
                    "speaker": "Player",
                    "text": "你是在描述科学院的学术水平吗？"
                },
                {
                    "id": "741270403",
                    "speaker": "艾尤恩",
                    "text": "不，我就是在说这里的高度，虽然之前科学院的学术水平确实也不低啦…"
                },
                {
                    "id": "741270404",
                    "speaker": "艾尤恩",
                    "text": "至于现在…唉，谁又想得到科学院会遭那么多罪呢？也不知道重建工作能不能顺利进行…"
                },
                {
                    "id": "741270405",
                    "speaker": "艾尤恩",
                    "text": "最后一站是…「枫丹科学院驻外资质审核办公室」。"
                },
                {
                    "id": "741270406",
                    "speaker": "Player",
                    "text": "亏你能一口气念下来…"
                },
                {
                    "id": "741270407",
                    "speaker": "艾尤恩",
                    "text": "多谢您的夸奖。但是这地方在哪？我在科学院里并没有发现这个办公室啊？"
                },
                {
                    "id": "741270408",
                    "speaker": "Player",
                    "text": "办公室的负责人是德斯诺斯吗？"
                },
                {
                    "id": "741270409",
                    "speaker": "艾尤恩",
                    "text": "对！没错，这地方您也知道？果然不愧是科学院的荣誉高级研究员，简直是科学院万事通啊。"
                },
                {
                    "id": "741270410",
                    "speaker": "派蒙",
                    "text": "喔…我也记起来了！是那个在废墟里的办公室？如果…那也算办公室的话…"
                },
                {
                    "id": "741270411",
                    "speaker": "艾尤恩",
                    "text": "也许是德斯诺斯先生为了方便您理解，将前面的前缀都暂时省略了。"
                },
                {
                    "id": "741270412",
                    "speaker": "艾尤恩",
                    "text": "请您带路吧，我得去那边找德斯诺斯先生拿一些文件，拿完文件后，我就可以回复律庭了。"
                },
                {
                    "id": "741270413",
                    "speaker": "艾尤恩",
                    "text": "今天可真是顺利，我马上就可以回去歇着了。枫丹科学院的作风果然不同于…咳，我、我什么都没说…"
                }
            ]
        },
        {
            "id": "7412705",
            "objective": "前往「驻外资质审核办公室」",
            "dialogues": [
                {
                    "id": "741270501",
                    "speaker": "德斯诺斯",
                    "text": "老天保佑，那些机关可别再来捣乱了…艾尤恩，你怎么来这里了？"
                },
                {
                    "id": "741270502",
                    "speaker": "艾尤恩",
                    "text": "洛耶茨先生让我来这里考察，我就顺便过来看看您，再给您带些咖啡过来。"
                },
                {
                    "id": "741270503",
                    "speaker": "艾尤恩",
                    "text": "但不得不说，您工作的环境确实…颇为艰苦，我还以为这「办事处」至少有一间正经屋子呢。"
                },
                {
                    "id": "741270504",
                    "speaker": "德斯诺斯",
                    "text": "亲爱的艾尤恩，谢谢你的咖啡，至于工作环境…我已经知足了。你看看这周围，我至少找到了一个完整的天花板嘛。"
                },
                {
                    "id": "741270505",
                    "speaker": "Player",
                    "text": "你还在这里负责资质审核的工作吗？"
                },
                {
                    "id": "741270506",
                    "speaker": "德斯诺斯",
                    "text": "#{NICKNAME}！不…应该叫您，荣誉高级研究员，真高兴见到您。"
                },
                {
                    "id": "741270507",
                    "speaker": "德斯诺斯",
                    "text": "艾尤恩，你怎么满脸愁容，发生什么了？"
                },
                {
                    "id": "741270508",
                    "speaker": "艾尤恩",
                    "text": "唉…事情是这样的…"
                },
                {
                    "id": "741270509",
                    "speaker": "Black Screen",
                    "text": "艾尤恩满脸愁容地讲述了之前的事…"
                },
                {
                    "id": "741270510",
                    "speaker": "德斯诺斯",
                    "text": "咦？这信函…是什么重要的秘密文件吗？"
                },
                {
                    "id": "741270511",
                    "speaker": "艾尤恩",
                    "text": "不会呀，这种回函里信件的信息一般也就是说一些「我知道了」、「我没问题」、「我不知道」之类的话…"
                },
                {
                    "id": "741270512",
                    "speaker": "艾尤恩",
                    "text": "最多抄送给其他部门，告诉大家有这么一件事值得在意。"
                },
                {
                    "id": "741270513",
                    "speaker": "德斯诺斯",
                    "text": "喔，那怪不得我也接到了这封信…你看看，是这个吗？"
                },
                {
                    "id": "741270514",
                    "speaker": "艾尤恩",
                    "text": "什、什么？！舒瓦瑟尔先生明明和我说，他还没寄出去！"
                },
                {
                    "id": "741270515",
                    "speaker": "艾尤恩",
                    "text": "…喔，他说的是「对外的信件」还没寄出去。"
                },
                {
                    "id": "741270516",
                    "speaker": "Player",
                    "text": "这家伙又没把话说全。"
                },
                {
                    "id": "741270517",
                    "speaker": "派蒙",
                    "text": "枫丹科学院的人…还是这么擅长让人不开心…"
                },
                {
                    "id": "741270518",
                    "speaker": "德斯诺斯",
                    "text": "看你的脸色，这一定就是你要的那份文件，而且我都看完了好几遍了。"
                },
                {
                    "id": "741270519",
                    "speaker": "Player",
                    "text": "这和你要的那份文件一模一样。"
                },
                {
                    "id": "741270520",
                    "speaker": "德斯诺斯",
                    "text": "#啊哈，{NICKNAME}非常敏锐。艾尤恩，舒瓦瑟尔寄出去的所有信件，肯定全都是一模一样。"
                },
                {
                    "id": "741270521",
                    "speaker": "德斯诺斯",
                    "text": "你为什么不直接把我的这份文件拿回去呢？"
                },
                {
                    "id": "741270522",
                    "speaker": "派蒙",
                    "text": "欸？等一下，要是艾尤恩拿走了文件，你不就没有了吗？"
                },
                {
                    "id": "741270523",
                    "speaker": "德斯诺斯",
                    "text": "哈哈哈哈哈，你瞧瞧我这位置，没人会在意我不小心弄丢了一封可有可无的信函的。",
                    "choices": [
                        {
                            "id": "741270524",
                            "text": "这样不错。",
                            "response": [
                                {
                                    "id": "741270526",
                                    "speaker": "德斯诺斯",
                                    "text": "你瞧，我可不会白喝你的咖啡啊，艾尤恩。"
                                },
                                {
                                    "id": "741270527",
                                    "speaker": "艾尤恩",
                                    "text": "不，先生，我不会这么做，这不符合规定。我会回去等着正式信件送到手里的。"
                                },
                                {
                                    "id": "741270528",
                                    "speaker": "德斯诺斯",
                                    "text": "天哪…艾尤恩！脑筋灵活点，别做傻瓜。你为什么非得折腾自己呢？"
                                },
                                {
                                    "id": "741270529",
                                    "speaker": "德斯诺斯",
                                    "text": "那封信天知道什么时候才能送到你手里。早一天拿到信件，你就可以早一天开工，尽快了结那些麻烦事。"
                                },
                                {
                                    "id": "741270530",
                                    "speaker": "艾尤恩",
                                    "text": "不，先生，谢谢您的好意，但我不会违反规定的。我的职责要求我这么做。"
                                },
                                {
                                    "id": "741270531",
                                    "speaker": "艾尤恩",
                                    "text": "#{NICKNAME}，德斯诺斯先生，还有派蒙。我就先告辞了，洛耶茨先生还在等着我回报呢。"
                                },
                                {
                                    "id": "741270532",
                                    "speaker": "Black Screen",
                                    "text": "艾尤恩迈着沉重的步伐离开了…"
                                },
                                {
                                    "id": "741270533",
                                    "speaker": "德斯诺斯",
                                    "text": "…唉，艾尤恩这傻瓜，满脑子都是死脑筋。"
                                },
                                {
                                    "id": "741270534",
                                    "speaker": "德斯诺斯",
                                    "text": "大家都想着法让自己好过一些，他为什么非得这么折腾自己呢？这又不是什么大事。",
                                    "choices": [
                                        {
                                            "id": "741270535",
                                            "text": "他的品格如此。",
                                            "response": [
                                                {
                                                    "id": "741270537",
                                                    "speaker": "德斯诺斯",
                                                    "text": "真让人敬佩…也让人害怕。也怪不得他在复律庭里没什么朋友，只有洛耶茨和瑟米安两位先生陪着他。"
                                                },
                                                {
                                                    "id": "741270538",
                                                    "speaker": "Player",
                                                    "text": "我也是他的朋友。"
                                                },
                                                {
                                                    "id": "741270539",
                                                    "speaker": "派蒙",
                                                    "text": "我也是我也是！"
                                                },
                                                {
                                                    "id": "741270540",
                                                    "speaker": "德斯诺斯",
                                                    "text": "哈哈哈，那倒不错。您可要常去和他说说话，我总觉得艾尤恩的情绪一天不如一天了…"
                                                },
                                                {
                                                    "id": "741270541",
                                                    "speaker": "德斯诺斯",
                                                    "text": "信件的事我会想办法。我等一下会去找舒瓦瑟尔先生，请他把寄送信件的事交给我。"
                                                },
                                                {
                                                    "id": "741270542",
                                                    "speaker": "德斯诺斯",
                                                    "text": "如果他答应我的话，我会尽快把信件送给艾尤恩。"
                                                },
                                                {
                                                    "id": "741270543",
                                                    "speaker": "德斯诺斯",
                                                    "text": "哎哟，和一个傻瓜做朋友，可真是太费劲喽…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741270536",
                                            "text": "艾尤恩就是这样的人啦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741270525",
                            "text": "那事情不就解决了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7412751",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741275101",
                    "speaker": "舒瓦瑟尔",
                    "text": "雷蒙多还没有回来…这人到底去做什么了…"
                }
            ]
        },
        {
            "id": "7412799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741279901",
                    "speaker": "艾尤恩",
                    "text": "那一堆机关看起来像是失控了，我来的时候就注意到了。"
                },
                {
                    "id": "741279902",
                    "speaker": "艾尤恩",
                    "text": "为了绕开它们，我还专门选了一条远路…"
                },
                {
                    "id": "741279903",
                    "speaker": "艾尤恩",
                    "text": "唉，枫丹科学院就放任它们在这里失控，也不去管管…"
                }
            ]
        }
    ]
}