    "talks": [
        {
            "id": "2402101",
            "objective": "与沙尔梅对话",
            "dialogues": [
                {
                    "id": "240210201",
                    "speaker": "沙尔梅",
                    "text": "那就请您，帮我把进门<color=#00E1FFFF>左边桌子</color>上的那个卷宗箱拿过来吧。"
                },
                {
                    "id": "240210202",
                    "speaker": "沙尔梅",
                    "text": "拜托您了。那个卷宗箱很重，请您一定要小心，别和我一样…把腰伤到了…"
                }
            ]
        },
        {
            "id": "2402102",
            "objective": "帮沙尔梅取来卷宗箱",
            "dialogues": []
        },
        {
            "id": "2402111",
