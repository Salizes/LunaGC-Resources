    "talks": [
        {
            "id": "1504902",
            "objective": "",
            "dialogues": [
                {
                    "id": "150351001",
                    "speaker": "派蒙",
                    "text": "呼…你发现了吗？待在深渊里，确实是一种很奇妙的感觉。"
                },
                {
                    "id": "150351002",
                    "speaker": "派蒙",
                    "text": "这里没有白天和夜晚，时间仿佛变得不重要了。不刻意去数的话，连过去几天都不知道。"
                },
                {
                    "id": "150351003",
                    "speaker": "派蒙",
                    "text": "不过肚子还是会饿…你加油训练呀，我先去吃点东西。"
                },
                {
                    "id": "150351004",
                    "speaker": "Player",
                    "text": "开始吧。"
                },
                {
                    "id": "150351005",
                    "speaker": "丝柯克",
                    "text": "在我看来，追求力量分成三个阶段。"
                },
                {
                    "id": "150351006",
                    "speaker": "丝柯克",
                    "text": "第一步是将常规的武器练好，第二步是学会驾驭自然的能量。之后就能随心所欲，向更高的维度发起挑战。"
                },
                {
                    "id": "150351007",
                    "speaker": "丝柯克",
                    "text": "所谓自然的能量，在提瓦特就是元素力。不过我对元素力的理解并不深刻，它和我属于两种不同的体系。",
                    "choices": [
                        {
                            "id": "150351008",
                            "text": "你的力量是…",
                            "response": [
                                {
                                    "id": "150351010",
                                    "speaker": "丝柯克",
                                    "text": "没错，我习惯用的是深渊力量，也就是所谓的「虚界力」。"
                                },
                                {
                                    "id": "150351011",
                                    "speaker": "丝柯克",
                                    "text": "我的师父苏尔特洛奇是这方面的专家。坎瑞亚人把他列为五大罪人之一，正是因为他们窃取了支撑万象的深渊力量。"
                                },
                                {
                                    "id": "150351012",
                                    "speaker": "丝柯克",
                                    "text": "而提瓦特大陆的元素力本质上都是「光界力」衍生而来。光界力与虚界力是完全对立的两种能量，所以这次训练我能教你的不多。",
                                    "choices": [
                                        {
                                            "id": "150351013",
                                            "text": "为什么你身上的气息与元素力很像？",
                                            "response": [
                                                {
                                                    "id": "150351015",
                                                    "speaker": "丝柯克",
                                                    "text": "不错，很敏锐的观察力。"
                                                },
                                                {
                                                    "id": "150351016",
                                                    "speaker": "丝柯克",
                                                    "text": "我把这叫做「客随主便」。深渊与这个世界的意志相违背，为了避免不必要的麻烦，我将力量拟态成了类似冰元素的存在。"
                                                },
                                                {
                                                    "id": "150351017",
                                                    "speaker": "丝柯克",
                                                    "text": "这也是我从坎瑞亚的遗迹中学到的，名为「蛇之七变」的技艺。如果以后你愿意掌握深渊力量，我可以一并教给你。",
                                                    "choices": [
                                                        {
                                                            "id": "150351018",
                                                            "text": "我和「深渊力量」不合。",
                                                            "response": [
                                                                {
                                                                    "id": "150351020",
                                                                    "speaker": "丝柯克",
                                                                    "text": "略有耳闻，你似乎曾几次清除深渊力量，这也是你的天赋之一。"
                                                                },
                                                                {
                                                                    "id": "150351021",
                                                                    "speaker": "丝柯克",
                                                                    "text": "不过…那真的是净化吗？我说过，力量不会凭空出现和消失。"
                                                                },
                                                                {
                                                                    "id": "150351022",
                                                                    "speaker": "Player",
                                                                    "text": "什么意思？"
                                                                },
                                                                {
                                                                    "id": "150351023",
                                                                    "speaker": "丝柯克",
                                                                    "text": "…想太多也没有意义。先把你掌握的元素力练好，以应对可能出现的各种复杂情况。"
                                                                },
                                                                {
                                                                    "id": "150351024",
                                                                    "speaker": "丝柯克",
                                                                    "text": "所谓成长，就是不断遇到困难，不断从失败中重新站起。"
                                                                },
                                                                {
                                                                    "id": "150351025",
                                                                    "speaker": "丝柯克",
                                                                    "text": "开始吧，去一次又一次挑战自身的极限，这样才能加快成长的步调。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "150351019",
                                                            "text": "我有「净化深渊」的力量…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "150351014",
                                            "text": "我感觉你的力量很接近冰元素。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "150351009",
                            "text": "「不同体系」？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504903",
            "objective": "",
            "dialogues": [
                {
                    "id": "150351901",
                    "speaker": "丝柯克",
                    "text": "经过之前的训练，你的剑术有所提升，对元素力的掌控也更为精妙。",
                    "choices": [
                        {
                            "id": "150351902",
                            "text": "多谢。",
                            "response": [
                                {
                                    "id": "150351904",
                                    "speaker": "丝柯克",
                                    "text": "我的教导只是其中一部分。你更应该感谢的是旅程中遇到的同伴，以及数次身临险境积累的经验。"
                                },
                                {
                                    "id": "150351905",
                                    "speaker": "丝柯克",
                                    "text": "接下来是临场判断，或者说是对「理性」的训练。实战中会出现各种预期之外的情况，譬如现在，你要试着防住我的进攻。"
                                },
                                {
                                    "id": "150351906",
                                    "speaker": "丝柯克",
                                    "text": "准备好了吗？",
                                    "choices": [
                                        {
                                            "id": "150351907",
                                            "text": "准备好了。",
                                            "response": [
                                                {
                                                    "id": "150351909",
                                                    "speaker": "丝柯克",
                                                    "text": "不错，很谨慎的防御架势，看上去滴水不漏。"
                                                },
                                                {
                                                    "id": "150351910",
                                                    "speaker": "丝柯克",
                                                    "text": "#就像你的{M#妹妹}{F#哥哥}一样。说起来，你不想知道{M#她}{F#他}经历过什么吗？"
                                                },
                                                {
                                                    "id": "150351911",
                                                    "speaker": "Player",
                                                    "text": "！！"
                                                },
                                                {
                                                    "id": "150351912",
                                                    "speaker": "Player",
                                                    "text": "啊…"
                                                },
                                                {
                                                    "id": "150351913",
                                                    "speaker": "派蒙",
                                                    "text": "不公平！你这完全属于偷袭嘛！"
                                                },
                                                {
                                                    "id": "150351914",
                                                    "speaker": "丝柯克",
                                                    "text": "站在人类的道德层面，的确可以指责对方使用了卑鄙的手段。但是…只有活下来的人才能出口谴责，死人是不会说话的。"
                                                },
                                                {
                                                    "id": "150351915",
                                                    "speaker": "丝柯克",
                                                    "text": "战斗中难免会产生激动、不安、愤怒等情绪，一个合格的战士必须超出情绪的左右，去做出正确的判断。"
                                                },
                                                {
                                                    "id": "150351916",
                                                    "speaker": "Player",
                                                    "text": "像你一样？"
                                                },
                                                {
                                                    "id": "150351917",
                                                    "speaker": "丝柯克",
                                                    "text": "有趣的说法，听起来像是你在尝试理解我。"
                                                },
                                                {
                                                    "id": "150351918",
                                                    "speaker": "丝柯克",
                                                    "text": "…但你和我不同，你可以走自己的路。"
                                                },
                                                {
                                                    "id": "150351919",
                                                    "speaker": "丝柯克",
                                                    "text": "开始吧，尝试用理性控制感情，时刻做出最冷静、最有利于当前局势的决断。"
                                                },
                                                {
                                                    "id": "150351920",
                                                    "speaker": "丝柯克",
                                                    "text": "这是最后的训练了，打起精神来。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "150351908",
                                            "text": "随时可以开始。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "150351903",
                            "text": "多亏有你指导。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1504904",
            "objective": "",
            "dialogues": [
                {
                    "id": "150352701",
                    "speaker": "Player",
                    "text": "（唔…）"
                },
                {
                    "id": "150352702",
                    "speaker": "Player",
                    "text": "（睁开眼，梦已经结束了。不远处传来火焰静静燃烧的声音，空气中弥漫着一种烤肉的香味。）"
                },
                {
                    "id": "150352703",
                    "speaker": "派蒙",
                    "text": "#啊，{NICKNAME}，你醒啦。"
                },
                {
                    "id": "150352704",
                    "speaker": "派蒙",
                    "text": "怎么样，是不是饿了？噔噔！我们特地准备了烤肉！",
                    "choices": [
                        {
                            "id": "150352705",
                            "text": "确实有点饿。",
                            "response": [
                                {
                                    "id": "150352707",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我就知道。这是我和丝柯克一起做的，快趁热尝尝。",
                                    "choices": [
                                        {
                                            "id": "150352708",
                                            "text": "你们两个…",
                                            "response": [
                                                {
                                                    "id": "150352710",
                                                    "speaker": "派蒙",
                                                    "text": "都过去这么多天了嘛！看在她做饭还算好吃的份上，我就暂时原谅她那种冷淡的态度了。毕竟我也是很大度的嘛。"
                                                },
                                                {
                                                    "id": "150352711",
                                                    "speaker": "丝柯克",
                                                    "text": "闲聊放在饭后，先用餐吧。"
                                                },
                                                {
                                                    "id": "150352712",
                                                    "speaker": "Black Screen",
                                                    "text": "与派蒙一起大快朵颐，风卷残云地消灭了所有的烤肉。"
                                                },
                                                {
                                                    "id": "150352713",
                                                    "speaker": "派蒙",
                                                    "text": "呼，吃得好饱。"
                                                },
                                                {
                                                    "id": "150352714",
                                                    "speaker": "派蒙",
                                                    "text": "这次换我去睡会儿，出发的时候记得叫我呀。"
                                                },
                                                {
                                                    "id": "150352715",
                                                    "speaker": "丝柯克",
                                                    "text": "两个好消息。"
                                                },
                                                {
                                                    "id": "150352716",
                                                    "speaker": "丝柯克",
                                                    "text": "第一是特训结束了。你已具备驾驭力量的资格，接下来就是不断消化旅程中的感悟，在与强者的对战中提升自己。"
                                                },
                                                {
                                                    "id": "150352717",
                                                    "speaker": "丝柯克",
                                                    "text": "第二是我已确定幕后那人的具体方位。调查结束，等我们将你的灵魂碎片取回来后，事情就彻底告一段落。",
                                                    "choices": [
                                                        {
                                                            "id": "150352718",
                                                            "text": "多谢…",
                                                            "response": [
                                                                {
                                                                    "id": "150352720",
                                                                    "speaker": "丝柯克",
                                                                    "text": "阿贾克斯跟我训练的时候，曾说自己「攒了一肚子问题」。于是送他离开之前，我允许他向我提问三次。"
                                                                },
                                                                {
                                                                    "id": "150352721",
                                                                    "speaker": "丝柯克",
                                                                    "text": "考虑到今后我们未必还会再次相见，如果你有什么与我有关的问题，此刻也可以畅所欲言。我同样会回答你三个问题。"
                                                                },
                                                                {
                                                                    "id": "150352722",
                                                                    "speaker": "Player",
                                                                    "text": "（在进入丝柯克的内心世界，触碰到她的回忆碎片后，我确实有很多问题想要问她。其中最重要的就是…）"
                                                                },
                                                                {
                                                                    "id": "150352723",
                                                                    "speaker": "Player",
                                                                    "text": "你…真的是提瓦特人吗？"
                                                                },
                                                                {
                                                                    "id": "150352724",
                                                                    "speaker": "丝柯克",
                                                                    "text": "刚开始就是意料之外的问题啊。为什么你会这么想？"
                                                                },
                                                                {
                                                                    "id": "150352725",
                                                                    "speaker": "Player",
                                                                    "text": "抱歉。魂梦镜像的时候，我似乎也看到了你内心中的记忆。"
                                                                },
                                                                {
                                                                    "id": "150352726",
                                                                    "speaker": "丝柯克",
                                                                    "text": "…？"
                                                                },
                                                                {
                                                                    "id": "150352727",
                                                                    "speaker": "Player",
                                                                    "text": "（丝柯克的表情第一次出现了明显的变化。她似乎对我所说的话感到非常不解。）"
                                                                },
                                                                {
                                                                    "id": "150352728",
                                                                    "speaker": "丝柯克",
                                                                    "text": "我对那个秘法的「副作用」早有预料，所以提前封闭了自己的内心。"
                                                                },
                                                                {
                                                                    "id": "150352729",
                                                                    "speaker": "丝柯克",
                                                                    "text": "哪怕魂梦镜像，你见到的也应该是无垠的黑暗才对。"
                                                                },
                                                                {
                                                                    "id": "150352730",
                                                                    "speaker": "Player",
                                                                    "text": "（看来那些回忆并不是丝柯克主动让我看到的。在决定用这个方案的时候，她就已经做好了「防御措施」。）"
                                                                },
                                                                {
                                                                    "id": "150352731",
                                                                    "speaker": "Player",
                                                                    "text": "（等等…这么说来，第一次进入她的内心世界时，那里的确只有虚无的黑暗。直到那个奇特的小家伙出现…）"
                                                                },
                                                                {
                                                                    "id": "150352732",
                                                                    "speaker": "丝柯克",
                                                                    "text": "算了，或许是我的秘法出现了一些漏洞。最近确实出了一些特殊情况，我对「自己」的掌控有些松动。"
                                                                },
                                                                {
                                                                    "id": "150352733",
                                                                    "speaker": "丝柯克",
                                                                    "text": "既然你已经看到了，我也不会再有所隐瞒。不过，这件事希望你替我保密。"
                                                                },
                                                                {
                                                                    "id": "150352734",
                                                                    "speaker": "丝柯克",
                                                                    "text": "我并非提瓦特人，而是来自另外的一颗星球。你可以理解为，我曾经像你一样，有过一段星际旅行的经历。"
                                                                },
                                                                {
                                                                    "id": "150352735",
                                                                    "speaker": "Player",
                                                                    "text": "这么说…你和我一样，是「降临者」吗？"
                                                                },
                                                                {
                                                                    "id": "150352736",
                                                                    "speaker": "丝柯克",
                                                                    "text": "不，这一点我们不同。这世界的命运因你而变化，而我只是其中的过客。"
                                                                },
                                                                {
                                                                    "id": "150352737",
                                                                    "speaker": "丝柯克",
                                                                    "text": "数百年前，我的师父苏尔特洛奇为我打开了世界的边界，将我送到了这里。"
                                                                },
                                                                {
                                                                    "id": "150352738",
                                                                    "speaker": "丝柯克",
                                                                    "text": "但这里并非我的归宿，终有一日我会回到浩渺的宇宙中去。好了，回答到此结束，你可以提第二个问题了。"
                                                                },
                                                                {
                                                                    "id": "150352739",
                                                                    "speaker": "Player",
                                                                    "text": "你来提瓦特的目的是什么呢？"
                                                                },
                                                                {
                                                                    "id": "150352740",
                                                                    "speaker": "丝柯克",
                                                                    "text": "为了变强。"
                                                                },
                                                                {
                                                                    "id": "150352741",
                                                                    "speaker": "丝柯克",
                                                                    "text": "出于一些原因，我必须尽快追上师父的脚步。在那之前，我需要先理解他的强大从何而来。"
                                                                },
                                                                {
                                                                    "id": "150352742",
                                                                    "speaker": "丝柯克",
                                                                    "text": "为此，我要走他走过的路，从中找到战胜他的方法。这对我来说是唯一真正重要的事情。"
                                                                },
                                                                {
                                                                    "id": "150352743",
                                                                    "speaker": "丝柯克",
                                                                    "text": "…还剩最后一个问题。"
                                                                },
                                                                {
                                                                    "id": "150352744",
                                                                    "speaker": "Player",
                                                                    "text": "（战胜「极恶骑」？从丝柯克的语气来看，这似乎是一件很严肃的事情，想必她有自己的理由。）"
                                                                },
                                                                {
                                                                    "id": "150352745",
                                                                    "speaker": "Player",
                                                                    "text": "（她很快地结束了这个问题，似乎并不想深聊这件事。还剩最后一个问题，问点什么好呢？）"
                                                                },
                                                                {
                                                                    "id": "150352746",
                                                                    "speaker": "「公子」",
                                                                    "text": "说得简单，自从那件事以后，我从没停止对丝柯克师父和那处深渊的寻找。"
                                                                },
                                                                {
                                                                    "id": "150352747",
                                                                    "speaker": "「公子」",
                                                                    "text": "可这么多年过去了，我还是一无所获…"
                                                                },
                                                                {
                                                                    "id": "150352748",
                                                                    "speaker": "Player",
                                                                    "text": "（啊…难得有这个机会，要不帮「公子」问一句好了。）"
                                                                },
                                                                {
                                                                    "id": "150352749",
                                                                    "speaker": "丝柯克",
                                                                    "text": "想好了吗？"
                                                                },
                                                                {
                                                                    "id": "150352750",
                                                                    "speaker": "Player",
                                                                    "text": "你知道「公子」一直在找你吗？为什么不去见见他呢？"
                                                                },
                                                                {
                                                                    "id": "150352751",
                                                                    "speaker": "丝柯克",
                                                                    "text": "阿贾克斯啊…"
                                                                },
                                                                {
                                                                    "id": "150352752",
                                                                    "speaker": "丝柯克",
                                                                    "text": "他和你不太一样。在我们正式见面之前，你已经见过了许多强者，观察过他们的招式，也有了自己的一套心得体会。"
                                                                },
                                                                {
                                                                    "id": "150352753",
                                                                    "speaker": "丝柯克",
                                                                    "text": "所以我对你的指导，就只是简单的添砖加瓦。但阿贾克斯跟我学习的时候太过年轻，就像一张白纸。"
                                                                },
                                                                {
                                                                    "id": "150352754",
                                                                    "speaker": "丝柯克",
                                                                    "text": "小孩子总会下意识地模仿他们憧憬和崇拜的人，长远来看，这却对他的成长没什么好处。"
                                                                },
                                                                {
                                                                    "id": "150352755",
                                                                    "speaker": "丝柯克",
                                                                    "text": "等他实力够格，我自会见他。在那之前，就让他继续把这当做目标，全力以赴地去提升自己的实力吧。"
                                                                },
                                                                {
                                                                    "id": "150352756",
                                                                    "speaker": "Player",
                                                                    "text": "（丝柯克的回答平静而冷漠，就像在叙述一件再平常不过的事情。然而听过之后，内心却产生了一种莫名的违和感。）"
                                                                },
                                                                {
                                                                    "id": "150352757",
                                                                    "speaker": "Player",
                                                                    "text": "（这个回答，其实是站在「为公子考量」的角度说出来的。她自己的感受呢？）"
                                                                },
                                                                {
                                                                    "id": "150352758",
                                                                    "speaker": "Player",
                                                                    "text": "（深渊秘境万籁无声，待久了难免会觉得孤独。她说自己数百年前就到了提瓦特，在深渊秘境里经历的时间只会更长。）"
                                                                },
                                                                {
                                                                    "id": "150352759",
                                                                    "speaker": "丝柯克",
                                                                    "text": "和你们不同，我并没有与世界建立联系的想法。实力弱小的普通人没有记住我的资格，遗忘对他们来说也是另一种幸运。"
                                                                },
                                                                {
                                                                    "id": "150352760",
                                                                    "speaker": "Player",
                                                                    "text": "（如此漫长的时间里，她从未主动和世界建立联系，仅仅是出于「强者的自傲」吗？）"
                                                                },
                                                                {
                                                                    "id": "150352761",
                                                                    "speaker": "Player",
                                                                    "text": "（…就算现在问她，应该也不会得到答案。就像刚刚那三个问题，里面有冰冷的事实，却没有她内心深处的「声音」。）"
                                                                },
                                                                {
                                                                    "id": "150352762",
                                                                    "speaker": "丝柯克",
                                                                    "text": "去把你的同伴叫醒吧，准备出发了。"
                                                                },
                                                                {
                                                                    "id": "150352763",
                                                                    "speaker": "丝柯克",
                                                                    "text": "对了，关于我的事…最好对她也保密。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "150352719",
                                                            "text": "没想到这么快。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "150352709",
                                            "text": "关系变好了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "150352706",
                            "text": "肚子早就咕咕叫了。"
                        }
                    ]
                }
            ]
        }
    ]
}