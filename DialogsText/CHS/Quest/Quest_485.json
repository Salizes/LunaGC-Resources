            "dialogues": []
        },
        {
            "id": "48510",
            "objective": "(test)进入安柏地城$HIDDEN",
            "dialogues": []
        },
        {
            "id": "48502",
            "objective": "向前追击「怪鸟」",
            "dialogues": []
        },
        {
            "id": "48503",
            "objective": "向前追击「怪鸟」",
            "dialogues": [
                {
                    "id": "4850301",
                    "speaker": "安柏",
                    "text": "前面看起来没路走了…那家伙到底会躲在哪呢？"
                },
                {
                    "id": "4850302",
                    "speaker": "派蒙",
                    "text": "安柏，看对面！"
                },
                {
                    "id": "4850303",
                    "speaker": "「怪鸟」",
                    "text": "你果然还是追上来了，没办法…咦？怎么是个小姑娘…"
                },
                {
                    "id": "4850304",
                    "speaker": "安柏",
                    "text": "你就是「怪鸟」吧！现在你已经逃不掉了！"
                },
                {
                    "id": "4850305",
                    "speaker": "「怪鸟」",
                    "text": "哈哈哈，我也不用逃，因为你压根过不来。"
                },
                {
                    "id": "4850306",
                    "speaker": "安柏",
                    "text": "唔——这断崖，确实很高…也很远。"
                },
                {
                    "id": "4850307",
                    "speaker": "「怪鸟」",
                    "text": "小姑娘，不如你现在回去，把团长叫来，说不定我就会马上投降呢。"
                },
                {
                    "id": "4850308",
                    "speaker": "安柏",
                    "text": "你这是在挑衅西风骑士团的侦察骑士吗？看我现在就飞过去抓住你！",
                    "choices": [
                        {
                            "id": "4850309",
                            "text": "先冷静一下。",
                            "response": [
                                {
                                    "id": "4850311",
                                    "speaker": "安柏",
                                    "text": "唔…你说得对。"
                                },
                                {
                                    "id": "4850312",
                                    "speaker": "安柏",
                                    "text": "可恶，明明就在对面了，要是可以直接飞过去就好了…"
                                },
                                {
                                    "id": "4850313",
                                    "speaker": "派蒙",
                                    "text": "但这个怪鸟是怎么过去的？",
                                    "choices": [
                                        {
                                            "id": "4850314",
                                            "text": "难道有可以来回的机关？",
                                            "response": [
                                                {
                                                    "id": "4850315",
                                                    "speaker": "安柏",
                                                    "text": "以我的眼力，也看不出这种机关的痕迹。"
                                                },
                                                {
                                                    "id": "4850316",
                                                    "speaker": "安柏",
                                                    "text": "而且周围也没有能建机关的岩壁。"
                                                },
                                                {
                                                    "id": "4850322",
                                                    "speaker": "「怪鸟」",
                                                    "text": "再见了，小姑娘——"
                                                },
                                                {
                                                    "id": "4850323",
                                                    "speaker": "派蒙",
                                                    "text": "呀，这家伙要逃了！"
                                                },
                                                {
                                                    "id": "4850324",
                                                    "speaker": "安柏",
                                                    "text": "不能再犹豫下去了，除了「飞行」以外，没有第二种越过断崖的方法。"
                                                },
                                                {
                                                    "id": "4850325",
                                                    "speaker": "派蒙",
                                                    "text": "但是…"
                                                },
                                                {
                                                    "id": "4850326",
                                                    "speaker": "安柏",
                                                    "text": "别担心，我可是蒙德城的飞行冠军，如果怪鸟可以飞过去，我也肯定可以做到！"
                                                },
                                                {
                                                    "id": "4850327",
                                                    "speaker": "「怪鸟」",
                                                    "text": "喂，侦察骑士，想要送死的话，不带风之翼从蒙德城的风神像上跳下去才更适合你。",
                                                    "choices": [
                                                        {
                                                            "id": "4850328",
                                                            "text": "我明白安柏的意思了。",
                                                            "response": [
                                                                {
                                                                    "id": "4850330",
                                                                    "speaker": "派蒙",
                                                                    "text": "#说得没错…除了「飞行」以外的答案，{NICKNAME}也认为都已经排除了呢。"
                                                                },
                                                                {
                                                                    "id": "4850331",
                                                                    "speaker": "安柏",
                                                                    "text": "#{NICKNAME}，还记得我拿错的那本…不是指南的指南吗？"
                                                                },
                                                                {
                                                                    "id": "4850332",
                                                                    "speaker": "安柏",
                                                                    "text": "「最初的鸟儿是不会飞翔的，飞翔是它们勇敢跃入峡谷的奖励」。"
                                                                },
                                                                {
                                                                    "id": "4850333",
                                                                    "speaker": "安柏",
                                                                    "text": "接下来，请你见证我吧。"
                                                                },
                                                                {
                                                                    "id": "4850334",
                                                                    "speaker": "Player",
                                                                    "text": "加油！侦察骑士！"
                                                                },
                                                                {
                                                                    "id": "4850335",
                                                                    "speaker": "安柏",
                                                                    "text": "收到！就让那家伙见识一下侦察骑士的勇气吧！"
                                                                },
                                                                {
                                                                    "id": "4850336",
                                                                    "speaker": "「怪鸟」",
                                                                    "text": "别，别开玩笑了，这里是飞不过来的！快点乖乖回去吧，小姑娘！"
                                                                },
                                                                {
                                                                    "id": "4850337",
                                                                    "speaker": "安柏",
                                                                    "text": "怪鸟，你是这么觉得的吗？可是你仔细听听，周围微小的声音…"
                                                                },
                                                                {
                                                                    "id": "4850338",
                                                                    "speaker": "安柏",
                                                                    "text": "风说——可以飞了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "4850329",
                                                            "text": "虽然需要勇气，但这不是自杀。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4850317",
                                            "text": "活用了某种元素魔法？",
                                            "response": [
                                                {
                                                    "id": "4850318",
                                                    "speaker": "派蒙",
                                                    "text": "#在{NICKNAME}的元素视野里有痕迹吗？…唔，果然也没有？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4850319",
                                            "text": "用了抓钩或者刺钉之类的？",
                                            "response": [
                                                {
                                                    "id": "4850320",
                                                    "speaker": "派蒙",
                                                    "text": "连飞都飞不过去，这种东西也不可能丢过去吧。"
                                                },
                                                {
                                                    "id": "4850321",
                                                    "speaker": "安柏",
                                                    "text": "地面上也没有钉桩的痕迹。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4850310",
                            "text": "观察一下周围…这是你教我的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "48504",
            "objective": "飞过断崖",
            "dialogues": [
                {
                    "id": "4850401",
                    "speaker": "派蒙",
                    "text": "安柏！要掉下去了掉下去了掉下去…"
                }
            ]
        },
        {
            "id": "48505",
            "objective": "向前追踪，逮捕「怪鸟」！",
            "dialogues": []
        },
        {
            "id": "48506",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "4850601",
                    "speaker": "安柏",
                    "text": "成功抓住怪鸟了！"
                },
                {
                    "id": "4850602",
                    "speaker": "安柏",
                    "text": "其实，只有在空中才能发现，那就是唯一的风场。"
                },
                {
                    "id": "4850603",
                    "speaker": "安柏",
                    "text": "怪鸟所要逃跑的方向，尽头根本是彻彻底底的死路。"
                },
                {
                    "id": "4850604",
                    "speaker": "安柏",
                    "text": "换句话说，如果怪鸟想要逃出去，就必须从我们这边经过才行。"
                },
                {
                    "id": "4850605",
                    "speaker": "派蒙",
                    "text": "喔——所以他才一直这么装模作样，原来是想骗我们放弃，然后自己再飞回来逃走。"
                },
                {
                    "id": "4850606",
                    "speaker": "派蒙",
                    "text": "不过，我们这边也不是那么好骗的。"
                },
                {
                    "id": "4850607",
                    "speaker": "安柏",
                    "text": "#幸亏有{NICKNAME}的分析，这就是所谓的「排除了所有错误答案以后，剩下的那个，无论多反常都是正确的」吧。"
                },
                {
                    "id": "4850608",
                    "speaker": "安柏",
                    "text": "总之，想要掌握飞行这种事情，七分靠技术，三分靠直觉，剩下的九十分全都是靠勇气来补足啦。"
                },
                {
                    "id": "4850609",
                    "speaker": "派蒙",
                    "text": "我看你刚才是九十九分都是勇气了吧…"
                },
                {
                    "id": "4850610",
                    "speaker": "安柏",
                    "text": "哎呀，这就和我第一次考飞行执照的时候一样吧…虽然很紧张，但还是有惊无险地把执照考到手了。"
                },
                {
                    "id": "4850611",
                    "speaker": "安柏",
                    "text": "可惜之后的几次考试我都再没有这种紧张感了，总觉得少了点什么呢。"
                },
                {
                    "id": "4850612",
                    "speaker": "派蒙",
                    "text": "你…等一下，飞行执照都考到手了，之后的考试是考什么？"
                },
                {
                    "id": "4850613",
                    "speaker": "安柏",
                    "text": "这个啊…因为蒙德城里这里不准飞那里也不准飞，这里不准降落那里也不准降落…"
                },
                {
                    "id": "4850614",
                    "speaker": "安柏",
                    "text": "我考到手的飞行执照总是被吊销，零零碎碎重新考过十五次飞行执照吧。"
                },
                {
                    "id": "4850615",
                    "speaker": "安柏",
                    "text": "但是每次补考我可都是一次考过，果然我的那本指南才是最棒的。"
                },
                {
                    "id": "4850616",
                    "speaker": "派蒙",
                    "text": "#…{NICKNAME}，之后有空的话，我们去琴团长那里拿一份正经的飞行指南吧。",
                    "choices": [
                        {
                            "id": "4850617",
                            "text": "好的…",
                            "response": [
                                {
                                    "id": "4850619",
                                    "speaker": "安柏",
                                    "text": "总之，我还要把怪鸟押回蒙德城，就先走一步了。"
                                },
                                {
                                    "id": "4850620",
                                    "speaker": "安柏",
                                    "text": "你回蒙德城之后，记得来大教堂找我，飞行执照还要在那颁发给你呢。"
                                }
                            ]
                        },
                        {
                            "id": "4850618",
                            "text": "琴团长真是辛苦了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "48507",
            "objective": "前往大教堂，领取飞行执照",
            "dialogues": []
        },
        {
            "id": "48508",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "4850801",
                    "speaker": "安柏",
                    "text": "恭喜！这就是你的飞行执照，这下你可以在蒙德城里合法飞行了。"
                },
                {
                    "id": "4850802",
                    "speaker": "安柏",
                    "text": "不过你的飞行技术已经这么好了，顺利通过也是意料之内。",
                    "choices": [
                        {
                            "id": "4850803",
                            "text": "嗯，很顺利。",
                            "response": [
                                {
                                    "id": "4850805",
                                    "speaker": "安柏",
                                    "text": "对了，下次蒙德城飞行大赛，我会帮你报名的！"
                                },
                                {
                                    "id": "4850806",
                                    "speaker": "安柏",
                                    "text": "我飞得太快了，谁也跟不上，所以总是一个人飞来飞去，也很无聊啦。",
                                    "choices": [
                                        {
                                            "id": "4850807",
                                            "text": "好啊。我会赢下比赛的。",
                                            "response": [
                                                {
                                                    "id": "4850809",
                                                    "speaker": "安柏",
                                                    "text": "哦？真是大胆的宣言啊。哼哼哼…看来你还不知道飞行大赛的恐怖之处…"
                                                },
                                                {
                                                    "id": "4850810",
                                                    "speaker": "安柏",
                                                    "text": "那么，在被我华丽击败以前，要合法地、自由地、快乐地飞行哦。"
                                                },
                                                {
                                                    "id": "4850811",
                                                    "speaker": "安柏",
                                                    "text": "一定要遵守蒙德城的飞行守则，千万不要被吊销执照…"
                                                },
                                                {
                                                    "id": "4850812",
                                                    "speaker": "派蒙",
                                                    "text": "这句话由安柏说出来，真是一点说服力都没有啊…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "4850808",
                                            "text": "安柏要拿不到下届冠军咯。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "4850804",
                            "text": "其实挺不容易的。"
                        }
                    ]
                }
            ]
        }
    ]
}