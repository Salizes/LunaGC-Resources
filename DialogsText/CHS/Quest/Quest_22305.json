    "talks": [
        {
            "id": "2230501",
            "objective": "与石头对话",
            "dialogues": [
                {
                    "id": "223050101",
                    "speaker": "石头",
                    "text": "客官，哎，客官！您要不要来块石头，试试手气？",
                    "choices": [
                        {
                            "id": "223050102",
                            "text": "来一块试试。",
                            "response": [
                                {
                                    "id": "223050103",
                                    "speaker": "石头",
                                    "text": "好嘞！客官，我看您今天气色不错，看上去就要赚钱哪，哈哈哈。"
                                },
                                {
                                    "id": "223050116",
                                    "speaker": "石头",
                                    "text": "客官，您这边上眼！"
                                }
                            ]
                        },
                        {
                            "id": "223050104",
                            "text": "什么石头？",
                            "response": [
                                {
                                    "id": "223050105",
                                    "speaker": "石头",
                                    "text": "当然是我店里这些上好的璞石。"
                                },
                                {
                                    "id": "223050106",
                                    "speaker": "石头",
                                    "text": "只要开石后能出玉，我就付给您摩拉，当然，如果什么也没有，那自然也没有摩拉了。"
                                },
                                {
                                    "id": "223050107",
                                    "speaker": "石头",
                                    "text": "客官，您自己来一块石头玩玩，就什么都明白了！"
                                }
                            ]
                        },
                        {
                            "id": "223050108",
                            "text": "这些石头从哪来？",
                            "response": [
                                {
                                    "id": "223050109",
                                    "speaker": "石头",
                                    "text": "我们店里这些璞石，个个那都是从「层岩巨渊」里凿出来的顶尖货…"
                                },
                                {
                                    "id": "223050110",
                                    "speaker": "石头",
                                    "text": "嘿嘿，您别不信，我们「解翠行」做了好几辈的玉器生意。看石头的眼光，那是独一无二！"
                                },
                                {
                                    "id": "223050111",
                                    "speaker": "石头",
                                    "text": "嗨，不过这些风光都是原来，现在…总务司不是把「层岩巨渊」给封了吗？"
                                },
                                {
                                    "id": "223050112",
                                    "speaker": "石头",
                                    "text": "这原料地一封，卖一块石头少一块，这么一来二去，这些石头反而比做好的玉器更值钱了…"
                                },
                                {
                                    "id": "223050113",
                                    "speaker": "石头",
                                    "text": "我一想，那不如直接把店里的璞石拿来卖算了，不仅省了道工序，开石的时候，还有股刺激感，嘿嘿…"
                                },
                                {
                                    "id": "223050114",
                                    "speaker": "石头",
                                    "text": "客官，您来一块石头玩玩，自己体验体验吧。"
                                },
                                {
                                    "id": "223050115",
                                    "speaker": "Player",
                                    "text": "来一块试试。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2230502",
            "objective": "和石头玩一把",
            "dialogues": [
                {
                    "id": "223050201",
                    "speaker": "石头",
                    "text": "我们「解翠行」璞石众多，要是挨个挑，客官您的眼睛都得挑花了。"
                },
                {
                    "id": "223050202",
                    "speaker": "石头",
                    "text": "我先粗略地看了一遍璞石，把璞石分好了，客官您看，来块什么价钱的璞石玩玩？"
                }
            ]
        },
        {
            "id": "2230503",
            "objective": "",
            "dialogues": [
                {
                    "id": "223050301",
                    "speaker": "Player",
                    "text": "200摩拉。"
                },
                {
                    "id": "223050302",
                    "speaker": "石头",
                    "text": "您这还挺谨慎的哈…也行，您看那边，选一块吧。"
                },
                {
                    "id": "223050303",
                    "speaker": "石头",
                    "text": "您可看仔细了，200摩拉呢，好歹也是钱…"
                },
                {
                    "id": "223050304",
                    "speaker": "石头",
                    "text": "看上哪一块您和我说，我来把璞石给开了。"
                }
            ]
        },
        {
            "id": "2230504",
            "objective": "",
            "dialogues": [
                {
                    "id": "223050401",
                    "speaker": "Player",
                    "text": "400摩拉。"
                },
                {
                    "id": "223050402",
                    "speaker": "石头",
                    "text": "看您就知道，您心里有数，这钱不多不少玩玩正好。"
                },
                {
                    "id": "223050403",
                    "speaker": "石头",
                    "text": "您来这边。这几块璞石，您自己挑一块。"
                },
                {
                    "id": "223050404",
                    "speaker": "石头",
                    "text": "不用着急，挑好了您和我说，我来帮您开石。"
                }
            ]
        },
        {
            "id": "2230505",
            "objective": "",
            "dialogues": [
                {
                    "id": "223050501",
                    "speaker": "Player",
                    "text": "600摩拉。"
                },
                {
                    "id": "223050502",
                    "speaker": "石头",
                    "text": "好！大气，瞧您这风姿仪态，那是要赚大钱！"
                },
                {
                    "id": "223050503",
                    "speaker": "石头",
                    "text": "您这边请，这几块璞石您上眼！"
                },
                {
                    "id": "223050504",
                    "speaker": "石头",
                    "text": "您慢慢看，这可都是上好的璞石，绝不会亏了您的。"
                },
                {
                    "id": "223050505",
                    "speaker": "石头",
                    "text": "挑好了您和我说，我来开石，不劳您动手。"
                }
            ]
        },
        {
            "id": "2230506",
            "objective": "选择璞石种类",
            "dialogues": [
                {
                    "id": "223050601",
                    "speaker": "石头",
                    "text": "对了，这判断璞石价值几何啊，每个人都各有手段。"
                },
                {
                    "id": "223050602",
                    "speaker": "石头",
                    "text": "有的人讲究「一眼之缘」，就是看到哪块，就是哪块。有的人就要细细观看，每一个细节都不放过。"
                },
                {
                    "id": "223050603",
                    "speaker": "石头",
                    "text": "我也不知道您挑璞石有什么独门手段。不过璞石就放在这，是<color=#00E1FFFF>细细观察</color>，还是<color=#00E1FFFF>任凭缘分</color>，都随您的喜好。"
                }
            ]
        },
        {
            "id": "2230507",
            "objective": "",
            "dialogues": [
                {
                    "id": "223050701",
                    "speaker": "Player",
                    "text": "黄色布上的那块…"
                },
                {
                    "id": "223050702",
                    "speaker": "石头",
                    "text": "好嘞，我来给您开石。"
                }
            ]
        },
        {
            "id": "2230508",
            "objective": "",
            "dialogues": [
                {
                    "id": "223050801",
                    "speaker": "Player",
                    "text": "蓝色布上的那块…"
                },
                {
                    "id": "223050802",
                    "speaker": "石头",
                    "text": "好嘞，我来给您开石。"
                }
            ]
        },
        {
            "id": "2230509",
            "objective": "",
            "dialogues": [
                {
                    "id": "223050901",
                    "speaker": "Player",
                    "text": "红白布上的那块…"
                },
                {
                    "id": "223050902",
                    "speaker": "石头",
                    "text": "好嘞，我来给您开石。"
                }
            ]
        },
        {
            "id": "2230510",
            "objective": "",
            "dialogues": [
                {
                    "id": "223051001",
                    "speaker": "石头",
                    "text": "您这石头，这里头没多少玉…"
                },
                {
                    "id": "223051002",
                    "speaker": "石头",
                    "text": "嗨，没事，就是玩玩嘛，权当花钱买个开心。"
                },
                {
                    "id": "223051003",
                    "speaker": "Player",
                    "text": "你说你们没有坏的…"
                },
                {
                    "id": "223051004",
                    "speaker": "石头",
                    "text": "那是没有坏的啊，那璞石就是璞石，哪里有坏石一说？"
                },
                {
                    "id": "223051005",
                    "speaker": "石头",
                    "text": "您啊，也别上心，这璞石，就是我有时候也会看走眼…"
                },
                {
                    "id": "223051006",
                    "speaker": "石头",
                    "text": "我先帮您收着，您如果想接着看，我们就接着来，到此为止，我们就马上结账。"
                },
                {
                    "id": "223051007",
                    "speaker": "石头",
                    "text": "<color=#00E1FFFF>最后，我再一起算给您钱</color>，免得我一份份地给您，我算糊涂，您也算糊涂。"
                },
                {
                    "id": "223051008",
                    "speaker": "石头",
                    "text": "怎么样客官，您再玩几块？"
                }
            ]
        },
        {
            "id": "2230511",
            "objective": "",
            "dialogues": [
                {
                    "id": "223051101",
                    "speaker": "Player",
                    "text": "再来一次！"
                },
                {
                    "id": "223051102",
                    "speaker": "石头",
                    "text": "好！您这性情看着就是来赚钱的。"
                },
                {
                    "id": "223051103",
                    "speaker": "石头",
                    "text": "「今天不来明天来，总有一天好运来！」，您这边请！"
                }
            ]
        },
        {
            "id": "2230512",
            "objective": "",
            "dialogues": [
                {
                    "id": "223051201",
                    "speaker": "Player",
                    "text": "还是不玩了…"
                },
                {
                    "id": "223051202",
                    "speaker": "石头",
                    "text": "也是，老是在这玩石头也不像话，那您自便吧。"
                }
            ]
        },
        {
            "id": "2230513",
            "objective": "与石头对话",
            "dialogues": []
        },
        {
            "id": "2230516",
            "objective": "",
            "dialogues": [
                {
                    "id": "223051301",
                    "speaker": "Player",
                    "text": "再来一次！"
                },
                {
                    "id": "223051302",
                    "speaker": "石头",
                    "text": "客官，您稍微停一停…这玩啊，也要适度地玩，我今天备的璞石啊，就这么多…"
                },
                {
                    "id": "223051303",
                    "speaker": "石头",
                    "text": "今天您就先歇了吧，之后要是再想来玩，我一定欢迎。"
                }
            ]
        },
        {
            "id": "2230517",
            "objective": "",
            "dialogues": [
                {
                    "id": "223051401",
                    "speaker": "石头",
                    "text": "这，这…还真出宝玉…"
                },
                {
                    "id": "223051402",
                    "speaker": "石头",
                    "text": "您…好眼力，啊哈哈，好眼力！"
                },
                {
                    "id": "223051403",
                    "speaker": "石头",
                    "text": "您这，这是从哪看出来的…您给我说道说道？"
                },
                {
                    "id": "223051404",
                    "speaker": "Player",
                    "text": "给钱。"
                },
                {
                    "id": "223051405",
                    "speaker": "石头",
                    "text": "啊？啊对，是是是，您拿好，您拿好。"
                },
                {
                    "id": "223051406",
                    "speaker": "石头",
                    "text": "客官下次再来哈，下次再来…"
                },
                {
                    "id": "223051407",
                    "speaker": "石头",
                    "text": "哎哟！哎哟！我的岩王爷哟！我怎么就看走眼了…"
                }
            ]
        },
        {
            "id": "2230518",
            "objective": "",
            "dialogues": [
                {
                    "id": "223051801",
                    "speaker": "石头",
                    "text": "您这，<color=#00E1FFFF>钱不太够</color>…这可玩不了啊。"
                },
                {
                    "id": "223051802",
                    "speaker": "石头",
                    "text": "这些璞石，个个可都是我们店里的宝贝。"
                },
                {
                    "id": "223051803",
                    "speaker": "石头",
                    "text": "就算您只是想随便玩玩，那好歹也要个…<color=#00E1FFFF>200</color>摩拉吧"
                }
            ]
        },
        {
            "id": "2230515",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "223051501",
                    "speaker": "Player",
                    "text": "你都已经看好了？"
                },
                {
                    "id": "223051502",
                    "speaker": "石头",
                    "text": "那哪能呢，我这不是方便客官您掌眼吗？"
                },
                {
                    "id": "223051503",
                    "speaker": "石头",
                    "text": "这璞石，人再拿眼睛看，再拿家伙事比划，终究是隔着一层石皮。"
                },
                {
                    "id": "223051504",
                    "speaker": "石头",
                    "text": "里面是什么样，我也只能说个大概，这里面到底有没有宝贝，值多少钱…"
                },
                {
                    "id": "223051505",
                    "speaker": "石头",
                    "text": "说实话，我是真不知道。不过漫说是我，在开石之前，那谁都不知道，说到底，这就是个运气。"
                },
                {
                    "id": "223051506",
                    "speaker": "石头",
                    "text": "运气坏，就是露了玉的璞石，刨开也是实心的烂货。运气好，走路上捡块石头敲开，那里面都是上好的夜泊石。"
                },
                {
                    "id": "223051507",
                    "speaker": "石头",
                    "text": "不过客官，按我的眼力看…我看您今天啊，运气那是顶顶不错的，哈哈哈。"
                }
            ]
        },
        {
            "id": "2230516",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "223051601",
                    "speaker": "Player",
                    "text": "我<color=#00E1FFFF>仔细看看</color>…"
                },
                {
                    "id": "223051602",
                    "speaker": "石头",
                    "text": "那您慢慢挑，不着急。"
                }
            ]
        },
        {
            "id": "2230517",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "223051701",
                    "speaker": "石头",
                    "text": "嚯，这石头虽然不算出彩，但也算不错了。"
                },
                {
                    "id": "223051702",
                    "speaker": "石头",
                    "text": "要是处理得当，也能卖出个能看的价钱。"
                },
                {
                    "id": "223051703",
                    "speaker": "Player",
                    "text": "那到底是好是坏…"
                },
                {
                    "id": "223051704",
                    "speaker": "石头",
                    "text": "嘿嘿，您要是这么问…"
                },
                {
                    "id": "223051705",
                    "speaker": "石头",
                    "text": "这块石头啊，不好不坏。"
                },
                {
                    "id": "223051706",
                    "speaker": "石头",
                    "text": "我先帮您收着，您如果想接着看，我们就接着来，到此为止，我们就马上结账。"
                },
                {
                    "id": "223051707",
                    "speaker": "石头",
                    "text": "<color=#00E1FFFF>最后，我再一起算给您钱</color>，免得我一份份地给您，我算糊涂，您也算糊涂。"
                }
            ]
        }
    ]
}