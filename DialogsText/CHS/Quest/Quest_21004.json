    "talks": [
        {
            "id": "2100401",
            "objective": "与索拉雅对话",
            "dialogues": [
                {
                    "id": "210040101",
                    "speaker": "索拉雅",
                    "text": "「归终四诫」…到底是在暗示什么呢…",
                    "choices": [
                        {
                            "id": "210040102",
                            "text": "我准备好了。",
                            "response": [
                                {
                                    "id": "210040103",
                                    "speaker": "索拉雅",
                                    "text": "哈哈哈，你可真有干劲，那好吧，我们开始解读一下这个「归终四诫」。"
                                },
                                {
                                    "id": "210040106",
                                    "speaker": "索拉雅",
                                    "text": "「教之以智、律之以德、坚其筋骨，众志一心，四者汇之而成『归离集』。」"
                                },
                                {
                                    "id": "210040107",
                                    "speaker": "索拉雅",
                                    "text": "从字面上来看，确实是类似于一种对于日常生活的「劝诫」。"
                                },
                                {
                                    "id": "210040108",
                                    "speaker": "索拉雅",
                                    "text": "不过，这句话哪里是在暗示着宝藏的线索呢…"
                                },
                                {
                                    "id": "210040109",
                                    "speaker": "索拉雅",
                                    "text": "…没办法了，还是用我们学者最笨，也是最自讨苦吃的方法吧。"
                                },
                                {
                                    "id": "210040110",
                                    "speaker": "索拉雅",
                                    "text": "先前，我们发现那七段话的地方，都是在各种形式的「遗迹」里。"
                                },
                                {
                                    "id": "210040111",
                                    "speaker": "索拉雅",
                                    "text": "既然现在我们不知道如何入手，那么，就继续去搜索「遗迹」看看吧。",
                                    "choices": [
                                        {
                                            "id": "210040112",
                                            "text": "到哪里找…",
                                            "response": [
                                                {
                                                    "id": "210040113",
                                                    "speaker": "索拉雅",
                                                    "text": "嗯…搜索区域的话，就暂时划定在「归离原」里吧。"
                                                },
                                                {
                                                    "id": "210040114",
                                                    "speaker": "索拉雅",
                                                    "text": "但是你看我这样的学者，一定跟不上你的步伐。"
                                                },
                                                {
                                                    "id": "210040115",
                                                    "speaker": "索拉雅",
                                                    "text": "所以，搜索遗迹的事就拜托你了，如果找到线索的话，就回来告诉我吧。"
                                                },
                                                {
                                                    "id": "210040129",
                                                    "speaker": "索拉雅",
                                                    "text": "这么说起来，我曾经在这附近发现过一处遗迹，而且，我还在里面发现了一个奇怪的圆盘，上面还有字迹…"
                                                },
                                                {
                                                    "id": "210040130",
                                                    "speaker": "索拉雅",
                                                    "text": "不过，当时我也只是做了一些孤立的研究，没有再做发散…"
                                                },
                                                {
                                                    "id": "210040131",
                                                    "speaker": "索拉雅",
                                                    "text": "现在回想起来，说不定那片遗迹里的那个圆盘，会和这「归终四诫」有所关系。"
                                                },
                                                {
                                                    "id": "210040132",
                                                    "speaker": "索拉雅",
                                                    "text": "唔…这样，我给你在地图上标记出来，你可以去看一下，说不定真能发现什么线索。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210040116",
                                            "text": "全，全部要找一遍吗…",
                                            "response": [
                                                {
                                                    "id": "210040117",
                                                    "speaker": "索拉雅",
                                                    "text": "当然不是，如果把搜索范围扩大到整片璃月的话，就凭我们两个人绝对搜索不完。"
                                                },
                                                {
                                                    "id": "210040118",
                                                    "speaker": "索拉雅",
                                                    "text": "既然是「归离原」上「归离集」的宝藏，那么我们就缩小搜索范围。"
                                                },
                                                {
                                                    "id": "210040119",
                                                    "speaker": "索拉雅",
                                                    "text": "搜索区域就暂定在这片「归离原」之内吧。"
                                                },
                                                {
                                                    "id": "210040120",
                                                    "speaker": "索拉雅",
                                                    "text": "啊，对了，你看我这样的学者，一定跟不上你的步伐。"
                                                },
                                                {
                                                    "id": "210040121",
                                                    "speaker": "索拉雅",
                                                    "text": "所以，搜索遗迹的事就拜托你了，如果找到线索的话，就回来告诉我吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "210040122",
                                            "text": "我这就去把璃月里的遗迹全部找一遍！",
                                            "response": [
                                                {
                                                    "id": "210040123",
                                                    "speaker": "索拉雅",
                                                    "text": "等一下！你别这么激动，璃月这么大，你想要找到什么时候去啊？！"
                                                },
                                                {
                                                    "id": "210040124",
                                                    "speaker": "索拉雅",
                                                    "text": "听见宝藏就激动成这样…我到底该说你什么好…"
                                                },
                                                {
                                                    "id": "210040125",
                                                    "speaker": "索拉雅",
                                                    "text": "既然宝藏来自于「归离原」上的「归离集」，那我们首先缩小一下搜索范围。"
                                                },
                                                {
                                                    "id": "210040126",
                                                    "speaker": "索拉雅",
                                                    "text": "我想想…搜索范围就暂定在这片「归离原」之内…"
                                                },
                                                {
                                                    "id": "210040127",
                                                    "speaker": "索拉雅",
                                                    "text": "喂，听我说完再走！记住了，一定要仔细搜索遗迹，如果有什么发现，就带回来告诉我。"
                                                },
                                                {
                                                    "id": "210040128",
                                                    "speaker": "索拉雅",
                                                    "text": "记住了，在「归离原」之内搜索就好，别跑太远了！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "210040104",
                            "text": "去找宝藏吧！",
                            "response": [
                                {
                                    "id": "210040105",
                                    "speaker": "索拉雅",
                                    "text": "一说到宝藏，感觉你就精神焕发…算了，我们开始解读这个「归终四诫」吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2100402",
            "objective": "询问索拉雅关于附近的传说2$HIDDEN",
            "dialogues": [
                {
                    "id": "210040201",
                    "speaker": "Player",
                    "text": "我有兴趣。"
                },
                {
                    "id": "210040202",
                    "speaker": "索拉雅",
                    "text": "我把已经发现的那片遗迹标在你的地图上了，你先去那里看看吧。"
                },
