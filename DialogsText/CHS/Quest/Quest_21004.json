            "dialogues": []
        },
        {
            "id": "2100412",
            "objective": "前往遗迹，寻找奇怪的圆盘",
            "dialogues": []
        },
        {
            "id": "2100413",
            "objective": "前往遗迹，寻找奇怪的圆盘",
            "dialogues": []
        },
        {
            "id": "2100414",
