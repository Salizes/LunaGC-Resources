            "dialogues": []
        },
        {
            "id": "2100420",
            "objective": "询问索拉雅",
            "dialogues": [
                {
                    "id": "210042001",
                    "speaker": "索拉雅",
                    "text": "即使是魔神，也有着逃不脱的命运…"
                },
                {
                    "id": "210042002",
                    "speaker": "Player",
                    "text": "在四个遗迹里找到了四条线索。"
                },
                {
                    "id": "210042003",
                    "speaker": "索拉雅",
                    "text": "四个遗迹，四条线索…刚好和「归终四诫」的诫语数量一样。"
                },
                {
                    "id": "210042004",
                    "speaker": "索拉雅",
                    "text": "不过，这四句话都是关于「归终四诫」中某一条的解释。"
                },
                {
                    "id": "210042005",
                    "speaker": "索拉雅",
                    "text": "想要正确解读，「归终四诫」的原文应该才是关键，这四条都是辅助。"
                },
                {
                    "id": "210042006",
                    "speaker": "索拉雅",
                    "text": "要把这五段话都结合起来，但是到底该怎么理解呢？"
                },
                {
                    "id": "210042007",
                    "speaker": "Player",
                    "text": "「汇之而成」…"
                },
                {
                    "id": "210042008",
                    "speaker": "索拉雅",
                    "text": "汇之而成…听起来像是在说，这四段话可以用某种方式结合起来…"
                },
                {
                    "id": "210042009",
                    "speaker": "索拉雅",
                    "text": "等等，我记得，这四段「诫语」都各自存在于某一处遗迹之中…"
                },
                {
                    "id": "210042010",
                    "speaker": "索拉雅",
                    "text": "唔…我有一个不成熟的猜测。如果想要解读这四段「诫语」，也许还需要借助一下这些「诫语」各自所在的<color=#00E1FFFF>「遗迹」</color>…"
                },
                {
                    "id": "210042011",
                    "speaker": "索拉雅",
                    "text": "不过，具体的解读方式，我还要再思考一下…你也可以想想，如果有什么好想法，直接去付诸实施也可以。"
                },
                {
                    "id": "210042012",
                    "speaker": "索拉雅",
                    "text": "毕竟你不像我这个「弱不禁风」的学者，跑几步就没劲了…唉，真羡慕你，有这么好的体力…"
                },
                {
                    "id": "210042013",
                    "speaker": "索拉雅",
                    "text": "好了，我再在这里仔细思考一下，如果你有什么想法，或者发现的话，就来告诉我吧。"
                }
            ]
        },
        {
            "id": "2100421",
            "objective": "找到最后的遗迹$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2100422",
            "objective": "找到最后的遗迹",
            "dialogues": [
                {
                    "id": "210042201",
                    "speaker": "索拉雅",
                    "text": "根据我那个不成熟的猜测，想要解读这四段「诫语」，也许还需要借助每段「诫语」各自所在的「遗迹」。"
                },
                {
                    "id": "210042202",
                    "speaker": "索拉雅",
                    "text": "至于具体如何「借助」，我还没有想好。而且…唉，我也没那么多力气，把我的每一个猜测都试一遍…"
                },
                {
                    "id": "210042203",
                    "speaker": "索拉雅",
                    "text": "但是这么一直想下去，感觉也不会有什么突破啊…"
                }
            ]
        },
        {
            "id": "2100430",
            "objective": "开启遗迹机关",
            "dialogues": [
                {
                    "id": "210043001",
                    "speaker": "索拉雅",
                    "text": "你们找到宝藏了吗？"
                }
            ]
        },
        {
            "id": "2100431",
            "objective": "击败遗迹守卫",
            "dialogues": []
        },
        {
            "id": "2100432",
            "objective": "开启机关",
            "dialogues": []
        },
        {
            "id": "2100440",
            "objective": "取得宝藏",
            "dialogues": [
                {
                    "id": "210044001",
                    "speaker": "索拉雅",
                    "text": "你们找到宝藏了吗？"
                }
            ]
        },
        {
            "id": "2100450",
            "objective": "与索拉雅对话",
            "dialogues": [
                {
                    "id": "210045001",
                    "speaker": "索拉雅",
                    "text": "怎么样？你们找到宝藏了吗？"
                },
                {
                    "id": "210045003",
                    "speaker": "Player",
                    "text": "找到了，确实是在「汇成之地」"
                },
                {
                    "id": "210045004",
                    "speaker": "索拉雅",
                    "text": "原来如此…还真是和「归终四诫」里说的一样，宝藏在四诫的「汇成之地」啊。"
                },
                {
                    "id": "210045005",
                    "speaker": "索拉雅",
                    "text": "设置谜题的那个人，一定很尊敬「归终」吧。"
                },
                {
                    "id": "210045006",
                    "speaker": "索拉雅",
                    "text": "即使故乡被毁灭，也要以这种方式把「归终四诫」给流传下去。"
                },
                {
                    "id": "210045007",
                    "speaker": "索拉雅",
                    "text": "而那位定下这四诫的「归终」，也一定深爱着她庇护着的子民。"
                },
                {
                    "id": "210045008",
                    "speaker": "索拉雅",
                    "text": "她希望自己的子民们拥有智慧，用道德约束自己，祝福他们身体强健，而且团结一心，一同保护自己的家园「归离集」…",
                    "choices": [
                        {
                            "id": "210045009",
                            "text": "但是她还是失败了。",
                            "response": [
                                {
                                    "id": "210045010",
                                    "speaker": "索拉雅",
                                    "text": "失败了？这么说也没错，她死去了…「归离集」被毁灭，她的子民们也流离失所。"
                                },
                                {
                                    "id": "210045011",
                                    "speaker": "索拉雅",
                                    "text": "不过，如今我们不是让她的「归终四诫」重见天日了吗？"
                                },
                                {
                                    "id": "210045012",
                                    "speaker": "索拉雅",
                                    "text": "这是那位「归终」为她的子民们亲手订下的诫语，和送上的祝福。"
                                },
                                {
                                    "id": "210045013",
                                    "speaker": "索拉雅",
                                    "text": "秉承着这份「归终四诫」，她曾经在这片大地上，和自己的子民们携手前进。"
                                },
                                {
                                    "id": "210045014",
                                    "speaker": "索拉雅",
                                    "text": "即使她已经死去了，但是她的信念和理想绝不会就此消失。"
                                },
                                {
                                    "id": "210045015",
                                    "speaker": "索拉雅",
                                    "text": "而且，那位崇敬着她的人可真是聪明，居然想到用「藏宝」的方式，把「归终四诫」给传下来。"
                                },
                                {
                                    "id": "210045028",
                                    "speaker": "索拉雅",
                                    "text": "不过，也不知道在那个人心中，真正的宝贝到底是金银珠宝，还是这份「归终四诫」呢…"
                                },
                                {
                                    "id": "210045029",
                                    "speaker": "索拉雅",
                                    "text": "哈哈，要我说，比起那些金银珠宝，这份「诫语」才是真正的宝物。"
                                },
                                {
                                    "id": "210045030",
                                    "speaker": "索拉雅",
                                    "text": "…但是，要真让人选，又有多少人会抛弃财宝，选这份「诫语」呢？唉…"
                                }
                            ]
                        },
                        {
                            "id": "210045016",
                            "text": "是一位温柔的魔神。",
                            "response": [
                                {
                                    "id": "210045017",
                                    "speaker": "索拉雅",
                                    "text": "用「温柔」来形容一位「魔神」，真是感觉有点不搭边际…"
                                },
                                {
                                    "id": "210045018",
                                    "speaker": "索拉雅",
                                    "text": "在很久很久之前，在那些引导着人们的魔神之中，也许真有「温柔」的魔神吧。"
                                },
                                {
                                    "id": "210045019",
                                    "speaker": "索拉雅",
                                    "text": "保护着自己的子民，和他们一同在这片大地上漫步，一同携手前进。"
                                },
                                {
                                    "id": "210045020",
                                    "speaker": "索拉雅",
                                    "text": "…不过这样温柔的魔神，最终还是什么也没能保护下来。就连她给自己子民的诫语，都要借助「宝藏」这种东西才能流传下来。"
                                }
                            ]
                        },
                        {
                            "id": "210045021",
                            "text": "真想见她一面。",
                            "response": [
                                {
                                    "id": "210045022",
                                    "speaker": "索拉雅",
                                    "text": "居然想要去见魔神，你还真是异想天开。"
                                },
                                {
                                    "id": "210045023",
                                    "speaker": "索拉雅",
                                    "text": "不过，如果你真见到了「归终」，你会做什么？"
                                },
                                {
                                    "id": "210045024",
                                    "speaker": "索拉雅",
                                    "text": "难道想要说「辛苦了」、「谢谢你」之类的话，来安慰她吗？"
                                },
                                {
                                    "id": "210045025",
                                    "speaker": "索拉雅",
                                    "text": "如果要我说的话，不如流利背诵一遍「归终四诫」吧。"
                                },
                                {
                                    "id": "210045026",
                                    "speaker": "索拉雅",
                                    "text": "然后告诉她，她的信念和理想还没有消失，这片大地上还有人牢记着她的教诲。"
                                },
                                {
                                    "id": "210045027",
                                    "speaker": "索拉雅",
                                    "text": "对于已经失去了一切的「归终」来说，也许…这才是最好的安慰吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2100409",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210040901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "210040902",
                    "speaker": "索拉雅",
                    "text": "要走了吗？有什么新奇的故事，记得回来告诉我啊。"
                }
            ]
        },
        {
            "id": "2100490",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210049001",
                    "speaker": "索拉雅",
                    "text": "（Test）在这个「传说」里，究竟隐藏着什么秘密呢…"
                },
                {
                    "id": "210049002",
                    "speaker": "Player",
                    "text": "（Test）关于「传说」的详情…"
                },
                {
                    "id": "210049003",
                    "speaker": "索拉雅",
                    "text": "（Test）你也对这里的传说感兴趣吗？唔，这段「传说」是这样的…"
                },
                {
                    "id": "210049004",
                    "speaker": "索拉雅",
                    "text": "（Test）「在智慧与意志、团结与坚毅如水汇聚之处，我将展露大地丰饶的宝藏。」"
                },
                {
                    "id": "210049005",
                    "speaker": "索拉雅",
                    "text": "（Test）我猜测，「智慧」、「意志」，「团结」和「坚毅」这四个词，应该指代的是某些具体的事物。"
                },
                {
                    "id": "210049006",
                    "speaker": "索拉雅",
                    "text": "（Test）我在探查山扉城往事的过程中，曾经到过一处遗迹…里面有和这个类似的文字。"
                },
                {
                    "id": "210049007",
                    "speaker": "索拉雅",
                    "text": "如果我的猜想是对的，那四个词，指代的应该就是四处遗迹。"
                },
                {
                    "id": "210049008",
                    "speaker": "索拉雅",
                    "text": "把这四处遗迹全部发现的话，说不定就能将那段「传说」完全解读。"
                },
                {
                    "id": "210049009",
                    "speaker": "索拉雅",
                    "text": "不过，我的体力不太好…光是发现那一处遗迹，回来就歇了好多天。"
                },
                {
                    "id": "210049010",
                    "speaker": "索拉雅",
                    "text": "如果你有兴趣的话，不如就去找找吧，也许…你会在我之前发现什么突破点呢。"
                }
            ]
        },
        {
            "id": "2100492",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210049201",
                    "speaker": "Player",
                    "text": "关于「归终四诫」…"
                },
                {
                    "id": "210049202",
                    "speaker": "索拉雅",
                    "text": "哦，你有些记不清「归终四诫」了吗？没关系，这种东西确实挺难记，不过，我的记忆力还算不错。"
                },
                {
                    "id": "210049203",
                    "speaker": "索拉雅",
                    "text": "「归终四诫」的内容是「教之以智、律之以德、坚其筋骨，众志一心，四者汇之而成『归离集』。」"
                }
            ]
        },
        {
            "id": "2100493",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210049301",
                    "speaker": "Player",
                    "text": "也许是魔神之间的领地争斗…"
                },
                {
                    "id": "210049302",
                    "speaker": "索拉雅",
                    "text": "…领地吗？但是根据这里说的，「归离集」在「归终」的治理下，一直安稳地存在了很长时间。"
                },
                {
                    "id": "210049303",
                    "speaker": "索拉雅",
                    "text": "虽然感觉「归终」并不是什么拥有强大力量的魔神…"
                },
                {
                    "id": "210049304",
                    "speaker": "索拉雅",
                    "text": "但「归离集」里不仅有「归终」，似乎还存在着另外一位魔神，绝不会有人傻到对两位魔神一同发动攻击。"
                }
            ]
        },
        {
            "id": "2100494",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210049401",
                    "speaker": "Player",
                    "text": "因为…宝物？"
                },
                {
                    "id": "210049402",
                    "speaker": "索拉雅",
                    "text": "那可是堂堂的魔神，绝不会因为一点财宝而轻易大动干戈。"
                },
                {
                    "id": "210049403",
                    "speaker": "索拉雅",
                    "text": "而且，就算是以这个思路想下去，能够引起魔神彼此争斗的财宝…"
                },
                {
                    "id": "210049404",
                    "speaker": "索拉雅",
                    "text": "…哈哈，我是想象不出来，到底是什么。"
                }
            ]
        },
        {
            "id": "2100495",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210049501",
                    "speaker": "Player",
                    "text": "呃，说不定是和另外哪位魔神…"
                },
                {
                    "id": "210049502",
                    "speaker": "索拉雅",
                    "text": "你…到底是怎么会…这么想的，不要把璃月港里那些虚构的故事套入现实里来。"
                },
                {
                    "id": "210049503",
                    "speaker": "索拉雅",
                    "text": "「归终」贵为魔神，怎么可能和凡人一样…"
                },
                {
                    "id": "210049504",
                    "speaker": "索拉雅",
                    "text": "一…一定，呃，应该…不会吧…"
                }
            ]
        },
        {
            "id": "2100496",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210049601",
                    "speaker": "Player",
                    "text": "我也不知道为什么…"
                },
                {
                    "id": "210049602",
                    "speaker": "索拉雅",
                    "text": "难道，还是因为那场「魔神战争」。"
                },
                {
                    "id": "210049603",
                    "speaker": "索拉雅",
                    "text": "为了那七个天空岛上的神座，魔神们之间掀起的无尽争斗。"
                },
                {
                    "id": "210049604",
                    "speaker": "索拉雅",
                    "text": "看来在那场战争里，这个世界上没有谁能真正置身事外。"
                }
            ]
        },
        {
            "id": "2100497",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "210049701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "210049702",
                    "speaker": "索拉雅",
                    "text": "再见，如果有什么发现的话，就回来告诉我吧。"
                }
            ]
        }
    ]
}