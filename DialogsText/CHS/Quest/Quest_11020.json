    "talks": [
        {
            "id": "1102001",
            "objective": "前往珠钿舫",
            "dialogues": []
        },
        {
            "id": "1102002",
            "objective": "与桌边的钟离交谈",
            "dialogues": [
                {
                    "id": "110200201",
                    "speaker": "钟离",
                    "text": "哦？没想到会在这里遇见你们。"
                },
                {
                    "id": "110200202",
                    "speaker": "宛烟",
                    "text": "这两位是你的朋友吗？"
                },
                {
                    "id": "110200203",
                    "speaker": "钟离",
                    "text": "#嗯，前段时间有幸识得，{NICKNAME}，见多识广，博学多才。与之相处，倍感投缘。"
                },
                {
                    "id": "110200204",
                    "speaker": "钟离",
                    "text": "刚刚我们聊到「历史上的岩王帝君」这个话题，你有兴趣听一听吗？"
                },
                {
                    "id": "110200205",
                    "speaker": "翰学",
                    "text": "这位先生，好像轻看了岩王爷的神力。作为专业的考古学家，我想纠正他的一些观点。",
                    "choices": [
                        {
                            "id": "110200206",
                            "text": "他、他其实…",
                            "response": [
                                {
                                    "id": "110200208",
                                    "speaker": "翰学",
                                    "text": "我们正在讨论，「历史上第一枚摩拉」的下落。"
                                },
                                {
                                    "id": "110200209",
                                    "speaker": "派蒙",
                                    "text": "历史上的第一枚摩拉？"
                                },
                                {
                                    "id": "110200210",
                                    "speaker": "逸轩",
                                    "text": "众所周知，在岩王爷的指引下，璃月先民冶炼矿石，用最初的货物与世间诸国展开贸易。"
                                },
                                {
                                    "id": "110200211",
                                    "speaker": "逸轩",
                                    "text": "如今的璃月，掌握了全大陆摩拉的唯一铸造之权。而世上第一枚摩拉，应该就是在数千年前，岩王爷亲手铸造的。"
                                },
                                {
                                    "id": "110200212",
                                    "speaker": "宛烟",
                                    "text": "根据我的考证…再加上一点猜测，我认为这枚具有历史意义的摩拉，可能是作为一种「信物」，秘密传承了下来。"
                                },
                                {
                                    "id": "110200213",
                                    "speaker": "宛烟",
                                    "text": "比如…掌管璃月的「七星」，会不会在每一代上任之前，都有什么不为外人所知的仪式…"
                                },
                                {
                                    "id": "110200214",
                                    "speaker": "翰学",
                                    "text": "不不不，按照我的研究，这「第一枚摩拉」的地位，可没这么简单。"
                                },
                                {
                                    "id": "110200215",
                                    "speaker": "翰学",
                                    "text": "众所周知，摩拉是一种触媒。直到今天，也流传着利用摩拉在神秘学中的功效，来强化武器的奇术。"
                                },
                                {
                                    "id": "110200216",
                                    "speaker": "翰学",
                                    "text": "世上第一枚摩拉，一定蕴含着最强的力量。所以我的下一本历史著作，就是要大胆论证我十年来潜心研究的最新成果！"
                                },
                                {
                                    "id": "110200217",
                                    "speaker": "翰学",
                                    "text": "那就是——岩王爷用这枚摩拉作为触媒，强化了一刀一剑。"
                                },
                                {
                                    "id": "110200218",
                                    "speaker": "派蒙",
                                    "text": "一刀一剑？"
                                },
                                {
                                    "id": "110200219",
                                    "speaker": "翰学",
                                    "text": "哼哼哼，到时就请购买著作阅读全文了。现在我只揭秘一小部分：得到刀就可以成为璃月至尊，拔出剑就可以加冕璃月之王——"
                                },
                                {
                                    "id": "110200220",
                                    "speaker": "钟离",
                                    "text": "…不敢苟同。"
                                },
                                {
                                    "id": "110200221",
                                    "speaker": "翰学",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "110200222",
                                    "speaker": "钟离",
                                    "text": "且不提这刀剑考据的真实性…所谓摩拉，所谓金钱，诞生的初衷，只是一种方便「契约」签立的筹码而已。"
                                },
                                {
                                    "id": "110200223",
                                    "speaker": "钟离",
                                    "text": "引导人类利用摩拉进行交易，才是帝君本意。"
                                },
                                {
                                    "id": "110200224",
                                    "speaker": "钟离",
                                    "text": "想必「世上第一枚摩拉」，也只是被帝君当作普通的钱币，简简单单地花掉了吧…"
                                },
                                {
                                    "id": "110200225",
                                    "speaker": "逸轩",
                                    "text": "唔…我觉得翰学先生的假说很有道理，倒是这位钟离先生，无凭无据的，就这么看轻岩王爷的深远谋划？"
                                },
                                {
                                    "id": "110200226",
                                    "speaker": "钟离",
                                    "text": "不…我的说法不含褒贬，只是在陈述一种事实。"
                                },
                                {
                                    "id": "110200227",
                                    "speaker": "翰学",
                                    "text": "得了吧，是你懂岩王爷还是我懂岩王爷？",
                                    "choices": [
                                        {
                                            "id": "110200228",
                                            "text": "他、他其实…",
                                            "response": [
                                                {
                                                    "id": "110200230",
                                                    "speaker": "钟离",
                                                    "text": "历史之事，我只略通一二，岂敢自诩。但如果观念没有分歧，研讨也就失去了意义。"
                                                },
                                                {
                                                    "id": "110200231",
                                                    "speaker": "逸轩",
                                                    "text": "那我问你，千百年前，璃月港大兴土木，岩王爷传授人民建筑技艺。他使用的示范模型，全是用摩拉熔铸的，对吧？"
                                                },
                                                {
                                                    "id": "110200232",
                                                    "speaker": "钟离",
                                                    "text": "确有此事。"
                                                },
                                                {
                                                    "id": "110200233",
                                                    "speaker": "翰学",
                                                    "text": "好，你说，如果不是因为看重摩拉的神力特质，岩王爷又为何要做出如此奢侈的行为？"
                                                },
                                                {
                                                    "id": "110200234",
                                                    "speaker": "钟离",
                                                    "text": "这很容易解释。因为对帝君来说，摩拉是最容易获得的，成本最低的材料。"
                                                },
                                                {
                                                    "id": "110200235",
                                                    "speaker": "翰学",
                                                    "text": "唔、唔…"
                                                },
                                                {
                                                    "id": "110200236",
                                                    "speaker": "Player",
                                                    "text": "就像在说别人的故事一样。"
                                                },
                                                {
                                                    "id": "110200237",
                                                    "speaker": "钟离",
                                                    "text": "呵呵，本来就是岩王帝君的故事啊。"
                                                },
                                                {
                                                    "id": "110200238",
                                                    "speaker": "宛烟",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "110200239",
                                                    "speaker": "宛烟",
                                                    "text": "这位先生！那个…我有些考古学方面的问题，想换一个安静的地方，向你请教。不知会不会打扰先生？"
                                                },
                                                {
                                                    "id": "110200240",
                                                    "speaker": "钟离",
                                                    "text": "#哦，这倒无妨。不过，不知我的这位朋友方便一起来吗？说不定{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}能提供更多帮助。",
                                                    "choices": [
                                                        {
                                                            "id": "110200241",
                                                            "text": "我吗？",
                                                            "response": [
                                                                {
                                                                    "id": "110200243",
                                                                    "speaker": "宛烟",
                                                                    "text": "先生都这么说了，那当然欢迎！我们走吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110200242",
                                                            "text": "就当作来听听故事吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110200229",
                                            "text": "也许没人比他更懂…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110200207",
                            "text": "也许没人比他更懂…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1102003",
            "objective": "去船尾了解宛烟的问题",
            "dialogues": [
                {
                    "id": "110200301",
                    "speaker": "宛烟",
                    "text": "接下来说的话，对岩神有些不敬，会招来很多白眼，所以…还是安静的地方比较好。"
                },
                {
                    "id": "110200302",
                    "speaker": "宛烟",
                    "text": "方才见先生谈吐不凡，思维清晰，最关键的是不轻信吹嘘与演绎，非常客观。"
                },
                {
                    "id": "110200303",
                    "speaker": "宛烟",
                    "text": "所以我想问先生一个问题，或许能得到与普通学者不同的答案…先生觉得，被岩神杀死的魔神，全都是邪恶的吗？"
                },
                {
                    "id": "110200304",
                    "speaker": "钟离",
                    "text": "…善与恶，暂且不论。岩王帝君尊重「契约」，所以死于他手的魔神，一定是打破了某种「契约」。"
                },
                {
                    "id": "110200305",
                    "speaker": "派蒙",
                    "text": "嗯，至少滥杀无辜这种事，岩王爷是不会做的吧。"
                },
                {
                    "id": "110200306",
                    "speaker": "宛烟",
                    "text": "可是，我在考古的时候，了解到一些关于「盐之魔神」的传说。"
                },
                {
                    "id": "110200307",
                    "speaker": "宛烟",
                    "text": "「盐之魔神」赫乌莉亚…她是一位善良的魔神，却还是在战争中被摩拉克斯…"
                },
                {
                    "id": "110200308",
                    "speaker": "宛烟",
                    "text": "被摩拉克斯，用不光彩的手段…暗杀了。"
                },
                {
                    "id": "110200309",
                    "speaker": "派蒙",
                    "text": "啊？不会吧！"
                },
                {
                    "id": "110200310",
                    "speaker": "钟离",
                    "text": "这…确实是说来话长的一段历史。但故事的真相，可能并不是你想知道的那种。"
                },
                {
                    "id": "110200311",
                    "speaker": "宛烟",
                    "text": "没关系，请把你知道的历史都告诉我吧！这件事…这件事，我已经调查很久了！",
                    "choices": [
                        {
                            "id": "110200312",
                            "text": "钟离看起来有点为难。",
                            "response": [
                                {
                                    "id": "110200313",
                                    "speaker": "钟离",
                                    "text": "不…只是，该从哪里说起呢。"
                                },
                                {
                                    "id": "110200316",
                                    "speaker": "克列门特",
                                    "text": "哦，在这在这！钟离先生！哎呀，找了好久，没想到你在这里。",
                                    "choices": [
                                        {
                                            "id": "110200317",
                                            "text": "愚人众？！",
                                            "response": [
                                                {
                                                    "id": "110200319",
                                                    "speaker": "派蒙",
                                                    "text": "放下武器！保持距离！不然…不然我要报告千岩军了！"
                                                },
                                                {
                                                    "id": "110200320",
                                                    "speaker": "克列门特",
                                                    "text": "首先我就没有拿武器啊？！"
                                                },
                                                {
                                                    "id": "110200321",
                                                    "speaker": "克列门特",
                                                    "text": "呃…反应不用这么激烈，我是至冬国来的考古研究员，不是来找麻烦的。"
                                                },
                                                {
                                                    "id": "110200322",
                                                    "speaker": "派蒙",
                                                    "text": "愚人众每次都这么说…"
                                                },
                                                {
                                                    "id": "110200323",
                                                    "speaker": "克列门特",
                                                    "text": "这次，已经和璃月总务司报备过了。你们想看的话，我这里有官方的许可文书。"
                                                },
                                                {
                                                    "id": "110200324",
                                                    "speaker": "克列门特",
                                                    "text": "我会在璃月进行一段时间的考古勘探，所有的勘探结果，都会和官方共享。"
                                                },
                                                {
                                                    "id": "110200325",
                                                    "speaker": "克列门特",
                                                    "text": "而我听说，往生堂有位客卿，名叫钟离，博古通今，知识渊博。我就向往生堂支付了重金，聘请他当我的顾问。"
                                                },
                                                {
                                                    "id": "110200326",
                                                    "speaker": "钟离",
                                                    "text": "也就是说，是往生堂的工作，对吧。",
                                                    "choices": [
                                                        {
                                                            "id": "110200327",
                                                            "text": "怎么办？",
                                                            "response": [
                                                                {
                                                                    "id": "110200329",
                                                                    "speaker": "钟离",
                                                                    "text": "既然是工作，那就没办法了。身为往生堂的客卿，就要尊重这个身份。"
                                                                },
                                                                {
                                                                    "id": "110200330",
                                                                    "speaker": "克列门特",
                                                                    "text": "果然是通情达理之人！那我们现在就出发吧！"
                                                                },
                                                                {
                                                                    "id": "110200331",
                                                                    "speaker": "宛烟",
                                                                    "text": "稍等，如果是考古的话，我也可以一起去吗？我也是考古学家，可以提供很多帮助。"
                                                                },
                                                                {
                                                                    "id": "110200332",
                                                                    "speaker": "钟离",
                                                                    "text": "#那刚刚的话题，路上有机会再继续讲吧。对了，{NICKNAME}，你也一起来吧。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110200333",
                                                                            "text": "为什么？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110200335",
                                                                                    "speaker": "钟离",
                                                                                    "text": "接下来的经历，或许会对你未来的旅途有所帮助。"
                                                                                },
                                                                                {
                                                                                    "id": "110200336",
                                                                                    "speaker": "钟离",
                                                                                    "text": "那是七神体系建立之前的故事…虽然魔神已逝，不可能是你的寻访目标，但至少，也能为你的旅行见闻增添一些意义。"
                                                                                },
                                                                                {
                                                                                    "id": "110200337",
                                                                                    "speaker": "克列门特",
                                                                                    "text": "等等，这是考古小队，不是观光团！人太多了！"
                                                                                },
                                                                                {
                                                                                    "id": "110200338",
                                                                                    "speaker": "钟离",
                                                                                    "text": "可是，我这位朋友，有一项无人能及的寻宝天赋，对我们的考古之行大有裨益。"
                                                                                },
                                                                                {
                                                                                    "id": "110200339",
                                                                                    "speaker": "克列门特",
                                                                                    "text": "哦？什么天赋呢？"
                                                                                },
                                                                                {
                                                                                    "id": "110200340",
                                                                                    "speaker": "钟离",
                                                                                    "text": "——绝不会漏过任何一个视线之内的宝箱。"
                                                                                },
                                                                                {
                                                                                    "id": "110200341",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我也擅长这个！"
                                                                                },
                                                                                {
                                                                                    "id": "110200342",
                                                                                    "speaker": "克列门特",
                                                                                    "text": "…确实有点吸引力，行吧行吧。"
                                                                                },
                                                                                {
                                                                                    "id": "110200343",
                                                                                    "speaker": "克列门特",
                                                                                    "text": "事不宜迟，我们先去看看，不久前那位「漩涡之魔神」被群玉阁镇压时，会不会有什么东西冲刷上岸？"
                                                                                },
                                                                                {
                                                                                    "id": "110200344",
                                                                                    "speaker": "克列门特",
                                                                                    "text": "古物也好，痕迹也好，要是有一点点魔神肢体的碎片就更好了…总之，说不定能有大收获呢。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110200334",
                                                                            "text": "其实我不太懂考古。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110200328",
                                                            "text": "我觉得谨慎一点比较好。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110200318",
                                            "text": "老实点！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110200314",
                            "text": "是这么复杂的故事吗？",
                            "response": [
                                {
                                    "id": "110200315",
                                    "speaker": "钟离",
                                    "text": "嗯，不知该从哪里说起。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}