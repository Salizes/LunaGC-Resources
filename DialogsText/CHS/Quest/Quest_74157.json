            "dialogues": []
        },
        {
            "id": "7415702",
            "objective": "与茉莉对话",
            "dialogues": [
                {
                    "id": "741570201",
                    "speaker": "房屋出售信息",
                    "text": "此屋待售。价格实惠，欲购从速。"
                },
                {
                    "id": "741570202",
                    "speaker": "茉莉",
                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，还有派蒙姐姐，勒鲁瓦先生好像不住在这里了。你们后来见过他吗？"
                },
                {
                    "id": "741570203",
                    "speaker": "派蒙",
                    "text": "（喂，要说实话吗？）",
                    "choices": [
                        {
                            "id": "741570204",
                            "text": "见过。",
                            "response": [
                                {
                                    "id": "741570205",
                                    "speaker": "茉莉",
                                    "text": "原来你们见过！那你帮我告诉他点心很好吃了吗？",
                                    "choices": [
                                        {
                                            "id": "741570206",
                                            "text": "说了。",
                                            "response": [
                                                {
                                                    "id": "741570207",
                                                    "speaker": "茉莉",
                                                    "text": "#我就知道{NICKNAME}{M#哥哥}{F#姐姐}会守信用，你们真好，我带了泡泡桔过来，请你们一起吃。"
                                                },
                                                {
                                                    "id": "741570214",
                                                    "speaker": "Black Screen",
                                                    "text": "茉莉叹了口气，向你们挥手作别，正打算离开这条街道…"
                                                },
                                                {
                                                    "id": "741570215",
                                                    "speaker": "Black Screen",
                                                    "text": "大门打开，秋和阿托斯从屋内走了出来。"
                                                },
                                                {
                                                    "id": "741570216",
                                                    "speaker": "秋",
                                                    "text": "果然外面的声音是你们。还有什么事吗？",
                                                    "choices": [
                                                        {
                                                            "id": "741570217",
                                                            "text": "只是正巧路过。",
                                                            "response": [
                                                                {
                                                                    "id": "741570218",
                                                                    "speaker": "阿托斯",
                                                                    "text": "是吗？世界真小。正好我和秋也打算离开了。"
                                                                },
                                                                {
                                                                    "id": "741570219",
                                                                    "speaker": "Player",
                                                                    "text": "伯努瓦呢？"
                                                                },
                                                                {
                                                                    "id": "741570220",
                                                                    "speaker": "阿托斯",
                                                                    "text": "哦，他已经去别的地方了，那个地方我们几十年后才会去，你们短期内应该见不到他了。"
                                                                },
                                                                {
                                                                    "id": "741570221",
                                                                    "speaker": "阿托斯",
                                                                    "text": "不过这也不好说，明天和意外究竟哪个先来？谁知道呢？"
                                                                },
                                                                {
                                                                    "id": "741570225",
                                                                    "speaker": "阿托斯",
                                                                    "text": "这不是那个总来找伯努瓦的小鬼吗？"
                                                                },
                                                                {
                                                                    "id": "741570226",
                                                                    "speaker": "秋",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "741570227",
                                                                    "speaker": "茉莉",
                                                                    "text": "阿姨你好。"
                                                                },
                                                                {
                                                                    "id": "741570228",
                                                                    "speaker": "秋",
                                                                    "text": "…太像了，还有紫色的眼睛…"
                                                                },
                                                                {
                                                                    "id": "741570229",
                                                                    "speaker": "茉莉",
                                                                    "text": "阿、阿姨有什么事吗？"
                                                                },
                                                                {
                                                                    "id": "741570230",
                                                                    "speaker": "秋",
                                                                    "text": "你多大了？"
                                                                },
                                                                {
                                                                    "id": "741570231",
                                                                    "speaker": "茉莉",
                                                                    "text": "我九岁。"
                                                                },
                                                                {
                                                                    "id": "741570232",
                                                                    "speaker": "秋",
                                                                    "text": "你爸爸妈妈叫什么？"
                                                                },
                                                                {
                                                                    "id": "741570233",
                                                                    "speaker": "茉莉",
                                                                    "text": "唔…阿姨怎么了？"
                                                                },
                                                                {
                                                                    "id": "741570234",
                                                                    "speaker": "阿托斯",
                                                                    "text": "你的表情…这个小孩怎么了？…总不会这么巧吧？"
                                                                },
                                                                {
                                                                    "id": "741570235",
                                                                    "speaker": "秋",
                                                                    "text": "告诉我你是不是被收养的，快。"
                                                                },
                                                                {
                                                                    "id": "741570236",
                                                                    "speaker": "茉莉",
                                                                    "text": "#…{NICKNAME}{M#哥哥}{F#姐姐}，这个阿姨你认识吗？她要干什么…"
                                                                },
                                                                {
                                                                    "id": "741570237",
                                                                    "speaker": "阿托斯",
                                                                    "text": "哪有你这么问的，我来吧。"
                                                                },
                                                                {
                                                                    "id": "741570238",
                                                                    "speaker": "阿托斯",
                                                                    "text": "小姑娘，我记得你和爸爸关系很好，对吧？"
                                                                },
                                                                {
                                                                    "id": "741570239",
                                                                    "speaker": "茉莉",
                                                                    "text": "对，勒鲁瓦先生对我特别好。女婿叔叔，他是不住在这里了吗？"
                                                                },
                                                                {
                                                                    "id": "741570240",
                                                                    "speaker": "阿托斯",
                                                                    "text": "没错，他去了很远的地方，以后不回来住了。"
                                                                },
                                                                {
                                                                    "id": "741570241",
                                                                    "speaker": "阿托斯",
                                                                    "text": "爸爸他平常都和你们聊些什么呀？可以告诉我吗，回去我可以告诉爸爸，你很想念他。"
                                                                },
                                                                {
                                                                    "id": "741570242",
                                                                    "speaker": "茉莉",
                                                                    "text": "勒鲁瓦先生请我吃点心，让我摸娜娜，还会夸我眼睛好看！"
                                                                },
                                                                {
                                                                    "id": "741570243",
                                                                    "speaker": "阿托斯",
                                                                    "text": "还有呢？"
                                                                },
                                                                {
                                                                    "id": "741570244",
                                                                    "speaker": "茉莉",
                                                                    "text": "他经常让我代他向爸爸妈妈问好，虽然爸爸妈妈非常不喜欢这样…"
                                                                },
                                                                {
                                                                    "id": "741570245",
                                                                    "speaker": "茉莉",
                                                                    "text": "每次爸爸都会很生气，说勒鲁瓦先生是坏人，是「勒索」他们。"
                                                                },
                                                                {
                                                                    "id": "741570246",
                                                                    "speaker": "茉莉",
                                                                    "text": "虽然爸爸妈妈不许我过来，但是我和勒鲁瓦先生约好了，所以我还是会偷偷过来，叔叔你不要告诉我爸爸哦。"
                                                                },
                                                                {
                                                                    "id": "741570247",
                                                                    "speaker": "秋",
                                                                    "text": "他就是会做这样的事，不把最后一点价值榨干绝对不停手。"
                                                                },
                                                                {
                                                                    "id": "741570248",
                                                                    "speaker": "阿托斯",
                                                                    "text": "…混账…不好意思，刚才我们在说别的事。"
                                                                },
                                                                {
                                                                    "id": "741570249",
                                                                    "speaker": "茉莉",
                                                                    "text": "叔、叔叔阿姨还有别的事情吗？没有的话，我、我先回家了。"
                                                                },
                                                                {
                                                                    "id": "741570250",
                                                                    "speaker": "秋",
                                                                    "text": "…你的爸爸和妈妈爱你吗？"
                                                                },
                                                                {
                                                                    "id": "741570251",
                                                                    "speaker": "茉莉",
                                                                    "text": "他们是世界上最好的爸爸和妈妈。"
                                                                },
                                                                {
                                                                    "id": "741570252",
                                                                    "speaker": "秋",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "741570253",
                                                                    "speaker": "秋",
                                                                    "text": "这很好。"
                                                                },
                                                                {
                                                                    "id": "741570254",
                                                                    "speaker": "茉莉",
                                                                    "text": "我要回家了，叔叔阿姨再见。"
                                                                },
                                                                {
                                                                    "id": "741570255",
                                                                    "speaker": "秋",
                                                                    "text": "再见。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "741570256",
                                                                            "text": "这样就行了？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "741570258",
                                                                                    "speaker": "秋",
                                                                                    "text": "这个场景我想象过很多次…没有一个比知道她过得幸福更好，这样就够了。"
                                                                                },
                                                                                {
                                                                                    "id": "741570259",
                                                                                    "speaker": "秋",
                                                                                    "text": "我…不是我父亲，我不打算给她现在的家庭找麻烦。"
                                                                                },
                                                                                {
                                                                                    "id": "741570260",
                                                                                    "speaker": "阿托斯",
                                                                                    "text": "不是我故意扫兴，你不是买了一个音乐盒给她吗？也不送了？"
                                                                                },
                                                                                {
                                                                                    "id": "741570261",
                                                                                    "speaker": "秋",
                                                                                    "text": "……"
                                                                                },
                                                                                {
                                                                                    "id": "741570262",
                                                                                    "speaker": "秋",
                                                                                    "text": "没有必要了，她…看起来不缺这种东西。"
                                                                                },
                                                                                {
                                                                                    "id": "741570263",
                                                                                    "speaker": "秋",
                                                                                    "text": "以后我会经常想办法来看她的，她需要什么我会想办法。"
                                                                                },
                                                                                {
                                                                                    "id": "741570264",
                                                                                    "speaker": "秋",
                                                                                    "text": "…这个盒子我送给别人吧，好歹挑了那么久。"
                                                                                },
                                                                                {
                                                                                    "id": "741570265",
                                                                                    "speaker": "秋",
                                                                                    "text": "白头发的小女孩，你喜欢礼物吗？"
                                                                                },
                                                                                {
                                                                                    "id": "741570266",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我吗？你要送给我？"
                                                                                },
                                                                                {
                                                                                    "id": "741570267",
                                                                                    "speaker": "秋",
                                                                                    "text": "是的，就送给你，让它发挥最后一点价值吧。"
                                                                                },
                                                                                {
                                                                                    "id": "741570268",
                                                                                    "speaker": "秋",
                                                                                    "text": "阿托斯，抱歉，我们还要在枫丹廷逗留一阵。"
                                                                                },
                                                                                {
                                                                                    "id": "741570269",
                                                                                    "speaker": "阿托斯",
                                                                                    "text": "没关系，去哪里对我来说都一样。走吧。"
                                                                                },
                                                                                {
                                                                                    "id": "741570270",
                                                                                    "speaker": "Black Screen",
                                                                                    "text": "你们目送他俩走出这条街，勒鲁瓦一家的故事就此结束。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "741570257",
                                                                            "text": "不打算让她知道？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741570219",
                                                            "text": "伯努瓦呢？"
                                                        },
                                                        {
                                                            "id": "741570222",
                                                            "text": "伯努瓦怎么样了？",
                                                            "response": [
                                                                {
                                                                    "id": "741570223",
                                                                    "speaker": "阿托斯",
                                                                    "text": "这个世界上充满了不均衡，过度的贫乏和过度的贪婪，枫丹的律法没能施予的惩罚，就由我们自己施予吧。"
                                                                },
                                                                {
                                                                    "id": "741570224",
                                                                    "speaker": "阿托斯",
                                                                    "text": "我的意思是，他去他该去的地方了。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741570208",
                                            "text": "忘记了。",
                                            "response": [
                                                {
                                                    "id": "741570209",
                                                    "speaker": "茉莉",
                                                    "text": "啊，好吧。那太遗憾了，唉，看来我是再也没机会让勒鲁瓦先生知道了。那我带过来的泡泡桔…还是送给你们好了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741570210",
                            "text": "没见过。",
                            "response": [
                                {
                                    "id": "741570211",
                                    "speaker": "茉莉",
                                    "text": "啊，那太可惜了，我应该再也见不到勒鲁瓦先生了。"
                                },
                                {
                                    "id": "741570212",
                                    "speaker": "茉莉",
                                    "text": "#我带了泡泡桔过来，本来觉得说不定能见到勒鲁瓦先生，既然他不住在这里了，这些桔子就给{M#哥哥姐姐}{F#姐姐们}吧。"
                                },
                                {
                                    "id": "741570213",
                                    "speaker": "茉莉",
                                    "text": "不管怎么说，我想我会一直记得勒鲁瓦先生的。再见啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7415703",
            "objective": "(test)自动与夫妇对话",
            "dialogues": [
                {
                    "id": "741570301",
                    "speaker": "房屋出售信息",
                    "text": "此屋待售。价格实惠，欲购从速。"
                },
                {
                    "id": "741570302",
                    "speaker": "茉莉",
                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，还有派蒙姐姐，你们是来找勒鲁瓦先生的吗？",
                    "choices": [
                        {
                            "id": "741570303",
                            "text": "伯努瓦在家吗？",
                            "response": [
                                {
                                    "id": "741570304",
                                    "speaker": "茉莉",
                                    "text": "不在这里，爸爸说勒鲁瓦先生不会再住在这里了，他住到地下去了。"
                                },
                                {
                                    "id": "741570308",
                                    "speaker": "Player",
                                    "text": "灰河？"
                                },
                                {
                                    "id": "741570309",
                                    "speaker": "派蒙",
                                    "text": "是我们之前去过的那个灰河吗？"
                                },
                                {
                                    "id": "741570310",
                                    "speaker": "茉莉",
                                    "text": "那个的话，不是的，爸爸说的是更地下的地下。"
                                },
                                {
                                    "id": "741570311",
                                    "speaker": "茉莉",
                                    "text": "蒸汽鸟报上说，勒鲁瓦先生爬山的时候从很高的地方摔下来，摔了一个大跟头。"
                                },
                                {
                                    "id": "741570312",
                                    "speaker": "茉莉",
                                    "text": "其实我不是很明白摔跟头和搬家之间有什么联系…"
                                },
                                {
                                    "id": "741570313",
                                    "speaker": "茉莉",
                                    "text": "对了，我刚刚来的时候见到女婿叔叔了，还有一个非常好心的大姐姐。"
                                },
                                {
                                    "id": "741570314",
                                    "speaker": "茉莉",
                                    "text": "大姐姐很喜欢我，她的眼睛和我一样，都是紫色的呢。"
                                },
                                {
                                    "id": "741570315",
                                    "speaker": "茉莉",
                                    "text": "她还问了我家住在哪里，说有空会去看望我，做我的好朋友。果然勒鲁瓦先生一家都是很好的人。"
                                },
                                {
                                    "id": "741570316",
                                    "speaker": "茉莉",
                                    "text": "唉，本来带了泡泡桔过来想送给勒鲁瓦先生的，现在他不在这里…"
                                },
                                {
                                    "id": "741570317",
                                    "speaker": "茉莉",
                                    "text": "#{M#哥哥姐姐}{F#姐姐们}，我送给你们吧？"
                                },
                                {
                                    "id": "741570318",
                                    "speaker": "派蒙",
                                    "text": "谢谢你，小茉莉。"
                                },
                                {
                                    "id": "741570319",
                                    "speaker": "茉莉",
                                    "text": "不客气啦，爸爸妈妈说对待朋友要慷慨。"
                                },
                                {
                                    "id": "741570320",
                                    "speaker": "茉莉",
                                    "text": "今天我又做了一件好事，回去我就把它写到日记里去，开心！"
                                },
                                {
                                    "id": "741570321",
                                    "speaker": "Black Screen",
                                    "text": "你目送快乐的茉莉走出这条街，勒鲁瓦一家的故事就此结束。"
                                }
                            ]
                        },
                        {
                            "id": "741570305",
                            "text": "只是正巧路过。",
                            "response": [
                                {
                                    "id": "741570306",
                                    "speaker": "茉莉",
                                    "text": "#我刚才在想，要不要告诉{M#哥哥姐姐}{F#姐姐们}，勒鲁瓦先生搬家了。"
                                },
                                {
                                    "id": "741570307",
                                    "speaker": "茉莉",
                                    "text": "爸爸说勒鲁瓦先生不会再住在这里了，他住到地下去了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
