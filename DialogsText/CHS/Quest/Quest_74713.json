{
    "quest": {
        "id": "74713",
        "title": "水域状况不太妙？",
        "description": "菲米尼似乎有事找我们…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 20,
        "total_speaker_counts": {
            "Player": 3,
