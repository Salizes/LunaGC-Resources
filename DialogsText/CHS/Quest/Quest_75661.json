    "talks": [
        {
            "id": "7566101",
            "objective": "(test)隐藏环对话$HIDDEN",
            "dialogues": [
                {
                    "id": "756610101",
                    "speaker": "恰斯卡",
                    "text": "难怪总有种预感让我过来看看…原来是能遇上你，了不起的「杜{RUBY#[D]希望}麦尼」。"
                },
                {
                    "id": "756610102",
                    "speaker": "恰斯卡",
                    "text": "那么——你是为了「花羽会」的战士试炼而来的吧？",
                    "choices": [
                        {
                            "id": "756610103",
                            "text": "没错，我来检验关卡的难度！",
                            "response": [
                                {
                                    "id": "756610104",
                                    "speaker": "恰斯卡",
                                    "text": "那你一定不会失望，我对绒翼龙骑士们的要求非常严格。"
                                },
                                {
                                    "id": "756610105",
                                    "speaker": "恰斯卡",
                                    "text": "因为我不擅长教导别人，在受邀设计这些关卡时，只能回忆「相当棘手」的难题，再把它们一个接一个加进去。"
                                },
                                {
                                    "id": "756610109",
                                    "speaker": "恰斯卡",
                                    "text": "结果九成九的「花羽会」战士都过不了第一关…没办法，只能接受伊拉德的建议，降低点难度了。"
                                },
                                {
                                    "id": "756610110",
                                    "speaker": "恰斯卡",
                                    "text": "但对你来说，简化前的试炼可能都不够让你尽兴，应当选用…连我都束手无策的难关。",
                                    "choices": [
                                        {
                                            "id": "756610111",
                                            "text": "说得好！但我不用特殊对待！",
                                            "response": [
                                                {
                                                    "id": "756610113",
                                                    "speaker": "恰斯卡",
                                                    "text": "这是对你应有的重视。虽然我不擅教导，但评估起实力却从没看走眼。"
                                                },
                                                {
                                                    "id": "756610114",
                                                    "speaker": "恰斯卡",
                                                    "text": "而以你的实力…唯有难度最高的挑战，才能与你相称。",
                                                    "choices": [
                                                        {
                                                            "id": "756610115",
                                                            "text": "但我得考虑普通战士的能力…",
                                                            "response": [
                                                                {
                                                                    "id": "756610117",
                                                                    "speaker": "恰斯卡",
                                                                    "text": "…也对，这次你有委托在身，以后还有机会。"
                                                                },
                                                                {
                                                                    "id": "756610118",
                                                                    "speaker": "恰斯卡",
                                                                    "text": "我会专门为你量身定制…「超越」绒翼龙骑士巅峰的斗争盛宴！期待并等待吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756610116",
                                                            "text": "评估关卡的普适性也很重要！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756610112",
                                            "text": "太看得起我了，没必要！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756610106",
                            "text": "也可以是为了你而来。",
                            "response": [
                                {
                                    "id": "756610107",
                                    "speaker": "恰斯卡",
                                    "text": "哦？原来如此…"
                                },
                                {
                                    "id": "756610108",
                                    "speaker": "恰斯卡",
                                    "text": "——你是想要「超越」我的记录吧？正合我意。这些关卡在设计之初，就塞满了我曾遇见过的「相当棘手」的难题。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}