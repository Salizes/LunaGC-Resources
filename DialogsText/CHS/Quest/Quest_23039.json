    "talks": [
        {
            "id": "2303901",
            "objective": "与奥贝德对话",
            "dialogues": [
                {
                    "id": "230390101",
                    "speaker": "奥贝德",
                    "text": "#{M#大哥哥}{F#大姐姐}！请等一下！"
                },
                {
                    "id": "230390102",
                    "speaker": "奥贝德",
                    "text": "请问…你是冒险家吗？就是那种去过很多地方冒险，很擅长战斗的冒险家！",
                    "choices": [
                        {
                            "id": "230390103",
                            "text": "算是吧。",
                            "response": [
                                {
                                    "id": "230390105",
                                    "speaker": "奥贝德",
                                    "text": "#你看！希尔米，我就说这位{M#大哥哥}{F#大姐姐}一定是冒险家！"
                                },
                                {
                                    "id": "230390106",
                                    "speaker": "希尔米",
                                    "text": "但是冒险家不都是穿那种绿绿的衣服吗…",
                                    "choices": [
                                        {
                                            "id": "230390107",
                                            "text": "我比较厉害，不用那么穿。",
                                            "response": [
                                                {
                                                    "id": "230390109",
                                                    "speaker": "希尔米",
                                                    "text": "喔——"
                                                },
                                                {
                                                    "id": "230390110",
                                                    "speaker": "奥贝德",
                                                    "text": "喔——"
                                                },
                                                {
                                                    "id": "230390111",
                                                    "speaker": "奥贝德",
                                                    "text": "#那{M#大哥哥}{F#大姐姐}！你肯定能帮我们这个忙啦！"
                                                },
                                                {
                                                    "id": "230390112",
                                                    "speaker": "奥贝德",
                                                    "text": "你看见村子里那个大大的仓库了吗？哈巴奇哥哥说，里面装着很重要的东西，必须要好好防守。"
                                                },
                                                {
                                                    "id": "230390113",
                                                    "speaker": "希尔米",
                                                    "text": "他还和我们说，如果有坏蛋来攻击村子，他就要先去把升降梯停掉，然后切断吊桥…"
                                                },
                                                {
                                                    "id": "230390114",
                                                    "speaker": "奥贝德",
                                                    "text": "可那个仓库离升降梯还有好一段距离呢，哈巴奇哥哥要是想停掉升降梯，还得拼命跑过去。"
                                                },
                                                {
                                                    "id": "230390115",
                                                    "speaker": "奥贝德",
                                                    "text": "我们就提出，我们可以陪他练习，但哈巴奇哥哥都不搭理我们…"
                                                },
                                                {
                                                    "id": "230390116",
                                                    "speaker": "希尔米",
                                                    "text": "明明每次我们想去打水漂的时候，他都反应那么大，嘁…"
                                                },
                                                {
                                                    "id": "230390117",
                                                    "speaker": "奥贝德",
                                                    "text": "咳，总之！如果坏人来攻击村里，哈巴奇哥哥又跑不动了，那就只能由我们去停掉升降梯啦。"
                                                },
                                                {
                                                    "id": "230390118",
                                                    "speaker": "奥贝德",
                                                    "text": "#{M#大哥哥}{F#大姐姐}，你是个冒险家，肯定很擅长跑步吧，就请你陪我们训练一下吧。",
                                                    "choices": [
                                                        {
                                                            "id": "230390119",
                                                            "text": "那我就陪你们跑一段。",
                                                            "response": [
                                                                {
                                                                    "id": "230390120",
                                                                    "speaker": "奥贝德",
                                                                    "text": "#好耶！谢谢{M#大哥哥}{F#大姐姐}！"
                                                                },
                                                                {
                                                                    "id": "230390126",
                                                                    "speaker": "希尔米",
                                                                    "text": "#我们已经选好起点了，我们去那边吧，{M#大哥哥}{F#大姐姐}。"
                                                                },
                                                                {
                                                                    "id": "230390127",
                                                                    "speaker": "希尔米",
                                                                    "text": "嘿嘿，这次就由我来和你对决。先说好，我可是很擅长跑步的喔。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230390121",
                                                            "text": "可以相信哈巴奇的…",
                                                            "response": [
                                                                {
                                                                    "id": "230390122",
                                                                    "speaker": "奥贝德",
                                                                    "text": "欸…就陪我们玩…"
                                                                },
                                                                {
                                                                    "id": "230390123",
                                                                    "speaker": "奥贝德",
                                                                    "text": "#陪，陪我们训练一下吧，{M#大哥哥}{F#大姐姐}，拜托啦！"
                                                                },
                                                                {
                                                                    "id": "230390124",
                                                                    "speaker": "Player",
                                                                    "text": "好吧…"
                                                                },
                                                                {
                                                                    "id": "230390125",
                                                                    "speaker": "奥贝德",
                                                                    "text": "#好耶！谢谢{M#大哥哥}{F#大姐姐}！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230390108",
                                            "text": "我比较特别，不用那么穿。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230390104",
                            "text": "这么说倒也没问题…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303902",
            "objective": "参与赛跑",
            "dialogues": []
        },
        {
            "id": "2303903",
            "objective": "(test)判断小男孩B获胜$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2303904",
            "objective": "与希尔米对话",
            "dialogues": [
                {
                    "id": "230390401",
                    "speaker": "希尔米",
                    "text": "呼…呼…我赢啦！",
                    "choices": [
                        {
                            "id": "230390402",
                            "text": "恭…恭喜你…",
                            "response": [
                                {
                                    "id": "230390404",
                                    "speaker": "希尔米",
                                    "text": "#嘿嘿，我说了很擅长跑步的，{M#大哥哥}{F#大姐姐}难道是轻敌了吗？"
                                },
                                {
                                    "id": "230390405",
                                    "speaker": "奥贝德",
                                    "text": "不过，就算是跑这么快，哈巴奇哥哥还是会抓住我们，到底是为什么呢？",
                                    "choices": [
                                        {
                                            "id": "230390406",
                                            "text": "也许是抄了近路。",
                                            "response": [
                                                {
                                                    "id": "230390408",
                                                    "speaker": "奥贝德",
                                                    "text": "是这样吗？唔…但是这周围好像也没什么近路啊…"
                                                },
                                                {
                                                    "id": "230390409",
                                                    "speaker": "希尔米",
                                                    "text": "#不然，我们下次请{M#大哥哥}{F#大姐姐}来陪我们玩…"
                                                },
                                                {
                                                    "id": "230390410",
                                                    "speaker": "希尔米",
                                                    "text": "陪我们训练！那个…训练那个「野外匿踪」吧！"
                                                },
                                                {
                                                    "id": "230390411",
                                                    "speaker": "奥贝德",
                                                    "text": "对喔，既然跑不过哈巴奇哥哥，那我们就绕开他…"
                                                },
                                                {
                                                    "id": "230390412",
                                                    "speaker": "希尔米",
                                                    "text": "我们之前不都绕过了吗？但是无论如何都会被哈巴奇哥哥发现的啦…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230390407",
                                            "text": "也许是有什么诀窍…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230390403",
                            "text": "跑…跑这么快…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2303905",
            "objective": "与希尔米对话",
            "dialogues": [
                {
                    "id": "230390501",
                    "speaker": "希尔米",
                    "text": "#呼…呼…{M#大哥哥}{F#大姐姐}…跑得好快…",
                    "choices": [
                        {
                            "id": "230390502",
                            "text": "我…我是冒险家嘛…",
                            "response": [
                                {
                                    "id": "230390504",
                                    "speaker": "奥贝德",
                                    "text": "以这种速度，肯定还是会被哈巴奇哥哥赶上的，这可怎么办…"
                                },
                                {
                                    "id": "230390505",
                                    "speaker": "希尔米",
                                    "text": "而且每次哈巴奇哥哥抓住我们的时候都一副很轻松的模样，都根本不像是跑过步的样子。",
                                    "choices": [
                                        {
                                            "id": "230390506",
                                            "text": "也许是抄了近路。",
                                            "response": [
                                                {
                                                    "id": "230390508",
                                                    "speaker": "奥贝德",
                                                    "text": "是这样吗？唔…但是这周围好像也没什么近路啊…"
                                                },
                                                {
                                                    "id": "230390509",
                                                    "speaker": "希尔米",
                                                    "text": "#不然，我们下次请{M#大哥哥}{F#大姐姐}来陪我们玩…"
                                                },
                                                {
                                                    "id": "230390510",
                                                    "speaker": "希尔米",
                                                    "text": "陪我们训练！那个…训练那个「野外匿踪」吧！"
                                                },
                                                {
                                                    "id": "230390511",
                                                    "speaker": "奥贝德",
                                                    "text": "对喔，既然跑不过哈巴奇哥哥，那我们就绕开他…"
                                                },
                                                {
                                                    "id": "230390512",
                                                    "speaker": "希尔米",
                                                    "text": "我们之前不都绕过了吗？但是无论如何都会被哈巴奇哥哥发现的啦…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230390507",
                                            "text": "也许是有什么诀窍…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230390503",
                            "text": "跑…跑得多了…"
                        }
                    ]
                }
            ]
        }
    ]
