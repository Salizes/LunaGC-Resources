    "talks": [
        {
            "id": "49201",
            "objective": "(test)回教堂看看琴的情况$HIDDEN",
            "dialogues": [
                {
                    "id": "4901001",
                    "speaker": "琴",
                    "text": "啊，是你们。",
                    "choices": [
                        {
                            "id": "4901002",
                            "text": "原来你在这里。",
                            "response": [
                                {
                                    "id": "4901004",
                                    "speaker": "琴",
                                    "text": "嗯，我只是…出来透透气。"
                                },
                                {
                                    "id": "4901005",
                                    "speaker": "派蒙",
                                    "text": "琴好像有什么心事？"
                                },
                                {
                                    "id": "4901006",
                                    "speaker": "琴",
                                    "text": "#{NICKNAME}，容我再次感谢…"
                                },
                                {
                                    "id": "4901007",
                                    "speaker": "Player",
                                    "text": "其实我也一直被蒙在鼓里。"
                                },
                                {
                                    "id": "4901008",
                                    "speaker": "琴",
                                    "text": "但是，能这样和大家在一起，不知不觉就打起了精神呢。"
                                },
                                {
                                    "id": "4901011",
                                    "speaker": "琴",
                                    "text": "而且，我也认识到了一件事。"
                                },
                                {
                                    "id": "4901012",
                                    "speaker": "派蒙",
                                    "text": "什么事？"
                                },
                                {
                                    "id": "4901013",
                                    "speaker": "琴",
                                    "text": "比起「狮牙骑士」，果然还是「蒲公英骑士」更适合我。"
                                },
                                {
                                    "id": "4901014",
                                    "speaker": "琴",
                                    "text": "「狮牙骑士」，代表温妮莎为蒙德而斗争的过去…"
                                },
                                {
                                    "id": "4901015",
                                    "speaker": "琴",
                                    "text": "而建立西风骑士团之后的「蒲公英骑士」，代表她所期望的，骑士团的未来…"
                                },
                                {
                                    "id": "4901016",
                                    "speaker": "派蒙",
                                    "text": "温妮莎也一定会为现在的琴加油的！"
                                },
                                {
                                    "id": "4901017",
                                    "speaker": "琴",
                                    "text": "嗯，不论在高天之上，还是身旁的柔风里，温妮莎大人一定都还在注视着我们的。"
                                },
                                {
                                    "id": "4901018",
                                    "speaker": "Player",
                                    "text": "听凭风引。"
                                },
                                {
                                    "id": "4901019",
                                    "speaker": "琴",
                                    "text": "#听凭风引。自由之风会指引前进的路，今后也请与我们同行吧，{NICKNAME}。"
                                }
                            ]
                        },
                        {
                            "id": "4901003",
                            "text": "玩得开心吗？"
                        }
                    ]
                }
            ]
        }
    ]
}