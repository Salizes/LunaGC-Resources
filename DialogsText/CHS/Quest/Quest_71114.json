    "talks": [
        {
            "id": "7111401",
            "objective": "与斡流对话$HIDDEN",
            "dialogues": [
                {
                    "id": "711140101",
                    "speaker": "斡流",
                    "text": "水流的流势不错，周围水域的情况也很正常…真是太好了。"
                },
                {
                    "id": "711140102",
                    "speaker": "斡流",
                    "text": "周围的土质环境也得再观察一下才行。看来，不得不多放一些仪器了。"
                },
                {
                    "id": "711140103",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "711140104",
                    "speaker": "斡流",
                    "text": "旅行者？请你留步，我想请你帮我一个…小忙。"
                },
                {
                    "id": "711140105",
                    "speaker": "斡流",
                    "text": "先自我介绍一下，我叫斡流，是一个「水文学家」，目前正在沉玉谷里搜集和研究水文问题。"
                },
                {
                    "id": "711140106",
                    "speaker": "Player",
                    "text": "研究水文，为什么要观察土质？"
                },
                {
                    "id": "711140107",
                    "speaker": "斡流",
                    "text": "这个问题不错。但想要在这里研究水文，可不能仅仅研究水文。"
                },
                {
                    "id": "711140108",
                    "speaker": "斡流",
                    "text": "山体、水流、地质、天候、还有人们的日常生活，都一同复杂地影响着这里的水文环境。"
                },
                {
                    "id": "711140109",
                    "speaker": "派蒙",
                    "text": "听…听不明白，但感觉这是一件很复杂的事呢…"
                },
                {
                    "id": "711140110",
                    "speaker": "斡流",
                    "text": "确实不算简单。但是和枫丹的水文环境比起来，还是好太多了…"
                },
                {
                    "id": "711140111",
                    "speaker": "斡流",
                    "text": "在枫丹考察的时候，我想要放一个水下的水文勘探装置真是难如登天，要么是被水生动物袭击，要么就被洋流冲走。"
                },
                {
                    "id": "711140112",
                    "speaker": "斡流",
                    "text": "还有那些不知道谁造的水下机关…算了，我真的不想再回忆了…"
                },
                {
                    "id": "711140113",
                    "speaker": "Player",
                    "text": "所以，你要我们帮的忙…"
                },
                {
                    "id": "711140114",
                    "speaker": "斡流",
                    "text": "嗯…也不算是什么大事。我只是想要请你们帮忙把这些监测仪器安置在旁边的山上。"
                },
                {
                    "id": "711140115",
                    "speaker": "斡流",
                    "text": "这些仪器是我刚刚从枫丹订购的机关装置，安置后就会不断向下钻探，直到取出深层的土壤标本。"
                },
                {
                    "id": "711140116",
                    "speaker": "斡流",
                    "text": "有了这些样本，我就可以测算出水文环境对附近山体土质的影响了。"
                },
                {
                    "id": "711140117",
                    "speaker": "Player",
                    "text": "听起来不算复杂。"
                },
                {
                    "id": "711140119",
                    "speaker": "斡流",
                    "text": "话…也不能这么说啦，我听说这附近的野外有盗宝团出没，本来我想雇几位冒险家，可是一直没人接受我的委托…"
                },
                {
                    "id": "711140120",
                    "speaker": "斡流",
                    "text": "不过，看你们的模样，肯定不会怕那些欺软怕硬的盗宝团，对吧？",
                    "choices": [
                        {
                            "id": "711140121",
                            "text": "这件事就交给我吧。",
                            "response": [
                                {
                                    "id": "711140123",
                                    "speaker": "斡流",
                                    "text": "那么，安置仪器的事就交给你们了。只要安置在附近的山坡上就好。"
                                },
                                {
                                    "id": "711140124",
                                    "speaker": "斡流",
                                    "text": "我还要在这里调试仪器，安装好仪器之后，就回来找我吧。"
                                }
                            ]
                        },
                        {
                            "id": "711140122",
                            "text": "他们应该怕我。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7111402",
            "objective": "帮助斡流安置仪器",
            "dialogues": [
                {
                    "id": "711140201",
                    "speaker": "派蒙",
                    "text": "别、别往下看！太高了，安置好仪器之后就快走啦！"
                }
            ]
        },
        {
            "id": "7111403",
            "objective": "帮助斡流安置仪器",
            "dialogues": [
                {
                    "id": "711140301",
                    "speaker": "派蒙",
                    "text": "唔…这里能行吗？算了，我们就相信这台仪器的实力吧。"
                }
            ]
        },
        {
            "id": "7111406",
            "objective": "2/3环任务回滚保护环$HIDDEN",
            "dialogues": [
                {
                    "id": "711140601",
                    "speaker": "斡流",
                    "text": "前面那个位置应该不错，唔…等一下去吊桥附近看看好了…"
                }
            ]
        },
        {
            "id": "7111404",
            "objective": "向斡流回报",
            "dialogues": [
                {
                    "id": "711140401",
                    "speaker": "斡流",
                    "text": "…这么调整应该没问题了。"
                },
                {
                    "id": "711140402",
                    "speaker": "斡流",
                    "text": "旅行者，你们把仪器都安置好了？真是太感谢了。"
                },
                {
                    "id": "711140403",
                    "speaker": "斡流",
                    "text": "等我把这台仪器也安置好，就把报酬结给你们。"
                },
                {
                    "id": "711140404",
                    "speaker": "Player",
                    "text": "刚才直接让我一起安置就好啦。"
                },
                {
                    "id": "711140405",
                    "speaker": "斡流",
                    "text": "多谢你的好意。不过，这台仪器有些特殊，需要调试的地方有些多，要是你来操作的话，实在太麻烦你了。"
                },
                {
                    "id": "711140406",
                    "speaker": "斡流",
                    "text": "我们先去那边的悬崖上把这台仪器安置好，然后我就可以和你们结清报酬了。"
                },
                {
                    "id": "711140407",
                    "speaker": "派蒙",
                    "text": "听起来好复杂…你一直都这样工作的吗？"
                },
                {
                    "id": "711140408",
                    "speaker": "斡流",
                    "text": "现在我只用把仪器安置在陆地上…在有一次考察里，我还不得不想办法把仪器浸到一条大江的中央呢。"
                },
                {
                    "id": "711140409",
                    "speaker": "Player",
                    "text": "不能直接坐船过去吗？"
                },
                {
                    "id": "711140410",
                    "speaker": "斡流",
                    "text": "唉，如果只用把仪器沉进江水里，那我当然可以坐着船，过去把仪器丢进水里，然后就离开…"
                },
                {
                    "id": "711140411",
                    "speaker": "斡流",
                    "text": "但那次考察我要勘测的是水流强度，所以必须把勘测用的特型仪器持续置于水流的中央，不能浮到顶，也不能沉到底…"
                },
                {
                    "id": "711140412",
                    "speaker": "斡流",
                    "text": "还好那条河上面有一座吊桥，要是没吊桥的话，我就只能求人在两座山之间拉一条绳索…"
                },
                {
                    "id": "711140413",
                    "speaker": "斡流",
                    "text": "再把这台仪器用绳索吊起来，用另一条绳索拉着，一直送到河流中心再放下。"
                },
                {
                    "id": "711140414",
                    "speaker": "斡流",
                    "text": "咳…先不说这些了，现在我们也不用处理这种情况…虽然我们等会也要路过一座吊桥。"
                },
                {
                    "id": "711140415",
                    "speaker": "斡流",
                    "text": "这边走吧，那座吊桥离我们不远。"
                }
            ]
        },
        {
            "id": "7111405",
            "objective": "和斡流同行",
            "dialogues": []
        },
        {
            "id": "7111407",
            "objective": "打倒所有盗宝团",
            "dialogues": []
        },
        {
            "id": "7111408",
            "objective": "与刚脱困的人对话",
            "dialogues": [
                {
                    "id": "711140841",
                    "speaker": "Black Screen",
                    "text": "赶走了所有盗宝团后，带着被盗宝团围困的人去到了旁边的亭子里休息…"
                },
                {
                    "id": "711140801",
                    "speaker": "邱老板",
                    "text": "谢谢，太谢谢你了，您…"
                },
                {
                    "id": "711140802",
                    "speaker": "Player",
                    "text": "你是…邱老板？"
                },
                {
                    "id": "711140803",
                    "speaker": "邱老板",
                    "text": "#您、您是{NICKNAME}！怎么遇见您了，这真是…我又欠了您一笔大人情啊！"
                },
                {
                    "id": "711140804",
                    "speaker": "派蒙",
                    "text": "你们不是在枫丹学怎么拍映影吗？怎么突然回璃月了呀？"
                },
                {
                    "id": "711140805",
                    "speaker": "Player",
                    "text": "已经学成了？"
                },
                {
                    "id": "711140806",
                    "speaker": "弈丰",
                    "text": "与其说是学成了…"
                },
                {
                    "id": "711140807",
                    "speaker": "兴晔",
                    "text": "不如说是不得不「先赚钱」啦。"
                },
                {
                    "id": "711140808",
                    "speaker": "邱老板",
                    "text": "你们两个人…"
                },
                {
                    "id": "711140809",
                    "speaker": "弈丰",
                    "text": "热塞尔先生的确非常专业，为我们做出的各种指导也非常有用，但是…"
                },
                {
                    "id": "711140810",
                    "speaker": "兴晔",
                    "text": "他所指导我们拍的映影，都太过注重表现意义和概念，至于具体的事物和情节嘛…"
                },
                {
                    "id": "711140811",
                    "speaker": "弈丰",
                    "text": "用热塞尔先生的话来说，就「让他们退居幕后」了。"
                },
                {
                    "id": "711140812",
                    "speaker": "兴晔",
                    "text": "但我们要拍的可是用来宣传翘英庄茶叶的映影，这么学下去，根本就是南辕北辙嘛，所以…"
                },
                {
                    "id": "711140813",
                    "speaker": "邱老板",
                    "text": "所以！我就决定，暂停学习，先回来拍一部记录映影，用实际的练习来检验我们的学习成果！"
                },
                {
                    "id": "711140814",
                    "speaker": "弈丰",
                    "text": "…也有一部分原因是，我们的资金快用差不多了啦。"
                },
                {
                    "id": "711140815",
                    "speaker": "邱老板",
                    "text": "都、都说了，我已经把事情都计划好了，只要我们拍好这部映影，资金不就回来了吗？"
                },
                {
                    "id": "711140816",
                    "speaker": "弈丰",
                    "text": "#然后，就被盗宝团两头堵在了吊桥上，还好有{NICKNAME}搭救啊。",
                    "choices": [
                        {
                            "id": "711140817",
                            "text": "这里…是不是离翘英庄有点远？",
                            "response": [
                                {
                                    "id": "711140819",
                                    "speaker": "邱老板",
                                    "text": "唉，我这不是想要取一些壮观的景色，放在映影里壮壮声势吗？"
                                },
                                {
                                    "id": "711140820",
                                    "speaker": "邱老板",
                                    "text": "谁知道拍得太入神，被这些盗宝团抓住了空档，我们一路跑到了这里，结果还是被堵住了…"
                                },
                                {
                                    "id": "711140821",
                                    "speaker": "派蒙",
                                    "text": "等等，难道斡流小姐之前说的那几位专业的留影师，就是…"
                                },
                                {
                                    "id": "711140822",
                                    "speaker": "斡流",
                                    "text": "没错，就是邱老板他们。"
                                },
                                {
                                    "id": "711140823",
                                    "speaker": "邱老板",
                                    "text": "斡流小姐，你、你是从哪冒出来的？我刚才都没见到你…"
                                },
                                {
                                    "id": "711140824",
                                    "speaker": "斡流",
                                    "text": "因为我藏得比较好。"
                                },
                                {
                                    "id": "711140825",
                                    "speaker": "Player",
                                    "text": "原来你们都认识啊…"
                                },
                                {
                                    "id": "711140826",
                                    "speaker": "邱老板",
                                    "text": "哎呀，斡流小姐是专业的水文学家，对这附近的地形了如指掌。"
                                },
                                {
                                    "id": "711140827",
                                    "speaker": "邱老板",
                                    "text": "关于取景点这个问题，我们也请教了她很多次。"
                                },
                                {
                                    "id": "711140828",
                                    "speaker": "邱老板",
                                    "text": "我们还想请斡流小姐加入我们的映影团队呢！可她说要等到自己有空的时候再考虑…"
                                },
                                {
                                    "id": "711140829",
                                    "speaker": "弈丰",
                                    "text": "老板，那个…我们刚才跑的时候，好像把装着画片和设备的箱子放在原地了…"
                                },
                                {
                                    "id": "711140830",
                                    "speaker": "兴晔",
                                    "text": "里面…好像还有我们拍了一部分的映影画片…"
                                },
                                {
                                    "id": "711140831",
                                    "speaker": "邱老板",
                                    "text": "……"
                                },
                                {
                                    "id": "711140832",
                                    "speaker": "邱老板",
                                    "text": "#斡流小姐！{NICKNAME}，派蒙，多谢你们了啊！有…有空的话，就来翘英庄找我吧！"
                                },
                                {
                                    "id": "711140833",
                                    "speaker": "邱老板",
                                    "text": "无论怎么说…这救命之恩，多少得为你准备点报酬。"
                                },
                                {
                                    "id": "711140834",
                                    "speaker": "邱老板",
                                    "text": "我们就先告辞了啊！快快快！那个箱子放哪了！快走快走！"
                                },
                                {
                                    "id": "711140835",
                                    "speaker": "Black Screen",
                                    "text": "邱老板一行人急匆匆地离开了…"
                                },
                                {
                                    "id": "711140836",
                                    "speaker": "派蒙",
                                    "text": "感觉…邱老板他们的箱子，真是多灾多难呢…"
                                },
                                {
                                    "id": "711140837",
                                    "speaker": "斡流",
                                    "text": "俗话说「好事多磨」，邱老板一定能拍出很不错的映影。"
                                },
                                {
                                    "id": "711140838",
                                    "speaker": "斡流",
                                    "text": "好了，我先把报酬结给你们吧。等一下我就去安置最后一台仪器，然后…我也会找个时间，去和邱老板聊聊。"
                                },
                                {
                                    "id": "711140839",
                                    "speaker": "斡流",
                                    "text": "不然，他们不知道又要跑去什么地方拍映影了。"
                                },
                                {
                                    "id": "711140840",
                                    "speaker": "斡流",
                                    "text": "唔，他们刚才说，可以去翘英庄找他们吧…等一下我先去那边找找好了。"
                                }
                            ]
                        },
                        {
                            "id": "711140818",
                            "text": "但你们拍翘英庄，来这里做什么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7111409",
            "objective": "在翘英庄寻找邱老板",
            "dialogues": [
                {
                    "id": "711140901",
                    "speaker": "邱老板",
                    "text": "唉，还是先把翘英庄里的景取了吧…",
                    "choices": [
                        {
                            "id": "711140902",
                            "text": "一切都还好吗？",
                            "response": [
                                {
                                    "id": "711140904",
                                    "speaker": "邱老板",
                                    "text": "#{NICKNAME}，派蒙，哎哟！托了你们的福，设备和画片一点没丢。"
                                },
                                {
                                    "id": "711140905",
                                    "speaker": "邱老板",
                                    "text": "不过，我们下次想要去那边取景，看来必须得去雇几个冒险家同行了…"
                                },
                                {
                                    "id": "711140906",
                                    "speaker": "派蒙",
                                    "text": "所以，你们那部关于茶的映影，到底拍得怎么样了呀？"
                                },
                                {
                                    "id": "711140907",
                                    "speaker": "邱老板",
                                    "text": "呃…这部片子处于…"
                                },
                                {
                                    "id": "711140908",
                                    "speaker": "兴晔",
                                    "text": "有一个良好的开头。"
                                },
                                {
                                    "id": "711140909",
                                    "speaker": "弈丰",
                                    "text": "和一个良好的趋势。"
                                },
                                {
                                    "id": "711140910",
                                    "speaker": "Player",
                                    "text": "这不就是才刚开始拍吗？！"
                                },
                                {
                                    "id": "711140911",
                                    "speaker": "邱老板",
                                    "text": "哎呀，我们现在的资金…有点紧张，热塞尔先生的收费就和他的学问一样高超…"
                                },
                                {
                                    "id": "711140912",
                                    "speaker": "邱老板",
                                    "text": "虽然我们也拍了几部小片，赚了几笔小钱，但这种大型记录映影，实在是太花钱了。"
                                },
                                {
                                    "id": "711140913",
                                    "speaker": "兴晔",
                                    "text": "特别是老板还拒绝了几家过来赞助的客商。"
                                },
                                {
                                    "id": "711140914",
                                    "speaker": "弈丰",
                                    "text": "和谢绝了一堆合作邀请。"
                                },
                                {
                                    "id": "711140915",
                                    "speaker": "邱老板",
                                    "text": "你们懂什么！这是为了我们能完全依照我们自己的审美，拍出一部好片。"
                                },
                                {
                                    "id": "711140916",
                                    "speaker": "兴晔",
                                    "text": "但是老板，我们最开始拍片的目的，不也是为了赚钱吗…"
                                },
                                {
                                    "id": "711140917",
                                    "speaker": "邱老板",
                                    "text": "我…你、你们别管这么多，先去把设备支起来！"
                                },
                                {
