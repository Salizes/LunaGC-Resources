    "talks": [
        {
            "id": "7467301",
            "objective": "与乌尔曼对话",
            "dialogues": [
                {
                    "id": "746730101",
                    "speaker": "乌尔曼",
                    "text": "小家伙，我真的不会潜水，你瞧，我连潜水服都没有。"
                },
                {
                    "id": "746730102",
                    "speaker": "乌尔曼",
                    "text": "哎哟…你就算是蹦来蹦去，我也没办法和你一起下去啊…",
                    "choices": [
                        {
                            "id": "746730103",
                            "text": "乌尔曼！你也来枫丹了？",
                            "response": [
                                {
                                    "id": "746730105",
                                    "speaker": "乌尔曼",
                                    "text": "#{NICKNAME}，还有派蒙，居然能在这遇见你们，真是巧了。"
                                },
                                {
                                    "id": "746730106",
                                    "speaker": "派蒙",
                                    "text": "你还是和之前一样，好受仙灵欢迎啊。而且…和仙灵交流得越来越熟练了呢。"
                                },
                                {
                                    "id": "746730107",
                                    "speaker": "Player",
                                    "text": "帮我翻译一下仙灵在说什么。"
                                },
                                {
                                    "id": "746730108",
                                    "speaker": "乌尔曼",
                                    "text": "唉，你们就别笑我了。我哪明白它想说什么啊。"
                                },
                                {
                                    "id": "746730109",
                                    "speaker": "乌尔曼",
                                    "text": "我就是来枫丹做生意，来水边闲逛，突然又被一个小仙灵缠上了。"
                                },
                                {
                                    "id": "746730110",
                                    "speaker": "乌尔曼",
                                    "text": "我早就习惯这种事了，所以就跟着它走，翻过山，越过岭，还划了一会船。"
                                },
                                {
                                    "id": "746730111",
                                    "speaker": "乌尔曼",
                                    "text": "一般来说，它马上就会蹦来蹦去，告诉我这里埋着什么东西了。"
                                },
                                {
                                    "id": "746730112",
                                    "speaker": "乌尔曼",
                                    "text": "但是…它一头扎进了水里，越游越深…"
                                },
                                {
                                    "id": "746730113",
                                    "speaker": "乌尔曼",
                                    "text": "我可不会潜水啊！而且我听人家说，这水里不仅有洋流，还有各种危险的东西…我只能待在船上，等它回来。"
                                },
                                {
                                    "id": "746730114",
                                    "speaker": "乌尔曼",
                                    "text": "但是，那个小家伙还是锲而不舍地带我去各种地方…我真希望它能知道，我是真的不会潜水…",
                                    "choices": [
                                        {
                                            "id": "746730115",
                                            "text": "感受到枫丹的特色了？",
                                            "response": [
                                                {
                                                    "id": "746730116",
                                                    "speaker": "乌尔曼",
                                                    "text": "完全感受到了。真是一个友好、热情、善良，让人流连忘返的国度啊。哈、哈、哈。"
                                                },
                                                {
                                                    "id": "746730119",
                                                    "speaker": "派蒙",
                                                    "text": "那么这么说，你肯定又要拜托我们出马了，对吧？"
                                                },
                                                {
                                                    "id": "746730120",
                                                    "speaker": "乌尔曼",
                                                    "text": "没错！谢天谢地，你们没有被这帮枫丹人影响太深，说话还是这么干净利落。"
                                                },
                                                {
                                                    "id": "746730121",
                                                    "speaker": "乌尔曼",
                                                    "text": "我真是受不了某些亲爱的枫丹人说话时的那股劲头了。"
                                                },
                                                {
                                                    "id": "746730122",
                                                    "speaker": "乌尔曼",
                                                    "text": "平均每二十个词里有两个敬称、三个比喻、六个形容词…",
                                                    "choices": [
                                                        {
                                                            "id": "746730123",
                                                            "text": "我一向是个利落的人。",
                                                            "response": [
                                                                {
                                                                    "id": "746730125",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "见鬼…我觉得自己也被影响了…来！拿着这本笔记，我把那个小家伙带我去的地方都标注好了。"
                                                                },
                                                                {
                                                                    "id": "746730126",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "还是和之前一样，找到古铁钱的话，就拿回来给我，我高价收购。"
                                                                },
                                                                {
                                                                    "id": "746730127",
                                                                    "speaker": "乌尔曼",
                                                                    "text": "#咱们合作愉快，{NICKNAME}，还有派蒙。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "746730124",
                                                            "text": "我在修辞上的造诣确实不深。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746730117",
                                            "text": "我还以为你早就习惯遇见魔物了。",
                                            "response": [
                                                {
                                                    "id": "746730118",
                                                    "speaker": "乌尔曼",
                                                    "text": "我的确习惯了。但是在陆地上遇见魔物的话，我能转身就跑，但在水下遇见魔物，我根本游不动啊！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746730104",
                            "text": "你的「仙灵缘」还是很好啊。"
                        }
                    ]
                }
            ]
        }
    ]
}