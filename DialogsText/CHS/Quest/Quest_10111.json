            "dialogues": []
        },
        {
            "id": "1011102",
            "objective": "寻找杰克与斯坦利",
            "dialogues": [
                {
                    "id": "101110201",
                    "speaker": "派蒙",
                    "text": "咦？他们是——"
                }
            ]
        },
        {
            "id": "1011103",
            "objective": "解救杰克与斯坦利",
            "dialogues": []
        },
        {
            "id": "1011111",
            "objective": "(test)开启地城大门用$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1011104",
            "objective": "(test)与杰克对话$HIDDEN",
            "dialogues": [
                {
                    "id": "101110401",
                    "speaker": "斯坦利",
                    "text": "呼…呼…"
                },
                {
                    "id": "101110402",
                    "speaker": "杰克",
                    "text": "我刚才以为自己会死！"
                },
                {
                    "id": "101110403",
                    "speaker": "温迪",
                    "text": "确实只差一点点了。"
                },
                {
                    "id": "101110404",
                    "speaker": "温迪",
                    "text": "对了，你就是冒险家杰克吧？"
                },
                {
                    "id": "101110405",
                    "speaker": "杰克",
                    "text": "对，请问你是…？"
                },
                {
                    "id": "101110406",
                    "speaker": "派蒙",
                    "text": "我们是来找你的。"
                },
                {
                    "id": "101110407",
                    "speaker": "温迪",
                    "text": "艾琳托我们带个口信给你：今天她没法跟你商量冒险计划了，得改天。"
                },
                {
                    "id": "101110408",
                    "speaker": "杰克",
                    "text": "呃…原来是这样，真不好意思，还麻烦你们到这里来找我…还救了我。"
                },
                {
                    "id": "101110409",
                    "speaker": "斯坦利",
                    "text": "哈！多管闲事！根本就不用救，难道我斯坦利还搞不定这种简单的情况吗？"
                },
                {
                    "id": "101110410",
                    "speaker": "派蒙",
                    "text": "哇，你就是那个名震蒙德、曾经抵达「烬寂海」的传说级大冒险家啊！"
                },
                {
                    "id": "101110411",
                    "speaker": "斯坦利",
                    "text": "没错，我就是斯坦利！"
                },
                {
                    "id": "101110412",
                    "speaker": "温迪",
                    "text": "哈哈，很荣幸见到这种传说级的人物。"
                },
                {
                    "id": "101110413",
                    "speaker": "温迪",
                    "text": "那么各位，现在怎么打算？往前？还是回头？",
                    "choices": [
                        {
                            "id": "101110414",
                            "text": "斯坦利先生怎么想？",
                            "response": [
                                {
                                    "id": "101110415",
                                    "speaker": "斯坦利",
                                    "text": "#哈哈，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_GIRLE]}，跟你们在一起的，可是名震蒙德的大探险家斯坦利啊！"
                                },
                                {
                                    "id": "101110416",
                                    "speaker": "斯坦利",
                                    "text": "难道还有走回头路的必要吗？"
                                },
                                {
                                    "id": "101110419",
                                    "speaker": "温迪",
                                    "text": "全票通过，那就继续前进咯。"
                                }
                            ]
                        },
                        {
                            "id": "101110417",
                            "text": "杰克怎么想？",
                            "response": [
                                {
                                    "id": "101110418",
                                    "speaker": "杰克",
                                    "text": "我们还是继续向前走吧，有斯坦利先生在，一定没问题的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011105",
            "objective": "完成秘境冒险",
            "dialogues": [
                {
                    "id": "101110501",
                    "speaker": "斯坦利",
                    "text": "所以，你们也想来听我讲冒险故事吧？"
                }
            ]
        },
        {
            "id": "1011106",
            "objective": "(test)与温迪对话$HIDDEN",
            "dialogues": [
                {
                    "id": "101110601",
                    "speaker": "温迪",
                    "text": "旅行者，我有一个小小的发现。"
                },
                {
                    "id": "101110602",
                    "speaker": "温迪",
                    "text": "可以请你打开探测仪吗？"
                },
                {
                    "id": "101110603",
                    "speaker": "派蒙",
                    "text": "哎？斯坦利居然也有「幻想朋友」？！"
                },
                {
                    "id": "101110604",
                    "speaker": "温迪",
                    "text": "看起来，他的朋友是一位久经沙场的战士…浑身都是伤痕，表情也十分坚毅。",
                    "choices": [
                        {
                            "id": "101110605",
                            "text": "像是斯坦利描述里的自己。",
                            "response": [
                                {
                                    "id": "101110606",
                                    "speaker": "温迪",
                                    "text": "他的幻想朋友，难道是理想化的自己？"
                                },
                                {
                                    "id": "101110607",
                                    "speaker": "温迪",
                                    "text": "有意思。但，真的是这样吗？"
                                },
                                {
                                    "id": "101110611",
                                    "speaker": "斯坦利",
                                    "text": "那么，我先走咯。"
                                },
                                {
                                    "id": "101110612",
                                    "speaker": "杰克",
                                    "text": "斯坦利先生再见！"
                                },
                                {
                                    "id": "101110613",
                                    "speaker": "杰克",
                                    "text": "二位，请问有空吗？"
                                },
                                {
                                    "id": "101110614",
                                    "speaker": "温迪",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "101110615",
                                    "speaker": "杰克",
                                    "text": "其实，前几天斯坦利先生喝醉酒，说了一些不为人知的秘密给我听。"
                                },
                                {
                                    "id": "101110616",
                                    "speaker": "杰克",
                                    "text": "他当年冒险时用的武器，是大英雄温妮莎的遗物，<color=#00E1FFFF>「辉煌勇气之剑」</color>和<color=#00E1FFFF>「光耀意志之盾」</color>！"
                                },
                                {
                                    "id": "101110617",
                                    "speaker": "杰克",
                                    "text": "说出来怕你们不信，这两件武器现在都还藏在蒙德境内，就在<color=#00E1FFFF>达达乌帕谷</color>哦！"
                                },
                                {
                                    "id": "101110618",
                                    "speaker": "杰克",
                                    "text": "你们这么厉害，能不能陪我去找这两件神器？",
                                    "choices": [
                                        {
                                            "id": "101110619",
                                            "text": "竟然有这么厉害的武器？",
                                            "response": [
                                                {
                                                    "id": "101110620",
                                                    "speaker": "杰克",
                                                    "text": "当然有啊！毕竟那可是斯坦利先生！"
                                                },
                                                {
                                                    "id": "101110623",
                                                    "speaker": "杰克",
                                                    "text": "如果能找到足够厉害的东西证明自己，家里说不定就会支持我做冒险家了…"
                                                },
                                                {
                                                    "id": "101110624",
                                                    "speaker": "杰克",
                                                    "text": "现在我还是能力不足的新人，而且父亲和母亲对我的理想非常反对…"
                                                },
                                                {
                                                    "id": "101110625",
                                                    "speaker": "杰克",
                                                    "text": "所以求求你了，帮帮我吧！"
                                                },
                                                {
                                                    "id": "101110626",
                                                    "speaker": "杰克",
                                                    "text": "我不敢把这个自私的念头说给斯坦利先生听…但我保证，用完马上就还给他！"
                                                },
                                                {
                                                    "id": "101110627",
                                                    "speaker": "派蒙",
                                                    "text": "好可怜…喂，我们就帮帮他吧！",
                                                    "choices": [
                                                        {
                                                            "id": "101110628",
                                                            "text": "好吧。",
                                                            "response": [
                                                                {
                                                                    "id": "101110630",
                                                                    "speaker": "派蒙",
                                                                    "text": "温迪，你来吗？"
                                                                },
                                                                {
                                                                    "id": "101110631",
                                                                    "speaker": "温迪",
                                                                    "text": "这个嘛…嗯…"
                                                                },
                                                                {
                                                                    "id": "101110632",
                                                                    "speaker": "杰克",
                                                                    "text": "前年我托人搞来一瓶珍贵名酒，只要帮我找到神器，酒就归你！"
                                                                },
                                                                {
                                                                    "id": "101110633",
                                                                    "speaker": "温迪",
                                                                    "text": "<color=#00E1FFFF>达达乌帕谷</color>对吧？！事不宜迟，我们现在就动身！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "101110629",
                                                            "text": "不能视而不见吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "101110621",
                                            "text": "他把神器随便丢在野外？",
                                            "response": [
                                                {
                                                    "id": "101110622",
                                                    "speaker": "杰克",
                                                    "text": "厉害的人总是有些怪癖嘛！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "101110608",
                            "text": "说起来，他的故事也有点奇怪…",
                            "response": [
                                {
                                    "id": "101110609",
                                    "speaker": "温迪",
                                    "text": "哦？你也觉得有问题吗？"
                                },
                                {
                                    "id": "101110610",
                                    "speaker": "温迪",
                                    "text": "看来，斯坦利的故事还有隐情。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1011009",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "101100919",
                    "speaker": "艾琳",
                    "text": "那就拜托你们了！"
                },
                {
                    "id": "101100920",
                    "speaker": "艾琳",
                    "text": "杰克在<color=#00E1FFFF>南风之狮的庙宇</color>，别忘了哦。"
                }
            ]
        }
    ]
}