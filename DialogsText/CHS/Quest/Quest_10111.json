            "dialogues": [
                {
                    "id": "101110101",
                    "speaker": "派蒙",
                    "text": "南风之狮的庙宇…之前为了「风魔龙事件」，我们探索过这里吧。"
                }
            ]
        },
        {
            "id": "1011107",
