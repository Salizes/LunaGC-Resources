    "talks": [
        {
            "id": "7305901",
            "objective": "到达无郁稠林",
            "dialogues": [
                {
                    "id": "730590101",
                    "speaker": "海亚姆",
                    "text": "「石榴歌唱，苹果鼓掌…」"
                },
                {
                    "id": "730590102",
                    "speaker": "派蒙",
                    "text": "你好呀，海亚姆先生！你怎么在这里？"
                },
                {
                    "id": "730590103",
                    "speaker": "海亚姆",
                    "text": "哦哦，你好，你好。白色的小朋友，和…唉…抱歉，孩子，我的脑袋不太清楚了，时间稍微一长就记不住名字…"
                },
                {
                    "id": "730590104",
                    "speaker": "Player",
                    "text": "#叫我{NICKNAME}就好。"
                },
                {
                    "id": "730590105",
                    "speaker": "海亚姆",
                    "text": "哈哈…好啊，你们就是之前…"
                },
                {
                    "id": "730590106",
                    "speaker": "派蒙",
                    "text": "对！我们就是那两个「杰万」——勇敢的年轻人！"
                },
                {
                    "id": "730590107",
                    "speaker": "海亚姆",
                    "text": "嗯…所以，告诉我，「兰那罗」，他们还记得我吗？还记得我们所有人吗？"
                },
                {
                    "id": "730590108",
                    "speaker": "派蒙",
                    "text": "欸…这个…",
                    "choices": [
                        {
                            "id": "730590109",
                            "text": "他们还记得你。",
                            "response": [
                                {
                                    "id": "730590110",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "730590111",
                                    "speaker": "海亚姆",
                                    "text": "这样啊…但我看不到他们了，也听不到他们如何想念我…真是遗憾。"
                                },
                                {
                                    "id": "730590114",
                                    "speaker": "海亚姆",
                                    "text": "呵呵…我看不到他们了。我太老了，看不到他们的样子，听不到他们的声音…错过了，都错过了。"
                                },
                                {
                                    "id": "730590115",
                                    "speaker": "海亚姆",
                                    "text": "咳咳…抱歉，我先离开了。或许只有期待奇迹了吧…"
                                },
                                {
                                    "id": "730590116",
                                    "speaker": "海亚姆",
                                    "text": "奇迹不能去理解，不能去追求，只能等待呀。"
                                },
                                {
                                    "id": "730590117",
                                    "speaker": "Black Screen",
                                    "text": "海亚姆蹒跚着离开了…"
                                }
                            ]
                        },
                        {
                            "id": "730590112",
                            "text": "他们不记得你了。",
                            "response": [
                                {
                                    "id": "730590113",
                                    "speaker": "派蒙",
                                    "text": "但是…我们还可以和他们重新交朋友呀！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7305902",
            "objective": "和海亚姆对话",
            "dialogues": []
        },
        {
            "id": "7305904",
            "objective": "（test）刷新group专用$HIDDEN",
            "dialogues": [
                {
                    "id": "730590401",
                    "speaker": "兰纳迦",
                    "text": "你好，金色的那菈和白飞飞。"
                },
                {
                    "id": "730590402",
                    "speaker": "兰纳迦",
                    "text": "谢谢你们，虽然回不来了，以前的记忆…但可以信任的朋友，你们是的。"
                }
            ]
        },
        {
            "id": "7305903",
            "objective": "和兰那罗们对话",
            "dialogues": [
                {
                    "id": "730590201",
                    "speaker": "兰纳真",
                    "text": "兰纳迦，他来啦，他们来啦！"
                },
                {
                    "id": "730590202",
                    "speaker": "兰迦鲁",
                    "text": "嗯嗯，来啦，来啦！"
                },
                {
                    "id": "730590203",
                    "speaker": "兰纳迦",
                    "text": "#来啦，那菈{NICKNAME}，白色的飞飞。欢迎你们，我们三个。"
                },
                {
                    "id": "730590204",
                    "speaker": "兰纳迦",
                    "text": "到了，月亮。到啦，种下花朵的时刻。你们准备好了吗？"
                },
                {
                    "id": "730590205",
                    "speaker": "Player",
                    "text": "我准备好了。"
                },
                {
                    "id": "730590206",
                    "speaker": "派蒙",
                    "text": "嗯，我也是！"
                },
                {
                    "id": "730590207",
                    "speaker": "兰纳迦",
                    "text": "那么…兰纳真，兰迦鲁，我们开始仪式吧。"
                },
                {
                    "id": "730590208",
                    "speaker": "兰纳迦",
                    "text": "「归去，归去，花园的梦，森林的记忆…」"
                },
                {
                    "id": "730590209",
                    "speaker": "兰纳真",
                    "text": "「迎接吧，让我们：」"
                },
                {
                    "id": "730590210",
                    "speaker": "兰纳真",
                    "text": "「渐浓的睡梦，不散的欢欣。」"
                },
                {
                    "id": "730590211",
                    "speaker": "兰迦鲁",
                    "text": "「庆贺呀，让我们：」"
                },
                {
                    "id": "730590212",
                    "speaker": "兰迦鲁",
                    "text": "「石榴歌唱，苹果鼓掌！」"
                },
                {
                    "id": "730590213",
                    "speaker": "Black Screen",
                    "text": "兰那罗们种下干瘪的花朵，随着歌谣在风中回荡，花朵奇迹般地重返了新生…"
                },
                {
                    "id": "730590214",
                    "speaker": "派蒙",
                    "text": "哇…这三朵花，又活过来了！"
                },
                {
                    "id": "730590215",
                    "speaker": "兰纳迦",
                    "text": "是呀，因为…是慈悯的，「无郁夷摩」。所以，她要让记忆有重新焕发的机会。"
                },
                {
                    "id": "730590216",
                    "speaker": "兰纳真",
                    "text": "嗯！即使我们不再记得你们啦，记忆也会…唔，融进叶脉和根系中间，变成绿叶，变成年轮！"
                },
                {
                    "id": "730590217",
                    "speaker": "兰迦鲁",
                    "text": "或者变成肉肉的虫虫，给别的虫虫吃，别的虫虫留下滋养草木的东西，让我们全都长大大！"
                },
                {
                    "id": "730590218",
                    "speaker": "派蒙",
                    "text": "可是…你们还是不记得我们了，对吗？"
                },
                {
                    "id": "730590219",
                    "speaker": "兰纳迦",
                    "text": "嗯…因为，并不专属于你我，记忆…过去经历的事情，我们，已经分给了森林里的所有草木…"
                },
                {
                    "id": "730590220",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "730590221",
                    "speaker": "兰纳真",
                    "text": "但是没关系呀，我们已经是新的朋友了，对吧！"
                },
                {
                    "id": "730590222",
                    "speaker": "兰迦鲁",
                    "text": "嗯！新朋友！"
                }
            ]
        },
        {
            "id": "7305903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730590301",
                    "speaker": "兰纳真",
                    "text": "你好！新朋友！"
                },
                {
                    "id": "730590302",
                    "speaker": "兰纳真",
                    "text": "希望你能一直记得，我们的歌！"
                }
            ]
        },
        {
            "id": "7305905",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "730590501",
                    "speaker": "兰迦鲁",
                    "text": "#谢谢你们！那菈{NICKNAME}和白飞飞！"
                },
                {
                    "id": "730590502",
                    "speaker": "兰迦鲁",
                    "text": "以后也要一起玩呀！"
                }
            ]
        }
    ]
}