            "dialogues": []
        },
        {
            "id": "2007001",
            "objective": "回收洞窟附近的包裹",
            "dialogues": [
                {
                    "id": "200700101",
                    "speaker": "芙萝拉",
                    "text": "之前存在雪山上的花怎么样啦？"
                },
                {
                    "id": "200700102",
                    "speaker": "Player",
                    "text": "只拿到一份…"
                },
                {
                    "id": "200700103",
                    "speaker": "芙萝拉",
                    "text": "其他的花是没能取回来吗？唔…好吧，毕竟雪山里的情况，确实很难预料呢。"
                },
                {
                    "id": "200700104",
                    "speaker": "芙萝拉",
                    "text": "但只有这一份的话，就没法对比着看了，只能以后再找机会了…"
                },
                {
                    "id": "200700105",
                    "speaker": "芙萝拉",
                    "text": "这次辛苦你帮忙，这是给你准备的报酬哦，以后说不定还要麻烦你。"
                }
            ]
        },
        {
            "id": "2007006",
            "objective": "循着踪迹寻找包裹",
            "dialogues": []
        },
        {
            "id": "2007003",
            "objective": "击败盗宝团",
            "dialogues": [
                {
                    "id": "200700301",
                    "speaker": "芙萝拉",
                    "text": "之前存在雪山上的花怎么样啦？"
                },
                {
                    "id": "200700302",
                    "speaker": "Player",
                    "text": "加上这次的都在这里了。"
                },
                {
                    "id": "200700303",
                    "speaker": "芙萝拉",
                    "text": "都拿到了吗 ？太好了，快给我看看。"
                },
                {
                    "id": "200700304",
                    "speaker": "芙萝拉",
                    "text": "呼呼，看起来不错呀，嗯…看来这个方法确实可行。"
                },
                {
                    "id": "200700305",
                    "speaker": "芙萝拉",
                    "text": "不过，雪山距离蒙德城有些太远了，总不能每次都麻烦你，以后得想个方便的办法才行…"
                },
                {
                    "id": "200700306",
                    "speaker": "芙萝拉",
                    "text": "总之，谢谢你来帮忙呀，这些是给你的谢礼，请拿着吧。"
                }
            ]
        },
        {
            "id": "2007012",
            "objective": "（隐藏）检测玩家是否有破坏雪堆$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2007007",
            "objective": "向芙萝拉道歉",
            "dialogues": [
                {
                    "id": "200700201",
                    "speaker": "芙萝拉",
                    "text": "花怎么样啦？"
                },
                {
                    "id": "200700202",
                    "speaker": "Player",
                    "text": "对不起…"
                },
                {
                    "id": "200700203",
                    "speaker": "芙萝拉",
                    "text": "嗯？怎么了？"
                },
                {
                    "id": "200700204",
                    "speaker": "Player",
                    "text": "我不小心把盒子和花弄坏了…"
                },
                {
                    "id": "200700205",
                    "speaker": "芙萝拉",
                    "text": "弄、弄坏了？！"
                },
                {
                    "id": "200700206",
                    "speaker": "芙萝拉",
                    "text": "呜…那可是我专门挑出来的花，那么好的花，可不是能轻易找到的…"
                },
                {
                    "id": "200700207",
                    "speaker": "芙萝拉",
                    "text": "雪山真有这么危险吗？连你这样的冒险家都会失手，连一盒花都…"
                },
                {
                    "id": "200700208",
                    "speaker": "芙萝拉",
                    "text": "不过，还是谢谢你帮我跑这一趟，这些东西给你，请收下吧，我要去打理店里的花了。"
                },
                {
                    "id": "200700209",
                    "speaker": "芙萝拉",
                    "text": "唉，不然…我还是再用莎拉小姐的办法试试吧…"
                }
            ]
        },
