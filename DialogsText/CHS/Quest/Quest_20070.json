    "talks": [
        {
            "id": "2007015",
            "objective": "与芙萝拉对话",
            "dialogues": [
                {
                    "id": "200700501",
                    "speaker": "芙萝拉",
                    "text": "这边这边，来这边。"
                },
                {
                    "id": "200700502",
                    "speaker": "芙萝拉",
                    "text": "你还记得上次我拜托你放进雪山的那些花吗？"
                },
                {
                    "id": "200700503",
                    "speaker": "芙萝拉",
                    "text": "现在已经过了一天了，我想要看看冷藏的效果。"
                },
                {
                    "id": "200700504",
                    "speaker": "芙萝拉",
                    "text": "你愿意帮我去雪山上，把那些花拿回来吗？",
                    "choices": [
                        {
                            "id": "200700505",
                            "text": "交给我吧",
                            "response": [
                                {
                                    "id": "200700506",
                                    "speaker": "芙萝拉",
                                    "text": "那就拜托你啦，我就在这里等你，请快去快回吧。"
                                }
                            ]
                        },
                        {
                            "id": "200700507",
                            "text": "我放哪了来着…",
                            "response": [
                                {
                                    "id": "200700508",
                                    "speaker": "芙萝拉",
                                    "text": "你不记得了吗？是<color=#00E1FFFF>七天神像旁边</color>，<color=#00E1FFFF>山里的水边</color>，还有一个<color=#00E1FFFF>洞窟附近</color>哦。"
                                },
                                {
                                    "id": "200700509",
                                    "speaker": "芙萝拉",
                                    "text": "我再帮你在地图上标记一次吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
