    "talks": [
        {
            "id": "7224601",
            "objective": "自然日刷新（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722460101",
                    "speaker": "墨田",
                    "text": "好漂亮的镯子！好漂亮的花瓶！璃月的东西真漂亮！"
                },
                {
                    "id": "722460102",
                    "speaker": "墨田",
                    "text": "…啊，不行。这么匮乏的用词，实在是愧对小说家的身份哪。"
                },
                {
                    "id": "722460103",
                    "speaker": "墨田",
                    "text": "买个巧夺天工的瓷瓶，用来当做下一部小说的参考好了…"
                },
                {
                    "id": "722460104",
                    "speaker": "墨田",
                    "text": "嗯…写个这样的情节吧！"
                },
                {
                    "id": "722460105",
                    "speaker": "墨田",
                    "text": "「扭转局面的关键，竟然是藏在花瓶里的神之眼…！」"
                },
                {
                    "id": "722460106",
                    "speaker": "墨田",
                    "text": "感觉很有意思呢！你觉得呢，阿釜？"
                },
                {
                    "id": "722460107",
                    "speaker": "阿釜",
                    "text": "我没什么所…"
                },
                {
                    "id": "722460108",
                    "speaker": "阿釜",
                    "text": "……"
                },
                {
                    "id": "722460109",
                    "speaker": "阿釜",
                    "text": "…我个人觉得，给「花瓶」的笔墨要控制好。描写过度的话，意图会被察觉到。但描写有所欠缺的话，最后又会显得太过突兀。"
                },
                {
                    "id": "722460110",
                    "speaker": "墨田",
                    "text": "哦哦，你说得很对！我记一下…"
                },
                {
                    "id": "722460111",
                    "speaker": "墨田",
                    "text": "啊，抱歉抱歉！我们换个地方吧。"
                },
                {
                    "id": "722460112",
                    "speaker": "墨田",
                    "text": "还有，说了多少次了，别叫我大人了——"
                },
                {
                    "id": "722460113",
                    "speaker": "墨田",
                    "text": "嗯？仔细一想，看起来很普通的两名旅人，其中一位将另一位称为「大人」，也是常见的情节…"
                }
            ]
        },
        {
            "id": "7224602",
            "objective": "璃月纪念品商店（test）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7224604",
            "objective": "（test'）闲置对话$HIDDEN",
            "dialogues": [
                {
                    "id": "722460401",
                    "speaker": "墨田",
                    "text": "「世界如此宽广…」"
                },
                {
                    "id": "722460402",
                    "speaker": "阿釜",
                    "text": "是《净琉璃机动队》吗？"
                },
                {
                    "id": "722460403",
                    "speaker": "墨田",
                    "text": "嗯。阿釜你的记性，很不错嘛。"
                },
                {
                    "id": "722460404",
                    "speaker": "阿釜",
                    "text": "是您跟我说过的故事。"
                }
            ]
        },
        {
            "id": "7224603",
            "objective": "蒙德图书馆（test）$HIDDEN",
            "dialogues": [
                {
                    "id": "722460201",
                    "speaker": "墨田",
                    "text": "呼啊——真是太愉快了——"
                },
                {
                    "id": "722460202",
                    "speaker": "墨田",
                    "text": "该说真不愧是北陆最大的图书馆吗！竟然能有机会一口气把《少女薇拉的忧郁》看完！痛快痛快！"
                },
                {
                    "id": "722460203",
                    "speaker": "阿釜",
                    "text": "墨田大人，小声一点。"
                },
                {
                    "id": "722460204",
                    "speaker": "墨田",
                    "text": "啊，不好意思。实在是太让人激动了嘛…"
                },
                {
                    "id": "722460205",
                    "speaker": "阿釜",
                    "text": "不，我是怕您受伤。那个司书小姐有着强者的威压感…"
                },
                {
                    "id": "722460206",
                    "speaker": "墨田",
                    "text": "欸？是吗？我倒觉得是个有些懒散的，典型的魔女…"
                },
                {
                    "id": "722460207",
                    "speaker": "墨田",
                    "text": "…仔细想想，一般这样的角色才是最强的。不好不好，绝对不能激怒她…"
                },
                {
                    "id": "722460208",
                    "speaker": "墨田",
                    "text": "啊，对了。有道理。下次就以这样的角色为中心，写一篇作品好了。《大图书馆的魔法师》…"
                },
                {
                    "id": "722460209",
                    "speaker": "Player",
                    "text": "你们的旅行如何了？"
                },
                {
                    "id": "722460210",
                    "speaker": "阿釜",
                    "text": "好久不见。"
                },
                {
                    "id": "722460211",
                    "speaker": "墨田",
                    "text": "#欸，是传说中的{NICKNAME}…"
                },
                {
                    "id": "722460212",
                    "speaker": "墨田",
                    "text": "旅行啊…以前我也常常外出旅行取材。"
                },
                {
                    "id": "722460213",
                    "speaker": "墨田",
                    "text": "「为了描写雷灾而前往无想刃狭间」、「为了描写蛇妖而去蛇神之首」、「为了描写逐电者的生活而请阿釜参军」…"
                },
                {
                    "id": "722460214",
                    "speaker": "Player",
                    "text": "阿釜真不容易…"
                },
                {
                    "id": "722460215",
                    "speaker": "阿釜",
                    "text": "没什么大不了的。"
                },
                {
                    "id": "722460216",
                    "speaker": "墨田",
                    "text": "但是，这次是真正的旅行，漫无目的的远游。"
                },
                {
                    "id": "722460217",
                    "speaker": "墨田",
                    "text": "我才发现，值得写的、有趣的故事，真是太多了。就像《纪野之旅》一样。"
                },
                {
                    "id": "722460218",
                    "speaker": "墨田",
                    "text": "我和阿釜一起寻访本地人推荐的景点与店铺。然后，在野外露营时，与陌生的旅人分享篝火与故事…"
                },
                {
                    "id": "722460219",
                    "speaker": "墨田",
                    "text": "醒来的时候，发现旅资都被偷走了…"
                },
                {
                    "id": "722460220",
                    "speaker": "Player",
                    "text": "…没问题吗？"
                },
                {
                    "id": "722460221",
                    "speaker": "墨田",
                    "text": "没问题的。找到那些盗贼，发现他们有十几个人的时候，我还以为没办法拿回来了。"
                },
                {
                    "id": "722460222",
                    "speaker": "墨田",
                    "text": "但阿釜竟然设法说服了他们，把钱全都拿回来了，还附带了很多有乌鸦纹样的纪念币！"
                },
                {
                    "id": "722460223",
                    "speaker": "墨田",
                    "text": "明明感觉可以写成有趣的情节，但阿釜就是不愿意告诉我过程。",
                    "choices": [
                        {
                            "id": "722460224",
                            "text": "……",
                            "response": [
                                {
                                    "id": "722460226",
                                    "speaker": "阿釜",
                                    "text": "是我应该做的。墨田大人不必挂心。"
                                },
                                {
                                    "id": "722460227",
                                    "speaker": "墨田",
                                    "text": "不，阿釜真的很可靠！"
                                },
                                {
                                    "id": "722460228",
                                    "speaker": "墨田",
                                    "text": "和你在一起，就算旅行到世界尽头也不会有什么问题吧！"
                                },
                                {
                                    "id": "722460229",
                                    "speaker": "墨田",
                                    "text": "而且，总感觉，自从鹤观以来，你变了很多呢。会有想做的事了，也会提出质疑与观点…"
                                },
                                {
                                    "id": "722460230",
                                    "speaker": "阿釜",
                                    "text": "如果墨田大人觉得不妥当的话…"
                                },
                                {
                                    "id": "722460231",
                                    "speaker": "墨田",
                                    "text": "我觉得很好喔！你的看法，都相当值得参考。",
                                    "choices": [
                                        {
                                            "id": "722460232",
                                            "text": "那么，我就不打扰了。",
                                            "response": [
                                                {
                                                    "id": "722460234",
                                                    "speaker": "墨田",
                                                    "text": "#嗯。再见，{NICKNAME}。就让我们像《菲谢尔皇女夜谭》里那样，相约在一切的尽头再会吧。"
                                                },
                                                {
                                                    "id": "722460235",
                                                    "speaker": "阿釜",
                                                    "text": "#{NICKNAME}，谢谢你。要多保重。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722460233",
                                            "text": "或许我们会在别的地方再会吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722460225",
                            "text": "阿釜真有本领。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7224603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722460301",
                    "speaker": "阿釜",
                    "text": "墨田大人对之后的目的地，有计划吗？"
                },
                {
                    "id": "722460302",
                    "speaker": "墨田",
                    "text": "嗯——这么说来，听说蒙德城里有一座很大的图书馆…"
                }
            ]
        }
    ]
}