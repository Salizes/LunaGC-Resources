    "talks": [
        {
            "id": "800501",
            "objective": "前往调查遗迹，寻找路线",
            "dialogues": [
                {
                    "id": "80050101",
                    "speaker": "派蒙",
                    "text": "这边有一些丘丘人生活的痕迹，会是委托里涉及到的那些丘丘人吗？"
                },
                {
                    "id": "80050102",
                    "speaker": "戴因斯雷布",
                    "text": "委托？说起来，你们还没告诉我…为何你们会出现在这里，一般的旅行者可没理由涉足层岩巨渊之下。"
                },
                {
                    "id": "80050103",
                    "speaker": "派蒙",
                    "text": "我们是接到冒险家协会的委托，来调查层岩巨渊内丘丘人反常聚集的事件的。"
                },
                {
                    "id": "80050104",
                    "speaker": "派蒙",
                    "text": "一路下来，终于在这里发现了线索…"
                },
                {
                    "id": "80050105",
                    "speaker": "戴因斯雷布",
                    "text": "你们想要答案？"
                },
                {
                    "id": "80050106",
                    "speaker": "派蒙",
                    "text": "欸？戴因知道些什么吗？"
                },
                {
                    "id": "80050107",
                    "speaker": "戴因斯雷布",
                    "text": "碰巧知道。",
                    "choices": [
                        {
                            "id": "80050108",
                            "text": "我怎么没发现？",
                            "response": [
                                {
                                    "id": "80050110",
                                    "speaker": "戴因斯雷布",
                                    "text": "你们无法察觉异样也情有可原。此地的怪异，其实在于…"
                                },
                                {
                                    "id": "80050111",
                                    "speaker": "戴因斯雷布",
                                    "text": "…这里的环境正在削弱「诅咒」的效果。"
                                },
                                {
                                    "id": "80050112",
                                    "speaker": "派蒙",
                                    "text": "诅咒！我记得之前说过，戴因作为坎瑞亚的国民，身中不死诅咒什么的…"
                                },
                                {
                                    "id": "80050113",
                                    "speaker": "戴因斯雷布",
                                    "text": "几百年来，诅咒带来的苦痛依旧每天都在纠缠我。而来到此地，身体却感觉得到了片刻的喘息。"
                                },
                                {
                                    "id": "80050114",
                                    "speaker": "戴因斯雷布",
                                    "text": "此时此刻，我的身体也正在向我表达着强烈的意愿，那就是——「留下来」。"
                                },
                                {
                                    "id": "80050115",
                                    "speaker": "派蒙",
                                    "text": "削弱诅咒…这里为什么会有这样神奇的效果呢？"
                                },
                                {
                                    "id": "80050116",
                                    "speaker": "戴因斯雷布",
                                    "text": "这也是我想要查明的，不过据我所知，深渊教团还尚未拥有实现类似效果的技术。",
                                    "choices": [
                                        {
                                            "id": "80050117",
                                            "text": "也就是说…",
                                            "response": [
                                                {
                                                    "id": "80050119",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "嗯，你知道为何丘丘人都戴着面具么？",
                                                    "choices": [
                                                        {
                                                            "id": "80050120",
                                                            "text": "我有所了解。",
                                                            "response": [
                                                                {
                                                                    "id": "80050122",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "因为它们都在回避着自己如今的面貌，害怕着水中的倒影…"
                                                                },
                                                                {
                                                                    "id": "80050123",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "毕竟那和它们记忆中的自己相比，太过丑陋，也太过绝望了。"
                                                                },
                                                                {
                                                                    "id": "80050124",
                                                                    "speaker": "Player",
                                                                    "text": "果然丘丘人也是…"
                                                                },
                                                                {
                                                                    "id": "80050125",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "不死诅咒其实…也并非真正永久的「不死」。"
                                                                },
                                                                {
                                                                    "id": "80050126",
                                                                    "speaker": "派蒙",
                                                                    "text": "难道还有逆转的机会吗？"
                                                                },
                                                                {
                                                                    "id": "80050127",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "不。而是在「磨损」的作用下，灵魂与肉体依旧会被消磨殆尽，哪怕不是以「死亡」这一形式。"
                                                                },
                                                                {
                                                                    "id": "80050128",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "当那些丘丘人意识到自我的终结将至，似乎会本能地找寻一个安静又黑暗的角落，与几百年来的苦痛道别。"
                                                                },
                                                                {
                                                                    "id": "80050129",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "而能够削弱诅咒效果的此地，对它们来说一定是最好的灵柩吧。"
                                                                },
                                                                {
                                                                    "id": "80050130",
                                                                    "speaker": "派蒙",
                                                                    "text": "居然…会是这样…"
                                                                },
                                                                {
                                                                    "id": "80050131",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "闲聊到此为止，警戒！"
                                                                },
                                                                {
                                                                    "id": "80050132",
                                                                    "speaker": "派蒙",
                                                                    "text": "怎么、怎么了！"
                                                                },
                                                                {
                                                                    "id": "80050133",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "敌袭。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80050121",
                                                            "text": "我不太清楚…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80050118",
                                            "text": "来到此处的丘丘人…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80050109",
                            "text": "和那座倒着的城市有关么？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800502",
            "objective": "击败黑蛇骑士",
            "dialogues": []
        },
        {
            "id": "800503",
            "objective": "与戴因斯雷布对话",
            "dialogues": [
                {
                    "id": "80050301",
                    "speaker": "派蒙",
                    "text": "刚才那些是…为什么忽然袭击我们？"
                },
                {
                    "id": "80050302",
                    "speaker": "戴因斯雷布",
                    "text": "「黑蛇骑士」，曾隶属于坎瑞亚宫廷卫队。"
                },
                {
                    "id": "80050303",
                    "speaker": "派蒙",
                    "text": "等等！宫廷卫队…他们曾经是你的下属吗！？"
                },
                {
                    "id": "80050304",
                    "speaker": "戴因斯雷布",
                    "text": "曾经是。可如今他们身上那强烈的诅咒气息，还有舍弃了所有荣耀的战斗方式…"
                },
                {
                    "id": "80050305",
                    "speaker": "派蒙",
                    "text": "…已经是深渊的爪牙了吗？"
                },
                {
                    "id": "80050306",
                    "speaker": "戴因斯雷布",
                    "text": "…先前进吧。"
                },
                {
                    "id": "80050307",
                    "speaker": "派蒙",
                    "text": "啊，戴因…"
                },
                {
                    "id": "80050308",
                    "speaker": "戴因斯雷布",
                    "text": "嗯？"
                },
                {
                    "id": "80050309",
                    "speaker": "？？？",
                    "text": "……"
                },
                {
                    "id": "80050310",
                    "speaker": "戴因斯雷布",
                    "text": "漏了一个么…"
                },
                {
                    "id": "80050311",
                    "speaker": "？？？",
                    "text": "……"
                },
                {
                    "id": "80050312",
                    "speaker": "戴因斯雷布",
                    "text": "等等，你们先退后，他似乎有所不同…"
                },
                {
                    "id": "80050313",
                    "speaker": "戴因斯雷布",
                    "text": "…消失了。"
                },
                {
                    "id": "80050314",
                    "speaker": "派蒙",
                    "text": "怎么回事，那个黑蛇骑士！难道是有话想说吗？"
                },
                {
                    "id": "80050315",
                    "speaker": "戴因斯雷布",
                    "text": "（怎么会…没有「那个东西」的话，如何能在五百年间保持自我意识…）"
                },
                {
                    "id": "80050316",
                    "speaker": "戴因斯雷布",
                    "text": "（还有令人在意的，莫名熟悉的气息…）"
                },
                {
                    "id": "80050317",
                    "speaker": "Player",
                    "text": "或许他认出了你。"
                },
                {
                    "id": "80050318",
                    "speaker": "戴因斯雷布",
                    "text": "如此绝望的灾变之中，本不应该诞生这种奇迹才对…就当是巧合吧。"
                },
                {
                    "id": "80050319",
                    "speaker": "戴因斯雷布",
                    "text": "我们继续前进，往那座「城市」的方向。"
                }
            ]
        },
        {
            "id": "800504",
            "objective": "前往遗迹入口处",
            "dialogues": [
                {
                    "id": "80050401",
                    "speaker": "派蒙",
                    "text": "好像有股奇怪的力量包围着这座城市，没法继续前进了。"
                },
                {
                    "id": "80050402",
                    "speaker": "派蒙",
                    "text": "按理说，附近应该有什么机关之类的？旅行者，拿出我们以前探索遗迹的本领吧？",
                    "choices": [
                        {
                            "id": "80050403",
                            "text": "看来又是解谜环节了。",
                            "response": [
                                {
                                    "id": "80050405",
                                    "speaker": "戴因斯雷布",
                                    "text": "不必浪费时间。"
                                },
                                {
                                    "id": "80050406",
                                    "speaker": "派蒙",
                                    "text": "欸！？"
                                },
                                {
                                    "id": "80050407",
                                    "speaker": "戴因斯雷布",
                                    "text": "坎瑞亚的技术，深渊力量的气息…再熟悉不过了。这些事物在我眼里，不过是虚幻的泡沫。"
                                },
                                {
                                    "id": "80050408",
                                    "speaker": "派蒙",
                                    "text": "我明白了！果然，深渊教团是想隐藏什么秘密吧？"
                                },
                                {
                                    "id": "80050409",
                                    "speaker": "派蒙",
                                    "text": "唔…戴因这家伙刚才表现得那么了解内情，难怪会被深渊教团针对呢。",
                                    "choices": [
                                        {
                                            "id": "80050410",
                                            "text": "这座倒立的城市与坎瑞亚有关么？",
                                            "response": [
                                                {
                                                    "id": "80050412",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "恐怕没有必然联系。走得越近，我越能确定，这些遗迹来源于更加古早的文明。"
                                                },
                                                {
                                                    "id": "80050413",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "只是被深渊教团捷足先登了而已。"
                                                },
                                                {
                                                    "id": "80050414",
                                                    "speaker": "派蒙",
                                                    "text": "更加古早的文明！唔…想象不出来…"
                                                },
                                                {
                                                    "id": "80050415",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "不过这里的建筑结构的确与过去的坎瑞亚有些相似，嗯…正过来会更像。"
                                                },
                                                {
                                                    "id": "80050416",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "走吧，那里有亮光。千万注意别从前面的平台上失足掉下去。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80050411",
                                            "text": "这座倒立的城市与深渊教团有关么？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80050404",
                            "text": "我在附近先找找线索。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800520",
            "objective": "",
            "dialogues": [
                {
                    "id": "80052001",
                    "speaker": "派蒙",
                    "text": "不是什么深渊教团的秘密，被守护着的…竟然只是一些快要迎来终结的丘丘人。"
                },
                {
                    "id": "80052002",
                    "speaker": "派蒙",
                    "text": "还是不要打搅它们了吧。"
                }
            ]
        },
        {
            "id": "800505",
            "objective": "前往遗迹中有光亮的房间",
            "dialogues": [
                {
                    "id": "80050501",
                    "speaker": "派蒙",
                    "text": "呀，黑蛇骑士！"
                },
                {
                    "id": "80050502",
                    "speaker": "派蒙",
                    "text": "这里是他们的老窝吗？还是说，他们在守护什么东西…"
                },
                {
                    "id": "80050503",
                    "speaker": "戴因斯雷布",
                    "text": "或许，深渊教团想隐藏的秘密就在这附近。先击败他们吧。"
                }
            ]
        },
        {
            "id": "800506",
            "objective": "击败黑蛇骑士",
            "dialogues": []
        },
        {
            "id": "800508",
            "objective": "继续探索遗迹",
            "dialogues": [
                {
                    "id": "80050801",
                    "speaker": "派蒙",
                    "text": "这边也有黑蛇骑士！"
                },
                {
                    "id": "80050802",
                    "speaker": "往日的黑蛇骑士",
                    "text": "「——————！！！」"
                },
                {
                    "id": "80050803",
                    "speaker": "派蒙",
                    "text": "他们没有直接冲过来，是在威胁我们吗？"
                },
                {
                    "id": "80050804",
                    "speaker": "派蒙",
                    "text": "这些黑蛇骑士似乎把什么围在了身后…"
                },
                {
                    "id": "80050805",
                    "speaker": "往日的黑蛇骑士",
                    "text": "「——————！！！」"
                },
                {
                    "id": "80050806",
                    "speaker": "戴因斯雷布",
                    "text": "等一下，他们好像…"
                },
                {
                    "id": "80050807",
                    "speaker": "往日的黑蛇骑士",
                    "text": "「——————！！！」"
                },
                {
                    "id": "80050808",
                    "speaker": "派蒙",
                    "text": "哇啊，他们冲过来了，快应战！"
                }
            ]
        },
        {
            "id": "800509",
            "objective": "击败黑蛇骑士",
            "dialogues": []
        },
        {
            "id": "800510",
            "objective": "调查黑蛇骑士守护的东西",
            "dialogues": [
                {
                    "id": "80051001",
                    "speaker": "派蒙",
                    "text": "啊！这、这是…"
                },
                {
                    "id": "80051002",
                    "speaker": "戴因斯雷布",
                    "text": "…果然，这些黑蛇骑士与深渊教团的秘密无关。哼…我早该猜到的。"
                },
                {
                    "id": "80051003",
                    "speaker": "派蒙",
                    "text": "这些丘丘人究竟是怎么回事？"
                },
                {
                    "id": "80051004",
                    "speaker": "戴因斯雷布",
                    "text": "如我先前所说，这就是丘丘人的「结局」。",
                    "choices": [
                        {
                            "id": "80051005",
                            "text": "准备迎接终结的丘丘人…",
                            "response": [
                                {
                                    "id": "80051007",
                                    "speaker": "戴因斯雷布",
                                    "text": "变得老化、畏光，甚至与黑暗逐渐融为一体。即便如此，诅咒依旧继续侵蚀着它们。"
                                },
                                {
                                    "id": "80051008",
                                    "speaker": "派蒙",
                                    "text": "可是为什么，这些黑蛇骑士会那样守护着它们呢…"
                                },
                                {
                                    "id": "80051009",
                                    "speaker": "往日的黑蛇骑士",
                                    "text": "「——————！！！」"
                                },
                                {
                                    "id": "80051010",
                                    "speaker": "派蒙",
                                    "text": "啊！黑蛇骑士们又围上来了！"
                                },
                                {
                                    "id": "80051011",
                                    "speaker": "往日的黑蛇骑士",
                                    "text": "「——————！！！」",
                                    "choices": [
                                        {
                                            "id": "80051012",
                                            "text": "想办法避免战斗吧。",
                                            "response": [
                                                {
                                                    "id": "80051014",
                                                    "speaker": "？？？",
                                                    "text": "「——————————————！」"
                                                },
                                                {
                                                    "id": "80051015",
                                                    "speaker": "派蒙",
                                                    "text": "那个是！一开始冷不丁出现又消失的家伙！"
                                                },
                                                {
                                                    "id": "80051016",
                                                    "speaker": "派蒙",
                                                    "text": "他们都退开了…难道是刚才那个骑士在发号施令吗？"
                                                },
                                                {
                                                    "id": "80051017",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "…哈夫丹？"
                                                },
                                                {
                                                    "id": "80051018",
                                                    "speaker": "？？？",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "80051019",
                                                    "speaker": "派蒙",
                                                    "text": "喂，怎么搞的，你认识刚才那个黑蛇骑士吗？"
                                                },
                                                {
                                                    "id": "80051020",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "…这样吗…若真是如此，那还真令人悲伤啊。"
                                                },
                                                {
                                                    "id": "80051021",
                                                    "speaker": "派蒙",
                                                    "text": "戴因？"
                                                },
                                                {
                                                    "id": "80051022",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "你想知道他们为何留在这里守护那些丘丘人，对吧。"
                                                },
                                                {
                                                    "id": "80051023",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "那是因为，对这些黑蛇骑士而言，他们仅仅是在履行职责。"
                                                },
                                                {
                                                    "id": "80051024",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "我也是刚刚认出，方才喝退了其他骑士的…是往日宫廷卫队中的年轻精英。其名为——哈夫丹。"
                                                },
                                                {
                                                    "id": "80051025",
                                                    "speaker": "派蒙",
                                                    "text": "是五百年前的人…"
                                                },
                                                {
                                                    "id": "80051026",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "我依稀还记得，坎瑞亚灾变当日，身为「末光之剑」的我赶往皇宫之前，嘱托那位名为哈夫丹的骑士…"
                                                },
                                                {
                                                    "id": "80051027",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "「转告所有黑蛇骑士，不论如何，守护好坎瑞亚的人民。」"
                                                },
                                                {
                                                    "id": "80051028",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "诚然，我们有着「宫廷卫队」的头衔。但面对那种浩劫，王室、名流、平民…这些身份都已经失去意义。"
                                                },
                                                {
                                                    "id": "80051029",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "面对神明之力，大地上只存在「坎瑞亚人」这一身份。"
                                                },
                                                {
                                                    "id": "80051030",
                                                    "speaker": "Player",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "80051031",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "或许在这些已经失去理智的黑蛇骑士心中，他们依然在为守护坎瑞亚人民而战。"
                                                },
                                                {
                                                    "id": "80051032",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "将这座遗迹视为灾难中的坎瑞亚，将那些丘丘人视为正在求助的民众…"
                                                },
                                                {
                                                    "id": "80051033",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "正如我所听到的…他们口中不断嘶吼的，绝非是对他人的警告。"
                                                },
                                                {
                                                    "id": "80051034",
                                                    "speaker": "派蒙",
                                                    "text": "那…他们说的是什么？"
                                                },
                                                {
                                                    "id": "80051035",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "尽管已经很难辨别，但我听得出，那是古坎瑞亚语的「快逃」。",
                                                    "choices": [
                                                        {
                                                            "id": "80051036",
                                                            "text": "他们并非是在对我们说话…",
                                                            "response": [
                                                                {
                                                                    "id": "80051038",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "就算是我也不得不承认，这份意志如此顽强，经历了五百年时光都未被磨灭…算得上是诞生自绝望的奇迹了吧。"
                                                                },
                                                                {
                                                                    "id": "80051039",
                                                                    "speaker": "派蒙",
                                                                    "text": "那、那我不是误会他们了吗…"
                                                                },
                                                                {
                                                                    "id": "80051040",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "没什么。即使是我，也有那么一瞬间将他们视为敌人。"
                                                                },
                                                                {
                                                                    "id": "80051041",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "朝着上面有光亮的地方继续前进吧，黑蛇骑士们应该不会阻止我们了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80051037",
                                                            "text": "是在让身后的丘丘人快逃…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80051013",
                                            "text": "这种战斗没有意义。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80051006",
                            "text": "「结局」…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800511",
            "objective": "前往遗迹顶层中心的房间",
            "dialogues": []
        },
        {
            "id": "800512",
            "objective": "前往遗迹顶层中心的房间",
            "dialogues": []
        },
        {
            "id": "800513",
            "objective": "前往遗迹顶层中心的房间",
            "dialogues": []
        },
        {
            "id": "800514",
            "objective": "前往遗迹顶层中心的房间",
            "dialogues": [
                {
                    "id": "80051401",
                    "speaker": "派蒙",
                    "text": "欸，这个房间没有门阻挡，看来终于可以前往中间的那个房间了。"
                },
                {
                    "id": "80051402",
                    "speaker": "派蒙",
                    "text": "我们快过去吧！"
                }
            ]
        },
        {
            "id": "800516",
            "objective": "",
            "dialogues": [
                {
                    "id": "80051501",
                    "speaker": "派蒙",
                    "text": "快看头顶上，居然有个水池！"
                },
                {
                    "id": "80051502",
                    "speaker": "派蒙",
                    "text": "连池水都是倒置的，还真是奇景。"
                },
                {
                    "id": "80051503",
                    "speaker": "派蒙",
                    "text": "你知道这个水池是怎么回事吗，戴因？"
                },
                {
                    "id": "80051504",
                    "speaker": "戴因斯雷布",
                    "text": "水池似乎和整座城市是一体的，想必也是古文明的遗留物。"
                },
                {
                    "id": "80051505",
                    "speaker": "戴因斯雷布",
                    "text": "关键在于…我认为，削弱诅咒的效果便是来自于它。"
                },
                {
                    "id": "80051506",
                    "speaker": "戴因斯雷布",
                    "text": "身处此地，躯体便会感觉到前所未有的宁静。感觉比之前更强烈了，我想多半是因为那池水有着类似「净化」的效果。"
                },
                {
                    "id": "80051507",
                    "speaker": "派蒙",
                    "text": "「净化」？那会不会…那个水池里的水可以彻底将诅咒净化掉呢？"
                },
                {
                    "id": "80051508",
                    "speaker": "戴因斯雷布",
                    "text": "不可能。"
                },
                {
                    "id": "80051509",
                    "speaker": "派蒙",
                    "text": "那么肯定？"
                },
                {
                    "id": "80051510",
                    "speaker": "戴因斯雷布",
                    "text": "我保持着清醒与诅咒共存至今，已有五百年。没人比我更清楚有关诅咒的事。"
                },
                {
                    "id": "80051511",
                    "speaker": "戴因斯雷布",
                    "text": "它是这个世界的因果级别的烙印，神明的诅咒甚至从位格上高于人类本身。"
                },
                {
                    "id": "80051512",
                    "speaker": "戴因斯雷布",
                    "text": "我能感觉到，诅咒正在不断渗透我的一切，成为我的一部分，甚至逐渐「取代」我。"
                },
                {
                    "id": "80051513",
                    "speaker": "戴因斯雷布",
                    "text": "有限地抑制诅咒侵蚀或许还有可能，至于净化…"
                },
                {
                    "id": "80051514",
                    "speaker": "戴因斯雷布",
                    "text": "你就想象成直接焚毁掉身体的某一部分好了。在那之前，你甚至无法保住性命。"
                },
                {
                    "id": "80051515",
                    "speaker": "派蒙",
                    "text": "啊？！那不就要一命呜呼了吗！怎么会这样…无法净化的诅咒…"
                },
                {
                    "id": "80051516",
                    "speaker": "戴因斯雷布",
                    "text": "从这里感受到的池水，其净化效力还差得很远。只能勉强起到一些抑制诅咒的作用。"
                },
                {
                    "id": "80051517",
                    "speaker": "派蒙",
                    "text": "那下面这个装置又是什么呢？好像跟周围有些格格不入…",
                    "choices": [
                        {
                            "id": "80051518",
                            "text": "莫非是深渊教团的东西？",
                            "response": [
                                {
                                    "id": "80051520",
                                    "speaker": "戴因斯雷布",
                                    "text": "坦白说，我也没见过这种构造的装置。你认为是深渊教团放置的，不无道理。莫非，他们是在做什么准备…"
                                },
                                {
                                    "id": "80051521",
                                    "speaker": "？？？",
                                    "text": "（咔啦咔啦…）"
                                },
                                {
                                    "id": "80051522",
                                    "speaker": "派蒙",
                                    "text": "呜哇！吓我一跳，周围那些大门都被打开了？"
                                },
                                {
                                    "id": "80051523",
                                    "speaker": "哈夫丹",
                                    "text": "……"
                                },
                                {
                                    "id": "80051524",
                                    "speaker": "派蒙",
                                    "text": "呀，是那个叫哈夫丹的骑士…"
                                },
                                {
                                    "id": "80051525",
                                    "speaker": "戴因斯雷布",
                                    "text": "你有话要对我说吗？哈夫丹。"
                                },
                                {
                                    "id": "80051526",
                                    "speaker": "哈夫丹",
                                    "text": "……"
                                },
                                {
                                    "id": "80051527",
                                    "speaker": "派蒙",
                                    "text": "他走了…可这次不是突然消失的！"
                                },
                                {
                                    "id": "80051528",
                                    "speaker": "戴因斯雷布",
                                    "text": "是在示意我们跟随他。如何，你们要来么？",
                                    "choices": [
                                        {
                                            "id": "80051529",
                                            "text": "可能是新的线索。",
                                            "response": [
                                                {
                                                    "id": "80051531",
                                                    "speaker": "派蒙",
                                                    "text": "说的也是…那…我们走吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80051530",
                                            "text": "他应该对我们没有恶意了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80051519",
                            "text": "可能是深渊教团的秘密了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800515",
            "objective": "前往遗迹顶层中心的房间",
            "dialogues": []
        },
        {
            "id": "800521",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80052101",
                    "speaker": "派蒙",
                    "text": "又是这些丘丘人，似乎被保护得很好的样子。"
                }
            ]
        },
        {
            "id": "800522",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80052201",
                    "speaker": "派蒙",
                    "text": "默默等待着自己消失的丘丘人们…希望它们可以如愿。"
                }
            ]
        },
        {
            "id": "800523",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80052301",
                    "speaker": "派蒙",
                    "text": "这么一想，从没见过如此老实的丘丘人呢，是因为灵魂真的已经老去了吗？"
                }
            ]
        },
        {
            "id": "800599",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80059901",
                    "speaker": "派蒙",
                    "text": "总算击败他们了！快去看看那些黑蛇骑士在守护的到底是什么秘密吧！"
                },
                {
                    "id": "80059903",
                    "speaker": "派蒙",
                    "text": "戴因…怎么不说话？"
                },
                {
                    "id": "80059904",
                    "speaker": "戴因斯雷布",
                    "text": "没什么，在想一些事而已。是想安慰我吗？那大可不必。"
                },
                {
                    "id": "80059905",
                    "speaker": "派蒙",
                    "text": "哼！好吧…"
                },
                {
                    "id": "80059906",
                    "speaker": "派蒙",
                    "text": "前面的藤蔓，好像可以爬上去的样子，试试看吧？"
                },
                {
                    "id": "80059907",
                    "speaker": "派蒙",
                    "text": "哈夫丹是从这边跳下去了吧，我们也下去看看？"
                }
            ]
        }
    ]
}