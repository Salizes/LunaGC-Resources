    "talks": [
        {
            "id": "7322001",
            "objective": "离开洞穴",
            "dialogues": []
        },
        {
            "id": "7322002",
            "objective": "继续前进",
            "dialogues": []
        },
        {
            "id": "7322011",
            "objective": "与婕德对话",
            "dialogues": [
                {
                    "id": "732201101",
                    "speaker": "派蒙",
                    "text": "哇…没想到在沙漠中间，还会有这样的地方…"
                },
                {
                    "id": "732201102",
                    "speaker": "派蒙",
                    "text": "欸？原来我们从地下出来的时候，太阳已经快落山了吗？"
                },
                {
                    "id": "732201103",
                    "speaker": "利露帕尔",
                    "text": "不…这里是女主人的乐园，水天相接的永恒一刻，是「机巧」与「慈爱」的媾合之时，此刻即是永恒。"
                },
                {
                    "id": "732201104",
                    "speaker": "派蒙",
                    "text": "唔…虽然听不明白你在说什么，但应该是这里所有东西都静止不动的原因吧？"
                },
                {
                    "id": "732201105",
                    "speaker": "婕德",
                    "text": "我的父母…所以说，他们会将这里视为归宿吗？"
                },
                {
                    "id": "732201106",
                    "speaker": "利露帕尔",
                    "text": "我没这么说哦…唉，随便你怎么理解吧，可怜的孩子。"
                }
            ]
        },
        {
            "id": "7322003",
            "objective": "前往花神永眠之处",
            "dialogues": []
        },
        {
            "id": "7322009",
            "objective": "拾取利露帕尔的碎片",
            "dialogues": []
        },
        {
            "id": "7322012",
            "objective": "与利露帕尔对话",
            "dialogues": [
                {
                    "id": "732201201",
                    "speaker": "利露帕尔",
                    "text": "我的女主人…她不在这里。"
                },
                {
                    "id": "732201202",
                    "speaker": "利露帕尔",
                    "text": "但我却在这里寻到了自己的碎片…"
                },
                {
                    "id": "732201203",
                    "speaker": "利露帕尔",
                    "text": "……"
                }
            ]
        },
        {
            "id": "7322013",
            "objective": "与利露帕尔对话",
            "dialogues": [
                {
                    "id": "732201301",
                    "speaker": "Black Screen",
                    "text": "随着闪光的碎片汇入利露帕尔的魔瓶，你感到自身的力量也被抽离了少许…但很快，一股温暖的感觉充实了你。"
                },
                {
                    "id": "732201302",
                    "speaker": "Black Screen",
                    "text": "从镇灵恍惚的目光中，你看到了红玉堆砌的宫阙与花园…千万种花儿盛开，万千鸟儿鸣啭。\\n镇灵们是女主人富有灵性的仆从，是她的乐师与斟酒者。\\n她的花园中，发疯的僧人与破落的旅人伴着萨吉的水仙旋舞，啜饮着葡萄藤女儿的鲜血…\\n这是世上无二的花园，曾是花之女主人的居所，如今是她长眠的陵墓…"
                },
                {
                    "id": "732201303",
                    "speaker": "Black Screen",
                    "text": "「玫瑰绽放如火，将夜莺的生命点燃。蜡烛灿然微笑，却给飞蛾带来灾难。」"
                },
                {
                    "id": "732201304",
                    "speaker": "Black Screen",
                    "text": "你看见她伸出手来，肤色如月光般透明。你望见她的脸庞，难以言喻的美丽。仿佛每一个美妙的镇灵都是她的花瓣，每一缕馨香都来自她一般…\\n然后，你对上了她的目光——"
                },
                {
                    "id": "732201305",
                    "speaker": "Black Screen",
                    "text": "那里什么都没有。\\n只有无垠的虚空，令你坠落其中，恐惧不已…"
                },
                {
                    "id": "732201306",
                    "speaker": "Black Screen",
                    "text": "你的意识逐渐恢复，婕德正握着你的手，神情担忧。"
                },
                {
                    "id": "732201307",
                    "speaker": "婕德",
                    "text": "你醒了…你还好吗？"
                },
                {
                    "id": "732201308",
                    "speaker": "婕德",
                    "text": "你刚刚…唉，算了。你没事就好…"
                },
                {
                    "id": "732201309",
                    "speaker": "派蒙",
                    "text": "你都看到了什么呀…就像做了一个长梦一样，看起来蛮吓人的…",
                    "choices": [
                        {
                            "id": "732201310",
                            "text": "是「花的女主人」…",
                            "response": [
                                {
                                    "id": "732201312",
                                    "speaker": "利露帕尔",
                                    "text": "……"
                                },
                                {
                                    "id": "732201313",
                                    "speaker": "利露帕尔",
                                    "text": "她已经不在这里了，他骗了我们，骗了我们所有人。"
                                },
                                {
                                    "id": "732201314",
                                    "speaker": "婕德",
                                    "text": "你说什么…？"
                                },
                                {
                                    "id": "732201315",
                                    "speaker": "利露帕尔",
                                    "text": "没什么，一个很久以前的契约取消了。我想…我自由了？"
                                },
                                {
                                    "id": "732201316",
                                    "speaker": "利露帕尔",
                                    "text": "沙海的王曾向我们承诺，花的女主人沉眠在此处，终有一日会从这里醒来…但…"
                                },
                                {
                                    "id": "732201317",
                                    "speaker": "利露帕尔",
                                    "text": "真是奇怪…女主人已经死去了，他骗了我…骗了我的族人。"
                                },
                                {
                                    "id": "732201318",
                                    "speaker": "利露帕尔",
                                    "text": "我本应该发了疯般地恨他，为了这片沙漠，为了女主人的死去…就像我曾爱他和仰视他…"
                                },
                                {
                                    "id": "732201319",
                                    "speaker": "利露帕尔",
                                    "text": "但…我却失去了憎恨的动力…为什么会这样…",
                                    "choices": [
                                        {
                                            "id": "732201320",
                                            "text": "或许这就是「自由」吧。",
                                            "response": [
                                                {
                                                    "id": "732201322",
                                                    "speaker": "利露帕尔",
                                                    "text": "这样吗…"
                                                },
                                                {
                                                    "id": "732201323",
                                                    "speaker": "婕德",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "732201324",
                                                    "speaker": "利露帕尔",
                                                    "text": "哼，少卖乖了…我的主人仍旧是您，我们的契约还没有结束呢…"
                                                },
                                                {
                                                    "id": "732201325",
                                                    "speaker": "利露帕尔",
                                                    "text": "我们走吧，婕德还在这里等着你呢。"
                                                },
                                                {
                                                    "id": "732201326",
                                                    "speaker": "婕德",
                                                    "text": "嗯…我看到有一片好地方，就在那边。我先过去了。"
                                                },
                                                {
                                                    "id": "732201327",
                                                    "speaker": "婕德",
                                                    "text": "你也别忘了过来呀。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732201321",
                                            "text": "你不用依赖「爱人」或「仇人」了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732201311",
                            "text": "是这里很久以前的样子…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7322005",
            "objective": "前去寻找婕德",
            "dialogues": []
        },
        {
            "id": "7322014",
            "objective": "与婕德对话",
            "dialogues": [
                {
                    "id": "732201401",
                    "speaker": "婕德",
                    "text": "……"
                },
                {
                    "id": "732201402",
                    "speaker": "婕德",
                    "text": "这个地方…和母亲日志里的古代草图能够对应上。应该就是这里了。"
                },
                {
                    "id": "732201403",
                    "speaker": "利露帕尔",
                    "text": "是个安眠的好地方，对吧…？"
                },
                {
                    "id": "732201404",
                    "speaker": "婕德",
                    "text": "…嗯。"
                },
                {
                    "id": "732201405",
                    "speaker": "婕德",
                    "text": "危机四伏的沙漠，背叛和阴谋…无法原谅的事情，无法释怀的事情，明明刚发生了不久…"
                },
                {
                    "id": "732201406",
                    "speaker": "婕德",
                    "text": "但在这里，我却很平静…很开心。我不知道…为什么会这样。"
                },
                {
                    "id": "732201407",
                    "speaker": "利露帕尔",
                    "text": "因为这里是花的女主人最后的领域…天空的馈赠在地下深处维持着它的静止，这里保存了她最后的精魄…"
                },
                {
                    "id": "732201408",
                    "speaker": "利露帕尔",
                    "text": "所以即使她已经死去，这里依然平静如初，就像从未有人来过。所以，进入这片领域的人…只会感受到平静与快乐。"
                },
                {
                    "id": "732201409",
                    "speaker": "利露帕尔",
                    "text": "因为女主人是疯癫僧人与歧途旅客的保护者…这里对于他们来说，曾是归宿的乐园。"
                },
                {
                    "id": "732201410",
                    "speaker": "婕德",
                    "text": "……"
                },
                {
                    "id": "732201411",
                    "speaker": "Black Screen",
                    "text": "婕德没有说话，默默上前放下母亲的笔记，又将哲伯莱勒的大斧斜倚在一旁…\\n就仿佛他们从未走远一样。"
                }
            ]
        },
        {
            "id": "7322004",
            "objective": "陪伴婕德",
            "dialogues": []
        },
        {
            "id": "7322006",
            "objective": "与婕德对话",
            "dialogues": [
                {
                    "id": "732200601",
                    "speaker": "婕德",
                    "text": "抱歉…我一时有点不知该说什么。"
                },
                {
                    "id": "732200602",
                    "speaker": "婕德",
                    "text": "时间就像忘记流动了一样，一切都是静止的。不知为什么，我甚至忘记了惊叹这里的奇异景色…只感到了平静。"
                },
                {
                    "id": "732200603",
                    "speaker": "婕德",
                    "text": "在这种地方，伴着已死的神长眠…唉，虽然我宁愿他们从没有离开过。"
                },
                {
                    "id": "732200604",
                    "speaker": "婕德",
                    "text": "真希望他们能永远留驻这里，不再被时间遗忘。"
                },
                {
                    "id": "732200605",
                    "speaker": "利露帕尔",
                    "text": "……"
                },
                {
                    "id": "732200606",
                    "speaker": "利露帕尔",
                    "text": "起初进来时，我们搅扰了碎片的力量，也破坏了维持稳定的机关…这里早晚会崩毁，被黄沙吞没。"
                },
                {
                    "id": "732200607",
                    "speaker": "利露帕尔",
                    "text": "到那时候，女主人维持这片绿洲静止的残力也会回归诸天…这是无可挽回的结局。"
                },
                {
                    "id": "732200608",
                    "speaker": "婕德",
                    "text": "嗯…我知道。但至少在那之前，至少在那之前…我的父母终于重聚了，就像他们从没离开彼此。"
                },
                {
                    "id": "732200609",
                    "speaker": "婕德",
                    "text": "或许终有一天，我也会回到这里吧…等到我厌倦了所有冒险，离开了所有能称之为「家」的地方之后。"
                },
                {
                    "id": "732200610",
                    "speaker": "婕德",
                    "text": "到那时候，再从容地说一句「我回来咯！」然后，躺在父母中间沉沉睡去。"
                },
                {
                    "id": "732200611",
                    "speaker": "婕德",
                    "text": "……"
                },
                {
                    "id": "732200612",
                    "speaker": "派蒙",
                    "text": "婕德…那一天一定还很远呢！现在…唔…现在哲伯莱勒肯定很高兴，虽然板着脸，但是肯定很高兴的…"
                },
                {
                    "id": "732200613",
                    "speaker": "婕德",
                    "text": "谢谢你，派蒙…"
                },
                {
                    "id": "732200614",
                    "speaker": "婕德",
                    "text": "#还有{NICKNAME}，很感谢你愿意一路陪我，完成这个小小的任性心愿…但现在我一个人想多陪父母一会…",
                    "choices": [
                        {
                            "id": "732200615",
                            "text": "我理解的。",
                            "response": [
                                {
                                    "id": "732200616",
                                    "speaker": "婕德",
                                    "text": "嗯…谢谢你。"
                                }
                            ]
                        },
                        {
                            "id": "732200617",
                            "text": "别忘了回去。",
                            "response": [
                                {
                                    "id": "732200618",
                                    "speaker": "婕德",
                                    "text": "不用管我…我随后会跟上来的。哈，现在还不是在这里定居的好时候呢，对吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7322022",
            "objective": "与利露帕尔对话",
            "dialogues": []
        },
        {
            "id": "7322018",
            "objective": "与利露帕尔对话",
            "dialogues": [
                {
                    "id": "732201801",
                    "speaker": "利露帕尔",
                    "text": "她是个好孩子，我的大人。"
                },
                {
                    "id": "732201802",
                    "speaker": "利露帕尔",
                    "text": "这孩子是一头天生的猛兽。她可能头脑不是很聪明，但生存直觉却敏锐无比…"
                },
                {
                    "id": "732201803",
                    "speaker": "利露帕尔",
                    "text": "她知道谁想让她受伤流血，而一旦她嗅到这一点…就会拼命反击，毫不留情，无论对方有着多么亲密的掩饰…"
                },
                {
                    "id": "732201804",
                    "speaker": "利露帕尔",
                    "text": "唉…但她还不知道，有什么样的罗网在等着她呢。她还不知道，她想要争取的那个家园…究竟是个多么虚伪的东西。"
                },
                {
                    "id": "732201805",
                    "speaker": "利露帕尔",
                    "text": "我的大人，如果您在乎她，请好好保护她吧。"
                },
                {
                    "id": "732201806",
                    "speaker": "利露帕尔",
                    "text": "我的小小建议，您就当作是…我不知道，就当是身为母亲，一点小小的补偿吧…"
                }
            ]
        },
        {
            "id": "7322015",
            "objective": "与婕德对话",
            "dialogues": [
                {
                    "id": "732201501",
                    "speaker": "婕德",
                    "text": "……"
                },
                {
                    "id": "732201502",
                    "speaker": "婕德",
                    "text": "（她只是静静地坐在这里，享受着与父母独处的时光。）",
                    "choices": [
                        {
                            "id": "732201503",
                            "text": "（还是先不打扰她了。）",
                            "response": [
                                {
                                    "id": "732201504",
                                    "speaker": "婕德",
                                    "text": "……"
                                }
                            ]
                        },
                        {
                            "id": "732201505",
                            "text": "我们回去吧。",
                            "response": [
                                {
                                    "id": "732201506",
                                    "speaker": "婕德",
                                    "text": "如果你不介意的话，我还想多在这里待一会…抱歉。",
                                    "choices": [
                                        {
                                            "id": "732201507",
                                            "text": "（还是不打扰她了。）",
                                            "response": [
                                                {
                                                    "id": "732201508",
                                                    "speaker": "婕德",
                                                    "text": "……"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732201509",
                                            "text": "部落还在等着我们的消息。",
                                            "response": [
                                                {
                                                    "id": "732201510",
                                                    "speaker": "婕德",
                                                    "text": "嗯…稍微再给我一点时间…"
                                                },
                                                {
                                                    "id": "732201511",
                                                    "speaker": "婕德",
                                                    "text": "你们先去，稍后我就来。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7322007",
            "objective": "离开「永恒绿洲」",
            "dialogues": []
        },
        {
            "id": "7322016",
            "objective": "与婕德对话",
            "dialogues": [
                {
                    "id": "732201601",
                    "speaker": "婕德",
                    "text": "我感觉好多了。谢谢你们。"
                },
                {
                    "id": "732201602",
                    "speaker": "派蒙",
                    "text": "真的没事了吗？再休息一下也没关系的…"
                },
                {
                    "id": "732201603",
                    "speaker": "婕德",
                    "text": "我们回去吧。去跟芭别尔主母报告我们一路上的消息。"
                },
                {
                    "id": "732201604",
                    "speaker": "派蒙",
                    "text": "嗯，既然你这样说…那我们走吧！"
                }
            ]
        },
        {
            "id": "7322008",
            "objective": "向芭别尔回报情况",
            "dialogues": [
                {
                    "id": "732200801",
                    "speaker": "婕德",
                    "text": "我们安全回来了，芭别尔主母。"
                },
                {
                    "id": "732200802",
                    "speaker": "婕德",
                    "text": "我们探明了「永恒绿洲」的秘密，为部族打开了通道。"
                },
                {
                    "id": "732200803",
                    "speaker": "婕德",
                    "text": "感谢您给我这次机会，让我得以完成父母的夙愿…即使他们并不受塔尼特的祜佑。"
                },
                {
                    "id": "732200804",
                    "speaker": "芭别尔",
                    "text": "请不要这么说，孩子。你的夙愿，我一直记在心里。满足孩子们的愿望，也是我作为主母的职责。"
                },
                {
                    "id": "732200805",
                    "speaker": "婕德",
                    "text": "谢谢…"
                },
                {
                    "id": "732200806",
                    "speaker": "芭别尔",
                    "text": "很好，婕德。那么，阿萨里格的事情…"
                },
                {
                    "id": "732200807",
                    "speaker": "婕德",
                    "text": "您的判断是正确的…他是叛徒无疑。"
                },
                {
                    "id": "732200808",
                    "speaker": "派蒙",
                    "text": "欸，所以你们早就知道阿萨里格会反水了吗…？"
                },
                {
                    "id": "732200809",
                    "speaker": "婕德",
                    "text": "不，之前还只是怀疑而已，一路上我都在监视着他…但我没想到阿萨里格会这么快摊牌。"
                },
                {
                    "id": "732200810",
                    "speaker": "婕德",
                    "text": "芭别尔主母警告过我，但我那时宁愿选择相信他。"
                },
                {
                    "id": "732200811",
                    "speaker": "婕德",
                    "text": "请看，这里是有关他与愚人众勾结的证据。"
                },
                {
                    "id": "732200812",
                    "speaker": "Black Screen",
                    "text": "婕德将阿德菲的信件交给了芭别尔主母。"
                },
                {
                    "id": "732200813",
                    "speaker": "芭别尔",
                    "text": "……"
                },
                {
                    "id": "732200814",
                    "speaker": "婕德",
                    "text": "请不要悲伤，芭别尔主母…"
                },
                {
                    "id": "732200815",
                    "speaker": "芭别尔",
                    "text": "嗯…我早就察觉到他怀有异心，只可惜没能亲手处决他…我曾经那么看重他。"
                },
                {
                    "id": "732200816",
                    "speaker": "芭别尔",
                    "text": "但现在，部族的环境愈发凶险…我失去了两个曾精心培养的人物，以后部族的大事小情，就要多多要你承担了。"
                },
                {
                    "id": "732200817",
                    "speaker": "派蒙",
                    "text": "欸…所以说，婕德是晋升了呀？恭喜你啦，婕德！"
                },
                {
                    "id": "732200818",
                    "speaker": "芭别尔",
                    "text": "晋升？哈哈…这个词在沙漠里可不多见。"
                },
                {
                    "id": "732200819",
                    "speaker": "芭别尔",
                    "text": "在我们沙漠人眼中可没有什么官僚层级。只是谁负责的事情更多了，谁就更有可能在未来掌握更多权力。"
                },
                {
                    "id": "732200820",
                    "speaker": "芭别尔",
                    "text": "婕德…塔尼特的未来在你身上，请不要辜负族人们的希望。"
                },
                {
                    "id": "732200821",
                    "speaker": "婕德",
                    "text": "族人…所以，您也承认我是塔尼特真正的族人了吗？"
                },
                {
                    "id": "732200822",
                    "speaker": "芭别尔",
                    "text": "别犯傻，我一直这样认为。不论之前发生过什么，你是塔尼特的女儿，你的身上永远流着与我们相同的血。"
                },
                {
                    "id": "732200823",
                    "speaker": "婕德",
                    "text": "嗯…谢谢。"
                },
                {
                    "id": "732200824",
                    "speaker": "派蒙",
                    "text": "唔，总觉得有什么不太对劲的东西没有提到呢…"
                },
                {
                    "id": "732200825",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们之前遇到过什么可疑的东西来着？",
                    "choices": [
                        {
                            "id": "732200826",
                            "text": "关于峡谷里的那些废弃营地…",
                            "response": [
                                {
                                    "id": "732200827",
                                    "speaker": "利露帕尔",
                                    "text": "你曾往绿洲派出过其他族人，并且任由他们死在了那里，然后以「禁忌」的借口禁止后来人进入，对吧？"
                                },
                                {
                                    "id": "732200828",
                                    "speaker": "利露帕尔",
                                    "text": "但你却鼓励我们深入险地，对这些东西只字不提，这是怎么回事？"
                                },
                                {
                                    "id": "732200829",
                                    "speaker": "婕德",
                                    "text": "……"
                                },
                                {
                                    "id": "732200830",
                                    "speaker": "芭别尔",
                                    "text": "……"
                                },
                                {
                                    "id": "732200831",
                                    "speaker": "芭别尔",
                                    "text": "尊敬的利露帕尔，此前的种种不便与误会，请容我向您致歉。"
                                },
                                {
                                    "id": "732200832",
                                    "speaker": "芭别尔",
                                    "text": "但塔尼特部族的确并非最近才开始探索居尔城的遗迹，以及「永恒绿洲」之所在…我此前已经派出过许多族人前往。"
                                },
                                {
                                    "id": "732200833",
                                    "speaker": "芭别尔",
                                    "text": "今人之所以能够确定这几处地点的位置与地形情况，也是多亏了他们的探险…"
                                },
                                {
                                    "id": "732200834",
                                    "speaker": "芭别尔",
                                    "text": "只是由于风险巨大，人员往往十不存一，而考察结果寥寥…"
                                },
                                {
                                    "id": "732200835",
                                    "speaker": "芭别尔",
                                    "text": "我才要求停止这种行动，将这些地方划为部族的禁忌区域。"
                                },
                                {
                                    "id": "732200836",
                                    "speaker": "芭别尔",
                                    "text": "阿萨里格那个叛徒…也曾经带队考察过那些峡谷与遗迹，我以为我能信任他给你们开路…但却没想到他…"
                                },
                                {
                                    "id": "732200837",
                                    "speaker": "婕德",
                                    "text": "但你没跟我们说过这些。"
                                },
                                {
                                    "id": "732200838",
                                    "speaker": "芭别尔",
                                    "text": "因为我从一开始就知道，你们会安然无恙地回来。你是我所信托的后辈，婕德。"
                                },
                                {
                                    "id": "732200839",
                                    "speaker": "芭别尔",
                                    "text": "你的勇敢无畏，你的凶猛和机智，你对待族人和朋友的真诚和温柔，我都看在眼里。"
                                },
                                {
                                    "id": "732200840",
                                    "speaker": "芭别尔",
                                    "text": "如果我的女儿未曾被沙漠带走，我想她一定也会长成你的样子。任何危险都打不倒她，任何沙暴都无法吞没她…"
                                },
                                {
                                    "id": "732200841",
                                    "speaker": "芭别尔",
                                    "text": "所以，我也这样相信着你，一直在默默为你祈祷。"
                                },
                                {
                                    "id": "732200842",
                                    "speaker": "婕德",
                                    "text": "……"
                                },
                                {
                                    "id": "732200843",
                                    "speaker": "婕德",
                                    "text": "…抱歉，芭别尔主母，是我顶撞您了。"
                                },
                                {
                                    "id": "732200844",
                                    "speaker": "芭别尔",
                                    "text": "不，引起了你们的误解和疑虑，应该是我要请求你们的原谅才对。"
                                },
                                {
                                    "id": "732200864",
                                    "speaker": "利露帕尔",
                                    "text": "……"
                                },
                                {
                                    "id": "732200865",
                                    "speaker": "利露帕尔",
                                    "text": "抱歉，我的大人，是我多虑了。"
                                },
                                {
                                    "id": "732200866",
                                    "speaker": "芭别尔",
                                    "text": "#那么，很高兴大家都能解开误会。{NICKNAME}，作为贵客，塔尼特部族永远欢迎你们。"
                                },
                                {
                                    "id": "732200867",
                                    "speaker": "芭别尔",
                                    "text": "尊贵的「镇灵主人」，无论您提出什么样的要求，请尽管与我相谈，我将尽全力满足。"
                                },
                                {
                                    "id": "732200868",
                                    "speaker": "Player",
                                    "text": "任何要求吗？"
                                },
                                {
                                    "id": "732200869",
                                    "speaker": "芭别尔",
                                    "text": "任何要求。",
                                    "choices": [
                                        {
                                            "id": "732200870",
                                            "text": "我想要摩拉做报酬。",
                                            "response": [
                                                {
                                                    "id": "732200871",
                                                    "speaker": "派蒙",
                                                    "text": "这才对嘛！摩拉、摩拉！"
                                                },
                                                {
                                                    "id": "732200872",
                                                    "speaker": "芭别尔",
                                                    "text": "很好，这是你应得的报酬。还有…感谢你为我照顾婕德。"
                                                },
                                                {
                                                    "id": "732200881",
                                                    "speaker": "芭别尔",
                                                    "text": "好了，不要让我留你们太长时间了。再次感谢你们的帮助，「镇灵主人」…还望您能够多多光顾塔尼特部族…"
                                                },
                                                {
                                                    "id": "732200882",
                                                    "speaker": "芭别尔",
                                                    "text": "毕竟，我们仰仗着您与利露帕尔的引导。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732200873",
                                            "text": "我想要一件纪念物。",
                                            "response": [
                                                {
                                                    "id": "732200874",
                                                    "speaker": "派蒙",
                                                    "text": "欸，我们不要摩拉吗？"
                                                },
                                                {
                                                    "id": "732200875",
                                                    "speaker": "芭别尔",
                                                    "text": "你与塔尼特的友谊当然值得留下纪念，请收下我们的薄礼，希望你不要嫌弃。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732200876",
                                            "text": "在婕德生日的宴会上替我敬杯酒吧。",
                                            "response": [
                                                {
                                                    "id": "732200877",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯，那也别忘了我的份！"
                                                },
                                                {
                                                    "id": "732200878",
                                                    "speaker": "婕德",
                                                    "text": "欸…？谢谢…"
                                                },
                                                {
                                                    "id": "732200879",
                                                    "speaker": "芭别尔",
                                                    "text": "噗…这是你们外人的传统吗？那好吧…"
                                                },
                                                {
                                                    "id": "732200880",
                                                    "speaker": "芭别尔",
                                                    "text": "我就为你们留着这个人情好了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732200845",
                            "text": "关于叛徒的书信…",
                            "response": [
                                {
                                    "id": "732200846",
                                    "speaker": "利露帕尔",
                                    "text": "阿萨里格和阿德菲的信里提及，他们反叛的原因是你将婕德这个「叛徒的女儿」当做掌中宝和继承人…"
                                },
                                {
                                    "id": "732200847",
                                    "speaker": "婕德",
                                    "text": "……"
                                },
                                {
                                    "id": "732200848",
                                    "speaker": "利露帕尔",
                                    "text": "另外，你也在部族中刻意清理「外人」的党羽，即使之前你曾依赖他们和「北方人」交流？"
                                },
                                {
                                    "id": "732200849",
                                    "speaker": "利露帕尔",
                                    "text": "我听不懂你们的黑话，但方才这些话是什么意思…我很好奇呢。"
                                },
                                {
                                    "id": "732200850",
                                    "speaker": "芭别尔",
                                    "text": "……"
                                },
                                {
                                    "id": "732200851",
                                    "speaker": "芭别尔",
                                    "text": "尊敬的利露帕尔，此前的种种不便与误会，请容我向您致歉。"
                                },
                                {
                                    "id": "732200852",
                                    "speaker": "芭别尔",
                                    "text": "但塔尼特部族的经营与生存，必须依赖多方贸易才能维持。这之中就包括那些来自北方的家伙。"
                                },
                                {
                                    "id": "732200853",
                                    "speaker": "芭别尔",
                                    "text": "纵我忙于处理部落事务的方方面面，也难以料定他们居心叵测…"
                                },
                                {
                                    "id": "732200854",
                                    "speaker": "芭别尔",
                                    "text": "但后来，我逐渐发现他们带来的风险多于益处…也就只能先从内部下手清理叛徒了。"
                                },
                                {
                                    "id": "732200855",
                                    "speaker": "芭别尔",
                                    "text": "这也正是我需要婕德的原因，她总能够坚定迅速地为部族排除叛徒，我欣赏她的忠诚和能力。"
                                },
                                {
                                    "id": "732200856",
                                    "speaker": "婕德",
                                    "text": "但你没跟我们说过这些。"
                                },
                                {
                                    "id": "732200857",
                                    "speaker": "芭别尔",
                                    "text": "因为我从一开始就知道，你们会安然无恙地回来。你是我所信托的后辈，婕德。"
                                },
                                {
                                    "id": "732200858",
                                    "speaker": "芭别尔",
                                    "text": "你的勇敢无畏，你的凶猛和机智，你对待族人和朋友的真诚和温柔，我都看在眼里。"
                                },
                                {
                                    "id": "732200859",
                                    "speaker": "芭别尔",
                                    "text": "如果我的女儿未曾被沙漠带走，我想她一定也会长成你的样子。任何危险都打不倒她，任何沙暴都无法吞没她…"
                                },
                                {
                                    "id": "732200860",
                                    "speaker": "芭别尔",
                                    "text": "所以，我也这样相信着你，一直在默默为你祈祷。"
                                },
                                {
                                    "id": "732200861",
                                    "speaker": "婕德",
                                    "text": "……"
                                },
                                {
                                    "id": "732200862",
                                    "speaker": "婕德",
                                    "text": "…抱歉，芭别尔主母，是我顶撞您了。"
                                },
                                {
                                    "id": "732200863",
                                    "speaker": "芭别尔",
                                    "text": "不，引起了你们的误解和疑虑，应该是我要请求你们的原谅才对。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7322050",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732205001",
                    "speaker": "婕德",
                    "text": "……"
                },
                {
                    "id": "732205002",
                    "speaker": "婕德",
                    "text": "（她只是静静地坐在这里，享受着与父母独处的时光。）"
                },
                {
                    "id": "732205003",
                    "speaker": "Player",
                    "text": "（还是先不打扰她了。）"
                }
            ]
        },
        {
            "id": "7322061",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732206113",
                    "speaker": "Player",
                    "text": "不，没什么事…"
                }
            ]
        },
        {
            "id": "7322099",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732209904",
                    "speaker": "Black Screen",
                    "text": "徘徊良久，你们决定离开这片静止的绿洲。\\n婕德也很快从后面赶了上来，与你们相会。"
                }
            ]
        }
    ]
}