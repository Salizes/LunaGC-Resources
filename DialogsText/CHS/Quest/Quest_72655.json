    "talks": [
        {
            "id": "7265501",
            "objective": "与慕珍对话",
            "dialogues": [
                {
                    "id": "726550101",
                    "speaker": "慕珍",
                    "text": "我们终于找到目标的位置了！好耶，可以回船上睡觉了！"
                },
                {
                    "id": "726550102",
                    "speaker": "派蒙",
                    "text": "欸——？这就事不关己了吗！"
                },
                {
                    "id": "726550103",
                    "speaker": "慕珍",
                    "text": "怎么可能啦，既然离我们所需的东西只剩一步之遥了，我们现在就出发，捕猎遗迹机械吧！"
                },
                {
                    "id": "726550104",
                    "speaker": "派蒙",
                    "text": "刚刚还以为你要回船上！"
                },
                {
                    "id": "726550105",
                    "speaker": "派蒙",
                    "text": "唉，算了，我们也一起去吧！"
                }
            ]
        },
        {
            "id": "7265502",
            "objective": "前往遗迹地点",
            "dialogues": [
                {
                    "id": "726550201",
                    "speaker": "慕珍",
                    "text": "哈哈，就是这里啦！"
                },
                {
                    "id": "726550202",
                    "speaker": "慕珍",
                    "text": "原来在这里也有地下遗迹…唔。",
                    "choices": [
                        {
                            "id": "726550203",
                            "text": "怎么了？",
                            "response": [
                                {
                                    "id": "726550205",
                                    "speaker": "慕珍",
                                    "text": "没、没什么。"
                                },
                                {
                                    "id": "726550206",
                                    "speaker": "派蒙",
                                    "text": "咦，是身体不舒服了吗？"
                                },
                                {
                                    "id": "726550207",
                                    "speaker": "慕珍",
                                    "text": "哈哈，我平时不怎么下船，看到遗迹入口这种大场面，还有点心虚罢了。"
                                },
                                {
                                    "id": "726550208",
                                    "speaker": "派蒙",
                                    "text": "这算什么大场面啦！"
                                },
                                {
                                    "id": "726550209",
                                    "speaker": "慕珍",
                                    "text": "好啦，大姐头的订单还等着完成，想必旅行者你也很好奇遗迹里潜藏的秘密吧！"
                                },
                                {
                                    "id": "726550210",
                                    "speaker": "慕珍",
                                    "text": "所以，就请冒险经验丰富的旅行者来打头阵吧？"
                                },
                                {
                                    "id": "726550211",
                                    "speaker": "Player",
                                    "text": "真拿你没办法…"
                                },
                                {
                                    "id": "726550212",
                                    "speaker": "派蒙",
                                    "text": "真是拿你没办法，我们走吧！"
                                }
                            ]
                        },
                        {
                            "id": "726550204",
                            "text": "有什么发现吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7265503",
            "objective": "与慕珍对话",
            "dialogues": []
        },
        {
            "id": "7265504",
            "objective": "探索这座遗迹",
            "dialogues": []
        },
        {
            "id": "7265503",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "726550301",
                    "speaker": "慕珍",
                    "text": "怎么，还需要点准备运动吗？",
                    "choices": [
                        {
                            "id": "726550302",
                            "text": "关于遗迹…",
                            "response": [
                                {
                                    "id": "726550304",
                                    "speaker": "慕珍",
                                    "text": "毕竟我是航船技术官，陆地上的历史我了解的不太多，抱歉啦。"
                                },
                                {
                                    "id": "726550305",
                                    "speaker": "慕珍",
                                    "text": "不过这些遗迹，我想都与五百年前那场大灾难有关…"
                                },
                                {
                                    "id": "726550306",
                                    "speaker": "慕珍",
                                    "text": "我也是从小听老水手们提起过那场大灾，据说不论海陆都没有幸免深渊的侵袭…"
                                },
                                {
                                    "id": "726550307",
                                    "speaker": "慕珍",
                                    "text": "不过对我来说，和吓唬小孩的鬼故事差不多啦。"
                                },
                                {
                                    "id": "726550308",
                                    "speaker": "慕珍",
                                    "text": "毕竟亲眼所见的可怕，才是真的可怕！"
                                }
                            ]
                        },
                        {
                            "id": "726550303",
                            "text": "关于神秘的机械…"
                        }
                    ]
                }
            ]
        }
    ]
