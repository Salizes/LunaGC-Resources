        {
            "id": "7517799",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751779901",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "唔…波嗯，呜…呀！"
                },
                {
                    "id": "751779902",
                    "speaker": "派蒙",
                    "text": "#嗯？怎么了，{REALNAME[ID(2)|SHOWHOST(true)]}，有什么事想要和我们说吗？"
                },
                {
                    "id": "751779903",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！唔嗯……"
                },
                {
                    "id": "751779904",
                    "speaker": "派蒙",
                    "text": "难道是累了，想要休息一下吗…嗯，我有个好想法，不如我们去我们第一次见面的那个地方休息一会儿吧！"
                },
                {
                    "id": "751779905",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀！"
                },
                {
                    "id": "751779906",
                    "speaker": "派蒙",
                    "text": "#好，嘿嘿，{NICKNAME}，我们待会儿就去吧！"
                }
            ]
        }
    ]
