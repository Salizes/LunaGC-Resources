    "talks": [
        {
            "id": "7517701",
            "objective": "(test)隐藏判定是否完成任务$HIDDEN",
            "dialogues": [
                {
                    "id": "751770101",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！呀！"
                },
                {
                    "id": "751770102",
                    "speaker": "派蒙",
                    "text": "#哎呀，{REALNAME[ID(2)|SHOWHOST(true)]}你是从哪里弄来的这个留影机…"
                },
                {
                    "id": "751770103",
                    "speaker": "派蒙",
                    "text": "不会是趁着别人不注意…这样可不行哦？"
                },
                {
                    "id": "751770104",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呜！"
                },
                {
                    "id": "751770105",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "嗯…呀！呀！呱呀……",
                    "choices": [
                        {
                            "id": "751770106",
                            "text": "很熟悉的动作…",
                            "response": [
                                {
                                    "id": "751770107",
                                    "speaker": "派蒙",
                                    "text": "哦哦，这不是「大炖肉火焰」嘛！"
                                },
                                {
                                    "id": "751770110",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，是在「回声之子」那会儿，有个想要当导演却放反了留影机的部族人…啊！留影机是从他那借来的吗？"
                                },
                                {
                                    "id": "751770111",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！嗯…呀！"
                                },
                                {
                                    "id": "751770112",
                                    "speaker": "派蒙",
                                    "text": "你想要跟我们一起拍一张画片，嘿嘿，是这个意思吧！"
                                },
                                {
                                    "id": "751770113",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "751770114",
                                    "speaker": "派蒙",
                                    "text": "是哦，一起冒险了那么久，还没有一起拍画片留念呢，小家伙身上的诅咒已经去除，可以健康长大了！"
                                },
                                {
                                    "id": "751770115",
                                    "speaker": "派蒙",
                                    "text": "#不知道长成大嵴锋龙要多久，如果明天一下子就变成大嵴锋龙了，那不是再也见不到{REALNAME[ID(2)|SHOWHOST(true)]}还是小龙的样子了嘛！",
                                    "choices": [
                                        {
                                            "id": "751770116",
                                            "text": "……",
                                            "response": [
                                                {
                                                    "id": "751770117",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿，就来拍一张嘛！"
                                                },
                                                {
                                                    "id": "751770119",
                                                    "speaker": "派蒙",
                                                    "text": "调整好了，大概是这样，检查过了，我可没有弄反！"
                                                },
                                                {
                                                    "id": "751770120",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，那倒数结束就喊「大炖肉火焰」！三、二、一！"
                                                },
                                                {
                                                    "id": "751770121",
                                                    "speaker": "Player",
                                                    "text": "「大炖肉火焰」！"
                                                },
                                                {
                                                    "id": "751770122",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "751770123",
                                                    "speaker": "派蒙",
                                                    "text": "#这样就拍好啦，你看，{REALNAME[ID(2)|SHOWHOST(true)]}也很有气势…"
                                                },
                                                {
                                                    "id": "751770124",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "751770125",
                                                    "speaker": "Black Screen",
                                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}接过画片中的其中一张，转过身去，很小心地放在了坚硬壳下，柔软的背中。"
                                                },
                                                {
                                                    "id": "751770126",
                                                    "speaker": "派蒙",
                                                    "text": "#不过，{REALNAME[ID(2)|SHOWHOST(true)]}为什么突然想要拍画片呢…"
                                                },
                                                {
                                                    "id": "751770127",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "波嗯…"
                                                },
                                                {
                                                    "id": "751770128",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "唔…"
                                                },
                                                {
                                                    "id": "751770129",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呜呀…唔…"
                                                },
                                                {
                                                    "id": "751770130",
                                                    "speaker": "派蒙",
                                                    "text": "#咦，怎么了，{REALNAME[ID(2)|SHOWHOST(true)]}，是哪里不舒服吗，看上去，看上去不太开心…"
                                                },
                                                {
                                                    "id": "751770131",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "751770132",
                                                    "speaker": "Player",
                                                    "text": "#{REALNAME[ID(2)|SHOWHOST(true)]}…"
                                                },
                                                {
                                                    "id": "751770133",
                                                    "speaker": "Player",
                                                    "text": "想要开始属于自己的冒险了吧…"
                                                },
                                                {
                                                    "id": "751770134",
                                                    "speaker": "派蒙",
                                                    "text": "欸，什么，自己的冒险…是、是不想跟我们一起旅行了吗，呜，是不是我说了什么话让你生气了…"
                                                },
                                                {
                                                    "id": "751770135",
                                                    "speaker": "派蒙",
                                                    "text": "我、我以后再也不说你贪吃了，你不要离开我们，好不好？"
                                                },
                                                {
                                                    "id": "751770136",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "唔…"
                                                },
                                                {
                                                    "id": "751770137",
                                                    "speaker": "Player",
                                                    "text": "…派蒙。"
                                                },
                                                {
                                                    "id": "751770138",
                                                    "speaker": "派蒙",
                                                    "text": "呜…我知道，我知道的啦…小家伙总有一天会长大，它也有、也有自己要去的地方…"
                                                },
                                                {
                                                    "id": "751770139",
                                                    "speaker": "派蒙",
                                                    "text": "可是，就算是这样，突然说要离开，还是会感到寂寞…"
                                                },
                                                {
                                                    "id": "751770140",
                                                    "speaker": "Player",
                                                    "text": "没关系，以后还会见到的…"
                                                },
                                                {
                                                    "id": "751770141",
                                                    "speaker": "派蒙",
                                                    "text": "#真的吗？以后、唔，以后我们需要帮助的时候，{REALNAME[ID(2)|SHOWHOST(true)]}可要赶过来哦！"
                                                },
                                                {
                                                    "id": "751770142",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！"
                                                },
                                                {
                                                    "id": "751770143",
                                                    "speaker": "派蒙",
                                                    "text": "#那以后，{REALNAME[ID(2)|SHOWHOST(true)]}的冒险要是遇到了难题，也得立刻来找我们，不许逞强！"
                                                },
                                                {
                                                    "id": "751770144",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！呀！"
                                                },
                                                {
                                                    "id": "751770145",
                                                    "speaker": "派蒙",
                                                    "text": "…还有，平时不要吃得太多了，遇到打不过的大家伙就要及时逃跑。虽然说不能吃太多，但是该吃的炖肉也要吃…"
                                                },
                                                {
                                                    "id": "751770146",
                                                    "speaker": "派蒙",
                                                    "text": "然后，最最最最，最重要的就是——"
                                                },
                                                {
                                                    "id": "751770147",
                                                    "speaker": "Player",
                                                    "text": "要好好长大…"
                                                },
                                                {
                                                    "id": "751770148",
                                                    "speaker": "派蒙",
                                                    "text": "对，要好好长大！起码要长成三座山大小那么大！"
                                                },
                                                {
                                                    "id": "751770149",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "呀！呀！呀！"
                                                },
                                                {
                                                    "id": "751770150",
                                                    "speaker": "派蒙",
                                                    "text": "就是…呜，就得有这样的气势！一定、一定要记得我们呀！"
                                                },
                                                {
                                                    "id": "751770151",
                                                    "speaker": "Black Screen",
                                                    "text": "在静谧的林中，你们一同享用了告别的火焰炖肉，而后，整理起了这片偶尔前来的营地。\\n你为今后将要独自前行的伙伴整理一路上的纪念品，你们想起这段旅途上发生的所有事，堵住洞口的匿叶龙，海畔边的膨膨兽，和在纳塔遇到的许多个性各异的人们…"
                                                },
                                                {
                                                    "id": "751770152",
                                                    "speaker": "Black Screen",
                                                    "text": "还有…还有那个凭借古怪金文说话的家伙…\\n派蒙说：「那个家伙就是在利用我们嘛，从头到尾也没露过面。」\\n这让你回想起在图兰圣山之底时，一度成长的幼龙眼中曾流露过的复杂的情绪。\\n…现在它仍然幼小，但总有一天会变成那样了不起的大龙吧。"
                                                },
                                                {
                                                    "id": "751770153",
                                                    "speaker": "Black Screen",
                                                    "text": "最后的最后，它轻轻用角抵触派蒙的额心，又蹭蹭你伸出的手掌。\\n然后，像是要劝自己下定决心那样——"
                                                },
                                                {
                                                    "id": "751770154",
                                                    "speaker": "Black Screen",
                                                    "text": "幼小的龙坚决地转身离开了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "751770118",
                                            "text": "嗯，来拍吧！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "751770108",
                            "text": "是「大炖肉火焰」！",
                            "response": [
                                {
                                    "id": "751770109",
                                    "speaker": "派蒙",
                                    "text": "哦哦，你这么一说，我就有点印象了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
