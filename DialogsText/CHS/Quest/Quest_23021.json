    "talks": [
        {
            "id": "2302101",
            "objective": "与拉菲克对话",
            "dialogues": [
                {
                    "id": "230210101",
                    "speaker": "拉菲克",
                    "text": "旅行者！你来得正好，船刚刚下水，十分平稳。"
                },
                {
                    "id": "230210102",
                    "speaker": "拉菲克",
                    "text": "我的计算果然没有任何问题！"
                },
                {
                    "id": "230210103",
                    "speaker": "绮珊",
                    "text": "所以，我们说好的负载试验什么时候开始？"
                },
                {
                    "id": "230210104",
                    "speaker": "拉菲克",
                    "text": "别着急嘛，旅行者都来了，我们马上开始。"
                },
                {
                    "id": "230210105",
                    "speaker": "Player",
                    "text": "负载试验是什么？"
                },
                {
                    "id": "230210106",
                    "speaker": "拉菲克",
                    "text": "简单来说，就是用重物来测试船的负载能力。"
                },
                {
                    "id": "230210107",
                    "speaker": "拉菲克",
                    "text": "嗯…也就是说，需要有人和我一起把重物都搬到船上去…"
                },
                {
                    "id": "230210108",
                    "speaker": "拉菲克",
                    "text": "旅行者，我上次就发现你身强体壮，力量充沛，非常擅长这种工作…",
                    "choices": [
                        {
                            "id": "230210109",
                            "text": "原来这才是让我来的原因。",
                            "response": [
                                {
                                    "id": "230210111",
                                    "speaker": "拉菲克",
                                    "text": "没、没有啦，我是真的没法一个人搞定这件事，只能拜托你来帮忙了。"
                                },
                                {
                                    "id": "230210112",
                                    "speaker": "拉菲克",
                                    "text": "而且报酬绝对不会少！放心吧，我前几天刚帮人去修好了一艘大船，拿了不少钱呢！"
                                },
                                {
                                    "id": "230210113",
                                    "speaker": "绮珊",
                                    "text": "哦…不少钱啊…"
                                },
                                {
                                    "id": "230210114",
                                    "speaker": "拉菲克",
                                    "text": "欸？那个，我几乎把钱都投入造船里了…"
                                },
                                {
                                    "id": "230210115",
                                    "speaker": "绮珊",
                                    "text": "全部？"
                                },
                                {
                                    "id": "230210116",
                                    "speaker": "拉菲克",
                                    "text": "还留着一点！哎呀，我会请你喝咖啡的啦…"
                                },
                                {
                                    "id": "230210117",
                                    "speaker": "拉菲克",
                                    "text": "旅行者，我们赶紧开始吧，快快快！"
                                }
                            ]
                        },
                        {
                            "id": "230210110",
                            "text": "生气。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302102",
            "objective": "收集重物",
            "dialogues": []
        },
        {
            "id": "2302103",
            "objective": "收集重物",
            "dialogues": []
        },
        {
            "id": "2302104",
            "objective": "把重物搬上船",
            "dialogues": []
        },
        {
            "id": "2302105",
            "objective": "测试失败$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2302109",
            "objective": "搬货刷suite辅助环$HIDDEN",
            "dialogues": [
                {
                    "id": "230210901",
                    "speaker": "绮珊",
                    "text": "唉，这艘船真能载得动这么重的东西吗…"
                }
            ]
        },
        {
            "id": "2302106",
            "objective": "回去和拉菲克对话",
            "dialogues": [
                {
                    "id": "230210614",
                    "speaker": "拉菲克",
                    "text": "好…嘞！这样就可以了，让我们来看看会发生什…"
                },
                {
                    "id": "230210601",
                    "speaker": "派蒙",
                    "text": "呜哇！那边漏水了！"
                },
                {
                    "id": "230210615",
                    "speaker": "拉菲克",
                    "text": "什么？！"
                },
                {
                    "id": "230210602",
                    "speaker": "派蒙",
                    "text": "船，船都歪了！怎么回事呀！"
                },
                {
                    "id": "230210603",
                    "speaker": "拉菲克",
                    "text": "快，快把东西搬下去，肯定是出问题了！"
                },
                {
                    "id": "230210604",
                    "speaker": "Black Screen",
                    "text": "和拉菲克匆匆忙忙地把所有东西都搬下了船…"
                },
                {
                    "id": "230210605",
                    "speaker": "拉菲克",
                    "text": "呼…呼…还好东西不多…"
                },
                {
                    "id": "230210606",
                    "speaker": "拉菲克",
                    "text": "这到底…到底是哪里出问题了…"
                },
                {
                    "id": "230210607",
                    "speaker": "绮珊",
                    "text": "我当初说什么来着？你计算的那些理论数据都太极限了，这样是不可靠的。"
                },
                {
                    "id": "230210608",
                    "speaker": "拉菲克",
                    "text": "呼…我…我…好吧…"
                },
                {
                    "id": "230210609",
                    "speaker": "拉菲克",
                    "text": "不应该啊，我都算得那么精确了…"
                },
                {
                    "id": "230210610",
                    "speaker": "拉菲克",
                    "text": "旅行者，谢谢你帮忙，这些是报酬，请你收下吧 。"
                },
                {
                    "id": "230210611",
                    "speaker": "拉菲克",
                    "text": "我要回去重新计算一遍…绮珊，能再帮我一下吗？"
                },
                {
                    "id": "230210612",
                    "speaker": "绮珊",
                    "text": "…说得好像我都没帮忙似的。"
                },
                {
                    "id": "230210613",
                    "speaker": "绮珊",
                    "text": "交给我吧，计算完了之后记得请我喝咖啡。"
                }
            ]
        },
        {
            "id": "2302107",
            "objective": "测试成功$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2302108",
            "objective": "回去和拉菲克对话",
            "dialogues": [
                {
                    "id": "230210801",
                    "speaker": "拉菲克",
                    "text": "太棒了，非常成功！"
                },
                {
                    "id": "230210802",
                    "speaker": "拉菲克",
                    "text": "船体的结构没有问题…吃水线也很稳定，也没有倾倒。"
                },
                {
                    "id": "230210803",
                    "speaker": "拉菲克",
                    "text": "绮珊，你看看，我的设计和计算完美无缺！"
                },
                {
                    "id": "230210804",
                    "speaker": "绮珊",
                    "text": "这才是负载试验的第一阶段，别高兴太早了。"
                },
                {
                    "id": "230210805",
                    "speaker": "绮珊",
                    "text": "而且你还没有考虑到天气因素和航行时货物挪移导致的船体重心问题…"
                },
                {
                    "id": "230210806",
                    "speaker": "拉菲克",
                    "text": "呃…呃，我会考虑的，你就先让我高兴一下嘛…"
                },
                {
                    "id": "230210807",
                    "speaker": "拉菲克",
                    "text": "对了旅行者，这是你的报酬，请先收下吧。"
                },
                {
                    "id": "230210808",
                    "speaker": "拉菲克",
                    "text": "绮珊啊，你就不能给我打打气吗？"
                },
                {
                    "id": "230210809",
                    "speaker": "绮珊",
                    "text": "可是在造船这件事上，给人打气鼓劲没用啊。"
                },
                {
                    "id": "230210810",
                    "speaker": "绮珊",
                    "text": "你还是好好想想，怎么给自己的钱包打气鼓劲吧。"
                }
            ]
        },
        {
            "id": "2302110",
            "objective": "回去和拉菲克对话",
            "dialogues": [
                {
                    "id": "230211001",
                    "speaker": "拉菲克",
                    "text": "这艘船的载重能力绝对不会有问题！放心吧！"
                }
            ]
        }
    ]
}