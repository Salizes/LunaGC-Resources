    "talks": [
        {
            "id": "7418701",
            "objective": "(test)前往大钟洞穴锁链处$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7418702",
            "objective": "(test)石像对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741870701",
                    "speaker": "领头的家伙",
                    "text": "好吧…您说的没错，我们的所作所为确实需要重新考虑。但我也不知道为什么会变成这样…"
                },
                {
                    "id": "741870702",
                    "speaker": "领头的家伙",
                    "text": "自从战争爆发以来，我的心中总有一种奇怪的感觉。"
                },
                {
                    "id": "741870703",
                    "speaker": "领头的家伙",
                    "text": "我们追求的本应是自由与幸福，但「福波斯」却一步一步将我们引向了这里…"
                },
                {
                    "id": "741870704",
                    "speaker": "领头的家伙",
                    "text": "到底出了什么问题呢？"
                },
                {
                    "id": "741870705",
                    "speaker": "领头的家伙",
                    "text": "如果你们回去的时候能面见至尊大人的话，也请将这里的情况，我们的疑惑禀报给他吧。"
                },
                {
                    "id": "741870706",
                    "speaker": "领头的家伙",
                    "text": "拜托你们了。"
                },
                {
                    "id": "741870707",
                    "speaker": "派蒙",
                    "text": "嗯嗯，我们当然会的！"
                }
            ]
        },
        {
            "id": "7418705",
            "objective": "(test)失败分支：石像战斗$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7418703",
            "objective": "(test)解开大钟区域锁链$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7418704",
            "objective": "(test)大钟区域锁链Timeline$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7418706",
            "objective": "(test)与埃斯特对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741870901",
                    "speaker": "埃斯特",
                    "text": "看样子，刚才的问题您应该已经成功解决了。"
                },
                {
                    "id": "741870902",
                    "speaker": "埃斯特",
                    "text": "那么，接下来您也要奔赴新的目标了吧。"
                },
                {
                    "id": "741870903",
                    "speaker": "小呜斯",
                    "text": "嗯，埃斯特，这里的事情就拜托你了…"
                },
                {
                    "id": "741870904",
                    "speaker": "小呜斯",
                    "text": "以及，比起将评判对错的准绳交给「福波斯」或是某位调律师，更重要的是相信自己内心的判断。"
                },
                {
                    "id": "741870905",
                    "speaker": "小呜斯",
                    "text": "至尊创造「福波斯」是为了使我们摆脱命运的奴役，但公民们的盲从却会让我们陷入更可怕的奴役当中。"
                },
                {
                    "id": "741870906",
                    "speaker": "小呜斯",
                    "text": "未来你或许还会遇到这样的选择，等到那个时候，希望你也能做出正确的决定。"
                },
                {
                    "id": "741870907",
                    "speaker": "埃斯特",
                    "text": "卡西奥多大人，您怎么突然说起这些了…"
                },
                {
                    "id": "741870908",
                    "speaker": "埃斯特",
                    "text": "不过，您的话我记住了，埃斯特当然会坚持自己内心中的正义。"
                },
                {
                    "id": "741870909",
                    "speaker": "小呜斯",
                    "text": "这样就好，那么就暂别了，我想我们还会再见的。"
                }
            ]
        },
        {
            "id": "7418707",
            "objective": "(test)成功分支检测用$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7418702",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741870201",
                    "speaker": "领头的家伙",
                    "text": "喂，你这笨蛋！怎么还剩下这么多宝物在这里，磨磨蹭蹭地要搞到什么时候啊！"
                },
                {
                    "id": "741870202",
                    "speaker": "被称作「笨蛋」的家伙",
                    "text": "不是啊，老大！这些宝藏实在是太重了啊，我们都已经搬了一整天了，结果还有这么多在这里…"
                },
                {
                    "id": "741870203",
                    "speaker": "领头的家伙",
                    "text": "你长这么大块头干什么吃的啊！这些可是宝藏，重一点不是很正常吗！"
                },
                {
                    "id": "741870204",
                    "speaker": "领头的家伙",
                    "text": "况且这些宝藏可都是我们从该死的蛮族手里「收缴」来的…"
                },
                {
                    "id": "741870205",
                    "speaker": "领头的家伙",
                    "text": "哼，那些虫豸只配像猪狗一样生活，把宝藏留在他们手里，可就暴殄天物了啊！"
                },
                {
                    "id": "741870206",
                    "speaker": "被称作「笨蛋」的家伙",
                    "text": "但是，要想把这些宝藏全都运回雷穆利亚的话，无论如何都得让上面再多派几艘船来啊。"
                },
                {
                    "id": "741870207",
                    "speaker": "领头的家伙",
                    "text": "你是笨蛋吗！帝国的运输船怎么可能让我们拿来做这种事情！"
                },
                {
                    "id": "741870208",
                    "speaker": "被称作「笨蛋」的家伙",
                    "text": "既然这样的话，就全部毁掉吧！不管怎样，一点都不能落到那些蛮族的手里！"
                },
                {
                    "id": "741870209",
                    "speaker": "派蒙",
                    "text": "唔，这段对话总感觉似曾相识呢…",
                    "choices": [
                        {
                            "id": "741870210",
                            "text": "刚到佩特莉可镇的时候…",
                            "response": [
                                {
                                    "id": "741870212",
                                    "speaker": "派蒙",
                                    "text": "对啊，之前被我们打跑的那群倒霉的冒险家，不是也说过类似的话吗？"
                                },
                                {
                                    "id": "741870213",
                                    "speaker": "派蒙",
                                    "text": "而且感觉听起来比之前更过分了啊！"
                                },
                                {
                                    "id": "741870214",
                                    "speaker": "派蒙",
                                    "text": "难不成是那些家伙坐的船沉到了水里，然后他们也被变成了魔像？"
                                },
                                {
                                    "id": "741870215",
                                    "speaker": "派蒙",
                                    "text": "不管怎么想也太邪门了！"
                                },
                                {
                                    "id": "741870216",
                                    "speaker": "埃斯特",
                                    "text": "你们是第九军团的人吗，在这里干什么？按照命令，第九军团应该已经撤回卡布狄斯堡了。"
                                },
                                {
                                    "id": "741870217",
                                    "speaker": "领头的家伙",
                                    "text": "喂，埃斯特，你可不要来坏我们的好事啊！"
                                },
                                {
                                    "id": "741870218",
                                    "speaker": "领头的家伙",
                                    "text": "反正对付这些蛮子比对付死鱼还要容易，让我们在这里多玩一会也没什么所谓吧。"
                                },
                                {
                                    "id": "741870219",
                                    "speaker": "埃斯特",
                                    "text": "这些财物…唉，我不知道统辖你们的调律师是如何命令你们的。"
                                },
                                {
                                    "id": "741870220",
                                    "speaker": "埃斯特",
                                    "text": "但至尊命我们征服这些无知的部族，是为了砸碎束缚他们的，命运的镣铐。而你们的所为…毫无疑问是犯罪行为。"
                                },
                                {
                                    "id": "741870221",
                                    "speaker": "领头的家伙",
                                    "text": "哈？我们的长官，伟大的波爱修斯大人可是命令我们要狠狠惩罚这些蛮族啊。"
                                },
                                {
                                    "id": "741870222",
                                    "speaker": "领头的家伙",
                                    "text": "况且我们没有受到任何惩罚，那就说明无论是「福波斯」还是至尊陛下都默认了我们的行动。"
                                },
                                {
                                    "id": "741870223",
                                    "speaker": "领头的家伙",
                                    "text": "你却在这胡说什么犯罪…是故意想找茬吗？"
                                },
                                {
                                    "id": "741870224",
                                    "speaker": "埃斯特",
                                    "text": "但是…"
                                },
                                {
                                    "id": "741870225",
                                    "speaker": "派蒙",
                                    "text": "唔，看起来这里也有个埃斯特呢，事情变得越来越奇怪了！"
                                },
                                {
                                    "id": "741870226",
                                    "speaker": "小呜斯",
                                    "text": "看来现在就是解答之前那个问题的时机了。"
                                },
                                {
                                    "id": "741870227",
                                    "speaker": "小呜斯",
                                    "text": "你们在镇上遇见的那个埃斯特，就是我们雷穆利亚人的后裔。当初他的祖先跟随我加入了新的国家，成为了普通的枫丹人。"
                                },
                                {
                                    "id": "741870228",
                                    "speaker": "小呜斯",
                                    "text": "因此，夺走了枫丹人灵魂的「乐章」对他无效。相对的，记录了他祖先记忆的旋律，则因为无处可去而附着到了那具雕像之上。"
                                },
                                {
                                    "id": "741870229",
                                    "speaker": "派蒙",
                                    "text": "照这么说，这里的埃斯特其实是镇上那个埃斯特的祖先，真正的「机智的埃斯特」？那其他人呢？"
                                },
                                {
                                    "id": "741870230",
                                    "speaker": "小呜斯",
                                    "text": "都是因为迷失在过去的记忆里而徘徊于此的灵魂罢了，我们过去看看吧。"
                                },
                                {
                                    "id": "741870231",
                                    "speaker": "Black Screen",
                                    "text": "你们和呜斯先生一起走上前去…"
                                },
                                {
                                    "id": "741870232",
                                    "speaker": "派蒙",
                                    "text": "你好呀，埃斯特。"
                                },
                                {
                                    "id": "741870233",
                                    "speaker": "埃斯特",
                                    "text": "嗯，你们好，你们是什么人？"
                                },
                                {
                                    "id": "741870234",
                                    "speaker": "埃斯特",
                                    "text": "看起来不是雷穆利亚人啊，该不会是蛮族？",
                                    "choices": [
                                        {
                                            "id": "741870235",
                                            "text": "只是个路过的旅行者。",
                                            "response": [
                                                {
                                                    "id": "741870237",
                                                    "speaker": "埃斯特",
                                                    "text": "这里可是战场啊，很危险。不管你们是什么人，还是赶紧离开吧。"
                                                },
                                                {
                                                    "id": "741870238",
                                                    "speaker": "小呜斯",
                                                    "text": "是我，埃斯特，好久不见。"
                                                },
                                                {
                                                    "id": "741870239",
                                                    "speaker": "埃斯特",
                                                    "text": "…天啊，卡西奥多大人！您以这样的拟态显形还真是少见，我都差点没能认出您来。"
                                                },
                                                {
                                                    "id": "741870240",
                                                    "speaker": "埃斯特",
                                                    "text": "那么这两位…该不会是您的侍从？",
                                                    "choices": [
                                                        {
                                                            "id": "741870241",
                                                            "text": "就当是这样吧。",
                                                            "response": [
                                                                {
                                                                    "id": "741870245",
                                                                    "speaker": "埃斯特",
                                                                    "text": "不过，卡西奥多大人，您怎么会在这里呢，至尊不是派您去…该死，怎么想不起来了，我该不会是在做梦吧？"
                                                                },
                                                                {
                                                                    "id": "741870246",
                                                                    "speaker": "小呜斯",
                                                                    "text": "看起来确实如此。"
                                                                },
                                                                {
                                                                    "id": "741870247",
                                                                    "speaker": "埃斯特",
                                                                    "text": "哈哈，您可真会开玩笑，我看又是至尊给您派下了什么秘密任务吧！"
                                                                },
                                                                {
                                                                    "id": "741870248",
                                                                    "speaker": "小呜斯",
                                                                    "text": "你猜的不错。话说回来，那几个第九军团的士兵，把守着锁链是在做什么？"
                                                                },
                                                                {
                                                                    "id": "741870249",
                                                                    "speaker": "埃斯特",
                                                                    "text": "锁链…您是说那些宝藏吗，看起来是他们在战争中劫掠而来的。"
                                                                },
                                                                {
                                                                    "id": "741870250",
                                                                    "speaker": "埃斯特",
                                                                    "text": "虽然至尊将战争视为达成我们的宏愿而不得不使用的手段，早就禁止了这种残暴的行为。"
                                                                },
                                                                {
                                                                    "id": "741870251",
                                                                    "speaker": "埃斯特",
                                                                    "text": "但是您也知道，这已是相当普遍的事情了…我们正在奔向黑暗的路上，但人们却没有丝毫察觉。"
                                                                },
                                                                {
                                                                    "id": "741870252",
                                                                    "speaker": "埃斯特",
                                                                    "text": "卡西奥多大人，到底发生了什么？「福波斯」本来应该为我们带来幸福，但现在我只感到莫名的痛苦…"
                                                                },
                                                                {
                                                                    "id": "741870253",
                                                                    "speaker": "小呜斯",
                                                                    "text": "我也正在寻找这个问题的答案。不过看起来，我们得先解决眼前的麻烦。"
                                                                },
                                                                {
                                                                    "id": "741870254",
                                                                    "speaker": "埃斯特",
                                                                    "text": "嗯，但是无论如何，他们也是我们军团的成员，还是尽量用和平的方式解决吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741870242",
                                                            "text": "其实我是他的饲主。",
                                                            "response": [
                                                                {
                                                                    "id": "741870243",
                                                                    "speaker": "埃斯特",
                                                                    "text": "…欸？"
                                                                },
                                                                {
                                                                    "id": "741870244",
                                                                    "speaker": "派蒙",
                                                                    "text": "#呜哇，{NICKNAME}，你不要让事情变得更复杂啦。{M#他}{F#她}只是开了个玩笑而已，埃斯特你继续说。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741870236",
                                            "text": "嗯，我也有野蛮的一面。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741870211",
                            "text": "之前遇到的「盗宝团」。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7418706",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741870601",
                    "speaker": "派蒙",
                    "text": "咳咳，第九军团的士兵们。"
                },
                {
                    "id": "741870602",
                    "speaker": "领头的家伙",
                    "text": "嗯？你们又是什么人，该不会是那个埃斯特找来的帮手吧。",
                    "choices": [
                        {
                            "id": "741870603",
                            "text": "的确如此。",
                            "response": [
                                {
                                    "id": "741870604",
                                    "speaker": "派蒙",
                                    "text": "不是普通的帮手，是很强的帮手！我们是跟着卡西奥多大人一起来的。"
                                },
                                {
                                    "id": "741870609",
                                    "speaker": "小呜斯",
                                    "text": "#（看来{NICKNAME}和派蒙也颇有演剧的天分呢。）"
                                },
                                {
                                    "id": "741870610",
                                    "speaker": "领头的家伙",
                                    "text": "嗯…卡西奥多大人吗，我听说伟大的至尊将他派往了埃雷莫利卡，难道这么快就回来了？"
                                },
                                {
                                    "id": "741870611",
                                    "speaker": "派蒙",
                                    "text": "这个嘛，其实我们旁边这只就是…"
                                },
                                {
                                    "id": "741870612",
                                    "speaker": "小呜斯",
                                    "text": "……"
                                },
                                {
                                    "id": "741870613",
                                    "speaker": "派蒙",
                                    "text": "咳，总之，我们是过来视察前线军团的情况的！"
                                },
                                {
                                    "id": "741870614",
                                    "speaker": "领头的家伙",
                                    "text": "好吧，我猜也是这样。"
                                },
                                {
                                    "id": "741870615",
                                    "speaker": "领头的家伙",
                                    "text": "虽然我们没有跟随大部队一起前往卡布狄斯堡…"
                                },
                                {
                                    "id": "741870616",
                                    "speaker": "领头的家伙",
                                    "text": "但作为殿后，留在这里完成最后的「清理」工作，也算是合情合理吧！"
                                },
                                {
                                    "id": "741870617",
                                    "speaker": "Player",
                                    "text": "这也是「福波斯」的命令吗？"
                                },
                                {
                                    "id": "741870618",
                                    "speaker": "领头的家伙",
                                    "text": "这个嘛…「福波斯」本应指引我们的一切行动，但自从来到这里之后，我们却常常无法接收到「福波斯」的旋律。"
                                },
                                {
                                    "id": "741870619",
                                    "speaker": "领头的家伙",
                                    "text": "因此，我们只能按照波爱修斯大人的指示来行动了。",
                                    "choices": [
                                        {
                                            "id": "741870620",
                                            "text": "那个没礼貌的家伙…",
                                            "response": [
                                                {
                                                    "id": "741870621",
                                                    "speaker": "领头的家伙",
                                                    "text": "喂，你这家伙，竟然对波爱修斯大人出言不逊！"
                                                },
                                                {
                                                    "id": "741870622",
                                                    "speaker": "领头的家伙",
                                                    "text": "作为尊贵的调律师，波爱修斯大人凡事都遵照至尊的谕示行动，他的命令就等同于「福波斯」的律令。",
                                                    "choices": [
                                                        {
                                                            "id": "741870626",
                                                            "text": "或许「福波斯」也会犯错。",
                                                            "response": [
                                                                {
                                                                    "id": "741870627",
                                                                    "speaker": "领头的家伙",
                                                                    "text": "你是雷穆利亚人吗？难道你不知道创造「福波斯」的是全能的至尊与无谬的先知？"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "741870628",
                                                            "text": "但你们也没接收到旋律。",
                                                            "response": [
                                                                {
                                                                    "id": "741870629",
                                                                    "speaker": "领头的家伙",
                                                                    "text": "唔…的确如此，但除了「福波斯」我们又能相信什么呢…"
                                                                },
                                                                {
                                                                    "id": "741870630",
                                                                    "speaker": "领头的家伙",
                                                                    "text": "倘若我们走上了歧途，它怎么会无动于衷？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741870623",
                                            "text": "至尊可没让你们残害无辜。",
                                            "response": [
                                                {
                                                    "id": "741870624",
                                                    "speaker": "领头的家伙",
                                                    "text": "残害无辜…虽然在战争开始前，至尊的命令是让我们救助这些脆弱的人类。"
                                                },
                                                {
                                                    "id": "741870625",
                                                    "speaker": "领头的家伙",
                                                    "text": "但现在我们的行为也被「福波斯」所默许，难道「福波斯」的律令会与至尊的圣意相违背吗？",
                                                    "choices": [
                                                        {
                                                            "id": "741870626",
                                                            "text": "或许「福波斯」也会犯错。"
                                                        },
                                                        {
                                                            "id": "741870628",
                                                            "text": "但你们也没接收到旋律。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741870605",
                            "text": "我们是至尊派来的特遣官。",
                            "response": [
                                {
                                    "id": "741870606",
                                    "speaker": "派蒙",
                                    "text": "特遣官是什么…喔，也没错啦，我们是跟着卡西奥多大人一起来的。"
                                }
                            ]
                        },
                        {
                            "id": "741870607",
                            "text": "我们是卡西奥多的侍从。",
                            "response": [
                                {
                                    "id": "741870608",
                                    "speaker": "派蒙",
                                    "text": "没错，我们可是卡西奥多大人的侍从呢！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7418708",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741870801",
                    "speaker": "领头的家伙",
                    "text": "话说回来，你这家伙，该不会是狡猾的蛮族假扮的，在这里妖言惑众想要诓骗我等吧！"
                },
                {
                    "id": "741870802",
                    "speaker": "领头的家伙",
                    "text": "该死的虫豸，给我受死吧！"
                }
            ]
        },
        {
            "id": "7418710",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741871001",
                    "speaker": "埃斯特",
                    "text": "那些人无论如何也是我们军团的成员，请尽量用和平的方式解决吧。"
                }
            ]
        },
        {
            "id": "7418711",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741871101",
                    "speaker": "埃斯特",
                    "text": "神王在上，多亏了卡西奥多大人。无论如何，总算是暂时解决了。"
                }
            ]
        },
        {
            "id": "7418712",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "741871201",
                    "speaker": "领头的家伙",
                    "text": "「福波斯」是绝对完美的造物，作为雷穆利亚人，我劝你还是不要质疑为好。",
                    "choices": [
                        {
                            "id": "741871202",
                            "text": "完美？没有什么是完美的。",
                            "response": [
                                {
                                    "id": "741871203",
                                    "speaker": "领头的家伙",
                                    "text": "你是在和我讨论哲学吗，这话你应该去和王城里那些博学的乐师说。军人的天职是服从命令，太复杂的问题我可搞不懂…"
                                }
                            ]
                        },
                        {
                            "id": "741871204",
                            "text": "「福波斯」的沉默意味着拒绝。",
                            "response": [
                                {
                                    "id": "741871205",
                                    "speaker": "领头的家伙",
                                    "text": "确实…确实有这样的可能，我竟然没有考虑到。难道是因为我们的肆意妄为才导致「福波斯」不再给予我们指引？"
                                },
                                {
                                    "id": "741871206",
                                    "speaker": "领头的家伙",
                                    "text": "要是这样的话可就糟了，唔…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}