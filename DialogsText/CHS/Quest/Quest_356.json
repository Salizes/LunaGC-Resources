    "talks": [
        {
            "id": "35601",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "3560101",
                    "speaker": "安柏",
                    "text": "容我正式介绍，风与蒲公英的牧歌之城，自由之都——"
                },
                {
                    "id": "3560102",
                    "speaker": "安柏",
                    "text": "受西风骑士团庇护的旅人们，欢迎来到蒙德城！"
                },
                {
                    "id": "3560103",
                    "speaker": "派蒙",
                    "text": "终于不用在荒野露宿啦。"
                },
                {
                    "id": "3560104",
                    "speaker": "派蒙",
                    "text": "不过城里的大家…精神都不太好的样子。"
                },
                {
                    "id": "3560105",
                    "speaker": "安柏",
                    "text": "因为最近全城都在烦恼风魔龙的事吧。"
                },
                {
                    "id": "3560106",
                    "speaker": "安柏",
                    "text": "但有琴在的话，一切都不会有问题的！"
                },
                {
                    "id": "3560107",
                    "speaker": "派蒙",
                    "text": "琴？"
                },
                {
                    "id": "3560108",
                    "speaker": "安柏",
                    "text": "西风骑士团代理团长——琴。蒙德的守护者。"
                },
                {
                    "id": "3560109",
                    "speaker": "安柏",
                    "text": "与琴同在的我们，即使是风魔龙这种级别的灾害，也一定能够战胜的。",
                    "choices": [
                        {
                            "id": "3560110",
                            "text": "（看来是一位大人物…）",
                            "response": [
                                {
                                    "id": "3560112",
                                    "speaker": "安柏",
                                    "text": "#对了，在一起去骑士团总部之前，我有礼物要送给{NICKNAME}。"
                                },
                                {
                                    "id": "3560113",
                                    "speaker": "安柏",
                                    "text": "是刚才帮我清理丘丘人营地的酬谢喔。"
                                },
                                {
                                    "id": "3560114",
                                    "speaker": "派蒙",
                                    "text": "见，见者有份！为什么我没有礼物？"
                                },
                                {
                                    "id": "3560115",
                                    "speaker": "安柏",
                                    "text": "嗯…因为那是小派蒙没法用的东西吧。"
                                },
                                {
                                    "id": "3560116",
                                    "speaker": "安柏",
                                    "text": "但我今晚会请你吃蒙德特色的蜜酱胡萝卜煎肉。"
                                },
                                {
                                    "id": "3560117",
                                    "speaker": "派蒙",
                                    "text": "蜜酱胡萝卜煎肉！"
                                },
                                {
                                    "id": "3560118",
                                    "speaker": "安柏",
                                    "text": "现在就先跟我来吧，我们要去城区的…<color=#00E1FFFF>高处</color>。"
                                }
                            ]
                        },
                        {
                            "id": "3560111",
                            "text": "（希望她能知道关于风神的事…）"
                        }
                    ]
                }
            ]
        },
        {
            "id": "35602",
            "objective": "(test)跟随安柏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "35603",
            "objective": "前往安柏指示的地点",
            "dialogues": []
        },
        {
            "id": "35604",
            "objective": "与安柏对话",
            "dialogues": [
                {
                    "id": "3560401",
                    "speaker": "安柏",
                    "text": "那么，说好的礼物就是——"
                },
                {
                    "id": "3560402",
                    "speaker": "安柏",
                    "text": "<color=#00E1FFFF>风之翼</color>！"
                },
                {
                    "id": "3560403",
                    "speaker": "安柏",
                    "text": "侦察骑士靠它在天空中行动，蒙德的市民们也很喜欢用。"
                },
                {
                    "id": "3560404",
                    "speaker": "安柏",
                    "text": "我特地把你叫到这里来，就是为了让你第一时间感受到它的好处！"
                },
                {
                    "id": "3560405",
                    "speaker": "派蒙",
                    "text": "是正在热心推荐的语气呢。"
                },
                {
                    "id": "3560406",
                    "speaker": "安柏",
                    "text": "因为「风」是蒙德的灵魂嘛。"
                },
                {
                    "id": "3560407",
                    "speaker": "安柏",
                    "text": "好了，赶快来试试风之翼的性能吧。"
                },
                {
                    "id": "3560408",
                    "speaker": "安柏",
                    "text": "虽然操作起来很简单，但你一定要听我指示。"
                }
            ]
        },
        {
