    "talks": [
        {
            "id": "7505301",
            "objective": "(test)与老板对话$HIDDEN",
            "dialogues": [
                {
                    "id": "750530101",
                    "speaker": "穆蒲",
                    "text": "嗬，异邦人，眼神不错…怎么样，来试试，「目随羽视」的挑战？"
                },
                {
                    "id": "750530102",
                    "speaker": "穆蒲",
                    "text": "锻炼视力…也能，得到嘉奖。"
                },
                {
                    "id": "750530103",
                    "speaker": "派蒙",
                    "text": "哦哦，真是简洁的说明…也像是什么都没说…"
                },
                {
                    "id": "750530104",
                    "speaker": "穆蒲",
                    "text": "详细的规则，还在后头…如果你们，想要试试看？"
                },
                {
                    "id": "750530105",
                    "speaker": "Player",
                    "text": "那就听听看吧…"
                },
                {
                    "id": "750530106",
                    "speaker": "穆蒲",
                    "text": "三只绒翼龙，会往外飞，盯住中间那只…"
                },
                {
                    "id": "750530107",
                    "speaker": "穆蒲",
                    "text": "等它们都飞回，<color=#00E1FFFF>认出…原本在中间的那只</color>，就是这样。"
                },
                {
                    "id": "750530108",
                    "speaker": "派蒙",
                    "text": "唔，也就是说，这三只会在空中变换位置，我们得找到原本在中间的那只？"
                },
                {
                    "id": "750530109",
                    "speaker": "穆蒲",
                    "text": "很对。"
                },
                {
                    "id": "750530110",
                    "speaker": "派蒙",
                    "text": "怪不得说这个挑战能够锻炼视力呢。"
                },
                {
                    "id": "750530111",
                    "speaker": "穆蒲",
                    "text": "先来点，简单的，试试水？"
                },
                {
                    "id": "750530112",
                    "speaker": "穆蒲",
                    "text": "如果没问题，我们再，正式玩一把。"
                },
                {
                    "id": "750530113",
                    "speaker": "穆蒲",
                    "text": "挑战成功，奖励归你。",
                    "choices": [
                        {
                            "id": "750530114",
                            "text": "还有别的事，之后再来。",
                            "response": [
                                {
                                    "id": "750530115",
                                    "speaker": "穆蒲",
                                    "text": "好，反正，我一直在这。"
                                }
                            ]
                        },
                        {
                            "id": "750530116",
                            "text": "那就试试吧。",
                            "response": [
                                {
                                    "id": "750530117",
                                    "speaker": "穆蒲",
                                    "text": "准备好，就击打，靶子，开始吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7505302",
            "objective": "(test)完成玩法$HIDDEN",
            "dialogues": [
                {
                    "id": "750530201",
                    "speaker": "穆蒲",
                    "text": "「目随羽视」挑战，要试试吗？"
                },
                {
                    "id": "750530202",
                    "speaker": "Player",
                    "text": "我忘记规则了…"
                },
                {
                    "id": "750530203",
                    "speaker": "穆蒲",
                    "text": "三只绒翼龙，会往外飞，盯住中间那只…"
                },
                {
                    "id": "750530204",
                    "speaker": "穆蒲",
                    "text": "等它们都飞回，<color=#00E1FFFF>认出…原本在中间的那只</color>，就可以了。",
                    "choices": [
                        {
                            "id": "750530207",
                            "text": "那就试试吧。",
                            "response": [
                                {
                                    "id": "750530208",
                                    "speaker": "穆蒲",
                                    "text": "准备好，就击打，靶子，开始吧！"
                                }
                            ]
                        },
                        {
                            "id": "750530205",
                            "text": "还有别的事，之后再来。",
                            "response": [
                                {
                                    "id": "750530206",
                                    "speaker": "穆蒲",
                                    "text": "好，反正，我一直在这。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7505303",
            "objective": "(test)最后与老板对话$HIDDEN",
            "dialogues": [
                {
                    "id": "750530301",
                    "speaker": "穆蒲",
                    "text": "已经没有奖赏，自然没有，「目随羽视」挑战。"
                },
                {
                    "id": "750530302",
                    "speaker": "穆蒲",
                    "text": "难道有，其他的，问题？",
                    "choices": [
                        {
                            "id": "750530303",
                            "text": "关于「目随羽视」…",
                            "response": [
                                {
                                    "id": "750530304",
                                    "speaker": "穆蒲",
                                    "text": "那是，很久以前，部族，流传下来…"
                                },
                                {
                                    "id": "750530305",
                                    "speaker": "穆蒲",
                                    "text": "因为「花羽会」，锐利的眼睛，很是重要。"
                                },
                                {
                                    "id": "750530306",
                                    "speaker": "穆蒲",
                                    "text": "这一代，就由，我来主持，负责。"
                                }
                            ]
                        },
                        {
                            "id": "750530307",
                            "text": "为什么说话很慢…",
                            "response": [
                                {
                                    "id": "750530308",
                                    "speaker": "穆蒲",
                                    "text": "以前，受过伤，从很高的地方…摔下…"
                                },
                                {
                                    "id": "750530309",
                                    "speaker": "穆蒲",
                                    "text": "喉咙，和胸口，让我不能…如以往一样，说话。"
                                },
                                {
                                    "id": "750530310",
                                    "speaker": "穆蒲",
                                    "text": "但我，不觉得…现在…很糟糕。"
                                }
                            ]
                        },
                        {
                            "id": "750530311",
                            "text": "不，没什么问题。",
                            "response": [
                                {
                                    "id": "750530312",
                                    "speaker": "穆蒲",
                                    "text": "祝福你…再见。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
