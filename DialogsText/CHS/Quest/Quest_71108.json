        {
            "id": "7110802",
            "objective": "探索藏书阁",
            "dialogues": [
                {
                    "id": "711080201",
                    "speaker": "《古华手记》",
                    "text": "(test)今天开始写日记了，习武多年，我要留下一本惊世著作，将我的武学传于后世有缘人！第一天，养猪。",
                    "choices": [
                        {
                            "id": "711080202",
                            "text": "(test)继续读",
                            "response": [
                                {
                                    "id": "711080204",
                                    "speaker": "《古华手记》",
                                    "text": "(test)第二天，养猪。第三天，古华啊古华，你怎能如此堕落，说好的要将武功记录下来呢？",
                                    "choices": [
                                        {
                                            "id": "711080205",
                                            "text": "(test)继续读",
                                            "response": [
                                                {
                                                    "id": "711080207",
                                                    "speaker": "《古华手记》",
                                                    "text": "(test)第四天，养猪。",
                                                    "choices": [
                                                        {
                                                            "id": "711080208",
                                                            "text": "(test)继续读",
                                                            "response": [
                                                                {
                                                                    "id": "711080211",
                                                                    "speaker": "《古华手记》",
                                                                    "text": "(test)第五天，养猪真没意思，明天去沉玉谷附近走走，试试我的猪脚好了"
                                                                },
                                                                {
                                                                    "id": "711080212",
                                                                    "speaker": "Player",
                                                                    "text": "(test)不读了"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "711080209",
                                                            "text": "(test)不读了"
                                                        },
                                                        {
                                                            "id": "711080210",
                                                            "text": "(test)好像有一行小字",
                                                            "response": [
                                                                {
                                                                    "id": "711080213",
                                                                    "speaker": "《古华手记》",
                                                                    "text": "(test)辅以神明的实现，把猪放到对的猪圈里，才能去我古华专用养猪场！"
                                                                },
                                                                {
                                                                    "id": "711080214",
