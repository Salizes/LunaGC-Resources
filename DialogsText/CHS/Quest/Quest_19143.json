            "objective": "（test）抓捕一保底$HIDDEN",
            "dialogues": [
                {
                    "id": "191430301",
                    "speaker": "奏太",
                    "text": "真可气！"
                },
                {
                    "id": "191430302",
                    "speaker": "由真",
                    "text": "是啊！怎么回事儿！"
                },
                {
                    "id": "191430303",
                    "speaker": "瑛太",
                    "text": "有人占了我们的秘密基地！"
                },
                {
                    "id": "191430304",
                    "speaker": "久岐忍",
                    "text": "我知道怎么回事儿了"
                }
            ]
        },
        {
            "id": "1914301",
            "objective": "寻找阿守等人的踪迹",
            "dialogues": [
                {
                    "id": "191430901",
                    "speaker": "蓝川丞",
                    "text": "刚才我在馆里打扫的时候，外面突然吵闹了起来。"
                },
                {
                    "id": "191430902",
                    "speaker": "蓝川丞",
                    "text": "我刚一出门，就看到…<color=#00E1FFFF>有个黑影从树下一下子窜了上去！</color>"
                },
                {
                    "id": "191430903",
                    "speaker": "蓝川丞",
                    "text": "这人来人往的，不会是什么小偷强盗吧…"
                }
            ]
        },
        {
            "id": "1914302",
            "objective": "前往「秋沙钱汤」上方探查",
            "dialogues": []
        },
        {
            "id": "1914306",
            "objective": "（test）抓捕二保底$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1914304",
            "objective": "寻找元太等人的踪迹",
            "dialogues": [
                {
                    "id": "191431001",
                    "speaker": "奏太",
                    "text": "怎么办？难道今天就玩不了《七圣召唤》了吗？"
                },
                {
                    "id": "191431002",
                    "speaker": "瑛太",
                    "text": "要不然换个地方？可是除了桥底下，还有什么地方不容易被大人发现啊…"
                },
                {
                    "id": "191431003",
                    "speaker": "奏太",
                    "text": "啊啊…干脆去请宵宫姐姐放点烟花，把占地方的人给吓出来吧！"
                },
                {
                    "id": "191431004",
                    "speaker": "瑛太",
                    "text": "这不太好吧？虽然确实是他先动手把我们赶出来的…"
                },
                {
                    "id": "191431005",
                    "speaker": "奏太",
                    "text": "所以全都是他不好嘛！"
                },
                {
                    "id": "191431006",
                    "speaker": "由真",
                    "text": "我觉得…我们是不是，该回家写作业了？"
                },
                {
                    "id": "191431007",
                    "speaker": "由真",
                    "text": "老是打牌不学习的话，将来不会也变成<color=#00E1FFFF>桥底下那种大人</color>吧？"
                }
            ]
        },
        {
            "id": "1914305",
            "objective": "前往桥下进行探查",
            "dialogues": []
        },
        {
            "id": "1914307",
            "objective": "前往稻妻城外",
            "dialogues": []
        },
        {
            "id": "1914309",
            "objective": "前往北方进行探查",
            "dialogues": []
        },
        {
            "id": "1914308",
            "objective": "（test）向海边靠近",
            "dialogues": []
        },
        {
            "id": "1914301",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191430101",
                    "speaker": "松本",
                    "text": "有谁路过这里？不好意思，刚刚我一心在品鉴这儿的柠檬水…"
                },
                {
                    "id": "191430102",
                    "speaker": "松本",
                    "text": "要打听消息的话，不如问问对面温泉馆的人吧。"
                }
            ]
        },
        {
            "id": "1914311",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191431101",
                    "speaker": "久岐忍",
                    "text": "你们先待在此地，不要走动，明白了吗？"
                },
                {
                    "id": "191431102",
                    "speaker": "阿守",
                    "text": "明、明白了，我们是真的跑不动了…"
                },
                {
                    "id": "191431103",
                    "speaker": "久岐忍",
                    "text": "现在是跑不动，等缓过劲，不会又想逃跑吧。"
                },
                {
                    "id": "191431104",
                    "speaker": "元太",
                    "text": "不敢不敢！我们再也不敢了！"
                }
            ]
        },
        {
            "id": "1914399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191439901",
                    "speaker": "久岐忍",
                    "text": "「秋沙钱汤」的老板…好像在张望什么？"
                }
            ]
        }
    ]
