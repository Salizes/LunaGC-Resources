    "talks": [
        {
            "id": "7080301",
            "objective": "(test)隐藏等待一天$HIDDEN",
            "dialogues": [
                {
                    "id": "708030101",
                    "speaker": "派蒙",
                    "text": "咦？这个人是…",
                    "choices": [
                        {
                            "id": "708030102",
                            "text": "难道是乔尔的父亲？",
                            "response": [
                                {
                                    "id": "708030104",
                                    "speaker": "冒失的帕拉德",
                                    "text": "喔！你来了啊，旅行者。"
                                },
                                {
                                    "id": "708030105",
                                    "speaker": "冒失的帕拉德",
                                    "text": "我介绍一下，这位就是乔尔的父亲，乔瑟夫先生。"
                                },
                                {
                                    "id": "708030106",
                                    "speaker": "乔尔",
                                    "text": "爸爸！这位就是我和你说的旅行者，之前帮过我好多好多忙，这次还陪我一起堆雪人呢。"
                                },
                                {
                                    "id": "708030107",
                                    "speaker": "乔瑟夫",
                                    "text": "乔尔都和我说了，哎呀，真是太感谢你了。",
                                    "choices": [
                                        {
                                            "id": "708030108",
                                            "text": "团圆就好…",
                                            "response": [
                                                {
                                                    "id": "708030110",
                                                    "speaker": "派蒙",
                                                    "text": "是啊，这真是天大的好事了！"
                                                },
                                                {
                                                    "id": "708030111",
                                                    "speaker": "塞琉斯",
                                                    "text": "帕拉德，这次你算是立了一个大功，干得不错！"
                                                },
                                                {
                                                    "id": "708030112",
                                                    "speaker": "派蒙",
                                                    "text": "又？帕拉德又做什么了？"
                                                },
                                                {
                                                    "id": "708030113",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "你们还记得，我之前说在雪山里看见了一个人影吧？"
                                                },
                                                {
                                                    "id": "708030114",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "那天你们陪我进了雪山，又帮我打倒了那些魔物之后，我又开始在周围搜索。"
                                                },
                                                {
                                                    "id": "708030115",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "在搜索的时候，我一个不小心从山上滚了下去…"
                                                },
                                                {
                                                    "id": "708030116",
                                                    "speaker": "派蒙",
                                                    "text": "滚、滚了下去…"
                                                },
                                                {
                                                    "id": "708030117",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "还好下面的雪层很厚，我没有受伤。"
                                                },
                                                {
                                                    "id": "708030118",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "正当我准备找回去的路时，突然听见旁边有响动，一个人突然钻了出来。"
                                                },
                                                {
                                                    "id": "708030119",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "我当时没有意识到他就是我要找的人，还以为是和我一样进山搜救的冒险家。"
                                                },
                                                {
                                                    "id": "708030120",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "但聊了几句才发现，好多事情他都记不得了，连自己的名字都不知道。"
                                                },
                                                {
                                                    "id": "708030121",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "当时我来不及多想，雪山上太冷了，我赶紧催他跟我一起翻山回营地，有什么事等回来再说！"
                                                },
                                                {
                                                    "id": "708030122",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "回到营地，我们见到了乔尔，乔尔一见到他就愣住了，跟着大叫起来：「爸爸！」他就是在这个时候突然回忆起一些事情的。"
                                                },
                                                {
                                                    "id": "708030123",
                                                    "speaker": "乔尔",
                                                    "text": "爸爸…"
                                                },
                                                {
                                                    "id": "708030124",
                                                    "speaker": "乔瑟夫",
                                                    "text": "乔尔，爸爸在，爸爸在。"
                                                },
                                                {
                                                    "id": "708030125",
                                                    "speaker": "派蒙",
                                                    "text": "乔瑟夫先生，真的想不起其他事情了吗？"
                                                },
                                                {
                                                    "id": "708030126",
                                                    "speaker": "派蒙",
                                                    "text": "《野猪公主》、还有雪山上你喂过的狐狸们…"
                                                },
                                                {
                                                    "id": "708030127",
                                                    "speaker": "乔瑟夫",
                                                    "text": "很抱歉，我没有印象了。或许是因为脑袋受了外伤？我也不清楚了…"
                                                },
                                                {
                                                    "id": "708030128",
                                                    "speaker": "乔瑟夫",
                                                    "text": "当我醒来的时候，身上全是血。就连行李也丢了，没有能够证明身份的东西。"
                                                },
                                                {
                                                    "id": "708030129",
                                                    "speaker": "乔瑟夫",
                                                    "text": "我只能爬进一个山洞，安顿下来慢慢养伤，在腿脚恢复点之后，靠打猎的本能才活了下来。"
                                                },
                                                {
                                                    "id": "708030130",
                                                    "speaker": "乔尔",
                                                    "text": "爸爸…我真的好担心你。"
                                                },
                                                {
                                                    "id": "708030131",
                                                    "speaker": "乔瑟夫",
                                                    "text": "没事没事，乔尔不哭，爸爸这次哪里也不去了，就陪在你身边。"
                                                },
                                                {
                                                    "id": "708030132",
                                                    "speaker": "派蒙",
                                                    "text": "乔瑟夫先生，那你接下来准备怎么办？"
                                                },
                                                {
                                                    "id": "708030133",
                                                    "speaker": "乔瑟夫",
                                                    "text": "我…现在只想再和我的家人们多待一会。"
                                                },
                                                {
                                                    "id": "708030134",
                                                    "speaker": "塞琉斯",
                                                    "text": "能回来就好。这件事也算是有了个完美的结局了，哈哈哈。"
                                                },
                                                {
                                                    "id": "708030135",
                                                    "speaker": "塞琉斯",
                                                    "text": "不过，帕拉德，在搜索的过程中居然能失足滚下山去，你的冒险能力还需要再加强啊…"
                                                },
                                                {
                                                    "id": "708030136",
                                                    "speaker": "塞琉斯",
                                                    "text": "回去协会，我得好好再给你补课了。"
                                                },
                                                {
                                                    "id": "708030137",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "欸？塞、塞琉斯会长…我不是都立功了吗！"
                                                },
                                                {
                                                    "id": "708030138",
                                                    "speaker": "塞琉斯",
                                                    "text": "走了！回协会去！"
                                                },
                                                {
                                                    "id": "708030139",
                                                    "speaker": "冒失的帕拉德",
                                                    "text": "会长！你就饶了我吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "708030109",
                                            "text": "没事就好…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "708030103",
                            "text": "大号的乔尔…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7080302",
            "objective": "前往雪山下的营地",
            "dialogues": []
        }
    ]
