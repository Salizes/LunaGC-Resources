        {
            "id": "7414908",
            "objective": "完成打工",
            "dialogues": []
        },
        {
            "id": "7414907",
            "objective": "(test)回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "741490701",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "忘了我请你们做什么事了吗？小孩子的记性啊，哈哈。"
                },
                {
                    "id": "741490702",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "一件是帮我清理家门口和屋后的污迹，一件是喂我的猫，娜娜，一点鱼肉。"
                }
            ]
        },
        {
            "id": "7414905",
            "objective": "向勒鲁瓦先生回报",
            "dialogues": [
                {
                    "id": "741490501",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "你们忙完了啊？"
                },
                {
                    "id": "741490502",
                    "speaker": "派蒙",
                    "text": "是的，勒鲁瓦先生。那个…"
                },
                {
                    "id": "741490503",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "想要糖果还是想要报酬当零花钱使啊？"
                },
                {
                    "id": "741490504",
                    "speaker": "派蒙",
                    "text": "都、都想要，嘿嘿。"
                },
                {
                    "id": "741490505",
                    "speaker": "Player",
                    "text": "派蒙…"
                },
                {
                    "id": "741490506",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "贪心的孩子，哈哈哈。没关系，小孩子嘛，就是这样的。"
                },
                {
                    "id": "741490507",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "尤其是像派蒙这样可爱的小姑娘，就应该吃着马卡龙，穿着漂亮的小裙子，住在漂亮的屋子里。"
                },
                {
                    "id": "741490508",
                    "speaker": "派蒙",
                    "text": "#我也这么觉得！{NICKNAME}，{NICKNAME}，我可不可以买…"
                },
                {
                    "id": "741490509",
                    "speaker": "Player",
                    "text": "不可以。"
                },
                {
                    "id": "741490510",
                    "speaker": "派蒙",
                    "text": "#呜呜，讨厌，{NICKNAME}好吝啬。",
                    "choices": [
                        {
                            "id": "741490511",
                            "text": "派蒙，我们是冒险家…",
                            "response": [
                                {
                                    "id": "741490513",
                                    "speaker": "派蒙",
                                    "text": "但是这跟马卡龙、小裙子还有漂亮的大房子有什么矛盾嘛。"
                                },
                                {
                                    "id": "741490514",
                                    "speaker": "伯努瓦·勒鲁瓦",
                                    "text": "看你们两个，怎么斗起嘴来了？真是孩子气。不过能像这样斗嘴也很好，证明你们还是孩子。",
                                    "choices": [
                                        {
                                            "id": "741490515",
                                            "text": "其实我的年纪…",
                                            "response": [
                                                {
                                                    "id": "741490517",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "童年是不长久的，要珍惜啊。"
                                                },
                                                {
                                                    "id": "741490518",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "好了好了，报酬和甜点都给你们，这下别闹了。"
                                                },
                                                {
                                                    "id": "741490519",
                                                    "speaker": "派蒙",
                                                    "text": "好耶，有点心！谢谢勒鲁瓦先生！"
                                                },
                                                {
                                                    "id": "741490520",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "称呼我伯努瓦就可以了，勒鲁瓦是我的姓氏。"
                                                },
                                                {
                                                    "id": "741490521",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "整个枫丹廷现在只有我一个勒鲁瓦了，特地强调姓氏只会让我这个老人寂寞，还是称呼名字吧。"
                                                },
                                                {
                                                    "id": "741490522",
                                                    "speaker": "派蒙",
                                                    "text": "勒…伯努瓦的女儿难道不姓勒鲁瓦吗？"
                                                },
                                                {
                                                    "id": "741490523",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "莫蒂西娅她不是我血缘上的女儿，只是我半年前收养的女儿。不过对我来说，她就和亲生的女儿一样。"
                                                },
                                                {
                                                    "id": "741490524",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "你们乐意的话，明天也可以来，那时候莫蒂西娅和阿托斯就回来了。"
                                                },
                                                {
                                                    "id": "741490525",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "请两个可爱的孩子帮点小忙，吃些点心，我想莫蒂西娅是不会有意见的。"
                                                },
                                                {
                                                    "id": "741490526",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "偶尔也会有其他孩子到我这里来，你们可以一起玩。我很喜欢小孩子，小孩子多，家里热闹。"
                                                },
                                                {
                                                    "id": "741490527",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "以后你们来的时候，如果没有见到我就敲门问问，阿托斯会给你们开门的。"
                                                },
                                                {
                                                    "id": "741490528",
                                                    "speaker": "派蒙",
                                                    "text": "那就说好啦，明天我们会再来的哦。"
                                                },
                                                {
                                                    "id": "741490529",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "好，好，正好我也要进屋了。"
                                                },
                                                {
                                                    "id": "741490530",
                                                    "speaker": "Player",
                                                    "text": "明天再见。"
                                                },
                                                {
                                                    "id": "741490531",
                                                    "speaker": "伯努瓦·勒鲁瓦",
                                                    "text": "再会，孩子们。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "741490516",
                                            "text": "这是关系好的证明。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "741490512",
                            "text": "派蒙，不要忘记旅行的目的…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7414999",
