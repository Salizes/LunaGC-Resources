    "talks": [
        {
            "id": "7414901",
            "objective": "与欧芙对话$HIDDEN",
            "dialogues": [
                {
                    "id": "741490101",
                    "speaker": "Player",
                    "text": "关于新工作…"
                },
                {
                    "id": "741490102",
                    "speaker": "欧芙",
                    "text": "哦？看来对你而言，「人间百态」的委托工作太没挑战性了。还是说最近你手头紧，缺摩拉了呢？",
                    "choices": [
                        {
                            "id": "741490103",
                            "text": "摩拉永远不嫌多。",
                            "response": [
                                {
                                    "id": "741490104",
                                    "speaker": "欧芙",
                                    "text": "嗯哼，这种心态倒是常见。"
                                },
                                {
                                    "id": "741490107",
                                    "speaker": "欧芙",
                                    "text": "我这里最不缺的就是委托工作，除了冒险家协会，蒸汽鸟报社大概算是全枫丹廷最大的雇佣信息集散地了。"
                                },
                                {
                                    "id": "741490108",
                                    "speaker": "欧芙",
                                    "text": "虽然理论上来说，我们没必要承担这样的社会功能。"
                                },
                                {
                                    "id": "741490109",
                                    "speaker": "欧芙",
                                    "text": "总之，既然你需要摩拉，那我给你推荐一个长期的工作吧。"
                                },
                                {
                                    "id": "741490110",
                                    "speaker": "欧芙",
                                    "text": "这是勒鲁瓦先生大半年前给我们「人间百态」版块的留言，勒鲁瓦先生我们这条街的人都认识。"
                                },
                                {
                                    "id": "741490111",
                                    "speaker": "欧芙",
                                    "text": "虽然他年轻的时候名声不太好，不过这些年我倒是没再听说过他有什么不好的传闻。"
                                },
                                {
                                    "id": "741490112",
                                    "speaker": "欧芙",
                                    "text": "他一辈子独身，唯一的女儿又不在身边，身边没人照顾，确实需要一位钟点工帮忙。"
                                },
                                {
                                    "id": "741490113",
                                    "speaker": "欧芙",
                                    "text": "据我所知，勒鲁瓦先生不缺钱，所以给的报酬应该不会太低。"
                                },
                                {
                                    "id": "741490114",
                                    "speaker": "欧芙",
                                    "text": "我想这份工作没什么风险，报酬也不错，不妨考虑看看。"
                                },
                                {
                                    "id": "741490115",
                                    "speaker": "派蒙",
                                    "text": "只要帮忙做做家务就好了吗？我觉得这份工作好！"
                                },
                                {
                                    "id": "741490116",
                                    "speaker": "Player",
                                    "text": "请给我联络地址。"
                                },
                                {
                                    "id": "741490117",
                                    "speaker": "欧芙",
                                    "text": "好啊，勒鲁瓦先生的房子你转过两个街角，然后再绕到…啊算了，我给你一张地图吧。"
                                },
                                {
                                    "id": "741490118",
                                    "speaker": "欧芙",
                                    "text": "记得跟他说是我介绍你们去的哦。"
                                }
                            ]
                        },
                        {
                            "id": "741490105",
                            "text": "都有。",
                            "response": [
                                {
                                    "id": "741490106",
                                    "speaker": "欧芙",
                                    "text": "还真是个努力的年轻人啊，也好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7414902",
            "objective": "寻找勒鲁瓦先生",
            "dialogues": [
                {
                    "id": "741490201",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "阿托斯的衬衫一千摩拉…莫蒂西娅的项链…啧啧，现在的年轻人真会花钱啊。"
                },
                {
                    "id": "741490202",
                    "speaker": "Player",
                    "text": "你好，勒鲁瓦先生。"
                },
                {
                    "id": "741490203",
                    "speaker": "派蒙",
                    "text": "你好呀，我们是从欧芙小姐那里来的。"
                },
                {
                    "id": "741490204",
                    "speaker": "Black Screen",
                    "text": "你们向勒鲁瓦先生说明了来意。"
                },
                {
                    "id": "741490205",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "哈哈，这都是大半年之前的事情了，欧芙小姐居然还留着我当时的委托记录。"
                },
                {
                    "id": "741490206",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "没错，我的确是有过招募钟点工的想法。人不管年轻的时候多能干，到老了总归需要别人照顾。"
                },
                {
                    "id": "741490207",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "我辛苦了一辈子赚了这么一栋房子，到老了，发现自己孤零零一个人。"
                },
                {
                    "id": "741490208",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "之前我的确是为这件事难受过一阵，好在这会儿我有女儿和女婿来照顾我了。"
                },
                {
                    "id": "741490209",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "这两个好孩子乖巧又相爱，有他们陪伴，我没有什么不满意的了。"
                },
                {
                    "id": "741490210",
                    "speaker": "伯努瓦·勒鲁瓦",
                    "text": "所以说呢，年轻人，我现在已经不需要招募护工了。",
                    "choices": [
                        {
                            "id": "741490211",
                            "text": "可惜白跑一趟…",
                            "response": [
                                {
                                    "id": "741490213",
                                    "speaker": "伯努瓦·勒鲁瓦",
                                    "text": "你们也别失望嘛，我最不喜欢看到年轻人失落的样子，年轻人就应该微笑着享受一切美好的东西。"
                                },
                                {
                                    "id": "741490214",
                                    "speaker": "伯努瓦·勒鲁瓦",
                                    "text": "毕竟你们特意跑了这一趟，又是报社的欧芙小姐推荐你们来的，我这里还是有些活请你们做的。"
                                },
                                {
                                    "id": "741490215",
                                    "speaker": "伯努瓦·勒鲁瓦",
                                    "text": "正好，我的孩子们出门去了，这会儿不在家，我一个人也忙不动。当然，报酬一样会给。"
                                },
                                {
                                    "id": "741490216",
                                    "speaker": "派蒙",
                                    "text": "哇，勒鲁瓦先生，你真是个大好人！"
                                },
                                {
                                    "id": "741490217",
                                    "speaker": "伯努瓦·勒鲁瓦",
                                    "text": "哈哈哈，这孩子嘴巴真甜。"
                                },
                                {
                                    "id": "741490218",
                                    "speaker": "伯努瓦·勒鲁瓦",
                                    "text": "去吧，帮我清扫一下门口和屋后的污迹，顺便喂娜娜点鱼肉。"
                                },
                                {
                                    "id": "741490219",
                                    "speaker": "伯努瓦·勒鲁瓦",
                                    "text": "哦，娜娜是我的猫，就是门口那只。我先代它感谢你们了。"
                                },
                                {
                                    "id": "741490220",
                                    "speaker": "派蒙",
                                    "text": "听起来很简单嘛，没问题，交给我们吧。"
                                }
                            ]
                        },
                        {
                            "id": "741490212",
                            "text": "欧芙小姐真是的…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7414906",
            "objective": "完成打工$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7414903",
            "objective": "完成打工",
