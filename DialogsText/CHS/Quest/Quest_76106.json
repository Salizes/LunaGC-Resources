    },
    "talks": [
        {
            "id": "7610601",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "761060401",
                    "speaker": "Player",
                    "text": "堂堂愚人众就只有这种程度的本领？"
                },
                {
                    "id": "761060402",
                    "speaker": "沃莉斯菈娃",
                    "text": "现在的新人说话怎么都这么呛人呢…等一下，仔细看你好像不是这次招进来的新人啊！"
                },
                {
                    "id": "761060403",
                    "speaker": "沃莉斯菈娃",
                    "text": "还企图撒谎混入我们的队伍，被我看穿了吧？给我拿下！"
                }
            ]
        },
        {
            "id": "7610601",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761060101",
                    "speaker": "沃莉斯菈娃",
                    "text": "嗯？你看上去有点面生，是新来的对吧？"
                }
            ]
        },
        {
            "id": "7610602",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761060201",
                    "speaker": "Player",
                    "text": "…嗯。"
                },
                {
                    "id": "761060202",
                    "speaker": "沃莉斯菈娃",
                    "text": "我可是为你好。没事别到设计局里边去，尤其是二层！要是吸收了太多月矩力…轻则头疼重则呕吐。别怪我没提醒过你！"
                }
            ]
        },
        {
            "id": "7610603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761060301",
                    "speaker": "Player",
                    "text": "真的？"
                },
                {
                    "id": "761060302",
                    "speaker": "沃莉斯菈娃",
                    "text": "那当然！但凡在里面干活的家伙都会多发一杯苹果酿。你想想，要是对身体没有伤害，怎么会有这样的好事？"
                },
                {
                    "id": "761060303",
                    "speaker": "沃莉斯菈娃",
                    "text": "再说了，我之前在霜月之子那边亲眼所见！他们的那些执祭头上都长出角来了，你说这能正常吗？"
                },
                {
                    "id": "761060304",
                    "speaker": "Player",
                    "text": "原来是这样…多谢提醒。"
                },
                {
                    "id": "761060305",
                    "speaker": "派蒙",
                    "text": "听上去好可怕哦！会、会变成怪物吗？"
                },
                {
                    "id": "761060306",
                    "speaker": "沃莉斯菈娃",
                    "text": "唉，尽派新来的做这些危险的事…你自己小心些吧，别在里面待太久。"
                }
            ]
        },
        {
            "id": "7610605",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761060501",
                    "speaker": "Player",
                    "text": "初次见面，我是你们的老对手了！"
                },
                {
                    "id": "761060502",
                    "speaker": "沃莉斯菈娃",
                    "text": "可恶，竟然是敌袭…都给我上！"
                }
            ]
        },
        {
            "id": "7610606",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761060601",
                    "speaker": "沃莉斯菈娃",
                    "text": "都说了不要在里面待太久了，你怎么还跑来跑去的？你真不怕吸收那么多月矩力之后的副作用吗？"
                }
            ]
        },
        {
            "id": "7610607",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761060701",
                    "speaker": "Player",
                    "text": "不怕啊，我可不像你这么弱。"
                },
                {
                    "id": "761060702",
                    "speaker": "沃莉斯菈娃",
                    "text": "哈？！现在的新人说话怎么都这么呛人呢…等一下，仔细看你好像不是这次招进来的新人啊！原、原来是奸细吗？给我拿下！"
                }
            ]
        },
        {
            "id": "7610608",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "761060801",
                    "speaker": "Player",
                    "text": "打扰了，我好像走错了…"
                },
                {
                    "id": "761060802",
                    "speaker": "沃莉斯菈娃",
                    "text": "这可是军事重地！你要是有事就赶紧办事，没事别到处乱逛。"
                }
            ]
        }
    ]
}