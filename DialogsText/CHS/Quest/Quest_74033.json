    "talks": [
        {
            "id": "7403302",
            "objective": "前往废弃生产区",
            "dialogues": []
        },
        {
            "id": "7403301",
            "objective": "与卡特皮拉对话",
            "dialogues": [
                {
                    "id": "740330101",
                    "speaker": "卡特皮拉",
                    "text": "晶簇矿坑道封锁之后，这里就不太有人来了，这里的机械装置也不适合外行摆弄。"
                },
                {
                    "id": "740330102",
                    "speaker": "卡特皮拉",
                    "text": "不过这次就是有人随意摆弄传动机阀，把自己的同伴关了起来…"
                },
                {
                    "id": "740330103",
                    "speaker": "卡特皮拉",
                    "text": "总之，我们先操作传动机阀打开通向<color=#00E1FFFF>一号备品仓库</color>的连通路吧。如果待会儿他要请你喝什么饮料，最好还是婉拒。"
                },
                {
                    "id": "740330104",
                    "speaker": "派蒙",
                    "text": "谁要请我们喝饮料？为什么不喝呢？"
                },
                {
                    "id": "740330105",
                    "speaker": "卡特皮拉",
                    "text": "待会儿你就知道了。"
                }
            ]
        },
        {
            "id": "7403305",
            "objective": "操作传动机阀，打开通向一号备品仓库的连通路",
            "dialogues": []
        },
        {
            "id": "7403303",
            "objective": "进入一号备品仓库",
            "dialogues": []
        },
        {
            "id": "7403304",
            "objective": "和被困的人对话",
            "dialogues": [
                {
                    "id": "740330401",
                    "speaker": "卡特皮拉",
                    "text": "米图尔，你还好吗？应该没被困太久吧。"
                },
                {
                    "id": "740330402",
                    "speaker": "米图尔",
                    "text": "我的救星！你们可算来了！"
                },
                {
                    "id": "740330403",
                    "speaker": "米图尔",
                    "text": "科布伦茨呢？他没跟你们一起吗？"
                },
                {
                    "id": "740330404",
                    "speaker": "卡特皮拉",
                    "text": "是他向我求助，说你被困在这里了。不过中途被看守打断，他就先行离开了。"
                },
                {
                    "id": "740330405",
                    "speaker": "米图尔",
                    "text": "我就知道他不是个靠得住的生意伙伴！他肯定是怕了，自己心虚理亏，所以逃跑。"
                },
                {
                    "id": "740330406",
                    "speaker": "米图尔",
                    "text": "你说，做生意，不胆大点能有收益吗？"
                },
                {
                    "id": "740330407",
                    "speaker": "米图尔",
                    "text": "他笨手笨脚也就算了，还瞻前顾后的…你猜怎么着，现在别说是「纯洁之水」了，枫达都进来了！"
                },
                {
                    "id": "740330408",
                    "speaker": "米图尔",
                    "text": "枫达进来了，我们还能有活路吗？"
                },
                {
                    "id": "740330409",
                    "speaker": "派蒙",
                    "text": "哦…"
                },
                {
                    "id": "740330410",
                    "speaker": "米图尔",
                    "text": "怎么，你们也喜欢枫达吗？",
                    "choices": [
                        {
                            "id": "740330411",
                            "text": "怎么，你不喜欢？",
                            "response": [
                                {
                                    "id": "740330412",
                                    "speaker": "米图尔",
                                    "text": "我当然喜欢！我必须承认，它是相当强力的竞争对手…"
                                },
                                {
                                    "id": "740330415",
                                    "speaker": "米图尔",
                                    "text": "不多说了，我得去找科布伦茨这家伙算账去了。对了，他是不是没有支付报酬？"
                                },
                                {
                                    "id": "740330416",
                                    "speaker": "卡特皮拉",
                                    "text": "的确没有。"
                                },
                                {
                                    "id": "740330417",
                                    "speaker": "米图尔",
                                    "text": "…有时我真想把他塞进桶里让他好好反省反省。总之，请你们收下这些特许券。"
                                },
                                {
                                    "id": "740330418",
                                    "speaker": "卡特皮拉",
                                    "text": "#请{NICKNAME}和派蒙收下吧。"
                                },
                                {
                                    "id": "740330419",
                                    "speaker": "派蒙",
                                    "text": "欸？全都给我们吗？"
                                },
                                {
                                    "id": "740330420",
                                    "speaker": "卡特皮拉",
                                    "text": "当然。"
                                },
                                {
                                    "id": "740330421",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，那我们就收下啦。之后有机会也可以去破烂骨头商店看看有没有什么好东西！"
                                },
                                {
                                    "id": "740330422",
                                    "speaker": "米图尔",
                                    "text": "对了，既然给你们添了不少麻烦，作为赔礼，我这儿有几瓶新鲜的健康饮料，你们要不要尝尝？"
                                },
                                {
                                    "id": "740330423",
                                    "speaker": "派蒙",
                                    "text": "新鲜的…健康饮料？"
                                },
                                {
                                    "id": "740330424",
                                    "speaker": "米图尔",
                                    "text": "比「纯洁之水」健康多了！",
                                    "choices": [
                                        {
                                            "id": "740330425",
                                            "text": "给我来一杯。",
                                            "response": [
                                                {
                                                    "id": "740330426",
                                                    "speaker": "派蒙",
                                                    "text": "（喂！卡特皮拉刚才是不是说过，还是不要喝比较好…）"
                                                },
                                                {
                                                    "id": "740330427",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}刚才说的不算！我们来之前已经…呃，已经喝了很多饮料了。"
                                                },
                                                {
                                                    "id": "740330431",
                                                    "speaker": "派蒙",
                                                    "text": "真可惜啊，这么好的健康饮料，还是之后有机会再好好品尝吧！"
                                                },
                                                {
                                                    "id": "740330432",
                                                    "speaker": "米图尔",
                                                    "text": "这么不凑巧吗？那好吧，之后如果有机会记得来找我，我一定好好款待。"
                                                },
                                                {
                                                    "id": "740330433",
                                                    "speaker": "米图尔",
                                                    "text": "那我就先告辞了，还得去找科布伦茨…"
                                                },
                                                {
                                                    "id": "740330434",
                                                    "speaker": "卡特皮拉",
                                                    "text": "我有些别的事要办，就暂时道别吧。特许券的事你们不用太忧心了，<color=#00E1FFFF>有线索的话我会贴在黑板上的</color>。稍晚一些我们再会合吧。"
                                                },
                                                {
                                                    "id": "740330435",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，那我们晚点再见！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "740330428",
                                            "text": "给我来杯枫达。",
                                            "response": [
                                                {
                                                    "id": "740330429",
                                                    "speaker": "米图尔",
                                                    "text": "有倒是有…嗯？你是不是瞧不上我的健康饮料？我跟你说哦…"
                                                },
                                                {
                                                    "id": "740330430",
                                                    "speaker": "派蒙",
                                                    "text": "#{NICKNAME}不是这个意思啦！只是…只是我们来之前已经喝过很多饮料了，现在饱得不行…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "740330413",
                            "text": "还行吧。",
                            "response": [
                                {
                                    "id": "740330414",
                                    "speaker": "米图尔",
                                    "text": "哦？看来是有品位的顾客。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}