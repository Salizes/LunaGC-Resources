    "talks": [
        {
            "id": "7518501",
            "objective": "(test)火山黑蛋大师$HIDDEN",
            "dialogues": [
                {
                    "id": "751850501",
                    "speaker": "Player",
                    "text": "我来试试！"
                }
            ]
        },
        {
            "id": "7518503",
            "objective": "(test)开启挑战$HIDDEN",
            "dialogues": [
                {
                    "id": "751850301",
                    "speaker": "Player",
                    "text": "乌乌黑蛋是什么？"
                },
                {
                    "id": "751850302",
                    "speaker": "伦图",
                    "text": "说到乌乌黑蛋，那可是只有我们火山地区才能创造的美食啊。"
                },
                {
                    "id": "751850303",
                    "speaker": "伦图",
                    "text": "将鸟蛋放在地热喷口上，利用火山喷出的气态燃素进行烤制，等到火候正好的时刻取出，就能得到一枚完美的乌乌黑蛋。"
                },
                {
                    "id": "751850304",
                    "speaker": "伦图",
                    "text": "不过，要是不小心烤焦了，味道就会变得相当……不同寻常。"
                }
            ]
        },
        {
            "id": "7518502",
            "objective": "(test)子任务描述Test$HIDDEN",
            "dialogues": [
                {
                    "id": "751850401",
                    "speaker": "伦图",
                    "text": "两位真是好身手啊，咻咻咻地几下就完成了挑战。"
                },
                {
                    "id": "751850402",
                    "speaker": "伦图",
                    "text": "让我看看——哦哦，这个黝黑的色泽和浓厚的气味，真是让人胃口大开啊。快趁热品尝吧！"
                },
                {
                    "id": "751850403",
                    "speaker": "伦图",
                    "text": "这份食谱你们也拿着，以后如果还想品尝乌乌黑蛋，可以自己动手烹饪看看哦。"
                }
            ]
        },
        {
            "id": "7518501",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751850101",
                    "speaker": "伦图",
                    "text": "远道而来的异邦旅人，你们好啊！你们可曾听闻过我们沃陆之邦的特产美食——乌乌黑蛋？"
                }
            ]
        },
        {
            "id": "7518502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751850201",
                    "speaker": "伦图",
                    "text": "现在只需要完成一个小小的「火山蛋挑战」——将那边的地热喷口打破，取出里面的乌乌黑蛋，就能品尝到新鲜出炉的美味了！"
                }
            ]
        },
        {
            "id": "7518506",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751850601",
                    "speaker": "Player",
                    "text": "还有别的事情要做。"
                },
                {
                    "id": "751850602",
                    "speaker": "伦图",
                    "text": "好吧，等有时间了，别忘了来尝试啊！"
                }
            ]
        },
        {
            "id": "7518507",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "751850701",
                    "speaker": "伦图",
                    "text": "是你们啊，身手矫健的异邦旅人。怎么样，有尝试自己动手制作乌乌黑蛋吗？",
                    "choices": [
                        {
                            "id": "751850702",
                            "text": "尝试过了，吃完浑身有力！",
                            "response": [
                                {
                                    "id": "751850703",
                                    "speaker": "伦图",
                                    "text": "对吧，对吧，这可是蕴含了火山精华的美味啊。"
                                },
                                {
                                    "id": "751850704",
                                    "speaker": "伦图",
                                    "text": "据说每天都吃的话，能让身体变得越来越健壮呢！"
                                }
                            ]
                        },
                        {
                            "id": "751850705",
                            "text": "烤过头了，吃完差点晕过去。",
                            "response": [
                                {
                                    "id": "751850706",
                                    "speaker": "伦图",
                                    "text": "哈哈哈，那个味道很让人印象深刻吧？"
                                },
                                {
                                    "id": "751850707",
                                    "speaker": "伦图",
                                    "text": "我倒是觉得吃习惯之后，也没那么难以下咽啦。"
                                }
                            ]
                        },
                        {
                            "id": "751850710",
                            "text": "还没有，下次试试。",
                            "response": [
                                {
                                    "id": "751850711",
                                    "speaker": "伦图",
                                    "text": "没问题，愿你旅途一切顺利！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}