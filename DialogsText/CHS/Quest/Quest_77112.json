    },
    "talks": [
        {
            "id": "7711201",
            "objective": "寻找娜斯佳",
            "dialogues": [
                {
                    "id": "771120101",
                    "speaker": "派蒙",
                    "text": "娜斯佳！"
                },
                {
                    "id": "771120102",
                    "speaker": "娜斯佳",
                    "text": "#别担心，小小派蒙，{NICKNAME}{M#大哥哥}{F#大姐姐}，不如说，现在我很好哦，因为我见到了莫罗医生…"
                },
                {
                    "id": "771120103",
                    "speaker": "娜斯佳",
                    "text": "#莫罗医生夸奖了我，说他看得见，我在小小派蒙和{NICKNAME}{M#大哥哥}{F#大姐姐}的帮助下跨越困难回来。"
                },
                {
                    "id": "771120104",
                    "speaker": "娜斯佳",
                    "text": "他说我很了不起，也能成为「完全树」的一部分，我也，我也感受到了妈妈…虽然那和以前的拥抱并不一样…"
                },
                {
                    "id": "771120105",
                    "speaker": "娜斯佳",
                    "text": "但是我知道妈妈确实在那里。"
                },
                {
                    "id": "771120106",
                    "speaker": "派蒙",
                    "text": "咦？莫罗医生，娜斯佳的妈妈？这里除了娜斯佳就没有任何人了啊？"
                },
                {
                    "id": "771120107",
                    "speaker": "娜斯佳",
                    "text": "小小派蒙看不到呢，如果小小派蒙成为家人的话，就能够感受到了…"
                },
                {
                    "id": "771120108",
                    "speaker": "娜斯佳",
                    "text": "因为…啊，因为…「完全树」是超越了一切时间，超越了一切生命的生命，是…永恒。"
                },
                {
                    "id": "771120109",
                    "speaker": "娜斯佳",
                    "text": "谢谢，「娜斯佳已经不再是单独的娜斯佳」…娜斯佳是「我们」，现在，「或彼时」，娜斯佳本来就是「我们」的一部分。"
                },
                {
                    "id": "771120110",
                    "speaker": "娜斯佳",
                    "text": "只是在「这一刻」她回归了，「我们的怀抱」，在永恒的尺度，相连，感谢你们的帮助，尤其是你…"
                },
                {
                    "id": "771120111",
                    "speaker": "娜斯佳",
                    "text": "「降临者」，那第四位的，「如今位格唯一」的双生子之一。",
                    "choices": [
                        {
                            "id": "771120112",
                            "text": "你不是娜斯佳？",
                            "response": [
                                {
                                    "id": "771120114",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "「我们」共有千万个名字，「曾经」，如今已失去意义，但是我是你们寻找的，「或追求的」，那个东西，「那个人」。"
                                },
                                {
                                    "id": "771120115",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "为了方便理解，你可以叫我卡谢伊，「或者莫罗医生」，其实这两者没有差别，「现在更是没有任何差别了」。"
                                },
                                {
                                    "id": "771120116",
                                    "speaker": "派蒙",
                                    "text": "啊，原来那个坏蛋就是你！"
                                },
                                {
                                    "id": "771120117",
                                    "speaker": "派蒙",
                                    "text": "把「眼镜」的力量还回来，还有娜斯佳，你不许用娜斯佳的身体。"
                                },
                                {
                                    "id": "771120118",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "…「灰眸」，或者「原初之人」，力量的归还，「这样的事终究会发生」，但命运会偏转，我，「或者我们」，原本以为…"
                                },
                                {
                                    "id": "771120119",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "会出现在这里的是另一个人，「阿克西妮娅」。如今，是你被选择，代替了她应该做的事。"
                                },
                                {
                                    "id": "771120120",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "取走吧，「仪式已然完成」。我，「或者我们」已用不到那份力量，已经是永恒，「从概念上无限接近永恒的生命」。"
                                },
                                {
                                    "id": "771120121",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "这样驱使话语的时间也很短暂，在一切永恒的时间里，话语终将失去意义，「为一切都会失去意义」。"
                                },
                                {
                                    "id": "771120122",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "啊，可是，恒久的梦啊，恒久的梦，没有意义而不会痛苦的庭院里…我为何寻求永恒，为了…为了…"
                                },
                                {
                                    "id": "771120123",
                                    "speaker": "Player",
                                    "text": "你忘了你想要什么东西了。"
                                },
                                {
                                    "id": "771120124",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "…因为「想要什么东西」已失去了意义。"
                                },
                                {
                                    "id": "771120125",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "永恒啊，冷酷的彼端，即便再炽热的爱也无法抵达。"
                                },
                                {
                                    "id": "771120126",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "我，「我们」，会将力量归还。"
                                },
                                {
                                    "id": "771120127",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "不过…这一切终究会以没人想要看到的方式结束…"
                                },
                                {
                                    "id": "771120128",
                                    "speaker": "「灰眸」",
                                    "text": "那是什么意思？"
                                },
                                {
                                    "id": "771120129",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "你会明白的，到最后，「在最初」，你的设想。你选择了「降临者」，这将是你最后的挣扎吗，「又或只是命运的巧合」…"
                                },
                                {
                                    "id": "771120130",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "真是短暂的苦痛，我将要回归，回归「我们」之间。娜斯佳，你，还有一点点时间，才能成为「我们」。"
                                },
                                {
                                    "id": "771120131",
                                    "speaker": "曾为娜斯佳的某物",
                                    "text": "与他们告别吧，虽然到最后，「或时间的尽头」，在寂灭之后，我们都会变成同样的东西。"
                                },
                                {
                                    "id": "771120132",
                                    "speaker": "娜斯佳",
                                    "text": "唔…好的，我会好好告别的。"
                                },
                                {
                                    "id": "771120133",
                                    "speaker": "派蒙",
                                    "text": "娜斯佳？"
                                },
                                {
                                    "id": "771120134",
                                    "speaker": "娜斯佳",
                                    "text": "#小小派蒙，{NICKNAME}{M#大哥哥}{F#大姐姐}，谢谢你们。谢谢你们帮忙，我才能回「家」。"
                                },
                                {
                                    "id": "771120135",
                                    "speaker": "娜斯佳",
                                    "text": "这样我就能成为「完全树」的一部分，我也能变得和大家一样，也能重新和妈妈一起生活啦…"
                                },
                                {
                                    "id": "771120136",
                                    "speaker": "派蒙",
                                    "text": "可是，娜斯佳，如果变成「完全树」，我们以后就没法一起玩游戏，呃，在树林里跑来跑去，或者，吃好吃的东西。"
                                },
                                {
                                    "id": "771120137",
                                    "speaker": "娜斯佳",
                                    "text": "没关系的，小小派蒙，那些虽然都很重要，但是娜斯佳有更重要的事要做。",
                                    "choices": [
                                        {
                                            "id": "771120138",
                                            "text": "这真的是…你想做的事吗？",
                                            "response": [
                                                {
                                                    "id": "771120140",
                                                    "speaker": "派蒙",
                                                    "text": "对啊，娜斯佳，外面还有好多好多好玩的东西，有好多好多精彩的事，跟我们出去吧。"
                                                },
                                                {
                                                    "id": "771120141",
                                                    "speaker": "派蒙",
                                                    "text": "而且，而且那个什么卡谢伊搞的仪式，「眼镜」、「眼镜」一定也有办法对不对。"
                                                },
                                                {
                                                    "id": "771120142",
                                                    "speaker": "「灰眸」",
                                                    "text": "是的…法仪可以进行拆解，已转变的一切虽然无法逆转，但是仪式停止，生命的形式亦不会继续进行转变。"
                                                },
                                                {
                                                    "id": "771120143",
                                                    "speaker": "派蒙",
                                                    "text": "#娜斯佳，不用变成完全树，也可以很好地生活哦…还有其他的，都可以交给我和{NICKNAME}，我们会保护你的！"
                                                },
                                                {
                                                    "id": "771120144",
                                                    "speaker": "娜斯佳",
                                                    "text": "#嗯…我知道的，我都知道的，小小派蒙，还有{NICKNAME}{M#大哥哥}{F#大姐姐}。"
                                                },
                                                {
                                                    "id": "771120145",
                                                    "speaker": "娜斯佳",
                                                    "text": "勒庇依婶婶、烂鼻子欧维、弗瑞奥萨姐姐都跟我说过外面的世界的事…那些事都很有趣，听得我也想去外面冒险。"
                                                },
                                                {
                                                    "id": "771120146",
                                                    "speaker": "娜斯佳",
                                                    "text": "但是让我觉得最开心的，还是我每天回到家，我向躺在床上的妈妈说…说我和朋友们玩，说那些听来的故事…"
                                                },
                                                {
                                                    "id": "771120147",
                                                    "speaker": "娜斯佳",
                                                    "text": "我在说的时候呀，妈妈看向我的，让人觉得心里暖洋洋的眼睛。"
                                                },
                                                {
                                                    "id": "771120148",
                                                    "speaker": "娜斯佳",
                                                    "text": "如果能够再看到那眼睛一次，无论怎么样我都会愿意…"
                                                },
                                                {
                                                    "id": "771120149",
                                                    "speaker": "派蒙",
                                                    "text": "可是…"
                                                },
                                                {
                                                    "id": "771120150",
                                                    "speaker": "Player",
                                                    "text": "…这是娜斯佳自己的选择。"
                                                },
                                                {
                                                    "id": "771120151",
                                                    "speaker": "娜斯佳",
                                                    "text": "#嘿嘿，我知道的，小小派蒙和{NICKNAME}{M#大哥哥}{F#大姐姐}，看向娜斯佳时，有的时候也让人心里觉得暖洋洋的。"
                                                },
                                                {
                                                    "id": "771120152",
                                                    "speaker": "娜斯佳",
                                                    "text": "外面的世界一定也有很多有着这样的眼睛的人，可是妈妈就是妈妈…"
                                                },
                                                {
                                                    "id": "771120153",
                                                    "speaker": "娜斯佳",
                                                    "text": "在变成「完成树」之前，能够遇到你们，真是太好了，等我见到妈妈，我一定会和妈妈说你们的故事。"
                                                },
                                                {
                                                    "id": "771120154",
                                                    "speaker": "派蒙",
                                                    "text": "好吧…再见，再见，娜斯佳！"
                                                },
                                                {
                                                    "id": "771120155",
                                                    "speaker": "娜斯佳",
                                                    "text": "再见！不用担心，小小派蒙，在永恒之后的世界我们会再见的！"
                                                },
                                                {
                                                    "id": "771120156",
                                                    "speaker": "Black Screen",
                                                    "text": "首先发出光芒并解体的是女孩挥动的手。 \\n那光芒生长，然后转化，发出淡淡的光，是之前路上见到的蓝藻的模样。 \\n身体的转化比想象中要更快，她的眼神从一瞬的错愕转向喜悦。"
                                                },
                                                {
                                                    "id": "771120157",
                                                    "speaker": "Black Screen",
                                                    "text": "全身泛起光芒的女孩似乎想向你们踏出一步…但或许又只是一个踉跄。\\n她的身躯轻巧地跌落于地面，在完全跌落时，已然化作蓝藻。\\n…就犹如，覆于你们来时路上的诸多蓝藻一般。"
                                                },
                                                {
                                                    "id": "771120158",
                                                    "speaker": "派蒙",
                                                    "text": "娜斯佳…"
                                                },
                                                {
                                                    "id": "771120159",
                                                    "speaker": "「灰眸」",
                                                    "text": "这就是最终的「完全树」…卡谢伊想要成就的，永恒的生命。"
                                                },
                                                {
                                                    "id": "771120160",
                                                    "speaker": "「灰眸」",
                                                    "text": "无法移动，没有话语，甚至生命的形式已经被转变，已没有一切意义，唯有永恒，和已不知喜悦与爱的生命…"
                                                },
                                                {
                                                    "id": "771120161",
                                                    "speaker": "「灰眸」",
                                                    "text": "啊，所有这个区域大仪式的力量都被收回了…在那巨大的卵之中。那个就是我…身躯的一部分。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "771120139",
                                            "text": "只要你说一句「不愿意」…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "771120113",
                            "text": "你是…什么东西？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7711202",
            "objective": "与娜斯佳对话",
            "dialogues": []
        },
        {
            "id": "7711203",
            "objective": "取得「灰眸」身躯的一部分",
            "dialogues": []
        },
        {
            "id": "7711204",
            "objective": "(test)与「灰眸」对话",
            "dialogues": [
                {
                    "id": "771120201",
                    "speaker": "派蒙",
                    "text": "这是…身躯的一部分吗？"
                },
                {
                    "id": "771120202",
                    "speaker": "「灰眸」",
                    "text": "应该是身躯化作的力量的一部分，就像是某种…结晶…如果真的把身躯直接拿来用的话，也许画面会很不美观。"
                },
                {
                    "id": "771120203",
                    "speaker": "派蒙",
                    "text": "唔，说的也对，那我们就先装进包里吧…"
                },
                {
                    "id": "771120204",
                    "speaker": "派蒙",
                    "text": "啊，对了，扎拉，那只大的火鸟，不是说火鸟会不断重生…"
                },
                {
                    "id": "771120205",
                    "speaker": "「灰眸」",
                    "text": "…确实，那只合成魔兽应该并不依赖「我的力量」作为核心。只是完全的生物炼金产物。"
                },
                {
                    "id": "771120206",
                    "speaker": "派蒙",
                    "text": "那它不会因为这里没有要守护的东西之后，就发大火，甚至跑出去到处破坏吧！"
                },
                {
                    "id": "771120207",
                    "speaker": "「灰眸」",
                    "text": "并非没有这样的可能，合成魔兽一般不具备太高的智性…"
                },
                {
                    "id": "771120208",
                    "speaker": "派蒙",
                    "text": "不行，我们得出去看看！"
                },
                {
                    "id": "771120209",
                    "speaker": "？？？",
                    "text": "…你最后选择的是将「它」和植物融为一体啊，卡谢伊。"
                },
                {
                    "id": "771120210",
                    "speaker": "？？？",
                    "text": "火鸟啊，火鸟…你在夜里歌唱，在冰雪如玻璃的宫殿中起舞，在歌唱中垂首，啄食金色的果实。"
                },
                {
                    "id": "771120211",
                    "speaker": "？？？",
                    "text": "啊，你们来了，是担心它还会复活吗？我稍微做了点处理，它的肉体很快就会崩溃消解。"
                },
                {
                    "id": "771120212",
                    "speaker": "？？？",
                    "text": "说到底，合成魔兽如无法「超越」一切，也不过就是正常的魔兽之躯。"
                },
                {
                    "id": "771120213",
                    "speaker": "派蒙",
                    "text": "哦哦，谢谢…真是帮了大忙了！"
                },
                {
                    "id": "771120214",
                    "speaker": "派蒙",
                    "text": "咦，不对，你是谁？"
                },
                {
                    "id": "771120215",
                    "speaker": "？？？",
                    "text": "哦，对哦，虽然我已经知道你们是谁了，不过确实，我还没有向你们做过自我介绍呢…"
                },
                {
                    "id": "771120216",
                    "speaker": "？？？",
                    "text": "我只是已逝去的白沙皇陛下座前…区区一位「宫廷小丑」罢了，不值一提的名讳是：阿克西妮娅。"
                },
                {
                    "id": "771120217",
                    "speaker": "「灰眸」",
                    "text": "阿克西妮娅…"
                },
                {
                    "id": "771120218",
                    "speaker": "阿克西妮娅",
                    "text": "是的，稍微想起来一点了吗？"
                },
                {
                    "id": "771120219",
                    "speaker": "阿克西妮娅",
                    "text": "虽然伊兹梅洛常常抱怨，说我做自我介绍的态度未免稍微有些谦卑了，但我觉得这也是种个人风格嘛。"
                },
                {
                    "id": "771120220",
                    "speaker": "「灰眸」",
                    "text": "阿克西妮娅，很熟悉的名字。"
                },
                {
                    "id": "771120221",
                    "speaker": "阿克西妮娅",
                    "text": "嗯，毕竟那是创造出你现在寄身的机关的人的名字。"
                },
                {
                    "id": "771120222",
                    "speaker": "Player",
                    "text": "你是…「眼镜」的制造者？"
                },
                {
                    "id": "771120223",
                    "speaker": "阿克西妮娅",
                    "text": "是的。"
                },
                {
                    "id": "771120224",
                    "speaker": "阿克西妮娅",
                    "text": "哈哈，所以「眼镜」是属于我的东西，现在快把它还回来吧，你们这些偷了我东西的小贼们！"
                },
                {
                    "id": "771120225",
                    "speaker": "派蒙",
                    "text": "欸——"
                },
                {
                    "id": "771120226",
                    "speaker": "阿克西妮娅",
                    "text": "开玩笑的。就让「他」在你们身边吧。"
                },
                {
                    "id": "771120227",
                    "speaker": "阿克西妮娅",
                    "text": "虽然从最开始的设想中，在那里拿到「灰眸」以及其中意志的，确实应该是我，不过既然「他」做出了选择——"
                },
                {
                    "id": "771120228",
                    "speaker": "阿克西妮娅",
                    "text": "我相信它，我也相信「他」选择的你们。"
                },
                {
                    "id": "771120229",
                    "speaker": "阿克西妮娅",
                    "text": "好了，打招呼的话就说到这里了，我们的目标是一致的…帮「灰眸」里的意志寻回身躯，取回力量。"
                },
                {
                    "id": "771120230",
                    "speaker": "阿克西妮娅",
                    "text": "这是，你所希望的吧。"
                },
                {
                    "id": "771120231",
                    "speaker": "「灰眸」",
                    "text": "…是的。"
                },
                {
                    "id": "771120232",
                    "speaker": "阿克西妮娅",
                    "text": "那我们就会在旅途中再见的，啊，差不多了。"
                },
                {
                    "id": "771120233",
                    "speaker": "派蒙",
                    "text": "什么…什么差不多了？"
                },
                {
                    "id": "771120234",
                    "speaker": "阿克西妮娅",
                    "text": "「落叶在脚下簌簌地响个不停，冬日开始将自己的祭品铺砌」…"
                },
                {
                    "id": "771120235",
                    "speaker": "阿克西妮娅",
                    "text": "…差不多了，诸位，田野上呀，最后绽放的花要开始凋谢了。"
                },
                {
                    "id": "771120236",
                    "speaker": "派蒙",
                    "text": "啊，等等，我们还有很多问题…"
                },
                {
                    "id": "771120237",
                    "speaker": "派蒙",
                    "text": "唔，奇怪的女人，突然就消失了，「眼镜」，怎么样，那个女人会让你想起什么吗？"
                },
                {
                    "id": "771120238",
                    "speaker": "「灰眸」",
                    "text": "想起了一些，但是不过是…模糊的印象，她与卡谢伊，还有其他两位大人创造了我。在…"
                },
                {
                    "id": "771120239",
                    "speaker": "「灰眸」",
                    "text": "名为「谧源所」的机构。"
                },
                {
                    "id": "771120240",
                    "speaker": "「灰眸」",
                    "text": "似乎能想起来的就只有这些了。"
                },
                {
                    "id": "771120241",
                    "speaker": "派蒙",
                    "text": "唔…好吧。"
                },
                {
                    "id": "771120242",
                    "speaker": "派蒙",
                    "text": "不过她不是说之后还会碰到嘛，等到那个时候再好好问问她好了！"
                }
            ]
        },
        {
            "id": "7711205",
            "objective": "(test)废弃",
            "dialogues": []
        },
        {
            "id": "7711206",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7711204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "771120401",
                    "speaker": "蓝藻",
                    "text": "又回到了这个地方啊…还是以前的样子，只不过，种子中的嫩芽好像马上要钻出来了，新的枝叶也在生长…"
                },
                {
                    "id": "771120402",
                    "speaker": "蓝藻",
                    "text": "我的床…变成了别的生命的小床…我的被子…我的枕头和我的玩具…"
                },
                {
                    "id": "771120403",
                    "speaker": "蓝藻",
                    "text": "它好像已经不是我的小窝了？但是…奇怪，妈妈也已经在我的旁边了，我为什么还在怀念…"
                },
                {
                    "id": "771120404",
                    "speaker": "蓝藻",
                    "text": "妈妈的手摸着我的头发，它们还没有变成漂亮的枝叶，但妈妈一样爱我——「乖乖孩子早早睡…」"
                },
                {
                    "id": "771120405",
                    "speaker": "Player",
                    "text": "（是娜斯佳吗？但好像没办法和她对话…）"
                }
            ]
        }
    ]
}