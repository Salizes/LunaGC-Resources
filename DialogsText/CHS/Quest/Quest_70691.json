    "talks": [
        {
            "id": "7069101",
            "objective": "与可莉对话",
            "dialogues": [
                {
                    "id": "706910101",
                    "speaker": "可莉",
                    "text": "#{M#荣誉骑士哥哥}{F#荣誉骑士姐姐}！这边这边！"
                },
                {
                    "id": "706910102",
                    "speaker": "可莉",
                    "text": "可莉交到了新朋友！要和我们一起玩吗？"
                },
                {
                    "id": "706910103",
                    "speaker": "可莉",
                    "text": "哥哥姐姐们教给我们一种新游戏，叫做「雪白迷踪」。"
                },
                {
                    "id": "706910104",
                    "speaker": "可莉",
                    "text": "规则也不难，就是很特别的捉迷藏！"
                },
                {
                    "id": "706910105",
                    "speaker": "派蒙",
                    "text": "哇哇，可莉、瑶瑶和早柚，你们交上朋友啦！"
                },
                {
                    "id": "706910106",
                    "speaker": "派蒙",
                    "text": "听这个游戏的名字，像是「风行迷踪」的改进版？和你们一起玩，肯定非常有意思！",
                    "choices": [
                        {
                            "id": "706910107",
                            "text": "好呀好呀，捉迷藏！",
                            "response": [
                                {
                                    "id": "706910109",
                                    "speaker": "早柚",
                                    "text": "阿嚏…虽然在营地里就不怎么冷了，但还是有点困…"
                                },
                                {
                                    "id": "706910110",
                                    "speaker": "早柚",
                                    "text": "#唔？我是不是眼花了，怎么好像看到了{NICKNAME}和派蒙？"
                                },
                                {
                                    "id": "706910111",
                                    "speaker": "瑶瑶",
                                    "text": "#你没有眼花哦，{NICKNAME}和派蒙确实来啦。",
                                    "choices": [
                                        {
                                            "id": "706910112",
                                            "text": "你们好呀，瑶瑶和早柚！",
                                            "response": [
                                                {
                                                    "id": "706910114",
                                                    "speaker": "可莉",
                                                    "text": "动起来，开开心心玩游戏，就不会打瞌睡啦！"
                                                },
                                                {
                                                    "id": "706910115",
                                                    "speaker": "瑶瑶",
                                                    "text": "那位严肃的菫葵小姐不是也说过吗，早柚在雪山多转转，也对自己的本领有好处？"
                                                },
                                                {
                                                    "id": "706910116",
                                                    "speaker": "早柚",
                                                    "text": "呃，你们居然都记住了！"
                                                },
                                                {
                                                    "id": "706910117",
                                                    "speaker": "早柚",
                                                    "text": "好吧…如果输给那几位同行，甚至是超级忍犬的话…之后偷懒肯定会被抓得更严！"
                                                },
                                                {
                                                    "id": "706910118",
                                                    "speaker": "早柚",
                                                    "text": "看来这次出远门的修行，确实要认真起来了。"
                                                },
                                                {
                                                    "id": "706910119",
                                                    "speaker": "瑶瑶",
                                                    "text": "没事哦，我准备了新做法的蔬菜炖肉，加入了绝云椒椒和胡椒的粉末。"
                                                },
                                                {
                                                    "id": "706910120",
                                                    "speaker": "瑶瑶",
                                                    "text": "开玩之前吃几口，整场捉迷藏都不会冷哦。"
                                                },
                                                {
                                                    "id": "706910121",
                                                    "speaker": "早柚",
                                                    "text": "太好了！待会儿，我先来一整碗！"
                                                },
                                                {
                                                    "id": "706910122",
                                                    "speaker": "派蒙",
                                                    "text": "我也要，我也要！"
                                                },
                                                {
                                                    "id": "706910123",
                                                    "speaker": "可莉",
                                                    "text": "那——雪山捉迷藏，准备开始啦！"
                                                },
                                                {
                                                    "id": "706910124",
                                                    "speaker": "派蒙",
                                                    "text": "嘿呀！雪山到处都是白色，我躲起来，肯定不容易被发现！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706910113",
                                            "text": "要一起来玩捉迷藏吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706910108",
                            "text": "让我也认识一下可莉的新朋友~"
                        }
                    ]
                }
            ]
        }
    ]
}