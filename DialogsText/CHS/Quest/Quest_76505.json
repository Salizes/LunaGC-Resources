    "talks": [
        {
            "id": "7650501",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "765050101",
                    "speaker": "瓦雷莎",
                    "text": "#{NICKNAME}和派蒙？真是巧呀！我之前听说你们出发去挪德卡莱了，没想到这么快就能在这里碰上！"
                },
                {
                    "id": "765050102",
                    "speaker": "派蒙",
                    "text": "对啊对啊，我还以为我看错了呢！瓦雷莎，你怎么也跑到这么远的地方来啦？难道也是来旅行的吗？"
                },
                {
                    "id": "765050103",
                    "speaker": "瓦雷莎",
                    "text": "嘿嘿，差不多吧！我这次是来帮家里的果园采购一批农用机械的。"
                },
                {
                    "id": "765050104",
                    "speaker": "瓦雷莎",
                    "text": "爸爸说挪德卡莱这边有些好东西，能让果子长得更好，也能让我省点力气，这样我就有更多的时间睡觉…和健身了。"
                },
                {
                    "id": "765050105",
                    "speaker": "瓦雷莎",
                    "text": "来了之后发现，这里有好多纳塔没有的好吃的！这几天除了办正事以外，我几乎所有时间都花在吃吃喝喝上面了！"
                },
                {
                    "id": "765050106",
                    "speaker": "瓦雷莎",
                    "text": "不知不觉，马上就要到回程的时间，都有点不舍得了。"
                },
                {
                    "id": "765050107",
                    "speaker": "瓦雷莎",
                    "text": "所以呀，我要抓紧最后的机会，再好好逛逛，把没吃过的都尝一遍，没看过的都看个够！"
                },
                {
                    "id": "765050108",
                    "speaker": "瓦雷莎",
                    "text": "#你们呢？让我猜猜…我们无敌的大英雄{NICKNAME}，是不是又在这片新的土地上，忙着维护正义呀？",
                    "choices": [
                        {
                            "id": "765050109",
                            "text": "我们正在四处参观。",
                            "response": [
                                {
                                    "id": "765050111",
                                    "speaker": "瓦雷莎",
                                    "text": "嘿嘿，我懂我懂！到了新的国家，看什么都新鲜得不得了，简直想把每个有趣的角落，都用留影机「咔擦」一下保存下来！"
                                },
                                {
                                    "id": "765050112",
                                    "speaker": "瓦雷莎",
                                    "text": "这么说来…哎呀！我应该也把在这里吃过的所有美食都仔仔细细地拍下来才对。"
                                },
                                {
                                    "id": "765050113",
                                    "speaker": "瓦雷莎",
                                    "text": "这样的话，等我回纳塔，说不定能让阿托力大叔照着画片，尝试把这些美味都给还原出来！"
                                },
                                {
                                    "id": "765050114",
                                    "speaker": "Player",
                                    "text": "瓦雷莎说不定能当美食摄影师呢。"
                                },
                                {
                                    "id": "765050115",
                                    "speaker": "瓦雷莎",
                                    "text": "嘿嘿，真的吗？美食摄影师啊…听起来就很棒！每天都能和好吃的打交道，还能把它们拍得让人看了就流口水！",
                                    "choices": [
                                        {
                                            "id": "765050116",
                                            "text": "在拍摄美食之前…",
                                            "response": [
                                                {
                                                    "id": "765050118",
                                                    "speaker": "瓦雷莎",
                                                    "text": "欸，要拍我吗？真的可以吗？"
                                                },
                                                {
                                                    "id": "765050119",
                                                    "speaker": "瓦雷莎",
                                                    "text": "我、我的头发有没有乱？嘴角没沾到酱汁吧？哎呀，早知道今天会遇到你们，我就把昨天在集市买到的配饰戴上了！",
                                                    "choices": [
                                                        {
                                                            "id": "765050120",
                                                            "text": "你现在这样就很好了！",
                                                            "response": [
                                                                {
                                                                    "id": "765050122",
                                                                    "speaker": "瓦雷莎",
                                                                    "text": "好！那…那就拜托你们了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765050121",
                                                            "text": "我想拍下你开心的样子。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765050117",
                                            "text": "可以为你拍摄画片吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765050110",
                            "text": "顺便寻找拍摄素材。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7650502",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
