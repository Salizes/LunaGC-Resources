    "talks": [
        {
            "id": "1204401",
            "objective": "派蒙的心血来潮",
            "dialogues": []
        },
        {
            "id": "1204402",
            "objective": "前往稻妻",
            "dialogues": [
                {
                    "id": "120440201",
                    "speaker": "派蒙",
                    "text": "嗯…我又想起了之前在这边追狸猫的日子，有些怀念呢。"
                },
                {
                    "id": "120440202",
                    "speaker": "派蒙",
                    "text": "欸？那是什么？",
                    "choices": [
                        {
                            "id": "120440203",
                            "text": "狸猫？",
                            "response": [
                                {
                                    "id": "120440205",
                                    "speaker": "派蒙",
                                    "text": "怎么看都不像吧？难道稻妻又有新的妖怪了？"
                                },
                                {
                                    "id": "120440206",
                                    "speaker": "派蒙",
                                    "text": "嗯…难道它想让我们跟过去？"
                                }
                            ]
                        },
                        {
                            "id": "120440204",
                            "text": "小猪仔？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1204403",
            "objective": "跟上小妖怪",
            "dialogues": [
                {
                    "id": "120440301",
                    "speaker": "派蒙",
                    "text": "那里怎么有个小姐姐？"
                },
                {
                    "id": "120440302",
                    "speaker": "派蒙",
                    "text": "她好像很难受…我们快过去看看吧！"
                },
                {
                    "id": "120440801",
                    "speaker": "派蒙",
                    "text": "刚刚是怎么了？明明只是和那个小姐姐对视了一眼…"
                },
                {
                    "id": "120440802",
                    "speaker": "派蒙",
                    "text": "等一下，这里什么时候来了这么多人？这些人到这里来干嘛？"
                },
                {
                    "id": "120440803",
                    "speaker": "Player",
                    "text": "这些人好像在排队？"
                },
                {
                    "id": "120440804",
                    "speaker": "派蒙",
                    "text": "是哦…那个姐姐还在那里！嗯…我觉得她可能知道发生了什么。"
                },
                {
                    "id": "120440805",
                    "speaker": "手岛",
                    "text": "现在出发的话，我剩下的时间还足够吗？"
                },
                {
                    "id": "120440806",
                    "speaker": "阿茂",
                    "text": "怎么就聊不明白呢？"
                },
                {
                    "id": "120440807",
                    "speaker": "真田",
                    "text": "举报了肯定混不下去，可是…"
                },
                {
                    "id": "120440808",
                    "speaker": "？？？",
                    "text": "唔…因为缺乏灵感而产生的焦虑…灵感往往不会光顾过于焦虑的大脑，希望这次治疗能让你更放松一些。"
                },
                {
                    "id": "120440809",
                    "speaker": "若紫",
                    "text": "…谢谢。"
                },
                {
                    "id": "120440810",
                    "speaker": "？？？",
                    "text": "…对于过往恶行的悔恨，还有对于困顿现状的哀愁…我可以让你更开朗地面对这一切，但还请你也努力一下。"
                },
                {
                    "id": "120440811",
                    "speaker": "西口",
                    "text": "…多谢。"
                },
                {
                    "id": "120440812",
                    "speaker": "？？？",
                    "text": "下一位…咳咳！"
                },
                {
                    "id": "120440813",
                    "speaker": "派蒙",
                    "text": "这是怎么了？"
                },
                {
                    "id": "120440814",
                    "speaker": "Player",
                    "text": "你没事吧？"
                },
                {
                    "id": "120440815",
                    "speaker": "？？？",
                    "text": "我还行，下一位…"
                },
                {
                    "id": "120440816",
                    "speaker": "派蒙",
                    "text": "这是…"
                },
                {
                    "id": "120440817",
                    "speaker": "？？？",
                    "text": "…唔！真好吃！"
                },
                {
                    "id": "120440818",
                    "speaker": "派蒙",
                    "text": "哇，好突然…"
                },
                {
                    "id": "120440819",
                    "speaker": "？？？",
                    "text": "欸？这是…嗝！真的很抱歉…"
                },
                {
                    "id": "120440820",
                    "speaker": "派蒙",
                    "text": "抱歉？说实话，我们两个都不清楚刚刚到底发生了什么事，能麻烦说明一下吗？"
                },
                {
                    "id": "120440821",
                    "speaker": "？？？",
                    "text": "两位应该是误入了我的梦境，容我先让两位醒来再进行说明。"
                },
                {
                    "id": "120440822",
                    "speaker": "派蒙",
                    "text": "梦境？什么时候…"
                },
                {
                    "id": "120440901",
                    "speaker": "派蒙",
                    "text": "唔…"
                },
                {
                    "id": "120440902",
                    "speaker": "？？？",
                    "text": "#嗨，是不是有种「如梦方醒」的感觉？真没想到那位{NICKNAME}会出现在我的梦里。"
                },
                {
                    "id": "120440903",
                    "speaker": "Player",
                    "text": "你认识我？"
                },
                {
                    "id": "120440904",
                    "speaker": "？？？",
                    "text": "有人经常向我提起你，嗯…我根据传闻做的人物侧写还算准确。"
                },
                {
                    "id": "120440905",
                    "speaker": "派蒙",
                    "text": "那你是…"
                },
                {
                    "id": "120440906",
                    "speaker": "？？？",
                    "text": "#说起来这是我和{NICKNAME}的第一次见面呢，那么正式自我介绍一下。"
                },
                {
                    "id": "120440907",
                    "speaker": "梦见月瑞希",
                    "text": "我是梦见月瑞希，叫我瑞希就好。我来自食梦貘一族，也是稻妻的妖怪之一哦。"
                },
                {
                    "id": "120440908",
                    "speaker": "派蒙",
                    "text": "食梦貘？"
                },
                {
                    "id": "120440909",
                    "speaker": "小食梦貘",
                    "text": "啾啾！"
                },
                {
                    "id": "120440910",
                    "speaker": "派蒙",
                    "text": "是之前的那个小家伙…"
                },
                {
                    "id": "120440911",
                    "speaker": "梦见月瑞希",
                    "text": "这就是我们一族原本的样子，两位刚刚应该就是被它吸引才误入了我的梦境吧？"
                },
                {
                    "id": "120440912",
                    "speaker": "梦见月瑞希",
                    "text": "食梦貘拥有吞食人类噩梦的能力，而噩梦需要我们在自己的梦境里进行消化，你们刚刚看到的就是我消化噩梦的场景。"
                },
                {
                    "id": "120440913",
                    "speaker": "梦见月瑞希",
                    "text": "我一口气吃了太多噩梦，它们堵在一起，让我有些消化不良…幸好它带你们闯了进来。"
                },
                {
                    "id": "120440914",
                    "speaker": "梦见月瑞希",
                    "text": "也算是歪打正着，帮了我一个大忙，现在我可以好好消化这些噩梦了。"
                },
                {
                    "id": "120440915",
                    "speaker": "派蒙",
                    "text": "我们就是发现你有些难受才凑过去的，虽然不知道具体发生了什么，但能帮到你就好。"
                },
                {
                    "id": "120440916",
                    "speaker": "派蒙",
                    "text": "我最讨厌噩梦了，能吞食噩梦的妖怪，确实要好好帮助一下呢！"
                },
                {
                    "id": "120440917",
                    "speaker": "梦见月瑞希",
                    "text": "不过，非常抱歉…"
                },
                {
                    "id": "120440918",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "120440919",
                    "speaker": "梦见月瑞希",
                    "text": "你在梦境里凑过来的时候，我从你身上分离出来的不是噩梦，而是美梦…"
                },
                {
                    "id": "120440920",
                    "speaker": "梦见月瑞希",
                    "text": "之前吃了那么多噩梦，我的动作都变得机械了，没留意就一口咬了下去…"
                },
                {
                    "id": "120440921",
                    "speaker": "派蒙",
                    "text": "原来食梦貘也可以吃美梦啊…话说回来，这是很过分的事吗？"
                },
                {
                    "id": "120440922",
                    "speaker": "梦见月瑞希",
                    "text": "当然了，美梦对于人类来说十分珍贵，怎么能像噩梦那样随意吞食呢？"
                },
                {
                    "id": "120440923",
                    "speaker": "梦见月瑞希",
                    "text": "我们食梦貘一族有个不成文的规定，未经允许绝对不能吞食他人的美梦，我真是太不小心了…",
                    "choices": [
                        {
                            "id": "120440924",
                            "text": "不必这么自责。",
                            "response": [
                                {
                                    "id": "120440926",
                                    "speaker": "梦见月瑞希",
                                    "text": "难道你没有觉得十分低落，又或者忽然想起很多伤心往事？"
                                },
                                {
                                    "id": "120440927",
                                    "speaker": "Player",
                                    "text": "没有啊。"
                                },
                                {
                                    "id": "120440928",
                                    "speaker": "梦见月瑞希",
                                    "text": "自己的美梦被吞食一部分后还能维持如此稳定的心理状态，真是难得一见的案例…"
                                },
                                {
                                    "id": "120440929",
                                    "speaker": "派蒙",
                                    "text": "#嗯…肯定是{NICKNAME}的美梦太多了，被吃掉一点也没关系嘛！"
                                },
                                {
                                    "id": "120440930",
                                    "speaker": "梦见月瑞希",
                                    "text": "但我还是应该向你提供补偿…这样吧，请收下这个。"
                                },
                                {
                                    "id": "120440931",
                                    "speaker": "派蒙",
                                    "text": "秋沙钱汤贵宾邀请函…"
                                },
                                {
                                    "id": "120440932",
                                    "speaker": "派蒙",
                                    "text": "本店有多位心理诊疗师坐镇，并附带温泉和美食服务。带着烦恼前来，带着快乐离开…"
                                },
                                {
                                    "id": "120440933",
                                    "speaker": "梦见月瑞希",
                                    "text": "邀请函上标注了地址，我就在那里工作。"
                                },
                                {
                                    "id": "120440934",
                                    "speaker": "梦见月瑞希",
                                    "text": "使用这张邀请函，你们可以在那里免费享受最高级别的服务…啊，说起来我也得赶快回去，店里的事务不能搁置太久。"
                                },
                                {
                                    "id": "120440935",
                                    "speaker": "梦见月瑞希",
                                    "text": "那么，期待你们的正式光临哦！"
                                },
                                {
                                    "id": "120440936",
                                    "speaker": "派蒙",
                                    "text": "这么说，那位食梦貘姐姐还是一位心理诊疗师？",
                                    "choices": [
                                        {
                                            "id": "120440937",
                                            "text": "不意外。",
                                            "response": [
                                                {
                                                    "id": "120440939",
                                                    "speaker": "派蒙",
                                                    "text": "心理诊疗服务…除了思考下一顿该吃什么，很少有能让我发愁的事情。"
                                                },
                                                {
                                                    "id": "120440940",
                                                    "speaker": "派蒙",
                                                    "text": "对了，那个什么汤好像也提供美食服务，有这张卡的话就可以去那里免费吃大餐吧？我们可不能浪费这次机会哦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120440938",
                                            "text": "有意思。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120440925",
                            "text": "我感觉还好。"
                        }
                    ]
                }
            ]
        },
