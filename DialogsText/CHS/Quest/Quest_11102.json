            "dialogues": [
                {
                    "id": "111022001",
                    "speaker": "男性信众",
                    "text": "「星辰天君」大人居然会失手，一定是状态不好吧？"
                }
            ]
        },
        {
            "id": "1110221",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111022101",
                    "speaker": "女性信众",
                    "text": "到底怎么回事，还好有你们在…"
                }
            ]
        },
        {
            "id": "1110222",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111022201",
                    "speaker": "商人信众",
                    "text": "这些丘丘人，以「星辰天君」的法力居然也制服不了吗…"
                }
            ]
        },
        {
            "id": "1110223",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111022301",
                    "speaker": "掇星攫辰天君",
                    "text": "本仙真的只是身体有恙，这次的事还望不要到处宣扬…"
                }
            ]
        },
        {
            "id": "1110224",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "111022401",
                    "speaker": "魈",
                    "text": "做好准备就进去吧，不要放任那些妖魔太久。"
                }
            ]
        }
    ]
}