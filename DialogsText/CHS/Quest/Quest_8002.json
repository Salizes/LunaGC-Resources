    "talks": [
        {
            "id": "800201",
            "objective": "前往西风大教堂",
            "dialogues": [
                {
                    "id": "80020101",
                    "speaker": "芭芭拉",
                    "text": "荣誉骑士！你好，最近过得如何？今天有什么事吗？"
                },
                {
                    "id": "80020102",
                    "speaker": "芭芭拉",
                    "text": "啊…不过，先说好，想再借天空之琴，是不可以的！"
                },
                {
                    "id": "80020103",
                    "speaker": "派蒙",
                    "text": "（看来她还没有发现幻术的事…）"
                },
                {
                    "id": "80020104",
                    "speaker": "派蒙",
                    "text": "我们是来打听事情的。芭芭拉听说过「世上第一座耕地机」吗？"
                },
                {
                    "id": "80020105",
                    "speaker": "芭芭拉",
                    "text": "嗯？那是什么？「耕地机」…是用来做什么的？"
                },
                {
                    "id": "80020106",
                    "speaker": "派蒙",
                    "text": "唔，果然不知道啊。那换个问题吧，教会有没有弄丢过七天神像呢？"
                },
                {
                    "id": "80020107",
                    "speaker": "芭芭拉",
                    "text": "欸？"
                },
                {
                    "id": "80020108",
                    "speaker": "芭芭拉",
                    "text": "你们是来问那个「老故事」的吗？好意外，因为是很久以前的事，现在已经没有什么人再提起了。"
                },
                {
                    "id": "80020109",
                    "speaker": "芭芭拉",
                    "text": "很久以前，确实有座七天神像一夜之间突然消失，没有留下任何痕迹。"
                },
                {
                    "id": "80020110",
                    "speaker": "芭芭拉",
                    "text": "当时，几乎所有教会成员都参与了搜索，但最后也没有找到。"
                },
                {
                    "id": "80020111",
                    "speaker": "芭芭拉",
                    "text": "在教会的记载里，这件怪事被称为「失落的七天神像」。"
                },
                {
                    "id": "80020112",
                    "speaker": "派蒙",
                    "text": "唔…果然。"
                },
                {
                    "id": "80020113",
                    "speaker": "芭芭拉",
                    "text": "果然？"
                },
                {
                    "id": "80020114",
                    "speaker": "派蒙",
                    "text": "啊，没什么。还有别的什么线索吗？呃，我是说…还有别的什么怪事吗？"
                },
                {
                    "id": "80020115",
                    "speaker": "派蒙",
                    "text": "（对不起了，芭芭拉，暂时不能告诉你我们见过神像的事…这也是商量过的结果，为了你的安全…）"
                },
                {
                    "id": "80020116",
                    "speaker": "芭芭拉",
                    "text": "别的怪事？不太清楚，我想想教会记录过的怪事…「暴君的遗怨」？不对，时间上应该关联不大…"
                },
                {
                    "id": "80020117",
                    "speaker": "派蒙",
                    "text": "「暴君的遗怨」？"
                },
                {
                    "id": "80020118",
                    "speaker": "芭芭拉",
                    "text": "哦，这件怪事指的是，现在被称作「风龙废墟」的「旧蒙德」，有一段时间变得非常危险。"
                },
                {
                    "id": "80020119",
                    "speaker": "芭芭拉",
                    "text": "在很多年前的某段时间里，只要有人接近那里，就会引来从天而降的火球。"
                },
                {
                    "id": "80020120",
                    "speaker": "派蒙",
                    "text": "从天而降的火球？！好可怕。"
                },
                {
                    "id": "80020121",
                    "speaker": "芭芭拉",
                    "text": "当时，人们认为那是「龙卷之魔神」的诅咒，所以把它叫做「暴君的遗怨」。"
                },
                {
                    "id": "80020122",
                    "speaker": "芭芭拉",
                    "text": "这个诡异的现象持续了一年，最后也没能解决，后来是自己慢慢停息的。",
                    "choices": [
                        {
                            "id": "80020123",
                            "text": "这也太古怪了。",
                            "response": [
                                {
                                    "id": "80020125",
                                    "speaker": "芭芭拉",
                                    "text": "嗯，后来教会认为，「暴君遗怨」的说法站不住脚。龙卷之魔神，按理说不会发射火球…"
                                },
                                {
                                    "id": "80020126",
                                    "speaker": "芭芭拉",
                                    "text": "恐怕，是有别的什么原因引发了灾祸吧。"
                                },
                                {
                                    "id": "80020127",
                                    "speaker": "芭芭拉",
                                    "text": "总之，这件事和「失落的神像」可能没有关系。但其它的怪事，我也联想不到什么了。"
                                },
                                {
                                    "id": "80020128",
                                    "speaker": "派蒙",
                                    "text": "没关系，还是很谢谢你！"
                                },
                                {
                                    "id": "80020129",
                                    "speaker": "罗莎莉亚",
                                    "text": "「谢谢」？我好像又听到了麻烦的词…"
                                },
                                {
                                    "id": "80020130",
                                    "speaker": "芭芭拉",
                                    "text": "啊，是你啊，罗莎莉亚。"
                                },
                                {
                                    "id": "80020131",
                                    "speaker": "罗莎莉亚",
                                    "text": "如果要找骑士团，他们现在没时间，「那群魔物」又回来了。"
                                },
                                {
                                    "id": "80020132",
                                    "speaker": "芭芭拉",
                                    "text": "「那群魔物」？"
                                },
                                {
                                    "id": "80020133",
                                    "speaker": "罗莎莉亚",
                                    "text": "就是那些曾经借风魔龙之乱，试图进攻蒙德城的怪物。"
                                },
                                {
                                    "id": "80020134",
                                    "speaker": "派蒙",
                                    "text": "那不就是深渊教团吗？！它们又有动作了？"
                                },
                                {
                                    "id": "80020135",
                                    "speaker": "罗莎莉亚",
                                    "text": "嗯，它们正在<color=#00E1FFFF>奔狼领</color>集结，狼群躁动不安。"
                                },
                                {
                                    "id": "80020136",
                                    "speaker": "罗莎莉亚",
                                    "text": "深渊教团，或许是…盯上了「北风王狼的残魂」？至于是为了什么，我还不能确定。"
                                },
                                {
                                    "id": "80020137",
                                    "speaker": "罗莎莉亚",
                                    "text": "琴团长已经去了<color=#00E1FFFF>奔狼领</color>，我也要开始暗中行动了。"
                                },
                                {
                                    "id": "80020138",
                                    "speaker": "芭芭拉",
                                    "text": "那、那我也要去！"
                                },
                                {
                                    "id": "80020139",
                                    "speaker": "罗莎莉亚",
                                    "text": "琴团长说，要你留在教会，做好神职人员的本职工作。"
                                },
                                {
                                    "id": "80020140",
                                    "speaker": "芭芭拉",
                                    "text": "可、可你也是神职人员啊…"
                                },
                                {
                                    "id": "80020141",
                                    "speaker": "Player",
                                    "text": "不用担心，我也会去帮忙的。"
                                },
                                {
                                    "id": "80020142",
                                    "speaker": "派蒙",
                                    "text": "对，我们也会去帮助琴团长的！"
                                },
                                {
                                    "id": "80020143",
                                    "speaker": "芭芭拉",
                                    "text": "唔…好吧，有「荣誉骑士」在的话…"
                                },
                                {
                                    "id": "80020144",
                                    "speaker": "芭芭拉",
                                    "text": "但还是请务必小心行事。愿风神保佑大家都安然无恙…"
                                }
                            ]
                        },
                        {
                            "id": "80020124",
                            "text": "未必和暴君有关吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800209",
            "objective": "与戴因对话",
            "dialogues": [
                {
                    "id": "80020401",
                    "speaker": "戴因斯雷布",
                    "text": "巨大的神像，恢弘的教堂。蒙德人为了修建它们，必然花费了海量的资源与精力。"
                },
                {
                    "id": "80020402",
                    "speaker": "戴因斯雷布",
                    "text": "但收到这份礼物的风神，究竟感受到了多少，又回报了多少呢？"
                },
                {
                    "id": "80020403",
                    "speaker": "派蒙",
                    "text": "「信仰」是不求回报的吧？"
                },
                {
                    "id": "80020404",
                    "speaker": "戴因斯雷布",
                    "text": "哼，只要神灵心安理得，我也不多说什么。"
                },
                {
                    "id": "80020405",
                    "speaker": "派蒙",
                    "text": "嘘——！马上就要进教堂了，风神的坏话可不能乱说。"
                },
                {
                    "id": "80020406",
                    "speaker": "派蒙",
                    "text": "而且风神其实…呃，啊，没什么。"
                },
                {
                    "id": "80020407",
                    "speaker": "戴因斯雷布",
                    "text": "呵，我本来就没有进教堂的打算。与修女打交道的事，就交给你们了。"
                },
                {
                    "id": "80020408",
                    "speaker": "派蒙",
                    "text": "欸？",
                    "choices": [
                        {
                            "id": "80020409",
                            "text": "之前都是一起行动的。",
                            "response": [
                                {
                                    "id": "80020411",
                                    "speaker": "戴因斯雷布",
                                    "text": "你是蒙德城的荣誉骑士，深受信任，他们应该会放心让你参与到这件事里。"
                                },
                                {
                                    "id": "80020412",
                                    "speaker": "戴因斯雷布",
                                    "text": "而我的出现，只会徒增警惕罢了。",
                                    "choices": [
                                        {
                                            "id": "80020413",
                                            "text": "因为是陌生人？",
                                            "response": [
                                                {
                                                    "id": "80020415",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "嗯，而且就像小家伙说的一样，我随时…都可能说出教会不想听到的话。"
                                                },
                                                {
                                                    "id": "80020416",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "「拒信者」踏入「虔诚之地」，从来不会有什么好结果。"
                                                },
                                                {
                                                    "id": "80020417",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "我过去从未蒙受过神明的恩惠，现在和未来也没有必要。"
                                                },
                                                {
                                                    "id": "80020418",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "好了，这种事说得也够多了。我们在闲聊的时候，深渊教团可没有停下脚步。"
                                                },
                                                {
                                                    "id": "80020419",
                                                    "speaker": "派蒙",
                                                    "text": "#唔，那，{NICKNAME}，就我们两个人去问问看吧。"
                                                },
                                                {
                                                    "id": "80020420",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "我还得提醒你们一句，你们最好也别向教会里的人提起「污秽逆位神像」。"
                                                },
                                                {
                                                    "id": "80020421",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "西风教会对神像的事不会置之不理，但如果他们贸然插手，只怕会打草惊蛇。"
                                                },
                                                {
                                                    "id": "80020422",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "而且…不论是谁，触碰了与「深渊」有关的因果，一般也不会有太好的结局。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80020414",
                                            "text": "你觉得你会不受欢迎？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80020410",
                            "text": "你不好奇吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800202",
            "objective": "与芭芭拉对话",
            "dialogues": []
        },
        {
            "id": "800210",
            "objective": "与戴因对话",
            "dialogues": [
                {
                    "id": "80020501",
                    "speaker": "戴因斯雷布",
                    "text": "原来如此，深渊教团已经展开新的行动了么？"
                },
                {
                    "id": "80020502",
                    "speaker": "戴因斯雷布",
                    "text": "很可能与「污秽逆位神像」有关，我们也去看看。"
                },
                {
                    "id": "80020503",
                    "speaker": "派蒙",
                    "text": "说起来，深渊教团去奔狼领干嘛？难道又要重演特瓦林事件？啊——重复的灾难就别再来啦。"
                },
                {
                    "id": "80020504",
                    "speaker": "戴因斯雷布",
                    "text": "不，应该不会。"
                },
                {
                    "id": "80020505",
                    "speaker": "戴因斯雷布",
                    "text": "与被镇压的奥赛尔不同，魔神「安德留斯」早就死了。"
                },
                {
                    "id": "80020506",
                    "speaker": "戴因斯雷布",
                    "text": "如今守护奔狼领的，只是它的残魂而已。"
                },
                {
                    "id": "80020507",
                    "speaker": "戴因斯雷布",
                    "text": "深渊使徒将那缕残魂当作目标，或许只是想要从风神眷属的口中，挖出些有用的信息…"
                }
            ]
        },
        {
            "id": "800203",
            "objective": "前往奔狼领",
            "dialogues": [
                {
                    "id": "80020301",
                    "speaker": "雷泽",
                    "text": "这里，不欢迎，你。"
                },
                {
                    "id": "80020302",
                    "speaker": "深渊使徒",
                    "text": "呵呵呵…仅剩残魂的狼，竟然还有养护子嗣的习性。"
                },
                {
                    "id": "80020303",
                    "speaker": "深渊使徒",
                    "text": "是想要作为护卫吗？但他的力量，显然不能与魔神曾经的利爪相比。"
                },
                {
                    "id": "80020304",
                    "speaker": "深渊使徒",
                    "text": "而只要服从于我们，你就能重获比肩神明的权柄，就像过去一样。"
                },
                {
                    "id": "80020305",
                    "speaker": "玻瑞亚斯",
                    "text": "谗…言…"
                },
                {
                    "id": "80020306",
                    "speaker": "派蒙",
                    "text": "这是什么仪式？它看上去很痛苦！"
                },
                {
                    "id": "80020307",
                    "speaker": "派蒙",
                    "text": "唔…是类似控制特瓦林心智时的「腐蚀」吗？！"
                },
                {
                    "id": "80020308",
                    "speaker": "雷泽",
                    "text": "狼，不屈服。但，不能，再继续。",
                    "choices": [
                        {
                            "id": "80020309",
                            "text": "我来阻止它。",
                            "response": [
                                {
                                    "id": "80020311",
                                    "speaker": "深渊使徒",
                                    "text": "不论几次，你们的努力都只是徒劳无功…"
                                }
                            ]
                        },
                        {
                            "id": "80020310",
                            "text": "再战一次使徒而已。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800204",
            "objective": "打倒深渊教团",
            "dialogues": []
        },
        {
            "id": "800205",
            "objective": "与琴对话",
            "dialogues": [
                {
                    "id": "80020201",
                    "speaker": "派蒙",
                    "text": "呼——这一带敌人可真不少！"
                },
                {
                    "id": "80020202",
                    "speaker": "戴因斯雷布",
                    "text": "越靠近目标，敌人就越多。哼，符合教团的作风。"
                },
                {
                    "id": "80020203",
                    "speaker": "Player",
                    "text": "我们得快点找到「王狼」。"
                },
                {
                    "id": "80020204",
                    "speaker": "派蒙",
                    "text": "嗯！走吧！"
                },
                {
                    "id": "80020205",
                    "speaker": "戴因斯雷布",
                    "text": "我…就不去了。"
                },
                {
                    "id": "80020206",
                    "speaker": "派蒙",
                    "text": "哎？为什么呀？难道你害怕毛茸茸的生物？",
                    "choices": [
                        {
                            "id": "80020207",
                            "text": "应该不是这种原因。",
                            "response": [
                                {
                                    "id": "80020209",
                                    "speaker": "戴因斯雷布",
                                    "text": "与「狼」无关。是因为它作为昔日的魔神，却效力于如今的七神。"
                                },
                                {
                                    "id": "80020210",
                                    "speaker": "戴因斯雷布",
                                    "text": "我无法认可它的行为，更不想和它打交道。"
                                },
                                {
                                    "id": "80020211",
                                    "speaker": "戴因斯雷布",
                                    "text": "再说，讨人喜欢是你的本事，我可做不到。",
                                    "choices": [
                                        {
                                            "id": "80020212",
                                            "text": "你真的很讨厌七神呢。",
                                            "response": [
                                                {
                                                    "id": "80020213",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "神明本就不值得期待。"
                                                },
                                                {
                                                    "id": "80020216",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "就当是我私人的建议好了，记住，随时都要对神明保持警惕。"
                                                },
                                                {
                                                    "id": "80020217",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "不要太过信任他们，但，也不要走上…「推翻」或「猎杀」的道路。"
                                                },
                                                {
                                                    "id": "80020218",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "即使，对于你当年那个「仇敌」，也是如此。"
                                                },
                                                {
                                                    "id": "80020219",
                                                    "speaker": "派蒙",
                                                    "text": "不要信任，也不要猎杀…好别扭的想法。戴因究竟是在仇恨七神，还是维护七神呢？"
                                                },
                                                {
                                                    "id": "80020220",
                                                    "speaker": "Player",
                                                    "text": "为什么会有如此矛盾的观点？"
                                                },
                                                {
                                                    "id": "80020221",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "80020222",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "前车之鉴。"
                                                },
                                                {
                                                    "id": "80020223",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "我…就最后告诉你们一个事实吧。"
                                                },
                                                {
                                                    "id": "80020224",
                                                    "speaker": "派蒙",
                                                    "text": "欸？什么事实？"
                                                },
                                                {
                                                    "id": "80020225",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "「坎瑞亚是被神覆灭的国度，而这就是…深渊教团想要覆灭七神国度的原因。」"
                                                },
                                                {
                                                    "id": "80020226",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "闲聊到此为止，先办正事。我去解决剩余的深渊教团，你们也快去快回。事情都解决后，我们在奔狼领的入口见。"
                                                },
                                                {
                                                    "id": "80020227",
                                                    "speaker": "派蒙",
                                                    "text": "啊…他走了…"
                                                },
                                                {
                                                    "id": "80020228",
                                                    "speaker": "派蒙",
                                                    "text": "真是个怪人呢。"
                                                },
                                                {
                                                    "id": "80020229",
                                                    "speaker": "Player",
                                                    "text": "我稍微能理解他一点。"
                                                },
                                                {
                                                    "id": "80020230",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，这么说来，你也很提防「陌生的神灵」呢。"
                                                },
                                                {
                                                    "id": "80020231",
                                                    "speaker": "派蒙",
                                                    "text": "那时在璃月，请仙典仪上，你的选择和戴因很类似…"
                                                },
                                                {
                                                    "id": "80020232",
                                                    "speaker": "Player",
                                                    "text": "因为缺乏信任。无从交涉，只能回避。"
                                                },
                                                {
                                                    "id": "80020233",
                                                    "speaker": "派蒙",
                                                    "text": "唉…真是不容易啊…"
                                                },
                                                {
                                                    "id": "80020234",
                                                    "speaker": "琴",
                                                    "text": "荣誉骑士，派蒙！你们怎么在这里？"
                                                },
                                                {
                                                    "id": "80020235",
                                                    "speaker": "派蒙",
                                                    "text": "呀，琴团长！太好了，找到你啦！"
                                                },
                                                {
                                                    "id": "80020236",
                                                    "speaker": "派蒙",
                                                    "text": "我们听罗莎莉亚说，你来这里作战，所以就过来支援你啦。"
                                                },
                                                {
                                                    "id": "80020237",
                                                    "speaker": "琴",
                                                    "text": "那真是非常感谢。这次暴动非常诡异，深渊教团将奔狼领层层包围，我正准备调动兵力对抗。"
                                                },
                                                {
                                                    "id": "80020238",
                                                    "speaker": "琴",
                                                    "text": "我刚在奔狼领侦察了一番…没想到遇见了你们。"
                                                },
                                                {
                                                    "id": "80020239",
                                                    "speaker": "琴",
                                                    "text": "听罗莎莉亚说，他们的目标可能是「玻瑞亚斯」。"
                                                },
                                                {
                                                    "id": "80020240",
                                                    "speaker": "琴",
                                                    "text": "但深渊教团…与「玻瑞亚斯」…会有什么关联？"
                                                },
                                                {
                                                    "id": "80020241",
                                                    "speaker": "派蒙",
                                                    "text": "单纯的找麻烦，应该不需要理由吧。"
                                                },
                                                {
                                                    "id": "80020242",
                                                    "speaker": "派蒙",
                                                    "text": "你看，深渊教团已经找过特瓦林的麻烦，再去找另一个风神眷属的麻烦，也不奇怪呀。"
                                                },
                                                {
                                                    "id": "80020243",
                                                    "speaker": "琴",
                                                    "text": "也、也有道理…"
                                                },
                                                {
                                                    "id": "80020244",
                                                    "speaker": "琴",
                                                    "text": "总之，这附近的威胁，无论是明面的，还是潜伏的，都交给我来处理吧。"
                                                },
                                                {
                                                    "id": "80020245",
                                                    "speaker": "琴",
                                                    "text": "荣誉骑士，请你赶去确认一下「王狼」是否遭遇危机。"
                                                },
                                                {
                                                    "id": "80020246",
                                                    "speaker": "琴",
                                                    "text": "魔神的残魂…不常见人。但我听说你与它有过一面之缘，由你出面，或许是最合适的。"
                                                },
                                                {
                                                    "id": "80020247",
                                                    "speaker": "Player",
                                                    "text": "交给我吧。"
                                                },
                                                {
                                                    "id": "80020248",
                                                    "speaker": "琴",
                                                    "text": "嗯，多加小心。前方的任务就拜托你了，「西风的荣誉骑士」。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80020214",
                                            "text": "你真的很不喜欢交际呢。",
                                            "response": [
                                                {
                                                    "id": "80020215",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "与人打交道当然没问题，与神…就不好说了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80020208",
                            "text": "毛茸茸不可爱吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800206",
            "objective": "寻找「北风的王狼」",
            "dialogues": [
                {
                    "id": "80020601",
                    "speaker": "戴因斯雷布",
                    "text": "你们去教会里找人打听吧，我就在这里等着你们。"
                }
            ]
        },
        {
            "id": "800211",
            "objective": "与雷泽对话",
            "dialogues": []
        },
        {
            "id": "800207",
            "objective": "打倒所有魔物",
            "dialogues": [
                {
                    "id": "80020701",
                    "speaker": "深渊使徒",
                    "text": "哼…短暂的仪式被打断了，你们真是好运。"
                },
                {
                    "id": "80020702",
                    "speaker": "深渊使徒",
                    "text": "没想到，仅仅是一缕残魂，也有这么坚强的意志…"
                },
                {
                    "id": "80020703",
                    "speaker": "深渊使徒",
                    "text": "但这种微小的变数，不足以影响全局。"
                },
                {
                    "id": "80020704",
                    "speaker": "派蒙",
                    "text": "又消失了…",
                    "choices": [
                        {
                            "id": "80020705",
                            "text": "至少阻止了它的行动。",
                            "response": [
                                {
                                    "id": "80020707",
                                    "speaker": "雷泽",
                                    "text": "谢谢你们，来得，及时。"
                                },
                                {
                                    "id": "80020708",
                                    "speaker": "玻瑞亚斯",
                                    "text": "人类中的「卢皮卡」…让你们见到我如此姿态，见笑了。"
                                },
                                {
                                    "id": "80020709",
                                    "speaker": "玻瑞亚斯",
                                    "text": "但深渊的使徒，终究是太小看我了。"
                                },
                                {
                                    "id": "80020710",
                                    "speaker": "雷泽",
                                    "text": "王狼，不拒绝，试炼。但，阴森的外来者，不遵守，试炼的规矩。"
                                },
                                {
                                    "id": "80020711",
                                    "speaker": "雷泽",
                                    "text": "我也，注意不到，布下的陷阱…"
                                },
                                {
                                    "id": "80020712",
                                    "speaker": "派蒙",
                                    "text": "也就是说，是深渊教团先做好了腐蚀的准备，再以试炼的名义，把「王狼」唤醒？",
                                    "choices": [
                                        {
                                            "id": "80020713",
                                            "text": "这不是你的错，雷泽。",
                                            "response": [
                                                {
                                                    "id": "80020715",
                                                    "speaker": "雷泽",
                                                    "text": "#谢谢你，{NICKNAME}。以后，我的爪子，需要，更锋利。"
                                                },
                                                {
                                                    "id": "80020716",
                                                    "speaker": "雷泽",
                                                    "text": "你们，闻到了危险，来这里？"
                                                },
                                                {
                                                    "id": "80020717",
                                                    "speaker": "派蒙",
                                                    "text": "不，我们是听说的，我们的鼻子没有这么好用啦。"
                                                },
                                                {
                                                    "id": "80020718",
                                                    "speaker": "派蒙",
                                                    "text": "除了来帮忙之外，我们还有一件事要请教。"
                                                },
                                                {
                                                    "id": "80020719",
                                                    "speaker": "派蒙",
                                                    "text": "请问…这位魔神大人，你知道「世上第一座耕地机」吗？"
                                                },
                                                {
                                                    "id": "80020720",
                                                    "speaker": "玻瑞亚斯",
                                                    "text": "我不关心人类的造物，不知道「耕地机」是什么。但只说印象深刻的机械，曾经倒是有一座。"
                                                },
                                                {
                                                    "id": "80020721",
                                                    "speaker": "玻瑞亚斯",
                                                    "text": "它误闯了我的试炼场地，我将它视为参与试炼的勇士。"
                                                },
                                                {
                                                    "id": "80020722",
                                                    "speaker": "玻瑞亚斯",
                                                    "text": "可它没有智能，只想要战斗。它从头到脚，都是为了杀戮而铸造。"
                                                },
                                                {
                                                    "id": "80020723",
                                                    "speaker": "玻瑞亚斯",
                                                    "text": "最终，我的攻击损坏了它。在倒下之前，它离开了这块试炼场。"
                                                },
                                                {
                                                    "id": "80020724",
                                                    "speaker": "派蒙",
                                                    "text": "唔…听这些描述，好像不排除是「世上第一座耕地机」的可能？",
                                                    "choices": [
                                                        {
                                                            "id": "80020725",
                                                            "text": "它会旋转吗？",
                                                            "response": [
                                                                {
                                                                    "id": "80020726",
                                                                    "speaker": "玻瑞亚斯",
                                                                    "text": "是的，它会旋转，跳得很高，还会发射火球。力量虽不比魔神，但比很多持有「神之眼」的人都强。"
                                                                },
                                                                {
                                                                    "id": "80020730",
                                                                    "speaker": "派蒙",
                                                                    "text": "火球…？咦，最近是不是在哪听到过这个词来着。"
                                                                },
                                                                {
                                                                    "id": "80020731",
                                                                    "speaker": "派蒙",
                                                                    "text": "总之，这个消息是不是能说明，「世上第一座耕地机」，确实来过蒙德？"
                                                                },
                                                                {
                                                                    "id": "80020732",
                                                                    "speaker": "派蒙",
                                                                    "text": "听起来，「世上第一座」的力量，比后来那些量产的遗迹守卫强了很多呢。"
                                                                },
                                                                {
                                                                    "id": "80020733",
                                                                    "speaker": "派蒙",
                                                                    "text": "但在这个故事里，它好像在「狼的试炼」里被打坏了…"
                                                                },
                                                                {
                                                                    "id": "80020734",
                                                                    "speaker": "雷泽",
                                                                    "text": "不知道。那么，帮上忙了吗？"
                                                                },
                                                                {
                                                                    "id": "80020735",
                                                                    "speaker": "派蒙",
                                                                    "text": "帮大忙了，谢谢你们！"
                                                                },
                                                                {
                                                                    "id": "80020736",
                                                                    "speaker": "派蒙",
                                                                    "text": "我们要继续去追查一件很重要的事了。虽然深渊使徒离开了，但教团的进攻还没结束，你们也要小心！"
                                                                },
                                                                {
                                                                    "id": "80020737",
                                                                    "speaker": "雷泽",
                                                                    "text": "嗯，我能闻到，更加危险的，东西。"
                                                                },
                                                                {
                                                                    "id": "80020738",
                                                                    "speaker": "雷泽",
                                                                    "text": "你们，也，保护自己。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80020727",
                                                            "text": "它会发射导弹吗？",
                                                            "response": [
                                                                {
                                                                    "id": "80020728",
                                                                    "speaker": "玻瑞亚斯",
                                                                    "text": "「导弹」？不…我已经说了，我不关心人类的造物，不懂这些奇怪的词。"
                                                                },
                                                                {
                                                                    "id": "80020729",
                                                                    "speaker": "玻瑞亚斯",
                                                                    "text": "它会旋转，跳得很高，还会发射火球。力量虽不比魔神，但比很多持有「神之眼」的人都强。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80020714",
                                            "text": "别沮丧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80020706",
                            "text": "跑得倒是挺快。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800212",
            "objective": "(test)解除束缚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "800208",
            "objective": "与「北风的王狼」对话",
            "dialogues": []
        },
        {
            "id": "800200",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80020001",
                    "speaker": "派蒙",
                    "text": "啊！果然有深渊教团的魔物！"
                },
                {
                    "id": "80020002",
                    "speaker": "戴因斯雷布",
                    "text": "不要轻敌，我们上。"
                },
                {
                    "id": "80020003",
                    "speaker": "派蒙",
                    "text": "掌握了非常重要的情报，我们快去告诉戴因吧！"
                },
                {
                    "id": "80020004",
                    "speaker": "派蒙",
                    "text": "看、看那边！是雷泽！还有…「深渊使徒」！"
                }
            ]
        }
    ]
}