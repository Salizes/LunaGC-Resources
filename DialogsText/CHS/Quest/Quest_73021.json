        }
    },
    "talks": [
        {
            "id": "7302101",
            "objective": "寻找兰阿帕斯",
            "dialogues": [
                {
                    "id": "730210101",
                    "speaker": "派蒙",
                    "text": "哇，这个锅里炖的是什么呀，闻上去真香。只是闻着，口水就不停流下来了…"
                },
                {
                    "id": "730210102",
                    "speaker": "派蒙",
                    "text": "好像是什么汤的样子，嗯…也看不出来是用什么材料做的…"
                },
                {
                    "id": "730210103",
                    "speaker": "派蒙",
                    "text": "#哎呀，{NICKNAME}…"
                },
                {
                    "id": "730210104",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "730210105",
                    "speaker": "派蒙",
                    "text": "你看现在，炖汤的人也不在，这个汤这么香，我们不如偷偷喝上一口尝一尝吧。",
                    "choices": [
                        {
                            "id": "730210106",
                            "text": "那我们就偷偷喝一口吧…",
                            "response": [
                                {
                                    "id": "730210107",
                                    "speaker": "派蒙",
                                    "text": "好耶！"
                                },
                                {
                                    "id": "730210112",
                                    "speaker": "Black Screen",
                                    "text": "锅容量比看上去的要小。\\n里面的内容物就这样全部不见了。"
                                },
                                {
                                    "id": "730210113",
                                    "speaker": "派蒙",
                                    "text": "噗哈…嗯？这个汤，香倒是很香，但是怎么感觉尝不出什么味道呢…"
                                },
                                {
                                    "id": "730210114",
                                    "speaker": "？？？",
                                    "text": "兰穆护昆达在上！你们这些那菈，怎么回事！"
                                },
                                {
                                    "id": "730210115",
                                    "speaker": "派蒙",
                                    "text": "兰、兰那罗？到底是从哪里突然出现的！"
                                },
                                {
                                    "id": "730210116",
                                    "speaker": "兰阿帕斯",
                                    "text": "从地里啦！不说这个，你们怎么能偷喝我做的汤，那可是我兰阿帕斯辛辛苦苦做出来的汤耶！",
                                    "choices": [
                                        {
                                            "id": "730210117",
                                            "text": "对不起…",
                                            "response": [
                                                {
                                                    "id": "730210118",
                                                    "speaker": "派蒙",
                                                    "text": "对不起…"
                                                },
                                                {
                                                    "id": "730210119",
                                                    "speaker": "兰阿帕斯",
                                                    "text": "哼，偷喝了我做的汤，一句对不起就够了吗！"
                                                },
                                                {
                                                    "id": "730210123",
                                                    "speaker": "兰阿帕斯",
                                                    "text": "你们知道在这里做汤有多难吗？一会儿，天上下雨。一会儿，太阳出来。"
                                                },
                                                {
                                                    "id": "730210124",
                                                    "speaker": "兰阿帕斯",
                                                    "text": "我好不容易做了这么一锅，竟然在采新鲜的香辛果的时候，被你们…"
                                                },
                                                {
                                                    "id": "730210125",
                                                    "speaker": "派蒙",
                                                    "text": "我们只是因为味道太香才…"
                                                },
                                                {
                                                    "id": "730210126",
                                                    "speaker": "派蒙",
                                                    "text": "不过，既然这么困难，为什么要在这里做汤呢？"
                                                },
                                                {
                                                    "id": "730210127",
                                                    "speaker": "兰阿帕斯",
                                                    "text": "哼，烹饪最关键的东西，必须每天都要取得的…",
                                                    "choices": [
                                                        {
                                                            "id": "730210128",
                                                            "text": "是身为厨师的自尊？",
                                                            "response": [
                                                                {
                                                                    "id": "730210130",
                                                                    "speaker": "兰阿帕斯",
                                                                    "text": "是水！是水啦！汤的香味，受水影响很大，当然要用最好的水来做汤啦。"
                                                                },
                                                                {
                                                                    "id": "730210131",
                                                                    "speaker": "兰阿帕斯",
                                                                    "text": "我一路上，在水天丛林取各个地方的水来做汤。采集了好多好多、有树上的叶子那么多的水样以后，才找到了最好的「活源水」。"
                                                                },
                                                                {
                                                                    "id": "730210132",
                                                                    "speaker": "兰阿帕斯",
                                                                    "text": "那才是配得上无忧节的「至上珍馐」！就算跟你们说这个，你们肯定也不明白吧…只有之前那个那菈…"
                                                                },
                                                                {
                                                                    "id": "730210133",
                                                                    "speaker": "派蒙",
                                                                    "text": "说到这个，其实我们是从兰帕卡提那来的…"
                                                                },
                                                                {
                                                                    "id": "730210134",
                                                                    "speaker": "Black Screen",
                                                                    "text": "向兰阿帕斯述说事情的经过。"
                                                                },
                                                                {
                                                                    "id": "730210135",
                                                                    "speaker": "兰阿帕斯",
                                                                    "text": "啊，原来是「妹妹」的那菈朋友！而且，要举办无忧节了！"
                                                                },
                                                                {
                                                                    "id": "730210136",
                                                                    "speaker": "兰阿帕斯",
                                                                    "text": "不过没有关系，我已经取得「活源水」，我的「至上珍馐」已经完成。就在这个锅里…然后…"
                                                                },
                                                                {
                                                                    "id": "730210137",
                                                                    "speaker": "兰阿帕斯",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "730210138",
                                                                    "speaker": "Player",
                                                                    "text": "……"
                                                                },
                                                                {
                                                                    "id": "730210139",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸嘿嘿。你别难过，汤闻起来真的很香…"
                                                                },
                                                                {
                                                                    "id": "730210140",
                                                                    "speaker": "兰阿帕斯",
                                                                    "text": "啊，我的「活源水」！水的源头住着「亚普修那」，好不容易等到它们离开水源，我才取了一锅…"
                                                                },
                                                                {
                                                                    "id": "730210141",
                                                                    "speaker": "兰阿帕斯",
                                                                    "text": "不行，你们一定要再取一锅「活源水」赔给我！"
                                                                },
                                                                {
                                                                    "id": "730210142",
                                                                    "speaker": "派蒙",
                                                                    "text": "「亚普修那」…？那是什么东西？"
                                                                },
                                                                {
                                                                    "id": "730210143",
                                                                    "speaker": "兰阿帕斯",
                                                                    "text": "哼，那菈对森林真是一点也不了解。就是那种住在水里的，四条腿、有尾巴、会咬咬的东西。"
                                                                },
                                                                {
                                                                    "id": "730210144",
                                                                    "speaker": "派蒙",
                                                                    "text": "…狗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "730210145",
                                                                            "text": "狗不住在水里吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "730210147",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "啊，也对。那「亚普修那」到底是什么呢…"
                                                                                },
                                                                                {
                                                                                    "id": "730210148",
                                                                                    "speaker": "兰阿帕斯",
                                                                                    "text": "别管「亚普修那」了！我要水！而且要那边的「活源水」！"
                                                                                },
                                                                                {
                                                                                    "id": "730210149",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "#好啦好啦…{NICKNAME}，没办法，我们走吧…",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "730210150",
                                                                                            "text": "哦。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "730210152",
                                                                                                    "speaker": "兰阿帕斯",
                                                                                                    "text": "一定要「活源水」，其他的水都不行！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "730210151",
                                                                                            "text": "走吧。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "730210146",
                                                                            "text": "哪来的水狗。水之幻形狗吗？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "730210129",
                                                            "text": "是不忘初心的意志？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730210120",
                                            "text": "都、都是派蒙…",
                                            "response": [
                                                {
                                                    "id": "730210121",
                                                    "speaker": "派蒙",
                                                    "text": "#喂！{NICKNAME}，你居然出卖我！"
                                                },
                                                {
                                                    "id": "730210122",
                                                    "speaker": "兰阿帕斯",
                                                    "text": "我才不管是谁喝的啦，反正我的汤没有了！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730210108",
                            "text": "这不太好吧…",
                            "response": [
                                {
                                    "id": "730210109",
                                    "speaker": "派蒙",
                                    "text": "我是真的很好奇嘛，呜，我就偷偷喝一口，就一口！"
                                },
                                {
                                    "id": "730210110",
                                    "speaker": "Player",
                                    "text": "要是喝坏肚子就不好了…"
                                },
                                {
                                    "id": "730210111",
                                    "speaker": "派蒙",
                                    "text": "哼哼，可不要小看派蒙！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302102",
            "objective": "调查飘出香味的锅",
            "dialogues": []
        },
        {
            "id": "7302104",
            "objective": "取得「活源水」",
            "dialogues": [
                {
                    "id": "730210401",
                    "speaker": "兰阿帕斯",
                    "text": "…嗯，确实是河流源头的水，「活源水」凛冽又干净，和月光一样。"
                },
                {
                    "id": "730210402",
                    "speaker": "兰阿帕斯",
                    "text": "如果兰茶荼、兰萨卡和兰非拉是吸着这样的水长大的，那肯定不会变成现在这样的笨蛋。只有兰帕卡提，我的妹妹…"
                },
                {
                    "id": "730210403",
                    "speaker": "派蒙",
                    "text": "咳咳，接下来…"
                },
                {
                    "id": "730210404",
                    "speaker": "兰阿帕斯",
                    "text": "嗯？对了，接下来，你们要做一锅汤赔给我…"
                },
                {
                    "id": "730210405",
                    "speaker": "Black Screen",
                    "text": "在兰阿帕斯的指导下，在水中加入了一些蔬果，开始烹饪。\\n锅中慢慢传出了不错的香味。"
                },
                {
                    "id": "730210406",
                    "speaker": "Black Screen",
                    "text": "完成后，一同品尝了刚刚做好的「汤」。\\n…应该说是符合预期吧，虽然确实有食材的香味…\\n但没有任何调味的汤果然还是太纯粹了。\\n一点味道也没有。"
                },
                {
                    "id": "730210407",
                    "speaker": "兰阿帕斯",
                    "text": "嗯嗯，「至上珍馐」当然就是要有这样的香味才对！"
                },
                {
                    "id": "730210408",
                    "speaker": "派蒙",
                    "text": "#嗯…你觉得呢，{NICKNAME}？",
                    "choices": [
                        {
                            "id": "730210409",
                            "text": "以汤的角度来说，确实能解渴。",
                            "response": [
                                {
                                    "id": "730210411",
                                    "speaker": "派蒙",
                                    "text": "我觉得，如果加点盐和胡椒，应该会比较美味。"
                                },
                                {
                                    "id": "730210412",
                                    "speaker": "Player",
                                    "text": "任何东西加盐和胡椒都会变得美味。"
                                },
                                {
                                    "id": "730210413",
                                    "speaker": "兰阿帕斯",
                                    "text": "兰穆护昆达在上！竟然要加盐…盐是多么可怕的东西！"
                                },
                                {
                                    "id": "730210414",
                                    "speaker": "兰阿帕斯",
                                    "text": "有盐的土地上，就没有生命，兰那罗只能退缩成干种子…那菈竟然要放盐！"
                                },
                                {
                                    "id": "730210415",
                                    "speaker": "兰阿帕斯",
                                    "text": "汤没有味道，是理所应当的！你们这些那菈，竟然不懂这样的道理。"
                                },
                                {
                                    "id": "730210416",
                                    "speaker": "兰阿帕斯",
                                    "text": "以前那个那菈，喝了汤以后，就告诉过我们这样的道理："
                                },
                                {
                                    "id": "730210417",
                                    "speaker": "兰阿帕斯",
                                    "text": "「我们那菈呀，到了孩子们要回家的时候，家里都会传来汤的香味。所以，汤只需要有香味。」"
                                },
                                {
                                    "id": "730210418",
                                    "speaker": "兰阿帕斯",
                                    "text": "#然后，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}夸我兰阿帕斯的汤做得很好，很香。我一直记得。所以，我才不信你说的！"
                                },
                                {
                                    "id": "730210419",
                                    "speaker": "派蒙",
                                    "text": "但只有香味也不行吧…"
                                },
                                {
                                    "id": "730210420",
                                    "speaker": "兰阿帕斯",
                                    "text": "……"
                                },
                                {
                                    "id": "730210421",
                                    "speaker": "兰阿帕斯",
                                    "text": "哼，不过既然你们是这次无忧节的那菈，那一定是兰拉迦、兰帕卡提他们认可的。没办法，就想办法做有味道的汤吧。"
                                },
                                {
                                    "id": "730210422",
                                    "speaker": "兰阿帕斯",
                                    "text": "那下次就找更好的水来做汤，一定能做出更好的汤！"
                                },
                                {
                                    "id": "730210423",
                                    "speaker": "Player",
                                    "text": "…我倒觉得和水没关系。"
                                },
                                {
                                    "id": "730210424",
                                    "speaker": "兰阿帕斯",
                                    "text": "是嘛…不过这次的「烹饪修行」已经圆满结束了。好，一切都等到无忧节再说吧！"
                                },
                                {
                                    "id": "730210425",
                                    "speaker": "兰阿帕斯",
                                    "text": "做汤的办法也教给你们了。这可是伟大那菈认可的味道，你们多尝尝吧。但是，记住：一定要用好水！"
                                },
                                {
                                    "id": "730210426",
                                    "speaker": "派蒙",
                                    "text": "#({NICKNAME}，下次我们加点调味料试试吧。味道应该会不错…）"
                                }
                            ]
                        },
                        {
                            "id": "730210410",
                            "text": "对我来说太健康了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7302105",
            "objective": "将「活源水」带给兰阿帕斯",
            "dialogues": [
