    },
    "talks": [
        {
            "id": "7053701",
            "objective": "(test)调查木箱$HIDDEN",
            "dialogues": [
                {
                    "id": "705371201",
                    "speaker": "Player",
                    "text": "哈哈！是炸弹！我要玩！"
                },
                {
                    "id": "705371202",
                    "speaker": "派蒙",
                    "text": "你怎么突然兴奋起来了？现在还不知道这些炸弹的威力有多大呢，万一伤到无辜路人就不妙了！",
                    "choices": [
                        {
                            "id": "705371203",
                            "text": "反正都是炸鱼，就往湖里扔吧。",
                            "response": [
                                {
                                    "id": "705371205",
                                    "speaker": "派蒙",
                                    "text": "噫！"
                                },
                                {
                                    "id": "705371206",
                                    "speaker": "派蒙",
                                    "text": "被你这么一说，我也有点心痒痒了…"
                                },
                                {
                                    "id": "705371207",
                                    "speaker": "派蒙",
                                    "text": "平常总是听说，可莉想炸鱼，在炸鱼，炸了鱼，然后因此受了罚…"
                                },
                                {
                                    "id": "705371208",
                                    "speaker": "派蒙",
                                    "text": "结果自己身边放着一箱炸弹，站在湖边的时候…确实也想试试看！"
                                },
                                {
                                    "id": "705371209",
                                    "speaker": "派蒙",
                                    "text": "只是扔一个的话…应该不要紧吧？",
                                    "choices": [
                                        {
                                            "id": "705371210",
                                            "text": "我们一人一个！",
                                            "response": [
                                                {
                                                    "id": "705371212",
                                                    "speaker": "Black Screen",
                                                    "text": "与派蒙一起打开了可疑的木箱，各自取出了炸弹，研究了点火的方法，倒数「三，二，一」，拉响引信，一同把炸弹远远丢进了果酒湖里…"
                                                },
                                                {
                                                    "id": "705371213",
                                                    "speaker": "Black Screen",
                                                    "text": "水下传来低沉的轰鸣，两朵水花在湖面上爆开，几条角鲀旋转着飞散…\\n你和派蒙相视一笑，开心地击掌，随后便快速拾掇首次炸鱼的收获，准备离开现场…"
                                                },
                                                {
                                                    "id": "705371214",
                                                    "speaker": "Black Screen",
                                                    "text": "但这次「一时兴起的隐秘炸鱼行动」似乎并不成功，几乎在炸弹起爆的同时，你们就暴露了…"
                                                },
                                                {
                                                    "id": "705371215",
                                                    "speaker": "远方传来的惨叫",
                                                    "text": "啊！！！"
                                                },
                                                {
                                                    "id": "705371216",
                                                    "speaker": "远方传来的惨叫",
                                                    "text": "我的耳朵！！！"
                                                },
                                                {
                                                    "id": "705371217",
                                                    "speaker": "艾玛托",
                                                    "text": "吓死我了！怎么了方妮雅，你不要紧吧？"
                                                },
                                                {
                                                    "id": "705371218",
                                                    "speaker": "方妮雅",
                                                    "text": "水下突然发生了爆炸…差点把我给震聋！这个声纹的质感，一定是你的炸弹，艾玛托！"
                                                },
                                                {
                                                    "id": "705371219",
                                                    "speaker": "艾玛托",
                                                    "text": "哈？我这不是一直乖乖站在你附近，什么都没干吗？你看我手里都没有炸弹！"
                                                },
                                                {
                                                    "id": "705371220",
                                                    "speaker": "方妮雅",
                                                    "text": "你！你肯定是想看我狼狈不堪的模样，事先设置好了定时引信，往湖里丢了几个炸弹！"
                                                },
                                                {
                                                    "id": "705371221",
                                                    "speaker": "艾玛托",
                                                    "text": "那按照你的说法，我应该准备好留影机，抓拍你现在跪在地上抱头哭哭的模样，不然我岂不是太亏了？"
                                                },
                                                {
                                                    "id": "705371222",
                                                    "speaker": "方妮雅",
                                                    "text": "你！下个月的房租，别指望我再给你打折扣了！还有之前没计较的水费，家具费，蹭饭的伙食费…都给我补上！"
                                                },
                                                {
                                                    "id": "705371223",
                                                    "speaker": "艾玛托",
                                                    "text": "别别别别别，我错了！方妮雅，我的好姐姐！就算以前的几十次恶作剧都我干的…刚才的那次也绝对不是我！"
                                                },
                                                {
                                                    "id": "705371224",
                                                    "speaker": "艾玛托",
                                                    "text": "如果我能随便就做几个…沉进水里很长时间，还超级可靠的定时引信…"
                                                },
                                                {
                                                    "id": "705371225",
                                                    "speaker": "艾玛托",
                                                    "text": "那上次咱两一起算计那帮丘丘人的时候，还需要我拼死拼活冲到伏击点旁边，手动引爆炸弹吗？"
                                                },
                                                {
                                                    "id": "705371226",
                                                    "speaker": "方妮雅",
                                                    "text": "…也对，你头脑这么简单，应该想不到用定时引信来戏弄我。"
                                                },
                                                {
                                                    "id": "705371227",
                                                    "speaker": "艾玛托",
                                                    "text": "你！"
                                                },
                                                {
                                                    "id": "705371228",
                                                    "speaker": "艾玛托",
                                                    "text": "你也骗了我！你不是说过，在你用那套侦测设备的时候，任何一点大动静都会损伤你的听力吗？"
                                                },
                                                {
                                                    "id": "705371229",
                                                    "speaker": "艾玛托",
                                                    "text": "我看你现在也没聋啊，还能这么有精神地和我吵架！"
                                                },
                                                {
                                                    "id": "705371230",
                                                    "speaker": "方妮雅",
                                                    "text": "你根本就不懂！听力的损失是慢慢积累，阶段性爆发的！你现在这么大声和我顶嘴，也是在加重我的听力损失！"
                                                },
                                                {
                                                    "id": "705371231",
                                                    "speaker": "方妮雅",
                                                    "text": "有可能在将来的某一天，我突然就分辨不出细致的声纹了，那便是我失业之日！"
                                                },
                                                {
                                                    "id": "705371232",
                                                    "speaker": "方妮雅",
                                                    "text": "到时候，你也没房子住了！因为我会把整套房子租给出价更高的人！然后去…去…去当渔民！反正不管你了！"
                                                },
                                                {
                                                    "id": "705371233",
                                                    "speaker": "艾玛托",
                                                    "text": "那，那我小声点和你吵不就成了嘛…我小声点…"
                                                },
                                                {
                                                    "id": "705371234",
                                                    "speaker": "艾玛托",
                                                    "text": "………"
                                                },
                                                {
                                                    "id": "705371235",
                                                    "speaker": "方妮雅",
                                                    "text": "………"
                                                },
                                                {
                                                    "id": "705371236",
                                                    "speaker": "派蒙",
                                                    "text": "听不太清那边在说什么…她们只顾着自己吵架去了。",
                                                    "choices": [
                                                        {
                                                            "id": "705371237",
                                                            "text": "耶！感觉超级好玩！",
                                                            "response": [
                                                                {
                                                                    "id": "705371239",
                                                                    "speaker": "派蒙",
                                                                    "text": "超级好玩！再丢一个…"
                                                                },
                                                                {
                                                                    "id": "705371240",
                                                                    "speaker": "派蒙",
                                                                    "text": "不对不对，一次就够了，多来几次，可能那边的两个人就会过来调查了。我们可不能被抓住！"
                                                                },
                                                                {
                                                                    "id": "705371241",
                                                                    "speaker": "派蒙",
                                                                    "text": "虽然感觉，我们好像闯了一个…不大不小的祸？但满足了我一直以来的好奇心，心满意足！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705371238",
                                                            "text": "也没什么问题嘛！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705371211",
                                            "text": "用力扔出炸弹！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705371204",
                            "text": "扔炸弹的感觉，你不想知道吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7053701",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705370101",
                    "speaker": "可疑的木箱",
                    "text": "以前没有见过的可疑木箱，箱子盖板的缝隙里夹着一张纸条，写着「调查小队所属设备，最高等级危险品，轻拿轻放」。"
                }
            ]
        },
        {
            "id": "7053711",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705371101",
                    "speaker": "Player",
                    "text": "姑且研究一下…"
                },
                {
                    "id": "705371102",
                    "speaker": "派蒙",
                    "text": "这个箱子上的留言…听起来很吓人！"
                },
                {
                    "id": "705371103",
                    "speaker": "派蒙",
                    "text": "明明是危险品，却被放在果酒湖边？难道是那边那两个骑士的东西？"
                },
                {
                    "id": "705371104",
                    "speaker": "派蒙",
                    "text": "木板上好像有个很宽的缝，可以看到里边装着什么！"
                },
                {
                    "id": "705371105",
                    "speaker": "派蒙",
                    "text": "让我瞧瞧看…里边好像塞着很多…圆圆的，比日落果还大不少的，红色的球…"
                },
                {
                    "id": "705371106",
                    "speaker": "派蒙",
                    "text": "等等，难道是炸弹？"
                },
                {
                    "id": "705371107",
                    "speaker": "派蒙",
                    "text": "骑士团为什么会在湖边放一箱炸弹啊？难道就是要用来炸那些…丽莎提到过的，入侵果酒湖的鱼？"
                }
            ]
        },
        {
            "id": "7053713",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705371301",
                    "speaker": "Player",
                    "text": "哇啊！好可怕！我们走！"
                },
                {
                    "id": "705371302",
                    "speaker": "派蒙",
                    "text": "对对对，一整箱炸弹，怎么想都很危险，我们快离它远点！"
                }
            ]
        },
        {
            "id": "7053714",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705371401",
                    "speaker": "Player",
                    "text": "呜哇！超可怕！我们快逃！"
                },
                {
                    "id": "705371402",
                    "speaker": "派蒙",
                    "text": "连你都觉得很危险吗！难道是箱子里透露出了一股杀气…我们快逃！"
                }
            ]
        }
    ]
}