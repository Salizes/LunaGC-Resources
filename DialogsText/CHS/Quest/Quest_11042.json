            "dialogues": []
        },
        {
            "id": "1104205",
            "objective": "前往阿贝多的营地",
            "dialogues": [
                {
                    "id": "110420501",
                    "speaker": "阿贝多",
                    "text": "这里就是我的营地，刚刚收集到的材料，我已经先一步用在药剂的调制上了。"
                },
                {
                    "id": "110420502",
                    "speaker": "阿贝多",
                    "text": "在等待调制完成的这段时间，先来这边看看吧。"
                },
                {
                    "id": "110420503",
                    "speaker": "阿贝多",
                    "text": "这位是我的助手，蒂玛乌斯，正在协助我的研究。你们应该在蒙德城里见过面。"
                },
                {
                    "id": "110420504",
                    "speaker": "蒂玛乌斯",
                    "text": "你们好，我刚刚拿到了你们的实验数据，已经整理成报告贴在板子上了。"
                },
                {
                    "id": "110420505",
                    "speaker": "派蒙",
                    "text": "哇，这个，还有这个…只是和史莱姆打了一场，就有这么多结论吗？"
                },
                {
                    "id": "110420506",
                    "speaker": "蒂玛乌斯",
                    "text": "哈哈，说不上结论，很多都是推演，以及我的大胆猜测。"
                },
                {
                    "id": "110420507",
                    "speaker": "蒂玛乌斯",
                    "text": "最合理的一种方向，我觉得是论证这位旅行者和史莱姆的亲缘关系。",
                    "choices": [
                        {
                            "id": "110420508",
                            "text": "这合理吗？",
                            "response": [
                                {
                                    "id": "110420510",
                                    "speaker": "蒂玛乌斯",
                                    "text": "你看，你没有神之眼，却可以使用元素力，史莱姆也没有神之眼，也可以使用元素力。"
                                },
                                {
                                    "id": "110420511",
                                    "speaker": "蒂玛乌斯",
                                    "text": "顺着这个思路去寻找线索，肯定能得到更多事实支撑！"
                                },
                                {
                                    "id": "110420512",
                                    "speaker": "阿贝多",
                                    "text": "这个切入点没有什么问题，但是严格来说史莱姆是属于元素生物，换句话说，元素即实体。"
                                },
                                {
                                    "id": "110420513",
                                    "speaker": "阿贝多",
                                    "text": "要类比的话，可能急冻树，或者骗骗花更加合适，但要追溯动植物之间的亲缘关系，恐怕要追溯到世界原初了。"
                                },
                                {
                                    "id": "110420514",
                                    "speaker": "阿贝多",
                                    "text": "从这个角度来看，是不是过于困难了呢？"
                                },
                                {
                                    "id": "110420515",
                                    "speaker": "蒂玛乌斯",
                                    "text": "唔，好像是这样，老师说得没错。"
                                },
                                {
                                    "id": "110420516",
                                    "speaker": "阿贝多",
                                    "text": "而且，其实数据的顶部写了，这位旅行者是来自其他世界的客人。"
                                },
                                {
                                    "id": "110420517",
                                    "speaker": "阿贝多",
                                    "text": "如果和这个世界有亲缘关系，反而是更加值得研究的内容。"
                                },
                                {
                                    "id": "110420518",
                                    "speaker": "蒂玛乌斯",
                                    "text": "啊啊，真的！抱歉，我拿到数据太激动了！下次我一定注意！"
                                },
                                {
                                    "id": "110420519",
                                    "speaker": "蒂玛乌斯",
                                    "text": "对了，想要完成研究还需要更多数据，我暂时都会在这里做分析，如果想了解实验结果，都可以来找我。"
                                },
                                {
                                    "id": "110420520",
                                    "speaker": "阿贝多",
                                    "text": "嗯，这里就交给你了。"
                                },
                                {
                                    "id": "110420521",
                                    "speaker": "阿贝多",
                                    "text": "看起来药剂已经完成了，我会先尝一尝，如果没什么问题的话，就拜托你们了。"
                                }
                            ]
                        },
                        {
                            "id": "110420509",
                            "text": "我觉得派蒙的亲缘更近一点。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104206",
            "objective": "拿取桌上的药水",
            "dialogues": [
                {
                    "id": "110420601",
                    "speaker": "阿贝多",
                    "text": "我已经尝过了，很符合我的预期。"
                },
                {
                    "id": "110420602",
                    "speaker": "阿贝多",
                    "text": "记得喝的时候不要着急，如果有不适感，记得要深呼吸。"
                },
                {
                    "id": "110420603",
                    "speaker": "阿贝多",
                    "text": "我会记录下所有观察到的结果与数据。"
                }
            ]
        },
        {
            "id": "1104216",
            "objective": "饮用药水",
            "dialogues": []
        },
        {
            "id": "1104217",
            "objective": "(test)喝药效果（测试后隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "1104207",
            "objective": "与阿贝多交谈，获取结论",
            "dialogues": [
                {
                    "id": "110420701",
                    "speaker": "派蒙",
                    "text": "#怎么样？{NICKNAME}，看你的表情有点不舒服。",
                    "choices": [
                        {
                            "id": "110420702",
                            "text": "像是…在烧。",
                            "response": [
                                {
                                    "id": "110420704",
                                    "speaker": "派蒙",
                                    "text": "你不是说你已经尝过，可以喝吗？为什么会变成这样？"
                                },
                                {
                                    "id": "110420705",
                                    "speaker": "阿贝多",
                                    "text": "嗯？这个是所有可能性中最正常的一种，是值得高兴的结果。"
                                },
                                {
                                    "id": "110420706",
                                    "speaker": "阿贝多",
                                    "text": "这种药剂，是将元素力灌入体内，正常状态下会引起一些排斥反应。"
                                },
                                {
                                    "id": "110420707",
                                    "speaker": "阿贝多",
                                    "text": "但如果内部元素流动畅通的话，只需要忍受短暂的不适，等待元素力流动完毕就好了，不会有其他影响。"
                                },
                                {
                                    "id": "110420708",
                                    "speaker": "派蒙",
                                    "text": "这么说，你明知道喝了会很难受，你还是把它喝了？"
                                },
                                {
                                    "id": "110420709",
                                    "speaker": "阿贝多",
                                    "text": "呵呵，毕竟是我配制的药剂，自然应该由我担负起试药的责任。",
                                    "choices": [
                                        {
                                            "id": "110420710",
                                            "text": "这算是…体谅研究对象吗。",
                                            "response": [
                                                {
                                                    "id": "110420711",
                                                    "speaker": "阿贝多",
                                                    "text": "那当然了，你是我的协助者，于情于理我也不能让你帮我承担风险。"
                                                },
                                                {
                                                    "id": "110420714",
                                                    "speaker": "阿贝多",
                                                    "text": "总之，我说说看结论吧。在元素力的测试上，你和这个世界上的其他人一样，没有什么特别之处。"
                                                },
                                                {
                                                    "id": "110420715",
                                                    "speaker": "派蒙",
                                                    "text": "还以为会更特别一点呢…"
                                                },
                                                {
                                                    "id": "110420716",
                                                    "speaker": "阿贝多",
                                                    "text": "我觉得比起特别，还是平凡一点好。「特别」…其实也不尽如人意。"
                                                },
                                                {
                                                    "id": "110420717",
                                                    "speaker": "Player",
                                                    "text": "感觉意有所指。"
                                                },
                                                {
                                                    "id": "110420718",
                                                    "speaker": "阿贝多",
                                                    "text": "平凡的好处，在于身边处处都是你的参照物，处处都是能够理解你的人。"
                                                },
                                                {
                                                    "id": "110420719",
                                                    "speaker": "阿贝多",
                                                    "text": "因为是一样的人，所以能够互相理解与体谅，也能互相鼓励与支持。"
                                                },
                                                {
                                                    "id": "110420720",
                                                    "speaker": "阿贝多",
                                                    "text": "生了病，因为和其他人一样，医生很容易为你诊断病情。出了问题，因为和其他人一样，可以和犯了同样错误的人请教经验。"
                                                },
                                                {
                                                    "id": "110420721",
                                                    "speaker": "阿贝多",
                                                    "text": "但「特别」之人，是无法享受到这些理所当然的，因为在生命的本质上就有差距。"
                                                },
                                                {
                                                    "id": "110420722",
                                                    "speaker": "阿贝多",
                                                    "text": "就比如…人类也无法理解爆炎树或者狂风之核的生活吧。不知道我这样说，你能听明白吗？",
                                                    "choices": [
                                                        {
                                                            "id": "110420723",
                                                            "text": "大致能够理解。",
                                                            "response": [
                                                                {
                                                                    "id": "110420725",
                                                                    "speaker": "阿贝多",
                                                                    "text": "总之，实验结果是件好事。至少在未来，你可以放心地使用你的元素力了。"
                                                                },
                                                                {
                                                                    "id": "110420726",
                                                                    "speaker": "阿贝多",
                                                                    "text": "蒂玛乌斯，新的实验结果已经出来了，麻烦你继续整理一下。"
                                                                },
                                                                {
                                                                    "id": "110420727",
                                                                    "speaker": "蒂玛乌斯",
                                                                    "text": "来了，来了！交给我吧，老师！"
                                                                },
                                                                {
                                                                    "id": "110420728",
                                                                    "speaker": "蒂玛乌斯",
                                                                    "text": "在刚刚被老师点拨了一番之后，我觉得我的思维受到了局限，现在我想得清楚多了。"
                                                                },
                                                                {
                                                                    "id": "110420729",
                                                                    "speaker": "蒂玛乌斯",
                                                                    "text": "可能把你定位成「动物」有点不严谨，但假如从论证你是「元素生物」的角度入手的话…"
                                                                },
                                                                {
                                                                    "id": "110420730",
                                                                    "speaker": "阿贝多",
                                                                    "text": "也好，我认为是个有趣的方向，具体情况如何，比起我来判断，还是由你自己来研究吧。"
                                                                },
                                                                {
                                                                    "id": "110420731",
                                                                    "speaker": "蒂玛乌斯",
                                                                    "text": "嗯，放心，我会拿出让你们都满意的结论！"
                                                                },
                                                                {
                                                                    "id": "110420732",
                                                                    "speaker": "派蒙",
                                                                    "text": "他似乎没有沮丧，斗志反而更高了。"
                                                                },
                                                                {
                                                                    "id": "110420733",
                                                                    "speaker": "派蒙",
                                                                    "text": "该说是他态度认真呢，还是阿贝多很会说话呢…"
                                                                },
                                                                {
                                                                    "id": "110420734",
                                                                    "speaker": "阿贝多",
                                                                    "text": "那么，在进行接下来的研究之前，我需要准备一个小东西，稍等我一下。"
                                                                },
                                                                {
                                                                    "id": "110420735",
                                                                    "speaker": "阿贝多",
                                                                    "text": "如果有兴趣的话，你们可以先参观一下这里，就当是打发时间了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110420724",
                                                            "text": "还是感觉…意有所指。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110420712",
                                            "text": "不怕自己有危险吗？",
                                            "response": [
                                                {
                                                    "id": "110420713",
                                                    "speaker": "阿贝多",
                                                    "text": "这或许就是学者的自信吧，节省了很多不必要的麻烦。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110420703",
                            "text": "你居然喝得下去。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104206",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "110420611",
                    "speaker": "阿贝多",
                    "text": "嗯…和预期相同，可以饮用。"
                },
                {
                    "id": "110420612",
                    "speaker": "阿贝多",
                    "text": "记得喝的时候不要着急，如果有不适感，记得要深呼吸。"
                }
            ]
        }
    ]
}