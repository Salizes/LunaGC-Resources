        {
            "id": "1104208",
            "objective": "(test)沿路寻找「星银矿触媒」$HIDDEN",
            "dialogues": [
                {
                    "id": "110420801",
                    "speaker": "蒂玛乌斯",
                    "text": "从异世界到来的元素生物，一旦发现了有力的依据，恐怕会推翻很多现在的炼金术理论！"
                },
                {
                    "id": "110420802",
                    "speaker": "蒂玛乌斯",
                    "text": "这样的话，老师的研究应该也可以更进一步了！"
                }
            ]
        },
        {
            "id": "1104209",
            "objective": "(test)沿路寻找「星银矿触媒」$HIDDEN",
            "dialogues": [
                {
                    "id": "110420901",
                    "speaker": "蒂玛乌斯",
                    "text": "看来是不太严谨，我要想想有没有其他思路…"
                }
            ]
        },
        {
