    "talks": [
        {
            "id": "1104201",
            "objective": "前往研究场所",
            "dialogues": [
                {
                    "id": "110420101",
                    "speaker": "派蒙",
                    "text": "说起来，我有一个疑问，那个种子发芽以后会长出什么东西吗？"
                },
                {
                    "id": "110420102",
                    "speaker": "阿贝多",
                    "text": "不知道，但我觉得重点不在结果，而是过程。"
                },
                {
                    "id": "110420103",
                    "speaker": "阿贝多",
                    "text": "能够使用炼金术，在提瓦特唤醒不属于此世的生命的话，我对生命本质的理解，应该就能更进一步。"
                },
                {
                    "id": "110420104",
                    "speaker": "阿贝多",
                    "text": "唤醒之后，就算是创造，也并非不可能的事了。"
                },
                {
                    "id": "110420105",
                    "speaker": "派蒙",
                    "text": "唔唔…"
                },
                {
                    "id": "110420106",
                    "speaker": "阿贝多",
                    "text": "哈哈，对你来说还是太难懂了吗？"
                },
                {
                    "id": "110420107",
                    "speaker": "派蒙",
                    "text": "不不不，我完全听懂了，我只是更关心这个种子发芽之后会长出什么！",
                    "choices": [
                        {
                            "id": "110420108",
                            "text": "完全没懂嘛。",
                            "response": [
                                {
                                    "id": "110420110",
                                    "speaker": "阿贝多",
                                    "text": "如果长出了非常美味的果实，我们就一起分享吧。"
                                },
                                {
                                    "id": "110420111",
                                    "speaker": "派蒙",
                                    "text": "好耶！说话要算话哦！",
                                    "choices": [
                                        {
                                            "id": "110420112",
                                            "text": "居然轻松说服了派蒙。",
                                            "response": [
                                                {
                                                    "id": "110420114",
                                                    "speaker": "阿贝多",
                                                    "text": "这是因为我…有时要帮忙照顾某个孩子。这要解释起来比较复杂，就当是我在炼金术之外的小技能吧。"
                                                },
                                                {
                                                    "id": "110420115",
                                                    "speaker": "阿贝多",
                                                    "text": "说回第一项研究，是关于元素力的。这个世界的人想要使用元素力，就必须拥有神之眼，但我没看到你身上有类似的东西。"
                                                },
                                                {
                                                    "id": "110420116",
                                                    "speaker": "阿贝多",
                                                    "text": "为什么你可以自如地使用元素力，我想确认一下，所以想先问你几个问题。"
                                                },
                                                {
                                                    "id": "110420117",
                                                    "speaker": "阿贝多",
                                                    "text": "首先，你有别人没有的器官吗？比如，第二个心脏，第四个胃之类的。",
                                                    "choices": [
                                                        {
                                                            "id": "110420118",
                                                            "text": "没有。",
                                                            "response": [
                                                                {
                                                                    "id": "110420120",
                                                                    "speaker": "阿贝多",
                                                                    "text": "原来如此，那么，飞在你身边的小家伙，和你的身体是连接起来的吗？"
                                                                },
                                                                {
                                                                    "id": "110420121",
                                                                    "speaker": "派蒙",
                                                                    "text": "这个问题好奇怪！从外表来看就能排除这种可能性吧。"
                                                                },
                                                                {
                                                                    "id": "110420122",
                                                                    "speaker": "派蒙",
                                                                    "text": "还有，不是「小家伙」，是派蒙！"
                                                                },
                                                                {
                                                                    "id": "110420123",
                                                                    "speaker": "阿贝多",
                                                                    "text": "我只是在考虑你作为「外置器官」的可能性，或许连接你们的是一种不可见的方式。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110420124",
                                                                            "text": "我们是在旅行中认识的。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110420126",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "哦，那就可以排除这种可能性了。那么，会不会是派蒙将元素力导向了你？"
                                                                                },
                                                                                {
                                                                                    "id": "110420127",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "但前提是派蒙的元素力可以击穿十米厚的山岩，又或者是让清泉镇南边的瀑布逆流而上。"
                                                                                },
                                                                                {
                                                                                    "id": "110420128",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "唔，果然不可能啊…"
                                                                                },
                                                                                {
                                                                                    "id": "110420129",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我还什么都没说呢！"
                                                                                },
                                                                                {
                                                                                    "id": "110420130",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "这么说来，看来你的身体构造和这个世界的人类，并没有明显的区别。"
                                                                                },
                                                                                {
                                                                                    "id": "110420131",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "那只能用实验的方法，研究可能存在的差异点了。"
                                                                                },
                                                                                {
                                                                                    "id": "110420132",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "首先，先看看这不明来源的元素力，究竟是如何对外流动的。"
                                                                                },
                                                                                {
                                                                                    "id": "110420133",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "接下来我会吸引一些史莱姆过来，请用你最熟悉的方式击败它们吧。"
                                                                                },
                                                                                {
                                                                                    "id": "110420134",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "原来是用这么简单的方式来观察吗…"
                                                                                },
                                                                                {
                                                                                    "id": "110420135",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "好的实验应该是直观而清晰的，而且这只是简单的小研究。"
                                                                                },
                                                                                {
                                                                                    "id": "110420136",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "当然，如果你们觉得缺乏挑战性的话，我们也可以去尝试同时挑战六个纯水精灵。"
                                                                                },
                                                                                {
                                                                                    "id": "110420137",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "史莱姆！史莱姆就可以了！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "110420138",
                                                                                            "text": "不太明白，但好像很麻烦。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "110420140",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "那么，准备一下吧，史莱姆要来了。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "110420139",
                                                                                            "text": "我不想被幻形兽撞来撞去。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110420125",
                                                                            "text": "她是我从水里钓上来的。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110420119",
                                                            "text": "据我所知是没有的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110420113",
                                            "text": "居然看穿了派蒙的想法。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110420109",
                            "text": "我也想知道。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104202",
            "objective": "击败史莱姆，完成实验",
            "dialogues": []
        },
        {
            "id": "1104203",
            "objective": "与阿贝多交谈，获取结论",
            "dialogues": [
                {
                    "id": "110420301",
                    "speaker": "阿贝多",
                    "text": "辛苦了，你应该没有感觉到什么异常吧？"
                },
                {
                    "id": "110420302",
                    "speaker": "阿贝多",
                    "text": "如果受伤了的话，我这里有些应急用的药剂。",
                    "choices": [
                        {
                            "id": "110420303",
                            "text": "不用担心。",
                            "response": [
                                {
                                    "id": "110420305",
                                    "speaker": "阿贝多",
                                    "text": "那就好，根据我的观察，元素力对外流动顺畅，元素反应合理，没有观察到特别的状况。"
                                },
                                {
                                    "id": "110420306",
                                    "speaker": "阿贝多",
                                    "text": "确定「对外流动」没问题之后，我们再来测试一下「内部流动」吧。"
                                },
                                {
                                    "id": "110420307",
                                    "speaker": "派蒙",
                                    "text": "「内部流动」…要怎么做？"
                                },
                                {
                                    "id": "110420308",
                                    "speaker": "阿贝多",
                                    "text": "很简单，我可以用炼金术制作一种萃取了元素力的药剂。"
                                },
                                {
                                    "id": "110420309",
                                    "speaker": "阿贝多",
                                    "text": "如果元素力是以生理的方式储存或堆积在你的体内，或许会和这种药剂产生元素反应。",
                                    "choices": [
                                        {
                                            "id": "110420310",
                                            "text": "会在肚子里扩散？",
                                            "response": [
                                                {
                                                    "id": "110420312",
                                                    "speaker": "派蒙",
                                                    "text": "听、听起来好可怕！"
                                                },
                                                {
                                                    "id": "110420313",
                                                    "speaker": "阿贝多",
                                                    "text": "没事的，如果一切正常的话，只会引发短暂的不适，但对身体没有害处。"
                                                },
                                                {
                                                    "id": "110420314",
                                                    "speaker": "派蒙",
                                                    "text": "要是不正常呢？"
                                                },
                                                {
                                                    "id": "110420315",
                                                    "speaker": "阿贝多",
                                                    "text": "万一有意外发生，我也有充足的准备，不用太担心。"
                                                },
                                                {
                                                    "id": "110420316",
                                                    "speaker": "Player",
                                                    "text": "还是很担心…"
                                                },
                                                {
                                                    "id": "110420317",
                                                    "speaker": "阿贝多",
                                                    "text": "嗯，并非完全没有风险。但如果你体内的元素流动确实存在障碍的话，也能借此检查出来。"
                                                },
                                                {
                                                    "id": "110420318",
                                                    "speaker": "阿贝多",
                                                    "text": "这也是一种对健康的预警，如果内部的元素反应由其他意外引起，那才会引发真正的危险。"
                                                },
                                                {
                                                    "id": "110420319",
                                                    "speaker": "Player",
                                                    "text": "像体检一样…"
                                                },
                                                {
                                                    "id": "110420320",
                                                    "speaker": "阿贝多",
                                                    "text": "对，我觉得可以这么理解。不过在实验之前，检测用的药剂还差了一种触媒，我们需要找一找。"
                                                },
                                                {
                                                    "id": "110420321",
                                                    "speaker": "阿贝多",
                                                    "text": "是一种名叫「星银矿」的矿石，不过不是所有这种矿石都适合做触媒。"
                                                },
                                                {
                                                    "id": "110420322",
                                                    "speaker": "阿贝多",
                                                    "text": "我现在带你去我的营地，沿路收集一些「星银矿」吧。如果有适合做触媒的，我会告诉你。"
                                                },
                                                {
                                                    "id": "110420323",
                                                    "speaker": "阿贝多",
                                                    "text": "如果顺利的话，等我们抵达营地，就可以直接进行药物的调制了。"
                                                },
                                                {
                                                    "id": "110420324",
                                                    "speaker": "派蒙",
                                                    "text": "听起来虽然不太安全，但似乎是有好处的事。"
                                                },
                                                {
                                                    "id": "110420325",
                                                    "speaker": "派蒙",
                                                    "text": "我们在路上的时候留意一下吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110420311",
                                            "text": "会在肚子里结晶？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110420304",
                            "text": "只是有点冷。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1104204",
            "objective": "(test)沿路寻找「星银矿触媒」$HIDDEN",
