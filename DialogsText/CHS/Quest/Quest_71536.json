    "talks": [
        {
            "id": "7153601",
            "objective": "等待至次日的8时至18时",
            "dialogues": [
                {
                    "id": "715360101",
                    "speaker": "坎蒂丝",
                    "text": "#{NICKNAME}？海灯节快乐，你帮迪希雅做「祝柬」的事，我已经听说了，很漂亮，谢谢你。"
                },
                {
                    "id": "715360102",
                    "speaker": "Player",
                    "text": "村里的事已经安排妥当了？"
                },
                {
                    "id": "715360103",
                    "speaker": "坎蒂丝",
                    "text": "多亏了迪希雅她们帮忙，村里现在有人守着，我也能安心一些。"
                },
                {
                    "id": "715360104",
                    "speaker": "Player",
                    "text": "这段时间就好好休息吧。"
                },
                {
                    "id": "715360105",
                    "speaker": "坎蒂丝",
                    "text": "嗯，我会的。迪希雅还说，过几天想去「翘英庄」看看。"
                },
                {
                    "id": "715360106",
                    "speaker": "坎蒂丝",
                    "text": "她说那边景色非常不错，还产出好茶，正好买一些带回去给村里的人。"
                },
                {
                    "id": "715360107",
                    "speaker": "坎蒂丝",
                    "text": "我本来也想按照璃月的传统，做几张「祝柬」，附在礼物里送出去。"
                },
                {
                    "id": "715360108",
                    "speaker": "坎蒂丝",
                    "text": "可是迪希雅的日程安排太满，我们俩到处跑，根本没什么空写「祝柬」…"
                },
                {
                    "id": "715360109",
                    "speaker": "坎蒂丝",
                    "text": "我听迪希雅说，你很擅长做「祝柬」，能教我做一封么？"
                },
                {
                    "id": "715360110",
                    "speaker": "Player",
                    "text": "好呀，交给我吧。"
                }
            ]
        },
        {
            "id": "7153602",
            "objective": "与坎蒂丝对话",
            "dialogues": []
        },
        {
            "id": "7153603",
            "objective": "和坎蒂丝一同完成祝柬",
            "dialogues": [
                {
                    "id": "715360301",
                    "speaker": "坎蒂丝",
                    "text": "#原来是这样…这份「祝柬」真好看，谢谢你，{NICKNAME}。"
                },
                {
                    "id": "715360302",
                    "speaker": "坎蒂丝",
                    "text": "我等会照着你教我的做法再做几份，随着礼物一起送给村里人，他们一定会很高兴的。"
                },
                {
                    "id": "715360303",
                    "speaker": "坎蒂丝",
                    "text": "至于你做的这一封，我会好好珍藏的。"
                }
            ]
        },
        {
