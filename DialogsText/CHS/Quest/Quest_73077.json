    "talks": [
        {
            "id": "7307701",
            "objective": "隐藏任务上线就完成$HIDDEN",
            "dialogues": [
                {
                    "id": "730770101",
                    "speaker": "？？？",
                    "text": "啊呀，石头锁！石头锁不见了！"
                },
                {
                    "id": "730770102",
                    "speaker": "？？？",
                    "text": "到底是谁呀，是谁破坏了石头锁呀…难道是「大大铁块」…"
                },
                {
                    "id": "730770103",
                    "speaker": "派蒙",
                    "text": "是兰那罗…"
                },
                {
                    "id": "730770104",
                    "speaker": "？？？",
                    "text": "啊呀，能看见兰提沙，是金色的那菈和银色的鸟。"
                },
                {
                    "id": "730770105",
                    "speaker": "派蒙",
                    "text": "#我才不是什么银色的鸟呢！我是派蒙…金色的是{NICKNAME}。"
                },
                {
                    "id": "730770106",
                    "speaker": "兰提沙",
                    "text": "#是那菈{NICKNAME}和派蒙，兰提沙记住了，兰提沙的名字是兰提沙…"
                },
                {
                    "id": "730770107",
                    "speaker": "兰提沙",
                    "text": "欸嘿嘿，是跟故事里那菈法留纳一样的金色的那菈，金色那菈，有着阳光晒过的树叶那样温暖的味道…"
                },
                {
                    "id": "730770108",
                    "speaker": "兰提沙",
                    "text": "#啊呀，现在不是交朋友时间，石头锁！石头锁，那菈{NICKNAME}和派蒙在这儿…有没有看到破坏石头锁的坏家伙！"
                },
                {
                    "id": "730770109",
                    "speaker": "派蒙",
                    "text": "石头锁，应该说的就是刚才我们打开的…"
                },
                {
                    "id": "730770110",
                    "speaker": "Player",
                    "text": "确实是我们破坏的…"
                },
                {
                    "id": "730770111",
                    "speaker": "兰提沙",
                    "text": "#什么呀，原来破坏石头锁的是那菈{NICKNAME}…兰提沙还以为是「大大铁块」自己跑出来了呢…啊！"
                },
                {
                    "id": "730770112",
                    "speaker": "兰提沙",
                    "text": "石头锁没了！「大大铁块」要跑出来了！"
                },
                {
                    "id": "730770113",
                    "speaker": "兰提沙",
                    "text": "#那菈{NICKNAME}和派蒙，你们快躲起来，「大大铁块」，又大又坚硬，有的眼睛还会冒火，危险危险！"
                },
                {
                    "id": "730770114",
                    "speaker": "派蒙",
                    "text": "兰提沙你说的是被困在里面的怪物吗，已经被我们消灭啦…"
                },
                {
                    "id": "730770115",
                    "speaker": "兰提沙",
                    "text": "什么呀，原来「大大铁块」们被消灭了…欸嘿嘿，好呀好呀，想到「大大铁块」跑出来，兰提沙差点吓得叶子快要掉了…"
                },
                {
                    "id": "730770116",
                    "speaker": "兰提沙",
                    "text": "#咦！是那菈{NICKNAME}和派蒙把这里的「大大铁块」们解决掉的吗！"
                },
                {
                    "id": "730770117",
                    "speaker": "派蒙",
                    "text": "我们已经解决掉过很多这样的怪物啦！",
                    "choices": [
                        {
                            "id": "730770118",
                            "text": "已经是熟练工了…",
                            "response": [
                                {
                                    "id": "730770121",
                                    "speaker": "兰提沙",
                                    "text": "#没想到那菈{NICKNAME}居然有这样的力量…欸嘿嘿，兰提沙有件事想拜托那菈{NICKNAME}帮忙…"
                                },
                                {
                                    "id": "730770122",
                                    "speaker": "派蒙",
                                    "text": "什么事呀，不会是，和这些石头锁有关…"
                                },
                                {
                                    "id": "730770123",
                                    "speaker": "兰提沙",
                                    "text": "派蒙，好聪明！兰提沙有点惊讶…"
                                },
                                {
                                    "id": "730770124",
                                    "speaker": "派蒙",
                                    "text": "你惊讶什么呀！"
                                },
                                {
                                    "id": "730770125",
                                    "speaker": "兰提沙",
                                    "text": "欸嘿嘿，确实和石头锁有关…"
                                },
                                {
                                    "id": "730770126",
                                    "speaker": "兰提沙",
                                    "text": "#石头锁，在森林里，有十六个石头锁，里面有「大大铁块」，{NICKNAME}能帮忙打倒那些「大大铁块」吗…",
                                    "choices": [
                                        {
                                            "id": "730770127",
                                            "text": "当然可以…",
                                            "response": [
                                                {
                                                    "id": "730770129",
                                                    "speaker": "兰提沙",
                                                    "text": "#呜呜，那菈{NICKNAME}真是好那菈，兰提沙，在这里由衷感谢那菈{NICKNAME}…"
                                                },
                                                {
                                                    "id": "730770130",
                                                    "speaker": "兰提沙",
                                                    "text": "如果所有石头锁里的「大大铁块」都被打倒了，就来找我吧。"
                                                },
                                                {
                                                    "id": "730770131",
                                                    "speaker": "兰提沙",
                                                    "text": "你们要是能打倒所有「大大铁块」的话，一定也可以…"
                                                },
                                                {
                                                    "id": "730770132",
                                                    "speaker": "派蒙",
                                                    "text": "？"
                                                },
                                                {
                                                    "id": "730770133",
                                                    "speaker": "兰提沙",
                                                    "text": "#欸嘿嘿，不过等那菈{NICKNAME}来了，到时候兰提沙再和你们说吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "730770128",
                                            "text": "如果看到的话…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "730770119",
                            "text": "派蒙最好有出手过哦…",
                            "response": [
                                {
                                    "id": "730770120",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，我有好好躲起来，不让你担心嘛！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7307704",
            "objective": "凋零之森机兵1完成$HIDDEN",
            "dialogues": [
                {
                    "id": "730770401",
                    "speaker": "兰提沙",
                    "text": "#那菈{NICKNAME}，很厉害，有你在，我们一定能够打倒「大方方铁块」的！"
                }
            ]
        },
        {
            "id": "7307705",
            "objective": "凋零之森机兵2完成$HIDDEN",
            "dialogues": [
                {
                    "id": "730770501",
                    "speaker": "兰耶多",
                    "text": "能不能打倒「大方方铁块」呢…这可是故事里出现的可怕怪物，有些紧张…"
                }
            ]
        },
        {
            "id": "7307706",
            "objective": "凋零之森机兵3完成$HIDDEN",
            "dialogues": [
                {
                    "id": "730770601",
                    "speaker": "兰沙陀",
                    "text": "故事里，「大方方铁块」变化多端，还会如蘑菇一般，分裂成好几个「大大铁块」…"
                },
                {
                    "id": "730770602",
                    "speaker": "兰沙陀",
                    "text": "#但只要打倒其中关键的一只，就能让「大方方铁块」露出破绽。要小心观察，那菈{NICKNAME}。"
                }
            ]
        },
        {
            "id": "7307707",
            "objective": "凋零之森机兵4完成$HIDDEN",
            "dialogues": [
                {
                    "id": "730770701",
                    "speaker": "兰沙诃",
                    "text": "…很少和那菈说话。"
                },
                {
                    "id": "730770702",
                    "speaker": "兰沙诃",
                    "text": "…谢谢你，好那菈。"
                }
            ]
        },
        {
            "id": "7307708",
            "objective": "织梦之森机兵5完成$HIDDEN",
            "dialogues": [
                {
                    "id": "730770801",
                    "speaker": "兰提沙",
                    "text": "…啊呀，没想到，就算使用「兰迦拉梨」，「大方方铁块」还有那么强的力量。"
                },
                {
                    "id": "730770802",
                    "speaker": "兰提沙",
                    "text": "就算我们的兰迦拉梨能够打倒「大大铁块」，但肯定打不倒「大方方铁块」…"
                },
                {
                    "id": "730770803",
                    "speaker": "兰提沙",
                    "text": "#如果不是那菈{NICKNAME}在场…"
                },
                {
                    "id": "730770804",
                    "speaker": "派蒙",
                    "text": "没有关系啦，反正现在恒常机关阵列…不对，反正「大方方铁块」已经被打倒了，现在已经不会再有铁怪物来破坏森林了！"
                },
                {
                    "id": "730770805",
                    "speaker": "Player",
                    "text": "嗯，你们可以放心了…"
                },
                {
                    "id": "730770806",
                    "speaker": "兰沙诃",
                    "text": "…不行。"
                },
                {
                    "id": "730770807",
                    "speaker": "兰沙诃",
                    "text": "…得靠自己。"
                },
                {
                    "id": "730770808",
                    "speaker": "兰沙陀",
                    "text": "#兰沙诃说得对，看到那菈{NICKNAME}和「大方方铁块」对战，如同幼鸟见识到峰巅之高，砾石触及大地之广。"
                },
                {
                    "id": "730770809",
                    "speaker": "兰耶多",
                    "text": "我们离了不起的兰帝裟，还有很远的距离…"
                },
                {
                    "id": "730770810",
                    "speaker": "兰耶多",
                    "text": "一定要更加努力的修炼，下一次森林陷入危机时，才能成为兰帝裟那样的英雄！"
                },
                {
                    "id": "730770811",
                    "speaker": "兰提沙",
                    "text": "我们要在梦境里，和想象出来的「大方方铁块」进行战斗！"
                },
                {
                    "id": "730770812",
                    "speaker": "派蒙",
                    "text": "加油啊！"
                },
                {
                    "id": "730770813",
                    "speaker": "Player",
                    "text": "你们一定能成功的。"
                },
                {
                    "id": "730770814",
                    "speaker": "兰提沙",
                    "text": "#那菈{NICKNAME}，如果你想来的话，就跟进入桓那兰那时一样，在这里吹响「大梦的曲调」吧…"
                },
                {
                    "id": "730770815",
                    "speaker": "兰提沙",
                    "text": "那样就能进入我们的梦，与我们共享一个有「大方方铁块」的梦境了…"
                },
                {
                    "id": "730770816",
                    "speaker": "派蒙",
                    "text": "呜哇，听上去不像是个好梦…",
                    "choices": [
                        {
                            "id": "730770817",
                            "text": "派蒙会做战斗的梦吗…",
                            "response": [
                                {
                                    "id": "730770818",
                                    "speaker": "派蒙",
                                    "text": "我才不要做呢，我要做有很多好吃的食物的那种梦。"
                                },
                                {
                                    "id": "730770821",
                                    "speaker": "兰提沙",
                                    "text": "那兰提沙和兰沙陀，兰耶多，兰沙诃，就先去梦境中修炼了！"
                                },
                                {
                                    "id": "730770822",
                                    "speaker": "兰沙陀",
                                    "text": "#嗯，那菈{NICKNAME}，为表感谢，我将用清晨时的第一缕阳光铭记你。"
                                },
                                {
                                    "id": "730770823",
                                    "speaker": "兰耶多",
                                    "text": "#那菈{NICKNAME}，就跟那菈法留纳一样了不起！"
                                },
                                {
                                    "id": "730770824",
                                    "speaker": "兰沙诃",
                                    "text": "…不会忘记你。"
                                },
                                {
                                    "id": "730770825",
                                    "speaker": "兰提沙",
                                    "text": "啊呀，如果可以的话，在梦中再次相遇吧！"
                                }
                            ]
                        },
                        {
                            "id": "730770819",
                            "text": "梦里不会有真的危险…",
                            "response": [
                                {
                                    "id": "730770820",
                                    "speaker": "派蒙",
                                    "text": "是呢，毕竟是他们自己的梦…他们想象的恒常机关阵列也不会跑出来，就算在梦里打不过也不会受伤…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
