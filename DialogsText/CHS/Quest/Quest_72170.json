    "talks": [
        {
            "id": "7217005",
            "objective": "（test）检测水面是否下降$HIDDEN",
            "dialogues": [
                {
                    "id": "721700501",
                    "speaker": "旭东",
                    "text": "这里的海草还不错…"
                },
                {
                    "id": "721700502",
                    "speaker": "芭尔瓦涅",
                    "text": "呃…这手感，与其说是「采」，不如说是「拔」…"
                },
                {
                    "id": "721700503",
                    "speaker": "朱莉",
                    "text": "用小刀的话，一下子就能采走海草啦。"
                }
            ]
        },
        {
            "id": "7217001",
            "objective": "（test）领任务$HIDDEN",
            "dialogues": [
                {
                    "id": "721700101",
                    "speaker": "旭东",
                    "text": "这可下不去啊…"
                },
                {
                    "id": "721700102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "721700103",
                    "speaker": "旭东",
                    "text": "旅行者，又见面了。我们正在想怎么…潜进前面的水里…"
                },
                {
                    "id": "721700104",
                    "speaker": "旭东",
                    "text": "然后，去里面取一点新鲜的海草来，做一种叫做「饭团」的食物。",
                    "choices": [
                        {
                            "id": "721700105",
                            "text": "在海边取就好了。",
                            "response": [
                                {
                                    "id": "721700106",
                                    "speaker": "旭东",
                                    "text": "那种在海边的海草都不太新鲜，用来做菜总感觉少点味道啊。"
                                },
                                {
                                    "id": "721700109",
                                    "speaker": "旭东",
                                    "text": "我向城里的人打听过了，这里底下生长着一些品质很不错的海草。"
                                },
                                {
                                    "id": "721700110",
                                    "speaker": "旭东",
                                    "text": "不过今天一来…就看见这里完全被海水淹没了。"
                                },
                                {
                                    "id": "721700111",
                                    "speaker": "旭东",
                                    "text": "而且我们三个都…完全不会潜水，只能在这里傻傻看着…"
                                },
                                {
                                    "id": "721700112",
                                    "speaker": "Player",
                                    "text": "周围有什么机关吗？"
                                },
                                {
                                    "id": "721700113",
                                    "speaker": "朱莉",
                                    "text": "那边有一个机关喔！不过…"
                                },
                                {
                                    "id": "721700114",
                                    "speaker": "旭东",
                                    "text": "不过那个机关，又被罩在那种屏障里面了，根本进不去啊。"
                                },
                                {
                                    "id": "721700115",
                                    "speaker": "旭东",
                                    "text": "唉，我们继续在这里琢磨一下吧。"
                                },
                                {
                                    "id": "721700116",
                                    "speaker": "旭东",
                                    "text": "旅行者，要是你知道怎么解决这个问题，就请快点过来告诉我们吧。"
                                },
                                {
                                    "id": "721700117",
                                    "speaker": "旭东",
                                    "text": "当然啦，如果你能直接把那些海草拿过来的话就更好…"
                                },
                                {
                                    "id": "721700118",
                                    "speaker": "芭尔瓦涅",
                                    "text": "旭东先生？"
                                },
                                {
                                    "id": "721700119",
                                    "speaker": "旭东",
                                    "text": "咳！要是你能直接把那些海草拿来的话，那报酬肯定少不了你的，还有一顿饭团大餐奉上！"
                                },
                                {
                                    "id": "721700120",
                                    "speaker": "芭尔瓦涅",
                                    "text": "饭团到底怎么能称得上是「大餐」…"
                                },
                                {
                                    "id": "721700121",
                                    "speaker": "旭东",
                                    "text": "哎呀，只要数量够多就行了…咳，我们还是接着琢磨吧…"
                                }
                            ]
                        },
                        {
                            "id": "721700107",
                            "text": "一定要潜进去吗？",
                            "response": [
                                {
                                    "id": "721700108",
                                    "speaker": "旭东",
                                    "text": "那种在海边就能采到的海草都不太新鲜，用来做菜总感觉少点味道。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7217002",
            "objective": "摘取「新鲜的海草」",
            "dialogues": [
                {
                    "id": "721700201",
                    "speaker": "旭东",
                    "text": "旅行者，你采到海草了吗？"
                },
                {
                    "id": "721700202",
                    "speaker": "旭东",
                    "text": "喔！就是这个，谢谢你帮忙啦，旅行者。"
                },
                {
                    "id": "721700203",
                    "speaker": "旭东",
                    "text": "我这就开始做那种叫做…「饭团」的食物，听说做起来还挺简单的…"
                },
                {
                    "id": "721700204",
                    "speaker": "旭东",
                    "text": "噢，我处理食材需要一点时间，你先去旁边稍等一下吧。"
                }
            ]
        },
        {
            "id": "7217003",
            "objective": "将「新鲜的海草」带给旭东",
            "dialogues": []
        },
        {
            "id": "7217004",
            "objective": "与旭东对话",
            "dialogues": [
                {
                    "id": "721700301",
                    "speaker": "旭东",
                    "text": "海草…鱼肉…还有稻米…"
                },
                {
                    "id": "721700302",
                    "speaker": "旭东",
                    "text": "应该是这样做吧…"
                },
                {
                    "id": "721700303",
                    "speaker": "旭东",
                    "text": "这样就做好了！这就是「饭团」了。"
                },
                {
                    "id": "721700304",
                    "speaker": "芭尔瓦涅",
                    "text": "这还真是…朴实无华…我要这个好了，感觉我应该吃不完…"
                },
                {
                    "id": "721700305",
                    "speaker": "朱莉",
                    "text": "只要味道好就行啦，我要这个！"
                },
                {
                    "id": "721700306",
                    "speaker": "旭东",
                    "text": "这是你的，旅行者。还有这份「饭团」的制作方法，我也抄了一份给你。"
                },
                {
                    "id": "721700307",
                    "speaker": "旭东",
                    "text": "虽然「饭团」的做法看起来很简单，但想要做得好吃，还是需要一点技巧的。"
                },
                {
                    "id": "721700308",
                    "speaker": "旭东",
                    "text": "咳…好了，闲话就先不说了，忙活这么久，我也要去吃一点了。"
                },
                {
                    "id": "721700309",
                    "speaker": "旭东",
                    "text": "喂！芭尔瓦涅，你不是说你吃不完吗？给我留一点！"
                }
            ]
        },
        {
            "id": "7217004",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721700401",
                    "speaker": "旭东",
                    "text": "难道，真要找个方法潜水进去了？"
                },
                {
                    "id": "721700402",
                    "speaker": "芭尔瓦涅",
                    "text": "我们就不能换个地方采海草吗？为什么一定要在这里…"
                },
                {
                    "id": "721700403",
                    "speaker": "朱莉",
                    "text": "为什么机关又被罩在屏障里了呢…"
                }
            ]
        },
        {
            "id": "7217006",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721700601",
                    "speaker": "朱莉",
                    "text": "唔，这底下不会又有什么遗迹之类的吧？"
                },
                {
                    "id": "721700602",
                    "speaker": "芭尔瓦涅",
                    "text": "遗、遗迹？呃…如果真有的话就好了…"
                }
            ]
        },
        {
            "id": "7217007",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "721700701",
                    "speaker": "旭东",
                    "text": "那下面，好像被水淹过啊…"
                },
                {
                    "id": "721700702",
                    "speaker": "朱莉",
                    "text": "嗯，水痕都很明显喔，下面确实在不久前被水淹没过呢。"
                },
                {
                    "id": "721700703",
                    "speaker": "朱莉",
                    "text": "但是，为什么那些水突然全部都退了呢…"
                },
                {
                    "id": "721700704",
                    "speaker": "芭尔瓦涅",
                    "text": "呃…这周围都湿漉漉的，鞋子都要湿了…"
                },
                {
                    "id": "721700705",
                    "speaker": "旭东",
                    "text": "算了，别管这些了，还是快点再采些海草吧。"
                },
                {
                    "id": "721700706",
                    "speaker": "Player",
                    "text": "你们在这做什么？"
                },
                {
                    "id": "721700707",
                    "speaker": "旭东",
                    "text": "咦？居然在这里都能遇见你，我们还真是有缘分啊，旅行者。"
                },
                {
                    "id": "721700708",
                    "speaker": "旭东",
                    "text": "我们刚去下面采集了一些新鲜的海草上来，准备做一种叫做「饭团」的食物呢，下面的路可真难走，我的鞋子都湿透了…"
                },
                {
                    "id": "721700709",
                    "speaker": "旭东",
                    "text": "先不说这些了，旅行者，你能帮我们再去下面采一些海草吗？"
                },
                {
                    "id": "721700710",
                    "speaker": "旭东",
                    "text": "下面似乎曾经被水淹过，虽然现在水退了，但也许…不知道什么时候，水会再次把下面淹没。"
                },
                {
                    "id": "721700711",
                    "speaker": "旭东",
                    "text": "我觉得，还是要快点再去采一些海草上来才好。",
                    "choices": [
                        {
                            "id": "721700712",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "721700713",
                                    "speaker": "旭东",
                                    "text": "那就拜托你了旅行者。"
                                },
                                {
                                    "id": "721700714",
                                    "speaker": "旭东",
                                    "text": "采到海草之后，就拿过来给我吧。"
                                }
                            ]
                        },
                        {
                            "id": "721700715",
                            "text": "为什么不在海边采？",
                            "response": [
                                {
                                    "id": "721700716",
                                    "speaker": "旭东",
                                    "text": "那种在海边的海草都不太新鲜，用来做菜总感觉少点味道。"
                                },
                                {
                                    "id": "721700717",
                                    "speaker": "旭东",
                                    "text": "这个地方的海草品质应该就很好。总之，采海草的事就拜托了，旅行者。"
                                },
                                {
                                    "id": "721700718",
                                    "speaker": "旭东",
                                    "text": "采到海草之后，就拿过来给我吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}