            "dialogues": []
        },
        {
            "id": "7614807",
            "objective": "与伊斯托利亚对话",
            "dialogues": [
                {
                    "id": "761480701",
                    "speaker": "伊斯托利亚",
                    "text": "又回到这里了…"
                },
                {
                    "id": "761480702",
                    "speaker": "伊斯托利亚",
                    "text": "上次来这里，按照人的寿命来算都是前前前前前前…世时候的事了吧。"
                },
                {
                    "id": "761480703",
                    "speaker": "伊斯托利亚",
                    "text": "看来我们都被重新投入无想之间了。"
                },
                {
                    "id": "761480704",
                    "speaker": "Player",
                    "text": "所以我们应该怎么出去？"
                },
                {
                    "id": "761480705",
                    "speaker": "伊斯托利亚",
                    "text": "常规办法就是学习冥想，控制心和思绪。然后抛弃所有渴望的念头。"
                },
                {
                    "id": "761480706",
                    "speaker": "伊斯托利亚",
                    "text": "保持什么都不想的状态。"
                },
                {
                    "id": "761480707",
                    "speaker": "伊斯托利亚",
                    "text": "说着挺简单的。但是根据人的素质和渴望程度之不同，办到这一点从几年到几百年的都有。"
                },
                {
                    "id": "761480708",
                    "speaker": "伊斯托利亚",
                    "text": "像你这种背负世界命运的人，渴望恐怕无法被自己割舍吧。何况也不应该被舍弃。"
                },
                {
                    "id": "761480709",
                    "speaker": "Player",
                    "text": "那怎么办？"
                },
                {
                    "id": "761480710",
                    "speaker": "伊斯托利亚",
                    "text": "先找到彩特琳德再想办法吧。"
                },
                {
                    "id": "761480711",
                    "speaker": "小右",
                    "text": "！"
                },
                {
                    "id": "761480712",
                    "speaker": "Player",
                    "text": "你捡来了什么？"
                },
                {
                    "id": "761480713",
                    "speaker": "伊斯托利亚",
                    "text": "等等，小右也一起被拉进来了？"
                },
                {
                    "id": "761480714",
                    "speaker": "伊斯托利亚",
                    "text": "那么这一切或许还有转机。"
                },
                {
                    "id": "761480715",
                    "speaker": "伊斯托利亚",
                    "text": "同为守望者，或许小右可以利用这些碎片里的力量。强行开辟一条出路。"
                },
                {
                    "id": "761480716",
                    "speaker": "伊斯托利亚",
                    "text": "这个碎片总归是需要个名字方便称呼的。"
                },
                {
                    "id": "761480717",
                    "speaker": "伊斯托利亚",
                    "text": "这些过于夸张的棺材我略有耳闻，是神殿主人某个姐妹的布置。好像是叫做「死随念棺」。"
                },
                {
                    "id": "761480718",
                    "speaker": "伊斯托利亚",
                    "text": "那这些碎片就叫做「念亡碎片」吧。"
                }
            ]
        },
