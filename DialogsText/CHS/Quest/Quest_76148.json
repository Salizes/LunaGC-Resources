    "talks": [
        {
            "id": "7614801",
            "objective": "(test)废弃",
            "dialogues": [
                {
                    "id": "761480101",
                    "speaker": "派蒙",
                    "text": "呜啊，你们刚才去哪里了！吓死我了。"
                },
                {
                    "id": "761480102",
                    "speaker": "派蒙",
                    "text": "我一直在喊你的名字。"
                },
                {
                    "id": "761480103",
                    "speaker": "伊斯托利亚",
                    "text": "为什么派蒙这个小家伙没有被拉入无想之间？"
                },
                {
                    "id": "761480104",
                    "speaker": "Player",
                    "text": "可能她除了吃和睡…"
                },
                {
                    "id": "761480105",
                    "speaker": "Player",
                    "text": "…本身就什么也不想吧。"
                },
                {
                    "id": "761480106",
                    "speaker": "伊斯托利亚",
                    "text": "有道理。"
                },
                {
                    "id": "761480107",
                    "speaker": "伊斯托利亚",
                    "text": "看来梅兰塔真的生气了。"
                },
                {
                    "id": "761480108",
                    "speaker": "伊斯托利亚",
                    "text": "#送{NICKNAME}上去直面梅兰塔之事已是迫在眉睫了。"
                },
                {
                    "id": "761480109",
                    "speaker": "伊斯托利亚",
                    "text": "换个地方说话吧。这里也不是很安全。"
                },
                {
                    "id": "761480110",
                    "speaker": "阿罗逻",
                    "text": "那个，虽然没有人在意。但是大家好，我叫阿罗逻。"
                }
            ]
        },
