    },
    "talks": [
        {
            "id": "7280401",
            "objective": "与朝仓对话",
            "dialogues": [
                {
                    "id": "728040101",
                    "speaker": "朝仓",
                    "text": "阁下，正巧您来了，今天是至关重要的一天！"
                },
                {
                    "id": "728040102",
                    "speaker": "Player",
                    "text": "难道和你的武器有关…"
                },
                {
                    "id": "728040103",
                    "speaker": "朝仓",
                    "text": "正是！这段时间我四处搜集线索，总算确定了那一队海乱鬼的位置！"
                },
                {
                    "id": "728040104",
                    "speaker": "朝仓",
                    "text": "今天我就要洗刷耻辱，夺回我的武器！"
                },
                {
                    "id": "728040105",
                    "speaker": "派蒙",
                    "text": "哦！朝仓很有干劲呢！"
                },
                {
                    "id": "728040106",
                    "speaker": "朝仓",
                    "text": "不过我必须吸取之前的教训，海乱鬼的人数众多，还都是些不择手段的人。"
                },
                {
                    "id": "728040107",
                    "speaker": "朝仓",
                    "text": "要是他们一哄而上，消耗我的体力，我肯定会陷入被动，就和上次一样…"
                },
                {
                    "id": "728040108",
                    "speaker": "朝仓",
                    "text": "所以，这次我想请阁下与我同行。"
                },
                {
                    "id": "728040109",
                    "speaker": "朝仓",
                    "text": "上次我之所以落败，是因为那群海乱鬼仗着自己人多势众，不断地用车轮战消耗我的实力。"
                },
                {
                    "id": "728040110",
                    "speaker": "朝仓",
                    "text": "等我体力不支后，他们的首领再前来和我对战。"
                },
                {
                    "id": "728040111",
                    "speaker": "朝仓",
                    "text": "这次，我想请您帮我挡住周围的那些海乱鬼，而我会直接去挑战他们的首领。"
                },
                {
                    "id": "728040112",
                    "speaker": "朝仓",
                    "text": "等我斩了那个恶徒，再回来助您。",
                    "choices": [
                        {
                            "id": "728040113",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "728040114",
                                    "speaker": "朝仓",
                                    "text": "阁下愿意协助我，实在感激不尽！"
                                },
                                {
                                    "id": "728040119",
                                    "speaker": "朝仓",
                                    "text": "总之，就拜托阁下了。"
                                },
                                {
                                    "id": "728040120",
                                    "speaker": "朝仓",
                                    "text": "事不宜迟，我们这就出发吧。"
                                }
                            ]
                        },
                        {
                            "id": "728040115",
                            "text": "听上去我要一个打一群…",
                            "response": [
                                {
                                    "id": "728040116",
                                    "speaker": "朝仓",
                                    "text": "那群海乱鬼，说白了也就是一群除了人数之外一无是处的乌合之众。"
                                },
                                {
                                    "id": "728040117",
                                    "speaker": "朝仓",
                                    "text": "我相信凭阁下的身手，他们就算是一起上，在阁下手底下也走不过三招。"
                                },
                                {
                                    "id": "728040118",
                                    "speaker": "Player",
                                    "text": "咳，谬赞谬赞…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7280403",
            "objective": "击败海乱鬼",
            "dialogues": [
                {
                    "id": "728040301",
                    "speaker": "「海乱鬼」头领",
                    "text": "你？哈哈哈，不是上次的那个毛头小子吗？怎么，又来给我送藏品了？"
                },
                {
                    "id": "728040302",
                    "speaker": "朝仓",
                    "text": "我是来取回我的武器的！"
                },
                {
                    "id": "728040303",
                    "speaker": "「海乱鬼」头领",
                    "text": "嗯…不错，倒是有点胆色。但只找了一个帮手就敢闯到这里来，你未免也太看不起我了。"
                },
                {
                    "id": "728040304",
                    "speaker": "「海乱鬼」头领",
                    "text": "不过，看在你到这里的这份胆色上，我就给你这个机会，上前来！我们去旁边玩玩。"
                },
                {
                    "id": "728040305",
                    "speaker": "「海乱鬼」头领",
                    "text": "#但是嘛…我的这些手下，当然也不能闲着，你不是带了个帮手来吗？就让{M#他}{F#她}来陪他们玩玩吧。",
                    "choices": [
                        {
                            "id": "728040306",
                            "text": "尽管放马过来。",
                            "response": [
                                {
                                    "id": "728040308",
                                    "speaker": "「海乱鬼」头领",
                                    "text": "哈哈哈，口气倒是挺大。小的们，给我好好…折腾一下这愣头青！"
                                },
                                {
                                    "id": "728040309",
                                    "speaker": "「海乱鬼」头领",
                                    "text": "至于你，我们去旁边吧。"
                                },
                                {
                                    "id": "728040310",
                                    "speaker": "朝仓",
                                    "text": "那就交给你了，阁下…"
                                },
                                {
                                    "id": "728040311",
                                    "speaker": "Player",
                                    "text": "交给我吧。"
                                },
                                {
                                    "id": "728040312",
                                    "speaker": "朝仓",
                                    "text": "不胜感激。我会马上把他斩掉，然后回来帮您的。"
                                },
                                {
                                    "id": "728040313",
                                    "speaker": "「海乱鬼」头领",
                                    "text": "你的口气也不小啊，想要斩我的话，就自己来试试吧！"
                                }
                            ]
                        },
                        {
                            "id": "728040307",
                            "text": "只怕我玩不尽兴。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7280404",
            "objective": "审问海乱鬼",
            "dialogues": [
                {
                    "id": "728040206",
                    "speaker": "「海乱鬼」",
                    "text": "哎哟！好汉，好汉留手！你这是从哪里找来的帮手…"
                },
                {
                    "id": "728040207",
                    "speaker": "朝仓",
                    "text": "恶徒！现在就把武器还给我！"
                },
                {
                    "id": "728040208",
                    "speaker": "「海乱鬼」",
                    "text": "你、你居然还惦记着那把武器…"
                },
                {
                    "id": "728040209",
                    "speaker": "朝仓",
                    "text": "我只为取回我的武器，你告诉我那把武器在哪，我留你一条生路。"
                },
                {
                    "id": "728040210",
                    "speaker": "「海乱鬼」",
                    "text": "这…",
                    "choices": [
                        {
                            "id": "728040211",
                            "text": "别和他废话了。",
                            "response": [
                                {
                                    "id": "728040213",
                                    "speaker": "「海乱鬼」",
                                    "text": "啊哟！好汉留手！怎得如此暴躁，我也没说我不说啊！"
                                },
                                {
                                    "id": "728040214",
                                    "speaker": "「海乱鬼」",
                                    "text": "那…那把武器，被我们老大留着当藏品了，你们要是想拿，去那边的营地里找他就可以了！"
                                },
                                {
                                    "id": "728040215",
                                    "speaker": "朝仓",
                                    "text": "哼，算你识相。"
                                },
                                {
                                    "id": "728040216",
                                    "speaker": "「海乱鬼」",
                                    "text": "那二位好汉，在下…"
                                },
                                {
                                    "id": "728040217",
                                    "speaker": "Player",
                                    "text": "滚！"
                                },
                                {
                                    "id": "728040218",
                                    "speaker": "「海乱鬼」",
                                    "text": "是！"
                                },
                                {
                                    "id": "728040219",
                                    "speaker": "朝仓",
                                    "text": "武艺不怎么样，逃跑倒是挺在行！"
                                },
                                {
                                    "id": "728040220",
                                    "speaker": "Player",
                                    "text": "卖同伴卖得这么果断…"
                                },
                                {
                                    "id": "728040221",
                                    "speaker": "朝仓",
                                    "text": "海乱鬼终归只是一群为利而聚的乌合之众，谈不上什么忠诚，也谈不上什么信念。"
                                },
                                {
                                    "id": "728040222",
                                    "speaker": "朝仓",
                                    "text": "遇见了麻烦事，第一反应是拍屁股走人，这实在是太正常不过了。"
                                },
                                {
                                    "id": "728040223",
                                    "speaker": "朝仓",
                                    "text": "不过，还是多亏了阁下在一旁以声势压人，不然他可不会这么容易就服软。"
                                },
                                {
                                    "id": "728040224",
                                    "speaker": "朝仓",
                                    "text": "但接下来，我们就必须直奔海乱鬼的大本营了。"
                                },
                                {
                                    "id": "728040225",
                                    "speaker": "朝仓",
                                    "text": "还是依照之前的计划，阁下，我会直接去斩了那个头领，剩下的杂鱼就交给阁下了。",
                                    "choices": [
                                        {
                                            "id": "728040226",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "728040228",
                                                    "speaker": "朝仓",
                                                    "text": "那就拜托阁下了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "728040227",
                                            "text": "我一个打十个。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "728040212",
                            "text": "我们还是找下一个人…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7280408",
            "objective": "前往海乱鬼的营地",
            "dialogues": []
        },
        {
            "id": "7280405",
            "objective": "前往海乱鬼的营地",
            "dialogues": []
        },
        {
            "id": "7280406",
            "objective": "击败海乱鬼头领的部下",
            "dialogues": []
        },
        {
            "id": "7280407",
            "objective": "与朝仓对话",
            "dialogues": [
                {
                    "id": "728040406",
                    "speaker": "朝仓",
                    "text": "阁下，看你气息平稳，那些海乱鬼对你而言，果然不算什么。"
                },
                {
                    "id": "728040407",
                    "speaker": "Player",
                    "text": "看起来你也赢了。"
                },
                {
                    "id": "728040408",
                    "speaker": "朝仓",
                    "text": "没错，但是很惭愧…最后那家伙居然虚晃一招，拼着被我刺了一枪后逃跑了。"
                },
                {
                    "id": "728040409",
                    "speaker": "朝仓",
                    "text": "但是他伤得很重，我想，几年内他应该不可能再出来作乱了。"
                },
                {
                    "id": "728040410",
                    "speaker": "朝仓",
                    "text": "最主要的是，我亲手击败了他，也夺回了武器，彻底洗刷了耻辱。"
                },
                {
                    "id": "728040411",
                    "speaker": "Player",
                    "text": "恭喜你，朝仓。"
                },
                {
                    "id": "728040412",
                    "speaker": "朝仓",
                    "text": "实在感谢，但我还不能松懈！"
                },
                {
                    "id": "728040413",
                    "speaker": "朝仓",
                    "text": "这一切的起因，都是我的武艺还不够精湛，以后我会继续加倍刻苦修炼，精进武艺的。"
                },
                {
                    "id": "728040414",
                    "speaker": "朝仓",
                    "text": "所以…还请阁下多多关照，常来和我对练了！"
                },
                {
                    "id": "728040415",
                    "speaker": "朝仓",
                    "text": "哦，对了，这些东西还请阁下收下。虽然不算太多…但也是我的一份心意。"
                },
                {
                    "id": "728040416",
                    "speaker": "朝仓",
                    "text": "再次谢谢您，阁下！"
                }
            ]
        },
        {
            "id": "7280499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "728049903",
                    "speaker": "「海乱鬼」",
                    "text": "又是你？上次捡回一条命，居然还敢找过来？"
                },
                {
                    "id": "728049904",
                    "speaker": "「海乱鬼」",
                    "text": "还带了个帮手…哼，既然你不知好歹，那就别怪兄弟们下手黑了！"
                },
                {
                    "id": "728049905",
                    "speaker": "「海乱鬼」",
                    "text": "一起上！放倒他们！"
                },
                {
                    "id": "728049906",
                    "speaker": "派蒙",
                    "text": "朝仓去和那家伙一对一了，我们赶快打倒这些家伙！"
                },
                {
                    "id": "728049907",
                    "speaker": "「海乱鬼」头领",
                    "text": "都说同心的武器就是他们的尊严，你早就输给了我，还有什么脸面来和我对决！"
                },
                {
                    "id": "728049908",
                    "speaker": "朝仓",
                    "text": "正是因为上次输给了你…我这次才特意过来，亲手洗刷耻辱！"
                },
                {
                    "id": "728049909",
                    "speaker": "「海乱鬼」头领",
                    "text": "真是不知天高地厚…这次你可没人来帮忙了！"
                },
                {
                    "id": "728049910",
                    "speaker": "朝仓",
                    "text": "我也不需要人帮，我自己，就能斩了你！"
                },
                {
                    "id": "728049911",
                    "speaker": "派蒙",
                    "text": "看！朝仓在那里！"
                },
                {
                    "id": "728049912",
                    "speaker": "派蒙",
                    "text": "海乱鬼的头领好像逃走了，那肯定是朝仓赢了吧！"
                }
            ]
        }
    ]
}