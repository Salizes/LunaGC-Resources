    "talks": [
        {
            "id": "7327901",
            "objective": "(test)隐藏：与马塞拉对话领取任务$HIDDEN",
            "dialogues": [
                {
                    "id": "732790101",
                    "speaker": "马塞拉",
                    "text": "#啊，{NICKNAME}，尊贵的「镇灵主人」，大驾光临，令我受宠若惊。"
                },
                {
                    "id": "732790102",
                    "speaker": "利露帕尔",
                    "text": "好呀，又是一个沙漠奴才。我的大人…唉，算了，您有您自己的判断，我相信您就是了。"
                },
                {
                    "id": "732790103",
                    "speaker": "马塞拉",
                    "text": "不知您是否有闲暇赏光…我如同企盼明月和雨露一般，企望您的到来。"
                },
                {
                    "id": "732790104",
                    "speaker": "利露帕尔",
                    "text": "无事献殷勤，必不怀好意，你不如说得明白些。"
                },
                {
                    "id": "732790105",
                    "speaker": "马塞拉",
                    "text": "很好，镇灵大人…我的确有事相求。"
                },
                {
                    "id": "732790106",
                    "speaker": "马塞拉",
                    "text": "哈哈，没什么大事…是我的猎鹰，塔德菈…她应该是遇险了。"
                },
                {
                    "id": "732790107",
                    "speaker": "马塞拉",
                    "text": "唉…如果不是因为我的腿脚不行，也就不用麻烦您了。"
                },
                {
                    "id": "732790108",
                    "speaker": "派蒙",
                    "text": "我明白了，所以我们要去救她，然后你会谢谢我们，给我们好多摩拉，我们再去大吃一顿庆祝胜利！对吧？"
                },
                {
                    "id": "732790109",
                    "speaker": "马塞拉",
                    "text": "呃…是的，是的。"
                },
                {
                    "id": "732790110",
                    "speaker": "派蒙",
                    "text": "如果是这样的话，就交给我们好啦！"
                },
                {
                    "id": "732790111",
                    "speaker": "Player",
                    "text": "每到这种时候，逻辑就格外清晰呢…"
                },
                {
                    "id": "732790112",
                    "speaker": "利露帕尔",
                    "text": "唉…那就这样吧，为了这贪婪的小家伙能大吃一顿。"
                },
                {
                    "id": "732790113",
                    "speaker": "马塞拉",
                    "text": "万分感谢…那么这件事就拜托给您了。"
                },
                {
                    "id": "732790114",
                    "speaker": "马塞拉",
                    "text": "啊…她最后出现的地点，在这里，请让我为您标出来…"
                },
                {
                    "id": "732790115",
                    "speaker": "马塞拉",
                    "text": "你们要找的人，塔德菈…她的个子很高，肤色黝黑，留着浅色的长发，手持长弓…嗯，这些信息应该够了。"
                },
                {
                    "id": "732790116",
                    "speaker": "马塞拉",
                    "text": "怎么样，你们记住了吗？"
                },
                {
                    "id": "732790117",
                    "speaker": "派蒙",
                    "text": "嗯…高个子，深色皮肤的女孩子，浅色长发，还拿着长弓！嘿嘿，我记性很好的！"
                },
                {
                    "id": "732790118",
                    "speaker": "马塞拉",
                    "text": "嗯…愿流风引导您穿越黄沙，避开重重险阻。"
                },
                {
                    "id": "732790119",
                    "speaker": "派蒙",
                    "text": "好，我们走啦！"
                }
            ]
        },
        {
            "id": "7327902",
            "objective": "前往塔德菈最后出现的地方",
            "dialogues": [
                {
                    "id": "732790201",
                    "speaker": "马塞拉",
                    "text": "怎么，你们找到她了？"
                },
                {
                    "id": "732790202",
                    "speaker": "马塞拉",
                    "text": "啊，还需要时间，是吧…"
                },
                {
                    "id": "732790203",
                    "speaker": "马塞拉",
                    "text": "那么还要劳烦你们尽快救出塔德菈…时间不等人呀。"
                }
            ]
        },
        {
            "id": "7327903",
            "objective": "深入探索",
            "dialogues": []
        },
        {
            "id": "7327904",
            "objective": "与派蒙对话",
            "dialogues": [
                {
                    "id": "732790401",
                    "speaker": "派蒙",
                    "text": "嘘…！你看…有人在那边…！"
                },
                {
                    "id": "732790402",
                    "speaker": "利露帕尔",
                    "text": "哦…我的大人，这些人…就是此前你们曾反复提及的「蠢人众」吧？"
                },
                {
                    "id": "732790403",
                    "speaker": "Player",
                    "text": "是「愚人众」…"
                },
                {
                    "id": "732790404",
                    "speaker": "利露帕尔",
                    "text": "有区别吗？"
                },
                {
                    "id": "732790405",
                    "speaker": "派蒙",
                    "text": "你小声一点啦！万一被发现了…"
                },
                {
                    "id": "732790406",
                    "speaker": "利露帕尔",
                    "text": "没关系的，他们听不到我说话。不信你们看…"
                },
                {
                    "id": "732790407",
                    "speaker": "利露帕尔",
                    "text": "喂！大胖子！我在这边！开饭了，开饭了！"
                },
                {
                    "id": "732790408",
                    "speaker": "愚人众先遣队员甲",
                    "text": "嗯…？你听到什么了吗？"
                },
                {
                    "id": "732790409",
                    "speaker": "愚人众先遣队员乙",
                    "text": "没有，怎么了？"
                },
                {
                    "id": "732790410",
                    "speaker": "愚人众先遣队员甲",
                    "text": "唔…我还以为开饭了呢。"
                },
                {
                    "id": "732790411",
                    "speaker": "利露帕尔",
                    "text": "哼哼，看吧？"
                },
                {
                    "id": "732790412",
                    "speaker": "派蒙",
                    "text": "利露帕尔也会玩这种小孩子把戏呀…嘿嘿，总觉得有点可爱呢！"
                },
                {
                    "id": "732790413",
                    "speaker": "派蒙",
                    "text": "你看…那边！他们关押的那个是不是塔德菈呀！"
                },
                {
                    "id": "732790414",
                    "speaker": "派蒙",
                    "text": "唔我记得她…个子很高，肤色黝黑，留着浅色的长发…应该就是她了。"
                },
                {
                    "id": "732790415",
                    "speaker": "利露帕尔",
                    "text": "记性不错嘛，小家伙。我们动手吧，我的大人。"
                },
                {
                    "id": "732790416",
                    "speaker": "派蒙",
                    "text": "#好，{NICKNAME}，我们动手吧！"
                }
            ]
        },
        {
            "id": "7327905",
            "objective": "击败愚人众",
            "dialogues": []
        },
        {
            "id": "7327906",
            "objective": "与塔德菈对话",
            "dialogues": [
                {
                    "id": "732790601",
                    "speaker": "塔德菈",
                    "text": "……"
                },
                {
                    "id": "732790602",
                    "speaker": "派蒙",
                    "text": "那个…你就是塔德菈吗？我们是来救你的！"
                },
                {
                    "id": "732790603",
                    "speaker": "塔德菈",
                    "text": "嗯…？嗯。"
                },
                {
                    "id": "732790604",
                    "speaker": "塔德菈",
                    "text": "你把他们放走了。",
                    "choices": [
                        {
                            "id": "732790605",
                            "text": "那些人构不成威胁了。",
                            "response": [
                                {
                                    "id": "732790607",
                                    "speaker": "塔德菈",
                                    "text": "…他们会回去，告诉其他人。这样他们都会知道我们在这里。"
                                },
                                {
                                    "id": "732790608",
                                    "speaker": "利露帕尔",
                                    "text": "你看，智者所见略同。我喜欢这女孩。"
                                },
                                {
                                    "id": "732790609",
                                    "speaker": "派蒙",
                                    "text": "那些不要紧啦！他们再来，我们就再把他们打跑！不过你受伤了…需要我们帮忙吗？"
                                },
                                {
                                    "id": "732790610",
                                    "speaker": "塔德菈",
                                    "text": "我还好，还能走，还能找个地方自己死去。"
                                },
                                {
                                    "id": "732790611",
                                    "speaker": "派蒙",
                                    "text": "哦…那还好啦，她还能找个地方——喂，一点也不好吧！"
                                },
                                {
                                    "id": "732790612",
                                    "speaker": "塔德菈",
                                    "text": "我开玩笑的。"
                                },
                                {
                                    "id": "732790613",
                                    "speaker": "利露帕尔",
                                    "text": "哈哈。"
                                },
                                {
                                    "id": "732790614",
                                    "speaker": "利露帕尔",
                                    "text": "我喜欢这女孩的幽默感…若有似无的。"
                                },
                                {
                                    "id": "732790615",
                                    "speaker": "塔德菈",
                                    "text": "谢谢你们，我们回去吧。",
                                    "choices": [
                                        {
                                            "id": "732790616",
                                            "text": "你的腿脚方便吗？",
                                            "response": [
                                                {
                                                    "id": "732790617",
                                                    "speaker": "塔德菈",
                                                    "text": "不方便，但也不需要搀扶。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "732790618",
                                            "text": "不休息一下吗？",
                                            "response": [
                                                {
                                                    "id": "732790619",
                                                    "speaker": "塔德菈",
                                                    "text": "休息…？不，我们还没那么熟。"
                                                },
                                                {
                                                    "id": "732790620",
                                                    "speaker": "利露帕尔",
                                                    "text": "但我觉得我们可以认识一下，怎么样？"
                                                },
                                                {
                                                    "id": "732790621",
                                                    "speaker": "塔德菈",
                                                    "text": "谢谢，以后吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "732790606",
                            "text": "没必要赶尽杀绝。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7327907",
            "objective": "与马塞拉对话",
            "dialogues": [
                {
                    "id": "732790701",
                    "speaker": "马塞拉",
                    "text": "啊，我的小猎鹰回来了！谢谢你们！"
                },
                {
                    "id": "732790702",
                    "speaker": "塔德菈",
                    "text": "抱歉…我遭到了伏击，多亏他们相救，我才能回来见您。"
                },
                {
                    "id": "732790703",
                    "speaker": "马塞拉",
                    "text": "「他们」…？是我们尊贵的「镇灵主人」！"
                },
                {
                    "id": "732790704",
                    "speaker": "塔德菈",
                    "text": "对不起…"
                },
                {
                    "id": "732790705",
                    "speaker": "派蒙",
                    "text": "没关系，没关系啦！塔德菈受伤了，你也对她好些嘛！"
                },
                {
                    "id": "732790706",
                    "speaker": "塔德菈",
                    "text": "……"
                },
                {
                    "id": "732790707",
                    "speaker": "马塞拉",
                    "text": "…你受伤了？"
                },
                {
                    "id": "732790708",
                    "speaker": "塔德菈",
                    "text": "…对不起。"
                },
                {
                    "id": "732790709",
                    "speaker": "马塞拉",
                    "text": "是什么动物把你搞成这样的？是人？"
                },
                {
                    "id": "732790710",
                    "speaker": "塔德菈",
                    "text": "是北方人，我遭到了北方人的伏击…他们发现自己被跟踪了，就设下埋伏…"
                },
                {
                    "id": "732790711",
                    "speaker": "马塞拉",
                    "text": "设下埋伏的应该是你才对。"
                },
                {
                    "id": "732790712",
                    "speaker": "马塞拉",
                    "text": "被猎物反咬成这个样子，对猎鹰来说，像什么样子…"
                },
                {
                    "id": "732790713",
                    "speaker": "塔德菈",
                    "text": "……"
                },
                {
                    "id": "732790714",
                    "speaker": "马塞拉",
                    "text": "…去休息吧，你需要休息。稍后我会为你疗伤。"
                },
                {
                    "id": "732790715",
                    "speaker": "Black Screen",
                    "text": "塔德菈只是默默点点头，忍着疼痛缓步离开了。"
                },
                {
                    "id": "732790716",
                    "speaker": "派蒙",
                    "text": "马塞拉对塔德菈有点苛刻呢…",
                    "choices": [
                        {
                            "id": "732790717",
                            "text": "你们之间关系…不好吗？",
                            "response": [
                                {
                                    "id": "732790718",
                                    "speaker": "马塞拉",
                                    "text": "嗯？不，怎么会呢！她是我最爱的「猎鹰」…我爱她，但不溺爱她。猎鹰没有给你带回猎物的话，怎么能喂饱它呢？"
                                },
                                {
                                    "id": "732790719",
                                    "speaker": "利露帕尔",
                                    "text": "原来是这样…哼，那女孩不会有好结果的。"
                                },
                                {
                                    "id": "732790723",
                                    "speaker": "马塞拉",
                                    "text": "这些报酬请您一定收下，感谢您，尊贵的「镇灵主人」。"
                                },
                                {
                                    "id": "732790724",
                                    "speaker": "利露帕尔",
                                    "text": "咳咳，你是不是忘了什么？这里还有两个人呢？"
                                },
                                {
                                    "id": "732790725",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，其中一个也不算「人」吧…"
                                },
                                {
                                    "id": "732790726",
                                    "speaker": "利露帕尔",
                                    "text": "哦…我忘了，这个小精灵不是人。不过我们也应该得到感谢吧？"
                                },
                                {
                                    "id": "732790727",
                                    "speaker": "派蒙",
                                    "text": "喂——！"
                                },
                                {
                                    "id": "732790728",
                                    "speaker": "马塞拉",
                                    "text": "哈哈，抱歉、抱歉，请您收下额外的报酬。"
                                },
                                {
                                    "id": "732790729",
                                    "speaker": "派蒙",
                                    "text": "还有额外的报酬！"
                                },
                                {
                                    "id": "732790730",
                                    "speaker": "利露帕尔",
                                    "text": "…仍是不多，不过既然我的大人没什么意见，那就这样吧。"
                                },
                                {
                                    "id": "732790731",
                                    "speaker": "马塞拉",
                                    "text": "很好，啊…希望有时间的话，您能再来一趟…我想，我的「猎鹰」仍然需要您的帮助。"
                                }
                            ]
                        },
                        {
                            "id": "732790720",
                            "text": "请不要太苛待塔德菈。",
                            "response": [
                                {
                                    "id": "732790721",
                                    "speaker": "马塞拉",
                                    "text": "苛待？不，我太纵容她了，她的本领退步了…我只是在教育她而已，她是个优秀的「猎鹰」，我怎会忍心伤害她呢。"
                                },
                                {
                                    "id": "732790722",
                                    "speaker": "利露帕尔",
                                    "text": "那么猎鹰的结局，往往是什么样呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7327908",
            "objective": "(test)废弃",
            "dialogues": []
        },
        {
            "id": "7327999",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "732799901",
                    "speaker": "派蒙",
                    "text": "塔德菈不在这里呢…我们再往前找找吧？"
                },
                {
                    "id": "732799902",
                    "speaker": "利露帕尔",
                    "text": "你看，这里有很多脚印，看来盘踞在这座洞里的家伙直到最近还很活跃…哼，这么不谨慎吗？"
                },
                {
                    "id": "732799903",
                    "speaker": "派蒙",
                    "text": "有道理呢，我们也进去调查一下吧！"
                },
                {
                    "id": "732799904",
                    "speaker": "愚人众先遣队员甲",
                    "text": "放弃据点，撤退！我们撤退！"
                },
                {
                    "id": "732799905",
                    "speaker": "利露帕尔",
                    "text": "他们逃走了，唉…为何如此心慈手软呢，我的大人？"
                }
            ]
        }
    ]
}