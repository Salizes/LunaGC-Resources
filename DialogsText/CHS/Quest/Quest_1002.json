    "talks": [
        {
            "id": "100201",
            "objective": "绝云间遇仙",
            "dialogues": []
        },
        {
            "id": "100202",
            "objective": "（test）与仙人对话$HIDDEN",
            "dialogues": [
                {
                    "id": "10020201",
                    "speaker": "？？？",
                    "text": "尔是何人，因何擅闯「绝云间」？",
                    "choices": [
                        {
                            "id": "10020202",
                            "text": "我受人之托…",
                            "response": [
                                {
                                    "id": "10020203",
                                    "speaker": "Player",
                                    "text": "请您看看这个…"
                                },
                                {
                                    "id": "10020204",
                                    "speaker": "？？？",
                                    "text": "「百无禁忌箓」…多年不见这东西了，原来凡人手中还有残余。"
                                },
                                {
                                    "id": "10020205",
                                    "speaker": "削月筑阳真君",
                                    "text": "我乃三眼五显仙人，削月筑阳真君。旅者，说出你的来意。"
                                },
                                {
                                    "id": "10020206",
                                    "speaker": "派蒙",
                                    "text": "其实…"
                                },
                                {
                                    "id": "10020207",
                                    "speaker": "千岩军教头",
                                    "text": "是刺客！他们居然潜逃到了这里！"
                                },
                                {
                                    "id": "10020208",
                                    "speaker": "千岩军士兵",
                                    "text": "头儿，我们已经太深入「绝云间」了…"
                                },
                                {
                                    "id": "10020209",
                                    "speaker": "千岩军教头",
                                    "text": "这…没法子，捉拿刺客是头等大事，硬着头皮也要上啊！"
                                },
                                {
                                    "id": "10020210",
                                    "speaker": "削月筑阳真君",
                                    "text": "…滋扰清境。"
                                },
                                {
                                    "id": "10020211",
                                    "speaker": "削月筑阳真君",
                                    "text": "送走他们，莫要杀生。"
                                }
                            ]
                        },
                        {
                            "id": "10020203",
                            "text": "请您看看这个…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "100203",
            "objective": "对话中创建怪物（隐藏）$HIDDEN",
            "dialogues": []
        },
        {
            "id": "100204",
            "objective": "仙人加持下的战斗",
            "dialogues": []
        },
        {
            "id": "100205",
            "objective": "自动与仙人对话（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "10020501",
                    "speaker": "削月筑阳真君",
                    "text": "那么，重归正题——旅者，说出你的来意。"
                },
                {
                    "id": "10020502",
                    "speaker": "派蒙",
                    "text": "其实…"
                },
                {
                    "id": "10020503",
                    "speaker": "削月筑阳真君",
                    "text": "岂有此理…"
                },
                {
                    "id": "10020504",
                    "speaker": "削月筑阳真君",
                    "text": "岂有此理！！！"
                },
                {
                    "id": "10020505",
                    "speaker": "削月筑阳真君",
                    "text": "璃月七星…实在令人失望。"
                },
                {
                    "id": "10020506",
                    "speaker": "削月筑阳真君",
                    "text": "「请仙典仪」上，如何能有人行刺帝君…"
                },
                {
                    "id": "10020507",
                    "speaker": "削月筑阳真君",
                    "text": "帝君遇刺之后…又如何能将嫌疑推给观礼凡民？！"
                },
                {
                    "id": "10020508",
                    "speaker": "削月筑阳真君",
                    "text": "……"
                },
                {
                    "id": "10020509",
                    "speaker": "削月筑阳真君",
                    "text": "旅者，你受诬为刺客的冤情，我也已然知晓。"
                },
                {
                    "id": "10020510",
                    "speaker": "削月筑阳真君",
                    "text": "此事我心已有判断。然我独断，或有差错，尚需知会众仙。"
                },
                {
                    "id": "10020511",
                    "speaker": "削月筑阳真君",
                    "text": "去吧。拿着你的「百无禁忌箓」，为我去传口信。",
                    "choices": [
                        {
                            "id": "10020512",
                            "text": "我该去找谁呢？",
                            "response": [
                                {
                                    "id": "10020513",
                                    "speaker": "Player",
                                    "text": "我该去哪里呢？"
                                },
                                {
                                    "id": "10020514",
                                    "speaker": "削月筑阳真君",
                                    "text": "理水叠山真君、留云借风真君，这两位常在此间，但你未必有缘相遇——随缘即可。"
                                },
                                {
                                    "id": "10020515",
                                    "speaker": "削月筑阳真君",
                                    "text": "还有一位降魔大圣、护法夜叉。去往「望舒客栈」，或可觅其踪迹。"
                                }
                            ]
                        },
                        {
                            "id": "10020513",
                            "text": "我该去哪里呢？"
                        }
                    ]
                }
            ]
        }
    ]
