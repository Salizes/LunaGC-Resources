    },
    "talks": [
        {
            "id": "1501201",
            "objective": "询问伊蜜的状况",
            "dialogues": [
                {
                    "id": "150120101",
                    "speaker": "伊蜜",
                    "text": "还，还没有回来…夏温师父难道真的出了什么事…呜…"
                },
                {
                    "id": "150120102",
                    "speaker": "派蒙",
                    "text": "那边的小朋友怎么在哭啊，是发生了什么吗？"
                },
                {
                    "id": "150120103",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们过去看看吧。"
                },
                {
                    "id": "150120104",
                    "speaker": "Player",
                    "text": "小妹妹，你怎么了？"
                },
                {
                    "id": "150120105",
                    "speaker": "伊蜜",
                    "text": "呜…是，是夏温师父…"
                },
                {
                    "id": "150120106",
                    "speaker": "伊蜜",
                    "text": "她、她说要去那边采「火山晶石」…但是到现在也没回来。"
                },
                {
                    "id": "150120107",
                    "speaker": "伊蜜",
                    "text": "我告诉了守卫叔叔，但叔叔们说，现在部族里实在抽不开来人手，而且那边的地形很危险，还待着好多魔物和坏蛋…"
                },
                {
                    "id": "150120108",
                    "speaker": "伊蜜",
                    "text": "他们只能先尽量筹备着，等准备好之后再去营救夏温师父…但那样就来不及了。",
                    "choices": [
                        {
                            "id": "150120109",
                            "text": "放心吧，包在我身上。",
                            "response": [
                                {
                                    "id": "150120111",
                                    "speaker": "伊蜜",
                                    "text": "你愿意帮我？太好了！我这就把守卫叔叔之前去过的地方画给你。"
                                },
                                {
                                    "id": "150120112",
                                    "speaker": "伊蜜",
                                    "text": "守卫叔叔们说，这可能就是夏温师父待过的地方。"
                                },
                                {
                                    "id": "150120113",
                                    "speaker": "伊蜜",
                                    "text": "说不定，她会被迫跑到了「缝影针」附近。如果…如果是那样的话…呜…"
                                },
                                {
                                    "id": "150120114",
                                    "speaker": "伊蜜",
                                    "text": "#拜托了，{M#大哥哥}{F#大姐姐}，救救夏温师父吧！"
                                }
                            ]
                        },
                        {
                            "id": "150120110",
                            "text": "看来我的英雄事迹又要多一笔了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1501202",
            "objective": "前往营救夏温",
            "dialogues": [
                {
                    "id": "150120201",
                    "speaker": "伊蜜",
                    "text": "#拜托了，{M#大哥哥}{F#大姐姐}，救救夏温师父吧！"
                }
            ]
        },
        {
            "id": "1501203",
            "objective": "解救夏温",
            "dialogues": []
        },
        {
            "id": "1501204",
            "objective": "与夏温对话",
            "dialogues": [
                {
                    "id": "150120701",
                    "speaker": "Player",
                    "text": "她为什么不再打造「古名」了？"
                },
                {
                    "id": "150120702",
                    "speaker": "夏温",
                    "text": "…因为她的女儿。可怜的小妮赫佳患了重病，特拉佐莉几乎抛下了一切，全心照顾着她。"
                },
                {
                    "id": "150120703",
                    "speaker": "夏温",
                    "text": "在小妮赫佳病情最严重的那段时间，特拉佐莉就像是一束陷入泥潭的火炬。拼了命的发着光和热，底下的泥水却追逐得越来越近…"
                },
                {
                    "id": "150120704",
                    "speaker": "夏温",
                    "text": "哎呀，但是还好！多亏了医生的药，还有大灵的保佑，小妮赫佳的生命之火还是重新燃了起来！"
                },
                {
                    "id": "150120705",
                    "speaker": "夏温",
                    "text": "之后，小妮赫佳的病情也逐渐变好。虽然她身体还很虚弱，只能在家里静养，但这孩子已经有力气写信了。"
                },
                {
                    "id": "150120706",
                    "speaker": "夏温",
                    "text": "我听说，她经常寄信给那位希诺宁，还梦想着成为一个锻造古名的工匠，接下她母亲曾经为之自豪的重任呢。"
                },
                {
                    "id": "150120707",
                    "speaker": "夏温",
                    "text": "过几天就是小妮赫佳的生日了，特拉佐莉也特意来拜托我，帮她找一块足够纯净的「火山晶石」，用来给妮赫佳做生日礼物。",
                    "choices": [
                        {
                            "id": "150120708",
                            "text": "所以，你才会一个人来这里探矿。",
                            "response": [
                                {
                                    "id": "150120710",
                                    "speaker": "派蒙",
                                    "text": "确实是一块意义重大的矿石呀。有了这么漂亮的礼物，那个叫妮赫佳的小朋友一定能好得更快。"
                                },
                                {
                                    "id": "150120711",
                                    "speaker": "夏温",
                                    "text": "那我就替特拉佐莉和妮赫佳借你吉言了。"
                                },
                                {
                                    "id": "150120712",
                                    "speaker": "夏温",
                                    "text": "我们先回去吧，不能让伊蜜那孩子等急了。"
                                },
                                {
                                    "id": "150120713",
                                    "speaker": "夏温",
                                    "text": "对了，如果你愿意的话，明天和我一起去探望特拉佐莉吧。"
                                },
                                {
                                    "id": "150120714",
                                    "speaker": "夏温",
                                    "text": "多亏了你帮忙，这枚晶石才没被那群人抢走。"
                                },
                                {
                                    "id": "150120715",
                                    "speaker": "夏温",
                                    "text": "你保护了这么一枚意义重大的晶石，理应也拿到一份意义重大的礼物。"
                                },
                                {
                                    "id": "150120716",
                                    "speaker": "Player",
                                    "text": "希望能让妮赫佳开心。"
                                },
                                {
                                    "id": "150120717",
                                    "speaker": "派蒙",
                                    "text": "嗯，只要心情好，病就能好得更快！"
                                },
                                {
                                    "id": "150120718",
                                    "speaker": "派蒙",
                                    "text": "当然啦，那个…稍微给我们一点礼物，我们的心情也会很好…"
                                },
                                {
                                    "id": "150120719",
                                    "speaker": "夏温",
                                    "text": "哈哈哈，放心吧，这份礼物绝对能让你们满意。"
                                },
                                {
                                    "id": "150120720",
                                    "speaker": "夏温",
                                    "text": "至于它究竟是什么…就等明天特拉佐莉亲口告诉你们吧。"
                                }
                            ]
                        },
                        {
                            "id": "150120709",
                            "text": "这枚晶石，的确不能轻易让出去。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1501204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150120401",
                    "speaker": "派蒙",
                    "text": "呜哇，跑得好快，也好果断…",
                    "choices": [
                        {
                            "id": "150120402",
                            "text": "算他们识时务。",
                            "response": [
                                {
                                    "id": "150120404",
                                    "speaker": "夏温",
                                    "text": "呼…太谢谢你们了。要不是你们帮忙，我肯定要被丢下山去了。"
                                },
                                {
                                    "id": "150120405",
                                    "speaker": "夏温",
                                    "text": "#能让{NICKNAME}出手搭救，我今天的运气也是够好的。"
                                },
                                {
                                    "id": "150120406",
                                    "speaker": "夏温",
                                    "text": "抱歉，我没做自我介绍，我是夏温，一个倒霉透顶，刚刚才撞了好运的宝石匠。"
                                },
                                {
                                    "id": "150120407",
                                    "speaker": "Player",
                                    "text": "是伊蜜拜托我们来的。"
                                },
                                {
                                    "id": "150120408",
                                    "speaker": "夏温",
                                    "text": "那孩子…唉，让她担心了。我离开铺子的时候，还以为最多两天就能回来。"
                                },
                                {
                                    "id": "150120409",
                                    "speaker": "夏温",
                                    "text": "我也没想到，居然能在「缝影针」附近发现一条新的「火山晶石」矿脉。里面的晶石格外纯净，矿量也足。"
                                },
                                {
                                    "id": "150120410",
                                    "speaker": "夏温",
                                    "text": "我挖出了许多纯净的「火山晶石」，正准备回去的时候，晶石里的燃素却吸引来了魔物…"
                                }
                            ]
                        },
                        {
                            "id": "150120403",
                            "text": "名声大也有好处啊…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1501205",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150120501",
                    "speaker": "夏温",
                    "text": "我慌不择路，只能挑小路绕开它们。没想到刚出来的时候，却撞见了那些贼匪…幸好你们来得及时。"
                },
                {
                    "id": "150120502",
                    "speaker": "派蒙",
                    "text": "你逃跑的时候，还带着这些晶石吗？都那么危险了，不能把这些石头丢掉吗？"
                },
                {
                    "id": "150120503",
                    "speaker": "夏温",
                    "text": "我已经丢了很多了。只留下了一块最纯净的晶石。我无论如何都得把它带回去。"
                },
                {
                    "id": "150120504",
                    "speaker": "夏温",
                    "text": "…为了特拉佐莉，也为了可怜的小妮赫佳。"
                },
                {
                    "id": "150120505",
                    "speaker": "Player",
                    "text": "这两个人是…"
                },
                {
                    "id": "150120506",
                    "speaker": "夏温",
                    "text": "喔，你不知道也正常。特拉佐莉…曾经是一位打造「古名」的工匠，妮赫佳是她的女儿。"
                }
            ]
        },
        {
            "id": "1501206",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150120601",
                    "speaker": "夏温",
                    "text": "不过…你也看见这周围的情况了吧。前段时间，一直在上面悬着的「缝影针」突然砸了下去，把周围砸出了一个大坑。"
                },
                {
                    "id": "150120602",
                    "speaker": "夏温",
                    "text": "虽然我找到的那条矿脉靠外侧，勉强幸免于难…但周围的魔物全被惊了，到处都是发了狂的怪物。"
                },
                {
                    "id": "150120603",
                    "speaker": "夏温",
                    "text": "我慌不择路，只能挑小路绕开它们。没想到刚出来的时候，却撞见了那些贼匪…幸好你们来得及时。"
                },
                {
                    "id": "150120604",
                    "speaker": "派蒙",
                    "text": "你逃跑的时候，还带着这些晶石吗？都那么危险了，不能把这些石头丢掉吗？"
                },
                {
                    "id": "150120605",
                    "speaker": "夏温",
                    "text": "我已经丢了很多了。只留下了一块最纯净的晶石。我无论如何都得把它带回去。"
                },
                {
                    "id": "150120606",
                    "speaker": "夏温",
                    "text": "…为了特拉佐莉，也为了可怜的小妮赫佳。"
                },
                {
                    "id": "150120607",
                    "speaker": "Player",
                    "text": "这两个人是…"
                },
                {
                    "id": "150120608",
                    "speaker": "夏温",
                    "text": "喔，你不知道也正常。特拉佐莉…曾经是一位打造「古名」的工匠，妮赫佳是她的女儿。"
                }
            ]
        },
