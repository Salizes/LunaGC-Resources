        "chapter": {
            "icon": "UI_ChapterIcon_Natlan_Drillhead",
            "id": "2058",
            "num": "祈祝福愿，倾告嵴锋 第一幕",
            "title": "嵴锋的异响"
        },
        "total_dialogue_lines": 115,
