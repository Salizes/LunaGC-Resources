{
    "quest": {
        "id": "72248",
        "title": "庙前的叩问",
        "description": "按名为阿倍良久的残魂的说法，通过试炼，取得供奉之物…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "UI_ChapterIcon_Common",
            "id": "10060",
            "num": "",
            "title": "许伯利翁哀歌"
        },
        "total_dialogue_lines": 53,
        "total_speaker_counts": {
            "Player": 4,
            "派蒙": 16,
