        }
    },
    "talks": [
        {
            "id": "7224801",
            "objective": "(test)解锁5个封印$HIDDEN",
            "dialogues": [
                {
                    "id": "722480101",
                    "speaker": "阿倍良久",
                    "text": "旅者啊，汝准备好了吗？"
                }
            ]
        },
        {
            "id": "7224805",
            "objective": "与残魂对话$HIDDEN",
            "dialogues": [
                {
                    "id": "722480301",
                    "speaker": "派蒙",
                    "text": "好像出现了一个残魂……"
                },
                {
                    "id": "722480302",
                    "speaker": "阿倍良久",
                    "text": "吾乃…"
                },
                {
                    "id": "722480303",
                    "speaker": "阿倍良久",
                    "text": "吾乃赫利俄斯之建造者，名曰：阿倍良久！"
                },
                {
                    "id": "722480304",
                    "speaker": "阿倍良久",
                    "text": "吾怎么可能被你们这些妄语谗言所击倒，吾怎么会被你们操纵的稚童幽禁！"
                },
                {
                    "id": "722480305",
                    "speaker": "阿倍良久",
                    "text": "吾…不对，吾…吾在幽禁之所度过了无尽岁月，此时已是…生后之身？"
                },
                {
                    "id": "722480306",
                    "speaker": "派蒙",
                    "text": "生后之身？是说自己已经死去的意思吗？"
                },
                {
                    "id": "722480307",
                    "speaker": "派蒙",
                    "text": "能够意识到这点的残魂很少见啊。"
                },
                {
                    "id": "722480308",
                    "speaker": "阿倍良久",
                    "text": "说来惭愧，但为何而死，吾已回想不出…"
                },
                {
                    "id": "722480309",
                    "speaker": "阿倍良久",
                    "text": "只是记忆之中，吾被一个孩子下令关押至死。"
                },
                {
                    "id": "722480310",
                    "speaker": "派蒙",
                    "text": "一个孩子？"
                },
                {
                    "id": "722480311",
                    "speaker": "阿倍良久",
                    "text": "正是，不过，时至今日，提起那个孩子吾也不觉得怨恨，只是觉得可怜。"
                },
                {
                    "id": "722480312",
                    "speaker": "阿倍良久",
                    "text": "有错的，并不是他，有错的是将他视为掌中傀儡的…算了，不提也罢。"
                },
                {
                    "id": "722480313",
                    "speaker": "阿倍良久",
                    "text": "那之后，吾就被幽禁…"
                },
                {
                    "id": "722480314",
                    "speaker": "阿倍良久",
                    "text": "幽禁于一处…"
                },
                {
                    "id": "722480315",
                    "speaker": "派蒙",
                    "text": "一处？"
                },
                {
                    "id": "722480316",
                    "speaker": "阿倍良久",
                    "text": "一处很高的地方…"
                },
                {
                    "id": "722480317",
                    "speaker": "阿倍良久",
                    "text": "虽然很高，但该处却黯淡无光，冷若冰窟。"
                },
                {
                    "id": "722480318",
                    "speaker": "阿倍良久",
                    "text": "…咦，奇怪，为何呢？"
                },
                {
                    "id": "722480319",
                    "speaker": "阿倍良久",
                    "text": "为何吾会觉得，高处本应是让人温暖舒畅的呢？"
                },
                {
                    "id": "722480320",
                    "speaker": "阿倍良久",
                    "text": "为何…为何吾什么都想不起来？"
                },
                {
                    "id": "722480321",
                    "speaker": "派蒙",
                    "text": "难道是因为肚子饿了？"
                },
                {
                    "id": "722480322",
                    "speaker": "派蒙",
                    "text": "我肚子饿的时候，别说动脑想什么了，连话都说不顺。",
                    "choices": [
                        {
                            "id": "722480323",
                            "text": "我觉得不是因为这个…",
                            "response": [
                                {
                                    "id": "722480324",
                                    "speaker": "派蒙",
                                    "text": "肯定就是嘛！你看他也话都说不清了。"
                                },
                                {
                                    "id": "722480327",
                                    "speaker": "派蒙",
                                    "text": "#啊，{NICKNAME}，你可以找找看，万一贡品里面有能吃的东西呢？"
                                },
                                {
                                    "id": "722480328",
                                    "speaker": "阿倍良久",
                                    "text": "是了！贡品！"
                                },
                                {
                                    "id": "722480329",
                                    "speaker": "派蒙",
                                    "text": "怎么样，是想吃贡品了吗？"
                                },
                                {
                                    "id": "722480330",
                                    "speaker": "阿倍良久",
                                    "text": "不，吾只是想起了…"
                                },
                                {
                                    "id": "722480331",
                                    "speaker": "阿倍良久",
                                    "text": "吾在幽禁至死后，因铸造赫利俄斯之功，残躯与衣冠在各处享有供奉。"
                                },
                                {
                                    "id": "722480332",
                                    "speaker": "阿倍良久",
                                    "text": "也是因此而魂魄分离，致使灵魂难安。"
                                },
                                {
                                    "id": "722480333",
                                    "speaker": "阿倍良久",
                                    "text": "此处本应供奉吾之圣冠，但是早已朽坏…恐怕这也是为何吾念头滞涩的原因。"
                                },
                                {
                                    "id": "722480334",
                                    "speaker": "阿倍良久",
                                    "text": "长此以往，恐怕连保持现在的状态都相当困难…"
                                },
                                {
                                    "id": "722480335",
                                    "speaker": "阿倍良久",
                                    "text": "但好在这些供奉品——这些贡品能代替残躯与衣冠，承载吾一丝念想。"
                                },
                                {
                                    "id": "722480336",
                                    "speaker": "阿倍良久",
                                    "text": "劳烦汝将之取走。"
                                },
                                {
                                    "id": "722480337",
                                    "speaker": "阿倍良久",
                                    "text": "不过供奉之路上有多重险阻，虽有冒犯之嫌，但也希望汝能接受一次考验…"
                                },
                                {
                                    "id": "722480338",
                                    "speaker": "派蒙",
                                    "text": "考验？什么考验？"
                                },
                                {
                                    "id": "722480339",
                                    "speaker": "阿倍良久",
                                    "text": "就请汝击败周围这些困守吾残魂的怪物吧…"
                                },
                                {
                                    "id": "722480340",
                                    "speaker": "阿倍良久",
                                    "text": "此事凶险，旅者啊，若汝准备好了，再与吾说吧。"
                                }
                            ]
                        },
                        {
                            "id": "722480325",
                            "text": "我这里有应急食…",
                            "response": [
                                {
                                    "id": "722480326",
                                    "speaker": "派蒙",
                                    "text": "喂！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7224802",
            "objective": "开启残魂的试炼",
            "dialogues": [
                {
                    "id": "722480501",
                    "speaker": "Player",
                    "text": "准备好了。"
                },
                {
                    "id": "722480502",
                    "speaker": "阿倍良久",
                    "text": "那就祝汝……武运昌隆。"
                }
            ]
        },
        {
            "id": "7224803",
            "objective": "(test)挑战开始,失败回滚$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7224804",
            "objective": "从残魂处取得供奉之物",
            "dialogues": [
                {
                    "id": "722480201",
                    "speaker": "阿倍良久",
                    "text": "啊…若是当时白夜国有如汝这般的勇士，也不会…"
                },
                {
                    "id": "722480202",
                    "speaker": "阿倍良久",
                    "text": "唉，此事若成，那吾也可了却心愿。"
                },
                {
                    "id": "722480203",
                    "speaker": "阿倍良久",
                    "text": "一定要、一定要将这些寄托吾念的贡品拿去供奉，供奉在我幽禁之所。如此才能…"
                },
                {
                    "id": "722480204",
                    "speaker": "派蒙",
                    "text": "如此才能什么？"
                },
                {
                    "id": "722480205",
                    "speaker": "阿倍良久",
                    "text": "如此才能…如此才能…"
                },
                {
                    "id": "722480206",
                    "speaker": "派蒙",
                    "text": "唔，这位残魂先生看上去失魂落魄，说什么都没反应了…"
                },
                {
                    "id": "722480207",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，那就先带上贡品吧。"
                },
                {
                    "id": "722480208",
                    "speaker": "派蒙",
                    "text": "不过残魂先生被幽禁在的高处，到底是什么地方呢？"
                }
            ]
        },
        {
            "id": "7224806",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "722480601",
                    "speaker": "Player",
                    "text": "不，还需要准备一下。"
                },
                {
                    "id": "722480602",
                    "speaker": "阿倍良久",
                    "text": "那就静候汝之佳音了。"
                }
            ]
        }
    ]
}