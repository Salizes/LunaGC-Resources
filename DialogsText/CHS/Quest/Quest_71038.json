    "talks": [
        {
            "id": "7103801",
            "objective": "隔天隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7103802",
            "objective": "与焦急的瑾武对话",
            "dialogues": [
                {
                    "id": "710380201",
                    "speaker": "瑾武",
                    "text": "又是志琼那家伙，她去回收信标了…但现在还没回来。"
                },
                {
                    "id": "710380202",
                    "speaker": "瑾武",
                    "text": "本来我也知道她那喜欢到处乱跑的臭毛病，给她多预留了三个小时回程…可现在都已经至少五六个小时了…"
                },
                {
                    "id": "710380203",
                    "speaker": "瑾武",
                    "text": "那个孩子很尊敬你，还请你帮忙找找她吧。我可不希望再有人在我眼皮底下出事了。"
                },
                {
                    "id": "710380204",
                    "speaker": "派蒙",
                    "text": "嗨呀！这家伙怎么回事啦！怎么又跑丢了！",
                    "choices": [
                        {
                            "id": "710380205",
                            "text": "好的，我这就去。",
                            "response": [
                                {
                                    "id": "710380207",
                                    "speaker": "瑾武",
                                    "text": "啊，对了！真是的，最重要的信息忘记告诉你了。"
                                },
                                {
                                    "id": "710380208",
                                    "speaker": "瑾武",
                                    "text": "她可能不会走太远，但会去哪里呢…"
                                },
                                {
                                    "id": "710380209",
                                    "speaker": "派蒙",
                                    "text": "好啦，瑾武姐不要着急，我们去昨天布置信标的地方看看吧！"
                                },
                                {
                                    "id": "710380210",
                                    "speaker": "Player",
                                    "text": "派蒙说的没错。"
                                },
                                {
                                    "id": "710380211",
                                    "speaker": "瑾武",
                                    "text": "嗯…就这么办。如果找到那孩子的话…请尽快告诉我。"
                                }
                            ]
                        },
                        {
                            "id": "710380206",
                            "text": "她可能会在哪里？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103816",
            "objective": "隐藏判断瑾武是否说过闲置$HIDDEN",
            "dialogues": [
                {
                    "id": "710380301",
                    "speaker": "瑾武",
                    "text": "志琼她怎么样？你找到她了吗？",
                    "choices": [
                        {
                            "id": "710380302",
                            "text": "我还在找。",
                            "response": [
                                {
                                    "id": "710380304",
                                    "speaker": "瑾武",
                                    "text": "嗯…还请尽快找到她为好，如果出什么事的话…"
                                }
                            ]
                        },
                        {
                            "id": "710380303",
                            "text": "还没有找到她。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103803",
            "objective": "去信标放置处寻找志琼",
            "dialogues": []
        },
        {
            "id": "7103804",
            "objective": "去信标放置处寻找志琼",
            "dialogues": [
                {
                    "id": "710380401",
                    "speaker": "Player",
                    "text": "你还能走路吗？"
                },
                {
                    "id": "710380403",
                    "speaker": "志琼",
                    "text": "对不起…对不起…瑾武姐…还有…咳咳…"
                },
                {
                    "id": "710380406",
                    "speaker": "志琼",
                    "text": "请你们不要…咳咳…哈…不要这样看着我…请不要对我们失望…"
                },
                {
                    "id": "710380407",
                    "speaker": "志琼",
                    "text": "金色的城…黑色的高阙…咳咳…！天上下来的使者们离开了…"
                },
                {
                    "id": "710380404",
                    "speaker": "派蒙",
                    "text": "不要说胡话啦！你这个人呀…"
                }
            ]
        },
        {
            "id": "7103805",
            "objective": "去信标放置处寻找志琼",
            "dialogues": []
        },
        {
            "id": "7103806",
            "objective": "去信标放置处寻找志琼",
            "dialogues": [
                {
                    "id": "710380601",
                    "speaker": "瑾武",
                    "text": "海迪夫给她开了些药…志琼恢复了一点意识，但她什么也不愿意跟我说。"
                },
                {
                    "id": "710380602",
                    "speaker": "瑾武",
                    "text": "你们知道她是怎么回事吗？好好的一个人，怎么会变成这样？"
                },
                {
                    "id": "710380603",
                    "speaker": "Player",
                    "text": "我们发现她时，她被困在了黑泥里。"
                },
                {
                    "id": "710380604",
                    "speaker": "派蒙",
                    "text": "对呀对呀，幸好我们及时把她救出来了！"
                },
                {
                    "id": "710380605",
                    "speaker": "瑾武",
                    "text": "……"
                },
                {
                    "id": "710380606",
                    "speaker": "瑾武",
                    "text": "算了，志琼现在最需要休息。请替我把这碗汤趁热递给她吧。"
                },
                {
                    "id": "710380607",
                    "speaker": "瑾武",
                    "text": "虽然不太会做饭，照顾矿工的事情反正我也没少做过。还没人敢嫌弃我的手艺。"
                },
                {
                    "id": "710380608",
                    "speaker": "瑾武",
                    "text": "好了，去吧，看看志琼好些了吗。"
                },
                {
                    "id": "710380609",
                    "speaker": "瑾武",
                    "text": "我需要跟沐宁反映一下，志琼不能留在地下了。"
                }
            ]
        },
        {
            "id": "7103807",
            "objective": "去信标放置处寻找志琼",
            "dialogues": [
                {
                    "id": "710380701",
                    "speaker": "志琼",
                    "text": "咳咳…！咳咳…抱歉…"
                },
                {
                    "id": "710380702",
                    "speaker": "派蒙",
                    "text": "你也知道抱歉哇！到处乱跑的时候怎么就没想过要麻烦我们呢！"
                },
                {
                    "id": "710380703",
                    "speaker": "Player",
                    "text": "好了，派蒙…"
                },
                {
                    "id": "710380704",
                    "speaker": "志琼",
                    "text": "咳咳…哈…是…失足，是不小心…失足了…有点好笑…哈哈…对吧？"
                },
                {
                    "id": "710380705",
                    "speaker": "派蒙",
                    "text": "好笑什么啦！你就不拿自己的生命当回事吗！"
                },
                {
                    "id": "710380706",
                    "speaker": "Player",
                    "text": "你需要休息，瑾武姐给你做了汤。"
                }
            ]
        },
        {
            "id": "7103810",
            "objective": "击败志琼周围的怪物",
            "dialogues": []
        },
        {
            "id": "7103811",
            "objective": "与志琼对话",
            "dialogues": [
                {
                    "id": "710380408",
                    "speaker": "派蒙",
                    "text": "哇啊！这家伙状态太不妙啦！我们快把她带回去吧！",
                    "choices": [
                        {
                            "id": "710380401",
                            "text": "你还能走路吗？"
                        },
                        {
                            "id": "710380402",
                            "text": "别害怕，我带你回去。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103817",
            "objective": "2隐藏判断瑾武是否说过闲置$HIDDEN",
            "dialogues": [
                {
                    "id": "710381601",
                    "speaker": "瑾武",
                    "text": "……"
                },
                {
                    "id": "710381602",
                    "speaker": "瑾武",
                    "text": "…？啊，抱歉，我在想事情。抱歉…"
                },
                {
                    "id": "710381603",
                    "speaker": "瑾武",
                    "text": "志琼那孩子，我要好好和她谈谈才行…"
                },
                {
                    "id": "710381604",
                    "speaker": "瑾武",
                    "text": "我在矿上工作很久了，不是没有见过这样的孩子…"
                },
                {
                    "id": "710381605",
                    "speaker": "瑾武",
                    "text": "有太多不成熟的孩子，把冒险当做了不得的目标去追逐，最终却落得愿望破碎离散的下场…为此追悔莫及。"
                },
                {
                    "id": "710381606",
                    "speaker": "瑾武",
                    "text": "但我又能评判什么呢？唉…扎根在石缝里，长在岩间的琉璃袋，怎么去评价鸟儿的活法呢？"
                },
                {
                    "id": "710381607",
                    "speaker": "瑾武",
                    "text": "但是，我怎么放心…咳咳，或许阻拦她终究是不对的…她已经是能照顾自己的大人了，是吧？",
                    "choices": [
                        {
                            "id": "710381608",
                            "text": "没错，她不会有事的。",
                            "response": [
                                {
                                    "id": "710381610",
                                    "speaker": "瑾武",
                                    "text": "是啊…希望如此，希望如此。"
                                }
                            ]
                        },
                        {
                            "id": "710381609",
                            "text": "她不会为自己的选择后悔的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7103813",
            "objective": "与瑾武对话",
            "dialogues": []
        },
        {
            "id": "7103814",
            "objective": "将瑾武的汤交给志琼",
            "dialogues": []
        },
        {
            "id": "7103815",
            "objective": "与醒来的志琼对话",
            "dialogues": [
                {
                    "id": "710380707",
                    "speaker": "志琼",
                    "text": "是瑾武姐的手艺…？谢谢你们…请替我谢谢瑾武姐她们。"
                },
                {
                    "id": "710380708",
                    "speaker": "志琼",
                    "text": "没事的，我睡一觉就会好多了…"
                },
                {
                    "id": "710380709",
                    "speaker": "志琼",
                    "text": "实在对不起…咳咳…请你们过一阵子再回来吧…"
                }
            ]
        },
        {
            "id": "7103604",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710360401",
                    "speaker": "志琼",
                    "text": "你好，前辈！请找个地方坐坐吧。"
                },
                {
                    "id": "710360402",
                    "speaker": "Player",
                    "text": "关于冒险的事…"
                },
                {
                    "id": "710360403",
                    "speaker": "志琼",
                    "text": "你是想问，为什么我之前那么倔强，让大家如此费心吗？哈哈…我知道错啦，请不要再教训我了…"
                },
                {
                    "id": "710360404",
                    "speaker": "志琼",
                    "text": "不过话说回来，对「危险」的痴迷，或许是我们这些冒险家的本性吧。"
                },
                {
                    "id": "710360405",
                    "speaker": "志琼",
                    "text": "毕竟我们生来拥有坚韧的脊梁，轻捷的四肢…一想到身怀利器却安于无风无浪的一生，就总觉得不甘心呀。"
                },
                {
                    "id": "710360406",
                    "speaker": "志琼",
                    "text": "至于致命的风险，我也不是没有考虑过，但…嗯，我可以问你一个问题吗？"
                },
                {
                    "id": "710360407",
                    "speaker": "Player",
                    "text": "请说吧。"
                },
                {
                    "id": "710360408",
                    "speaker": "志琼",
                    "text": "蒙德的大冒险家斯坦利因他横穿烬寂海的壮举而闻名…他在这场冒险中失去了自己的挚友。"
                },
                {
                    "id": "710360409",
                    "speaker": "志琼",
                    "text": "因为他的这场冒险，那位死去的挚友…尽管很少有人知道他的名字是什么，但关于他的记忆却在冒险家中间流传至今。"
                },
                {
                    "id": "710360410",
                    "speaker": "志琼",
                    "text": "我在想…哈哈，请前辈不要笑我幼稚。斯坦利那位再不归来的友人…会不会并未逝去，而是正在真正地「活着」呢？",
                    "choices": [
                        {
                            "id": "710360411",
                            "text": "唯有生命本身才最重要。",
                            "response": [
                                {
                                    "id": "710360412",
                                    "speaker": "志琼",
                                    "text": "但为人所铭记这件事本身…即使事业令他早夭，不也是一种生命的延续吗？"
                                },
                                {
                                    "id": "710360413",
                                    "speaker": "志琼",
                                    "text": "就这样借助他人的憧憬与纪念，评价与凝视…以另一种方式活在众人中间。"
                                },
                                {
                                    "id": "710360422",
                                    "speaker": "Player",
                                    "text": "请不要太过在意别人的看法。"
                                },
                                {
                                    "id": "710360423",
                                    "speaker": "志琼",
                                    "text": "已经有很多人这样劝过我了，「做你自己就好」「管好自己的事情就行了」…表面上是开导人的话，终究只是劝人放弃。"
                                },
                                {
                                    "id": "710360424",
                                    "speaker": "志琼",
                                    "text": "其实我之前就说过了，我的冒险，不是为了别人…甚至不是为了自己。"
                                },
                                {
                                    "id": "710360425",
                                    "speaker": "志琼",
                                    "text": "嗯…你有这样想过吗，前辈…？"
                                },
                                {
                                    "id": "710360426",
                                    "speaker": "志琼",
                                    "text": "这个世界是由众神摆布的…但我们作为凡人，即使没有神灵恩赐的「眼」，也同样拥有不甘于安宁与遗忘的执着。"
                                },
                                {
                                    "id": "710360427",
                                    "speaker": "志琼",
                                    "text": "我相信这份不甘的心情并非毫无意义，所以才会不要命地跑去探索那些险地。毕竟呀…"
                                },
                                {
                                    "id": "710360428",
                                    "speaker": "志琼",
                                    "text": "以弱小之身与纵使神灵也为之恐惧的永恒角力，这才是人之所以为「人」的理由…我是这样相信的。",
                                    "choices": [
                                        {
                                            "id": "710360429",
                                            "text": "但赋予冒险意义的不仅你自己一人。",
                                            "response": [
                                                {
                                                    "id": "710360430",
                                                    "speaker": "志琼",
                                                    "text": "唔…我明白的。我不会忘记大家的帮助，不会忘记给前辈带来的麻烦的…毕竟这场冒险并不仅是我一个人的事。"
                                                },
                                                {
                                                    "id": "710360437",
                                                    "speaker": "志琼",
                                                    "text": "哈哈，这不就是冒险家嘛！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710360432",
                                            "text": "就这么想要逞英雄吗？",
                                            "response": [
                                                {
                                                    "id": "710360433",
                                                    "speaker": "志琼",
                                                    "text": "比起前辈来，我差得可太远啦…比起想做英雄，唔…不如说是，「想活着的人才不怕会死于非命」吧？"
                                                },
                                                {
                                                    "id": "710360434",
                                                    "speaker": "志琼",
                                                    "text": "这话是一个须弥的前辈告诉我的，她也是在「镀金旅团」听来的就是啦。"
                                                },
                                                {
                                                    "id": "710360435",
                                                    "speaker": "志琼",
                                                    "text": "我觉得很有道理…"
                                                },
                                                {
                                                    "id": "710360436",
                                                    "speaker": "派蒙",
                                                    "text": "不如说是在一个劲地追求不吉利的倒霉事呢…这个人呀！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710360414",
                            "text": "能被人记住，也是一种成功吧。",
                            "response": [
                                {
                                    "id": "710360415",
                                    "speaker": "志琼",
                                    "text": "唔…我从没想过过一场「成功」的人生啦。相反，即使「失败」，只要能让众人都留下印象就好。"
                                },
                                {
                                    "id": "710360416",
                                    "speaker": "志琼",
                                    "text": "至少有人会说：「志琼这个人，也是挑战过层岩巨渊的啊！」"
                                },
                                {
                                    "id": "710360417",
                                    "speaker": "志琼",
                                    "text": "至少不会像那些牺牲在无人之地的前辈一样…至少不会像现在的我一样，被人遗忘。"
                                }
                            ]
                        },
                        {
                            "id": "710360418",
                            "text": "从来没想过这种问题。",
                            "response": [
                                {
                                    "id": "710360419",
                                    "speaker": "志琼",
                                    "text": "这样吗…？或许那是因为像前辈这样的外来人，无论在哪里出现都会自然而然地成为视线的焦点吧。"
                                },
                                {
                                    "id": "710360420",
                                    "speaker": "志琼",
                                    "text": "就像含着金汤匙出生的孩子，也只会把贫穷当成一场并非必需的刺激冒险一样。"
                                },
                                {
                                    "id": "710360421",
                                    "speaker": "志琼",
                                    "text": "啊，抱歉…我不是那个意思，我只是说…没什么。当我没有问吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}