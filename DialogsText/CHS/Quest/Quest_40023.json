    "talks": [
        {
            "id": "4002301",
            "objective": "拜访「式大将」",
            "dialogues": [
                {
                    "id": "400230101",
                    "speaker": "「式大将」",
                    "text": "旅行者，你们来了！"
                },
                {
                    "id": "400230102",
                    "speaker": "「式大将」",
                    "text": "我向天领奉行说明了情况，出示了当年的公文。他们总算相信了——我和「诀箓阴阳寮」是清白的。"
                },
                {
                    "id": "400230103",
                    "speaker": "派蒙",
                    "text": "太好了，这样一来，「式大将」就能专注于自己的使命了。"
                },
                {
                    "id": "400230104",
                    "speaker": "「式大将」",
                    "text": "没错，现在「诀箓阴阳寮」被我复原成了最初的模样，修炼武艺的纯粹秘境。"
                },
                {
                    "id": "400230105",
                    "speaker": "「式大将」",
                    "text": "这座秘境运转一段时间后，可能再次耗尽符法之力。到时我会将它封闭，让它慢慢积攒力量。"
                },
                {
                    "id": "400230109",
                    "speaker": "「式大将」",
                    "text": "机会难得，想来挑战一下吗？",
                    "choices": [
                        {
                            "id": "400230106",
                            "text": "我准备好了！",
                            "response": [
                                {
                                    "id": "400230108",
                                    "speaker": "派蒙",
                                    "text": "嗯！我也很想见识一下！"
                                }
                            ]
                        },
                        {
                            "id": "400230107",
                            "text": "热血沸腾了！"
                        }
                    ]
                }
            ]
        }
    ]
