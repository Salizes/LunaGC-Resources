        },
        {
            "id": "7101224",
            "objective": "与亨利莫顿对话",
            "dialogues": [
                {
                    "id": "710122401",
                    "speaker": "亨利莫顿",
                    "text": "那个家伙是从哪冒出来的！之前完全没有看见！"
                },
                {
                    "id": "710122402",
                    "speaker": "亨利莫顿",
                    "text": "你是怎么把那大家伙弄出来的？"
                },
                {
                    "id": "710122403",
                    "speaker": "Player",
                    "text": "是这样…"
                },
                {
                    "id": "710122404",
                    "speaker": "亨利莫顿",
                    "text": "果然是「时与风」啊…"
                },
                {
                    "id": "710122405",
                    "speaker": "亨利莫顿",
                    "text": "在那座孤岛上，还有一座和这个一模一样的日晷，对吧？"
                },
                {
                    "id": "710122406",
                    "speaker": "亨利莫顿",
                    "text": "而且，连解谜的方式都一模一样。这两座日晷，还有这两个地方，一定有着某种联系…"
                },
                {
                    "id": "710122407",
                    "speaker": "亨利莫顿",
                    "text": "不行，我得找个办法，赶紧去那座岛上看看…"
                },
                {
                    "id": "710122408",
                    "speaker": "亨利莫顿",
                    "text": "谢谢你旅行者，等我做好准备之后就去找你，我们一起再去那座无人岛上一趟。"
                }
            ]
        },
        {
            "id": "7101221",
            "objective": "test废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7101222",
            "objective": "test废弃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7101211",
            "objective": "检测固定时间刷新元素紊乱-无人岛部分$HIDDEN",
            "dialogues": [
                {
                    "id": "710121101",
                    "speaker": "亨利莫顿",
                    "text": "时与风…那家伙到底研究出了什么东西？",
                    "choices": [
                        {
                            "id": "710121102",
                            "text": "时与风？",
                            "response": [
                                {
                                    "id": "710121103",
                                    "speaker": "亨利莫顿",
                                    "text": "哦，那是我朋友给我写的最后一封信里提到的词。"
                                },
                                {
                                    "id": "710121104",
                                    "speaker": "亨利莫顿",
                                    "text": "他说，「时与风」里埋藏着一个关于蒙德的秘密。"
                                },
                                {
                                    "id": "710121105",
                                    "speaker": "亨利莫顿",
                                    "text": "不过，我这个本地人都没怎么听过这个词，这家伙到底是从哪知道的…"
                                }
                            ]
                        },
                        {
                            "id": "710121106",
                            "text": "你在须弥学习过？",
                            "response": [
                                {
                                    "id": "710121107",
                                    "speaker": "亨利莫顿",
                                    "text": "对啊，虽然我是蒙德人，但一直在须弥教令院学习，呆在教令院的时间，反倒是比呆在蒙德的时间更长。"
                                },
                                {
                                    "id": "710121108",
                                    "speaker": "亨利莫顿",
                                    "text": "你是想知道教令院里面的情况吗？倒也不是秘密啦，里面…呃…怎么说呢。"
                                },
                                {
                                    "id": "710121109",
                                    "speaker": "亨利莫顿",
                                    "text": "都是一群…怪人？这种形容有点失礼…应该说是一群「让人印象深刻」的人吧…"
                                },
                                {
                                    "id": "710121110",
                                    "speaker": "亨利莫顿",
                                    "text": "如果你之后有机会去教令院，可以自己去体验一下，不过…体验归体验，别在那呆太久了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
