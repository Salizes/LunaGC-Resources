    "talks": [
        {
            "id": "7101201",
            "objective": "test完成对话·日晷·分支1（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "710120101",
                    "speaker": "残破的刻字",
                    "text": "「风带来了新的故事，时间使之成为神话。」"
                },
                {
                    "id": "710120102",
                    "speaker": "派蒙",
                    "text": "这句话是什么意思啊…完全没有头绪。"
                },
                {
                    "id": "710120103",
                    "speaker": "派蒙",
                    "text": "唔，不过，这个地方看起来似乎有什么秘密…"
                },
                {
                    "id": "710120104",
                    "speaker": "派蒙",
                    "text": "我们去周围看看吧，说不定会有什么线索呢。"
                }
            ]
        },
        {
            "id": "7101202",
            "objective": "驱散「风」的聚集点",
            "dialogues": [
                {
                    "id": "710120201",
                    "speaker": "残破的刻字",
                    "text": "「风带来了新的故事，时间使之成为神话。」"
                },
                {
                    "id": "710120202",
                    "speaker": "派蒙",
                    "text": "那本笔记里提到的日晷，应该就是这一座吧。"
                },
                {
                    "id": "710120203",
                    "speaker": "派蒙",
                    "text": "不过，这座日晷到底有什么特别的地方呢…"
                },
                {
                    "id": "710120204",
                    "speaker": "派蒙",
                    "text": "唔…我们再仔细看看那本笔记吧。"
                }
            ]
        },
