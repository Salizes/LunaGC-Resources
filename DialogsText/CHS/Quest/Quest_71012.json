        {
            "id": "7101209",
            "objective": "追击狂风之核",
            "dialogues": []
        },
        {
            "id": "7101210",
            "objective": "寻找狂风之核",
            "dialogues": [
                {
                    "id": "710121001",
                    "speaker": "亨利莫顿",
                    "text": "嗯？旅行者，你来这里有事吗？"
                },
                {
                    "id": "710121002",
                    "speaker": "Player",
                    "text": "关于狂风之核…"
                },
                {
                    "id": "710121003",
                    "speaker": "亨利莫顿",
                    "text": "狂风之核？我一直在这附近呆着，没有见过类似的东西啊，就是刚才莫名其妙刮过来一阵大风…"
                },
                {
                    "id": "710121004",
                    "speaker": "亨利莫顿",
                    "text": "不过，这里肯定没有出现过狂风之核。如果有那种大家伙，我肯定忘不了。",
                    "choices": [
                        {
                            "id": "710121005",
                            "text": "好吧…",
                            "response": [
                                {
                                    "id": "710121006",
                                    "speaker": "亨利莫顿",
                                    "text": "你就相信我吧，要是有那种家伙来这里打乱我的研究，我肯定忘不了的。"
                                },
                                {
                                    "id": "710121009",
                                    "speaker": "亨利莫顿",
                                    "text": "准确地说…应该是和我的一位朋友一起进行的研究。"
                                },
                                {
                                    "id": "710121010",
                                    "speaker": "亨利莫顿",
                                    "text": "我的那位朋友也是一位学者，曾经和我一同在须弥教令院里学习。"
                                },
                                {
                                    "id": "710121011",
                                    "speaker": "亨利莫顿",
                                    "text": "之后，他去做了考古学家，在世界上到处考察，我则继续在教令院里学习…"
                                },
                                {
                                    "id": "710121012",
                                    "speaker": "亨利莫顿",
                                    "text": "当他来蒙德的时候，还很兴奋地告诉我他正在蒙德的千风神殿考察。"
                                },
                                {
                                    "id": "710121013",
                                    "speaker": "亨利莫顿",
                                    "text": "还说什么「等我挖出了你家乡的秘密，绝对第一个就告诉你」。"
                                },
                                {
                                    "id": "710121014",
                                    "speaker": "亨利莫顿",
                                    "text": "之后他就突然没了音信，我托人给塞琉斯先生带了封信，拜托冒险家协会搜索我朋友的下落。"
                                },
                                {
                                    "id": "710121015",
                                    "speaker": "亨利莫顿",
                                    "text": "但一直没有任何消息传来，我就中断了在须弥的学习，自己赶了回来。"
                                },
                                {
                                    "id": "710121016",
                                    "speaker": "亨利莫顿",
                                    "text": "不过，这里也只有一座日晷，没有其他的线索了…"
                                },
                                {
                                    "id": "710121017",
                                    "speaker": "Player",
                                    "text": "关于那座岛上的日晷…"
                                },
                                {
                                    "id": "710121018",
                                    "speaker": "亨利莫顿",
                                    "text": "什么？居然还有一座一模一样的日晷，还是在一座海上的孤岛上？"
                                },
                                {
                                    "id": "710121019",
                                    "speaker": "亨利莫顿",
                                    "text": "哦，我记起来了，天气好的时候，我还看见过那座岛。"
                                },
                                {
                                    "id": "710121020",
                                    "speaker": "亨利莫顿",
                                    "text": "等等，你说…在那个岛上的日晷旁边，发现了一本笔记？难道说那家伙去过那里…"
                                },
                                {
                                    "id": "710121021",
                                    "speaker": "亨利莫顿",
                                    "text": "谢谢你，我有机会的话，会去那座孤岛上看看，现在我还是想先把这里研究明白。"
                                },
                                {
                                    "id": "710121022",
                                    "speaker": "亨利莫顿",
                                    "text": "我要继续研究了，如果你有兴趣，可以去翻翻我的研究笔记，我就放在那里了。"
                                },
                                {
                                    "id": "710121023",
                                    "speaker": "亨利莫顿",
                                    "text": "说不定上面有什么东西，会对你有帮助。"
                                }
                            ]
                        },
                        {
                            "id": "710121007",
                            "text": "你在这做什么？",
                            "response": [
                                {
                                    "id": "710121008",
                                    "speaker": "亨利莫顿",
                                    "text": "我？我正在这里做一些研究。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
