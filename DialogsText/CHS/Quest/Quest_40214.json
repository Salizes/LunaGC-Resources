    "talks": [
        {
            "id": "4021401",
            "objective": "与萨林对话",
            "dialogues": [
                {
                    "id": "766530301",
                    "speaker": "萨林",
                    "text": "您总算来了，爱诺…女士。"
                },
                {
                    "id": "766530302",
                    "speaker": "萨林",
                    "text": "#嗯？这不是大名鼎鼎的{NICKNAME}和{M#他的}{F#她的}精灵旅伴吗？"
                },
                {
                    "id": "766530303",
                    "speaker": "派蒙",
                    "text": "你认识我们？"
                },
                {
                    "id": "766530304",
                    "speaker": "萨林",
                    "text": "我叫萨林，是挪德卡莱冒险家协会的分会长。考虑一下你们在冒险家协会内部的声望吧，我不认识你们的话算是严重失职呢。"
                },
                {
                    "id": "766530305",
                    "speaker": "派蒙",
                    "text": "哦，原来是这样！"
                },
                {
                    "id": "766530306",
                    "speaker": "爱诺",
                    "text": "原来你们认识，不过我还是要确认一下，你的订单是哪个？"
                },
                {
                    "id": "766530307",
                    "speaker": "派蒙",
                    "text": "我也蛮好奇的，冒险家协会要找爱诺帮什么忙？"
                },
                {
                    "id": "766530308",
                    "speaker": "萨林",
                    "text": "唉…你们知道的，冒险家们在野外遇到的一大问题就是各种拦路的敌人。"
                },
                {
                    "id": "766530309",
                    "speaker": "萨林",
                    "text": "要是在其他国家，协会还能与当地的管理者合作，为冒险家们提供一些保护。但在挪德卡莱这种地方，协会就只能靠自己了。"
                },
                {
                    "id": "766530310",
                    "speaker": "萨林",
                    "text": "不久前我想到了一个点子——设计一种可以随身携带的防身装置，让那些不擅长战斗的冒险家也可以击退强大的敌人！"
                },
                {
                    "id": "766530311",
                    "speaker": "萨林",
                    "text": "可惜最终失败了…我终究没有这方面的才华，只能求助于专业人士。"
                },
                {
                    "id": "766530312",
                    "speaker": "爱诺",
                    "text": "我想起这个订单了，点子很好，设计太差。"
                },
                {
                    "id": "766530313",
                    "speaker": "萨林",
                    "text": "所以才要拜托爱诺…女士啊！"
                },
                {
                    "id": "766530314",
                    "speaker": "爱诺",
                    "text": "这个订单的难点在于，他设计的防身装置使用了来自其他国家的技术，无法适应挪德卡莱的月矩力环境。"
                },
                {
                    "id": "766530315",
                    "speaker": "爱诺",
                    "text": "这个订单需要我们做的事并不复杂，主要就是带着他的装置找一些敌人进行测试，然后改进设计。"
                },
                {
                    "id": "766530316",
                    "speaker": "爱诺",
                    "text": "测试的时候，我也能顺便收集一些与月矩力环境有关的数据，所以这个订单很划算。"
                },
                {
                    "id": "766530317",
                    "speaker": "爱诺",
                    "text": "不过，自己的身手一定要过关。万一这种装置不顶用，就得靠自己了。",
                    "choices": [
                        {
                            "id": "766530318",
                            "text": "问题不大。",
                            "response": [
                                {
                                    "id": "766530320",
                                    "speaker": "萨林",
                                    "text": "那就拜托各位了，有需要我的地方尽管说。成功之后，挪德卡莱冒险家协会一定会支付丰厚的报酬！"
                                }
                            ]
                        },
                        {
                            "id": "766530319",
                            "text": "我喜欢战斗！"
                        }
                    ]
                }
            ]
        }
    ]
}