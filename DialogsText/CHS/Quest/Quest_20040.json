        }
    },
    "talks": [
        {
            "id": "2004001",
            "objective": "与芬德修女对话",
            "dialogues": [
                {
                    "id": "200400101",
                    "speaker": "芬德",
                    "text": "唉，到底怎么过去呢…"
                },
                {
                    "id": "200400102",
                    "speaker": "芬德",
                    "text": "哦…您找我有什么事吗？"
                },
                {
                    "id": "200400103",
                    "speaker": "Player",
                    "text": "您在这做什么？"
                },
                {
                    "id": "200400104",
                    "speaker": "芬德",
                    "text": "我正准备去望风角的瞭望塔，去看看海上是不是有风暴在聚集。"
                },
                {
                    "id": "200400105",
                    "speaker": "芬德",
                    "text": "可是前面有一群怪物挡住了路…我在思考怎么过去。"
                },
                {
                    "id": "200400106",
                    "speaker": "芬德",
                    "text": "哦，不用担心，我没有让您代我去瞭望的意思。"
                },
                {
                    "id": "200400107",
                    "speaker": "芬德",
                    "text": "这是我的职责，也是我个人的坚持而已。"
                },
                {
                    "id": "200400108",
                    "speaker": "芬德",
                    "text": "您忙您的去吧，我自己再好好想想办法…"
                }
            ]
        },
        {
            "id": "2004002",
            "objective": "清剿烽火台上的魔物",
            "dialogues": [
                {
                    "id": "200400201",
                    "speaker": "芬德",
                    "text": "您还有什么事吗？"
                },
                {
                    "id": "200400202",
                    "speaker": "Player",
                    "text": "前面已经安全了。"
                },
                {
                    "id": "200400203",
                    "speaker": "芬德",
                    "text": "咦？感谢风神…"
                },
                {
                    "id": "200400204",
                    "speaker": "芬德",
                    "text": "不，不对，抱歉，我应该感谢的是您才对。"
                },
                {
                    "id": "200400205",
                    "speaker": "芬德",
                    "text": "我该怎么回报您呢…哦，对了。"
                },
                {
                    "id": "200400206",
                    "speaker": "芬德",
                    "text": "请您来瞭望塔顶吧，我在那等着您。"
                }
            ]
        },
        {
            "id": "2004003",
            "objective": "与芬德修女对话",
            "dialogues": []
        },
        {
            "id": "2004004",
            "objective": "登上瞭望塔",
            "dialogues": [
                {
                    "id": "200400401",
                    "speaker": "芬德",
                    "text": "嗯…今天也是风平浪静的一天。"
                },
                {
                    "id": "200400402",
                    "speaker": "芬德",
                    "text": "我的家族受到温妮莎大人命令，世代在此为蒙德守望风暴，"
                },
                {
                    "id": "200400403",
                    "speaker": "芬德",
                    "text": "虽然自从有了巴巴托斯大人的庇护，蒙德再也没有受到风暴的侵扰，瞭望台也逐渐废置了。"
                },
                {
                    "id": "200400404",
                    "speaker": "芬德",
                    "text": "但即使是这样，我还是会不由自主地想去瞭望塔上看看。",
                    "choices": [
                        {
                            "id": "200400405",
                            "text": "辛苦了。",
                            "response": [
                                {
                                    "id": "200400406",
                                    "speaker": "芬德",
                                    "text": "谢谢你，但是说到我的「职责」…"
                                },
                                {
                                    "id": "200400407",
                                    "speaker": "芬德",
                                    "text": "我倒宁愿永远不去真正履行它。"
                                },
                                {
                                    "id": "200400410",
                                    "speaker": "芬德",
                                    "text": "好了，谢谢您帮我，这些风车菊是给您的。"
                                },
                                {
                                    "id": "200400411",
                                    "speaker": "芬德",
                                    "text": "在之前，我的家族常以风车菊的生长程度，来判断一个地区的风力大小。"
                                },
                                {
                                    "id": "200400412",
                                    "speaker": "芬德",
                                    "text": "丝毫无风的地方，或者暴风侵袭的地方，都不会有风车菊存在。"
                                },
                                {
                                    "id": "200400413",
                                    "speaker": "芬德",
                                    "text": "只有在蒙德这样温柔的风中，它才会顺利地生长。"
                                },
                                {
                                    "id": "200400414",
                                    "speaker": "芬德",
                                    "text": "真希望，它们能一直这么顺利地生长下去啊…"
                                }
                            ]
                        },
                        {
                            "id": "200400408",
                            "text": "是很辛苦的历史啊…",
                            "response": [
                                {
                                    "id": "200400409",
                                    "speaker": "芬德",
                                    "text": "是的，希望那段历史永远不再重演。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2004007",
            "objective": "与芬德修女对话",
            "dialogues": []
        },
        {
            "id": "2004003",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200400301",
                    "speaker": "芬德",
                    "text": "唔…如果跑得够快，能不能直接爬上去呢…"
                }
            ]
        },
        {
            "id": "2004005",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200400501",
                    "speaker": "派蒙",
                    "text": "虽然她话是这么说，但是前面的怪物很多呢。"
                },
                {
                    "id": "200400502",
                    "speaker": "派蒙",
                    "text": "我们去帮芬德小姐扫除一下周围吧。"
                },
                {
                    "id": "200400503",
                    "speaker": "派蒙",
                    "text": "看她认真的样子，搞不好会想着直接冲过去…",
                    "choices": [
                        {
                            "id": "200400504",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "200400506",
                                    "speaker": "派蒙",
                                    "text": "嗯，认真的人就应该得到帮助呢。"
                                }
                            ]
                        },
                        {
                            "id": "200400505",
                            "text": "真有人会认真到这种地步吗？",
                            "response": [
                                {
                                    "id": "200400507",
                                    "speaker": "派蒙",
                                    "text": "那种是最糟糕的情况啦。"
                                },
                                {
                                    "id": "200400508",
                                    "speaker": "派蒙",
                                    "text": "为了不让这种情况发生，我们快点去扫除魔物吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}