    "talks": [
        {
            "id": "7055101",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "705510101",
                    "speaker": "艾梅莉埃",
                    "text": "#下午好，{NICKNAME}。"
                },
                {
                    "id": "705510102",
                    "speaker": "艾梅莉埃",
                    "text": "…没想到，我会有幸在蒙德见识到你的「调和」才华。",
                    "choices": [
                        {
                            "id": "705510103",
                            "text": "艾梅莉埃小姐来旅行吗？",
                            "response": [
                                {
                                    "id": "705510105",
                                    "speaker": "艾梅莉埃",
                                    "text": "两者兼有。"
                                },
                                {
                                    "id": "705510106",
                                    "speaker": "艾梅莉埃",
                                    "text": "一位自称魔女的小姐，邀请我来经营她的小花铺。另外，我还接到了猫尾酒馆的委托，为该店调制了新的香氛。"
                                },
                                {
                                    "id": "705510107",
                                    "speaker": "艾梅莉埃",
                                    "text": "#以{NICKNAME}亲手调制的饮品为今天的忙碌划上句号，更是绝妙的收获。",
                                    "choices": [
                                        {
                                            "id": "705510108",
                                            "text": "那我可要使出拿手好戏！",
                                            "response": [
                                                {
                                                    "id": "705510110",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "相信你的选择。"
                                                },
                                                {
                                                    "id": "705510111",
                                                    "speaker": "Player",
                                                    "text": "（艾梅莉埃对香味的敏感性强于常人，如果产生了控制不当的复合香气，或许会让她觉得不妥？）"
                                                },
                                                {
                                                    "id": "705510112",
                                                    "speaker": "Player",
                                                    "text": "（总之，使用香气包容性较强的材料，适当加上枫丹风味吧。）"
                                                },
                                                {
                                                    "id": "705510113",
                                                    "speaker": "Player",
                                                    "text": "（那就先来一杯蒙德改进版的「七时柔灯」好了。）"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705510109",
                                            "text": "我会为你调一杯惊喜特饮！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705510104",
                            "text": "艾梅莉埃小姐来出差吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7055102",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7055103",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "705510301",
                    "speaker": "Player",
                    "text": "请品尝，这杯专为艾梅莉埃改进的「七时柔灯」。不过，暂时还没想好它的名字…"
                },
                {
                    "id": "705510302",
                    "speaker": "艾梅莉埃",
                    "text": "色彩更加清爽，散发而出的香气，也十分淡雅，符合青色的印象。"
                },
                {
                    "id": "705510303",
                    "speaker": "艾梅莉埃",
                    "text": "表面这层斑斓的细末，来自风车菊的花瓣和叶片吗？",
                    "choices": [
                        {
                            "id": "705510304",
                            "text": "是的，一眼就看准了！",
                            "response": [
                                {
                                    "id": "705510306",
                                    "speaker": "艾梅莉埃",
                                    "text": "味道肯定很不错…我试试哦。"
                                },
                                {
                                    "id": "705510307",
                                    "speaker": "艾梅莉埃",
                                    "text": "嗯…风车菊的花语是「看得见的风」。"
                                },
                                {
                                    "id": "705510308",
                                    "speaker": "艾梅莉埃",
                                    "text": "你不仅捕捉到了它们的形态，还将它们捎来的香气融入了这杯特调。"
                                },
                                {
                                    "id": "705510309",
                                    "speaker": "艾梅莉埃",
                                    "text": "我提议，这杯特调，就命名为「云风芳迹」。"
                                },
                                {
                                    "id": "705510310",
                                    "speaker": "艾梅莉埃",
                                    "text": "蒙德的云与风，在杯中旋绕，留下芬芳之痕。",
                                    "choices": [
                                        {
                                            "id": "705510311",
                                            "text": "不愧是香水专家…",
                                            "response": [
                                                {
                                                    "id": "705510313",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "是吗？可能是职业的习惯使然，你满意就好。"
                                                },
                                                {
                                                    "id": "705510314",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "接下来，容我慢慢品尝这杯特调。"
                                                },
                                                {
                                                    "id": "705510315",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "#十分感谢，{NICKNAME}。这次蒙德之行，还真是收获满满。"
                                                },
                                                {
                                                    "id": "705510316",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "这是迄今为止，我印象最深的一杯特调。"
                                                },
                                                {
                                                    "id": "705510317",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "返回枫丹后，我会尝试，根据记忆中此刻的印象，以香水和香氛的两种形式，分别再现你的这杯杰作。",
                                                    "choices": [
                                                        {
                                                            "id": "705510318",
                                                            "text": "我的荣幸！",
                                                            "response": [
                                                                {
                                                                    "id": "705510320",
                                                                    "speaker": "艾梅莉埃",
                                                                    "text": "调制完毕后，还请你赏光，来当这两种新品的首位客户。"
                                                                },
                                                                {
                                                                    "id": "705510321",
                                                                    "speaker": "艾梅莉埃",
                                                                    "text": "到时，枫丹廷见。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705510319",
                                                            "text": "好耶好耶！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705510312",
                                            "text": "命名很有格调！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705510305",
                            "text": "正是蒙德特色的花卉！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7055104",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7055105",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7055106",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "705510201",
                    "speaker": "Player",
                    "text": "先试试看，艾梅莉埃小姐？"
                },
                {
                    "id": "705510202",
                    "speaker": "艾梅莉埃",
                    "text": "你的动作真是赏心悦目…"
                },
                {
                    "id": "705510203",
                    "speaker": "艾梅莉埃",
                    "text": "嗯…这是一杯「七时柔灯」的本地版吧？",
                    "choices": [
                        {
                            "id": "705510204",
                            "text": "非常准确。",
                            "response": [
                                {
                                    "id": "705510206",
                                    "speaker": "艾梅莉埃",
                                    "text": "柔和淡雅，层次分明的口感，结合了几分蒙德特色的香气，风味相当亲切，也避开了可能让我感到不谐的味觉成分…"
                                },
                                {
                                    "id": "705510207",
                                    "speaker": "艾梅莉埃",
                                    "text": "其实，不用这么谨慎，对于跳出常理框架的风味物质，我也有着不错的接受能力。",
                                    "choices": [
                                        {
                                            "id": "705510208",
                                            "text": "看来现在这杯有点太传统了？",
                                            "response": [
                                                {
                                                    "id": "705510210",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "这杯非常不错，当然，如果能有一杯更「深刻」，加入了你个人独特理解，也能加深我对蒙德印象的特调，就完美无瑕了。"
                                                },
                                                {
                                                    "id": "705510211",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "我们可以放慢节奏，从闲谈中寻找灵感。"
                                                },
                                                {
                                                    "id": "705510212",
                                                    "speaker": "Player",
                                                    "text": "这是你刚买的花卉吗？"
                                                },
                                                {
                                                    "id": "705510213",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "是经营花铺的酬劳之一，重要的香水材料，帮我完成了猫尾酒馆的委托——"
                                                },
                                                {
                                                    "id": "705510214",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "许多年前，我研究过蒙德的塞西莉亚花，塞西莉亚花的香气，在一些领域内，直接成为了「蒙德」的代名词。"
                                                },
                                                {
                                                    "id": "705510215",
                                                    "speaker": "艾梅莉埃",
                                                    "text": "不过，这次情况特殊，有些猫儿不太习惯塞西莉亚花的气味，需要特别考虑它们的感受…",
                                                    "choices": [
                                                        {
                                                            "id": "705510216",
                                                            "text": "这次换用了什么植物香气呢？",
                                                            "response": [
                                                                {
                                                                    "id": "705510218",
                                                                    "speaker": "艾梅莉埃",
                                                                    "text": "是风车菊。"
                                                                },
                                                                {
                                                                    "id": "705510219",
                                                                    "speaker": "艾梅莉埃",
                                                                    "text": "将风车菊的植株分部位研磨萃取后，适当混合花冠与叶片的香气。有蜜酒般的酣甜，但也强调了花卉枝叶中的清新气息。"
                                                                },
                                                                {
                                                                    "id": "705510220",
                                                                    "speaker": "艾梅莉埃",
                                                                    "text": "刚刚在猫尾酒馆小小试验了一番，猫儿们的反应还不错。客人们也觉得，新的香氛既温馨，又让他们精神飒爽。"
                                                                },
                                                                {
                                                                    "id": "705510221",
                                                                    "speaker": "艾梅莉埃",
                                                                    "text": "从外表平凡，未被重视的材料中，提取出卓越的香气…真是件令人欣喜的事。"
                                                                },
                                                                {
                                                                    "id": "705510222",
                                                                    "speaker": "Player",
                                                                    "text": "今天的天气很棒…"
                                                                },
                                                                {
                                                                    "id": "705510223",
                                                                    "speaker": "Player",
                                                                    "text": "（原来用经典话题展开聊天是这种感觉…）"
                                                                },
                                                                {
                                                                    "id": "705510224",
                                                                    "speaker": "艾梅莉埃",
                                                                    "text": "的确，早些时候，低空中徘徊着轻纱般的淡积云…大气的湿度适中，风速也相当柔和。"
                                                                },
                                                                {
                                                                    "id": "705510225",
                                                                    "speaker": "艾梅莉埃",
                                                                    "text": "这种条件下，人的嗅觉会处于一种…活跃，而不过度敏感的状态。"
                                                                },
                                                                {
                                                                    "id": "705510226",
                                                                    "speaker": "艾梅莉埃",
                                                                    "text": "混合得当的香味成分，能够自然而然地融入环境，深刻地浸润至人们的记忆之中。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705510227",
                                                                            "text": "居然还有这种理论…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705510229",
                                                                                    "speaker": "艾梅莉埃",
                                                                                    "text": "调饮似乎也有着相通之处——选择烈度适中的基酒，让各种香味成分和谐地融入酒体…"
                                                                                },
                                                                                {
                                                                                    "id": "705510230",
                                                                                    "speaker": "艾梅莉埃",
                                                                                    "text": "要是处理得当，一切成分都能共同发挥功用，给味觉带来最美妙的交响。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705510231",
                                                                                            "text": "好像懂了，口感融合很重要。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705510233",
                                                                                                    "speaker": "艾梅莉埃",
                                                                                                    "text": "嗯…说得对。仔细一想，层次分明的口感，确实不太符合我个人的习惯啊。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705510234",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "平时艾梅莉埃都喝些什么？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705510235",
                                                                                                    "speaker": "艾梅莉埃",
                                                                                                    "text": "平常啊…工作结束后，执律庭的朋友们偶尔会请我喝上两杯。通常，我会选择果茶，以便在聚餐后快速回到工作状态。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705510236",
                                                                                                    "speaker": "艾梅莉埃",
                                                                                                    "text": "如果第二天是假期，警员们兴高采烈，我也会点一小杯水果气泡酒。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705510237",
                                                                                                    "speaker": "艾梅莉埃",
                                                                                                    "text": "有位名叫蒂蕾娜的警官，还经常请我共饮陈年木桶的歌妲酒。不过她调去特巡队后，我就没再喝过了。",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "705510238",
                                                                                                            "text": "原来你能接受酒类吗？",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "705510240",
                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                    "text": "从科学的角度考虑，酒精是一种使用率极高的溶剂，我许多年前就习惯了高纯度酒精的气味。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705510241",
                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                    "text": "而在微醺状态下，我的心境会有所不同，进而影响到调香的思路…无论结果是好是坏，都属于新的尝试。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705510242",
                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                    "text": "所以，我并不抗拒烈度较低的酒饮，在饮品中加入一点点酒类就足够了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705510243",
                                                                                                                    "speaker": "Player",
                                                                                                                    "text": "最近的调香工作都还顺利吗？"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705510244",
                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                    "text": "嗯，多谢关心，一切都好，只有这次蒙德之行，遭遇了意料外的挑战。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705510245",
                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                    "text": "一开始，我就根据《芳香物质与人体感官概论》这本经典，选择了蒙德地区最传统的几种香味物质。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705510246",
                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                    "text": "没想到，落落莓为主调的香氛在酒馆中显得过于香甜，让人昏昏沉沉…有着漂亮耳朵的调饮师小姐直接倒下睡着了。",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "705510247",
                                                                                                                            "text": "原来落落莓有这种功效？",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "705510249",
                                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                                    "text": "只能说，甜度并非越高越好。对于摄入的甜味物质，适当把控总量，对身体和思维总归是有益的。"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "705510250",
                                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                                    "text": "日常生活中，我也不会经常吃甜食，并尽量避免食用浆果一类糖分过高的水果。"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "705510251",
                                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                                    "text": "最后，我在调香中完全划掉了落落莓的相关成分，转而向风车菊的方向探索出了一番成果。"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "705510252",
                                                                                                                                    "speaker": "Player",
                                                                                                                                    "text": "我已经有主意了，请稍等，我这就调整配方。"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "705510253",
                                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                                    "text": "嗯？只是简单聊了两句，你就找到了思路吗…"
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "705510254",
                                                                                                                                    "speaker": "艾梅莉埃",
                                                                                                                                    "text": "或许，你本来就有着很强的研发天赋？"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "705510248",
                                                                                                                            "text": "听起来落落莓香氛不太妙啊…"
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705510239",
                                                                                                            "text": "还以为你会觉得酒比较呛…"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705510232",
                                                                                            "text": "你倾向于浑然一体的口味。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705510228",
                                                                            "text": "第一次听说，长见识了。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705510217",
                                                            "text": "用哪种花卉取代了塞西莉亚？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705510209",
                                            "text": "艾梅莉埃想要更特别的饮品？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705510205",
                            "text": "一下就被你品出来了。"
