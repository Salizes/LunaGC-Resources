    "talks": [
        {
            "id": "7605601",
            "objective": "第一次对战对话$HIDDEN",
            "dialogues": [
                {
                    "id": "760560201",
                    "speaker": "Player",
                    "text": "不要说两招，三招也没问题。"
                },
                {
                    "id": "760560202",
                    "speaker": "特尔霍",
                    "text": "哈哈，爽快！果然还是人与人的较量才有意思对吧！彼伊列，要不就你先来和这位朋友过三招？"
                },
                {
                    "id": "760560205",
                    "speaker": "彼伊列",
                    "text": "好的老大！三招之内一定拿下！"
                }
            ]
        },
        {
            "id": "7605604",
            "objective": "第一场战斗$HIDDEN",
            "dialogues": [
                {
                    "id": "760560401",
                    "speaker": "彼伊列",
                    "text": "对不起老大…我给大家丢脸了…"
                },
                {
                    "id": "760560402",
                    "speaker": "特尔霍",
                    "text": "嗨，本来就是打发时间，输了也没关系。彼伊列，你先边上休息一下。"
                },
                {
                    "id": "760560403",
                    "speaker": "特尔霍",
                    "text": "这位朋友，你的身手很矫健嘛！我的名字叫特尔霍，幸会！"
                },
                {
                    "id": "760560404",
                    "speaker": "Player",
                    "text": "#我是{NICKNAME}，幸会！"
                },
                {
                    "id": "760560405",
                    "speaker": "特尔霍",
                    "text": "你看上去是有不少实战经验的高手，那我们可得认真一些了。刚才那次不算，再比试一次！英凯莉，轮到你了！"
                },
                {
                    "id": "760560406",
                    "speaker": "英凯莉",
                    "text": "老大每次都是遇到麻烦才想起我…真是没办法。那么，这位高手，我们开始吧！"
                }
            ]
        },
        {
            "id": "7605602",
            "objective": "第二次对战对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7605605",
            "objective": "第二场战斗$HIDDEN",
            "dialogues": [
                {
                    "id": "760560501",
                    "speaker": "英凯莉",
                    "text": "我、我竟然输了…被一个随随便便的路人打败了…这，怎么可能？！"
                },
                {
                    "id": "760560502",
                    "speaker": "特尔霍",
                    "text": "唔，竟然赢过了英凯莉…是我太轻敌了。"
                },
                {
                    "id": "760560503",
                    "speaker": "彼伊列",
                    "text": "不是老大的错，毕竟谁能想到会有这么强大的对手恰巧路过这里…"
                },
                {
                    "id": "760560504",
                    "speaker": "英凯莉",
                    "text": "老大！不能放他们走…"
                },
                {
                    "id": "760560505",
                    "speaker": "Player",
                    "text": "哦？难道不只是想切磋而已？"
                },
                {
                    "id": "760560506",
                    "speaker": "特尔霍",
                    "text": "别误会，英凯莉的意思是不能就这样认输罢了。我们毕竟也算是有点儿脸面的宝藏猎人。"
                },
                {
                    "id": "760560507",
                    "speaker": "特尔霍",
                    "text": "#{NICKNAME}，我郑重地向你发出正式挑战。这一次可就不是过招了，我们拿出真本事来打一场怎么样？"
                },
                {
                    "id": "760560508",
                    "speaker": "Player",
                    "text": "那就请三位一起上吧。"
                },
                {
                    "id": "760560509",
                    "speaker": "特尔霍",
                    "text": "好，那我们可就不客气了！"
                }
            ]
        },
        {
            "id": "7605603",
            "objective": "第三次对战对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7605606",
            "objective": "第三场战斗$HIDDEN",
            "dialogues": [
                {
                    "id": "760560601",
                    "speaker": "英凯莉",
                    "text": "竟然真的输给了一个过路人…三次！"
                },
                {
                    "id": "760560602",
                    "speaker": "彼伊列",
                    "text": "不不，你我各输了两次，老大只输了一次而已，还好…"
                },
                {
                    "id": "760560603",
                    "speaker": "特尔霍",
                    "text": "#嗨！输了就是输了，多想也没用！{NICKNAME}真的很强嘛！"
                },
                {
                    "id": "760560604",
                    "speaker": "特尔霍",
                    "text": "你们两个平时连我也打不过，现在见识到真正的强者了吧？你们还要多训练才行。"
                },
                {
                    "id": "760560605",
                    "speaker": "特尔霍",
                    "text": "至于我嘛！看来得考虑早点儿退休了，不知道瓦伊诺的训练场还招不招人…"
                }
            ]
        },
        {
            "id": "7605607",
            "objective": "战斗后闲置对话$HIDDEN",
            "dialogues": [
                {
                    "id": "760560701",
                    "speaker": "特尔霍",
                    "text": "你果然回来了！彼伊列，这次就你先上吧！怎么样？这位朋友，准备好跟我们过招了吗？"
                }
            ]
        },
        {
            "id": "7605601",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760560101",
                    "speaker": "特尔霍",
                    "text": "哟，这位朋友！来训练场光是打靶子的话，会不会觉得不是很过瘾？你看起来身手不错，要不要来跟我们过两招？"
                }
            ]
        },
        {
            "id": "7605603",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760560301",
                    "speaker": "Player",
                    "text": "抱歉，我还有事…"
                },
                {
                    "id": "760560302",
                    "speaker": "特尔霍",
                    "text": "没关系，反正我们也是在这里打发时间。等你有空了，闲得发慌的时候再来找我们吧！"
                }
            ]
        },
        {
            "id": "7605608",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760560801",
                    "speaker": "Player",
                    "text": "准备好了，来吧！"
                }
            ]
        },
        {
            "id": "7605609",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760560901",
                    "speaker": "Player",
                    "text": "抱歉，我还有事…"
                }
            ]
        }
    ]
}