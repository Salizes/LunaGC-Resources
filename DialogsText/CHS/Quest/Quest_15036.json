    "talks": [
        {
            "id": "1503601",
            "objective": "前往幕后真凶的藏身处",
            "dialogues": [
                {
                    "id": "150360101",
                    "speaker": "派蒙",
                    "text": "这里…我记得是层岩巨渊附近？"
                },
                {
                    "id": "150360102",
                    "speaker": "丝柯克",
                    "text": "从这里进去，就能抵达你梦里的那个空间。"
                },
                {
                    "id": "150360103",
                    "speaker": "丝柯克",
                    "text": "虽然同是深渊秘境，但那边是别人的地盘，还是要谨慎行事。"
                },
                {
                    "id": "150360104",
                    "speaker": "派蒙",
                    "text": "#放心吧，我会躲到{NICKNAME}身后的！"
                },
                {
                    "id": "150360105",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，{NICKNAME}，你也不要勉强哦。",
                    "choices": [
                        {
                            "id": "150360106",
                            "text": "放心。",
                            "response": [
                                {
                                    "id": "150360108",
                                    "speaker": "丝柯克",
                                    "text": "走吧。多想一想特训的内容，或许能用得上。"
                                }
                            ]
                        },
                        {
                            "id": "150360107",
                            "text": "好好教训一下那个「强盗」。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503607",
            "objective": "进入深渊裂隙",
            "dialogues": []
        },
        {
            "id": "1503602",
            "objective": "抵达深渊长廊尽头",
            "dialogues": [
                {
                    "id": "150360201",
                    "speaker": "派蒙",
                    "text": "前面好像没有路了！这里就是那个坏蛋藏身的地方吗？"
                },
                {
                    "id": "150360202",
                    "speaker": "派蒙",
                    "text": "好浓的雾，什么也看不清！"
                },
                {
                    "id": "150360203",
                    "speaker": "丝柯克",
                    "text": "之前，你就是在这里被袭击，失去了一部分灵魂碎片吧。"
                },
                {
                    "id": "150360204",
                    "speaker": "丝柯克",
                    "text": "你能感应到那部分灵魂碎片在哪吗？"
                },
                {
                    "id": "150360205",
                    "speaker": "Player",
                    "text": "（闭上眼睛，努力想象当时从身体中逸散的光点…它似乎就在附近，但并不清楚它的具体方位。）",
                    "choices": [
                        {
                            "id": "150360206",
                            "text": "不行…！",
                            "response": [
                                {
                                    "id": "150360208",
                                    "speaker": "丝柯克",
                                    "text": "看来对方也做好了准备，提前遮蔽了它的气息，否则灵魂之间应该存在更强烈的共鸣。"
                                },
                                {
                                    "id": "150360209",
                                    "speaker": "派蒙",
                                    "text": "等一下，快看！那些尖刺又出现了！"
                                },
                                {
                                    "id": "150360210",
                                    "speaker": "丝柯克",
                                    "text": "「投鼠忌器」，说的就是这种情况。反击的时候收着点力，先观察对方的动作。"
                                },
                                {
                                    "id": "150360211",
                                    "speaker": "丝柯克",
                                    "text": "对方既然夺走了你的灵魂碎片，就一定会用它做些什么。或许就藏在某个攻击招式里，想办法找出来。"
                                }
                            ]
                        },
                        {
                            "id": "150360207",
                            "text": "只能感觉到它在附近。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503608",
            "objective": "躲避尖刺袭击",
            "dialogues": []
        },
        {
            "id": "1503603",
            "objective": "躲避尖刺袭击",
            "dialogues": [
                {
                    "id": "150360301",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}、丝柯克！！"
                },
                {
                    "id": "150360302",
                    "speaker": "派蒙",
                    "text": "刚刚发生什么了？我看见丝柯克的肩膀好像被——"
                },
                {
                    "id": "150360303",
                    "speaker": "丝柯克",
                    "text": "……"
                },
                {
                    "id": "150360304",
                    "speaker": "丝柯克",
                    "text": "在归离原，你问我为什么那家伙盯上了你，将你视作重要的猎物。"
                },
                {
                    "id": "150360305",
                    "speaker": "丝柯克",
                    "text": "现在答案已经很明显了。除了你本身就具备着不俗的实力之外，也是因为你有着所谓「净化深渊」的能力。"
                },
                {
                    "id": "150360306",
                    "speaker": "丝柯克",
                    "text": "「净化」的本质暂且不论，借由这份力量，他就能做到许多原本做不到的事——"
                },
                {
                    "id": "150360307",
                    "speaker": "丝柯克",
                    "text": "就比如洞穿我的防御，吞噬我的力量。",
                    "choices": [
                        {
                            "id": "150360308",
                            "text": "他的目标其实是你？",
                            "response": [
                                {
                                    "id": "150360310",
                                    "speaker": "丝柯克",
                                    "text": "不，最初他应该并不清楚我会来。拿走你的灵魂碎片，只是认为你的力量很珍贵，没想到碰巧能在这时候派上用场。"
                                },
                                {
                                    "id": "150360311",
                                    "speaker": "丝柯克",
                                    "text": "如果这世界上真有所谓的命运，指的应该就是这种无聊的巧合吧。"
                                },
                                {
                                    "id": "150360312",
                                    "speaker": "丝柯克",
                                    "text": "不过，对我们来说也是好事。想明白它会将你的力量用在哪，就能反过来将你失去的东西拿回来。"
                                },
                                {
                                    "id": "150360313",
                                    "speaker": "Player",
                                    "text": "可是你…"
                                },
                                {
                                    "id": "150360314",
                                    "speaker": "丝柯克",
                                    "text": "我心里有数。"
                                },
                                {
                                    "id": "150360315",
                                    "speaker": "丝柯克",
                                    "text": "吃饱了吗？回答我的问题。"
                                },
                                {
                                    "id": "150360316",
                                    "speaker": "丝柯克",
                                    "text": "为什么…你会有「吞星之鲸」的权能？"
                                },
                                {
                                    "id": "150360317",
                                    "speaker": "派蒙",
                                    "text": "吞星之鲸？！"
                                },
                                {
                                    "id": "150360318",
                                    "speaker": "派蒙",
                                    "text": "啊…对哦！怪不得我看那个尖刺有点眼熟，那东西…长得很像吞星之鲸头上的角！"
                                },
                                {
                                    "id": "150360319",
                                    "speaker": "丝柯克",
                                    "text": "这份权能不是你靠自己的力量得来的，对吧？"
                                },
                                {
                                    "id": "150360320",
                                    "speaker": "丝柯克",
                                    "text": "如果你真有战胜吞星之鲸的实力，就无需四处收集魔神残渣这种不完整的力量。"
                                },
                                {
                                    "id": "150360321",
                                    "speaker": "丝柯克",
                                    "text": "我只能想到一种可能性。你认识我的师父，「极恶骑」苏尔特洛奇是吗？"
                                },
                                {
                                    "id": "150360322",
                                    "speaker": "？？？",
                                    "text": "「极恶骑」…"
                                },
                                {
                                    "id": "150360323",
                                    "speaker": "？？？",
                                    "text": "何人称其为「恶」？苏尔特洛奇…"
                                },
                                {
                                    "id": "150360324",
                                    "speaker": "？？？",
                                    "text": "苏尔…特洛奇…！"
                                },
                                {
                                    "id": "150360325",
                                    "speaker": "丝柯克",
                                    "text": "被力量冲昏了头脑，已经失去了基本的交流能力吗？"
                                },
                                {
                                    "id": "150360326",
                                    "speaker": "？？？",
                                    "text": "再等等，我还没有…"
                                },
                                {
                                    "id": "150360327",
                                    "speaker": "派蒙",
                                    "text": "快看！那东西又来了！"
                                },
                                {
                                    "id": "150360328",
                                    "speaker": "丝柯克",
                                    "text": "痴迷力量的人，在被反噬前都不会回头。"
                                },
                                {
                                    "id": "150360329",
                                    "speaker": "Player",
                                    "text": "现在该怎么办？"
                                },
                                {
                                    "id": "150360330",
                                    "speaker": "丝柯克",
                                    "text": "冷静。用你的「理性」思考，做你认为最合适的选择。"
                                },
                                {
                                    "id": "150360331",
                                    "speaker": "Player",
                                    "text": "（为了拿回我的灵魂碎片，丝柯克被那家伙的尖刺刺伤，力量也被夺走了。）"
                                },
                                {
                                    "id": "150360332",
                                    "speaker": "Player",
                                    "text": "（元凶就在迷雾之后。在刚刚的交手中，我已经逐渐摸清楚对方的攻击方式了。继续动手，胜算很高。）"
                                },
                                {
                                    "id": "150360333",
                                    "speaker": "Player",
                                    "text": "（但是丝柯克的气息比平时弱了许多。贸然进攻的话，必然无法保证她和派蒙的安全。虽然很不情愿…）"
                                },
                                {
                                    "id": "150360334",
                                    "speaker": "Player",
                                    "text": "先离开这里吧。"
                                },
                                {
                                    "id": "150360335",
                                    "speaker": "丝柯克",
                                    "text": "胜负不在一时，你做了正确的判断。"
                                },
                                {
                                    "id": "150360336",
                                    "speaker": "丝柯克",
                                    "text": "既然拿回了你的灵魂碎片，此行的目的也就达成了。至于他的命，再多寄存一段时间也无妨。"
                                },
                                {
                                    "id": "150360337",
                                    "speaker": "丝柯克",
                                    "text": "走吧。这次，靠你带我们出去了。"
                                }
                            ]
                        },
                        {
                            "id": "150360309",
                            "text": "他一开始就在打你的主意？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503604",
            "objective": "撤离快要坍塌的深渊",
            "dialogues": []
        },
        {
            "id": "1503605",
            "objective": "与丝柯克对话",
            "dialogues": [
                {
                    "id": "150360501",
                    "speaker": "派蒙",
                    "text": "呼…跑到这里，应该安全了吧？"
                },
                {
                    "id": "150360502",
                    "speaker": "丝柯克",
                    "text": "察觉不到他的气息，看来他仍停留在深渊秘境中。"
                },
                {
                    "id": "150360503",
                    "speaker": "丝柯克",
                    "text": "我的力量不是弱者轻易能够掌控的。在他消化完之前，应该都不会从那里离开了。",
                    "choices": [
                        {
                            "id": "150360504",
                            "text": "「吞星之鲸」…",
                            "response": [
                                {
                                    "id": "150360506",
                                    "speaker": "丝柯克",
                                    "text": "你看上去很惊讶。"
                                },
                                {
                                    "id": "150360507",
                                    "speaker": "丝柯克",
                                    "text": "也对…你并未真正见过那头鲸鱼张开血盆大口，仿佛要将星球吞入腹中的场景。"
                                },
                                {
                                    "id": "150360508",
                                    "speaker": "丝柯克",
                                    "text": "吞星之鲸有着「吞噬」的权能。无论是活人还是死物，只要能破开防御，直接接触到对方的本体，就能从中抽取力量。"
                                },
                                {
                                    "id": "150360509",
                                    "speaker": "派蒙",
                                    "text": "我们和它交手的时候，那维莱特好像也说过，「吞噬」是它的本能…"
                                },
                                {
                                    "id": "150360510",
                                    "speaker": "丝柯克",
                                    "text": "古龙的孑遗看出了它力量的实质，一直在用「水」的权能保护你们。那时候吞星之鲸也还处于饱腹的状态，没有彻底躁怒。"
                                },
                                {
                                    "id": "150360511",
                                    "speaker": "丝柯克",
                                    "text": "在力量完全耗尽后，它才会逐渐展露出真正的本性，将星球上的一切化作储粮。所以我将它收存在特殊的虚无空间里…"
                                },
                                {
                                    "id": "150360512",
                                    "speaker": "丝柯克",
                                    "text": "只是没想到，在这颗星球上，仍有人可以使用它的权能。这说明他在很久以前就见过吞星之鲸，应该是师父认识的人。"
                                },
                                {
                                    "id": "150360513",
                                    "speaker": "Player",
                                    "text": "他确实对「极恶骑」这个词有反应。"
                                },
                                {
                                    "id": "150360514",
                                    "speaker": "丝柯克",
                                    "text": "所以我说，此行的目的已经完成了。"
                                },
                                {
                                    "id": "150360515",
                                    "speaker": "丝柯克",
                                    "text": "这之后就是我的私事。如今的你已经重归完整，可以继续自己的旅程了。"
                                },
                                {
                                    "id": "150360516",
                                    "speaker": "派蒙",
                                    "text": "这怎么行！为了帮我们的忙，你的力量才被夺走了，我们怎么能放着你不管呢？"
                                },
                                {
                                    "id": "150360517",
                                    "speaker": "丝柯克",
                                    "text": "承受失败、失去力量，我已经不是第一次经历这种事情了。若是坠入低谷，就重新向上攀爬，直至变得更强。"
                                },
                                {
                                    "id": "150360518",
                                    "speaker": "派蒙",
                                    "text": "就算这样…万一那个怪物在你恢复好之前就找到你怎么办？"
                                },
                                {
                                    "id": "150360519",
                                    "speaker": "派蒙",
                                    "text": "而且你失去了力量，应该也不能像以前那样「咻」地一下打开去深渊的门了吧？"
                                },
                                {
                                    "id": "150360520",
                                    "speaker": "派蒙",
                                    "text": "至少这段时间，跟我们一起行动也不是什么坏事，对吧？",
                                    "choices": [
                                        {
                                            "id": "150360521",
                                            "text": "这并非出于「同情」。",
                                            "response": [
                                                {
                                                    "id": "150360523",
                                                    "speaker": "丝柯克",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "150360524",
                                                    "speaker": "丝柯克",
                                                    "text": "我明白你们的想法了。这个给你们。"
                                                },
                                                {
                                                    "id": "150360525",
                                                    "speaker": "派蒙",
                                                    "text": "这个是…？"
                                                },
                                                {
                                                    "id": "150360526",
                                                    "speaker": "丝柯克",
                                                    "text": "装摩拉的袋子。在这个世界生活需要花钱，这点常识我还是有的。"
                                                },
                                                {
                                                    "id": "150360527",
                                                    "speaker": "丝柯克",
                                                    "text": "这段时间就随你们安排。决定好去哪，就尽快出发。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "150360522",
                                            "text": "现在还算不上「两不相欠」。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "150360505",
                            "text": "居然连你的力量都能夺走…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503609",
            "objective": "前往不卜庐休整",
            "dialogues": []
        },
        {
            "id": "1503606",
            "objective": "前往不卜庐休整",
            "dialogues": [
                {
                    "id": "150360601",
                    "speaker": "派蒙",
                    "text": "仔细一看，丝柯克的包里居然装了这么多摩拉…"
                },
                {
                    "id": "150360602",
                    "speaker": "派蒙",
                    "text": "难道说她也在打工？不对不对，你还记得万民堂那时候发生的事吗？如果她去打工的话，绝对会变成这样子——"
                },
                {
                    "id": "150360603",
                    "speaker": "派蒙",
                    "text": "「老板，结一下这个月的工钱。」"
                },
                {
                    "id": "150360604",
                    "speaker": "派蒙",
                    "text": "「好的。等一下…你是谁？我们认识吗？」"
                },
                {
                    "id": "150360605",
                    "speaker": "派蒙",
                    "text": "嘿嘿，毕竟见过她的人一眨眼就把她忘了嘛。这些摩拉是从哪来的呢？"
                },
                {
                    "id": "150360606",
                    "speaker": "丝柯克",
                    "text": "地下的无主宝藏，以及顺手解决一些寻衅的魔物。来路正当，放心用吧。"
                },
                {
                    "id": "150360607",
                    "speaker": "派蒙",
                    "text": "呜哇！你能听到吗？"
                },
                {
                    "id": "150360608",
                    "speaker": "丝柯克",
                    "text": "这么响的说话声，站在门外的山顶上都能听到。"
                },
                {
                    "id": "150360609",
                    "speaker": "派蒙",
                    "text": "啊？等下，该不会我之前在背后说的那些…"
                },
                {
                    "id": "150360610",
                    "speaker": "丝柯克",
                    "text": "你指什么？雪山冻堇瓜？",
                    "choices": [
                        {
                            "id": "150360611",
                            "text": "果然被听到了…",
                            "response": [
                                {
                                    "id": "150360613",
                                    "speaker": "派蒙",
                                    "text": "那个…其实那句话不是我说的啦！是有一个长得和我很像的人，总喜欢背后冒充我，给别人起奇怪的绰号！"
                                },
                                {
                                    "id": "150360614",
                                    "speaker": "派蒙",
                                    "text": "#…好吧，我错了。那时候我不太喜欢你，但现在我觉得你人还不错，毕竟帮了{NICKNAME}这么大忙。我们可以当朋友吗？"
                                },
                                {
                                    "id": "150360615",
                                    "speaker": "丝柯克",
                                    "text": "……"
                                },
                                {
                                    "id": "150360616",
                                    "speaker": "丝柯克",
                                    "text": "我刚刚看过，这里只有一张床，你们去休息吧。"
                                },
                                {
                                    "id": "150360617",
                                    "speaker": "派蒙",
                                    "text": "欸？那你呢？"
                                },
                                {
                                    "id": "150360618",
                                    "speaker": "丝柯克",
                                    "text": "我不会感到疲惫，也不需要休息。我去外面挥剑，这样力量能快些恢复。"
                                },
                                {
                                    "id": "150360619",
                                    "speaker": "派蒙",
                                    "text": "但是你的身体——欸！等下，这就走啦！"
                                },
                                {
                                    "id": "150360620",
                                    "speaker": "派蒙",
                                    "text": "气死我了。哼！不管她，等她累了自然就回来休息了。"
                                },
                                {
                                    "id": "150360621",
                                    "speaker": "派蒙",
                                    "text": "我们睡觉！睡软软的床！"
                                },
                                {
                                    "id": "150360622",
                                    "speaker": "Player",
                                    "text": "（丝柯克很有主见，现在劝她躺下休息，她应该也不会答应。）"
                                },
                                {
                                    "id": "150360623",
                                    "speaker": "Player",
                                    "text": "（派蒙说的也有道理，如果丝柯克感到疲惫，她应该就会停止训练了。今晚先睡下吧。）"
                                },
                                {
                                    "id": "150360624",
                                    "speaker": "？？？",
                                    "text": "呼…呼…"
                                },
                                {
                                    "id": "150360625",
                                    "speaker": "Player",
                                    "text": "（丝柯克…？）"
                                },
                                {
                                    "id": "150360626",
                                    "speaker": "Player",
                                    "text": "（不愧是她，这么快就恢复了一些力量。不过她看上去有些奇怪…）"
                                },
                                {
                                    "id": "150360627",
                                    "speaker": "丝柯克",
                                    "text": "呼…"
                                },
                                {
                                    "id": "150360628",
                                    "speaker": "丝柯克",
                                    "text": "…安静。"
                                },
                                {
                                    "id": "150360629",
                                    "speaker": "Player",
                                    "text": "（安静？周围明明没有人说话。难道说…）"
                                },
                                {
                                    "id": "150360630",
                                    "speaker": "蛊惑人心的声音",
                                    "text": "想想我们吧，多少人葬身在那场大火当中，只有你一个人活了下来。"
                                },
                                {
                                    "id": "150360631",
                                    "speaker": "蛊惑人心的声音",
                                    "text": "不要将目光从剑上挪开，你还没有资格休息。"
                                },
                                {
                                    "id": "150360632",
                                    "speaker": "蛊惑人心的声音",
                                    "text": "跑起来，丝柯克。在死亡到来前，你都要不停地跑下去——"
                                },
                                {
                                    "id": "150360633",
                                    "speaker": "Player",
                                    "text": "（对了。那次在梦里，丝柯克也是在经历了一场失败后孤独地练剑，身后有数不清的杂声。）"
                                },
                                {
                                    "id": "150360634",
                                    "speaker": "Player",
                                    "text": "（大火…到底发生过什么事呢？要是她愿意和我们说说就好了…）"
                                },
                                {
                                    "id": "150360635",
                                    "speaker": "派蒙",
                                    "text": "早睡早起身体好！这床真舒服呀——"
                                },
                                {
                                    "id": "150360636",
                                    "speaker": "派蒙",
                                    "text": "丝柯克，你在这坐了一晚上吗？要不要休息一会儿？"
                                },
                                {
                                    "id": "150360637",
                                    "speaker": "丝柯克",
                                    "text": "……"
                                },
                                {
                                    "id": "150360638",
                                    "speaker": "Player",
                                    "text": "力量恢复了吗？"
                                },
                                {
                                    "id": "150360639",
                                    "speaker": "丝柯克",
                                    "text": "恢复了六七成。"
                                },
                                {
                                    "id": "150360640",
                                    "speaker": "派蒙",
                                    "text": "这么快！我还以为至少要几天呢！"
                                },
                                {
                                    "id": "150360641",
                                    "speaker": "丝柯克",
                                    "text": "不…比我预想中要慢。"
                                },
                                {
                                    "id": "150360642",
                                    "speaker": "丝柯克",
                                    "text": "如果是以前，力量还要多恢复两成。同样的方法、同样的感受，结果却变差了。"
                                },
                                {
                                    "id": "150360643",
                                    "speaker": "Player",
                                    "text": "难道是受那个尖刺的影响？"
                                },
                                {
                                    "id": "150360644",
                                    "speaker": "丝柯克",
                                    "text": "应该是我自己出了问题。"
                                },
                                {
                                    "id": "150360645",
                                    "speaker": "丝柯克",
                                    "text": "接下来的两天，我需要在这里冥想，让意识完全沉入内心，看看到底发生了什么。"
                                },
                                {
                                    "id": "150360646",
                                    "speaker": "派蒙",
                                    "text": "冥想！听起来好厉害，那我们就在旁边护法好啦。"
                                },
                                {
                                    "id": "150360647",
                                    "speaker": "丝柯克",
                                    "text": "有劳。两天后见。"
                                }
                            ]
                        },
                        {
                            "id": "150360612",
                            "text": "派蒙的悄悄话水平有待提高。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503604",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150360411",
                    "speaker": "丝柯克",
                    "text": "刚才开始，对方的进攻重点就放在我身上。"
                },
                {
                    "id": "150360414",
                    "speaker": "丝柯克",
                    "text": "自信能打穿我的防御？难道说…"
                },
                {
                    "id": "150360424",
                    "speaker": "Player",
                    "text": "你还好吗？刚刚那是…"
                },
                {
                    "id": "150360428",
                    "speaker": "丝柯克",
                    "text": "收好。我帮你拿回来了。"
                }
            ]
        },
        {
            "id": "1503650",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150365001",
                    "speaker": "丝柯克",
                    "text": "他的身上一定有关于师父的线索。下次见面…",
                    "choices": [
                        {
                            "id": "150365002",
                            "text": "伤口还疼吗？",
                            "response": [
                                {
                                    "id": "150365003",
                                    "speaker": "丝柯克",
                                    "text": "外伤而已，不必在意。"
                                },
                                {
                                    "id": "150365004",
                                    "speaker": "丝柯克",
                                    "text": "虽然恢复力量需要时间，但这种程度的困境我已经「适应」了。"
                                }
                            ]
                        },
                        {
                            "id": "150365005",
                            "text": "你的衣服…？",
                            "response": [
                                {
                                    "id": "150365006",
                                    "speaker": "丝柯克",
                                    "text": "你说这个？提瓦特的深渊能量非常稀薄，为了更加自由地使用力量，我制作了一种「星晶旅装」。"
                                },
                                {
                                    "id": "150365007",
                                    "speaker": "丝柯克",
                                    "text": "里面蕴藏着高规格的深渊能量，可以为我的行动提供便利。能量散尽的时候，就会变回它最初的样子。"
                                }
                            ]
                        },
                        {
                            "id": "150365008",
                            "text": "走吧。",
                            "response": [
                                {
                                    "id": "150365009",
                                    "speaker": "丝柯克",
                                    "text": "找好休息的地方了吗？那就尽快离开这里吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1503651",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150365101",
                    "speaker": "白术",
                    "text": "你看上去比之前健康许多，烦扰消失了？"
                },
                {
                    "id": "150365102",
                    "speaker": "长生",
                    "text": "嚯，真不简单。不过现在放松还太早了吧？"
                },
                {
                    "id": "150365103",
                    "speaker": "白术",
                    "text": "没错。疾病初愈，还是再观察一段时间为好。"
                },
                {
                    "id": "150365104",
                    "speaker": "白术",
                    "text": "正好近期病人不多，许多房间都空置着。如有需要，可以再暂住几天。"
                },
                {
                    "id": "150365105",
                    "speaker": "派蒙",
                    "text": "太好啦，谢谢你们！"
                }
            ]
        },
        {
            "id": "1503699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150369901",
                    "speaker": "派蒙",
                    "text": "呼啊——终于要出发了吗？"
                },
                {
                    "id": "150369902",
                    "speaker": "派蒙",
                    "text": "现在我们要去哪？"
                },
                {
                    "id": "150369903",
                    "speaker": "丝柯克",
                    "text": "跟我来。我会到离那家伙最近的地方打开深渊裂隙，带你们去他的藏身之处。"
                },
                {
                    "id": "150369904",
                    "speaker": "派蒙",
                    "text": "我们带丝柯克去休息吧！让我想想，去哪比较好呢？"
                },
                {
                    "id": "150369905",
                    "speaker": "派蒙",
                    "text": "感觉丝柯克应该不喜欢人多的地方…对了。白术不是借了我们一间病房吗？我们带丝柯克去那里休息吧。"
                }
            ]
        }
    ]
}