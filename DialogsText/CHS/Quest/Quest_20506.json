    "talks": [
        {
            "id": "2050601",
            "objective": "与蒂玛乌斯对话，了解炼金术",
            "dialogues": [
                {
                    "id": "205060101",
                    "speaker": "蒂玛乌斯",
                    "text": "你好，我是炼金术的研究者蒂玛乌斯，欢迎来到蒙德城。"
                },
                {
                    "id": "205060102",
                    "speaker": "Player",
                    "text": "炼金术？"
                },
                {
                    "id": "205060103",
                    "speaker": "蒂玛乌斯",
                    "text": "这是一种从古代流传下来的技术，目前我们还对它了解甚少。"
                },
                {
                    "id": "205060104",
                    "speaker": "蒂玛乌斯",
                    "text": "它的规则神秘而奇妙，和我们所知的创造物体的原理完全不同。"
                },
                {
                    "id": "205060105",
                    "speaker": "蒂玛乌斯",
                    "text": "要是能掌握这门技术，我们应该就能造出很不得了的东西了。"
                },
                {
                    "id": "205060106",
                    "speaker": "派蒙",
                    "text": "这边的这个就是炼金术用的台子吧？"
                },
                {
                    "id": "205060107",
                    "speaker": "蒂玛乌斯",
                    "text": "没错。对了，要不亲自使用一下炼金术试试？",
                    "choices": [
                        {
                            "id": "205060108",
                            "text": "听上去很复杂，没问题吗？",
                            "response": [
                                {
                                    "id": "205060110",
                                    "speaker": "蒂玛乌斯",
                                    "text": "没事的，至少操作上并不复杂。你有兴趣的话我可以教你最基础的部分。"
                                },
                                {
                                    "id": "205060111",
                                    "speaker": "Player",
                                    "text": "炼金合成"
                                }
                            ]
                        },
                        {
                            "id": "205060109",
                            "text": "会爆炸吧…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2050602",
            "objective": "(test)与蒂玛乌斯对话（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "205060201",
                    "speaker": "派蒙",
                    "text": "好神奇啊…"
                },
                {
                    "id": "205060202",
                    "speaker": "蒂玛乌斯",
                    "text": "我们现在所使用的炼金术，都还只是在模仿古代人留下来的方法。"
                },
                {
                    "id": "205060203",
                    "speaker": "蒂玛乌斯",
                    "text": "会使用风之翼的人是不需要知道它是怎么制作出来的，炼金术也是一个道理。"
                },
                {
                    "id": "205060204",
                    "speaker": "蒂玛乌斯",
                    "text": "但每当我觉得好像摸到了一点原理，它又马上会让人出乎意料，唉…",
                    "choices": [
                        {
                            "id": "205060205",
                            "text": "炼金术还能用来干什么？",
                            "response": [
                                {
                                    "id": "205060206",
                                    "speaker": "蒂玛乌斯",
                                    "text": "说实话我也不知道，但就是不知道才引人好奇。"
                                },
                                {
                                    "id": "205060210",
                                    "speaker": "蒂玛乌斯",
                                    "text": "有很多神奇的配方我也还在研究。"
                                },
                                {
                                    "id": "205060211",
                                    "speaker": "蒂玛乌斯",
                                    "text": "在你冒险的途中，应该能见到一些古代文明留下的关于炼金术的记录。"
                                },
                                {
                                    "id": "205060212",
                                    "speaker": "蒂玛乌斯",
                                    "text": "随着你「冒险等阶」的提高，你掌握的配方也会更多。",
                                    "choices": [
                                        {
                                            "id": "205060213",
                                            "text": "谢谢你的解释。",
                                            "response": [
                                                {
                                                    "id": "205060214",
                                                    "speaker": "蒂玛乌斯",
                                                    "text": "不用谢，也别忘了跟我分享你的见识与成果哦。"
                                                },
                                                {
                                                    "id": "205060218",
                                                    "speaker": "蒂玛乌斯",
                                                    "text": "那么，我们回头见。祝你们的前路永远有风吹拂。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "205060215",
                                            "text": "到那时就能造派蒙了。",
                                            "response": [
                                                {
                                                    "id": "205060216",
                                                    "speaker": "派蒙",
                                                    "text": "还在考虑这件事，我是哪里让你不满意了吗！"
                                                },
                                                {
                                                    "id": "205060217",
                                                    "speaker": "蒂玛乌斯",
                                                    "text": "哈哈，你们两位是很有趣的人啊。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "205060207",
                            "text": "能造出派蒙吗？",
                            "response": [
                                {
                                    "id": "205060208",
                                    "speaker": "派蒙",
                                    "text": "有一个我还不够吗？！"
                                },
                                {
                                    "id": "205060209",
                                    "speaker": "蒂玛乌斯",
                                    "text": "哈哈哈，很可惜现在还不行。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}