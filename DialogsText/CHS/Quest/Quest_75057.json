    "talks": [
        {
            "id": "7505701",
            "objective": "(test)完成消灭怪物$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7505702",
            "objective": "(test)长钉砸下镜头$HIDDEN",
            "dialogues": [
                {
                    "id": "750013201",
                    "speaker": "蒂图",
                    "text": "居然真的成功了…这之前只是出现在「故事」中的场景，真是了不起。"
                },
                {
                    "id": "750013202",
                    "speaker": "蒂图",
                    "text": "原本聒噪不休的声音也安静了下去…「小缝影针」又回归了原本的样貌。那么大的东西，「轰隆」一下砸了下去…"
                },
                {
                    "id": "750013203",
                    "speaker": "蒂图",
                    "text": "呼…真的有人能做到…这不会是一场梦吧，你们都真实存在？不会是我的臆想吧…"
                },
                {
                    "id": "750013204",
                    "speaker": "Player",
                    "text": "梦醒了…该你自己解决啦！"
                },
                {
                    "id": "750013205",
                    "speaker": "派蒙",
                    "text": "别说这么残忍的话啦。"
                },
                {
                    "id": "750013206",
                    "speaker": "派蒙",
                    "text": "#怎么样，我就说，{NICKNAME}是很强的！"
                },
                {
                    "id": "750013207",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750013208",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，{REALNAME[ID(2)|SHOWHOST(true)]}也觉得很了不起吧。"
                },
                {
                    "id": "750013209",
                    "speaker": "蒂图",
                    "text": "#{NICKNAME}，了不起的异邦勇士啊，你可没有被深渊影响到吧？",
                    "choices": [
                        {
                            "id": "750013210",
                            "text": "没事，区区深渊…",
                            "response": [
                                {
                                    "id": "750013212",
                                    "speaker": "蒂图",
                                    "text": "#就连部族里最强的勇士面对深渊都得打起十二分精神，{NICKNAME}果然不是一般人。"
                                },
                                {
                                    "id": "750013213",
                                    "speaker": "蒂图",
                                    "text": "哎呀，说不定以这个题材写出的故事，能够比桑哈杰记录的故事更加精彩。"
                                },
                                {
                                    "id": "750013214",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "啊嗯？"
                                },
                                {
                                    "id": "750013215",
                                    "speaker": "派蒙",
                                    "text": "虽然不知道桑哈杰是谁，但是听上去很了不起？"
                                },
                                {
                                    "id": "750013216",
                                    "speaker": "蒂图",
                                    "text": "哈哈，对于所有「讲故事的部族人」来说，烟谜主的桑哈杰都是值得崇敬的人物…"
                                },
                                {
                                    "id": "750013217",
                                    "speaker": "蒂图",
                                    "text": "不过现在情况紧急，等有空的时候，再和你们说桑哈杰的故事吧！"
                                },
                                {
                                    "id": "750013218",
                                    "speaker": "蒂图",
                                    "text": "好了，我们到下一根浮起的「小缝影针」那边去吧，快些解决问题，我今晚就能开始动笔啦！"
                                },
                                {
                                    "id": "750013219",
                                    "speaker": "派蒙",
                                    "text": "出发出发！"
                                },
                                {
                                    "id": "750013220",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                }
                            ]
                        },
                        {
                            "id": "750013211",
                            "text": "暂时还挺健康的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7500108",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "750010801",
                    "speaker": "？？？",
                    "text": "哇，刚才听到了些可怕的动静，所以想过来看看…"
                },
                {
                    "id": "750010802",
                    "speaker": "？？？",
                    "text": "过来的时候还安慰自己「别乱想啦，蒂图，还能有什么事呢」，结果根本就发生了了不起的大事啊！"
                },
                {
                    "id": "750010803",
                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                    "text": "呀！"
                },
                {
                    "id": "750010804",
                    "speaker": "？？？",
                    "text": "这里居然还有一只小嵴锋龙…是你把这两位异邦人引到这里来的吗？"
                },
                {
                    "id": "750010805",
                    "speaker": "？？？",
                    "text": "以及，这个「缝影针」…是你们钻下去的？",
                    "choices": [
                        {
                            "id": "750010806",
                            "text": "…难道，不应该被钻下去？",
                            "response": [
                                {
                                    "id": "750010807",
                                    "speaker": "派蒙",
                                    "text": "#啊？那，{NICKNAME}，我们岂不是做了很糟糕的事…不如趁目击者只有一位…"
                                },
                                {
                                    "id": "750010808",
                                    "speaker": "？？？",
                                    "text": "#哈哈，别说那么恐怖的话啦，情况没那么严重，不如说你们做了好事？这位{M#兄弟}{F#小姐}是{NICKNAME}，你呢？"
                                },
                                {
                                    "id": "750010813",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "呀！"
                                },
                                {
                                    "id": "750010814",
                                    "speaker": "Player",
                                    "text": "#这是{REALNAME[ID(2)|SHOWHOST(true)]}。"
                                },
                                {
                                    "id": "750010815",
                                    "speaker": "？？？",
                                    "text": "嗯，而我的名字是蒂图，我是部族里负责讲故{RUBY#[D]叙事人}事的人。同时，也负责「照看」山谷里的这几条石柱子。"
                                },
                                {
                                    "id": "750010816",
                                    "speaker": "蒂图",
                                    "text": "当然了，你们钻下去的这块石柱，是三根「小缝影针」其中之一，也在我的看管范围之内。"
                                },
                                {
                                    "id": "750010817",
                                    "speaker": "派蒙",
                                    "text": "看、看管…果然，我们把那个什么石柱子弄掉了，纳塔本地人就会以此来向我们索要赔偿。"
                                },
                                {
                                    "id": "750010818",
                                    "speaker": "派蒙",
                                    "text": "呜，早知道刚才就不应该报真名的。"
                                },
                                {
                                    "id": "750010819",
                                    "speaker": "蒂图",
                                    "text": "赔偿…「蒂图灵光一闪，说不定能够以这样的方式要挟眼前的人达成自己的目的…」"
                                },
                                {
                                    "id": "750010820",
                                    "speaker": "蒂图",
                                    "text": "感觉如果是这样的情节的话，就该插入这样的叙事…"
                                },
                                {
                                    "id": "750010821",
                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "750010822",
                                    "speaker": "蒂图",
                                    "text": "啊，抱歉，光顾着想些故事的事。我是部族里负责讲故{RUBY#[D]叙事人}事的人，讲了许多年的故事，最近到了需要自己想故事的时候了。"
                                },
                                {
                                    "id": "750010823",
                                    "speaker": "蒂图",
                                    "text": "这几天一直在为此烦心，结果「缝影针」也出了问题…老话说得好啊，人倒霉的时候龙也跟着一起倒霉。"
                                },
                                {
                                    "id": "750010824",
                                    "speaker": "蒂图",
                                    "text": "咳咳，我是不会要挟你们的啦，毕竟如果我真的想要要挟你们，就、就不会把脑海里的句子说出口了不是吗。"
                                },
                                {
                                    "id": "750010825",
                                    "speaker": "蒂图",
                                    "text": "哎呀，你看，我们互相报上了名字，却又没有大打出手，这就说明我们已经是朋友啦。"
                                },
                                {
                                    "id": "750010826",
                                    "speaker": "蒂图",
                                    "text": "不知道你们能不能听听朋友我这边的请求啊。"
                                },
                                {
                                    "id": "750010827",
                                    "speaker": "Player",
                                    "text": "只要…不是索要赔偿的话？"
                                },
                                {
                                    "id": "750010828",
                                    "speaker": "蒂图",
                                    "text": "当然不是啦，该怎么说好呢，对了，你们在山谷里漫步的时候，有没有看到一块超级大，还刻有金色花纹的固态燃素块…"
                                },
                                {
                                    "id": "750010829",
                                    "speaker": "蒂图",
                                    "text": "就在这片区域的中心，应该很显眼哦。",
                                    "choices": [
                                        {
                                            "id": "750010830",
                                            "text": "好像有…",
                                            "response": [
                                                {
                                                    "id": "750010833",
                                                    "speaker": "蒂图",
                                                    "text": "我要说的其实就和那个大石柱子有关…那个大石柱子被部族的人们称为「缝影针」，只不过，最近出了一些问题。"
                                                },
                                                {
                                                    "id": "750010834",
                                                    "speaker": "蒂图",
                                                    "text": "在看到你们之前，我都想放弃了，甚至都对自己说，「写一个『缝影针』问题解决不了，灾难毁灭了部族的故事也行啊…」"
                                                },
                                                {
                                                    "id": "750010835",
                                                    "speaker": "派蒙",
                                                    "text": "等等，只是一个石柱子，和毁灭部族有什么关系…"
                                                },
                                                {
                                                    "id": "750010836",
                                                    "speaker": "派蒙",
                                                    "text": "而且你刚才一直在说的「缝影针」，和更刚才说的，我们钻下去的什么「小缝影针」，明明都是大石柱子，为什么叫这个呀？"
                                                },
                                                {
                                                    "id": "750010837",
                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                    "text": "嗯？"
                                                },
                                                {
                                                    "id": "750010838",
                                                    "speaker": "蒂图",
                                                    "text": "#哦，{NICKNAME}和派蒙都是异邦人，确实得解释得更详细一些。这其实和部族里的一个传说故事有关。"
                                                },
                                                {
                                                    "id": "750010839",
                                                    "speaker": "蒂图",
                                                    "text": "故事里说，大灵将「缝影针」悬挂于此，是为了缝住火山大王的影子…"
                                                },
                                                {
                                                    "id": "750010840",
                                                    "speaker": "蒂图",
                                                    "text": "不过真实的历史是这样的，那柱子之下的其实是被封印在此的深渊。"
                                                },
                                                {
                                                    "id": "750010841",
                                                    "speaker": "蒂图",
                                                    "text": "在纳塔，故事大多都是这样，是为了警告，是被叙事装点过的话语，所有的修辞都是一种譬喻。"
                                                },
                                                {
                                                    "id": "750010842",
                                                    "speaker": "派蒙",
                                                    "text": "等等，所以下面的其实是被封印起来的深渊！"
                                                },
                                                {
                                                    "id": "750010843",
                                                    "speaker": "蒂图",
                                                    "text": "是啊，最近三根小的「缝影针」中浮起了两根，说不定等第三根浮起来的时候，底下的坏东西就会跟潮水一样涌出来了。"
                                                },
                                                {
                                                    "id": "750010844",
                                                    "speaker": "蒂图",
                                                    "text": "所以看到你们钻下去了一根，实在是有点喜出望外，所以当然了，也不可能向你们要赔偿啦。"
                                                },
                                                {
                                                    "id": "750010845",
                                                    "speaker": "蒂图",
                                                    "text": "而且，我想向你们请求，能不能把另外一根「小缝影针」也按下去…"
                                                },
                                                {
                                                    "id": "750010846",
                                                    "speaker": "派蒙",
                                                    "text": "#唔…怎么办好呢，{NICKNAME}…",
                                                    "choices": [
                                                        {
                                                            "id": "750010847",
                                                            "text": "…事涉深渊，很难袖手旁观了。",
                                                            "response": [
                                                                {
                                                                    "id": "750010849",
                                                                    "speaker": "#{REALNAME[ID(2)|SHOWHOST(true)]}",
                                                                    "text": "呀！"
                                                                },
                                                                {
                                                                    "id": "750010850",
                                                                    "speaker": "派蒙",
                                                                    "text": "#好吧，既然连{REALNAME[ID(2)|SHOWHOST(true)]}都答应了。"
                                                                },
                                                                {
                                                                    "id": "750010851",
                                                                    "speaker": "蒂图",
                                                                    "text": "哎呀…就像黑暗蒙昧之时总有火光出现，呵呵，危难之际也总能傲立起了不得的豪杰。人类的可能性总在这时候变得相当耀眼啊。"
                                                                },
                                                                {
                                                                    "id": "750010852",
                                                                    "speaker": "蒂图",
                                                                    "text": "#说不定这也能是个了不起的好故事，{NICKNAME}，你拥有一些故事里的英雄也不具备的气质呢，真让人期待。"
                                                                },
                                                                {
                                                                    "id": "750010853",
                                                                    "speaker": "蒂图",
                                                                    "text": "走吧，英雄们，我们这就出发，去看看剩下那根浮起来的「缝影针」吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "750010848",
                                                            "text": "或许我们可以帮上一点忙？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "750010831",
                                            "text": "没有什么印象了…",
                                            "response": [
                                                {
                                                    "id": "750010832",
                                                    "speaker": "蒂图",
                                                    "text": "是嘛，那个大家伙明明挺显眼的，不过没关系。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "750010809",
                            "text": "是派蒙干的，我只是从犯…",
                            "response": [
                                {
                                    "id": "750010810",
                                    "speaker": "派蒙",
                                    "text": "哇，这种时候你总是这样，我也是会生气的哦！"
                                },
                                {
                                    "id": "750010811",
                                    "speaker": "？？？",
                                    "text": "#哈哈，不用那么紧张，不如说，真是让人松了口气。这位小小的女士叫派蒙，那这位{M#兄弟}{F#小姐}的名字呢？"
                                },
                                {
                                    "id": "750010812",
                                    "speaker": "Player",
                                    "text": "#我叫{NICKNAME}。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}