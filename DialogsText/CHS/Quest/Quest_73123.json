            "id": "7312301",
            "objective": "",
            "dialogues": [
                {
                    "id": "731230101",
                    "speaker": "收集材料的兰那罗",
                    "text": "哦！是那菈朋友！大家都说，那菈朋友的「背包」很大…为了桓那，兰那罗需要很多「材料」，那菈朋友可以帮忙吗？"
                },
                {
                    "id": "731230102",
                    "speaker": "收集材料的兰那罗",
                    "text": "很多「材料」，是指很多蘑菇！<color=#00E1FFFF>普通的星蕈，没精神的星蕈，太有精神的星蕈</color>，全都需要…"
                }
            ]
        },
        {
            "id": "7312302",
            "objective": "",
            "dialogues": [
                {
                    "id": "731230201",
                    "speaker": "收集材料的兰那罗",
                    "text": "<color=#00E1FFFF>三种星蕈</color>，是很多蘑菇，但是，「大有用处」？"
                }
            ]
        },
        {
            "id": "7312305",
            "objective": "",
            "dialogues": [
                {
                    "id": "731230301",
                    "speaker": "收集材料的兰那罗",
                    "text": "「有求必应」！金色的那菈，好厉害的「背包」，什么都有…感谢好那菈！"
                },
                {
                    "id": "731230302",
                    "speaker": "收集材料的兰那罗",
                    "text": "嘿嘿，回桓那兰那去咯，好那菈，再见啦！"
                }
            ]
        },
        {
            "id": "7312399",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "731239911",
                    "speaker": "派蒙",
                    "text": "欸？这个好像是之前那种…小精灵…"
                }
            ]
        }
    ]
