{
    "quest": {
        "id": "20505",
        "title": "繁忙的冒险家协会",
        "description": "愿意前来委托冒险家协会的人越来越多，凯瑟琳似乎有点忙不过来了。",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 34,
        "total_speaker_counts": {
            "Player": 8,
            "凯瑟琳": 23,
            "派蒙": 3
        }
    },
    "talks": [
        {
            "id": "2050501",
            "objective": "与凯瑟琳对话",
            "dialogues": [
                {
                    "id": "205050101",
                    "speaker": "凯瑟琳",
                    "text": "不好意思，又把你叫过来。",
                    "choices": [
                        {
                            "id": "205050102",
                            "text": "没关系，平时受了很多照顾。",
                            "response": [
                                {
                                    "id": "205050103",
                                    "speaker": "凯瑟琳",
                                    "text": "你能这么说真是太好了，那我尽量长话短说。"
                                },
                                {
                                    "id": "205050106",
                                    "speaker": "凯瑟琳",
                                    "text": "很感谢你之前能帮忙完成协会的委托，冒险家协会的风评也变得越来越好了。"
                                },
                                {
                                    "id": "205050107",
                                    "speaker": "凯瑟琳",
                                    "text": "不过因为这个，愿意来委托协会的人越来越多，现在冒险家们已经有点忙不过来了。"
                                },
                                {
                                    "id": "205050108",
                                    "speaker": "派蒙",
                                    "text": "是要我们去当宣传员吗？"
                                },
                                {
                                    "id": "205050109",
                                    "speaker": "凯瑟琳",
                                    "text": "啊，不是的，有这份心我很感激。我也希望能有更多新人加入协会…"
                                },
                                {
                                    "id": "205050110",
                                    "speaker": "凯瑟琳",
                                    "text": "但现在再去找新人，有点远水救不了近火的感觉。"
                                },
                                {
                                    "id": "205050111",
                                    "speaker": "凯瑟琳",
                                    "text": "我想问问看，不知道你的朋友有时间帮这个忙吗？",
                                    "choices": [
                                        {
                                            "id": "205050112",
                                            "text": "需要和他们商量一下。",
                                            "response": [
                                                {
                                                    "id": "205050113",
                                                    "speaker": "凯瑟琳",
                                                    "text": "太好了，谢谢你。"
                                                },
                                                {
                                                    "id": "205050117",
                                                    "speaker": "凯瑟琳",
                                                    "text": "总之我先说明一下吧，现在比较紧急的是这种<color=#00E1FFFF>「探索派遣」</color>。"
                                                },
                                                {
                                                    "id": "205050118",
                                                    "speaker": "Player",
                                                    "text": "「探索派遣」？"
                                                },
                                                {
                                                    "id": "205050119",
                                                    "speaker": "凯瑟琳",
                                                    "text": "我们会随时关注城市周边和野外，比如存在潜在的危险，或者地下遗迹又有异常之类的情况。"
                                                },
                                                {
                                                    "id": "205050120",
                                                    "speaker": "凯瑟琳",
                                                    "text": "因为不是来自他人的委托，所以没有时间限制。"
                                                },
                                                {
                                                    "id": "205050121",
                                                    "speaker": "凯瑟琳",
                                                    "text": "但如果因为繁忙就长期搁置，可能隐患就会变成巨大的灾难。"
                                                },
                                                {
                                                    "id": "205050122",
                                                    "speaker": "派蒙",
                                                    "text": "听起来确实很重要…",
                                                    "choices": [
                                                        {
                                                            "id": "205050123",
                                                            "text": "朋友们应该可以理解。",
                                                            "response": [
                                                                {
                                                                    "id": "205050124",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "只要他们答应帮忙，剩下的手续交给我就好。"
                                                                },
                                                                {
                                                                    "id": "205050127",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "那事不宜迟，为你介绍一下目前的「探索派遣」有哪些吧。"
                                                                },
                                                                {
                                                                    "id": "205050128",
                                                                    "speaker": "Player",
                                                                    "text": "确认「探索派遣」"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "205050125",
                                                            "text": "报酬呢？",
                                                            "response": [
                                                                {
                                                                    "id": "205050126",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "放心，探索中的收获协会分文不取，全都归你们。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "205050114",
                                            "text": "原来想劝我的朋友加入协会？！",
                                            "response": [
                                                {
                                                    "id": "205050115",
                                                    "speaker": "凯瑟琳",
                                                    "text": "不不不，你误会了。我明白你的朋友有各种各样的身份，让他们都加入很不现实。"
                                                },
                                                {
                                                    "id": "205050116",
                                                    "speaker": "凯瑟琳",
                                                    "text": "这更像是协会的不情之请。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "205050104",
                            "text": "又有报酬可以拿了？",
                            "response": [
                                {
                                    "id": "205050105",
                                    "speaker": "凯瑟琳",
                                    "text": "哈哈…确实是这样，看来你很感兴趣的样子。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2050502",
            "objective": "(test)与凯瑟琳对话（隐藏）$HIDDEN",
            "dialogues": [
                {
                    "id": "205050201",
                    "speaker": "凯瑟琳",
                    "text": "你可以随时承接「探索派遣」，而执行委托的伙伴在此期间仍然可以和你一起冒险。"
                },
                {
                    "id": "205050202",
                    "speaker": "凯瑟琳",
                    "text": "进行不同程度的探索会花费不同的时间，探索完成后，只需要来我这里确认一下成果就好了。"
                },
                {
                    "id": "205050203",
                    "speaker": "凯瑟琳",
                    "text": "随着「冒险等阶」的提高，还可以去更多更危险的地方探索。"
                },
                {
                    "id": "205050204",
                    "speaker": "派蒙",
                    "text": "这就是能力越大，责任越大吧！"
                },
                {
                    "id": "205050205",
                    "speaker": "凯瑟琳",
                    "text": "是的，当然这也是为了各位的安全着想。"
                },
                {
                    "id": "205050206",
                    "speaker": "凯瑟琳",
                    "text": "再次感谢你的帮助，希望你和你的伙伴能多多承接「探索派遣」哦。"
                }
            ]
        }
    ]
}