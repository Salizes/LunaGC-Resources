    "talks": [
        {
            "id": "2103601",
            "objective": "与孙宇对话",
            "dialogues": [
                {
                    "id": "210360201",
                    "speaker": "Player",
                    "text": "对抗敌人。"
                },
                {
                    "id": "210360202",
                    "speaker": "孙宇",
                    "text": "好！我早就想要把我学习的剑术用在实处了…"
                },
                {
                    "id": "210360203",
                    "speaker": "Player",
                    "text": "只怕你看不清我的动作。"
                },
                {
                    "id": "210360204",
                    "speaker": "孙宇",
                    "text": "这…阁下武艺竟如此高强？哈哈哈，那就只能请阁下把动作稍稍放慢些啦。"
                },
                {
                    "id": "210360205",
                    "speaker": "孙宇",
                    "text": "我看看…附近就有一处魔物的聚集地，咱们就先去那里好了。"
                }
            ]
        },
        {
            "id": "2103607",
            "objective": "（test）记录打怪对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2103606",
            "objective": "(test)记录跑酷对话$HIDDEN",
            "dialogues": [
                {
                    "id": "210360301",
                    "speaker": "Player",
                    "text": "越野训练。"
                },
                {
                    "id": "210360302",
                    "speaker": "孙宇",
                    "text": "那就太好了，那位冒险家帮我规划了一条越野路线…唉，我能进来这里锻炼，也是托了她的福。"
                },
                {
                    "id": "210360303",
                    "speaker": "孙宇",
                    "text": "她说我只要尽快到达终点就好…但我每次用的时间都实在太长…"
                },
                {
                    "id": "210360304",
                    "speaker": "孙宇",
                    "text": "所以，我想拜托你为我示范一下如何快速「越野」，我会在后面努力跟上的。",
                    "choices": [
                        {
                            "id": "210360305",
                            "text": "没问题。",
                            "response": [
                                {
                                    "id": "210360308",
                                    "speaker": "孙宇",
                                    "text": "那就拜托你了，我们先去训练地点吧。"
                                }
                            ]
                        },
                        {
                            "id": "210360306",
                            "text": "你可别被我甩远了。",
                            "response": [
                                {
                                    "id": "210360307",
                                    "speaker": "孙宇",
                                    "text": "咳…我…我努力跟上，但说实话，我的脚力实在是有限啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103602",
            "objective": "打倒所有敌人",
            "dialogues": []
        },
        {
            "id": "2103608",
            "objective": "开始「锻炼」",
            "dialogues": [
                {
                    "id": "210360801",
                    "speaker": "孙宇",
                    "text": "呼…呼…呼…你怎么…怎么能跑得这么快…",
                    "choices": [
                        {
                            "id": "210360802",
                            "text": "是你跑得太慢了。",
                            "response": [
                                {
                                    "id": "210360803",
                                    "speaker": "孙宇",
                                    "text": "甘拜下风…甘拜下风…"
                                },
                                {
                                    "id": "210360806",
                                    "speaker": "孙宇",
                                    "text": "呼…总算是把气喘匀了。没想到「越野」居然这么累人…"
                                },
                                {
                                    "id": "210360807",
                                    "speaker": "孙宇",
                                    "text": "谢谢你给我做示范，旅行者，这些报酬请你收下吧。"
                                }
                            ]
                        },
                        {
                            "id": "210360804",
                            "text": "你还得多多锻炼啊。",
                            "response": [
                                {
                                    "id": "210360805",
                                    "speaker": "孙宇",
                                    "text": "你说得…说得对…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2103603",
            "objective": "在限时时间内抵达终点",
            "dialogues": []
        },
        {
            "id": "2103604",
            "objective": "与孙宇对话",
            "dialogues": [
                {
                    "id": "210360401",
                    "speaker": "孙宇",
                    "text": "呼…呼…真是难以对付…"
                },
                {
                    "id": "210360402",
                    "speaker": "孙宇",
                    "text": "抱歉，让你见笑了。看来我还是没多少长进…"
                },
                {
                    "id": "210360403",
                    "speaker": "孙宇",
                    "text": "我还是需要多多锻炼…多谢了旅行者，这些报酬给你，请收下吧。"
                },
                {
                    "id": "210360404",
                    "speaker": "Player",
                    "text": "你要怎么离开璃月？"
                },
                {
                    "id": "210360405",
                    "speaker": "孙宇",
                    "text": "唔…我现在打算的是，搭那位客商的船，从水路向外旅行。"
                },
                {
                    "id": "210360406",
                    "speaker": "孙宇",
                    "text": "第一站…我想先去枫丹看看，然后在那里待一段时间，之后再做打算。"
                },
                {
                    "id": "210360407",
                    "speaker": "孙宇",
                    "text": "唉，也不知道我能不能说服师妹和我同行…"
                }
            ]
        },
        {
            "id": "2103605",
            "objective": "与孙宇对话",
            "dialogues": [
                {
                    "id": "210360501",
                    "speaker": "孙宇",
                    "text": "呼…呼…呼…你怎么…怎么能跑得这么快…",
                    "choices": [
                        {
                            "id": "210360502",
                            "text": "是你跑得太慢了。",
                            "response": [
                                {
                                    "id": "210360503",
