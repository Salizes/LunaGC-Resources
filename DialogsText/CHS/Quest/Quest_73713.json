    "talks": [
        {
            "id": "7371301",
            "objective": "前往游览地点",
            "dialogues": [
                {
                    "id": "737130101",
                    "speaker": "派蒙",
                    "text": "锵锵！就是这里了，从一片浅滩下水，应该会有画卷慢慢展开的感觉！"
                },
                {
                    "id": "737130102",
                    "speaker": "玛因",
                    "text": "咦，是你们…还带了新伙伴？这个是…蕈兽吗？以前只在书上看到过…"
                },
                {
                    "id": "737130103",
                    "speaker": "派蒙",
                    "text": "真巧，还有美露莘在这里玩！",
                    "choices": [
                        {
                            "id": "737130104",
                            "text": "又见面啦，玛因。",
                            "response": [
                                {
                                    "id": "737130106",
                                    "speaker": "玛因",
                                    "text": "不是玩哦，是在采汐藻，准备制作今年份的腌制汐藻，许多姐姐妹妹都回到了村里帮忙。"
                                },
                                {
                                    "id": "737130107",
                                    "speaker": "玛因",
                                    "text": "昂吉安妮大姐头和小萝克珊都请假回来了，现在正忙活呢，待会儿我也要下水了。"
                                },
                                {
                                    "id": "737130108",
                                    "speaker": "玛因",
                                    "text": "说起来，昂吉安妮大姐头没说错，蓝色的蕈兽还真的有点像汐藻…"
                                },
                                {
                                    "id": "737130109",
                                    "speaker": "玛因",
                                    "text": "我的意思是，很招人喜欢，没有想吃的意思…嗯。"
                                },
                                {
                                    "id": "737130110",
                                    "speaker": "咚咚小圆帽",
                                    "text": "♫♪~"
                                },
                                {
                                    "id": "737130111",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，你很有眼光嘛！",
                                    "choices": [
                                        {
                                            "id": "737130112",
                                            "text": "蕈兽伙伴确实可爱。",
                                            "response": [
                                                {
                                                    "id": "737130114",
                                                    "speaker": "玛因",
                                                    "text": "总而言之，很高兴遇见你们，我要去干活了，也祝你们在附近玩得开心。"
                                                },
                                                {
                                                    "id": "737130115",
                                                    "speaker": "派蒙",
                                                    "text": "那我们也出发吧？和蕈兽伙伴们好好拍拍枫丹水下的漂亮景观！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737130113",
                                            "text": "美露莘们也都不赖。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737130105",
                            "text": "你好呀，没见过的美露莘。"
                        }
                    ]
                }
            ]
        }
    ]
