    },
    "talks": [
        {
            "id": "7108802",
            "objective": "",
            "dialogues": [
                {
                    "id": "710880201",
                    "speaker": "海迪夫",
                    "text": "你好！啊，原来是你呀！"
                },
                {
                    "id": "710880221",
                    "speaker": "海迪夫",
                    "text": "哈，他们还真把你给找来了。",
                    "choices": [
                        {
                            "id": "710880202",
                            "text": "没错，是我。",
                            "response": [
                                {
                                    "id": "710880204",
                                    "speaker": "海迪夫",
                                    "text": "哎哟，失礼失礼！我叫海迪夫，海迪夫·普尔希纳。"
                                },
                                {
                                    "id": "710880205",
                                    "speaker": "海迪夫",
                                    "text": "哈哈，如果你了解学院历史的话，我们的祖师们在星相学上曾是普尔比鲁尼一系的宿敌。",
                                    "choices": [
                                        {
                                            "id": "710880206",
                                            "text": "#我是{NICKNAME}。",
                                            "response": [
                                                {
                                                    "id": "710880207",
                                                    "speaker": "海迪夫",
                                                    "text": "不必特意自我介绍啦，你的大名我早已有所耳闻了。"
                                                },
                                                {
                                                    "id": "710880211",
                                                    "speaker": "Player",
                                                    "text": "你在这里做什么？"
                                                },
                                                {
                                                    "id": "710880212",
                                                    "speaker": "海迪夫",
                                                    "text": "我是总务司特约的调查学者，负责在层岩巨渊重新开放之前进入矿井调查生物群落变化情况，以及考察古生物种群…"
                                                },
                                                {
                                                    "id": "710880213",
                                                    "speaker": "海迪夫",
                                                    "text": "当然，作为交换条件，我需要将研究成果与璃月本地的历史学会共享。"
                                                },
                                                {
                                                    "id": "710880214",
                                                    "speaker": "海迪夫",
                                                    "text": "唉，我知道你想说什么…原则上这是违反教令院规则的，但璃月方面表态强硬，没人能让他们有所动摇。"
                                                },
                                                {
                                                    "id": "710880215",
                                                    "speaker": "海迪夫",
                                                    "text": "另外呢，由于勘探队名义上是由我牵头的，我还要负责营地所有矿工的开销…唉，要是得不偿失可就太亏了。",
                                                    "choices": [
                                                        {
                                                            "id": "710880216",
                                                            "text": "是啊…",
                                                            "response": [
                                                                {
                                                                    "id": "710880218",
                                                                    "speaker": "海迪夫",
                                                                    "text": "不过没关系的，不需要安慰我。我很有钱。"
                                                                },
                                                                {
                                                                    "id": "710880219",
                                                                    "speaker": "Player",
                                                                    "text": "好吧，告辞。"
                                                                },
                                                                {
                                                                    "id": "710880220",
                                                                    "speaker": "海迪夫",
                                                                    "text": "再见！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710880217",
                                                            "text": "真是不容易。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710880208",
                                            "text": "自报师门是须弥传统吗？",
                                            "response": [
                                                {
                                                    "id": "710880209",
                                                    "speaker": "海迪夫",
                                                    "text": "哈哈，不是这样的。怎么说…算是身为学者的自矜吧。"
                                                },
                                                {
                                                    "id": "710880210",
                                                    "speaker": "海迪夫",
                                                    "text": "说起来还都怪阿妮萨学姐那家伙…把普尔比鲁尼一门的坏毛病传染给我咯。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710880203",
                            "text": "我认识你吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7108803",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "710880301",
                    "speaker": "瑾武",
                    "text": "哟，是新面孔，你好，年轻人！"
                },
                {
                    "id": "710880302",
                    "speaker": "Player",
                    "text": "新面孔？"
                },
                {
                    "id": "710880303",
                    "speaker": "瑾武",
                    "text": "哈哈…矿上的每一个人不好说认识吧，至少都能叫得出名字。不过你嘛…是第一次来矿上，对吧？"
                },
                {
                    "id": "710880304",
                    "speaker": "Player",
                    "text": "#{NICKNAME}，幸会。"
                },
                {
                    "id": "710880305",
                    "speaker": "瑾武",
                    "text": "瑾武，管设备的。在矿上干了二十来年，算是这帮小伙子的大姐。有什么不懂的可以来找我，设备出毛病了找我也行。"
                },
                {
                    "id": "710880306",
                    "speaker": "瑾武",
                    "text": "或者，单纯听大姐闲扯两句历史故事什么的，我也欢迎。闲着也是闲着嘛。",
                    "choices": [
                        {
                            "id": "710880307",
                            "text": "关于层岩巨渊的历史…",
                            "response": [
                                {
                                    "id": "710880308",
                                    "speaker": "瑾武",
                                    "text": "那可就说来话长了…我就给你简短介绍一下吧。"
                                },
                                {
                                    "id": "710880309",
                                    "speaker": "瑾武",
                                    "text": "层岩巨渊是璃月最大的矿产基地，也是天衡山矿区之后第二古老的矿区。"
                                },
                                {
                                    "id": "710880310",
                                    "speaker": "瑾武",
                                    "text": "传说在岩王爷到来之前，这里就居住着以开采琉璃晶砂、交易陶瓷制成品为生的部族…"
                                },
                                {
                                    "id": "710880311",
                                    "speaker": "瑾武",
                                    "text": "后来这些部族与岩王爷的夜叉信使歃血为盟，自成一支，于是便成为了今日八门之一——盛露厅的前身。"
                                },
                                {
                                    "id": "710880312",
                                    "speaker": "瑾武",
                                    "text": "他们也参加了镇压若陀龙王与击退漆黑灾祸的大战…可谓劳苦功高。"
                                },
                                {
                                    "id": "710880313",
                                    "speaker": "瑾武",
                                    "text": "你看，西北面的那座谷地…传说就是当年岩王爷将若陀龙王拖离层岩巨渊，活生生拖出来的痕迹呢。"
                                },
                                {
                                    "id": "710880314",
                                    "speaker": "瑾武",
                                    "text": "后来呀，待到褪尽蛮荒，习惯了城市生活的部民便随岩王爷迁入城中，专以制造和贩卖瓷器为业，不再顾兵戈之事了。"
                                },
                                {
                                    "id": "710880315",
                                    "speaker": "瑾武",
                                    "text": "哈哈…所以别看盛露厅如今都是些斤斤计较的瓷器商人，祖上也是同岩王爷并肩打过硬仗的。"
                                }
                            ]
                        },
                        {
                            "id": "710880316",
                            "text": "关于层岩巨渊…",
                            "response": [
                                {
                                    "id": "710880317",
                                    "speaker": "瑾武",
                                    "text": "几年前矿区封锁时我也在场，听说下层的小伙子们挖到了不得了的东西。"
                                },
                                {
                                    "id": "710880318",
                                    "speaker": "瑾武",
                                    "text": "我光记得那时候伤员被接连不断地运上地面…"
                                },
                                {
                                    "id": "710880319",
                                    "speaker": "瑾武",
                                    "text": "更邪门的是，小伙子们受的伤并不是矿下面常见的工伤，而是…呃，有点像精神上的打击，你懂吧？"
                                },
                                {
                                    "id": "710880320",
                                    "speaker": "瑾武",
                                    "text": "把小伙子们送到地面之后，他们过几天就慢慢恢复正常了…虽然没造成什么严重损失，但还是引起了七星的震动。"
                                },
                                {
                                    "id": "710880321",
                                    "speaker": "瑾武",
                                    "text": "不管他们挖到了什么，一定不是什么好东西就对了。玉京台的大人们可能也是这样想的…就全面封锁了层岩巨渊。"
                                },
                                {
                                    "id": "710880322",
                                    "speaker": "瑾武",
                                    "text": "结果呢，盛露厅可不高兴了…哈哈，那就是另一个话题咯。"
                                }
                            ]
                        },
                        {
                            "id": "710880323",
                            "text": "关于你的工作…",
                            "response": [
                                {
                                    "id": "710880324",
                                    "speaker": "瑾武",
                                    "text": "我？管设备的。二十来年了，别人家孩子上学的年纪我就在鼓捣晶石矿灯和滤水器了，没什么好说的。"
                                },
                                {
                                    "id": "710880325",
                                    "speaker": "瑾武",
                                    "text": "#{M#认识了一拨又一拨矿工，初次下矿时也比你大不了多少。}{F#女孩子可不要做这种工作，像我一样把大好时光浪费在矿上，整天一身臭汗忙来忙去，不值得的。}"
                                }
                            ]
                        },
                        {
                            "id": "710880326",
                            "text": "关于「七星阵法」…",
                            "response": [
                                {
                                    "id": "710880327",
                                    "speaker": "瑾武",
                                    "text": "那是「七星」专门设立的阵法，为的就是防君子不防…哈哈，不开玩笑了。"
                                },
                                {
                                    "id": "710880328",
                                    "speaker": "瑾武",
                                    "text": "总之，这阵法在行政上是最高级别的封印，任何人看到它就会自然想到，擅自解封的话，要面临什么样的问责。"
                                },
                                {
                                    "id": "710880329",
                                    "speaker": "瑾武",
                                    "text": "所以呢，「七星」专门以过于显眼的「磐键」作为固定阵法的节点，也是为了显示权威…"
                                },
                                {
                                    "id": "710880330",
                                    "speaker": "瑾武",
                                    "text": "让小贼们即使有贼心，也没有贼胆大张旗鼓地解除封印，引得大人物震怒。"
                                },
                                {
                                    "id": "710880331",
                                    "speaker": "瑾武",
                                    "text": "咳咳…换句话说，如果有人真的解除了封印，而没有受到有效干涉…就证明那家伙至少得到了「七星」的默许。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}