    "talks": [
        {
            "id": "1913101",
            "objective": "前往群玉阁见凝光",
            "dialogues": []
        },
        {
            "id": "1913102",
            "objective": "与百识交谈",
            "dialogues": []
        },
        {
            "id": "1913102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191310298",
                    "speaker": "Player",
                    "text": "（总之…尽量避开专业性的事项吧。）"
                },
                {
                    "id": "191310299",
                    "speaker": "Player",
                    "text": "（总之…认真地试试看吧。）"
                }
            ]
        },
        {
            "id": "1913105",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191310501",
                    "speaker": "凝光",
                    "text": "(test)……"
                },
                {
                    "id": "191310502",
                    "speaker": "Player",
                    "text": "(test)凝光！起床啦！"
                },
                {
                    "id": "191310503",
                    "speaker": "凝光",
                    "text": "(test)我起来了。今天给我安排了什么行程呢？"
                },
                {
                    "id": "191310504",
                    "speaker": "凝光",
                    "text": "(test)今天放个假吧，我们去休息！"
                },
                {
                    "id": "191310505",
                    "speaker": "凝光",
                    "text": "(test)哦？放假？也好，我也很久没有休闲了。那我们要去做什么呢？"
                },
                {
                    "id": "191310598",
                    "speaker": "Player",
                    "text": "(test)凝光有没有一直想做的事？"
                },
                {
                    "id": "191310599",
                    "speaker": "Player",
                    "text": "(test)凝光有没有最近在考虑的事情？"
                }
            ]
        },
        {
            "id": "1913106",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191310601",
                    "speaker": "凝光",
                    "text": "(test)嗯……我最近一直想做一套新的棋戏。"
                },
                {
                    "id": "191310602",
                    "speaker": "凝光",
                    "text": "(test)我还想把你做成其中一颗棋子呢。"
                },
                {
                    "id": "191310603",
                    "speaker": "Player",
                    "text": "(test)我吗？"
                },
                {
                    "id": "191310604",
                    "speaker": "凝光",
                    "text": "(test)对，就是你。走吧，我们去春香窑找我的一个老相识。"
                }
            ]
        },
        {
            "id": "1913107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191310701",
                    "speaker": "凝光",
                    "text": "(test)一直想做的事吗……我倒是一直想体会一下白手起家重新创业的感觉，找回一下当时的激情。"
                },
                {
                    "id": "191310702",
                    "speaker": "凝光",
                    "text": "(test)如果我不用任何现在的资源重新开始，不知道能做到哪一步？"
                },
                {
                    "id": "191310703",
                    "speaker": "凝光",
                    "text": "(test)你觉得我白手起家，应该能做点什么呢？"
                },
                {
                    "id": "191310798",
                    "speaker": "Player",
                    "text": "(test)凝光这么懂商业，我觉得可以试试去北国银行当金融顾问。"
                },
                {
                    "id": "191310799",
                    "speaker": "Player",
                    "text": "(test)我们可以去试试收破烂。"
                }
            ]
        },
        {
            "id": "1913108",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191310801",
                    "speaker": "凝光",
                    "text": "(test)废品生意吗？倒也是一种稳妥的办法。那我们这就动身吧。"
                },
                {
                    "id": "191310802",
                    "speaker": "凝光",
                    "text": "(test)码头的仓库管理员狗三儿那里应该每天都会处理一些不用的东西，我们去问问他吧。"
                }
            ]
        },
        {
            "id": "1913109",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "191310901",
                    "speaker": "凝光",
                    "text": "(test)你确定北国银行会让我去给他们当顾问？"
                },
                {
                    "id": "191310902",
                    "speaker": "凝光",
                    "text": "(test)不过既然是你的提议，我们去看看也无妨。"
                }
            ]
        }
    ]
}