            "dialogues": [
                {
                    "id": "411590401",
                    "speaker": "Player",
                    "text": "还有别的事。"
                },
                {
                    "id": "411590402",
                    "speaker": "言笑",
                    "text": "那你忙着吧，我想想怎么办。"
                }
            ]
        },
        {
            "id": "4115901",
            "objective": "与言笑对话",
            "dialogues": [
                {
                    "id": "411590101",
                    "speaker": "Player",
                    "text": "我这就送过去。"
                },
                {
                    "id": "411590102",
                    "speaker": "言笑",
                    "text": "那麻烦你了。杏仁豆腐这东西，你明白吧，<color=#00E1FFFF>剧烈颠簸可能就碎了</color>。"
                },
                {
                    "id": "411590103",
                    "speaker": "言笑",
                    "text": "<color=#00E1FFFF>所以别乱飞乱爬乱跑。</color>路上注意一下。"
                }
            ]
        },
        {
            "id": "4115902",
            "objective": "将餐品送给随缘的铃官",
            "dialogues": [
                {
                    "id": "411590201",
                    "speaker": "随缘的铃官",
                    "text": "我觉得也该到了。"
                }
            ]
        },
        {
            "id": "4115903",
            "objective": "与随缘的铃官对话",
            "dialogues": [
                {
                    "id": "411590601",
                    "speaker": "Player",
                    "text": "这是您订的餐。"
                },
                {
                    "id": "411590602",
                    "speaker": "随缘的铃官",
                    "text": "嘿嘿，谢谢你啦。我还以为走这么近，望舒客栈就不送了呢。"
                }
            ]
        },
        {
            "id": "4115903",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411590301",
                    "speaker": "Player",
                    "text": "听说有特别订单…"
                },
                {
                    "id": "411590302",
                    "speaker": "言笑",
                    "text": "是的。铃官这人要了一份杏仁豆腐，然后就又往明蕴镇方向去了。"
                },
                {
                    "id": "411590303",
                    "speaker": "言笑",
                    "text": "明蕴镇可是个怪地方啊。"
                },
                {
                    "id": "411590304",
                    "speaker": "言笑",
                    "text": "总之这份杏仁豆腐希望有人能帮忙给她送过去。"
                }
            ]
        },
        {
            "id": "4115905",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "411590501",
                    "speaker": "随缘的铃官",
                    "text": "这里我熟悉啊。"
                }
            ]
        }
    ]
