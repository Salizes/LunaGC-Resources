    "talks": [
        {
            "id": "7050011",
            "objective": "",
            "dialogues": [
                {
                    "id": "705001101",
                    "speaker": "留云借风真君",
                    "text": "照看火候的事，就交给你负责了，旅行者。"
                }
            ]
        },
        {
            "id": "7050001",
            "objective": "与留云借风真君对话",
            "dialogues": [
                {
                    "id": "705000101",
                    "speaker": "留云借风真君",
                    "text": "冰天雪地，玉树琼枝…寂寞又冷冽之地啊。本仙这第三道菜，倒是应景得很。"
                },
                {
                    "id": "705000102",
                    "speaker": "Player",
                    "text": "这次又要做什么菜？"
                },
                {
                    "id": "705000103",
                    "speaker": "留云借风真君",
                    "text": "唔…本仙问你，你有没有听说过一种名为「烩」的烹饪手法？这种手法也是本仙翻阅食谱时偶然发现的。"
                },
                {
                    "id": "705000104",
                    "speaker": "留云借风真君",
                    "text": "本仙深感有趣，特意以这种烹饪手法为核心，写出了一份名为「红烩兽肉」的新食谱。"
                },
                {
                    "id": "705000105",
                    "speaker": "留云借风真君",
                    "text": "虽然对本仙的「机关烹饪神机」来说，这道菜并不麻烦，但「红烩兽肉」这道菜重点在肉，所用的兽肉必须是优品…"
                },
                {
                    "id": "705000106",
                    "speaker": "留云借风真君",
                    "text": "因此，本仙开启机关，一路追寻着食材的气息来到这里。"
                },
                {
                    "id": "705000107",
                    "speaker": "留云借风真君",
                    "text": "此处风雪弥漫，实难办事。"
                },
                {
                    "id": "705000108",
                    "speaker": "留云借风真君",
                    "text": "旅行者，本仙知道你见识广阔又精于冒险，区区雪山，对你而言，肯定不在话下。"
                },
                {
                    "id": "705000109",
                    "speaker": "留云借风真君",
                    "text": "就请你再为本仙跑一趟，寻些食材回来吧。",
                    "choices": [
                        {
                            "id": "705000110",
                            "text": "第三份食谱我也要哦。",
                            "response": [
                                {
                                    "id": "705000111",
                                    "speaker": "留云借风真君",
                                    "text": "自然忘不了你的。那这件事就交给你了，本仙就在这里等着你。"
                                },
                                {
                                    "id": "705000112",
                                    "speaker": "留云借风真君",
                                    "text": "呃，机关怎么突然停了，难不成是周遭太冷…"
                                },
                                {
                                    "id": "705000113",
                                    "speaker": "留云借风真君",
                                    "text": "待本仙重启一下…"
                                },
                                {
                                    "id": "705000114",
                                    "speaker": "留云借风真君",
                                    "text": "机关烹饪神机…启！"
                                },
                                {
                                    "id": "705000115",
                                    "speaker": "留云借风真君",
                                    "text": "这下应该好了…旅行者，你快循着气息的踪迹，去把本仙要的食材拿回来吧。"
                                }
                            ]
                        },
                        {
                            "id": "705000116",
                            "text": "您冷得飞不动了吗？",
                            "response": [
                                {
                                    "id": "705000117",
                                    "speaker": "留云借风真君",
                                    "text": "笑话！本仙威能，岂容你小觑！本仙只是、只是…需要在此修缮机关罢了！"
                                },
                                {
                                    "id": "705000118",
                                    "speaker": "留云借风真君",
                                    "text": "你且快去快回吧，莫要让本仙等待太久。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050002",
            "objective": "跟随气息的踪迹，寻找食材",
            "dialogues": [
                {
                    "id": "705000201",
                    "speaker": "留云借风真君",
                    "text": "怎么样，你拿到本仙要的食材了吗？"
                }
            ]
        },
        {
            "id": "7050003",
            "objective": "向留云借风真君回报",
            "dialogues": [
                {
                    "id": "705000301",
                    "speaker": "留云借风真君",
                    "text": "怎么样？「红烩兽肉」已经做好了吗？"
                }
            ]
        },
        {
            "id": "7050007",
            "objective": "向留云借风真君回报",
            "dialogues": [
                {
                    "id": "705000501",
                    "speaker": "留云借风真君",
                    "text": "这是…什么肉？"
                },
                {
                    "id": "705000502",
                    "speaker": "Player",
                    "text": "冷鲜肉。"
                },
                {
                    "id": "705000503",
                    "speaker": "留云借风真君",
                    "text": "冷鲜肉…名字倒是贴切。"
                },
                {
                    "id": "705000504",
                    "speaker": "留云借风真君",
                    "text": "唔…品质不错。但看肉的状态，还需要稍加小火，化冻才行。"
                },
                {
                    "id": "705000505",
                    "speaker": "留云借风真君",
                    "text": "幸好，本仙设计的「机关烹饪神机」兼有解冻之能…",
                    "choices": [
                        {
                            "id": "705000506",
                            "text": "这机关好像什么功能都不缺。",
                            "response": [
                                {
                                    "id": "705000507",
                                    "speaker": "留云借风真君",
                                    "text": "怎么会呢？要说功能缺失，自然也有。例如，自动取回食材啊，自动控制火候…之类的。"
                                },
                                {
                                    "id": "705000508",
                                    "speaker": "留云借风真君",
                                    "text": "这机关，还是需要多多改进。"
                                },
                                {
                                    "id": "705000509",
                                    "speaker": "留云借风真君",
                                    "text": "好了，闲话不多说。既然食材备齐，本仙马上就去开启机关。"
                                },
                                {
                                    "id": "705000510",
                                    "speaker": "留云借风真君",
                                    "text": "照看火候的事，依然交给你负责，旅行者。"
                                },
                                {
                                    "id": "705000511",
                                    "speaker": "留云借风真君",
                                    "text": "你准备好之后，速来知会本仙。"
                                }
                            ]
                        },
                        {
                            "id": "705000512",
                            "text": "仙人，果然很强大。",
                            "response": [
                                {
                                    "id": "705000513",
                                    "speaker": "留云借风真君",
                                    "text": "与其赞赏仙力，本仙更希望你赞赏「机关烹饪神机」的巧能。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7050009",
            "objective": "向留云借风真君回报",
            "dialogues": [
                {
                    "id": "705000901",
                    "speaker": "Player",
                    "text": "准备好了"
                },
                {
                    "id": "705000902",
                    "speaker": "留云借风真君",
                    "text": "那我们就开始吧。"
                },
                {
                    "id": "705000903",
                    "speaker": "留云借风真君",
                    "text": "机关烹饪神机…启！"
                }
            ]
        },
        {
            "id": "7050010",
            "objective": "(test)准备！$HIDDEN",
            "dialogues": [
                {
                    "id": "705001001",
                    "speaker": "Player",
                    "text": "还没准备好。"
                },
                {
                    "id": "705001002",
                    "speaker": "留云借风真君",
                    "text": "唔…那你准备好之后，再来告诉本仙吧。"
                }
            ]
        },
        {
            "id": "7050004",
            "objective": "协助留云借风真君完成烹饪",
            "dialogues": [
                {
                    "id": "705000401",
                    "speaker": "留云借风真君",
                    "text": "火候似乎控制得不太成功…"
                }
            ]
        },
        {
            "id": "7050006",
            "objective": "向留云借风真君回报",
            "dialogues": []
        },
        {
            "id": "7050005",
            "objective": "向留云借风真君回报",
            "dialogues": []
        },
        {
            "id": "7050008",
            "objective": "向留云借风真君回报",
            "dialogues": [
                {
                    "id": "705000701",
                    "speaker": "留云借风真君",
                    "text": "嗯…味道真是不错，不愧是…",
                    "choices": [
                        {
                            "id": "705000702",
                            "text": "不愧是您。",
                            "response": [
                                {
                                    "id": "705000704",
                                    "speaker": "留云借风真君",
                                    "text": "正是。这三道菜做下来，本仙亲自制作的这台「机关烹饪神机」，其可靠性已完全得到验证。"
                                },
                                {
                                    "id": "705000705",
                                    "speaker": "留云借风真君",
                                    "text": "只要解决控制火候与自动取回食材这两大问题，这台机关便能「一键烹饪」了。"
                                },
                                {
                                    "id": "705000706",
                                    "speaker": "留云借风真君",
                                    "text": "对了，这份「红烩兽肉」的食谱你收好。食谱中所写的肉类，特指寻常兽肉。"
                                },
                                {
                                    "id": "705000707",
                                    "speaker": "留云借风真君",
                                    "text": "雪山天寒地冻，不能让你总来此地寻材觅食…"
                                },
                                {
                                    "id": "705000708",
                                    "speaker": "留云借风真君",
                                    "text": "平日里下厨做这道菜，用寻常兽肉便可。"
                                },
                                {
                                    "id": "705000709",
                                    "speaker": "留云借风真君",
                                    "text": "好了，多谢你帮本仙搜罗食材，旅行者。"
                                },
                                {
                                    "id": "705000710",
                                    "speaker": "留云借风真君",
                                    "text": "本仙也该带着「机关烹饪神机」回洞府去，再好好琢磨一番了。就此别过吧。"
                                },
                                {
                                    "id": "705000711",
                                    "speaker": "留云借风真君",
                                    "text": "噢，本仙若还有什么事需要帮忙的话…说不定还会再找你。"
                                },
                                {
                                    "id": "705000712",
                                    "speaker": "留云借风真君",
                                    "text": "到时候，你可千万不要推辞啊。毕竟本仙信得过你，最是认可你的实力。"
                                }
                            ]
                        },
                        {
                            "id": "705000703",
                            "text": "不愧是您的「机关烹饪神机」。"
                        }
                    ]
                }
            ]
        },
        {
