    "talks": [
        {
            "id": "7351902",
            "objective": "等待至次日（8-12点）",
            "dialogues": []
        },
        {
            "id": "7351901",
            "objective": "与维纳亚克对话",
            "dialogues": [
                {
                    "id": "735190101",
                    "speaker": "维纳亚克",
                    "text": "真是难懂啊…明明是她说要去咖啡馆写报告的…",
                    "choices": [
                        {
                            "id": "735190102",
                            "text": "你怎么一个人在这？",
                            "response": [
                                {
                                    "id": "735190104",
                                    "speaker": "维纳亚克",
                                    "text": "嗨，别提了，她一个人写报告去了。"
                                },
                                {
                                    "id": "735190105",
                                    "speaker": "维纳亚克",
                                    "text": "昨天我们俩约在咖啡馆见面，可她花了好长时间才出现，甚至连写报告用的材料跟纸笔都没带！"
                                },
                                {
                                    "id": "735190106",
                                    "speaker": "维纳亚克",
                                    "text": "我批评了她不该浪费写报告的时间，结果她突然就又生气了！说什么报告她一个人写就完事，还把我给赶了出来！"
                                },
                                {
                                    "id": "735190107",
                                    "speaker": "维纳亚克",
                                    "text": "——真是岂有此理！你说对不对！"
                                },
                                {
                                    "id": "735190108",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "735190109",
                                    "speaker": "维纳亚克",
                                    "text": "唉，不过她这反反复复生气的性子，我也早就已经习惯啦，过几天就会正常的。"
                                },
                                {
                                    "id": "735190110",
                                    "speaker": "维纳亚克",
                                    "text": "——要是她的心情，也像机关那么简单就好了。",
                                    "choices": [
                                        {
                                            "id": "735190111",
                                            "text": "祝你好运。",
                                            "response": [
                                                {
                                                    "id": "735190113",
                                                    "speaker": "维纳亚克",
                                                    "text": "嗯？怎么连你说话也怪怪的…算啦，话说回来，这附近还有一些受影响的沙虫，虽然放着不管也会慢慢消停。"
                                                },
                                                {
                                                    "id": "735190114",
                                                    "speaker": "维纳亚克",
                                                    "text": "不过为了防止它们威胁到过往的行人，你要是有空就帮忙解决一下吧。"
                                                },
                                                {
                                                    "id": "735190115",
                                                    "speaker": "维纳亚克",
                                                    "text": "——顺便一提，现在的元素环境和充能装置都已经恢复正常了。"
                                                },
                                                {
                                                    "id": "735190116",
                                                    "speaker": "维纳亚克",
                                                    "text": "要想体验「对沙虫用杀虫炮」的全功率输出，现在就是最好的机会啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735190112",
                                            "text": "自求多福。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735190103",
                            "text": "施芮娅上哪去了？"
                        }
                    ]
                }
            ]
        }
    ]
}