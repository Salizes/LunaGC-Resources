    "talks": [
        {
            "id": "503001",
            "objective": "(test)竞技场护士-没救医生$HIDDEN",
            "dialogues": [
                {
                    "id": "50300101",
                    "speaker": "琪丝佩",
                    "text": "天啊，人也不够，东西也不够，就我这三脚猫的技术，很多伤口根本处理不了…"
                },
                {
                    "id": "50300102",
                    "speaker": "琪丝佩",
                    "text": "要是有更专业的人在就好了…不行不行，还不是叹气的时候，我得打起精神！"
                }
            ]
        },
        {
            "id": "503002",
            "objective": "(test)流泉之众商人闲置$HIDDEN",
            "dialogues": [
                {
                    "id": "50300201",
                    "speaker": "奥希娜",
                    "text": "我看到你们把葵可女士送回来了…对此我很遗憾，葵可女士真的是一位前途无限光明的医生。"
                },
                {
                    "id": "50300202",
                    "speaker": "奥希娜",
                    "text": "我们在业务上有很多合作，她对于药物的品质有很高的要求，有时候为了给别人治病，还会自掏腰包。"
                },
                {
                    "id": "50300203",
                    "speaker": "奥希娜",
                    "text": "她和我说，比起赚钱，她更看重经验的积累。"
                },
                {
                    "id": "50300204",
                    "speaker": "奥希娜",
                    "text": "只有掌握最精湛的医术，才能让她救最多的人，同时，也让她不会错过她最想救的那个人。"
                },
                {
                    "id": "50300205",
                    "speaker": "奥希娜",
                    "text": "可惜，可惜，医者难自医，纳塔失去了如此杰出的一位英才…"
                }
            ]
        },
        {
            "id": "503003",
            "objective": "(test)医生和护士对话$HIDDEN",
            "dialogues": [
                {
                    "id": "50300301",
                    "speaker": "玛亚薇",
                    "text": "药物还剩下多少，够用吗？"
                },
                {
                    "id": "50300302",
                    "speaker": "琪丝佩",
                    "text": "见底了，紧急储备还剩一些，是留给医生和战士的，这些不能动。"
                },
                {
                    "id": "50300303",
                    "speaker": "玛亚薇",
                    "text": "我知道，我知道…"
                },
                {
                    "id": "50300304",
                    "speaker": "玛亚薇",
                    "text": "把我的那份拿出来。"
                }
            ]
        },
        {
            "id": "503004",
            "objective": "(test)医生和护士对话$HIDDEN",
            "dialogues": []
        },
        {
            "id": "503005",
            "objective": "(test)灰心哥鼓励成功$HIDDEN",
            "dialogues": [
                {
                    "id": "50300501",
                    "speaker": "玛亚薇",
                    "text": "药物还剩下多少，够用吗？"
                },
                {
                    "id": "50300502",
                    "speaker": "琪丝佩",
                    "text": "见底了，紧急储备还剩一些，是留给医生和战士的，这些不能动。"
                },
                {
                    "id": "50300503",
                    "speaker": "玛亚薇",
                    "text": "我知道，我知道…"
                },
                {
                    "id": "50300504",
                    "speaker": "玛亚薇",
                    "text": "把我的那份拿出来。"
                },
                {
                    "id": "50300505",
                    "speaker": "玛亚薇",
                    "text": "原来是你们，很高兴看到你们没事。"
                },
                {
                    "id": "50300506",
                    "speaker": "Player",
                    "text": "你儿子的情况如何？"
                },
                {
                    "id": "50300507",
                    "speaker": "玛亚薇",
                    "text": "我不知道，通信基本断了，送来的伤员一个接一个，我必须集中精神。"
                },
                {
                    "id": "50300508",
                    "speaker": "玛亚薇",
                    "text": "但我相信他，他一定能在关键的时候做出正确的判断，因为他是我的儿子，我始终都为他骄傲。"
                }
            ]
        },
        {
            "id": "503006",
            "objective": "(test)灰心哥鼓励失败$HIDDEN",
            "dialogues": [
                {
                    "id": "50300601",
                    "speaker": "琪丝佩",
                    "text": "幸好有玛亚薇在，她真的很专业，治好了很多病人。"
                },
                {
                    "id": "50300602",
                    "speaker": "琪丝佩",
                    "text": "但她也有点太拼命了，这么长时间没休息过。等下我找个理由，和她换一下班吧。"
                }
            ]
        },
        {
            "id": "503007",
            "objective": "(test)湿地信差存活$HIDDEN",
            "dialogues": [
                {
                    "id": "50300701",
                    "speaker": "玛亚薇",
                    "text": "我相信他，他一定能在关键的时候做出正确的判断，因为他是我的儿子，我始终都为他骄傲。"
                }
            ]
        },
        {
            "id": "503008",
            "objective": "(test)救了愚人众关卡的人$HIDDEN",
            "dialogues": [
                {
                    "id": "50300801",
                    "speaker": "乌图伦库",
                    "text": "是你们，太好了！谢谢你们一直鼓励我！"
                },
                {
                    "id": "50300802",
                    "speaker": "乌图伦库",
                    "text": "纳塔有很多人都把对抗深渊视为荣耀，但他们也会被热血冲昏头脑，不知不觉就陷入险境之中。"
                },
                {
                    "id": "50300803",
                    "speaker": "乌图伦库",
                    "text": "你们说得很对，战斗很重要，生命也很重要，我们为所爱之人战斗，所以我们还要去和所爱之人重逢。"
                },
                {
                    "id": "50300804",
                    "speaker": "乌图伦库",
                    "text": "我转告了你们的想法之后，战友们都很认可，在战斗中也变得稳重了很多，我们取得了非常好的成果！"
                },
                {
                    "id": "50300805",
                    "speaker": "乌图伦库",
                    "text": "真的要谢谢你们！"
                }
            ]
        },
        {
            "id": "503009",
            "objective": "(test)救了驯龙高手等人$HIDDEN",
            "dialogues": [
                {
                    "id": "50300901",
                    "speaker": "乌图伦库",
                    "text": "…是你们啊，我还以为我们没办法再见了。"
                },
                {
                    "id": "50300902",
                    "speaker": "乌图伦库",
                    "text": "我还是打了一场好仗，我们赢了，虽然付出了很多代价…"
                },
                {
                    "id": "50300903",
                    "speaker": "乌图伦库",
                    "text": "你们还会继续战斗对吗？请千万要注意自己的安全。"
                },
                {
                    "id": "50300904",
                    "speaker": "乌图伦库",
                    "text": "对抗深渊是一种荣耀，但能换来胜利的并不是荣耀，而是活下去…"
                }
            ]
        },
        {
            "id": "503010",
            "objective": "(test)救了驯龙高手的龙$HIDDEN",
            "dialogues": [
                {
                    "id": "50301001",
                    "speaker": "拉曼",
                    "text": "是你们，你们回来了，谢谢你们救了我。"
                },
                {
                    "id": "50301002",
                    "speaker": "派蒙",
                    "text": "你没事就好。对了，那些龙去哪里了？"
                },
                {
                    "id": "50301003",
                    "speaker": "拉曼",
                    "text": "哦，它们又去帮忙了，去支援那些还能行动的讯使，到野外侦察和传递情报。"
                },
                {
                    "id": "50301004",
                    "speaker": "拉曼",
                    "text": "我知道外面的情况很差，恨不得自己能多走两步，但…现在只能做点力所能及的事了。"
                }
            ]
        },
        {
            "id": "503011",
            "objective": "(test)悬木人哨站一阶段去过$HIDDEN",
            "dialogues": [
                {
                    "id": "50301101",
                    "speaker": "伊约芭",
                    "text": "#是你们，感谢你们救了我们。来来，快来给{M#他}{F#她}们道谢。"
                },
                {
                    "id": "50301102",
                    "speaker": "欧莎薇",
                    "text": "谢谢你们！"
                },
                {
                    "id": "50301103",
                    "speaker": "派蒙",
                    "text": "不客气，不客气，你们没事就好。"
                },
                {
                    "id": "50301104",
                    "speaker": "欧莎薇",
                    "text": "还要谢谢那些哥哥姐姐，他们叫…愚、愚…"
                },
                {
                    "id": "50301105",
                    "speaker": "派蒙",
                    "text": "愚人众！"
                },
                {
                    "id": "50301106",
                    "speaker": "欧莎薇",
                    "text": "没错，愚人众！他们也很厉害…"
                },
                {
                    "id": "50301107",
                    "speaker": "伊约芭",
                    "text": "我也应该摒弃我的成见，即使是在这个势力之中，依然存在非常高尚的灵魂。"
                }
            ]
        },
        {
            "id": "503012",
            "objective": "(test)悬木人哨站一阶段没去过$HIDDEN",
            "dialogues": [
                {
                    "id": "50301201",
                    "speaker": "哈隆加",
                    "text": "跟我回来的龙伙伴，不管怎么劝，都要跟着战士往外冲，拦都拦不住。"
                },
                {
                    "id": "50301202",
                    "speaker": "哈隆加",
                    "text": "这样就显得我是那个最没用的家伙了，唉，幸好我还懂些龙的医术，可以帮它们治疗。"
                }
            ]
        },
        {
            "id": "503013",
            "objective": "(test)闲置部分回滚隔离$HIDDEN",
            "dialogues": [
                {
                    "id": "50301301",
                    "speaker": "幼小的匿叶龙",
                    "text": "呜——♪"
                },
                {
                    "id": "50301302",
                    "speaker": "派蒙",
                    "text": "是我们救下来的那只匿叶龙！你能安全回到这里，太好了，呜呜…"
                },
                {
                    "id": "50301303",
                    "speaker": "幼小的匿叶龙",
                    "text": "呜、呜！"
                }
            ]
        },
        {
            "id": "503014",
            "objective": "(test)整体父任务完成环$HIDDEN",
            "dialogues": [
                {
                    "id": "50301401",
                    "speaker": "利别科",
                    "text": "能看到你们安全归来，太好了。"
                },
                {
                    "id": "50301402",
                    "speaker": "派蒙",
                    "text": "说好了要在竞技场见，对吧。"
                },
                {
                    "id": "50301403",
                    "speaker": "库纳克",
                    "text": "嗯…我生平第一次战胜了深渊魔物，在我战胜它的瞬间，我觉得它也不过如此。"
                },
                {
                    "id": "50301404",
                    "speaker": "库纳克",
                    "text": "我输给了我的恐惧，我错过了保护别人的机会。"
                },
                {
                    "id": "50301405",
                    "speaker": "利别科",
                    "text": "不要太苛责自己，活下去才是最重要的事，只有活下去，我们才有机会和其他人讲起他们的故事。"
                },
                {
                    "id": "50301406",
                    "speaker": "利别科",
                    "text": "他们永远会活在我们心中。"
                }
            ]
        },
        {
            "id": "503015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50301501",
                    "speaker": "阿奇亚库",
                    "text": "太好了，我们还在担心你们！"
                },
                {
                    "id": "50301502",
                    "speaker": "派蒙",
                    "text": "路上没遇到危险吧？"
                },
                {
                    "id": "50301503",
                    "speaker": "阿奇亚库",
                    "text": "我们还是撞上了深渊魔物，说实话很危险，但他们很勇敢，很机敏，完全不输给合格的战士。"
                },
                {
                    "id": "50301504",
                    "speaker": "利别科",
                    "text": "身体记住的东西，看来没那么容易忘，哈哈哈。"
                },
                {
                    "id": "50301505",
                    "speaker": "库纳克",
                    "text": "能活下来，就是最幸运的事，只有活下来，才可能逐渐找回失去的东西。"
                },
                {
                    "id": "50301506",
                    "speaker": "库纳克",
                    "text": "你们也一定要平安无事啊。"
                }
            ]
        },
        {
            "id": "503016",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "50301601",
                    "speaker": "玛亚薇",
                    "text": "原来是你们，很高兴看到你们没事。"
                }
            ]
        }
    ]
