    "talks": [
        {
            "id": "2204601",
            "objective": "与寝子对话",
            "dialogues": [
                {
                    "id": "220460101",
                    "speaker": "「寝子」",
                    "text": "神社又有些乱了啊…"
                },
                {
                    "id": "220460102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "220460103",
                    "speaker": "「寝子」",
                    "text": "唔喵，是汝等啊，来得正好。"
                },
                {
                    "id": "220460104",
                    "speaker": "「寝子」",
                    "text": "一段时间没打扫，神社的屋子周围，又有了好多污渍。"
                },
                {
                    "id": "220460105",
                    "speaker": "「寝子」",
                    "text": "这样子可不能接待来神社的人类啊…"
                },
                {
                    "id": "220460106",
                    "speaker": "「寝子」",
                    "text": "汝等，能和上次一样，帮奴家打扫一下神社吗？",
                    "choices": [
                        {
                            "id": "220460107",
                            "text": "不是有大祐和悦子吗？",
                            "response": [
                                {
                                    "id": "220460108",
                                    "speaker": "「寝子」",
                                    "text": "奴家可不会去主动找那两个绿绿的人类说话。"
                                },
                                {
                                    "id": "220460109",
                                    "speaker": "「寝子」",
                                    "text": "那个高高的人类，看奴家的眼神总是很奇怪…"
                                },
                                {
                                    "id": "220460110",
                                    "speaker": "「寝子」",
                                    "text": "另外一个绿绿的人类，又总是那副提不起劲的样子。"
                                },
                                {
                                    "id": "220460111",
                                    "speaker": "「寝子」",
                                    "text": "喵喵，无论怎么想，都是两个靠不住的人类。"
                                },
                                {
                                    "id": "220460115",
                                    "speaker": "「寝子」",
                                    "text": "总之，就拜托汝等了。就和上次一样，用长棍子和水「打扫」，汝等明白了吗？",
                                    "choices": [
                                        {
                                            "id": "220460116",
                                            "text": "我知道了。",
                                            "response": [
                                                {
                                                    "id": "220460118",
                                                    "speaker": "「寝子」",
                                                    "text": "总之，这件事就拜托汝等了，奴家…"
                                                },
                                                {
                                                    "id": "220460119",
                                                    "speaker": "「寝子」",
                                                    "text": "奴家在这里等着汝等，喵喵。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "220460117",
                                            "text": "差不多明白了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "220460112",
                            "text": "可以拜托大岛先生…",
                            "response": [
                                {
                                    "id": "220460113",
                                    "speaker": "「寝子」",
                                    "text": "那个石头人类一直在忙个不停，不知道在咚咚咚地敲什么…"
                                },
                                {
                                    "id": "220460114",
                                    "speaker": "「寝子」",
                                    "text": "明明石头已经敲好了，为什么还在咚咚咚呢，真烦…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2204602",
            "objective": "打扫浅濑神社周围的污渍",
            "dialogues": [
                {
                    "id": "220460201",
                    "speaker": "「寝子」",
                    "text": "总之，「打扫」就拜托汝等了，奴家就在这里等着汝等，喵喵。"
                }
            ]
        },
        {
            "id": "2204603",
            "objective": "向寝子回报",
            "dialogues": [
                {
                    "id": "220460301",
                    "speaker": "「寝子」",
                    "text": "喔，汝等已经「打扫」完了吗？"
                },
                {
                    "id": "220460302",
                    "speaker": "Player",
                    "text": "已经打扫完了。"
                },
                {
                    "id": "220460303",
                    "speaker": "「寝子」",
                    "text": "喵喵，那就好，汝等果然非常可靠啊。"
                },
                {
                    "id": "220460304",
                    "speaker": "「寝子」",
                    "text": "神社真是越来越像样了，等阿响回来了之后，她一定会非常高兴的。"
                },
                {
                    "id": "220460305",
                    "speaker": "「寝子」",
                    "text": "奴家一定要好好打理神社才行…喵喵…"
                }
            ]
        }
    ]
