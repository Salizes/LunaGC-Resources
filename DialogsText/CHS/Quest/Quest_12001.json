    },
    "talks": [
        {
            "id": "1200101",
            "objective": "前往茂才公府，探听消息",
            "dialogues": [
                {
                    "id": "120010101",
                    "speaker": "派蒙",
                    "text": "这里就是茂才公的家吧，果然是有钱人，真的好气派。"
                },
                {
                    "id": "120010102",
                    "speaker": "派蒙",
                    "text": "要想知道茂才公和「愚人众」是不是有勾结…先和守卫打听打听吧。"
                }
            ]
        },
        {
            "id": "1200103",
            "objective": "和守卫交谈，探听消息",
            "dialogues": [
                {
                    "id": "120010301",
                    "speaker": "大武",
                    "text": "什么人？",
                    "choices": [
                        {
                            "id": "120010302",
                            "text": "我是蒙德来的商人，与茂才公有约。",
                            "response": [
                                {
                                    "id": "120010303",
                                    "speaker": "大武",
                                    "text": "咦？应该已经提前告知过了啊。"
                                },
                                {
                                    "id": "120010306",
                                    "speaker": "大武",
                                    "text": "老爷今天临时有要事，所有会面都取消了。"
                                },
                                {
                                    "id": "120010307",
                                    "speaker": "派蒙",
                                    "text": "「要事」…是？"
                                },
                                {
                                    "id": "120010308",
                                    "speaker": "大武",
                                    "text": "最近老爷在忙一笔重大的生意，早早就出门接待贵客了。"
                                },
                                {
                                    "id": "120010309",
                                    "speaker": "派蒙",
                                    "text": "那他现在在哪儿？"
                                },
                                {
                                    "id": "120010310",
                                    "speaker": "大武",
                                    "text": "抱歉，这个老爷特别叮嘱了，不能透露…"
                                },
                                {
                                    "id": "120010311",
                                    "speaker": "Player",
                                    "text": "意思是我们就不是贵客了？"
                                },
                                {
                                    "id": "120010312",
                                    "speaker": "大武",
                                    "text": "不不不，我没有冒犯的意思，请不要介意！",
                                    "choices": [
                                        {
                                            "id": "120010313",
                                            "text": "如果不让我见茂才公，有你好受的。",
                                            "response": [
                                                {
                                                    "id": "120010315",
                                                    "speaker": "大武",
                                                    "text": "对不起，对不起！老爷现在在新月轩谈生意！"
                                                },
                                                {
                                                    "id": "120010316",
                                                    "speaker": "大武",
                                                    "text": "还望您大人有大量，别让老爷怪责下来！"
                                                },
                                                {
                                                    "id": "120010317",
                                                    "speaker": "派蒙",
                                                    "text": "我家老爷还有要事在身，就不和你纠缠了。"
                                                },
                                                {
                                                    "id": "120010318",
                                                    "speaker": "派蒙",
                                                    "text": "#你就期待{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}和茂才公谈完生意之后，能把你的冒犯忘掉吧！"
                                                },
                                                {
                                                    "id": "120010319",
                                                    "speaker": "大武",
                                                    "text": "太、太谢谢你们了！愿你们的生意永远有岩王爷庇佑！"
                                                },
                                                {
                                                    "id": "120010320",
                                                    "speaker": "派蒙",
                                                    "text": "#没想到{NICKNAME}你还有这种天赋啊！",
                                                    "choices": [
                                                        {
                                                            "id": "120010321",
                                                            "text": "只是顺势…",
                                                            "response": [
                                                                {
                                                                    "id": "120010322",
                                                                    "speaker": "派蒙",
                                                                    "text": "以后我可要长个心眼，不能随随便便被你唬住了。"
                                                                },
                                                                {
                                                                    "id": "120010325",
                                                                    "speaker": "派蒙",
                                                                    "text": "看样子守卫提到的贵客，应该就是「愚人众」了。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "120010326",
                                                                            "text": "我猜也是。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "120010328",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "嗯，那就去新月轩吧！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "120010327",
                                                                            "text": "来得早不如来得巧。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "120010323",
                                                            "text": "你演得也不错。",
                                                            "response": [
                                                                {
                                                                    "id": "120010324",
                                                                    "speaker": "派蒙",
                                                                    "text": "嘿嘿，那作为感谢，要请我吃点心！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120010314",
                                            "text": "等你老爷为你的冒犯买单吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120010304",
                            "text": "#我是{NICKNAME}，你家主子的贵客！",
                            "response": [
                                {
                                    "id": "120010305",
                                    "speaker": "大武",
                                    "text": "奇怪了，名册上没有这个名字…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200106",
            "objective": "前往新月轩窃听茂才公谈话",
            "dialogues": []
        },
        {
            "id": "1200107",
            "objective": "(test)前往新月轩，窃听茂才公的谈话$HIDDEN",
            "dialogues": [
                {
                    "id": "120010701",
                    "speaker": "茂才公",
                    "text": "我知道，我知道，放心，订单我一定会完成的。"
                },
                {
                    "id": "120010702",
                    "speaker": "债务处理人",
                    "text": "但我之前派给你的手下回复我说，进度不太乐观啊…有人不愿配合，是么？"
                },
                {
                    "id": "120010703",
                    "speaker": "茂才公",
                    "text": "呃…是，在原料上出了点小问题，石珀暂时还没收购到。"
                },
                {
                    "id": "120010704",
                    "speaker": "茂才公",
                    "text": "不过这不需要您担心，就算那个常九爷不卖，我从其他人手上买就行了。"
                },
                {
                    "id": "120010705",
                    "speaker": "债务处理人",
                    "text": "那是最好，之前我就说过，「愚人众」只重视结果。"
                },
                {
                    "id": "120010706",
                    "speaker": "债务处理人",
                    "text": "为了完成订单，「愚人众」可以给你一定支持，但如果按时完不成…"
                },
                {
                    "id": "120010707",
                    "speaker": "债务处理人",
                    "text": "我们的好意可不是免费的。"
                },
                {
                    "id": "120010708",
                    "speaker": "茂才公",
                    "text": "明白明白，承蒙您关照，我又怎么敢辜负您的期望呢？"
                },
                {
                    "id": "120010709",
                    "speaker": "债务处理人",
                    "text": "那就到时候看你的成果了。"
                },
                {
                    "id": "120010710",
                    "speaker": "茂才公",
                    "text": "呼…该死的老常…"
                }
            ]
        },
        {
            "id": "1200108",
            "objective": "将茂才公的计划告知行秋",
            "dialogues": [
                {
                    "id": "120010801",
                    "speaker": "派蒙",
                    "text": "说是有其他想了解的事，搞得神神秘秘的…"
                },
                {
                    "id": "120010802",
                    "speaker": "派蒙",
                    "text": "结果你只是换了个地方看书吧！"
                },
                {
                    "id": "120010803",
                    "speaker": "Player",
                    "text": "茂才公的生意我们弄清楚了。"
                },
                {
                    "id": "120010804",
                    "speaker": "行秋",
                    "text": "原来如此，和我猜得差不多。"
                },
                {
                    "id": "120010805",
                    "speaker": "派蒙",
                    "text": "你真的有猜过吗…"
                },
                {
                    "id": "120010806",
                    "speaker": "行秋",
                    "text": "办法我已成竹在胸。我这里有封信，拜托你们带去给「飞云商会」的家丁，他知道该怎么做。"
                },
                {
                    "id": "120010807",
                    "speaker": "行秋",
                    "text": "因为一些难以言述的苦衷，在下不能与二位一同前往。"
                },
                {
                    "id": "120010808",
                    "speaker": "行秋",
                    "text": "至于信中内容你们不必查看，到时候…"
                },
                {
                    "id": "120010809",
                    "speaker": "派蒙",
                    "text": "哇，字好丑！这种字就算查看了也看不懂嘛。",
                    "choices": [
                        {
                            "id": "120010810",
                            "text": "古代文字？",
                            "response": [
                                {
                                    "id": "120010812",
                                    "speaker": "行秋",
                                    "text": "唔…"
                                },
                                {
                                    "id": "120010813",
                                    "speaker": "行秋",
                                    "text": "所以说你们不必查看，不看…也不会有什么关系！"
                                },
                                {
                                    "id": "120010814",
                                    "speaker": "行秋",
                                    "text": "那个人是读得懂这封信的。"
                                },
                                {
                                    "id": "120010815",
                                    "speaker": "派蒙",
                                    "text": "可是，是要找「飞云商会」帮忙吗？那可是璃月大名鼎鼎的商会之一，没理由帮我们吧？"
                                },
                                {
                                    "id": "120010816",
                                    "speaker": "Player",
                                    "text": "「飞云商会」？"
                                },
                                {
                                    "id": "120010817",
                                    "speaker": "派蒙",
                                    "text": "来璃月之后，经常听到这个名字，好像有很多很多生意都是他们主导的。"
                                },
                                {
                                    "id": "120010818",
                                    "speaker": "派蒙",
                                    "text": "像这样的大商会如果愿意帮忙是很好，但他们真的会帮忙吗？"
                                },
                                {
                                    "id": "120010819",
                                    "speaker": "行秋",
                                    "text": "这个不用担心，据我了解，他们都跟我一样，有一颗侠义心肠。"
                                },
                                {
                                    "id": "120010820",
                                    "speaker": "行秋",
                                    "text": "读了我晓之以理、动之以情的这封信，一定会出手相助的。",
                                    "choices": [
                                        {
                                            "id": "120010821",
                                            "text": "真的会有用吗？",
                                            "response": [
                                                {
                                                    "id": "120010823",
                                                    "speaker": "行秋",
                                                    "text": "要给茂才公一个深刻的教训，只靠我们是不够的。"
                                                },
                                                {
                                                    "id": "120010824",
                                                    "speaker": "行秋",
                                                    "text": "而且我也不想让别人知道这件事是我做的。"
                                                },
                                                {
                                                    "id": "120010825",
                                                    "speaker": "派蒙",
                                                    "text": "为什么？你不是为了报答常九爷吗？"
                                                },
                                                {
                                                    "id": "120010826",
                                                    "speaker": "行秋",
                                                    "text": "「事了拂衣去，深藏功与名」，此乃侠义之本，回味无穷。"
                                                },
                                                {
                                                    "id": "120010827",
                                                    "speaker": "行秋",
                                                    "text": "滴水之恩，定当涌泉相报，但这仅仅是报答，我不想要人情，也不想要回报。"
                                                },
                                                {
                                                    "id": "120010828",
                                                    "speaker": "派蒙",
                                                    "text": "说得这么帅，其实你只是想继续看你的书吧。"
                                                },
                                                {
                                                    "id": "120010829",
                                                    "speaker": "行秋",
                                                    "text": "那就拜托二位送信给「飞云商会」的家丁了，他现在应该在琉璃亭附近。"
                                                },
                                                {
                                                    "id": "120010830",
                                                    "speaker": "派蒙",
                                                    "text": "不准无视我！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "120010822",
                                            "text": "为什么要找他们？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "120010811",
                            "text": "加了密的密文？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1200043",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120004301",
                    "speaker": "大武",
                    "text": "对不起，是我眼拙，还望您大人有大量…"
                }
            ]
        },
        {
            "id": "1200102",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "120010201",
                    "speaker": "派蒙",
                    "text": "唔，到底要怎么样才能知道茂才公和「愚人众」有勾结呢？",
                    "choices": [
                        {
                            "id": "120010202",
                            "text": "要有决定性的证据。",
                            "response": [
                                {
                                    "id": "120010204",
                                    "speaker": "派蒙",
                                    "text": "那…直接去找他？能抓到现场最好，抓不到也能吓唬吓唬他，说不定就告诉我们了呢！"
                                },
                                {
                                    "id": "120010205",
                                    "speaker": "Player",
                                    "text": "先和守卫打听打听吧。"
                                },
                                {
                                    "id": "120010206",
                                    "speaker": "派蒙",
                                    "text": "那就交给你了！我会配合你的。"
                                }
                            ]
                        },
                        {
                            "id": "120010203",
                            "text": "如果能看到现场就好了…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "6100452",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "610045201",
                    "speaker": "行秋",
                    "text": "你们先出发吧，不必等我。"
                },
                {
                    "id": "610045202",
                    "speaker": "行秋",
                    "text": "我再看一页就动身，就看一页。"
                }
            ]
        },
        {
            "id": "6100457",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "610045701",
                    "speaker": "派蒙",
                    "text": "这个茂才公果然和「愚人众」有勾结！"
                },
                {
                    "id": "610045702",
                    "speaker": "派蒙",
                    "text": "不知道书呆子那边有没有什么进展，我们去告诉他吧。"
                }
            ]
        }
    ]
}