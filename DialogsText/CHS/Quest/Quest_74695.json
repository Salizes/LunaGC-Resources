    "talks": [
        {
            "id": "7469501",
            "objective": "与莱欧斯利对话",
            "dialogues": [
                {
                    "id": "746950101",
                    "speaker": "莱欧斯利",
                    "text": "你好，崔斯梅姬斯图斯女士。"
                },
                {
                    "id": "746950102",
                    "speaker": "芭比洛斯",
                    "text": "哦？能准确说出这个名字，看来我们有共同的朋友。"
                },
                {
                    "id": "746950103",
                    "speaker": "莱欧斯利",
                    "text": "有位哥伦比娅小姐向我推荐了这里。"
                },
                {
                    "id": "746950104",
                    "speaker": "芭比洛斯",
                    "text": "那可是位难以预测的小姐呢，你们的相遇一定充满惊喜。"
                },
                {
                    "id": "746950105",
                    "speaker": "莱欧斯利",
                    "text": "所言极是，我非常认同「难以预测」这个评价。"
                },
                {
                    "id": "746950106",
                    "speaker": "莱欧斯利",
                    "text": "初次见面，我是莱欧斯利。"
                },
                {
                    "id": "746950107",
                    "speaker": "芭比洛斯",
                    "text": "是了，驻守水下的公爵，很高兴认识你。"
                },
                {
                    "id": "746950108",
                    "speaker": "莱欧斯利",
                    "text": "没想到伟大的魔女之一竟然听说过我，真是荣幸之至。"
                },
                {
                    "id": "746950109",
                    "speaker": "莱欧斯利",
                    "text": "还是说，作为占星术士的崔斯梅姬斯图斯女士已经预见了我的到来？"
                },
                {
                    "id": "746950110",
                    "speaker": "芭比洛斯",
                    "text": "呵呵…既然我们都知晓彼此的身份，那就省去这些繁文缛节吧，称呼我为芭比洛斯即可。"
                },
                {
                    "id": "746950111",
                    "speaker": "莱欧斯利",
                    "text": "那也请直接叫我莱欧斯利吧，现在并非公务时间，我也只是一个闲散的枫丹市民罢了。"
                },
                {
                    "id": "746950112",
                    "speaker": "莱欧斯利",
                    "text": "刚刚路上正好碰到新鲜出炉的晶螺糕，听说魔女们都喜欢围着茶桌闲聊，如不嫌弃的话，请收下一份吧。"
                },
                {
                    "id": "746950113",
                    "speaker": "芭比洛斯",
                    "text": "哎呀，这的确是茶会上非常受欢迎的甜点。"
                },
                {
                    "id": "746950114",
                    "speaker": "芭比洛斯",
                    "text": "在这里停留许久，我给不少人送出了属于他们的预言，倒是第一次先收到了礼物呢。"
                },
                {
                    "id": "746950115",
                    "speaker": "芭比洛斯",
                    "text": "谢谢你，莱欧斯利先生，我会和艾莉丝她们分享的。"
                },
                {
                    "id": "746950116",
                    "speaker": "芭比洛斯？",
                    "text": "…我听到了哦，芭比，必须给我留！"
                },
                {
                    "id": "746950117",
                    "speaker": "艾莉丝",
                    "text": "不能像之前那样因为我来晚了就让尼可一声不吭地把所有——"
                },
                {
                    "id": "746950118",
                    "speaker": "芭比洛斯",
                    "text": "咳咳！知道了知道了，这次一定。"
                },
                {
                    "id": "746950119",
                    "speaker": "芭比洛斯",
                    "text": "真是的，你怎么来得这么巧，我还想在新朋友面前维持住魔女会的体面呢。"
                },
                {
                    "id": "746950120",
                    "speaker": "莱欧斯利",
                    "text": "没关系，有什么不好，没有规定说能力强大的人不能拥有活泼的性格。"
                },
                {
                    "id": "746950121",
                    "speaker": "艾莉丝",
                    "text": "正是如此！乐观开朗可是我们魔女会的入会门槛之一。"
                },
                {
                    "id": "746950122",
                    "speaker": "芭比洛斯",
                    "text": "第一次听说有这种门槛！"
                },
                {
                    "id": "746950123",
                    "speaker": "艾莉丝",
                    "text": "我刚刚想的！魔女会可是给世界带来快乐的组织，我们自己当然要先乐观开朗起来啦！"
                },
                {
                    "id": "746950124",
                    "speaker": "莱欧斯利",
                    "text": "仅代表个人，我支持诸位随心所欲地享受生活——当然，要在不违法乱纪的前提下。"
                },
                {
                    "id": "746950125",
                    "speaker": "芭比洛斯",
                    "text": "你这个前提在艾莉丝面前不堪一击。"
                },
                {
                    "id": "746950126",
                    "speaker": "莱欧斯利",
                    "text": "哎呀，那可真是令人担忧。"
                },
                {
                    "id": "746950127",
                    "speaker": "艾莉丝",
                    "text": "嘿，我还在这呢！"
                },
                {
                    "id": "746950128",
                    "speaker": "艾莉丝",
                    "text": "放心放心，我还不至于非要在梅洛彼得堡的管理人面前胡闹。"
                },
                {
                    "id": "746950129",
                    "speaker": "艾莉丝",
                    "text": "而且…就算退一步讲，你那里应该比西风骑士团的禁闭室要更宽敞一些吧？"
                },
                {
                    "id": "746950130",
                    "speaker": "莱欧斯利",
                    "text": "哈哈，难道一间禁闭室就能关住传说中的魔女吗？"
                },
                {
                    "id": "746950131",
                    "speaker": "莱欧斯利",
                    "text": "艾莉丝女士甘愿受罚，肯定是因为她为人谦和且守信啊。"
                },
                {
                    "id": "746950132",
                    "speaker": "艾莉丝",
                    "text": "这话说得——真是太对了。"
                },
                {
                    "id": "746950133",
                    "speaker": "芭比洛斯",
                    "text": "停，停，莱欧斯利先生，请不要再助长她的气焰了。"
                },
                {
                    "id": "746950134",
                    "speaker": "芭比洛斯",
                    "text": "一个心情愉悦的艾莉丝，可不一定会做出什么事来。",
                    "choices": [
                        {
                            "id": "746950135",
                            "text": "深有体会。",
                            "response": [
                                {
                                    "id": "746950137",
                                    "speaker": "派蒙",
                                    "text": "#对哦，说起来{NICKNAME}可是骑士团的荣誉骑士，那么肯定是要维护禁闭室的尊严才对！"
                                },
                                {
                                    "id": "746950138",
                                    "speaker": "莱欧斯利",
                                    "text": "由荣誉骑士来阻拦逃跑的魔女吗？听起来像是很不错的话剧，请务必叫我围观。"
                                },
                                {
                                    "id": "746950139",
                                    "speaker": "派蒙",
                                    "text": "你也真是看热闹不嫌事大啊！"
                                },
                                {
                                    "id": "746950140",
                                    "speaker": "派蒙",
                                    "text": "不过没想到公爵已经提前过来了，省去了我们往水下跑一趟呢。"
                                },
                                {
                                    "id": "746950141",
                                    "speaker": "Player",
                                    "text": "这就是占卜的力量吧。"
                                },
                                {
                                    "id": "746950142",
                                    "speaker": "芭比洛斯",
                                    "text": "啊，说到这个，也该做些正事了。"
                                },
                                {
                                    "id": "746950143",
                                    "speaker": "芭比洛斯",
                                    "text": "莱欧斯利先生，无论是看在哥伦比娅小姐的面上，还是作为茶会糕点的回礼，都请你抽取一张「月谕圣牌」吧。"
                                },
                                {
                                    "id": "746950144",
                                    "speaker": "芭比洛斯",
                                    "text": "或许命运的馈赠就暗藏其中。"
                                },
                                {
                                    "id": "746950145",
                                    "speaker": "莱欧斯利",
                                    "text": "这算是一种预言吗？"
                                },
                                {
                                    "id": "746950146",
                                    "speaker": "芭比洛斯",
                                    "text": "可以这么说。"
                                },
                                {
                                    "id": "746950147",
                                    "speaker": "莱欧斯利",
                                    "text": "那没有枫丹人会不认真对待的。"
                                },
                                {
                                    "id": "746950148",
                                    "speaker": "Black Screen",
                                    "text": "说是要「认真对待」，莱欧斯利直接拿起了最上面的一张牌…"
                                },
                                {
                                    "id": "746950149",
                                    "speaker": "莱欧斯利",
                                    "text": "我对这种牌不甚了解，这似乎是…"
                                },
                                {
                                    "id": "746950150",
                                    "speaker": "芭比洛斯",
                                    "text": "是正位的「皇帝」呢…"
                                },
                                {
                                    "id": "746950151",
                                    "speaker": "莱欧斯利",
                                    "text": "您这样欲言又止，难道是坏消息？请不必介意，直言相告就好。"
                                },
                                {
                                    "id": "746950152",
                                    "speaker": "芭比洛斯",
                                    "text": "不，恰恰相反，这张牌意味着永恒的统辖与难以撼动的权威。"
                                },
                                {
                                    "id": "746950153",
                                    "speaker": "芭比洛斯",
                                    "text": "如果这代表未来的路，那其实你早已抵达了目的地。"
                                },
                                {
                                    "id": "746950154",
                                    "speaker": "芭比洛斯",
                                    "text": "不过…呵呵呵，你的「命运」显然还会滚滚向前，变化不止，那么就意味着…"
                                },
                                {
                                    "id": "746950155",
                                    "speaker": "莱欧斯利",
                                    "text": "或许变化的不是人，而是环境？"
                                },
                                {
                                    "id": "746950156",
                                    "speaker": "芭比洛斯",
                                    "text": "嗯…就目前而言，是有这种倾向。"
                                },
                                {
                                    "id": "746950157",
                                    "speaker": "莱欧斯利",
                                    "text": "那看来我可以对自己的直觉更加自信一些了。"
                                },
                                {
                                    "id": "746950158",
                                    "speaker": "莱欧斯利",
                                    "text": "之前我曾因公务拜访挪德卡莱，长了不少见识，此后也不免关注了一些当地的新闻。"
                                },
                                {
                                    "id": "746950159",
                                    "speaker": "莱欧斯利",
                                    "text": "而有那么一个晚上，我看着格外明亮的月亮，不由得想，这个世界正在产生变化，对吗？"
                                },
                                {
                                    "id": "746950160",
                                    "speaker": "芭比洛斯",
                                    "text": "正确的回答是，世间万物每时每刻都在变化，而在巨大变量的介入后，我们都要做好迎接未知的准备。"
                                },
                                {
                                    "id": "746950161",
                                    "speaker": "芭比洛斯",
                                    "text": "不过从这张牌的结果来看，你似乎不用太过担心。无论环境如何改变，你都将拥有适应它或与之对抗的能力。"
                                },
                                {
                                    "id": "746950162",
                                    "speaker": "莱欧斯利",
                                    "text": "那可真是皆大欢喜。看来那一拳没有白挨？",
                                    "choices": [
                                        {
                                            "id": "746950163",
                                            "text": "是带着美好祝愿的一拳。",
                                            "response": [
                                                {
                                                    "id": "746950165",
                                                    "speaker": "莱欧斯利",
                                                    "text": "不过出于好奇，我有个相当冒昧的问题想要请教，不知能否直说…"
                                                },
                                                {
                                                    "id": "746950166",
                                                    "speaker": "艾莉丝",
                                                    "text": "真是狡猾，莱欧斯利先生这样说就是在故意引起我们的好奇心嘛！这下就算你不说，我也偏要问了。"
                                                },
                                                {
                                                    "id": "746950167",
                                                    "speaker": "莱欧斯利",
                                                    "text": "那就恕我直言了。"
                                                },
                                                {
                                                    "id": "746950168",
                                                    "speaker": "莱欧斯利",
                                                    "text": "我一直很想知道，一个真正的预言究竟要如何保证它的实现？"
                                                },
                                                {
                                                    "id": "746950169",
                                                    "speaker": "莱欧斯利",
                                                    "text": "就以我为例，当下的占卜称我会长期处于一个稳定的状态。"
                                                },
                                                {
                                                    "id": "746950170",
                                                    "speaker": "莱欧斯利",
                                                    "text": "但如果我在得知了这个预言后叛逆心肆起，立即去做一些出格的事情，结果又会如何呢？"
                                                },
                                                {
                                                    "id": "746950171",
                                                    "speaker": "莱欧斯利",
                                                    "text": "就比如…"
                                                },
                                                {
                                                    "id": "746950172",
                                                    "speaker": "Player",
                                                    "text": "比如把梅洛彼得堡炸上天？"
                                                },
                                                {
                                                    "id": "746950173",
                                                    "speaker": "莱欧斯利",
                                                    "text": "行，就这个。"
                                                },
                                                {
                                                    "id": "746950174",
                                                    "speaker": "派蒙",
                                                    "text": "还惦记着这回事呢？！"
                                                },
                                                {
                                                    "id": "746950175",
                                                    "speaker": "艾莉丝",
                                                    "text": "欸。"
                                                },
                                                {
                                                    "id": "746950176",
                                                    "speaker": "芭比洛斯",
                                                    "text": "不，你等会儿…"
                                                },
                                                {
                                                    "id": "746950177",
                                                    "speaker": "艾莉丝",
                                                    "text": "哈哈！真是巧了！我这边正好有一位实力强劲的爆破专家可以介绍给你——"
                                                },
                                                {
                                                    "id": "746950178",
                                                    "speaker": "艾莉丝",
                                                    "text": "而荣誉骑士会作为那位爆破专家的随行监护人，在关键时刻阻拦一切坏事的发生！"
                                                },
                                                {
                                                    "id": "746950179",
                                                    "speaker": "芭比洛斯",
                                                    "text": "…你看，预言就是这样达成的。"
                                                },
                                                {
                                                    "id": "746950180",
                                                    "speaker": "莱欧斯利",
                                                    "text": "看来是位破坏力很强的专家啊。"
                                                },
                                                {
                                                    "id": "746950181",
                                                    "speaker": "Player",
                                                    "text": "而且非常可爱。"
                                                },
                                                {
                                                    "id": "746950182",
                                                    "speaker": "派蒙",
                                                    "text": "啊，是小可莉吧！公爵可能不知道，可莉是艾莉丝的女儿哦。"
                                                },
                                                {
                                                    "id": "746950183",
                                                    "speaker": "艾莉丝",
                                                    "text": "不，准确地说，应当是「诸世界的大冒险家」「很坏很坏的大魔王」「旧蒙德的守护者」…"
                                                },
                                                {
                                                    "id": "746950184",
                                                    "speaker": "芭比洛斯",
                                                    "text": "太长了！"
                                                },
                                                {
                                                    "id": "746950185",
                                                    "speaker": "艾莉丝",
                                                    "text": "…总之就是大魔王艾莉丝最可爱的孩子，名副其实的「火花骑士」——可莉！"
                                                },
                                                {
                                                    "id": "746950186",
                                                    "speaker": "艾莉丝",
                                                    "text": "唉，就应该按照原定的计划，大家一起好好办一场聚会，还能介绍你们认识呢。"
                                                },
                                                {
                                                    "id": "746950187",
                                                    "speaker": "艾莉丝",
                                                    "text": "那样等可莉去枫丹玩的时候，还能有新朋友一起开茶会。"
                                                },
                                                {
                                                    "id": "746950188",
                                                    "speaker": "莱欧斯利",
                                                    "text": "听上去是个不错的计划，我已经开始期待了。"
                                                },
                                                {
                                                    "id": "746950189",
                                                    "speaker": "莱欧斯利",
                                                    "text": "毕竟我是不会对一壶好茶说不的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "746950164",
                                            "text": "大难不死，必有后福。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "746950136",
                            "text": "还请对禁闭室保持敬畏之心。"
                        }
                    ]
                }
            ]
        },
