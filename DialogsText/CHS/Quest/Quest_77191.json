        {
            "id": "7719109",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771910601",
                    "speaker": "兹拉托夫",
                    "text": "呼…怎么会这样…唉，我只想要进厢房休息一阵…"
                },
                {
                    "id": "771910602",
                    "speaker": "兹拉托夫",
                    "text": "结果你看，那边的墙壁居然有个巨大的缝隙…怎么…这可怎么让人安心。"
                },
                {
                    "id": "771910603",
                    "speaker": "兹拉托夫",
                    "text": "结果我去问那个雪孃，她说：「人手不足，暂时没法修缮」…要是有人在我休息的时候，透过那个缝隙…"
                },
                {
                    "id": "771910604",
                    "speaker": "Player",
                    "text": "只要挡住不就行了？"
                },
                {
                    "id": "771910605",
                    "speaker": "兹拉托夫",
                    "text": "挡住？呃…"
                },
                {
                    "id": "771910606",
                    "speaker": "兹拉托夫",
                    "text": "倒也不是不行，如果有什么东西可以挡住那个缝隙就好啦！"
                }
            ]
        },
