        },
        {
            "id": "7719113",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771911301",
                    "speaker": "伊斯克琳娜",
                    "text": "难得来赫斯珀利德斯之馆一趟，就让我在这里多喝一会儿吧…哼哼…"
                },
                {
                    "id": "771911302",
                    "speaker": "伊斯克琳娜",
                    "text": "看看还有哪个家伙不自量力，敢和我比拼酒力…"
                }
            ]
        },
        {
            "id": "7719114",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771911401",
                    "speaker": "科夏克娃",
                    "text": "妹妹…其实你没有必要…"
                },
                {
                    "id": "771911402",
                    "speaker": "赫梅莉娃",
                    "text": "我这不都是担心你吗，姐姐…真是的，谁能想到帕芙琳娜大人的贵宾室连个单独的桌子都分不出来…"
                },
                {
                    "id": "771911403",
                    "speaker": "赫梅莉娃",
                    "text": "更何况，一想到纯洁的姐姐你要独自和一个男的坐在一起，我就感到浑身刺挠…"
                },
                {
                    "id": "771911404",
                    "speaker": "科夏克娃",
                    "text": "唉…"
                }
            ]
        },
        {
            "id": "7719107",
            "objective": "(test)废弃$HIDDEN",
            "dialogues": [
                {
                    "id": "771910701",
                    "speaker": "阿布佐娃",
                    "text": "怎么样，客人，您…安排好了吗？还是、再需要点时间？",
                    "choices": [
                        {
                            "id": "771910702",
                            "text": "已经好了！",
                            "response": [
                                {
                                    "id": "771910703",
                                    "speaker": "阿布佐娃",
                                    "text": "真、真的吗，我再去打探一下他们的想法…"
                                },
                                {
                                    "id": "771910704",
                                    "speaker": "阿布佐娃",
                                    "text": "还请在这里稍等！"
                                }
                            ]
                        },
                        {
                            "id": "771910705",
                            "text": "还需要一点时间…",
                            "response": [
                                {
                                    "id": "771910706",
                                    "speaker": "阿布佐娃",
                                    "text": "好的，要是您安排好了，还请跟我说！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
