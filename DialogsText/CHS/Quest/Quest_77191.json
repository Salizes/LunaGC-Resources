    "talks": [
        {
            "id": "7719101",
            "objective": "服务员请求帮忙分桌$HIDDEN",
            "dialogues": [
                {
                    "id": "771910101",
                    "speaker": "阿布佐娃",
                    "text": "真是的…这该如何是好，有没有人能帮帮忙呢…",
                    "choices": [
                        {
                            "id": "771910102",
                            "text": "发生什么事了？",
                            "response": [
                                {
                                    "id": "771910103",
                                    "speaker": "阿布佐娃",
                                    "text": "嗯…是这样，帕芙琳娜大人举办婚礼，许多从前不常来赫斯珀利德斯之馆的雪精们也纷至沓来。"
                                },
                                {
                                    "id": "771910104",
                                    "speaker": "阿布佐娃",
                                    "text": "…啊，我也不是说客人多不好哦，这当然是好事，不过您看，现在常备的位置就不是很够了。"
                                },
                                {
                                    "id": "771910105",
                                    "speaker": "阿布佐娃",
                                    "text": "现在还只剩下两个空桌，但是却有四个客人…"
                                },
                                {
                                    "id": "771910106",
                                    "speaker": "阿布佐娃",
                                    "text": "能够进贵宾室的都是了不起的大人物，要是随意安排，惹恼了他们…我、我可怎么办啊？",
                                    "choices": [
                                        {
                                            "id": "771910107",
                                            "text": "要不交给我吧！",
                                            "response": [
                                                {
                                                    "id": "771910108",
                                                    "speaker": "阿布佐娃",
                                                    "text": "欸，可以吗…不对，仔细一想，您也是客人…唔…如果把活交给客人被知道了，一定会被阿格拉娅臭骂一顿，但是…"
                                                },
                                                {
                                                    "id": "771910109",
                                                    "speaker": "阿布佐娃",
                                                    "text": "该退缩的时候就应该退缩！"
                                                },
                                                {
                                                    "id": "771910110",
                                                    "speaker": "阿布佐娃",
                                                    "text": "那就交给你了！客人！"
                                                },
                                                {
                                                    "id": "771910111",
                                                    "speaker": "阿布佐娃",
                                                    "text": "情况、情况是这样的，现在贵宾休息室还有两张桌子。一张在大厅，一张在里面的厢房里。"
                                                },
                                                {
                                                    "id": "771910112",
                                                    "speaker": "阿布佐娃",
                                                    "text": "第一位宾客…唔，其实我也没有记住他的名字啦，那就叫他宾客1号。"
                                                },
                                                {
                                                    "id": "771910113",
                                                    "speaker": "阿布佐娃",
                                                    "text": "宾客1号想去厢房休息，但是却说厢房墙壁上的缝隙让他有点没有安全感…但是我们现在还没法修缮…"
                                                },
                                                {
                                                    "id": "771910114",
                                                    "speaker": "阿布佐娃",
                                                    "text": "宾客2号想要在大厅里饮酒…刚刚她和另一位拼酒，哇，把另一位都喝倒了，她还面不改色…"
                                                },
                                                {
                                                    "id": "771910115",
                                                    "speaker": "阿布佐娃",
                                                    "text": "宾客3号和4号是从新基捷城来的一对姐妹，"
                                                },
                                                {
                                                    "id": "771910116",
                                                    "speaker": "阿布佐娃",
                                                    "text": "宾客3号和谁一桌都行…但是4号说：「我可不能让姐姐和不知道哪来的野男人一桌，如果那样，我必须在场！」"
                                                },
                                                {
                                                    "id": "771910117",
                                                    "speaker": "阿布佐娃",
                                                    "text": "但是又是这个宾客4号说：「但是你们这里的桌子，一张桌子边上坐两个人就够拥挤了吧！」"
                                                },
                                                {
                                                    "id": "771910118",
                                                    "speaker": "阿布佐娃",
                                                    "text": "显然宾客4号…唔，这个麻烦的妹妹恐怕不会接受和其他两个人共享一张桌子…"
                                                },
                                                {
                                                    "id": "771910119",
                                                    "speaker": "阿布佐娃",
                                                    "text": "情况就是这样…唔…我是毫无头绪了，要不您和他们商量商量他们想要坐的座位…我去将他们领到座位上？"
                                                },
                                                {
                                                    "id": "771910120",
                                                    "speaker": "Player",
                                                    "text": "嗯…我来试试看…"
                                                },
                                                {
                                                    "id": "771910121",
                                                    "speaker": "阿布佐娃",
                                                    "text": "呜…那您真的算是救了我一命啦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "771910122",
                                            "text": "那你自己好好想想吧…",
                                            "response": [
                                                {
                                                    "id": "771910123",
                                                    "speaker": "阿布佐娃",
                                                    "text": "呜…该如何是好…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "771910124",
                            "text": "不打扰你了…",
                            "response": [
                                {
                                    "id": "771910125",
                                    "speaker": "阿布佐娃",
                                    "text": "好、好的，客人…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7719120",
            "objective": "回滚节点$HIDDEN",
            "dialogues": []
        },
        {
            "id": "7719108",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771910801",
                    "speaker": "Black Screen",
                    "text": "阿布佐娃按照你的安排，分别询问客人们是否满足需要…"
                },
                {
                    "id": "771910802",
                    "speaker": "Black Screen",
                    "text": "似乎所有客人们都很满意。"
                },
                {
                    "id": "771910803",
                    "speaker": "阿布佐娃",
                    "text": "呼…成、成功了！"
                },
                {
                    "id": "771910804",
                    "speaker": "阿布佐娃",
                    "text": "真是太感谢了，要是没有客人您，我都不知道要怎么办，没有客人不满意真是太好了。",
                    "choices": [
                        {
                            "id": "771910805",
                            "text": "我也是客人…",
                            "response": [
                                {
                                    "id": "771910807",
                                    "speaker": "阿布佐娃",
                                    "text": "嘿嘿，当然不会忘了客人您啦！"
                                },
                                {
                                    "id": "771910808",
                                    "speaker": "阿布佐娃",
                                    "text": "虽然不多，但是这些东西就交给您作为帮了我大忙的酬劳！"
                                },
                                {
                                    "id": "771910809",
                                    "speaker": "阿布佐娃",
                                    "text": "呜呜…第一次遇到了能帮忙解决麻烦而不是制造麻烦的客人…啊，也不是说其他客人都在制造麻烦的意思…"
                                }
                            ]
                        },
                        {
                            "id": "771910806",
                            "text": "我的需求呢？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7719111",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771911101",
                    "speaker": "科夏克娃",
                    "text": "唉…真是的…我倒是和谁坐一桌都可以…"
                },
                {
                    "id": "771911102",
                    "speaker": "科夏克娃",
                    "text": "可是我的妹妹，赫梅莉娃，却<color=#00E1FFFF>不让我和任何男性单独坐一桌</color>，但凡有这样的情况，她也非得要坐过来才行。"
                },
                {
                    "id": "771911103",
                    "speaker": "科夏克娃",
                    "text": "真是奇怪，她从小到大都这样…不过…毕竟她这也是担心我。",
                    "choices": [
                        {
                            "id": "771911104",
                            "text": "（那么，安排她去厢房休息…）",
                            "response": [
                                {
                                    "id": "771911106",
                                    "speaker": "科夏克娃",
                                    "text": "嗯…之后就要等侍者来引导我们入座，对吧。哎…希望座位的安排能让赫梅莉娃满意吧。"
                                }
                            ]
                        },
                        {
                            "id": "771911105",
                            "text": "（那么，安排她去大厅休息…）",
                            "response": [
                                {
                                    "id": "771911107",
                                    "speaker": "科夏克娃",
                                    "text": "嗯…之后就要等侍者来引导我们入座，对吧。哎…希望座位的安排能让赫梅莉娃满意吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7719110",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771911001",
                    "speaker": "兹拉托夫",
                    "text": "呼…就没有人能够…能够管管墙上的裂隙吗？"
                },
                {
                    "id": "771911002",
                    "speaker": "兹拉托夫",
                    "text": "真是的，这些馆里的雪孃，不知道裂隙有多可怕吗，要是有人从那些裂隙里看、看过来…怎么办？"
                }
            ]
        },
        {
            "id": "7719112",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771910201",
                    "speaker": "兹拉托夫",
                    "text": "#啊…您是说，厢房里墙壁上的缝被堵上了吗…那可真是太好了，您真是位热心肠的{M#先生}{F#小姐}。",
                    "choices": [
                        {
                            "id": "771910202",
                            "text": "（那么，安排他去厢房休息…）",
                            "response": [
                                {
                                    "id": "771910204",
                                    "speaker": "兹拉托夫",
                                    "text": "之后，等待侍者来安排位置就好了吧，没有安排就无法入座，山中之馆的规矩我还是明白的。"
                                }
                            ]
                        },
                        {
                            "id": "771910203",
                            "text": "（那么，安排他去大厅休息…）",
                            "response": [
                                {
                                    "id": "771910205",
                                    "speaker": "兹拉托夫",
                                    "text": "之后，等待侍者来安排位置就好了吧，没有安排就无法入座，山中之馆的规矩我还是明白的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7719103",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771910301",
                    "speaker": "伊斯克琳娜",
                    "text": "桌子的要求？我倒没有什么太大的要求，只要能<color=#00E1FFFF>坐在大厅里</color>就行，毕竟离吧台近嘛。"
                },
                {
                    "id": "771910302",
                    "speaker": "伊斯克琳娜",
                    "text": "难得来赫斯珀利德斯之馆一趟，就让我在这里多喝一会儿吧…哼哼…",
                    "choices": [
                        {
                            "id": "771910303",
                            "text": "（那么，安排她去厢房休息…）",
                            "response": [
                                {
                                    "id": "771910305",
                                    "speaker": "伊斯克琳娜",
                                    "text": "好的，就让我等侍者的引导吧…呼呼，待会儿要喝什么酒呢…"
                                }
                            ]
                        },
                        {
                            "id": "771910304",
                            "text": "（那么，安排她去大厅休息…）",
                            "response": [
                                {
                                    "id": "771910306",
                                    "speaker": "伊斯克琳娜",
                                    "text": "好的，就让我等侍者的引导吧…呼呼，待会儿要喝什么酒呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7719104",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "771910401",
                    "speaker": "赫梅莉娃",
                    "text": "哼，没想到雪孃王公制造的公馆居然用这么小的桌子…听说以前也流行过这种…"
                },
                {
                    "id": "771910402",
                    "speaker": "赫梅莉娃",
                    "text": "不过现在已经不是什么「贵妇人在小桌边亲密交谈」的时代啦！这种桌子，能坐两个人就是极限…"
                },
                {
                    "id": "771910403",
                    "speaker": "赫梅莉娃",
                    "text": "<color=#00E1FFFF>让我和其他两个人挤这样一张桌子？想也别想！</color>",
                    "choices": [
                        {
                            "id": "771910404",
                            "text": "（那么，安排她去厢房休息…）",
                            "response": [
                                {
                                    "id": "771910406",
                                    "speaker": "赫梅莉娃",
                                    "text": "要是待会儿那个侍者没能满足我的要求，我一定会向这边负责的雪精好好说说！"
                                }
                            ]
                        },
                        {
                            "id": "771910405",
                            "text": "（那么，安排她去大厅休息…）",
                            "response": [
                                {
                                    "id": "771910407",
                                    "speaker": "赫梅莉娃",
                                    "text": "要是待会儿那个侍者没能满足我的要求，我一定会向这边负责的雪精好好说说！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
