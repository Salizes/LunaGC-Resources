        "total_dialogue_lines": 82,
        "total_speaker_counts": {
            "Player": 17,
            "凯瑟琳": 6,
            "帕特里克": 35,
            "派蒙": 24
        }
    },
    "talks": [
        {
            "id": "7166401",
            "objective": "前往璃月的冒险家协会",
            "dialogues": [
                {
                    "id": "716640101",
                    "speaker": "凯瑟琳",
                    "text": "总算等到你了，旅行者。"
                },
                {
                    "id": "716640102",
                    "speaker": "凯瑟琳",
                    "text": "最近冒险家协会接到了一份相当重要的委托，根据我的经验，你是最合适的人选。",
                    "choices": [
                        {
                            "id": "716640103",
                            "text": "相当重要的委托…",
                            "response": [
                                {
                                    "id": "716640105",
                                    "speaker": "派蒙",
                                    "text": "不用这么客气啦，凯瑟琳小姐，我们早就习惯了！"
                                },
                                {
                                    "id": "716640106",
                                    "speaker": "派蒙",
                                    "text": "如果委托的报酬不够丰厚，凯瑟琳小姐也不会来麻烦我们的，对吧？"
                                },
                                {
                                    "id": "716640107",
                                    "speaker": "凯瑟琳",
                                    "text": "咳咳，倒也没错呢…不愧是你们，每次都这么爽快。"
                                },
                                {
                                    "id": "716640108",
                                    "speaker": "凯瑟琳",
                                    "text": "那我就直说好了，这次的委托人名叫帕特里克，是一位来自枫丹的科研专家。"
                                },
                                {
                                    "id": "716640109",
                                    "speaker": "凯瑟琳",
                                    "text": "他希望能雇佣几位助手，帮助他进行科研，目前他正在层岩巨渊外围进行考察。"
                                },
                                {
                                    "id": "716640110",
                                    "speaker": "凯瑟琳",
                                    "text": "虽然不清楚科研的详细内容，但你们对这种委托已经是轻车熟路了吧。"
                                },
                                {
                                    "id": "716640111",
                                    "speaker": "Player",
                                    "text": "确实如此…"
                                },
                                {
                                    "id": "716640112",
                                    "speaker": "派蒙",
                                    "text": "那就按照惯例办事吧，我们先去层岩巨渊附近看看！"
                                }
                            ]
                        },
                        {
                            "id": "716640104",
                            "text": "似曾相识的对话…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7166402",
            "objective": "前往层岩巨渊外围，寻找帕特里克",
            "dialogues": [
                {
                    "id": "716640201",
                    "speaker": "帕特里克",
                    "text": "不能再拖延下去了，必须尽快进入验证环节…实在不行，我就只能亲自上阵了。"
                },
                {
                    "id": "716640202",
                    "speaker": "帕特里克",
                    "text": "「意外受伤，被迫中止研究。」靠这个借口应该能多拖延一会儿…"
                },
                {
                    "id": "716640203",
                    "speaker": "帕特里克",
                    "text": "反正只要不把命给搭上，就比回去接受审判要划算！"
                },
                {
                    "id": "716640204",
                    "speaker": "派蒙",
                    "text": "#他在这里自言自语什么呢？打个招呼吧，{NICKNAME}。"
                },
                {
                    "id": "716640205",
                    "speaker": "Player",
                    "text": "你好，请问是帕特里克先生吗？"
                },
                {
                    "id": "716640206",
                    "speaker": "帕特里克",
                    "text": "吓死我了！你们两个是从哪冒出来的…怎么还知道我的名字？"
                },
                {
                    "id": "716640207",
                    "speaker": "帕特里克",
                    "text": "等等，你们不会也是便衣的千岩军吧？还要来驱赶我吗？我已经出示过实地考察的许可了！"
                },
                {
                    "id": "716640208",
                    "speaker": "帕特里克",
                    "text": "我保证，绝对不会深入禁区的！不信你去问那位杀气腾腾的、黑色短发的小姐！"
                },
                {
                    "id": "716640209",
                    "speaker": "派蒙",
                    "text": "虽然不知道你说的人是谁，但别紧张啦。"
                },
                {
                    "id": "716640210",
                    "speaker": "派蒙",
                    "text": "我们是友善、专业的冒险家。我们接到了协会的委托，来帮你解决麻烦啦。"
                },
                {
                    "id": "716640211",
                    "speaker": "帕特里克",
                    "text": "原来是救兵？太好了！你们总算到了，我的研究项目终于有救了，要不然我早晚有一天要被它害死…"
                },
                {
                    "id": "716640212",
                    "speaker": "派蒙",
                    "text": "看来你被你的研究项目给折磨得不轻啊。"
                },
                {
                    "id": "716640213",
                    "speaker": "帕特里克",
                    "text": "这是什么话！研究这一行为本身是神圣而高洁的！折磨我的只是一些「附加因素」罢了。"
                },
                {
                    "id": "716640214",
                    "speaker": "派蒙",
                    "text": "「附加因素」？比如说？"
                },
                {
                    "id": "716640215",
                    "speaker": "帕特里克",
                    "text": "科研失败就会死。"
                },
                {
                    "id": "716640216",
                    "speaker": "派蒙",
                    "text": "……？",
                    "choices": [
                        {
                            "id": "716640217",
                            "text": "…像一句自暴自弃的话。",
                            "response": [
                                {
                                    "id": "716640219",
                                    "speaker": "帕特里克",
                                    "text": "唉，我可没在开玩笑。"
                                },
                                {
                                    "id": "716640220",
                                    "speaker": "帕特里克",
                                    "text": "独立的研究者进行科研需要申请资金，只要使用这笔资金，就等于承担了枫丹的社会责任。"
                                },
                                {
                                    "id": "716640221",
                                    "speaker": "帕特里克",
                                    "text": "花费了大笔资金还没能取得成果，就无异于罪人，可是会被审判的！"
                                },
                                {
                                    "id": "716640222",
                                    "speaker": "帕特里克",
                                    "text": "要是我空手而归，等待着我的大概不止「浪费公共财产」，还有占用「学术资源」等好几十项罪名。"
                                },
                                {
                                    "id": "716640223",
                                    "speaker": "帕特里克",
                                    "text": "这些罪名会给我带来最严重的惩罚…财产亏空，身败名裂还是小事，被审判的话，真的有可能会死掉！"
                                },
                                {
                                    "id": "716640224",
                                    "speaker": "派蒙",
                                    "text": "欸？这也太过分了吧！"
                                },
                                {
                                    "id": "716640225",
                                    "speaker": "派蒙",
                                    "text": "所以你才那么慌张，花一大笔钱聘请助手么？",
                                    "choices": [
                                        {
                                            "id": "716640226",
                                            "text": "枫丹这个国家还真是可怕。",
                                            "response": [
                                                {
                                                    "id": "716640227",
                                                    "speaker": "帕特里克",
                                                    "text": "可怕的是「附加因素」！我美丽的故乡是无罪的！"
                                                },
                                                {
                                                    "id": "716640230",
                                                    "speaker": "派蒙",
                                                    "text": "冷静一点啦，我们明白情况有多严重了。这项科研关系到你的未来，你的性命。"
                                                },
                                                {
                                                    "id": "716640231",
                                                    "speaker": "派蒙",
                                                    "text": "都交给我们吧，我们会帮你搞定一切的！"
                                                },
                                                {
                                                    "id": "716640232",
                                                    "speaker": "帕特里克",
                                                    "text": "事到如今，我也只能依靠你们了。",
                                                    "choices": [
                                                        {
                                                            "id": "716640233",
                                                            "text": "你需要我们怎么做呢？",
                                                            "response": [
                                                                {
                                                                    "id": "716640235",
                                                                    "speaker": "帕特里克",
                                                                    "text": "嗯，那就进入正题吧。我的研究项目名叫「振晶映射」。"
                                                                },
                                                                {
                                                                    "id": "716640236",
                                                                    "speaker": "帕特里克",
                                                                    "text": "简单来说，就是激发矿藏宝石所含有的元素力，将这种元素力作为能源使用。"
                                                                },
                                                                {
                                                                    "id": "716640237",
                                                                    "speaker": "派蒙",
                                                                    "text": "听起来好方便啊！也许能用来制作实用又好玩的机器…"
                                                                },
                                                                {
                                                                    "id": "716640238",
                                                                    "speaker": "派蒙",
                                                                    "text": "不过，这些宝石和你说的什么晶什么映，又有什么关系呢？"
                                                                },
                                                                {
                                                                    "id": "716640239",
                                                                    "speaker": "Player",
                                                                    "text": "「振晶」就属于这种宝石吧。"
                                                                },
                                                                {
                                                                    "id": "716640240",
                                                                    "speaker": "帕特里克",
                                                                    "text": "答对了！不久之前，有人在激发宝石时发现，有一类特殊宝石之间能产生奇妙的共鸣。"
                                                                },
                                                                {
                                                                    "id": "716640241",
                                                                    "speaker": "帕特里克",
                                                                    "text": "并将这样的宝石统称为「振晶」。"
                                                                },
                                                                {
                                                                    "id": "716640242",
                                                                    "speaker": "帕特里克",
                                                                    "text": "「振晶」中的「响振晶」受到特定的刺激后，可以放出能量，激发「应振晶」的共鸣。"
                                                                },
                                                                {
                                                                    "id": "716640243",
                                                                    "speaker": "帕特里克",
                                                                    "text": "两种「振晶」所放出的能量会相互叠加，成倍增幅，无比强大！我将这种共鸣命名为「映射」现象，"
                                                                },
                                                                {
                                                                    "id": "716640244",
                                                                    "speaker": "帕特里克",
                                                                    "text": "目前项目已经进行到了关键阶段——验证我推导的「映射关系」。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "716640245",
                                                                            "text": "我有一种预感…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "716640247",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "我猜，你需要我们去检验你的理论，借助那些「振晶」的力量打败魔物，证明你所说的「映射关系」…"
                                                                                },
                                                                                {
                                                                                    "id": "716640248",
                                                                                    "speaker": "帕特里克",
                                                                                    "text": "完全正确！你们的悟性很高啊！"
                                                                                },
                                                                                {
                                                                                    "id": "716640249",
                                                                                    "speaker": "帕特里克",
                                                                                    "text": "我挑选了一片合适的区域，布置了许多组「振晶」的方碑。做好了准备的话，就告诉我吧。"
                                                                                },
                                                                                {
                                                                                    "id": "716640250",
                                                                                    "speaker": "帕特里克",
                                                                                    "text": "我会向你们仔细说明需要验证的项目，根据我的提示去战斗就可以了。"
                                                                                },
                                                                                {
                                                                                    "id": "716640251",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这么说来，还真是我们最熟悉的工作呢，甚至觉得有点无聊。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "716640252",
                                                                                            "text": "我倒有点兴趣…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "716640253",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "你打败过那么多强大的敌人，手脚加在一起都数不过来了吧，搞定这种委托，当然是小菜一碟！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640256",
                                                                                                    "speaker": "帕特里克",
                                                                                                    "text": "真有气势！璃月可真是个好地方啊，不止出产宝石的原矿，还有这么可靠的冒险家！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640257",
                                                                                                    "speaker": "帕特里克",
                                                                                                    "text": "不枉我跋山涉水，为了节省材料的费用赶到这里来。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640258",
                                                                                                    "speaker": "帕特里克",
                                                                                                    "text": "本来我还在为预算超支苦恼，这下倒好，支付了你们的佣金后，资金余下两成。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640259",
                                                                                                    "speaker": "帕特里克",
                                                                                                    "text": "事成之后，就用这笔钱雇佣一个报社写手，在新闻头版发布我的成果，好好宣传一番吧。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640260",
                                                                                                    "speaker": "帕特里克",
                                                                                                    "text": "标题我已经想好了，就叫「震惊！帕特里克对振晶的真经实论！」"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640261",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "正经一点啦！这个标题怎么看都不像是学术文章吧？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640262",
                                                                                                    "speaker": "帕特里克",
                                                                                                    "text": "标题一定要奇怪，要引人瞩目，这样才能拉到投资！到时候，我们还可以商量分红的事。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640263",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "分红？不明白你在说什么…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640264",
                                                                                                    "speaker": "帕特里克",
                                                                                                    "text": "如果「振晶映射」的理论被用来生产商品，我就能拿到不少利润，到时可以按一定比例分给你们哦。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640265",
                                                                                                    "speaker": "帕特里克",
                                                                                                    "text": "当然，前提是研究的进展顺利…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "716640266",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "居然还有这种好事吗？好呀好呀，我更有干劲了！标题什么的我不管了，随你喜欢！",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "716640267",
                                                                                                            "text": "派蒙…",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "716640269",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "#总之，{NICKNAME}，我们就早早开工，快快收工吧！"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "716640270",
                                                                                                                    "speaker": "派蒙",
                                                                                                                    "text": "然后就能和帕特里克先生商量分红的事了，嘿嘿…"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "716640268",
                                                                                                            "text": "口水要流出来了…"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "716640254",
                                                                                            "text": "不如你来试试？",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "716640255",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "我我我，我只是希望你能接到既有趣，又充满挑战的委托而已…可不是在抱怨哦！"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "716640246",
                                                                            "text": "我已经明白了…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "716640234",
                                                            "text": "请解释一下你的科研项目。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716640228",
                                            "text": "这种「附加因素」还真是恐怖。",
                                            "response": [
                                                {
                                                    "id": "716640229",
                                                    "speaker": "帕特里克",
                                                    "text": "但它有利有弊，只要不沦为罪人，还是能享受到各种便利的。出身于枫丹的人都曾受益于它。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716640218",
                            "text": "哦，有点好笑。"
                        }
                    ]
                }
            ]
        }
    ]
}