    "talks": [
        {
            "id": "1502001",
            "objective": "去找场地工作人员",
            "dialogues": [
                {
                    "id": "150200101",
                    "speaker": "因卡纳克",
                    "text": "欸，恰斯卡？是阿尔帕长老让你来的吗？"
                },
                {
                    "id": "150200102",
                    "speaker": "恰斯卡",
                    "text": "嗯，她还有其他事要做，这边的情况怎么样？"
                },
                {
                    "id": "150200103",
                    "speaker": "因卡纳克",
                    "text": "唔…根据调查结果，应该是过去的几次深渊入侵，导致了地脉紊乱，在试炼场地里形成了各种各样的「阻塞」。"
                },
                {
                    "id": "150200104",
                    "speaker": "因卡纳克",
                    "text": "理论上只要清理掉这些阻塞，就能让气态燃素再次充盈，但实际操作起来却各有各的问题…"
                },
                {
                    "id": "150200105",
                    "speaker": "因卡纳克",
                    "text": "具体情况，你们可以直接下去看看？也可以问问在场的工作人员。"
                }
            ]
        },
        {
            "id": "1502013",
            "objective": "(test)靠近后触发对话$HIDDEN",
            "dialogues": [
                {
                    "id": "150201001",
                    "speaker": "大胆的调查员",
                    "text": "咦，你们是来帮忙的吗？谢天谢地！我正愁没人配合呢。"
                },
                {
                    "id": "150201002",
                    "speaker": "大胆的调查员",
                    "text": "这里的「阻塞」要用特制的炸弹来清理，但是带着炸药爬上这么陡峭的山峰…"
                },
                {
                    "id": "150201003",
                    "speaker": "大胆的调查员",
                    "text": "磕一下碰一下，一条小命就没了！所以我打算把炸药运到对面，再用热气球送过来…"
                },
                {
                    "id": "150201004",
                    "speaker": "大胆的调查员",
                    "text": "只要有人能在这里<color=#00E1FFFF>看准时机击中热气球，让炸药刚刚好落在喷口上…</color>问题就解决了！"
                },
                {
                    "id": "150201005",
                    "speaker": "大胆的调查员",
                    "text": "怎么样？很简单易懂对吧？"
                },
                {
                    "id": "150201006",
                    "speaker": "Player",
                    "text": "确实挺简单的…"
                },
                {
                    "id": "150201007",
                    "speaker": "Player",
                    "text": "所以上面那个热气球也是你放的？"
                },
                {
                    "id": "150201008",
                    "speaker": "大胆的调查员",
                    "text": "嗯？你说那个啊…我也不知道是谁放的，居然能升得这么高。"
                },
                {
                    "id": "150201009",
                    "speaker": "大胆的调查员",
                    "text": "要是能飞上去看看它是用了什么技术就好了…不过现在修理场地的事更重要。"
                },
                {
                    "id": "150201010",
                    "speaker": "大胆的调查员",
                    "text": "我这就去对面布置，你们准备好了，就喊我一声！"
                }
            ]
        },
        {
            "id": "1502009",
            "objective": "清理场地内的阻塞",
            "dialogues": [
                {
                    "id": "150200901",
                    "speaker": "疑惑的调查员",
                    "text": "你！你看到了吗！刚刚有一头嵴锋龙突然出现了！"
                },
                {
                    "id": "150200902",
                    "speaker": "迷惑的调查员",
                    "text": "难…难道是路过的…？不管了，喷口清理完了就好…"
                }
            ]
        },
        {
            "id": "1502010",
            "objective": "清理场地内的阻塞",
            "dialogues": []
        },
        {
            "id": "1502011",
            "objective": "清理场地内的阻塞",
            "dialogues": [
                {
                    "id": "150201101",
                    "speaker": "大胆的调查员",
                    "text": "咦？你们怎么跑过来了？在这边可不好看清位置啊。"
                },
                {
                    "id": "150201102",
                    "speaker": "Player",
                    "text": "能重新说明一下计划吗？"
                },
                {
                    "id": "150201103",
                    "speaker": "大胆的调查员",
                    "text": "哦，我打算用热气球把炸药送到对面的喷口上空…"
                },
                {
                    "id": "150201104",
                    "speaker": "大胆的调查员",
                    "text": "只要你<color=#00E1FFFF>看准时机击中热气球，让炸药刚刚好落在喷口上…</color>问题就解决了！"
                }
            ]
        },
        {
            "id": "1502012",
            "objective": "清理场地内的阻塞",
            "dialogues": [
                {
                    "id": "150201201",
                    "speaker": "大胆的调查员$UNRELEASED",
                    "text": "好嘞！准备好——$UNRELEASED"
                }
            ]
        },
        {
            "id": "1502002",
            "objective": "清理场地内的阻塞$HIDDEN",
            "dialogues": [
                {
                    "id": "150200201",
                    "speaker": "谨慎的调查员",
                    "text": "嗯…看起来这个喷口，<color=#00E1FFFF>只要进行多次打击就能清理掉。</color>"
                },
                {
                    "id": "150200202",
                    "speaker": "谨慎的调查员",
                    "text": "不过这里头似乎有奇怪的生命活动迹象，不知道直接动手会不会有危险啊…"
                }
            ]
        },
        {
            "id": "1502003",
            "objective": "返回高处与因卡纳克对话",
            "dialogues": [
                {
                    "id": "150200301",
                    "speaker": "谨慎的调查员",
                    "text": "哈哈…我还以为自己要完了！这儿的喷口已经没事了，多谢你们。"
                }
            ]
        },
        {
            "id": "1502004",
            "objective": "与因卡纳克对话",
            "dialogues": [
                {
                    "id": "150200401",
                    "speaker": "因卡纳克",
                    "text": "居然用这么短的时间就清理完了…真不愧是你们！"
                },
                {
                    "id": "150200402",
                    "speaker": "因卡纳克",
                    "text": "接下来只要等气态燃素逐渐充盈，飞行试炼就能正常举办了。"
                },
                {
                    "id": "150200403",
                    "speaker": "恰斯卡",
                    "text": "唔…因卡纳克，我想先试飞一下，看看还有没有遗漏，能帮我安排一下吗？"
                },
                {
                    "id": "150200404",
                    "speaker": "因卡纳克",
                    "text": "欸？可是场地才刚刚清理完，万一有什么危险没发现…"
                },
                {
                    "id": "150200405",
                    "speaker": "恰斯卡",
                    "text": "所以才更应该由我来检查吧。"
                },
                {
                    "id": "150200406",
                    "speaker": "因卡纳克",
                    "text": "啊…也对，以你的飞行技巧，就算有什么遗漏，也不会是致命的危险…"
                },
                {
                    "id": "150200407",
                    "speaker": "恰斯卡",
                    "text": "这片区域里的环境还不稳定，不亲自试飞一下，很难检查出问题。"
                },
                {
                    "id": "150200408",
                    "speaker": "因卡纳克",
                    "text": "那我这就去安排。你准备好的话，就随时跟我说一声吧。"
                }
            ]
        },
        {
            "id": "1502014",
            "objective": "与因卡纳克对话",
            "dialogues": [
                {
                    "id": "150201401",
                    "speaker": "好奇的调查员",
                    "text": "奇怪…明明已经铆足了力气，怎么还是敲不破…"
                },
                {
                    "id": "150201402",
                    "speaker": "好奇的调查员",
                    "text": "难道真像因卡纳克说的，固态燃素内部已经形成稳定结构…需要同时击中所有弱点才能清理？"
                },
                {
                    "id": "150201403",
                    "speaker": "好奇的调查员",
                    "text": "——可是要怎么才能<color=#00E1FFFF>同时击中这些弱点</color>呢？"
                }
            ]
        },
        {
            "id": "1502005",
            "objective": "完成飞行挑战",
            "dialogues": [
                {
                    "id": "150200501",
                    "speaker": "因卡纳克",
                    "text": "准备好了吗？虽然对恰斯卡来说不是什么难事，不过还是要注意安全。",
                    "choices": [
                        {
                            "id": "150200502",
                            "text": "我相信她！",
                            "response": [
                                {
                                    "id": "150200503",
                                    "speaker": "因卡纳克",
                                    "text": "嗯，那就大胆地飞吧！"
                                }
                            ]
                        },
                        {
                            "id": "150200504",
                            "text": "最好再准备一下…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1502006",
            "objective": "与恰斯卡对话",
            "dialogues": [
                {
                    "id": "150200601",
                    "speaker": "派蒙",
                    "text": "好精彩的飞行！我连眼睛都不舍得眨！"
                },
                {
                    "id": "150200602",
                    "speaker": "Player",
                    "text": "还有什么遗漏吗？"
                },
                {
                    "id": "150200603",
                    "speaker": "恰斯卡",
                    "text": "嗯…没什么大问题，只要再过几天，就能正常举行试炼了。"
                },
                {
                    "id": "150200604",
                    "speaker": "伊西多尔",
                    "text": "救——救命啊——"
                },
                {
                    "id": "150200605",
                    "speaker": "伊西多尔",
                    "text": "你们…你们是花羽会的人吧？快…快来帮帮我们！"
                },
                {
                    "id": "150200606",
                    "speaker": "恰斯卡",
                    "text": "冷静点，出什么事了？"
                },
                {
                    "id": "150200607",
                    "speaker": "伊西多尔",
                    "text": "有…有一只绒翼龙，突然袭击了我们！"
                },
                {
                    "id": "150200608",
                    "speaker": "伊西多尔",
                    "text": "我的同伴跟货物都还在大道上…求求你们，快去救救他们吧！"
                },
                {
                    "id": "150200609",
                    "speaker": "派蒙",
                    "text": "欸？绒翼龙…有这么凶猛吗？一只直接袭击了一群人？"
                },
                {
                    "id": "150200610",
                    "speaker": "恰斯卡",
                    "text": "按理说应该不会…但凡事总有例外，先过去看看！"
                }
            ]
        },
        {
            "id": "1502007",
            "objective": "前去救助商队",
            "dialogues": [
                {
                    "id": "150200701",
                    "speaker": "疑惑的调查员",
                    "text": "奇了怪了…这里怎么会出现那么多固态燃素？"
                },
                {
                    "id": "150200702",
                    "speaker": "迷惑的调查员",
                    "text": "是不是因为地脉紊乱，把「回声之子」的什么东西给卷进来了？<color=#00E1FFFF>我刚刚在悬崖上就有看见奇怪的印记…</color>"
                },
                {
                    "id": "150200703",
                    "speaker": "疑惑的调查员",
                    "text": "不会吧？难道我们还得去「回声之子」借一头<color=#00E1FFFF>嵴锋龙</color>来清理吗？"
                }
            ]
        },
        {
            "id": "1502008",
            "objective": "与阿尔帕对话",
            "dialogues": [
                {
                    "id": "150200801",
                    "speaker": "阿尔帕",
                    "text": "#嗯？恰斯卡、{NICKNAME}，你们也来了？"
                },
                {
                    "id": "150200802",
                    "speaker": "派蒙",
                    "text": "阿尔帕长老？咦？他们说的绒翼龙呢？"
                },
                {
                    "id": "150200803",
                    "speaker": "阿尔帕",
                    "text": "已经先我们一步飞走了，看来是知道救兵要到，率先撤退了。"
                },
                {
                    "id": "150200804",
                    "speaker": "恰斯卡",
                    "text": "那它突然袭击人类的目的…是商队运送的食物吗？"
                },
                {
                    "id": "150200805",
                    "speaker": "阿尔帕",
                    "text": "不，这支商队运送的不是食物…"
                },
                {
                    "id": "150200806",
                    "speaker": "年轻的行商",
                    "text": "——哦！谢天谢地！「燃素翼」都还没事！"
                },
                {
                    "id": "150200807",
                    "speaker": "恰斯卡",
                    "text": "…「燃素翼」？"
                },
                {
                    "id": "150200808",
                    "speaker": "伊西多尔",
                    "text": "哎呀，太感谢了。这批「燃素翼」是我们最重要的货物，万一有什么闪失，可真不知道该怎么办！"
                },
                {
                    "id": "150200809",
                    "speaker": "阿尔帕",
                    "text": "…你们就是之前瓦尔米说的，要来跟我们谈合作的商队？"
                },
                {
                    "id": "150200810",
                    "speaker": "伊西多尔",
                    "text": "啊，没错没错，那…您就是阿尔帕长老咯？"
                },
                {
                    "id": "150200811",
                    "speaker": "阿尔帕",
                    "text": "是我。各位舟车劳顿，又受了惊吓，就先跟我一起回花羽会好好休息吧，有什么事，可以之后再谈。"
                },
                {
                    "id": "150200812",
                    "speaker": "恰斯卡",
                    "text": "阿尔帕长老，那绒翼龙袭击的事…"
                },
                {
                    "id": "150200813",
                    "speaker": "阿尔帕",
                    "text": "唔，我看这些朋友并没有受重伤，货物也没什么损失…或许只是那只绒翼龙，偶然间受到了什么刺激吧。"
                },
                {
                    "id": "150200814",
                    "speaker": "阿尔帕",
                    "text": "这附近的绒翼龙那么多，出现一两次意外也不奇怪，就不用费心去追查了…倒是飞行试炼那边，修整得怎么样了？",
                    "choices": [
                        {
                            "id": "150200815",
                            "text": "修理得差不多了。",
                            "response": [
                                {
                                    "id": "150200817",
                                    "speaker": "伊西多尔",
                                    "text": "哦？飞行试炼？——那可真是巧了！阿尔帕长老，我们的「燃素翼」一定能在试炼上给您一个惊喜！"
                                },
                                {
                                    "id": "150200818",
                                    "speaker": "阿尔帕",
                                    "text": "是吗？…听起来倒是挺有趣的。"
                                },
                                {
                                    "id": "150200819",
                                    "speaker": "伊西多尔",
                                    "text": "嘿嘿，那绒翼龙的事就放一边…我们快回去谈谈「燃素翼」的合作吧！"
                                },
                                {
                                    "id": "150200820",
                                    "speaker": "恰斯卡",
                                    "text": "……"
                                },
                                {
                                    "id": "150200821",
                                    "speaker": "派蒙",
                                    "text": "问题好像都解决了？还怪顺利的嘛…那我们也走吧…咦？恰斯卡？"
                                },
                                {
                                    "id": "150200822",
                                    "speaker": "Player",
                                    "text": "你在看什么呢？"
                                },
                                {
                                    "id": "150200823",
                                    "speaker": "恰斯卡",
                                    "text": "……"
                                },
                                {
                                    "id": "150200824",
                                    "speaker": "恰斯卡",
                                    "text": "染血的…羽毛？"
                                },
                                {
                                    "id": "150200825",
                                    "speaker": "Black Screen",
                                    "text": "这起风波最终不了了之，花羽会再次恢复了往日的平静。\\n在波澜不惊的日常中，飞行试炼也在紧锣密鼓地筹备…"
                                }
                            ]
                        },
                        {
                            "id": "150200816",
                            "text": "很快就能重启了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "1502013",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150201301",
                    "speaker": "大胆的调查员",
                    "text": "从这边看过去，那只热气球飞得可真高啊…到底是谁放的？"
                }
            ]
        },
        {
            "id": "1502015",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "150201501",
                    "speaker": "好奇的调查员",
                    "text": "原来是用这种方式来解决的吗？太厉害了！"
                }
            ]
        },
        {
            "id": "1502016",
            "objective": "Additional",
            "dialogues": [
                {
