            "dialogues": [
                {
                    "id": "150209901",
                    "speaker": "恰斯卡",
                    "text": "气态燃素正在恢复…看来所有喷口都已经清理完了。我们先回高台上去吧。"
                },
                {
                    "id": "150209902",
                    "speaker": "年轻的行商",
                    "text": "哎哟…"
                },
                {
                    "id": "150209903",
                    "speaker": "年长的行商",
                    "text": "怎么会有这么凶猛的绒翼龙…"
                },
                {
                    "id": "150209904",
                    "speaker": "谨慎的调查员",
                    "text": "哈哈…我还以为自己要完了！这儿的喷口已经没事了，多谢你们。"
                }
