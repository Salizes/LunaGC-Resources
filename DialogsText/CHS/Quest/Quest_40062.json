    "talks": [
        {
            "id": "4006201",
            "objective": "",
            "dialogues": [
                {
                    "id": "400471301",
                    "speaker": "阿祇",
                    "text": "怎么样，决定好了吗？"
                },
                {
                    "id": "400471302",
                    "speaker": "派蒙",
                    "text": "嗯嗯，让我们一起来整治渊下宫的黑雾问题吧。"
                },
                {
                    "id": "400471303",
                    "speaker": "阿祇",
                    "text": "是吗。那么请你收下这个。"
                },
                {
                    "id": "400471304",
                    "speaker": "阿祇",
                    "text": "这个叫做「睦疏之匣」，是我之前找办法的时候从大日御舆里翻出来的。"
                },
                {
                    "id": "400471305",
                    "speaker": "阿祇",
                    "text": "其实千灯仪式的做法和用具都是从大日御舆里翻出来的。还好我能看懂人类的文字。"
                },
                {
                    "id": "400471306",
                    "speaker": "派蒙",
                    "text": "嗯？你能看懂人类的文字不是很正常嘛？你是说能看懂古代渊下宫的文字吗？"
                },
                {
                    "id": "400471307",
                    "speaker": "阿祇",
                    "text": "啊，没什么。我觉得应该是想说《渊海祝由集成》上的文字吧。我并不知道是古代字还是现代字。"
                },
                {
                    "id": "400471308",
                    "speaker": "Player",
                    "text": "越听越混乱了。"
                },
                {
                    "id": "400471309",
                    "speaker": "阿祇",
                    "text": "不必在意，还是说回正事吧。"
                },
                {
                    "id": "400471310",
                    "speaker": "阿祇",
                    "text": "这个睦疏之匣可以采取光明，然后小范围内抵消虚界的黑暗。"
                },
                {
                    "id": "400471311",
                    "speaker": "阿祇",
                    "text": "比如说被黑雾护持的魔物，使用睦疏之匣的力量，就可以将他们打回原形。"
                },
                {
                    "id": "400471312",
                    "speaker": "阿祇",
                    "text": "正好营地附近有这样的魔物在作怪，你可以去体会一下睦疏之匣的力量。我稍后会跟上你的。"
                }
            ]
        }
    ]
}