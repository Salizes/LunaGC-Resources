    "talks": [
        {
            "id": "302702",
            "objective": "(test)刷海芭夏睡觉$HIDDEN",
            "dialogues": []
        },
        {
            "id": "302703",
            "objective": "(test)中位回滚任务$HIDDEN",
            "dialogues": []
        },
        {
            "id": "302701",
            "objective": "(test)刷纳西妲闲置$HIDDEN",
            "dialogues": []
        },
        {
            "id": "302617",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "30261784",
                    "speaker": "纳西妲",
                    "text": "嗯。再过一段时间，你们也会启程，然后离开须弥了吧？"
                },
                {
                    "id": "30261785",
                    "speaker": "纳西妲",
                    "text": "我对你未来的命运很感兴趣。那将是无法被观测，也不会被这个世界所记录的旅程…"
                },
                {
                    "id": "30261786",
                    "speaker": "纳西妲",
                    "text": "我曾说命运是终极的知识，而你的未来则是「终极的命运」。"
                },
                {
                    "id": "30261787",
                    "speaker": "派蒙",
                    "text": "能认识你真好，纳西妲。"
                },
                {
                    "id": "30261788",
                    "speaker": "纳西妲",
                    "text": "我才应该好好感谢你们的到来…"
                },
                {
                    "id": "30261789",
                    "speaker": "纳西妲",
                    "text": "好啦，就先聊到这里吧。以后如果你们想我的话，说不定我会在你们的梦里出现哦？"
                },
                {
                    "id": "30261790",
                    "speaker": "Player",
                    "text": "#关于我的{M#妹妹}{F#哥哥}…"
                },
                {
                    "id": "30261762",
                    "speaker": "纳西妲",
                    "text": "从我可以接触到的记录中，你的血亲是忽然出现在坎瑞亚的…"
                },
                {
                    "id": "30261763",
                    "speaker": "纳西妲",
                    "text": "#在坎瑞亚灾变以后，{M#她}{F#他}踏上了走遍提瓦特各国的旅行。"
                },
                {
                    "id": "30261764",
                    "speaker": "纳西妲",
                    "text": "#可是在{M#她}{F#他}的旅程即将结束的时候，世界树中有关{M#她}{F#他}的记录又忽然间模糊掉了…"
                },
                {
                    "id": "30261765",
                    "speaker": "派蒙",
                    "text": "#模糊掉了？{M#她}{F#他}遇上了什么事么？"
                },
                {
                    "id": "30261766",
                    "speaker": "纳西妲",
                    "text": "#我能确定的是，似乎有人在为了某种理由而刻意掩盖{M#她}{F#他}的「命运」…"
                },
                {
                    "id": "30261767",
                    "speaker": "纳西妲",
                    "text": "既然能做到这一点…那个家伙必然有着非凡的能力。"
                },
                {
                    "id": "30261768",
                    "speaker": "Player",
                    "text": "难道和「深渊」有关…"
                },
                {
                    "id": "30261769",
                    "speaker": "派蒙",
                    "text": "#但是，这些信息好像也没办法解释为什么{NICKNAME}的血亲会是这个世界的人…"
                },
                {
                    "id": "30261770",
                    "speaker": "纳西妲",
                    "text": "有一个值得注意的点，据我所知…在愚人众的情报体系中，他们也并未将你的血亲列入「降临者」的范畴。"
                },
                {
                    "id": "30261771",
                    "speaker": "Player",
                    "text": "「降临者」？"
                },
                {
                    "id": "30261772",
                    "speaker": "派蒙",
                    "text": "…降临者是什么？好像头一次听说这个概念…"
                },
                {
                    "id": "30261773",
                    "speaker": "纳西妲",
                    "text": "你应该也会好奇我究竟用神之心与愚人众交换了什么情报吧？"
                },
                {
                    "id": "30261774",
                    "speaker": "纳西妲",
                    "text": "其中非常重要的一部分，便是关于这个世界的「降临者」…不属于这个世界的外来存在。"
                },
                {
                    "id": "30261775",
                    "speaker": "纳西妲",
                    "text": "#{NICKNAME}，你是提瓦特的「第四降临者」。"
                },
                {
                    "id": "30261776",
                    "speaker": "Player",
                    "text": "第四…？"
                },
                {
                    "id": "30261777",
                    "speaker": "派蒙",
                    "text": "#啊？也就是说，按照愚人众所给出的情报，不算{NICKNAME}的血亲，居然还曾经有过三位「降临者」吗？"
                },
                {
                    "id": "30261778",
                    "speaker": "纳西妲",
                    "text": "没错，据我猜想，「第一降临者」应该就是如今的「天理」。"
                },
                {
                    "id": "30261779",
                    "speaker": "纳西妲",
                    "text": "而其他降临者的存在，我还需要些时间进行「考证」。"
                },
                {
                    "id": "30261780",
                    "speaker": "派蒙",
                    "text": "好像…知道了很多不得了的情报…"
                },
                {
                    "id": "30261781",
                    "speaker": "纳西妲",
                    "text": "告诉你们这些情报，也依旧无法解答你们所有的疑问吧？作为智慧之神，这一点我很惭愧…"
                },
                {
                    "id": "30261782",
                    "speaker": "纳西妲",
                    "text": "我心中也留有了很多疑惑，需要时间来整理。"
                },
                {
                    "id": "30261783",
                    "speaker": "Player",
                    "text": "我也一样…需要点时间思考。"
                },
                {
                    "id": "30261705",
                    "speaker": "纳西妲",
                    "text": "嗯。有什么想知道的事吗？",
                    "choices": [
                        {
                            "id": "30261706",
                            "text": "关于「虚空」…",
                            "response": [
                                {
                                    "id": "30261707",
                                    "speaker": "纳西妲",
                                    "text": "那件事之后，虚空不再能像原来那样运作了。"
                                },
                                {
                                    "id": "30261708",
                                    "speaker": "纳西妲",
                                    "text": "综合考虑之后，我选择关闭虚空。"
                                },
                                {
                                    "id": "30261709",
                                    "speaker": "纳西妲",
                                    "text": "不过，这绝对不是什么坏事。我原本也计划停止虚空的运作。"
                                },
                                {
                                    "id": "30261710",
                                    "speaker": "纳西妲",
                                    "text": "由虚空统一管理知识，本来就会限制人们的好奇心并抹杀他们的可能性。我想这并不利于须弥。"
                                },
                                {
                                    "id": "30261711",
                                    "speaker": "纳西妲",
                                    "text": "现在人们还会为失去虚空感到不适应，但不用多久，大家就会明白，这样的生活才更好、更适合他们。"
                                },
                                {
                                    "id": "30261712",
                                    "speaker": "纳西妲",
                                    "text": "而关于须弥的未来…我正准备重新掌控教令院。"
                                },
                                {
                                    "id": "30261713",
                                    "speaker": "纳西妲",
                                    "text": "原本的贤者已经接受了属于他们的惩戒，新的贤者还没选出。这件事，我也会亲自监督。"
                                },
                                {
                                    "id": "30261714",
                                    "speaker": "纳西妲",
                                    "text": "我期望中的新一代六贤者会更偏学术，现在，须弥需要这样的领导者。"
                                },
                                {
                                    "id": "30261715",
                                    "speaker": "纳西妲",
                                    "text": "另外，赤王子民乃至整个沙漠区域的居民，他们在过去很长的时间里遭到了不公待遇。"
                                },
                                {
                                    "id": "30261716",
                                    "speaker": "纳西妲",
                                    "text": "我已经做出一些相应处理了，重建任何事物都需要时间，但不论是文化、友谊、信任…我们都会重新得到的。"
                                }
                            ]
                        },
                        {
                            "id": "30261717",
                            "text": "关于那天我入睡后发生的事…",
                            "response": [
                                {
                                    "id": "30261718",
                                    "speaker": "纳西妲",
                                    "text": "你是说「博士」令你昏睡之后，究竟发生了什么吗？"
                                },
                                {
                                    "id": "30261719",
                                    "speaker": "Player",
                                    "text": "他夺走了神之心？"
                                },
                                {
                                    "id": "30261720",
                                    "speaker": "纳西妲",
                                    "text": "你猜得没错…第三席及之上的愚人众执行官都有着堪比神明的实力，那种情况下我并不是他的对手。"
                                },
                                {
                                    "id": "30261721",
                                    "speaker": "纳西妲",
                                    "text": "不过，尽管形势恶劣，我也做到了跟「博士」对等交易。"
                                },
                                {
                                    "id": "30261722",
                                    "speaker": "纳西妲",
                                    "text": "你一定记得吧，那个改变了你命运的——「天理」。"
                                },
                                {
                                    "id": "30261723",
                                    "speaker": "纳西妲",
                                    "text": "事实上，「天理」自从五百年前坎瑞亚灾变以后就沉寂至今了。而我利用这一点，威胁了博士。"
                                },
                                {
                                    "id": "30261724",
                                    "speaker": "纳西妲",
                                    "text": "我告诉他，如果我毁灭这颗神之心，就有可能将「天理」唤醒，虽然只是猜测，也成功反制住了他。"
                                },
                                {
                                    "id": "30261725",
                                    "speaker": "纳西妲",
                                    "text": "事关「法则」，这种级别的毁损，「天理」应该不会坐视不理吧。"
                                },
                                {
                                    "id": "30261726",
                                    "speaker": "纳西妲",
                                    "text": "至于我用神之心交换了什么…"
                                },
                                {
                                    "id": "30261727",
                                    "speaker": "纳西妲",
                                    "text": "我换到了对「博士」的惩罚，和我身为智慧之神难以拒绝的「知识」。"
                                }
                            ]
                        },
                        {
                            "id": "30261729",
                            "text": "关于「散兵」…",
                            "response": [
                                {
                                    "id": "30261730",
                                    "speaker": "纳西妲",
                                    "text": "他一直昏迷不醒，我像藏起一片羽毛那样，把他藏起来了。"
                                },
                                {
                                    "id": "30261731",
                                    "speaker": "纳西妲",
                                    "text": "我知道你对他充满顾虑，可是「曾经成神」的他，身上留有了一些很有用的特质。"
                                },
                                {
                                    "id": "30261732",
                                    "speaker": "纳西妲",
                                    "text": "不过别担心，我会看住他，不允许他作恶。"
                                },
                                {
                                    "id": "30261733",
                                    "speaker": "纳西妲",
                                    "text": "另外，他身上还存在着一些谜团。有些事从我的视角看得很清楚，他自己却完全没弄明白呢。"
                                },
                                {
                                    "id": "30261734",
                                    "speaker": "纳西妲",
                                    "text": "未来的事，还得看他造化。"
                                }
                            ]
                        },
                        {
                            "id": "30261735",
                            "text": "关于旅途的下一站，枫丹…",
                            "response": [
                                {
                                    "id": "30261736",
                                    "speaker": "纳西妲",
                                    "text": "你们要去那里了啊，「正义」的国度，枫丹。"
                                },
                                {
                                    "id": "30261737",
                                    "speaker": "纳西妲",
                                    "text": "据我了解，那个国家的运转是建立在一套关于正义的审判体系之上的。"
                                },
                                {
                                    "id": "30261738",
                                    "speaker": "派蒙",
                                    "text": "是由他们的神明来审判民众吗？"
                                },
                                {
                                    "id": "30261739",
                                    "speaker": "纳西妲",
                                    "text": "并不是，枫丹有一位最高审判官在，一般来说，神明「芙卡洛斯」并不会亲自参与审判。"
                                },
                                {
                                    "id": "30261740",
                                    "speaker": "纳西妲",
                                    "text": "但…几乎每一场审判，芙卡洛斯都不会缺席，她似乎只是沉醉于那种氛围而已。"
                                },
                                {
                                    "id": "30261741",
                                    "speaker": "纳西妲",
                                    "text": "作为神明的她，也依旧保留着影响最终判决的权力。"
                                },
                                {
                                    "id": "30261742",
                                    "speaker": "纳西妲",
                                    "text": "总而言之，是一位…嗯…非常有个性的神明。"
                                }
                            ]
                        },
                        {
                            "id": "30261743",
                            "text": "没什么了。"
                        }
                    ]
                }
            ]
        }
    ]
}