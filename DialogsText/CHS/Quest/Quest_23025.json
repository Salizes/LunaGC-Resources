        {
            "id": "2302506",
            "objective": "设置信标",
            "dialogues": [
                {
                    "id": "230250601",
                    "speaker": "法伽尼",
                    "text": "希望这次的数据不要再有误差了…"
                }
            ]
        },
        {
            "id": "2302507",
            "objective": "与法伽尼对话",
            "dialogues": [
                {
                    "id": "230250701",
                    "speaker": "法伽尼",
                    "text": "嗯？信标都已经设置完了吗？"
                },
                {
                    "id": "230250702",
                    "speaker": "Player",
                    "text": "都设置好了。"
                },
                {
                    "id": "230250703",
                    "speaker": "法伽尼",
                    "text": "真是太谢谢了，来，这是说好的报酬。"
                },
                {
                    "id": "230250704",
                    "speaker": "法伽尼",
                    "text": "这下只要等它们采集完数据，就能证实之前的推论了！"
                },
                {
                    "id": "230250705",
                    "speaker": "法伽尼",
                    "text": "不过话又说回来，我该怎么上去回收这些信标呢…"
                }
            ]
        },
        {
            "id": "2302508",
            "objective": "与法伽尼对话",
            "dialogues": [
                {
                    "id": "230250801",
                    "speaker": "法伽尼",
                    "text": "哦！旅行者，您可终于来了！"
                },
                {
                    "id": "230250802",
                    "speaker": "Player",
                    "text": "研究还顺利吗？"
                },
                {
                    "id": "230250803",
                    "speaker": "法伽尼",
                    "text": "托您的福，这几天的进展可不小，那些信标应该有在好好收集数据吧。"
                },
                {
                    "id": "230250804",
                    "speaker": "法伽尼",
                    "text": "现在只要把那些数据回收，就能验证这几天提出的新猜想了！",
                    "choices": [
                        {
                            "id": "230250805",
                            "text": "这几天就只是在猜想吗！",
                            "response": [
                                {
                                    "id": "230250807",
                                    "speaker": "法伽尼",
                                    "text": "咳咳，也有对计算公式的优化、测量仪器的校准之类的，毕竟您看…"
                                },
                                {
                                    "id": "230250808",
                                    "speaker": "法伽尼",
                                    "text": "凭我这副身板，也没办法爬到您设置信标的地方去回收啊。"
                                },
                                {
                                    "id": "230250809",
                                    "speaker": "法伽尼",
                                    "text": "这回恐怕还是要麻烦您一趟，去收回那些信标了。",
                                    "choices": [
                                        {
                                            "id": "230250810",
                                            "text": "好吧…",
                                            "response": [
                                                {
                                                    "id": "230250811",
                                                    "speaker": "法伽尼",
                                                    "text": "拜托了，旅行者，我会好好准备报酬的！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230250812",
                                            "text": "下次可以先考虑好怎么回收…",
                                            "response": [
                                                {
                                                    "id": "230250813",
                                                    "speaker": "法伽尼",
                                                    "text": "我也不是没有想过，加装回收装置啊、拓宽适用范围啊之类的…"
                                                },
                                                {
                                                    "id": "230250814",
                                                    "speaker": "法伽尼",
                                                    "text": "但是这一来要更多的预算，二来也不知道会不会影响数据精度…"
                                                },
                                                {
                                                    "id": "230250815",
                                                    "speaker": "法伽尼",
                                                    "text": "总、总之这次还是要看您的了，拜托了，旅行者！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230250806",
                            "text": "这不是完全没有进展吗！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302511",
            "objective": "前往设置信标处",
            "dialogues": []
        },
        {
            "id": "2302509",
            "objective": "回收信标",
            "dialogues": [
                {
                    "id": "230250901",
                    "speaker": "法伽尼",
                    "text": "希望这次的数据不要再有误差了…"
                }
            ]
        },
        {
            "id": "2302510",
            "objective": "与法伽尼对话",
            "dialogues": [
                {
                    "id": "230251001",
                    "speaker": "法伽尼",
                    "text": "什么？居然有魔物出现？这不应该呀，那片区域的环境参数明明…"
                },
                {
                    "id": "230251002",
                    "speaker": "法伽尼",
                    "text": "难不成是信标本身也构成了变量？如果是运作时的轻微震动和声光吸引了魔物…"
                },
                {
                    "id": "230251003",
                    "speaker": "法伽尼",
                    "text": "不会影响到采集的数据吧…啊，实在抱歉，我又自顾自地说话了。"
                },
                {
                    "id": "230251004",
                    "speaker": "法伽尼",
                    "text": "我也没想到，居然会给您添额外的麻烦…这些报酬还请务必收下。"
                },
                {
                    "id": "230251005",
                    "speaker": "法伽尼",
                    "text": "下次测量，一定要考虑得更谨慎些…"
                }
            ]
        }
    ]
