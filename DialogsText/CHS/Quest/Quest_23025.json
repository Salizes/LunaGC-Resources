    "talks": [
        {
            "id": "2302501",
            "objective": "立即完成随机数$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2302502",
            "objective": "与法伽尼对话",
            "dialogues": [
                {
                    "id": "230250201",
                    "speaker": "法伽尼",
                    "text": "嘿——这位朋友，请问能否占用您一些时间？",
                    "choices": [
                        {
                            "id": "230250202",
                            "text": "有什么事？",
                            "response": [
                                {
                                    "id": "230250208",
                                    "speaker": "法伽尼",
                                    "text": "您有没有想过这么一个问题：要是天塌下来该怎么办？",
                                    "choices": [
                                        {
                                            "id": "230250209",
                                            "text": "我觉得你多虑了…",
                                            "response": [
                                                {
                                                    "id": "230250212",
                                                    "speaker": "法伽尼",
                                                    "text": "或许是吧，但天空为什么不会坍塌？大地又为什么不会陷落？如果不经过准确的测量，这些问题就永远不会有答案。"
                                                },
                                                {
                                                    "id": "230250213",
                                                    "speaker": "法伽尼",
                                                    "text": "其实我已经有了一套完美的模型来解释这些问题，只是需要更多的观测数据来支撑…",
                                                    "choices": [
                                                        {
                                                            "id": "230250214",
                                                            "text": "需要我帮忙吗？",
                                                            "response": [
                                                                {
                                                                    "id": "230250223",
                                                                    "speaker": "法伽尼",
                                                                    "text": "那您是愿意帮忙了吧，真是太感谢了！"
                                                                },
                                                                {
                                                                    "id": "230250224",
                                                                    "speaker": "法伽尼",
                                                                    "text": "其实我已经选定了一个绝佳的观测地点，只是那附近的魔物有些活跃…"
                                                                },
                                                                {
                                                                    "id": "230250225",
                                                                    "speaker": "法伽尼",
                                                                    "text": "拜托您驱离那些魔物，我好安心去做观测记录。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230250226",
                                                                            "text": "好的。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230250227",
                                                                                    "speaker": "法伽尼",
                                                                                    "text": "多谢了，我们这就上路吧。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "230250228",
                                                                            "text": "你也要到现场吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "230250229",
                                                                                    "speaker": "法伽尼",
                                                                                    "text": "毕竟有些数据还是得亲眼去见证，才能发现误差产生的原因啊。"
                                                                                },
                                                                                {
                                                                                    "id": "230250230",
                                                                                    "speaker": "法伽尼",
                                                                                    "text": "埋头对着纸堆计算，可是会离正解越算越远的——我们快点上路吧。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "230250215",
                                                            "text": "祝你好运，再见。",
                                                            "response": [
                                                                {
                                                                    "id": "230250216",
                                                                    "speaker": "法伽尼",
                                                                    "text": "等、等等啊！您再考虑一下吧，只要我的成果能够发表，那可是开天辟地的大事！"
                                                                },
                                                                {
                                                                    "id": "230250217",
                                                                    "speaker": "法伽尼",
                                                                    "text": "到时候，您就是这篇伟大理论的协力者，我可以在文末的致谢列表里写上您的名字…"
                                                                },
                                                                {
                                                                    "id": "230250218",
                                                                    "speaker": "法伽尼",
                                                                    "text": "咕…要不然的话，第二作者的位置也不是不能…"
                                                                },
                                                                {
                                                                    "id": "230250219",
                                                                    "speaker": "Player",
                                                                    "text": "有这么着急吗…"
                                                                },
                                                                {
                                                                    "id": "230250220",
                                                                    "speaker": "法伽尼",
                                                                    "text": "要是再拿不出结果，我的研究经费怕是都要出问题…这可比天什么时候会塌要命得多。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "230250221",
                                                                            "text": "「第二作者」就算了…"
                                                                        },
                                                                        {
                                                                            "id": "230250222",
                                                                            "text": "报酬合理就可以。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "230250210",
                                            "text": "天应该塌不下来…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "230250203",
                            "text": "我很忙。",
                            "response": [
                                {
                                    "id": "230250204",
                                    "speaker": "法伽尼",
                                    "text": "哦！请别这么说，有什么事情能比自己的居所坍圮在即还要严重？"
                                },
                                {
                                    "id": "230250205",
                                    "speaker": "Player",
                                    "text": "你家屋子…要塌了？"
                                },
                                {
                                    "id": "230250206",
                                    "speaker": "法伽尼",
                                    "text": "咳咳，那当然不是。但如果您住在一座屋子里，却从没见过这屋子的全貌，也没人保证过屋子的结构强度…"
                                },
                                {
                                    "id": "230250207",
                                    "speaker": "法伽尼",
                                    "text": "那每天生活在这屋子里，也是会有不安的吧？那么住在这个世界里也是一个道理。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2302503",
            "objective": "击败目的地附近的魔物",
            "dialogues": []
        },
        {
            "id": "2302504",
            "objective": "与法伽尼对话",
            "dialogues": [
                {
                    "id": "230250401",
                    "speaker": "法伽尼",
                    "text": "嗯嗯…原来是这样吗？只要再引入这个变量，就能解释之前的误差…"
                },
                {
                    "id": "230250402",
                    "speaker": "法伽尼",
                    "text": "不过这么一来，别的推论会不会也跟着改变呢…"
                },
                {
                    "id": "230250403",
                    "speaker": "Player",
                    "text": "有进展了吗？"
                },
                {
                    "id": "230250404",
                    "speaker": "法伽尼",
                    "text": "啊，不好意思，都忘了你还在这里…来，这是说好的报酬。"
                },
                {
                    "id": "230250405",
                    "speaker": "法伽尼",
                    "text": "至于进展嘛…虽然解决了一些问题，但又好像出现了不少新问题…大概这就是做研究吧。"
                },
                {
                    "id": "230250406",
                    "speaker": "法伽尼",
                    "text": "在得出最终的结论之前，可能还是得继续麻烦你了，旅行者。"
                }
            ]
        },
