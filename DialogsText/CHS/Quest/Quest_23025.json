{
    "quest": {
        "id": "23025",
        "title": "衡量世界之人！",
        "description": "一名想要「测量世界」的学者，似乎遇到了研究的瓶颈…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
