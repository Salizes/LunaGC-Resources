            "dialogues": [
                {
                    "id": "4660801",
                    "speaker": "迪卢克",
                    "text": "<color=#00E1FFFF>酒庄西北</color>方向，有蒙德最好的冰雾花产地。周边地方也零零散散长了一些。"
                },
                {
                    "id": "4660802",
                    "speaker": "迪卢克",
                    "text": "收集到足够多的<color=#00E1FFFF>冰雾花</color>，我们再聊下一步计划。"
                }
            ]
