    "talks": [
        {
            "id": "46601",
            "objective": "前往晨曦酒庄",
            "dialogues": [
                {
                    "id": "4660101",
                    "speaker": "派蒙",
                    "text": "迪卢克老爷！听我说…"
                },
                {
                    "id": "4660102",
                    "speaker": "迪卢克",
                    "text": "哼，凯亚那家伙吗…"
                },
                {
                    "id": "4660103",
                    "speaker": "迪卢克",
                    "text": "我早该意识到了。对他来说，现在就是从我这里扳回一城的最好时机。"
                },
                {
                    "id": "4660104",
                    "speaker": "派蒙",
                    "text": "你们好像有什么恩怨的样子…"
                },
                {
                    "id": "4660105",
                    "speaker": "迪卢克",
                    "text": "先不说这个，骑士团的想法倒是跟我预料的差不多。"
                },
                {
                    "id": "4660106",
                    "speaker": "迪卢克",
                    "text": "现在将计就计就好。",
                    "choices": [
                        {
                            "id": "4660107",
                            "text": "干脆先别去酒馆代班了…",
                            "response": [
                                {
                                    "id": "4660108",
                                    "speaker": "迪卢克",
                                    "text": "不行。既然骑士团已经知道我代班的事，不去的话反而招致怀疑。"
                                },
                                {
                                    "id": "4660109",
                                    "speaker": "迪卢克",
                                    "text": "这也是凯亚的算计。"
                                },
                                {
                                    "id": "4660110",
                                    "speaker": "派蒙",
                                    "text": "那该怎么办呢？"
                                },
                                {
                                    "id": "4660112",
                                    "speaker": "迪卢克",
                                    "text": "安静一点，让我想想…"
                                },
                                {
                                    "id": "4660113",
                                    "speaker": "迪卢克",
                                    "text": "……"
                                },
                                {
                                    "id": "4660114",
                                    "speaker": "迪卢克",
                                    "text": "…既然要监视我，那就如他所愿。"
                                },
                                {
                                    "id": "4660115",
                                    "speaker": "迪卢克",
                                    "text": "我们来创造一个完美的「不在场证明」吧。"
                                },
                                {
                                    "id": "4660116",
                                    "speaker": "派蒙",
                                    "text": "「不在场证明」？那是什么意思呢？"
                                },
                                {
                                    "id": "4660117",
                                    "speaker": "迪卢克",
                                    "text": "想知道的话，就先帮我个小忙吧。"
                                },
                                {
                                    "id": "4660118",
                                    "speaker": "派蒙",
                                    "text": "怎么还要卖关子呀…"
                                },
                                {
                                    "id": "4660119",
                                    "speaker": "迪卢克",
                                    "text": "<color=#00E1FFFF>酒庄西北</color>方向，有蒙德最好的冰雾花产地。周边地方也零零散散长了一些。"
                                },
                                {
                                    "id": "4660120",
                                    "speaker": "迪卢克",
                                    "text": "请你们帮我收集几株回来吧，我在这里做些其它准备。"
                                }
                            ]
                        },
                        {
                            "id": "4660111",
                            "text": "你有什么想法了吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "46602",
            "objective": "向迪卢克提供情报",
            "dialogues": []
        },
        {
            "id": "46603",
            "objective": "离开酒庄",
            "dialogues": [
                {
                    "id": "4660301",
                    "speaker": "派蒙",
                    "text": "呼…才一点点居然就有这么强的效果，好在没有白忙活。"
                },
                {
                    "id": "4660302",
                    "speaker": "派蒙",
                    "text": "于是现在可以说了吗？迪卢克老爷的计划到底是什么呀？"
                },
                {
                    "id": "4660303",
                    "speaker": "迪卢克",
                    "text": "嗯，计划其实是这样的…"
                },
                {
                    "id": "4660304",
                    "speaker": "迪卢克",
                    "text": "…就是这样。"
                },
                {
                    "id": "4660305",
                    "speaker": "派蒙",
                    "text": "但是…这真的没关系吗？"
                },
                {
                    "id": "4660306",
                    "speaker": "派蒙",
                    "text": "…只靠你一个人…"
                },
                {
                    "id": "4660307",
                    "speaker": "迪卢克",
                    "text": "从一开始就是我一个人的坚持…"
                },
                {
                    "id": "4660308",
                    "speaker": "迪卢克",
                    "text": "…事到如今，也该由我一个人去面对。"
                },
                {
                    "id": "4660309",
                    "speaker": "派蒙",
                    "text": "好吧~既然你已经决定了。"
                },
                {
                    "id": "4660310",
                    "speaker": "派蒙",
                    "text": "#不过在那之前，我和{NICKNAME}还是会帮你的，对吧？",
                    "choices": [
                        {
                            "id": "4660311",
                            "text": "嗯。",
                            "response": [
                                {
                                    "id": "4660314",
                                    "speaker": "迪卢克",
                                    "text": "是我欠你们一个人情。那么就按照计划，<color=#00E1FFFF>酒馆</color>见了。"
                                }
                            ]
                        },
                        {
                            "id": "4660312",
                            "text": "那报酬呢…",
                            "response": [
                                {
                                    "id": "4660313",
                                    "speaker": "派蒙",
                                    "text": "喂！别说那么不合时宜的话啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "46621",
            "objective": "在水边采集冰雾花花朵",
            "dialogues": []
        },
        {
            "id": "46622",
            "objective": "把4个冰雾花花朵交给迪卢克",
            "dialogues": [
                {
                    "id": "4660901",
                    "speaker": "迪卢克",
                    "text": "哦，回来了吗。"
                },
                {
                    "id": "4660902",
                    "speaker": "迪卢克",
                    "text": "介绍一下，他是酒庄的酿造师…"
                },
                {
                    "id": "4660903",
                    "speaker": "康纳",
                    "text": "这么多冰雾花！我已经开始期待「它」的效果了！"
                },
                {
                    "id": "4660904",
                    "speaker": "迪卢克",
                    "text": "提纯设备可以承受这样的纯度么，会不会出什么问题…"
                },
                {
                    "id": "4660905",
                    "speaker": "康纳",
                    "text": "喔…喔喔喔——大老板亲自对我说话了！"
                },
                {
                    "id": "4660906",
                    "speaker": "康纳",
                    "text": "放心好了，老爷！只要是您的意思，我就算搭上这条命都十分甘心！"
                },
                {
                    "id": "4660907",
                    "speaker": "派蒙",
                    "text": "这不是可以拼上性命的事吧…"
                },
                {
                    "id": "4660908",
                    "speaker": "康纳",
                    "text": "你们先聊，我这就开工！"
                },
                {
                    "id": "4660909",
                    "speaker": "派蒙",
                    "text": "他拿那些冰雾花去干什么了？"
                },
                {
                    "id": "4660910",
                    "speaker": "迪卢克",
                    "text": "事情是这样的…"
                },
                {
                    "id": "4660911",
                    "speaker": "迪卢克",
                    "text": "前些日子酒庄在研发新口味的时候，试着加了些冰雾花来让口感清凉。"
                },
                {
                    "id": "4660912",
                    "speaker": "迪卢克",
                    "text": "经过提纯后的冰雾花确实有很强的吸引力…"
                },
                {
                    "id": "4660913",
                    "speaker": "派蒙",
                    "text": "所以卖的很好嘛？"
                },
                {
                    "id": "4660914",
                    "speaker": "迪卢克",
                    "text": "不，我指的不是吸引酒客，而是…吸引史莱姆。"
                },
                {
                    "id": "4660915",
                    "speaker": "迪卢克",
                    "text": "这类依靠汲取元素力量维生的生物，完全抵抗不了它的诱惑。"
                },
                {
                    "id": "4660916",
                    "speaker": "迪卢克",
                    "text": "于是我想，干脆利用这一点做些文章…"
                },
                {
                    "id": "4660917",
                    "speaker": "提纯中",
                    "text": "咚！咔啦咔啦…哐哐！"
                },
                {
                    "id": "4660918",
                    "speaker": "派蒙",
                    "text": "呜哇！刚刚那是什么声音！"
                },
                {
                    "id": "4660919",
                    "speaker": "康纳",
                    "text": "好冷…好冷！迪、迪卢克…老爷，提、提纯…已经…完成了，只是设、设备…"
                },
                {
                    "id": "4660920",
                    "speaker": "迪卢克",
                    "text": "辛苦你了，设备你不用在乎，我会让管家重新订购。"
                },
                {
                    "id": "4660921",
                    "speaker": "派蒙",
                    "text": "真是阔气的发言！"
                },
                {
                    "id": "4660922",
                    "speaker": "迪卢克",
                    "text": "刚才说的就是这东西了。"
                },
                {
                    "id": "4660923",
                    "speaker": "迪卢克",
                    "text": "提纯后的冰雾花——可以叫它「元素诱饵」吧。"
                },
                {
                    "id": "4660924",
                    "speaker": "派蒙",
                    "text": "好厉害，这扑面而来的元素气息！要怎么试效果呢？"
                },
                {
                    "id": "4660925",
                    "speaker": "迪卢克",
                    "text": "洒一点在那边的地上吧，当心…就一点点。"
                }
            ]
        },
        {
            "id": "46604",
            "objective": "布置「元素诱饵」",
            "dialogues": [
                {
                    "id": "4660401",
                    "speaker": "迪卢克",
                    "text": "骑士团的霍夫曼先生，这个时间光临…是有何贵干？"
                },
                {
                    "id": "4660402",
                    "speaker": "霍夫曼",
                    "text": "…啊，没事没事。忙里偷闲，只是想来小酌两杯…没有别的意思。"
                },
                {
                    "id": "4660403",
                    "speaker": "霍夫曼",
                    "text": "哦？旅行者，这么巧你们也在。"
                },
                {
                    "id": "4660404",
                    "speaker": "派蒙",
                    "text": "是呀~今晚心情不错，我们出来转转。"
                },
                {
                    "id": "4660405",
                    "speaker": "迪卢克",
                    "text": "几位想要来点什么？"
                },
                {
                    "id": "4660406",
                    "speaker": "霍夫曼",
                    "text": "那就「蒲公英酒」吧。"
                },
                {
                    "id": "4660407",
                    "speaker": "派蒙",
                    "text": "派蒙要苹果汁！"
                },
                {
                    "id": "4660409",
                    "speaker": "派蒙",
                    "text": "#啊…我的钱袋好像忘记带出来…{NICKNAME}你有带钱吗？",
                    "choices": [
                        {
                            "id": "4660311",
                            "text": "嗯。"
                        },
                        {
                            "id": "4660312",
                            "text": "那报酬呢…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "46605",
            "objective": "与迪卢克对话",
            "dialogues": [
                {
                    "id": "4660201",
                    "speaker": "派蒙",
                    "text": "这样就可以了吗？"
                },
                {
                    "id": "4660202",
                    "speaker": "派蒙",
                    "text": "嗯…要等多久才会有效果呢？"
                },
                {
                    "id": "4660203",
                    "speaker": "？？？",
                    "text": "咔嚓…咔嚓…"
                },
                {
                    "id": "4660204",
                    "speaker": "派蒙",
                    "text": "唔哇，史莱姆真的出现了！…只是数量好像比想象中还多…"
                },
                {
                    "id": "4660205",
                    "speaker": "迪卢克",
                    "text": "效果似乎已经超过预期了…"
                },
                {
                    "id": "4660206",
                    "speaker": "迪卢克",
                    "text": "在庄园被这些史莱姆搞得一团糟之前，把它们处理掉吧。"
                }
            ]
        },
        {
            "id": "46606",
            "objective": "消灭史莱姆",
            "dialogues": [
                {
                    "id": "4660601",
                    "speaker": "派蒙",
                    "text": "不愧是迪卢克老爷，真是干净利落！"
                },
                {
                    "id": "4660602",
                    "speaker": "迪卢克",
                    "text": "不过是些杂碎而已。"
                },
                {
                    "id": "4660603",
                    "speaker": "迪卢克",
                    "text": "没有闲聊的时间了，不知侧门那边情况如何，赶快回<color=#00E1FFFF>酒馆</color>吧。"
                }
            ]
        },
        {
            "id": "46607",
            "objective": "与迪卢克对话",
            "dialogues": []
        },
        {
            "id": "46608",
