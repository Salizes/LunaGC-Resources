    "talks": [
        {
            "id": "400301",
            "objective": "(test)(hide)隐藏环修复PSActivity$HIDDEN",
            "dialogues": [
                {
                    "id": "40030101",
                    "speaker": "那维莱特",
                    "text": "哦，是你们啊，是娜维娅小姐邀请你们来扫墓的吗？"
                },
                {
                    "id": "40030102",
                    "speaker": "派蒙",
                    "text": "嗯，今天在街上偶遇了娜维娅，然后就跟着过来了。"
                },
                {
                    "id": "40030103",
                    "speaker": "那维莱特",
                    "text": "原来如此，那你们找我是有什么事么？"
                },
                {
                    "id": "40030104",
                    "speaker": "派蒙",
                    "text": "啊…就是…难得像这样遇到你嘛，你平时都挺忙的，看看可不可以回答我们几个问题…"
                },
                {
                    "id": "40030105",
                    "speaker": "那维莱特",
                    "text": "但说无妨，毕竟你们作为外来人，协助枫丹解决了这么大的案件，我理应回报你们。"
                }
            ]
        },
        {
            "id": "400302",
            "objective": "(test)和那维莱特对话",
            "dialogues": []
        },
        {
            "id": "4003199",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400319901",
                    "speaker": "派蒙",
                    "text": "这一带的小动物们应该已经找齐了吧，好耶，我们去找龙二吧！"
                },
                {
                    "id": "400319902",
                    "speaker": "派蒙",
                    "text": "啊，原来是他们把小动物给偷走了！"
                },
                {
                    "id": "400319903",
                    "speaker": "派蒙",
                    "text": "#这几个坏东西！{NICKNAME}，你快去教训一下他们！"
                }
            ]
        },
        {
            "id": "4003499",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "400349901",
                    "speaker": "派蒙",
                    "text": "咦？龙二居然不在？我们去问问珊瑚吧！"
                },
                {
                    "id": "400349902",
                    "speaker": "派蒙",
                    "text": "珊瑚说的，应该就是这附近了吧。我们找找龙二在哪里吧。"
                },
                {
                    "id": "400349903",
                    "speaker": "派蒙",
                    "text": "找到了！他在那里！我们快过去吧。"
                },
                {
                    "id": "400349904",
                    "speaker": "派蒙",
                    "text": "#啊，这群家伙回来了！没想到到头来还是要战斗了。{NICKNAME}，小心不要伤到小动物们。"
                },
                {
                    "id": "400349905",
                    "speaker": "龙二",
                    "text": "没事，你们安心战斗，我来把小动物们转移到安全的地方。"
                },
                {
                    "id": "400349906",
                    "speaker": "派蒙",
                    "text": "#它、它怎么突然攻击过来了！{NICKNAME}，你快想想办法让它冷静下来！"
                }
            ]
        }
    ]
}