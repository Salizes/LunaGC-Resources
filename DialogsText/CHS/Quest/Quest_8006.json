    "talks": [
        {
            "id": "800601",
            "objective": "跟随哈夫丹指引的方向进行探索",
            "dialogues": [
                {
                    "id": "80060101",
                    "speaker": "派蒙",
                    "text": "哈夫丹的身影，好像消失在这条路的尽头了…"
                },
                {
                    "id": "80060102",
                    "speaker": "戴因斯雷布",
                    "text": "前面可能有他想让我们看到的东西。跟上去吧。"
                }
            ]
        },
        {
            "id": "800602",
            "objective": "沿道路向前方探索",
            "dialogues": []
        },
        {
            "id": "800603",
            "objective": "沿道路向前方探索",
            "dialogues": []
        },
        {
            "id": "800612",
            "objective": "",
            "dialogues": [
                {
                    "id": "80060401",
                    "speaker": "派蒙",
                    "text": "一处有些简陋的丘丘人营地…"
                },
                {
                    "id": "80060402",
                    "speaker": "派蒙",
                    "text": "这里也有看起来很可怜的丘丘人呢，有些已经…失去了生命气息…"
                },
                {
                    "id": "80060403",
                    "speaker": "派蒙",
                    "text": "哈夫丹想带我们看的就是这里吗？"
                },
                {
                    "id": "80060404",
                    "speaker": "戴因斯雷布",
                    "text": "无论是或不是，这里都有仔细探查的价值。四处调查一番，别漏掉任何细节。"
                }
            ]
        },
        {
            "id": "800604",
            "objective": "前往丘丘人营地",
            "dialogues": []
        },
        {
            "id": "800605",
            "objective": "调查丘丘人营地中的线索",
            "dialogues": [
                {
                    "id": "80060501",
                    "speaker": "派蒙",
                    "text": "这么深的地底，怎么会有这样的花？"
                },
                {
                    "id": "80060502",
                    "speaker": "派蒙",
                    "text": "是献给这些死去的丘丘人的吗？",
                    "choices": [
                        {
                            "id": "80060503",
                            "text": "我知道这是什么花…",
                            "response": [
                                {
                                    "id": "80060505",
                                    "speaker": "派蒙",
                                    "text": "欸，你这么一说，我也觉得有些眼熟…"
                                },
                                {
                                    "id": "80060506",
                                    "speaker": "戴因斯雷布",
                                    "text": "是坎瑞亚的国花——「因提瓦特」。曾盛放在坎瑞亚大地的每一个角落。"
                                },
                                {
                                    "id": "80060507",
                                    "speaker": "戴因斯雷布",
                                    "text": "这种花的花期原本只有两周。可若被人折下、带离坎瑞亚的土地，花瓣便不再生长，而且变得十分坚硬。"
                                },
                                {
                                    "id": "80060508",
                                    "speaker": "戴因斯雷布",
                                    "text": "直至回到故土之中，花瓣才会重新变得柔软，最终泯于尘土…"
                                },
                                {
                                    "id": "80060509",
                                    "speaker": "戴因斯雷布",
                                    "text": "所以，因提瓦特也象征「游子」，寓意着「故乡的温柔」。"
                                },
                                {
                                    "id": "80060510",
                                    "speaker": "Player",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_Twins2Male|INFO_FEMALE_PRONOUN_Twins2Female]}"
                                },
                                {
                                    "id": "80060511",
                                    "speaker": "派蒙",
                                    "text": "啊！那这种花出现在这里，也就是说…"
                                },
                                {
                                    "id": "80060512",
                                    "speaker": "深渊使徒",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_GIRLD|INFO_FEMALE_PRONOUN_BOYD]}殿下，您终于同意了？"
                                },
                                {
                                    "id": "80060513",
                                    "speaker": "Sibling",
                                    "text": "过分专注地投入对抗「天理」之大业，反而淡忘了「复国」的使命。"
                                },
                                {
                                    "id": "80060514",
                                    "speaker": "Sibling",
                                    "text": "的确，我不该如此优柔寡断。"
                                },
                                {
                                    "id": "80060515",
                                    "speaker": "深渊使徒",
                                    "text": "「装置」即将完备，等待殿下您的吩咐。"
                                },
                                {
                                    "id": "80060516",
                                    "speaker": "Sibling",
                                    "text": "有多少把握？"
                                },
                                {
                                    "id": "80060517",
                                    "speaker": "深渊使徒",
                                    "text": "理论上的可行性，大概…"
                                },
                                {
                                    "id": "80060518",
                                    "speaker": "Sibling",
                                    "text": "算了，哪怕只有百分之一的希望…"
                                },
                                {
                                    "id": "80060519",
                                    "speaker": "Sibling",
                                    "text": "我们不也是一样么，早已身处深渊了。"
                                },
                                {
                                    "id": "80060520",
                                    "speaker": "Sibling",
                                    "text": "对「他们」而言，与其活得毫无尊严，还不如早日回到「循环」之中。"
                                },
                                {
                                    "id": "80060521",
                                    "speaker": "Sibling",
                                    "text": "不要让「他们」继续背负…那些莫须有的罪孽了。"
                                },
                                {
                                    "id": "80060522",
                                    "speaker": "深渊使徒",
                                    "text": "您的决断，是教团的幸运。"
                                },
                                {
                                    "id": "80060523",
                                    "speaker": "Player",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_BROTHER]}…"
                                },
                                {
                                    "id": "80060524",
                                    "speaker": "戴因斯雷布",
                                    "text": "你似乎看到了什么。能说给我听听么？"
                                },
                                {
                                    "id": "80060525",
                                    "speaker": "派蒙",
                                    "text": "是呀，你好像愣神了好久。"
                                },
                                {
                                    "id": "80060526",
                                    "speaker": "Black Screen",
                                    "text": "将刚刚看到的画面告诉了戴因斯雷布…"
                                },
                                {
                                    "id": "80060527",
                                    "speaker": "戴因斯雷布",
                                    "text": "这是仅属于「双子」的奇妙连接么…"
                                },
                                {
                                    "id": "80060528",
                                    "speaker": "戴因斯雷布",
                                    "text": "听起来，他们试图利用某些装置净化诅咒，可能就是之前我们看到过的那件物品。"
                                },
                                {
                                    "id": "80060529",
                                    "speaker": "戴因斯雷布",
                                    "text": "#而且…{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}还提到了「复国」，对么？",
                                    "choices": [
                                        {
                                            "id": "80060530",
                                            "text": "没错。",
                                            "response": [
                                                {
                                                    "id": "80060532",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "这个顽固的家伙，果然还没有放弃。"
                                                },
                                                {
                                                    "id": "80060533",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "看来，教团计划借这一地点净化丘丘人身上的诅咒，想令他们复原…从而作为坎瑞亚复国的根基。"
                                                },
                                                {
                                                    "id": "80060534",
                                                    "speaker": "戴因斯雷布",
                                                    "text": "毕竟，没有「国民」，便谈不上「国家」。",
                                                    "choices": [
                                                        {
                                                            "id": "80060535",
                                                            "text": "你怎么看？",
                                                            "response": [
                                                                {
                                                                    "id": "80060537",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "哼，愚昧至极。连百分之一的可能性都没有。"
                                                                },
                                                                {
                                                                    "id": "80060538",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "我应该说过，作为与诅咒共处了五百年的人，没有人比我更明白…绝不存在什么救赎。诅咒是不可逆的。"
                                                                },
                                                                {
                                                                    "id": "80060539",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "强行祛除诅咒的话，除了痛苦，什么都不会得到。"
                                                                },
                                                                {
                                                                    "id": "80060540",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "所以，要保持清醒，要反复告诫自己——那些已经不是人类了。"
                                                                },
                                                                {
                                                                    "id": "80060541",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "执着于此，投入过多感情，只会越陷越深…最终像它们一样，陷入名为伪善的污泥之中。"
                                                                },
                                                                {
                                                                    "id": "80060542",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "还是把心思放在更值得拯救的东西上吧。"
                                                                },
                                                                {
                                                                    "id": "80060543",
                                                                    "speaker": "Player",
                                                                    "text": "我凭什么相信你？"
                                                                },
                                                                {
                                                                    "id": "80060544",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "嗯？"
                                                                },
                                                                {
                                                                    "id": "80060545",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "#哈哈…也对。我们之间不过是雇佣关系，而{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}是你的血亲。"
                                                                },
                                                                {
                                                                    "id": "80060546",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "#你选择站在{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}身边，于情于理，确实没有问题。"
                                                                },
                                                                {
                                                                    "id": "80060547",
                                                                    "speaker": "戴因斯雷布",
                                                                    "text": "不论你做出何种选择，都不会撼动我的本心。阻止深渊是我所认定的路，如果无法达成共识，那不妨就此…"
                                                                },
                                                                {
                                                                    "id": "80060548",
                                                                    "speaker": "Player",
                                                                    "text": "我这次选择相信你。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "80060549",
                                                                            "text": "但不代表我完全信任你。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "80060551",
                                                                                    "speaker": "戴因斯雷布",
                                                                                    "text": "这样吗。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "80060552",
                                                                                            "text": "百分之一的机会得到救赎。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "80060554",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "没有任何人有资格…",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "80060556",
                                                                                                            "text": "更何况那些丘丘人…",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "80060558",
                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                    "text": "看来，我当初问你的三个问题不是没有意义的。你已经找到独属于你的，看待这个世界的方法了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80060559",
                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                    "text": "既然你吐露了真实想法，我也不打算继续隐瞒。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80060560",
                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                    "text": "目前，比起单纯地阻止深渊，我更加在乎的是——"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "80060561",
                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                    "text": "绝不能允许深渊以如此独断的行为，来践踏哈夫丹他们的「遗愿」。",
                                                                                                                    "choices": [
                                                                                                                        {
                                                                                                                            "id": "80060562",
                                                                                                                            "text": "我能理解。",
                                                                                                                            "response": [
                                                                                                                                {
                                                                                                                                    "id": "80060564",
                                                                                                                                    "speaker": "戴因斯雷布",
                                                                                                                                    "text": "深渊随时可能出现，保持警惕，继续前进。"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "80060563",
                                                                                                                            "text": "继续联手吧。"
                                                                                                                        }
                                                                                                                    ]
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "80060557",
                                                                                                            "text": "原本已经选择好了自己的归宿。"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "80060553",
                                                                                            "text": "百分之九十九的可能痛苦死去。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "80060550",
                                                                            "text": "#只是因为我不认同{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_YING|INFO_FEMALE_PRONOUN_BROTHER]}的做法。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "80060536",
                                                            "text": "有机会实现么？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "80060531",
                                            "text": "#{PLAYERAVATAR#SEXPRO[INFO_FEMALE_PRONOUN_SHE|INFO_MALE_PRONOUN_HE]}说这是使命。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "80060504",
                            "text": "我见过这种花。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "800609",
            "objective": "调查丘丘人营地中的线索",
            "dialogues": []
        },
        {
            "id": "800610",
            "objective": "调查丘丘人营地中的线索",
            "dialogues": []
        },
        {
            "id": "800611",
            "objective": "调查丘丘人营地中的线索",
            "dialogues": []
        },
        {
            "id": "800606",
            "objective": "离开丘丘人营地",
            "dialogues": [
                {
                    "id": "80060601",
                    "speaker": "派蒙",
                    "text": "从这里也能看到那座倒立的城市呀。"
                },
                {
                    "id": "80060602",
                    "speaker": "戴因斯雷布",
                    "text": "不对…小心！"
                },
                {
                    "id": "80060603",
                    "speaker": "派蒙",
                    "text": "哇啊！"
                },
                {
                    "id": "80060604",
                    "speaker": "派蒙",
                    "text": "怎么、怎么回事！是之前那个正中央的房间发出的光吗？眼睛好痛！"
                },
                {
                    "id": "80060605",
                    "speaker": "戴因斯雷布",
                    "text": "异变还在继续，深渊已经动手了么？"
                },
                {
                    "id": "80060606",
                    "speaker": "深渊使徒",
                    "text": "戴因斯雷布…如此纠缠不休，居然还再一次联合了殿下的血亲…"
                },
                {
                    "id": "80060607",
                    "speaker": "深渊使徒",
                    "text": "之前没来得及确认传送网络，结果误将你传送到这里…真是致命的失误。"
                },
                {
                    "id": "80060608",
                    "speaker": "戴因斯雷布",
                    "text": "哼！只懂得逃跑的懦夫，是谁给了你直面我的勇气？"
                },
                {
                    "id": "80060609",
                    "speaker": "深渊使徒",
                    "text": "殿下的意志必须被落实，应当不惜一切代价清除干扰。"
                },
                {
                    "id": "80060610",
                    "speaker": "深渊使徒",
                    "text": "这次一定要彻底地…将折磨着人民的诅咒清除掉。"
                },
                {
                    "id": "80060611",
                    "speaker": "戴因斯雷布",
                    "text": "折磨它们的只会是你们。"
                },
                {
                    "id": "80060612",
                    "speaker": "戴因斯雷布",
                    "text": "那些丘丘人身上，除了诅咒，本就已经什么都没有留下了。"
                },
                {
                    "id": "80060613",
                    "speaker": "深渊使徒",
                    "text": "我不会逃了，来吧，戴因斯雷布。"
                },
                {
                    "id": "80060614",
                    "speaker": "戴因斯雷布",
                    "text": "如此可笑的意志，值得你用生命来拖延时间吗？你想坚持，那就如你所愿！"
                }
            ]
        },
        {
            "id": "800607",
            "objective": "击败深渊使徒",
            "dialogues": []
        },
        {
            "id": "800608",
            "objective": "与戴因斯雷布对话",
            "dialogues": [
                {
                    "id": "80060801",
                    "speaker": "派蒙",
                    "text": "呼！你追了这么久的深渊使徒，总算是干掉了！"
                },
                {
                    "id": "80060802",
                    "speaker": "戴因斯雷布",
                    "text": "没空闲聊了。看来深渊教团的装置正在启动，现在赶去摧毁它还来得及。"
                },
                {
                    "id": "80060803",
                    "speaker": "派蒙",
                    "text": "嗯！我们赶快过去看看！"
                }
            ]
        },
        {
            "id": "800620",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80062001",
                    "speaker": "派蒙",
                    "text": "和普通的丘丘人一样，这边也有篝火呢。"
                },
                {
                    "id": "80062002",
                    "speaker": "派蒙",
                    "text": "可是戴因明明说，丘丘人在生命的最后阶段会变得畏光…"
                },
                {
                    "id": "80062003",
                    "speaker": "派蒙",
                    "text": "莫非是在最后的最后，还是想要感受一下光明和温暖？啊，我只是瞎猜哦…也有可能是别的原因啦！"
                }
            ]
        },
        {
            "id": "800621",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80062101",
                    "speaker": "派蒙",
                    "text": "这些箱子，一般来说是丘丘人们存放食物的地方吧？"
                },
                {
                    "id": "80062102",
                    "speaker": "派蒙",
                    "text": "好像…基本上是空空如也的。似乎丘丘人的生命到了最后是不需要吃东西的吗？"
                },
                {
                    "id": "80062103",
                    "speaker": "派蒙",
                    "text": "如果是我的话，至少…肯定还是会想念食物的味道的…"
                }
            ]
        },
        {
            "id": "800622",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80062201",
                    "speaker": "派蒙",
                    "text": "这些丘丘人…完全没有生命的气息了呢，就快要和黑暗融为一体了。"
                },
                {
                    "id": "80062202",
                    "speaker": "派蒙",
                    "text": "总是吵吵闹闹的丘丘人原来是以这样的方式老去的，想想还真是不可思议。"
                },
                {
                    "id": "80062203",
                    "speaker": "派蒙",
                    "text": "尽管和丘丘人之间没有太多好的回忆，但，还是希望它们在最后的时刻得到了安宁吧。"
                }
            ]
        },
        {
            "id": "800699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "80069901",
