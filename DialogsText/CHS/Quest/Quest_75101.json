    "talks": [
        {
            "id": "7510101",
            "objective": "(test)与神像交互说一句话$HIDDEN",
            "dialogues": [
                {
                    "id": "750970301",
                    "speaker": "派蒙",
                    "text": "哦哦，这样才正常嘛…那种和七天神像建立稳固联系的感觉。"
                },
                {
                    "id": "750970302",
                    "speaker": "派蒙",
                    "text": "所以之前七天神像不正常，果然是因为夜神之国里有那个坏家伙！看来七天神像之前也很辛苦呢…你很努力了，七天神像！"
                },
                {
                    "id": "750970303",
                    "speaker": "派蒙",
                    "text": "虽然和火元素共鸣的力量也不是你给的…"
                },
                {
                    "id": "750970304",
                    "speaker": "Player",
                    "text": "嗯，是和火神共同战斗时候…"
                },
                {
                    "id": "750970305",
                    "speaker": "派蒙",
                    "text": "#是呀，那个时候我可担心了…不过果然还是{NICKNAME}更强！"
                },
                {
                    "id": "750970306",
                    "speaker": "派蒙",
                    "text": "解决了深渊的怪物，七天神像也恢复了正常，真是太好了！"
                }
            ]
        },
