{
    "quest": {
        "id": "70523",
        "title": "山间的饮品调配师",
        "description": "刚刚返回轻策庄不久的厨师关垂似乎在为兄弟们的解渴饮品发愁…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 61,
        "total_speaker_counts": {
            "Player": 11,
            "关垂": 23,
            "格奥尔格": 10,
            "派蒙": 17
        }
    },
    "talks": [
        {
            "id": "7052301",
            "objective": "",
            "dialogues": [
                {
                    "id": "705230101",
                    "speaker": "关垂",
                    "text": "外地来的客人？欢迎来到轻策庄…",
                    "choices": [
                        {
                            "id": "705230102",
                            "text": "你好…",
                            "response": [
                                {
                                    "id": "705230104",
                                    "speaker": "派蒙",
                                    "text": "我先说我先说，我们先自我介绍！"
                                },
                                {
                                    "id": "705230105",
                                    "speaker": "派蒙",
                                    "text": "#这是无所不能的旅行者{NICKNAME}，我是旅行者最好的伙伴派蒙。"
                                },
                                {
                                    "id": "705230106",
                                    "speaker": "派蒙",
                                    "text": "我们正在帮外地的客人订购佳酿节的特色饮品，看到了你的委托，所以就来直接和你商量了。"
                                },
                                {
                                    "id": "705230107",
                                    "speaker": "关垂",
                                    "text": "原来如此，真是爽快人！那我也不废话了。"
                                },
                                {
                                    "id": "705230109",
                                    "speaker": "关垂",
                                    "text": "我是厨师关垂，需要采购<color=#00E1FFFF>100箱「假日果酿」</color>，用来兑茶水，给干体力活的兄弟们喝个痛快。"
                                },
                                {
                                    "id": "705230110",
                                    "speaker": "派蒙",
                                    "text": "好！那我们就开工了，请提供采购资金吧。"
                                },
                                {
                                    "id": "705230111",
                                    "speaker": "关垂",
                                    "text": "早就准备好了，请收下这些「佳酿晶冻」！下单后想必还会有盈余，不管还剩多少，都是两位劳苦功高的报酬！"
                                },
                                {
                                    "id": "705230112",
                                    "speaker": "派蒙",
                                    "text": "我们都收下了，待会儿就出发！"
                                },
                                {
                                    "id": "705230113",
                                    "speaker": "关垂",
                                    "text": "好极了！等着你们两位的好消息！",
                                    "choices": [
                                        {
                                            "id": "705230114",
                                            "text": "好迅速的交流…",
                                            "response": [
                                                {
                                                    "id": "705230116",
                                                    "speaker": "派蒙",
                                                    "text": "#别愣着啦，{NICKNAME}，我们快走吧！"
                                                },
                                                {
                                                    "id": "705230117",
                                                    "speaker": "派蒙",
                                                    "text": "有什么想说的，就等下单以后再来聊吧。"
                                                },
                                                {
                                                    "id": "705230118",
                                                    "speaker": "派蒙",
                                                    "text": "早点搞定这些工作，我们就能早点开店啦！"
                                                },
                                                {
                                                    "id": "705230119",
                                                    "speaker": "派蒙",
                                                    "text": "开店开店，嗯哼哼~"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705230115",
                                            "text": "派蒙也上道了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705230103",
                            "text": "请问你…"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7052305",
            "objective": "前往轻策庄",
            "dialogues": []
        },
        {
            "id": "7052304",
            "objective": "与关垂对话",
            "dialogues": []
        },
        {
            "id": "7052302",
            "objective": "返回清泉镇，向格奥尔格提出采购订单",
            "dialogues": [
                {
                    "id": "705230201",
                    "speaker": "格奥尔格",
                    "text": "哦！你们又来了？"
                },
                {
                    "id": "705230202",
                    "speaker": "格奥尔格",
                    "text": "这次还是帮别国的客人下单吗？"
                },
                {
                    "id": "705230203",
                    "speaker": "派蒙",
                    "text": "没错哦，这次我们需要100箱「假日果酿」，委托人是轻策庄的厨师关垂。"
                },
                {
                    "id": "705230204",
                    "speaker": "派蒙",
                    "text": "我们准备好出价了，格奥尔格先生！",
                    "choices": [
                        {
                            "id": "705230205",
                            "text": "怎么有种商业对决的感觉…",
                            "response": [
                                {
                                    "id": "705230207",
                                    "speaker": "格奥尔格",
                                    "text": "喔！气势很强嘛！那就让我看看你们这次的觉悟吧！"
                                }
                            ]
                        },
                        {
                            "id": "705230206",
                            "text": "请接招吧，格奥尔格先生！"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7052306",
            "objective": "与格奥尔格交涉",
            "dialogues": [
                {
                    "id": "705232601",
                    "speaker": "格奥尔格",
                    "text": "好了，和上次一样，单据给你们，运输工作由我来安排。"
                },
                {
                    "id": "705232602",
                    "speaker": "格奥尔格",
                    "text": "因为是新顾客，你们还是把单据交给他比较好，这样能让他安心。"
                },
                {
                    "id": "705232603",
                    "speaker": "派蒙",
                    "text": "格奥尔格先生说得有道理，我们正有此意！"
                },
                {
                    "id": "705232604",
                    "speaker": "派蒙",
                    "text": "#走吧，{NICKNAME}，我们回轻策庄去交差。"
                }
            ]
        },
        {
            "id": "7052303",
            "objective": "前往轻策庄，答复关垂",
            "dialogues": [
                {
                    "id": "705230301",
                    "speaker": "派蒙",
                    "text": "关垂先生，我们回来了！"
                },
                {
                    "id": "705230302",
                    "speaker": "派蒙",
                    "text": "你需要的100箱「假日果酿」已经订好了，这是给你的单据，请收下。"
                },
                {
                    "id": "705230303",
                    "speaker": "关垂",
                    "text": "好好好！两位真是帮大忙了！"
                },
                {
                    "id": "705230304",
                    "speaker": "关垂",
                    "text": "我要好好研究一下「假日果酿」，把这种新鲜饮料和茶水按特定的比例混合，调出最好的口感，让兄弟们下地干活时更有干劲！"
                },
                {
                    "id": "705230305",
                    "speaker": "派蒙",
                    "text": "呃，听起来有点像调酒，不过用茶水来兑…真的能做到吗？"
                },
                {
                    "id": "705230306",
                    "speaker": "关垂",
                    "text": "放心吧，我以前在外边当过一段时间厨师。这种做法能在成本和口味之间取得最好的平衡，我已经调配过很多次了！"
                },
                {
                    "id": "705230307",
                    "speaker": "Player",
                    "text": "有点想试试看…"
                },
                {
                    "id": "705230308",
                    "speaker": "关垂",
                    "text": "下次你们来轻策庄玩的时候，我就用成品来招待你们。"
                },
                {
                    "id": "705230309",
                    "speaker": "派蒙",
                    "text": "#好哦！到时候就让{NICKNAME}先尝尝！"
                },
                {
                    "id": "705230310",
                    "speaker": "Player",
                    "text": "加油啊，调配饮品的厨师！"
                },
                {
                    "id": "705230311",
                    "speaker": "关垂",
                    "text": "谢谢你们！有空常来啊！"
                }
            ]
        },
        {
            "id": "7052304",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705230401",
                    "speaker": "关垂",
                    "text": "这次佳酿节的特色饮品，想来就和轻策庄的山泉茶水很般配！"
                },
                {
                    "id": "705230402",
                    "speaker": "关垂",
                    "text": "有劳你们两位了！",
                    "choices": [
                        {
                            "id": "705230403",
                            "text": "关于你自己…",
                            "response": [
                                {
                                    "id": "705230404",
                                    "speaker": "关垂",
                                    "text": "我和几个兄弟搬回庄里还没多久。平时我负责给下地干活的兄弟们做点饭菜，送到田里去。"
                                },
                                {
                                    "id": "705230405",
                                    "speaker": "关垂",
                                    "text": "不过我做的大多是些简单管饱的菜式，拿出来招待外地的客人还是有点寒碜了…"
                                },
                                {
                                    "id": "705230406",
                                    "speaker": "关垂",
                                    "text": "轻策庄虽不热闹，但美食可一点都不少，你在庄里逛逛就能见识到了！"
                                }
                            ]
                        },
                        {
                            "id": "705230407",
                            "text": "关于茶水…",
                            "response": [
                                {
                                    "id": "705230408",
                                    "speaker": "关垂",
                                    "text": "下地干活的兄弟们口渴得厉害，经常半天就喝掉一大缸茶。"
                                },
                                {
                                    "id": "705230409",
                                    "speaker": "关垂",
                                    "text": "田地和庄里的茶水摊隔着一段距离，来来回回不太方便。"
                                },
                                {
                                    "id": "705230410",
                                    "speaker": "关垂",
                                    "text": "凯叔一把年纪了，可不能麻烦他给兄弟们送茶，这个活儿就由我包揽了。"
                                },
                                {
                                    "id": "705230411",
                                    "speaker": "关垂",
                                    "text": "我和几个兄弟在外地闯荡过一段时间，大缸的茶水对我们来说有点清淡，有时兄弟们想喝些味道重的东西。"
                                },
                                {
                                    "id": "705230412",
                                    "speaker": "关垂",
                                    "text": "所以我会往茶水里加些饮品，调出新鲜的风味，让兄弟们乐呵乐呵。"
                                },
                                {
                                    "id": "705230413",
                                    "speaker": "关垂",
                                    "text": "当然，我做的茶水只提供给几个兄弟，可不能抢凯叔的生意啊！"
                                },
                                {
                                    "id": "705230414",
                                    "speaker": "关垂",
                                    "text": "闲下来以后，我们也会去凯叔的茶水摊品茶，帮他干些杂活。"
                                }
                            ]
                        },
                        {
                            "id": "705230415",
                            "text": "我们去去就回。",
                            "response": [
                                {
                                    "id": "705230416",
                                    "speaker": "关垂",
                                    "text": "好啊！等着你们的好消息！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7052321",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705232101",
                    "speaker": "格奥尔格",
                    "text": "不行不行，太少了！就算订货的总量变多了，每箱的单价也不至于降到这种水平！"
                }
            ]
        },
        {
            "id": "7052322",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705232201",
                    "speaker": "格奥尔格",
                    "text": "嗯，这个出价还算不错，但考虑到去轻策庄的运输难度，还是够呛啊。"
                }
            ]
        },
        {
            "id": "7052323",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705232301",
                    "speaker": "格奥尔格",
                    "text": "成交！你们俩的悟性很好嘛，第二回和我讲价，就找到了一个让大家都满意的价钱！"
                }
            ]
        },
        {
            "id": "7052324",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705232401",
                    "speaker": "格奥尔格",
                    "text": "不错啊，刚好卡在我能接受的最低价上，算你们机灵！"
                }
            ]
        },
        {
            "id": "7052325",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "705232501",
                    "speaker": "格奥尔格",
                    "text": "啊哈，看来我被小瞧了啊！这次就用我说的价钱成交吧，就当是你们交了一笔砍价技巧的学费。"
                }
            ]
        }
    ]
}