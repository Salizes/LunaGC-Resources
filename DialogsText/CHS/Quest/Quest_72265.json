    "talks": [
        {
            "id": "7226501",
            "objective": "将「竹签」交给玄冬",
            "dialogues": [
                {
                    "id": "721033901",
                    "speaker": "Player",
                    "text": "交出「特制的竹签」。"
                },
                {
                    "id": "721033902",
                    "speaker": "「玄冬林檎」",
                    "text": "好的，请将竹签交给我吧。奇怪，总觉得刚才好像没有看到您摇晃签筒…"
                },
                {
                    "id": "721033903",
                    "speaker": "Player",
                    "text": "是你的错觉。"
                },
                {
                    "id": "721033904",
                    "speaker": "派蒙",
                    "text": "对呀，因为玄冬小姐一副心不在焉的样子。"
                },
                {
                    "id": "721033905",
                    "speaker": "「玄冬林檎」",
                    "text": "心、心不在焉？！啊…没有的事，大概只是因为昨天没有睡好的关系，让您担心了！"
                },
                {
                    "id": "721033906",
                    "speaker": "「玄冬林檎」",
                    "text": "这是您的御神签，请您收好。"
                },
                {
                    "id": "721033907",
                    "speaker": "派蒙",
                    "text": "（怎么样怎么样？刚才粉末应该已经粘在她身上了吧。）"
                },
                {
                    "id": "721033908",
                    "speaker": "Player",
                    "text": "（嗯，没问题。）"
                },
                {
                    "id": "721033909",
                    "speaker": "「玄冬林檎」",
                    "text": "咦，你们两位为什么一脸凝重地站在这里？难道是抽到凶签了吗？"
                },
                {
                    "id": "721033910",
                    "speaker": "Player",
                    "text": "不，是「末吉」。"
                },
                {
                    "id": "721033911",
                    "speaker": "「玄冬林檎」",
                    "text": "请不要灰心，「末吉」其实也是不错的运势哦。也许会经历一些坎坷，但最终一定会迎来美满的结局。"
                },
                {
                    "id": "721033912",
                    "speaker": "「玄冬林檎」",
                    "text": "尤其是对于您这样善良的人，一定会灵验的。至少，我是这样相信的。"
                }
            ]
        },
        {
            "id": "7226502",
            "objective": "在晚上（21点~23点）等待假玄冬",
            "dialogues": []
        },
        {
            "id": "7226503",
            "objective": "等待假玄冬出现",
            "dialogues": [
                {
                    "id": "722650301",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}你看，有个人影从神社里走出来了！"
                },
                {
                    "id": "722650302",
                    "speaker": "派蒙",
                    "text": "没错，是假玄冬！她向着山下的方向走了，我们快追！"
                }
            ]
        },
        {
            "id": "7226504",
            "objective": "用元素视野追踪假玄冬",
            "dialogues": []
        },
        {
            "id": "7226505",
            "objective": "偷听两人的对话",
            "dialogues": [
                {
                    "id": "722650501",
                    "speaker": "「玄冬林檎」",
                    "text": "应该还不到和老师例行会面的日期才对，一定是因为那件事…"
                },
                {
                    "id": "722650502",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "柳达希卡。"
                },
                {
                    "id": "722650503",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "啊，老师您来了！"
                },
                {
                    "id": "722650504",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "您辛苦了，我马上向您汇报近日的进展。关于您吩咐的渗透终末番一事…"
                },
                {
                    "id": "722650505",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "够了，柳达希卡，你那些拖延时间的说辞，我已经听够了。"
                },
                {
                    "id": "722650506",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "什么「频繁发布假任务可能会引起对方怀疑」，「眼狩令废止后，终末番的行动方针可能会有变化，需要搜集情报」…"
                },
                {
                    "id": "722650507",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "每次都是这样！我猜你根本就没有获得那两个终末番成员的信任，所以才不得不编出这些谎话来搪塞我！"
                },
                {
                    "id": "722650508",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "不是的老师！我确实已经获得了他们的信任，只是还需要一点时间…"
                },
                {
                    "id": "722650509",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "时间？我已经给了你很多时间了！"
                },
                {
                    "id": "722650510",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "你要知道，我的耐心是有限的，「仆人」大人的耐心也是有限的！"
                },
                {
                    "id": "722650511",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "真是万分抱歉…"
                },
                {
                    "id": "722650512",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "我辛辛苦苦在你身上花了这么多年时间，要的不是你的道歉！我要的是「结果」，「结果」！"
                },
                {
                    "id": "722650513",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "…算了，我不想追究之前的事。不管是你没取得敌人的信任，还是现在的生活让你昏了头，都不重要了。"
                },
                {
                    "id": "722650514",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "这张纸上是你的「最终指令」，拿着它。你给我一个字一个字地，好好看清楚。"
                },
                {
                    "id": "722650515",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "是，老师！我一定会完成任务，不负您的信任！"
                },
                {
                    "id": "722650516",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "…这、这是？！"
                },
                {
                    "id": "722650517",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "怎么了？"
                },
                {
                    "id": "722650518",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "啊，不，没什么…"
                },
                {
                    "id": "722650519",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "柳达希卡，你刚才那句「我一定会完成任务，不负您的信任」，我可以当作是你的承诺吧。"
                },
                {
                    "id": "722650520",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "……"
                },
                {
                    "id": "722650521",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "回答我，「是」还是「不是」！"
                },
                {
                    "id": "722650522",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "老师！我当然支持您的决断，只是…只是您说过，「仆人」大人随时都可能让我们从稻妻撤离。"
                },
                {
                    "id": "722650523",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "而且现在幕府和海祇岛已经停战，我们这样做，真的有必要吗…"
                },
                {
                    "id": "722650524",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "呵呵，正因为如此，这个任务才有价值！"
                },
                {
                    "id": "722650525",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "虽然「女士」大人在稻妻遇害了，但现在，也正是我们回报「仆人」大人的恩情，为其建立威望的好时机。"
                },
                {
                    "id": "722650526",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "而且我也一直告诉你们，「混乱」才是最能让我们愚人众壮大的土壤！"
                },
                {
                    "id": "722650527",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "……"
                },
                {
                    "id": "722650528",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "柳达希卡，你还在犹豫什么？！"
                },
                {
                    "id": "722650529",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "只是这样一来，一定又会有很多孤儿…"
                },
                {
                    "id": "722650530",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "那不是更好吗？我们也可以收留他们，让他们成为新的战力。当然前提是，你能顺利完成这个任务！"
                },
                {
                    "id": "722650531",
                    "speaker": "叶菲·雪奈茨维奇",
                    "text": "柳达希卡，别再让我失望。我们有这么多年的情分，我也不想把事情做得太绝。"
                },
                {
                    "id": "722650532",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "呜…"
                },
                {
                    "id": "722650533",
                    "speaker": "派蒙",
                    "text": "不好了，海祇岛要发生可怕的事了！"
                },
                {
                    "id": "722650534",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，现在只剩下柳达希卡一个人了，我们快去把她手里的最终指令抢过来！"
                }
            ]
        },
        {
            "id": "7226506",
            "objective": "与柳达希卡对峙",
            "dialogues": [
                {
                    "id": "722650601",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "……"
                },
                {
                    "id": "722650602",
                    "speaker": "Player",
                    "text": "柳达希卡。"
                },
                {
                    "id": "722650603",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "谁？！"
                },
                {
                    "id": "722650604",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "#{NICKNAME}，您…您怎么会在这里？！"
                },
                {
                    "id": "722650605",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "那个…不，您误会了，我…我之所以在这里，其实…其实是…"
                },
                {
                    "id": "722650606",
                    "speaker": "Player",
                    "text": "我觉得并没有什么误会。因为…",
                    "choices": [
                        {
                            "id": "722650607",
                            "text": "你回应了「柳达希卡」这个名字。",
                            "response": [
                                {
                                    "id": "722650609",
                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                    "text": "…哎呀哎呀，看来现在，再说什么都没有用了。"
                                },
                                {
                                    "id": "722650610",
                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                    "text": "既然你已经发现了我的真实身份，就别想活着离开！"
                                }
                            ]
                        },
                        {
                            "id": "722650608",
                            "text": "你身上的衣服说明了一切。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226507",
            "objective": "与柳达希卡战斗",
            "dialogues": []
        },
        {
            "id": "7226508",
            "objective": "与柳达希卡谈谈",
            "dialogues": [
                {
                    "id": "722650801",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "咳…咳咳咳！呼…呼…"
                },
                {
                    "id": "722650802",
                    "speaker": "派蒙",
                    "text": "喂，你还好吗？"
                },
                {
                    "id": "722650803",
                    "speaker": "Player",
                    "text": "抱歉，下手有点重。"
                },
                {
                    "id": "722650804",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "呼…为什么，不干脆了结掉我？"
                },
                {
                    "id": "722650805",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "你们应该是想知道我身上那张「最终指令」的内容吧。只要干掉我，一切不就很简单了吗？"
                },
                {
                    "id": "722650806",
                    "speaker": "Player",
                    "text": "对，那样确实很简单。"
                },
                {
                    "id": "722650807",
                    "speaker": "Player",
                    "text": "而且对你而言也是种「解脱」吧。"
                },
                {
                    "id": "722650808",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "……"
                },
                {
                    "id": "722650809",
                    "speaker": "派蒙",
                    "text": "#玄冬…不，柳达希卡小姐，我们其实已经发现了，你刚才虽然气势汹汹地冲了过来，但你和{NICKNAME}战斗的时候，根本就没有用全力吧？",
                    "choices": [
                        {
                            "id": "722650810",
                            "text": "而且气势也太假了一点。",
                            "response": [
                                {
                                    "id": "722650812",
                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                    "text": "欸！不…不至于吧，真的有那么假吗？！"
                                },
                                {
                                    "id": "722650813",
                                    "speaker": "Player",
                                    "text": "但你想要自我了断是真的。"
                                },
                                {
                                    "id": "722650814",
                                    "speaker": "派蒙",
                                    "text": "柳达希卡小姐，我们刚才听到了你和那个「老师」的谈话，你似乎有一些苦衷。能和我们讲讲吗？我们可以帮你的！"
                                },
                                {
                                    "id": "722650815",
                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                    "text": "但是我…我是愚人众啊。",
                                    "choices": [
                                        {
                                            "id": "722650816",
                                            "text": "派蒙说了，会帮你的。",
                                            "response": [
                                                {
                                                    "id": "722650817",
                                                    "speaker": "派蒙",
                                                    "text": "#哇，谢谢你{NICKNAME}，我好感动！"
                                                },
                                                {
                                                    "id": "722650819",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，你放心吧，我们是不会对好人出手的！"
                                                },
                                                {
                                                    "id": "722650820",
                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                    "text": "但其实，我的确不能算是什么好人…"
                                                },
                                                {
                                                    "id": "722650821",
                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                    "text": "我一开始接到任务混进鸣神大社，只是为了接触终末番的成员，混进他们内部。"
                                                },
                                                {
                                                    "id": "722650822",
                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                    "text": "但我来到神社之后却发现，老师所说的那两个终末番成员，却是曾经在蒙德和璃月鼎鼎有名的旅行者和跟班…"
                                                },
                                                {
                                                    "id": "722650823",
                                                    "speaker": "派蒙",
                                                    "text": "派蒙不是跟班！！",
                                                    "choices": [
                                                        {
                                                            "id": "722650824",
                                                            "text": "难怪你知道我的名字。",
                                                            "response": [
                                                                {
                                                                    "id": "722650826",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "是的。所以，老师让我渗透进终末番，从根本上就是无法成立的。"
                                                                },
                                                                {
                                                                    "id": "722650827",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "因为老师对这一行动寄予厚望，我不知道该如何向他汇报。他如果知道了真相，一定会大发雷霆，我不会有好下场的…"
                                                                },
                                                                {
                                                                    "id": "722650828",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "不过，我能够来到稻妻，还能在神社里当巫女，简直像做梦一样！能够做这样一个梦，我已经非常满足了！"
                                                                },
                                                                {
                                                                    "id": "722650829",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "所以，我就一直用各种理由搪塞老师，决定过一天是一天。"
                                                                },
                                                                {
                                                                    "id": "722650830",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "我以为自己的谎言总有一天会穿帮，不过却没想到，老师并没有追究这件事，而是给了我新的任务。"
                                                                },
                                                                {
                                                                    "id": "722650831",
                                                                    "speaker": "派蒙",
                                                                    "text": "老师到底给了你什么任务？刚才你一看见纸上的字，脸就变白了。"
                                                                },
                                                                {
                                                                    "id": "722650832",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "因为…我的任务是「投毒」。"
                                                                },
                                                                {
                                                                    "id": "722650833",
                                                                    "speaker": "派蒙",
                                                                    "text": "呀，投毒？！"
                                                                },
                                                                {
                                                                    "id": "722650834",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "老师要我和其他几个人进入海祇岛，在那里投毒。然后故意暴露出我们鸣神大社巫女和天领奉行士兵的身份。"
                                                                },
                                                                {
                                                                    "id": "722650835",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "这样，幕府与海祇岛之间一定会再起冲突，愚人众也就能乘虚而入。"
                                                                },
                                                                {
                                                                    "id": "722650836",
                                                                    "speaker": "派蒙",
                                                                    "text": "那个「老师」也太狠毒了！如果被他实行了这样的计划，许多人之前为了稻妻和平做出的努力就都白费了呀！"
                                                                },
                                                                {
                                                                    "id": "722650837",
                                                                    "speaker": "Player",
                                                                    "text": "柳达希卡，你准备怎么做？"
                                                                },
                                                                {
                                                                    "id": "722650838",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "我…我不知道。我根本没有违抗老师命令的资格，但我并不想看见这样的事情发生！"
                                                                },
                                                                {
                                                                    "id": "722650839",
                                                                    "speaker": "Player",
                                                                    "text": "因为你也是「雪奈茨芙娜」。"
                                                                },
                                                                {
                                                                    "id": "722650840",
                                                                    "speaker": "派蒙",
                                                                    "text": "#说起来我之前就经常听见这个词，它到底是什么意思呀？{NICKNAME}你好像已经完全知道了的样子！"
                                                                },
                                                                {
                                                                    "id": "722650841",
                                                                    "speaker": "Player",
                                                                    "text": "是代表孤儿的意思吧。"
                                                                },
                                                                {
                                                                    "id": "722650842",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "对，「雪奈茨维奇」和「雪奈茨芙娜」，是愚人众给予我们这些被收养的孤儿们的姓氏。"
                                                                },
                                                                {
                                                                    "id": "722650843",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "我们从小在「仆人」大人设立的福利院里长大，我们不知道自己究竟是谁，顶多知道自己有哪里的血统。"
                                                                },
                                                                {
                                                                    "id": "722650844",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "我就是因为有稻妻的血统，所以从小就在学习关于这里的事情。"
                                                                },
                                                                {
                                                                    "id": "722650845",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "其实我的老师，他也是一个「雪奈茨维奇」。所以，我才更不能理解他…不，是不能原谅他说的那些话。"
                                                                },
                                                                {
                                                                    "id": "722650846",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "因为一直以来我都在思考着：我究竟是谁？我为什么是孤身一人？我的父母他们遭遇了不幸吗？还是他们抛弃了我呢？"
                                                                },
                                                                {
                                                                    "id": "722650847",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "但老师那些话，却无视了孤儿们的痛苦…让我忍不住去想，我的命运，难道是被愚人众…被老师这样的人创造出来的吗？"
                                                                },
                                                                {
                                                                    "id": "722650848",
                                                                    "speaker": "Player",
                                                                    "text": "确实不可原谅。"
                                                                },
                                                                {
                                                                    "id": "722650849",
                                                                    "speaker": "派蒙",
                                                                    "text": "#{NICKNAME}，我们帮帮柳达希卡小姐吧。她虽然是愚人众，可她并不是坏人。"
                                                                },
                                                                {
                                                                    "id": "722650850",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "谢谢你们的好意，但我觉得我的命运已经注定了。「老师」是个对背叛者毫不留情的人，只要我还活着，他就一定会把我找出来。"
                                                                },
                                                                {
                                                                    "id": "722650851",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "可能被你们了结掉，才是我最好的归宿。"
                                                                },
                                                                {
                                                                    "id": "722650852",
                                                                    "speaker": "派蒙",
                                                                    "text": "难道只有死了才不会被他盯上吗？怎么会这样！"
                                                                },
                                                                {
                                                                    "id": "722650853",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯？等一下，我总觉得好像想到了点什么…"
                                                                },
                                                                {
                                                                    "id": "722650854",
                                                                    "speaker": "Player",
                                                                    "text": "是百代小姐吧。"
                                                                },
                                                                {
                                                                    "id": "722650855",
                                                                    "speaker": "派蒙",
                                                                    "text": "百代小姐？…啊！我想起来了，对啊！她最近不就正在做假尸——"
                                                                },
                                                                {
                                                                    "id": "722650856",
                                                                    "speaker": "Player",
                                                                    "text": "嘘。"
                                                                },
                                                                {
                                                                    "id": "722650857",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯，咳咳，柳达希卡小姐，总之，我们已经有办法救你了！而且我们也会挫败「老师」的阴谋！"
                                                                },
                                                                {
                                                                    "id": "722650858",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "咦，真的吗？"
                                                                },
                                                                {
                                                                    "id": "722650859",
                                                                    "speaker": "派蒙",
                                                                    "text": "你就放心吧！不过这几天，你要先找个地方躲起来，等到我们把事情都办妥之后再出来。"
                                                                },
                                                                {
                                                                    "id": "722650860",
                                                                    "speaker": "派蒙",
                                                                    "text": "你有地方可去吗？最好是那种方便我们找到你，也不会被人怀疑的地方。"
                                                                },
                                                                {
                                                                    "id": "722650861",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "让我想想…"
                                                                },
                                                                {
                                                                    "id": "722650862",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "啊，有一个地方似乎可以！我之前曾经用过一个假名在八重堂打过工，做小说新刊的校对。因为我很喜欢读八重堂出版的小说。"
                                                                },
                                                                {
                                                                    "id": "722650863",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "他们在稻妻城的书店后面有一间小屋，偶尔会给拖稿的作者或者校对员使用。"
                                                                },
                                                                {
                                                                    "id": "722650864",
                                                                    "speaker": "派蒙",
                                                                    "text": "听起来是个不错的地方！"
                                                                },
                                                                {
                                                                    "id": "722650865",
                                                                    "speaker": "Player",
                                                                    "text": "嗯，大隐隐于市。"
                                                                },
                                                                {
                                                                    "id": "722650866",
                                                                    "speaker": "派蒙",
                                                                    "text": "柳达希卡小姐，你就暂时躲在那里吧，我们如果有事就过去找你。"
                                                                },
                                                                {
                                                                    "id": "722650867",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "我明白了。真不知道该如何感谢你们，我明明之前一直在欺骗你们…"
                                                                },
                                                                {
                                                                    "id": "722650868",
                                                                    "speaker": "柳达希卡·雪奈茨芙娜",
                                                                    "text": "老师给我的这张纸上，写有任务的详细计划。海祇岛无辜众人的性命，就拜托你们了。"
                                                                },
                                                                {
                                                                    "id": "722650869",
                                                                    "speaker": "Black Screen",
                                                                    "text": "柳达离开了"
                                                                },
                                                                {
                                                                    "id": "722650870",
                                                                    "speaker": "派蒙",
                                                                    "text": "她走了。我们也赶快回百代小姐那去吧，接下来还有很多事情要做呢。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722650825",
                                                            "text": "原来你知道我的事情。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722650818",
                                            "text": "如果你真的有苦衷的话。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722650811",
                            "text": "而且笑声也太假了一点。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226509",
            "objective": "向百代报告跟踪结果",
            "dialogues": [
                {
                    "id": "722650901",
                    "speaker": "百代",
                    "text": "怎么才回来？情报拿到了吗？"
                }
            ]
        },
        {
            "id": "7226517",
            "objective": "向百代报告信息-跟百代对话",
            "dialogues": [
                {
                    "id": "722651701",
                    "speaker": "百代",
                    "text": "做的不错，有了这个东西，就能够挫败愚人众的阴谋了。我马上就去找人安排后续的行动，你们就不用担心了。"
                },
                {
                    "id": "722651702",
                    "speaker": "派蒙",
                    "text": "那个，百代小姐，其实我们有一件事想求你…"
                },
                {
                    "id": "722651703",
                    "speaker": "Black Screen",
                    "text": "把刚才发生的事详细告诉了百代。"
                },
                {
                    "id": "722651704",
                    "speaker": "百代",
                    "text": "……"
                },
                {
                    "id": "722651705",
                    "speaker": "派蒙",
                    "text": "呜，百代小姐，你不要这样盯着我嘛！你…你就说好不好嘛！"
                },
                {
                    "id": "722651706",
                    "speaker": "百代",
                    "text": "你们想救愚人众？这关我什么事？！"
                },
                {
                    "id": "722651707",
                    "speaker": "百代",
                    "text": "那个女人顶替了我的位置，如果不是因为你们之前误打误撞，终末番很可能就会遇到重大危机！"
                },
                {
                    "id": "722651708",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，你也想办法劝劝百代小姐吧，要不然柳达希卡小姐就性命难保了！",
                    "choices": [
                        {
                            "id": "722651709",
                            "text": "做出可怜巴巴的表情。",
                            "response": [
                                {
                                    "id": "722651712",
                                    "speaker": "百代",
                                    "text": "哼，没用的。我已经说过了，愚人众和我没关系！"
                                },
                                {
                                    "id": "722651713",
                                    "speaker": "百代",
                                    "text": "而且你们以为，伪造人体是这么轻松的事吗？这几天你们去探听情报的时候，我没日没夜地工作，才把他们要的假人做完。"
                                },
                                {
                                    "id": "722651714",
                                    "speaker": "百代",
                                    "text": "需要那么多<color=#00E1FFFF>兽肉</color>才能凑够一个人的重量！还要把<color=#00E1FFFF>白铁块</color>和其他许多材料烧在一起伪造成骨头！"
                                },
                                {
                                    "id": "722651715",
                                    "speaker": "百代",
                                    "text": "如果不放<color=#00E1FFFF>海灵芝</color>，脂肪含量不足，效果就不够逼真。"
                                },
                                {
                                    "id": "722651716",
                                    "speaker": "百代",
                                    "text": "啊啊，最烦的就是把<color=#00E1FFFF>衣服</color>套在拼出来的假人上烧的过程了。毕竟要小心别把衣服烧得面目全非了呀！"
                                },
                                {
                                    "id": "722651717",
                                    "speaker": "派蒙",
                                    "text": "……"
                                },
                                {
                                    "id": "722651718",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "722651719",
                                    "speaker": "百代",
                                    "text": "你们是听不懂人话吗？还愣着干嘛？！<color=#00E1FFFF>八块兽肉，四块白铁块，三颗海灵芝</color>，外加一件容易辨识身份的<color=#00E1FFFF>衣服</color>！"
                                },
                                {
                                    "id": "722651720",
                                    "speaker": "派蒙",
                                    "text": "呜呜呜！我就知道百代小姐你最好了！！"
                                },
                                {
                                    "id": "722651721",
                                    "speaker": "百代",
                                    "text": "别烦我，快走快走！"
                                }
                            ]
                        },
                        {
                            "id": "722651710",
                            "text": "做出特别可怜巴巴的表情。"
                        },
                        {
                            "id": "722651711",
                            "text": "做出特别可怜巴巴都要哭了的表情。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7226513",
            "objective": "获取八块兽肉",
            "dialogues": [
                {
                    "id": "722651301",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "我会在这里一边做校对工作，一边为二位祈祷。"
                },
                {
                    "id": "722651302",
                    "speaker": "派蒙",
                    "text": "说起来，校对的工作怎么样了？"
                },
                {
                    "id": "722651303",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "还算顺利，不过这次要校对的内容非常多，加上八重堂这两天人手不足，可能要通宵吧。"
                },
                {
                    "id": "722651304",
                    "speaker": "派蒙",
                    "text": "好辛苦呀！"
                },
                {
                    "id": "722651305",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "呵呵，虽然辛苦，但我觉得非常有趣！能够提前看到喜欢的小说，偶尔还能接触到作者们的手稿，简直太棒了！"
                }
            ]
        },
        {
            "id": "7226514",
            "objective": "获取四块白铁块",
            "dialogues": [
                {
                    "id": "722651401",
                    "speaker": "百代",
                    "text": "快去吧。把竹签上的药粉粘在那个冒牌货身上，就能利用元素视野跟踪她了。"
                },
                {
                    "id": "722651402",
                    "speaker": "百代",
                    "text": "愚人众去海祇岛肯定没安什么好心，不过现在已经没有天领奉行给他们撑腰了，他们别以为还能在稻妻掀起风浪来。"
                }
            ]
        },
        {
            "id": "7226516",
            "objective": "获取柳达希卡的衣服",
            "dialogues": [
                {
                    "id": "722651601",
                    "speaker": "派蒙",
                    "text": "柳达希卡小姐，你在里面吗？"
                },
                {
                    "id": "722651602",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "#是{NICKNAME}和派蒙，怎么了，是不是因为行动进行得不顺利？别担心，我马上就离开这里，不会给你们添麻烦…"
                },
                {
                    "id": "722651603",
                    "speaker": "派蒙",
                    "text": "不是不是！我们来找你，只是因为目前计划里需要一套你的衣服，能一下子辨认出你身份的那种。"
                },
                {
                    "id": "722651604",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "能辨认我身份的衣服？我明白了。"
                },
                {
                    "id": "722651605",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "这是我在愚人众的服装。如果是认识我的人的话，应该能辨认出这套衣服。"
                },
                {
                    "id": "722651606",
                    "speaker": "派蒙",
                    "text": "摸起来还有点温温的。"
                },
                {
                    "id": "722651607",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "说来惭愧，因为我之前把它穿在其他衣服里面，以备不时之需。"
                },
                {
                    "id": "722651608",
                    "speaker": "派蒙",
                    "text": "好，现在有了这套衣服，计划一定能顺利进行！"
                },
                {
                    "id": "722651609",
                    "speaker": "柳达希卡·雪奈茨芙娜",
                    "text": "谢谢你们，祝你们好运。"
                }
            ]
        },
        {
            "id": "7226515",
            "objective": "获取三颗海灵芝",
            "dialogues": [
                {
                    "id": "722651501",
                    "speaker": "陆",
                    "text": "呀，是外国人！你好！"
                },
                {
                    "id": "722651502",
                    "speaker": "Player",
                    "text": "你刚才有没有看见什么？"
                },
                {
                    "id": "722651503",
                    "speaker": "陆",
                    "text": "嗯，有的！"
                },
                {
                    "id": "722651504",
                    "speaker": "陆",
                    "text": "我看见一个巫女大姐姐走了过去，在那边唰地变成了紫色，然后一下子就飞走了！好厉害哦！"
                }
            ]
        },
        {
            "id": "7226510",
            "objective": "将材料交给百代",
            "dialogues": [
                {
                    "id": "722651001",
                    "speaker": "百代",
                    "text": "你们回来了。"
                }
            ]
        },
        {
            "id": "7226520",
            "objective": "将材料交给百代",
            "dialogues": [
                {
                    "id": "722652101",
                    "speaker": "百代",
                    "text": "哼，我什么时候说要这些材料了？"
                },
                {
                    "id": "722652102",
                    "speaker": "百代",
                    "text": "可既然你们都把材料摆到我面前了，也不是不能帮你们这个忙。毕竟你们之前拿到的情报，可以拯救许多人的生命。"
                },
                {
                    "id": "722652103",
                    "speaker": "百代",
                    "text": "兽肉、白铁块、海灵芝…嗯，这些就够了。"
                }
            ]
        },
        {
            "id": "7226519",
            "objective": "交付柳达的衣服",
            "dialogues": [
                {
                    "id": "722651901",
                    "speaker": "百代",
                    "text": "能辨认那个柳达希卡身份的衣服，你们也拿到了吧？"
                }
            ]
        },
        {
            "id": "7226518",
            "objective": "拜托百代进行制作",
            "dialogues": [
                {
                    "id": "722651801",
                    "speaker": "百代",
                    "text": "好，东西都齐了，接下来就没你们的事了。"
                },
                {
                    "id": "722651802",
                    "speaker": "派蒙",
                    "text": "海祇岛那边怎么样了？"
                },
                {
                    "id": "722651803",
                    "speaker": "百代",
                    "text": "在你们出去找材料这段时间，我已经安排好了。"
                },
                {
                    "id": "722651804",
                    "speaker": "百代",
                    "text": "你们要的东西，大概需要一整天的时间才能完工，你们明天再来吧。"
                },
                {
                    "id": "722651805",
                    "speaker": "百代",
                    "text": "那个时候，我们再来商量一下怎么使用这具假人吧。"
                }
            ]
        },
        {
            "id": "7226511",
            "objective": "离开安全屋",
