    "talks": [
        {
            "id": "2006201",
            "objective": "与赫尔曼对话",
            "dialogues": [
                {
                    "id": "200620101",
                    "speaker": "赫尔曼",
                    "text": "到底怎么办呢…"
                },
                {
                    "id": "200620102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "200620103",
                    "speaker": "赫尔曼",
                    "text": "是这样的…我女儿艾琳想要进入西风骑士团，正在为骑士选拔做准备。"
                },
                {
                    "id": "200620104",
                    "speaker": "赫尔曼",
                    "text": "唉…我本来想要自己指导她，但是她怎么样也不相信我之前是个冒险家，坚持自己训练。"
                },
                {
                    "id": "200620105",
                    "speaker": "赫尔曼",
                    "text": "我也没办法证明给她看…有了老婆孩子之后，我已经没有到处肆意冒险的资本了。"
                },
                {
                    "id": "200620106",
                    "speaker": "赫尔曼",
                    "text": "比起满足自己的冒险欲望和自尊心，好好照顾家庭才是我现在最重要的责任。"
                },
                {
                    "id": "200620107",
                    "speaker": "赫尔曼",
                    "text": "哈哈，不过我这个「冒险家」，终归还是能做点事的。"
                },
                {
                    "id": "200620108",
                    "speaker": "赫尔曼",
                    "text": "我之前到处冒险的时候，留意过那些丘丘人用来训练的木桩。"
                },
                {
                    "id": "200620109",
                    "speaker": "赫尔曼",
                    "text": "那些木桩看着质量很不错，肯定很适合艾琳用来训练。"
                },
                {
                    "id": "200620110",
                    "speaker": "赫尔曼",
                    "text": "帮我去找几个丘丘人训练木桩回来吧。按照冒险家的规矩，我也不会让你干白工的，你觉得怎么样？",
                    "choices": [
                        {
                            "id": "200620111",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "200620113",
                                    "speaker": "赫尔曼",
                                    "text": "哦，我就喜欢爽快的人，你很有我当年刚入行时的风采…"
                                },
                                {
                                    "id": "200620114",
                                    "speaker": "赫尔曼",
                                    "text": "开玩笑，开玩笑，好了，快点去吧。"
                                }
                            ]
                        },
                        {
                            "id": "200620112",
                            "text": "只是丘丘人，你自己也可以…",
                            "response": [
                                {
                                    "id": "200620115",
                                    "speaker": "赫尔曼",
                                    "text": "不，不行不行，冒险家的能力也是有极限的。一位冒险家，同时只能应付一场冒险。"
                                },
                                {
                                    "id": "200620116",
                                    "speaker": "赫尔曼",
                                    "text": "而「婚后生活」这场冒险…无论是多伟大的冒险家，都必须要全身心投入。"
                                },
                                {
                                    "id": "200620117",
                                    "speaker": "赫尔曼",
                                    "text": "所以，搜集木桩就拜托你了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2006202",
            "objective": "清剿魔物营地",
            "dialogues": [
                {
                    "id": "200620201",
                    "speaker": "赫尔曼",
                    "text": "你找到木桩了吗？"
                },
                {
                    "id": "200620202",
                    "speaker": "Player",
                    "text": "找到了。"
                },
                {
                    "id": "200620203",
                    "speaker": "赫尔曼",
                    "text": "唔…哈哈，你看，看着确实质量不错。"
                },
                {
                    "id": "200620204",
                    "speaker": "赫尔曼",
                    "text": "这木桩能经得起丘丘人折腾，肯定也能经得起艾琳折腾。"
                },
                {
                    "id": "200620205",
                    "speaker": "赫尔曼",
                    "text": "谢谢你，哦对了，按照冒险家的规矩，这是你的报酬。"
                }
            ]
        },
        {
            "id": "2006205",
            "objective": "(test)保证木桩存活$HIDDEN",
            "dialogues": [
                {
                    "id": "200620501",
                    "speaker": "艾琳",
                    "text": "到底怎么训练才好呢…"
                },
                {
                    "id": "200620502",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "200620503",
                    "speaker": "艾琳",
                    "text": "哦，我正在为了骑士选拔做训练呢。但是怎么样都不得要领，而且也没人指导我。"
                },
                {
                    "id": "200620504",
                    "speaker": "艾琳",
                    "text": "我爸一个劲说他是冒险家，他可以指导我，但是我才不信呢…"
                },
                {
                    "id": "200620505",
                    "speaker": "艾琳",
                    "text": "他那样子，怎么可能指导我通过骑士选拔啊。"
                },
                {
                    "id": "200620506",
                    "speaker": "艾琳",
                    "text": "他还说要帮我准备训练用的东西，他到底会准备什么呢…"
                }
            ]
        },
        {
            "id": "2006203",
            "objective": "取得训练用木桩",
            "dialogues": [
                {
                    "id": "200620301",
                    "speaker": "赫尔曼",
                    "text": "你找到木桩了吗？"
                },
                {
                    "id": "200620302",
                    "speaker": "Player",
                    "text": "找到了，可是…"
                },
                {
                    "id": "200620303",
                    "speaker": "赫尔曼",
                    "text": "哈…你下手也太狠了，这么结实的木桩都被打散架了。"
                },
                {
                    "id": "200620304",
                    "speaker": "赫尔曼",
                    "text": "不过在战斗的时候，确实不会有人顾得上为了个木桩收手…"
                },
                {
                    "id": "200620305",
                    "speaker": "赫尔曼",
                    "text": "虽然不能直接给艾琳…但材料已经有了，我来加工一下就好。"
                },
                {
                    "id": "200620306",
                    "speaker": "赫尔曼",
                    "text": "勉强是组装起来了，你看，呃…还是有点模样的，对吧？"
                },
                {
                    "id": "200620307",
                    "speaker": "赫尔曼",
                    "text": "总之谢谢你了。这是报酬，我说了不会让你打白工的。"
                },
                {
                    "id": "200620308",
                    "speaker": "赫尔曼",
                    "text": "虽然我不是冒险家了，但是冒险家的规矩可不能坏啊。"
                }
            ]
        },
        {
            "id": "2006204",
            "objective": "与赫尔曼对话",
            "dialogues": []
        },
        {
            "id": "2006206",
            "objective": "捡起训练用木桩材料",
            "dialogues": [
                {
                    "id": "200620601",
                    "speaker": "艾琳",
                    "text": "这个木桩可真不错，这下子我训练起来可方便了不少。"
                },
                {
                    "id": "200620602",
                    "speaker": "艾琳",
                    "text": "不过，这么结实的木桩，老爸到底是从哪弄来的呢？"
                },
                {
                    "id": "200620603",
                    "speaker": "艾琳",
                    "text": "不，不会是买的吧！这得花多少钱啊…"
                }
            ]
        },
        {
            "id": "2006207",
            "objective": "与赫尔曼对话",
            "dialogues": []
        },
        {
            "id": "2006204",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200620401",
                    "speaker": "赫尔曼",
                    "text": "你找到木桩了吗"
                },
                {
                    "id": "200620402",
                    "speaker": "Player",
                    "text": "还没找到。"
                },
                {
                    "id": "200620403",
                    "speaker": "赫尔曼",
                    "text": "艾琳正在努力训练，我能为她做的也就这些了…"
                },
                {
                    "id": "200620404",
                    "speaker": "赫尔曼",
                    "text": "如果我还是个冒险家，就能自己去拿了。"
                },
                {
                    "id": "200620405",
                    "speaker": "赫尔曼",
                    "text": "而且就蒙德城冒险家协会的现状…我的那些前「同伴」们，大部分也都不干冒险家这行了。"
                },
                {
                    "id": "200620406",
                    "speaker": "赫尔曼",
                    "text": "这也没办法，蒙德城里的西风骑士团这么强势，年轻人都想去做西风骑士，至于在野外摸爬滚打的冒险家…"
                },
                {
                    "id": "200620407",
                    "speaker": "赫尔曼",
                    "text": "早就没多少人愿意做咯——"
                }
            ]
        },
        {
            "id": "2006207",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "200620701",
                    "speaker": "艾琳",
                    "text": "哈…老爸说给我找的「训练器材」就是这个吗？"
                },
                {
                    "id": "200620702",
                    "speaker": "艾琳",
                    "text": "总感觉我稍微一动手，这个木桩就散架了。"
                },
                {
                    "id": "200620703",
                    "speaker": "艾琳",
                    "text": "不过，有总比没有好，过一会就开始训练吧。"
                }
            ]
        }
    ]
}