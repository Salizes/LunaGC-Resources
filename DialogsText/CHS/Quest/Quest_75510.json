    "talks": [
        {
            "id": "7551001",
            "objective": "与维热对话",
            "dialogues": [
                {
                    "id": "755100101",
                    "speaker": "「小松果」",
                    "text": "要我说，虽然「面具斗士」不能像「调停人」那样自由地飞来飞去，但只要找准机会，埋头冲刺，肯定能赢下对局！"
                },
                {
                    "id": "755100102",
                    "speaker": "「燃爆木头人」",
                    "text": "呆子，不能太依赖直线行动的速度啊，转不过弯，撞不中，不就没有意义了嘛！"
                },
                {
                    "id": "755100103",
                    "speaker": "维热",
                    "text": "好啦好啦，孩子们，可以认真讨论，但不能动气吵架哦。"
                },
                {
                    "id": "755100104",
                    "speaker": "「燃爆木头人」",
                    "text": "没有啦，没有啦，我们只是…聊到强大的战士，都非常兴奋！"
                },
                {
                    "id": "755100105",
                    "speaker": "「小松果」",
                    "text": "你可以放心的，维热姐姐！就算要比出个高低，我们也会讲道理，摆证据！"
                },
                {
                    "id": "755100106",
                    "speaker": "「燃爆木头人」",
                    "text": "还有个方法，再来一局。"
                },
                {
                    "id": "755100107",
                    "speaker": "「小松果」",
                    "text": "那就再来一局！",
                    "choices": [
                        {
                            "id": "755100108",
                            "text": "真热闹。",
                            "response": [
                                {
                                    "id": "755100110",
                                    "speaker": "维热",
                                    "text": "新的客人，你好啊！"
                                },
                                {
                                    "id": "755100111",
                                    "speaker": "维热",
                                    "text": "看你的装束，应该是一位旅者吧？那我们是同行！"
                                },
                                {
                                    "id": "755100112",
                                    "speaker": "维热",
                                    "text": "要不要和孩子们一起，来试试我最近创作的这个「互动织卷」？",
                                    "choices": [
                                        {
                                            "id": "755100113",
                                            "text": "「互动织卷」？",
                                            "response": [
                                                {
                                                    "id": "755100115",
                                                    "speaker": "维热",
                                                    "text": "简单来说，就是结合了璃月剪纸戏、稻妻漫画和枫丹映影三种技术的幕布游戏。"
                                                },
                                                {
                                                    "id": "755100116",
                                                    "speaker": "维热",
                                                    "text": "以本地著名的战士为原型，加入一些「跨界挑战」的设想，组合成新奇的故事。"
                                                },
                                                {
                                                    "id": "755100117",
                                                    "speaker": "维热",
                                                    "text": "说不定能给你带来非常新奇的体验呢。"
                                                },
                                                {
                                                    "id": "755100118",
                                                    "speaker": "Player",
                                                    "text": "那我来试试看！"
                                                },
                                                {
                                                    "id": "755100119",
                                                    "speaker": "维热",
                                                    "text": "好呀好呀，祝你玩得开心！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755100114",
                                            "text": "会动的画卷？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755100109",
                            "text": "发生什么了？"
                        }
                    ]
                }
            ]
        },
