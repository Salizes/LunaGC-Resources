    "talks": [
        {
            "id": "7906101",
            "objective": "",
            "dialogues": [
                {
                    "id": "790610201",
                    "speaker": "Player",
                    "text": "是的。<color=#FFCC33FF>外面的世界</color>有许多新鲜事。"
                },
                {
                    "id": "790610202",
                    "speaker": "派蒙",
                    "text": "对呀，外面有好多好吃的和好玩的，还能遇见好多有趣的事，认识很多厉害的人。比如…",
                    "choices": [
                        {
                            "id": "790610203",
                            "text": "有专注着事物美好本质的人。",
                            "response": [
                                {
                                    "id": "790610206",
                                    "speaker": "埃斯诺尔",
                                    "text": "真的？哎呀，我还以为外面世界的只有「价值」，大家都是那种想戴帽子却又不敢的人呢。"
                                },
                                {
                                    "id": "790610207",
                                    "speaker": "派蒙",
                                    "text": "这个呀…呃，那个…就，就像是蛋糕上面撒的巧克力，每一颗都是不同的味道呀。"
                                },
                                {
                                    "id": "790610208",
                                    "speaker": "派蒙",
                                    "text": "要是每一颗巧克力豆全是一个味道，那蛋糕吃起来不就很普通了吗？",
                                    "choices": [
                                        {
                                            "id": "790610209",
                                            "text": "派蒙，很会说嘛。",
                                            "response": [
                                                {
                                                    "id": "790610211",
                                                    "speaker": "派蒙",
                                                    "text": "都听了这么久，多少也会一点了嘛，嘿嘿，是不是还挺有道理的？"
                                                },
                                                {
                                                    "id": "790610212",
                                                    "speaker": "埃斯诺尔",
                                                    "text": "这样吗？我…我还要再想想…也许，去小小地远游一下，也不错…？"
                                                },
                                                {
                                                    "id": "790610213",
                                                    "speaker": "罗泽尔",
                                                    "text": "不用着急，埃斯诺尔，离下次起航日还很远，我可以和你一起慢慢想。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "790610210",
                                            "text": "派蒙已经完全融入这里了啊…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "790610204",
                            "text": "永不褪色的灿烂理想…"
                        },
                        {
                            "id": "790610205",
                            "text": "和为了梦想努力的人们。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7906103",
            "objective": "",
            "dialogues": [
                {
                    "id": "790610301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>里面的世界</color>倒也不错。"
                },
                {
                    "id": "790610302",
                    "speaker": "派蒙",
                    "text": "嗯。这里毕竟是埃斯诺尔的家呢。埃斯诺尔肯定也很喜欢这里。而且…",
                    "choices": [
                        {
                            "id": "790610303",
                            "text": "这里有许多熟悉的朋友。",
                            "response": [
                                {
                                    "id": "790610306",
                                    "speaker": "埃斯诺尔",
                                    "text": "是的！我就担心失去这些，总是为这些事烦忧。"
                                },
                                {
                                    "id": "790610307",
                                    "speaker": "埃斯诺尔",
                                    "text": "这一切都很好，好的不得了…我不愿他们改变，也不愿自己改变。"
                                },
                                {
                                    "id": "790610308",
                                    "speaker": "埃斯诺尔",
                                    "text": "…但是。远游会让一切都变得不一样。对吗？罗泽尔。"
                                },
                                {
                                    "id": "790610309",
                                    "speaker": "罗泽尔",
                                    "text": "会的，一定会。我不愿骗你，也无意让你难过，亲爱的埃斯诺尔。"
                                },
                                {
                                    "id": "790610310",
                                    "speaker": "埃斯诺尔",
                                    "text": "好的…好的。我明白你的心，你一定也明白我的。"
                                },
                                {
                                    "id": "790610311",
                                    "speaker": "埃斯诺尔",
                                    "text": "我要好好想想你的邀请，稍后再做下决定…至少现在，我们只应该一起平静地喝点茶。"
                                },
                                {
                                    "id": "790610312",
                                    "speaker": "罗泽尔",
                                    "text": "好吧…我会陪着你的，埃斯诺尔。离下次起航日还很远，我可以和你一起慢慢想。"
                                }
                            ]
                        },
                        {
                            "id": "790610304",
                            "text": "有很多漂亮的花…"
                        },
                        {
                            "id": "790610305",
                            "text": "和好吃的蛋糕。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7906104",
            "objective": "",
            "dialogues": [
                {
                    "id": "790610401",
                    "speaker": "埃斯诺尔",
                    "text": "罗泽尔，或许…我可以和你同行。但是…我不知道该如何准备。"
                },
                {
                    "id": "790610402",
                    "speaker": "罗泽尔",
                    "text": "这很简单。准备好你的果酱，面包和好奇心。穿上舒适的衣服，也带上一些备用的。"
                },
                {
                    "id": "790610403",
                    "speaker": "罗泽尔",
                    "text": "最后，再做好心理准备——因为你很可能会在半路不得不丢掉它们之中的一些东西。"
                },
                {
                    "id": "790610404",
                    "speaker": "埃斯诺尔",
                    "text": "哦。听起来真复杂。而且我不想丢掉它们，它们是我的东西，很宝贵，我爱它们。"
                },
                {
                    "id": "790610405",
                    "speaker": "罗泽尔",
                    "text": "在它们离开你之后，你会遇见新的宝贵物件的，亲爱的埃斯诺尔。"
                },
                {
                    "id": "790610406",
                    "speaker": "罗泽尔",
                    "text": "相信我，这会是一趟有趣的旅程。"
                }
            ]
        },
        {
            "id": "7906101",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790610101",
                    "speaker": "埃斯诺尔",
                    "text": "罗泽尔，无论你说多少遍，我都不会和你去远游的。"
                },
                {
                    "id": "790610102",
                    "speaker": "埃斯诺尔",
                    "text": "我是你的朋友，这永远不变，我不讨厌你。但…但我不喜欢远游。"
                },
                {
                    "id": "790610103",
                    "speaker": "罗泽尔",
                    "text": "埃斯诺尔，这一切没有你想象的那么可怕，只是一场旅行，仅此而已。"
                },
                {
                    "id": "790610104",
                    "speaker": "罗泽尔",
                    "text": "外面的世界有许多村里没有的花，没见过的人，甚至连云的形状都不一样。"
                },
                {
                    "id": "790610105",
                    "speaker": "罗泽尔",
                    "text": "我不是从外面给你带来了花种吗？我保证，你肯定从未见过这种形状和颜色的花。"
                },
                {
                    "id": "790610106",
                    "speaker": "埃斯诺尔",
                    "text": "它还是种子，我要把它种下去，等它开了花才知道。"
                },
                {
                    "id": "790610107",
                    "speaker": "罗泽尔",
                    "text": "如果你愿意和我去远游，那么我们也许能直接找到这种花。"
                },
                {
                    "id": "790610108",
                    "speaker": "埃斯诺尔",
                    "text": "罗泽尔…抱歉，我不想远游，也不想变得和那些冒险客一样。"
                },
                {
                    "id": "790610109",
                    "speaker": "埃斯诺尔",
                    "text": "他们总是操心地毯的价值，不在意漂亮的帽子…"
                },
                {
                    "id": "790610110",
                    "speaker": "埃斯诺尔",
                    "text": "这是远游带给你们的改变，我害怕它。"
                },
                {
                    "id": "790610111",
                    "speaker": "罗泽尔",
                    "text": "这是事实。但你注意到他们手提箱里的地图，植物样本，还有写得满满当当的游记了吗？"
                },
                {
                    "id": "790610112",
                    "speaker": "罗泽尔",
                    "text": "我们就像一阵风穿过不同的树丛，一条河流经另一片湖泊…结识了新鲜事，但也不再是从前的自己。"
                },
                {
                    "id": "790610113",
                    "speaker": "罗泽尔",
                    "text": "这是远游带给我们的改变，我也惧怕它…但我也感谢它。"
                },
                {
                    "id": "790610114",
                    "speaker": "罗泽尔",
                    "text": "就像一片两面都涂着奶油的面包，无论你再怎么小心地拿起，总会有一面的奶油被你弄得一团糟。"
                },
                {
                    "id": "790610115",
                    "speaker": "埃斯诺尔",
                    "text": "那我就把奶油分开涂，这样我甚至能涂上不同口味。",
                    "choices": [
                        {
                            "id": "790610116",
                            "text": "这主意不错，听起来一定能吃饱。",
                            "response": [
                                {
                                    "id": "790610118",
                                    "speaker": "埃斯诺尔",
                                    "text": "是您啊，您可算来了。罗泽尔一直在告诉我，外面的世界很美好，邀请我去远游…"
                                },
                                {
                                    "id": "790610119",
                                    "speaker": "埃斯诺尔",
                                    "text": "您对外面的世界有了解吗？那边…真的和罗泽尔说的一样吗？"
                                }
                            ]
                        },
                        {
                            "id": "790610117",
                            "text": "这想法挺好，奶油不会弄到手上。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7906105",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790610501",
                    "speaker": "埃斯诺尔",
                    "text": "抱歉，罗泽尔。我…还是不能和你同行。"
                },
                {
                    "id": "790610502",
                    "speaker": "埃斯诺尔",
                    "text": "我待在这里就足够了。这样的话，当你远游回来时，至少会有人迎接你。"
                },
                {
                    "id": "790610503",
                    "speaker": "罗泽尔",
                    "text": "但是，埃斯诺尔，我…"
                },
                {
                    "id": "790610504",
                    "speaker": "埃斯诺尔",
                    "text": "我不够聪明，也不够勇敢，罗泽尔。但我想…"
                },
                {
                    "id": "790610505",
                    "speaker": "埃斯诺尔",
                    "text": "风穿过树丛，河流经湖泊，周而复始，他们总是会在最后回到起点。"
                },
                {
                    "id": "790610506",
                    "speaker": "埃斯诺尔",
                    "text": "或许，它们在经历了那么多改变后，最终的愿望还是…变回最初的自己。"
                },
                {
                    "id": "790610507",
                    "speaker": "罗泽尔",
                    "text": "……"
                },
                {
                    "id": "790610508",
                    "speaker": "埃斯诺尔",
                    "text": "我会在家里等你的，好朋友，一如既往。"
                }
            ]
        },
        {
            "id": "7906106",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790610601",
                    "speaker": "字迹歪歪扭扭的信",
                    "text": "「这封信给我的邻居，朋友，灯塔和小花。」"
                },
                {
                    "id": "790610602",
                    "speaker": "字迹歪歪扭扭的信",
                    "text": "「我即将和罗泽尔外出远游。您尽管用我的秋千，桌子和凳子。」"
                },
                {
                    "id": "790610603",
                    "speaker": "字迹歪歪扭扭的信",
                    "text": "「祝您愉快。」"
                },
                {
                    "id": "790610604",
                    "speaker": "字迹歪歪扭扭的信",
                    "text": "「您的邻居，埃斯诺尔。」"
                }
            ]
        },
        {
            "id": "7906107",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "790610701",
                    "speaker": "埃斯诺尔",
                    "text": "…还是让「改变」来得再慢些吧。"
                }
            ]
        }
    ]
}