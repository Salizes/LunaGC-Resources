    "talks": [
        {
            "id": "7054701",
            "objective": "与活跃的冒险家对话$HIDDEN",
            "dialogues": [
                {
                    "id": "705470101",
                    "speaker": "瓦乐瑞娜",
                    "text": "呜啊，是猫猫救星和白猫魔法师！居然等来了你们！"
                },
                {
                    "id": "705470102",
                    "speaker": "派蒙",
                    "text": "咦？你刚刚叫我们什么来着？",
                    "choices": [
                        {
                            "id": "705470103",
                            "text": "好像有点耳熟…",
                            "response": [
                                {
                                    "id": "705470105",
                                    "speaker": "派蒙",
                                    "text": "唔…总感觉，我们之前应该见过？"
                                },
                                {
                                    "id": "705470106",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "哈哈！白猫魔法师对我还有印象，瓦乐瑞娜大成功！"
                                },
                                {
                                    "id": "705470107",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "叙旧可以等到稍后，现在，要不要先试试我赞助的新游戏？让我最近开心整整一星期的——"
                                },
                                {
                                    "id": "705470108",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "嘟嘟可爆轰大乱斗！"
                                },
                                {
                                    "id": "705470109",
                                    "speaker": "派蒙",
                                    "text": "有…有好多种嘟嘟可！",
                                    "choices": [
                                        {
                                            "id": "705470110",
                                            "text": "而且每种都很眼熟。",
                                            "response": [
                                                {
                                                    "id": "705470112",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "你看，猫猫救星…咳咳，应该说，闪闪发光的！可敬的荣誉骑士！"
                                                },
                                                {
                                                    "id": "705470113",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "这个嘟嘟可玩偶就是以您为形象参考设计的哦。"
                                                },
                                                {
                                                    "id": "705470114",
                                                    "speaker": "派蒙",
                                                    "text": "#真，真的欸，配色和花纹都是{NICKNAME}的风格！"
                                                },
                                                {
                                                    "id": "705470115",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "在游戏中，火花嘟嘟可，闪光嘟嘟可，骑兵嘟嘟可，魔法嘟嘟可要默契合作，使用炸弹战胜前所未见的敌人…"
                                                },
                                                {
                                                    "id": "705470116",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "我只负责游戏的赞助和运营，不懂开发的细节，也不知道这些敌人的原型在现实中长什么样…"
                                                },
                                                {
                                                    "id": "705470117",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "但我相信，就算哪天真的碰面了，奇妙无比的嘟嘟可一定能打败它们！"
                                                },
                                                {
                                                    "id": "705470118",
                                                    "speaker": "派蒙",
                                                    "text": "那是当然，什么样的魔物都挡不住小可莉和她的好伙伴嘟嘟可，我们也这么觉得！",
                                                    "choices": [
                                                        {
                                                            "id": "705470119",
                                                            "text": "那就来试试看吧！",
                                                            "response": [
                                                                {
                                                                    "id": "705470121",
                                                                    "speaker": "瓦乐瑞娜",
                                                                    "text": "嘿嘿，你们肯定也能从中获得快乐！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705470120",
                                                            "text": "新的嘟嘟可游戏！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705470111",
                                            "text": "原型显而易见了呢。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705470104",
                            "text": "没听过的新外号…"
                        }
                    ]
                }
            ]
        }
    ]
}