            "dialogues": [
                {
                    "id": "220359901",
                    "speaker": "盗宝团",
                    "text": "怎么又是你们！我还什么都没干呢！"
                },
                {
                    "id": "220359902",
                    "speaker": "龙二",
                    "text": "抱歉了，社长说这也算是…预防犯罪、旅行者，我们上吧。"
                },
                {
                    "id": "220359903",
                    "speaker": "盗宝团",
                    "text": "搞、搞什么？！等一下，给我好好听人说话啊！"
                }
            ]
