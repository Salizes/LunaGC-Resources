    "talks": [
        {
            "id": "2203501",
            "objective": "与龙二对话",
            "dialogues": [
                {
                    "id": "220350101",
                    "speaker": "龙二",
                    "text": "旅行者，又见面了。上次多亏了你帮忙，社长已经确定了犯人。"
                },
                {
                    "id": "220350102",
                    "speaker": "龙二",
                    "text": "但想让那个犯人彻底伏法，需要再做一些准备。"
                },
                {
                    "id": "220350103",
                    "speaker": "龙二",
                    "text": "社长会处理其他的事，我们就继续上次的工作吧。",
                    "choices": [
                        {
                            "id": "220350104",
                            "text": "还要继续找盗宝团麻烦？",
                            "response": [
                                {
                                    "id": "220350105",
                                    "speaker": "龙二",
                                    "text": "没错。虽然那个犯人也许和我们要对付的那些盗宝团没关系…"
                                },
                                {
                                    "id": "220350106",
                                    "speaker": "龙二",
                                    "text": "但那些盗宝团平日里也没有做什么好事，这次就让他们继续「帮」我们一把好了。"
                                },
                                {
                                    "id": "220350112",
                                    "speaker": "龙二",
                                    "text": "具体的地点社长也已经给我标好了，就在城外不远。"
                                },
                                {
                                    "id": "220350113",
                                    "speaker": "龙二",
                                    "text": "城内的话…社长也已经私下里和天野和安藤先生交代过了，他们也会配合我们行动的。"
                                },
                                {
                                    "id": "220350114",
                                    "speaker": "龙二",
                                    "text": "而且…社长也已经承诺了他们，破获这桩案子的功劳，都归他们所有。他们一定会很乐意合作的。"
                                },
                                {
                                    "id": "220350115",
                                    "speaker": "龙二",
                                    "text": "思考和计划就交给社长吧，我们继续去和那些盗宝团好好「交流」一下。"
                                },
                                {
                                    "id": "220350116",
                                    "speaker": "龙二",
                                    "text": "我把地点也标在你的地图上了，我们这就出发吧。"
                                }
                            ]
                        },
                        {
                            "id": "220350107",
                            "text": "还要继续麻痹那家伙？",
                            "response": [
                                {
                                    "id": "220350108",
                                    "speaker": "龙二",
                                    "text": "没错。我们还要继续让他以为，我们的目标还是盗宝团。"
                                },
                                {
                                    "id": "220350109",
                                    "speaker": "龙二",
                                    "text": "这样，社长才能有更多的时间来完善计划。"
                                },
                                {
                                    "id": "220350110",
                                    "speaker": "龙二",
                                    "text": "呵呵…反正那些盗宝团平日里也没有做什么好事…"
                                },
                                {
                                    "id": "220350111",
                                    "speaker": "龙二",
                                    "text": "这次，就让他们继续「帮」我们一把好了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2203502",
            "objective": "前往盗宝团营地",
            "dialogues": []
        },
        {
            "id": "2203503",
            "objective": "打倒所有盗宝团",
            "dialogues": []
        },
        {
            "id": "2203508",
            "objective": "与龙二对话",
            "dialogues": [
                {
                    "id": "220350204",
                    "speaker": "龙二",
                    "text": "嗯，这次的动静也够大了，天野和安藤先生会配合我们，让城里的那个盗贼察觉到这个消息。"
                },
                {
                    "id": "220350205",
                    "speaker": "Player",
                    "text": "这还要折腾多久？"
                },
                {
                    "id": "220350206",
                    "speaker": "龙二",
                    "text": "很快了，只要社长做好准备，我们就可以去给这桩案子收尾了。"
                },
                {
                    "id": "220350207",
                    "speaker": "龙二",
                    "text": "这些报酬给你，旅行者，多谢你帮忙了。"
                },
                {
                    "id": "220350208",
                    "speaker": "龙二",
                    "text": "这是社长亲自指定的数目，应该是十分合适的，请收下吧，说不定之后还要麻烦你。"
                }
            ]
        },
