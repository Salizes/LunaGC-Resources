    "talks": [
        {
            "id": "7905801",
            "objective": "(test)阅读广告牌$HIDDEN",
            "dialogues": [
                {
                    "id": "790580101",
                    "speaker": "片场备注",
                    "text": "此处为短剧《绝境高飞》片场的弃用场景"
                },
                {
                    "id": "790580102",
                    "speaker": "片场备注",
                    "text": "原本构想的故事是受困于神秘洞窟的水形幻灵，只能凭借藏匿在书中的挖掘道具逃出生天的故事…"
                },
                {
                    "id": "790580103",
                    "speaker": "片场备注",
                    "text": "但是遭到了伊迪娅小姐的否定。"
                },
                {
                    "id": "790580104",
                    "speaker": "片场备注",
                    "text": "确实啦，水形幻灵不依靠道具就能从洞窟里钻出来，非要把挖掘用具藏在书本的设计也有点莫名奇妙。"
                },
                {
                    "id": "790580105",
                    "speaker": "片场备注",
                    "text": "但、但这个绝对是个能够受欢迎的好点子。如果能将想法展示给伊迪娅小姐看就好了。"
                },
                {
                    "id": "790580106",
                    "speaker": "片场备注",
                    "text": "不过，呜，好像得先把<color=#00E1FFFF>被附近的丘丘人偷走的道具书</color>拿回来…"
                },
                {
                    "id": "790580107",
                    "speaker": "片场备注",
                    "text": "——「导演」"
                }
            ]
        },
