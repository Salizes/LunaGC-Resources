    "talks": [
        {
            "id": "2007112",
            "objective": "与芙萝拉对话",
            "dialogues": [
                {
                    "id": "200710401",
                    "speaker": "芙萝拉",
                    "text": "这边这边，来这边。"
                },
                {
                    "id": "200710402",
                    "speaker": "芙萝拉",
                    "text": "你还记得上次我拜托你放进雪山的那些花吗？"
                },
                {
                    "id": "200710403",
                    "speaker": "芙萝拉",
                    "text": "现在已经过了一天了，我想要看看冷藏的效果。"
                },
                {
                    "id": "200710404",
                    "speaker": "芙萝拉",
                    "text": "你愿意帮我去雪山上，把那些花拿回来吗？",
                    "choices": [
                        {
                            "id": "200710405",
                            "text": "交给我吧。",
                            "response": [
                                {
                                    "id": "200710406",
                                    "speaker": "芙萝拉",
                                    "text": "那就拜托你啦，我就在这里等你，请快去快回吧。"
                                }
                            ]
                        },
                        {
                            "id": "200710407",
                            "text": "我放哪了来着…",
                            "response": [
                                {
                                    "id": "200710408",
                                    "speaker": "芙萝拉",
                                    "text": "你不记得了吗？是<color=#00E1FFFF>七天神像旁边</color>，<color=#00E1FFFF>山里的水边</color>，还有一个<color=#00E1FFFF>洞窟附近</color>哦。"
                                },
                                {
                                    "id": "200710409",
                                    "speaker": "芙萝拉",
                                    "text": "我再帮你在地图上标记一次吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2007101",
            "objective": "前往雪山回收包裹",
            "dialogues": [
                {
                    "id": "200710101",
                    "speaker": "芙萝拉",
                    "text": "之前存在雪山上的花怎么样啦？"
                },
                {
                    "id": "200710102",
                    "speaker": "Player",
                    "text": "只拿到一份…"
                },
                {
                    "id": "200710103",
                    "speaker": "芙萝拉",
                    "text": "其他的花是没能取回来吗？唔…好吧，毕竟雪山里的情况，确实很难预料呢。"
                },
                {
                    "id": "200710104",
                    "speaker": "芙萝拉",
                    "text": "但只有这一份的话，就没法对比着看了，只能以后再找机会了…"
                },
                {
                    "id": "200710105",
                    "speaker": "芙萝拉",
                    "text": "这次辛苦你帮忙，这是给你准备的报酬哦，以后说不定还要麻烦你。"
                }
            ]
        },
        {
            "id": "2007102",
            "objective": "回收雪山中七天神像附近的包裹",
            "dialogues": [
                {
                    "id": "200710201",
                    "speaker": "芙萝拉",
                    "text": "花怎么样啦？"
                },
                {
                    "id": "200710202",
                    "speaker": "Player",
                    "text": "对不起…"
                },
                {
                    "id": "200710203",
                    "speaker": "芙萝拉",
                    "text": "嗯？怎么了？"
                },
                {
                    "id": "200710204",
                    "speaker": "Player",
                    "text": "我不小心把盒子和花弄坏了…"
                },
                {
                    "id": "200710205",
                    "speaker": "芙萝拉",
                    "text": "弄、弄坏了？！"
                },
                {
                    "id": "200710206",
                    "speaker": "芙萝拉",
                    "text": "呜…那可是我专门挑出来的花，那么好的花，可不是能轻易找到的…"
                },
                {
                    "id": "200710207",
                    "speaker": "芙萝拉",
                    "text": "雪山真有这么危险吗？连你这样的冒险家都会失手，连一盒花都…"
                },
                {
                    "id": "200710208",
                    "speaker": "芙萝拉",
                    "text": "不过，还是谢谢你帮我跑这一趟，这些东西给你，请收下吧，我要去打理店里的花了。"
                },
                {
                    "id": "200710209",
                    "speaker": "芙萝拉",
                    "text": "唉，不然…我还是再用莎拉小姐的办法试试吧…"
                }
            ]
        },
        {
            "id": "2007103",
            "objective": "回收雪山中七天神像附近的包裹",
            "dialogues": [
                {
                    "id": "200710301",
                    "speaker": "芙萝拉",
                    "text": "之前存在雪山上的花怎么样啦？"
                },
                {
                    "id": "200710302",
                    "speaker": "Player",
                    "text": "加上这次的都在这里了。"
                },
                {
                    "id": "200710303",
                    "speaker": "芙萝拉",
                    "text": "都拿到了吗 ？太好了，快给我看看。"
                },
                {
                    "id": "200710304",
                    "speaker": "芙萝拉",
                    "text": "呼呼，看起来不错呀，嗯…看来这个方法确实可行。"
                },
                {
                    "id": "200710305",
                    "speaker": "芙萝拉",
                    "text": "不过，雪山距离蒙德城有些太远了，总不能每次都麻烦你，以后得想个方便的办法才行…"
                },
                {
                    "id": "200710306",
                    "speaker": "芙萝拉",
                    "text": "总之，谢谢你来帮忙呀，这些是给你的谢礼，请拿着吧。"
                }
            ]
        },
