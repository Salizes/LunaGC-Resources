    "talks": [
        {
            "id": "7001101",
            "objective": "与丘丘人对话",
            "dialogues": [
                {
                    "id": "700110101",
                    "speaker": "警惕的丘丘人",
                    "text": "Yaya dala! Kundala?"
                },
                {
                    "id": "700110102",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi nye odomu! Kundala nye!"
                },
                {
                    "id": "700110103",
                    "speaker": "警惕的丘丘人",
                    "text": "Nye Odomu? Yoyo mani mi?"
                },
                {
                    "id": "700110104",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi tomo, mimi plata odomu! Mimi mani ye!"
                },
                {
                    "id": "700110105",
                    "speaker": "警惕的丘丘人",
                    "text": "Mani…? Zido mi, mi dada. Nye kundala? Mi plata yeye!"
                },
                {
                    "id": "700110106",
                    "speaker": "派蒙",
                    "text": "哇…这家伙脾气好差！",
                    "choices": [
                        {
                            "id": "700110107",
                            "text": "马斯克小姐，小心…",
                            "response": [
                                {
                                    "id": "700110109",
                                    "speaker": "艾拉·马斯克",
                                    "text": "请别冲动，没关系的。我完全理解了。"
                                },
                                {
                                    "id": "700110110",
                                    "speaker": "派蒙",
                                    "text": "欸…？"
                                },
                                {
                                    "id": "700110111",
                                    "speaker": "艾拉·马斯克",
                                    "text": "它想要我们帮忙打败敌人而已，就在地图的…这个位置。"
                                },
                                {
                                    "id": "700110113",
                                    "speaker": "Player",
                                    "text": "原来如此…"
                                },
                                {
                                    "id": "700110114",
                                    "speaker": "艾拉·马斯克",
                                    "text": "那家伙的位置已经在地图上标好了，我就先回去啦！"
                                },
                                {
                                    "id": "700110115",
                                    "speaker": "警惕的丘丘人",
                                    "text": "Dada, Valo!"
                                }
                            ]
                        },
                        {
                            "id": "700110108",
                            "text": "需要我们出手吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7001102",
            "objective": "前往指定地点战斗",
            "dialogues": [
                {
                    "id": "700110201",
                    "speaker": "警惕的丘丘人",
                    "text": "Mosi mita!"
                },
                {
                    "id": "700110202",
                    "speaker": "艾拉·马斯克",
                    "text": "Mimi muhe du, du ya Wei zido dala si."
                },
                {
                    "id": "700110203",
                    "speaker": "警惕的丘丘人",
                    "text": "Mi mito nye. Mi mito ya zido mito, beru ya!"
                },
                {
                    "id": "700110204",
                    "speaker": "艾拉·马斯克",
                    "text": "它也不知道，不过我们可以找它认识的人问一问。"
                },
                {
                    "id": "700110205",
                    "speaker": "Player",
                    "text": "Valo!"
                },
                {
                    "id": "700110206",
                    "speaker": "警惕的丘丘人",
                    "text": "Valo, mimi tomo!"
                }
            ]
        },
        {
