    "talks": [
        {
            "id": "7069601",
            "objective": "与八重神子对话",
            "dialogues": [
                {
                    "id": "706960101",
                    "speaker": "八重神子",
                    "text": "好久不见了，小家伙。最近去哪儿旅行了？"
                },
                {
                    "id": "706960102",
                    "speaker": "Black Screen",
                    "text": "将雪山的见闻告知了神子。"
                },
                {
                    "id": "706960103",
                    "speaker": "八重神子",
                    "text": "嗯，真是群可爱的孩子呀。"
                },
                {
                    "id": "706960104",
                    "speaker": "八重神子",
                    "text": "为了共同的爱好，不管相隔多远也要相聚……啊呀，青春的气息真是扑面而来。"
                },
                {
                    "id": "706960105",
                    "speaker": "八重神子",
                    "text": "看来《炽魂斗士战记》的魅力不小呢，是时候把再版计划提上日程了…"
                },
                {
                    "id": "706960106",
                    "speaker": "八重神子",
                    "text": "读者们这么真诚，我也必须表示一下心意才行呢。"
                },
                {
                    "id": "706960107",
                    "speaker": "八重神子",
                    "text": "给你们赠送一些漫画如何？嗯…人不少，得多送几本。",
                    "choices": [
                        {
                            "id": "706960108",
                            "text": "谢谢你。",
                            "response": [
                                {
                                    "id": "706960110",
                                    "speaker": "八重神子",
                                    "text": "都是初版印刷品，外面可买不到，好好珍惜哦。"
                                }
                            ]
                        },
                        {
                            "id": "706960109",
                            "text": "会和大家分享的。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7069602",
            "objective": "返回营地放置礼物",
            "dialogues": [
                {
                    "id": "706960201",
                    "speaker": "派蒙",
                    "text": "神子送了我们不少漫画，既然决定了要和大家分享，干脆就把它们都摆出来吧。"
                },
                {
                    "id": "706960202",
                    "speaker": "派蒙",
                    "text": "就放在「特战队」营地书摊附近吧，方便大家拿去看。"
                },
                {
                    "id": "706960203",
                    "speaker": "Black Screen",
                    "text": "借来一个书柜，将神子赠送的漫画都放了进去。"
                },
                {
                    "id": "706960204",
                    "speaker": "派蒙",
                    "text": "不错不错，这样一来，大家空闲的时候就能来挑漫画了。"
                }
            ]
        }
    ]
}