    "talks": [
        {
            "id": "2400601",
            "objective": "与韦吕对话",
            "dialogues": [
                {
                    "id": "240060101",
                    "speaker": "韦吕",
                    "text": "这次轮到我来抓人了，我肯定能抓住洛薇。"
                },
                {
                    "id": "240060102",
                    "speaker": "洛薇",
                    "text": "那可说不准。有些地方你都爬不上去呢。"
                },
                {
                    "id": "240060103",
                    "speaker": "韦吕",
                    "text": "那是…那是因为我的鞋子不适合爬，要是换双鞋，肯定能抓住你！"
                },
                {
                    "id": "240060104",
                    "speaker": "洛薇",
                    "text": "那我们干脆把鞋子都脱掉好了，这样才公平！"
                },
                {
                    "id": "240060105",
                    "speaker": "奥雷勒",
                    "text": "好了！你们不许光脚到处跑，这里到处都是废弃的零件，要是划伤了怎么办？"
                },
                {
                    "id": "240060106",
                    "speaker": "洛薇",
                    "text": "是…"
                },
                {
                    "id": "240060107",
                    "speaker": "韦吕",
                    "text": "好…"
                },
                {
                    "id": "240060108",
                    "speaker": "韦吕",
                    "text": "那个…哥，你刚才抓我的时候，怎么一副走神的样子啊？我从你面前跑过去都没反应。"
                },
                {
                    "id": "240060109",
                    "speaker": "奥雷勒",
                    "text": "咦？是这样吗？我刚才完全没注意到…"
                },
                {
                    "id": "240060110",
                    "speaker": "洛薇",
                    "text": "是啊，我刚才绕着跑一圈啦，但你就和没看见我一样。"
                },
                {
                    "id": "240060111",
                    "speaker": "奥雷勒",
                    "text": "#但…欸？{M#大哥哥}{F#大姐姐}，您怎么来了？",
                    "choices": [
                        {
                            "id": "240060112",
                            "text": "洛薇怎么在这？",
                            "response": [
                                {
                                    "id": "240060113",
                                    "speaker": "洛薇",
                                    "text": "爸爸说他最近要去出差，妈妈也要出去工作。"
                                },
                                {
                                    "id": "240060114",
                                    "speaker": "洛薇",
                                    "text": "正好奥雷勒哥哥来还书，爸爸就拜托奥雷勒哥哥来照顾我，所以我就来这里和他们一起玩啦。"
                                },
                                {
                                    "id": "240060118",
                                    "speaker": "奥雷勒",
                                    "text": "不说这些了，继续玩吧，这次谁来抓人？",
                                    "choices": [
                                        {
                                            "id": "240060119",
                                            "text": "我还以为你不太喜欢捉迷藏。",
                                            "response": [
                                                {
                                                    "id": "240060121",
                                                    "speaker": "奥雷勒",
                                                    "text": "这个啊，咳…因为我最近正在写第一篇评论，需要思考一些问题。"
                                                },
                                                {
                                                    "id": "240060122",
                                                    "speaker": "奥雷勒",
                                                    "text": "我发现…那个，在运动时我的思维会格外敏捷，所以…"
                                                },
                                                {
                                                    "id": "240060123",
                                                    "speaker": "洛薇",
                                                    "text": "但就是容易走神，有时候还会站在原地自言自语，怎么叫都没反应。"
                                                },
                                                {
                                                    "id": "240060124",
                                                    "speaker": "韦吕",
                                                    "text": "#{M#大哥哥}{F#大姐姐}，你陪我们玩玩吧，你玩捉迷藏肯定比哥哥厉害多了。",
                                                    "choices": [
                                                        {
                                                            "id": "240060125",
                                                            "text": "没问题。",
                                                            "response": [
                                                                {
                                                                    "id": "240060127",
                                                                    "speaker": "韦吕",
                                                                    "text": "嘿嘿，那可说不好，我和洛薇可都是捉迷藏大师。"
                                                                },
                                                                {
                                                                    "id": "240060128",
                                                                    "speaker": "韦吕",
                                                                    "text": "那就开始吧，快快快洛薇，我们去藏起来吧。"
                                                                },
                                                                {
                                                                    "id": "240060129",
                                                                    "speaker": "Black Screen",
                                                                    "text": "洛薇和韦吕飞快地跑开了，奥雷勒则沉思着缓步离开…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "240060126",
                                                            "text": "我可不会让你们。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "240060120",
                                            "text": "你怎么突然这么想玩捉迷藏了？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "240060115",
                            "text": "你们还在玩捉迷藏吗？",
                            "response": [
                                {
                                    "id": "240060116",
                                    "speaker": "奥雷勒",
                                    "text": "是的。因为德勒吕叔叔正巧要去出差，杜梅阿姨也要去工作，于是他们就拜托我来照顾洛薇。"
                                },
                                {
                                    "id": "240060117",
                                    "speaker": "奥雷勒",
                                    "text": "所以我就带着洛薇来这里和我们一起玩了，希望她的裙子不会被弄得太脏…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2400602",
            "objective": "找到孩子们",
            "dialogues": [
                {
                    "id": "240060201",
                    "speaker": "韦吕",
                    "text": "#还是被找到啦，{M#大哥哥}{F#大姐姐}果然还是比我厉害。"
                },
                {
                    "id": "240060202",
                    "speaker": "韦吕",
                    "text": "那我去集合点啦，希望哥哥能晚点被找到…"
                },
                {
                    "id": "240060203",
                    "speaker": "Player",
                    "text": "你为什么这么希望？"
                },
                {
                    "id": "240060204",
                    "speaker": "韦吕",
                    "text": "哥哥说过呀，每次玩捉迷藏了之后，他都会找到很多新思路。"
                },
                {
                    "id": "240060205",
                    "speaker": "韦吕",
                    "text": "那些思路太多了，他每次都要蹲在地上记好久。"
                },
                {
                    "id": "240060206",
                    "speaker": "韦吕",
                    "text": "洛薇和我说，那些思路可宝贵了，绝对不能打扰他。"
                },
                {
                    "id": "240060207",
                    "speaker": "韦吕",
                    "text": "所以我和洛薇在和哥哥玩捉迷藏的时候。如果轮到他被抓，那我们就会故意拖长时间，等他记好了再去找他。"
                },
                {
                    "id": "240060208",
                    "speaker": "韦吕",
                    "text": "就是…如果轮到哥哥抓人，那我们可就得等好长一段时间了…"
                }
            ]
        },
        {
            "id": "2400603",
            "objective": "找到孩子们",
            "dialogues": [
                {
                    "id": "240060301",
                    "speaker": "奥雷勒",
                    "text": "不行…这一段的逻辑不通顺，要从另外一个角度切入…"
                },
                {
                    "id": "240060302",
                    "speaker": "奥雷勒",
                    "text": "这么…不对，还是不对…"
                },
                {
                    "id": "240060303",
                    "speaker": "奥雷勒",
                    "text": "啊？我被找到了啊，我现在就去集合点。"
                },
                {
                    "id": "240060304",
                    "speaker": "奥雷勒",
                    "text": "嗯…这个观点对吗？不对，呃…对不对呢…"
                }
            ]
        },
        {
            "id": "2400604",
            "objective": "找到孩子们",
            "dialogues": [
                {
                    "id": "240060401",
                    "speaker": "洛薇",
                    "text": "不知道奥雷勒哥哥能不能找到思路…"
                },
                {
                    "id": "240060402",
                    "speaker": "洛薇",
                    "text": "#咦？！这个地方也能被找到吗？{M#大哥哥}{F#大姐姐}，你到底玩过多少次捉迷藏啊…"
                },
                {
                    "id": "240060403",
                    "speaker": "洛薇",
                    "text": "那我回集合点啦，下次一定藏得再好点。"
                }
            ]
        },
        {
            "id": "2400605",
            "objective": "(test)（隐藏）抓三个小孩保底$HIDDEN",
            "dialogues": []
        },
        {
            "id": "2400606",
            "objective": "与奥雷勒对话",
            "dialogues": [
                {
                    "id": "240060601",
                    "speaker": "奥雷勒",
                    "text": "不对，不对…这里的论证不严谨…"
                },
                {
                    "id": "240060602",
                    "speaker": "洛薇",
                    "text": "#奥雷勒哥哥又不搭理人了…{M#大哥哥}{F#大姐姐}，谢谢你陪我们玩啦。",
                    "choices": [
                        {
                            "id": "240060603",
                            "text": "他…没关系吗？",
                            "response": [
                                {
                                    "id": "240060605",
                                    "speaker": "洛薇",
                                    "text": "只要他不像我爸爸一样，把咖啡当做水来喝，应该就不会有身体问题。"
                                },
                                {
                                    "id": "240060606",
                                    "speaker": "韦吕",
                                    "text": "这个问题嘛，就包在我身上，我不会让哥哥喝太多咖啡的，实在不行…我把他的咖啡都藏起来。"
                                },
                                {
                                    "id": "240060607",
                                    "speaker": "洛薇",
                                    "text": "唉，我还打算把我爸爸的咖啡，都拿过来藏在这里的…这下可藏不得啦。"
                                },
                                {
                                    "id": "240060608",
                                    "speaker": "韦吕",
                                    "text": "做评论家，可真是一件麻烦的事啊…"
                                }
                            ]
                        },
                        {
                            "id": "240060604",
                            "text": "他…不会太累吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2400699",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "240069901",
                    "speaker": "韦吕",
                    "text": "找不到我…找不到我…"
                },
                {
                    "id": "240069902",
                    "speaker": "洛薇",
                    "text": "奥雷勒真是的…"
                },
                {
                    "id": "240069903",
                    "speaker": "奥雷勒",
                    "text": "这段还不错…"
                },
                {
                    "id": "240069904",
                    "speaker": "韦吕",
                    "text": "抓不住我…抓不住我…"
                },
                {
                    "id": "240069905",
                    "speaker": "洛薇",
                    "text": "奥雷勒这家伙…"
                }
            ]
        }
    ]
}