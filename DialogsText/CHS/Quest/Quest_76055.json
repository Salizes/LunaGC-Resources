    "talks": [
        {
            "id": "7605501",
            "objective": "(test)隐藏$HIDDEN",
            "dialogues": [
                {
                    "id": "760550101",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>菈乌玛</color>似乎听到了什么…）"
                },
                {
                    "id": "760550102",
                    "speaker": "菈乌玛",
                    "text": "…奇怪。刚才听见了什么响动。"
                },
                {
                    "id": "760550103",
                    "speaker": "？？？",
                    "text": "（又有客人！转动轮盘，停下转盘，就有好吃的！）"
                },
                {
                    "id": "760550104",
                    "speaker": "？？？",
                    "text": "（咦？客人怎么不转呀，快点快点，想吃好吃的！）"
                },
                {
                    "id": "760550105",
                    "speaker": "菈乌玛",
                    "text": "听起来，像是一只小狗…？转动轮盘，有好吃的…这又是什么意思…"
                },
                {
                    "id": "760550106",
                    "speaker": "？？？",
                    "text": "（客人！能和我说话，客人，快点转动轮盘吧，不然我就吃不到好吃的啦。）"
                },
                {
                    "id": "760550107",
                    "speaker": "菈乌玛",
                    "text": "你饿了么？来，我带着一些饼干，先吃一点吧。"
                },
                {
                    "id": "760550108",
                    "speaker": "？？？",
                    "text": "（呜？客人不转轮盘，客人要给我吃的…嗯，先吃，先吃。）"
                },
                {
                    "id": "760550109",
                    "speaker": "巴甫洛夫",
                    "text": "（谢谢客人，我是巴甫洛夫，谢谢客人的饼干，好吃好吃。但你没有转动轮盘呢。）"
                },
                {
                    "id": "760550110",
                    "speaker": "菈乌玛",
                    "text": "不用客气，但…你刚才说的转盘，是什么意思呢？"
                },
                {
                    "id": "760550111",
                    "speaker": "巴甫洛夫",
                    "text": "（转盘动了，让它停下，好吃的会掉下来，每次都是这样。）"
                },
                {
                    "id": "760550112",
                    "speaker": "巴甫洛夫",
                    "text": "（客人，你真的不转转盘吗？每个人转完之后，都很高兴。）"
                },
                {
                    "id": "760550113",
                    "speaker": "菈乌玛",
                    "text": "我就不用了，看样子…你在这里过得还不错？"
                },
                {
                    "id": "760550114",
                    "speaker": "巴甫洛夫",
                    "text": "（好呀，好呀，有人陪着我玩，转盘陪着我玩，还有好吃的。）"
                },
                {
                    "id": "760550115",
                    "speaker": "菈乌玛",
                    "text": "这样就好。那么，替我向你的主人问好，我先告辞了。"
                },
                {
                    "id": "760550116",
                    "speaker": "巴甫洛夫",
                    "text": "（呜…客人再见，客人下次再见。）"
                }
            ]
        },
        {
            "id": "7605502",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760550201",
                    "speaker": "Player",
                    "text": "（咦？好像有<color=#FFCC33FF>小动物</color>的声音…？）"
                },
                {
                    "id": "760550202",
                    "speaker": "Player",
                    "text": "（如果有能听懂动物说话的人在，也许能更清晰地分辨出来这声音的来源…）"
                }
            ]
        },
        {
            "id": "7605503",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "760550301",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>哥伦比娅</color>似乎听到了什么…）"
                },
                {
                    "id": "760550302",
                    "speaker": "哥伦比娅",
                    "text": "奇怪。好像有什么声音…"
                },
                {
                    "id": "760550303",
                    "speaker": "？？？",
                    "text": "（又有客人！转动轮盘，停下转盘，就有好吃的！）"
                },
                {
                    "id": "760550304",
                    "speaker": "？？？",
                    "text": "（咦？客人怎么不转呀，快点快点，想吃好吃的！）"
                },
                {
                    "id": "760550305",
                    "speaker": "哥伦比娅",
                    "text": "一只小狗…？你想让我帮你转动轮盘么？"
                },
                {
                    "id": "760550306",
                    "speaker": "？？？",
                    "text": "（客人！能和我说话，是的，客人，快点转动轮盘吧，不然我就吃不到好吃的啦。）"
                },
                {
                    "id": "760550307",
                    "speaker": "哥伦比娅",
                    "text": "你饿了么？我刚买了点心，分你一点，吃吧。"
                },
                {
                    "id": "760550308",
                    "speaker": "？？？",
                    "text": "（呜？客人不转轮盘，客人要给我吃的…嗯，先吃，先吃。）"
                },
                {
                    "id": "760550309",
                    "speaker": "巴甫洛夫",
                    "text": "（谢谢客人，我是巴甫洛夫，谢谢客人，好吃好吃。但你没有转动轮盘呢。）"
                },
                {
                    "id": "760550310",
                    "speaker": "哥伦比娅",
                    "text": "这种点心确实很好吃。但你刚才说的轮盘，是什么意思呢？"
                },
                {
                    "id": "760550311",
                    "speaker": "巴甫洛夫",
                    "text": "（转盘动了，让它停下，好吃的会掉下来，每次都是这样。）"
                },
                {
                    "id": "760550312",
                    "speaker": "巴甫洛夫",
                    "text": "（客人，你真的不转转盘吗？每个人转完之后，都很高兴。）"
                },
                {
                    "id": "760550313",
                    "speaker": "哥伦比娅",
                    "text": "那么，转轮盘之后，你会高兴吗？"
                },
                {
                    "id": "760550314",
                    "speaker": "巴甫洛夫",
                    "text": "（高兴呀，很高兴呀，有人陪着我玩，转盘陪着我玩，还有好吃的…最重要的是好吃的！）"
                },
                {
                    "id": "760550315",
                    "speaker": "哥伦比娅",
                    "text": "嗯…那，这些点心也给你。好吃的确实很重要。"
                },
                {
                    "id": "760550316",
                    "speaker": "哥伦比娅",
                    "text": "我还要去买其他的好吃的，再见啦，巴甫洛夫。"
                },
                {
                    "id": "760550317",
                    "speaker": "巴甫洛夫",
                    "text": "（呜…好吃好吃，客人再见，客人下次再见。）"
                }
            ]
        }
    ]
}