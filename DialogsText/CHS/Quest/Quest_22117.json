{
    "quest": {
        "id": "22117",
        "title": "绝云访友",
        "description": "萍姥姥刚刚去「琥牢山」寻访了故友，但是她却发现，自己好像把什么东西落在了「琥牢山」上…",
        "rewards": [],
        "rewards_formatted": "",
        "chapter": {
            "icon": "",
            "id": "",
            "num": "",
            "title": ""
        },
        "total_dialogue_lines": 31,
        "total_speaker_counts": {
            "Player": 6,
            "派蒙": 1,
            "萍姥姥": 24
        }
    },
    "talks": [
        {
            "id": "2211701",
            "objective": "和萍姥姥对话",
            "dialogues": [
                {
                    "id": "221170101",
                    "speaker": "萍姥姥",
                    "text": "唉，不会真的落在山上了吧…"
                },
                {
                    "id": "221170102",
                    "speaker": "Player",
                    "text": "婆婆，您…您怎么在这？"
                },
                {
                    "id": "221170103",
                    "speaker": "萍姥姥",
                    "text": "哎呀，你们这两个孩子，怎么到这里来了？这可太巧了…哦唷，你这孩子怎么穿这么少，上面风大，可别着凉了…"
                },
                {
                    "id": "221170104",
                    "speaker": "萍姥姥",
                    "text": "我老婆子刚刚去「琥牢山」见了个老朋友，叙了叙旧，就打算回城里了。"
                },
                {
                    "id": "221170105",
                    "speaker": "萍姥姥",
                    "text": "但是走到一半，我突然发现有东西不见了，唉，大概是落在「琥牢山」上了吧…"
                },
                {
                    "id": "221170106",
                    "speaker": "萍姥姥",
                    "text": "但是都走了这么远了，山上还有那堆麻烦的琥珀，我这老身子骨可再没力气走第二趟了。"
                },
                {
                    "id": "221170107",
                    "speaker": "萍姥姥",
                    "text": "孩子们，你们能帮我去「琥牢山」上看看，帮我把落下的东西拿回来吗？",
                    "choices": [
                        {
                            "id": "221170108",
                            "text": "您的朋友是…",
                            "response": [
                                {
                                    "id": "221170109",
                                    "speaker": "萍姥姥",
                                    "text": "唉，就是住在「琥牢山」上的那位，你们应该已经见过了吧。他的那个琥珀啊…可麻烦喽…"
                                },
                                {
                                    "id": "221170110",
                                    "speaker": "萍姥姥",
                                    "text": "也是赖我记性不好，忘了把那个盒子放在壶里，多了这么些事情…"
                                }
                            ]
                        },
                        {
                            "id": "221170111",
                            "text": "您落下的是什么东西？",
                            "response": [
                                {
                                    "id": "221170112",
                                    "speaker": "萍姥姥",
                                    "text": "应该是一个盒子，唉，也是我记性不好，直接把那东西放进壶里，哪里有这么多事…"
                                },
                                {
                                    "id": "221170113",
                                    "speaker": "萍姥姥",
                                    "text": "不过，要是我的那个盒子真落在了「琥牢山」上，那十有八九是被关在了那山上的琥珀里面，倒也好找。"
                                },
                                {
                                    "id": "221170114",
                                    "speaker": "萍姥姥",
                                    "text": "孩子们，你们就去「琥牢山」上，从那些琥珀里头，帮我老婆子找找东西吧。"
                                },
                                {
                                    "id": "221170115",
                                    "speaker": "萍姥姥",
                                    "text": "对了，你们可要当心了啊。这么多年了，那琥珀里头，不知道都被那位关进去了些什么…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "2211702",
            "objective": "打碎琥珀，找到萍姥姥的盒子",
            "dialogues": [
                {
                    "id": "221170201",
                    "speaker": "派蒙",
                    "text": "这应该就是婆婆落下的东西了吧。"
                }
            ]
        },
        {
            "id": "2211703",
            "objective": "和萍姥姥对话",
            "dialogues": [
                {
                    "id": "221170301",
                    "speaker": "萍姥姥",
                    "text": "你这孩子，怎么还不去多穿点衣服！要是着凉了就要遭大罪啦。"
                },
                {
                    "id": "221170302",
                    "speaker": "Player",
                    "text": "婆婆，这是您落下的东西吗？"
                },
                {
                    "id": "221170303",
                    "speaker": "萍姥姥",
                    "text": "我看看…对，对，就是这个东西，还真落在山上了，我这个记性啊…"
                },
                {
                    "id": "221170304",
                    "speaker": "萍姥姥",
                    "text": "别看啦，孩子们，这盒子里装的都是些无聊的老物件。"
                },
                {
                    "id": "221170305",
                    "speaker": "萍姥姥",
                    "text": "喏，这些是给你们的，收好了，谢谢你们帮我跑这么一趟。"
                },
                {
                    "id": "221170306",
                    "speaker": "萍姥姥",
                    "text": "唉，得赶紧把这盒子放进壶里了，别再忘记了…"
                }
            ]
        },
        {
            "id": "2211704",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "221170401",
                    "speaker": "萍姥姥",
                    "text": "你这孩子，怎么还不去多穿点衣服！要是着凉了就要遭大罪啦。",
                    "choices": [
                        {
                            "id": "221170402",
                            "text": "那些琥珀…",
                            "response": [
                                {
                                    "id": "221170403",
                                    "speaker": "萍姥姥",
                                    "text": "那些琥珀啊，都是我那位老朋友弄出来的，他和我说，这是为了防一些侵扰山上的怪物和毛贼…"
                                },
                                {
                                    "id": "221170404",
                                    "speaker": "萍姥姥",
                                    "text": "经年日久…到现在，有些山上的琥珀里面还关着些莫名其妙的东西…"
                                },
                                {
                                    "id": "221170405",
                                    "speaker": "萍姥姥",
                                    "text": "唉，这些琥珀啊，真是…"
                                }
                            ]
                        },
                        {
                            "id": "221170406",
                            "text": "您的那个壶…",
                            "response": [
                                {
                                    "id": "221170407",
                                    "speaker": "萍姥姥",
                                    "text": "喔，可要谢谢你们啦，我老婆子的那个壶，总算是又干净了。"
                                },
                                {
                                    "id": "221170408",
                                    "speaker": "萍姥姥",
                                    "text": "这不，我过来取东西，就是要再把那个壶给好好打理一下。"
                                },
                                {
                                    "id": "221170409",
                                    "speaker": "萍姥姥",
                                    "text": "打扫干净，打理好了之后，才好再用来请客啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}