    },
    "talks": [
        {
            "id": "7220601",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060101",
                    "speaker": "阿部",
                    "text": "喂！我还在这呢！！"
                },
                {
                    "id": "722060102",
                    "speaker": "阿部",
                    "text": "现在的年轻人都是怎么回事，一点公德心都没有吗！！",
                    "choices": [
                        {
                            "id": "722060103",
                            "text": "对、对不起！",
                            "response": [
                                {
                                    "id": "722060104",
                                    "speaker": "阿部",
                                    "text": "哼…这还差不多，认错就好，那点蘑菇就当我送你的了…不要乱碰我的蘑菇啦！"
                                }
                            ]
                        },
                        {
                            "id": "722060105",
                            "text": "这是你的蘑菇吗？",
                            "response": [
                                {
                                    "id": "722060106",
                                    "speaker": "阿部",
                                    "text": "关你什么事！别再乱采摘了，乖乖离开就好！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220603",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060201",
                    "speaker": "派蒙",
                    "text": "哇啊！刚刚那个家伙…你看到了吗？！",
                    "choices": [
                        {
                            "id": "722060202",
                            "text": "没看到。",
                            "response": [
                                {
                                    "id": "722060204",
                                    "speaker": "派蒙",
                                    "text": "唔…真邪门。我们再摘几棵蘑菇就快点离开吧！"
                                }
                            ]
                        },
                        {
                            "id": "722060203",
                            "text": "是幻觉吧。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220604",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060401",
                    "speaker": "阿部",
                    "text": "怎么？准备让我开开眼界了吗？"
                },
                {
                    "id": "722060402",
                    "speaker": "Player",
                    "text": "这些是你要的蘑菇吗？"
                }
            ]
        },
        {
            "id": "7220605",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060301",
                    "speaker": "阿部",
                    "text": "喂！我没有警告过你们吗！你们是耳朵不好还是没长眼睛呀？！"
                },
                {
                    "id": "722060302",
                    "speaker": "Player",
                    "text": "哇，是幽灵。"
                },
                {
                    "id": "722060303",
                    "speaker": "阿部",
                    "text": "哇啊！什么幽灵？！哪里有幽灵！！",
                    "choices": [
                        {
                            "id": "722060304",
                            "text": "就在这里哦。",
                            "response": [
                                {
                                    "id": "722060306",
                                    "speaker": "阿部",
                                    "text": "呀啊！去，去！恶灵速去！！以我阿部的氏名，命你快快离去！！"
                                },
                                {
                                    "id": "722060307",
                                    "speaker": "阿部",
                                    "text": "唉呀，邪门，邪门！我活了这么些年，还没见过如此凶恶的灵！！为何还不速去！！"
                                },
                                {
                                    "id": "722060308",
                                    "speaker": "Player",
                                    "text": "我是从岛外来的。"
                                },
                                {
                                    "id": "722060309",
                                    "speaker": "阿部",
                                    "text": "雾海外的恶灵吗…哼，我可不怕你！你在这里站着别动，等着让雷鸟大人把你驱走吧！",
                                    "choices": [
                                        {
                                            "id": "722060310",
                                            "text": "雷鸟不会再来了。",
                                            "response": [
                                                {
                                                    "id": "722060312",
                                                    "speaker": "阿部",
                                                    "text": "你说什么…？",
                                                    "choices": [
                                                        {
                                                            "id": "722060313",
                                                            "text": "大家都已经离去了。",
                                                            "response": [
                                                                {
                                                                    "id": "722060315",
                                                                    "speaker": "阿部",
                                                                    "text": "什么…你在说什么啊…别说让我害怕的话呀，鸡皮疙瘩都起来了…"
                                                                },
                                                                {
                                                                    "id": "722060316",
                                                                    "speaker": "阿部",
                                                                    "text": "不过…岛上的人是越来越少了…之前木奈那孩子说，大家都去坐船了呢…唉，也不知道那孩子跑去哪里玩了…"
                                                                },
                                                                {
                                                                    "id": "722060317",
                                                                    "speaker": "阿部",
                                                                    "text": "对了，岛外来的恶灵大人，你不去吗…？海边那条银璨璨的船？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "722060318",
                                                                            "text": "我没看到哪里有船。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "722060320",
                                                                                    "speaker": "阿部",
                                                                                    "text": "哼…我就知道，那船呀，岛外的人是看不到的…"
                                                                                },
                                                                                {
                                                                                    "id": "722060321",
                                                                                    "speaker": "阿部",
                                                                                    "text": "谢谢你催我上船，岛外的恶灵大人。只不过呀…我活了这么些年，还有好些东西没见识过呢，可舍不得离开…"
                                                                                },
                                                                                {
                                                                                    "id": "722060322",
                                                                                    "speaker": "Player",
                                                                                    "text": "你需要什么？"
                                                                                },
                                                                                {
                                                                                    "id": "722060323",
                                                                                    "speaker": "阿部",
                                                                                    "text": "需要？哈哈，不算需要吧…也就是看个新鲜而已…"
                                                                                },
                                                                                {
                                                                                    "id": "722060324",
                                                                                    "speaker": "阿部",
                                                                                    "text": "我很小、很小的时候，曾经和宇奈大姐打过一个赌…我说岛外一定有不一样的蘑菇，可她就是不信。"
                                                                                },
                                                                                {
                                                                                    "id": "722060325",
                                                                                    "speaker": "阿部",
                                                                                    "text": "后来…她的丈夫出海去了外人的土地，就再也没能回来…他的灵也只能在外人的土地上晃悠了…可怜呀。"
                                                                                },
                                                                                {
                                                                                    "id": "722060326",
                                                                                    "speaker": "阿部",
                                                                                    "text": "于是，宇奈大姐一直一个人过日子到现在…一想起来我就…唉…",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "722060327",
                                                                                            "text": "请不要惦记别人了。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "722060329",
                                                                                                    "speaker": "阿部",
                                                                                                    "text": "我还求过祭司大人呢…好歹要给人家一个归宿…嗯？哦，对了，对了，蘑菇！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "722060330",
                                                                                                    "speaker": "阿部",
                                                                                                    "text": "咳咳…就要登船了，我也没什么可遗憾的…就是没有见识过岛外的玩意。可是我最上心的呢…也就每天都在关照的蘑菇们了…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "722060331",
                                                                                                    "speaker": "阿部",
                                                                                                    "text": "就请你给我带来一些雾海外的蘑菇吧…也让我涨涨见识。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "722060332",
                                                                                                    "speaker": "阿部",
                                                                                                    "text": "拜托你了，岛外的恶灵大人。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "722060328",
                                                                                            "text": "关于蘑菇…"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "722060319",
                                                                            "text": "那不是为我准备的。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "722060314",
                                                            "text": "是时候告别了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "722060311",
                                            "text": "「雾海」已经是过去了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "722060305",
                            "text": "就是我啦。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7220607",
            "objective": "",
            "dialogues": [
                {
                    "id": "722060501",
                    "speaker": "阿部",
                    "text": "哦哦！哈哈…真是奇形怪状！它们也有自己的「灵」吗？它们也凝结着人的记忆吗…？"
                },
                {
                    "id": "722060502",
                    "speaker": "阿部",
                    "text": "还有这个…软软呼呼的，小翅膀一样，它是会飞吗…？"
                },
                {
                    "id": "722060503",
                    "speaker": "阿部",
                    "text": "唉呀…没完没了的好奇，船夫都要生气了…真是不好意思，最终还是该走了，该上船咯…"
                }
            ]
        }
    ]
}