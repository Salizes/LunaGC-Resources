            "dialogues": []
        },
        {
            "id": "7223914",
            "objective": "（test）与派蒙说话$HIDDEN",
            "dialogues": [
                {
                    "id": "722390701",
                    "speaker": "派蒙",
                    "text": "感觉已经有一些变化了，接下来只要耐心等待。"
                },
                {
                    "id": "722390702",
                    "speaker": "派蒙",
                    "text": "我们过一段时间再来看看吧."
                }
            ]
        },
        {
            "id": "7223916",
            "objective": "等待龙骨花凝结",
            "dialogues": []
        },
        {
            "id": "7223918",
            "objective": "获取龙骨花凝珠",
            "dialogues": [
                {
                    "id": "722391801",
                    "speaker": "Player",
                    "text": "光明来自太阳之后…"
                },
                {
                    "id": "722391802",
                    "speaker": "阿多尼斯",
                    "text": "什么和什么啊，赶紧走开！"
                }
            ]
        },
        {
            "id": "7223919",
            "objective": "",
            "dialogues": [
                {
                    "id": "722391001",
                    "speaker": "派蒙",
                    "text": "龙骨花凝珠就是这个吗，看起来就很一般般嘛…"
                },
                {
                    "id": "722391002",
                    "speaker": "派蒙",
                    "text": "怎么也不像说的那么神奇，感觉没什么用的样子，真的能卖钱吗？"
                },
                {
                    "id": "722391003",
                    "speaker": "派蒙",
                    "text": "我们要不去各地的商店问问吧？他们比较有见识，像蒙德的荣光之风、璃月的希古居，还有稻妻的根付之源…"
                },
                {
                    "id": "722391004",
                    "speaker": "派蒙",
                    "text": "希望能换点钱来买好吃的…"
                }
            ]
        },
        {
