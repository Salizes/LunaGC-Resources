    "talks": [
        {
            "id": "101401",
            "objective": "与萍姥姥对话",
            "dialogues": [
                {
                    "id": "10140101",
                    "speaker": "萍姥姥",
                    "text": "世事无常，世事无常…",
                    "choices": [
                        {
                            "id": "10140102",
                            "text": "您好。",
                            "response": [
                                {
                                    "id": "10140103",
                                    "speaker": "萍姥姥",
                                    "text": "咦？年轻人，你是来赏花的吗？"
                                },
                                {
                                    "id": "10140104",
                                    "speaker": "萍姥姥",
                                    "text": "可惜啊，你来得不是时候，这「琉璃百合」，都要谢完了…"
                                },
                                {
                                    "id": "10140107",
                                    "speaker": "派蒙",
                                    "text": "这些花…为什么都谢了呀？"
                                },
                                {
                                    "id": "10140108",
                                    "speaker": "萍姥姥",
                                    "text": "在我那个年头，人们说「琉璃百合」通人性。"
                                },
                                {
                                    "id": "10140109",
                                    "speaker": "萍姥姥",
                                    "text": "如果它们听见了好声音，比如笑声啦，歌声啦…它们就会很高兴，会长得很好。"
                                },
                                {
                                    "id": "10140110",
                                    "speaker": "萍姥姥",
                                    "text": "但如果反过来，听了太多不好的声音…比如乱七八糟的流言蜚语，它们就会枯萎得很快。"
                                },
                                {
                                    "id": "10140111",
                                    "speaker": "派蒙",
                                    "text": "…所以，现在璃月港里的状况，这些花也感觉到了呀。"
                                },
                                {
                                    "id": "10140112",
                                    "speaker": "萍姥姥",
                                    "text": "是啊，岩王帝君之死的传言，可不是小事。这大街小巷里，说什么的都有。"
                                },
                                {
                                    "id": "10140113",
                                    "speaker": "萍姥姥",
                                    "text": "有人说是愚人众的阴谋，有人说是「海里的东西」要镇不住了，还有人说，这些都是七星自导自演的…"
                                },
                                {
                                    "id": "10140114",
                                    "speaker": "萍姥姥",
                                    "text": "这座港口，就和柴火堆一样。只要一点火星，火就要止不住了。"
                                },
                                {
                                    "id": "10140115",
                                    "speaker": "萍姥姥",
                                    "text": "唉，话头就到这打住吧，我老婆子年纪大了，就喜欢唠叨…年轻人，你们找我有什么事吗？",
                                    "choices": [
                                        {
                                            "id": "10140116",
                                            "text": "想借您的「涤尘铃」",
                                            "response": [
                                                {
                                                    "id": "10140117",
                                                    "speaker": "萍姥姥",
                                                    "text": "喔，那个老物件啊…我记得。确实在我这，但是具体放在哪…我老婆子就记不清啦。"
                                                },
                                                {
                                                    "id": "10140118",
                                                    "speaker": "萍姥姥",
                                                    "text": "那是我年轻的时候，一个老朋友身上戴着的小玩意…"
                                                },
                                                {
                                                    "id": "10140119",
                                                    "speaker": "萍姥姥",
                                                    "text": "他看我老是眼巴巴地看着，就把铃铛送给我了。"
                                                },
                                                {
                                                    "id": "10140120",
                                                    "speaker": "萍姥姥",
                                                    "text": "但他当年就和我说，假如以后有人来借这个铃铛，我可不能舍不得。"
                                                },
                                                {
                                                    "id": "10140127",
                                                    "speaker": "萍姥姥",
                                                    "text": "这么多年了，这铃铛也不知道被借走了多少次。"
                                                },
                                                {
                                                    "id": "10140128",
                                                    "speaker": "萍姥姥",
                                                    "text": "但是，不知道从什么时候开始，已经很久没人再来借这个铃铛啦…"
                                                },
                                                {
                                                    "id": "10140129",
                                                    "speaker": "萍姥姥",
                                                    "text": "唉，我这个老身子骨，找起东西来慢吞吞的，你们怕是等不得哟…",
                                                    "choices": [
                                                        {
                                                            "id": "10140130",
                                                            "text": "我们自己来找就好。",
                                                            "response": [
                                                                {
                                                                    "id": "10140131",
                                                                    "speaker": "派蒙",
                                                                    "text": "对，婆婆，我们陪您回家，然后我们自己来找。"
                                                                },
                                                                {
                                                                    "id": "10140132",
                                                                    "speaker": "派蒙",
                                                                    "text": "还能…还能帮您收拾屋子呢。"
                                                                },
                                                                {
                                                                    "id": "10140135",
                                                                    "speaker": "萍姥姥",
                                                                    "text": "好啦，孩子们，那个铃铛我也没有放多远，你们也别太操心了。"
                                                                },
                                                                {
                                                                    "id": "10140136",
                                                                    "speaker": "派蒙",
                                                                    "text": "咦？婆婆，您家就在这附近吗？呜哇…这可是玉京台呀，真有钱…"
                                                                },
                                                                {
                                                                    "id": "10140137",
                                                                    "speaker": "萍姥姥",
                                                                    "text": "呵呵，我老婆子可置办不起城里的房子——看看这个壶，我的全部家当都放在里面啦。"
                                                                },
                                                                {
                                                                    "id": "10140138",
                                                                    "speaker": "派蒙",
                                                                    "text": "全部家当…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "10140139",
                                                                            "text": "您是指，把屋子钥匙放里面了？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "10140146",
                                                                                    "speaker": "萍姥姥",
                                                                                    "text": "呵呵呵…孩子们，总之铃铛就放在这个壶里。想找铃铛的话，就自己去看看吧。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "10140140",
                                                                            "text": "您的家当就一个铃铛吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "10140141",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "这么说很不礼貌！"
                                                                                },
                                                                                {
                                                                                    "id": "10140142",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "就，就算是这样，那…那也是个很珍贵的铃铛！对吧，婆婆？"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "10140143",
                                                                            "text": "派蒙进壶里看看吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "10140144",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "进不去！怎么想我都进不去吧？！"
                                                                                },
                                                                                {
                                                                                    "id": "10140145",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "而且你为什么要让我进去，掀开盖子看看不就好了吗！？"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "10140133",
                                                            "text": "我跟西风骑士团长学过找东西。",
                                                            "response": [
                                                                {
                                                                    "id": "10140134",
                                                                    "speaker": "派蒙",
                                                                    "text": "唔…突然在意外的地方自豪起来了？！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10140121",
                                            "text": "想找您借个东西…",
                                            "response": [
                                                {
                                                    "id": "10140122",
                                                    "speaker": "萍姥姥",
                                                    "text": "东西？喔…你们是要来借「涤尘铃」的吧？"
                                                },
                                                {
                                                    "id": "10140123",
                                                    "speaker": "萍姥姥",
                                                    "text": "除了这个老物件，我也没什么值得你们年轻人来求的了。"
                                                },
                                                {
                                                    "id": "10140124",
                                                    "speaker": "萍姥姥",
                                                    "text": "不过，这铃铛本来也不是我的，本来是我一个老朋友戴着的小玩意。"
                                                },
                                                {
                                                    "id": "10140125",
                                                    "speaker": "萍姥姥",
                                                    "text": "我年轻的时候爱漂亮，喜欢那个铃铛，所以就黏着他，一个劲地央求…"
                                                },
                                                {
                                                    "id": "10140126",
                                                    "speaker": "萍姥姥",
                                                    "text": "他拗不过我，所以就把铃铛送给我了。不过他和我说，假如以后有人来借铃铛，我可不能舍不得。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10140105",
                            "text": "您怎么了？",
                            "response": [
                                {
                                    "id": "10140106",
                                    "speaker": "萍姥姥",
                                    "text": "没事，没事，我只不过看见「琉璃百合」谢了太多，觉得太可惜了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "101406",
            "objective": "触碰萍姥姥的壶",
            "dialogues": [
                {
                    "id": "10140601",
                    "speaker": "触碰壶面",
                    "text": "（test）看向壶口"
                },
                {
                    "id": "10140602",
                    "speaker": "触碰壶面",
                    "text": "（test）进入大壶啦"
                }
            ]
        },
        {
            "id": "101402",
            "objective": "寻找涤尘铃",
            "dialogues": [
                {
                    "id": "10140201",
                    "speaker": "萍姥姥",
                    "text": "孩子们，你们不是急着要铃铛吗？还不快去找？"
                },
                {
                    "id": "10140202",
                    "speaker": "萍姥姥",
                    "text": "不过这壶我很久没打扫，你们可要当心了。"
                },
                {
                    "id": "10140203",
                    "speaker": "萍姥姥",
                    "text": "穿着这么漂亮的衣服，弄脏的话，洗干净可要花功夫喽。"
                }
            ]
        },
        {
            "id": "101405",
            "objective": "(test)寻找涤尘铃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "101408",
            "objective": "(test)寻找涤尘铃$HIDDEN",
            "dialogues": []
        },
        {
            "id": "101403",
            "objective": "与萍姥姥对话",
            "dialogues": [
                {
                    "id": "10140301",
                    "speaker": "萍姥姥",
                    "text": "年轻人手脚就是利索，这么一会，就拿到了…",
                    "choices": [
                        {
                            "id": "10140302",
                            "text": "您是仙人吗？",
                            "response": [
                                {
                                    "id": "10140303",
                                    "speaker": "萍姥姥",
                                    "text": "仙人…这两个字，我老婆子可很久没有听人正经提起了。"
                                },
                                {
                                    "id": "10140304",
                                    "speaker": "萍姥姥",
                                    "text": "至于我是不是仙人，孩子，你心里难道不明白吗？"
                                },
                                {
                                    "id": "10140312",
                                    "speaker": "派蒙",
                                    "text": "唔…好像懂了，又好像没全懂。不过婆婆，您…就这么把铃铛给我们了？"
                                },
                                {
                                    "id": "10140313",
                                    "speaker": "派蒙",
                                    "text": "您不奇怪吗？岩王帝君刚出事，我们就急匆匆地找您来要铃铛…"
                                },
                                {
                                    "id": "10140314",
                                    "speaker": "萍姥姥",
                                    "text": "傻孩子，璃月港古往今来，不知道有多少仙人离开，也不知道折腾出了多少风浪。"
                                },
                                {
                                    "id": "10140315",
                                    "speaker": "萍姥姥",
                                    "text": "但无论是哪一次，都是按规矩先把「送仙典仪」办体面了，再去安排后面的事。"
                                },
                                {
                                    "id": "10140316",
                                    "speaker": "萍姥姥",
                                    "text": "一个劲地喊着「抓凶手」，却耽误了「送仙典仪」，在我看来，才是本末倒置。"
                                },
                                {
                                    "id": "10140317",
                                    "speaker": "萍姥姥",
                                    "text": "现在你们来借铃铛，我揣摩着，大概是哪位老朋友终于看不过眼，出来主持大局了吧。"
                                },
                                {
                                    "id": "10140318",
                                    "speaker": "萍姥姥",
                                    "text": "所以，我又怎么会不肯借铃铛给你们呢？",
                                    "choices": [
                                        {
                                            "id": "10140319",
                                            "text": "要是您的「老朋友」借了不还呢？",
                                            "response": [
                                                {
                                                    "id": "10140320",
                                                    "speaker": "萍姥姥",
                                                    "text": "不还？哈哈哈，要是他们真腆着脸这么干了，那我老婆子说不得就要走一趟了。"
                                                },
                                                {
                                                    "id": "10140321",
                                                    "speaker": "萍姥姥",
                                                    "text": "正好很久没见，去找他们喝喝茶，聊聊天，也是很好的。"
                                                },
                                                {
                                                    "id": "10140326",
                                                    "speaker": "萍姥姥",
                                                    "text": "好了，既然拿到了东西，就快点回去吧，可别误事了。"
                                                },
                                                {
                                                    "id": "10140327",
                                                    "speaker": "萍姥姥",
                                                    "text": "再帮我给那位差遣你们的人带句话，就说…"
                                                },
                                                {
                                                    "id": "10140328",
                                                    "speaker": "萍姥姥",
                                                    "text": "有空的话，过来喝喝茶也是可以的。老婆子我没什么家当，但总归还是有盏茶壶的。"
                                                },
                                                {
                                                    "id": "10140329",
                                                    "speaker": "派蒙",
                                                    "text": "嗯！我们记住啦，谢谢婆婆！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "10140322",
                                            "text": "这铃铛能送我吗？",
                                            "response": [
                                                {
                                                    "id": "10140323",
                                                    "speaker": "派蒙",
                                                    "text": "喂！你这个人，这可是婆婆的东西呀！用完了就要还给人家！"
                                                },
                                                {
                                                    "id": "10140324",
                                                    "speaker": "萍姥姥",
                                                    "text": "送你？你这孩子还真直白，哈哈哈，你想拿就拿着吧。"
                                                },
                                                {
                                                    "id": "10140325",
                                                    "speaker": "萍姥姥",
                                                    "text": "不过这铃铛很恋家，指不定什么时候啊，它就溜回我老婆子这来咯。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "10140305",
                            "text": "您是「璃月七星」的人吧。",
                            "response": [
                                {
                                    "id": "10140306",
                                    "speaker": "萍姥姥",
                                    "text": "「璃月七星」…那些孩子，很久之前就不愿意让我这老婆子…还有我的老伙计们…去帮工喽。"
                                },
                                {
                                    "id": "10140307",
                                    "speaker": "萍姥姥",
                                    "text": "不过，这些年他们做得也不错。我们这些老家伙，也乐得个清闲。"
                                }
                            ]
                        },
                        {
                            "id": "10140308",
                            "text": "难道您是愚人众的…",
                            "response": [
                                {
                                    "id": "10140309",
                                    "speaker": "萍姥姥",
                                    "text": "愚人众？哈哈哈，你这孩子，心思倒是多得很，成天都在想些什么歪门故事？"
                                },
                                {
                                    "id": "10140310",
                                    "speaker": "萍姥姥",
                                    "text": "我老婆子一把年纪了，可懒得和这些外人折腾。"
                                },
                                {
                                    "id": "10140311",
                                    "speaker": "萍姥姥",
                                    "text": "不过，他们的手要是再伸长一点，该劳碌的，还是要劳碌的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "id": "101404",
            "objective": "放置香膏和涤尘铃",
            "dialogues": [
                {
                    "id": "10140401",
                    "speaker": "钟离",
                    "text": "不错，这正是「涤尘铃」…嗯，保管得还真不错。"
                },
                {
                    "id": "10140402",
                    "speaker": "钟离",
                    "text": "我们顺便把之前做好的香膏也安放了吧。",
                    "choices": [
                        {
                            "id": "10140403",
                            "text": "你认识萍姥姥？",
                            "response": [
                                {
                                    "id": "10140404",
                                    "speaker": "钟离",
                                    "text": "自然是认识的，不然我怎么会知道，这枚铃铛在她那？"
                                },
                                {
                                    "id": "10140407",
                                    "speaker": "派蒙",
                                    "text": "嗯…疑点重重！但你不想说的话，我们也就先不追问了吧。"
                                },
                                {
                                    "id": "10140408",
                                    "speaker": "派蒙",
                                    "text": "对了，那位婆婆让我们带句话给你。"
                                },
                                {
                                    "id": "10140409",
                                    "speaker": "派蒙",
                                    "text": "「有空的话，过来喝喝茶也是可以的。老婆子我没什么家当，但总归还是有盏茶壶的。」"
                                },
                                {
                                    "id": "10140410",
                                    "speaker": "钟离",
                                    "text": "哈哈哈，这语气可不太适合你。不过，她的茶壶确实很不错，用来泡茶再好不过了。"
                                },
                                {
                                    "id": "10140411",
                                    "speaker": "钟离",
                                    "text": "等到了合适的时候，我自然会带着好茶…去见她的。"
                                },
                                {
                                    "id": "10140412",
                                    "speaker": "派蒙",
                                    "text": "那么，仪式下一项准备，该是什么了？"
                                },
                                {
                                    "id": "10140413",
                                    "speaker": "钟离",
