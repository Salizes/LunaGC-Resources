            "dialogues": [
                {
                    "id": "700470101",
                    "speaker": "阿乔",
                    "text": "喂，基尼奇，快看谁来了。"
                },
                {
                    "id": "700470102",
                    "speaker": "阿乔",
                    "text": "#{NICKNAME}，伟大圣龙库胡勒阿乔在此，速速前来觐见！"
                },
                {
                    "id": "700470103",
                    "speaker": "基尼奇",
                    "text": "#又在这儿碰上了，{NICKNAME}。"
                },
                {
                    "id": "700470104",
                    "speaker": "Player",
                    "text": "你们好。"
                },
                {
                    "id": "700470105",
                    "speaker": "阿乔",
                    "text": "我不好！这个闷葫芦在这儿盯着一堆五颜六色的纸壳子看了半天，也太无聊了。"
                },
                {
                    "id": "700470106",
                    "speaker": "基尼奇",
                    "text": "这儿的装饰布置得挺有意思，看起来像是纸板做的。",
                    "choices": [
                        {
                            "id": "700470107",
                            "text": "基尼奇喜欢这里的布置？",
                            "response": [
                                {
                                    "id": "700470109",
                                    "speaker": "基尼奇",
                                    "text": "是有点兴趣，感觉这纸板还挺适合作为阿乔的家。"
                                },
                                {
                                    "id": "700470110",
                                    "speaker": "阿乔",
                                    "text": "你什么意思？你说我是纸片龙？"
                                },
                                {
                                    "id": "700470111",
                                    "speaker": "Player",
                                    "text": "阿乔的确经常住进箱子里。"
                                },
                                {
                                    "id": "700470112",
                                    "speaker": "阿乔",
                                    "text": "你…！你们！好啊，等到见识圣龙库胡勒阿乔俊伟真容的那天，你们别后悔！"
                                },
                                {
                                    "id": "700470113",
                                    "speaker": "基尼奇",
                                    "text": "那可要先把你纸片龙的姿态记录下来了。"
                                },
                                {
                                    "id": "700470114",
                                    "speaker": "基尼奇",
                                    "text": "#{NICKNAME}，我看到你带了留影机，能帮我给这个纸剧场拍一张吗？"
                                },
                                {
                                    "id": "700470115",
                                    "speaker": "Player",
                                    "text": "顺便也给基尼奇拍一张吧。"
                                },
                                {
                                    "id": "700470116",
                                    "speaker": "基尼奇",
                                    "text": "也好，就当是来度假的纪念了。"
                                },
                                {
                                    "id": "700470117",
                                    "speaker": "基尼奇",
                                    "text": "对了，你对我们的入镜姿势有什么想法吗？",
