        {
            "id": "1104109",
            "objective": "利用「元素视野」跟随阿贝多的足迹",
            "dialogues": []
        },
        {
            "id": "1104103",
            "objective": "利用「元素视野」跟随阿贝多的足迹",
            "dialogues": []
        },
        {
            "id": "1104104",
            "objective": "抵达阿贝多所在地",
            "dialogues": [
                {
                    "id": "110410401",
                    "speaker": "派蒙",
                    "text": "那就是阿贝多吗？为什么他会待在这种地方？"
                },
                {
                    "id": "110410402",
                    "speaker": "罗莎莉亚",
                    "text": "听说阿贝多他很喜欢画画，在什么地方写生都不奇怪。"
                },
                {
                    "id": "110410403",
                    "speaker": "罗莎莉亚",
                    "text": "这里视野很好，风景也不错，无论是远景还是近景都值得描绘。"
                },
                {
                    "id": "110410404",
                    "speaker": "派蒙",
                    "text": "但…他有注意到这些丘丘人吗？会不会被突然攻击？"
                },
                {
                    "id": "110410405",
                    "speaker": "派蒙",
                    "text": "呜哇？！"
                }
            ]
        },
        {
            "id": "1104105",
            "objective": "击败被惊动的丘丘人",
            "dialogues": []
        },
        {
            "id": "1104106",
            "objective": "与阿贝多交谈",
            "dialogues": [
                {
                    "id": "110410601",
                    "speaker": "阿贝多",
                    "text": "你们是谁？为什么要惊扰它们？"
                },
                {
                    "id": "110410602",
                    "speaker": "阿贝多",
                    "text": "幸好我的画已经完成，要是没能为特别的丘丘人收尾，就太可惜了。",
                    "choices": [
                        {
                            "id": "110410603",
                            "text": "原来你在画丘丘人。",
                            "response": [
                                {
                                    "id": "110410605",
                                    "speaker": "派蒙",
                                    "text": "不过，丘丘人有什么好画的，不都长得差不多吗？"
                                },
                                {
                                    "id": "110410606",
                                    "speaker": "阿贝多",
                                    "text": "嗯…这个问题解释起来比较复杂，不如请你们直接看看我的画吧。",
                                    "choices": [
                                        {
                                            "id": "110410607",
                                            "text": "这…",
                                            "response": [
                                                {
                                                    "id": "110410609",
                                                    "speaker": "派蒙",
                                                    "text": "哇，有画得特别认真的，但是，也有一看就非常敷衍的。"
                                                },
                                                {
                                                    "id": "110410610",
                                                    "speaker": "阿贝多",
                                                    "text": "那些都是随处可见的丘丘人，很无聊，不值得浪费时间。"
                                                },
                                                {
                                                    "id": "110410611",
                                                    "speaker": "阿贝多",
                                                    "text": "但你看这一只，它的体格，它的毛发，它的姿态，你能看到它与众不同的生命张力。"
                                                },
                                                {
                                                    "id": "110410612",
                                                    "speaker": "阿贝多",
                                                    "text": "在原始族群周而复始的生活中，这种特殊性代表了进化。进化，即是从无到有，从已知到未知…"
                                                },
                                                {
                                                    "id": "110410613",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "稍等稍等，我有预感会是一篇长篇大论，我可没什么兴趣。"
                                                },
                                                {
                                                    "id": "110410614",
                                                    "speaker": "罗莎莉亚",
                                                    "text": "既然找到了人，我就先走了。"
                                                },
                                                {
                                                    "id": "110410615",
                                                    "speaker": "派蒙",
                                                    "text": "啊，你没有什么问题想问他吗？喂！"
                                                },
                                                {
                                                    "id": "110410616",
                                                    "speaker": "派蒙",
                                                    "text": "唉，好奇怪的一个人。"
                                                },
                                                {
                                                    "id": "110410617",
                                                    "speaker": "阿贝多",
                                                    "text": "没想到罗莎莉亚修女会为你们带路。嗯，没来得及向她道谢呢。"
                                                },
                                                {
                                                    "id": "110410618",
                                                    "speaker": "阿贝多",
                                                    "text": "话说回来，听她的意思，你们是专程来找我的？"
                                                },
                                                {
                                                    "id": "110410619",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，没错，我们在蒙德城里遇见了一个叫砂糖的女孩子，她说，你的研究陷入了瓶颈。"
                                                },
                                                {
                                                    "id": "110410620",
                                                    "speaker": "阿贝多",
                                                    "text": "原来如此，是她把你们介绍过来的啊…"
                                                },
                                                {
                                                    "id": "110410621",
                                                    "speaker": "阿贝多",
                                                    "text": "那么，我没猜错的话，你就是最近蒙德城里都在议论的那位「荣誉骑士」吧。"
                                                },
                                                {
                                                    "id": "110410622",
                                                    "speaker": "阿贝多",
                                                    "text": "你在龙灾中的表现、你对于元素力的异常掌控，还有诸多神秘之处，我都有所耳闻…"
                                                },
                                                {
                                                    "id": "110410623",
                                                    "speaker": "阿贝多",
                                                    "text": "直接说结论吧，可能性只有一种——你是从「另一个世界」远道而来，对吗？",
                                                    "choices": [
                                                        {
                                                            "id": "110410624",
                                                            "text": "嗯，没错。",
                                                            "response": [
                                                                {
                                                                    "id": "110410626",
                                                                    "speaker": "阿贝多",
                                                                    "text": "太棒了。如果能得到你的协助，我的研究一定可以取得很大的进展。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "110410627",
                                                                            "text": "你的研究？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "110410629",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "啊，抱歉，想必你现在一定很疑惑吧。从哪里开始解释比较好呢…唔，先讲讲生命的本质？"
                                                                                },
                                                                                {
                                                                                    "id": "110410630",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "等下等下，这已经很抽象了！"
                                                                                },
                                                                                {
                                                                                    "id": "110410631",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "唔…有道理，比起语言解释，还是让你们看到点什么比较好。"
                                                                                },
                                                                                {
                                                                                    "id": "110410632",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "比如，唤醒生命，让枯枝获得「新生」。"
                                                                                },
                                                                                {
                                                                                    "id": "110410634",
                                                                                    "speaker": "派蒙",
                                                                                    "text": "居然能做到这种事？！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "110410635",
                                                                                            "text": "炼金术真是神奇。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "110410637",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "可是…我有一颗特殊的种子。刚刚用的办法，在那个种子上就不奏效了。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410639",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "它和你一样，是从另一个世界来的——如何让它生长并盛开，就是我现在遇到的瓶颈，也是需要你协助的研究内容。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410640",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "你都做不到的事，那我们也帮不上忙吧。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410641",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "当然可以，因为就算是我，也无法想象这个世界以外的生命形式。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410642",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "但只要认真观察研究同是来自异世界的你，说不定就能让我找到让种子发芽的灵感。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410643",
                                                                                                    "speaker": "Player",
                                                                                                    "text": "原来我是「被研究对象」？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "110410644",
                                                                                                    "speaker": "派蒙",
                                                                                                    "text": "#怎、怎么办，{NICKNAME}？我觉得听起来有点奇怪…",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "110410645",
                                                                                                            "text": "有什么危险吗？",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "110410646",
                                                                                                                    "speaker": "阿贝多",
                                                                                                                    "text": "可能会有，但我会尽最大努力保障你的安全。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110410649",
                                                                                                                    "speaker": "阿贝多",
                                                                                                                    "text": "事不宜迟，我们先换个地方，赶紧开始研究吧。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110410650",
                                                                                                                    "speaker": "罗莎莉亚",
                                                                                                                    "text": "(test)镜头转到远处的罗莎莉亚，对话不中断"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110410651",
                                                                                                                    "speaker": "罗莎莉亚",
                                                                                                                    "text": "阿贝多，还有那个旅行者，好像一拍即合。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "110410652",
                                                                                                                    "speaker": "罗莎莉亚",
                                                                                                                    "text": "这两个人，都是「异类」。蒙德的平稳延续…会被这样的变量影响吗？"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "110410647",
                                                                                                            "text": "有什么报酬吗？",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "110410648",
                                                                                                                    "speaker": "阿贝多",
                                                                                                                    "text": "摩拉，知识，以及你想知道的，又是我知道的答案，这样没问题吧。"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "110410636",
                                                                                            "text": "炼金术真是方便。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "110410628",
                                                                            "text": "我不是很明白。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "110410625",
                                                            "text": "你的学识果然名不虚传。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "110410608",
                                            "text": "这就是前卫艺术吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "110410604",
                            "text": "还以为是风景画。"
                        }
                    ]
                }
            ]
        }
    ]
}