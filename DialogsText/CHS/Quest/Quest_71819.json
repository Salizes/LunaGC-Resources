    "talks": [
        {
            "id": "7181910",
            "objective": "与望雅对话$HIDDEN",
            "dialogues": [
                {
                    "id": "718191001",
                    "speaker": "蔡乐",
                    "text": "还好那个霄灯被树给挂住了，要是再飞高点，那就真拿不到了…"
                }
            ]
        },
        {
            "id": "7181901",
            "objective": "与望雅对话",
            "dialogues": [
                {
                    "id": "718190101",
                    "speaker": "望雅",
                    "text": "唉…事情真是做不完…"
                },
                {
                    "id": "718190102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "718190103",
                    "speaker": "望雅",
                    "text": "没事，我正在梳理海灯节期间要处理的事呢。"
                },
                {
                    "id": "718190104",
                    "speaker": "望雅",
                    "text": "只不过…越梳理越多…"
                },
                {
                    "id": "718190105",
                    "speaker": "望雅",
                    "text": "虽然其他同事帮我分担了一部分，但今年轮到我带队去送霄灯，得快点准备好东西才行…",
                    "choices": [
                        {
                            "id": "718190106",
                            "text": "送霄灯？",
                            "response": [
                                {
                                    "id": "718190108",
                                    "speaker": "望雅",
                                    "text": "对喔…你应该不知道，我说的「送霄灯」不是你想的那种，普通地把霄灯送给别人。"
                                },
                                {
                                    "id": "718190109",
                                    "speaker": "望雅",
                                    "text": "简单来说…应该更像是送去节日的祝福啦，氛围啦之类的…"
                                },
                                {
                                    "id": "718190110",
                                    "speaker": "望雅",
                                    "text": "比如，海灯节期间，虽然大部分人都回家过节了，一般的店铺也会休假…"
                                },
                                {
                                    "id": "718190111",
                                    "speaker": "望雅",
                                    "text": "但为了维持节日里的秩序，还有处理一些事务，还有一部分千岩军会继续在节日期间值班。"
                                },
                                {
                                    "id": "718190112",
                                    "speaker": "望雅",
                                    "text": "总务司在海灯节期间一般也会安排人去给他们送些礼品去…"
                                },
                                {
                                    "id": "718190113",
                                    "speaker": "望雅",
                                    "text": "我今天就正准备去给负责城里守卫的千岩军们「送霄灯」呢。"
                                },
                                {
                                    "id": "718190114",
                                    "speaker": "望雅",
                                    "text": "不过…我带的人也不太够了，有些礼品送出去了，但还有些没送出去…"
                                },
                                {
                                    "id": "718190115",
                                    "speaker": "望雅",
                                    "text": "旅行者，你能帮我把这些礼物送过去吗？"
                                },
                                {
                                    "id": "718190116",
                                    "speaker": "Player",
                                    "text": "交给我吧。"
                                },
                                {
                                    "id": "718190117",
                                    "speaker": "望雅",
                                    "text": "你愿意帮忙吗？那太好了，就拜托你了。"
                                },
                                {
                                    "id": "718190118",
                                    "speaker": "Player",
                                    "text": "要送给谁？"
                                },
                                {
                                    "id": "718190119",
                                    "speaker": "望雅",
                                    "text": "我看看…还有没送到的千岩军是…"
                                },
                                {
                                    "id": "718190120",
                                    "speaker": "望雅",
                                    "text": "向明…弘毅…还有蔡乐。"
                                },
                                {
                                    "id": "718190121",
                                    "speaker": "望雅",
                                    "text": "我把他们的位置标记给你，就拜托你了。"
                                }
                            ]
                        },
                        {
                            "id": "718190107",
                            "text": "是要送很多人吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181902",
            "objective": "将礼品送给向明",
            "dialogues": [
                {
                    "id": "718190201",
                    "speaker": "向明",
                    "text": "嗯？你有什么事，我在执行任务…"
                },
                {
                    "id": "718190202",
                    "speaker": "Player",
                    "text": "关于海灯节礼品。"
                },
                {
                    "id": "718190203",
                    "speaker": "向明",
                    "text": "小声点！我在执行任务呢，什么礼品？"
                },
                {
                    "id": "718190204",
                    "speaker": "向明",
                    "text": "是总务司要你送来的？哦…"
                },
                {
                    "id": "718190205",
                    "speaker": "向明",
                    "text": "唉，又是一年海灯节了，本来今年我还想早点回家的…"
                },
                {
                    "id": "718190206",
                    "speaker": "向明",
                    "text": "可是看现在这状况，我可不敢放松…估计我又得晚几天回家了…"
                },
                {
                    "id": "718190207",
                    "speaker": "向明",
                    "text": "谢谢你跑这一趟，这个我就收下了，辛苦你了。"
                },
                {
                    "id": "718190208",
                    "speaker": "向明",
                    "text": "唉，那家伙到底什么时候走啊…"
                }
            ]
        },
        {
            "id": "7181903",
            "objective": "将礼品送给弘毅",
            "dialogues": [
                {
                    "id": "718190301",
                    "speaker": "弘毅",
                    "text": "这井水到底是怎么回事…"
                },
                {
                    "id": "718190302",
                    "speaker": "Player",
                    "text": "关于海灯节礼品。"
                },
                {
                    "id": "718190303",
                    "speaker": "弘毅",
                    "text": "噢，这是总务司送过来的吧。谢啦，我就收下了。"
                },
                {
                    "id": "718190304",
                    "speaker": "弘毅",
                    "text": "不过，我还得接着在这执勤一段时间，免得有居民在节日期间过来取水。"
                },
                {
                    "id": "718190305",
                    "speaker": "弘毅",
                    "text": "唉，这井水也不知道是怎么回事…但总之，肯定是喝不得了…"
                }
            ]
        },
        {
            "id": "7181904",
            "objective": "将礼品送给蔡乐",
            "dialogues": [
                {
                    "id": "718190401",
                    "speaker": "一弦",
                    "text": "呜呜…我，我还没写好愿望呢…呜…"
                },
                {
                    "id": "718190402",
                    "speaker": "一柱",
                    "text": "弦儿乖，千岩军叔叔去已经帮你拿了…"
                },
                {
                    "id": "718190403",
                    "speaker": "Player",
                    "text": "关于蔡乐…"
                },
                {
                    "id": "718190404",
                    "speaker": "一柱",
                    "text": "你是在找那位千岩军叔叔吗？"
                },
                {
                    "id": "718190405",
                    "speaker": "一柱",
                    "text": "刚才弦儿在霄灯上写愿望的时候，不小心把霄灯放飞了，一直往那边飞了…"
                },
                {
                    "id": "718190406",
                    "speaker": "一柱",
                    "text": "那位千岩军叔叔说，他看见霄灯挂在了树上，他去那边帮我们拿霄灯了…",
                    "choices": [
                        {
                            "id": "718190407",
                            "text": "那盏霄灯很特别吗？",
                            "response": [
                                {
                                    "id": "718190409",
                                    "speaker": "一柱",
                                    "text": "我是这么和弦儿说的，但是她…"
                                },
                                {
                                    "id": "718190410",
                                    "speaker": "一弦",
                                    "text": "呜…不…不嘛，那是哥哥做给我的，哥哥做了好久才做好的…"
                                },
                                {
                                    "id": "718190411",
                                    "speaker": "一柱",
                                    "text": "弦儿乖，千岩军叔叔很快就回来了…"
                                },
                                {
                                    "id": "718190412",
                                    "speaker": "一柱",
                                    "text": "抱歉，如果你急着找那位千岩军叔叔的话，可以去那边找找看。"
                                }
                            ]
                        },
                        {
                            "id": "718190408",
                            "text": "不能重新做一盏吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181905",
            "objective": "向一弦与一柱询问蔡乐的去向",
            "dialogues": []
        },
        {
            "id": "7181906",
            "objective": "寻找蔡乐",
            "dialogues": [
                {
                    "id": "718190501",
                    "speaker": "蔡乐",
                    "text": "哎…这怎么上去呢，唔…不然还是换个法子…"
                },
                {
                    "id": "718190502",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "718190503",
                    "speaker": "蔡乐",
                    "text": "旅行者？哈哈，没事没事，我正在想着怎么爬上去把那盏霄灯拿下来呢。"
                },
                {
                    "id": "718190504",
                    "speaker": "蔡乐",
                    "text": "不过这树也太难爬了，我这一身的甲胄，爬一半就滑下来了…"
                },
                {
                    "id": "718190505",
                    "speaker": "蔡乐",
                    "text": "呃…旅行者，如果你愿意的话，能不能帮我上去把那盏霄灯给取下来？"
                },
                {
                    "id": "718190506",
                    "speaker": "Player",
                    "text": "交给我吧。"
                },
                {
                    "id": "718190507",
                    "speaker": "蔡乐",
                    "text": "行，那就拜托你了，那孩子都急哭了，可得快点把霄灯拿回来。"
                }
            ]
        },
        {
            "id": "7181907",
            "objective": "爬上树取下霄灯",
            "dialogues": [
                {
                    "id": "718190701",
                    "speaker": "望雅",
                    "text": "你回来了，礼品发的怎么样了？"
                },
                {
                    "id": "718190702",
                    "speaker": "Player",
                    "text": "都发给对应的人了。"
                },
                {
                    "id": "718190703",
                    "speaker": "望雅",
                    "text": "谢谢，实在是帮大忙了…没有你的话，我肯定忙不过来。"
                },
                {
                    "id": "718190704",
                    "speaker": "Player",
                    "text": "他们整个节日里都不会放假吗？"
                },
                {
                    "id": "718190705",
                    "speaker": "望雅",
                    "text": "这个…唉，虽然总务司也会安排千岩军们交替值班…"
                },
                {
                    "id": "718190706",
                    "speaker": "望雅",
                    "text": "但璃月实在是太大了，需要驻守和巡逻的地方也太多了。"
                },
                {
                    "id": "718190707",
                    "speaker": "望雅",
                    "text": "就算是交替值班，人手也总是不够，总会有人不得不在节日期间值班。"
                },
                {
                    "id": "718190708",
                    "speaker": "望雅",
                    "text": "而且因为每年的海灯节都很盛大，所以在节日期间，有的地方工作压力反而会更大，无论怎么分配人手都不足…",
                    "choices": [
                        {
                            "id": "718190709",
                            "text": "那真是辛苦了…",
                            "response": [
                                {
                                    "id": "718190711",
                                    "speaker": "望雅",
                                    "text": "没有啦，没有，这是我们应该做的…只要海灯节一切顺利就好。"
                                },
                                {
                                    "id": "718190712",
                                    "speaker": "望雅",
                                    "text": "对了，在海灯节期间，其实还有很多人需要帮助，如果你愿意的话，可以多多去帮忙。"
                                },
                                {
                                    "id": "718190713",
                                    "speaker": "望雅",
                                    "text": "如果能让更多的人能参与到「海灯节」中来，节日的氛围也肯定会更加红火吧。"
                                },
                                {
                                    "id": "718190714",
                                    "speaker": "望雅",
                                    "text": "我们之所以会「送霄灯」，也是希望每个人都能放出一盏霄灯，许出自己的心愿。"
                                },
                                {
                                    "id": "718190715",
                                    "speaker": "望雅",
                                    "text": "如果再说得宽泛点…就是把「海灯节」带去四面八方，让所有人都能感受到海灯节的氛围。"
                                },
                                {
                                    "id": "718190716",
                                    "speaker": "望雅",
                                    "text": "毕竟，海灯节可是所有人的节日啊。"
                                },
                                {
                                    "id": "718190717",
                                    "speaker": "望雅",
                                    "text": "好啦，我还要有事情要做，就先去忙了，祝你在海灯节上玩得开心。"
                                }
                            ]
                        },
                        {
                            "id": "718190710",
                            "text": "辛苦你们了。"
                        }
                    ]
                }
            ]
        },
        {
            "id": "7181908",
            "objective": "与蔡乐对话",
            "dialogues": [
                {
                    "id": "718190601",
                    "speaker": "蔡乐",
                    "text": "怎么样，你拿到霄灯了吗？"
                },
                {
                    "id": "718190602",
                    "speaker": "Player",
                    "text": "拿到了。"
                },
                {
                    "id": "718190603",
                    "speaker": "蔡乐",
                    "text": "我看看…对，就是这盏，谢谢你啊，我这就把霄灯给他们带回去。"
                },
                {
                    "id": "718190604",
                    "speaker": "蔡乐",
                    "text": "这么长时间了，也不知道那两个孩子是不是还待在原地…"
                },
                {
                    "id": "718190605",
                    "speaker": "Player",
                    "text": "关于礼品…"
                },
                {
                    "id": "718190606",
                    "speaker": "蔡乐",
                    "text": "这是总务司送的吧，行，我收下了，谢谢你跑这么一趟啊。"
                },
                {
                    "id": "718190607",
                    "speaker": "Player",
                    "text": "这也是千岩军的职责吗？"
                },
                {
                    "id": "718190608",
                    "speaker": "蔡乐",
                    "text": "你说帮忙摘霄灯吗？哈哈哈，当然算了。"
                },
                {
                    "id": "718190609",
                    "speaker": "蔡乐",
                    "text": "不管是摘霄灯，还是赶走不怀好心的人，或者是去击退魔物…"
                },
                {
                    "id": "718190610",
                    "speaker": "蔡乐",
                    "text": "帮助需要帮助的人，这就是千岩军的职责。"
                },
                {
                    "id": "718190611",
                    "speaker": "蔡乐",
                    "text": "好了，再次感谢你。我要赶紧把霄灯带给那两个孩子了。"
                },
                {
                    "id": "718190612",
                    "speaker": "蔡乐",
                    "text": "然后我还得接着去处理另外的事…"
                }
            ]
        },
        {
            "id": "7181909",
            "objective": "向望雅回报",
            "dialogues": []
        },
        {
            "id": "7181909",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718190901",
                    "speaker": "一弦",
                    "text": "我…呜呜…我愿望还没写完，会不会实现不了…"
                },
                {
                    "id": "718190902",
                    "speaker": "一柱",
                    "text": "不会的，真的不会的，弦儿乖…"
                }
            ]
        },
        {
            "id": "7181911",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "718191101",
                    "speaker": "望雅",
                    "text": "奇怪…蔡寻的送过去了，蔡乐的怎么没送过去…"
                },
                {
                    "id": "718191102",
                    "speaker": "望雅",
                    "text": "唉，准是送礼品的人又疏漏了…"
                }
            ]
        }
    ]
}