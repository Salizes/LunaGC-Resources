    "talks": [
        {
            "id": "2230601",
            "objective": "与张顺对话",
            "dialogues": [
                {
                    "id": "223060101",
                    "speaker": "张顺",
                    "text": "这可怎么办…"
                },
                {
                    "id": "223060102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "223060103",
                    "speaker": "张顺",
                    "text": "我之前是南十字船队的水手，但是有次运气不好，受了伤…"
                },
                {
                    "id": "223060104",
                    "speaker": "张顺",
                    "text": "退出船队之后，为了筹钱生活，我把几张藏宝图押给了一个叫博来的生意人。"
                },
                {
                    "id": "223060105",
                    "speaker": "张顺",
                    "text": "如果真有宝藏，他也会匀我一份，但是一直没什么消息，我觉得他压根没有去找…"
                },
                {
                    "id": "223060106",
                    "speaker": "张顺",
                    "text": "老是这样也不是个办法，你愿意帮我去找找宝藏吗？",
                    "choices": [
                        {
                            "id": "223060107",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "223060108",
                                    "speaker": "张顺",
                                    "text": "那就拜托你了。"
                                },
                                {
                                    "id": "223060120",
                                    "speaker": "张顺",
                                    "text": "你先去<color=#00E1FFFF>博来</color>那拿<color=#00E1FFFF>藏宝图</color>吧，然后把<color=#00E1FFFF>宝藏</color>直接带回去<color=#00E1FFFF>给他</color>。"
                                },
                                {
                                    "id": "223060121",
                                    "speaker": "张顺",
                                    "text": "我已经和他说好了，他会把我的那一份留着的。"
                                }
                            ]
                        },
                        {
                            "id": "223060109",
                            "text": "为什么退出船队？",
                            "response": [
                                {
                                    "id": "223060110",
                                    "speaker": "张顺",
                                    "text": "我这个身子的情况我自己知道，随时可能旧伤复发，我可不想拖累船队，就自己退出了。"
                                },
                                {
                                    "id": "223060111",
                                    "speaker": "张顺",
                                    "text": "然后，我用自己之前搜集的一些零碎，在这里做点小生意谋生。但是这生意也不好做啊，东西也快卖光了…"
                                },
                                {
                                    "id": "223060112",
                                    "speaker": "张顺",
                                    "text": "我本来还有几张藏宝图，也是之前跟船的时候拿到的战利品。"
                                },
                                {
                                    "id": "223060113",
                                    "speaker": "张顺",
                                    "text": "但是我这个破身子，走路都费劲，哪里还能去探险呢？"
                                },
                                {
                                    "id": "223060114",
                                    "speaker": "张顺",
                                    "text": "我就把那几张藏宝图押给了那个叫博来的，换了几个钱。"
                                },
                                {
                                    "id": "223060115",
                                    "speaker": "张顺",
                                    "text": "不过他大概也没办法亲自去寻宝吧，毕竟也就是个普通商人…所以，宝藏的事就拜托你了。",
                                    "choices": [
                                        {
                                            "id": "223060107",
                                            "text": "我知道了。"
                                        },
                                        {
                                            "id": "223060116",
                                            "text": "真有大宝藏吗？",
                                            "response": [
                                                {
                                                    "id": "223060117",
                                                    "speaker": "张顺",
                                                    "text": "哈哈哈，这应该是不可能的，这些藏宝图也是船队里分发的战利品。"
                                                },
                                                {
                                                    "id": "223060118",
                                                    "speaker": "张顺",
                                                    "text": "要真有大宝藏，船队里的好手早就解开线索，把宝藏拿回船了。"
                                                },
                                                {
                                                    "id": "223060119",
                                                    "speaker": "张顺",
                                                    "text": "但是，就算不是大宝藏，应该也多少能值点钱，至少三个人匀是够了…所以，宝藏就拜托你了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "223060116",
                            "text": "真有大宝藏吗？"
                        }
                    ]
                }
            ]
        },
        {
            "id": "2230602",
            "objective": "与博来对话",
            "dialogues": [
                {
                    "id": "223060801",
                    "speaker": "博来",
                    "text": "对了，您看得懂这藏宝图吗？"
                },
                {
                    "id": "223060802",
                    "speaker": "博来",
                    "text": "不瞒您说，我当初刚拿到的时候，请过几个人来瞅了几眼。"
                },
                {
                    "id": "223060803",
                    "speaker": "博来",
                    "text": "宝藏是在个什么地方，大致也已经摸清了。不过，他们说如果真要下手寻宝，我得另外加钱，所以我就没去寻…"
                },
                {
                    "id": "223060804",
                    "speaker": "博来",
                    "text": "要是觉得自己解麻烦，那您和我说一声，我马上给您把地方标出来。"
                },
                {
                    "id": "223060805",
                    "speaker": "博来",
                    "text": "不过费用嘛。嘿嘿，您多少得付点…就<color=#00E1FFFF>100摩拉</color>，您看怎么样。"
                },
                {
                    "id": "223060806",
                    "speaker": "博来",
                    "text": "您看，需要我给您在藏宝图上<color=#00E1FFFF>标上地点</color>吗？"
                }
            ]
        },
        {
            "id": "2230603",
            "objective": "与博来对话$HIDDEN",
            "dialogues": [
                {
                    "id": "223060301",
                    "speaker": "Player",
                    "text": "给我标上吧。"
                },
                {
                    "id": "223060302",
                    "speaker": "博来",
                    "text": "好，我现在就把地方给您标好了。"
                },
                {
                    "id": "223060303",
                    "speaker": "博来",
                    "text": "您走好，拿到宝藏之后，记得拿回来我们一起分啊。"
                }
            ]
        },
        {
            "id": "2230604",
            "objective": "寻找宝藏$HIDDEN",
            "dialogues": [
                {
                    "id": "223060401",
                    "speaker": "Player",
                    "text": "不用了。"
                },
                {
                    "id": "223060402",
                    "speaker": "博来",
                    "text": "那也行，都凭您自己的主意。"
                },
                {
                    "id": "223060403",
                    "speaker": "博来",
                    "text": "您走好，拿到宝藏之后，记得拿回来我们一起分啊。"
                }
            ]
        },
        {
            "id": "2230611",
