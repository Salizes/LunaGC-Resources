        {
            "id": "2230605",
            "objective": "与博来对话",
            "dialogues": [
                {
                    "id": "223060601",
                    "speaker": "博来",
                    "text": "您回来了，宝藏找着了吗？"
                },
                {
                    "id": "223060602",
                    "speaker": "Player",
                    "text": "找到了。"
                },
                {
                    "id": "223060603",
                    "speaker": "博来",
                    "text": "不愧是实打实的冒险家，手脚这个麻利。"
                },
                {
                    "id": "223060604",
                    "speaker": "博来",
                    "text": "那行，我看看啊，这个盒子…哼，没啥用的东西…"
                },
                {
                    "id": "223060605",
                    "speaker": "博来",
                    "text": "不过还是辛苦你了，这份是您的，张顺的那份我留着，等他过来拿。"
                },
                {
                    "id": "223060606",
                    "speaker": "博来",
                    "text": "唉，还是没找着，那群家伙别是把我给蒙了吧…"
                }
            ]
        },
        {
            "id": "2230605",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "223060501",
                    "speaker": "张顺",
                    "text": "要是没受伤…肯定能和大姐头一起，找到更多宝藏吧…"
                },
                {
                    "id": "223060502",
                    "speaker": "张顺",
                    "text": "唉，真想再去船上看看…"
                }
            ]
        },
        {
            "id": "2230607",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "223060701",
                    "speaker": "博来",
                    "text": "您真不需要？就是一点小小的消息…"
                }
            ]
        },
        {
            "id": "2230609",
            "objective": "Additional",
            "dialogues": [
                {
                    "id": "223060901",
                    "speaker": "博来",
                    "text": "您回来了，宝藏找着了吗？"
                },
                {
                    "id": "223060902",
                    "speaker": "Player",
                    "text": "找到了。"
                },
                {
                    "id": "223060903",
                    "speaker": "博来",
                    "text": "不愧是实打实的冒险家，手脚这个麻利。"
                },
                {
                    "id": "223060904",
                    "speaker": "博来",
                    "text": "那行，我看看啊，这个盒子…这是什么，地图的残片？"
                },
                {
                    "id": "223060905",
                    "speaker": "博来",
                    "text": "那群家伙说的居然是真的，在那些破烂藏宝图里面，藏着真宝藏的线索…"
                },
                {
                    "id": "223060906",
                    "speaker": "博来",
                    "text": "咦？您怎么还在这，这份是您的，您…您赶紧忙您的去吧，张顺那一份我留着等他来拿。"
                }
            ]
        }
