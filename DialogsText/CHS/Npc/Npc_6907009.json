{
    "talkId": "6907009",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "妮露": 14
    },
    "dialogues": [
        {
            "id": "690700401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690700402",
            "speaker": "妮露",
            "text": "嗯…我们来做几个花盆吧…",
            "choices": [
                {
                    "id": "690700403",
                    "text": "妮露还会做花盆吗？",
                    "response": [
                        {
                            "id": "690700404",
                            "speaker": "妮露",
                            "text": "我原本不会，但我想和你一起做一件很重要的事…就请教了大巴扎的朋友，悄悄练习了一下。"
                        },
                        {
                            "id": "690700405",
                            "speaker": "妮露",
                            "text": "啊，你不用担心，我是成功做出花盆成品之后才来邀请你的。"
                        },
                        {
                            "id": "690700406",
                            "speaker": "妮露",
                            "text": "因为我想…"
                        },
                        {
                            "id": "690700411",
                            "speaker": "妮露",
                            "text": "移植一些帕蒂沙兰过来。"
                        },
                        {
                            "id": "690700412",
                            "speaker": "妮露",
                            "text": "都是我亲手种的，我已经选好了长势不错的几株。"
                        },
                        {
                            "id": "690700413",
                            "speaker": "妮露",
                            "text": "这是我最喜欢的花朵，所以我想要送给我最重要的人。"
                        },
                        {
                            "id": "690700414",
                            "speaker": "妮露",
                            "text": "希望快乐的时间永驻你的身边。"
                        },
                        {
                            "id": "690700415",
                            "speaker": "Player",
                            "text": "谢谢你，妮露。"
                        },
                        {
                            "id": "690700416",
                            "speaker": "妮露",
                            "text": "不用客气啦，你喜欢就好。"
                        },
                        {
                            "id": "690700417",
                            "speaker": "妮露",
                            "text": "等你方便的时候就和我说哦，我随时都可以「登台」。"
                        },
                        {
                            "id": "690700418",
                            "speaker": "妮露",
                            "text": "放心吧，这次我很有信心，连深呼吸也不用做…毕竟我们已经相处很久了呀。"
                        }
                    ]
                },
                {
                    "id": "690700407",
                    "text": "有什么想种的花吗？",
                    "response": [
                        {
                            "id": "690700408",
                            "speaker": "妮露",
                            "text": "嗯——我想了很久。"
                        },
                        {
                            "id": "690700409",
                            "speaker": "妮露",
                            "text": "毕竟你帮了我很多，我也想要为你做点什么。"
                        },
                        {
                            "id": "690700410",
                            "speaker": "妮露",
                            "text": "可是看你似乎都没什么烦恼的样子，我的肢体动作疗愈法也派不上用场，我就想着…"
                        }
                    ]
                }
            ]
        }
    ]
}