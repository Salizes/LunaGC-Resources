{
    "talkId": "6535202",
    "total_dialogue_lines": 5,
    "speaker_counts": {
        "Player": 1,
        "蒂埃坡罗": 4
    },
    "dialogues": [
        {
            "id": "653520201",
            "speaker": "Player",
            "text": "智者委员会？"
        },
        {
            "id": "653520202",
            "speaker": "蒂埃坡罗",
            "text": "相信年长者的智慧是佩特莉可镇的传统。自古以来，镇子上的大小事务都是由长者们组成的委员会来评定的。"
        },
        {
            "id": "653520203",
            "speaker": "蒂埃坡罗",
            "text": "而其中最能让大家信服的长者，就会被推选为「督治」。"
        },
        {
            "id": "653520204",
            "speaker": "蒂埃坡罗",
            "text": "呵呵…不才正是老叟。"
        },
        {
            "id": "653520205",
            "speaker": "蒂埃坡罗",
            "text": "不过虽说是「督治」，这个小镇上倒也没什么需要我管理的事情。毕竟这里风俗淳朴，一切都有传统可依。"
        }
    ]
}