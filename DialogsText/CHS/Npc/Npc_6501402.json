    "dialogues": [
        {
            "id": "650140201",
            "speaker": "Player",
            "text": "有什么新闻？"
        },
        {
            "id": "650140202",
            "speaker": "帕班",
            "text": "对劲爆新闻感兴趣？请买一份报纸吧！"
        },
        {
            "id": "650140203",
            "speaker": "帕班",
            "text": "当然，您若是懒得阅读文字，也可以去找报社门口的亚瑟先生，它会为您口述最新消息的。"
        },
        {
            "id": "650140204",
            "speaker": "帕班",
            "text": "但不在报纸上登出的新闻，您想知道就难咯。"
        }
    ]
}