{
    "talkId": "7323891",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "毕洛": 9
    },
    "dialogues": [
        {
            "id": "732389101",
            "speaker": "毕洛",
            "text": "虽然斯露莎大人是这样说了，不过要是敢有什么可疑的举动，我可不会轻饶！",
            "choices": [
                {
                    "id": "732389102",
                    "text": "听起来真是可靠。",
                    "response": [
                        {
                            "id": "732389103",
                            "speaker": "毕洛",
                            "text": "哼，这是当然，毕竟在「矫论团」，我也算是资格最老的成员之一了。"
                        },
                        {
                            "id": "732389104",
                            "speaker": "毕洛",
                            "text": "虽然学识方面没办法和识主大人相比，但作为世代生活在这里的沙漠民，我和「矫论团」可以说是血脉相连。"
                        },
                        {
                            "id": "732389105",
                            "speaker": "毕洛",
                            "text": "所以如果有什么问题的话可以问…"
                        },
                        {
                            "id": "732389106",
                            "speaker": "毕洛",
                            "text": "不对！就算问了我也是不会回答的！"
                        }
                    ]
                },
                {
                    "id": "732389107",
                    "text": "关于识主…",
                    "response": [
                        {
                            "id": "732389108",
                            "speaker": "毕洛",
                            "text": "那可是位渊博的大人啊！在我见过的人当中，没有比他懂得更多的了。"
                        },
                        {
                            "id": "732389109",
                            "speaker": "毕洛",
                            "text": "虽说我们「矫论团」曾经也是归属于教令院的学派，但几百年来驻守在远离城市的沙漠，早就荒废了知识的传承。"
                        },
                        {
                            "id": "732389110",
                            "speaker": "毕洛",
                            "text": "多亏了识主大人带领我们恢复古老的传统。有识主大人在，我们「矫论团」一定很快就能重振山门！"
                        }
                    ]
                },
                {
                    "id": "732389111",
                    "text": "当然不会。",
                    "response": [
                        {
                            "id": "732389112",
                            "speaker": "毕洛",
                            "text": "哼，那就好。"
                        }
                    ]
                }
            ]
        }
    ]
}