{
    "talkId": "6913308",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 7,
        "桑多涅": 13
    },
    "dialogues": [
        {
            "id": "691330301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691330302",
            "speaker": "桑多涅",
            "text": "抱怨同事可以吗？",
            "choices": [
                {
                    "id": "691330303",
                    "text": "请、请…",
                    "response": [
                        {
                            "id": "691330305",
                            "speaker": "桑多涅",
                            "text": "好极了。以前就想找个没人听得到的地方把工作中遇到的破事都骂一遍！"
                        },
                        {
                            "id": "691330306",
                            "speaker": "桑多涅",
                            "text": "多托雷就不说了，他最好永远离开我的世界。离开所有人的世界。"
                        },
                        {
                            "id": "691330307",
                            "speaker": "桑多涅",
                            "text": "「公鸡」和「富人」这俩尽管互相不对付，但从他们嘴里蹦出的那些回避问题的辞令都是一套一套的。"
                        },
                        {
                            "id": "691330308",
                            "speaker": "桑多涅",
                            "text": "先假装认可你的想法，然后在此基础上说「当然，你一定不介意这么做会引发的这样那样的问题」，借此来让你自己退缩。"
                        },
                        {
                            "id": "691330309",
                            "speaker": "桑多涅",
                            "text": "如果你依旧坚持的话，他们就会搬出自己的绝招——一串你根本听不懂的长难句，其中夹杂着无数专业用语和饶舌的生僻词，说完后问：「你怎么看？」"
                        },
                        {
                            "id": "691330310",
                            "speaker": "桑多涅",
                            "text": "看你个鬼啊！词汇量这么大的话给你们办个拼写比赛好不好？就不能把时间花在聊正事上吗！"
                        },
                        {
                            "id": "691330311",
                            "speaker": "桑多涅",
                            "text": "呼…说几次都来气。",
                            "choices": [
                                {
                                    "id": "691330312",
                                    "text": "你歇歇…",
                                    "response": [
                                        {
                                            "id": "691330314",
                                            "speaker": "桑多涅",
                                            "text": "算了算了…我也知道现实世界中的「道理」不像数理世界中的「定理」那样简单而确信。"
                                        },
                                        {
                                            "id": "691330315",
                                            "speaker": "桑多涅",
                                            "text": "正因为「公鸡」的手段圆滑，才能调和如此之多的利益关系。"
                                        },
                                        {
                                            "id": "691330316",
                                            "speaker": "桑多涅",
                                            "text": "「富人」看起来一肚子坏心思，但不可否认他有着管理至冬经济体系和统筹冒险家协会的能力。"
                                        },
                                        {
                                            "id": "691330317",
                                            "speaker": "Player",
                                            "text": "怎么变成说好话了…"
                                        },
                                        {
                                            "id": "691330318",
                                            "speaker": "桑多涅",
                                            "text": "啊？这不是好话！我理解一个现象，但不代表我不讨厌这种现象！"
                                        },
                                        {
                                            "id": "691330319",
                                            "speaker": "Player",
                                            "text": "还有其他不爽的吗？"
                                        },
                                        {
                                            "id": "691330320",
                                            "speaker": "桑多涅",
                                            "text": "下次再说吧，一天骂两个差不多了。抱怨也要懂得节制。"
                                        }
                                    ]
                                },
                                {
                                    "id": "691330313",
                                    "text": "喝口水…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691330304",
                    "text": "说什么都行。"
                }
            ]
        }
    ]
}