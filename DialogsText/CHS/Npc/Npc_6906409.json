{
    "talkId": "6906409",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "云堇": 12
    },
    "dialogues": [
        {
            "id": "690640201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690640202",
            "speaker": "云堇",
            "text": "放心。这里的一切布置得当，风景也好，住起来很舒服。"
        },
        {
            "id": "690640203",
            "speaker": "云堇",
            "text": "我有个习惯，每天清晨都要找个空旷的地方，遛一遛嗓子。"
        },
        {
            "id": "690640204",
            "speaker": "云堇",
            "text": "璃月港内，空旷无人的地方可不好找。但在这里就方便得多了。",
            "choices": [
                {
                    "id": "690640205",
                    "text": "「遛嗓子」？",
                    "response": [
                        {
                            "id": "690640206",
                            "speaker": "云堇",
                            "text": "是呀，每天练声练气是我们这行的基本功。"
                        },
                        {
                            "id": "690640207",
                            "speaker": "云堇",
                            "text": "一天不练，自己知道，三天不练，观众知道。基本功啊，是绝对不能怠慢的。"
                        },
                        {
                            "id": "690640208",
                            "speaker": "云堇",
                            "text": "你看你，满脸写着「听起来好辛苦」，我可不这么觉得哦。"
                        },
                        {
                            "id": "690640209",
                            "speaker": "云堇",
                            "text": "坚持做好每件小事，演好每个细节，才能将璃月戏中细腻优美的一面传达给观众。"
                        },
                        {
                            "id": "690640210",
                            "speaker": "云堇",
                            "text": "做这些事，我向来是乐在其中。"
                        },
                        {
                            "id": "690640215",
                            "speaker": "Player",
                            "text": "我明白了。"
                        },
                        {
                            "id": "690640216",
                            "speaker": "云堇",
                            "text": "嗯，感谢理解，也谢谢你的关心。"
                        }
                    ]
                },
                {
                    "id": "690640211",
                    "text": "需要我陪你吗？",
                    "response": [
                        {
                            "id": "690640212",
                            "speaker": "云堇",
                            "text": "真体贴啊，这份好意我心领了。"
                        },
                        {
                            "id": "690640213",
                            "speaker": "云堇",
                            "text": "不过我练习起来，一会儿念一会儿唱，一会儿扮哭腔一会儿学笑声，起伏太大，别吓到你才好。"
                        },
                        {
                            "id": "690640214",
                            "speaker": "云堇",
                            "text": "对你，我更想献上一台准备完全的演出。"
                        }
                    ]
                }
            ]
        }
    ]
}