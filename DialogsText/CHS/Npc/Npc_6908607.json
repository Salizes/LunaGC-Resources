{
    "talkId": "6908607",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "莱欧斯利": 11
    },
    "dialogues": [
        {
            "id": "690860201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690860202",
            "speaker": "莱欧斯利",
            "text": "嗯，环境很好，温度和湿度都无可挑剔，是适合悠闲度日的地方。"
        },
        {
            "id": "690860203",
            "speaker": "莱欧斯利",
            "text": "有这样舒适的庇护所还愿意在外面闯荡，你确实不一般。",
            "choices": [
                {
                    "id": "690860204",
                    "text": "我有必须要做的事。",
                    "response": [
                        {
                            "id": "690860205",
                            "speaker": "莱欧斯利",
                            "text": "语气如此坚定，看来是生命中至关重要的大事。"
                        },
                        {
                            "id": "690860206",
                            "speaker": "莱欧斯利",
                            "text": "执着于某项目标是好事，能避免人生陷入迷茫。"
                        },
                        {
                            "id": "690860207",
                            "speaker": "莱欧斯利",
                            "text": "但千万不要因为被执念掌控而步入险途，好吗？"
                        },
                        {
                            "id": "690860208",
                            "speaker": "莱欧斯利",
                            "text": "毕竟还有这样一个美妙的地方等你回来呢。"
                        }
                    ]
                },
                {
                    "id": "690860209",
                    "text": "生命在于运动。",
                    "response": [
                        {
                            "id": "690860210",
                            "speaker": "莱欧斯利",
                            "text": "哦，很有说服力的一句话，我可以记下来写进梅洛彼得堡的什么守则里。"
                        },
                        {
                            "id": "690860211",
                            "speaker": "莱欧斯利",
                            "text": "需要给你署名吗？"
                        },
                        {
                            "id": "690860212",
                            "speaker": "Player",
                            "text": "休想推卸责任。"
                        },
                        {
                            "id": "690860213",
                            "speaker": "莱欧斯利",
                            "text": "哎呀，被你看穿了。"
                        },
                        {
                            "id": "690860214",
                            "speaker": "莱欧斯利",
                            "text": "放心吧，我只是开玩笑而已。"
                        },
                        {
                            "id": "690860215",
                            "speaker": "莱欧斯利",
                            "text": "就算真要定什么规矩，我也会亲自负责的。"
                        }
                    ]
                }
            ]
        }
    ]
}