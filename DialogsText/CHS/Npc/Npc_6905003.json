{
    "talkId": "6905003",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "托马": 12
    },
    "dialogues": [
        {
            "id": "690500301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690500302",
            "speaker": "托马",
            "text": "好啊。这里的氛围很悠闲，正适合闲聊呢。"
        },
        {
            "id": "690500303",
            "speaker": "托马",
            "text": "说起来，我一直在想，有空得带你去鸣神大社看看。"
        },
        {
            "id": "690500304",
            "speaker": "托马",
            "text": "大社里的神樱树常年开花，落樱飞舞，非常漂亮。看到那样的美景，你一定会喜欢上稻妻。",
            "choices": [
                {
                    "id": "690500305",
                    "text": "嗯，我见过。",
                    "response": [
                        {
                            "id": "690500307",
                            "speaker": "托马",
                            "text": "哈哈，真不错。"
                        },
                        {
                            "id": "690500308",
                            "speaker": "托马",
                            "text": "啊对了，说到鸣神大社，我得提醒你一句：千万不要攻击大社附近的小狐狸。"
                        },
                        {
                            "id": "690500309",
                            "speaker": "托马",
                            "text": "你没有做过这种事…对吧？",
                            "choices": [
                                {
                                    "id": "690500310",
                                    "text": "怎么会，我是动物之友。",
                                    "response": [
                                        {
                                            "id": "690500311",
                                            "speaker": "托马",
                                            "text": "那就好，我就知道你是个心存善念的人。"
                                        },
                                        {
                                            "id": "690500314",
                                            "speaker": "托马",
                                            "text": "一个爱说神鬼故事的老奶奶告诉过我，曾有人因为攻击了大社附近的小狐狸，受到了「雷罚」。"
                                        },
                                        {
                                            "id": "690500315",
                                            "speaker": "托马",
                                            "text": "狐狸是受到鸣神大人青睐的动物，发生这种事也不意外。"
                                        },
                                        {
                                            "id": "690500316",
                                            "speaker": "托马",
                                            "text": "不过，就算是别的动物，也该和它们好好相处。"
                                        },
                                        {
                                            "id": "690500317",
                                            "speaker": "托马",
                                            "text": "毕竟每一株花木、每一个生灵，都值得我们去尊重。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690500312",
                                    "text": "会发生什么？",
                                    "response": [
                                        {
                                            "id": "690500313",
                                            "speaker": "托马",
                                            "text": "唔…你很好奇吗？但不要因为好奇就去尝试啊，会遭遇不幸的。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690500306",
                    "text": "下次一起去吧。"
                }
            ]
        }
    ]
}