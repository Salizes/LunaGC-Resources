    "dialogues": [
        {
            "id": "645070201",
            "speaker": "Player",
            "text": "说说你的时代吧。"
        },
        {
            "id": "645070202",
            "speaker": "维尼皮",
            "text": "我的时代？"
        },
        {
            "id": "645070203",
            "speaker": "维尼皮",
            "text": "我只是个名义上的学徒，实际上的运砖工人。"
        },
        {
            "id": "645070204",
            "speaker": "维尼皮",
            "text": "一定要说些什么的话…"
        },
        {
            "id": "645070205",
            "speaker": "维尼皮",
            "text": "我们那个时代，所有参与赤王陵修建的工人，每天都提供两杯啤酒。"
        },
        {
            "id": "645070206",
            "speaker": "维尼皮",
            "text": "真怀念啊。虽然我已经忘记那个味道了。"
        }
    ]
}