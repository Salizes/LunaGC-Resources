    "dialogues": [
        {
            "id": "675060401",
            "speaker": "Player",
            "text": "是「歌剧」和「芭蕾舞」吧…"
        },
        {
            "id": "675060402",
            "speaker": "季莫菲",
            "text": "哦哦，哦哦…看来您是内行啊！"
        },
        {
            "id": "675060403",
            "speaker": "季莫菲",
            "text": "实不相瞒，我虽然手上有票，但确实没欣赏过这些演出。唉，都是生计所迫。"
        },
        {
            "id": "675060404",
            "speaker": "季莫菲",
            "text": "见笑，见笑。总之，如果您想要内部票，可别忘了来找我。"
        }
    ]
}