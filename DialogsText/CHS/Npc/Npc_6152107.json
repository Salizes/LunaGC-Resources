{
    "talkId": "6152107",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "葛罗丽": 11
    },
    "dialogues": [
        {
            "id": "615210701",
            "speaker": "Player",
            "text": "你还好吗？"
        },
        {
            "id": "615210702",
            "speaker": "葛罗丽",
            "text": "啊…失礼了。听这个嗓音…是旅行者吗？"
        },
        {
            "id": "615210703",
            "speaker": "葛罗丽",
            "text": "我最近还是会在这里等古德温，祈祷他回来的路上能够避开那些缠人的丘丘人或者深渊教团…早日和我相聚。"
        },
        {
            "id": "615210704",
            "speaker": "葛罗丽",
            "text": "啊我又在自说自话了…能有你陪我聊天，真是令人高兴。",
            "choices": [
                {
                    "id": "615210705",
                    "text": "关于古德温…",
                    "response": [
                        {
                            "id": "615210706",
                            "speaker": "葛罗丽",
                            "text": "大团长法尔伽告诉我，古德温的「远征」还没有结束，他会在挪德卡莱继续自己的战斗…"
                        },
                        {
                            "id": "615210707",
                            "speaker": "葛罗丽",
                            "text": "我最近收到了许多古德温的来信。他的信总是写得很长，就像是有什么话想说却说不出口，只能一直绕着那句话打转。"
                        },
                        {
                            "id": "615210708",
                            "speaker": "葛罗丽",
                            "text": "…其实他不用说那么多，我也能明白他想说什么。你一定也体会过这种感觉吧？"
                        },
                        {
                            "id": "615210709",
                            "speaker": "Player",
                            "text": "…嗯。我明白。"
                        },
                        {
                            "id": "615210710",
                            "speaker": "葛罗丽",
                            "text": "所以我愿意相信…这一次，他会信守诺言的。"
                        }
                    ]
                },
                {
                    "id": "615210711",
                    "text": "关于丘丘人和深渊教团。",
                    "response": [
                        {
                            "id": "615210712",
                            "speaker": "葛罗丽",
                            "text": "你也会觉得他们很烦吧？每天都在添麻烦的家伙们。"
                        },
                        {
                            "id": "615210713",
                            "speaker": "葛罗丽",
                            "text": "听说大多数丘丘人是数百年前忽然出现在提瓦特的，深渊教团…好像也是差不多的时期。"
                        },
                        {
                            "id": "615210714",
                            "speaker": "葛罗丽",
                            "text": "有人说是他们诞生于一场提瓦特的大灾难…可我更怀疑他们是从天空以外的地方来的…"
                        },
                        {
                            "id": "615210715",
                            "speaker": "葛罗丽",
                            "text": "…唔抱歉，我因为看不见，所以经常会一个人想些无聊的事情，请不要在意。"
                        }
                    ]
                }
            ]
        }
    ]
}