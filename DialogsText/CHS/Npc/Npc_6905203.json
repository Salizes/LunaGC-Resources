    },
    "dialogues": [
        {
            "id": "690520301",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690520302",
            "speaker": "影",
            "text": "如果是与「一心净土」相提并论的话，这里热闹了很多。"
        },
        {
            "id": "690520303",
            "speaker": "Player",
            "text": "会不适应吗？"
        },
        {
            "id": "690520304",
            "speaker": "影",
            "text": "不会，不用担心。"
        },
        {
            "id": "690520305",
            "speaker": "影",
            "text": "热闹仅仅是外在的，我的内心依旧保持平静。",
            "choices": [
                {
                    "id": "690520306",
                    "text": "这样就好。",
                    "response": [
                        {
                            "id": "690520307",
                            "speaker": "影",
                            "text": "嗯，谢谢你的理解。"
                        },
                        {
                            "id": "690520310",
                            "speaker": "影",
                            "text": "……"
                        },
                        {
                            "id": "690520311",
                            "speaker": "影",
                            "text": "要再多待一会儿吗？"
                        },
                        {
                            "id": "690520312",
                            "speaker": "影",
                            "text": "有你在旁边，即使相顾无言，心中也会变得安然。"
                        },
                        {
                            "id": "690520313",
                            "speaker": "影",
                            "text": "我并不讨厌这样的变化。"
                        }
                    ]
                },
                {
                    "id": "690520308",
                    "text": "要不要试着「热闹」起来？",
                    "response": [
                        {
                            "id": "690520309",
                            "speaker": "影",
                            "text": "听上去有违「永恒」的理念，我会再考虑一下的。"
                        }
                    ]
                }
            ]
        }
    ]
}