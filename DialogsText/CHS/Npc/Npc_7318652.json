{
    "talkId": "7318652",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "马塞拉": 7
    },
    "dialogues": [
        {
            "id": "731865201",
            "speaker": "马塞拉",
            "text": "「扑梭梭梭梭~」小金丝雀飞回来咯！嘿嘿，恭喜你！",
            "choices": [
                {
                    "id": "731865202",
                    "text": "你在说什么？",
                    "response": [
                        {
                            "id": "731865203",
                            "speaker": "马塞拉",
                            "text": "瞧瞧你，瞧瞧你…小金丝雀还不知道发生了什么，就已经让毒蝎作茧自缚了…真是了不起呀，了不起！"
                        },
                        {
                            "id": "731865206",
                            "speaker": "马塞拉",
                            "text": "不过呀…那只小狞猫和你一样，对自己深陷的天罗地网一无所知，只是出于直觉和本能在里面撕扯着…"
                        },
                        {
                            "id": "731865207",
                            "speaker": "马塞拉",
                            "text": "「撕拉、撕拉…」她会不会越陷越深呢…？"
                        },
                        {
                            "id": "731865208",
                            "speaker": "Player",
                            "text": "你到底在说什么？"
                        },
                        {
                            "id": "731865209",
                            "speaker": "马塞拉",
                            "text": "哦，哦！你生气了！"
                        },
                        {
                            "id": "731865210",
                            "speaker": "马塞拉",
                            "text": "哈哈，没什么…请保护好她，她是个好孩子。"
                        }
                    ]
                },
                {
                    "id": "731865204",
                    "text": "我不是小金丝雀。",
                    "response": [
                        {
                            "id": "731865205",
                            "speaker": "马塞拉",
                            "text": "哦，那你是小猎鹰？哈哈，先要赢过我的猎鹰才行！"
                        }
                    ]
                }
            ]
        }
    ]
}