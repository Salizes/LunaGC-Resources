    "dialogues": [
        {
            "id": "621400801",
            "speaker": "Player",
            "text": "关于凝光。"
        },
        {
            "id": "621400802",
            "speaker": "百晓",
            "text": "凝光大人乃是七星之一，总览璃月，遍察工商…"
        },
        {
            "id": "621400803",
            "speaker": "百晓",
            "text": "除此之外，恕我不便透露太多信息。"
        },
        {
            "id": "621400804",
            "speaker": "百晓",
            "text": "不过以您和凝光大人的交情…有什么疑问的话，可以尝试去问她本人。"
        }
    ]
}