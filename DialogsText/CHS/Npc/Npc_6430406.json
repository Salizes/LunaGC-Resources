    "dialogues": [
        {
            "id": "643040601",
            "speaker": "Player",
            "text": "你好。"
        },
        {
            "id": "643040602",
            "speaker": "基翁",
            "text": "你好你好。"
        },
        {
            "id": "643040603",
            "speaker": "基翁",
            "text": "化城郭经常有来往的旅客、商人、冒险家…但你的脚步声比他们都要轻快，想必是位活泼可爱的年轻人吧。"
        },
        {
            "id": "643040604",
            "speaker": "基翁",
            "text": "在如今的须弥，这可是件难得的好事。"
        },
        {
            "id": "643040605",
            "speaker": "基翁",
            "text": "年轻的旅客，小吉祥草王大人保佑你。"
        }
    ]
}