{
    "talkId": "6617501",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "阿卡坦加": 6
    },
    "dialogues": [
        {
            "id": "661750101",
            "speaker": "阿卡坦加",
            "text": "这些布景应该还有别的用途…哦，你好。",
            "choices": [
                {
                    "id": "661750102",
                    "text": "布景怎么了？",
                    "response": [
                        {
                            "id": "661750103",
                            "speaker": "阿卡坦加",
                            "text": "我在想这里的布景还有没有别的用处，直接撤掉就有些可惜了，你说是吧？"
                        },
                        {
                            "id": "661750104",
                            "speaker": "阿卡坦加",
                            "text": "开放给其他的映影爱好者使用…是一个选择，不过感觉吸引力不太够。是不是应该多准备一点场景…"
                        }
                    ]
                },
                {
                    "id": "661750105",
                    "text": "关于之前的映影…",
                    "response": [
                        {
                            "id": "661750106",
                            "speaker": "阿卡坦加",
                            "text": "哦！其实评价很不错呢，不过是在一部分人之中。我那分道扬镳的朋友…她还是没有回心转意。"
                        },
                        {
                            "id": "661750107",
                            "speaker": "阿卡坦加",
                            "text": "到底是哪里不对呢？我自己对这部作品很满意的…"
                        }
                    ]
                },
                {
                    "id": "661750108",
                    "text": "不打扰了，再见。",
                    "response": [
                        {
                            "id": "661750109",
                            "speaker": "阿卡坦加",
                            "text": "哪里的话，祝你一路顺风。"
                        }
                    ]
                }
            ]
        }
    ]
}