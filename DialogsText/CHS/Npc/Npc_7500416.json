{
    "talkId": "7500416",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "尤考姆": 10
    },
    "dialogues": [
        {
            "id": "750041601",
            "speaker": "尤考姆",
            "text": "唉，没想到这次轮值看守居然轮值了那么久，蒂图那家伙终于回来了…",
            "choices": [
                {
                    "id": "750041602",
                    "text": "你是谁？",
                    "response": [
                        {
                            "id": "750041603",
                            "speaker": "尤考姆",
                            "text": "哈哈，我？真是个好奇心旺盛的客人，如您所见，我的名字叫尤考姆，是此处哨站的看守…之一。"
                        },
                        {
                            "id": "750041604",
                            "speaker": "尤考姆",
                            "text": "#不过要我说，{M#兄弟}{F#小姐}，在纳塔的野外可不能像这样随便向人搭话…"
                        },
                        {
                            "id": "750041605",
                            "speaker": "尤考姆",
                            "text": "这里已经接近回声之子部族的外沿，出了这个区域，就是战士们互相「切磋」的地界了。"
                        }
                    ]
                },
                {
                    "id": "750041606",
                    "text": "你在这做什么？",
                    "response": [
                        {
                            "id": "750041607",
                            "speaker": "尤考姆",
                            "text": "我在看守，我在伫立，我在…等待。"
                        },
                        {
                            "id": "750041608",
                            "speaker": "尤考姆",
                            "text": "好吧，我只是有点无聊，也有点累，这里是回声之子的哨站，每天都会有人轮流到岗进行看守。"
                        },
                        {
                            "id": "750041609",
                            "speaker": "尤考姆",
                            "text": "这就是我在部族里承担的「职责」。"
                        }
                    ]
                },
                {
                    "id": "750041610",
                    "text": "蒂图回来了，你不休息吗？",
                    "response": [
                        {
                            "id": "750041611",
                            "speaker": "尤考姆",
                            "text": "我现在就是在休息啊。蒂图这家伙回来了，我就不用盯着那些不祥的风，怪言怪语，和扭曲的阴影啦。"
                        },
                        {
                            "id": "750041612",
                            "speaker": "尤考姆",
                            "text": "#而我呢，我就只用看着别人工作，哈，这就是我最大的休息了，{M#兄弟}{F#小姐}。"
                        }
                    ]
                },
                {
                    "id": "750041613",
                    "text": "再见！",
                    "response": [
                        {
                            "id": "750041614",
                            "speaker": "尤考姆",
                            "text": "#再见，路上小心，{M#兄弟}{F#小姐}。"
                        }
                    ]
                }
            ]
        }
    ]
}