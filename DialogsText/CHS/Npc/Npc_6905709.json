{
    "talkId": "6905709",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "荒泷一斗": 11
    },
    "dialogues": [
        {
            "id": "690570201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690570202",
            "speaker": "荒泷一斗",
            "text": "那还用说吗？别小看混混啊…"
        },
        {
            "id": "690570203",
            "speaker": "荒泷一斗",
            "text": "四海之内，没有一个地方是我荒泷一斗住不习惯的。"
        },
        {
            "id": "690570204",
            "speaker": "荒泷一斗",
            "text": "大街小巷、码头野林…我都住过！不过要说环境最舒服的还是町奉行的牢房。"
        },
        {
            "id": "690570205",
            "speaker": "荒泷一斗",
            "text": "当然，那是遇见你之前了。"
        },
        {
            "id": "690570206",
            "speaker": "荒泷一斗",
            "text": "现在我郑重宣布，你打造的这个地方比町奉行的牢房还要好十…啊不，一百倍！",
            "choices": [
                {
                    "id": "690570207",
                    "text": "谁要跟牢房比啊！",
                    "response": [
                        {
                            "id": "690570208",
                            "speaker": "荒泷一斗",
                            "text": "怎么就不能比呢？！你怕了吗？"
                        },
                        {
                            "id": "690570209",
                            "speaker": "荒泷一斗",
                            "text": "看着我的眼睛，听好了，你这里就是最好的！"
                        },
                        {
                            "id": "690570213",
                            "speaker": "荒泷一斗",
                            "text": "总之…我的意思你能懂就好。多的我就不说了，男子汉婆婆妈妈的算什么话！"
                        },
                        {
                            "id": "690570214",
                            "speaker": "荒泷一斗",
                            "text": "按照道上规矩，我也得表示表示…这样吧，这个场子以后就由我荒泷一斗罩了！"
                        }
                    ]
                },
                {
                    "id": "690570210",
                    "text": "多谢夸奖！",
                    "response": [
                        {
                            "id": "690570211",
                            "speaker": "荒泷一斗",
                            "text": "哈哈！实话实说而已，你跟我就不用客气了。"
                        },
                        {
                            "id": "690570212",
                            "speaker": "荒泷一斗",
                            "text": "如果你不介意，那我就把这里当自己家了，这么好的地方，我还巴不得天天躺在这呢…"
                        }
                    ]
                }
            ]
        }
    ]
}