{
    "talkId": "6201602",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "岚姐": 13
    },
    "dialogues": [
        {
            "id": "620160201",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "620160202",
            "speaker": "岚姐",
            "text": "如果你要找璃月冒险家协会的会长的话，那很不幸地告诉你，我就是。"
        },
        {
            "id": "620160203",
            "speaker": "岚姐",
            "text": "我的意思是你别指望我能帮上什么忙，协会事务那种麻烦的东西，我一丁点也不想染指。"
        },
        {
            "id": "620160204",
            "speaker": "岚姐",
            "text": "除非，你带来的是「剑」的消息。"
        },
        {
            "id": "620160205",
            "speaker": "Player",
            "text": "「剑」？"
        },
        {
            "id": "620160206",
            "speaker": "岚姐",
            "text": "是我大哥的那把剑，找到的话，就能好好把他下葬了…"
        },
        {
            "id": "620160207",
            "speaker": "岚姐",
            "text": "…那才是武人该有的归宿。"
        },
        {
            "id": "620160208",
            "speaker": "岚姐",
            "text": "那剑样貌平平，却吹毛断发锋利无比，名为「藏锋」。",
            "choices": [
                {
                    "id": "620160209",
                    "text": "你是怎么当上分会长的？",
                    "response": [
                        {
                            "id": "620160210",
                            "speaker": "岚姐",
                            "text": "又是这个问题吗…好吧，我就破例给你讲讲。"
                        },
                        {
                            "id": "620160211",
                            "speaker": "岚姐",
                            "text": "当初身为雇佣兵的我，为了找「剑」，想要利用冒险家协会的情报网，所以才加入了协会。"
                        },
                        {
                            "id": "620160212",
                            "speaker": "岚姐",
                            "text": "识字什么的我很不擅长，可是「剑」字我可认得，有「剑」相关的委托我就全接了一遍。"
                        },
                        {
                            "id": "620160213",
                            "speaker": "岚姐",
                            "text": "不记得是第八个还是第九个刚完成的时候，至冬国总部那边发来消息，说我刚刚完成了两个「S级」的委托。"
                        },
                        {
                            "id": "620160214",
                            "speaker": "岚姐",
                            "text": "…然后就这么被提拔成了分会长，真是莫名其妙。"
                        }
                    ]
                },
                {
                    "id": "620160215",
                    "text": "我会帮你留意的。",
                    "response": [
                        {
                            "id": "620160216",
                            "speaker": "岚姐",
                            "text": "哦？我很中意你这样爽快的人。"
                        },
                        {
                            "id": "620160217",
                            "speaker": "岚姐",
                            "text": "那就拜托你了，新人，看来我加入这协会还算有些意义。"
                        }
                    ]
                }
            ]
        }
    ]
}