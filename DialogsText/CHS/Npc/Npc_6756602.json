    "dialogues": [
        {
            "id": "675660201",
            "speaker": "Player",
            "text": "这是你养的熊？"
        },
        {
            "id": "675660202",
            "speaker": "卢戈夫斯科",
            "text": "哦…饲养和被饲养可不是这么简单的关系，小家伙。在很多人眼里，是我在饲养这头熊…"
        },
        {
            "id": "675660203",
            "speaker": "卢戈夫斯科",
            "text": "可或许在这头熊眼里，是他在养护我呢…在面对那些偷鸡摸狗的家伙的时候，他可比狗要可靠多了。"
        }
    ]
}