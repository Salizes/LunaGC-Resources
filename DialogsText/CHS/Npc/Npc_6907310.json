{
    "talkId": "6907310",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 6,
        "纳西妲": 11
    },
    "dialogues": [
        {
            "id": "690730301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690730302",
            "speaker": "纳西妲",
            "text": "好啊。不过，比起讲故事，今天还是先来解决你的烦恼吧。"
        },
        {
            "id": "690730303",
            "speaker": "纳西妲",
            "text": "你的眼神像在问我，我是怎么会知道的？"
        },
        {
            "id": "690730304",
            "speaker": "纳西妲",
            "text": "那当然是从你的脸上看出来的，因为我总是在观察着你嘛。"
        },
        {
            "id": "690730305",
            "speaker": "纳西妲",
            "text": "现在的你，哭丧得像是被雷劈过的堇瓜一样。"
        },
        {
            "id": "690730306",
            "speaker": "Player",
            "text": "感觉最近有点倒霉…"
        },
        {
            "id": "690730307",
            "speaker": "纳西妲",
            "text": "别灰心。你还不能确定是你倒霉，还是只是你遇上了倒霉的事。",
            "choices": [
                {
                    "id": "690730308",
                    "text": "有什么区别吗？",
                    "response": [
                        {
                            "id": "690730309",
                            "speaker": "纳西妲",
                            "text": "打比方的话…就像一只吞掉了小狐狸的长鬓虎拉肚子了。"
                        },
                        {
                            "id": "690730312",
                            "speaker": "纳西妲",
                            "text": "可你不知道是因为小狐狸的问题还是小狐狸肚子里的东西的问题，这样说你能明白吗？",
                            "choices": [
                                {
                                    "id": "690730313",
                                    "text": "马马虎虎。",
                                    "response": [
                                        {
                                            "id": "690730315",
                                            "speaker": "纳西妲",
                                            "text": "要是因为拉肚子就不敢再去吃小狐狸，那长鬓虎早就灭绝了吧。"
                                        },
                                        {
                                            "id": "690730316",
                                            "speaker": "纳西妲",
                                            "text": "只要长鬓虎还在吃小狐狸，只要我们还在一天天生活下去，总会遇到各种各样的事情。"
                                        },
                                        {
                                            "id": "690730317",
                                            "speaker": "纳西妲",
                                            "text": "你已经做得很好了，摸摸头。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690730314",
                                    "text": "我完全明白了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690730310",
                    "text": "麻烦纳西妲打个比方？",
                    "response": [
                        {
                            "id": "690730311",
                            "speaker": "纳西妲",
                            "text": "嗯…就像一只吞掉了小狐狸的长鬓虎拉肚子了。"
                        }
                    ]
                }
            ]
        }
    ]
}