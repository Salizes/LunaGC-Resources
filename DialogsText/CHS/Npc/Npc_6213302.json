{
    "talkId": "6213302",
    "total_dialogue_lines": 6,
    "speaker_counts": {
        "Player": 1,
        "卡斯帕": 5
    },
    "dialogues": [
        {
            "id": "621330201",
            "speaker": "Player",
            "text": "风景如何？"
        },
        {
            "id": "621330202",
            "speaker": "卡斯帕",
            "text": "实在是太棒了，跟我的家乡枫丹完全不一样啊！"
        },
        {
            "id": "621330203",
            "speaker": "卡斯帕",
            "text": "即便是我路过时瞟到过的「庆云顶」，那在大雾中只能看轮廓的山峦，也是别有一番韵味啊…"
        },
        {
            "id": "621330204",
            "speaker": "卡斯帕",
            "text": "此情此景，真是不禁想让人像璃月的诗人一样吟诗一首！"
        },
        {
            "id": "621330205",
            "speaker": "卡斯帕",
            "text": "你看这山！…那什么，侧看有如…有如什么呢…"
        },
        {
            "id": "621330206",
            "speaker": "卡斯帕",
            "text": "…算了，这山真棒啊！"
        }
    ]
}