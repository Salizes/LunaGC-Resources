{
    "talkId": "6905204",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "影": 15
    },
    "dialogues": [
        {
            "id": "690520401",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690520402",
            "speaker": "影",
            "text": "好啊，我正好也有事情想询问你。"
        },
        {
            "id": "690520403",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "690520404",
            "speaker": "影",
            "text": "我想知道，你是怎么把甜点心做得那么好吃的？"
        },
        {
            "id": "690520405",
            "speaker": "影",
            "text": "咳咳…至少很符合我的口味。",
            "choices": [
                {
                    "id": "690520406",
                    "text": "最重要的是耐心。",
                    "response": [
                        {
                            "id": "690520407",
                            "speaker": "影",
                            "text": "尝试的结果可能是失败，但却不会因为失败而放弃再度尝试。"
                        },
                        {
                            "id": "690520408",
                            "speaker": "影",
                            "text": "在实践过程中通过微量调试，不断总结和积累经验。"
                        },
                        {
                            "id": "690520409",
                            "speaker": "影",
                            "text": "…是这个意思吗？"
                        },
                        {
                            "id": "690520415",
                            "speaker": "Player",
                            "text": "没错。"
                        },
                        {
                            "id": "690520416",
                            "speaker": "影",
                            "text": "…嗯，我记下了。"
                        },
                        {
                            "id": "690520417",
                            "speaker": "影",
                            "text": "既然已经得到了你的验证，那么下次对于将军人偶的优化，也按照这个方向尝试吧。",
                            "choices": [
                                {
                                    "id": "690520418",
                                    "text": "原来问这些的目的…",
                                    "response": [
                                        {
                                            "id": "690520420",
                                            "speaker": "影",
                                            "text": "嗯？我都说了我不会做饭嘛…"
                                        },
                                        {
                                            "id": "690520421",
                                            "speaker": "影",
                                            "text": "不过我问这些，跟你也不是完全没有关系…"
                                        },
                                        {
                                            "id": "690520422",
                                            "speaker": "影",
                                            "text": "更厉害的将军…也就更能从不同的危机中保护你吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690520419",
                                    "text": "不是为了学做点心…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690520410",
                    "text": "最重要的是愿望。",
                    "response": [
                        {
                            "id": "690520411",
                            "speaker": "影",
                            "text": "愿望？"
                        },
                        {
                            "id": "690520412",
                            "speaker": "影",
                            "text": "没想到让甜点心变得更好吃…这居然也是一种愿望。"
                        },
                        {
                            "id": "690520413",
                            "speaker": "影",
                            "text": "不…仔细想想的话，应该不止那么简单。"
                        },
                        {
                            "id": "690520414",
                            "speaker": "影",
                            "text": "「愿望」同时也指的是，想要满足食客的那一份心意吧。"
                        }
                    ]
                }
            ]
        }
    ]
}