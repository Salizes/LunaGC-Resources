{
    "talkId": "6906907",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "提纳里": 12
    },
    "dialogues": [
        {
            "id": "690690201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690690202",
            "speaker": "提纳里",
            "text": "嗯，这里环境宜人，景色优美，令人倍感舒适。"
        },
        {
            "id": "690690203",
            "speaker": "提纳里",
            "text": "…或者说，让我觉得有点太舒适了。"
        },
        {
            "id": "690690204",
            "speaker": "提纳里",
            "text": "你看，我已经连要在这里做什么的日程都安排好了。",
            "choices": [
                {
                    "id": "690690205",
                    "text": "在这里还要巡逻吗？",
                    "response": [
                        {
                            "id": "690690206",
                            "speaker": "提纳里",
                            "text": "哈哈，那倒不至于。这里是用法术构筑的空间吧？我没有察觉到任何危险的气息。"
                        },
                        {
                            "id": "690690207",
                            "speaker": "提纳里",
                            "text": "而且能进入这里的，我想应该都是你邀请的伙伴。"
                        },
                        {
                            "id": "690690208",
                            "speaker": "提纳里",
                            "text": "既然是你结交的朋友，估计不会闹出什么出格的动静。"
                        },
                        {
                            "id": "690690209",
                            "speaker": "提纳里",
                            "text": "…呃，应该不会吧？"
                        }
                    ]
                },
                {
                    "id": "690690210",
                    "text": "是要做研究吗？",
                    "response": [
                        {
                            "id": "690690211",
                            "speaker": "提纳里",
                            "text": "嗯…不全是吧。"
                        },
                        {
                            "id": "690690212",
                            "speaker": "提纳里",
                            "text": "这里转转，那里看看，到处观察各式各样的植物，就像平常一样。"
                        },
                        {
                            "id": "690690213",
                            "speaker": "提纳里",
                            "text": "既是学术研究，也是日常生活。"
                        },
                        {
                            "id": "690690214",
                            "speaker": "提纳里",
                            "text": "不过在这里的话，我还是以度假的心态，只安排了以往日程中百分之六十的事务。"
                        },
                        {
                            "id": "690690215",
                            "speaker": "提纳里",
                            "text": "所以如果有事找我的话，随时都可以。"
                        }
                    ]
                }
            ]
        }
    ]
}