{
    "talkId": "6906807",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "多莉": 12
    },
    "dialogues": [
        {
            "id": "690680201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690680202",
            "speaker": "多莉",
            "text": "咳咳，虽然比不过艾尔卡萨扎莱宫…"
        },
        {
            "id": "690680203",
            "speaker": "多莉",
            "text": "但作为我的第二据点来说，合格了！",
            "choices": [
                {
                    "id": "690680204",
                    "text": "只是合格而已吗？",
                    "response": [
                        {
                            "id": "690680205",
                            "speaker": "多莉",
                            "text": "拜托，能让见多识广的桑歌玛哈巴依老爷给出这样子的评价…"
                        },
                        {
                            "id": "690680206",
                            "speaker": "多莉",
                            "text": "已经算是有两把刷子了！"
                        },
                        {
                            "id": "690680207",
                            "speaker": "多莉",
                            "text": "你可是比那些没有艺术细胞的呆头菇高出一大截了呢！"
                        },
                        {
                            "id": "690680212",
                            "speaker": "多莉",
                            "text": "只是呢，如果要请博闻强识的桑歌玛哈巴依老爷来当这里的改造顾问的话…"
                        },
                        {
                            "id": "690680213",
                            "speaker": "多莉",
                            "text": "摩拉，也需要很多很多…"
                        },
                        {
                            "id": "690680214",
                            "speaker": "多莉",
                            "text": "不用着急喔，多多攒起来吧。"
                        },
                        {
                            "id": "690680215",
                            "speaker": "多莉",
                            "text": "既然有大生意，我也会一直留在这里的，嘿嘿。"
                        }
                    ]
                },
                {
                    "id": "690680208",
                    "text": "那怎样才能算「优秀」呢？",
                    "response": [
                        {
                            "id": "690680209",
                            "speaker": "多莉",
                            "text": "喔？难道说难道说，你想让它打败艾尔卡萨扎莱宫，变成我的第一据点？"
                        },
                        {
                            "id": "690680210",
                            "speaker": "多莉",
                            "text": "不错嘛，看来我的小跟班很有上进心。"
                        },
                        {
                            "id": "690680211",
                            "speaker": "多莉",
                            "text": "我很欣赏喔！"
                        }
                    ]
                }
            ]
        }
    ]
}