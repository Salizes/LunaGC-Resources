    "dialogues": [
        {
            "id": "678490301",
            "speaker": "Player",
            "text": "这些酒…"
        },
        {
            "id": "678490302",
            "speaker": "叶尔莫洛夫",
            "text": "这是我家餐厅自己酿的酒。这段时间没什么客人，晶矿也越来越少…我索性关了门，把剩下的酒拿出来卖。"
        },
        {
            "id": "678490303",
            "speaker": "叶尔莫洛夫",
            "text": "但再这样下去，怕是连酒都卖不出去了。"
        }
    ]
}