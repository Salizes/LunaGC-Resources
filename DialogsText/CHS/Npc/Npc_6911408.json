    },
    "dialogues": [
        {
            "id": "691140301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691140302",
            "speaker": "丝柯克",
            "text": "有聊天的时间，不如去提升一下自己的武艺。",
            "choices": [
                {
                    "id": "691140303",
                    "text": "聊聊嘛！",
                    "response": [
                        {
                            "id": "691140304",
                            "speaker": "丝柯克",
                            "text": "……",
                            "choices": [
                                {
                                    "id": "691140305",
                                    "text": "聊聊嘛。",
                                    "response": [
                                        {
                                            "id": "691140306",
                                            "speaker": "丝柯克",
                                            "text": "……",
                                            "choices": [
                                                {
                                                    "id": "691140307",
                                                    "text": "聊聊嘛…",
                                                    "response": [
                                                        {
                                                            "id": "691140308",
                                                            "speaker": "丝柯克",
                                                            "text": "哈…"
                                                        },
                                                        {
                                                            "id": "691140309",
                                                            "speaker": "丝柯克",
                                                            "text": "想听什么？",
                                                            "choices": [
                                                                {
                                                                    "id": "691140310",
                                                                    "text": "一个人待着不孤独吗？",
                                                                    "response": [
                                                                        {
                                                                            "id": "691140311",
                                                                            "speaker": "丝柯克",
                                                                            "text": "「孤独」，好问题。"
                                                                        },
                                                                        {
                                                                            "id": "691140312",
                                                                            "speaker": "丝柯克",
                                                                            "text": "人类常被孤独困扰，甚至有人称其为「最刻骨铭心的情感」。我也曾受困于孤独，但现在它已基本被理性隔绝。"
                                                                        },
                                                                        {
                                                                            "id": "691140313",
                                                                            "speaker": "丝柯克",
                                                                            "text": "在「克服」孤独之后，我思考过另一个问题。人类为何孤独？为何要在进化中保留这种近乎于负面的情感？"
                                                                        },
                                                                        {
                                                                            "id": "691140314",
                                                                            "speaker": "丝柯克",
                                                                            "text": "我想，或许是因为人类始终保持着群居的习惯，他们身上的许多情感对个体来说没什么好处，却有利于种族的延续。"
                                                                        },
                                                                        {
                                                                            "id": "691140315",
                                                                            "speaker": "丝柯克",
                                                                            "text": "而师父和我不同，我们是以个体的形式完成「进化」，这是另外一条路，注定与人类渐行渐远。"
                                                                        },
                                                                        {
                                                                            "id": "691140316",
                                                                            "speaker": "丝柯克",
                                                                            "text": "所以偶尔我也会观察人类，思考自己必须要保留哪些「无用之物」，才能够最低限度地理解他们。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "691140317",
                                                                    "text": "想听丝柯克经历过的趣事。",
                                                                    "response": [
                                                                        {
                                                                            "id": "691140318",
                                                                            "speaker": "丝柯克",
                                                                            "text": "看来你一直想要理解我。我经历过的趣事…不算很多，可能要追溯到很久很久以前了。"
                                                                        },
                                                                        {
                                                                            "id": "691140319",
                                                                            "speaker": "丝柯克",
                                                                            "text": "小时候，我家旁边的树林里住着一只亲近人类的巨大蜥蜴。"
                                                                        },
                                                                        {
                                                                            "id": "691140320",
                                                                            "speaker": "丝柯克",
                                                                            "text": "妈妈说它活了几百年，不过谁也不知道真假。只知道它看上去确实老态龙钟，每天就在树上晒太阳。"
                                                                        },
                                                                        {
                                                                            "id": "691140321",
                                                                            "speaker": "丝柯克",
                                                                            "text": "那时候我喜欢去树林里探险，有一次被许多手掌大的马蜂追，我就往蜥蜴的方向跑，向它求救。"
                                                                        },
                                                                        {
                                                                            "id": "691140322",
                                                                            "speaker": "丝柯克",
                                                                            "text": "没想到它也拿马蜂没办法，于是和我一起跑。我跑的比它快，遁入河中逃向远方，回来的时候发现它已经倒地不起。"
                                                                        },
                                                                        {
                                                                            "id": "691140323",
                                                                            "speaker": "丝柯克",
                                                                            "text": "我抱着它哭了好久，以为它死了，就挖坑安葬了它，还立了一块碑。"
                                                                        },
                                                                        {
                                                                            "id": "691140324",
                                                                            "speaker": "丝柯克",
                                                                            "text": "正好被我妈看到，她赶快挖开了土坑，给那只老蜥蜴上药，把它从鬼门关前抢救了回来。"
                                                                        },
                                                                        {
                                                                            "id": "691140325",
                                                                            "speaker": "丝柯克",
                                                                            "text": "从那以后，它依旧对人很亲近…只是见到我就跑，跑得飞快。"
                                                                        },
                                                                        {
                                                                            "id": "691140326",
                                                                            "speaker": "丝柯克",
                                                                            "text": "不知道…它有没有跑过那场大火呢。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691140327",
                                                    "text": "好吧…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691140327",
                                    "text": "好吧…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691140327",
                    "text": "好吧…"
                }
            ]
        }
    ]
}