    },
    "dialogues": [
        {
            "id": "641040401",
            "speaker": "Player",
            "text": "都有什么故事？"
        },
        {
            "id": "641040402",
            "speaker": "弥诺",
            "text": "有很多哦，你没听说过吗？"
        },
        {
            "id": "641040403",
            "speaker": "弥诺",
            "text": "比如「勇敢的兰那罗」。兰那罗虽然个子小小，但是勇气大大。"
        },
        {
            "id": "641040404",
            "speaker": "弥诺",
            "text": "如此怕火的兰那罗，也会为了保护森林…呜…与森林中的孩子，用身体扑灭山火…"
        },
        {
            "id": "641040405",
            "speaker": "弥诺",
            "text": "呜呜…兰那罗…"
        },
        {
            "id": "641040406",
            "speaker": "弥诺",
            "text": "啊不对，这个，这个只是童话故事罢了！而弥诺已经长大，不再相信这些了…"
        },
        {
            "id": "641040407",
            "speaker": "弥诺",
            "text": "呜…"
        }
    ]
}