    "speaker_counts": {
        "Player": 3,
        "刻晴": 8
    },
    "dialogues": [
        {
            "id": "690420901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690420202",
            "speaker": "刻晴",
            "text": "关于这个问题，如果你问的是感受，那我感觉不错。"
        },
        {
            "id": "690420203",
            "speaker": "刻晴",
            "text": "只是…如果从专业性的角度出发，还有不少提升的空间。"
        },
        {
            "id": "690420204",
            "speaker": "刻晴",
            "text": "首先，不用考虑灾害和外在风险已经让土地规划简化不少了。"
        },
        {
            "id": "690420205",
            "speaker": "刻晴",
            "text": "对你而言最重要的问题，就是合理化空间利用率…"
        },
        {
            "id": "690420206",
            "speaker": "刻晴",
            "text": "另外也要考虑好各资源的分配比例…",
            "choices": [
                {
                    "id": "690420207",
                    "text": "我大概明白了…",
                    "response": [
                        {
                            "id": "690420209",
                            "speaker": "刻晴",
                            "text": "啊…没关系。我只是…有点职业习惯。"
                        },
                        {
                            "id": "690420210",
                            "speaker": "刻晴",
                            "text": "按你的想法来做吧！"
                        },
                        {
                            "id": "690420211",
                            "speaker": "刻晴",
                            "text": "这才是你的家，才有你的样子！"
                        }
                    ]
                },
                {
                    "id": "690420208",
                    "text": "我一句也没听懂…"
                }
            ]
        }
    ]
}