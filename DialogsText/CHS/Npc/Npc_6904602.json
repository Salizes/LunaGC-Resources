    "dialogues": [
        {
            "id": "690460201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690460202",
            "speaker": "胡桃",
            "text": "你这里有山有水，有吃有玩，好得很。"
        },
        {
            "id": "690460203",
            "speaker": "胡桃",
            "text": "唔~再说，你对我这么好，我可喜欢这儿了。",
            "choices": [
                {
                    "id": "690460204",
                    "text": "和胡桃一起很开心。",
                    "response": [
                        {
                            "id": "690460205",
                            "speaker": "胡桃",
                            "text": "哦？是吗？速速附耳过来，本堂主要告诉你一个秘密。"
                        },
                        {
                            "id": "690460206",
                            "speaker": "胡桃",
                            "text": "其实啊，我也是这么想的呢。"
                        }
                    ]
                },
                {
                    "id": "690460207",
                    "text": "堂主不招待招待我吗？",
                    "response": [
                        {
                            "id": "690460208",
                            "speaker": "胡桃",
                            "text": "可以啊，你不忌讳去往生堂就行。"
                        },
                        {
                            "id": "690460209",
                            "speaker": "胡桃",
                            "text": "只要我不忙，随时欢迎你来哦。"
                        }
                    ]
                }
            ]
        }
    ]
}