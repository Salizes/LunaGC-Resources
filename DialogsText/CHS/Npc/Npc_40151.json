    "dialogues": [
        {
            "id": "4015140301",
            "speaker": "昆恩",
            "text": "新鲜水果尽在昆恩水果摊——"
        },
        {
            "id": "4015140302",
            "speaker": "贝雅特丽奇",
            "text": "昆恩——"
        },
        {
            "id": "4015140303",
            "speaker": "昆恩",
            "text": "…又是你啊，今天要多少？"
        },
        {
            "id": "4015140304",
            "speaker": "昆恩",
            "text": "我先声明，绝不打折！"
        },
        {
            "id": "4015140305",
            "speaker": "贝雅特丽奇",
            "text": "青梅竹马都不给亲友价嘛？"
        },
        {
            "id": "4015140306",
            "speaker": "昆恩",
            "text": "我说过很多次了。"
        },
        {
            "id": "4015140307",
            "speaker": "昆恩",
            "text": "价钱不打折，品质也绝不打折！"
        },
        {
            "id": "4015140308",
            "speaker": "贝雅特丽奇",
            "text": "哎呀~~再商量商量嘛~"
        },
        {
            "id": "4015140309",
            "speaker": "贝雅特丽奇",
            "text": "我帮你带午饭来的话，可以打折吗？"
        },
        {
            "id": "4015140310",
            "speaker": "昆恩",
            "text": "你说什么都不会打折的。"
        }
    ]
}