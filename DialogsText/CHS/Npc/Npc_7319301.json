{
    "talkId": "7319301",
    "total_dialogue_lines": 50,
    "speaker_counts": {
        "Player": 8,
        "派蒙": 13,
        "赛芭": 26,
        "齐亚德": 3
    },
    "dialogues": [
        {
            "id": "731930101",
            "speaker": "齐亚德",
            "text": "♪蔷薇啊蔷薇，实现我的愿望。"
        },
        {
            "id": "731930102",
            "speaker": "齐亚德",
            "text": "♪花从石头中绽放，金蔷薇对我歌唱。"
        },
        {
            "id": "731930103",
            "speaker": "齐亚德",
            "text": "♪她唱…"
        },
        {
            "id": "731930104",
            "speaker": "派蒙",
            "text": "这是须弥本地的童谣吧。会唱歌的蔷薇，嗯，是首可爱的歌呢。"
        },
        {
            "id": "731930105",
            "speaker": "派蒙",
            "text": "可惜那个男孩唱到一半就跑开了，本来我还想听完再打个招呼的。"
        },
        {
            "id": "731930106",
            "speaker": "赛芭",
            "text": "是生面孔啊，两位客人是第一次来阿如村吗？",
            "choices": [
                {
                    "id": "731930107",
                    "text": "是的。",
                    "response": [
                        {
                            "id": "731930108",
                            "speaker": "赛芭",
                            "text": "这就对了，难怪你们没听过蔷薇歌谣。"
                        },
                        {
                            "id": "731930111",
                            "speaker": "赛芭",
                            "text": "你们是从其他国家来须弥求学的学者吧，我记得教令院里有很多异国学者。"
                        },
                        {
                            "id": "731930112",
                            "speaker": "派蒙",
                            "text": "虽然我们是认识很多学者没错，但要说我们自己…哎呀，还算不上啦。"
                        },
                        {
                            "id": "731930113",
                            "speaker": "派蒙",
                            "text": "#严格来说，我们是冒险家哦，周游世界的冒险家二人组——派蒙和{NICKNAME}。"
                        },
                        {
                            "id": "731930114",
                            "speaker": "赛芭",
                            "text": "周游世界吗？哈哈哈哈…"
                        },
                        {
                            "id": "731930115",
                            "speaker": "派蒙",
                            "text": "怎么嘛？有什么好笑的啦，我们可是很有名的冒险家，你别不信。"
                        },
                        {
                            "id": "731930116",
                            "speaker": "赛芭",
                            "text": "啊，两位远道来的客人，我并不是在嘲笑你们。正相反，听到周游世界这种让人振奋的话，我很开心。"
                        },
                        {
                            "id": "731930117",
                            "speaker": "赛芭",
                            "text": "跟世界脱节太久，突然听到这样的豪言壮语，还有些惊讶。"
                        },
                        {
                            "id": "731930118",
                            "speaker": "赛芭",
                            "text": "这才一时做出了冒犯的行为，我叫作赛芭，向两位道歉，同时也欢迎你们来到阿如村。"
                        },
                        {
                            "id": "731930119",
                            "speaker": "赛芭",
                            "text": "对了，你们刚才是在讨论齐亚德唱的蔷薇歌谣吗？",
                            "choices": [
                                {
                                    "id": "731930120",
                                    "text": "没错。",
                                    "response": [
                                        {
                                            "id": "731930122",
                                            "speaker": "赛芭",
                                            "text": "既然你们感兴趣，我们可以聊聊蔷薇歌谣，希望这些闲聊能点缀你们的旅程。"
                                        },
                                        {
                                            "id": "731930123",
                                            "speaker": "派蒙",
                                            "text": "赛芭小姐打算给我们唱歌听吗？好啊好啊，刚才那首歌谣特别好听，我正想听完呢。"
                                        },
                                        {
                                            "id": "731930124",
                                            "speaker": "赛芭",
                                            "text": "抱歉，我不太擅长唱歌…不过我们倒是可以谈谈蔷薇歌谣的内容。"
                                        },
                                        {
                                            "id": "731930125",
                                            "speaker": "派蒙",
                                            "text": "嗯，记得刚才那个孩子唱到「蔷薇能实现愿望」来着…"
                                        },
                                        {
                                            "id": "731930126",
                                            "speaker": "赛芭",
                                            "text": "是的，我们这样的小村子里，没有教令院那样的大图书馆，所有的歌都是口口相传的。"
                                        },
                                        {
                                            "id": "731930127",
                                            "speaker": "赛芭",
                                            "text": "我一直认为，歌谣中能实现愿望的花朵，应该是先民们的集体想象。"
                                        },
                                        {
                                            "id": "731930128",
                                            "speaker": "赛芭",
                                            "text": "在沙漠这种极端环境下，水是一种极其重要的生存资源，先民们非常重视能储水的植物。"
                                        },
                                        {
                                            "id": "731930129",
                                            "speaker": "赛芭",
                                            "text": "所以越是地理条件苛刻的地方，越是多植物的传说，这里面蕴含着先民对美好生活的向往。"
                                        },
                                        {
                                            "id": "731930130",
                                            "speaker": "赛芭",
                                            "text": "同时，它们也是先民与沙漠生物之间共生关系的例证。"
                                        },
                                        {
                                            "id": "731930131",
                                            "speaker": "赛芭",
                                            "text": "不过就这个例子而言…阿如村是一个建立在沙地上的村落，这里的土壤并不适合须弥蔷薇。"
                                        },
                                        {
                                            "id": "731930132",
                                            "speaker": "赛芭",
                                            "text": "我自己栽种的须弥蔷薇就始终无法生长，所以我想，歌谣中的金蔷薇可能是想象出的物种…"
                                        },
                                        {
                                            "id": "731930133",
                                            "speaker": "派蒙",
                                            "text": "唔，等一下…我越来越跟不上了。"
                                        },
                                        {
                                            "id": "731930134",
                                            "speaker": "派蒙",
                                            "text": "赛芭小姐，你们闲聊的时候都会讨论这种话题吗？"
                                        },
                                        {
                                            "id": "731930135",
                                            "speaker": "赛芭",
                                            "text": "…啊！对不起，我以为两位是从外面来的，比起天气和收成，可能更想听这种话题。"
                                        },
                                        {
                                            "id": "731930136",
                                            "speaker": "派蒙",
                                            "text": "前面的那些共生关系、集体想象什么的…我的确是不明白，不过最后那句我听懂了。"
                                        },
                                        {
                                            "id": "731930137",
                                            "speaker": "派蒙",
                                            "text": "你是说这里的土地不适合种须弥蔷薇对吧？的确，我们也只在土壤更湿润的地方见过须弥蔷薇呢。",
                                            "choices": [
                                                {
                                                    "id": "731930138",
                                                    "text": "毕竟是沙地。",
                                                    "response": [
                                                        {
                                                            "id": "731930140",
                                                            "speaker": "赛芭",
                                                            "text": "讲起蔷薇，有件事我刚才就在想了，既然两位是冒险家，说不定能接受我的委托…"
                                                        },
                                                        {
                                                            "id": "731930141",
                                                            "speaker": "派蒙",
                                                            "text": "#哈哈，说这个可就有得聊了。{NICKNAME}和我是见过大风大浪的冒险家，什么委托都能解决。"
                                                        },
                                                        {
                                                            "id": "731930142",
                                                            "speaker": "Player",
                                                            "text": "所以遇到了什么困难？"
                                                        },
                                                        {
                                                            "id": "731930143",
                                                            "speaker": "赛芭",
                                                            "text": "我知道，非要求本不属于这里的蔷薇开出花来实在勉强，但无论如何，我还是希望看到它们开放的样子。"
                                                        },
                                                        {
                                                            "id": "731930144",
                                                            "speaker": "赛芭",
                                                            "text": "说起来有点不好意思，这算是我的一点心结吧。"
                                                        },
                                                        {
                                                            "id": "731930145",
                                                            "speaker": "赛芭",
                                                            "text": "按我对蔷薇的了解，如果能使用草元素含量高的肥料，就算是沙地上，它们还是能发芽的。"
                                                        },
                                                        {
                                                            "id": "731930146",
                                                            "speaker": "赛芭",
                                                            "text": "不过这里很难弄到那样的肥料，所以我想拜托两位看看，能不能买到草元素含量高的肥料…"
                                                        },
                                                        {
                                                            "id": "731930147",
                                                            "speaker": "Player",
                                                            "text": "草元素？"
                                                        },
                                                        {
                                                            "id": "731930148",
                                                            "speaker": "赛芭",
                                                            "text": "是的，草元素对生物的生长有很大促进作用，对长势不佳的作物尤其有效。"
                                                        },
                                                        {
                                                            "id": "731930149",
                                                            "speaker": "赛芭",
                                                            "text": "但我是个普通人，没有草元素神之眼，高效的肥料又买不到，真是没有办法。"
                                                        },
                                                        {
                                                            "id": "731930150",
                                                            "speaker": "派蒙",
                                                            "text": "只要<color=#00E1FFFF>草元素</color>的话，那反而简单了，看我们的吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "731930139",
                                                    "text": "蔷薇真娇气。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "731930121",
                                    "text": "蔷薇歌谣？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "731930109",
                    "text": "不是。",
                    "response": [
                        {
                            "id": "731930110",
                            "speaker": "赛芭",
                            "text": "哦？我猜错了吗…让我想想。"
                        }
                    ]
                }
            ]
        }
    ]
}