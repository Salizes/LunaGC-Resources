{
    "talkId": "4008142",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 8,
        "铁骨双刀": 8
    },
    "dialogues": [
        {
            "id": "400814201",
            "speaker": "铁骨双刀",
            "text": "怎么是你们两个？哼！",
            "choices": [
                {
                    "id": "400814202",
                    "text": "我们怎么了？",
                    "response": [
                        {
                            "id": "400814203",
                            "speaker": "铁骨双刀",
                            "text": "没什么，你们迟早会明白的。"
                        },
                        {
                            "id": "400814204",
                            "speaker": "派蒙",
                            "text": "这个人怎么跑到训练的场地来了？听他的口气，难道他也是参赛选手吗？",
                            "choices": [
                                {
                                    "id": "400814205",
                                    "text": "派蒙不要怕。",
                                    "response": [
                                        {
                                            "id": "400814207",
                                            "speaker": "派蒙",
                                            "text": "好像也对哦，那么多凶巴巴的家伙都被我们打败了，这个人也没什么特别的。"
                                        },
                                        {
                                            "id": "400814208",
                                            "speaker": "派蒙",
                                            "text": "而且我相信「咚咚小圆帽」和蕈兽伙伴们！脾气这么坏的人，肯定也和蕈兽们搞不好关系！"
                                        },
                                        {
                                            "id": "400814209",
                                            "speaker": "铁骨双刀",
                                            "text": "你们的声音没压住，我都听见了。"
                                        },
                                        {
                                            "id": "400814210",
                                            "speaker": "派蒙",
                                            "text": "噫！"
                                        },
                                        {
                                            "id": "400814211",
                                            "speaker": "铁骨双刀",
                                            "text": "我不想和你们浪费口舌，所有事情都会在赛场上见分晓。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400814206",
                                    "text": "对付他还不是轻轻松松。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400814212",
                    "text": "哼！",
                    "response": [
                        {
                            "id": "400814213",
                            "speaker": "铁骨双刀",
                            "text": "你！你倒还挺嚣张啊？"
                        },
                        {
                            "id": "400814214",
                            "speaker": "派蒙",
                            "text": "呜哇，你不要和他对着干啦！"
                        },
                        {
                            "id": "400814215",
                            "speaker": "Player",
                            "text": "他凶凶，我气气。"
                        },
                        {
                            "id": "400814216",
                            "speaker": "派蒙",
                            "text": "可是，万一惹恼了他，打起来了该怎么办…"
                        },
                        {
                            "id": "400814217",
                            "speaker": "派蒙",
                            "text": "唔，不对哦！要是打起来了，要提心吊胆的应该是他！那…到时候你可得注意下手的力道啊！"
                        },
                        {
                            "id": "400814218",
                            "speaker": "派蒙",
                            "text": "#总之，这位佣兵，为了你的安全着想，还是不要和{NICKNAME}争起来比较好哦。"
                        },
                        {
                            "id": "400814219",
                            "speaker": "铁骨双刀",
                            "text": "我可是要成为知名驯兽师的人！使用个人武力进行赛场外的斗争，对我而言完全没有意义。"
                        },
                        {
                            "id": "400814220",
                            "speaker": "铁骨双刀",
                            "text": "别浪费时间和我斗嘴了，该干什么就干什么去吧！"
                        }
                    ]
                },
                {
                    "id": "400814221",
                    "text": "告辞！",
                    "response": [
                        {
                            "id": "400814222",
                            "speaker": "铁骨双刀",
                            "text": "快走吧你！"
                        }
                    ]
                }
            ]
        }
    ]
}