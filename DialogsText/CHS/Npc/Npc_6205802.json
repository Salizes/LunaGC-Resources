{
    "talkId": "6205802",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "弘毅": 12
    },
    "dialogues": [
        {
            "id": "620580201",
            "speaker": "Player",
            "text": "你为什么愁眉苦脸的？"
        },
        {
            "id": "620580202",
            "speaker": "弘毅",
            "text": "唉，说起这件事我就头疼。"
        },
        {
            "id": "620580203",
            "speaker": "弘毅",
            "text": "绯云坡附近的水源似乎被污染了，散发着一股腐烂的味道…"
        },
        {
            "id": "620580204",
            "speaker": "弘毅",
            "text": "现在大家取水很不方便，不少人都只能去吃虎岩或者远一点的地方取水。"
        },
        {
            "id": "620580205",
            "speaker": "弘毅",
            "text": "更有甚者，还借着这个机会敛财，他们瞄上那些腿脚不方便、力气不够的老少妇孺，收取高额的搬水费，唉…",
            "choices": [
                {
                    "id": "620580206",
                    "text": "水源为什么会被污染？",
                    "response": [
                        {
                            "id": "620580207",
                            "speaker": "弘毅",
                            "text": "具体原因还不清楚，不能确定是人为因素还是什么其他原因。"
                        },
                        {
                            "id": "620580208",
                            "speaker": "弘毅",
                            "text": "如果是人为因素的话，根据凝光大人亲自修订过的「固土净水镇宅书」，可是要吃一辈子牢饭的。"
                        },
                        {
                            "id": "620580209",
                            "speaker": "弘毅",
                            "text": "第十二则是这么写的——"
                        },
                        {
                            "id": "620580210",
                            "speaker": "弘毅",
                            "text": "「水澈无瑕，瘴毒避之。擅浊其源，大疫出之。无心之失，尚可宽之。滥觞浊淖，严惩毋恕。」"
                        }
                    ]
                },
                {
                    "id": "620580401",
                    "text": "有什么解决办法吗？",
                    "response": [
                        {
                            "id": "620580402",
                            "speaker": "弘毅",
                            "text": "嗯，我正在积极地寻求解决办法，不过…"
                        },
                        {
                            "id": "620580403",
                            "speaker": "弘毅",
                            "text": "我只是一介普通士兵，能做的就只有将这件事报告给长官，然后再由长官继续向上报告…"
                        },
                        {
                            "id": "620580404",
                            "speaker": "弘毅",
                            "text": "在璃月管理土地民生的是璃月七星中的「玉衡」，也就是刻晴大人。"
                        },
                        {
                            "id": "620580405",
                            "speaker": "弘毅",
                            "text": "可是最近璃月港各种事件频发，璃月七星日理万机，也不知道能不能收到我的报告…"
                        }
                    ]
                }
            ]
        }
    ]
}