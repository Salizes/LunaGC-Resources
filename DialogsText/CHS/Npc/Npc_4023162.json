{
    "talkId": "4023162",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 1,
        "塔利雅": 5,
        "派蒙": 5,
        "罗莎莉亚": 5
    },
    "dialogues": [
        {
            "id": "402316201",
            "speaker": "派蒙",
            "text": "玳龟？这东西不应该出现在这里吧。"
        },
        {
            "id": "402316202",
            "speaker": "罗莎莉亚",
            "text": "我也这么认为。"
        },
        {
            "id": "402316203",
            "speaker": "塔利雅",
            "text": "我还没见过这么大的乌龟呢。"
        },
        {
            "id": "402316204",
            "speaker": "塔利雅",
            "text": "我记得小时候有段时间，蒙德城里的小孩子都流行养小乌龟，几乎是人手一只。"
        },
        {
            "id": "402316205",
            "speaker": "派蒙",
            "text": "哦，对啊，好久好久之前，琴团长和迪卢克老爷都说过。"
        },
        {
            "id": "402316206",
            "speaker": "塔利雅",
            "text": "那时候特别流行，我也养过。"
        },
        {
            "id": "402316207",
            "speaker": "罗莎莉亚",
            "text": "不太好养，这种小宠物都不太好养。"
        },
        {
            "id": "402316208",
            "speaker": "派蒙",
            "text": "你、你也养过？"
        },
        {
            "id": "402316209",
            "speaker": "罗莎莉亚",
            "text": "怎么了，很奇怪吗？"
        },
        {
            "id": "402316210",
            "speaker": "派蒙",
            "text": "没有啦…"
        },
        {
            "id": "402316211",
            "speaker": "Player",
            "text": "这个玳龟怎么办呢？"
        },
        {
            "id": "402316212",
            "speaker": "塔利雅",
            "text": "要不然，我带回教会养起来吧，就让它待在教堂的后面，给它造个水池。"
        },
        {
            "id": "402316213",
            "speaker": "塔利雅",
            "text": "看它结结实实的样子，估计很好养的。"
        },
        {
            "id": "402316214",
            "speaker": "罗莎莉亚",
            "text": "…不行。感觉太过结实了，可能会有生物入侵的问题。"
        },
        {
            "id": "402316215",
            "speaker": "罗莎莉亚",
            "text": "麻烦告诉魔女，从哪里弄来的，就还到哪里去吧。"
        },
        {
            "id": "402316216",
            "speaker": "派蒙",
            "text": "好吧…"
        }
    ]
}