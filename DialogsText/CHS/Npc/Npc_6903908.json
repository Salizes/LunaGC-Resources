{
    "talkId": "6903908",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "迪奥娜": 9
    },
    "dialogues": [
        {
            "id": "690390801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690390402",
            "speaker": "迪奥娜",
            "text": "唔…"
        },
        {
            "id": "690390403",
            "speaker": "迪奥娜",
            "text": "#其…其实，有件事，我想请{NICKNAME}你来帮忙。"
        },
        {
            "id": "690390404",
            "speaker": "迪奥娜",
            "text": "平时因为需要调酒和打猎，我都会把头发像这样束起来。"
        },
        {
            "id": "690390405",
            "speaker": "迪奥娜",
            "text": "但是在这里，没有任务，很放松，也不会被别人看到…"
        },
        {
            "id": "690390406",
            "speaker": "迪奥娜",
            "text": "我就想…是不是把头发放下来会更、更好一点…",
            "choices": [
                {
                    "id": "690390407",
                    "text": "迪奥娜按自己喜欢的来就好。",
                    "response": [
                        {
                            "id": "690390409",
                            "speaker": "迪奥娜",
                            "text": "真…真的吗？！"
                        },
                        {
                            "id": "690390410",
                            "speaker": "迪奥娜",
                            "text": "那…那能请你来帮我打理一下吗？"
                        },
                        {
                            "id": "690390411",
                            "speaker": "迪奥娜",
                            "text": "先，先说好！才不是因为我觉得梳毛很舒服才拜托你的！"
                        },
                        {
                            "id": "690390412",
                            "speaker": "迪奥娜",
                            "text": "而且你要是弄疼了我，我可是会咬人的！"
                        }
                    ]
                },
                {
                    "id": "690390408",
                    "text": "放下来也一定很可爱。"
                }
            ]
        }
    ]
}