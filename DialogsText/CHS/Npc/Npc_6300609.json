    "speaker_counts": {
        "Player": 1,
        "小仓澪": 4
    },
    "dialogues": [
        {
            "id": "630060901",
            "speaker": "Player",
            "text": "生意不要紧吧？"
        },
        {
            "id": "630060902",
            "speaker": "小仓澪",
            "text": "多谢客人关心。"
        },
        {
            "id": "630060903",
            "speaker": "小仓澪",
            "text": "虽然布料的货源有些吃紧，但「小仓屋」毕竟是老店，在售的商品品质优秀，名声在外。"
        },
        {
            "id": "630060904",
            "speaker": "小仓澪",
            "text": "再加上因为家兄身为幕府军士，鄙店一直多受天领奉行大人们的关照。"
        },
        {
            "id": "630060905",
            "speaker": "小仓澪",
            "text": "天领奉行里多是居住在上流城区的武士，家眷众多，常来选购价格昂贵的高档着物。所以托大人们的福，鄙店生意尚佳。"
        }
    ]
}