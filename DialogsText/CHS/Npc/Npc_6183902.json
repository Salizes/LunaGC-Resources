    "dialogues": [
        {
            "id": "618390201",
            "speaker": "Player",
            "text": "你也是璃月人吗？"
        },
        {
            "id": "618390202",
            "speaker": "卡斯蒂廖内",
            "text": "不是不是，您误会了，我是来自佩特莉可镇的枫丹人。"
        },
        {
            "id": "618390203",
            "speaker": "卡斯蒂廖内",
            "text": "只不过，既然来到了这如同仙境的宝地，自然要换上璃月雅士的衣冠，方能对得起这满眼的如画江山。"
        }
    ]
}