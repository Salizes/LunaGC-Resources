{
    "talkId": "6906103",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 7,
        "绮良良": 12
    },
    "dialogues": [
        {
            "id": "690610301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690610302",
            "speaker": "绮良良",
            "text": "好呀，有什么想问我的吗？"
        },
        {
            "id": "690610303",
            "speaker": "Player",
            "text": "聊聊快递工作？"
        },
        {
            "id": "690610304",
            "speaker": "绮良良",
            "text": "噢，这个话题好！"
        },
        {
            "id": "690610305",
            "speaker": "绮良良",
            "text": "接单量对我来说不是难事，妖怪的腿脚天生跑得就快。"
        },
        {
            "id": "690610306",
            "speaker": "绮良良",
            "text": "但好评率就没那么容易维持了。怕麻烦，不想多费周折是人之常情…"
        },
        {
            "id": "690610307",
            "speaker": "绮良良",
            "text": "奇怪…为什么是只猫的时候，路过的人会花时间来看我晒太阳，但变成人后就没人愿意多花些时间给个好评呢？",
            "choices": [
                {
                    "id": "690610308",
                    "text": "不辛苦吗？",
                    "response": [
                        {
                            "id": "690610309",
                            "speaker": "绮良良",
                            "text": "可能会有一点吧，尤其在筹备祭典的时候，加急件总会像墩墩桃那样挤在一堆。"
                        },
                        {
                            "id": "690610310",
                            "speaker": "绮良良",
                            "text": "真想妖力变得更强些。这样说不定能跑得更快，或者变出好多个自己。",
                            "choices": [
                                {
                                    "id": "690610311",
                                    "text": "一只猫又两条尾巴…",
                                    "response": [
                                        {
                                            "id": "690610313",
                                            "speaker": "绮良良",
                                            "text": "停停停！再数下去感觉尾巴都要打结了！"
                                        },
                                        {
                                            "id": "690610317",
                                            "speaker": "Player",
                                            "text": "听上去你很热爱工作。"
                                        },
                                        {
                                            "id": "690610318",
                                            "speaker": "绮良良",
                                            "text": "是啊。多亏了它，我才能这样融入人类的城市。"
                                        },
                                        {
                                            "id": "690610319",
                                            "speaker": "绮良良",
                                            "text": "负责一点…才能算「报恩」？"
                                        }
                                    ]
                                },
                                {
                                    "id": "690610312",
                                    "text": "三只猫又六条尾巴…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690610314",
                    "text": "收效如何？",
                    "response": [
                        {
                            "id": "690610315",
                            "speaker": "绮良良",
                            "text": "嘿嘿，我现在是唯一一位，「狛荷屋」金牌级快递员。"
                        },
                        {
                            "id": "690610316",
                            "speaker": "绮良良",
                            "text": "之前老板还想给我一笔特别奖励呢！但我也说了，还是公费出游…啊不，还是多给我些接跨国件的机会更好。"
                        }
                    ]
                }
            ]
        }
    ]
}