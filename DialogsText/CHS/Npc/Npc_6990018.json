{
    "talkId": "6990018",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699001801",
            "speaker": "Player",
            "text": "关于北斗…"
        },
        {
            "id": "699001802",
            "speaker": "派蒙",
            "text": "要怎么样才能成为北斗大姐头那种，又有号召力，又帅气的人物呢！"
        },
        {
            "id": "699001803",
            "speaker": "Player",
            "text": "要有足够的见识…"
        },
        {
            "id": "699001804",
            "speaker": "派蒙",
            "text": "陪你旅行到现在，派蒙已经见过很多东西了！"
        },
        {
            "id": "699001805",
            "speaker": "Player",
            "text": "要经历挫折和苦难…"
        },
        {
            "id": "699001806",
            "speaker": "派蒙",
            "text": "派蒙差点在水里咕嘟咕嘟咕嘟下去了…"
        },
        {
            "id": "699001807",
            "speaker": "Player",
            "text": "要始终怀有鼓舞他人的气概…"
        },
        {
            "id": "699001808",
            "speaker": "派蒙",
            "text": "嗯！派蒙一直支持着你哦。"
        },
        {
            "id": "699001809",
            "speaker": "Player",
            "text": "看待问题要成熟…"
        },
        {
            "id": "699001810",
            "speaker": "派蒙",
            "text": "喂！你就是想说派蒙我没可能了是吧？"
        }
    ]
}