    },
    "dialogues": [
        {
            "id": "651300501",
            "speaker": "Player",
            "text": "是为了重建白淞镇吧。"
        },
        {
            "id": "651300502",
            "speaker": "艾琪诺",
            "text": "嗯…一半一半吧。"
        },
        {
            "id": "651300503",
            "speaker": "艾琪诺",
            "text": "一部分是为了清理水中杂物和那些需要下水的重建工作。还有一部分，是为了追回大家的财物。"
        },
        {
            "id": "651300504",
            "speaker": "艾琪诺",
            "text": "有很多镇上居民的重要物品都被冲进了水里，值钱或者不值钱的，都有不同的意义。"
        },
        {
            "id": "651300505",
            "speaker": "艾琪诺",
            "text": "如果可以的话，我会尽量帮忙找回。"
        }
    ]
}