    "dialogues": [
        {
            "id": "690145101",
            "speaker": "芭芭拉",
            "text": "穿过这座公园的风，带来了熟悉的气息。"
        },
        {
            "id": "690145102",
            "speaker": "芭芭拉",
            "text": "如果午后在这边小憩片刻，听听流水的细语，感觉心情也会跟着放松下来。"
        },
        {
            "id": "690145103",
            "speaker": "芭芭拉",
            "text": "谢谢你！我很喜欢这里！"
        }
    ]
}