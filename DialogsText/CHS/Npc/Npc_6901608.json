{
    "talkId": "6901608",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "迪卢克": 16
    },
    "dialogues": [
        {
            "id": "690160801",
            "speaker": "迪卢克",
            "text": "只是闲聊吗…",
            "choices": [
                {
                    "id": "690160802",
                    "text": "忘记迪卢克不喜欢闲聊了…",
                    "response": [
                        {
                            "id": "690160803",
                            "speaker": "迪卢克",
                            "text": "不。不用那么在意。"
                        },
                        {
                            "id": "690160804",
                            "speaker": "迪卢克",
                            "text": "在你身上花些时间，也是应该的事情。"
                        },
                        {
                            "id": "690160810",
                            "speaker": "迪卢克",
                            "text": "嗯。你还是一如既往地敏锐啊。"
                        },
                        {
                            "id": "690160811",
                            "speaker": "迪卢克",
                            "text": "无论是人的暗中觊觎，还是非人集团的秘密谋划。"
                        },
                        {
                            "id": "690160812",
                            "speaker": "迪卢克",
                            "text": "威胁无孔不入，只要有机可乘。"
                        },
                        {
                            "id": "690160813",
                            "speaker": "迪卢克",
                            "text": "……"
                        },
                        {
                            "id": "690160814",
                            "speaker": "迪卢克",
                            "text": "这应该不是你想听的聊天内容。",
                            "choices": [
                                {
                                    "id": "690160815",
                                    "text": "没关系。",
                                    "response": [
                                        {
                                            "id": "690160816",
                                            "speaker": "迪卢克",
                                            "text": "嗯…"
                                        },
                                        {
                                            "id": "690160817",
                                            "speaker": "迪卢克",
                                            "text": "我得反思一下自己了…"
                                        },
                                        {
                                            "id": "690160821",
                                            "speaker": "迪卢克",
                                            "text": "你所感兴趣的闲聊话题，我也会找到的。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690160818",
                                    "text": "知道你这样守护着蒙德，我就放心了。",
                                    "response": [
                                        {
                                            "id": "690160819",
                                            "speaker": "迪卢克",
                                            "text": "嗯…"
                                        },
                                        {
                                            "id": "690160820",
                                            "speaker": "迪卢克",
                                            "text": "我会的。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690160805",
                    "text": "因为看你一直不太开心的样子？",
                    "response": [
                        {
                            "id": "690160806",
                            "speaker": "迪卢克",
                            "text": "我吗…？我并没有不开心。"
                        },
                        {
                            "id": "690160807",
                            "speaker": "迪卢克",
                            "text": "我只是在思考，在观察，或者在计划着一些事情。"
                        },
                        {
                            "id": "690160808",
                            "speaker": "迪卢克",
                            "text": "不过…我明白你是在关照我。让你担心了。"
                        }
                    ]
                },
                {
                    "id": "690160809",
                    "text": "最近还是在关心着「蒙德」的安全？"
                }
            ]
        }
    ]
}