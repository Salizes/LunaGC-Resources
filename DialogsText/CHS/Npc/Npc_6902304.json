{
    "talkId": "6902304",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "香菱": 17
    },
    "dialogues": [
        {
            "id": "690230401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690230402",
            "speaker": "香菱",
            "text": "想跟你一起去冒险！",
            "choices": [
                {
                    "id": "690230403",
                    "text": "这不是我们一直做的事情吗？",
                    "response": [
                        {
                            "id": "690230404",
                            "speaker": "香菱",
                            "text": "嗯，是的，没错！"
                        },
                        {
                            "id": "690230405",
                            "speaker": "香菱",
                            "text": "但是，这依旧是我第一想做的事情。"
                        },
                        {
                            "id": "690230408",
                            "speaker": "香菱",
                            "text": "想和你一起冒险，探寻未知。收集提瓦特大陆各地神奇的食材，做出好吃的菜肴给你品尝！"
                        },
                        {
                            "id": "690230409",
                            "speaker": "香菱",
                            "text": "嗯…想来想去，都觉得这是最幸福的事情了。"
                        },
                        {
                            "id": "690230410",
                            "speaker": "Player",
                            "text": "（香菱的幸福很简单呢…）"
                        },
                        {
                            "id": "690230411",
                            "speaker": "香菱",
                            "text": "怎、怎么了。"
                        },
                        {
                            "id": "690230412",
                            "speaker": "香菱",
                            "text": "你怎么看着我不说话…是不能答应我的意思吗。"
                        },
                        {
                            "id": "690230413",
                            "speaker": "香菱",
                            "text": "我不会给你的饭菜里加奇怪的佐料的！"
                        },
                        {
                            "id": "690230414",
                            "speaker": "香菱",
                            "text": "呃…即使我有什么灵感，我也会事先征询你的想法！"
                        },
                        {
                            "id": "690230415",
                            "speaker": "香菱",
                            "text": "还，还有…在野外的时候，我不会给你拖后腿的！"
                        },
                        {
                            "id": "690230416",
                            "speaker": "香菱",
                            "text": "惹到了不得的敌人也不做纠缠，逃得更快…",
                            "choices": [
                                {
                                    "id": "690230417",
                                    "text": "没有不答应的意思…",
                                    "response": [
                                        {
                                            "id": "690230418",
                                            "speaker": "香菱",
                                            "text": "呼…吓死我了。"
                                        },
                                        {
                                            "id": "690230421",
                                            "speaker": "香菱",
                                            "text": "那就好，那就好。"
                                        },
                                        {
                                            "id": "690230422",
                                            "speaker": "香菱",
                                            "text": "不过，我也会变得更厉害的。不管是厨艺，还是其他的方面。"
                                        },
                                        {
                                            "id": "690230423",
                                            "speaker": "香菱",
                                            "text": "为了你脸上满足的笑容。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690230419",
                                    "text": "刚刚在想香菱的事情。",
                                    "response": [
                                        {
                                            "id": "690230420",
                                            "speaker": "香菱",
                                            "text": "哦…哦。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690230406",
                    "text": "我还以为香菱会想让我试菜。",
                    "response": [
                        {
                            "id": "690230407",
                            "speaker": "香菱",
                            "text": "试菜也包括在冒险之内！"
                        }
                    ]
                }
            ]
        }
    ]
}