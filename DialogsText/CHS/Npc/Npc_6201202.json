    "dialogues": [
        {
            "id": "620120201",
            "speaker": "Player",
            "text": "你在做什么呢？"
        },
        {
            "id": "620120202",
            "speaker": "小安",
            "text": "工作，你没看到吗？这座码头所有船只无论大小，出海入海、停泊清关都由我经手。"
        },
        {
            "id": "620120203",
            "speaker": "小安",
            "text": "没别的事请不要打扰我，违禁货物审核单…找千岩军队长签字…"
        },
        {
            "id": "620120204",
            "speaker": "Player",
            "text": "原来自言自语也是工作。"
        },
        {
            "id": "620120205",
            "speaker": "小安",
            "text": "…你能别烦我了吗。我是在统计接下来要完成的事项！"
        },
        {
            "id": "620120206",
            "speaker": "小安",
            "text": "…糟了，刚刚记到哪里了来着…"
        }
    ]
}