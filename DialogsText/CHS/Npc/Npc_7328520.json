{
    "talkId": "7328520",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "索希": 8
    },
    "dialogues": [
        {
            "id": "732852001",
            "speaker": "索希",
            "text": "…哦！是斯露莎大人的「谒颂主」。如果有什么想问的，我一定知无不言。",
            "choices": [
                {
                    "id": "732852002",
                    "text": "关于灵光碑…",
                    "response": [
                        {
                            "id": "732852003",
                            "speaker": "索希",
                            "text": "如各位所见，我没有放弃整理矫论团的文献。"
                        },
                        {
                            "id": "732852004",
                            "speaker": "索希",
                            "text": "虽说之前发现文献记录和实际情况有一些出入…"
                        },
                        {
                            "id": "732852005",
                            "speaker": "索希",
                            "text": "但我相信只要仔细分辨，一定能找到真相。"
                        }
                    ]
                },
                {
                    "id": "732852006",
                    "text": "关于愚人众…",
                    "response": [
                        {
                            "id": "732852007",
                            "speaker": "索希",
                            "text": "托各位的福，马尔科佐夫那一批队伍已经撤退了。"
                        },
                        {
                            "id": "732852008",
                            "speaker": "索希",
                            "text": "但这不代表愚人众就会轻易放弃…"
                        },
                        {
                            "id": "732852009",
                            "speaker": "索希",
                            "text": "或许矫论团应该考虑多招募一些有能之士，我是说，至少得比毕洛更可靠。"
                        }
                    ]
                },
                {
                    "id": "732852010",
                    "text": "不打扰你了。",
                    "response": [
                        {
                            "id": "732852011",
                            "speaker": "索希",
                            "text": "太客气了。那我就继续自己的工作了。"
                        }
                    ]
                }
            ]
        }
    ]
}