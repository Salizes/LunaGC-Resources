{
    "talkId": "6902702",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "凝光": 7
    },
    "dialogues": [
        {
            "id": "690270201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690270202",
            "speaker": "凝光",
            "text": "嗯，这里环境舒适，能让人静下心来思考问题。"
        },
        {
            "id": "690270203",
            "speaker": "凝光",
            "text": "就像在群玉阁上的那些日子…",
            "choices": [
                {
                    "id": "690270204",
                    "text": "这里…恐怕比不上群玉阁吧。",
                    "response": [
                        {
                            "id": "690270205",
                            "speaker": "凝光",
                            "text": "哦，你不要误会。"
                        },
                        {
                            "id": "690270208",
                            "speaker": "凝光",
                            "text": "地方好坏不应简单以大小奢简来衡量。"
                        },
                        {
                            "id": "690270209",
                            "speaker": "凝光",
                            "text": "我感受到的，是你在此投入的心意，这让我想起自己当初建造群玉阁时的样子。"
                        },
                        {
                            "id": "690270210",
                            "speaker": "凝光",
                            "text": "换句话说，这里是属于你的「群玉阁」。"
                        }
                    ]
                },
                {
                    "id": "690270206",
                    "text": "过奖了。",
                    "response": [
                        {
                            "id": "690270207",
                            "speaker": "凝光",
                            "text": "我并不是在恭维你。"
                        }
                    ]
                }
            ]
        }
    ]
}