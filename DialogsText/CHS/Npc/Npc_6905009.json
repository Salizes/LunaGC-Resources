{
    "talkId": "6905009",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "托马": 10
    },
    "dialogues": [
        {
            "id": "690500201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690500202",
            "speaker": "托马",
            "text": "哈哈，你完全不用担心，我的适应能力可是很强的。"
        },
        {
            "id": "690500203",
            "speaker": "托马",
            "text": "而且，我很喜欢这里的布设。比方说门口那个圆嘟嘟的鸟…",
            "choices": [
                {
                    "id": "690500204",
                    "text": "那是壶灵阿圆。",
                    "response": [
                        {
                            "id": "690500205",
                            "speaker": "托马",
                            "text": "对对，壶灵阿圆…什么？"
                        },
                        {
                            "id": "690500206",
                            "speaker": "托马",
                            "text": "狐狸神使、狸妖、天狗的传说我都听过，这壶灵的说法我还是第一次听到。"
                        },
                        {
                            "id": "690500207",
                            "speaker": "托马",
                            "text": "有意思，那这个壶妖…哦不，壶灵是你亲手捉到的吗？"
                        },
                        {
                            "id": "690500212",
                            "speaker": "Player",
                            "text": "说来话长，但阿圆不是妖怪。"
                        },
                        {
                            "id": "690500213",
                            "speaker": "托马",
                            "text": "不是妖怪…那这位阿圆大人，该不会是什么地位尊崇的魔神吧？"
                        },
                        {
                            "id": "690500214",
                            "speaker": "托马",
                            "text": "我还摸了它的毛，完了完了…"
                        }
                    ]
                },
                {
                    "id": "690500208",
                    "text": "那是管家阿圆。",
                    "response": [
                        {
                            "id": "690500209",
                            "speaker": "托马",
                            "text": "对对，管家阿圆…什么？"
                        },
                        {
                            "id": "690500210",
                            "speaker": "托马",
                            "text": "哪有聪明到能管家的鸟，等等，那只鸟不会是妖怪吧…"
                        },
                        {
                            "id": "690500211",
                            "speaker": "托马",
                            "text": "哇，越想越不得了，难道你还有退治妖怪的本事？"
                        }
                    ]
                }
            ]
        }
    ]
}