{
    "talkId": "6179202",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 8,
        "乌苏拉": 17
    },
    "dialogues": [
        {
            "id": "617920201",
            "speaker": "Player",
            "text": "怎么值岗的时候还想着薪水？"
        },
        {
            "id": "617920202",
            "speaker": "乌苏拉",
            "text": "因为我是薪水小偷…不对，薪水大盗！"
        },
        {
            "id": "617920203",
            "speaker": "乌苏拉",
            "text": "回荆夫港后，我们的工作排得没那么满了，日子过得悠悠哉哉。"
        },
        {
            "id": "617920204",
            "speaker": "乌苏拉",
            "text": "不像在挪德卡莱，一周都休息不了几个小时。不是在和魔物作战，就是在挖坑，造防御工事，保养武器和搬货…"
        },
        {
            "id": "617920205",
            "speaker": "乌苏拉",
            "text": "相应的，如果有骑士休假，我就可以主动申请替那人干活，拿走那段时间的酬劳！",
            "choices": [
                {
                    "id": "617920206",
                    "text": "这哪里是偷了？",
                    "response": [
                        {
                            "id": "617920208",
                            "speaker": "乌苏拉",
                            "text": "对，对吗？不…不对吧？"
                        },
                        {
                            "id": "617920209",
                            "speaker": "乌苏拉",
                            "text": "到手的薪水变多了，赚的总归是我…没错吧？"
                        },
                        {
                            "id": "617920210",
                            "speaker": "乌苏拉",
                            "text": "而且，不止这种方法能拿到更多摩拉。"
                        },
                        {
                            "id": "617920211",
                            "speaker": "乌苏拉",
                            "text": "在远程小队每月的射术大赛上打进前三名，就有额外的薪水可以偷了！"
                        },
                        {
                            "id": "617920212",
                            "speaker": "乌苏拉",
                            "text": "从开办到现在，我每次都拿到了喔！",
                            "choices": [
                                {
                                    "id": "617920213",
                                    "text": "这哪里是偷了！",
                                    "response": [
                                        {
                                            "id": "617920215",
                                            "speaker": "乌苏拉",
                                            "text": "但是，和大家一起工作很开心，射击很开心，保养铳枪很开心，吃到派发的罐头也很开心…"
                                        },
                                        {
                                            "id": "617920216",
                                            "speaker": "乌苏拉",
                                            "text": "过着开心的生活，还有摩拉拿，怎么想都是我赚，骑士团亏才对吧！"
                                        },
                                        {
                                            "id": "617920217",
                                            "speaker": "Player",
                                            "text": "在攒钱买东西？赚得很少吗？"
                                        },
                                        {
                                            "id": "617920218",
                                            "speaker": "乌苏拉",
                                            "text": "那倒没有，只是因为…《装甲潮流》比较火，星银涂装限量版的统帅座机模型发售得太少，这几年来一直在涨价。"
                                        },
                                        {
                                            "id": "617920219",
                                            "speaker": "乌苏拉",
                                            "text": "我的薪水应该只在副队长下面一个档次…"
                                        },
                                        {
                                            "id": "617920220",
                                            "speaker": "乌苏拉",
                                            "text": "就连我都很难承受得起模型的开销，不知道那些一出手就买下十来台的人，究竟是何方神圣…",
                                            "choices": [
                                                {
                                                    "id": "617920221",
                                                    "text": "那听起来反而蛮多的。",
                                                    "response": [
                                                        {
                                                            "id": "617920223",
                                                            "speaker": "乌苏拉",
                                                            "text": "嘿！除了不能随心所欲地买模型和漫画，我觉得差不多就够了！"
                                                        },
                                                        {
                                                            "id": "617920224",
                                                            "speaker": "乌苏拉",
                                                            "text": "每个月还能留下不少钱，和艾玛托开开心心吃大餐呢！"
                                                        },
                                                        {
                                                            "id": "617920225",
                                                            "speaker": "乌苏拉",
                                                            "text": "要是欧蜜涅别老把艾玛托叫走…就只需要准备好礼物，搞定那个闷闷的方妮雅了。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "617920222",
                                                    "text": "再涨薪可不得了喔。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "617920214",
                                    "text": "你这明明是奖金吧！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "617920207",
                    "text": "你这明明是加班。"
                }
            ]
        }
    ]
}