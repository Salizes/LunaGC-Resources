    "dialogues": [
        {
            "id": "693880101",
            "speaker": "恰斯卡",
            "text": "这一路下来消耗的子弹还真不少，枪管到现在还在发烫。"
        },
        {
            "id": "693880102",
            "speaker": "恰斯卡",
            "text": "我会留在这里保养一下枪支，你不妨也暂停一下，调整好状态吧。"
        },
        {
            "id": "693880103",
            "speaker": "恰斯卡",
            "text": "枪需要休息，人也一样。"
        }
    ]
