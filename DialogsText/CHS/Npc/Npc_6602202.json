        {
            "id": "660220201",
            "speaker": "Player",
            "text": "奇幻？"
        },
        {
            "id": "660220202",
            "speaker": "延塔莎",
            "text": "用最美妙的果实鲜榨，用最神秘的香料佐味，为你带来最丰富的口感！"
        },
        {
            "id": "660220203",
            "speaker": "延塔莎",
            "text": "喝过之后的感觉，就像被大灵送上了世间所有的祝福，如绒翼龙的羽毛一样飞上云端…"
        }
    ]
