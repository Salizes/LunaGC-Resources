    "speaker_counts": {
        "玛塔莉": 5,
        "玛希德": 5
    },
    "dialogues": [
        {
            "id": "641220201",
            "speaker": "玛希德",
            "text": "你说，我要是不那么书呆子，是不是…嗝，以前上学时就能更受欢迎一点…"
        },
        {
            "id": "641220202",
            "speaker": "玛塔莉",
            "text": "嗯嗯，也许吧。"
        },
        {
            "id": "641220203",
            "speaker": "玛希德",
            "text": "你说，我要是…嗝…能和你一样好脾气的话，是不是就能和大家搞好关系了…"
        },
        {
            "id": "641220204",
            "speaker": "玛塔莉",
            "text": "嗯嗯，可能吧。"
        },
        {
            "id": "641220205",
            "speaker": "玛希德",
            "text": "你说，我要是说话做事更委婉…嗝！是不是早就能升职了…"
        },
        {
            "id": "641220206",
            "speaker": "玛塔莉",
            "text": "嗯嗯，是的吧。"
        },
        {
            "id": "641220207",
            "speaker": "玛希德",
            "text": "你说，我这样碌碌无为，是不是辜负了树王大人留下的宝贵遗产…"
        },
        {
            "id": "641220208",
            "speaker": "玛塔莉",
            "text": "嗯…啊，不是的。"
        },
        {
            "id": "641220209",
            "speaker": "玛塔莉",
            "text": "不能这样讲。您现在的工作也十分重要。"
        },
        {
            "id": "641220210",
            "speaker": "玛希德",
            "text": "真、真的吗…嗝…"
        }
    ]
}