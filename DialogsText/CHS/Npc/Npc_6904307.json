{
    "talkId": "6904307",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "砂糖": 10
    },
    "dialogues": [
        {
            "id": "690430701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690430302",
            "speaker": "砂糖",
            "text": "唔，我可能…不太擅长和人聊天。"
        },
        {
            "id": "690430303",
            "speaker": "砂糖",
            "text": "大多数时间，我都是一个人在实验室做研究，一做就是好几个小时。"
        },
        {
            "id": "690430304",
            "speaker": "砂糖",
            "text": "如果遇到了特别不顺的时候，连做几天也是常有的事。"
        },
        {
            "id": "690430305",
            "speaker": "砂糖",
            "text": "外面发生了什么，大家在聊什么有趣的话题。这些我都不太清楚…"
        },
        {
            "id": "690430306",
            "speaker": "砂糖",
            "text": "而且…就算遇到了休息日，我也不太愿意出门社交。",
            "choices": [
                {
                    "id": "690430307",
                    "text": "如果是和我一起出门呢？",
                    "response": [
                        {
                            "id": "690430309",
                            "speaker": "砂糖",
                            "text": "欸…和你的话…"
                        },
                        {
                            "id": "690430310",
                            "speaker": "砂糖",
                            "text": "不行…我还是会不知道要讲什么话才合适。",
                            "choices": [
                                {
                                    "id": "690430311",
                                    "text": "想到什么就讲什么。",
                                    "response": [
                                        {
                                            "id": "690430313",
                                            "speaker": "砂糖",
                                            "text": "嗯…"
                                        },
                                        {
                                            "id": "690430314",
                                            "speaker": "砂糖",
                                            "text": "听上去好像轻松多了。"
                                        },
                                        {
                                            "id": "690430315",
                                            "speaker": "砂糖",
                                            "text": "我可以…试试看。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690430312",
                                    "text": "即使没有话题也不是尴尬的事。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690430308",
                    "text": "如果是和我聊天呢？"
                }
            ]
        }
    ]
}