{
    "talkId": "6912109",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "爱诺": 14
    },
    "dialogues": [
        {
            "id": "691210401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691210402",
            "speaker": "爱诺",
            "text": "嗯…我想帮你改造那台蛋卷机的外观！"
        },
        {
            "id": "691210403",
            "speaker": "爱诺",
            "text": "现在它的出品很标准，但我还想让它变得再特别一点。"
        },
        {
            "id": "691210404",
            "speaker": "爱诺",
            "text": "你喜欢什么形状的？机器人？或者小鸭子会不会更可爱一点？"
        },
        {
            "id": "691210405",
            "speaker": "爱诺",
            "text": "#名字我倒是想好大概的了！就叫咯吱咔啦{NICKNAME}专用款蛋卷机！"
        },
        {
            "id": "691210406",
            "speaker": "Player",
            "text": "机器人模样的是？"
        },
        {
            "id": "691210407",
            "speaker": "爱诺",
            "text": "由机械臂负责操作，在胸口装载上烤箱。"
        },
        {
            "id": "691210408",
            "speaker": "爱诺",
            "text": "等一阵咯吱咔啦声响起后，蛋卷就会从胸口烤箱里弹出来了，嘴里还会吹出糖霜！"
        },
        {
            "id": "691210409",
            "speaker": "Player",
            "text": "那小鸭子形状的呢？"
        },
        {
            "id": "691210410",
            "speaker": "爱诺",
            "text": "在鸭背上放入原料，按一按小鸭子翅膀上的开关。"
        },
        {
            "id": "691210411",
            "speaker": "爱诺",
            "text": "等一阵咯吱咔啦声响起后…锵锵！就能从鸭嘴里拿到它含着的蛋卷了！拿完一卷自动接上下一卷！",
            "choices": [
                {
                    "id": "691210412",
                    "text": "感觉都不错啊…",
                    "response": [
                        {
                            "id": "691210413",
                            "speaker": "爱诺",
                            "text": "犹豫的话，不如两个全做了吧！"
                        },
                        {
                            "id": "691210414",
                            "speaker": "爱诺",
                            "text": "反正结构和原理都不算很复杂，有了想法之后，实现它的过程对于爱诺来说小菜一碟。"
                        },
                        {
                            "id": "691210418",
                            "speaker": "爱诺",
                            "text": "可惜这台蛋卷机拆不出对我有用的材料，还是得回一趟家找点东西…"
                        },
                        {
                            "id": "691210419",
                            "speaker": "爱诺",
                            "text": "我马上就回来！说话算话的，你一定要等我哦！"
                        }
                    ]
                },
                {
                    "id": "691210415",
                    "text": "哇，真好玩！",
                    "response": [
                        {
                            "id": "691210416",
                            "speaker": "爱诺",
                            "text": "是吧是吧，我就知道你肯定会欣赏的！"
                        },
                        {
                            "id": "691210417",
                            "speaker": "爱诺",
                            "text": "那我两个都做出来送给你好了！机械也需要有懂它的人陪伴才行。"
                        }
                    ]
                }
            ]
        }
    ]
}