    "talkId": "6639501",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "查尤霍": 3,
        "泰库马": 4
    },
    "dialogues": [
        {
            "id": "663950101",
            "speaker": "泰库马",
            "text": "好！顺着刚才的气势，再来一组！肌肉可是不会偷懒的！"
        },
        {
            "id": "663950102",
            "speaker": "查尤霍",
            "text": "明白，教练！"
        },
        {
            "id": "663950103",
            "speaker": "泰库马",
            "text": "没错！就是这样！像这样继续下去！肌肉会奖赏，肌肉会承认，肌肉会背负整个部族的未来！"
        },
        {
            "id": "663950104",
            "speaker": "查尤霍",
            "text": "肌…肌肉！"
        },
        {
            "id": "663950105",
            "speaker": "泰库马",
            "text": "你那副表情是怎么回事！你那迟疑是怎么回事！你的迟疑可以锻炼出肌肉吗！"
        },
        {
            "id": "663950106",
            "speaker": "泰库马",
            "text": "要时时刻刻向伊安珊教练学习，新人！更快！更强！更肌肉！"
        },
        {
            "id": "663950107",
            "speaker": "查尤霍",
            "text": "明、明白了，教练！肌肉！"
        }
    ]
}