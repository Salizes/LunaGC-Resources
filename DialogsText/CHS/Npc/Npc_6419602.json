    "dialogues": [
        {
            "id": "641960201",
            "speaker": "Player",
            "text": "你有什么烦恼？"
        },
        {
            "id": "641960202",
            "speaker": "兰伊舍",
            "text": "啊，是那菈朋友。"
        },
        {
            "id": "641960203",
            "speaker": "兰伊舍",
            "text": "那菈朋友不知道无忧节，所以也不会知道兰伊舍的烦恼。"
        },
        {
            "id": "641960204",
            "speaker": "兰伊舍",
            "text": "无忧节开始的时候，所有兰那罗都会回到桓那兰那，会有许多兰那罗找兰伊舍猜谜…"
        },
        {
            "id": "641960205",
            "speaker": "兰伊舍",
            "text": "可是现在谜题还不够，这样大家就会不够吃…"
        }
    ]
}