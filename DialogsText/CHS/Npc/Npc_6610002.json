    "speaker_counts": {
        "Player": 1,
        "瓦伊纳": 4
    },
    "dialogues": [
        {
            "id": "661000201",
            "speaker": "Player",
            "text": "关于你自己…"
        },
        {
            "id": "661000202",
            "speaker": "瓦伊纳",
            "text": "我是「悬木人」部族的首领，叫我瓦伊纳就好。"
        },
        {
            "id": "661000203",
            "speaker": "瓦伊纳",
            "text": "有的人会叫我叔叔，但你可别听他们的，我哪有那么老嘛。"
        },
        {
            "id": "661000204",
            "speaker": "瓦伊纳",
            "text": "「成熟」，可以是一种时尚风格。"
        },
        {
            "id": "661000205",
            "speaker": "瓦伊纳",
            "text": "在我们的部族中，它只能代表我有比其他人更丰富的冒险经验，但并不与我的实际年龄挂钩，懂了吧。"
        }
    ]
}