{
    "talkId": "1402204",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "夏沃蕾寄来的信": 2,
        "娜维娅寄来的信": 2,
        "绮良良寄来的信": 2,
        "艾梅莉埃寄来的信": 2,
        "阅读": 1
    },
    "dialogues": [
        {
            "id": "140220401",
            "speaker": "阅读",
            "text": "桌上散落着一些信件…",
            "choices": [
                {
                    "id": "140220402",
                    "text": "艾梅莉埃寄来的信",
                    "response": [
                        {
                            "id": "140220403",
                            "speaker": "艾梅莉埃寄来的信",
                            "text": "「…非常感谢千织小姐对于香氛的宝贵意见，信中附上新款样品，是我最近尝试的海露香调…」"
                        },
                        {
                            "id": "140220404",
                            "speaker": "艾梅莉埃寄来的信",
                            "text": "「另外，关于下一次试香的安排…」"
                        }
                    ]
                },
                {
                    "id": "140220405",
                    "text": "娜维娅寄来的信",
                    "response": [
                        {
                            "id": "140220406",
                            "speaker": "娜维娅寄来的信",
                            "text": "「今天！傍晚！刺玫会派对！一起来吧！」"
                        },
                        {
                            "id": "140220407",
                            "speaker": "娜维娅寄来的信",
                            "text": "「附言：把爱洛芙也叫上吧！」"
                        }
                    ]
                },
                {
                    "id": "140220408",
                    "text": "绮良良寄来的信",
                    "response": [
                        {
                            "id": "140220409",
                            "speaker": "绮良良寄来的信",
                            "text": "「千织姐，送货途中又有人打听我的衣服是在哪儿买的，说想要为女儿也做一套。」"
                        },
                        {
                            "id": "140220410",
                            "speaker": "绮良良寄来的信",
                            "text": "「在这里附上尺码和照片，下次我到枫丹的时候来你店里取货！」"
                        }
                    ]
                },
                {
                    "id": "140220411",
                    "text": "夏沃蕾寄来的信",
                    "response": [
                        {
                            "id": "140220412",
                            "speaker": "夏沃蕾寄来的信",
                            "text": "「…警备队怀疑审判官…私底下有违法交易。」"
                        },
                        {
                            "id": "140220413",
                            "speaker": "夏沃蕾寄来的信",
                            "text": "「…他妻子…是你店里的常客，帮忙留意。」"
                        }
                    ]
                }
            ]
        }
    ]
}