    "dialogues": [
        {
            "id": "620771101",
            "speaker": "Player",
            "text": "你好，竺子。"
        },
        {
            "id": "620771102",
            "speaker": "竺子",
            "text": "好久不见了，旅行者。"
        },
        {
            "id": "620771103",
            "speaker": "竺子",
            "text": "以前每次遇到你都是在璃月港，没想到现在我回了稻妻，还能再次遇到你。"
        },
        {
            "id": "620771104",
            "speaker": "竺子",
            "text": "你好像经常在各个国家之间旅行，真是了不起呀。"
        }
    ]
