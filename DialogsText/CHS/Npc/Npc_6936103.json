    "dialogues": [
        {
            "id": "693610301",
            "speaker": "艾尔海森",
            "text": "书不少。"
        },
        {
            "id": "693610302",
            "speaker": "艾尔海森",
            "text": "这里放的大多是故事书。智慧宫里很少有这样的书本，说是会耽误学生们进修。"
        },
        {
            "id": "693610303",
            "speaker": "艾尔海森",
            "text": "但如果一个人非得靠外界限制才能勉强写完论文，那他的学术之路也就这样了。"
        }
    ]
}