{
    "talkId": "38307",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "迪卢克": 8
    },
    "dialogues": [
        {
            "id": "3830527",
            "speaker": "迪卢克",
            "text": "即使有了交涉的希望，但与风魔龙也不是没有一战的可能，要做好准备。",
            "choices": [
                {
                    "id": "3830528",
                    "text": "关于「天使的馈赠」。",
                    "response": [
                        {
                            "id": "3830529",
                            "speaker": "迪卢克",
                            "text": "晨曦酒庄的酒，一部分会在「天使的馈赠」酒馆里直销。"
                        },
                        {
                            "id": "3830530",
                            "speaker": "迪卢克",
                            "text": "偶尔我也会在那边做代班酒保，有什么话想跟我说的话，可以趁那时来酒馆找我。"
                        },
                        {
                            "id": "3830531",
                            "speaker": "迪卢克",
                            "text": "不然，可能就要找管家预约了。"
                        }
                    ]
                },
                {
                    "id": "3830532",
                    "text": "为什么帮助我们？",
                    "response": [
                        {
                            "id": "3830533",
                            "speaker": "迪卢克",
                            "text": "只是心血来潮吧，或者说对那个诗人有点兴趣。"
                        },
                        {
                            "id": "3830534",
                            "speaker": "迪卢克",
                            "text": "况且，放任风魔龙为所欲为的话，酒庄的生意也会受到影响。"
                        },
                        {
                            "id": "3830535",
                            "speaker": "迪卢克",
                            "text": "但要注意的一点是，我帮忙的对象是你们，绝不是对骑士团有什么期待。"
                        }
                    ]
                },
                {
                    "id": "3830536",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "3830537",
                            "speaker": "迪卢克",
                            "text": "做好觉悟了吗，我们摘星崖见吧。"
                        }
                    ]
                }
            ]
        }
    ]
}