    "dialogues": [
        {
            "id": "693800301",
            "speaker": "克洛琳德",
            "text": "在下一场战斗来临前，我就在这里读点书吧。"
        },
        {
            "id": "693800302",
            "speaker": "克洛琳德",
            "text": "还请不要向我推荐报纸一类的读物，我知道它们从功能上来说更适合打发短暂的休息时间…"
        },
        {
            "id": "693800303",
            "speaker": "克洛琳德",
            "text": "但我不喜欢。"
        }
    ]
