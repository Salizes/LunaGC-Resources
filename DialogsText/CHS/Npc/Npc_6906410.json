{
    "talkId": "6906410",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "云堇": 14
    },
    "dialogues": [
        {
            "id": "690640301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690640302",
            "speaker": "云堇",
            "text": "正合我意。我憋了许多问题，早就想向你请教了。",
            "choices": [
                {
                    "id": "690640303",
                    "text": "云堇太谦虚了。",
                    "response": [
                        {
                            "id": "690640304",
                            "speaker": "云堇",
                            "text": "你走南闯北，见识比我广博得多。"
                        },
                        {
                            "id": "690640305",
                            "speaker": "云堇",
                            "text": "向你请教，当然得抱有敬意。"
                        },
                        {
                            "id": "690640309",
                            "speaker": "云堇",
                            "text": "咳咳…其实，我偶尔也想放下戏曲，找一段空闲日子远游各国。但戏社内事务繁忙，总是没有机会。"
                        },
                        {
                            "id": "690640310",
                            "speaker": "云堇",
                            "text": "你去过那么多地方，一定十分了解各地风俗。能和我讲讲吗？"
                        },
                        {
                            "id": "690640311",
                            "speaker": "云堇",
                            "text": "嗯…比方说，蒙德骑士们舞起剑来是什么样子，跟我们璃月的武师有何不同？"
                        },
                        {
                            "id": "690640312",
                            "speaker": "云堇",
                            "text": "我还听说，稻妻制造的刀剑也很锋利，稻妻人又是如何铸剑的呢？",
                            "choices": [
                                {
                                    "id": "690640313",
                                    "text": "蒙德骑士擅长西风剑术…",
                                    "response": [
                                        {
                                            "id": "690640314",
                                            "speaker": "云堇",
                                            "text": "像风一样的剑术？难道他们舞剑时能吹起风来？"
                                        },
                                        {
                                            "id": "690640317",
                                            "speaker": "云堇",
                                            "text": "听你说这些真是太有意思了！"
                                        },
                                        {
                                            "id": "690640318",
                                            "speaker": "云堇",
                                            "text": "好，回头我再多准备一些问题。"
                                        },
                                        {
                                            "id": "690640319",
                                            "speaker": "云堇",
                                            "text": "当然啦，不会让你白白费时给我讲这些。回答问题的谢礼，我也会准备最高规格的。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690640315",
                                    "text": "稻妻的师傅会用「玉钢」锻剑…",
                                    "response": [
                                        {
                                            "id": "690640316",
                                            "speaker": "云堇",
                                            "text": "特殊的材料？难怪听说稻妻人在锻造兵器方面很有自信…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690640306",
                    "text": "云堇见外了。",
                    "response": [
                        {
                            "id": "690640307",
                            "speaker": "云堇",
                            "text": "哈哈，你的这份幽默，是走南闯北时历练出来的吗？"
                        },
                        {
                            "id": "690640308",
                            "speaker": "云堇",
                            "text": "那我也不拐弯抹角了。"
                        }
                    ]
                }
            ]
        }
    ]
}