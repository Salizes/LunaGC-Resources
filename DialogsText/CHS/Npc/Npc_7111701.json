    "speaker_counts": {
        "古老的石碑": 8
    },
    "dialogues": [
        {
            "id": "711170101",
            "speaker": "古老的石碑",
            "text": "「鸳鸯于飞，矫游自在。"
        },
        {
            "id": "711170102",
            "speaker": "古老的石碑",
            "text": "鼋鱼上下，鳣鲇群行。"
        },
        {
            "id": "711170103",
            "speaker": "古老的石碑",
            "text": "潜藏山泽，匍匐丛薮。"
        },
        {
            "id": "711170104",
            "speaker": "古老的石碑",
            "text": "碧水虽广，浮鼋犹渡。"
        },
        {
            "id": "711170105",
            "speaker": "古老的石碑",
            "text": "感物兴想，我心长忧。"
        },
        {
            "id": "711170106",
            "speaker": "古老的石碑",
            "text": "鼋桥安在，浮舟茕茕。"
        },
        {
            "id": "711170107",
            "speaker": "古老的石碑",
            "text": "精脍投之，望友得之。"
        },
        {
            "id": "711170108",
            "speaker": "古老的石碑",
            "text": "致饩食之，惟友来飨。」"
        }
    ]
}