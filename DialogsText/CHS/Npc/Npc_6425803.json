    "speaker_counts": {
        "Player": 1,
        "海亚姆": 7
    },
    "dialogues": [
        {
            "id": "642580301",
            "speaker": "Player",
            "text": "关于熙蔓…"
        },
        {
            "id": "642580302",
            "speaker": "海亚姆",
            "text": "……"
        },
        {
            "id": "642580303",
            "speaker": "海亚姆",
            "text": "嗯…？啊，她啊…"
        },
        {
            "id": "642580304",
            "speaker": "海亚姆",
            "text": "「群沙之中出生的孩子，比任何人都珍爱绿色。」这句话或许就是在说她吧…"
        },
        {
            "id": "642580305",
            "speaker": "海亚姆",
            "text": "她本来应该像她父亲一样，成为一个佣兵，在广袤的沙漠冒险的…但她选择了学者的道路。"
        },
        {
            "id": "642580306",
            "speaker": "海亚姆",
            "text": "但是她终究是做佣兵的料，不惜代价，不计后果，连自己的生命都不重视…"
        },
        {
            "id": "642580307",
            "speaker": "海亚姆",
            "text": "我试过理解她，但那时我太年轻了，闹得很不愉快…所以，如你所见，我们分开已经有很多年了…好几十年了。"
        },
        {
            "id": "642580308",
            "speaker": "海亚姆",
            "text": "希望她过得还好。"
        }
    ]
}