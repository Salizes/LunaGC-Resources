    "dialogues": [
        {
            "id": "729350101",
            "speaker": "Player",
            "text": "常道恢弘…"
        },
        {
            "id": "729350102",
            "speaker": "麻纪",
            "text": "…鸣神永恒。"
        },
        {
            "id": "729350103",
            "speaker": "麻纪",
            "text": "没错，这就是雷神大人所追求的「永恒」的力量。看来你对稻妻已经有所了解了。"
        },
        {
            "id": "729350104",
            "speaker": "麻纪",
            "text": "这个小小的花饰就送给你吧。虽然不是神力化形的花朵，但应该也可以较为长久地陪伴着你。祝你好运。"
        }
    ]
}