    "dialogues": [
        {
            "id": "614330601",
            "speaker": "Player",
            "text": "关于西风骑士团。"
        },
        {
            "id": "614330602",
            "speaker": "霍夫曼",
            "text": "…是问我们的近况吗？"
        },
        {
            "id": "614330603",
            "speaker": "霍夫曼",
            "text": "感谢关心，托二位的福，解决了很多棘手的难题。"
        },
        {
            "id": "614330604",
            "speaker": "霍夫曼",
            "text": "没有辜负蒙德民众的期望真是太好了。"
        },
        {
            "id": "614330605",
            "speaker": "霍夫曼",
            "text": "我和我优秀的同僚们，今后也会一如既往地守护人们的幸福——一如既往。"
        }
    ]
}