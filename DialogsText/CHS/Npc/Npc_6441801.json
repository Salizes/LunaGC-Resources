{
    "talkId": "6441801",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "卡格姆尼": 4,
        "库尔苏姆": 7
    },
    "dialogues": [
        {
            "id": "644180101",
            "speaker": "库尔苏姆",
            "text": "知道错了吗？"
        },
        {
            "id": "644180102",
            "speaker": "卡格姆尼",
            "text": "我…我知道了…"
        },
        {
            "id": "644180103",
            "speaker": "库尔苏姆",
            "text": "错在哪了？"
        },
        {
            "id": "644180104",
            "speaker": "卡格姆尼",
            "text": "我…我不该相信谣传…"
        },
        {
            "id": "644180105",
            "speaker": "库尔苏姆",
            "text": "还有吗？"
        },
        {
            "id": "644180106",
            "speaker": "卡格姆尼",
            "text": "还有？还有…还有…不该和您的孙子乱讲？"
        },
        {
            "id": "644180107",
            "speaker": "库尔苏姆",
            "text": "虽然确实不对，但这个是重点吗？"
        },
        {
            "id": "644180108",
            "speaker": "库尔苏姆",
            "text": "光知道错了有什么用，更重要的是行动！"
        },
        {
            "id": "644180109",
            "speaker": "库尔苏姆",
            "text": "你就是因为整日无所事事，才会听信那些莫须有的传言！"
        },
        {
            "id": "644180110",
            "speaker": "库尔苏姆",
            "text": "你这么年轻，现在正是学习知识的好时候，也该读点书了。看看人家塞塔蕾！"
        },
        {
            "id": "644180111",
            "speaker": "卡格姆尼",
            "text": "您、您说的对…"
        }
    ]
}