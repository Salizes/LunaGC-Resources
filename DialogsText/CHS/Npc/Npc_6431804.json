    },
    "dialogues": [
        {
            "id": "643180401",
            "speaker": "Player",
            "text": "要不我去…"
        },
        {
            "id": "643180402",
            "speaker": "卡桑",
            "text": "别、别，没必要。"
        },
        {
            "id": "643180403",
            "speaker": "卡桑",
            "text": "反正我在这也没什么事干，偶尔提醒下他们也还好啦。"
        },
        {
            "id": "643180404",
            "speaker": "卡桑",
            "text": "而且他们最近的注意力好像转到别处去了，有时会大叫着「停运，停运，这不是演习！」朝我冲过来…"
        },
        {
            "id": "643180405",
            "speaker": "卡桑",
            "text": "等等，这么一说好像更麻烦了？"
        }
    ]
}