    "dialogues": [
        {
            "id": "720280101",
            "speaker": "红豆",
            "text": "你放过霄灯了吗？"
        },
        {
            "id": "720280102",
            "speaker": "红豆",
            "text": "偷偷告诉你哦，刚才的霄灯我写的愿望是——"
        },
        {
            "id": "720280103",
            "speaker": "红豆",
            "text": "希望白术哥哥经常来我家做客，这样我就能天天见到他了！"
        },
        {
            "id": "720280104",
            "speaker": "红豆",
            "text": "你的愿望呢？说给我听听呀！"
        }
    ]
