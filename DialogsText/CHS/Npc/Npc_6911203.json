{
    "talkId": "6911203",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 6,
        "爱可菲": 21
    },
    "dialogues": [
        {
            "id": "691120301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691120302",
            "speaker": "爱可菲",
            "text": "当然了，我可有许多问题想要问你呢，你这是自投罗网~",
            "choices": [
                {
                    "id": "691120303",
                    "text": "我，我犯事了？",
                    "response": [
                        {
                            "id": "691120305",
                            "speaker": "爱可菲",
                            "text": "不用紧张，都是好事。"
                        },
                        {
                            "id": "691120306",
                            "speaker": "爱可菲",
                            "text": "你是我认识的人中，游历过最多国家，见闻最广，战胜的敌人也最强的孤例。"
                        },
                        {
                            "id": "691120307",
                            "speaker": "爱可菲",
                            "text": "那么，请听主厨的问题——有没有什么食材，或是潜在的食物…让你好奇过它的味道？"
                        },
                        {
                            "id": "691120308",
                            "speaker": "爱可菲",
                            "text": "哦…咳咳，我没有怂恿你去扮演异食癖患者的意思。"
                        },
                        {
                            "id": "691120309",
                            "speaker": "爱可菲",
                            "text": "我是想试试，假如你给我出一些刁钻的「风味模拟」难题，我能否用替代食材完美地模拟出来。"
                        },
                        {
                            "id": "691120310",
                            "speaker": "爱可菲",
                            "text": "能让你都好奇的风味，在「技术料理」领域，应该算是至高难度的挑战了。",
                            "choices": [
                                {
                                    "id": "691120311",
                                    "text": "我很保守，不想乱吃东西。",
                                    "response": [
                                        {
                                            "id": "691120312",
                                            "speaker": "爱可菲",
                                            "text": "哦？出乎意料的答案。"
                                        },
                                        {
                                            "id": "691120313",
                                            "speaker": "爱可菲",
                                            "text": "某些时候，有限的好奇心对于身体健康的确是一道保险，能让你避开越界的「新鲜料理」，和惨痛的食物中毒…"
                                        },
                                        {
                                            "id": "691120314",
                                            "speaker": "爱可菲",
                                            "text": "不过，我也有信心，用前所未有的惊喜风味拓展你的舒适圈~"
                                        }
                                    ]
                                },
                                {
                                    "id": "691120315",
                                    "text": "…比如史莱姆和飘浮灵？",
                                    "response": [
                                        {
                                            "id": "691120316",
                                            "speaker": "爱可菲",
                                            "text": "啊，出现了，「元素生物的味道」，几百年来的经典命题！"
                                        },
                                        {
                                            "id": "691120317",
                                            "speaker": "爱可菲",
                                            "text": "许多人通过颜色，将它们与对应的水果联系起来，常见的传言有：冰史莱姆是薄荷味，雷史莱姆就像钩钩果…"
                                        },
                                        {
                                            "id": "691120318",
                                            "speaker": "爱可菲",
                                            "text": "但是，根据我的取样，我发现它们的凝液中还有许多反直觉的物质。比如水史莱姆其实完全无味，而不像海灵芝…"
                                        },
                                        {
                                            "id": "691120319",
                                            "speaker": "爱可菲",
                                            "text": "火史莱姆除了包含璃月食材绝云椒椒的辣味，还隐含总量较少但烈度极高的甜。"
                                        },
                                        {
                                            "id": "691120320",
                                            "speaker": "爱可菲",
                                            "text": "下一道茶点，我就模拟这甜味给你试试！"
                                        }
                                    ]
                                },
                                {
                                    "id": "691120321",
                                    "text": "发条机关可堪一战。",
                                    "response": [
                                        {
                                            "id": "691120322",
                                            "speaker": "爱可菲",
                                            "text": "居然对金属和能量体的味道感兴趣吗？有意思！"
                                        },
                                        {
                                            "id": "691120323",
                                            "speaker": "爱可菲",
                                            "text": "我小时候也好奇过，白铁是什么味道的？进口的星银呢？"
                                        },
                                        {
                                            "id": "691120324",
                                            "speaker": "爱可菲",
                                            "text": "结果不出意外，都很难吃…前者有种两成泥土，三成干草和五成白蜡混在一起的感觉。"
                                        },
                                        {
                                            "id": "691120325",
                                            "speaker": "爱可菲",
                                            "text": "后者确实有种冰雪的味道，但混进了刷墙用的石灰，小试一口，就要不停咳嗽大几十口。"
                                        },
                                        {
                                            "id": "691120326",
                                            "speaker": "爱可菲",
                                            "text": "至于能量体，比如芒荒能量块，我真的没敢尝试，但我推测，它们会对舌头造成伤害，所以会有麻痹感。"
                                        },
                                        {
                                            "id": "691120327",
                                            "speaker": "爱可菲",
                                            "text": "要在一道菜肴里还原这种味道，的确有些挑战。基础载体就选冰沙好了，等到天气再炎热点，就让你尝个鲜！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691120304",
                    "text": "我，我是问题磁铁？"
                }
            ]
        }
    ]
}