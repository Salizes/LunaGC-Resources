{
    "talkId": "6911204",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 7,
        "爱可菲": 16
    },
    "dialogues": [
        {
            "id": "691120401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691120402",
            "speaker": "爱可菲",
            "text": "很多哦，多到我自己都要评价我自己贪心了——"
        },
        {
            "id": "691120403",
            "speaker": "爱可菲",
            "text": "我想学习绘画，变得像画家一样熟知千种万种色彩，探索它们对人的情绪与味觉的影响，改善以后对菜肴的调色；"
        },
        {
            "id": "691120404",
            "speaker": "爱可菲",
            "text": "我想研究工程学，以便改进现有的两种机关，争取在单位时间内独自完成一个厨师小组的工作量；"
        },
        {
            "id": "691120405",
            "speaker": "爱可菲",
            "text": "我想了解锻刀的技巧，如此一来，我就能亲自制作自己需要的三十三种厨刀，对每种食材进行最细致的处理；"
        },
        {
            "id": "691120406",
            "speaker": "爱可菲",
            "text": "我还想成为杰出的作曲家，给自己的每道菜肴配上专属的乐曲，让食客们品味它们时，达成听觉与味觉的通感…"
        },
        {
            "id": "691120407",
            "speaker": "爱可菲",
            "text": "但想来想去，其实这些贪心的念头又很单调，因为它们都在为一件事服务，那就是提升厨艺。"
        },
        {
            "id": "691120408",
            "speaker": "爱可菲",
            "text": "看来，我这辈子就离不开烹饪啦…",
            "choices": [
                {
                    "id": "691120409",
                    "text": "专心致志很好哦。",
                    "response": [
                        {
                            "id": "691120411",
                            "speaker": "爱可菲",
                            "text": "其实我也知道，我所说的每个想法，要付诸现实，至少都需要好几十年的不懈努力。"
                        },
                        {
                            "id": "691120412",
                            "speaker": "爱可菲",
                            "text": "就像烹饪本身，远远不止外行看着「按步骤把食材处理好就行」那么简单，可不能瞧不起任何一门学问的难度！"
                        },
                        {
                            "id": "691120413",
                            "speaker": "爱可菲",
                            "text": "但我觉得，如果是你，说不定真能同时活成…我贪心念想的模样。",
                            "choices": [
                                {
                                    "id": "691120414",
                                    "text": "我…我吗？",
                                    "response": [
                                        {
                                            "id": "691120416",
                                            "speaker": "爱可菲",
                                            "text": "没错，在我的认知中，你从不被常理束缚，有着无限的可能。"
                                        },
                                        {
                                            "id": "691120417",
                                            "speaker": "爱可菲",
                                            "text": "而且，你的意志力、执行力和判断力都无可挑剔。"
                                        },
                                        {
                                            "id": "691120418",
                                            "speaker": "爱可菲",
                                            "text": "如果要说世界上有谁能同时学会如此之多的技艺，我只能想到你了。",
                                            "choices": [
                                                {
                                                    "id": "691120419",
                                                    "text": "承蒙爱可菲老师夸奖…",
                                                    "response": [
                                                        {
                                                            "id": "691120421",
                                                            "speaker": "爱可菲",
                                                            "text": "嗯哼~等到你掌握了上述这些技巧，就该轮到你来指导我下厨了。"
                                                        },
                                                        {
                                                            "id": "691120422",
                                                            "speaker": "爱可菲",
                                                            "text": "按照设想中的趋势，到时候，我们可能整天整天泡在厨房里，甚至创造不可思议的料理，用厨房装下大半个提瓦特！"
                                                        },
                                                        {
                                                            "id": "691120423",
                                                            "speaker": "爱可菲",
                                                            "text": "真是太令人激动了！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691120420",
                                                    "text": "有道理，我努努力应该能做到！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691120415",
                                    "text": "我精通这么多学问？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691120410",
                    "text": "三心二意容易一场空。"
                }
            ]
        }
    ]
}