    "speaker_counts": {
        "老孙": 4,
        "老高": 4
    },
    "dialogues": [
        {
            "id": "620350501",
            "speaker": "老高",
            "text": "孙弟，今天赚了不少吧？"
        },
        {
            "id": "620350502",
            "speaker": "老孙",
            "text": "来，这是小弟孝敬您的，全靠高兄的妙计啊！"
        },
        {
            "id": "620350503",
            "speaker": "老高",
            "text": "哼哼，那帮人肯定想不到，这一切都在我的计划之内！"
        },
        {
            "id": "620350504",
            "speaker": "老孙",
            "text": "高兄就是高！肯定没人能想到咱们是一伙的，别人一看您的价格，再看我这边的价格，肯定就觉得自己赚到了！"
        },
        {
            "id": "620350505",
            "speaker": "老高",
            "text": "哈哈哈哈，孙弟，喝酒喝酒！"
        },
        {
            "id": "620350506",
            "speaker": "老孙",
            "text": "来，高兄，我给你满上！"
        },
        {
            "id": "620350507",
            "speaker": "老高",
            "text": "好！今晚我们一定要一醉方休，哈哈哈哈！"
        },
        {
            "id": "620350508",
            "speaker": "老孙",
            "text": "不说了，都在酒里！"
        }
    ]
}