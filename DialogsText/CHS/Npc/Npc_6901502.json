{
    "talkId": "6901502",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "凯亚": 8
    },
    "dialogues": [
        {
            "id": "690150201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690150701",
            "speaker": "凯亚",
            "text": "哦，习惯得很。"
        },
        {
            "id": "690150702",
            "speaker": "凯亚",
            "text": "唔，只说「习惯」的话怎么想都会觉得程度不够吧。"
        },
        {
            "id": "690150703",
            "speaker": "凯亚",
            "text": "最初的确是「大吃一惊」。",
            "choices": [
                {
                    "id": "690150704",
                    "text": "惊喜的那种？",
                    "response": [
                        {
                            "id": "690150705",
                            "speaker": "凯亚",
                            "text": "嗯，没错！"
                        },
                        {
                            "id": "690150708",
                            "speaker": "凯亚",
                            "text": "这里比我当初想象得更漂亮。"
                        },
                        {
                            "id": "690150709",
                            "speaker": "凯亚",
                            "text": "但是，待的时间长了，吃惊的感觉没留下多少。倒是因为这种自在，产生了点归属感。"
                        },
                        {
                            "id": "690150710",
                            "speaker": "凯亚",
                            "text": "真是难得啊…"
                        }
                    ]
                },
                {
                    "id": "690150706",
                    "text": "惊吓的那种？",
                    "response": [
                        {
                            "id": "690150707",
                            "speaker": "凯亚",
                            "text": "哎——当然是惊喜的那种啦。"
                        }
                    ]
                }
            ]
        }
    ]
}