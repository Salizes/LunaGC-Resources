{
    "talkId": "6906904",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 7,
        "提纳里": 20
    },
    "dialogues": [
        {
            "id": "690690401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690690402",
            "speaker": "提纳里",
            "text": "我吗？正在思考一些最近需要处理的待办事项。"
        },
        {
            "id": "690690403",
            "speaker": "提纳里",
            "text": "这周内要去禅那园观察并记录试验结果，另外巡林员们的值班次序也差不多该更替了…"
        },
        {
            "id": "690690404",
            "speaker": "提纳里",
            "text": "不过这些都不急，可以等。"
        },
        {
            "id": "690690405",
            "speaker": "提纳里",
            "text": "你呢，有没有什么特别想做的事情？"
        },
        {
            "id": "690690406",
            "speaker": "Player",
            "text": "唔…没…"
        },
        {
            "id": "690690407",
            "speaker": "提纳里",
            "text": "哦？竟然没有想法吗？"
        },
        {
            "id": "690690408",
            "speaker": "提纳里",
            "text": "那我就不客气了。请回答我一个问题吧。"
        },
        {
            "id": "690690409",
            "speaker": "提纳里",
            "text": "你是不是——很想摸我的耳朵呀？",
            "choices": [
                {
                    "id": "690690410",
                    "text": "你这是…反客为主！",
                    "response": [
                        {
                            "id": "690690411",
                            "speaker": "提纳里",
                            "text": "这不怪我哈，我可是给过你主动的机会了。"
                        },
                        {
                            "id": "690690414",
                            "speaker": "提纳里",
                            "text": "其实我嘛…并不介意熟悉的人碰我的耳朵哦？"
                        },
                        {
                            "id": "690690415",
                            "speaker": "提纳里",
                            "text": "不过不知怎么搞的，大家似乎一致认定我会因为这件事情生气。"
                        },
                        {
                            "id": "690690416",
                            "speaker": "提纳里",
                            "text": "渐渐地，「在提纳里面前故意逃避耳朵和尾巴的话题」变成了像是潜规则一样的东西。"
                        },
                        {
                            "id": "690690417",
                            "speaker": "提纳里",
                            "text": "有时看着他们想说些什么又马上吞回去的表情，还挺有意思的。"
                        },
                        {
                            "id": "690690418",
                            "speaker": "提纳里",
                            "text": "也算是好事吧。毕竟那些半生不熟的人要是上来就想对你动手动脚，也很麻烦呢。"
                        },
                        {
                            "id": "690690419",
                            "speaker": "Player",
                            "text": "所以说，我可以…"
                        },
                        {
                            "id": "690690420",
                            "speaker": "提纳里",
                            "text": "嗯，没问题哦。"
                        },
                        {
                            "id": "690690421",
                            "speaker": "提纳里",
                            "text": "不过实际摸上去可能没有你想象的手感那么好啦，其实就跟摸普通的猫猫狗狗是差不多的感觉。",
                            "choices": [
                                {
                                    "id": "690690422",
                                    "text": "我觉得好，应该多给几次机会。",
                                    "response": [
                                        {
                                            "id": "690690424",
                                            "speaker": "提纳里",
                                            "text": "得寸进尺是吧？"
                                        },
                                        {
                                            "id": "690690425",
                                            "speaker": "提纳里",
                                            "text": "…唉，好吧好吧。"
                                        },
                                        {
                                            "id": "690690426",
                                            "speaker": "提纳里",
                                            "text": "只要你觉得好，那就是真的好。"
                                        },
                                        {
                                            "id": "690690427",
                                            "speaker": "提纳里",
                                            "text": "如果是你的话，就算合影五百次都行，摸两下又算什么呢。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690690423",
                                    "text": "嘿嘿，那尾巴也…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690690412",
                    "text": "呀！被看穿了吗？",
                    "response": [
                        {
                            "id": "690690413",
                            "speaker": "提纳里",
                            "text": "你的目光一直在不受控制地往上瞟呢。"
                        }
                    ]
                }
            ]
        }
    ]
}