{
    "talkId": "6204902",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "独孤朔": 9
    },
    "dialogues": [
        {
            "id": "620490201",
            "speaker": "独孤朔",
            "text": "大侠…？"
        },
        {
            "id": "620490202",
            "speaker": "独孤朔",
            "text": "干嘛这么看着我！"
        },
        {
            "id": "620490203",
            "speaker": "独孤朔",
            "text": "你的眼睛分明在说「身高还没有剑高的小豆丁怎么可能会是大侠」，你心里一定是这么想的！"
        },
        {
            "id": "620490204",
            "speaker": "独孤朔",
            "text": "哼，有了铁匠叔叔给的这把剑，本大侠已经不怕任何坏蛋了！"
        },
        {
            "id": "620490205",
            "speaker": "独孤朔",
            "text": "等以后再得到岩元素的神之眼，本大侠就是天下第一侠客了！"
        },
        {
            "id": "620490206",
            "speaker": "独孤朔",
            "text": "为什么是岩元素？"
        },
        {
            "id": "620490207",
            "speaker": "独孤朔",
            "text": "那还用说！"
        },
        {
            "id": "620490208",
            "speaker": "独孤朔",
            "text": "要是有了岩元素的神之眼，本大侠就可以操控元素立起一个高高的石柱，然后本大侠就站在上面！"
        },
        {
            "id": "620490209",
            "speaker": "独孤朔",
            "text": "到那时，所有的人都得仰视本大侠，哈哈哈哈…"
        }
    ]
}