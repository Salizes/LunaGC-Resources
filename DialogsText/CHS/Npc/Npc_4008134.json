{
    "talkId": "4008134",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 4,
        "左右加": 15,
        "派蒙": 3
    },
    "dialogues": [
        {
            "id": "400813401",
            "speaker": "左右加",
            "text": "两位，你们也来训练了！",
            "choices": [
                {
                    "id": "400813402",
                    "text": "训练的进展如何？",
                    "response": [
                        {
                            "id": "400813403",
                            "speaker": "左右加",
                            "text": "一切顺利！我的王牌蕈兽「信风舞姬」表现得特别出色！"
                        },
                        {
                            "id": "400813404",
                            "speaker": "左右加",
                            "text": "预赛的时候，我几乎完全是靠着「信风舞姬」的力量战胜对手的，这也让我发现了队伍的不足之处。"
                        },
                        {
                            "id": "400813405",
                            "speaker": "左右加",
                            "text": "嗯，只有在剧情前期向读者揭示一些隐患，尽早埋下伏笔，才能让后来的转折合情合理，或是让主角的失败更有说服力。"
                        },
                        {
                            "id": "400813406",
                            "speaker": "左右加",
                            "text": "预赛对我作为驯兽师这个角色而言的意义，大抵就是这样。"
                        },
                        {
                            "id": "400813407",
                            "speaker": "左右加",
                            "text": "从这个角度考虑，「信风舞姬」起到了相当重要的作用，简直就像是主角的模范伙伴！"
                        },
                        {
                            "id": "400813408",
                            "speaker": "派蒙",
                            "text": "左右加小姐不知不觉就进入状态了…真厉害！"
                        }
                    ]
                },
                {
                    "id": "400813409",
                    "text": "取材的进展如何？",
                    "response": [
                        {
                            "id": "400813410",
                            "speaker": "左右加",
                            "text": "不…不瞒你们说，除了比赛的部分之外，好像就没什么进度了…"
                        },
                        {
                            "id": "400813411",
                            "speaker": "左右加",
                            "text": "八重大人嘱咐过我，既然参加了比赛，就应该先揣摩驯兽师的心境，快快进入角色。"
                        },
                        {
                            "id": "400813412",
                            "speaker": "左右加",
                            "text": "这样一来，我在每一场比赛中都能收获很多文思。"
                        },
                        {
                            "id": "400813413",
                            "speaker": "左右加",
                            "text": "不过，比赛是小说的主题，每次比赛都是重要的章节，但章节之间还需要很多日常情节来进行填充。"
                        },
                        {
                            "id": "400813414",
                            "speaker": "左右加",
                            "text": "关于日常情节的部分，目前我只有一份大纲，还完全不知道该怎么细化。"
                        },
                        {
                            "id": "400813415",
                            "speaker": "左右加",
                            "text": "如果和八重大人一起去各种地方游玩…或许就会有灵感的！"
                        },
                        {
                            "id": "400813416",
                            "speaker": "Player",
                            "text": "不会太紧张吗？"
                        },
                        {
                            "id": "400813417",
                            "speaker": "派蒙",
                            "text": "就是啊，感觉神子在身边的时候，你都紧张得说不出话了，那一起旅行的时候，还能睡得着吗？"
                        },
                        {
                            "id": "400813418",
                            "speaker": "派蒙",
                            "text": "吃饭的时候，会不会连餐具都拿不稳？"
                        },
                        {
                            "id": "400813419",
                            "speaker": "左右加",
                            "text": "哪里有这么夸张啊！我也不是时时刻刻都害怕被八重大人催稿的！"
                        },
                        {
                            "id": "400813420",
                            "speaker": "左右加",
                            "text": "咳咳…总之作为一个小说作者，和八重大人一起旅行，是最荣幸最快乐的事情！肯定能让我找到足够用上好几年的素材！"
                        }
                    ]
                },
                {
                    "id": "400813421",
                    "text": "加油啊，左右加小姐！",
                    "response": [
                        {
                            "id": "400813422",
                            "speaker": "左右加",
                            "text": "实在太感谢了！我的斗志开始燃烧了！"
                        }
                    ]
                }
            ]
        }
    ]
}