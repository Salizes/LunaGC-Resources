{
    "talkId": "6912108",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 8,
        "爱诺": 10
    },
    "dialogues": [
        {
            "id": "691210301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691210302",
            "speaker": "爱诺",
            "text": "好呀。不过…你能一起帮我找找看我的精密机械用六角螺母吗？"
        },
        {
            "id": "691210303",
            "speaker": "Player",
            "text": "上次见到时在哪里？"
        },
        {
            "id": "691210304",
            "speaker": "爱诺",
            "text": "嘿嘿…记不得了。"
        },
        {
            "id": "691210305",
            "speaker": "Player",
            "text": "上回用是什么时候？"
        },
        {
            "id": "691210306",
            "speaker": "爱诺",
            "text": "几小时？半天前？还是一天来着…我的时间概念没有那么清楚啦，一旦忙碌起来，就没有余力观察天色了嘛。"
        },
        {
            "id": "691210307",
            "speaker": "Player",
            "text": "以前是怎么解决的？"
        },
        {
            "id": "691210308",
            "speaker": "爱诺",
            "text": "嗯…找不到东西，或者不小心弄乱房间了之后，我会习惯性地喊一声：伊涅芙——"
        },
        {
            "id": "691210309",
            "speaker": "爱诺",
            "text": "虽然很有可能会被伊涅芙数落，但更有可能得到有效解决！"
        },
        {
            "id": "691210310",
            "speaker": "爱诺",
            "text": "对了！你身边没有人帮忙，你是怎么避免这些问题出现的呢？",
            "choices": [
                {
                    "id": "691210311",
                    "text": "我会花一些时间打理…",
                    "response": [
                        {
                            "id": "691210313",
                            "speaker": "爱诺",
                            "text": "可是我在机械制作上已经花了很多时间…如果还要为收拾东西花额外时间的话，还哪里有时间吃点心呢？",
                            "choices": [
                                {
                                    "id": "691210314",
                                    "text": "原来问题是出在点心上…",
                                    "response": [
                                        {
                                            "id": "691210316",
                                            "speaker": "爱诺",
                                            "text": "欸？！不行呀！你要和爱诺统一战线！我们可是点心同盟！"
                                        },
                                        {
                                            "id": "691210317",
                                            "speaker": "爱诺",
                                            "text": "你一定是太久没吃到香香脆脆的饼干，忘记了它的滋味。正好我带着多的，我来分给…"
                                        },
                                        {
                                            "id": "691210318",
                                            "speaker": "爱诺",
                                            "text": "欸！我的六角螺母！原来是藏在袖子里了！"
                                        }
                                    ]
                                },
                                {
                                    "id": "691210315",
                                    "text": "突然更加理解伊涅芙了…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691210312",
                    "text": "养成习惯就还好…"
                }
            ]
        }
    ]
}