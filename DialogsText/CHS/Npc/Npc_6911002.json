{
    "talkId": "6911002",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "伊安珊": 7
    },
    "dialogues": [
        {
            "id": "691100201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691100202",
            "speaker": "伊安珊",
            "text": "很不错，空气清新，有益身心。"
        },
        {
            "id": "691100203",
            "speaker": "伊安珊",
            "text": "不过，我好像没看到专门用来锻炼的地方啊…要不我帮你搭一间健身房？设计图还有器材的事都可以交给我去办。",
            "choices": [
                {
                    "id": "691100204",
                    "text": "好啊。",
                    "response": [
                        {
                            "id": "691100205",
                            "speaker": "伊安珊",
                            "text": "嗯，那我得认真规划一下了。"
                        },
                        {
                            "id": "691100206",
                            "speaker": "伊安珊",
                            "text": "首先器材就得仔细选选，很多人健身时伤到身体就是因为用了不趁手的器材。"
                        },
                        {
                            "id": "691100207",
                            "speaker": "伊安珊",
                            "text": "这样吧，先等一段时间，我直接找熟人给你定做一套。"
                        }
                    ]
                },
                {
                    "id": "691100208",
                    "text": "外出探险就是我的锻炼。",
                    "response": [
                        {
                            "id": "691100209",
                            "speaker": "伊安珊",
                            "text": "这样说倒也没错…每个人对健身的喜好都不一样。"
                        },
                        {
                            "id": "691100210",
                            "speaker": "伊安珊",
                            "text": "不是所有人都喜欢跟器材较劲，爬爬山，去田野里跑几个来回，这些运动方式确实更适合你这样的旅者。"
                        }
                    ]
                }
            ]
        }
    ]
}