    "dialogues": [
        {
            "id": "741083901",
            "speaker": "Player",
            "text": "你…"
        },
        {
            "id": "741083902",
            "speaker": "欧菲妮",
            "text": "我是本次航行的导览员欧菲妮。"
        },
        {
            "id": "741083903",
            "speaker": "Player",
            "text": "我想问的是…"
        },
        {
            "id": "741083904",
            "speaker": "欧菲妮",
            "text": "美露莘是诞生在枫丹的年轻种族，与人有许多区别。"
        },
        {
            "id": "741083905",
            "speaker": "Player",
            "text": "关于美露莘，还有什么…"
        },
        {
            "id": "741083906",
            "speaker": "欧菲妮",
            "text": "#关于美露莘确实有一个秘密可以与乘客{M#先生}{F#小姐}您分享。"
        },
        {
            "id": "741083907",
            "speaker": "欧菲妮",
            "text": "美露莘有一点与人很相似：不同的美露莘有不同的性格。有的美露莘喜欢聊天，有的不喜欢。"
        }
    ]
}