{
    "talkId": "6902707",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "凝光": 10
    },
    "dialogues": [
        {
            "id": "690270701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690270301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690270302",
            "speaker": "凝光",
            "text": "聊天？你的意思是，有什么商业问题想同我探讨吗？"
        },
        {
            "id": "690270303",
            "speaker": "Player",
            "text": "不…只是简单的聊天而已。"
        },
        {
            "id": "690270304",
            "speaker": "凝光",
            "text": "有意思…那些富商巨贾，都为请我吃一顿饭而挤破头皮。"
        },
        {
            "id": "690270305",
            "speaker": "凝光",
            "text": "而你，却只是想和我「简单」聊几句？",
            "choices": [
                {
                    "id": "690270306",
                    "text": "我没有那么多钱…",
                    "response": [
                        {
                            "id": "690270307",
                            "speaker": "凝光",
                            "text": "哈，说笑了。"
                        },
                        {
                            "id": "690270310",
                            "speaker": "凝光",
                            "text": "知道吗？他们送我的东西极尽奢华…"
                        },
                        {
                            "id": "690270311",
                            "speaker": "凝光",
                            "text": "但那只不过是期待从我的只言片语中嗅到商界的动向罢了。"
                        },
                        {
                            "id": "690270312",
                            "speaker": "凝光",
                            "text": "正因如此，与你在此轻松闲聊的时光，对我来说才显得弥足珍贵。"
                        },
                        {
                            "id": "690270313",
                            "speaker": "凝光",
                            "text": "这是再多摩拉都换不到的。"
                        },
                        {
                            "id": "690270314",
                            "speaker": "凝光",
                            "text": "所以，再这样陪我一会儿吧，聊聊那些在你看来「简单」的话题。什么都好。"
                        }
                    ]
                },
                {
                    "id": "690270308",
                    "text": "我们聊凝光喜欢的话题就好。",
                    "response": [
                        {
                            "id": "690270309",
                            "speaker": "凝光",
                            "text": "…你果然和别人不太一样。"
                        }
                    ]
                }
            ]
        }
    ]
}