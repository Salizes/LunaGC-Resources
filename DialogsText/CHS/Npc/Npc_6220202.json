{
    "talkId": "6220202",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "淮安": 9
    },
    "dialogues": [
        {
            "id": "622020201",
            "speaker": "Player",
            "text": "最近生意如何？"
        },
        {
            "id": "622020202",
            "speaker": "淮安",
            "text": "托您关照，生意一直都还行。日子过得去。"
        },
        {
            "id": "622020203",
            "speaker": "淮安",
            "text": "哈哈哈。又到了该活络起来的时候了。",
            "choices": [
                {
                    "id": "622020306",
                    "text": "关于传闻…",
                    "response": [
                        {
                            "id": "622020307",
                            "speaker": "淮安",
                            "text": "传闻，什么传闻？"
                        },
                        {
                            "id": "622020308",
                            "speaker": "淮安",
                            "text": "如果是关于我们望舒客栈的诽谤谣言，那全部都不可信。"
                        },
                        {
                            "id": "622020309",
                            "speaker": "淮安",
                            "text": "如果是说有什么有趣的事情。"
                        },
                        {
                            "id": "622020310",
                            "speaker": "淮安",
                            "text": "最近璃月港的愚人众变多了。山雨欲来啊。"
                        },
                        {
                            "id": "622020311",
                            "speaker": "淮安",
                            "text": "您倒是有什么有意思的事情能和我分享分享的？"
                        }
                    ]
                },
                {
                    "id": "622020312",
                    "text": "关于这狗…",
                    "response": [
                        {
                            "id": "622020313",
                            "speaker": "淮安",
                            "text": "狗，狗当然叫旺财了。"
                        },
                        {
                            "id": "622020314",
                            "speaker": "淮安",
                            "text": "它挺懂事的，又爱干净，不会给客人添麻烦的。"
                        }
                    ]
                }
            ]
        }
    ]
}