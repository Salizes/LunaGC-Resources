    "dialogues": [
        {
            "id": "660690201",
            "speaker": "Player",
            "text": "不能去看吗？"
        },
        {
            "id": "660690202",
            "speaker": "塔洛娜",
            "text": "能，也不能。"
        },
        {
            "id": "660690203",
            "speaker": "塔洛娜",
            "text": "你问我想不想去看呢，那当然是想了。"
        },
        {
            "id": "660690204",
            "speaker": "塔洛娜",
            "text": "但是你问一问我的钱包，它大约是不建议的。"
        },
        {
            "id": "660690205",
            "speaker": "塔洛娜",
            "text": "再问一问家里的房子呢，呃，它说可能需要再买一间仓库。"
        },
        {
            "id": "660690206",
            "speaker": "塔洛娜",
            "text": "我…我应该尊重它们的意见，对吧？"
        }
    ]
}