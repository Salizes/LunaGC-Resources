    "dialogues": [
        {
            "id": "690330201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690330202",
            "speaker": "达达利亚",
            "text": "嗯，这里太适合居家生活了。"
        },
        {
            "id": "690330203",
            "speaker": "达达利亚",
            "text": "美丽、僻静…也温馨。"
        },
        {
            "id": "690330204",
            "speaker": "达达利亚",
            "text": "真想把冬妮娅、安东和托克他们都叫来住…",
            "choices": [
                {
                    "id": "690330205",
                    "text": "我这住不下那么多人…",
                    "response": [
                        {
                            "id": "690330207",
                            "speaker": "达达利亚",
                            "text": "哈哈哈哈，抱歉，我不是那个意思。"
                        },
                        {
                            "id": "690330208",
                            "speaker": "达达利亚",
                            "text": "我只是想到，冬妮娅他们有你陪的话，一定会很开心的。"
                        }
                    ]
                },
                {
                    "id": "690330206",
                    "text": "其实我没有你想得那么擅长照顾孩子…"
                }
            ]
        }
    ]
}