    "dialogues": [
        {
            "id": "631121001",
            "speaker": "Player",
            "text": "关于「公义」…"
        },
        {
            "id": "631121002",
            "speaker": "松平",
            "text": "那家伙，已经死了。"
        },
        {
            "id": "631121003",
            "speaker": "松平",
            "text": "明明有那么好的剑术，又和研次一道受上官赏识，居然会叛逃，真是让人想不通。"
        },
        {
            "id": "631121004",
            "speaker": "松平",
            "text": "如果不是因为这种荒谬的事情，研次怎么会…"
        },
        {
            "id": "631121005",
            "speaker": "松平",
            "text": "唉，可惜了研次啊，那小子不该沦落成那个样子的。"
        }
    ]
}