    "dialogues": [
        {
            "id": "759500101",
            "speaker": "Player",
            "text": "有什么推荐的餐点吗？"
        },
        {
            "id": "759500102",
            "speaker": "加莫莉",
            "text": "推荐的餐点啊…嗯，你应该还不是很饿吧。这样的话，要不要来尝尝我们的「粒果膨膨棒」？"
        },
        {
            "id": "759500103",
            "speaker": "加莫莉",
            "text": "既健康又美味，而且做起来也相当方便！这一顿就算是我请啦，「营养餐」才不是什么可怕的东西！"
        }
    ]
}