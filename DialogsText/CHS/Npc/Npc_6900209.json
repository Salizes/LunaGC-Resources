{
    "talkId": "6900209",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "神里绫华": 16
    },
    "dialogues": [
        {
            "id": "690020901",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690020402",
            "speaker": "神里绫华",
            "text": "嗯…要来交流茶艺心得吗？"
        },
        {
            "id": "690020403",
            "speaker": "神里绫华",
            "text": "或者…换一种说法，要来尝尝我亲手做的抹茶吗？"
        },
        {
            "id": "690020404",
            "speaker": "神里绫华",
            "text": "我曾在书中学习过，蒙德和璃月都有着独特的茶文化。"
        },
        {
            "id": "690020405",
            "speaker": "神里绫华",
            "text": "但说起对茶的研习，稻妻人也有一番心得。"
        },
        {
            "id": "690020406",
            "speaker": "神里绫华",
            "text": "我想让你尝一尝纯正的稻妻抹茶，随后听听你的评价！"
        },
        {
            "id": "690020407",
            "speaker": "神里绫华",
            "text": "…想必也会加深我对茶道的理解吧。",
            "choices": [
                {
                    "id": "690020408",
                    "text": "绫华这样的身份，不应该由你来泡茶…",
                    "response": [
                        {
                            "id": "690020409",
                            "speaker": "神里绫华",
                            "text": "请不要这样说。"
                        },
                        {
                            "id": "690020410",
                            "speaker": "神里绫华",
                            "text": "你是远渡重天，创造诸多伟业之人。"
                        },
                        {
                            "id": "690020411",
                            "speaker": "神里绫华",
                            "text": "与你的经历相比，「社奉行神里家的大小姐」才是不足挂齿的名号…"
                        },
                        {
                            "id": "690020412",
                            "speaker": "神里绫华",
                            "text": "更重要的是…我也希望，你我之间可以不用拘泥这些身份…"
                        },
                        {
                            "id": "690020413",
                            "speaker": "神里绫华",
                            "text": "我只是把你当作…最重要的人。"
                        },
                        {
                            "id": "690020418",
                            "speaker": "Player",
                            "text": "（最重要的人…）"
                        },
                        {
                            "id": "690020419",
                            "speaker": "神里绫华",
                            "text": "……"
                        },
                        {
                            "id": "690020420",
                            "speaker": "神里绫华",
                            "text": "我可以…牵着你的手吗？"
                        }
                    ]
                },
                {
                    "id": "690020414",
                    "text": "那我来做搭配茶一起享用的甜点心吧。",
                    "response": [
                        {
                            "id": "690020415",
                            "speaker": "神里绫华",
                            "text": "…真的吗？！"
                        },
                        {
                            "id": "690020416",
                            "speaker": "神里绫华",
                            "text": "咳咳…不好意思，我有些太过开心了。"
                        },
                        {
                            "id": "690020417",
                            "speaker": "神里绫华",
                            "text": "能和最重要的人共享茶艺的乐趣，像发生在梦里一样…"
                        }
                    ]
                }
            ]
        }
    ]
}