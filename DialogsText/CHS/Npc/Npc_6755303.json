    "dialogues": [
        {
            "id": "675530301",
            "speaker": "Player",
            "text": "有什么推荐吗？"
        },
        {
            "id": "675530302",
            "speaker": "兹纳缅斯基",
            "text": "在海屑镇能干的事还是挺多的，您可以去海钓，或是试试雪橇，也可以去拉祖莫夫斯基的摊子吃烧烤！"
        },
        {
            "id": "675530303",
            "speaker": "兹纳缅斯基",
            "text": "恕我直言，他调的烧烤酱味道一般，不过胜在鱼和肉都很新鲜。"
        }
    ]
}