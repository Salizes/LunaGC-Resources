        {
            "id": "652110201",
            "speaker": "Player",
            "text": "你要修什么？"
        },
        {
            "id": "652110202",
            "speaker": "德尼谢尔",
            "text": "这台警卫机关。安里说它是「机动自律型枫达专卖机」的保镖，还试图在它内部安装录音装置…"
        },
        {
            "id": "652110203",
            "speaker": "德尼谢尔",
