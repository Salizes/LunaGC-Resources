    "dialogues": [
        {
            "id": "5030201",
            "speaker": "吃虎岩公告板",
            "text": "此乃吃虎岩公告板，街区新闻、店铺广告，无论大小，皆以公示。闲人如无要事，请勿擅自张贴。"
        },
        {
            "id": "5030202",
            "speaker": "万民堂广告",
            "text": "万民百味，众口能调！"
        },
        {
            "id": "5030203",
            "speaker": "万民堂广告",
            "text": "用全新的美味，唤起您的美好回忆！"
        },
        {
            "id": "5030204",
            "speaker": "万民堂广告",
            "text": "万民堂，静候您的光临！"
        },
        {
            "id": "5030205",
            "speaker": "留言",
            "text": "「今天也是香菱下厨吗？」"
        },
        {
            "id": "5030206",
            "speaker": "回复",
            "text": "「实在抱歉，小女近日正遍游七国修习厨艺，颇需时日才能回来。」"
        }
    ]
}