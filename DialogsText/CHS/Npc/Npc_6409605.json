    "dialogues": [
        {
            "id": "640960501",
            "speaker": "Player",
            "text": "二（明论派）。"
        },
        {
            "id": "640960502",
            "speaker": "希忒",
            "text": "明论派依托于梨多梵谛学院，以星空为其研究中心，认为天空映照真理，刻写命运。"
        },
        {
            "id": "640960503",
            "speaker": "希忒",
            "text": "其标志为蓝色，包含天文学、占星术等学科。"
        },
        {
            "id": "640960504",
            "speaker": "希忒",
            "text": "…简而言之，不是在看天，就是在苦算。"
        }
    ]
}