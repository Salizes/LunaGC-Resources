    "dialogues": [
        {
            "id": "621230201",
            "speaker": "Player",
            "text": "你指的是岩王帝君？"
        },
        {
            "id": "621230202",
            "speaker": "阿鸠",
            "text": "呵呵呵…那个僭位者吗？"
        },
        {
            "id": "621230203",
            "speaker": "阿鸠",
            "text": "人类眼中的历史…果然只是从人类的时代开始…"
        },
        {
            "id": "621230204",
            "speaker": "阿鸠",
            "text": "如此便能将那些黑暗罪行封存在旧世界，然后安稳度日了吗？"
        },
        {
            "id": "621230205",
            "speaker": "阿鸠",
            "text": "…也罢，既然你甘愿沉溺于虚伪的繁荣，那就在其中慢慢溺死吧。"
        }
    ]
}