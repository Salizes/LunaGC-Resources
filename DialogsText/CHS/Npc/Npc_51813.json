    "dialogues": [
        {
            "id": "5181301",
            "speaker": "留言",
            "text": "「虽然战争终于平息了，但海贼仍然在许多海域肆虐，诸位朋友远行依然要注意安全。」"
        },
        {
            "id": "5181302",
            "speaker": "留言",
            "text": "「听说官府正在和珊瑚宫那边谈判，以后或许会恢复海上协防的协议。」"
        },
        {
            "id": "5181303",
            "speaker": "另一人的留言",
            "text": "「如果是那样的话，就太好了。」"
        }
    ]
}