    "dialogues": [
        {
            "id": "614370701",
            "speaker": "Player",
            "text": "关于龙灾…"
        },
        {
            "id": "614370702",
            "speaker": "斯万",
            "text": "龙灾？请稍等，让我回想一下《骑士团指导手册》…"
        },
        {
            "id": "614370703",
            "speaker": "斯万",
            "text": "不好意思，里面好像没有提到面对巨龙应该怎么做啊…"
        },
        {
            "id": "614370704",
            "speaker": "斯万",
            "text": "我想起来了，不过里面有提及该如何面对突发的危机："
        },
        {
            "id": "614370705",
            "speaker": "斯万",
            "text": "「面对危险时不要慌张，可以双手抱头并蹲下、护住要害部位」…"
        },
        {
            "id": "614370706",
            "speaker": "斯万",
            "text": "…总之，请参考这个吧。"
        }
    ]
}