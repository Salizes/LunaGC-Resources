    "dialogues": [
        {
            "id": "617970301",
            "speaker": "Player",
            "text": "谁懒得维护？训他！"
        },
        {
            "id": "617970302",
            "speaker": "科赫",
            "text": "就是君特那家伙，仗着自己老拿队内射击比试的冠军，不好好擦枪，老把保养的工作丢给我们枪匠。"
        },
        {
            "id": "617970303",
            "speaker": "科赫",
            "text": "可恶…铳枪明明是精妙的艺术品…如果我的射术比他强，我一定按着他的头让他好好向铳枪们道歉！"
        }
    ]
