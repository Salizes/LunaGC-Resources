{
    "talkId": "6990043",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 9,
        "派蒙": 9
    },
    "dialogues": [
        {
            "id": "699004301",
            "speaker": "Player",
            "text": "关于美露莘…"
        },
        {
            "id": "699004302",
            "speaker": "派蒙",
            "text": "听说每位美露莘在诞生时都会有一个与生俱来的信物，她们会把这个信物当作自己精神的象征。",
            "choices": [
                {
                    "id": "699004303",
                    "text": "假如派蒙是美露莘的话…",
                    "response": [
                        {
                            "id": "699004305",
                            "speaker": "派蒙",
                            "text": "肯定是叉子！代表吃遍全世界的好吃的！"
                        },
                        {
                            "id": "699004306",
                            "speaker": "Player",
                            "text": "不是摩拉吗？"
                        },
                        {
                            "id": "699004307",
                            "speaker": "派蒙",
                            "text": "对哦，假如是摩拉的话，不就说明我会成为大富翁。以后想买什么就买什么了吗？"
                        },
                        {
                            "id": "699004308",
                            "speaker": "派蒙",
                            "text": "唔——好纠结，我都好想要！",
                            "choices": [
                                {
                                    "id": "699004309",
                                    "text": "那就摩拉做的叉子吧…",
                                    "response": [
                                        {
                                            "id": "699004311",
                                            "speaker": "派蒙",
                                            "text": "那真是好主意呢！"
                                        },
                                        {
                                            "id": "699004312",
                                            "speaker": "派蒙",
                                            "text": "如果是这样的话，你的信物一定是一口锅，负责给我做好吃的！"
                                        },
                                        {
                                            "id": "699004313",
                                            "speaker": "Player",
                                            "text": "不不不，我的信物是派蒙哦。"
                                        },
                                        {
                                            "id": "699004314",
                                            "speaker": "派蒙",
                                            "text": "嘿嘿，真的吗？"
                                        },
                                        {
                                            "id": "699004315",
                                            "speaker": "Player",
                                            "text": "这样派蒙的东西就都是我的啦。"
                                        },
                                        {
                                            "id": "699004316",
                                            "speaker": "派蒙",
                                            "text": "唔——那好吧，好朋友之间东西是要互相分享的。"
                                        },
                                        {
                                            "id": "699004317",
                                            "speaker": "Player",
                                            "text": "我的东西还是我的。"
                                        },
                                        {
                                            "id": "699004318",
                                            "speaker": "派蒙",
                                            "text": "喂！"
                                        }
                                    ]
                                },
                                {
                                    "id": "699004310",
                                    "text": "这样就都能有了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699004304",
                    "text": "这个信物会是什么呢？"
                }
            ]
        }
    ]
}