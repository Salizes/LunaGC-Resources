{
    "talkId": "6220302",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 3,
        "兰达": 14
    },
    "dialogues": [
        {
            "id": "622030201",
            "speaker": "Player",
            "text": "请问你是？"
        },
        {
            "id": "622030202",
            "speaker": "兰达",
            "text": "我叫兰达，做酒业生意的。那边跑来跑去的是我的女儿，蒂雅。"
        },
        {
            "id": "622030203",
            "speaker": "兰达",
            "text": "你知道，蒙德的酒要流通到璃月才能卖给全大陆。"
        },
        {
            "id": "622030204",
            "speaker": "兰达",
            "text": "明曦酒庄你知道吗？就是从那里来的。"
        },
        {
            "id": "622030205",
            "speaker": "兰达",
            "text": "啊，对对，晨曦晨曦。",
            "choices": [
                {
                    "id": "622030206",
                    "text": "有些可疑啊…",
                    "response": [
                        {
                            "id": "622030207",
                            "speaker": "兰达",
                            "text": "欸，离开蒙德太久了会这样的。"
                        },
                        {
                            "id": "622030208",
                            "speaker": "兰达",
                            "text": "我可是这里老熟人了，这条商道跑了好多年了。"
                        },
                        {
                            "id": "622030209",
                            "speaker": "兰达",
                            "text": "掌柜和老板娘，他们都可以给我担保的。"
                        },
                        {
                            "id": "622030210",
                            "speaker": "兰达",
                            "text": "是不是啊，淮安、戈黛特，啊哈哈哈。"
                        },
                        {
                            "id": "622030211",
                            "speaker": "兰达",
                            "text": "你们别不说话啊…"
                        }
                    ]
                },
                {
                    "id": "622030212",
                    "text": "越看越可疑…",
                    "response": [
                        {
                            "id": "622030213",
                            "speaker": "兰达",
                            "text": "怎、怎么能这么说。"
                        },
                        {
                            "id": "622030214",
                            "speaker": "兰达",
                            "text": "那，我来告诉你一个只有在酒行才知道的秘密吧。"
                        },
                        {
                            "id": "622030215",
                            "speaker": "兰达",
                            "text": "「天使的馈赠」其实说的是「天使的一份」。"
                        },
                        {
                            "id": "622030216",
                            "speaker": "兰达",
                            "text": "也就是酿酒时，被空气带走的一部分。"
                        },
                        {
                            "id": "622030217",
                            "speaker": "兰达",
                            "text": "怎么样，学习到了吧。"
                        }
                    ]
                }
            ]
        }
    ]
}