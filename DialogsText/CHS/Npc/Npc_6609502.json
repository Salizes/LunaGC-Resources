    "dialogues": [
        {
            "id": "660950201",
            "speaker": "Player",
            "text": "怎么说？"
        },
        {
            "id": "660950202",
            "speaker": "阿布帕隆",
            "text": "举个比较现实的例子。很久很久以前，有那么一天，当当！你降生在了回声之子的部族中。"
        },
        {
            "id": "660950203",
            "speaker": "阿布帕隆",
            "text": "好消息，这里盛产很厉害的石头，大家可以依靠开采石头生活，打首饰、打武器、做生意，其乐无穷！"
        },
        {
            "id": "660950204",
            "speaker": "阿布帕隆",
            "text": "坏消息呢，就是这里只有石头。无论你需要什么别的东西，都只能拿石头去换。"
        },
        {
            "id": "660950205",
            "speaker": "阿布帕隆",
            "text": "怎么样，浅显易懂吧。"
        }
    ]
}