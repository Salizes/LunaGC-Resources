{
    "talkId": "6990050",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699005001",
            "speaker": "Player",
            "text": "关于「霜月之子」…"
        },
        {
            "id": "699005002",
            "speaker": "派蒙",
            "text": "我听说，「霜月之子」是一个崇信月神的组织。那你说，他们在白天的时候，又在干什么呢？"
        },
        {
            "id": "699005003",
            "speaker": "Player",
            "text": "欸，不是普通而又正常地生活着吗？"
        },
        {
            "id": "699005004",
            "speaker": "派蒙",
            "text": "肯定没有那么简单！要我说，他们一定有着独特的生活节奏！"
        },
        {
            "id": "699005005",
            "speaker": "Player",
            "text": "比如？"
        },
        {
            "id": "699005006",
            "speaker": "派蒙",
            "text": "比如在白天伪装成一个个巨大的石头，然后睡大觉。"
        },
        {
            "id": "699005007",
            "speaker": "派蒙",
            "text": "等到入夜，就清醒过来，噼里啪啦地恢复人形，再进行一些不为人知的神秘工作…",
            "choices": [
                {
                    "id": "699005008",
                    "text": "偶尔会遇到一些可怕的事情…",
                    "response": [
                        {
                            "id": "699005010",
                            "speaker": "派蒙",
                            "text": "对对对！一定是这样的！没错没错！"
                        },
                        {
                            "id": "699005011",
                            "speaker": "Player",
                            "text": "你说的，怕不是早柚吧…"
                        }
                    ]
                },
                {
                    "id": "699005009",
                    "text": "只能工作个没日没夜？"
                }
            ]
        }
    ]
}