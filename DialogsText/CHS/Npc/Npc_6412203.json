{
    "talkId": "6412203",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "玛塔莉": 5,
        "玛希德": 5
    },
    "dialogues": [
        {
            "id": "641220301",
            "speaker": "玛希德",
            "text": "你说，我要是不那么书呆子，是不是…嗝，以前上学时就能更受欢迎一点…"
        },
        {
            "id": "641220302",
            "speaker": "玛塔莉",
            "text": "嗯嗯，也许吧。"
        },
        {
            "id": "641220303",
            "speaker": "玛希德",
            "text": "你说，我要是…嗝…能和你一样好脾气的话，是不是就能和大家搞好关系了…"
        },
        {
            "id": "641220304",
            "speaker": "玛塔莉",
            "text": "嗯嗯，可能吧。"
        },
        {
            "id": "641220305",
            "speaker": "玛希德",
            "text": "你说，我要是说话做事更委婉…嗝！是不是早就能升职了…"
        },
        {
            "id": "641220306",
            "speaker": "玛塔莉",
            "text": "嗯嗯，是的吧。"
        },
        {
            "id": "641220307",
            "speaker": "玛希德",
            "text": "你说，我这样碌碌无为，是不是辜负了小吉祥草王大人对须弥人的期待…"
        },
        {
            "id": "641220308",
            "speaker": "玛塔莉",
            "text": "嗯…啊，不是的。"
        },
        {
            "id": "641220309",
            "speaker": "玛塔莉",
            "text": "不能这样讲。您现在的工作也十分重要。"
        },
        {
            "id": "641220310",
            "speaker": "玛希德",
            "text": "真、真的吗…嗝…"
        }
    ]
}