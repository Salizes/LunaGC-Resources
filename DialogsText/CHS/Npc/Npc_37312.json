{
    "talkId": "37312",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "琴": 9
    },
    "dialogues": [
        {
            "id": "3730902",
            "speaker": "琴",
            "text": "风魔龙事件的真相，依然存在隐情。一定还有我们未能掌握的事实…",
            "choices": [
                {
                    "id": "3730903",
                    "text": "有关风魔龙。",
                    "response": [
                        {
                            "id": "3730904",
                            "speaker": "琴",
                            "text": "关于龙的体型和力量的异变，的确有很多疑点…"
                        },
                        {
                            "id": "3730905",
                            "speaker": "琴",
                            "text": "不过，对于骑士团来说，当务之急是平息这次袭击的余波。"
                        },
                        {
                            "id": "3730906",
                            "speaker": "琴",
                            "text": "既然团长离开前将骑士团交给我，我便绝不能辜负团长，和蒙德的人民。"
                        },
                        {
                            "id": "3730907",
                            "speaker": "琴",
                            "text": "一定要弄清楚事情的真相…"
                        }
                    ]
                },
                {
                    "id": "3730908",
                    "text": "关于愚人众。",
                    "response": [
                        {
                            "id": "3730909",
                            "speaker": "琴",
                            "text": "那些穿着奇怪制服的人…愚人众。"
                        },
                        {
                            "id": "3730910",
                            "speaker": "琴",
                            "text": "是作为至冬国使团来到蒙德的。"
                        },
                        {
                            "id": "3730911",
                            "speaker": "琴",
                            "text": "尽量避免和他们扯上关系，即使对于无关的旅者而言，与他们接触也是有风险的。"
                        }
                    ]
                },
                {
                    "id": "3730912",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "3730913",
                            "speaker": "琴",
                            "text": "听凭风引。"
                        }
                    ]
                }
            ]
        }
    ]
}