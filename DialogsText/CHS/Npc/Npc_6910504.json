{
    "talkId": "6910504",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 14,
        "欧洛伦": 21
    },
    "dialogues": [
        {
            "id": "691050401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691050402",
            "speaker": "欧洛伦",
            "text": "暂时没想到什么。有推荐吗？"
        },
        {
            "id": "691050403",
            "speaker": "Player",
            "text": "比如…安静的事情？"
        },
        {
            "id": "691050404",
            "speaker": "欧洛伦",
            "text": "哦…那，想试试「燃素刻录」吗？"
        },
        {
            "id": "691050405",
            "speaker": "欧洛伦",
            "text": "它只有名字听上去很严肃，简单来说，就是用颜料绘制花纹，然后使用燃素或者元素力激活，从而产生不同的力量。"
        },
        {
            "id": "691050406",
            "speaker": "欧洛伦",
            "text": "或者更简单一些，如果不追求特定效果，我们可以只把它当成一次简单的涂鸦绘画，剩下的顺其自然。"
        },
        {
            "id": "691050407",
            "speaker": "欧洛伦",
            "text": "比如画一个派蒙在手背上，可能过一会儿你就会感到饿了。"
        },
        {
            "id": "691050408",
            "speaker": "Player",
            "text": "像是会发生的事情。"
        },
        {
            "id": "691050409",
            "speaker": "欧洛伦",
            "text": "嗯。图案的意义很重要，有时，颜料的配方也很重要。"
        },
        {
            "id": "691050410",
            "speaker": "Player",
            "text": "或者…有什么不安静的事情吗？"
        },
        {
            "id": "691050411",
            "speaker": "欧洛伦",
            "text": "你是说运动之类的吗？"
        },
        {
            "id": "691050412",
            "speaker": "欧洛伦",
            "text": "我们可以赛跑。"
        },
        {
            "id": "691050413",
            "speaker": "Player",
            "text": "？",
            "choices": [
                {
                    "id": "691050414",
                    "text": "你说的赛跑是「比赛逃跑」吗？",
                    "response": [
                        {
                            "id": "691050416",
                            "speaker": "欧洛伦",
                            "text": "不，永远不要低估自己。"
                        },
                        {
                            "id": "691050417",
                            "speaker": "欧洛伦",
                            "text": "如果你没信心，我可以先教你怎么做涂鸦烟雾弹，这样我们就能公平竞争了。",
                            "choices": [
                                {
                                    "id": "691050418",
                                    "text": "我很愿意。",
                                    "response": [
                                        {
                                            "id": "691050420",
                                            "speaker": "欧洛伦",
                                            "text": "噢…你说得对。"
                                        },
                                        {
                                            "id": "691050421",
                                            "speaker": "欧洛伦",
                                            "text": "这里太舒适了，我完全忘了自己正在别人家里做客，实在不好意思。"
                                        },
                                        {
                                            "id": "691050422",
                                            "speaker": "欧洛伦",
                                            "text": "那我们就只能干巴巴地赛跑了。也好吧，也是一种锻炼。"
                                        },
                                        {
                                            "id": "691050423",
                                            "speaker": "Player",
                                            "text": "还有别的选项吗？"
                                        },
                                        {
                                            "id": "691050424",
                                            "speaker": "欧洛伦",
                                            "text": "有，动静结合。"
                                        },
                                        {
                                            "id": "691050425",
                                            "speaker": "欧洛伦",
                                            "text": "也就是一边赛跑一边涂鸦。",
                                            "choices": [
                                                {
                                                    "id": "691050426",
                                                    "text": "哈哈！",
                                                    "response": [
                                                        {
                                                            "id": "691050429",
                                                            "speaker": "欧洛伦",
                                                            "text": "看你样子，应该是希望我在开玩笑。"
                                                        },
                                                        {
                                                            "id": "691050430",
                                                            "speaker": "欧洛伦",
                                                            "text": "所以我应该是在开玩笑。"
                                                        },
                                                        {
                                                            "id": "691050431",
                                                            "speaker": "Player",
                                                            "text": "谢谢，和你聊天很愉快。"
                                                        },
                                                        {
                                                            "id": "691050432",
                                                            "speaker": "欧洛伦",
                                                            "text": "不用客气，我才是应该道谢的那个人。"
                                                        },
                                                        {
                                                            "id": "691050433",
                                                            "speaker": "欧洛伦",
                                                            "text": "我不常到朋友家做客，所以，非常感谢你愿意邀请我。"
                                                        },
                                                        {
                                                            "id": "691050434",
                                                            "speaker": "Player",
                                                            "text": "不客气，喜欢再来。"
                                                        },
                                                        {
                                                            "id": "691050435",
                                                            "speaker": "欧洛伦",
                                                            "text": "嗯，我会的。下次，我会带家门口最大的萝卜来。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691050427",
                                                    "text": "…是开玩笑的对吧？",
                                                    "response": [
                                                        {
                                                            "id": "691050428",
                                                            "speaker": "欧洛伦",
                                                            "text": "…对。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691050419",
                                    "text": "但会很难打扫。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691050415",
                    "text": "那我输定了。"
                }
            ]
        }
    ]
}