        {
            "id": "732851901",
            "speaker": "索希",
            "text": "陌生的来客…有什么事的话请直接找识主大人吧。",
            "choices": [
                {
                    "id": "732851902",
                    "text": "你在这里做什么？",
                    "response": [
                        {
                            "id": "732851903",
                            "speaker": "索希",
                            "text": "我是…唔，外人没必要知道这些。"
                        },
                        {
                            "id": "732851904",
                            "speaker": "索希",
                            "text": "没什么事的话，请尽快离开吧。"
                        }
                    ]
                },
                {
