{
    "talkId": "4008141",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 9,
        "荒谷": 11
    },
    "dialogues": [
        {
            "id": "400814101",
            "speaker": "荒谷",
            "text": "真让人惊奇！你们以前研究过驯兽吗？如果刚刚上手，就能这么轻松地连胜三场，未免也太有天赋了！",
            "choices": [
                {
                    "id": "400814102",
                    "text": "恭喜我们呀。",
                    "response": [
                        {
                            "id": "400814103",
                            "speaker": "派蒙",
                            "text": "#哈哈，{NICKNAME}学什么都很快哦！"
                        },
                        {
                            "id": "400814104",
                            "speaker": "派蒙",
                            "text": "如果荒谷小姐跟着我们去冒险，就会接触到更多很新奇的事物了，但那些事物总是只给我们一丁点时间去适应！"
                        },
                        {
                            "id": "400814105",
                            "speaker": "荒谷",
                            "text": "当真？"
                        },
                        {
                            "id": "400814106",
                            "speaker": "荒谷",
                            "text": "原本我以为，这样的人只会在顺吉那种夸张的小说里出现…今天算是见识到了！"
                        },
                        {
                            "id": "400814107",
                            "speaker": "荒谷",
                            "text": "以后我再也不会对顺吉那种「给角色突然增加能力」的设定发表负面评论了！"
                        }
                    ]
                },
                {
                    "id": "400814108",
                    "text": "这个先放在一边，左右加…",
                    "response": [
                        {
                            "id": "400814109",
                            "speaker": "派蒙",
                            "text": "对哦，荒谷小姐在这里闲逛，左右加小姐去哪了呢？"
                        },
                        {
                            "id": "400814110",
                            "speaker": "荒谷",
                            "text": "左右加啊？她好像很快就打起精神来了，说是规划好了新书的核心桥段，但还需要为日常的部分寻找灵感…"
                        },
                        {
                            "id": "400814111",
                            "speaker": "荒谷",
                            "text": "所以她就去找熟悉本地环境的人了，正在规划接下来的旅途。"
                        },
                        {
                            "id": "400814112",
                            "speaker": "Player",
                            "text": "还好还好。"
                        },
                        {
                            "id": "400814113",
                            "speaker": "派蒙",
                            "text": "左右加小姐从失败的挫折里走出来了，我们也能松口气了呢。"
                        },
                        {
                            "id": "400814114",
                            "speaker": "Player",
                            "text": "神子不也一样吗？"
                        },
                        {
                            "id": "400814115",
                            "speaker": "派蒙",
                            "text": "就是啊，听说神子每次都把对手打得丢魂落魄！以神子悠哉的作风，肯定还没拿出全力！"
                        },
                        {
                            "id": "400814116",
                            "speaker": "荒谷",
                            "text": "来了来了，进入了我熟悉的「商业互夸」环节！"
                        },
                        {
                            "id": "400814117",
                            "speaker": "荒谷",
                            "text": "那么我就要提问了——旅行者和八重大人孰强？"
                        },
                        {
                            "id": "400814118",
                            "speaker": "荒谷",
                            "text": "注意哦，我问的是这场比赛中的战斗力。假设你们和八重大人狭路相逢，谁会赢？"
                        },
                        {
                            "id": "400814119",
                            "speaker": "派蒙",
                            "text": "欸？好突然！脑子一下子转不过来了…"
                        },
                        {
                            "id": "400814120",
                            "speaker": "派蒙",
                            "text": "回答不知道，好像太敷衍了…现在就说我们会赢过神子，又属于大不敬的行为？那直接认输，又太软弱了，不甘心！",
                            "choices": [
                                {
                                    "id": "400814121",
                                    "text": "比较战斗力没有意义。",
                                    "response": [
                                        {
                                            "id": "400814123",
                                            "speaker": "派蒙",
                                            "text": "有…有道理！差点就被荒谷小姐神子带偏了！神子自己也说过，她只是来体验一下驯兽罢了，根本没必要提这种问题嘛。"
                                        },
                                        {
                                            "id": "400814124",
                                            "speaker": "荒谷",
                                            "text": "何等标准的答案！是「不会得罪任何人」级别的台词，直接让话题向着下一个阶段发展，收不回来了！"
                                        },
                                        {
                                            "id": "400814125",
                                            "speaker": "荒谷",
                                            "text": "果然，你们才是被整个世界选中的「主角」吗！我开始期待了，你们两位的角色在左右加的新书里会有怎样一番表现！"
                                        },
                                        {
                                            "id": "400814126",
                                            "speaker": "派蒙",
                                            "text": "怎么荒谷小姐也开始神神叨叨了，是左右加小姐的气质感染了她吗…"
                                        }
                                    ]
                                },
                                {
                                    "id": "400814122",
                                    "text": "重要的是和伙伴们共处。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}