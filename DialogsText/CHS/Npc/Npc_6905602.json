{
    "talkId": "6905602",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "九条裟罗": 8
    },
    "dialogues": [
        {
            "id": "690560201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690560202",
            "speaker": "九条裟罗",
            "text": "虽然没有九条家的宅邸宽阔，但住下来，还算舒心。"
        },
        {
            "id": "690560203",
            "speaker": "九条裟罗",
            "text": "这里的一切都是按照你的意思建造的吗？没想到你还有这种才能。"
        },
        {
            "id": "690560204",
            "speaker": "九条裟罗",
            "text": "如果九条家要扩建，我会优先来找你的。",
            "choices": [
                {
                    "id": "690560205",
                    "text": "大可不必…",
                    "response": [
                        {
                            "id": "690560206",
                            "speaker": "九条裟罗",
                            "text": "怎么？你不乐意吗？"
                        },
                        {
                            "id": "690560209",
                            "speaker": "九条裟罗",
                            "text": "呵呵，放心吧，我不会强人所难。"
                        },
                        {
                            "id": "690560210",
                            "speaker": "九条裟罗",
                            "text": "事实上，九条家也不可能有什么改变了，至少不可能改造成这里的样子。"
                        },
                        {
                            "id": "690560211",
                            "speaker": "九条裟罗",
                            "text": "因为这里存在的生机与乐趣，是我此前从未感受过的…"
                        }
                    ]
                },
                {
                    "id": "690560207",
                    "text": "交给我吧！",
                    "response": [
                        {
                            "id": "690560208",
                            "speaker": "九条裟罗",
                            "text": "我还没说要求呢，你就一口答应了吗？"
                        }
                    ]
                }
            ]
        }
    ]
}