{
    "talkId": "6906609",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "神里绫人": 10
    },
    "dialogues": [
        {
            "id": "690660201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690660202",
            "speaker": "神里绫人",
            "text": "当然。"
        },
        {
            "id": "690660203",
            "speaker": "神里绫人",
            "text": "虽说摆设我多数见过，但布局却又与我平日里见的不同。"
        },
        {
            "id": "690660204",
            "speaker": "神里绫人",
            "text": "如此巧妙的构思，处处皆有新奇…着实不错。"
        },
        {
            "id": "690660205",
            "speaker": "神里绫人",
            "text": "不如我差人把社奉行府也改成这种风格吧。"
        },
        {
            "id": "690660206",
            "speaker": "神里绫人",
            "text": "你来当监工，如何？",
            "choices": [
                {
                    "id": "690660207",
                    "text": "该不是说笑的吧…",
                    "response": [
                        {
                            "id": "690660208",
                            "speaker": "神里绫人",
                            "text": "啊，被看出来了吗？看来我的演技有所退步啊。"
                        },
                        {
                            "id": "690660212",
                            "speaker": "神里绫人",
                            "text": "话又说回来，这里的确让我很有新鲜感。"
                        },
                        {
                            "id": "690660213",
                            "speaker": "神里绫人",
                            "text": "就请允许我多来拜访吧。"
                        }
                    ]
                },
                {
                    "id": "690660209",
                    "text": "呃…不太合适吧…",
                    "response": [
                        {
                            "id": "690660210",
                            "speaker": "神里绫人",
                            "text": "呵呵，怎么露出这么为难的表情呢？"
                        },
                        {
                            "id": "690660211",
                            "speaker": "神里绫人",
                            "text": "既然如此，那就不好勉强了。"
                        }
                    ]
                }
            ]
        }
    ]
}