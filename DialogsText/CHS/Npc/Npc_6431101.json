    "dialogues": [
        {
            "id": "643110101",
            "speaker": "费尔比",
            "text": "你说，走层岩巨渊这条路来须弥，是不是个错误的选择啊？"
        },
        {
            "id": "643110102",
            "speaker": "费尔比",
            "text": "本以为横穿过来是条近路，结果因为封锁不让我这种没关系的普通人进，反而绕了一大圈！"
        },
        {
            "id": "643110103",
            "speaker": "费尔比",
            "text": "这家伙，给我累的…"
        }
    ]
