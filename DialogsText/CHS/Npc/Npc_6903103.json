{
    "talkId": "6903103",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "奥兹": 5,
        "菲谢尔": 12
    },
    "dialogues": [
        {
            "id": "690310301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690310302",
            "speaker": "菲谢尔",
            "text": "那时间的步履已被我擒住，那命运的窥探已被我遮蔽。"
        },
        {
            "id": "690310303",
            "speaker": "菲谢尔",
            "text": "异界之旅人啊，就让至高无上的皇女来裁断你心中的孽扰吧！"
        },
        {
            "id": "690310304",
            "speaker": "奥兹",
            "text": "小姐的意思是，现在她正好有空。"
        },
        {
            "id": "690310305",
            "speaker": "奥兹",
            "text": "如果有什么烦心事，她很乐意倾听。"
        },
        {
            "id": "690310306",
            "speaker": "Player",
            "text": "我其实想知道皇女殿下会不会有什么烦恼。"
        },
        {
            "id": "690310307",
            "speaker": "菲谢尔",
            "text": "愚谬！吾乃断罪之皇女，凡间情愫何至于将我之心灵污扰？"
        },
        {
            "id": "690310308",
            "speaker": "奥兹",
            "text": "在我外出侦察的时候，冒险家协会的新人不是因为会错了小姐的意，惹出了不小的笑话吗？"
        },
        {
            "id": "690310309",
            "speaker": "奥兹",
            "text": "我记得小姐还为此苦恼过。"
        },
        {
            "id": "690310310",
            "speaker": "菲谢尔",
            "text": "胡…胡言！本皇女岂会为区区扈从所扰？"
        },
        {
            "id": "690310311",
            "speaker": "菲谢尔",
            "text": "我只不过在嗟叹，那些年轻的扈从，不似这位被命运之丝引至我身前的异界旅人…"
        },
        {
            "id": "690310312",
            "speaker": "菲谢尔",
            "text": "能将吾之旨谕了然于心。",
            "choices": [
                {
                    "id": "690310313",
                    "text": "皇女过誉了。",
                    "response": [
                        {
                            "id": "690310315",
                            "speaker": "菲谢尔",
                            "text": "嗯，错不了…"
                        },
                        {
                            "id": "690310316",
                            "speaker": "菲谢尔",
                            "text": "本皇女心意已定，若再遇奥兹代我外出巡视，就恩许你与我同行。"
                        },
                        {
                            "id": "690310317",
                            "speaker": "菲谢尔",
                            "text": "就由你，来向扈从们传达吾之意旨吧！"
                        },
                        {
                            "id": "690310318",
                            "speaker": "奥兹",
                            "text": "坦白说，我也觉得这是个好主意。"
                        },
                        {
                            "id": "690310319",
                            "speaker": "Player",
                            "text": "万一我没理解对…"
                        },
                        {
                            "id": "690310320",
                            "speaker": "菲谢尔",
                            "text": "毋需烦忧。你为本皇女钦选之人，尽管向世人昭告吾之尊意吧！"
                        },
                        {
                            "id": "690310321",
                            "speaker": "Player",
                            "text": "既然你们都这么说了…"
                        },
                        {
                            "id": "690310322",
                            "speaker": "菲谢尔",
                            "text": "一言既定。"
                        },
                        {
                            "id": "690310323",
                            "speaker": "菲谢尔",
                            "text": "庆贺吧！在吾至圣光耀之下，那恣肆的邪恶云翳就此消散！"
                        }
                    ]
                },
                {
                    "id": "690310314",
                    "text": "能够理解皇女是我的荣幸。"
                }
            ]
        }
    ]
}