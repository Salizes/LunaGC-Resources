{
    "talkId": "6911108",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 7,
        "瓦雷莎": 13
    },
    "dialogues": [
        {
            "id": "691110301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691110302",
            "speaker": "瓦雷莎",
            "text": "好哎！正好悠悠哉哉，我们可以慢慢聊天…"
        },
        {
            "id": "691110303",
            "speaker": "瓦雷莎",
            "text": "不过，说到聊天，有零食和饮料在身边才最惬意，当然正经的饭菜也可以！"
        },
        {
            "id": "691110304",
            "speaker": "瓦雷莎",
            "text": "如果在这边架起篝火，支一口锅，就更有感觉了…甚至可以边做饭边聊。",
            "choices": [
                {
                    "id": "691110305",
                    "text": "瓦雷莎喜欢自己做饭吗？",
                    "response": [
                        {
                            "id": "691110307",
                            "speaker": "瓦雷莎",
                            "text": "只是兴趣爱好，厨艺不厉害，嘿嘿…刚尝试新东西那阵，还有点丢人…"
                        },
                        {
                            "id": "691110308",
                            "speaker": "瓦雷莎",
                            "text": "那是我在做「咚咚膨膨」的时候，不小心把家里的厨房搞炸了。锅飞出去好远好远，还正好砸中伊安珊老师。"
                        },
                        {
                            "id": "691110309",
                            "speaker": "瓦雷莎",
                            "text": "结果锅受了重伤，到现在还没好。"
                        },
                        {
                            "id": "691110310",
                            "speaker": "瓦雷莎",
                            "text": "从那以后，爸爸妈妈就不让我在屋子里做饭了，我只好在野营时做点简单的料理，慢慢练手。"
                        },
                        {
                            "id": "691110311",
                            "speaker": "瓦雷莎",
                            "text": "自己动手一点点做出来的饭菜，味道可能没那么好，却有种特别的满足感，是外出就餐换不来的！",
                            "choices": [
                                {
                                    "id": "691110312",
                                    "text": "同感，这是自己动手的美味！",
                                    "response": [
                                        {
                                            "id": "691110314",
                                            "speaker": "瓦雷莎",
                                            "text": "不如，下次我准备好肉和水果，你准备好蔬菜和调料，我们一起做道超级厉害的硬菜！"
                                        },
                                        {
                                            "id": "691110315",
                                            "speaker": "瓦雷莎",
                                            "text": "#就用我们的名字来命名…比如…{NICKNAME}和瓦雷莎的辉煌烤肉大要塞！"
                                        },
                                        {
                                            "id": "691110316",
                                            "speaker": "瓦雷莎",
                                            "text": "唔，要达到「辉煌」级别的话，应该要加很多味道厉害的调料，而且要猛火烈烤…"
                                        },
                                        {
                                            "id": "691110317",
                                            "speaker": "瓦雷莎",
                                            "text": "还是找个僻静、安全的地方来做吧。万一出了什么意外，也不能把你用心布置的家园搞得一片狼藉。",
                                            "choices": [
                                                {
                                                    "id": "691110318",
                                                    "text": "说好了说好了！"
                                                },
                                                {
                                                    "id": "691110319",
                                                    "text": "大爆炸也不怕。",
                                                    "response": [
                                                        {
                                                            "id": "691110320",
                                                            "speaker": "瓦雷莎",
                                                            "text": "嘿嘿，也不怕！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691110313",
                                    "text": "同感，我也炸过厨房！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691110306",
                    "text": "瓦雷莎对烹饪有造诣？"
                }
            ]
        }
    ]
}