{
    "talkId": "6904807",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 6,
        "烟绯": 12
    },
    "dialogues": [
        {
            "id": "690480701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690480302",
            "speaker": "烟绯",
            "text": "好啊，聊天聊天！不过我一旦打开了话匣子那话就要收不住了。"
        },
        {
            "id": "690480303",
            "speaker": "烟绯",
            "text": "你不是话一直比较少嘛。对你来说不会太「闹腾」了吗？",
            "choices": [
                {
                    "id": "690480304",
                    "text": "不会…",
                    "response": [
                        {
                            "id": "690480305",
                            "speaker": "烟绯",
                            "text": "唔…不会就好。"
                        },
                        {
                            "id": "690480306",
                            "speaker": "烟绯",
                            "text": "不知道为什么，听到你这样说，心里还挺开心的。"
                        },
                        {
                            "id": "690480307",
                            "speaker": "烟绯",
                            "text": "既然这样，你来选择话题吧。"
                        },
                        {
                            "id": "690480312",
                            "speaker": "Player",
                            "text": "那么…聊聊难对付的客户吧。"
                        },
                        {
                            "id": "690480313",
                            "speaker": "烟绯",
                            "text": "欸，我有那么多有趣的事情，你偏偏要问扫兴的话题。",
                            "choices": [
                                {
                                    "id": "690480314",
                                    "text": "因为大多数情况烟绯都应付得来。",
                                    "response": [
                                        {
                                            "id": "690480316",
                                            "speaker": "烟绯",
                                            "text": "原，原来你是这样想的。"
                                        },
                                        {
                                            "id": "690480317",
                                            "speaker": "烟绯",
                                            "text": "谢谢你…"
                                        },
                                        {
                                            "id": "690480318",
                                            "speaker": "烟绯",
                                            "text": "咳咳，那我就跟你说说，上次那个来咨询民事案件的客户…"
                                        }
                                    ]
                                },
                                {
                                    "id": "690480315",
                                    "text": "问这个才能帮烟绯解决问题。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690480308",
                    "text": "我听就好。",
                    "response": [
                        {
                            "id": "690480309",
                            "speaker": "烟绯",
                            "text": "欸——只是听啊。"
                        },
                        {
                            "id": "690480310",
                            "speaker": "烟绯",
                            "text": "聊天聊天，一来一往才叫聊天。"
                        },
                        {
                            "id": "690480311",
                            "speaker": "烟绯",
                            "text": "我又不是说书人。我已经选到了我最喜欢的工作，这辈子也不会成为说书人了。"
                        }
                    ]
                }
            ]
        }
    ]
}