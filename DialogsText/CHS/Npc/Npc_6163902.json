    "dialogues": [
        {
            "id": "616390201",
            "speaker": "锋",
            "text": "你是？"
        },
        {
            "id": "616390202",
            "speaker": "锋",
            "text": "锋。"
        },
        {
            "id": "616390203",
            "speaker": "锋",
            "text": "歌德老爷子雇来的「铠子」。"
        },
        {
            "id": "616390204",
            "speaker": "锋",
            "text": "听过我名号的话，最好别打「肉」的主意。"
        },
        {
            "id": "616390205",
            "speaker": "锋",
            "text": "铠子？"
        },
        {
            "id": "616390206",
            "speaker": "锋",
            "text": "哼，外行么。"
        },
        {
            "id": "616390207",
            "speaker": "锋",
            "text": "我们那边都这么称呼佣兵，就是替别人挡刀子的。"
        },
        {
            "id": "616390208",
            "speaker": "锋",
            "text": "虽然现在他们叫我私人保镖什么的…不管了。"
        }
    ]
}