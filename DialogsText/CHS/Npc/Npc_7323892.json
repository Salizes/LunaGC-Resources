{
    "talkId": "7323892",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "毕洛": 8
    },
    "dialogues": [
        {
            "id": "732389201",
            "speaker": "毕洛",
            "text": "没想到会发生这样的事，实在惭愧…"
        },
        {
            "id": "732389202",
            "speaker": "毕洛",
            "text": "果然学问什么的对我来说实在太复杂了还是不需要动脑子的事情更适合我。",
            "choices": [
                {
                    "id": "732389203",
                    "text": "关于「矫论团」…",
                    "response": [
                        {
                            "id": "732389204",
                            "speaker": "毕洛",
                            "text": "当务之急是要选出新的识主，但就像你看到的，我们这里没人能担当这样的重任。"
                        },
                        {
                            "id": "732389205",
                            "speaker": "毕洛",
                            "text": "不过我们已经委托阿亚德瓦前辈帮忙从城里邀请一位出色的学者过来了。"
                        },
                        {
                            "id": "732389206",
                            "speaker": "毕洛",
                            "text": "「矫论团」在这里已经镇守了数百年，也经历过更大的危机，这种小事不用担心！"
                        }
                    ]
                },
                {
                    "id": "732389207",
                    "text": "你不回去营地那边吗？",
                    "response": [
                        {
                            "id": "732389208",
                            "speaker": "毕洛",
                            "text": "越是这种时候越应该坚守在此啊！要是有什么不轨之徒打算这时候趁虚而入可就麻烦了。"
                        },
                        {
                            "id": "732389209",
                            "speaker": "毕洛",
                            "text": "索希小姐也拜托我不要乱跑，她一定也觉得我很可靠吧！"
                        }
                    ]
                },
                {
                    "id": "732389210",
                    "text": "不打扰了。",
                    "response": [
                        {
                            "id": "732389211",
                            "speaker": "毕洛",
                            "text": "哈哈，那我就不送了。"
                        }
                    ]
                }
            ]
        }
    ]
}