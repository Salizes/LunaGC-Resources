    "dialogues": [
        {
            "id": "759450101",
            "speaker": "Player",
            "text": "要珍惜已有之物。"
        },
        {
            "id": "759450102",
            "speaker": "特佐佐",
            "text": "嗯…你说的对！"
        },
        {
            "id": "759450103",
            "speaker": "特佐佐",
            "text": "还是要先充分用好手里的东西，再考虑额外的想法。"
        },
        {
            "id": "759450104",
            "speaker": "特佐佐",
            "text": "这些听说是从液态燃素里长出的果实…嗯，我想我暂时还用不好…"
        },
        {
            "id": "759450105",
            "speaker": "特佐佐",
            "text": "请你收下吧，让它们能有自己的用武之地。"
        }
    ]
}