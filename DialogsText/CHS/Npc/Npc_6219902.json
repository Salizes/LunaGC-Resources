    "dialogues": [
        {
            "id": "621990201",
            "speaker": "Player",
            "text": "老图离得不远。"
        },
        {
            "id": "621990202",
            "speaker": "阿昊",
            "text": "我知道，前两天还和他打了一照面呢。可是距离近归近，他有他要忙的，我有我要忙的，也顾不上说几句话。"
        },
        {
            "id": "621990203",
            "speaker": "阿昊",
            "text": "不过也多亏沐宁总管好心，让他干些杂活，否则啊，他也无处可去了。"
        }
    ]
}