{
    "talkId": "7505210",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "桑科约克": 8
    },
    "dialogues": [
        {
            "id": "750521001",
            "speaker": "桑科约克",
            "text": "降价了降价了，卖完就走，现在就是最后机会！",
            "choices": [
                {
                    "id": "750521002",
                    "text": "你在这里做买卖？",
                    "response": [
                        {
                            "id": "750521003",
                            "speaker": "桑科约克",
                            "text": "也没碍着谁的事，你说是不是？而且口碑摆在这儿，我也不愁销路。"
                        },
                        {
                            "id": "750521004",
                            "speaker": "桑科约克",
                            "text": "不过天天昼伏夜出还是有点吃不消，改天给豪卡捎个信让他换个人来接替我好了。"
                        }
                    ]
                },
                {
                    "id": "750521005",
                    "text": "你这里卖的东西正经吗？",
                    "response": [
                        {
                            "id": "750521006",
                            "speaker": "桑科约克",
                            "text": "怎么不正经了？给人喝的提神药剂，给龙吃的龙龙饼干，哪个不是正经东西。"
                        },
                        {
                            "id": "750521007",
                            "speaker": "桑科约克",
                            "text": "除了这些成品还有炼金素材，从蝴蝶翅膀到鳅鳅宝玉，你尽管提需求，没有我们弄不来的。"
                        },
                        {
                            "id": "750521008",
                            "speaker": "桑科约克",
                            "text": "哦，不过你要是有跟伊柯特洛差不多的嗜好那我可不奉陪。"
                        },
                        {
                            "id": "750521009",
                            "speaker": "桑科约克",
                            "text": "我们虽然也不是什么光明正大的人物，但那家伙的「宝石」买卖…我们也看不过眼。"
                        }
                    ]
                },
                {
                    "id": "750521010",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "750521011",
                            "speaker": "桑科约克",
                            "text": "慢走。"
                        }
                    ]
                }
            ]
        }
    ]
}