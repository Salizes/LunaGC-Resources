{
    "talkId": "6905904",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 6,
        "鹿野院平藏": 20
    },
    "dialogues": [
        {
            "id": "690590401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690590402",
            "speaker": "鹿野院平藏",
            "text": "我正想出去一趟，要不要一起呀？我的搭档。"
        },
        {
            "id": "690590403",
            "speaker": "鹿野院平藏",
            "text": "但行程会有点麻烦呢。得先去町街买点用得上的东西，再去趟城外，最后可能还得回奉行所…"
        },
        {
            "id": "690590404",
            "speaker": "Player",
            "text": "是要去抓犯人吗？"
        },
        {
            "id": "690590405",
            "speaker": "鹿野院平藏",
            "text": "问得好！那当然——不可能。抓捕犯人这种活就留给我专业的同僚们来做。"
        },
        {
            "id": "690590406",
            "speaker": "鹿野院平藏",
            "text": "我是想去探望一些犯人的家属。有老人，也有小孩。"
        },
        {
            "id": "690590407",
            "speaker": "鹿野院平藏",
            "text": "要不是我把决定性的证据抛出来，让他们的亲人入狱，还不至于像这样无依无靠…",
            "choices": [
                {
                    "id": "690590408",
                    "text": "不该觉得愧疚…",
                    "response": [
                        {
                            "id": "690590409",
                            "speaker": "鹿野院平藏",
                            "text": "哈哈，你放心，我当然知道该愧疚的是犯人。"
                        },
                        {
                            "id": "690590410",
                            "speaker": "鹿野院平藏",
                            "text": "抓出真凶，原本就是侦探平藏应该做的事。"
                        },
                        {
                            "id": "690590411",
                            "speaker": "鹿野院平藏",
                            "text": "真要说遗憾，嗯…也只是没有更早终结悲剧，从源头上减少犯罪率。"
                        },
                        {
                            "id": "690590412",
                            "speaker": "鹿野院平藏",
                            "text": "但事已至此，在犯人们服刑改正的期间，我就姑且帮忙照看一下他们的家属吧。"
                        },
                        {
                            "id": "690590417",
                            "speaker": "鹿野院平藏",
                            "text": "毕竟扶危济困，与人为善，也是普通人平藏会坚守的原则嘛。",
                            "choices": [
                                {
                                    "id": "690590418",
                                    "text": "要带着东西上门探访吗？",
                                    "response": [
                                        {
                                            "id": "690590419",
                                            "speaker": "鹿野院平藏",
                                            "text": "哎呀呀，这可不行。家属们看到我这张脸，脾气不好一点的，说不好就直接打上来喽。"
                                        },
                                        {
                                            "id": "690590420",
                                            "speaker": "鹿野院平藏",
                                            "text": "你看，我的原意是想给他们一些关怀，还是不触碰伤疤为好。"
                                        },
                                        {
                                            "id": "690590421",
                                            "speaker": "鹿野院平藏",
                                            "text": "把东西和信件放门口就走吧。"
                                        },
                                        {
                                            "id": "690590425",
                                            "speaker": "鹿野院平藏",
                                            "text": "那么，等你准备好，我们就出发吧。"
                                        },
                                        {
                                            "id": "690590426",
                                            "speaker": "鹿野院平藏",
                                            "text": "我的直觉告诉我，这一路有你同行，一定会是最顺利、最愉快的一次。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690590422",
                                    "text": "要把东西放门口就走吗？",
                                    "response": [
                                        {
                                            "id": "690590423",
                                            "speaker": "鹿野院平藏",
                                            "text": "真不愧是我的搭档，在我解释之前，就把这一层也想到了。"
                                        },
                                        {
                                            "id": "690590424",
                                            "speaker": "鹿野院平藏",
                                            "text": "你和我如此心有灵犀，再说什么都嫌多喽。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690590413",
                    "text": "原来你那么关心他们…",
                    "response": [
                        {
                            "id": "690590414",
                            "speaker": "鹿野院平藏",
                            "text": "嗯…还原真相，是侦探平藏应该做的事。"
                        },
                        {
                            "id": "690590415",
                            "speaker": "鹿野院平藏",
                            "text": "但在案件侦破之后，至少在舆论上，犯人这边的家人会遭受更多谩骂和歧视。"
                        },
                        {
                            "id": "690590416",
                            "speaker": "鹿野院平藏",
                            "text": "我当然也盼望着他们可以早日摆脱事件的影响，继续好好生活…"
                        }
                    ]
                }
            ]
        }
    ]
}