{
    "talkId": "6912704",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 7,
        "叶洛亚": 19
    },
    "dialogues": [
        {
            "id": "691270401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691270402",
            "speaker": "叶洛亚",
            "text": "说来我研究了一下你的这处秘密基地，果然很神奇啊。"
        },
        {
            "id": "691270403",
            "speaker": "叶洛亚",
            "text": "看似四处都是破绽，但实际上却是个密不透风的小天地。"
        },
        {
            "id": "691270404",
            "speaker": "叶洛亚",
            "text": "就算是阿咚，想要偷偷跑出去恐怕也没那么容易。"
        },
        {
            "id": "691270405",
            "speaker": "叶洛亚",
            "text": "但是话又说回来，要是有魔物也钻进这个壶里，并且占据了入口的话…"
        },
        {
            "id": "691270406",
            "speaker": "叶洛亚",
            "text": "那里面的人不就危险了吗？",
            "choices": [
                {
                    "id": "691270407",
                    "text": "魔物应该进不来吧？",
                    "response": [
                        {
                            "id": "691270408",
                            "speaker": "叶洛亚",
                            "text": "应该…这也就是说依然有受到魔物袭击的可能对吧？"
                        },
                        {
                            "id": "691270409",
                            "speaker": "叶洛亚",
                            "text": "比如，它们或许会变化成你熟人的样子，然后趁你不注意就偷偷跑进来。"
                        },
                        {
                            "id": "691270413",
                            "speaker": "Player",
                            "text": "真的会有这种事吗…"
                        },
                        {
                            "id": "691270414",
                            "speaker": "叶洛亚",
                            "text": "毕竟只要不是百分百确保的事情，就有可能发生吧？"
                        },
                        {
                            "id": "691270415",
                            "speaker": "叶洛亚",
                            "text": "但俗话又说，这个世界上没有什么事情是百分百确保的。"
                        },
                        {
                            "id": "691270416",
                            "speaker": "Player",
                            "text": "那依叶洛亚的想法呢？"
                        },
                        {
                            "id": "691270417",
                            "speaker": "叶洛亚",
                            "text": "嗯嗯，说到底还是要防患于未然嘛。不然等到真的出现危险的时候，可就来不及了。"
                        },
                        {
                            "id": "691270418",
                            "speaker": "叶洛亚",
                            "text": "所以我最近打算围绕着这里的入口，先修筑一座瓮城。"
                        },
                        {
                            "id": "691270419",
                            "speaker": "叶洛亚",
                            "text": "这样就算有敌人偷偷溜进来，也会立马发现自己掉入了我的陷阱。"
                        },
                        {
                            "id": "691270420",
                            "speaker": "叶洛亚",
                            "text": "接下来可以再围绕着修好的瓮城，建造几座用来防守的塔楼。考虑到射击死角的话…嗯，八座哨塔刚刚好。"
                        },
                        {
                            "id": "691270421",
                            "speaker": "叶洛亚",
                            "text": "充分利用材料的话，想必可以造出不亚于皮拉米达的城堡，就交给我吧。",
                            "choices": [
                                {
                                    "id": "691270422",
                                    "text": "你有想做的事情也很好。",
                                    "response": [
                                        {
                                            "id": "691270424",
                                            "speaker": "叶洛亚",
                                            "text": "哦对了，这样一说，也不能忘记还得建一座粮仓，在里面储备上足够供我们所有人吃上半年的食物。"
                                        },
                                        {
                                            "id": "691270425",
                                            "speaker": "叶洛亚",
                                            "text": "老爹说过，所谓战争，大多数时候就是看哪一方能撑得更久。"
                                        },
                                        {
                                            "id": "691270426",
                                            "speaker": "叶洛亚",
                                            "text": "在这一点上，我们可不能输啊！"
                                        }
                                    ]
                                },
                                {
                                    "id": "691270423",
                                    "text": "考虑得还真是周到。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691270410",
                    "text": "我不会放魔物进来。",
                    "response": [
                        {
                            "id": "691270411",
                            "speaker": "叶洛亚",
                            "text": "我当然相信你，但人总有考虑不到的事情吧。"
                        },
                        {
                            "id": "691270412",
                            "speaker": "叶洛亚",
                            "text": "说不定魔物会变化成你熟人的样子，然后趁你不注意就偷偷跑进来。"
                        }
                    ]
                }
            ]
        }
    ]
}