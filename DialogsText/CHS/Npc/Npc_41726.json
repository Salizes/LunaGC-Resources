    "dialogues": [
        {
            "id": "4015142503",
            "speaker": "Player",
            "text": "关于甜甜花。"
        },
        {
            "id": "4015142509",
            "speaker": "芙萝拉",
            "text": "甜甜花啊…呼呼。"
        },
        {
            "id": "4015142510",
            "speaker": "芙萝拉",
            "text": "花朵是很好看，但大家一般都是拿它去做菜的呢。"
        },
        {
            "id": "4015142511",
            "speaker": "芙萝拉",
            "text": "要是你看到有人家里种着甜甜花盆栽…"
        },
        {
            "id": "4015142512",
            "speaker": "芙萝拉",
            "text": "说不定只是为了熬糖用的呢，呼呼。"
        }
    ]
}