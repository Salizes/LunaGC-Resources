{
    "talkId": "6907202",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "坎蒂丝": 9
    },
    "dialogues": [
        {
            "id": "690720201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690720202",
            "speaker": "坎蒂丝",
            "text": "嗯，虽然是和阿如村完全不同的环境，但也能让人感到安心。"
        },
        {
            "id": "690720203",
            "speaker": "坎蒂丝",
            "text": "我第一次进来时十分惊讶，明明只是一个小壶，里面却有如此广阔的空间…"
        },
        {
            "id": "690720204",
            "speaker": "坎蒂丝",
            "text": "如果能把阿如村装进壶里的话…",
            "choices": [
                {
                    "id": "690720205",
                    "text": "要试试看吗？",
                    "response": [
                        {
                            "id": "690720206",
                            "speaker": "坎蒂丝",
                            "text": "只是妄语罢了。就算它从效果上能实现，我要守护的，也不是「阿如村」这个物件。"
                        },
                        {
                            "id": "690720207",
                            "speaker": "坎蒂丝",
                            "text": "…而是我的故乡和其中每一个人的生活。"
                        },
                        {
                            "id": "690720211",
                            "speaker": "坎蒂丝",
                            "text": "#真是抱歉，{NICKNAME}，让你听到奇怪的话了。"
                        },
                        {
                            "id": "690720212",
                            "speaker": "坎蒂丝",
                            "text": "还有，谢谢你邀请我到这儿做客。"
                        }
                    ]
                },
                {
                    "id": "690720208",
                    "text": "这样确实能方便很多…",
                    "response": [
                        {
                            "id": "690720209",
                            "speaker": "坎蒂丝",
                            "text": "唔，如果真的能带着大家轻松地抵达世上不同的地方…"
                        },
                        {
                            "id": "690720210",
                            "speaker": "坎蒂丝",
                            "text": "不，恐怕他们也不愿意离开沙漠，到别的地方去吧。"
                        }
                    ]
                }
            ]
        }
    ]
}