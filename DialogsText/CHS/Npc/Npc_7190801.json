    "dialogues": [
        {
            "id": "719080101",
            "speaker": "Player",
            "text": "这么严肃吗…"
        },
        {
            "id": "719080102",
            "speaker": "九贯",
            "text": "嗯，或许是我的用词太正经，让您有了误解。"
        },
        {
            "id": "719080103",
            "speaker": "九贯",
            "text": "品茶本身是一件相当轻松的事，无需沐浴更衣焚香之类的夸张礼节，好好享受就行了！"
        },
        {
            "id": "719080104",
            "speaker": "九贯",
            "text": "但愿您也能在品茶时找到心灵的宁静。"
        }
    ]
}