    "dialogues": [
        {
            "id": "5080801",
            "speaker": "留言",
            "text": "「千叶华子，千叶龙一，前蛇骨矿洞工人，有技术证书，身体健康，吃苦耐劳。」"
        },
        {
            "id": "5080802",
            "speaker": "留言",
            "text": "「切望获得一份诚实的工作，以贴补家庭日常衣食租费。希望能在同一场所工作。」"
        },
        {
            "id": "5080803",
            "speaker": "留言",
            "text": "「薪水、福利可面谈！」"
        }
    ]
}