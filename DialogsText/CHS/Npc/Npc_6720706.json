    "dialogues": [
        {
            "id": "672070601",
            "speaker": "Player",
            "text": "（翻看。）"
        },
        {
            "id": "672070602",
            "speaker": "奈芙尔",
            "text": "阿舍鲁，有什么发现么？"
        },
        {
            "id": "672070603",
            "speaker": "阿舍鲁",
            "text": "喵。喵？"
        },
        {
            "id": "672070604",
            "speaker": "奈芙尔",
            "text": "呵…昨天又和雅珂达去哪里玩了，回来的时候窗户都没关好。"
        },
        {
            "id": "672070605",
            "speaker": "阿舍鲁",
            "text": "喵喵，喵喵喵喵…"
        },
        {
            "id": "672070606",
            "speaker": "奈芙尔",
            "text": "不过，这次雅珂达偷偷出门，至少没有发出大动静，算她有点长进。"
        },
        {
            "id": "672070607",
            "speaker": "奈芙尔",
            "text": "嗯，这封信里的委托，正好就交给她去办吧。"
        }
    ]
}