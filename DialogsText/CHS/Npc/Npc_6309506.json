    },
    "dialogues": [
        {
            "id": "630950601",
            "speaker": "Player",
            "text": "你的手续…"
        },
        {
            "id": "630950602",
            "speaker": "罗伯特",
            "text": "唉，听我说啊，我真倒霉！"
        },
        {
            "id": "630950603",
            "speaker": "罗伯特",
            "text": "之前我托一位至冬朋友帮衬，费尽千辛万苦准备好了所有的文件，然后又千里迢迢和船队来到这里…"
        },
        {
            "id": "630950604",
            "speaker": "罗伯特",
            "text": "结果因为没搞明白他们的「收费」标准，一直没把凭证办下来！"
        },
        {
            "id": "630950605",
            "speaker": "罗伯特",
            "text": "然后现在勘定奉行被上面审查，不乱收费了…"
        }
    ]
}