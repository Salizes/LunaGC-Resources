{
    "talkId": "6907711",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "瑶瑶": 14
    },
    "dialogues": [
        {
            "id": "690770401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690770402",
            "speaker": "瑶瑶",
            "text": "你对小团雀感兴趣吗？它们唱歌很好听哦。"
        },
        {
            "id": "690770403",
            "speaker": "瑶瑶",
            "text": "我也会，嘿嘿！"
        },
        {
            "id": "690770404",
            "speaker": "Player",
            "text": "瑶瑶怎么会这个？"
        },
        {
            "id": "690770405",
            "speaker": "瑶瑶",
            "text": "以前家父家母忙于种草药，我时常一个人跑去山林里面玩…"
        },
        {
            "id": "690770406",
            "speaker": "瑶瑶",
            "text": "有一次，碰巧遇到过那种情况哦！大团雀教小团雀唱歌。"
        },
        {
            "id": "690770407",
            "speaker": "瑶瑶",
            "text": "大团雀叫一句，小团雀学一句，瑶瑶也跟一句。啾啾啾~♪",
            "choices": [
                {
                    "id": "690770408",
                    "text": "以后可以多来这边玩。",
                    "response": [
                        {
                            "id": "690770409",
                            "speaker": "瑶瑶",
                            "text": "好呀，那我就恭敬不如从命啦！"
                        },
                        {
                            "id": "690770410",
                            "speaker": "瑶瑶",
                            "text": "为了感谢你的「收留之恩」，就让瑶瑶教你小团雀的歌吧。"
                        },
                        {
                            "id": "690770414",
                            "speaker": "瑶瑶",
                            "text": "你放心你放心，这可比练枪简单多啦！"
                        },
                        {
                            "id": "690770415",
                            "speaker": "Player",
                            "text": "但我用的是单手剑…"
                        },
                        {
                            "id": "690770416",
                            "speaker": "瑶瑶",
                            "text": "不用紧张，师父教过我一个词…「触类旁通」！"
                        },
                        {
                            "id": "690770417",
                            "speaker": "瑶瑶",
                            "text": "比起熟练掌握，我更希望你像我一样享受这个放松的过程。"
                        },
                        {
                            "id": "690770418",
                            "speaker": "瑶瑶",
                            "text": "所以，只需要跟着我就好啦，我一句，你跟一句。"
                        },
                        {
                            "id": "690770419",
                            "speaker": "瑶瑶",
                            "text": "其他事情不用操心，瑶瑶都会准备好的！"
                        }
                    ]
                },
                {
                    "id": "690770411",
                    "text": "好有意思…",
                    "response": [
                        {
                            "id": "690770412",
                            "speaker": "瑶瑶",
                            "text": "对吧！这就是所谓的…嗯，唔…噢噢…「妙趣横生」！"
                        },
                        {
                            "id": "690770413",
                            "speaker": "瑶瑶",
                            "text": "我想把这份「妙趣」也分享给你！"
                        }
                    ]
                }
            ]
        }
    ]
}