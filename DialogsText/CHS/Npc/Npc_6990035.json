{
    "talkId": "6990035",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "699003501",
            "speaker": "Player",
            "text": "关于兰那罗用的称呼…"
        },
        {
            "id": "699003502",
            "speaker": "派蒙",
            "text": "兰罗摩，兰拉娜，兰拉迦，兰加惟…唔，兰那罗的名字还真是难记…"
        },
        {
            "id": "699003503",
            "speaker": "派蒙",
            "text": "唯一能确定的就是名字最开始一定是个兰字！",
            "choices": [
                {
                    "id": "699003504",
                    "text": "如果派蒙是兰那罗的话…",
                    "response": [
                        {
                            "id": "699003506",
                            "speaker": "派蒙",
                            "text": "是呢，如果是你…"
                        },
                        {
                            "id": "699003507",
                            "speaker": "派蒙",
                            "text": "这么说来，如果是称呼你的话，他们都会叫那菈旅行者呢…"
                        },
                        {
                            "id": "699003508",
                            "speaker": "Player",
                            "text": "那菈就是他们对我们的称呼吧…"
                        },
                        {
                            "id": "699003509",
                            "speaker": "派蒙",
                            "text": "那如果有个名字是那菈的家伙，被他们称呼的话会变成什么样？"
                        },
                        {
                            "id": "699003510",
                            "speaker": "Player",
                            "text": "那菈那菈…吧，感觉有点可爱。"
                        },
                        {
                            "id": "699003511",
                            "speaker": "派蒙",
                            "text": "嘿嘿，确实呢。"
                        }
                    ]
                },
                {
                    "id": "699003505",
                    "text": "派蒙的名字就会变成兰派蒙呢。"
                }
            ]
        }
    ]
}