{
    "talkId": "6143906",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "劳伦斯": 13
    },
    "dialogues": [
        {
            "id": "4015143902",
            "speaker": "Player",
            "text": "关于蒙德城。"
        },
        {
            "id": "4015143906",
            "speaker": "劳伦斯",
            "text": "是「北境的明冠」，是「牧歌之城」，是多少赞美之词都不足以描述的美妙城市。"
        },
        {
            "id": "4015143907",
            "speaker": "劳伦斯",
            "text": "最近城里又来了个吟游诗人，想体验蒙德风情的话，可以去进城找找他。"
        },
        {
            "id": "4015143908",
            "speaker": "劳伦斯",
            "text": "不过他的曲子…怎么说呢，有点太古典了？"
        },
        {
            "id": "4015143909",
            "speaker": "劳伦斯",
            "text": "…那种千年前的歌谣，他究竟是从哪里学到的呢…",
            "choices": [
                {
                    "id": "4015143903",
                    "text": "蒙德有什么传说吗？",
                    "response": [
                        {
                            "id": "4015143910",
                            "speaker": "劳伦斯",
                            "text": "那你可问对人了。"
                        },
                        {
                            "id": "4015143911",
                            "speaker": "劳伦斯",
                            "text": "据说蒙德最近的晚上，经常有一位惩恶扬善的英雄人物出现。"
                        },
                        {
                            "id": "4015143912",
                            "speaker": "劳伦斯",
                            "text": "不过至今还没人知道他的身份…"
                        },
                        {
                            "id": "4015143913",
                            "speaker": "劳伦斯",
                            "text": "不行不行，提起他的事我就要说个没完啦，万一又被团长看到…"
                        },
                        {
                            "id": "4015143914",
                            "speaker": "劳伦斯",
                            "text": "等下次有机会再和你聊吧，真是不好意思。"
                        }
                    ]
                },
                {
                    "id": "4015143904",
                    "text": "蒙德有什么逸闻吗？",
                    "response": [
                        {
                            "id": "4015143915",
                            "speaker": "劳伦斯",
                            "text": "逸闻啊…不知道这个算不算。"
                        },
                        {
                            "id": "4015143916",
                            "speaker": "劳伦斯",
                            "text": "我在这里站岗的时候，偶尔会注意到天气突变，电闪雷鸣…不过一小会儿就又消失了。"
                        },
                        {
                            "id": "4015143917",
                            "speaker": "劳伦斯",
                            "text": "嗯…感觉不像是自然现象，是人为操控天气所致。可又是谁拥有这么强的魔力呢？"
                        },
                        {
                            "id": "4015143918",
                            "speaker": "劳伦斯",
                            "text": "骑士团的高层似乎也没有这样的人物，真是奇怪。"
                        }
                    ]
                }
            ]
        }
    ]
}