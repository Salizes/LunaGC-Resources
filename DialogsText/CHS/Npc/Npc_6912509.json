{
    "talkId": "6912509",
    "total_dialogue_lines": 47,
    "speaker_counts": {
        "Player": 23,
        "哥伦比娅": 24
    },
    "dialogues": [
        {
            "id": "691250401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691250402",
            "speaker": "哥伦比娅",
            "text": "唔…都到你这边来做客了，还要让你实现我的愿望，是不是不太好？",
            "choices": [
                {
                    "id": "691250403",
                    "text": "没关系的。",
                    "response": [
                        {
                            "id": "691250405",
                            "speaker": "哥伦比娅",
                            "text": "好吧。那我的确有想让你帮忙的事。"
                        },
                        {
                            "id": "691250406",
                            "speaker": "Player",
                            "text": "说来听听。"
                        },
                        {
                            "id": "691250407",
                            "speaker": "哥伦比娅",
                            "text": "菈乌玛之前说过，会将我介绍给现在的「霜月之子」，希望我能融入这个家庭。"
                        },
                        {
                            "id": "691250408",
                            "speaker": "哥伦比娅",
                            "text": "我很高兴她这么说，但…也会有些担心。"
                        },
                        {
                            "id": "691250409",
                            "speaker": "Player",
                            "text": "担心什么？"
                        },
                        {
                            "id": "691250410",
                            "speaker": "哥伦比娅",
                            "text": "我很少和陌生人相处，有些担心聊天时把握不好尺度。我不希望让「霜月之子」的大家感到不自在。"
                        },
                        {
                            "id": "691250411",
                            "speaker": "哥伦比娅",
                            "text": "所以，我想让你陪我…演练？或者说模仿一下可能会遇到的情况。"
                        },
                        {
                            "id": "691250412",
                            "speaker": "Player",
                            "text": "具体要怎么做？"
                        },
                        {
                            "id": "691250413",
                            "speaker": "哥伦比娅",
                            "text": "很简单，你问我一些「霜月之子」的人们可能会问的问题，我来回答。如果有不合适的答案，就告诉我。",
                            "choices": [
                                {
                                    "id": "691250414",
                                    "text": "其实哥伦比娅做自己就好…",
                                    "response": [
                                        {
                                            "id": "691250415",
                                            "speaker": "哥伦比娅",
                                            "text": "我知道。但难得的机会，还是想和「霜月之子」的大家相处得更融洽些。"
                                        },
                                        {
                                            "id": "691250417",
                                            "speaker": "哥伦比娅",
                                            "text": "那就开始吧。"
                                        },
                                        {
                                            "id": "691250418",
                                            "speaker": "Player",
                                            "text": "月神大人还会离开我们吗？"
                                        },
                                        {
                                            "id": "691250419",
                                            "speaker": "哥伦比娅",
                                            "text": "会的。",
                                            "choices": [
                                                {
                                                    "id": "691250420",
                                                    "text": "…啊？",
                                                    "response": [
                                                        {
                                                            "id": "691250422",
                                                            "speaker": "哥伦比娅",
                                                            "text": "嗯？旅行的时候就会离开呀。",
                                                            "choices": [
                                                                {
                                                                    "id": "691250423",
                                                                    "text": "这个要说清楚…",
                                                                    "response": [
                                                                        {
                                                                            "id": "691250425",
                                                                            "speaker": "哥伦比娅",
                                                                            "text": "哦。好的，要说清楚。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "691250426",
                                                                                    "text": "以防万一…",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "691250428",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "好的。"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250429",
                                                                                            "speaker": "Player",
                                                                                            "text": "您能保佑我求婚成功吗？"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250430",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "不行。"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250431",
                                                                                            "speaker": "Player",
                                                                                            "text": "您能保佑我家孩子长高吗？"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250432",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "如果你家孩子是凛角鹿的话…"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250433",
                                                                                            "speaker": "Player",
                                                                                            "text": "这种时候也说不行就好。"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250434",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "好的，不行。"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250435",
                                                                                            "speaker": "Player",
                                                                                            "text": "您有想要邀请来做客的人吗？"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250436",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "「愚人众」的桑多涅，还有阿蕾奇诺。她们很好奇我在这里的生活。"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250437",
                                                                                            "speaker": "Player",
                                                                                            "text": "这个不太合适…"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250438",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "欸…？不能让她们看吗？"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250439",
                                                                                            "speaker": "Player",
                                                                                            "text": "是对「霜月之子」不合适…"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250440",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "好吧。那就邀请梅拉，还有阿贝多先生和尼可小姐。"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250441",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "阿贝多先生和梅拉很会画画，尼可小姐有很多写书的点子。我想请他们记录下「霜月之子」如今幸福的模样。"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250442",
                                                                                            "speaker": "Player",
                                                                                            "text": "不错的想法。"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250443",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "嗯，桑多涅和阿蕾奇诺，就等有机会的时候悄悄带她们来吧。"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250444",
                                                                                            "speaker": "Player",
                                                                                            "text": "这个不能说哦…"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250445",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "好，这个不能说。"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250446",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "唔…我是不是回答得不够好？"
                                                                                        },
                                                                                        {
                                                                                            "id": "691250447",
                                                                                            "speaker": "哥伦比娅",
                                                                                            "text": "有机会的话，再陪我多练练吧。"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "691250427",
                                                                                    "text": "问几个有些传统的问题…"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "691250424",
                                                                    "text": "他们问的不是这个「离开」…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691250421",
                                                    "text": "会…会吗？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691250416",
                                    "text": "我明白了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691250404",
                    "text": "这是我的待客之道。"
                }
            ]
        }
    ]
}