{
    "talkId": "6906304",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 8,
        "申鹤": 13
    },
    "dialogues": [
        {
            "id": "690630401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690630402",
            "speaker": "申鹤",
            "text": "嗯，想吃饭。"
        },
        {
            "id": "690630403",
            "speaker": "Player",
            "text": "肚子饿了吗？"
        },
        {
            "id": "690630404",
            "speaker": "申鹤",
            "text": "其实不太饿…我只是想和你一起坐下来，慢慢地吃顿饭。"
        },
        {
            "id": "690630405",
            "speaker": "申鹤",
            "text": "我听说「吃饭」在璃月人眼中是件大事。"
        },
        {
            "id": "690630406",
            "speaker": "申鹤",
            "text": "不仅为了填饱肚子，更重要的是，「跟重要的人共享一段温馨时光」。"
        },
        {
            "id": "690630407",
            "speaker": "申鹤",
            "text": "聚在一起吃饭，这个场面就叫「团圆」。我学的对吗？"
        },
        {
            "id": "690630408",
            "speaker": "Player",
            "text": "对，尤其在节日里。"
        },
        {
            "id": "690630409",
            "speaker": "申鹤",
            "text": "比如海灯节？我知道会放霄灯，但海灯节一年只有一次。太遗憾了。",
            "choices": [
                {
                    "id": "690630410",
                    "text": "也有其他节日…",
                    "response": [
                        {
                            "id": "690630412",
                            "speaker": "申鹤",
                            "text": "是吗…"
                        },
                        {
                            "id": "690630413",
                            "speaker": "申鹤",
                            "text": "以前总觉得，任何节日都与我无关，但现在…心中好像有个声音呼唤下个节日早点到来。"
                        },
                        {
                            "id": "690630414",
                            "speaker": "申鹤",
                            "text": "想用我学到的东西，和你一起庆祝。",
                            "choices": [
                                {
                                    "id": "690630415",
                                    "text": "不知不觉间…",
                                    "response": [
                                        {
                                            "id": "690630417",
                                            "speaker": "申鹤",
                                            "text": "这是因为一直有你指导。我不会忘记你的恩情。"
                                        },
                                        {
                                            "id": "690630418",
                                            "speaker": "申鹤",
                                            "text": "我对你的感情，也不止感激…"
                                        },
                                        {
                                            "id": "690630419",
                                            "speaker": "申鹤",
                                            "text": "总之，下个节日，我们也一起度过吧。"
                                        },
                                        {
                                            "id": "690630420",
                                            "speaker": "Player",
                                            "text": "团团圆圆？"
                                        },
                                        {
                                            "id": "690630421",
                                            "speaker": "申鹤",
                                            "text": "嗯，团团圆圆。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690630416",
                                    "text": "申鹤成熟起来了…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690630411",
                    "text": "比如逐月节会一起赏月…"
                }
            ]
        }
    ]
}