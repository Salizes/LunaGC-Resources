    "speaker_counts": {
        "Player": 1,
        "阿梅妲": 5
    },
    "dialogues": [
        {
            "id": "661090201",
            "speaker": "Player",
            "text": "工作多是好事吗？"
        },
        {
            "id": "661090202",
            "speaker": "阿梅妲",
            "text": "具体要看是什么工作。对我来说，是的。"
        },
        {
            "id": "661090203",
            "speaker": "阿梅妲",
            "text": "你看，我是部族里负责制作、修理运动装备的人。"
        },
        {
            "id": "661090204",
            "speaker": "阿梅妲",
            "text": "钩锁啊、护具啊之类的，有需要的尽管来找我，也算是照顾我的生意了。"
        },
        {
            "id": "661090205",
            "speaker": "阿梅妲",
            "text": "而我的生意越多，就意味着等着用装备的人越多。"
        },
        {
            "id": "661090206",
            "speaker": "阿梅妲",
            "text": "——总比人越少要好，对吧？"
        }
    ]
}