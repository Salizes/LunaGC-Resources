    "dialogues": [
        {
            "id": "661050201",
            "speaker": "Player",
            "text": "刚刚在乱跑什么呢？"
        },
        {
            "id": "661050202",
            "speaker": "马伊塔",
            "text": "怎么能说是乱跑呢！我明明是在训练。"
        },
        {
            "id": "661050203",
            "speaker": "马伊塔",
            "text": "大人们都说我跑得贼快，是他们见过的跑得最快的调皮蛋。"
        },
        {
            "id": "661050204",
            "speaker": "马伊塔",
            "text": "所以我要学有所长，继续加油，早日成为在深渊里跑得最快的战士！"
        }
    ]
}