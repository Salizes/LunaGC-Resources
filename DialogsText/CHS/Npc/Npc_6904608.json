{
    "talkId": "6904608",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "胡桃": 9
    },
    "dialogues": [
        {
            "id": "690460801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690460402",
            "speaker": "胡桃",
            "text": "唔？想做的事…我每天都在做自己想做的事哦。"
        },
        {
            "id": "690460403",
            "speaker": "胡桃",
            "text": "所以，今天就不干那些有的没的了，让我在你家呆着吧。"
        },
        {
            "id": "690460404",
            "speaker": "胡桃",
            "text": "你家有山有水，有吃有玩，还有你陪我，多好啊。"
        },
        {
            "id": "690460405",
            "speaker": "Player",
            "text": "胡桃很喜欢这里啊。"
        },
        {
            "id": "690460406",
            "speaker": "胡桃",
            "text": "说什么傻话…院子亭子哪里没有？喜欢的怎么会是屋子呢。"
        },
        {
            "id": "690460407",
            "speaker": "胡桃",
            "text": "还能为什么呀，当然是~当然是~你猜！"
        },
        {
            "id": "690460408",
            "speaker": "胡桃",
            "text": "唉，瞧你这表情…不逗你了。"
        },
        {
            "id": "690460409",
            "speaker": "胡桃",
            "text": "我呀，就是喜欢跟你一起玩。你要是不陪我，就是不拿我当朋友哦。",
            "choices": [
                {
                    "id": "690460410",
                    "text": "我猜也是这样。",
                    "response": [
                        {
                            "id": "690460412",
                            "speaker": "胡桃",
                            "text": "哼哼，反正不管你说什么，我今天就要赖在这儿，谁也别想把我拉走。"
                        },
                        {
                            "id": "690460413",
                            "speaker": "胡桃",
                            "text": "我们关系这么好，你肯定不会介意的吧？"
                        }
                    ]
                },
                {
                    "id": "690460411",
                    "text": "胡桃醉翁之意不在酒呢。"
                }
            ]
        }
    ]
}