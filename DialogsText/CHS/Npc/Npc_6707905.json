    "dialogues": [
        {
            "id": "670790501",
            "speaker": "Player",
            "text": "不如你再看看别的？"
        },
        {
            "id": "670790502",
            "speaker": "卡乌妮娅",
            "text": "我看得已经够多了！"
        },
        {
            "id": "670790503",
            "speaker": "卡乌妮娅",
            "text": "你知道那夏镇里最时尚、最潮流的是什么人吗？是愚人众！真是令人绝望。"
        },
        {
            "id": "670790504",
            "speaker": "卡乌妮娅",
            "text": "不过话说回来，你的穿搭真是不错，这色彩的搭配，简直让人如沐春风。"
        }
    ]
