        {
            "id": "630890201",
            "speaker": "Player",
            "text": "驻留许可证？"
        },
        {
            "id": "630890202",
            "speaker": "百合华",
            "text": "根据稻妻现行的锁国令，异国的来客如果想要在离岛长期停留的话，需要办理驻留许可哦。"
        },
        {
            "id": "630890203",
            "speaker": "百合华",
            "text": "在办理驻留手续之前，请事先准备好登岛许可证…以及其他所需的「材料」。"
        }
    ]
}