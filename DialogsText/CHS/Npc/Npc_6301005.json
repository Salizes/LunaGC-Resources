    "dialogues": [
        {
            "id": "630100501",
            "speaker": "Player",
            "text": "「客气地」…？"
        },
        {
            "id": "630100502",
            "speaker": "梢",
            "text": "对，请问有什么疑问吗？"
        },
        {
            "id": "630100503",
            "speaker": "梢",
            "text": "身为高档茶室的看板娘，又为神里家工作，通情达理可是必须的美德。"
        },
        {
            "id": "630100504",
            "speaker": "梢",
            "text": "即便来客不是正派人士，我也会以礼相待…只要，他们也识趣的话。"
        }
    ]
}