    "dialogues": [
        {
            "id": "624200301",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "624200302",
            "speaker": "花初",
            "text": "失礼了…我是明华商行掌柜的次女，今日特出行远游。"
        },
        {
            "id": "624200303",
            "speaker": "花初",
            "text": "不过因为是第一次远行…还是不太适应呢…",
            "choices": [
                {
                    "id": "624200304",
                    "text": "只有你们两个人吗？",
                    "response": [
                        {
                            "id": "624200305",
                            "speaker": "花初",
                            "text": "是的，因为…生意上的考虑，我只带了一人随行。"
                        }
                    ]
                },
                {
                    "id": "624200306",
                    "text": "你们要去哪里？",
                    "response": [
                        {
                            "id": "624200307",
                            "speaker": "花初",
                            "text": "抱歉，这是商业机密，不便透露。"
                        }
                    ]
                }
            ]
        }
    ]
