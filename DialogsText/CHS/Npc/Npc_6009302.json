    "speaker_counts": {
        "安娜": 9
    },
    "dialogues": [
        {
            "id": "4015140502",
            "speaker": "安娜",
            "text": "你在干什么？"
        },
        {
            "id": "4015140506",
            "speaker": "安娜",
            "text": "我在…咳咳…许愿。"
        },
        {
            "id": "4015140507",
            "speaker": "安娜",
            "text": "像这样把硬币投进水池里，然后默念心愿…"
        },
        {
            "id": "4015140508",
            "speaker": "安娜",
            "text": "据说…要有诚心，坚持每天许愿，泉水精灵才会听到…咳…"
        },
        {
            "id": "4015140509",
            "speaker": "安娜",
            "text": "对不起，那个…一直在咳嗽…"
        },
        {
            "id": "4015140503",
            "speaker": "安娜",
            "text": "你的愿望是？"
        },
        {
            "id": "4015140510",
            "speaker": "安娜",
            "text": "啊…我的身体一直不太好。"
        },
        {
            "id": "4015140511",
            "speaker": "安娜",
            "text": "我想要泉水精灵保佑我快点好起来。"
        },
        {
            "id": "4015140512",
            "speaker": "安娜",
            "text": "这样，就不会再给爸爸妈妈，还有安东尼哥哥添麻烦了…"
        }
    ]
}