    "dialogues": [
        {
            "id": "690891001",
            "speaker": "芙宁娜",
            "text": "啊，这样的景致，让我又想起了之前莅临欧庇克莱歌剧院的时光。"
        },
        {
            "id": "690891002",
            "speaker": "芙宁娜",
            "text": "咳咳…啊——啊啊——"
        },
        {
            "id": "690891003",
            "speaker": "芙宁娜",
            "text": "怎么了？看你吃惊的样子。水雾即是幕布，繁花即是舞台，大明星无论在哪都能为热忱的观众献唱。"
        }
    ]
}