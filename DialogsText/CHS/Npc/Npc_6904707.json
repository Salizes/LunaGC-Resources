{
    "talkId": "6904707",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "枫原万叶": 13
    },
    "dialogues": [
        {
            "id": "690470701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690470302",
            "speaker": "枫原万叶",
            "text": "可以啊，不过聊点什么好呢…我想想。"
        },
        {
            "id": "690470303",
            "speaker": "枫原万叶",
            "text": "最近到雨季了吧，有什么关于雨的话题吗？",
            "choices": [
                {
                    "id": "690470304",
                    "text": "经常在野外遇见暴雨…",
                    "response": [
                        {
                            "id": "690470305",
                            "speaker": "枫原万叶",
                            "text": "嗯，如果雨势很大，一般会找个地方躲雨吧。"
                        },
                        {
                            "id": "690470308",
                            "speaker": "枫原万叶",
                            "text": "首选是山洞，不过如果山洞里有野兽，就需要先和它较量一番。"
                        },
                        {
                            "id": "690470309",
                            "speaker": "枫原万叶",
                            "text": "其次的话会选择废弃的寺庙，不过那里通常四面漏风，还带着一股散不掉的霉味。"
                        },
                        {
                            "id": "690470310",
                            "speaker": "枫原万叶",
                            "text": "如果实在没什么条件，也会在树底下躲雨。"
                        },
                        {
                            "id": "690470311",
                            "speaker": "枫原万叶",
                            "text": "但是有雷暴的时候就不敢这么做了，会很危险。"
                        },
                        {
                            "id": "690470312",
                            "speaker": "枫原万叶",
                            "text": "最后会试着去亮灯的人家碰碰运气…当然运气不好就算了。"
                        },
                        {
                            "id": "690470313",
                            "speaker": "Player",
                            "text": "为什么最后才去试着借宿？"
                        },
                        {
                            "id": "690470314",
                            "speaker": "枫原万叶",
                            "text": "雨夜有人带刀来访，一般人都会下意识地警惕吧。"
                        },
                        {
                            "id": "690470315",
                            "speaker": "枫原万叶",
                            "text": "知道了这个道理，就没必要去打扰他们了。反正天地广阔，总有地方可去。"
                        },
                        {
                            "id": "690470316",
                            "speaker": "枫原万叶",
                            "text": "别担心，野外不会一直下雨，人生也不会一直阴云密布。"
                        },
                        {
                            "id": "690470317",
                            "speaker": "枫原万叶",
                            "text": "在晴朗的夜晚抬起头，自然会见到漫天星河。"
                        }
                    ]
                },
                {
                    "id": "690470306",
                    "text": "有什么躲雨的推荐吗？",
                    "response": [
                        {
                            "id": "690470307",
                            "speaker": "枫原万叶",
                            "text": "嗯…"
                        }
                    ]
                }
            ]
        }
    ]
}