{
    "talkId": "4008152",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "努查赫": 10,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "400815201",
            "speaker": "努查赫",
            "text": "啊呀，那位打进四强的选手…明明不属于生论派，却能和蕈兽配合成这样？传说中的学生，果然没法用常理去揣测呢！",
            "choices": [
                {
                    "id": "400815202",
                    "text": "传说中的学生？",
                    "response": [
                        {
                            "id": "400815203",
                            "speaker": "努查赫",
                            "text": "啊呀，这不是鼎鼎大名的「黄金流星」和「白银伴星」吗？"
                        },
                        {
                            "id": "400815204",
                            "speaker": "努查赫",
                            "text": "你们刚刚还和她友好比试了一场，怎么反倒来问我？"
                        },
                        {
                            "id": "400815205",
                            "speaker": "派蒙",
                            "text": "难道你说的是…莱依拉？"
                        },
                        {
                            "id": "400815206",
                            "speaker": "派蒙",
                            "text": "咦，莱依拉还有这种称号吗？能不能请你稍微解释一下…"
                        },
                        {
                            "id": "400815207",
                            "speaker": "努查赫",
                            "text": "原来你们也不太了解她啊，我就更不用说了，只听说了一点点未经证实的传闻…"
                        },
                        {
                            "id": "400815208",
                            "speaker": "努查赫",
                            "text": "传说中，那位学生会在深夜出没于各种地方，认真地观测星象。她转移观测阵地的动作迅速、利落，甚至能轻松长途跋涉…"
                        },
                        {
                            "id": "400815209",
                            "speaker": "派蒙",
                            "text": "好奇怪！怎么想都是看错了吧！"
                        },
                        {
                            "id": "400815210",
                            "speaker": "派蒙",
                            "text": "莱依拉平时的体力不太好，怎么想都做不到那种事吧。"
                        },
                        {
                            "id": "400815211",
                            "speaker": "努查赫",
                            "text": "我只是原样说出了传闻而已，对它的准确度概不负责哦。你如果更了解她，就请向我说明真实情况吧。",
                            "choices": [
                                {
                                    "id": "400815212",
                                    "text": "不告诉你。",
                                    "response": [
                                        {
                                            "id": "400815214",
                                            "speaker": "派蒙",
                                            "text": "对哦，不经本人同意就向别人转述她的情况，绝对不合适…你要是想知道的话，就自己去和莱依拉交朋友嘛。"
                                        },
                                        {
                                            "id": "400815215",
                                            "speaker": "努查赫",
                                            "text": "哈哈哈，你们很有义气很讲礼貌嘛！"
                                        },
                                        {
                                            "id": "400815216",
                                            "speaker": "努查赫",
                                            "text": "对我来说，真的也好假的也罢，都只是茶余饭后的闲谈罢了，没必要付出太多时间去证实。"
                                        },
                                        {
                                            "id": "400815217",
                                            "speaker": "努查赫",
                                            "text": "须弥这么大，她和我不属于同一个学派，反正以后也不会有什么交集。这场比赛结束后，我们肯定也没有任何交集了…"
                                        },
                                        {
                                            "id": "400815218",
                                            "speaker": "派蒙",
                                            "text": "话倒是没说错，不过总感觉有点无情…"
                                        }
                                    ]
                                },
                                {
                                    "id": "400815213",
                                    "text": "你自己去了解。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400815219",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "400815220",
                            "speaker": "努查赫",
                            "text": "可能不会再见了哦，两位忙碌的冠军候选人。"
                        }
                    ]
                }
            ]
        }
    ]
}