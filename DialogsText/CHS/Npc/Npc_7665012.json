{
    "talkId": "7665012",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 3,
        "盗宝鼬": 2,
        "菈乌玛": 9
    },
    "dialogues": [
        {
            "id": "766501201",
            "speaker": "盗宝鼬",
            "text": "♪"
        },
        {
            "id": "766501202",
            "speaker": "派蒙",
            "text": "#{NICKNAME}你看，那只盗宝鼬又来了，就站在菈乌玛旁边呢。"
        },
        {
            "id": "766501203",
            "speaker": "盗宝鼬",
            "text": "！！！"
        },
        {
            "id": "766501204",
            "speaker": "派蒙",
            "text": "欸？怎么一下子就走了…"
        },
        {
            "id": "766501205",
            "speaker": "Player",
            "text": "难道是认清之前的错误了？"
        },
        {
            "id": "766501206",
            "speaker": "菈乌玛",
            "text": "#来，{NICKNAME}，这枚摩拉，是那孩子请我转交给你的。"
        },
        {
            "id": "766501207",
            "speaker": "派蒙",
            "text": "#啊？盗宝鼬为什么要给{NICKNAME}摩拉呀？"
        },
        {
            "id": "766501208",
            "speaker": "菈乌玛",
            "text": "#之前我说过，那孩子十分佩服能掘出重宝的{NICKNAME}，希望能跟随你挖出世界上所有的宝箱。"
        },
        {
            "id": "766501209",
            "speaker": "菈乌玛",
            "text": "这一枚摩拉，是它专程送给你的「订金」。"
        },
        {
            "id": "766501210",
            "speaker": "Player",
            "text": "它、它是认真的？"
        },
        {
            "id": "766501211",
            "speaker": "菈乌玛",
            "text": "牵涉摩拉之事，盗宝鼬一族从不撒谎。"
        },
        {
            "id": "766501212",
            "speaker": "菈乌玛",
            "text": "拿好了，这可是你和盗宝鼬一族…至少是与这只盗宝鼬之间的「约定」。",
            "choices": [
                {
                    "id": "766501213",
                    "text": "找宝箱只是我的副业…",
                    "response": [
                        {
                            "id": "766501215",
                            "speaker": "菈乌玛",
                            "text": "无需太过担心。说是「约定」，其实只是那孩子想要与你交朋友。"
                        },
                        {
                            "id": "766501216",
                            "speaker": "菈乌玛",
                            "text": "它并不明白你喜欢什么，所以，就把自己最喜欢的东西送给了你。",
                            "choices": [
                                {
                                    "id": "766501217",
                                    "text": "……",
                                    "response": [
                                        {
                                            "id": "766501219",
                                            "speaker": "菈乌玛",
                                            "text": "嗯。若是有心，你回去后可以在枕头旁边放些白灵果干，那孩子最喜欢吃这种零食。"
                                        },
                                        {
                                            "id": "766501220",
                                            "speaker": "菈乌玛",
                                            "text": "当然也别放太多了。要是那孩子一不留神吃了太多，只怕就没法打洞离开了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "766501218",
                                    "text": "我会收藏好的。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "766501214",
                    "text": "我真不是做这一行的…"
                }
            ]
        }
    ]
}