    "dialogues": [
        {
            "id": "622000203",
            "speaker": "Player",
            "text": "关于生意…"
        },
        {
            "id": "622000204",
            "speaker": "仲林",
            "text": "我的生意？当然小买卖啦。在七星的手腕下面捡点漏下的生意。"
        },
        {
            "id": "622000205",
            "speaker": "仲林",
            "text": "不过游商嘛，奈何百货卖不赢大手，那当然就是奇货啦。"
        },
        {
            "id": "622000206",
            "speaker": "仲林",
            "text": "给你瞧瞧，须弥的蘑菇，没见过吧。"
        }
    ]
}