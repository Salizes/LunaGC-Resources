{
    "talkId": "6910703",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 7,
        "茜特菈莉": 19
    },
    "dialogues": [
        {
            "id": "691070301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691070302",
            "speaker": "茜特菈莉",
            "text": "好的呀。有什么想说的吗？"
        },
        {
            "id": "691070303",
            "speaker": "Player",
            "text": "为什么没有看到你的那些…"
        },
        {
            "id": "691070304",
            "speaker": "茜特菈莉",
            "text": "你是说「星魔」吗？确实，我也感到奇怪。"
        },
        {
            "id": "691070305",
            "speaker": "茜特菈莉",
            "text": "现在想想应该是你这片天地很不一般吧。它最大程度隔绝了外面的天地，所以来自星空的恶意被削弱了很多。"
        },
        {
            "id": "691070306",
            "speaker": "茜特菈莉",
            "text": "这才让「星魔」们看起来没有什么精神。",
            "choices": [
                {
                    "id": "691070307",
                    "text": "看起来有点可怜。",
                    "response": [
                        {
                            "id": "691070308",
                            "speaker": "茜特菈莉",
                            "text": "你真好心。"
                        },
                        {
                            "id": "691070309",
                            "speaker": "茜特菈莉",
                            "text": "确实它们诞生自世界对人的恶意。但是这部分邪恶的力量已经在做坏事之前被修正掉了。"
                        },
                        {
                            "id": "691070310",
                            "speaker": "茜特菈莉",
                            "text": "现在它们只是吉祥物罢了。"
                        },
                        {
                            "id": "691070314",
                            "speaker": "茜特菈莉",
                            "text": "话说回来，这片天地有如此遮蔽天机的「造化神工」，难道这里是洞天福地吗？"
                        },
                        {
                            "id": "691070315",
                            "speaker": "Player",
                            "text": "你是怎么知道的…"
                        },
                        {
                            "id": "691070316",
                            "speaker": "茜特菈莉",
                            "text": "从小说里看来的啊。"
                        },
                        {
                            "id": "691070317",
                            "speaker": "茜特菈莉",
                            "text": "《蜃楼战记》的超古代诸侯们上承三圣时代，许多古代科技和魔法并没有丢失，其中就有洞天技术。"
                        },
                        {
                            "id": "691070318",
                            "speaker": "茜特菈莉",
                            "text": "噢！原来小说里的是真的啊！"
                        },
                        {
                            "id": "691070319",
                            "speaker": "Player",
                            "text": "假的假的…"
                        },
                        {
                            "id": "691070320",
                            "speaker": "茜特菈莉",
                            "text": "那，那换个说法吧。果然好小说都是很考究的。"
                        },
                        {
                            "id": "691070321",
                            "speaker": "茜特菈莉",
                            "text": "你说有没有可能，写《蜃楼战记》的人就是你说的仙人呢？"
                        },
                        {
                            "id": "691070322",
                            "speaker": "茜特菈莉",
                            "text": "而猫头的「东之王公」和「西之王母」就是他们的自我投射？"
                        },
                        {
                            "id": "691070323",
                            "speaker": "Player",
                            "text": "你别说，你还真别说…"
                        },
                        {
                            "id": "691070324",
                            "speaker": "茜特菈莉",
                            "text": "你认识什么猫类的仙人吗？"
                        },
                        {
                            "id": "691070325",
                            "speaker": "茜特菈莉",
                            "text": "不、不对。我想了一下，作者或许不是仙人。"
                        },
                        {
                            "id": "691070326",
                            "speaker": "茜特菈莉",
                            "text": "《蜃楼战记》我一路看连载下来，已经换了两次作者了。如果是仙人应该会比我坚持更久吧…"
                        }
                    ]
                },
                {
                    "id": "691070311",
                    "text": "这样看起来比较安全。",
                    "response": [
                        {
                            "id": "691070312",
                            "speaker": "茜特菈莉",
                            "text": "唔，这么说也没错。它们是诞生自世界恶意的灵。"
                        },
                        {
                            "id": "691070313",
                            "speaker": "茜特菈莉",
                            "text": "不过它们在做坏事之前就被我阻止了。不会有危险的。"
                        }
                    ]
                }
            ]
        }
    ]
}