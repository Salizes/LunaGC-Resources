    "dialogues": [
        {
            "id": "5211401",
            "speaker": "留言",
            "text": "「为了应对今后可能激增的贸易需求，我提议大家定一个时间在『万国商会』交换消息，互通有无。」"
        },
        {
            "id": "5211402",
            "speaker": "留言",
            "text": "「避免内部的无谓竞争，才能将商机最大程度地转化成利润。」"
        },
        {
            "id": "5211403",
            "speaker": "另一人的留言",
            "text": "「我赞成，终于能大赚一笔了！」"
        }
    ]
