{
    "talkId": "6212002",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "富贵": 11
    },
    "dialogues": [
        {
            "id": "621200201",
            "speaker": "Player",
            "text": "看相？"
        },
        {
            "id": "621200202",
            "speaker": "富贵",
            "text": "不是我吹，只要我定睛一看，不但能看出你的吉凶祸福，还能一眼看出谁心里有鬼、谁是坏人！"
        },
        {
            "id": "621200203",
            "speaker": "富贵",
            "text": "最近我在帮路过的人免费看相，怎么样，有兴趣吗？"
        },
        {
            "id": "621200204",
            "speaker": "Player",
            "text": "能帮我看看吗？"
        },
        {
            "id": "621200205",
            "speaker": "富贵",
            "text": "行啊！让我看看…"
        },
        {
            "id": "621200206",
            "speaker": "富贵",
            "text": "天庭饱满、地阁方圆，五官端正，眉清目秀，气色红润…"
        },
        {
            "id": "621200207",
            "speaker": "富贵",
            "text": "嗯？你脸上…好像有点儿红。",
            "choices": [
                {
                    "id": "621200208",
                    "text": "精神焕发！",
                    "response": [
                        {
                            "id": "621200209",
                            "speaker": "富贵",
                            "text": "…答得底气十足、字正腔圆，不像是心里有鬼的样子，看样子是个好人…"
                        },
                        {
                            "id": "621200210",
                            "speaker": "富贵",
                            "text": "…嗯，我可以看得出你未来命中有一笔大财，只是按照你现在的趋势很可能会与其擦肩而过。"
                        },
                        {
                            "id": "621200211",
                            "speaker": "富贵",
                            "text": "所以，不要贪图享乐、好逸恶劳，好好努力，你在未来一定会有所收获，明白了吗。"
                        }
                    ]
                },
                {
                    "id": "621200212",
                    "text": "刚才战斗时候磕的…",
                    "response": [
                        {
                            "id": "621200213",
                            "speaker": "富贵",
                            "text": "…能磕的这么对称吗，不过你的面相，看着也不像是坏人…"
                        },
                        {
                            "id": "621200214",
                            "speaker": "富贵",
                            "text": "…嗯，我可以看得出你未来命中必有一劫，但是如果好好努力、脚踏实地，你就能逢凶化吉。"
                        },
                        {
                            "id": "621200215",
                            "speaker": "富贵",
                            "text": "所以，不要好高骛远、投机取巧，也许不是大富大贵的命，但一定会平安无事，明白了吗。"
                        }
                    ]
                }
            ]
        }
    ]
}