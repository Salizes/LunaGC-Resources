    "speaker_counts": {
        "Player": 1,
        "黄巨贾": 4
    },
    "dialogues": [
        {
            "id": "621250301",
            "speaker": "Player",
            "text": "闲着？"
        },
        {
            "id": "621250302",
            "speaker": "黄巨贾",
            "text": "嘿，说起这事我就来气！"
        },
        {
            "id": "621250303",
            "speaker": "黄巨贾",
            "text": "自从我得到仙人保佑之后，我在蒙德到璃月的路上做生意，那叫一个红火啊！"
        },
        {
            "id": "621250304",
            "speaker": "黄巨贾",
            "text": "后来也不知道是谁，估摸着是商会里的人眼红我的生意吧，居然让商会高层把我给派到轻策庄去了！"
        },
        {
            "id": "621250305",
            "speaker": "黄巨贾",
            "text": "…哼，我就是老死在这望舒客栈，也绝不会去轻策庄的！那种穷乡僻壤怎么能发挥我的才能和财气？"
        }
    ]
}