        {
            "id": "643410201",
            "speaker": "Player",
            "text": "你在等什么？"
        },
        {
            "id": "643410202",
            "speaker": "达纳",
            "text": "在等待一个决定我毕生命运的结果！"
        },
        {
            "id": "643410203",
            "speaker": "达纳",
            "text": "…就是我的毕业留校申请啦。"
        },
        {
            "id": "643410204",
            "speaker": "达纳",
            "text": "听说最近加入教令院的竞争越来越激烈了，每天都有人给齐米娅老师推荐简历，我还能有机会吗…"
        },
        {
            "id": "643410205",
            "speaker": "达纳",
            "text": "不行，要自信一点。从我毕业论文的研究成果上来看，还是很有优势的。"
        }
    ]
