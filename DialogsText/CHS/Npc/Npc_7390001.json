{
    "talkId": "7390001",
    "total_dialogue_lines": 6,
    "speaker_counts": {
        "Player": 1,
        "阿什帕齐": 5
    },
    "dialogues": [
        {
            "id": "739000101",
            "speaker": "Player",
            "text": "我不信。"
        },
        {
            "id": "739000102",
            "speaker": "阿什帕齐",
            "text": "嘿，怎么还跟我杠上了。"
        },
        {
            "id": "739000103",
            "speaker": "阿什帕齐",
            "text": "看你长得眉清目秀、通情达理的，不像是不讲道理的人啊。"
        },
        {
            "id": "739000104",
            "speaker": "阿什帕齐",
            "text": "哦，我明白了！你一定是想用激将法，骗我的肉吃！"
        },
        {
            "id": "739000105",
            "speaker": "阿什帕齐",
            "text": "不过没关系，在分享美食方面，我不介意上当。"
        },
        {
            "id": "739000106",
            "speaker": "阿什帕齐",
            "text": "只有一个要求，你吃完如果觉得好吃的话，得帮我宣传宣传啊。"
        }
    ]
}