    "dialogues": [
        {
            "id": "643000301",
            "speaker": "Player",
            "text": "你会做饭？"
        },
        {
            "id": "643000302",
            "speaker": "阿什帕齐",
            "text": "欸，这是问的什么话！"
        },
        {
            "id": "643000303",
            "speaker": "阿什帕齐",
            "text": "不要看我穿着巡林官的制服，就小瞧我的厨艺！我可是巡林队里大名鼎鼎的「大厨」！"
        },
        {
            "id": "643000304",
            "speaker": "阿什帕齐",
            "text": "…哈哈，不开玩笑了。"
        },
        {
            "id": "643000305",
            "speaker": "阿什帕齐",
            "text": "虽然没到「大名鼎鼎」的程度，但我的厨艺确实没的说，周围吃过的人都说好。"
        }
    ]
}