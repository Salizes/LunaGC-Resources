    "dialogues": [
        {
            "id": "691251001",
            "speaker": "哥伦比娅",
            "text": "你帮我把银月之庭搬过来了？"
        },
        {
            "id": "691251002",
            "speaker": "哥伦比娅",
            "text": "唔，不对。是像水中倒影一样的拟似景象吗？真神奇，想起了许多美好的回忆。"
        },
        {
            "id": "691251003",
            "speaker": "哥伦比娅",
            "text": "现在只缺我的歌声了。"
        }
    ]
