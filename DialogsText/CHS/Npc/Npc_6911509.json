{
    "talkId": "6911509",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "塔利雅": 15
    },
    "dialogues": [
        {
            "id": "691150401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691150402",
            "speaker": "塔利雅",
            "text": "不如跟我一起练习合唱吧。",
            "choices": [
                {
                    "id": "691150403",
                    "text": "这个我有信心！",
                    "response": [
                        {
                            "id": "691150404",
                            "speaker": "塔利雅",
                            "text": "合唱并不是为了展现个人的才华哦，唱诗班的大家都会尝试让自己融入和声，就像万物的声响都被融入风声那样。"
                        },
                        {
                            "id": "691150405",
                            "speaker": "塔利雅",
                            "text": "不过，自信确实很重要，有不少新加入唱诗班的人因为害羞开不了口呢。"
                        },
                        {
                            "id": "691150409",
                            "speaker": "塔利雅",
                            "text": "先来试试嗓音吧，啊…",
                            "choices": [
                                {
                                    "id": "691150410",
                                    "text": "真好听。",
                                    "response": [
                                        {
                                            "id": "691150412",
                                            "speaker": "塔利雅",
                                            "text": "我确实认真地考虑过这种可能，但最终还是放弃了。"
                                        },
                                        {
                                            "id": "691150413",
                                            "speaker": "Player",
                                            "text": "为什么？"
                                        },
                                        {
                                            "id": "691150414",
                                            "speaker": "塔利雅",
                                            "text": "作为偶像，需要足够的热情去面对大量的粉丝，芭芭拉心地善良…"
                                        },
                                        {
                                            "id": "691150415",
                                            "speaker": "塔利雅",
                                            "text": "但对我来说，有趣的灵魂寥寥无几，无趣的灵魂比比皆是。"
                                        },
                                        {
                                            "id": "691150416",
                                            "speaker": "塔利雅",
                                            "text": "对于自己不感兴趣的人，我恐怕只有力气维持基本的礼节。"
                                        },
                                        {
                                            "id": "691150417",
                                            "speaker": "塔利雅",
                                            "text": "所以我还是更想做一个旁观者，观察芭芭拉如何处理偶像身份带来的麻烦。"
                                        },
                                        {
                                            "id": "691150418",
                                            "speaker": "塔利雅",
                                            "text": "不瞒你说，这样的体验比亲自当偶像有趣多了。"
                                        },
                                        {
                                            "id": "691150419",
                                            "speaker": "塔利雅",
                                            "text": "对了，你想不想出道？骑士团还没出过偶像呢！荣誉骑士摇身一变，成为了骑士团的新锐偶像…这个设想很有意思！"
                                        },
                                        {
                                            "id": "691150420",
                                            "speaker": "塔利雅",
                                            "text": "正好，跟我练习美声吧，我保证能帮你出道！"
                                        },
                                        {
                                            "id": "691150421",
                                            "speaker": "Player",
                                            "text": "还是别了吧…"
                                        },
                                        {
                                            "id": "691150422",
                                            "speaker": "塔利雅",
                                            "text": "先试一试总可以嘛，来，跟我学，啊…"
                                        }
                                    ]
                                },
                                {
                                    "id": "691150411",
                                    "text": "考虑过像芭芭拉那样出道吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691150406",
                    "text": "五音不全怎么办？",
                    "response": [
                        {
                            "id": "691150407",
                            "speaker": "塔利雅",
                            "text": "哈哈，无妨无妨。"
                        },
                        {
                            "id": "691150408",
                            "speaker": "塔利雅",
                            "text": "唱诗班负责的颂歌当中并没有多少炫技的内容，只要感情足够真挚，绝大多数人都可以融入和声。"
                        }
                    ]
                }
            ]
        }
    ]
}