{
    "talkId": "4008147",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 12,
        "风速枣椰": 15
    },
    "dialogues": [
        {
            "id": "400814701",
            "speaker": "风速枣椰",
            "text": "怎么只给一次机会，太不公平了！",
            "choices": [
                {
                    "id": "400814702",
                    "text": "什么机会？",
                    "response": [
                        {
                            "id": "400814703",
                            "speaker": "风速枣椰",
                            "text": "比赛啊！为什么我只是输了第一场，就不让我继续参赛了！"
                        },
                        {
                            "id": "400814704",
                            "speaker": "风速枣椰",
                            "text": "我还想好好表现呢！大家还等着和我带回家的蕈兽一起玩呢！"
                        },
                        {
                            "id": "400814705",
                            "speaker": "派蒙",
                            "text": "原来你不知道吗…预赛都没通过的话，就没有机会了哦。"
                        },
                        {
                            "id": "400814706",
                            "speaker": "派蒙",
                            "text": "感觉你好像只凭一股热情就参加比赛了，完全没有好好读过比赛规则呢…"
                        },
                        {
                            "id": "400814707",
                            "speaker": "Player",
                            "text": "为你们感到遗憾。"
                        },
                        {
                            "id": "400814708",
                            "speaker": "派蒙",
                            "text": "不管怎么样，你已经尽力了啦，现在后悔也没什么用，还不如和蕈兽们开开心心地放松一下呢。"
                        },
                        {
                            "id": "400814709",
                            "speaker": "派蒙",
                            "text": "你不是还有一些小弟吗？你可以和让小弟们和你的蕈兽也交朋友，一起去野餐，去探险…"
                        },
                        {
                            "id": "400814710",
                            "speaker": "派蒙",
                            "text": "唔，探险还是算了，对你们来说不太安全。"
                        },
                        {
                            "id": "400814711",
                            "speaker": "风速枣椰",
                            "text": "对，对哦！还没来得及让小弟们认识一下我的蕈兽！"
                        },
                        {
                            "id": "400814712",
                            "speaker": "风速枣椰",
                            "text": "有两个胆大包天的小弟，居然还模仿参赛选手，偷偷去找什么「传说中最乖巧最听话的蕈兽」…还好没出什么事！"
                        },
                        {
                            "id": "400814713",
                            "speaker": "风速枣椰",
                            "text": "明明和我的蕈兽一起玩就行了啊！"
                        },
                        {
                            "id": "400814714",
                            "speaker": "Player",
                            "text": "这事怎么有点耳熟…"
                        },
                        {
                            "id": "400814715",
                            "speaker": "派蒙",
                            "text": "嘿嘿，这样才对嘛，你就不要有心理负担啦！"
                        }
                    ]
                },
                {
                    "id": "400814716",
                    "text": "小弟们不会责怪你的。",
                    "response": [
                        {
                            "id": "400814717",
                            "speaker": "风速枣椰",
                            "text": "可是…我明明是大姐头，是唯一拿到比赛资格的人，是全帮的希望啊！"
                        },
                        {
                            "id": "400814718",
                            "speaker": "风速枣椰",
                            "text": "大家以前都要绕着蕈兽走，明明觉得很多蕈兽很可爱，但却不敢接近它们，都指望着我训练几只蕈兽，作为我们的镇帮之宝…"
                        },
                        {
                            "id": "400814719",
                            "speaker": "风速枣椰",
                            "text": "结果我失败了，完全没希望了…"
                        },
                        {
                            "id": "400814720",
                            "speaker": "派蒙",
                            "text": "那你不是更应该抓紧时间，让小弟们和你的蕈兽多玩一会儿了吗？"
                        },
                        {
                            "id": "400814721",
                            "speaker": "派蒙",
                            "text": "虽然只有八强选手能把蕈兽一直留在身边，可现在比赛还没结束嘛，不会马上把你的宝珠和伙伴们收走的！"
                        },
                        {
                            "id": "400814722",
                            "speaker": "派蒙",
                            "text": "既然这一次输掉了，就吸取教训，下次比赛再兑现承诺嘛！"
                        },
                        {
                            "id": "400814723",
                            "speaker": "风速枣椰",
                            "text": "等等，你好像说得没错喔！"
                        },
                        {
                            "id": "400814724",
                            "speaker": "风速枣椰",
                            "text": "没想到你这个白色飞蘑菇还挺机灵！谢…"
                        },
                        {
                            "id": "400814725",
                            "speaker": "Player",
                            "text": "不用谢。"
                        },
                        {
                            "id": "400814726",
                            "speaker": "派蒙",
                            "text": "不用谢哦！"
                        },
                        {
                            "id": "400814727",
                            "speaker": "风速枣椰",
                            "text": "呃…果然还是说不出口！"
                        },
                        {
                            "id": "400814728",
                            "speaker": "风速枣椰",
                            "text": "你们两个，我就先放过你们一次！你们一定要拿到冠军啊！"
                        },
                        {
                            "id": "400814729",
                            "speaker": "风速枣椰",
                            "text": "这样一来，等到下次比赛，我一打败你们，就会成为最亮眼的选手！"
                        },
                        {
                            "id": "400814730",
                            "speaker": "派蒙",
                            "text": "这是什么话，又好笑又好气…"
                        },
                        {
                            "id": "400814731",
                            "speaker": "派蒙",
                            "text": "算了，我们大人有大量，就先答应你好了！下次一定要变强，然后和我们再较量一番哦！"
                        }
                    ]
                },
                {
                    "id": "400814732",
                    "text": "再见…",
                    "response": [
                        {
                            "id": "400814733",
                            "speaker": "风速枣椰",
                            "text": "唉，垂头丧气也不是个事，还是要打起精神去面对小弟们啊…再见吧！"
                        }
                    ]
                }
            ]
        }
    ]
}