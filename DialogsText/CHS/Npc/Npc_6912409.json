{
    "talkId": "6912409",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 4,
        "雅珂达": 6
    },
    "dialogues": [
        {
            "id": "691240401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691240402",
            "speaker": "雅珂达",
            "text": "我可以…摸摸那只叫做「阿圆」的团雀吗？她好大，也好可爱喔！"
        },
        {
            "id": "691240403",
            "speaker": "Player",
            "text": "那你可能要去问问阿圆…"
        },
        {
            "id": "691240404",
            "speaker": "雅珂达",
            "text": "阿圆能听懂我说话吗？哇…我还以为只有菈乌玛那样的人能听懂她说话呢。"
        },
        {
            "id": "691240405",
            "speaker": "雅珂达",
            "text": "那、那阿嘟呢！就是那个偶尔才过来这边的团雀，我是不是也可以直接和他说话？",
            "choices": [
                {
                    "id": "691240406",
                    "text": "是吧…",
                    "response": [
                        {
                            "id": "691240408",
                            "speaker": "雅珂达",
                            "text": "喔对，阿圆和阿嘟是壶灵，不是团雀…"
                        },
                        {
                            "id": "691240409",
                            "speaker": "雅珂达",
                            "text": "总之，我回去洗点水果，带去给阿圆吃。"
                        },
                        {
                            "id": "691240410",
                            "speaker": "雅珂达",
                            "text": "我还是第一次和壶灵说话呢，问点什么好呢…"
                        }
                    ]
                },
                {
                    "id": "691240407",
                    "text": "他们壶灵很厉害的。"
                }
            ]
        }
    ]
}