{
    "talkId": "6220402",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "言笑": 9
    },
    "dialogues": [
        {
            "id": "622040201",
            "speaker": "Player",
            "text": "请、请问您是？"
        },
        {
            "id": "622040202",
            "speaker": "言笑",
            "text": "我叫言笑。厨子。"
        },
        {
            "id": "622040203",
            "speaker": "言笑",
            "text": "没事就出去吧。"
        },
        {
            "id": "622040204",
            "speaker": "Player",
            "text": "只、只是厨子？"
        },
        {
            "id": "622040205",
            "speaker": "言笑",
            "text": "可不咋的。没看到我切肉炖汤吗？"
        },
        {
            "id": "622040206",
            "speaker": "言笑",
            "text": "不过的确很多人都说我不像是厨子。"
        },
        {
            "id": "622040207",
            "speaker": "言笑",
            "text": "是这样的。以前是道上的。不小心劫了老板。"
        },
        {
            "id": "622040208",
            "speaker": "言笑",
            "text": "然后被打了一顿，关了些时候。"
        },
        {
            "id": "622040209",
            "speaker": "言笑",
            "text": "放出来，老板说接我当厨子。"
        },
        {
            "id": "622040210",
            "speaker": "言笑",
            "text": "我发现当厨子是比当强盗开心。"
        },
        {
            "id": "622040211",
            "speaker": "言笑",
            "text": "这才是真正的我。"
        }
    ]
}