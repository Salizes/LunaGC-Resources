{
    "talkId": "6912608",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 10,
        "兹白": 19
    },
    "dialogues": [
        {
            "id": "691260301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691260302",
            "speaker": "兹白",
            "text": "好啊，你对数理感兴趣么？我之前长居月上时，经常用数理打发时间。"
        },
        {
            "id": "691260303",
            "speaker": "兹白",
            "text": "来到璃月后，我也没有放下算数本，偶尔也会和那位「留云借风真君」交流一下数理之学。"
        },
        {
            "id": "691260304",
            "speaker": "兹白",
            "text": "可是…我们二人对于数理的看法，似乎有些差异。"
        },
        {
            "id": "691260305",
            "speaker": "兹白",
            "text": "留云真君的数理研究大多是为了研究机关之学，她觉得，数理之学还需要落在实处，不能一直纸上谈兵。"
        },
        {
            "id": "691260306",
            "speaker": "兹白",
            "text": "而我认为，数理之学的奥妙就在于数理本身，要是研究数理仅是为了做出机巧器具，难免会破坏数理的美感。"
        },
        {
            "id": "691260307",
            "speaker": "Player",
            "text": "数、数理的美感…？"
        },
        {
            "id": "691260308",
            "speaker": "兹白",
            "text": "没错。比如…你有没有想过为何一只团雀和另一只团雀加起来，等于两只团雀？",
            "choices": [
                {
                    "id": "691260309",
                    "text": "啊…啊？当然是两只…",
                    "response": [
                        {
                            "id": "691260311",
                            "speaker": "兹白",
                            "text": "没错，这是自然之理，人人都知晓。"
                        },
                        {
                            "id": "691260312",
                            "speaker": "兹白",
                            "text": "那要是把我们所观察的这件事列成算式，也就是在草稿纸上写出「一加一等于二」后…"
                        },
                        {
                            "id": "691260313",
                            "speaker": "兹白",
                            "text": "你想过，为什么「一加一等于二」么？",
                            "choices": [
                                {
                                    "id": "691260314",
                                    "text": "啊…啊？当然也是二…",
                                    "response": [
                                        {
                                            "id": "691260316",
                                            "speaker": "兹白",
                                            "text": "依我来看，「一加一等于二」虽被公认，但还是缺乏更加…客观且严密的逻辑推理。"
                                        },
                                        {
                                            "id": "691260317",
                                            "speaker": "兹白",
                                            "text": "就这件事，我已经和留云真君讨论过几次了。"
                                        },
                                        {
                                            "id": "691260318",
                                            "speaker": "兹白",
                                            "text": "虽然她最开始觉得讨论这件事简直是「无稽之谈」，但听完我的叙述后，她也对这种理论性研究产生了兴趣。"
                                        },
                                        {
                                            "id": "691260319",
                                            "speaker": "兹白",
                                            "text": "我们两人谈论到了半夜，还意犹未尽，但因为我们各有要事处理，只能约定过些日子再来讨论。"
                                        },
                                        {
                                            "id": "691260320",
                                            "speaker": "Player",
                                            "text": "好像须弥教令院也在研究数理…"
                                        },
                                        {
                                            "id": "691260321",
                                            "speaker": "兹白",
                                            "text": "你是说那个名为「梨多梵谛」的学院么？呵呵，我之前云游时，也曾去那里拜访。"
                                        },
                                        {
                                            "id": "691260322",
                                            "speaker": "兹白",
                                            "text": "那里的数理研究似乎极为深入，我在里面读了几本书之后，实在获益匪浅。"
                                        },
                                        {
                                            "id": "691260323",
                                            "speaker": "兹白",
                                            "text": "所以，我也正准备考入教令院，在那里好好学习一番。",
                                            "choices": [
                                                {
                                                    "id": "691260324",
                                                    "text": "璃月的仙人…",
                                                    "response": [
                                                        {
                                                            "id": "691260326",
                                                            "speaker": "兹白",
                                                            "text": "这有何问题，路遇名师，自然应当求教。"
                                                        },
                                                        {
                                                            "id": "691260327",
                                                            "speaker": "兹白",
                                                            "text": "而且，我想教令院这类贤人聚集之所，应当也奉行着有教无类的原则，不会轻易拒绝求学之人入学吧。"
                                                        },
                                                        {
                                                            "id": "691260328",
                                                            "speaker": "Player",
                                                            "text": "应、应该吧…"
                                                        },
                                                        {
                                                            "id": "691260329",
                                                            "speaker": "兹白",
                                                            "text": "嗯…看来我这趟去须弥，能见着许多新鲜故事。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691260325",
                                                    "text": "去教令院上学…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691260315",
                                    "text": "不然还能是三吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691260310",
                    "text": "那、那还能等于多少只？"
                }
            ]
        }
    ]
}