{
    "talkId": "6904902",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "宵宫": 13
    },
    "dialogues": [
        {
            "id": "690490201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690490202",
            "speaker": "宵宫",
            "text": "太厉害了！谁能想到你有一个这么厉害的地方！"
        },
        {
            "id": "690490203",
            "speaker": "宵宫",
            "text": "这是璃月的仙家之物对吧？简直难以置信，你让我进到这个壶里来的时候，我以为你在开玩笑呢。"
        },
        {
            "id": "690490204",
            "speaker": "宵宫",
            "text": "我还在想要怎么接你的话，是吐槽，还是顺着你的话题继续说下去…",
            "choices": [
                {
                    "id": "690490205",
                    "text": "吐槽会怎么说？",
                    "response": [
                        {
                            "id": "690490206",
                            "speaker": "宵宫",
                            "text": "「进不去，怎么想都进不去嘛！」"
                        },
                        {
                            "id": "690490207",
                            "speaker": "宵宫",
                            "text": "哈哈，这个是派蒙告诉我的，她刚刚见到壶的时候就是这个反应。"
                        },
                        {
                            "id": "690490208",
                            "speaker": "宵宫",
                            "text": "她都进不去，那我就更不可能了嘛。"
                        },
                        {
                            "id": "690490212",
                            "speaker": "宵宫",
                            "text": "结果谁能想到，你推了推我，我就眼前一黑，转眼就到了这里。"
                        },
                        {
                            "id": "690490213",
                            "speaker": "宵宫",
                            "text": "视野开阔，空气新鲜，简直是绝美的宝地。"
                        },
                        {
                            "id": "690490214",
                            "speaker": "Player",
                            "text": "你喜欢就好。"
                        },
                        {
                            "id": "690490215",
                            "speaker": "宵宫",
                            "text": "当然喜欢啦，连一直住在这里的心都有了。"
                        },
                        {
                            "id": "690490216",
                            "speaker": "宵宫",
                            "text": "欸，要不然在这里开一间「长野原」的分店好了。"
                        },
                        {
                            "id": "690490217",
                            "speaker": "宵宫",
                            "text": "叫上我们的伙伴都来看烟花吧，就当是我送你的祝贺礼！"
                        }
                    ]
                },
                {
                    "id": "690490209",
                    "text": "顺着说会怎么说？",
                    "response": [
                        {
                            "id": "690490210",
                            "speaker": "宵宫",
                            "text": "「那我就派出我家鱼缸里的大将，『金鱼太郎』陪你进去吧！」"
                        },
                        {
                            "id": "690490211",
                            "speaker": "宵宫",
                            "text": "它的话肯定没问题，毕竟是金鱼嘛。"
                        }
                    ]
                }
            ]
        }
    ]
}