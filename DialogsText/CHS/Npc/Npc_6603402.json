    "dialogues": [
        {
            "id": "660340201",
            "speaker": "Player",
            "text": "我也喜欢烤鱼。"
        },
        {
            "id": "660340202",
            "speaker": "莎娜",
            "text": "哦吼…撕开焦脆的鱼皮，里面闪亮的鱼肉就像新造好的比赛设备…"
        },
        {
            "id": "660340203",
            "speaker": "莎娜",
            "text": "而我这个工程师，就是第一个体验它们的人！"
        },
        {
            "id": "660340204",
            "speaker": "莎娜",
            "text": "…当然，试用设备是为了安全检测，和烤鱼是不一样的。"
        }
    ]
}