{
    "talkId": "1504550",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "玛薇卡": 9
    },
    "dialogues": [
        {
            "id": "150455001",
            "speaker": "玛薇卡",
            "text": "#{NICKNAME}，来喝一杯吗？",
            "choices": [
                {
                    "id": "150455002",
                    "text": "没想到大家都来了…",
                    "response": [
                        {
                            "id": "150455003",
                            "speaker": "玛薇卡",
                            "text": "哈哈，是不是声势太大？但事先告知你的话，就不能算作「惊喜」了。"
                        },
                        {
                            "id": "150455004",
                            "speaker": "玛薇卡",
                            "text": "看拍照时的表情，大家都对度假时光充满了期待啊。"
                        }
                    ]
                },
                {
                    "id": "150455005",
                    "text": "接下去有什么打算？",
                    "response": [
                        {
                            "id": "150455006",
                            "speaker": "玛薇卡",
                            "text": "尽管时间不会很长，但趁这个难得的机会，我也想放松一下。"
                        },
                        {
                            "id": "150455007",
                            "speaker": "玛薇卡",
                            "text": "那么…度假村里难度最高的项目是什么？你有推荐吗？"
                        }
                    ]
                },
                {
                    "id": "150455008",
                    "text": "关于风…",
                    "response": [
                        {
                            "id": "150455009",
                            "speaker": "玛薇卡",
                            "text": "噢，是天气的话题？"
                        },
                        {
                            "id": "150455010",
                            "speaker": "玛薇卡",
                            "text": "度假村里最近吹着一阵既凉爽又舒适的风…很是难得。"
                        },
                        {
                            "id": "150455011",
                            "speaker": "玛薇卡",
                            "text": "如果这阵风能够在纳塔多停留几日，就再好不过了。"
                        }
                    ]
                },
                {
                    "id": "150455012",
                    "text": "祝玛薇卡也享受假期。",
                    "response": [
                        {
                            "id": "150455013",
                            "speaker": "玛薇卡",
                            "text": "谢谢你的祝福，也祝你和朋友们玩得畅怀。"
                        }
                    ]
                }
            ]
        }
    ]
}