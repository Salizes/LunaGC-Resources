{
    "talkId": "6912403",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 8,
        "雅珂达": 20
    },
    "dialogues": [
        {
            "id": "691240301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691240302",
            "speaker": "雅珂达",
            "text": "行啊，你想听什么？或者说，你想要我教你什么？"
        },
        {
            "id": "691240303",
            "speaker": "雅珂达",
            "text": "无论是开锁、潜泳、布置陷阱，调配泻药，甚至是…出老千，我都能教你，你就只管说吧。",
            "choices": [
                {
                    "id": "691240304",
                    "text": "你都是从哪学来的这些？",
                    "response": [
                        {
                            "id": "691240306",
                            "speaker": "雅珂达",
                            "text": "这就和老板无关了，俗话说「尺有所短，寸有所长」嘛，这些小把戏是我的个人特长。"
                        },
                        {
                            "id": "691240307",
                            "speaker": "雅珂达",
                            "text": "虽然奈姐在大事上确实手眼通天、实力超群、英明神武、深藏不露…"
                        },
                        {
                            "id": "691240308",
                            "speaker": "雅珂达",
                            "text": "但她处理完大事后，留下来的那些小事，我也得好好处理才行。"
                        },
                        {
                            "id": "691240309",
                            "speaker": "雅珂达",
                            "text": "嘿嘿，毕竟每一个厉害老板的背后，都要有一个可靠员工嘛。"
                        },
                        {
                            "id": "691240310",
                            "speaker": "雅珂达",
                            "text": "要是没点特长，还怎么做「秘闻馆」的员工，就连阿舍鲁都会向客人招手，示意他们进来坐呢。"
                        },
                        {
                            "id": "691240311",
                            "speaker": "雅珂达",
                            "text": "不过，这么大一个「秘闻馆」，居然只有我一个员工，也不知道奈姐怎么想的。"
                        },
                        {
                            "id": "691240312",
                            "speaker": "雅珂达",
                            "text": "我最开始来的时候，还以为「秘闻馆」只是看起来没什么人手。"
                        },
                        {
                            "id": "691240313",
                            "speaker": "雅珂达",
                            "text": "实际上，「秘闻馆」里真正厉害的角色都潜伏在黑暗里。"
                        },
                        {
                            "id": "691240314",
                            "speaker": "雅珂达",
                            "text": "只要奈姐打个响指，他们就会唰地一下出现，然后…",
                            "choices": [
                                {
                                    "id": "691240315",
                                    "text": "还人人都有帅气称号？",
                                    "response": [
                                        {
                                            "id": "691240317",
                                            "speaker": "雅珂达",
                                            "text": "对对对，你也看过那本轻小说啊！"
                                        },
                                        {
                                            "id": "691240318",
                                            "speaker": "雅珂达",
                                            "text": "可惜，现实里的「秘闻馆」没有这种情节，事实上，确实就只有我一个员工。"
                                        },
                                        {
                                            "id": "691240319",
                                            "speaker": "雅珂达",
                                            "text": "唉，老板啊老板，你就不能多招点人吗？天天就让我一个人出去跑腿，遇见事情太多的时候，你还要自己出面…"
                                        },
                                        {
                                            "id": "691240320",
                                            "speaker": "雅珂达",
                                            "text": "你或许真的不累，但我真的很累…"
                                        },
                                        {
                                            "id": "691240321",
                                            "speaker": "雅珂达",
                                            "text": "#{NICKNAME}，你有兴趣来「秘闻馆」工作吗？你这么厉害，奈姐肯定会…"
                                        },
                                        {
                                            "id": "691240322",
                                            "speaker": "雅珂达",
                                            "text": "喔…不对…"
                                        },
                                        {
                                            "id": "691240323",
                                            "speaker": "Player",
                                            "text": "哪里不对？"
                                        },
                                        {
                                            "id": "691240324",
                                            "speaker": "雅珂达",
                                            "text": "按奈姐的风格，肯定会回答我："
                                        },
                                        {
                                            "id": "691240325",
                                            "speaker": "雅珂达",
                                            "text": "#「与{NICKNAME}结识这么久，{M#他}{F#她}早就是我们『秘闻馆』的合作伙伴了，又何必再邀请一次呢？」",
                                            "choices": [
                                                {
                                                    "id": "691240326",
                                                    "text": "你已经很懂奈芙尔了。",
                                                    "response": [
                                                        {
                                                            "id": "691240328",
                                                            "speaker": "雅珂达",
                                                            "text": "总是待在奈姐身边，我听也听会了。但是老板啊——你就再招个人吧，拜托嘛——"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691240327",
                                                    "text": "很有奈芙尔的风格了。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691240316",
                                    "text": "还有战力排行？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691240305",
                    "text": "难道是奈芙尔教的？"
                }
            ]
        }
    ]
}