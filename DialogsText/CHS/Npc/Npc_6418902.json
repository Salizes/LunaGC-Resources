    "dialogues": [
        {
            "id": "641890201",
            "speaker": "Player",
            "text": "你打算做什么？"
        },
        {
            "id": "641890202",
            "speaker": "兰那库拉",
            "text": "#啊，是金色的那菈{NICKNAME}…"
        },
        {
            "id": "641890203",
            "speaker": "兰那库拉",
            "text": "#兰那库拉在准备为那菈{NICKNAME}留下「石头的记忆」。"
        },
        {
            "id": "641890204",
            "speaker": "兰那库拉",
            "text": "#这样一来，即便那菈{NICKNAME}离开了，再回来的时候，也能重新想起大树的叶子、林间的风还有兰那库拉。"
        },
        {
            "id": "641890205",
            "speaker": "兰那库拉",
            "text": "要是那菈法留纳回来了，也会知道，还有另外一个，被桓那记住的金色那菈。"
        }
    ]
}