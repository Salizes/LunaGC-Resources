{
    "talkId": "38305",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "温迪": 10
    },
    "dialogues": [
        {
            "id": "3830501",
            "speaker": "温迪",
            "text": "#辛苦你了，{NICKNAME}。接下来就看我的吧！",
            "choices": [
                {
                    "id": "3830502",
                    "text": "关于特瓦林。",
                    "response": [
                        {
                            "id": "3830503",
                            "speaker": "温迪",
                            "text": "曾经的特瓦林是我的朋友…现在也还是，我确信。"
                        },
                        {
                            "id": "3830504",
                            "speaker": "温迪",
                            "text": "他曾经与我一同聆听风的歌唱，一同弹奏蒲公英的诗篇…"
                        },
                        {
                            "id": "3830505",
                            "speaker": "温迪",
                            "text": "仅仅出于这样的原因，我也要唤回他曾经的温柔。"
                        },
                        {
                            "id": "3830506",
                            "speaker": "温迪",
                            "text": "嗯？当然，你也已经是我的朋友啦。"
                        }
                    ]
                },
                {
                    "id": "3830507",
                    "text": "关于酒。",
                    "response": [
                        {
                            "id": "3830508",
                            "speaker": "温迪",
                            "text": "蒙德最宝贵的自由，就是饮酒的自由了吧？"
                        },
                        {
                            "id": "3830509",
                            "speaker": "温迪",
                            "text": "而酒中最佳，当属蒲公英酒了。"
                        },
                        {
                            "id": "3830510",
                            "speaker": "温迪",
                            "text": "其实啊，即使手中没有酒杯，单是风中蒲公英的味道就足够让我沉醉了。"
                        },
                        {
                            "id": "3830511",
                            "speaker": "温迪",
                            "text": "哦，我差点忘了。以你现在的年纪，还不能喝酒。真不自由啊，嘿嘿。"
                        }
                    ]
                },
                {
                    "id": "3830512",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "3830513",
                            "speaker": "温迪",
                            "text": "嗯，我也要为了见「老朋友」而好好准备一下了。"
                        }
                    ]
                }
            ]
        }
    ]
}