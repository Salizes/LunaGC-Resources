{
    "talkId": "6902107",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "安柏": 11
    },
    "dialogues": [
        {
            "id": "690210701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690210301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690210302",
            "speaker": "安柏",
            "text": "好呀。"
        },
        {
            "id": "690210303",
            "speaker": "安柏",
            "text": "……"
        },
        {
            "id": "690210304",
            "speaker": "安柏",
            "text": "抱歉，我不是很擅长讲故事。不像爷爷或者丽莎，脑袋一转就能讲出非常引人入胜的故事。",
            "choices": [
                {
                    "id": "690210305",
                    "text": "我记得安柏有本笔记…",
                    "response": [
                        {
                            "id": "690210306",
                            "speaker": "安柏",
                            "text": "欸！你是什么时候发现的！"
                        },
                        {
                            "id": "690210307",
                            "speaker": "安柏",
                            "text": "虽然原本不是什么秘密，但里面记录了不少夸你的话…"
                        },
                        {
                            "id": "690210308",
                            "speaker": "安柏",
                            "text": "真要拿给你看还是会不好意思的啦！"
                        },
                        {
                            "id": "690210309",
                            "speaker": "安柏",
                            "text": "但，我可以摘一点有关冒险的故事和你分享。"
                        },
                        {
                            "id": "690210315",
                            "speaker": "安柏",
                            "text": "好！嘿嘿，那我开始了…"
                        }
                    ]
                },
                {
                    "id": "690210310",
                    "text": "我想听听安柏的过往。",
                    "response": [
                        {
                            "id": "690210311",
                            "speaker": "安柏",
                            "text": "过去的事啊…"
                        },
                        {
                            "id": "690210312",
                            "speaker": "安柏",
                            "text": "可能不是那么有趣。而且，以我现在的眼光来看，小时候的自己…还是太调皮了一点。"
                        },
                        {
                            "id": "690210313",
                            "speaker": "安柏",
                            "text": "不过只要你不取笑我的话，我还是愿意讲给你听的！"
                        },
                        {
                            "id": "690210314",
                            "speaker": "Player",
                            "text": "那就拜托喽？"
                        }
                    ]
                }
            ]
        }
    ]
}