{
    "talkId": "4003501",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "朋义": 6
    },
    "dialogues": [
        {
            "id": "400350101",
            "speaker": "朋义",
            "text": "是您啊，您好！之前的事多亏您帮忙了。"
        },
        {
            "id": "400350102",
            "speaker": "朋义",
            "text": "您今天过来，是想自己亲手做一做烟花吗？",
            "choices": [
                {
                    "id": "400350103",
                    "text": "能做出什么样的烟花？",
                    "response": [
                        {
                            "id": "400350104",
                            "speaker": "朋义",
                            "text": "那样式可多了！说一天也说不完。不过，我已经把一些基本烟花样式的做法写下来了。"
                        },
                        {
                            "id": "400350105",
                            "speaker": "朋义",
                            "text": "您就先试试制作烟花吧。"
                        },
                        {
                            "id": "400350106",
                            "speaker": "朋义",
                            "text": "我相信以您的巧手，一定能做出漂亮的烟花。"
                        }
                    ]
                },
                {
                    "id": "400350109",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "400350110",
                            "speaker": "朋义",
                            "text": "您还有其他事要忙吗？那等您有空了，一定要来做一做烟花啊。"
                        }
                    ]
                }
            ]
        }
    ]
}