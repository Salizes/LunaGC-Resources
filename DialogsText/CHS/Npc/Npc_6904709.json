{
    "talkId": "6904709",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "枫原万叶": 9
    },
    "dialogues": [
        {
            "id": "690470901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690470202",
            "speaker": "枫原万叶",
            "text": "嗯。能有一个让我暂时安身的地方，我很开心。"
        },
        {
            "id": "690470203",
            "speaker": "枫原万叶",
            "text": "我时常会独自欣赏窗外的景致。"
        },
        {
            "id": "690470204",
            "speaker": "枫原万叶",
            "text": "四下无人，内心也会自然而然地平静下来。"
        },
        {
            "id": "690470205",
            "speaker": "枫原万叶",
            "text": "明日之事不可知，但至少现在我拥有此刻的安稳。"
        },
        {
            "id": "690470206",
            "speaker": "枫原万叶",
            "text": "只可惜我不能久居于此，不然我的刀就变钝了。",
            "choices": [
                {
                    "id": "690470207",
                    "text": "可以偶尔来休息一下。",
                    "response": [
                        {
                            "id": "690470209",
                            "speaker": "枫原万叶",
                            "text": "那真是太感谢了。"
                        },
                        {
                            "id": "690470210",
                            "speaker": "枫原万叶",
                            "text": "一年之中，总有酷暑与严冬。最热或最冷的那几天，对我来说也很难熬。"
                        },
                        {
                            "id": "690470211",
                            "speaker": "枫原万叶",
                            "text": "这里的气候总是很舒适…"
                        },
                        {
                            "id": "690470212",
                            "speaker": "枫原万叶",
                            "text": "能在这里悠闲地打发掉那段时光，真是一件幸福的事。"
                        }
                    ]
                },
                {
                    "id": "690470208",
                    "text": "这里随时欢迎你来。"
                }
            ]
        }
    ]
}