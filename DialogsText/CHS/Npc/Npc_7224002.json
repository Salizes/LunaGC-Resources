{
    "talkId": "7224002",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "伊达": 6,
        "派蒙": 3
    },
    "dialogues": [
        {
            "id": "722400201",
            "speaker": "伊达",
            "text": "那边的迷宫也通关了吗？不错不错。你们赢得了我的认可。"
        },
        {
            "id": "722400202",
            "speaker": "派蒙",
            "text": "哦，哦…"
        },
        {
            "id": "722400203",
            "speaker": "伊达",
            "text": "有什么评价吗？"
        },
        {
            "id": "722400204",
            "speaker": "派蒙",
            "text": "评价？这个嘛…"
        },
        {
            "id": "722400205",
            "speaker": "伊达",
            "text": "嗯嗯，是不是觉得非常精妙非常厉害？"
        },
        {
            "id": "722400206",
            "speaker": "派蒙",
            "text": "欸…欸嘿！"
        },
        {
            "id": "722400207",
            "speaker": "伊达",
            "text": "「欸嘿」是什么意思啊！"
        },
        {
            "id": "722400208",
            "speaker": "伊达",
            "text": "咳咳。既然你们已经收集了两枚认可状，密室的通道应该就打开了。"
        },
        {
            "id": "722400209",
            "speaker": "伊达",
            "text": "把认可状放进去就可以打开宝库门了。"
        }
    ]
}