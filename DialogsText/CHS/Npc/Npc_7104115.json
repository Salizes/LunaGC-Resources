    "dialogues": [
        {
            "id": "710411501",
            "speaker": "塔列辛",
            "text": "#我们又重逢了！「金发的{NICKNAME}！」",
            "choices": [
                {
                    "id": "710411502",
                    "text": "塔列辛，你是要与我决斗吗？",
                    "response": [
                        {
                            "id": "710411503",
                            "speaker": "派蒙",
                            "text": "你突然在犯什么病呀！"
                        },
                        {
                            "id": "710411505",
                            "speaker": "塔列辛",
                            "text": "哈哈，我是来寻求灵感的！咳咳，你看…失去了过去、从未有族名的英雄！和忠诚的精灵侍从！"
                        },
                        {
                            "id": "710411506",
                            "speaker": "派蒙",
                            "text": "谁呀…？"
                        },
                        {
                            "id": "710411507",
                            "speaker": "Player",
                            "text": "谁啊…？"
                        },
                        {
                            "id": "710411508",
                            "speaker": "塔列辛",
                            "text": "哦，看呐，看呐，谦逊的英雄，不要向遥远的山边投去迷惘的目光，在这黑暗的地下，你自盛放灼目的光芒！"
                        },
                        {
                            "id": "710411509",
                            "speaker": "派蒙",
                            "text": "啊…？"
                        },
                        {
                            "id": "710411510",
                            "speaker": "Player",
                            "text": "啥…？"
                        },
                        {
                            "id": "710411511",
                            "speaker": "塔列辛",
                            "text": "就是你呀，我现成的写作模板。"
                        },
                        {
                            "id": "710411512",
                            "speaker": "Player",
                            "text": "哦…"
                        },
                        {
                            "id": "710411513",
                            "speaker": "派蒙",
                            "text": "什么嘛…原来这家伙是会说人话的呀。"
                        },
                        {
                            "id": "710411514",
                            "speaker": "Player",
                            "text": "再见。"
                        },
                        {
                            "id": "710411515",
                            "speaker": "塔列辛",
                            "text": "#再会了，「金发的{NICKNAME}！」"
                        }
                    ]
                },
                {
                    "id": "710411504",
                    "text": "你在这里做什么？"
                }
            ]
        }
    ]
