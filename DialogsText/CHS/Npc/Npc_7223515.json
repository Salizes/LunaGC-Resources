        {
            "id": "722351501",
            "speaker": "Player",
            "text": "关于《光昼影底集》"
        },
        {
            "id": "722351502",
            "speaker": "绘真",
            "text": "这只是一本猜谜书。巫女们说是适合九岁到十二岁的儿童阅读，但是我觉得好像只适合八岁以下的小孩子。"
        },
        {
            "id": "722351503",
            "speaker": "绘真",
            "text": "出借人也只是个普通市民。回收这本书需要缘分呢。"
        }
    ]
