    "dialogues": [
        {
            "id": "4015143303",
            "speaker": "霍夫曼",
            "text": "关于蒙德城。"
        },
        {
            "id": "4015143309",
            "speaker": "霍夫曼",
            "text": "是一座被神和民众们所热爱的城市，也是我们西风骑士团建立的意义所在…"
        },
        {
            "id": "4015143310",
            "speaker": "霍夫曼",
            "text": "呃，就是这些。我们的信念就是这么简短，简短所以有力，您说对吗？"
        }
    ]
}