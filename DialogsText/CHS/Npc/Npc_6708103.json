    "dialogues": [
        {
            "id": "670810301",
            "speaker": "Player",
            "text": "这样也挺不错的。"
        },
        {
            "id": "670810302",
            "speaker": "维贾米",
            "text": "是啊，人总想得到更多，但人的能力是有限的。而大多数人的欲望总是会膨胀得远超其能力所能拥有…"
        },
        {
            "id": "670810303",
            "speaker": "维贾米",
            "text": "这就是野心和欲望的可怕之处。"
        },
        {
            "id": "670810304",
            "speaker": "维贾米",
            "text": "想想吧，如果你在攀登一座没有顶峰的山，那无论如何…你要么死在山上，要么你终究会从高处跌落。"
        },
        {
            "id": "670810305",
            "speaker": "维贾米",
            "text": "知足才能常乐，孩子。"
        }
    ]
}