{
    "talkId": "6622005",
    "total_dialogue_lines": 5,
    "speaker_counts": {
        "Player": 1,
        "阿马佐利": 4
    },
    "dialogues": [
        {
            "id": "662200501",
            "speaker": "Player",
            "text": "名字的意义很重要。"
        },
        {
            "id": "662200502",
            "speaker": "阿马佐利",
            "text": "对对，是这样的。"
        },
        {
            "id": "662200503",
            "speaker": "阿马佐利",
            "text": "暝视龙大长老的全名意为「拥有烟雾色利爪的他」，我的名字「阿马佐利」意为「古老的书籍」。"
        },
        {
            "id": "662200504",
            "speaker": "阿马佐利",
            "text": "所以你看，我现在就在这里，开着一家书店。"
        },
        {
            "id": "662200505",
            "speaker": "阿马佐利",
            "text": "就像萨满们从梦中窥探命运的一角，一切都有迹可循。"
        }
    ]
}