{
    "talkId": "7665037",
    "total_dialogue_lines": 42,
    "speaker_counts": {
        "Player": 14,
        "安洛丝": 28
    },
    "dialogues": [
        {
            "id": "766503701",
            "speaker": "安洛丝",
            "text": "这本书应该在哪来着…"
        },
        {
            "id": "766503702",
            "speaker": "安洛丝",
            "text": "#{NICKNAME}？欢迎，菈乌玛大人向我提起过您。"
        },
        {
            "id": "766503703",
            "speaker": "安洛丝",
            "text": "如果现在想找菈乌玛大人的话，她刚出去处理事务了，请您稍等吧。"
        },
        {
            "id": "766503704",
            "speaker": "Player",
            "text": "你是在整理书籍？"
        },
        {
            "id": "766503705",
            "speaker": "安洛丝",
            "text": "是的。自从建立了这座书库，菈乌玛大人就拜托我们将「霜月之子」的书籍尽可能地搬过来。"
        },
        {
            "id": "766503706",
            "speaker": "安洛丝",
            "text": "然后…还请我们做了一些动物用的软垫和架子…"
        },
        {
            "id": "766503707",
            "speaker": "安洛丝",
            "text": "她说，是为了让动物们来这里造访的时候，也有地方可以休息。"
        },
        {
            "id": "766503708",
            "speaker": "安洛丝",
            "text": "我是不懂啦，但既然是菈乌玛大人的指示，那她也一定有自己的考量。"
        },
        {
            "id": "766503709",
            "speaker": "安洛丝",
            "text": "好嘞，这本厚得和砖头似的书，就放在最下面，要是有人想要拿它垫脚或者当凳子，只要抽出来就行。",
            "choices": [
                {
                    "id": "766503710",
                    "text": "这是记录什么的？",
                    "response": [
                        {
                            "id": "766503712",
                            "speaker": "安洛丝",
                            "text": "没事啦，这本书是一本记录各代「咏月使」言行的流水账，而且还是抄本…"
                        },
                        {
                            "id": "766503713",
                            "speaker": "安洛丝",
                            "text": "唉，虽然我是执祭，不该说这种话…但这本书应该是整个书库里最最无聊的书了。"
                        },
                        {
                            "id": "766503714",
                            "speaker": "安洛丝",
                            "text": "全书里写的，都是某年某月某日，某位「咏月使」说了什么，做了什么，然后有了怎么样的后果…"
                        },
                        {
                            "id": "766503715",
                            "speaker": "安洛丝",
                            "text": "我之前每次失眠的时候，就会拿起来翻一翻，没翻两页就倒在枕头上睡过去了。",
                            "choices": [
                                {
                                    "id": "766503716",
                                    "text": "就没点有趣的故事？",
                                    "response": [
                                        {
                                            "id": "766503718",
                                            "speaker": "安洛丝",
                                            "text": "趣闻呀…也有啊，虽然书里没记载，但我可是打听到不少。哼哼，我这个执祭可不是白做的。",
                                            "choices": [
                                                {
                                                    "id": "766503719",
                                                    "text": "我说，执祭的本职是这个吗？",
                                                    "response": [
                                                        {
                                                            "id": "766503721",
                                                            "speaker": "安洛丝",
                                                            "text": "当然是从其他的执祭那里呀，她们知道的故事可多了。"
                                                        },
                                                        {
                                                            "id": "766503722",
                                                            "speaker": "安洛丝",
                                                            "text": "比如，一位前代的「咏月使」有一个怪癖，那就是无论春夏秋冬，只要是需要主持祭祀，她都会去旁边的湖里泡上两个小时。"
                                                        },
                                                        {
                                                            "id": "766503723",
                                                            "speaker": "安洛丝",
                                                            "text": "她说，湖面倒映着月亮，她泡在湖里能够很好地感受月光和月神的赐福，这么做有助于祭祀顺利进行。"
                                                        },
                                                        {
                                                            "id": "766503724",
                                                            "speaker": "安洛丝",
                                                            "text": "在某段祭祀频繁的日子里，她几乎每天都要泡在湖里很久…",
                                                            "choices": [
                                                                {
                                                                    "id": "766503725",
                                                                    "text": "想必祭祀一定很顺利吧…",
                                                                    "response": [
                                                                        {
                                                                            "id": "766503726",
                                                                            "speaker": "安洛丝",
                                                                            "text": "顺利倒是顺利，那位「咏月使」也是一个能力很强的人。但是…"
                                                                        },
                                                                        {
                                                                            "id": "766503729",
                                                                            "speaker": "安洛丝",
                                                                            "text": "因为长时间受寒，那位超级虔诚的「咏月使」得了很严重的关节炎，不得不提前卸任「咏月使」了…"
                                                                        },
                                                                        {
                                                                            "id": "766503730",
                                                                            "speaker": "安洛丝",
                                                                            "text": "但就算是卸任了「咏月使」，她也一直说，关节部分的疼痛是月神的注视…",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "766503731",
                                                                                    "text": "月神应该不管关节炎吧…",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "766503733",
                                                                                            "speaker": "安洛丝",
                                                                                            "text": "因为…每次下雨的时候，月亮都会因为被云遮住而消失，她认为，膝关节的疼痛是月神在向她告别。"
                                                                                        },
                                                                                        {
                                                                                            "id": "766503734",
                                                                                            "speaker": "Player",
                                                                                            "text": "那要是看得见月亮呢？"
                                                                                        },
                                                                                        {
                                                                                            "id": "766503735",
                                                                                            "speaker": "安洛丝",
                                                                                            "text": "那就是月神在召唤。她就会披着衣服冲进雨里开始祈祷…"
                                                                                        },
                                                                                        {
                                                                                            "id": "766503736",
                                                                                            "speaker": "安洛丝",
                                                                                            "text": "后来为了她的健康，我们不得不找了一个侍祭每天看着这位老婆婆，别让她再折腾身体了。"
                                                                                        },
                                                                                        {
                                                                                            "id": "766503737",
                                                                                            "speaker": "安洛丝",
                                                                                            "text": "而那位幸运的执祭…啊，不对，应该是侍祭，就是我了。",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "766503738",
                                                                                                    "text": "怪不得你知道这么多故事。",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "766503740",
                                                                                                            "speaker": "安洛丝",
                                                                                                            "text": "嘿嘿，那是当然了，照顾婆婆的时候，我可不止是听故事，还学了好多东西呢。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "766503741",
                                                                                                            "speaker": "安洛丝",
                                                                                                            "text": "要是以后有机会，我就把它们都记下来，集结成书，书名就叫…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "766503742",
                                                                                                            "speaker": "安洛丝",
                                                                                                            "text": "哎呀！不好不好，光顾着聊天了，我还要继续收拾书库呢。不过…唔，那本书到底叫什么好呢…"
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "766503739",
                                                                                                    "text": "侍祭确实没白当啊。"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "766503732",
                                                                                    "text": "这两者有什么关系吗？"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "766503727",
                                                                    "text": "她的身体真的没问题吗？",
                                                                    "response": [
                                                                        {
                                                                            "id": "766503728",
                                                                            "speaker": "安洛丝",
                                                                            "text": "哈哈…虽然在她的主持下，祭祀都顺利举行了。但是…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "766503720",
                                                    "text": "你都是从哪里打听的…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "766503717",
                                    "text": "我还以为能看见趣闻呢…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "766503711",
                    "text": "这是不是有点随便…"
                }
            ]
        }
    ]
}