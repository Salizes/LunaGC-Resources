    "dialogues": [
        {
            "id": "751070601",
            "speaker": "阅读",
            "text": "「偶然路过此地，或是在本区域长期活动的朋友们，请你们留个心眼。」"
        },
        {
            "id": "751070602",
            "speaker": "阅读",
            "text": "「本区域曾活动着一支狡诈的犯罪团伙，他们会用不留痕迹的武器打伤人们的龙伙伴，并将其抓捕，贩卖，以此牟利！」",
            "choices": [
                {
                    "id": "751070603",
                    "text": "阅读",
                    "response": [
                        {
                            "id": "751070605",
                            "speaker": "阅读",
                            "text": "#「好在，无比勇敢，足智多谋的{NICKNAME}、{M#他}{F#她}的伙伴派蒙和{REALNAME[ID(2)|SHOWHOST(true)]}及时出手…」"
                        },
                        {
                            "id": "751070606",
                            "speaker": "阅读",
                            "text": "「他们沉重打击了这个犯罪团伙，解救了许多被抓的动物！」",
                            "choices": [
                                {
                                    "id": "751070607",
                                    "text": "阅读",
                                    "response": [
                                        {
                                            "id": "751070609",
                                            "speaker": "阅读",
                                            "text": "「不过，谁也不知道这些坏家伙还有没有同党，什么时候会卷土重来…」"
                                        },
                                        {
                                            "id": "751070610",
                                            "speaker": "阅读",
                                            "text": "「不久后，各部族会轮流派出巡逻队，保障这一区域的安全，持续追查那支犯罪团伙的线索，争取将其彻底剿灭。」",
                                            "choices": [
                                                {
                                                    "id": "751070611",
                                                    "text": "阅读",
                                                    "response": [
                                                        {
                                                            "id": "751070613",
                                                            "speaker": "阅读",
                                                            "text": "「各位朋友们在附近休息时，请尽量别待在开阔地，还是进到营地里更安全，更舒心！」"
                                                        },
                                                        {
                                                            "id": "751070614",
                                                            "speaker": "阅读",
                                                            "text": "#「愿{NICKNAME}、派蒙和{REALNAME[ID(2)|SHOWHOST(true)]}的好运和勇气保佑你们！」"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "751070612",
                                                    "text": "离开"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "751070608",
                                    "text": "离开"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "751070604",
                    "text": "离开"
                }
            ]
        }
    ]
}