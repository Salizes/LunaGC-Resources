{
    "talkId": "6210802",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "葫芦": 10
    },
    "dialogues": [
        {
            "id": "621080201",
            "speaker": "Player",
            "text": "那是什么酒？"
        },
        {
            "id": "621080202",
            "speaker": "葫芦",
            "text": "这款璃月出品的佳酿色如琥珀，刚入口就能感觉到丝丝甘甜…"
        },
        {
            "id": "621080203",
            "speaker": "葫芦",
            "text": "随后细品便是醇厚的馥郁，回味无穷，乃是上佳的好酒！"
        },
        {
            "id": "621080204",
            "speaker": "葫芦",
            "text": "价格也实惠，晨曦酒庄的酒窖直销…",
            "choices": [
                {
                    "id": "621080207",
                    "text": "晨曦酒庄？",
                    "response": [
                        {
                            "id": "621080208",
                            "speaker": "葫芦",
                            "text": "啊…我刚才提过吗？"
                        },
                        {
                            "id": "621080209",
                            "speaker": "葫芦",
                            "text": "应、应该没提过吧…我说的是璃月的酒窖…"
                        },
                        {
                            "id": "621080210",
                            "speaker": "葫芦",
                            "text": "你绝对提了。"
                        },
                        {
                            "id": "621080211",
                            "speaker": "葫芦",
                            "text": "…看你不信任的眼神，原来我是遇上行家了…"
                        },
                        {
                            "id": "621080212",
                            "speaker": "葫芦",
                            "text": "好吧我承认，是晨曦酒庄的酒换了包装。"
                        },
                        {
                            "id": "621080213",
                            "speaker": "葫芦",
                            "text": "我也不想撒谎的，但晨曦酒庄的酒确实太好喝了嘛…"
                        }
                    ]
                },
                {
                    "id": "621080205",
                    "text": "没什么兴趣。",
                    "response": [
                        {
                            "id": "621080206",
                            "speaker": "葫芦",
                            "text": "没什么兴趣？一看你就是旅行者吧…那你怕是要白来一趟璃月咯…"
                        }
                    ]
                }
            ]
        }
    ]
}