            "text": "咕！",
            "choices": [
                {
                    "id": "765110902",
                    "text": "帅狗狗！",
                    "response": [
                        {
                            "id": "765110903",
                            "speaker": "「咕咕丸」",
                            "text": "咕咕！"
                        },
                        {
                            "id": "765110904",
                            "speaker": "「咕咕丸」",
                            "text": "（这只忍犬似乎对你很有好感，眼里闪烁着期待的光芒…）"
                        }
                    ]
                },
                {
                    "id": "765110905",
                    "text": "狗不是这么叫的！",
                    "response": [
                        {
                            "id": "765110906",
                            "speaker": "「咕咕丸」",
                            "text": "呜…"
                        },
                        {
                            "id": "765110907",
                            "speaker": "「咕咕丸」",
                            "text": "嗷？"
                        },
                        {
                            "id": "765110908",
                            "speaker": "Player",
                            "text": "乖狗狗！"
                        },
                        {
                            "id": "765110909",
                            "speaker": "「咕咕丸」",
                            "text": "（这只忍犬的眼神变得格外明亮，显然非常开心。）"
                        }
                    ]
                },
                {
                    "id": "765110910",
                    "text": "待会儿再来陪你玩。",
                    "response": [
                        {
                            "id": "765110911",
                            "speaker": "「咕咕丸」",
                            "text": "咕~"
                        }
                    ]
                }
