    "dialogues": [
        {
            "id": "626150301",
            "speaker": "Player",
            "text": "你在做什么？"
        },
        {
            "id": "626150302",
            "speaker": "嘉玮",
            "text": "我在准备食材呢，哈哈。"
        },
        {
            "id": "626150303",
            "speaker": "嘉玮",
            "text": "我老婆非常爱吃鱼，而且一定要吃我每天新鲜钓上来的鱼，真是拿她没办法..."
        },
        {
            "id": "626150304",
            "speaker": "嘉玮",
            "text": "不过好在这正是我的拿手好戏，毕竟当年我也是出海追捕过传说中的大鱼的精英渔师了。"
        },
        {
            "id": "626150305",
            "speaker": "嘉玮",
            "text": "哈哈，那还是我没遇到她的时候的往事，不提了不提了。你们找我有什么事吗？"
        }
    ]
}