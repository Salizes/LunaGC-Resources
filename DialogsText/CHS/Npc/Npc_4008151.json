{
    "talkId": "4008151",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "派蒙": 3,
        "雪怪伯": 8
    },
    "dialogues": [
        {
            "id": "400815101",
            "speaker": "雪怪伯",
            "text": "「黄金流星」，还有「白银伴星」，恭喜你们进入决赛。",
            "choices": [
                {
                    "id": "400815102",
                    "text": "多谢多谢！",
                    "response": [
                        {
                            "id": "400815103",
                            "speaker": "雪怪伯",
                            "text": "看过你们和莱依拉选手的比赛后，我能感觉到，你们对于蕈兽有一种共识。"
                        },
                        {
                            "id": "400815104",
                            "speaker": "雪怪伯",
                            "text": "你们似乎倾向于…将宝珠控制下的蕈兽当成朋友，所以更了解它们，能将它们的潜力彻底发挥出来。"
                        },
                        {
                            "id": "400815105",
                            "speaker": "雪怪伯",
                            "text": "相比之下，我还带着一点「主人」的心思，只想着和它们一起苦修，磨砺技艺，却没有给过它们足够的关怀。"
                        },
                        {
                            "id": "400815106",
                            "speaker": "雪怪伯",
                            "text": "这种割裂，大概就是我败给你们的原因吧，我输得心服口服。"
                        },
                        {
                            "id": "400815107",
                            "speaker": "派蒙",
                            "text": "不至于啦，雪什么来着…雪先生！你也没有对蕈兽伙伴太严苛，只是在用普通的方法去对待他们。"
                        },
                        {
                            "id": "400815108",
                            "speaker": "派蒙",
                            "text": "而且，说不定我们也能向你学习呢，比如…一起和蕈兽伙伴冒险，适当吃一点点苦，来让我们的默契更加…坚不可摧！"
                        },
                        {
                            "id": "400815109",
                            "speaker": "雪怪伯",
                            "text": "过奖了，「白银伴星」！修行没有终点，我还要多多精进才是呐…"
                        },
                        {
                            "id": "400815110",
                            "speaker": "雪怪伯",
                            "text": "希望下次比赛，我能有幸和夺得了冠军的你们再切磋一次。"
                        },
                        {
                            "id": "400815111",
                            "speaker": "Player",
                            "text": "等我们的好消息吧。"
                        },
                        {
                            "id": "400815112",
                            "speaker": "派蒙",
                            "text": "我们也等着你的好消息哦。"
                        }
                    ]
                },
                {
                    "id": "400815113",
                    "text": "我们先去准备了。",
                    "response": [
                        {
                            "id": "400815114",
                            "speaker": "雪怪伯",
                            "text": "嗯，强大的对手正等着你们，不可疏忽大意。我相信，你们是冠军的最佳人选！"
                        }
                    ]
                }
            ]
        }
    ]
}