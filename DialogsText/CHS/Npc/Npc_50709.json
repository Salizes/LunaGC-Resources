    "dialogues": [
        {
            "id": "5070901",
            "speaker": "「万端珊瑚」广告",
            "text": "「万端珊瑚，代行万端！」"
        },
        {
            "id": "5070902",
            "speaker": "「万端珊瑚」广告",
            "text": "「寻人、寻找宠物、婚姻调查、犯罪调查、商业委托、运送货品、代购代送…」"
        },
        {
            "id": "5070903",
            "speaker": "「万端珊瑚」广告",
            "text": "「只要您开价，钱形、百目鬼之流江洋大盗也捉给您看！」"
        }
    ]
}