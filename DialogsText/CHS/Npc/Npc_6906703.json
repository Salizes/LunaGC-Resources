{
    "talkId": "6906703",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 10,
        "柯莱": 14
    },
    "dialogues": [
        {
            "id": "690670301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690670302",
            "speaker": "柯莱",
            "text": "好的！"
        },
        {
            "id": "690670303",
            "speaker": "柯莱",
            "text": "……"
        },
        {
            "id": "690670304",
            "speaker": "柯莱",
            "text": "…抱歉，我还以为你会先开口。"
        },
        {
            "id": "690670305",
            "speaker": "柯莱",
            "text": "我没怎么主动和朋友聊过天…不知道这种时候该找什么话题。"
        },
        {
            "id": "690670306",
            "speaker": "Player",
            "text": "没事，我正好有事想告诉你。"
        },
        {
            "id": "690670307",
            "speaker": "柯莱",
            "text": "唔…嗯，来吧！我已经准备好了。",
            "choices": [
                {
                    "id": "690670308",
                    "text": "安柏和我说了一些你的情况…",
                    "response": [
                        {
                            "id": "690670309",
                            "speaker": "柯莱",
                            "text": "——安柏？她提到我了吗？她是怎么说的？稍等，我去找个本子记录一下！",
                            "choices": [
                                {
                                    "id": "690670310",
                                    "text": "看到你阳光的样子…",
                                    "response": [
                                        {
                                            "id": "690670312",
                                            "speaker": "柯莱",
                                            "text": "哪里，我还差得远呢…还有吗？",
                                            "choices": [
                                                {
                                                    "id": "690670313",
                                                    "text": "说起你最近的来信…",
                                                    "response": [
                                                        {
                                                            "id": "690670315",
                                                            "speaker": "柯莱",
                                                            "text": "唔…我，我已经尽力了…"
                                                        },
                                                        {
                                                            "id": "690670320",
                                                            "speaker": "柯莱",
                                                            "text": "最近我又学了一些新词，想着要多熟悉熟悉，就全都用到信里了。"
                                                        },
                                                        {
                                                            "id": "690670321",
                                                            "speaker": "柯莱",
                                                            "text": "如果已经影响到阅读的话，还是我太心急了吗。"
                                                        },
                                                        {
                                                            "id": "690670322",
                                                            "speaker": "柯莱",
                                                            "text": "得小心一点用，少用一点，新的和旧的混在一起…"
                                                        },
                                                        {
                                                            "id": "690670323",
                                                            "speaker": "Player",
                                                            "text": "我可以帮你检查拼写哦。"
                                                        },
                                                        {
                                                            "id": "690670324",
                                                            "speaker": "柯莱",
                                                            "text": "真的吗？那就拜托你了！而且，还要叫你一声「师父」才行！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690670314",
                                                    "text": "错字稍微有点多…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690670311",
                                    "text": "她也感到非常高兴。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690670316",
                    "text": "凯亚和我说了一些你的情况…",
                    "response": [
                        {
                            "id": "690670317",
                            "speaker": "柯莱",
                            "text": "凯、凯亚吗…抱歉，我突然有点胃痛…"
                        },
                        {
                            "id": "690670318",
                            "speaker": "Player",
                            "text": "说你最近的来信错字很多。"
                        },
                        {
                            "id": "690670319",
                            "speaker": "柯莱",
                            "text": "啊，原来是这件事吗。我还以为肯定会…咳，没什么。"
                        }
                    ]
                }
            ]
        }
    ]
}