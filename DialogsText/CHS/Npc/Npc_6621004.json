    },
    "dialogues": [
        {
            "id": "662100401",
            "speaker": "Player",
            "text": "需要准备很多礼物吗？"
        },
        {
            "id": "662100402",
            "speaker": "约洛特莉",
            "text": "不不不，恰恰相反。"
        },
        {
            "id": "662100403",
            "speaker": "约洛特莉",
            "text": "暝视龙最不喜欢其他种族的生物为了一己私利借用它们的能力，自然也不会被简单的好处收买。"
        },
        {
            "id": "662100404",
            "speaker": "约洛特莉",
            "text": "在请它们出马前，必须要做足仪式，表明需要它们提供帮助的理由和目的。"
        },
        {
            "id": "662100405",
            "speaker": "约洛特莉",
            "text": "暝视龙的眼睛可是很亮的，千万不要想着去欺骗它们哦。"
        }
    ]
}