{
    "talkId": "6903009",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "钟离": 6
    },
    "dialogues": [
        {
            "id": "690300901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690300202",
            "speaker": "钟离",
            "text": "氛围宜人，很合我意。",
            "choices": [
                {
                    "id": "690300203",
                    "text": "能让你满意就好。",
                    "response": [
                        {
                            "id": "690300204",
                            "speaker": "钟离",
                            "text": "相识至今，我对你的行事原则和为人处世算是略知一二。"
                        },
                        {
                            "id": "690300205",
                            "speaker": "钟离",
                            "text": "你的选择值得信赖。"
                        }
                    ]
                },
                {
                    "id": "690300206",
                    "text": "我怕这些对你来说太过幼稚。",
                    "response": [
                        {
                            "id": "690300207",
                            "speaker": "钟离",
                            "text": "万事万物大都是从无到有，从小到大，循序渐进。"
                        },
                        {
                            "id": "690300208",
                            "speaker": "钟离",
                            "text": "我只是年长些，不意味着古板到无法欣赏年轻人的优秀。"
                        },
                        {
                            "id": "690300209",
                            "speaker": "钟离",
                            "text": "你的品位，向来令人安心。"
                        }
                    ]
                }
            ]
        }
    ]
}