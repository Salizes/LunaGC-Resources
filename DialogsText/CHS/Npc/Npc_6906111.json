{
    "talkId": "6906111",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "绮良良": 12
    },
    "dialogues": [
        {
            "id": "690610401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690610402",
            "speaker": "绮良良",
            "text": "啊，我有个事情早就想问你了。"
        },
        {
            "id": "690610403",
            "speaker": "绮良良",
            "text": "#{M#你知道人类女孩子喜欢些什么打扮吗？}{F#你喜欢怎样打扮自己呀？}"
        },
        {
            "id": "690610404",
            "speaker": "Player",
            "text": "这个…"
        },
        {
            "id": "690610405",
            "speaker": "绮良良",
            "text": "太突然了吗？抱歉抱歉！那我从头讲好了。"
        },
        {
            "id": "690610406",
            "speaker": "绮良良",
            "text": "你知道，我虽然是个妖怪，但从小时候起，就一直受到人类奶奶的照顾。"
        },
        {
            "id": "690610407",
            "speaker": "绮良良",
            "text": "人的故事，比妖的故事，听得多的多了。温暖又多彩的人类社会，我非常向往！"
        },
        {
            "id": "690610408",
            "speaker": "绮良良",
            "text": "于是，我好不容易才用妖力变出了现在的外貌，可新的问题又来了。如果打扮和举止太像「猫又」，也不太好…"
        },
        {
            "id": "690610409",
            "speaker": "绮良良",
            "text": "所以，我偷偷观察了人类女孩子的打扮，大家似乎都很喜欢蝴蝶结和花朵…"
        },
        {
            "id": "690610410",
            "speaker": "绮良良",
            "text": "我就给自己的衣服加了不少！",
            "choices": [
                {
                    "id": "690610411",
                    "text": "的确很可爱。",
                    "response": [
                        {
                            "id": "690610412",
                            "speaker": "绮良良",
                            "text": "真的吗？那太好啦。"
                        },
                        {
                            "id": "690610415",
                            "speaker": "绮良良",
                            "text": "那个…等你什么时候有空，可以陪我逛逛商店吗？"
                        },
                        {
                            "id": "690610416",
                            "speaker": "绮良良",
                            "text": "我想买些好看的小饰品，有你提供意见，肯定会更顺利！"
                        }
                    ]
                },
                {
                    "id": "690610413",
                    "text": "不如再搭配点别的。",
                    "response": [
                        {
                            "id": "690610414",
                            "speaker": "绮良良",
                            "text": "哇，你很懂行呀？我果然没有问错人！"
                        }
                    ]
                }
            ]
        }
    ]
}