{
    "talkId": "6907504",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 5,
        "Wanderer": 19
    },
    "dialogues": [
        {
            "id": "690750401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690750402",
            "speaker": "Wanderer",
            "text": "这样发问，是准备满足我提出的任何需求吗？"
        },
        {
            "id": "690750403",
            "speaker": "Wanderer",
            "text": "那我可得好好想想，测试一下你能为我做到什么程度…"
        },
        {
            "id": "690750404",
            "speaker": "Wanderer",
            "text": "——逗你的。"
        },
        {
            "id": "690750405",
            "speaker": "Wanderer",
            "text": "虽然你在预感不妙时的表情很耐人寻味，但我并没有故意为难你的癖好。"
        },
        {
            "id": "690750406",
            "speaker": "Wanderer",
            "text": "不过你要真是闲着没事，不如去给我弄点吃的吧。"
        },
        {
            "id": "690750407",
            "speaker": "Player",
            "text": "人偶也需要吃饭吗？"
        },
        {
            "id": "690750408",
            "speaker": "Wanderer",
            "text": "不必须，至少我不用。"
        },
        {
            "id": "690750409",
            "speaker": "Wanderer",
            "text": "但饭桌是个很有意思的地方。"
        },
        {
            "id": "690750410",
            "speaker": "Wanderer",
            "text": "大家各怀鬼胎，表面上却还得推杯换盏，互相问候。"
        },
        {
            "id": "690750411",
            "speaker": "Wanderer",
            "text": "嘻嘻，真想带你去见识一次执行官们的饭局。"
        },
        {
            "id": "690750412",
            "speaker": "Wanderer",
            "text": "他们为了逃避不喜欢的任务，什么都做得出来。"
        },
        {
            "id": "690750413",
            "speaker": "Wanderer",
            "text": "可惜现在只有你我，肯定不会有那么戏剧性的场面了。"
        },
        {
            "id": "690750414",
            "speaker": "Wanderer",
            "text": "我不挑剔，你做什么我就吃什么。",
            "choices": [
                {
                    "id": "690750415",
                    "text": "还是给点建议吧。",
                    "response": [
                        {
                            "id": "690750416",
                            "speaker": "Wanderer",
                            "text": "那就做你最喜欢的吧。"
                        },
                        {
                            "id": "690750417",
                            "speaker": "Wanderer",
                            "text": "万一吃饭时尴尬到说不出话来，至少还可以享受食物。"
                        }
                    ]
                },
                {
                    "id": "690750418",
                    "text": "那我要准备一大桌甜食——",
                    "response": [
                        {
                            "id": "690750419",
                            "speaker": "Wanderer",
                            "text": "…我错了。"
                        },
                        {
                            "id": "690750420",
                            "speaker": "Player",
                            "text": "欸？怎么突然道歉…"
                        },
                        {
                            "id": "690750421",
                            "speaker": "Wanderer",
                            "text": "谁道歉了！"
                        },
                        {
                            "id": "690750422",
                            "speaker": "Wanderer",
                            "text": "只是在承认自己判断失误罢了。"
                        },
                        {
                            "id": "690750423",
                            "speaker": "Wanderer",
                            "text": "不过你能有些坏心思也算是好事。"
                        },
                        {
                            "id": "690750424",
                            "speaker": "Wanderer",
                            "text": "你要是太过善良，我反而很难办呢。"
                        }
                    ]
                }
            ]
        }
    ]
}