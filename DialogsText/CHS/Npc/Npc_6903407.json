{
    "talkId": "6903407",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "诺艾尔": 15
    },
    "dialogues": [
        {
            "id": "690340701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690340301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690340209",
            "speaker": "诺艾尔",
            "text": "好的，这是我的荣幸。"
        },
        {
            "id": "690340302",
            "speaker": "诺艾尔",
            "text": "说起来…自从来这里之后，我已经很久没有捡到来历不明的失物了。"
        },
        {
            "id": "690340303",
            "speaker": "诺艾尔",
            "text": "感觉还有些不习惯呢。",
            "choices": [
                {
                    "id": "690340304",
                    "text": "欸？",
                    "response": [
                        {
                            "id": "690340305",
                            "speaker": "诺艾尔",
                            "text": "就是，在清扫工作中遇到的。"
                        },
                        {
                            "id": "690340308",
                            "speaker": "诺艾尔",
                            "text": "比如…在柜子底下翻到颜色陈旧的发带。"
                        },
                        {
                            "id": "690340309",
                            "speaker": "诺艾尔",
                            "text": "在灌木丛里找到被小猫叼过的球。"
                        },
                        {
                            "id": "690340310",
                            "speaker": "诺艾尔",
                            "text": "还有图书馆角落里的书签，丢在路边的钥匙，教堂门缝里没有署名的忏悔信…",
                            "choices": [
                                {
                                    "id": "690340311",
                                    "text": "听起来清扫工作真是辛苦…",
                                    "response": [
                                        {
                                            "id": "690340312",
                                            "speaker": "诺艾尔",
                                            "text": "没有没有！我感到很荣幸哦。"
                                        },
                                        {
                                            "id": "690340315",
                                            "speaker": "诺艾尔",
                                            "text": "不过，这样说起来。"
                                        },
                                        {
                                            "id": "690340316",
                                            "speaker": "诺艾尔",
                                            "text": "这处家园一直都很干净呢。"
                                        },
                                        {
                                            "id": "690340317",
                                            "speaker": "Player",
                                            "text": "其中也有诺艾尔的功劳。"
                                        },
                                        {
                                            "id": "690340318",
                                            "speaker": "诺艾尔",
                                            "text": "谢谢…"
                                        },
                                        {
                                            "id": "690340319",
                                            "speaker": "诺艾尔",
                                            "text": "我工作的时候非常有干劲！比打扫骑士团或者其他任何地方都要高兴。"
                                        },
                                        {
                                            "id": "690340320",
                                            "speaker": "诺艾尔",
                                            "text": "因为…这可是你的家呀。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690340313",
                                    "text": "最后它们都去哪里了呢？",
                                    "response": [
                                        {
                                            "id": "690340314",
                                            "speaker": "诺艾尔",
                                            "text": "我会尽全力为它们找到失主！但也有一部分没人认领的，会被留在骑士团里。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690340306",
                    "text": "诺艾尔还有捡东西的习惯？",
                    "response": [
                        {
                            "id": "690340307",
                            "speaker": "诺艾尔",
                            "text": "不，不是啦。是清扫工作中遇到的…"
                        }
                    ]
                }
            ]
        }
    ]
}