{
    "talkId": "7322057",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "芭别尔": 14
    },
    "dialogues": [
        {
            "id": "732205701",
            "speaker": "芭别尔",
            "text": "#是你啊，{NICKNAME}，从探险中回来了吗？",
            "choices": [
                {
                    "id": "732205702",
                    "text": "关于叛徒…",
                    "response": [
                        {
                            "id": "732205703",
                            "speaker": "芭别尔",
                            "text": "你是在说阿德菲和阿萨里格吗…真是让你看到了塔尼特不堪的一面…"
                        },
                        {
                            "id": "732205704",
                            "speaker": "芭别尔",
                            "text": "他们和那些「北方人」接触得太久了，忘记了自己本来是塔尼特的子女，应该遵照部落的规矩成活。"
                        },
                        {
                            "id": "732205705",
                            "speaker": "芭别尔",
                            "text": "但好在我还有婕德…她没有辜负我的期望。"
                        }
                    ]
                },
                {
                    "id": "732205706",
                    "text": "关于婕德…",
                    "response": [
                        {
                            "id": "732205707",
                            "speaker": "芭别尔",
                            "text": "婕德吗？她是个好孩子。在部落学得很快，也很能吃苦…从没见她抱怨过。"
                        },
                        {
                            "id": "732205708",
                            "speaker": "芭别尔",
                            "text": "呵呵，说起来，塔尼特部族和她的父亲还有过一些小小的过节。真的是很遗憾…"
                        },
                        {
                            "id": "732205709",
                            "speaker": "芭别尔",
                            "text": "但我很高兴婕德回来了，虽然那孩子的父亲…唉，这也算是迟来的和解吧。"
                        },
                        {
                            "id": "732205710",
                            "speaker": "芭别尔",
                            "text": "那孩子也很喜欢你，我看得出来。"
                        },
                        {
                            "id": "732205711",
                            "speaker": "芭别尔",
                            "text": "所以…请不要辜负她的友谊。"
                        }
                    ]
                },
                {
                    "id": "732205712",
                    "text": "关于居尔城与利露帕尔…",
                    "response": [
                        {
                            "id": "732205713",
                            "speaker": "芭别尔",
                            "text": "「镇灵之母」已不再开口说话，选择了离去…是么。"
                        },
                        {
                            "id": "732205714",
                            "speaker": "芭别尔",
                            "text": "那还真是件…令人遗憾的事。不过「镇灵之母」回归了她的命运，或许对包括她在内的所有人来说，都是最好的结局。"
                        },
                        {
                            "id": "732205715",
                            "speaker": "芭别尔",
                            "text": "但镇灵的力量不会离契约所定的主人远去，那瓶子里一定还有她残留的力量与权能，我说的没错吧？"
                        },
                        {
                            "id": "732205716",
                            "speaker": "芭别尔",
                            "text": "呵呵，「镇灵之母」虽已远去，但契约仍在，希望你能够…好好保存它…在沙漠中好好保护自己。"
                        }
                    ]
                },
                {
                    "id": "732205717",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "732205718",
                            "speaker": "芭别尔",
                            "text": "再见，客人，塔尼特永远欢迎你。"
                        }
                    ]
                }
            ]
        }
    ]
}