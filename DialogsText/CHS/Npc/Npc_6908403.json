{
    "talkId": "6908403",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 8,
        "林尼": 14
    },
    "dialogues": [
        {
            "id": "690840301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690840302",
            "speaker": "林尼",
            "text": "好呀，那你先来看看我的帽子，注意到了吗，它与平时有什么不同？"
        },
        {
            "id": "690840303",
            "speaker": "Player",
            "text": "好像没什么区别。"
        },
        {
            "id": "690840304",
            "speaker": "林尼",
            "text": "观察得不够仔细，再看看？靠近点看看。"
        },
        {
            "id": "690840305",
            "speaker": "Player",
            "text": "好吧。"
        },
        {
            "id": "690840306",
            "speaker": "林尼",
            "text": "有结论了吗？花纹还是颜色？你应该见过它不少次了吧。",
            "choices": [
                {
                    "id": "690840307",
                    "text": "还是没看出来。",
                    "response": [
                        {
                            "id": "690840308",
                            "speaker": "林尼",
                            "text": "哎呀，真可惜…但结论没错。"
                        },
                        {
                            "id": "690840311",
                            "speaker": "林尼",
                            "text": "我刚刚玩了一个小小的把戏，偷走了你的一件东西，又将一张卡牌放进了你的包里。"
                        },
                        {
                            "id": "690840312",
                            "speaker": "林尼",
                            "text": "要来猜猜看我偷走的是什么东西吗？",
                            "choices": [
                                {
                                    "id": "690840313",
                                    "text": "钱包？",
                                    "response": [
                                        {
                                            "id": "690840314",
                                            "speaker": "林尼",
                                            "text": "哈哈，我可真是个见钱眼开的小偷，难怪能弄来很多钱呢！"
                                        },
                                        {
                                            "id": "690840315",
                                            "speaker": "林尼",
                                            "text": "但正确答案是「注意力」，比钱更有价值！"
                                        },
                                        {
                                            "id": "690840321",
                                            "speaker": "林尼",
                                            "text": "了解并熟练掌握这一点，勤加练习手法，你也能成为优秀的魔术师哦！"
                                        },
                                        {
                                            "id": "690840322",
                                            "speaker": "林尼",
                                            "text": "…好了，现在把卡牌还给我吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690840316",
                                    "text": "心？",
                                    "response": [
                                        {
                                            "id": "690840317",
                                            "speaker": "林尼",
                                            "text": "真是个意想不到的回答，我的心跳都要跟着加速了呢。"
                                        },
                                        {
                                            "id": "690840318",
                                            "speaker": "林尼",
                                            "text": "但正确答案是「注意力」，虽然没有「心」那么有价值，但对魔术师来说很重要！"
                                        }
                                    ]
                                },
                                {
                                    "id": "690840319",
                                    "text": "注意力？",
                                    "response": [
                                        {
                                            "id": "690840320",
                                            "speaker": "林尼",
                                            "text": "敏捷的思维，真厉害，回答正确！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690840309",
                    "text": "是大小吗？",
                    "response": [
                        {
                            "id": "690840310",
                            "speaker": "林尼",
                            "text": "很遗憾，我故意误导了你。"
                        }
                    ]
                }
            ]
        }
    ]
}