{
    "talkId": "6908003",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "米卡": 13
    },
    "dialogues": [
        {
            "id": "690800301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690800302",
            "speaker": "米卡",
            "text": "当然了！"
        },
        {
            "id": "690800303",
            "speaker": "米卡",
            "text": "难得这样独处…我有很多事想请教你。"
        },
        {
            "id": "690800304",
            "speaker": "米卡",
            "text": "比如，你擅长使用单手剑，却能击败一些弩箭都够不着的强大敌人。"
        },
        {
            "id": "690800305",
            "speaker": "米卡",
            "text": "距离和射程这些因素，对你而言从来不是问题…究竟是怎么做到的呢？",
            "choices": [
                {
                    "id": "690800306",
                    "text": "以后我可以给你现场演示哦。",
                    "response": [
                        {
                            "id": "690800308",
                            "speaker": "米卡",
                            "text": "的确呢…以后还要一起旅行，看着你现场演示，我应该理解得更快。"
                        },
                        {
                            "id": "690800309",
                            "speaker": "米卡",
                            "text": "那我们还是聊一点轻松的话题吧…你想听我讲哪方面的故事呢？"
                        },
                        {
                            "id": "690800310",
                            "speaker": "Player",
                            "text": "米卡说什么，我就听什么。"
                        },
                        {
                            "id": "690800311",
                            "speaker": "米卡",
                            "text": "嗯…我想想…那就和你聊聊游击小队的趣事吧！"
                        },
                        {
                            "id": "690800312",
                            "speaker": "米卡",
                            "text": "刚开始，游击小队会用「掰甜甜花的花瓣」来决定收工后由谁做饭。"
                        },
                        {
                            "id": "690800313",
                            "speaker": "米卡",
                            "text": "有的伙伴不擅长下厨，大家也不会介意，而是照常吃完所有饭菜，然后一起讨论优缺点。"
                        },
                        {
                            "id": "690800314",
                            "speaker": "米卡",
                            "text": "多亏大家互相给出建议，一段时间以后，所有人做饭的技术都突飞猛进。"
                        },
                        {
                            "id": "690800315",
                            "speaker": "米卡",
                            "text": "比不上城里的饭馆也没关系，作为行军餐已经很可口了。",
                            "choices": [
                                {
                                    "id": "690800316",
                                    "text": "我们也来试试吧。",
                                    "response": [
                                        {
                                            "id": "690800318",
                                            "speaker": "米卡",
                                            "text": "我觉得可以哦！这样有一种惊喜的感觉…"
                                        },
                                        {
                                            "id": "690800319",
                                            "speaker": "米卡",
                                            "text": "嘿嘿，开始期待下一顿饭了…我这就去找几朵甜甜花！"
                                        }
                                    ]
                                },
                                {
                                    "id": "690800317",
                                    "text": "还可以这样决定做什么料理。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690800307",
                    "text": "现在，我想听听米卡的故事。"
                }
            ]
        }
    ]
}