    "dialogues": [
        {
            "id": "650490201",
            "speaker": "Player",
            "text": "里面看着还挺忙的。"
        },
        {
            "id": "650490202",
            "speaker": "里凯蒂",
            "text": "这就是问题所在。"
        },
        {
            "id": "650490203",
            "speaker": "里凯蒂",
            "text": "让我们扪心自问，如果按照正常的工作效率，以复律官的忙碌程度来看，工作成果本应有多少？"
        },
        {
            "id": "650490204",
            "speaker": "里凯蒂",
            "text": "我还在「特巡队」的时候，从未想过这样的问题。年纪变大转入复律庭后，心中的疑问日益增多。"
        }
    ]
}