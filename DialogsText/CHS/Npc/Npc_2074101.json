{
    "talkId": "2074101",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "葛瑞丝": 8
    },
    "dialogues": [
        {
            "id": "207410101",
            "speaker": "葛瑞丝",
            "text": "感谢风神大人…"
        },
        {
            "id": "207410102",
            "speaker": "Player",
            "text": "你在做什么呢？"
        },
        {
            "id": "207410103",
            "speaker": "葛瑞丝",
            "text": "我正在向巴巴托斯大人祈祷呢，多亏了他的护佑，蒙德城才得以度过灾难。"
        },
        {
            "id": "207410104",
            "speaker": "葛瑞丝",
            "text": "还有西风骑士团和冒险家协会的各位，感谢风神，他们都平安无事。"
        },
        {
            "id": "207410105",
            "speaker": "葛瑞丝",
            "text": "感谢您，巴巴托斯大人…",
            "choices": [
                {
                    "id": "207410106",
                    "text": "感谢您，巴巴托斯大人…",
                    "response": [
                        {
                            "id": "207410108",
                            "speaker": "葛瑞丝",
                            "text": "我不敢自己揣测巴巴托斯大人具体为我们做了什么。"
                        },
                        {
                            "id": "207410109",
                            "speaker": "葛瑞丝",
                            "text": "但是，仅仅是意识到有这样一位勤恳的神明在护佑着蒙德城，也足够让人安心了。"
                        },
                        {
                            "id": "207410110",
                            "speaker": "葛瑞丝",
                            "text": "对了，如果您有空的话，能帮我一个忙吗？"
                        },
                        {
                            "id": "207410111",
                            "speaker": "葛瑞丝",
                            "text": "我想请您帮我去搜集一份蒲公英籽，然后到风神像上将它们播撒到远方…"
                        }
                    ]
                },
                {
                    "id": "207410107",
                    "text": "…那还真是辛苦他了。"
                }
            ]
        }
    ]
}