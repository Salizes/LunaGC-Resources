    "dialogues": [
        {
            "id": "622000207",
            "speaker": "Player",
            "text": "关于老家…"
        },
        {
            "id": "622000208",
            "speaker": "仲林",
            "text": "老婆在城里，家里老人和女儿在轻策山住。"
        },
        {
            "id": "622000209",
            "speaker": "仲林",
            "text": "所以你说我算什么人？我也不知道我算什么人了。"
        },
        {
            "id": "622000210",
            "speaker": "仲林",
            "text": "这么说来，您是哪里人啊？"
        }
    ]
}