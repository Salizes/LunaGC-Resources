    "dialogues": [
        {
            "id": "694070301",
            "speaker": "哥伦比娅",
            "text": "你留意过头顶么？书架以倒立的形式摆放，天花板上同样存在着地毯和桌椅…"
        },
        {
            "id": "694070302",
            "speaker": "哥伦比娅",
            "text": "那么，换一个角度呢？"
        },
        {
            "id": "694070303",
            "speaker": "哥伦比娅",
            "text": "说不定那才是真实的地面，而我们是被魔女小姐们的魔法悬挂在了天上。"
        }
    ]
}