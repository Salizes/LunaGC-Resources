{
    "talkId": "200010",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Player": 8,
        "参赛者": 12,
        "派蒙": 8,
        "珠函": 16
    },
    "dialogues": [
        {
            "id": "20001001",
            "speaker": "珠函",
            "text": "「轻策庄扳手腕冠军」，这个荣誉…唉，还是通过好了…"
        },
        {
            "id": "20001002",
            "speaker": "珠函",
            "text": "麻烦下一位来报名吧，首先请告诉我你的名字。"
        },
        {
            "id": "20001003",
            "speaker": "Player",
            "text": "#我是{NICKNAME}。"
        },
        {
            "id": "20001004",
            "speaker": "珠函",
            "text": "#{NICKNAME}，难道是，那一位…？！"
        },
        {
            "id": "20001005",
            "speaker": "参赛者",
            "text": "#{NICKNAME}，我没听错吧？"
        },
        {
            "id": "20001006",
            "speaker": "参赛者",
            "text": "真的是那个人？"
        },
        {
            "id": "20001007",
            "speaker": "参赛者",
            "text": "欸？那个人没有神之眼吗？居然来参加这场武斗会！"
        },
        {
            "id": "20001008",
            "speaker": "珠函",
            "text": "那个…我核实一下，你就是帮助璃月港击退了魔神的旅行者吗？"
        },
        {
            "id": "20001009",
            "speaker": "Player",
            "text": "嗯。"
        },
        {
            "id": "20001010",
            "speaker": "参赛者",
            "text": "#果然是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}！"
        },
        {
            "id": "20001011",
            "speaker": "参赛者",
            "text": "在「送仙典仪」上，跟刻晴大人讲话的那个人！"
        },
        {
            "id": "20001012",
            "speaker": "参赛者",
            "text": "#等、等会能不能找{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}签名啊？"
        },
        {
            "id": "20001013",
            "speaker": "珠函",
            "text": "你应该知道，这场武斗会是只允许没有神之眼的人参加的吧？"
        },
        {
            "id": "20001014",
            "speaker": "Player",
            "text": "我没有神之眼。"
        },
        {
            "id": "20001015",
            "speaker": "珠函",
            "text": "真的吗？可是传闻中，你的战斗能力出神入化，多次闯入险境之中，无论是魔神还是愚人众，都不是你的对手。"
        },
        {
            "id": "20001016",
            "speaker": "派蒙",
            "text": "#但{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}就是没有神之眼啦，不信你们完全可以来找找看。"
        },
        {
            "id": "20001017",
            "speaker": "珠函",
            "text": "抱歉，无意冒犯，我相信大英雄是不会说谎的。那，能请你报上一些荣誉吗？"
        },
        {
            "id": "20001018",
            "speaker": "珠函",
            "text": "虽然对你来说这只是走个形式，但如果你能说一下，也方便我来登记…"
        },
        {
            "id": "20001019",
            "speaker": "珠函",
            "text": "讨伐了魔神奥赛尔这一条，我已经知道了，还有别的吗？",
            "choices": [
                {
                    "id": "20001020",
                    "text": "击败过愚人众的执行官。",
                    "response": [
                        {
                            "id": "20001021",
                            "speaker": "派蒙",
                            "text": "还和风魔龙特瓦林交过手哦。"
                        },
                        {
                            "id": "20001026",
                            "speaker": "参赛者",
                            "text": "这……"
                        },
                        {
                            "id": "20001027",
                            "speaker": "参赛者",
                            "text": "#冠军肯定是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}的了。"
                        },
                        {
                            "id": "20001028",
                            "speaker": "参赛者",
                            "text": "我想知道现在退赛还是不是来得及。"
                        },
                        {
                            "id": "20001029",
                            "speaker": "珠函",
                            "text": "我知道了，我知道了，有这些完全足够了，我从来没见过这么豪华的荣誉背景…"
                        },
                        {
                            "id": "20001030",
                            "speaker": "珠函",
                            "text": "好了，已经登记完毕，接下来由我为你们介绍一下比赛的奖品。"
                        },
                        {
                            "id": "20001031",
                            "speaker": "珠函",
                            "text": "既然大英雄要参加这场武斗会，一定是剑指冠军，想要拿到这枚珍贵的神之眼吧。"
                        },
                        {
                            "id": "20001032",
                            "speaker": "派蒙",
                            "text": "我们不是为了这个来的啦。北斗答应了我们，只要能夺冠，就会带我们去稻妻。"
                        },
                        {
                            "id": "20001033",
                            "speaker": "参赛者",
                            "text": "还有追加奖励？从来没听说过啊！"
                        },
                        {
                            "id": "20001034",
                            "speaker": "参赛者",
                            "text": "我觉得，就是因为北斗开出了优厚的条件，才能请到大英雄吧。"
                        },
                        {
                            "id": "20001035",
                            "speaker": "参赛者",
                            "text": "但是大英雄居然想去稻妻那种危险的地方吗…"
                        },
                        {
                            "id": "20001036",
                            "speaker": "珠函",
                            "text": "原、原来是这样，和大姐头提前谈好了条件啊。",
                            "choices": [
                                {
                                    "id": "20001037",
                                    "text": "大家有点误会。",
                                    "response": [
                                        {
                                            "id": "20001038",
                                            "speaker": "珠函",
                                            "text": "毕竟谁都没想到你会来参赛，就连我也很吃惊…"
                                        },
                                        {
                                            "id": "20001041",
                                            "speaker": "珠函",
                                            "text": "总之，预选赛即将开始，你可以先去做一些准备，商量一些对策。"
                                        },
                                        {
                                            "id": "20010101",
                                            "speaker": "派蒙",
                                            "text": "对了，这场武斗会是不允许有神之眼的人参加的。"
                                        },
                                        {
                                            "id": "20010102",
                                            "speaker": "派蒙",
                                            "text": "虽然你没有神之眼，但在提瓦特，大家都认为只有拥有神之眼的人才能使用元素力。"
                                        },
                                        {
                                            "id": "20010103",
                                            "speaker": "派蒙",
                                            "text": "为了不被误解，你在比武的时候也不要使用元素力吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "20001039",
                                    "text": "只是对神之眼兴趣不大而已。",
                                    "response": [
                                        {
                                            "id": "20001040",
                                            "speaker": "珠函",
                                            "text": "不愧是大英雄，有自己的考量。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "20001022",
                    "text": "特瓦林的拯救者。",
                    "response": [
                        {
                            "id": "20001023",
                            "speaker": "派蒙",
                            "text": "还和愚人众执行官「公子」交过手哦。"
                        }
                    ]
                },
                {
                    "id": "20001024",
                    "text": "西风骑士团荣誉骑士。",
                    "response": [
                        {
                            "id": "20001025",
                            "speaker": "派蒙",
                            "text": "和风魔龙特瓦林，愚人众执行官「公子」都交过手哦。"
                        }
                    ]
                }
            ]
        }
    ]
}