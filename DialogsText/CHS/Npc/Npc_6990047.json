{
    "talkId": "6990047",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 9,
        "派蒙": 8
    },
    "dialogues": [
        {
            "id": "699004701",
            "speaker": "Player",
            "text": "关于使龙开心的办法…"
        },
        {
            "id": "699004702",
            "speaker": "派蒙",
            "text": "欸嘿嘿，纳塔有好多好多可爱的龙，我要跟它们都搞好关系！"
        },
        {
            "id": "699004703",
            "speaker": "Player",
            "text": "哦？派蒙很自信嘛。"
        },
        {
            "id": "699004704",
            "speaker": "派蒙",
            "text": "那当然，我还特意为此准备了秘诀！"
        },
        {
            "id": "699004705",
            "speaker": "Player",
            "text": "秘诀？是什么秘诀啊？"
        },
        {
            "id": "699004706",
            "speaker": "派蒙",
            "text": "很简单！首先，你要先夸奖它，这样它就会感受到你的好意并放下防备。接着，再轻轻地摸摸它的头，你们就熟悉起来啦！"
        },
        {
            "id": "699004707",
            "speaker": "派蒙",
            "text": "最后，也是最重要的！好吃的！只要你跟龙分享好吃的，你们就是好朋友啦！怎么样，我厉害吧！",
            "choices": [
                {
                    "id": "699004708",
                    "text": "——唔，总感觉…",
                    "response": [
                        {
                            "id": "699004710",
                            "speaker": "派蒙",
                            "text": "喂！不许用那刚才的招数对付我！",
                            "choices": [
                                {
                                    "id": "699004711",
                                    "text": "欸？我的意思明明是…",
                                    "response": [
                                        {
                                            "id": "699004713",
                                            "speaker": "派蒙",
                                            "text": "哼，你就是想说点好听的来敷衍我，我才不上当呢！",
                                            "choices": [
                                                {
                                                    "id": "699004714",
                                                    "text": "可我是在真心夸奖派蒙啊，没想到惹你不高兴了。",
                                                    "response": [
                                                        {
                                                            "id": "699004716",
                                                            "speaker": "派蒙",
                                                            "text": "真的？好哎，是甜甜花酿鸡！我现在就要吃！"
                                                        },
                                                        {
                                                            "id": "699004717",
                                                            "speaker": "派蒙",
                                                            "text": "不过话说回来，你怎么笑得这么开心啊？难道我错过了什么吗？"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "699004715",
                                                    "text": "作为道歉，我请你吃甜甜花酿鸡好不好？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "699004712",
                                    "text": "派蒙就跟纳塔的龙宝宝一样可爱呢！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699004709",
                    "text": "这些招数用来对付派蒙也很好用呢…"
                }
            ]
        }
    ]
}