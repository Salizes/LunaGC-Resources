{
    "talkId": "6900608",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "丽莎": 12
    },
    "dialogues": [
        {
            "id": "690060801",
            "speaker": "丽莎",
            "text": "为什么不呢？"
        },
        {
            "id": "690060802",
            "speaker": "丽莎",
            "text": "要是没有图书登记或者别的药剂配置工作，真想天天就这样和你悠闲地聊聊天度过。",
            "choices": [
                {
                    "id": "690060803",
                    "text": "最近来图书馆借书的人还多吗？",
                    "response": [
                        {
                            "id": "690060804",
                            "speaker": "丽莎",
                            "text": "和以前差不多吧。借书不还的人倒是少了一些。"
                        },
                        {
                            "id": "690060805",
                            "speaker": "丽莎",
                            "text": "「自由」之都的人们时间意识变得强烈起来，我还是挺欣慰的。"
                        },
                        {
                            "id": "690060806",
                            "speaker": "丽莎",
                            "text": "当然，我也不会期待每个人都和小可爱你一样懂事。"
                        },
                        {
                            "id": "690060814",
                            "speaker": "丽莎",
                            "text": "呵呵…"
                        },
                        {
                            "id": "690060815",
                            "speaker": "丽莎",
                            "text": "#{NICKNAME}你脸红的样子…真的很可爱呢。"
                        }
                    ]
                },
                {
                    "id": "690060807",
                    "text": "有调制出什么特别的药剂吗？",
                    "response": [
                        {
                            "id": "690060808",
                            "speaker": "丽莎",
                            "text": "特别的药剂…"
                        },
                        {
                            "id": "690060809",
                            "speaker": "丽莎",
                            "text": "啊，我做出了一种能让纺织品摸起来更柔软的药剂。"
                        },
                        {
                            "id": "690060810",
                            "speaker": "丽莎",
                            "text": "还有一支能够让空气保持甜香的清新剂。我还挺喜欢的。"
                        },
                        {
                            "id": "690060811",
                            "speaker": "丽莎",
                            "text": "不过，这些就不是骑士团的需要。而是出自我的个人兴趣。"
                        },
                        {
                            "id": "690060812",
                            "speaker": "丽莎",
                            "text": "嗯…难道是跟你认识了之后，爱好也向居家的方向转变了吗。"
                        }
                    ]
                },
                {
                    "id": "690060813",
                    "text": "丽莎又在说让人害羞的话了…"
                }
            ]
        }
    ]
}