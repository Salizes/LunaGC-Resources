    "dialogues": [
        {
            "id": "631050301",
            "speaker": "Player",
            "text": "大家的愿望…"
        },
        {
            "id": "631050302",
            "speaker": "稻城萤美",
            "text": "嗯…我一直负责接待前来神社求签的人，也听闻了不少世人的愿望。"
        },
        {
            "id": "631050303",
            "speaker": "稻城萤美",
            "text": "最近来求签的人，有不少都希望锁国能早日解除…"
        },
        {
            "id": "631050304",
            "speaker": "稻城萤美",
            "text": "雷神大人…不，没什么。"
        },
        {
            "id": "631050305",
            "speaker": "稻城萤美",
            "text": "身为巫女，我自当永远追随、侍奉雷神大人。鸣神永恒，此心不移。"
        }
    ]
}