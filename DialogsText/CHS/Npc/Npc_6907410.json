{
    "talkId": "6907410",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "莱依拉": 11
    },
    "dialogues": [
        {
            "id": "690740301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690740302",
            "speaker": "莱依拉",
            "text": "好呀，正好转换一下心情。"
        },
        {
            "id": "690740303",
            "speaker": "莱依拉",
            "text": "唔…我想想有没有什么值得跟你分享的事…啊，有了！"
        },
        {
            "id": "690740304",
            "speaker": "莱依拉",
            "text": "你知道那个吗？「研究室的叹息之灵」。"
        },
        {
            "id": "690740305",
            "speaker": "Player",
            "text": "那是什么？"
        },
        {
            "id": "690740306",
            "speaker": "莱依拉",
            "text": "#嘿嘿，看来消息灵通的{NICKNAME}还没听说过呀。"
        },
        {
            "id": "690740307",
            "speaker": "莱依拉",
            "text": "我跟你说，我们学院里有一间特别的研究室，里面总是会发生怪事。"
        },
        {
            "id": "690740308",
            "speaker": "莱依拉",
            "text": "有人晚上路过那间研究室的时候，听见里面有人在叹气。"
        },
        {
            "id": "690740309",
            "speaker": "莱依拉",
            "text": "但是打开门一看，明明房间里没有亮光，也没有人。"
        },
        {
            "id": "690740310",
            "speaker": "莱依拉",
            "text": "这种情况隔上三五天就发生一次，而且碰到过它的人，下次考试一定会考砸。",
            "choices": [
                {
                    "id": "690740311",
                    "text": "真的假的？",
                    "response": [
                        {
                            "id": "690740313",
                            "speaker": "莱依拉",
                            "text": "欸，你不相信吗？我周围的同学里还是相信的人居多。"
                        },
                        {
                            "id": "690740314",
                            "speaker": "莱依拉",
                            "text": "就算是不相信的，碰到那间研究室大多也会绕着走。"
                        },
                        {
                            "id": "690740315",
                            "speaker": "莱依拉",
                            "text": "毕竟，大家都不想自己的考试运受到什么影响嘛。"
                        }
                    ]
                },
                {
                    "id": "690740312",
                    "text": "感觉是迷信…"
                }
            ]
        }
    ]
}