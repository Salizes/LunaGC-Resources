{
    "talkId": "7081001",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "维克多": 16
    },
    "dialogues": [
        {
            "id": "708100101",
            "speaker": "维克多",
            "text": "旅行者，又见面了，有空的话，来帮我个忙怎么样？报酬绝不会亏你的。",
            "choices": [
                {
                    "id": "708100102",
                    "text": "你们怎么还在蒙德城里？",
                    "response": [
                        {
                            "id": "708100103",
                            "speaker": "维克多",
                            "text": "你这话说的，我又没有做什么，我在这里呆着怎么了？"
                        },
                        {
                            "id": "708100104",
                            "speaker": "维克多",
                            "text": "啊？你说歌德大酒店里面的那些先生？那…我就不知道了，那不在我的职权范围内。"
                        },
                        {
                            "id": "708100107",
                            "speaker": "维克多",
                            "text": "行了行了，说正事，你们蒙德的人就喜欢啰啰嗦嗦，做事也拖拖拉拉的…"
                        },
                        {
                            "id": "708100108",
                            "speaker": "维克多",
                            "text": "上次我俩的交易你还记得吧？你帮我办事，我给你讲点你想要的情报。"
                        },
                        {
                            "id": "708100109",
                            "speaker": "维克多",
                            "text": "这次也一样，你去帮我置办点蒙德城的特产回来，我再给你讲点「小故事」，怎么样？",
                            "choices": [
                                {
                                    "id": "708100110",
                                    "text": "什么样的「小故事」？",
                                    "response": [
                                        {
                                            "id": "708100111",
                                            "speaker": "维克多",
                                            "text": "哼，你帮我去把东西置办好了，我再告诉你…反正不会让你吃亏的。"
                                        },
                                        {
                                            "id": "708100112",
                                            "speaker": "维克多",
                                            "text": "你就放心吧，咱们愚人众说到做到。"
                                        },
                                        {
                                            "id": "708100119",
                                            "speaker": "维克多",
                                            "text": "好了好了，这件事就拜托你了啊，快点去吧，我就在教堂里面等着你。"
                                        },
                                        {
                                            "id": "708100120",
                                            "speaker": "维克多",
                                            "text": "唉，就想买点东西，搞得和我是要去犯罪一样，真是…"
                                        }
                                    ]
                                },
                                {
                                    "id": "708100113",
                                    "text": "你买特产干什么？",
                                    "response": [
                                        {
                                            "id": "708100114",
                                            "speaker": "维克多",
                                            "text": "你能不能不要…不要这么警惕，我好不容易来蒙德城一趟，总得买点什么吧？"
                                        },
                                        {
                                            "id": "708100115",
                                            "speaker": "维克多",
                                            "text": "而且，蒙德城对咱们愚人众的态度是越来越苛刻，说不定什么时候咱们就要回至冬国去了。"
                                        },
                                        {
                                            "id": "708100116",
                                            "speaker": "维克多",
                                            "text": "提前买点特产备着，到时候也好带回去啊，这有什么问题？"
                                        },
                                        {
                                            "id": "708100117",
                                            "speaker": "维克多",
                                            "text": "我是不熟蒙德城，也不知道什么特产好，你在蒙德城东奔西跑这么久，肯定比我了解，"
                                        },
                                        {
                                            "id": "708100118",
                                            "speaker": "维克多",
                                            "text": "我这才想让你帮忙，买点特产而已，我又不是想去犯罪…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "708100105",
                    "text": "你又想要做什么？",
                    "response": [
                        {
                            "id": "708100106",
                            "speaker": "维克多",
                            "text": "我说，你怎么对我这么大意见，我也没对你做什么吧？上次的交易，我俩不挺愉快的吗？"
                        }
                    ]
                }
            ]
        }
    ]
}