    "dialogues": [
        {
            "id": "400480108",
            "speaker": "Player",
            "text": "关于千灯…"
        },
        {
            "id": "400480109",
            "speaker": "阿祇",
            "text": "千灯的仪式以前被人们拿来驱逐龙蜥。这是人界力量和龙蜥界力量的对抗。"
        },
        {
            "id": "400480110",
            "speaker": "阿祇",
            "text": "这个灯塔修好之后，千灯仪式就用得少了。不过作为人界秘法，对抗虚界黑雾也很有效果。"
        }
    ]
}