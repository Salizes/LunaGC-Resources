{
    "talkId": "6912102",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "爱诺": 11
    },
    "dialogues": [
        {
            "id": "691210201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691210202",
            "speaker": "爱诺",
            "text": "嗯…刚刚阿圆陪我聊了一会儿天。"
        },
        {
            "id": "691210203",
            "speaker": "爱诺",
            "text": "她的全名比「轰隆隆月矩力能量炮」难记多了，「真君」什么的，我也不是很理解其中的意思。"
        },
        {
            "id": "691210204",
            "speaker": "Player",
            "text": "她是璃月仙人的一员。"
        },
        {
            "id": "691210205",
            "speaker": "爱诺",
            "text": "啊…总之是那种用科学和机械原理解释不清的群体对吧？"
        },
        {
            "id": "691210206",
            "speaker": "爱诺",
            "text": "没想到一离开挪德卡莱，这样的情况反倒更多了啊。"
        },
        {
            "id": "691210207",
            "speaker": "爱诺",
            "text": "我听她说，在这里造东西很容易，有图纸就行。"
        },
        {
            "id": "691210208",
            "speaker": "爱诺",
            "text": "于是我翻出下一件打算制作的大型机械设计图，拿出我随身带的工具和零件，刚准备开工…她却说用不上这些。"
        },
        {
            "id": "691210209",
            "speaker": "Player",
            "text": "的确是要靠仙术…"
        },
        {
            "id": "691210210",
            "speaker": "爱诺",
            "text": "所以啊，说是说容易，但其实完全不是我擅长的领域！根本就没有发挥空间嘛…",
            "choices": [
                {
                    "id": "691210211",
                    "text": "没事，爱诺来提要求就好。",
                    "response": [
                        {
                            "id": "691210213",
                            "speaker": "爱诺",
                            "text": "唉…好吧！"
                        },
                        {
                            "id": "691210214",
                            "speaker": "爱诺",
                            "text": "虽然还是有一点点不甘心，但毕竟在这里我才是客人，得遵守做客时的礼仪…"
                        },
                        {
                            "id": "691210215",
                            "speaker": "爱诺",
                            "text": "那…就麻烦你先造一台蛋卷机？"
                        },
                        {
                            "id": "691210216",
                            "speaker": "爱诺",
                            "text": "至少我们可以先吃起来！"
                        }
                    ]
                },
                {
                    "id": "691210212",
                    "text": "制作就交给我来吧。"
                }
            ]
        }
    ]
}