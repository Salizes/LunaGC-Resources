{
    "talkId": "6500402",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "伊莎朵": 3,
        "杰柯艾妲": 4
    },
    "dialogues": [
        {
            "id": "650040201",
            "speaker": "杰柯艾妲",
            "text": "我就不懂了，那俩领导明明就坐在一个办公室里，还是前后桌，怎么下达的意见还能不一样的？"
        },
        {
            "id": "650040202",
            "speaker": "伊莎朵",
            "text": "感觉是缺乏沟通吧…"
        },
        {
            "id": "650040203",
            "speaker": "杰柯艾妲",
            "text": "而且每次去签字都找不到人，要不就是找到了一个又让我问另一个的意见，你们自己不能先统一一下吗？"
        },
        {
            "id": "650040204",
            "speaker": "伊莎朵",
            "text": "那就是关系不好吧…"
        },
        {
            "id": "650040205",
            "speaker": "杰柯艾妲",
            "text": "最近各地关于涨水后的重建和修复工作也变多了。"
        },
        {
            "id": "650040206",
            "speaker": "杰柯艾妲",
            "text": "一旦发现自己没有溶解的兴奋劲过去后，实际需要解决的问题就浮出水面了…"
        },
        {
            "id": "650040207",
            "speaker": "伊莎朵",
            "text": "嗯，说的也是…"
        }
    ]
}