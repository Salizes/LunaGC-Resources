{
    "talkId": "6990049",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 7,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699004901",
            "speaker": "Player",
            "text": "关于沃陆之邦与花羽会…"
        },
        {
            "id": "699004902",
            "speaker": "派蒙",
            "text": "听说沃陆之邦的人们都很健壮。",
            "choices": [
                {
                    "id": "699004903",
                    "text": "那假如把派蒙放在那里…",
                    "response": [
                        {
                            "id": "699004905",
                            "speaker": "派蒙",
                            "text": "我才不要变成那个样子啦！",
                            "choices": [
                                {
                                    "id": "699004906",
                                    "text": "那放在花羽会怎么样，他们很擅长飞行…",
                                    "response": [
                                        {
                                            "id": "699004908",
                                            "speaker": "派蒙",
                                            "text": "欸，飞行不就是咻——的一下就好了，还需要什么技巧吗？"
                                        },
                                        {
                                            "id": "699004909",
                                            "speaker": "Player",
                                            "text": "我只要求派蒙能带着我飞起来就好。"
                                        },
                                        {
                                            "id": "699004910",
                                            "speaker": "派蒙",
                                            "text": "差太多了吧！怎么想都不可能吧！"
                                        },
                                        {
                                            "id": "699004911",
                                            "speaker": "Player",
                                            "text": "那你先变成肌肉派蒙不就好了。"
                                        },
                                        {
                                            "id": "699004912",
                                            "speaker": "派蒙",
                                            "text": "喂！说到底你就是想看肌肉吧！"
                                        }
                                    ]
                                },
                                {
                                    "id": "699004907",
                                    "text": "说不定可以帮忙提升派蒙的飞行技巧呢。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699004904",
                    "text": "会不会变成肌肉派蒙呢？"
                }
            ]
        }
    ]
}