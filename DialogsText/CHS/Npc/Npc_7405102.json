{
    "talkId": "7405102",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "兴晔": 3,
        "弈丰": 4,
        "邱老板": 9
    },
    "dialogues": [
        {
            "id": "740510201",
            "speaker": "兴晔",
            "text": "老板，这下可怎么办？映影没拍好，映影机还丢了…"
        },
        {
            "id": "740510202",
            "speaker": "邱老板",
            "text": "行了，别唉声叹气的。咱们不是已经去冒险家协会挂过委托了吗？"
        },
        {
            "id": "740510203",
            "speaker": "邱老板",
            "text": "为今之计，只有一个等字…"
        },
        {
            "id": "740510204",
            "speaker": "弈丰",
            "text": "但是，咱们拍了一半的映影片还在机器里。"
        },
        {
            "id": "740510205",
            "speaker": "弈丰",
            "text": "就算机器不容易坏，但要是那些片子被弄坏了…"
        },
        {
            "id": "740510206",
            "speaker": "邱老板",
            "text": "这…",
            "choices": [
                {
                    "id": "740510207",
                    "text": "什么映影机？",
                    "response": [
                        {
                            "id": "740510208",
                            "speaker": "邱老板",
                            "text": "瞧！这不就来了吗？我就说嘛，要沉下心来等！"
                        },
                        {
                            "id": "740510221",
                            "speaker": "弈丰",
                            "text": "冒险家协会的效率，什么时候这么高了？"
                        },
                        {
                            "id": "740510209",
                            "speaker": "兴晔",
                            "text": "唔，看来枫丹人办事也不都是磨磨蹭蹭的嘛。"
                        },
                        {
                            "id": "740510210",
                            "speaker": "邱老板",
                            "text": "您好，您好，冒险家。您一定是接到了协会的委托，来帮助我们拿回映影机的吧？"
                        },
                        {
                            "id": "740510211",
                            "speaker": "邱老板",
                            "text": "我们就是在那边被魔物袭击的，请您快点…",
                            "choices": [
                                {
                                    "id": "740510212",
                                    "text": "我什么委托也没接到啊。",
                                    "response": [
                                        {
                                            "id": "740510214",
                                            "speaker": "兴晔",
                                            "text": "呃…"
                                        },
                                        {
                                            "id": "740510215",
                                            "speaker": "弈丰",
                                            "text": "这…"
                                        },
                                        {
                                            "id": "740510216",
                                            "speaker": "邱老板",
                                            "text": "没…关系！没关系，我就知道冒险家协会不靠谱…"
                                        },
                                        {
                                            "id": "740510217",
                                            "speaker": "邱老板",
                                            "text": "冒险家，你现在愿意临时接受一个委托吗？报酬都好说。",
                                            "choices": [
                                                {
                                                    "id": "740510218",
                                                    "text": "倒是没问题…",
                                                    "response": [
                                                        {
                                                            "id": "740510220",
                                                            "speaker": "邱老板",
                                                            "text": "好！太好了，请您快点去那边帮我们拿回映影机，拜托您了！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "740510219",
                                                    "text": "报酬给足就行。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "740510213",
                                    "text": "我只是刚好路过这里而已。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "740510222",
                    "text": "发生什么了？"
                }
            ]
        }
    ]
}