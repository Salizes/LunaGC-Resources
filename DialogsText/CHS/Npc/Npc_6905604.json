{
    "talkId": "6905604",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "九条裟罗": 17
    },
    "dialogues": [
        {
            "id": "690560401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690560402",
            "speaker": "九条裟罗",
            "text": "从小到大，我已经习惯了一个人做各种事情了…"
        },
        {
            "id": "690560403",
            "speaker": "九条裟罗",
            "text": "我曾经有过养宠物的念头，但因为种种原因，最后还是不了了之…"
        },
        {
            "id": "690560404",
            "speaker": "Player",
            "text": "想养什么宠物？"
        },
        {
            "id": "690560405",
            "speaker": "九条裟罗",
            "text": "没有想过具体的种类。只是「想要一个玩伴」罢了。"
        },
        {
            "id": "690560406",
            "speaker": "九条裟罗",
            "text": "奉行所里人多事杂，我经常又要外出执行任务…"
        },
        {
            "id": "690560407",
            "speaker": "九条裟罗",
            "text": "每当想到这些，我就能断定我肯定没有时间陪宠物玩，所以还是算了。"
        },
        {
            "id": "690560408",
            "speaker": "九条裟罗",
            "text": "缺少陪伴的成长是不会快乐的，宠物也是，人也是，天狗也是…"
        },
        {
            "id": "690560409",
            "speaker": "Player",
            "text": "现在就可以养，养在这吧？"
        },
        {
            "id": "690560410",
            "speaker": "九条裟罗",
            "text": "哈哈…说得也对。"
        },
        {
            "id": "690560411",
            "speaker": "九条裟罗",
            "text": "既然要养在这里，当然也要征询你的意见，你觉得养什么好呢？"
        },
        {
            "id": "690560412",
            "speaker": "九条裟罗",
            "text": "红角蜥怎么样？总是形单影只，不需要人陪。",
            "choices": [
                {
                    "id": "690560413",
                    "text": "还是养猫吧…",
                    "response": [
                        {
                            "id": "690560414",
                            "speaker": "九条裟罗",
                            "text": "猫吗…猫的话，我该怎么区分它们心情的好坏？"
                        },
                        {
                            "id": "690560417",
                            "speaker": "九条裟罗",
                            "text": "我没有什么经验，不知道能不能胜任「主人」这个身份。"
                        },
                        {
                            "id": "690560418",
                            "speaker": "九条裟罗",
                            "text": "但既然这是你我共同做下的决定，你也要尽好你的责任才是。"
                        },
                        {
                            "id": "690560419",
                            "speaker": "九条裟罗",
                            "text": "呼…为了体谅你，我可以承担最难的部分，也就是陪伴。"
                        },
                        {
                            "id": "690560420",
                            "speaker": "Player",
                            "text": "意思就是我…"
                        },
                        {
                            "id": "690560421",
                            "speaker": "九条裟罗",
                            "text": "没错，你只需要把最基础的喂食和清洁工作做好就行了。"
                        },
                        {
                            "id": "690560422",
                            "speaker": "九条裟罗",
                            "text": "啊，在此之前，得给它取个有纪念意义的名字…"
                        },
                        {
                            "id": "690560423",
                            "speaker": "九条裟罗",
                            "text": "不用着急，有想法的时候我们再一起商量也不迟。"
                        }
                    ]
                },
                {
                    "id": "690560415",
                    "text": "还是养狗吧…",
                    "response": [
                        {
                            "id": "690560416",
                            "speaker": "九条裟罗",
                            "text": "狗吗…好像观察尾巴就能知道它们的想法了吧？"
                        }
                    ]
                }
            ]
        }
    ]
}