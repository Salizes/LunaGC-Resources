{
    "talkId": "6903603",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "重云": 15
    },
    "dialogues": [
        {
            "id": "690360301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690360302",
            "speaker": "重云",
            "text": "好。我恰巧遇到了一些愤慨之事…"
        },
        {
            "id": "690360303",
            "speaker": "重云",
            "text": "是这样的。不久前我听人说起有一本书，叫做《恶鬼奇谭录》，就花了重金将其买下。"
        },
        {
            "id": "690360304",
            "speaker": "重云",
            "text": "结果哪里想到，这本书通篇都是在描写一个丧尽天良的大恶人！"
        },
        {
            "id": "690360305",
            "speaker": "重云",
            "text": "我实在是…难以克制心中的怒火！"
        },
        {
            "id": "690360306",
            "speaker": "重云",
            "text": "花了半天功夫才把这股气血压制下去。",
            "choices": [
                {
                    "id": "690360307",
                    "text": "是啊，这不是文不对题嘛！",
                    "response": [
                        {
                            "id": "690360308",
                            "speaker": "重云",
                            "text": "文不对题？…我不是在乎这个。"
                        },
                        {
                            "id": "690360311",
                            "speaker": "重云",
                            "text": "让我生气的是…这天底下怎么会有这么无恶不作的人！"
                        },
                        {
                            "id": "690360312",
                            "speaker": "重云",
                            "text": "如果让我遇到了，我一定会…"
                        },
                        {
                            "id": "690360313",
                            "speaker": "重云",
                            "text": "呼…呼…冷静，冷静。"
                        },
                        {
                            "id": "690360314",
                            "speaker": "Player",
                            "text": "书里的情节一般是作者编出来的…"
                        },
                        {
                            "id": "690360315",
                            "speaker": "重云",
                            "text": "你的意思是…这不是真人真事？"
                        },
                        {
                            "id": "690360316",
                            "speaker": "重云",
                            "text": "可是它的情节跌宕起伏，就好像发生在眼前一样！"
                        },
                        {
                            "id": "690360317",
                            "speaker": "重云",
                            "text": "……"
                        },
                        {
                            "id": "690360318",
                            "speaker": "重云",
                            "text": "难道说…是我错误地相信了…",
                            "choices": [
                                {
                                    "id": "690360319",
                                    "text": "没事的，说明作者写得好…",
                                    "response": [
                                        {
                                            "id": "690360321",
                                            "speaker": "重云",
                                            "text": "对不起…让你看笑话了…"
                                        }
                                    ]
                                },
                                {
                                    "id": "690360320",
                                    "text": "这也是常有的事情。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690360309",
                    "text": "我去说清来由，帮你退货。",
                    "response": [
                        {
                            "id": "690360310",
                            "speaker": "重云",
                            "text": "不是的。不是钱的问题…"
                        }
                    ]
                }
            ]
        }
    ]
}