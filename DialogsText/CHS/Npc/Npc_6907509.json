{
    "talkId": "6907509",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "Wanderer": 11
    },
    "dialogues": [
        {
            "id": "690750201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690750202",
            "speaker": "Wanderer",
            "text": "……",
            "choices": [
                {
                    "id": "690750203",
                    "text": "怎、怎么了？",
                    "response": [
                        {
                            "id": "690750204",
                            "speaker": "Wanderer",
                            "text": "你才是这里的主人吧，紧张什么呢，不像样。"
                        },
                        {
                            "id": "690750207",
                            "speaker": "Wanderer",
                            "text": "…也没什么，只是在思考无聊的问题。"
                        },
                        {
                            "id": "690750208",
                            "speaker": "Wanderer",
                            "text": "你这个…住处，怎么有的地方空旷得很哪。",
                            "choices": [
                                {
                                    "id": "690750209",
                                    "text": "够用了，这是留白的美。",
                                    "response": [
                                        {
                                            "id": "690750210",
                                            "speaker": "Wanderer",
                                            "text": "随意评论主人的生活风格是不礼貌的。"
                                        },
                                        {
                                            "id": "690750211",
                                            "speaker": "Wanderer",
                                            "text": "你好心招待我来，我自当感激不尽。"
                                        },
                                        {
                                            "id": "690750215",
                                            "speaker": "Wanderer",
                                            "text": "这是你的地盘，按你高兴的方式安排吧。"
                                        },
                                        {
                                            "id": "690750216",
                                            "speaker": "Wanderer",
                                            "text": "我只是过客。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690750212",
                                    "text": "没办法，我也想塞满点的。",
                                    "response": [
                                        {
                                            "id": "690750213",
                                            "speaker": "Wanderer",
                                            "text": "啊，我懂，总有力不能及的事情嘛。"
                                        },
                                        {
                                            "id": "690750214",
                                            "speaker": "Wanderer",
                                            "text": "有时情况会慢慢变好，有时也只能保持现状。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690750205",
                    "text": "有话直说。",
                    "response": [
                        {
                            "id": "690750206",
                            "speaker": "Wanderer",
                            "text": "哼。"
                        }
                    ]
                }
            ]
        }
    ]
}