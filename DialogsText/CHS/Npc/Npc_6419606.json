    "dialogues": [
        {
            "id": "641960601",
            "speaker": "Player",
            "text": "你在想什么？"
        },
        {
            "id": "641960602",
            "speaker": "兰伊舍",
            "text": "#啊，是聪明的那菈{NICKNAME}。"
        },
        {
            "id": "641960603",
            "speaker": "兰伊舍",
            "text": "#无忧节的时候，那菈{NICKNAME}猜中了兰伊舍的所有的好吃的谜语。"
        },
        {
            "id": "641960604",
            "speaker": "兰伊舍",
            "text": "兰伊舍的谜语不够吃了。"
        },
        {
            "id": "641960605",
            "speaker": "兰伊舍",
            "text": "#那菈{NICKNAME}猜谜这么厉害，一定是因为那菈们的谜题都很鲜嫩吧。"
        }
    ]
