        {
            "id": "630890701",
            "speaker": "Player",
            "text": "进驻许可证？"
        },
        {
            "id": "630890702",
            "speaker": "百合华",
            "text": "根据稻妻现行的规定，异国的商人如果想在离岛长期开店售货，需要办理进驻许可哦。"
        },
        {
            "id": "630890703",
            "speaker": "百合华",
            "text": "在办理这类手续之前，请事先准备好身份登记证明…以及其他所需的「材料」。"
        }
    ]
}