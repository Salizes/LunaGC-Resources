        "Player": 1,
        "玥文": 4
    },
    "dialogues": [
        {
            "id": "739520101",
            "speaker": "Player",
            "text": "要定居吗？"
        },
        {
            "id": "739520102",
            "speaker": "玥文",
            "text": "我也在思考这个问题。"
        },
        {
            "id": "739520103",
            "speaker": "玥文",
            "text": "似乎是因为以前忙惯了，我身上那股勤劳的血液正催促着我赶紧去干活…"
        },
        {
            "id": "739520104",
            "speaker": "玥文",
            "text": "但我听村民们讲，须弥有句古话：「巧思才能得真知。」"
        },
        {
            "id": "739520105",
            "speaker": "玥文",
            "text": "没准，换个想法、换种生活，才更适合我呢？"
        }
    ]
}