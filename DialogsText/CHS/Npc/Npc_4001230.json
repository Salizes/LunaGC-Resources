    "dialogues": [
        {
            "id": "400123001",
            "speaker": "迪卢克",
            "text": "这么晚一个人在海边闲逛，看起来有些寂寞啊。",
            "choices": [
                {
                    "id": "400123002",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400123003",
                            "speaker": "迪卢克",
                            "text": "好啊。",
                            "choices": [
                                {
                                    "id": "400123004",
                                    "text": "关于奇怪的信…",
                                    "response": [
                                        {
                                            "id": "400123005",
                                            "speaker": "迪卢克",
                                            "text": "我从一开始就对那封信持怀疑态度。"
                                        },
                                        {
                                            "id": "400123006",
                                            "speaker": "迪卢克",
                                            "text": "但慎重起见，我找其他人打听了一番。果然，收信人不止我一个。"
                                        },
                                        {
                                            "id": "400123007",
                                            "speaker": "迪卢克",
                                            "text": "显然，这是一次有预谋的行动。对方的目的尚未浮出水面，我来海岛就是想查清这一点。"
                                        },
                                        {
                                            "id": "400123008",
                                            "speaker": "迪卢克",
                                            "text": "有我在，你可以放心。",
                                            "choices": [
                                                {
                                                    "id": "400123004",
                                                    "text": "关于奇怪的信…"
                                                },
                                                {
                                                    "id": "400123013",
                                                    "text": "关于迪卢克自己…",
                                                    "response": [
                                                        {
                                                            "id": "400123014",
                                                            "speaker": "迪卢克",
                                                            "text": "我？我的事，好像不值得讨论吧。"
                                                        },
                                                        {
                                                            "id": "400123015",
                                                            "speaker": "迪卢克",
                                                            "text": "相比起来，我还比较担心你的状况。"
                                                        },
                                                        {
                                                            "id": "400123016",
                                                            "speaker": "迪卢克",
                                                            "text": "如何？对海岛生活还习惯吗？"
                                                        },
                                                        {
                                                            "id": "400123017",
                                                            "speaker": "Player",
                                                            "text": "还好。"
                                                        },
                                                        {
                                                            "id": "400123018",
                                                            "speaker": "迪卢克",
                                                            "text": "嗯。如果你需要帮助，随时找我。"
                                                        },
                                                        {
                                                            "id": "400123019",
                                                            "speaker": "迪卢克",
                                                            "text": "有任何线索，也记得及时联系我。"
                                                        },
                                                        {
                                                            "id": "400123020",
                                                            "speaker": "迪卢克",
                                                            "text": "说起来…刚刚可莉让我帮她抓几条鱼。你愿意的话，就一起来吧。",
                                                            "choices": [
                                                                {
                                                                    "id": "400123004",
                                                                    "text": "关于奇怪的信…"
                                                                },
                                                                {
                                                                    "id": "400123013",
                                                                    "text": "关于迪卢克自己…"
                                                                },
                                                                {
                                                                    "id": "400123021",
                                                                    "text": "关于今天发生的事…",
                                                                    "response": [
                                                                        {
                                                                            "id": "400123022",
                                                                            "speaker": "迪卢克",
                                                                            "text": "今天？…噢，你是说那件事啊。"
                                                                        },
                                                                        {
                                                                            "id": "400123023",
                                                                            "speaker": "迪卢克",
                                                                            "text": "无趣的事，不值得你多留意。"
                                                                        },
                                                                        {
                                                                            "id": "400123024",
                                                                            "speaker": "迪卢克",
                                                                            "text": "凯亚那家伙…哼，我看他兴致很高啊。"
                                                                        },
                                                                        {
                                                                            "id": "400123025",
                                                                            "speaker": "迪卢克",
                                                                            "text": "都那么多年了，居然还像小时候一样喜欢夏天。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "400123004",
                                                                                    "text": "关于奇怪的信…"
                                                                                },
                                                                                {
                                                                                    "id": "400123013",
                                                                                    "text": "关于迪卢克自己…"
                                                                                },
                                                                                {
                                                                                    "id": "400123021",
                                                                                    "text": "关于今天发生的事…"
                                                                                },
                                                                                {
                                                                                    "id": "400123026",
                                                                                    "text": "先不打扰你了。",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "400123027",
                                                                                            "speaker": "迪卢克",
                                                                                            "text": "晚安，早点休息。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "400123026",
                                                                    "text": "先不打扰你了。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "400123021",
                                                    "text": "关于今天发生的事…"
                                                },
                                                {
                                                    "id": "400123026",
                                                    "text": "先不打扰你了。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "400123013",
                                    "text": "关于迪卢克自己…"
                                },
                                {
                                    "id": "400123021",
                                    "text": "关于今天发生的事…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400123026",
                    "text": "先不打扰你了。"
                }
            ]
        }
