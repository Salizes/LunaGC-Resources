{
    "talkId": "4008120",
    "total_dialogue_lines": 32,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 8,
        "风速枣椰": 19
    },
    "dialogues": [
        {
            "id": "400812001",
            "speaker": "风速枣椰",
            "text": "啊哈！这次通过训练的速度更快了，好极了好极了！",
            "choices": [
                {
                    "id": "400812002",
                    "text": "你是？",
                    "response": [
                        {
                            "id": "400812003",
                            "speaker": "风速枣椰",
                            "text": "你们也是参加月莲杯大赛的选手？居然还不认识本小姐…"
                        },
                        {
                            "id": "400812004",
                            "speaker": "风速枣椰",
                            "text": "呆头呆脑的外乡人，还有一只飞行白蘑菇…噗嗤…看起来好弱！"
                        },
                        {
                            "id": "400812005",
                            "speaker": "风速枣椰",
                            "text": "等等，好像也不是蘑菇啊…不过没什么差别啦。"
                        },
                        {
                            "id": "400812006",
                            "speaker": "Player",
                            "text": "派蒙也变成蘑菇伙伴了。"
                        },
                        {
                            "id": "400812007",
                            "speaker": "派蒙",
                            "text": "重点不在这里啦，这个家伙好狂啊！"
                        },
                        {
                            "id": "400812008",
                            "speaker": "风速枣椰",
                            "text": "什么叫狂？明明是强者的气势！"
                        },
                        {
                            "id": "400812009",
                            "speaker": "风速枣椰",
                            "text": "我「风速枣椰」可是「枣椰帮」第一个成为大人的大姐头！小弟们可是一直很崇拜我的！"
                        },
                        {
                            "id": "400812010",
                            "speaker": "风速枣椰",
                            "text": "干活挣钱最快，念书最快，跑得最快，大家全都跟在我后面…"
                        },
                        {
                            "id": "400812011",
                            "speaker": "Player",
                            "text": "吃枣椰也最快吗？"
                        },
                        {
                            "id": "400812012",
                            "speaker": "风速枣椰",
                            "text": "没错！小弟们都说我吃枣椰的速度就像雨林里的风！如果有什么「吃枣椰大胃王比赛」，我喝两缸水再上都能拿冠军！"
                        },
                        {
                            "id": "400812013",
                            "speaker": "派蒙",
                            "text": "哈哈，真是个好懂的称号，我看呆头呆脑的是你才对！"
                        },
                        {
                            "id": "400812014",
                            "speaker": "风速枣椰",
                            "text": "你！我记住你了，飞行白蘑菇！要是被我哗哗两下就打败了，可不要哭哦！"
                        },
                        {
                            "id": "400812015",
                            "speaker": "风速枣椰",
                            "text": "不过，说不定到时候我已经把你们忘了呢，毕竟有那么多人参加比赛，你们实在太不起眼了！"
                        },
                        {
                            "id": "400812016",
                            "speaker": "风速枣椰",
                            "text": "还是祈祷不要碰上我「风速枣椰」吧，不然可是会被我的蕈兽们打得满地找牙的哦。"
                        },
                        {
                            "id": "400812017",
                            "speaker": "派蒙",
                            "text": "好生气！果然我们应该报上那两个响亮的称号来的！"
                        }
                    ]
                },
                {
                    "id": "400812018",
                    "text": "速度？",
                    "response": [
                        {
                            "id": "400812019",
                            "speaker": "风速枣椰",
                            "text": "没错，我已经和蕈兽们找到了一套绝对无敌的速攻打法！"
                        },
                        {
                            "id": "400812020",
                            "speaker": "风速枣椰",
                            "text": "只要命令蕈兽们呼啦一下攻上去，对手就招架不住的！"
                        },
                        {
                            "id": "400812021",
                            "speaker": "派蒙",
                            "text": "唔，感觉是完全不经思考的打法呢。"
                        },
                        {
                            "id": "400812022",
                            "speaker": "派蒙",
                            "text": "那要是两边的实力相差很多，不就会被一下子都打败了吗？"
                        },
                        {
                            "id": "400812023",
                            "speaker": "风速枣椰",
                            "text": "你，你胡说什么！大家的蕈兽都是差不多强的，肯定是谁更快谁就赢！"
                        },
                        {
                            "id": "400812024",
                            "speaker": "风速枣椰",
                            "text": "一下子打败和自己差不多的四个对手，这种事只可能出现在哄小孩的故事里！"
                        },
                        {
                            "id": "400812025",
                            "speaker": "风速枣椰",
                            "text": "飞行白蘑菇，你不信的话，下次就尽管试试看吧。"
                        },
                        {
                            "id": "400812026",
                            "speaker": "风速枣椰",
                            "text": "反正你们都会变成我成为冠军路上的…经验书！"
                        },
                        {
                            "id": "400812027",
                            "speaker": "派蒙",
                            "text": "参赛选手有那么多，我们也不一定记得住你！"
                        },
                        {
                            "id": "400812028",
                            "speaker": "派蒙",
                            "text": "而且打败你又没有什么好处…完全提不起干劲…"
                        },
                        {
                            "id": "400812029",
                            "speaker": "风速枣椰",
                            "text": "呵！虽然只是假设，如果你们真的打败了我，我也会认可你们，给你一份帮里最好吃的枣椰蜜糖！"
                        },
                        {
                            "id": "400812030",
                            "speaker": "派蒙",
                            "text": "欸？最好吃的枣椰蜜糖？会是什么味道的呢…"
                        }
                    ]
                },
                {
                    "id": "400812031",
                    "text": "注意安全…",
                    "response": [
                        {
                            "id": "400812032",
                            "speaker": "风速枣椰",
                            "text": "哼，你们才是，小心别受伤哦！"
                        }
                    ]
                }
            ]
        }
    ]
}