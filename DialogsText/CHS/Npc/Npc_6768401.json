{
    "talkId": "6768401",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "涅朵奇卡": 11
    },
    "dialogues": [
        {
            "id": "676840101",
            "speaker": "涅朵奇卡",
            "text": "卡嘉的手艺真不错…还是晚些再回新基捷城好了。",
            "choices": [
                {
                    "id": "676840102",
                    "text": "关于新基捷城…",
                    "response": [
                        {
                            "id": "676840103",
                            "speaker": "涅朵奇卡",
                            "text": "在那儿生活的时候时常觉得憋闷，可一旦离开了又有些想念…这还是我第一次离家这么远呢。"
                        },
                        {
                            "id": "676840104",
                            "speaker": "涅朵奇卡",
                            "text": "我原本以为其他地方也和新基捷城一样生活着很多妖精呢，就算是至冬堡也有不少妖精嘛。"
                        },
                        {
                            "id": "676840105",
                            "speaker": "涅朵奇卡",
                            "text": "结果到了挪德卡莱，根本一个也没见到，派蒙也说自己不是。应该不是因为他们不喜欢这里的气候吧…"
                        },
                        {
                            "id": "676840106",
                            "speaker": "涅朵奇卡",
                            "text": "毕竟这里都没有暴风雪，在野外也不会因为没有炉子就寸步难行。"
                        },
                        {
                            "id": "676840107",
                            "speaker": "涅朵奇卡",
                            "text": "对了，我在挪德卡莱看到有人在喝新基捷城产的酒呢，虽说知道酒业和矿业一样出名，不过在这里看到还是有点…感动？"
                        }
                    ]
                },
                {
                    "id": "676840108",
                    "text": "关于拉斯科尔尼科夫…",
                    "response": [
                        {
                            "id": "676840109",
                            "speaker": "涅朵奇卡",
                            "text": "他啊，他以前就是最优秀，也是父亲最喜欢的学生。现在在愚人众也算出人头地了？"
                        },
                        {
                            "id": "676840110",
                            "speaker": "涅朵奇卡",
                            "text": "我曾经也很羡慕他呢，想要成为他那样的人…但不管我怎么努力，也不可能超过他吧。"
                        },
                        {
                            "id": "676840111",
                            "speaker": "涅朵奇卡",
                            "text": "唔，不过之前一直以为他根本没把我放在眼里，但这次却能感觉到他的敌意，到底是为什么呢？"
                        },
                        {
                            "id": "676840112",
                            "speaker": "涅朵奇卡",
                            "text": "还有，他说我「傲慢」…完全没有头绪。"
                        }
                    ]
                },
                {
                    "id": "676840113",
                    "text": "下次见！",
                    "response": [
                        {
                            "id": "676840114",
                            "speaker": "涅朵奇卡",
                            "text": "嗯！在那之前，祝你和我都好运！"
                        }
                    ]
                }
            ]
        }
    ]
}