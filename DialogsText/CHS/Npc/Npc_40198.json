    "dialogues": [
        {
            "id": "4015146961",
            "speaker": "艾尔菲",
            "text": "风声似乎有点大，请大声一点说话哦。",
            "choices": [
                {
                    "id": "4015146962",
                    "text": "我想要调整队伍成员。",
                    "response": [
                        {
                            "id": "4015146963",
                            "speaker": "Player",
                            "text": "在这样的天气下吗…简直像是天生的冒险家一样呢~！"
                        },
                        {
                            "id": "4015146964",
                            "speaker": "艾尔菲",
                            "text": "没问题，艾尔菲这就为你召集伙伴！"
                        }
                    ]
                },
                {
                    "id": "4015146965",
                    "text": "关于你自己。",
                    "response": [
                        {
                            "id": "4015146967",
                            "speaker": "艾尔菲",
                            "text": "现在不是自我介绍的时候，快点进屋里避难吧。"
                        },
                        {
                            "id": "4015146968",
                            "speaker": "艾尔菲",
                            "text": "我没问题的，作为冒险家，在大风天的室外生存可是基本功呢！"
                        }
                    ]
                },
                {
                    "id": "4015146966",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "4015146969",
                            "speaker": "艾尔菲",
                            "text": "别被大风吹跑了哦~~~~！"
                        }
                    ]
                }
            ]
        }
    ]
}