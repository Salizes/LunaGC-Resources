    "dialogues": [
        {
            "id": "690510201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690510202",
            "speaker": "优菈",
            "text": "哼…这算是什么问题？"
        },
        {
            "id": "690510203",
            "speaker": "优菈",
            "text": "我可不擅长说什么夸奖的话啊。"
        },
        {
            "id": "690510204",
            "speaker": "Player",
            "text": "我只是关心优菈的感受…"
        },
        {
            "id": "690510205",
            "speaker": "优菈",
            "text": "…多此一举。你以为我是很纤细的人吗。"
        },
        {
            "id": "690510206",
            "speaker": "优菈",
            "text": "不好不坏，你要听的话就是这样。",
            "choices": [
                {
                    "id": "690510207",
                    "text": "真的是这样吗？",
                    "response": [
                        {
                            "id": "690510209",
                            "speaker": "优菈",
                            "text": "喂，你这家伙还暗中观察我？"
                        },
                        {
                            "id": "690510210",
                            "speaker": "优菈",
                            "text": "（该死…是我没发现吗？）"
                        },
                        {
                            "id": "690510211",
                            "speaker": "优菈",
                            "text": "总之…这仇…我记下了。"
                        }
                    ]
                },
                {
                    "id": "690510208",
                    "text": "我之前看你明明露出了很温柔的表情…"
                }
            ]
        }
    ]
}