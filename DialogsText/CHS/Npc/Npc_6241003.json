        {
            "id": "624100301",
            "speaker": "Player",
            "text": "不打扰了。"
        },
        {
            "id": "624100302",
            "speaker": "伯桓子",
            "text": "我劝相思应趁早…山月常在，但红颜易消…"
        },
        {
            "id": "624100303",
            "speaker": "伯桓子",
            "text": "我劝少年多壮志…浮萍一生，莫抱憾告老…"
        }
