    "dialogues": [
        {
            "id": "739060101",
            "speaker": "Player",
            "text": "咖喱…"
        },
        {
            "id": "739060102",
            "speaker": "艾莲娜",
            "text": "嗯，咖喱可是须弥人人都会做的美食。"
        },
        {
            "id": "739060103",
            "speaker": "艾莲娜",
            "text": "每家每户搭配香料的方法都不一样，所以咖喱吃起来也有不同的味道。"
        },
        {
            "id": "739060104",
            "speaker": "艾莲娜",
            "text": "但，基本都很好吃啦。"
        },
        {
            "id": "739060105",
            "speaker": "艾莲娜",
            "text": "怎么样，要试试看我家的咖喱不？"
        }
    ]
}