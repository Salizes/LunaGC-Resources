{
    "talkId": "6154702",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "伊尔佳": 8
    },
    "dialogues": [
        {
            "id": "615470201",
            "speaker": "Player",
            "text": "明明是你鬼鬼祟祟的吧？"
        },
        {
            "id": "615470202",
            "speaker": "伊尔佳",
            "text": "说谁鬼鬼祟祟的？"
        },
        {
            "id": "615470203",
            "speaker": "伊尔佳",
            "text": "我是预备传奇冒险家伊尔佳，记住这个名字，因为它马上就要永垂史册了！",
            "choices": [
                {
                    "id": "615470204",
                    "text": "「预备」？",
                    "response": [
                        {
                            "id": "615470205",
                            "speaker": "伊尔佳",
                            "text": "就是…现在还没名气啦，你问那么多干什么！"
                        },
                        {
                            "id": "615470206",
                            "speaker": "伊尔佳",
                            "text": "唉…要是我有「神之眼」就好了，神到底什么时候才会认可我的意志呢？"
                        },
                        {
                            "id": "615470207",
                            "speaker": "伊尔佳",
                            "text": "能运用元素的力量的话，一定能开辟出一条自己的道路吧。"
                        }
                    ]
                },
                {
                    "id": "615470208",
                    "text": "你在做什么？",
                    "response": [
                        {
                            "id": "615470209",
                            "speaker": "伊尔佳",
                            "text": "我正在勘察清泉镇周边的山地，为过去的地理地图做校注。"
                        },
                        {
                            "id": "615470210",
                            "speaker": "伊尔佳",
                            "text": "虽说很多地形经历时代变迁也未改变，但也有一些地方的位置在现存的文献中模糊难辨…"
                        },
                        {
                            "id": "615470211",
                            "speaker": "伊尔佳",
                            "text": "不过等我完成了蒙德地图全校，一定能在全提瓦特成名的！"
                        }
                    ]
                }
            ]
        }
    ]
}