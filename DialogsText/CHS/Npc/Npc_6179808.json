    "dialogues": [
        {
            "id": "617980801",
            "speaker": "Player",
            "text": "练技术？"
        },
        {
            "id": "617980802",
            "speaker": "赫斯塔尔",
            "text": "嗯…对于你这样看起来像是战斗人员的例子而言，就是练习射术了。"
        },
        {
            "id": "617980803",
            "speaker": "赫斯塔尔",
            "text": "优秀的射手都是子弹喂出来的，一天不练，枪法不进则退。"
        },
        {
            "id": "617980804",
            "speaker": "赫斯塔尔",
            "text": "怎么，要不练上一轮，试试手感？"
        }
    ]
}