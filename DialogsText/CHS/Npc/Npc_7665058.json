{
    "talkId": "7665058",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 4,
        "库齐娅": 11
    },
    "dialogues": [
        {
            "id": "766505801",
            "speaker": "库齐娅",
            "text": "月神大人，愿您护佑我们的前路…"
        },
        {
            "id": "766505802",
            "speaker": "库齐娅",
            "text": "…呼，接下来要把雕像周围清理一下才好。"
        },
        {
            "id": "766505803",
            "speaker": "Player",
            "text": "需要帮忙吗？"
        },
        {
            "id": "766505804",
            "speaker": "库齐娅",
            "text": "#您好，{NICKNAME}，谢谢您的好意，但这些事就由我自己来吧。"
        },
        {
            "id": "766505805",
            "speaker": "库齐娅",
            "text": "每次祈祷之后，我都会顺便收拾一下周围，已经成为习惯了。"
        },
        {
            "id": "766505806",
            "speaker": "Player",
            "text": "其他人也会这么做吗？"
        },
        {
            "id": "766505807",
            "speaker": "库齐娅",
            "text": "我并没有特别注意过其他人的举动，但我想，大家也应该和我一样吧。"
        },
        {
            "id": "766505808",
            "speaker": "库齐娅",
            "text": "毕竟，维护月神大人的塑像这一举动，本身的意义也和祈祷相当呢。"
        },
        {
            "id": "766505809",
            "speaker": "库齐娅",
            "text": "#{NICKNAME}，我这里还有一些花，你要和我一起祈祷么？",
            "choices": [
                {
                    "id": "766505810",
                    "text": "好的，一起祈祷吧。",
                    "response": [
                        {
                            "id": "766505811",
                            "speaker": "库齐娅",
                            "text": "嗯，闭上眼，我会领着你一起念诵祈祷词的。"
                        },
                        {
                            "id": "766505812",
                            "speaker": "Black Screen",
                            "text": "和库齐娅一起，进行了虔诚的祈祷…"
                        },
                        {
                            "id": "766505813",
                            "speaker": "库齐娅",
                            "text": "#这样就好了。月神大人一定会听到你的声音，{NICKNAME}。"
                        },
                        {
                            "id": "766505816",
                            "speaker": "库齐娅",
                            "text": "愿月神大人，庇佑您的前路。"
                        }
                    ]
                },
                {
                    "id": "766505814",
                    "text": "现在暂时没空…",
                    "response": [
                        {
                            "id": "766505815",
                            "speaker": "库齐娅",
                            "text": "没关系，您想要祈祷时就过来吧，月神大人会聆听您的声音。"
                        }
                    ]
                }
            ]
        }
    ]
}