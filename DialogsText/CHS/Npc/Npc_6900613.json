{
    "talkId": "6900613",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "丽莎": 14
    },
    "dialogues": [
        {
            "id": "690061301",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690060901",
            "speaker": "丽莎",
            "text": "嗯，我想邀请你一起喝下午茶。"
        },
        {
            "id": "690060902",
            "speaker": "丽莎",
            "text": "日落果茶或者玫瑰花茶，点心呢，喜欢哪种口味的蛋糕？",
            "choices": [
                {
                    "id": "690060903",
                    "text": "难道丽莎是要亲自做？",
                    "response": [
                        {
                            "id": "690060904",
                            "speaker": "丽莎",
                            "text": "哈哈，被你猜对了。"
                        },
                        {
                            "id": "690060908",
                            "speaker": "丽莎",
                            "text": "只要我想做的，没有什么是做不出来的。"
                        },
                        {
                            "id": "690060909",
                            "speaker": "丽莎",
                            "text": "只是…只是…"
                        },
                        {
                            "id": "690060910",
                            "speaker": "丽莎",
                            "text": "多数时间，我会觉得这类事情不值得我多耗费精力而已。"
                        },
                        {
                            "id": "690060911",
                            "speaker": "丽莎",
                            "text": "但你对我而言意义不同。在你身上耗费精力，不需要思考这些。"
                        },
                        {
                            "id": "690060912",
                            "speaker": "丽莎",
                            "text": "唔，还是说，我不应该先问你的喜好…"
                        },
                        {
                            "id": "690060913",
                            "speaker": "丽莎",
                            "text": "而是把它们都做出来，当做一个惊喜？"
                        },
                        {
                            "id": "690060914",
                            "speaker": "Player",
                            "text": "丽莎的心意对我来说已经是一个惊喜了。"
                        },
                        {
                            "id": "690060915",
                            "speaker": "丽莎",
                            "text": "你变得越来越甜了，小可爱。"
                        },
                        {
                            "id": "690060916",
                            "speaker": "丽莎",
                            "text": "那我可要好好准备一下…"
                        },
                        {
                            "id": "690060917",
                            "speaker": "丽莎",
                            "text": "不能被你小瞧了啊…"
                        }
                    ]
                },
                {
                    "id": "690060905",
                    "text": "我都可以。",
                    "response": [
                        {
                            "id": "690060906",
                            "speaker": "丽莎",
                            "text": "和不挑剔的你相处，我很轻松呢。"
                        },
                        {
                            "id": "690060907",
                            "speaker": "丽莎",
                            "text": "不过这次…我是想亲手来做。"
                        }
                    ]
                }
            ]
        }
    ]
}