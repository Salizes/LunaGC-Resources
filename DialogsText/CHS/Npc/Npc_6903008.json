{
    "talkId": "6903008",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "钟离": 14
    },
    "dialogues": [
        {
            "id": "690300801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690300401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690300402",
            "speaker": "钟离",
            "text": "最近几日，我在考虑家宅布置的事。"
        },
        {
            "id": "690300403",
            "speaker": "钟离",
            "text": "你这住处景色别致，陈设典雅，我很是中意。"
        },
        {
            "id": "690300404",
            "speaker": "钟离",
            "text": "我经常出入此地，多有叨扰。"
        },
        {
            "id": "690300405",
            "speaker": "钟离",
            "text": "如此说来，也该为这处「洞天」出几份力才是…"
        },
        {
            "id": "690300406",
            "speaker": "钟离",
            "text": "而且…"
        },
        {
            "id": "690300407",
            "speaker": "钟离",
            "text": "要是你不嫌弃，我还想再寻些礼物给你。"
        },
        {
            "id": "690300408",
            "speaker": "钟离",
            "text": "可惜…俗话说得好，宝剑赠英雄。配得上你的礼物，着实有些少了。"
        },
        {
            "id": "690300409",
            "speaker": "钟离",
            "text": "幸好我们来日方长，不必急于一时决定。",
            "choices": [
                {
                    "id": "690300410",
                    "text": "钟离不必客气。",
                    "response": [
                        {
                            "id": "690300412",
                            "speaker": "钟离",
                            "text": "虽说我已不是岩神，但怎么说也是个老派璃月人。"
                        },
                        {
                            "id": "690300413",
                            "speaker": "钟离",
                            "text": "我有我的礼数，到时，你放心收下便是。",
                            "choices": [
                                {
                                    "id": "690300414",
                                    "text": "不愧是钟离，真讲究啊！",
                                    "response": [
                                        {
                                            "id": "690300416",
                                            "speaker": "钟离",
                                            "text": "嗯…你答应就好。"
                                        },
                                        {
                                            "id": "690300417",
                                            "speaker": "钟离",
                                            "text": "我从你身上看到了许多。时光永无止境…人生自在，靠的还是一颗坚定又澄澈的心。"
                                        },
                                        {
                                            "id": "690300418",
                                            "speaker": "钟离",
                                            "text": "像这样与你相处，实在是热闹又快活的事。"
                                        },
                                        {
                                            "id": "690300419",
                                            "speaker": "钟离",
                                            "text": "感谢你，朋友。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690300415",
                                    "text": "钟离的审美我当然认可。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690300411",
                    "text": "有这份心就足够了。"
                }
            ]
        }
    ]
}