{
    "talkId": "7202904",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "慧心": 12
    },
    "dialogues": [
        {
            "id": "720290401",
            "speaker": "Player",
            "text": "关于「海灯节」。"
        },
        {
            "id": "720290402",
            "speaker": "慧心",
            "text": "你是第一次来参加海灯节吗？我可以当你的讲解员哦？",
            "choices": [
                {
                    "id": "720290403",
                    "text": "关于「明霄灯」。",
                    "response": [
                        {
                            "id": "720290404",
                            "speaker": "慧心",
                            "text": "在久远之前，英雄与人们一起群策群力守护着璃月的土地。"
                        },
                        {
                            "id": "720290405",
                            "speaker": "慧心",
                            "text": "而如今的和平时代，为了让团结的精神永不磨灭，沿袭下了全城共建巨大浮灯「明霄灯」的习俗。"
                        },
                        {
                            "id": "720290406",
                            "speaker": "慧心",
                            "text": "人们搜集建材，贡献劳力，最后在海灯节闭幕的当天，在全城民众的见证下放飞，是海灯节最重要的「仪式」。"
                        },
                        {
                            "id": "720290407",
                            "speaker": "慧心",
                            "text": "看到「明霄灯」中间的那块巨岩了吗？它是璃月本年度出产的最大的「浮空石」。"
                        },
                        {
                            "id": "720290408",
                            "speaker": "慧心",
                            "text": "「明霄灯」的大小是由当年「浮空石」的大小决定的哦，而今年据说是二十年来最大的一块呢。"
                        },
                        {
                            "id": "720290409",
                            "speaker": "慧心",
                            "text": "为了纪念守护璃月而死的英雄们，「明霄灯」的造型会按照英雄生前的「仙体」来设计建造。"
                        },
                        {
                            "id": "720290410",
                            "speaker": "慧心",
                            "text": "顺便今年的「明霄灯」描绘的是「移霄导天真君」的英姿哦，是月海亭根据民众呼声决定的。"
                        }
                    ]
                },
                {
                    "id": "720290411",
                    "text": "关于「霄市」。",
                    "response": [
                        {
                            "id": "720290412",
                            "speaker": "慧心",
                            "text": "「霄市」简单来说就是，海灯节附属的娱乐活动吧。"
                        },
                        {
                            "id": "720290413",
                            "speaker": "慧心",
                            "text": "「明霄灯」的筹建资金很多也是源自于「霄市」上的摊位。"
                        },
                        {
                            "id": "720290414",
                            "speaker": "慧心",
                            "text": "所以说，作为商港的璃月港虽然有很多商贩平时看起来有些小气，但其实都是很好的人哦。"
                        },
                        {
                            "id": "720290415",
                            "speaker": "慧心",
                            "text": "趁着大家聚集于此，多和璃月的子民们聊聊天吧？"
                        }
                    ]
                }
            ]
        }
    ]
}