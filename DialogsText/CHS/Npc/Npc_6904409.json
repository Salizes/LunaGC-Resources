{
    "talkId": "6904409",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "辛焱": 8
    },
    "dialogues": [
        {
            "id": "690440901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690440202",
            "speaker": "辛焱",
            "text": "嗯！够大够自由，是非常酷的排练场地！",
            "choices": [
                {
                    "id": "690440203",
                    "text": "我可以来看辛焱排练吗？",
                    "response": [
                        {
                            "id": "690440204",
                            "speaker": "辛焱",
                            "text": "欸！如…如果可以的话，我还是希望自己演奏熟练之后，再表演给你看。"
                        },
                        {
                            "id": "690440205",
                            "speaker": "辛焱",
                            "text": "这样才能带给你最佳的视听体验嘛。"
                        },
                        {
                            "id": "690440206",
                            "speaker": "辛焱",
                            "text": "不过…谢谢你的支持，我一定会努力的！"
                        },
                        {
                            "id": "690440210",
                            "speaker": "辛焱",
                            "text": "哦，对了！每次排练完，我都会把场地收拾干净的。"
                        },
                        {
                            "id": "690440211",
                            "speaker": "辛焱",
                            "text": "就跟新的一样，你放心好了。"
                        }
                    ]
                },
                {
                    "id": "690440207",
                    "text": "谢谢你喜欢…",
                    "response": [
                        {
                            "id": "690440208",
                            "speaker": "辛焱",
                            "text": "欸，哪里的话。"
                        },
                        {
                            "id": "690440209",
                            "speaker": "辛焱",
                            "text": "要谢也该是我来谢你呀！邀请我来你住的地方，也不限制我做这做那。"
                        }
                    ]
                }
            ]
        }
    ]
}