    "dialogues": [
        {
            "id": "616680201",
            "speaker": "Player",
            "text": "你的爸爸？"
        },
        {
            "id": "616680202",
            "speaker": "乔尔",
            "text": "嗯，他是个冒险家。"
        },
        {
            "id": "616680203",
            "speaker": "乔尔",
            "text": "他说好了要接我来雪山看雪的，不过约定的日子到了，爸爸却一直没有来接我…"
        },
        {
            "id": "616680204",
            "speaker": "乔尔",
            "text": "我猜，他一定是发现了什么珍贵秘宝的藏宝图之类的，所以才没来找我的，一定是这样的。"
        },
        {
            "id": "616680205",
            "speaker": "乔尔",
            "text": "我就一个人来到雪山了。既然他没法来找我，我就来找他好了…"
        }
    ]
}