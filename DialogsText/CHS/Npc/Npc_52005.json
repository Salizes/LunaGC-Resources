    "dialogues": [
        {
            "id": "5050501",
            "speaker": "留言",
            "text": "「绯樱酒与樱饼很好，感谢招待。」"
        },
        {
            "id": "5050502",
            "speaker": "店主回复",
            "text": "感谢您的光临才是。"
        },
        {
            "id": "5050503",
            "speaker": "留言",
            "text": "「只是今夜的酒，口感略有不同，是否店家有意为之？」"
        },
        {
            "id": "5050504",
            "speaker": "店主回复",
            "text": "感谢您的品鉴，今夜的酒确是老夫为您特意准备。"
        }
    ]
