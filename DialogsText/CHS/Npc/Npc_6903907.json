{
    "talkId": "6903907",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "迪奥娜": 11
    },
    "dialogues": [
        {
            "id": "690390701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690390302",
            "speaker": "迪奥娜",
            "text": "我可是很忙的！"
        },
        {
            "id": "690390303",
            "speaker": "迪奥娜",
            "text": "…不过，稍微陪你聊聊也不是不可以。"
        },
        {
            "id": "690390304",
            "speaker": "迪奥娜",
            "text": "说吧，我可是知道很多话题的哦！",
            "choices": [
                {
                    "id": "690390305",
                    "text": "迪奥娜平时也会和别人聊天吗？",
                    "response": [
                        {
                            "id": "690390306",
                            "speaker": "迪奥娜",
                            "text": "唔…那些喝醉了的大叔经常来找我聊天。"
                        },
                        {
                            "id": "690390307",
                            "speaker": "迪奥娜",
                            "text": "虽然我一句话也不回他们，但他们却会自顾自地一直说下去！"
                        },
                        {
                            "id": "690390312",
                            "speaker": "迪奥娜",
                            "text": "每到这种时候，我就会调一杯我认为最最难喝的酒给他喝！"
                        },
                        {
                            "id": "690390313",
                            "speaker": "迪奥娜",
                            "text": "但他们喝了之后，反倒都说要再来一杯！就连话也变得比之前多了起来！"
                        },
                        {
                            "id": "690390314",
                            "speaker": "迪奥娜",
                            "text": "呜呜呜…到底为什么会这样嘛……"
                        }
                    ]
                },
                {
                    "id": "690390308",
                    "text": "迪奥娜平时都会聊些什么话题呢？",
                    "response": [
                        {
                            "id": "690390309",
                            "speaker": "迪奥娜",
                            "text": "我喜欢和别人分享打猎的心得，但是…"
                        },
                        {
                            "id": "690390310",
                            "speaker": "迪奥娜",
                            "text": "但是酒馆里大家都在聊庄稼的收成啦、喜欢的女性啦、打牌的技巧啦什么的…"
                        },
                        {
                            "id": "690390311",
                            "speaker": "迪奥娜",
                            "text": "可恶，明明我不想听，却经常有人在我面前说个不停。"
                        }
                    ]
                }
            ]
        }
    ]
}