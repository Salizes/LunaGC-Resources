{
    "talkId": "7280201",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 5,
        "竺子": 19
    },
    "dialogues": [
        {
            "id": "728020101",
            "speaker": "竺子",
            "text": "不知道妈妈的身体怎么样了，还有爸爸…"
        },
        {
            "id": "728020102",
            "speaker": "竺子",
            "text": "咦？旅行者？你怎么来了，我记得上次你来问我前往稻妻的方法…"
        },
        {
            "id": "728020103",
            "speaker": "Player",
            "text": "已经去过稻妻了。"
        },
        {
            "id": "728020104",
            "speaker": "竺子",
            "text": "居、居然真的过去了，而且还能回来…"
        },
        {
            "id": "728020105",
            "speaker": "竺子",
            "text": "不愧是名扬四方的勇士，各方面的本领都不是我这种普通人能企及的。"
        },
        {
            "id": "728020106",
            "speaker": "竺子",
            "text": "对、对了！如果可以的话，能不能请你帮我一个忙？",
            "choices": [
                {
                    "id": "728020107",
                    "text": "怎么了？",
                    "response": [
                        {
                            "id": "728020109",
                            "speaker": "竺子",
                            "text": "说起来，当初我离开稻妻的时候，是不辞而别。"
                        },
                        {
                            "id": "728020110",
                            "speaker": "竺子",
                            "text": "我从小就向往稻妻之外的广阔世界，喜欢到处游历，不喜欢受父母管束。"
                        },
                        {
                            "id": "728020111",
                            "speaker": "竺子",
                            "text": "眼狩令颁布后，稻妻的气氛变得越来越压抑，我这才临时起意，离开了家乡。"
                        },
                        {
                            "id": "728020112",
                            "speaker": "竺子",
                            "text": "虽然来了璃月之后，我勉强找到了维生的办法，但却找不到可靠的人帮着给家里捎信报平安。"
                        },
                        {
                            "id": "728020113",
                            "speaker": "竺子",
                            "text": "如果你愿意的话，我能请你帮忙把家书带给父母吗？",
                            "choices": [
                                {
                                    "id": "728020114",
                                    "text": "交给我吧。",
                                    "response": [
                                        {
                                            "id": "728020115",
                                            "speaker": "竺子",
                                            "text": "谢谢你！那么，送信的事就拜托你啦。"
                                        },
                                        {
                                            "id": "728020120",
                                            "speaker": "竺子",
                                            "text": "对了，我的父亲叫做「曜」，我的母亲叫做「满」，至于住址，我帮你标记在地图上吧。"
                                        },
                                        {
                                            "id": "728020121",
                                            "speaker": "竺子",
                                            "text": "离开家乡之后，我经历了许多，如今的我深知，想要成长为独立坚强的女性，总像以前那样依赖父母是不行的。"
                                        },
                                        {
                                            "id": "728020122",
                                            "speaker": "竺子",
                                            "text": "我已经决定了，短期内不会归乡。如果在外遇到困难的话，我会靠自己勇敢面对。"
                                        },
                                        {
                                            "id": "728020123",
                                            "speaker": "竺子",
                                            "text": "做到这一点的话，远方的爸爸妈妈，也会以我为傲吧。"
                                        },
                                        {
                                            "id": "728020124",
                                            "speaker": "竺子",
                                            "text": "我把这份决心也写在了家书里，就麻烦你把它带回我父母身边了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "728020116",
                                    "text": "你想回去看看吗？",
                                    "response": [
                                        {
                                            "id": "728020117",
                                            "speaker": "竺子",
                                            "text": "虽然我惦念父母，但如今我一旦回去，恐怕就再也没办法离开了。"
                                        },
                                        {
                                            "id": "728020118",
                                            "speaker": "竺子",
                                            "text": "我可没有像你这样来去自由的本事，所以无论如何我都不敢回去。"
                                        },
                                        {
                                            "id": "728020119",
                                            "speaker": "竺子",
                                            "text": "只要你能帮我把这封信捎去稻妻，我就满足了，至于其他…我实在不敢奢求。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "728020108",
                    "text": "有什么烦恼的事吗？"
                }
            ]
        }
    ]
}