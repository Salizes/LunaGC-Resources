    "dialogues": [
        {
            "id": "674180301",
            "speaker": "Player",
            "text": "那今天赢了吗？"
        },
        {
            "id": "674180302",
            "speaker": "捷列布佐夫",
            "text": "…如果只想着赢的话，是没有办法赢的，衡量人生的标准又岂能如此狭隘呢。"
        },
        {
            "id": "674180303",
            "speaker": "捷列布佐夫",
            "text": "就像我…虽然失去了正经的工作和妻子的体贴，但在垂钓时获得的平静也值回了一切…"
        }
    ]
}