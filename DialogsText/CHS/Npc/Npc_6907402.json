{
    "talkId": "6907402",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "莱依拉": 8
    },
    "dialogues": [
        {
            "id": "690740201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690740202",
            "speaker": "莱依拉",
            "text": "你放心，这里的陈设完全能满足我的日常需要，一点可抱怨的都没有。"
        },
        {
            "id": "690740203",
            "speaker": "莱依拉",
            "text": "一般来说，我很在意住的地方有没有小飞虫之类的。"
        },
        {
            "id": "690740204",
            "speaker": "莱依拉",
            "text": "你知道的，就是那种四处乱飞，发出嗡嗡声，还会时不时骚扰你的飞虫。",
            "choices": [
                {
                    "id": "690740205",
                    "text": "是说飞萤吧？",
                    "response": [
                        {
                            "id": "690740206",
                            "speaker": "莱依拉",
                            "text": "对对，就是那一类小虫子。"
                        },
                        {
                            "id": "690740209",
                            "speaker": "莱依拉",
                            "text": "别看它们小小的，但一到晚上夜深人静的时候，它们就会对着你的耳朵嗡嗡个不停，真的很烦人。"
                        },
                        {
                            "id": "690740210",
                            "speaker": "莱依拉",
                            "text": "我之前常被这种小虫子折腾得睡不着，但在你这里就完全没有这种困扰。"
                        },
                        {
                            "id": "690740211",
                            "speaker": "莱依拉",
                            "text": "又整洁又安静，真是失眠症患者的宝地！"
                        }
                    ]
                },
                {
                    "id": "690740207",
                    "text": "是说萤火虫吧？",
                    "response": [
                        {
                            "id": "690740208",
                            "speaker": "莱依拉",
                            "text": "不对啦，就算我的专业不是昆虫研究，也知道萤火虫和那种小虫子，肯定不是一个种类。"
                        }
                    ]
                }
            ]
        }
    ]
}