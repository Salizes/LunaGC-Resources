    "dialogues": [
        {
            "id": "640390301",
            "speaker": "Player",
            "text": "去铁匠铺问问？"
        },
        {
            "id": "640390302",
            "speaker": "伊拉杰",
            "text": "铁匠铺啊…还是算了吧。"
        },
        {
            "id": "640390303",
            "speaker": "伊拉杰",
            "text": "那里的老板是我的养父，经常话里话外想让我们回去继承打铁的家业。"
        },
        {
            "id": "640390304",
            "speaker": "伊拉杰",
            "text": "他对我们这些养子养女都很好，所以我们每次拒绝他心里都很过意不去…"
        },
        {
            "id": "640390305",
            "speaker": "伊拉杰",
            "text": "所以关于武器的事情，还是不要去麻烦他老人家啦。"
        }
    ]
}