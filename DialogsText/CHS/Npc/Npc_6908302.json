{
    "talkId": "6908302",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "琳妮特": 7
    },
    "dialogues": [
        {
            "id": "690830201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690830202",
            "speaker": "琳妮特",
            "text": "只要把自己的意识放空，在哪里都一样。"
        },
        {
            "id": "690830203",
            "speaker": "琳妮特",
            "text": "…不过，以正常标准而言，这里的环境确实很不错。",
            "choices": [
                {
                    "id": "690830204",
                    "text": "以正常标准而言？",
                    "response": [
                        {
                            "id": "690830205",
                            "speaker": "琳妮特",
                            "text": "清洁的空气，温暖的床榻，广阔的空间…"
                        },
                        {
                            "id": "690830206",
                            "speaker": "琳妮特",
                            "text": "要是我们以前能在这种环境下长大，林尼也不用总操心这操心那了吧。"
                        },
                        {
                            "id": "690830207",
                            "speaker": "琳妮特",
                            "text": "…好像掺进了一点主观要素，请不要在意。总之是一个好地方。"
                        }
                    ]
                },
                {
                    "id": "690830208",
                    "text": "以你的标准呢？",
                    "response": [
                        {
                            "id": "690830209",
                            "speaker": "琳妮特",
                            "text": "很适合发呆。充能速率比平时高了百分之五。"
                        },
                        {
                            "id": "690830210",
                            "speaker": "Player",
                            "text": "好微妙的评价…"
                        },
                        {
                            "id": "690830211",
                            "speaker": "琳妮特",
                            "text": "…以琳妮特标准，这已经是最高评价了哦。"
                        }
                    ]
                }
            ]
        }
    ]
}