        "艾斯特尔": 5
    },
    "dialogues": [
        {
            "id": "701080101",
            "speaker": "艾斯特尔",
            "text": "唉，只用这些信标，果然还是不能准确勘测雪山的高度啊，这误差也太大了…"
        },
        {
            "id": "701080102",
            "speaker": "艾斯特尔",
            "text": "除非…"
        },
        {
            "id": "701080103",
            "speaker": "玩家",
            "text": "除非…"
        },
        {
            "id": "701080104",
            "speaker": "艾斯特尔",
            "text": "除非，有一位勇敢的冒险家能帮我把这枚信标直接放到山顶上。",
            "choices": [
                {
                    "id": "701080105",
                    "text": "你说的是谁？",
                    "response": [
                        {
                            "id": "701080107",
                            "speaker": "艾斯特尔",
                            "text": "拜托你了！再帮帮我吧，我的信标被怪物弄坏太多，只有这种方法能缩小勘测误差了。"
                        },
                        {
                            "id": "701080108",
                            "speaker": "艾斯特尔",
                            "text": "只要把这枚信标放在雪山顶上就可以了，报酬我一定会准备好的，只有你能帮我这个忙了！"
                        }
                    ]
                },
                {
                    "id": "701080106",
                    "text": "你说的是我吗？"
                }
            ]
        }
    ]
}