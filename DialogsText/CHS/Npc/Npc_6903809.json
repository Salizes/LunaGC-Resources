    "dialogues": [
        {
            "id": "690380901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690380202",
            "speaker": "阿贝多",
            "text": "嗯，我想，书中说的「世外桃源」，大概就是这样的地方。"
        },
        {
            "id": "690380203",
            "speaker": "阿贝多",
            "text": "幽静又安逸，全身心投入实验之后，甚至能够忘记时间。",
            "choices": [
                {
                    "id": "690380204",
                    "text": "要记得按时吃饭哦。",
                    "response": [
                        {
                            "id": "690380205",
                            "speaker": "阿贝多",
                            "text": "……"
                        },
                        {
                            "id": "690380206",
                            "speaker": "阿贝多",
                            "text": "嗯，那是当然的。"
                        },
                        {
                            "id": "690380207",
                            "speaker": "阿贝多",
                            "text": "哦，对了…"
                        },
                        {
                            "id": "690380210",
                            "speaker": "阿贝多",
                            "text": "有时我会随处写生，你在「洞天」之内的布设，也是我的灵感源泉。"
                        },
                        {
                            "id": "690380211",
                            "speaker": "阿贝多",
                            "text": "…谢谢你。"
                        }
                    ]
                },
                {
                    "id": "690380208",
                    "text": "有什么需要可以和我说。",
                    "response": [
                        {
                            "id": "690380209",
                            "speaker": "阿贝多",
                            "text": "嗯…尽情发挥你的创意就好。"
                        }
                    ]
                }
            ]
        }
    ]
}