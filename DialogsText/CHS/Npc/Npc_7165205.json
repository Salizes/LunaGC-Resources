{
    "talkId": "7165205",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "盈珠": 6,
        "胡塞尼": 5
    },
    "dialogues": [
        {
            "id": "716520501",
            "speaker": "胡塞尼",
            "text": "我已经通过数据接收装置记录下所有数据了，你的战斗非常精彩。",
            "choices": [
                {
                    "id": "716520502",
                    "text": "其实马马虎虎。",
                    "response": [
                        {
                            "id": "716520503",
                            "speaker": "胡塞尼",
                            "text": "真是谦逊的回答啊，但我仍要感谢你为追求智慧付出的努力。"
                        },
                        {
                            "id": "716520506",
                            "speaker": "盈珠",
                            "text": "如果没有你的话，那处秘境我们根本没办法进去，毕竟实在太危险了。"
                        },
                        {
                            "id": "716520507",
                            "speaker": "盈珠",
                            "text": "你也挽救了协会的声誉，感谢你，旅行者。"
                        },
                        {
                            "id": "716520508",
                            "speaker": "胡塞尼",
                            "text": "可惜「地脉之果」已经碎成那么多片，关于「地脉之果」的研究没办法继续了。"
                        },
                        {
                            "id": "716520509",
                            "speaker": "胡塞尼",
                            "text": "现在起，将研究方向改成「导能原盘」的话，或许还来得及…"
                        },
                        {
                            "id": "716520510",
                            "speaker": "盈珠",
                            "text": "非常抱歉，胡塞尼先生，冒险家协会会负责到底。"
                        },
                        {
                            "id": "716520511",
                            "speaker": "盈珠",
                            "text": "旅行者，如果你在旅途过程中发现了更多的「地脉之果」碎片，能拜托你收集起来吗？"
                        },
                        {
                            "id": "716520512",
                            "speaker": "盈珠",
                            "text": "借助原盘的力量，挑战那些连我也不敢进入的秘境，这样一定能收集到更多数据，也能帮上胡塞尼先生的忙吧。"
                        },
                        {
                            "id": "716520513",
                            "speaker": "Player",
                            "text": "明白了。"
                        },
                        {
                            "id": "716520514",
                            "speaker": "盈珠",
                            "text": "感谢你的协助，旅行者，祝你旅途顺利。向着星辰与深渊。"
                        }
                    ]
                },
                {
                    "id": "716520504",
                    "text": "我可是战斗大师。",
                    "response": [
                        {
                            "id": "716520505",
                            "speaker": "胡塞尼",
                            "text": "哈哈，你确实是一位战斗大师。"
                        }
                    ]
                }
            ]
        }
    ]
}