    "dialogues": [
        {
            "id": "641260201",
            "speaker": "Player",
            "text": "你是…"
        },
        {
            "id": "641260202",
            "speaker": "罗莎娜",
            "text": "如你所见，是个店员。"
        },
        {
            "id": "641260203",
            "speaker": "罗莎娜",
            "text": "不过我既不会调酒，也不会招呼客人。"
        },
        {
            "id": "641260204",
            "speaker": "罗莎娜",
            "text": "毕竟，这里不是还有酒保和娜斯米儿吗。娜斯米儿一个人就能把事情做得七七八八了。"
        },
        {
            "id": "641260205",
            "speaker": "罗莎娜",
            "text": "酒保…其实就是这个饭店的老板啦。"
        },
        {
            "id": "641260206",
            "speaker": "罗莎娜",
            "text": "老板最怕的就是得罪客人，所以无论你提什么要求，他都会满足的。"
        }
    ]
}