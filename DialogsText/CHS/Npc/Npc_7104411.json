    "dialogues": [
        {
            "id": "710441101",
            "speaker": "Player",
            "text": "关于岚姐…"
        },
        {
            "id": "710441102",
            "speaker": "沐宁",
            "text": "她一定还跟你谈了「特殊委托」的事情吧？我是代表总务司行事的专员，冒险家协会的委托对总务司而言并无效力。"
        },
        {
            "id": "710441103",
            "speaker": "沐宁",
            "text": "所以你也…呃，别想拿她压我，没用的…"
        },
        {
            "id": "710441104",
            "speaker": "派蒙",
            "text": "一点底气都没有，鬼才信咧！",
            "choices": [
                {
                    "id": "710441105",
                    "text": "明明你还欠着她酒钱…",
                    "response": [
                        {
                            "id": "710441107",
                            "speaker": "沐宁",
                            "text": "好啦！请不要再提这档子事啦！我们说正事！"
                        }
                    ]
                },
                {
                    "id": "710441106",
                    "text": "「也」？这招曾经有用过？"
                }
            ]
        }
    ]
}