        "阿马佐利": 4
    },
    "dialogues": [
        {
            "id": "662200301",
            "speaker": "Player",
            "text": "关于「伊杜坎的秘藏」…"
        },
        {
            "id": "662200302",
            "speaker": "阿马佐利",
            "text": "「伊杜坎」…真是个好名字。"
        },
        {
            "id": "662200303",
            "speaker": "阿马佐利",
            "text": "是我从某本神话书籍里读到的，具体什么内容有些记不得了…但印象中名字的主人是十分智慧的人物。"
        },
        {
            "id": "662200305",
            "speaker": "阿马佐利",
            "text": "智慧有很多种形式，纸质的，布织的，甚至口口相传的语言，皆在其内。"
        },
        {
            "id": "662200304",
            "speaker": "阿马佐利",
            "text": "这就是为什么我会给自己店起名叫「伊杜坎的秘藏」。"
        }
    ]
}