        "留言": 4
    },
    "dialogues": [
        {
            "id": "5070701",
            "speaker": "留言",
            "text": "「稻妻城近来流行夜盗、海贼、假勘合」"
        },
        {
            "id": "5070702",
            "speaker": "留言",
            "text": "「走私、快脚、无事生非」"
        },
        {
            "id": "5070703",
            "speaker": "留言",
            "text": "「拘禁、受贿，自由出港」"
        },
        {
            "id": "5070704",
            "speaker": "留言",
            "text": "「强征、止滞、欺下瞒上」"
        },
        {
            "id": "5070705",
            "speaker": "回复",
            "text": "以上皆是妄言，无一事为实！"
        },
        {
            "id": "5070706",
            "speaker": "回复",
            "text": "如有发现涂鸦者，九条天领奉行孝行大人必从重发落！"
        }
    ]
}