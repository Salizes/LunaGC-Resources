    "dialogues": [
        {
            "id": "690160201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690160701",
            "speaker": "迪卢克",
            "text": "还行吧。",
            "choices": [
                {
                    "id": "690160702",
                    "text": "原来只是「还行」的程度。",
                    "response": [
                        {
                            "id": "690160704",
                            "speaker": "迪卢克",
                            "text": "……"
                        },
                        {
                            "id": "690160705",
                            "speaker": "迪卢克",
                            "text": "抱歉，我并不是贬低这处家园。"
                        },
                        {
                            "id": "690160706",
                            "speaker": "迪卢克",
                            "text": "也没有想让你失望的意思。"
                        },
                        {
                            "id": "690160707",
                            "speaker": "迪卢克",
                            "text": "我想说的是…如果要适应在这边居住生活的话，对我而言需要一点时间。"
                        },
                        {
                            "id": "690160708",
                            "speaker": "迪卢克",
                            "text": "希望你不会介意。"
                        }
                    ]
                },
                {
                    "id": "690160703",
                    "text": "果然迪卢克的品位名不虚传…"
                }
            ]
        }
    ]
}