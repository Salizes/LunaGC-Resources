{
    "talkId": "6911309",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "伊法": 14
    },
    "dialogues": [
        {
            "id": "691130401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691130402",
            "speaker": "伊法",
            "text": "想在你这里四处看看，参考学习一下布置手法。"
        },
        {
            "id": "691130403",
            "speaker": "伊法",
            "text": "有些摆设放得很有趣，还很实用。正好我也想调整一下自家的院子。",
            "choices": [
                {
                    "id": "691130404",
                    "text": "请尽情学习吧！",
                    "response": [
                        {
                            "id": "691130405",
                            "speaker": "伊法",
                            "text": "哈哈，不收我学费吧？"
                        },
                        {
                            "id": "691130408",
                            "speaker": "Player",
                            "text": "伊法也教我点什么吧。"
                        },
                        {
                            "id": "691130409",
                            "speaker": "伊法",
                            "text": "教你啊，唔，我想想…"
                        },
                        {
                            "id": "691130410",
                            "speaker": "伊法",
                            "text": "像你这种成熟独立的冒险家，会的东西已经很多了。"
                        },
                        {
                            "id": "691130411",
                            "speaker": "伊法",
                            "text": "非要学点什么的话…来，学习一下这个手势。"
                        },
                        {
                            "id": "691130412",
                            "speaker": "Player",
                            "text": "勾勾手？"
                        },
                        {
                            "id": "691130413",
                            "speaker": "伊法",
                            "text": "对，只是看着简单。角度和频率都很重要。"
                        },
                        {
                            "id": "691130414",
                            "speaker": "伊法",
                            "text": "不紧不慢，温和一点。勾手的频率也别太低，这样它们就能感觉到你很有活力。"
                        },
                        {
                            "id": "691130415",
                            "speaker": "伊法",
                            "text": "做得好的话，猫狗和龙都会主动跑来跟你打招呼。对它们来说这是友好的信号。"
                        },
                        {
                            "id": "691130416",
                            "speaker": "Player",
                            "text": "学到了！"
                        },
                        {
                            "id": "691130417",
                            "speaker": "伊法",
                            "text": "很实用吧。"
                        },
                        {
                            "id": "691130418",
                            "speaker": "Player",
                            "text": "对了，能吹口哨吗？"
                        },
                        {
                            "id": "691130419",
                            "speaker": "伊法",
                            "text": "这个我不推荐。对小动物可能还好，对龙吹口哨，有可能激怒它们。"
                        },
                        {
                            "id": "691130420",
                            "speaker": "伊法",
                            "text": "纳塔有些龙自尊心很强，甚至还很聪明。不要试图糊弄那群家伙。"
                        },
                        {
                            "id": "691130421",
                            "speaker": "伊法",
                            "text": "跟龙相处，本质上和跟人交往差不多。真心换真心才行。"
                        }
                    ]
                },
                {
                    "id": "691130406",
                    "text": "这是大师我的匠心之作。",
                    "response": [
                        {
                            "id": "691130407",
                            "speaker": "伊法",
                            "text": "让我偷师一下。"
                        }
                    ]
                }
            ]
        }
    ]
}