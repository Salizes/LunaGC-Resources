{
    "talkId": "100898",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 1,
        "李当": 7
    },
    "dialogues": [
        {
            "id": "10089801",
            "speaker": "李当",
            "text": "咳！咳咳，咳…咳咳！"
        },
        {
            "id": "10089802",
            "speaker": "李当",
            "text": "我怎么…是你们救我出来的？谢谢你们…"
        },
        {
            "id": "10089803",
            "speaker": "李当",
            "text": "对了！你们看见过我兄弟吗？他叫李丁，我们俩是一同上山的。"
        },
        {
            "id": "10089804",
            "speaker": "李当",
            "text": "但我…我也不知道是怎么了？是被这块琥珀给吞了吗？那时一下就失去了意识…"
        },
        {
            "id": "10089805",
            "speaker": "李当",
            "text": "不知道…我兄弟是不是也一样被琥珀给吞了…"
        },
        {
            "id": "10089806",
            "speaker": "Player",
            "text": "不知道…"
        },
        {
            "id": "10089807",
            "speaker": "李当",
            "text": "好吧，不麻烦您了，谢谢您…我要去找我兄弟了。"
        },
        {
            "id": "10089808",
            "speaker": "李当",
            "text": "希望他一切安全…"
        }
    ]
}