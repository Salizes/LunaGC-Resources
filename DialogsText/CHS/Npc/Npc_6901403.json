{
    "talkId": "6901403",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 6,
        "芭芭拉": 11
    },
    "dialogues": [
        {
            "id": "690140301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690140801",
            "speaker": "芭芭拉",
            "text": "啊，好的！"
        },
        {
            "id": "690140802",
            "speaker": "芭芭拉",
            "text": "嘿嘿…",
            "choices": [
                {
                    "id": "690140803",
                    "text": "你怎么突然笑了。",
                    "response": [
                        {
                            "id": "690140805",
                            "speaker": "芭芭拉",
                            "text": "啊，我刚刚意识到，自己很久没有像现在这样，轻轻松松地和朋友聊天。"
                        },
                        {
                            "id": "690140806",
                            "speaker": "芭芭拉",
                            "text": "突然就觉得很幸福。",
                            "choices": [
                                {
                                    "id": "690140807",
                                    "text": "芭芭拉很容易满足啊。",
                                    "response": [
                                        {
                                            "id": "690140808",
                                            "speaker": "芭芭拉",
                                            "text": "唔，唔，是这样吗…"
                                        },
                                        {
                                            "id": "690140809",
                                            "speaker": "芭芭拉",
                                            "text": "好像，这也不是什么坏事。"
                                        },
                                        {
                                            "id": "690140810",
                                            "speaker": "芭芭拉",
                                            "text": "很容易就感到幸福的话，就会有很多的能量，然后就可以把幸福的感觉传递给别人。"
                                        },
                                        {
                                            "id": "690140815",
                                            "speaker": "芭芭拉",
                                            "text": "唔，你不要总是夸我啦…"
                                        },
                                        {
                                            "id": "690140816",
                                            "speaker": "芭芭拉",
                                            "text": "有批评…才会有进步，对吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690140811",
                                    "text": "因为芭芭拉总是在为别人考虑。",
                                    "response": [
                                        {
                                            "id": "690140812",
                                            "speaker": "芭芭拉",
                                            "text": "那也是理所当然的嘛。"
                                        },
                                        {
                                            "id": "690140813",
                                            "speaker": "芭芭拉",
                                            "text": "我一直受到大家的照顾，我也想用自己的努力来回应这些善意。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690140814",
                                    "text": "真不愧是芭芭拉啊。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690140804",
                    "text": "想到什么有趣的事情了吗？"
                }
            ]
        }
    ]
}