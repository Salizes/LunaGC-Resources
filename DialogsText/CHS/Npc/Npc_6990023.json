{
    "talkId": "6990023",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 9
    },
    "dialogues": [
        {
            "id": "699002301",
            "speaker": "Player",
            "text": "关于神里绫华…"
        },
        {
            "id": "699002302",
            "speaker": "派蒙",
            "text": "嗯…嗯…"
        },
        {
            "id": "699002303",
            "speaker": "Player",
            "text": "派蒙，今天看起来好严肃啊。"
        },
        {
            "id": "699002304",
            "speaker": "派蒙",
            "text": "因为我正在思考很严肃的事情。"
        },
        {
            "id": "699002305",
            "speaker": "派蒙",
            "text": "我以前很羡慕大户人家的生活，可以有用不完的摩拉和吃不完的美食…"
        },
        {
            "id": "699002306",
            "speaker": "Player",
            "text": "嗯，确实都是你喜欢的东西。"
        },
        {
            "id": "699002307",
            "speaker": "派蒙",
            "text": "但是认识了绫华之后，我发现大小姐的生活也很辛苦呢。"
        },
        {
            "id": "699002308",
            "speaker": "派蒙",
            "text": "需要背负家族的使命与责任，尽力完成工作，才能在难得的闲暇享受自己的生活。"
        },
        {
            "id": "699002309",
            "speaker": "派蒙",
            "text": "绫华平常这么辛苦，应该也要多放松下才好呀…"
        },
        {
            "id": "699002310",
            "speaker": "派蒙",
            "text": "对了对了！下次再有祭典活动的话，我们也邀请绫华一起去吧？"
        },
        {
            "id": "699002311",
            "speaker": "派蒙",
            "text": "我们去邀请的话，绫华应该不会拒绝的吧，嘿嘿。",
            "choices": [
                {
                    "id": "699002312",
                    "text": "嗯，我也很想…",
                    "response": [
                        {
                            "id": "699002314",
                            "speaker": "派蒙",
                            "text": "而且，只要绫华在的话，那我们游玩的全部费用就都…"
                        },
                        {
                            "id": "699002315",
                            "speaker": "Player",
                            "text": "…这才是你真正的目的吧…"
                        }
                    ]
                },
                {
                    "id": "699002313",
                    "text": "再和她去一次祭典。"
                }
            ]
        }
    ]
}