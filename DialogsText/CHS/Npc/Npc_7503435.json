    "speaker_counts": {
        "Player": 2,
        "阿妮拉": 5
    },
    "dialogues": [
        {
            "id": "750343501",
            "speaker": "阿妮拉",
            "text": "是你呀，这次是专程来找我玩的吗？",
            "choices": [
                {
                    "id": "750343502",
                    "text": "关于之前的事…",
                    "response": [
                        {
                            "id": "750343503",
                            "speaker": "阿妮拉",
                            "text": "你愿意重新考虑之前的邀约了？还是说不是这件事？"
                        },
                        {
                            "id": "750343504",
                            "speaker": "阿妮拉",
                            "text": "如果你要问汉佩克的事，我只能告诉你那是他咎由自取。对方固然有不对的地方，但他难道就没有一点错吗？"
                        },
                        {
                            "id": "750343505",
                            "speaker": "阿妮拉",
                            "text": "哎呀，我这么说是不是显得有些落井下石的意思？唔，为了我自己的风评，现在还是保留意见好了。"
                        }
                    ]
                },
                {
                    "id": "750343506",
                    "text": "还有其他事，先走了。",
                    "response": [
                        {
                            "id": "750343507",
                            "speaker": "阿妮拉",
                            "text": "真可惜，那你路上小心哦。"
                        }
                    ]
                }
            ]
        }
    ]
}