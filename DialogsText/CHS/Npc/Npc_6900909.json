{
    "talkId": "6900909",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "久岐忍": 8
    },
    "dialogues": [
        {
            "id": "690090201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690090202",
            "speaker": "久岐忍",
            "text": "嗯，很舒服，谢谢你的邀请。"
        },
        {
            "id": "690090203",
            "speaker": "久岐忍",
            "text": "刚刚绕了几圈参观了一下，你的规划还挺有意思的，你学过景观设计吗？",
            "choices": [
                {
                    "id": "690090204",
                    "text": "没有，随便弄弄而已。",
                    "response": [
                        {
                            "id": "690090205",
                            "speaker": "久岐忍",
                            "text": "噢，那你就是所谓天赋型人才吧，无师自通那种。"
                        },
                        {
                            "id": "690090208",
                            "speaker": "久岐忍",
                            "text": "但其实，这让我也有些心动，我是不是可以去考个景观设计证书呢？"
                        },
                        {
                            "id": "690090209",
                            "speaker": "Player",
                            "text": "想考就考！"
                        },
                        {
                            "id": "690090210",
                            "speaker": "久岐忍",
                            "text": "你倒也很爽快。哈哈，谢谢你的建议。"
                        },
                        {
                            "id": "690090211",
                            "speaker": "久岐忍",
                            "text": "那我就试试看吧。不过在那之前，可以麻烦你提供这个场地让我练手么？"
                        },
                        {
                            "id": "690090212",
                            "speaker": "久岐忍",
                            "text": "作为回报的话…我来包你这阵子的烤堇瓜，如何？"
                        }
                    ]
                },
                {
                    "id": "690090206",
                    "text": "确实懂一点，阿忍也学过？",
                    "response": [
                        {
                            "id": "690090207",
                            "speaker": "久岐忍",
                            "text": "我倒还没怎么学…"
                        }
                    ]
                }
            ]
        }
    ]
}