{
    "talkId": "6908909",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "芙宁娜": 15
    },
    "dialogues": [
        {
            "id": "690890401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690890402",
            "speaker": "芙宁娜",
            "text": "这个嘛…我现在有很多想做的事，就像夜空中数不清的星星。"
        },
        {
            "id": "690890403",
            "speaker": "芙宁娜",
            "text": "不过当务之急嘛，还是要在这里添置几件家具。"
        },
        {
            "id": "690890404",
            "speaker": "Player",
            "text": "呃，你不喜欢现在的装扮吗？"
        },
        {
            "id": "690890405",
            "speaker": "芙宁娜",
            "text": "没、没必要露出失望的表情吧？我没有说这里不好啦…"
        },
        {
            "id": "690890406",
            "speaker": "芙宁娜",
            "text": "但是！美丽的装扮就像橱柜中的衣服，永远不会嫌多。"
        },
        {
            "id": "690890407",
            "speaker": "芙宁娜",
            "text": "特别是茶会用到的家具与装饰，必须要经常更换，才能保证新鲜感。"
        },
        {
            "id": "690890408",
            "speaker": "芙宁娜",
            "text": "虽然很多人会说「经典才是最好的」，但经典和守旧可是两码事。",
            "choices": [
                {
                    "id": "690890409",
                    "text": "说得好！",
                    "response": [
                        {
                            "id": "690890410",
                            "speaker": "芙宁娜",
                            "text": "看来你能够理解我的想法，说明你也是个有趣的人。"
                        },
                        {
                            "id": "690890413",
                            "speaker": "芙宁娜",
                            "text": "总之，添置家具既然是我自己的主意，就由我来承担相应的费用吧。"
                        },
                        {
                            "id": "690890414",
                            "speaker": "芙宁娜",
                            "text": "无需担心，海薇玛夫人这个月还没有拿出超支单，说明我的小金库运转良好。",
                            "choices": [
                                {
                                    "id": "690890415",
                                    "text": "你经常超支啊？",
                                    "response": [
                                        {
                                            "id": "690890416",
                                            "speaker": "芙宁娜",
                                            "text": "没、没办法吧？世界上有那么多可爱的、新奇的东西，让人忍不住想要买下来…"
                                        },
                                        {
                                            "id": "690890417",
                                            "speaker": "芙宁娜",
                                            "text": "唉，看来要稍微节约一点…就从下个月开始吧！"
                                        }
                                    ]
                                },
                                {
                                    "id": "690890418",
                                    "text": "「小金库」？",
                                    "response": [
                                        {
                                            "id": "690890419",
                                            "speaker": "芙宁娜",
                                            "text": "其实就是我的演出费用啦。之前我说过吧？其实几百年间我也偶尔会应邀上台表演，还是攒了些钱的。"
                                        },
                                        {
                                            "id": "690890420",
                                            "speaker": "芙宁娜",
                                            "text": "我把这些钱交给海薇玛夫人打理，她比我更擅长做投资和交易。"
                                        },
                                        {
                                            "id": "690890421",
                                            "speaker": "芙宁娜",
                                            "text": "大概在未来很长时间我不需要担心钱的事。虽然海薇玛夫人每个月都会做规划，但其实稍微超支一点点也没关系啦。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690890411",
                    "text": "芙宁娜懂得真多！",
                    "response": [
                        {
                            "id": "690890412",
                            "speaker": "芙宁娜",
                            "text": "呵呵，对我感兴趣的领域，我不介意多花一点时间，来做到「世界上最好」的程度。"
                        }
                    ]
                }
            ]
        }
    ]
}