{
    "talkId": "6909102",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "娜维娅": 11
    },
    "dialogues": [
        {
            "id": "690910201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690910202",
            "speaker": "娜维娅",
            "text": "很不错，我喜欢这里。"
        },
        {
            "id": "690910203",
            "speaker": "娜维娅",
            "text": "风景好，室内布设也很有品味，不愧是你家。"
        },
        {
            "id": "690910204",
            "speaker": "Player",
            "text": "跟你家比还是差了一点。"
        },
        {
            "id": "690910205",
            "speaker": "娜维娅",
            "text": "哪有，不可以这么说哦。"
        },
        {
            "id": "690910206",
            "speaker": "娜维娅",
            "text": "人们家里总是会留下只有主人才能布置出的感觉，来别人家看的不是别的，是性格。"
        },
        {
            "id": "690910207",
            "speaker": "娜维娅",
            "text": "嗯嗯，我概括得真好。对，就是性格！"
        },
        {
            "id": "690910208",
            "speaker": "娜维娅",
            "text": "好比这里…嗯，能感觉到呢，是你和派蒙的家。",
            "choices": [
                {
                    "id": "690910209",
                    "text": "你喜欢什么风格的家？",
                    "response": [
                        {
                            "id": "690910210",
                            "speaker": "娜维娅",
                            "text": "唔…温馨实用就好？我才没有那么挑剔啦。"
                        },
                        {
                            "id": "690910211",
                            "speaker": "娜维娅",
                            "text": "我家的布置很多都是迈勒斯安排的，我喜欢那种感觉。一旦习惯，就很难突然变更布设了。"
                        }
                    ]
                },
                {
                    "id": "690910212",
                    "text": "喜欢这里的话，请务必常来！",
                    "response": [
                        {
                            "id": "690910213",
                            "speaker": "娜维娅",
                            "text": "真的？我真的会经常来哦？没问题吧？"
                        },
                        {
                            "id": "690910214",
                            "speaker": "娜维娅",
                            "text": "放心，我会带点心来的，手工饼干，小蛋糕…你喜欢哪种都可以。"
                        },
                        {
                            "id": "690910215",
                            "speaker": "娜维娅",
                            "text": "派蒙的份也一起！"
                        }
                    ]
                }
            ]
        }
    ]
}