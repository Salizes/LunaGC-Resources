{
    "talkId": "7181201",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "岚姐": 11
    },
    "dialogues": [
        {
            "id": "718120101",
            "speaker": "岚姐",
            "text": "唔…看来还是没人能解开啊…"
        },
        {
            "id": "718120102",
            "speaker": "Player",
            "text": "解开什么？"
        },
        {
            "id": "718120103",
            "speaker": "岚姐",
            "text": "是一个宝藏的线索，唔…或者说，一个传言。"
        },
        {
            "id": "718120104",
            "speaker": "岚姐",
            "text": "有位冒险家说他在天遒谷附近发现了宝藏的线索…但他费尽办法也没找到宝藏…"
        },
        {
            "id": "718120105",
            "speaker": "岚姐",
            "text": "他最后只能把这个无头线索报告给了协会，协会就把这个所谓的「线索」作为悬赏发布了。"
        },
        {
            "id": "718120106",
            "speaker": "岚姐",
            "text": "任何想要尝试的冒险家都可以循着线索去试试看。如果真的解开了谜题找到宝藏，协会还有些奖励送上。"
        },
        {
            "id": "718120107",
            "speaker": "岚姐",
            "text": "但到现在也没人能找到一点宝藏的踪迹…",
            "choices": [
                {
                    "id": "718120108",
                    "text": "我能试试吗？",
                    "response": [
                        {
                            "id": "718120109",
                            "speaker": "岚姐",
                            "text": "唔，可以是可以。"
                        },
                        {
                            "id": "718120113",
                            "speaker": "岚姐",
                            "text": "如果你真有兴趣的话，试试看也没什么问题。"
                        },
                        {
                            "id": "718120114",
                            "speaker": "岚姐",
                            "text": "我把那个线索里提到的地点给你标在地图上，你先去那边看看吧。"
                        }
                    ]
                },
                {
                    "id": "718120110",
                    "text": "要是真的找到了什么宝贝…",
                    "response": [
                        {
                            "id": "718120111",
                            "speaker": "岚姐",
                            "text": "那就按照冒险家的规矩，谁找到的就归谁。"
                        },
                        {
                            "id": "718120112",
                            "speaker": "岚姐",
                            "text": "协会想要的只是解开这些谜题的「经验」。对冒险家来说，这才是最重要的东西。"
                        }
                    ]
                }
            ]
        }
    ]
}