{
    "talkId": "6903807",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "阿贝多": 16
    },
    "dialogues": [
        {
            "id": "690380701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690380302",
            "speaker": "阿贝多",
            "text": "当然。"
        },
        {
            "id": "690380303",
            "speaker": "阿贝多",
            "text": "啊…话题就交给你来决定吧。",
            "choices": [
                {
                    "id": "690380304",
                    "text": "阿贝多很喜欢画画呢…",
                    "response": [
                        {
                            "id": "690380305",
                            "speaker": "阿贝多",
                            "text": "嗯，这是很久以前养成的习惯了。"
                        },
                        {
                            "id": "690380306",
                            "speaker": "阿贝多",
                            "text": "最初为了研究需要，我尝试过将事物用类似拓印的手法复现在纸上。"
                        },
                        {
                            "id": "690380307",
                            "speaker": "阿贝多",
                            "text": "不过那样效果不好，也缺乏灵魂。"
                        },
                        {
                            "id": "690380308",
                            "speaker": "阿贝多",
                            "text": "后来，就试着学习了绘画。"
                        },
                        {
                            "id": "690380309",
                            "speaker": "阿贝多",
                            "text": "掌握绘画技巧的同时，不知不觉已经沉浸其中了。"
                        },
                        {
                            "id": "690380316",
                            "speaker": "阿贝多",
                            "text": "唔，除此之外的话…"
                        },
                        {
                            "id": "690380317",
                            "speaker": "阿贝多",
                            "text": "大概是你吧。"
                        },
                        {
                            "id": "690380318",
                            "speaker": "阿贝多",
                            "text": "一开始是因为你身上星海的气息…"
                        },
                        {
                            "id": "690380319",
                            "speaker": "阿贝多",
                            "text": "但现在…似乎不止是这样子。"
                        },
                        {
                            "id": "690380320",
                            "speaker": "阿贝多",
                            "text": "这是为什么呢？再给我多一些时间，我肯定能研究明白的。"
                        }
                    ]
                },
                {
                    "id": "690380310",
                    "text": "阿贝多很喜欢实验呢…",
                    "response": [
                        {
                            "id": "690380311",
                            "speaker": "阿贝多",
                            "text": "嗯，对我来说，世界是一座没有边界的书库。"
                        },
                        {
                            "id": "690380312",
                            "speaker": "阿贝多",
                            "text": "在实验中研究各种各样的课题…"
                        },
                        {
                            "id": "690380313",
                            "speaker": "阿贝多",
                            "text": "亲手揭开未知的秘密，最后掌握新的知识。"
                        },
                        {
                            "id": "690380314",
                            "speaker": "阿贝多",
                            "text": "这种感觉，令人着迷。"
                        }
                    ]
                },
                {
                    "id": "690380315",
                    "text": "阿贝多还有什么感兴趣的吗？"
                }
            ]
        }
    ]
}