{
    "talkId": "6900903",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "久岐忍": 16
    },
    "dialogues": [
        {
            "id": "690090301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690090302",
            "speaker": "久岐忍",
            "text": "可以啊，闲着也是闲着，想问什么就直接问吧。"
        },
        {
            "id": "690090303",
            "speaker": "Player",
            "text": "阿忍为什么讨厌巫女呢？"
        },
        {
            "id": "690090304",
            "speaker": "久岐忍",
            "text": "我想你可能误会了…"
        },
        {
            "id": "690090305",
            "speaker": "久岐忍",
            "text": "我并不讨厌任何一位具体的巫女，也不针对巫女这个职业。我深知每一项工作都很不容易…"
        },
        {
            "id": "690090306",
            "speaker": "久岐忍",
            "text": "只是巫女这个职业真的不适合我。这里面的原因很复杂，我得想想怎么解释比较好…",
            "choices": [
                {
                    "id": "690090307",
                    "text": "是家里的原因吗？",
                    "response": [
                        {
                            "id": "690090308",
                            "speaker": "久岐忍",
                            "text": "嗯…让你见笑了。的确有跟家里赌气的成分…"
                        },
                        {
                            "id": "690090309",
                            "speaker": "久岐忍",
                            "text": "我知道家里人是为我好，但以这个名义为我安排好所有事情，反倒让我不自在。"
                        },
                        {
                            "id": "690090310",
                            "speaker": "久岐忍",
                            "text": "总觉得我是孩子，事事都要叮嘱我别出错。每次接到来信投诉我态度冷淡，都要说上个三天三夜。"
                        },
                        {
                            "id": "690090311",
                            "speaker": "久岐忍",
                            "text": "我本来就不爱笑，根本不是故意对人冷淡…"
                        },
                        {
                            "id": "690090318",
                            "speaker": "Player",
                            "text": "能够理解…"
                        },
                        {
                            "id": "690090319",
                            "speaker": "久岐忍",
                            "text": "总之，还是那些评判标准清晰明了的、付出了就能看到实际效果的工作更适合我。"
                        },
                        {
                            "id": "690090320",
                            "speaker": "久岐忍",
                            "text": "做起来得心应手，也可以让家里人知道，我的选择未必不如他们。"
                        },
                        {
                            "id": "690090321",
                            "speaker": "久岐忍",
                            "text": "最最重要的是，现在的我不用勉强自己，可以过一种相对自由的人生。"
                        }
                    ]
                },
                {
                    "id": "690090312",
                    "text": "是自己的原因吗？",
                    "response": [
                        {
                            "id": "690090313",
                            "speaker": "久岐忍",
                            "text": "嗯，可能是吧。"
                        },
                        {
                            "id": "690090314",
                            "speaker": "久岐忍",
                            "text": "很多人求签只是为了讨得吉利，对签文上的结果也不算太在意。"
                        },
                        {
                            "id": "690090315",
                            "speaker": "久岐忍",
                            "text": "但也有些人，他们由于种种原因陷入困境，就把祈愿作为自己最后的救命稻草…"
                        },
                        {
                            "id": "690090316",
                            "speaker": "久岐忍",
                            "text": "渴望有天降的力量帮自己解决一切。"
                        },
                        {
                            "id": "690090317",
                            "speaker": "久岐忍",
                            "text": "我是不认可的。我也没法说出「总会好起来的」这种不太负责的话。"
                        }
                    ]
                }
            ]
        }
    ]
}