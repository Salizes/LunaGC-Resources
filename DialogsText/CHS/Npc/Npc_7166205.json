{
    "talkId": "7166205",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "宏朗": 10,
        "派蒙": 1
    },
    "dialogues": [
        {
            "id": "716620501",
            "speaker": "宏朗",
            "text": "这座秘境…到底有什么秘密…",
            "choices": [
                {
                    "id": "716620502",
                    "text": "关于秘境最开始的模样…",
                    "response": [
                        {
                            "id": "716620503",
                            "speaker": "宏朗",
                            "text": "嗯…老实说，我们也不能确定，这座秘境「最开始」到底是什么模样。"
                        },
                        {
                            "id": "716620504",
                            "speaker": "派蒙",
                            "text": "你不是说，最开始这里是灰蒙蒙的，像一间空荡荡的大房子吗？"
                        },
                        {
                            "id": "716620505",
                            "speaker": "宏朗",
                            "text": "但是…这也是那一支冒险队的「心愿」。"
                        },
                        {
                            "id": "716620506",
                            "speaker": "宏朗",
                            "text": "在进入这座秘境时，他们所有人心中都只有一个念头…"
                        },
                        {
                            "id": "716620507",
                            "speaker": "宏朗",
                            "text": "「希望这个秘境是一个从来没人探索过的未知区域。」"
                        },
                        {
                            "id": "716620508",
                            "speaker": "宏朗",
                            "text": "然后这座秘境依照他们的心愿，变成了那样的诡异样子。"
                        },
                        {
                            "id": "716620509",
                            "speaker": "宏朗",
                            "text": "至于这座秘境最开始到底是什么样…我想，也许真的是「什么也没有」吧。"
                        }
                    ]
                },
                {
                    "id": "716620510",
                    "text": "在这里冒险安全吗？",
                    "response": [
                        {
                            "id": "716620511",
                            "speaker": "宏朗",
                            "text": "只要你按照我说的来操作，肯定不会出什么问题。"
                        },
                        {
                            "id": "716620512",
                            "speaker": "宏朗",
                            "text": "但我个人建议，还是不要…让自己有什么过于庞大的心愿，以免出现某些…不可预知的情况。"
                        }
                    ]
                },
                {
                    "id": "716620513",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "716620514",
                            "speaker": "宏朗",
                            "text": "嗯，再见，你可要小心操纵这座秘境啊。"
                        }
                    ]
                }
            ]
        }
    ]
}