{
    "talkId": "6911909",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "菈乌玛": 11
    },
    "dialogues": [
        {
            "id": "691190401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691190402",
            "speaker": "菈乌玛",
            "text": "有是有，不过不是现在。"
        },
        {
            "id": "691190403",
            "speaker": "菈乌玛",
            "text": "挪德卡莱有些人迹罕至的美丽林区，闲暇时我经常去那里休息。"
        },
        {
            "id": "691190404",
            "speaker": "菈乌玛",
            "text": "大概因为我身体里流淌着一些非同常人的血脉吧…我总是很在意周围的水是否洁净，风是否轻柔。"
        },
        {
            "id": "691190405",
            "speaker": "菈乌玛",
            "text": "也因此，能彻底放松下来的时间会比普通人少一些。"
        },
        {
            "id": "691190406",
            "speaker": "菈乌玛",
            "text": "唯独在那些地方，我能忘记正在忙碌的事。泡在水潭里发呆，一不小心就从四肢变成六肢了。"
        },
        {
            "id": "691190407",
            "speaker": "Player",
            "text": "好稀奇的场面。"
        },
        {
            "id": "691190408",
            "speaker": "菈乌玛",
            "text": "嗯。多了两肢，生活多少也能便利一些。"
        },
        {
            "id": "691190409",
            "speaker": "菈乌玛",
            "text": "不好意思，这个话题会不会太小众了？",
            "choices": [
                {
                    "id": "691190410",
                    "text": "没关系，我觉得还是挺稀奇的！",
                    "response": [
                        {
                            "id": "691190411",
                            "speaker": "菈乌玛",
                            "text": "你能这么说我就放心了。"
                        },
                        {
                            "id": "691190412",
                            "speaker": "菈乌玛",
                            "text": "果然，交朋友还是要多交一些见识广的。"
                        }
                    ]
                },
                {
                    "id": "691190413",
                    "text": "六肢的感觉会很奇怪吗？",
                    "response": [
                        {
                            "id": "691190414",
                            "speaker": "菈乌玛",
                            "text": "不会，我已经习惯了。而且，四足奔跑的速度优势太大，体验过绝对放弃不了。"
                        },
                        {
                            "id": "691190415",
                            "speaker": "Player",
                            "text": "难怪菈乌玛有时会不顾一切向前进取…"
                        },
                        {
                            "id": "691190416",
                            "speaker": "菈乌玛",
                            "text": "是的。如你所说，这确实也是高速奔跑的惯性。"
                        }
                    ]
                }
            ]
        }
    ]
}