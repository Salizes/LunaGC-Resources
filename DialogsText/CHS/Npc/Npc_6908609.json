{
    "talkId": "6908609",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "莱欧斯利": 14
    },
    "dialogues": [
        {
            "id": "690860401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690860402",
            "speaker": "莱欧斯利",
            "text": "我想在这里到处转转，你不介意吧？",
            "choices": [
                {
                    "id": "690860403",
                    "text": "没关系，反正我也没法一直盯着你。",
                    "response": [
                        {
                            "id": "690860404",
                            "speaker": "莱欧斯利",
                            "text": "且不谈武力强弱，如果你拒绝，我肯定不会四处乱逛。"
                        },
                        {
                            "id": "690860405",
                            "speaker": "莱欧斯利",
                            "text": "不过你也算是对我有些了解了，我的确不习惯在自己不熟悉的地方久留。"
                        },
                        {
                            "id": "690860408",
                            "speaker": "莱欧斯利",
                            "text": "但这里是你家，应该不会有什么危险的，对吧？"
                        },
                        {
                            "id": "690860409",
                            "speaker": "莱欧斯利",
                            "text": "我只是出于好奇，想在这片似乎无边无际的神奇天地里闲逛一番，就像旅游一样。"
                        },
                        {
                            "id": "690860410",
                            "speaker": "Player",
                            "text": "还可以切换其他地区的景色哦。"
                        },
                        {
                            "id": "690860411",
                            "speaker": "莱欧斯利",
                            "text": "这么厉害？"
                        },
                        {
                            "id": "690860412",
                            "speaker": "莱欧斯利",
                            "text": "也就是说，只要你想，就能足不出壶地周游各国？",
                            "choices": [
                                {
                                    "id": "690860413",
                                    "text": "你想试试吗？",
                                    "response": [
                                        {
                                            "id": "690860415",
                                            "speaker": "莱欧斯利",
                                            "text": "哈哈，这对我来说肯定是难能可贵的机会。"
                                        },
                                        {
                                            "id": "690860416",
                                            "speaker": "莱欧斯利",
                                            "text": "如果有想要的东西就该去争取，不是吗？"
                                        },
                                        {
                                            "id": "690860417",
                                            "speaker": "Player",
                                            "text": "我可以切换给你看哦。"
                                        },
                                        {
                                            "id": "690860418",
                                            "speaker": "莱欧斯利",
                                            "text": "衷心感谢。"
                                        },
                                        {
                                            "id": "690860419",
                                            "speaker": "莱欧斯利",
                                            "text": "当然，我也知道世上不应当有白拿的午餐。"
                                        },
                                        {
                                            "id": "690860420",
                                            "speaker": "莱欧斯利",
                                            "text": "所以需要我帮忙的时候无需顾虑，水下永远欢迎你的到访。"
                                        },
                                        {
                                            "id": "690860421",
                                            "speaker": "莱欧斯利",
                                            "text": "——当然，不作为犯人下来的话最好。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690860414",
                                    "text": "兴趣已经写在脸上了哦。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690860406",
                    "text": "还以为你肯定已经探索过了。",
                    "response": [
                        {
                            "id": "690860407",
                            "speaker": "莱欧斯利",
                            "text": "如果换个地方的话…的确，我至少要先确保周边是安全的。"
                        }
                    ]
                }
            ]
        }
    ]
}