    "dialogues": [
        {
            "id": "4015142504",
            "speaker": "Player",
            "text": "关于塞西莉亚花。"
        },
        {
            "id": "4015142513",
            "speaker": "芙萝拉",
            "text": "塞西莉亚花呀，你可真有品味呢。"
        },
        {
            "id": "4015142514",
            "speaker": "芙萝拉",
            "text": "耐寒，喜风，传说只会在安静的地方开放。"
        },
        {
            "id": "4015142515",
            "speaker": "芙萝拉",
            "text": "如果想要培育的话…"
        },
        {
            "id": "4015142516",
            "speaker": "芙萝拉",
            "text": "呼呼，或许比养冰雾花还要难呢！"
        }
    ]
}