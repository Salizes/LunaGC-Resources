    "dialogues": [
        {
            "id": "671020401",
            "speaker": "Player",
            "text": "那你想干什么？"
        },
        {
            "id": "671020402",
            "speaker": "欧西安",
            "text": "我？我当然想去冒险啊！就像那些自由自在的宝藏猎人，或者传说中的大盗雷德·米勒那样！"
        },
        {
            "id": "671020403",
            "speaker": "欧西安",
            "text": "探索未知的秘境，寻找传说中的宝藏，和温馨又迷人的美丽少女们一起冒险…这才是我应该做的事嘛！"
        }
    ]
}