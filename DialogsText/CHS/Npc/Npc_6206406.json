    "dialogues": [
        {
            "id": "620640601",
            "speaker": "Player",
            "text": "关于岩王帝君的死…"
        },
        {
            "id": "620640602",
            "speaker": "宏宇",
            "text": "「请仙典仪」的时候我也在场，当时七星下令，让我们缄口不言。"
        },
        {
            "id": "620640603",
            "speaker": "宏宇",
            "text": "如今「送仙典仪」也办了，这件事已经人尽皆知了，我们千岩军也就不用再守口如瓶了…"
        },
        {
            "id": "620640604",
            "speaker": "宏宇",
            "text": "不过话虽如此…抱歉，我不想聊这个话题。"
        },
        {
            "id": "620640605",
            "speaker": "宏宇",
            "text": "岩王爷…唉…"
        }
    ]
}