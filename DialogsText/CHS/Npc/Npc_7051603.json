    "dialogues": [
        {
            "id": "705160301",
            "speaker": "麦克",
            "text": "你好，我是西风骑士麦克，请停步。"
        },
        {
            "id": "705160302",
            "speaker": "麦克",
            "text": "鹰翔海滩附近正在进行骑士团的实战训练，暂时禁止普通民众接近。",
            "choices": [
                {
                    "id": "705160303",
                    "text": "可是海滩附近好像没有骑士…",
                    "response": [
                        {
                            "id": "705160304",
                            "speaker": "麦克",
                            "text": "参加训练的骑士们正在集结，再过不久就会赶来。"
                        },
                        {
                            "id": "705160305",
                            "speaker": "麦克",
                            "text": "请赶快回到蒙德城内去吧，战斗训练没什么好看的，万一被误伤到就不妙了。"
                        }
                    ]
                },
                {
                    "id": "705160306",
                    "text": "可是海滩附近好像有些魔物…",
                    "response": [
                        {
                            "id": "705160307",
                            "speaker": "麦克",
                            "text": "如你所见，那正是骑士们需要击败的训练目标。"
                        },
                        {
                            "id": "705160308",
                            "speaker": "麦克",
                            "text": "请赶快回到蒙德城内去吧，战斗训练没什么好看的，万一被误伤到就不妙了。"
                        }
                    ]
                }
            ]
        }
