    "dialogues": [
        {
            "id": "641900201",
            "speaker": "Player",
            "text": "关于无忧节…"
        },
        {
            "id": "641900202",
            "speaker": "兰贡迪",
            "text": "#我们又相见了，那菈{NICKNAME}。"
        },
        {
            "id": "641900203",
            "speaker": "兰贡迪",
            "text": "#那菈{NICKNAME}要在无忧节唱歌吧，那一定是和太阳和月亮的光亮交织、天空与湖水重叠、露珠与雨水握手一样的旋律。"
        },
        {
            "id": "641900204",
            "speaker": "兰贡迪",
            "text": "#派蒙也要和那菈{NICKNAME}一起唱，不要偷懒。"
        }
    ]
}