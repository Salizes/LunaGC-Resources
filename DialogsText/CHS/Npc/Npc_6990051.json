{
    "talkId": "6990051",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 10,
        "派蒙": 13
    },
    "dialogues": [
        {
            "id": "699005101",
            "speaker": "Player",
            "text": "关于天才机械师…"
        },
        {
            "id": "699005102",
            "speaker": "派蒙",
            "text": "爱诺不愧是天才机械师，她的发明都好有…呃，想法？"
        },
        {
            "id": "699005103",
            "speaker": "派蒙",
            "text": "总能用意想不到的材料做出意料之外的造型，还能有远超预期的效果！"
        },
        {
            "id": "699005104",
            "speaker": "Player",
            "text": "派蒙又看上哪个发明了？"
        },
        {
            "id": "699005105",
            "speaker": "派蒙",
            "text": "扫地机就很不错呢！"
        },
        {
            "id": "699005106",
            "speaker": "派蒙",
            "text": "不如我们也请爱诺帮我们做一台，平时可以放在尘歌壶里打扫卫生，多方便呀！"
        },
        {
            "id": "699005107",
            "speaker": "Player",
            "text": "就只需要扫地机吗？"
        },
        {
            "id": "699005108",
            "speaker": "派蒙",
            "text": "你说得对噢，都找上天才爱诺了，干脆一不做二不休，再来些有擦拭功能的机械，还有会收纳整理的，浇花的，喂养宠物的…"
        },
        {
            "id": "699005109",
            "speaker": "派蒙",
            "text": "最好还有会聊天的，这样我们不在的时候阿圆也不会无聊了。"
        },
        {
            "id": "699005110",
            "speaker": "Player",
            "text": "还有什么补充要求？"
        },
        {
            "id": "699005111",
            "speaker": "派蒙",
            "text": "我想想…烹饪机可有可无吧，上次尝了机关烹饪神机的手艺，但我还是最喜欢吃你做的菜，嘿嘿。"
        },
        {
            "id": "699005112",
            "speaker": "派蒙",
            "text": "哦，有一点很重要，可以的话，我希望这些功能全都集中在一台机械上，不占地方！",
            "choices": [
                {
                    "id": "699005113",
                    "text": "派蒙想要的莫非是…",
                    "response": [
                        {
                            "id": "699005115",
                            "speaker": "派蒙",
                            "text": "哈？！好像是哦…伊涅芙就能完美做到这些…",
                            "choices": [
                                {
                                    "id": "699005116",
                                    "text": "而且还远远不止这些哦。",
                                    "response": [
                                        {
                                            "id": "699005118",
                                            "speaker": "派蒙",
                                            "text": "呜…你该不会想把向导的工作交给别人吧？！"
                                        },
                                        {
                                            "id": "699005119",
                                            "speaker": "派蒙",
                                            "text": "不不不不绝对不行，伊涅芙只有一个，她还有爱诺要照顾，我们不能拆散她们！"
                                        },
                                        {
                                            "id": "699005120",
                                            "speaker": "派蒙",
                                            "text": "我也很喜欢伊涅芙没错，但、但是我们壶里的活很简单，没必要屈才啦你说对不对？",
                                            "choices": [
                                                {
                                                    "id": "699005121",
                                                    "text": "好啦派蒙就是我最好的向导…",
                                                    "response": [
                                                        {
                                                            "id": "699005123",
                                                            "speaker": "派蒙",
                                                            "text": "哼哼，这还差不多。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "699005122",
                                                    "text": "也没有人能够拆散我们哦。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "699005117",
                                    "text": "就连旅行向导也做得不错…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699005114",
                    "text": "叫「伊涅芙」的全能型家用机器人？"
                }
            ]
        }
    ]
}