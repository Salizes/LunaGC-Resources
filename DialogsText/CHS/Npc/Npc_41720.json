        {
            "id": "4015142904",
            "speaker": "Player",
            "text": "关于向巴巴托斯祈祷。"
        },
        {
            "id": "4015142910",
            "speaker": "葛瑞丝",
            "text": "想要向巴巴托斯大人祈祷的话，只要在起风的时候悄悄说出愿望…"
        },
        {
            "id": "4015142911",
            "speaker": "葛瑞丝",
            "text": "风就会把你的愿望带给巴巴托斯大人了。"
        }
    ]
