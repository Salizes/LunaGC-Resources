    "dialogues": [
        {
            "id": "618010301",
            "speaker": "洛恩",
            "text": "呵…这下就天衣无缝了…"
        },
        {
            "id": "618010302",
            "speaker": "Player",
            "text": "洛恩你这是在…写报告？"
        },
        {
            "id": "618010303",
            "speaker": "派蒙",
            "text": "真意外，我还以为你会比法尔伽更讨厌这些文书工作…"
        },
        {
            "id": "618010304",
            "speaker": "洛恩",
            "text": "怎么会呢，这也是一队之长应尽的责任啊，虽然我还只是副队长。"
        },
        {
            "id": "618010305",
            "speaker": "洛恩",
            "text": "这份报告关系到远征军回归后的人事安排，还需要远征时主管行政的西蒙枢机卿过目。"
        },
        {
            "id": "618010306",
            "speaker": "洛恩",
            "text": "对了，你要是刚好有空回蒙德城一趟，干脆顺手帮我捎过去？",
            "choices": [
                {
                    "id": "618010307",
                    "text": "可以倒是可以…",
                    "response": [
                        {
                            "id": "618010309",
                            "speaker": "洛恩",
                            "text": "哈哈，就是因为很重要，所以才想托付给你嘛，「荣誉骑士」。"
                        }
                    ]
                },
                {
                    "id": "618010308",
                    "text": "但这不是很重要的文件吗？"
                }
            ]
        }
    ]
}