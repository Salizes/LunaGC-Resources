    "dialogues": [
        {
            "id": "641600301",
            "speaker": "Player",
            "text": "可能是因为没办法…"
        },
        {
            "id": "641600302",
            "speaker": "阿米",
            "text": "什么样的人只能在外面做饭呀？是因为没有家吗？"
        },
        {
            "id": "641600303",
            "speaker": "阿米",
            "text": "那的确没办法了，好可怜啊。"
        },
        {
            "id": "641600304",
            "speaker": "阿米",
            "text": "但爸爸明明有家啊，为什么还要在外面搭锅子呢？"
        },
        {
            "id": "641600305",
            "speaker": "阿米",
            "text": "难道是为了那些没有家的人吗？"
        },
        {
            "id": "641600306",
            "speaker": "阿米",
            "text": "唔，我好像有点理解了…"
        },
        {
            "id": "641600307",
            "speaker": "阿米",
            "text": "欸不对，那爸爸自己为什么也要在露天的锅子里做饭啊？"
        },
        {
            "id": "641600308",
            "speaker": "阿米",
            "text": "我又不懂了！"
        }
    ]
}