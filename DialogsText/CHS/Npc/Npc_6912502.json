{
    "talkId": "6912502",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 8,
        "哥伦比娅": 10
    },
    "dialogues": [
        {
            "id": "691250201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691250202",
            "speaker": "哥伦比娅",
            "text": "唔…其实不太习惯。"
        },
        {
            "id": "691250203",
            "speaker": "Player",
            "text": "欸…是太吵闹了吗？"
        },
        {
            "id": "691250204",
            "speaker": "哥伦比娅",
            "text": "不，和那没关系。"
        },
        {
            "id": "691250205",
            "speaker": "哥伦比娅",
            "text": "只是以前都是你到我住的地方来做客，现在我突然变成了客人，有些不习惯。"
        },
        {
            "id": "691250206",
            "speaker": "哥伦比娅",
            "text": "我应该做些什么呢？陪你聊聊天？还是和你一起做游戏？",
            "choices": [
                {
                    "id": "691250207",
                    "text": "把这里当成「家」…",
                    "response": [
                        {
                            "id": "691250209",
                            "speaker": "哥伦比娅",
                            "text": "真的吗？唔…那，我可以在附近一边散步一边唱歌吗？"
                        },
                        {
                            "id": "691250210",
                            "speaker": "Player",
                            "text": "当然可以。"
                        },
                        {
                            "id": "691250211",
                            "speaker": "哥伦比娅",
                            "text": "也可以想休息的时候，就随便找一个地方睡下？"
                        },
                        {
                            "id": "691250212",
                            "speaker": "Player",
                            "text": "需要枕头就叫我。"
                        },
                        {
                            "id": "691250213",
                            "speaker": "哥伦比娅",
                            "text": "采一些你种的花草也没事吗？就像你偶尔会到银月之庭采走月落银那样。",
                            "choices": [
                                {
                                    "id": "691250214",
                                    "text": "原来你都知道…",
                                    "response": [
                                        {
                                            "id": "691250216",
                                            "speaker": "哥伦比娅",
                                            "text": "哈哈，开个小玩笑。如果它们能帮到你的旅途，我自然不会介意的。"
                                        },
                                        {
                                            "id": "691250217",
                                            "speaker": "哥伦比娅",
                                            "text": "你将这里的景致打理得很舒心，我静静享受它们就已经很满足了。"
                                        },
                                        {
                                            "id": "691250218",
                                            "speaker": "哥伦比娅",
                                            "text": "唔…是不是我也该试着装点一下银月之庭了呢？"
                                        }
                                    ]
                                },
                                {
                                    "id": "691250215",
                                    "text": "原来你记仇了…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691250208",
                    "text": "做你想做的就好…"
                }
            ]
        }
    ]
}