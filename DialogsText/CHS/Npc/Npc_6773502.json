    "dialogues": [
        {
            "id": "677350201",
            "speaker": "Player",
            "text": "所以…你是在找书吗？"
        },
        {
            "id": "677350202",
            "speaker": "丛沈",
            "text": "你曾到过此地么？",
            "choices": [
                {
                    "id": "677350203",
                    "text": "啊？",
                    "response": [
                        {
                            "id": "677350206",
                            "speaker": "丛沈",
                            "text": "那你便会了。",
                            "choices": [
                                {
                                    "id": "677350207",
                                    "text": "会…会什么了？",
                                    "response": [
                                        {
                                            "id": "677350209",
