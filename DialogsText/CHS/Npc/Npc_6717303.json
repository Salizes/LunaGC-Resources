{
    "talkId": "6717303",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Black Screen": 2,
        "Player": 3,
        "派蒙": 2,
        "爱可菲": 15
    },
    "dialogues": [
        {
            "id": "671730322",
            "speaker": "Black Screen",
            "text": "在柜台后站定不久，就有一位客人来访…"
        },
        {
            "id": "671730301",
            "speaker": "爱可菲",
            "text": "这里应该就是「秘闻馆」…咦？"
        },
        {
            "id": "671730302",
            "speaker": "爱可菲",
            "text": "#{NICKNAME}，派蒙？真是巧了，居然在这里遇见你们。"
        },
        {
            "id": "671730303",
            "speaker": "爱可菲",
            "text": "你们这是在…",
            "choices": [
                {
                    "id": "671730304",
                    "text": "帮朋友代班啦。",
                    "response": [
                        {
                            "id": "671730306",
                            "speaker": "爱可菲",
                            "text": "欸…你们也不容易啊。"
                        },
                        {
                            "id": "671730307",
                            "speaker": "爱可菲",
                            "text": "对了，你们认识一个机器女孩么？她身上带着一股很浓郁的蛋卷味。"
                        },
                        {
                            "id": "671730308",
                            "speaker": "爱可菲",
                            "text": "而且，这种蛋卷的香气非常的…单纯，闻起来并没有使用太多的复合香料。"
                        },
                        {
                            "id": "671730309",
                            "speaker": "爱可菲",
                            "text": "在这个年头，单纯到这个地步的蛋卷可不常见，我还挺好奇这种蛋卷配方的。"
                        },
                        {
                            "id": "671730310",
                            "speaker": "爱可菲",
                            "text": "可是，我还没来得及问她，这机器女孩就走远了。"
                        },
                        {
                            "id": "671730311",
                            "speaker": "派蒙",
                            "text": "蛋卷…机器女孩…那肯定是伊涅芙啦。"
                        },
                        {
                            "id": "671730312",
                            "speaker": "爱可菲",
                            "text": "你们认识？那太好了，她住在哪里？我想要去拜访一下。"
                        },
                        {
                            "id": "671730313",
                            "speaker": "爱可菲",
                            "text": "那个机器人女孩喜欢吃…呃，她应该不吃普通的食物吧，我给她买点…机油？"
                        },
                        {
                            "id": "671730314",
                            "speaker": "Player",
                            "text": "倒是可以给爱诺带点好吃的…"
                        },
                        {
                            "id": "671730315",
                            "speaker": "爱可菲",
                            "text": "爱诺？这位是…"
                        },
                        {
                            "id": "671730316",
                            "speaker": "Black Screen",
                            "text": "向爱可菲详细叙述了爱诺和伊涅芙的关系，还有她们的住所…"
                        },
                        {
                            "id": "671730317",
                            "speaker": "爱可菲",
                            "text": "原来如此…小孩子吃太多甜的确实不太好。"
                        },
                        {
                            "id": "671730318",
                            "speaker": "派蒙",
                            "text": "这不是重点吧我说…"
                        },
                        {
                            "id": "671730319",
                            "speaker": "爱可菲",
                            "text": "不过，这可难不住我，我知道很多好吃且不甜的小零食。"
                        },
                        {
                            "id": "671730320",
                            "speaker": "爱可菲",
                            "text": "嗯，我这就去借个厨房，等做好了零食，我再去那个工坊拜访。"
                        },
                        {
                            "id": "671730321",
                            "speaker": "爱可菲",
                            "text": "真不错，这一趟挪德卡莱可算是没来错，不仅拿到了新食材，还能见识到特别的配方…"
                        }
                    ]
                },
                {
                    "id": "671730305",
                    "text": "在挪德卡莱工作。"
                }
            ]
        }
    ]
}