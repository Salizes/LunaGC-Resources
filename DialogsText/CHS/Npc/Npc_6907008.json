{
    "talkId": "6907008",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "妮露": 13
    },
    "dialogues": [
        {
            "id": "690700301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690700302",
            "speaker": "妮露",
            "text": "好呀，我很乐意。聊点什么好呢？",
            "choices": [
                {
                    "id": "690700303",
                    "text": "最近在想些什么…",
                    "response": [
                        {
                            "id": "690700304",
                            "speaker": "妮露",
                            "text": "欸？我吗？"
                        },
                        {
                            "id": "690700305",
                            "speaker": "妮露",
                            "text": "我在想，最初的最初，是先有观众，还是先有表演呢？"
                        },
                        {
                            "id": "690700306",
                            "speaker": "妮露",
                            "text": "想要知道真实情况的话，应该是要去寻找相关的文献和资料吧，但这不是我擅长做的事情…"
                        },
                        {
                            "id": "690700307",
                            "speaker": "妮露",
                            "text": "嘿嘿，所以我也只是随便想了想而已…"
                        },
                        {
                            "id": "690700314",
                            "speaker": "妮露",
                            "text": "哎呀，说是聊天，结果都是我一个人在说话…"
                        },
                        {
                            "id": "690700315",
                            "speaker": "妮露",
                            "text": "我要把球高高地抛还给你…来听听你身边发生的事情，还有你认识的人。"
                        },
                        {
                            "id": "690700316",
                            "speaker": "妮露",
                            "text": "和我讲讲吧！我很有兴趣！"
                        }
                    ]
                },
                {
                    "id": "690700308",
                    "text": "关于大巴扎的大家…",
                    "response": [
                        {
                            "id": "690700309",
                            "speaker": "妮露",
                            "text": "嗯，我很喜欢这种家人般的氛围。"
                        },
                        {
                            "id": "690700310",
                            "speaker": "妮露",
                            "text": "虽然大家的性格各不相同，偶尔也会闹些小矛盾…"
                        },
                        {
                            "id": "690700311",
                            "speaker": "妮露",
                            "text": "但要是谁遇到了什么困难，其他人都会发挥自己的长处，毫不保留地提供帮助…"
                        },
                        {
                            "id": "690700312",
                            "speaker": "妮露",
                            "text": "家人不就是这样吗？"
                        },
                        {
                            "id": "690700313",
                            "speaker": "妮露",
                            "text": "经常吵吵闹闹，但永远都是彼此最坚强的后盾。"
                        }
                    ]
                }
            ]
        }
    ]
}