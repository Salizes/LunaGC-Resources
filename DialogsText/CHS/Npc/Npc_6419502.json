    "dialogues": [
        {
            "id": "641950201",
            "speaker": "Player",
            "text": "关于兰帕卡提…"
        },
        {
            "id": "641950202",
            "speaker": "兰非拉",
            "text": "刚刚给了妹妹几颗「鲜嫩无朋之果」，她吃了果子，不那么生气了。"
        },
        {
            "id": "641950203",
            "speaker": "兰非拉",
            "text": "她上一次生气还是因为我们在桓那兰那弄出了许多烟。"
        },
        {
            "id": "641950204",
            "speaker": "兰非拉",
            "text": "等到下次，我再给她几颗「鲜嫩无朋之果」…"
        },
        {
            "id": "641950205",
            "speaker": "兰非拉",
            "text": "不对，还是不要有下次。"
        }
    ]
}