    "speaker_counts": {
        "Player": 3,
        "奥兹": 1,
        "菲谢尔": 6
    },
    "dialogues": [
        {
            "id": "690310901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690310202",
            "speaker": "菲谢尔",
            "text": "我尽览三千世界的盛景，通晓过去与未来的殊途。"
        },
        {
            "id": "690310203",
            "speaker": "菲谢尔",
            "text": "此地此景，勉强值得一观吧。",
            "choices": [
                {
                    "id": "690310204",
                    "text": "菲谢尔真严格啊。",
                    "response": [
                        {
                            "id": "690310205",
                            "speaker": "菲谢尔",
                            "text": "哼，皇女所领略过的万象，是凡人穷尽一生也无法想象的。"
                        },
                        {
                            "id": "690310208",
                            "speaker": "菲谢尔",
                            "text": "同我的幽夜净土相比，此处不过渺小一粟。"
                        },
                        {
                            "id": "690310209",
                            "speaker": "奥兹",
                            "text": "可之前小姐还说，想多在这里待一会儿的。"
                        },
                        {
                            "id": "690310210",
                            "speaker": "菲谢尔",
                            "text": "#那…那只是对{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}同为异世界之人的惦念罢了！"
                        }
                    ]
                },
                {
                    "id": "690310206",
                    "text": "菲谢尔喜欢就好。",
                    "response": [
                        {
                            "id": "690310207",
                            "speaker": "菲谢尔",
                            "text": "哼，也就较那凡尘俗世略为清净罢了。"
                        }
                    ]
                }
            ]
        }
    ]
}