    "dialogues": [
        {
            "id": "618010201",
            "speaker": "洛恩",
            "text": "…下次要去突袭哪里的倒霉蛋呢？"
        },
        {
            "id": "618010202",
            "speaker": "Player",
            "text": "你又在打什么主意？"
        },
        {
            "id": "618010203",
            "speaker": "洛恩",
            "text": "啊，你来得正好，荣誉骑士，能不能帮我参谋参谋。"
        },
        {
            "id": "618010204",
            "speaker": "洛恩",
            "text": "火烤雷史莱姆，跟冰封水史莱姆…你觉得哪边打起来更能放松心情？"
        },
        {
            "id": "618010205",
            "speaker": "洛恩",
            "text": "雷史莱姆一下子被炸飞出去的声音确实不错，但往冰坨里一扎到底的手感也让人心动啊。",
            "choices": [
                {
                    "id": "618010206",
                    "text": "不如先把水史莱姆冻住…",
                    "response": [
                        {
                            "id": "618010208",
                            "speaker": "洛恩",
                            "text": "哦？这想法不错嘛，改天要不要一起？"
                        }
                    ]
                },
                {
                    "id": "618010207",
                    "text": "再在边上火烤雷史莱姆。"
                }
            ]
        }
    ]
}