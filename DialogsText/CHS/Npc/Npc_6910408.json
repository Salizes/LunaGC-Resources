{
    "talkId": "6910408",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 10,
        "恰斯卡": 18
    },
    "dialogues": [
        {
            "id": "691040301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691040302",
            "speaker": "恰斯卡",
            "text": "好啊，刚好我有点事想问问你。"
        },
        {
            "id": "691040303",
            "speaker": "Player",
            "text": "嗯？什么事？"
        },
        {
            "id": "691040304",
            "speaker": "恰斯卡",
            "text": "那边那位…名字是叫阿圆对吗？你知道她是怎么浮起来的吗？"
        },
        {
            "id": "691040305",
            "speaker": "恰斯卡",
            "text": "明明看起来圆滚滚沉甸甸的，也看不出有什么动力源，却能一直保持滞空状态…"
        },
        {
            "id": "691040306",
            "speaker": "恰斯卡",
            "text": "要是能弄清楚是什么原理，说不定我就能带着更多火力上天了。"
        },
        {
            "id": "691040307",
            "speaker": "Player",
            "text": "估计是璃月的仙术…"
        },
        {
            "id": "691040308",
            "speaker": "恰斯卡",
            "text": "「仙术」？我从前也听人说起过，当时就觉得不可思议，可惜故事里的「仙人」总是难得一见。"
        },
        {
            "id": "691040309",
            "speaker": "Player",
            "text": "要不直接问问阿圆？"
        },
        {
            "id": "691040310",
            "speaker": "恰斯卡",
            "text": "嗯，我已经跟她打过招呼了，也试着问过。"
        },
        {
            "id": "691040311",
            "speaker": "恰斯卡",
            "text": "…不过她似乎有点害怕，说我盯着她的眼神就像盯着小鸟的猛禽…"
        },
        {
            "id": "691040312",
            "speaker": "Player",
            "text": "我觉得可能更像绒翼龙…"
        },
        {
            "id": "691040313",
            "speaker": "恰斯卡",
            "text": "是吗？唔…绒翼龙的一些特征确实挺像猛禽的。",
            "choices": [
                {
                    "id": "691040314",
                    "text": "比如说眼神吗？",
                    "response": [
                        {
                            "id": "691040315",
                            "speaker": "恰斯卡",
                            "text": "嗯，绒翼龙跟多数猛禽的眉骨突出、双目靠前，是为了在高速机动中保护眼睛，以及更好地从高空锁定目标。"
                        },
                        {
                            "id": "691040316",
                            "speaker": "恰斯卡",
                            "text": "乍一眼看上去，确实会显得有些凶戾。"
                        },
                        {
                            "id": "691040320",
                            "speaker": "Player",
                            "text": "难怪阿圆会害怕…"
                        },
                        {
                            "id": "691040321",
                            "speaker": "恰斯卡",
                            "text": "咳…不过再怎么说，我也不会把阿圆当成猎物的…况且我又不是绒翼龙。"
                        },
                        {
                            "id": "691040322",
                            "speaker": "恰斯卡",
                            "text": "得找个机会调解这场误会了…等等，当事人是不是不能担任调解人？",
                            "choices": [
                                {
                                    "id": "691040323",
                                    "text": "不如送点羽毛护理工具？",
                                    "response": [
                                        {
                                            "id": "691040324",
                                            "speaker": "恰斯卡",
                                            "text": "唔…挺不错的建议，绒翼龙每天都会花上不少时间来打理自己的羽毛。"
                                        },
                                        {
                                            "id": "691040325",
                                            "speaker": "恰斯卡",
                                            "text": "我也学着配过一些羽毛护理喷雾，不但能保持羽毛鲜亮，还能驱虫除味…不知道阿圆能不能用得上。"
                                        }
                                    ]
                                },
                                {
                                    "id": "691040326",
                                    "text": "不如送点亮晶晶的小饰品？",
                                    "response": [
                                        {
                                            "id": "691040327",
                                            "speaker": "恰斯卡",
                                            "text": "哦？你挺懂的嘛。我跟「妈妈」都很乐于收集这类装饰，不知道阿圆喜不喜欢。"
                                        },
                                        {
                                            "id": "691040328",
                                            "speaker": "恰斯卡",
                                            "text": "嗯…看「洞天宝钱」的样式，应该没问题吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691040317",
                    "text": "比如说食性吗？",
                    "response": [
                        {
                            "id": "691040318",
                            "speaker": "恰斯卡",
                            "text": "嗯，绒翼龙和猛禽平时都以肉食为主，都有着尖锐的钩喙和锋利的趾爪。"
                        },
                        {
                            "id": "691040319",
                            "speaker": "恰斯卡",
                            "text": "除了常见的中小型兽类和鱼类，有时还会袭击体型比自己小的鸟类…"
                        }
                    ]
                }
            ]
        }
    ]
}