    "dialogues": [
        {
            "id": "699000701",
            "speaker": "Player",
            "text": "关于猜拳…"
        },
        {
            "id": "699000702",
            "speaker": "派蒙",
            "text": "想马上就能吃到好吃的！但，又不想跑腿…"
        },
        {
            "id": "699000703",
            "speaker": "Player",
            "text": "要用猜拳来决定谁去买吗？"
        },
        {
            "id": "699000704",
            "speaker": "派蒙",
            "text": "好呀好呀！"
        },
        {
            "id": "699000705",
            "speaker": "Player",
            "text": "那么，石头剪刀布——"
        },
        {
            "id": "699000706",
            "speaker": "派蒙",
            "text": "「超级派蒙旋风」！"
        },
        {
            "id": "699000707",
            "speaker": "Player",
            "text": "…欸？"
        }
    ]
}