{
    "talkId": "6904407",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "辛焱": 14
    },
    "dialogues": [
        {
            "id": "690440701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690440302",
            "speaker": "辛焱",
            "text": "好啊！我遇到了个创作难题…陪我换换思路吧！",
            "choices": [
                {
                    "id": "690440303",
                    "text": "辛焱的曲子都是自己写的？",
                    "response": [
                        {
                            "id": "690440304",
                            "speaker": "辛焱",
                            "text": "那是当然的！"
                        },
                        {
                            "id": "690440305",
                            "speaker": "辛焱",
                            "text": "在璃月港，「摇滚」只能算是小众吧。乐迷虽多，创作者却少。"
                        },
                        {
                            "id": "690440306",
                            "speaker": "辛焱",
                            "text": "虽然我也会听来自「枫丹」的作品，但那只是欣赏和学习。"
                        },
                        {
                            "id": "690440307",
                            "speaker": "辛焱",
                            "text": "真正落到创作的时候，还是得亲力亲为，才能配得上「摇滚」二字！"
                        },
                        {
                            "id": "690440313",
                            "speaker": "Player",
                            "text": "真了不起！"
                        },
                        {
                            "id": "690440314",
                            "speaker": "辛焱",
                            "text": "嘿嘿…谢谢你赏识。"
                        },
                        {
                            "id": "690440315",
                            "speaker": "辛焱",
                            "text": "不过…最近倒是有些苦恼。"
                        },
                        {
                            "id": "690440318",
                            "speaker": "辛焱",
                            "text": "新的曲子被乐迷评价「火热中能听出温柔的感觉」，觉得风格变了…"
                        },
                        {
                            "id": "690440319",
                            "speaker": "辛焱",
                            "text": "可能是因为近期心境变化了吧。唔，到底该不该避免呢…"
                        }
                    ]
                },
                {
                    "id": "690440308",
                    "text": "以往会从什么题材入手呢？",
                    "response": [
                        {
                            "id": "690440309",
                            "speaker": "辛焱",
                            "text": "那当然是对「成见」的反抗！"
                        },
                        {
                            "id": "690440310",
                            "speaker": "辛焱",
                            "text": "街头巷尾耳闻目睹的事情，再结合我自身的体验…"
                        },
                        {
                            "id": "690440311",
                            "speaker": "辛焱",
                            "text": "叙述、抒情…最重要的是用足够的「激情」来发问！"
                        },
                        {
                            "id": "690440312",
                            "speaker": "辛焱",
                            "text": "一定要直指灵魂才行！"
                        },
                        {
                            "id": "690440316",
                            "speaker": "Player",
                            "text": "那最近是有什么苦恼呢？"
                        },
                        {
                            "id": "690440317",
                            "speaker": "辛焱",
                            "text": "嗯…"
                        }
                    ]
                }
            ]
        }
    ]
}