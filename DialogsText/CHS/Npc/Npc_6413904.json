    "dialogues": [
        {
            "id": "641390401",
            "speaker": "Player",
            "text": "早几天来？"
        },
        {
            "id": "641390402",
            "speaker": "汝英",
            "text": "是啊。"
        },
        {
            "id": "641390403",
            "speaker": "汝英",
            "text": "掌柜的有说，本来在我隔壁的是一个什么学者，整天都写论文什么的。"
        },
        {
            "id": "641390404",
            "speaker": "汝英",
            "text": "可惜他好像前几天不见了，房间也空了出来，住进去的是一对话说不停的夫妻。"
        },
        {
            "id": "641390405",
            "speaker": "汝英",
            "text": "我要是早来几天，现在都做完生意走人了，又何至于被吵到整晚整晚睡不着…"
        }
    ]
}