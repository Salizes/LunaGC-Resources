    "dialogues": [
        {
            "id": "662110201",
            "speaker": "Player",
            "text": "心情不错？"
        },
        {
            "id": "662110202",
            "speaker": "提帕诺",
            "text": "当然。"
        },
        {
            "id": "662110203",
            "speaker": "提帕诺",
            "text": "在烟谜主巡逻可能是最轻松的事情了，这些人要么找不到人影，要么憋在家里不出门。"
        },
        {
            "id": "662110204",
            "speaker": "提帕诺",
            "text": "一些简单的魔物，也能靠准备好的燃素刻录轻松解决。"
        },
        {
            "id": "662110205",
            "speaker": "提帕诺",
            "text": "主要是别让鲁莽的外人去打扰暝视龙们就好。龙要是闹起脾气来，可不是说着玩的。"
        }
    ]
}