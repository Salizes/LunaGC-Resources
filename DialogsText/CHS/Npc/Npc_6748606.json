    "dialogues": [
        {
            "id": "674860601",
            "speaker": "Player",
            "text": "这是你的工作要求吗？"
        },
        {
            "id": "674860602",
            "speaker": "巴热诺夫",
            "text": "瞧您说的…就算这份工作只要求我引导旅客出站，但身为至冬的公民，守护国土安全难道不是我们的分内之责吗？"
        },
        {
            "id": "674860603",
            "speaker": "巴热诺夫",
            "text": "不能再多说了，我必须时刻关注出站口的情况，请您谅解。"
        }
    ]
