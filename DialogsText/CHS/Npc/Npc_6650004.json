    "dialogues": [
        {
            "id": "665000401",
            "speaker": "Player",
            "text": "「花」也会说话吗？"
        },
        {
            "id": "665000402",
            "speaker": "穆托莉娜",
            "text": "会，但也不会，「花」不会言语，但它的一切均是言语。它的形貌会诠释命运，它的花粉会倾诉情绪，而它的骨朵会研判结局。"
        },
        {
            "id": "665000403",
            "speaker": "穆托莉娜",
            "text": "而你需要做的，便是与之相伴，并侧耳静听…"
        }
    ]
}