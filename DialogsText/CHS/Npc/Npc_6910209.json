{
    "talkId": "6910209",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 8,
        "玛拉妮": 21
    },
    "dialogues": [
        {
            "id": "691020401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691020402",
            "speaker": "玛拉妮",
            "text": "派对！我们办一个派对吧！"
        },
        {
            "id": "691020403",
            "speaker": "玛拉妮",
            "text": "你看啊，这里场地这么大，而且你还有这么多朋友…"
        },
        {
            "id": "691020404",
            "speaker": "玛拉妮",
            "text": "哇…光是想想这种热闹非凡的场景…就已经开始兴奋了！",
            "choices": [
                {
                    "id": "691020405",
                    "text": "好耶，泳池派对怎么样？",
                    "response": [
                        {
                            "id": "691020406",
                            "speaker": "玛拉妮",
                            "text": "好耶！是我最喜欢的泳池派对！"
                        },
                        {
                            "id": "691020407",
                            "speaker": "玛拉妮",
                            "text": "既然办派对的主意是我提出的，就请让我来布置场地吧。"
                        },
                        {
                            "id": "691020408",
                            "speaker": "玛拉妮",
                            "text": "唔…首先要确认派对的规模，如果朋友们全都到齐，那就需要一个超级巨大的泳池…好像有点难办…"
                        },
                        {
                            "id": "691020409",
                            "speaker": "玛拉妮",
                            "text": "有了！我可以把卡齐娜的冲天转转借过来，泳池不够，我挖着来凑！"
                        },
                        {
                            "id": "691020413",
                            "speaker": "玛拉妮",
                            "text": "哦对了，所有水上用品和客人们的泳衣都由我的店来赞助吧，我去多进些货。"
                        },
                        {
                            "id": "691020414",
                            "speaker": "Player",
                            "text": "玛拉妮果然很有钱！"
                        },
                        {
                            "id": "691020415",
                            "speaker": "玛拉妮",
                            "text": "你就别抬举我啦，只要朋友们玩得开心，这些花费就很划算啊。"
                        },
                        {
                            "id": "691020416",
                            "speaker": "玛拉妮",
                            "text": "大不了派对结束后我加倍努力工作好啦！玩的时候尽兴最重要。"
                        },
                        {
                            "id": "691020417",
                            "speaker": "玛拉妮",
                            "text": "那就这么定喽？"
                        },
                        {
                            "id": "691020418",
                            "speaker": "玛拉妮",
                            "text": "呼，已经开始紧张了，这么大型的派对我也是第一次筹备…"
                        },
                        {
                            "id": "691020419",
                            "speaker": "Player",
                            "text": "果然人太多连你也会害怕吧。"
                        },
                        {
                            "id": "691020420",
                            "speaker": "玛拉妮",
                            "text": "不是哦，我其实在担心太普通的登场方式不能引起大家的注意。"
                        },
                        {
                            "id": "691020421",
                            "speaker": "Player",
                            "text": "还是我多虑了！"
                        },
                        {
                            "id": "691020422",
                            "speaker": "玛拉妮",
                            "text": "哎呀，我是人越多我干劲越足的类型嘛，你是知道的。"
                        },
                        {
                            "id": "691020423",
                            "speaker": "玛拉妮",
                            "text": "快给我些建议好不好？你点子多，拜托啦拜托啦。",
                            "choices": [
                                {
                                    "id": "691020424",
                                    "text": "唱着歌进场？",
                                    "response": [
                                        {
                                            "id": "691020425",
                                            "speaker": "玛拉妮",
                                            "text": "嘿，我怎么没想过？还能先去「花羽会」偷偷师，他们的嗓音都很好听。"
                                        },
                                        {
                                            "id": "691020428",
                                            "speaker": "玛拉妮",
                                            "text": "谢谢你的建议，嘿嘿，我一定不会辜负你。"
                                        },
                                        {
                                            "id": "691020429",
                                            "speaker": "玛拉妮",
                                            "text": "就请等着我的闪亮登场吧！"
                                        }
                                    ]
                                },
                                {
                                    "id": "691020426",
                                    "text": "跳着舞进场？",
                                    "response": [
                                        {
                                            "id": "691020427",
                                            "speaker": "玛拉妮",
                                            "text": "采纳！我这就去「回声之子」紧急训练一番，他们擅长的舞蹈绝对抓人眼球！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691020410",
                    "text": "温泉派对是个好主意！",
                    "response": [
                        {
                            "id": "691020411",
                            "speaker": "玛拉妮",
                            "text": "哇，真的吗？这可是我们「流泉之众」最擅长的领域，交给我吧。"
                        },
                        {
                            "id": "691020412",
                            "speaker": "玛拉妮",
                            "text": "考虑到大家的口味不同，点心和饮料得多准备几个种类…龙龙饼干还是多备一些吧，纳塔特色嘛…"
                        }
                    ]
                }
            ]
        }
    ]
}