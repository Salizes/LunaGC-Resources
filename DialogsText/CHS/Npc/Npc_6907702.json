{
    "talkId": "6907702",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "瑶瑶": 10
    },
    "dialogues": [
        {
            "id": "690770201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690770202",
            "speaker": "瑶瑶",
            "text": "嘿嘿，这里比我家中热闹多啦，但又不像码头一样熙熙攘攘。",
            "choices": [
                {
                    "id": "690770203",
                    "text": "是喜欢的意思？",
                    "response": [
                        {
                            "id": "690770204",
                            "speaker": "瑶瑶",
                            "text": "当然啦。哎呀，你不用为我操心。"
                        },
                        {
                            "id": "690770205",
                            "speaker": "瑶瑶",
                            "text": "师父教过我要「入乡随俗」，欸…等等…这时候是不是应该用「客随主便」更好？"
                        },
                        {
                            "id": "690770206",
                            "speaker": "瑶瑶",
                            "text": "总之，我很喜欢这里！"
                        },
                        {
                            "id": "690770207",
                            "speaker": "瑶瑶",
                            "text": "要是让你觉得在意…我反倒要不好意思啦。"
                        },
                        {
                            "id": "690770212",
                            "speaker": "瑶瑶",
                            "text": "就让我在这里多待会儿吧。"
                        },
                        {
                            "id": "690770213",
                            "speaker": "瑶瑶",
                            "text": "也…让我多陪你一会儿吧。"
                        }
                    ]
                },
                {
                    "id": "690770208",
                    "text": "是不够热闹的意思？",
                    "response": [
                        {
                            "id": "690770209",
                            "speaker": "瑶瑶",
                            "text": "不是啦。"
                        },
                        {
                            "id": "690770210",
                            "speaker": "瑶瑶",
                            "text": "这里让我感到亲切又自在，就好像来到了仙府洞天一样。"
                        },
                        {
                            "id": "690770211",
                            "speaker": "瑶瑶",
                            "text": "能被你邀请来这里玩，是瑶瑶的荣幸。"
                        }
                    ]
                }
            ]
        }
    ]
}