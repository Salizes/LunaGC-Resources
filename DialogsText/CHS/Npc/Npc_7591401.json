    "dialogues": [
        {
            "id": "759140101",
            "speaker": "Player",
            "text": "可是饮料让人快乐…"
        },
        {
            "id": "759140102",
            "speaker": "帕兰",
            "text": "哎呀，那就没办法了。两难之下，只好舍弃一个咯？"
        },
        {
            "id": "759140103",
            "speaker": "帕兰",
            "text": "对我来说，喝水不是什么让人难过的事情，但的确会有人更喜欢甜的东西。"
        },
        {
            "id": "759140104",
            "speaker": "帕兰",
            "text": "那么来吧，吃点让人开心的东西。"
        }
    ]
