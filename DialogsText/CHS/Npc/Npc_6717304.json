{
    "talkId": "6717304",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 4,
        "夏沃蕾": 10,
        "派蒙": 1
    },
    "dialogues": [
        {
            "id": "671730416",
            "speaker": "Black Screen",
            "text": "在柜台后站定不久，就有一位客人来访…"
        },
        {
            "id": "671730401",
            "speaker": "夏沃蕾",
            "text": "#你们好，{NICKNAME}，派蒙。",
            "choices": [
                {
                    "id": "671730402",
                    "text": "夏、夏沃蕾？",
                    "response": [
                        {
                            "id": "671730404",
                            "speaker": "派蒙",
                            "text": "夏沃蕾怎么会来挪德卡莱？是…是来抓人的么？"
                        },
                        {
                            "id": "671730405",
                            "speaker": "夏沃蕾",
                            "text": "不是，我只是来给特巡队物色一个特训地点。"
                        },
                        {
                            "id": "671730406",
                            "speaker": "夏沃蕾",
                            "text": "各位特巡队员一直在枫丹作训，已经慢慢产生了训练惯性。"
                        },
                        {
                            "id": "671730407",
                            "speaker": "夏沃蕾",
                            "text": "平时训练时，虽然手脚确实在动，但却不怎么动脑，只要完成了一天的训练量就行。"
                        },
                        {
                            "id": "671730408",
                            "speaker": "夏沃蕾",
                            "text": "长此以往，特巡队一定会失去应对突发状况的能力。"
                        },
                        {
                            "id": "671730409",
                            "speaker": "夏沃蕾",
                            "text": "所以，我打算定期把特巡队拉到枫丹外进行特训，以此来训练特巡队应对陌生任务地点与突发状况的能力。"
                        },
                        {
                            "id": "671730410",
                            "speaker": "夏沃蕾",
                            "text": "奈芙尔老板已经帮我联系好了一处地点，我这次是来付钱的。"
                        },
                        {
                            "id": "671730411",
                            "speaker": "夏沃蕾",
                            "text": "#{NICKNAME}，既然今天是你在代班，那就请你帮我这些钱转交给奈芙尔老板吧。",
                            "choices": [
                                {
                                    "id": "671730412",
                                    "text": "啊…行。",
                                    "response": [
                                        {
                                            "id": "671730415",
                                            "speaker": "夏沃蕾",
                                            "text": "那么，我就先告辞了。我要尽快回枫丹，做一下准备工作了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "671730413",
                                    "text": "你就不担心我…",
                                    "response": [
                                        {
                                            "id": "671730414",
                                            "speaker": "夏沃蕾",
                                            "text": "我相信你的品德。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "671730403",
                    "text": "我揉揉眼睛…"
                }
            ]
        }
    ]
}