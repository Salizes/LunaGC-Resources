    "dialogues": [
        {
            "id": "614190101",
            "speaker": "Player",
            "text": "关于龙灾…"
        },
        {
            "id": "614190102",
            "speaker": "莎拉",
            "text": "唉，自从风魔龙出现后，大家都没心情吃饭了，生意比以前差了很多。"
        },
        {
            "id": "614190103",
            "speaker": "莎拉",
            "text": "即便是来用餐的客人，也总是唉声叹气的…"
        },
        {
            "id": "614190104",
            "speaker": "莎拉",
            "text": "…不过这也很正常吧，只能希望龙灾尽快结束了。"
        }
    ]
}