{
    "talkId": "6179403",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "格兰菲狄": 7
    },
    "dialogues": [
        {
            "id": "617940301",
            "speaker": "Player",
            "text": "需求？一般怎么提？"
        },
        {
            "id": "617940302",
            "speaker": "格兰菲狄",
            "text": "#嗯，{NICKNAME}长官，请听我简单讲解。"
        },
        {
            "id": "617940303",
            "speaker": "格兰菲狄",
            "text": "骑士必须先确认好，自己需要申请补充的物资。然后在表格上将姓名、战斗序列编号，所属小队和小组都准确写上。"
        },
        {
            "id": "617940304",
            "speaker": "格兰菲狄",
            "text": "最重要的是，拿着这张表去找小队队长，至少是联络官确认需求，签字后，才能从我们这里领取对应物资。"
        },
        {
            "id": "617940305",
            "speaker": "格兰菲狄",
            "text": "一般来说，单个骑士不会直接来找我发起需求，都是汇总到小组层级，再统一给我。"
        },
        {
            "id": "617940306",
            "speaker": "格兰菲狄",
            "text": "但有时，也会出现心急的同僚，这让我很苦恼。",
            "choices": [
                {
                    "id": "617940307",
                    "text": "说不定是急着用呢？",
                    "response": [
                        {
                            "id": "617940309",
                            "speaker": "格兰菲狄",
                            "text": "我理解，在前线时，大家一直死死卡着流程，会很僵硬，错失最佳时机。"
                        },
                        {
                            "id": "617940310",
                            "speaker": "格兰菲狄",
                            "text": "不过，既然回到战事烈度下降许多的荆夫港了，还是尽量按章办事比较好。"
                        }
                    ]
                },
                {
                    "id": "617940308",
                    "text": "可能不想等太长时间？"
                }
            ]
        }
    ]
}