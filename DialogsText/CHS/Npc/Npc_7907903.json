        {
            "id": "790790301",
            "speaker": "藏宝爱好者",
            "text": "这里够「深」了吧？"
        },
        {
            "id": "790790302",
            "speaker": "Player",
            "text": "你在做什么？"
        },
        {
            "id": "790790303",
            "speaker": "藏宝爱好者",
            "text": "哦！我亲爱的朋友，你吓我一跳！"
        },
        {
            "id": "790790304",
            "speaker": "藏宝爱好者",
            "text": "我在寻找一个完美的藏宝地呢！"
        },
        {
            "id": "790790305",
            "speaker": "藏宝爱好者",
            "text": "之前在星轨王城里藏的总觉得有些太简单了。"
        },
        {
            "id": "790790306",
            "speaker": "藏宝爱好者",
            "text": "偶尔也得给寻宝之人一些挑战才有趣嘛！"
        }
    ]
