    "dialogues": [
        {
            "id": "616680601",
            "speaker": "Player",
            "text": "最近如何？"
        },
        {
            "id": "616680602",
            "speaker": "乔尔",
            "text": "一切都好！爸爸虽然还是记不起太多事情，但他能一直陪着我，我就很开心啦！"
        },
        {
            "id": "616680603",
            "speaker": "乔尔",
            "text": "我找来了以前常跟爸爸一起玩的玩具，或许爸爸看到之后，就能想起来什么了！"
        },
        {
            "id": "616680604",
            "speaker": "乔尔",
            "text": "当然，就算爸爸永远想不起以前的事也不要紧。我会和爸爸一起去找新的玩具，一起创造新的回忆！"
        },
        {
            "id": "616680605",
            "speaker": "乔尔",
            "text": "比如…比如…"
        }
    ]
}