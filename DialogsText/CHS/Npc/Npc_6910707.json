{
    "talkId": "6910707",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "茜特菈莉": 9
    },
    "dialogues": [
        {
            "id": "691070201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691070202",
            "speaker": "茜特菈莉",
            "text": "挺好的挺好的。"
        },
        {
            "id": "691070203",
            "speaker": "茜特菈莉",
            "text": "就是让我过来住我可能还习惯不了。"
        },
        {
            "id": "691070204",
            "speaker": "茜特菈莉",
            "text": "房间太大了，躺床上看小说累了还得走好多步拿喝的。",
            "choices": [
                {
                    "id": "691070205",
                    "text": "这个…确实不方便…",
                    "response": [
                        {
                            "id": "691070206",
                            "speaker": "茜特菈莉",
                            "text": "是啊。"
                        },
                        {
                            "id": "691070207",
                            "speaker": "茜特菈莉",
                            "text": "你心中该没想着是因为我年纪大吧？这种习惯我可是从年轻人那里学的！"
                        },
                        {
                            "id": "691070208",
                            "speaker": "茜特菈莉",
                            "text": "不对，我就是年轻人啊。"
                        }
                    ]
                },
                {
                    "id": "691070209",
                    "text": "床边拿个椅子放零食饮料不就好了…",
                    "response": [
                        {
                            "id": "691070210",
                            "speaker": "茜特菈莉",
                            "text": "天才啊！"
                        },
                        {
                            "id": "691070211",
                            "speaker": "茜特菈莉",
                            "text": "不对，你在这里住了这么久，当然立刻能想到这个方法了。"
                        },
                        {
                            "id": "691070212",
                            "speaker": "茜特菈莉",
                            "text": "确实是这样。那样我还是喜欢大房间的，看起来宽敞，让人心情愉悦。"
                        }
                    ]
                }
            ]
        }
    ]
}