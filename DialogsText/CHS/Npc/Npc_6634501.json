{
    "talkId": "6634501",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "伦图": 6
    },
    "dialogues": [
        {
            "id": "663450101",
            "speaker": "伦图",
            "text": "是你们啊，身手矫健的异邦旅人。怎么样，有尝试自己动手制作乌乌黑蛋吗？",
            "choices": [
                {
                    "id": "663450102",
                    "text": "尝试过了，吃完浑身有力！",
                    "response": [
                        {
                            "id": "663450103",
                            "speaker": "伦图",
                            "text": "对吧，对吧，这可是蕴含了火山精华的美味啊。"
                        },
                        {
                            "id": "663450104",
                            "speaker": "伦图",
                            "text": "据说每天都吃的话，能让身体变得越来越健壮呢！"
                        }
                    ]
                },
                {
                    "id": "663450105",
                    "text": "烤过头了，吃完差点晕过去。",
                    "response": [
                        {
                            "id": "663450106",
                            "speaker": "伦图",
                            "text": "哈哈哈，那个味道很让人印象深刻吧？"
                        },
                        {
                            "id": "663450107",
                            "speaker": "伦图",
                            "text": "我倒是觉得吃习惯之后，也没那么难以下咽啦。"
                        }
                    ]
                },
                {
                    "id": "663450109",
                    "text": "还没有，下次试试。",
                    "response": [
                        {
                            "id": "663450110",
                            "speaker": "伦图",
                            "text": "没问题，愿你旅途一切顺利！"
                        }
                    ]
                }
            ]
        }
    ]
}