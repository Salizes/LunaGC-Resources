    "dialogues": [
        {
            "id": "671920401",
            "speaker": "哥伦比娅",
            "text": "我采到花了，喏，送给你。"
        },
        {
            "id": "671920402",
            "speaker": "团雀",
            "text": "漂亮花，好看，谢谢你！我走啦！我走啦！"
        },
        {
            "id": "671920403",
            "speaker": "哥伦比娅",
            "text": "你咬得住么？要是飞在天上的时候，这支金属花突然掉下来…"
        },
        {
            "id": "671920404",
            "speaker": "哥伦比娅",
            "text": "…已经飞远了。希望它和这支金属花，都能顺利到家。"
        }
    ]
}