{
    "talkId": "7265701",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "斑目百兵卫": 12
    },
    "dialogues": [
        {
            "id": "726570101",
            "speaker": "斑目百兵卫",
            "text": "贵客请留步，想必您就是神里大小姐提到的那位旅行者？"
        },
        {
            "id": "726570102",
            "speaker": "Player",
            "text": "正是在下。"
        },
        {
            "id": "726570103",
            "speaker": "斑目百兵卫",
            "text": "失礼了，在下斑目百兵卫，是神里氏家臣。"
        },
        {
            "id": "726570104",
            "speaker": "斑目百兵卫",
            "text": "阁下的名讳与事迹，我有所耳闻，况且就连神里大小姐对您也是十二分的器重，可见阁下是一位值得信赖的义士。"
        },
        {
            "id": "726570105",
            "speaker": "斑目百兵卫",
            "text": "我早想拜会，可惜各项事务缠身…",
            "choices": [
                {
                    "id": "726570106",
                    "text": "哪里哪里。",
                    "response": [
                        {
                            "id": "726570107",
                            "speaker": "斑目百兵卫",
                            "text": "阁下过谦了，社奉行神里绫人大人也曾和我提起您的事，连大人他也认为您值得信赖。"
                        },
                        {
                            "id": "726570110",
                            "speaker": "斑目百兵卫",
                            "text": "我还是直说吧，由于神社供奉事宜恰好在社奉行管辖范围内，我们常常能听到各种来自人民的愿望。"
                        },
                        {
                            "id": "726570111",
                            "speaker": "斑目百兵卫",
                            "text": "神里小姐仁慈亲和，说服了奉行大人拨款备物，帮助大家实现愿望。"
                        },
                        {
                            "id": "726570112",
                            "speaker": "斑目百兵卫",
                            "text": "大人考量之后，决定以公开委托的方式帮助大家实现愿望，所以派我协调此事。"
                        },
                        {
                            "id": "726570113",
                            "speaker": "斑目百兵卫",
                            "text": "不过尽管报酬充足，但大家的委托实在太多，我们的人手时有不足…如果阁下愿意协助那就太好了。"
                        },
                        {
                            "id": "726570114",
                            "speaker": "斑目百兵卫",
                            "text": "暂时没有空闲也不妨事，日后您有了闲暇随时可以来找我询问。"
                        },
                        {
                            "id": "726570115",
                            "speaker": "斑目百兵卫",
                            "text": "总而言之，我已经将收到的委托整理出来了，您可以具体看看。"
                        }
                    ]
                },
                {
                    "id": "726570108",
                    "text": "有话直说。",
                    "response": [
                        {
                            "id": "726570109",
                            "speaker": "斑目百兵卫",
                            "text": "哈哈，您果真和传闻中的一样直率，如此拐弯抹角是我器量小了。"
                        }
                    ]
                }
            ]
        }
    ]
}