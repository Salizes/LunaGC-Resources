{
    "talkId": "6908703",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "那维莱特": 15
    },
    "dialogues": [
        {
            "id": "690870301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690870302",
            "speaker": "那维莱特",
            "text": "好。你有什么想知道的事情吗？"
        },
        {
            "id": "690870303",
            "speaker": "那维莱特",
            "text": "比如我的世界名泉品鉴心得？"
        },
        {
            "id": "690870304",
            "speaker": "Player",
            "text": "…我舌头拙，无缘体会。"
        },
        {
            "id": "690870305",
            "speaker": "那维莱特",
            "text": "你的人生确实少了很多口福…"
        },
        {
            "id": "690870306",
            "speaker": "那维莱特",
            "text": "不过这也是没有办法的事情，有些事情就是天生的。"
        },
        {
            "id": "690870307",
            "speaker": "那维莱特",
            "text": "你知道吗？龙蜥会在进化的过程中失去分辨色彩的能力。"
        },
        {
            "id": "690870308",
            "speaker": "那维莱特",
            "text": "错过了时机，就没有办法再度欣赏有色彩的画作了。"
        },
        {
            "id": "690870309",
            "speaker": "那维莱特",
            "text": "啊，我只是出于兴趣了解过这类知识而已。"
        },
        {
            "id": "690870310",
            "speaker": "Player",
            "text": "总感觉在哪里听过这话…"
        },
        {
            "id": "690870311",
            "speaker": "那维莱特",
            "text": "我从龙蜥的故事里学到的两个经验就是——"
        },
        {
            "id": "690870312",
            "speaker": "那维莱特",
            "text": "第一，要尊重所有物种以及物种内所有个体的差异。"
        },
        {
            "id": "690870313",
            "speaker": "那维莱特",
            "text": "第二，不要辜负最美好的年华。"
        },
        {
            "id": "690870314",
            "speaker": "那维莱特",
            "text": "你能想到什么事情应该年轻时要做，不要等老了之后跌坐哀叹的吗？",
            "choices": [
                {
                    "id": "690870315",
                    "text": "去爱人然后被爱？",
                    "response": [
                        {
                            "id": "690870316",
                            "speaker": "那维莱特",
                            "text": "你的回答超出我的想象了。"
                        },
                        {
                            "id": "690870317",
                            "speaker": "那维莱特",
                            "text": "如果人们能做到就好了。若不如此，世界将会被悲哀淹没。"
                        }
                    ]
                },
                {
                    "id": "690870318",
                    "text": "去周游世界？",
                    "response": [
                        {
                            "id": "690870319",
                            "speaker": "那维莱特",
                            "text": "不错的回答。"
                        },
                        {
                            "id": "690870320",
                            "speaker": "那维莱特",
                            "text": "但是我很确信，这件事多晚做都不迟。我也盘算着之后去周游世界呢。"
                        }
                    ]
                }
            ]
        }
    ]
}