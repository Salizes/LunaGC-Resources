{
    "talkId": "7665030",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 6,
        "凛角鹿": 3,
        "卡尼": 13,
        "明娜": 13,
        "海崖鹦": 2
    },
    "dialogues": [
        {
            "id": "766503001",
            "speaker": "卡尼",
            "text": "小鹿小鹿，你想吃夏槲果么？我刚刚去摘的。"
        },
        {
            "id": "766503002",
            "speaker": "明娜",
            "text": "都吃掉了…它真的喜欢吃欸。"
        },
        {
            "id": "766503003",
            "speaker": "Player",
            "text": "你们在做什么呢？"
        },
        {
            "id": "766503004",
            "speaker": "明娜",
            "text": "#你好呀，{NICKNAME}{M#哥哥}{F#姐姐}，我们正在…嗯，郊游呢！"
        },
        {
            "id": "766503005",
            "speaker": "明娜",
            "text": "在郊游的路上，我们遇见了这只小鹿，它超级可爱的。"
        },
        {
            "id": "766503006",
            "speaker": "明娜",
            "text": "#小鹿小鹿，我和{NICKNAME}{M#哥哥}{F#姐姐}，还有卡尼能摸摸你么？要是可以的话…你就点点头。"
        },
        {
            "id": "766503007",
            "speaker": "凛角鹿",
            "text": "……"
        },
        {
            "id": "766503008",
            "speaker": "明娜",
            "text": "卡尼！它真的能听懂我说话。菈乌玛姐姐说的是真的，小鹿真的好聪明喔。"
        },
        {
            "id": "766503009",
            "speaker": "Player",
            "text": "摸摸，乖乖喔。"
        },
        {
            "id": "766503010",
            "speaker": "凛角鹿",
            "text": "……"
        },
        {
            "id": "766503011",
            "speaker": "明娜",
            "text": "它凑上来了欸。好可爱…嘿嘿，乖乖喔，这个白灵果也给你，要慢点吃呀。"
        },
        {
            "id": "766503012",
            "speaker": "卡尼",
            "text": "唉，要是我也和菈乌玛姐姐一样，能听懂小动物们说话就好了。"
        },
        {
            "id": "766503013",
            "speaker": "卡尼",
            "text": "这样的话，平时我就不用一个人发呆了…"
        },
        {
            "id": "766503014",
            "speaker": "明娜",
            "text": "放心啦，卡尼。我不是说了么？明天就来陪你玩一整天，我准备了好多玩具呢，可好玩了。"
        },
        {
            "id": "766503015",
            "speaker": "卡尼",
            "text": "谢谢你。可是…晚上我一个人睡的时候，还是会害怕…"
        },
        {
            "id": "766503016",
            "speaker": "凛角鹿",
            "text": "……"
        },
        {
            "id": "766503017",
            "speaker": "明娜",
            "text": "我们前几天不是刚捡到一只受伤的小海崖鹦么？你爸爸妈妈不是答应了，让你把它养在屋里了吗？"
        },
        {
            "id": "766503018",
            "speaker": "卡尼",
            "text": "是的。可是…它的伤已经好了呀。莎莱卡奶奶说，大自然才是小动物的家，把它一直养在屋里，对它不好。"
        },
        {
            "id": "766503019",
            "speaker": "卡尼",
            "text": "但我又舍不得，所以就只是把它放在那里…想着如果它不飞走的话，或许就是愿意待在家里，和我做朋友了…"
        },
        {
            "id": "766503020",
            "speaker": "卡尼",
            "text": "可我睡了一觉之后，它就不见了。"
        },
        {
            "id": "766503021",
            "speaker": "明娜",
            "text": "啊…你别难过，那只小海崖鹦说不定…是去找它的爸爸妈妈报平安了，等它的爸爸妈妈允许之后，就会回来看你了。",
            "choices": [
                {
                    "id": "766503022",
                    "text": "等等，那边是不是…",
                    "response": [
                        {
                            "id": "766503024",
                            "speaker": "海崖鹦",
                            "text": "……"
                        },
                        {
                            "id": "766503025",
                            "speaker": "明娜",
                            "text": "你看！这只海崖鹦说不定就是它的家人呢。"
                        },
                        {
                            "id": "766503026",
                            "speaker": "卡尼",
                            "text": "明娜，我又不是菈乌玛姐姐，每一只海崖鹦在我眼里都长得一模一样…"
                        },
                        {
                            "id": "766503027",
                            "speaker": "卡尼",
                            "text": "除非它们会说话，不然我不可能分得清啦…"
                        },
                        {
                            "id": "766503028",
                            "speaker": "明娜",
                            "text": "可它们都是海崖鹦，肯定互相都认识呀。我们干脆请它来帮你找找那只小海崖鹦吧。",
                            "choices": [
                                {
                                    "id": "766503029",
                                    "text": "就是，问问呗。",
                                    "response": [
                                        {
                                            "id": "766503031",
                                            "speaker": "明娜",
                                            "text": "喏，夏槲果给你，你喂给它吧。"
                                        },
                                        {
                                            "id": "766503032",
                                            "speaker": "卡尼",
                                            "text": "好…好的。那个…海崖鹦呀海崖鹦，如果你认识我家里的那只海崖鹦的话…"
                                        },
                                        {
                                            "id": "766503033",
                                            "speaker": "卡尼",
                                            "text": "呜…我自己说得都有些绕口了…"
                                        },
                                        {
                                            "id": "766503034",
                                            "speaker": "卡尼",
                                            "text": "但总之！我很想它，如果你认识它的话，能让它回来看看我吗？"
                                        },
                                        {
                                            "id": "766503035",
                                            "speaker": "海崖鹦",
                                            "text": "……"
                                        },
                                        {
                                            "id": "766503036",
                                            "speaker": "明娜",
                                            "text": "它没有反应欸…难道是不喜欢吃这种果子，等一下喔，我换一种。"
                                        },
                                        {
                                            "id": "766503037",
                                            "speaker": "卡尼",
                                            "text": "你别飞走啊，千万别飞走，我还有话和你说！"
                                        }
                                    ]
                                },
                                {
                                    "id": "766503030",
                                    "text": "说不定真认识呢。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "766503023",
                    "text": "就停着一只海崖鹦？"
                }
            ]
        }
    ]
}