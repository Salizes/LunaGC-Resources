{
    "talkId": "7665044",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 9,
        "韦克塞尔": 24
    },
    "dialogues": [
        {
            "id": "766504401",
            "speaker": "韦克塞尔",
            "text": "行了，这样就好了…呼，下次干脆给莎莱卡奶奶做一把新椅子吧…",
            "choices": [
                {
                    "id": "766504402",
                    "text": "这椅子修得挺好。",
                    "response": [
                        {
                            "id": "766504404",
                            "speaker": "韦克塞尔",
                            "text": "那是，在镇子上的时候，左邻右舍的桌椅板凳都是我修的。"
                        },
                        {
                            "id": "766504405",
                            "speaker": "韦克塞尔",
                            "text": "唉，但这椅子都被我修了好几轮了，下次再坏，恐怕就要彻底报废。"
                        },
                        {
                            "id": "766504406",
                            "speaker": "韦克塞尔",
                            "text": "我也和莎莱卡奶奶说，我可以给她做一把全新的椅子，但奶奶却一直坚持还能用，不要耗费太多材料。"
                        },
                        {
                            "id": "766504407",
                            "speaker": "韦克塞尔",
                            "text": "然后，她拜托我用省下来的材料给孩子们做桌椅，还有帮附近的小鸟修一下鸟巢…"
                        },
                        {
                            "id": "766504408",
                            "speaker": "韦克塞尔",
                            "text": "嗨，别担心。奶奶这么说是她的事，我修椅子的时候，可一点材料都不会省。"
                        },
                        {
                            "id": "766504409",
                            "speaker": "韦克塞尔",
                            "text": "当然啦，孩子们的桌椅和小鸟的鸟巢我也没落下，全都漂漂亮亮地修好了。"
                        },
                        {
                            "id": "766504410",
                            "speaker": "韦克塞尔",
                            "text": "虽然熬夜有点累，但等会我就去镇上喝两杯，再回家睡一觉，马上就能恢复力气。"
                        },
                        {
                            "id": "766504411",
                            "speaker": "Player",
                            "text": "等等，你不住在这里吗？"
                        },
                        {
                            "id": "766504412",
                            "speaker": "韦克塞尔",
                            "text": "哈哈哈，我忘了和你说了。我可不是「霜月之子」的教众，只是个…嗯，普普通通的镇里人。"
                        },
                        {
                            "id": "766504413",
                            "speaker": "韦克塞尔",
                            "text": "我之前因为某些事受过「霜月之子」的照顾，想着无论如何都要报答一下…"
                        },
                        {
                            "id": "766504414",
                            "speaker": "韦克塞尔",
                            "text": "过来了之后，发现我的木工手艺正好能派上用场，就经常过来帮大家做点修理工作，也算是小小的报恩啦。",
                            "choices": [
                                {
                                    "id": "766504415",
                                    "text": "没想过正式加入「霜月之子」？",
                                    "response": [
                                        {
                                            "id": "766504417",
                                            "speaker": "韦克塞尔",
                                            "text": "这个啊，爱维琳和索妮齐娅都来问过我，要不要干脆加入「霜月之子」，然后正式住下…"
                                        },
                                        {
                                            "id": "766504418",
                                            "speaker": "韦克塞尔",
                                            "text": "我想了一晚上，最后还是拒绝了。"
                                        },
                                        {
                                            "id": "766504419",
                                            "speaker": "Player",
                                            "text": "是有什么担心吗？"
                                        },
                                        {
                                            "id": "766504420",
                                            "speaker": "韦克塞尔",
                                            "text": "倒是有点…啊，你别误会，不是对「霜月之子」的担心，是我个人的小问题。"
                                        },
                                        {
                                            "id": "766504421",
                                            "speaker": "韦克塞尔",
                                            "text": "你看啊，「霜月之子」不是信仰那位「月神」吗？大家对那位神明的态度都超级虔诚的欸。"
                                        },
                                        {
                                            "id": "766504422",
                                            "speaker": "韦克塞尔",
                                            "text": "但我这个人嘛，现在既不信仰「月神」，往后应该也不可能信仰「月神」…"
                                        },
                                        {
                                            "id": "766504423",
                                            "speaker": "韦克塞尔",
                                            "text": "因为从根源上来说，我压根就没有信仰神明的习惯啦。"
                                        },
                                        {
                                            "id": "766504424",
                                            "speaker": "韦克塞尔",
                                            "text": "虽然莎莱卡奶奶说，我也可以作为一个普通居民住在这里，对我的信仰也不强求…"
                                        },
                                        {
                                            "id": "766504425",
                                            "speaker": "韦克塞尔",
                                            "text": "唉，但我总是觉得这样不太好啦，就算这么勉强地加入了「霜月之子」，肯定也会影响周围的人。"
                                        },
                                        {
                                            "id": "766504426",
                                            "speaker": "韦克塞尔",
                                            "text": "我是为了报答各位对我的帮助，才来「霜月之子」这边帮忙的，可不能反过来添麻烦啊。",
                                            "choices": [
                                                {
                                                    "id": "766504427",
                                                    "text": "你想太多了啦。",
                                                    "response": [
                                                        {
                                                            "id": "766504430",
                                                            "speaker": "韦克塞尔",
                                                            "text": "我知道。但…嗨，我就是过不去自己心里这道坎。总之，我就先这样，待在这边帮大家的忙吧，"
                                                        },
                                                        {
                                                            "id": "766504431",
                                                            "speaker": "韦克塞尔",
                                                            "text": "说不定之后会有合适的契机出现，等到那个时候，我再加入也不迟。"
                                                        },
                                                        {
                                                            "id": "766504432",
                                                            "speaker": "韦克塞尔",
                                                            "text": "其实现在也挺好的，偶尔过来这边帮帮忙，没事情做就在镇上喝点酒，打发一会时间。"
                                                        },
                                                        {
                                                            "id": "766504433",
                                                            "speaker": "韦克塞尔",
                                                            "text": "咳…我也不知道「霜月之子」里有啥规矩。要是加入了之后没酒喝，那不就糟糕了…"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "766504428",
                                                    "text": "大家会欢迎你的。"
                                                },
                                                {
                                                    "id": "766504429",
                                                    "text": "这里的大家也没这么严苛。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "766504416",
                                    "text": "听起来也修了不少东西…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "766504403",
                    "text": "手艺不错啊。"
                }
            ]
        }
    ]
}