    "dialogues": [
        {
            "id": "630640401",
            "speaker": "Player",
            "text": "「奥诘众」？"
        },
        {
            "id": "630640402",
            "speaker": "毅",
            "text": "通俗来说，就是将军大人的贴身护卫。"
        },
        {
            "id": "630640403",
            "speaker": "毅",
            "text": "「奥诘众」存在的意义，就是保证将军身边随时都有能够无条件信任并调用的力量。"
        },
        {
            "id": "630640404",
            "speaker": "毅",
            "text": "所以对我们而言最重要的东西，就是忠诚。"
        }
    ]
}