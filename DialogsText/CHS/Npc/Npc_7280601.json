{
    "talkId": "7280601",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 5,
        "荒谷": 20
    },
    "dialogues": [
        {
            "id": "728060101",
            "speaker": "荒谷",
            "text": "这种时候…怎么联系这两位老师呢…"
        },
        {
            "id": "728060102",
            "speaker": "Player",
            "text": "联系什么？"
        },
        {
            "id": "728060103",
            "speaker": "荒谷",
            "text": "欸！是旅行者啊，你…你来得正好，我正有事想请人帮忙呢。"
        },
        {
            "id": "728060104",
            "speaker": "荒谷",
            "text": "是这样，「八重堂」一年一度的小说比赛就快要开始了，按照惯例，我们打算邀请几位作家老师来当评委。"
        },
        {
            "id": "728060105",
            "speaker": "荒谷",
            "text": "但是…有两位老师并不是稻妻人，目前也不在稻妻国内。"
        },
        {
            "id": "728060106",
            "speaker": "荒谷",
            "text": "您也知道，眼下这种时候，实在没法邀请国外人士过来。"
        },
        {
            "id": "728060107",
            "speaker": "荒谷",
            "text": "但这种大事，如果不给作者老师们知会一声，也不太合适…"
        },
        {
            "id": "728060108",
            "speaker": "荒谷",
            "text": "所以我就想着，至少托人送点礼物过去，也算是不失了礼节，顺便还可以再附信一封，预约一下往后的稿子，咳…"
        },
        {
            "id": "728060109",
            "speaker": "荒谷",
            "text": "不知道，您意下如何呀？",
            "choices": [
                {
                    "id": "728060110",
                    "text": "交给我吧。",
                    "response": [
                        {
                            "id": "728060111",
                            "speaker": "荒谷",
                            "text": "那就拜托你了，旅行者。"
                        },
                        {
                            "id": "728060114",
                            "speaker": "荒谷",
                            "text": "常九爷的小说《古华派的大师兄》，叙述的是一个出身古典宗门的璃月大师兄与异国的稻妻小师妹之间的江湖故事。"
                        },
                        {
                            "id": "728060115",
                            "speaker": "荒谷",
                            "text": "要我说的话，题材和剧情其实都有些老套了，但好在还有一些读者买账，销量也还可以。"
                        },
                        {
                            "id": "728060116",
                            "speaker": "荒谷",
                            "text": "我们也总结过几封意见信，托人带给常九爷，希望能帮助他在后续的作品里做出一些突破…"
                        },
                        {
                            "id": "728060117",
                            "speaker": "荒谷",
                            "text": "但信寄出去之后却一直杳无回音，也不知道是送丢了，还是怎么回事…"
                        },
                        {
                            "id": "728060118",
                            "speaker": "Player",
                            "text": "「枕玉」是谁？"
                        },
                        {
                            "id": "728060119",
                            "speaker": "荒谷",
                            "text": "那我可不知道，应该是这位老师的笔名吧。"
                        },
                        {
                            "id": "728060120",
                            "speaker": "荒谷",
                            "text": "这位老师写的《沉秋拾剑录》？这可是引起轰动的著作！"
                        },
                        {
                            "id": "728060121",
                            "speaker": "荒谷",
                            "text": "无论是设定还是剧情，都大大地引领了一波创作的风潮。"
                        },
                        {
                            "id": "728060122",
                            "speaker": "Player",
                            "text": "那我要去哪找这位老师…"
                        },
                        {
                            "id": "728060123",
                            "speaker": "荒谷",
                            "text": "呃…这个…这位老师应该也是在璃月。据那位把这本《沉秋拾剑录》带回稻妻的客商说，他是在「万文集舍」里看见的这本书。"
                        },
                        {
                            "id": "728060124",
                            "speaker": "荒谷",
                            "text": "我想，问问「万文集舍」的人，应该就能找到这位老师了。"
                        },
                        {
                            "id": "728060125",
                            "speaker": "荒谷",
                            "text": "不过…咳！先不说这些了，这些礼物和信件请你拿好了，这件事就拜托你了。"
                        }
                    ]
                },
                {
                    "id": "728060112",
                    "text": "那两位老师分别是谁？",
                    "response": [
                        {
                            "id": "728060113",
                            "speaker": "荒谷",
                            "text": "那两位老师一位叫「枕玉」，一位是叫…常九爷。"
                        }
                    ]
                }
            ]
        }
    ]
}