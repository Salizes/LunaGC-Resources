    "dialogues": [
        {
            "id": "760390101",
            "speaker": "迷路的幽影",
            "text": "按紧急预案，警戒信号亮起后，总部将派遣我们特别援助小队「影」进行支援。"
        },
        {
            "id": "760390102",
            "speaker": "迷路的幽影",
            "text": "…这里的雾气太浓了，我们看不到灯塔。"
        },
        {
            "id": "760390103",
            "speaker": "迷路的幽影",
            "text": "长官…有脚步声…"
        },
        {
            "id": "760390104",
            "speaker": "迷路的幽影",
            "text": "是岛上驻守的执灯人吗…请回答…",
            "choices": [
                {
                    "id": "760390105",
                    "text": "没错。",
                    "response": [
                        {
                            "id": "760390107",
                            "speaker": "迷路的幽影",
                            "text": "情况不对…小心…"
                        },
                        {
                            "id": "760390108",
                            "speaker": "迷路的幽影",
                            "text": "按紧急预案，警戒信号亮起后，总部将派遣我们特别援助小队「影」进行支援。"
                        },
                        {
                            "id": "760390109",
                            "speaker": "迷路的幽影",
                            "text": "…这里的雾气太浓了，我们看不到灯塔…"
                        },
                        {
                            "id": "760390110",
                            "speaker": "迷路的幽影",
                            "text": "看不到…看不到…看不到…"
                        }
                    ]
                },
                {
