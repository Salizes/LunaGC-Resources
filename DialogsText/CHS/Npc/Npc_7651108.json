{
    "talkId": "7651108",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "堇葵": 10
    },
    "dialogues": [
        {
            "id": "765110801",
            "speaker": "堇葵",
            "text": "嗯？原来泽西切先生提到的「最终试炼人」是您…真让人安心。",
            "choices": [
                {
                    "id": "765110802",
                    "text": "你是？",
                    "response": [
                        {
                            "id": "765110803",
                            "speaker": "堇葵",
                            "text": "「终末番」目付堇葵，携搭档忍犬，前来磨砺武技。"
                        },
                        {
                            "id": "765110804",
                            "speaker": "堇葵",
                            "text": "我曾听早柚多次提起你的本领，今天终于可以开开眼界了。"
                        },
                        {
                            "id": "765110805",
                            "speaker": "堇葵",
                            "text": "尽情捶打所有对手吧，反正其他两位选手的医药费不用我付。"
                        }
                    ]
                },
                {
                    "id": "765110806",
                    "text": "「咕咕丸」？",
                    "response": [
                        {
                            "id": "765110807",
                            "speaker": "堇葵",
                            "text": "是我从小抚养到大的忍犬，最新一届忍犬的模范与领队。"
                        },
                        {
                            "id": "765110808",
                            "speaker": "堇葵",
                            "text": "虽说「咕咕丸」资历尚浅，但应用了改进后的训练方法。"
                        },
                        {
                            "id": "765110809",
                            "speaker": "堇葵",
                            "text": "战斗力应当不逊于…全盛时期的「暮色残光」——「太郎丸」先生…嗯，至少不会差太多吧。"
                        },
                        {
                            "id": "765110810",
                            "speaker": "堇葵",
                            "text": "愿你们两位好好享受战斗的过程，当然，也请别对「咕咕丸」下手太狠。"
                        },
                        {
                            "id": "765110811",
                            "speaker": "堇葵",
                            "text": "不然，我会心疼的。"
                        }
                    ]
                },
                {
                    "id": "765110812",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "765110813",
                            "speaker": "堇葵",
                            "text": "您慢走。"
                        }
                    ]
                }
            ]
        }
    ]
}