    "dialogues": [
        {
            "id": "699004501",
            "speaker": "Player",
            "text": "关于解决争端的办法…"
        },
        {
            "id": "699004502",
            "speaker": "派蒙",
            "text": "据说在纳塔，有着可以不靠肌肉就解决争端的办法。",
            "choices": [
                {
                    "id": "699004503",
                    "text": "在战争的国度…",
                    "response": [
                        {
                            "id": "699004505",
                            "speaker": "派蒙",
                            "text": "没错，我听说在回声之子，某一部分人就有用舞蹈对决来解决争端的传统！",
                            "choices": [
                                {
                                    "id": "699004506",
                                    "text": "舞蹈对决？",
                                    "response": [
                                        {
                                            "id": "699004508",
                                            "speaker": "派蒙",
                                            "text": "嗯嗯。"
                                        },
                                        {
                                            "id": "699004509",
                                            "speaker": "Player",
                                            "text": "然后开始比拼花式动作…"
                                        },
                                        {
                                            "id": "699004510",
                                            "speaker": "派蒙",
                                            "text": "对对。"
                                        },
                                        {
                                            "id": "699004511",
                                            "speaker": "Player",
                                            "text": "直至一方力竭，最终倒地不起为止？"
                                        },
                                        {
                                            "id": "699004512",
                                            "speaker": "派蒙",
                                            "text": "没错！"
                                        },
                                        {
                                            "id": "699004513",
                                            "speaker": "派蒙",
                                            "text": "——欸，不对，那不还是靠肌肉吗！"
                                        }
                                    ]
                                },
                                {
                                    "id": "699004507",
                                    "text": "你是说，大家约好时间地点…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699004504",
                    "text": "竟然还有这种方法吗？"
                }
            ]
        }
    ]
}