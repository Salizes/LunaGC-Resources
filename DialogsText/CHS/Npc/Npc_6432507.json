    "dialogues": [
        {
            "id": "643250701",
            "speaker": "Player",
            "text": "关于拉娜…"
        },
        {
            "id": "643250702",
            "speaker": "素达蓓",
            "text": "拉娜姐姐也是厉害又漂亮的大姐姐。素达蓓看过的故事里，最后快乐地生活在一起的人，都得一样聪明又厉害…"
        },
        {
            "id": "643250703",
            "speaker": "素达蓓",
            "text": "所以为了能够娶拉娜姐姐，素达蓓也要变成和拉娜姐姐一样厉害的大姐姐！"
        }
    ]
}