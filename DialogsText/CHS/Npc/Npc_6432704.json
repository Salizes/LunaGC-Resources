        {
            "id": "643270401",
            "speaker": "Player",
            "text": "为什么留在维摩庄…"
        },
        {
            "id": "643270402",
            "speaker": "艾方索",
            "text": "该从哪里说起呢…嗯…我本来只是跟着老师来须弥参加教令院的讨论会，偶尔路过了这里，不知为何就想留下来了…"
        },
        {
            "id": "643270403",
            "speaker": "艾方索",
            "text": "维摩庄可比枫丹舒服许多了，无论是环境，还是氛围。"
        }
    ]
}