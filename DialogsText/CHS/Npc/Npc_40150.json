    "dialogues": [
        {
            "id": "4015140101",
            "speaker": "昆恩",
            "text": "新鲜水果尽在昆恩水果摊——"
        },
        {
            "id": "4015140102",
            "speaker": "贝雅特丽奇",
            "text": "昆恩——"
        },
        {
            "id": "4015140103",
            "speaker": "昆恩",
            "text": "…又是你啊，今天要多少？"
        },
        {
            "id": "4015140104",
            "speaker": "昆恩",
            "text": "我先声明，绝不打折！"
        },
        {
            "id": "4015140105",
            "speaker": "贝雅特丽奇",
            "text": "青梅竹马都不给亲友价嘛？"
        },
        {
            "id": "4015140106",
            "speaker": "昆恩",
            "text": "我说过很多次了。"
        },
        {
            "id": "4015140107",
            "speaker": "昆恩",
            "text": "价钱不打折，品质也绝不打折！"
        },
        {
            "id": "4015140108",
            "speaker": "贝雅特丽奇",
            "text": "哎呀~~再商量商量嘛~"
        },
        {
            "id": "4015140109",
            "speaker": "贝雅特丽奇",
            "text": "我帮你带午饭来的话，可以打折吗？"
        },
        {
            "id": "4015140110",
            "speaker": "昆恩",
            "text": "你说什么都不会打折的。"
        }
    ]
}