    "dialogues": [
        {
            "id": "631800201",
            "speaker": "Player",
            "text": "你还没回协会吗？"
        },
        {
            "id": "631800202",
            "speaker": "悦子",
            "text": "喔，是你啊。"
        },
        {
            "id": "631800203",
            "speaker": "悦子",
            "text": "大祐似乎被那只会说话的猫「寝子」迷住了，一个劲地说还想在这里调查一段时间。"
        },
        {
            "id": "631800204",
            "speaker": "悦子",
            "text": "为了看住这家伙，防止他做出什么蠢事…我也暂时留在这里了。"
        },
        {
            "id": "631800205",
            "speaker": "悦子",
            "text": "正好，我也可以在这里稍微偷一下懒。"
        }
    ]
}