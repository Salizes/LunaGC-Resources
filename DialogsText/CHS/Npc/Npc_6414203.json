    "dialogues": [
        {
            "id": "641420301",
            "speaker": "Player",
            "text": "这里是…"
        },
        {
            "id": "641420302",
            "speaker": "巴巴克",
            "text": "这里是奥摩斯港最大的舶来品商店，由教令院直接管理。"
        },
        {
            "id": "641420303",
            "speaker": "巴巴克",
            "text": "我既是学者，也是店长。"
        },
        {
            "id": "641420304",
            "speaker": "巴巴克",
            "text": "因为有官方保障，所以免去了不少货物的税费，客人可以在这里购买到价格合理的外国商品。"
        },
        {
            "id": "641420305",
            "speaker": "巴巴克",
            "text": "也算是从某种方面上遏制了那些走私行为吧。"
        }
    ]
}