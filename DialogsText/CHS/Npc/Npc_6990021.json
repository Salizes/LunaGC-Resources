{
    "talkId": "6990021",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 7
    },
    "dialogues": [
        {
            "id": "699002101",
            "speaker": "Player",
            "text": "关于眼狩令…"
        },
        {
            "id": "699002102",
            "speaker": "派蒙",
            "text": "说到稻妻最近发生的大事，果然还是眼狩令吧。"
        },
        {
            "id": "699002103",
            "speaker": "派蒙",
            "text": "不过你没有神之眼，所以不用担心会被收走。"
        },
        {
            "id": "699002104",
            "speaker": "派蒙",
            "text": "#但反过来，如果被天领奉行抓住，{NICKNAME}，你也没办法交出神之眼来保命…",
            "choices": [
                {
                    "id": "699002105",
                    "text": "我可以跟他们说…",
                    "response": [
                        {
                            "id": "699002107",
                            "speaker": "派蒙",
                            "text": "派蒙还真是方便的道具…才不对吧！"
                        },
                        {
                            "id": "699002108",
                            "speaker": "Player",
                            "text": "放心吧，不会交出派蒙的。"
                        },
                        {
                            "id": "699002109",
                            "speaker": "派蒙",
                            "text": "这样还差不多。",
                            "choices": [
                                {
                                    "id": "699002110",
                                    "text": "然后我和派蒙大概会一起坐牢…",
                                    "response": [
                                        {
                                            "id": "699002112",
                                            "speaker": "派蒙",
                                            "text": "唔…如、如果真的这样的话，还是把我交出去吧…"
                                        },
                                        {
                                            "id": "699002113",
                                            "speaker": "派蒙",
                                            "text": "…等等，从一开始不要被抓住不就好了吗！"
                                        }
                                    ]
                                },
                                {
                                    "id": "699002111",
                                    "text": "一起被下令处死…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699002106",
                    "text": "派蒙就是我的神之眼哦。"
                }
            ]
        }
    ]
}