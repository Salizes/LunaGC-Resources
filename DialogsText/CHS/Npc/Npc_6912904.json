{
    "talkId": "6912904",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "洛恩": 11
    },
    "dialogues": [
        {
            "id": "691290401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691290402",
            "speaker": "洛恩",
            "text": "可以的话，能帮我找几个靶子来吗？一人高的那种就行，我想练练枪。"
        },
        {
            "id": "691290403",
            "speaker": "洛恩",
            "text": "虽说这里很适合休息，但也不能一直待在这里什么也不干，那样的话，枪术都生疏了。"
        },
        {
            "id": "691290404",
            "speaker": "洛恩",
            "text": "噢，如果你认识用枪好手的话，我也很乐意和他们切磋一下。"
        },
        {
            "id": "691290405",
            "speaker": "洛恩",
            "text": "我保证在切磋里只用长枪，不用其他的武器，相信我，我的枪法可是很光明磊落的。",
            "choices": [
                {
                    "id": "691290406",
                    "text": "切磋的时候…",
                    "response": [
                        {
                            "id": "691290408",
                            "speaker": "洛恩",
                            "text": "如果是平时战斗，那当然是有什么就用什么了。"
                        },
                        {
                            "id": "691290409",
                            "speaker": "洛恩",
                            "text": "微型火铳、淬毒的弩箭、靴子里的匕首、袖子里的小刀、毒粉、炼金溶剂…"
                        },
                        {
                            "id": "691290410",
                            "speaker": "洛恩",
                            "text": "要是以上武器全部失效，那也没关系，可以用石头砸，运气好捡到断骨的话，锋利的骨茬也可以伤敌。"
                        },
                        {
                            "id": "691290411",
                            "speaker": "洛恩",
                            "text": "要是运气糟糕到什么都找不到，那就用牙咬，用头撞…无论如何，总能找到干掉敌人的方法。",
                            "choices": [
                                {
                                    "id": "691290412",
                                    "text": "你之前经历过很艰苦的战斗吧。",
                                    "response": [
                                        {
                                            "id": "691290414",
                                            "speaker": "洛恩",
                                            "text": "呵，没事的，我没感觉到辛苦。对我来说，思考干掉敌人的方法这件事非常有趣——至少我认为，这件事有益我的身心健康。"
                                        },
                                        {
                                            "id": "691290415",
                                            "speaker": "洛恩",
                                            "text": "不过话说回来，平时切磋的时候，我的枪法真的很光明磊落。"
                                        },
                                        {
                                            "id": "691290416",
                                            "speaker": "洛恩",
                                            "text": "如果我的对手突然滑倒、咳嗽、打喷嚏…嗯，那一定是今天的天气不太好，不适合切磋。"
                                        }
                                    ]
                                },
                                {
                                    "id": "691290413",
                                    "text": "辛苦了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691290407",
                    "text": "那要是平时战斗的话…"
                }
            ]
        }
    ]
}