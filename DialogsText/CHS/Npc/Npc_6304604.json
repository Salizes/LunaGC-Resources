        {
            "id": "630460401",
            "speaker": "Player",
            "text": "关于将军大人…"
        },
        {
            "id": "630460402",
            "speaker": "天野",
            "text": "将军大人的威名震慑四方，守护稻妻永恒的和平。"
        },
        {
            "id": "630460403",
            "speaker": "天野",
            "text": "对于将军大人的任何决定，我都没有疑问。"
        },
        {
            "id": "630460404",
            "speaker": "天野",
            "text": "就算锁国令解除了，来到稻妻的外国人也还是要遵守这里的规矩。"
        }
    ]
