    "dialogues": [
        {
            "id": "630130201",
            "speaker": "Player",
            "text": "……"
        },
        {
            "id": "630130202",
            "speaker": "平八",
            "text": "你老盯着我干嘛？"
        },
        {
            "id": "630130203",
            "speaker": "平八",
            "text": "茶难喝就是难喝，简直难喝死了，乌鸦的口水也就这样了。"
        },
        {
            "id": "630130204",
            "speaker": "平八",
            "text": "不仅茶难喝，景色也差，明明是稻妻的店面却总有外国人晃悠。"
        },
        {
            "id": "630130205",
            "speaker": "平八",
            "text": "还敢自称什么只接待上流人士的高端地界…哼，在我看来，不过一间茅草屋罢了。"
        },
        {
            "id": "630130206",
            "speaker": "平八",
            "text": "要不是因为要务在身，我才不愿待在这。"
        }
    ]
}