    "dialogues": [
        {
            "id": "630210901",
            "speaker": "Player",
            "text": "你是说锁国令解除？"
        },
        {
            "id": "630210902",
            "speaker": "长谷川",
            "text": "可不是吗！锁国令期间不许外国的货船通行，很多只靠进口的高档货都没有了。"
        },
        {
            "id": "630210903",
            "speaker": "长谷川",
            "text": "现在嘛，终于又能喝到蒙德的蒲公英酒，定做璃月丝绸制作的着物了…"
        },
        {
            "id": "630210904",
            "speaker": "长谷川",
            "text": "这才是美好的人生啊。"
        }
    ]
}