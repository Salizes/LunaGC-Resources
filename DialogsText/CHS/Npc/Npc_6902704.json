{
    "talkId": "6902704",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 6,
        "凝光": 12
    },
    "dialogues": [
        {
            "id": "690270401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690270402",
            "speaker": "凝光",
            "text": "嗯…有一件事我计划很久了。"
        },
        {
            "id": "690270403",
            "speaker": "凝光",
            "text": "下次有大事要决策的时候，我想请你一同前往。",
            "choices": [
                {
                    "id": "690270404",
                    "text": "是去整理资料吗？",
                    "response": [
                        {
                            "id": "690270406",
                            "speaker": "凝光",
                            "text": "不，我是想…说不定可以让你参与到「决策」中来。",
                            "choices": [
                                {
                                    "id": "690270407",
                                    "text": "我能处理好吗…",
                                    "response": [
                                        {
                                            "id": "690270408",
                                            "speaker": "凝光",
                                            "text": "放心吧，我是不会看错的。"
                                        },
                                        {
                                            "id": "690270409",
                                            "speaker": "凝光",
                                            "text": "你在旅途中所积累的学识与魄力，将会使决策更加富有远见。"
                                        },
                                        {
                                            "id": "690270415",
                                            "speaker": "凝光",
                                            "text": "嗯，我相信你。"
                                        },
                                        {
                                            "id": "690270416",
                                            "speaker": "凝光",
                                            "text": "哦，对了。"
                                        },
                                        {
                                            "id": "690270417",
                                            "speaker": "凝光",
                                            "text": "在做出决策之后，你就替我将那墙上的资料碾碎吧。"
                                        },
                                        {
                                            "id": "690270418",
                                            "speaker": "凝光",
                                            "text": "这摇撼商界的「碎雪」，下次就由你来洒落。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690270410",
                                    "text": "交给我吧。",
                                    "response": [
                                        {
                                            "id": "690270411",
                                            "speaker": "凝光",
                                            "text": "嗯，我喜欢你的魄力。"
                                        },
                                        {
                                            "id": "690270412",
                                            "speaker": "凝光",
                                            "text": "商界如战场，决策时需要的就是这样的自信与果断。"
                                        },
                                        {
                                            "id": "690270413",
                                            "speaker": "凝光",
                                            "text": "你在旅途中所积累的见识，也会使决策更加富有远见。"
                                        },
                                        {
                                            "id": "690270414",
                                            "speaker": "Player",
                                            "text": "我一定尽我所能。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690270405",
                    "text": "是想让我学习决策的思路吗？"
                }
            ]
        }
    ]
}