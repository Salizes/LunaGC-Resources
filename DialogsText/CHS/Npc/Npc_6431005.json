    "dialogues": [
        {
            "id": "643100501",
            "speaker": "Player",
            "text": "我不是哦。"
        },
        {
            "id": "643100502",
            "speaker": "鲁达贝",
            "text": "唔…真遗憾。"
        },
        {
            "id": "643100503",
            "speaker": "鲁达贝",
            "text": "不过其他人的观点…似乎也不是不能参考？"
        },
        {
            "id": "643100504",
            "speaker": "鲁达贝",
            "text": "只是不知道你对道成林的情况了解吗？"
        },
        {
            "id": "643100505",
            "speaker": "鲁达贝",
            "text": "关于草神大人曾在雨林中留下的踪迹，又见到过多少呢？"
        },
        {
            "id": "643100506",
            "speaker": "鲁达贝",
            "text": "…啊，抱歉，拖着你讲了这么久。你如果不介意的话，可以抽空找我聊聊哦。"
        }
    ]
}