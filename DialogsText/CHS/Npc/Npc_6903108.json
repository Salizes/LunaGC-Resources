{
    "talkId": "6903108",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "奥兹": 2,
        "菲谢尔": 11
    },
    "dialogues": [
        {
            "id": "690310801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690310401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690310402",
            "speaker": "菲谢尔",
            "text": "自高天陨落的星辰，是昭告终末之刻的沙漏。"
        },
        {
            "id": "690310403",
            "speaker": "菲谢尔",
            "text": "地心中暗涌的震颤，是古神心脏垂死的残响。"
        },
        {
            "id": "690310404",
            "speaker": "菲谢尔",
            "text": "难道本皇女终将独自一人迎来这世间孤寂的终篇吗？"
        },
        {
            "id": "690310405",
            "speaker": "菲谢尔",
            "text": "祝圣之人啊…"
        },
        {
            "id": "690310406",
            "speaker": "菲谢尔",
            "text": "你…你愿伴随本皇女见证这世间万象的终焉，迎候那永世幽夜的降临吗？"
        },
        {
            "id": "690310407",
            "speaker": "奥兹",
            "text": "小姐的意思是…"
        },
        {
            "id": "690310408",
            "speaker": "菲谢尔",
            "text": "奥…奥兹！",
            "choices": [
                {
                    "id": "690310409",
                    "text": "没事，我能听懂…",
                    "response": [
                        {
                            "id": "690310411",
                            "speaker": "菲谢尔",
                            "text": "欸…欸？你说的是真的吗…"
                        },
                        {
                            "id": "690310412",
                            "speaker": "奥兹",
                            "text": "小…小姐…"
                        },
                        {
                            "id": "690310413",
                            "speaker": "菲谢尔",
                            "text": "啊！咳咳…！"
                        },
                        {
                            "id": "690310414",
                            "speaker": "菲谢尔",
                            "text": "如此甚好，就让我以祝圣的荣辉，光耀你命运的旅途吧！"
                        },
                        {
                            "id": "690310415",
                            "speaker": "菲谢尔",
                            "text": "我，菲谢尔·冯·露弗施洛斯·那菲多特…"
                        },
                        {
                            "id": "690310416",
                            "speaker": "菲谢尔",
                            "text": "将携夜之眷属奥兹华尔多·赫芙那梵茵斯，守护你的前路。正如命运的默示录所昭告的那般！"
                        }
                    ]
                },
                {
                    "id": "690310410",
                    "text": "愿随皇女左右。"
                }
            ]
        }
    ]
}