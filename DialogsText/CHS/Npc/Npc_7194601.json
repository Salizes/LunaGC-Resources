    "dialogues": [
        {
            "id": "719460101",
            "speaker": "Player",
            "text": "采这么多花会不会不太好…"
        },
        {
            "id": "719460102",
            "speaker": "蒙蒙",
            "text": "啊，蒙蒙做错了，对不起…"
        },
        {
            "id": "719460103",
            "speaker": "蒙蒙",
            "text": "都怪蒙蒙手太笨了…好多花的茎都断了，没法用来编花环了…"
        },
        {
            "id": "719460104",
            "speaker": "蒙蒙",
            "text": "…要不，这些花就送给你吧！"
        },
        {
            "id": "719460105",
            "speaker": "蒙蒙",
            "text": "这样，这些花也有了自己的归宿了。"
        }
    ]
}