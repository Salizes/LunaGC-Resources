{
    "talkId": "6900309",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "琴": 11
    },
    "dialogues": [
        {
            "id": "690030901",
            "speaker": "琴",
            "text": "嗯，可以陪我散散步吗？"
        },
        {
            "id": "690030902",
            "speaker": "琴",
            "text": "我之前按你说的，试着对自己的生活做出一些改变。"
        },
        {
            "id": "690030903",
            "speaker": "琴",
            "text": "虽然在处理公务的时候，还是会尽自己所能去完成。"
        },
        {
            "id": "690030904",
            "speaker": "琴",
            "text": "但在你身边的时候，我已经能够让自己从心态上放松下来。",
            "choices": [
                {
                    "id": "690030905",
                    "text": "那已经很有进步了。",
                    "response": [
                        {
                            "id": "690030907",
                            "speaker": "琴",
                            "text": "这些都是你的功劳…"
                        },
                        {
                            "id": "690030908",
                            "speaker": "琴",
                            "text": "一直以来，你像这样陪伴着我，考虑着我的事情。"
                        },
                        {
                            "id": "690030909",
                            "speaker": "琴",
                            "text": "如果我连这份付出都看不到的话，那就太无地自容了。"
                        },
                        {
                            "id": "690030910",
                            "speaker": "琴",
                            "text": "真的很感谢你。"
                        },
                        {
                            "id": "690030911",
                            "speaker": "Player",
                            "text": "琴笑起来的样子很好看。"
                        },
                        {
                            "id": "690030912",
                            "speaker": "Player",
                            "text": "我也要感谢琴才对。"
                        },
                        {
                            "id": "690030913",
                            "speaker": "琴",
                            "text": "……"
                        },
                        {
                            "id": "690030914",
                            "speaker": "琴",
                            "text": "我们，边走边说吧。"
                        },
                        {
                            "id": "690030915",
                            "speaker": "琴",
                            "text": "我还有很多话，想要对你说。"
                        }
                    ]
                },
                {
                    "id": "690030906",
                    "text": "我很开心听到这些。"
                }
            ]
        }
    ]
}