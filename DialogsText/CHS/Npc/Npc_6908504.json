{
    "talkId": "6908504",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "菲米尼": 13
    },
    "dialogues": [
        {
            "id": "690850401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690850402",
            "speaker": "菲米尼",
            "text": "嗯…等你有空，可以请你陪我去几个地方吗？"
        },
        {
            "id": "690850403",
            "speaker": "菲米尼",
            "text": "勒波特钟表店、博蒙特工坊还有瓦萨里回廊…",
            "choices": [
                {
                    "id": "690850404",
                    "text": "当然可以啊。",
                    "response": [
                        {
                            "id": "690850406",
                            "speaker": "菲米尼",
                            "text": "嗯…我想去看看发条工艺品，还有各式各样的机械装置。"
                        },
                        {
                            "id": "690850407",
                            "speaker": "菲米尼",
                            "text": "平日里我常去的是莱舒的发条工坊，但路过其他店的时候，总免不了好奇…"
                        },
                        {
                            "id": "690850408",
                            "speaker": "菲米尼",
                            "text": "深处的橱柜藏着怎样的商品？会不会有什么既新鲜又精巧的设计？"
                        },
                        {
                            "id": "690850409",
                            "speaker": "菲米尼",
                            "text": "真想一件不落地看下来！可是…唉…"
                        },
                        {
                            "id": "690850410",
                            "speaker": "菲米尼",
                            "text": "我不太擅长和人打交道…如果闷声看了半天却是只看不买，肯定会被店家讨厌的。"
                        },
                        {
                            "id": "690850411",
                            "speaker": "菲米尼",
                            "text": "那个时候，就需要麻烦你…",
                            "choices": [
                                {
                                    "id": "690850412",
                                    "text": "帮你解释？",
                                    "response": [
                                        {
                                            "id": "690850413",
                                            "speaker": "菲米尼",
                                            "text": "嗯…对的。我知道这样很为难…但…"
                                        },
                                        {
                                            "id": "690850417",
                                            "speaker": "菲米尼",
                                            "text": "我会报答你的！只要我力所能及…"
                                        },
                                        {
                                            "id": "690850418",
                                            "speaker": "Player",
                                            "text": "没问题。"
                                        },
                                        {
                                            "id": "690850419",
                                            "speaker": "菲米尼",
                                            "text": "太好了！…简直像做梦一样。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690850414",
                                    "text": "帮你买下来？",
                                    "response": [
                                        {
                                            "id": "690850415",
                                            "speaker": "菲米尼",
                                            "text": "欸？！当、当然不是这个意思…"
                                        },
                                        {
                                            "id": "690850416",
                                            "speaker": "菲米尼",
                                            "text": "你只要帮我解释两句就好了…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690850405",
                    "text": "是有什么想逛的吗？"
                }
            ]
        }
    ]
}