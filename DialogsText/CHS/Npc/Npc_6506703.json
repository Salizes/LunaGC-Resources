    "dialogues": [
        {
            "id": "650670301",
            "speaker": "Player",
            "text": "听上去很好吃。"
        },
        {
            "id": "650670302",
            "speaker": "布莱卡利",
            "text": "呵呵，孩子们喜欢就好。"
        },
        {
            "id": "650670303",
            "speaker": "布莱卡利",
            "text": "这里的大人们工作忙，总有小孩子来替家里买东西，我就会拿点零食给他们。"
        },
        {
            "id": "650670304",
            "speaker": "布莱卡利",
            "text": "有时娜维娅那丫头也会过来，大包小包地带好多礼物给我，也跟小孩子一样嚷嚷着想吃蛋糕。"
        }
    ]
}