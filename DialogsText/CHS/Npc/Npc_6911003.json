{
    "talkId": "6911003",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 9,
        "伊安珊": 22
    },
    "dialogues": [
        {
            "id": "691100301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691100302",
            "speaker": "伊安珊",
            "text": "嗯…"
        },
        {
            "id": "691100303",
            "speaker": "Player",
            "text": "怎么了？伊安珊在发愁吗？"
        },
        {
            "id": "691100304",
            "speaker": "伊安珊",
            "text": "啊…抱歉。我在思考下一批学员的课程该怎么安排。"
        },
        {
            "id": "691100305",
            "speaker": "Player",
            "text": "课程？"
        },
        {
            "id": "691100306",
            "speaker": "伊安珊",
            "text": "嗯，健身课程。"
        },
        {
            "id": "691100307",
            "speaker": "伊安珊",
            "text": "健身是我们部族的特色文化之一，作为沃陆之邦健身俱乐部的总教练，我有义务指导新人。"
        },
        {
            "id": "691100308",
            "speaker": "Player",
            "text": "往年的课程安排不能用吗？"
        },
        {
            "id": "691100309",
            "speaker": "伊安珊",
            "text": "你大概是觉得健身的方法大体类似？每年的新人都有这种想法。"
        },
        {
            "id": "691100310",
            "speaker": "伊安珊",
            "text": "#{NICKNAME}，不妨先回答本教练一个问题，你健身的时候更关注哪一点？",
            "choices": [
                {
                    "id": "691100311",
                    "text": "运动。",
                    "response": [
                        {
                            "id": "691100312",
                            "speaker": "伊安珊",
                            "text": "那就以此为例，总有新人认为所有健身运动都是一套大差不差的流程，按这个流程去做就能练出一身肌肉。"
                        },
                        {
                            "id": "691100313",
                            "speaker": "伊安珊",
                            "text": "其实每个人的情况都不一样，我指定的运动计划也必须随之做出改变。"
                        },
                        {
                            "id": "691100314",
                            "speaker": "伊安珊",
                            "text": "如果一个学员体型较胖，我就会推荐他尝试慢跑之类的有氧运动，先把体脂降下来。"
                        },
                        {
                            "id": "691100315",
                            "speaker": "伊安珊",
                            "text": "如果一个学员体型较瘦，我就会推荐他先从推拉等基本的力量训练做起，增肌是第一要务。"
                        },
                        {
                            "id": "691100316",
                            "speaker": "伊安珊",
                            "text": "要是所有人都按同一套流程来，免不了会有人受伤。"
                        },
                        {
                            "id": "691100322",
                            "speaker": "伊安珊",
                            "text": "就是这样，每换一批学员，课程安排就得跟着换…"
                        },
                        {
                            "id": "691100323",
                            "speaker": "Player",
                            "text": "原来当健身教练这么辛苦…"
                        },
                        {
                            "id": "691100324",
                            "speaker": "伊安珊",
                            "text": "怎么会，我乐在其中。"
                        },
                        {
                            "id": "691100325",
                            "speaker": "伊安珊",
                            "text": "我的古名是「力量」，而健身本质上就是一种通过自身努力获得力量的过程。它与天赋关系不大，更看重每个人付出的汗水。"
                        },
                        {
                            "id": "691100326",
                            "speaker": "伊安珊",
                            "text": "指导过的学员越多，我对这个古名的理解就越深刻呢。"
                        },
                        {
                            "id": "691100327",
                            "speaker": "伊安珊",
                            "text": "话说回来，你对健身感兴趣吗？我正好可以帮你也制定一套健身计划。",
                            "choices": [
                                {
                                    "id": "691100328",
                                    "text": "我现在就足够健壮了。",
                                    "response": [
                                        {
                                            "id": "691100329",
                                            "speaker": "伊安珊",
                                            "text": "健身是一种坚持，不是一个结果哦。你基础不错，那是值得肯定的好事，但也不要输给岁月和松懈感啊！"
                                        }
                                    ]
                                },
                                {
                                    "id": "691100330",
                                    "text": "请教练指导。",
                                    "response": [
                                        {
                                            "id": "691100331",
                                            "speaker": "伊安珊",
                                            "text": "哈哈，这个学员我收了。健身计划的话，先从适应营养餐的口味开始吧，很多学员都倒在这里。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691100317",
                    "text": "营养。",
                    "response": [
                        {
                            "id": "691100318",
                            "speaker": "伊安珊",
                            "text": "那这里面的学问可就大了，关于健身时该怎么吃，其实每个人都有所差异。"
                        },
                        {
                            "id": "691100319",
                            "speaker": "伊安珊",
                            "text": "太瘦弱的人，首先热量必须跟上，否则他连运动的基本消耗都承受不了。我必须让学员明白，「健身」和「减肥」不一样。"
                        },
                        {
                            "id": "691100320",
                            "speaker": "伊安珊",
                            "text": "本身已经足够健壮的人，则要更注重调理和控制热量。明明坚持了很久，结果因为几顿大餐就前功尽弃的学员，我见过太多了。"
                        },
                        {
                            "id": "691100321",
                            "speaker": "伊安珊",
                            "text": "所以，我会针对每名学员分别设计营养餐。"
                        }
                    ]
                }
            ]
        }
    ]
}