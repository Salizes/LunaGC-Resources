    "speaker_counts": {
        "Player": 1,
        "福迪尔": 5
    },
    "dialogues": [
        {
            "id": "644030501",
            "speaker": "Player",
            "text": "另一边呢？"
        },
        {
            "id": "644030502",
            "speaker": "福迪尔",
            "text": "是我不熟悉的地方。"
        },
        {
            "id": "644030503",
            "speaker": "福迪尔",
            "text": "以前我还在镀金旅团里时，去过几次奥摩斯港，但碰上的净是些趁火打劫的生意。"
        },
        {
            "id": "644030504",
            "speaker": "福迪尔",
            "text": "我不喜欢，就离开了，此后再没离开过村子。"
        },
        {
            "id": "644030505",
            "speaker": "福迪尔",
            "text": "那段经历里唯一值得肯定的，就只有在摸爬滚打中学来的身手了吧。"
        },
        {
            "id": "644030506",
            "speaker": "福迪尔",
            "text": "现在可以用来保护阿如村，正好。"
        }
    ]
}