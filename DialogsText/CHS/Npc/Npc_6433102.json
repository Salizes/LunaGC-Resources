    "dialogues": [
        {
            "id": "643310201",
            "speaker": "Player",
            "text": "你在烦恼什么？"
        },
        {
            "id": "643310202",
            "speaker": "扎蒂斯",
            "text": "唉，我正在为要去教令院的哪个学派进修发愁。"
        },
        {
            "id": "643310203",
            "speaker": "扎蒂斯",
            "text": "这次考核的成绩超出我想象的好，每个学派的要求都达标了。可是问题来了，学派有六个啊…"
        },
        {
            "id": "643310204",
            "speaker": "扎蒂斯",
            "text": "听说从阿弥利多学派毕业当医生赚的摩拉多，又有人说刹诃伐罗学派中的建筑方向就业形势好…"
        },
        {
            "id": "643310205",
            "speaker": "扎蒂斯",
            "text": "到底该选哪个呢？"
        }
    ]
}