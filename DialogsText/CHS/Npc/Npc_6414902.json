        "Player": 1,
        "阿法纳西": 5
    },
    "dialogues": [
        {
            "id": "641490201",
            "speaker": "Player",
            "text": "你还好吗？"
        },
        {
            "id": "641490202",
            "speaker": "阿法纳西",
            "text": "我？还行吧，还能撑。"
        },
        {
            "id": "641490203",
            "speaker": "阿法纳西",
            "text": "不知道为什么，这帮港务监察官每天总是盯着我的货物检查。"
        },
        {
            "id": "641490204",
            "speaker": "阿法纳西",
            "text": "我卖的明明都是很普通的至冬工业品啊？"
        },
        {
            "id": "641490205",
            "speaker": "阿法纳西",
            "text": "但这些官员总是神经兮兮的，好像害怕这些商品突然爆炸一样。"
        },
        {
            "id": "641490206",
            "speaker": "阿法纳西",
            "text": "唉，希望他们早点放下心来才好。老这样查来查去，会影响我做生意的啊…"
        }
    ]
}