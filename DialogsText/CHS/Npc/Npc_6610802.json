    "dialogues": [
        {
            "id": "661080201",
            "speaker": "Player",
            "text": "亲人可以吗？"
        },
        {
            "id": "661080202",
            "speaker": "辛奇",
            "text": "…你好像误会了，我是猎人。"
        },
        {
            "id": "661080203",
            "speaker": "辛奇",
            "text": "想找人的话应该得去联系私家侦探或者冒险家协会之类的吧…我也不太清楚。"
        },
        {
            "id": "661080204",
            "speaker": "辛奇",
            "text": "我只精通怎么和匿叶龙一起出门狩猎。你告诉我目标，我就能给你把猎物带回来，就是这样。"
        }
    ]
}