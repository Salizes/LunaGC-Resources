    "dialogues": [
        {
            "id": "652750901",
            "speaker": "Player",
            "text": "在这里待得还习惯吗？"
        },
        {
            "id": "652750902",
            "speaker": "菲希里耶",
            "text": "…挺好的。待在船上，至少没有人能够突然过来找我麻烦。"
        },
        {
            "id": "652750903",
            "speaker": "菲希里耶",
            "text": "不过，现在除了院里，应该也没人会突然联系我了。"
        },
        {
            "id": "652750904",
            "speaker": "菲希里耶",
            "text": "希望我接下来的每一个夜晚都安安静静，不被人打扰。"
        }
    ]
}