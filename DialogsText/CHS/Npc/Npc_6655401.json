{
    "talkId": "6655401",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "乌哈纳": 10
    },
    "dialogues": [
        {
            "id": "665540101",
            "speaker": "乌哈纳",
            "text": "朋友！欢迎来到梦中的帕依提提！嗝…！",
            "choices": [
                {
                    "id": "665540102",
                    "text": "帕依提提是什么？",
                    "response": [
                        {
                            "id": "665540103",
                            "speaker": "乌哈纳",
                            "text": "帕依提提就是提提岛，提提岛就是帕依提提！嗝…！"
                        },
                        {
                            "id": "665540104",
                            "speaker": "乌哈纳",
                            "text": "所以说啊，提提岛上埋藏的宝藏，就是神秘黄金国帕依提提的宝藏啦…"
                        },
                        {
                            "id": "665540105",
                            "speaker": "乌哈纳",
                            "text": "这件事我就告诉你了你一个哦！嗝…！"
                        },
                        {
                            "id": "665540106",
                            "speaker": "Player",
                            "text": "岛上真的有宝藏吗？"
                        },
                        {
                            "id": "665540107",
                            "speaker": "乌哈纳",
                            "text": "嘿嘿，我不会骗你的，真的有，因为其实是度假村官方埋的啦。"
                        },
                        {
                            "id": "665540108",
                            "speaker": "乌哈纳",
                            "text": "虽说是为了吸引客人的噱头，但也是实实在在的宝藏哦，就看哪位幸运游客能找到了。"
                        },
                        {
                            "id": "665540109",
                            "speaker": "Player",
                            "text": "能告诉我在哪里吗？"
                        },
                        {
                            "id": "665540110",
                            "speaker": "乌哈纳",
                            "text": "哎呀，你干嘛这样看着我啦，真是的。"
                        },
                        {
                            "id": "665540111",
                            "speaker": "乌哈纳",
                            "text": "好吧好吧，你这种小鹿一样的眼神我真是受不了，那我也就只告诉你一个哦！"
                        },
                        {
                            "id": "665540112",
                            "speaker": "乌哈纳",
                            "text": "在提提岛的北边，总之你在北边找就对了。嗝…！"
                        }
                    ]
                },
                {
                    "id": "665540213",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "665540214",
                            "speaker": "乌哈纳",
                            "text": "再见。嗝…！"
                        }
                    ]
                }
            ]
        }
    ]
}