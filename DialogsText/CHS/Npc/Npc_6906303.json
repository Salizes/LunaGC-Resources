{
    "talkId": "6906303",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 11,
        "申鹤": 17
    },
    "dialogues": [
        {
            "id": "690630301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690630302",
            "speaker": "申鹤",
            "text": "聊天？你也跟师父一样，喜欢聊天吗？"
        },
        {
            "id": "690630303",
            "speaker": "申鹤",
            "text": "也好，修行之外，师父也教过我聊天的技巧。不过大多数时间都是她说，我听。"
        },
        {
            "id": "690630304",
            "speaker": "申鹤",
            "text": "难得有实践的机会，请出招。"
        },
        {
            "id": "690630305",
            "speaker": "Player",
            "text": "都有哪些聊天技巧？"
        },
        {
            "id": "690630306",
            "speaker": "申鹤",
            "text": "唔…聊天这种行为和修炼方术不同，似乎没有具体口诀。"
        },
        {
            "id": "690630307",
            "speaker": "申鹤",
            "text": "只记得她说过，聊天的目的不仅在于传递信息，还能调节气氛和增进情感。",
            "choices": [
                {
                    "id": "690630308",
                    "text": "怎么调节气氛？",
                    "response": [
                        {
                            "id": "690630309",
                            "speaker": "申鹤",
                            "text": "根据她的说法，聊一些对方感兴趣的人和事，最能调动气氛。"
                        },
                        {
                            "id": "690630310",
                            "speaker": "申鹤",
                            "text": "但在认识你之前，我熟悉的人不多，感兴趣的话题也…几乎没有。",
                            "choices": [
                                {
                                    "id": "690630315",
                                    "text": "也就是说…",
                                    "response": [
                                        {
                                            "id": "690630317",
                                            "speaker": "申鹤",
                                            "text": "但师父和我聊起你时，我会觉得…很有趣。"
                                        },
                                        {
                                            "id": "690630318",
                                            "speaker": "Player",
                                            "text": "我？"
                                        },
                                        {
                                            "id": "690630319",
                                            "speaker": "申鹤",
                                            "text": "嗯。说你在大家眼中是个身手了得的大英雄，然而上次你却惊慌失措地摔下了群玉…"
                                        },
                                        {
                                            "id": "690630320",
                                            "speaker": "Player",
                                            "text": "好了请别往下说了…"
                                        },
                                        {
                                            "id": "690630321",
                                            "speaker": "申鹤",
                                            "text": "你脸红了。是因为被这个话题调动了情绪吗？"
                                        },
                                        {
                                            "id": "690630322",
                                            "speaker": "申鹤",
                                            "text": "看来师父的聊天技巧是有用的…"
                                        },
                                        {
                                            "id": "690630323",
                                            "speaker": "申鹤",
                                            "text": "明白了，今后我会向师父多多询问你的事情，以便增加我们之间的话题。"
                                        },
                                        {
                                            "id": "690630324",
                                            "speaker": "Player",
                                            "text": "请不要这样做…"
                                        },
                                        {
                                            "id": "690630325",
                                            "speaker": "申鹤",
                                            "text": "啊，也对。你近在咫尺，不必如此麻烦。"
                                        },
                                        {
                                            "id": "690630326",
                                            "speaker": "申鹤",
                                            "text": "那么，请告诉我更多关于你的事情吧，我会牢牢记住的。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690630316",
                                    "text": "申鹤其实不喜欢聊天…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690630311",
                    "text": "怎么增进感情？",
                    "response": [
                        {
                            "id": "690630312",
                            "speaker": "申鹤",
                            "text": "说来惭愧，这方面我没有天赋，没能习得师父半点真传…"
                        },
                        {
                            "id": "690630313",
                            "speaker": "申鹤",
                            "text": "仙人们与我的师徒之情非比寻常，不需要通过聊天来增进。"
                        },
                        {
                            "id": "690630314",
                            "speaker": "申鹤",
                            "text": "除了他们，我也没有其他朋友，所以，没有需要增进感情的对象。",
                            "choices": [
                                {
                                    "id": "690630315",
                                    "text": "也就是说…"
                                },
                                {
                                    "id": "690630316",
                                    "text": "申鹤其实不喜欢聊天…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}