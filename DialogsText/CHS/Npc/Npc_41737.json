{
    "talkId": "41737",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "艾迪丝博士": 8
    },
    "dialogues": [
        {
            "id": "615550205",
            "speaker": "Player",
            "text": "关于大树…"
        },
        {
            "id": "615550206",
            "speaker": "艾迪丝博士",
            "text": "这棵大树就是在当年温妮莎登上天空岛的地方生长出来的，我敢保证你走遍蒙德都找不到这么大的橡树！"
        },
        {
            "id": "615550207",
            "speaker": "艾迪丝博士",
            "text": "关于它，我收集了数不胜数的故事和诗歌，找个地方坐坐吧，这些故事我跟你讲三天三夜也讲不完…",
            "choices": [
                {
                    "id": "615550208",
                    "text": "…还是下次吧。",
                    "response": [
                        {
                            "id": "615550209",
                            "speaker": "艾迪丝博士",
                            "text": "好吧，没关系。有时间的话随时欢迎！"
                        }
                    ]
                },
                {
                    "id": "615550210",
                    "text": "天空岛？",
                    "response": [
                        {
                            "id": "615550211",
                            "speaker": "艾迪丝博士",
                            "text": "天空岛是人间伟大的英雄最终相聚的地方。"
                        },
                        {
                            "id": "615550212",
                            "speaker": "艾迪丝博士",
                            "text": "登上天空岛而被接纳的英雄会成为诸神的一员，在高天之上继续守护人民。"
                        },
                        {
                            "id": "615550213",
                            "speaker": "艾迪丝博士",
                            "text": "凡人不会知道天空岛上是什么样的景色。"
                        },
                        {
                            "id": "615550214",
                            "speaker": "艾迪丝博士",
                            "text": "即使是行走大地的众神，也对天空岛缄口不言…"
                        },
                        {
                            "id": "615550215",
                            "speaker": "艾迪丝博士",
                            "text": "或许天空岛的故事，只有那些在人间故去的英雄才有资格讲述吧。"
                        }
                    ]
                }
            ]
        }
    ]
}