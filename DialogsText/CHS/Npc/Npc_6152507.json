{
    "talkId": "6152507",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "薇尔": 15
    },
    "dialogues": [
        {
            "id": "615250701",
            "speaker": "Player",
            "text": "你刚在自言自语什么？"
        },
        {
            "id": "615250702",
            "speaker": "薇尔",
            "text": "哦，莎拉最近想进口点璃月原产辣椒，据说是能让蒙德最爱吃辣的芭芭拉都辣哭的品种。"
        },
        {
            "id": "615250703",
            "speaker": "薇尔",
            "text": "要我说，不符合86%的蒙德人的口味，费大半天力气进口了也很难卖出去吧。",
            "choices": [
                {
                    "id": "615250704",
                    "text": "芭芭拉喜欢吃辣？",
                    "response": [
                        {
                            "id": "615250705",
                            "speaker": "薇尔",
                            "text": "啊？原来你不知道吗？我以为全蒙德的人都知道呢。"
                        },
                        {
                            "id": "615250706",
                            "speaker": "Player",
                            "text": "请多说些「全蒙德知道」的事…"
                        },
                        {
                            "id": "615250707",
                            "speaker": "薇尔",
                            "text": "嗯…话说那些来到蒙德的至冬使团，除了政治目的之外，也有至冬的商人带来了「火水」这种充满至冬特色的酒，旨在与晨曦酒庄达成商业合作。"
                        },
                        {
                            "id": "615250708",
                            "speaker": "薇尔",
                            "text": "在晨曦酒庄举办的酒宴上，迪卢克老爷端起一杯产自万里之外的至冬「火水」，也叫女仆为至冬商人斟满酒庄最自豪的「蒲公英酒」。"
                        },
                        {
                            "id": "615250709",
                            "speaker": "薇尔",
                            "text": "出于礼貌，迪卢克老爷效仿至冬习俗，一口气将整杯「火水」饮尽。"
                        },
                        {
                            "id": "615250710",
                            "speaker": "薇尔",
                            "text": "至冬来客们对迪卢克老爷的「豪气」赞许连连，他微微点头回应，随后便感觉一阵天旋地转…"
                        },
                        {
                            "id": "615250711",
                            "speaker": "薇尔",
                            "text": "但迪卢克老爷依然「从容」地将庄主的风度维持到了最后。可是酒宴结束之后，老爷在房间里整整昏睡了三天。"
                        },
                        {
                            "id": "615250712",
                            "speaker": "薇尔",
                            "text": "晨曦酒庄上上下下都在担忧，莫非老爷遭到了至冬人的暗算…？"
                        },
                        {
                            "id": "615250713",
                            "speaker": "薇尔",
                            "text": "负责照顾老爷起居的爱德琳小姐安抚了大家，「老爷没事…只是我从来都没见过谁会醉成这样…」"
                        },
                        {
                            "id": "615250714",
                            "speaker": "薇尔",
                            "text": "…迪卢克老爷醒来之后的第一件事，便是拒绝了与至冬国的商业合作——「蒙德人喝不来这个。」"
                        }
                    ]
                },
                {
                    "id": "615250513",
                    "text": "你可以劝劝她。",
                    "response": [
                        {
                            "id": "615250514",
                            "speaker": "薇尔",
                            "text": "我劝过了，并没有用。"
                        },
                        {
                            "id": "615250515",
                            "speaker": "薇尔",
                            "text": "如果还想不出办法，就只能动用「那个男人」了。"
                        },
                        {
                            "id": "615250516",
                            "speaker": "薇尔",
                            "text": "常识来讲，以凯亚的话术，稍微旁敲侧击一下就搞定了吧。"
                        },
                        {
                            "id": "615250517",
                            "speaker": "薇尔",
                            "text": "咳咳，总之，谢谢你的关心了。"
                        }
                    ]
                }
            ]
        }
    ]
}