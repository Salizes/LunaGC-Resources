{
    "talkId": "7615303",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 3,
        "派蒙": 2,
        "萨维特": 10,
        "雅珂达": 6
    },
    "dialogues": [
        {
            "id": "761530301",
            "speaker": "Player",
            "text": "（<color=#FFCC33FF>雅珂达</color>似乎对投资券有兴趣…）"
        },
        {
            "id": "761530302",
            "speaker": "萨维特",
            "text": "怎么又是你，我不卖投资券了，走吧走吧。"
        },
        {
            "id": "761530303",
            "speaker": "萨维特",
            "text": "唉，回头一想，我就不该信你还有什么朋友…",
            "choices": [
                {
                    "id": "761530304",
                    "text": "你那完全就是骗人啦。",
                    "response": [
                        {
                            "id": "761530306",
                            "speaker": "派蒙",
                            "text": "是啊，好好卖书不是挺好的？"
                        },
                        {
                            "id": "761530307",
                            "speaker": "派蒙",
                            "text": "#喔！{NICKNAME}，你看那边，那本书好像很有趣，我们去看看吧。"
                        },
                        {
                            "id": "761530308",
                            "speaker": "萨维特",
                            "text": "行，行，算我倒…霉…"
                        },
                        {
                            "id": "761530309",
                            "speaker": "萨维特",
                            "text": "雅珂达，你怎么来了…难道是奈芙尔老板…"
                        },
                        {
                            "id": "761530310",
                            "speaker": "雅珂达",
                            "text": "没有，我就是陪着我的朋友来这里随便逛逛。"
                        },
                        {
                            "id": "761530311",
                            "speaker": "雅珂达",
                            "text": "嘿嘿，看来萨维特老板的投资生意确实做得很好啊。"
                        },
                        {
                            "id": "761530312",
                            "speaker": "萨维特",
                            "text": "一般！一般，哈哈哈…小本生意，糊口罢了。"
                        },
                        {
                            "id": "761530313",
                            "speaker": "萨维特",
                            "text": "（这丫头…话里有话！肯定是奈芙尔派她过来的…嘁。）"
                        },
                        {
                            "id": "761530314",
                            "speaker": "雅珂达",
                            "text": "萨维特老板真谦虚，老板说，你可是最最有声望，最最有能力的商人。"
                        },
                        {
                            "id": "761530315",
                            "speaker": "雅珂达",
                            "text": "大家跟着您投资，您一定能赚到大钱。"
                        },
                        {
                            "id": "761530316",
                            "speaker": "萨维特",
                            "text": "（果然是奈芙尔…！）"
                        },
                        {
                            "id": "761530317",
                            "speaker": "萨维特",
                            "text": "借奈芙尔老板吉言…借奈芙尔老板吉言。"
                        },
                        {
                            "id": "761530318",
                            "speaker": "萨维特",
                            "text": "…然后，雅珂达…小姐，上次我拜托秘闻馆帮忙找的那个…"
                        },
                        {
                            "id": "761530319",
                            "speaker": "雅珂达",
                            "text": "啊。老板说：「东西已经找到了。」"
                        },
                        {
                            "id": "761530320",
                            "speaker": "雅珂达",
                            "text": "「萨维特先生，不要心急。事情，要一步一步地做才稳当。」"
                        },
                        {
                            "id": "761530321",
                            "speaker": "萨维特",
                            "text": "是、是，奈芙尔老板说的是…那就麻烦了，我就指望您了…"
                        }
                    ]
                },
                {
                    "id": "761530305",
                    "text": "下次别干了喔。"
                }
            ]
        }
    ]
}