{
    "talkId": "6201008",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "茶博士刘苏": 14
    },
    "dialogues": [
        {
            "id": "620100801",
            "speaker": "Player",
            "text": "（听听评书）"
        },
        {
            "id": "620100802",
            "speaker": "茶博士刘苏",
            "text": "…好，那就请您们再赏光听我讲讲那尽览商海，遍察工商的凝光大人。"
        },
        {
            "id": "620100803",
            "speaker": "茶博士刘苏",
            "text": "…话说凝光大人当年方得岩王帝君赏识，初掌「天权」之时…"
        },
        {
            "id": "620100804",
            "speaker": "茶博士刘苏",
            "text": "见税制老旧偏颇，当即雷厉风行，严正法条，惩治偷漏。"
        },
        {
            "id": "620100805",
            "speaker": "茶博士刘苏",
            "text": "当时就重罚了好几个大商会，裁撤了一大批冗员…"
        },
        {
            "id": "620100806",
            "speaker": "茶博士刘苏",
            "text": "一时间那些偷漏税款的大商贾是人人自危，而像咱们这些本分人，那是拍手称快呀！",
            "choices": [
                {
                    "id": "620100807",
                    "text": "好！",
                    "response": [
                        {
                            "id": "620100808",
                            "speaker": "茶博士刘苏",
                            "text": "可是这算惹上事了，凝光大人这一套霹雳手段，就得罪了当时赫赫有名的海运大行「玉龙会」。"
                        },
                        {
                            "id": "620100809",
                            "speaker": "茶博士刘苏",
                            "text": "那时「玉龙会」的总头人称「海焰」，乃是码头上的一霸，生得魁伟雄壮，力能搏鲨。两臂好似古树粗，一口钢牙能碎金！"
                        },
                        {
                            "id": "620100810",
                            "speaker": "茶博士刘苏",
                            "text": "「好她个天权，好她个凝光，且待老夫去会会这小姑娘！」"
                        },
                        {
                            "id": "620100811",
                            "speaker": "茶博士刘苏",
                            "text": "这海焰怒发冲冠八丈高，即刻便登门踢馆去了…"
                        },
                        {
                            "id": "620100812",
                            "speaker": "Player",
                            "text": "哎哟…"
                        },
                        {
                            "id": "620100813",
                            "speaker": "茶博士刘苏",
                            "text": "…话说那海焰进去得有三四个时辰了，却是悄无声息。"
                        },
                        {
                            "id": "620100814",
                            "speaker": "茶博士刘苏",
                            "text": "卫兵们心里也都纳闷：这凝光大人的府邸，怕是有什么仙术道法，竟能隔绝声响？"
                        },
                        {
                            "id": "620100815",
                            "speaker": "茶博士刘苏",
                            "text": "话不多时，只听霹雳一声震天响，大事不好——"
                        },
                        {
                            "id": "620100816",
                            "speaker": "茶博士刘苏",
                            "text": "欲知后事如何，且听我下回分解。"
                        }
                    ]
                },
                {
                    "id": "620100817",
                    "text": "（不听了）",
                    "response": [
                        {
                            "id": "620100818",
                            "speaker": "茶博士刘苏",
                            "text": "可是这算惹上事了，凝光大人这一套霹雳手段，就得罪了当时赫赫有名的海运大行「玉龙会」…"
                        }
                    ]
                }
            ]
        }
    ]
}