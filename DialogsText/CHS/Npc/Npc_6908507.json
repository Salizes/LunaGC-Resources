{
    "talkId": "6908507",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "菲米尼": 12
    },
    "dialogues": [
        {
            "id": "690850201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690850202",
            "speaker": "菲米尼",
            "text": "嗯。"
        },
        {
            "id": "690850203",
            "speaker": "菲米尼",
            "text": "……"
        },
        {
            "id": "690850204",
            "speaker": "菲米尼",
            "text": "我是说…我很习惯，一切都好，不用为我担心。",
            "choices": [
                {
                    "id": "690850205",
                    "text": "你不用那么拘谨。",
                    "response": [
                        {
                            "id": "690850206",
                            "speaker": "菲米尼",
                            "text": "对不起…"
                        },
                        {
                            "id": "690850207",
                            "speaker": "菲米尼",
                            "text": "我怕什么想法都往外说的话，会让听的人产生不必要的误解。"
                        },
                        {
                            "id": "690850210",
                            "speaker": "菲米尼",
                            "text": "……"
                        },
                        {
                            "id": "690850211",
                            "speaker": "菲米尼",
                            "text": "…好吧，那我遵从你的意愿。"
                        },
                        {
                            "id": "690850212",
                            "speaker": "菲米尼",
                            "text": "其实，我…我有点想家。"
                        },
                        {
                            "id": "690850213",
                            "speaker": "菲米尼",
                            "text": "虽然住得很舒适，环境无可挑剔，但我暂时还没法…彻底融入这里的生活。"
                        },
                        {
                            "id": "690850214",
                            "speaker": "菲米尼",
                            "text": "这是我自己的问题…请你不要误会成我对你或这个地方有任何的不满。"
                        },
                        {
                            "id": "690850215",
                            "speaker": "菲米尼",
                            "text": "…也请你原谅我。"
                        }
                    ]
                },
                {
                    "id": "690850208",
                    "text": "你可以实话实说。",
                    "response": [
                        {
                            "id": "690850209",
                            "speaker": "菲米尼",
                            "text": "哈…你希望我如此吗？"
                        }
                    ]
                }
            ]
        }
    ]
}