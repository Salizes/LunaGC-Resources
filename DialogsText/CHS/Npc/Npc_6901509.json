{
    "talkId": "6901509",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "凯亚": 11
    },
    "dialogues": [
        {
            "id": "690150901",
            "speaker": "凯亚",
            "text": "我嘛，只要有你在身边就满足了。"
        },
        {
            "id": "690150902",
            "speaker": "凯亚",
            "text": "#倒是有什么能为你效劳的吗？{NICKNAME}。",
            "choices": [
                {
                    "id": "690150903",
                    "text": "凯亚还是那么会说话啊…",
                    "response": [
                        {
                            "id": "690150904",
                            "speaker": "凯亚",
                            "text": "哈，哪里哪里。"
                        },
                        {
                            "id": "690150905",
                            "speaker": "凯亚",
                            "text": "我说的可都是我的真心话。"
                        },
                        {
                            "id": "690150906",
                            "speaker": "凯亚",
                            "text": "如果我的点子对你起到了什么帮助，那感到自豪的可是我本人。"
                        },
                        {
                            "id": "690150907",
                            "speaker": "凯亚",
                            "text": "这说明你信任我，也说明我有这种为你解决问题的能力。"
                        },
                        {
                            "id": "690150910",
                            "speaker": "凯亚",
                            "text": "哦，对了。要不要为你编写一本指南呢…"
                        },
                        {
                            "id": "690150911",
                            "speaker": "凯亚",
                            "text": "将居家旅行的实用知识收纳其中，我所总结出的三教九流交流技巧也可以尽数分享给你。",
                            "choices": [
                                {
                                    "id": "690150912",
                                    "text": "感觉会很有用…",
                                    "response": [
                                        {
                                            "id": "690150914",
                                            "speaker": "凯亚",
                                            "text": "哈哈…谢谢！"
                                        },
                                        {
                                            "id": "690150915",
                                            "speaker": "凯亚",
                                            "text": "看来我要早点开工了啊…"
                                        }
                                    ]
                                },
                                {
                                    "id": "690150913",
                                    "text": "不愧是凯亚呢。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690150908",
                    "text": "以后也可以借用凯亚的智慧吗？",
                    "response": [
                        {
                            "id": "690150909",
                            "speaker": "凯亚",
                            "text": "听候你的差遣。"
                        }
                    ]
                }
            ]
        }
    ]
}