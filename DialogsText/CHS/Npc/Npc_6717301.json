{
    "talkId": "6717301",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "671730101",
            "speaker": "派蒙",
            "text": "怎么柜台后面都没人，这上面怎么…"
        },
        {
            "id": "671730102",
            "speaker": "派蒙",
            "text": "怎么贴着我的头像啊！"
        },
        {
            "id": "671730103",
            "speaker": "Player",
            "text": "这留言板上还写着字呢…"
        },
        {
            "id": "671730104",
            "speaker": "派蒙",
            "text": "#「{NICKNAME}和派蒙，拜托拜托拜托帮我值个班，我有急事要出去一趟…」"
        },
        {
            "id": "671730105",
            "speaker": "派蒙",
            "text": "啊？但雅珂达怎么知道我们要来，要是我们不来，不就…"
        },
        {
            "id": "671730106",
            "speaker": "Player",
            "text": "后面还有字呢。"
        },
        {
            "id": "671730107",
            "speaker": "派蒙",
            "text": "「…因为我刚才看见你们进来了，所以才拜托你们帮忙，拜托拜托拜托——」",
            "choices": [
                {
                    "id": "671730108",
                    "text": "感觉整页纸上都写着拜托…",
                    "response": [
                        {
                            "id": "671730110",
                            "speaker": "派蒙",
                            "text": "好吧，虽然雅珂达让我们帮她值班，但我们应该做什么呢？",
                            "choices": [
                                {
                                    "id": "671730111",
                                    "text": "不知道…"
                                },
                                {
                                    "id": "671730112",
                                    "text": "总之先等着吧。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "671730109",
                    "text": "就帮她这个忙吧…"
                }
            ]
        }
    ]
}