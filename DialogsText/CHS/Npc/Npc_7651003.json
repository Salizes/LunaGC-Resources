{
    "talkId": "7651003",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "维斯菈娃": 6
    },
    "dialogues": [
        {
            "id": "765100301",
            "speaker": "维斯菈娃",
            "text": "唉，休假期马上结束了，不知下次见面…",
            "choices": [
                {
                    "id": "765100302",
                    "text": "不如趁现在再来一盘兵棋推演。",
                    "response": [
                        {
                            "id": "765100303",
                            "speaker": "维斯菈娃",
                            "text": "哈，是啊，您是对的，不如专注现下的快乐…"
                        }
                    ]
                },
                {
                    "id": "765100304",
                    "text": "就换我来和你切磋？",
                    "response": [
                        {
                            "id": "765100305",
                            "speaker": "维斯菈娃",
                            "text": "啊哈哈，放心，除非是迫不得已的情况下，我也不想跟您交手啊。"
                        },
                        {
                            "id": "765100306",
                            "speaker": "维斯菈娃",
                            "text": "与其与您一较高下，我还是更想和埃德勒明明白白分个胜负，她是个好对手——势均力敌的对局才最好看，对吧？"
                        }
                    ]
                },
                {
                    "id": "765100307",
                    "text": "期待下次在休假期内见面。",
                    "response": [
                        {
                            "id": "765100308",
                            "speaker": "维斯菈娃",
                            "text": "我也想…如果休假期能更长一些就好了。"
                        },
                        {
                            "id": "765100309",
                            "speaker": "维斯菈娃",
                            "text": "这样，说不定，我就能和您一样，自由自在享受一段无拘无束的旅行时光呢…"
                        }
                    ]
                }
            ]
        }
    ]
}