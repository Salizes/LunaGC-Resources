    "dialogues": [
        {
            "id": "690871101",
            "speaker": "那维莱特",
            "text": "在我看来，办公桌是人类最实用的发明之一。"
        },
        {
            "id": "690871102",
            "speaker": "那维莱特",
            "text": "在接见陌生人的时候，一道有形的屏障往往比口头提醒更有效，可以应付一些没有分寸感的人。"
        },
        {
            "id": "690871103",
            "speaker": "那维莱特",
            "text": "它之于我，很重要。"
        }
    ]
}