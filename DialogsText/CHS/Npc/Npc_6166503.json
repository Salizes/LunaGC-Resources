    "dialogues": [
        {
            "id": "616650301",
            "speaker": "Player",
            "text": "塞琉斯…那小子？"
        },
        {
            "id": "616650302",
            "speaker": "玉霞",
            "text": "嗯，塞琉斯是我弟弟。"
        },
        {
            "id": "616650303",
            "speaker": "玉霞",
            "text": "以前我们姐弟总是一起冒险，也算是名扬天下的冒险家二人组吧。"
        },
        {
            "id": "616650304",
            "speaker": "玉霞",
            "text": "不过自从他接任冒险家协会的蒙德分会长之后，就被各种琐事缠身，我们也很久没有一起冒险了。"
        },
        {
            "id": "616650305",
            "speaker": "玉霞",
            "text": "虽然我也接到过担任分会长的邀请，但我拒绝了。对我来说还是做一个单纯的冒险家要省心得多。"
        }
    ]
}