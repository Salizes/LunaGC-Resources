{
    "talkId": "6907007",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "妮露": 13
    },
    "dialogues": [
        {
            "id": "690700201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690700202",
            "speaker": "妮露",
            "text": "我、我没事的…你不用担心我。"
        },
        {
            "id": "690700203",
            "speaker": "妮露",
            "text": "我很开心能收到你的邀请，来这里转转…",
            "choices": [
                {
                    "id": "690700204",
                    "text": "妮露在紧张吧？",
                    "response": [
                        {
                            "id": "690700205",
                            "speaker": "妮露",
                            "text": "唔、唔，还是瞒不过你吗…"
                        },
                        {
                            "id": "690700206",
                            "speaker": "妮露",
                            "text": "呼——让我想象一下，现在的我正埋在墩墩桃的海洋里。"
                        },
                        {
                            "id": "690700207",
                            "speaker": "妮露",
                            "text": "把身边的墩墩桃轻轻推开…嗯，这样就能把紧张从身体里赶跑了。"
                        },
                        {
                            "id": "690700212",
                            "speaker": "妮露",
                            "text": "啊，说回刚刚的问题…这里被你布置得温馨又舒适。"
                        },
                        {
                            "id": "690700213",
                            "speaker": "妮露",
                            "text": "但我一直以来都没怎么出过须弥城，突然来到陌生的地方就…"
                        },
                        {
                            "id": "690700214",
                            "speaker": "妮露",
                            "text": "不知道该做点什么，也不知道要找谁说话…"
                        },
                        {
                            "id": "690700215",
                            "speaker": "妮露",
                            "text": "能让我多待一会儿，再等我适应一段时间吗？"
                        },
                        {
                            "id": "690700216",
                            "speaker": "妮露",
                            "text": "等熟悉这里了，我肯定就不会紧张了，嘿嘿。"
                        }
                    ]
                },
                {
                    "id": "690700208",
                    "text": "要不要去摸摸阿圆…",
                    "response": [
                        {
                            "id": "690700209",
                            "speaker": "妮露",
                            "text": "欸？原来那个圆滚滚的小家伙就叫阿圆呀？"
                        },
                        {
                            "id": "690700210",
                            "speaker": "妮露",
                            "text": "噗…好厉害的取名方式，把特征概括得很准确哦。"
                        },
                        {
                            "id": "690700211",
                            "speaker": "妮露",
                            "text": "光是看着它就像伸了个大大的懒腰一样，变得放松下来了呢。"
                        }
                    ]
                }
            ]
        }
    ]
}