    "dialogues": [
        {
            "id": "663440201",
            "speaker": "？？？",
            "text": "#是{NICKNAME}{M#哥哥}{F#姐姐}！嘿嘿，好久不见啊！你们还好吗？",
            "choices": [
                {
                    "id": "663440202",
                    "text": "发生什么好事了？",
                    "response": [
                        {
                            "id": "663440203",
                            "speaker": "？？？",
                            "text": "嘿嘿，偷偷告诉你哦，我发现温泉的水温恢复正常了！这下好啦，小鳍游龙们可以开心地玩耍，我也不用提心吊胆了！"
                        },
                        {
                            "id": "663440204",
                            "speaker": "？？？",
                            "text": "接下来我要开开心心地玩！好好享受温泉和火山！"
                        },
                        {
                            "id": "663440205",
                            "speaker": "Player",
                            "text": "祝你开心！"
                        },
                        {
                            "id": "663440206",
                            "speaker": "？？？",
                            "text": "#嗯嗯，{NICKNAME}{M#哥哥}{F#姐姐}也要开心哦！"
                        }
                    ]
                },
                {
                    "id": "663440207",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "663440208",
                            "speaker": "？？？",
                            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，一路顺风！"
                        }
                    ]
                }
            ]
        }
    ]
