    "dialogues": [
        {
            "id": "740001601",
            "speaker": "Player",
            "text": "关于莉诺尔…"
        },
        {
            "id": "740001602",
            "speaker": "恩肖",
            "text": "小东西…和她妈妈一样，那么有活力，那么有主见。"
        },
        {
            "id": "740001603",
            "speaker": "恩肖",
            "text": "小孩子成长得很快，我有什么可说的呢，我只希望她能过上自己想要的生活，健康、快乐，比什么都重要。"
        }
    ]
}