{
    "talkId": "4008150",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 8,
        "铁骨双刀": 7
    },
    "dialogues": [
        {
            "id": "400815001",
            "speaker": "铁骨双刀",
            "text": "你们…马上就要和海妮耶大人交锋了吧？",
            "choices": [
                {
                    "id": "400815002",
                    "text": "怎么了？",
                    "response": [
                        {
                            "id": "400815003",
                            "speaker": "派蒙",
                            "text": "关于海妮耶的事情，我们的心情也有点沉重，你不要乱说话哦，不然我们会生气的…"
                        },
                        {
                            "id": "400815004",
                            "speaker": "铁骨双刀",
                            "text": "不，现在的我没资格对你们任何一边妄加评论，只不过，我看了海妮耶大人和那位…「玲珑油豆腐」女士的比赛。"
                        },
                        {
                            "id": "400815005",
                            "speaker": "铁骨双刀",
                            "text": "海妮耶大人好像动摇了，我还是第一次看见她这幅模样，感觉…很震撼。"
                        },
                        {
                            "id": "400815006",
                            "speaker": "派蒙",
                            "text": "哼！我早就想说了，你到底把海妮耶当成什么铁石心肠的人了啦，这样一点也不尊重她！"
                        },
                        {
                            "id": "400815007",
                            "speaker": "派蒙",
                            "text": "你都没和她说过几句话，根本不了解她吧！我也不了解你，现在我模仿你，只凭你的外表，就猜测你以前是个…"
                        },
                        {
                            "id": "400815008",
                            "speaker": "派蒙",
                            "text": "喝醉了酒以后，嘴上叼着烤焦的蘑菇串，拿着双刀在篝火边跳舞，自己绊倒自己，脸朝下摔个一脸泥巴的笨蛋！"
                        },
                        {
                            "id": "400815009",
                            "speaker": "派蒙",
                            "text": "而且我还到处去和别人说，怎么样？你知道这件事后，难道不会生气吗？"
                        },
                        {
                            "id": "400815010",
                            "speaker": "铁骨双刀",
                            "text": "「白银伴星」！你竟然…竟然猜中了？"
                        },
                        {
                            "id": "400815011",
                            "speaker": "派蒙",
                            "text": "？"
                        },
                        {
                            "id": "400815012",
                            "speaker": "Player",
                            "text": "……"
                        },
                        {
                            "id": "400815013",
                            "speaker": "铁骨双刀",
                            "text": "不过，你说的确实有道理…我确实不知道海妮耶大人本来是什么样的人，也许给她凭空增添了不少麻烦…"
                        },
                        {
                            "id": "400815014",
                            "speaker": "铁骨双刀",
                            "text": "我错了，我不该对海妮耶大人妄加评论，我再次向您道歉！",
                            "choices": [
                                {
                                    "id": "400815015",
                                    "text": "居然震慑了这个大块头！",
                                    "response": [
                                        {
                                            "id": "400815017",
                                            "speaker": "派蒙",
                                            "text": "喂喂，也不用这么夸张啦…我这一套说法都是向神子和莱依拉学的啦！"
                                        },
                                        {
                                            "id": "400815018",
                                            "speaker": "派蒙",
                                            "text": "反正，你知道自己错了就好，以后千万别再这样了哦！"
                                        }
                                    ]
                                },
                                {
                                    "id": "400815016",
                                    "text": "派蒙的气势好强！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400815019",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "400815020",
                            "speaker": "铁骨双刀",
                            "text": "再见…我还要好好反省一下…"
                        }
                    ]
                }
            ]
        }
    ]
}