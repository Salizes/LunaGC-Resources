{
    "talkId": "6200303",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "天叔": 13
    },
    "dialogues": [
        {
            "id": "620030301",
            "speaker": "Player",
            "text": "关于小船。"
        },
        {
            "id": "620030302",
            "speaker": "天叔",
            "text": "怎么，你喜欢这条船吗？她陪了我一辈子了…"
        },
        {
            "id": "620030303",
            "speaker": "天叔",
            "text": "说起老朽我年轻时候钓鱼，虽然穷得叮当响…可是那时候有干劲呀。"
        },
        {
            "id": "620030304",
            "speaker": "天叔",
            "text": "自己干的活，收成都是自己的。流多少汗就能收获多少…那时候的日子真好啊，浑身都有使不完的劲…"
        },
        {
            "id": "620030305",
            "speaker": "天叔",
            "text": "……"
        },
        {
            "id": "620030306",
            "speaker": "天叔",
            "text": "……"
        },
        {
            "id": "620030307",
            "speaker": "Player",
            "text": "……？"
        },
        {
            "id": "620030308",
            "speaker": "天叔",
            "text": "欸哟…刚刚说到哪了来着，说到一半给忘了。"
        },
        {
            "id": "620030309",
            "speaker": "天叔",
            "text": "…哦对，后来呀，不知道拼搏了多久，也借助了一点运气…老朽有了自己的产业，再也不用自己捕鱼了。"
        },
        {
            "id": "620030310",
            "speaker": "天叔",
            "text": "可是…商场上的尔虞我诈，虚与应酬，让老朽越来越觉得不像自己了…"
        },
        {
            "id": "620030311",
            "speaker": "天叔",
            "text": "所以为了找回年轻时候的充实，老朽就在这里钓鱼，偶尔和人叙叙旧。"
        },
        {
            "id": "620030312",
            "speaker": "天叔",
            "text": "说起老朽我年轻时候钓鱼，虽然穷得叮当响……"
        },
        {
            "id": "620030313",
            "speaker": "Player",
            "text": "您已经讲过一遍了…"
        },
        {
            "id": "620030314",
            "speaker": "天叔",
            "text": "…什么讲过？唉…别打岔，老朽我年轻时候钓鱼啊，虽然穷得叮当响…"
        },
        {
            "id": "620030315",
            "speaker": "天叔",
            "text": "可是那时候有干劲呀……"
        },
        {
            "id": "620030316",
            "speaker": "天叔",
            "text": "……"
        }
    ]
}