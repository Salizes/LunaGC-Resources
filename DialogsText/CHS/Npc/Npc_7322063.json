{
    "talkId": "7322063",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 5,
        "婕德": 19
    },
    "dialogues": [
        {
            "id": "732206301",
            "speaker": "婕德",
            "text": "#…{NICKNAME}，是你啊，你从居尔城回来了？"
        },
        {
            "id": "732206302",
            "speaker": "婕德",
            "text": "嗯…对了，你现在找我，是有什么事吗？呃，最近塔尼特的事情稍微有点多…",
            "choices": [
                {
                    "id": "732206303",
                    "text": "关于利露帕尔…",
                    "response": [
                        {
                            "id": "732206304",
                            "speaker": "婕德",
                            "text": "嗯，我听说了，她离开了。回到那个被诅咒的地方去了。"
                        },
                        {
                            "id": "732206305",
                            "speaker": "婕德",
                            "text": "那个家伙，整天一副高高在上的态度惹人不爽，现在可算是安静了…让我松了口气。"
                        },
                        {
                            "id": "732206306",
                            "speaker": "婕德",
                            "text": "不过，她确实帮了我们很多…唔，你说，她在那里会找到什么呢？如果那里什么都没有的话…她也会像我们一样，感到孤独吗？"
                        },
                        {
                            "id": "732206307",
                            "speaker": "婕德",
                            "text": "唉…真可惜没能跟你一起去…"
                        }
                    ]
                },
                {
                    "id": "732206308",
                    "text": "塔尼特的事？",
                    "response": [
                        {
                            "id": "732206309",
                            "speaker": "婕德",
                            "text": "啊，不是什么大事，现在也没法跟你说…"
                        },
                        {
                            "id": "732206310",
                            "speaker": "婕德",
                            "text": "大、大概是旅团里的一些事吧，嗯，也许和那群北方人有关，具体的情况我也不是很清楚…"
                        },
                        {
                            "id": "732206311",
                            "speaker": "婕德",
                            "text": "不过…嗯…"
                        },
                        {
                            "id": "732206312",
                            "speaker": "婕德",
                            "text": "不过…！"
                        },
                        {
                            "id": "732206313",
                            "speaker": "婕德",
                            "text": "呃，对不起，我怎么一惊一乍的…我是说，之后假如我…"
                        },
                        {
                            "id": "732206314",
                            "speaker": "婕德",
                            "text": "不，假如、假如你遇到了危险，请你一定相信我！我永远站在你这边。"
                        },
                        {
                            "id": "732206315",
                            "speaker": "婕德",
                            "text": "假如遭遇危险的是我…我也相信，你一定会来帮我，对吧？",
                            "choices": [
                                {
                                    "id": "732206316",
                                    "text": "当然。",
                                    "response": [
                                        {
                                            "id": "732206317",
                                            "speaker": "婕德",
                                            "text": "嗯…谢谢。你要…小心坏人。"
                                        }
                                    ]
                                },
                                {
                                    "id": "732206318",
                                    "text": "当然，不过别忘了付账。",
                                    "response": [
                                        {
                                            "id": "732206319",
                                            "speaker": "婕德",
                                            "text": "噗…少拿佣兵那套搪塞我了！"
                                        },
                                        {
                                            "id": "732206320",
                                            "speaker": "婕德",
                                            "text": "不过…你要小心。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "732206324",
                    "text": "那就等你有空…",
                    "response": [
                        {
                            "id": "732206325",
                            "speaker": "婕德",
                            "text": "嗯，等我稍微闲一点了，我们再聊…"
                        },
                        {
                            "id": "732206326",
                            "speaker": "婕德",
                            "text": "呃，对了…！对了…"
                        },
                        {
                            "id": "732206327",
                            "speaker": "婕德",
                            "text": "没什么…嗯，不管你遇到什么危险，我会站在你这边。所以…请小心。"
                        }
                    ]
                }
            ]
        }
    ]
}