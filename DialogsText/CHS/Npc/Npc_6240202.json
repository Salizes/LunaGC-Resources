{
    "talkId": "6240202",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "快拳阿凌": 7
    },
    "dialogues": [
        {
            "id": "624020201",
            "speaker": "Player",
            "text": "这是什么拳法？"
        },
        {
            "id": "624020202",
            "speaker": "快拳阿凌",
            "text": "「天下武功，唯快不破」！"
        },
        {
            "id": "624020203",
            "speaker": "快拳阿凌",
            "text": "你有所不知，这是师父传我的「金鼋乱舞」！"
        },
        {
            "id": "624020204",
            "speaker": "快拳阿凌",
            "text": "你就看吧，快不快！快不快！",
            "choices": [
                {
                    "id": "624020205",
                    "text": "我没看见啊…",
                    "response": [
                        {
                            "id": "624020206",
                            "speaker": "快拳阿凌",
                            "text": "没看见？那是你看不懂！"
                        },
                        {
                            "id": "624020207",
                            "speaker": "快拳阿凌",
                            "text": "看不见就对了！你就说我快不快！"
                        }
                    ]
                },
                {
                    "id": "624020208",
                    "text": "这功夫有用吗？",
                    "response": [
                        {
                            "id": "624020209",
                            "speaker": "快拳阿凌",
                            "text": "有没有用，练就对了！这不只是武功，这是求仙寻道！"
                        },
                        {
                            "id": "624020210",
                            "speaker": "快拳阿凌",
                            "text": "为这个我前前后后花了好几万摩拉呢！练了，就值了！对不对，师父！"
                        }
                    ]
                }
            ]
        }
    ]
}