    "dialogues": [
        {
            "id": "676550501",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "676550502",
            "speaker": "阿格拉娅",
            "text": "我…我的梅诗金，我竟然忘了他曾经来过，我忘了…他也被这个仪式卷入…"
        },
        {
            "id": "676550503",
            "speaker": "阿格拉娅",
            "text": "我在这里等待了…等待了那么久…"
        },
        {
            "id": "676550504",
            "speaker": "阿格拉娅",
            "text": "呜呜…竟然连他已经…都忘了…"
        }
