{
    "talkId": "4008154",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "派蒙": 7,
        "风速枣椰": 6
    },
    "dialogues": [
        {
            "id": "400815401",
            "speaker": "风速枣椰",
            "text": "奖金…我的奖金…明明是参赛选手，为什么没有奖金！亏我还高兴了好一阵子…结果根本白来了！",
            "choices": [
                {
                    "id": "400815402",
                    "text": "奖金？",
                    "response": [
                        {
                            "id": "400815403",
                            "speaker": "风速枣椰",
                            "text": "对啊！我明明参加了比赛，居然一摩拉的奖金都没有，这合理吗！"
                        },
                        {
                            "id": "400815404",
                            "speaker": "派蒙",
                            "text": "呃…获得奖金的规则，好像留言板上也有写吧？虽然规则确实很多很复杂，根本看不过来啦，但只进入了预赛，肯定是不够的嘛…"
                        },
                        {
                            "id": "400815405",
                            "speaker": "Player",
                            "text": "我的奖金分你一点？"
                        },
                        {
                            "id": "400815406",
                            "speaker": "派蒙",
                            "text": "啊？真的要这样吗？可我们自己不是也没拿多少奖金吗？"
                        },
                        {
                            "id": "400815407",
                            "speaker": "派蒙",
                            "text": "好吧，看在枣椰怪怪人什么都不懂就被我们打败了，安慰一下她也不是不行…"
                        },
                        {
                            "id": "400815408",
                            "speaker": "风速枣椰",
                            "text": "我我我…我就不用了！"
                        },
                        {
                            "id": "400815409",
                            "speaker": "风速枣椰",
                            "text": "凭别人的好意拿到的奖金，还算得上奖金吗！小弟们听说了这种事，一定会笑话我的！"
                        },
                        {
                            "id": "400815410",
                            "speaker": "派蒙",
                            "text": "为了大姐头的威严…居然能抵挡住摩拉的诱惑？"
                        },
                        {
                            "id": "400815411",
                            "speaker": "派蒙",
                            "text": "有点了不起，我对你刮目相看了哦！"
                        }
                    ]
                },
                {
                    "id": "400815412",
                    "text": "接受现实吧，少女！",
                    "response": [
                        {
                            "id": "400815413",
                            "speaker": "派蒙",
                            "text": "没错，以后你要小心一点啦，至少在做事之前把规则看清楚！不然，总是迷迷糊糊就吃了亏，怎么能行呢！"
                        },
                        {
                            "id": "400815414",
                            "speaker": "风速枣椰",
                            "text": "我已经接受了啦，又不会胡闹，只是有点丧气罢了。"
                        },
                        {
                            "id": "400815415",
                            "speaker": "风速枣椰",
                            "text": "你们别管我啦，我再难过一小下，就…就会打起精神来的！"
                        }
                    ]
                },
                {
                    "id": "400815416",
                    "text": "还是别打扰她了…",
                    "response": [
                        {
                            "id": "400815417",
                            "speaker": "派蒙",
                            "text": "嗯，她之前一直乐呵呵的，这次应该也没什么大问题！"
                        }
                    ]
                }
            ]
        }
    ]
}