{
    "talkId": "6907109",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 8,
        "赛诺": 18
    },
    "dialogues": [
        {
            "id": "690710401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690710402",
            "speaker": "赛诺",
            "text": "仔细想想，我已经五天没有打七圣召唤了。"
        },
        {
            "id": "690710403",
            "speaker": "Player",
            "text": "这个时间很长吗？"
        },
        {
            "id": "690710404",
            "speaker": "赛诺",
            "text": "不，还好，最长记录是二十天。"
        },
        {
            "id": "690710405",
            "speaker": "赛诺",
            "text": "那时候我在执行一个危险的任务，一直没有抽出时间对战。"
        },
        {
            "id": "690710406",
            "speaker": "赛诺",
            "text": "回来后才发现自己的卡组已经过时，接连输了好几局，才逐渐扭转劣势。"
        },
        {
            "id": "690710407",
            "speaker": "赛诺",
            "text": "想要保住胜率，就要不停对战，学习别人的思路。"
        },
        {
            "id": "690710408",
            "speaker": "Player",
            "text": "赛诺很喜欢七圣召唤吗？"
        },
        {
            "id": "690710409",
            "speaker": "赛诺",
            "text": "嗯。看你的表情…很意外吗？"
        },
        {
            "id": "690710410",
            "speaker": "赛诺",
            "text": "其实第一次尝试的时候，我也只把它当做是一种消遣。"
        },
        {
            "id": "690710411",
            "speaker": "赛诺",
            "text": "做风纪官，心中必须有一根弦。这根弦不能松懈，但也不能一直绷紧，否则不知道什么时候就会断掉。"
        },
        {
            "id": "690710412",
            "speaker": "赛诺",
            "text": "所以一开始我接触七圣召唤，是想用它转移注意力，强迫自己放松休息。"
        },
        {
            "id": "690710413",
            "speaker": "赛诺",
            "text": "…不过现在，它对我倒不仅仅是一种消遣了。",
            "choices": [
                {
                    "id": "690710414",
                    "text": "有什么变化吗？",
                    "response": [
                        {
                            "id": "690710416",
                            "speaker": "赛诺",
                            "text": "在以前的工作中，我审判过许多违反规则的罪犯，也听过他们不停控诉。"
                        },
                        {
                            "id": "690710417",
                            "speaker": "赛诺",
                            "text": "在绝大部分时候，我无法理解他们，他们也无法理解我。"
                        },
                        {
                            "id": "690710418",
                            "speaker": "赛诺",
                            "text": "不只是犯人，即便是身边的朋友，也一定有无法相互理解的地方。"
                        },
                        {
                            "id": "690710419",
                            "speaker": "赛诺",
                            "text": "但是在对局的时候，我却能够清晰地感知到对方的想法。"
                        },
                        {
                            "id": "690710420",
                            "speaker": "赛诺",
                            "text": "对胜利的渴望、对卡组的信赖、对决斗的热情…每个人都会隐藏自己的战术，却几乎不会隐藏自身的情感。"
                        },
                        {
                            "id": "690710421",
                            "speaker": "Player",
                            "text": "我也感受到了这种情绪。"
                        },
                        {
                            "id": "690710422",
                            "speaker": "赛诺",
                            "text": "是吗？那要不要来一局？",
                            "choices": [
                                {
                                    "id": "690710423",
                                    "text": "求之不得！",
                                    "response": [
                                        {
                                            "id": "690710425",
                                            "speaker": "赛诺",
                                            "text": "我是不会手下留情的。尽力战胜我吧。"
                                        },
                                        {
                                            "id": "690710426",
                                            "speaker": "赛诺",
                                            "text": "等结束后，我会帮你好好分析的。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690710424",
                                    "text": "还请手下留情…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690710415",
                    "text": "我大概能够理解。"
                }
            ]
        }
    ]
}