{
    "talkId": "6909804",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 7,
        "克洛琳德": 17
    },
    "dialogues": [
        {
            "id": "690980401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690980402",
            "speaker": "克洛琳德",
            "text": "嗯…要来玩有关「决斗」的游戏吗？"
        },
        {
            "id": "690980403",
            "speaker": "Player",
            "text": "我先问问怎么玩…"
        },
        {
            "id": "690980404",
            "speaker": "克洛琳德",
            "text": "很简单，用「命运示数牌」来决定决斗的规则和使用的武器。我以前和师父常玩，不过那时用的是骰子。",
            "choices": [
                {
                    "id": "690980405",
                    "text": "如果骰到了「大失败」…",
                    "response": [
                        {
                            "id": "690980406",
                            "speaker": "克洛琳德",
                            "text": "那么很抱歉，你必须绑住自己的双手双脚来和我决斗。"
                        },
                        {
                            "id": "690980407",
                            "speaker": "Player",
                            "text": "我以为「决斗」要讲求公平…"
                        },
                        {
                            "id": "690980408",
                            "speaker": "克洛琳德",
                            "text": "的确。但那是审判庭上用来自证名誉的决斗。这个游戏是用来锻炼逐影猎人野外生存能力的。"
                        },
                        {
                            "id": "690980409",
                            "speaker": "克洛琳德",
                            "text": "有时候，你就算是断了腿，又折了胳膊，依然需要同魔物战斗。"
                        },
                        {
                            "id": "690980410",
                            "speaker": "克洛琳德",
                            "text": "「永远不能停止思考如何胜利」——这是师父教给我的。"
                        },
                        {
                            "id": "690980411",
                            "speaker": "克洛琳德",
                            "text": "她也有次运气非常不好，武器还只骰到了一根小树枝，结果我还是输了。"
                        },
                        {
                            "id": "690980420",
                            "speaker": "克洛琳德",
                            "text": "不论如何，这都是一个充满随机性的游戏，尝试一下自己极限也未尝不可。输了马上重来就行。"
                        },
                        {
                            "id": "690980421",
                            "speaker": "克洛琳德",
                            "text": "怎么样？你准备好了吗？"
                        },
                        {
                            "id": "690980422",
                            "speaker": "Player",
                            "text": "来…来就来！"
                        },
                        {
                            "id": "690980423",
                            "speaker": "克洛琳德",
                            "text": "嗯，你的眼神比你自认为的更加坚定。我欣赏。"
                        },
                        {
                            "id": "690980424",
                            "speaker": "克洛琳德",
                            "text": "那就开始吧，输了的请吃饭。"
                        }
                    ]
                },
                {
                    "id": "690980412",
                    "text": "如果骰到了「大成功」…",
                    "response": [
                        {
                            "id": "690980413",
                            "speaker": "克洛琳德",
                            "text": "那么恭喜你，你可以选择自己最顺手的武器，外加一次无视致命攻击的机会。我要击中你两次才能赢。"
                        },
                        {
                            "id": "690980414",
                            "speaker": "Player",
                            "text": "我以为「决斗」要讲求公平…"
                        },
                        {
                            "id": "690980415",
                            "speaker": "克洛琳德",
                            "text": "的确。但那是审判庭上用来自证名誉的决斗。这个游戏是用来锻炼逐影猎人野外生存能力的。"
                        },
                        {
                            "id": "690980416",
                            "speaker": "克洛琳德",
                            "text": "但有时就算运气再好，准备得再充分，优秀的逐影猎人也还是会因麻痹大意而败在魔物手下。"
                        },
                        {
                            "id": "690980417",
                            "speaker": "克洛琳德",
                            "text": "「大成功」，反倒有可能成为「大失败」的伏笔。"
                        },
                        {
                            "id": "690980418",
                            "speaker": "克洛琳德",
                            "text": "我运气不算差，在游戏中经常骰出好点数，却常常在自以为获胜的时候被师父反杀。"
                        },
                        {
                            "id": "690980419",
                            "speaker": "克洛琳德",
                            "text": "「猎物在自以为是的时候，才最容易捕获」——这是师父教给我的。"
                        }
                    ]
                }
            ]
        }
    ]
}