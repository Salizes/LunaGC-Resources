    "dialogues": [
        {
            "id": "664910301",
            "speaker": "Player",
            "text": "在悠悠集市能干什么？"
        },
        {
            "id": "664910302",
            "speaker": "「特特尔特特尔」",
            "text": "休憩，获取妙趣横生的货物，品尝特色美食，欣赏色彩缤纷的街道，躺在椅子上挥霍时光。"
        },
        {
            "id": "664910303",
            "speaker": "「特特尔特特尔」",
            "text": "或者让「特特尔特特尔」陪您聊一整天。"
        },
        {
            "id": "664910304",
            "speaker": "Player",
            "text": "谢谢，下次吧。"
        },
        {
            "id": "664910305",
            "speaker": "「特特尔特特尔」",
            "text": "哦嗬嗬，愿您能享受这个心旷神怡的夏天。"
        }
    ]
}