{
    "talkId": "7106212",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 8,
        "安东": 25
    },
    "dialogues": [
        {
            "id": "710621201",
            "speaker": "安东",
            "text": "我们很快就会撤离，如果阻碍了你的冒险，那么实属抱歉。",
            "choices": [
                {
                    "id": "710621202",
                    "text": "关于与千岩军的合作…",
                    "response": [
                        {
                            "id": "710621203",
                            "speaker": "安东",
                            "text": "很久以前的事情了，这里刚刚封闭，我们就找上了璃月的七星。"
                        },
                        {
                            "id": "710621204",
                            "speaker": "安东",
                            "text": "开始大家谈得还可以…「女士」大人还顺势谈成了几笔有利于双方的贸易协定。"
                        },
                        {
                            "id": "710621205",
                            "speaker": "安东",
                            "text": "而愚人众先遣部队进驻层岩巨渊，原本是附加条件之一…我们来到这里为的是调查和消灭异变源头。"
                        },
                        {
                            "id": "710621206",
                            "speaker": "安东",
                            "text": "我们调查所得的一切情报，则是由至冬国和璃月公平共享。"
                        },
                        {
                            "id": "710621207",
                            "speaker": "Player",
                            "text": "你们没有别的目的了吗？"
                        },
                        {
                            "id": "710621208",
                            "speaker": "安东",
                            "text": "至少就我们所知，没有。我们出发时还受到了市民们的祝福，大家都认为…我们是牺牲自己保护别人的英雄部队。"
                        },
                        {
                            "id": "710621209",
                            "speaker": "安东",
                            "text": "唉…谁知道，现在事情变成了这样。"
                        }
                    ]
                },
                {
                    "id": "710621210",
                    "text": "关于「黑灾」…",
                    "response": [
                        {
                            "id": "710621211",
                            "speaker": "安东",
                            "text": "或者「漆黑灾祸」，或者随便怎么称呼…五百年前的那场大灾难。"
                        },
                        {
                            "id": "710621212",
                            "speaker": "安东",
                            "text": "总之…是我们至冬人永恒的敌人，我们相信的是…五百年来，灾祸一直在潜伏着，而我们会永远保持警惕。"
                        }
                    ]
                },
                {
                    "id": "710621213",
                    "text": "关于你们自己…",
                    "response": [
                        {
                            "id": "710621214",
                            "speaker": "安东",
                            "text": "我们自己？有什么好说的…我们在努力战斗了，但失败了，就这么简单。"
                        },
                        {
                            "id": "710621215",
                            "speaker": "安东",
                            "text": "下来的时候我们是第九连队，六十四人。可到现在呢？包括连长在内…牺牲或失踪的可能超过一半以上，也可能不到…"
                        },
                        {
                            "id": "710621216",
                            "speaker": "安东",
                            "text": "但大体差不多…我们都被打散了，彼此失去了联系…我们已经输了，早就该撤离了…"
                        },
                        {
                            "id": "710621217",
                            "speaker": "Player",
                            "text": "你们在地面的同僚攻击了璃月港。"
                        },
                        {
                            "id": "710621218",
                            "speaker": "安东",
                            "text": "…很惊讶，但完全理解。"
                        },
                        {
                            "id": "710621219",
                            "speaker": "安东",
                            "text": "为了协助更有意义的冒险，「公鸡」大人自然会抛弃相对低价值的资产，这是他的理性。"
                        },
                        {
                            "id": "710621220",
                            "speaker": "安东",
                            "text": "我们作为他的直属部下，对此完全可以接受…"
                        }
                    ]
                },
                {
                    "id": "710621221",
                    "text": "关于卡塔琳娜…",
                    "response": [
                        {
                            "id": "710621222",
                            "speaker": "安东",
                            "text": "你遇见她了？她还活着…？我希望她能原谅我们。"
                        },
                        {
                            "id": "710621223",
                            "speaker": "安东",
                            "text": "她和她的弟弟，尼古拉下士，都是在「壁炉之家」长大的…是女皇陛下的孩子们。"
                        },
                        {
                            "id": "710621224",
                            "speaker": "安东",
                            "text": "她和我说一定要找到弟弟才行，我以为是下面的环境搞坏了她的脑子才让她那样子出丑…她的弟弟不可能活下来了。",
                            "choices": [
                                {
                                    "id": "710621225",
                                    "text": "所以你们抛弃了她？",
                                    "response": [
                                        {
                                            "id": "710621226",
                                            "speaker": "安东",
                                            "text": "抛弃…？不，她…她是自愿要留下的。毕竟，我们中的任何人带着不必要的牵挂…只会拖慢整个队伍。"
                                        },
                                        {
                                            "id": "710621227",
                                            "speaker": "安东",
                                            "text": "毕竟我们…每一个人都要做好为众人牺牲自己，或为众人牺牲重要之人的准备…这是作为愚人众的觉悟。"
                                        },
                                        {
                                            "id": "710621228",
                                            "speaker": "安东",
                                            "text": "卡佳她一定也做好了这样的觉悟，科利亚也是的。"
                                        },
                                        {
                                            "id": "710621229",
                                            "speaker": "安东",
                                            "text": "如果他们对我做出相同的事情，我也完全可以理解。"
                                        }
                                    ]
                                },
                                {
                                    "id": "710621230",
                                    "text": "她的状况没你说的那么差。",
                                    "response": [
                                        {
                                            "id": "710621231",
                                            "speaker": "安东",
                                            "text": "因为你是外人。愚人众不能也不应该对平民失态。"
                                        },
                                        {
                                            "id": "710621232",
                                            "speaker": "安东",
                                            "text": "但对于她来说，我们是家人。她也是我们的家人…曾经是的。"
                                        },
                                        {
                                            "id": "710621233",
                                            "speaker": "安东",
                                            "text": "是她自己执意要找科利亚的…希望她能原谅我们。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}