{
    "talkId": "7167007",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "齐勇": 11
    },
    "dialogues": [
        {
            "id": "716700701",
            "speaker": "齐勇",
            "text": "新一轮的战斗来了啊，实在令人兴奋！"
        },
        {
            "id": "716700702",
            "speaker": "齐勇",
            "text": "不知道这次，我们能在秘境中支撑多久…",
            "choices": [
                {
                    "id": "716700703",
                    "text": "不是在外边防御作战吗？",
                    "response": [
                        {
                            "id": "716700704",
                            "speaker": "齐勇",
                            "text": "攻势防御也是一种对抗敌军的手段，有时甚至能起到极为关键的作用。"
                        },
                        {
                            "id": "716700705",
                            "speaker": "齐勇",
                            "text": "地脉紊乱点活跃的初期，我们组织过精锐的斥候部队，攻入其中，探查到了不少有效情报。"
                        },
                        {
                            "id": "716700706",
                            "speaker": "齐勇",
                            "text": "这种磨砺自己的战局可不多，换成我原本所在的队伍，每个战友都会抢着上前！"
                        }
                    ]
                },
                {
                    "id": "716700707",
                    "text": "要注意保存自身的力量…",
                    "response": [
                        {
                            "id": "716700708",
                            "speaker": "齐勇",
                            "text": "请放心，我们都知道把握分寸。"
                        },
                        {
                            "id": "716700709",
                            "speaker": "齐勇",
                            "text": "准确评估敌我战力差距，是战士必不可少的本领。"
                        },
                        {
                            "id": "716700710",
                            "speaker": "齐勇",
                            "text": "在抵达极限前，绝不表现出半分怯懦，保持最为稳定的进攻节奏。"
                        },
                        {
                            "id": "716700711",
                            "speaker": "齐勇",
                            "text": "在面对绝无可能战胜的强敌时，绝不莽撞应战，而是互相照应，有序脱离接触，等待援军或更为合适的战机。"
                        },
                        {
                            "id": "716700712",
                            "speaker": "齐勇",
                            "text": "总之，我们会将战斗的主动权牢牢掌握在自己手中！"
                        }
                    ]
                },
                {
                    "id": "716700713",
                    "text": "我也摩拳擦掌！",
                    "response": [
                        {
                            "id": "716700714",
                            "speaker": "齐勇",
                            "text": "能和您并肩作战实在荣幸，我的斗志正在燃烧！"
                        }
                    ]
                }
            ]
        }
    ]
}