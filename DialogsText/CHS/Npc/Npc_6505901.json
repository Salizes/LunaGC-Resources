{
    "talkId": "6505901",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "奥利弗": 5,
        "爱丝蒂": 6,
        "马尼特": 3
    },
    "dialogues": [
        {
            "id": "650590101",
            "speaker": "爱丝蒂",
            "text": "…你家壁炉里的火，最近烧得挺旺吧？"
        },
        {
            "id": "650590102",
            "speaker": "奥利弗",
            "text": "你家里的天平，最近也用得很勤吧？"
        },
        {
            "id": "650590103",
            "speaker": "马尼特",
            "text": "我家火挺旺的，柴火足！天平咱用不上，买菜不缺那点斤两。"
        },
        {
            "id": "650590104",
            "speaker": "爱丝蒂",
            "text": "……"
        },
        {
            "id": "650590105",
            "speaker": "爱丝蒂",
            "text": "你最好小心着点，要是火苗跳到了歌剧院的地毯上，那灭火的时候，恐怕就得连你家壁炉里的火一起灭了。"
        },
        {
            "id": "650590106",
            "speaker": "奥利弗",
            "text": "哟，这还真是不得了。但你怎么能保证，歌剧院能从火焰中幸存呢？"
        },
        {
            "id": "650590107",
            "speaker": "马尼特",
            "text": "我寻思家里的火烧不到歌剧院，远着咧！"
        },
        {
            "id": "650590108",
            "speaker": "奥利弗",
            "text": "……"
        },
        {
            "id": "650590109",
            "speaker": "爱丝蒂",
            "text": "…所以，最近那些火苗还老实吗？"
        },
        {
            "id": "650590110",
            "speaker": "奥利弗",
            "text": "哼，你猜？"
        },
        {
            "id": "650590111",
            "speaker": "爱丝蒂",
            "text": "我才不猜，你老实交代。"
        },
        {
            "id": "650590112",
            "speaker": "马尼特",
            "text": "我猜老实得很，火苗能造到哪里去？"
        },
        {
            "id": "650590113",
            "speaker": "奥利弗",
            "text": "……"
        },
        {
            "id": "650590114",
            "speaker": "爱丝蒂",
            "text": "……"
        }
    ]
}