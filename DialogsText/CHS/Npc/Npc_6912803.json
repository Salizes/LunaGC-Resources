{
    "talkId": "6912803",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 11,
        "法尔伽": 18
    },
    "dialogues": [
        {
            "id": "691280301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691280302",
            "speaker": "法尔伽",
            "text": "「聊天」？行啊，我可会聊了！"
        },
        {
            "id": "691280303",
            "speaker": "法尔伽",
            "text": "……"
        },
        {
            "id": "691280304",
            "speaker": "Player",
            "text": "…为何沉默？"
        },
        {
            "id": "691280305",
            "speaker": "法尔伽",
            "text": "…我在等你拿酒出来？难道…没有吗？"
        },
        {
            "id": "691280306",
            "speaker": "Player",
            "text": "没有哦…"
        },
        {
            "id": "691280307",
            "speaker": "法尔伽",
            "text": "不配酒干聊天…哈哈，原来是这样…",
            "choices": [
                {
                    "id": "691280308",
                    "text": "你看起来特别失落。",
                    "response": [
                        {
                            "id": "691280310",
                            "speaker": "法尔伽",
                            "text": "没事，我是经验老到的西风骑士，无论遇到怎样的情景都能迅速调节自己的状态…"
                        },
                        {
                            "id": "691280311",
                            "speaker": "法尔伽",
                            "text": "是我今天的期待值不恰当地高了一点而已。我没关系，好，来吧！开始我们的「会谈」。",
                            "choices": [
                                {
                                    "id": "691280312",
                                    "text": "呃…会谈？",
                                    "response": [
                                        {
                                            "id": "691280314",
                                            "speaker": "法尔伽",
                                            "text": "这种没有酒的聊天，我通常称之为「会谈」。"
                                        },
                                        {
                                            "id": "691280315",
                                            "speaker": "法尔伽",
                                            "text": "上次「会谈」好像还是在跟魔女会的女士们喝茶？嗯，远征期间也遇上过几次…",
                                            "choices": [
                                                {
                                                    "id": "691280316",
                                                    "text": "那干脆就聊聊…",
                                                    "response": [
                                                        {
                                                            "id": "691280318",
                                                            "speaker": "法尔伽",
                                                            "text": "嚯，这确实是个不错的话题。首先拿大家的共同点，或是对方关心的人或事来切入。就比如说…"
                                                        },
                                                        {
                                                            "id": "691280319",
                                                            "speaker": "法尔伽",
                                                            "text": "「哎呀，您家的孩子真可爱！不让人省心？哈哈，孩子嘛，哪有让人省心的，就说我家那两个…」"
                                                        },
                                                        {
                                                            "id": "691280320",
                                                            "speaker": "法尔伽",
                                                            "text": "「想在提瓦特找个落脚地？那肯定得是蒙德啊！我跟您说说这蒙德都有哪些好…」"
                                                        },
                                                        {
                                                            "id": "691280321",
                                                            "speaker": "法尔伽",
                                                            "text": "等话题开始热络之后，再寻找新的突破口…"
                                                        },
                                                        {
                                                            "id": "691280322",
                                                            "speaker": "法尔伽",
                                                            "text": "「您看孩子都留在蒙德了，各位魔女不妨也加入我们？」"
                                                        },
                                                        {
                                                            "id": "691280323",
                                                            "speaker": "法尔伽",
                                                            "text": "「噢，不是要几位加入骑士团的意思，我想想…外援这个词还合适吗？」"
                                                        },
                                                        {
                                                            "id": "691280324",
                                                            "speaker": "法尔伽",
                                                            "text": "接着趁对方还在犹豫的时候，一口气打消掉顾虑！然后一锤定音！"
                                                        },
                                                        {
                                                            "id": "691280325",
                                                            "speaker": "法尔伽",
                                                            "text": "「放心！蒙德本来就什么人都有。您大概听说过？就连北风王狼都是从异乡流浪来的！」"
                                                        },
                                                        {
                                                            "id": "691280326",
                                                            "speaker": "法尔伽",
                                                            "text": "「也不用特地做什么！大部分情况我们自己能处理，真遇上得请诸位出手的时候…我猜也是合乎大家立场的。」"
                                                        },
                                                        {
                                                            "id": "691280327",
                                                            "speaker": "Player",
                                                            "text": "真有两下。"
                                                        },
                                                        {
                                                            "id": "691280328",
                                                            "speaker": "法尔伽",
                                                            "text": "哈哈，多谢你的赞美！那么，为了回报你的赏识，咱们去喝一杯吧，我请！"
                                                        },
                                                        {
                                                            "id": "691280329",
                                                            "speaker": "Player",
                                                            "text": "还惦记着呢！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691280317",
                                                    "text": "你跟魔女会最初是怎么聊的？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691280313",
                                    "text": "倒也不必那么正式…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691280309",
                    "text": "你平时不也聊得挺欢吗？"
                }
            ]
        }
    ]
}