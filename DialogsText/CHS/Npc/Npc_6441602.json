    "speaker_counts": {
        "Player": 1,
        "纳瓦兹": 4
    },
    "dialogues": [
        {
            "id": "644160201",
            "speaker": "Player",
            "text": "圣金虫？"
        },
        {
            "id": "644160202",
            "speaker": "纳瓦兹",
            "text": "什么，你不知道吗？圣金虫是世界上最酷——的虫子啦！"
        },
        {
            "id": "644160203",
            "speaker": "纳瓦兹",
            "text": "它有着最酷的甲壳，和最酷的花纹，在阳光下闪着最酷的金光。"
        },
        {
            "id": "644160204",
            "speaker": "纳瓦兹",
            "text": "听大人们讲，圣金虫里被赤王放进了很厉害的东西，所以它能一直保护我们。"
        },
        {
            "id": "644160205",
            "speaker": "纳瓦兹",
            "text": "听上去好厉害哦！"
        }
    ]
}