{
    "talkId": "6901604",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 6,
        "迪卢克": 11
    },
    "dialogues": [
        {
            "id": "690160401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690160901",
            "speaker": "迪卢克",
            "text": "嗯，请尝一下这个。"
        },
        {
            "id": "690160902",
            "speaker": "迪卢克",
            "text": "无酒精饮料，基底是祖上的配方。但我在调制的时候，也融入了一些自己的想法。",
            "choices": [
                {
                    "id": "690160903",
                    "text": "很清新的口感。",
                    "response": [
                        {
                            "id": "690160905",
                            "speaker": "迪卢克",
                            "text": "看你的表情，你是喜欢的。"
                        },
                        {
                            "id": "690160906",
                            "speaker": "迪卢克",
                            "text": "那就好。我根据你的口味进行过一些调整，看来方向没有错。"
                        },
                        {
                            "id": "690160907",
                            "speaker": "迪卢克",
                            "text": "接下来还有一件事情要拜托你。"
                        },
                        {
                            "id": "690160908",
                            "speaker": "迪卢克",
                            "text": "这款饮料需要一个名字。既然配方改动过，原先的名字就已经不适合了。"
                        },
                        {
                            "id": "690160909",
                            "speaker": "Player",
                            "text": "是希望我来想吗？"
                        },
                        {
                            "id": "690160910",
                            "speaker": "迪卢克",
                            "text": "嗯，这是按你口味调制的，我觉得用你起的名字才更妥帖。"
                        },
                        {
                            "id": "690160911",
                            "speaker": "迪卢克",
                            "text": "还是说…你希望直接用你的名字？",
                            "choices": [
                                {
                                    "id": "690160912",
                                    "text": "感觉怪怪的。",
                                    "response": [
                                        {
                                            "id": "690160914",
                                            "speaker": "迪卢克",
                                            "text": "…说得也是。"
                                        },
                                        {
                                            "id": "690160915",
                                            "speaker": "迪卢克",
                                            "text": "没关系，你可以慢慢想。如果忘了味道，我也可以再调制一杯给你。"
                                        },
                                        {
                                            "id": "690160916",
                                            "speaker": "迪卢克",
                                            "text": "随时随地。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690160913",
                                    "text": "我还是再想想…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690160904",
                    "text": "很浓烈的回味！"
                }
            ]
        }
    ]
}