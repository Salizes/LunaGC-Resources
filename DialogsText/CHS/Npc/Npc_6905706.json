    "dialogues": [
        {
            "id": "690570601",
            "speaker": "Player",
            "text": "晚安，一斗。"
        },
        {
            "id": "690570602",
            "speaker": "荒泷一斗",
            "text": "啊…这个点就要睡了吗？"
        },
        {
            "id": "690570603",
            "speaker": "荒泷一斗",
            "text": "弱者才要睡觉，我们显然都是强者啊！不如再玩两把捉迷藏怎么样？"
        },
        {
            "id": "690570604",
            "speaker": "荒泷一斗",
            "text": "大晚上玩这个可刺激了，我就本色出演来当鬼吧，你快去藏好！"
        }
    ]
