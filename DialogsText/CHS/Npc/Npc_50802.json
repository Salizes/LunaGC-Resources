    "dialogues": [
        {
            "id": "5080201",
            "speaker": "幕府公告",
            "text": "近日有行踪可疑之外国人士进入稻妻城区，游荡不定，可见动机险恶。"
        },
        {
            "id": "5080202",
            "speaker": "幕府公告",
            "text": "幕府特此通告：举报可疑人员可得重赏，包庇者必加严惩！"
        },
        {
            "id": "5080203",
            "speaker": "幕府公告",
            "text": "常道恢弘，鸣神永恒。"
        }
    ]
}