    "dialogues": [
        {
            "id": "650270201",
            "speaker": "Player",
            "text": "关于香水…"
        },
        {
            "id": "650270202",
            "speaker": "卡嘉妮",
            "text": "芳香不仅仅是气味，也是一种生活态度，是人生行走过后留下的痕迹。"
        },
        {
            "id": "650270203",
            "speaker": "卡嘉妮",
            "text": "您认为香水最易消散吗？我并不否认。"
        },
        {
            "id": "650270204",
            "speaker": "卡嘉妮",
            "text": "但为何那看不见的香气常令人魂牵梦绕呢？"
        }
    ]
}