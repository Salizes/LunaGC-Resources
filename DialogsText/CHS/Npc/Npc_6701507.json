    "dialogues": [
        {
            "id": "670150701",
            "speaker": "Player",
            "text": "有什么特别的水果吗…"
        },
        {
            "id": "670150702",
            "speaker": "采若",
            "text": "特别的水果？你瞧这墩墩桃，还有这青蜜莓，在挪德卡莱已经算是很特别的水果啦。"
        },
        {
            "id": "670150703",
            "speaker": "采若",
            "text": "如果你想要璃月特产，我倒是也能帮你订购，不过，这就要视商队的时间安排啦。",
            "choices": [
                {
                    "id": "670150704",
                    "text": "听起来还挺麻烦的…",
                    "response": [
                        {
                            "id": "670150706",
                            "speaker": "采若",
                            "text": "……"
                        },
                        {
                            "id": "670150707",
                            "speaker": "采若",
                            "text": "没问题，客人请您看这边！这一堆墩墩桃可新鲜啦，来来，你直接尝一个吧。"
                        }
                    ]
                },
                {
                    "id": "670150705",
                    "text": "那我还是看看别的吧。"
                }
            ]
        }
    ]
