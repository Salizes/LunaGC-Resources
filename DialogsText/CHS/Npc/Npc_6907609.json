{
    "talkId": "6907609",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "珐露珊": 12
    },
    "dialogues": [
        {
            "id": "690760201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690760202",
            "speaker": "珐露珊",
            "text": "放心好了，我又不是那种讨人嫌的挑剔老学者…平时也不难相处…"
        },
        {
            "id": "690760203",
            "speaker": "珐露珊",
            "text": "嗯？你那是什么信不过我的表情？"
        },
        {
            "id": "690760204",
            "speaker": "珐露珊",
            "text": "我偶尔挑三拣四，也是针对教令院的离谱规矩，或是某些不讲礼貌的学生。"
        },
        {
            "id": "690760205",
            "speaker": "珐露珊",
            "text": "你为人又好，这里环境也不错，我怎么会有不满呢？",
            "choices": [
                {
                    "id": "690760206",
                    "text": "喜欢就好。",
                    "response": [
                        {
                            "id": "690760207",
                            "speaker": "珐露珊",
                            "text": "哈哈，像你这样细心周到的后辈，现在已经很少见啦。"
                        },
                        {
                            "id": "690760208",
                            "speaker": "珐露珊",
                            "text": "那假如住一段时间之后，我发现了设计不合理的地方，我也会如实照说，没问题吧？"
                        },
                        {
                            "id": "690760214",
                            "speaker": "Player",
                            "text": "好！没问题。"
                        },
                        {
                            "id": "690760215",
                            "speaker": "珐露珊",
                            "text": "很好。看来，我可以安心在这研究我感兴趣的东西了。"
                        },
                        {
                            "id": "690760216",
                            "speaker": "珐露珊",
                            "text": "即使再住上一百年…呵呵，我也非常乐意。"
                        }
                    ]
                },
                {
                    "id": "690760209",
                    "text": "还有什么需要吗？",
                    "response": [
                        {
                            "id": "690760210",
                            "speaker": "珐露珊",
                            "text": "好。能帮我多备些纸笔吗？"
                        },
                        {
                            "id": "690760211",
                            "speaker": "珐露珊",
                            "text": "来的时候，没想到这个地方的构造如此独特。"
                        },
                        {
                            "id": "690760212",
                            "speaker": "珐露珊",
                            "text": "到底是什么样的机关才能把这一切收纳成一方净土，我得再研究一下…"
                        },
                        {
                            "id": "690760213",
                            "speaker": "珐露珊",
                            "text": "要是又写得满地都是，可不太对得起你啊…"
                        }
                    ]
                }
            ]
        }
    ]
}