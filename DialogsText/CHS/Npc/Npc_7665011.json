{
    "talkId": "7665011",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 7,
        "凛角鹿": 2,
        "派蒙": 1,
        "海崖鹦": 1,
        "菈乌玛": 23
    },
    "dialogues": [
        {
            "id": "766501101",
            "speaker": "菈乌玛",
            "text": "也算是告一段落了。接下来，就是怎么把这些东西放回去…"
        },
        {
            "id": "766501102",
            "speaker": "Player",
            "text": "这些东西是…"
        },
        {
            "id": "766501103",
            "speaker": "菈乌玛",
            "text": "是的…里面有已经化石化的古树种子、动物的骨骸化石，彩色的石头…"
        },
        {
            "id": "766501104",
            "speaker": "菈乌玛",
            "text": "…还有人家埋下去的存钱罐、许愿盒、带画片的信件…"
        },
        {
            "id": "766501105",
            "speaker": "Player",
            "text": "什么都往回拿啊！"
        },
        {
            "id": "766501106",
            "speaker": "菈乌玛",
            "text": "毕竟盗宝鼬眼中的「珍贵」和我们眼中的「珍贵」，并非一个概念。只要看着新奇，它就会把那东西收入包里。"
        },
        {
            "id": "766501107",
            "speaker": "菈乌玛",
            "text": "种子和石头倒是好说，但那些存钱罐和许愿盒，看起来必然是被人特意埋下去，预备着将来再挖出来的。"
        },
        {
            "id": "766501108",
            "speaker": "Player",
            "text": "需要我帮忙吗？"
        },
        {
            "id": "766501109",
            "speaker": "菈乌玛",
            "text": "谢谢好意。我已经请了一位稳重些的盗宝鼬过来，到时候，会由它把这些东西都放回原位。"
        },
        {
            "id": "766501110",
            "speaker": "菈乌玛",
            "text": "毕竟是那孩子的心意，若是直接让它放回…难免有些伤它的心。"
        },
        {
            "id": "766501111",
            "speaker": "派蒙",
            "text": "可是，那一只你请过来的盗宝鼬，难道不会把事情都告诉它吗？"
        },
        {
            "id": "766501112",
            "speaker": "菈乌玛",
            "text": "这只小盗宝鼬并不惯于聚居，总是单独出没。它们大概是遇不见的。"
        },
        {
            "id": "766501113",
            "speaker": "菈乌玛",
            "text": "而且它的注意力转移颇快。大约过半个月，它应当就不记得它挖出过什么事物了吧。",
            "choices": [
                {
                    "id": "766501114",
                    "text": "菈乌玛真了解动物的习性。",
                    "response": [
                        {
                            "id": "766501116",
                            "speaker": "菈乌玛",
                            "text": "我和它们语言相通，又久日作伴，自然能理解它们，就像是一般人交朋友一样。"
                        },
                        {
                            "id": "766501117",
                            "speaker": "菈乌玛",
                            "text": "不过，一般人并不能听懂动物们的话，想要理解动物，多少会有些差池。"
                        },
                        {
                            "id": "766501118",
                            "speaker": "菈乌玛",
                            "text": "比如在外面作家们的笔下，「兽性」一词往往偏贬，而「人性」一词，却褒贬皆有…",
                            "choices": [
                                {
                                    "id": "766501119",
                                    "text": "毕竟是人类写的书嘛。",
                                    "response": [
                                        {
                                            "id": "766501121",
                                            "speaker": "菈乌玛",
                                            "text": "噗…你说得对。如果是让一匹狼，或者是一只凛角鹿来写书的话，或许书中内容就会大为不同了。"
                                        },
                                        {
                                            "id": "766501122",
                                            "speaker": "凛角鹿",
                                            "text": "……"
                                        },
                                        {
                                            "id": "766501123",
                                            "speaker": "菈乌玛",
                                            "text": "…但对我来说，无论是「人性」抑或「兽性」，皆为一般「性格」。"
                                        },
                                        {
                                            "id": "766501124",
                                            "speaker": "菈乌玛",
                                            "text": "无论是人是兽，都会时而勇敢，时而怯懦，时而贪婪入脑，时而怒气攻心…"
                                        },
                                        {
                                            "id": "766501125",
                                            "speaker": "海崖鹦",
                                            "text": "♪"
                                        },
                                        {
                                            "id": "766501126",
                                            "speaker": "菈乌玛",
                                            "text": "功成则心喜，功败则垂丧…这一切并无人兽之分，皆为生于「自然」，发于「自然」的「性格」。"
                                        },
                                        {
                                            "id": "766501127",
                                            "speaker": "菈乌玛",
                                            "text": "我有时也会想，假若人兽之语生而相通，周围诸事会不会…更好一些。"
                                        },
                                        {
                                            "id": "766501128",
                                            "speaker": "菈乌玛",
                                            "text": "…但这类想法，终究是无谓空想。"
                                        },
                                        {
                                            "id": "766501129",
                                            "speaker": "菈乌玛",
                                            "text": "有些人，就是无论如何，都不愿意理解自然的。"
                                        },
                                        {
                                            "id": "766501130",
                                            "speaker": "菈乌玛",
                                            "text": "在这类恶徒的眼中，无论屠戮的对象是否与他们语言相通，他们扣动扳机的动作，也不会慢下来半分。"
                                        },
                                        {
                                            "id": "766501131",
                                            "speaker": "凛角鹿",
                                            "text": "……"
                                        },
                                        {
                                            "id": "766501132",
                                            "speaker": "菈乌玛",
                                            "text": "…好孩子，我知道你能保护好自己，跑得也比他们快。安心，不会再有人伤害你们了。"
                                        },
                                        {
                                            "id": "766501133",
                                            "speaker": "菈乌玛",
                                            "text": "一不小心聊了这么久，我也该继续给那堆「宝物」做分类了。"
                                        },
                                        {
                                            "id": "766501134",
                                            "speaker": "菈乌玛",
                                            "text": "离我和那条盗宝鼬约的时间还早，应该足够把它们分类好了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "766501120",
                                    "text": "毕竟他们听不懂动物说话啦。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "766501115",
                    "text": "也很了解动物的心理。"
                }
            ]
        }
    ]
}