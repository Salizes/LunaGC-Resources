    "dialogues": [
        {
            "id": "642240201",
            "speaker": "Player",
            "text": "你有什么苦恼吗？"
        },
        {
            "id": "642240202",
            "speaker": "兰伽卢",
            "text": "#啊，是那菈{NICKNAME}，你好。"
        },
        {
            "id": "642240203",
            "speaker": "兰伽卢",
            "text": "兰伽卢想知道，那菈的种地方式。他们不会夸赞花，也不会唱歌给果树听。"
        },
        {
            "id": "642240204",
            "speaker": "兰伽卢",
            "text": "但是却也能让树木高兴起来。"
        },
        {
            "id": "642240205",
            "speaker": "兰伽卢",
            "text": "#那菈{NICKNAME}知道他们是怎么做到的吗？"
        }
    ]
}