{
    "talkId": "6905910",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "鹿野院平藏": 17
    },
    "dialogues": [
        {
            "id": "690590301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690590302",
            "speaker": "鹿野院平藏",
            "text": "好呀，当然好。我正期待着一展拳脚呢！",
            "choices": [
                {
                    "id": "690590303",
                    "text": "拳…什么？",
                    "response": [
                        {
                            "id": "690590305",
                            "speaker": "鹿野院平藏",
                            "text": "哈哈，别误会。你看，我在这里晃悠了有些时间。"
                        },
                        {
                            "id": "690590306",
                            "speaker": "鹿野院平藏",
                            "text": "大到布景风格、场地规划，小到陈列出来的摆件样式…已经从中掌握了不少你的信息哦。"
                        },
                        {
                            "id": "690590307",
                            "speaker": "鹿野院平藏",
                            "text": "据我推断，某些地方的布置，也不一定都是出自你的喜好，很可能是为了来访的朋友专门打造的。"
                        },
                        {
                            "id": "690590308",
                            "speaker": "鹿野院平藏",
                            "text": "证据，以及具体分析的话…",
                            "choices": [
                                {
                                    "id": "690590309",
                                    "text": "厉害！不愧是侦探！",
                                    "response": [
                                        {
                                            "id": "690590310",
                                            "speaker": "鹿野院平藏",
                                            "text": "哦？用表扬打断话题吗？"
                                        },
                                        {
                                            "id": "690590313",
                                            "speaker": "鹿野院平藏",
                                            "text": "看来你也有不想被我点破的小秘密呢。"
                                        },
                                        {
                                            "id": "690590314",
                                            "speaker": "鹿野院平藏",
                                            "text": "那就和你聊聊我自己吧。我想想…"
                                        },
                                        {
                                            "id": "690590315",
                                            "speaker": "鹿野院平藏",
                                            "text": "身份和社会关系，你早就听说过了。日常喜好嘛，我们都相处那么久了。"
                                        },
                                        {
                                            "id": "690590316",
                                            "speaker": "鹿野院平藏",
                                            "text": "至于我家里的情况，我猜你也没太大兴趣了解。"
                                        },
                                        {
                                            "id": "690590317",
                                            "speaker": "鹿野院平藏",
                                            "text": "这样吧！我把我的「弱点」告诉你。"
                                        },
                                        {
                                            "id": "690590318",
                                            "speaker": "Player",
                                            "text": "平藏也有弱点吗？"
                                        },
                                        {
                                            "id": "690590319",
                                            "speaker": "鹿野院平藏",
                                            "text": "是啊。别看我平时做出的都是理性分析。但其实，我是个非常容易被「感性」打动的人哦。"
                                        },
                                        {
                                            "id": "690590320",
                                            "speaker": "鹿野院平藏",
                                            "text": "那些不断努力的人身上发出的光芒，会在我的记忆中留下烈焰花一样浓重的色彩。"
                                        },
                                        {
                                            "id": "690590321",
                                            "speaker": "鹿野院平藏",
                                            "text": "为此，我才要努力保护善意不被利用，祝福美丽的事物可以一直美丽下去。"
                                        },
                                        {
                                            "id": "690590322",
                                            "speaker": "鹿野院平藏",
                                            "text": "顺带一提，和你在一起的时候，我也有过很多次这种感觉，「噔」地一下被你打动了。"
                                        },
                                        {
                                            "id": "690590323",
                                            "speaker": "鹿野院平藏",
                                            "text": "嘘！因为是「弱点」，拜托你要好好保密哦。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690590311",
                                    "text": "我也想掌握你的信息！",
                                    "response": [
                                        {
                                            "id": "690590312",
                                            "speaker": "鹿野院平藏",
                                            "text": "哦？直接岔开话题吗？"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690590304",
                    "text": "动嘴还是动手？"
                }
            ]
        }
    ]
}