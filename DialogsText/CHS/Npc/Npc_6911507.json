{
    "talkId": "6911507",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "塔利雅": 7
    },
    "dialogues": [
        {
            "id": "691150201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691150202",
            "speaker": "塔利雅",
            "text": "还不错，这里是个适合祷告的地方。"
        },
        {
            "id": "691150203",
            "speaker": "塔利雅",
            "text": "不过，我一直没有找到适合喝酒的场所，要不要考虑建一个吧台？",
            "choices": [
                {
                    "id": "691150204",
                    "text": "教职人员这么喜欢喝酒合适吗？",
                    "response": [
                        {
                            "id": "691150205",
                            "speaker": "塔利雅",
                            "text": "巴巴托斯的风带来了甘霖和种子，我们才得以酿制美酒。"
                        },
                        {
                            "id": "691150206",
                            "speaker": "塔利雅",
                            "text": "美酒既是风神降下的诸多赐福，也是蒙德的标志之一。"
                        },
                        {
                            "id": "691150207",
                            "speaker": "塔利雅",
                            "text": "作为西风教会成员，厌弃美酒才是对风神的亵渎。不是吗？"
                        }
                    ]
                },
                {
                    "id": "691150208",
                    "text": "好主意！",
                    "response": [
                        {
                            "id": "691150209",
                            "speaker": "塔利雅",
                            "text": "太好了，我正好认识很多酒馆老板，采购酒水的事就交给我吧。"
                        },
                        {
                            "id": "691150210",
                            "speaker": "塔利雅",
                            "text": "对了，再请一位驻唱吧？我有一位推荐的吟游诗人。"
                        }
                    ]
                }
            ]
        }
    ]
}