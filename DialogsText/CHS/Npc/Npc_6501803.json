    "dialogues": [
        {
            "id": "650180301",
            "speaker": "Player",
            "text": "关于警卫机关…"
        },
        {
            "id": "650180302",
            "speaker": "诺尔",
            "text": "警卫机关虽然是机械，但其实是警备队不可或缺的部分。城内的日常治安几乎都要依靠它们维持。"
        },
        {
            "id": "650180303",
            "speaker": "诺尔",
            "text": "而我嘛，更像是负责维护警卫机关的工程师吧。"
        }
    ]
}