    "speaker_counts": {
        "Player": 2,
        "杜拉夫": 4
    },
    "dialogues": [
        {
            "id": "615370701",
            "speaker": "Player",
            "text": "你喝了很多酒…"
        },
        {
            "id": "615370702",
            "speaker": "杜拉夫",
            "text": "痛快地狩猎之后，当然要痛快地饮酒！"
        },
        {
            "id": "615370703",
            "speaker": "杜拉夫",
            "text": "况且，我的女儿迪奥娜，可是蒙德数一数二的调酒师呐…"
        },
        {
            "id": "615370704",
            "speaker": "杜拉夫",
            "text": "那小家伙，明明还整天叫唤着讨厌酒，讨厌酒的，哈哈哈…"
        },
        {
            "id": "615370801",
            "speaker": "Player",
            "text": "会休猎到什么时候？"
        },
        {
            "id": "615370802",
            "speaker": "杜拉夫",
            "text": "当然是到下一次狩猎开始的时候啊，这不是明摆着的事情吗？"
        }
    ]
}