    "speaker_counts": {
        "Player": 2,
        "派蒙": 2,
        "海迪夫": 6
    },
    "dialogues": [
        {
            "id": "710411401",
            "speaker": "海迪夫",
            "text": "#你好，{NICKNAME}！在这里遇见你真高兴。",
            "choices": [
                {
                    "id": "710411402",
                    "text": "你在这里做什么？",
                    "response": [
                        {
                            "id": "710411403",
                            "speaker": "海迪夫",
                            "text": "实地考察，记录与研究古代生物，以及它们的孑遗。嗯…还有就是，观察地质层的异变情况。"
                        },
                        {
                            "id": "710411404",
                            "speaker": "派蒙",
                            "text": "你不亲自下去考察吗？"
                        },
                        {
                            "id": "710411405",
                            "speaker": "海迪夫",
                            "text": "我不亲自下去考察吗？当然不。"
                        },
                        {
                            "id": "710411406",
                            "speaker": "海迪夫",
                            "text": "你看，这支勘探队是我花钱组建的。我花钱，你们办事；我完成研究，你们有摩拉拿；我开心，你们开心。"
                        },
                        {
                            "id": "710411407",
                            "speaker": "海迪夫",
                            "text": "道理就是这样。"
                        },
                        {
                            "id": "710411408",
                            "speaker": "派蒙",
                            "text": "呜哇…这个家伙，怎么这么招人讨厌！"
                        }
                    ]
                },
                {
                    "id": "710411409",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "710411410",
                            "speaker": "海迪夫",
                            "text": "别让我耽搁了你的时间。"
                        }
                    ]
                }
            ]
        }
    ]
}