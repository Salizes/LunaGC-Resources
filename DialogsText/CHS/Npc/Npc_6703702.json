    "dialogues": [
        {
            "id": "670370201",
            "speaker": "Player",
            "text": "你是裁缝吗？"
        },
        {
            "id": "670370202",
            "speaker": "阿锦",
            "text": "给那些宝藏猎人们缝缝补补，讨个生计而已。"
        },
        {
            "id": "670370203",
            "speaker": "阿锦",
            "text": "他们干的活儿动作大，衣服也坏得快，不过付钱也大方。靠着这个，日子倒也过得去。"
        }
    ]
}