    "speaker_counts": {
        "Player": 4,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699001301",
            "speaker": "Player",
            "text": "关于迪卢克与凯亚…"
        },
        {
            "id": "699001302",
            "speaker": "派蒙",
            "text": "奇怪…"
        },
        {
            "id": "699001303",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "699001304",
            "speaker": "派蒙",
            "text": "为什么迪卢克和凯亚明明是很相似的两个人，关系却不太好呢？"
        },
        {
            "id": "699001305",
            "speaker": "Player",
            "text": "他们哪里相似了？"
        },
        {
            "id": "699001306",
            "speaker": "派蒙",
            "text": "凯亚像是那种…会光明正大地耍阴招的人。"
        },
        {
            "id": "699001307",
            "speaker": "派蒙",
            "text": "迪卢克像是那种…在暗地里做光明正大的事的人。"
        },
        {
            "id": "699001308",
            "speaker": "派蒙",
            "text": "是不是很相似？"
        },
        {
            "id": "699001309",
            "speaker": "Player",
            "text": "我还是不知道相似在哪里。"
        }
    ]
}