{
    "talkId": "6909302",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "闲云": 11
    },
    "dialogues": [
        {
            "id": "690930201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690930202",
            "speaker": "闲云",
            "text": "嗯，这里仙力充盈，视野开阔，不错不错。"
        },
        {
            "id": "690930203",
            "speaker": "闲云",
            "text": "说来，这外景之能，并非常人所能掌握。你是从何处得到这个法宝？"
        },
        {
            "id": "690930204",
            "speaker": "Player",
            "text": "这是萍姥姥所赠。"
        },
        {
            "id": "690930205",
            "speaker": "闲云",
            "text": "噢，原来如此。"
        },
        {
            "id": "690930206",
            "speaker": "闲云",
            "text": "歌尘以前就喜爱游山玩水，又常感叹四时风景皆不相同，一段时间不见，这山水便已变了模样…"
        },
        {
            "id": "690930207",
            "speaker": "闲云",
            "text": "想来她也是运用外景之能，将自己喜欢的景象放入小小的茶壶之中…"
        },
        {
            "id": "690930208",
            "speaker": "闲云",
            "text": "想不到，经你布置，这壶中倒是增加了不少生活气息，成了一个适合起居的好地方。"
        },
        {
            "id": "690930209",
            "speaker": "闲云",
            "text": "下回本仙不想出门觅食的时候，索性跑来你这里蹭饭吧。",
            "choices": [
                {
                    "id": "690930210",
                    "text": "自然欢迎。",
                    "response": [
                        {
                            "id": "690930211",
                            "speaker": "闲云",
                            "text": "哦？你倒是很爽快嘛。"
                        },
                        {
                            "id": "690930212",
                            "speaker": "闲云",
                            "text": "那就一言为定。本仙开始期待你会做出怎样的菜肴了。"
                        }
                    ]
                },
                {
                    "id": "690930213",
                    "text": "我不一定想下厨…",
                    "response": [
                        {
                            "id": "690930214",
                            "speaker": "闲云",
                            "text": "既然是本仙不请自来，做饭的事情就交给本仙…新改进的烹饪神机吧。"
                        },
                        {
                            "id": "690930215",
                            "speaker": "闲云",
                            "text": "至于要吃什么菜，你就尽管发挥想象力吧。本仙为你实现。"
                        }
                    ]
                }
            ]
        }
    ]
}