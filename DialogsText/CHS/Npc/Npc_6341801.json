{
    "talkId": "6341801",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "塔伊西娅": 4,
        "普列特涅夫": 3
    },
    "dialogues": [
        {
            "id": "634180101",
            "speaker": "塔伊西娅",
            "text": "很久之前…我还参加过这里的晚宴，那天，甚至亲眼见到了白沙皇陛下…"
        },
        {
            "id": "634180102",
            "speaker": "普列特涅夫",
            "text": "天哪，塔伊西娅，看看这里的装饰…"
        },
        {
            "id": "634180103",
            "speaker": "塔伊西娅",
            "text": "唉…普列特涅夫…"
        },
        {
            "id": "634180104",
            "speaker": "普列特涅夫",
            "text": "我感觉那边的烛台年纪比我都大…天哪…"
        },
        {
            "id": "634180105",
            "speaker": "塔伊西娅",
            "text": "好了好了，别说了，至少别说得那么大声…不然我只能装作不认识你了！"
        },
        {
            "id": "634180106",
            "speaker": "普列特涅夫",
            "text": "怎么了？"
        },
        {
            "id": "634180107",
            "speaker": "塔伊西娅",
            "text": "我嫌丢人…"
        }
    ]
}