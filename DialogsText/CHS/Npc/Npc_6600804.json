    "speaker_counts": {
        "Player": 1,
        "爱雅": 4
    },
    "dialogues": [
        {
            "id": "660080401",
            "speaker": "Player",
            "text": "厉害，有什么诀窍吗？"
        },
        {
            "id": "660080402",
            "speaker": "爱雅",
            "text": "有啊，靠天分。"
        },
        {
            "id": "660080403",
            "speaker": "爱雅",
            "text": "就像有的人哪怕去一个全新的地方也不会迷路一样，我对颜色也有着这样的天赋。"
        },
        {
            "id": "660080404",
            "speaker": "爱雅",
            "text": "在我眼里没有难看的颜色，只有难看的搭配。就算是烂水果一样的颜料，也有着能大放异彩的地方。"
        },
        {
            "id": "660080405",
            "speaker": "爱雅",
            "text": "说起来，你眼睛的颜色就很不错…等会儿我要配下试试看。"
        }
    ]
}