{
    "talkId": "7167004",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "方谨": 12
    },
    "dialogues": [
        {
            "id": "716700401",
            "speaker": "方谨",
            "text": "#{NICKNAME}，你来了！"
        },
        {
            "id": "716700402",
            "speaker": "方谨",
            "text": "目前战况稳定，地脉紊乱点并不活跃，我部正持续清剿外逃的魔物。",
            "choices": [
                {
                    "id": "716700403",
                    "text": "关于地脉紊乱点…",
                    "response": [
                        {
                            "id": "716700404",
                            "speaker": "方谨",
                            "text": "如您所见，相比最初的形态，地脉紊乱点发生了相当程度的变化。为此，我们加强了侦察，部署了更多预备队…"
                        },
                        {
                            "id": "716700405",
                            "speaker": "方谨",
                            "text": "好在，根据斥候部队的综合情报分析，短时间内，威胁依然可控。"
                        },
                        {
                            "id": "716700406",
                            "speaker": "方谨",
                            "text": "即便在它最为活跃的阶段，我们也能稳住防线。"
                        },
                        {
                            "id": "716700407",
                            "speaker": "方谨",
                            "text": "当然，相信您也能不断削弱它的势头，压制它的进一步异变。"
                        }
                    ]
                },
                {
                    "id": "716700408",
                    "text": "关于驻军的情况…",
                    "response": [
                        {
                            "id": "716700409",
                            "speaker": "方谨",
                            "text": "请放心，目前将士们精力充沛，配发了近乎全新的武备，部队韧性极佳，还能以最高战备长期驻守。"
                        },
                        {
                            "id": "716700410",
                            "speaker": "方谨",
                            "text": "经开阳星大人精确调遣，每过半个月，一线作战的将士们都会进行轮换，以防部队劳损过度。"
                        },
                        {
                            "id": "716700411",
                            "speaker": "方谨",
                            "text": "眼下，局面已趋于稳定，轮换部队已由七成老兵与三成新兵组成。"
                        },
                        {
                            "id": "716700412",
                            "speaker": "方谨",
                            "text": "如此一来，既能稳定地应对敌情，又能将险境化为我用，为将士们提供充分的实战训练。"
                        },
                        {
                            "id": "716700413",
                            "speaker": "方谨",
                            "text": "当然，无论人员如何调动，我和我的几位得力部下都会在此常驻，一直配合你，请放心。"
                        }
                    ]
                },
                {
                    "id": "716700414",
                    "text": "辛苦了。",
                    "response": [
                        {
                            "id": "716700415",
                            "speaker": "方谨",
                            "text": "职责所在，理当全力以赴！"
                        }
                    ]
                }
            ]
        }
    ]
}