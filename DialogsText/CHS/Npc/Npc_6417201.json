{
    "talkId": "6417201",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "库塔": 6,
        "萨尔姆": 8
    },
    "dialogues": [
        {
            "id": "641720101",
            "speaker": "萨尔姆",
            "text": "唉，还是再试一次吧…库塔，听我说，坐！"
        },
        {
            "id": "641720102",
            "speaker": "库塔",
            "text": "（坐好。）"
        },
        {
            "id": "641720103",
            "speaker": "萨尔姆",
            "text": "还记得驮兽是什么吗？圆圆的、大大的、胖胖的。"
        },
        {
            "id": "641720104",
            "speaker": "库塔",
            "text": "汪！"
        },
        {
            "id": "641720105",
            "speaker": "萨尔姆",
            "text": "还记得家里一共有多少只驮兽吗？"
        },
        {
            "id": "641720106",
            "speaker": "库塔",
            "text": "汪，汪，汪，汪，汪…汪？"
        },
        {
            "id": "641720107",
            "speaker": "萨尔姆",
            "text": "又错啦！不是跟你讲过，上个月那几只新出生的小驮兽，也要一起算进去吗？"
        },
        {
            "id": "641720108",
            "speaker": "库塔",
            "text": "（摇尾巴。）"
        },
        {
            "id": "641720109",
            "speaker": "萨尔姆",
            "text": "冲我摇尾巴也没用！答错了就没有零食吃。"
        },
        {
            "id": "641720110",
            "speaker": "库塔",
            "text": "呜…"
        },
        {
            "id": "641720111",
            "speaker": "萨尔姆",
            "text": "…算了算了，至少比上次有进步，还是给你一点吧。"
        },
        {
            "id": "641720112",
            "speaker": "萨尔姆",
            "text": "有时还挺羡慕你的，每天围着驮兽转圈圈就能吃饱肚皮，日子真好过啊…"
        },
        {
            "id": "641720113",
            "speaker": "萨尔姆",
            "text": "不像我，每天辛辛苦苦养驮兽，结果卖出去赚的钱还不够跑丢的那些赔进去的呢。"
        },
        {
            "id": "641720114",
            "speaker": "库塔",
            "text": "？"
        }
    ]
}