{
    "talkId": "7104901",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 2,
        "阿旭": 14
    },
    "dialogues": [
        {
            "id": "710490101",
            "speaker": "阿旭",
            "text": "啊，是少爷的朋友。您好！"
        },
        {
            "id": "710490102",
            "speaker": "阿旭",
            "text": "实在是不好意思，但我有一事相求，不知您是否方便相助？",
            "choices": [
                {
                    "id": "710490103",
                    "text": "既然都是熟人，请你直说吧。",
                    "response": [
                        {
                            "id": "710490105",
                            "speaker": "阿旭",
                            "text": "是这样的，我有一位朋友名叫沐宁，此前经常照顾我们飞云商会的生意。"
                        },
                        {
                            "id": "710490106",
                            "speaker": "阿旭",
                            "text": "只是最近他在岩上茶室欠了点小钱，只好找我们少爷借钱救急…"
                        },
                        {
                            "id": "710490107",
                            "speaker": "阿旭",
                            "text": "结果呢，少爷二话不说就把钱借出去了，连利息也不要！唉，这豪爽的脾气呀…可别太用在生意上…"
                        },
                        {
                            "id": "710490108",
                            "speaker": "派蒙",
                            "text": "行侠仗义嘛，这不是好事吗？"
                        },
                        {
                            "id": "710490109",
                            "speaker": "阿旭",
                            "text": "事倒是好事，不过您看…行秋少爷外出行侠了，我这边忙于家务又脱不开身。这用钱之事，大家都能信得过的就只有您了。"
                        },
                        {
                            "id": "710490110",
                            "speaker": "阿旭",
                            "text": "他就在层岩巨渊当班，吃住都在那边，你不会认错人的。",
                            "choices": [
                                {
                                    "id": "710490111",
                                    "text": "还有人会住在层岩巨渊那种地方吗？",
                                    "response": [
                                        {
                                            "id": "710490112",
                                            "speaker": "阿旭",
                                            "text": "哈哈，瞧您这是哪里的话，什么叫「那种地方」呀。沐宁是总务司派驻层岩巨渊的专员，当然要在那里常驻啦！"
                                        },
                                        {
                                            "id": "710490113",
                                            "speaker": "阿旭",
                                            "text": "虽说那里以前是矿区，食物、饮水和生活物资需要专门从璃月运过去配发给大家…"
                                        },
                                        {
                                            "id": "710490114",
                                            "speaker": "阿旭",
                                            "text": "吃吃喝喝，东玩西逛是别指望了，生活可能会艰苦无聊一点…但不管怎么说，在那边工作的补偿待遇还是非常优厚的。"
                                        },
                                        {
                                            "id": "710490116",
                                            "speaker": "阿旭",
                                            "text": "嗯…您毕竟是璃月的大英雄。先不说七八分啊，哪怕就三分，走到哪人家不都得看着您的面子？"
                                        },
                                        {
                                            "id": "710490117",
                                            "speaker": "阿旭",
                                            "text": "我相信您一定能把这个忙给帮了。再说万一您被拦在了层岩巨渊门口，那也没关系，我们回来再从长计议就好。",
                                            "choices": [
                                                {
                                                    "id": "710490118",
                                                    "text": "看在行秋的面子上，我会帮忙的。",
                                                    "response": [
                                                        {
                                                            "id": "710490119",
                                                            "speaker": "阿旭",
                                                            "text": "那就多谢您了！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "710490120",
                                                    "text": "你就不怕我半路私吞这些摩拉吗？",
                                                    "response": [
                                                        {
                                                            "id": "710490121",
                                                            "speaker": "派蒙",
                                                            "text": "喂！你怎么说出来了呀！"
                                                        },
                                                        {
                                                            "id": "710490122",
                                                            "speaker": "阿旭",
                                                            "text": "哈哈哈哈哈！请不要开这种玩笑，我相信您一定会帮这个忙的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "710490115",
                                    "text": "可层岩巨渊不是已经关闭了吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "710490104",
                    "text": "什么事情需要帮忙？"
                }
            ]
        }
    ]
}