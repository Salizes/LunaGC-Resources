    "dialogues": [
        {
            "id": "640140201",
            "speaker": "Player",
            "text": "你叫维齐尔？"
        },
        {
            "id": "640140202",
            "speaker": "尼扎姆",
            "text": "不，我叫尼扎姆。维齐尔并不是我的名字，而是职务，负责代表教令院管理大巴扎和宝商街附近的各项行政事宜。"
        },
        {
            "id": "640140203",
            "speaker": "尼扎姆",
            "text": "…至少官方的说法是这样的。"
        },
        {
            "id": "640140204",
            "speaker": "尼扎姆",
            "text": "实际上呢，遇到的都是些鸡毛蒜皮的琐事，教令官们不愿意处理的麻烦也经常转交给我…"
        },
        {
            "id": "640140205",
            "speaker": "尼扎姆",
            "text": "说什么快要选出新一任大掌书了，比较繁忙，其实都是借口…"
        }
    ]
}