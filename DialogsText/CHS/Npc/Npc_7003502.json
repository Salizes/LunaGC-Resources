    "dialogues": [
        {
            "id": "700350201",
            "speaker": "派蒙",
            "text": "呜哇——从望舒客栈往外看去，璃月真的好美哦！"
        },
        {
            "id": "700350202",
            "speaker": "派蒙",
            "text": "如果能每天待在这里，就算是再难过的心情也能平复下来吧？"
        },
        {
            "id": "700350203",
            "speaker": "派蒙",
            "text": "#{NICKNAME}，在这里弹琴试试吧。"
        },
        {
            "id": "700350204",
            "speaker": "派蒙",
            "text": "也许会有万叶说的那种跟人合奏的奇妙感觉呢！"
        }
    ]
}