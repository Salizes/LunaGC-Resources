{
    "talkId": "6203402",
    "total_dialogue_lines": 5,
    "speaker_counts": {
        "老高": 5
    },
    "dialogues": [
        {
            "id": "620340201",
            "speaker": "老高",
            "text": "怎么买多了还贵了？"
        },
        {
            "id": "620340202",
            "speaker": "老高",
            "text": "我的鱼，我乐意！"
        },
        {
            "id": "620340203",
            "speaker": "老高",
            "text": "你看看这鱼多新鲜，买一条你小赚，买两条我小亏，买三条我都亏本了！多买多赚你懂吗！"
        },
        {
            "id": "620340204",
            "speaker": "老高",
            "text": "而且我的鱼卖一条少一条，越少越贵不是很正常，没听说过那什么…「稀缺性」吗，你居然还嫌弃价格？"
        },
        {
            "id": "620340205",
            "speaker": "老高",
            "text": "对你这种人，我就只有四个字——爱买不买！"
        }
    ]
}