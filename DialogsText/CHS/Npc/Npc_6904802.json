{
    "talkId": "6904802",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "烟绯": 8
    },
    "dialogues": [
        {
            "id": "690480201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690480202",
            "speaker": "烟绯",
            "text": "习惯习惯。好得很。"
        },
        {
            "id": "690480203",
            "speaker": "烟绯",
            "text": "你是不是忘了，我对这种「外景」之能早有耳闻。",
            "choices": [
                {
                    "id": "690480204",
                    "text": "那烟绯也能创造一个自己的家园吗。",
                    "response": [
                        {
                            "id": "690480205",
                            "speaker": "烟绯",
                            "text": "这个…稍微有一点…"
                        },
                        {
                            "id": "690480206",
                            "speaker": "烟绯",
                            "text": "不属于我的强项！"
                        },
                        {
                            "id": "690480207",
                            "speaker": "烟绯",
                            "text": "而且我已经住在这里了，就不需要考虑多余的了。"
                        },
                        {
                            "id": "690480211",
                            "speaker": "烟绯",
                            "text": "与其操心我，还不如多操心操心你自己哦。"
                        }
                    ]
                },
                {
                    "id": "690480208",
                    "text": "那烟绯大仙有什么指教吗？",
                    "response": [
                        {
                            "id": "690480209",
                            "speaker": "烟绯",
                            "text": "嗯，嗯。依我之见，应该开辟专门的几间屋子用于存放法典。"
                        },
                        {
                            "id": "690480210",
                            "speaker": "烟绯",
                            "text": "不过你的家，「规则」是应该由你来定的。"
                        }
                    ]
                }
            ]
        }
    ]
}