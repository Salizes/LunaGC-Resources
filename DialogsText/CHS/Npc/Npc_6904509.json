{
    "talkId": "6904509",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "罗莎莉亚": 9
    },
    "dialogues": [
        {
            "id": "690450901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690450202",
            "speaker": "罗莎莉亚",
            "text": "没什么习惯不习惯的，我对自己的住所没什么所谓。"
        },
        {
            "id": "690450203",
            "speaker": "罗莎莉亚",
            "text": "不过在这里比教会自在多了…"
        },
        {
            "id": "690450204",
            "speaker": "罗莎莉亚",
            "text": "至少不会有人以晨祷的名义，打扰我早上补觉。",
            "choices": [
                {
                    "id": "690450205",
                    "text": "还是睡得很晚吗？",
                    "response": [
                        {
                            "id": "690450206",
                            "speaker": "罗莎莉亚",
                            "text": "多谢关心。呵呵，无非是有点小事要处理而已。"
                        },
                        {
                            "id": "690450207",
                            "speaker": "罗莎莉亚",
                            "text": "我早就习惯这种作息了，想改也麻烦。"
                        },
                        {
                            "id": "690450211",
                            "speaker": "罗莎莉亚",
                            "text": "说不定，我比想象中更适应这里啊…"
                        },
                        {
                            "id": "690450212",
                            "speaker": "罗莎莉亚",
                            "text": "嘁，产生依赖可不好。"
                        }
                    ]
                },
                {
                    "id": "690450208",
                    "text": "辛苦了。",
                    "response": [
                        {
                            "id": "690450209",
                            "speaker": "罗莎莉亚",
                            "text": "…这种话，跟我还真不配。"
                        },
                        {
                            "id": "690450210",
                            "speaker": "罗莎莉亚",
                            "text": "算了算了，我知道你是好意。我心领了。"
                        }
                    ]
                }
            ]
        }
    ]
}