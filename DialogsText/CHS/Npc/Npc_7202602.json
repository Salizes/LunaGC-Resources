    "dialogues": [
        {
            "id": "720260201",
            "speaker": "Player",
            "text": "关于你自己…"
        },
        {
            "id": "720260202",
            "speaker": "江舟",
            "text": "我是海灯节的策划人之一，隶属「海灯节筹备办」。"
        },
        {
            "id": "720260203",
            "speaker": "江舟",
            "text": "一年的准备就为了这一刻的开花结果，这么一想，眼泪都差点激动地流出来了呢。"
        },
        {
            "id": "720260204",
            "speaker": "江舟",
            "text": "千万要顺利呀，海灯节！"
        }
    ]
}