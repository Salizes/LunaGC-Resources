{
    "talkId": "4008135",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 1,
        "留言板": 25
    },
    "dialogues": [
        {
            "id": "400813501",
            "speaker": "留言板",
            "text": "「『月莲杯驯兽师大赛』的预赛结果已揭晓，三十二位出色的选手脱颖而出，即将为大家带来一场竞技的视觉盛宴…」",
            "choices": [
                {
                    "id": "400813502",
                    "text": "快速浏览「大赛规则」…",
                    "response": [
                        {
                            "id": "400813503",
                            "speaker": "留言板",
                            "text": "「赛事奖励·八强级：总量可观的摩拉、首届『月莲杯』大赛限定荣誉称号，以及保留王牌蕈兽的资格…」"
                        },
                        {
                            "id": "400813504",
                            "speaker": "留言板",
                            "text": "……"
                        },
                        {
                            "id": "400813505",
                            "speaker": "留言板",
                            "text": "「蕈兽活动规范·第三条：经过『意智宝珠』控制，并登记在册的蕈兽，可以在赛场周围活动，但请驯兽师们注意行动的边界。」"
                        },
                        {
                            "id": "400813506",
                            "speaker": "留言板",
                            "text": "「可活动的区域仅限于赛场周围、奥摩斯港的主要道路，切勿将蕈兽带入以下公共场所：维卡拉商栈、所有商店、餐馆。」"
                        },
                        {
                            "id": "400813507",
                            "speaker": "留言板",
                            "text": "「目前，本赛事尚未被所有民众接受，若是蕈兽突然出现在不知情的民众面前，可能引起恐慌和混乱，建议大家谨慎行事。」"
                        },
                        {
                            "id": "400813508",
                            "speaker": "留言板",
                            "text": "「『三十人团』将监督参赛选手，一旦违规，将取消选手的参赛资格，情节严重者，可能会被追究责任，受到教令院的惩罚」"
                        },
                        {
                            "id": "400813509",
                            "speaker": "留言板",
                            "text": "……"
                        },
                        {
                            "id": "400813510",
                            "speaker": "派蒙",
                            "text": "好像没有什么看漏的、不明白的规则呢。"
                        }
                    ]
                },
                {
                    "id": "400813511",
                    "text": "「最受『支持』的留言」",
                    "response": [
                        {
                            "id": "400813512",
                            "speaker": "留言板",
                            "text": "「浮游蕈兽最可爱！不论水、风、草元素！」"
                        },
                        {
                            "id": "400813513",
                            "speaker": "留言板",
                            "text": "「脑袋大大的，身子软软的，动起来慢慢悠悠的，一抖一抖的。」"
                        },
                        {
                            "id": "400813514",
                            "speaker": "留言板",
                            "text": "「我们一起成立浮游蕈兽保护协会吧！」"
                        },
                        {
                            "id": "400813515",
                            "speaker": "留言板",
                            "text": "（下面似乎还有针对这条留言的回应…）"
                        },
                        {
                            "id": "400813516",
                            "speaker": "留言板",
                            "text": "「工作人员提醒您：竞赛蕈兽很特殊，野生蕈兽太危险！」"
                        },
                        {
                            "id": "400813517",
                            "speaker": "留言板",
                            "text": "「理智观赏比赛，切勿主动模仿！」"
                        },
                        {
                            "id": "400813518",
                            "speaker": "留言板",
                            "text": "「若被魔物伤，家人泪汪汪！」"
                        }
                    ]
                },
                {
                    "id": "400813519",
                    "text": "「最被『反对』的留言」",
                    "response": [
                        {
                            "id": "400813520",
                            "speaker": "留言板",
                            "text": "「建议赛方加入一些平衡机制，让比赛的竞技性更强。」"
                        },
                        {
                            "id": "400813521",
                            "speaker": "留言板",
                            "text": "「比如规定每种蕈兽出战所需的点数，越能打的蕈兽，点数就越高，然后限制队伍的总点数。」"
                        },
                        {
                            "id": "400813522",
                            "speaker": "留言板",
                            "text": "「如此一来，就更加考验选手们的组队策略了，比赛的竞技性也能得到充分的保障。」"
                        },
                        {
                            "id": "400813523",
                            "speaker": "留言板",
                            "text": "（下面似乎还有针对这条留言的回应…）"
                        },
                        {
                            "id": "400813524",
                            "speaker": "留言板",
                            "text": "笨蛋！比赛搞得太复杂的话，肯定更难看懂，观众也会很累的！"
                        },
                        {
                            "id": "400813525",
                            "speaker": "留言板",
                            "text": "大家来看比赛都是图一乐，谁想边看比赛边跟着计算点数，思考策略啊！"
                        },
                        {
                            "id": "400813526",
                            "speaker": "留言板",
                            "text": "而且，很强的蕈兽，招式也很好看，如果限制它们出场，比赛没准就更无趣了！"
                        }
                    ]
                },
                {
                    "id": "400813527",
                    "text": "「公认『有趣』的留言」",
                    "response": [
                        {
                            "id": "400813528",
                            "speaker": "留言板",
                            "text": "「预赛已经结束了，什么时候才发售比赛过程的『映影』呢？」"
                        },
                        {
                            "id": "400813529",
                            "speaker": "留言板",
                            "text": "「光看赛程表就忍不住了，太多选手取了威风的代号，听起来就很强，一般观众根本看不过来，所以需要『映影』！」"
                        },
                        {
                            "id": "400813530",
                            "speaker": "留言板",
                            "text": "「就算卖得很贵也没关系，毕竟这种比赛实在新奇，可以反复观看！」"
                        }
                    ]
                },
                {
                    "id": "400813531",
                    "text": "离去。"
                }
            ]
        }
    ]
}