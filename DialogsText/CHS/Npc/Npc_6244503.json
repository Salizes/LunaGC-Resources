    "dialogues": [
        {
            "id": "624450301",
            "speaker": "Player",
            "text": "你在做什么？"
        },
        {
            "id": "624450302",
            "speaker": "骆丰",
            "text": "那当然是拓展人脉了！"
        },
        {
            "id": "624450303",
            "speaker": "骆丰",
            "text": "很多人都没意识到，其实这「珠钿舫」最有价值的是船上的客人啊！"
        },
        {
            "id": "624450304",
            "speaker": "骆丰",
            "text": "能到这里的，哪个不是达官显贵？倘若能结交到一两位大人物，那才是真的不虚此行…"
        },
        {
            "id": "624450305",
            "speaker": "骆丰",
            "text": "嘿嘿，不多聊了，我得抓紧时间多认识些人，争取混个脸熟。"
        }
    ]
}