{
    "talkId": "6713301",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "爱诺": 4,
        "阿莎莎·郎勃罗": 4
    },
    "dialogues": [
        {
            "id": "671330101",
            "speaker": "爱诺",
            "text": "阿莎莎，最近你总能从垃圾堆里挑出有用的宝贝，是不是变聪明了？"
        },
        {
            "id": "671330102",
            "speaker": "阿莎莎·郎勃罗",
            "text": "哼，我比你聪明一万倍。"
        },
        {
            "id": "671330103",
            "speaker": "爱诺",
            "text": "哎呀，比聪明更膨胀的原来是嚣张。再这样我就要把你的花花摘掉，它开始让你认不清自己啦。"
        },
        {
            "id": "671330104",
            "speaker": "阿莎莎·郎勃罗",
            "text": "不许摘！那不是花花。"
        },
        {
            "id": "671330105",
            "speaker": "爱诺",
            "text": "明明就是我上次给你戴的花花。"
        },
        {
            "id": "671330106",
            "speaker": "阿莎莎·郎勃罗",
            "text": "总之不许摘！"
        },
        {
            "id": "671330107",
            "speaker": "爱诺",
            "text": "为什么？"
        },
        {
            "id": "671330108",
            "speaker": "阿莎莎·郎勃罗",
            "text": "因为那是我的聪明草。"
        }
    ]
}