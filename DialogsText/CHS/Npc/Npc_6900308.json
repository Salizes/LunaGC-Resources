{
    "talkId": "6900308",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "琴": 12
    },
    "dialogues": [
        {
            "id": "690030801",
            "speaker": "琴",
            "text": "好的，非常愿意奉陪。"
        },
        {
            "id": "690030802",
            "speaker": "琴",
            "text": "想聊怎样的话题呢？",
            "choices": [
                {
                    "id": "690030803",
                    "text": "只要不是工作，都可以。",
                    "response": [
                        {
                            "id": "690030804",
                            "speaker": "琴",
                            "text": "抱歉…一定是我平时总是说着工作的事情，才会让你有这样的困扰。"
                        },
                        {
                            "id": "690030805",
                            "speaker": "琴",
                            "text": "我会好好反思自己。"
                        },
                        {
                            "id": "690030806",
                            "speaker": "Player",
                            "text": "琴又认真起来啦…"
                        },
                        {
                            "id": "690030807",
                            "speaker": "琴",
                            "text": "抱歉，我…"
                        },
                        {
                            "id": "690030808",
                            "speaker": "琴",
                            "text": "我明白了，你的意思是我们应该更轻松一点地相处。"
                        },
                        {
                            "id": "690030816",
                            "speaker": "琴",
                            "text": "嗯…我…"
                        },
                        {
                            "id": "690030817",
                            "speaker": "琴",
                            "text": "我会努力的…"
                        }
                    ]
                },
                {
                    "id": "690030809",
                    "text": "听说琴唱歌很好听？",
                    "response": [
                        {
                            "id": "690030810",
                            "speaker": "琴",
                            "text": "只是能简单的唱几句而已。"
                        },
                        {
                            "id": "690030811",
                            "speaker": "琴",
                            "text": "并…并不是什么值得夸耀的事情。"
                        },
                        {
                            "id": "690030812",
                            "speaker": "Player",
                            "text": "想听琴唱歌。"
                        },
                        {
                            "id": "690030813",
                            "speaker": "琴",
                            "text": "欸…可是我现在一点准备都没有。"
                        },
                        {
                            "id": "690030814",
                            "speaker": "琴",
                            "text": "至少也要等我练习过后才行。"
                        }
                    ]
                },
                {
                    "id": "690030815",
                    "text": "嗯，说好了。"
                }
            ]
        }
    ]
}