{
    "talkId": "4008132",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 6,
        "风速枣椰": 9
    },
    "dialogues": [
        {
            "id": "400813201",
            "speaker": "风速枣椰",
            "text": "怎么回事，到底怎么回事！凭什么一下子就把我的所有蕈兽都打败了！这下我要怎么和小弟们交差啊…",
            "choices": [
                {
                    "id": "400813202",
                    "text": "你还好吗？",
                    "response": [
                        {
                            "id": "400813203",
                            "speaker": "风速枣椰",
                            "text": "啊？你们两个来干什么？想要嘲笑我吗！"
                        },
                        {
                            "id": "400813204",
                            "speaker": "风速枣椰",
                            "text": "不要太得意了！等到下次比赛，我还会赢回来的！"
                        },
                        {
                            "id": "400813205",
                            "speaker": "派蒙",
                            "text": "咦？还有下次比赛吗？预赛不是只有一次机会吗？",
                            "choices": [
                                {
                                    "id": "400813206",
                                    "text": "也许她想说下一届比赛。",
                                    "response": [
                                        {
                                            "id": "400813208",
                                            "speaker": "派蒙",
                                            "text": "嗯，这也是好事，不要因为一次失败太受挫折！"
                                        },
                                        {
                                            "id": "400813209",
                                            "speaker": "派蒙",
                                            "text": "总之，枣椰怪怪人，下次较量的时候，希望你变得更强！"
                                        },
                                        {
                                            "id": "400813210",
                                            "speaker": "风速枣椰",
                                            "text": "那还用说吗！到时候就是我来安慰你们了！"
                                        },
                                        {
                                            "id": "400813211",
                                            "speaker": "风速枣椰",
                                            "text": "如果你们的态度不错，我也可以考虑给你们几颗秘制枣椰蜜糖安慰一下你们哦。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400813207",
                                    "text": "她还抱有很强的斗志。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400813212",
                    "text": "哈哈，是我们赢啦！",
                    "response": [
                        {
                            "id": "400813213",
                            "speaker": "派蒙",
                            "text": "对哦，是我们「黄金流星」和「白银伴星」赢啦！"
                        },
                        {
                            "id": "400813214",
                            "speaker": "风速枣椰",
                            "text": "呃…蕈兽们的招式能够互相反应，我只不过是没有考虑到这一点。"
                        },
                        {
                            "id": "400813215",
                            "speaker": "风速枣椰",
                            "text": "贸然冲上去的确有危险，以后我会注意的！"
                        },
                        {
                            "id": "400813216",
                            "speaker": "风速枣椰",
                            "text": "不管怎么样，我还会和伙伴们调整策略的，下次绝不输给你们！"
                        },
                        {
                            "id": "400813217",
                            "speaker": "派蒙",
                            "text": "咦，这话说得好像之后还会再见面一样…"
                        },
                        {
                            "id": "400813218",
                            "speaker": "Player",
                            "text": "比赛也不会只办一届吧。"
                        },
                        {
                            "id": "400813219",
                            "speaker": "派蒙",
                            "text": "确实呢，希望下一届比赛，她还这么有热情吧！"
                        }
                    ]
                },
                {
                    "id": "400813220",
                    "text": "别太沮丧了…",
                    "response": [
                        {
                            "id": "400813221",
                            "speaker": "风速枣椰",
                            "text": "我！我才不沮丧！走着瞧吧，我还会赢回来的！"
                        }
                    ]
                }
            ]
        }
    ]
}