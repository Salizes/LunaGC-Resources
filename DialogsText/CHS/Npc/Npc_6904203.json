{
    "talkId": "6904203",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "刻晴": 15
    },
    "dialogues": [
        {
            "id": "690420301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690420302",
            "speaker": "刻晴",
            "text": "嗯，我没问题。"
        },
        {
            "id": "690420303",
            "speaker": "刻晴",
            "text": "不过有言在先，大多数人认为和我聊天的体验并不好。"
        },
        {
            "id": "690420304",
            "speaker": "Player",
            "text": "欸，比如呢？"
        },
        {
            "id": "690420305",
            "speaker": "刻晴",
            "text": "比如之前有同事问我：「刻晴小姐有什么需要我帮忙的吗？」"
        },
        {
            "id": "690420306",
            "speaker": "刻晴",
            "text": "我说：「先把你自己的工作效率提上去吧。」"
        },
        {
            "id": "690420307",
            "speaker": "刻晴",
            "text": "后来，就再也没来找过我了。"
        },
        {
            "id": "690420308",
            "speaker": "刻晴",
            "text": "还有人问我：「知不知道凝光小姐喜欢怎样的礼物？」"
        },
        {
            "id": "690420309",
            "speaker": "刻晴",
            "text": "我说：「放弃吧。凝光她根本不会在乎献殷勤的对象。」"
        },
        {
            "id": "690420310",
            "speaker": "刻晴",
            "text": "嗯，所以…你也明白了吧。",
            "choices": [
                {
                    "id": "690420311",
                    "text": "刻晴只是有话直说吧。",
                    "response": [
                        {
                            "id": "690420313",
                            "speaker": "刻晴",
                            "text": "嗯…我觉得没有必要选择所谓委婉或者含蓄的表达。"
                        },
                        {
                            "id": "690420314",
                            "speaker": "刻晴",
                            "text": "不管是粉饰后的事实或是善意的谎言，那都是浪费彼此的时间。",
                            "choices": [
                                {
                                    "id": "690420315",
                                    "text": "不如直接一点。",
                                    "response": [
                                        {
                                            "id": "690420316",
                                            "speaker": "刻晴",
                                            "text": "没错。你果然很了解我。"
                                        },
                                        {
                                            "id": "690420317",
                                            "speaker": "刻晴",
                                            "text": "看来我没有看错，我们还是很聊得来的。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690420318",
                                    "text": "不过这样会降低别人对刻晴的评价吗？",
                                    "response": [
                                        {
                                            "id": "690420319",
                                            "speaker": "刻晴",
                                            "text": "如果是这些人的评价，我不在意。"
                                        },
                                        {
                                            "id": "690420320",
                                            "speaker": "刻晴",
                                            "text": "如果是你的评价…"
                                        },
                                        {
                                            "id": "690420321",
                                            "speaker": "刻晴",
                                            "text": "那…我会考虑一下的。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690420312",
                    "text": "我觉得这也不是坏事。"
                }
            ]
        }
    ]
}