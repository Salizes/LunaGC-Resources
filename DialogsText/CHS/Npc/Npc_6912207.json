{
    "talkId": "6912207",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 8,
        "奈芙尔": 12
    },
    "dialogues": [
        {
            "id": "691220201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691220202",
            "speaker": "奈芙尔",
            "text": "非常优秀的住所，没什么可挑剔的地方。"
        },
        {
            "id": "691220203",
            "speaker": "奈芙尔",
            "text": "要我说的话，甚至有点过于安逸了，太容易滋生偷懒的心思。",
            "choices": [
                {
                    "id": "691220204",
                    "text": "本来就是休息的地方。",
                    "response": [
                        {
                            "id": "691220206",
                            "speaker": "奈芙尔",
                            "text": "你说得也没错。但「偷懒」对我来说，实在是一个过于遥远的词汇。"
                        },
                        {
                            "id": "691220207",
                            "speaker": "奈芙尔",
                            "text": "无论是挪德卡莱还是我那个遥远的老家，都没有让我安生过。"
                        },
                        {
                            "id": "691220208",
                            "speaker": "奈芙尔",
                            "text": "呵呵，瞧你的表情，就差在脸上写着：「这家伙明明都是在让雅珂达去跑腿啊。」",
                            "choices": [
                                {
                                    "id": "691220209",
                                    "text": "欸…欸？",
                                    "response": [
                                        {
                                            "id": "691220211",
                                            "speaker": "奈芙尔",
                                            "text": "骗你的，你刚才的表情最多算是「无理由的傻笑」，看来是想起了高兴的事。怎么？跑委托的时候赚了一大笔？",
                                            "choices": [
                                                {
                                                    "id": "691220212",
                                                    "text": "派蒙答应以后负责做早餐。",
                                                    "response": [
                                                        {
                                                            "id": "691220213",
                                                            "speaker": "奈芙尔",
                                                            "text": "哈哈哈，这样么？那这小家伙可要好好训练了，要是需要做一口专用锅的话，可以去找爱诺问问看。"
                                                        },
                                                        {
                                                            "id": "691220214",
                                                            "speaker": "奈芙尔",
                                                            "text": "看来，你的小旅伴终于要和你分担工作，让你们两个人在奔忙里尽量做到劳逸结合了？"
                                                        },
                                                        {
                                                            "id": "691220217",
                                                            "speaker": "Player",
                                                            "text": "奈芙尔偶尔也放松一点吧。"
                                                        },
                                                        {
                                                            "id": "691220218",
                                                            "speaker": "奈芙尔",
                                                            "text": "我也这么希望。可惜挪德卡莱的诸位，还有我背后那位「大老板」并不希望我停下脚步。"
                                                        },
                                                        {
                                                            "id": "691220219",
                                                            "speaker": "奈芙尔",
                                                            "text": "不过，你还是给我留一间客房吧。说不定哪一天我就能真正开始休息了。"
                                                        },
                                                        {
                                                            "id": "691220220",
                                                            "speaker": "奈芙尔",
                                                            "text": "等到那一天…呵，算了，愿望说出来就不灵了，就说到这里吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691220215",
                                                    "text": "想起这几天不用做委托…",
                                                    "response": [
                                                        {
                                                            "id": "691220216",
                                                            "speaker": "奈芙尔",
                                                            "text": "嗯，这样也不错。劳逸结合，工作的效率才高。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691220210",
                                    "text": "有、有这么明显吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691220205",
                    "text": "就是用来偷懒的。"
                }
            ]
        }
    ]
}