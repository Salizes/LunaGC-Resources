{
    "talkId": "6902008",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "雷泽": 13
    },
    "dialogues": [
        {
            "id": "690200801",
            "speaker": "雷泽",
            "text": "对不起，我不太会，聊天。"
        },
        {
            "id": "690200802",
            "speaker": "雷泽",
            "text": "说话，很难。找到意思，很难。",
            "choices": [
                {
                    "id": "690200803",
                    "text": "没关系，我能理解雷泽的意思。",
                    "response": [
                        {
                            "id": "690200804",
                            "speaker": "雷泽",
                            "text": "嗯…你很强。"
                        },
                        {
                            "id": "690200807",
                            "speaker": "雷泽",
                            "text": "好。我会努力多说话。"
                        },
                        {
                            "id": "690200808",
                            "speaker": "雷泽",
                            "text": "……"
                        },
                        {
                            "id": "690200809",
                            "speaker": "雷泽",
                            "text": "比起地板，喜欢草坪。"
                        },
                        {
                            "id": "690200810",
                            "speaker": "雷泽",
                            "text": "地板，很大，但是很硬。草坪，更大。但是好闻。",
                            "choices": [
                                {
                                    "id": "690200811",
                                    "text": "这里要用「而且」…",
                                    "response": [
                                        {
                                            "id": "690200813",
                                            "speaker": "雷泽",
                                            "text": "嗯！而且好闻…"
                                        },
                                        {
                                            "id": "690200814",
                                            "speaker": "雷泽",
                                            "text": "比起生的肉，喜欢你做的肉。"
                                        },
                                        {
                                            "id": "690200815",
                                            "speaker": "雷泽",
                                            "text": "生的肉，有时候，拉肚子。你做的肉，很香，好吃。"
                                        },
                                        {
                                            "id": "690200816",
                                            "speaker": "雷泽",
                                            "text": "想要…一直吃到你做的肉。"
                                        },
                                        {
                                            "id": "690200817",
                                            "speaker": "雷泽",
                                            "text": "这样说，对吗？"
                                        }
                                    ]
                                },
                                {
                                    "id": "690200812",
                                    "text": "「而且好闻」…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690200805",
                    "text": "我来陪你一起练习。",
                    "response": [
                        {
                            "id": "690200806",
                            "speaker": "雷泽",
                            "text": "练习？谢谢你。"
                        }
                    ]
                }
            ]
        }
    ]
}