{
    "talkId": "6909902",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "艾梅莉埃": 11
    },
    "dialogues": [
        {
            "id": "690990201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690990202",
            "speaker": "艾梅莉埃",
            "text": "比想的更好。"
        },
        {
            "id": "690990203",
            "speaker": "艾梅莉埃",
            "text": "能像这样欣赏一处兼具个人审美与流行美学的宅邸，我很惊喜。",
            "choices": [
                {
                    "id": "690990204",
                    "text": "有没有装潢方面的建议？",
                    "response": [
                        {
                            "id": "690990205",
                            "speaker": "艾梅莉埃",
                            "text": "以我的特长，恐怕不适合就这方面发表意见。不过，如果你需要通风布设方面的建议，我愿意提供一些参考。"
                        },
                        {
                            "id": "690990206",
                            "speaker": "艾梅莉埃",
                            "text": "我现在使用的制香室，里面的排风系统就是我自己构建的。区别于普通房屋，制香室对这方面要求更高。"
                        },
                        {
                            "id": "690990207",
                            "speaker": "艾梅莉埃",
                            "text": "另外，门窗的位置也很有讲究。当然，建议终究只是建议。如果你有更专业的朋友，也可以咨询他们。"
                        }
                    ]
                },
                {
                    "id": "690990208",
                    "text": "能推荐一些适合这里的香氛吗？",
                    "response": [
                        {
                            "id": "690990209",
                            "speaker": "艾梅莉埃",
                            "text": "依照你这里的情况，我会推荐草本香调。"
                        },
                        {
                            "id": "690990210",
                            "speaker": "艾梅莉埃",
                            "text": "符合整体开阔的印象，又带有来自大地的气味。与你本身的职业定位也很符合。"
                        },
                        {
                            "id": "690990211",
                            "speaker": "Player",
                            "text": "职业定位？是指旅行吗？"
                        },
                        {
                            "id": "690990212",
                            "speaker": "艾梅莉埃",
                            "text": "是的。至少在我看来，这是你最显著也最重要的职业特征。"
                        },
                        {
                            "id": "690990213",
                            "speaker": "艾梅莉埃",
                            "text": "据我所知，长年在外旅行的人，他们所记住的气味类型很可能多于一般人。"
                        },
                        {
                            "id": "690990214",
                            "speaker": "艾梅莉埃",
                            "text": "而大地、土壤…这些最踏实的要素，正是旅行的起与终，也是你每日踏足的根本。"
                        },
                        {
                            "id": "690990215",
                            "speaker": "艾梅莉埃",
                            "text": "草本是大地的精华，适合走遍最多土地的人。"
                        }
                    ]
                }
            ]
        }
    ]
}