    },
    "dialogues": [
        {
            "id": "5160701",
            "speaker": "「万端珊瑚」广告",
            "text": "「万端珊瑚，代行万端！」"
        },
        {
            "id": "5160702",
            "speaker": "「万端珊瑚」广告",
            "text": "「寻人、寻找宠物、婚姻调查、犯罪调查、商业委托、运送货品、代购代送…」"
        },
        {
            "id": "5160703",
            "speaker": "「万端珊瑚」广告",
            "text": "「只要您开价，钱形、百目鬼之流江洋大盗也捉给您看！」"
        },
        {
            "id": "5160704",
            "speaker": "「万端珊瑚」广告",
            "text": "「顺便，请各位客户不要相信那位自称平藏的『侦探』！此人乃诈骗惯犯！！」"
        },
        {
            "id": "5160705",
            "speaker": "留言",
            "text": "「这就是『同行相轻』吗…」"
        },
        {
            "id": "5160706",
            "speaker": "「万端珊瑚」回复",
            "text": "「谁和那家伙是同行啦！」"
        }
    ]
}