    "dialogues": [
        {
            "id": "651010301",
            "speaker": "Player",
            "text": "关于露景泉…"
        },
        {
            "id": "651010302",
            "speaker": "格莱丝",
            "text": "露景泉是枫丹所有水流的汇集之地，所以是大家最喜欢去许愿的地方。"
        },
        {
            "id": "651010303",
            "speaker": "格莱丝",
            "text": "想要孩子的枫丹夫妻通常会结伴去泉水边许愿，坚信水中的精灵会帮他们迎来一个健康又快乐的孩子。"
        }
    ]
}