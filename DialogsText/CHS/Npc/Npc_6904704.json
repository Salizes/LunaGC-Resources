{
    "talkId": "6904704",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "枫原万叶": 17
    },
    "dialogues": [
        {
            "id": "690470401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690470402",
            "speaker": "枫原万叶",
            "text": "嗯，请收下这个。"
        },
        {
            "id": "690470403",
            "speaker": "枫原万叶",
            "text": "听说故乡的枫叶已经染上了红色，很想回去看看。不过路途遥远，暂时回不去了…"
        },
        {
            "id": "690470404",
            "speaker": "枫原万叶",
            "text": "前几天在集市上闲逛，见到了保存良好的枫叶标本，就买了几枚。"
        },
        {
            "id": "690470405",
            "speaker": "枫原万叶",
            "text": "虽然不确定是否为故乡所产，但也能稍稍抚平思乡之苦。",
            "choices": [
                {
                    "id": "690470406",
                    "text": "万叶很喜欢枫叶吗？",
                    "response": [
                        {
                            "id": "690470407",
                            "speaker": "枫原万叶",
                            "text": "是啊。"
                        },
                        {
                            "id": "690470408",
                            "speaker": "枫原万叶",
                            "text": "以前我也会在秋风起时收集一些枫叶，带在身上。"
                        },
                        {
                            "id": "690470409",
                            "speaker": "枫原万叶",
                            "text": "在船上的时候，我也曾把枫叶撒落在海水中，看着它们漂向遥远的地方。"
                        },
                        {
                            "id": "690470410",
                            "speaker": "枫原万叶",
                            "text": "也许，也会有一个像我一样思念故乡的人，捡到其中的某一片吧…"
                        },
                        {
                            "id": "690470416",
                            "speaker": "Player",
                            "text": "我也想去万叶的故乡看看。"
                        },
                        {
                            "id": "690470417",
                            "speaker": "枫原万叶",
                            "text": "啊…失礼了。"
                        },
                        {
                            "id": "690470418",
                            "speaker": "枫原万叶",
                            "text": "本该是由我主动邀请…我却独自沉浸在思乡的情绪之中。",
                            "choices": [
                                {
                                    "id": "690470419",
                                    "text": "没关系的。",
                                    "response": [
                                        {
                                            "id": "690470421",
                                            "speaker": "枫原万叶",
                                            "text": "…谢谢。"
                                        },
                                        {
                                            "id": "690470422",
                                            "speaker": "枫原万叶",
                                            "text": "那便以这枫叶为信物，与你就此约定了。"
                                        },
                                        {
                                            "id": "690470423",
                                            "speaker": "枫原万叶",
                                            "text": "等下次枫叶红时，共赴故乡。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690470420",
                                    "text": "我能够理解万叶的心情。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690470411",
                    "text": "看上去确实很漂亮。",
                    "response": [
                        {
                            "id": "690470412",
                            "speaker": "枫原万叶",
                            "text": "是吧…单纯从观赏的角度来看，染红的枫叶也有着别样的美感。"
                        },
                        {
                            "id": "690470413",
                            "speaker": "枫原万叶",
                            "text": "在我的故乡，人们每年都会观赏红叶飘落的盛景。"
                        },
                        {
                            "id": "690470414",
                            "speaker": "枫原万叶",
                            "text": "树上的枫叶犹如红色的火烧云，落下的便是红色的雨。"
                        },
                        {
                            "id": "690470415",
                            "speaker": "枫原万叶",
                            "text": "落叶在地上积满厚厚的一层，秋虫鸣叫，野鸟徘徊…"
                        }
                    ]
                }
            ]
        }
    ]
}