    "speaker_counts": {
        "Player": 1,
        "锋": 5
    },
    "dialogues": [
        {
            "id": "616390501",
            "speaker": "Player",
            "text": "你在做什么？"
        },
        {
            "id": "616390502",
            "speaker": "锋",
            "text": "拿了歌德老爷子的钱要我护着少爷，又拿了少爷的钱让我把这事对老爷子保密。"
        },
        {
            "id": "616390503",
            "speaker": "锋",
            "text": "想拿双份钱的话，自然就得闭嘴在这儿守着。"
        },
        {
            "id": "616390504",
            "speaker": "锋",
            "text": "哼，有我盯着居然还亲热得起来，不知羞耻的年轻人…"
        },
        {
            "id": "616390505",
            "speaker": "锋",
            "text": "…等等，难道说被我这么盯着反而更加来劲儿？"
        },
        {
            "id": "616390506",
            "speaker": "锋",
            "text": "…可恶，可恶啊…咳咳…"
        }
    ]
}