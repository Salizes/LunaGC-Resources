{
    "talkId": "6909411",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 7,
        "千织": 17
    },
    "dialogues": [
        {
            "id": "690940401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690940402",
            "speaker": "千织",
            "text": "你这儿有羽子板吗？想和你来打几场。"
        },
        {
            "id": "690940403",
            "speaker": "千织",
            "text": "你脸上的表情是怎么回事？该不会在你心中，我只会坐在工作台前缝衣服吧？"
        },
        {
            "id": "690940404",
            "speaker": "Player",
            "text": "只是没想到是羽子板…"
        },
        {
            "id": "690940405",
            "speaker": "千织",
            "text": "小时候在稻妻常玩，当时可没几个孩子能赢我。"
        },
        {
            "id": "690940406",
            "speaker": "千织",
            "text": "结果到了枫丹之后没人会玩，教新手打又觉得像在欺负人。"
        },
        {
            "id": "690940407",
            "speaker": "千织",
            "text": "你在稻妻的时候应该玩过这种游艺吧？想必身手不赖。"
        },
        {
            "id": "690940408",
            "speaker": "千织",
            "text": "怎么？难不成你怕了？",
            "choices": [
                {
                    "id": "690940409",
                    "text": "接受挑战！",
                    "response": [
                        {
                            "id": "690940410",
                            "speaker": "千织",
                            "text": "嗯，有气势。不愧是人们交口称赞的旅行者。"
                        },
                        {
                            "id": "690940411",
                            "speaker": "千织",
                            "text": "先说好，要是输了，可别指望我帮你保密。"
                        },
                        {
                            "id": "690940416",
                            "speaker": "千织",
                            "text": "准备好就开始，我用自己的两支羽子板。",
                            "choices": [
                                {
                                    "id": "690940417",
                                    "text": "…二板流？",
                                    "response": [
                                        {
                                            "id": "690940419",
                                            "speaker": "千织",
                                            "text": "规则没说不能用两支呀。我平时用双刀，现在用两支羽子板也很正常吧？"
                                        },
                                        {
                                            "id": "690940420",
                                            "speaker": "千织",
                                            "text": "你要是想的话，用四支来和我打都行。我没意见。"
                                        },
                                        {
                                            "id": "690940421",
                                            "speaker": "千织",
                                            "text": "还是说，这就已经准备认输了？"
                                        },
                                        {
                                            "id": "690940422",
                                            "speaker": "Player",
                                            "text": "…输了别不认！"
                                        },
                                        {
                                            "id": "690940423",
                                            "speaker": "千织",
                                            "text": "放心，虽然「千织」这个品牌的理念是永不认输。但对朋友，我可不会耍赖。"
                                        },
                                        {
                                            "id": "690940424",
                                            "speaker": "千织",
                                            "text": "前提是你能赢过我。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690940418",
                                    "text": "…是不是有些不公平？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690940412",
                    "text": "输了的人怎么办？",
                    "response": [
                        {
                            "id": "690940413",
                            "speaker": "千织",
                            "text": "哦？来认真的？好呀，有点代价才好玩。"
                        },
                        {
                            "id": "690940414",
                            "speaker": "千织",
                            "text": "要是你输了，就来我店里打几天工吧。打扫店铺、整理衣服，偶尔当当模特…"
                        },
                        {
                            "id": "690940415",
                            "speaker": "千织",
                            "text": "要是我输了，就随你开一个差不多的条件，打扫你的家，或者做点好看的东西帮你装点一下什么的…"
                        }
                    ]
                }
            ]
        }
    ]
}