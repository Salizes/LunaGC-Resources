{
    "talkId": "6905409",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "珊瑚宫心海": 12
    },
    "dialogues": [
        {
            "id": "690540401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690540402",
            "speaker": "珊瑚宫心海",
            "text": "如果可以的话，我想带你一起去海里潜水。"
        },
        {
            "id": "690540403",
            "speaker": "珊瑚宫心海",
            "text": "尘世中有许多烦恼，但任何烦恼与大海的广阔相比，都变得不值一提。"
        },
        {
            "id": "690540404",
            "speaker": "珊瑚宫心海",
            "text": "悠悠古今，岁月变迁，而大海一如既往。身处水下的世界，心也会慢慢平静下来。"
        },
        {
            "id": "690540405",
            "speaker": "珊瑚宫心海",
            "text": "有时候我会感觉你太累了，所以我也想尝试一下，把我平时放松的方法教给你。",
            "choices": [
                {
                    "id": "690540406",
                    "text": "可是在水下要怎么呼吸…",
                    "response": [
                        {
                            "id": "690540408",
                            "speaker": "珊瑚宫心海",
                            "text": "嗯…这倒是一个问题…"
                        },
                        {
                            "id": "690540409",
                            "speaker": "珊瑚宫心海",
                            "text": "等等，我想到了一个办法。"
                        },
                        {
                            "id": "690540410",
                            "speaker": "珊瑚宫心海",
                            "text": "我可以做一个特别特别大的泡泡，将我们两个包裹进去，慢慢沉到水下。"
                        },
                        {
                            "id": "690540411",
                            "speaker": "珊瑚宫心海",
                            "text": "这样我们就可以一起在水下遨游了！想必能量也会回复得更快吧。"
                        },
                        {
                            "id": "690540412",
                            "speaker": "珊瑚宫心海",
                            "text": "我也没和别人一起潜过水呢，真让人期待…"
                        },
                        {
                            "id": "690540413",
                            "speaker": "Player",
                            "text": "需要我准备什么东西吗？"
                        },
                        {
                            "id": "690540414",
                            "speaker": "珊瑚宫心海",
                            "text": "不用，本来就是为了放松而规划的旅行，随性而为就好。"
                        },
                        {
                            "id": "690540415",
                            "speaker": "珊瑚宫心海",
                            "text": "更何况，还有我这个「军师」在呢。"
                        },
                        {
                            "id": "690540416",
                            "speaker": "珊瑚宫心海",
                            "text": "你就好好休息，剩下的事情交给我就好。"
                        }
                    ]
                },
                {
                    "id": "690540407",
                    "text": "可是我不会游泳…"
                }
            ]
        }
    ]
}