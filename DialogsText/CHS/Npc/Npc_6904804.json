{
    "talkId": "6904804",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "烟绯": 13
    },
    "dialogues": [
        {
            "id": "690480401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690480402",
            "speaker": "烟绯",
            "text": "我想想…要不要一起去钓鱼。"
        },
        {
            "id": "690480403",
            "speaker": "烟绯",
            "text": "我和你，不带其他人，连那个小家伙都不带。"
        },
        {
            "id": "690480404",
            "speaker": "烟绯",
            "text": "理由嘛…你肯定要问我理由对不对。"
        },
        {
            "id": "690480405",
            "speaker": "烟绯",
            "text": "一个人钓鱼很没劲。鱼钓得再多，最多也就回去跟姥姥分分。"
        },
        {
            "id": "690480406",
            "speaker": "烟绯",
            "text": "和客户、朋友去的话，你知道的，我不能发挥自己的真正实力。"
        },
        {
            "id": "690480407",
            "speaker": "烟绯",
            "text": "怎么想，都只有你才是合适的人选。",
            "choices": [
                {
                    "id": "690480408",
                    "text": "有种被挑剩下来的感觉…",
                    "response": [
                        {
                            "id": "690480410",
                            "speaker": "烟绯",
                            "text": "不，不是的！"
                        },
                        {
                            "id": "690480411",
                            "speaker": "烟绯",
                            "text": "哎呀，我就是想和你两个人出去嘛。"
                        },
                        {
                            "id": "690480412",
                            "speaker": "烟绯",
                            "text": "安安静静、不被打扰的，享受两个人的时光…"
                        },
                        {
                            "id": "690480413",
                            "speaker": "烟绯",
                            "text": "也让你看看我本职工作以外厉害的一面…",
                            "choices": [
                                {
                                    "id": "690480414",
                                    "text": "我一直都认可着烟绯。",
                                    "response": [
                                        {
                                            "id": "690480415",
                                            "speaker": "烟绯",
                                            "text": "什么嘛…"
                                        },
                                        {
                                            "id": "690480418",
                                            "speaker": "烟绯",
                                            "text": "那我们就说好了！这是我和你之间的…重要的「契约」哦。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690480416",
                                    "text": "但钓鱼我也是很在行的。",
                                    "response": [
                                        {
                                            "id": "690480417",
                                            "speaker": "烟绯",
                                            "text": "哦？你这样说的话…我可是更来劲了！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690480409",
                    "text": "感觉是现编的…"
                }
            ]
        }
    ]
}