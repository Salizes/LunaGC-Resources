    "dialogues": [
        {
            "id": "750343401",
            "speaker": "潘帕",
            "text": "哟，有空来这儿了？",
            "choices": [
                {
                    "id": "750343402",
                    "text": "我们很熟吗？",
                    "response": [
                        {
                            "id": "750343403",
                            "speaker": "潘帕",
                            "text": "见过面、说过话，那就是朋友！再说了，之前那事儿咱俩不是一边的吗？可别说你忘了。"
                        },
                        {
                            "id": "750343404",
                            "speaker": "Player",
                            "text": "我是我自己这边的。"
                        },
                        {
                            "id": "750343405",
                            "speaker": "潘帕",
                            "text": "哎，你说得对，听说就连特纳华先生也很赏识你。能跟你交上朋友，真是件荣幸的事呢！"
                        }
                    ]
                },
                {
                    "id": "750343406",
                    "text": "我该走了。",
                    "response": [
                        {
                            "id": "750343407",
                            "speaker": "潘帕",
                            "text": "那你先忙。"
                        }
                    ]
                }
            ]
        }
    ]
}