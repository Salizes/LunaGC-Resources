{
    "talkId": "6910109",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "基尼奇": 11,
        "阿乔": 5
    },
    "dialogues": [
        {
            "id": "691010401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691010402",
            "speaker": "基尼奇",
            "text": "我无所谓。现在手边没委托，做什么都行。"
        },
        {
            "id": "691010403",
            "speaker": "基尼奇",
            "text": "你想喝点东西吗？比如青蜜莓苦种果汁。"
        },
        {
            "id": "691010404",
            "speaker": "阿乔",
            "text": "#哇！别管{M#他}{F#她}要不要了，把我的份先呈上来！",
            "choices": [
                {
                    "id": "691010405",
                    "text": "什么价格？",
                    "response": [
                        {
                            "id": "691010406",
                            "speaker": "基尼奇",
                            "text": "呵，这杯不收你钱。"
                        },
                        {
                            "id": "691010409",
                            "speaker": "基尼奇",
                            "text": "在纳塔，苦种主要被用于制作巧克力和苦水，最有价值的部分是发酵后的种子。"
                        },
                        {
                            "id": "691010410",
                            "speaker": "基尼奇",
                            "text": "但万物皆有其用。如果将它白色的果肉部分挤榨成汁，经过恰当调味，同样能够制成可口的饮品。"
                        },
                        {
                            "id": "691010411",
                            "speaker": "阿乔",
                            "text": "介绍够了没？快点快点，我已经等不及了！"
                        },
                        {
                            "id": "691010412",
                            "speaker": "基尼奇",
                            "text": "起初，我用的是维茨特兰当地的火榴果，它能够为人和龙提供丰富的燃素。"
                        },
                        {
                            "id": "691010413",
                            "speaker": "基尼奇",
                            "text": "后来，考虑到获取上的难度，我将它改成青蜜莓，相应调整了饮品中各材料的配比。"
                        },
                        {
                            "id": "691010414",
                            "speaker": "阿乔",
                            "text": "基尼奇！你故意的吧？平时怎么没见到你话那么多、解释起来那么啰嗦！"
                        },
                        {
                            "id": "691010415",
                            "speaker": "阿乔",
                            "text": "你要不要从维茨特兰的起源和世界上的第一棵火榴果树开始讲起啊？"
                        },
                        {
                            "id": "691010416",
                            "speaker": "基尼奇",
                            "text": "这是为了让我的朋友能对这道饮品有更多的了解，从而更好地享用它。"
                        },
                        {
                            "id": "691010417",
                            "speaker": "基尼奇",
                            "text": "反正你也尝不出果汁口感上的好坏，平时和你说你也不懂。"
                        },
                        {
                            "id": "691010418",
                            "speaker": "阿乔",
                            "text": "你…！"
                        },
                        {
                            "id": "691010419",
                            "speaker": "Player",
                            "text": "那个…我被你们说得想尝尝了！"
                        },
                        {
                            "id": "691010420",
                            "speaker": "基尼奇",
                            "text": "好。那我现在就为二位调配果汁。"
                        }
                    ]
                },
                {
                    "id": "691010407",
                    "text": "那是什么？",
                    "response": [
                        {
                            "id": "691010408",
                            "speaker": "基尼奇",
                            "text": "一种由我自创的混合燃素果汁。"
                        }
                    ]
                }
            ]
        }
    ]
}