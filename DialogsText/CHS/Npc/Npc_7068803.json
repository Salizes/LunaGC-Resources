    "speaker_counts": {
        "Player": 3,
        "凯瑟琳": 6
    },
    "dialogues": [
        {
            "id": "706880301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么厉害的委托吗？</color>"
        },
        {
            "id": "706880302",
            "speaker": "凯瑟琳",
            "text": "您来的正巧，有一份协会共享给资深冒险家的手册要交给您。",
            "choices": [
                {
                    "id": "706880303",
                    "text": "是提瓦特美食大全吗？",
                    "response": [
                        {
                            "id": "706880304",
                            "speaker": "凯瑟琳",
                            "text": "很遗憾，并不是。"
                        },
                        {
                            "id": "706880307",
                            "speaker": "凯瑟琳",
                            "text": "如您所见，手册记录了值得挑战的强敌的信息。"
                        },
                        {
                            "id": "706880308",
                            "speaker": "凯瑟琳",
                            "text": "若能合理利用，想必会为您的冒险旅途增加许多助益。之后如果需要查阅相关信息，也随时欢迎您来。"
                        },
                        {
                            "id": "706880309",
                            "speaker": "凯瑟琳",
                            "text": "那么，就祝您旗开得胜。"
                        }
                    ]
                },
                {
                    "id": "706880305",
                    "text": "难道又是新的任务…",
                    "response": [
                        {
                            "id": "706880306",
                            "speaker": "凯瑟琳",
                            "text": "挑战与否，选择权当然在您。"
                        }
                    ]
                }
            ]
        }
    ]
}