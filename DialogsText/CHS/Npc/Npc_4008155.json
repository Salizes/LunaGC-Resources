{
    "talkId": "4008155",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 2,
        "左右加": 7,
        "派蒙": 4
    },
    "dialogues": [
        {
            "id": "400815501",
            "speaker": "左右加",
            "text": "没想到啊，真没想到！明明是这么好的一场比赛，背后怎么就藏着不得了的阴谋呢…",
            "choices": [
                {
                    "id": "400815502",
                    "text": "已经没事了！",
                    "response": [
                        {
                            "id": "400815503",
                            "speaker": "派蒙",
                            "text": "对哦，坏家伙的阴谋都被挫败了，不用怕啦！"
                        },
                        {
                            "id": "400815504",
                            "speaker": "派蒙",
                            "text": "不过，这种时候，左右加小姐不应该很激动地喊着「我知道该怎么写了」吗？"
                        },
                        {
                            "id": "400815505",
                            "speaker": "派蒙",
                            "text": "这么关键的桥段，肯定给了你不少灵感吧！"
                        },
                        {
                            "id": "400815506",
                            "speaker": "左右加",
                            "text": "实不相瞒…我！我觉得这样的发展有点超出我的想象了！必须一开始就给埃尔欣根这种大反派明显一点的描写才行。"
                        },
                        {
                            "id": "400815507",
                            "speaker": "左右加",
                            "text": "你们和八重大人好像很早就发现了不对劲的地方，但我这样的普通人根本不知道发生了什么。"
                        },
                        {
                            "id": "400815508",
                            "speaker": "左右加",
                            "text": "如果要写进轻小说，还是要好好酝酿一下解开谜底的过程，并且给读者更多信息！毕竟反转太突兀也不合适嘛。"
                        },
                        {
                            "id": "400815509",
                            "speaker": "左右加",
                            "text": "当然，最后和伙伴们一起战胜幕后黑手，这样重要的情节，写得再用力都不为过！没准在动笔之前，我还要喝两壶酒来积累气势！"
                        },
                        {
                            "id": "400815510",
                            "speaker": "左右加",
                            "text": "这也是八重大人推荐的方法，我今晚就试一试！"
                        },
                        {
                            "id": "400815511",
                            "speaker": "派蒙",
                            "text": "太夸张了吧！当心别喝醉了哦，还不知道你喝醉以后会写出什么样的情节来呢！"
                        }
                    ]
                },
                {
                    "id": "400815512",
                    "text": "不打扰你思考了…",
                    "response": [
                        {
                            "id": "400815513",
                            "speaker": "左右加",
                            "text": "咦！你们两位要走了吗？那…以后有机会的话，我一定要好好答谢你们！"
                        }
                    ]
                }
            ]
        }
    ]
}