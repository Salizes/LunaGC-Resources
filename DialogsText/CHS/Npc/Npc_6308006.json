    "dialogues": [
        {
            "id": "630800601",
            "speaker": "Player",
            "text": "生意如何？"
        },
        {
            "id": "630800602",
            "speaker": "瓦希德",
            "text": "这话问得，那当然…"
        },
        {
            "id": "630800603",
            "speaker": "瓦希德",
            "text": "…唉，算了，我就和您说实话吧。"
        },
        {
            "id": "630800604",
            "speaker": "瓦希德",
            "text": "「锁国令」之前还偶尔有从鸣神岛来的稻妻人照顾生意。"
        },
        {
            "id": "630800605",
            "speaker": "瓦希德",
            "text": "可自从「锁国令」颁布之后，客流少了，生意是每况愈下，也不知道还能撑多久…"
        },
        {
            "id": "630800606",
            "speaker": "瓦希德",
            "text": "客官，您要来点「丰沃之惠」吗？就当是旅行的纪念品，怎么样？"
        }
    ]
}