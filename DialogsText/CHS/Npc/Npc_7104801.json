{
    "talkId": "7104801",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 10,
        "岚姐": 19,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "710480101",
            "speaker": "岚姐",
            "text": "啊，是你呀。怎么，你是来应征探索层岩巨渊的吗？"
        },
        {
            "id": "710480102",
            "speaker": "Player",
            "text": "层岩巨渊？"
        },
        {
            "id": "710480103",
            "speaker": "派蒙",
            "text": "没听说过有这种委托呢…"
        },
        {
            "id": "710480104",
            "speaker": "岚姐",
            "text": "嗯？哦，原来你还不知道冒险家协会的委托…抱歉，是我的失职。"
        },
        {
            "id": "710480105",
            "speaker": "岚姐",
            "text": "毕竟层岩巨渊已经关闭了嘛。若是没有璃月七星等级人士的许可，任何人都无权进入那里…冒险家协会也不例外。",
            "choices": [
                {
                    "id": "710480106",
                    "text": "冒险家协会没有特别许可吗？",
                    "response": [
                        {
                            "id": "710480108",
                            "speaker": "岚姐",
                            "text": "我们可不能用这种事干扰玉京台的工作…干涉已成定论的政策，结果只能适得其反。"
                        },
                        {
                            "id": "710480109",
                            "speaker": "岚姐",
                            "text": "即使是那位看起来很好说话的甘雨小姐，恐怕也只会满面微笑地对你来一句「不好意思，请稍等片刻，先喝杯茶吧。」"
                        },
                        {
                            "id": "710480110",
                            "speaker": "岚姐",
                            "text": "然后把你晾半天，让你怀疑她是不是直到快下班才会想起来处理你的请求…"
                        },
                        {
                            "id": "710480111",
                            "speaker": "岚姐",
                            "text": "哼…你也知道，甘雨小姐从来不会下班。"
                        },
                        {
                            "id": "710480112",
                            "speaker": "派蒙",
                            "text": "噗…"
                        },
                        {
                            "id": "710480113",
                            "speaker": "Player",
                            "text": "确实是甘雨特有的拒绝方式…"
                        },
                        {
                            "id": "710480114",
                            "speaker": "岚姐",
                            "text": "所以，探索层岩巨渊的委托自然不适合拜托凯瑟琳小姐公示出来。我们只能私下里寻找更方便的人选。"
                        },
                        {
                            "id": "710480115",
                            "speaker": "Player",
                            "text": "更方便的人选…？"
                        },
                        {
                            "id": "710480116",
                            "speaker": "岚姐",
                            "text": "嗯，比如说辉山厅指定的矿工、千岩军人员、总务司职员之类，他们更容易拿到通行证，以及…"
                        },
                        {
                            "id": "710480117",
                            "speaker": "派蒙",
                            "text": "以及…什么呀？"
                        },
                        {
                            "id": "710480118",
                            "speaker": "岚姐",
                            "text": "嗯…从海魔的触手之下拯救过璃月，却每天无所事事的大英雄，我想在千岩军面前应该也很好说话吧？"
                        },
                        {
                            "id": "710480119",
                            "speaker": "Player",
                            "text": "谁呀…？"
                        },
                        {
                            "id": "710480120",
                            "speaker": "岚姐",
                            "text": "你呀。"
                        },
                        {
                            "id": "710480121",
                            "speaker": "派蒙",
                            "text": "对哦，还能有谁呀！"
                        },
                        {
                            "id": "710480122",
                            "speaker": "岚姐",
                            "text": "别装傻了，我说的还能是岩王爷他老人家不成？",
                            "choices": [
                                {
                                    "id": "710480123",
                                    "text": "嘿嘿。",
                                    "response": [
                                        {
                                            "id": "710480125",
                                            "speaker": "岚姐",
                                            "text": "行了，别臭美啦。"
                                        },
                                        {
                                            "id": "710480126",
                                            "speaker": "岚姐",
                                            "text": "总之…感谢你之前一直为冒险家协会提供的帮助，这次的委托也希望你考虑一下。"
                                        },
                                        {
                                            "id": "710480127",
                                            "speaker": "岚姐",
                                            "text": "如果不方便的话也没关系的，只是…假如你路经层岩巨渊的话，希望能替我找一下沐宁这个家伙。"
                                        },
                                        {
                                            "id": "710480128",
                                            "speaker": "派蒙",
                                            "text": "沐宁…那又是谁呀？"
                                        },
                                        {
                                            "id": "710480129",
                                            "speaker": "岚姐",
                                            "text": "他呀，是总务司派驻层岩巨渊的专员。跟我有一点私人事务没有解决…如果你在层岩巨渊遇到了什么阻碍可以找他咨询。"
                                        },
                                        {
                                            "id": "710480130",
                                            "speaker": "岚姐",
                                            "text": "就转达我的话，「你还欠着岚姐的酒钱呢，可别忘了。」——他自然会明白。",
                                            "choices": [
                                                {
                                                    "id": "710480131",
                                                    "text": "我明白了。",
                                                    "response": [
                                                        {
                                                            "id": "710480133",
                                                            "speaker": "岚姐",
                                                            "text": "啊，请留步！顺便…如果你同意接下这个委托的话，报酬请直接找沐宁商议吧。"
                                                        },
                                                        {
                                                            "id": "710480134",
                                                            "speaker": "岚姐",
                                                            "text": "请不要问我为何这样安排…总务司方面是这样坚持的，冒险家协会也不好过问。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "710480132",
                                                    "text": "我会顺路看看的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "710480124",
                                    "text": "我还是有在忙正事的。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "710480107",
                    "text": "七星也不会对冒险家协会网开一面？"
                }
            ]
        }
    ]
}