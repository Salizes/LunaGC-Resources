{
    "talkId": "6905108",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "优菈": 12
    },
    "dialogues": [
        {
            "id": "690510801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690510402",
            "speaker": "优菈",
            "text": "想做的？为什么会这么问？"
        },
        {
            "id": "690510403",
            "speaker": "Player",
            "text": "因为想要陪优菈。"
        },
        {
            "id": "690510404",
            "speaker": "优菈",
            "text": "……"
        },
        {
            "id": "690510405",
            "speaker": "优菈",
            "text": "奇怪的说法。"
        },
        {
            "id": "690510406",
            "speaker": "优菈",
            "text": "既然如此，我来教你跳舞吧，属于我的「祭礼之舞」。"
        },
        {
            "id": "690510407",
            "speaker": "优菈",
            "text": "我告诉过你，我在自己的剑技中融入了舞蹈。想学习我的剑术，得过舞蹈这关。"
        },
        {
            "id": "690510408",
            "speaker": "优菈",
            "text": "其实，它作为艺术消遣本身，也是我所钟爱的…"
        },
        {
            "id": "690510409",
            "speaker": "优菈",
            "text": "现在是时候教给你了。",
            "choices": [
                {
                    "id": "690510410",
                    "text": "有双人舞吗？",
                    "response": [
                        {
                            "id": "690510411",
                            "speaker": "优菈",
                            "text": "先等你把基础舞步都练会再说。"
                        },
                        {
                            "id": "690510412",
                            "speaker": "优菈",
                            "text": "那么贪心，理应给你记上最深最重的仇——"
                        },
                        {
                            "id": "690510415",
                            "speaker": "优菈",
                            "text": "但是，我想过了。都已经到这个份上了，这些仇不计较也罢。"
                        },
                        {
                            "id": "690510416",
                            "speaker": "优菈",
                            "text": "毕竟和你「仇」到深处…早就难解难分了。"
                        }
                    ]
                },
                {
                    "id": "690510413",
                    "text": "如果踩到优菈脚的话…",
                    "response": [
                        {
                            "id": "690510414",
                            "speaker": "优菈",
                            "text": "那理应给你记上最深最重的仇——"
                        }
                    ]
                }
            ]
        }
    ]
}