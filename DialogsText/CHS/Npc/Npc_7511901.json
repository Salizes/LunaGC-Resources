    "dialogues": [
        {
            "id": "751190101",
            "speaker": "玛兹嘉",
            "text": "好孩子要听话哦，咕噜噜。你伤没完全好，不要再偷跑出去打猎了哦，我会担心你的。"
        },
        {
            "id": "751190105",
            "speaker": "玛兹嘉",
            "text": "况且，你猎来的兽肉太多啦，都跟小山一样高了，根本吃不完，这样下去会浪费掉的。"
        },
        {
            "id": "751190102",
            "speaker": "「咕噜噜」",
            "text": "哇！哇！"
        },
        {
            "id": "751190103",
            "speaker": "玛兹嘉",
            "text": "没错，没错，咕噜噜是最棒最听话的绒翼龙啦。嘿嘿，别闹啦别闹啦，太痒了啦。"
        },
        {
            "id": "751190104",
            "speaker": "「咕噜噜」",
            "text": "哇哇哇哇哇哇~"
        }
    ]
