{
    "talkId": "6905304",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "早柚": 14
    },
    "dialogues": [
        {
            "id": "690530401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690530402",
            "speaker": "早柚",
            "text": "如果你方便的话…"
        },
        {
            "id": "690530403",
            "speaker": "早柚",
            "text": "可不可以和我一起种一棵树？"
        },
        {
            "id": "690530404",
            "speaker": "Player",
            "text": "种树？"
        },
        {
            "id": "690530405",
            "speaker": "早柚",
            "text": "嗯，种一棵大树吧！"
        },
        {
            "id": "690530406",
            "speaker": "早柚",
            "text": "比外面的那些树都要大。"
        },
        {
            "id": "690530407",
            "speaker": "早柚",
            "text": "我可以教你一些借助树叶的忍术哦。"
        },
        {
            "id": "690530408",
            "speaker": "早柚",
            "text": "虽然，都是些逃跑用的…"
        },
        {
            "id": "690530409",
            "speaker": "早柚",
            "text": "但是，但是！遇到强敌的时候，逃跑也是很重要的！"
        },
        {
            "id": "690530410",
            "speaker": "早柚",
            "text": "我不希望看到你受伤…"
        },
        {
            "id": "690530411",
            "speaker": "Player",
            "text": "那到时候就拜托早柚了。"
        },
        {
            "id": "690530412",
            "speaker": "早柚",
            "text": "交给我吧。"
        },
        {
            "id": "690530413",
            "speaker": "早柚",
            "text": "然后，我们还可以爬上树休息。"
        },
        {
            "id": "690530414",
            "speaker": "早柚",
            "text": "坐在树干上吹风…"
        },
        {
            "id": "690530415",
            "speaker": "早柚",
            "text": "呼啊…这么一想…真的有点困了。",
            "choices": [
                {
                    "id": "690530416",
                    "text": "晚安，早柚。",
                    "response": [
                        {
                            "id": "690530418",
                            "speaker": "早柚",
                            "text": "#{NICKNAME}，你也是。"
                        },
                        {
                            "id": "690530419",
                            "speaker": "早柚",
                            "text": "…希望每次睡着都能梦见你…"
                        }
                    ]
                },
                {
                    "id": "690530417",
                    "text": "做个好梦吧，早柚。"
                }
            ]
        }
    ]
}