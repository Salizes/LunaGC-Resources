{
    "talkId": "6717101",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "阿舍鲁": 2,
        "雅珂达": 9
    },
    "dialogues": [
        {
            "id": "671710101",
            "speaker": "雅珂达",
            "text": "哎呀，今天没什么客人，可算闲下来了。"
        },
        {
            "id": "671710102",
            "speaker": "雅珂达",
            "text": "我就说嘛，找人找猫什么的，直接去冒险家协会就行，找我们做什么…"
        },
        {
            "id": "671710103",
            "speaker": "雅珂达",
            "text": "不过，就这么站着没事干也挺无聊的啊…"
        },
        {
            "id": "671710104",
            "speaker": "Player",
            "text": "你看来还是想工作。"
        },
        {
            "id": "671710105",
            "speaker": "雅珂达",
            "text": "当然不想咯，但我要是翘班的话，老板又要念叨我了…"
        },
        {
            "id": "671710106",
            "speaker": "雅珂达",
            "text": "#{NICKNAME}，不然你哪天帮我值个班吧，让我出去放放风，不然我要无聊死了…",
            "choices": [
                {
                    "id": "671710107",
                    "text": "我不愿意。",
                    "response": [
                        {
                            "id": "671710110",
                            "speaker": "雅珂达",
                            "text": "唉，好啦好啦，我就是这么一说嘛…值班，我这就接着值班…"
                        },
                        {
                            "id": "671710112",
                            "speaker": "雅珂达",
                            "text": "阿舍鲁啊阿舍鲁，你也不能帮我值一下吗？"
                        },
                        {
                            "id": "671710113",
                            "speaker": "阿舍鲁",
                            "text": "喵喵？喵。喵~"
                        },
                        {
                            "id": "671710108",
                            "speaker": "雅珂达",
                            "text": "喵！喵喵喵！"
                        },
                        {
                            "id": "671710111",
                            "speaker": "阿舍鲁",
                            "text": "喵呜？"
                        },
                        {
                            "id": "671710114",
                            "speaker": "雅珂达",
                            "text": "就知道指望不上你，行了行了，小猫咪…玩去吧。"
                        }
                    ]
                },
                {
                    "id": "671710109",
                    "text": "你自己值啦。"
                }
            ]
        }
    ]
}