{
    "talkId": "7668403",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 2,
        "夏沃蕾": 8,
        "蒂蕾娜": 9
    },
    "dialogues": [
        {
            "id": "766840301",
            "speaker": "蒂蕾娜",
            "text": "队长，你刚刚说的是认真的吗？",
            "choices": [
                {
                    "id": "766840302",
                    "text": "（继续听听看…）",
                    "response": [
                        {
                            "id": "766840303",
                            "speaker": "蒂蕾娜",
                            "text": "我也要被绒翼龙抓着在天上飞吗？"
                        },
                        {
                            "id": "766840304",
                            "speaker": "夏沃蕾",
                            "text": "对。"
                        },
                        {
                            "id": "766840305",
                            "speaker": "蒂蕾娜",
                            "text": "我还要练习在天上操纵铳枪，在高速移动中射击地面的目标？"
                        },
                        {
                            "id": "766840306",
                            "speaker": "夏沃蕾",
                            "text": "对。"
                        },
                        {
                            "id": "766840307",
                            "speaker": "蒂蕾娜",
                            "text": "那…加薪吗？"
                        },
                        {
                            "id": "766840308",
                            "speaker": "夏沃蕾",
                            "text": "加。"
                        },
                        {
                            "id": "766840309",
                            "speaker": "蒂蕾娜",
                            "text": "我干！"
                        },
                        {
                            "id": "766840310",
                            "speaker": "蒂蕾娜",
                            "text": "其实就算不加薪，我也会干。钱从来不是问题，特巡队员的尊严才是。"
                        },
                        {
                            "id": "766840311",
                            "speaker": "蒂蕾娜",
                            "text": "「花羽会」的龙骑士们能做到，我也不想认输！"
                        },
                        {
                            "id": "766840312",
                            "speaker": "夏沃蕾",
                            "text": "其实我知道，不加薪你也会答应，但我不想亏待任何一个队员。所以，除了加薪，还会有一系列额外保险措施和津贴。"
                        },
                        {
                            "id": "766840313",
                            "speaker": "夏沃蕾",
                            "text": "为了保证你们拥有充足的体力，应对更恶劣的作战环境，我会给你们再增加针对性的体能训练。"
                        },
                        {
                            "id": "766840314",
                            "speaker": "夏沃蕾",
                            "text": "先从十万步的负重跑开始吧。"
                        },
                        {
                            "id": "766840315",
                            "speaker": "蒂蕾娜",
                            "text": "我…我跑，我一定好好跑。"
                        },
                        {
                            "id": "766840316",
                            "speaker": "蒂蕾娜",
                            "text": "在天上挂着，确实很消耗体能吧？那这次的十万步，我就背五十单位的负重？"
                        },
                        {
                            "id": "766840317",
                            "speaker": "夏沃蕾",
                            "text": "…我本来想说三十五单位的。"
                        },
                        {
                            "id": "766840318",
                            "speaker": "夏沃蕾",
                            "text": "但你既然主动提出五十单位，那勒泰利埃也按这个标准来好了，然后再看看其他人承不承受得了。"
                        }
                    ]
                },
                {
                    "id": "766840319",
                    "text": "（还是不听了…）"
                }
            ]
        }
    ]
}