{
    "talkId": "6990044",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "699004401",
            "speaker": "Player",
            "text": "关于足不出户的侦探…"
        },
        {
            "id": "699004402",
            "speaker": "派蒙",
            "text": "听说枫丹廷有足不出户就能解明真相的侦探。"
        },
        {
            "id": "699004403",
            "speaker": "派蒙",
            "text": "这就是所谓的居家办公吧？听起来很轻松呢！"
        },
        {
            "id": "699004404",
            "speaker": "派蒙",
            "text": "不过话说回来，不亲自去现场调查，究竟是靠什么推理出真相的呢…啊，我知道了！一定是用占卜吧？"
        },
        {
            "id": "699004405",
            "speaker": "Player",
            "text": "那应该叫占卜师而不是侦探吧。"
        },
        {
            "id": "699004406",
            "speaker": "派蒙",
            "text": "对、对哦…",
            "choices": [
                {
                    "id": "699004407",
                    "text": "案件的线索…",
                    "response": [
                        {
                            "id": "699004409",
                            "speaker": "派蒙",
                            "text": "也就是说，一定有人帮侦探收集线索…",
                            "choices": [
                                {
                                    "id": "699004410",
                                    "text": "说不定我们在冒险家协会接到的委托里…",
                                    "response": [
                                        {
                                            "id": "699004412",
                                            "speaker": "派蒙",
                                            "text": "欸？那原本应该给我们的报酬岂不是会被侦探拿走一部分？那可不行！我们现在就去找侦探抗议！"
                                        }
                                    ]
                                },
                                {
                                    "id": "699004411",
                                    "text": "有一部分就是…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699004408",
                    "text": "可不会自己长脚还专程到侦探府上拜访。"
                }
            ]
        }
    ]
}