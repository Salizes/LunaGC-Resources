    "dialogues": [
        {
            "id": "699002601",
            "speaker": "Player",
            "text": "关于早柚的烦恼…"
        },
        {
            "id": "699002602",
            "speaker": "派蒙",
            "text": "小早柚似乎有很多烦恼呢。"
        },
        {
            "id": "699002603",
            "speaker": "派蒙",
            "text": "真是难以理解。"
        },
        {
            "id": "699002604",
            "speaker": "Player",
            "text": "这大概就是成长的烦恼吧。"
        },
        {
            "id": "699002605",
            "speaker": "派蒙",
            "text": "唔，你这句话也很难理解。"
        },
        {
            "id": "699002606",
            "speaker": "派蒙",
            "text": "毕竟派蒙是没什么烦恼的。"
        },
        {
            "id": "699002607",
            "speaker": "Player",
            "text": "嗯…",
            "choices": [
                {
                    "id": "699002608",
                    "text": "糟了，背包里没几个摩拉了…",
                    "response": [
                        {
                            "id": "699002610",
                            "speaker": "派蒙",
                            "text": "欸？不要啊——"
                        },
                        {
                            "id": "699002611",
                            "speaker": "Player",
                            "text": "现在你有烦恼了。"
                        },
                        {
                            "id": "699002612",
                            "speaker": "派蒙",
                            "text": "怎么会这样…"
                        }
                    ]
                },
                {
                    "id": "699002609",
                    "text": "接下来我们要过穷日子了…"
                }
            ]
        }
    ]
}