{
    "talkId": "6912007",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "菲林斯": 10
    },
    "dialogues": [
        {
            "id": "691200201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691200202",
            "speaker": "菲林斯",
            "text": "你的关心令人感动，请放心，我感觉很好。"
        },
        {
            "id": "691200203",
            "speaker": "菲林斯",
            "text": "这里的各种用度一应俱全，能从中感受到主人的体贴。",
            "choices": [
                {
                    "id": "691200204",
                    "text": "你太客气了。",
                    "response": [
                        {
                            "id": "691200205",
                            "speaker": "菲林斯",
                            "text": "我空手前来，并未携带任何礼物。"
                        },
                        {
                            "id": "691200206",
                            "speaker": "菲林斯",
                            "text": "你用自己准备的食物招待我，我提供真心的赞美，这是应有的礼节。"
                        },
                        {
                            "id": "691200210",
                            "speaker": "菲林斯",
                            "text": "但除了这份好奇心催生而出的欲望，我其他的物质需求都已经被满足了。"
                        },
                        {
                            "id": "691200211",
                            "speaker": "Player",
                            "text": "真别客气啊！"
                        },
                        {
                            "id": "691200212",
                            "speaker": "菲林斯",
                            "text": "你实在太会照料我的感受了。非要吹毛求疵的话，我只能就住所的分配问题提出一些苛刻的意见了。"
                        },
                        {
                            "id": "691200213",
                            "speaker": "菲林斯",
                            "text": "你方便的话，或许，可以给我划分一个更幽静遮光的角落吗？"
                        },
                        {
                            "id": "691200214",
                            "speaker": "菲林斯",
                            "text": "对我这样一个长年住在墓园的人来说，晦暗的环境反而更令人自在。"
                        }
                    ]
                },
                {
                    "id": "691200207",
                    "text": "有缺的告诉我。",
                    "response": [
                        {
                            "id": "691200208",
                            "speaker": "菲林斯",
                            "text": "你的屋子里有不少储藏空间，我毫不怀疑你作为周游四方的冒险家，储藏了不少好货。"
                        },
                        {
                            "id": "691200209",
                            "speaker": "菲林斯",
                            "text": "等你有空之后，我很希望能一起看看这些珍藏。"
                        }
                    ]
                }
            ]
        }
    ]
}