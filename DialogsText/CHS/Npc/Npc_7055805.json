{
    "talkId": "7055805",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "米卡": 14
    },
    "dialogues": [
        {
            "id": "705580501",
            "speaker": "米卡",
            "text": "唔…荣誉骑士前辈体验得如何？"
        },
        {
            "id": "705580502",
            "speaker": "米卡",
            "text": "我相信特雷斯在这方面还是很有天赋的，这个挑战应该能让你理解不少测绘要点…",
            "choices": [
                {
                    "id": "705580503",
                    "text": "新手也能轻松上手！",
                    "response": [
                        {
                            "id": "705580504",
                            "speaker": "米卡",
                            "text": "那、那就好，特雷斯很有天分，又很努力，如果能交出一份大家都满意的答卷，自然也会增加他的信心…"
                        },
                        {
                            "id": "705580505",
                            "speaker": "米卡",
                            "text": "还有埃洛雯，虽然有些偏科，但擅长的事务很多，说是多面手也不为过。"
                        },
                        {
                            "id": "705580506",
                            "speaker": "米卡",
                            "text": "尤其是战地烹饪这方面，来过游击小队营地吃饭的人都说好！"
                        },
                        {
                            "id": "705580507",
                            "speaker": "Player",
                            "text": "说得我都想来尝尝了。"
                        },
                        {
                            "id": "705580508",
                            "speaker": "米卡",
                            "text": "那请多来做客！等他们完成了测绘训练，我应该也能空闲下来！"
                        },
                        {
                            "id": "705580509",
                            "speaker": "米卡",
                            "text": "这次不光是他们，其实我回顾一些初级的问题，因为经验和视角的变化，也产生了许多新的想法。"
                        },
                        {
                            "id": "705580510",
                            "speaker": "米卡",
                            "text": "希望最后，大家都能满载而归。"
                        }
                    ]
                },
                {
                    "id": "705580511",
                    "text": "发现了，米卡是测绘领域泰斗！",
                    "response": [
                        {
                            "id": "705580512",
                            "speaker": "米卡",
                            "text": "啊，还远远谈不上泰斗啦…我只是在做我力所能及的事，并希望这能对我的团队有帮助。"
                        },
                        {
                            "id": "705580513",
                            "speaker": "米卡",
                            "text": "不过比起其他的事情，我的确更喜欢勘察陌生的区域，记录地形的细节，为大家绘制出精确的地图。"
                        },
                        {
                            "id": "705580514",
                            "speaker": "米卡",
                            "text": "前段时间，我们还在推广「前哨龙龙」，那是用来侦查魔物，勘测地形的好帮手。"
                        },
                        {
                            "id": "705580515",
                            "speaker": "米卡",
                            "text": "除了骑士团的大家，就连那些冒险家们也对它好评不断呢。现在要解决的就是量产的难题了…"
                        },
                        {
                            "id": "705580516",
                            "speaker": "米卡",
                            "text": "希望以后，我的经验能帮工程师发明更多这样的工具…这样，测绘对于大家来说，就能更轻松、更精确、更安全了…"
                        }
                    ]
                },
                {
                    "id": "705580517",
                    "text": "我还要去试试！",
                    "response": [
                        {
                            "id": "705580518",
                            "speaker": "米卡",
                            "text": "好的，如果荣誉骑士前辈体验完后感觉还不错，那也是对特雷斯最好的鼓励，麻烦你了！"
                        }
                    ]
                }
            ]
        }
    ]
}