{
    "talkId": "6902208",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "温迪": 15
    },
    "dialogues": [
        {
            "id": "690220801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690220401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690220402",
            "speaker": "温迪",
            "text": "嗯…来举办一场宴会吧！"
        },
        {
            "id": "690220403",
            "speaker": "温迪",
            "text": "叫上和你关系要好的朋友，我也贡献出我珍藏的最棒的酒。"
        },
        {
            "id": "690220404",
            "speaker": "温迪",
            "text": "地点的话…"
        },
        {
            "id": "690220405",
            "speaker": "温迪",
            "text": "干脆就在这里办吧，找一片空地，装饰上长椅、围廊和漂亮的鲜花！",
            "choices": [
                {
                    "id": "690220406",
                    "text": "那么…庆祝的主题呢？",
                    "response": [
                        {
                            "id": "690220407",
                            "speaker": "温迪",
                            "text": "欸…还需要主题吗？那你等我现想一个哦。"
                        },
                        {
                            "id": "690220408",
                            "speaker": "温迪",
                            "text": "「干杯——」「砰——」…有了！「祝幸福」，怎么样怎么样？"
                        },
                        {
                            "id": "690220412",
                            "speaker": "温迪",
                            "text": "哦，对了！能再麻烦你准备一个拿手菜吗？"
                        },
                        {
                            "id": "690220413",
                            "speaker": "温迪",
                            "text": "什么都行，我喜欢吃你做的菜！",
                            "choices": [
                                {
                                    "id": "690220414",
                                    "text": "嗯，感觉会很开心。",
                                    "response": [
                                        {
                                            "id": "690220415",
                                            "speaker": "温迪",
                                            "text": "对吧对吧，一定会很热闹。"
                                        },
                                        {
                                            "id": "690220420",
                                            "speaker": "温迪",
                                            "text": "好，那就算正式开始筹办了！"
                                        },
                                        {
                                            "id": "690220421",
                                            "speaker": "温迪",
                                            "text": "真是个开心的日子…今天也值得喝一杯来庆祝呢。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690220416",
                                    "text": "嗯…感觉场面会很混乱。",
                                    "response": [
                                        {
                                            "id": "690220417",
                                            "speaker": "温迪",
                                            "text": "嘿嘿…「乱」中作乐，也是宴会的特色嘛。"
                                        },
                                        {
                                            "id": "690220418",
                                            "speaker": "温迪",
                                            "text": "放心吧，我会安排好的。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690220419",
                                    "text": "我也会出力的。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690220409",
                    "text": "温迪会表演节目吗？",
                    "response": [
                        {
                            "id": "690220410",
                            "speaker": "温迪",
                            "text": "可以啊，那我就久违地来一个组曲连唱吧！"
                        },
                        {
                            "id": "690220411",
                            "speaker": "温迪",
                            "text": "你有什么想听的歌吗？我可以预先练习一下，当然，这用不了多久。"
                        }
                    ]
                }
            ]
        }
    ]
}