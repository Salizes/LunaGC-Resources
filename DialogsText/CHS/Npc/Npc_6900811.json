{
    "talkId": "6900811",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "夜兰": 12
    },
    "dialogues": [
        {
            "id": "690080401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690080402",
            "speaker": "夜兰",
            "text": "现在是你的休息时间吧？那就做一些不那么费脑力的事情好了。"
        },
        {
            "id": "690080403",
            "speaker": "夜兰",
            "text": "啊，口袋里正好装着骰子，不如来玩个小游戏吧。"
        },
        {
            "id": "690080404",
            "speaker": "夜兰",
            "text": "我投骰子，根据点数来决定接下来的倾诉者。",
            "choices": [
                {
                    "id": "690080405",
                    "text": "点数？",
                    "response": [
                        {
                            "id": "690080407",
                            "speaker": "夜兰",
                            "text": "如果投出一三五，就由你来扮演「倾诉者」，要告诉我一个…绝不能被第三人知道的秘密。"
                        },
                        {
                            "id": "690080408",
                            "speaker": "夜兰",
                            "text": "如果是二四六，就由我来坦白相同分量的秘密，如何？",
                            "choices": [
                                {
                                    "id": "690080409",
                                    "text": "感觉有点危险…",
                                    "response": [
                                        {
                                            "id": "690080410",
                                            "speaker": "夜兰",
                                            "text": "看来你对我还有所保留呢。"
                                        },
                                        {
                                            "id": "690080411",
                                            "speaker": "夜兰",
                                            "text": "不过，合格了。在哪怕重要的合作伙伴面前也留了一线，我反而对你更放心了。"
                                        },
                                        {
                                            "id": "690080412",
                                            "speaker": "夜兰",
                                            "text": "有朝一日，说不定你也会成为很出色的情报人员呢。我会期待和你过招的。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690080413",
                                    "text": "那就试试看吧！",
                                    "response": [
                                        {
                                            "id": "690080414",
                                            "speaker": "夜兰",
                                            "text": "哦？明明这个游戏有一半的概率只亏不赢，你仍然愿意进行吗？"
                                        },
                                        {
                                            "id": "690080415",
                                            "speaker": "夜兰",
                                            "text": "还是说，为了掌握我的秘密，你不惜投入这份赌注呢？"
                                        },
                                        {
                                            "id": "690080416",
                                            "speaker": "夜兰",
                                            "text": "有意思。本来还想暗中动点小机关的，现在连我也期待起来了。"
                                        },
                                        {
                                            "id": "690080417",
                                            "speaker": "夜兰",
                                            "text": "呵呵…那就赶快开始第一轮吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690080406",
                    "text": "倾诉者？"
                }
            ]
        }
    ]
}