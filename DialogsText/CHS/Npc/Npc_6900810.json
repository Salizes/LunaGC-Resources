{
    "talkId": "6900810",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "夜兰": 13
    },
    "dialogues": [
        {
            "id": "690080301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690080302",
            "speaker": "夜兰",
            "text": "当然可以。"
        },
        {
            "id": "690080303",
            "speaker": "夜兰",
            "text": "沏一壶好茶，边品茶边聊天，享受幽静的时光，也是恢复精力的好办法啊。"
        },
        {
            "id": "690080304",
            "speaker": "夜兰",
            "text": "对了，与你关系很好的那位「销虹霁雨真君」也很喜欢品茶。不如用她珍藏的好茶来招待我，怎么样？",
            "choices": [
                {
                    "id": "690080305",
                    "text": "不要欺负阿圆…",
                    "response": [
                        {
                            "id": "690080307",
                            "speaker": "夜兰",
                            "text": "呵呵，开个玩笑。她已经请我喝过了，我们还聊得挺投机的。"
                        },
                        {
                            "id": "690080308",
                            "speaker": "夜兰",
                            "text": "想要聊天进展顺利，重点在于话题的选择。"
                        },
                        {
                            "id": "690080309",
                            "speaker": "夜兰",
                            "text": "跟你的话…不如就来谈谈追踪目标的技巧，设伏的要点，发展线人和布设眼哨的原则。",
                            "choices": [
                                {
                                    "id": "690080310",
                                    "text": "好专业…",
                                    "response": [
                                        {
                                            "id": "690080312",
                                            "speaker": "夜兰",
                                            "text": "呵呵，如果你是想找我聊些无关痛痒的话题，我也能够奉陪。"
                                        },
                                        {
                                            "id": "690080313",
                                            "speaker": "夜兰",
                                            "text": "你懂的，角色扮演算我的强项。"
                                        },
                                        {
                                            "id": "690080314",
                                            "speaker": "夜兰",
                                            "text": "…但在我看来，真正值得与你分享的，还要算那些话题。"
                                        },
                                        {
                                            "id": "690080315",
                                            "speaker": "夜兰",
                                            "text": "我的心得结合了千岩军斥候的秘法、商界交锋的实例，还有不少外国组织的经验。"
                                        },
                                        {
                                            "id": "690080316",
                                            "speaker": "夜兰",
                                            "text": "对于你而言，这些知识迟早能派上用场。"
                                        },
                                        {
                                            "id": "690080317",
                                            "speaker": "夜兰",
                                            "text": "学会之后，也就不会被懂行的人欺负了。"
                                        },
                                        {
                                            "id": "690080318",
                                            "speaker": "夜兰",
                                            "text": "总之，想要在这些方面有所精进的时候，记得来找我。我会好好教导你的。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690080311",
                                    "text": "好正式…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690080306",
                    "text": "你自己去提升信任度嘛…"
                }
            ]
        }
    ]
}