{
    "talkId": "41603",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 4,
        "艾尔菲": 17
    },
    "dialogues": [
        {
            "id": "4015146920",
            "speaker": "Player",
            "text": "想了解些事情。"
        },
        {
            "id": "4015146921",
            "speaker": "艾尔菲",
            "text": "那就尽管问吧，为协会成员解答疑惑也是情报部的职责呀，嘿嘿。",
            "choices": [
                {
                    "id": "4015146904",
                    "text": "关于冒险家协会。",
                    "response": [
                        {
                            "id": "4015146908",
                            "speaker": "艾尔菲",
                            "text": "向着星辰与深渊~！"
                        },
                        {
                            "id": "4015146909",
                            "speaker": "艾尔菲",
                            "text": "大体上就是喜欢冒险的朋友们的聚集地啦，帮助民众或者组织解决各种麻烦。"
                        },
                        {
                            "id": "4015146910",
                            "speaker": "艾尔菲",
                            "text": "当然冒险家也是要吃饭的嘛，完成各种「委托」还会有奖励拿哦。"
                        },
                        {
                            "id": "4015146911",
                            "speaker": "艾尔菲",
                            "text": "前台接待是凯瑟琳小姐负责哦。"
                        },
                        {
                            "id": "4015146912",
                            "speaker": "艾尔菲",
                            "text": "既然你感兴趣，请一定要过去看看~！"
                        }
                    ]
                },
                {
                    "id": "4015146905",
                    "text": "关于你自己…",
                    "response": [
                        {
                            "id": "4015146913",
                            "speaker": "艾尔菲",
                            "text": "我吗？没什么大不了的啦。"
                        },
                        {
                            "id": "4015146914",
                            "speaker": "艾尔菲",
                            "text": "硬要说的话，大概就是…全提瓦特没有我不认识的人吧。"
                        },
                        {
                            "id": "4015146915",
                            "speaker": "艾尔菲",
                            "text": "哦？这很了不起吗…其实还是依靠冒险家协会情报部的资源。"
                        },
                        {
                            "id": "4015146916",
                            "speaker": "艾尔菲",
                            "text": "顺便我也是情报部的成员，除了帮忙联络和引导的工作外，时刻竖起耳朵收集情报也是我的任务哦。"
                        },
                        {
                            "id": "4015146917",
                            "speaker": "艾尔菲",
                            "text": "你看我们已经聊了这么多，我们可以说是朋友了吧？"
                        },
                        {
                            "id": "4015146918",
                            "speaker": "艾尔菲",
                            "text": "来来，快讲讲你的事情给我听吧！"
                        }
                    ]
                },
                {
                    "id": "4015146922",
                    "text": "关于情报部…",
                    "response": [
                        {
                            "id": "4015146923",
                            "speaker": "艾尔菲",
                            "text": "情报部的大多数情况都不会直接参与委托，而是通过提供情报的方式来支援执行委托的冒险家。"
                        },
                        {
                            "id": "4015146924",
                            "speaker": "艾尔菲",
                            "text": "简单来说，我们情报部的运作可以分为「收集」和「整理」两个部分。"
                        },
                        {
                            "id": "4015146925",
                            "speaker": "艾尔菲",
                            "text": "收集情报主要由被称为「调查员」的外勤人员来负责，例如菲谢尔，她就是一位极为优秀的调查员。"
                        },
                        {
                            "id": "4015146926",
                            "speaker": "艾尔菲",
                            "text": "而像我这样在后方工作的人则负责将收集到的情报整理好，再提供给冒险家们…"
                        },
                        {
                            "id": "4015146927",
                            "speaker": "艾尔菲",
                            "text": "所以说冒险家们的成功，和我们情报部背后的努力是脱不开关系的。"
                        }
                    ]
                }
            ]
        }
    ]
}