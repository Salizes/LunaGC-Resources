{
    "talkId": "7512409",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "容韦勒": 7
    },
    "dialogues": [
        {
            "id": "751240901",
            "speaker": "容韦勒",
            "text": "唔…如果是这样的角度，浮流鸟…啊，怎么了，有什么事吗？",
            "choices": [
                {
                    "id": "751240902",
                    "text": "还在进行拍摄吗？",
                    "response": [
                        {
                            "id": "751240903",
                            "speaker": "容韦勒",
                            "text": "嗯，虽然已经拍摄到了想要的画片，但是从枫丹来纳塔，一来一回的旅费可不容易…"
                        },
                        {
                            "id": "751240904",
                            "speaker": "容韦勒",
                            "text": "不如多拍几张为妙！"
                        }
                    ]
                },
                {
                    "id": "751240905",
                    "text": "喜欢浮流鸟的什么地方呢？",
                    "response": [
                        {
                            "id": "751240906",
                            "speaker": "容韦勒",
                            "text": "啊，浮流鸟受到喜爱的地方有很多，有人喜欢它的脚掌，有人喜欢它的羽冠…"
                        },
                        {
                            "id": "751240907",
                            "speaker": "容韦勒",
                            "text": "不过，要我说啊，浮流鸟最吸引人的，我最喜欢的，其实是浮流鸟刚出水时，羽毛在阳光下漉漉发亮的样子。"
                        },
                        {
                            "id": "751240908",
                            "speaker": "容韦勒",
                            "text": "那个时候羽毛看上去真的好摸极了…"
                        }
                    ]
                },
                {
                    "id": "751240909",
                    "text": "没什么事，再见。",
                    "response": [
                        {
                            "id": "751240910",
                            "speaker": "容韦勒",
                            "text": "再见！"
                        }
                    ]
                }
            ]
        }
    ]
}