    "dialogues": [
        {
            "id": "674210201",
            "speaker": "Player",
            "text": "你在干什么？"
        },
        {
            "id": "674210202",
            "speaker": "格罗莫夫",
            "text": "…喔，天哪，您吓了我一跳，客人。"
        },
        {
            "id": "674210203",
            "speaker": "格罗莫夫",
            "text": "我、我在想菜单上的一道菜要怎么做，我…我之前只是个学徒，不过最近带我的老师傅因为腰痛休息了…"
        },
        {
            "id": "674210204",
            "speaker": "格罗莫夫",
            "text": "说不定之后酒店里大菜的活会交给我，我得认真想一遍这道菜的所有细节，等到开工的时候，才不会手忙脚乱…"
        }
    ]
}