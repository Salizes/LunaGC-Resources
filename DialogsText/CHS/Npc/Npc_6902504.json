{
    "talkId": "6902504",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 6,
        "行秋": 8
    },
    "dialogues": [
        {
            "id": "690250401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690250402",
            "speaker": "行秋",
            "text": "嗯，我想请你评点评点…我写的短篇小说。",
            "choices": [
                {
                    "id": "690250403",
                    "text": "是我们的那些故事吗？",
                    "response": [
                        {
                            "id": "690250404",
                            "speaker": "行秋",
                            "text": "看来你变机灵了不少，的确受益于我的熏陶啊。"
                        },
                        {
                            "id": "690250409",
                            "speaker": "行秋",
                            "text": "咳咳…古语有云：「士别三日，当刮目相待。」"
                        },
                        {
                            "id": "690250410",
                            "speaker": "行秋",
                            "text": "我…我也不跟你多费什么口舌。你慢慢看便是了。"
                        },
                        {
                            "id": "690250411",
                            "speaker": "Player",
                            "text": "看得出行秋很用心。"
                        },
                        {
                            "id": "690250412",
                            "speaker": "Player",
                            "text": "我会把它带在身边的。"
                        },
                        {
                            "id": "690250413",
                            "speaker": "行秋",
                            "text": "好啦，我们俩都什么关系了，别说这种肉麻话了。"
                        },
                        {
                            "id": "690250414",
                            "speaker": "行秋",
                            "text": "记得发表感想。有了你的意见，之后的续作应该也会更加精彩吧。"
                        }
                    ]
                },
                {
                    "id": "690250405",
                    "text": "之前你不还支支吾吾的么…",
                    "response": [
                        {
                            "id": "690250406",
                            "speaker": "行秋",
                            "text": "之前是之前…现在是现在…"
                        },
                        {
                            "id": "690250407",
                            "speaker": "行秋",
                            "text": "毕竟这个故事有你的一份。"
                        },
                        {
                            "id": "690250408",
                            "speaker": "Player",
                            "text": "乍一看字倒是进步了不少…"
                        }
                    ]
                }
            ]
        }
    ]
}