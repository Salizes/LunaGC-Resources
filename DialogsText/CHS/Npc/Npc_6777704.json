    "dialogues": [
        {
            "id": "677770401",
            "speaker": "Player",
            "text": "他怎么了？"
        },
        {
            "id": "677770402",
            "speaker": "瓦柳希娜",
            "text": "想要一醉解千愁，却又担心自己酒后失态；想要纵心享乐，却又惦记着许多东西。"
        },
        {
            "id": "677770403",
            "speaker": "瓦柳希娜",
            "text": "所以，就只能枫达浇愁愁更愁喽。啊，也可能是牛奶浇愁愁更愁，看他自己的选择。"
        }
    ]
}