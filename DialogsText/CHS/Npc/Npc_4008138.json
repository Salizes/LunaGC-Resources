{
    "talkId": "4008138",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "派蒙": 1,
        "雪怪伯": 7
    },
    "dialogues": [
        {
            "id": "400813801",
            "speaker": "雪怪伯",
            "text": "还不错，是个接受磨砺的好地方。",
            "choices": [
                {
                    "id": "400813802",
                    "text": "磨砺？",
                    "response": [
                        {
                            "id": "400813803",
                            "speaker": "雪怪伯",
                            "text": "共同接受磨砺，是和蕈兽们一起变强的正道。"
                        },
                        {
                            "id": "400813804",
                            "speaker": "雪怪伯",
                            "text": "我年轻时，就曾和多地的冒险家组成过队伍，在各地游历，完成了协会的大量委托。"
                        },
                        {
                            "id": "400813805",
                            "speaker": "雪怪伯",
                            "text": "经历各种艰险的挑战和「苦修」后，我们以之前不敢想象的速度变强了，这个道理同样适用于蕈兽的队伍。"
                        },
                        {
                            "id": "400813806",
                            "speaker": "雪怪伯",
                            "text": "主办方划定的这个训练的场地，用来磨砺蕈兽的队伍，实在是太合了。"
                        },
                        {
                            "id": "400813807",
                            "speaker": "雪怪伯",
                            "text": "虽然里边的敌人来历不明…但这种事情，不用我们这些参赛者搞得太清楚。"
                        },
                        {
                            "id": "400813808",
                            "speaker": "派蒙",
                            "text": "唔，这个人考虑的事情还挺多呢，看来是个慎重的选手，但也不缺少热情！"
                        }
                    ]
                },
                {
                    "id": "400813809",
                    "text": "打扰了…",
                    "response": [
                        {
                            "id": "400813810",
                            "speaker": "雪怪伯",
                            "text": "没事，大家都是参赛选手，互相认识一下也不错。"
                        }
                    ]
                }
            ]
        }
    ]
}