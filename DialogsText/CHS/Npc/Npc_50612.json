    "dialogues": [
        {
            "id": "5061201",
            "speaker": "留言",
            "text": "「此前拜见了神里笔头奉行绫人大人，没想到其人竟如此年轻。」"
        },
        {
            "id": "5061202",
            "speaker": "留言",
            "text": "「相比其妹绫华公主更加坚毅稳重，神里家有此家主，前程不可限量…」"
        },
        {
            "id": "5061203",
            "speaker": "回复",
            "text": "「感谢谬赞家兄。」"
        }
    ]
}