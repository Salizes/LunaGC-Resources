    "dialogues": [
        {
            "id": "670200401",
            "speaker": "Player",
            "text": "不该进来的人？"
        },
        {
            "id": "670200402",
            "speaker": "蒂昂日",
            "text": "啊？我、我就是打个比方！"
        },
        {
            "id": "670200403",
            "speaker": "蒂昂日",
            "text": "比如…走私客？或者别的什么…违反规定的人？谁知道呢！反正肯定不是我！你看我这样子像坏人吗？！"
        },
        {
            "id": "670200404",
            "speaker": "蒂昂日",
            "text": "我这种只想本本分分过日子的普通水手，办个入境都这么费劲，真不知道他们在防什么…"
        }
    ]
}