{
    "talkId": "6903608",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "重云": 14
    },
    "dialogues": [
        {
            "id": "690360801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690360401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690360402",
            "speaker": "重云",
            "text": "嗯，我想邀请你…一起吃鸳鸯锅。"
        },
        {
            "id": "690360403",
            "speaker": "重云",
            "text": "你知道，因为我体质的缘故，所有食物都要等到凉透之后才能下口。"
        },
        {
            "id": "690360404",
            "speaker": "重云",
            "text": "没法和你在同一时间吃饭…对我来说一直是个遗憾。"
        },
        {
            "id": "690360405",
            "speaker": "重云",
            "text": "我冥思苦想，终于想出了鸳鸯锅这种吃法。"
        },
        {
            "id": "690360406",
            "speaker": "重云",
            "text": "在热气腾腾的璃月火锅基础上，用一块隔板将两边汤底隔开。"
        },
        {
            "id": "690360407",
            "speaker": "重云",
            "text": "这样即使你想吃绝云椒椒做的汤底，我也可以尽情享用清淡的那一边。"
        },
        {
            "id": "690360408",
            "speaker": "重云",
            "text": "而且，火锅食材通常都是薄片。吃之前只要在盛满冰水的碗中浸泡片刻，就能迅速降温了。",
            "choices": [
                {
                    "id": "690360409",
                    "text": "好啊，听上去会很开心。",
                    "response": [
                        {
                            "id": "690360410",
                            "speaker": "重云",
                            "text": "你…你这就已经答应了。"
                        },
                        {
                            "id": "690360411",
                            "speaker": "重云",
                            "text": "也…也就是说，马上就能实现了…"
                        },
                        {
                            "id": "690360415",
                            "speaker": "重云",
                            "text": "唔…"
                        },
                        {
                            "id": "690360416",
                            "speaker": "Player",
                            "text": "你脸好红…"
                        },
                        {
                            "id": "690360417",
                            "speaker": "重云",
                            "text": "我…我没事。我只是…"
                        },
                        {
                            "id": "690360418",
                            "speaker": "重云",
                            "text": "比我想象中还顺利。让我有点开心过头了…等一下就好了…"
                        }
                    ]
                },
                {
                    "id": "690360412",
                    "text": "我来陪重云吃清汤的也行。",
                    "response": [
                        {
                            "id": "690360413",
                            "speaker": "重云",
                            "text": "欸…欸！"
                        },
                        {
                            "id": "690360414",
                            "speaker": "重云",
                            "text": "同…同一个锅子里煮出来的…"
                        }
                    ]
                }
            ]
        }
    ]
}