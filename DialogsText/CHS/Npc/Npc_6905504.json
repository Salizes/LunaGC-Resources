{
    "talkId": "6905504",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "五郎": 15
    },
    "dialogues": [
        {
            "id": "690550401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690550402",
            "speaker": "五郎",
            "text": "嗯！我听管家阿圆说，她能依照你的想法改变这里的地形。"
        },
        {
            "id": "690550403",
            "speaker": "五郎",
            "text": "能不能请你搭建出高耸的山体呢？最好险峻一些，让攀登起来有足够的难度。"
        },
        {
            "id": "690550404",
            "speaker": "五郎",
            "text": "然后，我们一起向顶峰发起挑战吧！"
        },
        {
            "id": "690550405",
            "speaker": "Player",
            "text": "没问题。"
        },
        {
            "id": "690550406",
            "speaker": "五郎",
            "text": "答应得好爽快！谢谢你！"
        },
        {
            "id": "690550407",
            "speaker": "五郎",
            "text": "以前，我经常和反抗军的同伴们一起登山。大家边流汗，边谈笑，是我十分宝贵的回忆与财富。"
        },
        {
            "id": "690550408",
            "speaker": "五郎",
            "text": "我总有一种「直觉」。和你一起登山，会比和其他任何人登山都开心。"
        },
        {
            "id": "690550409",
            "speaker": "五郎",
            "text": "我也想要…和你分享每一个我觉得开心的时刻。",
            "choices": [
                {
                    "id": "690550410",
                    "text": "我明白了。",
                    "response": [
                        {
                            "id": "690550412",
                            "speaker": "五郎",
                            "text": "嗯。对了…我们再选一段相对比较安全的山路，比试登山速度，如何！"
                        },
                        {
                            "id": "690550413",
                            "speaker": "五郎",
                            "text": "输了的人就请对方吃大餐，吃甜点…",
                            "choices": [
                                {
                                    "id": "690550414",
                                    "text": "想要摸摸尾巴…",
                                    "response": [
                                        {
                                            "id": "690550415",
                                            "speaker": "五郎",
                                            "text": "欸？好奇怪的心愿…"
                                        },
                                        {
                                            "id": "690550416",
                                            "speaker": "五郎",
                                            "text": "但…没问题，我答应你！"
                                        },
                                        {
                                            "id": "690550419",
                                            "speaker": "五郎",
                                            "text": "我…我…好吧，我知道了！"
                                        },
                                        {
                                            "id": "690550420",
                                            "speaker": "五郎",
                                            "text": "为了尾巴…我会拿出全力的！但事先说好，要赢过我可不容易。"
                                        },
                                        {
                                            "id": "690550421",
                                            "speaker": "五郎",
                                            "text": "我们就提前一点…开始热身吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690550417",
                                    "text": "想要枕着尾巴睡觉…",
                                    "response": [
                                        {
                                            "id": "690550418",
                                            "speaker": "五郎",
                                            "text": "欸？！尾巴…睡觉…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690550411",
                    "text": "五郎，也谢谢你。"
                }
            ]
        }
    ]
}