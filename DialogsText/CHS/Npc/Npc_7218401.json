{
    "talkId": "7218401",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 3,
        "木南杏奈": 15
    },
    "dialogues": [
        {
            "id": "721840101",
            "speaker": "木南杏奈",
            "text": "唉，这可怎么办呢…"
        },
        {
            "id": "721840102",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "721840103",
            "speaker": "木南杏奈",
            "text": "旅行者？太好了，你来得正好！"
        },
        {
            "id": "721840104",
            "speaker": "木南杏奈",
            "text": "你还记得上次，你和神里小姐来我店里的时候，你写给我的那道食谱吗？"
        },
        {
            "id": "721840105",
            "speaker": "木南杏奈",
            "text": "哎呀，那道披萨可受欢迎了，好多客人都专门来店里点那道披萨吃呢。"
        },
        {
            "id": "721840106",
            "speaker": "木南杏奈",
            "text": "但是…有些客人也说，总是吃这一种披萨感觉有点腻了，问我有没有其他味道的披萨。"
        },
        {
            "id": "721840107",
            "speaker": "木南杏奈",
            "text": "虽然我自己也根据客人们的反馈尝试过几种新做法…"
        },
        {
            "id": "721840108",
            "speaker": "木南杏奈",
            "text": "但总觉得…差那么点味道，客人们的反响也不太好。"
        },
        {
            "id": "721840109",
            "speaker": "木南杏奈",
            "text": "唉，也许我真的不太会做「披萨」这种菜吧…"
        },
        {
            "id": "721840110",
            "speaker": "木南杏奈",
            "text": "旅行者，你应该很懂这种菜吧？你能帮我再拿拿主意吗？",
            "choices": [
                {
                    "id": "721840111",
                    "text": "没问题。",
                    "response": [
                        {
                            "id": "721840112",
                            "speaker": "木南杏奈",
                            "text": "太好了！对了，我也搜集了客人们的反馈，我找一下，你稍等。"
                        },
                        {
                            "id": "721840116",
                            "speaker": "木南杏奈",
                            "text": "这位梨绘小姐说，这份披萨的味道虽然还不错…"
                        },
                        {
                            "id": "721840117",
                            "speaker": "木南杏奈",
                            "text": "但她觉得，如果这道披萨能融合一些稻妻本土的食材，味道一定会更好。"
                        },
                        {
                            "id": "721840118",
                            "speaker": "木南杏奈",
                            "text": "也不知道，她想融合的是哪些食材…旅行者，你就先去问问她吧。"
                        }
                    ]
                },
                {
                    "id": "721840113",
                    "text": "关于客人的反馈…",
                    "response": [
                        {
                            "id": "721840114",
                            "speaker": "木南杏奈",
                            "text": "你想看看客人们的反馈吗？"
                        },
                        {
                            "id": "721840115",
                            "speaker": "木南杏奈",
                            "text": "我找一下，你稍等。"
                        }
                    ]
                }
            ]
        }
    ]
}