        {
            "id": "670710201",
            "speaker": "Player",
            "text": "怎么说？"
        },
        {
            "id": "670710202",
            "speaker": "库丹科娃",
            "text": "在工作方面能给我提供不少帮助呢。不过这个一点也不重要，最重要的当然是——情绪价值！"
        },
        {
            "id": "670710203",
            "speaker": "库丹科娃",
            "text": "和它们一起工作就能缓解工作的痛苦…而跟它们一起游戏就更棒啦！"
        }
