{
    "talkId": "6907203",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "坎蒂丝": 11
    },
    "dialogues": [
        {
            "id": "690720301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690720302",
            "speaker": "坎蒂丝",
            "text": "好啊，不过，要聊些什么呢…"
        },
        {
            "id": "690720303",
            "speaker": "坎蒂丝",
            "text": "啊，如果不麻烦的话，能跟我说说你曾经路过的那些地方吗？随意选取一个就好。",
            "choices": [
                {
                    "id": "690720304",
                    "text": "关于蒙德的风景与人文…",
                    "response": [
                        {
                            "id": "690720305",
                            "speaker": "坎蒂丝",
                            "text": "如茵的绿草，讴歌自由的城邦…"
                        },
                        {
                            "id": "690720310",
                            "speaker": "坎蒂丝",
                            "text": "真想亲眼看一下啊。"
                        },
                        {
                            "id": "690720311",
                            "speaker": "坎蒂丝",
                            "text": "我从小到大都在沙漠里生活，连防沙壁另一侧都未去过几次。"
                        },
                        {
                            "id": "690720312",
                            "speaker": "坎蒂丝",
                            "text": "听你分享那么遥远的地方的事，不免也有些神往。"
                        },
                        {
                            "id": "690720313",
                            "speaker": "Player",
                            "text": "那坎蒂丝也来旅行吧！"
                        },
                        {
                            "id": "690720314",
                            "speaker": "坎蒂丝",
                            "text": "嗯，真是诱人的提案，但我还有守护阿如村的职责在身…"
                        },
                        {
                            "id": "690720315",
                            "speaker": "坎蒂丝",
                            "text": "不过，你的话或许会成为一颗种子。让我去外面看看的想法，在未来的某一天发出枝芽。"
                        },
                        {
                            "id": "690720316",
                            "speaker": "坎蒂丝",
                            "text": "等到那时候，我再去追寻你的脚步吧。"
                        }
                    ]
                },
                {
                    "id": "690720306",
                    "text": "关于璃月的风景与人文…",
                    "response": [
                        {
                            "id": "690720307",
                            "speaker": "坎蒂丝",
                            "text": "遵循贸易与契约的国度，虽然以前就有所耳闻，不过听你描述又有另一番味道。"
                        }
                    ]
                },
                {
                    "id": "690720308",
                    "text": "关于稻妻的风景与人文…",
                    "response": [
                        {
                            "id": "690720309",
                            "speaker": "坎蒂丝",
                            "text": "四处都是茫茫的海水，在岛上建立的城堡么…"
                        }
                    ]
                }
            ]
        }
    ]
}