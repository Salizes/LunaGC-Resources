{
    "talkId": "30903",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "琴": 9
    },
    "dialogues": [
        {
            "id": "3090301",
            "speaker": "琴",
            "text": "真的非常感谢你接受我们的邀请，旅行者。",
            "choices": [
                {
                    "id": "3090302",
                    "text": "有关风魔龙。",
                    "response": [
                        {
                            "id": "3090303",
                            "speaker": "琴",
                            "text": "关于龙的体型和力量的异变，的确有很多疑点…"
                        },
                        {
                            "id": "3090304",
                            "speaker": "琴",
                            "text": "不过，对于骑士团来说，当务之急是平息这次袭击的余波。"
                        },
                        {
                            "id": "3090305",
                            "speaker": "琴",
                            "text": "既然团长离开前将骑士团交给我，我便绝不能辜负团长，和蒙德的人民。"
                        },
                        {
                            "id": "3090306",
                            "speaker": "琴",
                            "text": "一定要弄清楚事情的真相…"
                        }
                    ]
                },
                {
                    "id": "3090307",
                    "text": "进城以前的事。",
                    "response": [
                        {
                            "id": "3090308",
                            "speaker": "琴",
                            "text": "听说侦察骑士安柏之前误会你了。"
                        },
                        {
                            "id": "3090309",
                            "speaker": "琴",
                            "text": "请原谅她吧，她只是在履行自己的职务。"
                        },
                        {
                            "id": "3090310",
                            "speaker": "琴",
                            "text": "啊，可以的话和安柏多多交流吧，她会把她的活力也传递给你的。"
                        }
                    ]
                },
                {
                    "id": "3090311",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "3090312",
                            "speaker": "琴",
                            "text": "#嗯，再次感谢你的帮忙，{NICKNAME}。"
                        }
                    ]
                }
            ]
        }
    ]
}