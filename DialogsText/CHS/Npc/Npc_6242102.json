    "speaker_counts": {
        "Player": 3,
        "宝儿": 6
    },
    "dialogues": [
        {
            "id": "624210201",
            "speaker": "Player",
            "text": "你在做什么？"
        },
        {
            "id": "624210202",
            "speaker": "宝儿",
            "text": "我在踩点…我是说，考古。",
            "choices": [
                {
                    "id": "624210203",
                    "text": "…踩点？",
                    "response": [
                        {
                            "id": "624210204",
                            "speaker": "宝儿",
                            "text": "呃，你听错了，我是个考古学家，正在研究归离原的古代建筑和遗物。"
                        }
                    ]
                },
                {
                    "id": "624210205",
                    "text": "考古？",
                    "response": [
                        {
                            "id": "624210206",
                            "speaker": "宝儿",
                            "text": "嗯，你脚下的这片土地在数千年前曾是魔神混战的战场。"
                        },
                        {
                            "id": "624210207",
                            "speaker": "宝儿",
                            "text": "也就是岩王爷当年过关斩将大杀四方的战场。"
                        },
                        {
                            "id": "624210208",
                            "speaker": "宝儿",
                            "text": "在这片土地之下，一定有无数的宝藏还从未被发掘。"
                        },
                        {
                            "id": "624210209",
                            "speaker": "宝儿",
                            "text": "真想知道这里都埋了什么宝贝啊…"
                        }
                    ]
                }
            ]
        }
    ]
}