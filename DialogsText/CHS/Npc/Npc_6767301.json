{
    "talkId": "6767301",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "瓦加劳": 6
    },
    "dialogues": [
        {
            "id": "676730101",
            "speaker": "瓦加劳",
            "text": "这段时间附近的月矩力异动频繁，一定要小心啊。",
            "choices": [
                {
                    "id": "676730102",
                    "text": "关于之前的獭懒羊…",
                    "response": [
                        {
                            "id": "676730103",
                            "speaker": "瓦加劳",
                            "text": "嗯，我已经顺利把它交给那位先生了。"
                        },
                        {
                            "id": "676730104",
                            "speaker": "瓦加劳",
                            "text": "不过听说没过多久，在那位先生想要将那只獭懒羊带出挪德卡莱的一瞬，它就变成了一颗失去生机的种子。"
                        },
                        {
                            "id": "676730105",
                            "speaker": "瓦加劳",
                            "text": "那位先生想把它带回自己国家的想法也因此落空。"
                        },
                        {
                            "id": "676730106",
                            "speaker": "瓦加劳",
                            "text": "要是他一开始能听进我的话，或许就不会以这样的结局收场了吧…"
                        }
                    ]
                },
                {
                    "id": "676730107",
                    "text": "没事。",
                    "response": [
                        {
                            "id": "676730108",
                            "speaker": "瓦加劳",
                            "text": "好的，请务必注意安全。"
                        }
                    ]
                }
            ]
        }
    ]
}