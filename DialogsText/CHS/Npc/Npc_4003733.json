{
    "talkId": "4003733",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "一柱": 7
    },
    "dialogues": [
        {
            "id": "400373301",
            "speaker": "一柱",
            "text": "你好…你是找我吗？",
            "choices": [
                {
                    "id": "400373302",
                    "text": "你是？",
                    "response": [
                        {
                            "id": "400373303",
                            "speaker": "一柱",
                            "text": "我叫一柱，你可能也见过我妹妹一弦。"
                        },
                        {
                            "id": "400373304",
                            "speaker": "一柱",
                            "text": "我答应过她，今年要一起过海灯节，还要教她为妈妈做一盏霄灯。"
                        },
                        {
                            "id": "400373305",
                            "speaker": "一柱",
                            "text": "我正在准备材料的时候，没想到长顺姐姐特意给我们拿了一些…"
                        },
                        {
                            "id": "400373306",
                            "speaker": "一柱",
                            "text": "所以，我也给长顺姐姐做了一盏霄灯，希望她能喜欢。"
                        },
                        {
                            "id": "400373307",
                            "speaker": "一柱",
                            "text": "最近我们兄妹受到了很多关照，真的很感谢大家。"
                        }
                    ]
                },
                {
                    "id": "400373308",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "400373309",
                            "speaker": "一柱",
                            "text": "再见…愿薪火相传，美德不灭。"
                        }
                    ]
                }
            ]
        }
    ]
}