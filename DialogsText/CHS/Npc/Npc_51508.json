    "dialogues": [
        {
            "id": "5150801",
            "speaker": "寻人启事",
            "text": "寻夫稻叶藤三郎久藏。高大无须，额角有剑疤。自停战以来尚未归家。"
        },
        {
            "id": "5150802",
            "speaker": "寻人启事",
            "text": "望诸位归国武士、故交友人等告知其人下落，或提供线索。必有重谢！"
        },
        {
            "id": "5150803",
            "speaker": "寻人启事",
            "text": "稻叶静子，敬上。"
        }
    ]
}