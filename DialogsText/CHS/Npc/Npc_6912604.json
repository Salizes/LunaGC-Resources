{
    "talkId": "6912604",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "兹白": 8
    },
    "dialogues": [
        {
            "id": "691260401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691260402",
            "speaker": "兹白",
            "text": "如此闲适的地方，最适合做的就是放松身心，神游天外。"
        },
        {
            "id": "691260403",
            "speaker": "兹白",
            "text": "用凡人的话来说，就是…"
        },
        {
            "id": "691260404",
            "speaker": "Player",
            "text": "发呆？"
        },
        {
            "id": "691260405",
            "speaker": "兹白",
            "text": "没错，发呆。"
        },
        {
            "id": "691260406",
            "speaker": "Player",
            "text": "仙人发呆，难道有特殊法门？"
        },
        {
            "id": "691260407",
            "speaker": "兹白",
            "text": "要是特意用仙法催动，那还叫什么「发呆」呢？"
        },
        {
            "id": "691260408",
            "speaker": "兹白",
            "text": "但就是这样看似普通，毫无诀窍的「发呆」，却没有多少人能够做到。"
        },
        {
            "id": "691260409",
            "speaker": "兹白",
            "text": "大多数人就算闭眼屏气，强令自己放松心神，脑海里依旧沸腾翻滚，演出无数幻象…"
        },
        {
            "id": "691260410",
            "speaker": "兹白",
            "text": "睁开眼后，反倒是比闭眼之前更累。"
        },
        {
            "id": "691260411",
            "speaker": "兹白",
            "text": "可能这就是所谓的「一静难求」吧…"
        }
    ]
}