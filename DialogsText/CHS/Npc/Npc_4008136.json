{
    "talkId": "4008136",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "左右加": 7,
        "派蒙": 4
    },
    "dialogues": [
        {
            "id": "400813601",
            "speaker": "左右加",
            "text": "呜…怎么办啊怎么办啊…明明花了那么多时间来准备，结果第二场比赛就被打垮了！",
            "choices": [
                {
                    "id": "400813602",
                    "text": "振作一点…",
                    "response": [
                        {
                            "id": "400813603",
                            "speaker": "派蒙",
                            "text": "别太自责了啦，左右加小姐，神子不会怪你的哦！"
                        },
                        {
                            "id": "400813604",
                            "speaker": "左右加",
                            "text": "你们两位…你们居然还来安慰我，我配得上这种殊荣吗…"
                        },
                        {
                            "id": "400813605",
                            "speaker": "左右加",
                            "text": "不对，等一等！脑袋里突然冒出来好多种展开…精彩的情节自动浮现了出来！"
                        },
                        {
                            "id": "400813606",
                            "speaker": "左右加",
                            "text": "你们先不要说话，让我猜测一下，你们之后的台词会是…"
                        },
                        {
                            "id": "400813607",
                            "speaker": "左右加",
                            "text": "「你的勇气和意志，我已经见识到了！之后就由我们来代你完成夺冠的愿望！」"
                        },
                        {
                            "id": "400813608",
                            "speaker": "Player",
                            "text": "？"
                        },
                        {
                            "id": "400813609",
                            "speaker": "派蒙",
                            "text": "？"
                        },
                        {
                            "id": "400813610",
                            "speaker": "左右加",
                            "text": "好耶，我知道这个地方该怎么写了！配合前期就碰上最强对手的意外，一定很有看点！先牢牢地记在脑袋里吧…"
                        },
                        {
                            "id": "400813611",
                            "speaker": "派蒙",
                            "text": "居然和神子说的完全一致，左右加小姐只是自言自语一会儿，就恢复过来了？"
                        },
                        {
                            "id": "400813612",
                            "speaker": "Player",
                            "text": "我们是不是也该说「好耶」？"
                        },
                        {
                            "id": "400813613",
                            "speaker": "派蒙",
                            "text": "嘘，还是不要打扰左右加小姐了，让她安静地理一理思路！"
                        }
                    ]
                },
                {
                    "id": "400813614",
                    "text": "（悄悄离开）",
                    "response": [
                        {
                            "id": "400813615",
                            "speaker": "左右加",
                            "text": "不过，要是放在小说里，主角刚刚参赛就遭遇重大挫折，反而是出人意料的展开，可以好好摆脱常见的剧情走向…"
                        }
                    ]
                }
            ]
        }
    ]
}