{
    "talkId": "7321910",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "尤夫腾": 13
    },
    "dialogues": [
        {
            "id": "732191001",
            "speaker": "尤夫腾",
            "text": "你好，塔尼特的…客人。"
        },
        {
            "id": "732191002",
            "speaker": "尤夫腾",
            "text": "常听婕、婕、婕德提起你，好孩子。",
            "choices": [
                {
                    "id": "732191003",
                    "text": "你在忙什么？",
                    "response": [
                        {
                            "id": "732191004",
                            "speaker": "尤夫腾",
                            "text": "种地，喂、喂鳄鱼。有时候也做屠、屠、屠夫，鳄鱼的皮和肉，很有用。"
                        },
                        {
                            "id": "732191008",
                            "speaker": "尤夫腾",
                            "text": "因为这、这里有四季不竭的干净泉水，正适合养殖鳄鱼。所、所以我们围起了这里。"
                        },
                        {
                            "id": "732191009",
                            "speaker": "尤夫腾",
                            "text": "鳄鱼好养，而且能收获很多皮和肉。但耕、耕地可就太、太难了…"
                        },
                        {
                            "id": "732191010",
                            "speaker": "Player",
                            "text": "你们还有耕地？"
                        },
                        {
                            "id": "732191011",
                            "speaker": "尤夫腾",
                            "text": "只是…试验田。芭别尔主母她请了些外人来、来、来为我们输送「丰沃之惠」，又从城里搞来许多旧书…"
                        },
                        {
                            "id": "732191012",
                            "speaker": "尤夫腾",
                            "text": "我们就、就、就照着书上写的东西，在这里尝试种地。"
                        },
                        {
                            "id": "732191013",
                            "speaker": "尤夫腾",
                            "text": "但峡谷中的绿洲还是太、太、太狭窄贫瘠了，必须想办法让土地更加肥、肥沃才行。"
                        },
                        {
                            "id": "732191014",
                            "speaker": "Player",
                            "text": "关于「丰沃之惠」…"
                        },
                        {
                            "id": "732191015",
                            "speaker": "尤夫腾",
                            "text": "外人不愿意透露它的配方，所以我们想要让土地肥、肥沃，就必须依赖提供它的人，这不好。"
                        },
                        {
                            "id": "732191016",
                            "speaker": "尤夫腾",
                            "text": "所、所以，芭别尔主母要我在、在这里研究，如何才能反向做、做出我们自己的…「丰沃之惠」。"
                        },
                        {
                            "id": "732191017",
                            "speaker": "Player",
                            "text": "不打扰了。"
                        },
                        {
                            "id": "732191018",
                            "speaker": "尤夫腾",
                            "text": "没、没关系，请随便拿些鳄鱼肉干吧，客人。就在我身边…"
                        }
                    ]
                },
                {
                    "id": "732191005",
                    "text": "哇，鳄鱼！",
                    "response": [
                        {
                            "id": "732191006",
                            "speaker": "尤夫腾",
                            "text": "呵呵，是的。它们都是由我、我在照顾。这几条很肥壮，很听话。"
                        },
                        {
                            "id": "732191007",
                            "speaker": "尤夫腾",
                            "text": "那条叫、叫、叫塞提姆，很凶很强，皮色很鲜艳，会是不错的挎包。还有那条，喀龙，小但肥，性格乖巧。"
                        }
                    ]
                }
            ]
        }
    ]
}