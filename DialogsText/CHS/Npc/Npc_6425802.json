    "dialogues": [
        {
            "id": "642580201",
            "speaker": "Player",
            "text": "关于伊尔凡…"
        },
        {
            "id": "642580202",
            "speaker": "海亚姆",
            "text": "啊，他呀…我们是从小玩大的朋友。他去奥摩斯港做了商人，再后来成家立业，过上了不错的日子…"
        },
        {
            "id": "642580203",
            "speaker": "海亚姆",
            "text": "很久没有和他一起喝酒谈天了…直到前些年他去世，我们也没能见上一面。"
        }
    ]
}