    },
    "dialogues": [
        {
            "id": "699001701",
            "speaker": "Player",
            "text": "关于《碎梦奇珍》…"
        },
        {
            "id": "699001702",
            "speaker": "派蒙",
            "text": "顺时针走七圈，逆时针走七圈，再睁开眼睛…"
        },
        {
            "id": "699001703",
            "speaker": "Player",
            "text": "你在梦游吗？"
        },
        {
            "id": "699001704",
            "speaker": "派蒙",
            "text": "才没有呢！我只是想看看《碎梦奇珍》里的那家古董店，是不是真的存在！",
            "choices": [
                {
                    "id": "699001705",
                    "text": "假如故事里的古董店真的存在…",
                    "response": [
                        {
                            "id": "699001707",
                            "speaker": "派蒙",
                            "text": "史莱姆生成器！"
                        },
                        {
                            "id": "699001708",
                            "speaker": "Player",
                            "text": "真的会存在那种东西吗…"
                        }
                    ]
                },
                {
                    "id": "699001706",
                    "text": "派蒙想要买什么宝物呢？"
                }
            ]
        }
    ]
}