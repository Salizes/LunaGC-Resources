    "dialogues": [
        {
            "id": "643200301",
            "speaker": "Player",
            "text": "鱼不算肉吗？"
        },
        {
            "id": "643200302",
            "speaker": "杰巴里",
            "text": "…意外的答案！"
        },
        {
            "id": "643200303",
            "speaker": "杰巴里",
            "text": "鱼算肉吗？呃，每个人心里的答案应该不一样吧…"
        },
        {
            "id": "643200304",
            "speaker": "杰巴里",
            "text": "不过我的重点不是这个啦，我只是在思考晚饭做什么吃比较好。"
        },
        {
            "id": "643200305",
            "speaker": "杰巴里",
            "text": "话说你肚子饿吗？要吃点什么东西吗？"
        },
        {
            "id": "643200306",
            "speaker": "杰巴里",
            "text": "不是我吹牛，我做饭可好吃了。有空来我家吃饭啊！"
        }
    ]
}