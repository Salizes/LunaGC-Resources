{
    "talkId": "6910009",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "卡齐娜": 14
    },
    "dialogues": [
        {
            "id": "691000401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691000402",
            "speaker": "卡齐娜",
            "text": "我想想哦，嗯…暂时没想到什么特别值得一提的心愿。"
        },
        {
            "id": "691000403",
            "speaker": "卡齐娜",
            "text": "现在的生活让我很满足，简直称得上是「幸福」了。"
        },
        {
            "id": "691000404",
            "speaker": "Player",
            "text": "这回不是逞强？"
        },
        {
            "id": "691000405",
            "speaker": "卡齐娜",
            "text": "嘿嘿，当然不是。我们已经是要好的朋友啦，我知道我骗不过你。"
        },
        {
            "id": "691000406",
            "speaker": "卡齐娜",
            "text": "主要是因为我很喜欢这里。在适应你家的环境之后，我发现它梦幻得像是存在于故事中的世界。"
        },
        {
            "id": "691000407",
            "speaker": "卡齐娜",
            "text": "美丽的风景就不说了，室外还有宽敞到可以乘着冲天转转四处闲逛的超大空间！"
        },
        {
            "id": "691000408",
            "speaker": "卡齐娜",
            "text": "生活节奏舒适安逸，怎么都待不够。"
        },
        {
            "id": "691000409",
            "speaker": "Player",
            "text": "卡齐娜喜欢就好。"
        },
        {
            "id": "691000410",
            "speaker": "卡齐娜",
            "text": "嗯，请收下我双倍认真的感谢，很高兴能收到你的邀请…家人告诉过我，感激的话说多少次都不嫌多的。"
        },
        {
            "id": "691000411",
            "speaker": "卡齐娜",
            "text": "对了，你要不要来我家做客？"
        },
        {
            "id": "691000412",
            "speaker": "卡齐娜",
            "text": "…啊！"
        },
        {
            "id": "691000413",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "691000414",
            "speaker": "卡齐娜",
            "text": "没…没什么，刚刚突然想起来房间里面堆了好多好多东西。但在你来之前，我一定会把它们收好的。"
        },
        {
            "id": "691000415",
            "speaker": "卡齐娜",
            "text": "床底下的箱子还有几个…最上层的柜子也空着…嗯，应该够放。",
            "choices": [
                {
                    "id": "691000416",
                    "text": "不费心收拾也没关系。",
                    "response": [
                        {
                            "id": "691000418",
                            "speaker": "卡齐娜",
                            "text": "呜…谢谢你能这么说！我…我心里好像一下子鼓满了勇气。"
                        },
                        {
                            "id": "691000419",
                            "speaker": "Player",
                            "text": "放心吧。"
                        },
                        {
                            "id": "691000420",
                            "speaker": "卡齐娜",
                            "text": "嘿嘿，那就说好了哦？我会细心安放好每块石头的位置，等你来的！"
                        },
                        {
                            "id": "691000421",
                            "speaker": "卡齐娜",
                            "text": "我保证！就算拥挤，也会是最好看的拥挤。"
                        }
                    ]
                },
                {
                    "id": "691000417",
                    "text": "拥挤感也是一种特色。"
                }
            ]
        }
    ]
}