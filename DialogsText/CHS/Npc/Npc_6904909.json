{
    "talkId": "6904909",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 4,
        "宵宫": 21
    },
    "dialogues": [
        {
            "id": "690490901",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690490402",
            "speaker": "宵宫",
            "text": "想了解更多关于你的事——！"
        },
        {
            "id": "690490403",
            "speaker": "宵宫",
            "text": "和你一起冒险了这么长的时间，我也从很多地方听说了你的故事。"
        },
        {
            "id": "690490404",
            "speaker": "宵宫",
            "text": "但是越听就越好奇，到底是什么让你这么与众不同呢？"
        },
        {
            "id": "690490405",
            "speaker": "宵宫",
            "text": "总是有个原因的吧，比如我喜欢说话，是因为小时候以为老爹特别喜欢听我说话。"
        },
        {
            "id": "690490406",
            "speaker": "宵宫",
            "text": "我喜欢烟花，是因为制作烟花这件事让我由衷自豪。"
        },
        {
            "id": "690490407",
            "speaker": "宵宫",
            "text": "而你又是为什么呢？",
            "choices": [
                {
                    "id": "690490408",
                    "text": "有想要见到的人。",
                    "response": [
                        {
                            "id": "690490409",
                            "speaker": "宵宫",
                            "text": "原来这就是你的动力啊。"
                        },
                        {
                            "id": "690490410",
                            "speaker": "宵宫",
                            "text": "#「不希望重逢的时候让{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}失望」，对吧？"
                        },
                        {
                            "id": "690490411",
                            "speaker": "宵宫",
                            "text": "唔，真的很佩服，而且，很羡慕！"
                        },
                        {
                            "id": "690490412",
                            "speaker": "宵宫",
                            "text": "我会帮助你的，不管走到什么地方，是天上还是地下，你们一定要相见啊！"
                        },
                        {
                            "id": "690490419",
                            "speaker": "宵宫",
                            "text": "嘿嘿，不好意思，稍微有点激动了。"
                        },
                        {
                            "id": "690490420",
                            "speaker": "宵宫",
                            "text": "不过，我已经决定了，那就是，我想重走你走过的路！"
                        },
                        {
                            "id": "690490421",
                            "speaker": "宵宫",
                            "text": "从蒙德开始，再到璃月，再到稻妻…看你看过的风景，见你见过的人和事。"
                        },
                        {
                            "id": "690490422",
                            "speaker": "宵宫",
                            "text": "想要彻底地了解一个人，就应该这样做嘛！"
                        },
                        {
                            "id": "690490423",
                            "speaker": "Player",
                            "text": "有点太隆重了。"
                        },
                        {
                            "id": "690490424",
                            "speaker": "宵宫",
                            "text": "啊，我没有想让你产生压力的意思，只是，嗯…怎么说呢，是很纯粹的…"
                        },
                        {
                            "id": "690490425",
                            "speaker": "宵宫",
                            "text": "想了解更多关于你的事——！"
                        }
                    ]
                },
                {
                    "id": "690490413",
                    "text": "有想要帮助的人。",
                    "response": [
                        {
                            "id": "690490414",
                            "speaker": "宵宫",
                            "text": "原来这就是你的动力啊。"
                        },
                        {
                            "id": "690490415",
                            "speaker": "宵宫",
                            "text": "「不想看到任何人经历不幸」，对吧？"
                        },
                        {
                            "id": "690490416",
                            "speaker": "宵宫",
                            "text": "像故事书里的英雄一样，太帅了。"
                        },
                        {
                            "id": "690490417",
                            "speaker": "宵宫",
                            "text": "欸？那我就是英雄的同伴了吧？"
                        },
                        {
                            "id": "690490418",
                            "speaker": "宵宫",
                            "text": "我会全力辅助你的，加油，去书写你的故事吧！"
                        }
                    ]
                }
            ]
        }
    ]
}