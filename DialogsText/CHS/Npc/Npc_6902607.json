{
    "talkId": "6902607",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "魈": 15
    },
    "dialogues": [
        {
            "id": "690260701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690260301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690260302",
            "speaker": "魈",
            "text": "…闲聊吗？"
        },
        {
            "id": "690260303",
            "speaker": "魈",
            "text": "…既然你想，我陪你便是。",
            "choices": [
                {
                    "id": "690260304",
                    "text": "我还以为你会拒绝呢。",
                    "response": [
                        {
                            "id": "690260305",
                            "speaker": "魈",
                            "text": "嗯？"
                        },
                        {
                            "id": "690260306",
                            "speaker": "魈",
                            "text": "提出要求却做好了被拒绝的准备…"
                        },
                        {
                            "id": "690260307",
                            "speaker": "魈",
                            "text": "人类的交往，真是麻烦。"
                        },
                        {
                            "id": "690260311",
                            "speaker": "魈",
                            "text": "一般来说，我不会参与「聊天」这种活动。"
                        },
                        {
                            "id": "690260312",
                            "speaker": "魈",
                            "text": "但对象是你的话…姑且可以一试。"
                        },
                        {
                            "id": "690260313",
                            "speaker": "Player",
                            "text": "魈最近还好吗？"
                        },
                        {
                            "id": "690260314",
                            "speaker": "魈",
                            "text": "你是在问…「业障」的影响吗？"
                        },
                        {
                            "id": "690260315",
                            "speaker": "魈",
                            "text": "无碍。"
                        },
                        {
                            "id": "690260316",
                            "speaker": "魈",
                            "text": "既然因我而起，我独自承受便是。"
                        },
                        {
                            "id": "690260317",
                            "speaker": "魈",
                            "text": "…不知是否与你有关，最近，蚀骨之痛已不再难以忍受。"
                        },
                        {
                            "id": "690260318",
                            "speaker": "魈",
                            "text": "比起以往，可谓轻松许多。"
                        },
                        {
                            "id": "690260319",
                            "speaker": "魈",
                            "text": "多余的担心，嗯…还是留给你自己吧。"
                        }
                    ]
                },
                {
                    "id": "690260308",
                    "text": "魈看起来有些勉强？",
                    "response": [
                        {
                            "id": "690260309",
                            "speaker": "魈",
                            "text": "并非如此。"
                        },
                        {
                            "id": "690260310",
                            "speaker": "魈",
                            "text": "我没有想见你会提出这样的要求。"
                        }
                    ]
                }
            ]
        }
    ]
}