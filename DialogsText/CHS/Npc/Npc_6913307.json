{
    "talkId": "6913307",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 7,
        "桑多涅": 12
    },
    "dialogues": [
        {
            "id": "691330201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691330202",
            "speaker": "桑多涅",
            "text": "嗯，挺好，谢谢关心。",
            "choices": [
                {
                    "id": "691330203",
                    "text": "没了？",
                    "response": [
                        {
                            "id": "691330205",
                            "speaker": "桑多涅",
                            "text": "哈，挑剔出自淑女卓越的品位和追求，又不是无法适应新环境。"
                        },
                        {
                            "id": "691330206",
                            "speaker": "桑多涅",
                            "text": "就算你这里一把椅子也没有，天天飘雨又漏水，我也照样过得下去。"
                        },
                        {
                            "id": "691330207",
                            "speaker": "桑多涅",
                            "text": "当然，那种情况下出现很多难听的话，就是你自找的了。",
                            "choices": [
                                {
                                    "id": "691330208",
                                    "text": "那依淑女的建议…",
                                    "response": [
                                        {
                                            "id": "691330210",
                                            "speaker": "桑多涅",
                                            "text": "建议谈不上。真要聊的话，我也只能跟你分享我从前的家了。"
                                        },
                                        {
                                            "id": "691330211",
                                            "speaker": "桑多涅",
                                            "text": "室内就不必谈了，一炉温暖的篝火，能让这家不管什么时候都显得无比温馨。"
                                        },
                                        {
                                            "id": "691330212",
                                            "speaker": "桑多涅",
                                            "text": "至于室外，我以前会依照植物的习性来规划花园。"
                                        },
                                        {
                                            "id": "691330213",
                                            "speaker": "桑多涅",
                                            "text": "哪些花春天开，哪些树秋天结果…这个花开的时候香气不能盖过另一种花…这其中有很多学问。",
                                            "choices": [
                                                {
                                                    "id": "691330214",
                                                    "text": "听起来很难…",
                                                    "response": [
                                                        {
                                                            "id": "691330215",
                                                            "speaker": "桑多涅",
                                                            "text": "只要稍微学学就不难，我可以教你。"
                                                        },
                                                        {
                                                            "id": "691330218",
                                                            "speaker": "桑多涅",
                                                            "text": "总之，家里的花园在我的照料下一年四季都有不同的景色，我很满足，阿兰也很开心。"
                                                        },
                                                        {
                                                            "id": "691330219",
                                                            "speaker": "桑多涅",
                                                            "text": "是啊…这么说来，我也该找时间回去重新打理打理那个家了。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691330216",
                                                    "text": "听起来很美…",
                                                    "response": [
                                                        {
                                                            "id": "691330217",
                                                            "speaker": "桑多涅",
                                                            "text": "哼，那是当然。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691330209",
                                    "text": "这里还能做什么改进呢？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691330204",
                    "text": "还以为桑多涅会更挑剔…"
                }
            ]
        }
    ]
}