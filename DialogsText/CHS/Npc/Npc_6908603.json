{
    "talkId": "6908603",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "莱欧斯利": 13
    },
    "dialogues": [
        {
            "id": "690860301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690860302",
            "speaker": "莱欧斯利",
            "text": "好啊，有什么想聊的话题吗？"
        },
        {
            "id": "690860303",
            "speaker": "莱欧斯利",
            "text": "谈论天气是个打开话匣的好办法，不过这里的气候好像始终如一。"
        },
        {
            "id": "690860304",
            "speaker": "Player",
            "text": "都是壶灵阿圆的功劳。"
        },
        {
            "id": "690860305",
            "speaker": "莱欧斯利",
            "text": "原来如此，那位管家是壶灵啊…"
        },
        {
            "id": "690860306",
            "speaker": "莱欧斯利",
            "text": "我刚到这里时，远远看去还误以为你养了只大型青冠雀一类的宠物。"
        },
        {
            "id": "690860307",
            "speaker": "Player",
            "text": "不可貌相哦。"
        },
        {
            "id": "690860308",
            "speaker": "莱欧斯利",
            "text": "嗯，没错。"
        },
        {
            "id": "690860309",
            "speaker": "莱欧斯利",
            "text": "说起来，我小时候也犯过类似的错误，以为美露莘就是天使海兔跳上岸以后的形态。"
        },
        {
            "id": "690860310",
            "speaker": "莱欧斯利",
            "text": "后来读了些书，被狠狠上了一课。"
        },
        {
            "id": "690860311",
            "speaker": "莱欧斯利",
            "text": "你应该知道，根据法律规定，美露莘是枫丹的正式公民，严禁被当作宠物或怪物对待。",
            "choices": [
                {
                    "id": "690860312",
                    "text": "略知一二。",
                    "response": [
                        {
                            "id": "690860313",
                            "speaker": "莱欧斯利",
                            "text": "那就没什么问题了，至少你陷入法律纠纷的原因又少了一个。"
                        },
                        {
                            "id": "690860317",
                            "speaker": "莱欧斯利",
                            "text": "虽然能到水下干活的人多多益善，但我并没有教唆犯罪的癖好。"
                        },
                        {
                            "id": "690860318",
                            "speaker": "莱欧斯利",
                            "text": "希望大家尽量通过正规途径入职梅洛彼得堡，不要给沫芒宫的女士先生们添麻烦。"
                        }
                    ]
                },
                {
                    "id": "690860314",
                    "text": "第一次听说…",
                    "response": [
                        {
                            "id": "690860315",
                            "speaker": "莱欧斯利",
                            "text": "那你可要感谢我了。"
                        },
                        {
                            "id": "690860316",
                            "speaker": "莱欧斯利",
                            "text": "对美露莘不敬的犯人，刑期可能会不太好看哦？"
                        }
                    ]
                }
            ]
        }
    ]
}