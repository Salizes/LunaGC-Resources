    "dialogues": [
        {
            "id": "210180501",
            "speaker": "Player",
            "text": "你在抓什么？"
        },
        {
            "id": "210180502",
            "speaker": "阿佑",
            "text": "我自己的影子，大家都告诉我是抓不到的，我哥哥也这么说。"
        },
        {
            "id": "210180203",
            "speaker": "阿佑",
            "text": "小六、小星还有东东他们也很早就想玩了，可是一直没有人愿意当鬼，嘿嘿。"
        },
        {
            "id": "210180204",
            "speaker": "阿佑",
            "text": "那等我们藏好，就开始找吧，不许偷看！哦对了！还要通知大家…"
        },
        {
            "id": "210180205",
            "speaker": "阿佑",
            "text": "鬼来啦————！！！"
        }
    ]
