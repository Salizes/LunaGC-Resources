        "安柏": 6
    },
    "dialogues": [
        {
            "id": "690210201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690210202",
            "speaker": "安柏",
            "text": "很习惯！"
        },
        {
            "id": "690210203",
            "speaker": "安柏",
            "text": "我对住的地方不那么挑剔。毕竟侦察骑士，得适应各种各样的环境。"
        },
        {
            "id": "690210204",
            "speaker": "安柏",
            "text": "必要的时候，就算在树枝上也要能睡着。",
            "choices": [
                {
                    "id": "690210205",
                    "text": "那还真是厉害啊。",
                    "response": [
                        {
                            "id": "690210206",
                            "speaker": "安柏",
                            "text": "是，是吗…"
                        },
                        {
                            "id": "690210209",
                            "speaker": "安柏",
                            "text": "放心吧！我很喜欢这个地方。"
                        }
                    ]
                },
                {
                    "id": "690210207",
                    "text": "希望这里比「树枝」舒适一点。",
                    "response": [
                        {
                            "id": "690210208",
                            "speaker": "安柏",
                            "text": "嘿嘿，那是当然的喽。"
                        }
                    ]
                }
            ]
        }
    ]
}