    "dialogues": [
        {
            "id": "749140101",
            "speaker": "Player",
            "text": "可以参观公共区域吗？"
        },
        {
            "id": "749140102",
            "speaker": "布吕诺",
            "text": "嗯…理论上来说，这里是办公场所，不过每天来办事的非办公人员也有很多。"
        },
        {
            "id": "749140103",
            "speaker": "布吕诺",
            "text": "我们并不会驱赶遵守秩序的来客，所以只要您在参观时轻声细语，不要打扰他人工作，就没有问题。"
        }
    ]
}