{
    "talkId": "6904104",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 7,
        "莫娜": 12
    },
    "dialogues": [
        {
            "id": "690410401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690410402",
            "speaker": "莫娜",
            "text": "嗯，我想约个你方便的时间，我们一起出去度假吧。"
        },
        {
            "id": "690410403",
            "speaker": "Player",
            "text": "度…度假？"
        },
        {
            "id": "690410404",
            "speaker": "莫娜",
            "text": "不管是无人的海岛还是寂静的雨林，总之，放下工作，享受轻松的时光。",
            "choices": [
                {
                    "id": "690410405",
                    "text": "不太像莫娜的作风呢…",
                    "response": [
                        {
                            "id": "690410406",
                            "speaker": "莫娜",
                            "text": "是…是吗。欸，不对，你该不会把我当作死脑筋的研究狂了吧。"
                        },
                        {
                            "id": "690410407",
                            "speaker": "莫娜",
                            "text": "我所做的事情是体察世界的真实，度假…也算是一种实现的方式。"
                        },
                        {
                            "id": "690410410",
                            "speaker": "莫娜",
                            "text": "很久之前，我就开始筹备这个计划。"
                        },
                        {
                            "id": "690410411",
                            "speaker": "莫娜",
                            "text": "攒钱不太容易，所以我专门准备了一个储蓄罐，每次发下稿酬都投些进去。"
                        },
                        {
                            "id": "690410412",
                            "speaker": "莫娜",
                            "text": "期间也忍住了不去买精装版的研究手稿…陆陆续续，终于攒够了。",
                            "choices": [
                                {
                                    "id": "690410413",
                                    "text": "真不容易…",
                                    "response": [
                                        {
                                            "id": "690410414",
                                            "speaker": "莫娜",
                                            "text": "没关系，是值得的！"
                                        },
                                        {
                                            "id": "690410419",
                                            "speaker": "莫娜",
                                            "text": "嗯！等着你的消息哦。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690410415",
                                    "text": "我不能用莫娜的钱。",
                                    "response": [
                                        {
                                            "id": "690410416",
                                            "speaker": "莫娜",
                                            "text": "欸…你的意思是？"
                                        },
                                        {
                                            "id": "690410417",
                                            "speaker": "莫娜",
                                            "text": "谢谢你体谅我！不过，这是我想做的事情，所以没关系。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690410418",
                                    "text": "那我去安排一下时间。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690410408",
                    "text": "莫娜有「经费」吗？…",
                    "response": [
                        {
                            "id": "690410409",
                            "speaker": "莫娜",
                            "text": "哼哼，当然准备好了。"
                        }
                    ]
                }
            ]
        }
    ]
}