{
    "talkId": "7265602",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 5,
        "驹形": 9
    },
    "dialogues": [
        {
            "id": "726560201",
            "speaker": "驹形",
            "text": "来、来试试「机关棋谭」吧！",
            "choices": [
                {
                    "id": "726560202",
                    "text": "游玩「机关棋谭」。",
                    "response": [
                        {
                            "id": "726560203",
                            "speaker": "驹形",
                            "text": "没问题，好好玩吧，这可是全新的「机关棋谭」，绝不会让你失望的！"
                        }
                    ]
                },
                {
                    "id": "726560204",
                    "text": "「机关棋谭」是什么？",
                    "response": [
                        {
                            "id": "726560205",
                            "speaker": "驹形",
                            "text": "简单来说，就是一种能在桌子上玩的「游戏」啦。最开始是由璃月的瑞锦小姐发明的。"
                        },
                        {
                            "id": "726560206",
                            "speaker": "驹形",
                            "text": "我…怎么说呢，按照瑞锦小姐的说法，我是这套「机关棋谭」在稻妻区域的「海外代理」啦。"
                        },
                        {
                            "id": "726560207",
                            "speaker": "驹形",
                            "text": "在获得…呃…「代理权」之后，瑞锦小姐就把整套的「机关棋谭」，还有相关的营业建议寄了过来。"
                        },
                        {
                            "id": "726560208",
                            "speaker": "驹形",
                            "text": "据瑞锦小姐说，她的「海外代理」还不止我一个。真不知道她到底赚了多少「代理费」…"
                        },
                        {
                            "id": "726560209",
                            "speaker": "驹形",
                            "text": "不过，我这边可是有全新玩法的，说不定会比瑞锦小姐的原版「机关棋谭」更…咳…"
                        },
                        {
                            "id": "726560210",
                            "speaker": "驹形",
                            "text": "唉，但瑞锦小姐的商业头脑可真好，要是我也能像她一样就好了…",
                            "choices": [
                                {
                                    "id": "726560202",
                                    "text": "游玩「机关棋谭」。"
                                },
                                {
                                    "id": "726560211",
                                    "text": "还有别的事…",
                                    "response": [
                                        {
                                            "id": "726560212",
                                            "speaker": "驹形",
                                            "text": "嗯，等你有空了再来玩吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "726560211",
                    "text": "还有别的事…"
                }
            ]
        }
    ]
}