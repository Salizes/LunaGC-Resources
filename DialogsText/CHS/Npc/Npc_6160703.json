    "dialogues": [
        {
            "id": "616070301",
            "speaker": "Player",
            "text": "你父亲是？"
        },
        {
            "id": "616070302",
            "speaker": "玛文",
            "text": "我姓歌德，懂了吧？"
        },
        {
            "id": "616070303",
            "speaker": "玛文",
            "text": "就是那位歌德大酒店老总管的儿子。"
        },
        {
            "id": "616070304",
            "speaker": "玛文",
            "text": "别看他那么和善，可他在我婚事的问题上顽固得很！"
        },
        {
            "id": "616070305",
            "speaker": "玛文",
            "text": "所以我半夜才不得不…等等，你该不会是他派来套我话的吧？"
        },
        {
            "id": "616070306",
            "speaker": "玛文",
            "text": "走吧走吧，你快走吧，我清醒得很，一点儿也不困…呵欠…"
        }
    ]
}