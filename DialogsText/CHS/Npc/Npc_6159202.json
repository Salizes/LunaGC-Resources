{
    "talkId": "6159202",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "格雷戈": 12
    },
    "dialogues": [
        {
            "id": "615920201",
            "speaker": "Player",
            "text": "你是谁？"
        },
        {
            "id": "615920202",
            "speaker": "格雷戈",
            "text": "我是格雷戈啦，格雷戈，晨曦酒庄的工人，今天迪卢克老爷开心，赏了我一瓶私酿！"
        },
        {
            "id": "615920203",
            "speaker": "格雷戈",
            "text": "美酒当然要和有缘人一同享用，我带你去酒庄品酒吧。"
        },
        {
            "id": "615920204",
            "speaker": "格雷戈",
            "text": "啊…我好像忘了路怎么走了，晨曦酒庄是往东北走吧？",
            "choices": [
                {
                    "id": "615920205",
                    "text": "不对。",
                    "response": [
                        {
                            "id": "615920206",
                            "speaker": "格雷戈",
                            "text": "啧，不是分得清楚方向嘛，看起来没醉。"
                        },
                        {
                            "id": "615920207",
                            "speaker": "格雷戈",
                            "text": "没醉就赶快滚，没事了。"
                        }
                    ]
                },
                {
                    "id": "615920208",
                    "text": "是的。",
                    "response": [
                        {
                            "id": "615920209",
                            "speaker": "格雷戈",
                            "text": "嘻嘻，原来如此…原来如此，那我们走吧。"
                        },
                        {
                            "id": "615920210",
                            "speaker": "格雷戈",
                            "text": "看你的样子，喝了挺多酒的吧，来来来，我搀着你。"
                        },
                        {
                            "id": "615920211",
                            "speaker": "格雷戈",
                            "text": "没事的，来嘛，还有好长一段路呢。"
                        },
                        {
                            "id": "615920212",
                            "speaker": "Player",
                            "text": "你一直在盯着我的口袋。"
                        },
                        {
                            "id": "615920213",
                            "speaker": "格雷戈",
                            "text": "哎呀，你看你说的这是什么话，我还能偷你东西不成…"
                        },
                        {
                            "id": "615920214",
                            "speaker": "格雷戈",
                            "text": "…等等，你怎么连这都注意到了。"
                        },
                        {
                            "id": "615920215",
                            "speaker": "格雷戈",
                            "text": "没喝醉就别跟我装，浪费时间。"
                        },
                        {
                            "id": "615920216",
                            "speaker": "格雷戈",
                            "text": "快走吧快走吧，对你没兴趣了。"
                        }
                    ]
                }
            ]
        }
    ]
}