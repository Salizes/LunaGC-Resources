{
    "talkId": "6910508",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "欧洛伦": 17
    },
    "dialogues": [
        {
            "id": "691050301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691050302",
            "speaker": "欧洛伦",
            "text": "你想吗？我可以陪你。"
        },
        {
            "id": "691050303",
            "speaker": "欧洛伦",
            "text": "不过让我挑话题的话，可选范围会很窄。"
        },
        {
            "id": "691050304",
            "speaker": "Player",
            "text": "比如种菜？"
        },
        {
            "id": "691050305",
            "speaker": "欧洛伦",
            "text": "对。"
        },
        {
            "id": "691050306",
            "speaker": "欧洛伦",
            "text": "你已经开始熟悉我了，这感觉真奇妙。"
        },
        {
            "id": "691050307",
            "speaker": "Player",
            "text": "会让你觉得「越界」吗？"
        },
        {
            "id": "691050308",
            "speaker": "欧洛伦",
            "text": "嗯？当然不。"
        },
        {
            "id": "691050309",
            "speaker": "欧洛伦",
            "text": "你像是那种在安全范围内主动亲近人的野生动物，没人会不欢迎的。"
        },
        {
            "id": "691050310",
            "speaker": "欧洛伦",
            "text": "…抱歉，把你比作小动物，我并没有想要冒犯的意思。"
        },
        {
            "id": "691050311",
            "speaker": "欧洛伦",
            "text": "我只是想说，你身边的氛围毛茸茸的，会让人不由自主放下戒备。"
        },
        {
            "id": "691050312",
            "speaker": "欧洛伦",
            "text": "当然我也能感觉到，你的灵魂比外表看上去要成熟很多。"
        },
        {
            "id": "691050313",
            "speaker": "欧洛伦",
            "text": "年轻的表象下包裹着丰富的经历与经验。比喻成水果，就是皮薄的美食…"
        },
        {
            "id": "691050314",
            "speaker": "欧洛伦",
            "text": "有点说不明白了，但请放心，我觉得非常好，大家都会喜欢这样的人。",
            "choices": [
                {
                    "id": "691050315",
                    "text": "第一次听人这样说。",
                    "response": [
                        {
                            "id": "691050316",
                            "speaker": "欧洛伦",
                            "text": "会很奇怪吗？"
                        },
                        {
                            "id": "691050317",
                            "speaker": "欧洛伦",
                            "text": "不好意思啊，我是怪人。"
                        },
                        {
                            "id": "691050318",
                            "speaker": "欧洛伦",
                            "text": "不过看起来你并没有感到不舒服，嗯，我会保持这样和你相处。"
                        }
                    ]
                },
                {
                    "id": "691050319",
                    "text": "听起来还挺不错的。",
                    "response": [
                        {
                            "id": "691050320",
                            "speaker": "欧洛伦",
                            "text": "是啊，比上了年纪却没能学到任何东西要好太多了。"
                        },
                        {
                            "id": "691050321",
                            "speaker": "欧洛伦",
                            "text": "…希望我以后不要变成那样的人。"
                        },
                        {
                            "id": "691050322",
                            "speaker": "欧洛伦",
                            "text": "怎么说呢…至少我很会种菜、打猎，不会饿肚子，对吧？"
                        }
                    ]
                }
            ]
        }
    ]
}