{
    "talkId": "6990029",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "699002901",
            "speaker": "Player",
            "text": "关于罐装知识…"
        },
        {
            "id": "699002902",
            "speaker": "派蒙",
            "text": "不用读书就能知道好多东西，罐装知识真是太方便了！"
        },
        {
            "id": "699002903",
            "speaker": "派蒙",
            "text": "不知道须弥，有没有关于七国风土人情的罐装知识…"
        },
        {
            "id": "699002904",
            "speaker": "派蒙",
            "text": "要是有的话，每到一个新的地方，我就替你打开一个新罐头，就不用再多费口舌了！",
            "choices": [
                {
                    "id": "699002905",
                    "text": "那也不用去新的地方…",
                    "response": [
                        {
                            "id": "699002907",
                            "speaker": "派蒙",
                            "text": "这、这是为了保持旅程的期待感嘛！",
                            "choices": [
                                {
                                    "id": "699002908",
                                    "text": "而且这么一来…",
                                    "response": [
                                        {
                                            "id": "699002910",
                                            "speaker": "派蒙",
                                            "text": "不行不行，我们还是把买罐头的摩拉省下来吧！"
                                        },
                                        {
                                            "id": "699002911",
                                            "speaker": "派蒙",
                                            "text": "省下来…当我的小费！嘿嘿，合情合理。"
                                        }
                                    ]
                                },
                                {
                                    "id": "699002909",
                                    "text": "也不用派蒙来当向导了…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699002906",
                    "text": "在须弥就能全都打开了吧…"
                }
            ]
        }
    ]
}