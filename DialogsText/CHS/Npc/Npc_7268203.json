{
    "talkId": "7268203",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "茅葺一庆": 11
    },
    "dialogues": [
        {
            "id": "726820301",
            "speaker": "茅葺一庆",
            "text": "嗨，怎么了吗？",
            "choices": [
                {
                    "id": "726820302",
                    "text": "关于小说…",
                    "response": [
                        {
                            "id": "726820303",
                            "speaker": "茅葺一庆",
                            "text": "我小的时候，也是读着话本、小说长大的，也想着长大了要变成像岩藏之胤、喜多院那样武艺高强，斩妖除魔的武者。"
                        },
                        {
                            "id": "726820304",
                            "speaker": "茅葺一庆",
                            "text": "长大了才发现，我实在没那个才能。所以我决定，去写武者的故事。能在字里行间绽放光彩，也算是一种「武道」吧。"
                        },
                        {
                            "id": "726820305",
                            "speaker": "茅葺一庆",
                            "text": "虽然当武官的文胆也不失为一种选择，但我还是更想写像你这样洒脱的异邦战士的故事。"
                        },
                        {
                            "id": "726820306",
                            "speaker": "茅葺一庆",
                            "text": "你上次在「百人一揆」中的表现，我已经写成了样稿，交给八重堂的编辑审阅了。不知情况如何呢…"
                        }
                    ]
                },
                {
                    "id": "726820307",
                    "text": "关于之前…",
                    "response": [
                        {
                            "id": "726820308",
                            "speaker": "茅葺一庆",
                            "text": "上次你在「百人一揆」当中的表现，实在是太精彩了。"
                        },
                        {
                            "id": "726820309",
                            "speaker": "茅葺一庆",
                            "text": "即使是「心流」的宗主涉川，恐怕也难以想象出这样的武人吧…"
                        }
                    ]
                },
                {
                    "id": "726820310",
                    "text": "关于「百人一揆」…",
                    "response": [
                        {
                            "id": "726820311",
                            "speaker": "茅葺一庆",
                            "text": "最早是过去的「天狗党人」举办的神秘仪式，旨在宣扬打闹的好处。"
                        },
                        {
                            "id": "726820312",
                            "speaker": "茅葺一庆",
                            "text": "但在他们被取缔后，还是会不时有人秘密举办。举办者的身份至今都笼罩在疑云之中。"
                        },
                        {
                            "id": "726820313",
                            "speaker": "茅葺一庆",
                            "text": "总之，是相当热闹的乱斗大会。无论什么人、甚至是魔物都能参加。"
                        },
                        {
                            "id": "726820314",
                            "speaker": "茅葺一庆",
                            "text": "对于渴求争斗的人来说，再合适不过了。"
                        }
                    ]
                }
            ]
        }
    ]
}