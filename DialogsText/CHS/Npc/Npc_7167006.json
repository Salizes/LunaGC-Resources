{
    "talkId": "7167006",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "方谨": 13
    },
    "dialogues": [
        {
            "id": "716700601",
            "speaker": "方谨",
            "text": "#又见面了，{NICKNAME}…"
        },
        {
            "id": "716700602",
            "speaker": "方谨",
            "text": "我有两则消息要带给您，一则不幸，一则万幸。",
            "choices": [
                {
                    "id": "716700603",
                    "text": "请说不幸的消息。",
                    "response": [
                        {
                            "id": "716700604",
                            "speaker": "方谨",
                            "text": "如你所见，地脉紊乱点再次开始活跃。相比最初的状态，现在它的外形似乎显得更为危险…当然，也只是外形而已。"
                        },
                        {
                            "id": "716700605",
                            "speaker": "方谨",
                            "text": "凶戾的魔物已开始躁动，你来之前，我们已经击退了若干波次的攻势。"
                        },
                        {
                            "id": "716700606",
                            "speaker": "方谨",
                            "text": "接下来，又要烦请你出手，攻抵秘境的最深处，将它再次重创了。",
                            "choices": [
                                {
                                    "id": "716700607",
                                    "text": "无妨，我随时准备着。",
                                    "response": [
                                        {
                                            "id": "716700608",
                                            "speaker": "方谨",
                                            "text": "真是锐不可当的气势…相信您这次依然能斩获惊人的战果！"
                                        }
                                    ]
                                },
                                {
                                    "id": "716700609",
                                    "text": "我稍作战斗准备再来。",
                                    "response": [
                                        {
                                            "id": "716700610",
                                            "speaker": "方谨",
                                            "text": "请安心整备，在此之前，我部会将所有出逃的魔物全数清剿。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "716700611",
                    "text": "先说万幸的好消息吧。",
                    "response": [
                        {
                            "id": "716700612",
                            "speaker": "方谨",
                            "text": "得益于地脉紊乱点的再次活跃，将士们又将迎来一次极具考验的实战演练。"
                        },
                        {
                            "id": "716700613",
                            "speaker": "方谨",
                            "text": "此前，璃月多地的危险魔物已被千岩军清剿一空，普通的将士很难得到这种真刀真枪对抗强敌的机会。"
                        },
                        {
                            "id": "716700614",
                            "speaker": "方谨",
                            "text": "但长期处于安定的环境下，将士们的身体和意志都会生锈。实战则是反映问题、彻查不足的重要渠道。"
                        },
                        {
                            "id": "716700615",
                            "speaker": "方谨",
                            "text": "所以，在保证防线稳定，确保严格抑制危害的前提下，千岩军正通过这个地脉紊乱点不断强化自身。"
                        },
                        {
                            "id": "716700616",
                            "speaker": "方谨",
                            "text": "经过最近的磨练，不少战士进步显著，相信以后还会涌现出更多杰出强者！"
                        }
                    ]
                },
                {
                    "id": "716700617",
                    "text": "容我斟酌一番，再来与你交流。",
                    "response": [
                        {
                            "id": "716700618",
                            "speaker": "方谨",
                            "text": "好的，我随时在此候命。"
                        }
                    ]
                }
            ]
        }
    ]
}