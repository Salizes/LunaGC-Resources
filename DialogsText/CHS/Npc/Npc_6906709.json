{
    "talkId": "6906709",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "柯莱": 13
    },
    "dialogues": [
        {
            "id": "690670401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690670402",
            "speaker": "柯莱",
            "text": "嗯，我正想着要不要约你一起去露营呢。"
        },
        {
            "id": "690670403",
            "speaker": "柯莱",
            "text": "我这几天的精神不错，又刚好考完试，师父说可以适当出去放松一下。"
        },
        {
            "id": "690670404",
            "speaker": "柯莱",
            "text": "我们可以找个视野开阔的地方看风景，还可以准备一些食材野炊。",
            "choices": [
                {
                    "id": "690670405",
                    "text": "大概什么时候？",
                    "response": [
                        {
                            "id": "690670407",
                            "speaker": "柯莱",
                            "text": "嗯…要不然，今天就出发？"
                        },
                        {
                            "id": "690670408",
                            "speaker": "Player",
                            "text": "这么着急吗！"
                        },
                        {
                            "id": "690670409",
                            "speaker": "柯莱",
                            "text": "唔…其实我只是刚交了测试卷，师父说忙完手头的事情再来批改…"
                        },
                        {
                            "id": "690670410",
                            "speaker": "柯莱",
                            "text": "可万一改完发现我的进度不如预期，就又得开始补课了。"
                        },
                        {
                            "id": "690670411",
                            "speaker": "柯莱",
                            "text": "难得你答应了，我不太想放弃这个机会…"
                        },
                        {
                            "id": "690670412",
                            "speaker": "柯莱",
                            "text": "但仔细想想…就算食材可以就地取用，合适的地点一下子也想不出来。"
                        },
                        {
                            "id": "690670413",
                            "speaker": "柯莱",
                            "text": "况且在野外露营要注意的事项还有很多…唔…"
                        },
                        {
                            "id": "690670414",
                            "speaker": "Player",
                            "text": "要不直接在这里露营？"
                        },
                        {
                            "id": "690670415",
                            "speaker": "柯莱",
                            "text": "欸！在这里吗…对呀，我怎么没想到！"
                        },
                        {
                            "id": "690670416",
                            "speaker": "柯莱",
                            "text": "地势开阔，风景也很不错，还不会有什么危险…"
                        },
                        {
                            "id": "690670417",
                            "speaker": "Player",
                            "text": "就当做正式露营前的演练吧。"
                        },
                        {
                            "id": "690670418",
                            "speaker": "柯莱",
                            "text": "好！真不愧是你，一下子就想出了那么好的点子。"
                        },
                        {
                            "id": "690670419",
                            "speaker": "柯莱",
                            "text": "哎呀，阿圆不会有意见吧？"
                        }
                    ]
                },
                {
                    "id": "690670406",
                    "text": "我去做点准备？"
                }
            ]
        }
    ]
}