    "dialogues": [
        {
            "id": "675780401",
            "speaker": "Player",
            "text": "关于索博列夫…"
        },
        {
            "id": "675780402",
            "speaker": "涅克拉索夫",
            "text": "他啊。说实话，他的职权范围挺杂的，你直接把他当成我们这帮工人的「大总管」就行。"
        },
        {
            "id": "675780403",
            "speaker": "涅克拉索夫",
            "text": "毕竟大到工资发放，小到设备维修，全得找他处理。所以他那边总缺人手，经常需要找人帮忙干点杂活。"
        }
    ]
}