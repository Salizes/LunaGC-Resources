    "dialogues": [
        {
            "id": "706765701",
            "speaker": "派蒙",
            "text": "这些书页上的文字…呜啊，字迹已经完全模糊了，看不出写的是什么。"
        },
        {
            "id": "706765702",
            "speaker": "派蒙",
            "text": "不过，书桌后面悬挂着的这个是时钟吗？一动不动的，好像也已经坏掉了呢。",
            "choices": [
                {
                    "id": "706765703",
                    "text": "「你是如此美丽，请为我停留…」",
                    "response": [
                        {
                            "id": "706765704",
                            "speaker": "派蒙",
                            "text": "#欸？怎、怎么了，{NICKNAME}？真是的，不要突然说这种奇怪的话啦！"
                        },
                        {
                            "id": "706765705",
                            "speaker": "派蒙",
                            "text": "咳咳，总之，这里应该没什么值得在意的东西了，我们先去其他地方看看吧？"
                        }
                    ]
                },
                {
                    "id": "706765706",
                    "text": "走吧。",
                    "response": [
                        {
                            "id": "706765707",
                            "speaker": "派蒙",
                            "text": "嗯，我们先去其他地方看看吧。"
                        }
                    ]
                }
            ]
        }
    ]
}