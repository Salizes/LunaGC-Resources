{
    "talkId": "7322053",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "芭别尔": 13
    },
    "dialogues": [
        {
            "id": "732205301",
            "speaker": "芭别尔",
            "text": "抱歉，部落事情繁杂…请问有什么事情吗？",
            "choices": [
                {
                    "id": "732205302",
                    "text": "关于叛徒…",
                    "response": [
                        {
                            "id": "732205303",
                            "speaker": "芭别尔",
                            "text": "你是在说阿德菲和阿萨里格吗…真是让你看到了塔尼特不堪的一面…"
                        },
                        {
                            "id": "732205304",
                            "speaker": "芭别尔",
                            "text": "他们和那些「北方人」接触得太久了，忘记了自己本来是塔尼特的子女，应该遵照部落的规矩成活。"
                        },
                        {
                            "id": "732205305",
                            "speaker": "芭别尔",
                            "text": "但好在我还有婕德…她没有辜负我的期望。"
                        }
                    ]
                },
                {
                    "id": "732205306",
                    "text": "关于婕德…",
                    "response": [
                        {
                            "id": "732205307",
                            "speaker": "芭别尔",
                            "text": "婕德吗？她是个好孩子。在部落学得很快，也很能吃苦…从没见她抱怨过。"
                        },
                        {
                            "id": "732205308",
                            "speaker": "芭别尔",
                            "text": "呵呵，说起来，塔尼特部族和她的父亲还有过一些小小的过节。真的是很遗憾…"
                        },
                        {
                            "id": "732205309",
                            "speaker": "芭别尔",
                            "text": "但我很高兴婕德回来了，虽然那孩子的父亲…唉，这也算是迟来的和解吧。"
                        },
                        {
                            "id": "732205310",
                            "speaker": "芭别尔",
                            "text": "那孩子也很喜欢你，我看得出来。"
                        },
                        {
                            "id": "732205311",
                            "speaker": "芭别尔",
                            "text": "所以…请不要辜负她的友谊。"
                        }
                    ]
                },
                {
                    "id": "732205312",
                    "text": "关于利露帕尔…",
                    "response": [
                        {
                            "id": "732205313",
                            "speaker": "芭别尔",
                            "text": "尊贵的「镇灵之母」自然有她的看法，之前引起她的不快是因为我们的行事令她产生了误解…"
                        },
                        {
                            "id": "732205314",
                            "speaker": "芭别尔",
                            "text": "但是要让沙漠复兴，要让土壤肥沃，要让部落的子民过上安定的生活，必须仰赖利露帕尔的垂青。"
                        },
                        {
                            "id": "732205315",
                            "speaker": "芭别尔",
                            "text": "希望在这点上，我们最终能与她达成共识吧…"
                        }
                    ]
                },
                {
                    "id": "732205316",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "732205317",
                            "speaker": "芭别尔",
                            "text": "再见，希望这次探险你们能够一路平安。"
                        }
                    ]
                }
            ]
        }
    ]
}