    "dialogues": [
        {
            "id": "690090801",
            "speaker": "久岐忍",
            "text": "我干过卖玩具的兼职，结果不仅没卖出多少货，还被好多家长投诉…"
        },
        {
            "id": "690090802",
            "speaker": "久岐忍",
            "text": "说我戴着面铠又凶神恶煞的样子容易吓到小孩…可是我明明记得路过的小孩都在说我很酷。"
        },
        {
            "id": "690090803",
            "speaker": "久岐忍",
            "text": "算了，过去就过去了。"
        }
    ]
}