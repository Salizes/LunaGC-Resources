    "dialogues": [
        {
            "id": "5061001",
            "speaker": "留言",
            "text": "「木漏茶室的梢小姐很可爱。」"
        },
        {
            "id": "5061002",
            "speaker": "留言",
            "text": "「虽然舌头很毒，脾气也很差，用刀背敲人超痛…」"
        },
        {
            "id": "5061003",
            "speaker": "留言",
            "text": "「但是她真的好可爱。」"
        },
        {
            "id": "5061004",
            "speaker": "回复",
            "text": "町奉行所已受理梢小姐的报案，诸位市民如有线索请主动上报。"
        },
        {
            "id": "5061005",
            "speaker": "回复",
            "text": "此条留言留作笔迹识别所用，禁止故意污损、撤下。"
        }
    ]
}