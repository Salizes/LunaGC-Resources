{
    "talkId": "6901503",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "凯亚": 16
    },
    "dialogues": [
        {
            "id": "690150301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690150801",
            "speaker": "凯亚",
            "text": "哦？那你可是找对人了。"
        },
        {
            "id": "690150802",
            "speaker": "凯亚",
            "text": "说吧，我很乐意奉陪。"
        },
        {
            "id": "690150803",
            "speaker": "凯亚",
            "text": "唔…要是手边有杯酒就更好了啊…"
        },
        {
            "id": "690150804",
            "speaker": "Player",
            "text": "凯亚为什么那么喜欢喝酒呢？"
        },
        {
            "id": "690150805",
            "speaker": "凯亚",
            "text": "嗯…口感是很重要的一部分。"
        },
        {
            "id": "690150806",
            "speaker": "凯亚",
            "text": "不过，也有一部分原因是喜欢喝酒的感觉。",
            "choices": [
                {
                    "id": "690150807",
                    "text": "我隐约能够理解。",
                    "response": [
                        {
                            "id": "690150808",
                            "speaker": "凯亚",
                            "text": "哦？明明没有实践却能单纯通过话语理解。"
                        },
                        {
                            "id": "690150809",
                            "speaker": "凯亚",
                            "text": "你果然有过人的天赋啊。"
                        },
                        {
                            "id": "690150813",
                            "speaker": "凯亚",
                            "text": "话说回来，跟你聊天是一件很让人陶醉的事情。"
                        },
                        {
                            "id": "690150814",
                            "speaker": "凯亚",
                            "text": "喝酒对我来说也一样。"
                        },
                        {
                            "id": "690150815",
                            "speaker": "凯亚",
                            "text": "所以…我只是比较贪心吧。想要让这些快乐的事情叠加在一起。"
                        },
                        {
                            "id": "690150816",
                            "speaker": "Player",
                            "text": "它们会像鸡尾酒一样分层吗？"
                        },
                        {
                            "id": "690150817",
                            "speaker": "凯亚",
                            "text": "哈哈…有意思有意思。是我没有思考过的角度。"
                        },
                        {
                            "id": "690150818",
                            "speaker": "凯亚",
                            "text": "我想想…"
                        },
                        {
                            "id": "690150819",
                            "speaker": "凯亚",
                            "text": "嗯…可能会吧。"
                        },
                        {
                            "id": "690150820",
                            "speaker": "凯亚",
                            "text": "但酒的作用是衬托你。"
                        }
                    ]
                },
                {
                    "id": "690150810",
                    "text": "原来不是因为能够麻醉痛苦之类的？",
                    "response": [
                        {
                            "id": "690150811",
                            "speaker": "凯亚",
                            "text": "哎——瞧你这说的。我哪有那么多痛苦的事情。"
                        },
                        {
                            "id": "690150812",
                            "speaker": "凯亚",
                            "text": "对于现在的生活，我可是很知足的。"
                        }
                    ]
                }
            ]
        }
    ]
}