{
    "talkId": "6151702",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "维克多": 9
    },
    "dialogues": [
        {
            "id": "615170201",
            "speaker": "Player",
            "text": "你在做什么？"
        },
        {
            "id": "615170202",
            "speaker": "维克多",
            "text": "咳！我可不是在打瞌睡消磨时间！"
        },
        {
            "id": "615170203",
            "speaker": "维克多",
            "text": "本人可是愚人众的参赞大人……"
        },
        {
            "id": "615170204",
            "speaker": "维克多",
            "text": "的随从——维克多！"
        },
        {
            "id": "615170205",
            "speaker": "维克多",
            "text": "奉参赞大人的命令来巡视蒙德城的情况！"
        },
        {
            "id": "615170206",
            "speaker": "Player",
            "text": "谈谈巡视的感受？"
        },
        {
            "id": "615170207",
            "speaker": "维克多",
            "text": "这蒙德…真是太没劲了…呵欠…"
        },
        {
            "id": "615170208",
            "speaker": "维克多",
            "text": "虽说是什么「自由之都」…"
        },
        {
            "id": "615170209",
            "speaker": "维克多",
            "text": "可这种一点儿刺激都没有的生活，蒙德人都是怎么坚持下来的？"
        },
        {
            "id": "615170210",
            "speaker": "维克多",
            "text": "还有这个巴巴托斯，啊？连个脸都不乐意露，有什么可崇拜的。"
        },
        {
            "id": "615170211",
            "speaker": "维克多",
            "text": "不像我们至冬宫的女皇陛下…唉得了得了，那边的修女又开始瞪我了。"
        }
    ]
}