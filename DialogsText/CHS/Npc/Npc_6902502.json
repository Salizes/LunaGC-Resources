{
    "talkId": "6902502",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "行秋": 9
    },
    "dialogues": [
        {
            "id": "690250201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690250202",
            "speaker": "行秋",
            "text": "这般壶中天地，即使是放进小说里，也是能让人钦羡不已的。"
        },
        {
            "id": "690250203",
            "speaker": "行秋",
            "text": "更何况我现在是亲临其中，亲自体验。"
        },
        {
            "id": "690250204",
            "speaker": "行秋",
            "text": "那自然是再满意不过了。"
        },
        {
            "id": "690250205",
            "speaker": "行秋",
            "text": "而且…"
        },
        {
            "id": "690250206",
            "speaker": "Player",
            "text": "而且…"
        },
        {
            "id": "690250207",
            "speaker": "行秋",
            "text": "在这边看书没有俗事来打搅，躲清闲正好。",
            "choices": [
                {
                    "id": "690250208",
                    "text": "行侠仗义的事要怎么办？",
                    "response": [
                        {
                            "id": "690250210",
                            "speaker": "行秋",
                            "text": "小、小点声…"
                        },
                        {
                            "id": "690250211",
                            "speaker": "行秋",
                            "text": "你说的那些我当然也不会落下的！"
                        },
                        {
                            "id": "690250212",
                            "speaker": "行秋",
                            "text": "只是…你别说顺了嘴，让别人听去。"
                        },
                        {
                            "id": "690250213",
                            "speaker": "行秋",
                            "text": "那家父和兄长的唠叨，又要够我好受的了。"
                        }
                    ]
                },
                {
                    "id": "690250209",
                    "text": "武艺不会退步吧？"
                }
            ]
        }
    ]
}