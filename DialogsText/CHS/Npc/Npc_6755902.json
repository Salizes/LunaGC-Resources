    "dialogues": [
        {
            "id": "675590201",
            "speaker": "Player",
            "text": "在想念哥哥吗…"
        },
        {
            "id": "675590202",
            "speaker": "？？？",
            "text": "是的！托克在想大哥和二哥，可是他们每隔几天都会回家，所以没有那么想…"
        },
        {
            "id": "675590203",
            "speaker": "？？？",
            "text": "托克最想念的还是阿贾克斯哥哥…他可是了不起的玩具推销员，每次回家都会带回来很多新的玩具！"
        },
        {
            "id": "675590204",
            "speaker": "？？？",
            "text": "就算有的时候不回家，也会写信给冬妮娅姐姐…还会随信附赠很多好吃的好玩的。"
        },
        {
            "id": "675590205",
            "speaker": "？？？",
            "text": "好吃的和好玩的都很好，不过还是哥哥回家，能和托克一起玩更好…"
        }
    ]
}