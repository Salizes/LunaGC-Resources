    "dialogues": [
        {
            "id": "660840301",
            "speaker": "Player",
            "text": "我是亮闪闪的吗？"
        },
        {
            "id": "660840302",
            "speaker": "伊蜜",
            "text": "对啊，对啊，每个人都闪着不同的光，不是吗？"
        },
        {
            "id": "660840303",
            "speaker": "伊蜜",
            "text": "夏温师父是蓝盈盈的，希诺宁姐姐是金灿灿的，卡齐娜则是红通通暖烘烘的…"
        },
        {
            "id": "660840304",
            "speaker": "伊蜜",
            "text": "我的话…嘿嘿，先不告诉你！"
        }
    ]
}