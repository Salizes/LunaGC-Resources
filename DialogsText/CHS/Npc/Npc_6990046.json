{
    "talkId": "6990046",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 8,
        "派蒙": 7
    },
    "dialogues": [
        {
            "id": "699004601",
            "speaker": "Player",
            "text": "关于发财的机会…"
        },
        {
            "id": "699004602",
            "speaker": "派蒙",
            "text": "嘿嘿，你听我说哦。我发现了一个不得了的发财机会！"
        },
        {
            "id": "699004603",
            "speaker": "Player",
            "text": "嗯，什么机会？"
        },
        {
            "id": "699004604",
            "speaker": "派蒙",
            "text": "你看圣火竞技场有这么多人经过。我们要是能在这里做点生意，一定可以发大财！"
        },
        {
            "id": "699004605",
            "speaker": "Player",
            "text": "哦？那派蒙准备卖点什么呢？"
        },
        {
            "id": "699004606",
            "speaker": "派蒙",
            "text": "蒙德的炼金药剂怎么样？"
        },
        {
            "id": "699004607",
            "speaker": "Player",
            "text": "貌似已经有人在卖类似的东西了…"
        },
        {
            "id": "699004608",
            "speaker": "派蒙",
            "text": "那璃月的各种矿石呢？这个一定很赚钱！"
        },
        {
            "id": "699004609",
            "speaker": "Player",
            "text": "回声之子不就是干这个的…"
        },
        {
            "id": "699004610",
            "speaker": "派蒙",
            "text": "哦对…啊！我想到了，须弥的挂毯，这个一定会很吃香！"
        },
        {
            "id": "699004611",
            "speaker": "Player",
            "text": "可惜，还有烟谜主呢。"
        },
        {
            "id": "699004612",
            "speaker": "派蒙",
            "text": "那，那我们把圣火竞技场四面用围栏拦起来！从今往后不管是参赛的和观战的，都要先付钱才能出入场地。",
            "choices": [
                {
                    "id": "699004613",
                    "text": "你的围栏还没建成…",
                    "response": [
                        {
                            "id": "699004615",
                            "speaker": "派蒙",
                            "text": "怎么这样——发财可真难啊。"
                        }
                    ]
                },
                {
                    "id": "699004614",
                    "text": "人就会先被谁给抓起来…"
                }
            ]
        }
    ]
}