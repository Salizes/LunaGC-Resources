    "dialogues": [
        {
            "id": "400123101",
            "speaker": "雷泽",
            "text": "啊…是你。"
        },
        {
            "id": "400123102",
            "speaker": "雷泽",
            "text": "嗯嗯…要吃鱼吗？",
            "choices": [
                {
                    "id": "400123103",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400123104",
                            "speaker": "雷泽",
                            "text": "我…不太会…"
                        },
                        {
                            "id": "400123105",
                            "speaker": "雷泽",
                            "text": "但，陪你。",
                            "choices": [
                                {
                                    "id": "400123106",
                                    "text": "关于气味…",
                                    "response": [
                                        {
                                            "id": "400123107",
                                            "speaker": "雷泽",
                                            "text": "气味…很强烈。在天上…就能闻到。"
                                        },
                                        {
                                            "id": "400123108",
                                            "speaker": "雷泽",
                                            "text": "所以…我下来…"
                                        },
                                        {
                                            "id": "400123109",
                                            "speaker": "雷泽",
                                            "text": "这里有…咸味…还有，树叶，草，果子。"
                                        },
                                        {
                                            "id": "400123110",
                                            "speaker": "雷泽",
                                            "text": "你的味道…好闻。",
                                            "choices": [
                                                {
                                                    "id": "400123106",
                                                    "text": "关于气味…"
                                                },
                                                {
                                                    "id": "400123111",
                                                    "text": "关于海岛…",
                                                    "response": [
                                                        {
                                                            "id": "400123112",
                                                            "speaker": "雷泽",
                                                            "text": "水…太多了…"
                                                        },
                                                        {
                                                            "id": "400123113",
                                                            "speaker": "雷泽",
                                                            "text": "左边，右边…全是。"
                                                        },
                                                        {
                                                            "id": "400123114",
                                                            "speaker": "雷泽",
                                                            "text": "不过…我喜欢游泳。",
