    "dialogues": [
        {
            "id": "660100501",
            "speaker": "Player",
            "text": "近况如何？"
        },
        {
            "id": "660100502",
            "speaker": "夏安卡",
            "text": "多谢关心，一切都好。"
        },
        {
            "id": "660100503",
            "speaker": "夏安卡",
            "text": "战后有不少老战友来我这里聚餐，虽然大家各有各的伤，但看起来都挺开心的。"
        },
        {
            "id": "660100504",
            "speaker": "夏安卡",
            "text": "…当然，也可能是不想在我面前展现出不开心的样子吧。"
        },
        {
            "id": "660100505",
            "speaker": "夏安卡",
            "text": "因为旧伤，我已经帮不上他们的忙了，只好请他们多吃几顿了。"
        }
    ]
}