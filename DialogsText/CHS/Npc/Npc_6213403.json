    "dialogues": [
        {
            "id": "621340301",
            "speaker": "Player",
            "text": "「掇星攫辰天君」其实是骗子…"
        },
        {
            "id": "621340302",
            "speaker": "星辰君",
            "text": "说什么呢，说什么呢！"
        },
        {
            "id": "621340303",
            "speaker": "星辰君",
            "text": "你敢在信众面前诬蔑星辰天君？你这人，你这人简直…"
        },
        {
            "id": "621340304",
            "speaker": "星辰君",
            "text": "…哼，仙家教导不能说粗话，何况我还戴着星辰天君大人的面具。"
        },
        {
            "id": "621340305",
            "speaker": "星辰君",
            "text": "快走吧走吧，不想和你说话，我看你才是骗子。"
        }
    ]
}