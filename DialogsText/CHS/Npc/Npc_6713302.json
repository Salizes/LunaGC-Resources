{
    "talkId": "6713302",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 1,
        "伊涅芙": 2,
        "派蒙": 3,
        "爱诺": 6
    },
    "dialogues": [
        {
            "id": "671330201",
            "speaker": "派蒙",
            "text": "是爱诺！嘿嘿，你在这里干什么呀？"
        },
        {
            "id": "671330202",
            "speaker": "爱诺",
            "text": "是你们呀，你们来的正好，我在玩呢，嘿嘿，要一起吗？"
        },
        {
            "id": "671330203",
            "speaker": "Player",
            "text": "伊涅芙没有和你一起玩吗？"
        },
        {
            "id": "671330204",
            "speaker": "爱诺",
            "text": "当然有呀，她最喜欢和我一起玩了。"
        },
        {
            "id": "671330205",
            "speaker": "派蒙",
            "text": "欸？她在哪里呀？"
        },
        {
            "id": "671330206",
            "speaker": "爱诺",
            "text": "喏。"
        },
        {
            "id": "671330207",
            "speaker": "伊涅芙",
            "text": "救——命——啊——"
        },
        {
            "id": "671330208",
            "speaker": "爱诺",
            "text": "这就是伊涅芙最喜欢玩的「叮铃哐啷爱诺翱翔」，她说这样既能开拓视野，又能活动筋骨。"
        },
        {
            "id": "671330209",
            "speaker": "派蒙",
            "text": "可是她在喊救命欸！"
        },
        {
            "id": "671330210",
            "speaker": "爱诺",
            "text": "那是为了娱乐效果啦，不信你们看。"
        },
        {
            "id": "671330211",
            "speaker": "爱诺",
            "text": "伊涅芙，该回家啦！"
        },
        {
            "id": "671330212",
            "speaker": "伊涅芙",
            "text": "不——要——！还——没——玩——够——"
        }
    ]
}