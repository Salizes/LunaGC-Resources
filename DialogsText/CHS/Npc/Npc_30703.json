{
    "talkId": "30703",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "凯亚": 11
    },
    "dialogues": [
        {
            "id": "3070301",
            "speaker": "凯亚",
            "text": "你风之翼用得不错，在哪学的呢？",
            "choices": [
                {
                    "id": "3070302",
                    "text": "你的眼罩？",
                    "response": [
                        {
                            "id": "3070303",
                            "speaker": "凯亚",
                            "text": "眼罩…怎么，想听我的故事？"
                        },
                        {
                            "id": "3070304",
                            "speaker": "凯亚",
                            "text": "嗯，说起来之前都没好好自我介绍过…"
                        },
                        {
                            "id": "3070305",
                            "speaker": "凯亚",
                            "text": "哈哈哈，抱歉了，我是骑兵队长凯亚。"
                        },
                        {
                            "id": "3070306",
                            "speaker": "凯亚",
                            "text": "等手头的问题解决了，我们再好好聊聊吧。"
                        },
                        {
                            "id": "3070307",
                            "speaker": "凯亚",
                            "text": "我知道一个好地方，那边更有聊天的氛围。"
                        }
                    ]
                },
                {
                    "id": "3070308",
                    "text": "琴为什么是「代理团长」？",
                    "response": [
                        {
                            "id": "3070309",
                            "speaker": "凯亚",
                            "text": "大团长现在正处于长期离开的状态，所以由副团长琴代行团长职责…"
                        },
                        {
                            "id": "3070310",
                            "speaker": "凯亚",
                            "text": "——这就是「代理团长」这称呼的来源了。"
                        },
                        {
                            "id": "3070311",
                            "speaker": "凯亚",
                            "text": "而且大团长走的时候，带走了五分之四的骑士，所以留给「代理团长」的，自然就是五倍的压力了。"
                        },
                        {
                            "id": "3070312",
                            "speaker": "凯亚",
                            "text": "这么说起来，琴还真是不容易呢，呵呵。"
                        }
                    ]
                },
                {
                    "id": "3070313",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "3070314",
                            "speaker": "凯亚",
                            "text": "嗯，那就回头见。"
                        }
                    ]
                }
            ]
        }
    ]
}