    "dialogues": [
        {
            "id": "660340301",
            "speaker": "Player",
            "text": "我也喜欢薄荷。"
        },
        {
            "id": "660340302",
            "speaker": "莎娜",
            "text": "哦吼…清新的回味，和冰凉的口感，就像把手放在了刚擦拭干净的机械上…"
        },
        {
            "id": "660340303",
            "speaker": "莎娜",
            "text": "钢铁的味道，也和薄荷的青涩如出一辙！"
        },
        {
            "id": "660340304",
            "speaker": "莎娜",
            "text": "…当然，薄荷可以吃，但冰凉的铁块我不推荐大家去舔。"
        }
    ]
}