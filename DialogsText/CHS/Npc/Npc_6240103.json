{
    "talkId": "6240103",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "霹雳闪雷真君": 7
    },
    "dialogues": [
        {
            "id": "624010301",
            "speaker": "Player",
            "text": "求仙问道？"
        },
        {
            "id": "624010302",
            "speaker": "霹雳闪雷真君",
            "text": "对喽！有道是「先贤大能寻不得，便入破庙拜老仙」！"
        },
        {
            "id": "624010303",
            "speaker": "霹雳闪雷真君",
            "text": "这您就要问了，求的什么仙？便是老夫。问的什么道？便是老夫的绝世武功之道。",
            "choices": [
                {
                    "id": "624010304",
                    "text": "这都什么乱七八糟的…",
                    "response": [
                        {
                            "id": "624010305",
                            "speaker": "霹雳闪雷真君",
                            "text": "去！去！你这是对仙人不敬你知道吗！"
                        },
                        {
                            "id": "624010306",
                            "speaker": "霹雳闪雷真君",
                            "text": "错过了向老夫求道的机会，你就一辈子后悔去吧！"
                        }
                    ]
                },
                {
                    "id": "624010307",
                    "text": "你都教些什么？",
                    "response": [
                        {
                            "id": "624010308",
                            "speaker": "霹雳闪雷真君",
                            "text": "我呀，我教…不对，仙人的「道」，那能随便说吗！"
                        },
                        {
                            "id": "624010309",
                            "speaker": "霹雳闪雷真君",
                            "text": "你也不能说「教」，那叫「传」，这都有讲究的。"
                        },
                        {
                            "id": "624010310",
                            "speaker": "霹雳闪雷真君",
                            "text": "你要想知道，那这样：一个月七千摩拉，我传你武功秘籍，保你拳脚快如流星，轻若蝴蝶！"
                        }
                    ]
                }
            ]
        }
    ]
}