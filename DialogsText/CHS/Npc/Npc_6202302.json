    "dialogues": [
        {
            "id": "620230201",
            "speaker": "Player",
            "text": "你是…？"
        },
        {
            "id": "620230202",
            "speaker": "琳琅",
            "text": "你好，我是希古居的老板，叫我琳琅就好。"
        },
        {
            "id": "620230203",
            "speaker": "琳琅",
            "text": "真是不好意思，古董行还没开门呢，请晚些再来希古居找我吧。"
        },
        {
            "id": "620230204",
            "speaker": "Player",
            "text": "关于希古居。"
        },
        {
            "id": "620230205",
            "speaker": "琳琅",
            "text": "怎么，你也对古董感兴趣吗？"
        },
        {
            "id": "620230206",
            "speaker": "琳琅",
            "text": "那么我希望你今晚能来敝店一叙。"
        },
        {
            "id": "620230207",
            "speaker": "琳琅",
            "text": "不过现在是我的早餐后散步时间，不好意思啦。"
        }
    ]
