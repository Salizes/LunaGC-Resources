    "dialogues": [
        {
            "id": "709360101",
            "speaker": "Player",
            "text": "海滩好玩吗？"
        },
        {
            "id": "709360102",
            "speaker": "小威",
            "text": "嗯，和蒙德城里的风景完全不一样。"
        },
        {
            "id": "709360103",
            "speaker": "小威",
            "text": "我还抓到了鱼呢，鳞片滑滑的好难抓哦…起码比小吉的螃蟹难抓多了。"
        },
        {
            "id": "709360104",
            "speaker": "小威",
            "text": "不过我也没地方能养着它，就送给你吧。"
        }
    ]
}