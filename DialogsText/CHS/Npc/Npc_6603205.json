    "dialogues": [
        {
            "id": "660320501",
            "speaker": "Player",
            "text": "可以请你拍照吗？"
        },
        {
            "id": "660320502",
            "speaker": "尤季娜",
            "text": "这个恕难从命。"
        },
        {
            "id": "660320503",
            "speaker": "尤季娜",
            "text": "以前也有人问过我，能不能买我拍的画片去找选手签名，但为了避免高价倒卖，我还是一律谢绝了。"
        },
        {
            "id": "660320504",
            "speaker": "尤季娜",
            "text": "再加上辅助裁判的事情时有发生，为了公正起见，我是不接私人委托的，还请见谅。"
        }
    ]
}