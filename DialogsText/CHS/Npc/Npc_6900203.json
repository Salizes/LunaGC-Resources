{
    "talkId": "6900203",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "神里绫华": 14
    },
    "dialogues": [
        {
            "id": "690020301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690020302",
            "speaker": "神里绫华",
            "text": "嗯，我很乐意。不过，话题的话…",
            "choices": [
                {
                    "id": "690020303",
                    "text": "就聊绫华喜欢的「雅乐诗词」吧。",
                    "response": [
                        {
                            "id": "690020304",
                            "speaker": "神里绫华",
                            "text": "嗯，对风雅之物的喜爱，最初是因为家教的缘故。"
                        },
                        {
                            "id": "690020305",
                            "speaker": "神里绫华",
                            "text": "每当细细揣摩之时，我常常能够感受到作者的情思。"
                        },
                        {
                            "id": "690020306",
                            "speaker": "神里绫华",
                            "text": "借由作者的眼睛，就能身临其境地看见世间万景。即使是熟悉的风物，也会萌生更深一层的感触。"
                        },
                        {
                            "id": "690020311",
                            "speaker": "Player",
                            "text": "我也有同感。"
                        },
                        {
                            "id": "690020312",
                            "speaker": "神里绫华",
                            "text": "「山茶落花，零落于昨日旧雨。」"
                        },
                        {
                            "id": "690020313",
                            "speaker": "神里绫华",
                            "text": "……"
                        },
                        {
                            "id": "690020314",
                            "speaker": "神里绫华",
                            "text": "仅仅读着就会感伤，这大概就是人们所说的「艺术的感染力」吧。"
                        },
                        {
                            "id": "690020315",
                            "speaker": "神里绫华",
                            "text": "啊…一不留神都在聊我的事情。"
                        },
                        {
                            "id": "690020316",
                            "speaker": "神里绫华",
                            "text": "明明还想趁着跟你聊天的机会，多了解你一些的…"
                        },
                        {
                            "id": "690020317",
                            "speaker": "神里绫华",
                            "text": "拜托了，再占用你一点时间，和我聊聊你喜欢的东西吧。"
                        },
                        {
                            "id": "690020318",
                            "speaker": "神里绫华",
                            "text": "…可以吗？"
                        }
                    ]
                },
                {
                    "id": "690020307",
                    "text": "就聊绫华喜欢的「风花雪月」吧。",
                    "response": [
                        {
                            "id": "690020308",
                            "speaker": "神里绫华",
                            "text": "若说起自然之景，就不得不提起，稻妻的人们相信万物有灵。"
                        },
                        {
                            "id": "690020309",
                            "speaker": "神里绫华",
                            "text": "风花雪月，虽然作为我们熟知的事物存在于世界之中，但也应有属于它们自己的「感情」。"
                        },
                        {
                            "id": "690020310",
                            "speaker": "神里绫华",
                            "text": "我觉得，至少这是一种很浪漫的想法。"
                        }
                    ]
                }
            ]
        }
    ]
}