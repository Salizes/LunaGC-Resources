{
    "talkId": "7106226",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "安东": 15
    },
    "dialogues": [
        {
            "id": "710622601",
            "speaker": "安东",
            "text": "我们很快就会撤离，如果阻碍了你的冒险，那么实属抱歉。",
            "choices": [
                {
                    "id": "710622602",
                    "text": "关于与千岩军的合作…",
                    "response": [
                        {
                            "id": "710622603",
                            "speaker": "安东",
                            "text": "很久以前的事情了，这里刚刚封闭，我们就找上了璃月的七星。"
                        },
                        {
                            "id": "710622604",
                            "speaker": "安东",
                            "text": "开始大家谈得还可以…「女士」大人还顺势谈成了几笔有利于双方的贸易协定。"
                        },
                        {
                            "id": "710622605",
                            "speaker": "安东",
                            "text": "而愚人众先遣部队进驻层岩巨渊，原本是附加条件之一…我们来到这里为的是调查和消灭异变源头。"
                        },
                        {
                            "id": "710622606",
                            "speaker": "安东",
                            "text": "我们调查所得的一切情报，则是由至冬国和璃月公平共享。"
                        },
                        {
                            "id": "710622607",
                            "speaker": "Player",
                            "text": "你们没有别的目的了吗？"
                        },
                        {
                            "id": "710622608",
                            "speaker": "安东",
                            "text": "至少就我们所知，没有。我们出发时还受到了市民们的祝福，大家都认为…我们是牺牲自己保护别人的英雄部队。"
                        },
                        {
                            "id": "710622609",
                            "speaker": "安东",
                            "text": "唉…谁知道，现在事情变成了这样。"
                        }
                    ]
                },
                {
                    "id": "710622610",
                    "text": "关于「黑灾」…",
                    "response": [
                        {
                            "id": "710622611",
                            "speaker": "安东",
                            "text": "或者「漆黑灾祸」，或者随便怎么称呼…五百年前的那场大灾难。"
                        },
                        {
                            "id": "710622612",
                            "speaker": "安东",
                            "text": "总之…是我们至冬人永恒的敌人，我们相信的是…五百年来，灾祸一直在潜伏着，而我们会永远保持警惕。"
                        }
                    ]
                },
                {
                    "id": "710622613",
                    "text": "关于你们自己…",
                    "response": [
                        {
                            "id": "710622614",
                            "speaker": "安东",
                            "text": "我们自己？有什么好说的…我们在努力奋战了，但失败了，就这么简单。"
                        },
                        {
                            "id": "710622615",
                            "speaker": "安东",
                            "text": "下来的时候我们是第九连队，六十四人。可到现在呢？包括连长在内…牺牲或失踪的可能超过一半以上，也可能不到…"
                        },
                        {
                            "id": "710622616",
                            "speaker": "安东",
                            "text": "但大体差不多…我们已经输了，早就该撤离了…"
                        },
                        {
                            "id": "710622617",
                            "speaker": "Player",
                            "text": "你们在地面的同僚攻击了璃月港。"
                        },
                        {
                            "id": "710622618",
                            "speaker": "安东",
                            "text": "…很惊讶，但完全理解。"
                        },
                        {
                            "id": "710622619",
                            "speaker": "安东",
                            "text": "为了协助更有意义的冒险，「公鸡」大人自然会抛弃相对低价值的资产，这是他的理性。"
                        },
                        {
                            "id": "710622620",
                            "speaker": "安东",
                            "text": "我们作为他的直属部下，对此完全可以接受…"
                        }
                    ]
                }
            ]
        }
    ]
}