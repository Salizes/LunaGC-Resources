    "dialogues": [
        {
            "id": "660420401",
            "speaker": "Player",
            "text": "哦吼，在纳塔很难卖吧。"
        },
        {
            "id": "660420402",
            "speaker": "伊赫卡",
            "text": "呃…嗯…唔…"
        },
        {
            "id": "660420403",
            "speaker": "伊赫卡",
            "text": "也、也不能说难卖吧，只能说使用场景比较的，呃，「单一」。"
        },
        {
            "id": "660420404",
            "speaker": "伊赫卡",
            "text": "一般来讲，绵驮兽的毛只有烟谜主的人在织毯子时会用到。"
        },
        {
            "id": "660420405",
            "speaker": "伊赫卡",
            "text": "但绵驮兽本身的用处就比较多了，可以当作驮运工具，同时也是很不错的耕地帮手。"
        }
    ]
}