{
    "talkId": "1503208",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 2,
        "派蒙": 2,
        "赞玛兰": 9
    },
    "dialogues": [
        {
            "id": "150320801",
            "speaker": "赞玛兰",
            "text": "……",
            "choices": [
                {
                    "id": "150320802",
                    "text": "关于「蕈之贤主」…",
                    "response": [
                        {
                            "id": "150320803",
                            "speaker": "赞玛兰",
                            "text": "…有智慧者提到了久远之名，它是元祖，空有力量，却无智慧，连四脚的也比不上。"
                        },
                        {
                            "id": "150320804",
                            "speaker": "赞玛兰",
                            "text": "用两脚的话说，它是「笨蛋父亲」。"
                        },
                        {
                            "id": "150320805",
                            "speaker": "派蒙",
                            "text": "真是简单易懂的评价啊。"
                        },
                        {
                            "id": "150320806",
                            "speaker": "赞玛兰",
                            "text": "它与我早无关联，我都快忘了这个名字，说不出更多有趣的事。但你们来看我，很有趣。"
                        },
                        {
                            "id": "150320807",
                            "speaker": "赞玛兰",
                            "text": "嗯…它还好吗？"
                        },
                        {
                            "id": "150320808",
                            "speaker": "派蒙",
                            "text": "比你差远了。"
                        },
                        {
                            "id": "150320809",
                            "speaker": "赞玛兰",
                            "text": "那就好。"
                        }
                    ]
                },
                {
                    "id": "150320810",
                    "text": "静静聆听…",
                    "response": [
                        {
                            "id": "150320811",
                            "speaker": "赞玛兰",
                            "text": "…愚痴未尝不是福气，有智也可招来祸灾…"
                        },
                        {
                            "id": "150320812",
                            "speaker": "赞玛兰",
                            "text": "…经智慧的灵浆浇灌过的生命才能如此茁壮…"
                        },
                        {
                            "id": "150320813",
                            "speaker": "赞玛兰",
                            "text": "…唯漂泊的冒险者无惧旷野的荒凉…"
                        }
                    ]
                }
            ]
        }
    ]
}