{
    "talkId": "6912302",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 9,
        "杜林": 16
    },
    "dialogues": [
        {
            "id": "691230201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691230202",
            "speaker": "杜林",
            "text": "嗯。虽然对于我来说，这里同样是新奇的地方…"
        },
        {
            "id": "691230203",
            "speaker": "杜林",
            "text": "但跟我刚到须弥，或者刚到蒙德时那种既激动又有点局促的心情不同，我在这里感到很安心和自在。"
        },
        {
            "id": "691230204",
            "speaker": "Player",
            "text": "那就好，需要什么跟我说哦！"
        },
        {
            "id": "691230205",
            "speaker": "杜林",
            "text": "谢谢，这里的东西很齐全，没什么额外要增添的了。"
        },
        {
            "id": "691230206",
            "speaker": "杜林",
            "text": "倒是有一些用不上的东西，我不应该占一个使用名额。"
        },
        {
            "id": "691230207",
            "speaker": "杜林",
            "text": "比如原先为我准备的松软的床铺，或许可以让给有需要的客人？"
        },
        {
            "id": "691230208",
            "speaker": "杜林",
            "text": "放心，我没有弄脏。"
        },
        {
            "id": "691230209",
            "speaker": "杜林",
            "text": "我把被子叠好放回柜子吧，之前我向一位优秀的女仆学习了实用的收纳技巧，现在正好有机会练手了。"
        },
        {
            "id": "691230210",
            "speaker": "Player",
            "text": "啊？是床不舒服吗？"
        },
        {
            "id": "691230211",
            "speaker": "杜林",
            "text": "床很好。只是我习惯在狭小逼仄的地方睡觉，这样会有安全感。"
        },
        {
            "id": "691230212",
            "speaker": "杜林",
            "text": "我自己选过一些睡觉的好地方。小沙发，还有衣橱里面。"
        },
        {
            "id": "691230213",
            "speaker": "杜林",
            "text": "这里不会有猫咪因为我睡了它们的地盘而过来赶我挠我，每晚都睡得很沉，很舒服。",
            "choices": [
                {
                    "id": "691230214",
                    "text": "完啦，我养猫了！",
                    "response": [
                        {
                            "id": "691230215",
                            "speaker": "杜林",
                            "text": "那…那我会把位置还给它的，再去找个新地方。我不想吓到小猫…",
                            "choices": [
                                {
                                    "id": "691230216",
                                    "text": "放心，我的猫不怕你。",
                                    "response": [
                                        {
                                            "id": "691230218",
                                            "speaker": "杜林",
                                            "text": "非常欢迎！"
                                        },
                                        {
                                            "id": "691230219",
                                            "speaker": "杜林",
                                            "text": "那从今晚起，我睡觉前腾出一点位置来，留给猫咪。"
                                        }
                                    ]
                                },
                                {
                                    "id": "691230217",
                                    "text": "还会跟你一起睡觉。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691230220",
                    "text": "我做一个属于杜林的「窝」吧！",
                    "response": [
                        {
                            "id": "691230221",
                            "speaker": "杜林",
                            "text": "像阿贝多那样，画一个出来吗？会麻烦你吗？",
                            "choices": [
                                {
                                    "id": "691230222",
                                    "text": "很抱歉，我不会炼金术。",
                                    "response": [
                                        {
                                            "id": "691230224",
                                            "speaker": "杜林",
                                            "text": "这样的「窝」我还第一次拥有，我会好好爱惜的。"
                                        },
                                        {
                                            "id": "691230225",
                                            "speaker": "杜林",
                                            "text": "请让我也一起动手帮忙吧！"
                                        }
                                    ]
                                },
                                {
                                    "id": "691230223",
                                    "text": "但亲手做一个也很简单！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}