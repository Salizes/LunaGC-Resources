    "dialogues": [
        {
            "id": "620070601",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "620070602",
            "speaker": "一柱",
            "text": "我叫一柱，你一定也见过我妹妹一弦吧？"
        },
        {
            "id": "620070603",
            "speaker": "一柱",
            "text": "最近…家里空荡荡了很多，我怕弦儿会觉得寂寞，所以想要买件玩具陪她。"
        },
        {
            "id": "620070604",
            "speaker": "一柱",
            "text": "长顺姐姐听了我的事，说可以免费挑一件玩具带回家，最近大家真的对我们兄妹很温柔…"
        },
        {
            "id": "620070605",
            "speaker": "一柱",
            "text": "……"
        },
        {
            "id": "620070606",
            "speaker": "一柱",
            "text": "…不行，不能哭，要笑给妹妹看。"
        }
    ]
