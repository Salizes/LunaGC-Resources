    },
    "dialogues": [
        {
            "id": "641290501",
            "speaker": "Player",
            "text": "关于「花神诞祭」…"
        },
        {
            "id": "641290502",
            "speaker": "帕丽莎",
            "text": "「花神诞祭」是我们须弥的神明——草神大人的生日祭典。"
        },
        {
            "id": "641290503",
            "speaker": "帕丽莎",
            "text": "只可惜，在树王大人逝去后，「花神诞祭」虽然被重新定在了小草神大人的生日那天，却失去了往日的荣光…"
        },
        {
            "id": "641290504",
            "speaker": "帕丽莎",
            "text": "教令院不再主办这个节日，大家能看到「花神之舞」的机会也几乎没有了。"
        },
        {
            "id": "641290505",
            "speaker": "帕丽莎",
            "text": "唉，真是可惜啊…"
        }
    ]
}