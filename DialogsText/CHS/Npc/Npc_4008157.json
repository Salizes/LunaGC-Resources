{
    "talkId": "4008157",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "留言板": 9
    },
    "dialogues": [
        {
            "id": "400815701",
            "speaker": "留言板",
            "text": "「感谢各位选手带来的精彩比赛！感谢各位观众的支持！首届『月莲杯驯兽师大赛』至此完满落幕了…」",
            "choices": [
                {
                    "id": "400815702",
                    "text": "继续阅读公告…",
                    "response": [
                        {
                            "id": "400815703",
                            "speaker": "留言板",
                            "text": "「尽管在决赛前后，发生了一些小小的插曲，但我们的冠军『黄金流星』和『白银伴星』已将问题全都处理完毕！」"
                        },
                        {
                            "id": "400815704",
                            "speaker": "留言板",
                            "text": "「由于技术缺陷，暂不能确定下一届『月莲杯驯兽师大赛』的举办时间，不过我们承诺，一定会尽早解决难题，让赛事重回正轨！」"
                        },
                        {
                            "id": "400815705",
                            "speaker": "留言板",
                            "text": "「届时还请各位继续支持我们！」"
                        }
                    ]
                },
                {
                    "id": "400815706",
                    "text": "「最受『支持』的留言」",
                    "response": [
                        {
                            "id": "400815707",
                            "speaker": "留言板",
                            "text": "「虽然很希望『月莲杯』能不间断地举办下去，但在详细了解『意智宝珠』的缺陷后，我完全能理解『白银伴星』的决定了！」"
                        },
                        {
                            "id": "400815708",
                            "speaker": "留言板",
                            "text": "「安全和健康重要，选手们都要平安无事啊，这样才能维持和蕈兽伙伴们的友情，继续给我们带来精彩的比赛！」"
                        },
                        {
                            "id": "400815709",
                            "speaker": "留言板",
                            "text": "（留言中还有许多对赛事状况的讨论，大家都对派蒙的决定表示理解，关心着选手们的身体状况，并希望赛事能正常举办下去。）"
                        }
                    ]
                },
                {
                    "id": "400815710",
                    "text": "「最被『反对』的留言」",
                    "response": [
                        {
                            "id": "400815711",
                            "speaker": "留言板",
                            "text": "（经历过激烈的比赛和派蒙发表的冠军演讲后，大家好像都很满意，没有在留言板上发表不和谐的声音了…）"
                        },
                        {
                            "id": "400815712",
                            "speaker": "留言板",
                            "text": "……"
                        }
                    ]
                },
                {
                    "id": "400815713",
                    "text": "离去。"
                }
            ]
        }
    ]
}