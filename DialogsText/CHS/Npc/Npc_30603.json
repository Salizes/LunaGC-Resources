{
    "talkId": "30603",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "安柏": 8
    },
    "dialogues": [
        {
            "id": "3060301",
            "speaker": "安柏",
            "text": "要和我组队吗？事先声明，我可不会特意配合新手放慢步调喔。",
            "choices": [
                {
                    "id": "3060302",
                    "text": "琴团长看起来很可靠呢。",
                    "response": [
                        {
                            "id": "3060303",
                            "speaker": "安柏",
                            "text": "有琴在，我们就安心了——虽然很想这么说…"
                        },
                        {
                            "id": "3060304",
                            "speaker": "安柏",
                            "text": "但实在不能总把这句话挂在嘴边。"
                        },
                        {
                            "id": "3060305",
                            "speaker": "安柏",
                            "text": "她总是冲在最前面，我们也希望她能好好休息。"
                        },
                        {
                            "id": "3060306",
                            "speaker": "安柏",
                            "text": "希望有一天可以认真地告诉琴，有我们在，你就可以安心了…"
                        }
                    ]
                },
                {
                    "id": "3060307",
                    "text": "关于风之翼。",
                    "response": [
                        {
                            "id": "3060308",
                            "speaker": "安柏",
                            "text": "身为西风骑士团的新人，对「风」的领会是不可或缺的品质。"
                        },
                        {
                            "id": "3060309",
                            "speaker": "安柏",
                            "text": "那么，风之翼的深入培训就交给我吧~！"
                        }
                    ]
                },
                {
                    "id": "3060310",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "3060311",
                            "speaker": "安柏",
                            "text": "嗯，风魔龙的事，一起加把劲吧！"
                        }
                    ]
                }
            ]
        }
    ]
}