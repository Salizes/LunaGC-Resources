{
    "talkId": "6908707",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "那维莱特": 10
    },
    "dialogues": [
        {
            "id": "690870201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690870202",
            "speaker": "那维莱特",
            "text": "风景宜人，让人心情愉快。"
        },
        {
            "id": "690870203",
            "speaker": "那维莱特",
            "text": "但我想问一下，这里不会下雨是吗？",
            "choices": [
                {
                    "id": "690870204",
                    "text": "确实不会。",
                    "response": [
                        {
                            "id": "690870205",
                            "speaker": "那维莱特",
                            "text": "我明白了。"
                        },
                        {
                            "id": "690870206",
                            "speaker": "那维莱特",
                            "text": "想来也是，开辟如此一方天地就是为了方便遮风挡雨。"
                        },
                        {
                            "id": "690870207",
                            "speaker": "那维莱特",
                            "text": "不必在意，没什么。"
                        }
                    ]
                },
                {
                    "id": "690870208",
                    "text": "但是我们这里有稻妻的温泉。",
                    "response": [
                        {
                            "id": "690870209",
                            "speaker": "那维莱特",
                            "text": "哦，那太好了。"
                        },
                        {
                            "id": "690870210",
                            "speaker": "那维莱特",
                            "text": "我对于稻妻的温泉早有耳闻，没想到能在你这里得以一见。"
                        },
                        {
                            "id": "690870211",
                            "speaker": "那维莱特",
                            "text": "…你说水源只是人工加热的吗？"
                        },
                        {
                            "id": "690870212",
                            "speaker": "那维莱特",
                            "text": "这也不要紧。我早已听说稻妻本无天然温泉，现有的设施也是由他们的财务部引进并开发出来的。"
                        },
                        {
                            "id": "690870213",
                            "speaker": "那维莱特",
                            "text": "差不多也是原汁原味的温泉体验了。"
                        }
                    ]
                }
            ]
        }
    ]
}