{
    "talkId": "4008118",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 3,
        "荒谷": 19
    },
    "dialogues": [
        {
            "id": "400811801",
            "speaker": "荒谷",
            "text": "你们好呀，八重大人的贵客，将军大人的座上宾。",
            "choices": [
                {
                    "id": "400811802",
                    "text": "你是…",
                    "response": [
                        {
                            "id": "400811803",
                            "speaker": "荒谷",
                            "text": "咦，居然不记得我了吗？"
                        },
                        {
                            "id": "400811804",
                            "speaker": "荒谷",
                            "text": "我是八重堂的策划，「这本小说真厉害！」幕后的操办人，之前我还有幸见过你们。"
                        },
                        {
                            "id": "400811805",
                            "speaker": "派蒙",
                            "text": "好像…有一点印象？"
                        },
                        {
                            "id": "400811806",
                            "speaker": "荒谷",
                            "text": "这次偶遇后，你们应该就会记住我了。"
                        },
                        {
                            "id": "400811807",
                            "speaker": "荒谷",
                            "text": "毕竟有了这次的经验，我会为八重堂的下一次活动注入超棒的创意，成为鼎鼎有名的策划…不愧是我！"
                        }
                    ]
                },
                {
                    "id": "400811808",
                    "text": "关于你们的游玩计划…",
                    "response": [
                        {
                            "id": "400811809",
                            "speaker": "荒谷",
                            "text": "啊，计划就是尽可能走遍每个出名的地方。"
                        },
                        {
                            "id": "400811810",
                            "speaker": "荒谷",
                            "text": "听说须弥有很多绝景，盘踞着各种神奇的动物。知性的学者和高尚的巡林员们来来往往，还有神秘、危险而诱人的佣兵团体。"
                        },
                        {
                            "id": "400811811",
                            "speaker": "荒谷",
                            "text": "作家来这里找灵感，岂不是就像喝水一样容易？"
                        },
                        {
                            "id": "400811812",
                            "speaker": "荒谷",
                            "text": "我原本建议八重大人带更多作者来取材，不过八重大人说，「重要的是质量而不是数量」，拿着名单随便翻翻，就选中了左右加。"
                        },
                        {
                            "id": "400811813",
                            "speaker": "荒谷",
                            "text": "其实左右加还没有什么出名的作品呢，只是因为文笔不错，还有着很容易入戏的性格，才被我列入备选名单的。"
                        },
                        {
                            "id": "400811814",
                            "speaker": "派蒙",
                            "text": "原来左右加小姐是这样被选中的吗…总感觉有点随便，但很符合神子的作风呢。"
                        },
                        {
                            "id": "400811815",
                            "speaker": "Player",
                            "text": "也许神子想试试亲手培养新人。"
                        },
                        {
                            "id": "400811816",
                            "speaker": "荒谷",
                            "text": "喔！居然猜的这么准！"
                        },
                        {
                            "id": "400811817",
                            "speaker": "荒谷",
                            "text": "八重大人也说过，「向着最有趣的方向发掘出新人的潜力，是难得的体验。」"
                        },
                        {
                            "id": "400811818",
                            "speaker": "荒谷",
                            "text": "当然，考虑到老派的作者们都有了自己习惯的写作风格，要把另一个国度的元素和谐地融会到小说里，新人反而可能更有优势。"
                        },
                        {
                            "id": "400811819",
                            "speaker": "荒谷",
                            "text": "不愧是八重大人！现在看来，左右加确实是这次须弥之行的最佳人选！"
                        }
                    ]
                },
                {
                    "id": "400811820",
                    "text": "关于八重神子…",
                    "response": [
                        {
                            "id": "400811821",
                            "speaker": "荒谷",
                            "text": "果然，你们更关注八重大人的去向。"
                        },
                        {
                            "id": "400811822",
                            "speaker": "荒谷",
                            "text": "不过遗憾的是，八重大人只在特定的几天安排了我们的行程，余下的时间，我们都是自由行动的。"
                        },
                        {
                            "id": "400811823",
                            "speaker": "荒谷",
                            "text": "比如我，就在这里考察驯兽师大赛的规划细节，真愉快。"
                        },
                        {
                            "id": "400811824",
                            "speaker": "荒谷",
                            "text": "至于自由行动期间，八重大人究竟去了什么地方…这属于她的私人事宜，不是我这个一般策划有资格知道的事情哦。"
                        },
                        {
                            "id": "400811825",
                            "speaker": "派蒙",
                            "text": "呃，想来也是，以神子的性格，应该不会喜欢那种满满当当的行程表吧。"
                        }
                    ]
                },
                {
                    "id": "400811826",
                    "text": "玩得开心！",
                    "response": [
                        {
                            "id": "400811827",
                            "speaker": "荒谷",
                            "text": "你们也是哦，祝你们比赛顺利！"
                        }
                    ]
                }
            ]
        }
    ]
}