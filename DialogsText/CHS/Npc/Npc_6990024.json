    "dialogues": [
        {
            "id": "699002401",
            "speaker": "Player",
            "text": "关于祭典的传统…"
        },
        {
            "id": "699002402",
            "speaker": "派蒙",
            "text": "说起来，在稻妻的祭典上，大家都有佩戴面具的传统呢。"
        },
        {
            "id": "699002403",
            "speaker": "派蒙",
            "text": "可是找遍所有的摊位，都没有适合我戴的尺寸…"
        },
        {
            "id": "699002404",
            "speaker": "Player",
            "text": "派蒙很想要自己的面具吗？"
        },
        {
            "id": "699002405",
            "speaker": "派蒙",
            "text": "当然啦！总觉得在祭典的氛围里，如果没戴面具，就好像在风花节上没收到花束一样…"
        },
        {
            "id": "699002406",
            "speaker": "Player",
            "text": "那我来给你做一个吧。"
        },
        {
            "id": "699002407",
            "speaker": "派蒙",
            "text": "#哇——{NICKNAME}，你是最好的人！",
            "choices": [
                {
                    "id": "699002408",
                    "text": "嗯，面具的样式就定为…",
                    "response": [
                        {
                            "id": "699002410",
                            "speaker": "派蒙",
                            "text": "好耶，史莱姆派蒙！"
                        }
                    ]
                },
                {
                    "id": "699002409",
                    "text": "派蒙最喜欢的史莱姆吧。"
                }
            ]
        }
    ]
}