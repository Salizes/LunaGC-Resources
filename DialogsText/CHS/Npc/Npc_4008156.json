{
    "talkId": "4008156",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "派蒙": 6,
        "铁骨双刀": 7
    },
    "dialogues": [
        {
            "id": "400815601",
            "speaker": "铁骨双刀",
            "text": "白白白白白…「白银伴星」大人，请收我为徒吧！",
            "choices": [
                {
                    "id": "400815602",
                    "text": "你冷静点！",
                    "response": [
                        {
                            "id": "400815603",
                            "speaker": "派蒙",
                            "text": "对对对，冷静点！你是不是没睡醒，突然说什么怪话啦？"
                        },
                        {
                            "id": "400815604",
                            "speaker": "铁骨双刀",
                            "text": "我是认真的！"
                        },
                        {
                            "id": "400815605",
                            "speaker": "铁骨双刀",
                            "text": "听说你们击败海妮耶大人后，我很震惊，斗胆拜访了海妮耶小姐，得知了你们之间的故事…"
                        },
                        {
                            "id": "400815606",
                            "speaker": "铁骨双刀",
                            "text": "原来我之前错的那么离谱！我一定要悔改！还请「白银伴星」大人为我指引正确的道路！"
                        },
                        {
                            "id": "400815607",
                            "speaker": "派蒙",
                            "text": "#为什么是我啦！明明很多事情都是{NICKNAME}决定的！"
                        },
                        {
                            "id": "400815608",
                            "speaker": "铁骨双刀",
                            "text": "虽然我知道，你们两位一直同心协力，观点也绝对是一致的"
                        },
                        {
                            "id": "400815609",
                            "speaker": "铁骨双刀",
                            "text": "但「黄金流星」大人平常很少发言，高深莫测。就算接受「黄金流星」大人的教导，愚钝的我也未必能理解其中的深意。"
                        },
                        {
                            "id": "400815610",
                            "speaker": "铁骨双刀",
                            "text": "而「白银伴星」大人的发言简单明了，很好懂！所以我想跟着「白银伴星」大人好好学习一番！"
                        },
                        {
                            "id": "400815611",
                            "speaker": "派蒙",
                            "text": "#怎么办，{NICKNAME}？从没见过这样的人，之前还凶巴巴的，现在突然这么激动，根本不知道该怎么应付他。"
                        },
                        {
                            "id": "400815612",
                            "speaker": "派蒙",
                            "text": "我觉得，与其让他学这个学那个， 不如放他自己去思考一会儿。知道自己错了以后，他应该会变得稳重一点！",
                            "choices": [
                                {
                                    "id": "400815613",
                                    "text": "那就只有一个办法了…",
                                    "response": [
                                        {
                                            "id": "400815615",
                                            "speaker": "派蒙",
                                            "text": "对喔，我们赶快离这个怪人远一点！"
                                        }
                                    ]
                                },
                                {
                                    "id": "400815614",
                                    "text": "快逃！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400815616",
                    "text": "派蒙，我们快逃！",
                    "response": [
                        {
                            "id": "400815617",
                            "speaker": "派蒙",
                            "text": "不知道发生了什么…但以前从没见过这种场面，我们快逃吧！"
                        }
                    ]
                }
            ]
        }
    ]
}