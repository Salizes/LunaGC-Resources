    "dialogues": [
        {
            "id": "618440201",
            "speaker": "Player",
            "text": "和我说说这里吧。"
        },
        {
            "id": "618440202",
            "speaker": "伊斯托利亚",
            "text": "此处是空之神殿。"
        },
        {
            "id": "618440203",
            "speaker": "伊斯托利亚",
            "text": "本意是神明为了保存消亡文明历史而建设的展览馆…"
        },
        {
            "id": "618440204",
            "speaker": "伊斯托利亚",
            "text": "只是那位神明大人的姐妹们…似乎都很有自己的想法，什么东西有趣都会丢这里。"
        },
        {
            "id": "618440205",
            "speaker": "伊斯托利亚",
            "text": "所以你看到什么东西都不必奇怪。"
        }
    ]
}