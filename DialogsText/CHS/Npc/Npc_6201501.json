{
    "talkId": "6201501",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "志华": 6,
        "绮命": 6
    },
    "dialogues": [
        {
            "id": "620150101",
            "speaker": "志华",
            "text": "绮命姐，这次我想请您帮我指点一下…我的爱情运势。"
        },
        {
            "id": "620150102",
            "speaker": "绮命",
            "text": "又是爱情运势吗…这已经是这个月第十次了吧…"
        },
        {
            "id": "620150103",
            "speaker": "志华",
            "text": "因为您算得准呀，每次您都说：「太沉迷于占卜的结果，是得不到爱情的。」"
        },
        {
            "id": "620150104",
            "speaker": "志华",
            "text": "于是我决定把心思放在「占卜本身」上。"
        },
        {
            "id": "620150105",
            "speaker": "绮命",
            "text": "唔…好吧，那么我换一种说法——"
        },
        {
            "id": "620150106",
            "speaker": "绮命",
            "text": "爱情这种东西，远在天边，近在眼前。不需强求，总有一天会自己送到你眼前…说不定就是今天呢。"
        },
        {
            "id": "620150107",
            "speaker": "志华",
            "text": "哦~！我明白了，我明白了！"
        },
        {
            "id": "620150108",
            "speaker": "绮命",
            "text": "你又明白什么了？"
        },
        {
            "id": "620150109",
            "speaker": "志华",
            "text": "我们果然是心意相通的！我会努力让你幸福，你愿意和我结婚吗？！"
        },
        {
            "id": "620150110",
            "speaker": "绮命",
            "text": "…不了，谢谢。"
        },
        {
            "id": "620150111",
            "speaker": "志华",
            "text": "姐姐今晚有空吗！"
        },
        {
            "id": "620150112",
            "speaker": "绮命",
            "text": "没有，我要叫巡逻队了。"
        }
    ]
}