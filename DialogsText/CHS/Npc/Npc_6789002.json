    "dialogues": [
        {
            "id": "678900201",
            "speaker": "Player",
            "text": "你还好吗？"
        },
        {
            "id": "678900202",
            "speaker": "萨米尔卡",
            "text": "不太…好…朋友…"
        },
        {
            "id": "678900203",
            "speaker": "萨米尔卡",
            "text": "至冬…真是太…太冷了…"
        },
        {
            "id": "678900204",
            "speaker": "萨米尔卡",
            "text": "我根本…根本…没带…厚衣服…因为…"
        },
        {
            "id": "678900205",
            "speaker": "萨米尔卡",
            "text": "妈妈…说…有了勇气…就能…就能抵御「一切」…"
        },
        {
            "id": "678900206",
            "speaker": "萨米尔卡",
            "text": "也许…「一切」里面…不包括…寒冷…"
        }
    ]
}