{
    "talkId": "7505202",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "汉佩克": 7
    },
    "dialogues": [
        {
            "id": "750520201",
            "speaker": "汉佩克",
            "text": "如果用别的方法…",
            "choices": [
                {
                    "id": "750520202",
                    "text": "关于鹰羽派…",
                    "response": [
                        {
                            "id": "750520203",
                            "speaker": "汉佩克",
                            "text": "原本就是一盘散沙，现在…现在还提它做什么？就当它不存在…不，它的确已经不存在了。"
                        },
                        {
                            "id": "750520204",
                            "speaker": "汉佩克",
                            "text": "哪怕用上一点不正当的手段，我也想要保全它。我曾经是这样想的。没想到就是这点成了致命的一击…"
                        }
                    ]
                },
                {
                    "id": "750520205",
                    "text": "关于蚱蜢派…",
                    "response": [
                        {
                            "id": "750520206",
                            "speaker": "汉佩克",
                            "text": "你应该不是来奚落我的吧？"
                        },
                        {
                            "id": "750520207",
                            "speaker": "汉佩克",
                            "text": "他们当然也受到了一些轻微的影响，但是跟我所经受的相比又算得了什么？"
                        },
                        {
                            "id": "750520208",
                            "speaker": "汉佩克",
                            "text": "也许我应该做个更体面的失败者，尽早离开这里…"
                        }
                    ]
                },
                {
                    "id": "750520209",
                    "text": "不打扰了。",
                    "response": [
                        {
                            "id": "750520210",
                            "speaker": "汉佩克",
                            "text": "再见…"
                        }
                    ]
                }
            ]
        }
    ]
}