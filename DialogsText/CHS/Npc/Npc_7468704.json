{
    "talkId": "7468704",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 11,
        "弗雷瑞斯": 23
    },
    "dialogues": [
        {
            "id": "746870401",
            "speaker": "弗雷瑞斯",
            "text": "怎么样，这次的炮台体验如何？",
            "choices": [
                {
                    "id": "746870402",
                    "text": "如果还能改进就好了。",
                    "response": [
                        {
                            "id": "746870403",
                            "speaker": "弗雷瑞斯",
                            "text": "比如说？",
                            "choices": [
                                {
                                    "id": "746870404",
                                    "text": "固定一个位置有点笨…",
                                    "response": [
                                        {
                                            "id": "746870406",
                                            "speaker": "弗雷瑞斯",
                                            "text": "没想到还有这种需求…准领队果然不是凡人，充满奇思妙想。"
                                        },
                                        {
                                            "id": "746870407",
                                            "speaker": "弗雷瑞斯",
                                            "text": "但要想边走边射击，还得先承受重炮的后坐力。"
                                        },
                                        {
                                            "id": "746870408",
                                            "speaker": "弗雷瑞斯",
                                            "text": "准领队你自己的话，以肉体之躯硬接舰炮的后坐力，也不是不可能。"
                                        },
                                        {
                                            "id": "746870409",
                                            "speaker": "弗雷瑞斯",
                                            "text": "但普通警备队员极大概率被炮尾直接一下撞死…所以还得发明一个…小型地上战舰级别的平台，载着重炮到处跑。"
                                        },
                                        {
                                            "id": "746870410",
                                            "speaker": "弗雷瑞斯",
                                            "text": "这么大一个东西，也得考虑防护能力，加了装甲就会很笨重，那动力和行走机构的问题，都要纳入考虑了。"
                                        },
                                        {
                                            "id": "746870411",
                                            "speaker": "弗雷瑞斯",
                                            "text": "工程设计会变得特别复杂，像我这种被枫丹科学院拒绝了三次的普通人…能顶得住吗？"
                                        }
                                    ]
                                },
                                {
                                    "id": "746870405",
                                    "text": "我想扛它着边走边打…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "746870412",
                    "text": "你好像有点眼熟？",
                    "response": [
                        {
                            "id": "746870413",
                            "speaker": "弗雷瑞斯",
                            "text": "你还对我有点印象啊？那太好了！"
                        },
                        {
                            "id": "746870414",
                            "speaker": "弗雷瑞斯",
                            "text": "好一段时间之前，这部炮台的原型机，也是你帮忙测试的。"
                        },
                        {
                            "id": "746870415",
                            "speaker": "弗雷瑞斯",
                            "text": "那时的我，还在不断和谢妮重复着天才的谎言…",
                            "choices": [
                                {
                                    "id": "746870416",
                                    "text": "现在谎言被拆穿了？",
                                    "response": [
                                        {
                                            "id": "746870418",
                                            "speaker": "弗雷瑞斯",
                                            "text": "哈哈，都不是，谎言进化了。"
                                        },
                                        {
                                            "id": "746870419",
                                            "speaker": "弗雷瑞斯",
                                            "text": "托你的福，上次的炮台表现很棒，执律庭也适当给了我资金支持，还帮我介绍了几位工程师。"
                                        },
                                        {
                                            "id": "746870420",
                                            "speaker": "弗雷瑞斯",
                                            "text": "得到了老前辈的指教，再加拿到了枫丹科学院的很多工程废案后，我确实做出了一些东西——"
                                        },
                                        {
                                            "id": "746870421",
                                            "speaker": "弗雷瑞斯",
                                            "text": "「能挖掘地下浅层矿物的钻头」，「异构安东·罗杰飞行器」…应该说叫「弗雷瑞斯飞行器」了。"
                                        },
                                        {
                                            "id": "746870422",
                                            "speaker": "弗雷瑞斯",
                                            "text": "不过，谢妮还是最喜欢那台「早餐自动烘焙机」，她说她天天都用。",
                                            "choices": [
                                                {
                                                    "id": "746870423",
                                                    "text": "那谎言不就变成现实了吗？",
                                                    "response": [
                                                        {
                                                            "id": "746870425",
                                                            "speaker": "弗雷瑞斯",
                                                            "text": "不，我心里明白，我能做出这些东西，都是借助了别人的力量，我只是个改进者，说得难听点，「装裱匠」。"
                                                        },
                                                        {
                                                            "id": "746870426",
                                                            "speaker": "弗雷瑞斯",
                                                            "text": "真正的天才，根本不需要借助别人的外力，"
                                                        },
                                                        {
                                                            "id": "746870427",
                                                            "speaker": "弗雷瑞斯",
                                                            "text": "但我又和原来那个普普通通，什么都做不出来的普通人…不一样了。"
                                                        },
                                                        {
                                                            "id": "746870428",
                                                            "speaker": "弗雷瑞斯",
                                                            "text": "所以我觉得，这个「谎言」好像逐渐变成了我的…「许诺」？"
                                                        },
                                                        {
                                                            "id": "746870429",
                                                            "speaker": "弗雷瑞斯",
                                                            "text": "没有那么不切实际，但好像，也还挺遥远的。",
                                                            "choices": [
                                                                {
                                                                    "id": "746870430",
                                                                    "text": "那你就为此不断加油吧！",
                                                                    "response": [
                                                                        {
                                                                            "id": "746870432",
                                                                            "speaker": "弗雷瑞斯",
                                                                            "text": "我会尽力的！你的鼓励让我稍微有一点底气了！"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "746870431",
                                                                    "text": "坚持下去！搞发明的男子汉！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "746870424",
                                                    "text": "说不定你确实是个天才呢？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "746870417",
                                    "text": "后来你和她坦白了？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "746870433",
                    "text": "我再琢磨琢磨。",
                    "response": [
                        {
                            "id": "746870434",
                            "speaker": "弗雷瑞斯",
                            "text": "没问题，重炮的身管寿命很不错，请随意开火吧。"
                        }
                    ]
                }
            ]
        }
    ]
}