    "dialogues": [
        {
            "id": "5200201",
            "speaker": "留言",
            "text": "「那些东西，还没交出去吧？」"
        },
        {
            "id": "5200202",
            "speaker": "留言",
            "text": "「要不然，我还是拿走扔掉…想到她随时可能回来，我又觉得这些东西没那么合适了。」"
        },
        {
            "id": "5200203",
            "speaker": "店主回复",
            "text": "姑且还由老夫保管，想拿走也没关系。"
        },
        {
            "id": "5200204",
            "speaker": "店主回复",
            "text": "只要您不会觉得遗憾。"
        },
        {
            "id": "5200205",
            "speaker": "留言",
            "text": "「我、我再想想吧，唉…」"
        }
    ]
}