{
    "talkId": "6156502",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "艾拉·马斯克": 9
    },
    "dialogues": [
        {
            "id": "615650201",
            "speaker": "Player",
            "text": "你说什么？"
        },
        {
            "id": "615650202",
            "speaker": "艾拉·马斯克",
            "text": "…嗯？哦哦，抱歉，刚刚太入神了。"
        },
        {
            "id": "615650203",
            "speaker": "艾拉·马斯克",
            "text": "这是丘丘语，意思是「你好！最近吃了吗？」。",
            "choices": [
                {
                    "id": "615650204",
                    "text": "为何语气似乎不太友好…",
                    "response": [
                        {
                            "id": "615650205",
                            "speaker": "艾拉·马斯克",
                            "text": "你在质疑我的学术水准吗？"
                        },
                        {
                            "id": "615650206",
                            "speaker": "艾拉·马斯克",
                            "text": "哼…有质疑也是正常的。关于丘丘语的学术研究目前还是一片空白，所以很多丘丘语词汇的含义，其实我也不敢确定…"
                        },
                        {
                            "id": "615650207",
                            "speaker": "艾拉·马斯克",
                            "text": "如今丘丘语研究最欠缺的是实地考察。假如能与丘丘人面对面沟通的话，或许很多谜团都能轻易揭开，只是…"
                        },
                        {
                            "id": "615650208",
                            "speaker": "Player",
                            "text": "只是…？"
                        },
                        {
                            "id": "615650209",
                            "speaker": "艾拉·马斯克",
                            "text": "唔…只是很少有人敢于直接和丘丘人交谈。假如有人可以替我验证我的理论就好了…"
                        }
                    ]
                },
                {
                    "id": "615650210",
                    "text": "你为什么想要研究这个？",
                    "response": [
                        {
                            "id": "615650211",
                            "speaker": "艾拉·马斯克",
                            "text": "你不觉得丘丘人是一种很有趣的生物吗？"
                        },
                        {
                            "id": "615650212",
                            "speaker": "艾拉·马斯克",
                            "text": "可惜和我有同样想法的人实在是太少了，硬要说的话也就只有砂糖小姐了吧。"
                        },
                        {
                            "id": "615650213",
                            "speaker": "艾拉·马斯克",
                            "text": "不过我们研究的方向不太一样，我研究的是活着的丘丘人，而她则对丘丘人的骨头更感兴趣。"
                        }
                    ]
                }
            ]
        }
    ]
}