{
    "talkId": "6906611",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "神里绫人": 12
    },
    "dialogues": [
        {
            "id": "690660401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690660402",
            "speaker": "神里绫人",
            "text": "#{NICKNAME}，不知你此前是否遛过狗呢？"
        },
        {
            "id": "690660403",
            "speaker": "Player",
            "text": "遛…遛狗？"
        },
        {
            "id": "690660404",
            "speaker": "神里绫人",
            "text": "嗯，就是陪狗一起散步。"
        },
        {
            "id": "690660405",
            "speaker": "神里绫人",
            "text": "狗生性忠诚。但就算它们再乖巧，总在一个地方憋着也是会不太愉快的。"
        },
        {
            "id": "690660406",
            "speaker": "神里绫人",
            "text": "和它们一起出门，看它们腾飞四肢，肆意奔跑玩耍的样子，心情也会放松下来。"
        },
        {
            "id": "690660407",
            "speaker": "神里绫人",
            "text": "不想试试吗？",
            "choices": [
                {
                    "id": "690660408",
                    "text": "我有点紧张…",
                    "response": [
                        {
                            "id": "690660409",
                            "speaker": "神里绫人",
                            "text": "没关系。我会差人准备好性格温顺的狗。"
                        },
                        {
                            "id": "690660410",
                            "speaker": "神里绫人",
                            "text": "或者…就请太郎丸出马吧。"
                        },
                        {
                            "id": "690660411",
                            "speaker": "Player",
                            "text": "那就试试吧。"
                        },
                        {
                            "id": "690660414",
                            "speaker": "神里绫人",
                            "text": "总之，如果刚开始你有所顾虑的话，我们可以先在这里，权当练习。"
                        },
                        {
                            "id": "690660415",
                            "speaker": "神里绫人",
                            "text": "等你也能享受这种乐趣之后，就一起去町街吧。"
                        },
                        {
                            "id": "690660416",
                            "speaker": "神里绫人",
                            "text": "边喝奶茶边遛狗…似乎会引发不小的轰动。"
                        },
                        {
                            "id": "690660417",
                            "speaker": "神里绫人",
                            "text": "呵呵，但也不坏。"
                        }
                    ]
                },
                {
                    "id": "690660412",
                    "text": "好呀。",
                    "response": [
                        {
                            "id": "690660413",
                            "speaker": "神里绫人",
                            "text": "呵呵，答应得这么干脆么。"
                        }
                    ]
                }
            ]
        }
    ]
}