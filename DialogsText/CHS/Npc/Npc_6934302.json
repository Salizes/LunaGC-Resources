    "dialogues": [
        {
            "id": "693430201",
            "speaker": "云堇",
            "text": "古往今来，诸多戏剧所写之人，无一不是经历了种种劫数，才得圆满。"
        },
        {
            "id": "693430202",
            "speaker": "云堇",
            "text": "前路凶险，但无须担心。"
        },
        {
            "id": "693430203",
            "speaker": "云堇",
            "text": "我们有同伴相助，勠力同心，定能克服艰难。"
        }
    ]
}