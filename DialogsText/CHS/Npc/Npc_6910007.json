{
    "talkId": "6910007",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "卡齐娜": 14
    },
    "dialogues": [
        {
            "id": "691000201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691000202",
            "speaker": "卡齐娜",
            "text": "当然…当然，不用担心我的，我能照顾好我自己。",
            "choices": [
                {
                    "id": "691000203",
                    "text": "不会是在逞强吧？",
                    "response": [
                        {
                            "id": "691000204",
                            "speaker": "卡齐娜",
                            "text": "欸？没有吧…！"
                        },
                        {
                            "id": "691000205",
                            "speaker": "卡齐娜",
                            "text": "你是从哪里看出来的？耳朵？还是…我的表情，或者肢体动作？"
                        },
                        {
                            "id": "691000206",
                            "speaker": "Player",
                            "text": "都有点僵硬哦…"
                        },
                        {
                            "id": "691000207",
                            "speaker": "卡齐娜",
                            "text": "对不起！可能是突然来到一个全新的环境，身体还不太适应。"
                        },
                        {
                            "id": "691000208",
                            "speaker": "卡齐娜",
                            "text": "谢谢你的关心，但我没事的…是真的。"
                        },
                        {
                            "id": "691000209",
                            "speaker": "卡齐娜",
                            "text": "这里天气一直很好，氛围也很平和安宁。我很喜欢！"
                        },
                        {
                            "id": "691000219",
                            "speaker": "卡齐娜",
                            "text": "为了尽快适应，也为了让你不用再担心我…"
                        },
                        {
                            "id": "691000220",
                            "speaker": "卡齐娜",
                            "text": "可以让我多在这里待一会儿吗？我会安安静静的。"
                        }
                    ]
                },
                {
                    "id": "691000210",
                    "text": "可以更放松一点。",
                    "response": [
                        {
                            "id": "691000211",
                            "speaker": "卡齐娜",
                            "text": "嗯——谢谢你邀请我到这里来玩…我会努力让自己更加放松的！"
                        },
                        {
                            "id": "691000212",
                            "speaker": "Player",
                            "text": "或许…放松是不用努力的。"
                        },
                        {
                            "id": "691000213",
                            "speaker": "卡齐娜",
                            "text": "对、对哦！"
                        },
                        {
                            "id": "691000214",
                            "speaker": "卡齐娜",
                            "text": "你的家很好…你的邀请更是让我开心得不知道怎么办才好…"
                        },
                        {
                            "id": "691000215",
                            "speaker": "卡齐娜",
                            "text": "只、只是，可能我还需要一点时间来适应新环境。"
                        },
                        {
                            "id": "691000216",
                            "speaker": "卡齐娜",
                            "text": "我…我不怎么出远门，这里又全都是我从没见过的事物…！光是一件件看过来就快让我忘记呼吸了。"
                        },
                        {
                            "id": "691000217",
                            "speaker": "Player",
                            "text": "没事的，你可以在这里做任何事情。"
                        },
                        {
                            "id": "691000218",
                            "speaker": "卡齐娜",
                            "text": "谢谢你，呜…你对我真好。"
                        }
                    ]
                }
            ]
        }
    ]
}