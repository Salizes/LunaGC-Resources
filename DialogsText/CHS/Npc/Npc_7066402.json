{
    "talkId": "7066402",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "宏朗": 12
    },
    "dialogues": [
        {
            "id": "706640201",
            "speaker": "宏朗",
            "text": "每次都派我来解决这种麻烦事…",
            "choices": [
                {
                    "id": "706640202",
                    "text": "关于这座秘境…",
                    "response": [
                        {
                            "id": "706640203",
                            "speaker": "宏朗",
                            "text": "这座秘境里无序分布着大量风场，有些风场发出的风甚至会彼此冲撞，形成一个阻飞区。"
                        },
                        {
                            "id": "706640204",
                            "speaker": "宏朗",
                            "text": "如果想要操纵风之翼强行突破这些风场的话…几乎是不可能的。"
                        },
                        {
                            "id": "706640205",
                            "speaker": "宏朗",
                            "text": "但我们也在这秘境中发现了一些机关。在启动这些机关后，一些风场的状态好像也发生了变化…"
                        },
                        {
                            "id": "706640206",
                            "speaker": "宏朗",
                            "text": "我们认为，如果能活用这些机关，也许就能更加顺利地探索这座秘境…"
                        },
                        {
                            "id": "706640207",
                            "speaker": "宏朗",
                            "text": "不过，这座秘境里似乎还存在着大量来源不明的魔物…"
                        },
                        {
                            "id": "706640208",
                            "speaker": "宏朗",
                            "text": "旅行者，在探索这座秘境的时候，请一定要格外小心。"
                        }
                    ]
                },
                {
                    "id": "706640209",
                    "text": "关于你自己…",
                    "response": [
                        {
                            "id": "706640210",
                            "speaker": "宏朗",
                            "text": "我？我就是个普普通通的冒险家，被岚姐推过来负责探索这一类未知的秘境。"
                        },
                        {
                            "id": "706640211",
                            "speaker": "宏朗",
                            "text": "她说是什么信任我的能力啦，认为我可当大任啦。"
                        },
                        {
                            "id": "706640212",
                            "speaker": "宏朗",
                            "text": "我觉得，她大概就是想找个闲人，来负责这件吃力不讨好的事罢了…无论是谁都行。"
                        }
                    ]
                },
                {
                    "id": "706640213",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "706640214",
                            "speaker": "宏朗",
                            "text": "嗯，探索秘境的事就拜托你了，报酬我会给你准备好的。"
                        },
                        {
                            "id": "706640215",
                            "speaker": "宏朗",
                            "text": "探索的时候，一定要注意安全啊。"
                        }
                    ]
                }
            ]
        }
    ]
}