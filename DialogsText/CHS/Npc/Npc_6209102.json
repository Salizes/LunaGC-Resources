    "dialogues": [
        {
            "id": "620910201",
            "speaker": "Player",
            "text": "请问你是…？"
        },
        {
            "id": "620910202",
            "speaker": "秀华",
            "text": "我是秀华，是白驹逆旅的服务员。请问客人有什么需求吗？"
        },
        {
            "id": "620910203",
            "speaker": "Player",
            "text": "关于身份…"
        },
        {
            "id": "620910204",
            "speaker": "秀华",
            "text": "您问我身份吗？我只是一个服务员而已，没…没什么特别的。"
        },
        {
            "id": "620910205",
            "speaker": "秀华",
            "text": "不过…我的双胞胎姐姐偶尔会和我互换岗位，请您千万不要见怪…"
        }
    ]
