{
    "talkId": "6910402",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "恰斯卡": 7
    },
    "dialogues": [
        {
            "id": "691040201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691040202",
            "speaker": "恰斯卡",
            "text": "习惯…可能还说不上。"
        },
        {
            "id": "691040203",
            "speaker": "恰斯卡",
            "text": "这里的空气安宁得出奇。风的呼啸，野兽间动荡的敌意，隐藏在人群喧闹声下的汹涌浪潮…我都听不到。"
        },
        {
            "id": "691040204",
            "speaker": "恰斯卡",
            "text": "内心深处一直躁动着的感觉似乎也平和了下来…非常奇妙。",
            "choices": [
                {
                    "id": "691040205",
                    "text": "要练练手吗？",
                    "response": [
                        {
                            "id": "691040206",
                            "speaker": "恰斯卡",
                            "text": "还是算了，我可不忍心破坏这么难得的安宁。"
                        },
                        {
                            "id": "691040209",
                            "speaker": "恰斯卡",
                            "text": "这世上的纷争跟矛盾已经够多了，就让它们都留在外面吧。"
                        },
                        {
                            "id": "691040210",
                            "speaker": "恰斯卡",
                            "text": "#{NICKNAME}，谢谢你带我来这里。"
                        }
                    ]
                },
                {
                    "id": "691040207",
                    "text": "这是坏事吗？",
                    "response": [
                        {
                            "id": "691040208",
                            "speaker": "恰斯卡",
                            "text": "不，我很钟意这种「不习惯」。"
                        }
                    ]
                }
            ]
        }
    ]
}