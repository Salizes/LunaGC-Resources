    "dialogues": [
        {
            "id": "624010201",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "624010202",
            "speaker": "霹雳闪雷真君",
            "text": "嘿嘿，也不瞒你，老夫便是隐居此处的仙人。"
        },
        {
            "id": "624010203",
            "speaker": "霹雳闪雷真君",
            "text": "进得绝云间的凡人，个个筋骨惊奇、神采非凡…"
        },
        {
            "id": "624010204",
            "speaker": "霹雳闪雷真君",
            "text": "老夫看了心中是喜不自胜，故在此地开坛收徒传道。"
        }
    ]
}