    },
    "dialogues": [
        {
            "id": "663050201",
            "speaker": "Player",
            "text": "你好。"
        },
        {
            "id": "663050202",
            "speaker": "阿卡特",
            "text": "你好啊，外乡的朋友！"
        },
        {
            "id": "663050203",
            "speaker": "阿卡特",
            "text": "看样子，你应该是第一次到这里来吧？欢迎，我是阿卡特，「沃陆之邦」的首领。"
        },
        {
            "id": "663050204",
            "speaker": "阿卡特",
            "text": "不必感到拘谨。这里没有什么繁文缛节，重要的只有勇气、毅力，以及在擂台上绝不后退的意志。"
        },
        {
            "id": "663050205",
            "speaker": "阿卡特",
            "text": "沃陆之邦尊重每一位可敬的战士，也尊重每一位可亲的朋友。愿你在沃陆之邦过得愉快。"
        }
    ]
}