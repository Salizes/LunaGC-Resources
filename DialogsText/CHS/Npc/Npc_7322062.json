{
    "talkId": "7322062",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 6,
        "婕德": 21
    },
    "dialogues": [
        {
            "id": "732206201",
            "speaker": "婕德",
            "text": "#啊，{NICKNAME}…原来是你，怎么了，有什么事吗？",
            "choices": [
                {
                    "id": "732206202",
                    "text": "关于「永恒绿洲」…",
                    "response": [
                        {
                            "id": "732206203",
                            "speaker": "婕德",
                            "text": "这次去「永恒绿洲」，真是多亏有你，如果没有你的话，说不定根本没办法真的打开通往「永恒绿洲」的道路。"
                        },
                        {
                            "id": "732206204",
                            "speaker": "婕德",
                            "text": "我都不知道应该如何感谢你…下次我们再一起点起篝火，坐在篝火边夜谈吧，就像…"
                        },
                        {
                            "id": "732206205",
                            "speaker": "婕德",
                            "text": "就像上次和阿萨里格…啊…"
                        },
                        {
                            "id": "732206206",
                            "speaker": "婕德",
                            "text": "…那个狗东西…"
                        },
                        {
                            "id": "732206207",
                            "speaker": "Player",
                            "text": "抱歉…"
                        },
                        {
                            "id": "732206208",
                            "speaker": "婕德",
                            "text": "没有什么可抱歉的…我没有在生你的气。"
                        },
                        {
                            "id": "732206209",
                            "speaker": "婕德",
                            "text": "主母在我出发前就已经让我提高警惕了。我可能行事草率…噗，也许吧…但我并不傻。"
                        },
                        {
                            "id": "732206210",
                            "speaker": "婕德",
                            "text": "那些古代机械的图纸…他从来没有给族人分享过——这是重罪，从意识到这点起，我就已经生疑了…"
                        },
                        {
                            "id": "732206211",
                            "speaker": "婕德",
                            "text": "但我没想到，他在与我接触的这么长时间里，竟然怀着那样的算计…他自以为能掌控我…"
                        },
                        {
                            "id": "732206212",
                            "speaker": "婕德",
                            "text": "一想到这个我就觉得恶心…"
                        },
                        {
                            "id": "732206213",
                            "speaker": "婕德",
                            "text": "不过还好，还有芭别尔主母始终站在我这边，我相信她一定能让部族重新繁荣…"
                        },
                        {
                            "id": "732206214",
                            "speaker": "婕德",
                            "text": "一定能…嗯。"
                        },
                        {
                            "id": "732206215",
                            "speaker": "婕德",
                            "text": "对了，还有你！还有你是我这边的！",
                            "choices": [
                                {
                                    "id": "732206216",
                                    "text": "嗯，我也是婕德人！",
                                    "response": [
                                        {
                                            "id": "732206217",
                                            "speaker": "婕德",
                                            "text": "婕德人是什么啦…好怪，听上去好像派蒙会取的外号哦。"
                                        },
                                        {
                                            "id": "732206218",
                                            "speaker": "婕德",
                                            "text": "#不过，谢谢你，{NICKNAME}…真的很感谢！"
                                        }
                                    ]
                                },
                                {
                                    "id": "732206219",
                                    "text": "如果我和主母起了冲突呢…",
                                    "response": [
                                        {
                                            "id": "732206220",
                                            "speaker": "婕德",
                                            "text": "……"
                                        },
                                        {
                                            "id": "732206221",
                                            "speaker": "婕德",
                                            "text": "哈哈，不许开这种玩笑啦，你是塔尼特的贵宾，又迎回了「镇灵之母」，找到了前往「永恒绿洲」的路…"
                                        },
                                        {
                                            "id": "732206222",
                                            "speaker": "婕德",
                                            "text": "我想不到主母会和你起冲突的理由。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "732206225",
                    "text": "关于奔奔…",
                    "response": [
                        {
                            "id": "732206226",
                            "speaker": "婕德",
                            "text": "多亏你上次从那些北方人手里拿来的东西，奔奔现在逐渐恢复，看上去可精神了。"
                        },
                        {
                            "id": "732206227",
                            "speaker": "婕德",
                            "text": "跟我们当初遇到它的时候一样…"
                        }
                    ]
                },
                {
                    "id": "732206223",
                    "text": "没什么事…",
                    "response": [
                        {
                            "id": "732206224",
                            "speaker": "婕德",
                            "text": "嗯…有什么需要我帮忙的，要及时和我说。"
                        }
                    ]
                }
            ]
        }
    ]
}