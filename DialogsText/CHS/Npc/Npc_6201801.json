{
    "talkId": "6201801",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "一弦": 4,
        "一柱": 5
    },
    "dialogues": [
        {
            "id": "620180101",
            "speaker": "一柱",
            "text": "弦儿乖，我们回家啦…"
        },
        {
            "id": "620180102",
            "speaker": "一弦",
            "text": "我不要！我要找妈妈…！"
        },
        {
            "id": "620180103",
            "speaker": "一柱",
            "text": "可是妈妈不会回来了…"
        },
        {
            "id": "620180104",
            "speaker": "一弦",
            "text": "呜呜…为什么…是我们不够乖吗…？"
        },
        {
            "id": "620180105",
            "speaker": "一柱",
            "text": "不是的…"
        },
        {
            "id": "620180106",
            "speaker": "一弦",
            "text": "可是…可是…我明明看见黑衣服的姐姐把她送到这里了…呜呜…"
        },
        {
            "id": "620180107",
            "speaker": "一柱",
            "text": "好了，其实…其实妈妈已经变成天上的星星了哦。"
        },
        {
            "id": "620180108",
            "speaker": "一弦",
            "text": "你是说妈妈不用再像那时候一样，一直睡觉了吗？…你一定又在骗我，我才不信…"
        },
        {
            "id": "620180109",
            "speaker": "一柱",
            "text": "是真的哦，等晚上我带你上屋顶看，好不好？星光会像妈妈的眼神一样温柔的…"
        }
    ]
}