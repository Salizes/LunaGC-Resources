    "dialogues": [
        {
            "id": "634090201",
            "speaker": "Player",
            "text": "这里来的客人很多吗？"
        },
        {
            "id": "634090202",
            "speaker": "奥克萨娜",
            "text": "其实…其实受邀请来的人类客人确实比较少，大部分还是生活在别处的雪精。"
        },
        {
            "id": "634090203",
            "speaker": "奥克萨娜",
            "text": "不过，从前这里招待过许多不同的客人。"
        },
        {
            "id": "634090204",
            "speaker": "奥克萨娜",
            "text": "只要是手持请柬的来客，都会受到我们的欢迎。"
        }
    ]
