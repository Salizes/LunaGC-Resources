    "dialogues": [
        {
            "id": "675460801",
            "speaker": "Player",
            "text": "「雪巷飞渡」是什么？"
        },
        {
            "id": "675460802",
            "speaker": "伊娜",
            "text": "哈哈，这是一项我自创的运动，不需要太多技巧，只要你会跑，就能参加。"
        },
        {
            "id": "675460803",
            "speaker": "伊娜",
            "text": "这冰天雪地的，我的头发都快冻成冰碴子咯…但如果跑完一趟「雪巷飞渡」，效果比喝上一壶烈酒还要好。"
        }
    ]
}