{
    "talkId": "6904908",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "宵宫": 18
    },
    "dialogues": [
        {
            "id": "690490801",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690490302",
            "speaker": "宵宫",
            "text": "好呀，你知道我最喜欢聊天了，我想想有没有什么有趣的话题…"
        },
        {
            "id": "690490303",
            "speaker": "宵宫",
            "text": "对了，难得你有了这么大一块世外桃源，除了用来居住之外，还有别的想法吗？"
        },
        {
            "id": "690490304",
            "speaker": "宵宫",
            "text": "比如建会客厅，展览馆，训练场什么的。",
            "choices": [
                {
                    "id": "690490305",
                    "text": "我想像你一样做生意。",
                    "response": [
                        {
                            "id": "690490306",
                            "speaker": "宵宫",
                            "text": "欸？这样啊，不过可能你有点误会，我们家的生意和平常的生意不太一样。"
                        },
                        {
                            "id": "690490307",
                            "speaker": "宵宫",
                            "text": "我知道璃月的商人都擅长赚大钱，大账小账都能做得特别精明。"
                        },
                        {
                            "id": "690490308",
                            "speaker": "宵宫",
                            "text": "但对我们家来说，客人都是老主顾，抬头不见低头见，人情往来更加重要。"
                        },
                        {
                            "id": "690490309",
                            "speaker": "宵宫",
                            "text": "所以，我和老爹做生意，为的是不辜负大家的信任吧。"
                        },
                        {
                            "id": "690490315",
                            "speaker": "宵宫",
                            "text": "总之，等你建设完毕的时候，记得找我来给你放烟花庆祝哦。"
                        },
                        {
                            "id": "690490316",
                            "speaker": "Player",
                            "text": "如果让你建，你有什么想法？"
                        },
                        {
                            "id": "690490317",
                            "speaker": "宵宫",
                            "text": "我的话…嘿嘿，我想建游乐场！"
                        },
                        {
                            "id": "690490318",
                            "speaker": "宵宫",
                            "text": "里面摆满了玩具，各种各样会闪的，会动的，会转的，饿了还有点心可以吃！"
                        },
                        {
                            "id": "690490319",
                            "speaker": "宵宫",
                            "text": "住在那样的世界里，我就算圆梦了吧！"
                        },
                        {
                            "id": "690490320",
                            "speaker": "Player",
                            "text": "我会考虑的。"
                        },
                        {
                            "id": "690490321",
                            "speaker": "宵宫",
                            "text": "不用，不用，不需要认真考虑，这只是我的私心啦。"
                        },
                        {
                            "id": "690490322",
                            "speaker": "宵宫",
                            "text": "不过…听到你这么说，我很开心。"
                        },
                        {
                            "id": "690490323",
                            "speaker": "宵宫",
                            "text": "游乐场…啊，真好。"
                        }
                    ]
                },
                {
                    "id": "690490310",
                    "text": "我想打造一片园林。",
                    "response": [
                        {
                            "id": "690490311",
                            "speaker": "宵宫",
                            "text": "哦，很有雅兴嘛！我觉得很有趣，我也想帮忙。"
                        },
                        {
                            "id": "690490312",
                            "speaker": "宵宫",
                            "text": "你需要什么东西，尽管跟我说，只要稻妻能找到的，我都会想办法弄到。"
                        },
                        {
                            "id": "690490313",
                            "speaker": "宵宫",
                            "text": "这也多亏家里的生意积累了人脉，哈哈。"
                        },
                        {
                            "id": "690490314",
                            "speaker": "宵宫",
                            "text": "对了，摘星星摘月亮什么的不行哦，摘不到的。"
                        }
                    ]
                }
            ]
        }
    ]
}