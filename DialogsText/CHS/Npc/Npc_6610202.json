    "dialogues": [
        {
            "id": "661020201",
            "speaker": "Player",
            "text": "之前的衣服怎么了？"
        },
        {
            "id": "661020202",
            "speaker": "汉扎",
            "text": "坏掉了呗。"
        },
        {
            "id": "661020203",
            "speaker": "汉扎",
            "text": "很正常啦，挑战极限总是要付出代价的！只是一身衣服而已，我还是付得起的。"
        },
        {
            "id": "661020204",
            "speaker": "汉扎",
            "text": "不过的确得承认，不带防具在不足半米宽的山脊上踩滑板是有点离谱。"
        },
        {
            "id": "661020205",
            "speaker": "汉扎",
            "text": "幸好当时身边有我最最最亲爱的龙朋友！加塔力可是一直跟着我的…欸，加塔力？去哪了？"
        },
        {
            "id": "661020206",
            "speaker": "汉扎",
            "text": "奇怪，刚刚还在身边的…"
        }
    ]
}