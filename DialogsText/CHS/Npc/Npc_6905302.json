    "dialogues": [
        {
            "id": "690530201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690530202",
            "speaker": "早柚",
            "text": "嗯，睡得非常舒服。"
        },
        {
            "id": "690530203",
            "speaker": "早柚",
            "text": "而且不用担心突然被抓去工作。"
        },
        {
            "id": "690530204",
            "speaker": "早柚",
            "text": "就算是一直睡下去也没关系。",
            "choices": [
                {
                    "id": "690530205",
                    "text": "早柚能喜欢这里，太好了。",
                    "response": [
                        {
                            "id": "690530206",
                            "speaker": "早柚",
                            "text": "嗯，这里也没有狸猫。"
                        },
                        {
                            "id": "690530207",
                            "speaker": "早柚",
                            "text": "我很喜欢。"
                        }
                    ]
                },
                {
                    "id": "690530208",
                    "text": "那早柚可以经常来玩。",
                    "response": [
                        {
                            "id": "690530209",
                            "speaker": "早柚",
                            "text": "好呀，谢谢你。"
                        },
                        {
                            "id": "690530210",
                            "speaker": "早柚",
                            "text": "那我下次旷…呃，休息的时候，首选地就是这里了。"
                        }
                    ]
                }
            ]
        }
    ]
}