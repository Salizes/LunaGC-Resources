    "dialogues": [
        {
            "id": "690721101",
            "speaker": "坎蒂丝",
            "text": "我很喜欢阿如村的建筑风格，倒不是什么爱屋及乌。"
        },
        {
            "id": "690721102",
            "speaker": "坎蒂丝",
            "text": "来，看看这些精美的斑纹，还有漂亮的外墙面。古老的风格为它增添了韵味，让它在静谧中更显壮丽。"
        },
        {
            "id": "690721103",
            "speaker": "坎蒂丝",
            "text": "…我可以再看一会儿吗？"
        }
    ]
}