{
    "talkId": "6906109",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "绮良良": 16
    },
    "dialogues": [
        {
            "id": "690610201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690610202",
            "speaker": "绮良良",
            "text": "欸，那么快就到「用户回访」环节了吗？咳咳，那我可要认真作答。"
        },
        {
            "id": "690610203",
            "speaker": "绮良良",
            "text": "环境分，五星！这里风景优美，难能一见，好像还存在着某种我看不透的妖力…"
        },
        {
            "id": "690610204",
            "speaker": "绮良良",
            "text": "舒适度，五星！晚上我在箱子里睡得可安稳了！"
        },
        {
            "id": "690610205",
            "speaker": "绮良良",
            "text": "没有噪音，没有强光，完全可以给满分！"
        },
        {
            "id": "690610206",
            "speaker": "绮良良",
            "text": "最后…服务分也是五星，无可挑剔。",
            "choices": [
                {
                    "id": "690610207",
                    "text": "好高的评价…",
                    "response": [
                        {
                            "id": "690610208",
                            "speaker": "绮良良",
                            "text": "这是你应得的，我才该多谢谢你。"
                        },
                        {
                            "id": "690610211",
                            "speaker": "Player",
                            "text": "还有其他感想吗？"
                        },
                        {
                            "id": "690610212",
                            "speaker": "绮良良",
                            "text": "噢噢，我懂，是最后的简答部分，好大一个空格子对吧！"
                        },
                        {
                            "id": "690610213",
                            "speaker": "绮良良",
                            "text": "唔…我想想啊。"
                        },
                        {
                            "id": "690610214",
                            "speaker": "绮良良",
                            "text": "我对那只个头大大的碧团雀挺感兴趣的。看上去胖墩墩、毛茸茸的，模样很悠闲，警惕性也低…",
                            "choices": [
                                {
                                    "id": "690610215",
                                    "text": "那是壶灵阿圆。",
                                    "response": [
                                        {
                                            "id": "690610216",
                                            "speaker": "绮良良",
                                            "text": "壶灵？跟付丧神类似吗？难道说她的本体是个茶壶？"
                                        },
                                        {
                                            "id": "690610217",
                                            "speaker": "绮良良",
                                            "text": "还是说…现在的样子正是她原本的形态，而她也像我一样，能变成一名少女？"
                                        },
                                        {
                                            "id": "690610218",
                                            "speaker": "绮良良",
                                            "text": "哎呀，太让人好奇了！请介绍我跟她认识认识吧！"
                                        }
                                    ]
                                },
                                {
                                    "id": "690610219",
                                    "text": "她可不能吃。",
                                    "response": [
                                        {
                                            "id": "690610220",
                                            "speaker": "绮良良",
                                            "text": "啊！不会的，不会的。"
                                        },
                                        {
                                            "id": "690610221",
                                            "speaker": "绮良良",
                                            "text": "我只是有一点点好奇而已，想知道她是怎么来的，平时会想些什么、做点什么…说不定还能交上朋友。"
                                        },
                                        {
                                            "id": "690610222",
                                            "speaker": "绮良良",
                                            "text": "有机会的话，请介绍我跟她认识认识吧！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690610209",
                    "text": "好认真的回答…",
                    "response": [
                        {
                            "id": "690610210",
                            "speaker": "绮良良",
                            "text": "你做了那么多，有这个机会，我当然要好好表达自己的心情。"
                        }
                    ]
                }
            ]
        }
    ]
}