{
    "talkId": "7665010",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 8,
        "派蒙": 4,
        "盗宝鼬": 3,
        "菈乌玛": 10
    },
    "dialogues": [
        {
            "id": "766501001",
            "speaker": "派蒙",
            "text": "菈乌玛，我们来做客啦！",
            "choices": [
                {
                    "id": "766501002",
                    "text": "这周围怎么…",
                    "response": [
                        {
                            "id": "766501004",
                            "speaker": "派蒙",
                            "text": "是喔，地上堆着好多盒子和杂物，有的拆开了，有的没拆开…这里不是书库吗？",
                            "choices": [
                                {
                                    "id": "766501005",
                                    "text": "感觉更像是仓库。",
                                    "response": [
                                        {
                                            "id": "766501007",
                                            "speaker": "派蒙",
                                            "text": "菈乌玛在那边，她正在和盗宝鼬说话？唔…难道是遇见什么麻烦事了？我们过去看看吧。"
                                        },
                                        {
                                            "id": "766501008",
                                            "speaker": "盗宝鼬",
                                            "text": "……"
                                        },
                                        {
                                            "id": "766501009",
                                            "speaker": "菈乌玛",
                                            "text": "…唉，即便如此。眼下也并无要紧的挖掘事务…暂且别四处挖掘了，好么？"
                                        },
                                        {
                                            "id": "766501010",
                                            "speaker": "盗宝鼬",
                                            "text": "♪"
                                        },
                                        {
                                            "id": "766501011",
                                            "speaker": "菈乌玛",
                                            "text": "好孩子，喏，这一枚摩拉是送给你的。"
                                        },
                                        {
                                            "id": "766501012",
                                            "speaker": "盗宝鼬",
                                            "text": "♪♪♪"
                                        },
                                        {
                                            "id": "766501013",
                                            "speaker": "派蒙",
                                            "text": "是上次那只盗宝鼬。菈乌玛在和它说什么呢？难道是又发现什么文物了？"
                                        },
                                        {
                                            "id": "766501014",
                                            "speaker": "菈乌玛",
                                            "text": "#你们好，{NICKNAME}，还有小派蒙。欢迎来书库，有何事需要我帮助么？",
                                            "choices": [
                                                {
                                                    "id": "766501015",
                                                    "text": "刚才看见你和盗宝鼬说话了。",
                                                    "response": [
                                                        {
                                                            "id": "766501017",
                                                            "speaker": "菈乌玛",
                                                            "text": "并非如此，我只是在…对这孩子稍作训诫，它最近有点太过于兴奋，总是去叨扰周围的人。"
                                                        },
                                                        {
                                                            "id": "766501018",
                                                            "speaker": "菈乌玛",
                                                            "text": "自从上次把「月谕之像」取回来，这孩子对探索宝藏更加热情了…时不时地就跑来问我，什么时候再继续去寻宝。"
                                                        },
                                                        {
                                                            "id": "766501019",
                                                            "speaker": "菈乌玛",
                                                            "text": "虽然我已经说了，目前书库内存放的书籍和文物已经足够研究，暂时不用外出探寻…但…",
                                                            "choices": [
                                                                {
                                                                    "id": "766501020",
                                                                    "text": "它抑制不住自己的本性了。",
                                                                    "response": [
                                                                        {
                                                                            "id": "766501022",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "是的。但这孩子并不了解「文物」之义，只要是看起来值钱的事物，它都会挖掘取回。"
                                                                        },
                                                                        {
                                                                            "id": "766501023",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "虽然这孩子答应我，以后不会再挖掘。但它挖出来的这些东西…也只能由我来处理了。"
                                                                        },
                                                                        {
                                                                            "id": "766501024",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "#抱歉，{NICKNAME}，小派蒙。今日我恐怕没法陪你们游览了。"
                                                                        },
                                                                        {
                                                                            "id": "766501025",
                                                                            "speaker": "菈乌玛",
                                                                            "text": "呼…这个盒子里，是装着什么来着…？"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "766501021",
                                                                    "text": "它还是自己到处搜罗东西了？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "766501016",
                                                    "text": "又发现什么埋藏着的文物了？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "766501006",
                                    "text": "难道是又要做装修？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "766501003",
                    "text": "这么多东西？"
                }
            ]
        }
    ]
}