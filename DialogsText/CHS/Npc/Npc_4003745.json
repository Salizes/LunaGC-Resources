    "dialogues": [
        {
            "id": "400374501",
            "speaker": "萍姥姥",
            "text": "嗯？是你啊，孩子。"
        },
        {
            "id": "400374502",
            "speaker": "萍姥姥",
            "text": "花开花谢，人去人归，但璃月的海灯节总会如期举办。"
        },
        {
            "id": "400374503",
            "speaker": "萍姥姥",
            "text": "不过今年的海灯节和以往的不太一样，孩子你可以多转转，多看看，慢慢享受璃月港的景色，呵呵。"
        }
    ]
}