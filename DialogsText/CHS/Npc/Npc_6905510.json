{
    "talkId": "6905510",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "五郎": 17
    },
    "dialogues": [
        {
            "id": "690550301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690550302",
            "speaker": "五郎",
            "text": "好啊！"
        },
        {
            "id": "690550303",
            "speaker": "五郎",
            "text": "就和你讲讲反抗军里的趣事吧？你在别的地方不一定会遇到哦。"
        },
        {
            "id": "690550304",
            "speaker": "Player",
            "text": "我很有兴趣…"
        },
        {
            "id": "690550305",
            "speaker": "五郎",
            "text": "嗯！反抗军的将士们并非每个人都经过专业训练，新兵难免会犯些小错误。"
        },
        {
            "id": "690550306",
            "speaker": "五郎",
            "text": "比如远征训练期间，没有考虑到口粮的保存条件，只好吃了半个月的白萝卜。"
        },
        {
            "id": "690550307",
            "speaker": "五郎",
            "text": "侦察时，把动物留下的痕迹当成敌军的线索，和野林猪斗智斗勇三天三夜…"
        },
        {
            "id": "690550308",
            "speaker": "五郎",
            "text": "这些小错没有造成严重的后果，倒是变成了我们茶余饭后的笑谈。"
        },
        {
            "id": "690550309",
            "speaker": "五郎",
            "text": "但仔细想想，确实可以通过调整编制来避免…"
        },
        {
            "id": "690550310",
            "speaker": "五郎",
            "text": "应该把反抗军中的老兵编制打散，尽可能分散到新兵的团队中去，让他们和新兵分享经验。"
        },
        {
            "id": "690550311",
            "speaker": "五郎",
            "text": "啊，抱歉，是我不好！不知不觉就开始思考了！"
        },
        {
            "id": "690550312",
            "speaker": "五郎",
            "text": "调整编制的事，以后再想！既然是陪你聊天，还是说点轻松的事情吧。比如，最近啊…"
        },
        {
            "id": "690550313",
            "speaker": "Player",
            "text": "想听「常胜将军」自己的故事…"
        },
        {
            "id": "690550314",
            "speaker": "五郎",
            "text": "…我自己的事？"
        },
        {
            "id": "690550315",
            "speaker": "五郎",
            "text": "唔…"
        },
        {
            "id": "690550316",
            "speaker": "五郎",
            "text": "虽然将士们经常向别人夸耀我的战绩。但总觉得，亲口说自己的经历，像是在自吹自擂。",
            "choices": [
                {
                    "id": "690550317",
                    "text": "想听想听！",
                    "response": [
                        {
                            "id": "690550319",
                            "speaker": "五郎",
                            "text": "你该不会是看准了我不会违背你的想法…才这么说的吧。"
                        },
                        {
                            "id": "690550320",
                            "speaker": "五郎",
                            "text": "咳咳…真拿你没办法…"
                        },
                        {
                            "id": "690550321",
                            "speaker": "五郎",
                            "text": "那就聊一聊…我在名椎滩北部独自侦察的惊险经历吧…"
                        },
                        {
                            "id": "690550322",
                            "speaker": "五郎",
                            "text": "当天的情况是这样的…"
                        }
                    ]
                },
                {
                    "id": "690550318",
                    "text": "我不会觉得是「自吹自擂」哦。"
                }
            ]
        }
    ]
}