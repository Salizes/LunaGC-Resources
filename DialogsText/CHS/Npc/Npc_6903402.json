    "dialogues": [
        {
            "id": "690340201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690340202",
            "speaker": "诺艾尔",
            "text": "当然，我很喜欢这里的环境。"
        },
        {
            "id": "690340203",
            "speaker": "诺艾尔",
            "text": "户外开阔又惬意，室内的装饰也雅致。"
        },
        {
            "id": "690340204",
            "speaker": "诺艾尔",
            "text": "我觉得胜过我见过的所有庄园。"
        },
        {
            "id": "690340205",
            "speaker": "诺艾尔",
            "text": "唯一的缺陷…"
        },
        {
            "id": "690340206",
            "speaker": "Player",
            "text": "唯一的缺陷？"
        },
        {
            "id": "690340207",
            "speaker": "诺艾尔",
            "text": "相比蒙德城，这里需要女仆做的工作实在太少了。"
        },
        {
            "id": "690340208",
            "speaker": "诺艾尔",
            "text": "感觉有点太悠闲了呢…"
        }
    ]
}