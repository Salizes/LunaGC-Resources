{
    "talkId": "6162402",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "常九爷": 9
    },
    "dialogues": [
        {
            "id": "616240201",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "616240202",
            "speaker": "常九爷",
            "text": "说出来怕吓到你，我就是当年在绯云坡大名鼎鼎的常九爷！"
        },
        {
            "id": "616240203",
            "speaker": "常九爷",
            "text": "想当年我还在璃月港的时候，每天经手的摩拉数都数不过来，做生意的所有人都得看我的脸色！"
        },
        {
            "id": "616240204",
            "speaker": "常九爷",
            "text": "什么璃月七星，哼，只要我想，就得给我让个位子！",
            "choices": [
                {
                    "id": "616240205",
                    "text": "那为什么来这里住…",
                    "response": [
                        {
                            "id": "616240206",
                            "speaker": "常九爷",
                            "text": "稍微…有点意外，生意上不是很顺利，干脆就卖了老宅到这清净的地方隐居了。"
                        },
                        {
                            "id": "616240207",
                            "speaker": "常九爷",
                            "text": "古人云「未曾清贫难成人」，虽然现在只有一屋子藏书陪着我，但属于我的机会肯定会再出现的。"
                        },
                        {
                            "id": "616240208",
                            "speaker": "常九爷",
                            "text": "比如矿石什么的…算了，凭什么泄露商机给你，嘿嘿。"
                        },
                        {
                            "id": "616240209",
                            "speaker": "常九爷",
                            "text": "到时候，整个璃月港都会知道「那个常九爷他回来了」！"
                        }
                    ]
                },
                {
                    "id": "616240210",
                    "text": "关于邻居…",
                    "response": [
                        {
                            "id": "616240211",
                            "speaker": "常九爷",
                            "text": "你说那群种地的穷鬼？哼…真是晦气。"
                        },
                        {
                            "id": "616240212",
                            "speaker": "常九爷",
                            "text": "我常九爷只是暂时不得不与他们当邻居，等我重振了家业，他们就连我脚后跟都摸不着了！"
                        }
                    ]
                }
            ]
        }
    ]
}