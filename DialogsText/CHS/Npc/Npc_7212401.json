{
    "talkId": "7212401",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 7,
        "无名": 24
    },
    "dialogues": [
        {
            "id": "721240101",
            "speaker": "无名",
            "text": "为什么？为什么找不到…"
        },
        {
            "id": "721240102",
            "speaker": "Player",
            "text": "在找什么？"
        },
        {
            "id": "721240103",
            "speaker": "无名",
            "text": "在找…找…我忘记了。每次快想起来的时候，都会忘记。"
        },
        {
            "id": "721240104",
            "speaker": "无名",
            "text": "喂，你知道我在找什么吗？",
            "choices": [
                {
                    "id": "721240105",
                    "text": "我怎么知道。",
                    "response": [
                        {
                            "id": "721240106",
                            "speaker": "无名",
                            "text": "不行，想不起来…"
                        },
                        {
                            "id": "721240111",
                            "speaker": "无名",
                            "text": "可恨，可恨！怎么总是想不起来。",
                            "choices": [
                                {
                                    "id": "721240112",
                                    "text": "以后会想起来的。",
                                    "response": [
                                        {
                                            "id": "721240113",
                                            "speaker": "无名",
                                            "text": "不行，我等不了那么久。"
                                        },
                                        {
                                            "id": "721240114",
                                            "speaker": "无名",
                                            "text": "不论我要找什么，这东西一定至关重要，越早想起来越好。"
                                        },
                                        {
                                            "id": "721240115",
                                            "speaker": "无名",
                                            "text": "冥冥之中，我有种感觉，我留在此地就是为了找到那东西，找不到绝对不行。"
                                        },
                                        {
                                            "id": "721240116",
                                            "speaker": "无名",
                                            "text": "所有想来打扰我、妨碍我的家伙，我统统都会斩掉…"
                                        },
                                        {
                                            "id": "721240117",
                                            "speaker": "无名",
                                            "text": "斩掉…对！挥刀斩人的感觉…畅快的感觉，哈哈哈哈，全身的血都会像江水一样奔涌起来。"
                                        },
                                        {
                                            "id": "721240122",
                                            "speaker": "无名",
                                            "text": "我的刀上次染血，是什么时候？"
                                        },
                                        {
                                            "id": "721240123",
                                            "speaker": "无名",
                                            "text": "呵，感觉有些时日了，今天终于又来了一个你。"
                                        },
                                        {
                                            "id": "721240124",
                                            "speaker": "无名",
                                            "text": "我要寻找何物，这个问题稍后再说，想了这么久我也累了，该放松一下。"
                                        },
                                        {
                                            "id": "721240125",
                                            "speaker": "无名",
                                            "text": "啊，有一阵子没挥刀了，都能听到「贵月胴切」她在抱怨了。"
                                        },
                                        {
                                            "id": "721240126",
                                            "speaker": "无名",
                                            "text": "你听，她在喊着想砍你啊，哈哈哈。和你打上一场，她也会开心吧。",
                                            "choices": [
                                                {
                                                    "id": "721240127",
                                                    "text": "你是疯子吗？",
                                                    "response": [
                                                        {
                                                            "id": "721240129",
                                                            "speaker": "无名",
                                                            "text": "「贵月胴切」的声音，你难道听不到吗？太可惜了。"
                                                        },
                                                        {
                                                            "id": "721240130",
                                                            "speaker": "无名",
                                                            "text": "生死悬于刀上之人，都会懂得倾听刀的声音。…呵呵，她又在催我动手了。"
                                                        },
                                                        {
                                                            "id": "721240131",
                                                            "speaker": "无名",
                                                            "text": "来吧，把你的武器亮出来，和我赌一赌胜负。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "721240128",
                                                    "text": "刀不会说话。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "721240118",
                                    "text": "回想一下你到这里来的时候。",
                                    "response": [
                                        {
                                            "id": "721240119",
                                            "speaker": "无名",
                                            "text": "我在这里的时候？我只记得我在这里挥刀，至于挥刀做什么…"
                                        },
                                        {
                                            "id": "721240120",
                                            "speaker": "无名",
                                            "text": "哈哈，对了，这个我记得，我挥刀是为了斩人！"
                                        },
                                        {
                                            "id": "721240121",
                                            "speaker": "无名",
                                            "text": "只要挥刀斩了眼前的敌人，全身的血都会像江水一样奔涌起来，何其畅快，哈哈哈哈。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "721240107",
                    "text": "摸摸你身上看看。",
                    "response": [
                        {
                            "id": "721240108",
                            "speaker": "无名",
                            "text": "没有，我已经找遍了，全都没有。"
                        },
                        {
                            "id": "721240109",
                            "speaker": "无名",
                            "text": "虽然我不记得了，但是我能感觉到不对，我要找的东西不在身上。"
                        },
                        {
                            "id": "721240110",
                            "speaker": "无名",
                            "text": "我要找的到底是什么…"
                        }
                    ]
                }
            ]
        }
    ]
}