    "dialogues": [
        {
            "id": "621110201",
            "speaker": "Player",
            "text": "您在做什么？"
        },
        {
            "id": "621110202",
            "speaker": "乔姨",
            "text": "阿婆我啊，只是在这儿帮忙看看摊位的。"
        },
        {
            "id": "621110203",
            "speaker": "乔姨",
            "text": "这附近卖茶的、卖茶叶的、卖茶叶蛋的，我都熟得很。"
        },
        {
            "id": "621110204",
            "speaker": "乔姨",
            "text": "他们有事的时候就让我来帮忙看看摊，他们都放心。"
        }
