{
    "talkId": "4008124",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 3,
        "茱塔": 17
    },
    "dialogues": [
        {
            "id": "400812401",
            "speaker": "茱塔",
            "text": "商机啊，真是大好的商机啊…",
            "choices": [
                {
                    "id": "400812402",
                    "text": "你是？",
                    "response": [
                        {
                            "id": "400812403",
                            "speaker": "茱塔",
                            "text": "我？如你所见，连一勺汤都分不到的，没人在意的蒙德商人罢了。"
                        },
                        {
                            "id": "400812404",
                            "speaker": "茱塔",
                            "text": "我原本只是来旅游的，听说有场比赛，就来凑凑热闹，结果看见惊人的商机，却没法和主办方谈拢，做不了生意，真痛苦啊…"
                        },
                        {
                            "id": "400812405",
                            "speaker": "派蒙",
                            "text": "原来是商人的本能觉醒了吗…",
                            "choices": [
                                {
                                    "id": "400812406",
                                    "text": "呜呜，赚不到钱…",
                                    "response": [
                                        {
                                            "id": "400812408",
                                            "speaker": "茱塔",
                                            "text": "我不难过，我只是觉得可惜。"
                                        },
                                        {
                                            "id": "400812409",
                                            "speaker": "茱塔",
                                            "text": "要我说，他们根本没把这场比赛的商业潜力发挥出来。主赛场附近居然连一个商位都没布置。"
                                        },
                                        {
                                            "id": "400812410",
                                            "speaker": "茱塔",
                                            "text": "这个参赛选手大量出没的秘境旁边，居然也连一个休息站都不安排，哪怕是卖普通小吃的摊位也好啊！"
                                        },
                                        {
                                            "id": "400812411",
                                            "speaker": "茱塔",
                                            "text": "换成是我，从这第一次比赛开始，就要大量售卖比赛限定版的纪念品、玩具和画册。"
                                        },
                                        {
                                            "id": "400812412",
                                            "speaker": "茱塔",
                                            "text": "出售餐饮的摊位也越多越好，不仅要向选手们提供三餐，还要尽可能服务更多观众。"
                                        },
                                        {
                                            "id": "400812413",
                                            "speaker": "茱塔",
                                            "text": "对了，他们好像还在赛场周围布置了很多映影机，据说还对一些比赛拍摄了「映影」什么的记录，也能拿来卖个好价钱。"
                                        },
                                        {
                                            "id": "400812414",
                                            "speaker": "茱塔",
                                            "text": "想要看「映影」的话，播放设备应该也要不少摩拉吧！"
                                        },
                                        {
                                            "id": "400812415",
                                            "speaker": "茱塔",
                                            "text": "总之，这场比赛的各个环节，都能找出很棒的盈利点！"
                                        },
                                        {
                                            "id": "400812416",
                                            "speaker": "派蒙",
                                            "text": "按你这么说，好像确实能赚不少钱呢。不过，主办方和赞助商好像不缺钱的样子，也许他们根本不在意能挣多少钱吧。"
                                        },
                                        {
                                            "id": "400812417",
                                            "speaker": "茱塔",
                                            "text": "这就是问题所在了！就算只是为了某种…高尚的精神！也可以把赚到的资金投入到以后的比赛里去，形成一种良性循环。"
                                        },
                                        {
                                            "id": "400812418",
                                            "speaker": "茱塔",
                                            "text": "我感觉吧，比赛幕后的赞助方其实没什么商业头脑，不像是什么…久经商场的老手。"
                                        },
                                        {
                                            "id": "400812419",
                                            "speaker": "茱塔",
                                            "text": "倒像是手里突然有一大笔闲钱，然后就乱花的暴发户。到底怎么回事？"
                                        },
                                        {
                                            "id": "400812420",
                                            "speaker": "派蒙",
                                            "text": "居然会有这么严苛的商人！对同行也一点不嘴下留情呢…"
                                        },
                                        {
                                            "id": "400812421",
                                            "speaker": "Player",
                                            "text": "或许只是你考虑得比较多。"
                                        },
                                        {
                                            "id": "400812422",
                                            "speaker": "茱塔",
                                            "text": "这话我爱听，谢谢！"
                                        },
                                        {
                                            "id": "400812423",
                                            "speaker": "茱塔",
                                            "text": "不过夸奖归夸奖，是没法换成摩拉的。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400812407",
                                    "text": "没事啦，以后还有机会。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400812424",
                    "text": "不打扰了…",
                    "response": [
                        {
                            "id": "400812425",
                            "speaker": "茱塔",
                            "text": "那就再见了，如果想讨论商业上的问题，我本来是有时间的。"
                        }
                    ]
                }
            ]
        }
    ]
}