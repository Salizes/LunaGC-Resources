{
    "talkId": "6913208",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "布伦妮": 15
    },
    "dialogues": [
        {
            "id": "691320301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691320302",
            "speaker": "布伦妮",
            "text": "既然你提到了，我们就来聊聊那个「终极反派」——艾莉丝吧。"
        },
        {
            "id": "691320303",
            "speaker": "Player",
            "text": "你们俩都是我的朋友…"
        },
        {
            "id": "691320304",
            "speaker": "布伦妮",
            "text": "别误会，不是要你现在就站队。魔女蛊惑人心的花样非常多，就算暂时被蒙蔽了也是可以被理解的。"
        },
        {
            "id": "691320305",
            "speaker": "布伦妮",
            "text": "我相信你的眼睛是雪亮的，谁对谁错你迟早会明辨！"
        },
        {
            "id": "691320306",
            "speaker": "布伦妮",
            "text": "只是我最近在反思，为什么每一次明面上是我「战胜」了她，结果却总是变成「按照她的剧本演完了下一幕」？"
        },
        {
            "id": "691320307",
            "speaker": "布伦妮",
            "text": "好不甘心！我需要一个熟悉魔女的人帮我复盘！"
        },
        {
            "id": "691320308",
            "speaker": "布伦妮",
            "text": "你说艾莉丝的「算盘」里到底有什么逻辑？"
        },
        {
            "id": "691320309",
            "speaker": "布伦妮",
            "text": "你这么聪明，能帮我想想怎么才能扳回一城吗？让她也尝尝「失算」的滋味！"
        },
        {
            "id": "691320310",
            "speaker": "Player",
            "text": "有没有可能，她根本不讲逻辑…"
        },
        {
            "id": "691320311",
            "speaker": "布伦妮",
            "text": "……！"
        },
        {
            "id": "691320312",
            "speaker": "布伦妮",
            "text": "你说得对。那个邪恶巫婆，做事总是随心所欲，借着什么「有趣」的名义肆意妄为…"
        },
        {
            "id": "691320313",
            "speaker": "布伦妮",
            "text": "那我该怎么对付她？",
            "choices": [
                {
                    "id": "691320314",
                    "text": "那就当个撒泼打滚的小孩…",
                    "response": [
                        {
                            "id": "691320316",
                            "speaker": "布伦妮",
                            "text": "谁会故意干那种又吵又闹，还会被人讨厌的事情啊！"
                        },
                        {
                            "id": "691320317",
                            "speaker": "布伦妮",
                            "text": "等等…你不对劲。我有理由怀疑你是魔女假扮的。"
                        },
                        {
                            "id": "691320318",
                            "speaker": "布伦妮",
                            "text": "难道你是…让我看看你的真面目——",
                            "choices": [
                                {
                                    "id": "691320319",
                                    "text": "其实是想让你不要想太多…",
                                    "response": [
                                        {
                                            "id": "691320321",
                                            "speaker": "布伦妮",
                                            "text": "唔…突然这么说，也不可能马上就做得到吧…"
                                        },
                                        {
                                            "id": "691320322",
                                            "speaker": "布伦妮",
                                            "text": "至少得从可莉她们身上稍微学一学…"
                                        }
                                    ]
                                },
                                {
                                    "id": "691320320",
                                    "text": "你也可以像孩子般随心所欲。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691320315",
                    "text": "用「魔法」打败「魔法」！"
                }
            ]
        }
    ]
}