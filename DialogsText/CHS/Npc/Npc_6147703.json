    "dialogues": [
        {
            "id": "4015147703",
            "speaker": "尼尔森",
            "text": "蒙德怎么样？"
        },
        {
            "id": "4015147707",
            "speaker": "尼尔森",
            "text": "这可是一个好地方。"
        },
        {
            "id": "4015147708",
            "speaker": "尼尔森",
            "text": "至于什么北境的明冠啊，浪漫的牧歌之城啊，那都是文化人整出来的说法。"
        },
        {
            "id": "4015147709",
            "speaker": "尼尔森",
            "text": "要我说，风景好，酒好，足够了！"
        },
        {
            "id": "4015147710",
            "speaker": "尼尔森",
            "text": "嗝，别地的酒都没这儿的好！不去不去。"
        }
    ]
}