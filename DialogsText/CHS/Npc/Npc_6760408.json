    "dialogues": [
        {
            "id": "676040801",
            "speaker": "Player",
            "text": "洛恩队长？"
        },
        {
            "id": "676040802",
            "speaker": "艾克贝特",
            "text": "洛恩是我们第五小队的副队长…虽然跟队长也没差了！"
        },
        {
            "id": "676040803",
            "speaker": "艾克贝特",
            "text": "你可能也听说过，洛恩队长对待敌人就像寒风一样毫不留情，对待下属…"
        },
        {
            "id": "676040804",
            "speaker": "Player",
            "text": "就像春风一样和煦？"
        },
        {
            "id": "676040805",
            "speaker": "艾克贝特",
            "text": "不，也像寒风一样冰冷，光是想想酒就醒了一半。"
        }
    ]
}