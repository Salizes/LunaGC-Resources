    },
    "dialogues": [
        {
            "id": "644700401",
            "speaker": "Player",
            "text": "去沙漠？"
        },
        {
            "id": "644700402",
            "speaker": "欧诺莉",
            "text": "一名正经的工程师，每天却在修理小发条机关，你说这是什么道理？"
        },
        {
            "id": "644700403",
            "speaker": "欧诺莉",
            "text": "想到那些宏伟的坎瑞亚遗迹机关，我的心已经飞到了沙漠深处…"
        },
        {
            "id": "644700404",
            "speaker": "欧诺莉",
            "text": "自己的退步固然难受，同僚的进步更加令人揪心。与此同时沃特蒙泰涅在璃月的研究说不定正在突飞猛进。"
        },
        {
            "id": "644700405",
            "speaker": "欧诺莉",
            "text": "呜呜！我一定要去沙漠。"
        }
    ]
}