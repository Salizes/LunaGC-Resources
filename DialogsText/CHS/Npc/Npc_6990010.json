{
    "talkId": "6990010",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 8,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "699001001",
            "speaker": "Player",
            "text": "关于雷泽…"
        },
        {
            "id": "699001002",
            "speaker": "派蒙",
            "text": "#{NICKNAME}，你知道毛笔吗？",
            "choices": [
                {
                    "id": "699001003",
                    "text": "用动物的毛做成的笔…",
                    "response": [
                        {
                            "id": "699001005",
                            "speaker": "派蒙",
                            "text": "嗯，答对了！据说好的毛笔能在璃月商人那边卖出高价呢！"
                        },
                        {
                            "id": "699001006",
                            "speaker": "Player",
                            "text": "所以派蒙也想做毛笔？"
                        },
                        {
                            "id": "699001007",
                            "speaker": "派蒙",
                            "text": "嗯！但是野外的狼都太凶了，所以我们去薅雷泽的毛做毛笔吧！"
                        },
                        {
                            "id": "699001008",
                            "speaker": "派蒙",
                            "text": "雷泽毛茸茸的，肯定能做出上好的狼毫笔！然后我们就能大赚一笔！",
                            "choices": [
                                {
                                    "id": "699001009",
                                    "text": "这样做出来的笔肯定带电…",
                                    "response": [
                                        {
                                            "id": "699001011",
                                            "speaker": "Player",
                                            "text": "而且雷泽不是狼…"
                                        },
                                        {
                                            "id": "699001013",
                                            "speaker": "派蒙",
                                            "text": "欸——那为什么要叫做狼毫笔！"
                                        },
                                        {
                                            "id": "699001014",
                                            "speaker": "Player",
                                            "text": "你看果酒湖里不也没有果酒吗。"
                                        },
                                        {
                                            "id": "699001015",
                                            "speaker": "派蒙",
                                            "text": "喔——很有道理呢！"
                                        }
                                    ]
                                },
                                {
                                    "id": "699001010",
                                    "text": "没办法用吧…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699001004",
                    "text": "可以拿来写字？"
                }
            ]
        }
    ]
}