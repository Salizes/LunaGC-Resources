    "dialogues": [
        {
            "id": "690140201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690140701",
            "speaker": "芭芭拉",
            "text": "嗯，我很喜欢这里！"
        },
        {
            "id": "690140702",
            "speaker": "芭芭拉",
            "text": "与蒙德城不同的风景，对我来说很有新鲜感。"
        },
        {
            "id": "690140703",
            "speaker": "芭芭拉",
            "text": "练习唱歌的时候，也可以放开歌喉。不用担心万一打扰到了别人该怎么办。",
            "choices": [
                {
                    "id": "690140704",
                    "text": "芭芭拉的歌声不能说是打扰吧。",
                    "response": [
                        {
                            "id": "690140705",
                            "speaker": "芭芭拉",
                            "text": "唔…"
                        },
                        {
                            "id": "690140706",
                            "speaker": "芭芭拉",
                            "text": "谢谢你能这样说。但我…还是要多考虑点别人的感受嘛。"
                        },
                        {
                            "id": "690140707",
                            "speaker": "芭芭拉",
                            "text": "总之，我很开心能收到你的邀请。"
                        },
                        {
                            "id": "690140710",
                            "speaker": "芭芭拉",
                            "text": "我还想在这里多待一会儿。"
                        }
                    ]
                },
                {
                    "id": "690140708",
                    "text": "那就太好了。",
                    "response": [
                        {
                            "id": "690140709",
                            "speaker": "芭芭拉",
                            "text": "嗯，我很开心能收到你的邀请。"
                        }
                    ]
                }
            ]
        }
    ]
}