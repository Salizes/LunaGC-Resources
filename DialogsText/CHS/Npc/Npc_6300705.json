    "dialogues": [
        {
            "id": "630070501",
            "speaker": "Player",
            "text": "身为老板却在喝酒吗？"
        },
        {
            "id": "630070502",
            "speaker": "冈崎陆斗",
            "text": "有何不可？清酒在手，佳肴常伴，不来一杯怎么对得起奔波的一生。"
        },
        {
            "id": "630070503",
            "speaker": "冈崎陆斗",
            "text": "加油，有朝一日你当了老板，也能像我一样。"
        }
    ]
