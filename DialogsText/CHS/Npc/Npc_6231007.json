    "dialogues": [
        {
            "id": "623100701",
            "speaker": "Player",
            "text": "师父！"
        },
        {
            "id": "623100702",
            "speaker": "路爷",
            "text": "哦哦，此话当真？"
        },
        {
            "id": "623100703",
            "speaker": "路爷",
            "text": "但看你的样子，也有不得不做的事情，有不得不去的地方吧。"
        },
        {
            "id": "623100704",
            "speaker": "路爷",
            "text": "等你把该做的事情做完了，到时候如果老夫还健在，再来叫我师父吧。"
        },
        {
            "id": "623100705",
            "speaker": "路爷",
            "text": "决定了，届时一定倾尽全力把「范木堂」的手艺传授给你。"
        }
    ]
