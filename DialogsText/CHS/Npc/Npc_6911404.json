{
    "talkId": "6911404",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "丝柯克": 16
    },
    "dialogues": [
        {
            "id": "691140401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691140402",
            "speaker": "丝柯克",
            "text": "你有所谓「净化深渊」的力量。我很好奇如果在实战中遇到，会对我的进攻策略造成什么样的影响。"
        },
        {
            "id": "691140403",
            "speaker": "丝柯克",
            "text": "百闻不如一见…",
            "choices": [
                {
                    "id": "691140404",
                    "text": "你该不会…",
                    "response": [
                        {
                            "id": "691140406",
                            "speaker": "丝柯克",
                            "text": "算了。即使是仙人法器，也难以承受我们全力以赴的战斗。"
                        },
                        {
                            "id": "691140407",
                            "speaker": "丝柯克",
                            "text": "切磋就放到下次。今天，我想和你探讨一个问题。"
                        },
                        {
                            "id": "691140408",
                            "speaker": "丝柯克",
                            "text": "世间生灵面对深渊，或是被侵染致死，或是像我一样适应它、利用它。"
                        },
                        {
                            "id": "691140409",
                            "speaker": "丝柯克",
                            "text": "而你有着如此特别的力量，不打算用它做点什么？"
                        },
                        {
                            "id": "691140410",
                            "speaker": "Player",
                            "text": "我用这份力量帮助过别人。"
                        },
                        {
                            "id": "691140411",
                            "speaker": "丝柯克",
                            "text": "不意外的回答，说明你仍然坚守善良与正义。"
                        },
                        {
                            "id": "691140412",
                            "speaker": "丝柯克",
                            "text": "许多人都相信自己能够救人于水火，但当他们真的拥有力量，却又常常用于谋取私利。"
                        },
                        {
                            "id": "691140413",
                            "speaker": "丝柯克",
                            "text": "是因为他们心志不坚，或是力量注定诱人堕落，你觉得呢？",
                            "choices": [
                                {
                                    "id": "691140414",
                                    "text": "还是要有一颗坚定的心。",
                                    "response": [
                                        {
                                            "id": "691140415",
                                            "speaker": "丝柯克",
                                            "text": "师父曾说，人所做的一切都是为了满足自己。"
                                        },
                                        {
                                            "id": "691140416",
                                            "speaker": "丝柯克",
                                            "text": "但也有许多像你一样的人愿意为他人使用力量，可见事无绝对。"
                                        },
                                        {
                                            "id": "691140421",
                                            "speaker": "丝柯克",
                                            "text": "好了，先聊到这里吧。探讨复杂的问题能够帮我们明晰道路，但不能因此耽误训练。"
                                        },
                                        {
                                            "id": "691140422",
                                            "speaker": "丝柯克",
                                            "text": "开始练剑。一起来吗？"
                                        }
                                    ]
                                },
                                {
                                    "id": "691140417",
                                    "text": "力量本就会催化欲望。",
                                    "response": [
                                        {
                                            "id": "691140418",
                                            "speaker": "丝柯克",
                                            "text": "每个人都有不可言说的欲望。"
                                        },
                                        {
                                            "id": "691140419",
                                            "speaker": "丝柯克",
                                            "text": "没有力量的加持，无法实现的欲望会蛰伏在心底。但有了力量，一切就变得不同。"
                                        },
                                        {
                                            "id": "691140420",
                                            "speaker": "丝柯克",
                                            "text": "不能指望每个个体都坚守初心，所以才需要规则来约束。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691140405",
                    "text": "是想在这里…！"
                }
            ]
        }
    ]
}