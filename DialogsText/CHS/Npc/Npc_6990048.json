{
    "talkId": "6990048",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699004801",
            "speaker": "Player",
            "text": "关于回声之子的宝石…"
        },
        {
            "id": "699004802",
            "speaker": "派蒙",
            "text": "说起来，这边的山谷有好多亮闪闪的宝石呢！"
        },
        {
            "id": "699004803",
            "speaker": "派蒙",
            "text": "机会难得，我们也在附近挖挖看吧。要是运气好的话，说不定就能挖到超级厉害的宝石，再也不用担心摩拉不够用啦！"
        },
        {
            "id": "699004804",
            "speaker": "Player",
            "text": "咦？派蒙能分辨宝石的种类吗？"
        },
        {
            "id": "699004805",
            "speaker": "派蒙",
            "text": "呃，这个…只要是亮闪闪的东西，就一定是好东西！嗯，应该是这样没错！",
            "choices": [
                {
                    "id": "699004806",
                    "text": "听上去简直就像是…",
                    "response": [
                        {
                            "id": "699004808",
                            "speaker": "派蒙",
                            "text": "哼哼，既然到了纳塔，就不应该叫「恶龙」，而是应该叫「贤龙」啦！"
                        },
                        {
                            "id": "699004809",
                            "speaker": "派蒙",
                            "text": "#「勇敢而机智的{NICKNAME}呀，就让本贤龙指引你找到超级厉害的宝石吧——」"
                        },
                        {
                            "id": "699004810",
                            "speaker": "Player",
                            "text": "明明连宝石的种类都没办法分辨？"
                        }
                    ]
                },
                {
                    "id": "699004807",
                    "text": "童话故事里收集财宝的恶龙一样呢。"
                }
            ]
        }
    ]
}