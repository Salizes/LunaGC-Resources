    "dialogues": [
        {
            "id": "653530201",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "653530202",
            "speaker": "福斯卡里",
            "text": "你忘了我的名字了吗？我是法乌斯图斯，神王委任的边境商人。"
        },
        {
            "id": "653530203",
            "speaker": "福斯卡里",
            "text": "多亏你救了我，我才能及时把南国的香料送来这里。"
        },
        {
            "id": "653530204",
            "speaker": "福斯卡里",
            "text": "神王在上，愿他永远荣耀。"
        }
    ]
}