    "dialogues": [
        {
            "id": "660980401",
            "speaker": "Player",
            "text": "什么样的合作？"
        },
        {
            "id": "660980402",
            "speaker": "霍娅",
            "text": "还挺多的呢，我想想…"
        },
        {
            "id": "660980403",
            "speaker": "霍娅",
            "text": "有时冒险家们会请流泉之众的人做向导，或者请烟谜主的医生出诊，如果自己联系不到人脉，倒是可以让我帮忙传个信。"
        },
        {
            "id": "660980404",
            "speaker": "霍娅",
            "text": "大伙儿都有自己擅长或不擅长的事情嘛，互相帮助是应该的。"
        }
    ]
}