{
    "talkId": "6903203",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "班尼特": 11
    },
    "dialogues": [
        {
            "id": "690320301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690320302",
            "speaker": "班尼特",
            "text": "好呀，和你说说我冒险的见闻吧！"
        },
        {
            "id": "690320303",
            "speaker": "班尼特",
            "text": "嗯…前几天，我在冒险途中发现了一种颜色奇怪的树莓。"
        },
        {
            "id": "690320304",
            "speaker": "班尼特",
            "text": "甜倒是很甜，就是…"
        },
        {
            "id": "690320305",
            "speaker": "Player",
            "text": "难道拉肚子了？"
        },
        {
            "id": "690320306",
            "speaker": "班尼特",
            "text": "啊，拉肚子什么的，我倒是习惯了啦。"
        },
        {
            "id": "690320307",
            "speaker": "班尼特",
            "text": "一开始是有色彩斑斓的光点，后面变成了小人手拉手在脑袋里跳舞。"
        },
        {
            "id": "690320308",
            "speaker": "班尼特",
            "text": "我人倒是好得也快，就是遗憾也没放点在包里…"
        },
        {
            "id": "690320309",
            "speaker": "班尼特",
            "text": "告诉大家，这种树莓不能吃。",
            "choices": [
                {
                    "id": "690320310",
                    "text": "班尼特真的很考虑别人呢…",
                    "response": [
                        {
                            "id": "690320311",
                            "speaker": "班尼特",
                            "text": "哎呀…这也是应该的。"
                        },
                        {
                            "id": "690320312",
                            "speaker": "班尼特",
                            "text": "我受到那么多人的照顾，当然也要回报大家！"
                        },
                        {
                            "id": "690320315",
                            "speaker": "班尼特",
                            "text": "哦，对了！下次有冒险记得叫上我哦，有我在的话，我能帮你避开这些危险！"
                        }
                    ]
                },
                {
                    "id": "690320313",
                    "text": "班尼特也要更小心自己…",
                    "response": [
                        {
                            "id": "690320314",
                            "speaker": "班尼特",
                            "text": "谢谢你…不过，有时候我小心了也没用。还不如提醒提醒别人。"
                        }
                    ]
                }
            ]
        }
    ]
}