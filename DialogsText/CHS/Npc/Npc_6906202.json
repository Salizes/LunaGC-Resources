{
    "talkId": "6906202",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "埃洛伊": 12
    },
    "dialogues": [
        {
            "id": "690620201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690620202",
            "speaker": "埃洛伊",
            "text": "如果你是问我住得舒不舒服的话…那当然很舒服了。"
        },
        {
            "id": "690620203",
            "speaker": "埃洛伊",
            "text": "但是要说习不习惯…抱歉啦，总是呆在这，多少还是有些不适应。",
            "choices": [
                {
                    "id": "690620204",
                    "text": "有哪里不对吗？",
                    "response": [
                        {
                            "id": "690620205",
                            "speaker": "埃洛伊",
                            "text": "不不不，没有哪里不对，这里的一切都棒极了。"
                        },
                        {
                            "id": "690620206",
                            "speaker": "埃洛伊",
                            "text": "只不过，我比较习惯露宿荒野。"
                        },
                        {
                            "id": "690620207",
                            "speaker": "埃洛伊",
                            "text": "你知道的，我的故乡几乎每天都会发生点事。"
                        },
                        {
                            "id": "690620208",
                            "speaker": "埃洛伊",
                            "text": "比如到处乱跑的机械巨兽、总是对人抱着敌意的奇怪部落，还有想要毁灭一切的超级机械怪物…"
                        },
                        {
                            "id": "690620209",
                            "speaker": "埃洛伊",
                            "text": "习惯了那种生活之后，突然一下子变得这么安稳…我还是需要点时间来适应。"
                        }
                    ]
                },
                {
                    "id": "690620210",
                    "text": "你是想出去冒险吗？",
                    "response": [
                        {
                            "id": "690620211",
                            "speaker": "埃洛伊",
                            "text": "那再好不过了！虽然这里的环境很不错，但我还是想多出去转转。老是待在这，我的弓弦都要松了。"
                        },
                        {
                            "id": "690620212",
                            "speaker": "埃洛伊",
                            "text": "这次出去，你可得好好和我说一下那种叫做「遗迹守卫」的家伙。"
                        },
                        {
                            "id": "690620213",
                            "speaker": "埃洛伊",
                            "text": "我觉得，我应该很擅长对付那种家伙，毕竟它身上也有个会发光的点。"
                        },
                        {
                            "id": "690620214",
                            "speaker": "埃洛伊",
                            "text": "而且打倒了它之后，也可以从它身上拆下来零件…"
                        },
                        {
                            "id": "690620215",
                            "speaker": "埃洛伊",
                            "text": "虽然那种零件怪模怪样的，没办法拿来改造我的弓箭…但你拿着应该有用，对吧？"
                        }
                    ]
                }
            ]
        }
    ]
}