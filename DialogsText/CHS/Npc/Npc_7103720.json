    "dialogues": [
        {
            "id": "710372001",
            "speaker": "简易公告板",
            "text": "「层岩巨渊勘探队在此暂行驻扎，请各位队员行动时注意安全规范，如无许可请勿单独行动！请勿擅自触碰层岩巨渊深处出现的不明物质！」",
            "choices": [
                {
                    "id": "710372002",
                    "text": "继续阅读…",
                    "response": [
                        {
                            "id": "710372004",
                            "speaker": "留言",
                            "text": "「近来在巨渊主矿区部分地带发现不明黑色泥状物质，非常危险！下矿人员应当格外小心，避开被黑泥污染之地域…如有疑惑请寻志琼为之讲解引路。」",
                            "choices": [
                                {
                                    "id": "710372005",
                                    "text": "继续阅读…",
                                    "response": [
                                        {
                                            "id": "710372007",
                                            "speaker": "留言",
                                            "text": "「塔列辛的鞋子湿掉了，请补给队多带些换洗衣物鞋子下来。」"
                                        },
                                        {
                                            "id": "710372008",
                                            "speaker": "留言",
                                            "text": "「另外为处理流明石『触媒』，瑾武姐还需要一套备用工具，请补给队尽快送达，十分感谢！」",
                                            "choices": [
                                                {
                                                    "id": "710372009",
                                                    "text": "继续阅读…",
                                                    "response": [
                                                        {
                                                            "id": "710372011",
                                                            "speaker": "不完整的纸条",
                                                            "text": "（被撕去一半的纸条，布满了复杂的运算痕迹和几何图形，似乎与占星术有关…）",
                                                            "choices": [
                                                                {
                                                                    "id": "710372012",
                                                                    "text": "继续阅读…",
                                                                    "response": [
                                                                        {
                                                                            "id": "710372014",
                                                                            "speaker": "备忘留言",
                                                                            "text": "「巨渊主矿区的『开山炮』似乎完好无损，应当可以利用来进一步打开通道，即可为勘探工作节省大量时间。」"
                                                                        },
                                                                        {
                                                                            "id": "710372015",
                                                                            "speaker": "备忘留言",
                                                                            "text": "「但首先要清除其周围盘踞的匪徒才行。不过也有好消息：千岩军已经出动，正在截断地面盗宝团的交易。」"
                                                                        },
                                                                        {
                                                                            "id": "710372016",
                                                                            "speaker": "备忘留言",
                                                                            "text": "「只要地面上的渠道被截断了，地下的这些盗宝团或许很快就会不攻自走吧…」"
                                                                        },
                                                                        {
                                                                            "id": "710372017",
                                                                            "speaker": "勘探队营地告示牌",
                                                                            "text": "「另外，需要多补充蔬菜。地下呆久了缺少阳光，大家都比较需要禽蛋、香菇与鱼来补充缺失的营养。」",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "710372018",
                                                                                    "text": "继续阅读…",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "710372020",
                                                                                            "speaker": "老旧的通知",
                                                                                            "text": "（看起来这张通知已饱经风霜了，似乎是勘探队到来之前由矿工所张贴的。）"
                                                                                        },
                                                                                        {
                                                                                            "id": "710372021",
                                                                                            "speaker": "老旧的通知",
                                                                                            "text": "「…矿下环境复杂，在矿下狭窄区域工作时，请一定要带上团雀笼，以防有毒易燃气体泄漏！请诸位矿工记住二哥的教训！」",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "710372022",
                                                                                                    "text": "继续阅读…",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "710372024",
                                                                                                            "speaker": "残缺的留言",
                                                                                                            "text": "（这张残缺的纸条边缘被烧成了深褐色，看来有人用火把阅读它的时候，没能控制好距离…）"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "710372025",
                                                                                                            "speaker": "残缺的留言",
                                                                                                            "text": "「矿工均配有专门的晶石灯具，请勿携带火把下矿！专业人员自会指示生火地点，如不熟悉地形请勿自行搭建营地…」",
                                                                                                            "choices": [
                                                                                                                {
                                                                                                                    "id": "710372026",
                                                                                                                    "text": "继续阅读…",
                                                                                                                    "response": [
                                                                                                                        {
                                                                                                                            "id": "710372028",
                                                                                                                            "speaker": "矿工的留言",
                                                                                                                            "text": "「撤离时请注意秩序！带好个人物品，请勿慌张，在地面下达信号后即可依照小队顺逐步撤离！」"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "710372029",
                                                                                                                            "speaker": "矿工的留言",
                                                                                                                            "text": "「距『晶石碎片』太近的施工人员，不论是否出现不良反应，请优先向医务队报到，尽快离开层岩巨渊！」"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "710372030",
                                                                                                                            "speaker": "矿工的留言",
                                                                                                                            "text": "「工友们请稍安勿躁，听从上级通知！」",
                                                                                                                            "choices": [
                                                                                                                                {
                                                                                                                                    "id": "710372031",
                                                                                                                                    "text": "继续阅读…",
                                                                                                                                    "response": [
                                                                                                                                        {
                                                                                                                                            "id": "710372033",
                                                                                                                                            "speaker": "被遮住的留言",
                                                                                                                                            "text": "（被较新的通知与留言部分遮盖的留言，似乎时间稍近，可能是矿坑封闭后不久张贴的。）"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "710372034",
                                                                                                                                            "speaker": "被遮住的留言",
                                                                                                                                            "text": "「在『晶石碎片』被发现后，『流明石』晶矿似乎开始快速增生，其利弊需要勘探团队进一步确认…」",
                                                                                                                                            "choices": [
                                                                                                                                                {
                                                                                                                                                    "id": "710372035",
                                                                                                                                                    "text": "继续阅读…",
                                                                                                                                                    "response": [
                                                                                                                                                        {
                                                                                                                                                            "id": "710372037",
                                                                                                                                                            "speaker": "破旧的名单",
                                                                                                                                                            "text": "（一张破旧的名单，似乎是矿坑封闭后的第一批勘探队所留。）"
                                                                                                                                                        },
                                                                                                                                                        {
                                                                                                                                                            "id": "710372038",
                                                                                                                                                            "speaker": "破旧的名单",
                                                                                                                                                            "text": "「为调查与充分利用『流明石』晶矿的开发潜能，特邀请以下专业人员在此搭建营地，进行取样研究实验：」"
                                                                                                                                                        },
                                                                                                                                                        {
                                                                                                                                                            "id": "710372039",
                                                                                                                                                            "speaker": "破旧的名单",
                                                                                                                                                            "text": "「…副研究主任，瑾武；实验助理，阿扎迪…勘探员，何志、何卫…」"
                                                                                                                                                        }
                                                                                                                                                    ]
                                                                                                                                                },
                                                                                                                                                {
                                                                                                                                                    "id": "710372036",
                                                                                                                                                    "text": "离开"
                                                                                                                                                }
                                                                                                                                            ]
                                                                                                                                        }
