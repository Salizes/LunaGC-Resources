{
    "talkId": "6906411",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "云堇": 15
    },
    "dialogues": [
        {
            "id": "690640401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690640402",
            "speaker": "云堇",
            "text": "说起来，有件事我一直记在心里。"
        },
        {
            "id": "690640403",
            "speaker": "云堇",
            "text": "小时候，父亲给我讲过许多仙人传说。其中一则，说的是绝云间里有仙府。"
        },
        {
            "id": "690640404",
            "speaker": "Player",
            "text": "仙府？"
        },
        {
            "id": "690640405",
            "speaker": "云堇",
            "text": "没错。传说中仙人们能乘光倚电，奔入云霄，一直飞进那座仙府里去。"
        },
        {
            "id": "690640406",
            "speaker": "云堇",
            "text": "「在那里，他们俯瞰山川河流，与天地同游，不知俗世红尘为何物。」"
        },
        {
            "id": "690640407",
            "speaker": "云堇",
            "text": "每次说到这儿，父亲都会露出沉醉的表情。"
        },
        {
            "id": "690640408",
            "speaker": "云堇",
            "text": "故事流传至今，谁也没见过传说中的仙府…"
        },
        {
            "id": "690640409",
            "speaker": "云堇",
            "text": "但我总是念念不忘，好想去那里看一看。"
        },
        {
            "id": "690640410",
            "speaker": "云堇",
            "text": "想到那里唱上一曲，请天地人神都听一听我们的声音。",
            "choices": [
                {
                    "id": "690640411",
                    "text": "我可能知道类似的地方。",
                    "response": [
                        {
                            "id": "690640413",
                            "speaker": "云堇",
                            "text": "嗯？真的？"
                        },
                        {
                            "id": "690640414",
                            "speaker": "云堇",
                            "text": "不不…你的话肯定不会有假。但…答案来得太突然，我还没想好到时候该唱什么，又要怎么打扮才好…",
                            "choices": [
                                {
                                    "id": "690640415",
                                    "text": "慢慢想也没关系。",
                                    "response": [
                                        {
                                            "id": "690640417",
                                            "speaker": "云堇",
                                            "text": "多谢！实在是太感谢你了。"
                                        },
                                        {
                                            "id": "690640418",
                                            "speaker": "云堇",
                                            "text": "……"
                                        },
                                        {
                                            "id": "690640419",
                                            "speaker": "云堇",
                                            "text": "唔…好，我大概有想法了。这出戏，不如就唱你与仙家打交道的选段…"
                                        },
                                        {
                                            "id": "690640420",
                                            "speaker": "云堇",
                                            "text": "至于行头，就想请你帮着参谋参谋。"
                                        },
                                        {
                                            "id": "690640421",
                                            "speaker": "Player",
                                            "text": "一言为定。"
                                        },
                                        {
                                            "id": "690640422",
                                            "speaker": "云堇",
                                            "text": "嗯，说好了。我从今天，啊…从现在就开始练习吧！一定要拿出最完美的成果。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690640416",
                                    "text": "想好再陪你一起去。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690640412",
                    "text": "如果是庆云顶上空的话…"
                }
            ]
        }
    ]
}