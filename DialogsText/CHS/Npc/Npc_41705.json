{
    "talkId": "41705",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "布兰琪": 6
    },
    "dialogues": [
        {
            "id": "4015142313",
            "speaker": "Player",
            "text": "想了解些事情。"
        },
        {
            "id": "4015142314",
            "speaker": "布兰琪",
            "text": "请说~我在听着呢~",
            "choices": [
                {
                    "id": "4015142303",
                    "text": "关于蒙德百货。",
                    "response": [
                        {
                            "id": "4015142307",
                            "speaker": "布兰琪",
                            "text": "虽然看起来店面不大，但是我们在璃月港建有储货仓库~"
                        },
                        {
                            "id": "4015142308",
                            "speaker": "布兰琪",
                            "text": "商品的种类~数量~供货速度，都是蒙德城第一哟。"
                        }
                    ]
                },
                {
                    "id": "4015142304",
                    "text": "关于蒙德城的特色…",
                    "response": [
                        {
                            "id": "4015142309",
                            "speaker": "布兰琪",
                            "text": "蒙德城是以酒闻名的城市~最著名的特色当然是酒馆~"
                        },
                        {
                            "id": "4015142310",
                            "speaker": "布兰琪",
                            "text": "在蒙德城，大部分人每天都会去遍布城内的酒馆~小酌几杯~放松自己~"
                        },
                        {
                            "id": "4015142311",
                            "speaker": "布兰琪",
                            "text": "所以在晚上的酒馆里~经常能看见许多人展现截然不同的姿态呢~"
                        }
                    ]
                }
            ]
        }
    ]
}