{
    "talkId": "6908902",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 7,
        "芙宁娜": 12
    },
    "dialogues": [
        {
            "id": "690890201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690890202",
            "speaker": "芙宁娜",
            "text": "当然。这里视野开阔，天气也不错，是个度假的好地方。"
        },
        {
            "id": "690890203",
            "speaker": "芙宁娜",
            "text": "没想到你购置了如此广袤的土地，还能将它打理得井井有条，想必花费了不少心思。"
        },
        {
            "id": "690890204",
            "speaker": "Player",
            "text": "倒也不算「购置」…"
        },
        {
            "id": "690890205",
            "speaker": "芙宁娜",
            "text": "我听说了，似乎是璃月的某种技术。到底是怎么做到的呢？"
        },
        {
            "id": "690890206",
            "speaker": "芙宁娜",
            "text": "我很想把那个壶拆开看看，可惜暂时没有把握组装回去，还是算了吧。"
        },
        {
            "id": "690890207",
            "speaker": "芙宁娜",
            "text": "这地方还真是有趣，仿佛蕴藏着无限的可能。唯一的遗憾就是太清静了，你住在这里不会感到孤独吗？"
        },
        {
            "id": "690890208",
            "speaker": "芙宁娜",
            "text": "如果想热闹一些的话，我想想…举办一场舞会怎么样？枫丹那些上流人士应该会很乐意跟你搞好关系，借用场地来尽情歌舞。",
            "choices": [
                {
                    "id": "690890209",
                    "text": "也不是什么人都能进来的啦。",
                    "response": [
                        {
                            "id": "690890211",
                            "speaker": "芙宁娜",
                            "text": "这、这样啊。嗯…那我们来办一场小型的舞会吧！"
                        },
                        {
                            "id": "690890212",
                            "speaker": "芙宁娜",
                            "text": "不需要邀请太多人，也不需要繁多的准备。让世界成为我们的舞台，随时随地都可以开启一段即兴演出。"
                        },
                        {
                            "id": "690890213",
                            "speaker": "芙宁娜",
                            "text": "好了——还站在那做什么？莫非想让我来伸出手吗？"
                        },
                        {
                            "id": "690890214",
                            "speaker": "Player",
                            "text": "能请您跳支舞吗？"
                        },
                        {
                            "id": "690890215",
                            "speaker": "芙宁娜",
                            "text": "我很乐意。不过…你真的会跳舞吗？",
                            "choices": [
                                {
                                    "id": "690890216",
                                    "text": "这个嘛…",
                                    "response": [
                                        {
                                            "id": "690890218",
                                            "speaker": "芙宁娜",
                                            "text": "好吧，握着我的手。放轻松，先将胳膊和腿舒展开。"
                                        },
                                        {
                                            "id": "690890219",
                                            "speaker": "芙宁娜",
                                            "text": "等会儿看我的步调就好。作为枫丹最耀眼的明星，这种小事就像吃饭喝水一样简单。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690890217",
                                    "text": "马马虎虎？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690890210",
                    "text": "我只会带重要的人到这里来。"
                }
            ]
        }
    ]
}