{
    "talkId": "2205001",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 8,
        "「寝子」": 14,
        "派蒙": 8
    },
    "dialogues": [
        {
            "id": "220500101",
            "speaker": "「寝子」",
            "text": "喔？是汝等啊，来得正好。"
        },
        {
            "id": "220500102",
            "speaker": "「寝子」",
            "text": "汝等，知道哪里长着一棵大大的，颜色粉粉的，而且还很高很高的树吗？"
        },
        {
            "id": "220500103",
            "speaker": "Player",
            "text": "什、什么？"
        },
        {
            "id": "220500104",
            "speaker": "「寝子」",
            "text": "就是和神社旁边那种花瓣粉粉的树一样，但是长得很高很高的树啊。"
        },
        {
            "id": "220500105",
            "speaker": "「寝子」",
            "text": "那棵树周围，还有很多酥酥麻麻，能让毛变成毛球的东西。"
        },
        {
            "id": "220500106",
            "speaker": "派蒙",
            "text": "酥酥麻麻，能让毛变成毛球的东西…应该是雷元素…"
        },
        {
            "id": "220500107",
            "speaker": "Player",
            "text": "树应该就是樱树了…"
        },
        {
            "id": "220500108",
            "speaker": "派蒙",
            "text": "雷元素和樱树，在稻妻感觉随处可见啊…",
            "choices": [
                {
                    "id": "220500109",
                    "text": "那棵树旁边还有什么吗？",
                    "response": [
                        {
                            "id": "220500111",
                            "speaker": "「寝子」",
                            "text": "阿响说那棵树的形状像狐狸。然后，那棵树旁边，还有一座很大很大的「神社」。"
                        },
                        {
                            "id": "220500112",
                            "speaker": "「寝子」",
                            "text": "和那棵树一样，都在很高的地方，神社的下面就是那种酥酥麻麻，能让毛变成毛球的东西。"
                        },
                        {
                            "id": "220500113",
                            "speaker": "派蒙",
                            "text": "很高的樱树和神社，还有雷元素…"
                        },
                        {
                            "id": "220500114",
                            "speaker": "派蒙",
                            "text": "呃！难、难道寝子说的是…"
                        },
                        {
                            "id": "220500115",
                            "speaker": "Player",
                            "text": "鸣神大社的那棵「神樱」。"
                        },
                        {
                            "id": "220500116",
                            "speaker": "派蒙",
                            "text": "嗯，感觉符合这三点的地方，全稻妻也就那么一个地方了呢。但是…"
                        },
                        {
                            "id": "220500117",
                            "speaker": "Player",
                            "text": "为什么要找那棵树？"
                        },
                        {
                            "id": "220500118",
                            "speaker": "「寝子」",
                            "text": "怎么，知道那棵树在哪吗？不愧是奴家相中的人。"
                        },
                        {
                            "id": "220500119",
                            "speaker": "「寝子」",
                            "text": "这是阿响提过的地方。阿响说，她曾经在那附近待过一段时间。"
                        },
                        {
                            "id": "220500120",
                            "speaker": "「寝子」",
                            "text": "而且，她还很喜欢那棵很大很大的树飘下来的花瓣。"
                        },
                        {
                            "id": "220500121",
                            "speaker": "「寝子」",
                            "text": "……"
                        },
                        {
                            "id": "220500122",
                            "speaker": "「寝子」",
                            "text": "奴家想，阿响之所以到现在还没回来，会不会是因为她正在什么地方办事呢？"
                        },
                        {
                            "id": "220500123",
                            "speaker": "「寝子」",
                            "text": "既然阿响暂时不回来，那奴家就过去找她好了。"
                        },
                        {
                            "id": "220500124",
                            "speaker": "「寝子」",
                            "text": "汝等知道那棵树在哪里。请带奴家去看看。"
                        },
                        {
                            "id": "220500125",
                            "speaker": "派蒙",
                            "text": "欸？！那、那神社怎么办？"
                        },
                        {
                            "id": "220500126",
                            "speaker": "「寝子」",
                            "text": "石头人类会代替奴家照料神社的。毋须担心。",
                            "choices": [
                                {
                                    "id": "220500127",
                                    "text": "拜托大岛先生了。",
                                    "response": [
                                        {
                                            "id": "220500129",
                                            "speaker": "派蒙",
                                            "text": "#想不到{NICKNAME}也有说出这句话的一天呢…"
                                        },
                                        {
                                            "id": "220500130",
                                            "speaker": "派蒙",
                                            "text": "大岛先生可真是辛苦了啊。那我们就出发吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "220500128",
                                    "text": "那就交给他了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "220500110",
                    "text": "那棵树有什么特征吗？"
                }
            ]
        }
    ]
}