{
    "talkId": "6911107",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "瓦雷莎": 14
    },
    "dialogues": [
        {
            "id": "691110201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691110202",
            "speaker": "瓦雷莎",
            "text": "唔？这个问题，我要想一想…"
        },
        {
            "id": "691110203",
            "speaker": "瓦雷莎",
            "text": "平时我喜欢在各种地方野营，有的时候，停好运水果的货车，随便在路边找块平整的草地，搭起帐篷，我也感觉很自在。"
        },
        {
            "id": "691110204",
            "speaker": "瓦雷莎",
            "text": "似乎，除了参加「归火圣夜巡礼」的团体赛，被对手们热切注视着之外，我还没有过「不习惯」的感受…",
            "choices": [
                {
                    "id": "691110205",
                    "text": "好强大的适应力！",
                    "response": [
                        {
                            "id": "691110207",
                            "speaker": "瓦雷莎",
                            "text": "但这里不一样！"
                        },
                        {
                            "id": "691110208",
                            "speaker": "瓦雷莎",
                            "text": "它让我有一种，其他地方都没有的…安心感？"
                        },
                        {
                            "id": "691110209",
                            "speaker": "瓦雷莎",
                            "text": "就像是…有人已经为我安排好了一切，从植物、到房子，再到小小的陈设，全都让我超舒坦，好神奇！"
                        },
                        {
                            "id": "691110210",
                            "speaker": "瓦雷莎",
                            "text": "哪怕在家里，有好几次，妈妈随手搬走了我常坐的椅子，我闭着眼睛不小心一下子坐空，哐咚一下摔在地上…"
                        },
                        {
                            "id": "691110211",
                            "speaker": "瓦雷莎",
                            "text": "嘿嘿…还好我身体本来就圆圆的，没有受伤。",
                            "choices": [
                                {
                                    "id": "691110212",
                                    "text": "没错，就是为你特别安排的！",
                                    "response": [
                                        {
                                            "id": "691110213",
                                            "speaker": "瓦雷莎",
                                            "text": "真，真的吗？我，我我…"
                                        },
                                        {
                                            "id": "691110214",
                                            "speaker": "瓦雷莎",
                                            "text": "#英雄{NICKNAME}把我当成重要的客人招待了！这可是好多大人物不曾得到的殊荣！力量有如泉涌！"
                                        },
                                        {
                                            "id": "691110218",
                                            "speaker": "瓦雷莎",
                                            "text": "哦！我现在充满干劲，要好好加油，努力锻炼才行！"
                                        },
                                        {
                                            "id": "691110219",
                                            "speaker": "瓦雷莎",
                                            "text": "#英雄{NICKNAME}！我们来撞拳！"
                                        }
                                    ]
                                },
                                {
                                    "id": "691110215",
                                    "text": "其实，这也是我喜欢的风格。",
                                    "response": [
                                        {
                                            "id": "691110216",
                                            "speaker": "瓦雷莎",
                                            "text": "真，真的吗？我，我我…"
                                        },
                                        {
                                            "id": "691110217",
                                            "speaker": "瓦雷莎",
                                            "text": "#我和走遍各地，见识过诸多英豪俊杰的{NICKNAME}喜欢一样的环境，默契不言自明！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691110206",
                    "text": "天然发现快乐的心态！"
                }
            ]
        }
    ]
}