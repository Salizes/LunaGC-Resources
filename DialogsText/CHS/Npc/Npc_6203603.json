    "dialogues": [
        {
            "id": "620360301",
            "speaker": "Player",
            "text": "关于岩王帝君的死…"
        },
        {
            "id": "620360302",
            "speaker": "观海",
            "text": "是啊，岩王爷都走了，璃月是不是要完了呢…"
        },
        {
            "id": "620360303",
            "speaker": "观海",
            "text": "每当想起这件事，我就完全提不起工作的热情了，沉浸在迷茫中不能自拔…"
        },
        {
            "id": "620360304",
            "speaker": "观海",
            "text": "嗯？你说我本来就这样？"
        },
        {
            "id": "620360305",
            "speaker": "观海",
            "text": "唔，那只能说明我已经颓废到了不能再颓废的地步…"
        },
        {
            "id": "620360306",
            "speaker": "观海",
            "text": "嗯…"
        },
        {
            "id": "620360307",
            "speaker": "观海",
            "text": "我真厉害啊。"
        }
    ]
}