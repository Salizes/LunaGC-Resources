    "dialogues": [
        {
            "id": "732205601",
            "speaker": "马塞拉",
            "text": "哦，这位不是尊贵的客人…"
        },
        {
            "id": "732205602",
            "speaker": "马塞拉",
            "text": "真是了不起，您居然真的达成了那样的伟业。"
        },
        {
            "id": "732205603",
            "speaker": "马塞拉",
            "text": "说不定有一日，我有需求您帮助的时候，到那时，还望您能够伸出援手。",
            "choices": [
                {
                    "id": "732205604",
                    "text": "当然可以，不过先来局牌吧。",
                    "response": [
                        {
                            "id": "732205605",
                            "speaker": "马塞拉",
                            "text": "跟您来上一局吗，那可真是我的荣幸。"
                        }
                    ]
                },
                {
                    "id": "732205606",
                    "text": "到时候我会帮忙的。",
                    "response": [
                        {
                            "id": "732205607",
                            "speaker": "马塞拉",
                            "text": "那我就提前谢过了。"
                        }
                    ]
                }
            ]
        }
    ]
}