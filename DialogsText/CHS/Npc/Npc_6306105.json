    "dialogues": [
        {
            "id": "630610501",
            "speaker": "Player",
            "text": "我可以泡「御温泉」吗？"
        },
        {
            "id": "630610502",
            "speaker": "三河茜",
            "text": "非常抱歉，恕难从命。"
        },
        {
            "id": "630610503",
            "speaker": "三河茜",
            "text": "「御温泉」是幕府专享的场所，内里设施严格按照官位等级分配。"
        },
        {
            "id": "630610504",
            "speaker": "三河茜",
            "text": "因为有私人隔间，罕有耳目，所以也时常成为大人们密谈的场所，谢绝外人进入。"
        }
    ]
}