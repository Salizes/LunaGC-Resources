{
    "talkId": "6903308",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "达达利亚": 10
    },
    "dialogues": [
        {
            "id": "690330801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690330401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690330402",
            "speaker": "达达利亚",
            "text": "嗯…你什么时候能抽出几周的闲暇呢。"
        },
        {
            "id": "690330403",
            "speaker": "达达利亚",
            "text": "我想带你看看老家的风景。"
        },
        {
            "id": "690330404",
            "speaker": "达达利亚",
            "text": "看看漫天的风雪，站上去踩几脚都不会碎开的冰湖湖面。"
        },
        {
            "id": "690330405",
            "speaker": "达达利亚",
            "text": "有的人家会做大型的冰雕作品…"
        },
        {
            "id": "690330406",
            "speaker": "达达利亚",
            "text": "如果你喜欢打雪仗的话，我可以和你一队，让弟弟妹妹们一起上。"
        },
        {
            "id": "690330407",
            "speaker": "达达利亚",
            "text": "哦，对了！我还可以用老家的特产给你做地道的甜菜汤。"
        },
        {
            "id": "690330408",
            "speaker": "达达利亚",
            "text": "…还能冰钓钓鱼！比池子里养的鱼可大多了。",
            "choices": [
                {
                    "id": "690330409",
                    "text": "听起来很棒。",
                    "response": [
                        {
                            "id": "690330411",
                            "speaker": "达达利亚",
                            "text": "好，那就说好了！"
                        },
                        {
                            "id": "690330412",
                            "speaker": "达达利亚",
                            "text": "哈…看来我得先跟家里知会一声。"
                        },
                        {
                            "id": "690330413",
                            "speaker": "达达利亚",
                            "text": "我都想象得到，他们围在一起读信时，脸上开心的表情啦。"
                        }
                    ]
                },
                {
                    "id": "690330410",
                    "text": "我很期待！"
                }
            ]
        }
    ]
}