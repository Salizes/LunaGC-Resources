{
    "talkId": "6990022",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 8
    },
    "dialogues": [
        {
            "id": "699002201",
            "speaker": "Player",
            "text": "关于五郎…"
        },
        {
            "id": "699002202",
            "speaker": "派蒙",
            "text": "嗯…"
        },
        {
            "id": "699002203",
            "speaker": "Player",
            "text": "派蒙在烦恼什么呢？"
        },
        {
            "id": "699002204",
            "speaker": "派蒙",
            "text": "#{NICKNAME}，你还记得五郎那毛茸茸的耳朵吗？"
        },
        {
            "id": "699002205",
            "speaker": "派蒙",
            "text": "我也好想要那个…或者像甘雨一样，有可爱的角也不错。"
        },
        {
            "id": "699002206",
            "speaker": "派蒙",
            "text": "#{NICKNAME}，你有什么好办法吗？"
        },
        {
            "id": "699002207",
            "speaker": "Player",
            "text": "让我找找…啊，有了。"
        },
        {
            "id": "699002208",
            "speaker": "派蒙",
            "text": "#真的吗？{NICKNAME}，我就知道你是最可靠的！"
        },
        {
            "id": "699002209",
            "speaker": "Player",
            "text": "锵锵~「吞天之鲸·只角」！"
        },
        {
            "id": "699002210",
            "speaker": "派蒙",
            "text": "不是要这个啦！"
        },
        {
            "id": "699002211",
            "speaker": "派蒙",
            "text": "唉…不过仔细想想，五郎不仅有毛茸茸的耳朵，还有尾巴呢…"
        },
        {
            "id": "699002212",
            "speaker": "Player",
            "text": "锵锵~「北风之尾」！"
        },
        {
            "id": "699002213",
            "speaker": "派蒙",
            "text": "都说了不需要啦！而且这两个组合起来绝对会很奇怪吧！"
        }
    ]
}