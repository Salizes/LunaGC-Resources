{
    "talkId": "37314",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "丽莎": 9
    },
    "dialogues": [
        {
            "id": "3730926",
            "speaker": "丽莎",
            "text": "最近和不熟的人打招呼变得困难了，「今天天气不错」这种万能的招式，居然失效了…",
            "choices": [
                {
                    "id": "3730927",
                    "text": "关于图书馆。",
                    "response": [
                        {
                            "id": "3730928",
                            "speaker": "丽莎",
                            "text": "无论想要查阅什么资料，都可以来图书馆。"
                        },
                        {
                            "id": "3730929",
                            "speaker": "丽莎",
                            "text": "图书馆自然是免费开放的哦。"
                        },
                        {
                            "id": "3730930",
                            "speaker": "丽莎",
                            "text": "只是记得借阅的图书一定要按时归还，不然…姐姐我可是会很为难的。"
                        }
                    ]
                },
                {
                    "id": "3730931",
                    "text": "有关怪物。",
                    "response": [
                        {
                            "id": "3730932",
                            "speaker": "丽莎",
                            "text": "关于荒野上那些怪物的资料？图书馆里有不少呢。"
                        },
                        {
                            "id": "3730933",
                            "speaker": "丽莎",
                            "text": "灵活运用元素带来的优势，是轻松取胜的诀窍。"
                        },
                        {
                            "id": "3730934",
                            "speaker": "丽莎",
                            "text": "对了，你考虑过来图书馆找份兼职工作吗？"
                        },
                        {
                            "id": "3730935",
                            "speaker": "丽莎",
                            "text": "最近打杂…不，跑腿…不，支援的人手有些不足…"
                        }
                    ]
                },
                {
                    "id": "3730936",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "3730937",
                            "speaker": "丽莎",
                            "text": "要走了吗？记得有空的时候回来看看喔。"
                        }
                    ]
                }
            ]
        }
    ]
}