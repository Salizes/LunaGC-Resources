{
    "talkId": "7411860",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "路通": 12
    },
    "dialogues": [
        {
            "id": "741186001",
            "speaker": "路通",
            "text": "#啊，{NICKNAME}，很高兴见到您。"
        },
        {
            "id": "741186002",
            "speaker": "路通",
            "text": "但我不得不告诉您…虽然非常遗憾，但咱们的佩特莉可镇之行，必须得稍稍延后。",
            "choices": [
                {
                    "id": "741186003",
                    "text": "佩特莉可镇发生了什么？",
                    "response": [
                        {
                            "id": "741186004",
                            "speaker": "路通",
                            "text": "一些…危机，危险，未知的情况。差不多类似于此。"
                        },
                        {
                            "id": "741186007",
                            "speaker": "路通",
                            "text": "根据警官的说法，佩特莉可镇里的居民现在似乎都陷入了一种…奇怪的沉睡中。"
                        },
                        {
                            "id": "741186008",
                            "speaker": "路通",
                            "text": "警官认为也许是某种具有催眠效应的自然气体从镇底泄露。"
                        },
                        {
                            "id": "741186009",
                            "speaker": "路通",
                            "text": "为了安全起见，她们正在劝离任何想要在这个时间段进入镇子的人…我们也在其列。"
                        },
                        {
                            "id": "741186010",
                            "speaker": "路通",
                            "text": "加尔恰先生十分担心那几位尚居镇内的朋友，甚至想要一个人偷偷去镇里。"
                        },
                        {
                            "id": "741186011",
                            "speaker": "路通",
                            "text": "还好迦雅小姐的身手颇为敏捷，她拦住了加尔恰先生，并将先生友好地绑在了屋里。"
                        },
                        {
                            "id": "741186012",
                            "speaker": "Player",
                            "text": "友好地…绑在屋里？"
                        },
                        {
                            "id": "741186013",
                            "speaker": "路通",
                            "text": "我们给他准备好了垫子，绑住他的也是绸缎，我相信他不会受到除了良心谴责外的任何伤害。"
                        },
                        {
                            "id": "741186014",
                            "speaker": "路通",
                            "text": "总而言之，咱们现在只能待在枫丹廷里了。有警官们和剧团成员的帮忙，那些觊觎先生研究成果的人也不敢轻举妄动。"
                        },
                        {
                            "id": "741186015",
                            "speaker": "路通",
                            "text": "#等到能够出发了，我一定第一时间来通知您，亲爱的{NICKNAME}。"
                        }
                    ]
                },
                {
                    "id": "741186005",
                    "text": "你们的旅费不够了吗？",
                    "response": [
                        {
                            "id": "741186006",
                            "speaker": "路通",
                            "text": "您这句话着实没有说错。但我们的行程是被更大的问题阻拦的。"
                        }
                    ]
                }
            ]
        }
    ]
}