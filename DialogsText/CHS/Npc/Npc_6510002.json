{
    "talkId": "6510002",
    "total_dialogue_lines": 5,
    "speaker_counts": {
        "Player": 1,
        "瑟萝": 4
    },
    "dialogues": [
        {
            "id": "651000201",
            "speaker": "Player",
            "text": "你自己在这不寂寞吗？"
        },
        {
            "id": "651000202",
            "speaker": "瑟萝",
            "text": "嗯？不会哦。"
        },
        {
            "id": "651000203",
            "speaker": "瑟萝",
            "text": "这里有时会有很多人来，非常拥挤；有时又会和现在一样，到处空荡荡。"
        },
        {
            "id": "651000204",
            "speaker": "瑟萝",
            "text": "很像来回拍打在海岸上的潮水，对不对？"
        },
        {
            "id": "651000205",
            "speaker": "瑟萝",
            "text": "有这样的潮水陪伴，我一点都不寂寞。"
        }
    ]
}