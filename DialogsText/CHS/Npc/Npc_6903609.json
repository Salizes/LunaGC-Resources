{
    "talkId": "6903609",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "重云": 7
    },
    "dialogues": [
        {
            "id": "690360901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690360202",
            "speaker": "重云",
            "text": "嗯，对我来说是个适合久居的好地方。"
        },
        {
            "id": "690360203",
            "speaker": "重云",
            "text": "洞天之内虽不比雪山凉爽，却也不用担心烈日暴晒、气温骤变。"
        },
        {
            "id": "690360204",
            "speaker": "重云",
            "text": "不用顾忌「纯阳之体」的影响，就可以一直专心练功。",
            "choices": [
                {
                    "id": "690360205",
                    "text": "不去外面多走走吗？",
                    "response": [
                        {
                            "id": "690360206",
                            "speaker": "重云",
                            "text": "走也走，不过得随身带伞，看着点太阳。"
                        },
                        {
                            "id": "690360209",
                            "speaker": "重云",
                            "text": "话说回来，谢谢你邀请我来这样宜居的地方…"
                        },
                        {
                            "id": "690360210",
                            "speaker": "重云",
                            "text": "有什么需要我做的，我一定全力相助。"
                        }
                    ]
                },
                {
                    "id": "690360207",
                    "text": "看来不用担心洞天内有妖邪了。",
                    "response": [
                        {
                            "id": "690360208",
                            "speaker": "重云",
                            "text": "那是自然，我可以向你担保。"
                        }
                    ]
                }
            ]
        }
    ]
}