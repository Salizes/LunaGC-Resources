{
    "talkId": "6990012",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 4,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699001201",
            "speaker": "Player",
            "text": "关于传说中的万能女仆…"
        },
        {
            "id": "699001202",
            "speaker": "派蒙",
            "text": "分享生活小智慧时间到！"
        },
        {
            "id": "699001203",
            "speaker": "Player",
            "text": "生活小智慧？"
        },
        {
            "id": "699001204",
            "speaker": "派蒙",
            "text": "在蒙德，如果有东西怎么修都修不好，或者怎么洗都洗不干净…"
        },
        {
            "id": "699001205",
            "speaker": "派蒙",
            "text": "遇到这种事，自己又处理不了的话，就可以对着天空大喊一声："
        },
        {
            "id": "699001206",
            "speaker": "派蒙",
            "text": "「诺——艾——尔——！」"
        },
        {
            "id": "699001207",
            "speaker": "派蒙",
            "text": "所有的烦心事，就都会被马上解决啦。"
        },
        {
            "id": "699001208",
            "speaker": "Player",
            "text": "这就是蒙德人的生活小智慧吗？"
        },
        {
            "id": "699001209",
            "speaker": "Player",
            "text": "太棒了，学到许多…"
        }
    ]
}