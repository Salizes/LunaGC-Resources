{
    "talkId": "6902209",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "温迪": 8
    },
    "dialogues": [
        {
            "id": "690220901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690220202",
            "speaker": "温迪",
            "text": "那是当然的喽。"
        },
        {
            "id": "690220203",
            "speaker": "温迪",
            "text": "我知道这里一草一木都来自你的汗水，我正怀着感激的心情和它们相处呢！",
            "choices": [
                {
                    "id": "690220204",
                    "text": "温迪喜欢就最好了。",
                    "response": [
                        {
                            "id": "690220205",
                            "speaker": "温迪",
                            "text": "嗯，喜欢！"
                        },
                        {
                            "id": "690220208",
                            "speaker": "温迪",
                            "text": "哎呀，虽然你征询我的意见，我很开心。"
                        },
                        {
                            "id": "690220209",
                            "speaker": "温迪",
                            "text": "但你也要对自己的品位更加自信一点嘛！"
                        },
                        {
                            "id": "690220210",
                            "speaker": "温迪",
                            "text": "在这里，你就是真正的主角呀！"
                        },
                        {
                            "id": "690220211",
                            "speaker": "温迪",
                            "text": "大胆尝试，把自己的想法变成现实…遇到困难的时候，我也会来帮你的！"
                        }
                    ]
                },
                {
                    "id": "690220206",
                    "text": "温迪有什么想要的吗？",
                    "response": [
                        {
                            "id": "690220207",
                            "speaker": "温迪",
                            "text": "我想要的，这里都已经有了哟！"
                        }
                    ]
                }
            ]
        }
    ]
}