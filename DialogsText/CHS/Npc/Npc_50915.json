    "dialogues": [
        {
            "id": "5091501",
            "speaker": "留言",
            "text": "「清子，我喜欢你。」"
        },
        {
            "id": "5091502",
            "speaker": "留言",
            "text": "「虽然我是外国人，刚刚来到这片土地，什么也不懂。但是没关系的。」"
        },
        {
            "id": "5091503",
            "speaker": "留言",
            "text": "「这里的役人只要收了摩拉就什么也不会管，我们想在哪里约会都可以。」"
        },
        {
            "id": "5091504",
            "speaker": "留言",
            "text": "「而且我不缺摩拉…」"
        },
        {
            "id": "5091505",
            "speaker": "留言",
            "text": "「准确来说，是我爸爸啦，哈哈。」"
        }
    ]
}