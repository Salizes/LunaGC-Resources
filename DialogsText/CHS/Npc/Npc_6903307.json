{
    "talkId": "6903307",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "达达利亚": 9
    },
    "dialogues": [
        {
            "id": "690330701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690330301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690330302",
            "speaker": "达达利亚",
            "text": "好，我很乐意。"
        },
        {
            "id": "690330303",
            "speaker": "达达利亚",
            "text": "在至冬，有一种烈酒叫做「火水」。"
        },
        {
            "id": "690330304",
            "speaker": "达达利亚",
            "text": "一边在冰天雪地里喝着「火水」一边聊天的两人，基本就已经要好到了能上战场的关系。"
        },
        {
            "id": "690330305",
            "speaker": "达达利亚",
            "text": "现在，我可以和你这样自在地聊着天。"
        },
        {
            "id": "690330306",
            "speaker": "达达利亚",
            "text": "在战场上，我也能将后背托付给你。",
            "choices": [
                {
                    "id": "690330307",
                    "text": "你不怕我会先袭击你吗？",
                    "response": [
                        {
                            "id": "690330308",
                            "speaker": "达达利亚",
                            "text": "这就是我对你的信任了。"
                        },
                        {
                            "id": "690330311",
                            "speaker": "达达利亚",
                            "text": "征服世界的道路上，如果有你相伴，我们可就是最强的组合了。"
                        },
                        {
                            "id": "690330312",
                            "speaker": "达达利亚",
                            "text": "你愿意接受我的邀请吗？"
                        }
                    ]
                },
                {
                    "id": "690330309",
                    "text": "你不怕我会先倒下吗？",
                    "response": [
                        {
                            "id": "690330310",
                            "speaker": "达达利亚",
                            "text": "那你可就对自己的实力太不自信了。"
                        }
                    ]
                }
            ]
        }
    ]
}