    "speaker_counts": {
        "Player": 1,
        "舒山": 4
    },
    "dialogues": [
        {
            "id": "625160301",
            "speaker": "Player",
            "text": "手艺？"
        },
        {
            "id": "625160302",
            "speaker": "舒山",
            "text": "切石运石的工艺，石面雕花的手法…如此百八十种学问，都属于石匠的手艺。"
        },
        {
            "id": "625160303",
            "speaker": "舒山",
            "text": "沉玉谷里不止玉石，还有不少品质绝佳的石材，用来修路筑屋都是上选。"
        },
        {
            "id": "625160304",
            "speaker": "舒山",
            "text": "虽说本地的石匠不止我一家，但谁都希望世代流传之物继续发光发热下去。"
        },
        {
            "id": "625160305",
            "speaker": "舒山",
            "text": "你说，是这个理没错吧？"
        }
    ]
}