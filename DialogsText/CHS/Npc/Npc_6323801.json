{
    "talkId": "6323801",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "缘谷紫": 8
    },
    "dialogues": [
        {
            "id": "632380101",
            "speaker": "缘谷紫",
            "text": "#您、您好！{NICKNAME}，请问有什么需要帮忙的么？",
            "choices": [
                {
                    "id": "632380102",
                    "text": "关于「许愿」的事…",
                    "response": [
                        {
                            "id": "632380103",
                            "speaker": "缘谷紫",
                            "text": "这个啊，宫司大人应该交给您了一叠用来写签文的纸吧？"
                        },
                        {
                            "id": "632380104",
                            "speaker": "缘谷紫",
                            "text": "您只需要双手夹住签文纸，心里想着希望实现的愿望，再把愿望写在签文纸上…"
                        },
                        {
                            "id": "632380105",
                            "speaker": "缘谷紫",
                            "text": "最后，把写好的签文纸贴在绘马上，然后挂在绘马架上就好啦。"
                        },
                        {
                            "id": "632380106",
                            "speaker": "缘谷紫",
                            "text": "请放心！我不会偷看您的愿望的！我之所以在这里…也是因为要负责这周围的清洁工作…"
                        },
                        {
                            "id": "632380107",
                            "speaker": "缘谷紫",
                            "text": "毕竟我才刚刚进入这里工作不久，也只能负责这种简单的活计啦。"
                        },
                        {
                            "id": "632380108",
                            "speaker": "缘谷紫",
                            "text": "啊…！对不起对不起，我光顾着说话，肯定耽误您时间了，请您忙自己的事吧，我还要在这里收拾一下。"
                        }
                    ]
                },
                {
                    "id": "632380109",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "632380110",
                            "speaker": "缘谷紫",
                            "text": "下次再见，希望您能得偿所愿。"
                        }
                    ]
                }
            ]
        }
    ]
}