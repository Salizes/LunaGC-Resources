{
    "talkId": "6905210",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 8,
        "影": 12
    },
    "dialogues": [
        {
            "id": "690520501",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690520502",
            "speaker": "影",
            "text": "嗯，拔剑吧。",
            "choices": [
                {
                    "id": "690520503",
                    "text": "等等，现在吗？",
                    "response": [
                        {
                            "id": "690520505",
                            "speaker": "影",
                            "text": "哼，那就等你准备好了再来。我的时间很多。"
                        },
                        {
                            "id": "690520506",
                            "speaker": "影",
                            "text": "你的剑术是否有所生疏，我会用这一刀来确认。"
                        },
                        {
                            "id": "690520507",
                            "speaker": "Player",
                            "text": "原来你是认真的？"
                        },
                        {
                            "id": "690520508",
                            "speaker": "影",
                            "text": "那是当然。"
                        },
                        {
                            "id": "690520509",
                            "speaker": "影",
                            "text": "刀剑相交之时，瞬间亦能化作永恒。我能借此感受你的内心。"
                        },
                        {
                            "id": "690520510",
                            "speaker": "影",
                            "text": "这是比所有言语都简明、直接的方式。也是能让我确认自身存在的方式。",
                            "choices": [
                                {
                                    "id": "690520511",
                                    "text": "感觉哪里不太对劲…",
                                    "response": [
                                        {
                                            "id": "690520513",
                                            "speaker": "影",
                                            "text": "欸？已经被你看出来了吗？我还以为我装得够像了。"
                                        },
                                        {
                                            "id": "690520514",
                                            "speaker": "影",
                                            "text": "算了算了，我还是直说好了，我的确是想找你切磋来着。"
                                        },
                                        {
                                            "id": "690520515",
                                            "speaker": "影",
                                            "text": "毕竟能接下我一刀的人也不多啦。而且有你陪练…会很开心。"
                                        },
                                        {
                                            "id": "690520516",
                                            "speaker": "影",
                                            "text": "我怕你不愿意对我出手，才故意用了将军的样子。",
                                            "choices": [
                                                {
                                                    "id": "690520517",
                                                    "text": "其实不用绕弯子…",
                                                    "response": [
                                                        {
                                                            "id": "690520519",
                                                            "speaker": "影",
                                                            "text": "没有直接反对，那就是答应了？"
                                                        },
                                                        {
                                                            "id": "690520520",
                                                            "speaker": "影",
                                                            "text": "呵呵…要记得好好准备哦！我可是不会手下留情的。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690520518",
                                                    "text": "这个要求是有点奇怪…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690520512",
                                    "text": "是「影」吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690520504",
                    "text": "我完全没有心理准备…"
                }
            ]
        }
    ]
}