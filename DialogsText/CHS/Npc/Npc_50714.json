    "dialogues": [
        {
            "id": "5071401",
            "speaker": "通缉令",
            "text": "悬赏：绿川四郎"
        },
        {
            "id": "5071402",
            "speaker": "通缉令",
            "text": "罪名：逐电；啸聚；海贼；抢劫官员；伏狩武士；诱拐老母为质，妄图对抗官府。"
        },
        {
            "id": "5071403",
            "speaker": "通缉令",
            "text": "此人及其党羽，活捉或正法，皆有重赏！"
        }
    ]
}