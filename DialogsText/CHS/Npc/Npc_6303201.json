{
    "talkId": "6303201",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "阿茂": 6,
        "顺吉": 8
    },
    "dialogues": [
        {
            "id": "630320101",
            "speaker": "顺吉",
            "text": "…接着，就是现在，啪康一下！时间停止！"
        },
        {
            "id": "630320102",
            "speaker": "阿茂",
            "text": "等等，停一停…"
        },
        {
            "id": "630320103",
            "speaker": "顺吉",
            "text": "对，就是停一停，然后…"
        },
        {
            "id": "630320104",
            "speaker": "阿茂",
            "text": "不是的，我是说停下，啊不，不是说时间停下…"
        },
        {
            "id": "630320105",
            "speaker": "顺吉",
            "text": "哦哦，不要时停吗？那隐形呢？好像也不错。"
        },
        {
            "id": "630320106",
            "speaker": "阿茂",
            "text": "啊啊，听人说话啊，你这个人！"
        },
        {
            "id": "630320107",
            "speaker": "顺吉",
            "text": "哎？"
        },
        {
            "id": "630320108",
            "speaker": "阿茂",
            "text": "这个角色身上已经有很多超能力了吧？突然加设定的话，会整个垮掉的！"
        },
        {
            "id": "630320109",
            "speaker": "顺吉",
            "text": "可是…"
        },
        {
            "id": "630320110",
            "speaker": "阿茂",
            "text": "没有可是！你再好好想想。"
        },
        {
            "id": "630320111",
            "speaker": "顺吉",
            "text": "行吧…唉，灵感一下就没了。"
        },
        {
            "id": "630320112",
            "speaker": "顺吉",
            "text": "明明我的直觉说，这里就是要时间停止。"
        },
        {
            "id": "630320113",
            "speaker": "顺吉",
            "text": "要不…你再好好想想？"
        },
        {
            "id": "630320114",
            "speaker": "阿茂",
            "text": "呜，好累…"
        }
    ]
}