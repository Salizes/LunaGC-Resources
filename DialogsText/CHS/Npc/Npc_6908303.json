{
    "talkId": "6908303",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "琳妮特": 12
    },
    "dialogues": [
        {
            "id": "690830301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690830302",
            "speaker": "琳妮特",
            "text": "……"
        },
        {
            "id": "690830303",
            "speaker": "Player",
            "text": "……"
        },
        {
            "id": "690830304",
            "speaker": "琳妮特",
            "text": "…真罕见，很少会有人想让我先开启一个话题。"
        },
        {
            "id": "690830305",
            "speaker": "琳妮特",
            "text": "毕竟大部分情况下，都会像这样陷入沉默。",
            "choices": [
                {
                    "id": "690830306",
                    "text": "你不喜欢聊天吗？",
                    "response": [
                        {
                            "id": "690830307",
                            "speaker": "琳妮特",
                            "text": "不会哦，我经常和女孩子们聊天。"
                        },
                        {
                            "id": "690830308",
                            "speaker": "琳妮特",
                            "text": "不管是讨论新的小说情节，还是谁跟谁互相暗恋…"
                        },
                        {
                            "id": "690830309",
                            "speaker": "琳妮特",
                            "text": "只要在恰当的时机接一句「原来如此」、「竟然是这样」、「然后呢」…就可以顺利推进对话。"
                        },
                        {
                            "id": "690830310",
                            "speaker": "琳妮特",
                            "text": "…省力节能，我很推荐。"
                        }
                    ]
                },
                {
                    "id": "690830311",
                    "text": "毕竟不太说话呢…",
                    "response": [
                        {
                            "id": "690830312",
                            "speaker": "琳妮特",
                            "text": "要想说出一句话，得先倾听，再分析，构思完毕，最后讲出口。"
                        },
                        {
                            "id": "690830313",
                            "speaker": "琳妮特",
                            "text": "如果想你一句我一句地聊起天的话，就得高效处理这些情报…唔，有点费力。"
                        },
                        {
                            "id": "690830314",
                            "speaker": "琳妮特",
                            "text": "…不过也有一些人，本就希望聊天的对象多听、少说吧。"
                        },
                        {
                            "id": "690830315",
                            "speaker": "琳妮特",
                            "text": "如果你有什么想倾诉的事，可以来找我。在帮忙平复心情方面，我还是有点经验的。"
                        },
                        {
                            "id": "690830316",
                            "speaker": "琳妮特",
                            "text": "而且，完全不用担心我会到处乱说。"
                        }
                    ]
                }
            ]
        }
    ]
}