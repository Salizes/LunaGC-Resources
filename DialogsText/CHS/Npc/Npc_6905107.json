{
    "talkId": "6905107",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "优菈": 15
    },
    "dialogues": [
        {
            "id": "690510701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690510302",
            "speaker": "优菈",
            "text": "没想到你会有无聊的时候…行，你说吧。"
        },
        {
            "id": "690510303",
            "speaker": "Player",
            "text": "最近有什么让你记仇的事情吗？"
        },
        {
            "id": "690510304",
            "speaker": "优菈",
            "text": "嗯…我想想。"
        },
        {
            "id": "690510305",
            "speaker": "优菈",
            "text": "不久前接到了一起整治附近盗宝团的任务。"
        },
        {
            "id": "690510306",
            "speaker": "优菈",
            "text": "回来路上，顺手救了一个被魔物袭击的清泉镇猎人。"
        },
        {
            "id": "690510307",
            "speaker": "优菈",
            "text": "…没想到对方第二天居然送来了肉和酒。"
        },
        {
            "id": "690510308",
            "speaker": "优菈",
            "text": "明知道我是蒙德罪人后裔还敢来送东西…这仇当然得记。",
            "choices": [
                {
                    "id": "690510309",
                    "text": "是很值得记的仇。",
                    "response": [
                        {
                            "id": "690510310",
                            "speaker": "优菈",
                            "text": "不仅如此。"
                        },
                        {
                            "id": "690510311",
                            "speaker": "优菈",
                            "text": "因为肉很好吃，吃多了有点胀肚，还影响了喝酒的兴致…"
                        },
                        {
                            "id": "690510315",
                            "speaker": "Player",
                            "text": "这仇得再加一点。"
                        },
                        {
                            "id": "690510316",
                            "speaker": "优菈",
                            "text": "哈哈，我很认同你的看法。"
                        },
                        {
                            "id": "690510319",
                            "speaker": "优菈",
                            "text": "……"
                        },
                        {
                            "id": "690510320",
                            "speaker": "优菈",
                            "text": "只是这样跟你聊聊，心情却好了不少…"
                        },
                        {
                            "id": "690510321",
                            "speaker": "优菈",
                            "text": "咳咳…谢谢你。"
                        }
                    ]
                },
                {
                    "id": "690510312",
                    "text": "优菈没有受伤吧？",
                    "response": [
                        {
                            "id": "690510313",
                            "speaker": "优菈",
                            "text": "哈，区区魔物怎么可能伤到我…"
                        },
                        {
                            "id": "690510314",
                            "speaker": "优菈",
                            "text": "倒是因为肉很好吃，吃多了有点胀肚，还影响了喝酒的兴致…"
                        },
                        {
                            "id": "690510317",
                            "speaker": "Player",
                            "text": "那么好吃吗？我也想吃…"
                        },
                        {
                            "id": "690510318",
                            "speaker": "优菈",
                            "text": "哈哈哈，别了吧。你真要想的话…我给你做「骇浪派」吧。"
                        }
                    ]
                }
            ]
        }
    ]
}