{
    "talkId": "7328521",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "索希": 10
    },
    "dialogues": [
        {
            "id": "732852101",
            "speaker": "索希",
            "text": "…哦！是斯露莎大人的「谒颂主」。如果有什么想问的，我一定知无不言。",
            "choices": [
                {
                    "id": "732852102",
                    "text": "关于灵光碑…",
                    "response": [
                        {
                            "id": "732852103",
                            "speaker": "索希",
                            "text": "如各位所见，我没有放弃整理矫论团的文献。"
                        },
                        {
                            "id": "732852104",
                            "speaker": "索希",
                            "text": "虽说之前发现文献记录和实际情况有一些出入…"
                        },
                        {
                            "id": "732852105",
                            "speaker": "索希",
                            "text": "但我相信只要仔细分辨，一定能找到真相。"
                        }
                    ]
                },
                {
                    "id": "732852106",
                    "text": "关于愚人众…",
                    "response": [
                        {
                            "id": "732852107",
                            "speaker": "索希",
                            "text": "托各位的福，马尔科佐夫那一批队伍已经撤退了。"
                        },
                        {
                            "id": "732852108",
                            "speaker": "索希",
                            "text": "但这不代表愚人众就会轻易放弃…"
                        },
                        {
                            "id": "732852109",
                            "speaker": "索希",
                            "text": "或许矫论团应该考虑多招募一些有能之士，我是说，至少得比毕洛更可靠。"
                        }
                    ]
                },
                {
                    "id": "732852110",
                    "text": "关于矫论团…",
                    "response": [
                        {
                            "id": "732852111",
                            "speaker": "索希",
                            "text": "识主大人…不，那先朱那的所作所为令人不齿。但是能够在这样的情况下解决「焚真之天象」的问题…不愧是斯露莎大人！"
                        },
                        {
                            "id": "732852112",
                            "speaker": "索希",
                            "text": "唯一可惜的或许是，为什么我没能参与到这项伟大的事业之中…"
                        }
                    ]
                },
                {
                    "id": "732852113",
                    "text": "不打扰你了。",
                    "response": [
                        {
                            "id": "732852114",
                            "speaker": "索希",
                            "text": "太客气了。那我就继续自己的工作了。"
                        }
                    ]
                }
            ]
        }
    ]
}