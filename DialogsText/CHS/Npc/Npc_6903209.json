{
    "talkId": "6903209",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "班尼特": 9
    },
    "dialogues": [
        {
            "id": "690320901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690320202",
            "speaker": "班尼特",
            "text": "嗯！这里非常棒！"
        },
        {
            "id": "690320203",
            "speaker": "班尼特",
            "text": "比我在冒险时候露宿的地方，好上太多了！"
        },
        {
            "id": "690320204",
            "speaker": "班尼特",
            "text": "不用躲在树洞里休息，也不用担心魔物的突袭。"
        },
        {
            "id": "690320205",
            "speaker": "班尼特",
            "text": "还有天上砸下来的石头…地里突然蹦出来的骗骗花…",
            "choices": [
                {
                    "id": "690320206",
                    "text": "那冒险之余，多来坐坐吧。",
                    "response": [
                        {
                            "id": "690320207",
                            "speaker": "班尼特",
                            "text": "可、可以吗！太棒了！"
                        },
                        {
                            "id": "690320208",
                            "speaker": "班尼特",
                            "text": "我是多幸运啊，能够认识你这样好心的搭档！"
                        },
                        {
                            "id": "690320212",
                            "speaker": "班尼特",
                            "text": "嘿嘿…今后，也要给你添麻烦啦。"
                        }
                    ]
                },
                {
                    "id": "690320209",
                    "text": "这也太…辛苦了。",
                    "response": [
                        {
                            "id": "690320210",
                            "speaker": "班尼特",
                            "text": "没有没有…冒险嘛，都这样。"
                        },
                        {
                            "id": "690320211",
                            "speaker": "班尼特",
                            "text": "有你的关怀，我已经什么伤口都不觉得疼了！真的！"
                        }
                    ]
                }
            ]
        }
    ]
}