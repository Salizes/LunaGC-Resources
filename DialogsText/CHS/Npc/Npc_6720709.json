    "dialogues": [
        {
            "id": "672070901",
            "speaker": "Player",
            "text": "（翻看。）"
        },
        {
            "id": "672070902",
            "speaker": "阿舍鲁",
            "text": "喵…？"
        },
        {
            "id": "672070903",
            "speaker": "雅珂达",
            "text": "阿舍鲁啊阿舍鲁，来，爪子借我用用，让我拆信。"
        },
        {
            "id": "672070904",
            "speaker": "阿舍鲁",
            "text": "喵喵…喵喵喵，喵…"
        },
        {
            "id": "672070905",
            "speaker": "雅珂达",
            "text": "欸…我就开个玩笑，不会真的用啦，而且你爪子是不是好久没剪？"
        },
        {
            "id": "672070906",
            "speaker": "阿舍鲁",
            "text": "喵！喵喵——喵！"
        },
        {
            "id": "672070907",
            "speaker": "雅珂达",
            "text": "决定了，现在就给你剪一下，别动喔，我去拿指甲剪。"
        },
        {
            "id": "672070908",
            "speaker": "阿舍鲁",
            "text": "喵…喵！"
        }
    ]
}