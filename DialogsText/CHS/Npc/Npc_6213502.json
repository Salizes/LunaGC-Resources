{
    "talkId": "6213502",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "鬼伯伯": 17
    },
    "dialogues": [
        {
            "id": "621350201",
            "speaker": "Player",
            "text": "你是…？"
        },
        {
            "id": "621350202",
            "speaker": "鬼伯伯",
            "text": "呵呵…庄里的小鬼头都叫我鬼伯伯，因为我有讲不完的鬼故事。"
        },
        {
            "id": "621350203",
            "speaker": "鬼伯伯",
            "text": "怎么，你也要听故事吗？要听的话可要站稳了，别腿一软吓趴下了！",
            "choices": [
                {
                    "id": "621350204",
                    "text": "好啊。",
                    "response": [
                        {
                            "id": "621350205",
                            "speaker": "鬼伯伯",
                            "text": "有个叫小冥的小姑娘，生得娇巧可爱，就是运气不太好，害了一场大病就早夭了。"
                        },
                        {
                            "id": "621350206",
                            "speaker": "鬼伯伯",
                            "text": "她的妈妈天天以泪洗面，足不出户，受不了这样的打击。"
                        },
                        {
                            "id": "621350207",
                            "speaker": "鬼伯伯",
                            "text": "可忽然有一天家里出现了敲门声…咚，咚，咚…妈妈被吓坏了，小心翼翼地推开门一看…"
                        },
                        {
                            "id": "621350208",
                            "speaker": "鬼伯伯",
                            "text": "是一碗热乎乎的肉汤和一大盘煮熟的肉，却见不着半个人影…小冥的妈妈疑惑不解，便循着香喷喷的味道一路找了过去…"
                        },
                        {
                            "id": "621350209",
                            "speaker": "鬼伯伯",
                            "text": "结果误打误撞碰上一处丘丘人营地！丘丘人们立马将她团团围住，吓得她赶忙捂上了双眼…"
                        },
                        {
                            "id": "621350210",
                            "speaker": "鬼伯伯",
                            "text": "可半晌过去，却只听到「哒哒…哒哒…」的响声…妈妈慢慢把手拿开，看到的是…"
                        },
                        {
                            "id": "621350211",
                            "speaker": "鬼伯伯",
                            "text": "丘丘人们正跳着小冥生前最喜欢的那支舞呐！"
                        },
                        {
                            "id": "621350212",
                            "speaker": "鬼伯伯",
                            "text": "这时她的背后突然被什么轻轻撞了一下，却什么也看不到，只闻到一股香香甜甜而又熟悉的气味…"
                        },
                        {
                            "id": "621350213",
                            "speaker": "鬼伯伯",
                            "text": "妈妈落下了眼泪，原来死后的小冥并不孤单，她交上了一群可爱的朋友啊…",
                            "choices": [
                                {
                                    "id": "621350217",
                                    "text": "我怎么感觉挺温馨的…",
                                    "response": [
                                        {
                                            "id": "621350218",
                                            "speaker": "鬼伯伯",
                                            "text": "扯什么呢，那小冥可是鬼啊，鬼还不够吓人吗？"
                                        },
                                        {
                                            "id": "621350219",
                                            "speaker": "鬼伯伯",
                                            "text": "真是的，搞不清你的思路…"
                                        }
                                    ]
                                },
                                {
                                    "id": "621350220",
                                    "text": "有被吓到。",
                                    "response": [
                                        {
                                            "id": "621350221",
                                            "speaker": "鬼伯伯",
                                            "text": "嘿嘿…这可是我最得意的鬼故事，还没失过手呢！"
                                        },
                                        {
                                            "id": "621350222",
                                            "speaker": "鬼伯伯",
                                            "text": "最重要是…这故事它是真的…嘿嘿嘿…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "621350214",
                    "text": "还是不了…",
                    "response": [
                        {
                            "id": "621350215",
                            "speaker": "鬼伯伯",
                            "text": "哼…我还以为你的胆子会比那群小鬼头大多少呢…"
                        },
                        {
                            "id": "621350216",
                            "speaker": "鬼伯伯",
                            "text": "也罢，也罢…"
                        }
                    ]
                }
            ]
        }
    ]
}