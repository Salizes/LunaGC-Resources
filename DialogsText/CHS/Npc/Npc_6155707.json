    "speaker_counts": {
        "Player": 1,
        "乌尔法": 6
    },
    "dialogues": [
        {
            "id": "615570204",
            "speaker": "Player",
            "text": "…你在造船？"
        },
        {
            "id": "615570205",
            "speaker": "乌尔法",
            "text": "是啊，我只是想造一条能让我跟芙萝拉小姐泛舟湖上的小船而已！"
        },
        {
            "id": "615570206",
            "speaker": "乌尔法",
            "text": "想要配得上轻飘飘的芙萝拉小姐的话，船那沉重的龙骨必须撤掉的吧？"
        },
        {
            "id": "615570207",
            "speaker": "乌尔法",
            "text": "船底再用她最喜欢的蒲公英…"
        },
        {
            "id": "615570208",
            "speaker": "乌尔法",
            "text": "什么？你问我船在哪？"
        },
        {
            "id": "615570209",
            "speaker": "乌尔法",
            "text": "初号艇在那边的水底，二号艇在这边的水底…"
        },
        {
            "id": "615570210",
            "speaker": "乌尔法",
            "text": "怎么就是浮不起来呢？"
        }
    ]
}