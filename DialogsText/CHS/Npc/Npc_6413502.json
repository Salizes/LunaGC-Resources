    "dialogues": [
        {
            "id": "641350201",
            "speaker": "Player",
            "text": "「醒醒」？"
        },
        {
            "id": "641350202",
            "speaker": "沙普尔",
            "text": "噢，是客人吗？"
        },
        {
            "id": "641350203",
            "speaker": "沙普尔",
            "text": "「醒醒」是我养的一只猫的名字，我正问它事呢。"
        },
        {
            "id": "641350204",
            "speaker": "沙普尔",
            "text": "不过这家伙最近不知在闹什么脾气，怎么叫都不答应。"
        },
        {
            "id": "641350205",
            "speaker": "沙普尔",
            "text": "算了，不管它，可能又跟欧欧一起鬼混去了。"
        },
        {
            "id": "641350206",
            "speaker": "沙普尔",
            "text": "我还是先叫我女儿给你办入住吧。莎莉，莎莉——在吗？"
        }
    ]
}