{
    "talkId": "4008149",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "左右加": 10,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "400814901",
            "speaker": "左右加",
            "text": "太棒了！你们两位和莱依拉小姐的比赛，明明万分激烈，却没有半点火药味，简直就是友情切磋的典范！",
            "choices": [
                {
                    "id": "400814902",
                    "text": "谢谢！",
                    "response": [
                        {
                            "id": "400814903",
                            "speaker": "派蒙",
                            "text": "嘿嘿，要是莱依拉听见这个评价，肯定会很高兴！"
                        },
                        {
                            "id": "400814904",
                            "speaker": "左右加",
                            "text": "原本我还不知道从哪个角度来描写这种…和主角存在竞争关系，却成为了朋友的人物，现在我完全明白了！"
                        },
                        {
                            "id": "400814905",
                            "speaker": "左右加",
                            "text": "我要再好好思考一下剧情的结构，给主角也加一个这样的朋友！"
                        },
                        {
                            "id": "400814906",
                            "speaker": "Player",
                            "text": "我们的较量也很友好。"
                        },
                        {
                            "id": "400814907",
                            "speaker": "派蒙",
                            "text": "对哦，和左右加小姐对阵的时候，我们的情绪也很轻松，完全没有焦躁啊，更不用说较真了！"
                        },
                        {
                            "id": "400814908",
                            "speaker": "左右加",
                            "text": "这…虽然我知道你们放水了，但用这么平和的态度对待我这个普通人…我都不知道该怎么谢谢你们！"
                        },
                        {
                            "id": "400814909",
                            "speaker": "左右加",
                            "text": "不过，把这种剧情写进小说后，需要修改一下…早早淘汰掉主角的对手还是要严肃一点，不然，给读者的挫败感就强得过头了！"
                        }
                    ]
                },
                {
                    "id": "400814910",
                    "text": "可是神子输了啦。",
                    "response": [
                        {
                            "id": "400814911",
                            "speaker": "派蒙",
                            "text": "对哦，神子输掉了，好可惜！"
                        },
                        {
                            "id": "400814912",
                            "speaker": "左右加",
                            "text": "咦？八重大人难道不是故意输掉的吗？"
                        },
                        {
                            "id": "400814913",
                            "speaker": "左右加",
                            "text": "比起胜负，她更在意的应该是——这个荟萃了众多驯兽师的故事，究竟怎样才能发展得让她满意。"
                        },
                        {
                            "id": "400814914",
                            "speaker": "派蒙",
                            "text": "唔…说得也是呢。"
                        },
                        {
                            "id": "400814915",
                            "speaker": "派蒙",
                            "text": "可是，她自己明明已经说动海妮耶了，再多来两句，应该就能让海妮耶清醒一点了…"
                        },
                        {
                            "id": "400814916",
                            "speaker": "左右加",
                            "text": "大概是因为…八重大人自认为，她在这个故事里的角色设定，并不是和海妮耶距离很近的朋友？所以不可以抢走你们的高光时刻！"
                        },
                        {
                            "id": "400814917",
                            "speaker": "左右加",
                            "text": "而且，就目前的发展来看，说不定八重大人也考虑到了「在这里断章刚刚好」！"
                        },
                        {
                            "id": "400814918",
                            "speaker": "派蒙",
                            "text": "这都是什么高深的作者术语，有点听不懂了啦…"
                        }
                    ]
                },
                {
                    "id": "400814919",
                    "text": "下次再聊…",
                    "response": [
                        {
                            "id": "400814920",
                            "speaker": "左右加",
                            "text": "好！两位请加油，期待你们在决赛中的表现！"
                        }
                    ]
                }
            ]
        }
    ]
}