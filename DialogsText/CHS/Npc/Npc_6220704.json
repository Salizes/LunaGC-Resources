{
    "talkId": "6220704",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "黄衫": 7
    },
    "dialogues": [
        {
            "id": "622070203",
            "speaker": "Player",
            "text": "那个…敢问大名？"
        },
        {
            "id": "622070204",
            "speaker": "黄衫",
            "text": "哈哈，忘了先说名字了。"
        },
        {
            "id": "622070205",
            "speaker": "黄衫",
            "text": "我叫黄衫。"
        },
        {
            "id": "622070206",
            "speaker": "黄衫",
            "text": "璃月蒙德商道我应该还挺有名气的。毕竟干活仔细，有口皆碑嘛。"
        },
        {
            "id": "622070207",
            "speaker": "Player",
            "text": "关于商路传闻…"
        },
        {
            "id": "622070208",
            "speaker": "黄衫",
            "text": "前些日子蒙德闹了龙灾，所以我暂停了一段时间。"
        },
        {
            "id": "622070209",
            "speaker": "黄衫",
            "text": "毕竟我对付山鬼、野兽、贼人有手段，对付龙可不行。"
        },
        {
            "id": "622070210",
            "speaker": "黄衫",
            "text": "说来，这里就是两地传闻的交汇点。听说这里的员工都是七星的情报探子噢。"
        },
        {
            "id": "622070211",
            "speaker": "黄衫",
            "text": "看你一脸严肃，难道你真的信了？哈哈哈。"
        }
    ]
}