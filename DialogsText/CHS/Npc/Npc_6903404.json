{
    "talkId": "6903404",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "诺艾尔": 8
    },
    "dialogues": [
        {
            "id": "690340401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690340402",
            "speaker": "诺艾尔",
            "text": "欸？问我吗…"
        },
        {
            "id": "690340403",
            "speaker": "诺艾尔",
            "text": "我…我想量一量你的身高尺码，为你做一身衣服。",
            "choices": [
                {
                    "id": "690340404",
                    "text": "怎么会突然想到这个？",
                    "response": [
                        {
                            "id": "690340407",
                            "speaker": "诺艾尔",
                            "text": "如果能让你平时穿我做的衣服…"
                        },
                        {
                            "id": "690340408",
                            "speaker": "诺艾尔",
                            "text": "那一定是一件很幸福很幸福的事情…",
                            "choices": [
                                {
                                    "id": "690340409",
                                    "text": "那就要辛苦你了。",
                                    "response": [
                                        {
                                            "id": "690340411",
                                            "speaker": "诺艾尔",
                                            "text": "嗯…嗯…"
                                        },
                                        {
                                            "id": "690340412",
                                            "speaker": "诺艾尔",
                                            "text": "太好了。又要忙碌起来了！"
                                        },
                                        {
                                            "id": "690340413",
                                            "speaker": "诺艾尔",
                                            "text": "不过，这是提瓦特大陆上，最幸福的忙碌了吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690340410",
                                    "text": "到时候…我也会为诺艾尔准备回礼的。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690340405",
                    "text": "诺艾尔连缝纫都会吗？",
                    "response": [
                        {
                            "id": "690340406",
                            "speaker": "诺艾尔",
                            "text": "那，那当然了…毕竟我是「万能女仆」嘛。"
                        }
                    ]
                }
            ]
        }
    ]
}