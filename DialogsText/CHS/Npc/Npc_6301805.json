    "dialogues": [
        {
            "id": "630180501",
            "speaker": "Player",
            "text": "拿来给你…？"
        },
        {
            "id": "630180502",
            "speaker": "松本",
            "text": "对啊，怎么了？"
        },
        {
            "id": "630180503",
            "speaker": "松本",
            "text": "你委托我尝菜，当然是你付钱去买，或者做好给我咯。"
        },
        {
            "id": "630180504",
            "speaker": "松本",
            "text": "我若是花钱购买的话，岂不是太功利了。菜肴的价格会影响评判结果的。"
        },
        {
            "id": "630180505",
            "speaker": "松本",
            "text": "就是因为没有金钱的交易，评价才更公正。"
        }
