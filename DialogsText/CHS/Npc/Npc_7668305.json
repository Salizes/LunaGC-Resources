{
    "talkId": "7668305",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "科赫": 8
    },
    "dialogues": [
        {
            "id": "766830501",
            "speaker": "科赫",
            "text": "荣誉骑士，枪匠科赫向你问好！祝你测距精准，打出理想的弹道。",
            "choices": [
                {
                    "id": "766830507",
                    "text": "关于「观测榴弹」的其他原理…",
                    "response": [
                        {
                            "id": "766830508",
                            "speaker": "科赫",
                            "text": "猜你想问：榴弹的变向机制。"
                        },
                        {
                            "id": "766830509",
                            "speaker": "科赫",
                            "text": "哈哈，其实原理也不难，榴弹本体采用的无烟火药能量较低，速度并不夸张。"
                        },
                        {
                            "id": "766830510",
                            "speaker": "科赫",
                            "text": "配合观测机关周围的黏着装置，就能实现命中后附着在目标上，然后点燃后部侧面的示踪剂，发出命中信号。"
                        },
                        {
                            "id": "766830511",
                            "speaker": "科赫",
                            "text": "弹头里余下的空间，都用来装填变向用的火药了，远程控制它指向想要的目标后，就可以点燃这些发射药，飞向下一个目标。"
                        },
                        {
                            "id": "766830512",
                            "speaker": "科赫",
                            "text": "因此，在推演中，「观测榴弹」就能进行次数有限的变向。"
                        },
                        {
                            "id": "766830513",
                            "speaker": "科赫",
                            "text": "这完全符合推演的主题——「用有限的射击次数，打出最完美的弹道。」"
                        }
                    ]
                },
                {
                    "id": "766830514",
                    "text": "待会儿再来和你聊。",
                    "response": [
                        {
                            "id": "766830515",
                            "speaker": "科赫",
                            "text": "了解，我随时在此待命。"
                        }
                    ]
                }
            ]
        }
    ]
}