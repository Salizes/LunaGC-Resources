{
    "talkId": "7665503",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "菲林斯": 9
    },
    "dialogues": [
        {
            "id": "766550301",
            "speaker": "菲林斯",
            "text": "又写完三份报告，我需要出来喘口气。"
        },
        {
            "id": "766550302",
            "speaker": "菲林斯",
            "text": "#{NICKNAME}…你在冒险家协会需要写报告吗？",
            "choices": [
                {
                    "id": "766550303",
                    "text": "不常写。",
                    "response": [
                        {
                            "id": "766550304",
                            "speaker": "菲林斯",
                            "text": "这是一种幸运，请务必珍惜。"
                        },
                        {
                            "id": "766550307",
                            "speaker": "菲林斯",
                            "text": "直到今天我也没法适应永远写不完的报告，从前的挪德卡莱没有报告这种东西。"
                        },
                        {
                            "id": "766550308",
                            "speaker": "菲林斯",
                            "text": "我能理解报告的必要性，但是一遍又一遍详细描述那些一句话就能概括的事，实在是耗神。"
                        },
                        {
                            "id": "766550309",
                            "speaker": "菲林斯",
                            "text": "一想到还有好几份报告等着我回去写完…"
                        },
                        {
                            "id": "766550310",
                            "speaker": "菲林斯",
                            "text": "不，想一想报告的必要性，执灯士总是要写报告的。"
                        },
                        {
                            "id": "766550311",
                            "speaker": "菲林斯",
                            "text": "我就在这里待一会儿，就一会儿。"
                        }
                    ]
                },
                {
                    "id": "766550305",
                    "text": "每天写。",
                    "response": [
                        {
                            "id": "766550306",
                            "speaker": "菲林斯",
                            "text": "看来你的运气也不太好，就和我一样。"
                        }
                    ]
                }
            ]
        }
    ]
}