{
    "talkId": "7667722",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 1,
        "法尔伽": 4,
        "温弗里德": 1,
        "艾克贝特": 1,
        "莱夫赫姆": 1
    },
    "dialogues": [
        {
            "id": "766772201",
            "speaker": "Player",
            "text": "法尔伽，你们这是在？"
        },
        {
            "id": "766772202",
            "speaker": "法尔伽",
            "text": "哦，这是骑士团里的队列训练。他们三个昨晚有点喝高了，我在给他们醒酒。"
        },
        {
            "id": "766772203",
            "speaker": "法尔伽",
            "text": "…顺便找出醉得最厉害的，罚跑二十圈。虽然远征军没有禁酒，但什么时候喝、每次喝多少也都是有规矩的。"
        },
        {
            "id": "766772204",
            "speaker": "温弗里德",
            "text": "我…我只喝了一点点！"
        },
        {
            "id": "766772205",
            "speaker": "艾克贝特",
            "text": "我…我也是！"
        },
        {
            "id": "766772206",
            "speaker": "法尔伽",
            "text": "…与其用言语，不如用行动来证明吧！ 给我拿出就算喝醉了也能完美应付的气势来！"
        },
        {
            "id": "766772207",
            "speaker": "莱夫赫姆",
            "text": "是…是！"
        },
        {
            "id": "766772401",
            "speaker": "法尔伽",
            "text": "…荣誉骑士，能请你来整肃他们吗？只要<color=#00E1FFFF>一边喊口号，一边找出里面犯错最多的人</color>就行。"
        }
    ]
}