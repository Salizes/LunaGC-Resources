{
    "talkId": "6909211",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "嘉明": 15
    },
    "dialogues": [
        {
            "id": "690920401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690920402",
            "speaker": "嘉明",
            "text": "好久没上桩舞兽了，有点坐不住了！准备去找些木头回来打磨一下，自己做些简易的梅花桩。"
        },
        {
            "id": "690920403",
            "speaker": "嘉明",
            "text": "想在周围找找，但问一下你先，你这里有没有种着什么发财树和富贵竹之类的植物呀？"
        },
        {
            "id": "690920404",
            "speaker": "嘉明",
            "text": "有的话我标记下位置，避开一点，不然不小心刮花它们就无谓啦…",
            "choices": [
                {
                    "id": "690920405",
                    "text": "发财树和富贵竹长什么样？",
                    "response": [
                        {
                            "id": "690920406",
                            "speaker": "嘉明",
                            "text": "不知道喔。虽然我帮不少做生意的老板运过，但品种好像都不是同一个。"
                        },
                        {
                            "id": "690920407",
                            "speaker": "嘉明",
                            "text": "哇，你都不知道啊，要将那棵树从山里运到城里，山长水远的，中途不能随意修剪啦、不能随便淋水啦…"
                        },
                        {
                            "id": "690920408",
                            "speaker": "嘉明",
                            "text": "好多讲究的，跑那一趟真是累死我了，比跟十个贼打架还累…"
                        },
                        {
                            "id": "690920413",
                            "speaker": "嘉明",
                            "text": "好啦，玩笑话这里讲完这里散，我不是做生意的料啦，但就算我不理解还是会做好我的本职工作的！"
                        },
                        {
                            "id": "690920414",
                            "speaker": "嘉明",
                            "text": "说几点钟淋水我就不会晚一分钟让它们淋到，说晒多久太阳我就不会让它们少晒一秒。"
                        },
                        {
                            "id": "690920415",
                            "speaker": "Player",
                            "text": "这明明挺会做生意嘛。"
                        },
                        {
                            "id": "690920416",
                            "speaker": "嘉明",
                            "text": "哈哈，别跟我讲笑啦，哪里是做生意，这是做人做事的基本而已。"
                        },
                        {
                            "id": "690920417",
                            "speaker": "嘉明",
                            "text": "尊重别人，答应别人的事就要做到。你明明也是这样的喔，说到做到，牙齿当金使。"
                        },
                        {
                            "id": "690920418",
                            "speaker": "嘉明",
                            "text": "更何况这是工作，丢了这个饭碗我就没钱继续研究舞兽戏咯。"
                        },
                        {
                            "id": "690920419",
                            "speaker": "嘉明",
                            "text": "所以能邀请你陪我一齐去采点木桩子回来吗？报酬是舞一段「瑞兽大战发财树」给你看？"
                        },
                        {
                            "id": "690920420",
                            "speaker": "Player",
                            "text": "早讲嘛！快点快点我想看！"
                        }
                    ]
                },
                {
                    "id": "690920409",
                    "text": "嘉明相信这些能招财吗？",
                    "response": [
                        {
                            "id": "690920410",
                            "speaker": "嘉明",
                            "text": "你问我吗？听说这些树很贵一棵的，还没发财前就要破一次财先，我肯定舍不得啦！"
                        },
                        {
                            "id": "690920411",
                            "speaker": "嘉明",
                            "text": "记得我家也养了一棵发财树，我老爸天天早上起来都要去看看它的。"
                        },
                        {
                            "id": "690920412",
                            "speaker": "嘉明",
                            "text": "我倒觉得靠它们发财还不如靠发梦快…呃，这句话被我老爸听到肯定要请我吃「藤条焖猪肉」了哈哈！"
                        }
                    ]
                }
            ]
        }
    ]
}