    "dialogues": [
        {
            "id": "621400203",
            "speaker": "Player",
            "text": "关于群玉阁。"
        },
        {
            "id": "621400204",
            "speaker": "百晓",
            "text": "群玉阁是由凝光大人坐镇的情报决策机关。"
        },
        {
            "id": "621400205",
            "speaker": "百晓",
            "text": "此处悉察整个璃月的大小事务。各路信息无论巨细，逃不过我们的耳目。"
        },
        {
            "id": "621400206",
            "speaker": "百晓",
            "text": "除此之外，恕无可奉告。"
        }
    ]
}