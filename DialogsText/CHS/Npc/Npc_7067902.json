{
    "talkId": "7067902",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "吉盖克斯": 12
    },
    "dialogues": [
        {
            "id": "706790201",
            "speaker": "吉盖克斯",
            "text": "您好啊，是来试玩「风行迷踪」的吗？",
            "choices": [
                {
                    "id": "706790202",
                    "text": "想要玩玩。",
                    "response": [
                        {
                            "id": "706790203",
                            "speaker": "吉盖克斯",
                            "text": "好！您来这边…"
                        }
                    ]
                },
                {
                    "id": "706790204",
                    "text": "关于「风行迷踪」的新规则…",
                    "response": [
                        {
                            "id": "706790205",
                            "speaker": "吉盖克斯",
                            "text": "喔！让我给您介绍一下。我可是在里面加入了很多全新的设计！"
                        },
                        {
                            "id": "706790206",
                            "speaker": "吉盖克斯",
                            "text": "在这副全新的「风行迷踪」里，我首次加入了名为「发信机」的东西。"
                        },
                        {
                            "id": "706790207",
                            "speaker": "吉盖克斯",
                            "text": "游侠只要成功启动四个「发信机」，就可以击败猎手，获得胜利！"
                        },
                        {
                            "id": "706790208",
                            "speaker": "吉盖克斯",
                            "text": "而猎手要做的事嘛…还是不变，只要把所有游侠抓住，就算他们赢。"
                        },
                        {
                            "id": "706790209",
                            "speaker": "吉盖克斯",
                            "text": "但在这次的「风行迷踪」里，游侠被猎手抓住后，不会直接出局，而是会被投入一个叫做「监控地」的地方。"
                        },
                        {
                            "id": "706790210",
                            "speaker": "吉盖克斯",
                            "text": "只要过段时间，或者是有其他游侠帮忙，被抓住的人就可以从「监控地」逃脱，继续和猎手周旋啦。"
                        },
                        {
                            "id": "706790211",
                            "speaker": "吉盖克斯",
                            "text": "不过，如果被抓住过的人再次被抓住…那就不得不被判出局啦。"
                        },
                        {
                            "id": "706790212",
                            "speaker": "吉盖克斯",
                            "text": "您别觉得这规则复杂。只要多玩几次，很容易就能掌握。"
                        },
                        {
                            "id": "706790213",
                            "speaker": "吉盖克斯",
                            "text": "来吧！试试这一副全新的「风行迷踪」！"
                        }
                    ]
                },
                {
                    "id": "706790214",
                    "text": "还有别的事。",
                    "response": [
                        {
                            "id": "706790215",
                            "speaker": "吉盖克斯",
                            "text": "没事，您有空的时候再来也行，我还会在这待一段时间。"
                        }
                    ]
                }
            ]
        }
    ]
}