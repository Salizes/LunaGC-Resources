{
    "talkId": "7480001",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 10,
        "吉雅罗": 17,
        "派蒙": 4
    },
    "dialogues": [
        {
            "id": "748000101",
            "speaker": "吉雅罗",
            "text": "应该不会…应该不会…"
        },
        {
            "id": "748000102",
            "speaker": "Player",
            "text": "你在干什么？"
        },
        {
            "id": "748000103",
            "speaker": "吉雅罗",
            "text": "啊！别！我什么也没干，别伤害我！"
        },
        {
            "id": "748000104",
            "speaker": "派蒙",
            "text": "你在说什么呢。我们为什么要伤害你呀？"
        },
        {
            "id": "748000105",
            "speaker": "吉雅罗",
            "text": "我不知道！但我也不知道你们不会伤害我。",
            "choices": [
                {
                    "id": "748000106",
                    "text": "什么乱七八糟的…",
                    "response": [
                        {
                            "id": "748000108",
                            "speaker": "吉雅罗",
                            "text": "对了…对了！一定是因为我发现了你们的秘密，对吧？"
                        },
                        {
                            "id": "748000109",
                            "speaker": "吉雅罗",
                            "text": "是…是我在咖啡馆里拿走了夹着你们密信的报纸？"
                        },
                        {
                            "id": "748000110",
                            "speaker": "吉雅罗",
                            "text": "还是我不小心看见了你们接头的密语？等等，难道是我昨晚上吃的那一条鱼…"
                        },
                        {
                            "id": "748000111",
                            "speaker": "吉雅罗",
                            "text": "我就说那条鱼为什么刺那么少，是你们把那条鱼身上的刺给剔下来的！"
                        },
                        {
                            "id": "748000112",
                            "speaker": "吉雅罗",
                            "text": "对，对，你们想用鱼骨两侧不同的鱼刺数量传递消息…但这条鱼却阴差阳错被我买回了家…"
                        },
                        {
                            "id": "748000113",
                            "speaker": "派蒙",
                            "text": "这家伙，到底在说什么呀？完全听不明白…",
                            "choices": [
                                {
                                    "id": "748000114",
                                    "text": "我不会伤害你的。",
                                    "response": [
                                        {
                                            "id": "748000116",
                                            "speaker": "吉雅罗",
                                            "text": "你们、你们真不是来害我的？"
                                        },
                                        {
                                            "id": "748000117",
                                            "speaker": "派蒙",
                                            "text": "你这个人！我们才第一次见到你，为什么要害你呀？"
                                        },
                                        {
                                            "id": "748000118",
                                            "speaker": "吉雅罗",
                                            "text": "是吗？那、那就好…真是抱歉，不好意思…"
                                        },
                                        {
                                            "id": "748000119",
                                            "speaker": "吉雅罗",
                                            "text": "我最近一直在琢磨一篇侦探小说，但一直不知道让里面的犯人用什么手法作案比较巧妙。"
                                        },
                                        {
                                            "id": "748000120",
                                            "speaker": "吉雅罗",
                                            "text": "因为我想得太多，所以…现在看见任何东西，第一反应就是如何用它来…作案。"
                                        },
                                        {
                                            "id": "748000121",
                                            "speaker": "吉雅罗",
                                            "text": "唉，所以我才…这么紧张，真是不好意思。用人家的话来说，我简直有「被害妄想」了。"
                                        },
                                        {
                                            "id": "748000122",
                                            "speaker": "吉雅罗",
                                            "text": "我刚才准备坐巡轨船去城里喝杯咖啡，但当我看见巡轨船运行的样子…"
                                        },
                                        {
                                            "id": "748000123",
                                            "speaker": "吉雅罗",
                                            "text": "我、我脑子里一瞬间就浮现了无数种我在巡轨船上被害的样子，根本不敢上船。",
                                            "choices": [
                                                {
                                                    "id": "748000124",
                                                    "text": "你自己都说是「妄想」了。",
                                                    "response": [
                                                        {
                                                            "id": "748000126",
                                                            "speaker": "吉雅罗",
                                                            "text": "话是这么说没错。但我就是忍不住想个没完，越想就越害怕…",
                                                            "choices": [
                                                                {
                                                                    "id": "748000127",
                                                                    "text": "我陪你去吧…",
                                                                    "response": [
                                                                        {
                                                                            "id": "748000129",
                                                                            "speaker": "吉雅罗",
                                                                            "text": "真的？！太好了，但是…如果那个想要害我的人，连你一起害了呢？"
                                                                        },
                                                                        {
                                                                            "id": "748000130",
                                                                            "speaker": "Player",
                                                                            "text": "你就放心吧…"
                                                                        },
                                                                        {
                                                                            "id": "748000131",
                                                                            "speaker": "派蒙",
                                                                            "text": "#走啦走啦，别想那么多。无论任何问题，{NICKNAME}都会轻松解决掉的。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "748000128",
                                                                    "text": "我来护送你。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "748000125",
                                                    "text": "怎么可能，别想太多了。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "748000115",
                                    "text": "别妄想这些乱七八糟的。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "748000107",
                    "text": "你在说什么呢？"
                }
            ]
        }
    ]
}