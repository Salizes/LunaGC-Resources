    "dialogues": [
        {
            "id": "630070301",
            "speaker": "Player",
            "text": "听说你是大人物？"
        },
        {
            "id": "630070302",
            "speaker": "冈崎陆斗",
            "text": "嗯？你听谁说的？"
        },
        {
            "id": "630070303",
            "speaker": "冈崎陆斗",
            "text": "哈哈，一定又是绘里香在夸我了。"
        },
        {
            "id": "630070304",
            "speaker": "冈崎陆斗",
            "text": "实不相瞒，当年我在天领奉行的名望甚高。即便现在隐退，也有不少与力、同心来找我商谈事宜。"
        },
        {
            "id": "630070305",
            "speaker": "冈崎陆斗",
            "text": "最近偶尔就连常常出入奉行府的大人物也会屈尊莅临本店…看来当下的稻妻确实暗流涌动啊…"
        }
    ]
}