    "dialogues": [
        {
            "id": "640750201",
            "speaker": "Player",
            "text": "你很难受？"
        },
        {
            "id": "640750202",
            "speaker": "贾瓦德",
            "text": "确实难受，但已经习惯了。"
        },
        {
            "id": "640750203",
            "speaker": "贾瓦德",
            "text": "我这个病啊，连最好的医生看了也摇头，我是不抱什么希望咯。"
        },
        {
            "id": "640750204",
            "speaker": "贾瓦德",
            "text": "与其唉声叹气，活得畏畏缩缩，我觉得还是及时行乐比较值得。"
        }
    ]
