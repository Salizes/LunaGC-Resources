{
    "talkId": "6762101",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 4,
        "别蕾娜": 18
    },
    "dialogues": [
        {
            "id": "676210101",
            "speaker": "别蕾娜",
            "text": "要用美味的面包，让大家打起精神来…",
            "choices": [
                {
                    "id": "676210102",
                    "text": "关于新食谱…",
                    "response": [
                        {
                            "id": "676210103",
                            "speaker": "别蕾娜",
                            "text": "啊，是说「蘑幻之菇」吗？呵呵，大受好评哦。"
                        },
                        {
                            "id": "676210104",
                            "speaker": "别蕾娜",
                            "text": "大家都很喜欢，说很久没尝过这么温暖的味道了。就连马鲁什金先生和格维妲小姐看起来也稍稍轻松了一些…嗯，应该吧？"
                        },
                        {
                            "id": "676210105",
                            "speaker": "别蕾娜",
                            "text": "多亏了你帮忙，我才能顺利做出来，真的很谢谢你！"
                        },
                        {
                            "id": "676210106",
                            "speaker": "别蕾娜",
                            "text": "最近我在想，如果能用甜甜的日落果和枫丹的泡泡桔做出好吃的果酱，作为替代蘑菇的夹心，会不会更好吃呢？"
                        },
                        {
                            "id": "676210107",
                            "speaker": "别蕾娜",
                            "text": "不过也只是想想啦。要是真的把摩拉花在泡泡桔这种不重要的东西上，格维妲小姐应该会气得比日落果还红吧…"
                        }
                    ]
                },
                {
                    "id": "676210108",
                    "text": "说起来，你为什么会成为执灯士？",
                    "response": [
                        {
                            "id": "676210109",
                            "speaker": "别蕾娜",
                            "text": "嗯…说起来可能有些长喔？"
                        },
                        {
                            "id": "676210110",
                            "speaker": "别蕾娜",
                            "text": "我很小的时候，爸爸妈妈就不在了。为了保护躲起来的我，被狂猎杀害了。"
                        },
                        {
                            "id": "676210111",
                            "speaker": "别蕾娜",
                            "text": "本来，我也应该死在那里的…那些怪物虽然没有脑袋，「嗅觉」却很灵敏呢，就算我拼命没有发出声音，它们还是找到了我。"
                        },
                        {
                            "id": "676210112",
                            "speaker": "别蕾娜",
                            "text": "就在那时，西格德先生救了我…啊，西格德先生是一位非常非常厉害的执灯士，虽然…他也已经不在了。"
                        },
                        {
                            "id": "676210113",
                            "speaker": "别蕾娜",
                            "text": "他把无处可去的我带回了皮拉米达城。那时的皮拉米达城和现在热热闹闹的样子不一样，整座城塞里都没有几个人…"
                        },
                        {
                            "id": "676210114",
                            "speaker": "别蕾娜",
                            "text": "所以——我其实没有经历过后面那样严格的考核喔，只是因为那个时候，这里已经没有可以工作的人了，只要申请就可以加入。"
                        },
                        {
                            "id": "676210115",
                            "speaker": "别蕾娜",
                            "text": "而我…我也希望能成为像西格德先生那样，能为大家带去温暖的人。"
                        },
                        {
                            "id": "676210116",
                            "speaker": "别蕾娜",
                            "text": "我做不到像大家那样战斗，但至少…我希望大家能露出更轻松的笑容。"
                        },
                        {
                            "id": "676210117",
                            "speaker": "别蕾娜",
                            "text": "即便是在黑暗中守望光明的人，听到开心的事也会笑，吃到美味的食物也会感到幸福…我是这样想的喔。"
                        }
                    ]
                },
                {
                    "id": "676210118",
                    "text": "还需要帮忙吗？",
                    "response": [
                        {
                            "id": "676210119",
                            "speaker": "别蕾娜",
                            "text": "呵呵，谢谢你的关心。这附近已经变得安全了，采麦子这种事就不用再麻烦你帮忙啦。"
                        },
                        {
                            "id": "676210120",
                            "speaker": "别蕾娜",
                            "text": "不过，有像你这样可靠的人在，真的非常安心呢。"
                        }
                    ]
                },
                {
                    "id": "676210121",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "676210122",
                            "speaker": "别蕾娜",
                            "text": "嗯嗯，路上小心，要记得好好吃饭哦。"
                        }
                    ]
                }
            ]
        }
    ]
}