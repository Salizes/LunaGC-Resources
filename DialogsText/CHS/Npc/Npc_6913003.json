{
    "talkId": "6913003",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 4,
        "莉奈娅": 17
    },
    "dialogues": [
        {
            "id": "691300301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691300302",
            "speaker": "莉奈娅",
            "text": "好呀，你最近的冒险有什么收获吗？",
            "choices": [
                {
                    "id": "691300303",
                    "text": "又找到一些宝箱…",
                    "response": [
                        {
                            "id": "691300304",
                            "speaker": "莉奈娅",
                            "text": "哦！那真是太好了，对我们冒险家来说，宝箱也是重要的收入来源呢。"
                        },
                        {
                            "id": "691300305",
                            "speaker": "莉奈娅",
                            "text": "像我，要是光靠给冒险家协会当顾问的收入，不知道要攒到什么时候才能买一艘属于自己的科考船…"
                        },
                        {
                            "id": "691300306",
                            "speaker": "莉奈娅",
                            "text": "而且，开宝箱的时候也得小心里面的东西不要被露米给吞掉了。"
                        },
                        {
                            "id": "691300307",
                            "speaker": "莉奈娅",
                            "text": "它这个看到亮晶晶的东西就想吞下去的毛病也不知道是怎么养成的…"
                        },
                        {
                            "id": "691300308",
                            "speaker": "莉奈娅",
                            "text": "说起来，有个关于固晶甲虫的传说，说的是它们最初背负起水晶般的固态燃素就是为了妆点自己。"
                        },
                        {
                            "id": "691300309",
                            "speaker": "莉奈娅",
                            "text": "也许露米吞下这些亮晶晶的东西也不单单是因为贪吃…"
                        },
                        {
                            "id": "691300310",
                            "speaker": "莉奈娅",
                            "text": "而是收集起来，为了有机会装饰自己，让同族的霜精认可、接纳它…"
                        },
                        {
                            "id": "691300311",
                            "speaker": "莉奈娅",
                            "text": "…下次还是多喂它一些好了！不过是一些矿石嘛，只要多开几个宝箱，总会找到更多的。"
                        }
                    ]
                },
                {
                    "id": "691300312",
                    "text": "又探索了一些遗迹…",
                    "response": [
                        {
                            "id": "691300313",
                            "speaker": "莉奈娅",
                            "text": "那些鲜有人踏足的遗迹往往会形成独特的生态呢，真令人着迷！"
                        },
                        {
                            "id": "691300314",
                            "speaker": "莉奈娅",
                            "text": "不过里面的机关和怪物就没那么迷人了…"
                        },
                        {
                            "id": "691300315",
                            "speaker": "莉奈娅",
                            "text": "像是元能构装体或者秘源机兵之类的倒还好，发条机关…光是想到都觉得脊背发凉。"
                        },
                        {
                            "id": "691300316",
                            "speaker": "莉奈娅",
                            "text": "枫丹科学院真是个可怕的地方…居然造出那么多形态功能各异的发条机关。"
                        },
                        {
                            "id": "691300317",
                            "speaker": "莉奈娅",
                            "text": "不过歌裴莉娅和科培琉司的舞蹈的确很吸引人，一点也不输剧院里的演出，虽然我是远远地看啦。"
                        },
                        {
                            "id": "691300318",
                            "speaker": "Player",
                            "text": "冰风组曲和重拳出击鸭你喜欢哪个？"
                        },
                        {
                            "id": "691300319",
                            "speaker": "莉奈娅",
                            "text": "当然是重拳出击鸭咯！造型就更可爱，还能简单对话，硬要说的话，也不是完全没有实用价值。"
                        },
                        {
                            "id": "691300320",
                            "speaker": "莉奈娅",
                            "text": "最重要的是，那是爱诺的发明…"
                        },
                        {
                            "id": "691300321",
                            "speaker": "莉奈娅",
                            "text": "你笑什么？好啦，我就是会偏心朋友嘛。"
                        }
                    ]
                }
            ]
        }
    ]
}