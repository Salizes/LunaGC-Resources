    "dialogues": [
        {
            "id": "670110601",
            "speaker": "Player",
            "text": "关于委托方…"
        },
        {
            "id": "670110602",
            "speaker": "克鲁切",
            "text": "我代表愚人众一方来与你签订短期的合同，期间所有的事务都由我与你对接。"
        },
        {
            "id": "670110603",
            "speaker": "克鲁切",
            "text": "合同效力对于双方的约束仅在委托存续期内有效，并且不会影响你除此委托以外的其他事务。"
        }
    ]
}