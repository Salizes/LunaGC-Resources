{
    "talkId": "7650902",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "埃德勒": 15
    },
    "dialogues": [
        {
            "id": "765090201",
            "speaker": "埃德勒",
            "text": "好巧，能在挪德卡莱遇见您…一段时间没见，准领队您的指挥作战能力似乎又上了一个台阶！",
            "choices": [
                {
                    "id": "765090202",
                    "text": "是兵棋推演的功劳！",
                    "response": [
                        {
                            "id": "765090203",
                            "speaker": "埃德勒",
                            "text": "您真是谦虚了，自从我从执律庭拿来了标准版的兵棋推演之后，我就每天琢磨怎么改得更复杂一些…"
                        },
                        {
                            "id": "765090204",
                            "speaker": "埃德勒",
                            "text": "格罗里夏尔队长和我说过——「有些人天生作战就像狼，不只牙口好，还知道怎么轻松咬到猎物的后脖颈」。"
                        },
                        {
                            "id": "765090205",
                            "speaker": "埃德勒",
                            "text": "准领队您就是那只善战的狼！改良版的兵棋推演，似乎还不能让您发挥出全力——您天生就知道怎么做。"
                        },
                        {
                            "id": "765090206",
                            "speaker": "埃德勒",
                            "text": "唉…但我看维斯菈娃玩起来都有些摸不着头脑，还以为这次改得算是十全十美了呢！",
                            "choices": [
                                {
                                    "id": "765090207",
                                    "text": "所以她是你正在追捕的嫌疑人？",
                                    "response": [
                                        {
                                            "id": "765090209",
                                            "speaker": "埃德勒",
                                            "text": "啊呀…这是一个意外，我要抓的人和她没半摩拉关系。"
                                        },
                                        {
                                            "id": "765090210",
                                            "speaker": "埃德勒",
                                            "text": "我和她在枫丹遇见过，有些过节…我把她当成了绑匪，当场就制伏了她，但这是一个误会。"
                                        },
                                        {
                                            "id": "765090211",
                                            "speaker": "埃德勒",
                                            "text": "她救了那个小女孩——但这也不怪我，一个长得很高的外地人，穿着本地的服装，手里拿着铳枪，出现在了荒郊野外…"
                                        },
                                        {
                                            "id": "765090212",
                                            "speaker": "埃德勒",
                                            "text": "咳，总之，最后误会解开了，但她看起来还是太危险…呃，太可疑了。"
                                        },
                                        {
                                            "id": "765090213",
                                            "speaker": "埃德勒",
                                            "text": "所以出于安全的角度考虑，我只说我是一个路见不平的「热心商人」，但这也没什么，毕竟她也肯定不是什么保镖就是了…"
                                        },
                                        {
                                            "id": "765090214",
                                            "speaker": "埃德勒",
                                            "text": "现在一看，她的身份更是不简单。"
                                        },
                                        {
                                            "id": "765090215",
                                            "speaker": "Player",
                                            "text": "哇，精彩的博弈。"
                                        },
                                        {
                                            "id": "765090216",
                                            "speaker": "埃德勒",
                                            "text": "运气这东西真难说，如今，「热心保镖」拦住了「可疑商人」…"
                                        },
                                        {
                                            "id": "765090217",
                                            "speaker": "埃德勒",
                                            "text": "谁知道呢！好在比起搞清我的身份和来意，和我打一架似乎对她来说更重要，这也算现在为数不多的好事吧！"
                                        }
                                    ]
                                },
                                {
                                    "id": "765090208",
                                    "text": "「热心商人」追捕「热心保镖」？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "765090221",
                    "text": "其实我还有些地方没玩明白…",
                    "response": [
                        {
                            "id": "765090218",
                            "speaker": "埃德勒",
                            "text": "不必着急，战场上的局势千变万化，棋局上的也是，没有人可以准确预料到其中的每一个变化。"
                        }
                    ]
                },
                {
                    "id": "765090222",
                    "text": "借你吉言，我要去大杀四方了。",
                    "response": [
                        {
                            "id": "765090220",
                            "speaker": "埃德勒",
                            "text": "那不打扰您了！去尽情享受兵棋推演的乐趣吧！"
                        }
                    ]
                }
            ]
        }
    ]
}