{
    "talkId": "6903808",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "阿贝多": 14
    },
    "dialogues": [
        {
            "id": "690380801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690380402",
            "speaker": "阿贝多",
            "text": "嗯，细说的话有不少。"
        },
        {
            "id": "690380403",
            "speaker": "阿贝多",
            "text": "有你的陪伴，灵感总是源源不断。",
            "choices": [
                {
                    "id": "690380404",
                    "text": "是指画画吗？",
                    "response": [
                        {
                            "id": "690380406",
                            "speaker": "阿贝多",
                            "text": "不管是画画也好，还是实验也好。"
                        },
                        {
                            "id": "690380407",
                            "speaker": "阿贝多",
                            "text": "除开这些之外，还有很多。"
                        },
                        {
                            "id": "690380408",
                            "speaker": "阿贝多",
                            "text": "说来…以前我时常觉得，人际交往很浪费时间。"
                        },
                        {
                            "id": "690380409",
                            "speaker": "阿贝多",
                            "text": "但在遇见你之后，比起其他事项，我更愿意把时间花在你身上。"
                        },
                        {
                            "id": "690380410",
                            "speaker": "阿贝多",
                            "text": "这是一种很独特的现象，我想我大概能理解它的原因。"
                        },
                        {
                            "id": "690380411",
                            "speaker": "阿贝多",
                            "text": "所以，你也可以多给我一些…你的时间吗？",
                            "choices": [
                                {
                                    "id": "690380412",
                                    "text": "那就陪你去写生吧。",
                                    "response": [
                                        {
                                            "id": "690380413",
                                            "speaker": "阿贝多",
                                            "text": "谢谢。那今天的题材——"
                                        },
                                        {
                                            "id": "690380414",
                                            "speaker": "阿贝多",
                                            "text": "就画「你与洞天」吧。"
                                        },
                                        {
                                            "id": "690380418",
                                            "speaker": "阿贝多",
                                            "text": "另外，结束之后，我能有幸邀请你一起去吃个甜点吗？"
                                        },
                                        {
                                            "id": "690380419",
                                            "speaker": "阿贝多",
                                            "text": "作为意义的延续，还有对你陪伴的感谢。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690380415",
                                    "text": "那就陪你做实验吧。",
                                    "response": [
                                        {
                                            "id": "690380416",
                                            "speaker": "阿贝多",
                                            "text": "谢谢。我会确保好你的安全，就像往常一样。"
                                        },
                                        {
                                            "id": "690380417",
                                            "speaker": "阿贝多",
                                            "text": "我们已经很默契了，不是吗？"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690380405",
                    "text": "是指实验吗？"
                }
            ]
        }
    ]
}