    "dialogues": [
        {
            "id": "652620201",
            "speaker": "Player",
            "text": "关于「拳力斗技」…"
        },
        {
            "id": "652620202",
            "speaker": "罗西莫夫",
            "text": "是非常健康的运动！"
        },
        {
            "id": "652620203",
            "speaker": "罗西莫夫",
            "text": "要我说，当主持真是吃亏！虽然能在最佳位置观赛，但我想要的是观赛吗？"
        },
        {
            "id": "652620204",
            "speaker": "罗西莫夫",
            "text": "我也想要上场，想站在圆形赛场上，和对手来一场硬碰硬的较量！"
        },
        {
            "id": "652620205",
            "speaker": "罗西莫夫",
            "text": "这么说来好像是少了一点观赏性，徒手格斗的观赏性毕竟上限太低了。得想点其他的限制条件…"
        }
    ]
}