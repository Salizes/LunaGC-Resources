{
    "talkId": "7505401",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "瓦达娜": 7
    },
    "dialogues": [
        {
            "id": "750540101",
            "speaker": "瓦达娜",
            "text": "「我没有必须达成的目标，也没有迫切的渴望，我是个快乐的牧民，我只关心绵驮兽，关心日月花草、清风雨露…」",
            "choices": [
                {
                    "id": "750540102",
                    "text": "关于「半熟蛋」…",
                    "response": [
                        {
                            "id": "750540103",
                            "speaker": "瓦达娜",
                            "text": "多亏了它这么有责任心，我才能过上现在的生活呢。说起它的名字，其实原本想给它起个普通点的名字…"
                        },
                        {
                            "id": "750540104",
                            "speaker": "瓦达娜",
                            "text": "那时因为和须弥来的厨子交上了朋友，尝过很多创意料理之后就想到要用食物的名字来命名。"
                        },
                        {
                            "id": "750540105",
                            "speaker": "瓦达娜",
                            "text": "外表看起来凶凶的，但其实很贴心，有时又会因为草率犯些无伤大雅的小错，嗯，叫它「半熟蛋」正合适！"
                        }
                    ]
                },
                {
                    "id": "750540106",
                    "text": "关于绵驮兽…",
                    "response": [
                        {
                            "id": "750540107",
                            "speaker": "瓦达娜",
                            "text": "毛乎乎的，真的很可爱！有时真想枕着它们睡午觉，那感觉，肯定跟睡在云端上一样吧？"
                        },
                        {
                            "id": "750540108",
                            "speaker": "瓦达娜",
                            "text": "嗯…也许可以用它们的毛来做一个枕头或者垫子…"
                        }
                    ]
                },
                {
                    "id": "750540109",
                    "text": "不打扰了。",
                    "response": [
                        {
                            "id": "750540110",
                            "speaker": "瓦达娜",
                            "text": "祝你度过平静快乐的一天！"
                        }
                    ]
                }
            ]
        }
    ]
}