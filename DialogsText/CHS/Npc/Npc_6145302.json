    "dialogues": [
        {
            "id": "4015145302",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "4015145306",
            "speaker": "苏西",
            "text": "我跟你一样，都是受到风神巴巴托斯护佑的人。"
        },
        {
            "id": "4015145307",
            "speaker": "苏西",
            "text": "我们都应该为这和风与温暖向巴巴托斯献上感谢，不是吗？"
        },
        {
            "id": "4015145303",
            "speaker": "Player",
            "text": "蒙德的风？"
        },
        {
            "id": "4015145308",
            "speaker": "苏西",
            "text": "蒙德，是受到风神巴巴托斯护佑的城市。"
        },
        {
            "id": "4015145309",
            "speaker": "苏西",
            "text": "这吹过蒙德的和风，就是巴巴托斯对蒙德人民的祝福哦。"
        }
    ]
