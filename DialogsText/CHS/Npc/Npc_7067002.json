{
    "talkId": "7067002",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "吉盖克斯": 16
    },
    "dialogues": [
        {
            "id": "706700201",
            "speaker": "吉盖克斯",
            "text": "欸，有兴趣来试玩一下「风行迷踪」吗？",
            "choices": [
                {
                    "id": "706700202",
                    "text": "游玩「风行迷踪」。"
                },
                {
                    "id": "706700203",
                    "text": "你还在招募人来试玩啊…",
                    "response": [
                        {
                            "id": "706700204",
                            "speaker": "吉盖克斯",
                            "text": "是您啊！您上次玩「风行迷踪」时所展现的技术，让我印象深刻。"
                        },
                        {
                            "id": "706700205",
                            "speaker": "吉盖克斯",
                            "text": "不过，虽然您玩起来游刃有余，但还是有不少人和我说这个游戏很难，要么游侠很难跑掉，要么猎手找不到人。"
                        },
                        {
                            "id": "706700206",
                            "speaker": "吉盖克斯",
                            "text": "还有人向我抱怨，被猎手抓住的游侠在游戏结束前根本就无事可干，只能在一旁干看着，实在有些无聊…"
                        },
                        {
                            "id": "706700207",
                            "speaker": "吉盖克斯",
                            "text": "唉，我也不知道他们说的对不对，所以就想再招募一批人来试玩，听听他们的意见…"
                        }
                    ]
                },
                {
                    "id": "706700208",
                    "text": "「风行迷踪」是什么？",
                    "response": [
                        {
                            "id": "706700209",
                            "speaker": "吉盖克斯",
                            "text": "啊哈，问得好，「风行迷踪」是一款承载着蒙德城历史的游戏！"
                        },
                        {
                            "id": "706700210",
                            "speaker": "吉盖克斯",
                            "text": "你应该知道，在之前的蒙德城里有一群「贵族」吧？"
                        },
                        {
                            "id": "706700211",
                            "speaker": "吉盖克斯",
                            "text": "他们在蒙德城里暴行不断，让不少人都苦不堪言…"
                        },
                        {
                            "id": "706700212",
                            "speaker": "吉盖克斯",
                            "text": "为了反抗贵族们的种种暴行，有一群勇敢的蒙德人聚集了起来，形成了一个秘密的反抗组织。"
                        },
                        {
                            "id": "706700213",
                            "speaker": "吉盖克斯",
                            "text": "这群游侠们不断在蒙德各处展开行动，让贵族们颇吃了些苦头。"
                        },
                        {
                            "id": "706700214",
                            "speaker": "吉盖克斯",
                            "text": "但是，那些贵族们也很快训练出了一群用来镇压游侠们的爪牙。"
                        },
                        {
                            "id": "706700215",
                            "speaker": "吉盖克斯",
                            "text": "于是，游侠们和贵族们的爪牙们，就这样在蒙德各处展开了一场又一场的对决。"
                        },
                        {
                            "id": "706700216",
                            "speaker": "吉盖克斯",
                            "text": "「风行迷踪」，正是取材于这样史诗一般的真实历史事件！曾经也是很受欢迎的…"
                        },
                        {
                            "id": "706700217",
                            "speaker": "Player",
                            "text": "曾经？"
                        },
                        {
                            "id": "706700218",
                            "speaker": "吉盖克斯",
                            "text": "是啊，现在城里的年轻人们对于「风行迷踪」可没多少兴趣了…"
                        },
                        {
                            "id": "706700219",
                            "speaker": "吉盖克斯",
                            "text": "但我可不想让「风行迷踪」就此失传，所以，我对它原来的规则做了些调整，让游戏规则更容易被理解，也更有趣。"
                        },
                        {
                            "id": "706700220",
                            "speaker": "吉盖克斯",
                            "text": "除此之外，我还特意添加了好几张全新的游戏地图。我觉得，这样应该会有更多的人来玩吧…"
                        }
                    ]
                },
                {
                    "id": "706700221",
                    "text": "离开。"
                }
            ]
        }
    ]
}