{
    "talkId": "6913109",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 7,
        "尼可": 11
    },
    "dialogues": [
        {
            "id": "691310401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691310402",
            "speaker": "尼可",
            "text": "我现在就想用最大声音呼喊。反正你这里周围生灵稀少。上次艾莉丝测过呢，我最大音量可以传播一百米内所有生命的心灵。",
            "choices": [
                {
                    "id": "691310403",
                    "text": "…别，壶里有别的朋友。",
                    "response": [
                        {
                            "id": "691310404",
                            "speaker": "尼可",
                            "text": "对哦。还有其他被你邀请来的朋友。"
                        },
                        {
                            "id": "691310407",
                            "speaker": "尼可",
                            "text": "那还是算了吧。我想想哦，难得来洞天，要做些什么有意思的事情呢？"
                        },
                        {
                            "id": "691310408",
                            "speaker": "Player",
                            "text": "把这里当成普通的庭院就好。"
                        },
                        {
                            "id": "691310409",
                            "speaker": "尼可",
                            "text": "确实。是我执着于本质，忽略表象了。这里虽然也是一种洞天，但是它更是你的小家。"
                        },
                        {
                            "id": "691310410",
                            "speaker": "尼可",
                            "text": "不一定要把这里当试验场。当成串门就好了。"
                        },
                        {
                            "id": "691310411",
                            "speaker": "尼可",
                            "text": "那，我想在你这里埋宝箱，设计谜题。",
                            "choices": [
                                {
                                    "id": "691310412",
                                    "text": "你去参加O的计划不是更有效率。",
                                    "response": [
                                        {
                                            "id": "691310413",
                                            "speaker": "尼可",
                                            "text": "哦，也对呢！不过这也不影响嘛。"
                                        },
                                        {
                                            "id": "691310415",
                                            "speaker": "尼可",
                                            "text": "我们来研究用墙做一个有趣的迷宫吧。"
                                        },
                                        {
                                            "id": "691310416",
                                            "speaker": "Player",
                                            "text": "宝箱你能提供吗？"
                                        },
                                        {
                                            "id": "691310417",
                                            "speaker": "尼可",
                                            "text": "交给我吧！对我们天使来说，箱子比内容重要。我一定会弄一个很厉害的箱子的。"
                                        },
                                        {
                                            "id": "691310418",
                                            "speaker": "尼可",
                                            "text": "至于内容。就随便丢些摩拉和卷心菜进去好了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "691310414",
                                    "text": "要怎么开始呢？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691310405",
                    "text": "…阿圆钻进壶里也防不住。",
                    "response": [
                        {
                            "id": "691310406",
                            "speaker": "尼可",
                            "text": "噢，也是。那只壶灵怪可爱的，波及到她不太好。"
                        }
                    ]
                }
            ]
        }
    ]
}