{
    "talkId": "6900809",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 6,
        "夜兰": 11
    },
    "dialogues": [
        {
            "id": "690080201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690080202",
            "speaker": "夜兰",
            "text": "还算不错，庭院里的陈设赏心悦目，远方的景致也别有一番韵味。"
        },
        {
            "id": "690080203",
            "speaker": "夜兰",
            "text": "嗯，算能让我享受闲暇时光了。",
            "choices": [
                {
                    "id": "690080204",
                    "text": "夜兰一般住在哪里？",
                    "response": [
                        {
                            "id": "690080206",
                            "speaker": "夜兰",
                            "text": "那当然是自己的家里。"
                        },
                        {
                            "id": "690080207",
                            "speaker": "夜兰",
                            "text": "只不过我的家在城外，是个很清静的地方。"
                        },
                        {
                            "id": "690080208",
                            "speaker": "夜兰",
                            "text": "呵呵…看你的眼神，该不会是听信了什么传言，以为我名下有不少财产，对生活起居的要求很严苛吧。"
                        },
                        {
                            "id": "690080209",
                            "speaker": "夜兰",
                            "text": "眼见都未必为实，更何况是流言呢。",
                            "choices": [
                                {
                                    "id": "690080210",
                                    "text": "远离喧嚣也有好处…",
                                    "response": [
                                        {
                                            "id": "690080212",
                                            "speaker": "夜兰",
                                            "text": "没错，这样的回答才像话，看来你也上道了。"
                                        },
                                        {
                                            "id": "690080213",
                                            "speaker": "夜兰",
                                            "text": "住得够远，就更有名正言顺的借口翘班啦。比如山路受阻，或者中途遭遇了拦路的盗宝团…"
                                        },
                                        {
                                            "id": "690080214",
                                            "speaker": "夜兰",
                                            "text": "何况，住在人来人往的城里，难免被人察觉到行踪。这会制造不必要的麻烦，妨碍我追查目标。"
                                        },
                                        {
                                            "id": "690080215",
                                            "speaker": "Player",
                                            "text": "原来还有这层考虑…"
                                        },
                                        {
                                            "id": "690080216",
                                            "speaker": "夜兰",
                                            "text": "话说回来，这里我进出自由，来去自如，不当做备用据点都有点可惜了。"
                                        },
                                        {
                                            "id": "690080217",
                                            "speaker": "夜兰",
                                            "text": "你不会介意的吧？"
                                        }
                                    ]
                                },
                                {
                                    "id": "690080211",
                                    "text": "或许对你的工作有帮助…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690080205",
                    "text": "夜兰一般去哪放松？"
                }
            ]
        }
    ]
}