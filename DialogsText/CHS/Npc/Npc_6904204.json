{
    "talkId": "6904204",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "刻晴": 12
    },
    "dialogues": [
        {
            "id": "690420401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690420402",
            "speaker": "刻晴",
            "text": "嗯，我们先约个晚上双方都方便的时间吧。"
        },
        {
            "id": "690420403",
            "speaker": "刻晴",
            "text": "不久前，我花了点时间，亲自走遍了这片家园的每一寸土地。"
        },
        {
            "id": "690420404",
            "speaker": "刻晴",
            "text": "找到了三处我心目中风景秀丽的地方。"
        },
        {
            "id": "690420405",
            "speaker": "刻晴",
            "text": "其中有一处，非常适合在夜晚看星星。"
        },
        {
            "id": "690420406",
            "speaker": "刻晴",
            "text": "怎么样，你有兴趣吗？",
            "choices": [
                {
                    "id": "690420407",
                    "text": "当然有兴趣。",
                    "response": [
                        {
                            "id": "690420408",
                            "speaker": "刻晴",
                            "text": "那就好。"
                        },
                        {
                            "id": "690420409",
                            "speaker": "刻晴",
                            "text": "问之前我还有些忐忑，甚至考虑了如果你拒绝的话要怎么说服你…"
                        },
                        {
                            "id": "690420412",
                            "speaker": "刻晴",
                            "text": "我是把它当做…对自己完成一阶段工作后的奖励来考虑的。"
                        },
                        {
                            "id": "690420413",
                            "speaker": "刻晴",
                            "text": "这种不可多得的幸福，要小心地使用。"
                        },
                        {
                            "id": "690420414",
                            "speaker": "Player",
                            "text": "刻晴…"
                        },
                        {
                            "id": "690420415",
                            "speaker": "刻晴",
                            "text": "既然你没有异议，那就尽快安排一下你的日程吧。"
                        },
                        {
                            "id": "690420416",
                            "speaker": "刻晴",
                            "text": "问我的话，当然是越快越好。"
                        }
                    ]
                },
                {
                    "id": "690420410",
                    "text": "没想到刻晴还有观星的爱好。",
                    "response": [
                        {
                            "id": "690420411",
                            "speaker": "刻晴",
                            "text": "也不算爱好吧…"
                        }
                    ]
                }
            ]
        }
    ]
}