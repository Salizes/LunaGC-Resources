{
    "talkId": "6909803",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 4,
        "克洛琳德": 17
    },
    "dialogues": [
        {
            "id": "690980301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690980302",
            "speaker": "克洛琳德",
            "text": "当然。你有什么感兴趣的话题吗？",
            "choices": [
                {
                    "id": "690980303",
                    "text": "成为最强决斗代理人之前的故事！",
                    "response": [
                        {
                            "id": "690980304",
                            "speaker": "克洛琳德",
                            "text": "在我认识娜维娅之前…"
                        },
                        {
                            "id": "690980305",
                            "speaker": "Player",
                            "text": "那么早吗？！"
                        },
                        {
                            "id": "690980306",
                            "speaker": "克洛琳德",
                            "text": "既然你想听的，是与如今我的生活截然不同的故事，我认为那会是一个很好的节点。"
                        },
                        {
                            "id": "690980307",
                            "speaker": "克洛琳德",
                            "text": "那时，我和师父朝夕相处。她是一位强大而又严格的人，对我的童年造成了许多影响。"
                        },
                        {
                            "id": "690980308",
                            "speaker": "克洛琳德",
                            "text": "我曾害怕夜行的魔物，因为不知它们会从哪个地方发起攻势。"
                        },
                        {
                            "id": "690980309",
                            "speaker": "克洛琳德",
                            "text": "她用布蒙上了我的双眼，把我推到林间，说「这里全是魔物」，要我在白天也靠听觉与直觉做出反应。"
                        },
                        {
                            "id": "690980310",
                            "speaker": "克洛琳德",
                            "text": "我曾惧怕孤独，在她离开我身边后便难以入睡。"
                        },
                        {
                            "id": "690980311",
                            "speaker": "克洛琳德",
                            "text": "后来很长一段时间，她都要我每天练习到再也抬不动手之后才放我去休息。"
                        },
                        {
                            "id": "690980312",
                            "speaker": "克洛琳德",
                            "text": "每天早上睁眼看到师父的脸，反倒成为了新的噩梦…"
                        },
                        {
                            "id": "690980313",
                            "speaker": "克洛琳德",
                            "text": "不知不觉，我也成为了一个如她一般坚强的人。"
                        },
                        {
                            "id": "690980314",
                            "speaker": "克洛琳德",
                            "text": "而可怕的是，如果现在要我收一名徒弟，我想不出比她当年更好的教育方法。"
                        }
                    ]
                },
                {
                    "id": "690980315",
                    "text": "决斗代理人工作中的趣闻！",
                    "response": [
                        {
                            "id": "690980316",
                            "speaker": "克洛琳德",
                            "text": "工作…嗯…"
                        },
                        {
                            "id": "690980317",
                            "speaker": "克洛琳德",
                            "text": "即使你把「工作」和「趣闻」两个词组放进同一个杯子里，它们也会分层。"
                        },
                        {
                            "id": "690980318",
                            "speaker": "克洛琳德",
                            "text": "我听说，不少同事曾在下班途中被隔天的决斗对象拽住，拖进咖啡馆里，听对方痛诉衷肠。"
                        },
                        {
                            "id": "690980319",
                            "speaker": "克洛琳德",
                            "text": "很浪费时间的行为，不是吗？我很高兴我从没遇上过。"
                        },
                        {
                            "id": "690980320",
                            "speaker": "克洛琳德",
                            "text": "但我不建议你继续打听下去。"
                        },
                        {
                            "id": "690980321",
                            "speaker": "克洛琳德",
                            "text": "我们这一行很容易见到过剩的故事性与戏剧感，但它们多半虚伪且肮脏…你会失望的。"
                        }
                    ]
                }
            ]
        }
    ]
}