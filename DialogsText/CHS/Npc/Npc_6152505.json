{
    "talkId": "6152505",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "薇尔": 13
    },
    "dialogues": [
        {
            "id": "615250501",
            "speaker": "Player",
            "text": "你刚在自言自语什么？"
        },
        {
            "id": "615250502",
            "speaker": "薇尔",
            "text": "哦，莎拉最近想进口点璃月原产辣椒，据说是能让蒙德最爱吃辣的芭芭拉都辣哭的品种。"
        },
        {
            "id": "615250503",
            "speaker": "薇尔",
            "text": "要我说，不符合86%的蒙德人的口味，费大半天力气进口了也很难卖出去吧。",
            "choices": [
                {
                    "id": "615250504",
                    "text": "芭芭拉喜欢吃辣？",
                    "response": [
                        {
                            "id": "615250505",
                            "speaker": "薇尔",
                            "text": "啊？原来你不知道吗？我以为全蒙德的人都知道呢。"
                        },
                        {
                            "id": "615250506",
                            "speaker": "Player",
                            "text": "请多说些「全蒙德知道」的事…"
                        },
                        {
                            "id": "615250507",
                            "speaker": "薇尔",
                            "text": "嗯…大家都知道图书馆的丽莎小姐有喝下午茶的习惯吧？"
                        },
                        {
                            "id": "615250508",
                            "speaker": "薇尔",
                            "text": "有一天，一位来自璃月的行商小贩，见到丽莎在用一种特殊的细腻网状物滤去茶渣。"
                        },
                        {
                            "id": "615250509",
                            "speaker": "薇尔",
                            "text": "虽说他当时并没看清丽莎用的是什么，但还是仿照着丽莎的制作手法，推出了名为「丝袜伯爵茶」的饮品。"
                        },
                        {
                            "id": "615250510",
                            "speaker": "薇尔",
                            "text": "即便事后有人推断，丽莎滤去茶渣所用的，只是一种常见的炼金滤材而已…但真相是什么连我也不知道了。"
                        },
                        {
                            "id": "615250511",
                            "speaker": "薇尔",
                            "text": "至少这种命名暧昧的茶饮料，在很长一段时间内流行了起来，哪怕是在偏重酒文化的蒙德。"
                        },
                        {
                            "id": "615250512",
                            "speaker": "薇尔",
                            "text": "不得不佩服璃月人的商业头脑，总是可以创造出令部分人无法抗拒的噱头呢…嗯…"
                        }
                    ]
                },
                {
                    "id": "615250513",
                    "text": "你可以劝劝她。",
                    "response": [
                        {
                            "id": "615250514",
                            "speaker": "薇尔",
                            "text": "我劝过了，并没有用。"
                        },
                        {
                            "id": "615250515",
                            "speaker": "薇尔",
                            "text": "如果还想不出办法，就只能动用「那个男人」了。"
                        },
                        {
                            "id": "615250516",
                            "speaker": "薇尔",
                            "text": "常识来讲，以凯亚的话术，稍微旁敲侧击一下就搞定了吧。"
                        },
                        {
                            "id": "615250517",
                            "speaker": "薇尔",
                            "text": "咳咳，总之，谢谢你的关心了。"
                        }
                    ]
                }
            ]
        }
    ]
}