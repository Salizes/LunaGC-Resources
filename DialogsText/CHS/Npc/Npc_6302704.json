    "dialogues": [
        {
            "id": "630270401",
            "speaker": "Player",
            "text": "关于「天目流」…"
        },
        {
            "id": "630270402",
            "speaker": "天目十五",
            "text": "在稻妻的刀匠中，有雷电五传之说。"
        },
        {
            "id": "630270403",
            "speaker": "天目十五",
            "text": "据说在古代，曾有某位浪人将锻造工艺传授给弟子五人，五种锻造之法各有秘籍。"
        },
        {
            "id": "630270404",
            "speaker": "天目十五",
            "text": "「天目流」便是其中一传。"
        }
    ]
}