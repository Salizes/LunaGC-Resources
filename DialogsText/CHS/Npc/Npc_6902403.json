{
    "talkId": "6902403",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "北斗": 11
    },
    "dialogues": [
        {
            "id": "690240301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690240302",
            "speaker": "北斗",
            "text": "好啊！想聊什么都行！"
        },
        {
            "id": "690240303",
            "speaker": "北斗",
            "text": "不过，我海上的故事你恐怕都从别人那儿听烦了吧？"
        },
        {
            "id": "690240304",
            "speaker": "北斗",
            "text": "不如咱们换换，说说你的冒险故事吧！",
            "choices": [
                {
                    "id": "690240305",
                    "text": "嗯…我打过龙哟。",
                    "response": [
                        {
                            "id": "690240306",
                            "speaker": "北斗",
                            "text": "哟，可以呀！那龙多大？"
                        },
                        {
                            "id": "690240308",
                            "speaker": "北斗",
                            "text": "啧啧啧，厉害呀！"
                        },
                        {
                            "id": "690240309",
                            "speaker": "北斗",
                            "text": "我揍过海里的，你打过天上的。"
                        },
                        {
                            "id": "690240310",
                            "speaker": "北斗",
                            "text": "咱们一起出去冒险，那岂不所向披靡了！"
                        },
                        {
                            "id": "690240311",
                            "speaker": "Player",
                            "text": "我基本都是在打丘丘人…"
                        },
                        {
                            "id": "690240312",
                            "speaker": "北斗",
                            "text": "丘丘人怎么了？我在海上想见还见不到一只呢！"
                        },
                        {
                            "id": "690240313",
                            "speaker": "北斗",
                            "text": "冒险不在于你遇到了多少风浪，而在于你知道还有更多未知的风浪在等着你！"
                        },
                        {
                            "id": "690240314",
                            "speaker": "北斗",
                            "text": "嚯，我好像说了句了不起的话嘛。"
                        },
                        {
                            "id": "690240315",
                            "speaker": "北斗",
                            "text": "哈哈哈！快活！值得为这个干上一杯！"
                        }
                    ]
                },
                {
                    "id": "690240307",
                    "text": "大概比北斗的船还大。"
                }
            ]
        }
    ]
}