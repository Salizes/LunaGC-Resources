    "dialogues": [
        {
            "id": "150458301",
            "speaker": "Player",
            "text": "不如帮你拍张照？"
        },
        {
            "id": "150458302",
            "speaker": "恰斯卡",
            "text": "好，那就这样。"
        },
        {
            "id": "150458303",
            "speaker": "恰斯卡",
            "text": "本来想拿去送给「妈妈」，但她看到只怕要举起翅膀，问我留画片算什么意思，怎么平时不多去看看她…"
        },
        {
            "id": "150458304",
            "speaker": "恰斯卡",
            "text": "我还是自己留作纪念吧。"
        }
    ]
}