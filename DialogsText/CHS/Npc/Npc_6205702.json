    },
    "dialogues": [
        {
            "id": "620570201",
            "speaker": "Player",
            "text": "好像有什么声音？"
        },
        {
            "id": "620570202",
            "speaker": "一成",
            "text": "这是咕…"
        },
        {
            "id": "620570203",
            "speaker": "一成",
            "text": "我的肚子咕噜…"
        },
        {
            "id": "620570204",
            "speaker": "一成",
            "text": "因为我咕…"
        },
        {
            "id": "620570205",
            "speaker": "一成",
            "text": "总是肚子很饿，所以一直咕噜咕噜叫个不停咕噜咕噜…",
            "choices": [
                {
                    "id": "620570206",
                    "text": "你真的没事吗？",
                    "response": [
                        {
                            "id": "620570207",
                            "speaker": "一成",
                            "text": "没事的咕…"
                        },
                        {
                            "id": "620570208",
                            "speaker": "一成",
                            "text": "除了有时候咕…"
                        },
                        {
                            "id": "620570209",
                            "speaker": "一成",
                            "text": "会盖住我的声音之外咕咕…"
                        },
                        {
                            "id": "620570210",
                            "speaker": "一成",
                            "text": "一切都很正常咕咕咕…"
                        }
                    ]
                },
                {
                    "id": "620570211",
                    "text": "需要我帮你带些吃的吗？",
                    "response": [
                        {
                            "id": "620570212",
                            "speaker": "一成",
                            "text": "那真是再好不过了！"
                        },
                        {
                            "id": "620570213",
                            "speaker": "一成",
                            "text": "我想吃咕噜…"
                        },
                        {
                            "id": "620570214",
                            "speaker": "一成",
                            "text": "还有咕噜噜…"
                        },
                        {
                            "id": "620570215",
                            "speaker": "一成",
                            "text": "以及咕噜咕噜再配上一点咕噜…"
                        },
                        {
                            "id": "620570216",
                            "speaker": "一成",
                            "text": "那就这些好了，谢谢你！"
                        }
                    ]
                }
            ]
        }
    ]
}