{
    "talkId": "6913309",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 9,
        "桑多涅": 18
    },
    "dialogues": [
        {
            "id": "691330401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691330402",
            "speaker": "桑多涅",
            "text": "你这儿有毛茸茸的小动物吗？猫、狗、狐狸…羊也行，我不挑。"
        },
        {
            "id": "691330403",
            "speaker": "桑多涅",
            "text": "最重要的是，它们能听你话吗？"
        },
        {
            "id": "691330404",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "691330405",
            "speaker": "桑多涅",
            "text": "借我揉一下就还给你。"
        },
        {
            "id": "691330406",
            "speaker": "Player",
            "text": "哈？"
        },
        {
            "id": "691330407",
            "speaker": "桑多涅",
            "text": "啧，别学我口气。"
        },
        {
            "id": "691330408",
            "speaker": "桑多涅",
            "text": "跟你说过的吧？野外的那些动物不算亲近我。"
        },
        {
            "id": "691330409",
            "speaker": "桑多涅",
            "text": "它们有一套独立又复杂的感觉系统，那戒心不是我调调温度模块或者笑容曲线就能改变的。"
        },
        {
            "id": "691330410",
            "speaker": "桑多涅",
            "text": "直说吧，我已经试过很多次了，但天才如我都没辙。"
        },
        {
            "id": "691330411",
            "speaker": "桑多涅",
            "text": "最便捷的方法，反倒是找到一个能让它们感到信赖的人，再轻声细语地告诉小动物，我是个不会伤害它们的好人。",
            "choices": [
                {
                    "id": "691330412",
                    "text": "比如找奈芙尔？",
                    "response": [
                        {
                            "id": "691330413",
                            "speaker": "桑多涅",
                            "text": "是，但奈芙尔心思太多。一两次还行，总是要分出心神来接她的话也怪累的。"
                        },
                        {
                            "id": "691330416",
                            "speaker": "Player",
                            "text": "那…哥伦比娅呢？"
                        },
                        {
                            "id": "691330417",
                            "speaker": "桑多涅",
                            "text": "……"
                        },
                        {
                            "id": "691330418",
                            "speaker": "桑多涅",
                            "text": "说到这个我就来气！"
                        },
                        {
                            "id": "691330419",
                            "speaker": "桑多涅",
                            "text": "有天我去找那夏镇的凯瑟琳办事，一只不知道从哪里来的凛角鹿突然跑过来拱我。"
                        },
                        {
                            "id": "691330420",
                            "speaker": "桑多涅",
                            "text": "那脖子上的毛皮确实柔软又暖和，鹿角摸起来的手感也很新奇…"
                        },
                        {
                            "id": "691330421",
                            "speaker": "桑多涅",
                            "text": "结果一回头，就看到哥伦比娅那家伙笑着在看我。"
                        },
                        {
                            "id": "691330422",
                            "speaker": "桑多涅",
                            "text": "「桑多涅，小动物们都躲着你，看起来很可怜。我和它们说了你不是坏人，反倒很温柔，睡觉时也经常抱着…」"
                        },
                        {
                            "id": "691330423",
                            "speaker": "Player",
                            "text": "抱着…？"
                        },
                        {
                            "id": "691330424",
                            "speaker": "桑多涅",
                            "text": "鬼才告诉你啦！重点是谁可怜了？谁需要小动物陪啦？！还把我的隐私说给它们听！烦死个人了。",
                            "choices": [
                                {
                                    "id": "691330425",
                                    "text": "她也是照顾你的感情…",
                                    "response": [
                                        {
                                            "id": "691330427",
                                            "speaker": "桑多涅",
                                            "text": "别说这些有的没的了，你到底借不借吧？！"
                                        }
                                    ]
                                },
                                {
                                    "id": "691330426",
                                    "text": "怪可爱的…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691330414",
                    "text": "比如找菈乌玛？",
                    "response": [
                        {
                            "id": "691330415",
                            "speaker": "桑多涅",
                            "text": "是，但菈乌玛很少离开霜月之坊。我这位讨人厌的「愚人众」执行官，一天到晚大摇大摆地出现在他们的居所也不妥当吧。"
                        }
                    ]
                }
            ]
        }
    ]
}