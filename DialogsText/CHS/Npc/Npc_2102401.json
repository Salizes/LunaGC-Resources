{
    "talkId": "2102401",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 4,
        "兰达": 17
    },
    "dialogues": [
        {
            "id": "210240101",
            "speaker": "兰达",
            "text": "这下可糟糕了…"
        },
        {
            "id": "210240102",
            "speaker": "Player",
            "text": "发生什么了？"
        },
        {
            "id": "210240103",
            "speaker": "兰达",
            "text": "啊？是旅行者啊…是这样，我是个商人，一直在蒙德城和璃月港之间跑生意。"
        },
        {
            "id": "210240104",
            "speaker": "兰达",
            "text": "我刚在蒙德城做了笔大生意，正准备把货单带回去给老板…"
        },
        {
            "id": "210240105",
            "speaker": "兰达",
            "text": "但是没想到，刚走到这附近，就被一群怪物袭击了。"
        },
        {
            "id": "210240106",
            "speaker": "兰达",
            "text": "我又打不过这群怪物，只能掉头就跑，跌跌撞撞一直跑到了这客栈里面。"
        },
        {
            "id": "210240107",
            "speaker": "兰达",
            "text": "但是我人跑掉了，货单却全部弄丢了…您能帮我找回来吗？",
            "choices": [
                {
                    "id": "210240108",
                    "text": "我知道了。",
                    "response": [
                        {
                            "id": "210240109",
                            "speaker": "兰达",
                            "text": "太好了，我大概能记得我跑过的地方，这就给您标上…"
                        },
                        {
                            "id": "210240110",
                            "speaker": "兰达",
                            "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
                        }
                    ]
                },
                {
                    "id": "210240111",
                    "text": "什么货单？",
                    "response": [
                        {
                            "id": "210240112",
                            "speaker": "兰达",
                            "text": "当然是酒啊，从蒙德还能跑什么生意。"
                        },
                        {
                            "id": "210240113",
                            "speaker": "兰达",
                            "text": "这可是笔大生意，要是出了问题，老板准要怪罪我。"
                        },
                        {
                            "id": "210240114",
                            "speaker": "兰达",
                            "text": "您就帮帮我吧。我把记得的大概位置都给标好了。"
                        },
                        {
                            "id": "210240115",
                            "speaker": "兰达",
                            "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
                        }
                    ]
                },
                {
                    "id": "210240116",
                    "text": "你老板是谁？",
                    "response": [
                        {
                            "id": "210240117",
                            "speaker": "兰达",
                            "text": "我老板？啊…那个，是璃月港里一个很有钱的商人，很有钱。"
                        },
                        {
                            "id": "210240118",
                            "speaker": "兰达",
                            "text": "哎呀，你就别多问了，我就是个跑腿的，老板的事我也不清楚。"
                        },
                        {
                            "id": "210240119",
                            "speaker": "兰达",
                            "text": "但我要是把这笔生意给弄黄了，估计连跑腿的工作都没了。"
                        },
                        {
                            "id": "210240120",
                            "speaker": "兰达",
                            "text": "您就帮帮我吧。我把记得的大概位置都给标好了。"
                        },
                        {
                            "id": "210240121",
                            "speaker": "兰达",
                            "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
                        }
                    ]
                }
            ]
        }
    ]
}