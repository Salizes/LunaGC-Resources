{
    "talkId": "6990040",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 7,
        "派蒙": 7
    },
    "dialogues": [
        {
            "id": "699004001",
            "speaker": "Player",
            "text": "关于魔术…"
        },
        {
            "id": "699004002",
            "speaker": "派蒙",
            "text": "林尼的魔术表演真精彩，在解答之前，完全想不到他是怎么做到的！"
        },
        {
            "id": "699004003",
            "speaker": "Player",
            "text": "啊，我突然想到了一个魔术。"
        },
        {
            "id": "699004004",
            "speaker": "派蒙",
            "text": "欸？你也会魔术？",
            "choices": [
                {
                    "id": "699004005",
                    "text": "嗯，我会把大大的魔术帽悬浮在空中…",
                    "response": [
                        {
                            "id": "699004007",
                            "speaker": "派蒙",
                            "text": "哇！真的吗？怎么办到的呀？"
                        },
                        {
                            "id": "699004008",
                            "speaker": "Player",
                            "text": "嘿嘿，因为派蒙在帽子里呀。"
                        },
                        {
                            "id": "699004009",
                            "speaker": "派蒙",
                            "text": "欸？为什么我在…哦！是我让它飘起来的呀！"
                        },
                        {
                            "id": "699004010",
                            "speaker": "派蒙",
                            "text": "嘿嘿，那我也想到了一个魔术！"
                        },
                        {
                            "id": "699004011",
                            "speaker": "Player",
                            "text": "哦？说来听听。"
                        },
                        {
                            "id": "699004012",
                            "speaker": "派蒙",
                            "text": "你往这个帽子里塞好多好吃的，会发现它怎么装都装不满！"
                        },
                        {
                            "id": "699004013",
                            "speaker": "Player",
                            "text": "呃…那盘子怎么办？"
                        },
                        {
                            "id": "699004014",
                            "speaker": "派蒙",
                            "text": "哦对！这帽子还会自己把盘子吐出来，很神奇吧！"
                        }
                    ]
                },
                {
                    "id": "699004006",
                    "text": "还能让它听我的指示飘来飘去。"
                }
            ]
        }
    ]
}