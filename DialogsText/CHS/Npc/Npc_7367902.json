    "dialogues": [
        {
            "id": "736790201",
            "speaker": "法拉比",
            "text": "旅行者，如果你准备好了的话，我就要点燃诱饵吸引大雪猪过来了。",
            "choices": [
                {
                    "id": "736790202",
                    "text": "我准备好了，大雪猪！"
                },
                {
                    "id": "736790203",
                    "text": "等一下，我还需要做点准备。",
                    "response": [
                        {
                            "id": "736790204",
                            "speaker": "法拉比",
                            "text": "没关系，你可以慢慢来，毕竟我们要对付的是那个大家伙嘛。"
                        }
                    ]
                },
                {
                    "id": "736790205",
                    "text": "埃德蒙德先生呢？",
                    "response": [
                        {
                            "id": "736790206",
                            "speaker": "法拉比",
                            "text": "因为埃德蒙德先生还要负责清泉镇的安全，所以我就让他先回去了。你放心吧，我会在一旁谨慎行事，不会给你添麻烦的。"
                        }
                    ]
                }
            ]
        }
    ]
}