    "dialogues": [
        {
            "id": "622050401",
            "speaker": "Player",
            "text": "你有什么作品吗？"
        },
        {
            "id": "622050402",
            "speaker": "清昼",
            "text": "「百战方孑存，万劫苦浩茫。」"
        },
        {
            "id": "622050403",
            "speaker": "清昼",
            "text": "「掠影傍孤云，祓恶报仙王。」"
        },
        {
            "id": "622050404",
            "speaker": "清昼",
            "text": "这是一首有关一位仙人的诗，不知为何感觉在这里吟诵会非常合适呢…"
        },
        {
            "id": "622050405",
            "speaker": "清昼",
            "text": "呵呵见笑了，见笑了。"
        }
    ]
}