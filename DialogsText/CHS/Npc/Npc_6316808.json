    "dialogues": [
        {
            "id": "631680801",
            "speaker": "Player",
            "text": "老样子…"
        },
        {
            "id": "631680802",
            "speaker": "梶",
            "text": "这样啊…"
        },
        {
            "id": "631680803",
            "speaker": "梶",
            "text": "打起精神来吧！总会有好事发生的！"
        },
        {
            "id": "631680804",
            "speaker": "梶",
            "text": "现在幕府和叛军议和了，矿场生产也终于有机会恢复正常了。"
        },
        {
            "id": "631680805",
            "speaker": "梶",
            "text": "唉，虽然停战了是好事，但一想到绯木村地那些受难者就…"
        },
        {
            "id": "631680806",
            "speaker": "梶",
            "text": "不知道那边何时才能恢复生机啊…"
        }
    ]
}