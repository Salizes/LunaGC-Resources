    "dialogues": [
        {
            "id": "615670501",
            "speaker": "Player",
            "text": "关于龙灾…"
        },
        {
            "id": "615670502",
            "speaker": "提米",
            "text": "我在想，风魔龙…会不会是鸽子变的呢？"
        },
        {
            "id": "615670503",
            "speaker": "提米",
            "text": "就是因为你们老吓它们，所以它们变成了龙，回来报复人类！"
        },
        {
            "id": "615670504",
            "speaker": "提米",
            "text": "它一定不会伤害像我这样善待它们的人，一定是这样的…"
        }
    ]
}