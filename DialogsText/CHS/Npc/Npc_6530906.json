    "dialogues": [
        {
            "id": "653090601",
            "speaker": "Player",
            "text": "咦，这里也有记者吗？"
        },
        {
            "id": "653090602",
            "speaker": "洛梅",
            "text": "嘿嘿，记者，是说我吗…看来我的气势和真正的记者也差不多嘛！"
        },
        {
            "id": "653090603",
            "speaker": "洛梅",
            "text": "不过我不是真的记者啦，现在还在努力学习成为一名记者。"
        },
        {
            "id": "653090604",
            "speaker": "洛梅",
            "text": "就像《蒸汽鸟报》上面写报道的那些记者一样！"
        }
    ]
}