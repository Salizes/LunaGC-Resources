{
    "talkId": "41803",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 8,
        "利文斯通博士": 21
    },
    "dialogues": [
        {
            "id": "4180301",
            "speaker": "利文斯通博士",
            "text": "这座剑冢可真让人伤脑筋啊…",
            "choices": [
                {
                    "id": "4180302",
                    "text": "关于剑冢…",
                    "response": [
                        {
                            "id": "4180303",
                            "speaker": "利文斯通博士",
                            "text": "这座剑冢很久以前就在这里了，大概是过去讨伐魔物的战士们留下的遗物…"
                        },
                        {
                            "id": "4180304",
                            "speaker": "利文斯通博士",
                            "text": "古代的勇者为了防止周围的丘丘人玷污剑冢，特意布下了三层封印。只有分别击败三个丘丘人部落，触发部落中的机关，才能解开。",
                            "choices": [
                                {
                                    "id": "4180305",
                                    "text": "关于丘丘人部落…",
                                    "response": [
                                        {
                                            "id": "4180306",
                                            "speaker": "利文斯通博士",
                                            "text": "剑冢周围一共有三个丘丘人部落，分别是北方的「好肉族」、南方的「好睡族」和东边谷地中的「黑日族」。",
                                            "choices": [
                                                {
                                                    "id": "4180318",
                                                    "text": "好肉族？",
                                                    "response": [
                                                        {
                                                            "id": "4180319",
                                                            "speaker": "利文斯通博士",
                                                            "text": "就是北边的部族啦。"
                                                        },
                                                        {
                                                            "id": "4180320",
                                                            "speaker": "利文斯通博士",
                                                            "text": "顾名思义，「好肉族」喜欢吃肉，痴迷肌肉，"
                                                        },
                                                        {
                                                            "id": "4180321",
                                                            "speaker": "利文斯通博士",
                                                            "text": "所以个个肌肉发达，头脑简单"
                                                        },
                                                        {
                                                            "id": "4180322",
                                                            "speaker": "利文斯通博士",
                                                            "text": "不巧的是，封印的机关恰恰在大擂台中央。"
                                                        },
                                                        {
                                                            "id": "4180323",
                                                            "speaker": "利文斯通博士",
                                                            "text": "一旦闯进去，就会被当成挑战者，和他们来一场大群殴。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "4180324",
                                                    "text": "好睡族？",
                                                    "response": [
                                                        {
                                                            "id": "4180325",
                                                            "speaker": "利文斯通博士",
                                                            "text": "「好睡族」在剑冢的南边。"
                                                        },
                                                        {
                                                            "id": "4180326",
                                                            "speaker": "利文斯通博士",
                                                            "text": "它们整天嗜睡，但却非常狡猾，诡计多端。"
                                                        },
                                                        {
                                                            "id": "4180327",
                                                            "speaker": "利文斯通博士",
                                                            "text": "所以不要被它们懒洋洋的模样骗了，它们一点也不好对付！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "4180328",
                                                    "text": "黑日族？",
                                                    "response": [
                                                        {
                                                            "id": "4180329",
                                                            "speaker": "利文斯通博士",
                                                            "text": "「黑日族」在东边的谷地中，是三个部族中最危险的，它们崇尚萨满传统，每天都神神叨叨的…"
                                                        },
                                                        {
                                                            "id": "4180330",
                                                            "speaker": "利文斯通博士",
                                                            "text": "那里的萨满虽然不信七神，却也能够驱使自然元素的力量。"
                                                        },
                                                        {
                                                            "id": "4180331",
                                                            "speaker": "利文斯通博士",
                                                            "text": "另外那里还有深渊法师出没…若不是亲眼见到，我还以为那只是古籍中的传说…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "4180307",
                                    "text": "为什么机关会在丘丘人部落里？",
                                    "response": [
                                        {
                                            "id": "4180308",
                                            "speaker": "利文斯通博士",
                                            "text": "这…是个好问题。以丘丘人的智力，它们是不会制造和处理机关的…所以…或许机关本身也是古代的英雄们留在此地的遗迹吧？"
                                        },
                                        {
                                            "id": "4180309",
                                            "speaker": "利文斯通博士",
                                            "text": "一方面机关降下了保护剑冢的封印，另一方面此地的丘丘人又恰好为剑冢充当了卫士的工作，"
                                        },
                                        {
                                            "id": "4180310",
                                            "speaker": "利文斯通博士",
                                            "text": "既发挥了人类的智力，也利用了丘丘人的愚蠢…或许这就是古代人的智慧吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "4180332",
                                    "text": "听起来很危险呢。",
                                    "response": [
                                        {
                                            "id": "4180333",
                                            "speaker": "利文斯通博士",
                                            "text": "话是这样说的，但是对于我们冒险家而言，「危险」也只是家常便饭而已啦！"
                                        },
                                        {
                                            "id": "4180334",
                                            "speaker": "利文斯通博士",
                                            "text": "我们冒险家都是为征服星空与深渊而生的人，为了区区危险而停下探索步伐，这样的人也太无聊了！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "4180335",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "4180336",
                            "speaker": "利文斯通博士",
                            "text": "嗯，注意安全啊。"
                        }
                    ]
                }
            ]
        }
    ]
}