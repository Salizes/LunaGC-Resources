    "dialogues": [
        {
            "id": "641080201",
            "speaker": "Player",
            "text": "小船也需要吗？"
        },
        {
            "id": "641080202",
            "speaker": "马斯鲁尔",
            "text": "请问是商船吗？"
        },
        {
            "id": "641080203",
            "speaker": "马斯鲁尔",
            "text": "理论上所有入港的船只都要登记所有人信息和入港事由等内容。"
        },
        {
            "id": "641080204",
            "speaker": "马斯鲁尔",
            "text": "涉及贸易往来的更是尤为重要。"
        },
        {
            "id": "641080205",
            "speaker": "马斯鲁尔",
            "text": "未登记的商船在奥摩斯港做生意，一旦被发现，会被立即叫停并受到行政处罚。"
        }
    ]
}