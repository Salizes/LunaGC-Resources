{
    "talkId": "6904408",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "辛焱": 18
    },
    "dialogues": [
        {
            "id": "690440801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690440402",
            "speaker": "辛焱",
            "text": "嗯…你想不想试试看弹琴？"
        },
        {
            "id": "690440403",
            "speaker": "辛焱",
            "text": "你看，你也听过我那么多场表演了。"
        },
        {
            "id": "690440404",
            "speaker": "辛焱",
            "text": "如果感兴趣，自己也想试试的话，我可以手把手教你！",
            "choices": [
                {
                    "id": "690440405",
                    "text": "乐器的话，我以前学过。",
                    "response": [
                        {
                            "id": "690440406",
                            "speaker": "辛焱",
                            "text": "欸，真的吗？太好了！"
                        },
                        {
                            "id": "690440411",
                            "speaker": "辛焱",
                            "text": "啊，对我来说，「摇滚」是像生命一样重要的东西。"
                        },
                        {
                            "id": "690440412",
                            "speaker": "辛焱",
                            "text": "假如能跟你一起演绎「摇滚」，那一定是双倍的…不，那一定是这个世上最棒的事情！"
                        },
                        {
                            "id": "690440413",
                            "speaker": "辛焱",
                            "text": "当，当然…我知道音乐品味会有不同。我心目中的「摇滚」也不止于音乐本身。"
                        },
                        {
                            "id": "690440414",
                            "speaker": "辛焱",
                            "text": "如果你有不情愿的地方，我肯定不会强迫你的！",
                            "choices": [
                                {
                                    "id": "690440415",
                                    "text": "为辛焱的话，我可以试试…",
                                    "response": [
                                        {
                                            "id": "690440416",
                                            "speaker": "辛焱",
                                            "text": "嗯…嗯…"
                                        },
                                        {
                                            "id": "690440417",
                                            "speaker": "辛焱",
                                            "text": "那我可不能辜负你的信任，要做个好老师啊。"
                                        },
                                        {
                                            "id": "690440418",
                                            "speaker": "辛焱",
                                            "text": "给，这是我的琴。"
                                        },
                                        {
                                            "id": "690440419",
                                            "speaker": "辛焱",
                                            "text": "魔鬼训练…要开始了哦！"
                                        }
                                    ]
                                },
                                {
                                    "id": "690440420",
                                    "text": "或许能找到其他演绎「摇滚」的方法？",
                                    "response": [
                                        {
                                            "id": "690440421",
                                            "speaker": "辛焱",
                                            "text": "没·问·题！"
                                        },
                                        {
                                            "id": "690440422",
                                            "speaker": "辛焱",
                                            "text": "其实…你能答应我，我已经很感动了。"
                                        },
                                        {
                                            "id": "690440423",
                                            "speaker": "辛焱",
                                            "text": "毕竟，你对我而言，意义不凡…"
                                        },
                                        {
                                            "id": "690440424",
                                            "speaker": "辛焱",
                                            "text": "咳咳…我会期待，和你一起「摇滚」起来的！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690440407",
                    "text": "我怕我弹不好…",
                    "response": [
                        {
                            "id": "690440408",
                            "speaker": "辛焱",
                            "text": "没事，有我帮你！"
                        },
                        {
                            "id": "690440409",
                            "speaker": "辛焱",
                            "text": "我会注意方式方法、循序渐进的…虽然我也是第一次当老师。"
                        }
                    ]
                },
                {
                    "id": "690440410",
                    "text": "为什么会想到这个？"
                }
            ]
        }
    ]
}