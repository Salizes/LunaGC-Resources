    "dialogues": [
        {
            "id": "620540601",
            "speaker": "Player",
            "text": "关于岩王帝君的死…"
        },
        {
            "id": "620540602",
            "speaker": "石头",
            "text": "唉，岩王爷一路走好了…"
        },
        {
            "id": "620540603",
            "speaker": "石头",
            "text": "不过伤心归伤心，我们也得好好活着不是？"
        },
        {
            "id": "620540604",
            "speaker": "石头",
            "text": "我在考虑要不要把在送仙典仪上用到的那种夜泊石改个名，以此来纪念岩王爷。"
        },
        {
            "id": "620540605",
            "speaker": "石头",
            "text": "你说是叫「送仙石」好，还是叫「别神石」好呢？好像两个都不错啊…"
        }
    ]
}