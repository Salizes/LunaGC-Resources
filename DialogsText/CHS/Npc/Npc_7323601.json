        {
            "id": "732360102",
            "speaker": "「本周膳食」",
            "text": "「合理饮食，规律作息，保持良好心情」"
        },
        {
            "id": "732360103",
            "speaker": "「本周膳食」",
            "text": "「周一：薄荷豆汤，米圆塔（午餐）；咖喱虾，绿汁脆球（晚餐）」"
        },
        {
            "id": "732360104",
            "speaker": "「本周膳食」",
            "text": "「周二：沙拉，兽米香香（午餐）；奶酱鲜鱼，土豆船（晚餐）」"
        },
        {
            "id": "732360105",
            "speaker": "「本周膳食」",
            "text": "「周三：番茄炖蛋，豆米糕（午餐）」"
        },
        {
            "id": "732360106",
            "speaker": "「本周膳食」",
            "text": "（剩余的部分都是空白的。）"
