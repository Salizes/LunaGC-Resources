    "speaker_counts": {
        "塔诺": 3,
        "波蒂莉": 5
    },
    "dialogues": [
        {
            "id": "660890101",
            "speaker": "塔诺",
            "text": "这个音色，听起来真不错。那位老兄搓碟的手法是不是越来越娴熟了？"
        },
        {
            "id": "660890102",
            "speaker": "波蒂莉",
            "text": "他的技术一直不错，但这次要归功于新唱片的压制工艺。"
        },
        {
            "id": "660890103",
            "speaker": "塔诺",
            "text": "哦哦，是我们上次聊过的，液态燃素的新用法吗？已经实现了？"
        },
        {
            "id": "660890104",
            "speaker": "波蒂莉",
            "text": "当然，小看我？"
        },
        {
            "id": "660890105",
            "speaker": "塔诺",
            "text": "哪有，这是为你高兴啊。"
        },
        {
            "id": "660890106",
            "speaker": "波蒂莉",
            "text": "还在试验阶段啦。我这不是在一边看演出，一边收集反馈嘛。"
        },
        {
            "id": "660890107",
            "speaker": "波蒂莉",
            "text": "嗯…碟片在回拉的时候，速度不是很好把控啊…"
        },
        {
            "id": "660890108",
            "speaker": "波蒂莉",
            "text": "看来还有改进空间。"
        }
    ]
}