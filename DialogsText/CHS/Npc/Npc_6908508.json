{
    "talkId": "6908508",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "菲米尼": 14
    },
    "dialogues": [
        {
            "id": "690850301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690850302",
            "speaker": "菲米尼",
            "text": "嗯…请说吧。"
        },
        {
            "id": "690850303",
            "speaker": "Player",
            "text": "聊聊佩伊怎么样？"
        },
        {
            "id": "690850304",
            "speaker": "菲米尼",
            "text": "…谢谢你，能够记住它的名字。",
            "choices": [
                {
                    "id": "690850305",
                    "text": "它的名字有什么来历吗？",
                    "response": [
                        {
                            "id": "690850307",
                            "speaker": "菲米尼",
                            "text": "要解释的话…就得提到很久很久以前，我在绘本上读到的故事了。"
                        },
                        {
                            "id": "690850308",
                            "speaker": "Player",
                            "text": "想听！"
                        },
                        {
                            "id": "690850309",
                            "speaker": "菲米尼",
                            "text": "嗯…说在遥远的海滨小镇，生活着一只黑白相间的海鸟。"
                        },
                        {
                            "id": "690850310",
                            "speaker": "菲米尼",
                            "text": "它生来就不会飞翔，走路歪歪扭扭，说话结结巴巴，因此遭到了其他海鸟的排挤。"
                        },
                        {
                            "id": "690850311",
                            "speaker": "菲米尼",
                            "text": "直到后来有一天，贪婪的海盗从水下宫殿偷走了镶满珍珠和黄金的冠冕…"
                        },
                        {
                            "id": "690850312",
                            "speaker": "菲米尼",
                            "text": "转眼间，电闪雷鸣，眼看海啸即将吞灭陆地…"
                        },
                        {
                            "id": "690850313",
                            "speaker": "菲米尼",
                            "text": "黑白的海鸟纵身一跃，却依旧无法飞翔…舍命之举使它撞断了桅杆，连同破船一起沉入海中。"
                        },
                        {
                            "id": "690850314",
                            "speaker": "菲米尼",
                            "text": "盘旋的海鸟都以为它会就此溺于水中，却没想到，在海里，它游得比谁都快。"
                        },
                        {
                            "id": "690850315",
                            "speaker": "菲米尼",
                            "text": "它游啊游，一直游到筋疲力尽。它终于将冠冕归还了原处。顷刻间风平浪静，仿佛一切都不曾发生。"
                        },
                        {
                            "id": "690850316",
                            "speaker": "菲米尼",
                            "text": "恐怕你已经猜到了…故事里的海鸟就叫「佩伊」，它是一只意外来到小镇的企鹅。",
                            "choices": [
                                {
                                    "id": "690850317",
                                    "text": "真是个不错的故事。",
                                    "response": [
                                        {
                                            "id": "690850320",
                                            "speaker": "菲米尼",
                                            "text": "我很崇敬故事里的「佩伊」，但读完之后，却深切地感到…它很孤独…"
                                        },
                                        {
                                            "id": "690850321",
                                            "speaker": "菲米尼",
                                            "text": "所以，我想跟它相互依偎，相互取暖…"
                                        }
                                    ]
                                },
                                {
                                    "id": "690850318",
                                    "text": "原来你是英雄的同伴！",
                                    "response": [
                                        {
                                            "id": "690850319",
                                            "speaker": "菲米尼",
                                            "text": "…哈，是啊。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690850306",
                    "text": "它为什么是这个外形呢？"
                }
            ]
        }
    ]
}