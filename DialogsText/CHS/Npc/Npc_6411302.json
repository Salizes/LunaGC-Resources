    "dialogues": [
        {
            "id": "641130201",
            "speaker": "Player",
            "text": "你是…"
        },
        {
            "id": "641130202",
            "speaker": "比塔",
            "text": "我只是一个平平无奇的码头工人，并不重要。"
        },
        {
            "id": "641130203",
            "speaker": "比塔",
            "text": "重要的…是我手上的货。"
        },
        {
            "id": "641130204",
            "speaker": "比塔",
            "text": "你看，这附近是哪？"
        },
        {
            "id": "641130205",
            "speaker": "比塔",
            "text": "是奥摩斯港！"
        },
        {
            "id": "641130206",
            "speaker": "比塔",
            "text": "港口的货，你还不明白吗？"
        },
        {
            "id": "641130207",
            "speaker": "比塔",
            "text": "如何，要看看不？"
        }
    ]
