    "speaker_counts": {
        "Player": 1,
        "诺拉": 5
    },
    "dialogues": [
        {
            "id": "616010301",
            "speaker": "Player",
            "text": "你在玩什么？"
        },
        {
            "id": "616010302",
            "speaker": "诺拉",
            "text": "诺拉喜欢在神像下面玩！"
        },
        {
            "id": "616010303",
            "speaker": "诺拉",
            "text": "神像又高又漂亮。"
        },
        {
            "id": "616010304",
            "speaker": "诺拉",
            "text": "你有爬到过上面去吗？那天诺拉想要爬上去，却被葛瑞丝阿姨训了。"
        },
        {
            "id": "616010305",
            "speaker": "诺拉",
            "text": "葛瑞丝阿姨是好人，诺拉不愿意再给她添麻烦。"
        },
        {
            "id": "616010306",
            "speaker": "诺拉",
            "text": "如果你能爬上去的话，就把上面的景色讲给诺拉听吧。"
        }
    ]
}