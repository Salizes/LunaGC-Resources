{
    "talkId": "7273007",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "「金龟奇术番长」": 10,
        "派蒙": 2
    },
    "dialogues": [
        {
            "id": "727300701",
            "speaker": "「金龟奇术番长」",
            "text": "不果断，不敏锐，不迅捷，不老练…还有提升的空间。",
            "choices": [
                {
                    "id": "727300702",
                    "text": "我们再跟你练练？",
                    "response": [
                        {
                            "id": "727300703",
                            "speaker": "「金龟奇术番长」",
                            "text": "还要来吗？"
                        },
                        {
                            "id": "727300704",
                            "speaker": "「金龟奇术番长」",
                            "text": "嗯…的确值得一试。那就开始吧！"
                        }
                    ]
                },
                {
                    "id": "727300705",
                    "text": "关于「花角玉将」…",
                    "response": [
                        {
                            "id": "727300706",
                            "speaker": "「金龟奇术番长」",
                            "text": "我的恩人？抱歉，我对他也不算了解。"
                        },
                        {
                            "id": "727300707",
                            "speaker": "「金龟奇术番长」",
                            "text": "我只知道，他对于鬼兜虫的艺术独具慧眼。"
                        },
                        {
                            "id": "727300708",
                            "speaker": "「金龟奇术番长」",
                            "text": "在我的「鬼兜虫奇术表演团」无人问津时，只有他一直来看我的表演，还能记住表演团里每一只鬼兜虫的名字。"
                        },
                        {
                            "id": "727300709",
                            "speaker": "「金龟奇术番长」",
                            "text": "虽说每次打赏给我的摩拉只够买到两碗「鳗肉茶泡饭」，但他也是我最大的、唯一的金主，所以我会无偿帮助他！"
                        },
                        {
                            "id": "727300710",
                            "speaker": "派蒙",
                            "text": "呜啊…原来你以前真的会训练鬼兜虫来表演节目？难怪之前说得话那么文雅…"
                        },
                        {
                            "id": "727300711",
                            "speaker": "派蒙",
                            "text": "那等到这场比试结束了，我们也来看看你的鬼兜虫演出吧！"
                        },
                        {
                            "id": "727300712",
                            "speaker": "「金龟奇术番长」",
                            "text": "哈哈…我已经破产好几年了，现在正另谋出路呢。"
                        },
                        {
                            "id": "727300713",
                            "speaker": "「金龟奇术番长」",
                            "text": "要是还有缘分，你们也许会在多年后听说「金龟奇术番长」这个名号的。"
                        }
                    ]
                },
                {
                    "id": "727300714",
                    "text": "再见了。",
                    "response": [
                        {
                            "id": "727300715",
                            "speaker": "「金龟奇术番长」",
                            "text": "嗯，以后再见。我还要好好思考一下进步的方法…"
                        }
                    ]
                }
            ]
        }
    ]
}