{
    "talkId": "6230902",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "阿佑": 8
    },
    "dialogues": [
        {
            "id": "623090201",
            "speaker": "Player",
            "text": "你在抓什么？"
        },
        {
            "id": "623090202",
            "speaker": "阿佑",
            "text": "我自己的影子，大家都告诉我是抓不到的，我哥哥也这么说。"
        },
        {
            "id": "623090203",
            "speaker": "阿佑",
            "text": "我哥哥是我见过最厉害的人，我想要什么他都可以弄到，可是就连他都抓不到自己的影子……"
        },
        {
            "id": "623090204",
            "speaker": "阿佑",
            "text": "一定有办法的，等我抓到了我的影子，我就和哥哥一样厉害了！",
            "choices": [
                {
                    "id": "623090205",
                    "text": "我来帮你吧。",
                    "response": [
                        {
                            "id": "623090206",
                            "speaker": "阿佑",
                            "text": "谢谢，但是我自己就可以做到。"
                        },
                        {
                            "id": "623090207",
                            "speaker": "阿佑",
                            "text": "我是家里被担心的最多的那一个，我不想要这样。"
                        },
                        {
                            "id": "623090208",
                            "speaker": "阿佑",
                            "text": "要是我和哥哥一样厉害，那爷爷还有在外面工作的爸爸妈妈就都会放心了吧！"
                        }
                    ]
                },
                {
                    "id": "623090209",
                    "text": "为什么不和哥哥一起玩？",
                    "response": [
                        {
                            "id": "623090210",
                            "speaker": "阿佑",
                            "text": "其实我很想跟他一起玩的，但我哥哥好像不愿意，他很忙，而且…我觉得他有点躲着我。"
                        },
                        {
                            "id": "623090211",
                            "speaker": "阿佑",
                            "text": "爷爷总是让我做一个懂事的妹妹，我不想给哥哥添麻烦。"
                        }
                    ]
                }
            ]
        }
    ]
}