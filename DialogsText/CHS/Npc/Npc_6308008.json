    "dialogues": [
        {
            "id": "630800801",
            "speaker": "Player",
            "text": "生意如何？"
        },
        {
            "id": "630800802",
            "speaker": "瓦希德",
            "text": "唔…怎么说呢…"
        },
        {
            "id": "630800803",
            "speaker": "瓦希德",
            "text": "本以为锁国令解除之后，生意会有很大起色，但实际上却没有好上太多。"
        },
        {
            "id": "630800804",
            "speaker": "瓦希德",
            "text": "来订购肥料的客户还是那老几位，而且他们还总是忘记使用方法…"
        },
        {
            "id": "630800805",
            "speaker": "瓦希德",
            "text": "客官，您要来点「丰沃之惠」吗？就当是旅行的纪念品，怎么样？"
        }
    ]
}