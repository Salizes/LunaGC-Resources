{
    "talkId": "6202502",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "畅畅": 8
    },
    "dialogues": [
        {
            "id": "620250201",
            "speaker": "Player",
            "text": "你好。"
        },
        {
            "id": "620250202",
            "speaker": "畅畅",
            "text": "嘿嘿，畅畅最懂礼貌了！你也是来等人的吗？",
            "choices": [
                {
                    "id": "620250203",
                    "text": "你一个人在这里吗？",
                    "response": [
                        {
                            "id": "620250204",
                            "speaker": "畅畅",
                            "text": "嗯！畅畅最懂事了，自己一个人玩也没问题！爷爷在那边的船厂上帮呢…上帮？上班…？上班！"
                        },
                        {
                            "id": "620250205",
                            "speaker": "畅畅",
                            "text": "畅畅不怕，这里的哥哥姐姐们都是好人…千岩军哥哥专门打坏人！"
                        }
                    ]
                },
                {
                    "id": "620250206",
                    "text": "你在玩什么呢？",
                    "response": [
                        {
                            "id": "620250207",
                            "speaker": "畅畅",
                            "text": "畅畅没有玩！畅畅做正事！"
                        },
                        {
                            "id": "620250208",
                            "speaker": "畅畅",
                            "text": "畅畅在等爸爸呢，爸爸多少天没回来了呢…"
                        },
                        {
                            "id": "620250209",
                            "speaker": "畅畅",
                            "text": "爸爸每次回来都会带好多好多好吃的和玩具…"
                        },
                        {
                            "id": "620250210",
                            "speaker": "畅畅",
                            "text": "上次是衣服，上上次是小小风车，上上上次是一大大大堆糖！"
                        },
                        {
                            "id": "620250211",
                            "speaker": "畅畅",
                            "text": "还有…上上上上次…是…好漂亮的瓷娃娃！还有还有…钩钩果蛋糕、起风就会发光的小瓶子、紫色的小沙漏…"
                        }
                    ]
                }
            ]
        }
    ]
}