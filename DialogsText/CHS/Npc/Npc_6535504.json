    "dialogues": [
        {
            "id": "653550401",
            "speaker": "Player",
            "text": "「卡皮托利姆」是？"
        },
        {
            "id": "653550402",
            "speaker": "韦尼尔",
            "text": "「卡皮托利姆」！当然是…是…是哪里来着？"
        },
        {
            "id": "653550403",
            "speaker": "韦尼尔",
            "text": "奇怪，我的嘴里为什么会冒出「卡皮托利姆」，好像这是我的故乡，家人也都在这里一样。"
        },
        {
            "id": "653550404",
            "speaker": "韦尼尔",
            "text": "唉，我已经没有家人了。"
        },
        {
            "id": "653550405",
            "speaker": "韦尼尔",
            "text": "如果「卡皮托利姆」是什么梦中的世界，或者死后的世界，希望我和她们在那里团聚吧！"
        }
    ]
}