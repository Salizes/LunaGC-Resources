{
    "talkId": "6717302",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 5,
        "嘉明": 12,
        "派蒙": 1
    },
    "dialogues": [
        {
            "id": "671730218",
            "speaker": "Black Screen",
            "text": "在柜台后站定不久，就有一位客人来访…"
        },
        {
            "id": "671730201",
            "speaker": "嘉明",
            "text": "#老板，我前些天找你订购的…哗！{NICKNAME}，派蒙，你们怎么在这里？",
            "choices": [
                {
                    "id": "671730202",
                    "text": "嘉明？",
                    "response": [
                        {
                            "id": "671730204",
                            "speaker": "嘉明",
                            "text": "不得了不得了，你们怎么在这里都有朋友？人脉简直比我们走镖的都广呀。"
                        },
                        {
                            "id": "671730205",
                            "speaker": "派蒙",
                            "text": "好了好了，接下来轮到我们问了。嘉明怎么来挪德卡莱了？璃月不是离这里超远吗？"
                        },
                        {
                            "id": "671730206",
                            "speaker": "嘉明",
                            "text": "这个啊，因为我有一个认识的叔叔住在这里，正好他们家长辈过寿辰。"
                        },
                        {
                            "id": "671730207",
                            "speaker": "嘉明",
                            "text": "老爷子很思念家乡，说不要金不要银，美味佳肴也不要，就想看一场璃月的舞兽戏。"
                        },
                        {
                            "id": "671730219",
                            "speaker": "嘉明",
                            "text": "但叔叔和家里那位长辈的年纪都很大了，回璃月是不可能了…所以，就来拜托我来挪德卡莱，给老爷子演一段。"
                        },
                        {
                            "id": "671730208",
                            "speaker": "嘉明",
                            "text": "正巧跑镖的兄弟们说，有一趟镖是送到挪德卡莱的，我就和他们一起过来了。"
                        },
                        {
                            "id": "671730209",
                            "speaker": "Player",
                            "text": "路上没遇见危险吧？"
                        },
                        {
                            "id": "671730210",
                            "speaker": "嘉明",
                            "text": "倒是遇见过几个劫道的小贼，被我们三两下就赶跑了，人和货都没事。"
                        },
                        {
                            "id": "671730211",
                            "speaker": "嘉明",
                            "text": "哎，说正事，我来这里是想要拜托奈芙尔老板帮我联系一下供货的人，帮我找一批上好的木材。"
                        },
                        {
                            "id": "671730212",
                            "speaker": "嘉明",
                            "text": "等木材到位，我就可以搭台子，开始演舞兽戏啦。",
                            "choices": [
                                {
                                    "id": "671730213",
                                    "text": "我记一下喔。",
                                    "response": [
                                        {
                                            "id": "671730215",
                                            "speaker": "嘉明",
                                            "text": "#好嘞，谢啦{NICKNAME}，等回了璃月，我请你吃…咦？好像有人在叫我…"
                                        },
                                        {
                                            "id": "671730216",
                                            "speaker": "嘉明",
                                            "text": "#哎呀，肯定是押镖的兄弟在找我，我先走了啊{NICKNAME}回头见！"
                                        },
                                        {
                                            "id": "671730217",
                                            "speaker": "嘉明",
                                            "text": "来了！来了！"
                                        }
                                    ]
                                },
                                {
                                    "id": "671730214",
                                    "text": "木材…嘉明…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "671730203",
                    "text": "帮朋友代班…"
                }
            ]
        }
    ]
}