{
    "talkId": "7012102",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "史蒂文斯": 15,
        "派蒙": 1
    },
    "dialogues": [
        {
            "id": "701210201",
            "speaker": "Player",
            "text": "我找到了这本日志…"
        },
        {
            "id": "701210202",
            "speaker": "史蒂文斯",
            "text": "嗯？在雪山上找到的？让我看看…"
        },
        {
            "id": "701210203",
            "speaker": "史蒂文斯",
            "text": "喔！这可真是了不得的宝藏。"
        },
        {
            "id": "701210204",
            "speaker": "Player",
            "text": "宝藏？"
        },
        {
            "id": "701210205",
            "speaker": "派蒙",
            "text": "宝藏！"
        },
        {
            "id": "701210206",
            "speaker": "史蒂文斯",
            "text": "…学术意义上的宝藏。"
        },
        {
            "id": "701210207",
            "speaker": "史蒂文斯",
            "text": "我以前游学的时候，曾经读过一些古老的年鉴。"
        },
        {
            "id": "701210208",
            "speaker": "史蒂文斯",
            "text": "一本年鉴上有记载，在骑士团的时代前，蒙德曾经有一支贵族向雪山派出了考察队。"
        },
        {
            "id": "701210209",
            "speaker": "史蒂文斯",
            "text": "但是不知道为什么，在那本年鉴里，关于那支考察团的事，并没有过多的细节记载…"
        },
        {
            "id": "701210210",
            "speaker": "史蒂文斯",
            "text": "如果这些考察日志真是那支考察队留下的，一定能成为重要的历史研究参考。"
        },
        {
            "id": "701210211",
            "speaker": "史蒂文斯",
            "text": "如果你愿意的话，能帮我再去雪山上搜索一下这些日志吗？",
            "choices": [
                {
                    "id": "701210212",
                    "text": "交给我吧！",
                    "response": [
                        {
                            "id": "701210213",
                            "speaker": "史蒂文斯",
                            "text": "真的吗？太感谢了！"
                        },
                        {
                            "id": "701210217",
                            "speaker": "史蒂文斯",
                            "text": "根据这篇日志…考察队为了考察，总共去了这座雪山里的三个地方…"
                        },
                        {
                            "id": "701210218",
                            "speaker": "史蒂文斯",
                            "text": "排除你们拿到日志的那一个，应该还有两个…"
                        },
                        {
                            "id": "701210219",
                            "speaker": "史蒂文斯",
                            "text": "我看看…这里…还有这里…嗯，我给你在地图上标记一下。"
                        },
                        {
                            "id": "701210220",
                            "speaker": "史蒂文斯",
                            "text": "那就拜托你了。一定要注意安全。"
                        }
                    ]
                },
                {
                    "id": "701210214",
                    "text": "如果有宝藏的话…",
                    "response": [
                        {
                            "id": "701210215",
                            "speaker": "史蒂文斯",
                            "text": "哈哈哈，物质意义上的宝藏不一定有。"
                        },
                        {
                            "id": "701210216",
                            "speaker": "史蒂文斯",
                            "text": "不过，如果你们肯帮忙。我也会准备好合适的…物质上的报酬，犒劳你对学术研究的伟大贡献。"
                        }
                    ]
                }
            ]
        }
    ]
}