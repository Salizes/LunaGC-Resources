    "dialogues": [
        {
            "id": "620930201",
            "speaker": "Player",
            "text": "您是在赏花？"
        },
        {
            "id": "620930202",
            "speaker": "萍姥姥",
            "text": "是啊，这花一代又一代，花谢又花开，生生不息，就和璃月一样。"
        },
        {
            "id": "620930203",
            "speaker": "萍姥姥",
            "text": "你看这边，还有这边，又新开了好几朵花…看来今年是个好年，一定会有好事发生的。"
        }
    ]
