    "dialogues": [
        {
            "id": "690820601",
            "speaker": "Player",
            "text": "晚安，白术。"
        },
        {
            "id": "690820602",
            "speaker": "白术",
            "text": "#晚安，{NICKNAME}。"
        },
        {
            "id": "690820603",
            "speaker": "白术",
            "text": "夜晚是身体休眠的时间，这时候睡觉是自然规律。不能总想着晚上不睡，白天补觉，这样不好。"
        },
        {
            "id": "690820604",
            "speaker": "白术",
            "text": "啊…不好意思，我没有指责你的意思。平时总跟病人说这些，成习惯了，你别在意。"
        }
    ]
}