{
    "talkId": "7051602",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 3,
        "派蒙": 3,
        "薇尔": 12
    },
    "dialogues": [
        {
            "id": "705160201",
            "speaker": "薇尔",
            "text": "嗯？这个时间点你们来找我，该不会是想从我这里购买情报吧？"
        },
        {
            "id": "705160202",
            "speaker": "薇尔",
            "text": "我最近很忙哦，有一位重要客户买下了我两周的工作时间。",
            "choices": [
                {
                    "id": "705160203",
                    "text": "重要客户？",
                    "response": [
                        {
                            "id": "705160204",
                            "speaker": "薇尔",
                            "text": "详情不能透露，总之他财力非常雄厚，你就别想着跟他竞争了。"
                        },
                        {
                            "id": "705160207",
                            "speaker": "派蒙",
                            "text": "奇怪，难道情报人员不应该…只有一个对接人吗？"
                        },
                        {
                            "id": "705160208",
                            "speaker": "薇尔",
                            "text": "情报生意也是生意，只发展一个合作伙伴，早晚会饿死的。"
                        },
                        {
                            "id": "705160209",
                            "speaker": "薇尔",
                            "text": "再说，就算是作风保守的骑士团，也有「对于大型行动，至少要保有两个情报源支持」的传统。"
                        },
                        {
                            "id": "705160210",
                            "speaker": "薇尔",
                            "text": "他们可是吃过情报不全的亏。所以从这点来说，我的工作非常重要哦。"
                        },
                        {
                            "id": "705160211",
                            "speaker": "薇尔",
                            "text": "比如，野外某个树丛里藏着深渊教团的伏兵，单凭一支侦察队不足以探清。"
                        },
                        {
                            "id": "705160212",
                            "speaker": "薇尔",
                            "text": "巡逻的骑士毫无戒备地路过，结果「哇！」地跳出来一只魔物，「砰！」地给他一棒。"
                        },
                        {
                            "id": "705160213",
                            "speaker": "Player",
                            "text": "为什么要用奇怪的拟声词…"
                        },
                        {
                            "id": "705160214",
                            "speaker": "薇尔",
                            "text": "我只是在描述客观事实，这样听起来更还原现场吧。"
                        },
                        {
                            "id": "705160215",
                            "speaker": "派蒙",
                            "text": "完全不对！魔物的叫声应该是「呀~」和「哐~」才对吧！"
                        },
                        {
                            "id": "705160216",
                            "speaker": "薇尔",
                            "text": "机灵一点嘛，你可以坚持自己的看法，把我给的情报当成备选方案。"
                        },
                        {
                            "id": "705160217",
                            "speaker": "派蒙",
                            "text": "欸？好像有道理哦…"
                        },
                        {
                            "id": "705160218",
                            "speaker": "薇尔",
                            "text": "话说回来，既然买家都要求多个情报源了，那情报交易员同时为多个客户服务，不是很正常的事吗？"
                        }
                    ]
                },
                {
                    "id": "705160205",
                    "text": "工作时间也能交易吗？",
                    "response": [
                        {
                            "id": "705160206",
                            "speaker": "薇尔",
                            "text": "当然了，工作本身就是在贩卖自己的劳动时间嘛，情报行业也是如此。"
                        }
                    ]
                }
            ]
        }
    ]
}