{
    "talkId": "6912802",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 9,
        "法尔伽": 11
    },
    "dialogues": [
        {
            "id": "691280201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691280202",
            "speaker": "法尔伽",
            "text": "习惯得不得了，「北风」在哪里都能找到适合自己的窝。",
            "choices": [
                {
                    "id": "691280203",
                    "text": "这还是「北风」吗…",
                    "response": [
                        {
                            "id": "691280205",
                            "speaker": "法尔伽",
                            "text": "动物为了生存会学着适应各种环境，我在远征前后也做过不少类似的事情。",
                            "choices": [
                                {
                                    "id": "691280206",
                                    "text": "远征之前？",
                                    "response": [
                                        {
                                            "id": "691280207",
                                            "speaker": "法尔伽",
                                            "text": "一些动物会躲藏在隐蔽的环境中来规避狩猎者，而那些躲藏地的条件往往不会有多好。"
                                        },
                                        {
                                            "id": "691280208",
                                            "speaker": "法尔伽",
                                            "text": "比如带刺的灌木丛、陡峭的绝壁…西风教会的塔尖、骑士团的屋顶…"
                                        },
                                        {
                                            "id": "691280209",
                                            "speaker": "Player",
                                            "text": "等等，最后两个不太对劲啊？"
                                        },
                                        {
                                            "id": "691280210",
                                            "speaker": "法尔伽",
                                            "text": "哈哈，那都是我逃出办公室之后的躲藏地啊！不过越到后来就越容易被抓住了。"
                                        },
                                        {
                                            "id": "691280211",
                                            "speaker": "法尔伽",
                                            "text": "现在嘛…大概得躲去风龙废墟的风墙里头，或者下着暴雪的龙脊雪山山顶…",
                                            "choices": [
                                                {
                                                    "id": "691280212",
                                                    "text": "还、还是待着这里吧…",
                                                    "response": [
                                                        {
                                                            "id": "691280214",
                                                            "speaker": "法尔伽",
                                                            "text": "多谢啦，不过枕头就不用了，睡得太踏实会影响警觉性和逃跑速度。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691280213",
                                                    "text": "需要的话再给你变个枕头。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691280215",
                                    "text": "远征之后？",
                                    "response": [
                                        {
                                            "id": "691280216",
                                            "speaker": "法尔伽",
                                            "text": "远征的路上多的是荒芜又危险的地界，有些时候也必须在里头扎营过夜。"
                                        },
                                        {
                                            "id": "691280217",
                                            "speaker": "法尔伽",
                                            "text": "虽然我们也带了行军床跟帐篷，但总会遇到来不及铺开的夜晚。"
                                        },
                                        {
                                            "id": "691280218",
                                            "speaker": "Player",
                                            "text": "大团长没有自己的大帐吗？"
                                        },
                                        {
                                            "id": "691280219",
                                            "speaker": "法尔伽",
                                            "text": "有倒是有，不过部下要挨冻的时候，待在那里头反而睡不踏实吧？所以我都是把它腾给伤员用的。"
                                        },
                                        {
                                            "id": "691280220",
                                            "speaker": "法尔伽",
                                            "text": "唉，要是那些时候，也有个这么方便的壶就好了。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691280204",
                    "text": "听着像是流浪动物…"
                }
            ]
        }
    ]
}