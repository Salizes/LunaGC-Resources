{
    "talkId": "7165812",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "云堇": 7
    },
    "dialogues": [
        {
            "id": "716581201",
            "speaker": "云堇",
            "text": "#{NICKNAME}，没想到能在轻策庄见到你。",
            "choices": [
                {
                    "id": "716581202",
                    "text": "就说城里找不到你…",
                    "response": [
                        {
                            "id": "716581204",
                            "speaker": "云堇",
                            "text": "承蒙关心。"
                        },
                        {
                            "id": "716581205",
                            "speaker": "云堇",
                            "text": "近日受若心前辈邀请，来轻策庄演出。虽说是唱给老人孩子听，但大家听得高兴，我也很是自豪。"
                        },
                        {
                            "id": "716581206",
                            "speaker": "Player",
                            "text": "若心前辈…？"
                        },
                        {
                            "id": "716581207",
                            "speaker": "云堇",
                            "text": "若心奶奶年轻时也是位角儿呢。如今见她，依然觉得神采奕奕。"
                        },
                        {
                            "id": "716581208",
                            "speaker": "云堇",
                            "text": "做这行就是这样，上台得时刻保持状态。现在是在台下，可以把这根弦略微松一松。"
                        },
                        {
                            "id": "716581209",
                            "speaker": "云堇",
                            "text": "我这儿有上好的茶叶，要不要喝杯茶再走？"
                        },
                        {
                            "id": "716581210",
                            "speaker": "云堇",
                            "text": "村子里看霄灯，也算别有风情。你若不嫌弃，我来慢慢为你说道。"
                        }
                    ]
                },
                {
                    "id": "716581203",
                    "text": "最近怎么样？"
                }
            ]
        }
    ]
}