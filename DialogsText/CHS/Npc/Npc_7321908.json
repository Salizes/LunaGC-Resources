{
    "talkId": "7321908",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 5,
        "阿德菲": 21
    },
    "dialogues": [
        {
            "id": "732190801",
            "speaker": "阿德菲",
            "text": "啊，是你。你来了。"
        },
        {
            "id": "732190802",
            "speaker": "阿德菲",
            "text": "芭别尔主母提起过你，你是我们的客人，请随便看看吧。",
            "choices": [
                {
                    "id": "732190803",
                    "text": "你是个商人？",
                    "response": [
                        {
                            "id": "732190804",
                            "speaker": "阿德菲",
                            "text": "嗯…？好眼力，我是个商人。负责为部落互通有无：化妆品、奢侈品、服装玩具、农产品、农具、精密小工具…"
                        },
                        {
                            "id": "732190805",
                            "speaker": "阿德菲",
                            "text": "你想要什么？我这里应有尽有。我这里没有什么？你尽管提，我都能为你搞到，无论是从城里，还是从枫丹。"
                        },
                        {
                            "id": "732190806",
                            "speaker": "阿德菲",
                            "text": "哦…你是外人，那么抱歉，我的商铺不对你开放。"
                        },
                        {
                            "id": "732190807",
                            "speaker": "阿德菲",
                            "text": "当然，你是我们的客人，所以在我的帐篷里看上什么，请随便拿吧…呃，别全都拿走就行！"
                        },
                        {
                            "id": "732190819",
                            "speaker": "Player",
                            "text": "你店里有好多书，我可以看看吗？"
                        },
                        {
                            "id": "732190820",
                            "speaker": "阿德菲",
                            "text": "嗯？书？哦！芭别尔主母的要求…近些时候城里人都开始流行在耳朵上戴「虚空」了，你一定见过那玩意。"
                        },
                        {
                            "id": "732190821",
                            "speaker": "阿德菲",
                            "text": "他们的图书馆淘汰了一大堆旧书，芭别尔主母就让我把它们收购回来细心存放，还让大家免费借阅。哼…赔钱买卖。"
                        },
                        {
                            "id": "732190822",
                            "speaker": "阿德菲",
                            "text": "至于「虚空」那玩意，我们也从别的部落手里进了一批…不好用，弄不懂。没法拆卸也没法维修，线路太集中化了…"
                        },
                        {
                            "id": "732190823",
                            "speaker": "阿德菲",
                            "text": "总之，自己多读书，总比依赖那种破玩意往你脑袋里塞知识要强得多。"
                        },
                        {
                            "id": "732190824",
                            "speaker": "阿德菲",
                            "text": "毕竟，要是轻易地把获取知识的渠道拱手让人了，谁知道他们会在你的脑子里装上什么样的后门呢？"
                        },
                        {
                            "id": "732190825",
                            "speaker": "Player",
                            "text": "再见。"
                        },
                        {
                            "id": "732190826",
                            "speaker": "阿德菲",
                            "text": "别让我挡了你的路。"
                        }
                    ]
                },
                {
                    "id": "732190808",
                    "text": "你都卖些什么？",
                    "response": [
                        {
                            "id": "732190809",
                            "speaker": "阿德菲",
                            "text": "开门见山，嗯？我喜欢这样的买家。不过抱歉，我不给外人卖东西。"
                        },
                        {
                            "id": "732190810",
                            "speaker": "阿德菲",
                            "text": "呃，不是我排外或者对你有成见，我该怎么说呢…我们部落，和城里的商人，并不共享一套经济圈，你明白我的话吧？"
                        },
                        {
                            "id": "732190811",
                            "speaker": "阿德菲",
                            "text": "我是只为塔尼特人服务的，是部落的商品分配人。所有交易和收益要向芭别尔主母负责，而我从中扣留一点利润。"
                        },
                        {
                            "id": "732190812",
                            "speaker": "阿德菲",
                            "text": "当然，你是我们的客人，所以在我的帐篷里看上什么，请随便拿吧…呃，别全都拿走就行！"
                        }
                    ]
                },
                {
                    "id": "732190813",
                    "text": "关于奔奔…",
                    "response": [
                        {
                            "id": "732190814",
                            "speaker": "阿德菲",
                            "text": "奔奔，啊，你是说这个跟在婕德身边的小机器。"
                        },
                        {
                            "id": "732190815",
                            "speaker": "阿德菲",
                            "text": "我已经做过检查了，没出什么特别的问题，不过，至于怎么让它恢复以前的活力…"
                        },
                        {
                            "id": "732190816",
                            "speaker": "阿德菲",
                            "text": "我有我自己的办法…不过这就不能告诉你了。"
                        },
                        {
                            "id": "732190817",
                            "speaker": "阿德菲",
                            "text": "总之，在修好之前，还是先把它放在我这儿吧。"
                        },
                        {
                            "id": "732190818",
                            "speaker": "阿德菲",
                            "text": "怎么了，还有什么别的事想问吗？"
                        }
                    ]
                }
            ]
        }
    ]
}