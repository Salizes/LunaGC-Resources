    "dialogues": [
        {
            "id": "618410201",
            "speaker": "Player",
            "text": "说说你的时代吧。"
        },
        {
            "id": "618410202",
            "speaker": "兴邦",
            "text": "与其说是时代，不如说是我自己的一些回忆吧。"
        },
        {
            "id": "618410203",
            "speaker": "兴邦",
            "text": "月光下的狐狸，荒野里试图摘下月亮当自己眼瞳的大骷髅…"
        },
        {
            "id": "618410204",
            "speaker": "兴邦",
            "text": "冬天的风，众神的长旅…"
        }
    ]
}