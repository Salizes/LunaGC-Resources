    "dialogues": [
        {
            "id": "631870201",
            "speaker": "Player",
            "text": "近来怎样？"
        },
        {
            "id": "631870202",
            "speaker": "阿妮萨",
            "text": "哈哈，不错不错！谢谢关心！"
        },
        {
            "id": "631870203",
            "speaker": "阿妮萨",
            "text": "这边气候也好，环境也不差，食物更美味。而且多亏了久美阿妹照顾，这段时间我每天都能打起精神一头钻进课题里！"
        },
        {
            "id": "631870204",
            "speaker": "阿妮萨",
            "text": "只不过…可能到处乱跑的我，有时也会让她担心吧。"
        },
        {
            "id": "631870205",
            "speaker": "阿妮萨",
            "text": "嘿嘿…还怪不好意思的。"
        }
    ]
}