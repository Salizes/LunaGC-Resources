    "dialogues": [
        {
            "id": "641350301",
            "speaker": "Player",
            "text": "你是…"
        },
        {
            "id": "641350302",
            "speaker": "沙普尔",
            "text": "哎呦，你都到门口了，还看不出我是谁吗？"
        },
        {
            "id": "641350303",
            "speaker": "沙普尔",
            "text": "我是旅店的老板，旅店的老板就是我。"
        },
        {
            "id": "641350304",
            "speaker": "沙普尔",
            "text": "哎，醒醒你看，不是我说，最近的年轻人注意力就是不行。"
        },
        {
            "id": "641350305",
            "speaker": "沙普尔",
            "text": "……"
        },
        {
            "id": "641350306",
            "speaker": "沙普尔",
            "text": "醒醒？醒醒！哎这胖猫，又去哪了？"
        }
    ]
