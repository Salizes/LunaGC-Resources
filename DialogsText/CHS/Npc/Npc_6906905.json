    "dialogues": [
        {
            "id": "690690501",
            "speaker": "Player",
            "text": "早啊，提纳里。"
        },
        {
            "id": "690690502",
            "speaker": "提纳里",
            "text": "早。一天之计在于晨，早起的鸟儿有虫吃。"
        },
        {
            "id": "690690503",
            "speaker": "提纳里",
            "text": "虽然早起的虫可能对此有异议吧，不过食物链就是这个样子啦。"
        },
        {
            "id": "690690504",
            "speaker": "提纳里",
            "text": "你看，树叶就算不早起也会被虫吃掉，但树叶也没处抱怨不是？"
        }
    ]
}