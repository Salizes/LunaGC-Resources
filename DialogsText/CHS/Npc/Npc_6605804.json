    "dialogues": [
        {
            "id": "660580401",
            "speaker": "Player",
            "text": "懂了，钱全靠你赚。"
        },
        {
            "id": "660580402",
            "speaker": "莉洛娅",
            "text": "总得有人来做啦。"
        },
        {
            "id": "660580403",
            "speaker": "莉洛娅",
            "text": "马努阿那家伙虽然经验丰富，但对首领有些溺爱。"
        },
        {
            "id": "660580404",
            "speaker": "莉洛娅",
            "text": "而且我看他最大的心愿大概是让首领赶紧成长起来吧，这样他就能快点退休去泡温泉咯。"
        },
        {
            "id": "660580405",
            "speaker": "莉洛娅",
            "text": "还好我很有耐心，可以慢慢帮他们把那些奇奇怪怪的主意转化成可以实现的样子。"
        }
    ]
}