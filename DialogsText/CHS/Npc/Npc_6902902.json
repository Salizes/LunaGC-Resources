{
    "talkId": "6902902",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "可莉": 9
    },
    "dialogues": [
        {
            "id": "690290201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690290202",
            "speaker": "可莉",
            "text": "这里很有趣！"
        },
        {
            "id": "690290203",
            "speaker": "可莉",
            "text": "有大大的房子，大大的空地。"
        },
        {
            "id": "690290204",
            "speaker": "可莉",
            "text": "有很多对可莉来说很新鲜的东西，从路的一头跑到另一头也要好久好久。",
            "choices": [
                {
                    "id": "690290205",
                    "text": "听上去可莉玩得很开心。",
                    "response": [
                        {
                            "id": "690290206",
                            "speaker": "可莉",
                            "text": "非常开心——"
                        },
                        {
                            "id": "690290207",
                            "speaker": "可莉",
                            "text": "#要是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}也有时间的话，可莉可以带你一起玩！"
                        },
                        {
                            "id": "690290212",
                            "speaker": "可莉",
                            "text": "抓蜥蜴、追青蛙、画画、做手工、捉迷藏…好玩的事情多着呢！"
                        }
                    ]
                },
                {
                    "id": "690290208",
                    "text": "可莉没有偷偷做坏事吧？",
                    "response": [
                        {
                            "id": "690290209",
                            "speaker": "可莉",
                            "text": "没有！绝对没有！"
                        },
                        {
                            "id": "690290210",
                            "speaker": "可莉",
                            "text": "#琴团长再三叮嘱可莉，说不能毁坏荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}的家。"
                        },
                        {
                            "id": "690290211",
                            "speaker": "可莉",
                            "text": "可莉就干脆什么宝物都不带啦。"
                        }
                    ]
                }
            ]
        }
    ]
}