    "dialogues": [
        {
            "id": "10213101",
            "speaker": "凝光",
            "text": "怎么，挑完了吗？"
        },
        {
            "id": "10213102",
            "speaker": "凝光",
            "text": "啊，决定了的话也不用问我，直接拿走就好。"
        },
        {
            "id": "10213103",
            "speaker": "凝光",
            "text": "然后，就在「群玉阁」坐一会、逛一逛吧。旅途当中的休息，也是很重要的一环。",
            "choices": [
                {
                    "id": "10213104",
                    "text": "多谢款待。",
                    "response": [
                        {
                            "id": "10213105",
                            "speaker": "凝光",
                            "text": "别这么客气，请随意些。"
                        }
                    ]
                },
                {
                    "id": "10213106",
                    "text": "是时候动身了，再见…",
                    "response": [
                        {
                            "id": "10213107",
                            "speaker": "凝光",
                            "text": "要走了么？也好。希望我们下次相遇时，你已经做了正确的事…或者将要作出正确的选择。"
                        }
                    ]
                }
            ]
        }
    ]
