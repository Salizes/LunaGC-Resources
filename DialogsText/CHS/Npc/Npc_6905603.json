{
    "talkId": "6905603",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "九条裟罗": 14
    },
    "dialogues": [
        {
            "id": "690560301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690560302",
            "speaker": "九条裟罗",
            "text": "闲来无事…既然你主动要求，当然可以。"
        },
        {
            "id": "690560303",
            "speaker": "九条裟罗",
            "text": "只是我多数时候都习惯独处，很少跟别人聊天，最好是你问我答。"
        },
        {
            "id": "690560304",
            "speaker": "九条裟罗",
            "text": "那就开始吧。",
            "choices": [
                {
                    "id": "690560305",
                    "text": "感觉像在考试，有点紧张。",
                    "response": [
                        {
                            "id": "690560306",
                            "speaker": "九条裟罗",
                            "text": "嗯？"
                        },
                        {
                            "id": "690560307",
                            "speaker": "九条裟罗",
                            "text": "你现在的表情，怎么跟我的部下汇报公务时一样…"
                        },
                        {
                            "id": "690560308",
                            "speaker": "九条裟罗",
                            "text": "不过我要提醒你，我从未将你当作部下。"
                        },
                        {
                            "id": "690560312",
                            "speaker": "Player",
                            "text": "唔…"
                        },
                        {
                            "id": "690560313",
                            "speaker": "九条裟罗",
                            "text": "唉，跟我聊天…是不是真的很困难。"
                        },
                        {
                            "id": "690560314",
                            "speaker": "九条裟罗",
                            "text": "其实，我最近也在学习与人相处的技巧，想着也许可以改变一下我严肃的形象。"
                        },
                        {
                            "id": "690560315",
                            "speaker": "九条裟罗",
                            "text": "但人与人之间的情感太过微妙和纤细，我很难在一时半会参透这些。"
                        },
                        {
                            "id": "690560316",
                            "speaker": "九条裟罗",
                            "text": "如果这种事情也像弓道一样，只要勤加练习，就能有所长进，那我还有些动力…"
                        },
                        {
                            "id": "690560317",
                            "speaker": "Player",
                            "text": "其实就是这样的。"
                        },
                        {
                            "id": "690560318",
                            "speaker": "九条裟罗",
                            "text": "唔…真的吗？"
                        },
                        {
                            "id": "690560319",
                            "speaker": "九条裟罗",
                            "text": "那么…就选你为我的练习对象吧！以后你就多来跟我聊聊天，应该没问题吧？"
                        }
                    ]
                },
                {
                    "id": "690560309",
                    "text": "你就没有想问我的吗？",
                    "response": [
                        {
                            "id": "690560310",
                            "speaker": "九条裟罗",
                            "text": "有是有…不过如果我问了，你就应该回答。"
                        },
                        {
                            "id": "690560311",
                            "speaker": "九条裟罗",
                            "text": "倘若你回答不出来，那就要接受相应的惩罚。做好觉悟了吗？"
                        }
                    ]
                }
            ]
        }
    ]
}