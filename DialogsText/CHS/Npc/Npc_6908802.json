{
    "talkId": "6908802",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "夏洛蒂": 9
    },
    "dialogues": [
        {
            "id": "690880201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690880202",
            "speaker": "夏洛蒂",
            "text": "这里的环境可太舒服了，而且光线特别好，无论从什么角度取景，都能拍出很好看的画片。"
        },
        {
            "id": "690880203",
            "speaker": "夏洛蒂",
            "text": "但是…我们其实是在那盏「茶壶」里，对吧？",
            "choices": [
                {
                    "id": "690880204",
                    "text": "对呀，你在担心什么吗？",
                    "response": [
                        {
                            "id": "690880205",
                            "speaker": "夏洛蒂",
                            "text": "也不算是担心啦。我就是在想…如果有人掀开这盏壶的盖子，往里面倒水的话…"
                        },
                        {
                            "id": "690880206",
                            "speaker": "夏洛蒂",
                            "text": "这里会发生怎样的情景呢？洪水？暴雨？还是说从底部突然开始涨水？"
                        },
                        {
                            "id": "690880207",
                            "speaker": "夏洛蒂",
                            "text": "#好想记录一下…{NICKNAME}，你能现在就去外面，往这盏壶里倒水吗？"
                        }
                    ]
                },
                {
                    "id": "690880208",
                    "text": "我不会用它泡茶的啦，放心。",
                    "response": [
                        {
                            "id": "690880209",
                            "speaker": "夏洛蒂",
                            "text": "欸？你没用过吗？真可惜，我还想问问你，用这种壶泡出来的茶是什么味道呢。"
                        },
                        {
                            "id": "690880210",
                            "speaker": "夏洛蒂",
                            "text": "我之前采访璃月人时听过一个传说。说是有位仙人曾经拿着一盏茶壶，用半条碧水河的水来泡茶…"
                        },
                        {
                            "id": "690880211",
                            "speaker": "夏洛蒂",
                            "text": "泡完茶后，这位仙人就把茶水重新倒回河里，所以碧水河的颜色才成了如今这样。"
                        },
                        {
                            "id": "690880212",
                            "speaker": "夏洛蒂",
                            "text": "也不知道传说是真是假…有机会的话，真想尝尝碧水河里有没有茶叶味呢。"
                        }
                    ]
                }
            ]
        }
    ]
}