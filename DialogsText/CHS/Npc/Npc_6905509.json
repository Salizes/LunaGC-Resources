{
    "talkId": "6905509",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "五郎": 10
    },
    "dialogues": [
        {
            "id": "690550201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690550202",
            "speaker": "五郎",
            "text": "嗯，当然！放心吧，我的适应力是很强的。"
        },
        {
            "id": "690550203",
            "speaker": "五郎",
            "text": "以前在军营里，哪怕枕着石头，或者躺在路边草地里都能休息。",
            "choices": [
                {
                    "id": "690550204",
                    "text": "会觉得这里的生活太松懈吗？",
                    "response": [
                        {
                            "id": "690550205",
                            "speaker": "五郎",
                            "text": "哈哈，不要这么说！"
                        },
                        {
                            "id": "690550206",
                            "speaker": "五郎",
                            "text": "一直紧绷着弓弦的话，它就会变得容易断裂。"
                        },
                        {
                            "id": "690550207",
                            "speaker": "五郎",
                            "text": "适当的放松，是为了更好地战斗。对我而言，这里的生活就是最好的调剂！"
                        },
                        {
                            "id": "690550211",
                            "speaker": "五郎",
                            "text": "对了，正好借这个机会，我想认真地向你表达我的感激，谢谢你！"
                        },
                        {
                            "id": "690550212",
                            "speaker": "五郎",
                            "text": "你对我那么真诚，让我心里特别温暖。"
                        },
                        {
                            "id": "690550213",
                            "speaker": "五郎",
                            "text": "不过，我也不会怠惰，随时都可以切换到备战和上阵的状态。不必担心！"
                        }
                    ]
                },
                {
                    "id": "690550208",
                    "text": "现在不用那么艰苦了…",
                    "response": [
                        {
                            "id": "690550209",
                            "speaker": "五郎",
                            "text": "唔，是啊…"
                        },
                        {
                            "id": "690550210",
                            "speaker": "五郎",
                            "text": "现在的轻松来之不易，我会好好珍惜的。"
                        }
                    ]
                }
            ]
        }
    ]
}