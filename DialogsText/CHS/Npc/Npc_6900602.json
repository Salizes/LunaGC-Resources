    "dialogues": [
        {
            "id": "690060201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690060701",
            "speaker": "丽莎",
            "text": "哦？你这是在关心我吗，小可爱。"
        },
        {
            "id": "690060702",
            "speaker": "丽莎",
            "text": "真让人感到温暖呢。"
        },
        {
            "id": "690060703",
            "speaker": "丽莎",
            "text": "放心，我很喜欢这里。",
            "choices": [
                {
                    "id": "690060704",
                    "text": "丽莎会想要「改建」一部分吗？",
                    "response": [
                        {
                            "id": "690060706",
                            "speaker": "丽莎",
                            "text": "没有哦。"
                        },
                        {
                            "id": "690060707",
                            "speaker": "丽莎",
                            "text": "我觉得它之所以特别，是因为这是小可爱你亲自搭建的。"
                        },
                        {
                            "id": "690060708",
                            "speaker": "丽莎",
                            "text": "如果我在旁指指点点，那就会削弱你的创意与韵味。"
                        },
                        {
                            "id": "690060709",
                            "speaker": "丽莎",
                            "text": "我可不想见到这种局面。"
                        }
                    ]
                },
                {
                    "id": "690060705",
                    "text": "丽莎有什么改进的建议吗？"
                }
            ]
        }
    ]
}