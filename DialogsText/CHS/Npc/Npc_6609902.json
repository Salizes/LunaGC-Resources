{
    "talkId": "6609902",
    "total_dialogue_lines": 6,
    "speaker_counts": {
        "Player": 1,
        "图达玛": 5
    },
    "dialogues": [
        {
            "id": "660990201",
            "speaker": "Player",
            "text": "可以送到国外吗？"
        },
        {
            "id": "660990202",
            "speaker": "图达玛",
            "text": "理论上来讲没什么问题。"
        },
        {
            "id": "660990203",
            "speaker": "图达玛",
            "text": "我本人要出纳塔比较困难，得向「大灵」提交好几轮申请，出门证还不一定能批下来…"
        },
        {
            "id": "660990204",
            "speaker": "图达玛",
            "text": "哈哈，不开玩笑了。"
        },
        {
            "id": "660990205",
            "speaker": "图达玛",
            "text": "如果有要寄到国外的信件，我们一般会送到纳塔边界，再交给外国的信使朋友们送走。"
        },
        {
            "id": "660990206",
            "speaker": "图达玛",
            "text": "总之交给我吧，一定能帮你送到！"
        }
    ]
}