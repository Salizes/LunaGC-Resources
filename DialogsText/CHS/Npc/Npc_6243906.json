    "dialogues": [
        {
            "id": "624390601",
            "speaker": "Player",
            "text": "我很好。"
        },
        {
            "id": "624390602",
            "speaker": "银杏",
            "text": "哦，那真是太好了！"
        },
        {
            "id": "624390603",
            "speaker": "银杏",
            "text": "我是这艘船的船医，水手们无论是晕船、风寒，还是截肢什么的都是由我来处理的。"
        },
        {
            "id": "624390604",
            "speaker": "银杏",
            "text": "所以我的医术你尽管放心，要是有什么不舒服的地方记得来找我哦！"
        },
        {
            "id": "624390605",
            "speaker": "银杏",
            "text": "当然，还是健健康康的最好啦。一定要记住，最危险的事，就是「对危险掉以轻心」！"
        }
    ]
}