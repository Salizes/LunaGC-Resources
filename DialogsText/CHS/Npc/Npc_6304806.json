    "dialogues": [
        {
            "id": "630480601",
            "speaker": "Player",
            "text": "好久不见，你还好吗？"
        },
        {
            "id": "630480602",
            "speaker": "黑泽京之介",
            "text": "我…唉，说不清。"
        },
        {
            "id": "630480603",
            "speaker": "黑泽京之介",
            "text": "失去的记忆大概永远回不来了。但我每每握住老爹留给我的刀，都能隐约感觉到过去的愿望曾经存在过的痕迹…"
        },
        {
            "id": "630480604",
            "speaker": "黑泽京之介",
            "text": "「仁义」之路，我还能重新走下去吗…"
        }
    ]
}