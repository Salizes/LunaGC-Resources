{
    "talkId": "6912804",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 11,
        "法尔伽": 15
    },
    "dialogues": [
        {
            "id": "691280401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691280402",
            "speaker": "法尔伽",
            "text": "嗯…想把留在挪德卡莱据点里的沙盘给带进来。",
            "choices": [
                {
                    "id": "691280403",
                    "text": "在这也要办公？",
                    "response": [
                        {
                            "id": "691280405",
                            "speaker": "法尔伽",
                            "text": "哈哈…那套沙盘一开始确实是为了做正经战术推演才带上的。"
                        },
                        {
                            "id": "691280406",
                            "speaker": "法尔伽",
                            "text": "后来为了培养骑士们的战术思维，我在闲暇时会把沙盘借出去给他们做假想训练用。"
                        },
                        {
                            "id": "691280407",
                            "speaker": "法尔伽",
                            "text": "其中一些骑士凑巧是「璃月千年」的爱好者，就拿出了自己珍藏的棋子来标识敌我，增强代入感。",
                            "choices": [
                                {
                                    "id": "691280408",
                                    "text": "「璃月千年」啊…",
                                    "response": [
                                        {
                                            "id": "691280410",
                                            "speaker": "法尔伽",
                                            "text": "再后来他们觉得假想训练不能局限于遭遇战，还要有敌人的动机、详尽的过程，要加上探索调查和交涉…"
                                        },
                                        {
                                            "id": "691280411",
                                            "speaker": "法尔伽",
                                            "text": "这时又有骑士提出可以参考枫丹的「桌上剧团」，就照那形式写了不少战役模组出来。"
                                        },
                                        {
                                            "id": "691280412",
                                            "speaker": "法尔伽",
                                            "text": "最好的地图、最好的棋子、最好的模组…结果你应该也猜得到。",
                                            "choices": [
                                                {
                                                    "id": "691280413",
                                                    "text": "这么好的配置…",
                                                    "response": [
                                                        {
                                                            "id": "691280415",
                                                            "speaker": "法尔伽",
                                                            "text": "嗨，「想象力」也是临敌应变的重要素质，能一边玩得开心，一边有所收获，那当然是最好不过。",
                                                            "choices": [
                                                                {
                                                                    "id": "691280416",
                                                                    "text": "老实说…",
                                                                    "response": [
                                                                        {
                                                                            "id": "691280418",
                                                                            "speaker": "法尔伽",
                                                                            "text": "……"
                                                                        },
                                                                        {
                                                                            "id": "691280419",
                                                                            "speaker": "Player",
                                                                            "text": "果然。"
                                                                        },
                                                                        {
                                                                            "id": "691280420",
                                                                            "speaker": "法尔伽",
                                                                            "text": "咳…这也不能算玩物丧志吧！我有好多计划都是这么推演出来的！"
                                                                        },
                                                                        {
                                                                            "id": "691280421",
                                                                            "speaker": "法尔伽",
                                                                            "text": "——而且他们总得找个又懂战场，又懂应变，最好还有点口才的人来主持流程？"
                                                                        },
                                                                        {
                                                                            "id": "691280422",
                                                                            "speaker": "Player",
                                                                            "text": "合着「主持人」就是你啊！"
                                                                        },
                                                                        {
                                                                            "id": "691280423",
                                                                            "speaker": "法尔伽",
                                                                            "text": "哈哈，「大团长」来当「带团长」，虽然像是喝酒喝多了大舌头，但也没什么不行的吧？"
                                                                        },
                                                                        {
                                                                            "id": "691280424",
                                                                            "speaker": "法尔伽",
                                                                            "text": "下次有团要一起来啊，荣誉骑士！"
                                                                        },
                                                                        {
                                                                            "id": "691280425",
                                                                            "speaker": "法尔伽",
                                                                            "text": "话又说回来，你这据点…是不是能当更豪华的沙盘地图来用？"
                                                                        },
                                                                        {
                                                                            "id": "691280426",
                                                                            "speaker": "法尔伽",
                                                                            "text": "就是得自己当棋子跑来跑去，再加上战斗…那不就成真练兵了吗？很难说是更有趣还是更累了啊…"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "691280417",
                                                                    "text": "你是不是也沉迷了？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691280414",
                                                    "text": "换我也想玩。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691280409",
                                    "text": "是那套很贵的战棋…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691280404",
                    "text": "这不像你啊！"
                }
            ]
        }
    ]
}