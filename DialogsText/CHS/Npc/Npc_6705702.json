    "dialogues": [
        {
            "id": "670570201",
            "speaker": "Player",
            "text": "你是指「旗舰」的工作？"
        },
        {
            "id": "670570202",
            "speaker": "奥梅索夫",
            "text": "啊不，我说的是「旗舰」里的愚人众招募官，那个叫克鲁切的家伙。他在里面招工，可千万别上当！"
        },
        {
            "id": "670570203",
            "speaker": "奥梅索夫",
            "text": "这是我的切身经历，报酬低也就算了，我有朋友去了之后就失踪了，我再也没见过他们。"
        }
    ]
}