    "dialogues": [
        {
            "id": "5000301",
            "speaker": "石门公告板",
            "text": "此为石门公告板，公告与来往客人留言皆可张贴此处。"
        },
        {
            "id": "5000302",
            "speaker": "留言",
            "text": "「天下日用，无奇不卖！」"
        },
        {
            "id": "5000303",
            "speaker": "留言",
            "text": "「有道是奇货可居，诸位过路客商如有需要，请尽管来荻花洲找我万货通！」"
        }
    ]
}