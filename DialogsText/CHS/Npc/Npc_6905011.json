{
    "talkId": "6905011",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "托马": 12
    },
    "dialogues": [
        {
            "id": "690500401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690500402",
            "speaker": "托马",
            "text": "嗯，我打算在这里找一个足够开阔的地方，然后…邀请你一起去看看天空。"
        },
        {
            "id": "690500403",
            "speaker": "托马",
            "text": "总觉得这里的天空比其他任何地方都要干净，都要…让人安心。"
        },
        {
            "id": "690500404",
            "speaker": "托马",
            "text": "我是说…稻妻的晚霞也不错啦，但要和这里相比的话，还是有些压抑嘛。",
            "choices": [
                {
                    "id": "690500405",
                    "text": "毕竟是在仙人的茶壶里。",
                    "response": [
                        {
                            "id": "690500406",
                            "speaker": "托马",
                            "text": "是啊，多么不可思议啊。天空和我们都被装在了茶壶里。"
                        },
                        {
                            "id": "690500409",
                            "speaker": "托马",
                            "text": "呼…"
                        },
                        {
                            "id": "690500410",
                            "speaker": "托马",
                            "text": "哪怕如此澄净的天空只是壶中茶水映出的幻影，能获得片刻安宁也是好事。"
                        },
                        {
                            "id": "690500411",
                            "speaker": "托马",
                            "text": "哈哈…我总是会把事情往好的地方想呢。",
                            "choices": [
                                {
                                    "id": "690500412",
                                    "text": "我很欣赏托马这一点。",
                                    "response": [
                                        {
                                            "id": "690500414",
                                            "speaker": "托马",
                                            "text": "哈哈哈…谢谢你。"
                                        },
                                        {
                                            "id": "690500415",
                                            "speaker": "托马",
                                            "text": "说真的，虽然你不太爱表达，但我能感觉到…你偶尔会流露出疲惫的情绪。"
                                        },
                                        {
                                            "id": "690500416",
                                            "speaker": "托马",
                                            "text": "既然来到了这里，就暂时放下烦恼，让自己的心休息一会儿吧。"
                                        },
                                        {
                                            "id": "690500417",
                                            "speaker": "托马",
                                            "text": "如果觉得寂寞，不要担心，你的身边还会有我陪伴。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690500413",
                                    "text": "所以托马也活得很开心。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690500407",
                    "text": "我明白。",
                    "response": [
                        {
                            "id": "690500408",
                            "speaker": "托马",
                            "text": "欸…真的吗？能和你有共同的感受，真是太好了。"
                        }
                    ]
                }
            ]
        }
    ]
}