    "dialogues": [
        {
            "id": "20010401",
            "speaker": "珠函",
            "text": "你的半决赛对手，名不见经传，却是一匹黑马。"
        },
        {
            "id": "20010402",
            "speaker": "珠函",
            "text": "我没有在质疑大英雄的实力，只是希望你能做好万全的准备。"
        },
        {
            "id": "20010403",
            "speaker": "派蒙",
            "text": "#这种水平的对决，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}没可能输的啦。",
            "choices": [
                {
                    "id": "20010404",
                    "text": "我准备好了。",
                    "response": [
                        {
                            "id": "20010405",
                            "speaker": "珠函",
                            "text": "好的，那我们进场吧。"
                        }
                    ]
                },
                {
                    "id": "20010406",
                    "text": "突然有点心虚。",
                    "response": [
                        {
                            "id": "20010407",
                            "speaker": "珠函",
                            "text": "没关系，调整好心态吧。"
                        }
                    ]
                }
            ]
        }
    ]
