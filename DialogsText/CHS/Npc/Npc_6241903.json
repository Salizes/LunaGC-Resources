    "dialogues": [
        {
            "id": "624190203",
            "speaker": "Player",
            "text": "星象？"
        },
        {
            "id": "624190204",
            "speaker": "紫微",
            "text": "没错！夜空中满天星斗排成阵列，绘出形象的时候，是我最好奇兴奋的时候。"
        },
        {
            "id": "624190205",
            "speaker": "紫微",
            "text": "这些星座就像是我收藏的宝贝，每多发现一个新的星座，我都要给它们起一个独一无二的名字！"
        }
    ]
}