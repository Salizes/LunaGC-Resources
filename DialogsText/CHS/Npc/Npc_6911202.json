{
    "talkId": "6911202",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "爱可菲": 11
    },
    "dialogues": [
        {
            "id": "691120201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691120202",
            "speaker": "爱可菲",
            "text": "嗯…像是回到了家，可以不用在乎客人的点餐要求，不用考虑店里的声誉，做些自己兴趣上排名前列的新料理。"
        },
        {
            "id": "691120203",
            "speaker": "爱可菲",
            "text": "我相信，你会为我准备一个专属厨房的，对吧？",
            "choices": [
                {
                    "id": "691120204",
                    "text": "你倒是完全不见外了！",
                    "response": [
                        {
                            "id": "691120206",
                            "speaker": "爱可菲",
                            "text": "呵~可不会让你吃亏！"
                        },
                        {
                            "id": "691120207",
                            "speaker": "爱可菲",
                            "text": "枫丹每天都有成百上千的名流贵客，挥舞着钱袋，想请我为他们的家宴添一道无与伦比的菜肴。"
                        },
                        {
                            "id": "691120208",
                            "speaker": "爱可菲",
                            "text": "我甚至没时间一一拒绝，有的信都不读不回。"
                        },
                        {
                            "id": "691120209",
                            "speaker": "爱可菲",
                            "text": "而你只需要准备灶台、炉具、橱柜和水源。厨具和食材我都自带了哦。"
                        },
                        {
                            "id": "691120210",
                            "speaker": "爱可菲",
                            "text": "全枫丹，甚至全提瓦特，都找不出第二个能获得这种待遇的人。"
                        },
                        {
                            "id": "691120211",
                            "speaker": "爱可菲",
                            "text": "而我想要的工资…就只是你在吃过料理后，做出的毫无保留的评价，越详细越好…",
                            "choices": [
                                {
                                    "id": "691120212",
                                    "text": "我不知道你烹饪的需求…",
                                    "response": [
                                        {
                                            "id": "691120214",
                                            "speaker": "爱可菲",
                                            "text": "不会的，我相信你的品味，也相信我们在料理领域的契合度。你尽管随你的喜好布置，必定能让我尽情发挥。"
                                        },
                                        {
                                            "id": "691120215",
                                            "speaker": "爱可菲",
                                            "text": "就像细腻的柔灯铃香与酸甜的虹彩蔷薇末，是绝佳的搭配。"
                                        },
                                        {
                                            "id": "691120216",
                                            "speaker": "爱可菲",
                                            "text": "我凭直觉为你准备的料理，绝对也会让你眼前一亮。"
                                        }
                                    ]
                                },
                                {
                                    "id": "691120213",
                                    "text": "要是我搭的厨房不合你的意呢？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691120205",
                    "text": "如你所愿，爱可菲主厨…"
                }
            ]
        }
    ]
}