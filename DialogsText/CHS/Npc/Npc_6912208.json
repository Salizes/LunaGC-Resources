{
    "talkId": "6912208",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 11,
        "奈芙尔": 20
    },
    "dialogues": [
        {
            "id": "691220301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691220302",
            "speaker": "奈芙尔",
            "text": "可以，想聊什么？是挪德卡莱赏金最高的通缉犯，还是黑市的通行口令？或者是…啊，你难不成是需要搞点好用的武器？"
        },
        {
            "id": "691220303",
            "speaker": "Player",
            "text": "就聊点日常什么的…"
        },
        {
            "id": "691220304",
            "speaker": "奈芙尔",
            "text": "嗯…这倒是稀奇，平时也没多少人和我聊过日常生活，你这个问题倒是把我难住了。"
        },
        {
            "id": "691220305",
            "speaker": "Player",
            "text": "你和雅珂达平时聊点什么？"
        },
        {
            "id": "691220306",
            "speaker": "奈芙尔",
            "text": "被她搞砸的委托，如何收拾这一桩被搞砸的委托，当然了，还有即将被她搞砸的委托。"
        },
        {
            "id": "691220307",
            "speaker": "奈芙尔",
            "text": "然后是工资，谁来看店，谁给阿舍鲁喂猫粮…"
        },
        {
            "id": "691220308",
            "speaker": "奈芙尔",
            "text": "啊，喂猫粮这个不用讨论，雅珂达都是抢着去的，阿舍鲁被她喂得都长胖了不少。"
        },
        {
            "id": "691220309",
            "speaker": "奈芙尔",
            "text": "我正在考虑向爱诺订个「跑猫轮」，让阿舍鲁减减肥呢。",
            "choices": [
                {
                    "id": "691220310",
                    "text": "除了雅珂达和阿舍鲁之外…",
                    "response": [
                        {
                            "id": "691220312",
                            "speaker": "奈芙尔",
                            "text": "朋友？那可多了，要是你也想认识一下我的那些「朋友」，我可以为你引荐。"
                        },
                        {
                            "id": "691220313",
                            "speaker": "Player",
                            "text": "听着不像什么正经朋友…"
                        },
                        {
                            "id": "691220314",
                            "speaker": "奈芙尔",
                            "text": "当然是正经朋友，那些先生女士可是我们「秘闻馆」的贵客，基于我们之间的友谊，往「秘闻馆」里投了不少钱。"
                        },
                        {
                            "id": "691220315",
                            "speaker": "奈芙尔",
                            "text": "至少在那些摩拉消耗殆尽之前，我们之间的友谊都坚不可摧。",
                            "choices": [
                                {
                                    "id": "691220316",
                                    "text": "这应该是客户吧！",
                                    "response": [
                                        {
                                            "id": "691220318",
                                            "speaker": "奈芙尔",
                                            "text": "在「秘闻馆」里，「客人」和「朋友」之间的界限并没有那么明确。"
                                        },
                                        {
                                            "id": "691220319",
                                            "speaker": "奈芙尔",
                                            "text": "毕竟，我们贩卖的货物看不见也摸不着，既没有到货日期，有时候也没有售后保障。"
                                        },
                                        {
                                            "id": "691220320",
                                            "speaker": "奈芙尔",
                                            "text": "要是没有坚实的「友谊」，还有从这份「友谊」里衍生出的「信任」，客人们怎么敢随便把宝贵的摩拉交给我呢？"
                                        },
                                        {
                                            "id": "691220321",
                                            "speaker": "Player",
                                            "text": "那这种「友谊」是怎么建立的？"
                                        },
                                        {
                                            "id": "691220322",
                                            "speaker": "奈芙尔",
                                            "text": "建立方式？嗯…其他的小技巧就不说了，但最重要的还是找到「共同点」。"
                                        },
                                        {
                                            "id": "691220323",
                                            "speaker": "奈芙尔",
                                            "text": "例如共同的爱好，共同的习惯，共同的朋友…或者是敌人。相同之处，就是友谊的源头，只要稍加扩展，就能让这个源头衍生出一条长河。"
                                        },
                                        {
                                            "id": "691220324",
                                            "speaker": "奈芙尔",
                                            "text": "当然，如果你能独自握住「源头」，那你就能把握住整条友谊之河。"
                                        },
                                        {
                                            "id": "691220325",
                                            "speaker": "奈芙尔",
                                            "text": "到时候，这条河究竟是清澈还是浑浊，是自由地奔流还是绝望地干涸…都由你说了算。",
                                            "choices": [
                                                {
                                                    "id": "691220326",
                                                    "text": "我不想控制友谊。",
                                                    "response": [
                                                        {
                                                            "id": "691220328",
                                                            "speaker": "奈芙尔",
                                                            "text": "嗯，看得出来，你的确这么想。这应该就是你讨人喜欢的地方了。"
                                                        },
                                                        {
                                                            "id": "691220329",
                                                            "speaker": "奈芙尔",
                                                            "text": "不过，凡事还是当心点好。我见过不少人对人奉上真心，却被人把真心卖了个好价钱。"
                                                        },
                                                        {
                                                            "id": "691220330",
                                                            "speaker": "奈芙尔",
                                                            "text": "如果之后遇见看不准的人，可以来问问我。我会帮你看看，哪些是知恩图报的忠犬，哪些是伺机噬咬你的毒蛇。"
                                                        },
                                                        {
                                                            "id": "691220331",
                                                            "speaker": "奈芙尔",
                                                            "text": "无论那条毒蛇将自己伪装成何物，都逃不过我的眼睛。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691220327",
                                                    "text": "友谊还是自然点好。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691220317",
                                    "text": "你刚刚自己都说「贵客」了…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691220311",
                    "text": "你在挪德卡莱有其他朋友吗？"
                }
            ]
        }
    ]
}