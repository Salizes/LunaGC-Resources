{
    "talkId": "6990034",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 7,
        "派蒙": 9
    },
    "dialogues": [
        {
            "id": "699003401",
            "speaker": "Player",
            "text": "关于学者…"
        },
        {
            "id": "699003402",
            "speaker": "派蒙",
            "text": "须弥城里真的有好多人希望成为学者呢。"
        },
        {
            "id": "699003403",
            "speaker": "派蒙",
            "text": "在这种愿望的推动下，他们都学习得好努力…"
        },
        {
            "id": "699003404",
            "speaker": "派蒙",
            "text": "不过，我觉得第一位学者的愿望肯定不是「成为学者」吧？"
        },
        {
            "id": "699003405",
            "speaker": "派蒙",
            "text": "唔…那第一位学者的愿望，到底会是什么呢…",
            "choices": [
                {
                    "id": "699003406",
                    "text": "我想，大概就是…",
                    "response": [
                        {
                            "id": "699003408",
                            "speaker": "派蒙",
                            "text": "欸？一般来说不都是，追求究极的，最最厉害的知识吗？"
                        },
                        {
                            "id": "699003409",
                            "speaker": "派蒙",
                            "text": "在这种求知欲的驱使下，渐渐成为第一位真正意义上的学者…"
                        },
                        {
                            "id": "699003410",
                            "speaker": "Player",
                            "text": "求知的具体方法就是论文啦。"
                        },
                        {
                            "id": "699003411",
                            "speaker": "派蒙",
                            "text": "可是，那个究极的，最最厉害的知识…"
                        },
                        {
                            "id": "699003412",
                            "speaker": "Player",
                            "text": "要证明这件事，也需要论文啦。",
                            "choices": [
                                {
                                    "id": "699003413",
                                    "text": "然后，为了证明你的论文…",
                                    "response": [
                                        {
                                            "id": "699003415",
                                            "speaker": "派蒙",
                                            "text": "好、好了啦！我知道了，不要露出这么难过的表情！你又不用写论文！"
                                        },
                                        {
                                            "id": "699003416",
                                            "speaker": "派蒙",
                                            "text": "你、你没写过吧…"
                                        }
                                    ]
                                },
                                {
                                    "id": "699003414",
                                    "text": "又要开始写另外一篇论文…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699003407",
                    "text": "「快点写完这篇论文」吧。"
                }
            ]
        }
    ]
}