{
    "talkId": "6910807",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "蓝砚": 9
    },
    "dialogues": [
        {
            "id": "691080201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691080202",
            "speaker": "蓝砚",
            "text": "当然不太习惯，跟我平时爱待的地方太不一样了。"
        },
        {
            "id": "691080203",
            "speaker": "Player",
            "text": "有哪里不满意吗？"
        },
        {
            "id": "691080204",
            "speaker": "蓝砚",
            "text": "欸？不不，你误会了，不是不满意的意思。"
        },
        {
            "id": "691080205",
            "speaker": "蓝砚",
            "text": "我说不习惯，指的是在这里很难保持平时的心境…"
        },
        {
            "id": "691080206",
            "speaker": "蓝砚",
            "text": "毕竟我还没住过这么奇妙的地方，说实话，直到这一刻我还很兴奋呢，心扑通乱跳。"
        },
        {
            "id": "691080207",
            "speaker": "Player",
            "text": "我家是挺大的。"
        },
        {
            "id": "691080208",
            "speaker": "蓝砚",
            "text": "对对…大是一方面，可最让人啧啧称奇的还要数你在布设上的巧思。"
        },
        {
            "id": "691080209",
            "speaker": "蓝砚",
            "text": "我家乡的山也很大，但我从来不会迷路。"
        },
        {
            "id": "691080210",
            "speaker": "蓝砚",
            "text": "刚刚我独自在周边逛了一下，得亏边走边留神着，不然可就找不着回来的路喽。"
        },
        {
            "id": "691080211",
            "speaker": "Player",
            "text": "没关系，我会来救你的！"
        },
        {
            "id": "691080212",
            "speaker": "蓝砚",
            "text": "嘻嘻，真的？"
        },
        {
            "id": "691080213",
            "speaker": "蓝砚",
            "text": "那你听见远处突然传来慌慌张张的银铃声时，要记得来找我哦？"
        }
    ]
}