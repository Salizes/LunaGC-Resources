{
    "talkId": "7181101",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "阿旭": 12
    },
    "dialogues": [
        {
            "id": "718110101",
            "speaker": "阿旭",
            "text": "这看起来照得还不错嘛，这什么「留影机」…"
        },
        {
            "id": "718110102",
            "speaker": "Player",
            "text": "什么「留影机」？"
        },
        {
            "id": "718110103",
            "speaker": "阿旭",
            "text": "哦，我们飞云商会从枫丹那边进了一批新商品，据说是那边的流行货。"
        },
        {
            "id": "718110104",
            "speaker": "阿旭",
            "text": "是一种…呃，按个按钮，就能把画面印在纸上的东西。"
        },
        {
            "id": "718110105",
            "speaker": "阿旭",
            "text": "名字是叫什么「留影机」…我玩起来倒是挺新鲜的，你听说过这东西吗？",
            "choices": [
                {
                    "id": "718110106",
                    "text": "有所耳闻。",
                    "response": [
                        {
                            "id": "718110108",
                            "speaker": "阿旭",
                            "text": "真的吗？不愧是旅行者啊，见识比我广多了。"
                        },
                        {
                            "id": "718110109",
                            "speaker": "阿旭",
                            "text": "这「留影机」啊，我们家少爷也喜欢得不行，说一定好卖。"
                        },
                        {
                            "id": "718110110",
                            "speaker": "阿旭",
                            "text": "但这玩意第一次开卖，我们心里也没底，所以就做了个试用的活动，周围的居民可以过来免费「留影」。"
                        },
                        {
                            "id": "718110111",
                            "speaker": "阿旭",
                            "text": "没想到反响还不错，不少居民还愿意付点小钱，让我们带着「留影机」过去给他们「留影」…"
                        },
                        {
                            "id": "718110112",
                            "speaker": "阿旭",
                            "text": "有的人还要我们好好给裱一裱再送过去，不过，最近来让我们上门留影的人真是越来越多了。"
                        },
                        {
                            "id": "718110113",
                            "speaker": "阿旭",
                            "text": "我本来想找少爷说说，但少爷又已经好几天不见踪影了。"
                        },
                        {
                            "id": "718110114",
                            "speaker": "阿旭",
                            "text": "我们也不好怠慢了顾客，所以就一直接待过来留影的人。人越来越多，我们都要接待不过来了。"
                        },
                        {
                            "id": "718110115",
                            "speaker": "阿旭",
                            "text": "旅行者，你能帮我个忙，把这两张留影机印出来的画给客人送过去吗？"
                        }
                    ]
                },
                {
                    "id": "718110107",
                    "text": "听说过类似的东西…"
                }
            ]
        }
    ]
}