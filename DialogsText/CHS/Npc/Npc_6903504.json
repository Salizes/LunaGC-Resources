{
    "talkId": "6903504",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "七七": 10
    },
    "dialogues": [
        {
            "id": "690350401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690350402",
            "speaker": "七七",
            "text": "想要养…小团雀。"
        },
        {
            "id": "690350403",
            "speaker": "七七",
            "text": "和你一起，在这个家里，养小团雀。"
        },
        {
            "id": "690350404",
            "speaker": "七七",
            "text": "你找来小谷子。我来喂小团雀。"
        },
        {
            "id": "690350405",
            "speaker": "七七",
            "text": "给它也搭一个窝，风吹不断，雨打不坏。"
        },
        {
            "id": "690350406",
            "speaker": "七七",
            "text": "白天，我陪它散步。睡前，一起做柔软体操。",
            "choices": [
                {
                    "id": "690350407",
                    "text": "七七就像姐姐一样呢。",
                    "response": [
                        {
                            "id": "690350409",
                            "speaker": "七七",
                            "text": "嗯！我会做好榜样。"
                        },
                        {
                            "id": "690350410",
                            "speaker": "七七",
                            "text": "我会保护它，也会保护你。",
                            "choices": [
                                {
                                    "id": "690350411",
                                    "text": "保护你们也是我的责任哦。",
                                    "response": [
                                        {
                                            "id": "690350413",
                                            "speaker": "七七",
                                            "text": "嗯！"
                                        },
                                        {
                                            "id": "690350414",
                                            "speaker": "七七",
                                            "text": "你，七七，小团雀…"
                                        },
                                        {
                                            "id": "690350415",
                                            "speaker": "七七",
                                            "text": "太好啦…"
                                        }
                                    ]
                                },
                                {
                                    "id": "690350412",
                                    "text": "那就要辛苦七七啦。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690350408",
                    "text": "一定会健康长大的。"
                }
            ]
        }
    ]
}