    "dialogues": [
        {
            "id": "710440101",
            "speaker": "沐宁",
            "text": "请问你是…？",
            "choices": [
                {
                    "id": "710440102",
                    "text": "你好…",
                    "response": [
                        {
                            "id": "710440104",
                            "speaker": "沐宁",
                            "text": "抱歉，层岩巨渊已经无限期关闭了，我们这里不欢迎访客。"
                        },
                        {
                            "id": "710440105",
                            "speaker": "沐宁",
                            "text": "除非…"
                        },
                        {
                            "id": "710440106",
                            "speaker": "Player",
                            "text": "除非…？"
                        },
                        {
                            "id": "710440107",
                            "speaker": "沐宁",
                            "text": "除非你能得到七星或玉京台的许可…或者受到了<color=#00E1FFFF>特别委托</color>。"
                        },
                        {
                            "id": "710440108",
                            "speaker": "沐宁",
                            "text": "不过近来日子比较特殊，大人物们都忙得自顾不暇…建议你还是不要叨扰，管好自己的事情为妙。"
                        },
                        {
                            "id": "710440109",
                            "speaker": "沐宁",
                            "text": "为了你自己的安全，还是请快点离开吧！"
                        }
                    ]
                },
                {
                    "id": "710440103",
                    "text": "我是…"
                }
            ]
        }
    ]
}