    },
    "dialogues": [
        {
            "id": "620850201",
            "speaker": "Player",
            "text": "请问你是…"
        },
        {
            "id": "620850202",
            "speaker": "小昭",
            "text": "如果是我的身份，我是璃月总务司的文员。"
        },
        {
            "id": "620850203",
            "speaker": "小昭",
            "text": "如果是我的名字，想搭讪的话请下班后。"
        },
        {
            "id": "620850204",
            "speaker": "Player",
            "text": "我想…"
        },
        {
            "id": "620850205",
            "speaker": "小昭",
            "text": "资格考试？报税？出海申请？船只停泊？"
        },
        {
            "id": "620850206",
            "speaker": "小昭",
            "text": "您想办什么业务？"
        },
        {
            "id": "620850207",
            "speaker": "小昭",
            "text": "麻烦快一点，再快一点。"
        },
        {
            "id": "620850208",
            "speaker": "小昭",
            "text": "接待您已经耗费了我很多时间了，我可不能把宝贵的时间浪费在你这种…"
        },
        {
            "id": "620850209",
            "speaker": "小昭",
            "text": "…没什么，没事我就叫下一位了。"
        }
    ]
}