{
    "talkId": "6911109",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 9,
        "瓦雷莎": 12
    },
    "dialogues": [
        {
            "id": "691110401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691110402",
            "speaker": "瓦雷莎",
            "text": "嗯，其实有一件事，我考虑好久了。正好，现在应该算是我们两人独处…"
        },
        {
            "id": "691110403",
            "speaker": "瓦雷莎",
            "text": "我，我要做好心理准备，鼓起勇气…",
            "choices": [
                {
                    "id": "691110404",
                    "text": "什…什么？",
                    "response": [
                        {
                            "id": "691110406",
                            "speaker": "瓦雷莎",
                            "text": "能请你…使出全力，和我战斗一场，切磋一下吗？"
                        },
                        {
                            "id": "691110407",
                            "speaker": "瓦雷莎",
                            "text": "你是现代英雄，当代传奇，我熟悉的…最强的人！还是我心目中的偶像，我希望赶上的榜样！"
                        },
                        {
                            "id": "691110408",
                            "speaker": "瓦雷莎",
                            "text": "我很想知道，自己的实力和火力全开的你之间究竟差着多远…",
                            "choices": [
                                {
                                    "id": "691110409",
                                    "text": "慢着？",
                                    "response": [
                                        {
                                            "id": "691110411",
                                            "speaker": "瓦雷莎",
                                            "text": "矛盾的是，就算知道你超级厉害，可以和神明打得有来有回，我还是害怕伤到你…因为我的战斗方式有点胡来。"
                                        },
                                        {
                                            "id": "691110412",
                                            "speaker": "瓦雷莎",
                                            "text": "怎么办，我脑袋里乱乱的…",
                                            "choices": [
                                                {
                                                    "id": "691110413",
                                                    "text": "就算是切磋，我也没法毫不留情哦。",
                                                    "response": [
                                                        {
                                                            "id": "691110415",
                                                            "speaker": "瓦雷莎",
                                                            "text": "呜…我明白了，我的这个要求太任性了…"
                                                        },
                                                        {
                                                            "id": "691110416",
                                                            "speaker": "瓦雷莎",
                                                            "text": "虽然没能和你交手，但不知道为什么，听了你的说法，感觉心里暖暖的…"
                                                        },
                                                        {
                                                            "id": "691110417",
                                                            "speaker": "瓦雷莎",
                                                            "text": "欸？那我们换个方法来切磋吧，比拼一下运动？",
                                                            "choices": [
                                                                {
                                                                    "id": "691110418",
                                                                    "text": "这个提议可行不少。",
                                                                    "response": [
                                                                        {
                                                                            "id": "691110420",
                                                                            "speaker": "瓦雷莎",
                                                                            "text": "那，那我们先用九万步的短跑和一半距离的游泳热身吧，然后准备五十块杠铃片，每块的重量都是标准成年突角龙的体重…"
                                                                        },
                                                                        {
                                                                            "id": "691110421",
                                                                            "speaker": "瓦雷莎",
                                                                            "text": "我开始期待了！你卧推杠铃时的力量感…一定很威风！"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "691110419",
                                                                    "text": "还好我一直在冒险中健身。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "691110414",
                                                    "text": "我和你一样，不想和朋友战斗。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "691110410",
                                    "text": "全力切磋？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691110405",
                    "text": "如此郑重…"
                }
            ]
        }
    ]
}