    "dialogues": [
        {
            "id": "722351301",
            "speaker": "Player",
            "text": "关于《白夜国水文考》"
        },
        {
            "id": "722351302",
            "speaker": "绘真",
            "text": "伊达这个蠢货！"
        },
        {
            "id": "722351303",
            "speaker": "绘真",
            "text": "这本书是白夜国望族家的公子借走的，得有好多年了吧。他的鸣神式名字叫做伊达，是欧律达忒之子。"
        },
        {
            "id": "722351304",
            "speaker": "绘真",
            "text": "他说要修建新时代的深海龙蜥防御工事什么的。其实就是想建迷宫玩吧。"
        },
        {
            "id": "722351305",
            "speaker": "绘真",
            "text": "啊，真羡慕有钱人家的孩子。"
        }
    ]
}