    "talkId": "6701605",
    "total_dialogue_lines": 6,
    "speaker_counts": {
        "Player": 2,
        "萨林": 4
    },
    "dialogues": [
        {
            "id": "670160501",
            "speaker": "Player",
            "text": "有什么特别委托吗？"
        },
        {
            "id": "670160502",
            "speaker": "萨林",
            "text": "特别的委托，只有在特殊的日子才会到达。"
        },
        {
            "id": "670160503",
            "speaker": "萨林",
            "text": "说起这个，今天外面下雪了么？"
        },
        {
            "id": "670160504",
            "speaker": "Player",
            "text": "下雪？没有啊。"
        },
        {
            "id": "670160505",
            "speaker": "萨林",
            "text": "这样啊…那么，送委托的使者今天不会来了。"
        },
        {
            "id": "670160506",
            "speaker": "萨林",
            "text": "感谢您对于协会的关注，如果想要接取特别委托的话，请择日再来吧。"
        }
    ]
}