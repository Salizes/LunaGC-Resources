    "dialogues": [
        {
            "id": "630480901",
            "speaker": "Player",
            "text": "好久不见，你还好吗？"
        },
        {
            "id": "630480902",
            "speaker": "黑泽京之介",
            "text": "眼狩令废除后，神之眼也回来了。我每每握住老爹留给我的刀，都能隐约感觉到过去的愿望在逐渐重燃…"
        },
        {
            "id": "630480903",
            "speaker": "黑泽京之介",
            "text": "「仁义」之路，果然还是要继续走下去…"
        }
    ]
}