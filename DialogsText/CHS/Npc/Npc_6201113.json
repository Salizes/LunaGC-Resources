    "dialogues": [
        {
            "id": "620111301",
            "speaker": "Player",
            "text": "想看摇滚演出。"
        },
        {
            "id": "620111302",
            "speaker": "范二爷",
            "text": "…是云老板叫你来的吗？"
        },
        {
            "id": "620111303",
            "speaker": "范二爷",
            "text": "这个云老板哟，每次想听个摇滚演出都得找借口，就怕他们戏社的老几位知道。"
        },
        {
            "id": "620111304",
            "speaker": "范二爷",
            "text": "我多大年纪的人了，还得跟她一起扯谎，每次都要对口供，跟秘密行动似的…"
        },
        {
            "id": "620111305",
            "speaker": "范二爷",
            "text": "嘿，想想还有点带劲。"
        }
    ]
}