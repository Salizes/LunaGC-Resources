{
    "talkId": "6990053",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 12,
        "派蒙": 9
    },
    "dialogues": [
        {
            "id": "699005301",
            "speaker": "Player",
            "text": "关于奇妙科技…",
            "choices": [
                {
                    "id": "699005302",
                    "text": "这么说来，现在的挪德卡莱…",
                    "response": [
                        {
                            "id": "699005304",
                            "speaker": "派蒙",
                            "text": "唔，没错。我们也有伊涅芙和普隆尼亚两个高级、精密、尖端的…科技产物？"
                        },
                        {
                            "id": "699005305",
                            "speaker": "派蒙",
                            "text": "唔，普隆尼亚就算了。这么称呼伊涅芙总感觉不太尊重，该换个什么说法呢？",
                            "choices": [
                                {
                                    "id": "699005306",
                                    "text": "震惊，喜欢给人取难听外号的派蒙…",
                                    "response": [
                                        {
                                            "id": "699005308",
                                            "speaker": "派蒙",
                                            "text": "喂！",
                                            "choices": [
                                                {
                                                    "id": "699005309",
                                                    "text": "这么说来…",
                                                    "response": [
                                                        {
                                                            "id": "699005311",
                                                            "speaker": "派蒙",
                                                            "text": "你这喜欢背后盘点战斗力的爱好比我取外号还要没礼貌吧！"
                                                        },
                                                        {
                                                            "id": "699005312",
                                                            "speaker": "派蒙",
                                                            "text": "不过确实呢，以现在大家的关系，让他们打一架似乎不太可能了。"
                                                        },
                                                        {
                                                            "id": "699005313",
                                                            "speaker": "派蒙",
                                                            "text": "就像是现在也没办法让琴团长和迪卢克老爷打一架一样。"
                                                        },
                                                        {
                                                            "id": "699005314",
                                                            "speaker": "Player",
                                                            "text": "你居然还记得这事…"
                                                        },
                                                        {
                                                            "id": "699005315",
                                                            "speaker": "Player",
                                                            "text": "咳咳，但是话又说回来，我有一个妙计。",
                                                            "choices": [
                                                                {
                                                                    "id": "699005316",
                                                                    "text": "把伊涅芙和普隆尼亚关在一个房间里…",
                                                                    "response": [
                                                                        {
                                                                            "id": "699005318",
                                                                            "speaker": "派蒙",
                                                                            "text": "呜啊！"
                                                                        },
                                                                        {
                                                                            "id": "699005319",
                                                                            "speaker": "Player",
                                                                            "text": "后被弄坏那个更加厉害！"
                                                                        },
                                                                        {
                                                                            "id": "699005320",
                                                                            "speaker": "派蒙",
                                                                            "text": "但是先坏掉的也可能是因为更加先进更加精密所以更加脆弱啊？"
                                                                        },
                                                                        {
                                                                            "id": "699005321",
                                                                            "speaker": "派蒙",
                                                                            "text": "不对，我们在想什么！"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "699005317",
                                                                    "text": "然后丢进去一个琳妮特——"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "699005310",
                                                    "text": "巅峰伊涅芙和全盛普隆尼亚谁比较厉害呢？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "699005307",
                                    "text": "居然会在这方面反省自己！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699005303",
                    "text": "同时有爱诺和桑多涅两个技术人才呢。"
                }
            ]
        }
    ]
}