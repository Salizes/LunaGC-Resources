{
    "talkId": "6990033",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "699003301",
            "speaker": "Player",
            "text": "关于健康之家…"
        },
        {
            "id": "699003302",
            "speaker": "派蒙",
            "text": "哇，须弥居然…还能免费看病吗！"
        },
        {
            "id": "699003303",
            "speaker": "Player",
            "text": "派蒙有哪里不舒服吗？"
        },
        {
            "id": "699003304",
            "speaker": "派蒙",
            "text": "现在还没有，谢谢你的关心。"
        },
        {
            "id": "699003305",
            "speaker": "派蒙",
            "text": "不过我从很久以前开始就一直想试试，一边吃冰棍一边吃火锅了！"
        },
        {
            "id": "699003306",
            "speaker": "Player",
            "text": "肯定会吃坏肚子吧！"
        },
        {
            "id": "699003307",
            "speaker": "派蒙",
            "text": "反正看病是免费的嘛，不看病不会觉得哪里亏了吗？",
            "choices": [
                {
                    "id": "699003308",
                    "text": "嗯…但是换个角度的话…",
                    "response": [
                        {
                            "id": "699003310",
                            "speaker": "派蒙",
                            "text": "欸！不能再吃好吃的了吗？"
                        },
                        {
                            "id": "699003311",
                            "speaker": "Player",
                            "text": "还会给派蒙开很苦的药。"
                        },
                        {
                            "id": "699003312",
                            "speaker": "派蒙",
                            "text": "好、好吧！那我再想想…"
                        }
                    ]
                },
                {
                    "id": "699003309",
                    "text": "治病的时候，饮食会被限制哦。"
                }
            ]
        }
    ]
}