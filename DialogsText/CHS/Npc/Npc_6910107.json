{
    "talkId": "6910107",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "基尼奇": 10,
        "阿乔": 5
    },
    "dialogues": [
        {
            "id": "691010201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691010202",
            "speaker": "基尼奇",
            "text": "嗯。环境不错，待着也舒适。"
        },
        {
            "id": "691010203",
            "speaker": "阿乔",
            "text": "我说基尼奇，你的衡量标准会不会低了一点？"
        },
        {
            "id": "691010204",
            "speaker": "阿乔",
            "text": "要我说，这陋室虽然也算有可圈可点之处，但比起我统辖的烈焰之国可就相形见绌喽。"
        },
        {
            "id": "691010205",
            "speaker": "阿乔",
            "text": "想当年，我库胡勒阿乔的城堡建在举国最高的地方，光是前来拜谒的仆从就不计其数。"
        },
        {
            "id": "691010206",
            "speaker": "阿乔",
            "text": "鲜红的果实被制成佳酿，财宝堆满华贵的宝匣…这还不过是我收到的万千进贡品中最寻常的两种。",
            "choices": [
                {
                    "id": "691010207",
                    "text": "那还真是了不起。",
                    "response": [
                        {
                            "id": "691010209",
                            "speaker": "基尼奇",
                            "text": "既然是伟大圣龙、至高领主，想必知道为客的礼仪？"
                        },
                        {
                            "id": "691010210",
                            "speaker": "阿乔",
                            "text": "哼…"
                        },
                        {
                            "id": "691010211",
                            "speaker": "基尼奇",
                            "text": "#{NICKNAME}，感谢你邀请我做客。"
                        },
                        {
                            "id": "691010212",
                            "speaker": "基尼奇",
                            "text": "餐风露宿的时候，我只需要一堆篝火，或是一处栖身的山洞。这里提供的不仅是安全，还有别处难以寻得的温馨。"
                        },
                        {
                            "id": "691010213",
                            "speaker": "基尼奇",
                            "text": "我应该给你怎样的回报？"
                        },
                        {
                            "id": "691010214",
                            "speaker": "Player",
                            "text": "不用客气的。"
                        },
                        {
                            "id": "691010215",
                            "speaker": "基尼奇",
                            "text": "这不是客气。我不想无偿接受你的好意，这是我的坚持。"
                        },
                        {
                            "id": "691010216",
                            "speaker": "基尼奇",
                            "text": "如果你对我有所期望，希望你能直言。我会根据情况考虑如何完成你的委托，那样事情更简单。"
                        },
                        {
                            "id": "691010217",
                            "speaker": "Player",
                            "text": "但我也没想好…"
                        },
                        {
                            "id": "691010218",
                            "speaker": "基尼奇",
                            "text": "好吧，我理解…那就先欠着。"
                        },
                        {
                            "id": "691010219",
                            "speaker": "基尼奇",
                            "text": "等你想好要什么，请随时和我说。"
                        },
                        {
                            "id": "691010220",
                            "speaker": "基尼奇",
                            "text": "当然，万一「价格」不合适，我会立刻告诉你的。"
                        }
                    ]
                },
                {
                    "id": "691010208",
                    "text": "让您屈尊了。"
                }
            ]
        }
    ]
}