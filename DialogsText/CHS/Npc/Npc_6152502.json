{
    "talkId": "6152502",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "薇尔": 10
    },
    "dialogues": [
        {
            "id": "615250201",
            "speaker": "Player",
            "text": "你刚在自言自语什么？"
        },
        {
            "id": "615250202",
            "speaker": "薇尔",
            "text": "哦，莎拉最近想进口点璃月原产辣椒，据说是能让蒙德最爱吃辣的芭芭拉都辣哭的品种。"
        },
        {
            "id": "615250203",
            "speaker": "薇尔",
            "text": "要我说，不符合86%的蒙德人的口味，费大半天力气进口了也很难卖出去吧。",
            "choices": [
                {
                    "id": "615250204",
                    "text": "芭芭拉喜欢吃辣？",
                    "response": [
                        {
                            "id": "615250205",
                            "speaker": "薇尔",
                            "text": "啊？原来你不知道吗？我以为全蒙德的人都知道呢。"
                        },
                        {
                            "id": "615250206",
                            "speaker": "Player",
                            "text": "请多说些「全蒙德知道」的事…"
                        },
                        {
                            "id": "615250207",
                            "speaker": "薇尔",
                            "text": "比如侦察骑士安柏，在骑士团聚会时自告奋勇做了烤肉排，结果烤糊到熏黑了骑士团厨房的房顶？"
                        },
                        {
                            "id": "615250208",
                            "speaker": "薇尔",
                            "text": "虽说安柏当时诚心诚意地拜托在场的每一个人，不要把这件事说出去…"
                        },
                        {
                            "id": "615250209",
                            "speaker": "薇尔",
                            "text": "但总之，差不多全蒙德都已经知道了，所以也不差你一个啦。"
                        }
                    ]
                },
                {
                    "id": "615250210",
                    "text": "你可以劝劝她。",
                    "response": [
                        {
                            "id": "615250211",
                            "speaker": "薇尔",
                            "text": "我劝过了，并没有用。"
                        },
                        {
                            "id": "615250212",
                            "speaker": "薇尔",
                            "text": "如果还想不出办法，就只能动用「那个男人」了。"
                        },
                        {
                            "id": "615250213",
                            "speaker": "薇尔",
                            "text": "常识来讲，以凯亚的话术，稍微旁敲侧击一下就搞定了吧。"
                        },
                        {
                            "id": "615250214",
                            "speaker": "薇尔",
                            "text": "咳咳，总之，谢谢你的关心了。"
                        }
                    ]
                }
            ]
        }
    ]
}