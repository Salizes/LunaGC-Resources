{
    "talkId": "6905703",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "荒泷一斗": 16
    },
    "dialogues": [
        {
            "id": "690570301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690570302",
            "speaker": "荒泷一斗",
            "text": "唔…唔…这件事的确很棘手…"
        },
        {
            "id": "690570303",
            "speaker": "Player",
            "text": "发生什么事情了？"
        },
        {
            "id": "690570304",
            "speaker": "荒泷一斗",
            "text": "这两天我重新在思考，我斗鬼兜虫之所以频频失利，或许是因为——我根本不适合干这件事。"
        },
        {
            "id": "690570305",
            "speaker": "荒泷一斗",
            "text": "也许是时候做出决断了…不该在无意义的事情上继续挣扎了…"
        },
        {
            "id": "690570306",
            "speaker": "Player",
            "text": "莫非你的意思是…"
        },
        {
            "id": "690570307",
            "speaker": "荒泷一斗",
            "text": "没错，我决定放弃斗鬼兜虫了！从今天开始，斗萤火虫吧！",
            "choices": [
                {
                    "id": "690570308",
                    "text": "也许不是虫子的问题…",
                    "response": [
                        {
                            "id": "690570309",
                            "speaker": "荒泷一斗",
                            "text": "怎么说？不斗虫子的话难道要斗猪斗鸟吗…也太困难了吧！"
                        },
                        {
                            "id": "690570310",
                            "speaker": "荒泷一斗",
                            "text": "不过你的分析也有道理，换一种虫子也不一定就能赢…"
                        },
                        {
                            "id": "690570314",
                            "speaker": "荒泷一斗",
                            "text": "哎，算了，说到底还是因为没有遇到合拍的虫子吧。嘁！默契的战友果然可遇不可求啊…"
                        },
                        {
                            "id": "690570315",
                            "speaker": "荒泷一斗",
                            "text": "幸好，你跟它们不一样，我一直都说我们才是最佳搭档！"
                        },
                        {
                            "id": "690570316",
                            "speaker": "Player",
                            "text": "不要把我当虫子啊！"
                        },
                        {
                            "id": "690570317",
                            "speaker": "荒泷一斗",
                            "text": "哈哈哈！开个玩笑开个玩笑！我当然没有这样想。"
                        },
                        {
                            "id": "690570318",
                            "speaker": "荒泷一斗",
                            "text": "如果真有无法避免的战斗，本大爷自然会站在你身前的。"
                        },
                        {
                            "id": "690570319",
                            "speaker": "荒泷一斗",
                            "text": "你呢，就在我身后，大声加油呐喊就行。记着，声音要越大越好，气势上绝不能输！"
                        },
                        {
                            "id": "690570320",
                            "speaker": "荒泷一斗",
                            "text": "唔…现在就只差一句惊艳四座的口号了…"
                        },
                        {
                            "id": "690570321",
                            "speaker": "荒泷一斗",
                            "text": "让我想想…这句怎么样？「一斗一斗，战无敌手」！"
                        },
                        {
                            "id": "690570322",
                            "speaker": "荒泷一斗",
                            "text": "来，要不要现在就喊喊看？"
                        }
                    ]
                },
                {
                    "id": "690570311",
                    "text": "也许是人的问题…",
                    "response": [
                        {
                            "id": "690570312",
                            "speaker": "荒泷一斗",
                            "text": "人的问题…嘶…不可能，绝对不可能！"
                        },
                        {
                            "id": "690570313",
                            "speaker": "荒泷一斗",
                            "text": "跟我斗虫的都是些小孩子，他们虽然叽叽喳喳，有些还喜欢搞恶作剧，但绝不会作弊的！"
                        }
                    ]
                }
            ]
        }
    ]
}