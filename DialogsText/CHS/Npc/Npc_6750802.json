    "speaker_counts": {
        "Player": 1,
        "彼塞姆斯基": 4
    },
    "dialogues": [
        {
            "id": "675080201",
            "speaker": "Player",
            "text": "什么意思？"
        },
        {
            "id": "675080202",
            "speaker": "彼塞姆斯基",
            "text": "我在回味昨晚的演出。"
        },
        {
            "id": "675080203",
            "speaker": "彼塞姆斯基",
            "text": "您看，传统的至冬歌剧往往侧重于宏大的悲剧，用繁复的唱词填补情感的空白…"
        },
        {
            "id": "675080204",
            "speaker": "彼塞姆斯基",
            "text": "但奥黛塔小姐与沃雅妮莎小姐的演出，则摒弃了那些冗余的表达——优雅！何等优雅！"
        },
        {
            "id": "675080205",
            "speaker": "彼塞姆斯基",
            "text": "尤其是奥黛塔小姐的步法——与其说是「舞」，不如说是「武」。您明白吧？"
        }
    ]
}