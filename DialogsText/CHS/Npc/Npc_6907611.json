{
    "talkId": "6907611",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "珐露珊": 17
    },
    "dialogues": [
        {
            "id": "690760401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690760402",
            "speaker": "珐露珊",
            "text": "唔…我正头疼住在沙漠的小朋友会喜欢些什么…零食还是玩具呢…"
        },
        {
            "id": "690760403",
            "speaker": "珐露珊",
            "text": "有空吗？给我点建议？"
        },
        {
            "id": "690760404",
            "speaker": "Player",
            "text": "前辈要去沙漠？"
        },
        {
            "id": "690760405",
            "speaker": "珐露珊",
            "text": "嗯。有位同僚前阵子离开了教令院，回到了沙漠任教，最近我收到她的来信。"
        },
        {
            "id": "690760406",
            "speaker": "珐露珊",
            "text": "她问我有没有兴趣去那边转一转，顺便给孩子们上几节识字课…"
        },
        {
            "id": "690760407",
            "speaker": "Player",
            "text": "好事，可以招新学生！"
        },
        {
            "id": "690760408",
            "speaker": "珐露珊",
            "text": "哈哈，你还替我记着这事呢？"
        },
        {
            "id": "690760409",
            "speaker": "珐露珊",
            "text": "此行的目的，只是给他们科普一些简单和常用的字符知识。"
        },
        {
            "id": "690760410",
            "speaker": "珐露珊",
            "text": "让他们能够更轻松地阅读，帮助自己挖掘更多感兴趣的东西…"
        },
        {
            "id": "690760411",
            "speaker": "珐露珊",
            "text": "现在播撒的种子，也许会在未来生根发芽，长成参天大树。这就够了。"
        },
        {
            "id": "690760412",
            "speaker": "珐露珊",
            "text": "至于他们以后有没有选择我的研究方向…那就得看他们的悟性了，对吧？",
            "choices": [
                {
                    "id": "690760413",
                    "text": "其实还是会期待的吧？",
                    "response": [
                        {
                            "id": "690760414",
                            "speaker": "珐露珊",
                            "text": "哼，这就敢揣摩前辈心理了，胆子大起来了嘛？"
                        },
                        {
                            "id": "690760417",
                            "speaker": "珐露珊",
                            "text": "但前辈我今天不跟你计较，还有准备工作没做完呢。"
                        },
                        {
                            "id": "690760418",
                            "speaker": "珐露珊",
                            "text": "准备工作…啊！糟了！"
                        },
                        {
                            "id": "690760419",
                            "speaker": "Player",
                            "text": "怎么了？！"
                        },
                        {
                            "id": "690760420",
                            "speaker": "珐露珊",
                            "text": "突然想起前不久教令院针对「外出开课」出台了新规则，要填一大堆申请材料呢。"
                        },
                        {
                            "id": "690760421",
                            "speaker": "珐露珊",
                            "text": "啧…真麻烦。"
                        },
                        {
                            "id": "690760422",
                            "speaker": "珐露珊",
                            "text": "算了，不管了，等他们发现后我就说我记性差忘记了，反正他们也拿我没办法。"
                        },
                        {
                            "id": "690760423",
                            "speaker": "珐露珊",
                            "text": "还是干正事要紧，走吧，陪我买礼物去？零食和玩具…就全买上好了。"
                        }
                    ]
                },
                {
                    "id": "690760415",
                    "text": "总不会那时候还没学生吧？",
                    "response": [
                        {
                            "id": "690760416",
                            "speaker": "珐露珊",
                            "text": "哼，这就敢嘲笑前辈了，胆子大起来了嘛？"
                        }
                    ]
                }
            ]
        }
    ]
}