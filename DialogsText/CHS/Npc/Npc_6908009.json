{
    "talkId": "6908009",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "米卡": 12
    },
    "dialogues": [
        {
            "id": "690800201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690800202",
            "speaker": "米卡",
            "text": "嗯，我很开心！"
        },
        {
            "id": "690800203",
            "speaker": "米卡",
            "text": "这里真的好奇妙，风景优美，宁静平和，还有我从没见过的奇观…"
        },
        {
            "id": "690800204",
            "speaker": "米卡",
            "text": "走遍提瓦特，也找不到第二个这样的好地方了吧？"
        },
        {
            "id": "690800205",
            "speaker": "米卡",
            "text": "就算只给我一个小帐篷，我也能在这里安心地住下去。"
        },
        {
            "id": "690800206",
            "speaker": "米卡",
            "text": "啊…不过，要是在外边露营，我可能要借用一点木材，用来做篝火…",
            "choices": [
                {
                    "id": "690800207",
                    "text": "不用篝火，这里冬暖夏凉！",
                    "response": [
                        {
                            "id": "690800209",
                            "speaker": "米卡",
                            "text": "太，太麻烦你了…"
                        },
                        {
                            "id": "690800210",
                            "speaker": "米卡",
                            "text": "那…如果有什么家务活，请尽管让我来做吧！"
                        },
                        {
                            "id": "690800211",
                            "speaker": "米卡",
                            "text": "我以前经常打理屋子和院子，应该还没生疏…",
                            "choices": [
                                {
                                    "id": "690800212",
                                    "text": "米卡是客人哦。",
                                    "response": [
                                        {
                                            "id": "690800214",
                                            "speaker": "米卡",
                                            "text": "呜…感觉好安心…太谢谢你了！"
                                        },
                                        {
                                            "id": "690800215",
                                            "speaker": "米卡",
                                            "text": "要是我再啰嗦，也许你会觉得我太见外，反而扫了你的兴…"
                                        },
                                        {
                                            "id": "690800216",
                                            "speaker": "米卡",
                                            "text": "那我就不客气了，我想用心观察这里的一切…争取理解你布置景观的理念！"
                                        },
                                        {
                                            "id": "690800217",
                                            "speaker": "米卡",
                                            "text": "这样一来，如果你需要我帮忙，我就能及时派上用场了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690800213",
                                    "text": "客人只需要享受就好啦。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690800208",
                    "text": "我当然会为你安排妥当！"
                }
            ]
        }
    ]
}