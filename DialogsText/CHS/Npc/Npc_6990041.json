{
    "talkId": "6990041",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699004101",
            "speaker": "Player",
            "text": "关于枫丹科学院的神秘宝藏…"
        },
        {
            "id": "699004102",
            "speaker": "派蒙",
            "text": "枫丹科学院是研究发条机关和各种能量的学术机构对吧？为什么会有神秘宝藏的传闻…"
        },
        {
            "id": "699004103",
            "speaker": "派蒙",
            "text": "如果是什么怪盗的宝藏、海贼的宝藏，倒是比较容易理解啦。"
        },
        {
            "id": "699004104",
            "speaker": "派蒙",
            "text": "研究员的宝藏、高阶技官的宝藏…总觉得听起来缺少冲击力…",
            "choices": [
                {
                    "id": "699004105",
                    "text": "如果有人白天是研究员，晚上是怪盗…",
                    "response": [
                        {
                            "id": "699004107",
                            "speaker": "派蒙",
                            "text": "唔…听起来好辛苦的样子…白天也要工作，晚上也要工作，那什么时候才能休息啊？",
                            "choices": [
                                {
                                    "id": "699004108",
                                    "text": "也许这位神秘人物的真实身份是发条机关…",
                                    "response": [
                                        {
                                            "id": "699004110",
                                            "speaker": "派蒙",
                                            "text": "白天是研究员，晚上是怪盗的神秘发条机关留下的神秘宝藏…听起来真的很神秘呢！"
                                        }
                                    ]
                                },
                                {
                                    "id": "699004109",
                                    "text": "这样就不用休息了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699004106",
                    "text": "这种神秘人物留下的神秘宝藏呢？"
                }
            ]
        }
    ]
}