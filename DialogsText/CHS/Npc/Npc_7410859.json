    "dialogues": [
        {
            "id": "741085901",
            "speaker": "Player",
            "text": "关于附近…"
        },
        {
            "id": "741085902",
            "speaker": "爱贝尔",
            "text": "嗯！我们已经抵达了目的地「海露站」，也就是「海露港」！严格来说，海露站是海露港的一部分，专指这条线路的站点！"
        },
        {
            "id": "741085903",
            "speaker": "爱贝尔",
            "text": "除此之外嘛…嗯…"
        },
        {
            "id": "741085904",
            "speaker": "爱贝尔",
            "text": "#（怎么办！官方导览手册里什么都没写！呃呃…爱贝尔，你可不能让乘客{M#先生}{F#小姐}失望！快想！）"
        },
        {
            "id": "741085905",
            "speaker": "爱贝尔",
            "text": "这里…还有著名的大瀑布！您看！水很多，所以瀑布很大！瀑布很大，所以流下去的水就很多！流下去的水越多，水就越少…？"
        },
        {
            "id": "741085906",
            "speaker": "爱贝尔",
            "text": "欸？欸？"
        }
    ]
}