    "dialogues": [
        {
            "id": "677000501",
            "speaker": "Player",
            "text": "尾…尾巴…"
        },
        {
            "id": "677000502",
            "speaker": "索菲亚",
            "text": "咦，你想摸尾巴吗…啊，真的想摸？"
        },
        {
            "id": "677000503",
            "speaker": "索菲亚",
            "text": "那…那好吧！"
        },
        {
            "id": "677000504",
            "speaker": "Black Screen",
            "text": "尾巴上全是晶石！根本不好摸！"
        },
        {
            "id": "677000505",
            "speaker": "索菲亚",
            "text": "怎么样，毛茸茸的毛发全都长出了晶石，所以摸上去刺刺的，这可是很了不起的妖精的象征哦。"
        },
        {
            "id": "677000506",
            "speaker": "索菲亚",
            "text": "欸，你怎么一副「上当受骗」了的表情啊…"
        }
    ]
}