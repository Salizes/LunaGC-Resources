    "dialogues": [
        {
            "id": "622630501",
            "speaker": "Player",
            "text": "关于岩上茶室的情况…"
        },
        {
            "id": "622630502",
            "speaker": "前韵",
            "text": "感谢关心。"
        },
        {
            "id": "622630503",
            "speaker": "前韵",
            "text": "自从老板接手茶室并将愚人众和嗜赌之人一并驱逐后，茶室就清朗了不少。"
        },
        {
            "id": "622630504",
            "speaker": "前韵",
            "text": "如今的岩上茶室，绝对配得上璃月港内第一的名头。"
        },
        {
            "id": "622630505",
            "speaker": "前韵",
            "text": "若您要在璃月港找个休憩处的话，还请务必试试我们岩上茶室。"
        }
    ]
}