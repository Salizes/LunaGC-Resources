    "speaker_counts": {
        "Player": 2,
        "塔尔诺": 3
    },
    "dialogues": [
        {
            "id": "670060801",
            "speaker": "Player",
            "text": "有什么特别的宝贝吗？"
        },
        {
            "id": "670060802",
            "speaker": "塔尔诺",
            "text": "…特别的宝贝？那当然了，本会的商品包罗万象，无奇不有。但想拿到它们，客人就需要带一些特别的东西来交换了。"
        },
        {
            "id": "670060803",
            "speaker": "塔尔诺",
            "text": "让我看看…啊，本店正急需几缕来自「北方的风」。"
        },
        {
            "id": "670060804",
            "speaker": "Player",
            "text": "「北方的风」？"
        },
        {
            "id": "670060805",
            "speaker": "塔尔诺",
            "text": "正是。待到客人捕捉到风之后，就请再来店里吧，我会静候您的光临。"
        }
    ]
}