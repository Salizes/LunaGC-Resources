{
    "talkId": "6902004",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "雷泽": 13
    },
    "dialogues": [
        {
            "id": "690200401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690200901",
            "speaker": "雷泽",
            "text": "我想，帮你看守。",
            "choices": [
                {
                    "id": "690200902",
                    "text": "是要看守我吗？",
                    "response": [
                        {
                            "id": "690200903",
                            "speaker": "雷泽",
                            "text": "不对…你很强。不用看守。"
                        },
                        {
                            "id": "690200904",
                            "speaker": "雷泽",
                            "text": "我想，看守。「家」。"
                        },
                        {
                            "id": "690200907",
                            "speaker": "雷泽",
                            "text": "这里，一开始是你的家。"
                        },
                        {
                            "id": "690200908",
                            "speaker": "雷泽",
                            "text": "我只是来，做客。"
                        },
                        {
                            "id": "690200909",
                            "speaker": "雷泽",
                            "text": "但是，你是我的「卢皮卡」。"
                        },
                        {
                            "id": "690200910",
                            "speaker": "雷泽",
                            "text": "这里也是我的家。"
                        },
                        {
                            "id": "690200911",
                            "speaker": "雷泽",
                            "text": "我想为你看家。",
                            "choices": [
                                {
                                    "id": "690200912",
                                    "text": "这里不用看守也行哦。",
                                    "response": [
                                        {
                                            "id": "690200914",
                                            "speaker": "雷泽",
                                            "text": "唔…你说行。就行。"
                                        },
                                        {
                                            "id": "690200915",
                                            "speaker": "雷泽",
                                            "text": "那我，看守你。"
                                        },
                                        {
                                            "id": "690200916",
                                            "speaker": "雷泽",
                                            "text": "不管你到哪里。如果有危险。"
                                        },
                                        {
                                            "id": "690200917",
                                            "speaker": "雷泽",
                                            "text": "我会，冲过来，保护你。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690200913",
                                    "text": "我更想让雷泽来「看守」我。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690200905",
                    "text": "是要看守家吗？",
                    "response": [
                        {
                            "id": "690200906",
                            "speaker": "雷泽",
                            "text": "对的。看守。「家」。"
                        }
                    ]
                }
            ]
        }
    ]
}