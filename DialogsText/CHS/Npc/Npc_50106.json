        {
            "id": "5010601",
            "speaker": "望舒客栈公告板",
            "text": "这里是望舒客栈的公告板，近况无论大小，皆悉心为客人公示。客人若有意见、需求或感触，亦请在此留言。"
        },
        {
            "id": "5010602",
            "speaker": "客人留言",
            "text": "「阿伟又吐毛毛了，好脏好脏。」"
        },
        {
            "id": "5010603",
            "speaker": "回应",
            "text": "「蒂雅，这种事情就不要贴在公告板上给大家看了。」"
        }
    ]
}