    "dialogues": [
        {
            "id": "663050401",
            "speaker": "Player",
            "text": "关于你的面具…"
        },
        {
            "id": "663050402",
            "speaker": "阿卡特",
            "text": "哦？对面具感兴趣吗？"
        },
        {
            "id": "663050403",
            "speaker": "阿卡特",
            "text": "面具是摔角的传统。在摔角中，败北的一方需要摘下面具，而胜者则会为其他人留下想象空间，激励更多人挑战。"
        },
        {
            "id": "663050404",
            "speaker": "阿卡特",
            "text": "而我嘛——我从未摘下过自己的面具，无论对手是人还是龙。"
        }
    ]
}