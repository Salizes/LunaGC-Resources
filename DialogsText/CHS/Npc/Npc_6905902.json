{
    "talkId": "6905902",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "鹿野院平藏": 9
    },
    "dialogues": [
        {
            "id": "690590201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690590202",
            "speaker": "鹿野院平藏",
            "text": "嘿嘿，你真体贴啊。"
        },
        {
            "id": "690590203",
            "speaker": "鹿野院平藏",
            "text": "安心啦，这里宁静悠闲，是比海祇岛还适合度假的好地方呢。"
        },
        {
            "id": "690590204",
            "speaker": "鹿野院平藏",
            "text": "只可惜没有案件，也缺少变数，有点不够刺激。",
            "choices": [
                {
                    "id": "690590205",
                    "text": "不好意思…",
                    "response": [
                        {
                            "id": "690590206",
                            "speaker": "鹿野院平藏",
                            "text": "哎呀呀，是我不好，怎么能让你为难呢。"
                        },
                        {
                            "id": "690590207",
                            "speaker": "鹿野院平藏",
                            "text": "这样吧，我有一个好主意。既能作为消遣，也能表达我的歉意。"
                        },
                        {
                            "id": "690590210",
                            "speaker": "鹿野院平藏",
                            "text": "我们来做一个简单的游戏吧！"
                        },
                        {
                            "id": "690590211",
                            "speaker": "鹿野院平藏",
                            "text": "每次你回来的时候，我都来猜猜，你这一天做了什么，吃过些什么，甚至见过哪些人。"
                        },
                        {
                            "id": "690590212",
                            "speaker": "鹿野院平藏",
                            "text": "赢了的话，随便你怎么奖励我。输了的话，我请你吃最好吃的炸串，如何？"
                        }
                    ]
                },
                {
                    "id": "690590208",
                    "text": "有什么能为你做的吗？",
                    "response": [
                        {
                            "id": "690590209",
                            "speaker": "鹿野院平藏",
                            "text": "哇，那我就接受你的好意喽。"
                        }
                    ]
                }
            ]
        }
    ]
}