{
    "talkId": "6902409",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "北斗": 8
    },
    "dialogues": [
        {
            "id": "690240901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690240202",
            "speaker": "北斗",
            "text": "挺好挺好！来这种鸟语花香的地方坐坐也不错！"
        },
        {
            "id": "690240203",
            "speaker": "北斗",
            "text": "不过嘛…",
            "choices": [
                {
                    "id": "690240204",
                    "text": "不过？",
                    "response": [
                        {
                            "id": "690240205",
                            "speaker": "北斗",
                            "text": "不过你也知道，还是大海的波涛更适合我！"
                        },
                        {
                            "id": "690240206",
                            "speaker": "北斗",
                            "text": "翻腾的海浪才是这世上最好的摇篮曲。"
                        },
                        {
                            "id": "690240210",
                            "speaker": "北斗",
                            "text": "哦，你别误会，你请我来我很开心。"
                        },
                        {
                            "id": "690240211",
                            "speaker": "北斗",
                            "text": "有来有往，下次就该轮到你到我的船上做客了！"
                        }
                    ]
                },
                {
                    "id": "690240207",
                    "text": "还是想念航海的日子？",
                    "response": [
                        {
                            "id": "690240208",
                            "speaker": "北斗",
                            "text": "哈哈！还是你懂我！"
                        },
                        {
                            "id": "690240209",
                            "speaker": "北斗",
                            "text": "那种穿越风暴、征服巨浪的日子才叫一个痛快啊！"
                        }
                    ]
                }
            ]
        }
    ]
}