    "dialogues": [
        {
            "id": "739610101",
            "speaker": "Player",
            "text": "很好看。"
        },
        {
            "id": "739610102",
            "speaker": "曼达娜",
            "text": "谢谢，我就当作是在夸奖我把花园照顾得好啦。"
        },
        {
            "id": "739610103",
            "speaker": "曼达娜",
            "text": "将新鲜的花连着枝叶剪下，插入有水的花瓶，就是很棒的室内装饰。"
        },
        {
            "id": "739610104",
            "speaker": "曼达娜",
            "text": "这些送给您，好看的花会为您带来好运。"
        }
    ]
}