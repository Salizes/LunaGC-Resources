    "dialogues": [
        {
            "id": "631680301",
            "speaker": "Player",
            "text": "老样子…"
        },
        {
            "id": "631680302",
            "speaker": "梶",
            "text": "这样啊…"
        },
        {
            "id": "631680303",
            "speaker": "梶",
            "text": "别灰心！这日子，大家都在硬撑着过。只要撑住了，总会有点好事发生的！"
        },
        {
            "id": "631680304",
            "speaker": "梶",
            "text": "你看，虽说我们现在被当兵的使唤来使唤去的…但是「祟神」不再溢出了，和平也就更近了，对吧！"
        },
        {
            "id": "631680305",
            "speaker": "梶",
            "text": "加把油，总会有好日子在后头的！"
        }
    ]
}