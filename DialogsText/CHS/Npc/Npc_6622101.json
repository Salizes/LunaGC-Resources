{
    "talkId": "6622101",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "穆伊萨": 5,
        "米特尔": 6
    },
    "dialogues": [
        {
            "id": "662210101",
            "speaker": "穆伊萨",
            "text": "哥们，你…相信命运吗？"
        },
        {
            "id": "662210102",
            "speaker": "米特尔",
            "text": "什、什么意思？"
        },
        {
            "id": "662210103",
            "speaker": "穆伊萨",
            "text": "我是说，你来烟谜主拜访，应该也是来占卜的吧？"
        },
        {
            "id": "662210104",
            "speaker": "米特尔",
            "text": "噢！对，对。"
        },
        {
            "id": "662210105",
            "speaker": "米特尔",
            "text": "我准备在家附近开垦一片新的农田。有两处地方土地品质差不多，我有些拿不准…"
        },
        {
            "id": "662210106",
            "speaker": "穆伊萨",
            "text": "种植啊…如果环境相似，那应该都能种出好东西吧。"
        },
        {
            "id": "662210107",
            "speaker": "米特尔",
            "text": "欸，你这么一说…"
        },
        {
            "id": "662210108",
            "speaker": "米特尔",
            "text": "说起来，你呢，是来占卜什么的？"
        },
        {
            "id": "662210109",
            "speaker": "穆伊萨",
            "text": "飞行试炼。我已经为此练习了很久，想看看究竟什么时候起飞，才最容易通过！"
        },
        {
            "id": "662210110",
            "speaker": "米特尔",
            "text": "这个，比起运气，应该更取决于当时的风向和你的技术吧？"
        },
        {
            "id": "662210111",
            "speaker": "穆伊萨",
            "text": "欸，你这么一说…"
        }
    ]
}