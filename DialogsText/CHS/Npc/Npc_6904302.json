    "dialogues": [
        {
            "id": "690430201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690430202",
            "speaker": "砂糖",
            "text": "啊…请不用担心我。"
        },
        {
            "id": "690430203",
            "speaker": "砂糖",
            "text": "对我来说，只要有一个独立的实验室，就已经很满足了。"
        },
        {
            "id": "690430204",
            "speaker": "砂糖",
            "text": "这里比我需要的好了太多。",
            "choices": [
                {
                    "id": "690430205",
                    "text": "不必拘束。",
                    "response": [
                        {
                            "id": "690430207",
                            "speaker": "砂糖",
                            "text": "唔…嗯…"
                        },
                        {
                            "id": "690430208",
                            "speaker": "砂糖",
                            "text": "这样麻烦你让我有点不好意思。"
                        },
                        {
                            "id": "690430209",
                            "speaker": "砂糖",
                            "text": "不过，我会好好珍惜你的这份好意。"
                        }
                    ]
                },
                {
                    "id": "690430206",
                    "text": "有什么需要的器材都可以跟我说。"
                }
            ]
        }
    ]
}