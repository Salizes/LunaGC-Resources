{
    "talkId": "4008122",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Player": 9,
        "努查赫": 22,
        "派蒙": 7
    },
    "dialogues": [
        {
            "id": "400812201",
            "speaker": "努查赫",
            "text": "没想到啊，那个狂徒居然还有这种本事？",
            "choices": [
                {
                    "id": "400812202",
                    "text": "狂徒？",
                    "response": [
                        {
                            "id": "400812203",
                            "speaker": "派蒙",
                            "text": "你好像怨气很大？用了这么激烈的词，说的到底是谁呢？"
                        },
                        {
                            "id": "400812204",
                            "speaker": "努查赫",
                            "text": "咳咳，既然你诚心诚意地发问了，我就要向你好好抱怨一番！"
                        },
                        {
                            "id": "400812205",
                            "speaker": "努查赫",
                            "text": "有关那个主办方的，狂傲自大的学者，考特里亚…你们有没有看他不顺眼啊？",
                            "choices": [
                                {
                                    "id": "400812206",
                                    "text": "（保持沉默并作好奇状）",
                                    "response": [
                                        {
                                            "id": "400812208",
                                            "speaker": "派蒙",
                                            "text": "咦…噢…嗯！"
                                        },
                                        {
                                            "id": "400812209",
                                            "speaker": "派蒙",
                                            "text": "我们和他没怎么交流过…在公开场合发表对别人的评价，好像有点不礼貌？"
                                        },
                                        {
                                            "id": "400812210",
                                            "speaker": "努查赫",
                                            "text": "不用担心！我以前是他的学生，可没在他那里少吃苦头！和我一起痛骂他的人也多了去了！"
                                        },
                                        {
                                            "id": "400812211",
                                            "speaker": "努查赫",
                                            "text": "考特里亚那家伙，从来都不知道「尊重」这个词该怎么写，把普通学生当成佣人使唤，给他干各种杂活，一点报酬都不给…"
                                        },
                                        {
                                            "id": "400812212",
                                            "speaker": "努查赫",
                                            "text": "就连我们的论文，他有时都以工作繁忙为理由，要么打回，不通过，要么就根本不看。好几个人被他毁掉了学术生涯！"
                                        },
                                        {
                                            "id": "400812213",
                                            "speaker": "Player",
                                            "text": "好过分！"
                                        },
                                        {
                                            "id": "400812214",
                                            "speaker": "派蒙",
                                            "text": "好过分！"
                                        },
                                        {
                                            "id": "400812215",
                                            "speaker": "努查赫",
                                            "text": "还好，后来他专心去钻研一个研究项目，找了其他学者来接管我们的论文，不然我这辈子的前途也全毁了…"
                                        },
                                        {
                                            "id": "400812216",
                                            "speaker": "努查赫",
                                            "text": "听说他在别的地方的名声也不好，我一点也不意外！就算是比他尊贵的人，他也会出言不逊。这种性格能混好就怪了！"
                                        },
                                        {
                                            "id": "400812217",
                                            "speaker": "努查赫",
                                            "text": "之前在台上讲话的时候，他还说「接过埃尔欣根先生的衣钵」…如果我没记错的话，在有些地方，这个说法只适用于已经去世的人。"
                                        },
                                        {
                                            "id": "400812218",
                                            "speaker": "努查赫",
                                            "text": "你听听你听听，拿了人家赞助的巨款，就把人家当成死人。换成你去和他打交道，你不会被气晕吗？"
                                        },
                                        {
                                            "id": "400812219",
                                            "speaker": "Player",
                                            "text": "请冷静一点…"
                                        },
                                        {
                                            "id": "400812220",
                                            "speaker": "派蒙",
                                            "text": "对对对，你说你已经不用听考特里亚的话了，所以也别这么生气嘛。摆脱了他，你应该高高兴兴才对！"
                                        },
                                        {
                                            "id": "400812221",
                                            "speaker": "努查赫",
                                            "text": "呼…你们说得有道理。"
                                        },
                                        {
                                            "id": "400812222",
                                            "speaker": "努查赫",
                                            "text": "本来我还想再数落那家伙一番的，现在看来，也不必再折磨自己的心神了，我确实应该好好庆祝一番！"
                                        },
                                        {
                                            "id": "400812223",
                                            "speaker": "努查赫",
                                            "text": "多谢你们，我暂时消气了…"
                                        }
                                    ]
                                },
                                {
                                    "id": "400812207",
                                    "text": "（偷偷给派蒙眼神暗示）"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400812224",
                    "text": "本事？",
                    "response": [
                        {
                            "id": "400812225",
                            "speaker": "努查赫",
                            "text": "咳咳，既然你诚心诚意地发问了，我就大致和你们说明一下吧。"
                        },
                        {
                            "id": "400812226",
                            "speaker": "努查赫",
                            "text": "这次比赛的「花花琼脂」还算巧妙。它似乎是一种植物熬制的凝胶，可以将蕈兽需要的养分和药剂长期储存，而且便于蕈兽吸收…"
                        },
                        {
                            "id": "400812227",
                            "speaker": "努查赫",
                            "text": "蕈兽利用「花花琼脂」获得的战技都是暂时的，不会对对方造成长久的伤害。等到比赛结束后一段时间，之前的伤口就会自动愈合。"
                        },
                        {
                            "id": "400812228",
                            "speaker": "努查赫",
                            "text": "要知道，蕈兽是不会「吃」东西的，只会用一种特殊的方式，从特定环境中「汲取」养分。所以要让蕈兽摄入物质，就比较麻烦…"
                        },
                        {
                            "id": "400812229",
                            "speaker": "派蒙",
                            "text": "听起来，「汲取」好像和「吃」也没什么区别嘛？"
                        },
                        {
                            "id": "400812230",
                            "speaker": "努查赫",
                            "text": "「汲取」就是「汲取」，不是「吃」！"
                        },
                        {
                            "id": "400812231",
                            "speaker": "派蒙",
                            "text": "你不要这么凶嘛…我们没那么讲究，「吃」念起来更简单，也更好懂…",
                            "choices": [
                                {
                                    "id": "400812232",
                                    "text": "别生气，别生气…",
                                    "response": [
                                        {
                                            "id": "400812234",
                                            "speaker": "努查赫",
                                            "text": "呃…对不起，我没想故意为难你们…可能我是论文被人挑刺太多，也染上了一些坏毛病。"
                                        },
                                        {
                                            "id": "400812235",
                                            "speaker": "努查赫",
                                            "text": "千万不能变得和考特里亚一样讨人厌，要平和，要平和…"
                                        },
                                        {
                                            "id": "400812236",
                                            "speaker": "努查赫",
                                            "text": "总之，虽然不知道那家伙是怎么搞出「花花琼脂」这种好东西来的，但从学术的角度评价，这东西的确还不错。"
                                        },
                                        {
                                            "id": "400812237",
                                            "speaker": "努查赫",
                                            "text": "或许可以用面粉等食材，以制作布丁的方法，来试着仿造一下…"
                                        }
                                    ]
                                },
                                {
                                    "id": "400812233",
                                    "text": "派蒙没有恶意…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400812238",
                    "text": "还是不要打扰她了吧…"
                }
            ]
        }
    ]
}