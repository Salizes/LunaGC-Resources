    "dialogues": [
        {
            "id": "620550601",
            "speaker": "Player",
            "text": "吃了什么？"
        },
        {
            "id": "620550602",
            "speaker": "大脚",
            "text": "吃虎鱼和中原杂碎，吃了多少就记不清了…"
        },
        {
            "id": "620550603",
            "speaker": "大脚",
            "text": "我一开吃就没完，毕竟是干体力活儿的人，胃口大。"
        },
        {
            "id": "620550604",
            "speaker": "大脚",
            "text": "话说你知不知道，「吃虎鱼」的「吃」字其实不这么写，以前我花轿上一位客人告诉过我，应该是…"
        },
        {
            "id": "620550605",
            "speaker": "大脚",
            "text": "欸，应该怎么写来着…"
        },
        {
            "id": "620550606",
            "speaker": "大脚",
            "text": "…不对啊，我不是不识字么…"
        }
    ]
}