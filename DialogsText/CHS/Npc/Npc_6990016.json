{
    "talkId": "6990016",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "699001601",
            "speaker": "Player",
            "text": "关于对联…"
        },
        {
            "id": "699001602",
            "speaker": "派蒙",
            "text": "听说对联是璃月的传统文化，有人写完上联以后，会为下联悬赏千金！"
        },
        {
            "id": "699001603",
            "speaker": "派蒙",
            "text": "但因为对联很难，钱也不是那么好赚的。"
        },
        {
            "id": "699001604",
            "speaker": "派蒙",
            "text": "不仅要求字数相等，还要考虑词性相对…"
        },
        {
            "id": "699001605",
            "speaker": "Player",
            "text": "嗯，举一个例子呢？"
        },
        {
            "id": "699001606",
            "speaker": "派蒙",
            "text": "嗯…「风起地风不起」。"
        },
        {
            "id": "699001607",
            "speaker": "Player",
            "text": "…唔，「云来海云再来」。"
        },
        {
            "id": "699001608",
            "speaker": "派蒙",
            "text": "唔！"
        },
        {
            "id": "699001609",
            "speaker": "派蒙",
            "text": "别坐着了，快点起来，快点起来！我们该赚钱去了！"
        }
    ]
}