{
    "talkId": "6909508",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 7,
        "希格雯": 24
    },
    "dialogues": [
        {
            "id": "690950301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690950302",
            "speaker": "希格雯",
            "text": "好哦，我喜欢跟人聊天。"
        },
        {
            "id": "690950303",
            "speaker": "希格雯",
            "text": "通常来说，配合美露莘特殊的感知力，我能大概知道病人身上有哪里不舒服。"
        },
        {
            "id": "690950304",
            "speaker": "希格雯",
            "text": "但想要知道造成病征的原因，靠简单的三两句问诊是远远不够的。"
        },
        {
            "id": "690950305",
            "speaker": "希格雯",
            "text": "聊一聊对方的兴趣爱好、生活习惯甚至心情想法…都很有助于对症下药。",
            "choices": [
                {
                    "id": "690950306",
                    "text": "尽责的护士长！",
                    "response": [
                        {
                            "id": "690950307",
                            "speaker": "希格雯",
                            "text": "是吗？我很高兴听到你这么说。"
                        },
                        {
                            "id": "690950308",
                            "speaker": "希格雯",
                            "text": "梅洛彼得堡的大家也会像你这样夸我呢，你们真是太可爱了。"
                        },
                        {
                            "id": "690950309",
                            "speaker": "希格雯",
                            "text": "人类的信任对我来说至关重要。有了信任，病人才会将自己的身体放心交由我来护理。"
                        },
                        {
                            "id": "690950314",
                            "speaker": "Player",
                            "text": "会有人不配合吗？"
                        },
                        {
                            "id": "690950315",
                            "speaker": "希格雯",
                            "text": "有过哦。毕竟…每个人都有自己的小秘密嘛，不想坦白也很正常。"
                        },
                        {
                            "id": "690950316",
                            "speaker": "希格雯",
                            "text": "就在不久前，有位病人经常会意外弄伤手指，每次来医务室，都嚷嚷着只要些绷带和止痛药就行。"
                        },
                        {
                            "id": "690950317",
                            "speaker": "希格雯",
                            "text": "可我一眼就能看出来，他有所隐瞒哟。"
                        },
                        {
                            "id": "690950318",
                            "speaker": "希格雯",
                            "text": "手指的伤不算什么，精神极度疲劳和涣散才是最糟糕的问题，他呀，已经快到临界值了。"
                        },
                        {
                            "id": "690950319",
                            "speaker": "Player",
                            "text": "那怎么办才好…"
                        },
                        {
                            "id": "690950320",
                            "speaker": "希格雯",
                            "text": "很难办呢，只有他自己把实情告诉我，我才能想办法帮助他。"
                        },
                        {
                            "id": "690950321",
                            "speaker": "希格雯",
                            "text": "「哎呀，这手…唉，恐怕没几天…」"
                        },
                        {
                            "id": "690950322",
                            "speaker": "希格雯",
                            "text": "也许他当时被我这番话吓到了，等其他病人都离开后，立刻哭着告诉了我真相。"
                        },
                        {
                            "id": "690950323",
                            "speaker": "Player",
                            "text": "你似乎在吓唬他…"
                        },
                        {
                            "id": "690950324",
                            "speaker": "希格雯",
                            "text": "没有哦。我想说的是「这手恐怕没几天就要痊愈了」。只是还没说完而已。"
                        },
                        {
                            "id": "690950325",
                            "speaker": "希格雯",
                            "text": "原来跟他住一个监舍的兄弟刑满出狱了，他一个人很怕黑，晚上睡不着，白天拖着疲惫的身体工作才频繁出意外。"
                        },
                        {
                            "id": "690950326",
                            "speaker": "希格雯",
                            "text": "他担心别人笑话他长得这么高大还怕黑，所以没好意思告诉任何人。"
                        },
                        {
                            "id": "690950327",
                            "speaker": "希格雯",
                            "text": "不过没关系，我陪他在莫莱妮小姐那里填好了调换监舍的申请表，问题已经从根本上解决啦。"
                        },
                        {
                            "id": "690950328",
                            "speaker": "希格雯",
                            "text": "唔…原来对于某些人而言，「面子」甚至比「健康」还重要…我学到了很多。"
                        },
                        {
                            "id": "690950329",
                            "speaker": "Player",
                            "text": "确实如此…"
                        },
                        {
                            "id": "690950330",
                            "speaker": "希格雯",
                            "text": "那你呢？你也会有什么难以启齿的秘密吗？"
                        },
                        {
                            "id": "690950331",
                            "speaker": "希格雯",
                            "text": "为了排除今后的健康隐患，可以考虑告诉我哦，我随时都在。"
                        }
                    ]
                },
                {
                    "id": "690950310",
                    "text": "大家都愿意跟你聊吧。",
                    "response": [
                        {
                            "id": "690950311",
                            "speaker": "希格雯",
                            "text": "我听说有很多人从小就害怕医生和护士，也很排斥消毒水和药剂的味道。"
                        },
                        {
                            "id": "690950312",
                            "speaker": "希格雯",
                            "text": "所幸在梅洛彼得堡，大家还是比较乐意来医务室找我的。"
                        },
                        {
                            "id": "690950313",
                            "speaker": "希格雯",
                            "text": "大多数病人都会乖乖地听我的话，回答我的问题。"
                        }
                    ]
                }
            ]
        }
    ]
}