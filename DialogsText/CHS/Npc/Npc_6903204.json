{
    "talkId": "6903204",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "班尼特": 15
    },
    "dialogues": [
        {
            "id": "690320401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690320402",
            "speaker": "班尼特",
            "text": "对于冒险家来说，想做的事情，果然还是冒险吧！"
        },
        {
            "id": "690320403",
            "speaker": "班尼特",
            "text": "为了终点的宝藏，踏上未知的旅途…"
        },
        {
            "id": "690320404",
            "speaker": "班尼特",
            "text": "不对不对…我想说的是，想成为你的助力！"
        },
        {
            "id": "690320405",
            "speaker": "班尼特",
            "text": "你看…我虽然没有什么体格上的特长，但我不怕疼痛，可以适应持久的战斗！"
        },
        {
            "id": "690320406",
            "speaker": "班尼特",
            "text": "虽然经常因为意外受伤，但包扎伤口的手法非常熟练！",
            "choices": [
                {
                    "id": "690320407",
                    "text": "这些我都明白…",
                    "response": [
                        {
                            "id": "690320408",
                            "speaker": "班尼特",
                            "text": "对，对哦…我们一起行动那么久了…"
                        },
                        {
                            "id": "690320411",
                            "speaker": "班尼特",
                            "text": "…关于这个问题，我其实也思考过很多次了。"
                        },
                        {
                            "id": "690320412",
                            "speaker": "班尼特",
                            "text": "我当然也会坚持我的使命。但使命之外的追求，也算是我的私心吧。"
                        },
                        {
                            "id": "690320413",
                            "speaker": "班尼特",
                            "text": "我想要成为能让你信任、能让你依靠的人。"
                        },
                        {
                            "id": "690320414",
                            "speaker": "班尼特",
                            "text": "患难与共的伙伴，来之不易的幸运…"
                        },
                        {
                            "id": "690320415",
                            "speaker": "班尼特",
                            "text": "这一次，我想成为你的力量！",
                            "choices": [
                                {
                                    "id": "690320416",
                                    "text": "你一直都是我重要的同伴。",
                                    "response": [
                                        {
                                            "id": "690320418",
                                            "speaker": "班尼特",
                                            "text": "...谢、谢谢你。"
                                        },
                                        {
                                            "id": "690320419",
                                            "speaker": "班尼特",
                                            "text": "呜…我这是…怎么了。明明是那么开心的事情。"
                                        },
                                        {
                                            "id": "690320420",
                                            "speaker": "班尼特",
                                            "text": "谢谢你…"
                                        }
                                    ]
                                },
                                {
                                    "id": "690320417",
                                    "text": "我也会把我的好运分给你。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690320409",
                    "text": "为什么会想要成为我的助力呢？",
                    "response": [
                        {
                            "id": "690320410",
                            "speaker": "班尼特",
                            "text": "那还用说！你可是我最崇拜的冒险家！"
                        }
                    ]
                }
            ]
        }
    ]
}