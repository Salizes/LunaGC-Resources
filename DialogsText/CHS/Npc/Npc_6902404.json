{
    "talkId": "6902404",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 3,
        "北斗": 14
    },
    "dialogues": [
        {
            "id": "690240401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690240402",
            "speaker": "北斗",
            "text": "那还用问？当然是想带你一起出海冒险喽！"
        },
        {
            "id": "690240403",
            "speaker": "北斗",
            "text": "你要是对掌舵有兴趣，我也可以教你。"
        },
        {
            "id": "690240404",
            "speaker": "北斗",
            "text": "要知道，海上的每个浪花都不会打出第二次…"
        },
        {
            "id": "690240405",
            "speaker": "北斗",
            "text": "不趁你有空的时候多带你到处转转，那岂不是太浪费了。",
            "choices": [
                {
                    "id": "690240406",
                    "text": "我需要做些准备。",
                    "response": [
                        {
                            "id": "690240407",
                            "speaker": "北斗",
                            "text": "行啊，一句话的事。"
                        },
                        {
                            "id": "690240408",
                            "speaker": "北斗",
                            "text": "哦…如果你有什么事要办的话，你就忙完再叫我。"
                        },
                        {
                            "id": "690240409",
                            "speaker": "北斗",
                            "text": "这出船一趟就是一年半载的，没个定数。"
                        },
                        {
                            "id": "690240410",
                            "speaker": "北斗",
                            "text": "还是把该结的事都结了再走的好！"
                        },
                        {
                            "id": "690240416",
                            "speaker": "北斗",
                            "text": "等你准备好了咱就选个日子出发吧！"
                        },
                        {
                            "id": "690240417",
                            "speaker": "北斗",
                            "text": "和你一起征服大海的景象，我都等不及了！"
                        }
                    ]
                },
                {
                    "id": "690240411",
                    "text": "我担心自己会晕船。",
                    "response": [
                        {
                            "id": "690240412",
                            "speaker": "北斗",
                            "text": "不用怕，别有什么心理负担。"
                        },
                        {
                            "id": "690240413",
                            "speaker": "北斗",
                            "text": "晕船这个事得先多适应一下。真要不行，我这还有药草。"
                        },
                        {
                            "id": "690240414",
                            "speaker": "北斗",
                            "text": "我给你打包票没问题，你就放心了吧。"
                        },
                        {
                            "id": "690240415",
                            "speaker": "北斗",
                            "text": "因为这个就错过了海上风光，那简直是人生一大憾事！"
                        }
                    ]
                }
            ]
        }
    ]
}