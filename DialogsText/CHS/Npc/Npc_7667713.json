    "dialogues": [
        {
            "id": "766771301",
            "speaker": "法尔伽",
            "text": "哟，是来视察「战果」的吗，猎手？"
        },
        {
            "id": "766771302",
            "speaker": "法尔伽",
            "text": "我还以为洛恩和米卡不在，西蒙和芙蕾德莉卡也回去之后，就没人能找到我了…"
        },
        {
            "id": "766771303",
            "speaker": "法尔伽",
            "text": "看来还是不能懈怠啊！反侦察能力还得继续锻炼。",
            "choices": [
                {
                    "id": "766771304",
                    "text": "好啊，随时奉陪。",
                    "response": [
                        {
                            "id": "766771306",
                            "speaker": "法尔伽",
                            "text": "哈哈…休息也休息完了，赶紧把这些东西解决吧！"
                        }
                    ]
                },
                {
                    "id": "766771305",
                    "text": "把工作做完再练吧！"
                }
            ]
        }
    ]
}