    "dialogues": [
        {
            "id": "678140301",
            "speaker": "Player",
            "text": "「那个东西」是哪个东西？"
        },
        {
            "id": "678140302",
            "speaker": "艾瓦佐夫斯基",
            "text": "嘘——小点声！"
        },
        {
            "id": "678140303",
            "speaker": "艾瓦佐夫斯基",
            "text": "哎呦喂…瞧瞧您，给我吓出一身冷汗。"
        },
        {
            "id": "678140304",
            "speaker": "艾瓦佐夫斯基",
            "text": "列车员盯着呢，这里可不兴提不合他们运输局规定的东西。"
        }
    ]
}