{
    "talkId": "6220406",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "言笑": 12
    },
    "dialogues": [
        {
            "id": "622040601",
            "speaker": "Player",
            "text": "不好意思…"
        },
        {
            "id": "622040602",
            "speaker": "言笑",
            "text": "没事儿，道上规矩都说要一报还一报。"
        },
        {
            "id": "622040603",
            "speaker": "言笑",
            "text": "当年闹鬼那事儿也受过你照顾，我就不跟你计较了。",
            "choices": [
                {
                    "id": "622040604",
                    "text": "关于你的身世…",
                    "response": [
                        {
                            "id": "622040605",
                            "speaker": "言笑",
                            "text": "咋还问起这个了，我不就一厨子吗？"
                        },
                        {
                            "id": "622040606",
                            "speaker": "言笑",
                            "text": "不过的确很多人都说我不像是厨子。"
                        },
                        {
                            "id": "622040607",
                            "speaker": "言笑",
                            "text": "是这样的。以前是道上的。不小心劫了老板。"
                        },
                        {
                            "id": "622040608",
                            "speaker": "言笑",
                            "text": "然后被打了一顿，关了些时候。"
                        },
                        {
                            "id": "622040609",
                            "speaker": "言笑",
                            "text": "放出来，老板说接我当厨子。"
                        },
                        {
                            "id": "622040610",
                            "speaker": "言笑",
                            "text": "我发现当厨子是比当强盗开心。"
                        },
                        {
                            "id": "622040611",
                            "speaker": "言笑",
                            "text": "这才是真正的我。"
                        }
                    ]
                },
                {
                    "id": "622040801",
                    "text": "最近怎么样？",
                    "response": [
                        {
                            "id": "622040802",
                            "speaker": "言笑",
                            "text": "还不错。自从那之后就再也没有看到奇怪的东西了。"
                        },
                        {
                            "id": "622040803",
                            "speaker": "言笑",
                            "text": "不过就算再出现也无所谓了。老板娘通过朋友认识了一位叫做重云的方士。"
                        },
                        {
                            "id": "622040804",
                            "speaker": "言笑",
                            "text": "如果再闹鬼，找他就行了。听说他对除妖驱鬼还是挺在行的。"
                        }
                    ]
                }
            ]
        }
    ]
}