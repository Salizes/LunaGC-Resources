{
    "talkId": "4008145",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 3,
        "派蒙": 4,
        "铁骨双刀": 13
    },
    "dialogues": [
        {
            "id": "400814501",
            "speaker": "铁骨双刀",
            "text": "实在太丢脸了…",
            "choices": [
                {
                    "id": "400814502",
                    "text": "鼠辈来啦！",
                    "response": [
                        {
                            "id": "400814503",
                            "speaker": "派蒙",
                            "text": "见识浅薄的派蒙来啦！"
                        },
                        {
                            "id": "400814504",
                            "speaker": "铁骨双刀",
                            "text": "你们！你们是想气死我吗！"
                        },
                        {
                            "id": "400814505",
                            "speaker": "铁骨双刀",
                            "text": "行，没问题！输了就是输了，我为之前不妥的言论道歉！"
                        },
                        {
                            "id": "400814506",
                            "speaker": "铁骨双刀",
                            "text": "对不起！你们尽管嘲笑我吧！"
                        },
                        {
                            "id": "400814507",
                            "speaker": "铁骨双刀",
                            "text": "不过，海妮耶大人还是会战胜你们的。虽然她赢了任何人都和我无关，但至少证明，我的信念没有错！"
                        },
                        {
                            "id": "400814508",
                            "speaker": "派蒙",
                            "text": "你为什么这么相信海妮耶呢？难道说，海妮耶以前帮过你，救过你的命吗？"
                        },
                        {
                            "id": "400814509",
                            "speaker": "铁骨双刀",
                            "text": "这就说来话长了…"
                        },
                        {
                            "id": "400814510",
                            "speaker": "铁骨双刀",
                            "text": "当年，有几个盗宝团的家伙，不知道用什么方法激怒了一大群驮兽，想用这些驮兽冲散一支商队，以便盗宝团打劫财物…"
                        },
                        {
                            "id": "400814511",
                            "speaker": "铁骨双刀",
                            "text": "但海妮耶大人不知用什么方法，察觉到了这群驮兽的异样，提前将它们安抚下来，阻止了一场灾难。"
                        },
                        {
                            "id": "400814512",
                            "speaker": "派蒙",
                            "text": "难道说，你担任了那支商队的护卫？海妮耶保住了你的雇主的财产，也因此保住了你的摩拉…甚至是性命！"
                        },
                        {
                            "id": "400814513",
                            "speaker": "铁骨双刀",
                            "text": "不，我是路过看戏的。"
                        },
                        {
                            "id": "400814514",
                            "speaker": "铁骨双刀",
                            "text": "凭我十多年佣兵生涯的经验，我敢确定，要是我被卷入了那样的事件，必定凶多吉少了。"
                        },
                        {
                            "id": "400814515",
                            "speaker": "铁骨双刀",
                            "text": "海妮耶大人驯兽的本领远比我手里的武器强大，为此，我才封存了我心爱的双刀，退出了镀金旅团，开始钻研驯兽之法。"
                        },
                        {
                            "id": "400814516",
                            "speaker": "铁骨双刀",
                            "text": "现在你们明白了吗？海妮耶大人让我走上了一条更有潜力的道路，是可敬的前辈！"
                        },
                        {
                            "id": "400814517",
                            "speaker": "Player",
                            "text": "明，明白了…"
                        },
                        {
                            "id": "400814518",
                            "speaker": "派蒙",
                            "text": "唔呃…逻辑有点奇怪，但好像也有点道理呢…"
                        }
                    ]
                },
                {
                    "id": "400814519",
                    "text": "你继续丢脸，不打扰了。",
                    "response": [
                        {
                            "id": "400814520",
                            "speaker": "铁骨双刀",
                            "text": "你！你们快走吧！现在我也不知道该和你说什么！"
                        }
                    ]
                }
            ]
        }
    ]
}