        "伊娜姆": 4
    },
    "dialogues": [
        {
            "id": "641200501",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "641200502",
            "speaker": "伊娜姆",
            "text": "前几天，有个才来没多久的小兄弟找玛塔莉换班，结果撞上了海兽预警。"
        },
        {
            "id": "641200503",
            "speaker": "伊娜姆",
            "text": "预警解除后，监察官大人来码头巡视，问那位小兄弟预警期间的情况，他支支吾吾答不上来。"
        },
        {
            "id": "641200504",
            "speaker": "伊娜姆",
            "text": "监察官大人又查了排班表，才知道是换班。所以她现在特别在意这个，没人敢犯她的忌讳。"
        },
        {
            "id": "641200505",
            "speaker": "伊娜姆",
            "text": "唉…想早点下班喝点酒。"
        }
    ]
}