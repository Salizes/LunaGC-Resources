    "dialogues": [
        {
            "id": "690430401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690430402",
            "speaker": "砂糖",
            "text": "啊，是这样的…我有几个简单的问题想要问你。"
        },
        {
            "id": "690430403",
            "speaker": "砂糖",
            "text": "你只需要告诉我第一感觉就好，没有对错之分。"
        },
        {
            "id": "690430404",
            "speaker": "砂糖",
            "text": "小灯草还是风车菊？",
            "choices": [
                {
                    "id": "690430405",
                    "text": "小灯草。",
                    "response": [
                        {
                            "id": "690430407",
                            "speaker": "砂糖",
                            "text": "风种子还是风晶蝶？",
                            "choices": [
                                {
                                    "id": "690430408",
                                    "text": "风种子。",
                                    "response": [
                                        {
                                            "id": "690430410",
                                            "speaker": "砂糖",
                                            "text": "云海还是花田？",
                                            "choices": [
                                                {
                                                    "id": "690430411",
                                                    "text": "云海。",
                                                    "response": [
                                                        {
                                                            "id": "690430413",
                                                            "speaker": "砂糖",
                                                            "text": "好的，我全记下来了。"
                                                        },
                                                        {
                                                            "id": "690430414",
                                                            "speaker": "砂糖",
                                                            "text": "…之前，我不知道要怎么表达自己的心意。"
                                                        },
                                                        {
                                                            "id": "690430415",
                                                            "speaker": "砂糖",
                                                            "text": "我想过要不要邀请你一起去「仙境」…但现在的我，都还没有创造出「仙境」的能力。"
                                                        },
                                                        {
                                                            "id": "690430416",
                                                            "speaker": "砂糖",
                                                            "text": "所以，我只能像这样…把你选择的这些事物装进这个小小的水晶球里。"
                                                        },
                                                        {
                                                            "id": "690430417",
                                                            "speaker": "砂糖",
                                                            "text": "直到能把它们装进「仙境」里的那一天到来。",
                                                            "choices": [
                                                                {
                                                                    "id": "690430418",
                                                                    "text": "一言为定。",
                                                                    "response": [
                                                                        {
                                                                            "id": "690430419",
                                                                            "speaker": "砂糖",
                                                                            "text": "…嗯，一言为定。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "690430420",
                                                                    "text": "也要带上砂糖喜欢的东西。",
                                                                    "response": [
                                                                        {
                                                                            "id": "690430421",
                                                                            "speaker": "砂糖",
                                                                            "text": "嗯…我会努力的！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690430412",
                                                    "text": "花田。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690430409",
                                    "text": "风晶蝶。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690430406",
                    "text": "风车菊。"
                }
            ]
        }
    ]
}