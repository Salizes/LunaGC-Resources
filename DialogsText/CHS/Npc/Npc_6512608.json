    "dialogues": [
        {
            "id": "651260801",
            "speaker": "Player",
            "text": "新货是…"
        },
        {
            "id": "651260802",
            "speaker": "科赛尔",
            "text": "就是指普通货物而已。"
        },
        {
            "id": "651260803",
            "speaker": "科赛尔",
            "text": "以前穆纳切洛老是强调「情报也是货物」，搞得大家对搬运工这个职业产生了不必要的期待。"
        },
        {
            "id": "651260804",
            "speaker": "科赛尔",
            "text": "现在是听不到他神神叨叨了…搬运工也就又变回无聊的职业了。"
        }
    ]
}