{
    "talkId": "6909602",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 8,
        "阿蕾奇诺": 9
    },
    "dialogues": [
        {
            "id": "690960201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690960202",
            "speaker": "阿蕾奇诺",
            "text": "感谢邀请。对我来说，是个度假的选择。"
        },
        {
            "id": "690960203",
            "speaker": "阿蕾奇诺",
            "text": "有考虑转手吗？",
            "choices": [
                {
                    "id": "690960204",
                    "text": "啊？",
                    "response": [
                        {
                            "id": "690960206",
                            "speaker": "阿蕾奇诺",
                            "text": "不必惊讶。这里安静隐秘，不受外界打扰，可以当做备用据点。"
                        },
                        {
                            "id": "690960207",
                            "speaker": "阿蕾奇诺",
                            "text": "有了它，许多麻烦都会迎刃而解，付出一些代价也值得。",
                            "choices": [
                                {
                                    "id": "690960208",
                                    "text": "不好意思…",
                                    "response": [
                                        {
                                            "id": "690960210",
                                            "speaker": "阿蕾奇诺",
                                            "text": "真令人遗憾…不过也算预料中的答案。"
                                        },
                                        {
                                            "id": "690960211",
                                            "speaker": "阿蕾奇诺",
                                            "text": "比起「据点」，它更像一个「家」。那就让它保持现状吧。"
                                        },
                                        {
                                            "id": "690960212",
                                            "speaker": "Player",
                                            "text": "说到「家」…"
                                        },
                                        {
                                            "id": "690960213",
                                            "speaker": "阿蕾奇诺",
                                            "text": "怎么了？",
                                            "choices": [
                                                {
                                                    "id": "690960214",
                                                    "text": "要不要举办「家庭烧烤聚会」？",
                                                    "response": [
                                                        {
                                                            "id": "690960216",
                                                            "speaker": "阿蕾奇诺",
                                                            "text": "不错的提案。周围足够宽敞，是举办家庭聚会的好地方。"
                                                        },
                                                        {
                                                            "id": "690960217",
                                                            "speaker": "阿蕾奇诺",
                                                            "text": "能到朋友家玩，孩子们也会很高兴。就这么说定了…聚会所需的一切开销，由我支付就好。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690960215",
                                                    "text": "可以邀请「壁炉之家」一起来。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690960209",
                                    "text": "这可是非卖品。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690960205",
                    "text": "你想买下尘歌壶？"
                }
            ]
        }
    ]
}