{
    "talkId": "7165811",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "申鹤": 7
    },
    "dialogues": [
        {
            "id": "716581101",
            "speaker": "申鹤",
            "text": "璃月港的夜晚，比奥藏山的白昼更明亮。"
        },
        {
            "id": "716581102",
            "speaker": "申鹤",
            "text": "起初，我很不习惯这样的景色。但人们说，这就是海灯节。我猜，大家都很喜欢明亮的地方，所以每每提及海灯节总是带着笑容。"
        },
        {
            "id": "716581103",
            "speaker": "申鹤",
            "text": "我学给你看，像这样。"
        },
        {
            "id": "716581104",
            "speaker": "Player",
            "text": "嗯，就是这样的笑容。"
        },
        {
            "id": "716581105",
            "speaker": "申鹤",
            "text": "#{NICKNAME}，你会一直留在这里吗？"
        },
        {
            "id": "716581106",
            "speaker": "Player",
            "text": "海灯节期间的话…"
        },
        {
            "id": "716581107",
            "speaker": "申鹤",
            "text": "…这样啊。"
        },
        {
            "id": "716581108",
            "speaker": "申鹤",
            "text": "能像这样跟你见面，我很高兴。"
        },
        {
            "id": "716581109",
            "speaker": "申鹤",
            "text": "真希望海灯节能一直持续下去，不要结束。"
        }
    ]
}