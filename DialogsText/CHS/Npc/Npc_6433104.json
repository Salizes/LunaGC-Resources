    "dialogues": [
        {
            "id": "643310401",
            "speaker": "Player",
            "text": "找人占卜看看。"
        },
        {
            "id": "643310402",
            "speaker": "扎蒂斯",
            "text": "哈哈哈，你可真会开玩笑！"
        },
        {
            "id": "643310403",
            "speaker": "扎蒂斯",
            "text": "…是开玩笑的对吧？"
        },
        {
            "id": "643310404",
            "speaker": "扎蒂斯",
            "text": "不管有多难选，这都是关系到我毕生职业规划的重要抉择。"
        },
        {
            "id": "643310405",
            "speaker": "扎蒂斯",
            "text": "如果选错了，没准就会像阿莲佐一样退学，或者像胡塞尼那样一直毕不了业。"
        },
        {
            "id": "643310406",
            "speaker": "扎蒂斯",
            "text": "我可千万不要那样啊！"
        }
    ]
}