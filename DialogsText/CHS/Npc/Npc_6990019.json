{
    "talkId": "6990019",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699001901",
            "speaker": "Player",
            "text": "关于凝光…"
        },
        {
            "id": "699001902",
            "speaker": "派蒙",
            "text": "要怎么样才能成为凝光大人那种，很有钱，又很有钱的人物呢！"
        },
        {
            "id": "699001903",
            "speaker": "Player",
            "text": "凝光给你的印象就只剩下钱了吗…"
        },
        {
            "id": "699001904",
            "speaker": "派蒙",
            "text": "还有大大的「群玉阁」！不过那也是用摩拉堆出来的吧。"
        },
        {
            "id": "699001905",
            "speaker": "Player",
            "text": "那么，要有精明的头脑…"
        },
        {
            "id": "699001906",
            "speaker": "派蒙",
            "text": "派蒙擅长给人取绰号！"
        },
        {
            "id": "699001907",
            "speaker": "Player",
            "text": "要熟悉市场运作的规则…"
        },
        {
            "id": "699001908",
            "speaker": "派蒙",
            "text": "一份渔人吐司卖1025摩拉，下雨天也不会打折。"
        },
        {
            "id": "699001909",
            "speaker": "Player",
            "text": "要有高人一等的办事手腕…"
        },
        {
            "id": "699001910",
            "speaker": "派蒙",
            "text": "…怎样才能跟一个有钱人成为朋友呢？"
        },
        {
            "id": "699001911",
            "speaker": "Player",
            "text": "这就已经放弃了吗？！"
        }
    ]
}