    "dialogues": [
        {
            "id": "690465101",
            "speaker": "胡桃",
            "text": "村里的气氛还不错，我随便转转，就有了诗兴！"
        },
        {
            "id": "690465102",
            "speaker": "胡桃",
            "text": "到了夜里，会不会碰上更好玩的事呢？比如…苏醒的石雕，沉入水中的鬼火…"
        },
        {
            "id": "690465103",
            "speaker": "胡桃",
            "text": "嘿嘿…你会跟我来的吧！"
        }
    ]
