{
    "talkId": "6905303",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "早柚": 12
    },
    "dialogues": [
        {
            "id": "690530301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690530302",
            "speaker": "早柚",
            "text": "好呀。"
        },
        {
            "id": "690530303",
            "speaker": "早柚",
            "text": "我会努力不睡着的…",
            "choices": [
                {
                    "id": "690530304",
                    "text": "早柚今天睡饱了吗？",
                    "response": [
                        {
                            "id": "690530305",
                            "speaker": "早柚",
                            "text": "这么一说，我又有点困了…"
                        },
                        {
                            "id": "690530306",
                            "speaker": "早柚",
                            "text": "呼啊…"
                        },
                        {
                            "id": "690530307",
                            "speaker": "早柚",
                            "text": "不行，我要忍住…"
                        },
                        {
                            "id": "690530311",
                            "speaker": "早柚",
                            "text": "和你在一起的时候，我睡着了的话…就太浪费了。"
                        },
                        {
                            "id": "690530312",
                            "speaker": "Player",
                            "text": "早柚的工作没关系吗？"
                        },
                        {
                            "id": "690530313",
                            "speaker": "早柚",
                            "text": "没关系哦…"
                        },
                        {
                            "id": "690530314",
                            "speaker": "早柚",
                            "text": "工作都是些没有意义的小事情。"
                        },
                        {
                            "id": "690530315",
                            "speaker": "早柚",
                            "text": "不如待在这里有意义。"
                        },
                        {
                            "id": "690530316",
                            "speaker": "早柚",
                            "text": "可以睡觉，也可以和你聊天…"
                        }
                    ]
                },
                {
                    "id": "690530308",
                    "text": "早柚困的话就睡吧。",
                    "response": [
                        {
                            "id": "690530309",
                            "speaker": "早柚",
                            "text": "唔，没事的…"
                        },
                        {
                            "id": "690530310",
                            "speaker": "早柚",
                            "text": "呼啊…我还不想睡觉…"
                        }
                    ]
                }
            ]
        }
    ]
}