    "dialogues": [
        {
            "id": "620320601",
            "speaker": "Player",
            "text": "你是卖鱼的吗？"
        },
        {
            "id": "620320602",
            "speaker": "碧波",
            "text": "鱼？如果你是想试探我的话，那大可不必，让我们打开天窗说亮话吧——"
        },
        {
            "id": "620320603",
            "speaker": "碧波",
            "text": "这么说吧，无论是什么货物、在哪里，只要报酬合适我都可以帮你搞来…"
        },
        {
            "id": "620320604",
            "speaker": "碧波",
            "text": "就算是稻妻的也没问题！"
        }
    ]
}