    "speaker_counts": {
        "Player": 1,
        "夏安卡": 4
    },
    "dialogues": [
        {
            "id": "660100601",
            "speaker": "Player",
            "text": "近况如何？"
        },
        {
            "id": "660100602",
            "speaker": "夏安卡",
            "text": "多谢关心，一切都好。"
        },
        {
            "id": "660100603",
            "speaker": "夏安卡",
            "text": "战后有不少老战友来我这里聚餐，虽然大家各有各的伤，但看起来都挺开心的。"
        },
        {
            "id": "660100604",
            "speaker": "夏安卡",
            "text": "…当然，也可能是不想在我面前展现出不开心的样子吧。"
        },
        {
            "id": "660100605",
            "speaker": "夏安卡",
            "text": "「和平」的喜悦与「失去」的伤痛是两回事，我们都知道的。只希望他们能多来我这吃吃饭、喝喝酒，我请客！"
        }
    ]
}