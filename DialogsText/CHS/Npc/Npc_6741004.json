        {
            "id": "674100401",
            "speaker": "Player",
            "text": "你好，凯瑟琳。"
        },
        {
            "id": "674100402",
            "speaker": "凯瑟琳",
            "text": "很高兴见到你。"
        },
        {
            "id": "674100403",
            "speaker": "凯瑟琳",
            "text": "我是冒险家协会的接待员凯瑟琳，负责为冒险家们提供任务发布和情报支援工作。"
        },
        {
            "id": "674100404",
            "speaker": "凯瑟琳",
            "text": "这里是冒险家协会总部，如果您在其他国家与地区遇到什么当地冒险家协会没法解决的问题，可以来总部进行咨询。"
        }
    ]
