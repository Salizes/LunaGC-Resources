{
    "talkId": "6911908",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "菈乌玛": 12
    },
    "dialogues": [
        {
            "id": "691190301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691190302",
            "speaker": "菈乌玛",
            "text": "当然好。需要我来甄选话题吗？"
        },
        {
            "id": "691190303",
            "speaker": "菈乌玛",
            "text": "唔…不过，我应该不能算是个擅长聊天的人吧…我自己是这么认为的。",
            "choices": [
                {
                    "id": "691190304",
                    "text": "不会呀，菈乌玛很擅长聊天。",
                    "response": [
                        {
                            "id": "691190305",
                            "speaker": "菈乌玛",
                            "text": "恐怕要让你失望了…职能所致，我必须说些安抚人心、鼓励他人的话语。"
                        },
                        {
                            "id": "691190306",
                            "speaker": "菈乌玛",
                            "text": "语言带有奇妙的力量，所以人们谨慎地使用最为合适的语言，我也一样。"
                        },
                        {
                            "id": "691190310",
                            "speaker": "菈乌玛",
                            "text": "但非要说的话，我确实想变得更擅长沟通一些…"
                        },
                        {
                            "id": "691190311",
                            "speaker": "Player",
                            "text": "可以学学身边的朋友。"
                        },
                        {
                            "id": "691190312",
                            "speaker": "菈乌玛",
                            "text": "…第一时间想到了那几位。奈芙尔小姐，法尔伽先生，还有菲林斯先生。"
                        },
                        {
                            "id": "691190313",
                            "speaker": "菈乌玛",
                            "text": "都是精明又聪慧的人呢。大家来自不同的环境，也就拥有了不同的谈吐。"
                        },
                        {
                            "id": "691190314",
                            "speaker": "菈乌玛",
                            "text": "遇见他们让我知道自己的局限。需要学习的地方还很多。"
                        },
                        {
                            "id": "691190315",
                            "speaker": "Player",
                            "text": "你也可以反过来教他们一些事哦。"
                        },
                        {
                            "id": "691190316",
                            "speaker": "菈乌玛",
                            "text": "嗯…或许是可以的。"
                        },
                        {
                            "id": "691190317",
                            "speaker": "菈乌玛",
                            "text": "至少在与动物交流这方面，我有着绝对优势。"
                        }
                    ]
                },
                {
                    "id": "691190307",
                    "text": "没关系，我也不擅长这方面。",
                    "response": [
                        {
                            "id": "691190308",
                            "speaker": "菈乌玛",
                            "text": "真的？在我看来你已经做得很好了呢。"
                        },
                        {
                            "id": "691190309",
                            "speaker": "菈乌玛",
                            "text": "虽然派蒙经常代替你说几句，你自己的发言倒也很有意思，我一直注意着。"
                        }
                    ]
                }
            ]
        }
    ]
}