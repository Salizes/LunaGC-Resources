{
    "talkId": "38306",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "琴": 10
    },
    "dialogues": [
        {
            "id": "3830514",
            "speaker": "琴",
            "text": "即使是以私人身份行动，也偶尔会用那种语气说话…这就是，所谓的职业病？",
            "choices": [
                {
                    "id": "3830515",
                    "text": "关于骑士团。",
                    "response": [
                        {
                            "id": "3830516",
                            "speaker": "琴",
                            "text": "说来有些惭愧，这次事件后，骑士团的大家都忙得焦头烂额。"
                        },
                        {
                            "id": "3830517",
                            "speaker": "琴",
                            "text": "如果我是一个更有能力的团长的话…"
                        },
                        {
                            "id": "3830518",
                            "speaker": "琴",
                            "text": "或者像大团长那样，给大家带来更多士气与力量的话…"
                        },
                        {
                            "id": "3830519",
                            "speaker": "琴",
                            "text": "不行，不能泄气，早点解决问题才是最重要的。对吧？荣誉骑士。"
                        }
                    ]
                },
                {
                    "id": "3830520",
                    "text": "关于天空之琴。",
                    "response": [
                        {
                            "id": "3830521",
                            "speaker": "琴",
                            "text": "巴巴托斯的圣物，蒙德的至宝…天空之琴。"
                        },
                        {
                            "id": "3830522",
                            "speaker": "琴",
                            "text": "有净化污秽的力量也不足为奇呢。"
                        },
                        {
                            "id": "3830523",
                            "speaker": "琴",
                            "text": "希望可以如温迪所说，靠它的力量拯救特瓦林。"
                        },
                        {
                            "id": "3830524",
                            "speaker": "琴",
                            "text": "该说这是巴巴托斯大人留给我们的祝福吗？"
                        }
                    ]
                },
                {
                    "id": "3830525",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "3830526",
                            "speaker": "琴",
                            "text": "听凭风引，特瓦林一定会得救的。"
                        }
                    ]
                }
            ]
        }
    ]
}