{
    "talkId": "41713",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "瓦格纳": 7
    },
    "dialogues": [
        {
            "id": "4015141714",
            "speaker": "Player",
            "text": "想了解些事情。"
        },
        {
            "id": "4015141715",
            "speaker": "瓦格纳",
            "text": "想问什么？那就快点问吧。",
            "choices": [
                {
                    "id": "4015141703",
                    "text": "关于这家铁匠铺。",
                    "response": [
                        {
                            "id": "4015141707",
                            "speaker": "瓦格纳",
                            "text": "哼，无聊的问题。你想了解这家铺子，买把铺子里的兵器试试不就知道了。"
                        },
                        {
                            "id": "4015141708",
                            "speaker": "瓦格纳",
                            "text": "全靠一张嘴，说什么都是空谈，只有亲身体会的才是真实。"
                        },
                        {
                            "id": "4015141709",
                            "speaker": "瓦格纳",
                            "text": "要是连这个都不知道，你迟早要吃亏的，小鬼。"
                        }
                    ]
                },
                {
                    "id": "4015141704",
                    "text": "关于你自己。",
                    "response": [
                        {
                            "id": "4015141710",
                            "speaker": "瓦格纳",
                            "text": "除了我和我徒弟舒茨之外，这地方没有一个人能算得上是合格的铁匠。"
                        },
                        {
                            "id": "4015141711",
                            "speaker": "瓦格纳",
                            "text": "打铁的诀窍，只有汗水！这是我几十年来的经验！而那些家伙却只知道投机取巧。"
                        },
                        {
                            "id": "4015141712",
                            "speaker": "瓦格纳",
                            "text": "家人？传承血脉？都是些没意义的东西，我只需要一个徒弟把手艺传承下去就够了。"
                        }
                    ]
                }
            ]
        }
    ]
}