{
    "talkId": "6904103",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "莫娜": 15
    },
    "dialogues": [
        {
            "id": "690410301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690410302",
            "speaker": "莫娜",
            "text": "好呀，现在我心情不错。有什么想要请教我的吗？"
        },
        {
            "id": "690410303",
            "speaker": "Player",
            "text": "想听莫娜分享知识！"
        },
        {
            "id": "690410304",
            "speaker": "莫娜",
            "text": "哦，很好学嘛。"
        },
        {
            "id": "690410305",
            "speaker": "莫娜",
            "text": "我可是很博学的，上知天文下知地理。"
        },
        {
            "id": "690410306",
            "speaker": "莫娜",
            "text": "…不过占星方面的知识，系统性地讲解会费不少时间。"
        },
        {
            "id": "690410307",
            "speaker": "莫娜",
            "text": "干脆，就告诉你一些生活上会用到的实用知识吧！",
            "choices": [
                {
                    "id": "690410308",
                    "text": "哦？都有什么呢。",
                    "response": [
                        {
                            "id": "690410311",
                            "speaker": "莫娜",
                            "text": "嗯…比如，临近保质期的食材，只要采用合适的烹饪方式加工熟透，就能吃到性价比很高的一餐。"
                        },
                        {
                            "id": "690410312",
                            "speaker": "莫娜",
                            "text": "很多店每个月都会有打折的时候。找准时机囤些粗粮干货，之后作为主食吃，饱腹感很强。"
                        },
                        {
                            "id": "690410313",
                            "speaker": "莫娜",
                            "text": "还有…自己加工制成肉制品，会比直接买现成的要便宜很多…",
                            "choices": [
                                {
                                    "id": "690410314",
                                    "text": "都是省钱方面的知识呢…",
                                    "response": [
                                        {
                                            "id": "690410315",
                                            "speaker": "莫娜",
                                            "text": "呃…呃…"
                                        },
                                        {
                                            "id": "690410316",
                                            "speaker": "莫娜",
                                            "text": "你这样的归纳是很失礼的！"
                                        },
                                        {
                                            "id": "690410317",
                                            "speaker": "莫娜",
                                            "text": "这些都是人生修行中重要的一部分。是对客观世界规律的提炼和总结。"
                                        },
                                        {
                                            "id": "690410318",
                                            "speaker": "莫娜",
                                            "text": "总，总之…我会对你更严格一些。要理解世界之理，你还需要更多修行！"
                                        }
                                    ]
                                },
                                {
                                    "id": "690410319",
                                    "text": "我记下了！",
                                    "response": [
                                        {
                                            "id": "690410320",
                                            "speaker": "莫娜",
                                            "text": "哼哼，你试试就知道，肯定会很有用的。"
                                        },
                                        {
                                            "id": "690410321",
                                            "speaker": "莫娜",
                                            "text": "等你学成之后，我就把更多蕴藏在世界深处的奥秘分享给你吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690410309",
                    "text": "莫娜好像很懂生活的样子…",
                    "response": [
                        {
                            "id": "690410310",
                            "speaker": "莫娜",
                            "text": "那是当然的！"
                        }
                    ]
                }
            ]
        }
    ]
}