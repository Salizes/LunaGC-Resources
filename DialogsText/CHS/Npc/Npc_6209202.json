    "dialogues": [
        {
            "id": "620920201",
            "speaker": "Player",
            "text": "关于玩具…"
        },
        {
            "id": "620920202",
            "speaker": "阿山婆",
            "text": "孩子们都会喜欢的，是一些新奇有趣的精巧东西。"
        },
        {
            "id": "620920203",
            "speaker": "阿山婆",
            "text": "…还有一些，是大人的玩具。"
        },
        {
            "id": "620920204",
            "speaker": "Player",
            "text": "大人的…玩具？"
        },
        {
            "id": "620920205",
            "speaker": "阿山婆",
            "text": "啊，我没说全，是需要大人带着孩子一起玩的玩具，比如风筝啊之类的。"
        },
        {
            "id": "620920206",
            "speaker": "阿山婆",
            "text": "不管是战乱年代、饥荒年代还是如今富饶的时代，快乐都该是永远不变的追求，你说是吧年轻人。"
        }
    ]
}