    "dialogues": [
        {
            "id": "739400101",
            "speaker": "Player",
            "text": "保重。"
        },
        {
            "id": "739400102",
            "speaker": "库什基",
            "text": "多谢关心。"
        },
        {
            "id": "739400103",
            "speaker": "库什基",
            "text": "现在唯一的安慰就是，因为教令院有了更重要的研究项目，所以对我们的成果要求放松了许多。"
        },
        {
            "id": "739400104",
            "speaker": "库什基",
            "text": "我也可以空出更多时间，调养自己的身体了。"
        },
        {
            "id": "739400105",
            "speaker": "库什基",
            "text": "虽然脖子痛的问题很难根除，但听说合理的饮食可以优化人的视觉。为此忍受一些食物，倒也不是很难。"
        }
    ]
}