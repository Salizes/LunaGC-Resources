{
    "talkId": "6904504",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "罗莎莉亚": 15
    },
    "dialogues": [
        {
            "id": "690450401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690450402",
            "speaker": "罗莎莉亚",
            "text": "嗯，干脆一起去喝酒吧。"
        },
        {
            "id": "690450403",
            "speaker": "罗莎莉亚",
            "text": "这次就痛痛快快地喝，喝醉也没事。",
            "choices": [
                {
                    "id": "690450404",
                    "text": "罗莎莉亚真的会喝醉吗？",
                    "response": [
                        {
                            "id": "690450406",
                            "speaker": "罗莎莉亚",
                            "text": "是啊，我从来不会让自己喝醉。"
                        },
                        {
                            "id": "690450407",
                            "speaker": "罗莎莉亚",
                            "text": "我原先觉得，把自己毫无防备地暴露在别人面前，是件蠢事。"
                        },
                        {
                            "id": "690450408",
                            "speaker": "罗莎莉亚",
                            "text": "不过我的想法改变了。"
                        },
                        {
                            "id": "690450409",
                            "speaker": "罗莎莉亚",
                            "text": "大概是因为信任你吧…这不是重点。"
                        },
                        {
                            "id": "690450410",
                            "speaker": "罗莎莉亚",
                            "text": "「天使的馈赠」和「猫尾酒馆」，要去哪家？",
                            "choices": [
                                {
                                    "id": "690450411",
                                    "text": "「天使的馈赠」。",
                                    "response": [
                                        {
                                            "id": "690450412",
                                            "speaker": "罗莎莉亚",
                                            "text": "晨曦酒庄出品，酒源有绝对的保证。"
                                        },
                                        {
                                            "id": "690450413",
                                            "speaker": "罗莎莉亚",
                                            "text": "去这家的话，就喝蒲公英酒好了。"
                                        },
                                        {
                                            "id": "690450417",
                                            "speaker": "罗莎莉亚",
                                            "text": "看在我的面子上，这次你总得喝几杯了吧？"
                                        },
                                        {
                                            "id": "690450418",
                                            "speaker": "Player",
                                            "text": "……"
                                        },
                                        {
                                            "id": "690450419",
                                            "speaker": "罗莎莉亚",
                                            "text": "……"
                                        },
                                        {
                                            "id": "690450420",
                                            "speaker": "罗莎莉亚",
                                            "text": "算了算了，我先替你喝吧。"
                                        },
                                        {
                                            "id": "690450421",
                                            "speaker": "罗莎莉亚",
                                            "text": "等你来日再还。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690450414",
                                    "text": "「猫尾酒馆」。",
                                    "response": [
                                        {
                                            "id": "690450415",
                                            "speaker": "罗莎莉亚",
                                            "text": "哦？是对这家的特调感兴趣吗？"
                                        },
                                        {
                                            "id": "690450416",
                                            "speaker": "罗莎莉亚",
                                            "text": "当家调酒师并不是每天都当班，倒是可以碰碰运气。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690450405",
                    "text": "想象不出罗莎莉亚喝醉的样子。"
                }
            ]
        }
    ]
}