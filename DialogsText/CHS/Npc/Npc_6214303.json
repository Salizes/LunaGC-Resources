    "dialogues": [
        {
            "id": "621430301",
            "speaker": "Player",
            "text": "我只是路过。"
        },
        {
            "id": "621430302",
            "speaker": "百闻",
            "text": "这样吗？那还真是有趣…"
        },
        {
            "id": "621430303",
            "speaker": "百闻",
            "text": "毕竟您来到了这里，不会仅仅是抱着观光游乐的目的吧？"
        },
        {
            "id": "621430304",
            "speaker": "百闻",
            "text": "情报显示，任何人来到群玉阁都是心有所图的，这一点还未曾有过例外。"
        },
        {
            "id": "621430305",
            "speaker": "百闻",
            "text": "哼哼…就算你不说，我们也一定会查明并登记在案的，不要小瞧我们的情报网。"
        }
    ]
