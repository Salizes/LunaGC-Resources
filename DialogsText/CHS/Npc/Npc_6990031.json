{
    "talkId": "6990031",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "699003101",
            "speaker": "Player",
            "text": "关于大巴扎…"
        },
        {
            "id": "699003102",
            "speaker": "派蒙",
            "text": "大巴扎居民们真是多才多艺啊！"
        },
        {
            "id": "699003103",
            "speaker": "派蒙",
            "text": "不仅会卖自己做的编织品、好看的瓶瓶罐罐，闻到味道肚子就会饿的香料…"
        },
        {
            "id": "699003104",
            "speaker": "派蒙",
            "text": "还个个能歌善舞，好让人羡慕！"
        },
        {
            "id": "699003105",
            "speaker": "Player",
            "text": "只要有心，派蒙也可以学哦。"
        },
        {
            "id": "699003106",
            "speaker": "派蒙",
            "text": "欸？真的吗？",
            "choices": [
                {
                    "id": "699003107",
                    "text": "就拿跳舞举例吧…",
                    "response": [
                        {
                            "id": "699003109",
                            "speaker": "Player",
                            "text": "既不会自己绊倒自己…"
                        },
                        {
                            "id": "699003111",
                            "speaker": "派蒙",
                            "text": "对哦！我都忘记会飞是那么方便的事了！"
                        },
                        {
                            "id": "699003112",
                            "speaker": "派蒙",
                            "text": "走吧，快点去大巴扎那晃悠晃悠，让大家都来羡慕我！"
                        },
                        {
                            "id": "699003113",
                            "speaker": "Player",
                            "text": "原来你是想去攀比吗？"
                        }
                    ]
                },
                {
                    "id": "699003108",
                    "text": "派蒙是有先天优势的。"
                }
            ]
        }
    ]
}