    "dialogues": [
        {
            "id": "676820301",
            "speaker": "Player",
            "text": "你在这里做什么。"
        },
        {
            "id": "676820302",
            "speaker": "托萨利斯",
            "text": "就像你所听到的，我在把我能记得住的词汇反复念诵出来，直到它们在语言的实践中被重新赋予意义…"
        },
        {
            "id": "676820303",
            "speaker": "托萨利斯",
            "text": "或者一直到我觉得满足了为止，至少现在我的感觉不错。"
        }
    ]
}