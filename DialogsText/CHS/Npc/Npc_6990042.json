{
    "talkId": "6990042",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 4,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "699004201",
            "speaker": "Player",
            "text": "关于枫达…"
        },
        {
            "id": "699004202",
            "speaker": "派蒙",
            "text": "枫达喝起来真的很痛快，你不觉得吗？"
        },
        {
            "id": "699004203",
            "speaker": "Player",
            "text": "嗯，一饮而下的话，就会特别神清气爽。"
        },
        {
            "id": "699004204",
            "speaker": "派蒙",
            "text": "能给我买一杯吗？我很久以前就想试试那个了！"
        },
        {
            "id": "699004205",
            "speaker": "Player",
            "text": "哪个？"
        },
        {
            "id": "699004206",
            "speaker": "派蒙",
            "text": "哎呀，等下我表演给你看。"
        },
        {
            "id": "699004207",
            "speaker": "派蒙",
            "text": "咕嘟咕嘟咕嘟咕嘟——"
        },
        {
            "id": "699004208",
            "speaker": "派蒙",
            "text": "哈啊——"
        },
        {
            "id": "699004209",
            "speaker": "派蒙",
            "text": "那些酒鬼干杯的时候总是这个样子，我也想试一次！"
        },
        {
            "id": "699004210",
            "speaker": "Player",
            "text": "别像个老头子一样啊…"
        }
    ]
}