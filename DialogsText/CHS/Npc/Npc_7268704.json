    "dialogues": [
        {
            "id": "726870401",
            "speaker": "柴染",
            "text": "你们好，有缘人。"
        },
        {
            "id": "726870402",
            "speaker": "柴染",
            "text": "你们对「插花」这门艺术有兴趣吗？",
            "choices": [
                {
                    "id": "726870403",
                    "text": "「插花」？",
                    "response": [
                        {
                            "id": "726870404",
                            "speaker": "派蒙",
                            "text": "以前好像接触过类似的事物呢…"
                        },
                        {
                            "id": "726870405",
                            "speaker": "柴染",
                            "text": "那可真是太好了。"
                        },
                        {
                            "id": "726870406",
                            "speaker": "柴染",
                            "text": "我正在筹备一项活动，宣传「插花」之道的美好。"
                        },
                        {
                            "id": "726870407",
                            "speaker": "柴染",
                            "text": "再过几天，两位就能在这里体验到「插花」的魅力了。"
                        },
                        {
                            "id": "726870408",
                            "speaker": "Player",
                            "text": "有点好奇…"
                        },
                        {
                            "id": "726870409",
                            "speaker": "派蒙",
                            "text": "好哦，那我们过几天再来看看吧！"
                        }
                    ]
                },
                {
                    "id": "726870410",
                    "text": "可能以后会有的…",
                    "response": [
                        {
                            "id": "726870411",
                            "speaker": "柴染",
                            "text": "再过几天，两位可以来这里体验一下「插花」，也许到时候，你们就会被这门艺术迷住了呢。"
                        }
                    ]
                }
            ]
        }
    ]
}