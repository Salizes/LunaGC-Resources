{
    "talkId": "6180112",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 1,
        "因薛尼": 3,
        "洛恩": 6
    },
    "dialogues": [
        {
            "id": "618011201",
            "speaker": "因薛尼",
            "text": "看不见我…看不见我…"
        },
        {
            "id": "618011202",
            "speaker": "洛恩",
            "text": "嘿。"
        },
        {
            "id": "618011203",
            "speaker": "因薛尼",
            "text": "——啊！"
        },
        {
            "id": "618011204",
            "speaker": "洛恩",
            "text": "小心点，要是就这么掉下去，压到小猫小狗怎么办？"
        },
        {
            "id": "618011205",
            "speaker": "洛恩",
            "text": "不过跑得那么高，倒是方便我们审讯了。荣誉骑士，你带绳子了吗？我想把他悬吊在墙角上问问话。"
        },
        {
            "id": "618011206",
            "speaker": "Player",
            "text": "要不要倒着吊？"
        },
        {
            "id": "618011207",
            "speaker": "洛恩",
            "text": "呵呵，我也正这么想——你觉得呢？"
        },
        {
            "id": "618011208",
            "speaker": "因薛尼",
            "text": "我…我招！我什么都招！求求你们放我下去再问话吧！"
        },
        {
            "id": "618011209",
            "speaker": "洛恩",
            "text": "唉，就这么配合？那行吧。"
        },
        {
            "id": "618011210",
            "speaker": "洛恩",
            "text": "希望你去了驻地之后不会后悔，没有在这里接受「倒吊」…这种最不遭罪的手段。"
        }
    ]
}