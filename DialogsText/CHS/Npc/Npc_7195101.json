{
    "talkId": "7195101",
    "total_dialogue_lines": 5,
    "speaker_counts": {
        "Player": 1,
        "百闻": 4
    },
    "dialogues": [
        {
            "id": "719510101",
            "speaker": "Player",
            "text": "我很崇拜凝光大人。"
        },
        {
            "id": "719510102",
            "speaker": "百闻",
            "text": "嗯，这并不稀奇，我也一样。"
        },
        {
            "id": "719510103",
            "speaker": "百闻",
            "text": "世人尽知，天权为尊。我能做的，便是为凝光大人织起情报之网。"
        },
        {
            "id": "719510104",
            "speaker": "百闻",
            "text": "待凝光大人抽丝剥茧，刀斩乱麻之后，便会从群玉阁降下「繁荣」的指引…"
        },
        {
            "id": "719510105",
            "speaker": "百闻",
            "text": "你也想领略一下吗？"
        }
    ]
}