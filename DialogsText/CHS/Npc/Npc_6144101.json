{
    "talkId": "6144101",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "盖伊": 13
    },
    "dialogues": [
        {
            "id": "4015144101",
            "speaker": "盖伊",
            "text": "又是毫无意义的一天…"
        },
        {
            "id": "4015144116",
            "speaker": "盖伊",
            "text": "哦！有什么需要帮忙的吗？不不，没有也没关系！",
            "choices": [
                {
                    "id": "4015144102",
                    "text": "你在做什么？",
                    "response": [
                        {
                            "id": "4015144105",
                            "speaker": "盖伊",
                            "text": "我也想知道我在做什么…我到底在做什么啊，盖伊。"
                        },
                        {
                            "id": "4015144106",
                            "speaker": "盖伊",
                            "text": "好吧，我在看守蒙德的侧门。众所周知的，几乎从来没有人经过的侧门。"
                        },
                        {
                            "id": "4015144107",
                            "speaker": "盖伊",
                            "text": "嘲笑我吧，如你所见，是毫无意义的差事。"
                        }
                    ]
                },
                {
                    "id": "4015144103",
                    "text": "你好像很苦恼。",
                    "response": [
                        {
                            "id": "4015144108",
                            "speaker": "盖伊",
                            "text": "是啊，当然很苦恼。"
                        },
                        {
                            "id": "4015144109",
                            "speaker": "盖伊",
                            "text": "8岁锻炼体力，10岁修习剑法，16岁成为见习骑士…"
                        },
                        {
                            "id": "4015144110",
                            "speaker": "盖伊",
                            "text": "作为家里的荣耀的我，却被安排了这样的差事…"
                        },
                        {
                            "id": "4015144111",
                            "speaker": "盖伊",
                            "text": "明明都在骑士团做事，可看守冷清的侧门这样的工作，简直就像没有迪奥娜的猫尾酒馆一样，是没有灵魂的！"
                        },
                        {
                            "id": "4015144112",
                            "speaker": "盖伊",
                            "text": "…话说你有遇到什么麻烦吗？多麻烦的事都行，让我看看能不能帮上忙吧！好歹我也是西风骑士嘛！"
                        },
                        {
                            "id": "4015144113",
                            "speaker": "盖伊",
                            "text": "啊…没有吗…"
                        }
                    ]
                },
                {
                    "id": "4015144104",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "4015144114",
                            "speaker": "盖伊",
                            "text": "这样啊，如果有麻烦请一定来找我…"
                        },
                        {
                            "id": "4015144115",
                            "speaker": "盖伊",
                            "text": "唉，算了，反正我在这种不起眼的地方，你马上就会把我忘了吧…"
                        }
                    ]
                }
            ]
        }
    ]
}