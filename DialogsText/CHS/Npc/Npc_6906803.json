{
    "talkId": "6906803",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "多莉": 12
    },
    "dialogues": [
        {
            "id": "690680301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690680302",
            "speaker": "多莉",
            "text": "好呀好呀。"
        },
        {
            "id": "690680303",
            "speaker": "多莉",
            "text": "那摩拉你准备好了吗？",
            "choices": [
                {
                    "id": "690680304",
                    "text": "为什么这么喜欢摩拉呢？",
                    "response": [
                        {
                            "id": "690680305",
                            "speaker": "多莉",
                            "text": "第一，当然是因为我是商人。"
                        },
                        {
                            "id": "690680306",
                            "speaker": "多莉",
                            "text": "第二，因为摩拉亮晶晶圆滚滚非常漂亮！"
                        },
                        {
                            "id": "690680307",
                            "speaker": "多莉",
                            "text": "第三，只有真心喜欢摩拉，摩拉才会源源不断地跑向你身边。"
                        },
                        {
                            "id": "690680313",
                            "speaker": "多莉",
                            "text": "所以你也要努力赚摩拉爱摩拉喔。"
                        },
                        {
                            "id": "690680314",
                            "speaker": "多莉",
                            "text": "这样子我就可以一直待在你身边，从你手上赚摩拉了。"
                        },
                        {
                            "id": "690680315",
                            "speaker": "多莉",
                            "text": "小跟班，加油加油喔！"
                        }
                    ]
                },
                {
                    "id": "690680308",
                    "text": "多莉为什么要赚那么多摩拉呢？",
                    "response": [
                        {
                            "id": "690680309",
                            "speaker": "多莉",
                            "text": "因为摩拉是世界上最可爱的东西！"
                        },
                        {
                            "id": "690680310",
                            "speaker": "多莉",
                            "text": "而且我再也不想因为摩拉不够，而失去些什么了…"
                        },
                        {
                            "id": "690680311",
                            "speaker": "多莉",
                            "text": "咳咳，总之摩拉能解决世界上的大部分烦恼。"
                        },
                        {
                            "id": "690680312",
                            "speaker": "多莉",
                            "text": "如果有什么是摩拉解决不了的，那么翻倍的摩拉一定就能解决了！"
                        }
                    ]
                }
            ]
        }
    ]
}