{
    "talkId": "6152102",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "葛罗丽": 10
    },
    "dialogues": [
        {
            "id": "615210201",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "615210202",
            "speaker": "葛罗丽",
            "text": "啊…失礼了，应该先自我介绍的，我是葛罗丽。"
        },
        {
            "id": "615210203",
            "speaker": "葛罗丽",
            "text": "我经常会在这里等古德温，祈祷他回来的路上能够避开那些缠人的丘丘人或者深渊教团…早日和我相聚。"
        },
        {
            "id": "615210204",
            "speaker": "葛罗丽",
            "text": "啊我又在自说自话了…能有你陪我聊天，真是令人高兴。",
            "choices": [
                {
                    "id": "615210205",
                    "text": "古德温是？",
                    "response": [
                        {
                            "id": "615210206",
                            "speaker": "葛罗丽",
                            "text": "是我的恋人，他跟随骑士团大团长法尔伽的远征队出城了。"
                        },
                        {
                            "id": "615210207",
                            "speaker": "葛罗丽",
                            "text": "他离开的时候，我虽然有些舍不得，但能加入法尔伽大人的队伍始终是件值得为他高兴的事儿吧。"
                        },
                        {
                            "id": "615210208",
                            "speaker": "葛罗丽",
                            "text": "…可惜我也不知道远征什么时候才结束，所以就只好这样等待了。"
                        }
                    ]
                },
                {
                    "id": "615210209",
                    "text": "关于丘丘人和深渊教团。",
                    "response": [
                        {
                            "id": "615210210",
                            "speaker": "葛罗丽",
                            "text": "你也会觉得他们很烦吧？每天都在添麻烦的家伙们。"
                        },
                        {
                            "id": "615210211",
                            "speaker": "葛罗丽",
                            "text": "听说大多数丘丘人是数百年前忽然出现在提瓦特的，深渊教团…好像也是差不多的时期。"
                        },
                        {
                            "id": "615210212",
                            "speaker": "葛罗丽",
                            "text": "有人说是他们诞生于一场提瓦特的大灾难…可我更怀疑他们是从天空以外的地方来的…"
                        },
                        {
                            "id": "615210213",
                            "speaker": "葛罗丽",
                            "text": "…唔抱歉，我因为看不见，所以经常会一个人想些无聊的事情，请不要在意。"
                        }
                    ]
                }
            ]
        }
    ]
}