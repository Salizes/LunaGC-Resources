{
    "talkId": "7102001",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "小昭": 10
    },
    "dialogues": [
        {
            "id": "710200101",
            "speaker": "小昭",
            "text": "真是受不了…"
        },
        {
            "id": "710200102",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "710200103",
            "speaker": "小昭",
            "text": "最近总务司的工作堆得越来越多，我正在整理每项工作和对应的负责人。"
        },
        {
            "id": "710200104",
            "speaker": "小昭",
            "text": "我刚把关于这些工作的问题整理成单子，但是实在抽不出身去把这些单子送给对应的人…",
            "choices": [
                {
                    "id": "710200105",
                    "text": "我来帮忙。",
                    "response": [
                        {
                            "id": "710200106",
                            "speaker": "小昭",
                            "text": "你愿意帮忙吗？那太好了，这其实也不复杂，需要和他们讲的问题我都已经在单子上写清楚了。"
                        },
                        {
                            "id": "710200107",
                            "speaker": "小昭",
                            "text": "只要把单子交到他们手上，让他们知道问题就行了。"
                        },
                        {
                            "id": "710200112",
                            "speaker": "小昭",
                            "text": "现在最急的两项工作，分别是江舟和小安负责，你把这两份单子交给他们吧。"
                        },
                        {
                            "id": "710200113",
                            "speaker": "小昭",
                            "text": "交到了之后就回来告诉我吧，我就在这等着你。"
                        }
                    ]
                },
                {
                    "id": "710200108",
                    "text": "听起来很复杂…",
                    "response": [
                        {
                            "id": "710200109",
                            "speaker": "小昭",
                            "text": "不，不复杂，需要和他们讲的问题我都已经在单子上写清楚了。"
                        },
                        {
                            "id": "710200110",
                            "speaker": "小昭",
                            "text": "你只要把单子交到他们手上，让他们知道问题所在就行了。"
                        },
                        {
                            "id": "710200111",
                            "speaker": "小昭",
                            "text": "拜托你了，我实在是抽不出身了。"
                        }
                    ]
                }
            ]
        }
    ]
}