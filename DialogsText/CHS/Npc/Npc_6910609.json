{
    "talkId": "6910609",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "玛薇卡": 14
    },
    "dialogues": [
        {
            "id": "691060401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691060402",
            "speaker": "玛薇卡",
            "text": "正好你问起来，我想和你分享一下我的新计划——驰轮车大奖赛！"
        },
        {
            "id": "691060403",
            "speaker": "Player",
            "text": "驰、驰轮…什么？"
        },
        {
            "id": "691060404",
            "speaker": "玛薇卡",
            "text": "哈哈哈，自从来到这里我就在想这件事，这里有如此广阔的空间与壮丽的风景，不利用起来实在有点可惜。"
        },
        {
            "id": "691060405",
            "speaker": "玛薇卡",
            "text": "我们可以打造一条兼具速度感和技巧性的赛道，邀请有兴趣的挑战者前来比拼，决出那个「驰轮车之王」！"
        },
        {
            "id": "691060406",
            "speaker": "玛薇卡",
            "text": "如果赛事成功的话，还能开拓出很高的商业价值，到时候奖品不用愁，进一步发展赛道规模的资金也有了。",
            "choices": [
                {
                    "id": "691060407",
                    "text": "想法是好的，但…",
                    "response": [
                        {
                            "id": "691060409",
                            "speaker": "玛薇卡",
                            "text": "不用担心，关于这个，我已经和希诺宁商量——并且被非常强硬地拒绝了。"
                        },
                        {
                            "id": "691060410",
                            "speaker": "玛薇卡",
                            "text": "她的理由非常充分，在我的计划里至少需要八台驰轮车，但这样做成本会非常非常高，而且也找不到那么多关键的秘源机关材料。"
                        },
                        {
                            "id": "691060411",
                            "speaker": "玛薇卡",
                            "text": "但有目标总比没有好，在实现许多车手一起同场竞速之前，我还有替代方案。"
                        },
                        {
                            "id": "691060412",
                            "speaker": "玛薇卡",
                            "text": "那就是所有人都驾驶我的驰轮车，在相同的赛道上行驶数圈，最后用时最短的人获胜。"
                        },
                        {
                            "id": "691060413",
                            "speaker": "玛薇卡",
                            "text": "不过这个方案希诺宁也是持反对态度，因为驰轮车在设计之初考虑的都是越野与战斗，速度并不是它的长项。"
                        },
                        {
                            "id": "691060414",
                            "speaker": "玛薇卡",
                            "text": "想要举办这个比赛，除了需要大量改造，驰轮车的部件老化速度也会加快很多，养护也会是件麻烦事。"
                        },
                        {
                            "id": "691060415",
                            "speaker": "玛薇卡",
                            "text": "不能因为娱乐性的考虑，而让驰轮车失去原本最重要的功能。"
                        },
                        {
                            "id": "691060416",
                            "speaker": "Player",
                            "text": "她说的也很有道理…"
                        },
                        {
                            "id": "691060417",
                            "speaker": "玛薇卡",
                            "text": "嗯…没错。"
                        },
                        {
                            "id": "691060418",
                            "speaker": "玛薇卡",
                            "text": "这么说的话…欸？如果能设计一个专门用来竞速的驰轮车不就行了吗？"
                        },
                        {
                            "id": "691060419",
                            "speaker": "玛薇卡",
                            "text": "我现在就设计一下，然后找她商量去！"
                        }
                    ]
                },
                {
                    "id": "691060408",
                    "text": "有这么多驰轮车吗？"
                }
            ]
        }
    ]
}