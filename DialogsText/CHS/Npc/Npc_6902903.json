{
    "talkId": "6902903",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 7,
        "可莉": 16
    },
    "dialogues": [
        {
            "id": "690290301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690290302",
            "speaker": "可莉",
            "text": "好耶！要来！可莉喜欢聊天。"
        },
        {
            "id": "690290303",
            "speaker": "可莉",
            "text": "啊…趁着这个机会，把我最近发现的好东西分享给你。",
            "choices": [
                {
                    "id": "690290304",
                    "text": "又有好东西啦？",
                    "response": [
                        {
                            "id": "690290306",
                            "speaker": "可莉",
                            "text": "看这个！超棒的捞鱼网！"
                        },
                        {
                            "id": "690290307",
                            "speaker": "可莉",
                            "text": "我来教你哦！只需要像这样把网伸到湖里…看准时机…"
                        },
                        {
                            "id": "690290308",
                            "speaker": "可莉",
                            "text": "一挑！就能把鱼捞出来啦。"
                        },
                        {
                            "id": "690290309",
                            "speaker": "可莉",
                            "text": "一定要悄悄地埋伏好，一下子出动哦！",
                            "choices": [
                                {
                                    "id": "690290310",
                                    "text": "挺厉害的嘛。",
                                    "response": [
                                        {
                                            "id": "690290311",
                                            "speaker": "可莉",
                                            "text": "嘿嘿，可莉把秘诀都告诉了你。你也会变得像可莉一样厉害的！"
                                        },
                                        {
                                            "id": "690290314",
                                            "speaker": "可莉",
                                            "text": "这种方法…虽然比起平时用炸弹的方法稍微麻烦了一点。"
                                        },
                                        {
                                            "id": "690290315",
                                            "speaker": "可莉",
                                            "text": "捞出来的鱼是滑溜溜的，还活蹦乱跳，不握紧一点就会又蹦回湖里。"
                                        },
                                        {
                                            "id": "690290316",
                                            "speaker": "可莉",
                                            "text": "不过…和鱼这样玩也很有乐趣！",
                                            "choices": [
                                                {
                                                    "id": "690290317",
                                                    "text": "有我在身边的时候，可以放心用炸弹玩哦。",
                                                    "response": [
                                                        {
                                                            "id": "690290318",
                                                            "speaker": "可莉",
                                                            "text": "欸！真的吗？"
                                                        },
                                                        {
                                                            "id": "690290319",
                                                            "speaker": "可莉",
                                                            "text": "那你等等我哦，我马上就可以做出好多炸弹，原材料早就准备好啦！"
                                                        },
                                                        {
                                                            "id": "690290323",
                                                            "speaker": "可莉",
                                                            "text": "嘻嘻，太开心啦！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690290320",
                                                    "text": "下次一起来比赛捞鱼吧。",
                                                    "response": [
                                                        {
                                                            "id": "690290321",
                                                            "speaker": "可莉",
                                                            "text": "好！"
                                                        },
                                                        {
                                                            "id": "690290322",
                                                            "speaker": "可莉",
                                                            "text": "#如果{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}输了的话，晚饭就要拜托你来做哦！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690290312",
                                    "text": "怎么不用「炸」的方法了呢？",
                                    "response": [
                                        {
                                            "id": "690290313",
                                            "speaker": "可莉",
                                            "text": "#因为这是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}的家，不能炸坏了…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690290305",
                    "text": "是什么呢？"
                }
            ]
        }
    ]
}