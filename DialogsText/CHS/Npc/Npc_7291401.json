    "dialogues": [
        {
            "id": "729140101",
            "speaker": "Player",
            "text": "我什么都没听见呢。"
        },
        {
            "id": "729140102",
            "speaker": "柚子",
            "text": "呜…你真好…"
        },
        {
            "id": "729140103",
            "speaker": "柚子",
            "text": "唉，真想和你这样的外国旅行者一样，去隔海相望的璃月，甚至更远一些的蒙德看看啊…"
        },
        {
            "id": "729140104",
            "speaker": "柚子",
            "text": "听说蒙德人生活无忧无虑，自由自在，我什么时候才能体验到呢…"
        }
    ]
