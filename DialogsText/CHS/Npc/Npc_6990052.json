{
    "talkId": "6990052",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 7,
        "派蒙": 8
    },
    "dialogues": [
        {
            "id": "699005201",
            "speaker": "Player",
            "text": "关于北大陆情报网…"
        },
        {
            "id": "699005202",
            "speaker": "派蒙",
            "text": "「北大陆情报网」…听上去很有神秘结社的气氛呢！"
        },
        {
            "id": "699005203",
            "speaker": "派蒙",
            "text": "平时不为人知，却能在暗中操纵情报，牵动整个世界的流向！",
            "choices": [
                {
                    "id": "699005204",
                    "text": "也没有那么不为人知吧…",
                    "response": [
                        {
                            "id": "699005206",
                            "speaker": "派蒙",
                            "text": "欸，你说我们有没有机会加入进去？我想想代号…比如说…「白金」！",
                            "choices": [
                                {
                                    "id": "699005207",
                                    "text": "白发和金发吗…",
                                    "response": [
                                        {
                                            "id": "699005209",
                                            "speaker": "派蒙",
                                            "text": "给自己起奇怪的代号就太奇怪了吧！"
                                        },
                                        {
                                            "id": "699005210",
                                            "speaker": "派蒙",
                                            "text": "说起来，西风骑士团不也跟他们合作上了吗？法尔伽的代号会是什么？「团长」？"
                                        },
                                        {
                                            "id": "699005211",
                                            "speaker": "派蒙",
                                            "text": "唔…不过那位大团长做起情报工作，会是什么风格呢…"
                                        },
                                        {
                                            "id": "699005212",
                                            "speaker": "派蒙",
                                            "text": "不会是正大光明地杀进敌人据点，然后大摇大摆地拿着情报出来吧？",
                                            "choices": [
                                                {
                                                    "id": "699005213",
                                                    "text": "…我怀疑身为「团长」。",
                                                    "response": [
                                                        {
                                                            "id": "699005215",
                                                            "speaker": "派蒙",
                                                            "text": "对哦！…不对！那这下秘密结社里就真的全是熟人了！太不秘密了！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "699005214",
                                                    "text": "大概率会让凯亚跟罗莎莉亚来代班。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "699005208",
                                    "text": "这次意外得很正常呢。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699005205",
                    "text": "我们不也有熟人在里面。"
                }
            ]
        }
    ]
}