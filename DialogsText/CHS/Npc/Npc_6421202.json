    "dialogues": [
        {
            "id": "642120201",
            "speaker": "Player",
            "text": "你在发愁？"
        },
        {
            "id": "642120202",
            "speaker": "兰耶师",
            "text": "啊，是金色的那菈…"
        },
        {
            "id": "642120203",
            "speaker": "兰耶师",
            "text": "真是惭愧…无忧节应该是大家都快乐的节日。但是我一想到如果有很坏很坏的家伙在这种时候闯进来，就不好了。"
        },
        {
            "id": "642120204",
            "speaker": "兰耶师",
            "text": "所以，有些不快乐…"
        }
    ]
