    "speaker_counts": {
        "Player": 4,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699001401",
            "speaker": "Player",
            "text": "关于努力与回报…"
        },
        {
            "id": "699001402",
            "speaker": "派蒙",
            "text": "我发现，在蒙德努力工作不一定会有回报呢。"
        },
        {
            "id": "699001403",
            "speaker": "Player",
            "text": "为什么这么说？"
        },
        {
            "id": "699001404",
            "speaker": "派蒙",
            "text": "你看西风骑士的霍夫曼先生，每天尽职尽责…"
        },
        {
            "id": "699001405",
            "speaker": "派蒙",
            "text": "可那位总是很轻松悠闲的凯亚先生，却是他的上司。",
            "choices": [
                {
                    "id": "699001406",
                    "text": "嗯…可是最辛苦的琴…",
                    "response": [
                        {
                            "id": "699001408",
                            "speaker": "派蒙",
                            "text": "那、那论地位来讲的话…"
                        },
                        {
                            "id": "699001409",
                            "speaker": "派蒙",
                            "text": "最懒散的温迪，还是整个蒙德城的神明呢！"
                        }
                    ]
                },
                {
                    "id": "699001407",
                    "text": "当上了代理团长呀？"
                }
            ]
        }
    ]
}