{
    "talkId": "6614401",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "雷格巴": 9
    },
    "dialogues": [
        {
            "id": "661440101",
            "speaker": "雷格巴",
            "text": "嗯，哈，原来是你呀，怎么样，最近还顺利吗？"
        },
        {
            "id": "661440102",
            "speaker": "雷格巴",
            "text": "如果觉得累了，倒是可以在这里好好休息一会儿，没关系，有我为你望风。",
            "choices": [
                {
                    "id": "661440103",
                    "text": "关于头上有印记的幼龙…",
                    "response": [
                        {
                            "id": "661440104",
                            "speaker": "雷格巴",
                            "text": "#啊，你是说{REALNAME[ID(2)|SHOWHOST(true)]}头上的印记？"
                        },
                        {
                            "id": "661440105",
                            "speaker": "雷格巴",
                            "text": "听说有那样印记的幼龙都会比其他的幼龙强壮…不过，那大概只是传闻吧，抱歉，我对龙的事可是一窍不通啊。"
                        }
                    ]
                },
                {
                    "id": "661440106",
                    "text": "关于「大灵」意志的显化…",
                    "response": [
                        {
                            "id": "661440107",
                            "speaker": "雷格巴",
                            "text": "据说那就是「大灵」的一缕意志，很多部族人都见过，按照部族的说法，「它们自有出现在地上的理由」。"
                        },
                        {
                            "id": "661440108",
                            "speaker": "雷格巴",
                            "text": "就比如…黑曜石像被盗之类的，哈哈。"
                        },
                        {
                            "id": "661440109",
                            "speaker": "雷格巴",
                            "text": "不过大多数时候部族的人都会悄悄绕过它们，啊，叙事人的故事里它们倒是经常出场…"
                        },
                        {
                            "id": "661440110",
                            "speaker": "雷格巴",
                            "text": "给勇士以试炼，给贪婪小人以责罚，或者指引英雄们走向正途…诸如此类的。"
                        }
                    ]
                },
                {
                    "id": "661440111",
                    "text": "没事，我马上就要离开了…",
                    "response": [
                        {
                            "id": "661440112",
                            "speaker": "雷格巴",
                            "text": "好，记得路上小心。"
                        }
                    ]
                }
            ]
        }
    ]
}