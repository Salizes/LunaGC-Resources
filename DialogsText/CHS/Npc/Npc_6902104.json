{
    "talkId": "6902104",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "安柏": 13
    },
    "dialogues": [
        {
            "id": "690210401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690210402",
            "speaker": "安柏",
            "text": "我想和你一起吃晚饭！"
        },
        {
            "id": "690210403",
            "speaker": "安柏",
            "text": "即使是再平常不过的用餐，在餐馆里和在家里是完全不一样的感觉。"
        },
        {
            "id": "690210404",
            "speaker": "安柏",
            "text": "餐馆里虽然很方便，味道也有保证。"
        },
        {
            "id": "690210405",
            "speaker": "安柏",
            "text": "但只有在家里，才有那种独一无二的温暖感。",
            "choices": [
                {
                    "id": "690210406",
                    "text": "嗯，我明白。",
                    "response": [
                        {
                            "id": "690210407",
                            "speaker": "安柏",
                            "text": "对吧！那就来嘛！"
                        },
                        {
                            "id": "690210410",
                            "speaker": "安柏",
                            "text": "我来做烤肉，唔…不行，「侦察骑士烤肉」的味道你早就熟悉了。"
                        },
                        {
                            "id": "690210411",
                            "speaker": "安柏",
                            "text": "我得对自己提出更高的要求。"
                        },
                        {
                            "id": "690210412",
                            "speaker": "安柏",
                            "text": "好，干脆，这次就来挑战蜜酱胡萝卜煎肉吧！"
                        },
                        {
                            "id": "690210413",
                            "speaker": "安柏",
                            "text": "啊…不会把你厨房的屋顶熏黑吧…"
                        },
                        {
                            "id": "690210414",
                            "speaker": "Player",
                            "text": "熏黑也没有关系。"
                        },
                        {
                            "id": "690210415",
                            "speaker": "Player",
                            "text": "我也会一起帮忙。"
                        },
                        {
                            "id": "690210416",
                            "speaker": "安柏",
                            "text": "嘿嘿，你对我真好。"
                        },
                        {
                            "id": "690210417",
                            "speaker": "安柏",
                            "text": "我一定会拿出最美味的成品，和你共享。哪怕失败几百遍也不会放弃的！"
                        },
                        {
                            "id": "690210418",
                            "speaker": "安柏",
                            "text": "真期待啊…"
                        }
                    ]
                },
                {
                    "id": "690210408",
                    "text": "那就一起吃晚饭吧。",
                    "response": [
                        {
                            "id": "690210409",
                            "speaker": "安柏",
                            "text": "真的吗？！"
                        }
                    ]
                }
            ]
        }
    ]
}