{
    "talkId": "6220806",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "菲尔戈黛特": 10
    },
    "dialogues": [
        {
            "id": "622080601",
            "speaker": "Player",
            "text": "你好老板娘。"
        },
        {
            "id": "622080602",
            "speaker": "菲尔戈黛特",
            "text": "唉…说了多少次了，不是老板娘。"
        },
        {
            "id": "622080603",
            "speaker": "菲尔戈黛特",
            "text": "我是这家望舒客栈的老板哦。"
        },
        {
            "id": "622080604",
            "speaker": "菲尔戈黛特",
            "text": "是、老、板。",
            "choices": [
                {
                    "id": "622080205",
                    "text": "有些传闻…",
                    "response": [
                        {
                            "id": "622080206",
                            "speaker": "菲尔戈黛特",
                            "text": "哈哈哈，能在这里开店，怎么可能和七星没有关系呢。"
                        },
                        {
                            "id": "622080207",
                            "speaker": "菲尔戈黛特",
                            "text": "我意思是，肯定需要他们同意嘛。"
                        },
                        {
                            "id": "622080208",
                            "speaker": "菲尔戈黛特",
                            "text": "其他一些有的没的，那当然都是谣言啦。"
                        },
                        {
                            "id": "622080209",
                            "speaker": "菲尔戈黛特",
                            "text": "这么说来，您听到过什么有意思的事情吗？"
                        }
                    ]
                },
                {
                    "id": "622080210",
                    "text": "关于这猫…",
                    "response": [
                        {
                            "id": "622080211",
                            "speaker": "菲尔戈黛特",
                            "text": "唉…这猫是自己跟来的，不过看着挺可爱的就留下了。"
                        },
                        {
                            "id": "622080212",
                            "speaker": "菲尔戈黛特",
                            "text": "名字吗，叫阿伟，随便起的。"
                        },
                        {
                            "id": "622080213",
                            "speaker": "菲尔戈黛特",
                            "text": "它可能会捣蛋一下，猫嘛，是这样的。您可千万别和它一般见识。"
                        }
                    ]
                }
            ]
        }
    ]
}