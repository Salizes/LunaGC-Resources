        {
            "id": "651130201",
            "speaker": "Player",
            "text": "你喜欢魔术吗？"
        },
        {
            "id": "651130202",
            "speaker": "布蕾莘",
            "text": "嗯。"
        },
        {
            "id": "651130203",
            "speaker": "布蕾莘",
            "text": "我的眼神很好，可以看清案发现场的蛛丝马迹，但魔术的奥妙我却看不懂。"
        },
        {
            "id": "651130204",
            "speaker": "布蕾莘",
            "text": "能骗过美露莘的眼睛，魔术师真是伟大的职业呀。"
        }
    ]
}