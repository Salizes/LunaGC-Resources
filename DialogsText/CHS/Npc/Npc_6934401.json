    "dialogues": [
        {
            "id": "693440101",
            "speaker": "申鹤",
            "text": "遵照师父嘱托，每当我胸中气息躁动时，我应静心打坐，摈弃杂念。"
        },
        {
            "id": "693440102",
            "speaker": "申鹤",
            "text": "若是丢了本心，只剩杀性，只怕会殃及身边人…"
        },
        {
            "id": "693440103",
            "speaker": "申鹤",
            "text": "这是我绝不愿见到的。"
        }
    ]
}