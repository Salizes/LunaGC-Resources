{
    "talkId": "7167005",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "齐勇": 10
    },
    "dialogues": [
        {
            "id": "716700501",
            "speaker": "齐勇",
            "text": "#原来是您，侠士{NICKNAME}，有新指示吗？",
            "choices": [
                {
                    "id": "716700502",
                    "text": "侠士？",
                    "response": [
                        {
                            "id": "716700503",
                            "speaker": "齐勇",
                            "text": "方谨长官说，你得知此地的险情后，毅然前来助阵…"
                        },
                        {
                            "id": "716700504",
                            "speaker": "齐勇",
                            "text": "即便了解到紊乱秘境中的凶险，也丝毫不曾感到畏惧，而是锐不可当地攻入敌营…"
                        },
                        {
                            "id": "716700505",
                            "speaker": "齐勇",
                            "text": "这股侠义之气实在令人钦佩！",
                            "choices": [
                                {
                                    "id": "716700506",
                                    "text": "我只是喜欢帮助好人！",
                                    "response": [
                                        {
                                            "id": "716700508",
                                            "speaker": "齐勇",
                                            "text": "您过谦了！我还想向您请教用剑的武艺，还望您不嫌麻烦…"
                                        },
                                        {
                                            "id": "716700509",
                                            "speaker": "齐勇",
                                            "text": "不过眼下的任务是保持戒备，随时做好迎敌的准备，只能等个合适的时机了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "716700507",
                                    "text": "还有很多真正的侠士！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "716700510",
                    "text": "指示？",
                    "response": [
                        {
                            "id": "716700511",
                            "speaker": "齐勇",
                            "text": "方谨长官确认了，您与我部达成了长期合作，必要时，我部会全力协助您作战。"
                        },
                        {
                            "id": "716700512",
                            "speaker": "齐勇",
                            "text": "当然，即使当前的阵线已相当稳固，我部也不能擅离职守，若是您想去附近清剿其他魔物，请恕我部难以配合。",
                            "choices": [
                                {
                                    "id": "716700513",
                                    "text": "不会不会，守好这里最重要！",
                                    "response": [
                                        {
                                            "id": "716700515",
                                            "speaker": "齐勇",
                                            "text": "没错，我们都相信，即便是面对各种情况都游刃有余的您，也会一丝不苟，专注于应对眼前的威胁。"
                                        }
                                    ]
                                },
                                {
                                    "id": "716700514",
                                    "text": "防住地脉紊乱点才是核心任务！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "716700516",
                    "text": "不干扰你了，请保持专注。",
                    "response": [
                        {
                            "id": "716700517",
                            "speaker": "齐勇",
                            "text": "竟如此体谅友军…真有大将风范！"
                        }
                    ]
                }
            ]
        }
    ]
}