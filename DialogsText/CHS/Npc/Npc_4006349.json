    "dialogues": [
        {
            "id": "400634901",
            "speaker": "葵之翁像",
            "text": "（阿贝多绘制的葵之翁画像。）"
        },
        {
            "id": "400634902",
            "speaker": "葵之翁像",
            "text": "（此画像以行秋为模特，亦融合了其身上璃月服饰的特色，绘制了葵之翁带走自己诗作的情景。）"
        },
        {
            "id": "400634903",
            "speaker": "葵之翁像",
            "text": "（虽然资料里说葵之翁是位老者来着…嗯，没关系没关系，神子是不会在意的！）"
        }
    ]
}