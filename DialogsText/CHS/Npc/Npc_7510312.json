    "dialogues": [
        {
            "id": "751031201",
            "speaker": "帕尼娅",
            "text": "嗯，今天要玩什么呢…我想想，要不然就和伊瓦伊一起锻炼好啦。"
        },
        {
            "id": "751031202",
            "speaker": "伊瓦伊",
            "text": "呜，呜！"
        },
        {
            "id": "751031203",
            "speaker": "帕尼娅",
            "text": "嗯嗯，很有精神呢。既然如此，伊瓦伊就先以「能一次撞飞三只浮流鸟」为目标，开始训练吧。"
        },
        {
            "id": "751031204",
            "speaker": "伊瓦伊",
            "text": "呜？！"
        },
        {
            "id": "751031205",
            "speaker": "帕尼娅",
            "text": "开玩笑的啦。不过，果然还是要多做锻炼才行呢…"
        }
    ]
}