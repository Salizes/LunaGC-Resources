{
    "talkId": "6901413",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "芭芭拉": 12
    },
    "dialogues": [
        {
            "id": "690141301",
            "speaker": "芭芭拉",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690140901",
            "speaker": "芭芭拉",
            "text": "啊，我最近练习了一首新的曲子。"
        },
        {
            "id": "690140902",
            "speaker": "芭芭拉",
            "text": "但有些细节我还把握不好…"
        },
        {
            "id": "690140903",
            "speaker": "芭芭拉",
            "text": "副歌在重复的时候要不要升个调，舞步有没有优化的空间…"
        },
        {
            "id": "690140904",
            "speaker": "芭芭拉",
            "text": "如果不麻烦你的话，我希望你能看我的表演，再给我一些建议。",
            "choices": [
                {
                    "id": "690140905",
                    "text": "我会为你「全力应援」。",
                    "response": [
                        {
                            "id": "690140907",
                            "speaker": "芭芭拉",
                            "text": "谢谢…"
                        },
                        {
                            "id": "690140908",
                            "speaker": "芭芭拉",
                            "text": "唔…如果有不成熟的地方，不要笑话我哦。"
                        },
                        {
                            "id": "690140909",
                            "speaker": "芭芭拉",
                            "text": "我思考过很多次，现在是鼓起勇气，才敢在那么近的地方表演给你看的。"
                        },
                        {
                            "id": "690140910",
                            "speaker": "芭芭拉",
                            "text": "要是你笑话我的话，我都不知道要往哪里躲…",
                            "choices": [
                                {
                                    "id": "690140911",
                                    "text": "不会的，放心吧。",
                                    "response": [
                                        {
                                            "id": "690140913",
                                            "speaker": "芭芭拉",
                                            "text": "呼…好。"
                                        },
                                        {
                                            "id": "690140914",
                                            "speaker": "芭芭拉",
                                            "text": "那么…"
                                        },
                                        {
                                            "id": "690140915",
                                            "speaker": "芭芭拉",
                                            "text": "演唱，开始！"
                                        }
                                    ]
                                },
                                {
                                    "id": "690140912",
                                    "text": "我相信你哦，芭芭拉也要相信自己。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690140906",
                    "text": "这是我的荣幸。"
                }
            ]
        }
    ]
}