        "Player": 2,
        "鉴秋": 5
    },
    "dialogues": [
        {
            "id": "624050301",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "624050302",
            "speaker": "鉴秋",
            "text": "我在吃虎岩做过几年算术老师，都是些穷人家的孩子。"
        },
        {
            "id": "624050303",
            "speaker": "鉴秋",
            "text": "而现在我是明华钱庄掌柜家的…雇员。"
        },
        {
            "id": "624050304",
            "speaker": "鉴秋",
            "text": "此次出行是为了保护小姐一路安全。"
        },
        {
            "id": "624050305",
            "speaker": "Player",
            "text": "你们要去哪里？"
        },
        {
            "id": "624050306",
            "speaker": "鉴秋",
            "text": "天空岛吧。"
        },
        {
            "id": "624050307",
            "speaker": "鉴秋",
            "text": "呵呵，开玩笑…我们此行的目的不便透露，抱歉。"
        }
    ]
}