    "dialogues": [
        {
            "id": "650130301",
            "speaker": "Player",
            "text": "这里的重点是工作吗？"
        },
        {
            "id": "650130302",
            "speaker": "普吕尼埃",
            "text": "对我来说是的。"
        },
        {
            "id": "650130303",
            "speaker": "普吕尼埃",
            "text": "我记得那个被放倒的倒霉蛋好像是个小偷吧？算是罪有应得。"
        },
        {
            "id": "650130304",
            "speaker": "普吕尼埃",
            "text": "后来好像还有个什么记者跑过来想要采访，被我赶走了。治安问题我哪懂啊，又不是我该考虑的事情。"
        },
        {
            "id": "650130305",
            "speaker": "普吕尼埃",
            "text": "而且，附近不是一直有个穿便服的美露莘在盯着吗？"
        }
    ]
}