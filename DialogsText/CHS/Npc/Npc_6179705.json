    "dialogues": [
        {
            "id": "617970502",
            "speaker": "科赫",
            "text": "居然！太走运了…"
        },
        {
            "id": "617970503",
            "speaker": "科赫",
            "text": "这是我为了试制新零件，自掏腰包买下的金属材料！"
        },
        {
            "id": "617970504",
            "speaker": "科赫",
            "text": "之前我托商人们自行从陆路运来，结果货物在野外被不明魔物劫走，不知下落…"
        },
        {
            "id": "617970505",
            "speaker": "科赫",
            "text": "我本来无比头疼，还想着请个假去找找看，这下问题全都解决了！"
        },
        {
            "id": "617970506",
            "speaker": "科赫",
            "text": "太感谢你了！"
        }
    ]
}