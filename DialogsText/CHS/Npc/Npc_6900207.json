{
    "talkId": "6900207",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "神里绫华": 10
    },
    "dialogues": [
        {
            "id": "690020701",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690020202",
            "speaker": "神里绫华",
            "text": "呵呵，敬请放心。"
        },
        {
            "id": "690020203",
            "speaker": "神里绫华",
            "text": "这里有别于神里家的布景，移步之间，处处都有新奇感。"
        },
        {
            "id": "690020204",
            "speaker": "神里绫华",
            "text": "因为是你的居所，意义就更加不同。",
            "choices": [
                {
                    "id": "690020205",
                    "text": "不必拘束，当作自己家也可以。",
                    "response": [
                        {
                            "id": "690020206",
                            "speaker": "神里绫华",
                            "text": "啊…"
                        },
                        {
                            "id": "690020207",
                            "speaker": "神里绫华",
                            "text": "那样的话就太失礼了…"
                        },
                        {
                            "id": "690020208",
                            "speaker": "神里绫华",
                            "text": "不过…你的好意…我拜领了。"
                        },
                        {
                            "id": "690020212",
                            "speaker": "Player",
                            "text": "绫华客气了。"
                        },
                        {
                            "id": "690020213",
                            "speaker": "神里绫华",
                            "text": "呵呵…谢谢你那么为我着想，但请你也不要因此勉强自己。"
                        },
                        {
                            "id": "690020214",
                            "speaker": "神里绫华",
                            "text": "如果有我能相助之处，希望我也能帮上你。"
                        }
                    ]
                },
                {
                    "id": "690020209",
                    "text": "希望绫华能够放下包袱，随意休息。",
                    "response": [
                        {
                            "id": "690020210",
                            "speaker": "神里绫华",
                            "text": "嗯…你的好意我拜领了。"
                        },
                        {
                            "id": "690020211",
                            "speaker": "神里绫华",
                            "text": "「随意休息」愧不敢当，不过能在这里小憩片刻，对我来说的确是非常值得感谢的事情。"
                        }
                    ]
                }
            ]
        }
    ]
}