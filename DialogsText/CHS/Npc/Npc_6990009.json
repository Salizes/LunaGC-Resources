{
    "talkId": "6990009",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 8,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699000901",
            "speaker": "Player",
            "text": "关于果酒湖…"
        },
        {
            "id": "699000902",
            "speaker": "派蒙",
            "text": "果酒湖是不冻湖，一整年里都不会结冰。"
        },
        {
            "id": "699000903",
            "speaker": "派蒙",
            "text": "蒙德最好的苹果酒，只能用这座湖里的甜水来酿。"
        },
        {
            "id": "699000904",
            "speaker": "派蒙",
            "text": "湖水真的很好喝！我一秒就能喝掉两大瓶。"
        },
        {
            "id": "699000905",
            "speaker": "Player",
            "text": "真是惊人。"
        },
        {
            "id": "699000906",
            "speaker": "派蒙",
            "text": "哼哼。"
        },
        {
            "id": "699000907",
            "speaker": "Player",
            "text": "派蒙这样的体型，喝这么多水…",
            "choices": [
                {
                    "id": "699000908",
                    "text": "居然不会像风史莱姆那样…",
                    "response": [
                        {
                            "id": "699000910",
                            "speaker": "派蒙",
                            "text": "哼哼。装好喝的饮料的是另一个胃。"
                        },
                        {
                            "id": "699000911",
                            "speaker": "Player",
                            "text": "嗯…世界真是广大。",
                            "choices": [
                                {
                                    "id": "699000912",
                                    "text": "需要花时间去思考的见闻…"
                                },
                                {
                                    "id": "699000913",
                                    "text": "还有很多…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "699000909",
                    "text": "炸到漏气满天飞…"
                }
            ]
        }
    ]
}