    "dialogues": [
        {
            "id": "662760101",
            "speaker": "耶里门",
            "text": "呕…不、不好意思，先、先让我歇会儿…",
            "choices": [
                {
                    "id": "662760102",
                    "text": "你没事吧？",
                    "response": [
                        {
                            "id": "662760104",
                            "speaker": "耶里门",
                            "text": "没、没事，咳，就是之前飞得太快，现在有点难受…"
                        },
                        {
                            "id": "662760105",
                            "speaker": "耶里门",
                            "text": "虽然特马乔说不用担心，大家都有过这个阶段，可是连塔卢加都一副云淡风轻的样子，他不会只是在安慰我吧？"
                        }
                    ]
                },
                {
                    "id": "662760103",
                    "text": "你先休息。",
                    "response": [
                        {
                            "id": "662760106",
                            "speaker": "耶里门",
                            "text": "谢谢…"
                        }
                    ]
                }
            ]
        }
