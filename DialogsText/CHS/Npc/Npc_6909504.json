{
    "talkId": "6909504",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "希格雯": 19
    },
    "dialogues": [
        {
            "id": "690950401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690950402",
            "speaker": "希格雯",
            "text": "看来你也正好闲下来了呢。"
        },
        {
            "id": "690950403",
            "speaker": "希格雯",
            "text": "想试试我新调制的护肤品吗？这次是一种面部软膏。",
            "choices": [
                {
                    "id": "690950404",
                    "text": "能返老还童吗？",
                    "response": [
                        {
                            "id": "690950405",
                            "speaker": "希格雯",
                            "text": "据我所知，暂时没有任何产品可以达到这样的效果。"
                        },
                        {
                            "id": "690950406",
                            "speaker": "希格雯",
                            "text": "如果有人跟你这么介绍的话，我建议上报给附近的警卫队，说不定这个人很快就要来梅洛彼得堡报到了。"
                        },
                        {
                            "id": "690950411",
                            "speaker": "希格雯",
                            "text": "还是不要对护肤和美容产品抱有不切实际的期待比较好哟。人类明明怎么样都很可爱很好看。"
                        },
                        {
                            "id": "690950412",
                            "speaker": "Player",
                            "text": "那最好看的人长什么样？"
                        },
                        {
                            "id": "690950413",
                            "speaker": "希格雯",
                            "text": "很遗憾我没办法回答这个问题呢。在我眼中人类没有美丑的区别，大家各有各的迷人之处。"
                        },
                        {
                            "id": "690950414",
                            "speaker": "希格雯",
                            "text": "而且，不管是谁，都没有资格给别人的长相外貌评分，更别说擅自做比较了。"
                        },
                        {
                            "id": "690950415",
                            "speaker": "希格雯",
                            "text": "就算是最高审判官那维莱特先生也不可以评判任何人的外貌哦。哦，但请放心，他是绝对不会这样做的。"
                        },
                        {
                            "id": "690950416",
                            "speaker": "希格雯",
                            "text": "说来我在《花容美谭》收到的大部分来信，都在抱怨自己长得不好看，想问我变好看的方法。"
                        },
                        {
                            "id": "690950417",
                            "speaker": "希格雯",
                            "text": "唉，我很难过为什么人类要对自己这么苛刻呢？"
                        },
                        {
                            "id": "690950418",
                            "speaker": "希格雯",
                            "text": "我分享美容技巧的初衷，是想要大家重视起自己这副可爱的模样，从而好好护理自己的皮肤，认真爱自己。"
                        },
                        {
                            "id": "690950419",
                            "speaker": "希格雯",
                            "text": "你也是哦，关注自己的外貌是好事，但前提是——要先肯定自己的可爱哟。",
                            "choices": [
                                {
                                    "id": "690950420",
                                    "text": "很有启发！",
                                    "response": [
                                        {
                                            "id": "690950421",
                                            "speaker": "希格雯",
                                            "text": "嘻嘻。对你有帮助就好。"
                                        },
                                        {
                                            "id": "690950424",
                                            "speaker": "希格雯",
                                            "text": "嗯…言归正传，我们还是快点开始试用新品吧。"
                                        },
                                        {
                                            "id": "690950425",
                                            "speaker": "希格雯",
                                            "text": "我已经迫不及待想看你全脸涂满紫色软膏的样子了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690950422",
                                    "text": "没错！我真可爱！",
                                    "response": [
                                        {
                                            "id": "690950423",
                                            "speaker": "希格雯",
                                            "text": "没错！你真可爱！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690950407",
                    "text": "能青春永驻吗？",
                    "response": [
                        {
                            "id": "690950408",
                            "speaker": "希格雯",
                            "text": "如果人类各种时刻的样子汇集成一本画片册，那护肤品就是画框。"
                        },
                        {
                            "id": "690950409",
                            "speaker": "希格雯",
                            "text": "在保护画片的同时点缀画面，让整个画面更有特点。"
                        },
                        {
                            "id": "690950410",
                            "speaker": "希格雯",
                            "text": "而不是把画片册上锁，这样不就看不到新的画片了，多可惜呀。"
                        }
                    ]
                }
            ]
        }
    ]
}