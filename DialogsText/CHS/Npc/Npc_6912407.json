{
    "talkId": "6912407",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "雅珂达": 15
    },
    "dialogues": [
        {
            "id": "691240201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691240202",
            "speaker": "雅珂达",
            "text": "吃的好睡的好，住的也特别好，没有什么不习惯的。"
        },
        {
            "id": "691240203",
            "speaker": "Player",
            "text": "但你怎么看着有点黑眼圈…"
        },
        {
            "id": "691240204",
            "speaker": "雅珂达",
            "text": "咦？欸？真的，有这么明显？"
        },
        {
            "id": "691240205",
            "speaker": "雅珂达",
            "text": "好吧，我承认，昨天晚上我失眠了，折腾了好久才勉强睡着。"
        },
        {
            "id": "691240206",
            "speaker": "雅珂达",
            "text": "失眠的原因…是因为这里的环境有点太好了，床很软，被子很轻，周围也很安静…",
            "choices": [
                {
                    "id": "691240207",
                    "text": "太、太好了？",
                    "response": [
                        {
                            "id": "691240209",
                            "speaker": "雅珂达",
                            "text": "是啊…这是我的老毛病了，越是待在舒适的地方，我就会越不适应，根本无法安心休息。"
                        },
                        {
                            "id": "691240210",
                            "speaker": "雅珂达",
                            "text": "就算是勉强酝酿了一些睡意，但在入睡的前一个刹那，我总是会一下子清醒过来…"
                        },
                        {
                            "id": "691240211",
                            "speaker": "雅珂达",
                            "text": "然后，我要么猛地从床上弹起来，本能地环顾四周；要么是把手伸进枕头底下，试图摸到什么东西。"
                        },
                        {
                            "id": "691240212",
                            "speaker": "雅珂达",
                            "text": "当然啦，大部分情况下，房间里只有我一个人，枕头底下也什么都没有…然后，我就一身冷汗地重新睡下，开始享受失眠的感觉。"
                        },
                        {
                            "id": "691240213",
                            "speaker": "雅珂达",
                            "text": "我刚到「秘闻馆」的时候，这种情况最严重，无论怎么样都睡不着，最后我只能悄悄跑去大厅，在沙发上躺下，这才算是睡着了…"
                        },
                        {
                            "id": "691240214",
                            "speaker": "雅珂达",
                            "text": "当我醒过来的时候，只看见奈姐抱着阿舍鲁，笑眯眯地盯着我看。"
                        },
                        {
                            "id": "691240215",
                            "speaker": "雅珂达",
                            "text": "唉，我当时魂都差点吓飞了…"
                        },
                        {
                            "id": "691240216",
                            "speaker": "Player",
                            "text": "那现在你适应了么？"
                        },
                        {
                            "id": "691240217",
                            "speaker": "雅珂达",
                            "text": "还没适应呢，但奈姐从稻妻弄来了一批…呃，我忘记叫什么了…总之是一批特殊的地垫吧…"
                        },
                        {
                            "id": "691240218",
                            "speaker": "雅珂达",
                            "text": "她让人把地垫铺在我房间里的地板上，说如果以后睡不着，可以直接睡在那些地垫上，这样至少不会着凉。"
                        },
                        {
                            "id": "691240219",
                            "speaker": "雅珂达",
                            "text": "嘿嘿，奈姐对我可好了，不愧是我最尊敬最亲爱，全世界最好最好的老板！"
                        },
                        {
                            "id": "691240220",
                            "speaker": "Player",
                            "text": "那我也给你换张床吧。"
                        },
                        {
                            "id": "691240221",
                            "speaker": "雅珂达",
                            "text": "没事没事，我现在已经学会如何习惯一张新床了，等我再适应适应就好，不用这么麻烦的。"
                        }
                    ]
                },
                {
                    "id": "691240208",
                    "text": "这也能导致失眠？"
                }
            ]
        }
    ]
}