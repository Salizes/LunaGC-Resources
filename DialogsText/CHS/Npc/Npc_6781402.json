    "dialogues": [
        {
            "id": "678140201",
            "speaker": "Player",
            "text": "你这儿卖什么？"
        },
        {
            "id": "678140202",
            "speaker": "艾瓦佐夫斯基",
            "text": "对不住，现在没开张。"
        },
        {
            "id": "678140203",
            "speaker": "艾瓦佐夫斯基",
            "text": "刚才在列车上摆摊，被列车员逮住了，说我违反了什么规定…不过那时我的货已经清掉了，哈哈。"
        },
        {
            "id": "678140204",
            "speaker": "艾瓦佐夫斯基",
            "text": "所以现在手头上也没什么好东西出售了，还请您下次再光顾了。"
        }
    ]
}