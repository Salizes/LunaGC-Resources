    "speaker_counts": {
        "Player": 1,
        "贾扬特": 5
    },
    "dialogues": [
        {
            "id": "641670201",
            "speaker": "Player",
            "text": "好随便的缘分。"
        },
        {
            "id": "641670202",
            "speaker": "贾扬特",
            "text": "哈哈，话不能这么说。"
        },
        {
            "id": "641670203",
            "speaker": "贾扬特",
            "text": "就连每天流到港口的浪花都未必来自同一片海域，你我在这里相遇，不是奇迹又是什么？"
        },
        {
            "id": "641670204",
            "speaker": "贾扬特",
            "text": "你来自哪里呀？跟我说说吧。"
        },
        {
            "id": "641670205",
            "speaker": "贾扬特",
            "text": "我见多识广，无论是在至冬冰钓，还是去枫丹划船，我都略知一二。"
        },
        {
            "id": "641670206",
            "speaker": "贾扬特",
            "text": "所以，想聊什么都可以。"
        }
    ]
}