{
    "talkId": "6905704",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "荒泷一斗": 18
    },
    "dialogues": [
        {
            "id": "690570401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690570402",
            "speaker": "荒泷一斗",
            "text": "来得正好！有件很重要的事，要当面问你才行。"
        },
        {
            "id": "690570403",
            "speaker": "荒泷一斗",
            "text": "那个什么冒险家协会里都有些什么活？你一般选什么类型的？"
        },
        {
            "id": "690570404",
            "speaker": "Player",
            "text": "你想要加入冒险家协会吗？"
        },
        {
            "id": "690570405",
            "speaker": "荒泷一斗",
            "text": "哈？怎么可能！"
        },
        {
            "id": "690570406",
            "speaker": "荒泷一斗",
            "text": "你不是隔三差五就跑去那个地方吗？看起来很忙嘛…"
        },
        {
            "id": "690570407",
            "speaker": "荒泷一斗",
            "text": "我让弟兄们一起来帮你忙！人多好办事！",
            "choices": [
                {
                    "id": "690570408",
                    "text": "居然是为了帮我吗…",
                    "response": [
                        {
                            "id": "690570409",
                            "speaker": "荒泷一斗",
                            "text": "等等…什么叫「居然」？！你这么说我就不高兴了。"
                        },
                        {
                            "id": "690570410",
                            "speaker": "荒泷一斗",
                            "text": "帮你可不是「居然」，是「理所当然」，给本大爷好好记住了！"
                        },
                        {
                            "id": "690570414",
                            "speaker": "荒泷一斗",
                            "text": "我说过的吧，我早就把你当成我们荒泷派的人了！"
                        },
                        {
                            "id": "690570415",
                            "speaker": "荒泷一斗",
                            "text": "荒泷派的每一个人，都是我的家人。你嘛…当然也是。"
                        },
                        {
                            "id": "690570416",
                            "speaker": "荒泷一斗",
                            "text": "家人的事，怎么能坐视不理呢？！包在本大爷身上好了！"
                        },
                        {
                            "id": "690570417",
                            "speaker": "荒泷一斗",
                            "text": "放心放心，弟兄们平时不是在城里玩就是在野外晃，不管在哪都能帮到你！"
                        },
                        {
                            "id": "690570418",
                            "speaker": "荒泷一斗",
                            "text": "哦，不对…出了稻妻，我该怎么保护你呢？"
                        },
                        {
                            "id": "690570419",
                            "speaker": "荒泷一斗",
                            "text": "嗯！看来有必要把荒泷派的势力发展到其他地方了！"
                        },
                        {
                            "id": "690570420",
                            "speaker": "Player",
                            "text": "别担心，我很强的！"
                        },
                        {
                            "id": "690570421",
                            "speaker": "荒泷一斗",
                            "text": "哈哈，好气魄！不愧是我认可的人！"
                        },
                        {
                            "id": "690570422",
                            "speaker": "荒泷一斗",
                            "text": "那也行。我不在的时候，你也要给我好好努力，好好活着。"
                        },
                        {
                            "id": "690570423",
                            "speaker": "荒泷一斗",
                            "text": "不论是打牌还是战斗，都不能输给别人啊，我的兄弟！"
                        }
                    ]
                },
                {
                    "id": "690570411",
                    "text": "谢谢你…",
                    "response": [
                        {
                            "id": "690570412",
                            "speaker": "荒泷一斗",
                            "text": "唔…比起道谢，你更应该先跟我道歉！"
                        },
                        {
                            "id": "690570413",
                            "speaker": "荒泷一斗",
                            "text": "我知道你找过别人帮忙，怎么就没想到来找我呢？真不够意思哎…"
                        }
                    ]
                }
            ]
        }
    ]
}