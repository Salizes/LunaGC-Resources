    "dialogues": [
        {
            "id": "630410401",
            "speaker": "Player",
            "text": "我想找人。"
        },
        {
            "id": "630410402",
            "speaker": "珊瑚",
            "text": "因为无名神明的袭击而失散的亲人…有意思的事件，值得「万端珊瑚侦探社」出手。"
        },
        {
            "id": "630410403",
            "speaker": "珊瑚",
            "text": "嗯嗯…有见过面的线索是吗，那就方便多了。把你知道的情报都告诉我吧。"
        },
        {
            "id": "630410404",
            "speaker": "珊瑚",
            "text": "……"
        },
        {
            "id": "630410405",
            "speaker": "珊瑚",
            "text": "…喂，再凑过来一点呀。重要的情报可别给外人偷听了去。"
        }
    ]
