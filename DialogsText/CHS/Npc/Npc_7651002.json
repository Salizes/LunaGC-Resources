{
    "talkId": "7651002",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "埃德勒": 7
    },
    "dialogues": [
        {
            "id": "765100201",
            "speaker": "埃德勒",
            "text": "您好啊。马上要离开挪德卡莱了，竟然还有一些舍不得。",
            "choices": [
                {
                    "id": "765100202",
                    "text": "还想再来一盘兵棋推演！",
                    "response": [
                        {
                            "id": "765100203",
                            "speaker": "埃德勒",
                            "text": "好哦，请自便。"
                        }
                    ]
                },
                {
                    "id": "765100204",
                    "text": "这是一个很自在的地方。",
                    "response": [
                        {
                            "id": "765100205",
                            "speaker": "埃德勒",
                            "text": "是啊，遇见不长眼的家伙，都可以直接…"
                        },
                        {
                            "id": "765100206",
                            "speaker": "埃德勒",
                            "text": "总之，我收获了很多——就连兵棋推演都有了不少的改进灵感呢，下次，您就可以玩到最最最新改良版了。"
                        }
                    ]
                },
                {
                    "id": "765100207",
                    "text": "或许，有些舍不得维斯菈娃？",
                    "response": [
                        {
                            "id": "765100208",
                            "speaker": "埃德勒",
                            "text": "她、她吗？没有，我巴不得离她远一点，总是挑刺，还很危险，再也不要遇到才好。"
                        },
                        {
                            "id": "765100209",
                            "speaker": "埃德勒",
                            "text": "不过，也不是，等什么时候有机会了，和她堂堂正正切磋上一场，彻彻底底比出个输赢才好呢。"
                        },
                        {
                            "id": "765100210",
                            "speaker": "埃德勒",
                            "text": "这样，她总能不天天想着「切磋」了吧…"
                        }
                    ]
                }
            ]
        }
    ]
}