{
    "talkId": "6909311",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 8,
        "闲云": 16
    },
    "dialogues": [
        {
            "id": "690930401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690930402",
            "speaker": "闲云",
            "text": "倒也没什么特别想做的事。尘世凡人忙碌奔波，皆是因光阴苦短，生怕虚度了少许，就被旁人抛在后面。"
        },
        {
            "id": "690930403",
            "speaker": "闲云",
            "text": "本仙…从未如此想过。"
        },
        {
            "id": "690930404",
            "speaker": "闲云",
            "text": "仙家本就不入红尘，弹指光阴百年，本仙又专心研究机关，对身外之事无所挂碍。"
        },
        {
            "id": "690930405",
            "speaker": "闲云",
            "text": "可能…或许…嗯…除了那几个孩子。"
        },
        {
            "id": "690930406",
            "speaker": "Player",
            "text": "那就…干脆休息休息？"
        },
        {
            "id": "690930407",
            "speaker": "闲云",
            "text": "呵呵…你倒是又提了一件本仙擅长的事。"
        },
        {
            "id": "690930408",
            "speaker": "闲云",
            "text": "言已至此，本仙不如分享你一些新奇的休憩方法吧。"
        },
        {
            "id": "690930409",
            "speaker": "Player",
            "text": "休憩也有方法？"
        },
        {
            "id": "690930410",
            "speaker": "闲云",
            "text": "正是。你来瞧瞧本仙写的这些。"
        },
        {
            "id": "690930411",
            "speaker": "闲云",
            "text": "「找陌生人打牌」，「去琥牢山敲琥珀」…当本仙想要休憩，又不知道做什么时，就会从中抽选。",
            "choices": [
                {
                    "id": "690930412",
                    "text": "听起来像是…奇怪的抽签。",
                    "response": [
                        {
                            "id": "690930413",
                            "speaker": "闲云",
                            "text": "怪又有何干，只要寻些乐趣，放松身心就好。"
                        },
                        {
                            "id": "690930416",
                            "speaker": "闲云",
                            "text": "当然，你若是有什么其他有效的休憩方法，也尽管说给本仙听。",
                            "choices": [
                                {
                                    "id": "690930417",
                                    "text": "今日只想走神。",
                                    "response": [
                                        {
                                            "id": "690930419",
                                            "speaker": "闲云",
                                            "text": "唔，偶尔神游天外也不错，说不定会捕到一些寻常劳碌中捉不到的灵光。"
                                        },
                                        {
                                            "id": "690930420",
                                            "speaker": "闲云",
                                            "text": "只是，不知道你这盏茶壶里，究竟哪里适合做这件事…"
                                        },
                                        {
                                            "id": "690930421",
                                            "speaker": "闲云",
                                            "text": "这里的风景能够跟随你的心意而动吧？不如…造个绝云间出来？"
                                        },
                                        {
                                            "id": "690930422",
                                            "speaker": "闲云",
                                            "text": "不，无须如此劳烦。咱们就回绝云间去。本仙使点腾云的本事，带你遨游云间怎么样？"
                                        },
                                        {
                                            "id": "690930423",
                                            "speaker": "Player",
                                            "text": "好像也不错。"
                                        },
                                        {
                                            "id": "690930424",
                                            "speaker": "闲云",
                                            "text": "就这么办。待本仙稍作规划，带上神机一二，我们这就出发！"
                                        }
                                    ]
                                },
                                {
                                    "id": "690930418",
                                    "text": "今天适合发呆。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690930414",
                    "text": "这类事情已经做过不少了。",
                    "response": [
                        {
                            "id": "690930415",
                            "speaker": "闲云",
                            "text": "哦？不妨说说感想？本仙颇有兴趣。"
                        }
                    ]
                }
            ]
        }
    ]
}