{
    "talkId": "4008139",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 8,
        "派蒙": 1,
        "留言板": 19
    },
    "dialogues": [
        {
            "id": "400813901",
            "speaker": "留言板",
            "text": "「『月莲杯驯兽师大赛』的赛事正火热推进中，十六位优异的选手将在下一阶段的比赛中激烈角逐，为我们带来精彩的对决…」",
            "choices": [
                {
                    "id": "400813902",
                    "text": "再次查阅「大赛规则」…",
                    "response": [
                        {
                            "id": "400813903",
                            "speaker": "留言板",
                            "text": "……"
                        },
                        {
                            "id": "400813904",
                            "speaker": "留言板",
                            "text": "「免责声明·第二条：确认参赛资格，即代表选手已知晓『意智宝珠』可能对身体造成的负面影响…」"
                        },
                        {
                            "id": "400813905",
                            "speaker": "留言板",
                            "text": "「免责声明·第七条：一切解释权归属于主办方与学者考特里亚先生，如有律法疑问，请向相关机构发起正式流程…」"
                        },
                        {
                            "id": "400813906",
                            "speaker": "留言板",
                            "text": "……"
                        },
                        {
                            "id": "400813907",
                            "speaker": "Player",
                            "text": "（以前好像没有注意到这几条规则的细节呢…）"
                        }
                    ]
                },
                {
                    "id": "400813908",
                    "text": "「最受『支持』的留言」",
                    "response": [
                        {
                            "id": "400813909",
                            "speaker": "留言板",
                            "text": "「加把劲啊，海妮耶和『火一』，一定要拿下冠军啊！」"
                        },
                        {
                            "id": "400813910",
                            "speaker": "留言板",
                            "text": "「你们的战斗风格非常豪放，让比赛观赏性提升了一个档次。」"
                        },
                        {
                            "id": "400813911",
                            "speaker": "留言板",
                            "text": "「不知道海妮耶会不会收徒！好想跟着她学习驯兽的技巧，和各种蕈兽交朋友！」"
                        }
                    ]
                },
                {
                    "id": "400813912",
                    "text": "「最被『反对』的留言」",
                    "response": [
                        {
                            "id": "400813913",
                            "speaker": "留言板",
                            "text": "「『黄金流星』和『白银伴星』实在太强势了！很难让人不怀疑，他们以前就对蕈兽很熟悉！」"
                        },
                        {
                            "id": "400813914",
                            "speaker": "留言板",
                            "text": "「有他们两位在的话，冠军岂不是没有悬念了吗？」"
                        },
                        {
                            "id": "400813915",
                            "speaker": "留言板",
                            "text": "「听说『白银伴星』很喜欢摩拉，不如，我们凑一大笔钱送给『白银伴星』，求求他们放水退赛吧！」"
                        },
                        {
                            "id": "400813916",
                            "speaker": "留言板",
                            "text": "「这样一来，至少我们这些普通人还有夺冠的机会！」"
                        },
                        {
                            "id": "400813917",
                            "speaker": "留言板",
                            "text": "（下面似乎还有针对这条留言的几条回应…）"
                        },
                        {
                            "id": "400813918",
                            "speaker": "留言板",
                            "text": "「你该不会就是他们那一组的选手吧！想用大家的钱收买他们？这是舞弊！」"
                        },
                        {
                            "id": "400813919",
                            "speaker": "留言板",
                            "text": "「人家凭实力说话，堂堂正正！你有打歪心思的功夫，不如好好锻炼自己的本领！」"
                        },
                        {
                            "id": "400813920",
                            "speaker": "留言板",
                            "text": "「现在就假设他们能夺冠，未免为时过早了。如果他们对上了『玲珑油豆腐』，绝对会是一番苦战。」",
                            "choices": [
                                {
                                    "id": "400813921",
                                    "text": "……",
                                    "response": [
                                        {
                                            "id": "400813923",
                                            "speaker": "派蒙",
                                            "text": "怎么了怎么了！有什么我不能看的留言吗！"
                                        }
                                    ]
                                },
                                {
                                    "id": "400813922",
                                    "text": "（假装没有看见，捂住派蒙的眼睛。）"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400813924",
                    "text": "「公认『有趣』的留言」",
                    "response": [
                        {
                            "id": "400813925",
                            "speaker": "留言板",
                            "text": "「有一位名叫荒谷的外国客人在收集蕈兽的照片，据说，她有门路制作一些蕈兽的画片，很有收藏价值！」"
                        },
                        {
                            "id": "400813926",
                            "speaker": "留言板",
                            "text": "「不过，荒谷小姐不想做亏本的生意，所以正在分析这种画片的销路。」"
                        },
                        {
                            "id": "400813927",
                            "speaker": "留言板",
                            "text": "「有意购买画片的朋友请留言！拍到了可爱蕈兽的朋友们，也请为我们提供照片！」"
                        }
                    ]
                },
                {
                    "id": "400813928",
                    "text": "离去。"
                }
            ]
        }
    ]
}