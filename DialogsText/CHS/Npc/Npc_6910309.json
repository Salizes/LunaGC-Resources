{
    "talkId": "6910309",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "希诺宁": 14
    },
    "dialogues": [
        {
            "id": "691030401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691030402",
            "speaker": "希诺宁",
            "text": "没有。我不想做任何事，在这里发呆就挺好。"
        },
        {
            "id": "691030403",
            "speaker": "希诺宁",
            "text": "难得在一个根本没人能找到我的地方休息，我就不给自己找麻烦了。"
        },
        {
            "id": "691030404",
            "speaker": "希诺宁",
            "text": "来来，我们一起发发呆吧，我教你迅速进入发呆状态的诀窍。"
        },
        {
            "id": "691030405",
            "speaker": "Player",
            "text": "这事情还有诀窍？"
        },
        {
            "id": "691030406",
            "speaker": "希诺宁",
            "text": "当然了。发呆的本质，就是迅速清理自己脑子里乱七八糟的事情，再将自己的精神抽出身体，达到一种有专注性的完全平静…",
            "choices": [
                {
                    "id": "691030407",
                    "text": "有一种「烟谜主」祭祀的感觉…",
                    "response": [
                        {
                            "id": "691030408",
                            "speaker": "希诺宁",
                            "text": "喔，我确实也向茜特菈莉学习过和冥想相关的知识。"
                        },
                        {
                            "id": "691030409",
                            "speaker": "希诺宁",
                            "text": "但我可没有…也懒得找那种和万物沟通的「灵性」，我只想学习到让自己清净下来的方法。"
                        },
                        {
                            "id": "691030414",
                            "speaker": "希诺宁",
                            "text": "好了好了，说起来复杂，其实很简单的，你跟着我一步一步来就行。"
                        },
                        {
                            "id": "691030415",
                            "speaker": "希诺宁",
                            "text": "首先，凝望着空气里的某一个点…随便哪里都可以，只要你觉得舒服。"
                        },
                        {
                            "id": "691030416",
                            "speaker": "希诺宁",
                            "text": "接着，开始放松你的眉头…再放松肩膀…专注盯着那个点，脑子里只思考，那个点究竟在哪里…"
                        },
                        {
                            "id": "691030417",
                            "speaker": "希诺宁",
                            "text": "然后…呼啊…然后…继续放松…放松…"
                        },
                        {
                            "id": "691030418",
                            "speaker": "希诺宁",
                            "text": "…呼…呼…"
                        }
                    ]
                },
                {
                    "id": "691030410",
                    "text": "发呆有这么深奥吗…",
                    "response": [
                        {
                            "id": "691030411",
                            "speaker": "希诺宁",
                            "text": "当然啦。不信你去问茜特菈莉，或者欧洛伦，他们「烟谜主」里有许多人都要专门学习如何冥想。"
                        },
                        {
                            "id": "691030412",
                            "speaker": "希诺宁",
                            "text": "冥想和发呆其实差不多啦，都是先清理思想，再让自己的内心平静下来。"
                        },
                        {
                            "id": "691030413",
                            "speaker": "希诺宁",
                            "text": "两者的区别就在于，「烟谜主」需要在冥想状态进行某种行动，而我们，只需要享受发呆带来的平静就好。"
                        }
                    ]
                }
            ]
        }
    ]
}