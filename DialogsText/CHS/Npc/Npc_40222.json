{
    "talkId": "40222",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 1,
        "斯坦利": 9
    },
    "dialogues": [
        {
            "id": "4015141103",
            "speaker": "Player",
            "text": "烬寂海？"
        },
        {
            "id": "4015141108",
            "speaker": "斯坦利",
            "text": "问得好！想不到你还是很懂的嘛，那可是我的传奇故事中最精彩的一段！"
        },
        {
            "id": "4015141109",
            "speaker": "斯坦利",
            "text": "远在大陆的另一端，有一处寸草不生的秘境。"
        },
        {
            "id": "4015141110",
            "speaker": "斯坦利",
            "text": "那里有着令人耳鸣的寂静，眼前是一片灰烬的海洋…"
        },
        {
            "id": "4015141111",
            "speaker": "斯坦利",
            "text": "……（唠叨不休）"
        },
        {
            "id": "4015141112",
            "speaker": "斯坦利",
            "text": "…那魔兽居然在灰烬的海洋里卷起了旋涡！我紧紧拉住快被卷入其中的伙伴的手…"
        },
        {
            "id": "4015141113",
            "speaker": "斯坦利",
            "text": "……（唠叨不休）"
        },
        {
            "id": "4015141114",
            "speaker": "斯坦利",
            "text": "…可惜最终再次踏上故乡土地的只有我一人，任凭蒙德的风吹落眼角的泪花…"
        },
        {
            "id": "4015141115",
            "speaker": "斯坦利",
            "text": "喂喂！你眼睛怎么都闭起来了…"
        },
        {
            "id": "4015141116",
            "speaker": "斯坦利",
            "text": "喂，给我醒醒啊！"
        }
    ]
}