{
    "talkId": "6205603",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 1,
        "嘉义": 7
    },
    "dialogues": [
        {
            "id": "620560301",
            "speaker": "Player",
            "text": "关于女儿…"
        },
        {
            "id": "620560302",
            "speaker": "嘉义",
            "text": "她叫小六。我夫人在她出生时就难产去世了，如今是轻策庄的长辈们在照顾她。"
        },
        {
            "id": "620560303",
            "speaker": "嘉义",
            "text": "…她还太小，我都不知道该怎么和她说这件事…只好骗她说，妈妈一直在璃月港工作…"
        },
        {
            "id": "620560304",
            "speaker": "嘉义",
            "text": "…唉，独自来到璃月工作后，我已经很久没见她了。上次抱起她时，好像还远没有这把长枪重…"
        },
        {
            "id": "620560305",
            "speaker": "嘉义",
            "text": "她有好好吃饭吗？"
        },
        {
            "id": "620560306",
            "speaker": "嘉义",
            "text": "她有没有健健康康的呢？"
        },
        {
            "id": "620560307",
            "speaker": "嘉义",
            "text": "她有没有交到朋友呢？"
        },
        {
            "id": "620560308",
            "speaker": "嘉义",
            "text": "唉…小六，爸爸好想你啊…"
        }
    ]
}