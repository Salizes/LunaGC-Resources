{
    "talkId": "6231003",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "路爷": 12
    },
    "dialogues": [
        {
            "id": "623100301",
            "speaker": "Player",
            "text": "关于徒弟…"
        },
        {
            "id": "623100302",
            "speaker": "路爷",
            "text": "客官是听到老夫念叨了吗，唉…"
        },
        {
            "id": "623100303",
            "speaker": "路爷",
            "text": "老夫年纪已经太大了，风也见过雨也见过，腿脚不麻利了。"
        },
        {
            "id": "623100304",
            "speaker": "路爷",
            "text": "还是想收个徒弟，把「范木堂」的名号传下去啊。"
        },
        {
            "id": "623100305",
            "speaker": "路爷",
            "text": "…这么说来，你对木工活有兴趣吗？通过劳动，把原始的木材，变成巧夺天工的艺术品，这样的事情，没兴趣吗？",
            "choices": [
                {
                    "id": "623100306",
                    "text": "师父！",
                    "response": [
                        {
                            "id": "623100307",
                            "speaker": "路爷",
                            "text": "哦哦，此话当真？"
                        },
                        {
                            "id": "623100308",
                            "speaker": "路爷",
                            "text": "但看你的样子，也有不得不做的事情，有不得不去的地方吧。"
                        },
                        {
                            "id": "623100309",
                            "speaker": "路爷",
                            "text": "等你把该做的事情做完了，到时候如果老夫还健在，再来叫我师父吧。"
                        },
                        {
                            "id": "623100310",
                            "speaker": "路爷",
                            "text": "决定了，届时一定倾尽全力把「范木堂」的手艺传授给你。"
                        }
                    ]
                },
                {
                    "id": "623100311",
                    "text": "还是算了。",
                    "response": [
                        {
                            "id": "623100312",
                            "speaker": "路爷",
                            "text": "真遗憾。木工活真的很有趣。"
                        },
                        {
                            "id": "623100313",
                            "speaker": "路爷",
                            "text": "看你的样子，也有不得不做的事情，不得不去的地方吧。"
                        },
                        {
                            "id": "623100314",
                            "speaker": "路爷",
                            "text": "等你把该做的事情做完了，如果改变了心意的话，一定要来找老夫啊。"
                        },
                        {
                            "id": "623100315",
                            "speaker": "路爷",
                            "text": "届时老夫一定倾尽全力把「范木堂」的手艺传授给你。"
                        }
                    ]
                }
            ]
        }
    ]
}