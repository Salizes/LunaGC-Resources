    "speaker_counts": {
        "Player": 27,
        "芭芭拉": 22
    },
    "dialogues": [
        {
            "id": "400122601",
            "speaker": "芭芭拉",
            "text": "荣誉骑士，来得正好，要一起欣赏海景吗？",
            "choices": [
                {
                    "id": "400122602",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400122603",
                            "speaker": "芭芭拉",
                            "text": "好啊好啊，有什么想聊的话题吗？",
                            "choices": [
                                {
                                    "id": "400122604",
                                    "text": "关于羽球…",
                                    "response": [
                                        {
                                            "id": "400122605",
                                            "speaker": "芭芭拉",
                                            "text": "你或许听说过，我们蒙德城有个传统节日，叫做「羽球节」。"
                                        },
                                        {
                                            "id": "400122606",
                                            "speaker": "芭芭拉",
                                            "text": "每到节日，人们就会投掷色彩绚丽的羽球，以这种仪式来传递喜悦并纪念风神。是个老少咸宜的节日哦！"
                                        },
                                        {
                                            "id": "400122607",
                                            "speaker": "芭芭拉",
                                            "text": "可莉很喜欢羽球节，不过现在还不是时候…所以，我就做了特制羽球给她。"
                                        },
                                        {
                                            "id": "400122608",
                                            "speaker": "芭芭拉",
                                            "text": "希望可莉能开心起来。她的笑容很有感染力，我一看见她开心的样子，也会忍不住笑哦。",
                                            "choices": [
                                                {
                                                    "id": "400122604",
                                                    "text": "关于羽球…"
                                                },
                                                {
                                                    "id": "400122609",
                                                    "text": "关于海岛…",
                                                    "response": [
                                                        {
                                                            "id": "400122610",
                                                            "speaker": "芭芭拉",
                                                            "text": "虽然姐姐经常叫大家保持警惕，但对我来说，这座海岛还挺有趣的呢。"
                                                        },
                                                        {
                                                            "id": "400122611",
                                                            "speaker": "芭芭拉",
                                                            "text": "夏天能看见星星的夜晚，像这样坐在沙滩上，随着海浪的起伏哼歌…"
                                                        },
                                                        {
                                                            "id": "400122612",
                                                            "speaker": "芭芭拉",
                                                            "text": "我觉得是非常浪漫的事哦。"
                                                        },
                                                        {
                                                            "id": "400122613",
                                                            "speaker": "芭芭拉",
                                                            "text": "而且，你也在这里，总觉得…这个夏天变得特别了起来。",
                                                            "choices": [
                                                                {
                                                                    "id": "400122604",
                                                                    "text": "关于羽球…"
                                                                },
                                                                {
                                                                    "id": "400122609",
                                                                    "text": "关于海岛…"
                                                                },
                                                                {
                                                                    "id": "400122614",
                                                                    "text": "关于芭芭拉自己…",
                                                                    "response": [
                                                                        {
                                                                            "id": "400122615",
                                                                            "speaker": "芭芭拉",
                                                                            "text": "嗯？我吗？"
                                                                        },
                                                                        {
                                                                            "id": "400122616",
                                                                            "speaker": "芭芭拉",
                                                                            "text": "我…我其实、其实…"
                                                                        },
                                                                        {
                                                                            "id": "400122617",
                                                                            "speaker": "芭芭拉",
                                                                            "text": "唔…你要听实话吗？"
                                                                        },
                                                                        {
                                                                            "id": "400122618",
                                                                            "speaker": "芭芭拉",
                                                                            "text": "其实，我既担心大家的安全，也想趁机和大家一起出远门，才跟来海岛的…"
                                                                        },
                                                                        {
                                                                            "id": "400122619",
                                                                            "speaker": "芭芭拉",
                                                                            "text": "你、你不会笑话我吧？毕竟作为祈礼牧师我也不应该太贪玩才是…"
                                                                        },
                                                                        {
                                                                            "id": "400122620",
                                                                            "speaker": "Player",
                                                                            "text": "不会的。"
                                                                        },
                                                                        {
                                                                            "id": "400122621",
                                                                            "speaker": "芭芭拉",
                                                                            "text": "呼…那就好。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "400122604",
                                                                                    "text": "关于羽球…"
                                                                                },
                                                                                {
                                                                                    "id": "400122609",
                                                                                    "text": "关于海岛…"
                                                                                },
                                                                                {
                                                                                    "id": "400122614",
                                                                                    "text": "关于芭芭拉自己…"
                                                                                },
                                                                                {
                                                                                    "id": "400122622",
                                                                                    "text": "关于今天发生的事…",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "400122623",
                                                                                            "speaker": "芭芭拉",
                                                                                            "text": "没想到那几位也到海岛来了，气氛一下活泼好多呢。"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122624",
                                                                                            "speaker": "芭芭拉",
                                                                                            "text": "我想借着这次机会拉近与大家的关系，特别是…跟姐姐。"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122625",
                                                                                            "speaker": "芭芭拉",
                                                                                            "text": "可能是性格原因，她总是非常繁忙，一个人背负许多事。"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122626",
                                                                                            "speaker": "芭芭拉",
                                                                                            "text": "我希望她能自由一些、快乐一些…至少我在的时候，能让她高兴起来。"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122627",
                                                                                            "speaker": "芭芭拉",
                                                                                            "text": "是不是该给她唱首歌呢？唔…",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "400122604",
                                                                                                    "text": "关于羽球…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122609",
                                                                                                    "text": "关于海岛…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122614",
                                                                                                    "text": "关于芭芭拉自己…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122622",
                                                                                                    "text": "关于今天发生的事…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122628",
                                                                                                    "text": "先不打扰你了。",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "400122629",
                                                                                                            "speaker": "芭芭拉",
                                                                                                            "text": "嗯，待会儿见！"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "400122628",
                                                                                    "text": "先不打扰你了。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "400122622",
                                                                    "text": "关于今天发生的事…"
                                                                },
                                                                {
                                                                    "id": "400122628",
                                                                    "text": "先不打扰你了。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "400122614",
                                                    "text": "关于芭芭拉自己…"
                                                },
                                                {
                                                    "id": "400122622",
                                                    "text": "关于今天发生的事…"
                                                },
                                                {
                                                    "id": "400122628",
                                                    "text": "先不打扰你了。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "400122609",
                                    "text": "关于海岛…"
                                },
                                {
                                    "id": "400122614",
                                    "text": "关于芭芭拉自己…"
                                },
                                {
                                    "id": "400122622",
                                    "text": "关于今天发生的事…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400122628",
                    "text": "先不打扰你了。"
                }
            ]
        }
    ]
}