    "dialogues": [
        {
            "id": "4015140903",
            "speaker": "塞琉斯",
            "text": "关于冒险家协会。"
        },
        {
            "id": "4015140909",
            "speaker": "塞琉斯",
            "text": "向着星辰与深渊！"
        },
        {
            "id": "4015140910",
            "speaker": "塞琉斯",
            "text": "全提瓦特的所有国家都有我们的分部，哈哈。"
        },
        {
            "id": "4015140911",
            "speaker": "塞琉斯",
            "text": "在协会里认识些新伙伴，探索整个大陆的每一个角落，达成委托还有酬金拿…"
        },
        {
            "id": "4015140912",
            "speaker": "塞琉斯",
            "text": "这不就是冒险家的天堂吗？真的不考虑加入吗小鬼，哈哈哈哈…"
        }
    ]
}