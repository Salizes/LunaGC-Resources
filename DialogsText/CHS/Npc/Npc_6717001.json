    "dialogues": [
        {
            "id": "671700101",
            "speaker": "奈芙尔",
            "text": "欢迎来到「秘闻馆」。"
        },
        {
            "id": "671700102",
            "speaker": "奈芙尔",
            "text": "有需要委托的事，在那边的留言簿上留言就好。"
        },
        {
            "id": "671700103",
            "speaker": "Player",
            "text": "难得见到奈芙尔在这…"
        },
        {
            "id": "671700104",
            "speaker": "奈芙尔",
            "text": "我今天要接待一个重要的客人，正好雅珂达前几天也向我请假。"
        },
        {
            "id": "671700105",
            "speaker": "奈芙尔",
            "text": "所以，今天就干脆由我做「秘闻馆」的接待了。"
        },
        {
            "id": "671700106",
            "speaker": "奈芙尔",
            "text": "算算时间，那位客人也快到了，嗯…等一下就清场吧。"
        }
    ]
}