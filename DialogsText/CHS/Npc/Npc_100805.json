    "dialogues": [
        {
            "id": "10080501",
            "speaker": "李当",
            "text": "咳！咳咳，咳…咳咳！"
        },
        {
            "id": "10080502",
            "speaker": "李当",
            "text": "我怎么…是你们救我出来的？谢谢你们…"
        },
        {
            "id": "10080503",
            "speaker": "李当",
            "text": "对了！你们看见过我兄弟吗？他叫李丁，我们俩是一同上山的。"
        },
        {
            "id": "10080504",
            "speaker": "李当",
            "text": "不知道…我兄弟是不是也一样被琥珀给吞了…",
            "choices": [
                {
                    "id": "10080505",
                    "text": "就是李丁拜托我来救你的。",
                    "response": [
                        {
                            "id": "10080506",
                            "speaker": "李当",
                            "text": "那他应该是安全了…"
                        },
                        {
                            "id": "10080509",
                            "speaker": "李当",
                            "text": "谢谢您，我这就去找我兄弟。"
                        },
                        {
                            "id": "10080510",
                            "speaker": "李当",
                            "text": "希望不会在路上再被琥珀给吞了…"
                        }
                    ]
                },
                {
                    "id": "10080507",
                    "text": "他现在在山顶上。",
                    "response": [
                        {
                            "id": "10080508",
                            "speaker": "李当",
                            "text": "在山顶上？那他应该是安全的…"
                        }
                    ]
                }
            ]
        }
    ]
}