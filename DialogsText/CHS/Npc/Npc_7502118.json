{
    "talkId": "7502118",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 5,
        "瓦兰卡": 9
    },
    "dialogues": [
        {
            "id": "750211801",
            "speaker": "瓦兰卡",
            "text": "…陌生的脚步声，是外来的客人吗？",
            "choices": [
                {
                    "id": "750211802",
                    "text": "关于奥尔科…",
                    "response": [
                        {
                            "id": "750211803",
                            "speaker": "瓦兰卡",
                            "text": "你认识那孩子…是他之前提过的异乡旅人吗？那时应该给你添了些麻烦吧，希望你不要怪罪。"
                        },
                        {
                            "id": "750211804",
                            "speaker": "瓦兰卡",
                            "text": "那孩子没有母亲管教，比其他孩子更调皮一些。我…也不太方便，所以对他的关照也非常有限。"
                        },
                        {
                            "id": "750211805",
                            "speaker": "Player",
                            "text": "他似乎很想帮到你。"
                        },
                        {
                            "id": "750211806",
                            "speaker": "瓦兰卡",
                            "text": "是的，是的，我听说了。也许还是我做得不对，想到那孩子的母亲已经不在了，为了排遣他的寂寞而讲了许多故事给他听…"
                        },
                        {
                            "id": "750211807",
                            "speaker": "瓦兰卡",
                            "text": "但没想到他信以为真，还想借助魔法之类的力量找回母亲…唉，我该把他从幻想的世界里带出来吗？我现在还不知道答案。"
                        }
                    ]
                },
                {
                    "id": "750211808",
                    "text": "你的听力很敏锐…",
                    "response": [
                        {
                            "id": "750211809",
                            "speaker": "瓦兰卡",
                            "text": "谢谢你的夸奖，但这后天因为缺陷才增长的能力，或许还是不要获得才比较好吧。"
                        },
                        {
                            "id": "750211810",
                            "speaker": "瓦兰卡",
                            "text": "如果你是冒险家，请千万小心「宝石收藏家」，不要落得我这般下场。"
                        },
                        {
                            "id": "750211811",
                            "speaker": "Player",
                            "text": "关于「宝石收藏家」…"
                        },
                        {
                            "id": "750211812",
                            "speaker": "瓦兰卡",
                            "text": "那是个穷凶极恶的歹徒。他所喜爱的「宝石」绝非「回声之子」的工匠爱好的那种…总之，请务必小心。"
                        }
                    ]
                },
                {
                    "id": "750211813",
                    "text": "不打扰了。",
                    "response": [
                        {
                            "id": "750211814",
                            "speaker": "瓦兰卡",
                            "text": "祝你一切顺利。"
                        }
                    ]
                }
            ]
        }
    ]
}