{
    "talkId": "6180110",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 5,
        "洛恩": 6
    },
    "dialogues": [
        {
            "id": "618011001",
            "speaker": "洛恩",
            "text": "嗯…该从哪下手呢？"
        },
        {
            "id": "618011002",
            "speaker": "Player",
            "text": "你在做什么？"
        },
        {
            "id": "618011003",
            "speaker": "洛恩",
            "text": "啊，骑士团最近接到消息，有个乔装打扮的小偷在集市上行窃，我是来捉他归案的。",
            "choices": [
                {
                    "id": "618011004",
                    "text": "你连这种小贼也会管？",
                    "response": [
                        {
                            "id": "618011006",
                            "speaker": "洛恩",
                            "text": "哈哈，最近和平太久了嘛。也不知道为什么，自从我驻扎在荆夫港，附近的盗宝团都不愿意来了…"
                        },
                        {
                            "id": "618011007",
                            "speaker": "洛恩",
                            "text": "好不容易有个不长眼…呵，有胆识的送上门，当然得好好「款待」他一下。"
                        },
                        {
                            "id": "618011008",
                            "speaker": "洛恩",
                            "text": "那么，荣誉骑士，你最近有在这儿遇到过什么可疑的人吗？",
                            "choices": [
                                {
                                    "id": "618011009",
                                    "text": "遇是遇到过…",
                                    "response": [
                                        {
                                            "id": "618011011",
                                            "speaker": "洛恩",
                                            "text": "哦，该不会是上哪躲起来了吧？有点意思。"
                                        }
                                    ]
                                },
                                {
                                    "id": "618011010",
                                    "text": "现在没影了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "618011005",
                    "text": "你连这种小贼也不放过？"
                }
            ]
        }
    ]
}