        "米卢·努伊": 4
    },
    "dialogues": [
        {
            "id": "660680201",
            "speaker": "Player",
            "text": "帕卡是谁？"
        },
        {
            "id": "660680202",
            "speaker": "米卢·努伊",
            "text": "「花歌唱片店」里那位。"
        },
        {
            "id": "660680203",
            "speaker": "米卢·努伊",
            "text": "你…你去过那家店了吗？虽然帕卡这小子不太靠谱，但品味不错，里面还有我的音乐唱片卖呢。"
        },
        {
            "id": "660680204",
            "speaker": "米卢·努伊",
            "text": "可以试听，不要错过！"
        },
        {
            "id": "660680205",
            "speaker": "米卢·努伊",
            "text": "…而且，听完麻烦跟我讲讲感受，我的音乐…真的很像儿歌吗？"
        }
    ]
}