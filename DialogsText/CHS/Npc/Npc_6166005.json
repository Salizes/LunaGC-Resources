    "dialogues": [
        {
            "id": "616600501",
            "speaker": "Player",
            "text": "会说话的小狐狸？"
        },
        {
            "id": "616600502",
            "speaker": "萨基",
            "text": "是啊！我好想知道跟小动物说话是什么感觉喔！"
        },
        {
            "id": "616600503",
            "speaker": "萨基",
            "text": "唔…我只见过一个绿衣服白袜子的哥哥跟动物说过话，碰巧看到的。"
        },
        {
            "id": "616600504",
            "speaker": "萨基",
            "text": "我跟妈妈说那个哥哥好厉害，但是哥哥却说是我听错了…"
        }
    ]
}