    "dialogues": [
        {
            "id": "640260201",
            "speaker": "Player",
            "text": "好诗。"
        },
        {
            "id": "640260202",
            "speaker": "卓英",
            "text": "哈哈哈，确实好，就像烈酒一样直白痛快…"
        },
        {
            "id": "640260203",
            "speaker": "卓英",
            "text": "但很遗憾，这诗歌来自一个悲伤的老故事…唉，甚至都算不上是什么诗。"
        },
        {
            "id": "640260204",
            "speaker": "卓英",
            "text": "就像我一样，现在也算不上什么水手，只是一个流连在醉意中的酒客罢了。"
        },
        {
            "id": "640260205",
            "speaker": "卓英",
            "text": "哎，不说了，喝！"
        }
    ]
}