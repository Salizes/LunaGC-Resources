{
    "talkId": "6906903",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 8,
        "提纳里": 17
    },
    "dialogues": [
        {
            "id": "690690301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690690302",
            "speaker": "提纳里",
            "text": "当然好啊，你有什么想聊的话题吗？"
        },
        {
            "id": "690690303",
            "speaker": "提纳里",
            "text": "如果让我起头的话，一定又都是些关于花花草草的事情了。",
            "choices": [
                {
                    "id": "690690304",
                    "text": "没关系，我已经预判到了。",
                    "response": [
                        {
                            "id": "690690306",
                            "speaker": "提纳里",
                            "text": "哦？那看来是做好准备咯？"
                        },
                        {
                            "id": "690690307",
                            "speaker": "提纳里",
                            "text": "那我们先从最基础的开始：植物学从属于生物学，主要研究植物的形态、分类、生态、遗传、进化等内容。"
                        },
                        {
                            "id": "690690308",
                            "speaker": "提纳里",
                            "text": "植物分类的基本等级有…",
                            "choices": [
                                {
                                    "id": "690690309",
                                    "text": "呼…呼…",
                                    "response": [
                                        {
                                            "id": "690690311",
                                            "speaker": "提纳里",
                                            "text": "不许走神，瞌睡虫！这可是你自己要听的。"
                                        },
                                        {
                                            "id": "690690312",
                                            "speaker": "提纳里",
                                            "text": "…哈哈，不逗你了。不从事相关工作的人不需要背这些死规矩啦。"
                                        },
                                        {
                                            "id": "690690313",
                                            "speaker": "提纳里",
                                            "text": "不过你经常在外旅行，风餐露宿的，还是需要多了解一些常见的野外植物特性。"
                                        },
                                        {
                                            "id": "690690314",
                                            "speaker": "提纳里",
                                            "text": "比如如何通过草木的生长形态辨别方向，如何利用茎杆和叶片获取干净的水源…"
                                        },
                                        {
                                            "id": "690690315",
                                            "speaker": "提纳里",
                                            "text": "再比如有哪些果实无毒又好吃，又有哪些野菜适合与肉类一起烹饪…",
                                            "choices": [
                                                {
                                                    "id": "690690316",
                                                    "text": "不好，口水要流下来了…",
                                                    "response": [
                                                        {
                                                            "id": "690690318",
                                                            "speaker": "提纳里",
                                                            "text": "哎，怎么回事！光听见和吃有关的事情了是吧。"
                                                        },
                                                        {
                                                            "id": "690690319",
                                                            "speaker": "Player",
                                                            "text": "这个主要怪派蒙…"
                                                        },
                                                        {
                                                            "id": "690690320",
                                                            "speaker": "提纳里",
                                                            "text": "那个小家伙啊…"
                                                        },
                                                        {
                                                            "id": "690690321",
                                                            "speaker": "提纳里",
                                                            "text": "她虽然看起来…脑瓜是不太灵活，但十分在乎你呢。"
                                                        },
                                                        {
                                                            "id": "690690322",
                                                            "speaker": "提纳里",
                                                            "text": "所以就算是为了保护好你的旅伴，你也要多学习一些自然科学哦。"
                                                        },
                                                        {
                                                            "id": "690690323",
                                                            "speaker": "提纳里",
                                                            "text": "哎呀，一不小心用培训巡林员的语气说话了…不好意思，你多包涵。"
                                                        },
                                                        {
                                                            "id": "690690324",
                                                            "speaker": "提纳里",
                                                            "text": "总之你是聪明人，一定能明白我的意思啦。"
                                                        },
                                                        {
                                                            "id": "690690325",
                                                            "speaker": "提纳里",
                                                            "text": "如果有什么想要了解的「花花草草」，欢迎随时来找我讨论。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690690317",
                                                    "text": "我饿了，「师父」。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690690310",
                                    "text": "呵…欠…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690690305",
                    "text": "教教我吧，「师父」。"
                }
            ]
        }
    ]
}