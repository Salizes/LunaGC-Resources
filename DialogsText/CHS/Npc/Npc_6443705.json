    "dialogues": [
        {
            "id": "644370501",
            "speaker": "Player",
            "text": "历史研究…？"
        },
        {
            "id": "644370502",
            "speaker": "坦吉",
            "text": "嗯，很奇怪吗？"
        },
        {
            "id": "644370503",
            "speaker": "坦吉",
            "text": "神王的故事是历史，帕维兹拉万的内室是历史…而塔尼特的神秘惨案也是历史。"
        },
        {
            "id": "644370504",
            "speaker": "坦吉",
            "text": "简而言之…哈哈，真相的碎片要如何拼合？"
        },
        {
            "id": "644370505",
            "speaker": "坦吉",
            "text": "记录旧事的人在写下文字时，他的目的是什么？他可能在想什么？"
        },
        {
            "id": "644370506",
            "speaker": "坦吉",
            "text": "…这就是历史。"
        }
    ]
}