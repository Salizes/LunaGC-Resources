{
    "talkId": "6909011",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "夏沃蕾": 14
    },
    "dialogues": [
        {
            "id": "690900401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690900402",
            "speaker": "夏沃蕾",
            "text": "能偶尔在这里放松一下，对我来说就很难得了。"
        },
        {
            "id": "690900403",
            "speaker": "夏沃蕾",
            "text": "另外…我最近在想，是不是能请你协助执行一些任务。有了你帮忙，想必那些凶徒只能乖乖伏法了。",
            "choices": [
                {
                    "id": "690900404",
                    "text": "上哪打架？",
                    "response": [
                        {
                            "id": "690900405",
                            "speaker": "夏沃蕾",
                            "text": "虽然的确可能产生冲突，但你的回答如此果断，莫非平时习惯使用暴力？"
                        },
                        {
                            "id": "690900406",
                            "speaker": "夏沃蕾",
                            "text": "别紧张，我不是在指责你。"
                        },
                        {
                            "id": "690900407",
                            "speaker": "夏沃蕾",
                            "text": "有些时候，这也是对方唯一能听懂的「语言」。我对此深有感触。"
                        },
                        {
                            "id": "690900411",
                            "speaker": "夏沃蕾",
                            "text": "那我们谈妥了？"
                        },
                        {
                            "id": "690900412",
                            "speaker": "Player",
                            "text": "具体要怎么配合呢？"
                        },
                        {
                            "id": "690900413",
                            "speaker": "夏沃蕾",
                            "text": "我原本设想过，在执行需要潜入和监视的任务时，靠这茶壶隐蔽。"
                        },
                        {
                            "id": "690900414",
                            "speaker": "夏沃蕾",
                            "text": "但现在看来，出入这盏茶壶并不方便。不如换个角度。我带着壶执行任务，你做援兵。"
                        },
                        {
                            "id": "690900415",
                            "speaker": "Player",
                            "text": "…什么？"
                        },
                        {
                            "id": "690900416",
                            "speaker": "夏沃蕾",
                            "text": "只要我一敲茶壶，你就从壶里跳出去，帮我打倒那些武装嫌犯。"
                        },
                        {
                            "id": "690900417",
                            "speaker": "夏沃蕾",
                            "text": "「带着神奇茶壶的特巡队队长」，这称号还挺有童话的感觉。就这么定了。"
                        },
                        {
                            "id": "690900418",
                            "speaker": "Player",
                            "text": "但茶壶我没法给你…"
                        },
                        {
                            "id": "690900419",
                            "speaker": "夏沃蕾",
                            "text": "…这样。好吧。"
                        },
                        {
                            "id": "690900420",
                            "speaker": "夏沃蕾",
                            "text": "那我要给你制定加训方案了。希望你不要喊苦喊累。"
                        }
                    ]
                },
                {
                    "id": "690900408",
                    "text": "多少报酬？",
                    "response": [
                        {
                            "id": "690900409",
                            "speaker": "夏沃蕾",
                            "text": "我出手从不小气。朋友一场，更是不会少你好处。"
                        },
                        {
                            "id": "690900410",
                            "speaker": "夏沃蕾",
                            "text": "顺带一提，庆功宴上的菜肴如果你吃不习惯，我可以和你共同分享某些罪恶的食物。"
                        }
                    ]
                }
            ]
        }
    ]
}