    "dialogues": [
        {
            "id": "414010201",
            "speaker": "季同",
            "text": "嗯…这台「留影机」果然值得好好研究一下啊…",
            "choices": [
                {
                    "id": "414010202",
                    "text": "兑换「福至宝匣」",
                    "response": [
                        {
                            "id": "414010203",
                            "speaker": "季同",
                            "text": "印出来了什么？给我看看…"
                        }
                    ]
                },
                {
                    "id": "414010204",
                    "text": "这台「留影机」从哪来的？",
                    "response": [
                        {
                            "id": "414010205",
                            "speaker": "季同",
                            "text": "这个啊，这台「留影机」我是从一个枫丹的商人手里收购的。"
                        },
                        {
                            "id": "414010206",
                            "speaker": "季同",
                            "text": "他和我说，这台「留影机」印出来的画，会有一种特别的效果，肯定很受欢迎。"
                        },
                        {
                            "id": "414010207",
                            "speaker": "季同",
                            "text": "我就相信了他，但是买回来之后，这台「留影机」印出来的东西我都不知道是什么…"
                        },
                        {
                            "id": "414010208",
                            "speaker": "季同",
                            "text": "难道是我哪里操作错了？但我现在也不知道去哪找他啊，唉…"
                        }
                    ]
                },
                {
                    "id": "414010209",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "414010210",
                            "speaker": "季同",
                            "text": "再见…奇怪了，这台「留影机」到底怎么回事…"
                        }
                    ]
                }
            ]
        }
    ]
}