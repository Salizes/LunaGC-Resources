    "dialogues": [
        {
            "id": "716529801",
            "speaker": "Player",
            "text": "你…还没毕业？"
        },
        {
            "id": "716529802",
            "speaker": "胡塞尼",
            "text": "…什么叫还没？我还没到30岁，没毕业不是很正常？"
        },
        {
            "id": "716529803",
            "speaker": "胡塞尼",
            "text": "再说，在教令院，过了30岁还没毕业也是很正常的事。"
        },
        {
            "id": "716529804",
            "speaker": "胡塞尼",
            "text": "别盯着我的头发看了，为了追求智慧，这是必须的代价！"
        }
    ]
}