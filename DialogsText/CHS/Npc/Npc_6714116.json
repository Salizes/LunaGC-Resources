{
    "talkId": "6714116",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "阿莎莎·郎勃罗": 8
    },
    "dialogues": [
        {
            "id": "671411601",
            "speaker": "Player",
            "text": "你可以给我讲一个笑话吗？"
        },
        {
            "id": "671411602",
            "speaker": "阿莎莎·郎勃罗",
            "text": "什么是笑话？"
        },
        {
            "id": "671411603",
            "speaker": "Player",
            "text": "就是让人笑起来的话。"
        },
        {
            "id": "671411604",
            "speaker": "阿莎莎·郎勃罗",
            "text": "你今天真好看！"
        },
        {
            "id": "671411605",
            "speaker": "Player",
            "text": "谢谢。"
        },
        {
            "id": "671411606",
            "speaker": "阿莎莎·郎勃罗",
            "text": "这个笑话怎么样？"
        },
        {
            "id": "671411607",
            "speaker": "Player",
            "text": "虽然很好，但这个不算笑话。"
        },
        {
            "id": "671411608",
            "speaker": "阿莎莎·郎勃罗",
            "text": "怎么不是啦？昨天爱诺就是这么对伊涅芙说的，伊涅芙笑了，我看到了！"
        },
        {
            "id": "671411609",
            "speaker": "Player",
            "text": "好吧，你还有别的笑话吗？"
        },
        {
            "id": "671411610",
            "speaker": "阿莎莎·郎勃罗",
            "text": "你好丑哦！"
        },
        {
            "id": "671411611",
            "speaker": "阿莎莎·郎勃罗",
            "text": "嗯？你怎么不笑了？这是前天爱诺把奶油抹在伊涅芙脸上的时候说的，伊涅芙也笑了，我也看到了…"
        },
        {
            "id": "671411612",
            "speaker": "阿莎莎·郎勃罗",
            "text": "喂！你那是什么眼神啊？你是不是想说这也不算笑话？"
        },
        {
            "id": "671411613",
            "speaker": "阿莎莎·郎勃罗",
            "text": "看来你根本不懂笑话…快走开！我再也不跟你说笑话了！"
        }
    ]
}