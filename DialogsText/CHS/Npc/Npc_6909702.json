{
    "talkId": "6909702",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "赛索斯": 11
    },
    "dialogues": [
        {
            "id": "690970201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690970202",
            "speaker": "赛索斯",
            "text": "当然，非常好。"
        },
        {
            "id": "690970203",
            "speaker": "赛索斯",
            "text": "我向来随遇而安，什么环境都能适应，就更不用说这样优美宜人的地方了。",
            "choices": [
                {
                    "id": "690970204",
                    "text": "我用心布置过了。",
                    "response": [
                        {
                            "id": "690970205",
                            "speaker": "赛索斯",
                            "text": "嗯，看得出来。"
                        },
                        {
                            "id": "690970206",
                            "speaker": "赛索斯",
                            "text": "有人喜欢出门游玩，有人则喜欢把自家整理得温馨舒适，独享清净。"
                        },
                        {
                            "id": "690970207",
                            "speaker": "赛索斯",
                            "text": "在我看来，形式不同，但都是热爱生活的表现。"
                        },
                        {
                            "id": "690970211",
                            "speaker": "赛索斯",
                            "text": "说起来，这里真是宽敞，不仅有房屋建筑，还有大片的空地…"
                        },
                        {
                            "id": "690970212",
                            "speaker": "赛索斯",
                            "text": "如果能按照不同风貌设计一番，岂不是每天都能换着地方露营玩耍了？"
                        },
                        {
                            "id": "690970213",
                            "speaker": "赛索斯",
                            "text": "你想的话，可以叫我来帮忙。"
                        },
                        {
                            "id": "690970214",
                            "speaker": "赛索斯",
                            "text": "我脑子里已经出现不少合适的摆设了。"
                        }
                    ]
                },
                {
                    "id": "690970208",
                    "text": "久疏打理，见笑了。",
                    "response": [
                        {
                            "id": "690970209",
                            "speaker": "赛索斯",
                            "text": "不不不，别这样说。"
                        },
                        {
                            "id": "690970210",
                            "speaker": "赛索斯",
                            "text": "我也是个喜欢出门冒险的人，家中布置得就比较简单了，可能还没有你这整洁呢。"
                        }
                    ]
                }
            ]
        }
    ]
}