{
    "talkId": "6908402",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "林尼": 10
    },
    "dialogues": [
        {
            "id": "690840201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690840202",
            "speaker": "林尼",
            "text": "你的家真厉害！即使是我这样的大魔术师，都可以说闻所未闻，见所未见！"
        },
        {
            "id": "690840203",
            "speaker": "林尼",
            "text": "但要是我说，我已经完全适应了…你会不会觉得我在撒谎？",
            "choices": [
                {
                    "id": "690840204",
                    "text": "不像真的。",
                    "response": [
                        {
                            "id": "690840205",
                            "speaker": "林尼",
                            "text": "这回答可真让人伤心啊——"
                        },
                        {
                            "id": "690840206",
                            "speaker": "林尼",
                            "text": "不过，确实是真话哦。"
                        },
                        {
                            "id": "690840207",
                            "speaker": "林尼",
                            "text": "看来，我要在这里多待上一段时间了！毕竟，只有通过时间才能让你重新相信我嘛。"
                        },
                        {
                            "id": "690840208",
                            "speaker": "林尼",
                            "text": "可别赶我走哦？"
                        }
                    ]
                },
                {
                    "id": "690840209",
                    "text": "我相信你。",
                    "response": [
                        {
                            "id": "690840210",
                            "speaker": "林尼",
                            "text": "嘿嘿，很荣幸能获得你的信任。"
                        },
                        {
                            "id": "690840211",
                            "speaker": "林尼",
                            "text": "面对你，我总是没法编出谎话…可能是不想看到你受伤的表情吧。"
                        },
                        {
                            "id": "690840212",
                            "speaker": "林尼",
                            "text": "咳咳，言归正传！既然你这么关心我，一定希望我再多待会儿吧？"
                        },
                        {
                            "id": "690840213",
                            "speaker": "林尼",
                            "text": "那就请你好好招待我了哦？"
                        }
                    ]
                }
            ]
        }
    ]
}