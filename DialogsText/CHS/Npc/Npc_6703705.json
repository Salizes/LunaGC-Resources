    "dialogues": [
        {
            "id": "670370501",
            "speaker": "Player",
            "text": "关于你的手艺…"
        },
        {
            "id": "670370502",
            "speaker": "阿锦",
            "text": "呵呵…瞧您说的，我哪有什么手艺呀。只不过是在老家就常做针线活，熟能生巧罢了。"
        },
        {
            "id": "670370503",
            "speaker": "阿锦",
            "text": "虽说对不起老师的期待，让一起学裁缝的同学们知道大抵也要被取笑，但能在这种地方派上用场，也算是没白学吧。"
        }
    ]
