{
    "talkId": "6910207",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "玛拉妮": 11
    },
    "dialogues": [
        {
            "id": "691020201",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "691020202",
            "speaker": "玛拉妮",
            "text": "嘻嘻，从小到大我既不怕生又不认床，在这里真的没有一点不习惯哎。"
        },
        {
            "id": "691020203",
            "speaker": "玛拉妮",
            "text": "你知道吗？在纳塔，大多数龙伙伴都很有领地意识，只有它们接纳的人才会被允许进入自己的地盘。"
        },
        {
            "id": "691020204",
            "speaker": "玛拉妮",
            "text": "你能邀请我来这里，说明是把我当好朋友了。我真的很开心，嘴角这一整天都压不下来！",
            "choices": [
                {
                    "id": "691020205",
                    "text": "没错，我就是这样的龙。",
                    "response": [
                        {
                            "id": "691020206",
                            "speaker": "玛拉妮",
                            "text": "哈哈…那你的领地真的很漂亮哦！"
                        },
                        {
                            "id": "691020207",
                            "speaker": "玛拉妮",
                            "text": "在纳塔人的观念里，龙是伙伴、是家人、是不可或缺的一份子。"
                        },
                        {
                            "id": "691020208",
                            "speaker": "玛拉妮",
                            "text": "你也是我人生中重要的朋友，所以我才会这样比喻。"
                        },
                        {
                            "id": "691020212",
                            "speaker": "Player",
                            "text": "「咿——」"
                        },
                        {
                            "id": "691020213",
                            "speaker": "玛拉妮",
                            "text": "…欸？"
                        },
                        {
                            "id": "691020214",
                            "speaker": "Player",
                            "text": "像不像鳍游龙开心的叫声？"
                        },
                        {
                            "id": "691020215",
                            "speaker": "玛拉妮",
                            "text": "哈哈哈，听出来了听出来了！"
                        },
                        {
                            "id": "691020216",
                            "speaker": "玛拉妮",
                            "text": "「咿——」！「咿——」！「咿——」！"
                        }
                    ]
                },
                {
                    "id": "691020209",
                    "text": "龙伙伴有表达开心的叫声吗？",
                    "response": [
                        {
                            "id": "691020210",
                            "speaker": "玛拉妮",
                            "text": "哈？哈哈哈，还真问倒我了…要不，我们自创一个？"
                        },
                        {
                            "id": "691020211",
                            "speaker": "玛拉妮",
                            "text": "作为我们两个人的「叫声暗号」，用来表示愉快啊、打招呼啊、好笑啊之类正面的信号！"
                        }
                    ]
                }
            ]
        }
    ]
}