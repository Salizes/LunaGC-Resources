    "dialogues": [
        {
            "id": "690350201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690350202",
            "speaker": "七七",
            "text": "嗯，这里很好。很安静。"
        },
        {
            "id": "690350203",
            "speaker": "七七",
            "text": "白天也能做柔软体操，不会被人看见。"
        },
        {
            "id": "690350204",
            "speaker": "七七",
            "text": "需要记住的事情，不多。",
            "choices": [
                {
                    "id": "690350205",
                    "text": "笔记有好好带在身边吧？",
                    "response": [
                        {
                            "id": "690350206",
                            "speaker": "七七",
                            "text": "笔记？笔记…"
                        },
                        {
                            "id": "690350207",
                            "speaker": "七七",
                            "text": "笔记…是什么来着？"
                        },
                        {
                            "id": "690350211",
                            "speaker": "Player",
                            "text": "（糟糕…）"
                        },
                        {
                            "id": "690350213",
                            "speaker": "七七",
                            "text": "没事哦。不会有问题的。"
                        },
                        {
                            "id": "690350214",
                            "speaker": "七七",
                            "text": "因为七七，很厉害。"
                        }
                    ]
                },
                {
                    "id": "690350208",
                    "text": "七七不会忘记采药的方法吧？",
                    "response": [
                        {
                            "id": "690350209",
                            "speaker": "七七",
                            "text": "采药？采药…"
                        },
                        {
                            "id": "690350210",
                            "speaker": "七七",
                            "text": "采药…是什么来着？"
                        },
                        {
                            "id": "690350212",
                            "speaker": "Player",
                            "text": "我会帮你想起来的。"
                        }
                    ]
                }
            ]
        }
    ]
