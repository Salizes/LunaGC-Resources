    "dialogues": [
        {
            "id": "651320201",
            "speaker": "Player",
            "text": "近况可好？"
        },
        {
            "id": "651320202",
            "speaker": "桑尼",
            "text": "承您吉言，虽然总有些需要处理的脏东西，但正如我们枫丹俗语所说，「这就是生活」。"
        },
        {
            "id": "651320203",
            "speaker": "桑尼",
            "text": "您不这么认为吗？亲爱的卢卡。"
        },
        {
            "id": "651320204",
            "speaker": "卢卡",
            "text": "生活？哼！"
        },
        {
            "id": "651320205",
            "speaker": "桑尼",
            "text": "您瞧，卢卡还是一如既往地妙语连珠。我很高兴他能以更加精简的语言回答您的问题。"
        }
    ]
}