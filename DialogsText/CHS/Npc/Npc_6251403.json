    "dialogues": [
        {
            "id": "625140301",
            "speaker": "Player",
            "text": "这船很有特色。"
        },
        {
            "id": "625140302",
            "speaker": "泊溯",
            "text": "你挺有眼光！"
        },
        {
            "id": "625140303",
            "speaker": "泊溯",
            "text": "这沉玉谷水浅弯多，大船进来容易搁浅。"
        },
        {
            "id": "625140304",
            "speaker": "泊溯",
            "text": "咱这小竹筏就不一样，重量轻吃水浅，不管什么急弯暗礁，都挡不住咱们。"
        },
        {
            "id": "625140305",
            "speaker": "泊溯",
            "text": "当然，更重要的是，这沉玉谷的山水风光，就得乘着竹筏慢慢漂，细细赏…"
        }
    ]
}