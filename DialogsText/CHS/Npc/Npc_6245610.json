    "dialogues": [
        {
            "id": "624561001",
            "speaker": "Player",
            "text": "你好，这里卖月亮吗？"
        },
        {
            "id": "624561002",
            "speaker": "步云",
            "text": "嗯果然是您，好久不见。"
        },
        {
            "id": "624561003",
            "speaker": "步云",
            "text": "我记得您是之前就得到了「玉衡特许」的贵客，又是助力过群玉阁重建的重要客人，我自然认得出。"
        },
        {
            "id": "624561004",
            "speaker": "步云",
            "text": "失敬了，请由此登阁吧。"
        }
    ]
}