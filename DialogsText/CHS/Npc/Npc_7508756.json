    "speaker_counts": {
        "Player": 2,
        "琪希可": 5
    },
    "dialogues": [
        {
            "id": "750875601",
            "speaker": "琪希可",
            "text": "欢迎来到帕帕卡飞行学校！",
            "choices": [
                {
                    "id": "750875602",
                    "text": "你在这里做什么？",
                    "response": [
                        {
                            "id": "750875604",
                            "speaker": "琪希可",
                            "text": "给学员必要的指引和帮助。现在和以前可真不一样了，要知道以前可是没有这些贴心的服务的。"
                        },
                        {
                            "id": "750875605",
                            "speaker": "琪希可",
                            "text": "但是有一次因为教练在指导时言辞有些…严厉？偏偏那个学员也是个脾气火爆的人物…唉，当时的场面我都不愿再提。"
                        },
                        {
                            "id": "750875606",
                            "speaker": "琪希可",
                            "text": "总之自那之后飞行学校就改变了指导的方针。伸手不打笑脸人，谁也不会讨厌被夸吧？"
                        }
                    ]
                },
                {
                    "id": "750875603",
                    "text": "先走了。",
                    "response": [
                        {
                            "id": "750875607",
                            "speaker": "琪希可",
                            "text": "祝你度过愉快的一天！"
                        }
                    ]
                }
            ]
        }
    ]
}