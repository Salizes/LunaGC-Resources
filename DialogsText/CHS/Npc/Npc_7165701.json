    "dialogues": [
        {
            "id": "716570101",
            "speaker": "凯瑟琳",
            "text": "感谢你这段时间的努力，冒险家，现在我们已经收集到足够多的关于「飘浮灵」的情报了。",
            "choices": [
                {
                    "id": "716570102",
                    "text": "帮上忙就好。",
                    "response": [
                        {
                            "id": "716570103",
                            "speaker": "凯瑟琳",
                            "text": "嗯，你提供的观察情报非常重要，太感谢了。"
                        },
                        {
                            "id": "716570106",
                            "speaker": "凯瑟琳",
                            "text": "之后就不用太担心「飘浮灵」威胁到普通人的安全了，这次的情报我也会整理起来，交给专业的学者去研究。"
                        },
                        {
                            "id": "716570107",
                            "speaker": "凯瑟琳",
                            "text": "对了，不要忘记领取协会提供的报酬哦！"
                        },
                        {
                            "id": "716570108",
                            "speaker": "凯瑟琳",
                            "text": "向着星辰与深渊！冒险家协会感谢你所做的一切！"
                        }
                    ]
                },
                {
                    "id": "716570104",
                    "text": "想要更多奖励。",
                    "response": [
                        {
                            "id": "716570105",
                            "speaker": "凯瑟琳",
                            "text": "哈哈，没问题，那请不要错过冒险家协会之后的委托。"
                        }
                    ]
                }
            ]
        }
    ]
}