{
    "talkId": "6911308",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "伊法": 14
    },
    "dialogues": [
        {
            "id": "691130301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "691130302",
            "speaker": "伊法",
            "text": "没问题。"
        },
        {
            "id": "691130303",
            "speaker": "伊法",
            "text": "我这里有零食，正好，来点吗？",
            "choices": [
                {
                    "id": "691130304",
                    "text": "是用来喂龙的吗？",
                    "response": [
                        {
                            "id": "691130306",
                            "speaker": "伊法",
                            "text": "自己吃也行，喂龙也行，多带点食物不会错。"
                        },
                        {
                            "id": "691130307",
                            "speaker": "伊法",
                            "text": "这些是我自己烤的肉干，尝尝吧，很好吃的。",
                            "choices": [
                                {
                                    "id": "691130308",
                                    "text": "好脆，好好吃！",
                                    "response": [
                                        {
                                            "id": "691130309",
                                            "speaker": "伊法",
                                            "text": "是吗？那就好。还有撒了其他调料的，下次带给你。"
                                        },
                                        {
                                            "id": "691130315",
                                            "speaker": "伊法",
                                            "text": "对了，这袋肉干给你，拿去喂龙可以跟它们搞好关系。"
                                        },
                                        {
                                            "id": "691130316",
                                            "speaker": "伊法",
                                            "text": "不确定你是否有这种需要，先拿着吧。"
                                        },
                                        {
                                            "id": "691130317",
                                            "speaker": "Player",
                                            "text": "伊法做事好周到啊，谢谢你。"
                                        },
                                        {
                                            "id": "691130318",
                                            "speaker": "伊法",
                                            "text": "你能这么想，我很高兴。"
                                        },
                                        {
                                            "id": "691130319",
                                            "speaker": "伊法",
                                            "text": "不过不瞒你说，我小时候也很丢三落四，当了医生以后才好起来。"
                                        },
                                        {
                                            "id": "691130327",
                                            "speaker": "伊法",
                                            "text": "糟糕事难免有，但总会过去的。"
                                        },
                                        {
                                            "id": "691130328",
                                            "speaker": "伊法",
                                            "text": "也祝你无论遇到什么困难都能越过去。"
                                        }
                                    ]
                                },
                                {
                                    "id": "691130310",
                                    "text": "谢谢，不过…很难嚼呢…",
                                    "response": [
                                        {
                                            "id": "691130311",
                                            "speaker": "伊法",
                                            "text": "糟糕，默认你的牙口和龙一样好了…"
                                        },
                                        {
                                            "id": "691130312",
                                            "speaker": "伊法",
                                            "text": "不好意思，那换些别的吧，还有烤好的小饼干…"
                                        },
                                        {
                                            "id": "691130313",
                                            "speaker": "Player",
                                            "text": "这个脆多了呢。"
                                        },
                                        {
                                            "id": "691130314",
                                            "speaker": "伊法",
                                            "text": "嚼得动就好。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "691130305",
                    "text": "是应急的干粮吗？"
                }
            ]
        }
    ]
}