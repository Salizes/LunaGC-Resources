        {
            "id": "644690301",
            "speaker": "Player",
            "text": "什么商机？"
        },
        {
            "id": "644690302",
            "speaker": "扎娅",
            "text": "拜达港和枫丹太近了，大家对枫丹的新鲜玩意已经见怪不怪了。"
        },
        {
            "id": "644690303",
            "speaker": "扎娅",
            "text": "可他们对璃月还知之甚少啊！"
        },
        {
            "id": "644690304",
            "speaker": "扎娅",
            "text": "商人的嗅觉不会出错，嗯，如果把璃月美食引进拜达港，比如…"
        }
