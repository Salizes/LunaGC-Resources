{
    "talkId": "6902604",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "魈": 13
    },
    "dialogues": [
        {
            "id": "690260401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
        },
        {
            "id": "690260402",
            "speaker": "魈",
            "text": "若你有空，可否一同前往璃月港内…"
        },
        {
            "id": "690260403",
            "speaker": "魈",
            "text": "没空便作罢。",
            "choices": [
                {
                    "id": "690260404",
                    "text": "当然可以。",
                    "response": [
                        {
                            "id": "690260405",
                            "speaker": "魈",
                            "text": "好。"
                        },
                        {
                            "id": "690260408",
                            "speaker": "魈",
                            "text": "我无意接近凡人的生活。"
                        },
                        {
                            "id": "690260409",
                            "speaker": "魈",
                            "text": "但我知道你经常出入城市，行走在人群之间。"
                        },
                        {
                            "id": "690260410",
                            "speaker": "魈",
                            "text": "这期间的故事…或者乐趣，如果不亲自体会的话，恐怕就难以获悉你的心情。"
                        },
                        {
                            "id": "690260411",
                            "speaker": "Player",
                            "text": "所以…魈是为了我？"
                        },
                        {
                            "id": "690260412",
                            "speaker": "魈",
                            "text": "嗯，想要理解你。"
                        },
                        {
                            "id": "690260413",
                            "speaker": "魈",
                            "text": "预感到会很困难…但有了这样的想法之后，无法坐视不管。"
                        },
                        {
                            "id": "690260414",
                            "speaker": "魈",
                            "text": "在城内我会控制好自己。"
                        },
                        {
                            "id": "690260415",
                            "speaker": "魈",
                            "text": "尽量…少说话吧。",
                            "choices": [
                                {
                                    "id": "690260416",
                                    "text": "嗯，我会陪着你。",
                                    "response": [
                                        {
                                            "id": "690260418",
                                            "speaker": "魈",
                                            "text": "嗯…"
                                        },
                                        {
                                            "id": "690260419",
                                            "speaker": "魈",
                                            "text": "准备好出发了，就告诉我吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690260417",
                                    "text": "说什么都没关系，我能帮你圆。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690260406",
                    "text": "魈终于想融入城市了？",
                    "response": [
                        {
                            "id": "690260407",
                            "speaker": "魈",
                            "text": "咳咳…"
                        }
                    ]
                }
            ]
        }
    ]
}