{
    "talkId": "4008131",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 7,
        "留言板": 9
    },
    "dialogues": [
        {
            "id": "400813101",
            "speaker": "留言板",
            "text": "「『月莲杯驯兽师大赛』现已开幕！上百位参赛选手正在捕捉蕈兽，组建强而有力的队伍！」"
        },
        {
            "id": "400813102",
            "speaker": "留言板",
            "text": "「准备阶段结束后，工作人员将确认选手们是否集齐了四只蕈兽，并随机决出预赛的赛程。」",
            "choices": [
                {
                    "id": "400813103",
                    "text": "查阅「大赛规则」…",
                    "response": [
                        {
                            "id": "400813104",
                            "speaker": "派蒙",
                            "text": "唔，这里写了好多好多条目！还有什么…免责声明？"
                        },
                        {
                            "id": "400813105",
                            "speaker": "派蒙",
                            "text": "好难懂啦，不想读，我们都跳过吧，最重要的是奖金…",
                            "choices": [
                                {
                                    "id": "400813106",
                                    "text": "派蒙…",
                                    "response": [
                                        {
                                            "id": "400813108",
                                            "speaker": "派蒙",
                                            "text": "不对不对！是有关蕈兽的内容，比如说，能不能让蕈兽在公开场合露面什么的…"
                                        },
                                        {
                                            "id": "400813109",
                                            "speaker": "派蒙",
                                            "text": "欸嘿嘿，我们找找看吧！"
                                        },
                                        {
                                            "id": "400813110",
                                            "speaker": "留言板",
                                            "text": "「赛事奖励·八强级：总量可观的摩拉、首届『月莲杯』大赛限定荣誉称号，以及保留王牌蕈兽的资格…」"
                                        },
                                        {
                                            "id": "400813111",
                                            "speaker": "派蒙",
                                            "text": "总量可观的摩拉？原来没有写清楚具体的数额啊…倒是这个保留王牌蕈兽的资格，说的是可以选一只蕈兽，带回家里去生活吗？"
                                        },
                                        {
                                            "id": "400813112",
                                            "speaker": "派蒙",
                                            "text": "我们再看看吧…"
                                        },
                                        {
                                            "id": "400813113",
                                            "speaker": "留言板",
                                            "text": "「蕈兽活动规范·第三条：经过『意智宝珠』控制，并登记在册的蕈兽，可以在赛场周围活动，但请驯兽师们注意行动的边界。」"
                                        },
                                        {
                                            "id": "400813114",
                                            "speaker": "留言板",
                                            "text": "「可活动的区域仅限于赛场周围、奥摩斯港的主要道路，切勿将蕈兽带入以下公共场所：维卡拉商栈、所有商店、餐馆。」"
                                        },
                                        {
                                            "id": "400813115",
                                            "speaker": "留言板",
                                            "text": "「目前，本赛事尚未被所有民众接受，若是蕈兽突然出现在不知情的民众面前，可能引起恐慌和混乱，建议大家谨慎行事。」"
                                        },
                                        {
                                            "id": "400813116",
                                            "speaker": "留言板",
                                            "text": "「『三十人团』将监督参赛选手，一旦违规，将取消选手的参赛资格，情节严重者，可能会被追究责任，受到教令院的惩罚」"
                                        },
                                        {
                                            "id": "400813117",
                                            "speaker": "派蒙",
                                            "text": "呜啊…规矩好严格！我们也一定要小心！"
                                        }
                                    ]
                                },
                                {
                                    "id": "400813107",
                                    "text": "你又露馅了…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400813118",
                    "text": "关于留言活动…",
                    "response": [
                        {
                            "id": "400813119",
                            "speaker": "留言板",
                            "text": "「预赛结果揭晓后，观众们可以在这块赛事公告板上留言，尽情声援自己支持的选手，或是发表对于蕈兽的见解！」"
                        },
                        {
                            "id": "400813120",
                            "speaker": "留言板",
                            "text": "「出于多种考量，所有留言将由工作人员审核后发表，也请各位观众不要发表太过激烈的言论，友善地留言！」"
                        }
                    ]
                },
                {
                    "id": "400813121",
                    "text": "离去。"
                }
            ]
        }
    ]
}