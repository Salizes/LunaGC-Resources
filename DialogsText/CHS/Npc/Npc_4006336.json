    "dialogues": [
        {
            "id": "400633601",
            "speaker": "Player",
            "text": "一本都没卖出去吗？"
        },
        {
            "id": "400633602",
            "speaker": "茅葺一庆",
            "text": "……"
        },
        {
            "id": "400633603",
            "speaker": "茅葺一庆",
            "text": "嗯…的确。"
        },
        {
            "id": "400633604",
            "speaker": "茅葺一庆",
            "text": "不过，我相信这只是一时的，毕竟，就算是名作家常老师也有过寂寂无名的时期。"
        },
        {
            "id": "400633605",
            "speaker": "茅葺一庆",
            "text": "这种窘境就和话本里的武道试炼一样，也是一种磨炼心性的写作者生涯试炼吧，只要坚持过去…"
        },
        {
            "id": "400633606",
            "speaker": "茅葺一庆",
            "text": "总有一天我的作品会获得认可！"
        }
    ]
}