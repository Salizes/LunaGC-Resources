    "dialogues": [
        {
            "id": "617000201",
            "speaker": "Player",
            "text": "最近怎么样？"
        },
        {
            "id": "617000202",
            "speaker": "安娜",
            "text": "啊，旅行者！是你啊。"
        },
        {
            "id": "617000203",
            "speaker": "安娜",
            "text": "我…正在「循序渐进」地开展冒险活动呢。"
        },
        {
            "id": "617000204",
            "speaker": "安娜",
            "text": "已经完成了「护送委托」，「护送委托」和「护送委托」。"
        },
        {
            "id": "617000205",
            "speaker": "安东尼",
            "text": "没错，安娜对于这种委托已经做得很好了。"
        },
        {
            "id": "617000206",
            "speaker": "安东尼",
            "text": "就我所见，她已经可以称得上是精通「护送委托」了。"
        },
        {
            "id": "617000207",
            "speaker": "安娜",
            "text": "哥！我都做了多少天这种委托了，我想要一场轰轰烈烈的冒险啦！"
        },
        {
            "id": "617000208",
            "speaker": "安东尼",
            "text": "所以说，做事要循序渐进。"
        },
        {
            "id": "617000209",
            "speaker": "安娜",
            "text": "呜…"
        }
    ]
}