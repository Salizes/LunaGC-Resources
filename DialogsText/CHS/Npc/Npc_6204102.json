{
    "talkId": "6204102",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "吴船长": 8
    },
    "dialogues": [
        {
            "id": "620410201",
            "speaker": "Player",
            "text": "你在干什么？"
        },
        {
            "id": "620410202",
            "speaker": "吴船长",
            "text": "唉，我只是一个平凡的跑船人，辛苦了小半辈子攒了些钱，现在正在犹豫要不要把钱存起来…"
        },
        {
            "id": "620410203",
            "speaker": "吴船长",
            "text": "你说，我是把钱存起来好，还是不存比较好呢？",
            "choices": [
                {
                    "id": "620410204",
                    "text": "就存起来？",
                    "response": [
                        {
                            "id": "620410205",
                            "speaker": "吴船长",
                            "text": "可是可是，如果要是存起来，说不定会错过一大波商机啊…"
                        },
                        {
                            "id": "620410206",
                            "speaker": "吴船长",
                            "text": "唉，你是不知道，在岩王爷的地盘上做买卖还是挺赚钱的…"
                        },
                        {
                            "id": "620410207",
                            "speaker": "吴船长",
                            "text": "要是拿着这笔钱去做生意、赚更多的钱，说不定哪天都可以把船换成凝光大人那样的款式…"
                        }
                    ]
                },
                {
                    "id": "620410208",
                    "text": "要不别先存？",
                    "response": [
                        {
                            "id": "620410209",
                            "speaker": "吴船长",
                            "text": "可是可是，如果做生意赔了，那我真是血本无归了…"
                        },
                        {
                            "id": "620410210",
                            "speaker": "吴船长",
                            "text": "而且现在七星正在对市场的动向进行调控，如果要是一不小心跟错了方向…"
                        },
                        {
                            "id": "620410211",
                            "speaker": "吴船长",
                            "text": "唉，那我努力了小半辈子的血汗钱就全都打水漂了…"
                        }
                    ]
                }
            ]
        }
    ]
}