    "dialogues": [
        {
            "id": "631410201",
            "speaker": "Player",
            "text": "你看起来很紧张。"
        },
        {
            "id": "631410202",
            "speaker": "阿波",
            "text": "啊哈哈…这么明显吗…"
        },
        {
            "id": "631410203",
            "speaker": "阿波",
            "text": "确实，我老是容易紧张，可能是因为我的视力很好吧。看见的东西越多，承受的压力就越大。"
        },
        {
            "id": "631410204",
            "speaker": "阿波",
            "text": "我能从这里看到很远的地方哦。上次往海那边看的时候，还发现了外国人的船只，上面的人打扮得挺招摇，好多还戴着面具。"
        },
        {
            "id": "631410205",
            "speaker": "阿波",
            "text": "…难道是愚人众吗？那可得多加留意，不能让他们随便靠岸。"
        }
    ]
}