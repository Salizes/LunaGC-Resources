{
    "talkId": "6990032",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 4,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "699003201",
            "speaker": "Player",
            "text": "关于占卜…"
        },
        {
            "id": "699003202",
            "speaker": "派蒙",
            "text": "说起来，须弥的人似乎很热衷于算命占卜。"
        },
        {
            "id": "699003203",
            "speaker": "派蒙",
            "text": "除了学者们才会的占星术之外，普通须弥人用咖啡就能进行占卜！",
            "choices": [
                {
                    "id": "699003204",
                    "text": "毕竟是智慧的国度…",
                    "response": [
                        {
                            "id": "699003206",
                            "speaker": "派蒙",
                            "text": "我听他们说，只要根据咖啡喝完之后杯底上的形状，就能知道一个人的命运…"
                        },
                        {
                            "id": "699003207",
                            "speaker": "派蒙",
                            "text": "和爬到塔上面看一晚上星星比起来，要方便多了呢！"
                        },
                        {
                            "id": "699003208",
                            "speaker": "Player",
                            "text": "派蒙也想知道自己的命运吗？"
                        },
                        {
                            "id": "699003209",
                            "speaker": "派蒙",
                            "text": "嗯…不过比起命运，我还是更想知道咖啡好不好喝。"
                        }
                    ]
                },
                {
                    "id": "699003205",
                    "text": "大家的好奇心都很强吧。"
                }
            ]
        }
    ]
}