{
    "talkId": "4008148",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "留言板": 12
    },
    "dialogues": [
        {
            "id": "400814801",
            "speaker": "留言板",
            "text": "「『月莲杯驯兽师大赛』的半决赛即将来临！选手们正不断掀开底牌，全力以赴，为大家献上精彩至极的竞技盛宴…」",
            "choices": [
                {
                    "id": "400814802",
                    "text": "「最受『支持』的留言」",
                    "response": [
                        {
                            "id": "400814803",
                            "speaker": "留言板",
                            "text": "「旋转火蕈兽真的好强啊！它释放爆炸的时候，『映影』的画面都在震动！」"
                        },
                        {
                            "id": "400814804",
                            "speaker": "留言板",
                            "text": "「既然如此，所有选手都用旋转火蕈兽去战斗不就好了？」"
                        }
                    ]
                },
                {
                    "id": "400814805",
                    "text": "「最被『反对』的留言」",
                    "response": [
                        {
                            "id": "400814806",
                            "speaker": "留言板",
                            "text": "「比赛进行到这个程度，我开始好奇了，每个选手训练蕈兽的方式都是什么样的？」"
                        },
                        {
                            "id": "400814807",
                            "speaker": "留言板",
                            "text": "「明明最开始的蕈兽都一样，比赛的时候风格却有这么大的差异，关键肯定在于训练这个环节！」"
                        },
                        {
                            "id": "400814808",
                            "speaker": "留言板",
                            "text": "「希望主办方能让观众们也去特训的场所看一看，我想深入了解选手们的作风，还有他们和蕈兽的日常生活…」"
                        },
                        {
                            "id": "400814809",
                            "speaker": "留言板",
                            "text": "（下面似乎还有针对这条留言的回应…）"
                        },
                        {
                            "id": "400814810",
                            "speaker": "留言板",
                            "text": "「大兄弟，不要犯傻啊！特训的场所可是很危险的，不像普通比赛的场地！」"
                        },
                        {
                            "id": "400814811",
                            "speaker": "留言板",
                            "text": "「而且，选手们一般会在赛场上拿出最佳的表现来吧，我们没必要过分关注他们的一举一动，这也会给他们增添困扰。」"
                        }
                    ]
                },
                {
                    "id": "400814812",
                    "text": "「公认『有趣』的留言」",
                    "response": [
                        {
                            "id": "400814813",
                            "speaker": "留言板",
                            "text": "「前资深冒险家『雪怪伯』先生拿出了自己的积蓄，买下了精彩的比赛『映影』和播放设备！」"
                        },
                        {
                            "id": "400814814",
                            "speaker": "留言板",
                            "text": "「有兴趣的朋友们，可以给我们留言，我们会定期组织活动，去『雪怪伯』先生的家里观看比赛。」"
                        },
                        {
                            "id": "400814815",
                            "speaker": "留言板",
                            "text": "「『雪怪伯』先生不收任何费用，还会为我们提供食物和茶水！但他一个人忙不过来，朋友们如果能自带一些就更好了！」"
                        }
                    ]
                }
            ]
        }
    ]
}