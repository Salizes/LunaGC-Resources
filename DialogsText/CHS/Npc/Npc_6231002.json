    "dialogues": [
        {
            "id": "623100201",
            "speaker": "Player",
            "text": "工坊？"
        },
        {
            "id": "623100202",
            "speaker": "路爷",
            "text": "从我爷爷的爷爷那一代，一直传到老夫手里的木工作坊。"
        },
        {
            "id": "623100203",
            "speaker": "路爷",
            "text": "常家九爷的房子也好，庄里的大磨坊也好，都是我们「范木堂」修的。"
        },
        {
            "id": "623100204",
            "speaker": "路爷",
            "text": "就连七星的人也会来找我们定制家具。"
        }
    ]
}