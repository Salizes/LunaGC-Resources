    "dialogues": [
        {
            "id": "732852201",
            "speaker": "索希",
            "text": "斯露莎大人的「谒颂主」…不，不应该轻易放弃，应该再自己努力一下。",
            "choices": [
                {
                    "id": "732852202",
                    "text": "发生什么事了吗？",
                    "response": [
                        {
                            "id": "732852203",
                            "speaker": "索希",
                            "text": "没什么，只是研究进展不是很顺利。对研究者来说，这也是常有的事。"
                        }
                    ]
                },
                {
                    "id": "732852204",
                    "text": "不打扰你了。",
                    "response": [
                        {
                            "id": "732852205",
                            "speaker": "索希",
                            "text": "感谢你的体谅。那我就继续自己的工作了。"
                        }
                    ]
                }
            ]
        }
    ]
