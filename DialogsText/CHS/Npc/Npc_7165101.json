{
    "talkId": "7165101",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "凯瑟琳": 7
    },
    "dialogues": [
        {
            "id": "716510101",
            "speaker": "凯瑟琳",
            "text": "冒险家，感谢你这些日子的努力，委托你「岩龙蜥」的调查的事，终于可以告一段落了。",
            "choices": [
                {
                    "id": "716510102",
                    "text": "终于结束了…",
                    "response": [
                        {
                            "id": "716510103",
                            "speaker": "凯瑟琳",
                            "text": "辛苦你了，解了协会的燃眉之急。"
                        },
                        {
                            "id": "716510106",
                            "speaker": "凯瑟琳",
                            "text": "去探亲的冒险家们已经陆续回协会报到了，你已经做了很多贡献，收尾的工作就交给我们吧。"
                        },
                        {
                            "id": "716510107",
                            "speaker": "凯瑟琳",
                            "text": "至于为什么「岩龙蜥」这种古老生物会突然出现，我们也会继续调查的。"
                        },
                        {
                            "id": "716510108",
                            "speaker": "凯瑟琳",
                            "text": "对了，不要忘记领取这次调查的报酬哦。"
                        },
                        {
                            "id": "716510109",
                            "speaker": "凯瑟琳",
                            "text": "冒险家协会期待你今后的活跃表现！向着星辰与深渊！"
                        }
                    ]
                },
                {
                    "id": "716510104",
                    "text": "还没尽兴呢。",
                    "response": [
                        {
                            "id": "716510105",
                            "speaker": "凯瑟琳",
                            "text": "哈哈，看来你乐在其中的样子，这再好不过了。"
                        }
                    ]
                }
            ]
        }
    ]
}