{
    "talkId": "6201011",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 5,
        "茶博士刘苏": 21
    },
    "dialogues": [
        {
            "id": "620101101",
            "speaker": "Player",
            "text": "（听听评书）"
        },
        {
            "id": "620101102",
            "speaker": "茶博士刘苏",
            "text": "…众所周知，那古华团门庭凋落，便成了古华堂，古华堂又日落西山，于是成了今日的古华派。"
        },
        {
            "id": "620101103",
            "speaker": "茶博士刘苏",
            "text": "今日咱们讲的便是出自古华派的一位知名少侠，剑客书生。"
        },
        {
            "id": "620101104",
            "speaker": "茶博士刘苏",
            "text": "…话说这少侠是衣冠楚楚，文质彬彬，面如冠玉，目若朗星…"
        },
        {
            "id": "620101105",
            "speaker": "茶博士刘苏",
            "text": "他是秉书携剑，行走江湖，颇有当年古华团剑客之风…"
        },
        {
            "id": "620101106",
            "speaker": "Player",
            "text": "（继续听）"
        },
        {
            "id": "620101107",
            "speaker": "茶博士刘苏",
            "text": "门派虽已经是破落不堪，可行侠仗义之事从来未曾断辍…"
        },
        {
            "id": "620101108",
            "speaker": "茶博士刘苏",
            "text": "话说一日，少侠正行走绝云间的石林之中，只听见云山雾罩之间似有啸聚之声…"
        },
        {
            "id": "620101109",
            "speaker": "茶博士刘苏",
            "text": "跑商路的客人一定明白，完了，这乃是遇上了歹人了！"
        },
        {
            "id": "620101110",
            "speaker": "茶博士刘苏",
            "text": "…只见少侠也不紧不慌，抽剑出鞘，口中是念念有词…"
        },
        {
            "id": "620101111",
            "speaker": "茶博士刘苏",
            "text": "贼人在暗处见这场面那也是一头雾水——",
            "choices": [
                {
                    "id": "620101112",
                    "text": "呀…",
                    "response": [
                        {
                            "id": "620101113",
                            "speaker": "茶博士刘苏",
                            "text": "「这小子，怕是会什么道术妖法？」"
                        },
                        {
                            "id": "620101114",
                            "speaker": "茶博士刘苏",
                            "text": "其实呀，少侠哪会什么道术。您看他念念有词，那是为了迷惑歹人，其实正暗中调动那「神之眼」的力量…"
                        },
                        {
                            "id": "620101115",
                            "speaker": "茶博士刘苏",
                            "text": "…诸位有所不知，古华派的「裁雨法」正在于集水成剑，以柔克刚。"
                        },
                        {
                            "id": "620101116",
                            "speaker": "茶博士刘苏",
                            "text": "那贼人见这小子缺乏防备，便要下手！"
                        },
                        {
                            "id": "620101117",
                            "speaker": "茶博士刘苏",
                            "text": "说时迟那时快，只听当空铮铮如有剑鸣，定睛一瞧，竟是十来柄水塑成的宝剑！"
                        },
                        {
                            "id": "620101118",
                            "speaker": "茶博士刘苏",
                            "text": "正所谓「雨露精华迸寒光，无义贼人尽逃亡」…"
                        },
                        {
                            "id": "620101119",
                            "speaker": "茶博士刘苏",
                            "text": "一眨眼的功夫，歹人便纷纷中剑倒地，痛呼饶命…"
                        },
                        {
                            "id": "620101120",
                            "speaker": "Player",
                            "text": "好！"
                        },
                        {
                            "id": "620101121",
                            "speaker": "茶博士刘苏",
                            "text": "…但这少侠未曾松弛，侧耳只听竹林里窸窣响动，甚是不祥…"
                        },
                        {
                            "id": "620101122",
                            "speaker": "茶博士刘苏",
                            "text": "这竹林里，可还有一双眼睛正盯着他呢…"
                        },
                        {
                            "id": "620101123",
                            "speaker": "茶博士刘苏",
                            "text": "要说这是谁人…"
                        },
                        {
                            "id": "620101124",
                            "speaker": "茶博士刘苏",
                            "text": "诸位，且听我下回分解！"
                        }
                    ]
                },
                {
                    "id": "620101125",
                    "text": "（不听了）",
                    "response": [
                        {
                            "id": "620101126",
                            "speaker": "茶博士刘苏",
                            "text": "「这小子，怕是会什么道术妖法？」其实呀，少侠哪会什么道术…"
                        }
                    ]
                }
            ]
        }
    ]
}