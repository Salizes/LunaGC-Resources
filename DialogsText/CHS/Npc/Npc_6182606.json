    "dialogues": [
        {
            "id": "618260601",
            "speaker": "Player",
            "text": "你很喜欢吗？"
        },
        {
            "id": "618260602",
            "speaker": "曾我隅田流左近重衡",
            "text": "然。一刹花咲，一刹花散。所谓仕者之本怀，亦当如是。"
        },
        {
            "id": "618260603",
            "speaker": "曾我隅田流左近重衡",
            "text": "…话虽如此，某如今却难遂愿，只得遭囚于有常之刻…何等可叹…"
        }
    ]
