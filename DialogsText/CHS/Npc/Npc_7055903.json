    "dialogues": [
        {
            "id": "705590301",
            "speaker": "埃洛雯",
            "text": "欸？是还想体验一遍「测绘寻物」吗？",
            "choices": [
                {
                    "id": "705590302",
                    "text": "是有些意犹未尽呢…",
                    "response": [
                        {
                            "id": "705590307",
                            "speaker": "埃洛雯",
                            "text": "是啊…只可惜这次准备的时间太少，我只草草做了几个标定物。"
                        },
                        {
                            "id": "705590303",
                            "speaker": "埃洛雯",
                            "text": "如果下次有机会能够再组织上一场「测绘寻物」，我一定再多多设计几个，每个著名骑士的形象都要有…"
                        }
                    ]
                },
                {
                    "id": "705590304",
                    "text": "已经在期待下一次…",
                    "response": [
                        {
                            "id": "705590308",
                            "speaker": "埃洛雯",
                            "text": "下一次？没错，虽然大家还没相处几天，但是好像已经是拥有不俗默契的战友了！"
                        },
                        {
                            "id": "705590305",
                            "speaker": "埃洛雯",
                            "text": "如果下一次还能有这样共同学习进步的机会，我一定不会错过。"
                        },
                        {
                            "id": "705590306",
                            "speaker": "埃洛雯",
                            "text": "唔…下次我还要准备更多的食材，让大家尝上真正的「战地大餐」…"
                        }
                    ]
                }
            ]
        }
    ]
}