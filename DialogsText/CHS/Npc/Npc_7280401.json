{
    "talkId": "7280401",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "朝仓": 15,
        "派蒙": 1
    },
    "dialogues": [
        {
            "id": "728040101",
            "speaker": "朝仓",
            "text": "阁下，正巧您来了，今天是至关重要的一天！"
        },
        {
            "id": "728040102",
            "speaker": "Player",
            "text": "难道和你的武器有关…"
        },
        {
            "id": "728040103",
            "speaker": "朝仓",
            "text": "正是！这段时间我四处搜集线索，总算确定了那一队海乱鬼的位置！"
        },
        {
            "id": "728040104",
            "speaker": "朝仓",
            "text": "今天我就要洗刷耻辱，夺回我的武器！"
        },
        {
            "id": "728040105",
            "speaker": "派蒙",
            "text": "哦！朝仓很有干劲呢！"
        },
        {
            "id": "728040106",
            "speaker": "朝仓",
            "text": "不过我必须吸取之前的教训，海乱鬼的人数众多，还都是些不择手段的人。"
        },
        {
            "id": "728040107",
            "speaker": "朝仓",
            "text": "要是他们一哄而上，消耗我的体力，我肯定会陷入被动，就和上次一样…"
        },
        {
            "id": "728040108",
            "speaker": "朝仓",
            "text": "所以，这次我想请阁下与我同行。"
        },
        {
            "id": "728040109",
            "speaker": "朝仓",
            "text": "上次我之所以落败，是因为那群海乱鬼仗着自己人多势众，不断地用车轮战消耗我的实力。"
        },
        {
            "id": "728040110",
            "speaker": "朝仓",
            "text": "等我体力不支后，他们的首领再前来和我对战。"
        },
        {
            "id": "728040111",
            "speaker": "朝仓",
            "text": "这次，我想请您帮我挡住周围的那些海乱鬼，而我会直接去挑战他们的首领。"
        },
        {
            "id": "728040112",
            "speaker": "朝仓",
            "text": "等我斩了那个恶徒，再回来助您。",
            "choices": [
                {
                    "id": "728040113",
                    "text": "没问题。",
                    "response": [
                        {
                            "id": "728040114",
                            "speaker": "朝仓",
                            "text": "阁下愿意协助我，实在感激不尽！"
                        },
                        {
                            "id": "728040119",
                            "speaker": "朝仓",
                            "text": "总之，就拜托阁下了。"
                        },
                        {
                            "id": "728040120",
                            "speaker": "朝仓",
                            "text": "事不宜迟，我们这就出发吧。"
                        }
                    ]
                },
                {
                    "id": "728040115",
                    "text": "听上去我要一个打一群…",
                    "response": [
                        {
                            "id": "728040116",
                            "speaker": "朝仓",
                            "text": "那群海乱鬼，说白了也就是一群除了人数之外一无是处的乌合之众。"
                        },
                        {
                            "id": "728040117",
                            "speaker": "朝仓",
                            "text": "我相信凭阁下的身手，他们就算是一起上，在阁下手底下也走不过三招。"
                        },
                        {
                            "id": "728040118",
                            "speaker": "Player",
                            "text": "咳，谬赞谬赞…"
                        }
                    ]
                }
            ]
        }
    ]
}