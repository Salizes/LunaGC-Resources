{
    "talkId": "6902503",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 6,
        "行秋": 11
    },
    "dialogues": [
        {
            "id": "690250301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690250302",
            "speaker": "行秋",
            "text": "自然可以。和你聊天是件畅快的事。"
        },
        {
            "id": "690250303",
            "speaker": "行秋",
            "text": "你先来说说吧，最近在忙些什么吗？",
            "choices": [
                {
                    "id": "690250304",
                    "text": "运送货物、教训作恶的匪徒之类的…",
                    "response": [
                        {
                            "id": "690250306",
                            "speaker": "行秋",
                            "text": "好！都是「行侠仗义」的大好事。"
                        },
                        {
                            "id": "690250307",
                            "speaker": "行秋",
                            "text": "啊…真想和你二人仗剑走遍天涯。",
                            "choices": [
                                {
                                    "id": "690250308",
                                    "text": "行秋也有身不由己之处吧…",
                                    "response": [
                                        {
                                            "id": "690250309",
                                            "speaker": "行秋",
                                            "text": "不说这些，我刚刚倒是想到了一个好点子。"
                                        },
                                        {
                                            "id": "690250312",
                                            "speaker": "行秋",
                                            "text": "不如我们就来进行一场比试吧，看谁先行得一百桩善事。"
                                        },
                                        {
                                            "id": "690250313",
                                            "speaker": "行秋",
                                            "text": "种类不限，对象不限。但须记录在案。完成之时交由对方确认。"
                                        },
                                        {
                                            "id": "690250314",
                                            "speaker": "Player",
                                            "text": "那我还是很有信心的。"
                                        },
                                        {
                                            "id": "690250315",
                                            "speaker": "行秋",
                                            "text": "哼哼…"
                                        },
                                        {
                                            "id": "690250316",
                                            "speaker": "行秋",
                                            "text": "唔，没什么…真的没什么。"
                                        },
                                        {
                                            "id": "690250317",
                                            "speaker": "行秋",
                                            "text": "那你可要好好努力啊。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690250310",
                                    "text": "我也正有此意。",
                                    "response": [
                                        {
                                            "id": "690250311",
                                            "speaker": "行秋",
                                            "text": "嘿嘿…只可惜那是未来的梦想。要近些的话，有了…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690250305",
                    "text": "驱赶怪物、解救被困之人什么的…"
                }
            ]
        }
    ]
}