{
    "talkId": "6909303",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 9,
        "闲云": 18
    },
    "dialogues": [
        {
            "id": "690930301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690930302",
            "speaker": "闲云",
            "text": "哦？有意思。这可是本仙最擅长的事。"
        },
        {
            "id": "690930303",
            "speaker": "闲云",
            "text": "不过，本仙正在思考一个重要的技术问题…闲聊恐怕还得往后放放。"
        },
        {
            "id": "690930304",
            "speaker": "Player",
            "text": "是什么样的技术问题？"
        },
        {
            "id": "690930305",
            "speaker": "闲云",
            "text": "本仙从前研制过一个「杂务扫理神机」，用于扫地和整理杂物。"
        },
        {
            "id": "690930306",
            "speaker": "闲云",
            "text": "本仙曾为它置入了一些「应声机巧」，只要发出特定声响，就能隔空驱使这机关。"
        },
        {
            "id": "690930307",
            "speaker": "闲云",
            "text": "但没想到，这「应声机巧」还是有些缺陷。若是站得略远，它就无法捕捉声响，也就不能隔空驱使了…"
        },
        {
            "id": "690930308",
            "speaker": "闲云",
            "text": "关于这点…你可有建议？"
        },
        {
            "id": "690930309",
            "speaker": "Player",
            "text": "大声喊叫如何？"
        },
        {
            "id": "690930310",
            "speaker": "闲云",
            "text": "嗯…不可谓不可行，只是略显不雅。"
        },
        {
            "id": "690930311",
            "speaker": "闲云",
            "text": "但经你一提，倒是给了本仙新的灵感。本仙不妨再制作一个…「传波扩声神机」。"
        },
        {
            "id": "690930312",
            "speaker": "闲云",
            "text": "只要神机集采仙力，千里传音，再行驱动其他神机…本仙便连走动的时间都可以省下了。妙！",
            "choices": [
                {
                    "id": "690930313",
                    "text": "仙力真是方便啊…",
                    "response": [
                        {
                            "id": "690930315",
                            "speaker": "闲云",
                            "text": "好了，本仙的难题已解大半，该说回正题了。"
                        },
                        {
                            "id": "690930316",
                            "speaker": "闲云",
                            "text": "你说要与本仙聊天，是想听本仙讲故事吗？",
                            "choices": [
                                {
                                    "id": "690930317",
                                    "text": "对！我会带上好茶。",
                                    "response": [
                                        {
                                            "id": "690930318",
                                            "speaker": "闲云",
                                            "text": "你倒是懂事。有好茶润喉，本仙的故事…当然也会讲得更流利了。"
                                        },
                                        {
                                            "id": "690930321",
                                            "speaker": "闲云",
                                            "text": "不过…咳，有些故事本仙还得先去征询老友的意见，才好和你细讲。"
                                        },
                                        {
                                            "id": "690930322",
                                            "speaker": "闲云",
                                            "text": "与你熟识的那几个小辈，唉，本仙一谈起她们的童年趣事，这些孩子就皱眉耷眼的…"
                                        },
                                        {
                                            "id": "690930323",
                                            "speaker": "闲云",
                                            "text": "还是与你聊天时，本仙最为舒适。不过…你倒是没怎么和本仙提起，你与派蒙先前经历的事。",
                                            "choices": [
                                                {
                                                    "id": "690930324",
                                                    "text": "那个，我还有事…",
                                                    "response": [
                                                        {
                                                            "id": "690930326",
                                                            "speaker": "闲云",
                                                            "text": "哼…小小心思，你不想说，本仙也不问。"
                                                        },
                                                        {
                                                            "id": "690930327",
                                                            "speaker": "闲云",
                                                            "text": "去吧，想说的时候再来找本仙，本仙保证守口如瓶。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690930325",
                                                    "text": "我去拿茶，您在这稍等！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690930319",
                                    "text": "对！想听好故事。",
                                    "response": [
                                        {
                                            "id": "690930320",
                                            "speaker": "闲云",
                                            "text": "本仙的故事…当然全是好故事。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690930314",
                    "text": "不愧是机关术…"
                }
            ]
        }
    ]
}