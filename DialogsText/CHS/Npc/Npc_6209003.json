    "dialogues": [
        {
            "id": "620900301",
            "speaker": "Player",
            "text": "你是…？"
        },
        {
            "id": "620900302",
            "speaker": "长顺",
            "text": "你好，我叫长顺，职业是经商，也是「璃月商贸学」的研究者。"
        },
        {
            "id": "620900303",
            "speaker": "长顺",
            "text": "请问您需要什么吗？"
        },
        {
            "id": "620900304",
            "speaker": "Player",
            "text": "「璃月商贸学」…？"
        },
        {
            "id": "620900305",
            "speaker": "长顺",
            "text": "嗯嗯，简单来说就是以每一个璃月商人的角度出发，研究如何赚最多摩拉的学问。"
        },
        {
            "id": "620900306",
            "speaker": "长顺",
            "text": "毕竟如今的商人只埋头赚钱可不行。只有学习知识、总结规律，才有机会掌握制胜之道。"
        }
    ]
}