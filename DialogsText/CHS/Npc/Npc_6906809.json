{
    "talkId": "6906809",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "多莉": 14
    },
    "dialogues": [
        {
            "id": "690680401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690680402",
            "speaker": "多莉",
            "text": "我们一起来做个金灿灿的雕塑吧！放在这里最显眼的地方！"
        },
        {
            "id": "690680403",
            "speaker": "Player",
            "text": "这就是「改造顾问」的建议？"
        },
        {
            "id": "690680404",
            "speaker": "多莉",
            "text": "没错，我想了很久这里缺什么…"
        },
        {
            "id": "690680405",
            "speaker": "多莉",
            "text": "哼哼，原来是缺少了金灿灿的感觉！",
            "choices": [
                {
                    "id": "690680406",
                    "text": "那…金灿灿的多莉雕塑？",
                    "response": [
                        {
                            "id": "690680407",
                            "speaker": "多莉",
                            "text": "如果你这么想要多莉雕塑的话，也不是不可以！"
                        },
                        {
                            "id": "690680408",
                            "speaker": "多莉",
                            "text": "不过等你能给我一大——笔肖像权使用费之后再说吧。"
                        },
                        {
                            "id": "690680409",
                            "speaker": "多莉",
                            "text": "现在，先来做个摩拉雕塑！"
                        },
                        {
                            "id": "690680413",
                            "speaker": "多莉",
                            "text": "既然这里也是我的据点，那么自然是要符合我的品味！"
                        },
                        {
                            "id": "690680414",
                            "speaker": "多莉",
                            "text": "#不过我先提醒你喔，这毕竟是名声赫赫的桑歌玛哈巴依老爷和{NICKNAME}的共同作品。"
                        },
                        {
                            "id": "690680415",
                            "speaker": "多莉",
                            "text": "你得拿出足够的干劲才行。"
                        },
                        {
                            "id": "690680416",
                            "speaker": "多莉",
                            "text": "制作工具和金灿灿的材料，我前几天已经都准备好了。总之这次我出钱，你出力！",
                            "choices": [
                                {
                                    "id": "690680417",
                                    "text": "多莉…出钱？",
                                    "response": [
                                        {
                                            "id": "690680419",
                                            "speaker": "多莉",
                                            "text": "哼，少啰嗦少啰嗦。"
                                        },
                                        {
                                            "id": "690680420",
                                            "speaker": "多莉",
                                            "text": "等你准备好了，就来和我说吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690680418",
                                    "text": "我没有听错吧？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690680410",
                    "text": "那…金灿灿的摩拉雕塑？",
                    "response": [
                        {
                            "id": "690680411",
                            "speaker": "多莉",
                            "text": "哎呀哎呀，跟了我这么长时间，小跟班的品味也变好了不少嘛！"
                        },
                        {
                            "id": "690680412",
                            "speaker": "多莉",
                            "text": "没错，就是摩拉雕塑！"
                        }
                    ]
                }
            ]
        }
    ]
}