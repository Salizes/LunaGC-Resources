{
    "talkId": "6905810",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 9,
        "八重神子": 20
    },
    "dialogues": [
        {
            "id": "690580301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690580302",
            "speaker": "八重神子",
            "text": "哦？突然想找我聊天，莫非是感觉寂寞了？"
        },
        {
            "id": "690580303",
            "speaker": "八重神子",
            "text": "正好我今天心情不错，给你讲一个很久以前的故事吧。",
            "choices": [
                {
                    "id": "690580304",
                    "text": "真让人期待。",
                    "response": [
                        {
                            "id": "690580306",
                            "speaker": "八重神子",
                            "text": "很久以前的某一天，神社里忽然来了一个小孩。"
                        },
                        {
                            "id": "690580307",
                            "speaker": "八重神子",
                            "text": "她抱着一只奄奄一息的狐狸，跪在狐斋宫的身前，请求狐斋宫救救她的这位朋友。"
                        },
                        {
                            "id": "690580308",
                            "speaker": "八重神子",
                            "text": "据她所说，这只狐狸被她某次投喂了油豆腐之后，就经常出现在村子里。"
                        },
                        {
                            "id": "690580309",
                            "speaker": "八重神子",
                            "text": "但好景不长，卸下防备的狐狸被村里的恶犬咬伤，生命垂危。小孩又伤心又自责，于是便来了神社。"
                        },
                        {
                            "id": "690580310",
                            "speaker": "八重神子",
                            "text": "狐斋宫答应了她的请求，帮她治疗那只小狐狸。同时担心她会寂寞，就让同为狐狸的我去陪一陪她。"
                        },
                        {
                            "id": "690580311",
                            "speaker": "Player",
                            "text": "然后呢？"
                        },
                        {
                            "id": "690580312",
                            "speaker": "八重神子",
                            "text": "然后嘛…像我这样美丽的狐狸，和她相处没多久，就把她迷得神魂颠倒。"
                        },
                        {
                            "id": "690580313",
                            "speaker": "八重神子",
                            "text": "不但给我买来了各种好吃的点心，更是一整天都腻在我的身旁，连睡觉都不肯离远一点。"
                        },
                        {
                            "id": "690580314",
                            "speaker": "八重神子",
                            "text": "两天后她的小狐狸痊愈，我跟她一起来到了神社。狐斋宫就问她，你喜欢自己的小狐狸，还是新的小狐狸呀？"
                        },
                        {
                            "id": "690580315",
                            "speaker": "八重神子",
                            "text": "她看看我，又看看自己的那位朋友，眼神中充满了苦恼。"
                        },
                        {
                            "id": "690580316",
                            "speaker": "Player",
                            "text": "确实很难抉择…"
                        },
                        {
                            "id": "690580317",
                            "speaker": "八重神子",
                            "text": "不过最后，当她的小狐狸跑到她面前，朝她呜呜叫了两声时，她还是放下了怀里的我。"
                        },
                        {
                            "id": "690580318",
                            "speaker": "八重神子",
                            "text": "「虽然巫女大人的狐狸很好看，但我还是更喜欢我的老朋友呢！」"
                        },
                        {
                            "id": "690580319",
                            "speaker": "八重神子",
                            "text": "最后那孩子奉上油豆腐，来感谢我的陪伴，然后带着自己的小狐狸离开了。",
                            "choices": [
                                {
                                    "id": "690580320",
                                    "text": "真是个好故事。",
                                    "response": [
                                        {
                                            "id": "690580322",
                                            "speaker": "八重神子",
                                            "text": "等等，小家伙，你不会打算就这么离开吧？"
                                        },
                                        {
                                            "id": "690580323",
                                            "speaker": "八重神子",
                                            "text": "世事都讲究一个互利互惠，听了我的故事，你是不是也应该有所表示呢？",
                                            "choices": [
                                                {
                                                    "id": "690580324",
                                                    "text": "那我也讲讲我的故事…",
                                                    "response": [
                                                        {
                                                            "id": "690580325",
                                                            "speaker": "八重神子",
                                                            "text": "嗯，这还差不多。"
                                                        },
                                                        {
                                                            "id": "690580326",
                                                            "speaker": "八重神子",
                                                            "text": "可要讲得有趣一些哦？最好是那种写出来放到八重堂，能够拿到销量冠军的程度。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "690580327",
                                                    "text": "我现在就去买油豆腐…",
                                                    "response": [
                                                        {
                                                            "id": "690580328",
                                                            "speaker": "八重神子",
                                                            "text": "很上道嘛。"
                                                        },
                                                        {
                                                            "id": "690580329",
                                                            "speaker": "八重神子",
                                                            "text": "那我就在这里等你了，快去快回。等你回来，我可以再给你讲讲别的故事。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "690580321",
                                    "text": "谢谢你的故事…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690580305",
                    "text": "我想听！"
                }
            ]
        }
    ]
}