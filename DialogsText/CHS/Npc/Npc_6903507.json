{
    "talkId": "6903507",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "七七": 14
    },
    "dialogues": [
        {
            "id": "690350701",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690350301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690350302",
            "speaker": "七七",
            "text": "聊天…聊天…"
        },
        {
            "id": "690350303",
            "speaker": "七七",
            "text": "跟你聊天，是一件很舒服的事情。"
        },
        {
            "id": "690350304",
            "speaker": "七七",
            "text": "但是…"
        },
        {
            "id": "690350305",
            "speaker": "Player",
            "text": "怎么了吗？"
        },
        {
            "id": "690350306",
            "speaker": "七七",
            "text": "…会忘记。"
        },
        {
            "id": "690350307",
            "speaker": "七七",
            "text": "聊天的内容，会忘记。"
        },
        {
            "id": "690350308",
            "speaker": "七七",
            "text": "声音的语调，会忘记。"
        },
        {
            "id": "690350309",
            "speaker": "七七",
            "text": "开心的感觉…会忘记…",
            "choices": [
                {
                    "id": "690350310",
                    "text": "只要这一刻的七七是开心的就好。",
                    "response": [
                        {
                            "id": "690350311",
                            "speaker": "七七",
                            "text": "啊…是这样吗。"
                        },
                        {
                            "id": "690350312",
                            "speaker": "七七",
                            "text": "嗯…如果我现在难过的话，你也会难过的。"
                        },
                        {
                            "id": "690350316",
                            "speaker": "七七",
                            "text": "嗯，七七要，笑一个。"
                        },
                        {
                            "id": "690350317",
                            "speaker": "Player",
                            "text": "七七笑起来很可爱。"
                        },
                        {
                            "id": "690350318",
                            "speaker": "七七",
                            "text": "啊…"
                        },
                        {
                            "id": "690350319",
                            "speaker": "七七",
                            "text": "…因为有你，在我身边。"
                        }
                    ]
                },
                {
                    "id": "690350313",
                    "text": "我会天天都来跟七七聊天。",
                    "response": [
                        {
                            "id": "690350314",
                            "speaker": "七七",
                            "text": "天天…都来。"
                        },
                        {
                            "id": "690350315",
                            "speaker": "七七",
                            "text": "那我，天天都会是…开心的？"
                        }
                    ]
                }
            ]
        }
    ]
}