    "dialogues": [
        {
            "id": "749000101",
            "speaker": "Player",
            "text": "形似演出的审判？"
        },
        {
            "id": "749000102",
            "speaker": "维缪尔",
            "text": "只是个比方。因为有水神大人在，审判过程中常常会插入一些像是会出现在戏剧中的说辞。"
        },
        {
            "id": "749000103",
            "speaker": "维缪尔",
            "text": "但审判本身是没有问题的。依靠最高审判官大人和谕示机的公正裁决，每一场审判都会圆满完成。"
        }
    ]
}