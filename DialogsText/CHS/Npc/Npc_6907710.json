{
    "talkId": "6907710",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "瑶瑶": 18
    },
    "dialogues": [
        {
            "id": "690770301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690770302",
            "speaker": "瑶瑶",
            "text": "好呀，我可喜欢聊天啦。"
        },
        {
            "id": "690770303",
            "speaker": "瑶瑶",
            "text": "不管对象是谁，我们总能聊得很开心哦！"
        },
        {
            "id": "690770304",
            "speaker": "Player",
            "text": "比如说呢？"
        },
        {
            "id": "690770305",
            "speaker": "瑶瑶",
            "text": "比如说——鹤！"
        },
        {
            "id": "690770306",
            "speaker": "瑶瑶",
            "text": "之前有一次我在溪边洗萝卜，看到一只特别漂亮的鹤停在我身边。"
        },
        {
            "id": "690770307",
            "speaker": "瑶瑶",
            "text": "羽毛的色彩尤其丰富，让人看见了就很喜欢。"
        },
        {
            "id": "690770308",
            "speaker": "瑶瑶",
            "text": "我打了声招呼，没想到那只鹤居然会说人话！",
            "choices": [
                {
                    "id": "690770309",
                    "text": "难道是理水叠山真君？",
                    "response": [
                        {
                            "id": "690770310",
                            "speaker": "瑶瑶",
                            "text": "嘿嘿，我再给你一些提示吧！"
                        },
                        {
                            "id": "690770311",
                            "speaker": "瑶瑶",
                            "text": "我们俩相谈甚欢，一起吃了我做的凉拌萝卜丝…对方又和我讲了很多身边的趣事。"
                        },
                        {
                            "id": "690770312",
                            "speaker": "瑶瑶",
                            "text": "最后，还说和我一见如故，送了我可爱的「月桂」呢！"
                        },
                        {
                            "id": "690770313",
                            "speaker": "瑶瑶",
                            "text": "你知道吗？月桂是通过机关术运作的！"
                        },
                        {
                            "id": "690770314",
                            "speaker": "Player",
                            "text": "是留云借风真君吗？"
                        },
                        {
                            "id": "690770315",
                            "speaker": "瑶瑶",
                            "text": "哇，恭喜恭喜，被你猜出来啦！"
                        },
                        {
                            "id": "690770322",
                            "speaker": "瑶瑶",
                            "text": "仙法、机关术…又厉害又实用，瑶瑶对留云阿姨非常钦佩。"
                        },
                        {
                            "id": "690770323",
                            "speaker": "瑶瑶",
                            "text": "有机会的话，我们一起去找她聊天吧！"
                        }
                    ]
                },
                {
                    "id": "690770316",
                    "text": "难道是留云借风真君？",
                    "response": [
                        {
                            "id": "690770317",
                            "speaker": "瑶瑶",
                            "text": "哇哇，我还没给提示呢，你怎么一下子就猜出来了！"
                        },
                        {
                            "id": "690770318",
                            "speaker": "瑶瑶",
                            "text": "「才思敏捷」这个词，应该就是用来形容你的吧！恭喜恭喜。"
                        },
                        {
                            "id": "690770319",
                            "speaker": "瑶瑶",
                            "text": "我和留云阿姨相谈甚欢，我们一起吃了我做的凉拌萝卜丝…她又和我讲了很多身边的趣事。"
                        },
                        {
                            "id": "690770320",
                            "speaker": "瑶瑶",
                            "text": "最后，还说和我一见如故，送了我可爱的「月桂」呢！"
                        },
                        {
                            "id": "690770321",
                            "speaker": "瑶瑶",
                            "text": "你知道吗？月桂是通过机关术运作的！"
                        }
                    ]
                }
            ]
        }
    ]
}