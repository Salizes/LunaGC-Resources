    "dialogues": [
        {
            "id": "631550501",
            "speaker": "Player",
            "text": "你的野心呢？"
        },
        {
            "id": "631550502",
            "speaker": "柴门二郎",
            "text": "可别乱说了！你别让我挨老爹骂了…"
        },
        {
            "id": "631550503",
            "speaker": "柴门二郎",
            "text": "不敢有什么奇怪的想法啦…一想到之前的经历就瑟瑟发抖。"
        },
        {
            "id": "631550504",
            "speaker": "柴门二郎",
            "text": "我呀，种种地，挖挖地，说不定事情哪天就有转机了呢？"
        }
    ]
