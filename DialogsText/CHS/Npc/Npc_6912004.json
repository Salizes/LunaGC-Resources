{
    "talkId": "6912004",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "菲林斯": 15
    },
    "dialogues": [
        {
            "id": "691200401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "691200402",
            "speaker": "菲林斯",
            "text": "最近有些思念睡眠。"
        },
        {
            "id": "691200403",
            "speaker": "Player",
            "text": "在这儿睡得不好吗？"
        },
        {
            "id": "691200404",
            "speaker": "菲林斯",
            "text": "哦不，请别误会，我不是这个意思，这里的床铺很柔软，远胜我的需要。"
        },
        {
            "id": "691200405",
            "speaker": "菲林斯",
            "text": "况且，对我这样一个自备居所的人来说，我还从未因为环境不适而产生睡眠不足的问题。"
        },
        {
            "id": "691200406",
            "speaker": "Player",
            "text": "那是…？"
        },
        {
            "id": "691200407",
            "speaker": "菲林斯",
            "text": "我正在怀念过去某个时期，我在绝对的黑暗中独自沉睡。"
        },
        {
            "id": "691200408",
            "speaker": "菲林斯",
            "text": "那种睡眠里既没有梦也没有意识，感受不到欢乐，也感受不到痛苦。"
        },
        {
            "id": "691200409",
            "speaker": "菲林斯",
            "text": "一种很奇妙的状态，绝对的安宁，绝对的空无。"
        },
        {
            "id": "691200410",
            "speaker": "菲林斯",
            "text": "对一般人来说或许很难想象，但我曾经长期浸泡其中。"
        },
        {
            "id": "691200411",
            "speaker": "菲林斯",
            "text": "和这样的睡眠相比，人们每夜所要经历的充满了梦的睡眠就显得过于喧闹了。"
        },
        {
            "id": "691200412",
            "speaker": "Player",
            "text": "你该不会…？"
        },
        {
            "id": "691200413",
            "speaker": "菲林斯",
            "text": "想要重新熄灭自己？当然不会。"
        },
        {
            "id": "691200414",
            "speaker": "菲林斯",
            "text": "思索过去所经历的事情，是为了审视自己此刻的判断和现今所处的位置。"
        },
        {
            "id": "691200415",
            "speaker": "菲林斯",
            "text": "怀念安宁与为了新的目标舍弃安宁，两者并不冲突。"
        },
        {
            "id": "691200416",
            "speaker": "菲林斯",
            "text": "希望这些絮絮叨叨不会使你觉得无聊。",
            "choices": [
                {
                    "id": "691200417",
                    "text": "不会。",
                    "response": [
                        {
                            "id": "691200418",
                            "speaker": "菲林斯",
                            "text": "太好了，能与你分享这些琐碎的思绪，这是我们友谊的证明。"
                        }
                    ]
                },
                {
                    "id": "691200419",
                    "text": "听不太明白。",
                    "response": [
                        {
                            "id": "691200420",
                            "speaker": "菲林斯",
                            "text": "没有关系，任何两个个体之间都有不同，完完全全明白另一个个体的所思所想是很困难的。"
                        },
                        {
                            "id": "691200421",
                            "speaker": "菲林斯",
                            "text": "但正因为我们的思维不同，互相对话才有意义。"
                        }
                    ]
                }
            ]
        }
    ]
}