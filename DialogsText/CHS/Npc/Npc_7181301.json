{
    "talkId": "7181301",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "大坤": 12
    },
    "dialogues": [
        {
            "id": "718130101",
            "speaker": "大坤",
            "text": "这些东西可难找啊…"
        },
        {
            "id": "718130102",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "718130103",
            "speaker": "大坤",
            "text": "哦，是你啊，还记得群玉阁那件事吧？百闻前几天过来了一趟，说重建群玉阁的事情已经提上了日程。"
        },
        {
            "id": "718130104",
            "speaker": "大坤",
            "text": "虽然整体建造的进度不可能那么快，但有些小东西可以预先筹备一下。"
        },
        {
            "id": "718130105",
            "speaker": "大坤",
            "text": "她给了我张清单，让我留意一下里面记着的东西，能搜罗到最好，但也不用特别去跑腿。"
        },
        {
            "id": "718130106",
            "speaker": "大坤",
            "text": "不过说实话，就算我想跑腿我也走不开，总务司里的事一天比一天多，真是不知道为什么…"
        },
        {
            "id": "718130107",
            "speaker": "大坤",
            "text": "如果你有空的话，能帮忙跑一趟就最好了，百闻那边看起来似乎很急的样子…",
            "choices": [
                {
                    "id": "718130108",
                    "text": "交给我了。",
                    "response": [
                        {
                            "id": "718130109",
                            "speaker": "大坤",
                            "text": "那就辛苦你了。"
                        },
                        {
                            "id": "718130113",
                            "speaker": "大坤",
                            "text": "我看看…唔，首先是要一本叫《珠玑宝矿》的书，然后是一些竹制的小摆件。"
                        },
                        {
                            "id": "718130114",
                            "speaker": "大坤",
                            "text": "书你可以去问问纪芳，竹制小摆件的话…我记得「范木堂」的路爷能做。"
                        },
                        {
                            "id": "718130115",
                            "speaker": "大坤",
                            "text": "那就拜托你了，唔…要是群玉阁真能重建起来，那也挺好的…"
                        }
                    ]
                },
                {
                    "id": "718130110",
                    "text": "群玉阁真的要重建了？",
                    "response": [
                        {
                            "id": "718130111",
                            "speaker": "大坤",
                            "text": "听百闻说，应该已经提上日程了。但那么大一个楼，重建应该也需要很长时间吧…"
                        },
                        {
                            "id": "718130112",
                            "speaker": "大坤",
                            "text": "她们现在也只能先筹备点小物件，等到要开始重建的时候，那才真有的忙了…"
                        }
                    ]
                }
            ]
        }
    ]
}