{
    "talkId": "6902309",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "香菱": 8
    },
    "dialogues": [
        {
            "id": "690230901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690230202",
            "speaker": "香菱",
            "text": "嗯，住着很舒服。还有很多新鲜的、有趣的，没见过的东西！"
        },
        {
            "id": "690230203",
            "speaker": "香菱",
            "text": "就可惜食材少了点…",
            "choices": [
                {
                    "id": "690230204",
                    "text": "以香菱的食材标准来看确实如此…",
                    "response": [
                        {
                            "id": "690230206",
                            "speaker": "香菱",
                            "text": "嘿嘿…"
                        },
                        {
                            "id": "690230207",
                            "speaker": "香菱",
                            "text": "但是…你也不用担心哦！"
                        },
                        {
                            "id": "690230208",
                            "speaker": "香菱",
                            "text": "食材之间通过相互搭配能够实现味觉的千变万化。"
                        },
                        {
                            "id": "690230209",
                            "speaker": "香菱",
                            "text": "不断地进行组合和调整，我有很多创意可以试！"
                        },
                        {
                            "id": "690230210",
                            "speaker": "香菱",
                            "text": "嗯…要是你能来点评点评就更好了！"
                        },
                        {
                            "id": "690230211",
                            "speaker": "Player",
                            "text": "包在我身上。"
                        },
                        {
                            "id": "690230212",
                            "speaker": "香菱",
                            "text": "哇！真的吗。那我现在就去开工！"
                        }
                    ]
                },
                {
                    "id": "690230205",
                    "text": "我会再想想办法的。"
                }
            ]
        }
    ]
}