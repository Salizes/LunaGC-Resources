    "dialogues": [
        {
            "id": "766774101",
            "speaker": "温弗里德",
            "text": "冤枉啊！我喝的不是最多…"
        },
        {
            "id": "766774102",
            "speaker": "法尔伽",
            "text": "——那也是喝醉了对吧？二十圈，一个都别落！直到练出喝了酒也不误事的气势来！"
        },
        {
            "id": "766774103",
            "speaker": "艾克贝特",
            "text": "呼…这下算是…"
        },
        {
            "id": "766774104",
            "speaker": "莱夫赫姆",
            "text": "…逃过一劫吗？"
        },
        {
            "id": "766774105",
            "speaker": "法尔伽",
            "text": "哦，你们两个，是不是在想「这下算是逃过一劫了」？刚刚看你们也醉得不轻啊？"
        },
        {
            "id": "766774106",
            "speaker": "法尔伽",
            "text": "去安塞姆那里领二十组力量训练，做完之前不许碰酒！"
        }
    ]
}