    "dialogues": [
        {
            "id": "652300301",
            "speaker": "Player",
            "text": "你的生意怎么样？"
        },
        {
            "id": "652300302",
            "speaker": "「狡诈泡泡桔」",
            "text": "嘘…小点声，我还在摸这个地方的底呢。"
        },
        {
            "id": "652300303",
            "speaker": "「狡诈泡泡桔」",
            "text": "这里的人买杂货什么的，好像只会去那个叫「破烂骨头商店」的地方，我现在不能高调地把货全铺开，不然被人盯上可不好。"
        },
        {
            "id": "652300304",
            "speaker": "「狡诈泡泡桔」",
            "text": "特别是那个埃尔瓦德…"
        }
    ]
}