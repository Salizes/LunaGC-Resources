{
    "talkId": "7066003",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 11,
        "吉盖克斯": 18
    },
    "dialogues": [
        {
            "id": "706600301",
            "speaker": "吉盖克斯",
            "text": "你好，想试试「风行迷踪」吗？",
            "choices": [
                {
                    "id": "706600302",
                    "text": "游玩「风行迷踪」。"
                },
                {
                    "id": "706600318",
                    "text": "关于「风行迷踪」的情况…",
                    "response": [
                        {
                            "id": "706600319",
                            "speaker": "吉盖克斯",
                            "text": "我之前就招募过一次试玩「风行迷踪」的人，那些人里有几个技术很出众，让我印象很深。"
                        },
                        {
                            "id": "706600320",
                            "speaker": "吉盖克斯",
                            "text": "但除了他们之外，还是有不少人和我说这个游戏很难，要么游侠很难跑掉，要么猎手找不到人。"
                        },
                        {
                            "id": "706600321",
                            "speaker": "吉盖克斯",
                            "text": "还有人向我抱怨，如果想要玩好这游戏，就必须熟悉每张图的每个细节，实在是太麻烦了，希望我简化游戏的玩法。"
                        },
                        {
                            "id": "706600322",
                            "speaker": "吉盖克斯",
                            "text": "唉，我也不知道他们说的对不对，所以我就想再招募一批人来试玩，听听他们的意见。"
                        },
                        {
                            "id": "706600323",
                            "speaker": "吉盖克斯",
                            "text": "如果您有兴趣的话，就请您也来试玩一下吧。",
                            "choices": [
                                {
                                    "id": "706600302",
                                    "text": "游玩「风行迷踪」。"
                                },
                                {
                                    "id": "706600303",
                                    "text": "「风行迷踪」是什么？",
                                    "response": [
                                        {
                                            "id": "706600304",
                                            "speaker": "吉盖克斯",
                                            "text": "啊哈，问得好，「风行迷踪」是一款承载着蒙德城历史的游戏！"
                                        },
                                        {
                                            "id": "706600305",
                                            "speaker": "吉盖克斯",
                                            "text": "你应该知道，在之前的蒙德城里有一群「贵族」吧？"
                                        },
                                        {
                                            "id": "706600306",
                                            "speaker": "吉盖克斯",
                                            "text": "他们在蒙德城里暴行不断，让不少人都苦不堪言…"
                                        },
                                        {
                                            "id": "706600307",
                                            "speaker": "吉盖克斯",
                                            "text": "为了反抗贵族们的种种暴行，有一群勇敢的蒙德人聚集了起来，形成了一个秘密的反抗组织。"
                                        },
                                        {
                                            "id": "706600308",
                                            "speaker": "吉盖克斯",
                                            "text": "这群游侠们不断在蒙德各处展开行动，让贵族们颇吃了些苦头。"
                                        },
                                        {
                                            "id": "706600309",
                                            "speaker": "吉盖克斯",
                                            "text": "但是，那些贵族们也很快训练出了一群用来镇压游侠们的爪牙。"
                                        },
                                        {
                                            "id": "706600310",
                                            "speaker": "吉盖克斯",
                                            "text": "于是，游侠们和贵族们的爪牙们，就这样在蒙德各处展开了一场又一场的对决。"
                                        },
                                        {
                                            "id": "706600311",
                                            "speaker": "吉盖克斯",
                                            "text": "「风行迷踪」，正是取材于这样史诗一般的真实历史事件！曾经也是很受欢迎的…"
                                        },
                                        {
                                            "id": "706600312",
                                            "speaker": "Player",
                                            "text": "曾经？"
                                        },
                                        {
                                            "id": "706600313",
                                            "speaker": "吉盖克斯",
                                            "text": "是啊，现在城里的年轻人们对于「风行迷踪」可没多少兴趣了…"
                                        },
                                        {
                                            "id": "706600314",
                                            "speaker": "吉盖克斯",
                                            "text": "但我可不想让「风行迷踪」就此失传，所以，我对它原来的规则做了些调整，让游戏规则更容易被理解，也更有趣。"
                                        },
                                        {
                                            "id": "706600315",
                                            "speaker": "吉盖克斯",
                                            "text": "除此之外，我还特意添加了好几张全新的游戏地图。我觉得，这样应该会有更多的人来玩吧…",
                                            "choices": [
                                                {
                                                    "id": "706600302",
                                                    "text": "游玩「风行迷踪」。"
                                                },
                                                {
                                                    "id": "706600318",
                                                    "text": "关于「风行迷踪」的情况…"
                                                },
                                                {
                                                    "id": "706600316",
                                                    "text": "离开。",
                                                    "response": [
                                                        {
                                                            "id": "706600317",
                                                            "speaker": "吉盖克斯",
                                                            "text": "好吧，如果有兴趣试玩「风行迷踪」的话，就过来找我吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "706600316",
                                    "text": "离开。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706600303",
                    "text": "「风行迷踪」是什么？"
                },
                {
                    "id": "706600316",
                    "text": "离开。"
                }
            ]
        }
    ]
}