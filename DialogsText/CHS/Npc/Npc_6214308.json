    "dialogues": [
        {
            "id": "621430801",
            "speaker": "Player",
            "text": "我只是路过。"
        },
        {
            "id": "621430802",
            "speaker": "百闻",
            "text": "这样吗？那还真是有趣…"
        },
        {
            "id": "621430803",
            "speaker": "百闻",
            "text": "毕竟这是你参与重建的群玉阁，你来到这里，不会仅仅是抱着观光游乐的目的吧？"
        },
        {
            "id": "621430804",
            "speaker": "百闻",
            "text": "按照以往的情报显示，任何人来到群玉阁都是心有所图的，这一点还未曾有过例外。"
        },
        {
            "id": "621430805",
            "speaker": "百闻",
            "text": "我身为为凝光大人收集和整理情报的秘书，无论任何人的信息都要掌握在手中，哪怕是身为贵客的你也一样。"
        }
    ]
}