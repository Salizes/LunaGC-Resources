{
    "talkId": "7165817",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "钟离": 12
    },
    "dialogues": [
        {
            "id": "716581701",
            "speaker": "钟离",
            "text": "身处云上，远望月落日升，时间也变得模糊了。"
        },
        {
            "id": "716581702",
            "speaker": "Player",
            "text": "记得这里是留云借风真君…"
        },
        {
            "id": "716581703",
            "speaker": "钟离",
            "text": "正是。"
        },
        {
            "id": "716581704",
            "speaker": "钟离",
            "text": "你应该见过她好几次，对吗？"
        },
        {
            "id": "716581705",
            "speaker": "Player",
            "text": "是位妙人。"
        },
        {
            "id": "716581706",
            "speaker": "钟离",
            "text": "你见多识广，性格良善，自然能和她友好相处。"
        },
        {
            "id": "716581707",
            "speaker": "钟离",
            "text": "留云借风真君是机关术专家，也可说是一位发明家。"
        },
        {
            "id": "716581708",
            "speaker": "钟离",
            "text": "她心性仁厚温良，为人耿直真诚，是位不可多得的良师益友。"
        },
        {
            "id": "716581709",
            "speaker": "钟离",
            "text": "我有位旧友曾说过，若是想知道些家长里短，与其寻街问巷三天三夜，不如找留云借风聊上一个时辰。"
        },
        {
            "id": "716581710",
            "speaker": "钟离",
            "text": "旅行者，你觉得呢？",
            "choices": [
                {
                    "id": "716581711",
                    "text": "完全正确。",
                    "response": [
                        {
                            "id": "716581713",
                            "speaker": "钟离",
                            "text": "哈哈，留云借风真君心直口快，不是坏事。她嘴上说着不近凡尘，实际却很爱护人类。"
                        },
                        {
                            "id": "716581714",
                            "speaker": "钟离",
                            "text": "呼…看了这么久的山景，也该换个地方了。"
                        },
                        {
                            "id": "716581715",
                            "speaker": "钟离",
                            "text": "明天…或许可以再往北边走走。"
                        },
                        {
                            "id": "716581716",
                            "speaker": "钟离",
                            "text": "除了璃月港，轻策庄里也有不少住民。去看看吧。"
                        }
                    ]
                },
                {
                    "id": "716581712",
                    "text": "不是没有道理。"
                }
            ]
        }
    ]
}