{
    "talkId": "7212704",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 4,
        "叶名山薰": 19
    },
    "dialogues": [
        {
            "id": "721270401",
            "speaker": "叶名山薰",
            "text": "您好，今天的花开得也很漂亮喔。",
            "choices": [
                {
                    "id": "721270402",
                    "text": "你还在种花吗？",
                    "response": [
                        {
                            "id": "721270403",
                            "speaker": "叶名山薰",
                            "text": "那当然啦，我还想要去找更多的花种，种出更多其他的花呢。"
                        },
                        {
                            "id": "721270404",
                            "speaker": "叶名山薰",
                            "text": "对了，你认识一个叫泽维尔的人吗？"
                        },
                        {
                            "id": "721270405",
                            "speaker": "叶名山薰",
                            "text": "那个人真奇怪，看见了我种的那么多花之后，突然很激动地冲过来，问我能不能允许他在那里…什么来着？好像是「取景」？"
                        },
                        {
                            "id": "721270406",
                            "speaker": "叶名山薰",
                            "text": "他旁边还跟着一个看起来像是幕府军人一样的人，我有点害怕，就问他到底想要做什么…"
                        },
                        {
                            "id": "721270407",
                            "speaker": "叶名山薰",
                            "text": "然后他说，他想要让那位幕府军人在花海上挥刀…什么的，还说要制作一部「剑阵片」。"
                        },
                        {
                            "id": "721270408",
                            "speaker": "叶名山薰",
                            "text": "但我才不想让他踩坏那些花呢，就拒绝了他，真是个奇怪的人…"
                        }
                    ]
                },
                {
                    "id": "721270409",
                    "text": "种花顺利吗？",
                    "response": [
                        {
                            "id": "721270410",
                            "speaker": "叶名山薰",
                            "text": "算是顺利吧，但总感觉缺点什么，不知道是不是因为之前「御影炉心」的事，感觉周围的花开得没有原来那么盛了。"
                        },
                        {
                            "id": "721270411",
                            "speaker": "叶名山薰",
                            "text": "唉，「御影炉心」果然还是对周围的土地造成影响了吧…"
                        },
                        {
                            "id": "721270412",
                            "speaker": "叶名山薰",
                            "text": "虽然我听说，离岛那边有一个叫瓦希德的人正在卖特色化肥，还说什么…是有须弥特色的特色化肥。"
                        },
                        {
                            "id": "721270413",
                            "speaker": "叶名山薰",
                            "text": "我对那些化肥有点兴趣，所以就托人去打听了打听。"
                        },
                        {
                            "id": "721270414",
                            "speaker": "叶名山薰",
                            "text": "但我听人说，那个店主…瓦希德介绍化肥的时候，总是在重复那几句话，问他化肥的各种细节时，他也答不上来。"
                        },
                        {
                            "id": "721270415",
                            "speaker": "叶名山薰",
                            "text": "怎么说呢…我总感觉那个店主很不靠谱…"
                        }
                    ]
                },
                {
                    "id": "721270416",
                    "text": "要注意安全。",
                    "response": [
                        {
                            "id": "721270417",
                            "speaker": "叶名山薰",
                            "text": "没关系，周围也没有什么魔物。"
                        },
                        {
                            "id": "721270418",
                            "speaker": "叶名山薰",
                            "text": "不过…虽然没有魔物，但我在去外面采花种的时候，偶然发现了一个奇怪的人。"
                        },
                        {
                            "id": "721270419",
                            "speaker": "叶名山薰",
                            "text": "他只是坐在那里发呆，什么也不做，手里还拿着一把剑，嘴里不知道在念叨着什么…"
                        },
                        {
                            "id": "721270420",
                            "speaker": "叶名山薰",
                            "text": "因为有点害怕，我就远远地看了一眼就走了。"
                        },
                        {
                            "id": "721270421",
                            "speaker": "叶名山薰",
                            "text": "不知道那个人现在是不是还呆在那里，不过，我总感觉那个人很危险，还是离远点比较好…"
                        }
                    ]
                },
                {
                    "id": "721270422",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "721270423",
                            "speaker": "叶名山薰",
                            "text": "嗯，再见。有空的话，记得来看看花呀。"
                        }
                    ]
                }
            ]
        }
    ]
}