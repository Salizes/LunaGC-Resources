        "帕卡·努伊": 4
    },
    "dialogues": [
        {
            "id": "660780401",
            "speaker": "Player",
            "text": "算是拓展业务吗？"
        },
        {
            "id": "660780402",
            "speaker": "帕卡·努伊",
            "text": "对，这位朋友很懂嘛。"
        },
        {
            "id": "660780403",
            "speaker": "帕卡·努伊",
            "text": "我认识一些很喜欢音乐的朋友，有回声之子的唱片匠人，也有烟谜主的涂鸦艺术家。"
        },
        {
            "id": "660780404",
            "speaker": "帕卡·努伊",
            "text": "如此一来，不仅是出唱片，就连包装、宣传海报之类的业务我也可以帮忙安排。"
        },
        {
            "id": "660780405",
            "speaker": "帕卡·努伊",
            "text": "非常全面、贴心的一条龙服务，对吧？"
        }
    ]
}