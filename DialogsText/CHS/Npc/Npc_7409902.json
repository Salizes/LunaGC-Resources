{
    "talkId": "7409902",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 2,
        "德拉萝诗的笔记": 20
    },
    "dialogues": [
        {
            "id": "740990201",
            "speaker": "德拉萝诗的笔记",
            "text": "（看起来似乎是德拉萝诗调制鱼饵配方的记录…）",
            "choices": [
                {
                    "id": "740990202",
                    "text": "阅读。",
                    "response": [
                        {
                            "id": "740990203",
                            "speaker": "德拉萝诗的笔记",
                            "text": "担任理事第六百三十四天，遇见「鱼斗胜利之神」后的第七十五次配方实验。"
                        },
                        {
                            "id": "740990204",
                            "speaker": "德拉萝诗的笔记",
                            "text": "分析鱼饵样本的尝试失败了，娴熟的炼金合成法让许多原材料的物质无迹可寻，所以继续尝试自己的组合。"
                        },
                        {
                            "id": "740990205",
                            "speaker": "德拉萝诗的笔记",
                            "text": "使用果酒湖水灌溉的蒙德进口日落果果肉，搭配史莱姆凝液，各一份标准用量…"
                        },
                        {
                            "id": "740990206",
                            "speaker": "德拉萝诗的笔记",
                            "text": "结果很不乐观，鱼根本都没有转头。好歹有东西掉进水里的时候，它们都会逃开啊！"
                        },
                        {
                            "id": "740990207",
                            "speaker": "德拉萝诗的笔记",
                            "text": "那个旅行商人卖的日落果好贵，两天饭钱又砸进去了，以后千万不要再买他的货了…"
                        },
                        {
                            "id": "740990208",
                            "speaker": "德拉萝诗的笔记",
                            "text": "……"
                        },
                        {
                            "id": "740990209",
                            "speaker": "德拉萝诗的笔记",
                            "text": "担任理事第六百三十五天，遇见「鱼斗胜利之神」后的第八十一次配方实验。"
                        },
                        {
                            "id": "740990210",
                            "speaker": "德拉萝诗的笔记",
                            "text": "分析鱼饵样本的尝试还是徒劳，所以继续尝试自己的组合。"
                        },
                        {
                            "id": "740990211",
                            "speaker": "德拉萝诗的笔记",
                            "text": "使用冰块保存完好的稻妻进口绯樱花瓣，搭配捣碎的鱼肉，希望以此能吸引一些肉食性的凶猛鱼类…"
                        },
                        {
                            "id": "740990212",
                            "speaker": "德拉萝诗的笔记",
                            "text": "但鱼斗士们好像对吃肉没有兴趣，完全不理会我的挑衅…"
                        },
                        {
                            "id": "740990213",
                            "speaker": "德拉萝诗的笔记",
                            "text": "可恶！至少朝我挥动一下尾巴，表示自己看到了嘛！"
                        },
                        {
                            "id": "740990214",
                            "speaker": "德拉萝诗的笔记",
                            "text": "……"
                        },
                        {
                            "id": "740990215",
                            "speaker": "德拉萝诗的笔记",
                            "text": "担任理事第六百三十六天，遇见「鱼斗胜利之神」后的第九十次配方实验。"
                        },
                        {
                            "id": "740990216",
                            "speaker": "德拉萝诗的笔记",
                            "text": "研究员们都建议我放弃分析鱼饵样本，或者去请专业的炼金术士，不过我没有那种人脉啦…所以继续尝试自己的组合。"
                        },
                        {
                            "id": "740990217",
                            "speaker": "德拉萝诗的笔记",
                            "text": "使用晒干后的进口须弥香辛果粉末，搭配本季最新鲜的泡泡桔果汁，蒸煮再蒸煮，浓缩再浓缩！"
                        },
                        {
                            "id": "740990218",
                            "speaker": "德拉萝诗的笔记",
                            "text": "简直是我能想到的…气味最强烈的组合了！"
                        },
                        {
                            "id": "740990219",
                            "speaker": "德拉萝诗的笔记",
                            "text": "类比一下，简直就像…在别人家门口架起大锅，炖煮发酵五年后的鱼肉和白萝卜泥一样，会让邻居冲出来把我狠狠打一顿！"
                        },
                        {
                            "id": "740990220",
                            "speaker": "德拉萝诗的笔记",
                            "text": "可是这些鱼斗士的味觉好像失灵了，完全没有反应…"
                        },
                        {
                            "id": "740990221",
                            "speaker": "德拉萝诗的笔记",
                            "text": "难道是我宣战的力度还不够强吗？那我必须拜托奇货商人…去寻找世界上气味最强烈的东西，给鱼斗士们一个…下水威！"
                        }
                    ]
                },
                {
                    "id": "740990222",
                    "text": "离去。"
                }
            ]
        }
    ]
}