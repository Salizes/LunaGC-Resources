{
    "talkId": "6904109",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "莫娜": 9
    },
    "dialogues": [
        {
            "id": "690410901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690410202",
            "speaker": "莫娜",
            "text": "当然！条件和设施都是一流的，我住得很舒服。"
        },
        {
            "id": "690410203",
            "speaker": "莫娜",
            "text": "甚至…住得太舒服了，有点担心回去之后反而会产生落差…",
            "choices": [
                {
                    "id": "690410204",
                    "text": "那莫娜要不要早点回去？",
                    "response": [
                        {
                            "id": "690410205",
                            "speaker": "莫娜",
                            "text": "欸，欸？不要啊——你是认真的吗？"
                        },
                        {
                            "id": "690410210",
                            "speaker": "莫娜",
                            "text": "呃！"
                        },
                        {
                            "id": "690410211",
                            "speaker": "莫娜",
                            "text": "可、可恶！看在你让我白住的份上，我就不跟你斤斤计较了。"
                        },
                        {
                            "id": "690410212",
                            "speaker": "莫娜",
                            "text": "那…之后我也想想办法，随便给你提供点好处吧。"
                        },
                        {
                            "id": "690410213",
                            "speaker": "莫娜",
                            "text": "这样我们就两不相欠了。"
                        }
                    ]
                },
                {
                    "id": "690410206",
                    "text": "莫娜可以一直住在这边。",
                    "response": [
                        {
                            "id": "690410207",
                            "speaker": "莫娜",
                            "text": "真，真的吗？"
                        },
                        {
                            "id": "690410208",
                            "speaker": "莫娜",
                            "text": "那么好的地方，不用付房租，还可以一直住下去…我是在做梦吗？"
                        }
                    ]
                },
                {
                    "id": "690410209",
                    "text": "「伟大占星术士」的高傲感不见了…"
                }
            ]
        }
    ]
}