    "dialogues": [
        {
            "id": "670150401",
            "speaker": "Player",
            "text": "你是璃月人？"
        },
        {
            "id": "670150402",
            "speaker": "采若",
            "text": "是呀，我是从璃月港来的！俗话说「八方四路，为商为贾」，这地方既然有商机，那自然少不了我们啦。"
        },
        {
            "id": "670150403",
            "speaker": "采若",
            "text": "更何况，多走走看看，了解不同地方的风土人情，对生意总是有帮助的嘛。"
        }
    ]
}