{
    "talkId": "6903708",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 6,
        "甘雨": 12
    },
    "dialogues": [
        {
            "id": "690370801",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690370402",
            "speaker": "甘雨",
            "text": "我想和你一起种花。或者是…别的植物，比如蔬菜…",
            "choices": [
                {
                    "id": "690370403",
                    "text": "甘雨很擅长园艺吧。",
                    "response": [
                        {
                            "id": "690370404",
                            "speaker": "甘雨",
                            "text": "是，是的…可以说是除了工作以外最大的兴趣爱好。"
                        },
                        {
                            "id": "690370405",
                            "speaker": "甘雨",
                            "text": "此前我会担心自己难以控制食欲，把种出来的菜都吃完…"
                        },
                        {
                            "id": "690370408",
                            "speaker": "甘雨",
                            "text": "但如果是和你一起种出来的蔬菜，我一定能控制好自己！"
                        },
                        {
                            "id": "690370409",
                            "speaker": "Player",
                            "text": "其实吃完也没什么关系。"
                        },
                        {
                            "id": "690370410",
                            "speaker": "甘雨",
                            "text": "不行！不行的…"
                        },
                        {
                            "id": "690370411",
                            "speaker": "甘雨",
                            "text": "会变胖的…"
                        },
                        {
                            "id": "690370412",
                            "speaker": "甘雨",
                            "text": "变胖的话…我的分量…我是说，代表你心中意义的那个分量…",
                            "choices": [
                                {
                                    "id": "690370413",
                                    "text": "也不会改变的。",
                                    "response": [
                                        {
                                            "id": "690370414",
                                            "speaker": "甘雨",
                                            "text": "唔！"
                                        },
                                        {
                                            "id": "690370415",
                                            "speaker": "甘雨",
                                            "text": "还，还是和你一起吃吧。一起种，一起吃…"
                                        },
                                        {
                                            "id": "690370418",
                                            "speaker": "甘雨",
                                            "text": "嗯！我现在就去…寻找最合适的种子。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690370416",
                                    "text": "那我和你一起吃吧。",
                                    "response": [
                                        {
                                            "id": "690370417",
                                            "speaker": "甘雨",
                                            "text": "你的意思是…一起种，一起吃？"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690370406",
                    "text": "之前好像从来没看到过甘雨种蔬菜。",
                    "response": [
                        {
                            "id": "690370407",
                            "speaker": "甘雨",
                            "text": "因为…会担心自己难以控制食欲，把种出来的菜都吃完…"
                        }
                    ]
                }
            ]
        }
    ]
}