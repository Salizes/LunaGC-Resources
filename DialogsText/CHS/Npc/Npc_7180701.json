{
    "talkId": "7180701",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "畅畅": 12
    },
    "dialogues": [
        {
            "id": "718070101",
            "speaker": "畅畅",
            "text": "哎呀…这样怎么喂它呀…"
        },
        {
            "id": "718070102",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "718070103",
            "speaker": "畅畅",
            "text": "畅畅正在想怎么去喂认识的那只小狗呢。"
        },
        {
            "id": "718070104",
            "speaker": "畅畅",
            "text": "之前爷爷说城里太乱，怎么样都不带畅畅去喂它。"
        },
        {
            "id": "718070105",
            "speaker": "畅畅",
            "text": "虽然最近爷爷说城里没事了，但他还有很多事要忙，没空带畅畅去…"
        },
        {
            "id": "718070106",
            "speaker": "畅畅",
            "text": "都这么久没喂它了，它不会饿坏了吧…虽然爷爷说小狗会自己找吃的，但畅畅还是很担心…"
        },
        {
            "id": "718070107",
            "speaker": "畅畅",
            "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，你能帮畅畅去城门口附近喂喂它吗？",
            "choices": [
                {
                    "id": "718070108",
                    "text": "我知道了。",
                    "response": [
                        {
                            "id": "718070109",
                            "speaker": "畅畅",
                            "text": "#那就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。"
                        },
                        {
                            "id": "718070113",
                            "speaker": "Player",
                            "text": "喂什么呢？"
                        },
                        {
                            "id": "718070114",
                            "speaker": "畅畅",
                            "text": "平时都是爷爷准备好喂它的东西，好像用的是禽肉，还是什么的…"
                        },
                        {
                            "id": "718070115",
                            "speaker": "畅畅",
                            "text": "#唔…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，那就请你找一份禽肉去喂它吧。"
                        },
                        {
                            "id": "718070116",
                            "speaker": "畅畅",
                            "text": "请快一点呀，说不定它都要饿坏了…"
                        }
                    ]
                },
                {
                    "id": "718070110",
                    "text": "我有点怕狗…",
                    "response": [
                        {
                            "id": "718070111",
                            "speaker": "畅畅",
                            "text": "别担心，它很好的，绝对不会咬人。"
                        },
                        {
                            "id": "718070112",
                            "speaker": "畅畅",
                            "text": "#那就拜托{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}啦。"
                        }
                    ]
                }
            ]
        }
    ]
}