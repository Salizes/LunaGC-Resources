    "dialogues": [
        {
            "id": "690780801",
            "speaker": "艾尔海森",
            "text": "本该拿来阅读的书籍，实际上在许多人家中起着其他作用。"
        },
        {
            "id": "690780802",
            "speaker": "艾尔海森",
            "text": "——装饰。"
        },
        {
            "id": "690780803",
            "speaker": "艾尔海森",
            "text": "有些人缺的不是读书的头脑，而是耐心。"
        }
    ]
