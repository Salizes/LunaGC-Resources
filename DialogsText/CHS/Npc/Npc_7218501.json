{
    "talkId": "7218501",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 3,
        "木南杏奈": 15
    },
    "dialogues": [
        {
            "id": "721850101",
            "speaker": "木南杏奈",
            "text": "唉，这可怎么办呢…"
        },
        {
            "id": "721850102",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "721850103",
            "speaker": "木南杏奈",
            "text": "旅行者？太好了，你来得正好！"
        },
        {
            "id": "721850104",
            "speaker": "木南杏奈",
            "text": "你还记得上次，你和神里小姐来我店里的时候，你写给我的那道食谱吗？"
        },
        {
            "id": "721850105",
            "speaker": "木南杏奈",
            "text": "哎呀，那道披萨可受欢迎了，好多客人都专门来店里点那道披萨吃呢。"
        },
        {
            "id": "721850106",
            "speaker": "木南杏奈",
            "text": "但是…有些客人也说，总是吃这一种披萨感觉有点腻了，问我有没有其他味道的披萨。"
        },
        {
            "id": "721850107",
            "speaker": "木南杏奈",
            "text": "虽然我自己也根据客人们的反馈尝试过几种新做法…"
        },
        {
            "id": "721850108",
            "speaker": "木南杏奈",
            "text": "但总觉得…差那么点味道，客人们的反响也不太好。"
        },
        {
            "id": "721850109",
            "speaker": "木南杏奈",
            "text": "唉，也许我真的不太会做「披萨」这种菜吧…"
        },
        {
            "id": "721850110",
            "speaker": "木南杏奈",
            "text": "旅行者，你应该很懂这种菜吧？你能帮我再拿拿主意吗？",
            "choices": [
                {
                    "id": "721850111",
                    "text": "没问题。",
                    "response": [
                        {
                            "id": "721850112",
                            "speaker": "木南杏奈",
                            "text": "太好了！对了，我也搜集了客人们的反馈，我找一下，你稍等。"
                        },
                        {
                            "id": "721850116",
                            "speaker": "木南杏奈",
                            "text": "这位松本小姐说，虽然我店里的这道披萨融合了很多稻妻的食材，但她听说，蒙德的披萨不是这么做的。"
                        },
                        {
                            "id": "721850117",
                            "speaker": "木南杏奈",
                            "text": "她说，这种异国的食物，最好还是保持着异国的特色比较好…"
                        },
                        {
                            "id": "721850118",
                            "speaker": "木南杏奈",
                            "text": "唉，但我怎么知道蒙德的披萨做法呢…旅行者，你就先去问问她吧。"
                        }
                    ]
                },
                {
                    "id": "721850113",
                    "text": "关于客人的反馈…",
                    "response": [
                        {
                            "id": "721850114",
                            "speaker": "木南杏奈",
                            "text": "你想看看客人们的反馈吗？"
                        },
                        {
                            "id": "721850115",
                            "speaker": "木南杏奈",
                            "text": "我找一下，你稍等。"
                        }
                    ]
                }
            ]
        }
    ]
}