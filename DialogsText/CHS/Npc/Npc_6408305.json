{
    "talkId": "6408305",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "海娜": 4,
        "齐里亚布": 5
    },
    "dialogues": [
        {
            "id": "640830501",
            "speaker": "齐里亚布",
            "text": "咳咳…「晚风如歌，为我诉说，人们白日的喜乐」…"
        },
        {
            "id": "640830502",
            "speaker": "海娜",
            "text": "？"
        },
        {
            "id": "640830503",
            "speaker": "齐里亚布",
            "text": "「我立风中，却只想听，你那温柔的轻和」。"
        },
        {
            "id": "640830504",
            "speaker": "齐里亚布",
            "text": "嘿嘿…怎么样？"
        },
        {
            "id": "640830505",
            "speaker": "海娜",
            "text": "呃，什么怎么样？"
        },
        {
            "id": "640830506",
            "speaker": "齐里亚布",
            "text": "这首我精心创作的诗歌，你听完之后，感觉如何？"
        },
        {
            "id": "640830507",
            "speaker": "海娜",
            "text": "这是…你的什么文学课作业吗？"
        },
        {
            "id": "640830508",
            "speaker": "海娜",
            "text": "抱歉，我不是很懂啦…"
        },
        {
            "id": "640830509",
            "speaker": "齐里亚布",
            "text": "没关系！听我给你细说——"
        }
    ]
}