    "dialogues": [
        {
            "id": "620910501",
            "speaker": "Player",
            "text": "请问你是…？"
        },
        {
            "id": "620910502",
            "speaker": "秀华",
            "text": "我是毓…秀华！是白驹逆旅的跑堂，客人您有什么要求尽管找我就好！"
        },
        {
            "id": "620910503",
            "speaker": "Player",
            "text": "关于身份…"
        },
        {
            "id": "620910504",
            "speaker": "秀华",
            "text": "…欸，客人为什么突然问起这个？难道被看穿了！"
        },
        {
            "id": "620910505",
            "speaker": "秀华",
            "text": "嘿嘿，其实我是秀华的姐姐毓华，一成不变的生活太无聊了，难得老天给我们双胞胎这样的机会…"
        },
        {
            "id": "620910506",
            "speaker": "秀华",
            "text": "还请客人千万要帮忙保守这个秘密~！"
        }
    ]
}