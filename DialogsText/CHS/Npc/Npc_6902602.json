    "dialogues": [
        {
            "id": "690260201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
        },
        {
            "id": "690260202",
            "speaker": "魈",
            "text": "……"
        },
        {
            "id": "690260203",
            "speaker": "魈",
            "text": "这里没有不祥之物，是个清静的去处。"
        },
        {
            "id": "690260204",
            "speaker": "魈",
            "text": "但是…",
            "choices": [
                {
                    "id": "690260205",
                    "text": "但是？",
                    "response": [
                        {
                            "id": "690260206",
                            "speaker": "魈",
                            "text": "太过安逸了。"
                        },
                        {
                            "id": "690260209",
                            "speaker": "魈",
                            "text": "我会为你守护这一隅乐土。"
                        },
                        {
                            "id": "690260210",
                            "speaker": "魈",
                            "text": "但我自知与无忧无虑的生活无缘。"
                        },
                        {
                            "id": "690260211",
                            "speaker": "魈",
                            "text": "…你的好意我领受了。"
                        }
                    ]
                },
                {
                    "id": "690260207",
                    "text": "还是不太习惯？",
                    "response": [
                        {
                            "id": "690260208",
                            "speaker": "魈",
                            "text": "…嗯。"
                        }
                    ]
                }
            ]
        }
