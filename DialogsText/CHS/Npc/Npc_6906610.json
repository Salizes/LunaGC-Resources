{
    "talkId": "6906610",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 9,
        "神里绫人": 19
    },
    "dialogues": [
        {
            "id": "690660301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690660302",
            "speaker": "神里绫人",
            "text": "你想聊天自然可以。想说些什么？",
            "choices": [
                {
                    "id": "690660303",
                    "text": "关心一下社奉行的工作…",
                    "response": [
                        {
                            "id": "690660304",
                            "speaker": "神里绫人",
                            "text": "我还以为会让你主动问起的，是更私人的话题。"
                        },
                        {
                            "id": "690660305",
                            "speaker": "神里绫人",
                            "text": "不用担心我在工作上操劳过度。"
                        },
                        {
                            "id": "690660306",
                            "speaker": "神里绫人",
                            "text": "你看，我还有余力像这样说笑呢，呵呵。",
                            "choices": [
                                {
                                    "id": "690660307",
                                    "text": "不觉得辛苦吗？",
                                    "response": [
                                        {
                                            "id": "690660308",
                                            "speaker": "神里绫人",
                                            "text": "觉得辛苦，多半是尚未发现自己想守护的东西吧。"
                                        },
                                        {
                                            "id": "690660309",
                                            "speaker": "神里绫人",
                                            "text": "对于我而言，不会有这种困扰。"
                                        },
                                        {
                                            "id": "690660313",
                                            "speaker": "Player",
                                            "text": "真厉害…"
                                        },
                                        {
                                            "id": "690660314",
                                            "speaker": "神里绫人",
                                            "text": "能得到你的赞美和关心，真是不胜荣幸。"
                                        },
                                        {
                                            "id": "690660315",
                                            "speaker": "神里绫人",
                                            "text": "也请你放心吧。现如今，没有人比我更适合社奉行这个位置了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690660310",
                                    "text": "不觉得事情太多吗？",
                                    "response": [
                                        {
                                            "id": "690660311",
                                            "speaker": "神里绫人",
                                            "text": "工作量庞大吗？也是，但这是无法避免的。"
                                        },
                                        {
                                            "id": "690660312",
                                            "speaker": "神里绫人",
                                            "text": "那就尽量用聪明些的方法一件件处理吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690660316",
                    "text": "关心一下社奉行的生活…",
                    "response": [
                        {
                            "id": "690660317",
                            "speaker": "神里绫人",
                            "text": "生活吗…公务之余，能够自由支配的时间确实不多。"
                        },
                        {
                            "id": "690660318",
                            "speaker": "神里绫人",
                            "text": "既然你想关心我的生活，不如直接一点，任命你做我的近侍吧。"
                        },
                        {
                            "id": "690660319",
                            "speaker": "神里绫人",
                            "text": "饮食起居，就交给你负责了。"
                        },
                        {
                            "id": "690660320",
                            "speaker": "神里绫人",
                            "text": "啊…餐饮方面我没有忌口，生活上的怪癖，嗯…也应该没有。"
                        },
                        {
                            "id": "690660321",
                            "speaker": "神里绫人",
                            "text": "要是有什么口味新奇的东西，可以给我带一份。",
                            "choices": [
                                {
                                    "id": "690660322",
                                    "text": "比如奇怪的料理？",
                                    "response": [
                                        {
                                            "id": "690660323",
                                            "speaker": "神里绫人",
                                            "text": "哦？你可以试试看哦。"
                                        },
                                        {
                                            "id": "690660326",
                                            "speaker": "Player",
                                            "text": "原来这次是认真的…"
                                        },
                                        {
                                            "id": "690660327",
                                            "speaker": "神里绫人",
                                            "text": "啊，当然。"
                                        },
                                        {
                                            "id": "690660328",
                                            "speaker": "神里绫人",
                                            "text": "没关系。我会多给你一些考虑的时间，我们从长计议吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690660324",
                                    "text": "比如新奇的奶茶？",
                                    "response": [
                                        {
                                            "id": "690660325",
                                            "speaker": "神里绫人",
                                            "text": "嗯，我还挺期待的。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}