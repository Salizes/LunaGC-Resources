    },
    "dialogues": [
        {
            "id": "621490201",
            "speaker": "Player",
            "text": "故事？"
        },
        {
            "id": "621490202",
            "speaker": "阿义",
            "text": "嗯！鬼伯伯的故事都很有意思、很吓人…而且很真实！",
            "choices": [
                {
                    "id": "621490203",
                    "text": "很真实…？",
                    "response": [
                        {
                            "id": "621490204",
                            "speaker": "阿义",
                            "text": "嗯嗯！他讲的故事，有些是真的发生过的哦…"
                        },
                        {
                            "id": "621490205",
                            "speaker": "阿义",
                            "text": "比如那个小冥！我真的见过她的，还说下次再来找我玩…"
                        },
                        {
                            "id": "621490206",
                            "speaker": "阿义",
                            "text": "话说鬼的记性是不是不太好呢，怎么还没有来找我玩，明明每天晚上我都开着门睡觉的。"
                        }
                    ]
                },
                {
                    "id": "621490207",
                    "text": "好可怕…",
                    "response": [
                        {
                            "id": "621490208",
                            "speaker": "阿义",
                            "text": "对吧对吧！虽然我也每次都被吓得不轻…"
                        },
                        {
                            "id": "621490209",
                            "speaker": "阿义",
                            "text": "但后来真的见到了小冥，就不再怕了。鬼其实也不是那么吓人嘛！"
                        }
                    ]
                }
            ]
        }
    ]
}