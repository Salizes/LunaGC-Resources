    "dialogues": [
        {
            "id": "643560201",
            "speaker": "Player",
            "text": "你在找人？"
        },
        {
            "id": "643560202",
            "speaker": "阿巴克",
            "text": "对。"
        },
        {
            "id": "643560203",
            "speaker": "阿巴克",
            "text": "…啊，请不要误会，莎菲并非我的亲妹妹，只是团里的大家彼此间都很熟悉，所以经常互称兄弟姐妹。"
        },
        {
            "id": "643560204",
            "speaker": "阿巴克",
            "text": "最近团里接到一些新的委托，本来有很适合她的任务，结果她人不在…大概又是去哪里闲逛了吧。"
        }
    ]
}