{
    "talkId": "6908103",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "卡维": 12
    },
    "dialogues": [
        {
            "id": "690810301",
            "speaker": "Player",
            "text": "想一起聊聊天吗？"
        },
        {
            "id": "690810302",
            "speaker": "卡维",
            "text": "好啊，聊些什么？"
        },
        {
            "id": "690810303",
            "speaker": "卡维",
            "text": "话题…不要让我选比较好。以前有人说过我一旦挑起话题，很容易说到自己的专业上，没完没了。",
            "choices": [
                {
                    "id": "690810304",
                    "text": "聊聊你的生活吧。",
                    "response": [
                        {
                            "id": "690810305",
                            "speaker": "卡维",
                            "text": "生活啊…好像有很多事可以讲，又不知从何说起…"
                        },
                        {
                            "id": "690810306",
                            "speaker": "卡维",
                            "text": "不瞒你说…以前有段时间我过得很不好。破产导致了一些糟糕的事，而活在世上，没钱有时就无法拥有尊严。"
                        },
                        {
                            "id": "690810307",
                            "speaker": "卡维",
                            "text": "我不喜欢那样，可也无法马上摆脱困境，每天都活在自尊和现实的挣扎中。"
                        },
                        {
                            "id": "690810308",
                            "speaker": "卡维",
                            "text": "自以为是优秀设计师，就不愿意去做任何其他工作…后来才发现，很多事跟我想的完全不一样。"
                        },
                        {
                            "id": "690810309",
                            "speaker": "卡维",
                            "text": "学生时代的我比现在更理想化。我不太愿意承认…但过分天真的人确实没有办法活下去。"
                        },
                        {
                            "id": "690810310",
                            "speaker": "卡维",
                            "text": "啊，不好意思，这个话题太沉重了。当我没说过。"
                        }
                    ]
                },
                {
                    "id": "690810311",
                    "text": "聊聊你喜欢的东西吧。",
                    "response": [
                        {
                            "id": "690810312",
                            "speaker": "卡维",
                            "text": "嗯，喜欢的东西…我最近买了一台磨咖啡豆的机器，那个很不错。"
                        },
                        {
                            "id": "690810313",
                            "speaker": "卡维",
                            "text": "非常精巧！最重要的是每个零件都安排得恰到好处。"
                        },
                        {
                            "id": "690810314",
                            "speaker": "卡维",
                            "text": "没有多余的小螺丝，机身上也没有任何无意义的配件。磨豆子的效率很高，声音也不响，我很满意。"
                        },
                        {
                            "id": "690810315",
                            "speaker": "卡维",
                            "text": "啊，今天出门太急忘了拿…下次有机会的话，我带一些磨好的咖啡粉给你吧。"
                        }
                    ]
                }
            ]
        }
    ]
}