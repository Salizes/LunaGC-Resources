    "dialogues": [
        {
            "id": "690390901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690390202",
            "speaker": "迪奥娜",
            "text": "哼，勉勉强强吧。",
            "choices": [
                {
                    "id": "690390203",
                    "text": "只是勉勉强强吗？",
                    "response": [
                        {
                            "id": "690390205",
                            "speaker": "迪奥娜",
                            "text": "这里的草地没我经常午睡的那片软。"
                        },
                        {
                            "id": "690390206",
                            "speaker": "迪奥娜",
                            "text": "这里的蝴蝶没我经常去的那片花田多。"
                        },
                        {
                            "id": "690390207",
                            "speaker": "迪奥娜",
                            "text": "这里也不能像在野外一样自由自在地狩猎…"
                        },
                        {
                            "id": "690390208",
                            "speaker": "Player",
                            "text": "我…我会改进的。"
                        },
                        {
                            "id": "690390209",
                            "speaker": "迪奥娜",
                            "text": "但…但是这里没有我讨厌的烂醉如泥的味道…"
                        },
                        {
                            "id": "690390210",
                            "speaker": "迪奥娜",
                            "text": "也没有喝醉的酒鬼大吵大闹。"
                        },
                        {
                            "id": "690390211",
                            "speaker": "迪奥娜",
                            "text": "所…所以，只需要维持现在这样就好…"
                        }
                    ]
                },
                {
                    "id": "690390204",
                    "text": "迪奥娜有什么好建议吗？"
                }
            ]
        }
    ]
}