{
    "talkId": "6179902",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "艾玛托": 15
    },
    "dialogues": [
        {
            "id": "617990201",
            "speaker": "Player",
            "text": "在干嘛呢？"
        },
        {
            "id": "617990202",
            "speaker": "艾玛托",
            "text": "啊啊，是荣誉骑士！你好你好！"
        },
        {
            "id": "617990203",
            "speaker": "艾玛托",
            "text": "调查小队武器官艾玛托报告，我的新型炸药已经试制成功了！"
        },
        {
            "id": "617990204",
            "speaker": "艾玛托",
            "text": "目前看来，爆速的理想值，已经达到火花骑士蹦蹦炸弹五分之一的水准。"
        },
        {
            "id": "617990205",
            "speaker": "艾玛托",
            "text": "量产后的综合效能有望进一步提高到十分之一的水准…"
        },
        {
            "id": "617990206",
            "speaker": "艾玛托",
            "text": "…前提是火花骑士大人的炸药水平，一直保持在我之前观测到的水准…",
            "choices": [
                {
                    "id": "617990207",
                    "text": "等等，这不矛盾吗？",
                    "response": [
                        {
                            "id": "617990210",
                            "speaker": "艾玛托",
                            "text": "因为威力越大，成本越高，但量产炸药又必须注意价钱和生产性，以及运输和携带过程中的安全。"
                        },
                        {
                            "id": "617990211",
                            "speaker": "艾玛托",
                            "text": "一般来说，最终使用的炸药，不会是爆速最高的单一成分，必须要加入钝化和安定剂…"
                        },
                        {
                            "id": "617990212",
                            "speaker": "艾玛托",
                            "text": "这又会影响到加工难度，生产速度，进而作用于产量和性价比，也就是综合评估的「效能」之上。"
                        },
                        {
                            "id": "617990213",
                            "speaker": "艾玛托",
                            "text": "所以，炸药的基础威力越大，效能不一定越高，还需要好好平衡各种成分！",
                            "choices": [
                                {
                                    "id": "617990214",
                                    "text": "好苛刻的评估…",
                                    "response": [
                                        {
                                            "id": "617990216",
                                            "speaker": "艾玛托",
                                            "text": "嗯，其实谈不上复杂和严苛，对于想要战胜魔物的人，谁不追求强劲的破坏力呢？"
                                        },
                                        {
                                            "id": "617990217",
                                            "speaker": "艾玛托",
                                            "text": "根据大团长的说法，以及情报官们从纳塔友军那里获得的信息…"
                                        },
                                        {
                                            "id": "617990218",
                                            "speaker": "艾玛托",
                                            "text": "愚人众那位…能用火花骑士的蜡笔，轻松击毁遗迹守卫的执行官「队长」，能…能…能…能…"
                                        },
                                        {
                                            "id": "617990219",
                                            "speaker": "艾玛托",
                                            "text": "能单手一挥，就轻松向两百步外投射十名骑士背负的炸药当量，成片清扫魔物！"
                                        },
                                        {
                                            "id": "617990220",
                                            "speaker": "艾玛托",
                                            "text": "目前根本想象不出，要达成这个等级的破坏力，需要开发出什么样的火器才足够…"
                                        },
                                        {
                                            "id": "617990221",
                                            "speaker": "艾玛托",
                                            "text": "战力的进步，永无止境啊…必须不断努力才行！"
                                        }
                                    ]
                                },
                                {
                                    "id": "617990215",
                                    "text": "真是严格的追求…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "617990208",
                    "text": "为什么威力是五分之一…"
                },
                {
                    "id": "617990209",
                    "text": "效能却是十分之一？"
                }
            ]
        }
    ]
}