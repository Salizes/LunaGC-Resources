    "dialogues": [
        {
            "id": "671630301",
            "speaker": "Player",
            "text": "三！"
        },
        {
            "id": "671630302",
            "speaker": "愚人众特遣队新人",
            "text": "…嗯？二、二？"
        },
        {
            "id": "671630303",
            "speaker": "阿扎莉娅",
            "text": "怎么回事！连这么简单的任务都做不到吗！你！那个金发的，对，就是你！你怎么连制服都没有穿？",
            "choices": [
                {
                    "id": "671630304",
                    "text": "我…刚来。我想加入你们！",
                    "response": [
                        {
                            "id": "671630305",
                            "speaker": "派蒙",
                            "text": "欸？是、是什么时候有这种计划的？"
                        },
                        {
                            "id": "671630306",
                            "speaker": "阿扎莉娅",
                            "text": "哦？这可有些出乎意料了。不过既然已经走到了这里，多少也表明了你的决心。"
                        },
                        {
                            "id": "671630307",
                            "speaker": "阿扎莉娅",
                            "text": "不过很可惜，像你们这种企图打入我们队伍内的家伙，别以为能骗过我阿扎莉娅的眼睛！"
                        }
                    ]
                },
                {
                    "id": "671630308",
                    "text": "制服？没有那种特别的爱好。",
                    "response": [
                        {
                            "id": "671630309",
                            "speaker": "阿扎莉娅",
                            "text": "什么乱七八糟的！你果然很可疑。想狡辩？哼，那就用拳头说吧！"
                        }
                    ]
                }
            ]
        }
    ]
}