{
    "talkId": "7508754",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "塔卢加": 9,
        "奥伯龙": 2
    },
    "dialogues": [
        {
            "id": "750875401",
            "speaker": "塔卢加",
            "text": "摆出可怜的样子也没用，不行就是不行。"
        },
        {
            "id": "750875402",
            "speaker": "奥伯龙",
            "text": "啊呜…",
            "choices": [
                {
                    "id": "750875403",
                    "text": "和奥伯龙相处还融洽吗？",
                    "response": [
                        {
                            "id": "750875406",
                            "speaker": "奥伯龙",
                            "text": "呜呜…"
                        },
                        {
                            "id": "750875407",
                            "speaker": "塔卢加",
                            "text": "哎呀，你这家伙，换个人装可怜也没用的，就死了这条心吧。"
                        },
                        {
                            "id": "750875408",
                            "speaker": "塔卢加",
                            "text": "你瞧，因为要控制饮食，它最近一直这副样子。我也是为它考虑嘛…唔？这句话怎么听起来像是拉密萨纳会说的话？"
                        },
                        {
                            "id": "750875409",
                            "speaker": "塔卢加",
                            "text": "总、总之，等它的飞行成绩回到原来的水平，或者长成大龙，我会及时调整它的食量的，不用担心！"
                        }
                    ]
                },
                {
                    "id": "750875404",
                    "text": "关于你姐姐…",
                    "response": [
                        {
                            "id": "750875410",
                            "speaker": "塔卢加",
                            "text": "她最近还是和拉密萨纳走得很近…真搞不懂他哪里好了。"
                        },
                        {
                            "id": "750875411",
                            "speaker": "塔卢加",
                            "text": "不过既然她自己觉得好，那我还是不要阻拦了。我也有自己的考虑嘛。"
                        },
                        {
                            "id": "750875412",
                            "speaker": "塔卢加",
                            "text": "要成为花羽会最厉害的冒险家，要做的事还有很多啊。"
                        },
                        {
                            "id": "750875413",
                            "speaker": "塔卢加",
                            "text": "奥伯龙也要和我一起变厉害才行，不然还怎么去奥奇卡纳塔冒险呢？"
                        }
                    ]
                },
                {
                    "id": "750875405",
                    "text": "先走了。",
                    "response": [
                        {
                            "id": "750875415",
                            "speaker": "塔卢加",
                            "text": "啊，你要走了吗？也欢迎你随时回来看看。"
                        }
                    ]
                }
            ]
        }
    ]
}