{
    "talkId": "6153903",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "艾伦": 7
    },
    "dialogues": [
        {
            "id": "615390301",
            "speaker": "Player",
            "text": "你看起来精神不好…"
        },
        {
            "id": "615390302",
            "speaker": "艾伦",
            "text": "不用担心，是我昨天狩猎的时候又迷路了…"
        },
        {
            "id": "615390303",
            "speaker": "艾伦",
            "text": "差点撞到丘丘人营地里面去，好不容易才跑了出来…",
            "choices": [
                {
                    "id": "615390304",
                    "text": "真是危险…",
                    "response": [
                        {
                            "id": "615390305",
                            "speaker": "艾伦",
                            "text": "还好是安全回来了，但又是空手而归…"
                        },
                        {
                            "id": "615390306",
                            "speaker": "艾伦",
                            "text": "不过…唉，算了，我都习惯了…"
                        }
                    ]
                },
                {
                    "id": "615390307",
                    "text": "辛苦你了。",
                    "response": [
                        {
                            "id": "615390308",
                            "speaker": "艾伦",
                            "text": "我倒是还好，只是经常会被路过的侦察骑士安柏小姐搭救…"
                        },
                        {
                            "id": "615390309",
                            "speaker": "艾伦",
                            "text": "真是太不好意思了。"
                        },
                        {
                            "id": "615390310",
                            "speaker": "艾伦",
                            "text": "她真的很厉害，不愧是拥有神之眼的人呐…"
                        }
                    ]
                }
            ]
        }
    ]
}