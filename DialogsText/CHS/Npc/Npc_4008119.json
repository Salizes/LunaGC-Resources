{
    "talkId": "4008119",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 7,
        "左右加": 14,
        "派蒙": 13
    },
    "dialogues": [
        {
            "id": "400811901",
            "speaker": "左右加",
            "text": "两位…你们也来培养蕈兽了 ？"
        },
        {
            "id": "400811902",
            "speaker": "左右加",
            "text": "#即便身手矫健如「三千贼匪七日斩」的{NICKNAME}，也会不懈努力…作为正派对手，的确能给人很强的压迫感！",
            "choices": [
                {
                    "id": "400811903",
                    "text": "你怎么不结巴了？",
                    "response": [
                        {
                            "id": "400811904",
                            "speaker": "派蒙",
                            "text": "对哦，你怎么突然说话这么流利了，难道是不怕我们了吗？"
                        },
                        {
                            "id": "400811905",
                            "speaker": "左右加",
                            "text": "呃…唔…嗯…呃…"
                        },
                        {
                            "id": "400811906",
                            "speaker": "左右加",
                            "text": "我对你们两位肯定是无比敬重的，但并不代表我会害怕和你们说话。"
                        },
                        {
                            "id": "400811907",
                            "speaker": "左右加",
                            "text": "之前说话哆哆嗦嗦，其实原因不在你们，说起来有点复杂…"
                        },
                        {
                            "id": "400811908",
                            "speaker": "派蒙",
                            "text": "我明白了！你肯定经常拖稿，所以很怕神子！"
                        },
                        {
                            "id": "400811909",
                            "speaker": "派蒙",
                            "text": "神子一站在身边，你就会想起快到截稿日时的恐惧，所以紧张得发抖吧！"
                        },
                        {
                            "id": "400811910",
                            "speaker": "Player",
                            "text": "呜呜，稿子要写不完了…"
                        },
                        {
                            "id": "400811911",
                            "speaker": "左右加",
                            "text": "请，请不要那么大声！"
                        },
                        {
                            "id": "400811912",
                            "speaker": "左右加",
                            "text": "就算你的猜测是真的，也请不要直接说出来…"
                        },
                        {
                            "id": "400811913",
                            "speaker": "派蒙",
                            "text": "别担心啦，我们口风很严的。"
                        },
                        {
                            "id": "400811914",
                            "speaker": "派蒙",
                            "text": "那就请你加油啦，左右加小姐！"
                        }
                    ]
                },
                {
                    "id": "400811915",
                    "text": "这都是什么奇怪的绰号…",
                    "response": [
                        {
                            "id": "400811916",
                            "speaker": "左右加",
                            "text": "啊，你们不喜欢吗？"
                        },
                        {
                            "id": "400811917",
                            "speaker": "左右加",
                            "text": "作者们吃饭的时候，偶尔会聊到你们，当场给你们起一些称号，每次都有人拍案叫好呢…"
                        },
                        {
                            "id": "400811918",
                            "speaker": "派蒙",
                            "text": "我倒是觉得很有意思，不愧是作者们想出来的绰号，确实有小说里重要角色的排场！"
                        },
                        {
                            "id": "400811919",
                            "speaker": "派蒙",
                            "text": "左右加小姐也会给蕈兽起这样的名吗？我记得神子的蕈兽，就是左右加小姐起的名。"
                        },
                        {
                            "id": "400811920",
                            "speaker": "左右加",
                            "text": "说实话，我本来想起个轻松一点的名字。"
                        },
                        {
                            "id": "400811921",
                            "speaker": "左右加",
                            "text": "但八重大人说，「既然要创作热血题材的小说，就要无拘无束，再夸张都没问题。」"
                        },
                        {
                            "id": "400811922",
                            "speaker": "Player",
                            "text": "佣兵们好像也这样。"
                        },
                        {
                            "id": "400811923",
                            "speaker": "派蒙",
                            "text": "#也对哦，佣兵们给我和{NICKNAME}起的外号，听起来也超级夸张！"
                        },
                        {
                            "id": "400811924",
                            "speaker": "派蒙",
                            "text": "「黄金流星」砸下来咯——轰轰！「白银伴星」跟在后面打了个二连击——哐哐！"
                        },
                        {
                            "id": "400811925",
                            "speaker": "左右加",
                            "text": "其实，据说「名字」也是一种期望的表达，能让人和事物向着「名字」的寓意演变。"
                        },
                        {
                            "id": "400811926",
                            "speaker": "左右加",
                            "text": "名字起的足够威风的话，蕈兽也会在不知不觉中变得很强！"
                        },
                        {
                            "id": "400811927",
                            "speaker": "派蒙",
                            "text": "真的吗？那我一定要多叫「咚咚小圆帽」的名字。"
                        },
                        {
                            "id": "400811928",
                            "speaker": "派蒙",
                            "text": "这样一来，「咚咚小圆帽」的脑袋，以后敲起来，就真的是「咚咚」声了。",
                            "choices": [
                                {
                                    "id": "400811929",
                                    "text": "肯定还是「噗噗」。",
                                    "response": [
                                        {
                                            "id": "400811931",
                                            "speaker": "派蒙",
                                            "text": "哼，我们就打个赌吧！"
                                        },
                                        {
                                            "id": "400811932",
                                            "speaker": "派蒙",
                                            "text": "输了的人就要给「咚咚小圆帽」当三天的坐骑哦！"
                                        }
                                    ]
                                },
                                {
                                    "id": "400811930",
                                    "text": "「咚咚」是水泡砸人的动静。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400811933",
                    "text": "加油啊，左右加！",
                    "response": [
                        {
                            "id": "400811934",
                            "speaker": "左右加",
                            "text": "呜呜，虽然只是一句普通的鼓励，但却让我觉得好荣幸！"
                        }
                    ]
                }
            ]
        }
    ]
}