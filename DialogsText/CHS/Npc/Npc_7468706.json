{
    "talkId": "7468706",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 4,
        "主角": 1,
        "玛因": 17
    },
    "dialogues": [
        {
            "id": "746870601",
            "speaker": "玛因",
            "text": "哟，老板…准领队，事态平息了吗？如果没什么魔物了，那我就去干正事了？",
            "choices": [
                {
                    "id": "746870602",
                    "text": "好像暂时还没处理完。",
                    "response": [
                        {
                            "id": "746870603",
                            "speaker": "玛因",
                            "text": "那我不急，不走，我继续待命。"
                        },
                        {
                            "id": "746870604",
                            "speaker": "玛因",
                            "text": "如果你累了，就叫我一声，我继续去遥控炮台，杀魔物。"
                        },
                        {
                            "id": "746870605",
                            "speaker": "玛因",
                            "text": "这事我能干一整天。"
                        }
                    ]
                },
                {
                    "id": "746870606",
                    "text": "你不和那两位同事交流吗？",
                    "response": [
                        {
                            "id": "746870607",
                            "speaker": "玛因",
                            "text": "咦？我有和他们好好聊过天啊。"
                        },
                        {
                            "id": "746870608",
                            "speaker": "玛因",
                            "text": "谢妮小姐还给了我很贵重的甜点，以前没吃过的蛋糕，以人类的标准，应该很美味。"
                        },
                        {
                            "id": "746870609",
                            "speaker": "玛因",
                            "text": "我的口味已经被同事们驯化好了，我吃得也挺开心的。"
                        },
                        {
                            "id": "746870610",
                            "speaker": "玛因",
                            "text": "谢妮家应该很有钱，弗雷瑞斯就出自普通家庭。谢妮总是给弗雷瑞斯吃这种甜点，少说一天也得花八九千摩拉。"
                        },
                        {
                            "id": "746870611",
                            "speaker": "主角",
                            "text": "这都能看出来？"
                        },
                        {
                            "id": "746870612",
                            "speaker": "玛因",
                            "text": "我猜的，嗯，根据步态，神情和谈吐用词猜的。"
                        },
                        {
                            "id": "746870613",
                            "speaker": "玛因",
                            "text": "不过，和他们一起休息的时候，我能感觉到，我有点多余。不是他们嫌弃我，而是我能意识到，气氛不对…"
                        },
                        {
                            "id": "746870614",
                            "speaker": "玛因",
                            "text": "所以我还是不打扰他们了，在这里安安静静放哨也挺好的，以前我在连队里也干侦察和放哨的活。"
                        }
                    ]
                },
                {
                    "id": "746870615",
                    "text": "你还有什么正事？",
                    "response": [
                        {
                            "id": "746870616",
                            "speaker": "玛因",
                            "text": "说来挺巧的，本来我在这附近转悠，是领了埃德勒…另一位探员的任务。"
                        },
                        {
                            "id": "746870617",
                            "speaker": "玛因",
                            "text": "最近有些搞经济犯罪的混蛋，在这一带出没过。"
                        },
                        {
                            "id": "746870618",
                            "speaker": "玛因",
                            "text": "正好这里也有几间正在招租的房子，说不定藏着点玄机，我就过来查查线索。"
                        },
                        {
                            "id": "746870619",
                            "speaker": "玛因",
                            "text": "不过，说实话，调查经济犯罪，并没有直接揍魔物来得有劲。"
                        },
                        {
                            "id": "746870620",
                            "speaker": "玛因",
                            "text": "以后你有揍魔物的差事，也可以随时叫上我，管饭最好，不管饭的话我自带便当。"
                        }
                    ]
                },
                {
                    "id": "746870621",
                    "text": "我去继续对付魔物了。",
                    "response": [
                        {
                            "id": "746870622",
                            "speaker": "玛因",
                            "text": "看样子还有的忙啊，挺好。别累着自己，乏了的话，就把重炮让给我吧，我来打打杀杀。"
                        }
                    ]
                }
            ]
        }
    ]
}