    "dialogues": [
        {
            "id": "726930801",
            "speaker": "莱内",
            "text": "一想到这次稻妻之旅很快就要结束，大家不能再像现在这样畅谈诗歌，心里还真是有点伤感。"
        },
        {
            "id": "726930802",
            "speaker": "大伴",
            "text": "虽说天下没有不散的筵席，但失落却是在所难免。莱内先生，之后我们就以书信来交流创作心得怎样？"
        },
        {
            "id": "726930803",
            "speaker": "莱内",
            "text": "那真是太好了！"
        }
    ]
}