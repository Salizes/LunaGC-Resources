    "dialogues": [
        {
            "id": "210070701",
            "speaker": "元鸿",
            "text": "孤木孑立，无林可依…"
        },
        {
            "id": "210070702",
            "speaker": "Player",
            "text": "您好。"
        },
        {
            "id": "210070703",
            "speaker": "元鸿",
            "text": "红叶萋萋，无风自离…"
        },
        {
            "id": "210070704",
            "speaker": "Player",
            "text": "您好！！"
        },
        {
            "id": "210070705",
            "speaker": "元鸿",
            "text": "红叶簌簌，乘风散去…"
        },
        {
            "id": "210070706",
            "speaker": "派蒙",
            "text": "他怎么不回答我们呀…"
        },
        {
            "id": "210070707",
            "speaker": "元鸿",
            "text": "什么金银财帛…都是个笑话，都是个笑话…"
        },
        {
            "id": "210070708",
            "speaker": "元鸿",
            "text": "这镇子…离得越远越好…"
        },
        {
            "id": "210070709",
            "speaker": "元鸿",
            "text": "只要从头来过，只要从头来过…"
        }
    ]
}