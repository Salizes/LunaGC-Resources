    "dialogues": [
        {
            "id": "650560401",
            "speaker": "Player",
            "text": "关于蔬果…"
        },
        {
            "id": "650560402",
            "speaker": "欧仁妮",
            "text": "枫丹本地盛产泡泡桔，但依靠发达的水路，也会引进很多国外的水果，只是价格会略高一些。"
        },
        {
            "id": "650560403",
            "speaker": "欧仁妮",
            "text": "但请您放心，我欧仁妮绝不做亏心生意，保证客人买到的蔬果从头美味到根，绝不会有一个坏果。"
        }
    ]
}