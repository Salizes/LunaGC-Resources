{
    "talkId": "6907411",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "莱依拉": 15
    },
    "dialogues": [
        {
            "id": "690740401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690740402",
            "speaker": "莱依拉",
            "text": "想做的事吗？那还挺多的呢。"
        },
        {
            "id": "690740403",
            "speaker": "莱依拉",
            "text": "嗯…想好好睡上一觉，想把这么漂亮的地方逛个遍…能随随便便想出一大堆。"
        },
        {
            "id": "690740404",
            "speaker": "莱依拉",
            "text": "但是要说当下、在这里，我最想做的事情是什么的话，那就是安心地「什么都不做」吧。",
            "choices": [
                {
                    "id": "690740405",
                    "text": "什么都不做？",
                    "response": [
                        {
                            "id": "690740407",
                            "speaker": "莱依拉",
                            "text": "啊！你对我非常好，这里的环境也很让我自在…"
                        },
                        {
                            "id": "690740408",
                            "speaker": "莱依拉",
                            "text": "我没有觉得哪里不好的意思，你千万不要误会！"
                        },
                        {
                            "id": "690740409",
                            "speaker": "Player",
                            "text": "没事，慢慢说就好。"
                        },
                        {
                            "id": "690740410",
                            "speaker": "莱依拉",
                            "text": "唔，好的…谢谢你。"
                        },
                        {
                            "id": "690740411",
                            "speaker": "莱依拉",
                            "text": "呼…你看我，平时做事总是没有底气，会因为各种各样的事情着急或焦虑。"
                        },
                        {
                            "id": "690740412",
                            "speaker": "莱依拉",
                            "text": "我有好多压力、好多苦恼…不知道自己够不够努力，不知道自己的未来什么样…"
                        },
                        {
                            "id": "690740413",
                            "speaker": "莱依拉",
                            "text": "我没把握的东西太多了，学业也好，生活也好。"
                        },
                        {
                            "id": "690740414",
                            "speaker": "莱依拉",
                            "text": "…总害怕自己不知不觉中错过了什么重要的东西，如果是这样的话，将来的我一定会后悔！"
                        },
                        {
                            "id": "690740415",
                            "speaker": "莱依拉",
                            "text": "这样很累，恐怕也被你看出来了。所以你才会建议我请假，好好休息对吧？"
                        },
                        {
                            "id": "690740416",
                            "speaker": "Player",
                            "text": "是有这种考虑。"
                        },
                        {
                            "id": "690740417",
                            "speaker": "莱依拉",
                            "text": "嘿嘿，那我还是聪明的嘛…"
                        },
                        {
                            "id": "690740418",
                            "speaker": "莱依拉",
                            "text": "所以，我就想着，得好好收下你的好意。彻彻底底地休息一会儿好了！"
                        },
                        {
                            "id": "690740419",
                            "speaker": "莱依拉",
                            "text": "既然决定了要让自己的心也跟着放松，那就什么都不干、什么都不去担心。",
                            "choices": [
                                {
                                    "id": "690740420",
                                    "text": "干脆跟我来吧…",
                                    "response": [
                                        {
                                            "id": "690740422",
                                            "speaker": "莱依拉",
                                            "text": "好呀！那我们就一起悠闲地发发呆吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "690740421",
                                    "text": "陪你找片草坪躺一会儿。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690740406",
                    "text": "为什么这么说？"
                }
            ]
        }
    ]
}