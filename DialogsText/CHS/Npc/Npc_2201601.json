{
    "talkId": "2201601",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 7,
        "芭尔瓦涅": 16
    },
    "dialogues": [
        {
            "id": "220160101",
            "speaker": "芭尔瓦涅",
            "text": "旅行者…你来得正好！你见过朱莉吗？就那个…那个小个子的蒙德女孩，之前在我旁边的那个！"
        },
        {
            "id": "220160102",
            "speaker": "Player",
            "text": "没见过…"
        },
        {
            "id": "220160103",
            "speaker": "芭尔瓦涅",
            "text": "你、你也没见过吗？这个笨蛋到底去哪了…"
        },
        {
            "id": "220160104",
            "speaker": "Player",
            "text": "怎么了？"
        },
        {
            "id": "220160105",
            "speaker": "芭尔瓦涅",
            "text": "朱莉突然…突然不见了。不、不不不，也不能说是突然不见了…"
        },
        {
            "id": "220160106",
            "speaker": "芭尔瓦涅",
            "text": "之前你和我们一起去搜集食材的时候，遇见了一个叫做龟井宗久的大叔，你还记得吗？",
            "choices": [
                {
                    "id": "220160107",
                    "text": "记得是记得…",
                    "response": [
                        {
                            "id": "220160109",
                            "speaker": "芭尔瓦涅",
                            "text": "那个大叔，不是打倒了那个营地附近的魔物，然后还把周围的食材分给我们了吗？"
                        },
                        {
                            "id": "220160110",
                            "speaker": "芭尔瓦涅",
                            "text": "朱莉那个家伙，自从回去之后就一直念叨着那个大叔，说什么想给那个大叔送点吃的东西道谢…"
                        },
                        {
                            "id": "220160111",
                            "speaker": "芭尔瓦涅",
                            "text": "我和旭东都以为这家伙只是说说，没想到她今天在营地里留了一封信，真的跑去找那个大叔了。"
                        },
                        {
                            "id": "220160112",
                            "speaker": "芭尔瓦涅",
                            "text": "这个笨蛋…根本不知道在想什么！那个龟井宗久，看着就很可疑啊！"
                        },
                        {
                            "id": "220160113",
                            "speaker": "芭尔瓦涅",
                            "text": "唉，之后我们就分头行动了，旭东去上次我们遇见那个大叔的地点搜索，我回来找冒险家协会挂个寻人委托。"
                        },
                        {
                            "id": "220160114",
                            "speaker": "芭尔瓦涅",
                            "text": "稻妻现在这种局势，那个笨蛋居然还敢乱跑…必须快点找到她才行。",
                            "choices": [
                                {
                                    "id": "220160115",
                                    "text": "我和你一起去吧。",
                                    "response": [
                                        {
                                            "id": "220160116",
                                            "speaker": "芭尔瓦涅",
                                            "text": "你愿意帮忙的话那就最好了。"
                                        },
                                        {
                                            "id": "220160123",
                                            "speaker": "芭尔瓦涅",
                                            "text": "旭东和我约定了汇合的地点，我们先去那边找他。"
                                        }
                                    ]
                                },
                                {
                                    "id": "220160117",
                                    "text": "如果她遇见了魔物…",
                                    "response": [
                                        {
                                            "id": "220160118",
                                            "speaker": "芭尔瓦涅",
                                            "text": "朱莉要是遇见了魔物…一般来说，那倒霉的应该是魔物才对。"
                                        },
                                        {
                                            "id": "220160119",
                                            "speaker": "芭尔瓦涅",
                                            "text": "但她要是遇见了海乱鬼之类的家伙就糟糕了，那些人可不能用对付魔物的思路来对付…"
                                        },
                                        {
                                            "id": "220160120",
                                            "speaker": "芭尔瓦涅",
                                            "text": "但如果真要和那些家伙动手，就算我和旭东一起也…"
                                        },
                                        {
                                            "id": "220160121",
                                            "speaker": "Player",
                                            "text": "我来帮忙对付那些家伙。"
                                        },
                                        {
                                            "id": "220160122",
                                            "speaker": "芭尔瓦涅",
                                            "text": "咦？你愿意帮忙吗？那太好了。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "220160108",
                    "text": "是那个武士？"
                }
            ]
        }
    ]
}