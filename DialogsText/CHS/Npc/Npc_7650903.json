{
    "talkId": "7650903",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 7,
        "维斯菈娃": 19
    },
    "dialogues": [
        {
            "id": "765090301",
            "speaker": "维斯菈娃",
            "text": "哎，您好，玩得如何？",
            "choices": [
                {
                    "id": "765090302",
                    "text": "相当不错，颇有感悟。",
                    "response": [
                        {
                            "id": "765090303",
                            "speaker": "维斯菈娃",
                            "text": "哼，埃德勒这人虽然笨，但是这种解闷的小玩意儿倒是做得很不错…",
                            "choices": [
                                {
                                    "id": "765090304",
                                    "text": "好直接…",
                                    "response": [
                                        {
                                            "id": "765090305",
                                            "speaker": "维斯菈娃",
                                            "text": "哈哈，我敢和你说这些话，自然就敢和她当面说这些话，更何况，这本来就是实话嘛！"
                                        },
                                        {
                                            "id": "765090306",
                                            "speaker": "维斯菈娃",
                                            "text": "她总觉得我还不知道她的身份，但她在枫丹出手的时候，我立马就知道了——她掏出的武器，上面有个小小的执律庭的标识…"
                                        },
                                        {
                                            "id": "765090307",
                                            "speaker": "维斯菈娃",
                                            "text": "但看着她乐呵呵地演着「热心商人」，我就觉得，我不说破，会更好玩一些。"
                                        },
                                        {
                                            "id": "765090308",
                                            "speaker": "维斯菈娃",
                                            "text": "一位正义的枫丹便衣警探，在这样的地界，要遭受我「热心保镖」的「报警」威胁，而不得已自证…"
                                        },
                                        {
                                            "id": "765090309",
                                            "speaker": "维斯菈娃",
                                            "text": "太像映影里的剧情了！"
                                        },
                                        {
                                            "id": "765090310",
                                            "speaker": "Player",
                                            "text": "如果能拍出来也相当精彩…"
                                        },
                                        {
                                            "id": "765090311",
                                            "speaker": "维斯菈娃",
                                            "text": "但说实话，我只是想和她切磋切磋，而她总是想太多。"
                                        },
                                        {
                                            "id": "765090312",
                                            "speaker": "维斯菈娃",
                                            "text": "好啦，不多说了，您去玩吧！这兵棋推演里面还有许多门道要琢磨呢。"
                                        }
                                    ]
                                },
                                {
                                    "id": "765090326",
                                    "text": "我们才第一次见面…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "765090313",
                    "text": "其实我更感兴趣你的身份。",
                    "response": [
                        {
                            "id": "765090314",
                            "speaker": "维斯菈娃",
                            "text": "我？跟您这种能成为执行官的座上宾的大人物不同，我只是他们手下的小人物，不足一提啦。"
                        },
                        {
                            "id": "765090315",
                            "speaker": "维斯菈娃",
                            "text": "但不瞒您说，虽然我这小喽啰大多数时候一点风声都听不到，架不住当年我的上级总是喜欢说这些。"
                        },
                        {
                            "id": "765090316",
                            "speaker": "维斯菈娃",
                            "text": "#在传说中，{NICKNAME}，一位武艺超群、智力非凡的大人物！"
                        },
                        {
                            "id": "765090317",
                            "speaker": "维斯菈娃",
                            "text": "当时我就想，或许之后某一日你我战场相见时，我会多快成为您刀下轻飘飘的幽魂呢？"
                        },
                        {
                            "id": "765090318",
                            "speaker": "维斯菈娃",
                            "text": "唉，想得太远并不是好事，您去继续玩兵棋吧。"
                        }
                    ]
                },
                {
                    "id": "765090319",
                    "text": "我更好奇你的休假期…",
                    "response": [
                        {
                            "id": "765090320",
                            "speaker": "维斯菈娃",
                            "text": "哎呀呀，当我还是只小蚂蚁的时候，我差不多…一年只有十来天能够在阳光底下遛遛。"
                        },
                        {
                            "id": "765090321",
                            "speaker": "维斯菈娃",
                            "text": "现在我变成了蚂蚁士官，也就能多溜达几天了。"
                        },
                        {
                            "id": "765090322",
                            "speaker": "维斯菈娃",
                            "text": "啊…等到哪天，我变成蚂蚁头头，我就能享受顶格待遇——整整二十五日的休假期了！"
                        },
                        {
                            "id": "765090323",
                            "speaker": "维斯菈娃",
                            "text": "到时候，我肯定要找个温暖的地方，好好享受享受…"
                        }
                    ]
                },
                {
                    "id": "765090324",
                    "text": "我还没玩上呢。",
                    "response": [
                        {
                            "id": "765090325",
                            "speaker": "维斯菈娃",
                            "text": "那快去吧，兵棋推演就摆在那儿呢。"
                        }
                    ]
                }
            ]
        }
    ]
}