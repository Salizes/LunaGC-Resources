{
    "talkId": "7104113",
    "total_dialogue_lines": 48,
    "speaker_counts": {
        "Player": 8,
        "克里托夫": 29,
        "派蒙": 11
    },
    "dialogues": [
        {
            "id": "710411301",
            "speaker": "克里托夫",
            "text": "你好，谢谢你们搭救，不然的话我恐怕就要被他们丢去喂狗了…",
            "choices": [
                {
                    "id": "710411302",
                    "text": "你们还有狗？",
                    "response": [
                        {
                            "id": "710411304",
                            "speaker": "克里托夫",
                            "text": "哈哈，不要开玩笑啦…还蛮吓人的。"
                        },
                        {
                            "id": "710411305",
                            "speaker": "Player",
                            "text": "你是怎么沦落至此的？"
                        },
                        {
                            "id": "710411306",
                            "speaker": "克里托夫",
                            "text": "我？帮二哥做事，搞砸了，被关笼子里了。就这么简单。",
                            "choices": [
                                {
                                    "id": "710411307",
                                    "text": "二哥是谁？",
                                    "response": [
                                        {
                                            "id": "710411308",
                                            "speaker": "克里托夫",
                                            "text": "他呀，他是明蕴镇的人。之前在那边上工，矿采空以后就来了层岩巨渊。干得不错，升任了工头。"
                                        },
                                        {
                                            "id": "710411309",
                                            "speaker": "克里托夫",
                                            "text": "然后…你也知道。层岩巨渊，「噗——」矿工们，「哇哦哦——」总务司，「嗯？嗯？嗯？！」"
                                        },
                                        {
                                            "id": "710411310",
                                            "speaker": "克里托夫",
                                            "text": "七星的大人们：「咳——咳——」然后千岩军就「哼——哼——哼——」"
                                        },
                                        {
                                            "id": "710411311",
                                            "speaker": "派蒙",
                                            "text": "…这个家伙在说些什么呀！什么哇哇哇哼哼哼的…"
                                        },
                                        {
                                            "id": "710411312",
                                            "speaker": "Player",
                                            "text": "请说人话。"
                                        },
                                        {
                                            "id": "710411313",
                                            "speaker": "克里托夫",
                                            "text": "归根结底一句话，矿坑歇业，矿工也没了工作。你们猜矿工没了工作，会靠什么糊口？"
                                        },
                                        {
                                            "id": "710411314",
                                            "speaker": "克里托夫",
                                            "text": "我是说，像二哥这样经验丰富，大半辈子都没见过阳光的资深矿工，四十来岁才当上工头，没得意几天，工作就没了…"
                                        },
                                        {
                                            "id": "710411315",
                                            "speaker": "克里托夫",
                                            "text": "他会去哪里做什么呢？"
                                        },
                                        {
                                            "id": "710411316",
                                            "speaker": "派蒙",
                                            "text": "唔…会去…加入盗宝团…？"
                                        },
                                        {
                                            "id": "710411317",
                                            "speaker": "克里托夫",
                                            "text": "哈哈！你的思路就和盗宝团的人很接近了！"
                                        },
                                        {
                                            "id": "710411318",
                                            "speaker": "克里托夫",
                                            "text": "不过我还是劝你，不要做违法犯罪的事情。盗宝团可不是什么好人哦，做坏事太多是没办法回头的…"
                                        },
                                        {
                                            "id": "710411319",
                                            "speaker": "派蒙",
                                            "text": "哦…你说的很对…我不应该做盗宝团…"
                                        },
                                        {
                                            "id": "710411320",
                                            "speaker": "派蒙",
                                            "text": "不对——！明明你才是盗宝团吧！！"
                                        },
                                        {
                                            "id": "710411321",
                                            "speaker": "克里托夫",
                                            "text": "哈哈哈哈哈哈！好了…哈哈好了…不开玩笑了。总之…加入盗宝团不全是因为天生坏心眼。"
                                        },
                                        {
                                            "id": "710411322",
                                            "speaker": "克里托夫",
                                            "text": "但是对二哥来说，总务司下发的补贴也足够让他重新开始，诚实经营了…他却选了这条险恶的路，哼…"
                                        },
                                        {
                                            "id": "710411323",
                                            "speaker": "克里托夫",
                                            "text": "人各有志吧。有的人耐不住暂时的苦难，注定要选择走投机的道路伤害别人…用我们蒙德人的话说，这也是自由的另一面吧？"
                                        }
                                    ]
                                },
                                {
                                    "id": "710411324",
                                    "text": "关于你自己…",
                                    "response": [
                                        {
                                            "id": "710411325",
                                            "speaker": "克里托夫",
                                            "text": "我？我自己？没什么好说的啦。"
                                        },
                                        {
                                            "id": "710411326",
                                            "speaker": "克里托夫",
                                            "text": "我是蒙德人，参加盗宝团没多久，来璃月也没多久。跟着几个大哥一起来的，他们在上面倒腾矿石。"
                                        },
                                        {
                                            "id": "710411327",
                                            "speaker": "克里托夫",
                                            "text": "我就跟着二哥倒腾点小活计，帮忙偷鸡摸狗、联络矿下的兄弟什么的…这不是，正倒腾着，被你们给抓了。"
                                        },
                                        {
                                            "id": "710411328",
                                            "speaker": "派蒙",
                                            "text": "不对呀…我们抓你之前，你不就已经在笼子里了吗？"
                                        },
                                        {
                                            "id": "710411329",
                                            "speaker": "克里托夫",
                                            "text": "唉…我先是踩点失误，让盗宝团的兄弟们中了不知谁的埋伏…"
                                        },
                                        {
                                            "id": "710411330",
                                            "speaker": "Player",
                                            "text": "是我们。"
                                        },
                                        {
                                            "id": "710411331",
                                            "speaker": "派蒙",
                                            "text": "噗——"
                                        },
                                        {
                                            "id": "710411332",
                                            "speaker": "克里托夫",
                                            "text": "原来…果然是你们！"
                                        },
                                        {
                                            "id": "710411333",
                                            "speaker": "派蒙",
                                            "text": "嘿嘿…举手之劳啦…"
                                        },
                                        {
                                            "id": "710411334",
                                            "speaker": "派蒙",
                                            "text": "况且…谁也没想到会牵连到你嘛，对吧？"
                                        },
                                        {
                                            "id": "710411335",
                                            "speaker": "克里托夫",
                                            "text": "哼…然后我就被二哥他们发配去看守盗宝鼬…结果我开了小差，盗宝鼬四处乱窜，把我们自己的东西偷了个干净…"
                                        },
                                        {
                                            "id": "710411336",
                                            "speaker": "派蒙",
                                            "text": "噗哈哈哈哈哈！"
                                        },
                                        {
                                            "id": "710411337",
                                            "speaker": "克里托夫",
                                            "text": "好啦，你就笑吧，小心笑坏肚子了…真是丢人。"
                                        },
                                        {
                                            "id": "710411338",
                                            "speaker": "克里托夫",
                                            "text": "再然后呢，二哥打发我寻找下矿的密道…好不容易探好了路，突然一阵地震，差点把我们都给活埋了！"
                                        },
                                        {
                                            "id": "710411339",
                                            "speaker": "Player",
                                            "text": "好像…也是我们…"
                                        },
                                        {
                                            "id": "710411340",
                                            "speaker": "派蒙",
                                            "text": "对哦！是我们破坏…呃，解封「磐键」的时候！好大一场地震呢！"
                                        },
                                        {
                                            "id": "710411341",
                                            "speaker": "克里托夫",
                                            "text": "二哥本来就憋了一肚子邪火，这下可是气得暴跳如雷。"
                                        },
                                        {
                                            "id": "710411342",
                                            "speaker": "克里托夫",
                                            "text": "「你这没出息的东西，怕不是千岩军专门派来搞我的！」"
                                        },
                                        {
                                            "id": "710411343",
                                            "speaker": "克里托夫",
                                            "text": "「坏我大事是吧？放我盗宝鼬是吧！这就把你关盗宝鼬的笼子里，等我们办完大生意再好好收拾你！」"
                                        },
                                        {
                                            "id": "710411344",
                                            "speaker": "克里托夫",
                                            "text": "…他是这么说的。"
                                        },
                                        {
                                            "id": "710411345",
                                            "speaker": "克里托夫",
                                            "text": "啊，顺便忘了提，于是他就把我关进笼子里了。"
                                        },
                                        {
                                            "id": "710411346",
                                            "speaker": "派蒙",
                                            "text": "哈哈哈哈哈哈哈！二哥也太惨了吧！"
                                        },
                                        {
                                            "id": "710411347",
                                            "speaker": "克里托夫",
                                            "text": "是啊…还被你们揍了两遍。"
                                        },
                                        {
                                            "id": "710411348",
                                            "speaker": "克里托夫",
                                            "text": "唔…我可没有同情他的意思！只是感谢你们搭救，不然我就真的惨了。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "710411303",
                    "text": "可惜我们没养狗。"
                }
            ]
        }
    ]
}