{
    "talkId": "6904603",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "胡桃": 11
    },
    "dialogues": [
        {
            "id": "690460301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690460302",
            "speaker": "胡桃",
            "text": "来得正好，我刚想找人闲聊，你就出现了，该不是有什么心灵感应吧？"
        },
        {
            "id": "690460303",
            "speaker": "胡桃",
            "text": "哎呀哎呀，贴心温柔，莫过于你啦！"
        },
        {
            "id": "690460304",
            "speaker": "胡桃",
            "text": "#那么，{NICKNAME}，你想聊些什么？",
            "choices": [
                {
                    "id": "690460305",
                    "text": "想听堂主讲解玄妙之事。",
                    "response": [
                        {
                            "id": "690460306",
                            "speaker": "胡桃",
                            "text": "玄妙之事怎么能用说的？天下万物，眼见为实。"
                        },
                        {
                            "id": "690460307",
                            "speaker": "胡桃",
                            "text": "只要胆子大，晚上跟本堂主去山里闲逛，包你开眼。"
                        },
                        {
                            "id": "690460308",
                            "speaker": "胡桃",
                            "text": "心不心动？要不要来？嘻嘻，那就说定咯。"
                        }
                    ]
                },
                {
                    "id": "690460309",
                    "text": "想听听你的最新作品。",
                    "response": [
                        {
                            "id": "690460310",
                            "speaker": "胡桃",
                            "text": "打油诗对吧？咳咳，许久未在人前大显身手，你等，洗耳恭听！"
                        },
                        {
                            "id": "690460311",
                            "speaker": "胡桃",
                            "text": "「树上两只鸟儿，鸟爪逮着鼠儿，鼠儿吃了芽儿，芽儿拖着豆儿。」"
                        },
                        {
                            "id": "690460312",
                            "speaker": "胡桃",
                            "text": "如何？给点反馈吧。"
                        },
                        {
                            "id": "690460313",
                            "speaker": "Player",
                            "text": "文采斐然，不愧是你。"
                        },
                        {
                            "id": "690460314",
                            "speaker": "胡桃",
                            "text": "对吧？就知道你是个有眼光的人，懂得欣赏本堂主的诗歌。"
                        },
                        {
                            "id": "690460315",
                            "speaker": "胡桃",
                            "text": "你啊，真是个叫人开心的好朋友！"
                        }
                    ]
                }
            ]
        }
    ]
}