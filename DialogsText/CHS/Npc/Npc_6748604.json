    "dialogues": [
        {
            "id": "674860401",
            "speaker": "Player",
            "text": "这里看上去很安全…"
        },
        {
            "id": "674860402",
            "speaker": "巴热诺夫",
            "text": "这叫防患于未然，旅客。"
        },
        {
            "id": "674860403",
            "speaker": "巴热诺夫",
            "text": "要知道，宁静的雪山会在人们意料不到的时刻开始崩塌，没有波纹的水面也有可能骤然掀起海啸。"
        },
        {
            "id": "674860404",
            "speaker": "巴热诺夫",
            "text": "越是平静的地方，越有可能暗流涌动，危机四伏。所以，我们必须始终保持警惕。"
        }
    ]
}