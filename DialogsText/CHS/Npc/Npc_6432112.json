    "dialogues": [
        {
            "id": "643211201",
            "speaker": "Player",
            "text": "关于拉娜…"
        },
        {
            "id": "643211202",
            "speaker": "阿玛兹亚",
            "text": "拉娜啊，她突然回来，说着「要跟一个很重要、很重要的朋友去旅行」…"
        },
        {
            "id": "643211203",
            "speaker": "阿玛兹亚",
            "text": "听得出来，这孩子的语气非常认真…只有旅行过的人才能明白旅行的意义，希望她能得到自己想要的东西吧…"
        }
    ]
}