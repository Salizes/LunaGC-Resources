{
    "talkId": "6158702",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "蒂玛乌斯": 12
    },
    "dialogues": [
        {
            "id": "615870201",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "615870202",
            "speaker": "蒂玛乌斯",
            "text": "我叫蒂玛乌斯，是蒙德的炼金学者，可能你没有听过我的名字…"
        },
        {
            "id": "615870203",
            "speaker": "蒂玛乌斯",
            "text": "但对阿贝多和砂糖这两个名字，你一定有所耳闻吧。"
        },
        {
            "id": "615870204",
            "speaker": "蒂玛乌斯",
            "text": "阿贝多是难得一见的炼金天才，还有他的助手砂糖，年纪轻轻也有不错的造诣。"
        },
        {
            "id": "615870205",
            "speaker": "蒂玛乌斯",
            "text": "和他们相比起来，我只是会一些雕虫小技罢了。",
            "choices": [
                {
                    "id": "615870206",
                    "text": "关于阿贝多…",
                    "response": [
                        {
                            "id": "615870207",
                            "speaker": "蒂玛乌斯",
                            "text": "阿贝多是被人们称为「白垩之子」的天才，蒙德首屈一指的炼金大师。"
                        },
                        {
                            "id": "615870208",
                            "speaker": "蒂玛乌斯",
                            "text": "据说忽然有一天从国外来到蒙德，并迅速被骑士团接纳为「首席炼金术士」，还兼任了调查小队队长。"
                        },
                        {
                            "id": "615870209",
                            "speaker": "蒂玛乌斯",
                            "text": "…他的炼金理论就当前的学术发展而言，简直像天马行空一样，却又在实践中可以处处得到证实。"
                        },
                        {
                            "id": "615870210",
                            "speaker": "蒂玛乌斯",
                            "text": "在他眼里，我的研究恐怕就像小孩子在摆弄玩具吧，唉…"
                        }
                    ]
                },
                {
                    "id": "615870211",
                    "text": "关于砂糖…",
                    "response": [
                        {
                            "id": "615870212",
                            "speaker": "蒂玛乌斯",
                            "text": "砂糖小姐是阿贝多唯一的助手，能被阿贝多赏识可真是个幸运的孩子。"
                        },
                        {
                            "id": "615870213",
                            "speaker": "蒂玛乌斯",
                            "text": "作为土生土长的蒙德人，砂糖小姐在炼金方面的贡献值得我们自豪…"
                        },
                        {
                            "id": "615870214",
                            "speaker": "蒂玛乌斯",
                            "text": "可是她的研究方向和兴趣上都有些…古怪，以致于能够真正应用的成果少之又少。"
                        },
                        {
                            "id": "615870215",
                            "speaker": "蒂玛乌斯",
                            "text": "唉，如果我能有那么好的研究资源的话，究竟又会如何呢…"
                        }
                    ]
                }
            ]
        }
    ]
}