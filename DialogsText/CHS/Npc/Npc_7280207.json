{
    "talkId": "7280207",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 5,
        "竺子": 19
    },
    "dialogues": [
        {
            "id": "728020701",
            "speaker": "竺子",
            "text": "不知道妈妈的身体怎么样了，还有爸爸…"
        },
        {
            "id": "728020702",
            "speaker": "竺子",
            "text": "咦？旅行者？你怎么来了，我记得上次你来问我前往稻妻的方法…"
        },
        {
            "id": "728020703",
            "speaker": "Player",
            "text": "已经去过稻妻了。"
        },
        {
            "id": "728020704",
            "speaker": "竺子",
            "text": "居、居然真的过去了，而且还能回来…"
        },
        {
            "id": "728020705",
            "speaker": "竺子",
            "text": "不愧是名扬四方的勇士，各方面的本领都不是我这种普通人能企及的。"
        },
        {
            "id": "728020706",
            "speaker": "竺子",
            "text": "对、对了！如果可以的话，能不能请你帮我一个忙？",
            "choices": [
                {
                    "id": "728020707",
                    "text": "怎么了？",
                    "response": [
                        {
                            "id": "728020709",
                            "speaker": "竺子",
                            "text": "说起来，当初我离开稻妻的时候，是不辞而别。"
                        },
                        {
                            "id": "728020710",
                            "speaker": "竺子",
                            "text": "我从小就向往稻妻之外的广阔世界，喜欢到处游历，不喜欢受父母管束。"
                        },
                        {
                            "id": "728020711",
                            "speaker": "竺子",
                            "text": "眼狩令颁布后，稻妻的气氛变得越来越压抑，我这才临时起意，离开了家乡。"
                        },
                        {
                            "id": "728020712",
                            "speaker": "竺子",
                            "text": "虽然来了璃月之后，我勉强找到了维生的办法，但却找不到可靠的人帮着给家里捎信报平安。"
                        },
                        {
                            "id": "728020713",
                            "speaker": "竺子",
                            "text": "如果你愿意的话，我能请你帮忙把家书带给父母吗？",
                            "choices": [
                                {
                                    "id": "728020714",
                                    "text": "交给我吧。",
                                    "response": [
                                        {
                                            "id": "728020715",
                                            "speaker": "竺子",
                                            "text": "谢谢你！那么，送信的事就拜托你啦。"
                                        },
                                        {
                                            "id": "728020720",
                                            "speaker": "竺子",
                                            "text": "对了，我的父亲叫做「曜」，我的母亲叫做「满」，至于住址，我帮你标记在地图上吧。"
                                        },
                                        {
                                            "id": "728020721",
                                            "speaker": "竺子",
                                            "text": "离开家乡之后，我经历了许多，如今的我深知，想要成长为独立坚强的女性，总像以前那样依赖父母是不行的。"
                                        },
                                        {
                                            "id": "728020722",
                                            "speaker": "竺子",
                                            "text": "我已经决定了，短期内不会归乡。如果在外遇到困难的话，我会靠自己勇敢面对。"
                                        },
                                        {
                                            "id": "728020723",
                                            "speaker": "竺子",
                                            "text": "做到这一点的话，远方的爸爸妈妈，也会以我为傲吧。"
                                        },
                                        {
                                            "id": "728020724",
                                            "speaker": "竺子",
                                            "text": "我把这份决心也写在了家书里，就麻烦你把它带回我父母身边了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "728020716",
                                    "text": "你想回去看看吗？",
                                    "response": [
                                        {
                                            "id": "728020717",
                                            "speaker": "竺子",
                                            "text": "虽然我惦念父母，但我在璃月还有一些事情要处理…"
                                        },
                                        {
                                            "id": "728020718",
                                            "speaker": "竺子",
                                            "text": "我可没有像你这样来去自由的本事，所以我现在也是有心无力。"
                                        },
                                        {
                                            "id": "728020719",
                                            "speaker": "竺子",
                                            "text": "只要你能帮我把这封信捎去稻妻，我就满足了，至于其他…就之后再说吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "728020708",
                    "text": "有什么烦恼的事吗？"
                }
            ]
        }
    ]
}