    "dialogues": [
        {
            "id": "620030701",
            "speaker": "Player",
            "text": "关于慧心…"
        },
        {
            "id": "620030702",
            "speaker": "天叔",
            "text": "哈哈，小女承蒙照顾了。"
        },
        {
            "id": "620030703",
            "speaker": "天叔",
            "text": "她脾气很执拗，只有甘雨姐姐…啊不，甘雨小姐的话才能听得进去。"
        },
        {
            "id": "620030704",
            "speaker": "天叔",
            "text": "可自从上次的事之后，她好像乐意接受我这个老头子的建议了…"
        },
        {
            "id": "620030705",
            "speaker": "天叔",
            "text": "…你们的手腕也还挺不错的。"
        }
    ]
}