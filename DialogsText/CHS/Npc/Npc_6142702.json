{
    "talkId": "6142702",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 3,
        "唐娜": 15
    },
    "dialogues": [
        {
            "id": "4015142702",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "4015142706",
            "speaker": "唐娜",
            "text": "欸？！"
        },
        {
            "id": "4015142707",
            "speaker": "唐娜",
            "text": "我…我是这家花店的帮工。只是一个…普普通通的女孩子。"
        },
        {
            "id": "4015142708",
            "speaker": "唐娜",
            "text": "（啊，我是不是脸红了。）"
        },
        {
            "id": "4015142709",
            "speaker": "唐娜",
            "text": "（刚刚幻想着迪卢克大人送我花的事情，是不是已经被发现了…）"
        },
        {
            "id": "4015142710",
            "speaker": "唐娜",
            "text": "啊…请不要那样看着我，真的没有什么特别的。",
            "choices": [
                {
                    "id": "4015142703",
                    "text": "迪卢克？",
                    "response": [
                        {
                            "id": "4015142711",
                            "speaker": "唐娜",
                            "text": "啊，我…不小心，说出口了？"
                        },
                        {
                            "id": "4015142712",
                            "speaker": "唐娜",
                            "text": "对不起…"
                        },
                        {
                            "id": "4015142713",
                            "speaker": "唐娜",
                            "text": "我一直想着能够在这里偶遇迪卢克大人的事情，不自觉就…唔！"
                        },
                        {
                            "id": "4015142714",
                            "speaker": "唐娜",
                            "text": "不，我没有…"
                        },
                        {
                            "id": "4015142715",
                            "speaker": "唐娜",
                            "text": "（呜呜，怎么办，真的好喜欢迪卢克大人啊。）"
                        }
                    ]
                },
                {
                    "id": "4015142704",
                    "text": "月亮派？",
                    "response": [
                        {
                            "id": "4015142716",
                            "speaker": "唐娜",
                            "text": "您是问…月亮派吗。"
                        },
                        {
                            "id": "4015142717",
                            "speaker": "唐娜",
                            "text": "这是蒙德城很有名的特产，是一种扎实又香甜的肉派。"
                        },
                        {
                            "id": "4015142718",
                            "speaker": "唐娜",
                            "text": "（要是我做了好吃的月亮派，送给迪卢克大人的话…）"
                        },
                        {
                            "id": "4015142719",
                            "speaker": "唐娜",
                            "text": "（快，快打住啊唐娜！）"
                        },
                        {
                            "id": "4015142720",
                            "speaker": "唐娜",
                            "text": "要要要是有机会，推荐您一定去店里尝一尝。"
                        }
                    ]
                }
            ]
        }
    ]
}