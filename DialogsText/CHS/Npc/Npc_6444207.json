    "dialogues": [
        {
            "id": "644420701",
            "speaker": "Player",
            "text": "关于斯露莎…"
        },
        {
            "id": "644420702",
            "speaker": "拉沙鲁",
            "text": "为了重要的事才把我叫醒，已经原谅她了。"
        },
        {
            "id": "644420703",
            "speaker": "拉沙鲁",
            "text": "「焚真之天象」熄灭了，是斯露莎…和大家的功劳。"
        },
        {
            "id": "644420704",
            "speaker": "拉沙鲁",
            "text": "虽然应该和她自己预想的情况不同，但一定是现在这样更好。"
        }
    ]
}