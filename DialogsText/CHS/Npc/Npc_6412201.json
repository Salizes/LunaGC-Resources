{
    "talkId": "6412201",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "玛塔莉": 3,
        "玛希德": 4
    },
    "dialogues": [
        {
            "id": "641220101",
            "speaker": "玛希德",
            "text": "下次再有人找你换班，一定不能随便答应！"
        },
        {
            "id": "641220102",
            "speaker": "玛塔莉",
            "text": "好的，监察官大人。"
        },
        {
            "id": "641220103",
            "speaker": "玛希德",
            "text": "你们镀金旅团的人，就是在沙漠里闲散惯了，不懂得规矩的重要性！"
        },
        {
            "id": "641220104",
            "speaker": "玛希德",
            "text": "如果大家都随意调换岗位，不按照定好的计划办事，一定会造成疏漏！"
        },
        {
            "id": "641220105",
            "speaker": "玛塔莉",
            "text": "好的，您说的对。"
        },
        {
            "id": "641220106",
            "speaker": "玛希德",
            "text": "虽然你是教令院从外面雇来的佣兵，但你的工作也是维持港口秩序的一部分，和学者们一样十分重要，懂了吗！"
        },
        {
            "id": "641220107",
            "speaker": "玛塔莉",
            "text": "好的，我明白了。"
        }
    ]
}