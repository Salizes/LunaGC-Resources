    "speaker_counts": {
        "Player": 1,
        "若心": 4
    },
    "dialogues": [
        {
            "id": "623060301",
            "speaker": "Player",
            "text": "关于过去…"
        },
        {
            "id": "623060302",
            "speaker": "若心",
            "text": "其实我很希望能出生长大在这里而不是璃月港，那样我会有更平淡但是更幸福的一辈子吧。"
        },
        {
            "id": "623060303",
            "speaker": "若心",
            "text": "我曾经是和裕茶馆的戏子，有着光鲜的生活，但戏子总归是戏子，没什么是真实的。"
        },
        {
            "id": "623060304",
            "speaker": "若心",
            "text": "当初和「他」一同幻想过这样的乡野生活，虽没有什么山珍海味和雕梁画栋，但一切都是那么真挚和友善。"
        },
        {
            "id": "623060305",
            "speaker": "若心",
            "text": "现在看来果然是对的。"
        }
    ]
}