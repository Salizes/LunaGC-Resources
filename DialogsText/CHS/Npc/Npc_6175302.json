{
    "talkId": "6175302",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "埃尔西": 8
    },
    "dialogues": [
        {
            "id": "617530201",
            "speaker": "Player",
            "text": "新作？"
        },
        {
            "id": "617530202",
            "speaker": "埃尔西",
            "text": "哼哼，没错！作为提瓦特除了巴巴托斯大人以外最最伟大的吟游诗人，本小姐正在创作一部巨作！"
        },
        {
            "id": "617530203",
            "speaker": "埃尔西",
            "text": "虽然还没完成，但先唱给你听也不是不可以喔？毕竟你是帮我搜集灵感的大恩人嘛！",
            "choices": [
                {
                    "id": "617530204",
                    "text": "请便。",
                    "response": [
                        {
                            "id": "617530205",
                            "speaker": "埃尔西",
                            "text": "咳咳…那我就开始啦！先唱一部分！"
                        },
                        {
                            "id": "617530206",
                            "speaker": "埃尔西",
                            "text": "「…北风吹，北风吹，北风吹完西风吹；西风吹，西风吹，西风吹完南风吹…」"
                        },
                        {
                            "id": "617530207",
                            "speaker": "埃尔西",
                            "text": "「…吹来吹去还在吹，不知骑士几时归？不知骑士几时归，不如坐下喝一杯…」",
                            "choices": [
                                {
                                    "id": "617530208",
                                    "text": "好！当饮一杯！",
                                    "response": [
                                        {
                                            "id": "617530209",
                                            "speaker": "埃尔西",
                                            "text": "嘿嘿，你很懂嘛！不过喝酒的事情就先留到以后，等本小姐星夜写完，再痛饮完工酒！"
                                        }
                                    ]
                                },
                                {
                                    "id": "617530210",
                                    "text": "好水的词儿…",
                                    "response": [
                                        {
                                            "id": "617530211",
                                            "speaker": "埃尔西",
                                            "text": "这、这是艺术啦！真是的，璃月人也说「曲高和寡」，就是这样没错！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "617530212",
                    "text": "抱歉，我还有事。",
                    "response": [
                        {
                            "id": "617530213",
                            "speaker": "埃尔西",
                            "text": "呜啊…好吧，没关系！等本小姐星夜写完，你就能在全提瓦特的酒馆中听到这旋律啦！"
                        }
                    ]
                }
            ]
        }
    ]
}