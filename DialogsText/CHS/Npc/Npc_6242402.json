{
    "talkId": "6242402",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "楚婆婆": 12
    },
    "dialogues": [
        {
            "id": "624240201",
            "speaker": "Player",
            "text": "我没听到其他人讲话…"
        },
        {
            "id": "624240202",
            "speaker": "楚婆婆",
            "text": "呵呵…我一开始的时候也是听不到的。"
        },
        {
            "id": "624240203",
            "speaker": "楚婆婆",
            "text": "可是几十年过去了，我的耳朵也越来越不灵了，但最近却开始能够听到「他」了…"
        },
        {
            "id": "624240204",
            "speaker": "楚婆婆",
            "text": "那个传说是真的，太好了，不枉我守在这里这么多年。",
            "choices": [
                {
                    "id": "624240205",
                    "text": "「他」是谁？",
                    "response": [
                        {
                            "id": "624240206",
                            "speaker": "楚婆婆",
                            "text": "是我的丈夫，他有着古铜色的皮肤，健硕的肌肉…"
                        },
                        {
                            "id": "624240207",
                            "speaker": "楚婆婆",
                            "text": "在求婚时候却像个孩子一样，郑重其事地说要和我白头偕老，呵呵。"
                        },
                        {
                            "id": "624240208",
                            "speaker": "楚婆婆",
                            "text": "我们是在同一个渔村长大的，做的也是出海打渔的活计。"
                        },
                        {
                            "id": "624240209",
                            "speaker": "楚婆婆",
                            "text": "直到我们结婚的第四年，风暴肆虐的海上，他把我绑在破损的舢板上…"
                        },
                        {
                            "id": "624240210",
                            "speaker": "楚婆婆",
                            "text": "我漂泊了一整夜，漂到这里捡回了自己的命，却再没有机会兑现和他白头偕老的誓言…"
                        }
                    ]
                },
                {
                    "id": "624240211",
                    "text": "传说指的是…",
                    "response": [
                        {
                            "id": "624240212",
                            "speaker": "楚婆婆",
                            "text": "闭上眼睛，仔细对着海螺聆听，就可以听到来自大海的声音…你听说过吗？"
                        },
                        {
                            "id": "624240213",
                            "speaker": "楚婆婆",
                            "text": "那么我那位永远留在了大海中的丈夫…会不会为我留下了什么话语呢…"
                        },
                        {
                            "id": "624240214",
                            "speaker": "楚婆婆",
                            "text": "所以我搬到了这座海螺屋里来住，一直等待着…"
                        },
                        {
                            "id": "624240215",
                            "speaker": "楚婆婆",
                            "text": "是否有一天，能听到海浪声中夹挟着的他的声音。"
                        }
                    ]
                }
            ]
        }
    ]
}