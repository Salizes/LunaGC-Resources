    "dialogues": [
        {
            "id": "691010101",
            "speaker": "基尼奇",
            "text": "#{NICKNAME}，你来了。有事找我？"
        },
        {
            "id": "691010102",
            "speaker": "阿乔",
            "text": "吾之仆从基尼奇！来者是客，汝之言辞未免过于冷淡，有失我伟大圣龙库胡勒阿乔的颜面。"
        },
        {
            "id": "691010103",
            "speaker": "基尼奇",
            "text": "不必理会它，有事就请说吧。"
        }
    ]
