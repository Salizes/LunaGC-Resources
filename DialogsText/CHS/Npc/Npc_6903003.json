    },
    "dialogues": [
        {
            "id": "690300301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
        },
        {
            "id": "690300302",
            "speaker": "钟离",
            "text": "乐意奉陪。想聊些什么？"
        },
        {
            "id": "690300303",
            "speaker": "Player",
            "text": "想听你说些从前的事。"
        },
        {
            "id": "690300304",
            "speaker": "钟离",
            "text": "从前的事啊…那就得找个闲暇日子慢慢说了。"
        },
        {
            "id": "690300305",
            "speaker": "钟离",
            "text": "千年的故事，一时半会儿可说不完。"
        },
        {
            "id": "690300306",
            "speaker": "钟离",
            "text": "想听得舒服，还需要一壶好茶、两把好椅子、一处好庭院。"
        },
        {
            "id": "690300307",
            "speaker": "Player",
            "text": "居然还要准备院子吗？"
        },
        {
            "id": "690300308",
            "speaker": "钟离",
            "text": "哈哈，怎么会呢？这里就好，我们坐下慢慢聊。"
        }
    ]
}