{
    "talkId": "6900904",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "久岐忍": 18
    },
    "dialogues": [
        {
            "id": "690090401",
            "speaker": "Player",
            "text": "有什么想做的吗？"
        },
        {
            "id": "690090402",
            "speaker": "久岐忍",
            "text": "嗯，有件事想托你帮忙，而且非你不可。"
        },
        {
            "id": "690090403",
            "speaker": "久岐忍",
            "text": "我正在做「移居置业企划」…"
        },
        {
            "id": "690090404",
            "speaker": "久岐忍",
            "text": "不同国家关于外来务工人员的置业政策我是了解的，但人文情况就不太清楚了…"
        },
        {
            "id": "690090405",
            "speaker": "久岐忍",
            "text": "在不同地区生活要注意什么，有什么帮派组织和地方势力？"
        },
        {
            "id": "690090406",
            "speaker": "久岐忍",
            "text": "你去过的地方多，能帮忙给点建议吗？",
            "choices": [
                {
                    "id": "690090407",
                    "text": "等等…",
                    "response": [
                        {
                            "id": "690090409",
                            "speaker": "久岐忍",
                            "text": "哈？！怎么可能！这不关荒泷派什么事。"
                        },
                        {
                            "id": "690090410",
                            "speaker": "久岐忍",
                            "text": "我只是帮客户做「移民企划书」而已，顺便还要出差几天。"
                        },
                        {
                            "id": "690090411",
                            "speaker": "久岐忍",
                            "text": "至于那群家伙…我倒是在准备「荒泷派生存与生活百宝书」，进展还行…"
                        },
                        {
                            "id": "690090412",
                            "speaker": "久岐忍",
                            "text": "你看，那些笨蛋个个心地不坏，却经常惹是生非。"
                        },
                        {
                            "id": "690090413",
                            "speaker": "久岐忍",
                            "text": "我也不能时时刻刻蹲守在他们身边，从长远来看，总得想点办法。",
                            "choices": [
                                {
                                    "id": "690090414",
                                    "text": "阿忍不会准备离开荒泷派吧？",
                                    "response": [
                                        {
                                            "id": "690090415",
                                            "speaker": "久岐忍",
                                            "text": "那当然不会，起码也不是现在。作为实际管事人，我还没打造出令我自己满意的荒泷派呢，不能半途而废。"
                                        },
                                        {
                                            "id": "690090416",
                                            "speaker": "久岐忍",
                                            "text": "至于以后的事情，谁都说不准吧。"
                                        },
                                        {
                                            "id": "690090417",
                                            "speaker": "久岐忍",
                                            "text": "要是以后真的走到这一步，大家不得不分开，也只能说是人之常情…"
                                        },
                                        {
                                            "id": "690090422",
                                            "speaker": "久岐忍",
                                            "text": "只要大家都在为各自的人生努力，不管要走向哪个方向，都是值得祝福的。"
                                        },
                                        {
                                            "id": "690090423",
                                            "speaker": "久岐忍",
                                            "text": "就像荒泷派和我，就像我和你。无论将来身处何地，在不在一起，都会支持彼此，你说是吗？"
                                        }
                                    ]
                                },
                                {
                                    "id": "690090418",
                                    "text": "不管阿忍做什么我都会支持！",
                                    "response": [
                                        {
                                            "id": "690090419",
                                            "speaker": "久岐忍",
                                            "text": "这可是你说的，口头约定同样具有律法效力。"
                                        },
                                        {
                                            "id": "690090420",
                                            "speaker": "久岐忍",
                                            "text": "要是我以后离开荒泷派，转而投奔你的时候，你可不能拒绝。嗯…阿圆作证。"
                                        },
                                        {
                                            "id": "690090421",
                                            "speaker": "久岐忍",
                                            "text": "呵呵，不过可惜。我不想投靠任何人，这不符合我的个性。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690090408",
                    "text": "你要带荒泷派跑路吗…"
                }
            ]
        }
    ]
}