        {
            "id": "670000401",
            "speaker": "Player",
            "text": "你好，凯瑟琳。"
        },
        {
            "id": "670000402",
            "speaker": "凯瑟琳",
            "text": "很高兴见到你。"
        },
        {
            "id": "670000403",
            "speaker": "凯瑟琳",
            "text": "我是冒险家协会的接待员凯瑟琳，负责为冒险家们提供任务发布和情报支援工作。"
        },
        {
            "id": "670000404",
            "speaker": "凯瑟琳",
            "text": "挪德卡莱边疆区是一片充满机遇的土地，希望你在这里也能经历令人兴奋的冒险。"
        }
    ]
