    "dialogues": [
        {
            "id": "670650401",
            "speaker": "Player",
            "text": "倒也没有想掌控世界…"
        },
        {
            "id": "670650402",
            "speaker": "泽伊采娃",
            "text": "我明白的。光是跟那些没品味的家伙解释「什么才是美」就很累了。"
        },
        {
            "id": "670650403",
            "speaker": "泽伊采娃",
            "text": "要是爱诺的艺术真的被那种随大流的人追捧起来…啊，好可怕！真正的艺术，果然还是应该留给像我们这样的人悄悄欣赏才是。"
        }
    ]
}