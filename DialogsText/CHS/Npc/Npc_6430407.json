    "dialogues": [
        {
            "id": "643040701",
            "speaker": "Player",
            "text": "须弥发生了什么吗？"
        },
        {
            "id": "643040702",
            "speaker": "基翁",
            "text": "虽然我只是个眼瞎的老人，但也能听出，最近似乎发生了好事情哦。"
        },
        {
            "id": "643040703",
            "speaker": "基翁",
            "text": "「虚空」关闭了之后，连林中飞翔的鸟儿都变多了…"
        },
        {
            "id": "643040704",
            "speaker": "基翁",
            "text": "正是这种时候，才更需要你们这样的年轻人啊。"
        }
    ]
}