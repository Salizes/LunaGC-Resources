{
    "talkId": "6903709",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 5,
        "甘雨": 7
    },
    "dialogues": [
        {
            "id": "690370901",
            "speaker": "Player",
            "text": "在这里还习惯吗？"
        },
        {
            "id": "690370202",
            "speaker": "甘雨",
            "text": "嗯，我认为这里是个非常美丽的地方。"
        },
        {
            "id": "690370203",
            "speaker": "甘雨",
            "text": "那么大的地方布置起来一定很不容易，劳你费心了。",
            "choices": [
                {
                    "id": "690370204",
                    "text": "客气了。",
                    "response": [
                        {
                            "id": "690370206",
                            "speaker": "甘雨",
                            "text": "闲暇的时候，我特别喜欢在室外静静地散步。"
                        },
                        {
                            "id": "690370207",
                            "speaker": "甘雨",
                            "text": "就算到了午休时间，睡午觉也非常安全。",
                            "choices": [
                                {
                                    "id": "690370208",
                                    "text": "安全性的确可以放心…",
                                    "response": [
                                        {
                                            "id": "690370209",
                                            "speaker": "甘雨",
                                            "text": "嗯。所以我更加喜欢这里了。"
                                        },
                                        {
                                            "id": "690370212",
                                            "speaker": "甘雨",
                                            "text": "总之…谢谢你！"
                                        }
                                    ]
                                },
                                {
                                    "id": "690370210",
                                    "text": "要注意别着凉哦…",
                                    "response": [
                                        {
                                            "id": "690370211",
                                            "speaker": "甘雨",
                                            "text": "请放心，我千年以来都是这样入睡的。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "690370205",
                    "text": "甘雨喜欢就好。"
                }
            ]
        }
    ]
}