{
    "talkId": "1600329",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 2,
        "派蒙": 8,
        "预言女巫": 5
    },
    "dialogues": [
        {
            "id": "160032901",
            "speaker": "派蒙",
            "text": "哦？莫娜的老师…不对，预言女巫还在这里。"
        },
        {
            "id": "160032902",
            "speaker": "预言女巫",
            "text": "是谁在打扰我观测星辰？"
        },
        {
            "id": "160032903",
            "speaker": "派蒙",
            "text": "呀！"
        },
        {
            "id": "160032904",
            "speaker": "Player",
            "text": "看来她的思绪回来了。"
        },
        {
            "id": "160032905",
            "speaker": "派蒙",
            "text": "哦，机会难得，要不我们也让预言女巫帮我们占卜一下未来？按照这本书里的说法，她的预言非常准…"
        },
        {
            "id": "160032906",
            "speaker": "派蒙",
            "text": "不过，要怎样才能让她为我们占卜呢？"
        },
        {
            "id": "160032907",
            "speaker": "Player",
            "text": "付钱？"
        },
        {
            "id": "160032908",
            "speaker": "预言女巫",
            "text": "放肆，你们以为我的占卜是在卖艺？"
        },
        {
            "id": "160032909",
            "speaker": "派蒙",
            "text": "抱歉！其实我只是好奇有多准…"
        },
        {
            "id": "160032910",
            "speaker": "预言女巫",
            "text": "哼，就让你们见识一下能够解读星辰的智慧吧。银色的精灵，上前来，让我看看你的命运。"
        },
        {
            "id": "160032911",
            "speaker": "派蒙",
            "text": "哦…"
        },
        {
            "id": "160032912",
            "speaker": "预言女巫",
            "text": "嗯…你竟然也想知道自己的命运？"
        },
        {
            "id": "160032913",
            "speaker": "派蒙",
            "text": "所以，是好是坏？"
        },
        {
            "id": "160032914",
            "speaker": "预言女巫",
            "text": "……"
        },
        {
            "id": "160032915",
            "speaker": "派蒙",
            "text": "又不说话了！"
        }
    ]
}