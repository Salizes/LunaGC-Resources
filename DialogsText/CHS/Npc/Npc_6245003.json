    "dialogues": [
        {
            "id": "624500301",
            "speaker": "Player",
            "text": "珠钿舫？"
        },
        {
            "id": "624500302",
            "speaker": "平海",
            "text": "嗯…你不知道也很正常。"
        },
        {
            "id": "624500303",
            "speaker": "平海",
            "text": "那里是璃月港的有钱老爷们消遣的地方，可不是一般平头老百姓可以进出的。"
        },
        {
            "id": "624500304",
            "speaker": "平海",
            "text": "而且如果不是「贵客」，普通人就算过去了也就只能看个热闹…"
        },
        {
            "id": "624500305",
            "speaker": "平海",
            "text": "…就说这么多，没事就别浪费我的时间了。"
        }
    ]
}