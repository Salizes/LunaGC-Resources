    "talks": [
        {
            "talkId": "6865002",
            "initDialog": "686500201",
            "dialogues": [
                {
                    "id": "686500201",
                    "speaker": "？？？",
                    "text": "看在厄歌莉娅的份上，薇恩狄娅，我真要写不完了！你就不能去烦卡塞留斯或者克莱兰德吗？！"
                }
            ]
        },
        {
            "talkId": "6865003",
            "initDialog": "686500301",
            "dialogues": [
                {
                    "id": "686500301",
                    "speaker": "？？？",
                    "text": "「莱缪尔医生假装成蒙德人，觐见稻妻将军，最后得到将军的协助，搭上社奉行的船回到荆夫港」…"
                },
                {
                    "id": "686500302",
                    "speaker": "？？？",
                    "text": "该死的，这整段和前后的剧情都完全不挨着！唯一能用的只有这个在稻妻召唤出历史上英雄们的亡灵、让他们互殴的点子…"
                }
            ]
        },
        {
            "talkId": "6865004",
            "initDialog": "686500401",
            "dialogues": [
                {
                    "id": "686500401",
                    "speaker": "？？？",
                    "text": "薇恩杜洁妮妲·德·乌塞洛布罗吉！我求求你不要再敲了！我在写作！"
                },
                {
                    "id": "686500402",
                    "speaker": "？？？",
                    "text": "看在随便什么东西的份上，拿着这些去找希尔妲多办点茶会，好吗？！"
                }
            ]
        }
    ]
}