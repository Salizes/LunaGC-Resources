    "talks": [
        {
            "talkId": "6800390",
            "initDialog": "680039001",
            "dialogues": [
                {
                    "id": "680039001",
                    "speaker": "见习地窖守卫鸦",
                    "text": "嘿！有段时间没见了，还记得我吗，我是之前在电梯里睡着，藏在地窖里的夜鸦啊…现在我也是夜鸦守卫啦！"
                },
                {
                    "id": "680039002",
                    "speaker": "见习地窖守卫鸦",
                    "text": "现在正跟着哥哥一起，守卫城堡的地窖…对了，这是我的一点小心意，上次你没有告诉别人我藏在地窖里，真是太感谢了！"
                }
            ]
        },
        {
            "talkId": "6800391",
            "initDialog": "680039101",
            "dialogues": [
                {
                    "id": "680039101",
                    "speaker": "见习地窖守卫鸦",
                    "text": "所有的努力和辛苦都是值得的，现在我也和哥哥一样，是光荣的夜鸦守卫的一员了。"
                }
            ]
        }
    ]
}