    "talks": [
        {
            "talkId": "6867204",
            "initDialog": "686720401",
            "dialogues": [
                {
                    "id": "686720401",
                    "speaker": "望月者号日志",
                    "text": "「…它是一颗星星的坠落…」"
                },
                {
                    "id": "686720402",
                    "speaker": "望月者号日志",
                    "text": "「…它是一颗星星的魂魄…」"
                },
                {
                    "id": "686720403",
                    "speaker": "望月者号日志",
                    "text": "「…它呼唤我…像肉汤呼唤餐桌…」"
                },
                {
                    "id": "686720404",
                    "speaker": "望月者号日志",
                    "text": "「…啊，我听见了，索卢格之王啊，伊纳古雷啊，你已被漆黑吞没…」"
                },
                {
                    "id": "686720405",
                    "speaker": "望月者号日志",
                    "text": "「…那么带上讯息走吧…」"
                },
                {
                    "id": "686720406",
                    "speaker": "望月者号日志",
                    "text": "「…巴·乌鲁·纳姆·乌吉恩·黑体…」"
                },
                {
                    "id": "686720407",
                    "speaker": "望月者号日志",
                    "text": "「…是你也是我…」"
                }
            ]
        }
    ]
}