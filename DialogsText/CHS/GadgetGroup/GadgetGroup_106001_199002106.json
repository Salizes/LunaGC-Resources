{
    "groupId": "106001_199002106",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "夜鸦乘务员": 12
    },
    "talks": [
        {
            "talkId": "6800312",
            "initDialog": "680031201",
            "dialogues": [
                {
                    "id": "680031201",
                    "speaker": "夜鸦乘务员",
                    "text": "哦哦，客人，这里是夜鸦航线…"
                },
                {
                    "id": "680031202",
                    "speaker": "夜鸦乘务员",
                    "text": "嗯？您不知道夜鸦航线为何物吗？那就让在下为您进行说明"
                },
                {
                    "id": "680031203",
                    "speaker": "夜鸦乘务员",
                    "text": "夜鸦们聆听皇女之谕旨往返城堡，而城堡建于高耸崖壁之上，殊为不易，于是便专门开通的风之航路。"
                },
                {
                    "id": "680031204",
                    "speaker": "夜鸦乘务员",
                    "text": "当然了，不仅夜鸦可以使用，您也可以进行航线的定制…不过，需要皇女亲笔的「邃羽夜巡之契」…"
                }
            ]
        },
        {
            "talkId": "6800313",
            "initDialog": "680031301",
            "dialogues": [
                {
                    "id": "680031301",
                    "speaker": "夜鸦乘务员",
                    "text": "客人，如何，您有「邃羽夜巡之契」吗…"
                },
                {
                    "id": "680031302",
                    "speaker": "夜鸦乘务员",
                    "text": "如果您想开通此站点的通行权限，那就将「邃羽夜巡之契」交予我吧。"
                }
            ]
        },
        {
            "talkId": "6800325",
            "initDialog": "680032501",
            "dialogues": [
                {
                    "id": "680032501",
                    "speaker": "夜鸦乘务员",
                    "text": "哦哦，这的确是，这的确就是皇女亲笔的「邃羽夜巡之契」！"
                },
                {
                    "id": "680032502",
                    "speaker": "夜鸦乘务员",
                    "text": "这优雅的字迹和高贵的遣词，哦，客人，我现在就为您开通此站点的权限！"
                }
            ]
        },
        {
            "talkId": "6800328",
            "initDialog": "680032801",
            "dialogues": [
                {
                    "id": "680032801",
                    "speaker": "夜鸦乘务员",
                    "text": "客人，欢迎使用夜鸦航线，请问您想前往哪一个站点？"
                }
            ]
        },
        {
            "talkId": "6800329",
            "initDialog": "680032901",
            "dialogues": [
                {
                    "id": "680032901",
                    "speaker": "Player",
                    "text": "通往半山站点"
                }
            ]
        },
        {
            "talkId": "6800330",
            "initDialog": "680033001",
            "dialogues": [
                {
                    "id": "680033001",
                    "speaker": "Player",
                    "text": "通往城堡瞭望台站点"
                }
            ]
        },
        {
            "talkId": "6800331",
            "initDialog": "680033101",
            "dialogues": [
                {
                    "id": "680033101",
                    "speaker": "夜鸦乘务员",
                    "text": "好的，请往前走，注意安全，祝您旅途愉快。"
                }
            ]
        },
        {
            "talkId": "6800332",
            "initDialog": "680033201",
            "dialogues": [
                {
                    "id": "680033201",
                    "speaker": "夜鸦乘务员",
                    "text": "好的，请往前走，注意安全，祝您旅途愉快。"
                }
            ]
        },
        {
            "talkId": "6800333",
            "initDialog": "680033301",
            "dialogues": [
                {
                    "id": "680033301",
                    "speaker": "Player",
                    "text": "不，暂时没这个需要。"
                }
            ]
        },
        {
            "talkId": "6800334",
            "initDialog": "680033401",
            "dialogues": [
                {
                    "id": "680033401",
                    "speaker": "夜鸦乘务员",
                    "text": "好的，客人，如果有需要的话，请尽情跟我说。"
                }
            ]
        }
    ]
}