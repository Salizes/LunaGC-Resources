    "talks": [
        {
            "talkId": "6861400",
            "initDialog": "686140001",
            "dialogues": [
                {
                    "id": "686140001",
                    "speaker": "选手休息室公告",
                    "text": "请各位选手严格遵守竞技规则，共同维护每场赛事的公正性！"
                },
                {
                    "id": "686140002",
                    "speaker": "选手休息室公告",
                    "text": "此外，在此等待通知时，请保持耐心，切勿大声喧哗。"
                }
            ]
        },
        {
            "talkId": "6861401",
            "initDialog": "686140101",
            "dialogues": [
                {
                    "id": "686140101",
                    "speaker": "Player",
                    "text": "继续阅读"
                }
            ]
        },
        {
            "talkId": "6861402",
            "initDialog": "686140201",
            "dialogues": [
                {
                    "id": "686140201",
                    "speaker": "Player",
                    "text": "离开"
                }
            ]
        },
        {
            "talkId": "6861403",
            "initDialog": "686140301",
            "dialogues": [
                {
                    "id": "686140301",
                    "speaker": "竞技规则",
                    "text": "请注意，无论参与「归火圣夜巡礼」还是其他竞技赛事，选手们进行对抗时，都仅能使用报名时登记在案的武器与道具。"
                },
                {
                    "id": "686140302",
                    "speaker": "竞技规则",
                    "text": "正式比赛中，选手需要在上台前接受基本的安全检查。"
                },
                {
                    "id": "686140303",
                    "speaker": "竞技规则",
                    "text": "若是在场上展现未经登记的武器与道具，将被判为输掉比赛，并需接受调查…"
                }
            ]
        },
        {
            "talkId": "6861404",
            "initDialog": "686140401",
            "dialogues": [
                {
                    "id": "686140401",
                    "speaker": "竞技规则",
                    "text": "上台比赛前，请各位选手谨慎评估自身的健康状态，切忌强行登台竞技。"
                },
                {
                    "id": "686140402",
                    "speaker": "竞技规则",
                    "text": "如遇身体不适，请及时向管理员反馈，以便我们尽早更改相关赛事的时间安排…"
                }
            ]
        },
        {
            "talkId": "6861405",
            "initDialog": "686140501",
            "dialogues": [
                {
                    "id": "686140501",
                    "speaker": "竞技规则",
                    "text": "比赛过程中，请各位选手务必听从裁判指示。"
                },
                {
                    "id": "686140502",
                    "speaker": "竞技规则",
                    "text": "在裁判宣布比赛开始前，以及正式确认比赛结束后，切勿进行战斗。"
                },
                {
                    "id": "686140503",
                    "speaker": "竞技规则",
                    "text": "同时，在裁判认为当前比赛出现异常，要求暂停时，请及时停止战斗，配合调查。"
                },
                {
                    "id": "686140504",
                    "speaker": "竞技规则",
                    "text": "竞技并非纷争，希望各位选手在公平公正的较量中决出胜负，点到即止…"
                }
            ]
        }
    ]
}