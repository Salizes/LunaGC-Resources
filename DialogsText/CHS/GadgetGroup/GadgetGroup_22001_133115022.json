            "dialogues": [
                {
                    "id": "684400001",
                    "speaker": "古剑士铭文·其一",
                    "text": "「…抚剑长歌去，斫龙歃血还。神光似游电，寒浪欲摧山…」"
                },
                {
                    "id": "684400003",
                    "speaker": "古剑士铭文·其一",
                    "text": "「…斩虎天衡下，刺蛟云海间。功成拂衣后，永同烟水闲…」"
                }
            ]
        }
    ]
}