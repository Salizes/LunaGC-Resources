    "talks": [
        {
            "talkId": "6834200",
            "initDialog": "683420001",
            "dialogues": [
                {
                    "id": "683420001",
                    "speaker": "无名的石碑",
                    "text": "（一尊完整的石碑，其上雕刻着无法破译的优雅文字。）"
                }
            ]
        },
        {
            "talkId": "6834300",
            "initDialog": "683430001",
            "dialogues": [
                {
                    "id": "683430001",
                    "speaker": "无名的石碑·其一",
                    "text": "「我儿基斯拉，我儿…」"
                },
                {
                    "id": "683430002",
                    "speaker": "无名的石碑·其一",
                    "text": "「基斯拉，基斯拉·帕维兹拉万，自我所出，因我而亡的孩子…」"
                },
                {
                    "id": "683430003",
                    "speaker": "无名的石碑·其一",
                    "text": "「你曾以为王权能够令人脱离奴役的枷锁，令凡人脱离诸神的藩篱…」"
                },
                {
                    "id": "683430004",
                    "speaker": "无名的石碑·其一",
                    "text": "「你曾用尖啸的机械建起齐天的宫阙，化绿洲为阡陌交通的耕地…」"
                },
                {
                    "id": "683430005",
                    "speaker": "无名的石碑·其一",
                    "text": "「但以名为自由的奴役建起的帝国，终将覆灭于同一个谎言…」"
                },
                {
                    "id": "683430006",
                    "speaker": "无名的石碑·其一",
                    "text": "「愿千百种骄傲充斥你心，直到天地翻覆，令至卑至贱者翻转到你的头上…」"
                },
                {
                    "id": "683430007",
                    "speaker": "无名的石碑·其一",
                    "text": "「到那日，奥尔玛兹的野心终得获应报。」"
                }
            ]
        }
    ]
}