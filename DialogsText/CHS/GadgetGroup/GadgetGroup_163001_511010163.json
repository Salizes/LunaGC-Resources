{
    "groupId": "163001_511010163",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "呜斯先生": 7
    },
    "talks": [
        {
            "talkId": "6850002",
            "initDialog": "685000201",
            "dialogues": [
                {
                    "id": "685000201",
                    "speaker": "呜斯先生",
                    "text": "继续前进吧，该给「过去」的故事做个了结了。",
                    "choices": [
                        {
                            "id": "685000202",
                            "text": "关于你和埃斯特…",
                            "response": [
                                {
                                    "id": "685000203",
                                    "speaker": "呜斯先生",
                                    "text": "就像你所看到的那样，他是我的朋友，也是雷穆利亚灭亡后幸存的一员。"
                                },
                                {
                                    "id": "685000204",
                                    "speaker": "呜斯先生",
                                    "text": "在后来的历史中，他跟随我一起前往新生的枫丹，并最终安息在了那里。"
                                },
                                {
                                    "id": "685000205",
                                    "speaker": "呜斯先生",
                                    "text": "泉水像对待普通枫丹人一样，回应了我们这些困于顽石中的灵魂，他也得以获得子嗣，组建家庭…"
                                },
                                {
                                    "id": "685000206",
                                    "speaker": "呜斯先生",
                                    "text": "他的血脉融入了枫丹，直到所有人都遗忘了他并非凡人。"
                                },
                                {
                                    "id": "685000207",
                                    "speaker": "呜斯先生",
                                    "text": "还算是个不错的结局，对吗？"
                                }
                            ]
                        },
                        {
                            "id": "685000208",
                            "text": "（摸一摸。）"
                        },
                        {
                            "id": "685000209",
                            "text": "没事。",
                            "response": [
                                {
                                    "id": "685000210",
                                    "speaker": "呜斯先生",
                                    "text": "好吧，有什么想知道的就来问我哦，不用客气！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}