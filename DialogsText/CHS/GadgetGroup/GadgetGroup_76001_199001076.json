            "dialogues": [
                {
                    "id": "680026201",
                    "speaker": "回声海螺",
                    "text": "「你可是我们之中获得荣誉最多的人，就不能对任务上点心吗…」"
                },
                {
                    "id": "680026202",
                    "speaker": "回声海螺",
                    "text": "「…你什么时候能意识到，荣誉，雅科夫，荣誉才是最重要的！」"
                },
                {
                    "id": "680026203",
                    "speaker": "回声海螺",
                    "text": "「叶夫卡，连累大家我很抱歉…但是我对你说的荣誉，可是半点都不在乎！」"
                }
            ]
        }
    ]
