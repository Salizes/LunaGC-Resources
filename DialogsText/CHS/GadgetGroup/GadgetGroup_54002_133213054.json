    "talks": [
        {
            "talkId": "6800402",
            "initDialog": "680040201",
            "dialogues": [
                {
                    "id": "680040201",
                    "speaker": "有相当年头的记事",
                    "text": "（似乎是最近被搜刮的愚人众翻出来的记事。因为年岁，大部分文本已经无法辨识了。）"
                },
                {
                    "id": "680040202",
                    "speaker": "有相当年头的记事",
                    "text": "「…终于造出长卷一柄。名之曰『大踏鞴长正』…」"
                },
                {
                    "id": "680040203",
                    "speaker": "有相当年头的记事",
                    "text": "「…目付大人兴致相当高昂，与造兵司佑大人…」"
                },
                {
                    "id": "680040204",
                    "speaker": "有相当年头的记事",
                    "text": "「…阿望为『大踏鞴长正』之美所服，为之绘制图画…」"
                },
                {
                    "id": "680040205",
                    "speaker": "有相当年头的记事",
                    "text": "「…同浮浪倾奇者剑舞…」"
                }
            ]
        },
        {
            "talkId": "6800430",
            "initDialog": "680043001",
