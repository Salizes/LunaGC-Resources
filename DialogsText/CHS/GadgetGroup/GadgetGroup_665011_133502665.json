    "talks": [
        {
            "talkId": "6861000",
            "initDialog": "686100001",
            "dialogues": [
                {
                    "id": "686100001",
                    "speaker": "店铺公告",
                    "text": "「神秘店铺即将入驻『流泉之众』，为这里的海风增添几分山樱的香气，还有优雅的紫色~」"
                },
                {
                    "id": "686100002",
                    "speaker": "店铺公告",
                    "text": "「敬请期待~」"
                }
            ]
        },
        {
            "talkId": "6861001",
            "initDialog": "686100101",
            "dialogues": [
                {
                    "id": "686100101",
                    "speaker": "「梦见月的舒心小站」",
                    "text": "「烦恼和忧愁，焦虑与慌张…这些负面的情绪很有可能潜藏至意识深处，在梦境中不断困扰我们…」"
                },
                {
                    "id": "686100102",
                    "speaker": "「梦见月的舒心小站」",
                    "text": "「享受愉悦的度假时光之余，不妨抽个空闲，试着消解这些不安的因素，寻得心灵的宁静…」"
                },
                {
                    "id": "686100103",
                    "speaker": "「梦见月的舒心小站」",
                    "text": "「梦见月的舒心小站等候您的来访，希望食梦貘一族特别的心理疗法能为您扫清阴霾。」"
                },
                {
                    "id": "686100104",
                    "speaker": "「梦见月的舒心小站」",
                    "text": "「此外，『秋沙钱汤』的纳塔分店锐意筹建中，敬请期待！」"
                }
            ]
        }
    ]
}