{
    "groupId": "19022_511010019",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 8,
        "无名的石像": 15
    },
    "talks": [
        {
            "talkId": "6849001",
            "initDialog": "684900101",
            "dialogues": [
                {
                    "id": "684900101",
                    "speaker": "无名的石像",
                    "text": "路过的勇士啊，请将你的脚步在此停留…",
                    "choices": [
                        {
                            "id": "684900102",
                            "text": "你怎么会在…",
                            "response": [
                                {
                                    "id": "684900103",
                                    "speaker": "无名的石像",
                                    "text": "正如你所看到的，我与我的军团弟兄们坚守于此，就像千年中的每一日一样。"
                                },
                                {
                                    "id": "684900107",
                                    "speaker": "Player",
                                    "text": "军团？你还有其他帮手？"
                                },
                                {
                                    "id": "684900108",
                                    "speaker": "无名的石像",
                                    "text": "曾经有过，不过它们都离开了。"
                                },
                                {
                                    "id": "684900109",
                                    "speaker": "无名的石像",
                                    "text": "或是在漫长时间中的某日放下了执着与仇恨，又或是彻底被执着与仇恨所占据，抛下职责投入到无意义的杀戮中去了。"
                                },
                                {
                                    "id": "684900110",
                                    "speaker": "无名的石像",
                                    "text": "最后只剩下我还坚守在这里。"
                                },
                                {
                                    "id": "684900111",
                                    "speaker": "无名的石像",
                                    "text": "尊贵的勇士，你从王城而来吗？可否请你带话给王城的公民们，就说第六军团的士兵完成了使命，没有让一只龙蜥通过这里。"
                                },
                                {
                                    "id": "684900112",
                                    "speaker": "Player",
                                    "text": "这里面还有龙蜥吗？"
                                },
                                {
                                    "id": "684900113",
                                    "speaker": "无名的石像",
                                    "text": "不，从很久以前开始应该就没有了…但是我等与其战斗的历史却不知为何被「乐章」记录了下来，如歌剧般在其中上演…"
                                },
                                {
                                    "id": "684900114",
                                    "speaker": "无名的石像",
                                    "text": "我也无法确定那是真是幻，你要进去看看吗？若是王城的勇士想必不会有什么危险，请用你的手与眼记录下我们的历史吧。"
                                }
                            ]
                        },
                        {
                            "id": "684900104",
                            "text": "这里是…",
                            "response": [
                                {
                                    "id": "684900105",
                                    "speaker": "无名的石像",
                                    "text": "切萨勒姆宫…过去似乎是这样称呼的，但如今这里只剩下废墟了。"
                                },
                                {
                                    "id": "684900106",
                                    "speaker": "无名的石像",
                                    "text": "我与我的不朽军团弟兄们坚守于此，就像千年中的每一日一样。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6849002",
            "initDialog": "684900201",
            "dialogues": [
                {
                    "id": "684900201",
                    "speaker": "Player",
                    "text": "带我去吧。"
                },
                {
                    "id": "684900202",
                    "speaker": "无名的石像",
                    "text": "嗯，出来之后记得再来找我。"
                }
            ]
        },
        {
            "talkId": "6849003",
            "initDialog": "684900301",
            "dialogues": [
                {
                    "id": "684900301",
                    "speaker": "Player",
                    "text": "还有别的事…"
                },
                {
                    "id": "684900302",
                    "speaker": "无名的石像",
                    "text": "好吧，等忙完之后也别忘了再来找我。"
                }
            ]
        },
        {
            "talkId": "6849004",
            "initDialog": "684900401",
            "dialogues": [
                {
                    "id": "684900401",
                    "speaker": "无名的石像",
                    "text": "路过的勇士啊，请将你的脚步在此停留。告诉王城的公民们，我们恪守了我们的使命…"
                }
            ]
        },
