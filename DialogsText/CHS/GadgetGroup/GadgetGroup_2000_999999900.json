        {
            "talkId": "6890501",
            "initDialog": "689050101",
            "dialogues": [
                {
                    "id": "689050101",
                    "speaker": "阿嘟",
                    "text": "吾乃「寻瑰纳琦真君」，云游四方，只求尽览世间珍宝…"
                }
            ]
        },
        {
            "talkId": "6890502",
            "initDialog": "689050201",
            "dialogues": [
                {
                    "id": "689050201",
                    "speaker": "Player",
                    "text": "你这里都卖些什么？"
                },
                {
                    "id": "689050202",
                    "speaker": "阿嘟",
                    "text": "瑰琦不可强求，理当顺应缘分。"
                }
            ]
        },
        {
            "talkId": "6890503",
            "initDialog": "689050301",
            "dialogues": [
                {
                    "id": "689050301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "689050302",
                    "speaker": "阿嘟",
                    "text": "有所收获是好事，没有遇见缘中之物，也不必介怀。"
                }
            ]
        },
        {
            "talkId": "6890511",
            "initDialog": "689051101",
            "dialogues": [
                {
                    "id": "689051101",
                    "speaker": "观察",
                    "text": "（看来，这也是一位壶灵吧…）"
                }
            ]
        }
    ]
}