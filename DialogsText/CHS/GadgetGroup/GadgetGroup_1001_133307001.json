            "dialogues": [
                {
                    "id": "683300101",
                    "speaker": "派蒙",
                    "text": "咦，这里居然留下了这样的记录…留下记录的人居然是哲伯莱勒！"
                },
                {
                    "id": "683300102",
                    "speaker": "派蒙",
                    "text": "哲伯莱勒，好熟悉的名字，咦，那不是…",
                    "choices": [
                        {
                            "id": "683300103",
                            "text": "是婕德的父亲…",
                            "response": [
                                {
                                    "id": "683300105",
                                    "speaker": "派蒙",
                                    "text": "从这里面来看，感觉这时候哲伯莱勒和萨梅尔关系还不错呢，毕竟以前是同一个部落的人，或许是一起到过这里。"
                                },
                                {
                                    "id": "683300106",
                                    "speaker": "派蒙",
                                    "text": "唔…难道这个放在边上的石头，就是他们在记录里留下的钥石…"
                                },
                                {
                                    "id": "683300107",
                                    "speaker": "派蒙",
                                    "text": "#真不知道有什么作用…嗯，{NICKNAME}，你有想到什么吗？"
                                },
                                {
                                    "id": "683300108",
                                    "speaker": "Player",
                                    "text": "是那块石板…"
                                },
                                {
                                    "id": "683300109",
                                    "speaker": "派蒙",
                                    "text": "石板上的符号，亮起来了！"
                                }
                            ]
                        },
                        {
                            "id": "683300104",
                            "text": "还提到了萨梅尔…"
                        }
                    ]
                }
            ]
        }
    ]
}