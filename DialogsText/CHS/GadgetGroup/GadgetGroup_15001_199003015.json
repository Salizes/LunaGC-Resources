            "dialogues": [
                {
                    "id": "680023702",
                    "speaker": "老旧的石碑",
                    "text": "（老旧的石碑，上面的部分字迹已模糊不清…）"
                },
                {
                    "id": "680023703",
                    "speaker": "老旧的石碑",
                    "text": "「…<color=#00E1FFFF>上至石壁之前，下至浅湾的河滩</color>，其间有四类元素之象征…」"
                },
                {
                    "id": "680023704",
                    "speaker": "老旧的石碑",
                    "text": "「…按<color=#00E1FFFF>自上而下</color>的…之序，次第点亮…当如是时，<color=#00E1FFFF>天象因循作四种变化</color>…」"
                },
                {
                    "id": "680023705",
                    "speaker": "老旧的石碑",
                    "text": "「…此后，正中之门将于此打开…」"
                }
            ]
        }
    ]
}