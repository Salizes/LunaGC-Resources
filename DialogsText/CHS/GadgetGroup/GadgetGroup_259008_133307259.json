            "dialogues": [
                {
                    "id": "683480001",
                    "speaker": "无名的石碑",
                    "text": "（一尊完整的石碑，其上雕刻着无法破译的优雅文字。）"
                }
            ]
        },
        {
            "talkId": "6834810",
            "initDialog": "683481001",
            "dialogues": [
                {
                    "id": "683481001",
                    "speaker": "无名的石碑·其六",
                    "text": "「我曾以为奥尔玛兹将为沙漠带来全新的秩序，令沙海的渺小世界告别奴役，但他令我失望了。」"
                },
                {
                    "id": "683481002",
                    "speaker": "无名的石碑·其六",
                    "text": "「于是，我惩治了他——彻底毁灭了他的王国，由父及子，三代而亡。」"
                },
                {
                    "id": "683481003",
                    "speaker": "无名的石碑·其六",
                    "text": "「…粉饰为『幸福』的奴役，尚不如暴烈的死亡…」"
                }
            ]
        }
    ]
}