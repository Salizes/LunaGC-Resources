{
    "groupId": "665009_133502665",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 2,
        "店主留言": 16
    },
    "talks": [
        {
            "talkId": "6860800",
            "initDialog": "686080001",
            "dialogues": [
                {
                    "id": "686080001",
                    "speaker": "店主留言",
                    "text": "「哟吼！店主玛拉妮向你问好！这里是『流泉之众』知名的水上用品店！嘿嘿，有什么需要记得留言哦。」"
                }
            ]
        },
        {
            "talkId": "6860801",
            "initDialog": "686080101",
            "dialogues": [
                {
                    "id": "686080101",
                    "speaker": "Player",
                    "text": "继续阅读"
                }
            ]
        },
        {
            "talkId": "6860802",
            "initDialog": "686080201",
            "dialogues": [
                {
                    "id": "686080201",
                    "speaker": "Player",
                    "text": "离开"
                }
            ]
        },
        {
            "talkId": "6860803",
            "initDialog": "686080301",
            "dialogues": [
                {
                    "id": "686080301",
                    "speaker": "店主留言",
                    "text": "「祝贺我呀！」"
                },
                {
                    "id": "686080302",
                    "speaker": "店主留言",
                    "text": "「本店店主玛拉妮要作为代表『流泉之众』的代表参加这次的『归火圣夜巡礼』啦！」"
                },
                {
                    "id": "686080303",
                    "speaker": "店主留言",
                    "text": "「等我拿到漂亮的名次，回来就给大家办厉害的活动，水上用品大赠送！」"
                }
            ]
        },
        {
            "talkId": "6860804",
            "initDialog": "686080401",
            "dialogues": [
                {
                    "id": "686080401",
                    "speaker": "店主留言",
                    "text": "「我知道大家一定很关心店里的用品种类和介绍，所以我就提前写在这里啦！」"
                },
                {
                    "id": "686080402",
                    "speaker": "店主留言",
                    "text": "「首先，就是本店的镇店之宝——好运色『豚豚泳装』！这可是能瞬间变成救生豚豚球的好东西，水性不好的朋友可不要错过！」"
                },
                {
                    "id": "686080403",
                    "speaker": "店主留言",
                    "text": "「然后，就是万众期待的冲浪板啦！想要什么样的颜色、材质和花纹都有！没有的话也可以定制！」"
                },
                {
                    "id": "686080404",
                    "speaker": "店主留言",
                    "text": "「当然，还有滑水，水上滑翔伞，沙滩排球等等的一切用品装备，这里写不下就不写啦，所有的都可以直接来找我本人询问！」"
                }
            ]
        },
        {
            "talkId": "6860805",
            "initDialog": "686080501",
            "dialogues": [
                {
                    "id": "686080501",
                    "speaker": "店主留言",
                    "text": "「要是找不到店主，请别着急！」"
                },
                {
                    "id": "686080502",
                    "speaker": "店主留言",
                    "text": "「请在沙滩排球区和冲浪区转一转。」"
                },
                {
                    "id": "686080503",
                    "speaker": "店主留言",
                    "text": "「如果实在找不到也没关系，这块牌子上也有价目表，要买东西的话，直接把摩拉留在柜台上就好啦~」"
                },
                {
                    "id": "686080504",
                    "speaker": "店主留言",
                    "text": "「我相信各位客人！」"
                }
            ]
        },
        {
            "talkId": "6860806",
            "initDialog": "686080601",
            "dialogues": [
                {
                    "id": "686080601",
                    "speaker": "店主留言",
                    "text": "「请不要在没有冲浪经验的情况下，随意借用店面的鲨鲨冲浪板哦！」"
                },
                {
                    "id": "686080602",
                    "speaker": "店主留言",
                    "text": "「比起一般的冲浪板，鲨鲨冲浪板在水上滑行的速度更快，但也不怎么稳定。」"
                },
                {
                    "id": "686080603",
                    "speaker": "店主留言",
                    "text": "「普通人有可能踩着鲨鲨冲浪板一头撞上岸边的礁石！」"
                },
                {
                    "id": "686080604",
                    "speaker": "店主留言",
                    "text": "「如果不走运遇上事故，就要浪费宝贵的度假时间躺在屋里养伤了，特别不划算！」"
                }
            ]
        }
    ]
}