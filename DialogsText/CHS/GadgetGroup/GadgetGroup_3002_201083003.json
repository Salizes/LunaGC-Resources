                {
                    "id": "140071401",
                    "speaker": "「关于刺玫会…」",
                    "text": "「刺玫会会长卡雷斯在决斗中落败，重伤不治。」"
                },
                {
                    "id": "140071402",
                    "speaker": "「关于刺玫会…」",
                    "text": "「这场关于名誉的决斗落下帷幕，嫌犯卡雷斯自始至终并未抗辩。」"
                },
                {
                    "id": "140071403",
                    "speaker": "「关于刺玫会…」",
                    "text": "「那维莱特大人对本案持保留意见，具体细节仍在调查中。」"
                }
            ]
        }
    ]
}