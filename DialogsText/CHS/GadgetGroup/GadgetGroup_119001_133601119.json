            "dialogues": [
                {
                    "id": "686251201",
                    "speaker": "誓言之灯",
                    "text": "（这盏制式提灯的金属灯罩上布满了细小的划痕，底部刻着一行字。）"
                },
                {
                    "id": "686251202",
                    "speaker": "誓言之灯",
                    "text": "「我们是执灯人，无尽雪原中执灯守护永燃的希望。」"
                },
                {
                    "id": "686251203",
                    "speaker": "誓言之灯",
                    "text": "（灯罩的一面有一道暗格，打开后出现了一张泛黄的留言纸条。）"
                }
            ]
        },
        {
            "talkId": "6862525",
            "initDialog": "686251801",
            "dialogues": [
                {
                    "id": "686251801",
                    "speaker": "誓言之灯",
                    "text": "一座黯淡的提灯，似乎是属于<color=#00E1FFFF>执灯人</color>的特有装备。"
                }
            ]
        }
    ]
}