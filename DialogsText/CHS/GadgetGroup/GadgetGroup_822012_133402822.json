                {
                    "id": "684120401",
                    "speaker": "污损的新闻剪报",
                    "text": "（破旧的《蒸汽鸟报》地方版面，被剪下后丢弃在了这里）"
                },
                {
                    "id": "684120402",
                    "speaker": "污损的新闻剪报",
                    "text": "「…预计沉玉谷茶叶进口额将在下一季度下降…届时璃月茶叶及其产品市场价格将上涨至约…摩拉…」"
                },
                {
                    "id": "684120403",
                    "speaker": "污损的新闻剪报",
                    "text": "（剪报的右下角被圈起了几行字，标上了星号，又标上了三个大大的感叹号。）",
                    "choices": [
                        {
                            "id": "684120404",
                            "text": "（查看被圈起的内容。）",
                            "response": [
                                {
                                    "id": "684120405",
                                    "speaker": "污损的新闻剪报",
                                    "text": "「…近日犯罪组织『新奇裤俱乐部』高层尽数被捕，柔灯港的地下权力平衡恐被『刺玫会』打破…」",
                                    "choices": [
                                        {
                                            "id": "684120404",
                                            "text": "（查看被圈起的内容。）"
                                        },
                                        {
                                            "id": "684120406",
                                            "text": "（查看标上星号的内容）",
                                            "response": [
                                                {
                                                    "id": "684120407",
                                                    "speaker": "污损的新闻剪报",
                                                    "text": "「…柔灯港水道计划再度搁置！工人滞留海港，待遇成谜…」",
                                                    "choices": [
                                                        {
                                                            "id": "684120404",
                                                            "text": "（查看被圈起的内容。）"
                                                        },
                                                        {
                                                            "id": "684120406",
