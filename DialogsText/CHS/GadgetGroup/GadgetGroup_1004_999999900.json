            "dialogues": [
                {
                    "id": "689010501",
                    "speaker": "Player",
                    "text": "洞天百宝"
                }
            ]
        },
        {
            "talkId": "6890406",
            "initDialog": "689040601",
            "dialogues": [
                {
                    "id": "689040601",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "689040602",
                    "speaker": "阿圆",
                    "text": "其实我有个挺难记的仙号，似乎叫…「销虹霁雨真君」。"
                },
                {
                    "id": "689040603",
                    "speaker": "阿圆",
                    "text": "当年战乱不断，大陆各地风雨如磐，日月无光。"
                },
                {
                    "id": "689040604",
                    "speaker": "阿圆",
                    "text": "阿萍和老友们对晴天心心念念，就给我起了这个名号。"
                },
                {
                    "id": "689040605",
                    "speaker": "阿圆",
                    "text": "所以，无论我用哪种形象示人，都会保留这身「霁青」的色彩。"
                }
            ]
        },
        {
            "talkId": "6890407",
            "initDialog": "689010701",
            "dialogues": [
                {
                    "id": "689010701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "689010702",
                    "speaker": "阿圆",
                    "text": "与壶中洞天有关的问题，你们都可以来找我。"
                }
            ]
        },
        {
            "talkId": "6890408",
            "initDialog": "689010801",
            "dialogues": [
                {
                    "id": "689010801",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>切换洞天形态</color>"
                }
            ]
        },
        {
            "talkId": "6890409",
            "initDialog": "689010901",
            "dialogues": [
                {
                    "id": "689010901",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>信任等阶</color>"
                }
            ]
        },
        {
            "talkId": "6890410",
