{
    "groupId": "53001_133611053",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 3,
        "叶洛亚": 15,
        "叶洛亚的信箱": 1
    },
    "talks": [
        {
            "talkId": "6863401",
            "initDialog": "686340101",
            "dialogues": [
                {
                    "id": "686340101",
                    "speaker": "叶洛亚",
                    "text": "看起来是志愿加入执灯人的孩子寄来的信…"
                },
                {
                    "id": "686340102",
                    "speaker": "叶洛亚",
                    "text": "最近愿意成为执灯士的人越来越多了，这都是同僚们共同努力的结果。"
                },
                {
                    "id": "686340103",
                    "speaker": "叶洛亚",
                    "text": "即便是那夏镇里最不关心公共利益的商人，如今也开始理解我们战斗的意义。"
                },
                {
                    "id": "686340104",
                    "speaker": "叶洛亚",
                    "text": "说不定再过不久，执灯人就能壮大到让挪德卡莱不再受到狂猎的威胁，真令人期待啊。"
                },
                {
                    "id": "686340105",
                    "speaker": "叶洛亚",
                    "text": "不过你还是等长大以后再来加入吧…"
                }
            ]
        },
        {
            "talkId": "6863402",
            "initDialog": "686340201",
            "dialogues": [
                {
                    "id": "686340201",
                    "speaker": "叶洛亚的信箱",
                    "text": "（似乎塞满了杂乱的信件…）"
                }
            ]
        },
        {
            "talkId": "6863403",
            "initDialog": "686340301",
            "dialogues": [
                {
                    "id": "686340301",
                    "speaker": "Player",
                    "text": "（有需要<color=#FFCC33FF>叶洛亚</color>处理的信件…）"
                }
            ]
        },
        {
            "talkId": "6863404",
            "initDialog": "686340401",
            "dialogues": [
                {
                    "id": "686340401",
                    "speaker": "Player",
                    "text": "（有需要<color=#FFCC33FF>叶洛亚</color>处理的信件…）"
                },
                {
                    "id": "686340403",
                    "speaker": "叶洛亚",
                    "text": "…看来有新的信件。"
                },
                {
                    "id": "686340402",
                    "speaker": "Player",
                    "text": "（翻阅。）"
                }
            ]
        },
        {
            "talkId": "6863405",
            "initDialog": "686340501",
            "dialogues": [
                {
                    "id": "686340501",
                    "speaker": "叶洛亚",
                    "text": "咦，这不是给菲林斯先生的信吗，为什么会在这里？"
                },
                {
                    "id": "686340502",
                    "speaker": "叶洛亚",
                    "text": "啊，我明白了…老爷子也真是的。就算让我去，他也是不会收下你想送的那只小狗崽的。"
                },
                {
                    "id": "686340503",
                    "speaker": "叶洛亚",
                    "text": "不过说起来，也有段时间没去看望菲林斯先生了。"
                },
                {
                    "id": "686340504",
                    "speaker": "叶洛亚",
                    "text": "下次巡逻的时候，就挑一条靠近帕哈岛的路线吧。"
                }
            ]
        },
        {
            "talkId": "6863406",
            "initDialog": "686340601",
            "dialogues": [
                {
                    "id": "686340601",
                    "speaker": "叶洛亚",
                    "text": "呃…爱诺小姐的工程学习会居然特意寄来了邀请函。"
                },
                {
                    "id": "686340602",
                    "speaker": "叶洛亚",
                    "text": "该不会是因为上次我为了不去参加找的理由实在太离谱，成了重点关注对象了吧。"
                },
                {
                    "id": "686340603",
                    "speaker": "叶洛亚",
                    "text": "怎么办，要当作没有看见吗，现在把信的样子摆回原样应该还来得及…"
                },
                {
                    "id": "686340604",
                    "speaker": "叶洛亚",
                    "text": "算了，收到了邀请函，假装没看见实在有些不礼貌了。"
                },
                {
                    "id": "686340605",
                    "speaker": "叶洛亚",
                    "text": "但要是正好那天有紧急任务的话就另当别论了，让我再仔细检查一下信箱…"
                }
            ]
        }
    ]
}