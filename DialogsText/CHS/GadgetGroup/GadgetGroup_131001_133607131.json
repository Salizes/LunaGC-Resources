            "talkId": "6890701",
            "initDialog": "689070101",
            "dialogues": [
                {
                    "id": "689070101",
                    "speaker": "悼词",
                    "text": "「执光之人，以鲜血践行荣光与正义。」"
                },
                {
                    "id": "689070102",
                    "speaker": "悼词",
                    "text": "「行迹匆匆，你我即便满身疮痍，也请片刻驻足，回望爱憎。」"
                },
                {
                    "id": "689070103",
                    "speaker": "悼词",
                    "text": "「直至深夜世界阖眼，那盏无人可见的，只为你一人的灯缓缓亮起。」"
                }
            ]
        }
    ]
}