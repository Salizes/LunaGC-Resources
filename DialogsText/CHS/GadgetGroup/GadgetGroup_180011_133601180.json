            "dialogues": [
                {
                    "id": "686250101",
                    "speaker": "迪特里克之墓",
                    "text": "执灯士迪特里克于此长眠。"
                }
            ]
        },
        {
            "talkId": "6862502",
            "initDialog": "686250206",
            "dialogues": [
                {
                    "id": "686250206",
                    "speaker": "<UNKNOWN>",
                    "text": "<color=#00E1FFFF>仔细辨认</color>"
                },
                {
                    "id": "686250201",
                    "speaker": "迪特里克之墓",
                    "text": "<color=#00E1FFFF>「邻家的舞曲让我忍不住踏脚！」</color>"
                },
                {
                    "id": "686250202",
                    "speaker": "迪特里克之墓",
                    "text": "<color=#00E1FFFF>「我在拉琴你们在微笑。」</color>"
                },
                {
                    "id": "686250203",
                    "speaker": "迪特里克之墓",
                    "text": "<color=#00E1FFFF>「大家都在开心跳舞，嘿！嘿！」</color>"
                },
                {
                    "id": "686250204",
                    "speaker": "迪特里克之墓",
                    "text": "<color=#00E1FFFF>「我们聚起来，聚起来跳舞！」</color>"
                },
                {
                    "id": "686250205",
                    "speaker": "迪特里克之墓",
                    "text": "<color=#00E1FFFF>愿他的美梦中充满美酒与永不停歇的歌声。</color>"
                }
            ]
        }
    ]
}