{
    "groupId": "2001_133402002",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 6,
        "梅雅德": 15
    },
    "talks": [
        {
            "talkId": "6801802",
            "initDialog": "680180201",
            "dialogues": [
                {
                    "id": "680180201",
                    "speaker": "梅雅德",
                    "text": "#{M#先生和女士}{F#女士们}，准备好挑战「冰风组曲」了吗？"
                }
            ]
        },
        {
            "talkId": "6801806",
            "initDialog": "680180601",
            "dialogues": [
                {
                    "id": "680180601",
                    "speaker": "Player",
                    "text": "挑战「歌裴莉娅的葬送」。"
                }
            ]
        },
        {
            "talkId": "6801807",
            "initDialog": "680180701",
            "dialogues": [
                {
                    "id": "680180701",
                    "speaker": "Player",
                    "text": "挑战「科培琉司的劫罚」。"
                }
            ]
        },
        {
            "talkId": "6801809",
            "initDialog": "680180901",
            "dialogues": [
                {
                    "id": "680180901",
                    "speaker": "Player",
                    "text": "下次再说吧。"
                },
                {
                    "id": "680180902",
                    "speaker": "梅雅德",
                    "text": "#舞池随时为您开放，尊敬的{M#先生}{F#女士}。"
                }
            ]
        },
        {
            "talkId": "6801810",
            "initDialog": "680181001",
            "dialogues": [
                {
                    "id": "680181001",
                    "speaker": "Player",
                    "text": "关于「冰风组曲」…"
                },
                {
                    "id": "680181002",
                    "speaker": "梅雅德",
                    "text": "您想了解哪方面的内容呢？"
                }
            ]
        },
        {
            "talkId": "6801811",
            "initDialog": "680181101",
            "dialogues": [
                {
                    "id": "680181101",
                    "speaker": "Player",
                    "text": "「冰风组曲」的故事内容是？"
                },
                {
                    "id": "680181102",
                    "speaker": "梅雅德",
                    "text": "好问题！"
                },
                {
                    "id": "680181103",
                    "speaker": "梅雅德",
                    "text": "比如说科培琉司在与诱惑的对抗中落败，因此遭受劫罚。又比如说，歌裴莉娅爱而不得，因此险些香消玉殒。"
                },
                {
                    "id": "680181104",
                    "speaker": "梅雅德",
                    "text": "再比如说，为了解救因遭受劫罚而被困的科培琉司，歌裴莉娅踏上旅途。"
                },
                {
                    "id": "680181105",
                    "speaker": "梅雅德",
                    "text": "但是不管怎么说，最终，舞剧将在恋人的圆舞中落下帷幕。"
                },
                {
                    "id": "680181106",
                    "speaker": "梅雅德",
                    "text": "哈哈，其实是只想到了一些情节的片段。我毕竟不是饱读诗书的文人，只是个和发条机关打交道的研究者。"
                },
                {
                    "id": "680181107",
                    "speaker": "梅雅德",
                    "text": "对我来说，发条机关的性能比附会给它们的故事更重要。"
                },
                {
                    "id": "680181108",
                    "speaker": "梅雅德",
                    "text": "不过，如果您真的对故事有兴趣，我会认真考虑。"
                }
            ]
        },
        {
            "talkId": "6801812",
            "initDialog": "680181201",
            "dialogues": [
                {
                    "id": "680181201",
                    "speaker": "Player",
                    "text": "为什么要加战斗技能？"
                },
                {
                    "id": "680181202",
                    "speaker": "梅雅德",
                    "text": "嗯…这个嘛，其实一开始，博絮埃先生也是反对的。"
                },
                {
                    "id": "680181203",
                    "speaker": "梅雅德",
                    "text": "该怎么说呢，算是我个人的兴趣？"
                },
                {
                    "id": "680181204",
                    "speaker": "梅雅德",
                    "text": "您瞧，加入了战斗技能的科培琉司和歌裴莉娅，它们的舞姿在优雅之余，更是充满了力量的美感！"
                },
                {
                    "id": "680181205",
                    "speaker": "梅雅德",
                    "text": "我觉得这是一次成功的尝试，不管别人怎么看。"
                },
                {
                    "id": "680181206",
                    "speaker": "梅雅德",
                    "text": "当然，这也多亏了一个意外…那就是在博絮埃先生离开枫丹科学院之后，没人否决我的研究计划了！"
                }
            ]
        }
    ]
}