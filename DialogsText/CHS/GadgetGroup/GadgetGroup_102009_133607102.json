        {
            "talkId": "6862301",
            "initDialog": "686230101",
            "dialogues": [
                {
                    "id": "686230101",
                    "speaker": "？？？",
                    "text": "警戒！检测到闯入者！扫描身份中…"
                },
                {
                    "id": "686230102",
                    "speaker": "？？？",
                    "text": "检测到闯入者已被「友谊蛋卷指南」登记，标识为「蛋卷伙伴」，警戒单元关闭…"
                },
                {
                    "id": "686230103",
                    "speaker": "？？？",
                    "text": "「除尘模拟」准备就绪，「工坊秘藏」准备就绪。「蛋卷伙伴」，是否开启？"
                }
            ]
        },
        {
            "talkId": "6862310",
            "initDialog": "686231001",
            "dialogues": [
                {
                    "id": "686231001",
                    "speaker": "Player",
                    "text": "「除尘模拟」是…？"
                },
                {
                    "id": "686231002",
                    "speaker": "？？？",
                    "text": "蛋卷伙伴选择开启「除尘模拟」，除尘清洁单元启动，以「蛋卷伙伴」为模拟对象！"
                }
            ]
        },
        {
            "talkId": "6862311",
            "initDialog": "686231101",
            "dialogues": [
                {
                    "id": "686231101",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "686231102",
                    "speaker": "？？？",
                    "text": "「蛋卷伙伴」已离开。"
                }
            ]
        },
        {
            "talkId": "6862312",
            "initDialog": "686231201",
            "dialogues": [
                {
                    "id": "686231201",
                    "speaker": "Player",
                    "text": "「工坊秘藏」是…？"
                },
                {
                    "id": "686231202",
                    "speaker": "？？？",
                    "text": "蛋卷伙伴选择开启工坊秘藏！"
                },
                {
                    "id": "686231203",
                    "speaker": "？？？",
                    "text": "密钥匹配错误，开启失败。"
                }
            ]
        },
        {
            "talkId": "6862313",
            "initDialog": "686231301",
            "dialogues": [
                {
                    "id": "686231301",
                    "speaker": "Player",
                    "text": "「工坊秘藏」是…？"
                },
                {
                    "id": "686231302",
                    "speaker": "？？？",
                    "text": "蛋卷伙伴选择开启工坊秘藏！"
                },
                {
                    "id": "686231303",
                    "speaker": "？？？",
                    "text": "密钥匹配正确，开启成功。"
                }
            ]
        },
        {
            "talkId": "6862314",
            "initDialog": "686231401",
            "dialogues": [
                {
                    "id": "686231401",
                    "speaker": "Player",
                    "text": "「友谊蛋卷指南」是…？"
                },
                {
                    "id": "686231402",
                    "speaker": "？？？",
                    "text": "是主人用来标识可信任对象的数据库，被登入其中的「蛋卷伙伴」拥有自由出入工坊部分区域的权限。"
                },
                {
                    "id": "686231403",
                    "speaker": "？？？",
                    "text": "如果「蛋卷伙伴」持有主人的密钥，还可以获得开启「工坊秘藏」的权限。"
                }
            ]
        },
        {
            "talkId": "6862316",
            "initDialog": "686231601",
            "dialogues": [
                {
                    "id": "686231601",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>开启「工坊秘藏」。</color>"
                },
                {
                    "id": "686231602",
                    "speaker": "「重拳出击鸭」",
                    "text": "密钥匹配正确，开启成功。"
                }
            ]
        }
    ]
}