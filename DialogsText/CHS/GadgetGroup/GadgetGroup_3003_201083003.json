    "talks": [
        {
            "talkId": "1400715",
            "initDialog": "140071501",
            "dialogues": [
                {
                    "id": "140071501",
                    "speaker": "「关于走私案…」",
                    "text": "「警备队与逐影庭联手破获了一起走私案。」"
                },
                {
                    "id": "140071502",
                    "speaker": "「关于走私案…」",
                    "text": "「案件主要参与者，根据其罪责大小，受到了不同程度的审判。」"
                },
                {
                    "id": "140071503",
                    "speaker": "「关于走私案…」",
                    "text": "「名单附录请翻阅案件附录表。」"
                }
            ]
        },
        {
            "talkId": "1400812",
            "initDialog": "140081201",
            "dialogues": [
                {
                    "id": "140081201",
                    "speaker": "「关于走私案…」",
                    "text": "「警备队与逐影庭联手破获了一起走私案。」"
                },
                {
                    "id": "140081202",
                    "speaker": "「关于走私案…」",
                    "text": "「案件主要参与者，根据其罪责大小，受到了不同程度的审判。」"
                },
                {
                    "id": "140081203",
                    "speaker": "「关于走私案…」",
                    "text": "「名单附录请翻阅案件附录表。」",
                    "choices": [
                        {
                            "id": "140081204",
                            "text": "继续阅读",
                            "response": [
                                {
                                    "id": "140081206",
                                    "speaker": "「关于走私案…」",
                                    "text": "「案件的主犯多梅尼科、伊尼加、尤娜等均已落网。经受审判后，被送到梅洛彼得堡。」"
                                },
                                {
                                    "id": "140081207",
                                    "speaker": "「关于走私案…」",
                                    "text": "「未参与走私案，但与主犯关系密切、有利益往来的人并未定罪，以教育为主。」"
                                },
                                {
                                    "id": "140081208",
                                    "speaker": "「关于走私案…」",
                                    "text": "「其中埃桑表现较好，提前解除观察。其余人员仍在重点观察名单中。」"
                                }
                            ]
                        },
                        {
                            "id": "140081205",
                            "text": "离开"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "1400815",
            "initDialog": "140081501",
            "dialogues": [
                {
                    "id": "140081501",
                    "speaker": "那维莱特",
                    "text": "「警备队与逐影庭联手破获了一起走私案」…就是这个。"
                },
                {
                    "id": "140081502",
                    "speaker": "那维莱特",
                    "text": "让我查一下具体的涉案人员名单，印象中是放在这里…找到了。"
                },
                {
                    "id": "140081503",
                    "speaker": "派蒙",
                    "text": "上面写着什么？"
                },
                {
                    "id": "140081504",
                    "speaker": "那维莱特",
                    "text": "「案件的主犯多梅尼科、伊尼加、尤娜等均已落网。经受审判后，被送到梅洛彼得堡。」"
                },
                {
                    "id": "140081505",
                    "speaker": "那维莱特",
                    "text": "「未参与走私案，但与主犯关系密切、有利益往来的人并未定罪，以教育为主。」"
                },
                {
                    "id": "140081506",
                    "speaker": "那维莱特",
                    "text": "「其中埃桑表现较好，提前解除观察。其余人员仍在重点观察名单中。」"
                },
                {
                    "id": "140081507",
                    "speaker": "派蒙",
                    "text": "好多名字！给基娅拉寄威胁信的人就在他们当中吗？"
                },
                {
                    "id": "140081508",
                    "speaker": "那维莱特",
                    "text": "嗯，准确来说，这个叫埃桑的人比较可疑。"
                },
                {
                    "id": "140081509",
                    "speaker": "那维莱特",
                    "text": "他看上去与走私案的核心成员有关，而且行动比较自由。"
                },
                {
                    "id": "140081510",
                    "speaker": "Player",
                    "text": "要不要把这个消息告诉娜维娅？"
                },
                {
                    "id": "140081511",
                    "speaker": "塞德娜",
                    "text": "那维莱特大人，刚刚有人过来登记，对方自称是刺玫会的成员。"
                },
                {
                    "id": "140081512",
                    "speaker": "塞德娜",
                    "text": "他说「人已经找到了，正在咖啡馆聊天」。"
                },
                {
                    "id": "140081513",
                    "speaker": "派蒙",
                    "text": "欸，我们刚刚搞清楚嫌疑人的名字，娜维娅是怎么知道的？"
                },
                {
                    "id": "140081514",
                    "speaker": "那维莱特",
                    "text": "我也不清楚。咖啡馆离这里不远，我们一起去看看吧。"
                }
            ]
        }
    ]
}