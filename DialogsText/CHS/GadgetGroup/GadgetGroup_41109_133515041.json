            "talkId": "6855200",
            "initDialog": "685520001",
            "dialogues": [
                {
                    "id": "685520001",
                    "speaker": "训练场公告",
                    "text": "「近期有学员反馈器械训练过于枯燥，现在增设了新的挑战项目。」"
                },
                {
                    "id": "685520002",
                    "speaker": "训练场公告",
                    "text": "「撞击『秘源龙像』获得分数，排名最高的人可以获得大奖。」"
                },
                {
                    "id": "685520003",
                    "speaker": "学员留言",
                    "text": "「我明白了，关键是爆发力！撞击之后再用力往前冲刺，就能拿到高分了！」"
                },
                {
                    "id": "685520004",
                    "speaker": "学员留言",
                    "text": "「用了上面说的方法，骨头都要撞碎了…我还是接着举杠铃吧。」"
                }
            ]
        }
    ]
}