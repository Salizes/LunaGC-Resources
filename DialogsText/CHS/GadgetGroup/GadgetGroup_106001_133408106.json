    "talks": [
        {
            "talkId": "6841100",
            "initDialog": "684110001",
            "dialogues": [
                {
                    "id": "684110001",
                    "speaker": "梅洛彼得堡公告板",
                    "text": "梅洛彼得堡公告及其他信息均在此发布，勿作他用。"
                },
                {
                    "id": "684110002",
                    "speaker": "一行小字",
                    "text": "接待员莫莱妮不负责任何有关本板的事务。"
                }
            ]
        },
        {
            "talkId": "6841101",
            "initDialog": "684110101",
            "dialogues": [
                {
                    "id": "684110101",
                    "speaker": "Player",
                    "text": "继续阅读"
                }
            ]
        },
        {
            "talkId": "6841102",
            "initDialog": "684110201",
            "dialogues": [
                {
                    "id": "684110201",
                    "speaker": "Player",
                    "text": "离开"
                }
            ]
        },
        {
            "talkId": "6841103",
            "initDialog": "684110301",
            "dialogues": [
                {
                    "id": "684110301",
                    "speaker": "公告",
                    "text": "关于生产区劳动纪律，现重申如下。"
                },
                {
                    "id": "684110302",
                    "speaker": "公告",
                    "text": "禁止携带与生产无关的杂物进入生产区，包括七圣召唤卡牌和小说等。"
                },
                {
                    "id": "684110303",
                    "speaker": "公告",
                    "text": "按时完成生产任务，并且保证生产质量，必要时接受技术指导。"
                },
                {
                    "id": "684110304",
                    "speaker": "公告",
                    "text": "爱护设施，禁止偷拿生产材料，禁止对发条机关进行改装。"
                }
            ]
        },
        {
            "talkId": "6841104",
            "initDialog": "684110401",
            "dialogues": [
                {
                    "id": "684110401",
                    "speaker": "公告",
                    "text": "外部管道检修工作长期开放申请。工作内容及申请条件详询艾蒂安。"
                },
                {
                    "id": "684110402",
                    "speaker": "补充公告",
                    "text": "有管道检修工作经验者优先。"
                }
            ]
        },
        {
            "talkId": "6841105",
            "initDialog": "684110501",
            "dialogues": [
                {
                    "id": "684110501",
                    "speaker": "公告",
                    "text": "在墙上乱涂乱画及随意张贴均为明令禁止的行为，违者必究。"
                },
                {
                    "id": "684110502",
                    "speaker": "补充公告",
                    "text": "对清除特殊涂料有心得者速与莫普瓦联络。"
                }
            ]
        },
        {
            "talkId": "6841106",
            "initDialog": "684110601",
            "dialogues": [
                {
                    "id": "684110601",
                    "speaker": "公告",
                    "text": "现已停止在晶簇矿坑道的各项作业，并封锁连通路。"
                },
                {
                    "id": "684110602",
                    "speaker": "公告",
                    "text": "如因公需要开启连通路，应提前七日提交申请，并在技术专家监督下操作传动机阀，以免发生意外。"
                }
            ]
        },
        {
            "talkId": "6841107",
            "initDialog": "684110701",
            "dialogues": [
                {
                    "id": "684110701",
                    "speaker": "公告",
                    "text": "近期发生多起针对新来者的诈骗事件，目前正在进一步调查中。事件说明将于调查完成后公示。"
                },
                {
                    "id": "684110702",
                    "speaker": "留言",
                    "text": "「大家一定要当心这些坏人，尤其是新来的。」"
                },
                {
                    "id": "684110703",
                    "speaker": "留言",
                    "text": "「我认识一个叫德瑟布尔的，据说他很照顾新人！有新来的找他准没错！」"
                }
            ]
        },
        {
            "talkId": "6841108",
            "initDialog": "684110801",
            "dialogues": [
                {
                    "id": "684110801",
                    "speaker": "公告",
                    "text": "关于近期发生的多起针对新来者的诈骗事件，现将调查结果公布如下。"
                },
                {
                    "id": "684110802",
                    "speaker": "公告",
                    "text": "犯人德瑟布尔，利用他人同情心，将委托低价外包给他人并从中赚取差价获利。"
                },
                {
                    "id": "684110803",
                    "speaker": "公告",
                    "text": "此行为严重违反了「特许券流通管理条例」，现决定对德瑟布尔及其同伙进行严厉处罚，特此通告。"
                }
            ]
        },
        {
            "talkId": "6841109",
            "initDialog": "684110901",
            "dialogues": [
                {
                    "id": "684110901",
                    "speaker": "公告",
                    "text": "外勤检修人员公开遴选现已开始，有意者详询艾蒂安。"
                },
                {
                    "id": "684110902",
                    "speaker": "公告",
                    "text": "目前已有四组人选参加，后续报名者可独立参加，亦可在协商后加入四组之中任意一组。"
                }
            ]
        },
        {
            "talkId": "6841110",
            "initDialog": "684111001",
            "dialogues": [
                {
                    "id": "684111001",
                    "speaker": "留言",
                    "text": "「我们队伍想招募几个成熟可靠的合作者，来与我们一同分享冠军的喜悦与战利品。」"
                },
                {
                    "id": "684111002",
                    "speaker": "留言",
                    "text": "「本招募在游戏结束前一直有效，欢迎有实力的合作者前往雷维处垂询。」"
                }
            ]
        },
        {
            "talkId": "6841111",
            "initDialog": "684111101",
            "dialogues": [
                {
                    "id": "684111101",
                    "speaker": "公告",
                    "text": "外勤检修人员公开遴选仍在进行，有意报名者详询艾蒂安。"
                },
                {
                    "id": "684111102",
                    "speaker": "补充公告",
                    "text": "以目前的情况来看，现在报名获选的概率不是完全没有，只是很小，小到几乎没有。"
                }
            ]
        },
        {
            "talkId": "6841112",
            "initDialog": "684111201",
            "dialogues": [
                {
                    "id": "684111201",
                    "speaker": "公告",
                    "text": "「拳力斗技」是一种健康的运动！"
                },
                {
                    "id": "684111202",
                    "speaker": "公告",
                    "text": "参加「拳力斗技」、暂借「拳力斗技场」，或只是单纯找人切磋，请至「拳力斗技场」详询罗西莫夫。"
                }
            ]
        },
        {
            "talkId": "6841113",
            "initDialog": "684111301",
            "dialogues": [
                {
                    "id": "684111301",
                    "speaker": "「三枚券剧团」广告",
                    "text": "「有人说能治疗众多罪恶的只有两贴药，一是时间，二是沉默…」"
                },
                {
                    "id": "684111302",
                    "speaker": "「三枚券剧团」广告",
                    "text": "当挚爱含恨身陨，自己也被构陷流放之时，她会选择沉默还是爆发？"
                },
                {
                    "id": "684111303",
                    "speaker": "「三枚券剧团」广告",
                    "text": "在近乎无限的冤仇中，她的命运又会如何沉沦往复？"
                },
                {
                    "id": "684111304",
                    "speaker": "「三枚券剧团」广告",
                    "text": "三枚券剧团将为您在近期带来《海中山女伯爵》公演，敬请期待。"
                }
            ]
        },
        {
            "talkId": "6841114",
            "initDialog": "684111401",
            "dialogues": [
                {
                    "id": "684111401",
                    "speaker": "公告",
                    "text": "根据「特许食堂管理条例」，每人每天可免费在布兰处申领美味福利餐一份。"
                },
                {
                    "id": "684111402",
                    "speaker": "公告",
                    "text": "领取福利餐时需保持秩序，排队领取，违者停餐三日。"
                },
                {
                    "id": "684111403",
                    "speaker": "留言",
                    "text": "「喂！不是『美味』福利餐吗？我领到的福利餐可一点不美味！我要求解释！」"
                },
                {
                    "id": "684111404",
                    "speaker": "回复",
                    "text": "「有关福利餐的意见，需在接待处填表上报，本板不受理相关业务。」"
                }
            ]
        },
        {
            "talkId": "6841115",
            "initDialog": "684111501",
            "dialogues": [
                {
                    "id": "684111501",
                    "speaker": "隐蔽的小字",
                    "text": "「想来点好东西吗？比『破烂骨头商店』还好的，请来『破烂骨头商店』（句号的位置画上了一颗橙色的桔子）」"
                }
            ]
        }
    ]
}