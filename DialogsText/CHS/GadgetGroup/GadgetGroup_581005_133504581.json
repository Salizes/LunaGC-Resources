    },
    "talks": [
        {
            "talkId": "6860400",
            "initDialog": "686040001",
            "dialogues": [
                {
                    "id": "686040001",
                    "speaker": "「穆胡鲁宝石铺」广告牌",
                    "text": "「欢迎光临『穆胡鲁宝石铺』，本店出售各类饰品、武器与工具，也承接宝石加工委托，还请客人耐心描述您的需求。」"
                }
            ]
        },
        {
            "talkId": "6860401",
            "initDialog": "686040101",
            "dialogues": [
                {
                    "id": "686040101",
                    "speaker": "Player",
                    "text": "继续阅读"
                }
            ]
        },
        {
            "talkId": "6860402",
            "initDialog": "686040201",
            "dialogues": [
                {
                    "id": "686040201",
                    "speaker": "Player",
                    "text": "离开"
                }
            ]
        },
        {
            "talkId": "6860403",
            "initDialog": "686040301",
            "dialogues": [
                {
                    "id": "686040301",
                    "speaker": "店长留言",
                    "text": "「如果没有看中本店提供的宝石造型方案，客人们可以自行提供加工图纸。」"
                },
                {
                    "id": "686040302",
                    "speaker": "店长留言",
                    "text": "「店长夏温和学徒伊蜜也承接设计订单，视需求复杂程度，需要两周到两个月不等的时间。」"
                },
                {
                    "id": "686040303",
                    "speaker": "店长留言",
                    "text": "「此外，本店亦会不定期推出由希诺宁小姐亲力切割打磨的特别款宝石，此类宝石数量有限，售完即止。」"
                },
                {
                    "id": "686040304",
                    "speaker": "店长留言",
                    "text": "「若您有选购意向，请持续关注本店货柜。」"
                }
            ]
        },
        {
            "talkId": "6860404",
            "initDialog": "686040401",
            "dialogues": [
                {
                    "id": "686040401",
                    "speaker": "店长留言",
                    "text": "「『穆胡鲁宝石铺百年诚信经营，假一赔十』…这类的固定宣传就不用多说了。」"
                },
                {
                    "id": "686040402",
                    "speaker": "店长留言",
                    "text": "「上一任的店长说过：『要是在本店买到虚假宣传，品相不好的宝石，您尽管提着锤子，来把店里同款宝石都砸了！』」"
                },
                {
                    "id": "686040403",
                    "speaker": "店长留言",
                    "text": "「言归正传，要是自备原材料，本店也承接加工服务，可以将宝石雕刻镶边，制作成大部分您想要的款式。」"
                },
                {
                    "id": "686040404",
                    "speaker": "店长留言",
                    "text": "「只要别提『给我雕个颗粒果』之类的需求，一切都好说！」"
                }
            ]
        },
        {
            "talkId": "6860405",
            "initDialog": "686040501",
            "dialogues": [
                {
                    "id": "686040501",
                    "speaker": "店长留言",
                    "text": "「为声援本届『归火圣夜巡礼』的参赛选手，本店将推出限时八折促销活动。」"
                },
                {
                    "id": "686040502",
                    "speaker": "店长留言",
                    "text": "「促销活动期间，本店的所有利润都将捐赠给代表『回声之子』出战的勇士们，作为支援资金。」"
                },
                {
                    "id": "686040503",
                    "speaker": "店长留言",
                    "text": "「当然，宝石的加工质量绝不会因为打折而降低，各位大可以放心！」"
                }
            ]
        }
    ]
}