            "talkId": "6854104",
            "initDialog": "685410401",
            "dialogues": [
                {
                    "id": "685410401",
                    "speaker": "珐露珊",
                    "text": "……"
                },
                {
                    "id": "685410402",
                    "speaker": "信使",
                    "text": "珐露珊导师！有学生来信！"
                },
                {
                    "id": "685410403",
                    "speaker": "珐露珊",
                    "text": "哦？是来报名听我的课的吗？快让我看看！"
                },
                {
                    "id": "685410404",
                    "speaker": "言辞诚恳的来信",
                    "text": "「珐露珊前辈，首先感谢您的邀请…我考虑了很久，还是想往妙论派的方向努力！」"
                },
                {
                    "id": "685410405",
                    "speaker": "字迹恭敬的来信",
                    "text": "「前辈好，虽然我对古代机关文献解读也很有兴趣，但知论派主要的研究方向就已经很耗精力…」"
                },
                {
                    "id": "685410406",
                    "speaker": "珐露珊",
                    "text": "…方向…"
                },
                {
                    "id": "685410407",
                    "speaker": "柯莱",
                    "text": "「抱歉！珐露珊前辈，我还想再跟师父学习一段时间…」"
                },
                {
                    "id": "685410408",
                    "speaker": "珐露珊",
                    "text": "哎…方向，方向，年轻人，都有自己的方向…"
                },
                {
                    "id": "685410409",
                    "speaker": "珐露珊",
                    "text": "……"
                },
                {
                    "id": "685410410",
                    "speaker": "珐露珊",
                    "text": "…有方向好啊。"
                },
                {
                    "id": "685410411",
                    "speaker": "赛诺",
                    "text": "人生方向，不「妨」多「想」。别让选择，成为遗憾。"
                }
            ]
        }
    ]
}