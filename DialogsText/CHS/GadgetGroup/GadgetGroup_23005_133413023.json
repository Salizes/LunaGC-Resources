    "talks": [
        {
            "talkId": "6853001",
            "initDialog": "685300101",
            "dialogues": [
                {
                    "id": "685300101",
                    "speaker": "小呜斯",
                    "text": "唔…"
                }
            ]
        },
        {
            "talkId": "6853002",
            "initDialog": "685300201",
            "dialogues": [
                {
                    "id": "685300201",
                    "speaker": "Player",
                    "text": "这里像是图书馆？"
                },
                {
                    "id": "685300202",
                    "speaker": "小呜斯",
                    "text": "准确来说是藏书室…不过说是图书馆也没错啦。"
                },
                {
                    "id": "685300203",
                    "speaker": "小呜斯",
                    "text": "古老的剧本、乐谱，曾经发生过的以及没发生过的全部故事…都被记录下来，收藏在这里。"
                },
                {
                    "id": "685300204",
                    "speaker": "小呜斯",
                    "text": "曾有人认为只要穷尽故事的一切可能，就能窥探到命运的秘密…"
                },
                {
                    "id": "685300205",
                    "speaker": "小呜斯",
                    "text": "但事实上并没有他想的那样复杂。每个人的命途说到底是被他们的愿望所锚定的，从一开始便不存在那么多的可能。"
                },
                {
                    "id": "685300206",
                    "speaker": "小呜斯",
                    "text": "或许在最后，他也意识到这一点了吧…"
                }
            ]
        },
        {
            "talkId": "6853003",
            "initDialog": "685300301",
            "dialogues": [
                {
                    "id": "685300301",
                    "speaker": "Player",
                    "text": "（摸一摸。）"
                }
            ]
        },
        {
            "talkId": "6853004",
            "initDialog": "685300401",
            "dialogues": [
                {
                    "id": "685300401",
                    "speaker": "Player",
                    "text": "没事。"
                },
                {
                    "id": "685300402",
                    "speaker": "小呜斯",
                    "text": "好吧，有什么想知道的就来问我哦，不用客气！"
                }
            ]
        },
        {
            "talkId": "6853005",
            "initDialog": "685300501",
            "dialogues": [
                {
                    "id": "685300501",
                    "speaker": "小呜斯",
                    "text": "唔…"
                }
            ]
        },
