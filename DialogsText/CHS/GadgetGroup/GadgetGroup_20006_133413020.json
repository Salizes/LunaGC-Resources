{
    "groupId": "20006_133413020",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 7,
        "小呜斯": 13
    },
    "talks": [
        {
            "talkId": "6852001",
            "initDialog": "685200101",
            "dialogues": [
                {
                    "id": "685200101",
                    "speaker": "小呜斯",
                    "text": "只要响起音乐驱动两边的「自鸣簧管」，把它们和周围的音符校准一致，就能把曲谱取下来了。"
                }
            ]
        },
        {
            "talkId": "6852002",
            "initDialog": "685200201",
            "dialogues": [
                {
                    "id": "685200201",
                    "speaker": "Player",
                    "text": "关于「自鸣簧管」…"
                },
                {
                    "id": "685200202",
                    "speaker": "小呜斯",
                    "text": "你说这个吗…嗯，顾名思义就是会自己演奏音乐的机关。"
                },
                {
                    "id": "685200203",
                    "speaker": "小呜斯",
                    "text": "旧日的文明是以音乐为基石构建的，因此有不少这样的机关遗留下来。"
                },
                {
                    "id": "685200204",
                    "speaker": "小呜斯",
                    "text": "不过和你们手中的音乐盒或是用来演奏「乐章」的机关不同，这家伙只能演奏一些简单的和弦，所以力量也要弱得多。"
                },
                {
                    "id": "685200205",
                    "speaker": "小呜斯",
                    "text": "之后应该也会遇到更多类似的机关，不过对于已经能够妙用「乐章」力量的我们而言，也不会是什么阻碍啦。"
                }
            ]
        },
        {
            "talkId": "6852003",
            "initDialog": "685200301",
            "dialogues": [
                {
                    "id": "685200301",
                    "speaker": "Player",
                    "text": "（摸一摸。）"
                }
            ]
        },
        {
            "talkId": "6852004",
            "initDialog": "685200401",
            "dialogues": [
                {
                    "id": "685200401",
                    "speaker": "Player",
                    "text": "没事。"
                },
                {
                    "id": "685200402",
                    "speaker": "小呜斯",
                    "text": "好吧，有什么想知道的就来问我哦，不用客气！"
                }
            ]
        },
        {
            "talkId": "6852005",
            "initDialog": "685200501",
            "dialogues": [
                {
                    "id": "685200501",
                    "speaker": "小呜斯",
                    "text": "喵喵，相信你们果然没错！"
                }
            ]
        },
        {
            "talkId": "6852006",
            "initDialog": "685200601",
            "dialogues": [
                {
                    "id": "685200601",
                    "speaker": "Player",
                    "text": "关于你和这座城堡…"
                },
                {
                    "id": "685200602",
                    "speaker": "小呜斯",
                    "text": "你们应该也猜到了吧。在过去，我还能自由变换身形的时候，曾经和他…还有众多伙伴们生活在这里。"
                },
                {
                    "id": "685200603",
                    "speaker": "小呜斯",
                    "text": "那时，新的国度刚刚诞生，对于我们而言还有着无数的可能性。"
                },
                {
                    "id": "685200604",
                    "speaker": "小呜斯",
                    "text": "我们在这里整理典籍，研究乐理与魔法，希望能驯服这危险的力量，开启更加光明的时代。"
                },
                {
                    "id": "685200605",
                    "speaker": "小呜斯",
                    "text": "然而…我们很快就失去了那些可能，最后只剩下我一个人在这里…"
                },
                {
                    "id": "685200606",
                    "speaker": "Player",
                    "text": "小呜斯…"
                },
                {
                    "id": "685200607",
                    "speaker": "小呜斯",
                    "text": "没关系，这些都已经过去太久了。"
                }
            ]
        },
        {
            "talkId": "6852007",
            "initDialog": "685200701",
            "dialogues": [
                {
                    "id": "685200701",
                    "speaker": "Player",
                    "text": "（摸一摸。）"
                }
            ]
        },
        {
            "talkId": "6852008",
            "initDialog": "685200801",
            "dialogues": [
                {
                    "id": "685200801",
                    "speaker": "Player",
                    "text": "没事。"
                },
                {
                    "id": "685200802",
                    "speaker": "小呜斯",
                    "text": "好吧，有什么想知道的就来问我哦，不用客气！"
                }
            ]
        }
    ]
