    },
    "talks": [
        {
            "talkId": "6842300",
            "initDialog": "684230001",
            "dialogues": [
                {
                    "id": "684230001",
                    "speaker": "剑匣镖局公告板",
                    "text": "此为剑匣镖局公告板，公告与客人留言皆可张贴此处。"
                }
            ]
        },
        {
            "talkId": "6842301",
            "initDialog": "684230101",
            "dialogues": [
                {
                    "id": "684230101",
                    "speaker": "Player",
                    "text": "继续阅读"
                }
            ]
        },
        {
            "talkId": "6842302",
            "initDialog": "684230201",
            "dialogues": [
                {
                    "id": "684230201",
                    "speaker": "Player",
                    "text": "离开"
                }
            ]
        },
        {
            "talkId": "6842303",
            "initDialog": "684230301",
            "dialogues": [
                {
                    "id": "684230301",
                    "speaker": "留言",
                    "text": "「前日委托的伤药，我已遣学徒送达。还望诸位平时多加保重，莫要意气用事，以免再受这般伤。」"
                },
                {
                    "id": "684230302",
                    "speaker": "回复",
                    "text": "「多谢白大夫关照。我会嘱咐那些小伙子的。」"
                }
            ]
        },
        {
            "talkId": "6842304",
            "initDialog": "684230401",
            "dialogues": [
                {
                    "id": "684230401",
                    "speaker": "留言",
                    "text": "「我要投诉！我要揭发！剑匣镖局名不副实，店大欺客！」"
                },
                {
                    "id": "684230402",
                    "speaker": "留言",
                    "text": "「早在三个月前，我就委托过他们，让他们帮我送去这封饱含心意的告白信…结果直到现在，我都没有收到一点回复！」"
                },
                {
                    "id": "684230403",
                    "speaker": "留言",
                    "text": "「定是镖师玩忽职守，弄丢了我的信！」"
                },
                {
                    "id": "684230404",
                    "speaker": "回复",
                    "text": "「您委托投递的信件早已送达。还望您能够接受现实。」"
                }
            ]
        },
        {
            "talkId": "6842305",
            "initDialog": "684230501",
            "dialogues": [
                {
                    "id": "684230501",
                    "speaker": "留言",
                    "text": "「拜启：百忙之中叨扰，实属抱歉。然而鄙人若松长久醉心于璃月武道，愿效古时的武者，于瀑布下参笼，以悟至极之道…」"
                },
                {
                    "id": "684230502",
                    "speaker": "留言",
                    "text": "「若蒙不弃，恳请各位传授鄙人瀑布修行之秘技，鄙人自心底感谢各位。敬具。」"
                },
                {
                    "id": "684230503",
                    "speaker": "回复",
                    "text": "「哈哈，这位外国来的朋友大抵是有什么误解。这世上哪里会有人在瀑布下面练习武术呢？」"
                },
                {
                    "id": "684230504",
                    "speaker": "回复",
                    "text": "「要是真的对武术感兴趣，不妨先从扎马步开始练起吧！」"
                }
            ]
        },
        {
            "talkId": "6842306",
            "initDialog": "684230601",
            "dialogues": [
                {
                    "id": "684230601",
                    "speaker": "留言",
                    "text": "「前些日子委托运送的轻策新竹，为何迟迟未至？」"
                },
                {
                    "id": "684230602",
                    "speaker": "回复",
                    "text": "「近来氲气稍重，路途有所耽搁，还请稍安勿躁。」"
                }
            ]
        },
        {
            "talkId": "6842307",
            "initDialog": "684230701",
            "dialogues": [
                {
                    "id": "684230701",
                    "speaker": "留言",
                    "text": "「久闻剑匣镖局诸位武艺超群，在下亦略懂舞枪弄棒。登门拜访，愿向诸位讨教一二，还望不吝赐教。」"
                },
                {
                    "id": "684230702",
                    "speaker": "回复",
                    "text": "「抱歉，本镖局近日业务繁忙，实在不便与外人切磋。阁下请回吧。」"
                }
            ]
        },
        {
            "talkId": "6842308",
            "initDialog": "684230801",
            "dialogues": [
                {
                    "id": "684230801",
                    "speaker": "留言",
                    "text": "「唉，前阵子，实在是给你们添麻烦了。要不是那个叫嘉明的小伙子出手搭救，我这把老骨头，恐怕就要交代在山里咯…」"
                },
                {
                    "id": "684230802",
                    "speaker": "回复",
                    "text": "「最近的野兽活动似乎比以往更为频繁。您年事已高，若无必要，最好还是不要再独自深入山间了。」"
                }
            ]
        },
        {
            "talkId": "6842309",
            "initDialog": "684230901",
            "dialogues": [
                {
                    "id": "684230901",
                    "speaker": "留言",
                    "text": "「朋友！你是否渴望探究璃月武学历史的厚重？你是否渴望领略剑侠荡气回肠的情怀？」"
                },
                {
                    "id": "684230902",
                    "speaker": "留言",
                    "text": "「不错，如今正是大好时机！古华派千年重地『王山厅』如今对外开放，诚邀各路英雄豪杰前来观览！」"
                },
                {
                    "id": "684230903",
                    "speaker": "留言",
                    "text": "「机不可失，时不再来，诸位有志之士，请至剑匣镖局一叙！」"
                }
            ]
        },
        {
            "talkId": "6842310",
            "initDialog": "684231001",
            "dialogues": [
                {
                    "id": "684231001",
                    "speaker": "招聘启事",
                    "text": "诚聘镖师，包吃包住，待遇优厚。"
                },
                {
                    "id": "684231002",
                    "speaker": "招聘启事",
                    "text": "要求身强体壮，能够吃苦耐劳。有意者请至镖局面议。"
                }
            ]
        },
        {
            "talkId": "6842311",
            "initDialog": "684231101",
            "dialogues": [
                {
                    "id": "684231101",
                    "speaker": "留言",
                    "text": "「欸？原来璃月的镖师还会兼职进行艺术表演吗？」"
                },
                {
                    "id": "684231102",
                    "speaker": "留言",
                    "text": "「那个叫什么来着…呃，舞兽？」"
                },
                {
                    "id": "684231103",
                    "speaker": "回复",
                    "text": "「哈哈，您要是看到我们的镖师参与其中，也大可不必感到惊奇——毕竟，谁不喜欢热热闹闹的欢快氛围呢？」"
                }
            ]
        },
        {
            "talkId": "6842312",
            "initDialog": "684231201",
            "dialogues": [
                {
                    "id": "684231201",
                    "speaker": "剑匣镖局广告",
                    "text": "您是否担心贵重商品会在运输途中被盗匪所劫？您是否担心独自行走在山林间会被野兽所伤？"
                },
                {
                    "id": "684231202",
                    "speaker": "剑匣镖局广告",
                    "text": "剑匣镖局，保您无虑！押运配送，百般精通！"
                },
                {
                    "id": "684231203",
                    "speaker": "剑匣镖局广告",
                    "text": "注：隐瞒镖码内容造成的一切后果，均由客户自行承担。"
                }
            ]
        }
    ]
}