                {
                    "id": "683491001",
                    "speaker": "无名的石碑·其七",
                    "text": "「…大镇灵利露帕尔，心肠歹毒，常怀颠覆之意，望僭主基斯拉多加警惕…」"
                },
                {
                    "id": "683491002",
                    "speaker": "无名的石碑·其七",
                    "text": "「…这是菲莉吉丝最终的警告。」"
                }
            ]
        }
