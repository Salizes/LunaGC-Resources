    "talks": [
        {
            "talkId": "6854101",
            "initDialog": "685410101",
            "dialogues": [
                {
                    "id": "685410101",
                    "speaker": "荒泷一斗",
                    "text": "来，这是你们的零花钱。"
                },
                {
                    "id": "685410102",
                    "speaker": "阿守",
                    "text": "哇！我有想买的轻小说！"
                },
                {
                    "id": "685410103",
                    "speaker": "元太",
                    "text": "嗯…要不要先存起来？"
                },
                {
                    "id": "685410104",
                    "speaker": "阿晃",
                    "text": "不如去买串串三味吧！"
                },
                {
                    "id": "685410105",
                    "speaker": "荒泷一斗",
                    "text": "……！"
                },
                {
                    "id": "685410106",
                    "speaker": "阿守",
                    "text": "就这么定吧！谢谢老大！"
                },
                {
                    "id": "685410107",
                    "speaker": "荒泷一斗",
                    "text": "……！！！"
                },
                {
                    "id": "685410108",
                    "speaker": "元太",
                    "text": "老…老大？"
                },
                {
                    "id": "685410109",
                    "speaker": "荒泷一斗",
                    "text": "——给你们零花钱是为了什么啊！"
                },
                {
                    "id": "685410110",
                    "speaker": "荒泷一斗",
                    "text": "要买的话…当然是买「七圣召唤」新卡组啦！"
                },
                {
                    "id": "685410111",
                    "speaker": "众人",
                    "text": "「七圣召唤」，赢家永远在胜利的路上！"
                },
                {
                    "id": "685410112",
                    "speaker": "久岐忍",
                    "text": "所以你们有人赢过我了吗…？"
                }
            ]
        }
    ]
}