    "talks": [
        {
            "talkId": "6834000",
            "initDialog": "683400001",
            "dialogues": [
                {
                    "id": "683400001",
                    "speaker": "无名的石碑",
                    "text": "（一尊完整的石碑，其上雕刻着无法破译的优雅文字。）"
                }
            ]
        },
        {
            "talkId": "6834100",
            "initDialog": "683410001",
            "dialogues": [
                {
                    "id": "683410001",
                    "speaker": "无名的石碑·其二",
                    "text": "「希琳，我的女儿，我未尝得享一日幸福的女儿…」"
                },
                {
                    "id": "683410002",
                    "speaker": "无名的石碑·其二",
                    "text": "「居尔城的兴衰因你而起，因你而终，你无辜而受难，疯狂成为归宿…」"
                },
                {
                    "id": "683410003",
                    "speaker": "无名的石碑·其二",
                    "text": "「你无辜受难，疯狂破碎的心智也被胞兄抽离，用以制造破碎无心智的奴隶…」"
                },
                {
                    "id": "683410004",
                    "speaker": "无名的石碑·其二",
                    "text": "「你无辜受难，最终比任何人都更完整地见证了居尔城疯狂的结局…」"
                },
                {
                    "id": "683410005",
                    "speaker": "无名的石碑·其二",
                    "text": "「请原谅我，希琳。」"
                }
            ]
        }
    ]
}