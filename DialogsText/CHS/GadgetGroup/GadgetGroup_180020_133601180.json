    "talks": [
        {
            "talkId": "6862513",
            "initDialog": "686251301",
            "dialogues": [
                {
                    "id": "686251301",
                    "speaker": "纪念碑",
                    "text": "执灯人在此郑重立下誓言："
                }
            ]
        },
        {
            "talkId": "6862514",
            "initDialog": "686251408",
            "dialogues": [
                {
                    "id": "686251408",
                    "speaker": "<UNKNOWN>",
                    "text": "<color=#00E1FFFF>仔细辨认</color>"
                },
                {
                    "id": "686251401",
                    "speaker": "纪念碑",
                    "text": "<color=#00E1FFFF>「如是我预见：\\n「海浪翻起白沫，死寂毁灭了星月夜；</color>"
                },
                {
                    "id": "686251402",
                    "speaker": "纪念碑",
                    "text": "<color=#00E1FFFF>「如是我宣告：\\n「谁掌中灯火不灭，就不必陷入如此黑暗；</color>"
                },
                {
                    "id": "686251403",
                    "speaker": "纪念碑",
                    "text": "<color=#00E1FFFF>「如是我立誓：\\n「我们将使骨血做燃料，我们将使生大于死。</color>"
                },
                {
                    "id": "686251404",
                    "speaker": "纪念碑",
                    "text": "<color=#00E1FFFF>「风已醒来，落叶飞旋；\\n「腾空你心中归于生者的幻梦。</color>"
                },
                {
                    "id": "686251405",
                    "speaker": "纪念碑",
                    "text": "<color=#00E1FFFF>「我们面颊苍白，发丝飘飞，眼眸闪灼；</color>"
                },
                {
                    "id": "686251406",
                    "speaker": "纪念碑",
                    "text": "<color=#00E1FFFF>「我们拨开天之雪幕，我们将荒原上的朔风吹响。</color>"
                },
                {
                    "id": "686251407",
                    "speaker": "纪念碑",
                    "text": "<color=#00E1FFFF>「我们是执灯人，无尽雪原中执灯守护永燃的希望。」</color>"
                }
            ]
        },
        {
            "talkId": "6862533",
            "initDialog": "686253301",
            "dialogues": [
                {
                    "id": "686253301",
                    "speaker": "纪念碑",
                    "text": "「如是…"
                },
                {
                    "id": "686253302",
                    "speaker": "纪念碑",
                    "text": "「…星月夜。」"
                }
            ]
        }
    ]
}