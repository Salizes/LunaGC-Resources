    "talks": [
        {
            "talkId": "6844300",
            "initDialog": "684430001",
            "dialogues": [
                {
                    "id": "684430001",
                    "speaker": "货仓通知",
                    "text": "「……」"
                },
                {
                    "id": "684430002",
                    "speaker": "货仓通知",
                    "text": "「…此处山洞为临时货仓，请勿在这里堆放除重要商品外任何杂物！」"
                },
                {
                    "id": "684430003",
                    "speaker": "货仓通知",
                    "text": "「……」"
                },
                {
                    "id": "684430004",
                    "speaker": "货仓通知",
                    "text": "「…近来翘英庄忙于解决茶叶问题，后山看守遗迹的村民少了许多，我们可以将近期发掘的古董暂存此处，以茶叶制品为掩护进行运送。」"
                },
                {
                    "id": "684430005",
                    "speaker": "货仓通知",
                    "text": "「……」"
                },
                {
                    "id": "684430006",
                    "speaker": "货仓通知",
                    "text": "「…土生发现了一个带驮兽的商人，或许可以妥善利用来为我们运输货物…」"
                },
                {
                    "id": "684430007",
                    "speaker": "货仓通知",
                    "text": "「…重要：不要随便敲打山洞深处的大铁坨！」"
                }
            ]
        }
    ]
}