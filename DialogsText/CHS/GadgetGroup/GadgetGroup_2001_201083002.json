            "dialogues": [
                {
                    "id": "740350801",
                    "speaker": "艾尤恩",
                    "text": "太好了，这下我可以继续工作了，今天一定要把这篇倡议书写出来。"
                },
                {
                    "id": "740350802",
                    "speaker": "艾尤恩",
                    "text": "太感谢你了，等我有空了，一定要请你吃一顿好的。"
                },
                {
                    "id": "740350807",
                    "speaker": "艾尤恩",
                    "text": "明天您有空吗？如果有的话，就来这里找我吧。"
                },
                {
                    "id": "740350808",
                    "speaker": "艾尤恩",
                    "text": "等我完成了工作，咱们就出去好好吃一顿！",
                    "choices": [
                        {
                            "id": "740350803",
                            "text": "那我就等着了。",
                            "response": [
                                {
                                    "id": "740350805",
                                    "speaker": "艾尤恩",
                                    "text": "你说得对，我必须再加快点速度…"
                                },
                                {
                                    "id": "740350806",
                                    "speaker": "艾尤恩",
                                    "text": "等会，下一句是什么来着？我应该用笔记下来了…"
                                }
                            ]
                        },
                        {
                            "id": "740350804",
                            "text": "你先把工作忙完吧。"
                        }
                    ]
                }
            ]
        }
    ]
