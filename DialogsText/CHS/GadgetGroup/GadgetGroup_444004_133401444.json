            "dialogues": [
                {
                    "id": "684010001",
                    "speaker": "德波大饭店公告",
                    "text": "光与影相互交织，梦境与真实融为一体。而你是否能够看穿，魔术之下所隐藏的真意？"
                },
                {
                    "id": "684010002",
                    "speaker": "德波大饭店公告",
                    "text": "今夜，枫丹廷最耀眼的双子星，为你揭秘！"
