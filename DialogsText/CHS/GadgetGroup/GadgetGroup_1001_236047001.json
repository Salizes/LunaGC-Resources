            "dialogues": [
                {
                    "id": "685410201",
                    "speaker": "锅巴",
                    "text": "♪~♪~♪~"
                },
                {
                    "id": "685410202",
                    "speaker": "卯师傅",
                    "text": "亲朋聚宴哪家强？吃虎岩找万民堂！"
                },
                {
                    "id": "685410203",
                    "speaker": "卯师傅",
                    "text": "璃月厨王掌厨房，菜品质量有保障！"
                },
                {
                    "id": "685410204",
                    "speaker": "卯师傅",
                    "text": "服务热情更在行，欢声笑语聚满堂！"
                },
                {
                    "id": "685410205",
                    "speaker": "申鹤",
                    "text": "早中晚饭哪家尝？吃虎岩找万民堂。"
                },
                {
                    "id": "685410206",
                    "speaker": "申鹤",
                    "text": "价格便宜又实惠，佳肴美味又不贵。"
                },
                {
                    "id": "685410207",
                    "speaker": "申鹤",
                    "text": "一日三餐顿顿享，只把下馆当家常。"
                },
                {
                    "id": "685410208",
                    "speaker": "香菱",
                    "text": "新鲜口味哪家香？吃虎岩找万民堂！"
                },
                {
                    "id": "685410209",
                    "speaker": "香菱",
                    "text": "璃菜月菜创新菜，准有一款你的菜。"
                },
                {
                    "id": "685410210",
                    "speaker": "香菱",
                    "text": "锅香一起飘四方，仙人尝了也跳墙！"
                },
                {
                    "id": "685410211",
                    "speaker": "众人",
                    "text": "——吃饭，就选万民堂！"
                },
                {
                    "id": "685410212",
                    "speaker": "锅巴",
                    "text": "♪~♪！"
                },
                {
                    "id": "685410213",
                    "speaker": "香菱",
                    "text": "啊——锅巴你又偷吃了！"
                }
            ]
        }
    ]
}