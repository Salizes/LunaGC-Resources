{
    "groupId": "356002_133401356",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "决斗代理人评价栏目": 21
    },
    "talks": [
        {
            "talkId": "7450406",
            "initDialog": "745040601",
            "dialogues": [
                {
                    "id": "745040601",
                    "speaker": "决斗代理人评价栏目",
                    "text": "全新企划现已开启，震撼玩具等你探索，火爆预购进行中，快留下您的宝贵建议。——莱舒的发条工坊。"
                }
            ]
        },
        {
            "talkId": "7450407",
            "initDialog": "745040701",
            "dialogues": [
                {
                    "id": "745040701",
                    "speaker": "决斗代理人评价栏目",
                    "text": "愤怒的留言"
                },
                {
                    "id": "745040702",
                    "speaker": "决斗代理人评价栏目",
                    "text": "「又来预购？又来抢先体验版？莱舒的发条工坊已经大不如前了，别被骗钱，大家快跑。」"
                }
            ]
        },
        {
            "talkId": "7450408",
            "initDialog": "745040801",
            "dialogues": [
                {
                    "id": "745040801",
                    "speaker": "决斗代理人评价栏目",
                    "text": "诚恳的留言"
                },
                {
                    "id": "745040802",
                    "speaker": "决斗代理人评价栏目",
                    "text": "「杰作。无可挑剔的。毫无置疑的。令人泪目的。此生必玩的。我这么说大家心里有数了吧？」"
                }
            ]
        },
        {
            "talkId": "7450409",
            "initDialog": "745040901",
            "dialogues": [
                {
                    "id": "745040901",
                    "speaker": "决斗代理人评价栏目",
                    "text": "标准的留言"
                },
                {
                    "id": "745040902",
                    "speaker": "决斗代理人评价栏目",
                    "text": "「我朋友就在制作团队，打听了一下，这个企划内部代号001，老板亲自带队，神作预定。」"
                }
            ]
        },
        {
            "talkId": "7450410",
            "initDialog": "745041001",
            "dialogues": [
                {
                    "id": "745041001",
                    "speaker": "决斗代理人评价栏目",
                    "text": "匆忙的留言"
                },
                {
                    "id": "745041002",
                    "speaker": "决斗代理人评价栏目",
                    "text": "「我朋友就在制作团队，打听了一下，这个企划内部代号001，老板亲自带队，神作预定。（一条五百摩拉）」"
                }
            ]
        },
        {
            "talkId": "7450411",
            "initDialog": "745041101",
            "dialogues": [
                {
                    "id": "745041101",
                    "speaker": "决斗代理人评价栏目",
                    "text": "兴奋的留言"
                },
                {
                    "id": "745041102",
                    "speaker": "决斗代理人评价栏目",
                    "text": "「决斗代理人是个好题材，还没玩过这种，一定要提供换装玩法！清凉一点的！」"
                }
            ]
        },
        {
            "talkId": "7450412",
            "initDialog": "745041201",
            "dialogues": [
                {
                    "id": "745041201",
                    "speaker": "决斗代理人评价栏目",
                    "text": "专业的留言"
                },
                {
                    "id": "745041202",
                    "speaker": "决斗代理人评价栏目",
                    "text": "「看了下玩具战斗模块的设计，跟普通的冒险家玩具差不多，没有体现决斗代理人的特色。」"
                },
                {
                    "id": "745041203",
                    "speaker": "决斗代理人评价栏目",
                    "text": "「玩具关节的灵活度来自于一万次的水下冲刺模拟，这块也不明所以，哪个决斗代理人是在水下训练的？」"
                },
                {
                    "id": "745041204",
                    "speaker": "决斗代理人评价栏目",
                    "text": "「感觉就是个换皮玩具，没有诚意，没有灵魂。总体评价是：不如隔壁勒波特钟表店。」"
                }
            ]
        },
        {
            "talkId": "7450413",
            "initDialog": "745041301",
            "dialogues": [
                {
                    "id": "745041301",
                    "speaker": "决斗代理人评价栏目",
                    "text": "意外的留言"
                },
                {
                    "id": "745041302",
                    "speaker": "决斗代理人评价栏目",
                    "text": "「相比之下，我对店门口那几只企鹅更有兴趣。希望店家能够联系我，有合作可以谈谈。」"
                }
            ]
        },
        {
            "talkId": "7450414",
            "initDialog": "745041401",
            "dialogues": [
                {
                    "id": "745041401",
                    "speaker": "决斗代理人评价栏目",
                    "text": "字迹可爱的留言"
                },
                {
                    "id": "745041402",
                    "speaker": "决斗代理人评价栏目",
                    "text": "「这里是美露莘精灵，所有看到这条留言的朋友都可以免费得到一只美露莘~」"
                }
            ]
        },
        {
            "talkId": "7450415",
            "initDialog": "745041501",
            "dialogues": [
                {
                    "id": "745041501",
                    "speaker": "决斗代理人评价栏目",
                    "text": "更多…"
                }
            ]
        },
        {
            "talkId": "7450416",
            "initDialog": "745041601",
            "dialogues": [
                {
                    "id": "745041601",
                    "speaker": "决斗代理人评价栏目",
                    "text": "离开"
                }
            ]
        }
    ]
}