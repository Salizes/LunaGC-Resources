            "dialogues": [
                {
                    "id": "684120301",
                    "speaker": "被丢弃的账单",
                    "text": "（被随意丢弃在吧台上的账单，在纸张一角有着潦草的涂改痕迹。）"
                },
                {
                    "id": "684120302",
                    "speaker": "被丢弃的账单",
                    "text": "「…从璃月来的三批货…很重…布雷克清点过了…」"
                },
                {
                    "id": "684120303",
                    "speaker": "被丢弃的账单",
                    "text": "「…我们的璃月朋友一只脚踩在桥上了，得叫人拉他们一把…」"
                }
            ]
        }
    ]
}