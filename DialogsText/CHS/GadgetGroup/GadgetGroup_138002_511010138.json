{
    "groupId": "138002_511010138",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "呜斯先生": 6
    },
    "talks": [
        {
            "talkId": "6850001",
            "initDialog": "685000101",
            "dialogues": [
                {
                    "id": "685000101",
                    "speaker": "呜斯先生",
                    "text": "那些灵魂…过去的阴影还残留在这里…如果能够打倒波爱修斯的话，他们或许也能得以安息…",
                    "choices": [
                        {
                            "id": "685000102",
                            "text": "他们的灵魂为什么会…",
                            "response": [
                                {
                                    "id": "685000103",
                                    "speaker": "呜斯先生",
                                    "text": "执念？妄念？无论如何，至尊所造的身躯成了供我们逃避的庇护所。"
                                },
                                {
                                    "id": "685000104",
                                    "speaker": "呜斯先生",
                                    "text": "就如他所希望的那样，大海再不能夺走我们的灵魂与生命…但我们的灵魂却也因此愈加沉重。"
                                },
                                {
                                    "id": "685000105",
                                    "speaker": "呜斯先生",
                                    "text": "如今躲藏在深水之下的我的同族们，与其说是被「乐章」所禁锢，倒不如说和波爱修斯一样，是被自己的执念束缚在这里。"
                                },
                                {
                                    "id": "685000106",
                                    "speaker": "呜斯先生",
                                    "text": "实在可悲…"
                                }
                            ]
                        },
                        {
                            "id": "685000107",
                            "text": "（摸一摸。）"
                        },
                        {
                            "id": "685000108",
                            "text": "没事。",
                            "response": [
                                {
                                    "id": "685000109",
                                    "speaker": "呜斯先生",
                                    "text": "好吧，有什么想知道的就来问我哦，不用客气！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}