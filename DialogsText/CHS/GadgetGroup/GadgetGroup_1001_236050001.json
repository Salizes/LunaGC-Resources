{
    "groupId": "1001_236050001",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "主持人": 3,
        "克洛琳德": 1,
        "娜维娅": 4,
        "林尼": 1,
        "琳妮特": 1,
        "芙宁娜": 1
    },
    "talks": [
        {
            "talkId": "6854105",
            "initDialog": "685410501",
            "dialogues": [
                {
                    "id": "685410501",
                    "speaker": "主持人",
                    "text": "…为了寻找传说中的宝藏，你们找到一位神情紧张的商人，她看起来格外警戒…"
                },
                {
                    "id": "685410502",
                    "speaker": "娜维娅",
                    "text": "——我可以对她使用「说服」吗？"
                },
                {
                    "id": "685410503",
                    "speaker": "主持人",
                    "text": "…商人指引着你们踏上旅途，但一个凶神恶煞的坚盾重甲蟹拦在了你们面前。"
                },
                {
                    "id": "685410504",
                    "speaker": "娜维娅",
                    "text": "——我可以对它使用「说服」吗？"
                },
                {
                    "id": "685410505",
                    "speaker": "主持人",
                    "text": "…凭借重甲蟹交代的线索，你们终于找到了宝藏，但一株身缠寒气的急冻树正盘踞于上。"
                },
                {
                    "id": "685410506",
                    "speaker": "娜维娅",
                    "text": "——我可以对它使用「说服」吗！"
                },
                {
                    "id": "685410507",
                    "speaker": "芙宁娜",
                    "text": "等等等一下！再怎么说也不可能对植物用「说服」吧！"
                },
                {
                    "id": "685410508",
                    "speaker": "娜维娅",
                    "text": "没问题！我这次有带「植物交谈」——啊，顺便一提检定牌还是二十。"
                },
                {
                    "id": "685410509",
                    "speaker": "克洛琳德",
                    "text": "…好吧。急冻树羞愧地钻进地里，向你们交出了宝藏。"
                },
                {
                    "id": "685410510",
                    "speaker": "林尼",
                    "text": "——自由冒险，欢乐无限！"
                },
                {
                    "id": "685410511",
                    "speaker": "琳妮特",
                    "text": "…桌上剧团，等你来玩。"
                }
            ]
        }
    ]
}