            "dialogues": [
                {
                    "id": "190603301",
                    "speaker": "嫌疑人龙二的定罪书",
                    "text": "嫌疑人龙二，年龄二十，奉行所同心，系死者鹰司勇下属。"
                },
                {
                    "id": "190603302",
                    "speaker": "嫌疑人龙二的定罪书",
                    "text": "因与上司鹰司勇的工作冲突，心生怨恨，秘密购置特殊毒药一瓶。仇恨杀人。"
                },
                {
                    "id": "190603303",
                    "speaker": "嫌疑人龙二的定罪书",
                    "text": "后在嫌疑人龙二家中搜出未使用完的毒药。嫌疑人龙二恶意杀害他人，暂押入狱，听候发落，留档为证。"
                },
                {
                    "id": "190603304",
                    "speaker": "嫌疑人龙二的定罪书",
                    "text": "签署人：九条裟罗。"
                },
                {
                    "id": "190603305",
                    "speaker": "派蒙",
                    "text": "呜哇，龙二的定罪书真的是九条裟罗签的…不过现在看，这里面的内容应该是错误的吧。"
                }
            ]
        }
    ]
}