    "dialogues": [
        {
            "id": "680038201",
            "speaker": "朱丽夜",
            "text": "怎么会这样，呜呜，早知道我就不说去散步了…"
        },
        {
            "id": "680038202",
            "speaker": "Player",
            "text": "发生什么了？"
        },
        {
            "id": "680038203",
            "speaker": "朱丽夜",
            "text": "我、我和我的朋友去周围散步，没想到有丘丘人突然出现…"
        },
        {
            "id": "680038204",
            "speaker": "朱丽夜",
            "text": "我的朋友他，他为了保护我，被丘丘人抓走了…"
        },
        {
            "id": "680038205",
            "speaker": "Player",
            "text": "丘丘人到哪去了？"
        },
        {
            "id": "680038206",
            "speaker": "朱丽夜",
            "text": "我没有看清…但是肯定还在这个岛上…呜呜，该怎么办才好啊…"
        }
    ]
}