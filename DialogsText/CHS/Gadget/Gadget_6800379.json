{
    "talkId": "6800379",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "夜鸦乘务员": 8
    },
    "dialogues": [
        {
            "id": "680037901",
            "speaker": "夜鸦乘务员",
            "text": "客人，我看看，您已通过夜鸦航线来往数次…"
        },
        {
            "id": "680037902",
            "speaker": "夜鸦乘务员",
            "text": "实不相瞒，我在这里想进行一次调查，您觉得夜鸦航线的服务质量如何？",
            "choices": [
                {
                    "id": "680037903",
                    "text": "非常棒。",
                    "response": [
                        {
                            "id": "680037904",
                            "speaker": "夜鸦乘务员",
                            "text": "能够得到您的认可，真是令人内心欣喜。"
                        },
                        {
                            "id": "680037907",
                            "speaker": "夜鸦乘务员",
                            "text": "嗯，下一个问题是这样，请问您觉得我们的乘务员服务态度如何？",
                            "choices": [
                                {
                                    "id": "680037908",
                                    "text": "非常周到！",
                                    "response": [
                                        {
                                            "id": "680037909",
                                            "speaker": "夜鸦乘务员",
                                            "text": "那真是太棒了，能让您满意就是我们的荣幸。"
                                        },
                                        {
                                            "id": "680037912",
                                            "speaker": "夜鸦乘务员",
                                            "text": "感谢您的回答，您的宝贵意见对我们来说非常重要，祝您玩的开心！"
                                        }
                                    ]
                                },
                                {
                                    "id": "680037910",
                                    "text": "没有宾至如归的感觉…",
                                    "response": [
                                        {
                                            "id": "680037911",
                                            "speaker": "夜鸦乘务员",
                                            "text": "原来如此，还有尚且有没做到位的地方吗…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "680037905",
                    "text": "不行，不是很常用。",
                    "response": [
                        {
                            "id": "680037906",
                            "speaker": "夜鸦乘务员",
                            "text": "唔，难道是路线安排有什么问题吗…"
                        }
                    ]
                }
            ]
        }
    ]
}