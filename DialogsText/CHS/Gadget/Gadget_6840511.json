    "dialogues": [
        {
            "id": "684051101",
            "speaker": "卡兰德拉服装店",
            "text": "最新的日常服饰，最舒适的穿着体验。"
        },
        {
            "id": "684051102",
            "speaker": "卡兰德拉服装店",
            "text": "卡兰德拉服装店，最懂您的服装店。"
        },
        {
            "id": "684051103",
            "speaker": "故意潦草的笔迹",
            "text": "「Gusha！Yaya ika！」"
        },
        {
            "id": "684051104",
            "speaker": "卡兰德拉服装店",
            "text": "「不好意思，我们的店员并不懂您所说的语言。」"
        },
        {
            "id": "684051105",
            "speaker": "故意潦草的笔迹",
            "text": "「那你们还说懂我？！」"
        },
        {
            "id": "684051106",
            "speaker": "修改后的广告",
            "text": "卡兰德拉服装店，最懂枫丹人需求的服装店。"
        }
    ]
