    "dialogues": [
        {
            "id": "684480001",
            "speaker": "古剑士铭文·其三",
            "text": "「…拂剑舞秋月，高咏嗟叹连…」"
        },
        {
            "id": "684480002",
            "speaker": "古剑士铭文·其三",
            "text": "「…清水仙居处，白石何离离…」"
        },
        {
            "id": "684480003",
            "speaker": "古剑士铭文·其三",
            "text": "「…脱帽与君笑，酌酒为君吟…」"
        }
    ]
}