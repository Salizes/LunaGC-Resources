    "dialogues": [
        {
            "id": "684081101",
            "speaker": "稚嫩的笔迹",
            "text": "「法斯捷大哥他好威猛，究竟该怎么努力才能变得更他一样强壮啊？」"
        },
        {
            "id": "684081102",
            "speaker": "另一人的留言",
            "text": "「你别看他现在这个样子。以前他可是瘦的不行呢。自从他被送进梅洛彼得堡以后才变成了现在这个样子。」"
        },
        {
            "id": "684081103",
            "speaker": "稚嫩的笔迹",
            "text": "「哇！我也要去梅洛彼得堡！」"
        },
        {
            "id": "684081104",
            "speaker": "另一人的留言",
            "text": "「这个可太简单了，你只用…」"
        },
        {
            "id": "684081105",
            "speaker": "法斯捷",
            "text": "「你别听这个人胡说，你只要好好吃饭，好好运动就可以强壮起来的！」"
        }
    ]
}