        {
            "id": "684071101",
            "speaker": "蒸汽鸟报文化艺术版",
            "text": "「时尚人物志：梅琪妮」"
        },
        {
            "id": "684071102",
            "speaker": "蒸汽鸟报文化艺术版",
            "text": "没有任何人会质疑，梅琪妮女士与她的白棠珍奇屋在枫丹时装设计界的地位。可以说正是她定义了何为枫丹的「时尚」。"
        },
        {
            "id": "684071103",
            "speaker": "蒸汽鸟报文化艺术版",
            "text": "当记者问及她的创新理念时，她回答道：「灵感源自于那些被人遗忘旧物件。因为唯有那些被彻底遗忘之物，才是崭新之物。」"
        },
        {
            "id": "684071104",
            "speaker": "蒸汽鸟报文化艺术版",
            "text": "……"
        }
    ]
}