    "dialogues": [
        {
            "id": "684470001",
            "speaker": "古剑士铭文·其二",
            "text": "「…倚剑登高台，悠悠极远目…」"
        },
        {
            "id": "684470002",
            "speaker": "古剑士铭文·其二",
            "text": "「…珍木盖层丘，琼池隐深谷…」"
        },
        {
            "id": "684470003",
            "speaker": "古剑士铭文·其二",
            "text": "「…归来怆途穷，日暮方恸哭…」"
        }
    ]
}