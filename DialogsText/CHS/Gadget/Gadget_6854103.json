    "dialogues": [
        {
            "id": "685410301",
            "speaker": "砂糖",
            "text": "…这样的药剂没问题吗？"
        },
        {
            "id": "685410302",
            "speaker": "诺艾尔",
            "text": "没关系，能行的！大概…"
        },
        {
            "id": "685410303",
            "speaker": "丘丘人",
            "text": "——Ya ika！"
        },
        {
            "id": "685410304",
            "speaker": "诺艾尔",
            "text": "唔唔…昨天复习得太晚…没休息好…"
        },
        {
            "id": "685410305",
            "speaker": "蒂玛乌斯",
            "text": "呵——看起来眼熟吗？"
        },
        {
            "id": "685410306",
            "speaker": "蒂玛乌斯",
            "text": "这样的场景，此时此刻正在蒙德各地上演！您，可能就是下一个。"
        },
        {
            "id": "685410307",
            "speaker": "蒂玛乌斯",
            "text": "除非您在出战前，做出最重要的选择…"
        },
        {
            "id": "685410308",
            "speaker": "砂糖",
            "text": "…这样的药剂没问题吗？"
        },
        {
            "id": "685410309",
            "speaker": "诺艾尔",
            "text": "…请给我最好的药剂！"
        },
        {
            "id": "685410310",
            "speaker": "丘丘人",
            "text": "——Ya ika！"
        },
        {
            "id": "685410311",
            "speaker": "诺艾尔",
            "text": "准备好——要全都打扫干净了！"
        },
        {
            "id": "685410312",
            "speaker": "蒂玛乌斯",
            "text": "扫除疲惫，做回自己！西风骑士团特许炼金药剂，给您安心，让您放心。"
        }
    ]
}