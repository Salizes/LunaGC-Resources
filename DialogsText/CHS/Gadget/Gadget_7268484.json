    "dialogues": [
        {
            "id": "726848401",
            "speaker": "荒泷豪鼓祭安全预案",
            "text": "「发生火情，速速浇水。」"
        },
        {
            "id": "726848402",
            "speaker": "荒泷豪鼓祭安全预案",
            "text": "「发生踩踏，疏散人群。」"
        },
        {
            "id": "726848403",
            "speaker": "荒泷豪鼓祭安全预案",
            "text": "「常备药物，谨防急病。」"
        },
        {
            "id": "726848404",
            "speaker": "荒泷豪鼓祭安全预案",
            "text": "「…………  」"
        },
        {
            "id": "726848405",
            "speaker": "荒泷豪鼓祭安全预案",
            "text": "「越写越多了啊忍姐，根本写不完啊，而且…审批用不着这么多吧？」"
        },
        {
            "id": "726848406",
            "speaker": "荒泷豪鼓祭安全预案",
            "text": "「让你写你就写，我和老大不在的时候，你们就得按着这个来，懂吗？快写！」"
        }
    ]
}