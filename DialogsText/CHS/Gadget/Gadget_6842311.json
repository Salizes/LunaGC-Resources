    "dialogues": [
        {
            "id": "684231101",
            "speaker": "留言",
            "text": "「欸？原来璃月的镖师还会兼职进行艺术表演吗？」"
        },
        {
            "id": "684231102",
            "speaker": "留言",
            "text": "「那个叫什么来着…呃，舞兽？」"
        },
        {
            "id": "684231103",
            "speaker": "回复",
            "text": "「哈哈，您要是看到我们的镖师参与其中，也大可不必感到惊奇——毕竟，谁不喜欢热热闹闹的欢快氛围呢？」"
        }
    ]
}