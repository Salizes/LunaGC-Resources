    "dialogues": [
        {
            "id": "680040701",
            "speaker": "有相当年头的记事",
            "text": "（似乎是最近被搜刮的愚人众翻出来的记事。因为年岁，大部分文本已经无法辨识了。）"
        },
        {
            "id": "680040702",
            "speaker": "有相当年头的记事",
            "text": "「…目付大人购买玉钢锭若干…」"
        },
        {
            "id": "680040703",
            "speaker": "有相当年头的记事",
            "text": "「…与造兵司佑大人、桂木大人彻夜讨论锻冶心得。」"
        }
    ]
}