{
    "talkId": "6850003",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "无名的石像": 9
    },
    "dialogues": [
        {
            "id": "685000301",
            "speaker": "无名的石像",
            "text": "「福波斯」引领你来到了这里，金发的异邦人。",
            "choices": [
                {
                    "id": "685000302",
                    "text": "你是…",
                    "response": [
                        {
                            "id": "685000303",
                            "speaker": "无名的石像",
                            "text": "我名为卢修斯·帕特里西乌斯，帝国的乐师。"
                        },
                        {
                            "id": "685000304",
                            "speaker": "无名的石像",
                            "text": "不必感到警惕，异邦人。与那些沉溺在梦中的同胞不同，我们依然能够维持自身音律的安宁。"
                        }
                    ]
                },
                {
                    "id": "685000305",
                    "text": "这里是…",
                    "response": [
                        {
                            "id": "685000306",
                            "speaker": "无名的石像",
                            "text": "这里曾是帝国最为繁荣的港口，安提库港。如今，这里是我们的坟墓。"
                        },
                        {
                            "id": "685000307",
                            "speaker": "无名的石像",
                            "text": "若是要寻找昔日驱散无尽海雾的铜钟，就请向上走吧。愿时岁与锈迹尚未将她吞噬殆尽。"
                        }
                    ]
                },
                {
                    "id": "685000308",
                    "text": "你的语气好像很平静…",
                    "response": [
                        {
                            "id": "685000309",
                            "speaker": "无名的石像",
                            "text": "无论是帝国的覆灭，还是神王的殒落，一切都是命中注定的事情。试图对那些原本由命运决定的东西产生情绪是不明智的。"
                        },
                        {
                            "id": "685000310",
                            "speaker": "无名的石像",
                            "text": "何必要为生活的一部分感到痛苦呢？生命的每一刻都值得让人潸然泪下。"
                        },
                        {
                            "id": "685000311",
                            "speaker": "无名的石像",
                            "text": "更何况，悲伤与怨恨又有什么益处，若是惩罚无法将罪愆抹去？"
                        }
                    ]
                },
                {
                    "id": "685000312",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "685000313",
                            "speaker": "无名的石像",
                            "text": "再见，金发的异邦人，愿你的音律安宁。"
                        }
                    ]
                }
            ]
        }
    ]
}