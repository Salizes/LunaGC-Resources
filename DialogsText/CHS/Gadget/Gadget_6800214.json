        "回声海螺": 5
    },
    "dialogues": [
        {
            "id": "680021401",
            "speaker": "回声海螺",
            "text": "「今天尝试了固定方向行驶，但无论如何，船都会回到出发点，原因不明…」"
        },
        {
            "id": "680021402",
            "speaker": "回声海螺",
            "text": "「早说了，我们在这里这么多年，能试的方法全都试过。」"
        },
        {
            "id": "680021403",
            "speaker": "回声海螺",
            "text": "「你们岛民本来就不是做这行的，我们才是名扬四海的稻妻海盗，航海问题，应该多参考我们的专家意见吧？」"
        },
        {
            "id": "680021404",
            "speaker": "回声海螺",
            "text": "「搁浅在群岛的专家？」"
        },
        {
            "id": "680021405",
            "speaker": "回声海螺",
            "text": "「…哼！」"
        }
    ]
}