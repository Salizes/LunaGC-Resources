{
    "talkId": "6800358",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "温柔骑士鸦": 6
    },
    "dialogues": [
        {
            "id": "680035801",
            "speaker": "温柔骑士鸦",
            "text": "天空真是伟大啊，能够包容一切，却又具有如此威严…真希望我也能有一天，可以如天空一样。"
        },
        {
            "id": "680035802",
            "speaker": "温柔骑士鸦",
            "text": "…"
        },
        {
            "id": "680035803",
            "speaker": "温柔骑士鸦",
            "text": "哈，如梦一般的，将入夜幕的夏日…如果能一直如此就好了…"
        },
        {
            "id": "680035804",
            "speaker": "温柔骑士鸦",
            "text": "然而夏日短暂啊，旅人…那些快乐的日子，童年，与友人同度的过去，追逐嬉戏的时光，仿佛眨眼之间，倏忽而过…"
        },
        {
            "id": "680035805",
            "speaker": "温柔骑士鸦",
            "text": "…旅人啊，你会记得这个夏日吗？",
            "choices": [
                {
                    "id": "680035806",
                    "text": "可能吧…",
                    "response": [
                        {
                            "id": "680035808",
                            "speaker": "温柔骑士鸦",
                            "text": "哈哈…希望你回想起在这儿度过的时间，能觉得愉快呀…"
                        }
                    ]
                },
                {
                    "id": "680035807",
                    "text": "一定会的。"
                }
            ]
        }
    ]
}