{
    "talkId": "6800256",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "暮夜剧团团长": 8,
        "派蒙": 1
    },
    "dialogues": [
        {
            "id": "680025601",
            "speaker": "暮夜剧团团长",
            "text": "呜呜…演出顺利结束了…"
        },
        {
            "id": "680025602",
            "speaker": "暮夜剧团团长",
            "text": "#感谢参加演出的各位演员，感谢观看演出的各位观众！当然，还有{NICKNAME}阁下，派蒙阁下！"
        },
        {
            "id": "680025603",
            "speaker": "暮夜剧团团长",
            "text": "感谢你们热情似火的注视…呜呜…就像恶龙灼热的吐息…啊…"
        },
        {
            "id": "680025604",
            "speaker": "派蒙",
            "text": "剧目的标题…"
        },
        {
            "id": "680025605",
            "speaker": "暮夜剧团团长",
            "text": "是「王女执剑记」！"
        },
        {
            "id": "680025606",
            "speaker": "Player",
            "text": "执剑的时间只有终幕的一小会儿？"
        },
        {
            "id": "680025607",
            "speaker": "暮夜剧团团长",
            "text": "这个嘛…就像「三勇者」其实有四个…",
            "choices": [
                {
                    "id": "680025611",
                    "text": "「最好的伙伴」也叫「应急食品」…",
                    "response": [
                        {
                            "id": "680025608",
                            "speaker": "暮夜剧团团长",
                            "text": "总之，重要的不是手上的剑！而是心中的勇气的剑！"
                        },
                        {
                            "id": "680025609",
                            "speaker": "暮夜剧团团长",
                            "text": "#说回正事！我们的演出顺利结束了，机会难得，想请{NICKNAME}阁下和派蒙阁下与剧团团员一道摄影留念！"
                        },
                        {
                            "id": "680025610",
                            "speaker": "暮夜剧团团长",
                            "text": "请不要推辞！来吧！"
                        }
                    ]
                },
                {
                    "id": "680025612",
                    "text": "就像没见过的「骑兵队长」的坐骑…"
                }
            ]
        }
    ]
}