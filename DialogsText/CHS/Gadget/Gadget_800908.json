    "dialogues": [
        {
            "id": "80090801",
            "speaker": "派蒙",
            "text": "#这边有个盒子，打开看看吧？{NICKNAME}你来动手…我、我怕里面的东西会咬我的手指头…",
            "choices": [
                {
                    "id": "80090802",
                    "text": "你究竟以为里面会有什么啊…",
                    "response": [
                        {
                            "id": "80090804",
                            "speaker": "派蒙",
                            "text": "欸，这是…一面镜子？"
                        },
                        {
                            "id": "80090805",
                            "speaker": "派蒙",
                            "text": "而且还是碎掉的，这个盒子难道是个化妆盒吗？",
                            "choices": [
                                {
                                    "id": "80090806",
                                    "text": "好像…就是很普通的镜子。",
                                    "response": [
                                        {
                                            "id": "80090808",
                                            "speaker": "派蒙",
                                            "text": "有点失望，我还以为会藏着什么大秘密呢，这个房间被戴因说得那么玄乎，好像也不过如此嘛。"
                                        }
                                    ]
                                },
                                {
                                    "id": "80090807",
                                    "text": "只不过碎掉了而已。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "80090803",
                    "text": "别往奇怪的方向想啊…"
                }
            ]
        }
    ]
}