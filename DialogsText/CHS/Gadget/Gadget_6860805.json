    "dialogues": [
        {
            "id": "686080501",
            "speaker": "店主留言",
            "text": "「要是找不到店主，请别着急！」"
        },
        {
            "id": "686080502",
            "speaker": "店主留言",
            "text": "「请在沙滩排球区和冲浪区转一转。」"
        },
        {
            "id": "686080503",
            "speaker": "店主留言",
            "text": "「如果实在找不到也没关系，这块牌子上也有价目表，要买东西的话，直接把摩拉留在柜台上就好啦~」"
        },
        {
            "id": "686080504",
            "speaker": "店主留言",
            "text": "「我相信各位客人！」"
        }
    ]
}