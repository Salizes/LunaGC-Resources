        {
            "id": "140383101",
            "speaker": "观察花卉",
            "text": "（角落里堆满了来自各国的花卉，花香十分浓郁。）"
        },
        {
            "id": "140383102",
            "speaker": "观察花卉",
            "text": "（微微摇曳的琉璃百合含而未放。花瓣边缘有一圈浸渍，摸起来很黏腻。）"
        },
        {
            "id": "140383103",
            "speaker": "派蒙",
            "text": "——就是它了！"
        }
    ]
