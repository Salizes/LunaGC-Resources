    "dialogues": [
        {
            "id": "684051801",
            "speaker": "执律庭",
            "text": "通缉令：重刑犯秋"
        },
        {
            "id": "684051802",
            "speaker": "执律庭",
            "text": "女犯秋犯有谋杀罪，于赴梅洛彼得堡服刑途中逃脱。该犯紫色眼瞳，身型瘦削。"
        },
        {
            "id": "684051803",
            "speaker": "执律庭",
            "text": "犯人逃脱时极有可能有同伴协助，有目击此人者请勿试图出手制服该犯，优先联络执律庭。"
        }
    ]
}