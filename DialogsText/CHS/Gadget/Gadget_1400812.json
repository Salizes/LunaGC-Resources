    "speaker_counts": {
        "Player": 2,
        "「关于走私案…」": 6
    },
    "dialogues": [
        {
            "id": "140081201",
            "speaker": "「关于走私案…」",
            "text": "「警备队与逐影庭联手破获了一起走私案。」"
        },
        {
            "id": "140081202",
            "speaker": "「关于走私案…」",
            "text": "「案件主要参与者，根据其罪责大小，受到了不同程度的审判。」"
        },
        {
            "id": "140081203",
            "speaker": "「关于走私案…」",
            "text": "「名单附录请翻阅案件附录表。」",
            "choices": [
                {
                    "id": "140081204",
                    "text": "继续阅读",
                    "response": [
                        {
                            "id": "140081206",
                            "speaker": "「关于走私案…」",
                            "text": "「案件的主犯多梅尼科、伊尼加、尤娜等均已落网。经受审判后，被送到梅洛彼得堡。」"
                        },
                        {
                            "id": "140081207",
                            "speaker": "「关于走私案…」",
                            "text": "「未参与走私案，但与主犯关系密切、有利益往来的人并未定罪，以教育为主。」"
                        },
                        {
                            "id": "140081208",
                            "speaker": "「关于走私案…」",
                            "text": "「其中埃桑表现较好，提前解除观察。其余人员仍在重点观察名单中。」"
                        }
                    ]
                },
                {
                    "id": "140081205",
                    "text": "离开"
                }
            ]
        }
    ]
}