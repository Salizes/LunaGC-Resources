    "dialogues": [
        {
            "id": "680020201",
            "speaker": "回声海螺",
            "text": "「以防万一，还是把属于这个家族的宝物传给你吧。」"
        },
        {
            "id": "680020202",
            "speaker": "回声海螺",
            "text": "「妈妈的奶奶说，它来自我们遥远的故乡。妈妈很小便坐船离开故乡，实在记不清了。或许，故乡的一切就在这首童谣里。」"
        },
        {
            "id": "680020203",
            "speaker": "回声海螺",
            "text": "「……………<color=#37FFFF>人稀林中两路分</color>……」"
        }
    ]
}