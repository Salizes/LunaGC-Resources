    "dialogues": [
        {
            "id": "30319910",
            "speaker": "倾奇者",
            "text": "为什么挡在我的去路上？"
        },
        {
            "id": "30319911",
            "speaker": "「丑角」",
            "text": "并非阻挡，而是等待。"
        },
        {
            "id": "30319912",
            "speaker": "「丑角」",
            "text": "你的真面目是一种武器，可为钢铁的意志所用，也可继续漂泊流浪。"
        },
        {
            "id": "30319913",
            "speaker": "倾奇者",
            "text": "…想拉拢我？"
        },
        {
            "id": "30319914",
            "speaker": "「丑角」",
            "text": "反抗的命运早已揭开帷幕。为何不来到席间，成为欢庆的一份子呢？"
        }
    ]
}