    "speaker_counts": {
        "小茂": 2,
        "派蒙": 4
    },
    "dialogues": [
        {
            "id": "711034401",
            "speaker": "派蒙",
            "text": "呜哇…这里别有洞天呢…"
        },
        {
            "id": "711034402",
            "speaker": "派蒙",
            "text": "欸？！是丘丘人！小茂你快躲到我们后面！"
        },
        {
            "id": "711034403",
            "speaker": "小茂",
            "text": "嘿嘿…有时候会这样啦，但之前我的朋友都会把它们赶走，所以…我一点也不怕！"
        },
        {
            "id": "711034404",
            "speaker": "派蒙",
            "text": "你的朋友很厉害呢…唔，不会也是什么仙人吧…？"
        },
        {
            "id": "711034405",
            "speaker": "小茂",
            "text": "唔…也不是啦，她不让我随便和别人提起她，所以…对不起啦…"
        },
        {
            "id": "711034406",
            "speaker": "派蒙",
            "text": "真是的，没必要道歉呀！"
        }
    ]
}