    "dialogues": [
        {
            "id": "120429901",
            "speaker": "雷电将军",
            "text": "对决所需的时间，足以见证王国兴起又覆灭。"
        },
        {
            "id": "120429902",
            "speaker": "雷电将军",
            "text": "对决所耗的能量，足以倾倒大海、覆灭天光。"
        },
        {
            "id": "120429903",
            "speaker": "雷电将军",
            "text": "对决所求的意志，足以贯通一心、颠倒梦想。"
        },
        {
            "id": "120429904",
            "speaker": "雷电将军",
            "text": "而你，依然存在。"
        },
        {
            "id": "120429905",
            "speaker": "影",
            "text": "我将永远存在。"
        }
    ]
}