    "dialogues": [
        {
            "id": "240019901",
            "speaker": "布蕾莘",
            "text": "巴里亚不喜欢太热闹的地方，歌剧肯定让它烦躁不安，所以才逃开了。"
        },
        {
            "id": "240019902",
            "speaker": "布蕾莘",
            "text": "它说不定会藏在草丛里…往前走走，去那片草丛里看看。"
        },
        {
            "id": "240019903",
            "speaker": "布蕾莘",
            "text": "没有…唔，去别处找找…"
        }
    ]
}