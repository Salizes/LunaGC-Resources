    "talkId": "1101501",
    "total_dialogue_lines": 5,
    "speaker_counts": {
        "派蒙": 2,
        "申鹤": 3
    },
    "dialogues": [
        {
            "id": "110159901",
            "speaker": "申鹤",
            "text": "你们怎么也来了？"
        },
        {
            "id": "110159902",
            "speaker": "派蒙",
            "text": "我们也不能让申鹤一个人冒险！"
        },
        {
            "id": "110159903",
            "speaker": "申鹤",
            "text": "冒险谈不上。璃月港的人早有准备，眼下她已经受了重伤，只是靠执念支撑着而已。"
        },
        {
            "id": "110159904",
            "speaker": "申鹤",
            "text": "虽然我的体力也所剩无几，不过像这样以命相搏…我大概比她要擅长。"
        },
        {
            "id": "110159905",
            "speaker": "派蒙",
            "text": "我们也来帮忙！"
        }
    ]
}