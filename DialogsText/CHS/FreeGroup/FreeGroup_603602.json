    "dialogues": [
        {
            "id": "60369902",
            "speaker": "迪希雅",
            "text": "碍事！"
        },
        {
            "id": "60369903",
            "speaker": "拉娜",
            "text": "吃我这招！"
        },
        {
            "id": "60369904",
