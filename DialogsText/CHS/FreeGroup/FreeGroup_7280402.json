    "dialogues": [
        {
            "id": "728049903",
            "speaker": "「海乱鬼」",
            "text": "又是你？上次捡回一条命，居然还敢找过来？"
        },
        {
            "id": "728049904",
            "speaker": "「海乱鬼」",
            "text": "还带了个帮手…哼，既然你不知好歹，那就别怪兄弟们下手黑了！"
        },
        {
            "id": "728049905",
            "speaker": "「海乱鬼」",
            "text": "一起上！放倒他们！"
        }
    ]
