    "dialogues": [
        {
            "id": "130149933",
            "speaker": "派蒙",
            "text": "小心，有魔物！"
        },
        {
            "id": "130149934",
            "speaker": "纳西妲",
            "text": "所有人，赶紧离开这里，去安全的地方！"
        },
        {
            "id": "130149935",
            "speaker": "莫塞伊思",
            "text": "我是这个梦境的主宰，创造无数的魔物也是轻而易举。"
        },
        {
            "id": "130149936",
            "speaker": "莫塞伊思",
            "text": "放心吧，受伤之前他们就会惊醒的，艾米尔不喜欢见到有人受伤。"
        },
        {
            "id": "130149937",
            "speaker": "莫塞伊思",
            "text": "——所以你们也给我识趣一点。"
        }
    ]
}