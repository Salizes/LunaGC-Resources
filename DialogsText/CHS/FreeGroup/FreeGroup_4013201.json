    "dialogues": [
        {
            "id": "401329901",
            "speaker": "派蒙",
            "text": "你读《蒸汽鸟报》了吗？看起来枫丹最近在过什么节日，广场那边好热闹呀！连旗子都换了！"
        },
        {
            "id": "401329902",
            "speaker": "派蒙",
            "text": "好多人手上拿着留影机，还有点心糖果，好开心的样子！"
        },
        {
            "id": "401329903",
            "speaker": "派蒙",
            "text": "我们也去看看吧！"
        }
    ]
}