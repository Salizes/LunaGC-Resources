{
    "talkId": "1400704",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "基娅拉": 3,
        "派蒙": 4
    },
    "dialogues": [
        {
            "id": "140079910",
            "speaker": "派蒙",
            "text": "说起来，基娅拉多大了？"
        },
        {
            "id": "140079911",
            "speaker": "基娅拉",
            "text": "嗯…让我想想…一、二、十…唔，我也记不清啦。"
        },
        {
            "id": "140079912",
            "speaker": "基娅拉",
            "text": "不过我有印象，是卡萝蕾姐姐和那维莱特大人把我带到枫丹廷的，那应该是很久之前了。"
        },
        {
            "id": "140079913",
            "speaker": "派蒙",
            "text": "我记得那维莱特提到过卡萝蕾…那是四百多年前的事了吧！你为什么会叫我姐姐呢？"
        },
        {
            "id": "140079914",
            "speaker": "基娅拉",
            "text": "因为我记忆力不是很好，卡萝蕾姐姐说我可以凭感觉去称呼别人…我觉得派蒙姐姐比我成熟，所以是姐姐。"
        },
        {
            "id": "140079915",
            "speaker": "派蒙",
            "text": "原来是这样…"
        },
        {
            "id": "140079916",
            "speaker": "派蒙",
            "text": "#咦，{NICKNAME}，你有没有听到什么声音？"
        }
    ]
}