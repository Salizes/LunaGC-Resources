    },
    "dialogues": [
        {
            "id": "741569920",
            "speaker": "派蒙",
            "text": "伯努瓦，你要跑去哪儿啊？"
        },
        {
            "id": "741569921",
            "speaker": "伯努瓦·勒鲁瓦",
            "text": "房子本来就是她的，她拿回去就拿回去好了…"
        },
        {
            "id": "741569922",
            "speaker": "伯努瓦·勒鲁瓦",
            "text": "我的命没了…不能没…这儿还有…"
        },
        {
            "id": "741569923",
            "speaker": "派蒙",
            "text": "伯努瓦！我们要跟不上了…怎么突然跑这么快？"
        },
        {
            "id": "741569924",
            "speaker": "？？？",
            "text": "水流缓缓拂过…"
        },
        {
            "id": "741569925",
            "speaker": "？？？",
            "text": "小鱼儿的摇篮轻轻颠簸…"
        },
        {
            "id": "741569926",
            "speaker": "？？？",
            "text": "要是折断了水草，摇篮会跟着波浪漂…"
        },
        {
            "id": "741569927",
            "speaker": "？？？",
            "text": "但我会接住你，接住摇篮还有鱼群的巢…"
        }
    ]
}