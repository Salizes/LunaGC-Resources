    "dialogues": [
        {
            "id": "150419901",
            "speaker": "绵驮兽警长",
            "text": "唉，不知英雄什么时候才会回来…"
        },
        {
            "id": "150419902",
            "speaker": "班尼特",
            "text": "警长，您说的英雄是…"
        },
        {
            "id": "150419903",
            "speaker": "绵驮兽警长",
            "text": "很久以前，我们镇上生活着一位见义勇为的神枪手。"
        },
        {
            "id": "150419904",
            "speaker": "绵驮兽警长",
            "text": "他心怀正义，英勇无比，曾帮上小镇许多忙…"
        }
    ]
}