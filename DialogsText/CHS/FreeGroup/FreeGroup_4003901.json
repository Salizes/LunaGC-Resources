    "speaker_counts": {
        "北斗": 3,
        "派蒙": 2,
        "辛焱": 4
    },
    "dialogues": [
        {
            "id": "400399901",
            "speaker": "北斗",
            "text": "旅行者，这就是…你的船？"
        },
        {
            "id": "400399902",
            "speaker": "北斗",
            "text": "真是…小巧啊，不错，不错…很适合捞海面上浮着的东西。"
        },
        {
            "id": "400399903",
            "speaker": "辛焱",
            "text": "就是有点挤，我的琴都摆不开了…"
        },
        {
            "id": "400399904",
            "speaker": "北斗",
            "text": "辛焱，你的琴离我太近了…"
        },
        {
            "id": "400399905",
            "speaker": "辛焱",
            "text": "哦…哦！我挪一下位置…"
        },
        {
            "id": "400399906",
            "speaker": "派蒙",
            "text": "咦？你的琴底下怎么还带着刃？"
        },
        {
            "id": "400399907",
            "speaker": "辛焱",
            "text": "当然是防身用的啦！它还会喷火呢，不过这大过节的，还是不演示了吧…"
        },
        {
            "id": "400399908",
            "speaker": "辛焱",
            "text": "俗话说得好，不怕一万就怕万一，可不能把你们的船给烧着了…"
        },
        {
            "id": "400399929",
            "speaker": "派蒙",
            "text": "这把琴用处可真多啊…"
        }
    ]
}