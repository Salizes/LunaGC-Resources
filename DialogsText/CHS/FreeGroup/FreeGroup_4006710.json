    "dialogues": [
        {
            "id": "400679924",
            "speaker": "枫原万叶",
            "text": "祖父生前曾去璃月观光，父亲则从书中读到蒙德风景。我…又该去哪里？"
        },
        {
            "id": "400679925",
            "speaker": "枫原万叶",
            "text": "…天色转阴，是要下雨了吧。"
        },
        {
            "id": "400679926",
            "speaker": "枫原万叶",
            "text": "这场雨，还会停吗？"
        }
    ]
}