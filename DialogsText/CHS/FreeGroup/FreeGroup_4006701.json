    "dialogues": [
        {
            "id": "400679901",
            "speaker": "老仆",
            "text": "少爷，我们是最后的家仆了啊！您当真要遣散大家？那往后，谁来…"
        },
        {
            "id": "400679902",
            "speaker": "枫原万叶",
            "text": "不必担心，我会照顾好自己。"
        },
        {
            "id": "400679903",
            "speaker": "老仆",
            "text": "唉，夫人走得早，老爷又离你而去，如今这个名存实亡的家，只剩你一人…"
        },
        {
            "id": "400679904",
            "speaker": "老仆",
            "text": "老仆这一走，此生应是不会再见了。少爷，请多保重。"
        },
        {
            "id": "400679905",
            "speaker": "水手",
            "text": "喂——！要开船了！"
        },
        {
            "id": "400679906",
            "speaker": "枫原万叶",
            "text": "再会了。"
        }
    ]
}