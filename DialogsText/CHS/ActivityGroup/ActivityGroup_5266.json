{
    "groupId": "5266",
    "total_dialogue_lines": 55,
    "speaker_counts": {
        "Player": 14,
        "昂吉安妮": 25,
        "蒂蕾娜": 16
    },
    "talks": [
        {
            "talkId": "7451702",
            "initDialog": "745170201",
            "dialogues": [
                {
                    "id": "745170201",
                    "speaker": "蒂蕾娜",
                    "text": "准领队，一段时间不见，感觉您的目光更加锐利了，完全可以…轻松锁定并击中千步距离上的目标！",
                    "choices": [
                        {
                            "id": "745170202",
                            "text": "但领队更该注重指挥吧。",
                            "response": [
                                {
                                    "id": "745170203",
                                    "speaker": "蒂蕾娜",
                                    "text": "道理确实是这样啦，所以还请您尽情推演，把所有想试的战术都发挥出来。"
                                },
                                {
                                    "id": "745170204",
                                    "speaker": "蒂蕾娜",
                                    "text": "不过，映影里面也有那种…我方猛将一下就把对方的头领「射落马下」，让对方士气崩溃的桥段嘛，超帅气！"
                                }
                            ]
                        },
                        {
                            "id": "745170205",
                            "text": "那你现在的射术怎么样？",
                            "response": [
                                {
                                    "id": "745170206",
                                    "speaker": "蒂蕾娜",
                                    "text": "报告准领队，两百步的半身靶，最好记录十五中九，夏沃蕾队长说，我算是中规中矩的射手了！"
                                },
                                {
                                    "id": "745170207",
                                    "speaker": "蒂蕾娜",
                                    "text": "不过，最近我发现，特巡队为了保证对大型魔物的杀伤力，一直选用较大口径的铳枪，弹头很重，远距离留存的动能够大。"
                                },
                                {
                                    "id": "745170208",
                                    "speaker": "蒂蕾娜",
                                    "text": "但我们不像夏沃蕾队长，能用元素力驱动专用铳枪，打出秒速好几千的弹头，无比狂猛…"
                                },
                                {
                                    "id": "745170209",
                                    "speaker": "蒂蕾娜",
                                    "text": "发射药量相同的情况下，弹头越重，初速越慢，弹道也就越弯曲，极端情况下，有些枪甚至被笑成投石机。",
                                    "choices": [
                                        {
                                            "id": "745170210",
                                            "text": "为了威力牺牲了攻击距离…",
                                            "response": [
                                                {
                                                    "id": "745170212",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "没错，可惜射手的身体能抵御的后坐力也有限，不可能一直加大发射药量，要不然，一开枪，射手先肩膀报废重伤倒地了…"
                                                },
                                                {
                                                    "id": "745170213",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "如果优化弹头的弹形，加强弹头战胜空气阻力的能力，就可以缩小口径，提升初速，既改善了命中率，又保住了远距离的动能！"
                                                },
                                                {
                                                    "id": "745170214",
                                                    "speaker": "蒂蕾娜",
                                                    "text": "同时，在弹头表面和内部使用不同硬度的材料，加强弹头侵彻后的翻滚和破碎，确保毁伤后效…",
                                                    "choices": [
                                                        {
                                                            "id": "745170215",
                                                            "text": "从这里开始听不懂了。",
                                                            "response": [
                                                                {
                                                                    "id": "745170217",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "可是我又不是枫丹科学院的工程师，不知道要怎么计算…也只能先记录一下，回头给队里的枪匠说说看了。"
                                                                },
                                                                {
                                                                    "id": "745170218",
                                                                    "speaker": "蒂蕾娜",
                                                                    "text": "哎，真希望有一把…指哪打哪，没后坐力，弹药也方便携带的好枪！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "745170216",
                                                            "text": "嗯嗯嗯！对的对的！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745170211",
                                            "text": "很难打中比较远的目标吧…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745170219",
                            "text": "你别走动，我推演几盘就来。",
                            "response": [
                                {
                                    "id": "745170220",
                                    "speaker": "蒂蕾娜",
                                    "text": "那肯定，我会一直看着您推演，专心学习的，请放心！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7451703",
            "initDialog": "745170301",
            "dialogues": [
                {
                    "id": "745170301",
                    "speaker": "昂吉安妮",
                    "text": "唉，一想到最近的新人也在犯蒂蕾娜年轻时的错误…就应该让他们多来练习推演，吃几回败仗，好好长长记性！",
                    "choices": [
                        {
                            "id": "745170302",
                            "text": "新人和蒂蕾娜怎么了？",
                            "response": [
                                {
                                    "id": "745170303",
                                    "speaker": "昂吉安妮",
                                    "text": "呃，就是太过注重装备性能和个人作战的技巧，把太多时间花费在了这两个方面上。"
                                },
                                {
                                    "id": "745170304",
                                    "speaker": "昂吉安妮",
                                    "text": "研究铳枪的性能，打磨自己的射术，寻找更棒的军服、头盔和携行背心…这些事没有错，但绝不能因此疏于培养全局意识！"
                                },
                                {
                                    "id": "745170305",
                                    "speaker": "昂吉安妮",
                                    "text": "执律庭的成员都讲究团队合作，除了夏沃蕾队长那样的特例，一名独行的射手根本不可能完成复杂的任务。"
                                },
                                {
                                    "id": "745170306",
                                    "speaker": "昂吉安妮",
                                    "text": "比如，一个射手的枪法再强装备再好，踹开门的瞬间，也只能打掉单个方向的敌人，然后就被其他角度的伏兵反击成筛子…"
                                },
                                {
                                    "id": "745170307",
                                    "speaker": "昂吉安妮",
                                    "text": "相反，如果和队友配合得当，一起动态切角攻入房间，就算拿着品控没那么完美的公发铳枪，也能大大提升成功率。"
                                },
                                {
                                    "id": "745170308",
                                    "speaker": "昂吉安妮",
                                    "text": "蒂蕾娜喜欢的远距离射击也是如此，没有其他方向的协助火力，独自远射的枪手很快就会被对方有意识地规避，分组绕开射界。"
                                },
                                {
                                    "id": "745170309",
                                    "speaker": "昂吉安妮",
                                    "text": "不走运的情况下，甚至会被反过来集中火力压制，甚至吃到炮弹的问候，走都走不掉！"
                                },
                                {
                                    "id": "745170310",
                                    "speaker": "昂吉安妮",
                                    "text": "现在的蒂蕾娜吃过这方面的苦头，不会再闷头追求细节，就看新人们什么时候才能长个心眼了。",
                                    "choices": [
                                        {
                                            "id": "745170311",
                                            "text": "好像有点道理…",
                                            "response": [
                                                {
                                                    "id": "745170313",
                                                    "speaker": "昂吉安妮",
                                                    "text": "所以说，这次推演的还是很有价值的。"
                                                },
                                                {
                                                    "id": "745170314",
                                                    "speaker": "昂吉安妮",
                                                    "text": "虽然看起来，敌我双方的单位，都没有采用特巡队的装备和交战方式，但底层的「行动逻辑」有着共通之处。"
                                                },
                                                {
                                                    "id": "745170315",
                                                    "speaker": "昂吉安妮",
                                                    "text": "确认初始位置、进行态势判断、规划行动路线、作出正确的进攻决策…慢慢练好这些意识，实战犯错的几率才会大大降低！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745170312",
                                            "text": "真打起来毕竟不像映影…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745170316",
                            "text": "你好像认识蒂蕾娜很久了。",
                            "response": [
                                {
                                    "id": "745170317",
                                    "speaker": "昂吉安妮",
                                    "text": "很久吗？也就四五年吧…"
                                },
                                {
                                    "id": "745170318",
                                    "speaker": "昂吉安妮",
                                    "text": "不对，怎么就四五年了？每天只管上班出勤，一不注意就这么久了！"
                                },
                                {
                                    "id": "745170319",
                                    "speaker": "昂吉安妮",
                                    "text": "前段时间蒂蕾娜还自称新人，把教导新人的活推给我来着…"
                                },
                                {
                                    "id": "745170320",
                                    "speaker": "昂吉安妮",
                                    "text": "这小妞，难不成是想借着装成新人，来逃避更高岗位的任务吗！",
                                    "choices": [
                                        {
                                            "id": "745170321",
                                            "text": "她可能只是谦虚…",
                                            "response": [
                                                {
                                                    "id": "745170323",
                                                    "speaker": "昂吉安妮",
                                                    "text": "唔…也对，应该是她的性格原因，总是觉得别人很强，处处唯唯诺诺，面对新人都觉得自己本领不足…"
                                                },
                                                {
                                                    "id": "745170324",
                                                    "speaker": "昂吉安妮",
                                                    "text": "这可不行，她毕竟都代表特巡队参加过联合推演了，要自信一点，适当拿出老成员的气势，这样才能教人本领！"
                                                },
                                                {
                                                    "id": "745170325",
                                                    "speaker": "昂吉安妮",
                                                    "text": "过段时间，我就和她好好说说！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745170322",
                                            "text": "她不像会偷懒的类型…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745170326",
                            "text": "好！那你用力教导新人！",
                            "response": [
                                {
                                    "id": "745170327",
                                    "speaker": "昂吉安妮",
                                    "text": "不劳你多说，我会卷起袖子狠狠下手的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7451802",
            "initDialog": "745180201",
            "dialogues": [
                {
                    "id": "745180201",
                    "speaker": "昂吉安妮",
                    "text": "蒂蕾娜！经过这次推演…不，是经过这么长时间的锻炼，你已经成为独当一面的特巡队员了。"
                },
                {
                    "id": "745180202",
                    "speaker": "昂吉安妮",
                    "text": "是时候由你来教导最近新入队的那批新人了。"
                },
                {
                    "id": "745180203",
                    "speaker": "蒂蕾娜",
                    "text": "我…我来吗？我得做好心理准备才行…"
                },
                {
                    "id": "745180204",
                    "speaker": "昂吉安妮",
                    "text": "拿出气势来，到时候，你就是他们的教官了。"
                },
                {
                    "id": "745180205",
                    "speaker": "昂吉安妮",
                    "text": "你啊，蒂蕾娜！作为实战和训练经验都可圈可点，逮捕过两位数重犯，击毙过四位数魔物，拿过七枚勋章的老兵…"
                },
                {
                    "id": "745180206",
                    "speaker": "昂吉安妮",
                    "text": "你可以不摆架子，但必须镇住他们，让他们踏踏实实潜心练习！"
                },
                {
                    "id": "745180207",
                    "speaker": "蒂蕾娜",
                    "text": "用枪托砸晕犯人和开枪打魔物很简单嘛，和同事打交道才困难！"
                },
                {
                    "id": "745180208",
                    "speaker": "蒂蕾娜",
                    "text": "总之…我会努力的！"
                }
            ]
        }
    ]
}