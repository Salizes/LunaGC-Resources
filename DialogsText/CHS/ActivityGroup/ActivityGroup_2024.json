{
    "groupId": "2024",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 6,
        "利弗": 4,
        "阿尔芒": 3,
        "阿尔贝": 11,
        "阿尔邦": 12
    },
    "talks": [
        {
            "talkId": "7450402",
            "initDialog": "745040201",
            "dialogues": [
                {
                    "id": "745040201",
                    "speaker": "阿尔邦",
                    "text": "你听说了吗？阿尔芒最近状态好像好多了，虽然人多的时候还会紧张，不过至少能表达意思了。"
                },
                {
                    "id": "745040202",
                    "speaker": "阿尔贝",
                    "text": "那还不错。要是话都说不完整，想当喜剧演员是肯定没戏的。"
                },
                {
                    "id": "745040203",
                    "speaker": "Player",
                    "text": "阿尔芒？"
                },
                {
                    "id": "745040204",
                    "speaker": "阿尔邦",
                    "text": "就是勒波特钟表店门口的那个店员。老爷您没见过他吗？"
                },
                {
                    "id": "745040205",
                    "speaker": "阿尔贝",
                    "text": "他跟我们是同一个村庄的，也是个想当喜剧演员的好小伙子，可惜，他有严重的口吃。"
                },
                {
                    "id": "745040206",
                    "speaker": "阿尔邦",
                    "text": "据说是小时候观看一场喜剧的时候，意外从看台摔了下来，脑袋落下了后遗症。"
                },
                {
                    "id": "745040207",
                    "speaker": "阿尔贝",
                    "text": "那场喜剧我本来很喜欢，名字叫「审判」。但现在总觉得有点爱不起来了。"
                },
                {
                    "id": "745040208",
                    "speaker": "阿尔邦",
                    "text": "志向成为喜剧演员的孩子在名为「审判」的喜剧中被审判了，惩罚是他再也当不了喜剧演员。"
                },
                {
                    "id": "745040209",
                    "speaker": "阿尔贝",
                    "text": "可怜的阿尔芒，他犯了什么罪？谁是审判官？"
                },
                {
                    "id": "745040210",
                    "speaker": "阿尔邦",
                    "text": "谁知道呢？"
                }
            ]
        },
        {
            "talkId": "7450403",
            "initDialog": "745040301",
            "dialogues": [
                {
                    "id": "745040301",
                    "speaker": "阿尔邦",
                    "text": "你看见留言板了吗？好像有人看上了那个发条企鹅。"
                },
                {
                    "id": "745040302",
                    "speaker": "阿尔贝",
                    "text": "看到了，是想要认识下菲米尼的那条吧？听口气，感觉还有点想进一步合作的意思。",
                    "choices": [
                        {
                            "id": "745040303",
                            "text": "菲米尼？",
                            "response": [
                                {
                                    "id": "745040305",
                                    "speaker": "阿尔邦",
                                    "text": "哦，就是摆在那边桌子上的发条玩具企鹅，是一个叫做菲米尼的潜水员做的。他放在我们店寄售。"
                                },
                                {
                                    "id": "745040306",
                                    "speaker": "阿尔贝",
                                    "text": "他是个好小伙子，有一张漂亮的脸蛋，说话轻声细语，做玩具的手艺还很棒。"
                                },
                                {
                                    "id": "745040307",
                                    "speaker": "阿尔邦",
                                    "text": "唯一就是，他看起来有点忧伤，就好像缺少了什么本该属于他的东西…"
                                },
                                {
                                    "id": "745040308",
                                    "speaker": "阿尔贝",
                                    "text": "那眼神我太清楚啦，和阿尔邦看他那空荡荡的钱包的眼神一模一样，他绝对是缺钱。"
                                },
                                {
                                    "id": "745040309",
                                    "speaker": "阿尔邦",
                                    "text": "别胡说，你忘了他来谈寄售的那天，都没说分成的事。这一看就不是冲着摩拉来的。"
                                },
                                {
                                    "id": "745040310",
                                    "speaker": "阿尔贝",
                                    "text": "这倒也是，但这种年纪的小伙子还能烦恼什么呢？"
                                },
                                {
                                    "id": "745040311",
                                    "speaker": "阿尔邦",
                                    "text": "话说回来，他确实挺讨人喜欢的，老板这还是头一回答应了寄售。"
                                },
                                {
                                    "id": "745040312",
                                    "speaker": "阿尔邦",
                                    "text": "不仅给安排了户外的摊位，也没占人便宜，主动提出了五五分成。"
                                },
                                {
                                    "id": "745040313",
                                    "speaker": "阿尔贝",
                                    "text": "可惜啊，最后卖的情况，只能说一般般吧。看的人不少，买的人不多。"
                                },
                                {
                                    "id": "745040314",
                                    "speaker": "阿尔贝",
                                    "text": "那个玩具的设计确实精巧，但可能正因为这样，上手的门槛也变高了，维修起来也不容易。"
                                },
                                {
                                    "id": "745040315",
                                    "speaker": "阿尔邦",
                                    "text": "没想到这次居然有人特地在留言板上留言。搞不好碰上大客户了呢。"
                                },
                                {
                                    "id": "745040316",
                                    "speaker": "阿尔贝",
                                    "text": "总之，回头记得提醒一下老板，好买卖可别弄丢了。"
                                }
                            ]
                        },
                        {
                            "id": "745040304",
                            "text": "发条企鹅？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7450404",
            "initDialog": "745040401",
            "dialogues": [
                {
                    "id": "745040401",
                    "speaker": "利弗",
                    "text": "北国银行那边有进展的话，我不会忘记通知两位贵客的。"
                },
                {
                    "id": "745040402",
                    "speaker": "Player",
                    "text": "阿尔邦和阿尔贝今天不在吗？"
                },
                {
                    "id": "745040403",
                    "speaker": "利弗",
                    "text": "他们两个请假了，说是有什么玩具的新点子。真是奇事。"
                },
                {
                    "id": "745040404",
                    "speaker": "利弗",
                    "text": "这两个家伙，平时满脑子都是他们的喜剧，对玩具可从没这么上心过。"
                },
                {
                    "id": "745040405",
                    "speaker": "利弗",
                    "text": "这回居然变性了，真不知道他们在想什么。"
                }
            ]
        },
        {
            "talkId": "7450502",
            "initDialog": "745050201",
            "dialogues": [
                {
                    "id": "745050201",
                    "speaker": "阿尔芒",
                    "text": "这个又…又简单…又…又好玩，试…试…试试吧？",
                    "choices": [
                        {
                            "id": "745050202",
                            "text": "开始吧。",
                            "response": [
                                {
                                    "id": "745050203",
                                    "speaker": "阿尔芒",
                                    "text": "祝…祝…祝两位…玩开心。"
                                }
                            ]
                        },
                        {
                            "id": "745050204",
                            "text": "等会再来。",
                            "response": [
                                {
                                    "id": "745050205",
                                    "speaker": "阿尔芒",
                                    "text": "好…好！什…什么时候来，我…我都在这。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}