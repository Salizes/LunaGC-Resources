    "talks": [
        {
            "talkId": "7453102",
            "initDialog": "745310201",
            "dialogues": [
                {
                    "id": "745310201",
                    "speaker": "乐平波琳",
                    "text": "测试数据我看过了，「瞬影」镜头的表现达到了理论标准…不，应该说比我预想的还要惊艳！这个捕捉精度，简直完美！"
                },
                {
                    "id": "745310202",
                    "speaker": "乐平波琳",
                    "text": "有了这些宝贵的实战数据，我已经有灵感了！下一代产品的设计图，我脑子里都快画出来了！"
                },
                {
                    "id": "745310203",
                    "speaker": "妮内特",
                    "text": "欸？下、下一代？可是师父，我们才刚刚完成这一代的测试啊…"
                },
                {
                    "id": "745310204",
                    "speaker": "乐平波琳",
                    "text": "趁着灵感还在，我得赶紧把它们记录下来！妮内特，快，快把我的笔记本拿过来！"
                },
                {
                    "id": "745310205",
                    "speaker": "妮内特",
                    "text": "是、是…"
                }
            ]
        },
        {
            "talkId": "7468902",
            "initDialog": "746890201",
            "dialogues": [
                {
                    "id": "746890201",
                    "speaker": "妮内特",
                    "text": "这台搭载了「瞬影」镜头的特制留影机就拜托您了！"
                },
                {
                    "id": "746890202",
                    "speaker": "妮内特",
                    "text": "请用它记录下您那些朋友们最生动、最独特的瞬间吧！"
                }
            ]
        }
    ]
}