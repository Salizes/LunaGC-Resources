{
    "groupId": "5323",
    "total_dialogue_lines": 108,
    "speaker_counts": {
        "Player": 27,
        "妮佩卡": 5,
        "希诺宁": 2,
        "明妮": 19,
        "班尼特": 35,
        "瓦雷莎": 20
    },
    "talks": [
        {
            "talkId": "7567203",
            "initDialog": "756720301",
            "dialogues": [
                {
                    "id": "756720301",
                    "speaker": "班尼特",
                    "text": "#状态怎么样，{NICKNAME}？我们继续引导阿夏收集染料？",
                    "choices": [
                        {
                            "id": "756720302",
                            "text": "一起加油吧！",
                            "response": [
                                {
                                    "id": "756720303",
                                    "speaker": "班尼特",
                                    "text": "好！和你一起冒险，每次都干劲满满！"
                                }
                            ]
                        },
                        {
                            "id": "756720304",
                            "text": "还有什么好消息吗？",
                            "response": [
                                {
                                    "id": "756720305",
                                    "speaker": "班尼特",
                                    "text": "这个呀，让我想想…"
                                },
                                {
                                    "id": "756720306",
                                    "speaker": "班尼特",
                                    "text": "…在纳塔，我的运气实在太好了，所以可以尝试许多以前不敢深入研究的事…"
                                },
                                {
                                    "id": "756720307",
                                    "speaker": "班尼特",
                                    "text": "比如——给自己做一组超合适的冒险护具！护腕护膝绑腿和鞋垫都要有！",
                                    "choices": [
                                        {
                                            "id": "756720308",
                                            "text": "没想到的道具…",
                                            "response": [
                                                {
                                                    "id": "756720310",
                                                    "speaker": "班尼特",
                                                    "text": "#{NICKNAME}也要留意哦，冒险的过程中，保护关节和双脚是一等一的大事。"
                                                },
                                                {
                                                    "id": "756720311",
                                                    "speaker": "班尼特",
                                                    "text": "背着重物爬坡，会对膝盖持续施加压力，通过崎岖的地形时，要防止一脚没踩稳，扭伤脚踝…"
                                                },
                                                {
                                                    "id": "756720312",
                                                    "speaker": "班尼特",
                                                    "text": "长途步行中，双脚也有可能比双腿先撑不住，需要有效避免疲惫，甚至是无形受伤。"
                                                },
                                                {
                                                    "id": "756720313",
                                                    "speaker": "班尼特",
                                                    "text": "减震和保护作用都不错的护具，就能在这种时候派上用场。",
                                                    "choices": [
                                                        {
                                                            "id": "756720314",
                                                            "text": "这么一说确实有道理。",
                                                            "response": [
                                                                {
                                                                    "id": "756720316",
                                                                    "speaker": "班尼特",
                                                                    "text": "长远来看，对自己有利的道具，永远不嫌多嘛！"
                                                                },
                                                                {
                                                                    "id": "756720317",
                                                                    "speaker": "班尼特",
                                                                    "text": "也可以听听普通冒险家们许多年来不断试错，总结出的窍门——"
                                                                },
                                                                {
                                                                    "id": "756720318",
                                                                    "speaker": "班尼特",
                                                                    "text": "把诸如嘟嘟莲和肉龙掌一类的植物，切成小块后，捣碎在面粉里，放进锅中，加入磐石精油熬煮两天。"
                                                                },
                                                                {
                                                                    "id": "756720319",
                                                                    "speaker": "班尼特",
                                                                    "text": "然后倒进模具，放在冰雾花旁边冷却一晚，稍微修修外形，削去不平的地方…"
                                                                },
                                                                {
                                                                    "id": "756720320",
                                                                    "speaker": "班尼特",
                                                                    "text": "比须弥的跳跳菇还有弹性的护具，就完工了！据说有了它，一天爬两回图兰大火山，关节和脚底都不会受伤！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756720321",
                                                                            "text": "听起来工艺也不复杂？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756720323",
                                                                                    "speaker": "班尼特",
                                                                                    "text": "哎呀，换在其他地方，我在熬煮的那一环，就会败下阵来。"
                                                                                },
                                                                                {
                                                                                    "id": "756720324",
                                                                                    "speaker": "班尼特",
                                                                                    "text": "要么是锅里混进去不知道什么成分，煮到一半就变质，要么就是整口锅都炸掉，碎片到处乱崩…"
                                                                                },
                                                                                {
                                                                                    "id": "756720325",
                                                                                    "speaker": "班尼特",
                                                                                    "text": "如果我自己去买，尺码合不合适另说，十有八九会买到次品。"
                                                                                },
                                                                                {
                                                                                    "id": "756720326",
                                                                                    "speaker": "班尼特",
                                                                                    "text": "关键，也不是老板有意卖给我劣质货，而是他们自己都没检查出问题…我只能自认倒霉。"
                                                                                },
                                                                                {
                                                                                    "id": "756720327",
                                                                                    "speaker": "班尼特",
                                                                                    "text": "所以以前，我还从没搞到过好用的护具呢，这事说大也不大，说小，也还确实对冒险的体验有影响。"
                                                                                },
                                                                                {
                                                                                    "id": "756720328",
                                                                                    "speaker": "班尼特",
                                                                                    "text": "这次来度假村，我就地取材，总算做出了最满意的作品…"
                                                                                },
                                                                                {
                                                                                    "id": "756720329",
                                                                                    "speaker": "班尼特",
                                                                                    "text": "真是太舒心了…原来踏上好用的鞋垫，戴上弹性正合适的护膝再跑步，是这种感觉！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756720322",
                                                                            "text": "虽然我不用这个也能爬好几回…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756720315",
                                                            "text": "平常没怎么注意过。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756720309",
                                            "text": "为什么是这个？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756720330",
                            "text": "附近还有别的朋友吗？",
                            "response": [
                                {
                                    "id": "756720331",
                                    "speaker": "班尼特",
                                    "text": "这个，如果是说以前打过交道的冒险家朋友，那他们都心满意足，跟着老爹们回去了啦。"
                                },
                                {
                                    "id": "756720332",
                                    "speaker": "班尼特",
                                    "text": "还留在纳塔的，只有和我们同乘一支车队来玩的几位蒙德游客。"
                                },
                                {
                                    "id": "756720333",
                                    "speaker": "班尼特",
                                    "text": "不过，有一位长着角的…摔角手？找了过来，向我询问，有没有见过一个戴帽子的女孩…"
                                },
                                {
                                    "id": "756720334",
                                    "speaker": "班尼特",
                                    "text": "听说那位摔角手是「沃陆之邦」重要的战士，之前还在「龙脊雪山越野赛」拿了不错的名次。"
                                },
                                {
                                    "id": "756720335",
                                    "speaker": "班尼特",
                                    "text": "也许，在我们没注意到的地方，不少蒙德人都和纳塔人交上朋友了？"
                                }
                            ]
                        },
                        {
                            "id": "756720336",
                            "text": "待会儿再来。",
                            "response": [
                                {
                                    "id": "756720337",
                                    "speaker": "班尼特",
                                    "text": "嗯，我们等着你！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7567204",
            "initDialog": "756720401",
            "dialogues": [
                {
                    "id": "756720401",
                    "speaker": "瓦雷莎",
                    "text": "明妮明妮，看那只阿夏画出来的涂鸦，像不像打翻了枫达瓶…果汁洒在了烤蘑菇披萨上？"
                },
                {
                    "id": "756720402",
                    "speaker": "明妮",
                    "text": "真的欸！这个比喻太贴切了…"
                },
                {
                    "id": "756720403",
                    "speaker": "明妮",
                    "text": "想吃。"
                },
                {
                    "id": "756720404",
                    "speaker": "瓦雷莎",
                    "text": "我也想…不过，泡泡桔的风味，和蘑菇混合在一起，会不会有点怪？",
                    "choices": [
                        {
                            "id": "756720405",
                            "text": "那要不试试？",
                            "response": [
                                {
                                    "id": "756720406",
                                    "speaker": "瓦雷莎",
                                    "text": "咦？我是不是…蘑菇吃太多，出现幻觉了吗…"
                                },
                                {
                                    "id": "756720407",
                                    "speaker": "明妮",
                                    "text": "#不是幻觉哦，的确是{NICKNAME}！没想到还能在悠悠度假村见面！",
                                    "choices": [
                                        {
                                            "id": "756720408",
                                            "text": "你是叫…明妮来着？",
                                            "response": [
                                                {
                                                    "id": "756720409",
                                                    "speaker": "明妮",
                                                    "text": "还记得我吗？太好了…感觉又得到了莫大的鼓舞…"
                                                },
                                                {
                                                    "id": "756720410",
                                                    "speaker": "瓦雷莎",
                                                    "text": "没错没错，也是我们「炽魂斗士特战队」的首席画师，现在正在创作《炽魂斗士战记》的外传作品。"
                                                },
                                                {
                                                    "id": "756720411",
                                                    "speaker": "瓦雷莎",
                                                    "text": "这次明妮可厉害了，一个人跟着冒险家们的车队来纳塔，出了个超级大远门！",
                                                    "choices": [
                                                        {
                                                            "id": "756720412",
                                                            "text": "那还真是长途跋涉。",
                                                            "response": [
                                                                {
                                                                    "id": "756720414",
                                                                    "speaker": "明妮",
                                                                    "text": "#没事的，还要多亏{NICKNAME}、瓦雷莎和希诺宁姐姐，之前你们说服了我的爸爸妈妈，让他们不再那么苛刻。"
                                                                },
                                                                {
                                                                    "id": "756720415",
                                                                    "speaker": "明妮",
                                                                    "text": "越野赛过后，我才找到机会，开始帮教会画公益宣传画，给一些书刊提供插图…"
                                                                },
                                                                {
                                                                    "id": "756720416",
                                                                    "speaker": "明妮",
                                                                    "text": "后来，瓦雷莎把我创作的《炽魂斗士战记》联想故事寄给了八重堂，被著名插画师朝雾老师看到了。"
                                                                },
                                                                {
                                                                    "id": "756720417",
                                                                    "speaker": "明妮",
                                                                    "text": "实在太好运了！朝雾老师非常认可我的画功，还给爸爸妈妈写了信。"
                                                                },
                                                                {
                                                                    "id": "756720418",
                                                                    "speaker": "明妮",
                                                                    "text": "现在，爸爸妈妈也明白，我可以把自己喜爱的绘画当成正经的工作，投入再多时间都值得。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "756720419",
                                                                            "text": "还算顺利嘛。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "756720421",
                                                                                    "speaker": "瓦雷莎",
                                                                                    "text": "我觉得，明妮可以自信一点，你的画功不是运气带来的，而是你自己每天努力的结果。"
                                                                                },
                                                                                {
                                                                                    "id": "756720422",
                                                                                    "speaker": "瓦雷莎",
                                                                                    "text": "就像…我现在还算不错的摔角技巧，也是跟着伊安珊教练一点点练出来的。"
                                                                                },
                                                                                {
                                                                                    "id": "756720423",
                                                                                    "speaker": "瓦雷莎",
                                                                                    "text": "朝雾小姐也参与了许多《炽魂斗士》系列作品的插画和漫画，直接和最严格的森子编辑推荐了明妮…"
                                                                                },
                                                                                {
                                                                                    "id": "756720424",
                                                                                    "speaker": "瓦雷莎",
                                                                                    "text": "正好，有一部《炽魂斗士战记》的外传作品，很长时间找不到画成漫画的合适画师。"
                                                                                },
                                                                                {
                                                                                    "id": "756720425",
                                                                                    "speaker": "瓦雷莎",
                                                                                    "text": "结果明妮做过笔试题后，直接拿到了九十多分，还破了招募的纪录呢！",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "756720426",
                                                                                            "text": "那还真是厉害！",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "756720428",
                                                                                                    "speaker": "明妮",
                                                                                                    "text": "谢…谢谢！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "756720429",
                                                                                                    "speaker": "明妮",
                                                                                                    "text": "但还不是庆祝的时候…我甚至都没拿出过正式的作品，就被选中来画这么一篇很有分量的连载，心里也很没底…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "756720430",
                                                                                                    "speaker": "明妮",
                                                                                                    "text": "我会一边磨砺画技，一边认真完成这部外传的。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "756720431",
                                                                                                    "speaker": "明妮",
                                                                                                    "text": "这次纳塔之行，除了和瓦雷莎、希诺宁姐姐还有妮佩卡见面，也是想尽量领略这里的文化，为作品做好考据！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "756720432",
                                                                                                    "speaker": "瓦雷莎",
                                                                                                    "text": "嘿嘿，最近我在圣火竞技场卖水果的时候，从龙遗物协会那边获得了不少…古物？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "756720433",
                                                                                                    "speaker": "瓦雷莎",
                                                                                                    "text": "总之，我更了解菲耶蒂娜和泰卡在历史上的形象了，甚至是他们龙伙伴和车队的细节！"
                                                                                                },
                                                                                                {
                                                                                                    "id": "756720434",
                                                                                                    "speaker": "瓦雷莎",
                                                                                                    "text": "初稿也可以寄给我哦，我也来给你出建议！"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "756720427",
                                                                                            "text": "恭喜喔！"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "756720420",
                                                                            "text": "是个好消息。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756720413",
                                                            "text": "你家里人不担心吗？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756720435",
                                            "text": "这位是谁，好像没见过？",
                                            "response": [
                                                {
                                                    "id": "756720436",
                                                    "speaker": "瓦雷莎",
                                                    "text": "我简单介绍一下，这位是我们「炽魂斗士特战队」的首席画师明妮，和我一样爱好漫画织卷的朋友。"
                                                },
                                                {
                                                    "id": "756720437",
                                                    "speaker": "瓦雷莎",
                                                    "text": "之前我们一起参加了「龙脊雪山越野赛」，还拿了很不错的名次呢！"
                                                },
                                                {
                                                    "id": "756720438",
                                                    "speaker": "瓦雷莎",
                                                    "text": "这次，为了画好一部漫画的外传，她专程来纳塔采风的！",
                                                    "choices": [
                                                        {
                                                            "id": "756720439",
                                                            "text": "那你们玩得开心。",
                                                            "response": [
                                                                {
                                                                    "id": "756720441",
                                                                    "speaker": "明妮",
                                                                    "text": "好…也不打扰您了。"
                                                                },
                                                                {
                                                                    "id": "756720442",
                                                                    "speaker": "瓦雷莎",
                                                                    "text": "#那{NICKNAME}，有空的话，还请再来「沃陆之邦」玩玩！"
                                                                },
                                                                {
                                                                    "id": "756720443",
                                                                    "speaker": "瓦雷莎",
                                                                    "text": "我和瓦娜娜会准备好最甜的果子等着你的！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "756720440",
                                                            "text": "我先去忙我的了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756720444",
                            "text": "（不太想吃这个欸…先溜吧。）"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7567205",
            "initDialog": "756720501",
            "dialogues": [
                {
                    "id": "756720501",
                    "speaker": "希诺宁",
                    "text": "和明妮玩得开心吗？差不多可以回去了？"
                },
                {
                    "id": "756720502",
                    "speaker": "妮佩卡",
                    "text": "嗯嗯，我们都尽兴了！"
                },
                {
                    "id": "756720503",
                    "speaker": "妮佩卡",
                    "text": "还有，希诺宁姐姐，我仔细看了明妮给我带来的插画…"
                },
                {
                    "id": "756720504",
                    "speaker": "妮佩卡",
                    "text": "很多张画里都出现了…蒙德的「偶像」？西风教会的芭芭拉小姐，她跳舞的本领好像很厉害！"
                },
                {
                    "id": "756720505",
                    "speaker": "妮佩卡",
                    "text": "玛拉妮姐姐不是想要在度假村再举办一次跳舞派对吗？还说要再次试着邀请国外的跳舞高手…"
                },
                {
                    "id": "756720506",
                    "speaker": "妮佩卡",
                    "text": "说不定，玛拉妮姐姐会对这位芭芭拉小姐感兴趣？"
                },
                {
                    "id": "756720507",
                    "speaker": "希诺宁",
                    "text": "有道理哦，那我把这些画也给玛拉妮看看好了…"
                }
            ]
        },
        {
            "talkId": "7567302",
            "initDialog": "756730201",
            "dialogues": [
                {
                    "id": "756730201",
                    "speaker": "班尼特",
                    "text": "#哎呀，感觉我们也越来越默契了，{NICKNAME}！",
                    "choices": [
                        {
                            "id": "756730202",
                            "text": "还想复盘一下收集颜料的过程。",
                            "response": [
                                {
                                    "id": "756730203",
                                    "speaker": "班尼特",
                                    "text": "哦？难道你也有关于色彩的灵感了吗？那要加油哦！"
                                }
                            ]
                        },
                        {
                            "id": "756730204",
                            "text": "之后有什么打算？",
                            "response": [
                                {
                                    "id": "756730205",
                                    "speaker": "班尼特",
                                    "text": "嗯…可能有点卡时间。"
                                },
                                {
                                    "id": "756730206",
                                    "speaker": "班尼特",
                                    "text": "距离下一趟回蒙德的车队出发还余下几天，我想试着去爬一下图兰大火山。"
                                },
                                {
                                    "id": "756730207",
                                    "speaker": "班尼特",
                                    "text": "咳咳，我指的是，在外围区域，本着不会冒犯本地人习俗的前提登高，看看那里壮观的景色。",
                                    "choices": [
                                        {
                                            "id": "756730208",
                                            "text": "要注意安全哦。",
                                            "response": [
                                                {
                                                    "id": "756730210",
                                                    "speaker": "班尼特",
                                                    "text": "嗯，我会的！在纳塔，我信心满满！"
                                                },
                                                {
                                                    "id": "756730211",
                                                    "speaker": "班尼特",
                                                    "text": "也祝你一切顺利！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756730209",
                                            "text": "看风景时也要注意规避危险。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756730212",
                            "text": "下次再见啦，班尼特。",
                            "response": [
                                {
                                    "id": "756730213",
                                    "speaker": "班尼特",
                                    "text": "好嘞，我们都要好运连连，下次再一起分享开心事！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7567303",
            "initDialog": "756730301",
            "dialogues": [
                {
                    "id": "756730301",
                    "speaker": "明妮",
                    "text": "最近在悠悠度假村玩的时候，我也发现了几个低调的漫画织卷同好，他们都在讨论一部新作——"
                },
                {
                    "id": "756730302",
                    "speaker": "明妮",
                    "text": "《这位杜麦尼明明超强却过分随和》。"
                },
                {
                    "id": "756730303",
                    "speaker": "瓦雷莎",
                    "text": "啊，我好像听说过…"
                },
                {
                    "id": "756730304",
                    "speaker": "瓦雷莎",
                    "text": "是互动映影专家维热小姐的跨界作品，根据近几年纳塔民俗传说写成的轻小说。"
                },
                {
                    "id": "756730305",
                    "speaker": "明妮",
                    "text": "嗯嗯！因为叙事的方式和大部分流行作品不一样，更像是一种…散文游记？出人意料地得到了很棒的反响…"
                },
                {
                    "id": "756730306",
                    "speaker": "明妮",
                    "text": "我觉得，真正当上画师以后，我肯定也要拓宽作品的题材…"
                },
                {
                    "id": "756730307",
                    "speaker": "明妮",
                    "text": "等我把画技提高到足够的水平，我就试着给这部作品做一些漫画改编的分镜设计！"
                }
            ]
        }
    ]
}