    "talks": [
        {
            "talkId": "4019217",
            "initDialog": "401921701",
            "dialogues": [
                {
                    "id": "401921701",
                    "speaker": "绮良良",
                    "text": "——「狛荷屋」，竭诚为您服务！…啊，原来是你呀？"
                },
                {
                    "id": "401921702",
                    "speaker": "Player",
                    "text": "你这是在…"
                },
                {
                    "id": "401921703",
                    "speaker": "绮良良",
                    "text": "是「会场寄送服务」哟！你看，要是在摊位上抢购了一堆东西，背着逛祭典不是会非——常麻烦吗？"
                },
                {
                    "id": "401921704",
                    "speaker": "绮良良",
                    "text": "这种时候，就安心把东西交给「狛荷屋」吧！我们会安安稳稳地将您的心爱之物护送到家！"
                }
            ]
        },
        {
            "talkId": "4019218",
            "initDialog": "401921801",
            "dialogues": [
                {
                    "id": "401921801",
                    "speaker": "千织",
                    "text": "#嗯？好久不见，{NICKNAME}。"
                },
                {
                    "id": "401921802",
                    "speaker": "Player",
                    "text": "你是从枫丹赶来的吗？"
                },
                {
                    "id": "401921803",
                    "speaker": "千织",
                    "text": "嗯，既属于妖也属于人的盛大祭典，即便我身在水之国度也有所耳闻。"
                },
                {
                    "id": "401921804",
                    "speaker": "千织",
                    "text": "恰好绫华给我发了邀请，就试着回来看看了…稻妻如今的气氛，似乎比我出走时好了许多。"
                }
            ]
        },
        {
            "talkId": "4019219",
            "initDialog": "401921901",
            "dialogues": [
                {
                    "id": "401921901",
                    "speaker": "枫原万叶",
                    "text": "「天也醉樱花，云脚乱蹒跚…」"
                },
                {
                    "id": "401921902",
                    "speaker": "Player",
                    "text": "万叶没去玩游艺吗？"
                },
                {
                    "id": "401921903",
                    "speaker": "枫原万叶",
                    "text": "你们不是也被这里吸引了吗？虽是为祭典而来，但影向山的绯樱，也还是一如既往地引人驻足呢。"
                },
                {
                    "id": "401921904",
                    "speaker": "枫原万叶",
                    "text": "游艺那边我打算花上几天慢慢感受。山在观山色，雨来听雨声…既然是来游玩的，自然得随性些？"
                }
            ]
        },
        {
            "talkId": "4019220",
            "initDialog": "401922001",
            "dialogues": [
                {
                    "id": "401922001",
                    "speaker": "托马",
                    "text": "…你们感觉怎么样？没留下什么后遗症吧？"
                },
                {
                    "id": "401922002",
                    "speaker": "狐妖",
                    "text": "没事啦！那位食梦貘姐姐已经帮我们看过啦。"
                },
                {
                    "id": "401922003",
                    "speaker": "河童",
                    "text": "「噩梦碎片」消失后不久，我们就醒过来了…感觉就像做了一场梦。"
                },
                {
                    "id": "401922004",
                    "speaker": "独眼小僧",
                    "text": "抱歉，没能遵守约定，来帮托马老大做游艺…"
                },
                {
                    "id": "401922005",
                    "speaker": "托马",
                    "text": "没事没事，况且现在也不晚——一块来试试「秋津羽球」，多提点意见吧？"
                },
                {
                    "id": "401922006",
                    "speaker": "「证城」",
                    "text": "大家，一块砰砰！"
                }
            ]
        },
        {
            "talkId": "4019221",
            "initDialog": "401922101",
            "dialogues": [
                {
                    "id": "401922101",
                    "speaker": "早柚",
                    "text": "奇怪…明明做完了游艺很开心，但总觉得好像忘了什么事情…好像是最初的目标什么的…"
                },
                {
                    "id": "401922102",
                    "speaker": "宵宫",
                    "text": "唔…既然想不起来，那会不会，也不是什么重要的事？"
                },
                {
                    "id": "401922103",
                    "speaker": "神里绫华",
                    "text": "那不如就先放一下，来享受「三川花祭」吧？这次的「游艺」都很让人身临其境呢。"
                },
                {
                    "id": "401922104",
                    "speaker": "「吉法师」",
                    "text": "呶哈哈！——妖狸法术，噼咔噼咔！"
                }
            ]
        },
        {
            "talkId": "4019222",
            "initDialog": "401922201",
            "dialogues": [
                {
                    "id": "401922201",
                    "speaker": "「刑部小判」",
                    "text": "——呶！下次，砰砰！嚓嚓…"
                },
                {
                    "id": "401922202",
                    "speaker": "五郎",
                    "text": "奇怪…刑部小判他说的话…我怎么有些听不懂了？"
                },
                {
                    "id": "401922203",
                    "speaker": "珊瑚宫心海",
                    "text": "似乎是某种法术的效果快要结束了…不过我大概能猜到他想说什么。"
                },
                {
                    "id": "401922204",
                    "speaker": "珊瑚宫心海",
                    "text": "「——下一次，还要一起玩呀。」"
                }
            ]
        },
        {
            "talkId": "4019223",
            "initDialog": "401922301",
            "dialogues": [
                {
                    "id": "401922301",
                    "speaker": "影",
                    "text": "…纵使一度误会、疏远，甚至敌对，也能迎来共飨盛会之时。"
                },
                {
                    "id": "401922302",
                    "speaker": "影",
                    "text": "看着人类、妖怪、金阁、银阁、铁之助他们…不由得让人如此感慨。"
                },
                {
                    "id": "401922303",
                    "speaker": "Player",
                    "text": "说来金阁还有神子他们去哪了…"
                },
                {
                    "id": "401922304",
                    "speaker": "影",
                    "text": "他们已随瑞希下去检查了，「噩梦碎片」的消失对妖狸们是否会有影响，需得细细查过才能放心。"
                },
                {
                    "id": "401922305",
                    "speaker": "影",
                    "text": "…还是说，此前你们所言，贸然斩除噩梦，会牵连妖狸身上的因果…只是在打诳语？"
                },
                {
                    "id": "401922306",
                    "speaker": "Player",
                    "text": "没、没有哦…"
                },
                {
                    "id": "401922307",
                    "speaker": "影",
                    "text": "…呵。"
                }
            ]
        },
        {
            "talkId": "4019308",
            "initDialog": "401930801",
            "dialogues": [
                {
                    "id": "401930801",
                    "speaker": "宏达",
                    "text": "从各国送来了不少贺信和礼物啊，这些也都要好好记录下来。"
                },
                {
                    "id": "401930802",
                    "speaker": "平野",
                    "text": "蒙德城的蒲公英酒、璃月港的石珀…咦？这份礼物…好像指名要送给社奉行和天目锻冶屋…"
                },
                {
                    "id": "401930803",
                    "speaker": "宏达",
                    "text": "看起来是一些没见过的锻造图谱啊…全是稻妻样式的，难不成是以前失传的？"
                },
                {
                    "id": "401930804",
                    "speaker": "平野",
                    "text": "估计是教令院的历史学者们搜集整理的吧？这要还原出来还真不容易。我看看落款是…伐护末那学院？"
                }
            ]
        },
        {
            "talkId": "4019309",
            "initDialog": "401930901",
            "dialogues": [
                {
                    "id": "401930901",
                    "speaker": "卓也",
                    "text": "……"
                },
                {
                    "id": "401930902",
                    "speaker": "Player",
                    "text": "你不是…"
                },
                {
                    "id": "401930903",
                    "speaker": "卓也",
                    "text": "…咳，没错，是我，之前犯案被捕的青鬼后裔。没想到会在这种情况下再见。"
                },
                {
                    "id": "401930904",
                    "speaker": "卓也",
                    "text": "奉行所里来了个狐狸女人，说这里发生了跟鬼族相关的事件，让我来看看有没有戴罪立功的机会。"
                },
                {
                    "id": "401930905",
                    "speaker": "卓也",
                    "text": "结果我都还没过来，事情就已经全解决了…反倒是人类跟妖怪的祭典办得红红火火…"
                },
                {
                    "id": "401930906",
                    "speaker": "卓也",
                    "text": "…该不会那个女人，只是想让我亲眼见到，妖怪也好鬼族也好，都能跟人类好好相处了吧…"
                },
                {
                    "id": "401930907",
                    "speaker": "卓也",
                    "text": "咳！总之，我这趟出来的事，还是请你保密，尤其是向那个赤鬼后人。"
                },
                {
                    "id": "401930908",
                    "speaker": "卓也",
                    "text": "免得他又嚷着让我加入荒泷派…这种事还是等我刑期结束，好好做人…做鬼之后吧。"
                },
                {
                    "id": "401930909",
                    "speaker": "Player",
                    "text": "他自己也会进奉行所看你的…"
                },
                {
                    "id": "401930910",
                    "speaker": "卓也",
                    "text": "…这个还是请你们多看着他一点吧。"
                }
            ]
        },
        {
            "talkId": "4019310",
            "initDialog": "401931001",
            "dialogues": [
                {
                    "id": "401931001",
                    "speaker": "幸雄",
                    "text": "刚出锅的油豆腐！热腾腾的狐狸拉面！玩累了、逛累了，记得来上一碗！"
                }
            ]
        },
        {
            "talkId": "4019311",
            "initDialog": "401931101",
            "dialogues": [
                {
                    "id": "401931101",
                    "speaker": "智树",
                    "text": "团子牛奶！团子牛奶！大家都爱的团子牛奶~走过路过，不要错过！"
                }
            ]
        },
        {
            "talkId": "4019312",
            "initDialog": "401931201",
            "dialogues": [
                {
                    "id": "401931201",
                    "speaker": "荒谷",
                    "text": "《转生成为雷电将军，然后天下无敌》、《拜托了我的狐仙宫司》…畅销书籍，应有尽有！"
                },
                {
                    "id": "401931202",
                    "speaker": "荒谷",
                    "text": "还有洛柯蒂小姐的《稻妻秘见录》新作发售，神秘的食梦貘从何而来？——先行场贩，限时限量！"
                }
            ]
        },
        {
            "talkId": "4019313",
            "initDialog": "401931301",
            "dialogues": [
                {
                    "id": "401931301",
                    "speaker": "矢田幸喜",
                    "text": "常道恢弘，鸣神永恒。您好，我正在巡视护卫「三川花祭」。九条大人吩咐，兹事体大，要以十二成的谨慎行事。"
                },
                {
                    "id": "401931302",
                    "speaker": "矢田幸喜",
                    "text": "…话是这么说，有您在这里，也不会有谁胆敢造次吧？"
                }
            ]
        },
        {
            "talkId": "4019314",
            "initDialog": "401931401",
            "dialogues": [
                {
                    "id": "401931401",
                    "speaker": "渡边",
                    "text": "现在的新人真是毫无警惕性，万一遇上什么危机…不过一场祭典，会有什么危机呢？"
                }
            ]
        },
        {
            "talkId": "4019315",
            "initDialog": "401931501",
            "dialogues": [
                {
                    "id": "401931501",
                    "speaker": "阿茂",
                    "text": "我说顺吉，是你说要来「三川花祭」上找灵感，我才推迟了截稿日陪你来的…可你怎么全在吃喝玩乐啊？"
                },
                {
                    "id": "401931502",
                    "speaker": "顺吉",
                    "text": "咳咳…找灵感的事情，怎么能叫吃喝玩乐呢！我这是在体验祭典的氛围！喧闹的祭典、欢快的人类跟妖怪…"
                },
                {
                    "id": "401931503",
                    "speaker": "顺吉",
                    "text": "…其中却悄然混入了掌握「秘技·千变万化」的「鬼武者」！——你看灵感这不就来了吗！"
                }
            ]
        },
        {
            "talkId": "4019316",
            "initDialog": "401931601",
            "dialogues": [
                {
                    "id": "401931601",
                    "speaker": "稻城萤美",
                    "text": "#咦？{NICKNAME}，您也注意到这只小妖了吗？",
                    "choices": [
                        {
                            "id": "401931602",
                            "text": "这居然是妖怪？",
                            "response": [
                                {
                                    "id": "401931604",
                                    "speaker": "稻城萤美",
                                    "text": "嗯，这孩子似乎是新近才成了妖怪，还没有开口说话的妖力跟灵智…不过还是被「三川花祭」的氛围吸引来了呢。"
                                },
                                {
                                    "id": "401931605",
                                    "speaker": "？？？",
                                    "text": "♪~~"
                                },
                                {
                                    "id": "401931606",
                                    "speaker": "稻城萤美",
                                    "text": "欸？这孩子…似乎是想跟您一起游览「三川花祭」？它好像是把您认成了妖力强大的大妖前辈？",
                                    "choices": [
                                        {
                                            "id": "401931607",
                                            "text": "那本「代表」就负起责任…",
                                            "response": [
                                                {
                                                    "id": "401931609",
                                                    "speaker": "？？？",
                                                    "text": "♪~~♪~~"
                                                },
                                                {
                                                    "id": "401931610",
                                                    "speaker": "Player",
                                                    "text": "这又是什么意思？"
                                                },
                                                {
                                                    "id": "401931611",
                                                    "speaker": "稻城萤美",
                                                    "text": "唔…我猜大概是…「请多指教！」"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401931608",
                                            "text": "带着「后辈」好好见学参观！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401931603",
                            "text": "我还以为是路灯…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4019317",
            "initDialog": "401931701",
            "dialogues": [
                {
                    "id": "401931701",
                    "speaker": "高村",
                    "text": "唔…吃得好撑，早知道就不跟狐妖比赛吃狐狸拉面了…"
                }
            ]
        },
        {
            "talkId": "4019318",
            "initDialog": "401931801",
            "dialogues": [
                {
                    "id": "401931801",
                    "speaker": "浅利",
                    "text": "这些装饰和道具都是妖狸变出来的吗？妖怪可真厉害啊！"
                }
            ]
        },
        {
            "talkId": "4019319",
            "initDialog": "401931901",
            "dialogues": [
                {
                    "id": "401931901",
                    "speaker": "毅",
                    "text": "常道…常客您好，欢迎光临。",
                    "choices": [
                        {
                            "id": "401931902",
                            "text": "……",
                            "response": [
                                {
                                    "id": "401931904",
                                    "speaker": "毅",
                                    "text": "咳…果然瞒不过代表大人…不过将军既已不在天守阁，奥诘众要守护的地方，自然也会因时而异。"
                                }
                            ]
                        },
                        {
                            "id": "401931903",
                            "text": "总感觉在天守阁门口见过你…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4019320",
            "initDialog": "401932001",
            "dialogues": [
                {
                    "id": "401932001",
                    "speaker": "井上",
                    "text": "常…尝尝创意料理吧！这儿有什锦奶茶、幻彩团子，还有大家都爱的…呃…",
                    "choices": [
                        {
                            "id": "401932002",
                            "text": "团子牛奶？",
                            "response": [
                                {
                                    "id": "401932004",
                                    "speaker": "井上",
                                    "text": "对对对！多谢提醒…唉，这些不常见的料理，记起来可真累…"
                                }
                            ]
                        },
                        {
                            "id": "401932003",
                            "text": "团子牛奶。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4019321",
            "initDialog": "401932101",
            "dialogues": [
                {
                    "id": "401932101",
                    "speaker": "仁美",
                    "text": "#好久不见，试胆大会的优胜者，还是该叫你们…「{NICKNAME}和派蒙」？"
                },
                {
                    "id": "401932102",
                    "speaker": "派蒙",
                    "text": "啊——你是试胆大会上的那个…喜欢说怪话的巫女姐姐！你怎么来看八重堂的摊子了啊？"
                },
                {
                    "id": "401932103",
                    "speaker": "仁美",
                    "text": "呵呵…此地已被笼罩在漆黑阴霾之下，只有被宫司大人委以使命之人，才能在涌动的暗流中守住一线光明…",
                    "choices": [
                        {
                            "id": "401932104",
                            "text": "简单翻译一下…",
                            "response": [
                                {
                                    "id": "401932106",
                                    "speaker": "仁美",
                                    "text": "呵，宫司大人说，这里需要一位有胆识又有空的巫女镇守…所以我就主动请缨了。"
                                },
                                {
                                    "id": "401932107",
                                    "speaker": "派蒙",
                                    "text": "原来如此…经历过「试胆大会」的巫女…确实很有「胆识」呢！难怪神子会让你来！"
                                },
                                {
                                    "id": "401932108",
                                    "speaker": "仁美",
                                    "text": "啊，主要是因为我在「试胆大会」结束之后，就一直挺闲的~"
                                }
                            ]
                        },
                        {
                            "id": "401932105",
                            "text": "又是神子派你来的吧。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4019322",
            "initDialog": "401932201",
            "dialogues": [
                {
                    "id": "401932201",
                    "speaker": "矢田幸喜",
                    "text": "九条大人要我们尽量表现如常，暗中警戒…不过怎么才算「如常」呢？跟平时一样，用十二成的谨慎吗…"
                }
            ]
        },
        {
            "talkId": "4019323",
            "initDialog": "401932301",
            "dialogues": [
                {
                    "id": "401932301",
                    "speaker": "渡边",
                    "text": "唉…所以我才总让新人保持警惕…啊，大人好！这附近我一直有盯着，一有情况发生，我就去通知各位！"
                }
            ]
        },
        {
            "talkId": "4019324",
            "initDialog": "401932401",
            "dialogues": [
                {
                    "id": "401932401",
                    "speaker": "加目无",
                    "text": "吁…老身是听闻此间有人类跟妖怪共飨的盛会，才特意跑来凑热闹的。可这的客人，似乎比老身想象得要少吁…"
                }
            ]
        },
        {
            "talkId": "4019325",
            "initDialog": "401932501",
            "dialogues": [
                {
                    "id": "401932501",
                    "speaker": "末须久",
                    "text": "嚯嚯嚯，这「秋津羽球」真是新奇有趣…不过要是能再多些人一起玩就好了…"
                }
            ]
        },
        {
            "talkId": "4019326",
            "initDialog": "401932601",
            "dialogues": [
                {
                    "id": "401932601",
                    "speaker": "千贺",
                    "text": "…你们说，这该不会是妖怪作祟吧？"
                },
                {
                    "id": "401932602",
                    "speaker": "若菜",
                    "text": "怎么会？我昨天都还跟新认识的妖怪玩得开开心心的…"
                },
                {
                    "id": "401932603",
                    "speaker": "泷藤",
                    "text": "人类也一样有好有坏吧，谁知道妖怪里面有没有不喜欢这「三川花祭」的…"
                }
            ]
        },
        {
            "talkId": "4019327",
            "initDialog": "401932701",
            "dialogues": [
                {
                    "id": "401932701",
                    "speaker": "毅",
                    "text": "情况我们已经听说，身为「奥诘众」一员，却只能看着您和将军大人迎敌，实在惭愧…"
                },
                {
                    "id": "401932702",
                    "speaker": "毅",
                    "text": "我们会全力为两位祈祷——另外，如果要来碗狐狸拉面补充体力，还请尽管吩咐！"
                }
            ]
        },
        {
            "talkId": "4019328",
            "initDialog": "401932801",
            "dialogues": [
                {
                    "id": "401932801",
                    "speaker": "井上",
                    "text": "终于不用再做这些奇奇怪怪的创意料理了…不知道为什么还挺不舍的…"
                },
                {
                    "id": "401932802",
                    "speaker": "井上",
                    "text": "咳，要是不嫌弃的话，等到您和将军大人得胜归来，请再来吃一回「团子牛奶」吧！"
                }
            ]
        },
        {
            "talkId": "4019329",
            "initDialog": "401932901",
            "dialogues": [
                {
                    "id": "401932901",
                    "speaker": "仁美",
                    "text": "宫司大人已经吩咐我们去做好仪式的准备了。冲破黑暗的阴霾，后面就是光明的未来！"
                },
                {
                    "id": "401932902",
                    "speaker": "仁美",
                    "text": "「试胆大会」的优胜者、「三川花祭」的代表与代表的代表…这一次也一定要拿下优胜呀。"
                }
            ]
        },
        {
            "talkId": "4019330",
            "initDialog": "401933001",
            "dialogues": [
                {
                    "id": "401933001",
                    "speaker": "矢田幸喜",
                    "text": "好，让天领奉行众都打起十二成的精神！这一次可不能再让九条裟罗大人失望了！"
                }
            ]
        },
        {
            "talkId": "4019331",
            "initDialog": "401933101",
            "dialogues": [
                {
                    "id": "401933101",
                    "speaker": "渡边",
                    "text": "这一回不用我敦促，新人们就自己鼓足干劲了，干脆就这么一鼓作气，把后面的训练也安排下来…"
                }
            ]
        },
        {
            "talkId": "4019332",
            "initDialog": "401933201",
            "dialogues": [
                {
                    "id": "401933201",
                    "speaker": "加目无",
                    "text": "赶跑了噩梦，「三川花祭」就会更热闹了吧！那老身也去要一份祷词吁~"
                }
            ]
        },
        {
            "talkId": "4019333",
            "initDialog": "401933301",
            "dialogues": [
                {
                    "id": "401933301",
                    "speaker": "末须久",
                    "text": "听说是有噩梦捣乱，来玩的人才变少了？真是可恶！"
                }
            ]
        },
        {
            "talkId": "4019334",
            "initDialog": "401933401",
            "dialogues": [
                {
                    "id": "401933401",
                    "speaker": "幸雄",
                    "text": "呼…社奉行的人说，这几天他们会代为打理我的摊子…居然还真打理得不错？干干净净，简直像是没动过！"
                }
            ]
        },
        {
            "talkId": "4019335",
            "initDialog": "401933501",
            "dialogues": [
                {
                    "id": "401933501",
                    "speaker": "智树",
                    "text": "这些天都是在吃社奉行准备的料理…实在太重复了！现在是时候让社奉行见识见识我的创新料理了！"
                }
            ]
        },
        {
            "talkId": "4019336",
            "initDialog": "401933601",
            "dialogues": [
                {
                    "id": "401933601",
                    "speaker": "荒谷",
                    "text": "嗯，都得好好回信呀…"
                },
                {
                    "id": "401933602",
                    "speaker": "Player",
                    "text": "这些信件是…？"
                },
                {
                    "id": "401933603",
                    "speaker": "荒谷",
                    "text": "啊，刚刚社奉行送来了一些指名送给八重堂的贺信，有白垩老师的贺图、枕玉老师的亲笔信…"
                },
                {
                    "id": "401933604",
                    "speaker": "荒谷",
                    "text": "还有这一封：「荒谷阿姨好！宫司大人大姐姐好！希望八重堂的祭典能办好，请帮我跟宵宫姐姐问好！」"
                },
                {
                    "id": "401933605",
                    "speaker": "荒谷",
                    "text": "呵呵，虽然忘了写名字，不过我大概能猜到，是哪位小小姐写的呢。"
                }
            ]
        }
    ]
}