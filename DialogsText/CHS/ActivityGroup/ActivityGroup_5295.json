{
    "groupId": "5295",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Player": 14,
        "「耶耶副教官」": 6,
        "克维库": 11,
        "科米娜": 13
    },
    "talks": [
        {
            "talkId": "7567002",
            "initDialog": "756700201",
            "dialogues": [
                {
                    "id": "756700201",
                    "speaker": "科米娜",
                    "text": "两位好，体验得如何了？",
                    "choices": [
                        {
                            "id": "756700202",
                            "text": "非常好，一定会大受欢迎的。",
                            "response": [
                                {
                                    "id": "756700203",
                                    "speaker": "科米娜",
                                    "text": "感谢你的祝福…这样的话，克维库先生心中的担忧总能放下一大半了吧。"
                                },
                                {
                                    "id": "756700204",
                                    "speaker": "科米娜",
                                    "text": "那场大战过后，他就经常发呆，然后——他想要大家都去尝试和龙伙伴们进行更有创意、更有趣的合作。"
                                },
                                {
                                    "id": "756700205",
                                    "speaker": "科米娜",
                                    "text": "我猜，他肯定是有一位难以忘怀的好伙伴永远地停留在了某一个时间节点上…"
                                },
                                {
                                    "id": "756700206",
                                    "speaker": "科米娜",
                                    "text": "好在他现在总归是精神一点了…每天看看像耶耶这样活蹦乱跳的小家伙们，总归是要比一个人呆在家好的。"
                                }
                            ]
                        },
                        {
                            "id": "756700207",
                            "text": "简直想要带只小龙回家看看…",
                            "response": [
                                {
                                    "id": "756700208",
                                    "speaker": "科米娜",
                                    "text": "那些小家伙的确有这样的魔力呢。"
                                },
                                {
                                    "id": "756700209",
                                    "speaker": "科米娜",
                                    "text": "虽然它们不会说话，还经常捣乱，但只要有它们在身边，总觉得一切事情都会变得好起来…"
                                },
                                {
                                    "id": "756700210",
                                    "speaker": "科米娜",
                                    "text": "这可能也是克维库先生真正想要让大家体验的东西吧。",
                                    "choices": [
                                        {
                                            "id": "756700211",
                                            "text": "小龙真是很好的伙伴对象呢。",
                                            "response": [
                                                {
                                                    "id": "756700213",
                                                    "speaker": "科米娜",
                                                    "text": "总之，和小龙呆在一起是一种很奇妙的感觉…有时候我甚至觉得，这比我的一些治疗都有效果呢。"
                                                },
                                                {
                                                    "id": "756700214",
                                                    "speaker": "科米娜",
                                                    "text": "啊…不多说了，是时候检查一下龙伙伴们的身体了。如果你想要体验那些关卡的话，请自便。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756700212",
                                            "text": "说得我想再去体验一遍了！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756700215",
                            "text": "我正准备去体验呢。",
                            "response": [
                                {
                                    "id": "756700216",
                                    "speaker": "科米娜",
                                    "text": "好哦…对了，有一点需要提醒你，大部分人和龙伙伴们玩起来都会容易忘记时间的流逝。"
                                },
                                {
                                    "id": "756700217",
                                    "speaker": "科米娜",
                                    "text": "如果你觉得你的肌肉感觉到疲惫的话，要记得注意停下来休息一下，放松放松。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7567003",
            "initDialog": "756700301",
            "dialogues": [
                {
                    "id": "756700301",
                    "speaker": "克维库",
                    "text": "想来试试看吗？龙伙伴们都已经准备好了呢。",
                    "choices": [
                        {
                            "id": "756700302",
                            "text": "好呀，我也准备好了。",
                            "response": [
                                {
                                    "id": "756700303",
                                    "speaker": "克维库",
                                    "text": "来吧！这体验不会让你失望的！"
                                }
                            ]
                        },
                        {
                            "id": "756700304",
                            "text": "有些不够玩。",
                            "response": [
                                {
                                    "id": "756700305",
                                    "speaker": "克维库",
                                    "text": "真的吗？实不相瞒，在去「回声之子」前，我的心都还在打鼓，万一没有人愿意尝试…"
                                },
                                {
                                    "id": "756700306",
                                    "speaker": "克维库",
                                    "text": "倒也不是担心其他的，我只是有时候看到那些小家伙们亮亮的眼睛，就总是觉得不得劲，这让我想起了我的老伙计…"
                                },
                                {
                                    "id": "756700307",
                                    "speaker": "克维库",
                                    "text": "它是条好龙…噢，特别活泼，你不陪它玩的时候，它就围着你绕来绕去，就像一个好奇的小宝宝一样…"
                                },
                                {
                                    "id": "756700308",
                                    "speaker": "克维库",
                                    "text": "还有科米娜小姐——有时候没有她，我都不知道下一步该怎么办好了。"
                                },
                                {
                                    "id": "756700309",
                                    "speaker": "克维库",
                                    "text": "但现在有你的肯定，我就安心多啦，至少看在你的份上，都会有许多人愿意尝试吧。",
                                    "choices": [
                                        {
                                            "id": "756700310",
                                            "text": "没有我也是一样的。",
                                            "response": [
                                                {
                                                    "id": "756700312",
                                                    "speaker": "克维库",
                                                    "text": "啊哈哈哈哈…不论如何，你还是帮我们大忙了。"
                                                },
                                                {
                                                    "id": "756700313",
                                                    "speaker": "克维库",
                                                    "text": "等到下次我想出新的关卡，我一定邀请你来第一个尝试。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "756700311",
                                            "text": "与龙同游的魅力很难抵抗。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "756700314",
                            "text": "我先热热身再来。",
                            "response": [
                                {
                                    "id": "756700315",
                                    "speaker": "克维库",
                                    "text": "啊，在运动前进行适当的热身是正确的…总之，你想玩了就来找我，我随时都在。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7567004",
            "initDialog": "756700401",
            "dialogues": [
                {
                    "id": "756700401",
                    "speaker": "「耶耶副教官」",
                    "text": "耶耶！",
                    "choices": [
                        {
                            "id": "756700402",
                            "text": "（拍拍。）",
                            "response": [
                                {
                                    "id": "756700403",
                                    "speaker": "「耶耶副教官」",
                                    "text": "呼呼——"
                                }
                            ]
                        },
                        {
                            "id": "756700404",
                            "text": "下次见！",
                            "response": [
                                {
                                    "id": "756700405",
                                    "speaker": "「耶耶副教官」",
                                    "text": "嗯…嗯！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7567005",
            "initDialog": "756700501",
            "dialogues": [
                {
                    "id": "756700501",
                    "speaker": "「耶耶副教官」",
                    "text": "你好！你好！",
                    "choices": [
                        {
                            "id": "756700502",
                            "text": "耶耶玩得高兴吗？",
                            "response": [
                                {
                                    "id": "756700503",
                                    "speaker": "「耶耶副教官」",
                                    "text": "呀！耶耶开心！"
                                }
                            ]
                        },
                        {
                            "id": "756700504",
                            "text": "再见咯——",
                            "response": [
                                {
                                    "id": "756700505",
                                    "speaker": "「耶耶副教官」",
                                    "text": "耶耶，再见~"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
