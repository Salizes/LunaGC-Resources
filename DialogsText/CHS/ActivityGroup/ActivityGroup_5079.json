{
    "groupId": "5079",
    "total_dialogue_lines": 41,
    "speaker_counts": {
        "Player": 4,
        "老图": 4,
        "胡塞尼": 28,
        "阿昊": 5
    },
    "talks": [
        {
            "talkId": "7150105",
            "initDialog": "715010501",
            "dialogues": [
                {
                    "id": "715010501",
                    "speaker": "胡塞尼",
                    "text": "现在就开始「普尔希娜光钉」的试运行吧，没关系，我会在旁边看着你操作的。"
                }
            ]
        },
        {
            "talkId": "7150204",
            "initDialog": "715020401",
            "dialogues": [
                {
                    "id": "715020401",
                    "speaker": "胡塞尼",
                    "text": "开启「普尔希娜光钉」吧，不过注意，一定小心黑泥和靠近的怪物，避免「普尔希娜光钉」停止运作。"
                }
            ]
        },
        {
            "talkId": "7150304",
            "initDialog": "715030401",
            "dialogues": [
                {
                    "id": "715030401",
                    "speaker": "胡塞尼",
                    "text": "#只能在这里先启动光钉，清理黑泥了。{NICKNAME}，小心别让「普尔希娜光钉」受损了。"
                }
            ]
        },
        {
            "talkId": "7150406",
            "initDialog": "715040601",
            "dialogues": [
                {
                    "id": "715040601",
                    "speaker": "老图",
                    "text": "要是你想开始搬运，启动热气球就行了。"
                },
                {
                    "id": "715040602",
                    "speaker": "阿昊",
                    "text": "嗯…路上黑泥啊怪物啊那么多，你自己得小心啊。"
                }
            ]
        },
        {
            "talkId": "7150407",
            "initDialog": "715040501",
            "dialogues": [
                {
                    "id": "715040501",
                    "speaker": "胡塞尼",
                    "text": "希望用热气球搬运「普尔希娜光钉」能够成功。"
                }
            ]
        },
        {
            "talkId": "7150504",
            "initDialog": "715050401",
            "dialogues": [
                {
                    "id": "715050401",
                    "speaker": "胡塞尼",
                    "text": "在地脉接洽的黑泥喷口启动「普尔希娜光钉」，肯定会产生相当大的影响，你自己一定要多多注意。"
                }
            ]
        },
        {
            "talkId": "7150606",
            "initDialog": "715060601",
            "dialogues": [
                {
                    "id": "715060601",
                    "speaker": "胡塞尼",
                    "text": "为了测算岩层的各项参数，还要取岩石样本来进行实验才行。"
                },
                {
                    "id": "715060602",
                    "speaker": "胡塞尼",
                    "text": "不能有负「教令院」之名啊…"
                }
            ]
        },
        {
            "talkId": "7150705",
            "initDialog": "715070501",
            "dialogues": [
                {
                    "id": "715070501",
                    "speaker": "胡塞尼",
                    "text": "嗯…那些矿工真是格外可靠，将光钉从营地周围搬到这里的时候步伐平稳地不可思议。"
                },
                {
                    "id": "715070502",
                    "speaker": "胡塞尼",
                    "text": "希望之后他们将光钉搬下矿道的时候也能这样顺利。"
                }
            ]
        },
        {
            "talkId": "7150805",
            "initDialog": "715080501",
            "dialogues": [
                {
                    "id": "715080501",
                    "speaker": "胡塞尼",
                    "text": "黑泥还在逐渐泛滥，不能让这种情况继续下去…"
                },
                {
                    "id": "715080502",
                    "speaker": "胡塞尼",
                    "text": "有什么不接触地面就能将「普尔希娜光钉」运送进去的办法吗？"
                }
            ]
        },
        {
            "talkId": "7150806",
            "initDialog": "715080601",
            "dialogues": [
                {
                    "id": "715080601",
                    "speaker": "老图",
                    "text": "咳咳…虽然还有点不舒服，不过至少比在矿区的时候好多了。"
                }
            ]
        },
        {
            "talkId": "7150807",
            "initDialog": "715080701",
            "dialogues": [
                {
                    "id": "715080701",
                    "speaker": "阿昊",
                    "text": "那个黑泥究竟是个什么东西，不小心碰一下，就感觉自己半边身子都凉了…咳咳…"
                },
                {
                    "id": "715080702",
                    "speaker": "阿昊",
                    "text": "不会留下什么后遗症吧…"
                }
            ]
        },
        {
            "talkId": "7150907",
            "initDialog": "715090701",
            "dialogues": [
                {
                    "id": "715090701",
                    "speaker": "胡塞尼",
                    "text": "#啊，{NICKNAME}，要调试完「普尔希娜光钉」还需要一段时间。"
                }
            ]
        },
        {
            "talkId": "7150908",
            "initDialog": "715090801",
            "dialogues": [
                {
                    "id": "715090801",
                    "speaker": "老图",
                    "text": "怎么样，清理黑泥的过程还顺利吗？"
                },
                {
                    "id": "715090802",
                    "speaker": "老图",
                    "text": "要有什么力所能及能帮上的，就随时跟我说！"
                }
            ]
        },
        {
            "talkId": "7150909",
            "initDialog": "715090901",
            "dialogues": [
                {
                    "id": "715090901",
                    "speaker": "阿昊",
                    "text": "希望黑泥能快点清理掉吧。"
                },
                {
                    "id": "715090902",
                    "speaker": "阿昊",
                    "text": "唉…不知道什么时候能恢复到以前，大家一起下矿时那样啊…"
                }
            ]
        },
        {
            "talkId": "7151005",
            "initDialog": "715100501",
            "dialogues": [
                {
                    "id": "715100501",
                    "speaker": "胡塞尼",
                    "text": "终于帮海迪夫解决了这次黑泥泛滥的问题…",
                    "choices": [
                        {
                            "id": "715100502",
                            "text": "你好。",
                            "response": [
                                {
                                    "id": "715100503",
                                    "speaker": "胡塞尼",
                                    "text": "#…你好啊，{NICKNAME}，今天过得如何？"
                                },
                                {
                                    "id": "715100504",
                                    "speaker": "胡塞尼",
                                    "text": "回想起来，算上这一次，每一次你都帮了我很大的忙"
                                },
                                {
                                    "id": "715100505",
                                    "speaker": "胡塞尼",
                                    "text": "「导能圆盘」那次，在鹤观进行特殊遗迹重机观察的那次，还有这次在层岩巨渊。"
                                },
                                {
                                    "id": "715100506",
                                    "speaker": "胡塞尼",
                                    "text": "每次都是些危急或者复杂的情况，但是正因为你出现，最后都能有一个好结果。"
                                },
                                {
                                    "id": "715100507",
                                    "speaker": "胡塞尼",
                                    "text": "这么想，真不知道是你的运气好，还是每次都能遇到你的我运气好呀…"
                                }
                            ]
                        },
                        {
                            "id": "715100508",
                            "text": "关于自传…",
                            "response": [
                                {
                                    "id": "715100509",
                                    "speaker": "胡塞尼",
                                    "text": "只是随口说说的，我现在离能够写自传的等级还远。"
                                },
                                {
                                    "id": "715100510",
                                    "speaker": "胡塞尼",
                                    "text": "更何况，还有许多研究课题等着我去攻克，你想，要是我多攻克一个研究课题，自传就能多写上几页。"
                                },
                                {
                                    "id": "715100511",
                                    "speaker": "胡塞尼",
                                    "text": "所以自传这个东西，肯定是越晚写越划算。"
                                }
                            ]
                        },
                        {
                            "id": "715100512",
                            "text": "关于海迪夫…",
                            "response": [
                                {
                                    "id": "715100513",
                                    "speaker": "胡塞尼",
                                    "text": "你是想问为什么会接受海迪夫的委托，来层岩巨渊帮忙吗？"
                                },
                                {
                                    "id": "715100514",
                                    "speaker": "胡塞尼",
                                    "text": "你知道「普尔比鲁尼」吗，海迪夫是「普尔比鲁尼」一门的学者。"
                                },
                                {
                                    "id": "715100515",
                                    "speaker": "胡塞尼",
                                    "text": "在「教令院」的时候，我曾经接受过「普尔比鲁尼」一门很多的帮助，受他的委托前来，其实也算是一种报答。"
                                },
                                {
                                    "id": "715100516",
                                    "speaker": "胡塞尼",
                                    "text": "算是正常的人情往来吧，单一领域的学者有的时候并没有办法解决所有的问题，所以需要不同的学者一起研究，"
                                },
                                {
                                    "id": "715100517",
                                    "speaker": "胡塞尼",
                                    "text": "这也是一种构建学者之间关系的方式。"
                                }
                            ]
                        },
                        {
                            "id": "715100518",
                            "text": "祝你顺利，再见！",
                            "response": [
                                {
                                    "id": "715100519",
                                    "speaker": "胡塞尼",
                                    "text": "谢谢你的祝福，再见！"
                                },
                                {
                                    "id": "715100520",
                                    "speaker": "胡塞尼",
                                    "text": "希望真的能顺利一些吧…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}