{
    "groupId": "2014",
    "total_dialogue_lines": 157,
    "speaker_counts": {
        "Player": 42,
        "冰封之心": 2,
        "奥兹": 6,
        "枫原万叶": 28,
        "温迪": 2,
        "火炽之心": 2,
        "莫娜": 28,
        "菲谢尔": 18,
        "辛焱": 29
    },
    "talks": [
        {
            "talkId": "4006411",
            "initDialog": "400641101",
            "dialogues": [
                {
                    "id": "400641101",
                    "speaker": "枫原万叶",
                    "text": "听着海风享用美食，当真是一件乐事。辛焱，多谢你为大家准备的晚餐。"
                },
                {
                    "id": "400641102",
                    "speaker": "辛焱",
                    "text": "没事，不用客气。看大家吃得开心，我也满足得很。我还担心自己对数量把控缺乏经验，不够吃…或者吃剩好多呢。"
                },
                {
                    "id": "400641103",
                    "speaker": "辛焱",
                    "text": "啊，对了…你们逛得怎么样，有没有去高点的地方看看风景？"
                },
                {
                    "id": "400641104",
                    "speaker": "枫原万叶",
                    "text": "嗯，吟游诗人口中「绿宝石般的」岛屿名副其实。"
                },
                {
                    "id": "400641105",
                    "speaker": "辛焱",
                    "text": "哦？难道那一整个故事也都是真的？"
                },
                {
                    "id": "400641106",
                    "speaker": "枫原万叶",
                    "text": "不好说。不过，我倒是相信的。"
                },
                {
                    "id": "400641107",
                    "speaker": "辛焱",
                    "text": "那要是明天醒来，我们就能见到故事里的魔王或者嘟嘟可，一定会很有意思。"
                },
                {
                    "id": "400641108",
                    "speaker": "辛焱",
                    "text": "…不对，见不到也没关系。能来到故事里的岛屿，还能交到蒙德的朋友，已经很有收获了。"
                }
            ]
        },
        {
            "talkId": "4006412",
            "initDialog": "400641201",
            "dialogues": [
                {
                    "id": "400641201",
                    "speaker": "菲谢尔",
                    "text": "凡尘的诱惑迫使真相却步，昭告胜利的判决未能显现在我的面前。"
                },
                {
                    "id": "400641202",
                    "speaker": "莫娜",
                    "text": "没想到，你还好意思再提起这个话题。"
                },
                {
                    "id": "400641203",
                    "speaker": "莫娜",
                    "text": "#你跟奥兹一唱一和，拼命在{NICKNAME}和派蒙耳边暗示，我看早就偏离了公平吧。"
                },
                {
                    "id": "400641204",
                    "speaker": "莫娜",
                    "text": "而且，也只有输了的人才会想要得到…"
                },
                {
                    "id": "400641205",
                    "speaker": "菲谢尔",
                    "text": "你说什么？"
                },
                {
                    "id": "400641206",
                    "speaker": "奥兹",
                    "text": "小姐，她的意思是你输了。"
                },
                {
                    "id": "400641207",
                    "speaker": "菲谢尔",
                    "text": "多嘴！奥兹！"
                },
                {
                    "id": "400641208",
                    "speaker": "菲谢尔",
                    "text": "咳咳…梅姬斯图斯卿，且让这神圣的胜负暂且搁置。待我重回幽夜的王座，再邀你于忘忧之御膳园中一决高下。"
                },
                {
                    "id": "400641209",
                    "speaker": "莫娜",
                    "text": "可以是可以，反正再来几次结果都是一样的…但那到底是个什么地方啊？"
                }
            ]
        },
        {
            "talkId": "4006413",
            "initDialog": "400641301",
            "dialogues": [
                {
                    "id": "400641301",
                    "speaker": "温迪",
                    "text": "哈啾！"
                },
                {
                    "id": "400641302",
                    "speaker": "温迪",
                    "text": "唔…果然还是不能离猫太近…我就待在房顶上吧。"
                }
            ]
        },
        {
            "talkId": "4006707",
            "initDialog": "400670701",
            "dialogues": [
                {
                    "id": "400670701",
                    "speaker": "莫娜",
                    "text": "水占盘…究竟是怎么一回事呢。"
                },
                {
                    "id": "400670702",
                    "speaker": "莫娜",
                    "text": "进一步的观测就交给专业人士我吧，有情况第一时间通知你。嗯，合作愉快。"
                }
            ]
        },
        {
            "talkId": "4006708",
            "initDialog": "400670801",
            "dialogues": [
                {
                    "id": "400670801",
                    "speaker": "辛焱",
                    "text": "万叶还算豁达，皇女殿下有莫娜陪伴，也不用过于操心。"
                },
                {
                    "id": "400670802",
                    "speaker": "辛焱",
                    "text": "#至于{NICKNAME}…你的状态看起来就和我一样好嘛！"
                }
            ]
        },
        {
            "talkId": "4006709",
            "initDialog": "400670901",
            "dialogues": [
                {
                    "id": "400670901",
                    "speaker": "枫原万叶",
                    "text": "「此身恰如秋叶，浮流远山海。」"
                },
                {
                    "id": "400670902",
                    "speaker": "枫原万叶",
                    "text": "如今的我仍在旅途之中，但回想自己曾经写下的诗句，心境却有不同。"
                }
            ]
        },
        {
            "talkId": "4007001",
            "initDialog": "400700101",
            "dialogues": [
                {
                    "id": "400700101",
                    "speaker": "莫娜",
                    "text": "菲谢尔不想面对的幻境，会是什么样子呢？"
                },
                {
                    "id": "400700102",
                    "speaker": "莫娜",
                    "text": "该不会…出现一堆幻影自称自己才是菲谢尔·冯·露弗施洛斯·那菲多特，幽夜净土的主人，漆黑烬灭的统御者…"
                },
                {
                    "id": "400700103",
                    "speaker": "莫娜",
                    "text": "紧接着用各种难懂的语言来争论些有的没的…咿。"
                },
                {
                    "id": "400700104",
                    "speaker": "莫娜",
                    "text": "算了算了，不该自己吓自己…"
                }
            ]
        },
        {
            "talkId": "4007002",
            "initDialog": "400700201",
            "dialogues": [
                {
                    "id": "400700201",
                    "speaker": "辛焱",
                    "text": "直到现在，我的脑海中还回荡着先前的旋律。真是不可思议的经历！"
                },
                {
                    "id": "400700202",
                    "speaker": "辛焱",
                    "text": "话说回来，我的愿望是实现了，但不知道其他人的幻境之旅会不会顺利…"
                },
                {
                    "id": "400700203",
                    "speaker": "辛焱",
                    "text": "先养足精力吧！无论出现怎样的情况，我该做的都是支持同伴。"
                }
            ]
        },
        {
            "talkId": "4007003",
            "initDialog": "400700301",
            "dialogues": [
                {
                    "id": "400700301",
                    "speaker": "枫原万叶",
                    "text": "为了不增添大家的焦虑，当时我没有着重提及…愚人众不见踪迹这件事，让我有些在意。"
                },
                {
                    "id": "400700302",
                    "speaker": "枫原万叶",
                    "text": "看你的样子…我明白了，看来我们的判断相近。"
                },
                {
                    "id": "400700303",
                    "speaker": "枫原万叶",
                    "text": "那我们就继续保持留意和警惕吧。"
                }
            ]
        },
        {
            "talkId": "4007006",
            "initDialog": "400700601",
            "dialogues": [
                {
                    "id": "400700601",
                    "speaker": "火炽之心",
                    "text": "为反抗高歌！"
                },
                {
                    "id": "400700602",
                    "speaker": "火炽之心",
                    "text": "嗯，充满气势地喊出这句话，心情就会变得舒畅。"
                }
            ]
        },
        {
            "talkId": "4007007",
            "initDialog": "400700701",
            "dialogues": [
                {
                    "id": "400700701",
                    "speaker": "冰封之心",
                    "text": "嘘…静下心来，仔细听。"
                },
                {
                    "id": "400700702",
                    "speaker": "冰封之心",
                    "text": "听到了吗？海洋，天空，山崖…世间万物都有只属于它们自己的歌声。"
                }
            ]
        },
        {
            "talkId": "4007301",
            "initDialog": "400730101",
            "dialogues": [
                {
                    "id": "400730101",
                    "speaker": "菲谢尔",
                    "text": "奥兹，总之…那个…咳咳，还是要谢谢你。"
                },
                {
                    "id": "400730102",
                    "speaker": "奥兹",
                    "text": "小姐不必客气，这都是我应该做的。能够追随小姐你，是我的荣幸。"
                },
                {
                    "id": "400730103",
                    "speaker": "菲谢尔",
                    "text": "那本皇女便赐你随侍我左右的殊荣，一同去看看戏剧吧。"
                },
                {
                    "id": "400730104",
                    "speaker": "奥兹",
                    "text": "一如小姐所愿。"
                }
            ]
        },
        {
            "talkId": "4007303",
            "initDialog": "400730301",
            "dialogues": [
                {
                    "id": "400730301",
                    "speaker": "莫娜",
                    "text": "菲谢尔的矛盾，确实在于「自我」。不过幻影只有一个，看来我此前的猜想还是激进了一些。"
                },
                {
                    "id": "400730302",
                    "speaker": "莫娜",
                    "text": "好在一番折腾之后，她总算是和自己和解了。"
                },
                {
                    "id": "400730303",
                    "speaker": "莫娜",
                    "text": "就是我这位「宫廷大法师」，不得不继续当下去了啊。"
                }
            ]
        },
        {
            "talkId": "4007305",
            "initDialog": "400730501",
            "dialogues": [
                {
                    "id": "400730501",
                    "speaker": "辛焱",
                    "text": "菲谢尔的那番驳斥相当不错！戏剧感很强，又有力量。要不是担心打断她说话，真想为她配上一段激昂的伴奏。"
                },
                {
                    "id": "400730502",
                    "speaker": "辛焱",
                    "text": "现在所有人重新聚在一起，剧场也搭起来了。我很喜欢这种感觉。"
                },
                {
                    "id": "400730503",
                    "speaker": "辛焱",
                    "text": "趁着这个时候，一起狂欢吧！"
                }
            ]
        },
        {
            "talkId": "4007307",
            "initDialog": "400730701",
            "dialogues": [
                {
                    "id": "400730701",
                    "speaker": "枫原万叶",
                    "text": "「寻路归故里，夜鸦轻啼向空去…」"
                },
                {
                    "id": "400730702",
                    "speaker": "枫原万叶",
                    "text": "嗯…虽然幻境的主题大不相同，但我总觉得其中也有某种共性。"
                },
                {
                    "id": "400730703",
                    "speaker": "枫原万叶",
                    "text": "…有了，结尾就用：「雨霁留虹霓。」"
                }
            ]
        },
        {
            "talkId": "4007703",
            "initDialog": "400770301",
            "dialogues": [
                {
                    "id": "400770301",
                    "speaker": "菲谢尔",
                    "text": "哦呵呵，是本皇女最忠实的扈从。",
                    "choices": [
                        {
                            "id": "400770302",
                            "text": "要不要聊聊天？",
                            "response": [
                                {
                                    "id": "400770303",
                                    "speaker": "菲谢尔",
                                    "text": "自然可以，本皇女赐你提问的权力。",
                                    "choices": [
                                        {
                                            "id": "400770306",
                                            "text": "关于夜鸦剧场…",
                                            "response": [
                                                {
                                                    "id": "400770307",
                                                    "speaker": "菲谢尔",
                                                    "text": "哦？你已经见识过圣国的戏剧了吗？"
                                                },
                                                {
                                                    "id": "400770308",
                                                    "speaker": "菲谢尔",
                                                    "text": "哼哼，不必吝啬称赞，那景象确为世间独有。"
                                                },
                                                {
                                                    "id": "400770309",
                                                    "speaker": "奥兹",
                                                    "text": "小姐已经迫不及待想要听到你的点评了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400770310",
                                            "text": "关于《圣国的咏唱》…",
                                            "response": [
                                                {
                                                    "id": "400770311",
                                                    "speaker": "菲谢尔",
                                                    "text": "其为幽夜净土圣典，切勿使之破损沾污…"
                                                },
                                                {
                                                    "id": "400770312",
                                                    "speaker": "Player",
                                                    "text": "我会好好保存。"
                                                },
                                                {
                                                    "id": "400770313",
                                                    "speaker": "菲谢尔",
                                                    "text": "哼，那就好。"
                                                },
                                                {
                                                    "id": "400770314",
                                                    "speaker": "奥兹",
                                                    "text": "在小姐心中，这也是见证这次旅途的宝贵纪念品。你的重视令她格外高兴。"
                                                },
                                                {
                                                    "id": "400770315",
                                                    "speaker": "菲谢尔",
                                                    "text": "奥兹，不需要翻译到这种程度！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400770316",
                                            "text": "关于这次假期…",
                                            "response": [
                                                {
                                                    "id": "400770317",
                                                    "speaker": "菲谢尔",
                                                    "text": "本皇女此番君临净土，见得这般欢庆盛况，很是愉快。"
                                                },
                                                {
                                                    "id": "400770318",
                                                    "speaker": "菲谢尔",
                                                    "text": "我行遍万千世界，自然也知道，宴席总有散场之日。"
                                                },
                                                {
                                                    "id": "400770319",
                                                    "speaker": "菲谢尔",
                                                    "text": "于是，我昭告子民，本皇女尚在巡礼之中，还有远方的扈从需要帮助。"
                                                },
                                                {
                                                    "id": "400770320",
                                                    "speaker": "奥兹",
                                                    "text": "和大家告别的时候，小姐都哭了呢。"
                                                },
                                                {
                                                    "id": "400770321",
                                                    "speaker": "菲谢尔",
                                                    "text": "奥兹！我都说过了，只是无礼的沙进入了眼角而已！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400770304",
                            "text": "先不打扰你了。",
                            "response": [
                                {
                                    "id": "400770305",
                                    "speaker": "菲谢尔",
                                    "text": "与吾命运交错之人，在此乐土畅游吧。",
                                    "choices": [
                                        {
                                            "id": "400770306",
                                            "text": "关于夜鸦剧场…"
                                        },
                                        {
                                            "id": "400770310",
                                            "text": "关于《圣国的咏唱》…"
                                        },
                                        {
                                            "id": "400770316",
                                            "text": "关于这次假期…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4007704",
            "initDialog": "400770401",
            "dialogues": [
                {
                    "id": "400770401",
                    "speaker": "莫娜",
                    "text": "假日要接近尾声了吗…",
                    "choices": [
                        {
                            "id": "400770402",
                            "text": "要不要聊聊天？",
                            "response": [
                                {
                                    "id": "400770403",
                                    "speaker": "莫娜",
                                    "text": "行啊，有什么要问我的吗？",
                                    "choices": [
                                        {
                                            "id": "400770406",
                                            "text": "关于水占盘…",
                                            "response": [
                                                {
                                                    "id": "400770407",
                                                    "speaker": "莫娜",
                                                    "text": "唉，说来也是扫兴，这几次一有大事发生，我的水占盘就会变得不太正常。"
                                                },
                                                {
                                                    "id": "400770408",
                                                    "speaker": "莫娜",
                                                    "text": "…简直像有意阻止我窥探结局一样。"
                                                },
                                                {
                                                    "id": "400770409",
                                                    "speaker": "莫娜",
                                                    "text": "等等，你会这么问，该不会也是想调侃这一点吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400770410",
                                            "text": "关于星空…",
                                            "response": [
                                                {
                                                    "id": "400770411",
                                                    "speaker": "莫娜",
                                                    "text": "哦，我正好想问你。当你看到那片星空的时候，内心有什么感想吗？"
                                                },
                                                {
                                                    "id": "400770412",
                                                    "speaker": "Player",
                                                    "text": "好厉害！"
                                                },
                                                {
                                                    "id": "400770413",
                                                    "speaker": "莫娜",
                                                    "text": "是…是吗。"
                                                },
                                                {
                                                    "id": "400770414",
                                                    "speaker": "莫娜",
                                                    "text": "毕、毕竟我是伟大的天才占星术士，幻境当然也得气派恢弘…"
                                                },
                                                {
                                                    "id": "400770415",
                                                    "speaker": "Player",
                                                    "text": "不愧是莫娜！"
                                                },
                                                {
                                                    "id": "400770416",
                                                    "speaker": "莫娜",
                                                    "text": "唔…不过那个时候我还沉浸在自己的思绪里，还是听到你说话才反应过来…"
                                                },
                                                {
                                                    "id": "400770417",
                                                    "speaker": "Player",
                                                    "text": "实在太好看了！"
                                                },
                                                {
                                                    "id": "400770418",
                                                    "speaker": "莫娜",
                                                    "text": "喂…我、我知道了啦。你这家伙，故意的吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400770419",
                                            "text": "关于这次假期…",
                                            "response": [
                                                {
                                                    "id": "400770420",
                                                    "speaker": "莫娜",
                                                    "text": "虽然最初是被菲谢尔连拖带拽喊过来的，但在不知不觉中，度过了一个愉快的夏天啊。"
                                                },
                                                {
                                                    "id": "400770421",
                                                    "speaker": "莫娜",
                                                    "text": "见证并守护大家的命运——的确是我想做的事。"
                                                },
                                                {
                                                    "id": "400770422",
                                                    "speaker": "Player",
                                                    "text": "莫娜做得很好哦。"
                                                },
                                                {
                                                    "id": "400770423",
                                                    "speaker": "莫娜",
                                                    "text": "谢谢，倒是你…你也辛苦了。"
                                                },
                                                {
                                                    "id": "400770424",
                                                    "speaker": "莫娜",
                                                    "text": "期待下次和你继续合作，呵呵…我们会变得更有默契吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400770404",
                            "text": "先不打扰你了。",
                            "response": [
                                {
                                    "id": "400770405",
                                    "speaker": "莫娜",
                                    "text": "嗯，离开这片海岛前，再多多享受一下吧。",
                                    "choices": [
                                        {
                                            "id": "400770406",
                                            "text": "关于水占盘…"
                                        },
                                        {
                                            "id": "400770410",
                                            "text": "关于星空…"
                                        },
                                        {
                                            "id": "400770419",
                                            "text": "关于这次假期…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4007705",
            "initDialog": "400770501",
            "dialogues": [
                {
                    "id": "400770501",
                    "speaker": "辛焱",
                    "text": "又有了新的作曲灵感…",
                    "choices": [
                        {
                            "id": "400770502",
                            "text": "要不要聊聊天？",
                            "response": [
                                {
                                    "id": "400770503",
                                    "speaker": "辛焱",
                                    "text": "好啊好啊，我非常乐意。",
                                    "choices": [
                                        {
                                            "id": "400770506",
                                            "text": "关于朋友…",
                                            "response": [
                                                {
                                                    "id": "400770507",
                                                    "speaker": "辛焱",
                                                    "text": "回去之后，我要好好跟她们分享这次的冒险故事。说不定，还能给云堇的璃月戏创作增添点灵感呢。"
                                                },
                                                {
                                                    "id": "400770508",
                                                    "speaker": "辛焱",
                                                    "text": "至于香菱嘛，在我说起做饭话题的时候，肯定就会帮着出主意了。"
                                                },
                                                {
                                                    "id": "400770509",
                                                    "speaker": "辛焱",
                                                    "text": "你知道的，她最专业了，肯定懂很多…类似不用炖锅也能做出好菜的方法，我想向她学一点…"
                                                },
                                                {
                                                    "id": "400770510",
                                                    "speaker": "辛焱",
                                                    "text": "在新朋友有空来玩之前，得多练会几道看家菜才行。哦，烤堇瓜也安排上！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400770511",
                                            "text": "关于音乐…",
                                            "response": [
                                                {
                                                    "id": "400770512",
                                                    "speaker": "辛焱",
                                                    "text": "这次在幻境中没弹摇滚，是不是让你有点遗憾？"
                                                },
                                                {
                                                    "id": "400770513",
                                                    "speaker": "Player",
                                                    "text": "怎么会呢。"
                                                },
                                                {
                                                    "id": "400770514",
                                                    "speaker": "辛焱",
                                                    "text": "呼，听你这样说，我就放心了。"
                                                },
                                                {
                                                    "id": "400770515",
                                                    "speaker": "辛焱",
                                                    "text": "摇滚是我的最爱，这一点从来不会改变。"
                                                },
                                                {
                                                    "id": "400770516",
                                                    "speaker": "辛焱",
                                                    "text": "但音乐也是情感的载体。比起单纯抒发自己的感受，我判断那样的形式会更切合场合。"
                                                },
                                                {
                                                    "id": "400770517",
                                                    "speaker": "辛焱",
                                                    "text": "嘿嘿，这样说来，你也是我的知音了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400770518",
                                            "text": "关于这次假期…",
                                            "response": [
                                                {
                                                    "id": "400770519",
                                                    "speaker": "辛焱",
                                                    "text": "简直太充实，太快乐了！"
                                                },
                                                {
                                                    "id": "400770520",
                                                    "speaker": "辛焱",
                                                    "text": "多亏有你，还有那位吟游诗人小哥的邀请。"
                                                },
                                                {
                                                    "id": "400770521",
                                                    "speaker": "辛焱",
                                                    "text": "也不知道他的驻场演唱顺不顺利…欠了他那么大一个人情，回头得好好感谢人家。"
                                                },
                                                {
                                                    "id": "400770522",
                                                    "speaker": "Player",
                                                    "text": "一起请他喝一杯吧。"
                                                },
                                                {
                                                    "id": "400770523",
                                                    "speaker": "辛焱",
                                                    "text": "好！那就这么说定了！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400770504",
                            "text": "先不打扰你了。",
                            "response": [
                                {
                                    "id": "400770505",
                                    "speaker": "辛焱",
                                    "text": "好，别累着自己了哦。",
                                    "choices": [
                                        {
                                            "id": "400770506",
                                            "text": "关于朋友…"
                                        },
                                        {
                                            "id": "400770511",
                                            "text": "关于音乐…"
                                        },
                                        {
                                            "id": "400770518",
                                            "text": "关于这次假期…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4007706",
            "initDialog": "400770601",
            "dialogues": [
                {
                    "id": "400770601",
                    "speaker": "枫原万叶",
                    "text": "四周「自然」的声音安逸，可以放心了…",
                    "choices": [
                        {
                            "id": "400770602",
                            "text": "要不要聊聊天？",
                            "response": [
                                {
                                    "id": "400770603",
                                    "speaker": "枫原万叶",
                                    "text": "好，你想到些什么了？",
                                    "choices": [
                                        {
                                            "id": "400770606",
                                            "text": "关于喝酒…",
                                            "response": [
                                                {
                                                    "id": "400770607",
                                                    "speaker": "枫原万叶",
                                                    "text": "咳、咳咳…"
                                                },
                                                {
                                                    "id": "400770608",
                                                    "speaker": "枫原万叶",
                                                    "text": "都已经过去了那么几天，原来你还没忘记啊。"
                                                },
                                                {
                                                    "id": "400770609",
                                                    "speaker": "枫原万叶",
                                                    "text": "酒应是风雅之物，失态醉倒，实在让人难以启齿。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400770610",
                                            "text": "关于过去…",
                                            "response": [
                                                {
                                                    "id": "400770611",
                                                    "speaker": "枫原万叶",
                                                    "text": "是啊，这样一来，也算是与它正式告别了。"
                                                },
                                                {
                                                    "id": "400770612",
                                                    "speaker": "枫原万叶",
                                                    "text": "放心，我和那时说的一样，既没有伤感低落，也不会留恋徘徊。"
                                                },
                                                {
                                                    "id": "400770613",
                                                    "speaker": "枫原万叶",
                                                    "text": "我发自内心感激这机缘巧合。"
                                                },
                                                {
                                                    "id": "400770614",
                                                    "speaker": "Player",
                                                    "text": "万叶总是那么豁达…"
                                                },
                                                {
                                                    "id": "400770615",
                                                    "speaker": "枫原万叶",
                                                    "text": "谢谢你能这样说，我可以将它视为你对我的肯定吗？"
                                                },
                                                {
                                                    "id": "400770616",
                                                    "speaker": "Player",
                                                    "text": "当然。"
                                                },
                                                {
                                                    "id": "400770617",
                                                    "speaker": "枫原万叶",
                                                    "text": "能与你这样的良友相识真好。"
                                                },
                                                {
                                                    "id": "400770618",
                                                    "speaker": "枫原万叶",
                                                    "text": "那就让我们重新回到眼前的风景中。在离开之前，再多看看这里的风和月吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400770619",
                                            "text": "关于这次假期…",
                                            "response": [
                                                {
                                                    "id": "400770620",
                                                    "speaker": "枫原万叶",
                                                    "text": "起伏跌宕，却也不虚此行。"
                                                },
                                                {
                                                    "id": "400770621",
                                                    "speaker": "枫原万叶",
                                                    "text": "北斗大姐头和船员们要是问起来，我就讲讲船灵和松鼠吧…至于新朋友们的故事，还是留在各自心中。"
                                                },
                                                {
                                                    "id": "400770622",
                                                    "speaker": "Player",
                                                    "text": "这样也好。"
                                                },
                                                {
                                                    "id": "400770623",
                                                    "speaker": "枫原万叶",
                                                    "text": "#一段旅途的结束，也是下一次旅程的开始。{NICKNAME}，你对这一点是最有感受的吧。"
                                                },
                                                {
                                                    "id": "400770624",
                                                    "speaker": "枫原万叶",
                                                    "text": "…只要走在路上就好。"
                                                },
                                                {
                                                    "id": "400770625",
                                                    "speaker": "枫原万叶",
                                                    "text": "和你一样，我也对未来充满了期待。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400770604",
                            "text": "先不打扰你了。",
                            "response": [
                                {
                                    "id": "400770605",
                                    "speaker": "枫原万叶",
                                    "text": "这些日子你也多有操劳，好好休息。",
                                    "choices": [
                                        {
                                            "id": "400770606",
                                            "text": "关于喝酒…"
                                        },
                                        {
                                            "id": "400770610",
                                            "text": "关于过去…"
                                        },
                                        {
                                            "id": "400770619",
                                            "text": "关于这次假期…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}