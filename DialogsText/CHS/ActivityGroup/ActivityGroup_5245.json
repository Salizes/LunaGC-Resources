{
    "groupId": "5245",
    "total_dialogue_lines": 46,
    "speaker_counts": {
        "Player": 20,
        "赫卡": 26
    },
    "talks": [
        {
            "talkId": "7565802",
            "initDialog": "756580201",
            "dialogues": [
                {
                    "id": "756580201",
                    "speaker": "赫卡",
                    "text": "我随时可以出发。",
                    "choices": [
                        {
                            "id": "756580202",
                            "text": "前往挑战地点。"
                        },
                        {
                            "id": "756580203",
                            "text": "暂时还有别的事。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7565803",
            "initDialog": "756580301",
            "dialogues": [
                {
                    "id": "756580301",
                    "speaker": "赫卡",
                    "text": "委托已经完成了。如果你还想继续挑战巨大怪物，我也可以陪你。",
                    "choices": [
                        {
                            "id": "756580302",
                            "text": "前往挑战地点。"
                        },
                        {
                            "id": "756580303",
                            "text": "暂时还有别的事。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7565805",
            "initDialog": "756580501",
            "dialogues": [
                {
                    "id": "756580501",
                    "speaker": "赫卡",
                    "text": "准备好挑战巨大螃蟹了吗？",
                    "choices": [
                        {
                            "id": "756580502",
                            "text": "现在准备一下。"
                        },
                        {
                            "id": "756580503",
                            "text": "想随便聊聊…",
                            "response": [
                                {
                                    "id": "756580504",
                                    "speaker": "赫卡",
                                    "text": "挪德卡莱也有蟹类，不过和它长得很不一样。唔，多拍几张画片好了，玫熙说不定会比较喜欢枫丹的螃蟹呢。"
                                },
                                {
                                    "id": "756580505",
                                    "speaker": "赫卡",
                                    "text": "不过话说回来，究竟是因为有了热泉才演化出了这样的物种，还是帝皇的存在让泉水也为之沸腾呢？"
                                },
                                {
                                    "id": "756580506",
                                    "speaker": "Player",
                                    "text": "关于挪德卡莱…"
                                },
                                {
                                    "id": "756580507",
                                    "speaker": "赫卡",
                                    "text": "硬要说的话，是很危险但也生机勃勃的地方？不过从最近的动向来看，可能危险的部分更多一些。"
                                },
                                {
                                    "id": "756580508",
                                    "speaker": "赫卡",
                                    "text": "在我离开之前，愚人众就运来了很多建筑材料，听说什么「执行官」也在，不知道是有什么打算。"
                                },
                                {
                                    "id": "756580509",
                                    "speaker": "赫卡",
                                    "text": "而且听说北边的情况也不是很好，深渊的力量似乎在扩大影响…卡嘉也让我回程时不要从北边取道。"
                                }
                            ]
                        },
                        {
                            "id": "756580510",
                            "text": "稍等。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7565806",
            "initDialog": "756580601",
            "dialogues": [
                {
                    "id": "756580601",
                    "speaker": "赫卡",
                    "text": "准备好挑战巨大水团了吗？",
                    "choices": [
                        {
                            "id": "756580602",
                            "text": "现在准备一下。"
                        },
                        {
                            "id": "756580603",
                            "text": "想随便聊聊…",
                            "response": [
                                {
                                    "id": "756580604",
                                    "speaker": "赫卡",
                                    "text": "水的意志也会以这样的形式显现…原来如此。真不可思议，它看起来并不像是没有灵魂的样子。"
                                },
                                {
                                    "id": "756580605",
                                    "speaker": "赫卡",
                                    "text": "卡嘉讲过一个故事，一个渔夫爱上了纯水的精怪，但精怪是没有灵魂的，于是渔夫踏上旅途，只为舍弃他自己的灵魂…"
                                },
                                {
                                    "id": "756580606",
                                    "speaker": "Player",
                                    "text": "关于卡嘉…"
                                },
                                {
                                    "id": "756580607",
                                    "speaker": "赫卡",
                                    "text": "她以前也是很厉害的冒险者，走南闯北去过很多地方，后来因为伤病告别了冒险生涯，就在那夏镇定居下来。"
                                },
                                {
                                    "id": "756580608",
                                    "speaker": "赫卡",
                                    "text": "她一直很照顾我们，在我出发之前也给了我很多实用的建议…我很敬佩她，也很感谢她。"
                                },
                                {
                                    "id": "756580609",
                                    "speaker": "赫卡",
                                    "text": "对了，如果有机会，一定要尝尝她的手艺！"
                                }
                            ]
                        },
                        {
                            "id": "756580610",
                            "text": "稍等。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7565807",
            "initDialog": "756580701",
            "dialogues": [
                {
                    "id": "756580701",
                    "speaker": "赫卡",
                    "text": "准备好挑战巨大人马石像了吗？",
                    "choices": [
                        {
                            "id": "756580702",
                            "text": "现在准备一下。"
                        },
                        {
                            "id": "756580703",
                            "text": "想随便聊聊…",
                            "response": [
                                {
                                    "id": "756580704",
                                    "speaker": "赫卡",
                                    "text": "这是古时候的文明所制造的机关吧。看它的样子就像是舞台上的演奏家，制造出它的文明真是了不得。"
                                },
                                {
                                    "id": "756580705",
                                    "speaker": "赫卡",
                                    "text": "卡嘉说，过去的挪德卡莱也有过秩序与繁荣的文明，似乎从它的身上也能看到那时的影子呢。"
                                },
                                {
                                    "id": "756580706",
                                    "speaker": "Player",
                                    "text": "关于过去的挪德卡莱…"
                                },
                                {
                                    "id": "756580707",
                                    "speaker": "赫卡",
                                    "text": "这个嘛，其实挪德卡莱也算是至冬的一部分呢，所以在过去，至冬曾经对那里进行过大规模的开发。"
                                },
                                {
                                    "id": "756580708",
                                    "speaker": "赫卡",
                                    "text": "但是现在除了随处可见的机械垃圾以外，已经找不到那时候留下来的痕迹了。"
                                },
                                {
                                    "id": "756580709",
                                    "speaker": "赫卡",
                                    "text": "不过说不定正是因为这样，挪德卡莱才会变成现在生机勃勃的样子。"
                                }
                            ]
                        },
                        {
                            "id": "756580710",
                            "text": "稍等。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7565808",
            "initDialog": "756580801",
            "dialogues": [
                {
                    "id": "756580801",
                    "speaker": "赫卡",
                    "text": "准备好挑战巨大机关怪物了吗？",
                    "choices": [
                        {
                            "id": "756580802",
                            "text": "现在准备一下。"
                        },
                        {
                            "id": "756580803",
                            "text": "想随便聊聊…",
                            "response": [
                                {
                                    "id": "756580804",
                                    "speaker": "赫卡",
                                    "text": "和它风格类似的遗迹我在挪德卡莱见过，嗯，在「霜月之子」们聚集的那座岛上…"
                                },
                                {
                                    "id": "756580805",
                                    "speaker": "赫卡",
                                    "text": "不过那些家伙都死气沉沉的，像这样会动的还是第一次见。真有趣，好好记录下来告诉玫熙吧。"
                                },
                                {
                                    "id": "756580806",
                                    "speaker": "Player",
                                    "text": "关于「霜月之子」…"
                                },
                                {
                                    "id": "756580807",
                                    "speaker": "赫卡",
                                    "text": "该怎么说呢，那是一群奇怪的人。和住在那夏镇里的人不一样，他们大部分时候都待在野外还有森林里面。"
                                },
                                {
                                    "id": "756580808",
                                    "speaker": "赫卡",
                                    "text": "据说他们崇拜着月亮的神明，挪德卡莱各处都能见到他们制作的雕像。剩下的我也不知道了，卡嘉让我少打听他们的事。"
                                },
                                {
                                    "id": "756580809",
                                    "speaker": "赫卡",
                                    "text": "不过我见过他们使用魔法哦，你要是看到了一定会很惊讶的。"
                                }
                            ]
                        },
                        {
                            "id": "756580810",
                            "text": "稍等。"
                        }
                    ]
                }
            ]
        }
    ]
}