    "talks": [
        {
            "talkId": "4014151",
            "initDialog": "401415101",
            "dialogues": [
                {
                    "id": "401415101",
                    "speaker": "夏洛蒂",
                    "text": "海灯节简直太棒了！我今晚可能睡不着了！",
                    "choices": [
                        {
                            "id": "401415102",
                            "text": "关于「械动式垂直拉升装置」…",
                            "response": [
                                {
                                    "id": "401415103",
                                    "speaker": "夏洛蒂",
                                    "text": "哦，你问这个啊。"
                                },
                                {
                                    "id": "401415104",
                                    "speaker": "夏洛蒂",
                                    "text": "这个装置的发明者，是一位叫伊尔德松斯的枫丹人。"
                                },
                                {
                                    "id": "401415105",
                                    "speaker": "夏洛蒂",
                                    "text": "他天天鼓捣着一些冷门的机关发明，还好几次找到我们报社，想让我们报道他的发明。"
                                },
                                {
                                    "id": "401415106",
                                    "speaker": "夏洛蒂",
                                    "text": "我找找他的原话，哦！"
                                },
                                {
                                    "id": "401415107",
                                    "speaker": "夏洛蒂",
                                    "text": "「本装置采用纯机械动力驱动，不需使用任何额外能源」…"
                                },
                                {
                                    "id": "401415108",
                                    "speaker": "夏洛蒂",
                                    "text": "就是手动上紧机关啦。这个装置能飞多高，取决于操作者的手能使出多大力气…"
                                },
                                {
                                    "id": "401415109",
                                    "speaker": "夏洛蒂",
                                    "text": "能把它和风筝结合在一起，真是个神奇的好主意。",
                                    "choices": [
                                        {
                                            "id": "401415110",
                                            "text": "关于茶的报道与合作…",
                                            "response": [
                                                {
                                                    "id": "401415111",
                                                    "speaker": "夏洛蒂",
                                                    "text": "和叶先生的交流很顺利，我的稿件已经寄回枫丹了。"
                                                },
                                                {
                                                    "id": "401415112",
                                                    "speaker": "夏洛蒂",
                                                    "text": "这是一篇兼具「真实」与「故事」的专访稿，连我自己都很满意。"
                                                },
                                                {
                                                    "id": "401415113",
                                                    "speaker": "夏洛蒂",
                                                    "text": "对了，还要感谢大家创造的这个机会！尤其是那位说话很有个性的闲云女士。"
                                                },
                                                {
                                                    "id": "401415114",
                                                    "speaker": "夏洛蒂",
                                                    "text": "多亏你们的人脉与创意，我才能得到这份意料之外的「特色礼物」。",
                                                    "choices": [
                                                        {
                                                            "id": "401415102",
                                                            "text": "关于「械动式垂直拉升装置」…"
                                                        },
                                                        {
                                                            "id": "401415115",
                                                            "text": "关于海灯节…",
                                                            "response": [
                                                                {
                                                                    "id": "401415116",
                                                                    "speaker": "夏洛蒂",
                                                                    "text": "我还是第一次亲身体验其他国家的节日，感想是…非常激动！"
                                                                },
                                                                {
                                                                    "id": "401415117",
                                                                    "speaker": "夏洛蒂",
                                                                    "text": "张灯结彩的节日氛围，「喜庆」所带给人的感染力，厚重、绵长而又诗意的传统与文化…"
                                                                },
                                                                {
                                                                    "id": "401415118",
                                                                    "speaker": "夏洛蒂",
                                                                    "text": "哦对了，刻晴送我的风筝上，还亲笔题了一首她自己写的诗呢！"
                                                                },
                                                                {
                                                                    "id": "401415119",
                                                                    "speaker": "夏洛蒂",
                                                                    "text": "「叠纸眺风倚亭槛，几方梦回递纸鸢。绝云登岭另有志，愿眺荻花在清滩。」"
                                                                },
                                                                {
                                                                    "id": "401415120",
                                                                    "speaker": "夏洛蒂",
                                                                    "text": "我想把这首诗也记录进我的海灯节专题报道，一定会有很多人喜欢的！",
                                                                    "choices": [
                                                                        {
                                                                            "id": "401415102",
                                                                            "text": "关于「械动式垂直拉升装置」…"
                                                                        },
                                                                        {
                                                                            "id": "401415110",
                                                                            "text": "关于茶的报道与合作…"
                                                                        },
                                                                        {
                                                                            "id": "401415121",
                                                                            "text": "下次再见哦，夏洛蒂。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "401415122",
                                                                                    "speaker": "夏洛蒂",
                                                                                    "text": "嗯！也祝你度过一个愉快的节日！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "401415121",
                                                            "text": "下次再见哦，夏洛蒂。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "401415115",
                                            "text": "关于海灯节…"
                                        },
                                        {
                                            "id": "401415121",
                                            "text": "下次再见哦，夏洛蒂。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "401415110",
                            "text": "关于茶的报道与合作…"
                        },
                        {
                            "id": "401415115",
                            "text": "关于海灯节…"
                        },
                        {
                            "id": "401415121",
                            "text": "下次再见哦，夏洛蒂。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4014152",
            "initDialog": "401415201",
            "dialogues": [
                {
                    "id": "401415201",
                    "speaker": "接笏",
                    "text": "看你这样子，是又想念老朋友了？"
                },
                {
                    "id": "401415202",
                    "speaker": "侯章",
                    "text": "睹物思人，也是在所难免…"
                },
                {
                    "id": "401415203",
                    "speaker": "接笏",
                    "text": "说罢。说出来会好些。"
                },
                {
                    "id": "401415204",
                    "speaker": "侯章",
                    "text": "要是弥怒尚在，能与你我二人共观此太平盛世…"
                },
                {
                    "id": "401415205",
                    "speaker": "侯章",
                    "text": "他手艺一向精巧，扎风筝不在话下。此时此刻，他若能支个小摊贩卖风筝，定然顾客盈门，生意兴隆。"
                },
                {
                    "id": "401415206",
                    "speaker": "侯章",
                    "text": "如果他和从前一样，无缘太近人世，可把风筝托给我们。我们卖完风筝后，打上几两浊酒，带回去与他共醉…"
                },
                {
                    "id": "401415207",
                    "speaker": "接笏",
                    "text": "削月。斯人已逝。"
                },
                {
                    "id": "401415208",
                    "speaker": "侯章",
                    "text": "…是啊。斯人已逝…"
                },
                {
                    "id": "401415209",
                    "speaker": "侯章",
                    "text": "我们再多看几眼吧，替他多看几眼。"
                }
            ]
        },
        {
            "talkId": "4014153",
            "initDialog": "401415301",
            "dialogues": [
                {
                    "id": "401415301",
                    "speaker": "申鹤",
                    "text": "想不通…"
                },
                {
                    "id": "401415302",
                    "speaker": "甘雨",
                    "text": "遇到麻烦了？申鹤你说就好。"
                },
                {
                    "id": "401415303",
                    "speaker": "申鹤",
                    "text": "黑色耐脏，但香菱不愿我穿着这身在万民堂工作，说是不合适。"
                },
                {
                    "id": "401415304",
                    "speaker": "申鹤",
                    "text": "不合适…在哪里呢？"
                },
                {
                    "id": "401415305",
                    "speaker": "甘雨",
                    "text": "…应该说是场合和身份感不相符。"
                },
                {
                    "id": "401415306",
                    "speaker": "甘雨",
                    "text": "如果申鹤是像今天这样，和朋友们一起享受海灯节，或是观赏夜景、参加重要宴会…就非常合适哦。"
                },
                {
                    "id": "401415307",
                    "speaker": "申鹤",
                    "text": "是只能穿给重要之人看的意思，对吧？"
                },
                {
                    "id": "401415308",
                    "speaker": "甘雨",
                    "text": "呃…这么想也可以吧。"
                }
            ]
        },
        {
            "talkId": "4014154",
            "initDialog": "401415401",
            "dialogues": [
                {
                    "id": "401415401",
                    "speaker": "叶德",
                    "text": "你还是爱吃冬蓉酥？"
                },
                {
                    "id": "401415402",
                    "speaker": "嘉明",
                    "text": "不是吧？结果派蒙那些话，全被老爸听进去了啊…"
                },
                {
                    "id": "401415403",
                    "speaker": "叶德",
                    "text": "呵呵…肯定的嘛。哪个做父亲的会不留意跟自己孩子有关的事情呢？"
                },
                {
                    "id": "401415404",
                    "speaker": "叶德",
                    "text": "我就想起你小时候啊，就爱骑在我头上去看舞兽戏。每次回去路上又吵着肚子饿，要吃饼。"
                },
                {
                    "id": "401415405",
                    "speaker": "叶德",
                    "text": "我们一次只买两块，但不知不觉，把整条街都吃了个遍。"
                },
                {
                    "id": "401415406",
                    "speaker": "叶德",
                    "text": "有一回还是你请我吃的呢！用的是你的零花钱，还记得吗？"
                },
                {
                    "id": "401415407",
                    "speaker": "嘉明",
                    "text": "嗯…记得的我。"
                },
                {
                    "id": "401415408",
                    "speaker": "叶德",
                    "text": "那真是我吃过的最好吃的冬蓉酥啦…"
                },
                {
                    "id": "401415409",
                    "speaker": "嘉明",
                    "text": "我们回头再去吃吧，店还在。我记得路，还我请。"
                },
                {
                    "id": "401415410",
                    "speaker": "叶德",
                    "text": "…真的？"
                },
                {
                    "id": "401415411",
                    "speaker": "嘉明",
                    "text": "嗯！"
                }
            ]
        },
        {
            "talkId": "4014155",
            "initDialog": "401415501",
            "dialogues": [
                {
                    "id": "401415501",
                    "speaker": "七七",
                    "text": "风筝，飞得很高。"
                },
                {
                    "id": "401415502",
                    "speaker": "七七",
                    "text": "瑶瑶，谢谢你，我很喜欢。"
                },
                {
                    "id": "401415503",
                    "speaker": "瑶瑶",
                    "text": "我也很开心！"
                },
                {
                    "id": "401415504",
                    "speaker": "瑶瑶",
                    "text": "不仅仅是今天，以后我们也可以一起放哦。"
                },
                {
                    "id": "401415505",
                    "speaker": "七七",
                    "text": "真的？"
                },
                {
                    "id": "401415506",
                    "speaker": "瑶瑶",
                    "text": "下回找个白天吧？白天的时候图案很明显的！飞高高之后特别像小团雀。"
                },
                {
                    "id": "401415507",
                    "speaker": "七七",
                    "text": "好。"
                },
                {
                    "id": "401415508",
                    "speaker": "七七",
                    "text": "风筝…晚上可以抱着睡觉吗？"
                },
                {
                    "id": "401415509",
                    "speaker": "瑶瑶",
                    "text": "嘿嘿，当然可以哟。"
                }
            ]
        },
        {
            "talkId": "4014156",
            "initDialog": "401415601",
            "dialogues": [
                {
                    "id": "401415601",
                    "speaker": "闲云",
                    "text": "玉衡星啊，这风筝比赛冠军的奖品，依本仙看，还是留给其他人吧。"
                },
                {
                    "id": "401415602",
                    "speaker": "刻晴",
                    "text": "仙家不必客气。在众多风筝里，您的风筝无出其右，实属仙巧。奖品理应由您收下。"
                },
                {
                    "id": "401415603",
                    "speaker": "刻晴",
                    "text": "更何况，如果没有您出手相助，今年的海灯节也难得如此圆满…"
                },
                {
                    "id": "401415604",
                    "speaker": "闲云",
                    "text": "…呵，那本仙便不再推脱了。但是，还请玉衡星再帮本仙一个忙。"
                },
                {
                    "id": "401415605",
                    "speaker": "刻晴",
                    "text": "仙家但说无妨。"
                },
                {
                    "id": "401415606",
                    "speaker": "闲云",
                    "text": "这一整箱「松萝仙芽」，还请玉衡星转赠那些正在岗的千岩军。佳节安康，全凭他们全心守责。"
                },
                {
                    "id": "401415607",
                    "speaker": "刻晴",
                    "text": "（不愧是留云借风真君！思虑深远，做事周全。）"
                },
                {
                    "id": "401415608",
                    "speaker": "刻晴",
                    "text": "我明白了。随后我依次送到。"
                },
                {
                    "id": "401415609",
                    "speaker": "闲云",
                    "text": "（呼…还好本仙找到了这两全其美之策。）"
                }
            ]
        },
        {
            "talkId": "4014157",
            "initDialog": "401415701",
            "dialogues": [
                {
                    "id": "401415701",
                    "speaker": "魈",
                    "text": "#{NICKNAME}。"
                },
                {
                    "id": "401415702",
                    "speaker": "Player",
                    "text": "你果然没进城。"
                },
                {
                    "id": "401415703",
                    "speaker": "魈",
                    "text": "若你想问我是否见到海灯节的灯火与美景…你看，这座山后方便是璃月港。"
                },
                {
                    "id": "401415704",
                    "speaker": "魈",
                    "text": "登高望远，能将夜幕下缓缓升起的风筝尽数收入眼底。"
                },
                {
                    "id": "401415705",
                    "speaker": "魈",
                    "text": "…如此便好。"
                },
                {
                    "id": "401415706",
                    "speaker": "Player",
                    "text": "好吧。"
                },
                {
                    "id": "401415707",
                    "speaker": "魈",
                    "text": "早些时候邀请你来此地找我，是有一件事情想做。"
                },
                {
                    "id": "401415708",
                    "speaker": "魈",
                    "text": "…陪我放一盏霄灯吧。"
                },
                {
                    "id": "401415709",
                    "speaker": "Player",
                    "text": "是你亲手做的吗？"
                },
                {
                    "id": "401415710",
                    "speaker": "魈",
                    "text": "嗯。"
                },
                {
                    "id": "401415711",
                    "speaker": "魈",
                    "text": "技艺不精之处…莫要笑我。"
                },
                {
                    "id": "401415712",
                    "speaker": "Player",
                    "text": "怎么会？很厉害哦。"
                },
                {
                    "id": "401415713",
                    "speaker": "魈",
                    "text": "…嗯，你果然会这样说。"
                },
                {
                    "id": "401415714",
                    "speaker": "魈",
                    "text": "那我便松手了。"
                }
            ]
        },
        {
            "talkId": "4014158",
            "initDialog": "401415801",
            "dialogues": [
                {
                    "id": "401415801",
                    "speaker": "魈",
                    "text": "……"
                },
                {
                    "id": "401415802",
                    "speaker": "Player",
                    "text": "（霄灯逐渐消失在了视野尽头。四下安宁，魈的表情微微舒展。）"
                },
                {
                    "id": "401415803",
                    "speaker": "魈",
                    "text": "#{NICKNAME}。"
                },
                {
                    "id": "401415804",
                    "speaker": "魈",
                    "text": "…谢谢。"
                }
            ]
        },
        {
            "talkId": "4014161",
            "initDialog": "401416101",
            "dialogues": [
                {
                    "id": "401416101",
                    "speaker": "琳琅",
                    "text": "我是琳琅，经营叫做「希古居」的古董行…请问有事吗？"
                }
            ]
        },
        {
            "talkId": "4014162",
            "initDialog": "401416201",
            "dialogues": [
                {
                    "id": "401416201",
                    "speaker": "Player",
                    "text": "【关于风筝…】"
                },
                {
                    "id": "401416202",
                    "speaker": "琳琅",
                    "text": "风筝是寄托了人的思念、终将飞向天空的物件，你不觉得和霄灯其实很像吗？"
                },
                {
                    "id": "401416203",
                    "speaker": "琳琅",
                    "text": "今年的海灯节主题定为了风筝，和漫天闪烁的霄灯相映成趣。"
                },
                {
                    "id": "401416204",
                    "speaker": "琳琅",
                    "text": "不知道有没有什么和二者相关的传说呢…若是再能和古物联系起来，定能造就一个引人入胜的好故事吧。"
                }
            ]
        },
        {
            "talkId": "4014163",
            "initDialog": "401416301",
            "dialogues": [
                {
                    "id": "401416301",
                    "speaker": "小安",
                    "text": "这位朋友，你好，想好要做什么样的风筝了吗？"
                },
                {
                    "id": "401416302",
                    "speaker": "小安",
                    "text": "啊，抱歉，不是想要打听你的私事，只是想给我自己做个参考。"
                },
                {
                    "id": "401416303",
                    "speaker": "小安",
                    "text": "终于等到了节庆的假期，却一时间想不出自己喜欢哪种花纹了…"
                },
                {
                    "id": "401416304",
                    "speaker": "小安",
                    "text": "总不能把办事处的过期文件缝成风筝放了吧？哈哈！"
                },
                {
                    "id": "401416305",
                    "speaker": "小安",
                    "text": "开玩笑的，仔细想想也没什么，就算没有自己的风筝，看看其他人的也挺有意思。"
                }
            ]
        },
        {
            "talkId": "4014164",
            "initDialog": "401416401",
            "dialogues": [
                {
                    "id": "401416401",
                    "speaker": "畅畅",
                    "text": "爸爸什么时候回来呀…现在写信找他要一个猊兽风筝还来得及吗？"
                },
                {
                    "id": "401416402",
                    "speaker": "畅畅",
                    "text": "畅畅一个人玩的时候，在天上看到了一个好漂亮的猊兽风筝！还会发光呢！"
                },
                {
                    "id": "401416403",
                    "speaker": "畅畅",
                    "text": "唔…不知道爸爸能不能也给我买一个呢？"
                }
            ]
        },
        {
            "talkId": "4014165",
            "initDialog": "401416501",
            "dialogues": [
                {
                    "id": "401416501",
                    "speaker": "慕胜",
                    "text": "哎呀，果然还是城里更有节日的氛围。"
                },
                {
                    "id": "401416502",
                    "speaker": "慕胜",
                    "text": "话说海灯节纪念的英雄，基本都是久远以前在璃月的仙人。"
                },
                {
                    "id": "401416503",
                    "speaker": "慕胜",
                    "text": "你知道今年明霄灯纪念的是哪位仙人吗？"
                },
                {
                    "id": "401416504",
                    "speaker": "慕胜",
                    "text": "我专门去打听了下，有位看起来就很懂行的先生告诉我，仙人的名号是心猿大将弥怒。"
                },
                {
                    "id": "401416505",
                    "speaker": "慕胜",
                    "text": "听说他虽为骁勇善战的夜叉一族，但却精于服饰的设计与制作。"
                },
                {
                    "id": "401416506",
                    "speaker": "慕胜",
                    "text": "听上去是位很喜欢创新的仙人呢！那一定能保佑我们璃月人的生活日新月异吧！"
                }
            ]
        },
        {
            "talkId": "4014166",
            "initDialog": "401416601",
            "dialogues": [
                {
                    "id": "401416601",
                    "speaker": "弗拉德",
                    "text": "你觉得，那些飞上天去的风筝，会不会有一些是没办法收回来的？"
                },
                {
                    "id": "401416602",
                    "speaker": "娜蒂亚",
                    "text": "也许吧？即使能够操控风筝线，风也不会听人指挥的吧。"
                },
                {
                    "id": "401416603",
                    "speaker": "娜蒂亚",
                    "text": "说到这个，我们要不要去买个风筝？虽然我没有放过，不知道能不能成功…"
                },
                {
                    "id": "401416604",
                    "speaker": "弗拉德",
                    "text": "或者…要不要一起做一只风筝？我看小孩子们都在讨论自己要画的风筝花纹，也许并不是特别困难的事情。"
                },
                {
                    "id": "401416605",
                    "speaker": "娜蒂亚",
                    "text": "两个人一起吗…好，试试看吧！"
                }
            ]
        },
        {
            "talkId": "4014167",
            "initDialog": "401416701",
            "dialogues": [
                {
                    "id": "401416701",
                    "speaker": "伊凡诺维奇",
                    "text": "原来风筝的形状可以这样千奇百怪…"
                },
                {
                    "id": "401416702",
                    "speaker": "伊凡诺维奇",
                    "text": "啊，我说的「千奇百怪」，是称赞的意思。"
                },
                {
                    "id": "401416703",
                    "speaker": "伊凡诺维奇",
                    "text": "我们商人，最喜欢的就是新奇玩意儿了！"
                },
                {
                    "id": "401416704",
                    "speaker": "伊凡诺维奇",
                    "text": "如果能把这个模式套用到别的商品上…哦，再加上枫丹引进的机械装置，可能是个不错的新市场。"
                }
            ]
        },
        {
            "talkId": "4014168",
            "initDialog": "401416801",
            "dialogues": [
                {
                    "id": "401416801",
                    "speaker": "一然",
                    "text": "阿宽！谢谢阿宽给我买的风筝！带我放风筝吧！"
                },
                {
                    "id": "401416802",
                    "speaker": "阿宽",
                    "text": "首先，说了很多次了，要叫我爸爸。"
                },
                {
                    "id": "401416803",
                    "speaker": "阿宽",
                    "text": "而且，既然已经给你买了风筝，那怎么说也该叫我爸爸了吧。"
                },
                {
                    "id": "401416804",
                    "speaker": "一然",
                    "text": "那既然是爸爸，为什么不带我放风筝呢？"
                },
                {
                    "id": "401416805",
                    "speaker": "阿宽",
                    "text": "这个…这个，爸爸要工作的啊，从没学过放风筝呀。"
                },
                {
                    "id": "401416806",
                    "speaker": "一然",
                    "text": "哦，那阿宽去学一下嘛。"
                },
                {
                    "id": "401416807",
                    "speaker": "一然",
                    "text": "阿宽每天都叫我好好学习，那也该轮到阿宽了！"
                },
                {
                    "id": "401416808",
                    "speaker": "一然",
                    "text": "阿宽想做爸爸的话，就要以身作则！"
                }
            ]
        },
        {
            "talkId": "4014169",
            "initDialog": "401416901",
            "dialogues": [
                {
                    "id": "401416901",
                    "speaker": "阿山婆",
                    "text": "海灯节快乐，年轻人，看看这里的玩具如何？"
                }
            ]
        },
        {
            "talkId": "4014170",
            "initDialog": "401417001",
            "dialogues": [
                {
                    "id": "401417001",
                    "speaker": "Player",
                    "text": "关于风筝…"
                },
                {
                    "id": "401417002",
                    "speaker": "阿山婆",
                    "text": "啊，是来买风筝的啊。"
                },
                {
                    "id": "401417003",
                    "speaker": "阿山婆",
                    "text": "今年海灯节的风筝有了不少新的款式，好像还有能让风筝更容易飞起来的装置…"
                },
                {
                    "id": "401417004",
                    "speaker": "阿山婆",
                    "text": "老婆子我这里只有些传统的纹样，新东西就有点搞不清了，所以想购置新风筝的话，你可以去枕鸢的摊位看看。"
                },
                {
                    "id": "401417005",
                    "speaker": "阿山婆",
                    "text": "这孩子是我的外甥女，今年从沉玉谷来璃月港做生意了。年轻人充满活力，但容易粗心，还请你多关照啦。"
                }
            ]
        },
        {
            "talkId": "4014171",
            "initDialog": "401417101",
            "dialogues": [
                {
                    "id": "401417101",
                    "speaker": "嘉义",
                    "text": "千岩牢固，重嶂不移。"
                },
                {
                    "id": "401417102",
                    "speaker": "嘉义",
                    "text": "你最近放过风筝了吗？"
                },
                {
                    "id": "401417103",
                    "speaker": "嘉义",
                    "text": "我看璃月港的小孩子们啊，好多都去结伴放风筝了…"
                },
                {
                    "id": "401417104",
                    "speaker": "嘉义",
                    "text": "…也不知道站在轻策庄的山坡上，能不能看到飞得那么高的风筝…"
                },
                {
                    "id": "401417105",
                    "speaker": "嘉义",
                    "text": "唉…小六，爸爸好想你啊…"
                }
            ]
        },
        {
            "talkId": "4014172",
            "initDialog": "401417201",
            "dialogues": [
                {
                    "id": "401417201",
                    "speaker": "大坤",
                    "text": "嘿，一年一度的海灯节终于来了，这可是个大日子！"
                },
                {
                    "id": "401417202",
                    "speaker": "大坤",
                    "text": "你看，整个璃月港都热闹起来了，这样的场面可不常见啊。"
                },
                {
                    "id": "401417203",
                    "speaker": "大坤",
                    "text": "要不是不能擅自离岗，我都想买个风筝去放一放了。"
                },
                {
                    "id": "401417204",
                    "speaker": "大坤",
                    "text": "哎，听他们说，如果装了那个什么械动装置，风筝很容易就能飞起来了！"
                },
                {
                    "id": "401417205",
                    "speaker": "大坤",
                    "text": "要是这样的话，我岂不是可以一边工作一边放风筝了？"
                }
            ]
        },
        {
            "talkId": "4014173",
            "initDialog": "401417301",
            "dialogues": [
                {
                    "id": "401417301",
                    "speaker": "霖铃",
                    "text": "风筝随风飞上天，一路飞到九天边。撞上霄灯光艳艳，一看被火烧一片。"
                },
                {
                    "id": "401417302",
                    "speaker": "霖铃",
                    "text": "妙啊，妙啊…"
                }
            ]
        },
        {
            "talkId": "4014174",
            "initDialog": "401417401",
            "dialogues": [
                {
                    "id": "401417401",
                    "speaker": "安德烈",
                    "text": "您好您好，找我有事吗？"
                },
                {
                    "id": "401417402",
                    "speaker": "安德烈",
                    "text": "如果是工作的事情，恕难奉陪。毕竟现在可是难得的节日啊，吹着海风，看看风筝，真是惬意…"
                }
            ]
        },
        {
            "talkId": "4014175",
            "initDialog": "401417501",
            "dialogues": [
                {
                    "id": "401417501",
                    "speaker": "宏宇",
                    "text": "一年又一年，每年都有新气象。"
                },
                {
                    "id": "401417502",
                    "speaker": "宏宇",
                    "text": "你看，今年给风筝装上了机械装置，明年也许就要给霄灯加上指南针了。"
                },
                {
                    "id": "401417503",
                    "speaker": "宏宇",
                    "text": "这样霄灯也能像鸽子一样，帮大家送信咯。"
                },
                {
                    "id": "401417504",
                    "speaker": "宏宇",
                    "text": "觉得我是在开玩笑吗？哈哈，也许吧！"
                }
            ]
        },
        {
            "talkId": "4014176",
            "initDialog": "401417601",
            "dialogues": [
                {
                    "id": "401417601",
                    "speaker": "小昭",
                    "text": "呼…海灯节可真是辛苦，还是应该休息一下…"
                },
                {
                    "id": "401417602",
                    "speaker": "小昭",
                    "text": "但只要一停下来，就会有种莫名的焦虑感…"
                },
                {
                    "id": "401417603",
                    "speaker": "小昭",
                    "text": "毕竟玉衡星大人布置了有关跨国合作的新任务，我还不能休息…"
                }
            ]
        },
        {
            "talkId": "4014177",
            "initDialog": "401417701",
            "dialogues": [
                {
                    "id": "401417701",
                    "speaker": "永安",
                    "text": "你好，我…你…猫…阿嚏！"
                },
                {
                    "id": "401417702",
                    "speaker": "永安",
                    "text": "对不起…你知道今年的主题是风筝，偶尔会有人来码头试飞…"
                },
                {
                    "id": "401417703",
                    "speaker": "永安",
                    "text": "有时风筝没飞起来，倒是被猫儿们叼走了…"
                },
                {
                    "id": "401417704",
                    "speaker": "永安",
                    "text": "我得帮他们把丢失的风筝找回来…猫…阿、阿嚏！"
                }
            ]
        },
        {
            "talkId": "4014178",
            "initDialog": "401417801",
            "dialogues": [
                {
                    "id": "401417801",
                    "speaker": "莺儿",
                    "text": "欸~这不是我的老相识嘛，难道是海灯节专程来看我的？"
                },
                {
                    "id": "401417802",
                    "speaker": "莺儿",
                    "text": "好久不见，你看上去还是那么眉清目秀呀。"
                },
                {
                    "id": "401417803",
                    "speaker": "莺儿",
                    "text": "怎么样，要不要试试我新做的香膏？"
                },
                {
                    "id": "401417804",
                    "speaker": "莺儿",
                    "text": "在风筝上涂一点也不错哦，可以带着香气飞到很远的地方呢~。"
                },
                {
                    "id": "401417805",
                    "speaker": "莺儿",
                    "text": "而且，呵呵，如果把有香味的风筝挂在家里，应该也是不错的装饰吧。"
                },
                {
                    "id": "401417806",
                    "speaker": "莺儿",
                    "text": "所谓闻香思人，也是同样的道理吧。"
                }
            ]
        },
        {
            "talkId": "4014181",
            "initDialog": "401418101",
            "dialogues": [
                {
                    "id": "401418101",
                    "speaker": "枕鸢",
                    "text": "欢迎欢迎，小店风筝样式又新又全，请随便看看吧！"
                }
            ]
        },
        {
            "talkId": "4014182",
            "initDialog": "401418201",
            "dialogues": [
                {
                    "id": "401418201",
                    "speaker": "Player",
                    "text": "想看看风筝。"
                },
                {
                    "id": "401418202",
                    "speaker": "枕鸢",
                    "text": "来，都在这儿了，请慢慢挑选，我给您折扣价。"
                }
            ]
        },
        {
            "talkId": "4014183",
            "initDialog": "401418301",
            "dialogues": [
                {
                    "id": "401418301",
                    "speaker": "Player",
                    "text": "这里的风筝…"
                },
                {
                    "id": "401418302",
                    "speaker": "枕鸢",
                    "text": "哦，你问这些风筝是从哪儿来的吗？都是我和我的家人亲手扎的！"
                },
                {
                    "id": "401418303",
                    "speaker": "枕鸢",
                    "text": "你放心，我从小跟着舅妈阿山婆学做风筝，这一行前前后后做了有十几年，风筝品质不会有半点问题。"
                },
                {
                    "id": "401418304",
                    "speaker": "枕鸢",
                    "text": "听说今年海灯节以风筝为主题，可把我舅妈乐坏了。"
                },
                {
                    "id": "401418305",
                    "speaker": "枕鸢",
                    "text": "但她又在信里向我絮叨，说她折腾不来枫丹的新装置。我这才跑来璃月港，帮着一起做生意。"
                },
                {
                    "id": "401418306",
                    "speaker": "枕鸢",
                    "text": "扎风筝也算我们家的祖传手艺了，喜欢的话，就请多带点走哦！"
                }
            ]
        },
        {
            "talkId": "4014184",
            "initDialog": "401418401",
            "dialogues": [
                {
                    "id": "401418401",
                    "speaker": "Player",
                    "text": "扎风筝的手艺…"
                },
                {
                    "id": "401418402",
                    "speaker": "枕鸢",
                    "text": "我还没跟你详细说过舅妈阿山婆的事吧？"
                },
                {
                    "id": "401418403",
                    "speaker": "枕鸢",
                    "text": "我们家人多少都会扎点风筝。但要说手艺最好的，还得是我舅妈，她对风筝真叫一个「痴迷」。"
                },
                {
                    "id": "401418404",
                    "speaker": "枕鸢",
                    "text": "想当初她教我那些传统纹样的时候，眼里都是泛着光的。我好好地听，好好地学着，也不知道自己有朝一日能不能赶上她。"
                },
                {
                    "id": "401418405",
                    "speaker": "枕鸢",
                    "text": "呵呵…你没见她都这么大人了，扎风筝的时候嘴角总还挂着笑意呢！"
                },
                {
                    "id": "401418406",
                    "speaker": "枕鸢",
                    "text": "要是我家孩子愿意的话呀，这门手艺，我也想让我家孩子继承下去…"
                }
            ]
        },
        {
            "talkId": "4014185",
            "initDialog": "401418501",
            "dialogues": [
                {
                    "id": "401418501",
                    "speaker": "<UNKNOWN>",
                    "text": "再见。"
                },
                {
                    "id": "401418502",
                    "speaker": "枕鸢",
                    "text": "再见！玩得开心哦，祝你海灯节快乐！"
                }
            ]
        },
        {
            "talkId": "7153002",
            "initDialog": "715300201",
            "dialogues": [
                {
                    "id": "715300201",
                    "speaker": "遐庆",
                    "text": "#大名人{M#大哥}{F#大姐}，看你容光焕发，意气风发，要玩一局「碰碰舞兽戏」吗？",
                    "choices": [
                        {
                            "id": "715300202",
                            "text": "那就玩一局「碰碰舞兽戏」！",
                            "response": [
                                {
                                    "id": "715300203",
                                    "speaker": "遐庆",
                                    "text": "好哇，祝你玩得开心！"
                                }
                            ]
                        },
                        {
                            "id": "715300204",
                            "text": "关于「碰碰舞兽戏」的道具和场地…",
                            "response": [
                                {
                                    "id": "715300205",
                                    "speaker": "遐庆",
                                    "text": "还不错吧？都是我改的！"
                                },
                                {
                                    "id": "715300206",
                                    "speaker": "遐庆",
                                    "text": "我在舞兽戏的戏服里加入了几种特别的石粉，你一拉绳子，石粉混在一起，就放出许多气体，把戏服撑起来，结结实实。"
                                },
                                {
                                    "id": "715300207",
                                    "speaker": "遐庆",
                                    "text": "所以不管你们怎么碰，都不会受伤，又好玩又安全！"
                                },
                                {
                                    "id": "715300208",
                                    "speaker": "遐庆",
                                    "text": "这是早就用在船上的技术，水手们用它来保住货物，就算装货的箱子跟着波浪到处晃，里边的货也不会撞得稀巴烂。"
                                },
                                {
                                    "id": "715300209",
                                    "speaker": "遐庆",
                                    "text": "然后吧，玩「碰碰舞兽戏」的场地是我向这家店租的。那么大的地下室，平常总是空着，正好派上用场。"
                                },
                                {
                                    "id": "715300210",
                                    "speaker": "遐庆",
                                    "text": "这家店的老板人很好，我宣传舞兽戏也能帮他揽客，所以他没收我多少钱！"
                                },
                                {
                                    "id": "715300211",
                                    "speaker": "遐庆",
                                    "text": "看情况，说不准以后我还能叫上嘉明，在这里表演！"
                                }
                            ]
                        },
                        {
                            "id": "715300212",
                            "text": "节日快乐！记得休息！",
                            "response": [
                                {
                                    "id": "715300213",
                                    "speaker": "遐庆",
                                    "text": "好！你也要玩得开心，吃得痛快！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7153003",
            "initDialog": "715300301",
            "dialogues": [
                {
                    "id": "715300301",
                    "speaker": "遐庆",
                    "text": "再准备一下，把活动办好点！"
                },
                {
                    "id": "715300302",
                    "speaker": "Player",
                    "text": "（这个人似乎正忙着筹备活动，没空和别人闲聊…）"
                }
            ]
        },
        {
            "talkId": "7153103",
            "initDialog": "715310301",
            "dialogues": [
                {
                    "id": "715310301",
                    "speaker": "文寻",
                    "text": "蓬蓬松松，软软弹弹…进度还不错，快要完成啦！"
                },
                {
