            "dialogues": [
                {
                    "id": "735090201",
                    "speaker": "哈贾娜德",
                    "text": "这次的「震沸装置」可是强大的新型机，能够承受超高强度的使用，还自带记录功能…"
                },
                {
                    "id": "735090202",
                    "speaker": "哈贾娜德",
                    "text": "怎么样，你有什么感觉吗？",
                    "choices": [
                        {
                            "id": "735090203",
                            "text": "确实厉害，深有同感。",
                            "response": [
                                {
                                    "id": "735090204",
                                    "speaker": "哈贾娜德",
                                    "text": "没错吧！哈哈哈，等到你给我正式的反馈，我稍作加工，写出最终的报告，导师肯定也会看得目瞪口呆！"
                                }
                            ]
                        },
                        {
                            "id": "735090205",
                            "text": "我再试试，琢磨琢磨。",
                            "response": [
                                {
                                    "id": "735090206",
                                    "speaker": "哈贾娜德",
                                    "text": "喔喔喔，从你平静的语气里，我听出了抑制不住的热情！为了开发出最强的炼金药剂，我们都要再加把劲！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}