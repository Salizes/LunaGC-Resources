    "talks": [
        {
            "talkId": "7351104",
            "initDialog": "735110401",
            "dialogues": [
                {
                    "id": "735110401",
                    "speaker": "维纳亚克",
                    "text": "勇敢的冒险家啊，准备好去回收零件了吗？",
                    "choices": [
                        {
                            "id": "735110402",
                            "text": "准备好了。",
                            "response": [
                                {
                                    "id": "735110403",
                                    "speaker": "维纳亚克",
                                    "text": "哦哦！不愧是你，那就万事拜托了！"
                                }
                            ]
                        },
                        {
                            "id": "735110404",
                            "text": "还没有。",
                            "response": [
                                {
                                    "id": "735110405",
                                    "speaker": "维纳亚克",
                                    "text": "唔…行吧，先做好计划也有助于提高效率…不过可不能学施芮娅，光做计划不实验啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7351302",
            "initDialog": "735130201",
            "dialogues": [
                {
                    "id": "735130201",
                    "speaker": "维纳亚克",
                    "text": "勇敢的冒险家啊，你已经准备好了吗？",
                    "choices": [
                        {
                            "id": "735130202",
                            "text": "准备好了。",
                            "response": [
                                {
                                    "id": "735130203",
                                    "speaker": "维纳亚克",
                                    "text": "哦哦！那么事不宜迟，这就开始吧。"
                                }
                            ]
                        },
                        {
                            "id": "735130204",
                            "text": "还没有。",
                            "response": [
                                {
                                    "id": "735130205",
                                    "speaker": "维纳亚克",
                                    "text": "唔…行吧，先做好计划也有助于提高效率…不过可不能学某人，光做计划不实验啊。"
                                },
                                {
                                    "id": "735130206",
                                    "speaker": "施芮娅",
                                    "text": "喂！你什么意思？还嫌没辩论够吗！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7351502",
            "initDialog": "735150201",
            "dialogues": [
                {
                    "id": "735150201",
                    "speaker": "维纳亚克",
                    "text": "勇敢的冒险家啊，准备好操作「对沙虫用杀虫炮」了吗？",
                    "choices": [
                        {
                            "id": "735150202",
                            "text": "准备好了。",
                            "response": [
                                {
                                    "id": "735150203",
                                    "speaker": "维纳亚克",
                                    "text": "好嘞，沙暴就快起来了，所有人各就各位——"
                                }
                            ]
                        },
                        {
                            "id": "735150204",
                            "text": "还没有。",
                            "response": [
                                {
                                    "id": "735150205",
                                    "speaker": "维纳亚克",
                                    "text": "唔…行吧，先做好计划也有助于提高效率…不过可不能学某人，光做计划不实验啊。"
                                },
                                {
                                    "id": "735150206",
                                    "speaker": "施芮娅",
                                    "text": "喂！你什么意思？还嫌没辩论够吗！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7351702",
            "initDialog": "735170201",
            "dialogues": [
                {
                    "id": "735170201",
                    "speaker": "维纳亚克",
                    "text": "…如果施芮娅的推论准确，这估计就是「对沙虫用杀虫炮」最重要的一战了。勇敢的冒险家啊，你准备好了吗？",
                    "choices": [
                        {
                            "id": "735170202",
                            "text": "准备好了。",
                            "response": [
                                {
                                    "id": "735170203",
                                    "speaker": "维纳亚克",
                                    "text": "好，那我们这就开始吧！向全须弥证明…「对沙虫用杀虫炮」可不只是好看而已！"
                                }
                            ]
                        },
                        {
                            "id": "735170204",
                            "text": "还没有。",
                            "response": [
                                {
                                    "id": "735170205",
                                    "speaker": "维纳亚克",
                                    "text": "唔…行吧，先做好计划也有助于提高效率…"
                                },
                                {
                                    "id": "735170206",
                                    "speaker": "施芮娅",
                                    "text": "——哦？这次态度变好了不少嘛？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7351902",
            "initDialog": "735190201",
            "dialogues": [
                {
                    "id": "735190201",
                    "speaker": "维纳亚克",
                    "text": "…话说回来，这附近还有一些受影响的沙虫，你要是有空就帮忙解决一下吧。",
                    "choices": [
                        {
                            "id": "735190202",
                            "text": "正有此意。",
                            "response": [
                                {
                                    "id": "735190203",
                                    "speaker": "维纳亚克",
                                    "text": "好嘞！——要想体验「对沙虫用杀虫炮」的全功率输出，现在就是最好的机会啦！"
                                }
                            ]
                        },
                        {
                            "id": "735190204",
                            "text": "下次再说。",
                            "response": [
                                {
                                    "id": "735190205",
                                    "speaker": "维纳亚克",
                                    "text": "也行，等你有空的时候，随时跟我说就好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7351903",
            "initDialog": "735190301",
            "dialogues": [
                {
                    "id": "735190301",
                    "speaker": "施芮娅",
                    "text": "那个笨蛋…！怎么会有这种人！来咖啡馆真就只想写报告？",
                    "choices": [
                        {
                            "id": "735190302",
                            "text": "你怎么一个人在这？",
                            "response": [
                                {
                                    "id": "735190304",
                                    "speaker": "施芮娅",
                                    "text": "——别再提那个满脑子机械齿轮的笨蛋了！我真是在沙漠里热晕了脑袋才会相信他开窍了！"
                                },
                                {
                                    "id": "735190305",
                                    "speaker": "施芮娅",
                                    "text": "之前我们约在咖啡馆里见面，我花了半天时间来收拾打理，还特意换了身新衣服…"
                                },
                                {
                                    "id": "735190306",
                                    "speaker": "施芮娅",
                                    "text": "——结果他看见我的第一句话，居然是「材料跟纸笔带了没？」"
                                },
                                {
                                    "id": "735190307",
                                    "speaker": "施芮娅",
                                    "text": "啊啊…就让他跟他的宝贝机械过一辈子去吧！"
                                }
                            ]
                        },
                        {
                            "id": "735190303",
                            "text": "维纳亚克上哪去了？"
                        }
                    ]
                }
            ]
        }
    ]
}