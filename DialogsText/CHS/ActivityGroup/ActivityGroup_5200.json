{
    "groupId": "5200",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Player": 9,
        "拜希麦·五世": 26,
        "派蒙": 9
    },
    "talks": [
        {
            "talkId": "7451302",
            "initDialog": "745130201",
            "dialogues": [
                {
                    "id": "745130201",
                    "speaker": "拜希麦·五世",
                    "text": "嗯哼哼~怎么样？你们玩过「哐哐当当雀雀球」了吗？团雀最可爱，我没说错吧！",
                    "choices": [
                        {
                            "id": "745130202",
                            "text": "来玩一局「雀雀球」！",
                            "response": [
                                {
                                    "id": "745130203",
                                    "speaker": "拜希麦·五世",
                                    "text": "嘿呀，看来这可可爱爱的团雀游戏正中你的心窝了！请随意游玩，玩到你心满意足！"
                                }
                            ]
                        },
                        {
                            "id": "745130204",
                            "text": "团雀一直很可爱！",
                            "response": [
                                {
                                    "id": "745130205",
                                    "speaker": "派蒙",
                                    "text": "嗯！我也想起来了，好像以前在什么地方玩到过这种桌上游戏！"
                                },
                                {
                                    "id": "745130206",
                                    "speaker": "派蒙",
                                    "text": "因为玩过这个桌上游戏，我还在现实中观察过一段时间的团雀呢，然后从团雀身上发现了很多…容易被疏忽的小特点。"
                                },
                                {
                                    "id": "745130207",
                                    "speaker": "派蒙",
                                    "text": "#拜希麦…五世小姐？说不定继续玩这个游戏，我和{NICKNAME}也能重温以前旅行时的记忆！"
                                },
                                {
                                    "id": "745130208",
                                    "speaker": "拜希麦·五世",
                                    "text": "以前玩过吗？那说明你们和我的家族很有缘！"
                                },
                                {
                                    "id": "745130209",
                                    "speaker": "拜希麦·五世",
                                    "text": "「哐哐当当雀雀球」是我们家从太外祖母那里继承下来的传统游戏，之前一直被当成招待贵客的家庭仪式。"
                                },
                                {
                                    "id": "745130210",
                                    "speaker": "拜希麦·五世",
                                    "text": "除了招待贵客，太外祖母似乎只和学术对手，以及她最认可的朋友们一起游玩过雀雀球，并送过她们几份样品…"
                                },
                                {
                                    "id": "745130211",
                                    "speaker": "拜希麦·五世",
                                    "text": "太外祖母说过，「要是大家都被团雀的可爱充盈了心灵，躁动不安的情绪就会减少，世界上的争吵就会少一点…」"
                                },
                                {
                                    "id": "745130212",
                                    "speaker": "拜希麦·五世",
                                    "text": "为了太外祖母的和平愿景，也为了让可爱的团雀给大家带去笑容，我要继续改进这个游戏，好好推广它！",
                                    "choices": [
                                        {
                                            "id": "745130213",
                                            "text": "具体要怎么做呢？",
                                            "response": [
                                                {
                                                    "id": "745130214",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "我已经想好了！如你所见，我正在枫丹人流量最大的港口打响「哐哐当当雀雀球」的名气！"
                                                },
                                                {
                                                    "id": "745130215",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "团雀的可爱名声会随着巡轨船和货船四处流传，等到时机成熟，我就会大量免费派送游戏，让大家随时都能玩到雀雀球！"
                                                },
                                                {
                                                    "id": "745130219",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "看来我们的想法非常一致，你们两位要不也加入「团雀和平大使」的队伍？"
                                                },
                                                {
                                                    "id": "745130220",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "要是方便的话，请带上几份游戏的本体，或者是宣传画，在之后的旅行过程中向其他人推荐「哐哐当当雀雀球」…"
                                                },
                                                {
                                                    "id": "745130221",
                                                    "speaker": "派蒙",
                                                    "text": "这样一来，就能向更多人喊出那句话了——"
                                                },
                                                {
                                                    "id": "745130222",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "「团雀最可爱！」"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745130216",
                                            "text": "好耶！可爱就是和平！",
                                            "response": [
                                                {
                                                    "id": "745130217",
                                                    "speaker": "派蒙",
                                                    "text": "现在我觉得这句话完全不夸张了，这段时间的旅行以来，接触到的养宠物的人都很有耐心，和他们讲道理也非常顺利！"
                                                },
                                                {
                                                    "id": "745130218",
                                                    "speaker": "派蒙",
                                                    "text": "所以拜希麦五世小姐和你的…太外祖母，说得非常有道理！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745130223",
                            "text": "为什么你叫「五世」来着？",
                            "response": [
                                {
                                    "id": "745130224",
                                    "speaker": "派蒙",
                                    "text": "对哦，听起来像是很厉害的大贵族后裔…须弥有这样的家族吗？"
                                },
                                {
                                    "id": "745130225",
                                    "speaker": "拜希麦·五世",
                                    "text": "哈哈哈，没有那么夸张啦！我的这个名字只是一个称号。"
                                },
                                {
                                    "id": "745130226",
                                    "speaker": "拜希麦·五世",
                                    "text": "一切都起源于我的太外祖母，她刚正不阿，得罪了很多学术对手，被恶意派遣到沙漠中去调查不存在的生物，直接失踪了…"
                                },
                                {
                                    "id": "745130227",
                                    "speaker": "拜希麦·五世",
                                    "text": "结果在所有人都以为她死掉的十几年后，她突然带着调查报告和「哐哐当当雀雀球」回来了。"
                                },
                                {
                                    "id": "745130228",
                                    "speaker": "拜希麦·五世",
                                    "text": "她不仅完成了当年的任务，还性情大变，像是参悟了什么道理。"
                                },
                                {
                                    "id": "745130229",
                                    "speaker": "拜希麦·五世",
                                    "text": "遇见和她争论的同行，她再也不会生气，而是邀请对方一起来玩雀雀球，边玩边讨论。"
                                },
                                {
                                    "id": "745130230",
                                    "speaker": "拜希麦·五世",
                                    "text": "在和谐的讨论氛围中，大部分问题都迎刃而解，甚至许多和太外祖母针锋相对的人都变成了她的好朋友兼雀雀球爱好者…"
                                },
                                {
                                    "id": "745130231",
                                    "speaker": "派蒙",
                                    "text": "雀雀球居然真的有这种功效吗！"
                                },
                                {
                                    "id": "745130232",
                                    "speaker": "Player",
                                    "text": "超出预期的发展…"
                                },
                                {
                                    "id": "745130233",
                                    "speaker": "拜希麦·五世",
                                    "text": "很神奇吧！所以我才坚信太外祖母的说法，可爱的团雀能让世界和平！"
                                },
                                {
                                    "id": "745130234",
                                    "speaker": "拜希麦·五世",
                                    "text": "出于对太外祖母的尊敬，她的朋友为我的家族成员们起了便于辨认的称号，我是那之后的第五代当家，所以就是五世了！"
                                },
                                {
                                    "id": "745130235",
                                    "speaker": "拜希麦·五世",
                                    "text": "据说一些太外祖母本人的朋友非常长寿，取走雀雀球研究时，还说，希望能看到拜希麦十世，甚至二十世的活跃…"
                                },
                                {
                                    "id": "745130236",
                                    "speaker": "拜希麦·五世",
                                    "text": "最后让「坐下来玩一局雀雀球」成为全提瓦特流行的一种习俗，解决万千争端！"
                                },
                                {
                                    "id": "745130237",
                                    "speaker": "派蒙",
                                    "text": "这么看来，拜希麦五世小姐的理想还真不是空话呢，我们也可以来帮忙！",
                                    "choices": [
                                        {
                                            "id": "745130238",
                                            "text": "多玩雀雀球少吵架。",
                                            "response": [
                                                {
                                                    "id": "745130240",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "说得很精髓，我用力鼓掌！"
                                                },
                                                {
                                                    "id": "745130241",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "你这简洁有力的话蕴含着最珍贵的道理，我就把它写在雀雀球包装的背面吧。"
                                                },
                                                {
                                                    "id": "745130242",
                                                    "speaker": "拜希麦·五世",
                                                    "text": "总之，我们一起努力吧，让更多人开开心心前进，把烦人的争吵变成和谐的讨论！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "745130239",
                                            "text": "多讲讲道理少生气。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "745130243",
                            "text": "下次再来聊可爱！",
                            "response": [
                                {
                                    "id": "745130244",
                                    "speaker": "拜希麦·五世",
                                    "text": "好哦！看在我们如此合拍的份上，记得多多回来找我，多多赏玩雀雀球哦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}