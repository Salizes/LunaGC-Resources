{
    "groupId": "5278",
    "total_dialogue_lines": 149,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 29,
        "丰克": 10,
        "可慎": 7,
        "埃德勒": 50,
        "多达马尼": 2,
        "派蒙": 20,
        "热情的乘客": 1,
        "科德": 7,
        "船员": 3,
        "萝克珊": 8,
        "诈狂": 4,
        "轩瞩": 3,
        "阿林": 4
    },
    "talks": [
        {
            "talkId": "4020003",
            "initDialog": "402000301",
            "dialogues": [
                {
                    "id": "402000301",
                    "speaker": "埃德勒",
                    "text": "#啊，是{NICKNAME}准领队！听夜兰小姐说，您也加入这次行动了…"
                },
                {
                    "id": "402000302",
                    "speaker": "埃德勒",
                    "text": "那一切稳得不能再稳了，「黑钱领主」和他最后的几个部下都该洗好脖子，乖乖等死！",
                    "choices": [
                        {
                            "id": "402000303",
                            "text": "你回来了？好快！",
                            "response": [
                                {
                                    "id": "402000304",
                                    "speaker": "埃德勒",
                                    "text": "毕竟只是帮夜兰小姐引开那帮家伙的注意力嘛，任务不重，时间要求其实挺宽松的。"
                                },
                                {
                                    "id": "402000305",
                                    "speaker": "埃德勒",
                                    "text": "科德和多达马尼那俩厮，跟得很紧，见我和沃特蒙泰涅坐下吃甜点，好几个小时没动弹，就假装是观光买茶的游客。"
                                },
                                {
                                    "id": "402000306",
                                    "speaker": "埃德勒",
                                    "text": "我提前和沃特蒙泰涅打好了招呼，让她告诉附近的店家，给那些坏人狠狠加价，店家就随手多写了两个零。"
                                },
                                {
                                    "id": "402000307",
                                    "speaker": "埃德勒",
                                    "text": "结果那两家伙，为了不显得自己可疑，还真掏钱买了，给我和沃特蒙泰涅乐开了花！"
                                },
                                {
                                    "id": "402000308",
                                    "speaker": "埃德勒",
                                    "text": "给翘英庄的乡亲们增加一点营收，也算是给他们赔个不是。毕竟，引着犯人到处逛，到了他们庄里，多少有点晦气。"
                                },
                                {
                                    "id": "402000309",
                                    "speaker": "埃德勒",
                                    "text": "那就用钱财补偿尽可能除掉这股晦气好了。",
                                    "choices": [
                                        {
                                            "id": "402000310",
                                            "text": "感觉你说话的方式很璃月。",
                                            "response": [
                                                {
                                                    "id": "402000312",
                                                    "speaker": "埃德勒",
                                                    "text": "啊哈，那说明我做的功课还算到位，天赋也还不错。"
                                                },
                                                {
                                                    "id": "402000313",
                                                    "speaker": "埃德勒",
                                                    "text": "四年级做同桌的时候，沃特蒙泰涅就说过，我学老师说话的腔调可像了！这天赋倒是给我的工作带来了不少好处…"
                                                },
                                                {
                                                    "id": "402000314",
                                                    "speaker": "埃德勒",
                                                    "text": "「干探员这行的，理应走到哪，就融入当地的氛围。和孩子们说话就可爱点，和璃月友人说话就文雅礼貌，或者接地气…」"
                                                },
                                                {
                                                    "id": "402000315",
                                                    "speaker": "埃德勒",
                                                    "text": "「和罪犯们聊天，就该粗暴用词不离口，骂脏点。」"
                                                },
                                                {
                                                    "id": "402000316",
                                                    "speaker": "埃德勒",
                                                    "text": "格罗里夏尔队长的原话如是说。"
                                                },
                                                {
                                                    "id": "402000317",
                                                    "speaker": "埃德勒",
                                                    "text": "话说回来，我还没听过他骂人呢。这次押送犯人回去以后，说不定就有机会见识队长最有攻击性，最狂野的粗口了。"
                                                },
                                                {
                                                    "id": "402000318",
                                                    "speaker": "埃德勒",
                                                    "text": "真期待啊！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402000311",
                                            "text": "你的用词有股亲切感…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402000319",
                            "text": "不要说这种反派一样的话…",
                            "response": [
                                {
                                    "id": "402000320",
                                    "speaker": "埃德勒",
                                    "text": "没事没事，我在孩子们面前会学着童话书里的口吻讲故事，不会教坏他们的。在正式执行公务的时候，也会注意语气！"
                                },
                                {
                                    "id": "402000321",
                                    "speaker": "埃德勒",
                                    "text": "对付穷凶极恶的罪犯，必须在狠劲上压倒他们，这样才不会被他们的气焰压制。"
                                },
                                {
                                    "id": "402000322",
                                    "speaker": "埃德勒",
                                    "text": "我不介意成为罪犯们口中的「刽子手」、「断头台」。不过，这么威风的称呼，还是留给您这种大人物比较好。"
                                },
                                {
                                    "id": "402000323",
                                    "speaker": "埃德勒",
                                    "text": "您也来试着恶狠狠地说话吧！",
                                    "choices": [
                                        {
                                            "id": "402000324",
                                            "text": "那…我以后多凶凶坏人？",
                                            "response": [
                                                {
                                                    "id": "402000325",
                                                    "speaker": "埃德勒",
                                                    "text": "好呀好呀，多凶多凶！"
                                                },
                                                {
                                                    "id": "402000326",
                                                    "speaker": "埃德勒",
                                                    "text": "以你的实力和威望，对着恶棍随便凶一下，他们都会吓到丢魂吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402000327",
                                            "text": "我要讲礼貌，不可以教坏派蒙。",
                                            "response": [
                                                {
                                                    "id": "402000328",
                                                    "speaker": "埃德勒",
                                                    "text": "哎，说得也对。我的同事都说，你的那位伙伴派蒙啊，乖巧机灵又可爱，确实不能给伙伴造成不好的影响。"
                                                },
                                                {
                                                    "id": "402000329",
                                                    "speaker": "埃德勒",
                                                    "text": "所以…你可以偷偷凶人！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402000330",
                            "text": "最后几个部下？",
                            "response": [
                                {
                                    "id": "402000331",
                                    "speaker": "埃德勒",
                                    "text": "是的，毕竟这次的行动已经进行了好几个月，夜兰小姐出手又利落干脆，效率高得让我无比羡慕。"
                                },
                                {
                                    "id": "402000332",
                                    "speaker": "埃德勒",
                                    "text": "现在，「黑钱领主」身边只剩他最关键的心腹了，行动能力大大受限，被我们逮住也只是时间问题…"
                                },
                                {
                                    "id": "402000333",
                                    "speaker": "埃德勒",
                                    "text": "难道说，您觉得抓到的犯人太少，成就感不够吗？",
                                    "choices": [
                                        {
                                            "id": "402000334",
                                            "text": "没事，不求最多但求最重要。",
                                            "response": [
                                                {
                                                    "id": "402000335",
                                                    "speaker": "埃德勒",
                                                    "text": "既然如此，下次，如果您还有协助探案的意愿，我就专挑困难的案情留给您，让您尽情享受打败狡诈罪犯的过程！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402000336",
                                            "text": "确实，多多抓犯人非常重要。",
                                            "response": [
                                                {
                                                    "id": "402000337",
                                                    "speaker": "埃德勒",
                                                    "text": "实在抱歉，下次，如果您还有协助探案的意愿，我就早点想办法邀请您，让您尽情多抓犯罪团伙的成员，也抓个乌泱泱一片！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402000338",
                            "text": "其实还想了解对方的情况。",
                            "response": [
                                {
                                    "id": "402000339",
                                    "speaker": "埃德勒",
                                    "text": "你是说，「黑钱领主」团队的情报吗？主要想听哪方面的内容呢？请尽管问，我都可以回答！",
                                    "choices": [
                                        {
                                            "id": "402000340",
                                            "text": "关于「摩拉除痕」的细节…",
                                            "response": [
                                                {
                                                    "id": "402000341",
                                                    "speaker": "埃德勒",
                                                    "text": "嗯，夜兰小姐应该给你说过基本的逻辑了——通过买下虚假估值的拍卖品，经过多重交易，把脏的钱变干净。"
                                                },
                                                {
                                                    "id": "402000342",
                                                    "speaker": "埃德勒",
                                                    "text": "除了利用拍卖会保护供货者和交易者个人隐私的法律漏洞，在执行环节，他们还玩了不少花样。"
                                                },
                                                {
                                                    "id": "402000343",
                                                    "speaker": "埃德勒",
                                                    "text": "比如，他用来买下国外收藏品的摩拉，本身就经过了重重转手，甚至以物易物再换回摩拉，以此来逃脱监管。"
                                                },
                                                {
                                                    "id": "402000344",
                                                    "speaker": "埃德勒",
                                                    "text": "在外地买东西时，他们也会通过让部下变装、花钱委托别人帮忙等方式，使得交易记录几乎完全不可被追查。"
                                                },
                                                {
                                                    "id": "402000345",
                                                    "speaker": "埃德勒",
                                                    "text": "这些收藏品在参加拍卖会前都属于普通货物，运往枫丹的过程中，执法单位很难定位它们，就算找到了也很难把它们怎么样。"
                                                },
                                                {
                                                    "id": "402000346",
                                                    "speaker": "埃德勒",
                                                    "text": "是不是听起来很无赖，很让人恼火？",
                                                    "choices": [
                                                        {
                                                            "id": "402000347",
                                                            "text": "谢谢，已经咬牙切齿了。",
                                                            "response": [
                                                                {
                                                                    "id": "402000349",
                                                                    "speaker": "埃德勒",
                                                                    "text": "其实「黑钱领主」还有别的洗钱渠道呢！包括但不限于虚假的慈善基金、投资映影项目、空壳商会…"
                                                                },
                                                                {
                                                                    "id": "402000350",
                                                                    "speaker": "埃德勒",
                                                                    "text": "那家伙本身就吞并了这种勾当的所有同行，所以花招多得不得了。"
                                                                },
                                                                {
                                                                    "id": "402000351",
                                                                    "speaker": "埃德勒",
                                                                    "text": "好在，现在正义的一方夺得了上风。"
                                                                },
                                                                {
                                                                    "id": "402000352",
                                                                    "speaker": "埃德勒",
                                                                    "text": "在枫丹本土，得益于刺玫会的有力协助，我们已经把上述花招中的大部分拆开掰碎，切作细末了。"
                                                                },
                                                                {
                                                                    "id": "402000353",
                                                                    "speaker": "埃德勒",
                                                                    "text": "至于这种拍卖品洗钱的方式，现在也被我们控制得七七八八，只留最后的几个开口，以便我们追查主谋。"
                                                                },
                                                                {
                                                                    "id": "402000354",
                                                                    "speaker": "埃德勒",
                                                                    "text": "有您来协助，打出一锤定音的关键重击，彻底干掉「黑钱领主」，完全只是时间问题了！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "402000348",
                                                            "text": "一般，只是想多给他们几拳。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402000355",
                                            "text": "罪犯们会怎么样？",
                                            "response": [
                                                {
                                                    "id": "402000356",
                                                    "speaker": "埃德勒",
                                                    "text": "好问题。"
                                                },
                                                {
                                                    "id": "402000357",
                                                    "speaker": "埃德勒",
                                                    "text": "此事涉及璃月和枫丹两国，除去「黑钱领主」自身四个层级的部下外，有大量不知情的人员被卷入其中。"
                                                },
                                                {
                                                    "id": "402000358",
                                                    "speaker": "埃德勒",
                                                    "text": "经过双方商议，目前采取的方案是，先由璃月一方将全数境内罪犯管控，审讯，录下口供，作为案件记录的主体。"
                                                },
                                                {
                                                    "id": "402000359",
                                                    "speaker": "埃德勒",
                                                    "text": "随后由枫丹方将其中的枫丹人引渡回国，查处所有与其相关的财产，并进一步杜绝相关罪犯漏网的可能。"
                                                },
                                                {
                                                    "id": "402000360",
                                                    "speaker": "埃德勒",
                                                    "text": "等到主犯黑钱领主落网，双方会再次进行商议，共同组建团体，对所有罪犯进行正式审理。"
                                                },
                                                {
                                                    "id": "402000361",
                                                    "speaker": "埃德勒",
                                                    "text": "据我的判断，只是帮忙买点东西的、不知情的本地人，应该只会被要求上缴从犯罪团伙手中获得的钱财，然后接受批评教育…"
                                                },
                                                {
                                                    "id": "402000362",
                                                    "speaker": "埃德勒",
                                                    "text": "团伙中第三级的罪犯开始，面临的牢狱之灾就该十年起步了。"
                                                },
                                                {
                                                    "id": "402000363",
                                                    "speaker": "埃德勒",
                                                    "text": "至于「黑钱领主」，他必须牢底坐穿！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402000364",
                            "text": "一起加油破案吧！",
                            "response": [
                                {
                                    "id": "402000365",
                                    "speaker": "埃德勒",
                                    "text": "好！期待您的发挥！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4020004",
            "initDialog": "402000401",
            "dialogues": [
                {
                    "id": "402000401",
                    "speaker": "萝克珊",
                    "text": "坏家伙都在这里了吗，林上校？"
                },
                {
                    "id": "402000402",
                    "speaker": "阿林",
                    "text": "没错，这里是最后一批完成审讯，录完口供的罪犯，之前的五批已经押送到船上了。"
                },
                {
                    "id": "402000403",
                    "speaker": "萝克珊",
                    "text": "数量还挺多的…这些枫丹的败类，就由我们好好教训，不会再放他们出来丢人现眼了。"
                },
                {
                    "id": "402000404",
                    "speaker": "萝克珊",
                    "text": "真是辛苦你了，林上校！"
                },
                {
                    "id": "402000405",
                    "speaker": "萝克珊",
                    "text": "等你来枫丹，我一定请你到特巡队餐厅的美露莘用餐区吃一顿，那边的黄油汐藻，口味一绝，最适合犒劳勤恳干活的我们！"
                },
                {
                    "id": "402000406",
                    "speaker": "阿林",
                    "text": "实在感谢，不过，在下职务在身，可见的十年内，都不会离开沉玉谷。希望再远的将来能有机会吧。"
                },
                {
                    "id": "402000407",
                    "speaker": "萝克珊",
                    "text": "十年吗？那好像也不算太久…"
                },
                {
                    "id": "402000408",
                    "speaker": "阿林",
                    "text": "另外，其实在下的职衔是教头。千岩军的军衔和职务体系，与执律庭，以及前枫丹海军，都有很大的区别。"
                },
                {
                    "id": "402000409",
                    "speaker": "萝克珊",
                    "text": "我懂我懂，千岩军很谦逊很节俭，军衔搞得也不复杂，光给纳税人省钱…"
                },
                {
                    "id": "402000410",
                    "speaker": "萝克珊",
                    "text": "我只是看你的工作职责和上校差不多，就这么叫了而已。你觉得不合适，那我就不这么叫你了，改口直呼你林教头！"
                },
                {
                    "id": "402000411",
                    "speaker": "萝克珊",
                    "text": "要是以后能组建联合部队就好了，和你们合作的感觉非常棒，刷刷两下就干完了活…一起剿灭大批魔物，肯定也是种享受！"
                },
                {
                    "id": "402000412",
                    "speaker": "阿林",
                    "text": "相信你与战友好好磨合后，一定也能达成这种效果。"
                }
            ]
        },
        {
            "talkId": "4020005",
            "initDialog": "402000501",
            "dialogues": [
                {
                    "id": "402000501",
                    "speaker": "科德",
                    "text": "警官，参与拍卖会的货品，还需要细致处理，能否先将货品运送至约定的地点…"
                },
                {
                    "id": "402000502",
                    "speaker": "丰克",
                    "text": "抱歉，科德先生，根据「执律庭」的情报，您与您的宝贵收藏品大概率受到了罪犯的重点关注。"
                },
                {
                    "id": "402000503",
                    "speaker": "丰克",
                    "text": "在拍卖会开始前，您与您的收藏品都必须处于「执律庭」的保护之下。否则，没人知道事态将如何发展。"
                },
                {
                    "id": "402000504",
                    "speaker": "科德",
                    "text": "但…拍卖会还有许多事务…"
                },
                {
                    "id": "402000505",
                    "speaker": "丰克",
                    "text": "请别再让我重复「必须」一词的含义，先生。"
                },
                {
                    "id": "402000506",
                    "speaker": "科德",
                    "text": "啧…好吧…"
                },
                {
                    "id": "402000507",
                    "speaker": "多达马尼",
                    "text": "我，我就先回船上去了，祝你好运，科德…"
                },
                {
                    "id": "402000508",
                    "speaker": "丰克",
                    "text": "多达马尼先生也请稍等片刻，对船舶的安全检查还需一段时间，接下来你便可自行返回须弥。"
                },
                {
                    "id": "402000509",
                    "speaker": "多达马尼",
                    "text": "好，好的…"
                }
            ]
        },
        {
            "talkId": "4020006",
            "initDialog": "402000601",
            "dialogues": [
                {
                    "id": "402000601",
                    "speaker": "热情的乘客",
                    "text": "刚才船上是不是出什么事了？怎么执律庭的警官们围过来了…"
                },
                {
                    "id": "402000602",
                    "speaker": "船员",
                    "text": "#啊…哈哈…应该没什么问题吧？我好像有看见，超厉害的冒险家{NICKNAME}都有露过脸…"
                },
                {
                    "id": "402000603",
                    "speaker": "船员",
                    "text": "不管有什么问题，船长都会摆平的吧…"
                },
                {
                    "id": "402000604",
                    "speaker": "船员",
                    "text": "我只是个听吩咐办事的…应该不会连累我吧…"
                }
            ]
        },
        {
            "talkId": "4020007",
            "initDialog": "402000701",
            "dialogues": [
                {
                    "id": "402000701",
                    "speaker": "可慎",
                    "text": "不是都说你很能打吗，盗宝团的高手「诈狂」？"
                },
                {
                    "id": "402000702",
                    "speaker": "可慎",
                    "text": "这十多年来，你的恶名可没少传到我们耳朵里。要不是你一直在外潜逃，我们早就想来会会你了。"
                },
                {
                    "id": "402000703",
                    "speaker": "可慎",
                    "text": "哦，还有你的主顾「黑钱领主」，情报显示，他和一位强者罗基·艾威尔森师出同门，怎么，找的你这个部下，身手还不如他？"
                },
                {
                    "id": "402000704",
                    "speaker": "可慎",
                    "text": "再来两个回合吧，这次单手让你。然后，就该押你回去了。"
                },
                {
                    "id": "402000705",
                    "speaker": "诈狂",
                    "text": "嘁…打不动也逃不动了，你一脚把我的小腿踢断了。"
                },
                {
                    "id": "402000706",
                    "speaker": "诈狂",
                    "text": "我是真没想到，你们明明被我引到了雷场里，居然还能毫发无伤地追过来…"
                },
                {
                    "id": "402000707",
                    "speaker": "诈狂",
                    "text": "尤其是你这家伙，结结实实吃了我两颗爆雷，居然只是…破了点皮？枫丹的发条机关都接不住…"
                },
                {
                    "id": "402000708",
                    "speaker": "可慎",
                    "text": "论布雷，你还欠了点火候。在轩瞩的俯瞰机关和金属感测器面前，你的那点陷阱，也就骗骗和你一样脏的贼匪了。"
                },
                {
                    "id": "402000709",
                    "speaker": "可慎",
                    "text": "炸药的劲头也不足，还不如玄文兽一爪来得劲道。"
                },
                {
                    "id": "402000717",
                    "speaker": "诈狂",
                    "text": "早知如此，就不该为了「黑钱领主」那点钱，冒险回到璃月来了…"
                },
                {
                    "id": "402000710",
                    "speaker": "可慎",
                    "text": "到大牢里后悔去吧。还有，别忘了给那一船乘客下跪认错。"
                },
                {
                    "id": "402000711",
                    "speaker": "轩瞩",
                    "text": "#啊，是{NICKNAME}！没想到你在协助破案之余还有空四处维持秩序…"
                },
                {
                    "id": "402000712",
                    "speaker": "轩瞩",
                    "text": "逮捕重犯的工作已经完成了，这边就不劳你出手了！",
                    "choices": [
                        {
                            "id": "402000713",
                            "text": "辛苦了！",
                            "response": [
                                {
                                    "id": "402000715",
                                    "speaker": "轩瞩",
                                    "text": "职责所在！"
                                },
                                {
                                    "id": "402000716",
                                    "speaker": "Black Screen",
                                    "text": "「诈狂」终于被恐惧和懊悔击垮，再也不敢吱声了…"
                                }
                            ]
                        },
                        {
                            "id": "402000714",
                            "text": "记得好好教训这个恶人！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4020008",
            "initDialog": "402000801",
            "dialogues": [
                {
                    "id": "402000801",
                    "speaker": "丰克",
                    "text": "怎么，腿在发抖啊？"
                },
                {
                    "id": "402000802",
                    "speaker": "丰克",
                    "text": "干那些肮脏活，赚黑钱赚到手软的时候，也没见你发抖啊，"
                },
                {
                    "id": "402000803",
                    "speaker": "丰克",
                    "text": "是因为那时你完全没想过自己洗白赃款的背后，有多少受害者，而现在不得不面对他们，不得不面对全体公民的怒火了?"
                },
                {
                    "id": "402000804",
                    "speaker": "丰克",
                    "text": "到头来，还是个性格老掉牙的懦夫啊…"
                },
                {
                    "id": "402000805",
                    "speaker": "科德",
                    "text": "……"
                },
                {
                    "id": "402000806",
                    "speaker": "科德",
                    "text": "我会好好面对审判的。"
                },
                {
                    "id": "402000807",
                    "speaker": "Player",
                    "text": "我会在观众席上朝你扔西红柿的。"
                },
                {
                    "id": "402000808",
                    "speaker": "科德",
                    "text": "你！"
                },
                {
                    "id": "402000809",
                    "speaker": "Player",
                    "text": "还是说，你想要臭鸡蛋？"
                },
                {
                    "id": "402000810",
                    "speaker": "科德",
                    "text": "栽在你们手上，可能正是我命该绝吧。"
                },
                {
                    "id": "402000811",
                    "speaker": "丰克",
                    "text": "哈哈！请帮我多扔一颗！"
                },
                {
                    "id": "402000812",
                    "speaker": "丰克",
                    "text": "哦，还有借我一身便服的哥们，「康思戈的前左手」。他有事不能来看这场审判，就请帮他朝科德扔一颗…发霉的苹果吧。"
                }
            ]
        },
        {
            "talkId": "4020009",
            "initDialog": "402000901",
            "dialogues": [
                {
                    "id": "402000901",
                    "speaker": "派蒙",
                    "text": "#嘿嘿，{NICKNAME}，我回来啦！"
                },
                {
                    "id": "402000902",
                    "speaker": "派蒙",
                    "text": "我跟着埃德勒警官，好好审讯了那些坏人…感觉，学到了不少新本领！",
                    "choices": [
                        {
                            "id": "402000903",
                            "text": "玩得开心吗？",
                            "response": [
                                {
                                    "id": "402000904",
                                    "speaker": "派蒙",
                                    "text": "嗯！让坏家伙们说出自己作案的动机，然后后悔认错的感觉，像是给不好的事情划上了一个句号，挺有意思的！"
                                },
                                {
                                    "id": "402000905",
                                    "speaker": "派蒙",
                                    "text": "你和夜兰呢？夜兰好好享受了假期嘛？",
                                    "choices": [
                                        {
                                            "id": "402000906",
                                            "text": "我们也玩得很尽兴。",
                                            "response": [
                                                {
                                                    "id": "402000908",
                                                    "speaker": "派蒙",
                                                    "text": "以前还没有什么概念，现在仔细一想，夜兰还真是个大忙人啊！"
                                                },
                                                {
                                                    "id": "402000909",
                                                    "speaker": "派蒙",
                                                    "text": "能把这——么——多的坏家伙揪出来，抓起来，还表现得悠悠哉哉，不怎么累…"
                                                },
                                                {
                                                    "id": "402000910",
                                                    "speaker": "派蒙",
                                                    "text": "唔…下次见面的时候，我也问问看好了，能不能和她学学安排时间，保持活力的秘诀好了。",
                                                    "choices": [
                                                        {
                                                            "id": "402000911",
                                                            "text": "最近你好上进欸！",
                                                            "response": [
                                                                {
                                                                    "id": "402000913",
                                                                    "speaker": "派蒙",
                                                                    "text": "欸嘿嘿，只是想多多帮你的忙而已啦！"
                                                                },
                                                                {
                                                                    "id": "402000914",
                                                                    "speaker": "派蒙",
                                                                    "text": "你一直在变强，我也要努力一点才行嘛！"
                                                                },
                                                                {
                                                                    "id": "402000930",
                                                                    "speaker": "派蒙",
                                                                    "text": "好啦，是时候开始下一次冒险了，我们继续出发吧！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "402000912",
                                                            "text": "好学派蒙！夸夸！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402000907",
                                            "text": "约好在挪德卡莱再见。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "402000915",
                            "text": "有用力凶坏人吗？",
                            "response": [
                                {
                                    "id": "402000916",
                                    "speaker": "派蒙",
                                    "text": "有，有吧？"
                                },
                                {
                                    "id": "402000917",
                                    "speaker": "派蒙",
                                    "text": "我的额头有点酸，一定是扮凶脸太久，眼睛瞪太大了！"
                                },
                                {
                                    "id": "402000918",
                                    "speaker": "派蒙",
                                    "text": "#那些家伙一发现，我是{NICKNAME}最好最好的伙伴，全都吓得不轻，叽里咕噜老实交代了。",
                                    "choices": [
                                        {
                                            "id": "402000919",
                                            "text": "那我以后也凶一点…",
                                            "response": [
                                                {
                                                    "id": "402000922",
                                                    "speaker": "派蒙",
                                                    "text": "唔…想象了一下，好像想象不出来…"
                                                },
                                                {
                                                    "id": "402000923",
                                                    "speaker": "派蒙",
                                                    "text": "#毕竟{NICKNAME}一直很温和嘛，最凶最凶的时候都不吓人，和我说话的时候都慢悠悠的~"
                                                },
                                                {
                                                    "id": "402000924",
                                                    "speaker": "派蒙",
                                                    "text": "面对一般的坏家伙，你也不可能真的特别特别生气，到动真格发火…大凶特凶的程度吧？"
                                                },
                                                {
                                                    "id": "402000925",
                                                    "speaker": "派蒙",
                                                    "text": "我们也算是见识过大风大浪了，心胸开阔，不和一般坏蛋们一般见识！"
                                                },
                                                {
                                                    "id": "402000926",
                                                    "speaker": "Player",
                                                    "text": "也对，不和一般坏家伙计较！"
                                                },
                                                {
                                                    "id": "402000927",
                                                    "speaker": "派蒙",
                                                    "text": "有了这次的经验，接下来的冒险，我们肯定会更得心应手啦！"
                                                },
                                                {
                                                    "id": "402000928",
                                                    "speaker": "派蒙",
                                                    "text": "#希望不管遇见什么情况，{NICKNAME}都要从从容容，不慌不忙…"
                                                },
                                                {
                                                    "id": "402000929",
                                                    "speaker": "派蒙",
                                                    "text": "这样，我也能安安心心，我们都能在打败坏家伙后开开心心！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "402000920",
                                            "text": "变成超绝恐怖大王…"
                                        },
                                        {
                                            "id": "402000921",
                                            "text": "岂不是坏人直接吓跑了…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}