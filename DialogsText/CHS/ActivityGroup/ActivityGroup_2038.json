    "talks": [
        {
            "talkId": "4017761",
            "initDialog": "401776101",
            "dialogues": [
                {
                    "id": "401776101",
                    "speaker": "米莱",
                    "text": "……"
                },
                {
                    "id": "401776102",
                    "speaker": "尼娅",
                    "text": "米莱…你一定要早点好起来呀。我还有很多话想对你说呢。"
                }
            ]
        },
        {
            "talkId": "4017762",
            "initDialog": "401776201",
            "dialogues": [
                {
                    "id": "401776201",
                    "speaker": "米莱",
                    "text": "……"
                },
                {
                    "id": "401776202",
                    "speaker": "尼娅",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "4017862",
            "initDialog": "401786201",
            "dialogues": [
                {
                    "id": "401786201",
                    "speaker": "米莱",
                    "text": "尼娅…安杜…等我好起来，我们再一起出去玩吧。"
                },
                {
                    "id": "401786202",
                    "speaker": "尼娅",
                    "text": "你一定要快点好起来呀！"
                },
                {
                    "id": "401786203",
                    "speaker": "安杜",
                    "text": "米莱…别担心，我已经找到办法了。"
                }
            ]
        },
        {
            "talkId": "4017863",
            "initDialog": "401786301",
            "dialogues": [
                {
                    "id": "401786301",
                    "speaker": "米莱",
                    "text": "……"
                },
                {
                    "id": "401786302",
                    "speaker": "尼娅",
                    "text": "……"
                },
                {
                    "id": "401786303",
                    "speaker": "安杜",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "4017981",
            "initDialog": "401798101",
            "dialogues": [
                {
                    "id": "401798101",
                    "speaker": "玛拉妮",
                    "text": "好…这个手套带上，这个滑板也带上。"
                },
                {
                    "id": "401798102",
                    "speaker": "玛拉妮",
                    "text": "今天的幸运色…应该是粉蓝色来着？可惜，现在不能去找茜特菈莉问问…"
                },
                {
                    "id": "401798103",
                    "speaker": "玛拉妮",
                    "text": "对了，还要写个告示牌放在店里…"
                },
                {
                    "id": "401798104",
                    "speaker": "玛拉妮",
                    "text": "「店主暂时不在，需要的东西直接取走就好，钱放在旁边的袋子里…」"
                },
                {
                    "id": "401798105",
                    "speaker": "玛拉妮",
                    "text": "「如果暂时没钱的话，也直接取走就好…」"
                },
                {
                    "id": "401798106",
                    "speaker": "玛拉妮",
                    "text": "「大家玩得开心！」"
                },
                {
                    "id": "401798107",
                    "speaker": "玛拉妮",
                    "text": "唔，写成「玩」好像不太合适…？"
                },
                {
                    "id": "401798108",
                    "speaker": "玛拉妮",
                    "text": "「大家热热闹闹，一起开心吧！」"
                },
                {
                    "id": "401798109",
                    "speaker": "玛拉妮",
                    "text": "改成这样就好了，嗯，我也该出发啦！"
                }
            ]
        },
        {
            "talkId": "4017982",
            "initDialog": "401798201",
            "dialogues": [
                {
                    "id": "401798201",
                    "speaker": "伊法",
                    "text": "听话哥们，不要害怕，只是一点小伤。"
                },
                {
                    "id": "401798202",
                    "speaker": "伊法",
                    "text": "别担心，这不是真正的战争，只是演习而已，你的伙伴很安全。"
                },
                {
                    "id": "401798203",
                    "speaker": "伊法",
                    "text": "等你恢复好，就可以继续投入战斗了，现在就好好休息吧。"
                },
                {
                    "id": "401798204",
                    "speaker": "伊法",
                    "text": "稍后我会让你的伙伴来陪你，不要乱动，不然会影响伤口痊愈。"
                },
                {
                    "id": "401798205",
                    "speaker": "伊法",
                    "text": "乖孩子，先睡一会吧。"
                }
            ]
        },
        {
            "talkId": "4017983",
            "initDialog": "401798301",
            "dialogues": [
                {
                    "id": "401798301",
                    "speaker": "瓦雷莎",
                    "text": "痛痛痛…木屑飘进眼睛里了。伊安珊老师，帮帮…"
                },
                {
                    "id": "401798302",
                    "speaker": "伊安珊",
                    "text": "你把眼睛睁开，我帮你吹吹。"
                },
                {
                    "id": "401798303",
                    "speaker": "瓦雷莎",
                    "text": "呜…痛得睁不开，眼泪也流个不停…"
                },
                {
                    "id": "401798304",
                    "speaker": "伊安珊",
                    "text": "所以我让你至少戴个护目镜…"
                },
                {
                    "id": "401798305",
                    "speaker": "伊安珊",
                    "text": "先躺好，我去找点水帮你冲洗一下。"
                }
            ]
        },
        {
            "talkId": "4017984",
            "initDialog": "401798401",
            "dialogues": [
                {
                    "id": "401798401",
                    "speaker": "夏洛蒂",
                    "text": "「纳塔战火再起，六部族谁能争先…」"
                },
                {
                    "id": "401798402",
                    "speaker": "夏洛蒂",
                    "text": "只要把这部长篇报道写完，下周下下周的头条肯定全都是我的了。"
                },
                {
                    "id": "401798403",
                    "speaker": "夏洛蒂",
                    "text": "不枉我从枫丹千辛万苦地跑过来…虽然只带了一台留影机，但也足够了。"
                },
                {
                    "id": "401798404",
                    "speaker": "夏洛蒂",
                    "text": "还要再去采访几位选手…对了，听说火神会在那个竞技场里现身…"
                },
                {
                    "id": "401798405",
                    "speaker": "夏洛蒂",
                    "text": "要是能拍到她的画面，那就赚大了！"
                },
                {
                    "id": "401798406",
                    "speaker": "夏洛蒂",
                    "text": "嘿嘿，嘿嘿嘿，嘿嘿嘿嘿…"
                }
            ]
        },
        {
            "talkId": "4017985",
            "initDialog": "401798501",
            "dialogues": [
                {
                    "id": "401798501",
                    "speaker": "瓦雷莎",
                    "text": "要不要吃点东西？这是我刚从果园里摘的。"
                },
                {
                    "id": "401798502",
                    "speaker": "尼娅",
                    "text": "呜呜…"
                },
                {
                    "id": "401798503",
                    "speaker": "伊安珊",
                    "text": "吃一点吧。照顾病号的你也很辛苦，不要因为担心累垮了身体。"
                },
                {
                    "id": "401798504",
                    "speaker": "尼娅",
                    "text": "呜！"
                },
                {
                    "id": "401798505",
                    "speaker": "瓦雷莎",
                    "text": "不够的话，我这里还有哦。"
                }
            ]
        },
        {
            "talkId": "7566451",
            "initDialog": "756645101",
            "dialogues": [
                {
                    "id": "756645101",
                    "speaker": "巴罗",
                    "text": "荣花演武正在如火如荼地举办，两位想加入哪个部族呢？",
                    "choices": [
                        {
                            "id": "756645102",
                            "text": "报名参赛。"
                        },
                        {
                            "id": "756645103",
                            "text": "询问规则。",
                            "response": [
                                {
                                    "id": "756645104",
                                    "speaker": "巴罗",
                                    "text": "需要我再帮你们介绍一下规则吗？没问题。"
                                },
                                {
                                    "id": "756645105",
                                    "speaker": "巴罗",
                                    "text": "荣花演武会分成「进攻战」和「守备战」。"
                                },
                                {
                                    "id": "756645106",
                                    "speaker": "巴罗",
                                    "text": "守备战很好理解，就是阻止对手进攻部族；进攻战要复杂一些，它是假定部族已经失守，现在要吹响反攻的号角。"
                                },
                                {
                                    "id": "756645107",
                                    "speaker": "巴罗",
                                    "text": "为了让比赛更有趣味性，我们制作了特殊的仪式道具。进攻方需要为它积蓄能量，破坏掉对方的特殊结界。"
                                },
                                {
                                    "id": "756645108",
                                    "speaker": "巴罗",
                                    "text": "还有，即使是比赛，我们也不想见到纯粹的暴力与冲突。打坏的东西要重新修好，另外遇到魔物也请及时清剿。"
                                }
                            ]
                        },
                        {
                            "id": "756645109",
                            "text": "闲聊。",
                            "response": [
                                {
                                    "id": "756645110",
                                    "speaker": "巴罗",
                                    "text": "呼…这次参加比赛的人真不少，两位应该也遇到熟人了吧？"
                                },
                                {
                                    "id": "756645111",
                                    "speaker": "巴罗",
                                    "text": "我的朋友也去了比赛现场。等眼前的工作告一段落，我也要去现场为他加油。"
                                },
                                {
                                    "id": "756645112",
                                    "speaker": "巴罗",
                                    "text": "哈哈，希望大家都能在比赛中发挥出全部实力！打个痛快，闹个尽兴！"
                                }
                            ]
                        },
                        {
                            "id": "756645114",
                            "text": "离开。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7566551",
            "initDialog": "756655101",
            "dialogues": [
                {
                    "id": "756655101",
                    "speaker": "薇内什",
                    "text": "欢迎来到「龙龙远征队补给站」，我们正在为参加远征的小龙提供指导，要一起来吗？",
                    "choices": [
                        {
                            "id": "756655102",
                            "text": "指导小龙。"
                        },
                        {
                            "id": "756655103",
                            "text": "闲聊。",
                            "response": [
                                {
                                    "id": "756655104",
                                    "speaker": "薇内什",
                                    "text": "我和哥哥正在伊法前辈的诊所实习哦，虽然实习的时间还很短，但每天都很充实。"
                                },
                                {
                                    "id": "756655105",
                                    "speaker": "薇内什",
                                    "text": "伊法前辈和咔库库前辈都很厉害，是我和哥哥的榜样。我们也希望成为受龙欢迎的好医生。"
                                },
                                {
                                    "id": "756655106",
                                    "speaker": "薇内什",
                                    "text": "我尤其喜欢咔库库前辈，嘿嘿。不过最近经常看到它和另外一只奇怪的黄色小龙吵架，让我有点担心。"
                                },
                                {
                                    "id": "756655107",
                                    "speaker": "薇内什",
                                    "text": "那只小龙还自称什么「伟大圣龙」。千万不要把咔库库前辈带坏呀…"
                                }
                            ]
                        },
                        {
                            "id": "756655108",
                            "text": "离开。"
                        }
                    ]
                }
            ]
        }
    ]
}