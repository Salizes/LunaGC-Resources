        "狗三儿": 8
    },
    "talks": [
        {
            "talkId": "7166608",
            "initDialog": "716660801",
            "dialogues": [
                {
                    "id": "716660801",
                    "speaker": "Player",
                    "text": "我就不能是打工的人吗？"
                },
                {
                    "id": "716660802",
                    "speaker": "狗三儿",
                    "text": "什么？来接差事的工人？那你有点不走运…"
                },
                {
                    "id": "716660803",
                    "speaker": "狗三儿",
                    "text": "能在这间仓库接到的工作，除了看门和货物的保养，主要就是搬货了。"
                },
                {
                    "id": "716660804",
                    "speaker": "狗三儿",
                    "text": "在码头和仓库之间来回搬货可不轻松，一般来说，白天搬货的单子都给了常年在码头正式工作的弟兄们。"
                },
                {
                    "id": "716660805",
                    "speaker": "狗三儿",
                    "text": "只有夜晚的差事才会分给有空打零工的人，要是处理不完，再留给其他弟兄。"
                },
                {
                    "id": "716660806",
                    "speaker": "狗三儿",
                    "text": "但最近来了个又高又壮，脑袋上戴着红色尖角的大兄弟，干活特别勤快。"
                },
                {
                    "id": "716660807",
                    "speaker": "狗三儿",
                    "text": "那个大兄弟好像根本不会累，一人干了差不多三个人的活，每晚只做三小时的差事，就能赚到不少摩拉。"
                },
                {
                    "id": "716660808",
                    "speaker": "狗三儿",
                    "text": "他倒也挺通情达理，和我们好好解释了一番，说是最近急着用钱，只会这样干几天，不会长期抢别人的单子。"
                },
                {
                    "id": "716660809",
                    "speaker": "狗三儿",
                    "text": "所以你最近深夜来做工，也接不到什么活了。"
                }
            ]
        },
        {
            "talkId": "7166622",
            "initDialog": "716662201",
            "dialogues": [
                {
                    "id": "716662201",
                    "speaker": "「且听下次复盘」",
                    "text": "朋友，你也要参加荒泷帮主的「甲光烈烈斗虫大修行」？",
                    "choices": [
                        {
                            "id": "716662202",
                            "text": "来场斗虫吧！",
                            "response": [
                                {
                                    "id": "716662203",
                                    "speaker": "「且听下次复盘」",
                                    "text": "如此甚好！之前的较量那叫一个精彩，我正打算仔细复盘！就劳烦你顺着荒泷帮主的思路再和我斗上一局了！"
                                }
                            ]
                        },
                        {
                            "id": "716662204",
                            "text": "关于斗虫的门道…",
                            "response": [
                                {
                                    "id": "716662205",
                                    "speaker": "「且听下次复盘」",
                                    "text": "不错，这个话题，可以仔细扯掰扯掰！"
                                },
                                {
                                    "id": "716662206",
                                    "speaker": "「且听下次复盘」",
                                    "text": "璃月也有不少斗虫的游戏，相比这鬼兜虫，各有重点和特色。"
                                },
                                {
                                    "id": "716662207",
                                    "speaker": "「且听下次复盘」",
                                    "text": "比如争一个灵巧，或是谁的虫叫声更高昂。"
                                },
                                {
                                    "id": "716662208",
                                    "speaker": "「且听下次复盘」",
                                    "text": "每种斗虫都暗藏玄机，稍稍添上几笔墨，改编成故事，指定能给各位老主顾好好说上几回！"
                                }
                            ]
                        },
                        {
                            "id": "716662209",
                            "text": "告辞！",
                            "response": [
                                {
                                    "id": "716662210",
                                    "speaker": "「且听下次复盘」",
                                    "text": "那就下回再见了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7166632",
            "initDialog": "716663201",
            "dialogues": [
                {
                    "id": "716663201",
                    "speaker": "「恐怖猫爪草」",
                    "text": "你们还要和畅畅玩游戏吗？",
                    "choices": [
                        {
                            "id": "716663202",
                            "text": "那就开打吧！",
                            "response": [
                                {
                                    "id": "716663203",
                                    "speaker": "「恐怖猫爪草」",
                                    "text": "好哦！我要和你好好学一学，那个…白什么小什么瓜的打法！"
                                }
                            ]
                        },
                        {
                            "id": "716663204",
                            "text": "关于你的称号…",
                            "response": [
                                {
                                    "id": "716663205",
                                    "speaker": "「恐怖猫爪草」",
                                    "text": "啊？你是说「恐怖猫爪草」吗？"
                                },
                                {
                                    "id": "716663206",
                                    "speaker": "「恐怖猫爪草」",
                                    "text": "只是因为爸爸以前给畅畅带回来过一种盆栽，每天晚上，畅畅把它放在窗边，结果第二天一早，它就跑到屋顶上去了。"
                                },
                                {
                                    "id": "716663207",
                                    "speaker": "「恐怖猫爪草」",
                                    "text": "有人说，半夜看见过畅畅的盆栽，就像猫猫一样爬上了墙…"
                                },
                                {
                                    "id": "716663208",
                                    "speaker": "「恐怖猫爪草」",
                                    "text": "后来才知道，原来，城里有只猫猫很喜欢那种盆栽，把它叼走了。"
                                },
                                {
                                    "id": "716663209",
                                    "speaker": "「恐怖猫爪草」",
                                    "text": "不知为什么，这件事传到别人嘴里，就变成了「畅畅把盆栽养成了猫」。"
                                },
                                {
                                    "id": "716663210",
                                    "speaker": "「恐怖猫爪草」",
                                    "text": "畅畅倒是无所谓，不过那个…「花椒鱼酱」…听说了这件事，觉得畅畅的外号很威风，还找畅畅来玩这个游戏…"
                                },
                                {
                                    "id": "716663211",
                                    "speaker": "「恐怖猫爪草」",
                                    "text": "畅畅玩得开心，还想继续玩！"
                                }
                            ]
                        },
                        {
                            "id": "716663212",
                            "text": "再见！",
                            "response": [
                                {
                                    "id": "716663213",
                                    "speaker": "「恐怖猫爪草」",
                                    "text": "嗯，那就再见了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7166642",
            "initDialog": "716664201",
            "dialogues": [
                {
                    "id": "716664201",
                    "speaker": "「装备碾压型选手」",
                    "text": "#啊呀，{NICKNAME}，还想再和我玩一局斗虫吗？",
                    "choices": [
                        {
                            "id": "716664202",
                            "text": "开玩开玩！",
                            "response": [
                                {
                                    "id": "716664203",
                                    "speaker": "「装备碾压型选手」",
                                    "text": "嘿！说不定这次，我能找到新的诀窍，打你个措手不及哦！"
                                }
                            ]
                        },
                        {
                            "id": "716664204",
                            "text": "烟绯最近忙吗？",
                            "response": [
                                {
                                    "id": "716664205",
                                    "speaker": "「装备碾压型选手」",
                                    "text": "没事没事，我还好啦！"
                                },
                                {
                                    "id": "716664206",
                                    "speaker": "「装备碾压型选手」",
                                    "text": "就算是律法专家，也不是每天都要帮人处理诉讼的嘛。"
                                },
                                {
                                    "id": "716664207",
                                    "speaker": "「装备碾压型选手」",
                                    "text": "正好，趁着师妹和师弟们聚会的空档，我直接把年假全都用掉！"
                                },
                                {
                                    "id": "716664208",
                                    "speaker": "「装备碾压型选手」",
                                    "text": "吃个爽快，睡个痛快，玩得开心，才能以最饱满的精神回到之后的工作中去。"
                                },
                                {
                                    "id": "716664209",
                                    "speaker": "「装备碾压型选手」",
                                    "text": "这样才算是快乐生活！"
                                }
                            ]
                        },
                        {
                            "id": "716664210",
                            "text": "回见了，烟绯！",
                            "response": [
                                {
                                    "id": "716664211",
                                    "speaker": "「装备碾压型选手」",
                                    "text": "好呀，有空的时候，可以再来教我玩玩这个游戏哦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7166652",
            "initDialog": "716665201",
            "dialogues": [
                {
                    "id": "716665201",
                    "speaker": "「花里胡哨不如一刀」",
                    "text": "是你啊，要再和我切磋一局吗？",
                    "choices": [
                        {
                            "id": "716665202",
                            "text": "那就来斗虫吧！",
                            "response": [
                                {
                                    "id": "716665203",
                                    "speaker": "「花里胡哨不如一刀」",
                                    "text": "很好，请赐教。"
                                }
                            ]
                        },
                        {
                            "id": "716665204",
                            "text": "会长居然也喜欢斗虫？",
                            "response": [
                                {
                                    "id": "716665205",
                                    "speaker": "「花里胡哨不如一刀」",
                                    "text": "谈不上喜欢，只是觉得许多活动都有值得学习的内容，试试看总不亏。"
                                },
                                {
                                    "id": "716665206",
                                    "speaker": "「花里胡哨不如一刀」",
                                    "text": "通常而言，各种高难度的委托里，也会有许多战斗以外的需求。"
                                },
                                {
                                    "id": "716665207",
                                    "speaker": "「花里胡哨不如一刀」",
                                    "text": "比如解开机关的谜题，或是遵循线索寻找特定的物品…"
                                },
                                {
                                    "id": "716665208",
                                    "speaker": "「花里胡哨不如一刀」",
                                    "text": "说不定哪天，就会碰见需要指挥其他生物达成某种目标的委托。"
                                },
                                {
                                    "id": "716665209",
                                    "speaker": "「花里胡哨不如一刀」",
                                    "text": "凭你的实力和见闻，应该深有体会吧？"
                                }
                            ]
                        },
                        {
                            "id": "716665210",
                            "text": "先不打扰了…",
                            "response": [
                                {
                                    "id": "716665211",
                                    "speaker": "「花里胡哨不如一刀」",
                                    "text": "嗯，去吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7166661",
            "initDialog": "716666101",
            "dialogues": [
                {
                    "id": "716666101",
                    "speaker": "「超级强者的随行厨神」",
                    "text": "#哟，{NICKNAME}！要再和锅巴玩一局吗？锅巴似乎还想再试试「花羽叶月神机」的本领！"
                },
                {
                    "id": "716666102",
                    "speaker": "「天崩石裂超级强者」",
                    "text": "♪~",
                    "choices": [
                        {
                            "id": "716666103",
                            "text": "那我就扮一回一斗！",
                            "response": [
                                {
                                    "id": "716666104",
                                    "speaker": "「超级强者的随行厨神」",
                                    "text": "好耶！再来一次斗虫大较量！"
                                },
                                {
                                    "id": "716666105",
                                    "speaker": "「天崩石裂超级强者」",
                                    "text": "♪！"
                                }
                            ]
                        },
                        {
                            "id": "716666106",
                            "text": "「万民堂」重新开业的准备如何了？",
                            "response": [
                                {
                                    "id": "716666107",
                                    "speaker": "「超级强者的随行厨神」",
                                    "text": "店里已经不那么忙啦，所以我和锅巴才能一直在这里玩斗虫，谢谢关心！"
                                },
                                {
                                    "id": "716666108",
                                    "speaker": "「超级强者的随行厨神」",
                                    "text": "食材都补充得差不多了，再过几天应该就能照常营业！"
                                },
                                {
                                    "id": "716666109",
                                    "speaker": "「超级强者的随行厨神」",
                                    "text": "如果你和派蒙还没吃够，那欢迎随时再来！"
                                },
                                {
                                    "id": "716666110",
                                    "speaker": "「天崩石裂超级强者」",
                                    "text": "♪~"
                                }
                            ]
                        },
                        {
                            "id": "716666111",
                            "text": "先走了，下次再来！",
                            "response": [
                                {
                                    "id": "716666112",
                                    "speaker": "「超级强者的随行厨神」",
                                    "text": "没问题，下回再见咯！"
                                },
                                {
                                    "id": "716666113",
                                    "speaker": "「天崩石裂超级强者」",
                                    "text": "♪！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7166671",
            "initDialog": "716667101",
            "dialogues": [
                {
                    "id": "716667101",
                    "speaker": "「花角玉将」",
                    "text": "「鬼王的左膀右臂」殿下，有什么我能帮你们的事吗？",
                    "choices": [
                        {
                            "id": "716667102",
                            "text": "给我也整一只鬼兜虫！",
                            "response": [
                                {
                                    "id": "716667103",
                                    "speaker": "「花角玉将」",
                                    "text": "好！完全不在话下！"
                                },
                                {
                                    "id": "716667104",
                                    "speaker": "「花角玉将」",
                                    "text": "不过，斗虫强者和鬼兜虫之间的相性，还需要很长的时间来观察…"
                                },
                                {
                                    "id": "716667105",
                                    "speaker": "「花角玉将」",
                                    "text": "凭借之前和您斗虫的经历，我大概能推测出最符合您斗虫风格的鬼兜虫。当然，对我而言也是一个重大的考验。"
                                },
                                {
                                    "id": "716667106",
                                    "speaker": "「花角玉将」",
                                    "text": "我得好好想想了，要去什么样的地点，才能抓到那种鬼兜虫…"
                                },
                                {
                                    "id": "716667107",
                                    "speaker": "「花角玉将」",
                                    "text": "就要麻烦您耐心等待了，希望下次见面时，我能给你一份完美的答卷！"
                                }
                            ]
                        },
                        {
                            "id": "716667108",
                            "text": "关于送礼的事…",
                            "response": [
                                {
                                    "id": "716667109",
                                    "speaker": "「花角玉将」",
                                    "text": "啊呀，你是说我们要给那位大师的礼物吗？"
                                },
                                {
                                    "id": "716667110",
                                    "speaker": "「花角玉将」",
                                    "text": "说实话，我一时还没有很好的点子…"
                                },
                                {
                                    "id": "716667111",
                                    "speaker": "「花角玉将」",
                                    "text": "那位大师能制作出无比精妙的「花羽叶月神机」，或许，买些精密的机械加工设备，好好包装在礼盒中，能让那位大师满意…"
                                },
                                {
                                    "id": "716667112",
                                    "speaker": "「花角玉将」",
                                    "text": "不过我手里只剩两百万摩拉了，怕是很难买到最顶尖的装置，入不了那位大师的法眼。"
                                },
                                {
                                    "id": "716667113",
                                    "speaker": "「花角玉将」",
                                    "text": "而且我也不知道要在璃月待多久，自己吃住也要花费摩拉，得想想办法扩充行动资金了…",
                                    "choices": [
                                        {
                                            "id": "716667114",
                                            "text": "两百万好像也不少吧…",
                                            "response": [
                                                {
                                                    "id": "716667116",
                                                    "speaker": "「花角玉将」",
                                                    "text": "小部分是我平常节省伙食费攒下来的，大部分是我祖父给我的。"
                                                },
                                                {
                                                    "id": "716667117",
                                                    "speaker": "「花角玉将」",
                                                    "text": "我的祖父以前是很厉害的冒险家，每次带着他的鬼兜虫出远门，都会被好运眷顾，找到一大笔财宝。"
                                                },
                                                {
                                                    "id": "716667118",
                                                    "speaker": "「花角玉将」",
                                                    "text": "所以他非常支持我的斗虫事业，每隔一段时间，都会给我一笔存款，我也没有乱花，总有一天要把这笔钱花在最重要的地方！"
                                                },
                                                {
                                                    "id": "716667119",
                                                    "speaker": "「花角玉将」",
                                                    "text": "之前，我看荒泷派的经济情况实在不好，提出要支援鬼王一笔资金，鬼王每次都拒绝了，还说…"
                                                },
                                                {
                                                    "id": "716667120",
                                                    "speaker": "「花角玉将」",
                                                    "text": "「哪有让盟友出钱的道理！本大爷和荒泷派可是有骨气的！」"
                                                },
                                                {
                                                    "id": "716667121",
                                                    "speaker": "「花角玉将」",
                                                    "text": "我尊重鬼王的气节，所以，买到了送给那位大师的礼物后，我也会向鬼王报销的…不管需要几百万摩拉！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716667115",
                                            "text": "这些钱都是你自己的？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716667122",
                            "text": "回见了，玉将！",
                            "response": [
                                {
                                    "id": "716667123",
                                    "speaker": "「花角玉将」",
                                    "text": "好啊，您先忙，「鬼王的左膀右臂」殿下！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7166672",
            "initDialog": "716667201",
            "dialogues": [
                {
                    "id": "716667201",
                    "speaker": "「花角玉将」",
                    "text": "「鬼王的左膀右臂」殿下，要和我来一场斗虫推演吗？",
                    "choices": [
                        {
                            "id": "716667202",
                            "text": "挑战「热身关卡」！"
                        },
                        {
                            "id": "716667203",
                            "text": "挑战「关卡一」！"
                        },
                        {
                            "id": "716667204",
                            "text": "挑战「关卡二」！"
                        },
                        {
                            "id": "716667205",
                            "text": "挑战「关卡三」！"
                        },
                        {
                            "id": "716667206",
                            "text": "挑战「关卡四」！"
