{
    "groupId": "2001",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "乔伊斯": 1,
        "云江": 1,
        "华清": 1,
        "哈特曼": 1,
        "大黄": 1,
        "天成": 1,
        "查看病患": 1,
        "经纶": 1,
        "老蔡": 1,
        "艾德娜": 1,
        "苏醒的病患": 4,
        "阿德勒": 1,
        "阿阳": 1,
        "高老六": 1
    },
    "talks": [
        {
            "talkId": "4111510",
            "initDialog": "411151001",
            "dialogues": [
                {
                    "id": "411151001",
                    "speaker": "乔伊斯",
                    "text": "请务必注意安全，不要用手直接触碰陨石。"
                }
            ]
        },
        {
            "talkId": "4111511",
            "initDialog": "411151101",
            "dialogues": [
                {
                    "id": "411151101",
                    "speaker": "阿德勒",
                    "text": "注意距离，闲杂人等不要靠近陨石落点。"
                }
            ]
        },
        {
            "talkId": "4111512",
            "initDialog": "411151201",
            "dialogues": [
                {
                    "id": "411151201",
                    "speaker": "哈特曼",
                    "text": "谢谢你们，我得赶紧回酒庄报个平安！"
                }
            ]
        },
        {
            "talkId": "4111513",
            "initDialog": "411151301",
            "dialogues": [
                {
                    "id": "411151301",
                    "speaker": "苏醒的病患",
                    "text": "哎？我睡着了吗？睡了多久？"
                }
            ]
        },
        {
            "talkId": "4111514",
            "initDialog": "411151401",
            "dialogues": [
                {
                    "id": "411151401",
                    "speaker": "艾德娜",
                    "text": "愿风神护佑你不受陨石的影响。"
                }
            ]
        },
        {
            "talkId": "4111515",
            "initDialog": "411151501",
            "dialogues": [
                {
                    "id": "411151501",
                    "speaker": "云江",
                    "text": "附近巡查的工作就交给我，而对于处理陨石…听说你们才是专业的吧？"
                }
            ]
        },
        {
            "talkId": "4111516",
            "initDialog": "411151601",
            "dialogues": [
                {
                    "id": "411151601",
                    "speaker": "天成",
                    "text": "陨石的事情发生以来，一直在忙前忙后…唔，昏睡过去的人是不是也挺幸福的呢？"
                }
            ]
        },
        {
            "talkId": "4111517",
            "initDialog": "411151701",
            "dialogues": [
                {
                    "id": "411151701",
                    "speaker": "老蔡",
                    "text": "千岩牢固，重嶂不移。如果有发现新的异常情况的话，还请务必告知我一声。"
                }
            ]
        },
        {
            "talkId": "4111518",
            "initDialog": "411151801",
            "dialogues": [
                {
                    "id": "411151801",
                    "speaker": "苏醒的病患",
                    "text": "呼啊…哎？干嘛盯着我看？"
                }
            ]
        },
        {
            "talkId": "4111519",
            "initDialog": "411151901",
            "dialogues": [
                {
                    "id": "411151901",
                    "speaker": "苏醒的病患",
                    "text": "醒了能回家吗？我想回家…"
                }
            ]
        },
        {
            "talkId": "4111520",
            "initDialog": "411152001",
            "dialogues": [
                {
                    "id": "411152001",
                    "speaker": "苏醒的病患",
                    "text": "听说是你们清理了陨石？真厉害呀，年纪轻轻就有一身好本事！"
                }
            ]
        },
        {
            "talkId": "4111521",
            "initDialog": "411152101",
            "dialogues": [
                {
                    "id": "411152101",
                    "speaker": "经纶",
                    "text": "嗨，陨石这种事，我还是第一次见！"
                }
            ]
        },
        {
            "talkId": "4111522",
            "initDialog": "411152201",
            "dialogues": [
                {
                    "id": "411152201",
                    "speaker": "华清",
                    "text": "什么人！…噢，原来是专程来帮忙的冒险家，抱歉。感谢你们能来。"
                }
            ]
        },
        {
            "talkId": "4111523",
            "initDialog": "411152301",
            "dialogues": [
                {
                    "id": "411152301",
                    "speaker": "大黄",
                    "text": "站岗太久，肚子有点饿了呢…"
                }
            ]
        },
        {
            "talkId": "4111524",
            "initDialog": "411152401",
            "dialogues": [
                {
                    "id": "411152401",
                    "speaker": "阿阳",
                    "text": "我发现，要是一直盯着睡着的人看，自己也会越来越困…不不，我可没在偷懒！"
                }
            ]
        },
        {
            "talkId": "4111525",
            "initDialog": "411152501",
            "dialogues": [
                {
                    "id": "411152501",
                    "speaker": "高老六",
                    "text": "一觉睡醒吃碗热乎的，美滋滋！"
                }
            ]
        },
        {
            "talkId": "4111526",
            "initDialog": "411152601",
            "dialogues": [
                {
                    "id": "411152601",
                    "speaker": "查看病患",
                    "text": "眼前的病患似乎还处于昏睡状态。"
                }
            ]
        }
    ]
}