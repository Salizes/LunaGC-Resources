{
    "groupId": "2043",
    "total_dialogue_lines": 185,
    "speaker_counts": {
        "Player": 26,
        "卡维": 10,
        "哈贾娜德": 12,
        "坎蒂丝": 13,
        "塔拉内": 4,
        "塔玛拉": 1,
        "妮露": 3,
        "安柏": 17,
        "提纳里": 8,
        "柯莱": 12,
        "沙瓦玛": 5,
        "珐露珊": 21,
        "纳西妲": 5,
        "艾尔海森": 7,
        "莱依拉": 3,
        "观察莱依拉": 1,
        "赛索斯": 6,
        "赛诺": 8,
        "迪希雅": 23
    },
    "talks": [
        {
            "talkId": "4021014",
            "initDialog": "402101401",
            "dialogues": [
                {
                    "id": "402101401",
                    "speaker": "赛诺",
                    "text": "#看来经过长期的积累与磨砺，{NICKNAME}的笑话水平日益精进。"
                },
                {
                    "id": "402101402",
                    "speaker": "提纳里",
                    "text": "开心吗。"
                },
                {
                    "id": "402101403",
                    "speaker": "赛诺",
                    "text": "嗯，就像打开了心结一般。"
                },
                {
                    "id": "402101404",
                    "speaker": "提纳里",
                    "text": "…说起来柯莱去给教令院帮忙了呢，不知道是否顺利，你过去看看吧。"
                },
                {
                    "id": "402101405",
                    "speaker": "赛诺",
                    "text": "啊？不是说好留我吃饭的吗？"
                }
            ]
        },
        {
            "talkId": "4021015",
            "initDialog": "402101501",
            "dialogues": [
                {
                    "id": "402101501",
                    "speaker": "观察莱依拉",
                    "text": "（莱依拉看起来睡得很香。）"
                },
                {
                    "id": "402101502",
                    "speaker": "塔玛拉",
                    "text": "欸？这位小姐…？"
                }
            ]
        },
        {
            "talkId": "4021016",
            "initDialog": "402101601",
            "dialogues": [
                {
                    "id": "402101601",
                    "speaker": "卡维",
                    "text": "买这个吧？看着就很新鲜！"
                },
                {
                    "id": "402101602",
                    "speaker": "艾尔海森",
                    "text": "好啊。"
                },
                {
                    "id": "402101603",
                    "speaker": "卡维",
                    "text": "老板，打包一些这个。"
                },
                {
                    "id": "402101604",
                    "speaker": "沙瓦玛",
                    "text": "好的好的，打包外带对吧。两位是要二人份？"
                },
                {
                    "id": "402101605",
                    "speaker": "卡维",
                    "text": "欸？啊不不不！不是，不是的…"
                },
                {
                    "id": "402101606",
                    "speaker": "卡维",
                    "text": "麻烦帮我们分开打包两个一人份！"
                },
                {
                    "id": "402101607",
                    "speaker": "沙瓦玛",
                    "text": "……？"
                },
                {
                    "id": "402101608",
                    "speaker": "沙瓦玛",
                    "text": "好的请稍等，马上就来哦。"
                },
                {
                    "id": "402101609",
                    "speaker": "卡维",
                    "text": "咳…差点差点…"
                },
                {
                    "id": "402101610",
                    "speaker": "艾尔海森",
                    "text": "老板，我那份酱料少一点。"
                },
                {
                    "id": "402101611",
                    "speaker": "沙瓦玛",
                    "text": "没问题，这位先生的呢？"
                },
                {
                    "id": "402101612",
                    "speaker": "卡维",
                    "text": "我的要多一点酱汁。"
                },
                {
                    "id": "402101613",
                    "speaker": "沙瓦玛",
                    "text": "好嘞！"
                }
            ]
        },
        {
            "talkId": "4021116",
            "initDialog": "402111601",
            "dialogues": [
                {
                    "id": "402111601",
                    "speaker": "艾尔海森",
                    "text": "想好要吃什么了吗？"
                },
                {
                    "id": "402111602",
                    "speaker": "卡维",
                    "text": "……"
                },
                {
                    "id": "402111603",
                    "speaker": "艾尔海森",
                    "text": "……"
                },
                {
                    "id": "402111604",
                    "speaker": "卡维",
                    "text": "……"
                },
                {
                    "id": "402111605",
                    "speaker": "艾尔海森",
                    "text": "我先点了。"
                },
                {
                    "id": "402111606",
                    "speaker": "卡维",
                    "text": "欸欸欸！不对，等等…"
                },
                {
                    "id": "402111607",
                    "speaker": "卡维",
                    "text": "这套装听不见的办法不是你教的吗？根本不管用啊！"
                },
                {
                    "id": "402111608",
                    "speaker": "艾尔海森",
                    "text": "那得看对付谁了。"
                },
                {
                    "id": "402111609",
                    "speaker": "艾尔海森",
                    "text": "用我教你的办法对付我，肯定不会有什么效果。"
                }
            ]
        },
        {
            "talkId": "4021117",
            "initDialog": "402111701",
            "dialogues": [
                {
                    "id": "402111701",
                    "speaker": "提纳里",
                    "text": "难得你来化城郭。上次在的时候没来得及好好招待，这次要不要多待几天？"
                },
                {
                    "id": "402111702",
                    "speaker": "赛索斯",
                    "text": "好啊好啊，有什么好玩的？"
                },
                {
                    "id": "402111703",
                    "speaker": "提纳里",
                    "text": "倒也没什么特别的…我们一般也就找个地方露营，钓钓鱼、吃点烧烤什么的。"
                },
                {
                    "id": "402111704",
                    "speaker": "提纳里",
                    "text": "#之前{NICKNAME}旅行回来，我们也找{M#他}{F#她}一起去露营来着。"
                },
                {
                    "id": "402111705",
                    "speaker": "赛索斯",
                    "text": "好啊好啊好啊！我最喜欢露营和烤肉了。"
                },
                {
                    "id": "402111706",
                    "speaker": "赛诺",
                    "text": "先别高兴太早。你可能不知道，提纳里的烧烤不放调料。"
                },
                {
                    "id": "402111707",
                    "speaker": "赛索斯",
                    "text": "啊？别啊…"
                },
                {
                    "id": "402111708",
                    "speaker": "提纳里",
                    "text": "别听他的。我只是自己不怎么吃，你们想放多少就放多少。"
                },
                {
                    "id": "402111709",
                    "speaker": "赛诺",
                    "text": "哎，别戳穿我啊。"
                },
                {
                    "id": "402111710",
                    "speaker": "赛索斯",
                    "text": "…赛诺，你变了。"
                },
                {
                    "id": "402111711",
                    "speaker": "赛索斯",
                    "text": "可惜阿帽最近有事不在，不然我一定叫他过来对付你。"
                },
                {
                    "id": "402111712",
                    "speaker": "赛诺",
                    "text": "我倒是也想，可惜他不打牌。"
                },
                {
                    "id": "402111713",
                    "speaker": "赛诺",
                    "text": "…想知道为什么吗？"
                },
                {
                    "id": "402111714",
                    "speaker": "提纳里",
                    "text": "不想！"
                },
                {
                    "id": "402111715",
                    "speaker": "赛诺",
                    "text": "对了，阿帽跑哪里去了？你最近见过他吗？"
                },
                {
                    "id": "402111716",
                    "speaker": "赛索斯",
                    "text": "听说是动身去挪德卡莱了，好像有事要办。"
                },
                {
                    "id": "402111717",
                    "speaker": "提纳里",
                    "text": "嗯，那就祝他一切顺利吧。"
                }
            ]
        },
        {
            "talkId": "4021118",
            "initDialog": "402111801",
            "dialogues": [
                {
                    "id": "402111801",
                    "speaker": "纳西妲",
                    "text": "真好呢，没想到今天能在这里与你们相聚。"
                },
                {
                    "id": "402111802",
                    "speaker": "纳西妲",
                    "text": "就像同一片天空上升起了三颗不同颜色的星星，是值得庆祝的盛景。"
                },
                {
                    "id": "402111803",
                    "speaker": "莱依拉",
                    "text": "草神大人，还有祖拜尔剧场的妮露小姐！我…我没有打扰到你们吧？"
                },
                {
                    "id": "402111804",
                    "speaker": "妮露",
                    "text": "当然不会！晴朗的星空令人身心放松，我偶尔会来这里放空，等舞蹈的灵感找上门来。"
                },
                {
                    "id": "402111805",
                    "speaker": "莱依拉",
                    "text": "原来除了我以外，还有人也会来这里寻找灵感。"
                },
                {
                    "id": "402111806",
                    "speaker": "莱依拉",
                    "text": "只不过我的灵感，是指课题方面的…"
                },
                {
                    "id": "402111807",
                    "speaker": "妮露",
                    "text": "没关系呀，虽然内容不同，但我觉得那种灵光一现的感觉一定是相通的。"
                },
                {
                    "id": "402111808",
                    "speaker": "妮露",
                    "text": "嘿嘿，只不过这次找上门来的不是灵感，竟然是小吉祥草王大人呢。"
                },
                {
                    "id": "402111809",
                    "speaker": "纳西妲",
                    "text": "哎呀，你们怎么知道，我来这里不是为了寻找灵感的呢？"
                },
                {
                    "id": "402111810",
                    "speaker": "纳西妲",
                    "text": "毕竟做梦也需要创新嘛。"
                },
                {
                    "id": "402111811",
                    "speaker": "纳西妲",
                    "text": "来，我带了枣椰蜜糖。就让它们为我们带来甜甜的梦境吧。"
                }
            ]
        },
        {
            "talkId": "7370504",
            "initDialog": "737050401",
            "dialogues": [
                {
                    "id": "737050401",
                    "speaker": "安柏",
                    "text": "#哟，{NICKNAME}！状态还好吗？要不要试试「翠星柯里安巴」和「赤红飞兔伯爵」的全速冲刺？"
                },
                {
                    "id": "737050402",
                    "speaker": "柯莱",
                    "text": "两位「侦察伙伴」已经调试完毕了，一切就绪！",
                    "choices": [
                        {
                            "id": "737050403",
                            "text": "那就开始吧！",
                            "response": [
                                {
                                    "id": "737050404",
                                    "speaker": "安柏",
                                    "text": "好呀！有点找回飞行测试那时的感觉了！"
                                }
                            ]
                        },
                        {
                            "id": "737050405",
                            "text": "柯莱忙得过来吗？",
                            "response": [
                                {
                                    "id": "737050406",
                                    "speaker": "柯莱",
                                    "text": "请放心，这座小站也兼作「稳健知行」的临时办事处。"
                                },
                                {
                                    "id": "737050407",
                                    "speaker": "柯莱",
                                    "text": "平时，我就一起和安柏处理「侦察伙伴」的实测数据，填填表。"
                                },
                                {
                                    "id": "737050408",
                                    "speaker": "安柏",
                                    "text": "还有还有，给出内部机关的修改建议！"
                                },
                                {
                                    "id": "737050409",
                                    "speaker": "安柏",
                                    "text": "如果考察队伍过来了，我们就去登记信息，确认他们是否需要紧急训练，然后办理出行手续，分配人员和装备…"
                                },
                                {
                                    "id": "737050410",
                                    "speaker": "安柏",
                                    "text": "然后就是时刻注意这个营地的物资补给，和后勤人员沟通…",
                                    "choices": [
                                        {
                                            "id": "737050411",
                                            "text": "这么多事？好忙！",
                                            "response": [
                                                {
                                                    "id": "737050413",
                                                    "speaker": "柯莱",
                                                    "text": "没事没事，只是暂时的。这个机构刚刚起步不久，一切都在建设中。"
                                                },
                                                {
                                                    "id": "737050414",
                                                    "speaker": "安柏",
                                                    "text": "不用担心，起码，确认学生们的出行资格，还有关注后勤物资这些活儿，我很拿手！"
                                                },
                                                {
                                                    "id": "737050415",
                                                    "speaker": "柯莱",
                                                    "text": "教令院还会调遣后续的专家，建立一支正规的文书工作组，根据我们的指示进行工作。"
                                                },
                                                {
                                                    "id": "737050416",
                                                    "speaker": "柯莱",
                                                    "text": "那边已经有几位专家就位了，等到他们进入状态，学者们给出完备的认证，我们就可以慢慢把工作交接出去。"
                                                },
                                                {
                                                    "id": "737050417",
                                                    "speaker": "安柏",
                                                    "text": "然后就能开开心心休息一段时间啦！"
                                                },
                                                {
                                                    "id": "737050418",
                                                    "speaker": "Player",
                                                    "text": "安柏去须弥各地玩过了吗？"
                                                },
                                                {
                                                    "id": "737050419",
                                                    "speaker": "安柏",
                                                    "text": "嘿嘿，出发之前，我找丽莎小姐和凯亚队长好好咨询过一番，做好了旅行计划。"
                                                },
                                                {
                                                    "id": "737050420",
                                                    "speaker": "安柏",
                                                    "text": "不过，这次时间有点紧，柯莱先带我在须弥城里逛了逛，享受了很棒很棒的本地美食。"
                                                },
                                                {
                                                    "id": "737050421",
                                                    "speaker": "安柏",
                                                    "text": "看柯莱这么忙，我也不好意思叫她陪我到处跑。相反，应该是我多陪陪她，帮帮忙才对。"
                                                },
                                                {
                                                    "id": "737050422",
                                                    "speaker": "柯莱",
                                                    "text": "对不起，安柏…"
                                                },
                                                {
                                                    "id": "737050423",
                                                    "speaker": "安柏",
                                                    "text": "哎呀，你干嘛道歉？我明明很开心！"
                                                },
                                                {
                                                    "id": "737050424",
                                                    "speaker": "安柏",
                                                    "text": "因为，我亲眼见识到了，现在的柯莱稳重又可靠，是须弥的朋友们信任…甚至依靠的对象！"
                                                },
                                                {
                                                    "id": "737050425",
                                                    "speaker": "安柏",
                                                    "text": "旅行和玩乐什么的，随时都可以出发嘛，我又不是只来这一次。"
                                                },
                                                {
                                                    "id": "737050426",
                                                    "speaker": "安柏",
                                                    "text": "你把「稳健知行」的工作办得稳稳当当以后，我们再安安心心去玩也不迟！"
                                                },
                                                {
                                                    "id": "737050427",
                                                    "speaker": "柯莱",
                                                    "text": "呜…感觉…更有干劲了…"
                                                },
                                                {
                                                    "id": "737050428",
                                                    "speaker": "柯莱",
                                                    "text": "我一定要好好工作，把一切事务处理得妥妥当当，不让安柏操心！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737050412",
                                            "text": "应该给你们俩多发几份工资。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737050429",
                            "text": "待会儿再来试试！",
                            "response": [
                                {
                                    "id": "737050430",
                                    "speaker": "安柏",
                                    "text": "好哦，不着急不着急，你先忙手头的事！"
                                },
                                {
                                    "id": "737050431",
                                    "speaker": "柯莱",
                                    "text": "我们随时等你！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7370505",
            "initDialog": "737050501",
            "dialogues": [
                {
                    "id": "737050501",
                    "speaker": "珐露珊",
                    "text": "#来啦，{NICKNAME}？是想深入研究一番机关解谜，还是来陪前辈我聊聊天的？",
                    "choices": [
                        {
                            "id": "737050502",
                            "text": "先来解谜吧！",
                            "response": [
                                {
                                    "id": "737050503",
                                    "speaker": "珐露珊",
                                    "text": "不错不错，我在你的眼里看见了旺盛的求知火光，好好表现吧！"
                                }
                            ]
                        },
                        {
                            "id": "737050504",
                            "text": "有些想问前辈的事。",
                            "response": [
                                {
                                    "id": "737050505",
                                    "speaker": "珐露珊",
                                    "text": "哼哼，尽管提问吧，仅限于你，前辈我可是有问必答的哦。",
                                    "choices": [
                                        {
                                            "id": "737050506",
                                            "text": "前辈偏好可爱还是精致的玩偶？",
                                            "response": [
                                                {
                                                    "id": "737050507",
                                                    "speaker": "珐露珊",
                                                    "text": "那当然是精致的种类…"
                                                },
                                                {
                                                    "id": "737050508",
                                                    "speaker": "珐露珊",
                                                    "text": "倒也不是「不喜欢」可爱的风格，很少有人会反感胖乎乎、眼睛大大、脸蛋圆圆的小家伙吧。"
                                                },
                                                {
                                                    "id": "737050509",
                                                    "speaker": "珐露珊",
                                                    "text": "但毕竟这把年纪了，还和小孩一样抱着圆圆软软的玩偶，多少有些…有失威严。"
                                                },
                                                {
                                                    "id": "737050510",
                                                    "speaker": "珐露珊",
                                                    "text": "相反，近来有些用料考究，线条优美，五官刻画细致，妆容如宝石般闪亮亮的玩偶。"
                                                },
                                                {
                                                    "id": "737050511",
                                                    "speaker": "珐露珊",
                                                    "text": "在兼顾可爱特质的同时，给人的第一反应是艺术品般的美观，就能两者兼得。"
                                                },
                                                {
                                                    "id": "737050512",
                                                    "speaker": "珐露珊",
                                                    "text": "不对…我以为你想咨询学术上的问题，怎么问的是这些无关问题？"
                                                },
                                                {
                                                    "id": "737050513",
                                                    "speaker": "Player",
                                                    "text": "欸嘿！知道了前辈的喜好！"
                                                },
                                                {
                                                    "id": "737050514",
                                                    "speaker": "珐露珊",
                                                    "text": "咳咳，这次就先不计较了，以后再和我「欸嘿」，也没法蒙混过关了哦！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737050515",
                                            "text": "自动和手控的机关谁更好？",
                                            "response": [
                                                {
                                                    "id": "737050516",
                                                    "speaker": "珐露珊",
                                                    "text": "哦，经典的自主行动和手动控制之争问题…"
                                                },
                                                {
                                                    "id": "737050517",
                                                    "speaker": "珐露珊",
                                                    "text": "我不是那种死板的，认准一个道理就不知变通的家伙，这个问题的答案完全取决于应用场景。"
                                                },
                                                {
                                                    "id": "737050518",
                                                    "speaker": "珐露珊",
                                                    "text": "简单来说，需要大量重复机械性行为，稀释了人脑劳动价值的工作，自主行动的机关更好。"
                                                },
                                                {
                                                    "id": "737050519",
                                                    "speaker": "珐露珊",
                                                    "text": "侧重于「辨识」、「分析」和「决策」的场景下，手动控制的机关永远更保险。"
                                                },
                                                {
                                                    "id": "737050520",
                                                    "speaker": "珐露珊",
                                                    "text": "因为人的思维相当复杂，哪怕只是模拟六岁小孩的思维，都需要付出无比巨大的…器件复杂度、系统重量和能量成本。"
                                                },
                                                {
                                                    "id": "737050521",
                                                    "speaker": "珐露珊",
                                                    "text": "在我可预见的一段时间内，以量产化的技术模拟成年人思维的传统设备啊，基本不可能下放到小型化的机关身上。",
                                                    "choices": [
                                                        {
                                                            "id": "737050522",
                                                            "text": "好精准的概括！",
                                                            "response": [
                                                                {
                                                                    "id": "737050524",
                                                                    "speaker": "珐露珊",
                                                                    "text": "我就说嘛，如果你对这样的学术问题感兴趣，你应该来听我的课。"
                                                                },
                                                                {
                                                                    "id": "737050525",
                                                                    "speaker": "珐露珊",
                                                                    "text": "以你的聪颖才思…嗯，肯定能从居勒什的学生丽莎·敏兹那里，夺走「两百年一见高材生」的荣誉！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "737050523",
                                                            "text": "新知识在脑袋里住下了…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737050526",
                            "text": "我先去处理一下别的事…",
                            "response": [
                                {
                                    "id": "737050527",
                                    "speaker": "珐露珊",
                                    "text": "去吧去吧，空闲下来了，就记得来找前辈我哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7370506",
            "initDialog": "737050601",
            "dialogues": [
                {
                    "id": "737050601",
                    "speaker": "迪希雅",
                    "text": "#哟，{NICKNAME}！要去检验「考官」们的成色吗？",
                    "choices": [
                        {
                            "id": "737050602",
                            "text": "正合我意，这就去会会对手！",
                            "response": [
                                {
                                    "id": "737050603",
                                    "speaker": "坎蒂丝",
                                    "text": "还请注意节奏，不必战斗得太过劳累。"
                                },
                                {
                                    "id": "737050604",
                                    "speaker": "迪希雅",
                                    "text": "没错，按照计划，在一定时间内打败适量的对手就行，留点敌人给接受考核的学员！"
                                }
                            ]
                        },
                        {
                            "id": "737050605",
                            "text": "不急不急，先聊聊天。",
                            "response": [
                                {
                                    "id": "737050606",
                                    "speaker": "迪希雅",
                                    "text": "哈哈，好啊！我们确实有些日子没见了。"
                                },
                                {
                                    "id": "737050607",
                                    "speaker": "迪希雅",
                                    "text": "要是提前知道了你会来，我肯定和坎蒂丝准备几道硬菜，先给你来一场新风味的接风宴！"
                                },
                                {
                                    "id": "737050608",
                                    "speaker": "Player",
                                    "text": "新风味？"
                                },
                                {
                                    "id": "737050609",
                                    "speaker": "迪希雅",
                                    "text": "说来也挺神奇的，上次我去了枫丹长了长见识，带回了几本食谱和几袋香料。"
                                },
                                {
                                    "id": "737050610",
                                    "speaker": "迪希雅",
                                    "text": "我把这些东西送给了坎蒂丝，没想到，她做出了让我惊奇的料理…"
                                },
                                {
                                    "id": "737050611",
                                    "speaker": "迪希雅",
                                    "text": "比如「海露花干烤肉拌饭」，看起来和平时的阿如拌饭完全没有区别…"
                                },
                                {
                                    "id": "737050612",
                                    "speaker": "迪希雅",
                                    "text": "谁能想到，入口后先是一阵肉香和米饭的满足，然后，清凉的回甘就在口腔中弥漫开来，油而不腻…"
                                },
                                {
                                    "id": "737050613",
                                    "speaker": "迪希雅",
                                    "text": "既能狠狠补充体力，又不会口干舌燥，太适合在沙漠野营的时候吃了！"
                                },
                                {
                                    "id": "737050614",
                                    "speaker": "坎蒂丝",
                                    "text": "只要不到离经叛道的程度，我并不反对改良传统菜式。"
                                },
                                {
                                    "id": "737050615",
                                    "speaker": "坎蒂丝",
                                    "text": "毕竟，在沙漠之中，一切食材都弥足珍贵，无论如何，都应该让它们物尽其用。"
                                },
                                {
                                    "id": "737050616",
                                    "speaker": "迪希雅",
                                    "text": "那你倒是收下那身衣服啊？织物也是珍贵的资源嘛。"
                                },
                                {
                                    "id": "737050617",
                                    "speaker": "迪希雅",
                                    "text": "虽然总有人说，我不讲究穿着，不够「时尚」…但我买的时候请人帮忙参考了，应该…还算合身吧？"
                                },
                                {
                                    "id": "737050618",
                                    "speaker": "迪希雅",
                                    "text": "结果最后让给团里的会计小妹了，她倒是开心得跳起来。"
                                },
                                {
                                    "id": "737050619",
                                    "speaker": "坎蒂丝",
                                    "text": "由衷感谢你，迪希雅，你的心意我收下了。"
                                },
                                {
                                    "id": "737050620",
                                    "speaker": "坎蒂丝",
                                    "text": "不过，我作为阿如村的守护者，不应穿得太过显眼。华贵的衣服，也应该在合适的场合发挥作用。"
                                },
                                {
                                    "id": "737050621",
                                    "speaker": "坎蒂丝",
                                    "text": "我推荐你将其赠予会计小妹，也是考虑到她会代表你们「炽光猎兽」去一些商业场合谈生意。"
                                },
                                {
                                    "id": "737050622",
                                    "speaker": "迪希雅",
                                    "text": "喔…喔！早说嘛！我还以为我选的款式入不了你的法眼呢！"
                                },
                                {
                                    "id": "737050623",
                                    "speaker": "坎蒂丝",
                                    "text": "下次，如果还想为了「炽光猎兽」在阿如村长期借住的事表示感谢…"
                                },
                                {
                                    "id": "737050624",
                                    "speaker": "坎蒂丝",
                                    "text": "可以带些布匹来，我略懂剪裁，能为大家做些抵御沙尘的披风。"
                                },
                                {
                                    "id": "737050625",
                                    "speaker": "坎蒂丝",
                                    "text": "布料不用太贵重，坚韧耐用就行，相信你的眼光。",
                                    "choices": [
                                        {
                                            "id": "737050626",
                                            "text": "看起来，坎蒂丝是实用派…",
                                            "response": [
                                                {
                                                    "id": "737050628",
                                                    "speaker": "坎蒂丝",
                                                    "text": "#为{NICKNAME}制作披风时，我必须好好考虑披风的形制，还有得体的花纹。"
                                                },
                                                {
                                                    "id": "737050629",
                                                    "speaker": "坎蒂丝",
                                                    "text": "这样才能彰显阿如村尊贵客人的身份。"
                                                },
                                                {
                                                    "id": "737050630",
                                                    "speaker": "Player",
                                                    "text": "原来也有我一份！"
                                                },
                                                {
                                                    "id": "737050631",
                                                    "speaker": "Player",
                                                    "text": "谢谢！不用太复杂哦！"
                                                },
                                                {
                                                    "id": "737050632",
                                                    "speaker": "迪希雅",
                                                    "text": "啊呀呀，你这么一说，我都有些期待了…"
                                                },
                                                {
                                                    "id": "737050633",
                                                    "speaker": "迪希雅",
                                                    "text": "要不然，下次出游的目的地，就定在璃月吧？听说那里的布料非常不错，物美价廉…"
                                                },
                                                {
                                                    "id": "737050634",
                                                    "speaker": "迪希雅",
                                                    "text": "如果想买珍贵的绸缎，也有大把选择。"
                                                },
                                                {
                                                    "id": "737050635",
                                                    "speaker": "迪希雅",
                                                    "text": "不过，那边的治安非常好，我们过去就接不到活了，只能扮演乖巧礼貌的游客，就当是纯粹的旅行好了。"
                                                },
                                                {
                                                    "id": "737050636",
                                                    "speaker": "迪希雅",
                                                    "text": "搞定这次的差事后，我就和兄弟们仔细商量一下！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "737050627",
                                            "text": "披风确实很适合眼下的场景…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "737050637",
                            "text": "请稍等，我待会儿再来…",
                            "response": [
                                {
                                    "id": "737050638",
                                    "speaker": "迪希雅",
                                    "text": "好啊，那就等你状态不错再开工！"
                                },
                                {
                                    "id": "737050639",
                                    "speaker": "坎蒂丝",
                                    "text": "如果感到疲倦，还请好好休息。时间相当充裕，不用争这一时。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7370509",
            "initDialog": "737050901",
            "dialogues": [
                {
                    "id": "737050901",
                    "speaker": "哈贾娜德",
                    "text": "#啊哈…啊哈哈哈…又见面了，我的恩人{NICKNAME}。"
                },
                {
                    "id": "737050902",
                    "speaker": "哈贾娜德",
                    "text": "我是悉般多摩学院的新晋学者哈贾娜德，即将带领专门人士入场，协助「稳健知行」机构之后的运作。"
                },
                {
                    "id": "737050903",
                    "speaker": "哈贾娜德",
                    "text": "不过，在此之前，尚需短暂的交接工作，还请您稍作等待。"
                }
            ]
        },
        {
            "talkId": "7370510",
            "initDialog": "737051001",
            "dialogues": [
                {
                    "id": "737051001",
                    "speaker": "哈贾娜德",
                    "text": "您好，我的恩人。接下来就由我来继续管理这个侦察伙伴的项目，并详尽记述资料。"
                },
                {
                    "id": "737051002",
                    "speaker": "哈贾娜德",
                    "text": "有什么吩咐吗？",
                    "choices": [
                        {
                            "id": "737051003",
                            "text": "想要再试试侦察伙伴…",
                            "response": [
                                {
                                    "id": "737051004",
                                    "speaker": "哈贾娜德",
                                    "text": "没问题！这次，我会用更加准确的模型来分析您提供的数据！"
                                }
                            ]
                        },
                        {
                            "id": "737051005",
                            "text": "你好像是悉般多摩学院的？",
                            "response": [
                                {
                                    "id": "737051006",
                                    "speaker": "哈贾娜德",
                                    "text": "没错，我的学院并不直接参与机关研究。"
                                },
                                {
                                    "id": "737051007",
                                    "speaker": "哈贾娜德",
                                    "text": "但是没关系，多亏你们之前完成了所有关键规则与操作手册的制定，只是管理摊位和继续运营，每个学者都能做到。"
                                },
                                {
                                    "id": "737051008",
                                    "speaker": "哈贾娜德",
                                    "text": "在无需专门人力的地方，就做出一定的节省，也符合我们最新的原则。"
                                },
                                {
                                    "id": "737051009",
                                    "speaker": "哈贾娜德",
                                    "text": "附近待命的学者中，不乏刹诃伐罗学院的优秀人士，如果侦察伙伴的机关需要调试，随时可以唤来他们。"
                                },
                                {
                                    "id": "737051010",
                                    "speaker": "哈贾娜德",
                                    "text": "不过，目前看来，侦察伙伴们的状态都很好，完全无需担心！"
                                }
                            ]
                        },
                        {
                            "id": "737051011",
                            "text": "你加油！",
                            "response": [
                                {
                                    "id": "737051012",
                                    "speaker": "哈贾娜德",
                                    "text": "当然，等我干出了漂亮的成绩，一定专程来答谢您！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7370511",
            "initDialog": "737051101",
            "dialogues": [
                {
                    "id": "737051101",
                    "speaker": "塔拉内",
                    "text": "礼物，酬金，还有迪希雅大姐的介绍信，都准备好了…"
                },
                {
                    "id": "737051102",
                    "speaker": "塔拉内",
                    "text": "不知道妮露小姐忙不忙…听说要去那么远的地方，会不会很吃惊…"
                },
                {
                    "id": "737051103",
                    "speaker": "Player",
                    "text": "要打牌吗？"
                },
                {
                    "id": "737051104",
                    "speaker": "塔拉内",
                    "text": "你！可敬的旅者，你居然追到这里来了…"
                },
                {
                    "id": "737051105",
                    "speaker": "塔拉内",
                    "text": "那…那就打吧，虽然我可能有点心不在焉…"
                }
            ]
        },
        {
            "talkId": "7370602",
            "initDialog": "737060201",
            "dialogues": [
                {
                    "id": "737060201",
                    "speaker": "安柏",
                    "text": "有了这次的经验，以后我来看望你，就轻车熟路啦。"
                },
                {
                    "id": "737060202",
                    "speaker": "安柏",
                    "text": "当然，我还会再待一段时间，不过最近的工作让你累得不轻，我们就在家里悠悠哉哉休息几天吧？"
                },
                {
                    "id": "737060203",
                    "speaker": "柯莱",
                    "text": "太好了，我觉得很合适！"
                },
                {
                    "id": "737060204",
                    "speaker": "柯莱",
                    "text": "我之前就屯了不少食材和零食，还有一些有意思的收藏品，就等你来呢！"
                }
            ]
        },
        {
            "talkId": "7370603",
            "initDialog": "737060301",
            "dialogues": [
                {
                    "id": "737060301",
                    "speaker": "珐露珊",
                    "text": "尽兴了，这次确实尽兴了！"
                },
                {
                    "id": "737060302",
                    "speaker": "珐露珊",
                    "text": "接下来，就去研究一下国外的典籍，列个清单，交给那个热情的小姑娘吧。"
                }
            ]
        },
        {
            "talkId": "7370604",
            "initDialog": "737060401",
            "dialogues": [
                {
                    "id": "737060401",
                    "speaker": "迪希雅",
                    "text": "别担心，坎蒂丝，我绝对不会喝多的。"
                },
                {
                    "id": "737060402",
                    "speaker": "坎蒂丝",
                    "text": "我倒是不担心你的酒量，但身体的韧性也很重要，多喝营养充足的茶，可以抵消酒的负面影响。"
                },
                {
                    "id": "737060403",
                    "speaker": "迪希雅",
                    "text": "对的对的，我本来也不是酒鬼嘛！"
                },
                {
                    "id": "737060404",
                    "speaker": "迪希雅",
                    "text": "不过，营养充足的茶，我这里还有很多很多。"
                },
                {
                    "id": "737060405",
                    "speaker": "迪希雅",
                    "text": "不用再送我新的了，谢谢你，也谢谢孩子们！"
                }
            ]
        }
    ]
}