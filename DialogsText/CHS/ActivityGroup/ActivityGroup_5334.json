{
    "groupId": "5334",
    "total_dialogue_lines": 54,
    "speaker_counts": {
        "Player": 18,
        "列斯诺娃": 6,
        "塔拉利欣": 30
    },
    "talks": [
        {
            "talkId": "7767402",
            "initDialog": "776740201",
            "dialogues": [
                {
                    "id": "776740201",
                    "speaker": "塔拉利欣",
                    "text": "#{NICKNAME}的状态似乎很不错，现在就开始影域模拟战斗吗？",
                    "choices": [
                        {
                            "id": "776740202",
                            "text": "那就开始吧。",
                            "response": [
                                {
                                    "id": "776740203",
                                    "speaker": "塔拉利欣",
                                    "text": "嗯，请注意利用各种掩体和机关。找到最节省心力的战斗方式，或许对长时间在「影域」中活动有益…"
                                }
                            ]
                        },
                        {
                            "id": "776740204",
                            "text": "聊聊你自己？",
                            "response": [
                                {
                                    "id": "776740205",
                                    "speaker": "塔拉利欣",
                                    "text": "我？我叫塔拉利欣·果戈里，是冒险家协会总部的一名普通文员…"
                                },
                                {
                                    "id": "776740206",
                                    "speaker": "塔拉利欣",
                                    "text": "如果你对不久前的「冒险家发展大会和竞技大赛」还有印象…我有幸在会上帮忙协调部分事务。",
                                    "choices": [
                                        {
                                            "id": "776740207",
                                            "text": "普通文员要探查影域？",
                                            "response": [
                                                {
                                                    "id": "776740209",
                                                    "speaker": "塔拉利欣",
                                                    "text": "只是个人兴趣…加上一些不怎么走运的经验，让我对「影域」的了解程度，比普通人深那么一点…"
                                                },
                                                {
                                                    "id": "776740210",
                                                    "speaker": "塔拉利欣",
                                                    "text": "我也想献出自己的力量，减少冒险家们因为「影域」受到的伤害。"
                                                },
                                                {
                                                    "id": "776740211",
                                                    "speaker": "塔拉利欣",
                                                    "text": "尽管从协会了解的案例看，从「影域」中生还，并保留基本神智的概率，不足万分之九…"
                                                },
                                                {
                                                    "id": "776740212",
                                                    "speaker": "塔拉利欣",
                                                    "text": "但我们不能就此认定，落入「影域」就是必死的境地。全力拼搏总比直接放弃要强。"
                                                },
                                                {
                                                    "id": "776740213",
                                                    "speaker": "塔拉利欣",
                                                    "text": "将枪械和运用工事的能力锻炼至炉火纯青的境界，或许就能争取到一线生机呢？",
                                                    "choices": [
                                                        {
                                                            "id": "776740214",
                                                            "text": "你的想法倒像个士兵。",
                                                            "response": [
                                                                {
                                                                    "id": "776740216",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "嗯，或许是被叔父和他的挚友们影响了吧。"
                                                                },
                                                                {
                                                                    "id": "776740217",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "我小的时候，就藏不住心里对枪械的那股喜爱劲，总是拿着戈尔坚科叔父的猎枪，不停把玩。"
                                                                },
                                                                {
                                                                    "id": "776740218",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "叔父就会在西多连科、诺莫科诺夫和瓦西里大伯叫他去打猎时带上我。"
                                                                },
                                                                {
                                                                    "id": "776740219",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "他们教我怎么在三百步的距离上一击放倒最凶暴的野兽，教我怎么在雪地里隐藏自己的踪迹…"
                                                                },
                                                                {
                                                                    "id": "776740220",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "第五次狩猎后，就让我去独自应对一些魔物，考验我「化距离为防护」的思维。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "776740221",
                                                                            "text": "很不错的经历。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "776740223",
                                                                                    "speaker": "塔拉利欣",
                                                                                    "text": "可惜，后来叔父和三位大伯走上了不同的道路，打交道的次数慢慢变少了…"
                                                                                },
                                                                                {
                                                                                    "id": "776740224",
                                                                                    "speaker": "塔拉利欣",
                                                                                    "text": "哪怕西多连科、诺莫科诺夫和瓦西里大伯有一位还在至冬，戈尔坚科叔父也不会轻敌，结果被卷入影域事故…"
                                                                                },
                                                                                {
                                                                                    "id": "776740225",
                                                                                    "speaker": "塔拉利欣",
                                                                                    "text": "啊，抱歉，有点啰嗦了…不能一味沉浸在回忆和假设里，还是让我们看向前方吧。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "776740222",
                                                                            "text": "你童年就成了专家。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "776740215",
                                                            "text": "你很相信武器和战术。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "776740208",
                                            "text": "普通文员写这种推演？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "776740226",
                            "text": "还有其他人参加推演吗？",
                            "response": [
                                {
                                    "id": "776740227",
                                    "speaker": "塔拉利欣",
                                    "text": "在刚才那位冒险家之前，还有12人试过，不过成绩都逊色于她，全都没能完成第一个推演。"
                                },
                                {
                                    "id": "776740228",
                                    "speaker": "塔拉利欣",
                                    "text": "她叫列斯诺娃，实力可观，能够相当轻松地独立完成A级委托，进步速度也很快…"
                                },
                                {
                                    "id": "776740229",
                                    "speaker": "塔拉利欣",
                                    "text": "论综合能力，我认为她和琪琪科娃小妹处于同一水平，达到了阿罗夏先生的一成…甚至两成，前途无量。",
                                    "choices": [
                                        {
                                            "id": "776740230",
                                            "text": "你认识阿罗夏？",
                                            "response": [
                                                {
                                                    "id": "776740232",
                                                    "speaker": "塔拉利欣",
                                                    "text": "我间接受过他的帮助，也出于职业习惯，根据一些零散的情报，简单评估过他的实力，结论相当惊人…"
                                                },
                                                {
                                                    "id": "776740233",
                                                    "speaker": "塔拉利欣",
                                                    "text": "当然，阿罗夏先生并不认识我，毕竟他直接或间接帮到的人可不少，我只希望有一天也能回报他。"
                                                },
                                                {
                                                    "id": "776740234",
                                                    "speaker": "塔拉利欣",
                                                    "text": "说回协会这边。列斯诺娃的未婚夫拉多米尔也回到至冬堡了，这使她精神抖擞。"
                                                },
                                                {
                                                    "id": "776740235",
                                                    "speaker": "塔拉利欣",
                                                    "text": "不过，列斯诺娃有点不擅长制定计划和分配时间，总是错过集合的节点，好几次让整支队伍缺员行动…"
                                                },
                                                {
                                                    "id": "776740236",
                                                    "speaker": "塔拉利欣",
                                                    "text": "之前的冒险家大赛中，她先后被纳蒂亚女士和梨香轻松超越，完全没机会登上榜单。",
                                                    "choices": [
                                                        {
                                                            "id": "776740237",
                                                            "text": "…是个有趣的家伙。",
                                                            "response": [
                                                                {
                                                                    "id": "776740239",
                                                                    "speaker": "塔拉利欣",
                                                                    "text": "要是她之后能稍微改改这个习惯，我想招募她，与其他两位可靠的兄弟一同协助岚姐…",
                                                                    "choices": [
                                                                        {
                                                                            "id": "776740240",
                                                                            "text": "岚姐吗？",
                                                                            "response": [
                                                                                {
                                                                                    "id": "776740242",
                                                                                    "speaker": "塔拉利欣",
                                                                                    "text": "她说着「先练练手」和「不用担心」，带着刚组好的枪械，去野外进行「战斗露营」了。"
                                                                                },
                                                                                {
                                                                                    "id": "776740243",
                                                                                    "speaker": "塔拉利欣",
                                                                                    "text": "可能，在迈出关键的那一步前，她想将自己对至冬的适应力提升至最佳区间。"
                                                                                },
                                                                                {
                                                                                    "id": "776740244",
                                                                                    "speaker": "塔拉利欣",
                                                                                    "text": "多做准备总归是好的，如果你对后续事宜感兴趣，请等着我们的好消息。"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "776740241",
                                                                            "text": "她的情况如何？"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "776740238",
                                                            "text": "…是个冒失的家伙。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "776740231",
                                            "text": "你和阿罗夏合作过？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "776740245",
                            "text": "待会儿再来。",
                            "response": [
                                {
                                    "id": "776740246",
                                    "speaker": "塔拉利欣",
                                    "text": "明白了，那我继续整理数据。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7767403",
            "initDialog": "776740301",
            "dialogues": [
                {
                    "id": "776740301",
                    "speaker": "列斯诺娃",
                    "text": "啊，你也被塔拉利欣拉着进行推演了吗？我看你和他聊了很久。",
                    "choices": [
                        {
                            "id": "776740302",
                            "text": "没错，有什么问题吗？",
                            "response": [
                                {
                                    "id": "776740303",
                                    "speaker": "列斯诺娃",
                                    "text": "我不太擅长和他打交道，祝你好运。"
                                },
                                {
                                    "id": "776740304",
                                    "speaker": "列斯诺娃",
                                    "text": "除了这次推演，塔拉利欣总把自己要去收拾的事说得轻描淡写…无论有多棘手。"
                                },
                                {
                                    "id": "776740305",
                                    "speaker": "列斯诺娃",
                                    "text": "派给别人的任务，哪怕只是找一只猫，都要再三叮嘱，让别人千万谨慎行事，生怕别人下错哪一级台阶崴了脚。"
                                },
                                {
                                    "id": "776740306",
                                    "speaker": "列斯诺娃",
                                    "text": "他总让我感觉，我不适合当冒险家，不适合团队合作…"
                                }
                            ]
                        },
                        {
                            "id": "776740307",
                            "text": "的确，不过我要先走了。",
                            "response": [
                                {
                                    "id": "776740308",
                                    "speaker": "列斯诺娃",
                                    "text": "那有缘再见。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}