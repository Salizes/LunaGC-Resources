{
    "groupId": "5333",
    "total_dialogue_lines": 116,
    "speaker_counts": {
        "Player": 26,
        "「小松果」": 11,
        "「燃爆木头人」": 13,
        "「燃爆木头人」&「小松果」": 1,
        "大喜儿": 23,
        "琪琪科娃": 42
    },
    "talks": [
        {
            "talkId": "7750403",
            "initDialog": "775040301",
            "dialogues": [
                {
                    "id": "775040301",
                    "speaker": "琪琪科娃",
                    "text": "呼呼~只要好好按照探索计划，熟悉至冬的各种地点和事物，迟早能成为名副其实的强者！",
                    "choices": [
                        {
                            "id": "775040302",
                            "text": "关于凯瑟琳的立像和礼物…",
                            "response": [
                                {
                                    "id": "775040303",
                                    "speaker": "琪琪科娃",
                                    "text": "嘿嘿，好看吧？"
                                },
                                {
                                    "id": "775040304",
                                    "speaker": "琪琪科娃",
                                    "text": "这一套凯瑟琳大人的立像可是限定的款式哦，花大价钱请了很厉害的画家和工匠做出来的…"
                                },
                                {
                                    "id": "775040305",
                                    "speaker": "琪琪科娃",
                                    "text": "有的被冒险家前辈们藏在了冰块里，有的被互相寄送交换。"
                                },
                                {
                                    "id": "775040306",
                                    "speaker": "琪琪科娃",
                                    "text": "因为太热门，发售方和协会都开始使用特殊的「热诚票券」来抽取立像的部件。"
                                },
                                {
                                    "id": "775040307",
                                    "speaker": "琪琪科娃",
                                    "text": "我也是费了好大好大的功夫…差不多半辈子的零花钱，才搞到这批票券和部件的！"
                                },
                                {
                                    "id": "775040308",
                                    "speaker": "琪琪科娃",
                                    "text": "这样一来，互助会的大家也都根据自己喜欢的方式，搭建出凯瑟琳大人的不同形象啦。",
                                    "choices": [
                                        {
                                            "id": "775040309",
                                            "text": "凯瑟琳…大人？",
                                            "response": [
                                                {
                                                    "id": "775040311",
                                                    "speaker": "琪琪科娃",
                                                    "text": "欸？凯瑟琳大人不是…冒险家协会说了算的人吗？"
                                                },
                                                {
                                                    "id": "775040312",
                                                    "speaker": "琪琪科娃",
                                                    "text": "我听别人说，每个冒险家都要听凯瑟琳大人指挥，任务都是凯瑟琳大人指派的。"
                                                },
                                                {
                                                    "id": "775040313",
                                                    "speaker": "琪琪科娃",
                                                    "text": "而且搞定一切后，奖励也是凯瑟琳大人亲手发放的。"
                                                },
                                                {
                                                    "id": "775040314",
                                                    "speaker": "琪琪科娃",
                                                    "text": "那，凯瑟琳大人手里应该掌握着全提瓦特所有冒险家的情报和奖金…"
                                                },
                                                {
                                                    "id": "775040315",
                                                    "speaker": "琪琪科娃",
                                                    "text": "这不是超厉害的嘛！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775040310",
                                            "text": "你好敬仰凯瑟琳的样子？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775040316",
                            "text": "关于探索计划…",
                            "response": [
                                {
                                    "id": "775040317",
                                    "speaker": "琪琪科娃",
                                    "text": "你是不是有点不放心？担心我的计划不靠谱？"
                                },
                                {
                                    "id": "775040318",
                                    "speaker": "琪琪科娃",
                                    "text": "以前也有别人质疑过我——「一个小鬼的计划，能让人学到什么东西？」"
                                },
                                {
                                    "id": "775040319",
                                    "speaker": "琪琪科娃",
                                    "text": "那我就要声明了：我的探索计划啊，可是根据塔拉利欣大哥留下的资料改编出来的！"
                                },
                                {
                                    "id": "775040320",
                                    "speaker": "琪琪科娃",
                                    "text": "塔拉利欣大哥的资料又综合了好多冒险家和猎人的经验，甚至是掷弹兵的训练手册。"
                                },
                                {
                                    "id": "775040321",
                                    "speaker": "琪琪科娃",
                                    "text": "明白了吧？就算我只是一个小鬼，至少参考信息绝对可靠。",
                                    "choices": [
                                        {
                                            "id": "775040322",
                                            "text": "这个人很厉害吗？",
                                            "response": [
                                                {
                                                    "id": "775040324",
                                                    "speaker": "琪琪科娃",
                                                    "text": "要看和谁比了…我们村里的阿贾克斯大哥来的话，一分钟能打五十个…八十个他？"
                                                },
                                                {
                                                    "id": "775040325",
                                                    "speaker": "琪琪科娃",
                                                    "text": "阿贾克斯大哥的大名，你总听过吧？"
                                                },
                                                {
                                                    "id": "775040326",
                                                    "speaker": "琪琪科娃",
                                                    "text": "话又说回来了，要是我这辈子能在阿贾克斯大哥手下撑过两秒钟，强到那种程度…我做梦都能笑醒！"
                                                },
                                                {
                                                    "id": "775040327",
                                                    "speaker": "琪琪科娃",
                                                    "text": "像我这种普通人，最多就达到塔拉利欣大哥的水平了，不能贪心。"
                                                },
                                                {
                                                    "id": "775040328",
                                                    "speaker": "琪琪科娃",
                                                    "text": "现在，塔拉利欣大哥在冒险家协会总部工作，听说他还挺重要的呢。"
                                                },
                                                {
                                                    "id": "775040329",
                                                    "speaker": "琪琪科娃",
                                                    "text": "只要你也快快变强，成为合格的冒险家，说不定就能在至冬堡见到他了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775040323",
                                            "text": "你这大哥很强吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775040330",
                            "text": "聊聊你自己的情况？",
                            "response": [
                                {
                                    "id": "775040331",
                                    "speaker": "琪琪科娃",
                                    "text": "我？好像也没什么好说的…"
                                },
                                {
                                    "id": "775040332",
                                    "speaker": "琪琪科娃",
                                    "text": "我家里就是普普通通的渔民，如果我不变厉害一点，以后也要继续打鱼了。"
                                },
                                {
                                    "id": "775040333",
                                    "speaker": "琪琪科娃",
                                    "text": "打鱼没什么不好，但好像也没什么值得期待。"
                                },
                                {
                                    "id": "775040334",
                                    "speaker": "琪琪科娃",
                                    "text": "家里最有出息的…是大我快二十岁的姐姐。"
                                },
                                {
                                    "id": "775040335",
                                    "speaker": "琪琪科娃",
                                    "text": "我姐姐叫布达诺娃，在我还不记事的时候，就因为身体很棒很棒，光荣地加入愚人众了。"
                                },
                                {
                                    "id": "775040336",
                                    "speaker": "琪琪科娃",
                                    "text": "后来，姐姐甚至成了一位厉害的执行官的部下，去了枫丹！"
                                },
                                {
                                    "id": "775040337",
                                    "speaker": "琪琪科娃",
                                    "text": "因为工作太忙太忙了，她好久好久没回来了，我都有点忘记她的样子了…"
                                },
                                {
                                    "id": "775040338",
                                    "speaker": "琪琪科娃",
                                    "text": "我只能一直和姐姐写信，她每封信里都给我寄好多零花钱，还拜托她在至冬的朋友给我买漂亮的衣服！"
                                },
                                {
                                    "id": "775040339",
                                    "speaker": "琪琪科娃",
                                    "text": "这件衣服就是用姐姐给我的摩拉买的，漂亮吧？"
                                },
                                {
                                    "id": "775040340",
                                    "speaker": "琪琪科娃",
                                    "text": "等我再变厉害一点，我要穿着这一身去枫丹，给姐姐一个惊喜！",
                                    "choices": [
                                        {
                                            "id": "775040341",
                                            "text": "你也想加入愚人众吗？",
                                            "response": [
                                                {
                                                    "id": "775040343",
                                                    "speaker": "琪琪科娃",
                                                    "text": "不，姐姐说过，如果我们姐妹两都走一样的道路，以后的生活就会少很多乐趣。"
                                                },
                                                {
                                                    "id": "775040344",
                                                    "speaker": "琪琪科娃",
                                                    "text": "她和爸爸妈妈说，我有很多很多选择，可以试试专业铳枪射手、地理勘测员、船员和冒险家…"
                                                },
                                                {
                                                    "id": "775040345",
                                                    "speaker": "琪琪科娃",
                                                    "text": "这里面，我还是对冒险家最感兴趣，不过，我也不会只学这一种职业的本领。"
                                                },
                                                {
                                                    "id": "775040346",
                                                    "speaker": "琪琪科娃",
                                                    "text": "最近认识的朋友大喜儿就告诉我一句璃月谚语：「技多不压身」。"
                                                },
                                                {
                                                    "id": "775040347",
                                                    "speaker": "琪琪科娃",
                                                    "text": "学会各种各样的本事，也是变强的一种境界嘛，还能从姐姐意想不到的角度帮她！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775040342",
                                            "text": "你想跟着姐姐干活吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775040348",
                            "text": "待会儿再来聊天…",
                            "response": [
                                {
                                    "id": "775040349",
                                    "speaker": "琪琪科娃",
                                    "text": "要去干活了吗？那你加油哦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7750404",
            "initDialog": "775040401",
            "dialogues": [
                {
                    "id": "775040401",
                    "speaker": "「燃爆木头人」",
                    "text": "杜杜杜杜杜杜杜杜麦尼！您是不是有什么秘密任务？不方便透露身份？"
                },
                {
                    "id": "775040402",
                    "speaker": "「小松果」",
                    "text": "需要我们做什么吗？虽然我们本领不强，但您交待的任务，我们一定全力以赴！",
                    "choices": [
                        {
                            "id": "775040403",
                            "text": "任务是让大家一起变强。",
                            "response": [
                                {
                                    "id": "775040404",
                                    "speaker": "「燃爆木头人」",
                                    "text": "那那那，我们已经开始锻炼了，不会让您失望的！"
                                },
                                {
                                    "id": "775040405",
                                    "speaker": "「小松果」",
                                    "text": "琪琪科娃姐姐让我们用留影机观察各种小动物，我们就去找猎人学习，不惊动它们…"
                                },
                                {
                                    "id": "775040406",
                                    "speaker": "「小松果」",
                                    "text": "这种本领，就是一些烟谜主勇士精通的「潜伏」吧？也可以用在竞技比赛里！"
                                },
                                {
                                    "id": "775040407",
                                    "speaker": "「燃爆木头人」",
                                    "text": "还有还有，对着手册到处转悠，路上都会碰到厚厚的积雪，还有厉害的风雪…"
                                },
                                {
                                    "id": "775040408",
                                    "speaker": "「燃爆木头人」",
                                    "text": "我们也要适应冷冷的环境，学会使用更多新鲜的冰雕！"
                                }
                            ]
                        },
                        {
                            "id": "775040409",
                            "text": "先说说你们的情况？",
                            "response": [
                                {
                                    "id": "775040410",
                                    "speaker": "「燃爆木头人」",
                                    "text": "啊，我们…我们是来远游锻炼的。"
                                },
                                {
                                    "id": "775040411",
                                    "speaker": "「燃爆木头人」",
                                    "text": "「小松果」的爸爸，也就是「塞提阿德的砂刃」阿姆鲁叔叔，教了我们很多战斗的本领。"
                                },
                                {
                                    "id": "775040412",
                                    "speaker": "「小松果」",
                                    "text": "但是因为常年在纳塔待着，不了解其他地方的战士，也不太像话。"
                                },
                                {
                                    "id": "775040413",
                                    "speaker": "「小松果」",
                                    "text": "所以，爸爸就给了我们一大笔旅费，让我们来至冬好好锻炼一番。",
                                    "choices": [
                                        {
                                            "id": "775040414",
                                            "text": "放你们两个小孩到国外玩吗…",
                                            "response": [
                                                {
                                                    "id": "775040416",
                                                    "speaker": "「燃爆木头人」",
                                                    "text": "我，我们都不小了哦，我已经十二岁了，「小松果」也十岁了！"
                                                },
                                                {
                                                    "id": "775040417",
                                                    "speaker": "「燃爆木头人」",
                                                    "text": "「沃陆之邦」的瓦雷莎姐姐在我们这么大的时候，好像都已经打败过几百只魔物了。"
                                                },
                                                {
                                                    "id": "775040418",
                                                    "speaker": "「燃爆木头人」",
                                                    "text": "再过几年，我们也该像基尼奇哥哥和阿乔领主那样，成为部族的正式战士。"
                                                },
                                                {
                                                    "id": "775040419",
                                                    "speaker": "「燃爆木头人」",
                                                    "text": "这回只是出国锻炼一下，跟着琪琪科娃姐姐，找了几只大白熊练了练拳击和摔跤而已。"
                                                },
                                                {
                                                    "id": "775040420",
                                                    "speaker": "「燃爆木头人」",
                                                    "text": "完全没有招惹厉害的家伙，不会有事的！"
                                                },
                                                {
                                                    "id": "775040421",
                                                    "speaker": "「小松果」",
                                                    "text": "爸爸说过，老是待在安逸的环境里，人会变呆变慢。"
                                                },
                                                {
                                                    "id": "775040422",
                                                    "speaker": "「小松果」",
                                                    "text": "大喜儿姐姐也说，璃月人都抱着一种，怎么说的来着…那种心态，在努力锻炼。"
                                                },
                                                {
                                                    "id": "775040423",
                                                    "speaker": "「燃爆木头人」",
                                                    "text": "…居安思危？"
                                                },
                                                {
                                                    "id": "775040424",
                                                    "speaker": "「小松果」",
                                                    "text": "对的对的，居安思危！"
                                                },
                                                {
                                                    "id": "775040425",
                                                    "speaker": "「小松果」",
                                                    "text": "随时做好坏家伙还会冒出来的准备，全力锻炼，碰见不妙的情况，就不会慌张。"
                                                },
                                                {
                                                    "id": "775040426",
                                                    "speaker": "「小松果」",
                                                    "text": "等到下次，纳塔需要更多战士的时候，我和木头人都要站出来帮忙！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775040415",
                                            "text": "这么看来，你爸也是真心大…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775040427",
                            "text": "没事，不打扰你们玩啦。",
                            "response": [
                                {
                                    "id": "775040428",
                                    "speaker": "「燃爆木头人」",
                                    "text": "我我我，其实我还蛮想被杜麦尼打扰的…"
                                },
                                {
                                    "id": "775040429",
                                    "speaker": "「小松果」",
                                    "text": "感觉…杜麦尼还有事？等你不那么忙了，请和我们一起玩吧！几分钟也好！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7750407",
            "initDialog": "775040701",
            "dialogues": [
                {
                    "id": "775040701",
                    "speaker": "大喜儿",
                    "text": "你好啊，荣誉骑士杜麦尼，没想到还能在这里碰见你。",
                    "choices": [
                        {
                            "id": "775040702",
                            "text": "你这是在干什么？",
                            "response": [
                                {
                                    "id": "775040703",
                                    "speaker": "大喜儿",
                                    "text": "「运气御寒」。"
                                },
                                {
                                    "id": "775040704",
                                    "speaker": "大喜儿",
                                    "text": "通俗地讲，是在磨练自己的意志——"
                                },
                                {
                                    "id": "775040705",
                                    "speaker": "大喜儿",
                                    "text": "只穿单薄的布衣，适应极寒环境，是传统武学的一门经典本领，我快初具神功了！"
                                },
                                {
                                    "id": "775040706",
                                    "speaker": "大喜儿",
                                    "text": "不过，比起当年的霍大师，还是差了不少火候…",
                                    "choices": [
                                        {
                                            "id": "775040707",
                                            "text": "霍大师…是谁？",
                                            "response": [
                                                {
                                                    "id": "775040709",
                                                    "speaker": "大喜儿",
                                                    "text": "我也只是从师父那里听说过他的威名啦。"
                                                },
                                                {
                                                    "id": "775040710",
                                                    "speaker": "大喜儿",
                                                    "text": "他既是一名剑术大师，又懂得锻造兵刃。"
                                                },
                                                {
                                                    "id": "775040711",
                                                    "speaker": "大喜儿",
                                                    "text": "霍大师凭借那柄名为「藏锋」的宝剑，斩除妖邪，在江湖上留下了不少佳话。"
                                                },
                                                {
                                                    "id": "775040712",
                                                    "speaker": "大喜儿",
                                                    "text": "可最近坊间有人在复盘，说：随着名望增长，霍大师意识到自己变得心浮气躁，开始寻找幽冷的避世之地。"
                                                },
                                                {
                                                    "id": "775040713",
                                                    "speaker": "大喜儿",
                                                    "text": "于是他向着提瓦特的北域不断挺进，最终消失在至冬呼啸的风雪之中…",
                                                    "choices": [
                                                        {
                                                            "id": "775040714",
                                                            "text": "听起来挺玄乎的。",
                                                            "response": [
                                                                {
                                                                    "id": "775040716",
                                                                    "speaker": "大喜儿",
                                                                    "text": "话又说回来了，前两周，霍大师的妹妹出来澄清，她觉得这则故事被添油加醋得太夸张，让人别再谣传。"
                                                                },
                                                                {
                                                                    "id": "775040717",
                                                                    "speaker": "大喜儿",
                                                                    "text": "考虑到十年前，我的师父成了她的手下败将，她最近也要来至冬，我就不多嘴啦。"
                                                                },
                                                                {
                                                                    "id": "775040718",
                                                                    "speaker": "大喜儿",
                                                                    "text": "沉下心来习武，不断提升自我，才是正道…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "775040715",
                                                            "text": "宝剑的名字有点耳熟。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775040708",
                                            "text": "没见过这位高手。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775040719",
                            "text": "你像是璃月人，怎么这么叫我？",
                            "response": [
                                {
                                    "id": "775040720",
                                    "speaker": "大喜儿",
                                    "text": "我妹妹在蒙德待了很多年嘛，每次和我们团聚的时候，都会给我们讲蒙德美食和骑士团的故事。"
                                },
                                {
                                    "id": "775040721",
                                    "speaker": "大喜儿",
                                    "text": "之前参加龙脊雪山国际越野赛的时候，也远远看到了你，不过，你应该完全没注意到我。"
                                },
                                {
                                    "id": "775040722",
                                    "speaker": "大喜儿",
                                    "text": "后来，我买了几车「邦邦滚石」的水果和颗粒果，被她邀请到纳塔玩，又听了一圈关于你的传说。"
                                },
                                {
                                    "id": "775040723",
                                    "speaker": "大喜儿",
                                    "text": "两个威风的称号合在一起，听起来不就格外厉害了吗？这才配得上你传说级的江湖高手身份。",
                                    "choices": [
                                        {
                                            "id": "775040724",
                                            "text": "那你没告诉琪琪科娃吗？",
                                            "response": [
                                                {
                                                    "id": "775040726",
                                                    "speaker": "大喜儿",
                                                    "text": "哎呀，亲眼见证江湖高手的厉害之处，可比从别人那里听说要有趣。"
                                                },
                                                {
                                                    "id": "775040727",
                                                    "speaker": "大喜儿",
                                                    "text": "况且琪琪科娃也未必知道外地的传说，有时，就连到过某个国家的游客都会错漏一些情报。"
                                                },
                                                {
                                                    "id": "775040728",
                                                    "speaker": "大喜儿",
                                                    "text": "比如，您听过我师父「飞叶斩鬼·黄衫」的事迹吗？",
                                                    "choices": [
                                                        {
                                                            "id": "775040729",
                                                            "text": "还真没听过…谁来着？",
                                                            "response": [
                                                                {
                                                                    "id": "775040731",
                                                                    "speaker": "大喜儿",
                                                                    "text": "所以嘛，提瓦特这么大，到处都有高手，想认全很难的啦。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "775040730",
                                                            "text": "听说过，但没什么实感…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "775040725",
                                            "text": "你在配合我低调行事哦？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "775040732",
                            "text": "下次再聊！",
                            "response": [
                                {
                                    "id": "775040733",
                                    "speaker": "大喜儿",
                                    "text": "你且慢走，我继续运功了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7750502",
            "initDialog": "775050201",
            "dialogues": [
                {
                    "id": "775050201",
                    "speaker": "琪琪科娃",
                    "text": "接下来，你们都有什么打算？"
                },
                {
                    "id": "775050202",
                    "speaker": "大喜儿",
                    "text": "听说东南方向有座很大的雪山，那里的环境相当恶劣，不同凡响，我想去挑战一下自己…"
                },
                {
                    "id": "775050203",
                    "speaker": "「燃爆木头人」&「小松果」",
                    "text": "我们也一起！"
                },
                {
                    "id": "775050204",
                    "speaker": "琪琪科娃",
                    "text": "好呀，不过那边我不太熟，村里的大人们也叮嘱过，千万不要随意靠近。"
                },
                {
                    "id": "775050205",
                    "speaker": "琪琪科娃",
                    "text": "远远参观一圈，就要回来了喔？"
                }
            ]
        }
    ]
}