{
    "groupId": "5324",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Player": 9,
        "枫原万叶": 13,
        "泽西切": 22
    },
    "talks": [
        {
            "talkId": "7651105",
            "initDialog": "765110501",
            "dialogues": [
                {
                    "id": "765110501",
                    "speaker": "泽西切",
                    "text": "你好，最终试炼人，现在就和选手们过两招吗？",
                    "choices": [
                        {
                            "id": "765110502",
                            "text": "战斗吧。",
                            "response": [
                                {
                                    "id": "765110503",
                                    "speaker": "泽西切",
                                    "text": "好的，那请随我乘船前往赛场。"
                                }
                            ]
                        },
                        {
                            "id": "765110504",
                            "text": "我们之前是不是见过？",
                            "response": [
                                {
                                    "id": "765110505",
                                    "speaker": "泽西切",
                                    "text": "你还记得啊，记性真好。"
                                },
                                {
                                    "id": "765110506",
                                    "speaker": "泽西切",
                                    "text": "在执灯人的办事处，调查异常案件的那次，我被奈芙尔女士叫来，办了个手续。"
                                },
                                {
                                    "id": "765110507",
                                    "speaker": "泽西切",
                                    "text": "感谢你为索西军士长所做的一切。"
                                }
                            ]
                        },
                        {
                            "id": "765110508",
                            "text": "原来执灯士也会当评委？",
                            "response": [
                                {
                                    "id": "765110509",
                                    "speaker": "泽西切",
                                    "text": "你是奈芙尔女士的合作伙伴，那就不瞒着你了。"
                                },
                                {
                                    "id": "765110510",
                                    "speaker": "泽西切",
                                    "text": "这次大赛原本和「执灯人」无关，我们一般不会参与这种活动。"
                                },
                                {
                                    "id": "765110511",
                                    "speaker": "泽西切",
                                    "text": "不过，为了提高「执灯人」的战备水平，我们有必要准确评估各方人士的战力。"
                                },
                                {
                                    "id": "765110512",
                                    "speaker": "泽西切",
                                    "text": "于我个人，情报也多多益善。"
                                },
                                {
                                    "id": "765110513",
                                    "speaker": "泽西切",
                                    "text": "所以我就答应了萨林，代他主持这次比赛。"
                                },
                                {
                                    "id": "765110514",
                                    "speaker": "泽西切",
                                    "text": "从结果而言，的确见识到了不少能人异士。不过在你来之前，他们因为遭到最后这三位高手淘汰，基本都离场了。"
                                },
                                {
                                    "id": "765110515",
                                    "speaker": "泽西切",
                                    "text": "其实，我很好奇枫原先生认真出手时的效果。"
                                },
                                {
                                    "id": "765110516",
                                    "speaker": "泽西切",
                                    "text": "三位冠军候选人已经是顶尖高手了，在我个人看来，挪德卡莱本地只有奈芙尔女士、菲林斯、叶洛亚长官和雅珂达在他们之上。"
                                },
                                {
                                    "id": "765110517",
                                    "speaker": "泽西切",
                                    "text": "但枫原先生彬彬有礼，举止随和，总给我一种深不可测的感觉。"
                                },
                                {
                                    "id": "765110518",
                                    "speaker": "泽西切",
                                    "text": "精彩到让我惊呼的比拼，他似乎早就司空见惯了，一直平静而客观地点评。"
                                },
                                {
                                    "id": "765110519",
                                    "speaker": "泽西切",
                                    "text": "当然，那种谦逊却又波澜不惊的态度，值得每位战士…或者文雅点，值得每位「武人」学习。",
                                    "choices": [
                                        {
                                            "id": "765110520",
                                            "text": "他是和我出生入死过的搭档哦。",
                                            "response": [
                                                {
                                                    "id": "765110521",
                                                    "speaker": "泽西切",
                                                    "text": "难怪，你们相处的感觉，就像是经历过血战的战友。"
                                                },
                                                {
                                                    "id": "765110522",
                                                    "speaker": "泽西切",
                                                    "text": "有资格和你并肩面对强敌…这个身份，的确令人肃然起敬。"
                                                },
                                                {
                                                    "id": "765110526",
                                                    "speaker": "泽西切",
                                                    "text": "这场比试结束后，我再以个人名义宴请枫原先生好了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765110523",
                                            "text": "他挡下过神明的一刀哦。",
                                            "response": [
                                                {
                                                    "id": "765110524",
                                                    "speaker": "泽西切",
                                                    "text": "…是某种比喻吗？这比方实在震撼人心。"
                                                },
                                                {
                                                    "id": "765110525",
                                                    "speaker": "泽西切",
                                                    "text": "连你都给出了这么高的评价，看来我之前还是失敬了…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765110527",
                            "text": "待会儿再来。",
                            "response": [
                                {
                                    "id": "765110528",
                                    "speaker": "泽西切",
                                    "text": "那你先忙，正好也给他们三位一点准备时间。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7651106",
            "initDialog": "765110601",
            "dialogues": [
                {
                    "id": "765110601",
                    "speaker": "枫原万叶",
                    "text": "近些日子，一切顺利吗？",
                    "choices": [
                        {
                            "id": "765110602",
                            "text": "劳累减轻了。",
                            "response": [
                                {
                                    "id": "765110603",
                                    "speaker": "枫原万叶",
                                    "text": "但我听说，你还是和往常一样，频频奔走在危险的前沿，向各界人士伸出援手。"
                                },
                                {
                                    "id": "765110604",
                                    "speaker": "枫原万叶",
                                    "text": "或许，你找到了诀窍，在平衡战斗与休憩的比值这件事上，已然得心应手了？"
                                },
                                {
                                    "id": "765110605",
                                    "speaker": "枫原万叶",
                                    "text": "若是如此，我也要向你请教其中的门道啊。"
                                }
                            ]
                        },
                        {
                            "id": "765110606",
                            "text": "万叶最近怎么样？",
                            "response": [
                                {
                                    "id": "765110607",
                                    "speaker": "枫原万叶",
                                    "text": "感谢关心，一切都好。"
                                },
                                {
                                    "id": "765110608",
                                    "speaker": "枫原万叶",
                                    "text": "大姐头推荐我来挪德卡莱，原本是让我领略不同以往的「自然」之声。"
                                },
                                {
                                    "id": "765110609",
                                    "speaker": "枫原万叶",
                                    "text": "我也顺带替平藏拜访了他的冒险家朋友，带了几件伴手礼。"
                                },
                                {
                                    "id": "765110610",
                                    "speaker": "枫原万叶",
                                    "text": "得知这次比拼后，我想，这是开阔眼界的好机会，便答应下来。"
                                },
                                {
                                    "id": "765110611",
                                    "speaker": "枫原万叶",
                                    "text": "毕竟，前路尚远，可不能疏于精进武艺。"
                                },
                                {
                                    "id": "765110612",
                                    "speaker": "枫原万叶",
                                    "text": "此地的愚人众并未与我发生过冲突，似乎还与你维持着某种合作关系。所以，我会以中立的态度对待他们。"
                                },
                                {
                                    "id": "765110613",
                                    "speaker": "枫原万叶",
                                    "text": "了解一下不同愚人众的战法，也是百利而无一弊。"
                                },
                                {
                                    "id": "765110614",
                                    "speaker": "枫原万叶",
                                    "text": "#这回要多多劳烦你了，{NICKNAME}，引导他们使出全部本领吧。"
                                }
                            ]
                        },
                        {
                            "id": "765110615",
                            "text": "待会儿再一起聊天，万叶。",
                            "response": [
                                {
                                    "id": "765110616",
                                    "speaker": "枫原万叶",
                                    "text": "嗯，不必心急，你先忙要紧的事。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}