{
    "groupId": "5116",
    "total_dialogue_lines": 96,
    "speaker_counts": {
        "Player": 27,
        "丽莎": 41,
        "加福尔": 9,
        "柯莱": 11,
        "阿米尔": 8
    },
    "talks": [
        {
            "talkId": "7350630",
            "initDialog": "735063001",
            "dialogues": [
                {
                    "id": "735063001",
                    "speaker": "丽莎",
                    "text": "小可爱，我们果然遇到了呢。"
                },
                {
                    "id": "735063002",
                    "speaker": "Player",
                    "text": "这里不太好找。"
                },
                {
                    "id": "735063003",
                    "speaker": "丽莎",
                    "text": "欸，有吗？不过须弥城毕竟是我曾经生活过的地方，故地重游，忍不住就想去各种偏僻的小店看看。"
                },
                {
                    "id": "735063004",
                    "speaker": "丽莎",
                    "text": "让人遗憾的是，有家我以前常去的成衣店居然已经倒闭很久了。"
                },
                {
                    "id": "735063005",
                    "speaker": "丽莎",
                    "text": "我本来还想多买些饰品和衣服，送给骑士团里的女孩子们的，嗯…有点可惜啊。",
                    "choices": [
                        {
                            "id": "735063006",
                            "text": "丽莎买了新衣服。",
                            "response": [
                                {
                                    "id": "735063008",
                                    "speaker": "丽莎",
                                    "text": "我还在想小可爱什么时候才会注意到这件新衣服呢，怎么样，你觉得好看吗？",
                                    "choices": [
                                        {
                                            "id": "735063009",
                                            "text": "很显气质。",
                                            "response": [
                                                {
                                                    "id": "735063011",
                                                    "speaker": "丽莎",
                                                    "text": "从别人嘴里听到称赞的话，果然让人开心，谢谢你哦，小可爱。"
                                                },
                                                {
                                                    "id": "735063012",
                                                    "speaker": "丽莎",
                                                    "text": "这件衣服是我找到了那家成衣店的店主，请她特别定制的。"
                                                },
                                                {
                                                    "id": "735063013",
                                                    "speaker": "丽莎",
                                                    "text": "穿上就想起了以前在教令院的时光，那时候可真是忙碌呀…"
                                                },
                                                {
                                                    "id": "735063014",
                                                    "speaker": "丽莎",
                                                    "text": "不过我手下的研究人员也从来不敢偷懒，不像某些借书不还的家伙，只用雷元素力来惩罚他们是不是太宽容了呢…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "735063010",
                                            "text": "风格优雅。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "735063007",
                            "text": "丽莎的新衣服很漂亮。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7350631",
            "initDialog": "735063101",
            "dialogues": [
                {
                    "id": "735063101",
                    "speaker": "丽莎",
                    "text": "小可爱，我们又遇到了呀。"
                },
                {
                    "id": "735063102",
                    "speaker": "Player",
                    "text": "丽莎在看什么？"
                },
                {
                    "id": "735063103",
                    "speaker": "丽莎",
                    "text": "这家店的彩绘器皿做得非常精致，买几个放回去做装饰应该不错。"
                },
                {
                    "id": "735063104",
                    "speaker": "丽莎",
                    "text": "还有那几个盘子，如果用它们来盛装茶点，就算是在工作的琴应该也会被吸引吧。",
                    "choices": [
                        {
                            "id": "735063105",
                            "text": "这些好像都不出售。",
                            "response": [
                                {
                                    "id": "735063107",
                                    "speaker": "丽莎",
                                    "text": "不出售吗？哎呀，真是的，既然不出售，干嘛放在店里呢。"
                                },
                                {
                                    "id": "735063108",
                                    "speaker": "丽莎",
                                    "text": "真让人失望，明明都这么漂亮…"
                                }
                            ]
                        },
                        {
                            "id": "735063106",
                            "text": "只是展示用的。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7350632",
            "initDialog": "735063201",
            "dialogues": [
                {
                    "id": "735063201",
                    "speaker": "丽莎",
                    "text": "小可爱，你也是来大巴扎看演出的吗？"
                },
                {
                    "id": "735063202",
                    "speaker": "Player",
                    "text": "丽莎喜欢吗？"
                },
                {
                    "id": "735063203",
                    "speaker": "丽莎",
                    "text": "嗯，这里的演出节目挺有趣的。我甚至在想，要不要把某些节目的形式记下来，下次羽球节或许用得上。"
                },
                {
                    "id": "735063204",
                    "speaker": "丽莎",
                    "text": "说笑话之类的还好办，可以让凯亚来，但是跳舞的话，有点困难呢。"
                },
                {
                    "id": "735063205",
                    "speaker": "Player",
                    "text": "丽莎看过这里的舞蹈吗？"
                },
                {
                    "id": "735063206",
                    "speaker": "丽莎",
                    "text": "昨天有个可爱的红头发女孩子跳了一场舞，我就在前排哦，真是漂亮呀。"
                },
                {
                    "id": "735063207",
                    "speaker": "丽莎",
                    "text": "忍不住就想，要是能在蒙德看同样的舞蹈就好了。",
                    "choices": [
                        {
                            "id": "735063208",
                            "text": "得说服妮露去蒙德演出。",
                            "response": [
                                {
                                    "id": "735063210",
                                    "speaker": "丽莎",
                                    "text": "其实我觉得难点在于，怎么让游击小队队长优菈对须弥舞蹈产生兴趣，而且还得找到既美丽又能让她接受的服装。"
                                },
                                {
                                    "id": "735063211",
                                    "speaker": "Player",
                                    "text": "居然在打优菈的主意吗？"
                                },
                                {
                                    "id": "735063212",
                                    "speaker": "丽莎",
                                    "text": "优菈在有的方面意外地单纯，比起请演员去蒙德，我觉得诱骗…啊不，「请」她跳舞要容易得多。"
                                }
                            ]
                        },
                        {
                            "id": "735063209",
                            "text": "那有点困难。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7350633",
            "initDialog": "735063301",
            "dialogues": [
                {
                    "id": "735063301",
                    "speaker": "丽莎",
                    "text": "咦，怎么在教令院附近见到你了？",
                    "choices": [
                        {
                            "id": "735063302",
                            "text": "丽莎不进教令院吗？",
                            "response": [
                                {
                                    "id": "735063303",
                                    "speaker": "丽莎",
                                    "text": "其实我刚从大门出来不久。"
                                },
                                {
                                    "id": "735063306",
                                    "speaker": "丽莎",
                                    "text": "居勒什老师还有几位师兄，以前共事过的另外几位研究员，大家聚在一起又见了一次。"
                                },
                                {
                                    "id": "735063307",
                                    "speaker": "丽莎",
                                    "text": "时间过得真快啊，看大家的样子能感觉到他们都忙得不得了呢。"
                                },
                                {
                                    "id": "735063308",
                                    "speaker": "丽莎",
                                    "text": "我的确是松散了一点。呵呵…他们一定很羡慕吧。"
                                },
                                {
                                    "id": "735063309",
                                    "speaker": "丽莎",
                                    "text": "话虽这么说，下个月还是少吃点蛋糕吧，得提防长胖呢。"
                                }
                            ]
                        },
                        {
                            "id": "735063304",
                            "text": "丽莎刚离开教令院吗？",
                            "response": [
                                {
                                    "id": "735063305",
                                    "speaker": "丽莎",
                                    "text": "是呀，刚走到这里就遇到你了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7350634",
            "initDialog": "735063401",
            "dialogues": [
                {
                    "id": "735063401",
                    "speaker": "丽莎",
                    "text": "是叫作萨古吗，好乖巧的小狗。"
                },
                {
                    "id": "735063402",
                    "speaker": "Player",
                    "text": "丽莎喜欢搜救犬吗？"
                },
                {
                    "id": "735063403",
                    "speaker": "丽莎",
                    "text": "听话的小狗我当然喜欢，特别是那种会露出肚皮给你抚摸，用湿漉漉的眼睛看着你的小狗。"
                },
                {
                    "id": "735063404",
                    "speaker": "丽莎",
                    "text": "其实我一直想养一条狗，它不仅能够用可爱治愈我一天的心情，有时还能起到震慑作用。"
                },
                {
                    "id": "735063405",
                    "speaker": "丽莎",
                    "text": "不过养狗的话，要定期给它梳理毛发，清扫粪便，未免太麻烦了。"
                },
                {
                    "id": "735063406",
                    "speaker": "丽莎",
                    "text": "养宠物就是这点麻烦，我果然不适合养宠物。"
                }
            ]
        },
        {
            "talkId": "7350635",
            "initDialog": "735063501",
            "dialogues": [
                {
                    "id": "735063501",
                    "speaker": "Player",
                    "text": "关于你身旁的女士…"
                },
                {
                    "id": "735063502",
                    "speaker": "阿米尔",
                    "text": "哎呀，你小点声。你是说那位女士的名字是丽莎吗？"
                },
                {
                    "id": "735063503",
                    "speaker": "阿米尔",
                    "text": "丽莎…丽莎，真是美丽又优雅的名字。"
                },
                {
                    "id": "735063504",
                    "speaker": "阿米尔",
                    "text": "可惜你没看到，刚才她和我说话了，问了萨古的名字，嘿嘿…"
                },
                {
                    "id": "735063505",
                    "speaker": "阿米尔",
                    "text": "看样子，她也是对动物怀有爱心的人。不过，她好像不太懂得该怎么跟动物打交道。"
                },
                {
                    "id": "735063506",
                    "speaker": "阿米尔",
                    "text": "这点从她刚才抚摸萨古的样子就看得出来，不过没关系，我可以教她。"
                },
                {
                    "id": "735063507",
                    "speaker": "阿米尔",
                    "text": "我们可以一起养很多条狗，一起…"
                },
                {
                    "id": "735063508",
                    "speaker": "阿米尔",
                    "text": "……"
                },
                {
                    "id": "735063509",
                    "speaker": "阿米尔",
                    "text": "（沉浸在幻想中自言自语）"
                }
            ]
        },
        {
            "talkId": "7350636",
            "initDialog": "735063601",
            "dialogues": [
                {
                    "id": "735063601",
                    "speaker": "柯莱",
                    "text": "放心吧，丽莎小姐，我现在很好。"
                },
                {
                    "id": "735063602",
                    "speaker": "Player",
                    "text": "你们好。"
                },
                {
                    "id": "735063603",
                    "speaker": "柯莱",
                    "text": "#是{NICKNAME}！你怎么来这儿啦。",
                    "choices": [
                        {
                            "id": "735063604",
                            "text": "来看看柯莱。",
                            "response": [
                                {
                                    "id": "735063606",
                                    "speaker": "丽莎",
                                    "text": "小可爱经常来探望小柯莱吗？"
                                },
                                {
                                    "id": "735063607",
                                    "speaker": "柯莱",
                                    "text": "#{NICKNAME}{M#他}{F#她}非常热心，之前在化城郭帮了我们不少忙呢。"
                                },
                                {
                                    "id": "735063608",
                                    "speaker": "Player",
                                    "text": "我和柯莱是很好的朋友。"
                                },
                                {
                                    "id": "735063609",
                                    "speaker": "丽莎",
                                    "text": "看样子，小柯莱在须弥认识了不少新朋友呢。"
                                },
                                {
                                    "id": "735063610",
                                    "speaker": "柯莱",
                                    "text": "而且我也有努力认字，现在我已经能读一些简单的句子了！"
                                },
                                {
                                    "id": "735063611",
                                    "speaker": "柯莱",
                                    "text": "师父和须弥的大家都很关照我，不过我从来没有忘记蒙德的朋友们，最近我一直想找个时间回去探望一次。"
                                },
                                {
                                    "id": "735063612",
                                    "speaker": "柯莱",
                                    "text": "丽莎小姐，大家怎么样？都还好吗？安柏好吗？凯亚先生好吗？琴小姐…"
                                },
                                {
                                    "id": "735063613",
                                    "speaker": "丽莎",
                                    "text": "哈哈，小柯莱不要着急哦，等我慢慢跟你说…"
                                },
                                {
                                    "id": "735063614",
                                    "speaker": "丽莎",
                                    "text": "抱歉，小可爱，给我一点时间，让我和小柯莱好好说说蒙德的事吧。"
                                }
                            ]
                        },
                        {
                            "id": "735063605",
                            "text": "居然又遇到了丽莎。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7350637",
            "initDialog": "735063701",
            "dialogues": [
                {
                    "id": "735063701",
                    "speaker": "柯莱",
                    "text": "放心吧，丽莎小姐，我现在很好。",
                    "choices": [
                        {
                            "id": "735063702",
                            "text": "你们好。",
                            "response": [
                                {
                                    "id": "735063704",
                                    "speaker": "丽莎",
                                    "text": "我来这里是想探望一位以前的朋友，但没想到她已经在这里当上了见习巡林员呀。"
                                },
                                {
                                    "id": "735063705",
                                    "speaker": "柯莱",
                                    "text": "嘿嘿，这其实没什么，我只是想帮上提纳里师父的忙。"
                                },
                                {
                                    "id": "735063706",
                                    "speaker": "丽莎",
                                    "text": "看样子，小柯莱在须弥认识了不少新朋友呢。"
                                },
                                {
                                    "id": "735063707",
                                    "speaker": "柯莱",
                                    "text": "而且我也有努力认字，现在我已经能读一些简单的句子了！"
                                },
                                {
                                    "id": "735063708",
                                    "speaker": "柯莱",
                                    "text": "师父和须弥的大家都很关照我，不过我从来没有忘记蒙德的朋友们，最近我一直想找个时间回去探望一次。"
                                },
                                {
                                    "id": "735063709",
                                    "speaker": "柯莱",
                                    "text": "丽莎小姐，大家怎么样？都还好吗？安柏好吗？琴小姐好吗？凯亚先生…"
                                },
                                {
                                    "id": "735063710",
                                    "speaker": "丽莎",
                                    "text": "哈哈，小柯莱不要着急哦，等我慢慢跟你说…"
                                },
                                {
                                    "id": "735063711",
                                    "speaker": "丽莎",
                                    "text": "抱歉，小可爱，给我一点时间，让我和小柯莱好好说说蒙德的事吧。"
                                }
                            ]
                        },
                        {
                            "id": "735063703",
                            "text": "居然又遇到了丽莎。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7350640",
            "initDialog": "735064001",
            "dialogues": [
                {
                    "id": "735064001",
                    "speaker": "加福尔",
                    "text": "倒是多派点人手啊，就这么点人根本处理不过来。算了，能处理多少是多少吧。",
                    "choices": [
                        {
                            "id": "735064002",
                            "text": "关于丽莎…",
                            "response": [
                                {
                                    "id": "735064003",
                                    "speaker": "加福尔",
                                    "text": "所以你们是在蒙德和丽莎认识的？她真的普普通通地在当图书管理员？"
                                },
                                {
                                    "id": "735064004",
                                    "speaker": "Player",
                                    "text": "是的，有什么问题吗？"
                                },
                                {
                                    "id": "735064005",
                                    "speaker": "加福尔",
                                    "text": "真是没想到，蒙德有什么吸引她的，值得这样浪费自己的才华。"
                                },
                                {
                                    "id": "735064006",
                                    "speaker": "加福尔",
                                    "text": "…好吧，我知道你是丽莎的朋友，我不会再找她说那件事了，你就别瞪我了。"
                                },
                                {
                                    "id": "735064007",
                                    "speaker": "加福尔",
                                    "text": "我也是好心给她提供机会，她不愿意就算了。"
                                }
                            ]
                        },
                        {
                            "id": "735064008",
                            "text": "关于素论派…",
                            "response": [
                                {
                                    "id": "735064009",
                                    "speaker": "加福尔",
                                    "text": "是啊，我们学院需要定期监测地脉运行情况，这是学院的研究基础之一。"
                                },
                                {
                                    "id": "735064010",
                                    "speaker": "加福尔",
                                    "text": "又有专业素养，又能独立承担秘境内地脉探索工作的人才实在不够，早就说了要多拨点人过来…"
                                },
                                {
                                    "id": "735064011",
                                    "speaker": "加福尔",
                                    "text": "找不到专业学者过来，我也只能招募志愿者了，唉。"
                                }
                            ]
                        },
                        {
                            "id": "735064012",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "735064013",
                                    "speaker": "加福尔",
                                    "text": "这处秘境的探索清理工作就交给你了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}