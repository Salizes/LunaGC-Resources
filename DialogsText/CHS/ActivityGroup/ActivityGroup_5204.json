{
    "groupId": "5204",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "方妮雅": 6,
        "派蒙": 4,
        "艾玛托": 6
    },
    "talks": [
        {
            "talkId": "7054604",
            "initDialog": "705460401",
            "dialogues": [
                {
                    "id": "705460401",
                    "speaker": "艾玛托",
                    "text": "追随火花！爆炸不止！荣誉骑士大人和白色小帮手，「嘟嘟可砰砰历险记」玩得还开心吗？有什么疑问，艾玛托随时为您解答！",
                    "choices": [
                        {
                            "id": "705460404",
                            "text": "聊聊这次嘟嘟可的冒险故事？",
                            "response": [
                                {
                                    "id": "705460405",
                                    "speaker": "艾玛托",
                                    "text": "好呀！丽莎小姐把续作交给我时，提供了很多故事情节…"
                                },
                                {
                                    "id": "705460406",
                                    "speaker": "艾玛托",
                                    "text": "「很坏很坏的角角鱼大王，在被嘟嘟可赶跑后，灰溜溜地回到了老巢…」"
                                },
                                {
                                    "id": "705460407",
                                    "speaker": "艾玛托",
                                    "text": "「角角鱼先锋说：大王！我们何不把角角鱼长老、角角鱼卫士、角角鱼清道夫，都纠集到一起，再次反攻呢？」"
                                },
                                {
                                    "id": "705460408",
                                    "speaker": "艾玛托",
                                    "text": "不过，后面的故事，还是荣誉骑士自己体验比较好！不然，就没有惊喜感了！"
                                },
                                {
                                    "id": "705460409",
                                    "speaker": "Player",
                                    "text": "紧张起来了，加油啊！嘟嘟可！"
                                },
                                {
                                    "id": "705460410",
                                    "speaker": "派蒙",
                                    "text": "加油啊！嘟嘟可！"
                                }
                            ]
                        },
                        {
                            "id": "705460411",
                            "text": "休息一会儿，下次再来！",
                            "response": [
                                {
                                    "id": "705460412",
                                    "speaker": "艾玛托",
                                    "text": "没问题！艾玛托一直在这里，等待荣誉骑士的命令！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7054605",
            "initDialog": "705460501",
            "dialogues": [
                {
                    "id": "705460501",
                    "speaker": "方妮雅",
                    "text": "您好，荣誉骑士与白色小帮手，虽说现在不是执勤时间，为了艾玛托的个人任务，我还不能回家。",
                    "choices": [
                        {
                            "id": "705460502",
                            "text": "个人任务？",
                            "response": [
                                {
                                    "id": "705460503",
                                    "speaker": "方妮雅",
                                    "text": "也就是如实记录荣誉骑士试玩「嘟嘟可砰砰历险记」的经历，艾玛托担心自己的记录不够周全，想让我也记录一份作为补充。"
                                },
                                {
                                    "id": "705460504",
                                    "speaker": "派蒙",
                                    "text": "哇！你们的感情真好！"
                                },
                                {
                                    "id": "705460505",
                                    "speaker": "方妮雅",
                                    "text": "我只是用这种付出的方式，静静地提醒她，下次再想对我恶作剧的时候，要怀有内疚之心。"
                                },
                                {
                                    "id": "705460506",
                                    "speaker": "派蒙",
                                    "text": "虽然不确定艾玛托会不会真的怀有内疚之心，不过，这也是她们之间相处的一种趣味吧！"
                                }
                            ]
                        },
                        {
                            "id": "705460507",
                            "text": "方妮雅还是这么严肃呢。",
                            "response": [
                                {
                                    "id": "705460508",
                                    "speaker": "方妮雅",
                                    "text": "这算严肃吗？常有人说我的回答总是太过标准，以至于有些缺乏趣味…"
                                },
                                {
                                    "id": "705460509",
                                    "speaker": "方妮雅",
                                    "text": "但是，我的诉求就是，节省不必要的沟通，赶快让我回归安静。"
                                },
                                {
                                    "id": "705460510",
                                    "speaker": "派蒙",
                                    "text": "#呜哇，{NICKNAME}，我们还是快走吧…"
                                }
                            ]
                        },
                        {
                            "id": "705460511",
                            "text": "辛苦了！",
                            "response": [
                                {
                                    "id": "705460512",
                                    "speaker": "方妮雅",
                                    "text": "谢谢长官，祝你们玩得开心，等记录结束，我这枚普通的「齿轮」就会顺其自然地离开了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}