{
    "groupId": "5123",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "阿纳托尔": 8
    },
    "talks": [
        {
            "talkId": "7368902",
            "initDialog": "736890201",
            "dialogues": [
                {
                    "id": "736890201",
                    "speaker": "阿纳托尔",
                    "text": "实验场所准备好了，拿着这份实验用说明手册吧，这个还是帕特里克留下来的…",
                    "choices": [
                        {
                            "id": "736890202",
                            "text": "关于枫丹科学院…",
                            "response": [
                                {
                                    "id": "736890203",
                                    "speaker": "阿纳托尔",
                                    "text": "科学院是由阿兰·吉约丹创立的研究所，全称是「枫丹动能工程科学研究院」。比之须弥的教令院，是性质大相径庭的机构。"
                                },
                                {
                                    "id": "736890204",
                                    "speaker": "阿纳托尔",
                                    "text": "我们没有对枫丹人进行行政管理的冗余责任，也不承担教育义务。从全名也能看出，我们研究的方向更为集中。"
                                },
                                {
                                    "id": "736890205",
                                    "speaker": "阿纳托尔",
                                    "text": "这么说吧，科学院的创立造就了枫丹。被誉为天才的吉约丹最初设计的一些发条机关与动能核心，如今还有许多工坊在制作呢。"
                                },
                                {
                                    "id": "736890206",
                                    "speaker": "阿纳托尔",
                                    "text": "哈哈，不过凡事都会有变质的那一天就是了。"
                                },
                                {
                                    "id": "736890211",
                                    "speaker": "阿纳托尔",
                                    "text": "总之，帕特里克能不能摆脱窘境，就看这次实验的啦！"
                                }
                            ]
                        },
                        {
                            "id": "736890207",
                            "text": "关于「爆炸」…",
                            "response": [
                                {
                                    "id": "736890208",
                                    "speaker": "阿纳托尔",
                                    "text": "当时我不在枫丹，并没有第一手消息。似乎是为了应对水位线的危机，高阶技官艾德温·伊斯丁豪斯运用始基矿进行了一场实验。"
                                },
                                {
                                    "id": "736890209",
                                    "speaker": "阿纳托尔",
                                    "text": "…总之结果很惨烈，实验事故已经让科学院变成枫丹著名地标了哦。伊斯丁豪斯似乎到现在还没有找齐…我是说，找到。"
                                }
                            ]
                        },
                        {
                            "id": "736890210",
                            "text": "嗯，待会儿就开始吧。"
                        }
                    ]
                }
            ]
        }
    ]
}