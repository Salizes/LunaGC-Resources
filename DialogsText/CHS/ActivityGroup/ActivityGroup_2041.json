{
    "groupId": "2041",
    "total_dialogue_lines": 76,
    "speaker_counts": {
        "Player": 18,
        "加希菈": 17,
        "普萨科": 13,
        "胡伊鲁": 13,
        "阿维苏菈": 15
    },
    "talks": [
        {
            "talkId": "7566301",
            "initDialog": "756630101",
            "dialogues": [
                {
                    "id": "756630101",
                    "speaker": "加希菈",
                    "text": "#哦呀？这不是{NICKNAME}吗？欢迎，有兴趣的话，来打两枪玩玩？"
                },
                {
                    "id": "756630102",
                    "speaker": "Player",
                    "text": "你是「花羽会」的成员？"
                },
                {
                    "id": "756630103",
                    "speaker": "加希菈",
                    "text": "没错。我之前曾经在「花羽会」里担任射击术教官，训练大家的空中射击技术。"
                },
                {
                    "id": "756630104",
                    "speaker": "加希菈",
                    "text": "在我教导过的那批学生里，有不少人都在战场上立下了赫赫战功。"
                },
                {
                    "id": "756630105",
                    "speaker": "加希菈",
                    "text": "不过…能够回到我身边的，也只有他们的赫赫战功了。"
                },
                {
                    "id": "756630106",
                    "speaker": "加希菈",
                    "text": "我之前也想要投身战场，和我的学生们并肩作战。但却被部族里的人拦住了…"
                },
                {
                    "id": "756630107",
                    "speaker": "加希菈",
                    "text": "他们说，我教导射击的能力比我的射击术本身更加宝贵，为了部族，我必须留下。"
                },
                {
                    "id": "756630108",
                    "speaker": "加希菈",
                    "text": "我服从了命令，继续研究训练射击术的方式，直到现在。"
                },
                {
                    "id": "756630109",
                    "speaker": "Player",
                    "text": "所以，你来这里也是为了研究这个？"
                },
                {
                    "id": "756630110",
                    "speaker": "加希菈",
                    "text": "呃…算是吧。准确来说，我来这里主要是为了研究…如何让孩子对射击术感兴趣。"
                },
                {
                    "id": "756630111",
                    "speaker": "加希菈",
                    "text": "普通的射击术训练很困难，也十分枯燥，战士们当然能够靠自己的毅力耐住性子训练…"
                },
                {
                    "id": "756630112",
                    "speaker": "加希菈",
                    "text": "但孩子们…正好处于爱玩的年纪，只怕是没有那么多耐心的。要是受的挫折多了，说不定反而会对射击术产生反感。"
                },
                {
                    "id": "756630113",
                    "speaker": "加希菈",
                    "text": "于是，我就想要研究出一套既有趣，也能让孩子们学习到基本射击术技巧的训练方式。"
                },
                {
                    "id": "756630114",
                    "speaker": "加希菈",
                    "text": "喏，这就是我的「研究成果」了。保证既有趣，又刺激，还十分安全。",
                    "choices": [
                        {
                            "id": "756630115",
                            "text": "给孩子们玩的啊…",
                            "response": [
                                {
                                    "id": "756630117",
                                    "speaker": "加希菈",
                                    "text": "哈哈哈哈哈，没关系，如果你需要的话，我可以再为你布设一套更加困难的挑战。"
                                },
                                {
                                    "id": "756630118",
                                    "speaker": "加希菈",
                                    "text": "来，站上台子，拿好射击器具，我保证一定让你尽兴而归。"
                                }
                            ]
                        },
                        {
                            "id": "756630116",
                            "text": "总觉得难度有点低…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7566302",
            "initDialog": "756630201",
            "dialogues": [
                {
                    "id": "756630201",
                    "speaker": "加希菈",
                    "text": "#怎么样，{NICKNAME}？想来玩两局射击吗？",
                    "choices": [
                        {
                            "id": "756630202",
                            "text": "想要试试…",
                            "response": [
                                {
                                    "id": "756630203",
                                    "speaker": "加希菈",
                                    "text": "没问题。站上台子，拿好射击器具，我保证一定让你尽兴而归。"
                                }
                            ]
                        },
                        {
                            "id": "756630204",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "756630205",
                                    "speaker": "加希菈",
                                    "text": "嗯，忙你的事去吧，想要试试的话，直接过来就好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7566601",
            "initDialog": "756660101",
            "dialogues": [
                {
                    "id": "756660101",
                    "speaker": "普萨科",
                    "text": "好嘞！这样就准备好了。不过…总感觉差点什么…"
                },
                {
                    "id": "756660102",
                    "speaker": "普萨科",
                    "text": "#{NICKNAME}！你来得正好，想不想痛痛快快地玩一场喷涂游戏？",
                    "choices": [
                        {
                            "id": "756660103",
                            "text": "喷涂游戏？",
                            "response": [
                                {
                                    "id": "756660105",
                                    "speaker": "普萨科",
                                    "text": "哈哈哈哈哈，别这么紧张嘛。真的就只是一场游戏而已。"
                                },
                                {
                                    "id": "756660106",
                                    "speaker": "普萨科",
                                    "text": "我保证，一点危险性都没有。最大的风险，也就是会把你衣服弄脏。"
                                },
                                {
                                    "id": "756660107",
                                    "speaker": "Player",
                                    "text": "我不是很擅长喷涂…"
                                },
                                {
                                    "id": "756660108",
                                    "speaker": "普萨科",
                                    "text": "放心放心，这场喷涂游戏由我亲自设计，不需要任何喷涂基础也能玩个开心。"
                                },
                                {
                                    "id": "756660109",
                                    "speaker": "普萨科",
                                    "text": "虽然我被拉过来的时候，是被要求做一个够大，够酷，够有气势的喷涂对象…"
                                },
                                {
                                    "id": "756660110",
                                    "speaker": "普萨科",
                                    "text": "不过嘛，从事实上来看，虽然我把那个够酷的喷涂对象造出来了，但并不是每一个人都能够把它喷好。"
                                },
                                {
                                    "id": "756660111",
                                    "speaker": "普萨科",
                                    "text": "所以，我就把它给简化了一下，把有趣的重点放在了喷涂的「过程」上。"
                                },
                                {
                                    "id": "756660112",
                                    "speaker": "普萨科",
                                    "text": "简单来说就是…呃，我也不知道怎么简单来说，但总之你玩玩就知道了。"
                                },
                                {
                                    "id": "756660113",
                                    "speaker": "普萨科",
                                    "text": "好了，说再多也不如自己亲手试试，上场上场！"
                                }
                            ]
                        },
                        {
                            "id": "756660104",
                            "text": "难道是什么战斗训练？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7566602",
            "initDialog": "756660201",
            "dialogues": [
                {
                    "id": "756660201",
                    "speaker": "普萨科",
                    "text": "好嘞！这样就摆好了，希望大家能涂得开心啊。",
                    "choices": [
                        {
                            "id": "756660202",
                            "text": "想玩！",
                            "response": [
                                {
                                    "id": "756660203",
                                    "speaker": "普萨科",
                                    "text": "哈哈哈哈哈，好！说再多也不如自己亲手试试，上场上场，玩个痛快吧！"
                                }
                            ]
                        },
                        {
                            "id": "756660204",
                            "text": "还有别的事…",
                            "response": [
                                {
                                    "id": "756660205",
                                    "speaker": "普萨科",
                                    "text": "没关系，先忙你的事吧。想玩的话，随时都可以过来。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7566701",
            "initDialog": "756670101",
            "dialogues": [
                {
                    "id": "756670101",
                    "speaker": "胡伊鲁",
                    "text": "#你好，{NICKNAME}。如果有空的话，你愿意听我讲一个故事吗？"
                },
                {
                    "id": "756670102",
                    "speaker": "Player",
                    "text": "是关于什么的故事？"
                },
                {
                    "id": "756670103",
                    "speaker": "胡伊鲁",
                    "text": "唔…简单来说，是一个有关于旅行，伙伴和家人的故事。"
                },
                {
                    "id": "756670104",
                    "speaker": "胡伊鲁",
                    "text": "在我们「流泉之众」里，曾经有一位著名的旅行家，名叫阿凯马伊。"
                },
                {
                    "id": "756670105",
                    "speaker": "胡伊鲁",
                    "text": "他和自己的伙伴，鳍游龙卡乌卡乌一起踏上了旅途，立志走遍整个纳塔，吃遍所有美食。"
                },
                {
                    "id": "756670106",
                    "speaker": "胡伊鲁",
                    "text": "每当他们抵达一个地方，阿凯马伊都会和自己的伙伴一起，寻找一块最漂亮的石头作为纪念。"
                },
                {
                    "id": "756670107",
                    "speaker": "胡伊鲁",
                    "text": "他们去了无数个地方，寻找到了许多漂亮的石头，也尝到了许多美食。"
                },
                {
                    "id": "756670108",
                    "speaker": "胡伊鲁",
                    "text": "据说当他们回到「流泉之众」时，阿凯马伊的身材都和我一样了。"
                },
                {
                    "id": "756670109",
                    "speaker": "胡伊鲁",
                    "text": "咳，当然这不是重点。重点在于，他们在旅途上遇见了许多奇妙的故事。"
                },
                {
                    "id": "756670110",
                    "speaker": "胡伊鲁",
                    "text": "#{NICKNAME}，如果你愿意的话，我可以将这些故事一一告诉你。"
                },
                {
                    "id": "756670111",
                    "speaker": "胡伊鲁",
                    "text": "我保证，这些故事绝对值得你略作驻足。"
                }
            ]
        },
        {
            "talkId": "7566702",
            "initDialog": "756670201",
            "dialogues": [
                {
                    "id": "756670201",
                    "speaker": "胡伊鲁",
                    "text": "#你好，{NICKNAME}。如果有空的话，你愿意听我讲一个故事吗？",
                    "choices": [
                        {
                            "id": "756670202",
                            "text": "那我听听看。",
                            "response": [
                                {
                                    "id": "756670203",
                                    "speaker": "胡伊鲁",
                                    "text": "请坐在这边吧， 我保证，这些故事绝对值得你略作驻足。"
                                }
                            ]
                        },
                        {
                            "id": "756670204",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "756670205",
                                    "speaker": "胡伊鲁",
                                    "text": "再见。请先去忙吧，如果想要听故事，随时都可以回来找我。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7566801",
            "initDialog": "756680101",
            "dialogues": [
                {
                    "id": "756680101",
                    "speaker": "阿维苏菈",
                    "text": "加点蘑菇…再加点野菜根…"
                },
                {
                    "id": "756680102",
                    "speaker": "阿维苏菈",
                    "text": "#饮料调好了，{NICKNAME}，你要尝尝么？"
                },
                {
                    "id": "756680103",
                    "speaker": "Player",
                    "text": "你，你往里面加了什么？"
                },
                {
                    "id": "756680104",
                    "speaker": "阿维苏菈",
                    "text": "都是一些普通的香料和调味品，它们能让饮料变得更好喝。"
                },
                {
                    "id": "756680105",
                    "speaker": "阿维苏菈",
                    "text": "后面的乐台已经搭建完成，普通的饮料可配不上它奏出来的音乐。"
                },
                {
                    "id": "756680106",
                    "speaker": "Player",
                    "text": "话是这么说没错…"
                },
                {
                    "id": "756680107",
                    "speaker": "阿维苏菈",
                    "text": "放心吧，在你之前已经有不少人喝过了。"
                },
                {
                    "id": "756680108",
                    "speaker": "阿维苏菈",
                    "text": "喏，他们都已经拿着饮料去乐台旁边跳舞了。"
                },
                {
                    "id": "756680109",
                    "speaker": "阿维苏菈",
                    "text": "#来吧{NICKNAME}，拿上一杯，和我们一起跳舞！"
                },
                {
                    "id": "756680110",
                    "speaker": "阿维苏菈",
                    "text": "把糟心事都甩到一旁，尽情享受音乐吧！"
                },
                {
                    "id": "756680111",
                    "speaker": "阿维苏菈",
                    "text": "对了，你跳舞的时候，也记得稍微控制一下，别用力过头了啊。"
                },
                {
                    "id": "756680112",
                    "speaker": "阿维苏菈",
                    "text": "之前就有几个人因为跳太久差点晕过去了，被人扶下来的时候，还嘟嘟囔囔什么…"
                },
                {
                    "id": "756680113",
                    "speaker": "阿维苏菈",
                    "text": "「我…我真看见了！那个…丘丘人…和我一起跳舞…」"
                },
                {
                    "id": "756680114",
                    "speaker": "阿维苏菈",
                    "text": "咳，不说这些耽误你时间了，快去台上玩个痛快吧！"
                }
            ]
        },
        {
            "talkId": "7566802",
            "initDialog": "756680201",
            "dialogues": [
                {
                    "id": "756680201",
                    "speaker": "阿维苏菈",
                    "text": "#行，这杯饮料也调好了…哦？{NICKNAME}，你要来一杯吗？",
                    "choices": [
                        {
                            "id": "756680202",
                            "text": "来一杯！",
                            "response": [
                                {
                                    "id": "756680203",
                                    "speaker": "阿维苏菈",
                                    "text": "没问题！拿上这杯，和我们一起跳舞，尽情享受音乐吧！"
                                }
                            ]
                        },
                        {
                            "id": "756680204",
                            "text": "还，还是不了…",
                            "response": [
                                {
                                    "id": "756680205",
                                    "speaker": "阿维苏菈",
                                    "text": "哎，行吧。你要是想喝，随时回来找我。可要早点来，不然饮料说不定都要被喝光了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}