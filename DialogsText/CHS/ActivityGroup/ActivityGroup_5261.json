{
    "groupId": "5261",
    "total_dialogue_lines": 70,
    "speaker_counts": {
        "Player": 20,
        "「律动魔匠」": 12,
        "希诺宁": 14,
        "梦见月瑞希": 13,
        "玛拉妮": 11
    },
    "talks": [
        {
            "talkId": "7550802",
            "initDialog": "755080201",
            "dialogues": [
                {
                    "id": "755080201",
                    "speaker": "「律动魔匠」",
                    "text": "嗯，撞球打击目标的音色富有张力，要是能配上稳定的节奏，就是完美的加花！",
                    "choices": [
                        {
                            "id": "755080202",
                            "text": "来一局「节拍撞球」！",
                            "response": [
                                {
                                    "id": "755080203",
                                    "speaker": "「律动魔匠」",
                                    "text": "好，期待你的发挥，祝你打出漂亮的段落！"
                                }
                            ]
                        },
                        {
                            "id": "755080204",
                            "text": "你是…",
                            "response": [
                                {
                                    "id": "755080205",
                                    "speaker": "「律动魔匠」",
                                    "text": "你好你好，欢迎来玩这个游戏！"
                                },
                                {
                                    "id": "755080206",
                                    "speaker": "「律动魔匠」",
                                    "text": "我是希诺宁大师雇来的一般乐师，负责管理这座「热舞乐台」。"
                                },
                                {
                                    "id": "755080207",
                                    "speaker": "Player",
                                    "text": "大师？"
                                },
                                {
                                    "id": "755080208",
                                    "speaker": "「律动魔匠」",
                                    "text": "没错！无论从设计、打造和维护设备的技术，还是控碟的本领，希诺宁都是我们这些乐师敬仰的绝对高手！"
                                },
                                {
                                    "id": "755080209",
                                    "speaker": "「律动魔匠」",
                                    "text": "她控碟时，从不局限于特定的风格和技法，什么风格的唱片都能驾驭…"
                                },
                                {
                                    "id": "755080210",
                                    "speaker": "「律动魔匠」",
                                    "text": "而且，她的「听感」非常准狠！"
                                },
                                {
                                    "id": "755080211",
                                    "speaker": "「律动魔匠」",
                                    "text": "哪个段落的音色过于干哑，音高偏差超过半度，音质效果拧过了头，她就算用青蜜莓堵住耳朵，都能听个八九不离十…"
                                },
                                {
                                    "id": "755080212",
                                    "speaker": "Player",
                                    "text": "为什么是青蜜莓…"
                                },
                                {
                                    "id": "755080213",
                                    "speaker": "「律动魔匠」",
                                    "text": "这就有门道了！青蜜莓饱含汁液，隔着它听东西，就像身处水下，对于音乐人来说，是最艰难的考验！"
                                },
                                {
                                    "id": "755080214",
                                    "speaker": "「律动魔匠」",
                                    "text": "虽然希诺宁大师从没提过这茬，但我觉得，准确听音的本事对战士和冒险家而言，也能起到至关重要的作用。"
                                },
                                {
                                    "id": "755080215",
                                    "speaker": "「律动魔匠」",
                                    "text": "推荐你向希诺宁大师学习听音技巧哦！"
                                }
                            ]
                        },
                        {
                            "id": "755080216",
                            "text": "下次再来看看…",
                            "response": [
                                {
                                    "id": "755080217",
                                    "speaker": "「律动魔匠」",
                                    "text": "有空常来！要是之后遇上了我们控碟乐师的演出，也请多多捧场！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7550803",
            "initDialog": "755080301",
            "dialogues": [
                {
                    "id": "755080301",
                    "speaker": "玛拉妮",
                    "text": "#哟，{NICKNAME}，精神满满嘛！",
                    "choices": [
                        {
                            "id": "755080302",
                            "text": "说起来，玛拉妮喜欢什么歌？",
                            "response": [
                                {
                                    "id": "755080303",
                                    "speaker": "玛拉妮",
                                    "text": "我啊？哈哈，我不挑！"
                                },
                                {
                                    "id": "755080304",
                                    "speaker": "玛拉妮",
                                    "text": "悠闲的、热情的、轻松愉快的歌，我都能接受！"
                                },
                                {
                                    "id": "755080305",
                                    "speaker": "玛拉妮",
                                    "text": "至于旋律比较低沉，氛围很正式的音乐，我可能没法跟着摇摆…我不常听，但也不反感！"
                                }
                            ]
                        },
                        {
                            "id": "755080306",
                            "text": "有什么游玩建议嘛？",
                            "response": [
                                {
                                    "id": "755080307",
                                    "speaker": "玛拉妮",
                                    "text": "嗯，让我想想…"
                                },
                                {
                                    "id": "755080308",
                                    "speaker": "玛拉妮",
                                    "text": "凭我打沙滩排球的经验，太过紧张的话，反而有可能发挥失常。"
                                },
                                {
                                    "id": "755080309",
                                    "speaker": "玛拉妮",
                                    "text": "有时看着飞来的撞球，思考太多条件，反而会左右为难！"
                                },
                                {
                                    "id": "755080310",
                                    "speaker": "玛拉妮",
                                    "text": "适当放空思维，让身体跟着直觉作出反应！"
                                },
                                {
                                    "id": "755080311",
                                    "speaker": "Player",
                                    "text": "原来如此，我试试！"
                                },
                                {
                                    "id": "755080312",
                                    "speaker": "玛拉妮",
                                    "text": "当然，遇上了需要比拼策略的游戏，或者更严肃的事，完全依靠直觉是行不通的，要好好考虑行动的后果哦。"
                                },
                                {
                                    "id": "755080313",
                                    "speaker": "玛拉妮",
                                    "text": "张弛有度才是关键！"
                                }
                            ]
                        },
                        {
                            "id": "755080314",
                            "text": "游戏不错，我再玩玩！",
                            "response": [
                                {
                                    "id": "755080315",
                                    "speaker": "玛拉妮",
                                    "text": "嘿！以你的实力，多玩几局，就能创下没人能超越的分数啦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7550804",
            "initDialog": "755080401",
            "dialogues": [
                {
                    "id": "755080401",
                    "speaker": "希诺宁",
                    "text": "#状态还不错，{NICKNAME}，有即兴演奏大师的风范了。",
                    "choices": [
                        {
                            "id": "755080402",
                            "text": "演奏方面还得请教你…",
                            "response": [
                                {
                                    "id": "755080403",
                                    "speaker": "希诺宁",
                                    "text": "很好，你确实对控碟乐师的专业技能有兴趣。"
                                },
                                {
                                    "id": "755080404",
                                    "speaker": "希诺宁",
                                    "text": "要了解控碟乐师的要点，还得先从熟悉设备开始…"
                                },
                                {
                                    "id": "755080405",
                                    "speaker": "希诺宁",
                                    "text": "我也打造过不少相关设备，收集了一些资料。下次来我那时，都拿去吧。"
                                },
                                {
                                    "id": "755080406",
                                    "speaker": "希诺宁",
                                    "text": "学习一门音乐技艺时，熟悉理论知识的过程难免有点枯燥，但只要成功入门，就会进入一段快速上升的甜蜜期。"
                                },
                                {
                                    "id": "755080407",
                                    "speaker": "希诺宁",
                                    "text": "期待你的表现。"
                                }
                            ]
                        },
                        {
                            "id": "755080408",
                            "text": "希诺宁最中意哪种音乐风格？",
                            "response": [
                                {
                                    "id": "755080409",
                                    "speaker": "希诺宁",
                                    "text": "风格吗…我倒是很难说，自己认定了哪种风格。"
                                },
                                {
                                    "id": "755080410",
                                    "speaker": "希诺宁",
                                    "text": "在我看来，一首歌的综合制作水平才更重要——"
                                },
                                {
                                    "id": "755080411",
                                    "speaker": "希诺宁",
                                    "text": "旋律线的走向、编曲的思路、配器的选择、录音和综合处理的质量…都有各自的及格线。"
                                },
                                {
                                    "id": "755080412",
                                    "speaker": "希诺宁",
                                    "text": "随处可见的大众风格中，也会诞生乐理技术异常超前的杰作，相对的，看似高级的小众风格里，也有水平不容乐观的案例。"
                                },
                                {
                                    "id": "755080413",
                                    "speaker": "希诺宁",
                                    "text": "要是一首歌粗制滥造，就想借着小众标签骗过听众，那未免有点…卑鄙？",
                                    "choices": [
                                        {
                                            "id": "755080414",
                                            "text": "确实，不能滥竽充数…",
                                            "response": [
                                                {
                                                    "id": "755080416",
                                                    "speaker": "希诺宁",
                                                    "text": "#所以啊，认真学习乐理，按部就班地练习吧，{NICKNAME}。"
                                                },
                                                {
                                                    "id": "755080417",
                                                    "speaker": "希诺宁",
                                                    "text": "基本功是重中之重，我相信你会扎扎实实做事。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755080415",
                                            "text": "还是没必要盯着标签…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755080418",
                            "text": "那我继续找找灵感。",
                            "response": [
                                {
                                    "id": "755080419",
                                    "speaker": "希诺宁",
                                    "text": "有好点子的话，可以和我分享，随便哼哼旋律也行，我会帮你记下来的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7550805",
            "initDialog": "755080501",
            "dialogues": [
                {
                    "id": "755080501",
                    "speaker": "梦见月瑞希",
                    "text": "嗯，我能感觉到，你在享受游艺的乐趣时，情绪中蕴含着温暖的色彩，相信你今晚会有个轻松舒畅的好梦。",
                    "choices": [
                        {
                            "id": "755080502",
                            "text": "瑞希也会听节奏很快的歌吗？",
                            "response": [
                                {
                                    "id": "755080503",
                                    "speaker": "梦见月瑞希",
                                    "text": "这个问题的思路非常经典哦。"
                                },
                                {
                                    "id": "755080504",
                                    "speaker": "梦见月瑞希",
                                    "text": "朋友推荐的音乐，不管我能否接受，都会好好听完，如此才不至于辜负朋友的好意。"
                                },
                                {
                                    "id": "755080505",
                                    "speaker": "梦见月瑞希",
                                    "text": "我可以接受节奏特别快的音乐，不过更倾向于舒缓、优美的类型。乐器的种类不一定要很丰富，技巧也不用特别炫目。"
                                },
                                {
                                    "id": "755080506",
                                    "speaker": "梦见月瑞希",
                                    "text": "只要主要的旋律足够动听，哪怕只是慢慢的独奏，或是人声清唱，也不会显得单薄，反而有种清静的美感。",
                                    "choices": [
                                        {
                                            "id": "755080507",
                                            "text": "我也一样。",
                                            "response": [
                                                {
                                                    "id": "755080508",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "那…等到你下回空闲时，我挑选几首不错的音乐，沏一壶好茶，准备些点心，一起慢慢欣赏吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "755080509",
                                            "text": "也可以试试新风格？",
                                            "response": [
                                                {
                                                    "id": "755080510",
                                                    "speaker": "梦见月瑞希",
                                                    "text": "没问题哦，以你的审美，肯定能让我走出舒适区，找到些新的宝藏。下回空闲时，带我欣赏这些杰作吧？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "755080511",
                            "text": "想看瑞希玩这个游戏。",
                            "response": [
                                {
                                    "id": "755080512",
                                    "speaker": "梦见月瑞希",
                                    "text": "当然可以啦，不过有点犯规哦。"
                                },
                                {
                                    "id": "755080513",
                                    "speaker": "梦见月瑞希",
                                    "text": "作为设计者之一的我了解每个关卡的细节，每一步都在预料中，难免显得有些无趣嘛。"
                                },
                                {
                                    "id": "755080514",
                                    "speaker": "梦见月瑞希",
                                    "text": "游艺之中多一点惊喜才好，这对设计者的思维是一种考验，要尽可能跳出常规，避免每一步发展都被人一眼望穿。"
                                },
                                {
                                    "id": "755080515",
                                    "speaker": "梦见月瑞希",
                                    "text": "在超出常理的领域里，你自然是最佳代表啦。"
                                },
                                {
                                    "id": "755080516",
                                    "speaker": "梦见月瑞希",
                                    "text": "希望以后，你也能从头参与一些游艺的统筹架构，让我体验你设计的关卡~"
                                }
                            ]
                        },
                        {
                            "id": "755080517",
                            "text": "你也要好好休息哦。",
                            "response": [
                                {
                                    "id": "755080518",
                                    "speaker": "梦见月瑞希",
                                    "text": "请别担心，这次成功邀请到你，我就心满意足了。心情舒畅的睡眠，一份时间，甚至抵得上平时的三倍~"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7550810",
            "initDialog": "755081001",
            "dialogues": [
                {
                    "id": "755081001",
                    "speaker": "Player",
                    "text": "（看起来，这位控碟乐师正沉浸在音乐中，还是先去找玛拉妮她们问问情况吧…）"
                }
            ]
        }
    ]
}