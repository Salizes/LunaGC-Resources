{
    "groupId": "2035",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 2,
        "勒拉": 3,
        "欧洛伦": 10
    },
    "talks": [
        {
            "talkId": "4017108",
            "initDialog": "401710801",
            "dialogues": [
                {
                    "id": "401710801",
                    "speaker": "欧洛伦",
                    "text": "#{NICKNAME}，这几天还要继续辛苦你聚集游灵了，用这个香炉就好，奶奶在上面留下了法术。",
                    "choices": [
                        {
                            "id": "401710802",
                            "text": "关于灵性织机…",
                            "response": [
                                {
                                    "id": "401710803",
                                    "speaker": "欧洛伦",
                                    "text": "噢，你喜欢玩那个吗？可以随时试试，里面应该有别的暝视记录。你可以把它们都拼接到织物上。还挺有趣的。"
                                },
                                {
                                    "id": "401710804",
                                    "speaker": "欧洛伦",
                                    "text": "不用担心别的，既然奶奶把它留在这里，应该就有给你练手的意思。"
                                }
                            ]
                        },
                        {
                            "id": "401710805",
                            "text": "关于烬寂海…",
                            "response": [
                                {
                                    "id": "401710806",
                                    "speaker": "欧洛伦",
                                    "text": "烬寂海？据我所知，那里不适合蔬菜生长。"
                                },
                                {
                                    "id": "401710807",
                                    "speaker": "欧洛伦",
                                    "text": "我怎么知道的？是奶奶说的啦，要是你想了解更多，还是等奶奶来了问她比较好。"
                                },
                                {
                                    "id": "401710808",
                                    "speaker": "欧洛伦",
                                    "text": "奶奶家里有一些相关的织卷，只是我对种不出蔬菜的地方实在提不起兴趣，所以一幅都没看过，真对不起。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4017109",
            "initDialog": "401710901",
            "dialogues": [
                {
                    "id": "401710901",
                    "speaker": "勒拉",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "4017205",
            "initDialog": "401720501",
            "dialogues": [
                {
                    "id": "401720501",
                    "speaker": "欧洛伦",
                    "text": "还是有点想不通，那个谷中假如别有目的，怎么又把桑哈杰前辈的遗物留在现场了呢？"
                },
                {
                    "id": "401720502",
                    "speaker": "欧洛伦",
                    "text": "难道说，那个也是诱饵？"
                }
            ]
        },
        {
            "talkId": "4017304",
            "initDialog": "401730401",
            "dialogues": [
                {
                    "id": "401730401",
                    "speaker": "欧洛伦",
                    "text": "#{NICKNAME}，不管怎么说，谢谢你。如果这次你不在的话，我得费更多力气。"
                },
                {
                    "id": "401730402",
                    "speaker": "欧洛伦",
                    "text": "这些送给你，都是我亲手种的，希望你喜欢。"
                }
            ]
        },
        {
            "talkId": "4017306",
            "initDialog": "401730601",
            "dialogues": [
                {
                    "id": "401730601",
                    "speaker": "勒拉",
                    "text": "加油，我要和欧洛伦努力学习法术，成为一颗漂亮的卷心菜。"
                },
                {
                    "id": "401730602",
                    "speaker": "勒拉",
                    "text": "不过其实我更希望成为胡萝卜，因为更加营养。"
                }
            ]
        }
    ]
}