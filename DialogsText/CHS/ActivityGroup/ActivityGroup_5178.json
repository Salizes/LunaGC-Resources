            "dialogues": [
                {
                    "id": "401432001",
                    "speaker": "公告板",
                    "text": "招聘启事：望舒客栈现高薪急聘临时厨师一位，待遇从优，酬劳面议。有意者请移步楼上与掌柜淮安详谈。"
                }
            ]
        },
        {
            "talkId": "4014321",
            "initDialog": "401432101",
            "dialogues": [
                {
                    "id": "401432101",
                    "speaker": "言笑",
                    "text": "油、盐、酱、醋…嗯，储备都很充足，够用过这阵了。"
                }
            ]
        },
        {
            "talkId": "4014322",
            "initDialog": "401432201",
            "dialogues": [
                {
                    "id": "401432201",
                    "speaker": "淮安",
                    "text": "#哟，{NICKNAME}，今年算是开了个好头呀。"
                }
            ]
        },
        {
            "talkId": "4014323",
            "initDialog": "401432301",
            "dialogues": [
                {
                    "id": "401432301",
                    "speaker": "菲尔戈黛特",
                    "text": "欢迎欢迎，有什么需要帮助的吗？"
                }
            ]
        },
        {
            "talkId": "4014324",
            "initDialog": "401432401",
            "dialogues": [
                {
                    "id": "401432401",
                    "speaker": "Player",
                    "text": "我能照常买点东西吗？"
                },
                {
                    "id": "401432402",
                    "speaker": "菲尔戈黛特",
                    "text": "当然可以，随便看看吧。"
                }
            ]
        },
        {
            "talkId": "4014325",
            "initDialog": "401432501",
            "dialogues": [
                {
                    "id": "401432501",
                    "speaker": "Player",
                    "text": "老板再见。"
                },
                {
                    "id": "401432502",
                    "speaker": "菲尔戈黛特",
                    "text": "再见，工作要努力哦。"
                }
            ]
        },
        {
            "talkId": "4014326",
            "initDialog": "401432601",
            "dialogues": [
                {
                    "id": "401432601",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "401432602",
                    "speaker": "淮安",
                    "text": "再见，一路顺风啊。"
                }
            ]
        },
        {
            "talkId": "4014327",
            "initDialog": "401432701",
            "dialogues": [
                {
                    "id": "401432701",
                    "speaker": "调查样品",
                    "text": "（惟妙惟肖的样品，忠实还原了那天所见的色泽质感，光是看着回忆就会涌上心头…可惜不能吃。）"
                }
            ]
        }
    ]
