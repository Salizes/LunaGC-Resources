{
    "groupId": "5280",
    "total_dialogue_lines": 128,
    "speaker_counts": {
        "Player": 26,
        "方妮雅": 36,
        "派蒙": 9,
        "瓦乐瑞娜": 31,
        "艾玛托": 26
    },
    "talks": [
        {
            "talkId": "7054702",
            "initDialog": "705470201",
            "dialogues": [
                {
                    "id": "705470201",
                    "speaker": "瓦乐瑞娜",
                    "text": "怎么样，猫猫救星和白猫魔法师？是不是觉得，嘟嘟可毛茸茸、软绵绵又蹦蹦弹弹，想抱抱！",
                    "choices": [
                        {
                            "id": "705470202",
                            "text": "你也成为嘟嘟可的粉丝了？",
                            "response": [
                                {
                                    "id": "705470203",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "对的对的！我现在的目标是支援艾玛托小姐，好好宣传火花骑士的厉害，还有伙伴嘟嘟可的可爱形象！"
                                },
                                {
                                    "id": "705470204",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "为此，我准备先投入一千万摩拉，试着量产这种桌上游戏，让它流行起来。"
                                },
                                {
                                    "id": "705470205",
                                    "speaker": "派蒙",
                                    "text": "一…一上来就一千万吗？已经不是普通粉丝的级别了…"
                                },
                                {
                                    "id": "705470206",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "不过，量产要等到试玩结束，收集大家的反馈。"
                                },
                                {
                                    "id": "705470207",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "再由实际上的开发者艾玛托小姐进行改良，争取做到每个人都能快速上手，玩个开心！"
                                }
                            ]
                        },
                        {
                            "id": "705470208",
                            "text": "关于游戏中的嘟嘟可和对手…",
                            "response": [
                                {
                                    "id": "705470209",
                                    "speaker": "派蒙",
                                    "text": "说得对哦，我也想知道，艾玛托小姐的灵感是怎么来的呢？"
                                },
                                {
                                    "id": "705470210",
                                    "speaker": "派蒙",
                                    "text": "#参考可莉，凯亚，丽莎和{NICKNAME}的形象，让我感觉很亲切！"
                                },
                                {
                                    "id": "705470211",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "哎呀，其实开发者不是我，是艾玛托小姐哦。"
                                },
                                {
                                    "id": "705470212",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "我也问过她相同的问题，她的观点让我非常信服——"
                                },
                                {
                                    "id": "705470213",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "你和凯亚先生，还有丽莎小姐，都是蒙德城的大名人，骑士团的中流砥柱！"
                                },
                                {
                                    "id": "705470214",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "你们与火花骑士并肩作战了好多好多年，也该在桌上游戏的舞台中登场。"
                                },
                                {
                                    "id": "705470215",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "英雄的故事从来不是一个人的独角戏，而是伙伴们的意志、勇气和智慧的合奏！"
                                },
                                {
                                    "id": "705470216",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "所以，在讲火花骑士的故事的同时，也要给火花骑士的每个伙伴充足的戏份！"
                                },
                                {
                                    "id": "705470217",
                                    "speaker": "Player",
                                    "text": "可莉的伙伴不止我们哦。"
                                },
                                {
                                    "id": "705470218",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "明白！目前的这些只是试玩版的玩偶，还有琴团长、白色小帮手、阿贝多先生、安柏和优菈小姐，等等等等…"
                                },
                                {
                                    "id": "705470219",
                                    "speaker": "派蒙",
                                    "text": "咦，我也有份吗？"
                                },
                                {
                                    "id": "705470220",
                                    "speaker": "Player",
                                    "text": "派蒙嘟嘟可化…期待！"
                                },
                                {
                                    "id": "705470221",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "至于这次的对手，都是艾玛托小姐根据远征队传回的情报设计的。"
                                },
                                {
                                    "id": "705470222",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "说是参考了挪德卡莱的魔物和敌人…"
                                },
                                {
                                    "id": "705470223",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "因为大家不熟的远方，总有一种神秘感，所以作为冒险的目标很不错嘛！"
                                },
                                {
                                    "id": "705470224",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "以后啊，嘟嘟可的故事，说不定会发展到…前往异世界冒险呢？"
                                },
                                {
                                    "id": "705470225",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "我一定要多多投资，多多见证这个桌上游戏的发展！"
                                }
                            ]
                        },
                        {
                            "id": "705470226",
                            "text": "我们以前见面的情况是…",
                            "response": [
                                {
                                    "id": "705470227",
                                    "speaker": "派蒙",
                                    "text": "还有你叫我们的外号，我总觉得有点印象…"
                                },
                                {
                                    "id": "705470228",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "嗯，说来时间也好久好久了。"
                                },
                                {
                                    "id": "705470229",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "之前，我在经营一座流浪猫收容所的时候，遇上了困难…好在有你们和罗莎莉亚小姐支援我！"
                                },
                                {
                                    "id": "705470230",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "和白猫魔法师学了两招之后，猫猫们也不再凶我，一切都走上了正轨！"
                                },
                                {
                                    "id": "705470231",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "不过，收容所试营业后没多久，我就被老朋友的队伍指名，参加了一次长途冒险。"
                                },
                                {
                                    "id": "705470232",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "还好我加入了队伍，那次冒险中遇上了好多谜题，要是我不在的话，大概率会有人遭遇不测…"
                                },
                                {
                                    "id": "705470233",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "最近我才回到蒙德城，正打算拾掇拾掇，重新让收容所开张，继续好好干活。",
                                    "choices": [
                                        {
                                            "id": "705470234",
                                            "text": "想起来了！",
                                            "response": [
                                                {
                                                    "id": "705470235",
                                                    "speaker": "派蒙",
                                                    "text": "是「猫茸茸城堡」吗？是「猫茸茸城堡」没错吧！"
                                                },
                                                {
                                                    "id": "705470236",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "太好了，你们还记得！"
                                                },
                                                {
                                                    "id": "705470237",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "「雪糕」、「兔叽」、「团团灰」和「阿呆」都很想你们呢！有空的话，要过来玩玩哦！"
                                                },
                                                {
                                                    "id": "705470238",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "也请允许我问问看，「大桔骑士」最近怎么样？",
                                                    "choices": [
                                                        {
                                                            "id": "705470239",
                                                            "text": "非常棒喔！",
                                                            "response": [
                                                                {
                                                                    "id": "705470240",
                                                                    "speaker": "派蒙",
                                                                    "text": "放心吧，瓦乐瑞娜小姐，在我们那儿，「大桔骑士」吃饱喝好，每天都能无忧无虑地玩耍！"
                                                                },
                                                                {
                                                                    "id": "705470243",
                                                                    "speaker": "瓦乐瑞娜",
                                                                    "text": "好呀好呀！容我仔细想想，做点什么小点心，麻烦你们带给它！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705470241",
                                                            "text": "还行还行！",
                                                            "response": [
                                                                {
                                                                    "id": "705470242",
                                                                    "speaker": "派蒙",
                                                                    "text": "说起来，我好像有段时间没找「大桔骑士」玩了…下次回壶中洞天，我就去好好陪陪它！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705470244",
                                            "text": "好像还是没印象…",
                                            "response": [
                                                {
                                                    "id": "705470245",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "没事没事！你们太忙太忙了，估计每个礼拜见的陌生人比我两三年都多。"
                                                },
                                                {
                                                    "id": "705470246",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "没能给你们留下印象，说明我还不够厉害，我会努力成为一名知名冒险家的。"
                                                },
                                                {
                                                    "id": "705470247",
                                                    "speaker": "瓦乐瑞娜",
                                                    "text": "争取下次见面时，你一下子就记起来我是谁，和你们一起经历过什么样的开心时光！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705470248",
                            "text": "下次来详聊！",
                            "response": [
                                {
                                    "id": "705470249",
                                    "speaker": "派蒙",
                                    "text": "我们还会回来的喔！"
                                },
                                {
                                    "id": "705470250",
                                    "speaker": "瓦乐瑞娜",
                                    "text": "好！我会认认真真等着你们的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7054703",
            "initDialog": "705470301",
            "dialogues": [
                {
                    "id": "705470301",
                    "speaker": "艾玛托",
                    "text": "好点了吗，方妮雅？"
                },
                {
                    "id": "705470302",
                    "speaker": "方妮雅",
                    "text": "头没那么痛了，吃些甜品确实有用…"
                },
                {
                    "id": "705470303",
                    "speaker": "方妮雅",
                    "text": "艾玛托…谢谢你。"
                },
                {
                    "id": "705470304",
                    "speaker": "艾玛托",
                    "text": "干嘛说谢谢？那么见外！"
                },
                {
                    "id": "705470305",
                    "speaker": "艾玛托",
                    "text": "你得早点好起来，早点回来工作，大家还等着你呢！",
                    "choices": [
                        {
                            "id": "705470306",
                            "text": "下午茶？能让我加入吗？",
                            "response": [
                                {
                                    "id": "705470307",
                                    "speaker": "艾玛托",
                                    "text": "荣誉骑士！"
                                },
                                {
                                    "id": "705470308",
                                    "speaker": "方妮雅",
                                    "text": "#{NICKNAME}长官…"
                                },
                                {
                                    "id": "705470309",
                                    "speaker": "Player",
                                    "text": "怎么一副苦闷的表情？"
                                },
                                {
                                    "id": "705470310",
                                    "speaker": "方妮雅",
                                    "text": "虽说已经过去了一段时间，看见你，我还是觉得心中有愧。"
                                },
                                {
                                    "id": "705470311",
                                    "speaker": "Player",
                                    "text": "是说之前那件事吗？"
                                },
                                {
                                    "id": "705470312",
                                    "speaker": "艾玛托",
                                    "text": "唔…嗯…荣誉骑士大人，你确定要讨论那件事吗？"
                                },
                                {
                                    "id": "705470313",
                                    "speaker": "艾玛托",
                                    "text": "杜林的那场风波，现在想来，我还感觉有点害怕…要重提吗？",
                                    "choices": [
                                        {
                                            "id": "705470314",
                                            "text": "我相信方妮雅做好了准备。",
                                            "response": [
                                                {
                                                    "id": "705470315",
                                                    "speaker": "方妮雅",
                                                    "text": "…没错，我不能逃避。"
                                                },
                                                {
                                                    "id": "705470316",
                                                    "speaker": "方妮雅",
                                                    "text": "请容我向你汇报情况，荣誉骑士长官。"
                                                },
                                                {
                                                    "id": "705470317",
                                                    "speaker": "方妮雅",
                                                    "text": "在那场风波中，代理团长揭穿了我被杜林影响心智的事，果断让骑士们将我押送回总部…"
                                                },
                                                {
                                                    "id": "705470318",
                                                    "speaker": "方妮雅",
                                                    "text": "在禁闭室里，我听见外边响起了烟花声…随后就是一种奇妙的冲击感。"
                                                },
                                                {
                                                    "id": "705470319",
                                                    "speaker": "方妮雅",
                                                    "text": "就像是…一场诡异的梦突然结束，意识瞬间就清醒了。"
                                                },
                                                {
                                                    "id": "705470320",
                                                    "speaker": "方妮雅",
                                                    "text": "然后才慢慢反应过来，自己之前做了多可怕的事…"
                                                },
                                                {
                                                    "id": "705470321",
                                                    "speaker": "方妮雅",
                                                    "text": "之后，阿贝多队长与砂糖小姐调制了温和的药剂，逐渐解除了我所受的负面影响和后遗症。"
                                                },
                                                {
                                                    "id": "705470322",
                                                    "speaker": "方妮雅",
                                                    "text": "其他受到影响的骑士，大多也被阿贝多队长用这种方法慢慢调理，恢复了正常。"
                                                },
                                                {
                                                    "id": "705470323",
                                                    "speaker": "方妮雅",
                                                    "text": "确认我并无大碍后，代理团长给我放了长假，希望我好好调整状态。"
                                                },
                                                {
                                                    "id": "705470324",
                                                    "speaker": "方妮雅",
                                                    "text": "但假期结束后，我还是有些心理负担，短时间内没法回到岗位上去。"
                                                },
                                                {
                                                    "id": "705470325",
                                                    "speaker": "艾玛托",
                                                    "text": "大家不会怪罪你的，毕竟都是不可抗力导致的…",
                                                    "choices": [
                                                        {
                                                            "id": "705470326",
                                                            "text": "这次你属于受害者。",
                                                            "response": [
                                                                {
                                                                    "id": "705470328",
                                                                    "speaker": "艾玛托",
                                                                    "text": "哎，那段时间，连我都没有发现异常。"
                                                                },
                                                                {
                                                                    "id": "705470329",
                                                                    "speaker": "艾玛托",
                                                                    "text": "我还在想，方妮雅被调去第七小队了，还参加了重要的推演，是不是应该办个宴会庆祝下。"
                                                                },
                                                                {
                                                                    "id": "705470330",
                                                                    "speaker": "艾玛托",
                                                                    "text": "没想到会是这样…"
                                                                },
                                                                {
                                                                    "id": "705470331",
                                                                    "speaker": "方妮雅",
                                                                    "text": "现在反思，我大概是在第7次高寒环境装备测试的过程中受到了影响。"
                                                                },
                                                                {
                                                                    "id": "705470332",
                                                                    "speaker": "方妮雅",
                                                                    "text": "那次测试中，我距离危险的残骸太近，回来后就像是大病了一场，身体乏力，脑袋昏昏沉沉，报告也没写好。"
                                                                },
                                                                {
                                                                    "id": "705470333",
                                                                    "speaker": "方妮雅",
                                                                    "text": "阿贝多队长应该是从报告中发现了我的异常，很快确定了我也中招。"
                                                                },
                                                                {
                                                                    "id": "705470334",
                                                                    "speaker": "方妮雅",
                                                                    "text": "于是，等到我的状态稍微稳定一点后，他就安排了我调任第七小队，以及参加联合推演的事。"
                                                                },
                                                                {
                                                                    "id": "705470335",
                                                                    "speaker": "方妮雅",
                                                                    "text": "可能正是因为我被重用，当时的杜林才将我列为重点内应。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "705470336",
                                                                            "text": "那推演中的收获岂不是…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "705470338",
                                                                                    "speaker": "方妮雅",
                                                                                    "text": "推演中，我的确全力以赴，也总结出了不少新战法。"
                                                                                },
                                                                                {
                                                                                    "id": "705470339",
                                                                                    "speaker": "方妮雅",
                                                                                    "text": "但请别担心，我所掌握的战术知识，并没有对蒙德的防卫战造成负面影响。"
                                                                                },
                                                                                {
                                                                                    "id": "705470340",
                                                                                    "speaker": "方妮雅",
                                                                                    "text": "最近我仔细复盘才明白，阿贝多队长和代理团长通过巧妙的方法，控制了从我这里流转给杜林的情报…"
                                                                                },
                                                                                {
                                                                                    "id": "705470341",
                                                                                    "speaker": "方妮雅",
                                                                                    "text": "一定程度上，「反向操纵」了杜林的进攻策略。"
                                                                                },
                                                                                {
                                                                                    "id": "705470342",
                                                                                    "speaker": "艾玛托",
                                                                                    "text": "反向操纵…听起来像魔法一样…"
                                                                                },
                                                                                {
                                                                                    "id": "705470343",
                                                                                    "speaker": "方妮雅",
                                                                                    "text": "我提交的战法报告，都会经过代理团长和可信的队长们一同审阅，确认是否予以采用。"
                                                                                },
                                                                                {
                                                                                    "id": "705470344",
                                                                                    "speaker": "方妮雅",
                                                                                    "text": "不知道内应已经暴露的情况下，杜林认为，被采用的战法，将影响骑士团最新的防御战术。"
                                                                                },
                                                                                {
                                                                                    "id": "705470345",
                                                                                    "speaker": "方妮雅",
                                                                                    "text": "但实际上，最终通知我被采用的战法，成了一种「诱饵」。"
                                                                                },
                                                                                {
                                                                                    "id": "705470346",
                                                                                    "speaker": "艾玛托",
                                                                                    "text": "原来…原来是这样！"
                                                                                },
                                                                                {
                                                                                    "id": "705470347",
                                                                                    "speaker": "艾玛托",
                                                                                    "text": "难怪我从好多同事那里听说，要训练新的战法了，结果在防卫战里，完全采用了另一种方案…",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "705470348",
                                                                                            "text": "就是反向利用「泄露」的情报…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "705470350",
                                                                                                    "speaker": "方妮雅",
                                                                                                    "text": "没错，防卫战中，魔物的主力部队不出意料，都用上了针对那种战法的行动逻辑。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705470351",
                                                                                                    "speaker": "方妮雅",
                                                                                                    "text": "结果反而让骑士团占据了主动权，最大程度减少了损伤。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705470352",
                                                                                                    "speaker": "方妮雅",
                                                                                                    "text": "不过，我不能有侥幸心理。即便是有意透露的情报，也可能在魔物那边产生奇妙的反应。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705470353",
                                                                                                    "speaker": "方妮雅",
                                                                                                    "text": "恢复正常以后，我针对杜林所掌握的情报，重新进行了830次推演，让艾玛托把分析结果转交给了阿贝多队长…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705470354",
                                                                                                    "speaker": "艾玛托",
                                                                                                    "text": "但阿贝多队长说，一切都尘埃落定了，不用再担心了哦。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "705470355",
                                                                                                    "speaker": "艾玛托",
                                                                                                    "text": "现在你最重要的任务，是把自己的状态调整好，早早回到我们身边来！",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "705470356",
                                                                                                            "text": "没错，暂时不用担心了。",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "705470358",
                                                                                                                    "speaker": "方妮雅",
                                                                                                                    "text": "这样吗…"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705470359",
                                                                                                                    "speaker": "方妮雅",
                                                                                                                    "text": "那我就针对自己的经历，再写一份详细的报告，作为警示案例好了。"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705470360",
                                                                                                                    "speaker": "方妮雅",
                                                                                                                    "text": "希望其他骑士以我为戒，在野外行动时务必小心，不要被奇怪的力量干扰心智…"
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "705470361",
                                                                                                                    "speaker": "方妮雅",
                                                                                                                    "text": "说不定，这也能发展成一种专门的学科？类似…「精神干扰与防治学」？"
                                                                                                                }
                                                                                                            ]
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "705470357",
                                                                                                            "text": "阿贝多把一切处理妥善了。"
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "705470349",
                                                                                            "text": "使得对方的行为可被预测？"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "705470337",
                                                                            "text": "全新的战术也被杜林给…"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705470327",
                                                            "text": "下次要小心谨慎点。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "705470362",
                                            "text": "那就聊点轻松的话题吧。",
                                            "response": [
                                                {
                                                    "id": "705470363",
                                                    "speaker": "艾玛托",
                                                    "text": "嗯嗯！吃点心的时候，就应该开开心心！"
                                                },
                                                {
                                                    "id": "705470364",
                                                    "speaker": "艾玛托",
                                                    "text": "最近我和方妮雅结交了一位新朋友，是个非常热心的冒险家姐姐！"
                                                },
                                                {
                                                    "id": "705470365",
                                                    "speaker": "艾玛托",
                                                    "text": "她打算重新开张自己的流浪动物收容所，说不定，不久后就能去她那里玩了。"
                                                },
                                                {
                                                    "id": "705470366",
                                                    "speaker": "艾玛托",
                                                    "text": "如果荣誉骑士不介意的话，要一起吗？"
                                                },
                                                {
                                                    "id": "705470367",
                                                    "speaker": "艾玛托",
                                                    "text": "我很好奇，荣誉骑士会喜欢什么样的猫猫！"
                                                },
                                                {
                                                    "id": "705470368",
                                                    "speaker": "艾玛托",
                                                    "text": "另外，还有件重要的事——我最近又在《嘟嘟可砰砰历险记》的基础上，改进出了合作冒险的《嘟嘟可爆轰大乱斗》…"
                                                },
                                                {
                                                    "id": "705470369",
                                                    "speaker": "艾玛托",
                                                    "text": "我和新朋友一起试玩的时候，非常非常开心！我想把这种游戏推广开来，就拜托她帮忙宣传了。"
                                                },
                                                {
                                                    "id": "705470370",
                                                    "speaker": "艾玛托",
                                                    "text": "游戏桌就放在骑士团附近的花园里，如果你有空，随时可以去体验一下。",
                                                    "choices": [
                                                        {
                                                            "id": "705470371",
                                                            "text": "好呀好呀！",
                                                            "response": [
                                                                {
                                                                    "id": "705470373",
                                                                    "speaker": "艾玛托",
                                                                    "text": "方妮雅，等到你精神好点，再叫上你在第七小队那边的搭档，我们一起玩个痛快吧？"
                                                                },
                                                                {
                                                                    "id": "705470374",
                                                                    "speaker": "艾玛托",
                                                                    "text": "我记得阿贝多队长说过，等到那边的侦察体系框架大致建成，你的工作就会全部转交给她，然后你就会调回来…"
                                                                },
                                                                {
                                                                    "id": "705470375",
                                                                    "speaker": "艾玛托",
                                                                    "text": "到时候可要麻烦她了，劳累的工作需要提前用开心的玩耍来对冲！"
                                                                },
                                                                {
                                                                    "id": "705470376",
                                                                    "speaker": "方妮雅",
                                                                    "text": "…好的，她还有好几个月才调去荆夫港，最近应该很闲。"
                                                                },
                                                                {
                                                                    "id": "705470377",
                                                                    "speaker": "方妮雅",
                                                                    "text": "我也是时候转换下心情了。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "705470372",
                                                            "text": "一定去玩！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "705470378",
                            "text": "（还是先不打扰她们了…）"
                        }
                    ]
                }
            ]
        }
    ]
}