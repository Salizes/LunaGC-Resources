{
    "groupId": "2027",
    "total_dialogue_lines": 178,
    "speaker_counts": {
        "Player": 29,
        "伊莲": 14,
        "千织": 16,
        "夏沃蕾": 26,
        "宵宫": 13,
        "小露米埃尔": 7,
        "梅里爱": 11,
        "泽维尔": 8,
        "神里绫人": 15,
        "神里绫华": 21,
        "芙宁娜": 4,
        "蒂蕾娜": 9,
        "那维莱特": 5
    },
    "talks": [
        {
            "talkId": "4013213",
            "initDialog": "401321301",
            "dialogues": [
                {
                    "id": "401321301",
                    "speaker": "泽维尔",
                    "text": "噢，多么好心的人啊，多么幸运的我啊！"
                },
                {
                    "id": "401321302",
                    "speaker": "千织",
                    "text": "…你慢点走。"
                },
                {
                    "id": "401321303",
                    "speaker": "泽维尔",
                    "text": "这就是苦尽甘来，这就是柳暗花明！"
                },
                {
                    "id": "401321304",
                    "speaker": "泽维尔",
                    "text": "噢，我看到了，我的前方是希望！"
                },
                {
                    "id": "401321305",
                    "speaker": "千织",
                    "text": "…你的前方是喷泉，我希望你至少看清这点。"
                }
            ]
        },
        {
            "talkId": "4013214",
            "initDialog": "401321401",
            "dialogues": [
                {
                    "id": "401321401",
                    "speaker": "神里绫人",
                    "text": "…对于以上种种，我所提出的初步想法和合作方向，不知那维莱特先生意下如何？"
                },
                {
                    "id": "401321402",
                    "speaker": "那维莱特",
                    "text": "非常周全的考虑。从神里先生的话语中足以见您良苦用心。不必谦虚。"
                },
                {
                    "id": "401321403",
                    "speaker": "神里绫人",
                    "text": "感谢您的认可。那么，结论是？"
                },
                {
                    "id": "401321404",
                    "speaker": "那维莱特",
                    "text": "……"
                },
                {
                    "id": "401321405",
                    "speaker": "那维莱特",
                    "text": "如果您问的是我个人…出于我自身的倾向，以及我对稻妻文化的印象，我愿意予以充分合作。"
                },
                {
                    "id": "401321406",
                    "speaker": "那维莱特",
                    "text": "但枫丹的运行并不依托于任何一人的私情，我想稻妻也是如此。凡事皆应符合规章。"
                },
                {
                    "id": "401321407",
                    "speaker": "神里绫人",
                    "text": "自然如此。"
                },
                {
                    "id": "401321408",
                    "speaker": "神里绫人",
                    "text": "我会将具体的合作事宜以书面形式交由沫芒宫，一周之内。"
                },
                {
                    "id": "401321409",
                    "speaker": "那维莱特",
                    "text": "期待着您的消息。"
                }
            ]
        },
        {
            "talkId": "4013215",
            "initDialog": "401321501",
            "dialogues": [
                {
                    "id": "401321501",
                    "speaker": "神里绫华",
                    "text": "宵宫尝尝晶螺糕吧。"
                },
                {
                    "id": "401321502",
                    "speaker": "宵宫",
                    "text": "这是绫华点的，绫华先吃。"
                },
                {
                    "id": "401321503",
                    "speaker": "神里绫华",
                    "text": "我是为了宵宫才要的。宵宫很喜欢甜点吧？"
                },
                {
                    "id": "401321504",
                    "speaker": "宵宫",
                    "text": "嘿嘿…既然这样，我们也不要再谦让了！一起吃吧，好不好？"
                },
                {
                    "id": "401321505",
                    "speaker": "神里绫华",
                    "text": "呵呵…好呀。"
                },
                {
                    "id": "401321506",
                    "speaker": "宵宫",
                    "text": "……"
                },
                {
                    "id": "401321507",
                    "speaker": "神里绫华",
                    "text": "……"
                },
                {
                    "id": "401321508",
                    "speaker": "宵宫",
                    "text": "太好吃了！"
                },
                {
                    "id": "401321509",
                    "speaker": "宵宫",
                    "text": "好松软！入口的时候黄油的香气特别馥郁，回味也让人觉得很幸福…"
                },
                {
                    "id": "401321510",
                    "speaker": "神里绫华",
                    "text": "太好了，宵宫很喜欢呢。"
                },
                {
                    "id": "401321511",
                    "speaker": "神里绫华",
                    "text": "我也觉得很好吃，而且，我很喜欢它的花纹。"
                },
                {
                    "id": "401321512",
                    "speaker": "宵宫",
                    "text": "听说是仿造「苍晶螺」的造型做的哦！我从来没有亲眼见过，很好奇它们长什么样子！"
                },
                {
                    "id": "401321513",
                    "speaker": "宵宫",
                    "text": "绫华，你有没有兴趣？要不要找个时间，我们一起去水下找找看？"
                },
                {
                    "id": "401321514",
                    "speaker": "神里绫华",
                    "text": "好啊，要不等下就去？"
                },
                {
                    "id": "401321515",
                    "speaker": "宵宫",
                    "text": "嗯！我还有好多地方想和绫华一起逛的，那就说好了哦！"
                }
            ]
        },
        {
            "talkId": "4013330",
            "initDialog": "401333001",
            "dialogues": [
                {
                    "id": "401333001",
                    "speaker": "夏沃蕾",
                    "text": "怎么了？特巡队队长在灰河长大很奇怪吗？",
                    "choices": [
                        {
                            "id": "401333002",
                            "text": "感觉很意外…",
                            "response": [
                                {
                                    "id": "401333003",
                                    "speaker": "夏沃蕾",
                                    "text": "我也很意外。有段时间，我还觉得自己再也没机会加入警备队了。"
                                },
                                {
                                    "id": "401333006",
                                    "speaker": "夏沃蕾",
                                    "text": "但只要你实力够硬，功绩够多…总有一天会被认可。"
                                },
                                {
                                    "id": "401333007",
                                    "speaker": "夏沃蕾",
                                    "text": "反过来说，灰河也造就了我，在某些方面。"
                                },
                                {
                                    "id": "401333008",
                                    "speaker": "夏沃蕾",
                                    "text": "比如怎样同罪人交易，怎样同罪人一样思考…"
                                },
                                {
                                    "id": "401333009",
                                    "speaker": "夏沃蕾",
                                    "text": "当然，这就当作我们之间的秘密吧。"
                                }
                            ]
                        },
                        {
                            "id": "401333004",
                            "text": "感觉很难…",
                            "response": [
                                {
                                    "id": "401333005",
                                    "speaker": "夏沃蕾",
                                    "text": "爬上来的过程吗？的确很难。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4013525",
            "initDialog": "401352501",
            "dialogues": [
                {
                    "id": "401352501",
                    "speaker": "夏沃蕾",
                    "text": "虽然有些迟了，但…谢谢你愿意陪我调查这个案件。"
                },
                {
                    "id": "401352502",
                    "speaker": "夏沃蕾",
                    "text": "这次不是代表特巡队，而是代表我自己向你表达感谢。",
                    "choices": [
                        {
                            "id": "401352503",
                            "text": "关于你的家人…",
                            "response": [
                                {
                                    "id": "401352504",
                                    "speaker": "夏沃蕾",
                                    "text": "还想听我和父亲的故事吗？"
                                },
                                {
                                    "id": "401352505",
                                    "speaker": "夏沃蕾",
                                    "text": "其实我和他相处的也不算多。特巡队工作很忙，他那时经常很晚才回到家，有时根本不回家。"
                                },
                                {
                                    "id": "401352506",
                                    "speaker": "夏沃蕾",
                                    "text": "有一次，他太久没回家了。可能有一个星期吧。"
                                },
                                {
                                    "id": "401352507",
                                    "speaker": "夏沃蕾",
                                    "text": "当我去街上买东西时，才知道他成了人们口中的「罪人」，而我则成了「罪人的女儿」。"
                                },
                                {
                                    "id": "401352508",
                                    "speaker": "夏沃蕾",
                                    "text": "不过…这个话题还是下次再说吧。"
                                }
                            ]
                        },
                        {
                            "id": "401352509",
                            "text": "关于案件…",
                            "response": [
                                {
                                    "id": "401352510",
                                    "speaker": "夏沃蕾",
                                    "text": "我其实很同情薇若妮卡和她的哥哥。也能理解他们心中的仇恨…"
                                },
                                {
                                    "id": "401352511",
                                    "speaker": "夏沃蕾",
                                    "text": "但这不代表我会纵容他们走上「罪恶」的路。尽管它或许通向另一种「正义」。"
                                }
                            ]
                        },
                        {
                            "id": "401352512",
                            "text": "关于映影…",
                            "response": [
                                {
                                    "id": "401352513",
                                    "speaker": "夏沃蕾",
                                    "text": "映影和现实不同，它是艺术，是人们内心的向往。"
                                },
                                {
                                    "id": "401352514",
                                    "speaker": "夏沃蕾",
                                    "text": "我喜欢《两个铳枪手》，也很高兴出演了其中的主角。"
                                },
                                {
                                    "id": "401352515",
                                    "speaker": "夏沃蕾",
                                    "text": "等它上映的时候，我会去歌剧院看的，观众们一定也喜欢这部映影的结局。"
                                }
                            ]
                        },
                        {
                            "id": "401352516",
                            "text": "你多保重…",
                            "response": [
                                {
                                    "id": "401352517",
                                    "speaker": "夏沃蕾",
                                    "text": "谢谢你的关心，我们颁奖典礼上见。我相信，这部映影一定会得奖的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4013526",
            "initDialog": "401352601",
            "dialogues": [
                {
                    "id": "401352601",
                    "speaker": "千织",
                    "text": "是你们，有什么事吗？",
                    "choices": [
                        {
                            "id": "401352602",
                            "text": "关于「千织屋」…",
                            "response": [
                                {
                                    "id": "401352603",
                                    "speaker": "千织",
                                    "text": "想要定制服务吗？随时欢迎。"
                                },
                                {
                                    "id": "401352606",
                                    "speaker": "Player",
                                    "text": "我们也没做什么…"
                                },
                                {
                                    "id": "401352607",
                                    "speaker": "千织",
                                    "text": "别那么谦虚，你帮了泽维尔、帮了夏沃蕾、绮良良也说她之前受你们照顾…他们都是我朋友。"
                                },
                                {
                                    "id": "401352608",
                                    "speaker": "千织",
                                    "text": "托你们的福，映影也如期上映，我的品牌能被更多人看到。"
                                },
                                {
                                    "id": "401352609",
                                    "speaker": "千织",
                                    "text": "你们所做的，远比你们所认为的多。"
                                }
                            ]
                        },
                        {
                            "id": "401352610",
                            "text": "关于千织的工作…",
                            "response": [
                                {
                                    "id": "401352611",
                                    "speaker": "千织",
                                    "text": "我就是个服装设计师而已，没什么奇怪的副业。"
                                },
                                {
                                    "id": "401352612",
                                    "speaker": "千织",
                                    "text": "只不过做生意的缘故，结交的朋友越来越多，遇到的破事也越来越多。"
                                },
                                {
                                    "id": "401352613",
                                    "speaker": "千织",
                                    "text": "你帮我一个忙，我帮你一个忙…今天你照顾我，明天我照顾你…这就是生意。"
                                }
                            ]
                        },
                        {
                            "id": "401352614",
                            "text": "没什么事了…",
                            "response": [
                                {
                                    "id": "401352615",
                                    "speaker": "千织",
                                    "text": "嗯，回头见。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4013613",
            "initDialog": "401361301",
            "dialogues": [
                {
                    "id": "401361301",
                    "speaker": "千织",
                    "text": "关于映影…"
                },
                {
                    "id": "401361302",
                    "speaker": "千织",
                    "text": "夺得了「芙宁娜」奖，泽维尔可要高兴坏了。说不定下次真会在喷泉里找到他。"
                },
                {
                    "id": "401361303",
                    "speaker": "千织",
                    "text": "来找我定制服装的人也越来越多，店里的人手都不够了。"
                },
                {
                    "id": "401361304",
                    "speaker": "千织",
                    "text": "这么一来，我的梦想…或许又近了一步…"
                },
                {
                    "id": "401361305",
                    "speaker": "千织",
                    "text": "不论如何，「千织屋」永远欢迎你们。不久后的枫丹时装周，也请你们多多捧场。"
                }
            ]
        },
        {
            "talkId": "4013614",
            "initDialog": "401361401",
            "dialogues": [
                {
                    "id": "401361401",
                    "speaker": "神里绫华",
                    "text": "映影终于成功拍完了，我很高兴。这段时间…也承蒙你的关照。",
                    "choices": [
                        {
                            "id": "401361402",
                            "text": "绫华的演技很出色。",
                            "response": [
                                {
                                    "id": "401361403",
                                    "speaker": "神里绫华",
                                    "text": "欸？谢谢…"
                                },
                                {
                                    "id": "401361404",
                                    "speaker": "神里绫华",
                                    "text": "一开始，我抱着不能拖大家后腿的心情努力，想着如果是因为我的原因喊「停」就太丢人了。"
                                },
                                {
                                    "id": "401361405",
                                    "speaker": "神里绫华",
                                    "text": "芙宁娜导演既专业又耐心，夏沃蕾和埃兰小姐也给了我很多细节上的帮助…这才渐渐得心应手起来。"
                                },
                                {
                                    "id": "401361406",
                                    "speaker": "神里绫华",
                                    "text": "虽然这么说，但到了最后，大家…包括你也在夸奖我，我心里还是会有些不好意思的…"
                                }
                            ]
                        },
                        {
                            "id": "401361407",
                            "text": "最近玩得开心吗？",
                            "response": [
                                {
                                    "id": "401361408",
                                    "speaker": "神里绫华",
                                    "text": "嗯，空下来的时候，我和宵宫一起逛了枫丹廷很多地方。"
                                },
                                {
                                    "id": "401361409",
                                    "speaker": "神里绫华",
                                    "text": "优雅的街景，美丽的绿植与花卉，还有像身处梦中一般的海底世界…留下了闪闪发光的回忆。"
                                },
                                {
                                    "id": "401361410",
                                    "speaker": "神里绫华",
                                    "text": "一想到在不久之前，或许你也曾恰好走过这些地方…就有些开心。"
                                }
                            ]
                        },
                        {
                            "id": "401361411",
                            "text": "绫华也辛苦了。",
                            "response": [
                                {
                                    "id": "401361412",
                                    "speaker": "神里绫华",
                                    "text": "哪里。我平时…不太容易得到这样出门的机会。"
                                },
                                {
                                    "id": "401361413",
                                    "speaker": "神里绫华",
                                    "text": "这次不仅交到了新朋友，还跟着大家学到了不少东西，非常有收获。我很珍惜。"
                                },
                                {
                                    "id": "401361414",
                                    "speaker": "神里绫华",
                                    "text": "啊，对了，我还给社奉行的大家带了晶螺糕作为伴手礼。"
                                },
                                {
                                    "id": "401361415",
                                    "speaker": "神里绫华",
                                    "text": "配着咖啡喝，呵呵…说不定就和现在在枫丹的感觉一样呢。"
                                }
                            ]
                        },
                        {
                            "id": "401361416",
                            "text": "回去路上慢点。",
                            "response": [
                                {
                                    "id": "401361417",
                                    "speaker": "神里绫华",
                                    "text": "嗯，谢谢你的关心，你在冒险途中也要照顾好自己哦。"
                                },
                                {
                                    "id": "401361418",
                                    "speaker": "神里绫华",
                                    "text": "有机会的话…我们稻妻再见。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4013615",
            "initDialog": "401361501",
            "dialogues": [
                {
                    "id": "401361501",
                    "speaker": "泽维尔",
                    "text": "芙宁娜大人，请容许我再为您拍摄一张画片吧！我还想要您的签名…作为我们本次合作的留念。"
                },
                {
                    "id": "401361502",
                    "speaker": "芙宁娜",
                    "text": "领奖的时候我可是已经被闪烁的留影机拍够了。"
                },
                {
                    "id": "401361503",
                    "speaker": "泽维尔",
                    "text": "噢…芙宁娜大人，我见过的最好的导演！最上镜的人！您正适合这样热闹又喜庆的场面，我相信所有的摄影师都是这么想的。"
                },
                {
                    "id": "401361504",
                    "speaker": "泽维尔",
                    "text": "来吧，亲爱的大明星，展现！展现您的光芒，留影机正在翘首以待呢！"
                },
                {
                    "id": "401361505",
                    "speaker": "芙宁娜",
                    "text": "就算你把我夸成这个样子…"
                },
                {
                    "id": "401361506",
                    "speaker": "芙宁娜",
                    "text": "唉…好吧，我就勉为其难再摆几个不一样的姿势好了。"
                },
                {
                    "id": "401361507",
                    "speaker": "芙宁娜",
                    "text": "奖杯总可以不拿着吧？"
                },
                {
                    "id": "401361508",
                    "speaker": "泽维尔",
                    "text": "啊…啊！当然！您想怎么来就怎么来！"
                },
                {
                    "id": "401361509",
                    "speaker": "泽维尔",
                    "text": "万分感谢，万分感谢！天啊，我的运气真是好得让我自己都惊讶了！"
                }
            ]
        },
        {
            "talkId": "4013616",
            "initDialog": "401361601",
            "dialogues": [
                {
                    "id": "401361601",
                    "speaker": "夏沃蕾",
                    "text": "宵宫小姐，之前没找到机会说。这几天的事，我很感谢你。"
                },
                {
                    "id": "401361602",
                    "speaker": "宵宫",
                    "text": "欸？我不记得我做了什么特别的事呀。"
                },
                {
                    "id": "401361603",
                    "speaker": "夏沃蕾",
                    "text": "最后那场特殊的演出，我很感谢你的配合。"
                },
                {
                    "id": "401361604",
                    "speaker": "夏沃蕾",
                    "text": "我明白。跟莫里斯单独接触…多少是有些风险的。"
                },
                {
                    "id": "401361605",
                    "speaker": "夏沃蕾",
                    "text": "你并不像我们特巡队，没有经过专业训练…"
                },
                {
                    "id": "401361606",
                    "speaker": "宵宫",
                    "text": "别这么说。我是导演助理，当然就该为剧组里的所有事情出力！能帮夏沃蕾破案，我还觉得荣幸呢。"
                },
                {
                    "id": "401361607",
                    "speaker": "宵宫",
                    "text": "虽然…那时候躺在地上，心跳声是扑通扑通响了好一阵子，我都怕被听出来呢，嘿嘿。"
                },
                {
                    "id": "401361608",
                    "speaker": "夏沃蕾",
                    "text": "你做得很好。"
                },
                {
                    "id": "401361609",
                    "speaker": "宵宫",
                    "text": "对了！如果你要来稻妻的话，记得来长野原烟花店找我哦，我给你做烟花。造型都想好了呢！"
                },
                {
                    "id": "401361610",
                    "speaker": "夏沃蕾",
                    "text": "铳枪？"
                },
                {
                    "id": "401361611",
                    "speaker": "宵宫",
                    "text": "嘿嘿，现在可不告诉你。想知道的话，就亲眼来稻妻看吧！"
                }
            ]
        },
        {
            "talkId": "4013617",
            "initDialog": "401361701",
            "dialogues": [
                {
                    "id": "401361701",
                    "speaker": "神里绫人",
                    "text": "没想到会在这里碰见你。",
                    "choices": [
                        {
                            "id": "401361702",
                            "text": "关于你正在喝的东西…",
                            "response": [
                                {
                                    "id": "401361703",
                                    "speaker": "神里绫人",
                                    "text": "哦，这种叫做「枫达」的饮料，口感新颖，我很喜欢。"
                                },
                                {
                                    "id": "401361704",
                                    "speaker": "神里绫人",
                                    "text": "「畅饮世界」的宣传语也不错，有点想把它也列做「文化交流」的项目之一了。"
                                },
                                {
                                    "id": "401361705",
                                    "speaker": "神里绫人",
                                    "text": "如果往「枫达」里加一些薄荷会怎么样呢？我很在意。"
                                },
                                {
                                    "id": "401361706",
                                    "speaker": "神里绫人",
                                    "text": "不如再勇敢一些，往「枫达」里兑等比例的什锦奶茶…"
                                },
                                {
                                    "id": "401361707",
                                    "speaker": "神里绫人",
                                    "text": "呵呵，感觉并不会好喝呢。"
                                }
                            ]
                        },
                        {
                            "id": "401361708",
                            "text": "关于映影…",
                            "response": [
                                {
                                    "id": "401361709",
                                    "speaker": "神里绫人",
                                    "text": "多亏你们，映影顺利上映， 社奉行也同沫芒宫达成了合作。"
                                },
                                {
                                    "id": "401361710",
                                    "speaker": "神里绫人",
                                    "text": "如果下次还有机会的话，我是不是真的该尝试担任一部电影的主演呢？"
                                },
                                {
                                    "id": "401361711",
                                    "speaker": "神里绫人",
                                    "text": "还是说…在你看来，「反派」这类角色要更适合我？"
                                }
                            ]
                        },
                        {
                            "id": "401361712",
                            "text": "希望回程顺利。",
                            "response": [
                                {
                                    "id": "401361713",
                                    "speaker": "神里绫人",
                                    "text": "谢谢，我会照顾好绫华和宵宫她们的。"
                                },
                                {
                                    "id": "401361714",
                                    "speaker": "神里绫人",
                                    "text": "也愿你今后的旅途顺利。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7467502",
            "initDialog": "746750201",
            "dialogues": [
                {
                    "id": "746750201",
                    "speaker": "小露米埃尔",
                    "text": "怎么样，要尝试拍摄映影吗？",
                    "choices": [
                        {
                            "id": "746750202",
                            "text": "想要试试。",
                            "response": [
                                {
                                    "id": "746750203",
                                    "speaker": "小露米埃尔",
                                    "text": "很好，我已经挑好拍摄场景，演员也已经就位，就等两位去片场开拍了。"
                                }
                            ]
                        },
                        {
                            "id": "746750204",
                            "text": "关于你的兄长…",
                            "response": [
                                {
                                    "id": "746750205",
                                    "speaker": "小露米埃尔",
                                    "text": "露米埃尔年长我很多，不过这不是问题，我们兄弟俩合作无间。"
                                },
                                {
                                    "id": "746750206",
                                    "speaker": "小露米埃尔",
                                    "text": "拍摄《进站》和《工厂大门》的时候，我们还没什么名气。"
                                },
                                {
                                    "id": "746750207",
                                    "speaker": "小露米埃尔",
                                    "text": "所有的事情都是我们兄弟俩一起完成的，因为当时没人愿意给不出名的电影爱好者做助手，哈哈。"
                                },
                                {
                                    "id": "746750208",
                                    "speaker": "小露米埃尔",
                                    "text": "如果你有兴趣的话，可以去看看这两部映影。"
                                }
                            ]
                        },
                        {
                            "id": "746750209",
                            "text": "还没准备好。",
                            "response": [
                                {
                                    "id": "746750210",
                                    "speaker": "小露米埃尔",
                                    "text": "没关系，我能理解，好的作品需要时间沉淀。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7467902",
            "initDialog": "746790201",
            "dialogues": [
                {
                    "id": "746790201",
                    "speaker": "蒂蕾娜",
                    "text": "「超天顶领队级战力」，请问还有什么指示吗？",
                    "choices": [
                        {
                            "id": "746790202",
                            "text": "来一局「千步拦射角分间」！",
                            "response": [
                                {
                                    "id": "746790203",
                                    "speaker": "蒂蕾娜",
                                    "text": "没问题！这个游戏不会真正的消耗弹药，也不用维护靶标。你甚至可以一口气玩几千局，打掉几万个靶标！"
                                }
                            ]
                        },
                        {
                            "id": "746790204",
                            "text": "关于铳枪…",
                            "response": [
                                {
                                    "id": "746790205",
                                    "speaker": "蒂蕾娜",
                                    "text": "嗯？您也想定制铳枪吗？"
                                },
                                {
                                    "id": "746790206",
                                    "speaker": "蒂蕾娜",
                                    "text": "虽然我不明白铳枪的内部原理，但我听同事提到过几位优秀的枪匠。"
                                },
                                {
                                    "id": "746790207",
                                    "speaker": "蒂蕾娜",
                                    "text": "相比量产铳枪，枪匠们仔细打造的产品在使用寿命，精度和弹道稳定上，都有着更卓越的表现…"
                                },
                                {
                                    "id": "746790208",
                                    "speaker": "蒂蕾娜",
                                    "text": "如果使用严格控制公差的优质弹药，更是能打出令人瞠目结舌的成绩！"
                                },
                                {
                                    "id": "746790209",
                                    "speaker": "蒂蕾娜",
                                    "text": "不过，我记得一般市民不能随意持有铳枪来着，好像要走一套相当复杂的流程…"
                                },
                                {
                                    "id": "746790210",
                                    "speaker": "蒂蕾娜",
                                    "text": "等到我回了「特巡队」的驻地，我帮您好好问问！"
                                }
                            ]
                        },
                        {
                            "id": "746790211",
                            "text": "回见！",
                            "response": [
                                {
                                    "id": "746790212",
                                    "speaker": "蒂蕾娜",
                                    "text": "您客气了，「超天顶领队级战力」！我随时在这里恭候您的到来！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7468002",
            "initDialog": "746800201",
            "dialogues": [
                {
                    "id": "746800201",
                    "speaker": "伊莲",
                    "text": "虽然神医们已经承诺帮我进行测试了，但还是有点不安…"
                },
                {
                    "id": "746800202",
                    "speaker": "伊莲",
                    "text": "这心神不宁的感觉，果然…甲方的恐怖，不是那么轻松就能摆脱的！",
                    "choices": [
                        {
                            "id": "746800203",
                            "text": "你还好吗？",
                            "response": [
                                {
                                    "id": "746800204",
                                    "speaker": "伊莲",
                                    "text": "啊！你回来了，神医！不好意思我走神了…"
                                },
                                {
                                    "id": "746800205",
                                    "speaker": "伊莲",
                                    "text": "我一直在想，难道真的我没有办法摆脱甲方的阴影了吗？"
                                },
                                {
                                    "id": "746800206",
                                    "speaker": "伊莲",
                                    "text": "难道真的要像神医您说的那样…设法先干掉老板？"
                                },
                                {
                                    "id": "746800207",
                                    "speaker": "伊莲",
                                    "text": "我，我得好好思考一下！"
                                }
                            ]
                        },
                        {
                            "id": "746800208",
                            "text": "关于「稳像平台」…",
                            "response": [
                                {
                                    "id": "746800209",
                                    "speaker": "伊莲",
                                    "text": "咦？神医您…对机械原理感兴趣吗？"
                                },
                                {
                                    "id": "746800210",
                                    "speaker": "伊莲",
                                    "text": "其实也没什么新奇的技术，我只是从几个已废弃项目的相关资料里找到了部分技术成果…"
                                },
                                {
                                    "id": "746800211",
                                    "speaker": "伊莲",
                                    "text": "听说以前啊，有一群很有才华的工程师…他们想让船上的火炮在超大的风浪中稳定地射击。"
                                },
                                {
                                    "id": "746800212",
                                    "speaker": "伊莲",
                                    "text": "为此，他们废寝忘食，才研发出一种能在垂直层面上稳定武器的机构。"
                                },
                                {
                                    "id": "746800213",
                                    "speaker": "伊莲",
                                    "text": "虽然这些项目最后全都被放弃了，不过我通过零碎的文件，一定程度还原了它的稳定装置。"
                                },
                                {
                                    "id": "746800214",
                                    "speaker": "伊莲",
                                    "text": "将它小型化后，就生产出了现在的「稳像机关」。"
                                },
                                {
                                    "id": "746800215",
                                    "speaker": "伊莲",
                                    "text": "不知道这种机关最后的销路究竟如何啊…"
                                }
                            ]
                        },
                        {
                            "id": "746800216",
                            "text": "（默然离去…）",
                            "response": [
                                {
                                    "id": "746800217",
                                    "speaker": "伊莲",
                                    "text": "怎么办啊，到底怎么办啊…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7468102",
            "initDialog": "746810201",
            "dialogues": [
                {
                    "id": "746810201",
                    "speaker": "梅里爱",
                    "text": "如何？我的「实验映影」和「特技光效」很华丽吧？",
                    "choices": [
                        {
                            "id": "746810202",
                            "text": "还没玩够…",
                            "response": [
                                {
                                    "id": "746810203",
                                    "speaker": "梅里爱",
                                    "text": "这就对了，我果然没看走眼！"
                                },
                                {
                                    "id": "746810204",
                                    "speaker": "梅里爱",
                                    "text": "你会有这种感觉，说明你很享受拍摄动作戏的体验。"
                                },
                                {
                                    "id": "746810205",
                                    "speaker": "梅里爱",
                                    "text": "去吧，「千灵映影节」期间，我的映影棚始终对你开放，尽管沉浸在映影之中吧！"
                                },
                                {
                                    "id": "746810206",
                                    "speaker": "梅里爱",
                                    "text": "我可是准备了用不完的底片，无论你想多拍多少组镜头，都可以尽情发挥！"
                                }
                            ]
                        },
                        {
                            "id": "746810207",
                            "text": "影片什么时候正式上映？",
                            "response": [
                                {
                                    "id": "746810208",
                                    "speaker": "梅里爱",
                                    "text": "这可就说不准了…"
                                },
                                {
                                    "id": "746810209",
                                    "speaker": "梅里爱",
                                    "text": "就算你和你的文戏替身顺利拍完所有镜头，剪辑调色和音效处理等环节也要花费许多时间…"
                                },
                                {
                                    "id": "746810210",
                                    "speaker": "梅里爱",
                                    "text": "甚至，等到正式宣传和放出预告时，这些工作都不一定能完成。"
                                },
                                {
                                    "id": "746810211",
                                    "speaker": "梅里爱",
                                    "text": "不过，我们的每项工作都不会白费。哪怕只是多打磨了一两天，最终上映时，映影的质量都会有一定程度的提升！"
                                },
                                {
                                    "id": "746810212",
                                    "speaker": "梅里爱",
                                    "text": "所以，请耐心一点，我的合作伙伴。"
                                }
                            ]
                        },
                        {
                            "id": "746810213",
                            "text": "告辞了…",
                            "response": [
                                {
                                    "id": "746810214",
                                    "speaker": "梅里爱",
                                    "text": "再见，记得有空的时候多去映影棚拍几组镜头哦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}