{
    "groupId": "2006",
    "total_dialogue_lines": 42,
    "speaker_counts": {
        "Player": 11,
        "慕珍": 29,
        "派蒙": 2
    },
    "talks": [
        {
            "talkId": "7265202",
            "initDialog": "726520201",
            "dialogues": [
                {
                    "id": "726520201",
                    "speaker": "慕珍",
                    "text": "唉，跟着北斗大姐头走遍七国，才觉得还是璃月老家好…"
                },
                {
                    "id": "726520202",
                    "speaker": "慕珍",
                    "text": "嘿嘿，虽说我也没怎么下过船。"
                },
                {
                    "id": "726520203",
                    "speaker": "Player",
                    "text": "关于北斗的下一段航程…"
                },
                {
                    "id": "726520204",
                    "speaker": "慕珍",
                    "text": "抱歉，保密！我只能告诉你，我们接下来会去须弥。"
                },
                {
                    "id": "726520205",
                    "speaker": "慕珍",
                    "text": "别的我就不多说啦，我也建议你别多问。"
                },
                {
                    "id": "726520206",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "726520207",
                    "speaker": "慕珍",
                    "text": "嗯嗯，一路顺风！"
                }
            ]
        },
        {
            "talkId": "7265302",
            "initDialog": "726530201",
            "dialogues": [
                {
                    "id": "726530201",
                    "speaker": "慕珍",
                    "text": "现在的话，大致能够判断遗迹机械所在的范围…但还没办法确切定位。",
                    "choices": [
                        {
                            "id": "726530202",
                            "text": "岸上风景如何？",
                            "response": [
                                {
                                    "id": "726530203",
                                    "speaker": "慕珍",
                                    "text": "你说这里吗？比起船舱里，视野倒是开阔了不少…挺不错的。"
                                },
                                {
                                    "id": "726530204",
                                    "speaker": "慕珍",
                                    "text": "唔，不过我不太喜欢岸上的空气，比起船舱里的空气少了点「料」…让我脑袋都慢了半拍。"
                                },
                                {
                                    "id": "726530205",
                                    "speaker": "慕珍",
                                    "text": "嗯…岸上适合观景，但不适合思考。"
                                },
                                {
                                    "id": "726530208",
                                    "speaker": "慕珍",
                                    "text": "所以我才在这里无所事事嘛，接下来全看你的了！"
                                },
                                {
                                    "id": "726530209",
                                    "speaker": "派蒙",
                                    "text": "这家伙，一点没有求人的自觉吗！"
                                },
                                {
                                    "id": "726530210",
                                    "speaker": "慕珍",
                                    "text": "嘿嘿~"
                                }
                            ]
                        },
                        {
                            "id": "726530206",
                            "text": "研究进展如何？",
                            "response": [
                                {
                                    "id": "726530207",
                                    "speaker": "慕珍",
                                    "text": "不太好。唔，准确点说，是停滞。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7265402",
            "initDialog": "726540201",
            "dialogues": [
                {
                    "id": "726540201",
                    "speaker": "慕珍",
                    "text": "呼，就差一步了，这次任务结束后，我也可以回到船上了！",
                    "choices": [
                        {
                            "id": "726540202",
                            "text": "你看起来很开心。",
                            "response": [
                                {
                                    "id": "726540204",
                                    "speaker": "慕珍",
                                    "text": "还好啦，我也在岸上待够了，研究进展一片大好，样品订单马上就要有着落了！"
                                },
                                {
                                    "id": "726540205",
                                    "speaker": "慕珍",
                                    "text": "哼哼，这次的订单完全没有依赖大姐头就办成了，等她回来，也一定会惊讶于我们的成长吧！"
                                },
                                {
                                    "id": "726540206",
                                    "speaker": "Player",
                                    "text": "你是说让我跑腿这件事？"
                                },
                                {
                                    "id": "726540207",
                                    "speaker": "慕珍",
                                    "text": "啊，对…还有你的成长！旅行者的成长也是有目共睹的！"
                                },
                                {
                                    "id": "726540208",
                                    "speaker": "派蒙",
                                    "text": "原来北斗大姐头的手下也可以这么不靠谱的吗…"
                                }
                            ]
                        },
                        {
                            "id": "726540203",
                            "text": "最近进展如何？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7265504",
            "initDialog": "726550401",
            "dialogues": [
                {
                    "id": "726550401",
                    "speaker": "慕珍",
                    "text": "哈啊——好困…岸上有什么好的…"
                },
                {
                    "id": "726550402",
                    "speaker": "慕珍",
                    "text": "啊，旅行者，你好！这阵子辛苦你了。"
                },
                {
                    "id": "726550403",
                    "speaker": "慕珍",
                    "text": "多亏了你的努力，旅行者！现在我们终于能够给大姐头交差了。",
                    "choices": [
                        {
                            "id": "726550404",
                            "text": "谁会想要这种东西…",
                            "response": [
                                {
                                    "id": "726550406",
                                    "speaker": "慕珍",
                                    "text": "看起来很危险，对吧？"
                                },
                                {
                                    "id": "726550407",
                                    "speaker": "慕珍",
                                    "text": "既然目的地是须弥，恐怕只有那些奇奇怪怪的「学者」会研究这种东西吧。"
                                },
                                {
                                    "id": "726550408",
                                    "speaker": "慕珍",
                                    "text": "可不是那些天天在外面转悠的游学者。我想他们更类似我这种人，是些整天闷在学斋里研究物件的「技术员」。"
                                },
                                {
                                    "id": "726550409",
                                    "speaker": "慕珍",
                                    "text": "而且我猜在那座遗迹里不止这几台机械…"
                                },
                                {
                                    "id": "726550410",
                                    "speaker": "慕珍",
                                    "text": "如果你还有兴趣的话，可以继续探索那座遗迹，然后把取得的零件交给我们，报酬不会少的！"
                                },
                                {
                                    "id": "726550411",
                                    "speaker": "慕珍",
                                    "text": "毕竟这种贵重商品不论对于我们，还是须弥的客户而言，都是多多益善嘛！",
                                    "choices": [
                                        {
                                            "id": "726550412",
                                            "text": "你还没有回船上？",
                                            "response": [
                                                {
                                                    "id": "726550414",
                                                    "speaker": "慕珍",
                                                    "text": "是啊，属于我的工作基本完成了，等到货物分检完毕之后，才是我插手的时候。"
                                                },
                                                {
                                                    "id": "726550415",
                                                    "speaker": "慕珍",
                                                    "text": "于是我就又被海龙大哥赶到岸上来咯。"
                                                },
                                                {
                                                    "id": "726550416",
                                                    "speaker": "慕珍",
                                                    "text": "「别总是闷在船上，多吹吹海风对你身体有好处。」哼，什么人嘛！"
                                                },
                                                {
                                                    "id": "726550417",
                                                    "speaker": "慕珍",
                                                    "text": "哈啊…没有别的事的话，请让我打会盹吧。实在不好意思…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "726550413",
                                            "text": "你还在这里？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "726550405",
                            "text": "这些零件有点邪门。"
                        }
                    ]
                }
            ]
        }
    ]
}