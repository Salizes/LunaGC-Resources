{
    "groupId": "5012",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Player": 12,
        "立本": 27
    },
    "talks": [
        {
            "talkId": "4122001",
            "initDialog": "412200756",
            "dialogues": [
                {
                    "id": "412200756",
                    "speaker": "立本",
                    "text": "小友，又见面了。"
                },
                {
                    "id": "412200757",
                    "speaker": "Player",
                    "text": "立本，最近去哪里发财了啊？"
                },
                {
                    "id": "412200758",
                    "speaker": "立本",
                    "text": "嘿，谈不上发财。甚至可以说有点小亏。"
                },
                {
                    "id": "412200759",
                    "speaker": "立本",
                    "text": "之前生意做到了「沃陆之邦」，结果那里人看了眼我的蘑菇说："
                },
                {
                    "id": "412200760",
                    "speaker": "立本",
                    "text": "「一般，感觉…不如蘑菇魔神。」"
                },
                {
                    "id": "412200761",
                    "speaker": "立本",
                    "text": "蘑菇魔神是个啥啊，新品种食用蕈子吗？"
                },
                {
                    "id": "412200762",
                    "speaker": "立本",
                    "text": "不过有钱没钱，都要回家过海灯节的嘛。最近打算跑点短程商路，比如荆夫港之类的。",
                    "choices": [
                        {
                            "id": "412200763",
                            "text": "哦，是荆夫港啊！",
                            "response": [
                                {
                                    "id": "412200765",
                                    "speaker": "立本",
                                    "text": "就在蒙德北边啊。小友你没去过吗？"
                                },
                                {
                                    "id": "412200766",
                                    "speaker": "Player",
                                    "text": "嗯，有人摁着我「以后再去探索吧」。"
                                },
                                {
                                    "id": "412200767",
                                    "speaker": "立本",
                                    "text": "那是个靠运输和花卉种植业的港镇，看着就养人。"
                                },
                                {
                                    "id": "412200768",
                                    "speaker": "立本",
                                    "text": "那里曾经也有个挺有名的山中疗养院，不过在前几年拆了。"
                                },
                                {
                                    "id": "412200769",
                                    "speaker": "立本",
                                    "text": "说到这个就有点瘆人了。那山中的疗养院，居然有个恐怖传说——"
                                },
                                {
                                    "id": "412200770",
                                    "speaker": "立本",
                                    "text": "「一旦去过疗养院，人就会永远留在魔性的山中。」"
                                },
                                {
                                    "id": "412200771",
                                    "speaker": "Player",
                                    "text": "因为太舒服，所以不想走了？"
                                },
                                {
                                    "id": "412200772",
                                    "speaker": "立本",
                                    "text": "这么一想就不恐怖了。说不定真的是因为山里空气不错又远离尘嚣呢。"
                                },
                                {
                                    "id": "412200773",
                                    "speaker": "立本",
                                    "text": "唉，真不错啊，住在山里。想想就不错。"
                                },
                                {
                                    "id": "412200774",
                                    "speaker": "Player",
                                    "text": "璃月好山好水也很多啊。"
                                },
                                {
                                    "id": "412200775",
                                    "speaker": "立本",
                                    "text": "是极。但是没人开发这种业务，一个人住山里愁吃愁喝，还怕被野兽叼走了。"
                                },
                                {
                                    "id": "412200776",
                                    "speaker": "立本",
                                    "text": "还得是花钱的山中休养、亲近自然疗程才舒服。"
                                },
                                {
                                    "id": "412200777",
                                    "speaker": "立本",
                                    "text": "住疗养院得花钱，那我得赶紧赚钱了。咱们还是老样子？"
                                }
                            ]
                        },
                        {
                            "id": "412200764",
                            "text": "啊，荆夫港？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4122002",
            "initDialog": "412200202",
            "dialogues": [
                {
                    "id": "412200202",
                    "speaker": "立本",
                    "text": "是你啊，有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "4122003",
            "initDialog": "412200303",
            "dialogues": [
                {
                    "id": "412200303",
                    "speaker": "Player",
                    "text": "想领取奇货匣。"
                },
                {
                    "id": "412200302",
                    "speaker": "立本",
                    "text": "今天需要的东西是这样的。"
                }
            ]
        },
        {
            "talkId": "4122004",
            "initDialog": "412200403",
            "dialogues": [
                {
                    "id": "412200403",
                    "speaker": "Player",
                    "text": "想领取奇货匣。"
                },
                {
                    "id": "412200402",
                    "speaker": "立本",
                    "text": "今天的已经兑换过了。其他的奇货匣可以随意查看，都是好东西。"
                }
            ]
        },
        {
            "talkId": "4122005",
            "initDialog": "412200543",
            "dialogues": [
                {
                    "id": "412200543",
                    "speaker": "Player",
                    "text": "再介绍一下你自己？"
                },
                {
                    "id": "412200544",
                    "speaker": "立本",
                    "text": "我叫立本，曾经是一个奇货商人。"
                },
                {
                    "id": "412200545",
                    "speaker": "立本",
                    "text": "为了给自己赚笔钱休大假，正在努力工作。"
                },
                {
                    "id": "412200546",
                    "speaker": "Player",
                    "text": "你说的生意是…"
                },
                {
                    "id": "412200547",
                    "speaker": "立本",
                    "text": "我会用这些装了各种宝贝的奇货匣子来兑换一些食材原料、日用百货。"
                },
                {
                    "id": "412200548",
                    "speaker": "立本",
                    "text": "这些匣子里的东西都是我奇货商时期的家底，绝对童叟无欺。"
                },
                {
                    "id": "412200549",
                    "speaker": "立本",
                    "text": "至于你问为什么弄成随机红包？"
                },
                {
                    "id": "412200550",
                    "speaker": "立本",
                    "text": "好像很多人喜欢这口，弄成这样大家好像就更有干劲了。"
                },
                {
                    "id": "412200551",
                    "speaker": "Player",
                    "text": "那你怎么赚钱呢？"
                },
                {
                    "id": "412200552",
                    "speaker": "立本",
                    "text": "听说至冬在全民节衣缩食。应该是有商机的。"
                }
            ]
        },
        {
            "talkId": "4122006",
            "initDialog": "412200601",
            "dialogues": [
                {
                    "id": "412200601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "412200602",
                    "speaker": "立本",
                    "text": "回见。"
                }
            ]
        }
    ]
}