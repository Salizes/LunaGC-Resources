{
    "talkId": "7550102",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 6,
        "「炫彩呆子」": 15,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "755010201",
            "speaker": "派蒙",
            "text": "咦，「炫彩呆子」？你在这附近考察涂鸦的地点吗？"
        },
        {
            "id": "755010202",
            "speaker": "「炫彩呆子」",
            "text": "啊呀，你们刚好也来这边了。看来你们确实挺有天赋的，能准确选中最有潜力的景致…"
        },
        {
            "id": "755010203",
            "speaker": "派蒙",
            "text": "嘿嘿，那可不是嘛！我们要么找不到灵感，要么就灵感如泉涌！",
            "choices": [
                {
                    "id": "755010204",
                    "text": "你要在这里工作吗？",
                    "response": [
                        {
                            "id": "755010206",
                            "speaker": "派蒙",
                            "text": "对喔，我还没看过一幅涂鸦完整画出来的流程呢，要不然，你现在就给我们演示一下？"
                        },
                        {
                            "id": "755010207",
                            "speaker": "「炫彩呆子」",
                            "text": "别心急，别心急。这附近并没有特别合适的山壁，前卫的涂鸦当然也需要前卫的画板！"
                        },
                        {
                            "id": "755010208",
                            "speaker": "「炫彩呆子」",
                            "text": "我只是刚好路过这片区域，想起以前和一位朋友在这边野餐的经历，再过来看看。"
                        },
                        {
                            "id": "755010209",
                            "speaker": "「炫彩呆子」",
                            "text": "要不是那位朋友的鼓励，我可能还是个一声不吭，只顾着闷头涂鸦的普通画手，根本领略不到最前卫的艺术理念。"
                        },
                        {
                            "id": "755010210",
                            "speaker": "「炫彩呆子」",
                            "text": "更不会认识你们了。"
                        },
                        {
                            "id": "755010211",
                            "speaker": "派蒙",
                            "text": "嗯？听起来是…给了你重要人生建议的挚友！",
                            "choices": [
                                {
                                    "id": "755010212",
                                    "text": "就像一起旅行的派蒙和我？",
                                    "response": [
                                        {
                                            "id": "755010214",
                                            "speaker": "「炫彩呆子」",
                                            "text": "你们好像大部分时间都待在一起？那倒没有你们感情这么好啦…"
                                        },
                                        {
                                            "id": "755010215",
                                            "speaker": "「炫彩呆子」",
                                            "text": "好几年前，我在圣火竞技场的颜料店学习调色，遇见了那位朋友，她的衣服有着独特的配色，瞬间就吸引了我。"
                                        },
                                        {
                                            "id": "755010216",
                                            "speaker": "「炫彩呆子」",
                                            "text": "别人都说，我思考颜料和色彩时，就像丢了魂一样，动不动就没了反应，不怎么带我玩。"
                                        },
                                        {
                                            "id": "755010217",
                                            "speaker": "「炫彩呆子」",
                                            "text": "但她不这么觉得，她认为我的「呆」，正代表我坚持自己的目标，什么都不在乎，就像正在修行的部族战士。"
                                        },
                                        {
                                            "id": "755010218",
                                            "speaker": "「炫彩呆子」",
                                            "text": "虽说不是特别煽情的鼓励，但她确实给了我澎湃的动力。以至于，这些年我没怎么和她打交道，也一直记得她的话。"
                                        },
                                        {
                                            "id": "755010219",
                                            "speaker": "「炫彩呆子」",
                                            "text": "她没有涂鸦的天分，这不要紧，后来她成为了厉害的部族战士。我想，总有一天，「回声之子」会以她为傲…"
                                        },
                                        {
                                            "id": "755010220",
                                            "speaker": "派蒙",
                                            "text": "原来还有这种事…不经常一起玩的朋友，也能相互鼓舞！",
                                            "choices": [
                                                {
                                                    "id": "755010221",
                                                    "text": "希望你们都能进步。",
                                                    "response": [
                                                        {
                                                            "id": "755010223",
                                                            "speaker": "「炫彩呆子」",
                                                            "text": "这你就放一万个心吧！"
                                                        },
                                                        {
                                                            "id": "755010224",
                                                            "speaker": "「炫彩呆子」",
                                                            "text": "惊险和意外只是一时的，她肯定能克服难关，我相信她！"
                                                        },
                                                        {
                                                            "id": "755010225",
                                                            "speaker": "「炫彩呆子」",
                                                            "text": "我也不能闲着，涂鸦技法的提升空间是无限的，融入最近我对「前卫艺术」的理解后，我肯定能迅猛进步！"
                                                        },
                                                        {
                                                            "id": "755010226",
                                                            "speaker": "「炫彩呆子」",
                                                            "text": "等她凯旋，我要争取为她创作一幅巨大的涂鸦！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "755010222",
                                                    "text": "祝你们顺利地向上冲击。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "755010213",
                                    "text": "你的朋友也跟你一起涂鸦？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "755010205",
                    "text": "展示一下涂鸦的手艺？"
                }
            ]
        }
    ]
}