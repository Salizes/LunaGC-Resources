    "dialogues": [
        {
            "id": "402092001",
            "speaker": "伊涅芙",
            "text": "#你们好，{NICKNAME}和派蒙，欢迎来到「噼里啪啦守卫团」的展示区。要体验一下基本的教学说明吗？",
            "choices": [
                {
                    "id": "402092002",
                    "text": "说明？感觉可以学学…",
                    "response": [
                        {
                            "id": "402092003",
                            "speaker": "伊涅芙",
                            "text": "好的，现在开始加载教学流程。"
                        },
                        {
                            "id": "402092004",
                            "speaker": "派蒙",
                            "text": "哦哦哦，还有专门的教学，好周到！"
                        },
                        {
                            "id": "402092005",
                            "speaker": "伊涅芙",
                            "text": "爱诺希望前来体验的人除了了解「噼里啪啦守卫团」的运作机理之外，还能感受到它带来的乐趣，因此专门设计了教学流程。"
                        },
                        {
                            "id": "402092006",
                            "speaker": "派蒙",
                            "text": "居然这么认真嘛？看来爱诺真的很喜欢这套作品…"
                        },
                        {
                            "id": "402092007",
                            "speaker": "伊涅芙",
                            "text": "教学说明马上开始，请做好准备。"
                        }
                    ]
                },
                {
                    "id": "402092008",
                    "text": "我还有些事。",
                    "response": [
                        {
                            "id": "402092009",
                            "speaker": "伊涅芙",
                            "text": "了解，等你腾出时间，随时可以过来继续教学，我会在此等待。"
                        },
                        {
                            "id": "402092010",
                            "speaker": "派蒙",
                            "text": "待会儿再见啦，伊涅芙！"
                        }
                    ]
                }
            ]
        }
    ]
}