{
    "talkId": "7451502",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 6,
        "胡塞尼": 10
    },
    "dialogues": [
        {
            "id": "745150201",
            "speaker": "胡塞尼",
            "text": "怎么样，实验进行的还顺利吗？",
            "choices": [
                {
                    "id": "745150202",
                    "text": "还可以。",
                    "response": [
                        {
                            "id": "745150203",
                            "speaker": "胡塞尼",
                            "text": "原盘的运行还算稳定，数据的记录也很清晰，如果是平时的话，我肯定会高兴得不得了吧。"
                        },
                        {
                            "id": "745150204",
                            "speaker": "胡塞尼",
                            "text": "不过，在实际观赏了你的战斗表现后，我感觉「胡塞尼原盘」还有很大的改进空间。",
                            "choices": [
                                {
                                    "id": "745150205",
                                    "text": "毕竟我是战斗大师。",
                                    "response": [
                                        {
                                            "id": "745150206",
                                            "speaker": "胡塞尼",
                                            "text": "哈哈，的确如此。所以我也得继续努力才行。"
                                        }
                                    ]
                                },
                                {
                                    "id": "745150207",
                                    "text": "能发现问题总是好的。",
                                    "response": [
                                        {
                                            "id": "745150208",
                                            "speaker": "胡塞尼",
                                            "text": "#没错，而且我已经有了改进的思路。这场实验非常有收获，谢谢你，{NICKNAME}。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "745150209",
                    "text": "你好像不咳嗽了？",
                    "response": [
                        {
                            "id": "745150210",
                            "speaker": "胡塞尼",
                            "text": "你这么一说，好像的确如此…自从「胡塞尼原盘」有了一定的进展后，我的咳嗽就好了。"
                        },
                        {
                            "id": "745150211",
                            "speaker": "胡塞尼",
                            "text": "或许，这就是医师们说的——「愉悦的心情才是治愈疾病的万能良药」吧？",
                            "choices": [
                                {
                                    "id": "745150212",
                                    "text": "祝你顺利。",
                                    "response": [
                                        {
                                            "id": "745150213",
                                            "speaker": "胡塞尼",
                                            "text": "#谢谢你，{NICKNAME}。"
                                        }
                                    ]
                                },
                                {
                                    "id": "745150214",
                                    "text": "那毕业困难的疾病呢？",
                                    "response": [
                                        {
                                            "id": "745150215",
                                            "speaker": "胡塞尼",
                                            "text": "这就要看我导师的心情了。"
                                        },
                                        {
                                            "id": "745150216",
                                            "speaker": "胡塞尼",
                                            "text": "当然，理论上只要「胡塞尼原盘」的表现达到了设计预期，他就算不想开心也得开心了，哈哈。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}