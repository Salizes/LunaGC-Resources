{
    "talkId": "4018937",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "哈贾娜德": 9
    },
    "dialogues": [
        {
            "id": "401893701",
            "speaker": "哈贾娜德",
            "text": "嘿嘿…呵呵…啊哈哈哈哈哈…小动物们…要开开心心喔，我给你们煮好吃的…",
            "choices": [
                {
                    "id": "401893702",
                    "text": "你正常点，我害怕…",
                    "response": [
                        {
                            "id": "401893703",
                            "speaker": "哈贾娜德",
                            "text": "啊！对不起对不起，我只是被小动物们治愈了，心情特别好…笑得有些得意忘形。"
                        },
                        {
                            "id": "401893704",
                            "speaker": "哈贾娜德",
                            "text": "我是好人！我有签合同的，绝不会也没理由伤害小动物们！"
                        },
                        {
                            "id": "401893705",
                            "speaker": "哈贾娜德",
                            "text": "而且，作为一个新人学者，就算我能从枫丹跑掉，也不可能从悉般多摩学院跑掉，请相信我！"
                        },
                        {
                            "id": "401893706",
                            "speaker": "哈贾娜德",
                            "text": "唉，什么时候能改掉这个傻笑的毛病…"
                        }
                    ]
                },
                {
                    "id": "401893707",
                    "text": "你自己开心吗？",
                    "response": [
                        {
                            "id": "401893708",
                            "speaker": "哈贾娜德",
                            "text": "当然啦！好不容易当上了学者，庆祝性休个假，就遇上了枫丹的庆典，边玩边挣外快…"
                        },
                        {
                            "id": "401893709",
                            "speaker": "哈贾娜德",
                            "text": "话说回来，我能写出决定性的论文，正式当上学者，也都是托了老板你的福呢。"
                        },
                        {
                            "id": "401893710",
                            "speaker": "哈贾娜德",
                            "text": "要不然，给我工资减半，就当是报答你吧？"
                        }
                    ]
                },
                {
                    "id": "401893711",
                    "text": "要注意动物们的食谱…",
                    "response": [
                        {
                            "id": "401893712",
                            "speaker": "哈贾娜德",
                            "text": "肯定的，我有牢牢记住最安全的营养物质配方！这可比配制药剂简单多了，不可能出错！"
                        }
                    ]
                }
            ]
        }
    ]
}