{
    "talkId": "7651106",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "枫原万叶": 13
    },
    "dialogues": [
        {
            "id": "765110601",
            "speaker": "枫原万叶",
            "text": "近些日子，一切顺利吗？",
            "choices": [
                {
                    "id": "765110602",
                    "text": "劳累减轻了。",
                    "response": [
                        {
                            "id": "765110603",
                            "speaker": "枫原万叶",
                            "text": "但我听说，你还是和往常一样，频频奔走在危险的前沿，向各界人士伸出援手。"
                        },
                        {
                            "id": "765110604",
                            "speaker": "枫原万叶",
                            "text": "或许，你找到了诀窍，在平衡战斗与休憩的比值这件事上，已然得心应手了？"
                        },
                        {
                            "id": "765110605",
                            "speaker": "枫原万叶",
                            "text": "若是如此，我也要向你请教其中的门道啊。"
                        }
                    ]
                },
                {
                    "id": "765110606",
                    "text": "万叶最近怎么样？",
                    "response": [
                        {
                            "id": "765110607",
                            "speaker": "枫原万叶",
                            "text": "感谢关心，一切都好。"
                        },
                        {
                            "id": "765110608",
                            "speaker": "枫原万叶",
                            "text": "大姐头推荐我来挪德卡莱，原本是让我领略不同以往的「自然」之声。"
                        },
                        {
                            "id": "765110609",
                            "speaker": "枫原万叶",
                            "text": "我也顺带替平藏拜访了他的冒险家朋友，带了几件伴手礼。"
                        },
                        {
                            "id": "765110610",
                            "speaker": "枫原万叶",
                            "text": "得知这次比拼后，我想，这是开阔眼界的好机会，便答应下来。"
                        },
                        {
                            "id": "765110611",
                            "speaker": "枫原万叶",
                            "text": "毕竟，前路尚远，可不能疏于精进武艺。"
                        },
                        {
                            "id": "765110612",
                            "speaker": "枫原万叶",
                            "text": "此地的愚人众并未与我发生过冲突，似乎还与你维持着某种合作关系。所以，我会以中立的态度对待他们。"
                        },
                        {
                            "id": "765110613",
                            "speaker": "枫原万叶",
                            "text": "了解一下不同愚人众的战法，也是百利而无一弊。"
                        },
                        {
                            "id": "765110614",
                            "speaker": "枫原万叶",
                            "text": "#这回要多多劳烦你了，{NICKNAME}，引导他们使出全部本领吧。"
                        }
                    ]
                },
                {
                    "id": "765110615",
                    "text": "待会儿再一起聊天，万叶。",
                    "response": [
                        {
                            "id": "765110616",
                            "speaker": "枫原万叶",
                            "text": "嗯，不必心急，你先忙要紧的事。"
                        }
                    ]
                }
            ]
        }
    ]
}