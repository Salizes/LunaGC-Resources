    "dialogues": [
        {
            "id": "705350501",
            "speaker": "可莉",
            "text": "#荣誉骑士{M#哥哥}{F#姐姐}和小派蒙，可莉和你们一起玩「嘟嘟可轰轰奇遇记」的时候，特别开心！谢谢你们陪可莉。",
            "choices": [
                {
                    "id": "705350502",
                    "text": "超级开心，再来一局！",
                    "response": [
                        {
                            "id": "705350503",
                            "speaker": "可莉",
                            "text": "好耶，我们再来一局！"
                        }
                    ]
                },
                {
                    "id": "705350504",
                    "text": "等下要送可莉回去吗？",
                    "response": [
                        {
                            "id": "705350505",
                            "speaker": "可莉",
                            "text": "啊…对哦，不能玩到太晚。可莉还是要好好听话，早点回家睡觉的。"
                        },
                        {
                            "id": "705350506",
                            "speaker": "可莉",
                            "text": "可莉认得回家的路，嘿嘿，我们白天再见！"
                        }
                    ]
                },
                {
                    "id": "705350507",
                    "text": "先休息一下，待会儿再继续玩！",
                    "response": [
                        {
                            "id": "705350508",
                            "speaker": "可莉",
                            "text": "#好呀，如果荣誉骑士{M#哥哥}{F#姐姐}有什么事的话，可以先去忙哦。"
                        },
                        {
                            "id": "705350509",
                            "speaker": "可莉",
                            "text": "反正时间有很多，白天的时候，可莉都在这里等你们！"
                        }
                    ]
                }
            ]
        }
    ]
}