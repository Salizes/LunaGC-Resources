{
    "talkId": "7567406",
    "total_dialogue_lines": 40,
    "speaker_counts": {
        "Player": 12,
        "卡齐娜": 28
    },
    "dialogues": [
        {
            "id": "756740601",
            "speaker": "卡齐娜",
            "text": "师父！玩得还开心嘛？"
        },
        {
            "id": "756740602",
            "speaker": "卡齐娜",
            "text": "芭芭拉和妮露姐姐说，玛拉妮做的蒙德纳塔融合菜很厉害，如果师父玩累了饿了，要不要也尝尝看？",
            "choices": [
                {
                    "id": "756740603",
                    "text": "很开心哦，你呢？",
                    "response": [
                        {
                            "id": "756740604",
                            "speaker": "卡齐娜",
                            "text": "我，我我…"
                        },
                        {
                            "id": "756740605",
                            "speaker": "卡齐娜",
                            "text": "其实我还有一点点兴奋。"
                        },
                        {
                            "id": "756740606",
                            "speaker": "Player",
                            "text": "兴奋？"
                        },
                        {
                            "id": "756740607",
                            "speaker": "卡齐娜",
                            "text": "因为，以前还没有和外国的朋友一起认真讨论过舞蹈的事…还是两位很厉害的朋友！"
                        },
                        {
                            "id": "756740608",
                            "speaker": "卡齐娜",
                            "text": "之前玛拉妮向我介绍过妮露姐姐，我已经做好心理准备了。"
                        },
                        {
                            "id": "756740609",
                            "speaker": "卡齐娜",
                            "text": "和妮露姐姐说话的时候，就像在听摇篮曲一样…"
                        },
                        {
                            "id": "756740610",
                            "speaker": "卡齐娜",
                            "text": "啊，不是要真的睡过去的意思，而是…唔…身体和心情都完全放松下来？"
                        },
                        {
                            "id": "756740611",
                            "speaker": "卡齐娜",
                            "text": "慢慢的，柔柔的，有种非常宁静，安心的感觉…",
                            "choices": [
                                {
                                    "id": "756740612",
                                    "text": "这么一说确实呢。",
                                    "response": [
                                        {
                                            "id": "756740614",
                                            "speaker": "卡齐娜",
                                            "text": "师父也这么想吗？太好了！"
                                        },
                                        {
                                            "id": "756740615",
                                            "speaker": "卡齐娜",
                                            "text": "然后是芭芭拉姐姐…见到她之前，我还有点担心呢…"
                                        },
                                        {
                                            "id": "756740616",
                                            "speaker": "卡齐娜",
                                            "text": "毕竟，听说她是蒙德最有人气的偶像，也就是，超级明星的级别吧？"
                                        },
                                        {
                                            "id": "756740617",
                                            "speaker": "卡齐娜",
                                            "text": "我想，要是什么地方没做好，会不会惹她不开心？"
                                        },
                                        {
                                            "id": "756740618",
                                            "speaker": "卡齐娜",
                                            "text": "还好，芭芭拉姐姐也特别随和。"
                                        },
                                        {
                                            "id": "756740619",
                                            "speaker": "卡齐娜",
                                            "text": "她的随和，和妮露姐姐有一些不同，我觉得更像…泡泡？"
                                        },
                                        {
                                            "id": "756740620",
                                            "speaker": "卡齐娜",
                                            "text": "轻轻的，飘飘的…还有闪闪亮亮的气质！"
                                        },
                                        {
                                            "id": "756740621",
                                            "speaker": "卡齐娜",
                                            "text": "以前，除了玛拉妮以外，还没有谁能像两位姐姐这样。"
                                        },
                                        {
                                            "id": "756740622",
                                            "speaker": "卡齐娜",
                                            "text": "不管我提出什么跳舞动作的想法，都能一拍即合！",
                                            "choices": [
                                                {
                                                    "id": "756740623",
                                                    "text": "确实是碰到知音了呀。",
                                                    "response": [
                                                        {
                                                            "id": "756740625",
                                                            "speaker": "卡齐娜",
                                                            "text": "嗯！我要好好珍惜这段时间！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756740624",
                                                    "text": "那你们要多多交流哦。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756740613",
                                    "text": "很准确的比喻哦。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740626",
                    "text": "和两位姐姐相处得怎么样？",
                    "response": [
                        {
                            "id": "756740627",
                            "speaker": "卡齐娜",
                            "text": "我…我发现，两位姐姐提到了好多技巧，都是我以前没有考虑过的…"
                        },
                        {
                            "id": "756740628",
                            "speaker": "卡齐娜",
                            "text": "论跳舞的时间，正式演出的次数，她们都比我强太多了。"
                        },
                        {
                            "id": "756740629",
                            "speaker": "卡齐娜",
                            "text": "虽然我们的舞蹈不属于同一种风格，但我也需要学习其他舞蹈风格的经验和灵感。"
                        },
                        {
                            "id": "756740630",
                            "speaker": "卡齐娜",
                            "text": "师父教导过我，要不断突破自己原来的边界，成为更全面的人嘛…",
                            "choices": [
                                {
                                    "id": "756740631",
                                    "text": "我说过这话来着？",
                                    "response": [
                                        {
                                            "id": "756740633",
                                            "speaker": "卡齐娜",
                                            "text": "师父没有直接说过，但我听外国来的冒险家说，你解决的问题关系到各种各样的领域。"
                                        },
                                        {
                                            "id": "756740634",
                                            "speaker": "卡齐娜",
                                            "text": "他们还说，如果要讨论…学术资质？你可能同时被璃月工匠，须弥大学院还有枫丹那什么学院，评定成好几种学问的行家…"
                                        },
                                        {
                                            "id": "756740635",
                                            "speaker": "卡齐娜",
                                            "text": "璃月不是也有一句话叫「以身作则」吗？我觉得，师父就在以身作则！",
                                            "choices": [
                                                {
                                                    "id": "756740636",
                                                    "text": "卡齐娜最近学得真的好多！",
                                                    "response": [
                                                        {
                                                            "id": "756740638",
                                                            "speaker": "卡齐娜",
                                                            "text": "谢，谢谢师父！我会继续加油的！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756740637",
                                                    "text": "那我们以后也要不断突破！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756740632",
                                    "text": "好像没什么印象了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740639",
                    "text": "我先休息一下再继续玩。",
                    "response": [
                        {
                            "id": "756740640",
                            "speaker": "卡齐娜",
                            "text": "好，好的！师父千万别累着自己哦！"
                        }
                    ]
                }
            ]
        }
    ]
}