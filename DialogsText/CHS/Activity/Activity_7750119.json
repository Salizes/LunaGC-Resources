{
    "talkId": "7750119",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 5,
        "萨林": 23
    },
    "dialogues": [
        {
            "id": "775011901",
            "speaker": "萨林",
            "text": "这场面真是令人感慨啊，各个分会的高手齐聚一堂，简直是热血映影里的情节…"
        },
        {
            "id": "775011902",
            "speaker": "萨林",
            "text": "要是规则限制再少一点，加强战斗切磋的部分，这次竞赛就完美了。",
            "choices": [
                {
                    "id": "775011903",
                    "text": "冒险家还是要全面发展嘛。",
                    "response": [
                        {
                            "id": "775011904",
                            "speaker": "萨林",
                            "text": "我同意，冒险是一门结合了跋涉、侦察搜寻、野外长期生存、非对称战斗和态势分析的全面技术。"
                        },
                        {
                            "id": "775011905",
                            "speaker": "萨林",
                            "text": "只懂得战斗，未必能成为合格的冒险家。"
                        },
                        {
                            "id": "775011906",
                            "speaker": "萨林",
                            "text": "但不能打的确万万不行，因为那样就会成为队伍里的短板，容易被魔物和不法之徒当成短板突破，甚至导致队伍全灭。"
                        },
                        {
                            "id": "775011907",
                            "speaker": "萨林",
                            "text": "暂时战力不足，可以慢慢锻炼，但拿「团队合作」当挡箭牌，不思进取，就属于最烂的态度了。"
                        },
                        {
                            "id": "775011908",
                            "speaker": "萨林",
                            "text": "至少，在挪德卡莱分部，我会尽量让这样的冒险家变少。"
                        }
                    ]
                },
                {
                    "id": "775011909",
                    "text": "那你也占不到便宜吧？",
                    "response": [
                        {
                            "id": "775011910",
                            "speaker": "萨林",
                            "text": "哦？之前你看我用过重弩战斗…是吗？"
                        },
                        {
                            "id": "775011911",
                            "speaker": "萨林",
                            "text": "那可真让你见笑了…"
                        },
                        {
                            "id": "775011912",
                            "speaker": "萨林",
                            "text": "我也会进步的嘛，在塔拉利欣先生的帮助下，我已经能熟练运用掷弹兵们的武器了哦。"
                        },
                        {
                            "id": "775011913",
                            "speaker": "萨林",
                            "text": "当然，如果真的对上「青墟寻剑人」这种级别的对手，也撑不过她一刀吧。",
                            "choices": [
                                {
                                    "id": "775011914",
                                    "text": "这称号有点耳熟。",
                                    "response": [
                                        {
                                            "id": "775011916",
                                            "speaker": "萨林",
                                            "text": "你应该很早就认识她了吧？那位璃月的分会长，人称岚姐的剑士。"
                                        },
                                        {
                                            "id": "775011917",
                                            "speaker": "萨林",
                                            "text": "她完成的第一个S级委托，她生涯的第八个委托，便是在青墟浦一带，战胜了一只丘丘岩盔王。"
                                        },
                                        {
                                            "id": "775011918",
                                            "speaker": "萨林",
                                            "text": "战斗结束时，她全身的创口与骨折多达七十处，大量失血，但还是自行返回了营地，等到了后援。"
                                        },
                                        {
                                            "id": "775011919",
                                            "speaker": "萨林",
                                            "text": "别人问她是不是疯了，一个人就敢往岩盔王的活动区里撞。"
                                        },
                                        {
                                            "id": "775011920",
                                            "speaker": "萨林",
                                            "text": "她说不知道啊，她也没管那么多，只是想着找剑而已。"
                                        },
                                        {
                                            "id": "775011921",
                                            "speaker": "萨林",
                                            "text": "而她当时紧急处理伤口的手法也被冒险家协会记录，写进了一些参考资料。"
                                        },
                                        {
                                            "id": "775011922",
                                            "speaker": "萨林",
                                            "text": "听说这件事的时候，我还只是个天天和妈妈吵着要吃夏槲蛋糕的顽皮小孩，只当是童话故事上新了…"
                                        },
                                        {
                                            "id": "775011923",
                                            "speaker": "萨林",
                                            "text": "软磨硬泡了不到十块蛋糕，居然还能听到连载…「青墟寻剑人」躺了没多久就痊愈了，又连着完成了第二个S级委托…"
                                        },
                                        {
                                            "id": "775011924",
                                            "speaker": "萨林",
                                            "text": "真是个怪物啊…现在只有加入协会超过十年的人，才记得这个称号当时带来的震撼了吧。"
                                        },
                                        {
                                            "id": "775011925",
                                            "speaker": "萨林",
                                            "text": "岚姐报名的时候，本来用的是「花里胡哨不如一刀」，不过被其他老人点破了，最后还是用了这个经典款。"
                                        },
                                        {
                                            "id": "775011926",
                                            "speaker": "萨林",
                                            "text": "在她离开至冬前，我得找个机会拦住她，请她去挪德卡莱分部当一段时间的顾问。"
                                        }
                                    ]
                                },
                                {
                                    "id": "775011915",
                                    "text": "为什么叫这个来着？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011927",
                    "text": "我也觉得很有意思。",
                    "response": [
                        {
                            "id": "775011928",
                            "speaker": "萨林",
                            "text": "那就让我们继续享受这场盛会吧。"
                        }
                    ]
                }
            ]
        }
    ]
}