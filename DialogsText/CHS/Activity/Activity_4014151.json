{
    "talkId": "4014151",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 13,
        "夏洛蒂": 18
    },
    "dialogues": [
        {
            "id": "401415101",
            "speaker": "夏洛蒂",
            "text": "海灯节简直太棒了！我今晚可能睡不着了！",
            "choices": [
                {
                    "id": "401415102",
                    "text": "关于「械动式垂直拉升装置」…",
                    "response": [
                        {
                            "id": "401415103",
                            "speaker": "夏洛蒂",
                            "text": "哦，你问这个啊。"
                        },
                        {
                            "id": "401415104",
                            "speaker": "夏洛蒂",
                            "text": "这个装置的发明者，是一位叫伊尔德松斯的枫丹人。"
                        },
                        {
                            "id": "401415105",
                            "speaker": "夏洛蒂",
                            "text": "他天天鼓捣着一些冷门的机关发明，还好几次找到我们报社，想让我们报道他的发明。"
                        },
                        {
                            "id": "401415106",
                            "speaker": "夏洛蒂",
                            "text": "我找找他的原话，哦！"
                        },
                        {
                            "id": "401415107",
                            "speaker": "夏洛蒂",
                            "text": "「本装置采用纯机械动力驱动，不需使用任何额外能源」…"
                        },
                        {
                            "id": "401415108",
                            "speaker": "夏洛蒂",
                            "text": "就是手动上紧机关啦。这个装置能飞多高，取决于操作者的手能使出多大力气…"
                        },
                        {
                            "id": "401415109",
                            "speaker": "夏洛蒂",
                            "text": "能把它和风筝结合在一起，真是个神奇的好主意。",
                            "choices": [
                                {
                                    "id": "401415110",
                                    "text": "关于茶的报道与合作…",
                                    "response": [
                                        {
                                            "id": "401415111",
                                            "speaker": "夏洛蒂",
                                            "text": "和叶先生的交流很顺利，我的稿件已经寄回枫丹了。"
                                        },
                                        {
                                            "id": "401415112",
                                            "speaker": "夏洛蒂",
                                            "text": "这是一篇兼具「真实」与「故事」的专访稿，连我自己都很满意。"
                                        },
                                        {
                                            "id": "401415113",
                                            "speaker": "夏洛蒂",
                                            "text": "对了，还要感谢大家创造的这个机会！尤其是那位说话很有个性的闲云女士。"
                                        },
                                        {
                                            "id": "401415114",
                                            "speaker": "夏洛蒂",
                                            "text": "多亏你们的人脉与创意，我才能得到这份意料之外的「特色礼物」。",
                                            "choices": [
                                                {
                                                    "id": "401415102",
                                                    "text": "关于「械动式垂直拉升装置」…"
                                                },
                                                {
                                                    "id": "401415115",
                                                    "text": "关于海灯节…",
                                                    "response": [
                                                        {
                                                            "id": "401415116",
                                                            "speaker": "夏洛蒂",
                                                            "text": "我还是第一次亲身体验其他国家的节日，感想是…非常激动！"
                                                        },
                                                        {
                                                            "id": "401415117",
                                                            "speaker": "夏洛蒂",
                                                            "text": "张灯结彩的节日氛围，「喜庆」所带给人的感染力，厚重、绵长而又诗意的传统与文化…"
                                                        },
                                                        {
                                                            "id": "401415118",
                                                            "speaker": "夏洛蒂",
                                                            "text": "哦对了，刻晴送我的风筝上，还亲笔题了一首她自己写的诗呢！"
                                                        },
                                                        {
                                                            "id": "401415119",
                                                            "speaker": "夏洛蒂",
                                                            "text": "「叠纸眺风倚亭槛，几方梦回递纸鸢。绝云登岭另有志，愿眺荻花在清滩。」"
                                                        },
                                                        {
                                                            "id": "401415120",
                                                            "speaker": "夏洛蒂",
                                                            "text": "我想把这首诗也记录进我的海灯节专题报道，一定会有很多人喜欢的！",
                                                            "choices": [
                                                                {
                                                                    "id": "401415102",
                                                                    "text": "关于「械动式垂直拉升装置」…"
                                                                },
                                                                {
                                                                    "id": "401415110",
                                                                    "text": "关于茶的报道与合作…"
                                                                },
                                                                {
                                                                    "id": "401415121",
                                                                    "text": "下次再见哦，夏洛蒂。",
                                                                    "response": [
                                                                        {
                                                                            "id": "401415122",
                                                                            "speaker": "夏洛蒂",
                                                                            "text": "嗯！也祝你度过一个愉快的节日！"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "401415121",
                                                    "text": "下次再见哦，夏洛蒂。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401415115",
                                    "text": "关于海灯节…"
                                },
                                {
                                    "id": "401415121",
                                    "text": "下次再见哦，夏洛蒂。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401415110",
                    "text": "关于茶的报道与合作…"
                },
                {
                    "id": "401415115",
                    "text": "关于海灯节…"
                },
                {
                    "id": "401415121",
                    "text": "下次再见哦，夏洛蒂。"
                }
            ]
        }
    ]
}