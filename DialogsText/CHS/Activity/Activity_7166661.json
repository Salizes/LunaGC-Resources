    "dialogues": [
        {
            "id": "716666101",
            "speaker": "「超级强者的随行厨神」",
            "text": "#哟，{NICKNAME}！要再和锅巴玩一局吗？锅巴似乎还想再试试「花羽叶月神机」的本领！"
        },
        {
            "id": "716666102",
            "speaker": "「天崩石裂超级强者」",
            "text": "♪~",
            "choices": [
                {
                    "id": "716666103",
                    "text": "那我就扮一回一斗！",
                    "response": [
                        {
                            "id": "716666104",
                            "speaker": "「超级强者的随行厨神」",
                            "text": "好耶！再来一次斗虫大较量！"
                        },
                        {
                            "id": "716666105",
                            "speaker": "「天崩石裂超级强者」",
                            "text": "♪！"
                        }
                    ]
                },
                {
                    "id": "716666106",
                    "text": "「万民堂」重新开业的准备如何了？",
                    "response": [
                        {
                            "id": "716666107",
                            "speaker": "「超级强者的随行厨神」",
                            "text": "店里已经不那么忙啦，所以我和锅巴才能一直在这里玩斗虫，谢谢关心！"
                        },
                        {
                            "id": "716666108",
                            "speaker": "「超级强者的随行厨神」",
                            "text": "食材都补充得差不多了，再过几天应该就能照常营业！"
                        },
                        {
                            "id": "716666109",
                            "speaker": "「超级强者的随行厨神」",
                            "text": "如果你和派蒙还没吃够，那欢迎随时再来！"
                        },
                        {
                            "id": "716666110",
                            "speaker": "「天崩石裂超级强者」",
                            "text": "♪~"
                        }
                    ]
                },
                {
                    "id": "716666111",
                    "text": "先走了，下次再来！",
                    "response": [
                        {
                            "id": "716666112",
                            "speaker": "「超级强者的随行厨神」",
                            "text": "没问题，下回再见咯！"
