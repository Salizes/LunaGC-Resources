{
    "talkId": "7154003",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "蓝砚": 10
    },
    "dialogues": [
        {
            "id": "715400301",
            "speaker": "蓝砚",
            "text": "呼…还好，万事平安…",
            "choices": [
                {
                    "id": "715400302",
                    "text": "蓝砚，这封祝柬送你。",
                    "response": [
                        {
                            "id": "715400303",
                            "speaker": "蓝砚",
                            "text": "#欸？这封祝柬是给我的么？真好看，谢谢你，{NICKNAME}。"
                        },
                        {
                            "id": "715400304",
                            "speaker": "Player",
                            "text": "祝你来年万事顺遂。"
                        },
                        {
                            "id": "715400305",
                            "speaker": "蓝砚",
                            "text": "借你吉言啦，也祝你来年事事如意。"
                        },
                        {
                            "id": "715400306",
                            "speaker": "蓝砚",
                            "text": "不过…像你这么厉害的人物，肯定是万难也挡不住的。"
                        },
                        {
                            "id": "715400307",
                            "speaker": "蓝砚",
                            "text": "就算遇见不如意的事，你也一定能转祸为福，化凶成吉。",
                            "choices": [
                                {
                                    "id": "715400308",
                                    "text": "只是尽力而为。",
                                    "response": [
                                        {
                                            "id": "715400310",
                                            "speaker": "蓝砚",
                                            "text": "果然是璃月港的大英雄，天权大人的座上宾呀，嘿嘿，三言两语，都带着一股豪气。"
                                        },
                                        {
                                            "id": "715400311",
                                            "speaker": "蓝砚",
                                            "text": "无论如何，多亏有你和胡堂主，终于解决了边界的问题，我爷爷也不用担心再卜错卦被客人骂了。"
                                        },
                                        {
                                            "id": "715400312",
                                            "speaker": "蓝砚",
                                            "text": "这样一来，今年的海灯节，也算得上是「顺遂如意」了吧。"
                                        },
                                        {
                                            "id": "715400313",
                                            "speaker": "蓝砚",
                                            "text": "希望来年，大家也万事顺遂，幸福安康…"
                                        }
                                    ]
                                },
                                {
                                    "id": "715400309",
                                    "text": "事在人为。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715400314",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715400315",
                            "speaker": "蓝砚",
                            "text": "嗯，再见，祝你海灯节快乐。"
                        }
                    ]
                }
            ]
        }
    ]
}