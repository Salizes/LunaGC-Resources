{
    "talkId": "4014604",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "德佑": 11,
        "派蒙": 3
    },
    "dialogues": [
        {
            "id": "401460401",
            "speaker": "德佑",
            "text": "你们好啊。我是来自璃月的商人德佑。"
        },
        {
            "id": "401460402",
            "speaker": "派蒙",
            "text": "哦，你也是来采购药剂的吗？"
        },
        {
            "id": "401460403",
            "speaker": "德佑",
            "text": "是的，看你们店铺生意蛮好的，这次应该能大卖吧…一定能大卖的吧…"
        },
        {
            "id": "401460404",
            "speaker": "派蒙",
            "text": "怎么听起来这么没信心…"
        },
        {
            "id": "401460405",
            "speaker": "派蒙",
            "text": "我们的药剂可畅销了，订单源源不断，都要做不过来了！"
        },
        {
            "id": "401460406",
            "speaker": "德佑",
            "text": "抱歉，我不是怀疑你们的销量…"
        },
        {
            "id": "401460407",
            "speaker": "德佑",
            "text": "只是我的买卖一直不太顺利，每次买入热销产品，还没卖出去呢，同行就纷纷降价，结果就是十次买卖九次亏。"
        },
        {
            "id": "401460408",
            "speaker": "德佑",
            "text": "每次我都相信只是运气不好，但是如果一直运气不好，是不是说明，我就不适合经商呢…"
        },
        {
            "id": "401460409",
            "speaker": "德佑",
            "text": "如果这次再不赚钱，我就准备回家，给老爹干活了。",
            "choices": [
                {
                    "id": "401460410",
                    "text": "可能是商品选得不对。",
                    "response": [
                        {
                            "id": "401460412",
                            "speaker": "德佑",
                            "text": "是这样的吗，我还有很多要学习的地方啊。"
                        },
                        {
                            "id": "401460413",
                            "speaker": "德佑",
                            "text": "嗯，一直消沉下去也不是办法，这次一定要赚到钱，让老爹刮目相看…"
                        },
                        {
                            "id": "401460414",
                            "speaker": "德佑",
                            "text": "好，我们来商量一下合作的事宜吧。",
                            "choices": [
                                {
                                    "id": "401460415",
                                    "text": "查看药剂需求。",
                                    "response": [
                                        {
                                            "id": "401460416",
                                            "speaker": "德佑",
                                            "text": "这次我打算收购这几种药剂。"
                                        }
                                    ]
                                },
                                {
                                    "id": "401460417",
                                    "text": "以后再说吧。",
                                    "response": [
                                        {
                                            "id": "401460418",
                                            "speaker": "德佑",
                                            "text": "没关系，谨慎一些也好。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401460411",
                    "text": "也许销售策略有问题。"
                }
            ]
        }
    ]
}