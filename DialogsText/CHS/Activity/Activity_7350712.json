                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "735071246",
                                                    "text": "为你高兴！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "735071232",
                                    "text": "是有这回事来着…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071254",
                    "text": "下次再聊！",
                    "response": [
                        {
                            "id": "735071255",
                            "speaker": "左右加",
                            "text": "果然，你们响应着许多人的期待，一直很忙…"
                        },
                        {
                            "id": "735071256",
                            "speaker": "左右加",
                            "text": "希望能尽快和你们再见面！"
                        }
                    ]
                }
            ]
        }
