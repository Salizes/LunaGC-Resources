{
    "talkId": "7350712",
    "total_dialogue_lines": 56,
    "speaker_counts": {
        "Player": 9,
        "左右加": 28,
        "派蒙": 19
    },
    "dialogues": [
        {
            "id": "735071201",
            "speaker": "左右加",
            "text": "咦？真没想到还能遇见你们，「智巧勇武双连星」！",
            "choices": [
                {
                    "id": "735071202",
                    "text": "不错的新绰号！",
                    "response": [
                        {
                            "id": "735071203",
                            "speaker": "派蒙",
                            "text": "好久不见了，左右加小姐！"
                        },
                        {
                            "id": "735071204",
                            "speaker": "派蒙",
                            "text": "#你又在给我们起称号了…不过这回还挺直白挺威风的，夸的也是我和{NICKNAME}的搭档，我还挺喜欢的！"
                        },
                        {
                            "id": "735071205",
                            "speaker": "左右加",
                            "text": "嘿嘿，你们喜欢就好！"
                        },
                        {
                            "id": "735071206",
                            "speaker": "派蒙",
                            "text": "说起来，原来海妮耶提到的选手就是左右加小姐！你怎么一个人跑到须弥来了？"
                        },
                        {
                            "id": "735071207",
                            "speaker": "左右加",
                            "text": "不瞒你们说，我是为了找回上次参赛时的心境…"
                        },
                        {
                            "id": "735071208",
                            "speaker": "左右加",
                            "text": "我的新书差不多完成了三分之一，可往后写的时候，总觉得有些地方不对劲…"
                        },
                        {
                            "id": "735071209",
                            "speaker": "左右加",
                            "text": "随着时间流逝，我当时的文思，还有对蕈兽伙伴们的情感，好像正在慢慢淡化。"
                        },
                        {
                            "id": "735071210",
                            "speaker": "派蒙",
                            "text": "唔…确实呢，不管记性有多好，和伙伴们分开太久的话，也未必能想起一起旅行时的快乐呢。"
                        },
                        {
                            "id": "735071211",
                            "speaker": "左右加",
                            "text": "所以我就和八重大人请示，长期到须弥来出差了！八重大人欣然答应了我，还让我捎来了一封信！"
                        },
                        {
                            "id": "735071212",
                            "speaker": "左右加",
                            "text": "我在雨林里找了好久好久，总算发现了海妮耶的营地，真的很隐蔽呢，完全不会打扰到周围的动物！"
                        },
                        {
                            "id": "735071213",
                            "speaker": "左右加",
                            "text": "虽说海妮耶很厉害，把蕈兽们照顾得妥妥当当，但我帮她分担一部分工作，也能减轻她的劳累。"
                        },
                        {
                            "id": "735071214",
                            "speaker": "左右加",
                            "text": "听说我的来意后，海妮耶答应了我的请求，给我好好上了几堂雨林生存课，教会了我照顾蕈兽的要点。"
                        },
                        {
                            "id": "735071215",
                            "speaker": "左右加",
                            "text": "和蕈兽伙伴们一起生活，本身就是一件很开心的事，我每天都过得很充实。"
                        },
                        {
                            "id": "735071216",
                            "speaker": "左右加",
                            "text": "还能随时找到灵感，把新书顺顺利利写下去！",
                            "choices": [
                                {
                                    "id": "735071217",
                                    "text": "完美的决定！",
                                    "response": [
                                        {
                                            "id": "735071219",
                                            "speaker": "派蒙",
                                            "text": "太好了！左右加小姐的新书有了灵感的保障，海妮耶的压力也减轻了！"
                                        },
                                        {
                                            "id": "735071220",
                                            "speaker": "派蒙",
                                            "text": "不过，怎么没有看见你的搭档呢。"
                                        },
                                        {
                                            "id": "735071221",
                                            "speaker": "派蒙",
                                            "text": "我记得是叫…「信风舞姬」？"
                                        },
                                        {
                                            "id": "735071222",
                                            "speaker": "左右加",
                                            "text": "「信风舞姬」最近帮我们搭建了新的小屋，正在营地里休息呢，这回就没跟到奥摩斯港来了。"
                                        },
                                        {
                                            "id": "735071223",
                                            "speaker": "左右加",
                                            "text": "其他选手的蕈兽伙伴正陪着「信风舞姬」，等到时机合适了，我可以带你们去营地里看看蕈兽伙伴们！"
                                        },
                                        {
                                            "id": "735071224",
                                            "speaker": "左右加",
                                            "text": "八重大人的「百雷遮罗」和莱依拉小姐的「转转悠悠兽」就在那边，你们可以去和它们一起玩哦。"
                                        },
                                        {
                                            "id": "735071225",
                                            "speaker": "派蒙",
                                            "text": "好哦！我们待会儿就去和好久没见的蕈兽伙伴碰头！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071218",
                                    "text": "为你高兴！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071226",
                    "text": "您是哪位来着…",
                    "response": [
                        {
                            "id": "735071227",
                            "speaker": "派蒙",
                            "text": "#是不是最近休息得不好呀，{NICKNAME}？你回忆一下？"
                        },
                        {
                            "id": "735071228",
                            "speaker": "派蒙",
                            "text": "左右加小姐是「八重堂」的新锐作者，上次「月莲杯驯兽师大赛」，跟着神子一起来参赛了呀。"
                        },
                        {
                            "id": "735071229",
                            "speaker": "派蒙",
                            "text": "虽然第二场比赛就被我们打败了…咳咳，先不提比赛的事了…"
                        },
                        {
                            "id": "735071230",
                            "speaker": "派蒙",
                            "text": "之后左右加小姐要把我们写进她的轻小说里，扮演非常重要的角色，我还挺期待的呢！",
                            "choices": [
                                {
                                    "id": "735071231",
                                    "text": "确实，想起来了！",
                                    "response": [
                                        {
                                            "id": "735071233",
                                            "speaker": "派蒙",
                                            "text": "对嘛，你才没有那么健忘！"
                                        },
                                        {
