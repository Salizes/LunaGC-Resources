    "dialogues": [
        {
            "id": "715110301",
            "speaker": "辛焱",
            "text": "好，我得抓紧时间写新曲子了！"
        },
        {
            "id": "715110302",
            "speaker": "云堇",
            "text": "你呀，刚圆一个梦，又找到新的目标了？"
        },
        {
            "id": "715110303",
            "speaker": "辛焱",
            "text": "你不也这样吗，我猜你把新戏的名字都想好了吧？"
        },
        {
            "id": "715110304",
            "speaker": "云堇",
            "text": "呵呵…还是辛焱懂我。"
        },
        {
            "id": "715110305",
            "speaker": "云堇",
            "text": "《渡舟寻仙》…听着如何？"
        },
        {
            "id": "715110306",
            "speaker": "辛焱",
            "text": "噢！好有画面感。"
        },
        {
            "id": "715110307",
            "speaker": "云堇",
            "text": "这点题的一句我也想好了，就叫它「钧天广乐，云间彻响」。"
        }
    ]
}