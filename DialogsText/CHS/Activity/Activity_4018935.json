{
    "talkId": "4018935",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "哲俩阿": 8
    },
    "dialogues": [
        {
            "id": "401893501",
            "speaker": "哲俩阿",
            "text": "不乱跑的动物，乖乖的，真好。多准备一些好吃的，在庄园里办一场动物宴会…",
            "choices": [
                {
                    "id": "401893502",
                    "text": "乱…乱跑的呢…",
                    "response": [
                        {
                            "id": "401893503",
                            "speaker": "哲俩阿",
                            "text": "乱跑但不搞破坏，属于单纯的调皮，好好教育一下，没什么问题。"
                        },
                        {
                            "id": "401893504",
                            "speaker": "哲俩阿",
                            "text": "可要是既乱跑，还搞破坏，还伤害其他动物，破坏本地生态…"
                        },
                        {
                            "id": "401893505",
                            "speaker": "哲俩阿",
                            "text": "那就属于生物入侵了！对付这种家伙，一定要毫不留情地出击！"
                        }
                    ]
                },
                {
                    "id": "401893506",
                    "text": "宴会的主菜是什么…",
                    "response": [
                        {
                            "id": "401893507",
                            "speaker": "哲俩阿",
                            "text": "这…应该要全素才对…"
                        },
                        {
                            "id": "401893508",
                            "speaker": "哲俩阿",
                            "text": "如果觉得营养不够，可以多加豆类？我不是专业的厨师，只有照顾猎物，把它们带回原本的栖息地的经验…"
                        },
                        {
                            "id": "401893509",
                            "speaker": "哲俩阿",
                            "text": "你提醒我了，我得多查查资料，保证庄园客人的膳食均衡。"
                        }
                    ]
                },
                {
                    "id": "401893510",
                    "text": "那你要好好照顾乖动物！",
                    "response": [
                        {
                            "id": "401893511",
                            "speaker": "哲俩阿",
                            "text": "这是我的职责，我一定全力以赴。"
                        }
                    ]
                }
            ]
        }
    ]
}