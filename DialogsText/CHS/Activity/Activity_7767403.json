{
    "talkId": "7767403",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "列斯诺娃": 6
    },
    "dialogues": [
        {
            "id": "776740301",
            "speaker": "列斯诺娃",
            "text": "啊，你也被塔拉利欣拉着进行推演了吗？我看你和他聊了很久。",
            "choices": [
                {
                    "id": "776740302",
                    "text": "没错，有什么问题吗？",
                    "response": [
                        {
                            "id": "776740303",
                            "speaker": "列斯诺娃",
                            "text": "我不太擅长和他打交道，祝你好运。"
                        },
                        {
                            "id": "776740304",
                            "speaker": "列斯诺娃",
                            "text": "除了这次推演，塔拉利欣总把自己要去收拾的事说得轻描淡写…无论有多棘手。"
                        },
                        {
                            "id": "776740305",
                            "speaker": "列斯诺娃",
                            "text": "派给别人的任务，哪怕只是找一只猫，都要再三叮嘱，让别人千万谨慎行事，生怕别人下错哪一级台阶崴了脚。"
                        },
                        {
                            "id": "776740306",
                            "speaker": "列斯诺娃",
                            "text": "他总让我感觉，我不适合当冒险家，不适合团队合作…"
                        }
                    ]
                },
                {
                    "id": "776740307",
                    "text": "的确，不过我要先走了。",
                    "response": [
                        {
                            "id": "776740308",
                            "speaker": "列斯诺娃",
                            "text": "那有缘再见。"
                        }
                    ]
                }
            ]
        }
    ]
}