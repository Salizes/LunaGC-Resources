{
    "talkId": "4016834",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "坎蒂丝": 12
    },
    "dialogues": [
        {
            "id": "401683401",
            "speaker": "坎蒂丝",
            "text": "#{NICKNAME}，风沙没有吹进你的衣袖里吧？快请在我身旁坐下。",
            "choices": [
                {
                    "id": "401683402",
                    "text": "坎蒂丝是在…",
                    "response": [
                        {
                            "id": "401683403",
                            "speaker": "坎蒂丝",
                            "text": "我在练习一首古老的曲子，我喜欢它曼妙的旋律，尽管它真正的结尾已在黄沙中佚失。"
                        },
                        {
                            "id": "401683404",
                            "speaker": "坎蒂丝",
                            "text": "过往我所做的，是重复演奏我能记住的段落。一遍，然后再来一遍。"
                        },
                        {
                            "id": "401683405",
                            "speaker": "坎蒂丝",
                            "text": "但今夜我正试图用我的理解，为它附上一个合适的结尾。"
                        },
                        {
                            "id": "401683406",
                            "speaker": "坎蒂丝",
                            "text": "或许是热闹的花神诞祭让心境发生了些许改变吧？我想有些故事适合被继续书写下去…"
                        },
                        {
                            "id": "401683407",
                            "speaker": "坎蒂丝",
                            "text": "有些记忆，即使模糊也不会改变其珍贵的本质。"
                        }
                    ]
                },
                {
                    "id": "401683408",
                    "text": "这就回来了吗？",
                    "response": [
                        {
                            "id": "401683409",
                            "speaker": "坎蒂丝",
                            "text": "听起来，我们的「花之骑士」仍有些意犹未尽。"
                        },
                        {
                            "id": "401683410",
                            "speaker": "坎蒂丝",
                            "text": "阿如村离不开我，而我也离不开它。"
                        },
                        {
                            "id": "401683411",
                            "speaker": "坎蒂丝",
                            "text": "我很荣幸能与大家共度一段愉快的节日时光，但回归生活本身并不是件需要落寞的事。"
                        },
                        {
                            "id": "401683412",
                            "speaker": "坎蒂丝",
                            "text": "打起精神，笑一笑吧。"
                        },
                        {
                            "id": "401683413",
                            "speaker": "坎蒂丝",
                            "text": "看看天边的云你就会明白，明天也一定会是个晴朗的好日子。"
                        }
                    ]
                },
                {
                    "id": "401683414",
                    "text": "还有别的事…",
                    "response": [
                        {
                            "id": "401683415",
                            "speaker": "坎蒂丝",
                            "text": "嗯，愿今日的欢笑一直留存在你我心中。"
                        }
                    ]
                }
            ]
        }
    ]
}