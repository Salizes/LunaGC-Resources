    "dialogues": [
        {
            "id": "401651701",
            "speaker": "Wanderer",
            "text": "……"
        },
        {
            "id": "401651702",
            "speaker": "纳西妲",
            "text": "教令院的人说这段时间都没见到你呢。"
        },
        {
            "id": "401651703",
            "speaker": "Wanderer",
            "text": "待得闷了出去走走都不行吗？这里是学校还是监狱？"
        },
        {
            "id": "401651704",
            "speaker": "纳西妲",
            "text": "我没说不行哦，只是看你心情不错的样子。"
        },
        {
            "id": "401651705",
            "speaker": "Wanderer",
            "text": "嘁…"
        },
        {
            "id": "401651706",
            "speaker": "小杜林",
            "text": "阿帽，这是谁呀？"
        },
        {
            "id": "401651707",
            "speaker": "Wanderer",
            "text": "闭嘴，别出声。"
        },
        {
            "id": "401651708",
            "speaker": "纳西妲",
            "text": "交到新朋友了？"
        },
        {
            "id": "401651709",
            "speaker": "Wanderer",
            "text": "…说了别看我在想什么。"
        },
        {
            "id": "401651710",
            "speaker": "纳西妲",
            "text": "我没看哟，都写在你脸上了。"
        },
        {
            "id": "401651711",
            "speaker": "Wanderer",
            "text": "啧…"
        }
    ]
}