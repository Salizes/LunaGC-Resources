    "dialogues": [
        {
            "id": "401971101",
            "speaker": "瓦雷莎",
            "text": "好，接下来是瓦雷莎冲刺时间，我要玩个痛快，然后安安心心看管水果摊！",
            "choices": [
                {
                    "id": "401971102",
                    "text": "记得带好水哦。",
                    "response": [
                        {
                            "id": "401971104",
                            "speaker": "派蒙",
                            "text": "对对对，不要玩得太入迷，结果饿到不行才发现自己一直没吃东西哦。"
                        },
                        {
                            "id": "401971105",
                            "speaker": "派蒙",
                            "text": "有个家伙偶尔也会这么专注干自己的事，这可不好，不管在忙什么，都大不过吃饱饭喝够水，保持身体健康！",
                            "choices": [
                                {
                                    "id": "401971106",
                                    "text": "派蒙居然也认识这样的人！",
                                    "response": [
                                        {
                                            "id": "401971108",
                                            "speaker": "派蒙",
                                            "text": "哼！"
                                        },
                                        {
                                            "id": "401971109",
                                            "speaker": "瓦雷莎",
                                            "text": "你们就放心好啦，我有长跑的习惯，每次都会带够物资出门，这次也不例外！"
                                        },
                                        {
                                            "id": "401971110",
                                            "speaker": "Black Screen",
                                            "text": "瓦雷莎进入了「妙影名篇」的游玩区，尽情玩耍了起来…"
                                        },
                                        {
                                            "id": "401971111",
                                            "speaker": "瓦雷莎",
                                            "text": "呼~超满足！"
                                        },
                                        {
                                            "id": "401971112",
                                            "speaker": "派蒙",
                                            "text": "怎么样，瓦雷莎玩过了所有关卡吗？"
                                        },
                                        {
                                            "id": "401971113",
                                            "speaker": "瓦雷莎",
                                            "text": "心满意足！不止拿到了很高的评分，确认了每个致敬原映影的细节，还重现了好几个漫画英雄的名场面呢！"
                                        },
                                        {
                                            "id": "401971114",
                                            "speaker": "瓦雷莎",
                                            "text": "这次我专心做好生意，如果以后还有这样的活动，请早早告诉我，我也想参与！",
                                            "choices": [
                                                {
                                                    "id": "401971115",
                                                    "text": "那就约好了，英雄专家！",
                                                    "response": [
                                                        {
                                                            "id": "401971117",
                                                            "speaker": "派蒙",
                                                            "text": "嗯！到时候，就由你来设计冒险的关卡，肯定能唤起忠实观众们的热情！"
                                                        },
                                                        {
                                                            "id": "401971118",
                                                            "speaker": "瓦雷莎",
                                                            "text": "心满意足啦！接下来，我就要认认真真管好水果摊，努努力，打响我家果园在枫丹的名气~"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "401971116",
                                                    "text": "下次一定！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401971107",
                                    "text": "是谁呀！一定要改掉才行！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401971103",
                    "text": "还有补充体力的食物。"
                }
            ]
        }
    ]
}