{
    "talkId": "7350633",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "丽莎": 7
    },
    "dialogues": [
        {
            "id": "735063301",
            "speaker": "丽莎",
            "text": "咦，怎么在教令院附近见到你了？",
            "choices": [
                {
                    "id": "735063302",
                    "text": "丽莎不进教令院吗？",
                    "response": [
                        {
                            "id": "735063303",
                            "speaker": "丽莎",
                            "text": "其实我刚从大门出来不久。"
                        },
                        {
                            "id": "735063306",
                            "speaker": "丽莎",
                            "text": "居勒什老师还有几位师兄，以前共事过的另外几位研究员，大家聚在一起又见了一次。"
                        },
                        {
                            "id": "735063307",
                            "speaker": "丽莎",
                            "text": "时间过得真快啊，看大家的样子能感觉到他们都忙得不得了呢。"
                        },
                        {
                            "id": "735063308",
                            "speaker": "丽莎",
                            "text": "我的确是松散了一点。呵呵…他们一定很羡慕吧。"
                        },
                        {
                            "id": "735063309",
                            "speaker": "丽莎",
                            "text": "话虽这么说，下个月还是少吃点蛋糕吧，得提防长胖呢。"
                        }
                    ]
                },
                {
                    "id": "735063304",
                    "text": "丽莎刚离开教令院吗？",
                    "response": [
                        {
                            "id": "735063305",
                            "speaker": "丽莎",
                            "text": "是呀，刚走到这里就遇到你了。"
                        }
                    ]
                }
            ]
        }
    ]
}