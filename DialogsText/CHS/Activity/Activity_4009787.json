{
    "talkId": "4009787",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "艾伦": 12
    },
    "dialogues": [
        {
            "id": "400978701",
            "speaker": "Player",
            "text": "关于狐狸…"
        },
        {
            "id": "400978702",
            "speaker": "艾伦",
            "text": "啊，这是我们清泉镇猎人的习俗。"
        },
        {
            "id": "400978703",
            "speaker": "艾伦",
            "text": "每到风花节，像我这样的年轻猎手要去奔狼领等地捕捉狐狸。"
        },
        {
            "id": "400978704",
            "speaker": "艾伦",
            "text": "抓到狐狸给它们戴上花环然后放生，以祈求这一年能收获美好的爱情…"
        },
        {
            "id": "400978705",
            "speaker": "艾伦",
            "text": "当然，只有年轻猎手会参与活动，像杜拉夫先生这样的已婚猎人肯定就不能参加了。",
            "choices": [
                {
                    "id": "400978706",
                    "text": "你抓到狐狸了吗？",
                    "response": [
                        {
                            "id": "400978707",
                            "speaker": "艾伦",
                            "text": "唉，别提了，狐狸真是太难抓了。"
                        },
                        {
                            "id": "400978708",
                            "speaker": "艾伦",
                            "text": "上次风花节我就没抓到狐狸，还差点把自己弄伤了，当时我发誓这次一定要一雪前耻的…"
                        },
                        {
                            "id": "400978709",
                            "speaker": "艾伦",
                            "text": "…结果到现在为止，我连一只狐狸都没抓到过，只抓到了两只松鼠。"
                        },
                        {
                            "id": "400978710",
                            "speaker": "艾伦",
                            "text": "话说，砂糖小姐能不能用生物炼金术把松鼠变成狐狸呢？"
                        },
                        {
                            "id": "400978711",
                            "speaker": "艾伦",
                            "text": "应该可以吧，哈、哈哈…"
                        }
                    ]
                },
                {
                    "id": "400978712",
                    "text": "抓到狐狸的人都收获爱情了吗？",
                    "response": [
                        {
                            "id": "400978713",
                            "speaker": "艾伦",
                            "text": "唔，如果一直参加的话，恋爱的运势就会一直叠加…"
                        },
                        {
                            "id": "400978714",
                            "speaker": "艾伦",
                            "text": "…这样的话，迟早有一天会找到合适的人的。"
                        },
                        {
                            "id": "400978715",
                            "speaker": "艾伦",
                            "text": "…咳咳，杜拉夫先生是这么和我们说的。"
                        }
                    ]
                }
            ]
        }
    ]
}