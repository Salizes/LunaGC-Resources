{
    "talkId": "7567407",
    "total_dialogue_lines": 66,
    "speaker_counts": {
        "Player": 16,
        "芭芭拉": 50
    },
    "dialogues": [
        {
            "id": "756740701",
            "speaker": "芭芭拉",
            "text": "你好呀，荣誉骑士。"
        },
        {
            "id": "756740702",
            "speaker": "芭芭拉",
            "text": "来了纳塔才知道，这里的人都非常尊敬你，有些时候，比蒙德人敬重荣誉骑士还夸张。",
            "choices": [
                {
                    "id": "756740703",
                    "text": "还好，只是力所能及帮了忙。",
                    "response": [
                        {
                            "id": "756740704",
                            "speaker": "芭芭拉",
                            "text": "说到这里，作为好朋友，我还是想给你一点小小的建议——"
                        },
                        {
                            "id": "756740705",
                            "speaker": "芭芭拉",
                            "text": "有的时候，不能执着地沉浸在各种委托中，只顾着为他人实现愿望。"
                        },
                        {
                            "id": "756740706",
                            "speaker": "芭芭拉",
                            "text": "也要留意自己的身体和精神，别让劳损积累哦。"
                        },
                        {
                            "id": "756740707",
                            "speaker": "芭芭拉",
                            "text": "嗯…就像姐姐。",
                            "choices": [
                                {
                                    "id": "756740708",
                                    "text": "谢谢芭芭拉。",
                                    "response": [
                                        {
                                            "id": "756740710",
                                            "speaker": "芭芭拉",
                                            "text": "现在这种轻松的聚会就很不错，你游历其他国家的时候，可以多和朋友们办一办类似的活动。"
                                        },
                                        {
                                            "id": "756740711",
                                            "speaker": "芭芭拉",
                                            "text": "以前也没机会看你跳舞或领舞，这次就让我来当观众吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "756740709",
                                    "text": "我会注意的。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740712",
                    "text": "芭芭拉也交到不少新朋友了嘛。",
                    "response": [
                        {
                            "id": "756740713",
                            "speaker": "芭芭拉",
                            "text": "对呀，纳塔的大家给我带来了好多惊喜！"
                        },
                        {
                            "id": "756740714",
                            "speaker": "芭芭拉",
                            "text": "之前到访蒙德的希诺宁女士，居然是那么厉害的锻造师，听说连神明都要找她铸造器具…"
                        },
                        {
                            "id": "756740715",
                            "speaker": "芭芭拉",
                            "text": "我也总算听到了「热舞乐台」的音色，实在是奇妙。"
                        },
                        {
                            "id": "756740716",
                            "speaker": "芭芭拉",
                            "text": "那种能被旋钮带动，扭动拉伸，不断闪烁的听感，让我头皮发麻…却又非常愉快。"
                        },
                        {
                            "id": "756740717",
                            "speaker": "芭芭拉",
                            "text": "希诺宁女士还送给我一盘记录着特色音乐的唱片，说是用枫丹款的机关也能播放。"
                        },
                        {
                            "id": "756740718",
                            "speaker": "芭芭拉",
                            "text": "回去以后，我要认真地多听听才行。"
                        },
                        {
                            "id": "756740719",
                            "speaker": "Player",
                            "text": "玛拉妮应该是最先找到你的？"
                        },
                        {
                            "id": "756740720",
                            "speaker": "芭芭拉",
                            "text": "是啊…说到玛拉妮，我现在还有些没回过神来呢。"
                        },
                        {
                            "id": "756740721",
                            "speaker": "芭芭拉",
                            "text": "收到她的邀请信时，我的第一反应是…咳咳…「新型诈骗」…"
                        },
                        {
                            "id": "756740722",
                            "speaker": "Player",
                            "text": "「新型诈骗」？"
                        },
                        {
                            "id": "756740723",
                            "speaker": "芭芭拉",
                            "text": "好在，往下读着读着，就感受到了…从字里行间涌出来的，能够穿透纸张的热情。"
                        },
                        {
                            "id": "756740724",
                            "speaker": "芭芭拉",
                            "text": "我听过真正虔诚的祈祷，这种发自内心的真诚，根本不可能伪装出来。"
                        },
                        {
                            "id": "756740725",
                            "speaker": "芭芭拉",
                            "text": "果然，车队抵达驿站时，我远远看见玛拉妮乘着冲浪板呼啦啦地冲过来，第一时间就能确定…"
                        },
                        {
                            "id": "756740726",
                            "speaker": "芭芭拉",
                            "text": "「一定是这个人，我们肯定能成为好朋友！」"
                        },
                        {
                            "id": "756740727",
                            "speaker": "芭芭拉",
                            "text": "然后，玛拉妮就推掉了所有的工作，带着我从「流泉之众」一路玩到了「回声之子」。"
                        },
                        {
                            "id": "756740728",
                            "speaker": "芭芭拉",
                            "text": "接到了须弥朋友们后，又一起折返回「花羽会」，乘船来度假村。",
                            "choices": [
                                {
                                    "id": "756740729",
                                    "text": "感觉非常尽兴呢。",
                                    "response": [
                                        {
                                            "id": "756740731",
                                            "speaker": "芭芭拉",
                                            "text": "一路的开心经历，就像做梦一样…"
                                        },
                                        {
                                            "id": "756740732",
                                            "speaker": "芭芭拉",
                                            "text": "当然，时间还有很多。我要集中精神，继续认真地感受这趟开心的旅程。"
                                        }
                                    ]
                                },
                                {
                                    "id": "756740730",
                                    "text": "确实是玛拉妮的风格。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740733",
                    "text": "和卡齐娜相处得怎么样？",
                    "response": [
                        {
                            "id": "756740734",
                            "speaker": "芭芭拉",
                            "text": "…说出来，有点感慨…"
                        },
                        {
                            "id": "756740735",
                            "speaker": "芭芭拉",
                            "text": "好像看到了刚刚学会跳舞不久的自己。"
                        },
                        {
                            "id": "756740736",
                            "speaker": "芭芭拉",
                            "text": "啊，我不是说跳舞的技巧，而是一种状态…"
                        },
                        {
                            "id": "756740737",
                            "speaker": "芭芭拉",
                            "text": "喜爱舞蹈，明明好好练习过了，但一到许多陌生人面前，还是打心底里有些怯场。",
                            "choices": [
                                {
                                    "id": "756740738",
                                    "text": "你也察觉到了呀。",
                                    "response": [
                                        {
                                            "id": "756740740",
                                            "speaker": "芭芭拉",
                                            "text": "在跳舞这方面，卡齐娜的潜力远远不止她谦虚的自评。"
                                        },
                                        {
                                            "id": "756740741",
                                            "speaker": "芭芭拉",
                                            "text": "如果不能让她的才能像宝石一样闪光，我也会心疼的。"
                                        },
                                        {
                                            "id": "756740742",
                                            "speaker": "芭芭拉",
                                            "text": "我会和卡齐娜分享我这些年来的所有心得，希望能帮她克服小小的不足之处。"
                                        }
                                    ]
                                },
                                {
                                    "id": "756740739",
                                    "text": "卡齐娜其实已经进步了喔。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740743",
                    "text": "有和妮露聊过天吗？",
                    "response": [
                        {
                            "id": "756740744",
                            "speaker": "芭芭拉",
                            "text": "当然了，妮露小姐可是须弥城有名的舞者！"
                        },
                        {
                            "id": "756740745",
                            "speaker": "芭芭拉",
                            "text": "就算这次没有接受邀请，作为蒙德的偶像，我也迟早会主动找到妮露小姐。"
                        },
                        {
                            "id": "756740746",
                            "speaker": "芭芭拉",
                            "text": "毕竟舞台没有边界，偶像的舞步必须不断进步。"
                        },
                        {
                            "id": "756740747",
                            "speaker": "芭芭拉",
                            "text": "不过，比起几位纳塔的朋友，我和妮露小姐彼此熟悉的速度，就不那么快了。"
                        },
                        {
                            "id": "756740748",
                            "speaker": "芭芭拉",
                            "text": "也许是因为最近玩的地方太多，暂时没能独处，好好聊聊天。"
                        },
                        {
                            "id": "756740749",
                            "speaker": "芭芭拉",
                            "text": "观察妮露小姐的舞姿，我能感受到一种自然与柔和，好像花苞舒展开来。"
                        },
                        {
                            "id": "756740750",
                            "speaker": "芭芭拉",
                            "text": "舞步能够最真实地反应一个人的性格，妮露小姐平常应该比较安静？"
                        },
                        {
                            "id": "756740751",
                            "speaker": "芭芭拉",
                            "text": "我想，和妮露小姐相处，要采取更温和的方式。",
                            "choices": [
                                {
                                    "id": "756740752",
                                    "text": "芭芭拉已经够随和了。",
                                    "response": [
                                        {
                                            "id": "756740754",
                                            "speaker": "芭芭拉",
                                            "text": "毕竟是须弥的朋友，又是有名的舞者，文化习惯和个人习惯上或许都有些差异？"
                                        },
                                        {
                                            "id": "756740755",
                                            "speaker": "芭芭拉",
                                            "text": "姐姐还专门提醒过我这一点…来之前，我特意借书，基本了解了纳塔的习俗。"
                                        },
                                        {
                                            "id": "756740756",
                                            "speaker": "芭芭拉",
                                            "text": "可是，须弥的相关知识，这次还没来得及详细了解。"
                                        },
                                        {
                                            "id": "756740757",
                                            "speaker": "芭芭拉",
                                            "text": "这几天，我还要抓紧时间，多请教一下玛拉妮，做一做功课…"
                                        }
                                    ]
                                },
                                {
                                    "id": "756740753",
                                    "text": "不用太担心这方面吧？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740758",
                    "text": "你要注意防暑哦。",
                    "response": [
                        {
                            "id": "756740759",
                            "speaker": "芭芭拉",
                            "text": "唔，是在担心我穿得太厚吗？"
                        },
                        {
                            "id": "756740760",
                            "speaker": "芭芭拉",
                            "text": "谢谢！其实还好的，这边的海风非常凉爽，到了夜晚还有点温差呢。"
                        },
                        {
                            "id": "756740761",
                            "speaker": "芭芭拉",
                            "text": "我决定来纳塔之前，分别向姐姐和父亲征询了意见。"
                        },
                        {
                            "id": "756740762",
                            "speaker": "芭芭拉",
                            "text": "姐姐觉得，我是西风教会的祈礼牧师，第一次出现在纳塔的公众场合，还是采用正式的着装为妙。"
                        },
                        {
                            "id": "756740763",
                            "speaker": "芭芭拉",
                            "text": "父亲则提醒我，纳塔的日光非常强烈，千万要注意防晒。"
                        },
                        {
                            "id": "756740764",
                            "speaker": "芭芭拉",
                            "text": "所以，尽管有些闷热，我还是穿着平常在教会时的衣服，来参加这场派对。"
                        }
                    ]
                },
                {
                    "id": "756740765",
                    "text": "芭芭拉先玩，我待会儿再来。",
                    "response": [
                        {
                            "id": "756740766",
                            "speaker": "芭芭拉",
                            "text": "嗯，那就待会儿再见啦。"
                        }
                    ]
                }
            ]
        }
    ]
}