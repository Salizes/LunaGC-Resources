{
    "talkId": "4020921",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "伊涅芙": 9,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "402092101",
            "speaker": "伊涅芙",
            "text": "#欢迎回来，{NICKNAME}和派蒙，想继续体验「噼里啪啦守卫团」吗？",
            "choices": [
                {
                    "id": "402092102",
                    "text": "状态大好，多来几局！",
                    "response": [
                        {
                            "id": "402092103",
                            "speaker": "派蒙",
                            "text": "没错没错，我们好像找到…排兵布阵的乐趣了！"
                        },
                        {
                            "id": "402092104",
                            "speaker": "伊涅芙",
                            "text": "那请做好准备，进入推演辅助模式，模拟对抗马上开始。"
                        }
                    ]
                },
                {
                    "id": "402092105",
                    "text": "可以再看一遍教学流程吗？",
                    "response": [
                        {
                            "id": "402092106",
                            "speaker": "派蒙",
                            "text": "唔，有道理，我也有点忘了该怎么指挥「噼里啪啦守卫团」了。"
                        },
                        {
                            "id": "402092107",
                            "speaker": "伊涅芙",
                            "text": "没问题，如果还有不明白的地方，请直接提问。"
                        }
                    ]
                },
                {
                    "id": "402092108",
                    "text": "伊涅芙觉得累吗？",
                    "response": [
                        {
                            "id": "402092109",
                            "speaker": "派蒙",
                            "text": "嗯，这次的展会的规模可不小，「噼里啪啦守卫军团」的操作也不简单，伊涅芙忙得过来吗？"
                        },
                        {
                            "id": "402092110",
                            "speaker": "伊涅芙",
                            "text": "正在评估客流量，对比过往数据…"
                        },
                        {
                            "id": "402092111",
                            "speaker": "伊涅芙",
                            "text": "分析完成，综合场地大小，来客总量等各项因素，本展位的客流量与祈月之夜基本持平。"
                        },
                        {
                            "id": "402092112",
                            "speaker": "伊涅芙",
                            "text": "而且，祈月之夜上，我还负责引导「叮铃哐啷蛋卷工坊」的大家，有序参与展览。"
                        },
                        {
                            "id": "402092113",
                            "speaker": "伊涅芙",
                            "text": "从工作的复杂和可控程度分析，管理「噼里啪啦守卫军团」，尚未达到「高强度工作」的范畴。"
                        },
                        {
                            "id": "402092114",
                            "speaker": "派蒙",
                            "text": "那看来，只要客人们都懂礼貌，伊涅芙就能开开心心完成任务啦。",
                            "choices": [
                                {
                                    "id": "402092115",
                                    "text": "希望过来的客人都是好人。",
                                    "response": [
                                        {
                                            "id": "402092117",
                                            "speaker": "伊涅芙",
                                            "text": "嗯，是轻松的，悠闲的。如果客人们都遵循礼节，我也会感到开心。"
                                        }
                                    ]
                                },
                                {
                                    "id": "402092116",
                                    "text": "如果有客人不礼貌，我们来管教。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "402092118",
                    "text": "待会儿再来玩。",
                    "response": [
                        {
                            "id": "402092119",
                            "speaker": "派蒙",
                            "text": "加油哦，伊涅芙，我们去别的地方逛逛！"
                        },
                        {
                            "id": "402092120",
                            "speaker": "伊涅芙",
                            "text": "好的，请慢走，我也进入等待模式好了。"
                        }
                    ]
                }
            ]
        }
    ]
}