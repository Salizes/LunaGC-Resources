    "dialogues": [
        {
            "id": "401578201",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想邀请你去参加音乐庆典。</color>"
        },
        {
            "id": "401578202",
            "speaker": "智树",
            "text": "咦？你们怎么知道我喜欢听音乐？我的很多创意点子都是从音乐中诞生的！"
        },
        {
            "id": "401578203",
            "speaker": "派蒙",
            "text": "那你一定有喜欢的音乐吧？我们可以弹给你听！"
        },
        {
            "id": "401578204",
            "speaker": "智树",
            "text": "那可太多了，嗯…如果一定要选一首的话，我可能会选绀田村当地的一首传统曲子。"
        },
        {
            "id": "401578205",
            "speaker": "智树",
            "text": "要知道我的创意美食之路，就是从那里开始的。"
        },
        {
            "id": "401578206",
            "speaker": "智树",
            "text": "我可以把旋律哼出来，你们可以弹给我听听吗？"
        },
        {
            "id": "401578207",
            "speaker": "Player",
            "text": "我来试试。"
        },
        {
            "id": "401578208",
            "speaker": "智树",
            "text": "感谢！"
        }
    ]
}