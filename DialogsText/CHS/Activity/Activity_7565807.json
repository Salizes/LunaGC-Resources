{
    "talkId": "7565807",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 4,
        "赫卡": 6
    },
    "dialogues": [
        {
            "id": "756580701",
            "speaker": "赫卡",
            "text": "准备好挑战巨大人马石像了吗？",
            "choices": [
                {
                    "id": "756580702",
                    "text": "现在准备一下。"
                },
                {
                    "id": "756580703",
                    "text": "想随便聊聊…",
                    "response": [
                        {
                            "id": "756580704",
                            "speaker": "赫卡",
                            "text": "这是古时候的文明所制造的机关吧。看它的样子就像是舞台上的演奏家，制造出它的文明真是了不得。"
                        },
                        {
                            "id": "756580705",
                            "speaker": "赫卡",
                            "text": "卡嘉说，过去的挪德卡莱也有过秩序与繁荣的文明，似乎从它的身上也能看到那时的影子呢。"
                        },
                        {
                            "id": "756580706",
                            "speaker": "Player",
                            "text": "关于过去的挪德卡莱…"
                        },
                        {
                            "id": "756580707",
                            "speaker": "赫卡",
                            "text": "这个嘛，其实挪德卡莱也算是至冬的一部分呢，所以在过去，至冬曾经对那里进行过大规模的开发。"
                        },
                        {
                            "id": "756580708",
                            "speaker": "赫卡",
                            "text": "但是现在除了随处可见的机械垃圾以外，已经找不到那时候留下来的痕迹了。"
                        },
                        {
                            "id": "756580709",
                            "speaker": "赫卡",
                            "text": "不过说不定正是因为这样，挪德卡莱才会变成现在生机勃勃的样子。"
                        }
                    ]
                },
                {
                    "id": "756580710",
                    "text": "稍等。"
                }
            ]
        }
    ]
}