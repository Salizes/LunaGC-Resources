{
    "talkId": "7650802",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "努斯妲": 18
    },
    "dialogues": [
        {
            "id": "765080201",
            "speaker": "努斯妲",
            "text": "#状态不错嘛，{NICKNAME}！我们有好几组舞者，搭建了多种舞台，可以让你玩个尽兴！",
            "choices": [
                {
                    "id": "765080202",
                    "text": "那就开始吧！",
                    "response": [
                        {
                            "id": "765080203",
                            "speaker": "努斯妲",
                            "text": "好嘞！音乐就位，舞者就位，请登上指导席！"
                        }
                    ]
                },
                {
                    "id": "765080204",
                    "text": "先闲聊两句，努斯妲？",
                    "response": [
                        {
                            "id": "765080205",
                            "speaker": "努斯妲",
                            "text": "好啊！聊多少都没问题！请稍等，我感受一下…"
                        },
                        {
                            "id": "765080206",
                            "speaker": "努斯妲",
                            "text": "嗯，没喝多，只是微醺！大英雄对什么话题感兴趣？",
                            "choices": [
                                {
                                    "id": "765080207",
                                    "text": "须弥之行开心吗？",
                                    "response": [
                                        {
                                            "id": "765080208",
                                            "speaker": "努斯妲",
                                            "text": "哈哈哈，那可乐得不行！除了之前说过的沙虫风波，我们还见识到了许多神奇的人和事——"
                                        },
                                        {
                                            "id": "765080209",
                                            "speaker": "努斯妲",
                                            "text": "辗转在须弥和枫丹之间的厨师小队，四位成员来自不同的国家，无论拿到什么食材，都能做成佳肴…"
                                        },
                                        {
                                            "id": "765080210",
                                            "speaker": "努斯妲",
                                            "text": "带着蕈兽伙伴从沙漠尽头回归的驯兽师，虽然穿着镀金旅团的衣服，但散发着一股淑女气质…"
                                        },
                                        {
                                            "id": "765080211",
                                            "speaker": "努斯妲",
                                            "text": "还有擅使双刃，扎着好看双辫，喜欢在夜里绕着篝火跳舞的佣兵女孩…"
                                        },
                                        {
                                            "id": "765080212",
                                            "speaker": "努斯妲",
                                            "text": "不过，手边没有饮料和零食，站着聊太久，感觉有点怠慢您。"
                                        },
                                        {
                                            "id": "765080213",
                                            "speaker": "努斯妲",
                                            "text": "等您不那么忙了，我请您吃顿大餐，我们边喝边聊！"
                                        }
                                    ]
                                },
                                {
                                    "id": "765080214",
                                    "text": "你的小队成员最近还好吗？",
                                    "response": [
                                        {
                                            "id": "765080215",
                                            "speaker": "努斯妲",
                                            "text": "嚯！代他们向您的关心表示感谢！"
                                        },
                                        {
                                            "id": "765080216",
                                            "speaker": "努斯妲",
                                            "text": "四位战友里，有两人在之前的战斗里受了点伤，不过不碍事，这么久过去了，基本都痊愈了！"
                                        },
                                        {
                                            "id": "765080217",
                                            "speaker": "努斯妲",
                                            "text": "现在他们一个个都生龙活虎呢。下次有机会，来陪他们练一练，活动活动筋骨？"
                                        }
                                    ]
                                },
                                {
                                    "id": "765080218",
                                    "text": "接下来有什么打算？",
                                    "response": [
                                        {
                                            "id": "765080219",
                                            "speaker": "努斯妲",
                                            "text": "嗯，除了继续担任拳法和跳舞的教练，我还想试着玩一玩乐队。"
                                        },
                                        {
                                            "id": "765080220",
                                            "speaker": "努斯妲",
                                            "text": "之前，「沃陆之邦」来我们部族支援时，伊安珊大师给我讲了许多打鼓的知识，我很感兴趣！"
                                        },
                                        {
                                            "id": "765080221",
                                            "speaker": "努斯妲",
                                            "text": "在悠悠度假村游玩时，我也远远看见了您和伊安珊…对，应该说是火神大人的乐队合奏。"
                                        },
                                        {
                                            "id": "765080222",
                                            "speaker": "努斯妲",
                                            "text": "鼓术大成后，我争取给您也伴奏几回！您想玩什么歌，我都尽量打个天衣无缝！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "765080228",
                    "text": "待会儿再来交流舞术！",
                    "response": [
                        {
                            "id": "765080229",
                            "speaker": "努斯妲",
                            "text": "嗯！吃饱喝足，状态大好的时候，和大家一起跳舞，就最最快乐！"
                        }
                    ]
                }
            ]
        }
    ]
}