{
    "talkId": "7154021",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "钟离": 8
    },
    "dialogues": [
        {
            "id": "715402101",
            "speaker": "钟离",
            "text": "果然是好茶…",
            "choices": [
                {
                    "id": "715402102",
                    "text": "钟离，这封祝柬送给你。",
                    "response": [
                        {
                            "id": "715402103",
                            "speaker": "钟离",
                            "text": "多谢。你来得正好，正好堂主带来了一包上好的陈年「铁绛叶」，我刚泡下。"
                        },
                        {
                            "id": "715402104",
                            "speaker": "Player",
                            "text": "之前谢谢钟离的提醒。"
                        },
                        {
                            "id": "715402105",
                            "speaker": "钟离",
                            "text": "呵呵，本就是你聪慧，「谢」字又从何而来。"
                        },
                        {
                            "id": "715402106",
                            "speaker": "钟离",
                            "text": "璃月之难，既是堂主果决，又是总务司统管，由众人合力，方才转祸为福。"
                        },
                        {
                            "id": "715402107",
                            "speaker": "钟离",
                            "text": "身为客卿，我也就帮堂主写了些祝柬，做了些吉语钱而已。"
                        },
                        {
                            "id": "715402108",
                            "speaker": "钟离",
                            "text": "而堂主能安然无恙，终归还是托了你的福。要说「谢」字，理应是我先谢谢你。",
                            "choices": [
                                {
                                    "id": "715402109",
                                    "text": "欸？是这个说法么？",
                                    "response": [
                                        {
                                            "id": "715402111",
                                            "speaker": "钟离",
                                            "text": "#茶好了，{NICKNAME}，第一杯，请。若是知道些闲趣佚事，我们可以边品茶边聊。"
                                        }
                                    ]
                                },
                                {
                                    "id": "715402110",
                                    "text": "呃…你，你等我想想…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715402112",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715402113",
                            "speaker": "钟离",
                            "text": "慢走。祝你海灯节安康。"
                        }
                    ]
                }
            ]
        }
    ]
}