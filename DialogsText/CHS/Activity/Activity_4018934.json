{
    "talkId": "4018934",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "梅里爱": 8
    },
    "dialogues": [
        {
            "id": "401893401",
            "speaker": "梅里爱",
            "text": "关键机关的光效到位了，就能拍出不错的镜头呀。以后要在道具上下更大的血本！",
            "choices": [
                {
                    "id": "401893402",
                    "text": "边工作，边取材？",
                    "response": [
                        {
                            "id": "401893403",
                            "speaker": "梅里爱",
                            "text": "啊哈哈，抱歉，职业病犯了…我的同行好像也都这样。"
                        },
                        {
                            "id": "401893404",
                            "speaker": "梅里爱",
                            "text": "你看，我都为了下部映影的资金，来给你打工了。不然，给我加点薪水呗？"
                        },
                        {
                            "id": "401893405",
                            "speaker": "梅里爱",
                            "text": "到时候，片尾特别鸣谢的名单，第一个就放上你的大名！"
                        }
                    ]
                },
                {
                    "id": "401893406",
                    "text": "资金够吗，你就下血本？",
                    "response": [
                        {
                            "id": "401893407",
                            "speaker": "梅里爱",
                            "text": "资金是永远不够的，合理地做加减法，是导演的职责。"
                        },
                        {
                            "id": "401893408",
                            "speaker": "梅里爱",
                            "text": "考虑到未来映影对整体画面的要求，我更倾向于…适当压低所谓明星演员的片酬，在道具、布景和特效上加大投入。"
                        },
                        {
                            "id": "401893409",
                            "speaker": "梅里爱",
                            "text": "毕竟，映影也不能只看演员的脸…精妙的场景，富有质感的道具，也是非常重要的元素。"
                        }
                    ]
                },
                {
                    "id": "401893410",
                    "text": "那你认真琢磨，但别忘了工作。",
                    "response": [
                        {
                            "id": "401893411",
                            "speaker": "梅里爱",
                            "text": "成熟的导演都是多线思考的高手，我绝对能帮你把项目管好！"
                        }
                    ]
                }
            ]
        }
    ]
}