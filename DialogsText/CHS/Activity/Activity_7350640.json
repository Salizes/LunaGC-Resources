{
    "talkId": "7350640",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "加福尔": 9
    },
    "dialogues": [
        {
            "id": "735064001",
            "speaker": "加福尔",
            "text": "倒是多派点人手啊，就这么点人根本处理不过来。算了，能处理多少是多少吧。",
            "choices": [
                {
                    "id": "735064002",
                    "text": "关于丽莎…",
                    "response": [
                        {
                            "id": "735064003",
                            "speaker": "加福尔",
                            "text": "所以你们是在蒙德和丽莎认识的？她真的普普通通地在当图书管理员？"
                        },
                        {
                            "id": "735064004",
                            "speaker": "Player",
                            "text": "是的，有什么问题吗？"
                        },
                        {
                            "id": "735064005",
                            "speaker": "加福尔",
                            "text": "真是没想到，蒙德有什么吸引她的，值得这样浪费自己的才华。"
                        },
                        {
                            "id": "735064006",
                            "speaker": "加福尔",
                            "text": "…好吧，我知道你是丽莎的朋友，我不会再找她说那件事了，你就别瞪我了。"
                        },
                        {
                            "id": "735064007",
                            "speaker": "加福尔",
                            "text": "我也是好心给她提供机会，她不愿意就算了。"
                        }
                    ]
                },
                {
                    "id": "735064008",
                    "text": "关于素论派…",
                    "response": [
                        {
                            "id": "735064009",
                            "speaker": "加福尔",
                            "text": "是啊，我们学院需要定期监测地脉运行情况，这是学院的研究基础之一。"
                        },
                        {
                            "id": "735064010",
                            "speaker": "加福尔",
                            "text": "又有专业素养，又能独立承担秘境内地脉探索工作的人才实在不够，早就说了要多拨点人过来…"
                        },
                        {
                            "id": "735064011",
                            "speaker": "加福尔",
                            "text": "找不到专业学者过来，我也只能招募志愿者了，唉。"
                        }
                    ]
                },
                {
                    "id": "735064012",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "735064013",
                            "speaker": "加福尔",
                            "text": "这处秘境的探索清理工作就交给你了。"
                        }
                    ]
                }
            ]
        }
    ]
}