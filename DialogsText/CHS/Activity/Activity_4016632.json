    "dialogues": [
        {
            "id": "401663201",
            "speaker": "Wanderer",
            "text": "哦？真是稀罕，节日期间还有人往教令院跑？",
            "choices": [
                {
                    "id": "401663202",
                    "text": "你不也是…",
                    "response": [
                        {
                            "id": "401663203",
                            "speaker": "Wanderer",
                            "text": "当其他人都去享受节日的时候，也就这里能寻个清净。"
                        },
                        {
                            "id": "401663206",
                            "speaker": "Wanderer",
                            "text": "你们去玩吧，别告诉其他人我在这里就行。"
                        },
                        {
                            "id": "401663207",
                            "speaker": "Wanderer",
                            "text": "难得的「节日」，也让我依自己喜欢的方式去过。"
                        }
                    ]
                },
                {
                    "id": "401663204",
                    "text": "你不去玩吗？",
                    "response": [
                        {
                            "id": "401663205",
                            "speaker": "Wanderer",
                            "text": "我在你心里什么时候变成了会去和大家牵着手逛街跳舞的样子？"
                        }
                    ]
                }
            ]
        }
    ]
}