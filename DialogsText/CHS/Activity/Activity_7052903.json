    "dialogues": [
        {
            "id": "705290301",
            "speaker": "莉兹",
            "text": "您想要来试试弹一首曲子吗？只要集中注意力跟上节拍和节奏，您一定能轻松弹奏出一首像样的曲子。"
        },
        {
            "id": "705290302",
            "speaker": "莉兹",
            "text": "在风中全神贯注地弹奏着优美动听的旋律…这样，您肯定能把烦心事都忘掉。",
            "choices": [
                {
                    "id": "705290303",
                    "text": "我现在就试试。",
                    "response": [
                        {
                            "id": "705290304",
                            "speaker": "莉兹",
                            "text": "没问题！曲谱什么的都在这里了，请您仔细看看吧。"
                        }
                    ]
                },
                {
                    "id": "705290305",
                    "text": "还有别的事…",
                    "response": [
                        {
                            "id": "705290306",
                            "speaker": "莉兹",
                            "text": "好吧…欢迎您随时过来试玩！"
                        }
                    ]
                }
            ]
        }
    ]
}