{
    "talkId": "4015443",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Black Screen": 2,
        "Player": 2,
        "丽莎": 4,
        "五郎": 5,
        "派蒙": 6,
        "绮良良": 3
    },
    "dialogues": [
        {
            "id": "401544301",
            "speaker": "派蒙",
            "text": "五郎，绮良良，你们需要的神奇药剂已经做好啦，先试试看吧？"
        },
        {
            "id": "401544302",
            "speaker": "五郎",
            "text": "太好了，你们两位的效率真是令人惊叹！"
        },
        {
            "id": "401544303",
            "speaker": "五郎",
            "text": "嗯…"
        },
        {
            "id": "401544304",
            "speaker": "五郎",
            "text": "哇，只是外用了一小点而已，我总是因为拉弓而酸痛的右臂，完全没有了疲惫感…"
        },
        {
            "id": "401544305",
            "speaker": "绮良良",
            "text": "我我我，我被石头硌到的爪子也不疼了，简直是灵丹妙药！"
        },
        {
            "id": "401544306",
            "speaker": "绮良良",
            "text": "有了它帮忙，说不定我一天能跑两百单快递！"
        },
        {
            "id": "401544307",
            "speaker": "派蒙",
            "text": "#嘿嘿，看来这次{NICKNAME}和我调配的药剂非常不错嘛，可以帮海祇岛和「狛荷屋」一个大忙了！",
            "choices": [
                {
                    "id": "401544308",
                    "text": "完美达标！",
                    "response": [
                        {
                            "id": "401544310",
                            "speaker": "派蒙",
                            "text": "好！那接下来就是快乐的下午茶时间…"
                        },
                        {
                            "id": "401544311",
                            "speaker": "派蒙",
                            "text": "正好，丽莎也来了。"
                        },
                        {
                            "id": "401544312",
                            "speaker": "丽莎",
                            "text": "小狼狼好像去忙别的事了，不在奔狼领。可惜他错过了交到毛茸茸耳朵朋友的机会呢。"
                        },
                        {
                            "id": "401544313",
                            "speaker": "丽莎",
                            "text": "不过，相信你们之后还有机会见面的。下次遇见他的时候，我会和他说一说你们的事，让他对新朋友们有个期待。"
                        },
                        {
                            "id": "401544314",
                            "speaker": "Black Screen",
                            "text": "丽莎在休息处找到了合适的圆桌，摆开了精致的点心和茶具，大家一同享受了愉快的下午茶时光。"
                        },
                        {
                            "id": "401544315",
                            "speaker": "Black Screen",
                            "text": "绮良良吃得非常开心，只是五郎有些紧张，让你们想起了他面对某位宫司大人时的局促神情…"
                        },
                        {
                            "id": "401544316",
                            "speaker": "丽莎",
                            "text": "嗯，这次的订单总量非常不错，谢谢惠顾啦，两位稻妻的朋友。"
                        },
                        {
                            "id": "401544317",
                            "speaker": "丽莎",
                            "text": "如果使用的反馈不错，还请继续照顾我们的生意哦。如果来往不太方便，直接寄信也没问题的。"
                        },
                        {
                            "id": "401544318",
                            "speaker": "绮良良",
                            "text": "#一定一定！{NICKNAME}、派蒙和丽莎姐的超强炼金药剂，说不定能帮助整个快递行业提升效率呢！"
                        },
                        {
                            "id": "401544319",
                            "speaker": "五郎",
                            "text": "#没问题，我会仔细听取将士们的反馈的…那就下次再见了，{NICKNAME}、派蒙和魔女阁下。"
                        },
                        {
                            "id": "401544320",
                            "speaker": "派蒙",
                            "text": "回见啦，五郎和绮良良！"
                        },
                        {
                            "id": "401544321",
                            "speaker": "五郎",
                            "text": "下次还是组织一个正式的访问团吧，找个机会，请珊瑚宫大人来和这位魔女打交道！"
                        },
                        {
                            "id": "401544322",
                            "speaker": "派蒙",
                            "text": "总觉得五郎好像对魔女产生了什么误解呢…"
                        }
                    ]
                },
                {
                    "id": "401544309",
                    "text": "不愧是我！"
                }
            ]
        }
    ]
}