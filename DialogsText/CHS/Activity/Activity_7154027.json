{
    "talkId": "7154027",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "宵宫": 10
    },
    "dialogues": [
        {
            "id": "715402701",
            "speaker": "宵宫",
            "text": "这灯可真漂亮…",
            "choices": [
                {
                    "id": "715402702",
                    "text": "这封祝柬送给你。",
                    "response": [
                        {
                            "id": "715402703",
                            "speaker": "宵宫",
                            "text": "谢谢！这就是「祝柬」啊…真漂亮，谢谢啦，我会好好珍藏的。"
                        },
                        {
                            "id": "715402704",
                            "speaker": "宵宫",
                            "text": "居然能在海灯节上遇见你，还收到你礼物，我这一趟也算是不白来啦。"
                        },
                        {
                            "id": "715402705",
                            "speaker": "Player",
                            "text": "听你的口气，没玩尽兴吗？"
                        },
                        {
                            "id": "715402706",
                            "speaker": "宵宫",
                            "text": "没有没有，璃月港里的东西很好吃，好玩的地方也很多，不过…"
                        },
                        {
                            "id": "715402707",
                            "speaker": "宵宫",
                            "text": "唉，我听说往年的海灯节，都会放一场大大的烟花，或者是放飞很多很多霄灯。"
                        },
                        {
                            "id": "715402708",
                            "speaker": "宵宫",
                            "text": "结果，两个都没有见识到。亏我还一直想着，那棵树一样的大灯笼会从哪里放出烟花来呢…"
                        },
                        {
                            "id": "715402709",
                            "speaker": "宵宫",
                            "text": "不过，那位「天权大人」主持的「祭仪」确实很有气势，周围灯火的效果也很好。"
                        },
                        {
                            "id": "715402710",
                            "speaker": "宵宫",
                            "text": "嘿嘿，等到下次稻妻举办庆典的时候，我也要做一场这样的巨大灯火演出。"
                        },
                        {
                            "id": "715402711",
                            "speaker": "宵宫",
                            "text": "到时候我提前告诉你，给你留一个最好的位置，一定要来看呀。"
                        }
                    ]
                },
                {
                    "id": "715402712",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715402713",
                            "speaker": "宵宫",
                            "text": "嗯，回头见！"
                        }
                    ]
                }
            ]
        }
    ]
}