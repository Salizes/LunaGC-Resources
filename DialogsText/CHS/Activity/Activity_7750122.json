{
    "talkId": "7750122",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 5,
        "苏赫拉布": 19
    },
    "dialogues": [
        {
            "id": "775012201",
            "speaker": "苏赫拉布",
            "text": "「震沸装置」状况良好，约束部件应该还能高强度使用十九天…足够了。",
            "choices": [
                {
                    "id": "775012202",
                    "text": "嘀嘀咕咕什么呢？",
                    "response": [
                        {
                            "id": "775012203",
                            "speaker": "苏赫拉布",
                            "text": "想要吗？能有效提升战力的炼金机关「震沸装置」。"
                        },
                        {
                            "id": "775012204",
                            "speaker": "苏赫拉布",
                            "text": "只要你有一定的战斗力，它就能让你爆发出老兵般的战斗力。"
                        },
                        {
                            "id": "775012205",
                            "speaker": "苏赫拉布",
                            "text": "如果像我一样，饱经锻炼和战斗的磨砺，用上它后，每次战斗都发挥出十二成的水准。"
                        },
                        {
                            "id": "775012206",
                            "speaker": "苏赫拉布",
                            "text": "不错吧？可以现在向我下订单哦，我一回须弥就告诉哈贾娜德老师，她会安排工坊加单的。",
                            "choices": [
                                {
                                    "id": "775012207",
                                    "text": "这装置有点耳熟…",
                                    "response": [
                                        {
                                            "id": "775012208",
                                            "speaker": "苏赫拉布",
                                            "text": "正常…老师说过，它的诞生得到了「世界上最辉煌的人协助」，感觉「像做了两场最美好的梦」。"
                                        },
                                        {
                                            "id": "775012209",
                                            "speaker": "苏赫拉布",
                                            "text": "老师的学术成果慢慢被教令院认可后，她的经历肯定会传到更多人耳朵里。"
                                        },
                                        {
                                            "id": "775012213",
                                            "speaker": "苏赫拉布",
                                            "text": "老师也会借此成为更有名望的人，然后和蔼地帮助更多人…"
                                        },
                                        {
                                            "id": "775012214",
                                            "speaker": "苏赫拉布",
                                            "text": "要是她的傻笑不那么吓人，就更完美了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "775012210",
                                    "text": "不知道是什么，不感兴趣。",
                                    "response": [
                                        {
                                            "id": "775012211",
                                            "speaker": "苏赫拉布",
                                            "text": "那你可错过宝贝了。现在「三十人团」都有少量列装「震沸装置」哦。"
                                        },
                                        {
                                            "id": "775012212",
                                            "speaker": "苏赫拉布",
                                            "text": "哈贾娜德老师以后肯定会把它改进得更完善，成为弯刀一样便宜可靠的辅助装备，更有力地保护须弥。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775012215",
                    "text": "你从须弥来？",
                    "response": [
                        {
                            "id": "775012216",
                            "speaker": "苏赫拉布",
                            "text": "是啊，没想到一眼就被你认出来了。"
                        },
                        {
                            "id": "775012217",
                            "speaker": "苏赫拉布",
                            "text": "以前我住在奥摩斯港北边，一直在当猎户，没怎么见过世面…"
                        },
                        {
                            "id": "775012218",
                            "speaker": "苏赫拉布",
                            "text": "有幸接了临时委托，护送一些学者在蕈兽密集区做调查后，被哈贾娜德老师选中，邀请我去教令院跟着她进修。"
                        },
                        {
                            "id": "775012219",
                            "speaker": "苏赫拉布",
                            "text": "然后我才来开始跟着课题，承接各种冒险委托。"
                        },
                        {
                            "id": "775012220",
                            "speaker": "苏赫拉布",
                            "text": "到现在，在「震沸装置」的帮助下，我已经完成了137个A级委托。"
                        },
                        {
                            "id": "775012221",
                            "speaker": "苏赫拉布",
                            "text": "虽然没有S级的超强成就，但因为够勤快，就被协会推荐，跟着莲塔队长来比赛了。"
                        },
                        {
                            "id": "775012222",
                            "speaker": "苏赫拉布",
                            "text": "希望最后的成绩能让老师满意…"
                        }
                    ]
                },
                {
                    "id": "775012223",
                    "text": "不打扰了。",
                    "response": [
                        {
                            "id": "775012224",
                            "speaker": "苏赫拉布",
                            "text": "咦？那…下次再见？"
                        }
                    ]
                }
            ]
        }
    ]
}