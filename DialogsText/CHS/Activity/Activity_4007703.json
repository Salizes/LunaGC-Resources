{
    "talkId": "4007703",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 9,
        "奥兹": 3,
        "菲谢尔": 12
    },
    "dialogues": [
        {
            "id": "400770301",
            "speaker": "菲谢尔",
            "text": "哦呵呵，是本皇女最忠实的扈从。",
            "choices": [
                {
                    "id": "400770302",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400770303",
                            "speaker": "菲谢尔",
                            "text": "自然可以，本皇女赐你提问的权力。",
                            "choices": [
                                {
                                    "id": "400770306",
                                    "text": "关于夜鸦剧场…",
                                    "response": [
                                        {
                                            "id": "400770307",
                                            "speaker": "菲谢尔",
                                            "text": "哦？你已经见识过圣国的戏剧了吗？"
                                        },
                                        {
                                            "id": "400770308",
                                            "speaker": "菲谢尔",
                                            "text": "哼哼，不必吝啬称赞，那景象确为世间独有。"
                                        },
                                        {
                                            "id": "400770309",
                                            "speaker": "奥兹",
                                            "text": "小姐已经迫不及待想要听到你的点评了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770310",
                                    "text": "关于《圣国的咏唱》…",
                                    "response": [
                                        {
                                            "id": "400770311",
                                            "speaker": "菲谢尔",
                                            "text": "其为幽夜净土圣典，切勿使之破损沾污…"
                                        },
                                        {
                                            "id": "400770312",
                                            "speaker": "Player",
                                            "text": "我会好好保存。"
                                        },
                                        {
                                            "id": "400770313",
                                            "speaker": "菲谢尔",
                                            "text": "哼，那就好。"
                                        },
                                        {
                                            "id": "400770314",
                                            "speaker": "奥兹",
                                            "text": "在小姐心中，这也是见证这次旅途的宝贵纪念品。你的重视令她格外高兴。"
                                        },
                                        {
                                            "id": "400770315",
                                            "speaker": "菲谢尔",
                                            "text": "奥兹，不需要翻译到这种程度！"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770316",
                                    "text": "关于这次假期…",
                                    "response": [
                                        {
                                            "id": "400770317",
                                            "speaker": "菲谢尔",
                                            "text": "本皇女此番君临净土，见得这般欢庆盛况，很是愉快。"
                                        },
                                        {
                                            "id": "400770318",
                                            "speaker": "菲谢尔",
                                            "text": "我行遍万千世界，自然也知道，宴席总有散场之日。"
                                        },
                                        {
                                            "id": "400770319",
                                            "speaker": "菲谢尔",
                                            "text": "于是，我昭告子民，本皇女尚在巡礼之中，还有远方的扈从需要帮助。"
                                        },
                                        {
                                            "id": "400770320",
                                            "speaker": "奥兹",
                                            "text": "和大家告别的时候，小姐都哭了呢。"
                                        },
                                        {
                                            "id": "400770321",
                                            "speaker": "菲谢尔",
                                            "text": "奥兹！我都说过了，只是无礼的沙进入了眼角而已！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770304",
                    "text": "先不打扰你了。",
                    "response": [
                        {
                            "id": "400770305",
                            "speaker": "菲谢尔",
                            "text": "与吾命运交错之人，在此乐土畅游吧。",
                            "choices": [
                                {
                                    "id": "400770306",
                                    "text": "关于夜鸦剧场…"
                                },
                                {
                                    "id": "400770310",
                                    "text": "关于《圣国的咏唱》…"
                                },
                                {
                                    "id": "400770316",
                                    "text": "关于这次假期…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}