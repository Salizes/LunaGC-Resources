{
    "talkId": "4008804",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "蕾娅": 6
    },
    "dialogues": [
        {
            "id": "400880401",
            "speaker": "蕾娅",
            "text": "欢迎参加归风佳酿节！如果您有任何事需要帮助，请联系西风骑士团。",
            "choices": [
                {
                    "id": "400880402",
                    "text": "关于佳酿节…",
                    "response": [
                        {
                            "id": "400880403",
                            "speaker": "蕾娅",
                            "text": "说起佳酿节，其实对于节日会场的选取并没有什么要求，之前也经常会在蒙德城内进行庆祝活动。"
                        },
                        {
                            "id": "400880404",
                            "speaker": "蕾娅",
                            "text": "不过我个人还是更喜欢今年的选址，比起繁华的蒙德城，果酒湖畔不仅风光优美，更多了一分野趣。"
                        }
                    ]
                },
                {
                    "id": "400880405",
                    "text": "关于西风骑士团…",
                    "response": [
                        {
                            "id": "400880406",
                            "speaker": "蕾娅",
                            "text": "西风骑士团作为节日的主办方之一，会保障会场的秩序，力求让每一个客人都能享受节日的乐趣。"
                        },
                        {
                            "id": "400880407",
                            "speaker": "蕾娅",
                            "text": "所以我也要提醒客人们适量饮酒！如果喝得太多给其他人添了麻烦，我们可是会出面的哦。"
                        }
                    ]
                },
                {
                    "id": "400880408",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "400880409",
                            "speaker": "蕾娅",
                            "text": "再见，祝你节日愉快！"
                        }
                    ]
                }
            ]
        }
    ]
}