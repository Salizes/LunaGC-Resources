    "dialogues": [
        {
            "id": "401415501",
            "speaker": "七七",
            "text": "风筝，飞得很高。"
        },
        {
            "id": "401415502",
            "speaker": "七七",
            "text": "瑶瑶，谢谢你，我很喜欢。"
        },
        {
            "id": "401415503",
            "speaker": "瑶瑶",
            "text": "我也很开心！"
        },
        {
            "id": "401415504",
            "speaker": "瑶瑶",
            "text": "不仅仅是今天，以后我们也可以一起放哦。"
        },
        {
            "id": "401415505",
            "speaker": "七七",
            "text": "真的？"
        },
        {
            "id": "401415506",
            "speaker": "瑶瑶",
            "text": "下回找个白天吧？白天的时候图案很明显的！飞高高之后特别像小团雀。"
        },
        {
            "id": "401415507",
            "speaker": "七七",
            "text": "好。"
        },
        {
            "id": "401415508",
            "speaker": "七七",
            "text": "风筝…晚上可以抱着睡觉吗？"
        },
        {
            "id": "401415509",
            "speaker": "瑶瑶",
            "text": "嘿嘿，当然可以哟。"
        }
    ]
}