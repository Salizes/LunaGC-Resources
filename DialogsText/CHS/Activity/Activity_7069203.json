{
    "talkId": "7069203",
    "total_dialogue_lines": 57,
    "speaker_counts": {
        "Player": 16,
        "米卡": 41
    },
    "dialogues": [
        {
            "id": "706920301",
            "speaker": "米卡",
            "text": "前辈，试飞「前哨龙龙」后，如果有什么想法，请尽管告诉我…严苛的批评也没关系！",
            "choices": [
                {
                    "id": "706920302",
                    "text": "叫我前辈还是有点生分了哦。",
                    "response": [
                        {
                            "id": "706920303",
                            "speaker": "米卡",
                            "text": "生分的意思是？",
                            "choices": [
                                {
                                    "id": "706920304",
                                    "text": "论骑士资历，你比我老哦。",
                                    "response": [
                                        {
                                            "id": "706920306",
                                            "speaker": "米卡",
                                            "text": "啊…以前确实没这么称呼过你，可能让你有些不适应，我尽快改正！"
                                        },
                                        {
                                            "id": "706920307",
                                            "speaker": "米卡",
                                            "text": "主要是，「国际越野赛」期间，我接触到了好几位纳塔朋友，以不一样的角度，听说了你在纳塔的传奇故事。"
                                        },
                                        {
                                            "id": "706920308",
                                            "speaker": "米卡",
                                            "text": "你战胜了那么恐怖的危机，成为了整个国度的大英雄，还和以前我想都不敢想的厉害人物顺利合作…"
                                        },
                                        {
                                            "id": "706920309",
                                            "speaker": "米卡",
                                            "text": "无论从冒险经历，还是为人处世的角度，你的经验和成就都已经绚烂得堪比星空，令我无比钦佩！"
                                        },
                                        {
                                            "id": "706920310",
                                            "speaker": "米卡",
                                            "text": "相比之下，最近的我似乎没有什么长进…"
                                        },
                                        {
                                            "id": "706920311",
                                            "speaker": "米卡",
                                            "text": "如果说，以前我是朝着你的背影努力，现在的你前进得有些迅猛，都快消失在地平线上了…"
                                        },
                                        {
                                            "id": "706920312",
                                            "speaker": "米卡",
                                            "text": "所以，下意识就对你使用了尊称…",
                                            "choices": [
                                                {
                                                    "id": "706920313",
                                                    "text": "不要气馁，你也会变强的！",
                                                    "response": [
                                                        {
                                                            "id": "706920315",
                                                            "speaker": "米卡",
                                                            "text": "呜…谢谢！我肯定会继续磨练自己的本领，绝不能丧气！"
                                                        },
                                                        {
                                                            "id": "706920316",
                                                            "speaker": "米卡",
                                                            "text": "单单埋头苦练，只凭勤奋，好像也不是个办法…需要换换思路。"
                                                        },
                                                        {
                                                            "id": "706920317",
                                                            "speaker": "米卡",
                                                            "text": "我会尽量找机会，多接触一些新事物，打破固有思维…"
                                                        },
                                                        {
                                                            "id": "706920318",
                                                            "speaker": "米卡",
                                                            "text": "这次合作改进「前哨龙龙」，就当是一种练习了！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "706920314",
                                                    "text": "有机会一起出门锻炼！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "706920305",
                                    "text": "不论资历，我们是朋友嘛。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706920319",
                    "text": "勘测机关不会抢你的工作吗？",
                    "response": [
                        {
                            "id": "706920320",
                            "speaker": "米卡",
                            "text": "机关和人的工作之争吗…这个问题我之前也思考过。"
                        },
                        {
                            "id": "706920321",
                            "speaker": "米卡",
                            "text": "我在挪德卡莱停留的时候，读到了三本枫丹和璃月工程人员的著作，受到了不少启发。"
                        },
                        {
                            "id": "706920322",
                            "speaker": "米卡",
                            "text": "拥有无限能源，能够从无限远的距离上遥控的机关，确实能替代我这种测绘员，甚至其他岗位的骑士。"
                        },
                        {
                            "id": "706920323",
                            "speaker": "米卡",
                            "text": "之前，骑士团的同僚在考察枫丹的警卫机关后，也感慨过：「将来迟早要用无人机关打仗，完全不需要士兵上阵」。"
                        },
                        {
                            "id": "706920324",
                            "speaker": "米卡",
                            "text": "但那只是理想条件，只谈供能和行动策略的问题，就不是机关能独立解决的。"
                        },
                        {
                            "id": "706920325",
                            "speaker": "米卡",
                            "text": "大部分机关不可能直接从营地出发，抵达目标位置后开始行动，那样的话，在执行任务前，储备的能量就不知会损耗多少。",
                            "choices": [
                                {
                                    "id": "706920326",
                                    "text": "确实…路上的不确定因素很多。",
                                    "response": [
                                        {
                                            "id": "706920328",
                                            "speaker": "米卡",
                                            "text": "是哦，一般还是由操作员们把机关带到合适的位置后，再将它们投入工作，工作过程也是人为可控的，以便随时应对意外。"
                                        },
                                        {
                                            "id": "706920329",
                                            "speaker": "米卡",
                                            "text": "要让机关完全脱离人运转，可能还需要好长好长的时间。"
                                        },
                                        {
                                            "id": "706920330",
                                            "speaker": "米卡",
                                            "text": "所以我的观点倾向于…目前在军事和冒险领域，机关依然是人的能力倍增器，而不是取代者。"
                                        },
                                        {
                                            "id": "706920331",
                                            "speaker": "米卡",
                                            "text": "我也想试着练习…一个人操作多台机关，同步测绘广大区域的新战法！"
                                        }
                                    ]
                                },
                                {
                                    "id": "706920327",
                                    "text": "让机关完全自主行动不保险。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706920332",
                    "text": "这个先放一边，最近还忙吗？",
                    "response": [
                        {
                            "id": "706920333",
                            "speaker": "米卡",
                            "text": "啊…感谢关心！如你所见，我暂时闲下来了。"
                        },
                        {
                            "id": "706920334",
                            "speaker": "米卡",
                            "text": "协助洛恩副队长的旧部适应新岗位后，我就来越野赛帮忙，下次远征队相关的人事协调工作，应该排到了两周后。",
                            "choices": [
                                {
                                    "id": "706920335",
                                    "text": "…洛恩？",
                                    "response": [
                                        {
                                            "id": "706920337",
                                            "speaker": "米卡",
                                            "text": "嗯！洛恩前辈是第五小队的副队长，之前一直在远征队中，担任机动兵力的骨干成员。"
                                        },
                                        {
                                            "id": "706920338",
                                            "speaker": "米卡",
                                            "text": "最近随着任务变动，这支小队的部分成员正准备返回蒙德…"
                                        },
                                        {
                                            "id": "706920339",
                                            "speaker": "米卡",
                                            "text": "第五小队是一支比较特别的小队，最初组建时，以使用弓箭为主，随着技术进步，开始逐渐列装多种远程武器…"
                                        },
                                        {
                                            "id": "706920340",
                                            "speaker": "米卡",
                                            "text": "平时，他们会作为一支小队整体进行训练，执行任务时，则会按照预先分好的小单位，被分配给其他小队，加强火力。",
                                            "choices": [
                                                {
                                                    "id": "706920341",
                                                    "text": "拆分开来作战？",
                                                    "response": [
                                                        {
                                                            "id": "706920343",
                                                            "speaker": "米卡",
                                                            "text": "大团长说，这样有助于提升火力运用的灵活性，让任何小队的骑士面对长手作战的敌人时，都不至于处于被动。"
                                                        },
                                                        {
                                                            "id": "706920344",
                                                            "speaker": "米卡",
                                                            "text": "因此，第五小队的成员们处于一种…「随叫随到，哪里需要救火就去哪」的状态，战斗任务的强度相当高。"
                                                        },
                                                        {
                                                            "id": "706920345",
                                                            "speaker": "米卡",
                                                            "text": "而洛恩前辈是第五小队中的佼佼者，他很喜欢在前线东奔西走，经常嫌魔物不够打，我很佩服他的战斗热情！",
                                                            "choices": [
                                                                {
                                                                    "id": "706920346",
                                                                    "text": "好像是个狠人…他对你如何？",
                                                                    "response": [
                                                                        {
                                                                            "id": "706920348",
                                                                            "speaker": "米卡",
                                                                            "text": "洛恩前辈对我非常非常好！每次我完成测绘，他都要第一时间和我一起校对结果，整理情报…"
                                                                        },
                                                                        {
                                                                            "id": "706920349",
                                                                            "speaker": "米卡",
                                                                            "text": "要是测绘内容存在疑点，洛恩前辈会主动前去「武力侦察」一番，帮我补充最精确的结果。"
                                                                        },
                                                                        {
                                                                            "id": "706920350",
                                                                            "speaker": "米卡",
                                                                            "text": "至于洛恩前辈的恶作剧…我觉得习惯以后，就能接受的。"
                                                                        },
                                                                        {
                                                                            "id": "706920351",
                                                                            "speaker": "米卡",
                                                                            "text": "受他影响，和他走得最近的同僚们，也倾向于使用非常凶猛的打击策略，有时不顾自己的安危…"
                                                                        },
                                                                        {
                                                                            "id": "706920352",
                                                                            "speaker": "米卡",
                                                                            "text": "所以，在考虑他们的人事协调时，除了岗位本身的适配程度，还要为他们找到足够稳重的搭档…"
                                                                        },
                                                                        {
                                                                            "id": "706920353",
                                                                            "speaker": "米卡",
                                                                            "text": "如此一来，就能让他们适当保持冷静，不至于在日常任务中，也打得过于激进了。"
                                                                        },
                                                                        {
                                                                            "id": "706920354",
                                                                            "speaker": "米卡",
                                                                            "text": "我想，等你见到洛恩前辈后，你就能明白他的作风了…"
                                                                        },
                                                                        {
                                                                            "id": "706920355",
                                                                            "speaker": "米卡",
                                                                            "text": "不知怎么，我有种感觉，你和洛恩前辈应该能顺利地熟悉彼此，配合得完美无缺！"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "706920347",
                                                                    "text": "这个…你和他相处得怎么样？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "706920342",
                                                    "text": "不集中使用火力吗？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "706920336",
                                    "text": "…副队长？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706920356",
                    "text": "我先去琢磨琢磨。",
                    "response": [
                        {
                            "id": "706920357",
                            "speaker": "米卡",
                            "text": "那…我就静候佳音！"
                        }
                    ]
                }
            ]
        }
    ]
}