{
    "talkId": "4020902",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 2,
        "克洛琳德": 1,
        "北斗": 4,
        "娜维娅": 3,
        "派蒙": 4,
        "雅珂达": 10
    },
    "dialogues": [
        {
            "id": "402090201",
            "speaker": "雅珂达",
            "text": "这就是刺玫会的那位…"
        },
        {
            "id": "402090202",
            "speaker": "北斗",
            "text": "嗯？"
        },
        {
            "id": "402090203",
            "speaker": "娜维娅",
            "text": "哦？"
        },
        {
            "id": "402090204",
            "speaker": "雅珂达",
            "text": "最棘手的情况还是要发生了吗？"
        },
        {
            "id": "402090205",
            "speaker": "派蒙",
            "text": "雅珂达，你在担心什么啊？"
        },
        {
            "id": "402090206",
            "speaker": "雅珂达",
            "text": "嘘！没看到那边吗？"
        },
        {
            "id": "402090207",
            "speaker": "雅珂达",
            "text": "撑伞的那位是来自枫丹的黑道大小姐，据说她独自统一了将要分裂的帮会，还亲手为父报仇，是个一等一的狠角色。"
        },
        {
            "id": "402090208",
            "speaker": "雅珂达",
            "text": "戴眼罩的那位是来自璃月的佣兵老大，她指挥着一支舰队，纵横远海，几乎没人敢惹。"
        },
        {
            "id": "402090209",
            "speaker": "雅珂达",
            "text": "所谓一山不容二虎，所以我才让她们的展位相隔很远，但是这两位还是见面了…"
        },
        {
            "id": "402090210",
            "speaker": "雅珂达",
            "text": "万一她们之间起了冲突…一想到要调解，我就头大。"
        },
        {
            "id": "402090211",
            "speaker": "Player",
            "text": "先交给我处理吧…"
        },
        {
            "id": "402090212",
            "speaker": "派蒙",
            "text": "大家在聊什么呢？"
        },
        {
            "id": "402090213",
            "speaker": "娜维娅",
            "text": "原来是搭档和派蒙啊。"
        },
        {
            "id": "402090214",
            "speaker": "雅珂达",
            "text": "（搭档…）"
        },
        {
            "id": "402090215",
            "speaker": "北斗",
            "text": "无论是刺玫会的大小姐还是枫丹廷的决斗代理人，我都久闻大名。这次偶然路过，就想来结交一下。"
        },
        {
            "id": "402090216",
            "speaker": "北斗",
            "text": "#正好{NICKNAME}也来了，看在你的面子上，或许这两位小姐愿意到我船上喝一杯茶呢。"
        },
        {
            "id": "402090217",
            "speaker": "雅珂达",
            "text": "#（看在{NICKNAME}的面子上…）"
        },
        {
            "id": "402090218",
            "speaker": "克洛琳德",
            "text": "北斗小姐客气了。"
        },
        {
            "id": "402090219",
            "speaker": "派蒙",
            "text": "#是这样的，那位是我和{NICKNAME}的朋友，她负责管理展会秩序，所以很担心你们之间会不会起什么冲突。"
        },
        {
            "id": "402090220",
            "speaker": "娜维娅",
            "text": "怎么会？尽管让她放心。"
        },
        {
            "id": "402090221",
            "speaker": "北斗",
            "text": "有需要我们帮忙的地方，也可以直说。"
        },
        {
            "id": "402090222",
            "speaker": "派蒙",
            "text": "总之…不用再担心了。"
        },
        {
            "id": "402090223",
            "speaker": "雅珂达",
            "text": "#{NICKNAME}…你的人脉怎么这么强？"
        },
        {
            "id": "402090224",
            "speaker": "Player",
            "text": "因为我的旅程足够长吧。"
        }
    ]
}