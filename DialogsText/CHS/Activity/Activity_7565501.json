{
    "talkId": "7565501",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 8,
        "柯莱": 14
    },
    "dialogues": [
        {
            "id": "756550202",
            "speaker": "Player",
            "text": "是来给须弥城留影的。"
        },
        {
            "id": "756550204",
            "speaker": "柯莱",
            "text": "留影啊，的确常常有教令院的学者到这里给须弥城留影。"
        },
        {
            "id": "756550205",
            "speaker": "柯莱",
            "text": "因论派和妙论派的人来得最多，据说是为了研究城市建设，唔…还有建筑历史之类的话题。",
            "choices": [
                {
                    "id": "756550206",
                    "text": "柯莱很了解各个学派啊。",
                    "response": [
                        {
                            "id": "756550207",
                            "speaker": "柯莱",
                            "text": "其实我了解得不多，只是知道各个学派的研究方向和课程设置而已，比起正式学者还差得远呢。"
                        },
                        {
                            "id": "756550210",
                            "speaker": "柯莱",
                            "text": "真要让我参加教令院选拔考试的话…我想想，啊，恐怕第一轮笔试就过不了关。"
                        },
                        {
                            "id": "756550211",
                            "speaker": "柯莱",
                            "text": "虽然我也希望自己能拥有学者的水平，不过这件事暂时还只是梦想…",
                            "choices": [
                                {
                                    "id": "756550212",
                                    "text": "将来可以的。",
                                    "response": [
                                        {
                                            "id": "756550214",
                                            "speaker": "柯莱",
                                            "text": "#谢谢你，{NICKNAME}。不管怎么说，现在得努力学好基础知识才行！"
                                        },
                                        {
                                            "id": "756550215",
                                            "speaker": "柯莱",
                                            "text": "像现在这样，每天都能学到新知识，我已经很开心了。"
                                        },
                                        {
                                            "id": "756550216",
                                            "speaker": "柯莱",
                                            "text": "至于眼前，做一个好巡林员就是我最大的目标。"
                                        },
                                        {
                                            "id": "756550217",
                                            "speaker": "柯莱",
                                            "text": "为在雨林里迷路的人找到方向，救助误食毒物的人，保护雨林里的动植物。"
                                        },
                                        {
                                            "id": "756550218",
                                            "speaker": "柯莱",
                                            "text": "巡林员能做的事有很多，大家都需要我，我也很愿意帮忙！"
                                        },
                                        {
                                            "id": "756550219",
                                            "speaker": "柯莱",
                                            "text": "说起来，我只是做了一点小事，最后却得到了所有人的认可。"
                                        },
                                        {
                                            "id": "756550220",
                                            "speaker": "柯莱",
                                            "text": "有了更多关心我的人，甚至和你这样厉害的人成了朋友，我运气真好啊。",
                                            "choices": [
                                                {
                                                    "id": "756550221",
                                                    "text": "和柯莱成为朋友我也很高兴。",
                                                    "response": [
                                                        {
                                                            "id": "756550223",
                                                            "speaker": "柯莱",
                                                            "text": "哈哈，所以如果有什么需要帮忙的，请放心和我说吧。"
                                                        },
                                                        {
                                                            "id": "756550224",
                                                            "speaker": "Player",
                                                            "text": "想请柯莱帮忙留影。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756550222",
                                                    "text": "嗯，柯莱和我都很厉害。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756550213",
                                    "text": "柯莱加油！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756550208",
                    "text": "柯莱听过这些学派的课？",
                    "response": [
                        {
                            "id": "756550209",
                            "speaker": "柯莱",
                            "text": "我还不是教令院的学生，没法去听这些学派的课啦，只是听师父介绍过这些学派的研究。"
                        }
                    ]
                }
            ]
        }
    ]
}