{
    "talkId": "7650807",
    "total_dialogue_lines": 49,
    "speaker_counts": {
        "Player": 6,
        "妮露": 11,
        "派蒙": 7,
        "玛拉妮": 25
    },
    "dialogues": [
        {
            "id": "765080701",
            "speaker": "玛拉妮",
            "text": "妮露妮露，试试看吧？"
        },
        {
            "id": "765080702",
            "speaker": "玛拉妮",
            "text": "我把萨巴桑炸角捏成了你喜欢的形状，放进青浪翻车鲀、浪沫羽鳃和胡椒炖煮的高汤…"
        },
        {
            "id": "765080703",
            "speaker": "玛拉妮",
            "text": "蒸煮半个小时后，再用文火烤干…风味是不是完全不一样了？"
        },
        {
            "id": "765080704",
            "speaker": "妮露",
            "text": "唔…嗯？"
        },
        {
            "id": "765080705",
            "speaker": "妮露",
            "text": "嗯嗯！好神奇，就像…水波起伏，清澈的风味跳起了小步舞？"
        },
        {
            "id": "765080706",
            "speaker": "妮露",
            "text": "炸角原本的酥脆口感，让肉馅里的鲜味一下一下炸开，节奏无比欢快…"
        },
        {
            "id": "765080707",
            "speaker": "妮露",
            "text": "只是吃一口，我就能想起好几段明亮的诗琴曲调！"
        },
        {
            "id": "765080708",
            "speaker": "玛拉妮",
            "text": "嘿嘿，努斯妲给我看过食谱以后，我就觉得，这种小吃肯定和纳塔本地的鱼鲜风味很搭！"
        },
        {
            "id": "765080709",
            "speaker": "玛拉妮",
            "text": "而且提供的能量多多，很适合跳舞后填饱肚子！"
        },
        {
            "id": "765080710",
            "speaker": "妮露",
            "text": "那我们一起动手，做几份类似的料理，给舞团的大家…"
        },
        {
            "id": "765080711",
            "speaker": "派蒙",
            "text": "实在听不下去了啦…我馋了！"
        },
        {
            "id": "765080712",
            "speaker": "妮露",
            "text": "#嗯？是{NICKNAME}和派蒙！你们终于来啦！"
        },
        {
            "id": "765080713",
            "speaker": "玛拉妮",
            "text": "#好呀好呀，至尊嘉宾{NICKNAME}和派蒙到场！",
            "choices": [
                {
                    "id": "765080714",
                    "text": "我们好像来得有点晚…",
                    "response": [
                        {
                            "id": "765080716",
                            "speaker": "玛拉妮",
                            "text": "对哦！我和妮露已经认识半天了！你应该今早就来，和我一起带着妮露在流泉之众好好玩上几圈！"
                        },
                        {
                            "id": "765080717",
                            "speaker": "玛拉妮",
                            "text": "我的好搭档，全纳塔的大英雄，和东道主没区别的重要人物，却对远道而来的尊贵客人招待不周…"
                        },
                        {
                            "id": "765080718",
                            "speaker": "玛拉妮",
                            "text": "哼哼，该罚！"
                        },
                        {
                            "id": "765080719",
                            "speaker": "派蒙",
                            "text": "罚罚…罚？怎么个罚法？"
                        },
                        {
                            "id": "765080720",
                            "speaker": "玛拉妮",
                            "text": "罚你接下来一直陪着我和妮露，吃我们试做的纳塔须弥融合菜到撑！"
                        },
                        {
                            "id": "765080721",
                            "speaker": "玛拉妮",
                            "text": "如果到了晚上，妮露因为玩得太兴奋，睡不着，你就要给她讲温馨可爱的睡前故事，直到她进入快乐的梦乡…"
                        },
                        {
                            "id": "765080722",
                            "speaker": "派蒙",
                            "text": "呼…还真是玛拉妮风格的「惩罚」！"
                        },
                        {
                            "id": "765080723",
                            "speaker": "派蒙",
                            "text": "#这种惩罚，超级加倍都没问题啦，是不是，{NICKNAME}？",
                            "choices": [
                                {
                                    "id": "765080724",
                                    "text": "遵命长官！一定完成！",
                                    "response": [
                                        {
                                            "id": "765080726",
                                            "speaker": "玛拉妮",
                                            "text": "#啊哈哈！{NICKNAME}也入戏了，心情不错嘛！"
                                        },
                                        {
                                            "id": "765080727",
                                            "speaker": "妮露",
                                            "text": "唔，那样的话，应该会完全睡不着的…"
                                        },
                                        {
                                            "id": "765080728",
                                            "speaker": "妮露",
                                            "text": "#不对，我是说…原来{NICKNAME}和玛拉妮，是部族战士的上下级关系吗？"
                                        },
                                        {
                                            "id": "765080729",
                                            "speaker": "玛拉妮",
                                            "text": "当然是开玩笑啦，我只不过在学阿米娜的认真口吻！"
                                        },
                                        {
                                            "id": "765080730",
                                            "speaker": "玛拉妮",
                                            "text": "#要论战绩和资历，我怎么也得是{NICKNAME}的部下…"
                                        },
                                        {
                                            "id": "765080731",
                                            "speaker": "玛拉妮",
                                            "text": "#按照最近流行的轻小说设定，我也可以担任{NICKNAME}的「亲卫队长」~"
                                        },
                                        {
                                            "id": "765080732",
                                            "speaker": "派蒙",
                                            "text": "「亲卫队长」？还有这么威风的称号呢？"
                                        },
                                        {
                                            "id": "765080733",
                                            "speaker": "派蒙",
                                            "text": "一比起来，好像「参谋」都没那么响亮了？"
                                        },
                                        {
                                            "id": "765080734",
                                            "speaker": "玛拉妮",
                                            "text": "根据「深海舌鲆鱼」老师的《轻小说设定学简述》，除了参谋，派蒙还可以是「财运星」——"
                                        },
                                        {
                                            "id": "765080735",
                                            "speaker": "玛拉妮",
                                            "text": "#什么都不用干，就能给{NICKNAME}带来摩拉滚滚的好运。"
                                        },
                                        {
                                            "id": "765080736",
                                            "speaker": "派蒙",
                                            "text": "嘿嘿嘿，这个设定我喜欢！不用战斗也挺厉害的！"
                                        },
                                        {
                                            "id": "765080737",
                                            "speaker": "玛拉妮",
                                            "text": "保持格式，妮露就是我们的「邻家姐姐魔法老师」——"
                                        },
                                        {
                                            "id": "765080738",
                                            "speaker": "玛拉妮",
                                            "text": "明明年纪差不多，可就是非常博学，会用温柔而无形的方法，给大家讲明白高深的道理。"
                                        },
                                        {
                                            "id": "765080739",
                                            "speaker": "妮露",
                                            "text": "欸？我还以为会是…施加祝福一类的协助者？"
                                        },
                                        {
                                            "id": "765080740",
                                            "speaker": "妮露",
                                            "text": "而且，我完全不懂什么高深的知识啦…"
                                        },
                                        {
                                            "id": "765080741",
                                            "speaker": "玛拉妮",
                                            "text": "这就叫高手不自知！"
                                        },
                                        {
                                            "id": "765080742",
                                            "speaker": "玛拉妮",
                                            "text": "你只是在小龙面前简单跳了一小段舞，就让好几只小龙学会了踩点哦。"
                                        },
                                        {
                                            "id": "765080743",
                                            "speaker": "玛拉妮",
                                            "text": "其他部族战士听了你的讲解，也很快学会了基本的舞蹈动作！"
                                        },
                                        {
                                            "id": "765080744",
                                            "speaker": "玛拉妮",
                                            "text": "#只要在{NICKNAME}的引导下，掌握好准确的节奏，大家都能领略到舞蹈的乐趣！"
                                        },
                                        {
                                            "id": "765080745",
                                            "speaker": "玛拉妮",
                                            "text": "#{NICKNAME}和派蒙待会儿就能看到，你用魔法启发的舞蹈者们，超快入行的学习成果！"
                                        },
                                        {
                                            "id": "765080746",
                                            "speaker": "妮露",
                                            "text": "这么夸我，都有点不好意思了…",
                                            "choices": [
                                                {
                                                    "id": "765080747",
                                                    "text": "我相信妮露的魔法！",
                                                    "response": [
                                                        {
                                                            "id": "765080749",
                                                            "speaker": "玛拉妮",
                                                            "text": "#嗯！{NICKNAME}和派蒙，在轻松愉快的首次「舞术交流」聚会上，尽情释放自己的热情吧！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "765080748",
                                                    "text": "我去加上完美的压轴！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "765080725",
                                    "text": "属下了解！我好好准备故事！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "765080715",
                    "text": "我们是不是少看了几集…"
                }
            ]
        }
    ]
}