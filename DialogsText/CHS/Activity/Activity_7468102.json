{
    "talkId": "7468102",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "梅里爱": 11
    },
    "dialogues": [
        {
            "id": "746810201",
            "speaker": "梅里爱",
            "text": "如何？我的「实验映影」和「特技光效」很华丽吧？",
            "choices": [
                {
                    "id": "746810202",
                    "text": "还没玩够…",
                    "response": [
                        {
                            "id": "746810203",
                            "speaker": "梅里爱",
                            "text": "这就对了，我果然没看走眼！"
                        },
                        {
                            "id": "746810204",
                            "speaker": "梅里爱",
                            "text": "你会有这种感觉，说明你很享受拍摄动作戏的体验。"
                        },
                        {
                            "id": "746810205",
                            "speaker": "梅里爱",
                            "text": "去吧，「千灵映影节」期间，我的映影棚始终对你开放，尽管沉浸在映影之中吧！"
                        },
                        {
                            "id": "746810206",
                            "speaker": "梅里爱",
                            "text": "我可是准备了用不完的底片，无论你想多拍多少组镜头，都可以尽情发挥！"
                        }
                    ]
                },
                {
                    "id": "746810207",
                    "text": "影片什么时候正式上映？",
                    "response": [
                        {
                            "id": "746810208",
                            "speaker": "梅里爱",
                            "text": "这可就说不准了…"
                        },
                        {
                            "id": "746810209",
                            "speaker": "梅里爱",
                            "text": "就算你和你的文戏替身顺利拍完所有镜头，剪辑调色和音效处理等环节也要花费许多时间…"
                        },
                        {
                            "id": "746810210",
                            "speaker": "梅里爱",
                            "text": "甚至，等到正式宣传和放出预告时，这些工作都不一定能完成。"
                        },
                        {
                            "id": "746810211",
                            "speaker": "梅里爱",
                            "text": "不过，我们的每项工作都不会白费。哪怕只是多打磨了一两天，最终上映时，映影的质量都会有一定程度的提升！"
                        },
                        {
                            "id": "746810212",
                            "speaker": "梅里爱",
                            "text": "所以，请耐心一点，我的合作伙伴。"
                        }
                    ]
                },
                {
                    "id": "746810213",
                    "text": "告辞了…",
                    "response": [
                        {
                            "id": "746810214",
                            "speaker": "梅里爱",
                            "text": "再见，记得有空的时候多去映影棚拍几组镜头哦！"
                        }
                    ]
                }
            ]
        }
    ]
}