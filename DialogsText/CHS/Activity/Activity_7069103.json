{
    "talkId": "7069103",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 11,
        "可莉": 24
    },
    "dialogues": [
        {
            "id": "706910301",
            "speaker": "可莉",
            "text": "#{M#荣誉骑士哥哥}{F#荣誉骑士姐姐}！可莉开心，你开心吗？",
            "choices": [
                {
                    "id": "706910302",
                    "text": "和可莉一起玩就开心！",
                    "response": [
                        {
                            "id": "706910303",
                            "speaker": "可莉",
                            "text": "好耶！那我们继续捉迷藏！"
                        },
                        {
                            "id": "706910304",
                            "speaker": "可莉",
                            "text": "本来，可莉最早看到这个游戏的时候，它是在桌上玩的…"
                        },
                        {
                            "id": "706910305",
                            "speaker": "可莉",
                            "text": "可莉觉得，要不要试试，真正扮演一下游戏里的角色，就和阿贝多哥哥说了这个想法。"
                        },
                        {
                            "id": "706910306",
                            "speaker": "可莉",
                            "text": "阿贝多哥哥刚好做了和骗骗花一样神奇的…叫什么来着…哦对，炼金道具！"
                        },
                        {
                            "id": "706910307",
                            "speaker": "可莉",
                            "text": "我们把这些道具放在捉迷藏的场地周围，就能装成各种箱子的模样，按照桌上那样的规则来玩了。",
                            "choices": [
                                {
                                    "id": "706910308",
                                    "text": "可莉和阿贝多，厉害！",
                                    "response": [
                                        {
                                            "id": "706910310",
                                            "speaker": "可莉",
                                            "text": "#可莉经常来雪山找阿贝多哥哥，不怕冷，不过，{M#荣誉骑士哥哥}{F#荣誉骑士姐姐}要小心，不要着凉感冒哦！"
                                        }
                                    ]
                                },
                                {
                                    "id": "706910309",
                                    "text": "捉迷藏进化，大成功！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706910311",
                    "text": "还有什么开心的事吗？",
                    "response": [
                        {
                            "id": "706910312",
                            "speaker": "可莉",
                            "text": "有的有的！几个从纳塔来的，一看就很强壮的姐姐，送了可莉不一样的故事书…叫漫画！"
                        },
                        {
                            "id": "706910313",
                            "speaker": "可莉",
                            "text": "漫画里的那些人都好厉害，可莉也想画蒙德的漫画…"
                        },
                        {
                            "id": "706910314",
                            "speaker": "可莉",
                            "text": "#比如…{M#荣誉骑士哥哥}{F#荣誉骑士姐姐}带着可莉去找宝藏的大冒险！"
                        },
                        {
                            "id": "706910315",
                            "speaker": "可莉",
                            "text": "还有妈妈和她朋友的故事！尼可阿姨，芭比阿姨，欧科塔维亚阿姨…"
                        },
                        {
                            "id": "706910316",
                            "speaker": "可莉",
                            "text": "然后然后，可莉的新朋友，瑶瑶姐姐和早柚姐姐，也都有着很神奇的本领，可厉害了！"
                        },
                        {
                            "id": "706910317",
                            "speaker": "可莉",
                            "text": "有意思的事情，几千页都讲不完！",
                            "choices": [
                                {
                                    "id": "706910318",
                                    "text": "支持可莉！",
                                    "response": [
                                        {
                                            "id": "706910320",
                                            "speaker": "可莉",
                                            "text": "可是用蜡笔画不出那种效果，好像要用专门的工具…可莉还得跟着阿贝多哥哥学学画画技巧。"
                                        },
                                        {
                                            "id": "706910321",
                                            "speaker": "可莉",
                                            "text": "阿贝多哥哥要加班…加完班很累，不能让他更累…"
                                        },
                                        {
                                            "id": "706910322",
                                            "speaker": "可莉",
                                            "text": "所以，等到阿贝多哥哥不忙的时候，可莉就去和阿贝多哥哥好好学习！"
                                        },
                                        {
                                            "id": "706910323",
                                            "speaker": "可莉",
                                            "text": "还有还有！宵宫姐姐也来了哦！"
                                        },
                                        {
                                            "id": "706910324",
                                            "speaker": "可莉",
                                            "text": "上次见面还是好久以前，去稻妻参加那个读书祭典的时候…",
                                            "choices": [
                                                {
                                                    "id": "706910325",
                                                    "text": "容彩祭？",
                                                    "response": [
                                                        {
                                                            "id": "706910327",
                                                            "speaker": "可莉",
                                                            "text": "宵宫姐姐路过的时候，可莉隔着好远好远，一下子就看到她了！"
                                                        },
                                                        {
                                                            "id": "706910328",
                                                            "speaker": "可莉",
                                                            "text": "然后，可莉带着宵宫姐姐在蒙德转了好几圈，吃了好多只有蒙德才有的好吃的！"
                                                        },
                                                        {
                                                            "id": "706910329",
                                                            "speaker": "可莉",
                                                            "text": "虽然还想带宵宫姐姐试试炸鱼，但琴团长说最近有很多外国客人…不能吓到他们，会让蒙德被误会！",
                                                            "choices": [
                                                                {
                                                                    "id": "706910330",
                                                                    "text": "可莉扮演了称职的东道主！",
                                                                    "response": [
                                                                        {
                                                                            "id": "706910332",
                                                                            "speaker": "可莉",
                                                                            "text": "嘿嘿，以后肯定还有机会的…"
                                                                        },
                                                                        {
                                                                            "id": "706910333",
                                                                            "speaker": "可莉",
                                                                            "text": "我想看——宵宫姐姐的烟花，在果酒湖里炸出金鱼的形状！"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "706910331",
                                                                    "text": "可莉越来越懂事了，棒！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "706910326",
                                                    "text": "确实有一阵子了呢！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "706910319",
                                    "text": "可莉要成为大漫画家！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706910334",
                    "text": "待会儿再来继续开心！",
                    "response": [
                        {
                            "id": "706910335",
                            "speaker": "可莉",
                            "text": "好！可莉等着你哦！"
                        }
                    ]
                }
            ]
        }
    ]
}