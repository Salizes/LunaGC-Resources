{
    "talkId": "7567203",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 10,
        "班尼特": 27
    },
    "dialogues": [
        {
            "id": "756720301",
            "speaker": "班尼特",
            "text": "#状态怎么样，{NICKNAME}？我们继续引导阿夏收集染料？",
            "choices": [
                {
                    "id": "756720302",
                    "text": "一起加油吧！",
                    "response": [
                        {
                            "id": "756720303",
                            "speaker": "班尼特",
                            "text": "好！和你一起冒险，每次都干劲满满！"
                        }
                    ]
                },
                {
                    "id": "756720304",
                    "text": "还有什么好消息吗？",
                    "response": [
                        {
                            "id": "756720305",
                            "speaker": "班尼特",
                            "text": "这个呀，让我想想…"
                        },
                        {
                            "id": "756720306",
                            "speaker": "班尼特",
                            "text": "…在纳塔，我的运气实在太好了，所以可以尝试许多以前不敢深入研究的事…"
                        },
                        {
                            "id": "756720307",
                            "speaker": "班尼特",
                            "text": "比如——给自己做一组超合适的冒险护具！护腕护膝绑腿和鞋垫都要有！",
                            "choices": [
                                {
                                    "id": "756720308",
                                    "text": "没想到的道具…",
                                    "response": [
                                        {
                                            "id": "756720310",
                                            "speaker": "班尼特",
                                            "text": "#{NICKNAME}也要留意哦，冒险的过程中，保护关节和双脚是一等一的大事。"
                                        },
                                        {
                                            "id": "756720311",
                                            "speaker": "班尼特",
                                            "text": "背着重物爬坡，会对膝盖持续施加压力，通过崎岖的地形时，要防止一脚没踩稳，扭伤脚踝…"
                                        },
                                        {
                                            "id": "756720312",
                                            "speaker": "班尼特",
                                            "text": "长途步行中，双脚也有可能比双腿先撑不住，需要有效避免疲惫，甚至是无形受伤。"
                                        },
                                        {
                                            "id": "756720313",
                                            "speaker": "班尼特",
                                            "text": "减震和保护作用都不错的护具，就能在这种时候派上用场。",
                                            "choices": [
                                                {
                                                    "id": "756720314",
                                                    "text": "这么一说确实有道理。",
                                                    "response": [
                                                        {
                                                            "id": "756720316",
                                                            "speaker": "班尼特",
                                                            "text": "长远来看，对自己有利的道具，永远不嫌多嘛！"
                                                        },
                                                        {
                                                            "id": "756720317",
                                                            "speaker": "班尼特",
                                                            "text": "也可以听听普通冒险家们许多年来不断试错，总结出的窍门——"
                                                        },
                                                        {
                                                            "id": "756720318",
                                                            "speaker": "班尼特",
                                                            "text": "把诸如嘟嘟莲和肉龙掌一类的植物，切成小块后，捣碎在面粉里，放进锅中，加入磐石精油熬煮两天。"
                                                        },
                                                        {
                                                            "id": "756720319",
                                                            "speaker": "班尼特",
                                                            "text": "然后倒进模具，放在冰雾花旁边冷却一晚，稍微修修外形，削去不平的地方…"
                                                        },
                                                        {
                                                            "id": "756720320",
                                                            "speaker": "班尼特",
                                                            "text": "比须弥的跳跳菇还有弹性的护具，就完工了！据说有了它，一天爬两回图兰大火山，关节和脚底都不会受伤！",
                                                            "choices": [
                                                                {
                                                                    "id": "756720321",
                                                                    "text": "听起来工艺也不复杂？",
                                                                    "response": [
                                                                        {
                                                                            "id": "756720323",
                                                                            "speaker": "班尼特",
                                                                            "text": "哎呀，换在其他地方，我在熬煮的那一环，就会败下阵来。"
                                                                        },
                                                                        {
                                                                            "id": "756720324",
                                                                            "speaker": "班尼特",
                                                                            "text": "要么是锅里混进去不知道什么成分，煮到一半就变质，要么就是整口锅都炸掉，碎片到处乱崩…"
                                                                        },
                                                                        {
                                                                            "id": "756720325",
                                                                            "speaker": "班尼特",
                                                                            "text": "如果我自己去买，尺码合不合适另说，十有八九会买到次品。"
                                                                        },
                                                                        {
                                                                            "id": "756720326",
                                                                            "speaker": "班尼特",
                                                                            "text": "关键，也不是老板有意卖给我劣质货，而是他们自己都没检查出问题…我只能自认倒霉。"
                                                                        },
                                                                        {
                                                                            "id": "756720327",
                                                                            "speaker": "班尼特",
                                                                            "text": "所以以前，我还从没搞到过好用的护具呢，这事说大也不大，说小，也还确实对冒险的体验有影响。"
                                                                        },
                                                                        {
                                                                            "id": "756720328",
                                                                            "speaker": "班尼特",
                                                                            "text": "这次来度假村，我就地取材，总算做出了最满意的作品…"
                                                                        },
                                                                        {
                                                                            "id": "756720329",
                                                                            "speaker": "班尼特",
                                                                            "text": "真是太舒心了…原来踏上好用的鞋垫，戴上弹性正合适的护膝再跑步，是这种感觉！"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "756720322",
                                                                    "text": "虽然我不用这个也能爬好几回…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756720315",
                                                    "text": "平常没怎么注意过。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756720309",
                                    "text": "为什么是这个？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756720330",
                    "text": "附近还有别的朋友吗？",
                    "response": [
                        {
                            "id": "756720331",
                            "speaker": "班尼特",
                            "text": "这个，如果是说以前打过交道的冒险家朋友，那他们都心满意足，跟着老爹们回去了啦。"
                        },
                        {
                            "id": "756720332",
                            "speaker": "班尼特",
                            "text": "还留在纳塔的，只有和我们同乘一支车队来玩的几位蒙德游客。"
                        },
                        {
                            "id": "756720333",
                            "speaker": "班尼特",
                            "text": "不过，有一位长着角的…摔角手？找了过来，向我询问，有没有见过一个戴帽子的女孩…"
                        },
                        {
                            "id": "756720334",
                            "speaker": "班尼特",
                            "text": "听说那位摔角手是「沃陆之邦」重要的战士，之前还在「龙脊雪山越野赛」拿了不错的名次。"
                        },
                        {
                            "id": "756720335",
                            "speaker": "班尼特",
                            "text": "也许，在我们没注意到的地方，不少蒙德人都和纳塔人交上朋友了？"
                        }
                    ]
                },
                {
                    "id": "756720336",
                    "text": "待会儿再来。",
                    "response": [
                        {
                            "id": "756720337",
                            "speaker": "班尼特",
                            "text": "嗯，我们等着你！"
                        }
                    ]
                }
            ]
        }
    ]
}