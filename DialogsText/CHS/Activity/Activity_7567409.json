{
    "talkId": "7567409",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Player": 10,
        "妮露": 29
    },
    "dialogues": [
        {
            "id": "756740901",
            "speaker": "妮露",
            "text": "#今天的你散发着欢悦的气息，{NICKNAME}，我也为你高兴。",
            "choices": [
                {
                    "id": "756740902",
                    "text": "也为你交到了新朋友开心。",
                    "response": [
                        {
                            "id": "756740903",
                            "speaker": "妮露",
                            "text": "#谢谢你，{NICKNAME}。"
                        },
                        {
                            "id": "756740904",
                            "speaker": "妮露",
                            "text": "这次，我已经在纳塔待了半个多月。"
                        },
                        {
                            "id": "756740905",
                            "speaker": "妮露",
                            "text": "以前还不怎么出远门的我，第一次长期体会须弥以外的生活。"
                        },
                        {
                            "id": "756740906",
                            "speaker": "妮露",
                            "text": "而在「悠悠度假村」，我有了不同于「流泉之众」那一回的感受。"
                        },
                        {
                            "id": "756740907",
                            "speaker": "妮露",
                            "text": "纳塔真的是一个很厉害的地方，六个部族都有自己的音乐风格…"
                        },
                        {
                            "id": "756740908",
                            "speaker": "妮露",
                            "text": "卡齐娜妹妹带我在「回声之子」参观的时候，我看到了他们独特的战舞较量。"
                        },
                        {
                            "id": "756740909",
                            "speaker": "妮露",
                            "text": "有些动作实在厉害，比如单手撑着地面，就让身体悬空…"
                        },
                        {
                            "id": "756740910",
                            "speaker": "妮露",
                            "text": "还有，躺倒在地面，腰腹和后背发力，飞快地旋转起来。"
                        },
                        {
                            "id": "756740911",
                            "speaker": "妮露",
                            "text": "「力量感」原来也能这样呈现在跳舞之中啊。",
                            "choices": [
                                {
                                    "id": "756740912",
                                    "text": "舞蹈也有专攻嘛。",
                                    "response": [
                                        {
                                            "id": "756740914",
                                            "speaker": "妮露",
                                            "text": "嗯，我其实也没法想象，如果自己来跳那样的舞，会是什么情景…"
                                        },
                                        {
                                            "id": "756740915",
                                            "speaker": "妮露",
                                            "text": "不强求自己什么都能学会，但可以像玛拉妮那样，乐观地接受新的事物。"
                                        },
                                        {
                                            "id": "756740916",
                                            "speaker": "妮露",
                                            "text": "艺术也要不断汲取新的养分，才能变得更美好吧。"
                                        },
                                        {
                                            "id": "756740917",
                                            "speaker": "妮露",
                                            "text": "关于这一点，多亏那位蒙德来的芭芭拉牧师，我也有收获。",
                                            "choices": [
                                                {
                                                    "id": "756740918",
                                                    "text": "向芭芭拉学习了？",
                                                    "response": [
                                                        {
                                                            "id": "756740920",
                                                            "speaker": "妮露",
                                                            "text": "是舞蹈中的「活力」。"
                                                        },
                                                        {
                                                            "id": "756740921",
                                                            "speaker": "妮露",
                                                            "text": "你知道的，以前的须弥不支持舞蹈这样的艺术。"
                                                        },
                                                        {
                                                            "id": "756740922",
                                                            "speaker": "妮露",
                                                            "text": "即使限制解除了很久，大家的习惯也还在慢慢改变的过程中。"
                                                        },
                                                        {
                                                            "id": "756740923",
                                                            "speaker": "妮露",
                                                            "text": "所以，我们的歌舞依然强调智慧，雅致和优美，不能有夸张的动作。"
                                                        },
                                                        {
                                                            "id": "756740924",
                                                            "speaker": "妮露",
                                                            "text": "迪希雅说，这属于文化上一种叫…「惯性」的东西，有点深奥。",
                                                            "choices": [
                                                                {
                                                                    "id": "756740925",
                                                                    "text": "大家改变观念是好几年的事。",
                                                                    "response": [
                                                                        {
                                                                            "id": "756740927",
                                                                            "speaker": "妮露",
                                                                            "text": "是吗…是这样啊。"
                                                                        },
                                                                        {
                                                                            "id": "756740928",
                                                                            "speaker": "妮露",
                                                                            "text": "对比之下，芭芭拉小姐跳起舞来，就无拘无束得多…"
                                                                        },
                                                                        {
                                                                            "id": "756740929",
                                                                            "speaker": "妮露",
                                                                            "text": "…可以说，很可爱。"
                                                                        },
                                                                        {
                                                                            "id": "756740930",
                                                                            "speaker": "妮露",
                                                                            "text": "不过，有一点点遗憾的是，芭芭拉牧师面对我的时候，反倒太有礼貌了？"
                                                                        },
                                                                        {
                                                                            "id": "756740931",
                                                                            "speaker": "妮露",
                                                                            "text": "唔，这么说不太准确，应该说，有点拘谨？"
                                                                        },
                                                                        {
                                                                            "id": "756740932",
                                                                            "speaker": "妮露",
                                                                            "text": "是因为她的身份吗？还是别的什么原因。",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "756740933",
                                                                                    "text": "第一次来见面，不太熟悉吧。",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "756740935",
                                                                                            "speaker": "妮露",
                                                                                            "text": "…好像明白了？"
                                                                                        },
                                                                                        {
                                                                                            "id": "756740936",
                                                                                            "speaker": "妮露",
                                                                                            "text": "不管多久，我都会等的。"
                                                                                        },
                                                                                        {
                                                                                            "id": "756740937",
                                                                                            "speaker": "妮露",
                                                                                            "text": "我也想和芭芭拉小姐成为像玛拉妮一样的朋友。"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "756740934",
                                                                                    "text": "人际关系也要慢慢来哦。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "756740926",
                                                                    "text": "整体变好确实需要更多时间。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756740919",
                                                    "text": "是什么样的收获？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756740913",
                                    "text": "那是另一种舞蹈路线啦。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740938",
                    "text": "我们继续跳舞，继续开心！",
                    "response": [
                        {
                            "id": "756740939",
                            "speaker": "妮露",
                            "text": "嗯！我们一起在欢快的音乐中，补充更多活力。"
                        }
                    ]
                }
            ]
        }
    ]
}