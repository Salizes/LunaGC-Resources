{
    "talkId": "7467502",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "小露米埃尔": 7
    },
    "dialogues": [
        {
            "id": "746750201",
            "speaker": "小露米埃尔",
            "text": "怎么样，要尝试拍摄映影吗？",
            "choices": [
                {
                    "id": "746750202",
                    "text": "想要试试。",
                    "response": [
                        {
                            "id": "746750203",
                            "speaker": "小露米埃尔",
                            "text": "很好，我已经挑好拍摄场景，演员也已经就位，就等两位去片场开拍了。"
                        }
                    ]
                },
                {
                    "id": "746750204",
                    "text": "关于你的兄长…",
                    "response": [
                        {
                            "id": "746750205",
                            "speaker": "小露米埃尔",
                            "text": "露米埃尔年长我很多，不过这不是问题，我们兄弟俩合作无间。"
                        },
                        {
                            "id": "746750206",
                            "speaker": "小露米埃尔",
                            "text": "拍摄《进站》和《工厂大门》的时候，我们还没什么名气。"
                        },
                        {
                            "id": "746750207",
                            "speaker": "小露米埃尔",
                            "text": "所有的事情都是我们兄弟俩一起完成的，因为当时没人愿意给不出名的电影爱好者做助手，哈哈。"
                        },
                        {
                            "id": "746750208",
                            "speaker": "小露米埃尔",
                            "text": "如果你有兴趣的话，可以去看看这两部映影。"
                        }
                    ]
                },
                {
                    "id": "746750209",
                    "text": "还没准备好。",
                    "response": [
                        {
                            "id": "746750210",
                            "speaker": "小露米埃尔",
                            "text": "没关系，我能理解，好的作品需要时间沉淀。"
                        }
                    ]
                }
            ]
        }
    ]
}