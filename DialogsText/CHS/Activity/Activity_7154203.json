{
    "talkId": "7154203",
    "total_dialogue_lines": 44,
    "speaker_counts": {
        "Player": 10,
        "「花角玉将」": 25,
        "派蒙": 9
    },
    "dialogues": [
        {
            "id": "715420301",
            "speaker": "「花角玉将」",
            "text": "怎么样，「鬼王的左膀右臂」大人，您是否痛痛快快指挥了「花羽叶月神机」，一骑当千，若出入无人…无敌之境？",
            "choices": [
                {
                    "id": "715420302",
                    "text": "确实无敌！",
                    "response": [
                        {
                            "id": "715420303",
                            "speaker": "派蒙",
                            "text": "没…没那么夸张吧？我觉得「无敌」这个词，应该说的是…想都不用想，就轻轻松松把对手打趴的情况。"
                        },
                        {
                            "id": "715420304",
                            "speaker": "派蒙",
                            "text": "#操纵「花羽叶月神机」的时候，我们还是好好思考过战术的。不会像{NICKNAME}在冒险中那样，眯着眼睛打败史莱姆。",
                            "choices": [
                                {
                                    "id": "715420305",
                                    "text": "以鬼兜虫的小身板很强了。",
                                    "response": [
                                        {
                                            "id": "715420307",
                                            "speaker": "派蒙",
                                            "text": "那倒是没错啦…"
                                        },
                                        {
                                            "id": "715420308",
                                            "speaker": "派蒙",
                                            "text": "想起之前，一斗和花角玉将用真正的鬼兜虫挑战幼岩龙蜥…对方只是跺跺脚，这边就全都晕过去了，根本没得打。"
                                        },
                                        {
                                            "id": "715420309",
                                            "speaker": "「花角玉将」",
                                            "text": "机关鬼兜虫超厉害的，对吧？"
                                        },
                                        {
                                            "id": "715420310",
                                            "speaker": "「花角玉将」",
                                            "text": "看见现今「花羽叶月神机」的表现，当初鬼王声称要用机关鬼兜虫之道拓展斗虫的边界，这决定无比正确，富有远见！"
                                        },
                                        {
                                            "id": "715420311",
                                            "speaker": "「花角玉将」",
                                            "text": "当然，学习机关术的难度也令人惊惧。在下听说，璃月的工学和算术课程常让同学龄的外人头晕目眩…这些都是基础。"
                                        },
                                        {
                                            "id": "715420312",
                                            "speaker": "「花角玉将」",
                                            "text": "不知鬼王的算术功底如何…"
                                        }
                                    ]
                                },
                                {
                                    "id": "715420306",
                                    "text": "放在小动物中堪称一绝。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715420313",
                    "text": "先不谈这个，关于一斗…",
                    "response": [
                        {
                            "id": "715420314",
                            "speaker": "「花角玉将」",
                            "text": "哦！忘了告诉你们了，鬼王和在下一直保持着书信来往，虽然看信件的字迹，似乎是忍姐代笔的…"
                        },
                        {
                            "id": "715420315",
                            "speaker": "派蒙",
                            "text": "噫，放牛的那家伙，作风还是没变！"
                        },
                        {
                            "id": "715420316",
                            "speaker": "「花角玉将」",
                            "text": "稻妻发生的大事，我还是知道的。比如，上次分别后，鬼王举办了「荒泷生命摇滚虹色大巡回」…"
                        },
                        {
                            "id": "715420317",
                            "speaker": "「花角玉将」",
                            "text": "那场音乐盛典甚至被人改编成了轻小说，其中鬼王演唱的主题曲故事，也得到了扩写。"
                        },
                        {
                            "id": "715420318",
                            "speaker": "「花角玉将」",
                            "text": "忍姐还特别在来信中附带了一本限量印刷纪念版，邮费就花掉了荒泷派不少预算…"
                        },
                        {
                            "id": "715420319",
                            "speaker": "「花角玉将」",
                            "text": "虽然小说的销量不好，作品没什么名气，但有一股灵气，在下非常喜欢！"
                        },
                        {
                            "id": "715420320",
                            "speaker": "「花角玉将」",
                            "text": "漱玉师父将这本书转交给留云仙君读过，我听说，留云仙君的评价是「颇有几分豪情」。"
                        },
                        {
                            "id": "715420321",
                            "speaker": "「花角玉将」",
                            "text": "结合我来访时说明的来意，留云仙君似是有了什么想法，才与萍仙君商量后，创制了「漱玉工奇斗虫大玄境」。"
                        },
                        {
                            "id": "715420322",
                            "speaker": "派蒙",
                            "text": "也就是说，这个斗虫秘境有一部分创作灵感…来源于放牛的唱的那首歌？"
                        },
                        {
                            "id": "715420323",
                            "speaker": "「花角玉将」",
                            "text": "没错！等到在下修习仙家玄术大成，就要回到鬼王身边，踏踏实实为他打造一个「荒泷撞翻世界斗虫大会」…"
                        },
                        {
                            "id": "715420324",
                            "speaker": "「花角玉将」",
                            "text": "咳咳，名字还没想好，得鬼王亲自来起才有那种韵味…总之，在下会努力的！"
                        }
                    ]
                },
                {
                    "id": "715420325",
                    "text": "跟漱玉师父学得如何了…",
                    "response": [
                        {
                            "id": "715420326",
                            "speaker": "「花角玉将」",
                            "text": "不瞒大人，在下才刚找到仙家洞府不过几日。但与鬼王分别，似乎快一年了，时间真是无情！"
                        },
                        {
                            "id": "715420327",
                            "speaker": "派蒙",
                            "text": "怎么回事，你是被什么麻烦事拖住了吗？"
                        },
                        {
                            "id": "715420328",
                            "speaker": "「花角玉将」",
                            "text": "没有啦，其实，在下于《万文集舍》读到了高人的著作，书中说，要想打动仙家高人，「此事不可强求，机缘乃重中之重」…"
                        },
                        {
                            "id": "715420329",
                            "speaker": "「花角玉将」",
                            "text": "所以在下没有过分依赖厨神姐姐的指引，只是帮厨神姐姐当了一段时间的原材料搬运工，报答了她和锅巴兄。"
                        },
                        {
                            "id": "715420330",
                            "speaker": "「花角玉将」",
                            "text": "随后在下便离开万民堂，去山野间游历了。"
                        },
                        {
                            "id": "715420331",
                            "speaker": "「花角玉将」",
                            "text": "在璃月的山间，在下见识到了许多新奇的事物。"
                        },
                        {
                            "id": "715420332",
                            "speaker": "「花角玉将」",
                            "text": "比如…使用自动锅的赤红巨鹿，在下远远看见那尊巨鹿将食材投入一口悬空的锅，便获得了香喷喷的料理…真让人大开眼界！"
                        },
                        {
                            "id": "715420333",
                            "speaker": "「花角玉将」",
                            "text": "不愧是璃月，连鹿都会使用机关！"
                        },
                        {
                            "id": "715420334",
                            "speaker": "派蒙",
                            "text": "这鹿，这锅…好像很耳熟…",
                            "choices": [
                                {
                                    "id": "715420335",
                                    "text": "是…是吗？",
                                    "response": [
                                        {
                                            "id": "715420337",
                                            "speaker": "「花角玉将」",
                                            "text": "多谢那尊赤红的巨鹿，在下受到启发，向工匠定制了自动研磨与煮制抹茶的机关，并在奇妙的仙家迹象多发之地煮茶…"
                                        },
                                        {
                                            "id": "715420338",
                                            "speaker": "「花角玉将」",
                                            "text": "结果，漱玉师父就循着香味找了过来，在下这才得到机会，正式拜访仙家洞府。"
                                        },
                                        {
                                            "id": "715420339",
                                            "speaker": "「花角玉将」",
                                            "text": "这大概就是书里所说的「机缘」吧——也可以理解成「因为机关的缘故」，妙啊，妙啊…",
                                            "choices": [
                                                {
                                                    "id": "715420340",
                                                    "text": "是…是吧？",
                                                    "response": [
                                                        {
                                                            "id": "715420342",
                                                            "speaker": "派蒙",
                                                            "text": "真的是这个意思吗…"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715420341",
                                                    "text": "对…对吗？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715420336",
                                    "text": "对…对吧？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715420343",
                    "text": "下次再来一骑当千。",
                    "response": [
                        {
                            "id": "715420344",
                            "speaker": "「花角玉将」",
                            "text": "嗯！先忙完别的事，再来安安心心享受极致的斗虫吧！"
                        }
                    ]
                }
            ]
        }
    ]
}