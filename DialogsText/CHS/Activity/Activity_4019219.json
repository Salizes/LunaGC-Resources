    "dialogues": [
        {
            "id": "401921901",
            "speaker": "枫原万叶",
            "text": "「天也醉樱花，云脚乱蹒跚…」"
        },
        {
            "id": "401921902",
            "speaker": "Player",
            "text": "万叶没去玩游艺吗？"
        },
        {
            "id": "401921903",
            "speaker": "枫原万叶",
            "text": "你们不是也被这里吸引了吗？虽是为祭典而来，但影向山的绯樱，也还是一如既往地引人驻足呢。"
        },
        {
            "id": "401921904",
            "speaker": "枫原万叶",
            "text": "游艺那边我打算花上几天慢慢感受。山在观山色，雨来听雨声…既然是来游玩的，自然得随性些？"
        }
    ]
}