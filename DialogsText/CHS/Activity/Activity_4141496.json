    "dialogues": [
        {
            "id": "414149601",
            "speaker": "Player",
            "text": "那个家伙？"
        },
        {
            "id": "414149602",
            "speaker": "昆恩",
            "text": "哦，你问贝雅啊。"
        },
        {
            "id": "414149603",
            "speaker": "昆恩",
            "text": "不知道她到底在想什么。"
        },
        {
            "id": "414149604",
            "speaker": "昆恩",
            "text": "自从风花节开始，就一直在念叨什么誓言岬、心形的日落果…"
        },
        {
            "id": "414149605",
            "speaker": "昆恩",
            "text": "怎么可能有那种日落果啊…"
        },
        {
            "id": "414149606",
            "speaker": "昆恩",
            "text": "你说对吧，嗝…"
        }
    ]
}