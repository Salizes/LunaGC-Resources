{
    "talkId": "4015416",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 2,
        "派蒙": 5,
        "砂糖": 11
    },
    "dialogues": [
        {
            "id": "401541601",
            "speaker": "砂糖",
            "text": "哇，连高级的考核都能顺利完成…"
        },
        {
            "id": "401541602",
            "speaker": "砂糖",
            "text": "#{NICKNAME}要不要考虑来我们的实验室帮忙啊？"
        },
        {
            "id": "401541603",
            "speaker": "派蒙",
            "text": "嘿嘿，我们要踏上成为炼金术专家的道路了吗？",
            "choices": [
                {
                    "id": "401541604",
                    "text": "还没到时候吧。",
                    "response": [
                        {
                            "id": "401541606",
                            "speaker": "砂糖",
                            "text": "如果能合作的话，说不定我们能制造出更加厉害的东西呢。"
                        },
                        {
                            "id": "401541607",
                            "speaker": "派蒙",
                            "text": "更加厉害的东西是什么呀？"
                        },
                        {
                            "id": "401541608",
                            "speaker": "砂糖",
                            "text": "以前我的研究对象基本上是各种各样的植物，但这段时间，我看到了炼金药剂在人们身上发挥的种种作用…"
                        },
                        {
                            "id": "401541609",
                            "speaker": "砂糖",
                            "text": "于是我在想，或许炼金术也能帮助人们探索自身的可能性呢。"
                        },
                        {
                            "id": "401541610",
                            "speaker": "砂糖",
                            "text": "比如…能让人一口气记下图书馆里所有藏书的超级记忆药剂。"
                        },
                        {
                            "id": "401541611",
                            "speaker": "砂糖",
                            "text": "或者，让派蒙喝了之后也能独自挑战深渊法师的强效增幅药剂。"
                        },
                        {
                            "id": "401541612",
                            "speaker": "派蒙",
                            "text": "哇，居然能炼制出这样的药剂吗？我的兴趣上来了！"
                        },
                        {
                            "id": "401541613",
                            "speaker": "砂糖",
                            "text": "从理论上来说是有可能的，炼金术是向未知领域的探索，目前我们还没有穷尽炼金术的所有可能性。"
                        },
                        {
                            "id": "401541614",
                            "speaker": "砂糖",
                            "text": "不过，要找到具体的实现方式，就要同时考虑炼金术的升华理论，炼金药剂的转化方式，以及人的生物学特性…"
                        },
                        {
                            "id": "401541615",
                            "speaker": "派蒙",
                            "text": "怎么感觉…已经开始头疼了。"
                        },
                        {
                            "id": "401541616",
                            "speaker": "砂糖",
                            "text": "哎呀，不好意思…如果有兴趣的话，下次来实验室的时候，我再给你们详细解释吧。"
                        },
                        {
                            "id": "401541617",
                            "speaker": "派蒙",
                            "text": "好欸，派蒙也要在变强的道路上更进一步了！"
                        },
                        {
                            "id": "401541618",
                            "speaker": "砂糖",
                            "text": "嗯！那我就先回去了。下次就是最后的考核了，我也要好好准备题目才行呢。"
                        }
                    ]
                },
                {
                    "id": "401541605",
                    "text": "帮忙的话还是可以的。"
                }
            ]
        }
    ]
}