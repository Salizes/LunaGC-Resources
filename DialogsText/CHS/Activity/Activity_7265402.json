    "dialogues": [
        {
            "id": "726540201",
            "speaker": "慕珍",
            "text": "呼，就差一步了，这次任务结束后，我也可以回到船上了！",
            "choices": [
                {
                    "id": "726540202",
                    "text": "你看起来很开心。",
                    "response": [
                        {
                            "id": "726540204",
                            "speaker": "慕珍",
                            "text": "还好啦，我也在岸上待够了，研究进展一片大好，样品订单马上就要有着落了！"
                        },
                        {
                            "id": "726540205",
                            "speaker": "慕珍",
                            "text": "哼哼，这次的订单完全没有依赖大姐头就办成了，等她回来，也一定会惊讶于我们的成长吧！"
                        },
                        {
                            "id": "726540206",
                            "speaker": "Player",
                            "text": "你是说让我跑腿这件事？"
                        },
                        {
                            "id": "726540207",
                            "speaker": "慕珍",
                            "text": "啊，对…还有你的成长！旅行者的成长也是有目共睹的！"
                        },
                        {
                            "id": "726540208",
                            "speaker": "派蒙",
                            "text": "原来北斗大姐头的手下也可以这么不靠谱的吗…"
                        }
                    ]
                },
                {
                    "id": "726540203",
                    "text": "最近进展如何？"
                }
            ]
        }
    ]
}