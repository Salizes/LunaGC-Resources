    "dialogues": [
        {
            "id": "775110301",
            "speaker": "岚姐",
            "text": "协会这边的事情都处理得差不多了，接下来要前往…嗯，彩冰镇北侧的冰原。",
            "choices": [
                {
                    "id": "775110302",
                    "text": "还想再复盘战斗…",
                    "response": [
                        {
                            "id": "775110303",
                            "speaker": "岚姐",
                            "text": "行，再打个痛快吧。"
                        }
                    ]
                },
                {
                    "id": "775110304",
                    "text": "还有任务吗？",
                    "response": [
                        {
                            "id": "775110305",
                            "speaker": "岚姐",
                            "text": "小事，和塔拉利欣去找些…线索。"
                        },
                        {
                            "id": "775110306",
                            "speaker": "岚姐",
                            "text": "之前麻烦过你很多回，这次就不给你多添烦扰了。"
                        },
                        {
                            "id": "775110307",
                            "speaker": "岚姐",
                            "text": "有本地人的协助，就像旅游一样轻松。"
                        }
                    ]
                },
                {
                    "id": "775110308",
                    "text": "祝顺利。",
                    "response": [
                        {
                            "id": "775110309",
                            "speaker": "岚姐",
                            "text": "嗯，我感觉，我们都会好运连连的。"
                        }
                    ]
                }
            ]
        }
    ]
}