{
    "talkId": "7567302",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "班尼特": 8
    },
    "dialogues": [
        {
            "id": "756730201",
            "speaker": "班尼特",
            "text": "#哎呀，感觉我们也越来越默契了，{NICKNAME}！",
            "choices": [
                {
                    "id": "756730202",
                    "text": "还想复盘一下收集颜料的过程。",
                    "response": [
                        {
                            "id": "756730203",
                            "speaker": "班尼特",
                            "text": "哦？难道你也有关于色彩的灵感了吗？那要加油哦！"
                        }
                    ]
                },
                {
                    "id": "756730204",
                    "text": "之后有什么打算？",
                    "response": [
                        {
                            "id": "756730205",
                            "speaker": "班尼特",
                            "text": "嗯…可能有点卡时间。"
                        },
                        {
                            "id": "756730206",
                            "speaker": "班尼特",
                            "text": "距离下一趟回蒙德的车队出发还余下几天，我想试着去爬一下图兰大火山。"
                        },
                        {
                            "id": "756730207",
                            "speaker": "班尼特",
                            "text": "咳咳，我指的是，在外围区域，本着不会冒犯本地人习俗的前提登高，看看那里壮观的景色。",
                            "choices": [
                                {
                                    "id": "756730208",
                                    "text": "要注意安全哦。",
                                    "response": [
                                        {
                                            "id": "756730210",
                                            "speaker": "班尼特",
                                            "text": "嗯，我会的！在纳塔，我信心满满！"
                                        },
                                        {
                                            "id": "756730211",
                                            "speaker": "班尼特",
                                            "text": "也祝你一切顺利！"
                                        }
                                    ]
                                },
                                {
                                    "id": "756730209",
                                    "text": "看风景时也要注意规避危险。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756730212",
                    "text": "下次再见啦，班尼特。",
                    "response": [
                        {
                            "id": "756730213",
                            "speaker": "班尼特",
                            "text": "好嘞，我们都要好运连连，下次再一起分享开心事！"
                        }
                    ]
                }
            ]
        }
    ]
}