{
    "talkId": "7350716",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Player": 9,
        "派蒙": 31,
        "百雷遮罗": 6,
        "转转悠悠兽": 7
    },
    "dialogues": [
        {
            "id": "735071601",
            "speaker": "派蒙",
            "text": "「转转悠悠兽」和「百雷遮罗」，你们好呀！还记得我们吗？"
        },
        {
            "id": "735071602",
            "speaker": "派蒙",
            "text": "它们都很开心的样子，一点都没有犹豫，太好了！"
        },
        {
            "id": "735071603",
            "speaker": "派蒙",
            "text": "唔，我们要陪蕈兽伙伴们做些什么好呢？",
            "choices": [
                {
                    "id": "735071604",
                    "text": "投喂蕈兽伙伴？",
                    "response": [
                        {
                            "id": "735071605",
                            "speaker": "派蒙",
                            "text": "好！让我们来看看两只蕈兽伙伴都喜欢什么口味的「妙妙琼脂」吧！",
                            "choices": [
                                {
                                    "id": "735071606",
                                    "text": "投喂树莓味的「妙妙琼脂」。",
                                    "response": [
                                        {
                                            "id": "735071607",
                                            "speaker": "转转悠悠兽",
                                            "text": "♩~"
                                        },
                                        {
                                            "id": "735071608",
                                            "speaker": "百雷遮罗",
                                            "text": "♬~"
                                        },
                                        {
                                            "id": "735071609",
                                            "speaker": "派蒙",
                                            "text": "嘿嘿，「转转悠悠兽」和「百雷遮罗」都很喜欢树莓的味道呢。"
                                        },
                                        {
                                            "id": "735071610",
                                            "speaker": "派蒙",
                                            "text": "树莓非常好找，旅行途中，我们顺手就积攒了几千个甚至几万个，以后可以留一点给蕈兽伙伴们哦！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071611",
                                    "text": "投喂堇瓜味的「妙妙琼脂」。",
                                    "response": [
                                        {
                                            "id": "735071612",
                                            "speaker": "派蒙",
                                            "text": "没想到还有堇瓜口味！海妮耶好厉害，居然把其他国家的食材也融入了「妙妙琼脂」！"
                                        },
                                        {
                                            "id": "735071613",
                                            "speaker": "转转悠悠兽",
                                            "text": "…"
                                        },
                                        {
                                            "id": "735071614",
                                            "speaker": "百雷遮罗",
                                            "text": "♬~"
                                        },
                                        {
                                            "id": "735071615",
                                            "speaker": "派蒙",
                                            "text": "「转转悠悠兽」好像不太能理解堇瓜的味道呢，说不定它也在思考，堇瓜是水果还是蔬菜！"
                                        },
                                        {
                                            "id": "735071616",
                                            "speaker": "派蒙",
                                            "text": "「百雷遮罗」倒是很欢快，好像想起了开心的事！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071617",
                                    "text": "投喂洋葱味的「妙妙琼脂」。",
                                    "response": [
                                        {
                                            "id": "735071618",
                                            "speaker": "派蒙",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071619",
                                            "speaker": "转转悠悠兽",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071620",
                                            "speaker": "百雷遮罗",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071621",
                                            "speaker": "派蒙",
                                            "text": "怎么还有这种口味？海妮耶的想法还真奇特呢…"
                                        },
                                        {
                                            "id": "735071622",
                                            "speaker": "转转悠悠兽",
                                            "text": "…♩~"
                                        },
                                        {
                                            "id": "735071623",
                                            "speaker": "派蒙",
                                            "text": "欸？「转转悠悠兽」好像反应过来了，它还挺喜欢洋葱味呢！"
                                        },
                                        {
                                            "id": "735071624",
                                            "speaker": "派蒙",
                                            "text": "洋葱有什么特别的效果吗？我想想…"
                                        },
                                        {
                                            "id": "735071625",
                                            "speaker": "派蒙",
                                            "text": "难道是…提神醒脑？"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071626",
                    "text": "用不同的声音来交流？",
                    "response": [
                        {
                            "id": "735071627",
                            "speaker": "派蒙",
                            "text": "要模仿动物的声音吗？可以哦，也想知道「转转悠悠兽」和「百雷遮罗」和其他动物的关系！"
                        },
                        {
                            "id": "735071628",
                            "speaker": "派蒙",
                            "text": "嗯，快来试试看吧！",
                            "choices": [
                                {
                                    "id": "735071629",
                                    "text": "咕咕…",
                                    "response": [
                                        {
                                            "id": "735071630",
                                            "speaker": "转转悠悠兽",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071631",
                                            "speaker": "百雷遮罗",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071632",
                                            "speaker": "派蒙",
                                            "text": "唔，须弥好像没什么鸽子哦，蕈兽伙伴们都不明白是什么意思。"
                                        },
                                        {
                                            "id": "735071633",
                                            "speaker": "派蒙",
                                            "text": "要不然，还是模仿暝彩鸟吧？"
                                        },
                                        {
                                            "id": "735071634",
                                            "speaker": "派蒙",
                                            "text": "喳喳喳，喳~喳喳，喳喳~喳！"
                                        },
                                        {
                                            "id": "735071635",
                                            "speaker": "派蒙",
                                            "text": "噫…好像有点难！完全学不来暝彩鸟的节奏，蕈兽伙伴们会更疑惑的吧…"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071636",
                                    "text": "嗷呜！",
                                    "response": [
                                        {
                                            "id": "735071637",
                                            "speaker": "派蒙",
                                            "text": "咦？这个连我都听不出来啦！难道你在模仿长鬓虎吗？"
                                        },
                                        {
                                            "id": "735071638",
                                            "speaker": "派蒙",
                                            "text": "会吓到蕈兽伙伴们的啦！"
                                        },
                                        {
                                            "id": "735071639",
                                            "speaker": "转转悠悠兽",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071640",
                                            "speaker": "百雷遮罗",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071641",
                                            "speaker": "派蒙",
                                            "text": "等等，蕈兽伙伴们好像很有干劲的样子？"
                                        },
                                        {
                                            "id": "735071642",
                                            "speaker": "派蒙",
                                            "text": "难道「转转悠悠兽」和「百雷遮罗」…以前和长鬓虎交过朋友，一起打过架？"
                                        },
                                        {
                                            "id": "735071643",
                                            "speaker": "派蒙",
                                            "text": "有点想象不出那个画面呢，以后我们多观察一下野外的蕈兽吧！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071644",
                                    "text": "呃~嘎嘎嘎！",
                                    "response": [
                                        {
                                            "id": "735071645",
                                            "speaker": "派蒙",
                                            "text": "你怎么在学深渊法师的声音！就算不太像，也会吓到蕈兽伙伴们的啦！"
                                        },
                                        {
                                            "id": "735071646",
                                            "speaker": "转转悠悠兽",
                                            "text": "！"
                                        },
                                        {
                                            "id": "735071647",
                                            "speaker": "百雷遮罗",
                                            "text": "！"
                                        },
                                        {
                                            "id": "735071648",
                                            "speaker": "派蒙",
                                            "text": "呜！「转转悠悠兽」和「百雷遮罗」好像有点害怕！"
                                        },
                                        {
                                            "id": "735071649",
                                            "speaker": "派蒙",
                                            "text": "#没事的，没事的，{NICKNAME}在恶作剧啦，附近没有深渊法师哦。"
                                        },
                                        {
                                            "id": "735071650",
                                            "speaker": "派蒙",
                                            "text": "不过，难道有的深渊法师会带着丘丘人欺负蕈兽吗？"
                                        },
                                        {
                                            "id": "735071651",
                                            "speaker": "派蒙",
                                            "text": "可恶，这样一想就有点生气！如果以后在野外遇见了被欺负的蕈兽，我们可不能坐视不理！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071652",
                    "text": "待会儿再来和蕈兽伙伴们玩。",
                    "response": [
                        {
                            "id": "735071653",
                            "speaker": "派蒙",
                            "text": "唔，确实还有些事没办完呢…那我们加把劲，争取尽快收工，多陪「转转悠悠兽」和「百雷遮罗」一会儿！"
                        }
                    ]
                }
            ]
        }
    ]
}