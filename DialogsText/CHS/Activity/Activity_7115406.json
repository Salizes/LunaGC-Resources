{
    "talkId": "7115406",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 13,
        "夏洛蒂": 10
    },
    "dialogues": [
        {
            "id": "711540601",
            "speaker": "夏洛蒂",
            "text": "#哎，{NICKNAME}，这边这边。"
        },
        {
            "id": "711540602",
            "speaker": "夏洛蒂",
            "text": "我就说嘛…你肯定不会错过璃月的海灯节，还想着什么时候能遇见你呢。",
            "choices": [
                {
                    "id": "711540603",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711540605",
                            "speaker": "夏洛蒂",
                            "text": "我已经看到啦。我刚才为了留影，也放飞了好几盏霄灯呢。"
                        },
                        {
                            "id": "711540606",
                            "speaker": "夏洛蒂",
                            "text": "心愿？啊…啊？！我光顾着留影，忘记写心愿了！不对不对，放飞那么多盏，许愿会不会不灵啊——"
                        },
                        {
                            "id": "711540604",
                            "speaker": "Player",
                            "text": "夏洛蒂又来工作？"
                        },
                        {
                            "id": "711540607",
                            "speaker": "夏洛蒂",
                            "text": "不是不是，哪能年年都在海灯节的时候工作呀，这次我真的是来休假的。"
                        },
                        {
                            "id": "711540608",
                            "speaker": "Player",
                            "text": "那你是不是申请了纪念留影…"
                        },
                        {
                            "id": "711540609",
                            "speaker": "夏洛蒂",
                            "text": "对呀，萍溪小姐说会找一位专业的留影师，给我拍一张漂亮的留影画片…等等，不会正好…"
                        },
                        {
                            "id": "711540610",
                            "speaker": "Player",
                            "text": "专业留影师来报到了。"
                        },
                        {
                            "id": "711540611",
                            "speaker": "夏洛蒂",
                            "text": "真的是你啊？嘿嘿嘿，那正好，快给我拍一张画片吧，看我们俩谁拍的更好。"
                        },
                        {
                            "id": "711540612",
                            "speaker": "夏洛蒂",
                            "text": "#怎么样，{NICKNAME}，咱们现在就开始拍摄？",
                            "choices": [
                                {
                                    "id": "711540613",
                                    "text": "没问题，那就开始留影吧。",
                                    "response": [
                                        {
                                            "id": "711540614",
                                            "speaker": "夏洛蒂",
                                            "text": "#好嘞，对了…拍留影画片的时候，还要做点动作才好…{NICKNAME}，你给我一点建议？",
                                            "choices": [
                                                {
                                                    "id": "711540615",
                                                    "text": "严肃一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711540619",
                                                            "speaker": "Player",
                                                            "text": "就这个动作吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711540616",
                                                    "text": "放松一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711540621",
                                                            "speaker": "Player",
                                                            "text": "再试试第一个动作…",
                                                            "choices": [
                                                                {
                                                                    "id": "711540620",
                                                                    "text": "再试试第二个动作…"
                                                                },
                                                                {
                                                                    "id": "711540619",
                                                                    "text": "就这个动作吧。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711540617",
                                    "text": "稍等一会…",
                                    "response": [
                                        {
                                            "id": "711540618",
                                            "speaker": "夏洛蒂",
                                            "text": "要去处理其他的事？没问题，等你处理好了之后，咱们再来讨论纪念留影的事吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711540604",
                    "text": "夏洛蒂又来工作？"
                }
            ]
        }
    ]
}