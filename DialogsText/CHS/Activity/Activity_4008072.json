{
    "talkId": "4008072",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "温迪": 15
    },
    "dialogues": [
        {
            "id": "400807201",
            "speaker": "温迪",
            "text": "想不到你会来到这里呀，莫非…你是顺着风中的酒香，一路找过来的？",
            "choices": [
                {
                    "id": "400807202",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400807205",
                            "speaker": "温迪",
                            "text": "好呀，真想多听听你的声音。",
                            "choices": [
                                {
                                    "id": "400807206",
                                    "text": "关于祝福…",
                                    "response": [
                                        {
                                            "id": "400807207",
                                            "speaker": "温迪",
                                            "text": "祝福？哦，你说那个啊。"
                                        },
                                        {
                                            "id": "400807208",
                                            "speaker": "温迪",
                                            "text": "偷偷告诉你，还好大家举杯的时候没有把心愿说出口，否则我就要下不来台了，因为…啊哈哈，风神巴巴托斯的本事很有限嘛。"
                                        },
                                        {
                                            "id": "400807209",
                                            "speaker": "温迪",
                                            "text": "为了吹起来自遥远过去的风，我可是做了一个很长很长的深呼吸，差点缓不过这口气呢。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807210",
                                    "text": "关于雷泽…",
                                    "response": [
                                        {
                                            "id": "400807211",
                                            "speaker": "温迪",
                                            "text": "那个孩子成长得那么快，我也很欣慰。"
                                        },
                                        {
                                            "id": "400807212",
                                            "speaker": "温迪",
                                            "text": "嗯，用这种口气说话，一下子变得像极了老爷爷呢。"
                                        },
                                        {
                                            "id": "400807213",
                                            "speaker": "温迪",
                                            "text": "这次，还要多亏有你们这些好朋友一路支持着他。"
                                        },
                                        {
                                            "id": "400807214",
                                            "speaker": "温迪",
                                            "text": "善良、温柔，也不乏浪漫和自由…不愧是喝着果酒湖的水长大的蒙德人。"
                                        },
                                        {
                                            "id": "400807215",
                                            "speaker": "温迪",
                                            "text": "至于你嘛…放心，你是我见过最温柔的人了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807216",
                                    "text": "关于喝酒…",
                                    "response": [
                                        {
                                            "id": "400807217",
                                            "speaker": "温迪",
                                            "text": "嗯~趁着那么好的节日，我早就喝到喝不下了。"
                                        },
                                        {
                                            "id": "400807218",
                                            "speaker": "温迪",
                                            "text": "可没想到，「归风日」那天，大家又把压箱底的好酒翻出来。"
                                        },
                                        {
                                            "id": "400807219",
                                            "speaker": "温迪",
                                            "text": "唔，闻着都让人陶醉。只好再撑一撑，再撑一撑…"
                                        },
                                        {
                                            "id": "400807220",
                                            "speaker": "温迪",
                                            "text": "不瞒你说，最后，我还偷偷藏了两瓶哦？"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807203",
                    "text": "先不打扰你了。",
                    "response": [
                        {
                            "id": "400807204",
                            "speaker": "温迪",
                            "text": "去吧，我的朋友。这里发生的诗篇，风会一一记下。"
                        }
                    ]
                }
            ]
        }
    ]
}