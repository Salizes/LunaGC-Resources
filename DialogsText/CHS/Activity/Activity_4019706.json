{
    "talkId": "4019706",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "希格雯": 7,
        "朱斯蒂娜": 3,
        "派蒙": 3
    },
    "dialogues": [
        {
            "id": "401970601",
            "speaker": "希格雯",
            "text": "你们来啦~"
        },
        {
            "id": "401970602",
            "speaker": "希格雯",
            "text": "我准备好了两箱动物相关的书，到时候，不管动物们碰到什么健康问题，都能找到解决的办法！",
            "choices": [
                {
                    "id": "401970603",
                    "text": "好周全的准备！",
                    "response": [
                        {
                            "id": "401970605",
                            "speaker": "派蒙",
                            "text": "别说解决健康问题，这两箱书看完，我说不定都能和动物们聊天了…"
                        },
                        {
                            "id": "401970606",
                            "speaker": "朱斯蒂娜",
                            "text": "欸欸欸，护士长，您先别走！还好找到您了！"
                        },
                        {
                            "id": "401970607",
                            "speaker": "朱斯蒂娜",
                            "text": "有个犯人迷上了动画映影里的「神奇鼠鼠料理」，用攒了三天的饭做了一份仿制品…"
                        },
                        {
                            "id": "401970608",
                            "speaker": "朱斯蒂娜",
                            "text": "结果食物中毒，症状我们都没见过！还得麻烦您来治疗！"
                        },
                        {
                            "id": "401970609",
                            "speaker": "希格雯",
                            "text": "咦？不是和他们强调过吗？映影里的事物不能当真…"
                        },
                        {
                            "id": "401970610",
                            "speaker": "希格雯",
                            "text": "居然让你追到这里来了，看来事态确实非常严重！"
                        },
                        {
                            "id": "401970611",
                            "speaker": "希格雯",
                            "text": "实在不好意思…要麻烦你们先帮我带着行李回到欢乐城去了。"
                        },
                        {
                            "id": "401970612",
                            "speaker": "希格雯",
                            "text": "你们来之前，我设想了动物庄园里可能发生的情况，写了一些运营建议。"
                        },
                        {
                            "id": "401970613",
                            "speaker": "希格雯",
                            "text": "也可以提前把它交给「悠悠慢庄园」的员工，应该很快就能派上用场！",
                            "choices": [
                                {
                                    "id": "401970614",
                                    "text": "你先忙吧，我们等你！",
                                    "response": [
                                        {
                                            "id": "401970616",
                                            "speaker": "派蒙",
                                            "text": "护士长真不容易啊，不仅要照顾病人，还要给自己找麻烦的家伙善后…"
                                        },
                                        {
                                            "id": "401970617",
                                            "speaker": "派蒙",
                                            "text": "要不然，我们给希格雯准备一些好吃的？希望能帮她打起精神来！"
                                        }
                                    ]
                                },
                                {
                                    "id": "401970615",
                                    "text": "病人的健康重要！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401970604",
                    "text": "令人安心！"
                }
            ]
        }
    ]
}