{
    "talkId": "7114504",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "蒂蕾娜": 7
    },
    "dialogues": [
        {
            "id": "711450401",
            "speaker": "蒂蕾娜",
            "text": "推演快要结束啦，准领队，我听苏定参谋说，你那边的进展相当顺利？",
            "choices": [
                {
                    "id": "711450402",
                    "text": "我这边还不错，你的收获如何？",
                    "response": [
                        {
                            "id": "711450403",
                            "speaker": "蒂蕾娜",
                            "text": "嘿！我们的收获可真是不得了！"
                        },
                        {
                            "id": "711450404",
                            "speaker": "蒂蕾娜",
                            "text": "这次我们在推演中遇上了许多机动性极强的敌人，比如飞行的蕈兽。"
                        },
                        {
                            "id": "711450405",
                            "speaker": "蒂蕾娜",
                            "text": "它们相当克制铳枪这种攻击速度不快，只能对点打击的武器。"
                        },
                        {
                            "id": "711450406",
                            "speaker": "蒂蕾娜",
                            "text": "因此，我们好好锻炼了小队伍快速转移的战术，区别于以前的结阵射击，战斗方式变得更灵活了！"
                        },
                        {
                            "id": "711450407",
                            "speaker": "蒂蕾娜",
                            "text": "总之，好在这次推演为我们找到了作战方式上的短板，接下来的努力方向就有眉目了，我现在充满干劲！"
                        }
                    ]
                },
                {
                    "id": "711450408",
                    "text": "一切都好，下次再见！",
                    "response": [
                        {
                            "id": "711450409",
                            "speaker": "蒂蕾娜",
                            "text": "当然当然！随时欢迎您到特巡队的驻地来视察…如果您能找得到！"
                        }
                    ]
                }
            ]
        }
    ]
}