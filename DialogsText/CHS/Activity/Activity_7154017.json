{
    "talkId": "7154017",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "白术": 12,
        "长生": 2
    },
    "dialogues": [
        {
            "id": "715401701",
            "speaker": "白术",
            "text": "这些药物也配好了…等会就让阿桂送出去吧。",
            "choices": [
                {
                    "id": "715401702",
                    "text": "这一封祝柬送给你。",
                    "response": [
                        {
                            "id": "715401703",
                            "speaker": "白术",
                            "text": "多谢你的祝柬，费心了。这几天身体感觉如何？",
                            "choices": [
                                {
                                    "id": "715401704",
                                    "text": "多亏白术妙手回春。",
                                    "response": [
                                        {
                                            "id": "715401705",
                                            "speaker": "白术",
                                            "text": "我只是施了些普通医法，谈不上妙手回春。"
                                        },
                                        {
                                            "id": "715401708",
                                            "speaker": "白术",
                                            "text": "你身体本就强健，虽曾被死气缠身，却没有丝毫入侵心脉的征兆。"
                                        },
                                        {
                                            "id": "715401709",
                                            "speaker": "白术",
                                            "text": "就连那大阵之力，也没有对你造成真正的影响，真是奇事…咳，咳咳…！",
                                            "choices": [
                                                {
                                                    "id": "715401710",
                                                    "text": "没事吧？快喝点水。",
                                                    "response": [
                                                        {
                                                            "id": "715401712",
                                                            "speaker": "白术",
                                                            "text": "咳…咳咳…别担心，我只是为了写方子，熬了一夜而已。"
                                                        },
                                                        {
                                                            "id": "715401713",
                                                            "speaker": "长生",
                                                            "text": "哎呀，你这家伙也该休息几天了，至少让精神放松一下，不然也会影响到身体。"
                                                        },
                                                        {
                                                            "id": "715401714",
                                                            "speaker": "白术",
                                                            "text": "呵呵，不碍事，我心中有数。"
                                                        },
                                                        {
                                                            "id": "715401715",
                                                            "speaker": "白术",
                                                            "text": "倒是你，如果之后几天身体不适，就快些来找我，我好给你开些药调养。"
                                                        },
                                                        {
                                                            "id": "715401716",
                                                            "speaker": "白术",
                                                            "text": "病起微末，就算是丝毫征兆也不能掉以轻心，你可要千万记住。"
                                                        },
                                                        {
                                                            "id": "715401717",
                                                            "speaker": "长生",
                                                            "text": "你也关心一下自己吧，熬了这么一夜，不如也给自己开点药？"
                                                        },
                                                        {
                                                            "id": "715401718",
                                                            "speaker": "白术",
                                                            "text": "不碍事，我自己心里有数。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715401711",
                                                    "text": "你不会又用了秘术吧？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715401706",
                                    "text": "感觉没什么问题！",
                                    "response": [
                                        {
                                            "id": "715401707",
                                            "speaker": "白术",
                                            "text": "那就好。医治「死气」之法不见于寻常药典，我也只是施了些普通医法。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715401719",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715401720",
                            "speaker": "白术",
                            "text": "慢走。回去后好好休息，大事已了，又是佳节时期，放松些，别太劳累了。"
                        }
                    ]
                }
            ]
        }
    ]
}