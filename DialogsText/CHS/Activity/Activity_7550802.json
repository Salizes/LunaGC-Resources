{
    "talkId": "7550802",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "「律动魔匠」": 12
    },
    "dialogues": [
        {
            "id": "755080201",
            "speaker": "「律动魔匠」",
            "text": "嗯，撞球打击目标的音色富有张力，要是能配上稳定的节奏，就是完美的加花！",
            "choices": [
                {
                    "id": "755080202",
                    "text": "来一局「节拍撞球」！",
                    "response": [
                        {
                            "id": "755080203",
                            "speaker": "「律动魔匠」",
                            "text": "好，期待你的发挥，祝你打出漂亮的段落！"
                        }
                    ]
                },
                {
                    "id": "755080204",
                    "text": "你是…",
                    "response": [
                        {
                            "id": "755080205",
                            "speaker": "「律动魔匠」",
                            "text": "你好你好，欢迎来玩这个游戏！"
                        },
                        {
                            "id": "755080206",
                            "speaker": "「律动魔匠」",
                            "text": "我是希诺宁大师雇来的一般乐师，负责管理这座「热舞乐台」。"
                        },
                        {
                            "id": "755080207",
                            "speaker": "Player",
                            "text": "大师？"
                        },
                        {
                            "id": "755080208",
                            "speaker": "「律动魔匠」",
                            "text": "没错！无论从设计、打造和维护设备的技术，还是控碟的本领，希诺宁都是我们这些乐师敬仰的绝对高手！"
                        },
                        {
                            "id": "755080209",
                            "speaker": "「律动魔匠」",
                            "text": "她控碟时，从不局限于特定的风格和技法，什么风格的唱片都能驾驭…"
                        },
                        {
                            "id": "755080210",
                            "speaker": "「律动魔匠」",
                            "text": "而且，她的「听感」非常准狠！"
                        },
                        {
                            "id": "755080211",
                            "speaker": "「律动魔匠」",
                            "text": "哪个段落的音色过于干哑，音高偏差超过半度，音质效果拧过了头，她就算用青蜜莓堵住耳朵，都能听个八九不离十…"
                        },
                        {
                            "id": "755080212",
                            "speaker": "Player",
                            "text": "为什么是青蜜莓…"
                        },
                        {
                            "id": "755080213",
                            "speaker": "「律动魔匠」",
                            "text": "这就有门道了！青蜜莓饱含汁液，隔着它听东西，就像身处水下，对于音乐人来说，是最艰难的考验！"
                        },
                        {
                            "id": "755080214",
                            "speaker": "「律动魔匠」",
                            "text": "虽然希诺宁大师从没提过这茬，但我觉得，准确听音的本事对战士和冒险家而言，也能起到至关重要的作用。"
                        },
                        {
                            "id": "755080215",
                            "speaker": "「律动魔匠」",
                            "text": "推荐你向希诺宁大师学习听音技巧哦！"
                        }
                    ]
                },
                {
                    "id": "755080216",
                    "text": "下次再来看看…",
                    "response": [
                        {
                            "id": "755080217",
                            "speaker": "「律动魔匠」",
                            "text": "有空常来！要是之后遇上了我们控碟乐师的演出，也请多多捧场！"
                        }
                    ]
                }
            ]
        }
    ]
}