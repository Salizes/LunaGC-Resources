    },
    "dialogues": [
        {
            "id": "711530802",
            "speaker": "希格雯",
            "text": "已经拍摄好了？请给我看看吧…噗，我的表情看起来很不错呢。"
        },
        {
            "id": "711530803",
            "speaker": "希格雯",
            "text": "真是一张好画片，我会把它好好珍藏起来的。",
            "choices": [
                {
                    "id": "711530801",
                    "text": "关于我刚放的霄灯…",
                    "response": [
                        {
                            "id": "711530804",
                            "speaker": "希格雯",
                            "text": "嗯，你的霄灯很好看喔。之前我在梅洛彼得堡里治疗过的病人也提到过，自己想要放飞霄灯。"
                        },
                        {
                            "id": "711530805",
                            "speaker": "希格雯",
                            "text": "正好趁此机会，帮他放飞一下愿望吧。"
                        }
                    ]
                },
                {
                    "id": "711530806",
                    "text": "再见，海灯节快乐。",
                    "response": [
                        {
                            "id": "711530807",
                            "speaker": "希格雯",
                            "text": "再见啦，祝你度过一段快乐的时光。"
                        }
                    ]
                }
            ]
        }
    ]
}