{
    "talkId": "7350807",
    "total_dialogue_lines": 58,
    "speaker_counts": {
        "Player": 17,
        "咚咚小圆帽": 2,
        "派蒙": 33,
        "火一": 2,
        "百雷遮罗": 2,
        "转转悠悠兽": 2
    },
    "dialogues": [
        {
            "id": "735080701",
            "speaker": "派蒙",
            "text": "「咚咚小圆帽」、「欢腾之火」、「转转悠悠兽」和「百雷遮罗」，你们聚在一起啦！",
            "choices": [
                {
                    "id": "735080702",
                    "text": "全员到齐啦！",
                    "response": [
                        {
                            "id": "735080703",
                            "speaker": "派蒙",
                            "text": "你们要好好听海妮耶的话哦，乖乖吃饭，好好睡觉，多多锻炼，快快乐乐地生活！"
                        },
                        {
                            "id": "735080704",
                            "speaker": "咚咚小圆帽",
                            "text": "♪~"
                        },
                        {
                            "id": "735080705",
                            "speaker": "火一",
                            "text": "♫~"
                        },
                        {
                            "id": "735080706",
                            "speaker": "转转悠悠兽",
                            "text": "♩~"
                        },
                        {
                            "id": "735080707",
                            "speaker": "百雷遮罗",
                            "text": "♬~"
                        },
                        {
                            "id": "735080708",
                            "speaker": "派蒙",
                            "text": "好乖好乖，下次给你们带一大堆礼物！",
                            "choices": [
                                {
                                    "id": "735080709",
                                    "text": "派蒙已经是蕈兽语的顶尖大师了！",
                                    "response": [
                                        {
                                            "id": "735080711",
                                            "speaker": "派蒙",
                                            "text": "嘿嘿，其实我也不知道蕈兽伙伴们在说什么啦，反正，看得出来它们很开心，很听我的话！"
                                        },
                                        {
                                            "id": "735080712",
                                            "speaker": "派蒙",
                                            "text": "我已经想好下次要给蕈兽伙伴们带些什么了——"
                                        },
                                        {
                                            "id": "735080713",
                                            "speaker": "派蒙",
                                            "text": "我要给「咚咚小圆帽」买一顶真正的小圆帽，又好看，又能保护它软软的脑袋。"
                                        },
                                        {
                                            "id": "735080714",
                                            "speaker": "派蒙",
                                            "text": "平时戴在头上，不戴的时候就由我来帮它好好保管。"
                                        },
                                        {
                                            "id": "735080715",
                                            "speaker": "派蒙",
                                            "text": "这样一来，「咚咚小圆帽」就永远不会「帽帽失失」了，以后就最最最可靠！"
                                        },
                                        {
                                            "id": "735080716",
                                            "speaker": "咚咚小圆帽",
                                            "text": "♪~",
                                            "choices": [
                                                {
                                                    "id": "735080717",
                                                    "text": "可「咚咚小圆帽」是水元素蕈兽。",
                                                    "response": [
                                                        {
                                                            "id": "735080719",
                                                            "speaker": "派蒙",
                                                            "text": "那，那就找人定做一款防水的帽子嘛，比如，用月莲的叶子，水珠只会从上面滑过去！"
                                                        },
                                                        {
                                                            "id": "735080720",
                                                            "speaker": "派蒙",
                                                            "text": "贵一点也不要紧…就从我的零食钱里扣掉！"
                                                        },
                                                        {
                                                            "id": "735080721",
                                                            "speaker": "派蒙",
                                                            "text": "我接着说哦，给「转转悠悠兽」的礼物是一个挎包，可以装它自己的「妙妙琼脂」，饿了就随时可以吃饭。"
                                                        },
                                                        {
                                                            "id": "735080722",
                                                            "speaker": "派蒙",
                                                            "text": "「转转悠悠兽」轻飘飘的，会用风的力量，力气很大，帮其他伙伴带东西也是小菜一碟。"
                                                        },
                                                        {
                                                            "id": "735080723",
                                                            "speaker": "派蒙",
                                                            "text": "毕竟以前连行李都能拖动。"
                                                        },
                                                        {
                                                            "id": "735080724",
                                                            "speaker": "Player",
                                                            "text": "「转转悠悠兽」好强！"
                                                        },
                                                        {
                                                            "id": "735080725",
                                                            "speaker": "转转悠悠兽",
                                                            "text": "♩~"
                                                        },
                                                        {
                                                            "id": "735080726",
                                                            "speaker": "派蒙",
                                                            "text": "嗯！看来「转转悠悠兽」也很满意！"
                                                        },
                                                        {
                                                            "id": "735080727",
                                                            "speaker": "派蒙",
                                                            "text": "接下来是「欢腾之火」，我要挑选一个很舒服的眼罩，戴上去以后，怎么晃都掉不下来…"
                                                        },
                                                        {
                                                            "id": "735080728",
                                                            "speaker": "派蒙",
                                                            "text": "对哦，那我还要找个机会，让海妮耶测一测「欢腾之火」的菇体尺寸。",
                                                            "choices": [
                                                                {
                                                                    "id": "735080729",
                                                                    "text": "什么原因？",
                                                                    "response": [
                                                                        {
                                                                            "id": "735080731",
                                                                            "speaker": "派蒙",
                                                                            "text": "「欢腾之火」是火蕈兽嘛！你想想，火元素的光肯定非常~亮！"
                                                                        },
                                                                        {
                                                                            "id": "735080732",
                                                                            "speaker": "派蒙",
                                                                            "text": "所以「欢腾之火」睡觉的时候，有可能被自己发出的光给照到，然后就突然醒了，这不是很难受吗！",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "735080733",
                                                                                    "text": "「欢腾之火」又没有黑眼圈。",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "735080735",
                                                                                            "speaker": "派蒙",
                                                                                            "text": "那不如直接问问当事菇？"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080736",
                                                                                            "speaker": "派蒙",
                                                                                            "text": "「欢腾之火」，你平常睡得还好吗？"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080737",
                                                                                            "speaker": "火一",
                                                                                            "text": "♫~"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080738",
                                                                                            "speaker": "派蒙",
                                                                                            "text": "答案好像是…「很不错」？说明「欢腾之火」没有这个烦恼欸…"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080739",
                                                                                            "speaker": "派蒙",
                                                                                            "text": "还是再想一想吧，我一定会有好点子的，总之，要让「欢腾之火」满意才行！"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080740",
                                                                                            "speaker": "派蒙",
                                                                                            "text": "再说说「百雷遮罗」的礼物，就决定是一块会留下雷元素痕迹的大画板了。"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080741",
                                                                                            "speaker": "派蒙",
                                                                                            "text": "「百雷遮罗」很活泼，动作很敏捷，在这块画板上作画，肯定特别快乐！"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080742",
                                                                                            "speaker": "派蒙",
                                                                                            "text": "玩的时候还能锻炼身体，一举两得，挺不错吧！"
                                                                                        },
                                                                                        {
                                                                                            "id": "735080743",
                                                                                            "speaker": "百雷遮罗",
                                                                                            "text": "♬~",
                                                                                            "choices": [
                                                                                                {
                                                                                                    "id": "735080744",
                                                                                                    "text": "还要有擦除画面的功能。",
                                                                                                    "response": [
                                                                                                        {
                                                                                                            "id": "735080746",
                                                                                                            "speaker": "派蒙",
                                                                                                            "text": "有道理！去找工匠下订单之前，我们先想想怎么实现这个功能吧。"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "735080747",
                                                                                                            "speaker": "派蒙",
                                                                                                            "text": "还要考虑一下，哪位工匠的手艺满足我们的要求…",
                                                                                                            "choices": [
                                                                                                                {
                                                                                                                    "id": "735080748",
                                                                                                                    "text": "但是你把礼物内容说出来了哦？",
                                                                                                                    "response": [
                                                                                                                        {
                                                                                                                            "id": "735080750",
                                                                                                                            "speaker": "派蒙",
                                                                                                                            "text": "有什么关系！我用的量词是「一大堆」哦，肯定不止这几样嘛。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "735080751",
                                                                                                                            "speaker": "派蒙",
                                                                                                                            "text": "我们之后还可以再好好想想，慢慢挑挑，不设数量上限。"
                                                                                                                        },
                                                                                                                        {
                                                                                                                            "id": "735080752",
                                                                                                                            "speaker": "派蒙",
                                                                                                                            "text": "目标是让蕈兽伙伴们在礼物堆里玩到尽兴！",
                                                                                                                            "choices": [
                                                                                                                                {
                                                                                                                                    "id": "735080753",
                                                                                                                                    "text": "礼物堆！",
                                                                                                                                    "response": [
                                                                                                                                        {
                                                                                                                                            "id": "735080755",
                                                                                                                                            "speaker": "派蒙",
                                                                                                                                            "text": "好，那我们也该出发了，抓紧时间多做委托，攒下买礼物的摩拉！"
                                                                                                                                        },
                                                                                                                                        {
                                                                                                                                            "id": "735080756",
                                                                                                                                            "speaker": "派蒙",
                                                                                                                                            "text": "「咚咚小圆帽」、「欢腾之火」、「转转悠悠兽」和「百雷遮罗」，用不了太久就会再见的，等着我们哦~"
                                                                                                                                        }
                                                                                                                                    ]
                                                                                                                                },
                                                                                                                                {
                                                                                                                                    "id": "735080754",
                                                                                                                                    "text": "玩到尽兴！"
                                                                                                                                }
                                                                                                                            ]
                                                                                                                        }
                                                                                                                    ]
                                                                                                                },
                                                                                                                {
                                                                                                                    "id": "735080749",
                                                                                                                    "text": "这下就没有惊喜了哦？"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                },
                                                                                                {
                                                                                                    "id": "735080745",
                                                                                                    "text": "防止画板变得一团糟。"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "735080734",
                                                                                    "text": "呜呜，好像海妮耶更需要眼罩。"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "735080730",
                                                                    "text": "我不理解。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "735080718",
                                                    "text": "还是会「帽帽湿湿」。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "735080710",
                                    "text": "教我教我！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735080757",
                    "text": "待会儿再回来看蕈兽伙伴们吧。",
                    "response": [
                        {
                            "id": "735080758",
                            "speaker": "派蒙",
                            "text": "海妮耶和左右加小姐好像要走了呢…那我们要抓紧时间哦，记得再回来看看大家！"
                        }
                    ]
                }
            ]
        }
    ]
}