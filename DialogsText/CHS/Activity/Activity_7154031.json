{
    "talkId": "7154031",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "提纳里": 10
    },
    "dialogues": [
        {
            "id": "715403101",
            "speaker": "提纳里",
            "text": "买些什么好呢…",
            "choices": [
                {
                    "id": "715403102",
                    "text": "这份祝柬送给你。",
                    "response": [
                        {
                            "id": "715403103",
                            "speaker": "提纳里",
                            "text": "#{NICKNAME}，没想到会在这里遇见你。谢谢你的祝柬，很漂亮。"
                        },
                        {
                            "id": "715403104",
                            "speaker": "Player",
                            "text": "海灯节玩得开心吗？"
                        },
                        {
                            "id": "715403105",
                            "speaker": "提纳里",
                            "text": "我和赛诺都玩得很开心，尝了不少好吃的，还买了不少礼物。"
                        },
                        {
                            "id": "715403106",
                            "speaker": "提纳里",
                            "text": "但是…这海灯节的璃月，人的确是太多了，在街上待太久，我的耳朵都有些疼。"
                        },
                        {
                            "id": "715403107",
                            "speaker": "提纳里",
                            "text": "所以，我就来这边稍微休息一下。"
                        },
                        {
                            "id": "715403108",
                            "speaker": "提纳里",
                            "text": "至于赛诺…他说自己要考虑一些事情，想去一个人呆一会。",
                            "choices": [
                                {
                                    "id": "715403109",
                                    "text": "难道又有什么案子…",
                                    "response": [
                                        {
                                            "id": "715403111",
                                            "speaker": "提纳里",
                                            "text": "我想…应该不是…"
                                        },
                                        {
                                            "id": "715403112",
                                            "speaker": "提纳里",
                                            "text": "他一直念叨着「祝柬」，只怕又是在想着什么新笑话。"
                                        },
                                        {
                                            "id": "715403113",
                                            "speaker": "提纳里",
                                            "text": "不过…「祝柬」能想出什么冷笑话？"
                                        }
                                    ]
                                },
                                {
                                    "id": "715403110",
                                    "text": "不会是什么工作上的事…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715403114",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715403115",
                            "speaker": "提纳里",
                            "text": "嗯，我等会也要去找赛诺了。唉…希望他今天的灵感，不是那么充沛…"
                        }
                    ]
                }
            ]
        }
    ]
}