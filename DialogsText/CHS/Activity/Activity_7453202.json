{
    "talkId": "7453202",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "小露米埃尔": 6
    },
    "dialogues": [
        {
            "id": "745320201",
            "speaker": "小露米埃尔",
            "text": "怎么样，准备好拍摄「速览映影」了吗？",
            "choices": [
                {
                    "id": "745320202",
                    "text": "开始吧！",
                    "response": [
                        {
                            "id": "745320203",
                            "speaker": "小露米埃尔",
                            "text": "好的，各个机位均已就绪，演员也已经准备好了，你们只需要自由发挥就好。"
                        }
                    ]
                },
                {
                    "id": "745320204",
                    "text": "关于日后的打算…",
                    "response": [
                        {
                            "id": "745320205",
                            "speaker": "小露米埃尔",
                            "text": "我计划继续拉拢更多可靠的合作方，比如我的兄长、乐平波琳女士或泽维尔先生。"
                        },
                        {
                            "id": "745320206",
                            "speaker": "小露米埃尔",
                            "text": "毕竟，「速览映影」潜力巨大，但其风险也难以忽视，仅靠我和梅里爱女士的力量，难以完全实现我们的目标。"
                        },
                        {
                            "id": "745320207",
                            "speaker": "小露米埃尔",
                            "text": "当然，在我进行下一步之前，我得先稳住梅里爱女士，别让她一口气把我们好不容易弄来的预算花光了…"
                        }
                    ]
                },
                {
                    "id": "745320208",
                    "text": "还需要等等。",
                    "response": [
                        {
                            "id": "745320209",
                            "speaker": "小露米埃尔",
                            "text": "嗯嗯，不用着急。目前我们已经找到了「速览映影」的方向，只需要稳步推进就好了。"
                        }
                    ]
                }
            ]
        }
    ]
}