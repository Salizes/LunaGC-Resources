{
    "talkId": "7055603",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 7,
        "埃利什卡": 14,
        "敦克哈斯": 14
    },
    "dialogues": [
        {
            "id": "705560301",
            "speaker": "敦克哈斯",
            "text": "法尔伽那家伙…又有长进啊…"
        },
        {
            "id": "705560302",
            "speaker": "埃利什卡",
            "text": "嗝儿…我不行了，下次再也不和他拼了…",
            "choices": [
                {
                    "id": "705560303",
                    "text": "你们还好吗？",
                    "response": [
                        {
                            "id": "705560304",
                            "speaker": "敦克哈斯",
                            "text": "没事没事，后生啊，要以我们为戒，不要和大团长较劲，喝不过的呀，喝不过的呀！"
                        },
                        {
                            "id": "705560305",
                            "speaker": "埃利什卡",
                            "text": "等等，后什么生，这荣誉骑士啊，你这家伙放尊重点！"
                        },
                        {
                            "id": "705560306",
                            "speaker": "敦克哈斯",
                            "text": "噢噢噢噢噢！对不住了，一时眼花没看出是你，荣誉骑士！"
                        },
                        {
                            "id": "705560307",
                            "speaker": "敦克哈斯",
                            "text": "…也说明你显年轻，有着少年少女般的朝气，还有…亲和力。",
                            "choices": [
                                {
                                    "id": "705560308",
                                    "text": "（他们很特别…要不客气点？）",
                                    "response": [
                                        {
                                            "id": "705560309",
                                            "speaker": "Player",
                                            "text": "两位是刚回蒙德城吗？"
                                        },
                                        {
                                            "id": "705560310",
                                            "speaker": "埃利什卡",
                                            "text": "没错，刚调回来…到小古恩希尔德那里干活没多久。"
                                        },
                                        {
                                            "id": "705560311",
                                            "speaker": "埃利什卡",
                                            "text": "好不容易等来一个假期，给法尔伽汇报汇报情况！"
                                        },
                                        {
                                            "id": "705560312",
                                            "speaker": "敦克哈斯",
                                            "text": "本来想随便灌他两杯意思意思的，结果被反将一军，今晚也不好意思跟小古恩希尔德请假了…"
                                        },
                                        {
                                            "id": "705560313",
                                            "speaker": "敦克哈斯",
                                            "text": "这么一说，丢人，我们有罪！"
                                        },
                                        {
                                            "id": "705560320",
                                            "speaker": "埃利什卡",
                                            "text": "作为赔罪，明天就帮小古恩希尔德把所有训练事务的报表都处理掉好了，让她少干三分之一的活。"
                                        },
                                        {
                                            "id": "705560321",
                                            "speaker": "Player",
                                            "text": "小…小古恩希尔德？"
                                        },
                                        {
                                            "id": "705560322",
                                            "speaker": "埃利什卡",
                                            "text": "哦，就是令人安心的代理团长琴·古恩希尔德，我们芙蕾德莉卡大姐的好女儿！"
                                        },
                                        {
                                            "id": "705560323",
                                            "speaker": "埃利什卡",
                                            "text": "仔细想想还挺唏嘘的…"
                                        },
                                        {
                                            "id": "705560324",
                                            "speaker": "埃利什卡",
                                            "text": "她还没这张桌子高的时候，就总是拿着满分的考卷，在骑士团门口等芙蕾德莉卡下班了…"
                                        },
                                        {
                                            "id": "705560325",
                                            "speaker": "敦克哈斯",
                                            "text": "有一次，芙蕾德莉卡甚至觉得，在书面成绩上已经没有再严格下去的必要了…怎么说的来着？"
                                        },
                                        {
                                            "id": "705560326",
                                            "speaker": "敦克哈斯",
                                            "text": "「偶尔也可以犯点错，别考这么高的分数…」"
                                        },
                                        {
                                            "id": "705560327",
                                            "speaker": "埃利什卡",
                                            "text": "「不然，邻居们就要拿你当榜样，给你的朋友压力了。在朋友们心中维持正面的形象，也是骑士需要注意的事项。」"
                                        },
                                        {
                                            "id": "705560328",
                                            "speaker": "敦克哈斯",
                                            "text": "然后下一次，小小琴就每科故意写错一题，只错一题…这不还是没人考得过嘛，哈哈哈哈哈！"
                                        },
                                        {
                                            "id": "705560329",
                                            "speaker": "埃利什卡",
                                            "text": "好快啊，好快啊，一晃就这么久过去了！"
                                        },
                                        {
                                            "id": "705560330",
                                            "speaker": "敦克哈斯",
                                            "text": "对啊…再尽力帮她处理两年杂务，让她养成适当节省心力的习惯…"
                                        },
                                        {
                                            "id": "705560331",
                                            "speaker": "敦克哈斯",
                                            "text": "我们两把老骨头，差不多也该退役了，啊哈哈…"
                                        },
                                        {
                                            "id": "705560332",
                                            "speaker": "埃利什卡",
                                            "text": "希望我们以后带出的徒弟，勉强能有小古恩希尔德一半的干劲和责任感！"
                                        }
                                    ]
                                },
                                {
                                    "id": "705560314",
                                    "text": "（是两个酒鬼骑士…训他们？）",
                                    "response": [
                                        {
                                            "id": "705560315",
                                            "speaker": "Player",
                                            "text": "这个点就醉酒！不像话！"
                                        },
                                        {
                                            "id": "705560316",
                                            "speaker": "埃利什卡",
                                            "text": "这个点…这个点不是还早吗？还有时间喝第二场，然后醒醒酒呢。"
                                        },
                                        {
                                            "id": "705560317",
                                            "speaker": "埃利什卡",
                                            "text": "我们刚给法尔伽汇报了调回来的工作情况…没多久呢！"
                                        },
                                        {
                                            "id": "705560318",
                                            "speaker": "敦克哈斯",
                                            "text": "但仔细一想，现在这会儿，小古恩希尔德八成还没下班。"
                                        },
                                        {
                                            "id": "705560319",
                                            "speaker": "敦克哈斯",
                                            "text": "不妙，有点愧疚…我们有罪！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705560333",
                    "text": "（还是不打扰他们了…）",
                    "response": [
                        {
                            "id": "705560334",
                            "speaker": "埃利什卡",
                            "text": "嗝儿…记得明天，要多帮小古恩希尔德干点活儿…"
                        },
                        {
                            "id": "705560335",
                            "speaker": "敦克哈斯",
                            "text": "记着呢…"
                        }
                    ]
                }
            ]
        }
    ]
}