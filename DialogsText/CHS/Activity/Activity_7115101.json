{
    "talkId": "7115101",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 8,
        "莱欧斯利": 7
    },
    "dialogues": [
        {
            "id": "711510101",
            "speaker": "莱欧斯利",
            "text": "#{NICKNAME}，我倒是想到了会遇见你，啊…先容我按照璃月习俗向你致意，海灯节快乐。",
            "choices": [
                {
                    "id": "711510102",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711510104",
                            "speaker": "莱欧斯利",
                            "text": "不错啊，你放的这盏灯又高又亮，弄得我都想买几盏带回梅洛彼得堡了。"
                        },
                        {
                            "id": "711510111",
                            "speaker": "莱欧斯利",
                            "text": "还是算了，在梅洛彼得堡里放的霄灯，既飞不上天，也实现不了什么心愿，只会白白增加清洁成本。"
                        },
                        {
                            "id": "711510103",
                            "speaker": "Player",
                            "text": "关于纪念留影…"
                        },
                        {
                            "id": "711510112",
                            "speaker": "莱欧斯利",
                            "text": "没错，是我向萍溪小姐申请的，看来她真的为我准备了一位专业留影师。"
                        },
                        {
                            "id": "711510113",
                            "speaker": "莱欧斯利",
                            "text": "那咱们就开始吧，为我拍一张好画片，等我回了枫丹，还打算把它放在办公室里呢。",
                            "choices": [
                                {
                                    "id": "711510105",
                                    "text": "那就开始留影吧。",
                                    "response": [
                                        {
                                            "id": "711510106",
                                            "speaker": "莱欧斯利",
                                            "text": "#行，我得做个动作？还是怎么样，{NICKNAME}，不然你来给点建议吧。",
                                            "choices": [
                                                {
                                                    "id": "711510109",
                                                    "text": "严肃一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711510114",
                                                            "speaker": "Player",
                                                            "text": "就这个动作吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711510110",
                                                    "text": "放松一点的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711510107",
                                    "text": "请稍等一会…",
                                    "response": [
                                        {
                                            "id": "711510108",
                                            "speaker": "莱欧斯利",
                                            "text": "要去处理其他的事？行啊，我也不急这一会。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711510103",
                    "text": "关于纪念留影…"
                }
            ]
        }
    ]
}