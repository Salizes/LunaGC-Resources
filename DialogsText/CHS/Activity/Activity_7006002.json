    "dialogues": [
        {
            "id": "700600201",
            "speaker": "凯亚",
            "text": "哟，荣誉骑士，有阵子不见，你也来度假村了。在忙什么呢？",
            "choices": [
                {
                    "id": "700600202",
                    "text": "在给度假村留影。",
                    "response": [
                        {
                            "id": "700600204",
                            "speaker": "凯亚",
                            "text": "哦，留影吗？的确是度假必备的环节。"
                        },
                        {
                            "id": "700600205",
                            "speaker": "凯亚",
                            "text": "不过我好像没看见留影机，你确定带在身上了吗？没有它就没办法拍画片了吧。"
                        }
                    ]
                },
                {
                    "id": "700600203",
                    "text": "边放松边留影。"
                }
            ]
        }
    ]
}