{
    "talkId": "7054604",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "派蒙": 1,
        "艾玛托": 6
    },
    "dialogues": [
        {
            "id": "705460401",
            "speaker": "艾玛托",
            "text": "追随火花！爆炸不止！荣誉骑士大人和白色小帮手，「嘟嘟可砰砰历险记」玩得还开心吗？有什么疑问，艾玛托随时为您解答！",
            "choices": [
                {
                    "id": "705460404",
                    "text": "聊聊这次嘟嘟可的冒险故事？",
                    "response": [
                        {
                            "id": "705460405",
                            "speaker": "艾玛托",
                            "text": "好呀！丽莎小姐把续作交给我时，提供了很多故事情节…"
                        },
                        {
                            "id": "705460406",
                            "speaker": "艾玛托",
                            "text": "「很坏很坏的角角鱼大王，在被嘟嘟可赶跑后，灰溜溜地回到了老巢…」"
                        },
                        {
                            "id": "705460407",
                            "speaker": "艾玛托",
                            "text": "「角角鱼先锋说：大王！我们何不把角角鱼长老、角角鱼卫士、角角鱼清道夫，都纠集到一起，再次反攻呢？」"
                        },
                        {
                            "id": "705460408",
                            "speaker": "艾玛托",
                            "text": "不过，后面的故事，还是荣誉骑士自己体验比较好！不然，就没有惊喜感了！"
                        },
                        {
                            "id": "705460409",
                            "speaker": "Player",
                            "text": "紧张起来了，加油啊！嘟嘟可！"
                        },
                        {
                            "id": "705460410",
                            "speaker": "派蒙",
                            "text": "加油啊！嘟嘟可！"
                        }
                    ]
                },
                {
                    "id": "705460411",
                    "text": "休息一会儿，下次再来！",
                    "response": [
                        {
                            "id": "705460412",
                            "speaker": "艾玛托",
                            "text": "没问题！艾玛托一直在这里，等待荣誉骑士的命令！"
                        }
                    ]
                }
            ]
        }
    ]
}