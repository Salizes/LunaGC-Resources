{
    "talkId": "4012621",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "纪芳": 8,
        "胡桃": 8
    },
    "dialogues": [
        {
            "id": "401262101",
            "speaker": "纪芳",
            "text": "…你不是要出书吗？"
        },
        {
            "id": "401262102",
            "speaker": "胡桃",
            "text": "对呀。"
        },
        {
            "id": "401262103",
            "speaker": "纪芳",
            "text": "…书呢？"
        },
        {
            "id": "401262104",
            "speaker": "胡桃",
            "text": "等诗来就有了。"
        },
        {
            "id": "401262105",
            "speaker": "纪芳",
            "text": "…诗呢？"
        },
        {
            "id": "401262106",
            "speaker": "胡桃",
            "text": "诗在路上了。"
        },
        {
            "id": "401262107",
            "speaker": "纪芳",
            "text": "…不是，胡堂主，你这诗还没来，我怎么跟你聊生意？"
        },
        {
            "id": "401262108",
            "speaker": "胡桃",
            "text": "我这不是先来和老板你谈谈妥嘛。"
        },
        {
            "id": "401262109",
            "speaker": "纪芳",
            "text": "我总要看看内容再决定卖不卖，怎么卖吧？"
        },
        {
            "id": "401262110",
            "speaker": "胡桃",
            "text": "哎呀呀，光是堂主我刚才给你看的几句，就足以撑起这本书的销量了吧！"
        },
        {
            "id": "401262111",
            "speaker": "纪芳",
            "text": "…就凭「林猪二十斤」？"
        },
        {
            "id": "401262112",
            "speaker": "胡桃",
            "text": "还有「地下开饭」那个呀！见多识广的钟离客卿可都说是好诗对！这不做个什么宣传宣传？"
        },
        {
            "id": "401262113",
            "speaker": "纪芳",
            "text": "…堂主，我们这都是小本生意。要是成本进去了但没人买，亏的是我的钱。"
        },
        {
            "id": "401262114",
            "speaker": "胡桃",
            "text": "放心放心，我和你担保，这诗集印出来，绝对惊天地泣鬼神！"
        },
        {
            "id": "401262115",
            "speaker": "胡桃",
            "text": "这不，我来的路上就听见了些鬼魂的哭声呢！你不信的话，我叫来给你听听？"
        },
        {
            "id": "401262116",
            "speaker": "纪芳",
            "text": "…这就免了。"
        }
    ]
}