    "speaker_counts": {
        "Player": 3,
        "「邦邦滚石」": 10
    },
    "dialogues": [
        {
            "id": "706940201",
            "speaker": "「邦邦滚石」",
            "text": "#状态怎么样，{NICKNAME}老板，要不要来露两手？",
            "choices": [
                {
                    "id": "706940202",
                    "text": "开始「斗魂试炼」吧！",
                    "response": [
                        {
                            "id": "706940203",
                            "speaker": "「邦邦滚石」",
                            "text": "这气势太强了，我得好好观战！"
                        }
                    ]
                },
                {
                    "id": "706940204",
                    "text": "朋友，你本来是做什么工作的？",
                    "response": [
                        {
                            "id": "706940205",
                            "speaker": "「邦邦滚石」",
                            "text": "我啊？给你打工的！"
                        },
                        {
                            "id": "706940206",
                            "speaker": "「邦邦滚石」",
                            "text": "哈哈，先别意外，我平常干最多的活儿，是帮瓦雷莎的店打杂。外出做生意的时候搬搬货，不出远门的时候管管仓库。"
                        },
                        {
                            "id": "706940207",
                            "speaker": "「邦邦滚石」",
                            "text": "不过瓦雷莎说过，如果大英雄有需要，在关键的时刻，整个水果店和果园都支援给你！"
                        },
                        {
                            "id": "706940208",
                            "speaker": "「邦邦滚石」",
                            "text": "所以理论上，我也是你的后备员工。"
                        },
                        {
                            "id": "706940209",
                            "speaker": "「邦邦滚石」",
                            "text": "之前去枫丹做生意的时候，我也确实给你投过简历，不知道你还有没有印象。"
                        },
                        {
                            "id": "706940210",
                            "speaker": "「邦邦滚石」",
                            "text": "有印象的话，是我最大的荣幸。"
                        },
                        {
                            "id": "706940211",
                            "speaker": "「邦邦滚石」",
                            "text": "没印象的话，下次来「沃陆之邦」的时候，容我请您尝尝云岩裂叶风味的颗粒果汁，说不定就记住我了！"
                        }
                    ]
                },
                {
                    "id": "706940212",
                    "text": "先去处理些点别的事。",
                    "response": [
                        {
                            "id": "706940213",
                            "speaker": "「邦邦滚石」",
                            "text": "理解理解，那您先忙！"
                        }
                    ]
                }
            ]
        }
    ]
}