{
    "talkId": "4020926",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 5,
        "北斗": 15,
        "派蒙": 8
    },
    "dialogues": [
        {
            "id": "402092601",
            "speaker": "北斗",
            "text": "呼…多亏你们，一切麻烦都搞定了！这次挪德卡莱之行，就算有些小小插曲，也让我身心舒畅！"
        },
        {
            "id": "402092602",
            "speaker": "北斗",
            "text": "怎么样，见识了改进型归终机的对空拦截作战后，有没有感觉热血上涌，再来一次对地战斗如何？",
            "choices": [
                {
                    "id": "402092603",
                    "text": "那就来战吧！",
                    "response": [
                        {
                            "id": "402092604",
                            "speaker": "派蒙",
                            "text": "呜喔！引导归终机打败坏家伙，这种好戏再来七八次也不嫌多！"
                        },
                        {
                            "id": "402092605",
                            "speaker": "北斗",
                            "text": "气势更强了！相信现在的你们，对归终机的火力肯定有了全新的理解，放手去打吧！"
                        }
                    ]
                },
                {
                    "id": "402092606",
                    "text": "关于二号舰…",
                    "response": [
                        {
                            "id": "402092607",
                            "speaker": "派蒙",
                            "text": "唔，之前北斗好像提到过，「死兆星」即的二号舰还没有命名？"
                        },
                        {
                            "id": "402092608",
                            "speaker": "北斗",
                            "text": "这个呀，我已经有一些想法了…"
                        },
                        {
                            "id": "402092609",
                            "speaker": "北斗",
                            "text": "如果说以后，「死兆星」的出现，宣告着宵小之辈与魔物们的恶业即将走到尽头…"
                        },
                        {
                            "id": "402092610",
                            "speaker": "北斗",
                            "text": "那二号舰就是挥出宝剑，斩断他们邪恶爪牙的先锋。"
                        },
                        {
                            "id": "402092611",
                            "speaker": "北斗",
                            "text": "基于星盘中一枚黯淡的变星，我想到了「伐煞星」这个名字。"
                        },
                        {
                            "id": "402092612",
                            "speaker": "派蒙",
                            "text": "这这这…听起来，威风中…有股不一样的杀气？"
                        },
                        {
                            "id": "402092613",
                            "speaker": "北斗",
                            "text": "或者换个思路——这次我们共同运用二号舰的武装，拦住了狂徒的攻击，保下了会场，是一次守护秩序的行动。"
                        },
                        {
                            "id": "402092614",
                            "speaker": "北斗",
                            "text": "所以，还有「衡正星」这么个名字可选，取的是「维持公正」的含义。"
                        },
                        {
                            "id": "402092615",
                            "speaker": "派蒙",
                            "text": "这个也挺不错的，非常正派！和之前的「伐煞星」各有特点，有点难以取舍…"
                        },
                        {
                            "id": "402092616",
                            "speaker": "北斗",
                            "text": "#{NICKNAME}怎么看？你更喜欢哪个名字？",
                            "choices": [
                                {
                                    "id": "402092617",
                                    "text": "我倾向于攻伐的意象。",
                                    "response": [
                                        {
                                            "id": "402092618",
                                            "speaker": "派蒙",
                                            "text": "嗯…主动出击，先把坏家伙打倒，确实符合你的作风。"
                                        },
                                        {
                                            "id": "402092619",
                                            "speaker": "北斗",
                                            "text": "自古以来一直都有「防患于未然」的理念，看来我们俩很合拍嘛！那就选「伐煞星」了！"
                                        },
                                        {
                                            "id": "402092623",
                                            "speaker": "北斗",
                                            "text": "#不错！那就根据{NICKNAME}的建议，给我们的二号舰定下全新的名字了！"
                                        },
                                        {
                                            "id": "402092624",
                                            "speaker": "北斗",
                                            "text": "空闲下来的话，你们多到船上玩玩啊，和船员们也都熟络熟络！"
                                        },
                                        {
                                            "id": "402092625",
                                            "speaker": "派蒙",
                                            "text": "一定一定！"
                                        }
                                    ]
                                },
                                {
                                    "id": "402092620",
                                    "text": "我倾向于守护的意象。",
                                    "response": [
                                        {
                                            "id": "402092621",
                                            "speaker": "派蒙",
                                            "text": "嗯！战斗的目的是为了保护大家，开开心心平平安安过好每一天。"
                                        },
                                        {
                                            "id": "402092622",
                                            "speaker": "北斗",
                                            "text": "确实，这么一想，「死兆星」号的煞气已经够重了，足够震慑敌人，「衡正星」恰好能缓和一下。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "402092626",
                    "text": "我们也开心，先去别处转转！",
                    "response": [
                        {
                            "id": "402092627",
                            "speaker": "派蒙",
                            "text": "现在没什么需要担心的了，北斗你也可以悠悠哉哉应付接下来的事！"
                        },
                        {
                            "id": "402092628",
                            "speaker": "北斗",
                            "text": "好啊！那就等你们之后再来！"
                        }
                    ]
                }
            ]
        }
    ]
}