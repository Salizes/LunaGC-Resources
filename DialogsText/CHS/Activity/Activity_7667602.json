    "dialogues": [
        {
            "id": "766760201",
            "speaker": "玛拉妮",
            "text": "「快乐的时光总是短暂的…」"
        },
        {
            "id": "766760202",
            "speaker": "玛拉妮",
            "text": "哎呀，我才不会说这样的话！以后，我们要把这次这样的聚会变成常态！"
        },
        {
            "id": "766760203",
            "speaker": "妮露",
            "text": "嗯！我也会期待，有一天，玛拉妮突然出现在祖拜尔剧场，从背后捂住我双眼，让我猜猜是谁…"
        },
        {
            "id": "766760204",
            "speaker": "派蒙",
            "text": "到时候可别忘了叫上我们哦！",
            "choices": [
                {
                    "id": "766760205",
                    "text": "看你们一起在舞台上表演。",
                    "response": [
                        {
                            "id": "766760207",
                            "speaker": "玛拉妮",
                            "text": "#哈哈，一言为定，{NICKNAME}和派蒙！"
                        },
                        {
                            "id": "766760208",
                            "speaker": "妮露",
                            "text": "玛拉妮还送了我一些「流泉之众」附近的花卉种子，我会好好栽培它们，把舞台装点得更加漂亮！"
                        }
                    ]
                },
                {
                    "id": "766760206",
                    "text": "带你们好好逛几圈大巴扎。"
                }
            ]
        }
    ]
}