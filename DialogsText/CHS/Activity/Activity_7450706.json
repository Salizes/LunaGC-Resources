{
    "talkId": "7450706",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Player": 12,
        "左右加": 20,
        "派蒙": 28,
        "？？？": 11
    },
    "dialogues": [
        {
            "id": "745070601",
            "speaker": "？？？",
            "text": "哇！「金山银山大老板」，居然真的在这里碰见你们了！",
            "choices": [
                {
                    "id": "745070602",
                    "text": "谁？",
                    "response": [
                        {
                            "id": "745070603",
                            "speaker": "派蒙",
                            "text": "这里怎么会有镀金旅团的成员！"
                        },
                        {
                            "id": "745070604",
                            "speaker": "？？？",
                            "text": "嘿嘿，没认出我来吧？我的变装大成功！"
                        },
                        {
                            "id": "745070605",
                            "speaker": "？？？",
                            "text": "好了，快把你们的朋友费交出来！"
                        },
                        {
                            "id": "745070606",
                            "speaker": "派蒙",
                            "text": "我们是不会给你摩拉的！"
                        },
                        {
                            "id": "745070607",
                            "speaker": "派蒙",
                            "text": "等等…朋友费是什么？"
                        },
                        {
                            "id": "745070608",
                            "speaker": "？？？",
                            "text": "热情地抱抱也可以，拍拍肩膀也行，碰碰拳头也没问题！"
                        },
                        {
                            "id": "745070609",
                            "speaker": "？？？",
                            "text": "重逢的时候，应该要开心欢呼庆祝，要大大大喝彩！"
                        },
                        {
                            "id": "745070610",
                            "speaker": "？？？",
                            "text": "难道你们不高兴吗，「天守阁的座上宾」，「三千贼匪七日斩」和「智巧勇武双连星」？"
                        },
                        {
                            "id": "745070611",
                            "speaker": "派蒙",
                            "text": "这一连串的奇怪称号，还有打招呼时的那个叫法…「大老板」？"
                        },
                        {
                            "id": "745070612",
                            "speaker": "派蒙",
                            "text": "我好像想起来了！"
                        },
                        {
                            "id": "745070613",
                            "speaker": "派蒙",
                            "text": "你难道是，难道是…左右加小姐？"
                        },
                        {
                            "id": "745070614",
                            "speaker": "左右加",
                            "text": "噔噔！答案正确！佣兵形态的左右加，堂堂登场！",
                            "choices": [
                                {
                                    "id": "745070615",
                                    "text": "好久不见，好有精神！",
                                    "response": [
                                        {
                                            "id": "745070616",
                                            "speaker": "派蒙",
                                            "text": "你怎么和海妮耶一样，完全就像是换了个人啊！"
                                        },
                                        {
                                            "id": "745070617",
                                            "speaker": "派蒙",
                                            "text": "你这身打扮，是穿了海妮耶的衣服吗？"
                                        },
                                        {
                                            "id": "745070618",
                                            "speaker": "左右加",
                                            "text": "还不错吧！轻便灵活又透气，很适合雨林生活，来到枫丹以后也刚刚好，把头发扎起来，完全不觉得闷热！"
                                        },
                                        {
                                            "id": "745070619",
                                            "speaker": "左右加",
                                            "text": "正好，我要在枫丹各地来回跑腿，连解暑的冰雾花花朵都省了！"
                                        },
                                        {
                                            "id": "745070625",
                                            "speaker": "左右加",
                                            "text": "正好聊到这里，你们见到海妮耶了吗？这次我们在枫丹开放了「小小灵蕈大幻戏」，是「灵蕈棋阵」的改进版。"
                                        },
                                        {
                                            "id": "745070626",
                                            "speaker": "左右加",
                                            "text": "里边有全新的对手哦，是我根据各地冒险家的传闻，精选了许多合适的对手，设计的棋子！"
                                        },
                                        {
                                            "id": "745070627",
                                            "speaker": "左右加",
                                            "text": "每位小小灵蕈的招式，也有经过重新设计，玩起来感觉肯定更不一样了！",
                                            "choices": [
                                                {
                                                    "id": "745070628",
                                                    "text": "体验更新奇了！",
                                                    "response": [
                                                        {
                                                            "id": "745070630",
                                                            "speaker": "派蒙",
                                                            "text": "嘿嘿，和动起来的对手较量的时候，感觉更紧张刺激了，指挥蕈兽伙伴们获胜的时候，也更有成就感！"
                                                        },
                                                        {
                                                            "id": "745070631",
                                                            "speaker": "左右加",
                                                            "text": "好耶，被两位老板认可了！那我接下来要再加把劲！"
                                                        },
                                                        {
                                                            "id": "745070632",
                                                            "speaker": "派蒙",
                                                            "text": "之前好像听海妮耶说过，你在报社门口站着，是忙着在《蒸汽鸟报》上刊登广告的事吗？"
                                                        },
                                                        {
                                                            "id": "745070633",
                                                            "speaker": "左右加",
                                                            "text": "没错！我已经和一位记者约好时间一起写稿了，文字方面的工作是我的强项！"
                                                        },
                                                        {
                                                            "id": "745070634",
                                                            "speaker": "左右加",
                                                            "text": "贝尔福先生则受邀去枫丹科学院那边，寻找改进「意智宝珠」的技术支援人员了，我暂时和他分头行动。"
                                                        },
                                                        {
                                                            "id": "745070635",
                                                            "speaker": "左右加",
                                                            "text": "等我搞定这边的事，我也要来和你们玩一局「小小灵蕈大幻戏」，请等着我哟！"
                                                        },
                                                        {
                                                            "id": "745070636",
                                                            "speaker": "派蒙",
                                                            "text": "那你们可要加油啊，左右加！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "745070629",
                                                    "text": "先夸夸左右加！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "745070620",
                                    "text": "我还没想起来呢！",
                                    "response": [
                                        {
                                            "id": "745070621",
                                            "speaker": "派蒙",
                                            "text": "#嗯，上次见到左右加小姐，还是在须弥的时候吧，{NICKNAME}你不记得了也很正常。"
                                        },
                                        {
                                            "id": "745070622",
                                            "speaker": "派蒙",
                                            "text": "好久以前，左右加小姐为了取材，参加了第一次驯兽师大赛，被我们打败了…"
                                        },
                                        {
                                            "id": "745070623",
                                            "speaker": "派蒙",
                                            "text": "但左右加小姐没有生气，还说要把我们写进她的小说里当正派对手。"
                                        },
                                        {
                                            "id": "745070624",
                                            "speaker": "派蒙",
                                            "text": "后来，她就跟着海妮耶一起照顾蕈兽伙伴们，还一直在出点子帮忙制作游戏。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "745070637",
                    "text": "哇！「镀金旅团」打进来了！",
                    "response": [
                        {
                            "id": "745070638",
                            "speaker": "派蒙",
                            "text": "哇啊啊啊！快去找警备队员…"
                        },
                        {
                            "id": "745070639",
                            "speaker": "派蒙",
                            "text": "有这个必要吗？"
                        },
                        {
                            "id": "745070640",
                            "speaker": "？？？",
                            "text": "干嘛幸灾乐祸啦哈哈哈哈哈，你们根本没在怕嘛！"
                        },
                        {
                            "id": "745070641",
                            "speaker": "？？？",
                            "text": "毕竟「你们很强，从你们手下逃过一劫的佣兵画了你们的像，警告其他人别惹你们。」"
                        },
                        {
                            "id": "745070642",
                            "speaker": "？？？",
                            "text": "不必说你们这样的强者，也不用提街上巡逻的警卫机关了，就连膨膨兽都能一尾巴抽晕我。"
                        },
                        {
                            "id": "745070643",
                            "speaker": "？？？",
                            "text": "何况，我又不是什么入侵者，我只是穿着佣兵的衣服，在进行正规商业活动的外来游客！"
                        },
                        {
                            "id": "745070644",
                            "speaker": "？？？",
                            "text": "海妮耶让蒂蕾娜小姐把我的相片送给了执律庭，所以警备队员们不会把我抓起来的！"
                        },
                        {
                            "id": "745070645",
                            "speaker": "Player",
                            "text": "等等，你提到了…海妮耶？"
                        },
                        {
                            "id": "745070646",
                            "speaker": "派蒙",
                            "text": "你难道是，难道是…左右加小姐？"
                        },
