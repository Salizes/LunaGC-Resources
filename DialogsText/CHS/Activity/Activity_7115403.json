    "dialogues": [
        {
            "id": "711540301",
            "speaker": "夏洛蒂",
            "text": "喔，都准备好了啊，那咱们就开始拍摄吧。",
            "choices": [
                {
                    "id": "711540302",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711540303",
                            "speaker": "夏洛蒂",
                            "text": "我已经看到啦。我刚才为了留影，也放飞了好几盏霄灯呢。"
                        },
                        {
                            "id": "711540304",
                            "speaker": "夏洛蒂",
                            "text": "心愿？啊…啊？！我光顾着留影，忘记写心愿了！不对不对，放飞那么多盏，许愿会不会不灵啊——",
                            "choices": [
                                {
                                    "id": "711540305",
                                    "text": "没问题，那就开始留影吧。",
                                    "response": [
                                        {
                                            "id": "711540306",
                                            "speaker": "夏洛蒂",
                                            "text": "#好嘞，对了…拍留影画片的时候，还要做点动作才好…{NICKNAME}，你给我一点建议？",
                                            "choices": [
                                                {
                                                    "id": "711540310",
                                                    "text": "放松一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711540313",
                                                            "speaker": "Player",
                                                            "text": "再试试第一个动作…",
                                                            "choices": [
                                                                {
                                                                    "id": "711540311",
                                                                    "text": "就这个动作吧。"
                                                                },
                                                                {
                                                                    "id": "711540312",
                                                                    "text": "再试试第二个动作…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711540309",
                                                    "text": "严肃一点的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711540307",
                                    "text": "请稍等一会…",
                                    "response": [
                                        {
                                            "id": "711540308",
                                            "speaker": "夏洛蒂",
                                            "text": "要去处理其他的事？没问题，等你处理好了之后，咱们再来讨论纪念留影的事吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
