    "dialogues": [
        {
            "id": "715404501",
            "speaker": "永安",
            "text": "你好，我…你…猫…阿嚏！"
        },
        {
            "id": "715404502",
            "speaker": "永安",
            "text": "对不起…前些日子不知怎么的，璃月港的猫猫狗狗都好像很焦躁的样子，边跑边叫忙个不停…"
        },
        {
            "id": "715404503",
            "speaker": "永安",
            "text": "最近倒是恢复了往日的样子，但我这过敏还是…阿、阿嚏！对不起…阿嚏！"
        }
    ]
}