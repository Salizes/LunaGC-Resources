{
    "talkId": "7114503",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "方妮雅": 8
    },
    "dialogues": [
        {
            "id": "711450301",
            "speaker": "方妮雅",
            "text": "看来你也忙得差不多了，荣誉骑士。我们这边的工作基本完成了，不久后就会启程返回蒙德。",
            "choices": [
                {
                    "id": "711450302",
                    "text": "这次交流的结果怎么样？",
                    "response": [
                        {
                            "id": "711450303",
                            "speaker": "方妮雅",
                            "text": "相当不错，直接暴露了我方计划编制的短板——机动力量中的远程交战能力略显孱弱。"
                        },
                        {
                            "id": "711450304",
                            "speaker": "方妮雅",
                            "text": "推演中，我方多次与枫丹的发条机关交手，虽有使用重型弓箭的单位，但很难穿透对方厚重的装甲，需要尽量拉近交战距离。"
                        },
                        {
                            "id": "711450305",
                            "speaker": "方妮雅",
                            "text": "如此一来，却又丧失了我方在预想中利用炼金侦察设备带来的情报优势。"
                        },
                        {
                            "id": "711450306",
                            "speaker": "方妮雅",
                            "text": "这方面的问题，可能要多多请教那位侦察骑士了。"
                        },
                        {
                            "id": "711450307",
                            "speaker": "方妮雅",
                            "text": "或者…找到艾玛托那家伙，让她把自己的炸药小型化…绑在箭头上？"
                        },
                        {
                            "id": "711450308",
                            "speaker": "方妮雅",
                            "text": "嗯…似乎也是不错的选择。"
                        }
                    ]
                },
                {
                    "id": "711450309",
                    "text": "一路顺风！",
                    "response": [
                        {
                            "id": "711450310",
                            "speaker": "方妮雅",
                            "text": "那就在蒙德再见了，荣誉骑士。"
                        }
                    ]
                }
            ]
        }
    ]
}