    "dialogues": [
        {
            "id": "401673401",
            "speaker": "莱依拉",
            "text": "欸…好像少计算了一个变量，难道要…重新开始…"
        },
        {
            "id": "401673402",
            "speaker": "Player",
            "text": "莱依拉，你还好吗？"
        },
        {
            "id": "401673403",
            "speaker": "莱依拉",
            "text": "#欸…你好{NICKNAME}！我没事，我只是看到了星星在眼前旋转…"
        },
        {
            "id": "401673404",
            "speaker": "莱依拉",
            "text": "不行！花神诞日就要到了，我必须尽快完成论文，然后去现场看花车巡游…",
            "choices": [
                {
                    "id": "401673405",
                    "text": "草神大人可不希望你勉强自己。",
                    "response": [
                        {
                            "id": "401673407",
                            "speaker": "莱依拉",
                            "text": "嗯…你说得对，说得对…"
                        },
                        {
                            "id": "401673408",
                            "speaker": "莱依拉",
                            "text": "再微小的星星也会有它自己的光亮。坚持发光，就一定能被看得到…我还是打起精神，再换一种算法好了…"
                        }
                    ]
                },
                {
                    "id": "401673406",
                    "text": "草神大人一定看得到你的努力。"
                }
            ]
        }
    ]
