{
    "talkId": "7567404",
    "total_dialogue_lines": 41,
    "speaker_counts": {
        "Player": 5,
        "卡齐娜": 14,
        "派蒙": 8,
        "芭芭拉": 14
    },
    "dialogues": [
        {
            "id": "756740401",
            "speaker": "卡齐娜",
            "text": "芭芭拉姐姐，我仔细想了一下，感觉之前有几个动作还可以再改进一下…"
        },
        {
            "id": "756740402",
            "speaker": "卡齐娜",
            "text": "目标是让美露莘朋友们施展得更自然，还要让小龙们更容易找到关键时机。"
        },
        {
            "id": "756740403",
            "speaker": "芭芭拉",
            "text": "好呀好呀，待会儿我们再对照医学书，尽量改进不适合美露莘和小龙发力的动作。"
        },
        {
            "id": "756740404",
            "speaker": "芭芭拉",
            "text": "肯定能像之前一样，编出又快乐又有趣，还简单好学的舞步！",
            "choices": [
                {
                    "id": "756740405",
                    "text": "卡齐娜和…芭芭拉？",
                    "response": [
                        {
                            "id": "756740407",
                            "speaker": "派蒙",
                            "text": "意想不到的朋友组合增加了！"
                        },
                        {
                            "id": "756740408",
                            "speaker": "卡齐娜",
                            "text": "啊，是师父和派蒙！"
                        },
                        {
                            "id": "756740409",
                            "speaker": "卡齐娜",
                            "text": "本来以为消息要很久才能送到冒险家协会那里，等你们收到又要好几天…"
                        },
                        {
                            "id": "756740410",
                            "speaker": "卡齐娜",
                            "text": "结果你们这么快就回来了，太好了！"
                        },
                        {
                            "id": "756740411",
                            "speaker": "卡齐娜",
                            "text": "这么看来，讯使们在国外送信的效率也还蛮高的嘛。"
                        },
                        {
                            "id": "756740412",
                            "speaker": "芭芭拉",
                            "text": "荣誉骑士啊，你终于到场了——"
                        },
                        {
                            "id": "756740413",
                            "speaker": "芭芭拉",
                            "text": "你再不出现，孩子们都要把《杜麦尼的蒙德旧闻》听完了。"
                        },
                        {
                            "id": "756740414",
                            "speaker": "芭芭拉",
                            "text": "但有许多有趣的事，要征得你们的同意才能转述呢。"
                        },
                        {
                            "id": "756740415",
                            "speaker": "派蒙",
                            "text": "确，确实呢，比如天空之琴的部分…",
                            "choices": [
                                {
                                    "id": "756740416",
                                    "text": "看来芭芭拉融入得很快嘛。",
                                    "response": [
                                        {
                                            "id": "756740417",
                                            "speaker": "芭芭拉",
                                            "text": "这都多亏了玛拉妮小姐的热情邀请，和卡齐娜的耐心介绍！"
                                        },
                                        {
                                            "id": "756740418",
                                            "speaker": "芭芭拉",
                                            "text": "来到悠悠度假村才几天，我就觉得，这里已经非常熟悉了。"
                                        },
                                        {
                                            "id": "756740419",
                                            "speaker": "派蒙",
                                            "text": "对吧？懒洋洋的夏日海滩…唔…和金苹果群岛有相似的感觉？"
                                        },
                                        {
                                            "id": "756740424",
                                            "speaker": "派蒙",
                                            "text": "话说回来，这次聚会的规模还真厉害呢。"
                                        },
                                        {
                                            "id": "756740425",
                                            "speaker": "派蒙",
                                            "text": "场地是专门搭的，参加的人也比第一回多好多，还来自另外两个国家！"
                                        },
                                        {
                                            "id": "756740426",
                                            "speaker": "卡齐娜",
                                            "text": "刚开始，玛拉妮只是想照常邀请妮露姐姐和须弥的朋友们，来再办一次舞术交流。"
                                        },
                                        {
                                            "id": "756740427",
                                            "speaker": "卡齐娜",
                                            "text": "不过，因为各种契机，不断出现新的参与者。"
                                        },
                                        {
                                            "id": "756740428",
                                            "speaker": "卡齐娜",
                                            "text": "蒙德的朋友还在计划之中，枫丹的朋友就完全是惊喜了。"
                                        },
                                        {
                                            "id": "756740429",
                                            "speaker": "卡齐娜",
                                            "text": "住在「流泉之众」好多年的梅内娅，都顺势邀请了她家乡的美露莘们来做客。"
                                        },
                                        {
                                            "id": "756740430",
                                            "speaker": "Player",
                                            "text": "这就是朋友的涌现效应呀。"
                                        },
                                        {
                                            "id": "756740431",
                                            "speaker": "派蒙",
                                            "text": "什么叫涌现…"
                                        },
                                        {
                                            "id": "756740432",
                                            "speaker": "派蒙",
                                            "text": "哦…哦！"
                                        },
                                        {
                                            "id": "756740433",
                                            "speaker": "派蒙",
                                            "text": "我好像明白了，意思就是…朋友多到一定程度的时候，惊喜就会像泉水一样冒出来？"
                                        },
                                        {
                                            "id": "756740434",
                                            "speaker": "芭芭拉",
                                            "text": "呼…我也是第一次在这么多不同国家的朋友面前跳舞，好好考验了一回舞台功底。"
                                        },
                                        {
                                            "id": "756740435",
                                            "speaker": "芭芭拉",
                                            "text": "不过，感觉真的很不错！"
                                        },
                                        {
                                            "id": "756740436",
                                            "speaker": "芭芭拉",
                                            "text": "希望你们也在这次特别的派对上玩得尽兴。"
                                        },
                                        {
                                            "id": "756740437",
                                            "speaker": "芭芭拉",
                                            "text": "美露莘和小龙们的一些动作，是卡齐娜带着我，专门为她们编排的哦。"
                                        },
                                        {
                                            "id": "756740438",
                                            "speaker": "卡齐娜",
                                            "text": "明明芭芭拉姐姐出力更多，还指出了好多…高深的医学问题！"
                                        },
                                        {
                                            "id": "756740439",
                                            "speaker": "芭芭拉",
                                            "text": "也不用太谦虚哟，卡齐娜。对于张力满满的舞蹈动作，我还有很多要向你学习的地方。"
                                        },
                                        {
                                            "id": "756740440",
                                            "speaker": "芭芭拉",
                                            "text": "如果你觉得「活动舞蹈编排者」的身份太出风头，好像关系到举办活动的功劳…"
                                        },
                                        {
                                            "id": "756740441",
                                            "speaker": "芭芭拉",
                                            "text": "那，我们来当并列的「小小动作顾问」就好啦~"
                                        }
                                    ]
                                },
                                {
                                    "id": "756740420",
                                    "text": "卡齐娜帮忙介绍得很到位。",
                                    "response": [
                                        {
                                            "id": "756740421",
                                            "speaker": "卡齐娜",
                                            "text": "应该的！师父的老朋友，对于纳塔的大家来说，也是最重要的客人。"
                                        },
                                        {
                                            "id": "756740422",
                                            "speaker": "卡齐娜",
                                            "text": "其实我也没做什么事…"
                                        },
                                        {
                                            "id": "756740423",
                                            "speaker": "卡齐娜",
                                            "text": "如果算是帮到忙了，我很开心！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740406",
                    "text": "我的好徒弟和…蒙德偶像？"
                }
            ]
        }
    ]
}