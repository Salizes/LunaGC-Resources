{
    "talkId": "7350804",
    "total_dialogue_lines": 105,
    "speaker_counts": {
        "Black Screen": 5,
        "Player": 12,
        "咚咚小圆帽": 1,
        "左右加": 28,
        "派蒙": 28,
        "海妮耶": 28,
        "火一": 1,
        "百雷遮罗": 1,
        "转转悠悠兽": 1
    },
    "dialogues": [
        {
            "id": "735080401",
            "speaker": "海妮耶",
            "text": "差不多该出发了，左右加。饭后再休息一会儿，我们就开始收拾营地。"
        },
        {
            "id": "735080402",
            "speaker": "海妮耶",
            "text": "待会儿又要长途跋涉了，如果蕈兽伙伴们走不动，就还是老样子——"
        },
        {
            "id": "735080403",
            "speaker": "海妮耶",
            "text": "你背「转转悠悠兽」和「百雷遮罗」，我背「咚咚小圆帽」和「欢腾之火」，帐篷和行李交给驮兽。"
        },
        {
            "id": "735080404",
            "speaker": "左右加",
            "text": "好的，那我准备一下就生火做饭，这顿饭可得多吃点！"
        },
        {
            "id": "735080405",
            "speaker": "派蒙",
            "text": "海妮耶和左右加小姐在营地里碰头了！她们在聊什么呢？",
            "choices": [
                {
                    "id": "735080406",
                    "text": "我们听听看？",
                    "response": [
                        {
                            "id": "735080407",
                            "speaker": "派蒙",
                            "text": "好，我实在有点好奇，海妮耶和左右加小姐应该不会介意吧…"
                        },
                        {
                            "id": "735080408",
                            "speaker": "左右加",
                            "text": "听说「灵蕈棋阵」的测试结果还不错啊？"
                        },
                        {
                            "id": "735080409",
                            "speaker": "左右加",
                            "text": "昨天，那几位商人来和我确认订货单了，连他们都试玩了「灵蕈棋阵」，赞不绝口。"
                        },
                        {
                            "id": "735080410",
                            "speaker": "海妮耶",
                            "text": "的确，贝尔福先生在策划活动这方面很有头脑，值得我们学习。"
                        },
                        {
                            "id": "735080411",
                            "speaker": "海妮耶",
                            "text": "这次还有「黄金流星」和「白银伴星」助阵，一切非常顺利，我深受鼓舞。"
                        },
                        {
                            "id": "735080412",
                            "speaker": "左右加",
                            "text": "真不愧是「智巧勇武双连星」，他们一出现，一般人应付不了的问题就会迎刃而解！"
                        },
                        {
                            "id": "735080413",
                            "speaker": "左右加",
                            "text": "一般人能对付的问题，也会在他们的帮助下快快消失…"
                        },
                        {
                            "id": "735080414",
                            "speaker": "派蒙",
                            "text": "嘿嘿，我们被夸啦！",
                            "choices": [
                                {
                                    "id": "735080415",
                                    "text": "嘘，派蒙…",
                                    "response": [
                                        {
                                            "id": "735080417",
                                            "speaker": "海妮耶",
                                            "text": "说起来，我们订购的东西还齐全吧？"
                                        },
                                        {
                                            "id": "735080418",
                                            "speaker": "左右加",
                                            "text": "放心，我们也算是他们的老客户了。"
                                        },
                                        {
                                            "id": "735080419",
                                            "speaker": "左右加",
                                            "text": "扩大营地的建材、蕈兽伙伴们的新床垫和小餐桌、还有玩耍用的爬架…一件都不差。"
                                        },
                                        {
                                            "id": "735080420",
                                            "speaker": "左右加",
                                            "text": "努查赫老师寄放在商人们那里的「妙妙琼脂」原料，也都新鲜得像是刚出炉！"
                                        },
                                        {
                                            "id": "735080421",
                                            "speaker": "左右加",
                                            "text": "这次奥摩斯港的旅途真是满载而归！"
                                        },
                                        {
                                            "id": "735080422",
                                            "speaker": "海妮耶",
                                            "text": "那我就放心了。"
                                        },
                                        {
                                            "id": "735080423",
                                            "speaker": "海妮耶",
                                            "text": "回到营地后，要麻烦你再教我一些字词和语法了，我要把那本「大型活动筹备要点五百问」好好读完。"
                                        },
                                        {
                                            "id": "735080424",
                                            "speaker": "左右加",
                                            "text": "没问题的，之前教你的东西绝对足够了，你学得那么刻苦，肯定能轻轻松松读懂大部分书。"
                                        },
                                        {
                                            "id": "735080425",
                                            "speaker": "左右加",
                                            "text": "不过，你还要研究商业的门道吗？明明都交给贝尔福先生就好。"
                                        },
                                        {
                                            "id": "735080426",
                                            "speaker": "海妮耶",
                                            "text": "第一届比赛开办的时候，除了贝尔福先生，还有几十人的幕后团队在忙碌，下次比赛还不知道能召回多少人。"
                                        },
                                        {
                                            "id": "735080427",
                                            "speaker": "海妮耶",
                                            "text": "不能只让贝尔福先生忙碌，当然也不能让「黄金流星」和「白银伴星」在下次大赛中为琐事操劳。"
                                        },
                                        {
                                            "id": "735080428",
                                            "speaker": "海妮耶",
                                            "text": "所以，我必须尽快变成一个多面手，在做好驯兽师的本职工作之余，尽可能顾及大赛各方面的事务。"
                                        },
                                        {
                                            "id": "735080429",
                                            "speaker": "海妮耶",
                                            "text": "#这样才能回应{M#他们}{F#她们}的期待…"
                                        },
                                        {
                                            "id": "735080430",
                                            "speaker": "左右加",
                                            "text": "有道理…那我也要帮忙！"
                                        },
                                        {
                                            "id": "735080431",
                                            "speaker": "左右加",
                                            "text": "虽然还不知道我能做什么，但决心要先拿出来！"
                                        },
                                        {
                                            "id": "735080432",
                                            "speaker": "海妮耶",
                                            "text": "你先练练体能吧，等到你能在野外独自生存，才有余力谈之后的事，不然，我还要分心照顾你。"
                                        },
                                        {
                                            "id": "735080433",
                                            "speaker": "左右加",
                                            "text": "是…我会努力的，争取不给你添麻烦！"
                                        },
                                        {
                                            "id": "735080434",
                                            "speaker": "左右加",
                                            "text": "至少这段时间以来，我进步很大，对不对？上次我还打退了闯进营地的大大大蕈猪！"
                                        },
                                        {
                                            "id": "735080435",
                                            "speaker": "海妮耶",
                                            "text": "一说打斗，我就想起来了，你这身衣服，要不也换换？"
                                        },
                                        {
                                            "id": "735080436",
                                            "speaker": "海妮耶",
                                            "text": "衣摆太长了，在雨林里不方便，看起来也很贵重，弄坏了有点可惜。"
                                        },
                                        {
                                            "id": "735080437",
                                            "speaker": "海妮耶",
                                            "text": "我有几套「镀金旅团」的备用服，还有当时在用的武器，不介意的话，都给你了。"
                                        },
                                        {
                                            "id": "735080438",
                                            "speaker": "左右加",
                                            "text": "佣兵的装束？我，我很好奇！作为小说角色的插曲经历，简直太棒了！"
                                        },
                                        {
                                            "id": "735080439",
                                            "speaker": "派蒙",
                                            "text": "嗯，她们俩的关系好像变得很不错了！真是件好事呢！",
                                            "choices": [
                                                {
                                                    "id": "735080440",
                                                    "text": "如果没人打断她们的话…",
                                                    "response": [
                                                        {
                                                            "id": "735080442",
                                                            "speaker": "派蒙",
                                                            "text": "我们就别打扰她们了，让她们专心讨论接下来的事吧！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "735080441",
                                                    "text": "感觉她们可以一直聊下去…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "735080416",
                                    "text": "嘿嘿…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735080443",
                    "text": "还是打个招呼吧？",
                    "response": [
                        {
                            "id": "735080444",
                            "speaker": "派蒙",
                            "text": "好，听起来，她们很快就要离开了，趁这个机会，再和她们聊两句吧。"
                        },
                        {
                            "id": "735080445",
                            "speaker": "派蒙",
                            "text": "喂~海妮耶，左右加！"
                        },
                        {
                            "id": "735080446",
                            "speaker": "左右加",
                            "text": "哇！突然出现了，不愧是「随叫随到冒险王」！"
                        },
                        {
                            "id": "735080447",
                            "speaker": "派蒙",
                            "text": "又是第一次听说的称号…"
                        },
                        {
                            "id": "735080448",
                            "speaker": "派蒙",
                            "text": "左右加小姐到底知道多少个我们的绰号啊？改天要拿个小记事本，全都记下来。"
                        },
                        {
                            "id": "735080449",
                            "speaker": "海妮耶",
                            "text": "之前我还说过，我们不用多久就会见面，没想到这么快就应验了。"
                        },
                        {
                            "id": "735080450",
                            "speaker": "海妮耶",
                            "text": "说不定下次也会像这样，在不经意间相遇。"
                        },
                        {
                            "id": "735080451",
                            "speaker": "海妮耶",
                            "text": "抱着这样的想法，暂时和蕈兽伙伴们分别，也不用太难过。"
                        },
                        {
                            "id": "735080452",
                            "speaker": "Player",
                            "text": "有道理。"
                        },
                        {
                            "id": "735080453",
                            "speaker": "派蒙",
                            "text": "多亏海妮耶，我心态变得越来越好啦！"
                        },
                        {
                            "id": "735080454",
                            "speaker": "海妮耶",
                            "text": "正好，我们打算吃顿饭后，启程返回营地，你们不赶时间的话，要不要和我们一起？"
                        },
                        {
                            "id": "735080455",
                            "speaker": "海妮耶",
                            "text": "左右加的厨艺特别强，常常做出我从没听过的美食，错过了就可惜了。"
                        },
                        {
                            "id": "735080456",
                            "speaker": "海妮耶",
                            "text": "根据她的提议，努查赫小姐还为最新版的「妙妙琼脂」加入了各种风味物质，蕈兽伙伴们都很喜欢。"
                        },
                        {
                            "id": "735080457",
                            "speaker": "派蒙",
                            "text": "真，真的吗？"
                        },
                        {
                            "id": "735080458",
                            "speaker": "左右加",
                            "text": "没，没那么夸张啦，我只不过照着一些轻小说里的桥段，试着做过一些料理，没什么章法…"
                        },
                        {
                            "id": "735080459",
                            "speaker": "左右加",
                            "text": "现在你们两位也来了，我更要拿出百分之千的认真，施展毕生所学，好好做一顿大餐！"
                        },
                        {
                            "id": "735080460",
                            "speaker": "派蒙",
                            "text": "好耶，大餐！"
                        },
                        {
                            "id": "735080461",
                            "speaker": "派蒙",
                            "text": "左右加小姐的「无拘束绮想作家大餐」！"
                        },
                        {
                            "id": "735080462",
                            "speaker": "海妮耶",
                            "text": "那我去把蕈兽伙伴们叫过来，摆好它们喜欢的「妙妙琼脂」，一起吃顿饭。"
                        },
                        {
                            "id": "735080463",
                            "speaker": "海妮耶",
                            "text": "嗯？这样的事情…我好像已经习以为常了？"
                        },
                        {
                            "id": "735080464",
                            "speaker": "海妮耶",
                            "text": "…真好啊。"
                        },
                        {
                            "id": "735080465",
                            "speaker": "派蒙",
                            "text": "你在念叨什么呢，海妮耶？"
                        },
                        {
                            "id": "735080466",
                            "speaker": "海妮耶",
                            "text": "没什么…你们还可以看看左右加下厨的过程，简直就像是变戏法。"
                        },
                        {
                            "id": "735080467",
                            "speaker": "左右加",
                            "text": "那我就准备开工啦，请看好哦！"
                        },
                        {
                            "id": "735080468",
                            "speaker": "Black Screen",
                            "text": "左右加从书堆里找出了好几本标题极长的轻小说，对照营地里已有的食材，决定了大餐的菜谱。"
                        },
                        {
                            "id": "735080469",
                            "speaker": "Black Screen",
                            "text": "随后，她取出厨具，开始了华丽而迅捷的烹饪。不消多时，就完成了几道丰盛的菜肴。"
                        },
                        {
                            "id": "735080470",
                            "speaker": "Black Screen",
                            "text": "大家在营地里席地而坐，与蕈兽伙伴们肩并肩，一起享用美味的饭菜。"
                        },
                        {
                            "id": "735080471",
                            "speaker": "Black Screen",
                            "text": "耳畔水声潺潺，来自雨林的芬芳与盛宴佳肴的馥郁香气交旋…"
                        },
                        {
                            "id": "735080472",
                            "speaker": "Black Screen",
                            "text": "时间似乎放慢了脚步，快乐的时光分外悠长…"
                        },
                        {
                            "id": "735080473",
                            "speaker": "派蒙",
                            "text": "呼…好饱好饱，好满足！"
                        },
                        {
                            "id": "735080474",
                            "speaker": "派蒙",
                            "text": "「咚咚小圆帽」、「欢腾之火」、「转转悠悠兽」和「百雷遮罗」，你们感觉怎么样？"
                        },
                        {
                            "id": "735080475",
                            "speaker": "咚咚小圆帽",
                            "text": "♪~"
                        },
                        {
                            "id": "735080476",
                            "speaker": "火一",
                            "text": "♫~"
                        },
                        {
                            "id": "735080477",
                            "speaker": "转转悠悠兽",
                            "text": "♩~"
                        },
                        {
                            "id": "735080478",
                            "speaker": "百雷遮罗",
                            "text": "♬~"
                        },
                        {
                            "id": "735080479",
                            "speaker": "派蒙",
                            "text": "太好了，大家都吃饱喝足，心满意足！",
                            "choices": [
                                {
                                    "id": "735080480",
                                    "text": "我怎么没听懂！",
                                    "response": [
                                        {
                                            "id": "735080482",
                                            "speaker": "派蒙",
                                            "text": "哼！那你等到下次比赛，多和「咚咚小圆帽」说说话啦！"
                                        },
                                        {
                                            "id": "735080483",
                                            "speaker": "派蒙",
                                            "text": "话说回来，没想到枣椰还有好几十种做法…"
                                        },
                                        {
                                            "id": "735080484",
                                            "speaker": "派蒙",
                                            "text": "日落果和墩墩桃煮熟后，搭配香辛料是这种味道！"
                                        },
                                        {
                                            "id": "735080485",
                                            "speaker": "派蒙",
                                            "text": "左右加小姐待在须弥的时间明明不长，怎么好像很快就了解了本地食材的特点！"
                                        },
                                        {
                                            "id": "735080486",
                                            "speaker": "左右加",
                                            "text": "这是作者的本职工作嘛，写作之前，要把书里提到的地区好好调查一番，尽可能背下当地的百科全书。"
                                        },
                                        {
                                            "id": "735080487",
                                            "speaker": "左右加",
                                            "text": "再加一点轻小说里常见的思维，看见两个陌生事物就搭配一下试试，就能得到意外的惊喜啦。"
                                        },
                                        {
                                            "id": "735080488",
                                            "speaker": "左右加",
                                            "text": "说到这里，我突然想起…有本轻小说提到过，将厨艺修炼到极致，甚至可以跨越绝对的喜好和固有的习惯…"
                                        },
                                        {
                                            "id": "735080489",
                                            "speaker": "左右加",
                                            "text": "比如让不能吃辣的人爱上吃辣，让狗狗也喜欢上猫猫的饭…"
                                        },
                                        {
                                            "id": "735080490",
                                            "speaker": "左右加",
                                            "text": "作者给出的理由是「只要搞清楚决定喜恶的味觉成分，对这些成分进行精准的把控，食物之间将没有界线」。"
                                        },
                                        {
                                            "id": "735080491",
                                            "speaker": "左右加",
                                            "text": "这个道理，或许也适用于蕈兽伙伴？"
                                        },
                                        {
                                            "id": "735080492",
                                            "speaker": "左右加",
                                            "text": "要是厨艺达到极致，说不定蕈兽伙伴也不用局限于汲取「妙妙琼脂」里的养分了呢。"
                                        },
                                        {
                                            "id": "735080493",
                                            "speaker": "派蒙",
                                            "text": "真的吗？听起来好像…有点道理？"
                                        },
                                        {
                                            "id": "735080494",
                                            "speaker": "派蒙",
                                            "text": "#{NICKNAME}，以后再去稻妻的时候，我们留意一下，看看能不能找到这样的轻小说吧？"
                                        },
                                        {
                                            "id": "735080495",
                                            "speaker": "派蒙",
                                            "text": "要是有合适的机会，我们也要来一番特别的厨艺修行，为蕈兽伙伴们打开美食新世界的大门！",
                                            "choices": [
                                                {
                                                    "id": "735080496",
                                                    "text": "交给我了！",
                                                    "response": [
                                                        {
                                                            "id": "735080498",
                                                            "speaker": "左右加",
                                                            "text": "太好了太好了，我先在书里面给你们追加上「全领域自适应特级厨师」的设定…说不定你们就成功了呢！"
                                                        },
                                                        {
                                                            "id": "735080499",
                                                            "speaker": "海妮耶",
                                                            "text": "如果是你们两位的话，就算无法用常理解释的事，说不定也能做到大功告成，证明给所有人看呢。"
                                                        },
                                                        {
                                                            "id": "735080500",
                                                            "speaker": "海妮耶",
                                                            "text": "我很期待，今后我们就一起努力吧！"
                                                        },
                                                        {
                                                            "id": "735080501",
                                                            "speaker": "派蒙",
                                                            "text": "好！我现在动力满满，我们就要出发了！"
                                                        },
                                                        {
                                                            "id": "735080502",
                                                            "speaker": "派蒙",
                                                            "text": "下次见面的时候，我们还要像现在这样聚餐！"
                                                        }
