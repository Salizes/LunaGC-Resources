    "dialogues": [
        {
            "id": "745071201",
            "speaker": "海妮耶",
            "text": "如果你们不忙的话，还可以再来玩玩「小小灵蕈大幻戏」。",
            "choices": [
                {
                    "id": "745071202",
                    "text": "再玩一局「小小灵蕈大幻戏」。",
                    "response": [
                        {
                            "id": "745071203",
                            "speaker": "左右加",
                            "text": "没错！观察你们的玩法，我也能得到更多设计的灵感！请玩到痛快为止吧！"
                        }
                    ]
                },
                {
                    "id": "745071204",
                    "text": "稍后再见！",
                    "response": [
                        {
                            "id": "745071205",
                            "speaker": "海妮耶",
                            "text": "我们还会在枫丹停留一段时间，期待你们忙完手头的事，再来玩的那天。"
                        },
                        {
                            "id": "745071206",
                            "speaker": "左右加",
                            "text": "不过，就算你们一时抽不开身也没问题。不管你们旅行到哪里，我们都会想办法追上你们的脚步，还会再见的！"
                        }
                    ]
                }
            ]
        }
    ]
}