{
    "talkId": "7750120",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 5,
        "瓦乐瑞娜": 22
    },
    "dialogues": [
        {
            "id": "775012001",
            "speaker": "瓦乐瑞娜",
            "text": "又见面啦，猫猫救星荣誉骑士，我也作为蒙德冒险家参赛了哦。"
        },
        {
            "id": "775012002",
            "speaker": "瓦乐瑞娜",
            "text": "虽然也有点意外，我本来在回访纳塔的朋友，正巧碰上她们出远门，就被顺路拎过来玩了…",
            "choices": [
                {
                    "id": "775012003",
                    "text": "最近的生活如何？",
                    "response": [
                        {
                            "id": "775012004",
                            "speaker": "瓦乐瑞娜",
                            "text": "一直很顺利哦。"
                        },
                        {
                            "id": "775012005",
                            "speaker": "瓦乐瑞娜",
                            "text": "之前，班尼特老师带了几位协会的老前辈，到纳塔悠悠度假村玩了个痛快。"
                        },
                        {
                            "id": "775012006",
                            "speaker": "瓦乐瑞娜",
                            "text": "听了他们的好评，我也去享受了一番，实在太舒爽了…"
                        },
                        {
                            "id": "775012007",
                            "speaker": "瓦乐瑞娜",
                            "text": "结果度假第八天，就碰见了在沙滩边晒日光浴的莉琉大姐，还有她的好朋友。"
                        },
                        {
                            "id": "775012008",
                            "speaker": "瓦乐瑞娜",
                            "text": "听说一位的称号是「海浪中的莎孚」，另一位则是「冰结之领」莉莱。"
                        },
                        {
                            "id": "775012009",
                            "speaker": "瓦乐瑞娜",
                            "text": "莉琉是这个音乐组合里的歌手兼聚聚鼓手，有时也会拿出可以坐在上边的那种箱鼓来拍打。"
                        },
                        {
                            "id": "775012010",
                            "speaker": "瓦乐瑞娜",
                            "text": "莎孚负责悠可琴，也会弹大尺寸的经典吉他，她的经典吉他还有德沃沙克大师的签名呢。"
                        },
                        {
                            "id": "775012011",
                            "speaker": "瓦乐瑞娜",
                            "text": "莉莱是长笛演奏家，又能吹晚风圆号，一般根据音色的需要来选乐器，灵活从容，没有演奏不了的乐曲~",
                            "choices": [
                                {
                                    "id": "775012012",
                                    "text": "听起来都是很温柔的人啊…",
                                    "response": [
                                        {
                                            "id": "775012014",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "又温柔又厉害，还特招小动物们喜欢！我跟着她们享受了一周的果酒和音乐之旅，听了个过瘾，玩了个痛快…"
                                        },
                                        {
                                            "id": "775012015",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "然后我就被她们拉进队伍，去寻找失落的乐谱了。"
                                        },
                                        {
                                            "id": "775012016",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "找完乐谱还不到两天，莉琉大姐就收到了这次大会的邀请函，果断拉着我一起来了。"
                                        },
                                        {
                                            "id": "775012017",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "听说她们想从一些旧曲目中获得启发，让新作更加完美。"
                                        },
                                        {
                                            "id": "775012018",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "最后有些收获，不过，她们完成新曲的写作，应该还需要一些时日。"
                                        },
                                        {
                                            "id": "775012019",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "但我已经期待到等不及了，以后我每隔两个月，就要回纳塔去看望看望她们！"
                                        }
                                    ]
                                },
                                {
                                    "id": "775012013",
                                    "text": "听起来都是很厉害的人啊…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775012020",
                    "text": "其实，不记得你是谁了。",
                    "response": [
                        {
                            "id": "775012021",
                            "speaker": "瓦乐瑞娜",
                            "text": "欸，怎么这样！"
                        },
                        {
                            "id": "775012022",
                            "speaker": "瓦乐瑞娜",
                            "text": "好吧…应该是我自己太不起眼的错，以后每隔一段时间就给你寄点礼物好了。"
                        },
                        {
                            "id": "775012023",
                            "speaker": "瓦乐瑞娜",
                            "text": "请让我重新介绍自己，我是主管着「猫茸茸城堡」的解谜专家瓦乐瑞娜。"
                        },
                        {
                            "id": "775012024",
                            "speaker": "瓦乐瑞娜",
                            "text": "最近也有投资丽莎和艾玛托小姐设计的「嘟嘟可爆轰系列」桌上游戏…"
                        },
                        {
                            "id": "775012025",
                            "speaker": "瓦乐瑞娜",
                            "text": "如果你有什么项目需要资金支持，预期商业表现不错，可以给我看计划书哦，我能出不少钱！"
                        }
                    ]
                },
                {
                    "id": "775012026",
                    "text": "那太好了，我们都要好好表现。",
                    "response": [
                        {
                            "id": "775012027",
                            "speaker": "瓦乐瑞娜",
                            "text": "嗯！我这次发挥不错哦，已经通过战斗以外的项目拿到了意料外的名次了，心满意足。"
                        }
                    ]
                }
            ]
        }
    ]
}