    "dialogues": [
        {
            "id": "401542401",
            "speaker": "北斗",
            "text": "我们回来咯。优菈带我去星落湖附近转了一圈，从高处俯瞰，风景真好啊。"
        },
        {
            "id": "401542402",
            "speaker": "优菈",
            "text": "你要是喜欢就好了。原本还担心一直瞎逛会让你觉得无聊呢…"
        },
        {
            "id": "401542403",
            "speaker": "北斗",
            "text": "怎么会，像我这样常年在海上的人，偶尔在林间散散步也挺难得的嘛。"
        },
        {
            "id": "401542404",
            "speaker": "北斗",
            "text": "#{NICKNAME}这边进展如何？",
            "choices": [
                {
                    "id": "401542405",
                    "text": "还差一点！",
                    "response": [
                        {
                            "id": "401542407",
                            "speaker": "北斗",
                            "text": "没事，这次行程预留的时间还挺充足的。"
                        }
                    ]
                },
                {
                    "id": "401542406",
                    "text": "马上就好！"
                }
            ]
        }
    ]
}