{
    "talkId": "7154013",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "凝光": 9
    },
    "dialogues": [
        {
            "id": "715401301",
            "speaker": "凝光",
            "text": "…终归是大事已了，能安下些心了。",
            "choices": [
                {
                    "id": "715401302",
                    "text": "这封祝柬送给你。",
                    "response": [
                        {
                            "id": "715401303",
                            "speaker": "凝光",
                            "text": "谢谢。不愧是出自你之手，这份祝柬果然精美好看。"
                        },
                        {
                            "id": "715401304",
                            "speaker": "凝光",
                            "text": "这次「死气」之事，多亏了有你和胡堂主相助，才没有出大事。"
                        },
                        {
                            "id": "715401305",
                            "speaker": "凝光",
                            "text": "我替璃月港，再谢你和胡堂主一次。"
                        },
                        {
                            "id": "715401306",
                            "speaker": "凝光",
                            "text": "世间口头慷慨者不知凡几，但真到了大难临头，只有挺身而出者方是真英雄。"
                        },
                        {
                            "id": "715401307",
                            "speaker": "凝光",
                            "text": "璃月港屡次得到各位英雄相助，是璃月港的幸运。"
                        },
                        {
                            "id": "715401308",
                            "speaker": "凝光",
                            "text": "…好了，佳节在前，场面话说太多，只怕连美食也吃不下去了。"
                        },
                        {
                            "id": "715401309",
                            "speaker": "凝光",
                            "text": "大难已过，你也该放松些，去好好享受这次海灯节了。"
                        }
                    ]
                },
                {
                    "id": "715401310",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715401311",
                            "speaker": "凝光",
                            "text": "再见。放松些，好好享受这次海灯节吧。"
                        }
                    ]
                }
            ]
        }
    ]
}