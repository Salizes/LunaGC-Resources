{
    "talkId": "7154001",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 3,
        "香菱": 14
    },
    "dialogues": [
        {
            "id": "715400101",
            "speaker": "香菱",
            "text": "唔，这里应该有些新鲜野菜…",
            "choices": [
                {
                    "id": "715400102",
                    "text": "香菱，这封祝柬送你。",
                    "response": [
                        {
                            "id": "715400103",
                            "speaker": "香菱",
                            "text": "#哎呀，{NICKNAME}，是你呀。多谢啦，这祝柬真好看。"
                        },
                        {
                            "id": "715400104",
                            "speaker": "香菱",
                            "text": "对了，海灯节那晚，你和胡桃其实是办了大事吧？她没详细讲，但我感觉就不是普通的祭仪。"
                        },
                        {
                            "id": "715400105",
                            "speaker": "香菱",
                            "text": "我那天备好了菜，搬好了凳子，还想等你们忙完回来一起吃饭呢。"
                        },
                        {
                            "id": "715400106",
                            "speaker": "香菱",
                            "text": "结果，一直等到半夜也不见你们回来，老爹就让我回去睡觉，他在外面看着。"
                        },
                        {
                            "id": "715400107",
                            "speaker": "香菱",
                            "text": "我最开始也守在门口呢，可是到了半夜，困得实在受不了了，就迷迷糊糊睡了过去…"
                        },
                        {
                            "id": "715400108",
                            "speaker": "香菱",
                            "text": "我睡的时候一直做梦，梦见胡桃站在我面前，一边拿桃树枝给我梳头发，一边唱着什么怪歌。"
                        },
                        {
                            "id": "715400109",
                            "speaker": "香菱",
                            "text": "我使劲想抓住她，想问她在干什么，但我的身子动不了，声音也发不出来…"
                        },
                        {
                            "id": "715400110",
                            "speaker": "香菱",
                            "text": "最后，我大叫一声「胡桃你别吓我！」，从床上一下子蹦起来，把老爹吓了一跳。"
                        },
                        {
                            "id": "715400111",
                            "speaker": "Player",
                            "text": "让你担心了。"
                        },
                        {
                            "id": "715400112",
                            "speaker": "香菱",
                            "text": "哼，你还知道呀。好在后来行秋透露了一点消息，说你们那晚弄了什么阵法。"
                        },
                        {
                            "id": "715400113",
                            "speaker": "香菱",
                            "text": "虽然我不懂…什么大阵的，但你们忙来忙去，难道肚子不饿，眼睛不花么？"
                        },
                        {
                            "id": "715400114",
                            "speaker": "香菱",
                            "text": "实在不行，我也能做几个米窝窝，给你们带着在路上吃呀，真是太不注意身体啦。"
                        },
                        {
                            "id": "715400115",
                            "speaker": "香菱",
                            "text": "嗯…罚你们节日期间，每天都来我家吃饭。"
                        }
                    ]
                },
                {
                    "id": "715400116",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715400117",
                            "speaker": "香菱",
                            "text": "嗯，回头见。"
                        }
                    ]
                }
            ]
        }
    ]
}