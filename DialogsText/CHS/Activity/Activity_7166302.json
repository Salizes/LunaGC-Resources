{
    "talkId": "7166302",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "娜扎法琳": 9
    },
    "dialogues": [
        {
            "id": "716630201",
            "speaker": "娜扎法琳",
            "text": "噢，我的小吉祥草王啊。我心中的大石头总算落地了。"
        },
        {
            "id": "716630202",
            "speaker": "娜扎法琳",
            "text": "二位大人真是大善人。",
            "choices": [
                {
                    "id": "716630203",
                    "text": "你的说话方式…",
                    "response": [
                        {
                            "id": "716630204",
                            "speaker": "娜扎法琳",
                            "text": "噢，我的小吉祥草王啊。您是说这样吗？我有个枫丹朋友，他非常喜欢这么说话。"
                        },
                        {
                            "id": "716630205",
                            "speaker": "娜扎法琳",
                            "text": "和他聊天久了之后，我也被传染成了这样。"
                        },
                        {
                            "id": "716630206",
                            "speaker": "娜扎法琳",
                            "text": "比起他，其实我已经非常克制了…只是还是忍不住。草王在上，我得继续加把劲儿才行。"
                        }
                    ]
                },
                {
                    "id": "716630207",
                    "text": "这口锅的用法…",
                    "response": [
                        {
                            "id": "716630208",
                            "speaker": "娜扎法琳",
                            "text": "噢，瞧瞧我这记性，要是您不提醒我，我就忘记了。"
                        },
                        {
                            "id": "716630209",
                            "speaker": "娜扎法琳",
                            "text": "其实非常简单，只需要在正确的时机加入正确的配料就行。"
                        },
                        {
                            "id": "716630210",
                            "speaker": "娜扎法琳",
                            "text": "您那么聪明，肯定试一次就会了。"
                        }
                    ]
                },
                {
                    "id": "716630211",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "716630212",
                            "speaker": "娜扎法琳",
                            "text": "再见。再次感谢您，拯救娜扎法琳的大英雄！"
                        }
                    ]
                }
            ]
        }
    ]
}