{
    "talkId": "7151410",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "派蒙": 4,
        "甜甜": 4
    },
    "dialogues": [
        {
            "id": "715141001",
            "speaker": "甜甜",
            "text": "两位前辈，你们回来了！竞速挑战的体验怎么样呀？",
            "choices": [
                {
                    "id": "715141002",
                    "text": "烟花助飞派蒙，咻咻！",
                    "response": [
                        {
                            "id": "715141003",
                            "speaker": "派蒙",
                            "text": "咻咻！我们跑得超级痛快，感觉很不错！"
                        },
                        {
                            "id": "715141004",
                            "speaker": "甜甜",
                            "text": "超级痛快？这个评价好强，如果我的体力再好一点，都想亲自去试试了！"
                        },
                        {
                            "id": "715141005",
                            "speaker": "派蒙",
                            "text": "那你也好好锻炼一下嘛，甜甜小姐！实力强大的宣传员肯定能吸引到更多新人！"
                        }
                    ]
                },
                {
                    "id": "715141006",
                    "text": "火药推进派蒙，呼呼！",
                    "response": [
                        {
                            "id": "715141007",
                            "speaker": "派蒙",
                            "text": "呼呼！我们创下了最快纪录，后来的参与者都追不上我们！"
                        },
                        {
                            "id": "715141008",
                            "speaker": "甜甜",
                            "text": "啊哈，我也有点心动了！说不定我这个活动的设计者能超过你们呢？"
                        },
                        {
                            "id": "715141009",
                            "speaker": "派蒙",
                            "text": "嘿嘿嘿，那可不容易，说不定你真的设计一个火药推进的背包，才有那么一点点机会呢！"
                        }
                    ]
                },
                {
                    "id": "715141010",
                    "text": "我们再去试试，拜拜！",
                    "response": [
                        {
                            "id": "715141011",
                            "speaker": "甜甜",
                            "text": "拜拜！我随时在这里等着前辈们的反馈！"
                        }
                    ]
                }
            ]
        }
    ]
}