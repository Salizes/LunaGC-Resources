{
    "talkId": "7154023",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "安柏": 11
    },
    "dialogues": [
        {
            "id": "715402301",
            "speaker": "安柏",
            "text": "唔，下一站去哪里呢…好像哪里都很热闹…",
            "choices": [
                {
                    "id": "715402302",
                    "text": "这封祝柬送给你。",
                    "response": [
                        {
                            "id": "715402303",
                            "speaker": "安柏",
                            "text": "谢谢啦！这应该就是「祝柬」吧。我听说过，璃月人在海灯节期间会互送「祝柬」，以示祝福。"
                        },
                        {
                            "id": "715402304",
                            "speaker": "安柏",
                            "text": "真漂亮，我会收好的。"
                        },
                        {
                            "id": "715402305",
                            "speaker": "Player",
                            "text": "你是专程来海灯节玩的吗？"
                        },
                        {
                            "id": "715402306",
                            "speaker": "安柏",
                            "text": "嗯，琴团长说大家都忙了一整年了，多少也应该休息一会，所以就安排骑士团的各位轮流休息。"
                        },
                        {
                            "id": "715402307",
                            "speaker": "安柏",
                            "text": "这几天轮到我和优菈休息，听说璃月港正在举办海灯节，所以就一起过来玩啦。"
                        },
                        {
                            "id": "715402308",
                            "speaker": "Player",
                            "text": "街上正好热闹，有很多好玩的。"
                        },
                        {
                            "id": "715402309",
                            "speaker": "安柏",
                            "text": "嗯，我们一起在街上玩了好久，刚刚分开各自去买礼物，准备带回去送给骑士团的大家。"
                        },
                        {
                            "id": "715402310",
                            "speaker": "安柏",
                            "text": "我已经买了好多了！扇子送给琴团长，茶杯送给丽莎，风筝送给小可莉…"
                        },
                        {
                            "id": "715402311",
                            "speaker": "安柏",
                            "text": "还有还有，这个给你！这种烤吃虎鱼可好吃了，快尝尝！我刚买的，还热着呢。"
                        },
                        {
                            "id": "715402312",
                            "speaker": "安柏",
                            "text": "你快点吃，别让它凉了喔，我要继续去那边买东西啦。"
                        },
                        {
                            "id": "715402313",
                            "speaker": "安柏",
                            "text": "扇子，茶杯，风筝…还差什么？对了，去看看首饰好了…"
                        }
                    ]
                },
                {
                    "id": "715402314",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715402315",
                            "speaker": "安柏",
                            "text": "再见！等你下次来蒙德，我们再好好聚一聚。"
                        }
                    ]
                }
            ]
        }
    ]
}