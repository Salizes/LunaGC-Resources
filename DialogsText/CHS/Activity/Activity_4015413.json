{
    "talkId": "4015413",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 4,
        "派蒙": 4,
        "砂糖": 13
    },
    "dialogues": [
        {
            "id": "401541301",
            "speaker": "砂糖",
            "text": "你们好呀，一段时间不见了。"
        },
        {
            "id": "401541302",
            "speaker": "派蒙",
            "text": "呜哇，这么快就有新的考核了吗。"
        },
        {
            "id": "401541303",
            "speaker": "砂糖",
            "text": "#嗯，这次是高级的考核，虽然难度会比上次更高，但我相信{NICKNAME}肯定没问题的。",
            "choices": [
                {
                    "id": "401541304",
                    "text": "有点紧张。",
                    "response": [
                        {
                            "id": "401541306",
                            "speaker": "砂糖",
                            "text": "其实可以轻松一些的啦。上回我把你炼制的药剂给阿贝多先生看了，他说初学者能做到这种程度，让人有些惊讶呢。"
                        },
                        {
                            "id": "401541307",
                            "speaker": "砂糖",
                            "text": "#「如果是{F#她}{M#他}的话，设置更难的题目也没关系吧。」"
                        },
                        {
                            "id": "401541308",
                            "speaker": "派蒙",
                            "text": "哇，这算是认可我们的实力吗…但好像压力更大了呢。"
                        },
                        {
                            "id": "401541309",
                            "speaker": "派蒙",
                            "text": "要是考核没通过，就有点没面子了。"
                        },
                        {
                            "id": "401541310",
                            "speaker": "砂糖",
                            "text": "其实没关系的啦，很多事情都是要反复尝试的。"
                        },
                        {
                            "id": "401541311",
                            "speaker": "砂糖",
                            "text": "我刚开始当阿贝多先生的助手的时候，做实验也经常会出现意外状况呢…"
                        },
                        {
                            "id": "401541312",
                            "speaker": "砂糖",
                            "text": "研究冰雾花特性的时候，把实验室里的器材冻成了冰雕，精密仪器差点就坏掉了。"
                        },
                        {
                            "id": "401541313",
                            "speaker": "砂糖",
                            "text": "熬煮试剂的时间太久，珍贵的材料都被煮成了焦黑色的团块，路过的骑士闻到气味，还以为是实验室起火了…"
                        },
                        {
                            "id": "401541314",
                            "speaker": "砂糖",
                            "text": "那时候我还会因为实验的不顺利而感到自责，可是后来发现，想要追求未知，就会相应地承担失败的风险。"
                        },
                        {
                            "id": "401541315",
                            "speaker": "砂糖",
                            "text": "如果为了避免失误而畏手畏脚，就没有机会得到自己想要的结果了。"
                        },
                        {
                            "id": "401541316",
                            "speaker": "派蒙",
                            "text": "确实是这样呢！砂糖还挺会鼓舞人的嘛。"
                        },
                        {
                            "id": "401541317",
                            "speaker": "砂糖",
                            "text": "#呵呵，只是做研究的经验之谈而已。总之，{NICKNAME}只要放手尝试就好了。"
                        },
                        {
                            "id": "401541318",
                            "speaker": "砂糖",
                            "text": "准备好了的话，我们就开始高级考核吧？",
                            "choices": [
                                {
                                    "id": "401541319",
                                    "text": "查看考核要求。"
                                },
                                {
                                    "id": "401541320",
                                    "text": "再准备一下。",
                                    "response": [
                                        {
                                            "id": "401541321",
                                            "speaker": "砂糖",
                                            "text": "没关系，我会等你准备好的。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401541305",
                    "text": "我会努力的。"
                }
            ]
        }
    ]
}