    "speaker_counts": {
        "甘雨": 4,
        "申鹤": 4
    },
    "dialogues": [
        {
            "id": "401415301",
            "speaker": "申鹤",
            "text": "想不通…"
        },
        {
            "id": "401415302",
            "speaker": "甘雨",
            "text": "遇到麻烦了？申鹤你说就好。"
        },
        {
            "id": "401415303",
            "speaker": "申鹤",
            "text": "黑色耐脏，但香菱不愿我穿着这身在万民堂工作，说是不合适。"
        },
        {
            "id": "401415304",
            "speaker": "申鹤",
            "text": "不合适…在哪里呢？"
        },
        {
            "id": "401415305",
            "speaker": "甘雨",
            "text": "…应该说是场合和身份感不相符。"
        },
        {
            "id": "401415306",
            "speaker": "甘雨",
            "text": "如果申鹤是像今天这样，和朋友们一起享受海灯节，或是观赏夜景、参加重要宴会…就非常合适哦。"
        },
        {
            "id": "401415307",
            "speaker": "申鹤",
            "text": "是只能穿给重要之人看的意思，对吧？"
        },
        {
            "id": "401415308",
            "speaker": "甘雨",
            "text": "呃…这么想也可以吧。"
        }
    ]
}