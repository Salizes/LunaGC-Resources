{
    "talkId": "4007706",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 11,
        "枫原万叶": 17
    },
    "dialogues": [
        {
            "id": "400770601",
            "speaker": "枫原万叶",
            "text": "四周「自然」的声音安逸，可以放心了…",
            "choices": [
                {
                    "id": "400770602",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400770603",
                            "speaker": "枫原万叶",
                            "text": "好，你想到些什么了？",
                            "choices": [
                                {
                                    "id": "400770606",
                                    "text": "关于喝酒…",
                                    "response": [
                                        {
                                            "id": "400770607",
                                            "speaker": "枫原万叶",
                                            "text": "咳、咳咳…"
                                        },
                                        {
                                            "id": "400770608",
                                            "speaker": "枫原万叶",
                                            "text": "都已经过去了那么几天，原来你还没忘记啊。"
                                        },
                                        {
                                            "id": "400770609",
                                            "speaker": "枫原万叶",
                                            "text": "酒应是风雅之物，失态醉倒，实在让人难以启齿。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770610",
                                    "text": "关于过去…",
                                    "response": [
                                        {
                                            "id": "400770611",
                                            "speaker": "枫原万叶",
                                            "text": "是啊，这样一来，也算是与它正式告别了。"
                                        },
                                        {
                                            "id": "400770612",
                                            "speaker": "枫原万叶",
                                            "text": "放心，我和那时说的一样，既没有伤感低落，也不会留恋徘徊。"
                                        },
                                        {
                                            "id": "400770613",
                                            "speaker": "枫原万叶",
                                            "text": "我发自内心感激这机缘巧合。"
                                        },
                                        {
                                            "id": "400770614",
                                            "speaker": "Player",
                                            "text": "万叶总是那么豁达…"
                                        },
                                        {
                                            "id": "400770615",
                                            "speaker": "枫原万叶",
                                            "text": "谢谢你能这样说，我可以将它视为你对我的肯定吗？"
                                        },
                                        {
                                            "id": "400770616",
                                            "speaker": "Player",
                                            "text": "当然。"
                                        },
                                        {
                                            "id": "400770617",
                                            "speaker": "枫原万叶",
                                            "text": "能与你这样的良友相识真好。"
                                        },
                                        {
                                            "id": "400770618",
                                            "speaker": "枫原万叶",
                                            "text": "那就让我们重新回到眼前的风景中。在离开之前，再多看看这里的风和月吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770619",
                                    "text": "关于这次假期…",
                                    "response": [
                                        {
                                            "id": "400770620",
                                            "speaker": "枫原万叶",
                                            "text": "起伏跌宕，却也不虚此行。"
                                        },
                                        {
                                            "id": "400770621",
                                            "speaker": "枫原万叶",
                                            "text": "北斗大姐头和船员们要是问起来，我就讲讲船灵和松鼠吧…至于新朋友们的故事，还是留在各自心中。"
                                        },
                                        {
                                            "id": "400770622",
                                            "speaker": "Player",
                                            "text": "这样也好。"
                                        },
                                        {
                                            "id": "400770623",
                                            "speaker": "枫原万叶",
                                            "text": "#一段旅途的结束，也是下一次旅程的开始。{NICKNAME}，你对这一点是最有感受的吧。"
                                        },
                                        {
                                            "id": "400770624",
                                            "speaker": "枫原万叶",
                                            "text": "…只要走在路上就好。"
                                        },
                                        {
                                            "id": "400770625",
                                            "speaker": "枫原万叶",
                                            "text": "和你一样，我也对未来充满了期待。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770604",
                    "text": "先不打扰你了。",
                    "response": [
                        {
                            "id": "400770605",
                            "speaker": "枫原万叶",
                            "text": "这些日子你也多有操劳，好好休息。",
                            "choices": [
                                {
                                    "id": "400770606",
                                    "text": "关于喝酒…"
                                },
                                {
                                    "id": "400770610",
                                    "text": "关于过去…"
                                },
                                {
                                    "id": "400770619",
                                    "text": "关于这次假期…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}