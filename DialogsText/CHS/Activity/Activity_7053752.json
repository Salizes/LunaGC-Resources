{
    "talkId": "7053752",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 7,
        "黑尔佳": 21
    },
    "dialogues": [
        {
            "id": "705375201",
            "speaker": "黑尔佳",
            "text": "#您好，蒙德城的大英雄{NICKNAME}！我是「猎鹿人」的餐品派送员黑尔佳，有什么可以为您效劳的吗？",
            "choices": [
                {
                    "id": "705375202",
                    "text": "餐品派送员？",
                    "response": [
                        {
                            "id": "705375203",
                            "speaker": "黑尔佳",
                            "text": "就是专门为餐馆派送订单的人啦，是一种超简单但超快乐的职业哦！"
                        },
                        {
                            "id": "705375204",
                            "speaker": "黑尔佳",
                            "text": "有的顾客不想生火做饭，或者要在家里招待重要的客人时，会提前向餐馆下订单，餐馆就会派我们把餐品送到客人指定的地方。",
                            "choices": [
                                {
                                    "id": "705375205",
                                    "text": "听起来也不简单嘛…",
                                    "response": [
                                        {
                                            "id": "705375207",
                                            "speaker": "黑尔佳",
                                            "text": "咦？有这回事吗？我倒是挺开心的呀！"
                                        },
                                        {
                                            "id": "705375208",
                                            "speaker": "黑尔佳",
                                            "text": "不限时间和地点，让大家轻松地吃到喜欢的东西…我觉得，做了这样的事以后，我感觉很充实，很有成就感！"
                                        },
                                        {
                                            "id": "705375209",
                                            "speaker": "黑尔佳",
                                            "text": "几年前，我不小心摔断了腿，在家里养伤，几乎不能下床行动。"
                                        },
                                        {
                                            "id": "705375210",
                                            "speaker": "黑尔佳",
                                            "text": "平常家里都是靠我做饭的，我爸做的饭菜特别难吃，他自己都受不了，而且他每天回来得很晚，外边的店全关门了。"
                                        },
                                        {
                                            "id": "705375211",
                                            "speaker": "黑尔佳",
                                            "text": "那段时间，我和我爸都是靠派送员们送来的饭菜过日子的。听见派送员敲门的声音，我们就知道，横扫饥饿的时间到了！"
                                        },
                                        {
                                            "id": "705375212",
                                            "speaker": "黑尔佳",
                                            "text": "所以我养好了伤之后就入行了，励志成为最快最稳，最让顾客满意的餐品外送员！"
                                        },
                                        {
                                            "id": "705375213",
                                            "speaker": "黑尔佳",
                                            "text": "#听说以前有一位被称为「金色飞影」的派送员，无论订单的要求多苛刻，距离有多远，{M#他}{F#她}都能在最短时间内完成派送！"
                                        },
                                        {
                                            "id": "705375214",
                                            "speaker": "黑尔佳",
                                            "text": "只可惜，那位「金色飞影」只是餐馆从冒险家协会找来的临时帮手，干了没几天就走了，只留下一个最快速度的传说。"
                                        },
                                        {
                                            "id": "705375215",
                                            "speaker": "黑尔佳",
                                            "text": "#{M#他}{F#她}就是我努力的目标，我也要成为那种…提瓦特顶尖的餐品派送员！",
                                            "choices": [
                                                {
                                                    "id": "705375216",
                                                    "text": "哈哈哈哈！那你加油！",
                                                    "response": [
                                                        {
                                                            "id": "705375218",
                                                            "speaker": "黑尔佳",
                                                            "text": "谢谢你的鼓励，我现在充满了干劲！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "705375217",
                                                    "text": "有这回事？那你加油！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "705375206",
                                    "text": "重复工作也不快乐…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705375219",
                    "text": "你在这里干什么呢？",
                    "response": [
                        {
                            "id": "705375220",
                            "speaker": "黑尔佳",
                            "text": "是这样的——莎拉小姐说，「猎鹿人」接到了订单，每天都要在固定时间为火花骑士小姐提供餐品。"
                        },
                        {
                            "id": "705375221",
                            "speaker": "黑尔佳",
                            "text": "防止她因为重要任务忘了吃中饭。"
                        },
                        {
                            "id": "705375222",
                            "speaker": "黑尔佳",
                            "text": "看着火花骑士小姐无忧无虑地玩游戏…呃咳，执行重要任务，我也很开心！"
                        },
                        {
                            "id": "705375223",
                            "speaker": "黑尔佳",
                            "text": "相比之下，我的另一个同事就倒霉多了，她接到了一份订单，居然要把餐品送到<color=#00E1FFFF>明冠山地</color>的一座山崖附近去…"
                        },
                        {
                            "id": "705375224",
                            "speaker": "黑尔佳",
                            "text": "光是在蒙德城里送餐就有够累了，背着送餐的背包爬山涉水，我想都不敢想…"
                        },
                        {
                            "id": "705375225",
                            "speaker": "黑尔佳",
                            "text": "好在那位下单的客人是个大富商，会额外付一大笔送餐费…"
                        },
                        {
                            "id": "705375228",
                            "speaker": "黑尔佳",
                            "text": "不然，光是来回一趟花费的时间，都够她干上几十次活，赚几天工钱了。"
                        }
                    ]
                },
                {
                    "id": "705375226",
                    "text": "不劳烦你，再见！",
                    "response": [
                        {
                            "id": "705375227",
                            "speaker": "黑尔佳",
                            "text": "那两位慢走。有空的时候请来「猎鹿人」坐坐，享受美味大餐！"
                        }
                    ]
                }
            ]
        }
    ]
}