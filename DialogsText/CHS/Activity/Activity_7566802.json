                {
                    "id": "756680202",
                    "text": "来一杯！",
                    "response": [
                        {
                            "id": "756680203",
                            "speaker": "阿维苏菈",
                            "text": "没问题！拿上这杯，和我们一起跳舞，尽情享受音乐吧！"
                        }
                    ]
                },
                {
                    "id": "756680204",
                    "text": "还，还是不了…",
                    "response": [
                        {
                            "id": "756680205",
                            "speaker": "阿维苏菈",
                            "text": "哎，行吧。你要是想喝，随时回来找我。可要早点来，不然饮料说不定都要被喝光了。"
                        }
                    ]
                }
            ]
        }
