{
    "talkId": "7053904",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 9,
        "派蒙": 6,
        "罗莎莉亚": 18
    },
    "dialogues": [
        {
            "id": "705390401",
            "speaker": "罗莎莉亚",
            "text": "嗯？怎么不和猫猫们玩，过来找我了？是有外卖订单需要我跑腿吗？",
            "choices": [
                {
                    "id": "705390402",
                    "text": "这份差事感觉如何？",
                    "response": [
                        {
                            "id": "705390403",
                            "speaker": "派蒙",
                            "text": "罗莎莉亚好像不怎么和猫猫们玩呢，那会不会有点…无聊？"
                        },
                        {
                            "id": "705390404",
                            "speaker": "罗莎莉亚",
                            "text": "还行吧，无聊和有趣是相对的。"
                        },
                        {
                            "id": "705390405",
                            "speaker": "罗莎莉亚",
                            "text": "在这里工作，不会有什么重量级的事件或事故发生，平平淡淡而已，和待在教会里没什么不同…"
                        },
                        {
                            "id": "705390406",
                            "speaker": "罗莎莉亚",
                            "text": "嗯…有一些不同之处。"
                        },
                        {
                            "id": "705390407",
                            "speaker": "罗莎莉亚",
                            "text": "有些猫很聪明，能理解我的用意，偶尔和它们互动一下，算得上有趣。"
                        },
                        {
                            "id": "705390408",
                            "speaker": "罗莎莉亚",
                            "text": "虽说瓦乐瑞娜和维多利亚很像，总能给我找来许多活儿…但她们做事的风格有着不小的差别。"
                        },
                        {
                            "id": "705390409",
                            "speaker": "罗莎莉亚",
                            "text": "总归给我带来了一些新鲜感吧，我已经有段时间没找到过这种新鲜感了，还不错。"
                        },
                        {
                            "id": "705390410",
                            "speaker": "派蒙",
                            "text": "感觉不错，那就说明是好事！"
                        },
                        {
                            "id": "705390411",
                            "speaker": "派蒙",
                            "text": "我感觉你和瓦乐瑞娜，还有这里的每只猫猫，其实都挺合得来！",
                            "choices": [
                                {
                                    "id": "705390412",
                                    "text": "你们其实有一种默契。",
                                    "response": [
                                        {
                                            "id": "705390414",
                                            "speaker": "罗莎莉亚",
                                            "text": "谢谢，但愿一直如此。"
                                        }
                                    ]
                                },
                                {
                                    "id": "705390413",
                                    "text": "你们会是很好的搭档。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705390415",
                    "text": "罗莎莉亚最喜欢哪只猫？",
                    "response": [
                        {
                            "id": "705390416",
                            "speaker": "派蒙",
                            "text": "我也很好奇哦！罗莎莉亚有过特别想亲近，或者想好好照顾的猫猫吗？"
                        },
                        {
                            "id": "705390417",
                            "speaker": "罗莎莉亚",
                            "text": "问得有点突然，不过符合正常人的好奇心。"
                        },
                        {
                            "id": "705390418",
                            "speaker": "罗莎莉亚",
                            "text": "我的答案是：没有。"
                        },
                        {
                            "id": "705390419",
                            "speaker": "派蒙",
                            "text": "欸？好果断！",
                            "choices": [
                                {
                                    "id": "705390420",
                                    "text": "有点意外…",
                                    "response": [
                                        {
                                            "id": "705390422",
                                            "speaker": "罗莎莉亚",
                                            "text": "对于不同的人，「喜欢」这个词的分量可不一样。"
                                        },
                                        {
                                            "id": "705390423",
                                            "speaker": "罗莎莉亚",
                                            "text": "对我来说，现在暂且还没什么生灵或物体的分量配得上这个词。当然，「讨厌」也差不多。"
                                        },
                                        {
                                            "id": "705390424",
                                            "speaker": "罗莎莉亚",
                                            "text": "我愿意照顾这些猫儿，为它们花费时间，只是因为工作…"
                                        },
                                        {
                                            "id": "705390425",
                                            "speaker": "罗莎莉亚",
                                            "text": "或者说，一个问题摆在了我的眼前，而我不用付出太多精力，就能改善情况，那就动手吧。"
                                        },
                                        {
                                            "id": "705390426",
                                            "speaker": "罗莎莉亚",
                                            "text": "现在这份差事已经带给了我一些微小的…惊喜，不错了。"
                                        },
                                        {
                                            "id": "705390427",
                                            "speaker": "派蒙",
                                            "text": "有，有点没听懂，不过感觉罗莎莉亚的情绪…应该是正面的！",
                                            "choices": [
                                                {
                                                    "id": "705390428",
                                                    "text": "没事，我也没太搞明白。",
                                                    "response": [
                                                        {
                                                            "id": "705390430",
                                                            "speaker": "罗莎莉亚",
                                                            "text": "别想太多，嗯，很多时候，生活就是没什么波澜的，习惯就好。"
                                                        },
                                                        {
                                                            "id": "705390431",
                                                            "speaker": "罗莎莉亚",
                                                            "text": "不习惯的话…以你们的能力，当然也可以改变你们所见的一切，祝顺利。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "705390429",
                                                    "text": "没事，我理解罗莎莉亚。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "705390421",
                                    "text": "不出所料…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705390432",
                    "text": "不打扰了…",
                    "response": [
                        {
                            "id": "705390433",
                            "speaker": "罗莎莉亚",
                            "text": "没关系，有事再找我吧。"
                        }
                    ]
                }
            ]
        }
    ]
}