{
    "talkId": "4019710",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 4,
        "派蒙": 4,
        "瓦雷莎": 10
    },
    "dialogues": [
        {
            "id": "401971001",
            "speaker": "瓦雷莎",
            "text": "老板你好！我是「沃陆之邦」来的，之前我们写信到你这里，委托设计了一些部件…"
        },
        {
            "id": "401971002",
            "speaker": "派蒙",
            "text": "说起来，为什么伊安珊需要发条机关呢？",
            "choices": [
                {
                    "id": "401971003",
                    "text": "难道要造机械哑铃人…",
                    "response": [
                        {
                            "id": "401971005",
                            "speaker": "瓦雷莎",
                            "text": "没有那么夸张啦，伊安珊老师只是想把健身器材再细分一下，方便锻炼不同位置的肌肉。"
                        },
                        {
                            "id": "401971006",
                            "speaker": "瓦雷莎",
                            "text": "她说，用什么「划船机」，可以重点锻炼背部，还有什么「蝴蝶机」和「蹬腿机」…"
                        },
                        {
                            "id": "401971007",
                            "speaker": "瓦雷莎",
                            "text": "连接拉绳和杠铃片的部件很容易损耗，又需要做得很结实，伊安珊老师就想试试枫丹的发条机关。"
                        },
                        {
                            "id": "401971008",
                            "speaker": "派蒙",
                            "text": "好高深，怎么感觉健身锻炼也和高深的工程问题有关了！"
                        },
                        {
                            "id": "401971009",
                            "speaker": "瓦雷莎",
                            "text": "欸嘿嘿，其实我也不太懂细节啦，如果伊安珊老师成功了，我就按她修改后的方法认真练！"
                        },
                        {
                            "id": "401971010",
                            "speaker": "瓦雷莎",
                            "text": "如果这次尝试不成功，我们以前的办法也不差的！"
                        },
                        {
                            "id": "401971011",
                            "speaker": "瓦雷莎",
                            "text": "下次你来「沃陆之邦」的时候，如果你有兴趣，我就带你试试几个入门练习？"
                        },
                        {
                            "id": "401971012",
                            "speaker": "瓦雷莎",
                            "text": "你肯定能轻轻松松拿下破纪录的重量！",
                            "choices": [
                                {
                                    "id": "401971013",
                                    "text": "好，那我就来施展一下力量！",
                                    "response": [
                                        {
                                            "id": "401971015",
                                            "speaker": "派蒙",
                                            "text": "我，我就算了！我可以在旁边给你们加油！"
                                        },
                                        {
                                            "id": "401971016",
                                            "speaker": "瓦雷莎",
                                            "text": "派蒙可以在旁边试试小龙的器材嘛，从小重量组练起，不怕上手难！"
                                        },
                                        {
                                            "id": "401971017",
                                            "speaker": "瓦雷莎",
                                            "text": "好好锻炼，人人有份，只要多用心，常坚持，大家都能拥有岩石般结实的肌肉！"
                                        },
                                        {
                                            "id": "401971018",
                                            "speaker": "派蒙",
                                            "text": "噫！"
                                        },
                                        {
                                            "id": "401971019",
                                            "speaker": "Black Screen",
                                            "text": "陪瓦雷莎一边闲聊健身的话题，一边在利奥奈区悠悠哉哉玩了几圈，相约过段时间回到「海薇玛映影欢乐城」碰头…"
                                        }
                                    ]
                                },
                                {
                                    "id": "401971014",
                                    "text": "应该不至于，我更靠巧劲！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401971004",
                    "text": "来鞭笞偷懒的学员？"
                }
            ]
        }
    ]
}