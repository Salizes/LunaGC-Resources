{
    "talkId": "7650808",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 5,
        "主角": 1,
        "妮露": 24
    },
    "dialogues": [
        {
            "id": "765080801",
            "speaker": "妮露",
            "text": "没想到，上次见面后不久，我又在异国他乡相遇了…我现在特别安心，非常开心！",
            "choices": [
                {
                    "id": "765080802",
                    "text": "我也特别开心！",
                    "response": [
                        {
                            "id": "765080803",
                            "speaker": "妮露",
                            "text": "这次出行真是无比正确的决定…"
                        },
                        {
                            "id": "765080804",
                            "speaker": "妮露",
                            "text": "之前，小吉祥草王大人刚刚离开祖拜尔剧场，塔拉内小姐就带着一车礼物找了过来，说明了「舞术交流」的事。"
                        },
                        {
                            "id": "765080805",
                            "speaker": "妮露",
                            "text": "得知目的地是纳塔后，我还有点紧张。因为听说纳塔的人们都热衷于提升战斗技巧，我担心遇见非常暴躁的人。"
                        },
                        {
                            "id": "765080806",
                            "speaker": "妮露",
                            "text": "没想到，完全不是那回事。纳塔朋友们并不是痴迷战斗，走火入魔，更像…充满活力地锻炼自我，提升本领。"
                        },
                        {
                            "id": "765080807",
                            "speaker": "妮露",
                            "text": "努斯妲小姐的团队更是活力满满，快乐无限。多亏他们几位，我认识了好几位可爱的龙龙朋友！"
                        },
                        {
                            "id": "765080808",
                            "speaker": "妮露",
                            "text": "每个部族的小龙都很有特色，颜色漂漂亮亮，叫声也都软软的，光是和这些小龙互动，不知不觉，一天就过去了…"
                        },
                        {
                            "id": "765080809",
                            "speaker": "主角",
                            "text": "妮露最喜欢哪种小龙？"
                        },
                        {
                            "id": "765080810",
                            "speaker": "妮露",
                            "text": "大家都很可爱，暂时还没有更喜欢哪种一些…"
                        },
                        {
                            "id": "765080811",
                            "speaker": "妮露",
                            "text": "小匿叶龙和小暝视龙都对须弥蔷薇的香气很感兴趣，被我的香粉吸引，第一次见到我的时候，好奇地围着我打转…"
                        },
                        {
                            "id": "765080812",
                            "speaker": "妮露",
                            "text": "小突角龙和小绒翼龙意外地喜欢我们带来的枣椰蜜糖，吃饱后，就会在我们的篝火边睡下，偶尔还会小声打呼噜呢。"
                        },
                        {
                            "id": "765080813",
                            "speaker": "妮露",
                            "text": "小鳍游龙们都非常听玛拉妮的话，有的还会乖巧地洗好小爪子，帮塔拉内小姐她们洗衣服…"
                        },
                        {
                            "id": "765080814",
                            "speaker": "妮露",
                            "text": "哦，还有一只小嵴锋龙，她对跳舞的节拍相当感兴趣。听说，是「回声之子」那边的舞台常客。"
                        },
                        {
                            "id": "765080815",
                            "speaker": "妮露",
                            "text": "希望，经过你的指导，那只小龙能完全掌握跳舞的关键技巧。",
                            "choices": [
                                {
                                    "id": "765080816",
                                    "text": "我有把握！",
                                    "response": [
                                        {
                                            "id": "765080818",
                                            "speaker": "妮露",
                                            "text": "加油哦！但也请注意保存精力，别玩得太累，而是最好要轻松休闲。"
                                        }
                                    ]
                                },
                                {
                                    "id": "765080817",
                                    "text": "我努努力！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "765080819",
                    "text": "和玛拉妮玩得尽兴吗？",
                    "response": [
                        {
                            "id": "765080820",
                            "speaker": "妮露",
                            "text": "嗯！感觉有种…释放自我的活力感？好奇妙…"
                        },
                        {
                            "id": "765080821",
                            "speaker": "妮露",
                            "text": "虽然是第一次见到玛拉妮，但居然，完全没有刚认识时的生疏？一切都非常自然。"
                        },
                        {
                            "id": "765080822",
                            "speaker": "妮露",
                            "text": "塔拉内小姐说，我们两个在一起交谈的时候，简直就像失散多年的姐妹。"
                        },
                        {
                            "id": "765080823",
                            "speaker": "妮露",
                            "text": "我觉得这个比喻有点夸张了，说是从小就在一起长大的好朋友，应该更合适？"
                        },
                        {
                            "id": "765080824",
                            "speaker": "妮露",
                            "text": "有的时候，我面对纳塔完全陌生的事物，多少会有点紧张，不敢接近。"
                        },
                        {
                            "id": "765080825",
                            "speaker": "妮露",
                            "text": "比如，刚开始见到成年的龙时，我会下意识放慢呼吸，观察那些龙有没有敌意…"
                        },
                        {
                            "id": "765080826",
                            "speaker": "妮露",
                            "text": "在玛拉妮的帮助下，我才大胆和龙伙伴们接触，尝试别的本地特色活动，慢慢体会到了纳塔朋友们生活中的乐趣…"
                        },
                        {
                            "id": "765080827",
                            "speaker": "妮露",
                            "text": "她对新事物的接受能力，还有主动寻找不同乐趣的态度，让我也感觉，受到了鼓舞…"
                        },
                        {
                            "id": "765080828",
                            "speaker": "妮露",
                            "text": "好像，沐浴在午后的阳光下，身体和精神都暖洋洋的…"
                        }
                    ]
                },
                {
                    "id": "765080829",
                    "text": "有舞蹈问题的话，还要请教你！",
                    "response": [
                        {
                            "id": "765080830",
                            "speaker": "妮露",
                            "text": "好呀，这段时间，我随时在这里等着你。"
                        }
                    ]
                }
            ]
        }
    ]
}