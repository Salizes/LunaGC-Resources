{
    "talkId": "4013526",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "千织": 9
    },
    "dialogues": [
        {
            "id": "401352601",
            "speaker": "千织",
            "text": "是你们，有什么事吗？",
            "choices": [
                {
                    "id": "401352602",
                    "text": "关于「千织屋」…",
                    "response": [
                        {
                            "id": "401352603",
                            "speaker": "千织",
                            "text": "想要定制服务吗？随时欢迎。"
                        },
                        {
                            "id": "401352606",
                            "speaker": "Player",
                            "text": "我们也没做什么…"
                        },
                        {
                            "id": "401352607",
                            "speaker": "千织",
                            "text": "别那么谦虚，你帮了泽维尔、帮了夏沃蕾、绮良良也说她之前受你们照顾…他们都是我朋友。"
                        },
                        {
                            "id": "401352608",
                            "speaker": "千织",
                            "text": "托你们的福，映影也如期上映，我的品牌能被更多人看到。"
                        },
                        {
                            "id": "401352609",
                            "speaker": "千织",
                            "text": "你们所做的，远比你们所认为的多。"
                        }
                    ]
                },
                {
                    "id": "401352610",
                    "text": "关于千织的工作…",
                    "response": [
                        {
                            "id": "401352611",
                            "speaker": "千织",
                            "text": "我就是个服装设计师而已，没什么奇怪的副业。"
                        },
                        {
                            "id": "401352612",
                            "speaker": "千织",
                            "text": "只不过做生意的缘故，结交的朋友越来越多，遇到的破事也越来越多。"
                        },
                        {
                            "id": "401352613",
                            "speaker": "千织",
                            "text": "你帮我一个忙，我帮你一个忙…今天你照顾我，明天我照顾你…这就是生意。"
                        }
                    ]
                },
                {
                    "id": "401352614",
                    "text": "没什么事了…",
                    "response": [
                        {
                            "id": "401352615",
                            "speaker": "千织",
                            "text": "嗯，回头见。"
                        }
                    ]
                }
            ]
        }
    ]
}