    "dialogues": [
        {
            "id": "401577901",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想邀请你去参加音乐庆典。</color>"
        },
        {
            "id": "401577902",
            "speaker": "葵",
            "text": "真稀奇，从来没人请过我去参加音乐庆典。"
        },
        {
            "id": "401577903",
            "speaker": "派蒙",
            "text": "所以我们就来了！嘿嘿。"
        },
        {
            "id": "401577904",
            "speaker": "派蒙",
            "text": "葵小姐一定也有喜欢的音乐吧，我们现在可以弹给你听哦。我们是认真的音乐交流。"
        },
        {
            "id": "401577905",
            "speaker": "葵",
            "text": "音乐吗？嗯…倒是有一首很久很久以前的曲子，那时候我应该才跟你差不多高吧。"
        },
        {
            "id": "401577906",
            "speaker": "葵",
            "text": "我只能记得一些旋律了，可以弹给我听听看吗？"
        },
        {
            "id": "401577907",
            "speaker": "Player",
            "text": "我来试试。"
        },
        {
            "id": "401577908",
            "speaker": "葵",
            "text": "谢谢。"
        }
    ]
}