{
    "talkId": "4018923",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "玛因": 11
    },
    "dialogues": [
        {
            "id": "401892301",
            "speaker": "玛因",
            "text": "啊，老板好，我在努力工作哦！你也多给我点工钱吧？这样，我就可以给爱贝尔买更多礼物了。",
            "choices": [
                {
                    "id": "401892302",
                    "text": "爱贝尔？",
                    "response": [
                        {
                            "id": "401892303",
                            "speaker": "玛因",
                            "text": "就是克莱门汀线巡轨船的那位导游啦，以前我们是同事。"
                        },
                        {
                            "id": "401892304",
                            "speaker": "玛因",
                            "text": "后来不知道为什么，她被调走了。她走前还帮我把很多活干了，我一直想找个机会感谢她。"
                        },
                        {
                            "id": "401892305",
                            "speaker": "玛因",
                            "text": "结果每天都忙个没停，转眼就过去了好久好久。最近我第一次休假，出来散散心。"
                        },
                        {
                            "id": "401892306",
                            "speaker": "玛因",
                            "text": "本来想叫上爱贝尔一起，结果她又说，「最近有大型活动，正是需要迎接游客的时候」，婉拒了我的邀请…"
                        },
                        {
                            "id": "401892307",
                            "speaker": "玛因",
                            "text": "所以还是给她买些礼物好了！"
                        }
                    ]
                },
                {
                    "id": "401892308",
                    "text": "为什么不是欧菲妮？",
                    "response": [
                        {
                            "id": "401892309",
                            "speaker": "玛因",
                            "text": "欧菲妮？你也认识「绯红幻影」？"
                        },
                        {
                            "id": "401892310",
                            "speaker": "玛因",
                            "text": "说实话，以前我不太喜欢她，因为她把最有价值的任务都干完了，显得我很呆。"
                        },
                        {
                            "id": "401892311",
                            "speaker": "玛因",
                            "text": "射击和格斗科目…咳咳…我是说，几项主要的工作技能，她的考核成绩都接近满分。"
                        },
                        {
                            "id": "401892312",
                            "speaker": "玛因",
                            "text": "这种厉害人物，每逢假期，应该收礼物收到手软才对，当然不需要我帮忙带礼物…"
                        }
                    ]
                },
                {
                    "id": "401892313",
                    "text": "那你加油干。",
                    "response": [
                        {
                            "id": "401892314",
                            "speaker": "玛因",
                            "text": "好喔，我会拿出登舰作战…咳，拿出在海上打工的干劲！"
                        }
                    ]
                }
            ]
        }
    ]
}