{
    "talkId": "7069403",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Player": 9,
        "宵宫": 30
    },
    "dialogues": [
        {
            "id": "706940301",
            "speaker": "宵宫",
            "text": "#{NICKNAME}，一看见你，我就觉得快乐加倍，这次蒙德之行可真是太值了！",
            "choices": [
                {
                    "id": "706940302",
                    "text": "要不要加件外套？",
                    "response": [
                        {
                            "id": "706940303",
                            "speaker": "宵宫",
                            "text": "啊呀，没事没事！冷归冷，也只是新奇而已，还不至于把自己包裹起来！"
                        },
                        {
                            "id": "706940304",
                            "speaker": "宵宫",
                            "text": "用认真一点的说法，前不久，我还在用烟花炸魔物，现在浑身热腾腾的呢。"
                        },
                        {
                            "id": "706940305",
                            "speaker": "宵宫",
                            "text": "附近也有篝火，真感觉冷的话，随时随地都能取暖，完全不用担心我！"
                        },
                        {
                            "id": "706940306",
                            "speaker": "宵宫",
                            "text": "用有趣一点的说法，这么多漫画同好聚在一起，会场里的气氛高涨，我的热血也被唤醒啦！"
                        },
                        {
                            "id": "706940307",
                            "speaker": "宵宫",
                            "text": "你也没有披上厚厚的棉袄嘛，要相信你的好伙伴，身板没那么弱！"
                        }
                    ]
                },
                {
                    "id": "706940308",
                    "text": "宵宫这次是专程看比赛的？",
                    "response": [
                        {
                            "id": "706940309",
                            "speaker": "宵宫",
                            "text": "啊哈，其实看比赛是顺路的，这回我来蒙德，有个认真的目标哦——"
                        },
                        {
                            "id": "706940310",
                            "speaker": "宵宫",
                            "text": "最近半年，我一直在寻找烟花的新材料，试试能不能打造出更有灵气的爆炸效果。"
                        },
                        {
                            "id": "706940311",
                            "speaker": "宵宫",
                            "text": "大部分稻妻常见的材料，我都试过了，有些材料的效果很不错，比如轻飘飘的绯樱绣球，和家家户户都有的堇瓜皮。"
                        },
                        {
                            "id": "706940312",
                            "speaker": "宵宫",
                            "text": "把这两种材料浸泡在染料里一段时间，风干后，薄薄地刷上加了塑形剂的火药，做成子烟花…"
                        },
                        {
                            "id": "706940313",
                            "speaker": "宵宫",
                            "text": "再仔细雕刻这些子烟花，调整它们的重量，按照特别的排布装进筒里…"
                        },
                        {
                            "id": "706940314",
                            "speaker": "宵宫",
                            "text": "它们被爆炸的力量推散开来后，就能按我想要的轨迹，在夜空里画出更细致的图案，甚至是一整副画卷！",
                            "choices": [
                                {
                                    "id": "706940315",
                                    "text": "听起来要仔细地算数…",
                                    "response": [
                                        {
                                            "id": "706940317",
                                            "speaker": "宵宫",
                                            "text": "也不至于啦！只要多尝试，不怕失败，跟着加工时最棒的手感走，总能做出想要的款式！"
                                        },
                                        {
                                            "id": "706940318",
                                            "speaker": "宵宫",
                                            "text": "根据这个道理，我想，如果想要延长烟花画卷展现的时间，那就需要给火药找一种轻巧的载体。"
                                        },
                                        {
                                            "id": "706940319",
                                            "speaker": "宵宫",
                                            "text": "什么样的载体，才能乘着夜风，一直徘徊在天空中呢？",
                                            "choices": [
                                                {
                                                    "id": "706940320",
                                                    "text": "第一时间想到了…蒲公英？",
                                                    "response": [
                                                        {
                                                            "id": "706940322",
                                                            "speaker": "宵宫",
                                                            "text": "答对啦！我们的点子完全一致！"
                                                        },
                                                        {
                                                            "id": "706940323",
                                                            "speaker": "宵宫",
                                                            "text": "正好，这边也举办了越野赛，船票都有折扣呢！趁着热闹的时候来一趟，我也算是一边玩，一边干正事啦。"
                                                        },
                                                        {
                                                            "id": "706940324",
                                                            "speaker": "宵宫",
                                                            "text": "刚到蒙德不久，我就收集了许多新鲜的蒲公英，把它们好好保存起来，大功告成！"
                                                        },
                                                        {
                                                            "id": "706940325",
                                                            "speaker": "宵宫",
                                                            "text": "不过，新鲜的蒲公英比我印象中更轻盈，也更脆弱，加工起来，需要相当精细的手法才行…这也是对我的一次考验！"
                                                        },
                                                        {
                                                            "id": "706940326",
                                                            "speaker": "宵宫",
                                                            "text": "等我做出了图案更漂亮，燃烧时间更长的烟花，第一个请你观赏！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "706940321",
                                                    "text": "风之国蒙德的特色植物？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "706940316",
                                    "text": "感觉变成了工程问题…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706940327",
                    "text": "对蒙德的感觉如何？",
                    "response": [
                        {
                            "id": "706940328",
                            "speaker": "宵宫",
                            "text": "我想想…这次我游览的节奏很慢，感觉在蒙德，随时随地都能睡着。"
                        },
                        {
                            "id": "706940329",
                            "speaker": "宵宫",
                            "text": "哦，是绝对好评的意思！要知道，人有心事的时候，容易睡不着，周围的人都在忙碌的时候，更不可能放松下来。"
                        },
                        {
                            "id": "706940330",
                            "speaker": "宵宫",
                            "text": "蒙德的这种松弛感，就像每分每秒都处于假期之中。难怪蒙德的人们都这么精神饱满，积极乐观！"
                        },
                        {
                            "id": "706940331",
                            "speaker": "宵宫",
                            "text": "可莉妹妹告诉我，蒙德最盛大的节日是风花节，要我说，这么闲适的氛围，还可以多来些庆典和活动嘛。"
                        },
                        {
                            "id": "706940332",
                            "speaker": "宵宫",
                            "text": "到时候，我们家也可以多给蒙德提供一些特色的烟花！"
                        }
                    ]
                },
                {
                    "id": "706940333",
                    "text": "有认识新朋友吗？",
                    "response": [
                        {
                            "id": "706940334",
                            "speaker": "宵宫",
                            "text": "有哦有哦！我还是头一回和年纪差不多的纳塔人一起玩呢！比如「邦邦滚石」小姐的老板瓦雷莎，听说她是超厉害的摔跤手！"
                        },
                        {
                            "id": "706940335",
                            "speaker": "宵宫",
                            "text": "和瓦雷莎一起吃饭的时候，我发现她非常好相处，说话慢慢的，柔柔的…完全想象不出来她和别人格斗时的样子。"
                        },
                        {
                            "id": "706940336",
                            "speaker": "宵宫",
                            "text": "不过，这次她是来见笔友的，忙得不行呢！我们没有聊太多，先混个脸熟。"
                        },
                        {
                            "id": "706940337",
                            "speaker": "宵宫",
                            "text": "大家都是漫画同好，以后稻妻举办相关的活动时，相信还能和她们再见面的！"
                        }
                    ]
                },
                {
                    "id": "706940338",
                    "text": "稍后再来聊聊天！",
                    "response": [
                        {
                            "id": "706940339",
                            "speaker": "宵宫",
                            "text": "好啊好啊，你先去忙吧，蒙德、纳塔和稻妻的大家都需要你！"
                        }
                    ]
                }
            ]
        }
    ]
}