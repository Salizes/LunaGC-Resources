{
    "talkId": "7069104",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 11,
        "早柚": 25
    },
    "dialogues": [
        {
            "id": "706910401",
            "speaker": "早柚",
            "text": "#呼啊…{NICKNAME}，你可真有精神，难道一直不用休息的嘛？",
            "choices": [
                {
                    "id": "706910402",
                    "text": "早柚的雪山之旅愉快吗？",
                    "response": [
                        {
                            "id": "706910403",
                            "speaker": "早柚",
                            "text": "唔…如果不算堇葵的训练科目，这次的工作还挺轻松的。"
                        },
                        {
                            "id": "706910404",
                            "speaker": "早柚",
                            "text": "忘记告诉你了，堇葵是新上任的目付。这次「终末番」来雪山出差，她算是领队，盯我盯得比巫女姐姐还严…"
                        },
                        {
                            "id": "706910405",
                            "speaker": "早柚",
                            "text": "之前，他们派人参加了一个什么推演，出来见了见世面…"
                        },
                        {
                            "id": "706910406",
                            "speaker": "早柚",
                            "text": "那个叫玄理的代行带回了一堆报告，得到了大人物的支持，然后到处联络旗本，推行新的训练办法，连「终末番」也逃不了…"
                        },
                        {
                            "id": "706910407",
                            "speaker": "早柚",
                            "text": "具体的细节我不明白…但，呜呼流也不是适合正面战斗的流派！一直抓着我，让我努力根本没用嘛…"
                        },
                        {
                            "id": "706910408",
                            "speaker": "早柚",
                            "text": "最多，让我教教他们的新忍犬，那只咕咕丸，怎么样才能藏得更好，随时随地睡大觉。",
                            "choices": [
                                {
                                    "id": "706910409",
                                    "text": "原来是被要求加训了…",
                                    "response": [
                                        {
                                            "id": "706910411",
                                            "speaker": "早柚",
                                            "text": "这要多谢可莉和瑶瑶…"
                                        },
                                        {
                                            "id": "706910412",
                                            "speaker": "早柚",
                                            "text": "我们刚到蒙德，在骑士团办手续的时候，可莉被我衣服上的尾巴吸引，好奇地问了我好多问题…"
                                        },
                                        {
                                            "id": "706910413",
                                            "speaker": "早柚",
                                            "text": "然后，她就邀请我一起来到这个营地，找到了瑶瑶。玩了两盘捉迷藏以后，我们算是交上朋友了。"
                                        },
                                        {
                                            "id": "706910414",
                                            "speaker": "早柚",
                                            "text": "可莉居然有个专门的称号「火花骑士」…听起来，好像还蛮威风的？"
                                        },
                                        {
                                            "id": "706910415",
                                            "speaker": "早柚",
                                            "text": "情报说，骑士团里有专门称号的都是队长级的大人物，甚至，他们的团长姐姐都只是「狮牙骑士」，听起来…半斤八两的样子？"
                                        },
                                        {
                                            "id": "706910416",
                                            "speaker": "早柚",
                                            "text": "所以，在骑士团里，可莉应该和团长差不多厉害，说话一样有分量！",
                                            "choices": [
                                                {
                                                    "id": "706910417",
                                                    "text": "这…对…对吗？",
                                                    "response": [
                                                        {
                                                            "id": "706910419",
                                                            "speaker": "早柚",
                                                            "text": "总之，堇葵是这么想的，她对可莉很尊敬！可莉说要和我玩，堇葵就不敢来叫我去训练了！"
                                                        },
                                                        {
                                                            "id": "706910420",
                                                            "speaker": "早柚",
                                                            "text": "和可莉、瑶瑶待在一起的时候，我感觉非常自在。"
                                                        },
                                                        {
                                                            "id": "706910421",
                                                            "speaker": "早柚",
                                                            "text": "虽然总是被误会成她们的同龄人，但也能拿到更多零食和礼物，有种不一样的开心…"
                                                        },
                                                        {
                                                            "id": "706910422",
                                                            "speaker": "早柚",
                                                            "text": "要是不用坐那么久的船，我每天也能睡个饱的话…说不定，我会经常来找可莉？"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "706910418",
                                                    "text": "这…没…没错！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "706910410",
                                    "text": "但你现在好像不忙哦？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706910423",
                    "text": "早柚还对蒙德的什么感兴趣？",
                    "response": [
                        {
                            "id": "706910424",
                            "speaker": "早柚",
                            "text": "果酒湖里的…鲈鱼！",
                            "choices": [
                                {
                                    "id": "706910425",
                                    "text": "欸？有点意外…",
                                    "response": [
                                        {
                                            "id": "706910427",
                                            "speaker": "早柚",
                                            "text": "嗯…可莉给我看过她妈妈的画片，好高好高…"
                                        },
                                        {
                                            "id": "706910428",
                                            "speaker": "早柚",
                                            "text": "孩子的身高，一般不会输给爸爸妈妈，所以可莉以后也能长到那种个头！"
                                        },
                                        {
                                            "id": "706910429",
                                            "speaker": "早柚",
                                            "text": "可莉说过，她喜欢吃果酒湖里现炸的鲈鱼，她的妈妈也觉得鲈鱼好，说明果酒湖的鲈鱼吃了对身体棒，长个子！",
                                            "choices": [
                                                {
                                                    "id": "706910430",
                                                    "text": "这好办，我给你捣鼓两条…",
                                                    "response": [
                                                        {
                                                            "id": "706910432",
                                                            "speaker": "早柚",
                                                            "text": "真的吗？感觉，不用这么麻烦你！"
                                                        },
                                                        {
                                                            "id": "706910433",
                                                            "speaker": "早柚",
                                                            "text": "仔细一想，买当天打捞上来的鱼，做成这里特色的烤鱼，应该也差不多？反正炸上来的鱼，也是要仔细烹饪后才能吃的…"
                                                        },
                                                        {
                                                            "id": "706910434",
                                                            "speaker": "早柚",
                                                            "text": "我先自己试试看好了！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "706910431",
                                                    "text": "我也略懂「可莉炸鱼法」…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "706910426",
                                    "text": "难道是因为可莉的口味？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706910435",
                    "text": "你说得对，我也去休息一下…",
                    "response": [
                        {
                            "id": "706910436",
                            "speaker": "早柚",
                            "text": "嗯，虽然你已经不用长身体的样子，但多睡睡，总没错！"
                        }
                    ]
                }
            ]
        }
    ]
}