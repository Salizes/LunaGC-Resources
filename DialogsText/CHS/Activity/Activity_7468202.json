{
    "talkId": "7468202",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "兰吉特": 11
    },
    "dialogues": [
        {
            "id": "746820201",
            "speaker": "兰吉特",
            "text": "现在出发吗？",
            "choices": [
                {
                    "id": "746820202",
                    "text": "走吧。"
                },
                {
                    "id": "746820203",
                    "text": "关于能飞的伙伴…",
                    "response": [
                        {
                            "id": "746820204",
                            "speaker": "兰吉特",
                            "text": "之前提到的昆图尔的故事，他的伙伴暝视龙就是能飞得很高的龙。"
                        },
                        {
                            "id": "746820205",
                            "speaker": "兰吉特",
                            "text": "不如说，如果没有暝视龙伙伴的帮助，他恐怕也很难成功吧。"
                        },
                        {
                            "id": "746820206",
                            "speaker": "兰吉特",
                            "text": "有个能飞的伙伴真不错啊…仔细想想，你的伙伴也是能飞的，怎么样，她有什么拿手的技能之类的吗？"
                        },
                        {
                            "id": "746820207",
                            "speaker": "Player",
                            "text": "她能让很多食物瞬间消失。"
                        },
                        {
                            "id": "746820208",
                            "speaker": "兰吉特",
                            "text": "哇，是厨子听了会开心的技能。"
                        },
                        {
                            "id": "746820209",
                            "speaker": "兰吉特",
                            "text": "下次也让我给她做点好吃的吧。说起我的手艺，纳塔朋友都建议我留在纳塔做龙饭厨子，肯定大受欢迎。"
                        },
                        {
                            "id": "746820210",
                            "speaker": "兰吉特",
                            "text": "你的伙伴肯定也会喜欢的！"
                        }
                    ]
                },
                {
                    "id": "746820211",
                    "text": "关于温泉…",
                    "response": [
                        {
                            "id": "746820212",
                            "speaker": "兰吉特",
                            "text": "枫丹好像也有几处热泉，足足能把人烫伤的那种。听说铁甲熔火帝皇的居所附近的水域就格外灼热…"
                        },
                        {
                            "id": "746820213",
                            "speaker": "兰吉特",
                            "text": "不过纳塔温泉又是不一样的热，该怎么说呢，不管是身体还是心灵的伤痛都能被它治愈。"
                        },
                        {
                            "id": "746820214",
                            "speaker": "兰吉特",
                            "text": "也因为这个，意外的叫人上瘾呢…"
                        }
                    ]
                },
                {
                    "id": "746820215",
                    "text": "还有别的事，稍候。",
                    "response": [
                        {
                            "id": "746820216",
                            "speaker": "兰吉特",
                            "text": "没问题，我就在这儿等你。"
                        }
                    ]
                }
            ]
        }
    ]
}