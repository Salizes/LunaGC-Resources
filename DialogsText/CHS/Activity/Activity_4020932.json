{
    "talkId": "4020932",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "丰运": 11
    },
    "dialogues": [
        {
            "id": "402093201",
            "speaker": "丰运",
            "text": "罐头、干货和冻品还足够，但船都来近海了，还是去买些新鲜食材吧…",
            "choices": [
                {
                    "id": "402093202",
                    "text": "你是厨师吗？",
                    "response": [
                        {
                            "id": "402093203",
                            "speaker": "丰运",
                            "text": "哦哦，我不掌勺啦，我只负责这艘船的后勤和仓储，大厨正在船舱里忙活呢。"
                        },
                        {
                            "id": "402093204",
                            "speaker": "丰运",
                            "text": "哎呀，船上的食材为了长期航行，都做了脱水和冷冻处理，要么就是罐装货，口感不太好，不然，我高低让他给你炒俩菜！",
                            "choices": [
                                {
                                    "id": "402093205",
                                    "text": "听起来感觉挺苦的。",
                                    "response": [
                                        {
                                            "id": "402093207",
                                            "speaker": "丰运",
                                            "text": "严格来说也不算差啦…"
                                        },
                                        {
                                            "id": "402093208",
                                            "speaker": "丰运",
                                            "text": "听说啊，以前的水手出港后，每天的菜谱都是定死的，先吃容易腐烂的蔬菜水果，按时序往后一天一天排…"
                                        },
                                        {
                                            "id": "402093209",
                                            "speaker": "丰运",
                                            "text": "最后就只剩下硬得能磕碎牙的肉干，和能当锤头的面包了，想想就绝望…"
                                        },
                                        {
                                            "id": "402093210",
                                            "speaker": "丰运",
                                            "text": "储存技术的进步真是太棒了！至少现在，我们船上的伙食，只是在风味上比不过饭馆，总体还是健康、新鲜又营养的。"
                                        },
                                        {
                                            "id": "402093211",
                                            "speaker": "丰运",
                                            "text": "更换冰元素瓶和冰雾花的麻烦，比起切掉食材腐烂的部分，也不值一提。"
                                        },
                                        {
                                            "id": "402093212",
                                            "speaker": "丰运",
                                            "text": "以前我还不理解，北斗大姐头每到一个地方，都要专门安排人去询问各种前沿商品的技术，不惜花重金也要搬到船上来用…"
                                        },
                                        {
                                            "id": "402093213",
                                            "speaker": "丰运",
                                            "text": "现在看来，大姐头的长远眼光绝对准狠，任何事情都可以相信她！"
                                        }
                                    ]
                                },
                                {
                                    "id": "402093206",
                                    "text": "吃不好怎么和风浪搏斗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "402093214",
                    "text": "那你去忙吧，我也走了。",
                    "response": [
                        {
                            "id": "402093215",
                            "speaker": "丰运",
                            "text": "啊…下次要来船上吃饭的话，提前打个招呼哦！"
                        }
                    ]
                }
            ]
        }
    ]
}