{
    "talkId": "7151701",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "钟离": 8,
        "锅巴": 2
    },
    "dialogues": [
        {
            "id": "715170101",
            "speaker": "钟离",
            "text": "蔬菜十分新鲜，干货也备了许多。海鲜…嗯，不要了。"
        },
        {
            "id": "715170102",
            "speaker": "钟离",
            "text": "啊，原来是你，又见面了。"
        },
        {
            "id": "715170103",
            "speaker": "钟离",
            "text": "见到我在这里，很惊讶吗？"
        },
        {
            "id": "715170104",
            "speaker": "钟离",
            "text": "是堂主布置的新任务。香菱节日期间被店里的生意困住，一直没空游玩，堂主见了，就派我来帮几日厨，好让香菱能得些空闲。"
        },
        {
            "id": "715170105",
            "speaker": "钟离",
            "text": "不过来了才发现，有这位能干的老友在，我似乎帮不上什么忙…"
        },
        {
            "id": "715170106",
            "speaker": "锅巴",
            "text": "♪~"
        },
        {
            "id": "715170107",
            "speaker": "钟离",
            "text": "看着老友搬菜生火，心中很是快活啊。"
        },
        {
            "id": "715170108",
            "speaker": "钟离",
            "text": "要不…再去借留云借风真君的「机关烹饪神机」一用？"
        },
        {
            "id": "715170109",
            "speaker": "锅巴",
            "text": "！"
        },
        {
            "id": "715170110",
            "speaker": "钟离",
            "text": "…放不下吗？好吧。"
        }
    ]
}