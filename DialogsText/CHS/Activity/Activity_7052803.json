{
    "talkId": "7052803",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "卜劳恩": 6
    },
    "dialogues": [
        {
            "id": "705280301",
            "speaker": "卜劳恩",
            "text": "怎么样？你想试玩一下「逐花棋」吗？",
            "choices": [
                {
                    "id": "705280302",
                    "text": "试玩一下。"
                },
                {
                    "id": "705280303",
                    "text": "关于「逐花棋」…",
                    "response": [
                        {
                            "id": "705280304",
                            "speaker": "卜劳恩",
                            "text": "设计这个游戏的冒险家自己说，设计灵感是来自于飘飞的花瓣，还有追逐着花瓣的风…"
                        },
                        {
                            "id": "705280305",
                            "speaker": "卜劳恩",
                            "text": "整个游戏的感觉，也是想要模拟那种追逐花瓣的…浪漫感…"
                        },
                        {
                            "id": "705280306",
                            "speaker": "卜劳恩",
                            "text": "唉，但从游玩角度来说，我就是在被几个塞满花瓣和彩纸的气球追来追去嘛…"
                        },
                        {
                            "id": "705280307",
                            "speaker": "卜劳恩",
                            "text": "虽然玩起来我个人感觉不错啦，但这哪里谈得上浪漫…"
                        }
                    ]
                },
                {
                    "id": "705280308",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "705280309",
                            "speaker": "卜劳恩",
                            "text": "喔，再见。想要试玩的话，过来打个招呼就行。"
                        }
                    ]
                }
            ]
        }
    ]
}