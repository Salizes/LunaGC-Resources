{
    "talkId": "7350709",
    "total_dialogue_lines": 43,
    "speaker_counts": {
        "Player": 11,
        "派蒙": 14,
        "海妮耶": 18
    },
    "dialogues": [
        {
            "id": "735070901",
            "speaker": "海妮耶",
            "text": "看你们的神情，应该还有很多事想要问吧？"
        },
        {
            "id": "735070902",
            "speaker": "海妮耶",
            "text": "不用见外，请随意一点。你们有恩于我，我会将我所知道的一切与你们分享。",
            "choices": [
                {
                    "id": "735070903",
                    "text": "关于领养蕈兽伙伴…",
                    "response": [
                        {
                            "id": "735070904",
                            "speaker": "派蒙",
                            "text": "#嗯，{NICKNAME}和我想问的一样。"
                        },
                        {
                            "id": "735070905",
                            "speaker": "派蒙",
                            "text": "之前我们不能带走「咚咚小圆帽」，是为了公平，防止大家觉得我们搞特殊对待，反对最后的决定。"
                        },
                        {
                            "id": "735070906",
                            "speaker": "派蒙",
                            "text": "现在距离上次大赛已经有一段时间了，如果我们不依靠「意智宝珠」也能和蕈兽伙伴沟通…"
                        },
                        {
                            "id": "735070907",
                            "speaker": "派蒙",
                            "text": "那我们能不能把「咚咚小圆帽」留在身边呢？"
                        },
                        {
                            "id": "735070908",
                            "speaker": "海妮耶",
                            "text": "这一点，我确实有考虑过。"
                        },
                        {
                            "id": "735070909",
                            "speaker": "海妮耶",
                            "text": "假如你们可以找到一片没有居民和其他动物的区域，理论上是没问题的。"
                        },
                        {
                            "id": "735070910",
                            "speaker": "海妮耶",
                            "text": "虽说我们的蕈兽伙伴都很乖巧，但要是被野林猪之类的生物挑衅，说不定也会生气。",
                            "choices": [
                                {
                                    "id": "735070911",
                                    "text": "我们有「尘歌壶」…",
                                    "response": [
                                        {
                                            "id": "735070913",
                                            "speaker": "派蒙",
                                            "text": "不过，壶中洞天还会有客人和动物吧？"
                                        },
                                        {
                                            "id": "735070914",
                                            "speaker": "派蒙",
                                            "text": "要是蕈兽伙伴们和壶中洞天里的其他动物打起来了，阿圆也会很苦恼的…"
                                        },
                                        {
                                            "id": "735070915",
                                            "speaker": "派蒙",
                                            "text": "还是先问问阿圆好了，说不定她会有什么好主意？"
                                        },
                                        {
                                            "id": "735070916",
                                            "speaker": "海妮耶",
                                            "text": "我也在寻找新的保险措施，比如有着特殊孢子的路牌或围栏，能让蕈兽伙伴们自觉地待在一个区域里。"
                                        },
                                        {
                                            "id": "735070917",
                                            "speaker": "海妮耶",
                                            "text": "这样或许就能把它们的活动区域和一般的动物划分开来，避免冲突。"
                                        },
                                        {
                                            "id": "735070918",
                                            "speaker": "海妮耶",
                                            "text": "要是有了眉目，我会第一时间通知你们的。"
                                        },
                                        {
                                            "id": "735070919",
                                            "speaker": "Player",
                                            "text": "好！我们一起努力！"
                                        },
                                        {
                                            "id": "735070920",
                                            "speaker": "派蒙",
                                            "text": "谢谢你，海妮耶！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735070912",
                                    "text": "「壶中洞天」很宽敞。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735070921",
                    "text": "关于「妙妙琼脂」…",
                    "response": [
                        {
                            "id": "735070922",
                            "speaker": "海妮耶",
                            "text": "不用担心，「妙妙琼脂」是我托生论派学者努查赫小姐制作的，蕈兽伙伴们的口粮。"
                        },
                        {
                            "id": "735070923",
                            "speaker": "海妮耶",
                            "text": "琼脂里完全不含药物成分，只有蕈兽们所需的营养物质。"
                        },
                        {
                            "id": "735070924",
                            "speaker": "海妮耶",
                            "text": "有了「妙妙琼脂」，就可以避免蕈兽伙伴过度汲取土壤中的养分，防止破坏雨林的生态。"
                        },
                        {
                            "id": "735070925",
                            "speaker": "海妮耶",
                            "text": "另外，还可以根据蕈兽伙伴们的个性，加入它们各自钟爱的成分，让它们心情愉快。"
                        },
                        {
                            "id": "735070926",
                            "speaker": "派蒙",
                            "text": "还有这种事！那岂不是能搞清楚「咚咚小圆帽」喜欢的味道了？",
                            "choices": [
                                {
                                    "id": "735070927",
                                    "text": "派蒙要尝尝看吗？",
                                    "response": [
                                        {
                                            "id": "735070929",
                                            "speaker": "派蒙",
                                            "text": "才不呢，虽然「花花琼脂」和「妙妙琼脂」看起来都很美味啦，但我还不至于贪吃到抢蕈兽伙伴们的食物！"
                                        },
                                        {
                                            "id": "735070930",
                                            "speaker": "派蒙",
                                            "text": "待会儿我们就去给「咚咚小圆帽」和「欢腾之火」喂一些「妙妙琼脂」吧？"
                                        }
                                    ]
                                },
                                {
                                    "id": "735070928",
                                    "text": "吃了以后描述一下味道…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735070931",
                    "text": "关于你的资金…",
                    "response": [
                        {
                            "id": "735070932",
                            "speaker": "派蒙",
                            "text": "#唔…{NICKNAME}和我担心的问题一样，海妮耶一直在照顾蕈兽伙伴，会不会出现摩拉不够用的情况啊？"
                        },
                        {
                            "id": "735070933",
                            "speaker": "海妮耶",
                            "text": "请别担心。"
                        },
                        {
                            "id": "735070934",
                            "speaker": "海妮耶",
                            "text": "在雨林里，我的食物可以通过渔猎获得，蕈兽伙伴们可以直接汲取土壤中的养分。"
                        },
                        {
                            "id": "735070935",
                            "speaker": "海妮耶",
                            "text": "除了我的衣物和日常用品，还有给蕈兽伙伴们制作「妙妙琼脂」所需的费用，基本没有日常开销。"
                        },
                        {
                            "id": "735070936",
                            "speaker": "海妮耶",
                            "text": "我以前为商队训练驮兽时攒下了不少积蓄，加上上次比赛拿到的奖金，支撑几十年都没问题。"
                        },
                        {
                            "id": "735070937",
                            "speaker": "派蒙",
                            "text": "好，好厉害！这就是专业的驯兽师吗！",
                            "choices": [
                                {
                                    "id": "735070938",
                                    "text": "如果有需要，请告诉我们。",
                                    "response": [
                                        {
                                            "id": "735070940",
                                            "speaker": "海妮耶",
                                            "text": "你们的心意我领会了，我承诺过，要照顾好蕈兽伙伴们，不出意外，我绝不会给你们添麻烦的。"
                                        },
                                        {
                                            "id": "735070941",
                                            "speaker": "派蒙",
                                            "text": "呜…有一种特别安心的感觉，等到时机合适了，我们请海妮耶吃一顿大餐，好好改善一下伙食吧！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735070939",
                                    "text": "我们会全力支持你。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735070942",
                    "text": "暂时不麻烦你了。",
                    "response": [
                        {
                            "id": "735070943",
                            "speaker": "海妮耶",
                            "text": "别客气！我随时在这里等着你们，有空的时候就来看看吧。"
                        }
                    ]
                }
            ]
        }
    ]
}