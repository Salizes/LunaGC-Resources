    "dialogues": [
        {
            "id": "401544201",
            "speaker": "五郎",
            "text": "…之前说过，要想安静地穿过林地，可以提前把尾巴打湿，这样就能防止毛茸茸的尾巴不经意间钩挂到树枝，打草惊蛇…"
        },
        {
            "id": "401544202",
            "speaker": "绮良良",
            "text": "不，不太好吧，湿漉漉的，完全受不了…不如直接把尾巴打个结，或者多练练战斗的本领，直接赶走拦路的魔物…"
        },
        {
            "id": "401544203",
            "speaker": "绮良良",
            "text": "#啊，{NICKNAME}来啦，药剂的调配还顺利吗？",
            "choices": [
                {
                    "id": "401544204",
                    "text": "提交药剂。"
                },
                {
                    "id": "401544205",
                    "text": "还在技术攻关阶段。",
                    "response": [
                        {
                            "id": "401544206",
                            "speaker": "五郎",
                            "text": "加油加油，我相信凭你强悍的实力，一切技术难关都拦不住你！"
                        }
                    ]
                }
            ]
        }
    ]
}