{
    "talkId": "4019723",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 4,
        "派蒙": 4,
        "芙宁娜": 7
    },
    "dialogues": [
        {
            "id": "401972301",
            "speaker": "芙宁娜",
            "text": "准备完成了，接下来，我们就在附近转转，随机寻找客人，询问他们几个关键问题好啦。"
        },
        {
            "id": "401972302",
            "speaker": "Black Screen",
            "text": "与芙宁娜一同行动，向许多游客征询了建议，收获了大量反馈…"
        },
        {
            "id": "401972303",
            "speaker": "派蒙",
            "text": "收集到的建议居然这么详细…「原型映影的选取」、「还原场景的切入点」、「服化道的表现和成本平衡」…"
        },
        {
            "id": "401972304",
            "speaker": "派蒙",
            "text": "我要看晕了，大家都好专业！"
        },
        {
            "id": "401972305",
            "speaker": "派蒙",
            "text": "还有，每个人几乎都提到了，「想看芙宁娜大人的演出」，你的人气真的好高啊！",
            "choices": [
                {
                    "id": "401972306",
                    "text": "完全不意外。",
                    "response": [
                        {
                            "id": "401972308",
                            "speaker": "芙宁娜",
                            "text": "其实这次，我并没有计划特别演出哦。"
                        },
                        {
                            "id": "401972309",
                            "speaker": "芙宁娜",
                            "text": "作为一个合格的明星，要把握自己戏份的尺度——"
                        },
                        {
                            "id": "401972310",
                            "speaker": "芙宁娜",
                            "text": "该当主角时，台上的所有聚光灯都该为我而亮；作为客人时，则要适当低调，切忌喧宾夺主。"
                        },
                        {
                            "id": "401972311",
                            "speaker": "芙宁娜",
                            "text": "所以，比起直接上台演出，我更倾向于在幕后支援你们，比如，给你们的游乐项目当顾问。",
                            "choices": [
                                {
                                    "id": "401972312",
                                    "text": "话都说到这份上了！",
                                    "response": [
                                        {
                                            "id": "401972314",
                                            "speaker": "派蒙",
                                            "text": "对，对喔！「妙影名篇」这个项目很考验映影的阅历，好像还真没有芙宁娜以外的合适人选了！"
                                        },
                                        {
                                            "id": "401972315",
                                            "speaker": "芙宁娜",
                                            "text": "好呀！这份工作，我就满怀干劲地接下了。"
                                        },
                                        {
                                            "id": "401972316",
                                            "speaker": "芙宁娜",
                                            "text": "容我小小准备一番，一起去「甜点大校」那里吃份蛋糕，然后就正式开工吧！"
                                        }
                                    ]
                                },
                                {
                                    "id": "401972313",
                                    "text": "正好有个位置非你莫属！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401972307",
                    "text": "换我我也这么答。"
                }
            ]
        }
    ]
}