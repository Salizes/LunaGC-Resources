{
    "talkId": "7751106",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "尤维尔": 6,
        "纳蒂亚": 4
    },
    "dialogues": [
        {
            "id": "775110601",
            "speaker": "纳蒂亚",
            "text": "啊，恭喜你拿到冠军。",
            "choices": [
                {
                    "id": "775110602",
                    "text": "还想复盘射击挑战…",
                    "response": [
                        {
                            "id": "775110603",
                            "speaker": "尤维尔",
                            "text": "那太好了，我也好好观瞻一下…"
                        }
                    ]
                },
                {
                    "id": "775110604",
                    "text": "你们接下来有什么打算？",
                    "response": [
                        {
                            "id": "775110605",
                            "speaker": "尤维尔",
                            "text": "这个啊，奥利菲亚给我们的资金还有很多，我们还会在至冬旅游一段时间。顺带也给她带点纪念品。"
                        },
                        {
                            "id": "775110606",
                            "speaker": "尤维尔",
                            "text": "说起来，纳蒂亚觉得累吗？有没有哪里不舒服？"
                        },
                        {
                            "id": "775110607",
                            "speaker": "纳蒂亚",
                            "text": "没什么感觉哦，照着尤维尔的分析，像吃饭一样，开开心心就比完赛了。"
                        },
                        {
                            "id": "775110608",
                            "speaker": "尤维尔",
                            "text": "那，既然说到吃饭了，我们待会儿去老庭院餐厅，点一桌大餐吧？"
                        },
                        {
                            "id": "775110609",
                            "speaker": "纳蒂亚",
                            "text": "好啊，我要吃…加了烟熏甜菜叶的鱼鱼刨花。"
                        },
                        {
                            "id": "775110610",
                            "speaker": "纳蒂亚",
                            "text": "昨天在外边玩的时候，一只小熊给我的，好吃。"
                        },
                        {
                            "id": "775110611",
                            "speaker": "尤维尔",
                            "text": "下次还是小心点，不要什么东西都乱尝哦…"
                        }
                    ]
                },
                {
                    "id": "775110612",
                    "text": "你们也表现得很棒。",
                    "response": [
                        {
                            "id": "775110613",
                            "speaker": "尤维尔",
                            "text": "感谢肯定，纳蒂亚玩得很开心，我锻炼也更有目标了，这次比赛来得很值。"
                        }
                    ]
                }
            ]
        }
    ]
}