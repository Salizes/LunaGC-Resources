{
    "talkId": "7750114",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "梨香": 19
    },
    "dialogues": [
        {
            "id": "775011401",
            "speaker": "梨香",
            "text": "你好啊，这么有缘一起参赛，要买「八重堂」的新小说，还是直接开始列车推演？",
            "choices": [
                {
                    "id": "775011402",
                    "text": "先来列车推演好了。",
                    "response": [
                        {
                            "id": "775011403",
                            "speaker": "梨香",
                            "text": "列车这东西，以前只在轻小说里读到过，祝你也玩得开心哦！"
                        }
                    ]
                },
                {
                    "id": "775011404",
                    "text": "冒险家为何卖小说？",
                    "response": [
                        {
                            "id": "775011405",
                            "speaker": "梨香",
                            "text": "冒险家怎么了嘛…干活途中卖点道具的，也不止我嘛？"
                        },
                        {
                            "id": "775011406",
                            "speaker": "梨香",
                            "text": "冒险那么花钱，每次做委托，丢掉一大堆元素瓶什么的道具，拿完奖励还要倒贴几十万摩拉。"
                        },
                        {
                            "id": "775011407",
                            "speaker": "梨香",
                            "text": "那不就只能…打工卖货，补贴补贴家用了嘛？",
                            "choices": [
                                {
                                    "id": "775011408",
                                    "text": "既然如此为何还要冒险…",
                                    "response": [
                                        {
                                            "id": "775011410",
                                            "speaker": "梨香",
                                            "text": "那不行，循规蹈矩的生活太无聊了，我过不了几天就会死的。"
                                        },
                                        {
                                            "id": "775011411",
                                            "speaker": "梨香",
                                            "text": "我的梦想是，每天醒来，都能面对陌生的天花板，见到新奇的人和事物，迎接没见过的挑战。"
                                        },
                                        {
                                            "id": "775011412",
                                            "speaker": "梨香",
                                            "text": "只有冒险家的生活，才符合我的要求。"
                                        },
                                        {
                                            "id": "775011413",
                                            "speaker": "梨香",
                                            "text": "这次的比赛就让我心满意足——交到了好多远方的朋友，还在冰雪之国大饱眼福。"
                                        },
                                        {
                                            "id": "775011414",
                                            "speaker": "梨香",
                                            "text": "可惜，我完全是个写作白痴。"
                                        },
                                        {
                                            "id": "775011415",
                                            "speaker": "梨香",
                                            "text": "也只能托其他编辑写封信，把最近的见闻告诉拖稿大王左右加，看看她能不能用上这些有趣的故事素材了…"
                                        }
                                    ]
                                },
                                {
                                    "id": "775011409",
                                    "text": "实在拮据不如找份正常工作…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011416",
                    "text": "你这耳朵…",
                    "response": [
                        {
                            "id": "775011417",
                            "speaker": "梨香",
                            "text": "假的啦，是道具哦，我身上这套巫女服也是。"
                        },
                        {
                            "id": "775011418",
                            "speaker": "梨香",
                            "text": "几年前，我为了挑战S级委托，欠了太多钱，兜兜转转去八重堂打了工。"
                        },
                        {
                            "id": "775011419",
                            "speaker": "梨香",
                            "text": "结果，天无绝人之路，我赶上了热热闹闹的容彩祭，装扮成小说里的角色，宣传联动饮品…"
                        },
                        {
                            "id": "775011420",
                            "speaker": "梨香",
                            "text": "最后业绩不错，得到了荒谷编辑的认可，拿了不少奖金呢。"
                        },
                        {
                            "id": "775011421",
                            "speaker": "梨香",
                            "text": "从此以后，我就一直为八重堂卖命了，这份差事最稳当。"
                        },
                        {
                            "id": "775011422",
                            "speaker": "梨香",
                            "text": "不过，我也不会守在柜台啦。因为我一直在各种地方旅游、露营和冒险。"
                        },
                        {
                            "id": "775011423",
                            "speaker": "梨香",
                            "text": "向同行的人出售合乎情景的轻小说，是我最大的业绩来源！"
                        }
                    ]
                },
                {
                    "id": "775011424",
                    "text": "都下次再说吧。",
                    "response": [
                        {
                            "id": "775011425",
                            "speaker": "梨香",
                            "text": "欸？那好吧…实在无聊的话，就来找我买书哦。"
                        }
                    ]
                }
            ]
        }
    ]
}