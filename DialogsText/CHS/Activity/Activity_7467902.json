{
    "talkId": "7467902",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "蒂蕾娜": 9
    },
    "dialogues": [
        {
            "id": "746790201",
            "speaker": "蒂蕾娜",
            "text": "「超天顶领队级战力」，请问还有什么指示吗？",
            "choices": [
                {
                    "id": "746790202",
                    "text": "来一局「千步拦射角分间」！",
                    "response": [
                        {
                            "id": "746790203",
                            "speaker": "蒂蕾娜",
                            "text": "没问题！这个游戏不会真正的消耗弹药，也不用维护靶标。你甚至可以一口气玩几千局，打掉几万个靶标！"
                        }
                    ]
                },
                {
                    "id": "746790204",
                    "text": "关于铳枪…",
                    "response": [
                        {
                            "id": "746790205",
                            "speaker": "蒂蕾娜",
                            "text": "嗯？您也想定制铳枪吗？"
                        },
                        {
                            "id": "746790206",
                            "speaker": "蒂蕾娜",
                            "text": "虽然我不明白铳枪的内部原理，但我听同事提到过几位优秀的枪匠。"
                        },
                        {
                            "id": "746790207",
                            "speaker": "蒂蕾娜",
                            "text": "相比量产铳枪，枪匠们仔细打造的产品在使用寿命，精度和弹道稳定上，都有着更卓越的表现…"
                        },
                        {
                            "id": "746790208",
                            "speaker": "蒂蕾娜",
                            "text": "如果使用严格控制公差的优质弹药，更是能打出令人瞠目结舌的成绩！"
                        },
                        {
                            "id": "746790209",
                            "speaker": "蒂蕾娜",
                            "text": "不过，我记得一般市民不能随意持有铳枪来着，好像要走一套相当复杂的流程…"
                        },
                        {
                            "id": "746790210",
                            "speaker": "蒂蕾娜",
                            "text": "等到我回了「特巡队」的驻地，我帮您好好问问！"
                        }
                    ]
                },
                {
                    "id": "746790211",
                    "text": "回见！",
                    "response": [
                        {
                            "id": "746790212",
                            "speaker": "蒂蕾娜",
                            "text": "您客气了，「超天顶领队级战力」！我随时在这里恭候您的到来！"
                        }
                    ]
                }
            ]
        }
    ]
}