    "dialogues": [
        {
            "id": "711580401",
            "speaker": "蓝砚",
            "text": "接下来还要给邻居们送霄灯，下一位是…",
            "choices": [
                {
                    "id": "711580402",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711580403",
                            "speaker": "蓝砚",
                            "text": "你也放飞霄灯了？原来你自己准备了啊，我还说编一盏送给你呢。"
                        },
                        {
                            "id": "711580404",
                            "speaker": "蓝砚",
                            "text": "但无论如何，希望我们写在霄灯上的心愿能全部实现。"
                        }
                    ]
                },
                {
                    "id": "711580405",
                    "text": "再见啦，海灯节快乐。",
                    "response": [
                        {
                            "id": "711580406",
                            "speaker": "蓝砚",
                            "text": "海灯节快乐，玩的开心呀！"
                        }
                    ]
                }
            ]
