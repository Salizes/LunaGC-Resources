{
    "talkId": "4019715",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 2,
        "派蒙": 3,
        "迪希雅": 9
    },
    "dialogues": [
        {
            "id": "401971501",
            "speaker": "迪希雅",
            "text": "#{NICKNAME}和派蒙，好消息！"
        },
        {
            "id": "401971502",
            "speaker": "迪希雅",
            "text": "「炽光猎兽」的兄弟姐妹们一致同意了我的提议——"
        },
        {
            "id": "401971503",
            "speaker": "迪希雅",
            "text": "如果接到了列柱沙原以西，千壑沙地以北、阿陀河谷以东，善见地以南的订单，全都转交给你！"
        },
        {
            "id": "401971504",
            "speaker": "迪希雅",
            "text": "虽说最近这种委托并不常见，但按照经验，每年都会有几单不错的差事。"
        },
        {
            "id": "401971505",
            "speaker": "迪希雅",
            "text": "回报极其可观，但也有超出寻常的风险，通常，一整队全副武装的佣兵才能拿下。"
        },
        {
            "id": "401971506",
            "speaker": "迪希雅",
            "text": "不过，对你来说刚刚好，没这个难度，说不定你还觉得连活动筋骨都不够呢！",
            "choices": [
                {
                    "id": "401971507",
                    "text": "对我们来说刚刚好！",
                    "response": [
                        {
                            "id": "401971509",
                            "speaker": "派蒙",
                            "text": "迪希雅做事真麻利，三下五除二就和大家谈好了。这下，我们两个也算是「炽光猎兽」合作伙伴了…"
                        },
                        {
                            "id": "401971510",
                            "speaker": "派蒙",
                            "text": "嘿哈！新人佣兵上路…我是不是该给自己起个道上的名？"
                        },
                        {
                            "id": "401971511",
                            "speaker": "迪希雅",
                            "text": "哈哈，记得，在别国活动的时候，适当帮「炽光猎兽」打打广告就行——"
                        },
                        {
                            "id": "401971512",
                            "speaker": "迪希雅",
                            "text": "里外照应，生意源源不断！"
                        },
                        {
                            "id": "401971513",
                            "speaker": "迪希雅",
                            "text": "总之，以后一有合适的差事，我就往各地的冒险家协会寄信，你们记得及时查收哦！"
                        },
                        {
                            "id": "401971514",
                            "speaker": "派蒙",
                            "text": "就这么说定了！"
                        }
                    ]
                },
                {
                    "id": "401971508",
                    "text": "超清晰的分红区域。"
                }
            ]
        }
    ]
}