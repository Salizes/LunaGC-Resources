    },
    "dialogues": [
        {
            "id": "715402901",
            "speaker": "赛诺",
            "text": "祝柬…祝柬，嗯…",
            "choices": [
                {
                    "id": "715402902",
                    "text": "这份祝柬送给你。",
                    "response": [
                        {
                            "id": "715402903",
                            "speaker": "赛诺",
                            "text": "谢谢，祝节日快乐。"
                        },
                        {
                            "id": "715402904",
                            "speaker": "Player",
                            "text": "你…也快乐？"
                        },
                        {
                            "id": "715402905",
                            "speaker": "赛诺",
                            "text": "嗯。"
                        },
                        {
                            "id": "715402906",
                            "speaker": "赛诺",
                            "text": "你怎么这副表情？",
                            "choices": [
                                {
                                    "id": "715402907",
                                    "text": "赛诺今天，话好少喔。",
                                    "response": [
                                        {
                                            "id": "715402909",
                                            "speaker": "赛诺",
                                            "text": "海灯节很好。"
                                        },
                                        {
                                            "id": "715402910",
                                            "speaker": "赛诺",
                                            "text": "但你送我祝柬，我要随俗。",
                                            "choices": [
                                                {
                                                    "id": "715402911",
                                                    "text": "…欸？",
                                                    "response": [
                                                        {
                                                            "id": "715402913",
                                                            "speaker": "赛诺",
                                                            "text": "是。既然你祝我「简」。"
                                                        },
                                                        {
                                                            "id": "715402914",
                                                            "speaker": "赛诺",
                                                            "text": "那我说话，也要简短点。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715402912",
                                                    "text": "随，随俗？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715402908",
                                    "text": "是哪里玩得不高兴么？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715402915",
                    "text": "再见…",
                    "response": [
                        {
                            "id": "715402916",
                            "speaker": "赛诺",
                            "text": "慢走。"
                        }
                    ]
                }
            ]
        }
    ]
}