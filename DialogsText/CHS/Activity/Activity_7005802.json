    "dialogues": [
        {
            "id": "700580201",
            "speaker": "魈",
            "text": "是你，许久未见了。"
        },
        {
            "id": "700580202",
            "speaker": "魈",
            "text": "你脚步轻松，看来兴致不错，是来此处游玩的？",
            "choices": [
                {
                    "id": "700580203",
                    "text": "是来留影的。",
                    "response": [
                        {
                            "id": "700580205",
                            "speaker": "魈",
                            "text": "留影…我记得闲云曾与我说起过，须有留影机才可留影。"
                        },
                        {
                            "id": "700580206",
                            "speaker": "魈",
                            "text": "你两手空空…留影机在何处，落在派蒙那里了么？"
                        }
                    ]
                },
                {
                    "id": "700580204",
                    "text": "是来游玩顺便留影的。"
                }
            ]
        }
    ]
}