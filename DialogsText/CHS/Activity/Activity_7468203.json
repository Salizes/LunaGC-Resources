{
    "talkId": "7468203",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "兰吉特": 10
    },
    "dialogues": [
        {
            "id": "746820301",
            "speaker": "兰吉特",
            "text": "我已经准备万全了。还是说你想聊聊？",
            "choices": [
                {
                    "id": "746820302",
                    "text": "关于能飞的伙伴…",
                    "response": [
                        {
                            "id": "746820303",
                            "speaker": "兰吉特",
                            "text": "之前提到的昆图尔的故事，他的伙伴暝视龙就是能飞得很高的龙。"
                        },
                        {
                            "id": "746820304",
                            "speaker": "兰吉特",
                            "text": "不如说，如果没有暝视龙伙伴的帮助，他恐怕也很难成功吧。"
                        },
                        {
                            "id": "746820305",
                            "speaker": "兰吉特",
                            "text": "有个能飞的伙伴真不错啊…仔细想想，你的伙伴也是能飞的，怎么样，她有什么拿手的技能之类的吗？"
                        },
                        {
                            "id": "746820306",
                            "speaker": "Player",
                            "text": "她能让很多食物瞬间消失。"
                        },
                        {
                            "id": "746820307",
                            "speaker": "兰吉特",
                            "text": "哇，是厨子听了会开心的技能。"
                        },
                        {
                            "id": "746820308",
                            "speaker": "兰吉特",
                            "text": "下次也让我给她做点好吃的吧。说起我的手艺，纳塔朋友都建议我留在纳塔做龙饭厨子，肯定大受欢迎。"
                        },
                        {
                            "id": "746820309",
                            "speaker": "兰吉特",
                            "text": "你的伙伴肯定也会喜欢的！"
                        }
                    ]
                },
                {
                    "id": "746820310",
                    "text": "关于温泉…",
                    "response": [
                        {
                            "id": "746820311",
                            "speaker": "兰吉特",
                            "text": "枫丹好像也有几处热泉，足足能把人烫伤的那种。听说铁甲熔火帝皇的居所附近的水域就格外灼热…"
                        },
                        {
                            "id": "746820312",
                            "speaker": "兰吉特",
                            "text": "不过纳塔温泉又是不一样的热，该怎么说呢，不管是身体还是心灵的伤痛都能被它治愈。"
                        },
                        {
                            "id": "746820313",
                            "speaker": "兰吉特",
                            "text": "也因为这个，意外的叫人上瘾呢…"
                        }
                    ]
                },
                {
                    "id": "746820314",
                    "text": "没什么想聊的。"
                }
            ]
        }
    ]
}