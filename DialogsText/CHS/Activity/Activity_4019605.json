    "dialogues": [
        {
            "id": "401960501",
            "speaker": "夏沃蕾",
            "text": "我们正在就灰色赌博产业一案对嫌疑人进行问询，一有消息就会告知各位。"
        },
        {
            "id": "401960502",
            "speaker": "那维莱特",
            "text": "嗯，辛苦了。"
        },
        {
            "id": "401960503",
            "speaker": "莱欧斯利",
            "text": "听上去好像没有我的事了？那容我先行告辞…"
        },
        {
            "id": "401960504",
            "speaker": "那维莱特",
            "text": "等等。"
        },
        {
            "id": "401960505",
            "speaker": "那维莱特",
            "text": "莱欧斯利先生作为重要证人，可能需要出席后续庭审。"
        },
        {
            "id": "401960506",
            "speaker": "莱欧斯利",
            "text": "哦天哪，真的假的…"
        },
        {
            "id": "401960507",
            "speaker": "夏沃蕾",
            "text": "？"
        },
        {
            "id": "401960508",
            "speaker": "莱欧斯利",
            "text": "我是说…可不可以让我匿名出席呢？"
        },
        {
            "id": "401960509",
            "speaker": "夏沃蕾",
            "text": "这怎么做到…听听你说的话。"
        }
    ]
}