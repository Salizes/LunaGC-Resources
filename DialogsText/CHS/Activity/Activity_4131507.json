    "dialogues": [
        {
            "id": "413150701",
            "speaker": "Player",
            "text": "你是？"
        },
        {
            "id": "413150702",
            "speaker": "一柱",
            "text": "我叫一柱，你一定也见过我妹妹一弦吧？"
        },
        {
            "id": "413150703",
            "speaker": "一柱",
            "text": "我答应过她，要一起为妈妈做一盏霄灯的。可我凑不齐做霄灯的材料，多亏长顺姐姐特意给我们留了一些材料…"
        },
        {
            "id": "413150704",
            "speaker": "一柱",
            "text": "最近大家真的对我们兄妹很温柔…"
        },
        {
            "id": "413150705",
            "speaker": "一柱",
            "text": "……"
        },
        {
            "id": "413150706",
            "speaker": "一柱",
            "text": "…不行，不能哭，要笑给妹妹看。"
        }
    ]
}