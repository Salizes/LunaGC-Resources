{
    "talkId": "7166622",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "「且听下次复盘」": 7
    },
    "dialogues": [
        {
            "id": "716662201",
            "speaker": "「且听下次复盘」",
            "text": "朋友，你也要参加荒泷帮主的「甲光烈烈斗虫大修行」？",
            "choices": [
                {
                    "id": "716662202",
                    "text": "来场斗虫吧！",
                    "response": [
                        {
                            "id": "716662203",
                            "speaker": "「且听下次复盘」",
                            "text": "如此甚好！之前的较量那叫一个精彩，我正打算仔细复盘！就劳烦你顺着荒泷帮主的思路再和我斗上一局了！"
                        }
                    ]
                },
                {
                    "id": "716662204",
                    "text": "关于斗虫的门道…",
                    "response": [
                        {
                            "id": "716662205",
                            "speaker": "「且听下次复盘」",
                            "text": "不错，这个话题，可以仔细扯掰扯掰！"
                        },
                        {
                            "id": "716662206",
                            "speaker": "「且听下次复盘」",
                            "text": "璃月也有不少斗虫的游戏，相比这鬼兜虫，各有重点和特色。"
                        },
                        {
                            "id": "716662207",
                            "speaker": "「且听下次复盘」",
                            "text": "比如争一个灵巧，或是谁的虫叫声更高昂。"
                        },
                        {
                            "id": "716662208",
                            "speaker": "「且听下次复盘」",
                            "text": "每种斗虫都暗藏玄机，稍稍添上几笔墨，改编成故事，指定能给各位老主顾好好说上几回！"
                        }
                    ]
                },
                {
                    "id": "716662209",
                    "text": "告辞！",
                    "response": [
                        {
                            "id": "716662210",
                            "speaker": "「且听下次复盘」",
                            "text": "那就下回再见了！"
                        }
                    ]
                }
            ]
        }
    ]
}