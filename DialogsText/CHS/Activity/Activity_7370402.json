{
    "talkId": "7370402",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "兰吉特": 6
    },
    "dialogues": [
        {
            "id": "737040201",
            "speaker": "兰吉特",
            "text": "准备好了吗？",
            "choices": [
                {
                    "id": "737040202",
                    "text": "好了，走吧。"
                },
                {
                    "id": "737040203",
                    "text": "关于昆图尔的故事…",
                    "response": [
                        {
                            "id": "737040204",
                            "speaker": "兰吉特",
                            "text": "说起来朋友只给我讲了后半的故事，并没有讲前半。他父亲到底犯了什么错才会让太阳这么痛恨呢？"
                        },
                        {
                            "id": "737040205",
                            "speaker": "兰吉特",
                            "text": "太阳用金箭刺瞎了他父亲的眼睛作为惩罚还不够，凡是昆图尔所到的地方，太阳都会躲在云层后边。"
                        },
                        {
                            "id": "737040206",
                            "speaker": "兰吉特",
                            "text": "听说也有壁画记录了他的故事，不过我没有亲眼见过。"
                        },
                        {
                            "id": "737040207",
                            "speaker": "兰吉特",
                            "text": "说起来，纳塔的壁画也很独特，不仅漂亮，也很有趣！有时想想，如果我去纳塔时带的不是锅而是留影机就好了…"
                        }
                    ]
                },
                {
                    "id": "737040208",
                    "text": "还有别的事，稍候。",
                    "response": [
                        {
                            "id": "737040209",
                            "speaker": "兰吉特",
                            "text": "没问题，我就在这儿等你。"
                        }
                    ]
                }
            ]
        }
    ]
}