{
    "talkId": "4007704",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 12,
        "莫娜": 15
    },
    "dialogues": [
        {
            "id": "400770401",
            "speaker": "莫娜",
            "text": "假日要接近尾声了吗…",
            "choices": [
                {
                    "id": "400770402",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400770403",
                            "speaker": "莫娜",
                            "text": "行啊，有什么要问我的吗？",
                            "choices": [
                                {
                                    "id": "400770406",
                                    "text": "关于水占盘…",
                                    "response": [
                                        {
                                            "id": "400770407",
                                            "speaker": "莫娜",
                                            "text": "唉，说来也是扫兴，这几次一有大事发生，我的水占盘就会变得不太正常。"
                                        },
                                        {
                                            "id": "400770408",
                                            "speaker": "莫娜",
                                            "text": "…简直像有意阻止我窥探结局一样。"
                                        },
                                        {
                                            "id": "400770409",
                                            "speaker": "莫娜",
                                            "text": "等等，你会这么问，该不会也是想调侃这一点吧？"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770410",
                                    "text": "关于星空…",
                                    "response": [
                                        {
                                            "id": "400770411",
                                            "speaker": "莫娜",
                                            "text": "哦，我正好想问你。当你看到那片星空的时候，内心有什么感想吗？"
                                        },
                                        {
                                            "id": "400770412",
                                            "speaker": "Player",
                                            "text": "好厉害！"
                                        },
                                        {
                                            "id": "400770413",
                                            "speaker": "莫娜",
                                            "text": "是…是吗。"
                                        },
                                        {
                                            "id": "400770414",
                                            "speaker": "莫娜",
                                            "text": "毕、毕竟我是伟大的天才占星术士，幻境当然也得气派恢弘…"
                                        },
                                        {
                                            "id": "400770415",
                                            "speaker": "Player",
                                            "text": "不愧是莫娜！"
                                        },
                                        {
                                            "id": "400770416",
                                            "speaker": "莫娜",
                                            "text": "唔…不过那个时候我还沉浸在自己的思绪里，还是听到你说话才反应过来…"
                                        },
                                        {
                                            "id": "400770417",
                                            "speaker": "Player",
                                            "text": "实在太好看了！"
                                        },
                                        {
                                            "id": "400770418",
                                            "speaker": "莫娜",
                                            "text": "喂…我、我知道了啦。你这家伙，故意的吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770419",
                                    "text": "关于这次假期…",
                                    "response": [
                                        {
                                            "id": "400770420",
                                            "speaker": "莫娜",
                                            "text": "虽然最初是被菲谢尔连拖带拽喊过来的，但在不知不觉中，度过了一个愉快的夏天啊。"
                                        },
                                        {
                                            "id": "400770421",
                                            "speaker": "莫娜",
                                            "text": "见证并守护大家的命运——的确是我想做的事。"
                                        },
                                        {
                                            "id": "400770422",
                                            "speaker": "Player",
                                            "text": "莫娜做得很好哦。"
                                        },
                                        {
                                            "id": "400770423",
                                            "speaker": "莫娜",
                                            "text": "谢谢，倒是你…你也辛苦了。"
                                        },
                                        {
                                            "id": "400770424",
                                            "speaker": "莫娜",
                                            "text": "期待下次和你继续合作，呵呵…我们会变得更有默契吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770404",
                    "text": "先不打扰你了。",
                    "response": [
                        {
                            "id": "400770405",
                            "speaker": "莫娜",
                            "text": "嗯，离开这片海岛前，再多多享受一下吧。",
                            "choices": [
                                {
                                    "id": "400770406",
                                    "text": "关于水占盘…"
                                },
                                {
                                    "id": "400770410",
                                    "text": "关于星空…"
                                },
                                {
                                    "id": "400770419",
                                    "text": "关于这次假期…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}