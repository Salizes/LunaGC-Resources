{
    "talkId": "7055702",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 9,
        "赫得蔚格": 22
    },
    "dialogues": [
        {
            "id": "705570201",
            "speaker": "赫得蔚格",
            "text": "荣誉骑士，您体验过「骑士话剧」了吗？见识到古恩希尔德长官…代理团长的英姿了吧？我们可以畅快地聊聊！",
            "choices": [
                {
                    "id": "705570202",
                    "text": "关于狮牙骑士之影…",
                    "response": [
                        {
                            "id": "705570203",
                            "speaker": "赫得蔚格",
                            "text": "很帅气吧？要论使用单手剑的大师，在我心目中，代理团长是无可撼动的第一名！"
                        },
                        {
                            "id": "705570204",
                            "speaker": "赫得蔚格",
                            "text": "凯亚队长是知道的，霍肯大概还不了解——我从骑兵小队调走前，被古恩希尔德长官救下过两次，两次这么多哦！"
                        },
                        {
                            "id": "705570205",
                            "speaker": "赫得蔚格",
                            "text": "当时古恩希尔德长官还不是代理团长，虽然比我还年轻，但在剑术比试中，已经可以力压…几乎所有老骑士了！"
                        },
                        {
                            "id": "705570206",
                            "speaker": "赫得蔚格",
                            "text": "只有那个该死的督察长，千刀万剐的叛徒伊洛克…"
                        },
                        {
                            "id": "705570207",
                            "speaker": "赫得蔚格",
                            "text": "好吧，那家伙真的有两下子，非常棘手，能和古恩希尔德长官打个势均力敌，较量六七个回合。"
                        },
                        {
                            "id": "705570208",
                            "speaker": "赫得蔚格",
                            "text": "换我上的话，那家伙两剑下来，我就没戏唱了。",
                            "choices": [
                                {
                                    "id": "705570209",
                                    "text": "依稀记得，我听说过这人…",
                                    "response": [
                                        {
                                            "id": "705570210",
                                            "speaker": "赫得蔚格",
                                            "text": "哎！只能说人心复杂，老骑士们也感慨过，刚招他进来的时候，他也不是那个坏样的。"
                                        },
                                        {
                                            "id": "705570213",
                                            "speaker": "赫得蔚格",
                                            "text": "因为对财富和力量的极度渴望，被人蛊惑，走上了邪路，暗悄悄干了不少脏事，偏偏脑子和武力都很不错。"
                                        },
                                        {
                                            "id": "705570214",
                                            "speaker": "赫得蔚格",
                                            "text": "有心思和他较量计策的人，武力上很难斗过他，武力上胜过他的长官，又经常忙得不可开交，所以被他钻了空子…"
                                        },
                                        {
                                            "id": "705570215",
                                            "speaker": "赫得蔚格",
                                            "text": "一想到，单单他受贿的那枚蓝宝石戒指，就抵得上我们十五个骑士一年的工资，能造出多少城防和公共设施…"
                                        },
                                        {
                                            "id": "705570216",
                                            "speaker": "赫得蔚格",
                                            "text": "还有他那难听又傲慢的声音…我就又来气了，哇啊啊啊啊…头疼！",
                                            "choices": [
                                                {
                                                    "id": "705570217",
                                                    "text": "你冷静点…",
                                                    "response": [
                                                        {
                                                            "id": "705570219",
                                                            "speaker": "赫得蔚格",
                                                            "text": "确实，冷静点冷静点…"
                                                        },
                                                        {
                                                            "id": "705570220",
                                                            "speaker": "赫得蔚格",
                                                            "text": "好在，古恩希尔德长官在与这家伙的第二次正式比试中，就取得了压倒性的优势！"
                                                        },
                                                        {
                                                            "id": "705570221",
                                                            "speaker": "赫得蔚格",
                                                            "text": "啊…不愧是古恩希尔德长官…代理团长！单手剑术最威风的骑士！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "705570218",
                                                    "text": "都过去了…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "705570211",
                                    "text": "没听过的家伙，但好像很坏？",
                                    "response": [
                                        {
                                            "id": "705570212",
                                            "speaker": "赫得蔚格",
                                            "text": "是个衣冠楚楚的恶人，要我评价…放在冒险故事里，足以担任那种中期反派，绝对的硬茬，很难啃。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705570222",
                    "text": "为什么单用姓氏来称呼琴？",
                    "response": [
                        {
                            "id": "705570223",
                            "speaker": "赫得蔚格",
                            "text": "这是荣耀的姓氏！可以说，跟我年纪差不多的骑士，有好多好多都受到了这个姓氏的影响——"
                        },
                        {
                            "id": "705570224",
                            "speaker": "赫得蔚格",
                            "text": "听着赤杨骑士的故事长大，受到鼓舞，努力加入骑士团，又有幸与狮牙骑士共事，为蒙德献出热血与汗水…"
                        },
                        {
                            "id": "705570225",
                            "speaker": "赫得蔚格",
                            "text": "让我觉得，我也能成为传奇故事中的一份子！我这一生实在走运，就是战死也值了呀！",
                            "choices": [
                                {
                                    "id": "705570226",
                                    "text": "不要说这种不吉利的话！",
                                    "response": [
                                        {
                                            "id": "705570228",
                                            "speaker": "赫得蔚格",
                                            "text": "哈哈，别在意别在意，根据小说和戏剧的传统，标志性的宣言，常常起到反向效果…"
                                        },
                                        {
                                            "id": "705570229",
                                            "speaker": "赫得蔚格",
                                            "text": "只要发出这样的宣言，死亡就不会找上我了，哈哈！等到我头发和眉毛都白了，您还可以来找我聊天！"
                                        }
                                    ]
                                },
                                {
                                    "id": "705570227",
                                    "text": "能不能说点好听的！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705570230",
                    "text": "容我再仔细体验一番…",
                    "response": [
                        {
                            "id": "705570231",
                            "speaker": "赫得蔚格",
                            "text": "嗯！祝您玩得尽兴！"
                        }
                    ]
                }
            ]
        }
    ]
}