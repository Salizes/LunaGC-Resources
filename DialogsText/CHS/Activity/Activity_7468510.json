{
    "talkId": "7468510",
    "total_dialogue_lines": 32,
    "speaker_counts": {
        "Player": 8,
        "布蕾斯特": 17,
        "派蒙": 7
    },
    "dialogues": [
        {
            "id": "746851001",
            "speaker": "布蕾斯特",
            "text": "两位，准备好感受「鳄鳄炮炮」的快乐了吗？",
            "choices": [
                {
                    "id": "746851002",
                    "text": "现在就来！",
                    "response": [
                        {
                            "id": "746851003",
                            "speaker": "布蕾斯特",
                            "text": "好的，祝你们玩得开心！"
                        }
                    ]
                },
                {
                    "id": "746851004",
                    "text": "关于你以前的工作…",
                    "response": [
                        {
                            "id": "746851005",
                            "speaker": "布蕾斯特",
                            "text": "如之前所说，我是一名舰炮工程师。不是我自夸，我可是我们组里排名前三的工程师！"
                        },
                        {
                            "id": "746851006",
                            "speaker": "派蒙",
                            "text": "前三？哇！布蕾斯特小姐你好厉害啊！"
                        },
                        {
                            "id": "746851007",
                            "speaker": "布蕾斯特",
                            "text": "嘿嘿，虽然当时我们组一共就只剩三名工程师了。"
                        },
                        {
                            "id": "746851008",
                            "speaker": "派蒙",
                            "text": "那不就是最后一名嘛！"
                        },
                        {
                            "id": "746851009",
                            "speaker": "布蕾斯特",
                            "text": "虽、虽然实力一般，但我运气好啊！我在工作的时候从没出过事故，就连那场恐怖的大爆炸，都被我躲过了。"
                        },
                        {
                            "id": "746851010",
                            "speaker": "布蕾斯特",
                            "text": "在最迷茫的时候，我又偶然接触到了沙蒂永先生的图纸。"
                        },
                        {
                            "id": "746851011",
                            "speaker": "布蕾斯特",
                            "text": "这让我不仅获得了给大家制造和传播快乐的机会，还遇到了最优秀的合作伙伴！不得不说，我还是很幸运的！",
                            "choices": [
                                {
                                    "id": "746851012",
                                    "text": "你的运气确实很好。",
                                    "response": [
                                        {
                                            "id": "746851015",
                                            "speaker": "布蕾斯特",
                                            "text": "呵呵，没错。既然我运气这么好，我相信只要我加倍努力，就一定会有好事情发生的！水上乐园也一定可以轻松建成！",
                                            "choices": [
                                                {
                                                    "id": "746851016",
                                                    "text": "只靠运气可不行…",
                                                    "response": [
                                                        {
                                                            "id": "746851017",
                                                            "speaker": "布蕾斯特",
                                                            "text": "的确，水上乐园可不是这么简单就能建成的。资金，名气等等因素缺一不可…"
                                                        },
                                                        {
                                                            "id": "746851018",
                                                            "speaker": "布蕾斯特",
                                                            "text": "不过，这些我早就算到了！我相信，只要鳄鳄炮炮向娱乐器材的市场发起进攻，一切都会好起来的！"
                                                        },
                                                        {
                                                            "id": "746851019",
                                                            "speaker": "布蕾斯特",
                                                            "text": "当然啦，这最重要的第一步就是宣传鳄鳄炮炮！所以，拜托你们开开心心地体验鳄鳄炮炮，好好感受它的乐趣吧！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "746851020",
                                                    "text": "祝你顺利。",
                                                    "response": [
                                                        {
                                                            "id": "746851021",
                                                            "speaker": "派蒙",
                                                            "text": "加油哦！布雷斯特小姐，你一定可以的！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "746851013",
                                    "text": "确实，我们很优秀。",
                                    "response": [
                                        {
                                            "id": "746851014",
                                            "speaker": "派蒙",
                                            "text": "问题的重点明明在运气上吧！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "746851022",
                    "text": "关于沙蒂永…",
                    "response": [
                        {
                            "id": "746851023",
                            "speaker": "派蒙",
                            "text": "对啊，布蕾斯特小姐有见过沙蒂永先生吗？他还好吗？"
                        },
                        {
                            "id": "746851024",
                            "speaker": "布蕾斯特",
                            "text": "很遗憾，我没有机会见到他。毕竟沙蒂永先生早在我出生前就已经离开人世了…"
                        },
                        {
                            "id": "746851025",
                            "speaker": "派蒙",
                            "text": "沙蒂永先生竟然已经…"
                        },
                        {
                            "id": "746851026",
                            "speaker": "布蕾斯特",
                            "text": "但我确信，他一定度过了一段非常快乐的时光。因为在鳄鳄炮炮的设计资料中，他的文字充满着希望和力量。"
                        },
                        {
                            "id": "746851027",
                            "speaker": "布蕾斯特",
                            "text": "「过去我用大炮对抗外敌，现在我用它来消灭忧愁。和平来之不易，只有振作和快乐，才对得起逝去的人…」"
                        },
                        {
                            "id": "746851028",
                            "speaker": "布蕾斯特",
                            "text": "我正是被沙蒂永先生留下的这句话所激励，方才立志继承他的意志，并重启「鳄鳄炮炮」这个项目。"
                        },
                        {
                            "id": "746851029",
                            "speaker": "派蒙",
                            "text": "沙蒂永先生如果知道了的话，一定会为布蕾斯特小姐感到骄傲的！"
                        },
                        {
                            "id": "746851030",
                            "speaker": "布蕾斯特",
                            "text": "呵呵，那为了沙蒂永先生，也为了振作和快乐，请你们继续操纵鳄鳄炮炮，尽情玩耍吧！"
                        }
                    ]
                },
                {
                    "id": "746851031",
                    "text": "等会儿再来。",
                    "response": [
                        {
                            "id": "746851032",
                            "speaker": "布蕾斯特",
                            "text": "没问题，最近我会一直在这附近，随时欢迎你们来玩！"
                        }
                    ]
                }
            ]
        }
    ]
}