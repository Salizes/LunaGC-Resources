    "dialogues": [
        {
            "id": "736962601",
            "speaker": "巴哈尔",
            "text": "每个人都拿走假条了吗？",
            "choices": [
                {
                    "id": "736962602",
                    "text": "有人选择了其他奖励。",
                    "response": [
                        {
                            "id": "736962605",
                            "speaker": "巴哈尔",
                            "text": "为什么盒子里剩下一张假条？",
                            "choices": [
                                {
                                    "id": "736962606",
                                    "text": "得到这张假条的人连同盒子一起取走了。",
                                    "response": [
                                        {
                                            "id": "736962609",
                                            "speaker": "巴哈尔",
                                            "text": "假条现在的情况是…",
                                            "choices": [
                                                {
                                                    "id": "736962610",
                                                    "text": "所有假条都在应得假条者的手上。"
                                                },
                                                {
                                                    "id": "736962611",
                                                    "text": "有些假条被毁坏了。"
                                                },
                                                {
                                                    "id": "736962612",
                                                    "text": "有些假条没有被取走。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "736962607",
                                    "text": "是属于其他工作人员的假条。"
                                },
                                {
                                    "id": "736962608",
                                    "text": "这张假条废弃了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "736962603",
                    "text": "有人后来被取消了领取假条的资格。"
                },
                {
                    "id": "736962604",
                    "text": "每个人都拿走了假条。"
                }
            ]
        }
    ]
}