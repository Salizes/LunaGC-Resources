    "dialogues": [
        {
            "id": "401577601",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想邀请你去参加音乐庆典。</color>"
        },
        {
            "id": "401577602",
            "speaker": "查尔斯",
            "text": "哈哈，今天是什么好日子？居然来邀请我，难道迪卢克老爷想给我放个假？"
        },
        {
            "id": "401577603",
            "speaker": "派蒙",
            "text": "不是啦！是一个稻妻的音乐交流活动。你要是有喜欢的音乐，我们现在可以弹给你听哦。"
        },
        {
            "id": "401577604",
            "speaker": "查尔斯",
            "text": "喜欢的音乐吗？嗯…我记得，爱德琳女仆长在晨曦酒庄操办过几次小型的家庭音乐会。"
        },
        {
            "id": "401577605",
            "speaker": "查尔斯",
            "text": "有首曲子我挺喜欢的，我尽量把旋律哼出来。可以弹给我听听看吗？"
        },
        {
            "id": "401577606",
            "speaker": "Player",
            "text": "我来试试。"
        },
        {
            "id": "401577607",
            "speaker": "查尔斯",
            "text": "劳驾。"
        }
    ]
}