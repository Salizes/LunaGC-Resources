    "dialogues": [
        {
            "id": "715403001",
            "speaker": "赛诺",
            "text": "我听说，有些人在制作祝柬时，会特意将信纸放在熏香上吹一吹，让纸带上些香味，你知道是为什么吗？",
            "choices": [
                {
                    "id": "715403002",
                    "text": "有，有点不太想问…",
                    "response": [
                        {
                            "id": "715403004",
                            "speaker": "赛诺",
                            "text": "这是在祝愿收到祝柬的人…"
                        },
                        {
                            "id": "715403005",
                            "speaker": "赛诺",
                            "text": "「手气好。」"
                        },
                        {
                            "id": "715403006",
                            "speaker": "Player",
                            "text": "…祝你手气好。"
                        },
                        {
                            "id": "715403007",
                            "speaker": "赛诺",
                            "text": "谢谢。我手气一直很好。"
                        }
                    ]
                },
                {
                    "id": "715403003",
                    "text": "…但是，为什么呢？"
                }
            ]
        }
    ]
