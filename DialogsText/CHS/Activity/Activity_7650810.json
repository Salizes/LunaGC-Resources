{
    "talkId": "7650810",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Player": 9,
        "「弯刀大叔」": 26,
        "主角": 3
    },
    "dialogues": [
        {
            "id": "765081001",
            "speaker": "「弯刀大叔」",
            "text": "#不是，等等…{NICKNAME}老板？努斯妲小妹说的重量级客人，原来是你啊？",
            "choices": [
                {
                    "id": "765081002",
                    "text": "我们是不是…在枫丹见过？",
                    "response": [
                        {
                            "id": "765081003",
                            "speaker": "「弯刀大叔」",
                            "text": "对啊！有个导演请我去搞活动，我还到你的映影城应聘过呢！"
                        },
                        {
                            "id": "765081004",
                            "speaker": "「弯刀大叔」",
                            "text": "没想到这次到了纳塔南边，还能碰见您。早知如此，就叫迪希雅也来了。"
                        },
                        {
                            "id": "765081005",
                            "speaker": "「弯刀大叔」",
                            "text": "可惜，迪希雅在忙别的事，这次没能一起过来。她肯定喜欢这样的场合，和那位冲浪高手也能聊得来！",
                            "choices": [
                                {
                                    "id": "765081006",
                                    "text": "我最近见到她了！",
                                    "response": [
                                        {
                                            "id": "765081008",
                                            "speaker": "「弯刀大叔」",
                                            "text": "可不是嘛！毕竟这些年来，雨林和沙漠的两边的交流越来越频繁了。"
                                        },
                                        {
                                            "id": "765081009",
                                            "speaker": "「弯刀大叔」",
                                            "text": "迪希雅除了管理「炽光猎兽」的工作，还总要和坎蒂丝女士一起，叫上她在雨林那边的朋友，在两边开展协调工作。"
                                        },
                                        {
                                            "id": "765081010",
                                            "speaker": "「弯刀大叔」",
                                            "text": "这些细活，我们这样的粗人完全看不懂！"
                                        },
                                        {
                                            "id": "765081011",
                                            "speaker": "「弯刀大叔」",
                                            "text": "所以，为了不让迪希雅太累，好多兄弟姐妹都开始念书学算术了，争取尽早帮迪希雅分摊些工作…"
                                        },
                                        {
                                            "id": "765081012",
                                            "speaker": "「弯刀大叔」",
                                            "text": "到时候，你应该能在各种地方碰见休假的迪希雅！"
                                        }
                                    ]
                                },
                                {
                                    "id": "765081007",
                                    "text": "她也是大忙人哦！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "765081013",
                    "text": "对你没什么印象了…",
                    "response": [
                        {
                            "id": "765081014",
                            "speaker": "「弯刀大叔」",
                            "text": "#没关系！我是迪希雅团里的弟兄，而你是迪希雅最重要的朋友，所以，等于我们的{M#大哥}{F#大姐}！"
                        },
                        {
                            "id": "765081015",
                            "speaker": "「弯刀大叔」",
                            "text": "在外面，咱们都听你的！比如，这次聚会结束后，如果你有需要，指到哪，兄弟们就打到哪。",
                            "choices": [
                                {
                                    "id": "765081016",
                                    "text": "不用不用，放轻松！",
                                    "response": [
                                        {
                                            "id": "765081018",
                                            "speaker": "「弯刀大叔」",
                                            "text": "也对…以你的手腕，不管在哪，应该都能摆平敌人。我也得放松心态，不是到哪都有架打的…"
                                        },
                                        {
                                            "id": "765081019",
                                            "speaker": "「弯刀大叔」",
                                            "text": "纳塔最好斗的战士，也只是热衷于切磋纯粹的战斗技巧，很讲武德！"
                                        },
                                        {
                                            "id": "765081020",
                                            "speaker": "「弯刀大叔」",
                                            "text": "这样看来，除了穿过巨人峡谷西边那片沙地的一段路程，完全不用担心塔拉内，以后她说不定能自己独自过来旅游…"
                                        },
                                        {
                                            "id": "765081021",
                                            "speaker": "主角",
                                            "text": "塔拉内？"
                                        },
                                        {
                                            "id": "765081022",
                                            "speaker": "「弯刀大叔」",
                                            "text": "哦，她是我兄弟的女儿，我也算是看着她从小长到大了！"
                                        },
                                        {
                                            "id": "765081023",
                                            "speaker": "「弯刀大叔」",
                                            "text": "塔拉内她爸啊，在以前的战斗里帮我挡下了致命的一箭…"
                                        },
                                        {
                                            "id": "765081024",
                                            "speaker": "主角",
                                            "text": "……"
                                        },
                                        {
                                            "id": "765081025",
                                            "speaker": "「弯刀大叔」",
                                            "text": "然后在养伤的几年里吃得太胖，减不下肥，转行去做货运生意了。"
                                        },
                                        {
                                            "id": "765081026",
                                            "speaker": "「弯刀大叔」",
                                            "text": "现在在奥摩斯港混得还算不错，每隔一两月，就会请兄弟们去吃饭喝酒。"
                                        },
                                        {
                                            "id": "765081027",
                                            "speaker": "「弯刀大叔」",
                                            "text": "这次请妮露老师来当顾问，还有所有人一起旅游的盘缠，就是我这哥们全包的。"
                                        },
                                        {
                                            "id": "765081028",
                                            "speaker": "主角",
                                            "text": "（松了口气…）"
                                        },
                                        {
                                            "id": "765081029",
                                            "speaker": "「弯刀大叔」",
                                            "text": "说起来也挺有意思的，我们和努斯妲小妹一行认识后，约好来纳塔玩玩，一想到，既然要跳舞，那就带上塔拉内吧…"
                                        },
                                        {
                                            "id": "765081030",
                                            "speaker": "「弯刀大叔」",
                                            "text": "结果塔拉内对自己的舞技有点不自信，提出请妮露老师当顾问，又苦于从没和自己的偶像搭过话…"
                                        },
                                        {
                                            "id": "765081031",
                                            "speaker": "「弯刀大叔」",
                                            "text": "于是我们提议迪希雅写一封介绍信，顺着礼物一起送过去，办法还挺管用！"
                                        },
                                        {
                                            "id": "765081032",
                                            "speaker": "「弯刀大叔」",
                                            "text": "来了纳塔，她们又遇见了那位冲浪高手，太合得来了…看她们玩得这么开心，我和塔拉内她爸都放心了不少。"
                                        },
                                        {
                                            "id": "765081033",
                                            "speaker": "「弯刀大叔」",
                                            "text": "有了这次旅行的经历，塔拉内应该能从之前不愉快的心境里走出来了！",
                                            "choices": [
                                                {
                                                    "id": "765081034",
                                                    "text": "这是好事！",
                                                    "response": [
                                                        {
                                                            "id": "765081036",
                                                            "speaker": "「弯刀大叔」",
                                                            "text": "是啊，所以说，和阳光的朋友在一起，多出去活动活动，对人的心态大有好处！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "765081035",
                                                    "text": "恭喜她哦！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "765081017",
                                    "text": "眼下享受和平假期就好！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "765081037",
                    "text": "你先忙，回头聊！",
                    "response": [
                        {
                            "id": "765081038",
                            "speaker": "「弯刀大叔」",
                            "text": "我不忙！等你有空，什么时候来找我都成！"
                        }
                    ]
                }
            ]
        }
    ]
}