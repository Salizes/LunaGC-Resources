    },
    "dialogues": [
        {
            "id": "401440801",
            "speaker": "丽莎",
            "text": "小可爱有什么疑问吗？",
            "choices": [
                {
                    "id": "401440802",
                    "text": "关于炼制药剂。",
                    "response": [
                        {
                            "id": "401440803",
                            "speaker": "丽莎",
                            "text": "只要把药材放进炼金釜，按照步骤操作，就能炼制出药剂了。"
                        },
                        {
                            "id": "401440804",
                            "speaker": "丽莎",
                            "text": "根据加入药材的种类不同，最终炼制出的药剂也会发生变化。可以多尝试不同的组合。"
                        }
                    ]
                },
                {
                    "id": "401440805",
                    "text": "关于培育药材。",
                    "response": [
                        {
                            "id": "401440806",
                            "speaker": "丽莎",
                            "text": "这批药材经过了生物炼金技术的处理，带有不同的功效和特征。可以根据想要炼制的药剂，培育对应的药材哦。"
                        }
                    ]
                },
                {
                    "id": "401440807",
                    "text": "关于市场消息。",
                    "response": [
                        {
                            "id": "401440808",
                            "speaker": "丽莎",
                            "text": "具体要炼制什么样的药剂，就要参考市场消息了。"
                        },
                        {
                            "id": "401440809",
                            "speaker": "丽莎",
                            "text": "姐姐已经贴心地将近期的市场消息都整理好了，你在货架那边就能看到啦。"
                        }
                    ]
                },
                {
                    "id": "401440810",
                    "text": "没什么了。",
                    "response": [
                        {
                            "id": "401440811",
                            "speaker": "丽莎",
                            "text": "呵呵，有问题的话要及时跟姐姐说哦。"
                        }
                    ]
                }
            ]
        }
    ]
}