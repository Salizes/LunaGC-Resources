    "dialogues": [
        {
            "id": "711570401",
            "speaker": "嘉明",
            "text": "行，飞得挺高的，接下来…",
            "choices": [
                {
                    "id": "711570402",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711570404",
                            "speaker": "嘉明",
                            "text": "好漂亮的霄灯啊…哎哟，对了对了，等会我还要去给镖局里的兄弟们买几盏霄灯。"
                        },
                        {
                            "id": "711570405",
                            "speaker": "嘉明",
                            "text": "他们刚押了一趟急镖回来，肯定没空准备这些…"
                        }
                    ]
                },
                {
                    "id": "711570403",
                    "text": "再见啦，海灯节快乐。",
                    "response": [
                        {
                            "id": "711570406",
                            "speaker": "嘉明",
                            "text": "也祝你海灯节快乐，恭喜发财，恭喜发财啊！"
                        }
                    ]
                }
            ]
        }
    ]
