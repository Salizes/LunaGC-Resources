{
    "talkId": "4141440",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "莉兹": 9
    },
    "dialogues": [
        {
            "id": "414144001",
            "speaker": "Player",
            "text": "你是做什么的？"
        },
        {
            "id": "414144002",
            "speaker": "莉兹",
            "text": "我在这里招待客人，为大家介绍风花节期间在蒙德举办的各种各样的好玩活动。"
        },
        {
            "id": "414144003",
            "speaker": "莉兹",
            "text": "因为需要宽敞的场地，所以很多活动的举办地点都选在了城外，如果没有人告诉大家位置的话，许多人就会错过这些乐趣了！"
        },
        {
            "id": "414144004",
            "speaker": "莉兹",
            "text": "所以，承担介绍工作的，就是我莉兹啦！",
            "choices": [
                {
                    "id": "414144005",
                    "text": "都有什么活动？",
                    "response": [
                        {
                            "id": "414144006",
                            "speaker": "莉兹",
                            "text": "这次预定举办的活动有三项，「百发百中」，「风中万花」，「风物之歌」。"
                        },
                        {
                            "id": "414144007",
                            "speaker": "莉兹",
                            "text": "具体的活动形式，比起我来介绍，还是实际去尝试一下更容易理解。"
                        },
                        {
                            "id": "414144008",
                            "speaker": "莉兹",
                            "text": "只要活动准备就绪，我就会告诉你举办的位置。"
                        },
                        {
                            "id": "414144009",
                            "speaker": "莉兹",
                            "text": "祝你度过一个愉快的风花节！"
                        }
                    ]
                },
                {
                    "id": "414144010",
                    "text": "还有其他有趣的事吗？",
                    "response": [
                        {
                            "id": "414144011",
                            "speaker": "莉兹",
                            "text": "我听说，冒险家协会也准备了特别的风花节活动。"
                        },
                        {
                            "id": "414144012",
                            "speaker": "莉兹",
                            "text": "如果有兴趣的话，就去找冒险家卜劳恩吧，他会为你介绍的！"
                        }
                    ]
                }
            ]
        }
    ]
}