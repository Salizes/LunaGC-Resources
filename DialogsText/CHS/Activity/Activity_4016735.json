{
    "talkId": "4016735",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Wanderer": 6,
        "赛诺": 7
    },
    "dialogues": [
        {
            "id": "401673501",
            "speaker": "赛诺",
            "text": "嗯？这不是「阿帽」吗？赛索斯最近常提起你。"
        },
        {
            "id": "401673502",
            "speaker": "Wanderer",
            "text": "这不是大风纪官吗？你也有劝人去过节的兴趣？"
        },
        {
            "id": "401673503",
            "speaker": "赛诺",
            "text": "我回教令院查些东西，路过了就和你打声招呼而已。"
        },
        {
            "id": "401673504",
            "speaker": "赛诺",
            "text": "不过…我对你确实有些兴趣。"
        },
        {
            "id": "401673505",
            "speaker": "Wanderer",
            "text": "……"
        },
        {
            "id": "401673506",
            "speaker": "赛诺",
            "text": "你打「七圣召唤」吗？"
        },
        {
            "id": "401673507",
            "speaker": "Wanderer",
            "text": "不打。"
        },
        {
            "id": "401673508",
            "speaker": "赛诺",
            "text": "那我就放心了。"
        },
        {
            "id": "401673509",
            "speaker": "Wanderer",
            "text": "啊？"
        },
        {
            "id": "401673510",
            "speaker": "赛诺",
            "text": "你知道你打牌的话会发生什么吗？"
        },
        {
            "id": "401673511",
            "speaker": "Wanderer",
            "text": "我不打。"
        },
        {
            "id": "401673512",
            "speaker": "赛诺",
            "text": "你的牌…会变成「帽」牌货！"
        },
        {
            "id": "401673513",
            "speaker": "Wanderer",
            "text": "……"
        }
    ]
}