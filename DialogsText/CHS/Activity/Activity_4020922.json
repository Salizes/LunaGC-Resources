{
    "talkId": "4020922",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "娜维娅": 9,
        "派蒙": 5
    },
    "dialogues": [
        {
            "id": "402092201",
            "speaker": "娜维娅",
            "text": "虽然出了点让人不安的意外，但暂时不会影响到我们的展位…要来和芒荒弹幕机关继续切磋吗？",
            "choices": [
                {
                    "id": "402092202",
                    "text": "来吧，我手感火热！",
                    "response": [
                        {
                            "id": "402092203",
                            "speaker": "派蒙",
                            "text": "嗯，我们就好好见识一下，妙妙芒荒机关的实力！"
                        },
                        {
                            "id": "402092204",
                            "speaker": "娜维娅",
                            "text": "好呀，准备开始，祝你们玩得开心！"
                        }
                    ]
                },
                {
                    "id": "402092205",
                    "text": "想和娜维娅聊会儿天。",
                    "response": [
                        {
                            "id": "402092206",
                            "speaker": "派蒙",
                            "text": "对哦，说起来，娜维娅之前不常来挪德卡莱吧？要不要在附近逛上几圈？"
                        },
                        {
                            "id": "402092207",
                            "speaker": "娜维娅",
                            "text": "有哦有哦，我和克洛琳德把那夏镇里的店都看过了。"
                        },
                        {
                            "id": "402092208",
                            "speaker": "娜维娅",
                            "text": "我感觉，挪德卡莱的一些商品啊，充斥着「混乱」的活力，这是怎么都不会出现在枫丹橱窗里的要素。"
                        },
                        {
                            "id": "402092209",
                            "speaker": "娜维娅",
                            "text": "精致的商品确实赏心悦目，不过，总是规规矩矩，有时也感觉少了点什么，挪德卡莱的风格正好弥补了这一点…"
                        },
                        {
                            "id": "402092210",
                            "speaker": "娜维娅",
                            "text": "比如，轻敲两下就能像花瓣一样张开，喷出水雾和灯光来的须弥花瓶，还有内藏播音装置，可以放音乐催眠的机关枕头…"
                        },
                        {
                            "id": "402092211",
                            "speaker": "派蒙",
                            "text": "好像明白了，娜维娅觉得，适当来点…「反套路」的惊喜，也挺有意思的？"
                        },
                        {
                            "id": "402092212",
                            "speaker": "派蒙",
                            "text": "我支持这个看法！唔…一成不变的，漂亮的外表，肯定不如趣味多多的新奇设计！",
                            "choices": [
                                {
                                    "id": "402092213",
                                    "text": "说起来，这些是在哪买的？",
                                    "response": [
                                        {
                                            "id": "402092215",
                                            "speaker": "娜维娅",
                                            "text": "啊，从旗舰出门左转，下个坡就到了，我以为你们也常去呢！"
                                        },
                                        {
                                            "id": "402092216",
                                            "speaker": "娜维娅",
                                            "text": "那位个子小小的老板人还挺好，看我是稀客，给我打了八折哦！以后，我让刺玫会的朋友们也多多关照她的生意！"
                                        }
                                    ]
                                },
                                {
                                    "id": "402092214",
                                    "text": "平常没见挪德卡莱卖这些啊…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "402092217",
                    "text": "暂时还要忙别的。",
                    "response": [
                        {
                            "id": "402092218",
                            "speaker": "派蒙",
                            "text": "嗯，等到有空了，我们就来找你哦！"
                        },
                        {
                            "id": "402092219",
                            "speaker": "娜维娅",
                            "text": "去吧去吧，把事情办妥了，再安安心心轻轻松松回来玩！"
                        }
                    ]
                }
            ]
        }
    ]
}