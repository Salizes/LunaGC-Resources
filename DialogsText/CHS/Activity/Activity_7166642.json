    "dialogues": [
        {
            "id": "716664201",
            "speaker": "「装备碾压型选手」",
            "text": "#啊呀，{NICKNAME}，还想再和我玩一局斗虫吗？",
            "choices": [
                {
                    "id": "716664202",
                    "text": "开玩开玩！",
                    "response": [
                        {
                            "id": "716664203",
                            "speaker": "「装备碾压型选手」",
                            "text": "嘿！说不定这次，我能找到新的诀窍，打你个措手不及哦！"
                        }
                    ]
                },
                {
                    "id": "716664204",
                    "text": "烟绯最近忙吗？",
                    "response": [
                        {
                            "id": "716664205",
                            "speaker": "「装备碾压型选手」",
                            "text": "没事没事，我还好啦！"
                        },
                        {
                            "id": "716664206",
                            "speaker": "「装备碾压型选手」",
                            "text": "就算是律法专家，也不是每天都要帮人处理诉讼的嘛。"
                        },
                        {
                            "id": "716664207",
                            "speaker": "「装备碾压型选手」",
                            "text": "正好，趁着师妹和师弟们聚会的空档，我直接把年假全都用掉！"
                        },
                        {
                            "id": "716664208",
                            "speaker": "「装备碾压型选手」",
                            "text": "吃个爽快，睡个痛快，玩得开心，才能以最饱满的精神回到之后的工作中去。"
                        },
                        {
                            "id": "716664209",
                            "speaker": "「装备碾压型选手」",
                            "text": "这样才算是快乐生活！"
                        }
                    ]
                },
                {
                    "id": "716664210",
                    "text": "回见了，烟绯！",
                    "response": [
                        {
                            "id": "716664211",
                            "speaker": "「装备碾压型选手」",
                            "text": "好呀，有空的时候，可以再来教我玩玩这个游戏哦！"
                        }
                    ]
                }
            ]
        }
    ]
}