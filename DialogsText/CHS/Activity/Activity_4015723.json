        {
            "id": "401572301",
            "speaker": "Player",
            "text": "阅读来信"
        },
        {
            "id": "401572302",
            "speaker": "字迹潇洒的信件",
            "text": "在离岛询问了一些居民，几乎没人听说过所谓的战场上的忍犬。"
        },
        {
            "id": "401572303",
            "speaker": "字迹潇洒的信件",
            "text": "消息之少，出乎了我的预料，即使是小范围的传播，也不应该如此。"
        },
        {
            "id": "401572304",
            "speaker": "字迹潇洒的信件",
            "text": "我会再找找线索。"
        }
    ]
}