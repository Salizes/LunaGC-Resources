{
    "talkId": "7651105",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 6,
        "泽西切": 22
    },
    "dialogues": [
        {
            "id": "765110501",
            "speaker": "泽西切",
            "text": "你好，最终试炼人，现在就和选手们过两招吗？",
            "choices": [
                {
                    "id": "765110502",
                    "text": "战斗吧。",
                    "response": [
                        {
                            "id": "765110503",
                            "speaker": "泽西切",
                            "text": "好的，那请随我乘船前往赛场。"
                        }
                    ]
                },
                {
                    "id": "765110504",
                    "text": "我们之前是不是见过？",
                    "response": [
                        {
                            "id": "765110505",
                            "speaker": "泽西切",
                            "text": "你还记得啊，记性真好。"
                        },
                        {
                            "id": "765110506",
                            "speaker": "泽西切",
                            "text": "在执灯人的办事处，调查异常案件的那次，我被奈芙尔女士叫来，办了个手续。"
                        },
                        {
                            "id": "765110507",
                            "speaker": "泽西切",
                            "text": "感谢你为索西军士长所做的一切。"
                        }
                    ]
                },
                {
                    "id": "765110508",
                    "text": "原来执灯士也会当评委？",
                    "response": [
                        {
                            "id": "765110509",
                            "speaker": "泽西切",
                            "text": "你是奈芙尔女士的合作伙伴，那就不瞒着你了。"
                        },
                        {
                            "id": "765110510",
                            "speaker": "泽西切",
                            "text": "这次大赛原本和「执灯人」无关，我们一般不会参与这种活动。"
                        },
                        {
                            "id": "765110511",
                            "speaker": "泽西切",
                            "text": "不过，为了提高「执灯人」的战备水平，我们有必要准确评估各方人士的战力。"
                        },
                        {
                            "id": "765110512",
                            "speaker": "泽西切",
                            "text": "于我个人，情报也多多益善。"
                        },
                        {
                            "id": "765110513",
                            "speaker": "泽西切",
                            "text": "所以我就答应了萨林，代他主持这次比赛。"
                        },
                        {
                            "id": "765110514",
                            "speaker": "泽西切",
                            "text": "从结果而言，的确见识到了不少能人异士。不过在你来之前，他们因为遭到最后这三位高手淘汰，基本都离场了。"
                        },
                        {
                            "id": "765110515",
                            "speaker": "泽西切",
                            "text": "其实，我很好奇枫原先生认真出手时的效果。"
                        },
                        {
                            "id": "765110516",
                            "speaker": "泽西切",
                            "text": "三位冠军候选人已经是顶尖高手了，在我个人看来，挪德卡莱本地只有奈芙尔女士、菲林斯、叶洛亚长官和雅珂达在他们之上。"
                        },
                        {
                            "id": "765110517",
                            "speaker": "泽西切",
                            "text": "但枫原先生彬彬有礼，举止随和，总给我一种深不可测的感觉。"
                        },
                        {
                            "id": "765110518",
                            "speaker": "泽西切",
                            "text": "精彩到让我惊呼的比拼，他似乎早就司空见惯了，一直平静而客观地点评。"
                        },
                        {
                            "id": "765110519",
                            "speaker": "泽西切",
                            "text": "当然，那种谦逊却又波澜不惊的态度，值得每位战士…或者文雅点，值得每位「武人」学习。",
                            "choices": [
                                {
                                    "id": "765110520",
                                    "text": "他是和我出生入死过的搭档哦。",
                                    "response": [
                                        {
                                            "id": "765110521",
                                            "speaker": "泽西切",
                                            "text": "难怪，你们相处的感觉，就像是经历过血战的战友。"
                                        },
                                        {
                                            "id": "765110522",
                                            "speaker": "泽西切",
                                            "text": "有资格和你并肩面对强敌…这个身份，的确令人肃然起敬。"
                                        },
                                        {
                                            "id": "765110526",
                                            "speaker": "泽西切",
                                            "text": "这场比试结束后，我再以个人名义宴请枫原先生好了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "765110523",
                                    "text": "他挡下过神明的一刀哦。",
                                    "response": [
                                        {
                                            "id": "765110524",
                                            "speaker": "泽西切",
                                            "text": "…是某种比喻吗？这比方实在震撼人心。"
                                        },
                                        {
                                            "id": "765110525",
                                            "speaker": "泽西切",
                                            "text": "连你都给出了这么高的评价，看来我之前还是失敬了…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "765110527",
                    "text": "待会儿再来。",
                    "response": [
                        {
                            "id": "765110528",
                            "speaker": "泽西切",
                            "text": "那你先忙，正好也给他们三位一点准备时间。"
                        }
                    ]
                }
            ]
        }
    ]
}