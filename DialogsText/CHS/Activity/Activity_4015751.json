    "dialogues": [
        {
            "id": "401575101",
            "speaker": "朗清",
            "text": "#{NICKNAME}？久仰大名！芳芳给我说过你的事。",
            "choices": [
                {
                    "id": "401575102",
                    "text": "你是？",
                    "response": [
                        {
                            "id": "401575103",
                            "speaker": "朗清",
                            "text": "哦！忘了自我介绍，我是朗清，芳芳是我夫人，就是万文集舍的纪芳，她跟我说了这次摇滚庆典的事。"
                        },
                        {
                            "id": "401575104",
                            "speaker": "朗清",
                            "text": "其实我倒不懂什么摇滚啦，但芳芳说要支持一下文化交流，就把我赶了过来。"
                        },
                        {
                            "id": "401575105",
                            "speaker": "朗清",
                            "text": "我还带了一些免费的文创品，没想到一到这里就发完了，早知道我该多准备些。"
                        },
                        {
                            "id": "401575106",
                            "speaker": "朗清",
                            "text": "对了，她还让我跟你说，谢谢你的邀请，如果不是走不开，她肯定会亲自过来一趟。"
                        },
                        {
                            "id": "401575107",
                            "speaker": "朗清",
                            "text": "希望你们也能玩得开心。"
                        }
                    ]
                },
                {
                    "id": "401575108",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "401575109",
                            "speaker": "朗清",
                            "text": "嗯，再见。"
                        }
                    ]
                }
            ]
        }
    ]
}