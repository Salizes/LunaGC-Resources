{
    "talkId": "7550803",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "玛拉妮": 11
    },
    "dialogues": [
        {
            "id": "755080301",
            "speaker": "玛拉妮",
            "text": "#哟，{NICKNAME}，精神满满嘛！",
            "choices": [
                {
                    "id": "755080302",
                    "text": "说起来，玛拉妮喜欢什么歌？",
                    "response": [
                        {
                            "id": "755080303",
                            "speaker": "玛拉妮",
                            "text": "我啊？哈哈，我不挑！"
                        },
                        {
                            "id": "755080304",
                            "speaker": "玛拉妮",
                            "text": "悠闲的、热情的、轻松愉快的歌，我都能接受！"
                        },
                        {
                            "id": "755080305",
                            "speaker": "玛拉妮",
                            "text": "至于旋律比较低沉，氛围很正式的音乐，我可能没法跟着摇摆…我不常听，但也不反感！"
                        }
                    ]
                },
                {
                    "id": "755080306",
                    "text": "有什么游玩建议嘛？",
                    "response": [
                        {
                            "id": "755080307",
                            "speaker": "玛拉妮",
                            "text": "嗯，让我想想…"
                        },
                        {
                            "id": "755080308",
                            "speaker": "玛拉妮",
                            "text": "凭我打沙滩排球的经验，太过紧张的话，反而有可能发挥失常。"
                        },
                        {
                            "id": "755080309",
                            "speaker": "玛拉妮",
                            "text": "有时看着飞来的撞球，思考太多条件，反而会左右为难！"
                        },
                        {
                            "id": "755080310",
                            "speaker": "玛拉妮",
                            "text": "适当放空思维，让身体跟着直觉作出反应！"
                        },
                        {
                            "id": "755080311",
                            "speaker": "Player",
                            "text": "原来如此，我试试！"
                        },
                        {
                            "id": "755080312",
                            "speaker": "玛拉妮",
                            "text": "当然，遇上了需要比拼策略的游戏，或者更严肃的事，完全依靠直觉是行不通的，要好好考虑行动的后果哦。"
                        },
                        {
                            "id": "755080313",
                            "speaker": "玛拉妮",
                            "text": "张弛有度才是关键！"
                        }
                    ]
                },
                {
                    "id": "755080314",
                    "text": "游戏不错，我再玩玩！",
                    "response": [
                        {
                            "id": "755080315",
                            "speaker": "玛拉妮",
                            "text": "嘿！以你的实力，多玩几局，就能创下没人能超越的分数啦！"
                        }
                    ]
                }
            ]
        }
    ]
}