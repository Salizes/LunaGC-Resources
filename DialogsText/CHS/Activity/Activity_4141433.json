{
    "talkId": "4141433",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "艾伯特": 7
    },
    "dialogues": [
        {
            "id": "414143301",
            "speaker": "Player",
            "text": "你的作业完成得怎么样了？"
        },
        {
            "id": "414143302",
            "speaker": "艾伯特",
            "text": "哦，你说温迪老师的作业啊…"
        },
        {
            "id": "414143303",
            "speaker": "艾伯特",
            "text": "放心吧，虽然为芭芭拉大人准备礼物是头等大事，但创作饱含情感的诗歌也同样重要。"
        },
        {
            "id": "414143304",
            "speaker": "艾伯特",
            "text": "那么，就让你听听凝聚了粉丝心意的力作吧！"
        },
        {
            "id": "414143305",
            "speaker": "艾伯特",
            "text": "「世界上最远的距离\\n不是生与死的距离\\n而是我站在教堂窗外\\n你在窗里」",
            "choices": [
                {
                    "id": "414143306",
                    "text": "诗不错，想法一般。",
                    "response": [
                        {
                            "id": "414143308",
                            "speaker": "艾伯特",
                            "text": "唉，看来你还是缺乏一些灵性，无法理解我们对芭芭拉大人的崇敬之情…"
                        },
                        {
                            "id": "414143309",
                            "speaker": "艾伯特",
                            "text": "不过没关系，日子还长呢。加油，旅行者！"
                        },
                        {
                            "id": "414143310",
                            "speaker": "艾伯特",
                            "text": "嗯，等我再斟酌一番，修改出更好的版本，就能交作业给温迪老师了。"
                        }
                    ]
                },
                {
                    "id": "414143307",
                    "text": "下次不要偷看了，好吗？"
                }
            ]
        }
    ]
}