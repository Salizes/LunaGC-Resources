{
    "talkId": "7350637",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "丽莎": 4,
        "柯莱": 5
    },
    "dialogues": [
        {
            "id": "735063701",
            "speaker": "柯莱",
            "text": "放心吧，丽莎小姐，我现在很好。",
            "choices": [
                {
                    "id": "735063702",
                    "text": "你们好。",
                    "response": [
                        {
                            "id": "735063704",
                            "speaker": "丽莎",
                            "text": "我来这里是想探望一位以前的朋友，但没想到她已经在这里当上了见习巡林员呀。"
                        },
                        {
                            "id": "735063705",
                            "speaker": "柯莱",
                            "text": "嘿嘿，这其实没什么，我只是想帮上提纳里师父的忙。"
                        },
                        {
                            "id": "735063706",
                            "speaker": "丽莎",
                            "text": "看样子，小柯莱在须弥认识了不少新朋友呢。"
                        },
                        {
                            "id": "735063707",
                            "speaker": "柯莱",
                            "text": "而且我也有努力认字，现在我已经能读一些简单的句子了！"
                        },
                        {
                            "id": "735063708",
                            "speaker": "柯莱",
                            "text": "师父和须弥的大家都很关照我，不过我从来没有忘记蒙德的朋友们，最近我一直想找个时间回去探望一次。"
                        },
                        {
                            "id": "735063709",
                            "speaker": "柯莱",
                            "text": "丽莎小姐，大家怎么样？都还好吗？安柏好吗？琴小姐好吗？凯亚先生…"
                        },
                        {
                            "id": "735063710",
                            "speaker": "丽莎",
                            "text": "哈哈，小柯莱不要着急哦，等我慢慢跟你说…"
                        },
                        {
                            "id": "735063711",
                            "speaker": "丽莎",
                            "text": "抱歉，小可爱，给我一点时间，让我和小柯莱好好说说蒙德的事吧。"
                        }
                    ]
                },
                {
                    "id": "735063703",
                    "text": "居然又遇到了丽莎。"
                }
            ]
        }
    ]
}