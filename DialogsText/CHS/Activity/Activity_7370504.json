{
    "talkId": "7370504",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 6,
        "安柏": 15,
        "柯莱": 10
    },
    "dialogues": [
        {
            "id": "737050401",
            "speaker": "安柏",
            "text": "#哟，{NICKNAME}！状态还好吗？要不要试试「翠星柯里安巴」和「赤红飞兔伯爵」的全速冲刺？"
        },
        {
            "id": "737050402",
            "speaker": "柯莱",
            "text": "两位「侦察伙伴」已经调试完毕了，一切就绪！",
            "choices": [
                {
                    "id": "737050403",
                    "text": "那就开始吧！",
                    "response": [
                        {
                            "id": "737050404",
                            "speaker": "安柏",
                            "text": "好呀！有点找回飞行测试那时的感觉了！"
                        }
                    ]
                },
                {
                    "id": "737050405",
                    "text": "柯莱忙得过来吗？",
                    "response": [
                        {
                            "id": "737050406",
                            "speaker": "柯莱",
                            "text": "请放心，这座小站也兼作「稳健知行」的临时办事处。"
                        },
                        {
                            "id": "737050407",
                            "speaker": "柯莱",
                            "text": "平时，我就一起和安柏处理「侦察伙伴」的实测数据，填填表。"
                        },
                        {
                            "id": "737050408",
                            "speaker": "安柏",
                            "text": "还有还有，给出内部机关的修改建议！"
                        },
                        {
                            "id": "737050409",
                            "speaker": "安柏",
                            "text": "如果考察队伍过来了，我们就去登记信息，确认他们是否需要紧急训练，然后办理出行手续，分配人员和装备…"
                        },
                        {
                            "id": "737050410",
                            "speaker": "安柏",
                            "text": "然后就是时刻注意这个营地的物资补给，和后勤人员沟通…",
                            "choices": [
                                {
                                    "id": "737050411",
                                    "text": "这么多事？好忙！",
                                    "response": [
                                        {
                                            "id": "737050413",
                                            "speaker": "柯莱",
                                            "text": "没事没事，只是暂时的。这个机构刚刚起步不久，一切都在建设中。"
                                        },
                                        {
                                            "id": "737050414",
                                            "speaker": "安柏",
                                            "text": "不用担心，起码，确认学生们的出行资格，还有关注后勤物资这些活儿，我很拿手！"
                                        },
                                        {
                                            "id": "737050415",
                                            "speaker": "柯莱",
                                            "text": "教令院还会调遣后续的专家，建立一支正规的文书工作组，根据我们的指示进行工作。"
                                        },
                                        {
                                            "id": "737050416",
                                            "speaker": "柯莱",
                                            "text": "那边已经有几位专家就位了，等到他们进入状态，学者们给出完备的认证，我们就可以慢慢把工作交接出去。"
                                        },
                                        {
                                            "id": "737050417",
                                            "speaker": "安柏",
                                            "text": "然后就能开开心心休息一段时间啦！"
                                        },
                                        {
                                            "id": "737050418",
                                            "speaker": "Player",
                                            "text": "安柏去须弥各地玩过了吗？"
                                        },
                                        {
                                            "id": "737050419",
                                            "speaker": "安柏",
                                            "text": "嘿嘿，出发之前，我找丽莎小姐和凯亚队长好好咨询过一番，做好了旅行计划。"
                                        },
                                        {
                                            "id": "737050420",
                                            "speaker": "安柏",
                                            "text": "不过，这次时间有点紧，柯莱先带我在须弥城里逛了逛，享受了很棒很棒的本地美食。"
                                        },
                                        {
                                            "id": "737050421",
                                            "speaker": "安柏",
                                            "text": "看柯莱这么忙，我也不好意思叫她陪我到处跑。相反，应该是我多陪陪她，帮帮忙才对。"
                                        },
                                        {
                                            "id": "737050422",
                                            "speaker": "柯莱",
                                            "text": "对不起，安柏…"
                                        },
                                        {
                                            "id": "737050423",
                                            "speaker": "安柏",
                                            "text": "哎呀，你干嘛道歉？我明明很开心！"
                                        },
                                        {
                                            "id": "737050424",
                                            "speaker": "安柏",
                                            "text": "因为，我亲眼见识到了，现在的柯莱稳重又可靠，是须弥的朋友们信任…甚至依靠的对象！"
                                        },
                                        {
                                            "id": "737050425",
                                            "speaker": "安柏",
                                            "text": "旅行和玩乐什么的，随时都可以出发嘛，我又不是只来这一次。"
                                        },
                                        {
                                            "id": "737050426",
                                            "speaker": "安柏",
                                            "text": "你把「稳健知行」的工作办得稳稳当当以后，我们再安安心心去玩也不迟！"
                                        },
                                        {
                                            "id": "737050427",
                                            "speaker": "柯莱",
                                            "text": "呜…感觉…更有干劲了…"
                                        },
                                        {
                                            "id": "737050428",
                                            "speaker": "柯莱",
                                            "text": "我一定要好好工作，把一切事务处理得妥妥当当，不让安柏操心！"
                                        }
                                    ]
                                },
                                {
                                    "id": "737050412",
                                    "text": "应该给你们俩多发几份工资。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "737050429",
                    "text": "待会儿再来试试！",
                    "response": [
                        {
                            "id": "737050430",
                            "speaker": "安柏",
                            "text": "好哦，不着急不着急，你先忙手头的事！"
                        },
                        {
                            "id": "737050431",
                            "speaker": "柯莱",
                            "text": "我们随时等你！"
                        }
                    ]
                }
            ]
        }
    ]
}