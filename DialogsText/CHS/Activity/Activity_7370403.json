{
    "talkId": "7370403",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "Player": 2,
        "兰吉特": 5
    },
    "dialogues": [
        {
            "id": "737040301",
            "speaker": "兰吉特",
            "text": "我已经准备万全了。还是说你想聊聊？",
            "choices": [
                {
                    "id": "737040302",
                    "text": "关于昆图尔的故事…",
                    "response": [
                        {
                            "id": "737040303",
                            "speaker": "兰吉特",
                            "text": "说起来朋友只给我讲了后半的故事，并没有讲前半。他父亲到底犯了什么错才会让太阳这么痛恨呢？"
                        },
                        {
                            "id": "737040304",
                            "speaker": "兰吉特",
                            "text": "太阳用金箭刺瞎了他父亲的眼睛作为惩罚还不够，凡是昆图尔所到的地方，太阳都会躲在云层后边。"
                        },
                        {
                            "id": "737040305",
                            "speaker": "兰吉特",
                            "text": "听说也有壁画记录了他的故事，不过我没有亲眼见过。"
                        },
                        {
                            "id": "737040306",
                            "speaker": "兰吉特",
                            "text": "说起来，纳塔的壁画也很独特，不仅漂亮，也很有趣！有时想想，如果我去纳塔时带的不是锅而是留影机就好了…"
                        }
                    ]
                },
                {
                    "id": "737040307",
                    "text": "没什么想聊的。"
                }
            ]
        }
    ]
}