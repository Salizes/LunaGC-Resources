{
    "talkId": "7453203",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "梅里爱": 7
    },
    "dialogues": [
        {
            "id": "745320301",
            "speaker": "梅里爱",
            "text": "啊哈哈哈哈，我亲爱的合作伙伴！你是来拍摄「速览映影」的吗？",
            "choices": [
                {
                    "id": "745320302",
                    "text": "看起来你心情不错？",
                    "response": [
                        {
                            "id": "745320303",
                            "speaker": "梅里爱",
                            "text": "那当然，如今我们即证明了「速览映影」的可行性，又看到了未来「速览映影」的发展方向。可谓前途一片光明！"
                        },
                        {
                            "id": "745320304",
                            "speaker": "梅里爱",
                            "text": "无论是之前提出的单元剧式「速览映影」，还是刚刚提到的广告片式「速览映影」，都有火遍整个枫丹的潜质。"
                        },
                        {
                            "id": "745320305",
                            "speaker": "梅里爱",
                            "text": "目前看来，只需要放手一搏！我们就会成为全枫丹，不，是全映影界最耀眼的明星。"
                        },
                        {
                            "id": "745320306",
                            "speaker": "梅里爱",
                            "text": "到那时，我们的摩拉用之不尽…以前不敢尝试的夸张特效，不敢拍摄的六小时超长实验映影…也都有着落了！"
                        },
                        {
                            "id": "745320307",
                            "speaker": "Player",
                            "text": "可别一下就把钱花光了哦…"
                        },
                        {
                            "id": "745320308",
                            "speaker": "梅里爱",
                            "text": "这你放心好了！作为枫丹才华最为横溢的导演，我在项目管理上一样出众，你就等我们的好消息吧！"
                        }
                    ]
                },
                {
                    "id": "745320309",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "745320310",
                            "speaker": "梅里爱",
                            "text": "再见！有空的时候多来转转，说不定会有更多的好消息呢！"
                        }
                    ]
                }
            ]
        }
    ]
}