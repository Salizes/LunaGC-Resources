    "dialogues": [
        {
            "id": "401114401",
            "speaker": "提纳里",
            "text": "这么巧？赛诺先前和我讲了你们的经历。",
            "choices": [
                {
                    "id": "401114402",
                    "text": "关于「冷笑话」…",
                    "response": [
                        {
                            "id": "401114403",
                            "speaker": "提纳里",
                            "text": "停！赛诺已经满脸得意地和我一一细数了他想出的冷笑话。我不想听第二遍了。"
                        },
                        {
                            "id": "401114404",
                            "speaker": "提纳里",
                            "text": "这个话题到此为止吧。",
                            "choices": [
                                {
                                    "id": "401114405",
                                    "text": "关于「七圣召唤」…",
                                    "response": [
                                        {
                                            "id": "401114406",
                                            "speaker": "提纳里",
                                            "text": "最近道成林的事务不多，就带着柯莱一起去玩了玩。"
                                        },
                                        {
                                            "id": "401114407",
                                            "speaker": "提纳里",
                                            "text": "柯莱她还挺厉害的，在大奖赛上也拿到了不错的名次。"
                                        },
                                        {
                                            "id": "401114408",
                                            "speaker": "提纳里",
                                            "text": "我虽然通过了预选，但签运不好，没打几场就碰到了赛诺。"
                                        },
                                        {
                                            "id": "401114409",
                                            "speaker": "提纳里",
                                            "text": "那家伙，打起牌来一点情面都不给。使出杀手锏时也喊得格外大声，震得我耳朵疼。"
                                        },
                                        {
                                            "id": "401114410",
                                            "speaker": "提纳里",
                                            "text": "好久没见他这么激动的样子了…",
                                            "choices": [
                                                {
                                                    "id": "401114402",
                                                    "text": "关于「冷笑话」…"
                                                },
                                                {
                                                    "id": "401114411",
                                                    "text": "先不打扰你了。",
                                                    "response": [
                                                        {
                                                            "id": "401114412",
                                                            "speaker": "提纳里",
                                                            "text": "不必客气，有空多来玩。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401114411",
                                    "text": "先不打扰你了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401114405",
                    "text": "关于「七圣召唤」…"
                },
                {
                    "id": "401114411",
                    "text": "先不打扰你了。"
                }
            ]
        }
    ]
}