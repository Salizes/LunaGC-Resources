{
    "talkId": "4141478",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "劳伦斯": 13
    },
    "dialogues": [
        {
            "id": "414147801",
            "speaker": "Player",
            "text": "关于风花节…"
        },
        {
            "id": "414147802",
            "speaker": "劳伦斯",
            "text": "说起风花节，那就不得不提到「风之花」的传说了。"
        },
        {
            "id": "414147803",
            "speaker": "劳伦斯",
            "text": "风花节起源于很久很久以前的旧蒙德，所以风之花具体是哪种花，大家都有各自的看法。"
        },
        {
            "id": "414147804",
            "speaker": "劳伦斯",
            "text": "目前来说，最主流的观点应该是「蒲公英派」和「风车菊派」吧。"
        },
        {
            "id": "414147805",
            "speaker": "劳伦斯",
            "text": "当然，也有一些人认为这两种都不是真正的风之花…",
            "choices": [
                {
                    "id": "414147806",
                    "text": "关于蒲公英派…",
                    "response": [
                        {
                            "id": "414147807",
                            "speaker": "劳伦斯",
                            "text": "哦，他们认为风之花是蒲公英，这应该是目前最主流的观点了。"
                        },
                        {
                            "id": "414147808",
                            "speaker": "劳伦斯",
                            "text": "蒲公英派认为风花节是属于恋人的节日，大家会尽最大的心意来表达爱。"
                        },
                        {
                            "id": "414147809",
                            "speaker": "劳伦斯",
                            "text": "热恋的情侣们往往会到誓言岬，在飘散的蒲公英与盛开的塞西莉亚花中间传达自己的心意…"
                        },
                        {
                            "id": "414147810",
                            "speaker": "劳伦斯",
                            "text": "哈哈，是不是还挺浪漫的？"
                        }
                    ]
                },
                {
                    "id": "414147811",
                    "text": "关于风车菊派…",
                    "response": [
                        {
                            "id": "414147812",
                            "speaker": "劳伦斯",
                            "text": "哦，相信风车菊是风之花的人倒也不在少数，只是人数没有蒲公英派那么多。"
                        },
                        {
                            "id": "414147813",
                            "speaker": "劳伦斯",
                            "text": "他们认为风花节的核心主题是纪念旧蒙德的解放…"
                        },
                        {
                            "id": "414147814",
                            "speaker": "劳伦斯",
                            "text": "…比起庆祝爱情，这个节日更应该追忆、缅怀过去。"
                        },
                        {
                            "id": "414147815",
                            "speaker": "劳伦斯",
                            "text": "嗯，仔细想想这个说法也挺有道理的…"
                        },
                        {
                            "id": "414147816",
                            "speaker": "劳伦斯",
                            "text": "不过这个观点没有成为主流，或许是因为大家更想过一个轻松的节日吧，唔…"
                        }
                    ]
                }
            ]
        }
    ]
}