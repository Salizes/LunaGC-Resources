    "dialogues": [
        {
            "id": "401578501",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想邀请你去参加音乐庆典。</color>"
        },
        {
            "id": "401578502",
            "speaker": "幸雄",
            "text": "咦？是我听错了吗？是音乐庆典？还是小吃庆典？"
        },
        {
            "id": "401578503",
            "speaker": "派蒙",
            "text": "是音乐庆典啦！是正经的音乐交流活动！你有没有喜欢的音乐？我们现在就可以弹给你听！"
        },
        {
            "id": "401578504",
            "speaker": "幸雄",
            "text": "真的是音乐庆典啊？倒是有一首曲子，我可以把旋律哼出来，可以弹给我听听看吗？"
        },
        {
            "id": "401578505",
            "speaker": "Player",
            "text": "我来试试。"
        },
        {
            "id": "401578506",
            "speaker": "幸雄",
            "text": "真是意外之喜。"
        }
    ]
}