{
    "talkId": "4018933",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "萝克珊": 9
    },
    "dialogues": [
        {
            "id": "401893301",
            "speaker": "萝克珊",
            "text": "难得这么悠闲…不打靶的生活好清静，有点新奇。",
            "choices": [
                {
                    "id": "401893302",
                    "text": "打…打靶？",
                    "response": [
                        {
                            "id": "401893303",
                            "speaker": "萝克珊",
                            "text": "我的本职工作啦，别紧张。"
                        },
                        {
                            "id": "401893304",
                            "speaker": "萝克珊",
                            "text": "最近特巡队加大了训练量，每周有三次射击科目，每次要打一百二十发弹，总环数倒数十名要绕训练场跑十圈。"
                        },
                        {
                            "id": "401893305",
                            "speaker": "萝克珊",
                            "text": "很多人都说一周下来，脑瓜子嗡嗡的，我倒是觉得，习惯以后还挺来劲的，像是…锤子砸在铁块上，金属声，很动听。"
                        },
                        {
                            "id": "401893306",
                            "speaker": "萝克珊",
                            "text": "蒂蕾娜前辈给我的耳塞，从来没派上过用场。"
                        }
                    ]
                },
                {
                    "id": "401893307",
                    "text": "以前的生活不清静吗？",
                    "response": [
                        {
                            "id": "401893308",
                            "speaker": "萝克珊",
                            "text": "应该说，很充实！"
                        },
                        {
                            "id": "401893309",
                            "speaker": "萝克珊",
                            "text": "我可是要成为特巡队下一代神射手的天才。要不是蒂蕾娜前辈说，我已经连续三个月没休过假了，强制我放假出来玩玩…"
                        },
                        {
                            "id": "401893310",
                            "speaker": "萝克珊",
                            "text": "我还能继续练！"
                        }
                    ]
                },
                {
                    "id": "401893311",
                    "text": "悠闲可以，工作要管好哦。",
                    "response": [
                        {
                            "id": "401893312",
                            "speaker": "萝克珊",
                            "text": "放心好了，一定完成任务。"
                        }
                    ]
                }
            ]
        }
    ]
}