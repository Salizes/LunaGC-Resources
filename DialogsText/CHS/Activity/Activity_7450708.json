{
    "talkId": "7450708",
    "total_dialogue_lines": 49,
    "speaker_counts": {
        "Player": 9,
        "咚咚小圆帽": 6,
        "欢腾之火": 6,
        "派蒙": 25,
        "观察「有礼貌礼帽小姐」": 1,
        "观察警卫机关": 2
    },
    "dialogues": [
        {
            "id": "745070801",
            "speaker": "派蒙",
            "text": "「咚咚小圆帽」，还有「欢腾之火」，好久不见啦，好想你们！",
            "choices": [
                {
                    "id": "745070802",
                    "text": "捏捏蕈兽伙伴们！",
                    "response": [
                        {
                            "id": "745070803",
                            "speaker": "咚咚小圆帽",
                            "text": "♪~"
                        },
                        {
                            "id": "745070804",
                            "speaker": "欢腾之火",
                            "text": "♫~"
                        },
                        {
                            "id": "745070805",
                            "speaker": "派蒙",
                            "text": "让我也抱抱「咚咚小圆帽」，捏捏「欢腾之火」！"
                        },
                        {
                            "id": "745070806",
                            "speaker": "咚咚小圆帽",
                            "text": "♪♪~"
                        },
                        {
                            "id": "745070807",
                            "speaker": "欢腾之火",
                            "text": "♫♫~"
                        },
                        {
                            "id": "745070808",
                            "speaker": "派蒙",
                            "text": "咦？等等…"
                        },
                        {
                            "id": "745070809",
                            "speaker": "派蒙",
                            "text": "虽然外表看起来没什么变化，但好像感觉…「咚咚小圆帽」和「欢腾之火」都长胖了一点？",
                            "choices": [
                                {
                                    "id": "745070810",
                                    "text": "说明伙伴们平常的伙食很好！",
                                    "response": [
                                        {
                                            "id": "745070812",
                                            "speaker": "派蒙",
                                            "text": "嘿嘿，再这样下去，说不定「咚咚小圆帽」和「欢腾之火」有一天会变得比我们大很多…"
                                        },
                                        {
                                            "id": "745070813",
                                            "speaker": "派蒙",
                                            "text": "到时候，一起去旅行的时候，「咚咚小圆帽」就可以把我们顶在脑袋上，飞高高！"
                                        },
                                        {
                                            "id": "745070814",
                                            "speaker": "派蒙",
                                            "text": "要是「咚咚小圆帽」累了，就换「欢腾之火」来背我们，我们也可以找一只驮兽，一起骑着驮兽旅行！"
                                        },
                                        {
                                            "id": "745070815",
                                            "speaker": "咚咚小圆帽",
                                            "text": "♪♪♪！"
                                        },
                                        {
                                            "id": "745070816",
                                            "speaker": "欢腾之火",
                                            "text": "♫♫♫！"
                                        },
                                        {
                                            "id": "745070817",
                                            "speaker": "派蒙",
                                            "text": "说到一起去旅行，蕈兽伙伴们就特别开心，超级期待的样子！"
                                        },
                                        {
                                            "id": "745070818",
                                            "speaker": "派蒙",
                                            "text": "要是以后完成了「意智宝珠」的改进，蕈兽伙伴们能不受限制地自由行动了…"
                                        },
                                        {
                                            "id": "745070819",
                                            "speaker": "派蒙",
                                            "text": "#我们要去哪些地方玩呢？{NICKNAME}，我们好像确实可以计划一下了？"
                                        }
                                    ]
                                },
                                {
                                    "id": "745070811",
                                    "text": "说明海妮耶她们照顾得用心！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "745070820",
                    "text": "投喂蕈兽伙伴们。",
                    "response": [
                        {
                            "id": "745070821",
                            "speaker": "派蒙",
                            "text": "好哦！这次我们也有新口味的「妙妙琼脂」，我们要给蕈兽伙伴投喂哪种好呢？",
                            "choices": [
                                {
                                    "id": "745070822",
                                    "text": "投喂「炸鱼薯条味妙妙琼脂」。",
                                    "response": [
                                        {
                                            "id": "745070823",
                                            "speaker": "咚咚小圆帽",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "745070824",
                                            "speaker": "欢腾之火",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "745070825",
                                            "speaker": "派蒙",
                                            "text": "没想到蕈兽伙伴们居然也喜欢炸鱼薯条？"
                                        },
                                        {
                                            "id": "745070826",
                                            "speaker": "派蒙",
                                            "text": "完全不挑食呢！胃口好，身体肯定棒！"
                                        },
                                        {
                                            "id": "745070837",
                                            "speaker": "派蒙",
                                            "text": "嗯…既然来了枫丹，发现了新的美食，我们也可以把它们推荐给海妮耶，做成新口味的「妙妙琼脂」！"
                                        }
                                    ]
                                },
                                {
                                    "id": "745070827",
                                    "text": "投喂「咖啡味妙妙琼脂」。",
                                    "response": [
                                        {
                                            "id": "745070828",
                                            "speaker": "咚咚小圆帽",
                                            "text": "！"
                                        },
                                        {
                                            "id": "745070829",
                                            "speaker": "欢腾之火",
                                            "text": "！"
                                        },
                                        {
                                            "id": "745070830",
                                            "speaker": "派蒙",
                                            "text": "蕈兽伙伴们好像变得更有精神了呢！"
                                        },
                                        {
                                            "id": "745070831",
                                            "speaker": "派蒙",
                                            "text": "「咖啡味妙妙琼脂」里，难道真的有咖啡吗？"
                                        }
                                    ]
                                },
                                {
                                    "id": "745070832",
                                    "text": "投喂「枫达味妙妙琼脂」。",
                                    "response": [
                                        {
                                            "id": "745070833",
                                            "speaker": "咚咚小圆帽",
                                            "text": "？"
                                        },
                                        {
                                            "id": "745070834",
                                            "speaker": "欢腾之火",
                                            "text": "？"
                                        },
                                        {
                                            "id": "745070835",
                                            "speaker": "派蒙",
                                            "text": "蕈兽伙伴们…好像要飘起来了！"
                                        },
                                        {
                                            "id": "745070836",
                                            "speaker": "派蒙",
                                            "text": "原来，原来蕈兽伙伴们，不能吃气泡很多的食物吗…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "745070838",
                    "text": "旁边这位是…",
                    "response": [
                        {
                            "id": "745070839",
                            "speaker": "派蒙",
                            "text": "唔，看样子，好像是蒂蕾娜小姐带来的警卫机关？"
                        },
                        {
                            "id": "745070840",
                            "speaker": "派蒙",
                            "text": "难道我们不在的时候，它一直在陪蕈兽伙伴们玩？"
                        },
                        {
                            "id": "745070841",
                            "speaker": "观察警卫机关",
                            "text": "（这台警卫机关似乎点了一下头，发出机件运转的低音。）"
                        },
                        {
                            "id": "745070842",
                            "speaker": "观察警卫机关",
                            "text": "（不知为什么，它明明没有说话，却给人一种优雅的感觉。）"
                        },
                        {
                            "id": "745070843",
                            "speaker": "派蒙",
                            "text": "好有礼貌！那我，那我要给你起一个好听的外号…"
                        },
                        {
                            "id": "745070844",
                            "speaker": "派蒙",
                            "text": "就叫你…「有礼貌礼帽小姐」！"
                        },
                        {
                            "id": "745070845",
                            "speaker": "观察「有礼貌礼帽小姐」",
                            "text": "（这台警卫机关身上的部件似乎在隐隐闪光，闪光的节奏欢腾。）"
                        },
                        {
                            "id": "745070846",
                            "speaker": "派蒙",
                            "text": "嘿嘿，它好像很满意的样子！"
                        },
                        {
                            "id": "745070847",
                            "speaker": "派蒙",
                            "text": "蕈兽伙伴们交到你这个新朋友肯定也很开心，「有礼貌礼帽小姐」！"
                        }
                    ]
                },
                {
                    "id": "745070848",
                    "text": "暂时离去…",
                    "response": [
                        {
                            "id": "745070849",
                            "speaker": "派蒙",
                            "text": "那，那我们有空了，还是要来陪蕈兽伙伴们玩哦！"
                        }
                    ]
                }
            ]
        }
    ]
}