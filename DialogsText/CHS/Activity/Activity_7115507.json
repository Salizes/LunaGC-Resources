    "dialogues": [
        {
            "id": "711550701",
            "speaker": "梦见月瑞希",
            "text": "#{NICKNAME}，可以为我留影了么？",
            "choices": [
                {
                    "id": "711550702",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711550703",
                            "speaker": "梦见月瑞希",
                            "text": "我看见啦，很好看的霄灯。我刚才给它助了一把力，这样它肯定能飞得很高。"
                        },
                        {
                            "id": "711550711",
                            "speaker": "梦见月瑞希",
                            "text": "呵…按照璃月人的说法，你在霄灯上写的心愿，肯定也能圆满实现啦。",
                            "choices": [
                                {
                                    "id": "711550713",
                                    "text": "没问题，那就开始留影吧。",
                                    "response": [
                                        {
                                            "id": "711550714",
                                            "speaker": "梦见月瑞希",
                                            "text": "#嗯，那留影师{NICKNAME}，你认为什么样的动作比较入镜呢？",
                                            "choices": [
                                                {
                                                    "id": "711550706",
                                                    "text": "放松一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711550708",
                                                            "speaker": "Player",
                                                            "text": "就这个动作吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711550707",
                                                    "text": "认真一点的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711550704",
                                    "text": "请稍等一会…",
                                    "response": [
                                        {
                                            "id": "711550705",
                                            "speaker": "梦见月瑞希",
                                            "text": "是有事要忙么？没关系，等你准备好了之后，我们再来详细讨论一下如何留影吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711550713",
                    "text": "没问题，那就开始留影吧。"
                },
                {
                    "id": "711550704",
                    "text": "请稍等一会…"
                }
            ]
        }
    ]
