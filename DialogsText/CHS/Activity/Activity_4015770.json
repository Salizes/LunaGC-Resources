        {
            "id": "401577001",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想邀请你去参加音乐庆典。</color>"
        },
        {
            "id": "401577002",
            "speaker": "玛乔丽",
            "text": "音乐庆典？可风花节好像不是最近吧？"
        },
        {
            "id": "401577003",
            "speaker": "派蒙",
            "text": "是在稻妻的庆典啦，是认真的音乐交流哦。你要是有喜欢的音乐，我们现在就可以弹给你听呢。"
        },
        {
            "id": "401577004",
            "speaker": "玛乔丽",
            "text": "让我想想啊，我不记得名字了，但可以把旋律哼出来，可以弹给我听听看吗？"
        },
        {
            "id": "401577005",
            "speaker": "Player",
            "text": "我来试试。"
        },
        {
            "id": "401577006",
            "speaker": "玛乔丽",
            "text": "太好了。"
        }
    ]
