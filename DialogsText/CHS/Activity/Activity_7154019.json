{
    "talkId": "7154019",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 8,
        "魈": 13
    },
    "dialogues": [
        {
            "id": "715401901",
            "speaker": "魈",
            "text": "你来了。",
            "choices": [
                {
                    "id": "715401902",
                    "text": "这封祝柬，送给你。",
                    "response": [
                        {
                            "id": "715401903",
                            "speaker": "魈",
                            "text": "…多谢。"
                        },
                        {
                            "id": "715401904",
                            "speaker": "魈",
                            "text": "我见你气息平稳，步伐轻快，看来身体的确无恙了。"
                        },
                        {
                            "id": "715401905",
                            "speaker": "魈",
                            "text": "但那天行事，太过鲁莽。如此贸然以身涉险，你可反思？",
                            "choices": [
                                {
                                    "id": "715401906",
                                    "text": "事急从权嘛…",
                                    "response": [
                                        {
                                            "id": "715401908",
                                            "speaker": "魈",
                                            "text": "彼时我虽不在你身侧，但那道降魔印尚未消散殆尽，我能略微感知到你的行动。"
                                        },
                                        {
                                            "id": "715401909",
                                            "speaker": "魈",
                                            "text": "我知道你只身入阵，替往生堂的小姑娘受了阵中法度的影响。"
                                        },
                                        {
                                            "id": "715401910",
                                            "speaker": "魈",
                                            "text": "……",
                                            "choices": [
                                                {
                                                    "id": "715401911",
                                                    "text": "我没事的，那些伤不到我。",
                                                    "response": [
                                                        {
                                                            "id": "715401913",
                                                            "speaker": "魈",
                                                            "text": "总之，无事就好。"
                                                        },
                                                        {
                                                            "id": "715401914",
                                                            "speaker": "魈",
                                                            "text": "…我也可放下心中忧虑了。"
                                                        },
                                                        {
                                                            "id": "715401915",
                                                            "speaker": "魈",
                                                            "text": "少时我还要巡视附近，以防还有因死气发狂的魔物袭人。"
                                                        },
                                                        {
                                                            "id": "715401916",
                                                            "speaker": "魈",
                                                            "text": "如果你遇见了麻烦…",
                                                            "choices": [
                                                                {
                                                                    "id": "715401917",
                                                                    "text": "我会叫你的。",
                                                                    "response": [
                                                                        {
                                                                            "id": "715401919",
                                                                            "speaker": "魈",
                                                                            "text": "嗯。多留心。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "715401918",
                                                                    "text": "那就要麻烦你了。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715401912",
                                                    "text": "白术的药很管用，我没事的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715401907",
                                    "text": "你也知道了啊…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715401920",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715401921",
                            "speaker": "魈",
                            "text": "路上小心。"
                        }
                    ]
                }
            ]
        }
    ]
}