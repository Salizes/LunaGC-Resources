    "dialogues": [
        {
            "id": "745071301",
            "speaker": "左右加",
            "text": "「天守阁的座上宾」，「三千贼匪七日斩」、「智巧勇武双连星」、还有「金山银山大老板」…"
        },
        {
            "id": "745071302",
            "speaker": "左右加",
            "text": "不管是和你们聊天，还是玩游戏，我都很开心，感觉轻轻松松聊聊天，就能得到超多写作灵感！",
            "choices": [
                {
                    "id": "745071303",
                    "text": "那就再玩两局！",
                    "response": [
                        {
                            "id": "745071304",
                            "speaker": "左右加",
                            "text": "好呀！请多指教了！"
                        }
                    ]
                },
                {
                    "id": "745071305",
                    "text": "那不打扰你总结灵感了…",
                    "response": [
                        {
                            "id": "745071306",
                            "speaker": "左右加",
                            "text": "哎呀！不用这么见外啦！想和我聊天，或是再玩两局游戏的话，随时可以来找我哦！"
                        }
                    ]
                }
            ]
        }
    ]
}