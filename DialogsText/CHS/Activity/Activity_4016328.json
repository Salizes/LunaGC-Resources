{
    "talkId": "4016328",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "毕塞尔特": 4,
        "蒙塔纳": 3
    },
    "dialogues": [
        {
            "id": "401632801",
            "speaker": "毕塞尔特",
            "text": "卫兵队长阁下，您有什么需要帮助的吗？"
        },
        {
            "id": "401632802",
            "speaker": "蒙塔纳",
            "text": "为什么这么问？"
        },
        {
            "id": "401632803",
            "speaker": "毕塞尔特",
            "text": "因为国王陛下，那位贵不可言的「老板」，建议我帮助身边的人。"
        },
        {
            "id": "401632804",
            "speaker": "毕塞尔特",
            "text": "卫兵队长阁下现在距离我最近。"
        },
        {
            "id": "401632805",
            "speaker": "蒙塔纳",
            "text": "……"
        },
        {
            "id": "401632806",
            "speaker": "毕塞尔特",
            "text": "…抱歉，我只是想活跃一下气氛。既然如此，我们也该去看看居民们需要什么了。"
        },
        {
            "id": "401632807",
            "speaker": "蒙塔纳",
            "text": "说得正是，我来带路。"
        }
    ]
}