{
    "talkId": "4013215",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "宵宫": 8,
        "神里绫华": 7
    },
    "dialogues": [
        {
            "id": "401321501",
            "speaker": "神里绫华",
            "text": "宵宫尝尝晶螺糕吧。"
        },
        {
            "id": "401321502",
            "speaker": "宵宫",
            "text": "这是绫华点的，绫华先吃。"
        },
        {
            "id": "401321503",
            "speaker": "神里绫华",
            "text": "我是为了宵宫才要的。宵宫很喜欢甜点吧？"
        },
        {
            "id": "401321504",
            "speaker": "宵宫",
            "text": "嘿嘿…既然这样，我们也不要再谦让了！一起吃吧，好不好？"
        },
        {
            "id": "401321505",
            "speaker": "神里绫华",
            "text": "呵呵…好呀。"
        },
        {
            "id": "401321506",
            "speaker": "宵宫",
            "text": "……"
        },
        {
            "id": "401321507",
            "speaker": "神里绫华",
            "text": "……"
        },
        {
            "id": "401321508",
            "speaker": "宵宫",
            "text": "太好吃了！"
        },
        {
            "id": "401321509",
            "speaker": "宵宫",
            "text": "好松软！入口的时候黄油的香气特别馥郁，回味也让人觉得很幸福…"
        },
        {
            "id": "401321510",
            "speaker": "神里绫华",
            "text": "太好了，宵宫很喜欢呢。"
        },
        {
            "id": "401321511",
            "speaker": "神里绫华",
            "text": "我也觉得很好吃，而且，我很喜欢它的花纹。"
        },
        {
            "id": "401321512",
            "speaker": "宵宫",
            "text": "听说是仿造「苍晶螺」的造型做的哦！我从来没有亲眼见过，很好奇它们长什么样子！"
        },
        {
            "id": "401321513",
            "speaker": "宵宫",
            "text": "绫华，你有没有兴趣？要不要找个时间，我们一起去水下找找看？"
        },
        {
            "id": "401321514",
            "speaker": "神里绫华",
            "text": "好啊，要不等下就去？"
        },
        {
            "id": "401321515",
            "speaker": "宵宫",
            "text": "嗯！我还有好多地方想和绫华一起逛的，那就说好了哦！"
        }
    ]
}