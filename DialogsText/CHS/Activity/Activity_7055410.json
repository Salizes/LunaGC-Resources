{
    "talkId": "7055410",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "瓦乐瑞娜": 15
    },
    "dialogues": [
        {
            "id": "705541001",
            "speaker": "瓦乐瑞娜",
            "text": "啊哈哈，有段时间没见面了，猫猫救星！"
        },
        {
            "id": "705541002",
            "speaker": "瓦乐瑞娜",
            "text": "不对，现在的场合，应该称呼你荣誉骑士大人？",
            "choices": [
                {
                    "id": "705541003",
                    "text": "近来可好，瓦乐瑞娜？",
                    "response": [
                        {
                            "id": "705541004",
                            "speaker": "瓦乐瑞娜",
                            "text": "嗯，让我想想…不算完美，但也挺好！"
                        },
                        {
                            "id": "705541005",
                            "speaker": "瓦乐瑞娜",
                            "text": "本来，我已经计划好，要一边重新营业「猫茸茸城堡」，一边量产「嘟嘟可爆轰大乱斗」的桌上游戏了。"
                        },
                        {
                            "id": "705541006",
                            "speaker": "瓦乐瑞娜",
                            "text": "结果，一封来自纳塔的邀请函完全打乱了我的计划——"
                        },
                        {
                            "id": "705541007",
                            "speaker": "瓦乐瑞娜",
                            "text": "「伊奎米利的寒星」莉琉大姐，她听说了我之前的成就，特意邀请我的小队去帮忙，深入探索一座复杂的遗迹…"
                        },
                        {
                            "id": "705541008",
                            "speaker": "瓦乐瑞娜",
                            "text": "要知道，她可是纳塔有名的老战士，不再参加那个厉害的巡礼大会后，才转行冒险家…"
                        },
                        {
                            "id": "705541009",
                            "speaker": "瓦乐瑞娜",
                            "text": "只用了半年，她就完成了好多S级的委托，有希望成为纳塔冒险家协会的下一任分会长哦！至少是二把手！",
                            "choices": [
                                {
                                    "id": "705541010",
                                    "text": "有点耳熟的名字…",
                                    "response": [
                                        {
                                            "id": "705541012",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "说不定将来哪天，你们就会遇上呢，到时候，请代我向她再次问好哦。"
                                        },
                                        {
                                            "id": "705541013",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "总之，虽然我之前的计划耽搁了，但有幸为莉琉大姐出力，我非常满足！"
                                        },
                                        {
                                            "id": "705541014",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "顺带，也赚到了不少摩拉…资金更充裕了！"
                                        },
                                        {
                                            "id": "705541015",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "我带过去的伙伴们也都玩得特别开心，收获满满。比如那边那位在跳舞的，就是我队里的战斗厨师。"
                                        },
                                        {
                                            "id": "705541016",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "舞蹈是和纳塔勇士们现学的哦，很厉害吧！我想让城堡里的猫猫们也学着跳跳看！"
                                        }
                                    ]
                                },
                                {
                                    "id": "705541011",
                                    "text": "第一次听说的高手…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705541017",
                    "text": "你先坐坐！",
                    "response": [
                        {
                            "id": "705541018",
                            "speaker": "瓦乐瑞娜",
                            "text": "如果忙的话，完全可以无视我！以后还有机会慢慢聊天的！"
                        }
                    ]
                },
                {
                    "id": "705541019",
                    "text": "给你再来杯喝的？",
                    "response": [
                        {
                            "id": "705541020",
                            "speaker": "瓦乐瑞娜",
                            "text": "谢谢，如果你忙不过来，就暂时不麻烦了！"
                        }
                    ]
                }
            ]
        }
    ]
}