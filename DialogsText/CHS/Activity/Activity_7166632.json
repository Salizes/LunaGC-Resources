{
    "talkId": "7166632",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "「恐怖猫爪草」": 10
    },
    "dialogues": [
        {
            "id": "716663201",
            "speaker": "「恐怖猫爪草」",
            "text": "你们还要和畅畅玩游戏吗？",
            "choices": [
                {
                    "id": "716663202",
                    "text": "那就开打吧！",
                    "response": [
                        {
                            "id": "716663203",
                            "speaker": "「恐怖猫爪草」",
                            "text": "好哦！我要和你好好学一学，那个…白什么小什么瓜的打法！"
                        }
                    ]
                },
                {
                    "id": "716663204",
                    "text": "关于你的称号…",
                    "response": [
                        {
                            "id": "716663205",
                            "speaker": "「恐怖猫爪草」",
                            "text": "啊？你是说「恐怖猫爪草」吗？"
                        },
                        {
                            "id": "716663206",
                            "speaker": "「恐怖猫爪草」",
                            "text": "只是因为爸爸以前给畅畅带回来过一种盆栽，每天晚上，畅畅把它放在窗边，结果第二天一早，它就跑到屋顶上去了。"
                        },
                        {
                            "id": "716663207",
                            "speaker": "「恐怖猫爪草」",
                            "text": "有人说，半夜看见过畅畅的盆栽，就像猫猫一样爬上了墙…"
                        },
                        {
                            "id": "716663208",
                            "speaker": "「恐怖猫爪草」",
                            "text": "后来才知道，原来，城里有只猫猫很喜欢那种盆栽，把它叼走了。"
                        },
                        {
                            "id": "716663209",
                            "speaker": "「恐怖猫爪草」",
                            "text": "不知为什么，这件事传到别人嘴里，就变成了「畅畅把盆栽养成了猫」。"
                        },
                        {
                            "id": "716663210",
                            "speaker": "「恐怖猫爪草」",
                            "text": "畅畅倒是无所谓，不过那个…「花椒鱼酱」…听说了这件事，觉得畅畅的外号很威风，还找畅畅来玩这个游戏…"
                        },
                        {
                            "id": "716663211",
                            "speaker": "「恐怖猫爪草」",
                            "text": "畅畅玩得开心，还想继续玩！"
                        }
                    ]
                },
                {
                    "id": "716663212",
                    "text": "再见！",
                    "response": [
                        {
                            "id": "716663213",
                            "speaker": "「恐怖猫爪草」",
                            "text": "嗯，那就再见了！"
                        }
                    ]
                }
            ]
        }
    ]
}