{
    "talkId": "4141432",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 4,
        "玛文": 6
    },
    "dialogues": [
        {
            "id": "414143201",
            "speaker": "Player",
            "text": "你的作业完成得怎么样了？"
        },
        {
            "id": "414143202",
            "speaker": "玛文",
            "text": "趁着灵感写了一版，但总觉得…有些不好意思…"
        },
        {
            "id": "414143203",
            "speaker": "Player",
            "text": "可以念给我听吗？"
        },
        {
            "id": "414143204",
            "speaker": "玛文",
            "text": "当然！不要笑话我就行…哈哈。"
        },
        {
            "id": "414143205",
            "speaker": "玛文",
            "text": "「我与你\\n星与月\\n风与云\\n花与雾\\n无法分离」"
        },
        {
            "id": "414143206",
            "speaker": "玛文",
            "text": "怎、怎么样…还行吗？",
            "choices": [
                {
                    "id": "414143207",
                    "text": "文笔朴素了些。",
                    "response": [
                        {
                            "id": "414143209",
                            "speaker": "玛文",
                            "text": "是啊，我也这么觉得…以后我得多练习练习，争取写出更好的诗送给玛拉。"
                        },
                        {
                            "id": "414143210",
                            "speaker": "玛文",
                            "text": "谢谢你们！那我修改一下，等改完再去交作业…温迪老师，请等等我！"
                        }
                    ]
                },
                {
                    "id": "414143208",
                    "text": "感情丰富，行文稍显稚嫩。"
                }
            ]
        }
    ]
}