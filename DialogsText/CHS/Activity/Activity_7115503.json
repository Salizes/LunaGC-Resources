        "梦见月瑞希": 7
    },
    "dialogues": [
        {
            "id": "711550301",
            "speaker": "梦见月瑞希",
            "text": "#{NICKNAME}？真是巧遇，海灯节快乐。",
            "choices": [
                {
                    "id": "711550302",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711550304",
                            "speaker": "梦见月瑞希",
                            "text": "我看见啦，很好看的霄灯。我刚才给它助了一把力，这样它肯定能飞得很高。"
                        },
                        {
                            "id": "711550314",
                            "speaker": "梦见月瑞希",
                            "text": "呵…按照璃月人的说法，你在霄灯上写的心愿，肯定也能圆满实现啦。"
                        },
                        {
                            "id": "711550303",
                            "speaker": "Player",
                            "text": "关于纪念留影…"
                        },
                        {
                            "id": "711550315",
                            "speaker": "梦见月瑞希",
                            "text": "啊…我确实请萍溪小姐帮我安排了纪念留影，原来你就是萍溪说的留影师啊。"
                        },
                        {
                            "id": "711550316",
                            "speaker": "梦见月瑞希",
                            "text": "太好了，看来我这一次的海灯节之旅，能收获许多张好画片了。",
                            "choices": [
                                {
                                    "id": "711550305",
                                    "text": "那就开始留影吧。",
                                    "response": [
                                        {
                                            "id": "711550306",
                                            "speaker": "梦见月瑞希",
                                            "text": "#嗯，那留影师{NICKNAME}，你认为什么样的动作比较入镜呢？",
                                            "choices": [
                                                {
                                                    "id": "711550309",
                                                    "text": "放松一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711550311",
                                                            "speaker": "Player",
                                                            "text": "再试试第二个动作…",
                                                            "choices": [
                                                                {
                                                                    "id": "711550313",
                                                                    "text": "再试试第一个动作…"
                                                                },
                                                                {
                                                                    "id": "711550312",
                                                                    "text": "就这个动作吧。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711550310",
                                                    "text": "认真一点的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711550307",
                                    "text": "请稍等一会…",
                                    "response": [
                                        {
                                            "id": "711550308",
                                            "speaker": "梦见月瑞希",
                                            "text": "是有事要忙么？没关系，等你准备好了之后，我们再来详细讨论一下如何留影吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711550303",
                    "text": "关于纪念留影…"
                }
            ]
        }
    ]
}