    "dialogues": [
        {
            "id": "765080501",
            "speaker": "Player",
            "text": "有阵子没见过塔拉内小姐了？"
        },
        {
            "id": "765080502",
            "speaker": "塔拉内",
            "text": "没想到你还记得我！我演出的地方明明有点偏僻…",
            "choices": [
                {
                    "id": "765080503",
                    "text": "在一些地方听说过你的舞蹈…",
                    "response": [
                        {
                            "id": "765080505",
                            "speaker": "塔拉内",
                            "text": "实在感谢…这是最高的鼓励！我要继续精进，跳出更加鼓励人心的舞步！"
                        },
                        {
                            "id": "765080506",
                            "speaker": "塔拉内",
                            "text": "自己把日子过得好好的，和大家一起分享阳光向上的情绪，才最重要！"
                        }
                    ]
                },
                {
                    "id": "765080504",
                    "text": "想起你跳的舞，心情就好了！"
                }
            ]
        }
    ]
}