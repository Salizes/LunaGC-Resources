{
    "talkId": "7468002",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 3,
        "伊莲": 14
    },
    "dialogues": [
        {
            "id": "746800201",
            "speaker": "伊莲",
            "text": "虽然神医们已经承诺帮我进行测试了，但还是有点不安…"
        },
        {
            "id": "746800202",
            "speaker": "伊莲",
            "text": "这心神不宁的感觉，果然…甲方的恐怖，不是那么轻松就能摆脱的！",
            "choices": [
                {
                    "id": "746800203",
                    "text": "你还好吗？",
                    "response": [
                        {
                            "id": "746800204",
                            "speaker": "伊莲",
                            "text": "啊！你回来了，神医！不好意思我走神了…"
                        },
                        {
                            "id": "746800205",
                            "speaker": "伊莲",
                            "text": "我一直在想，难道真的我没有办法摆脱甲方的阴影了吗？"
                        },
                        {
                            "id": "746800206",
                            "speaker": "伊莲",
                            "text": "难道真的要像神医您说的那样…设法先干掉老板？"
                        },
                        {
                            "id": "746800207",
                            "speaker": "伊莲",
                            "text": "我，我得好好思考一下！"
                        }
                    ]
                },
                {
                    "id": "746800208",
                    "text": "关于「稳像平台」…",
                    "response": [
                        {
                            "id": "746800209",
                            "speaker": "伊莲",
                            "text": "咦？神医您…对机械原理感兴趣吗？"
                        },
                        {
                            "id": "746800210",
                            "speaker": "伊莲",
                            "text": "其实也没什么新奇的技术，我只是从几个已废弃项目的相关资料里找到了部分技术成果…"
                        },
                        {
                            "id": "746800211",
                            "speaker": "伊莲",
                            "text": "听说以前啊，有一群很有才华的工程师…他们想让船上的火炮在超大的风浪中稳定地射击。"
                        },
                        {
                            "id": "746800212",
                            "speaker": "伊莲",
                            "text": "为此，他们废寝忘食，才研发出一种能在垂直层面上稳定武器的机构。"
                        },
                        {
                            "id": "746800213",
                            "speaker": "伊莲",
                            "text": "虽然这些项目最后全都被放弃了，不过我通过零碎的文件，一定程度还原了它的稳定装置。"
                        },
                        {
                            "id": "746800214",
                            "speaker": "伊莲",
                            "text": "将它小型化后，就生产出了现在的「稳像机关」。"
                        },
                        {
                            "id": "746800215",
                            "speaker": "伊莲",
                            "text": "不知道这种机关最后的销路究竟如何啊…"
                        }
                    ]
                },
                {
                    "id": "746800216",
                    "text": "（默然离去…）",
                    "response": [
                        {
                            "id": "746800217",
                            "speaker": "伊莲",
                            "text": "怎么办啊，到底怎么办啊…"
                        }
                    ]
                }
            ]
        }
    ]
}