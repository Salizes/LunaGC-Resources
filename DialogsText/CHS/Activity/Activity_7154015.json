{
    "talkId": "7154015",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "北斗": 12
    },
    "dialogues": [
        {
            "id": "715401501",
            "speaker": "北斗",
            "text": "呼…也该回船上去了…",
            "choices": [
                {
                    "id": "715401502",
                    "text": "这封祝柬送给你。",
                    "response": [
                        {
                            "id": "715401503",
                            "speaker": "北斗",
                            "text": "哈哈，这封祝柬不错啊，看着漂亮，字也好。"
                        },
                        {
                            "id": "715401504",
                            "speaker": "北斗",
                            "text": "#{NICKNAME}，看来你这双手，不仅是救人的手，更是写字的手啊。"
                        },
                        {
                            "id": "715401505",
                            "speaker": "Player",
                            "text": "大家平安就好。"
                        },
                        {
                            "id": "715401506",
                            "speaker": "北斗",
                            "text": "哈哈，有你助拳，哪有不能平安的道理？"
                        },
                        {
                            "id": "715401507",
                            "speaker": "北斗",
                            "text": "别说我了，死兆星号的兄弟们，对你也是愈发佩服得紧，全都嚷着要和你好好喝上一顿呢。"
                        },
                        {
                            "id": "715401508",
                            "speaker": "Player",
                            "text": "我喝不了那么多…"
                        },
                        {
                            "id": "715401509",
                            "speaker": "北斗",
                            "text": "知道，知道，早就替你都挡下来了。"
                        },
                        {
                            "id": "715401510",
                            "speaker": "北斗",
                            "text": "要是在战场上，你肯定是威风凛凛，虎入羊群。但要是来我们船上喝一顿，怕就是羊入虎口咯。"
                        },
                        {
                            "id": "715401511",
                            "speaker": "北斗",
                            "text": "但…酒可以挡，饭必须吃。等你有空了，我做东，咱们好好地大吃一顿。"
                        },
                        {
                            "id": "715401512",
                            "speaker": "北斗",
                            "text": "至于现在嘛…我还得回去船上，给兄弟们分分天权星大人送过来的酬钱呢。"
                        },
                        {
                            "id": "715401513",
                            "speaker": "北斗",
                            "text": "等我给兄弟们分好了钱，置办完宴席，就叫你过来。"
                        },
                        {
                            "id": "715401514",
                            "speaker": "北斗",
                            "text": "#{NICKNAME}，到时候你可一定要来啊。"
                        }
                    ]
                },
                {
                    "id": "715401515",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715401516",
                            "speaker": "北斗",
                            "text": "回头见，等我置办好宴席，你可一定要来啊。"
                        }
                    ]
                }
            ]
        }
    ]
}