{
    "talkId": "4015440",
    "total_dialogue_lines": 51,
    "speaker_counts": {
        "Player": 8,
        "丽莎": 9,
        "五郎": 16,
        "派蒙": 8,
        "绮良良": 10
    },
    "dialogues": [
        {
            "id": "401544001",
            "speaker": "五郎",
            "text": "#传说中有求必应的炼金店铺…居然是{NICKNAME}和派蒙开的店？"
        },
        {
            "id": "401544002",
            "speaker": "派蒙",
            "text": "欸？五郎？你从哪冒出来的？"
        },
        {
            "id": "401544003",
            "speaker": "派蒙",
            "text": "而且怎么绮良良也在，你们为什么会同时出现在蒙德啦！",
            "choices": [
                {
                    "id": "401544004",
                    "text": "意料之外的客人！",
                    "response": [
                        {
                            "id": "401544006",
                            "speaker": "绮良良",
                            "text": "嘿嘿，「狛荷屋」的业务范围特别广，在哪里看见我都不奇怪嘛。"
                        },
                        {
                            "id": "401544007",
                            "speaker": "绮良良",
                            "text": "之前我来过蒙德，对这边还挺熟悉的，倒是这位五郎将军，在附近迷了路…"
                        },
                        {
                            "id": "401544008",
                            "speaker": "五郎",
                            "text": "咳咳！进入陌生地域行动，通常都需要前期情报的支持，可惜海祇岛的居民很少造访蒙德，我也完全没有这边的地形图。"
                        },
                        {
                            "id": "401544009",
                            "speaker": "五郎",
                            "text": "所以说，我是在一边进行前期侦查，一边执行正式任务，难免出差错！"
                        },
                        {
                            "id": "401544010",
                            "speaker": "绮良良",
                            "text": "明白了，五郎将军！下次我会提前准备好最最最详细的地图，放在那什么…行动出发点！随你们取用！"
                        },
                        {
                            "id": "401544011",
                            "speaker": "五郎",
                            "text": "倒也不需要这么正经，好像在和上级汇报…你只是我们临时聘请的顾问，又不是我军的兵士。"
                        },
                        {
                            "id": "401544012",
                            "speaker": "绮良良",
                            "text": "不不不，说好了！之后要麻烦你帮忙宣传，让海祇岛的客人们多多选择「狛荷屋」哦！"
                        },
                        {
                            "id": "401544013",
                            "speaker": "绮良良",
                            "text": "大家的业绩都指望你啦！"
                        },
                        {
                            "id": "401544014",
                            "speaker": "派蒙",
                            "text": "话说回来，五郎为什么突然到蒙德来了？你说的任务又是什么？"
                        },
                        {
                            "id": "401544015",
                            "speaker": "五郎",
                            "text": "这件事嘛…说来也巧。"
                        },
                        {
                            "id": "401544016",
                            "speaker": "五郎",
                            "text": "最近海祇岛在改进货船的工艺，提升运输物资的效率。为此，我们派出了多个访问团，前往各国学习最先进的生产技术。"
                        },
                        {
                            "id": "401544017",
                            "speaker": "五郎",
                            "text": "我原本在璃月学习，正打算回去时，突然听说了你们神奇的炼金药剂，就决定改变行程，来仔细考察一番。"
                        },
                        {
                            "id": "401544018",
                            "speaker": "五郎",
                            "text": "现在看来，真是个正确的选择！"
                        },
                        {
                            "id": "401544019",
                            "speaker": "派蒙",
                            "text": "嘿嘿，这回你可赚大了哦。我们的炼金药剂，其他地方可买不到！",
                            "choices": [
                                {
                                    "id": "401544020",
                                    "text": "看我们给你做个超厉害的！",
                                    "response": [
                                        {
                                            "id": "401544022",
                                            "speaker": "丽莎",
                                            "text": "哦？又有别国来的客人了？小可爱的朋友还真是遍布提瓦特呢…"
                                        },
                                        {
                                            "id": "401544023",
                                            "speaker": "丽莎",
                                            "text": "嗯，我有一种预感…你们会和小狼狼很合得来呢。"
                                        },
                                        {
                                            "id": "401544024",
                                            "speaker": "丽莎",
                                            "text": "买到了称心的炼金药剂后，要不要和小可爱，还有我的弟子一起喝下午茶啊？"
                                        },
                                        {
                                            "id": "401544025",
                                            "speaker": "绮良良",
                                            "text": "下午茶？好呀好呀！正好我送了好久好久的货，又干又渴，谢谢这位大姐姐啦！"
                                        },
                                        {
                                            "id": "401544026",
                                            "speaker": "五郎",
                                            "text": "等等！为什么有种似曾相识的压迫感…"
                                        },
                                        {
                                            "id": "401544027",
                                            "speaker": "五郎",
                                            "text": "#{NICKNAME}，这位是？",
                                            "choices": [
                                                {
                                                    "id": "401544028",
                                                    "text": "她是司书的魔女哦！",
                                                    "response": [
                                                        {
                                                            "id": "401544030",
                                                            "speaker": "五郎",
                                                            "text": "魔魔魔魔女！这个称号很威严…是宫司那样的大人物吗？"
                                                        },
                                                        {
                                                            "id": "401544031",
                                                            "speaker": "五郎",
                                                            "text": "还是说…和珊瑚宫大人一个等级？"
                                                        },
                                                        {
                                                            "id": "401544032",
                                                            "speaker": "派蒙",
                                                            "text": "你怎么也开始吓唬五郎啦，真是的。"
                                                        },
                                                        {
                                                            "id": "401544033",
                                                            "speaker": "派蒙",
                                                            "text": "不用紧张哦五郎，魔女什么的只是外号而已哦，这位是丽莎，蒙德图书馆的管理员，我们这个炼金店铺的总负责人！"
                                                        },
                                                        {
                                                            "id": "401544034",
                                                            "speaker": "派蒙",
                                                            "text": "丽莎，这两位是五郎和绮良良！一个是超厉害的海祇岛将军，一个是超准点的「狛荷屋」快递员。"
                                                        },
                                                        {
                                                            "id": "401544035",
                                                            "speaker": "丽莎",
                                                            "text": "绮良良呀，这个名字我有印象，图书馆的一些稻妻藏书，就是你帮忙送来的吧，真是帮大忙啦。"
                                                        },
                                                        {
                                                            "id": "401544036",
                                                            "speaker": "绮良良",
                                                            "text": "嘿嘿，没想到我和丽莎姐这么有缘！以后如果有快递委托，请指名我来送货！"
                                                        },
                                                        {
                                                            "id": "401544037",
                                                            "speaker": "丽莎",
                                                            "text": "至于五郎将军，我似乎也读到过有关你的报道，那些文章都夸赞你体恤部下，领兵有方。"
                                                        },
                                                        {
                                                            "id": "401544038",
                                                            "speaker": "丽莎",
                                                            "text": "容我猜猜，你是不是想为海祇岛的将士们寻找一种有助于工作的药剂？"
                                                        },
                                                        {
                                                            "id": "401544039",
                                                            "speaker": "五郎",
                                                            "text": "确实如此！"
                                                        },
                                                        {
                                                            "id": "401544040",
                                                            "speaker": "五郎",
                                                            "text": "海祈岛和其他地区的商业来往日益频繁，护航的将士和商船的水手每天都要高强度工作，面临着极大的考验。"
                                                        },
                                                        {
                                                            "id": "401544041",
                                                            "speaker": "五郎",
                                                            "text": "要是能找到一种药剂，帮助将士和水手们改善精力，提升力量，以应对长时间的工作，就再好不过了。"
                                                        },
                                                        {
                                                            "id": "401544042",
                                                            "speaker": "绮良良",
                                                            "text": "喔！如果真有这么神奇的药剂，麻烦给我也来几瓶！"
                                                        },
                                                        {
                                                            "id": "401544043",
                                                            "speaker": "绮良良",
                                                            "text": "有时我要把快递送到很偏远的地方去，在崎岖的路上走太久的话，腿很容易酸，爪子也硌得疼。"
                                                        },
                                                        {
                                                            "id": "401544044",
                                                            "speaker": "丽莎",
                                                            "text": "这是小可爱比较熟悉的药剂类型呢，应该花不了多少工夫吧？",
                                                            "choices": [
                                                                {
                                                                    "id": "401544045",
                                                                    "text": "应该能行。",
                                                                    "response": [
                                                                        {
                                                                            "id": "401544047",
                                                                            "speaker": "派蒙",
                                                                            "text": "你们就放心吧，包在我们身上了！"
                                                                        },
                                                                        {
                                                                            "id": "401544048",
                                                                            "speaker": "丽莎",
                                                                            "text": "那我就先写一封信，找位空闲的骑士，去请小狼狼过来。"
                                                                        },
                                                                        {
                                                                            "id": "401544049",
                                                                            "speaker": "丽莎",
                                                                            "text": "等到小可爱调配出了让你们满意的药剂，我们就可以开心地享受下午茶啦。"
                                                                        },
                                                                        {
                                                                            "id": "401544050",
                                                                            "speaker": "绮良良",
                                                                            "text": "嘿嘿，在果酒湖边吃下午茶点心，会是什么感觉呢？真期待！"
                                                                        },
                                                                        {
                                                                            "id": "401544051",
                                                                            "speaker": "五郎",
                                                                            "text": "呼，总算能松口气了…"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "401544046",
                                                                    "text": "我有信心！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "401544029",
                                                    "text": "也是下午茶的魔女！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401544021",
                                    "text": "给你们一些好玩又有用的！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401544005",
                    "text": "超级惊喜的客户！"
                }
            ]
        }
    ]
}