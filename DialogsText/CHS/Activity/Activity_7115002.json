{
    "talkId": "7115002",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 9,
        "瓦雷莎": 9
    },
    "dialogues": [
        {
            "id": "711500201",
            "speaker": "瓦雷莎",
            "text": "璃月有好多好吃的啊，接下来去吃什么好呢…不然去吃水煮鱼吧？"
        },
        {
            "id": "711500202",
            "speaker": "瓦雷莎",
            "text": "呜啊…不行不行，要先把画片拍好，我还要带回去给部族里的人看呢…",
            "choices": [
                {
                    "id": "711500203",
                    "text": "关于我刚放的霄灯…",
                    "response": [
                        {
                            "id": "711500204",
                            "speaker": "瓦雷莎",
                            "text": "#哇…飞得好高喔。{NICKNAME}，霄灯能不能放很多盏啊，我想帮部族里的每个人都放一盏霄灯。"
                        },
                        {
                            "id": "711500205",
                            "speaker": "瓦雷莎",
                            "text": "大家想要放飞的那些愿望，我都记在笔记本上了，有好多呢，嘿嘿…得买好多盏才行。"
                        },
                        {
                            "id": "711500206",
                            "speaker": "Player",
                            "text": "瓦雷莎？你要拍纪念留影么？"
                        },
                        {
                            "id": "711500207",
                            "speaker": "瓦雷莎",
                            "text": "#{NICKNAME}？哎呀，那位璃月姐姐说的专业留影人士就是你吗？"
                        },
                        {
                            "id": "711500208",
                            "speaker": "Player",
                            "text": "正是我。"
                        },
                        {
                            "id": "711500209",
                            "speaker": "瓦雷莎",
                            "text": "嘿嘿，那就太好啦，你那么厉害，肯定也很擅长留影。",
                            "choices": [
                                {
                                    "id": "711500210",
                                    "text": "那咱们就开始？",
                                    "response": [
                                        {
                                            "id": "711500211",
                                            "speaker": "瓦雷莎",
                                            "text": "好呀，我要做出一个帅气的动作…不过，会不会不太适合留影呢…"
                                        },
                                        {
                                            "id": "711500212",
                                            "speaker": "瓦雷莎",
                                            "text": "#{NICKNAME}，不然你给我一点建议？",
                                            "choices": [
                                                {
                                                    "id": "711500213",
                                                    "text": "帅气一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711500215",
                                                            "speaker": "Player",
                                                            "text": "就这个动作吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711500214",
                                                    "text": "放松一点的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711500216",
                                    "text": "稍等一会…",
                                    "response": [
                                        {
                                            "id": "711500217",
                                            "speaker": "瓦雷莎",
                                            "text": "是有其他的事要忙？好呀，嘿嘿…我先吃点东西…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711500206",
                    "text": "瓦雷莎？你要拍纪念留影么？"
                }
            ]
        }
    ]
}