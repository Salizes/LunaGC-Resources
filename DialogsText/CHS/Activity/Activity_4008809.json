{
    "talkId": "4008809",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "保琳": 10
    },
    "dialogues": [
        {
            "id": "400880901",
            "speaker": "保琳",
            "text": "本店有各种鲜艳的花卉在售，想买几束吗？",
            "choices": [
                {
                    "id": "400880902",
                    "text": "你是？",
                    "response": [
                        {
                            "id": "400880903",
                            "speaker": "保琳",
                            "text": "你好啊，荣誉骑士！"
                        },
                        {
                            "id": "400880904",
                            "speaker": "保琳",
                            "text": "你可能觉得我有些面生吧？"
                        },
                        {
                            "id": "400880905",
                            "speaker": "保琳",
                            "text": "我是清泉镇的普通住户，管理着一间小花店。"
                        },
                        {
                            "id": "400880906",
                            "speaker": "保琳",
                            "text": "平常我一直在照顾花卉，很久没和镇外的客人打过交道了…"
                        },
                        {
                            "id": "400880907",
                            "speaker": "保琳",
                            "text": "没想到今年遇上了你这种大名人。这难道是归风带来的好运吗？"
                        }
                    ]
                },
                {
                    "id": "400880908",
                    "text": "花卉？",
                    "response": [
                        {
                            "id": "400880909",
                            "speaker": "保琳",
                            "text": "我的兴趣是种花，这些花卉都是我自己栽培的，品种不太常见，没有观赏之外的用途。"
                        },
                        {
                            "id": "400880910",
                            "speaker": "保琳",
                            "text": "我希望漂亮的花卉给更多人带来好心情。"
                        },
                        {
                            "id": "400880911",
                            "speaker": "保琳",
                            "text": "不过，因为花卉的季节性，每年我只会在特定的时间开店营业。"
                        }
                    ]
                },
                {
                    "id": "400880912",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "400880913",
                            "speaker": "保琳",
                            "text": "再见，祝你心情愉快！"
                        }
                    ]
                }
            ]
        }
    ]
}