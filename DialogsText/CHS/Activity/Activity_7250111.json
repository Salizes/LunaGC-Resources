{
    "talkId": "7250111",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Player": 10,
        "宵宫": 18,
        "岩夫": 6,
        "彩香": 3,
        "松坂": 2
    },
    "dialogues": [
        {
            "id": "725011101",
            "speaker": "松坂",
            "text": "大貉妖也不在这里…"
        },
        {
            "id": "725011102",
            "speaker": "彩香",
            "text": "宵宫姐姐，它…它真的在附近吗…"
        },
        {
            "id": "725011103",
            "speaker": "彩香",
            "text": "那，那我们是不是已经进入它的地盘了？我，我有点害怕…"
        },
        {
            "id": "725011104",
            "speaker": "宵宫",
            "text": "别怕，我们有这么多人，而且还带了好多烟花，该害怕的是「大貉妖」才对！"
        },
        {
            "id": "725011105",
            "speaker": "岩夫",
            "text": "对，达达利亚哥哥也在后面帮忙殿后！没什么好怕…",
            "choices": [
                {
                    "id": "725011106",
                    "text": "那个，打扰一下…",
                    "response": [
                        {
                            "id": "725011108",
                            "speaker": "松坂",
                            "text": "呜哇！宵宫姐姐！"
                        },
                        {
                            "id": "725011109",
                            "speaker": "彩香",
                            "text": "宵宫姐姐！宵宫姐姐！"
                        },
                        {
                            "id": "725011110",
                            "speaker": "岩夫",
                            "text": "达达利亚哥哥！大貉妖来啦！"
                        },
                        {
                            "id": "725011111",
                            "speaker": "宵宫",
                            "text": "#没事！是{NICKNAME}啦，上次的那位{M#大哥哥}{F#大姐姐}，不是大貉妖！"
                        },
                        {
                            "id": "725011112",
                            "speaker": "Player",
                            "text": "你们在追踪「大貉妖」吗？"
                        },
                        {
                            "id": "725011113",
                            "speaker": "宵宫",
                            "text": "对呀，「大貉妖」现在活动得越来越猖狂，就连白天都敢去捉弄人了。"
                        },
                        {
                            "id": "725011114",
                            "speaker": "宵宫",
                            "text": "不仅涂改了岩夫的作业，让他在学校里难堪。还偷走了彩香的零食，弄坏了松坂的玩具。",
                            "choices": [
                                {
                                    "id": "725011115",
                                    "text": "（其实就是孩子们自己干的吧…）",
                                    "response": [
                                        {
                                            "id": "725011117",
                                            "speaker": "岩夫",
                                            "text": "所以我们才和宵宫姐姐来这里，准备把「大貉妖」彻底赶走！"
                                        },
                                        {
                                            "id": "725011118",
                                            "speaker": "Player",
                                            "text": "关于达达利亚…"
                                        },
                                        {
                                            "id": "725011119",
                                            "speaker": "宵宫",
                                            "text": "你说他啊，他…他是我请来专门对付「大貉妖」的专家啊。"
                                        },
                                        {
                                            "id": "725011120",
                                            "speaker": "宵宫",
                                            "text": "烟花只能把「大貉妖」吓走，想要真正打倒它，必须要真正的专业人士出马才行。"
                                        },
                                        {
                                            "id": "725011121",
                                            "speaker": "岩夫",
                                            "text": "达达利亚哥哥可厉害了！他打倒魔物的时候，我都看不清他的动作，就听见咻咻咻几声，魔物就全都倒下啦！"
                                        },
                                        {
                                            "id": "725011122",
                                            "speaker": "岩夫",
                                            "text": "唉，要是达达利亚哥哥能教我几招就好了…"
                                        },
                                        {
                                            "id": "725011123",
                                            "speaker": "宵宫",
                                            "text": "等打倒了「大貉妖」，我们再一起去问问他吧。"
                                        },
                                        {
                                            "id": "725011124",
                                            "speaker": "宵宫",
                                            "text": "现在最重要的，是要找到「大貉妖」行动的痕迹，再找到它的巢穴。"
                                        },
                                        {
                                            "id": "725011125",
                                            "speaker": "岩夫",
                                            "text": "然后…我们就可以正式和它决战了！"
                                        },
                                        {
                                            "id": "725011126",
                                            "speaker": "宵宫",
                                            "text": "没错，我们就一起去打倒它！",
                                            "choices": [
                                                {
                                                    "id": "725011127",
                                                    "text": "达达利亚其实是…",
                                                    "response": [
                                                        {
                                                            "id": "725011129",
                                                            "speaker": "宵宫",
                                                            "text": "嘘，小点声，别让岩夫他们听见了。"
                                                        },
                                                        {
                                                            "id": "725011130",
                                                            "speaker": "宵宫",
                                                            "text": "那个叫做达达利亚的人是「愚人众执行官」，对吧？朔次郎之前和我提起过他…还有璃月港里发生的那些事。"
                                                        },
                                                        {
                                                            "id": "725011131",
                                                            "speaker": "宵宫",
                                                            "text": "我知道这个人很危险。但他不仅救了岩夫，又和孩子们玩成了一片，还兴致勃勃地答应帮忙找「大貉妖」。"
                                                        },
                                                        {
                                                            "id": "725011132",
                                                            "speaker": "宵宫",
                                                            "text": "我听人家说，愚人众不应该都是那种既可怕，又危险，光是看一眼就让人想要远离的人吗？"
                                                        },
                                                        {
                                                            "id": "725011133",
                                                            "speaker": "宵宫",
                                                            "text": "这位达达利亚先生一直都很照顾孩子们，而且还和他们很认真地讨论「大貉妖」的战斗力…"
                                                        },
                                                        {
                                                            "id": "725011134",
                                                            "speaker": "宵宫",
                                                            "text": "在我看来，达达利亚先生对彩香他们的关心不像是作假。在孩子们看来，他应该也是一个很可靠的「好人」吧。"
                                                        },
                                                        {
                                                            "id": "725011135",
                                                            "speaker": "宵宫",
                                                            "text": "我觉得…无论达达利亚先生的身份是什么。他现在正在做着「好事」，那他就理应得到做好事应有的对待才是。"
                                                        },
                                                        {
                                                            "id": "725011136",
                                                            "speaker": "宵宫",
                                                            "text": "不过你放心，我还是会对他提高警惕的，绝对不会放松！",
                                                            "choices": [
                                                                {
                                                                    "id": "725011137",
                                                                    "text": "有问题就叫我来。",
                                                                    "response": [
                                                                        {
                                                                            "id": "725011139",
                                                                            "speaker": "宵宫",
                                                                            "text": "嗯！谢谢，有你在我就放心啦。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "725011138",
                                                                    "text": "放心，我能对付他。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "725011128",
                                                    "text": "达达利亚的身份是…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "725011116",
                                    "text": "（大概都是孩子们的恶作剧吧…）"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "725011107",
                    "text": "哇！有大貉妖！"
                }
            ]
        }
    ]
}