{
    "talkId": "4020919",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "北斗": 11,
        "派蒙": 6
    },
    "dialogues": [
        {
            "id": "402091901",
            "speaker": "北斗",
            "text": "#来啦？{NICKNAME}，要好好测试全新的战法吗？远程引导归终机的火力，给魔物们来阵从天而降的惊喜！",
            "choices": [
                {
                    "id": "402091902",
                    "text": "我准备好了。",
                    "response": [
                        {
                            "id": "402091903",
                            "speaker": "派蒙",
                            "text": "呜哦！我也要打起精神来！"
                        },
                        {
                            "id": "402091904",
                            "speaker": "北斗",
                            "text": "不错，就是这种气势，痛痛快快打一场吧！"
                        }
                    ]
                },
                {
                    "id": "402091905",
                    "text": "关于死兆星二号…",
                    "response": [
                        {
                            "id": "402091906",
                            "speaker": "派蒙",
                            "text": "北斗的新大船吗？我们以前确实还没见过它呢！"
                        },
                        {
                            "id": "402091907",
                            "speaker": "派蒙",
                            "text": "好好打磨了这么久，死兆星二号应该是最厉害的大船了！"
                        },
                        {
                            "id": "402091908",
                            "speaker": "北斗",
                            "text": "哈哈，放眼民间的船只，那肯定名列前茅，不过，和璃月、枫丹或至冬的专用战舰相比…我也不敢大夸海口。"
                        },
                        {
                            "id": "402091909",
                            "speaker": "北斗",
                            "text": "另外，严格来说，它应该算是「死兆星级」的二号舰，也是目前舰队里从大到小排第二的船，目前还没正式命名。"
                        },
                        {
                            "id": "402091910",
                            "speaker": "派蒙",
                            "text": "咦…还没名字？为什么会这样？"
                        },
                        {
                            "id": "402091911",
                            "speaker": "北斗",
                            "text": "说来也挺巧的，一般的战船是在下水后举行命名仪式的，偏偏它算是中间「插单」建造的新船。"
                        },
                        {
                            "id": "402091912",
                            "speaker": "北斗",
                            "text": "由于下水时间和另一艘补给船撞上了，加上它的用途特别，我们想让它低调点，就没为它大办仪式。"
                        },
                        {
                            "id": "402091913",
                            "speaker": "北斗",
                            "text": "下水舾装后，二号舰在远海试航了很久，刚刚确保新型动力装置万无一失，就又接收了新装备，再次出航，可谓一波三折…"
                        },
                        {
                            "id": "402091914",
                            "speaker": "北斗",
                            "text": "直到这次来挪德卡莱之前，它都没有对外公开过，我们叫它二号舰都习惯了！"
                        },
                        {
                            "id": "402091915",
                            "speaker": "派蒙",
                            "text": "但，总用这种代号，感觉二号舰也有点可怜…",
                            "choices": [
                                {
                                    "id": "402091916",
                                    "text": "感觉是秘密接头的称呼。",
                                    "response": [
                                        {
                                            "id": "402091918",
                                            "speaker": "北斗",
                                            "text": "嗯，贸易展也算是二号舰的正式亮相，我们也正打算给它一个正式名。"
                                        },
                                        {
                                            "id": "402091919",
                                            "speaker": "北斗",
                                            "text": "我会好好琢磨一番的！说不定还要请你们帮忙参考参考！"
                                        }
                                    ]
                                },
                                {
                                    "id": "402091917",
                                    "text": "还是需要个响亮的名字。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "402091920",
                    "text": "我们准备准备再来好好打一场。",
                    "response": [
                        {
                            "id": "402091921",
                            "speaker": "派蒙",
                            "text": "嗯！因为是全新的战斗方式，我们也要做好准备！"
                        },
                        {
                            "id": "402091922",
                            "speaker": "北斗",
                            "text": "那好啊，我会充满期待地等着你们，看你们披挂上阵。"
                        }
                    ]
                }
            ]
        }
    ]
}