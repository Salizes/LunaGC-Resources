{
    "talkId": "7750403",
    "total_dialogue_lines": 49,
    "speaker_counts": {
        "Player": 10,
        "琪琪科娃": 39
    },
    "dialogues": [
        {
            "id": "775040301",
            "speaker": "琪琪科娃",
            "text": "呼呼~只要好好按照探索计划，熟悉至冬的各种地点和事物，迟早能成为名副其实的强者！",
            "choices": [
                {
                    "id": "775040302",
                    "text": "关于凯瑟琳的立像和礼物…",
                    "response": [
                        {
                            "id": "775040303",
                            "speaker": "琪琪科娃",
                            "text": "嘿嘿，好看吧？"
                        },
                        {
                            "id": "775040304",
                            "speaker": "琪琪科娃",
                            "text": "这一套凯瑟琳大人的立像可是限定的款式哦，花大价钱请了很厉害的画家和工匠做出来的…"
                        },
                        {
                            "id": "775040305",
                            "speaker": "琪琪科娃",
                            "text": "有的被冒险家前辈们藏在了冰块里，有的被互相寄送交换。"
                        },
                        {
                            "id": "775040306",
                            "speaker": "琪琪科娃",
                            "text": "因为太热门，发售方和协会都开始使用特殊的「热诚票券」来抽取立像的部件。"
                        },
                        {
                            "id": "775040307",
                            "speaker": "琪琪科娃",
                            "text": "我也是费了好大好大的功夫…差不多半辈子的零花钱，才搞到这批票券和部件的！"
                        },
                        {
                            "id": "775040308",
                            "speaker": "琪琪科娃",
                            "text": "这样一来，互助会的大家也都根据自己喜欢的方式，搭建出凯瑟琳大人的不同形象啦。",
                            "choices": [
                                {
                                    "id": "775040309",
                                    "text": "凯瑟琳…大人？",
                                    "response": [
                                        {
                                            "id": "775040311",
                                            "speaker": "琪琪科娃",
                                            "text": "欸？凯瑟琳大人不是…冒险家协会说了算的人吗？"
                                        },
                                        {
                                            "id": "775040312",
                                            "speaker": "琪琪科娃",
                                            "text": "我听别人说，每个冒险家都要听凯瑟琳大人指挥，任务都是凯瑟琳大人指派的。"
                                        },
                                        {
                                            "id": "775040313",
                                            "speaker": "琪琪科娃",
                                            "text": "而且搞定一切后，奖励也是凯瑟琳大人亲手发放的。"
                                        },
                                        {
                                            "id": "775040314",
                                            "speaker": "琪琪科娃",
                                            "text": "那，凯瑟琳大人手里应该掌握着全提瓦特所有冒险家的情报和奖金…"
                                        },
                                        {
                                            "id": "775040315",
                                            "speaker": "琪琪科娃",
                                            "text": "这不是超厉害的嘛！"
                                        }
                                    ]
                                },
                                {
                                    "id": "775040310",
                                    "text": "你好敬仰凯瑟琳的样子？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775040316",
                    "text": "关于探索计划…",
                    "response": [
                        {
                            "id": "775040317",
                            "speaker": "琪琪科娃",
                            "text": "你是不是有点不放心？担心我的计划不靠谱？"
                        },
                        {
                            "id": "775040318",
                            "speaker": "琪琪科娃",
                            "text": "以前也有别人质疑过我——「一个小鬼的计划，能让人学到什么东西？」"
                        },
                        {
                            "id": "775040319",
                            "speaker": "琪琪科娃",
                            "text": "那我就要声明了：我的探索计划啊，可是根据塔拉利欣大哥留下的资料改编出来的！"
                        },
                        {
                            "id": "775040320",
                            "speaker": "琪琪科娃",
                            "text": "塔拉利欣大哥的资料又综合了好多冒险家和猎人的经验，甚至是掷弹兵的训练手册。"
                        },
                        {
                            "id": "775040321",
                            "speaker": "琪琪科娃",
                            "text": "明白了吧？就算我只是一个小鬼，至少参考信息绝对可靠。",
                            "choices": [
                                {
                                    "id": "775040322",
                                    "text": "这个人很厉害吗？",
                                    "response": [
                                        {
                                            "id": "775040324",
                                            "speaker": "琪琪科娃",
                                            "text": "要看和谁比了…我们村里的阿贾克斯大哥来的话，一分钟能打五十个…八十个他？"
                                        },
                                        {
                                            "id": "775040325",
                                            "speaker": "琪琪科娃",
                                            "text": "阿贾克斯大哥的大名，你总听过吧？"
                                        },
                                        {
                                            "id": "775040326",
                                            "speaker": "琪琪科娃",
                                            "text": "话又说回来了，要是我这辈子能在阿贾克斯大哥手下撑过两秒钟，强到那种程度…我做梦都能笑醒！"
                                        },
                                        {
                                            "id": "775040327",
                                            "speaker": "琪琪科娃",
                                            "text": "像我这种普通人，最多就达到塔拉利欣大哥的水平了，不能贪心。"
                                        },
                                        {
                                            "id": "775040328",
                                            "speaker": "琪琪科娃",
                                            "text": "现在，塔拉利欣大哥在冒险家协会总部工作，听说他还挺重要的呢。"
                                        },
                                        {
                                            "id": "775040329",
                                            "speaker": "琪琪科娃",
                                            "text": "只要你也快快变强，成为合格的冒险家，说不定就能在至冬堡见到他了！"
                                        }
                                    ]
                                },
                                {
                                    "id": "775040323",
                                    "text": "你这大哥很强吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775040330",
                    "text": "聊聊你自己的情况？",
                    "response": [
                        {
                            "id": "775040331",
                            "speaker": "琪琪科娃",
                            "text": "我？好像也没什么好说的…"
                        },
                        {
                            "id": "775040332",
                            "speaker": "琪琪科娃",
                            "text": "我家里就是普普通通的渔民，如果我不变厉害一点，以后也要继续打鱼了。"
                        },
                        {
                            "id": "775040333",
                            "speaker": "琪琪科娃",
                            "text": "打鱼没什么不好，但好像也没什么值得期待。"
                        },
                        {
                            "id": "775040334",
                            "speaker": "琪琪科娃",
                            "text": "家里最有出息的…是大我快二十岁的姐姐。"
                        },
                        {
                            "id": "775040335",
                            "speaker": "琪琪科娃",
                            "text": "我姐姐叫布达诺娃，在我还不记事的时候，就因为身体很棒很棒，光荣地加入愚人众了。"
                        },
                        {
                            "id": "775040336",
                            "speaker": "琪琪科娃",
                            "text": "后来，姐姐甚至成了一位厉害的执行官的部下，去了枫丹！"
                        },
                        {
                            "id": "775040337",
                            "speaker": "琪琪科娃",
                            "text": "因为工作太忙太忙了，她好久好久没回来了，我都有点忘记她的样子了…"
                        },
                        {
                            "id": "775040338",
                            "speaker": "琪琪科娃",
                            "text": "我只能一直和姐姐写信，她每封信里都给我寄好多零花钱，还拜托她在至冬的朋友给我买漂亮的衣服！"
                        },
                        {
                            "id": "775040339",
                            "speaker": "琪琪科娃",
                            "text": "这件衣服就是用姐姐给我的摩拉买的，漂亮吧？"
                        },
                        {
                            "id": "775040340",
                            "speaker": "琪琪科娃",
                            "text": "等我再变厉害一点，我要穿着这一身去枫丹，给姐姐一个惊喜！",
                            "choices": [
                                {
                                    "id": "775040341",
                                    "text": "你也想加入愚人众吗？",
                                    "response": [
                                        {
                                            "id": "775040343",
                                            "speaker": "琪琪科娃",
                                            "text": "不，姐姐说过，如果我们姐妹两都走一样的道路，以后的生活就会少很多乐趣。"
                                        },
                                        {
                                            "id": "775040344",
                                            "speaker": "琪琪科娃",
                                            "text": "她和爸爸妈妈说，我有很多很多选择，可以试试专业铳枪射手、地理勘测员、船员和冒险家…"
                                        },
                                        {
                                            "id": "775040345",
                                            "speaker": "琪琪科娃",
                                            "text": "这里面，我还是对冒险家最感兴趣，不过，我也不会只学这一种职业的本领。"
                                        },
                                        {
                                            "id": "775040346",
                                            "speaker": "琪琪科娃",
                                            "text": "最近认识的朋友大喜儿就告诉我一句璃月谚语：「技多不压身」。"
                                        },
                                        {
                                            "id": "775040347",
                                            "speaker": "琪琪科娃",
                                            "text": "学会各种各样的本事，也是变强的一种境界嘛，还能从姐姐意想不到的角度帮她！"
                                        }
                                    ]
                                },
                                {
                                    "id": "775040342",
                                    "text": "你想跟着姐姐干活吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775040348",
                    "text": "待会儿再来聊天…",
                    "response": [
                        {
                            "id": "775040349",
                            "speaker": "琪琪科娃",
                            "text": "要去干活了吗？那你加油哦！"
                        }
                    ]
                }
            ]
        }
    ]
}