    "dialogues": [
        {
            "id": "401541801",
            "speaker": "派蒙",
            "text": "哇，砂糖你来了！已经到了特级考核的时候吗？"
        },
        {
            "id": "401541802",
            "speaker": "派蒙",
            "text": "不知不觉，我们的炼金水平也在飞速进步呢。"
        },
        {
            "id": "401541803",
            "speaker": "砂糖",
            "text": "是啊，在阿贝多先生的规划里，如果通过了特级考核，就具备指导别人的资格了呢。"
        },
        {
            "id": "401541804",
            "speaker": "派蒙",
            "text": "哦哦，我们要成为炼金导师了吗！"
        },
        {
            "id": "401541805",
            "speaker": "派蒙",
            "text": "那我可要开班教学，让我想想，每个学生的学费收多少好呢…"
        },
        {
            "id": "401541806",
            "speaker": "派蒙",
            "text": "课后作业就让他们用炼金术做好吃的食物，然后交给我，嘿嘿…",
            "choices": [
                {
                    "id": "401541807",
                    "text": "派蒙…",
                    "response": [
                        {
                            "id": "401541809",
                            "speaker": "砂糖",
                            "text": "#嗯，我相信{NICKNAME}能像之前一样顺利完成的。"
                        },
                        {
                            "id": "401541810",
                            "speaker": "砂糖",
                            "text": "我这边随时都可以开始。我会为你加油的！",
                            "choices": [
                                {
                                    "id": "401541811",
                                    "text": "查看考核要求。"
                                },
                                {
                                    "id": "401541812",
                                    "text": "还需要时间。",
                                    "response": [
                                        {
                                            "id": "401541813",
                                            "speaker": "砂糖",
                                            "text": "这是最后的考核了，准备万全再开始吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401541808",
                    "text": "等通过了考核之后再说吧。"
                }
            ]
        }
    ]
}