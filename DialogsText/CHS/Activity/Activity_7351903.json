{
    "talkId": "7351903",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "Player": 2,
        "施芮娅": 5
    },
    "dialogues": [
        {
            "id": "735190301",
            "speaker": "施芮娅",
            "text": "那个笨蛋…！怎么会有这种人！来咖啡馆真就只想写报告？",
            "choices": [
                {
                    "id": "735190302",
                    "text": "你怎么一个人在这？",
                    "response": [
                        {
                            "id": "735190304",
                            "speaker": "施芮娅",
                            "text": "——别再提那个满脑子机械齿轮的笨蛋了！我真是在沙漠里热晕了脑袋才会相信他开窍了！"
                        },
                        {
                            "id": "735190305",
                            "speaker": "施芮娅",
                            "text": "之前我们约在咖啡馆里见面，我花了半天时间来收拾打理，还特意换了身新衣服…"
                        },
                        {
                            "id": "735190306",
                            "speaker": "施芮娅",
                            "text": "——结果他看见我的第一句话，居然是「材料跟纸笔带了没？」"
                        },
                        {
                            "id": "735190307",
                            "speaker": "施芮娅",
                            "text": "啊啊…就让他跟他的宝贝机械过一辈子去吧！"
                        }
                    ]
                },
                {
                    "id": "735190303",
                    "text": "维纳亚克上哪去了？"
                }
            ]
        }
    ]
}