{
    "talkId": "4019707",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "希格雯": 8,
        "派蒙": 2
    },
    "dialogues": [
        {
            "id": "401970701",
            "speaker": "希格雯",
            "text": "哎呀呀，总算解决问题了…"
        },
        {
            "id": "401970702",
            "speaker": "希格雯",
            "text": "#不好意思，{NICKNAME}和派蒙，病人的病情有点复杂，处理了很久。",
            "choices": [
                {
                    "id": "401970703",
                    "text": "辛苦了，请用饮品。",
                    "response": [
                        {
                            "id": "401970705",
                            "speaker": "派蒙",
                            "text": "还有特制的点心，希望你快快恢复元气！"
                        },
                        {
                            "id": "401970706",
                            "speaker": "希格雯",
                            "text": "哇啊~谢谢你们！"
                        },
                        {
                            "id": "401970707",
                            "speaker": "希格雯",
                            "text": "其实，这样的事情不至于让我特别劳累，只是会有点不理解。"
                        },
                        {
                            "id": "401970708",
                            "speaker": "希格雯",
                            "text": "每部给孩子们看的映影前都标注了，「剧中情节和产物纯属虚构，请勿模仿」，偏偏成年人还会犯错…"
                        },
                        {
                            "id": "401970709",
                            "speaker": "派蒙",
                            "text": "难道是他们看映影的时候不仔细吗？还是说，「不让我做，我偏要试试」的逆反心理在作怪？",
                            "choices": [
                                {
                                    "id": "401970710",
                                    "text": "不看警告完全没办法。",
                                    "response": [
                                        {
                                            "id": "401970712",
                                            "speaker": "希格雯",
                                            "text": "唔，这个话题发展下去，就太过深远了。"
                                        },
                                        {
                                            "id": "401970713",
                                            "speaker": "希格雯",
                                            "text": "以后有机会，我和公爵、还有那维莱特大人聊聊看，有没有预防的方法。"
                                        },
                                        {
                                            "id": "401970714",
                                            "speaker": "希格雯",
                                            "text": "现在，还是先把注意力放回「悠悠慢庄园」吧，迟到的顾问要上岗啦~"
                                        }
                                    ]
                                },
                                {
                                    "id": "401970711",
                                    "text": "看了不听更是让人头疼。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401970704",
                    "text": "给你准备了果茶。"
                }
            ]
        }
    ]
}