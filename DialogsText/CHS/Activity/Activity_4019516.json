    "speaker_counts": {
        "莱欧斯利": 5,
        "那维莱特": 3
    },
    "dialogues": [
        {
            "id": "401951601",
            "speaker": "莱欧斯利",
            "text": "说到绑架案…"
        },
        {
            "id": "401951602",
            "speaker": "那维莱特",
            "text": "嗯？"
        },
        {
            "id": "401951603",
            "speaker": "莱欧斯利",
            "text": "按照规定，我们对被绑架的主体是如何定义的来着？"
        },
        {
            "id": "401951604",
            "speaker": "莱欧斯利",
            "text": "除了人类以外，宠物算吗？非人类的智慧生物算吗？"
        },
        {
            "id": "401951605",
            "speaker": "莱欧斯利",
            "text": "嗯…美露莘就不用说了，但咔库库那种该怎么界定？"
        },
        {
            "id": "401951606",
            "speaker": "那维莱特",
            "text": "没想到你会不了解这方面的法律条款。"
        },
        {
            "id": "401951607",
            "speaker": "莱欧斯利",
            "text": "哈哈，我如果对每一条法律都了若指掌，就不会在梅洛彼得堡生活了。"
        },
        {
            "id": "401951608",
            "speaker": "那维莱特",
            "text": "…这个玩笑不好笑，莱欧斯利。"
        }
    ]
}