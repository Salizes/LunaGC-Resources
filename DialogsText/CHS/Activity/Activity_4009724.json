{
    "talkId": "4009724",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "米卡": 11,
        "赛诺": 10
    },
    "dialogues": [
        {
            "id": "400972401",
            "speaker": "赛诺",
            "text": "这就是风龙废墟…"
        },
        {
            "id": "400972402",
            "speaker": "赛诺",
            "text": "…风魔龙，会出现在天空哪一角呢。"
        },
        {
            "id": "400972403",
            "speaker": "米卡",
            "text": "欸？请问…"
        },
        {
            "id": "400972404",
            "speaker": "赛诺",
            "text": "谁？"
        },
        {
            "id": "400972405",
            "speaker": "米卡",
            "text": "呃啊！对不起对不起，我不是故意打扰你的！"
        },
        {
            "id": "400972406",
            "speaker": "赛诺",
            "text": "…不好意思，习惯使然。你是蒙德本地人吧？我叫赛诺，是来蒙德观光的，应该说是我打扰你了。"
        },
        {
            "id": "400972407",
            "speaker": "米卡",
            "text": "请问，你是在找什么东西吗？"
        },
        {
            "id": "400972408",
            "speaker": "赛诺",
            "text": "我在等风魔龙。"
        },
        {
            "id": "400972409",
            "speaker": "米卡",
            "text": "甚至在这里架起了留影机…"
        },
        {
            "id": "400972410",
            "speaker": "赛诺",
            "text": "嗯。我想把风魔龙的英姿拍下来，拿给别人做绘画参考。"
        },
        {
            "id": "400972411",
            "speaker": "米卡",
            "text": "原来是这样…我也帮着一起看看吧，听说风魔龙出没是有规律的。"
        },
        {
            "id": "400972412",
            "speaker": "赛诺",
            "text": "它一般多久出现一次？"
        },
        {
            "id": "400972413",
            "speaker": "米卡",
            "text": "啊，我应该查一下资料再告诉你！稍等，我看看笔记…"
        },
        {
            "id": "400972414",
            "speaker": "赛诺",
            "text": "……"
        },
        {
            "id": "400972415",
            "speaker": "米卡",
            "text": "……"
        },
        {
            "id": "400972416",
            "speaker": "米卡",
            "text": "赛诺先生，你就这样一直仰着头吗？"
        },
        {
            "id": "400972417",
            "speaker": "赛诺",
            "text": "没关系，我很强，我的脖子可以支撑住。"
        },
        {
            "id": "400972418",
            "speaker": "米卡",
            "text": "不不不，还是…还是坐下吧…我带了毯子，可以借给你！"
        },
        {
            "id": "400972419",
            "speaker": "赛诺",
            "text": "没问题的。"
        },
        {
            "id": "400972420",
            "speaker": "米卡",
            "text": "那…呃…"
        },
        {
            "id": "400972421",
            "speaker": "米卡",
            "text": "…奇怪，为什么我也跟着仰头看起来了…"
        }
    ]
}