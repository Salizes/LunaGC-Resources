{
    "talkId": "4020009",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 10,
        "派蒙": 20
    },
    "dialogues": [
        {
            "id": "402000901",
            "speaker": "派蒙",
            "text": "#嘿嘿，{NICKNAME}，我回来啦！"
        },
        {
            "id": "402000902",
            "speaker": "派蒙",
            "text": "我跟着埃德勒警官，好好审讯了那些坏人…感觉，学到了不少新本领！",
            "choices": [
                {
                    "id": "402000903",
                    "text": "玩得开心吗？",
                    "response": [
                        {
                            "id": "402000904",
                            "speaker": "派蒙",
                            "text": "嗯！让坏家伙们说出自己作案的动机，然后后悔认错的感觉，像是给不好的事情划上了一个句号，挺有意思的！"
                        },
                        {
                            "id": "402000905",
                            "speaker": "派蒙",
                            "text": "你和夜兰呢？夜兰好好享受了假期嘛？",
                            "choices": [
                                {
                                    "id": "402000906",
                                    "text": "我们也玩得很尽兴。",
                                    "response": [
                                        {
                                            "id": "402000908",
                                            "speaker": "派蒙",
                                            "text": "以前还没有什么概念，现在仔细一想，夜兰还真是个大忙人啊！"
                                        },
                                        {
                                            "id": "402000909",
                                            "speaker": "派蒙",
                                            "text": "能把这——么——多的坏家伙揪出来，抓起来，还表现得悠悠哉哉，不怎么累…"
                                        },
                                        {
                                            "id": "402000910",
                                            "speaker": "派蒙",
                                            "text": "唔…下次见面的时候，我也问问看好了，能不能和她学学安排时间，保持活力的秘诀好了。",
                                            "choices": [
                                                {
                                                    "id": "402000911",
                                                    "text": "最近你好上进欸！",
                                                    "response": [
                                                        {
                                                            "id": "402000913",
                                                            "speaker": "派蒙",
                                                            "text": "欸嘿嘿，只是想多多帮你的忙而已啦！"
                                                        },
                                                        {
                                                            "id": "402000914",
                                                            "speaker": "派蒙",
                                                            "text": "你一直在变强，我也要努力一点才行嘛！"
                                                        },
                                                        {
                                                            "id": "402000930",
                                                            "speaker": "派蒙",
                                                            "text": "好啦，是时候开始下一次冒险了，我们继续出发吧！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "402000912",
                                                    "text": "好学派蒙！夸夸！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "402000907",
                                    "text": "约好在挪德卡莱再见。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "402000915",
                    "text": "有用力凶坏人吗？",
                    "response": [
                        {
                            "id": "402000916",
                            "speaker": "派蒙",
                            "text": "有，有吧？"
                        },
                        {
                            "id": "402000917",
                            "speaker": "派蒙",
                            "text": "我的额头有点酸，一定是扮凶脸太久，眼睛瞪太大了！"
                        },
                        {
                            "id": "402000918",
                            "speaker": "派蒙",
                            "text": "#那些家伙一发现，我是{NICKNAME}最好最好的伙伴，全都吓得不轻，叽里咕噜老实交代了。",
                            "choices": [
                                {
                                    "id": "402000919",
                                    "text": "那我以后也凶一点…",
                                    "response": [
                                        {
                                            "id": "402000922",
                                            "speaker": "派蒙",
                                            "text": "唔…想象了一下，好像想象不出来…"
                                        },
                                        {
                                            "id": "402000923",
                                            "speaker": "派蒙",
                                            "text": "#毕竟{NICKNAME}一直很温和嘛，最凶最凶的时候都不吓人，和我说话的时候都慢悠悠的~"
                                        },
                                        {
                                            "id": "402000924",
                                            "speaker": "派蒙",
                                            "text": "面对一般的坏家伙，你也不可能真的特别特别生气，到动真格发火…大凶特凶的程度吧？"
                                        },
                                        {
                                            "id": "402000925",
                                            "speaker": "派蒙",
                                            "text": "我们也算是见识过大风大浪了，心胸开阔，不和一般坏蛋们一般见识！"
                                        },
                                        {
                                            "id": "402000926",
                                            "speaker": "Player",
                                            "text": "也对，不和一般坏家伙计较！"
                                        },
                                        {
                                            "id": "402000927",
                                            "speaker": "派蒙",
                                            "text": "有了这次的经验，接下来的冒险，我们肯定会更得心应手啦！"
                                        },
                                        {
                                            "id": "402000928",
                                            "speaker": "派蒙",
                                            "text": "#希望不管遇见什么情况，{NICKNAME}都要从从容容，不慌不忙…"
                                        },
                                        {
                                            "id": "402000929",
                                            "speaker": "派蒙",
                                            "text": "这样，我也能安安心心，我们都能在打败坏家伙后开开心心！"
                                        }
                                    ]
                                },
                                {
                                    "id": "402000920",
                                    "text": "变成超绝恐怖大王…"
                                },
                                {
                                    "id": "402000921",
                                    "text": "岂不是坏人直接吓跑了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}