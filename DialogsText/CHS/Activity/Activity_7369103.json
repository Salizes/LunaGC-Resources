    "dialogues": [
        {
            "id": "736910301",
            "speaker": "法尔博",
            "text": "哎哟，可别再有学长学姐过来问了，这真就只是一个普通的玩具而已啊…"
        },
        {
            "id": "736910302",
            "speaker": "法尔博",
            "text": "啊？哦…是旅行者啊，你是想要试玩一下「明星聚画」吗？",
            "choices": [
                {
                    "id": "736910303",
                    "text": "想要试玩看看。",
                    "response": [
                        {
                            "id": "736910304",
                            "speaker": "法尔博",
                            "text": "没问题，星盘就在这里。"
                        }
                    ]
                },
                {
                    "id": "736910305",
                    "text": "还有别的事。",
                    "response": [
                        {
                            "id": "736910306",
                            "speaker": "法尔博",
                            "text": "唔，反正在学院游乐会期间，我会一直在这边开着摊位，你想玩的话直接过来就好。"
                        }
                    ]
                }
            ]
        }
    ]
