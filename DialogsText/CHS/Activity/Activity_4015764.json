    "dialogues": [
        {
            "id": "401576401",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想邀请你去参加音乐庆典。</color>"
        },
        {
            "id": "401576402",
            "speaker": "琳琅",
            "text": "邀请我？您是指约会的那种邀请吗？"
        },
        {
            "id": "401576403",
            "speaker": "派蒙",
            "text": "是音乐交流那种啦！你有喜欢的曲子吗？我们可以弹给你听。我们是正经的音乐庆典。"
        },
        {
            "id": "401576404",
            "speaker": "琳琅",
            "text": "原来如此。那确实有一首曲子，我可以把旋律哼出来，可以弹给我听听看吗？"
        },
        {
            "id": "401576405",
            "speaker": "Player",
            "text": "我来试试。"
        },
        {
            "id": "401576406",
            "speaker": "琳琅",
            "text": "洗耳恭听。"
        }
    ]
}