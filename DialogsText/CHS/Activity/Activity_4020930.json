{
    "talkId": "4020930",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "龚妙": 8
    },
    "dialogues": [
        {
            "id": "402093001",
            "speaker": "龚妙",
            "text": "这趟出航，赚得还不少，差事也不复杂，还挺不错的…",
            "choices": [
                {
                    "id": "402093002",
                    "text": "在念叨什么呢？赚钱？",
                    "response": [
                        {
                            "id": "402093003",
                            "speaker": "龚妙",
                            "text": "啊，是大姐头的贵客啊，那好说——"
                        },
                        {
                            "id": "402093004",
                            "speaker": "龚妙",
                            "text": "我是本船的会计，简单来说，负责统计本船花了多少摩拉，赚了多少摩拉，然后帮大姐头分配船员们的薪水…"
                        },
                        {
                            "id": "402093005",
                            "speaker": "龚妙",
                            "text": "这次我们来挪德卡莱的路上，顺道接了个护航的委托，足以平掉之前的开销。"
                        },
                        {
                            "id": "402093006",
                            "speaker": "龚妙",
                            "text": "另外，之前我们用了几百箱货物压载，其中有许多品相不错的矿石和布匹，这次靠岸，正好托人在挪德卡莱出售。"
                        },
                        {
                            "id": "402093007",
                            "speaker": "龚妙",
                            "text": "不知道北斗大姐头那边的生意能赚多少…"
                        },
                        {
                            "id": "402093008",
                            "speaker": "龚妙",
                            "text": "长期稳定健康的收入，是维持船队不断发展的基石。如果挪德卡莱这边的情况乐观，说不定以后可以多往这边跑跑！"
                        }
                    ]
                },
                {
                    "id": "402093009",
                    "text": "那祝顺利，再见！",
                    "response": [
                        {
                            "id": "402093010",
                            "speaker": "龚妙",
                            "text": "谢谢！你也是！"
                        }
                    ]
                }
            ]
        }
    ]
}