{
    "talkId": "4013617",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "神里绫人": 11
    },
    "dialogues": [
        {
            "id": "401361701",
            "speaker": "神里绫人",
            "text": "没想到会在这里碰见你。",
            "choices": [
                {
                    "id": "401361702",
                    "text": "关于你正在喝的东西…",
                    "response": [
                        {
                            "id": "401361703",
                            "speaker": "神里绫人",
                            "text": "哦，这种叫做「枫达」的饮料，口感新颖，我很喜欢。"
                        },
                        {
                            "id": "401361704",
                            "speaker": "神里绫人",
                            "text": "「畅饮世界」的宣传语也不错，有点想把它也列做「文化交流」的项目之一了。"
                        },
                        {
                            "id": "401361705",
                            "speaker": "神里绫人",
                            "text": "如果往「枫达」里加一些薄荷会怎么样呢？我很在意。"
                        },
                        {
                            "id": "401361706",
                            "speaker": "神里绫人",
                            "text": "不如再勇敢一些，往「枫达」里兑等比例的什锦奶茶…"
                        },
                        {
                            "id": "401361707",
                            "speaker": "神里绫人",
                            "text": "呵呵，感觉并不会好喝呢。"
                        }
                    ]
                },
                {
                    "id": "401361708",
                    "text": "关于映影…",
                    "response": [
                        {
                            "id": "401361709",
                            "speaker": "神里绫人",
                            "text": "多亏你们，映影顺利上映， 社奉行也同沫芒宫达成了合作。"
                        },
                        {
                            "id": "401361710",
                            "speaker": "神里绫人",
                            "text": "如果下次还有机会的话，我是不是真的该尝试担任一部电影的主演呢？"
                        },
                        {
                            "id": "401361711",
                            "speaker": "神里绫人",
                            "text": "还是说…在你看来，「反派」这类角色要更适合我？"
                        }
                    ]
                },
                {
                    "id": "401361712",
                    "text": "希望回程顺利。",
                    "response": [
                        {
                            "id": "401361713",
                            "speaker": "神里绫人",
                            "text": "谢谢，我会照顾好绫华和宵宫她们的。"
                        },
                        {
                            "id": "401361714",
                            "speaker": "神里绫人",
                            "text": "也愿你今后的旅途顺利。"
                        }
                    ]
                }
            ]
        }
    ]
}