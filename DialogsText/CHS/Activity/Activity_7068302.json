{
    "talkId": "7068302",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "艾玛托": 14
    },
    "dialogues": [
        {
            "id": "706830201",
            "speaker": "艾玛托",
            "text": "嗯嗯嗯，如果装上尾翼的话，稳定性说不定就能…哦哦，你好你好，荣誉骑士大人！第七小队武器官艾玛托报到！有什么指示吗？",
            "choices": [
                {
                    "id": "706830202",
                    "text": "你在做什么？",
                    "response": [
                        {
                            "id": "706830203",
                            "speaker": "艾玛托",
                            "text": "报告！和往常一样，我正在思考新的炸弹构造！以及…按照方妮雅的要求，正在「安安静静地进行推演，不要损伤她的耳朵」！",
                            "choices": [
                                {
                                    "id": "706830204",
                                    "text": "呃，炸弹的构造？",
                                    "response": [
                                        {
                                            "id": "706830205",
                                            "speaker": "艾玛托",
                                            "text": "是的！荣誉骑士大人，您应该也见证过火花骑士那优美而华丽的「蹦蹦炸弹」吧？"
                                        },
                                        {
                                            "id": "706830206",
                                            "speaker": "艾玛托",
                                            "text": "本人艾玛托，虽然只是个小小的、不值一提的普通炼金术士，但我依然有一个「梦想」！"
                                        },
                                        {
                                            "id": "706830207",
                                            "speaker": "艾玛托",
                                            "text": "不是钻研出「黄金与水银」化合的「构造」，而是钻研出能够接近「蹦蹦炸弹」二十分之一威力的「构造」！"
                                        },
                                        {
                                            "id": "706830208",
                                            "speaker": "艾玛托",
                                            "text": "所以，我一直在思考全新的设计方案！完美的爆速，猛烈的震波，简洁的工艺，宜人的成本…啊啊，光是想想就让我浑身颤抖…"
                                        },
                                        {
                                            "id": "706830209",
                                            "speaker": "艾玛托",
                                            "text": "啊，抱歉，一不小心又入迷了！总之，如果有什么炸弹…不对，如果有什么我能为您做的事，就请随时告诉我吧，荣誉骑士大人！"
                                        }
                                    ]
                                },
                                {
                                    "id": "706830210",
                                    "text": "好吧，那我不打扰你了…",
                                    "response": [
                                        {
                                            "id": "706830211",
                                            "speaker": "艾玛托",
                                            "text": "哦哦，好的好的！慢走，荣誉骑士大人！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706830212",
                    "text": "「武器官」？",
                    "response": [
                        {
                            "id": "706830213",
                            "speaker": "艾玛托",
                            "text": "是的！我们的工作职责偏向后勤，您没听说过也是正常的！所谓「武器官」，就是对实验性装备进行开发与测试的骑士。"
                        },
                        {
                            "id": "706830214",
                            "speaker": "艾玛托",
                            "text": "就比方说，我现在正在思考新型远程投射物的设计结构…总之，如果有什么我能为您做的事，就请随时告诉我吧，荣誉骑士大人！"
                        }
                    ]
                },
                {
                    "id": "706830215",
                    "text": "你也是来参加兵棋推演的吗？",
                    "response": [
                        {
                            "id": "706830216",
                            "speaker": "艾玛托",
                            "text": "这个…哈哈，更准确地来说，是被方妮雅…呃，我是说方妮雅长官，强行拉过来的…"
                        },
                        {
                            "id": "706830217",
                            "speaker": "艾玛托",
                            "text": "毕竟我这么笨，搞不懂什么复杂的战术嘛。我只想安安心心地研究炸弹，再追随火花骑士大人的脚步，自由自在地引爆它们…"
                        },
                        {
                            "id": "706830218",
                            "speaker": "艾玛托",
                            "text": "啊，不过，如果您需要帮忙复位棋盘的话，请随时叫我！第七小队武器官艾玛托，很乐意为您效劳，荣誉骑士大人！"
                        }
                    ]
                },
                {
                    "id": "706830219",
                    "text": "没事，你继续忙吧。",
                    "response": [
                        {
                            "id": "706830220",
                            "speaker": "艾玛托",
                            "text": "哦哦，好的好的！慢走，荣誉骑士大人！"
                        }
                    ]
                }
            ]
        }
    ]
}