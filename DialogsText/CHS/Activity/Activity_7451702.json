{
    "talkId": "7451702",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 7,
        "蒂蕾娜": 13
    },
    "dialogues": [
        {
            "id": "745170201",
            "speaker": "蒂蕾娜",
            "text": "准领队，一段时间不见，感觉您的目光更加锐利了，完全可以…轻松锁定并击中千步距离上的目标！",
            "choices": [
                {
                    "id": "745170202",
                    "text": "但领队更该注重指挥吧。",
                    "response": [
                        {
                            "id": "745170203",
                            "speaker": "蒂蕾娜",
                            "text": "道理确实是这样啦，所以还请您尽情推演，把所有想试的战术都发挥出来。"
                        },
                        {
                            "id": "745170204",
                            "speaker": "蒂蕾娜",
                            "text": "不过，映影里面也有那种…我方猛将一下就把对方的头领「射落马下」，让对方士气崩溃的桥段嘛，超帅气！"
                        }
                    ]
                },
                {
                    "id": "745170205",
                    "text": "那你现在的射术怎么样？",
                    "response": [
                        {
                            "id": "745170206",
                            "speaker": "蒂蕾娜",
                            "text": "报告准领队，两百步的半身靶，最好记录十五中九，夏沃蕾队长说，我算是中规中矩的射手了！"
                        },
                        {
                            "id": "745170207",
                            "speaker": "蒂蕾娜",
                            "text": "不过，最近我发现，特巡队为了保证对大型魔物的杀伤力，一直选用较大口径的铳枪，弹头很重，远距离留存的动能够大。"
                        },
                        {
                            "id": "745170208",
                            "speaker": "蒂蕾娜",
                            "text": "但我们不像夏沃蕾队长，能用元素力驱动专用铳枪，打出秒速好几千的弹头，无比狂猛…"
                        },
                        {
                            "id": "745170209",
                            "speaker": "蒂蕾娜",
                            "text": "发射药量相同的情况下，弹头越重，初速越慢，弹道也就越弯曲，极端情况下，有些枪甚至被笑成投石机。",
                            "choices": [
                                {
                                    "id": "745170210",
                                    "text": "为了威力牺牲了攻击距离…",
                                    "response": [
                                        {
                                            "id": "745170212",
                                            "speaker": "蒂蕾娜",
                                            "text": "没错，可惜射手的身体能抵御的后坐力也有限，不可能一直加大发射药量，要不然，一开枪，射手先肩膀报废重伤倒地了…"
                                        },
                                        {
                                            "id": "745170213",
                                            "speaker": "蒂蕾娜",
                                            "text": "如果优化弹头的弹形，加强弹头战胜空气阻力的能力，就可以缩小口径，提升初速，既改善了命中率，又保住了远距离的动能！"
                                        },
                                        {
                                            "id": "745170214",
                                            "speaker": "蒂蕾娜",
                                            "text": "同时，在弹头表面和内部使用不同硬度的材料，加强弹头侵彻后的翻滚和破碎，确保毁伤后效…",
                                            "choices": [
                                                {
                                                    "id": "745170215",
                                                    "text": "从这里开始听不懂了。",
                                                    "response": [
                                                        {
                                                            "id": "745170217",
                                                            "speaker": "蒂蕾娜",
                                                            "text": "可是我又不是枫丹科学院的工程师，不知道要怎么计算…也只能先记录一下，回头给队里的枪匠说说看了。"
                                                        },
                                                        {
                                                            "id": "745170218",
                                                            "speaker": "蒂蕾娜",
                                                            "text": "哎，真希望有一把…指哪打哪，没后坐力，弹药也方便携带的好枪！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "745170216",
                                                    "text": "嗯嗯嗯！对的对的！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "745170211",
                                    "text": "很难打中比较远的目标吧…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "745170219",
                    "text": "你别走动，我推演几盘就来。",
                    "response": [
                        {
                            "id": "745170220",
                            "speaker": "蒂蕾娜",
                            "text": "那肯定，我会一直看着您推演，专心学习的，请放心！"
                        }
                    ]
                }
            ]
        }
    ]
}