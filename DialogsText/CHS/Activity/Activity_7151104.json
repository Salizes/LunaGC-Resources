{
    "talkId": "7151104",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "德沃沙克": 12
    },
    "dialogues": [
        {
            "id": "715110401",
            "speaker": "德沃沙克",
            "text": "太棒了…实在是太棒了…",
            "choices": [
                {
                    "id": "715110402",
                    "text": "关于演出…",
                    "response": [
                        {
                            "id": "715110403",
                            "speaker": "德沃沙克",
                            "text": "嗯，听到云间有乐声传来的时候，我整个人都快呆滞了。"
                        },
                        {
                            "id": "715110404",
                            "speaker": "德沃沙克",
                            "text": "它对我来说具有某种「魔力」…唔，或许该说是「仙力」？"
                        },
                        {
                            "id": "715110405",
                            "speaker": "德沃沙克",
                            "text": "最后的合奏也非常震撼！要不是我人还在舞台上，可能都会哭出来。"
                        }
                    ]
                },
                {
                    "id": "715110407",
                    "text": "关于今后的安排…",
                    "response": [
                        {
                            "id": "715110408",
                            "speaker": "德沃沙克",
                            "text": "「天权星」凝光小姐，邀请我之后去玉京台，详细探讨长期计划。"
                        },
                        {
                            "id": "715110409",
                            "speaker": "德沃沙克",
                            "text": "真希望一切顺利，未来也能有这样的合作机会。"
                        },
                        {
                            "id": "715110410",
                            "speaker": "德沃沙克",
                            "text": "到时候你可一定要来啊！我给你留最好的位置。"
                        }
                    ]
                },
                {
                    "id": "715110411",
                    "text": "关于「仙女」…",
                    "response": [
                        {
                            "id": "715110412",
                            "speaker": "德沃沙克",
                            "text": "哈哈…我已经和她当面道过谢了。"
                        },
                        {
                            "id": "715110413",
                            "speaker": "德沃沙克",
                            "text": "她说：「见人有难出手相助是天经地义之事，而你带给璃月港的精彩音乐，更值得感谢与祝福。」"
                        },
                        {
                            "id": "715110414",
                            "speaker": "德沃沙克",
                            "text": "啊，真是令我受宠若惊…"
                        },
                        {
                            "id": "715110415",
                            "speaker": "德沃沙克",
                            "text": "但我也决定了，一定要创作出更精彩的，属于我们这个时代的音乐！"
                        }
                    ]
                },
                {
                    "id": "715110416",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715110417",
                            "speaker": "德沃沙克",
                            "text": "#这次多亏有你，{NICKNAME}，请让我再次致以最真挚的感谢！"
                        }
                    ]
                }
            ]
        }
    ]
}