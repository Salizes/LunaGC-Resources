        "Player": 2,
        "里艾蒂": 5
    },
    "dialogues": [
        {
            "id": "766590201",
            "speaker": "里艾蒂",
            "text": "你好，有什么事吗？",
            "choices": [
                {
                    "id": "766590203",
                    "text": "你是？",
                    "response": [
                        {
                            "id": "766590204",
                            "speaker": "里艾蒂",
                            "text": "叫我里艾蒂就好，我也是挪德卡莱冒险家协会的成员。那个格乌登提被抓走后，会长叫我来代替他与工坊接洽。"
                        },
                        {
                            "id": "766590205",
                            "speaker": "里艾蒂",
                            "text": "毕竟爱诺女士对于侦察单元的研究还没有结束，会长对此很重视。"
                        }
                    ]
                },
                {
                    "id": "766590206",
                    "text": "愚人众那边…",
                    "response": [
                        {
                            "id": "766590207",
                            "speaker": "里艾蒂",
                            "text": "不用担心，之前搭建的月灵旅路都可以继续使用，收集到的零部件也不用归还。"
                        },
                        {
                            "id": "766590208",
                            "speaker": "里艾蒂",
                            "text": "他们似乎知道是他们自己找的人不靠谱，并没有对我们进行追责的意思。"
                        }
                    ]
                }
            ]
        }
    ]
}