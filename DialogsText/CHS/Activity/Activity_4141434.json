{
    "talkId": "4141434",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "艾琳": 7
    },
    "dialogues": [
        {
            "id": "414143401",
            "speaker": "Player",
            "text": "你的作业完成得怎么样了？"
        },
        {
            "id": "414143402",
            "speaker": "艾琳",
            "text": "是说写给琴大人的情诗吗？我、我有在努力写了！"
        },
        {
            "id": "414143403",
            "speaker": "艾琳",
            "text": "温迪老师教的是情诗技巧，但我想表达的，更多是憧憬与向往之情。"
        },
        {
            "id": "414143404",
            "speaker": "艾琳",
            "text": "带着这种心情创作了一首小诗，还没来得及交给老师…唔，可以的话，你要听听吗？"
        },
        {
            "id": "414143405",
            "speaker": "Player",
            "text": "好啊。"
        },
        {
            "id": "414143406",
            "speaker": "艾琳",
            "text": "「你办公时认真的侧脸\\n犹如夜空里璀璨的月亮一般\\n令我陷入梦幻」"
        },
        {
            "id": "414143407",
            "speaker": "艾琳",
            "text": "怎么样？还可以吗？",
            "choices": [
                {
                    "id": "414143408",
                    "text": "很有诚意！",
                    "response": [
                        {
                            "id": "414143410",
                            "speaker": "艾琳",
                            "text": "真的吗？太好了，这就是我想达到的效果！"
                        },
                        {
                            "id": "414143411",
                            "speaker": "艾琳",
                            "text": "谢谢你，那我再修改一番就去交作业啦！"
                        }
                    ]
                },
                {
                    "id": "414143409",
                    "text": "感情非常饱满呢…"
                }
            ]
        }
    ]
}