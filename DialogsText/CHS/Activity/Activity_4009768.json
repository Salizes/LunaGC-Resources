    "dialogues": [
        {
            "id": "400976801",
            "speaker": "Player",
            "text": "那个家伙？"
        },
        {
            "id": "400976802",
            "speaker": "昆恩",
            "text": "哦，你问贝雅啊。"
        },
        {
            "id": "400976803",
            "speaker": "昆恩",
            "text": "不知道她到底在想什么。"
        },
        {
            "id": "400976804",
            "speaker": "昆恩",
            "text": "自从风花节开始，就一直在念叨什么誓言岬、心形的日落果…"
        },
        {
            "id": "400976805",
            "speaker": "昆恩",
            "text": "怎么可能有那种日落果啊…"
        },
        {
            "id": "400976806",
            "speaker": "昆恩",
            "text": "你说对吧，嗝…"
        }
    ]
}