{
    "talkId": "7350630",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 5,
        "丽莎": 9
    },
    "dialogues": [
        {
            "id": "735063001",
            "speaker": "丽莎",
            "text": "小可爱，我们果然遇到了呢。"
        },
        {
            "id": "735063002",
            "speaker": "Player",
            "text": "这里不太好找。"
        },
        {
            "id": "735063003",
            "speaker": "丽莎",
            "text": "欸，有吗？不过须弥城毕竟是我曾经生活过的地方，故地重游，忍不住就想去各种偏僻的小店看看。"
        },
        {
            "id": "735063004",
            "speaker": "丽莎",
            "text": "让人遗憾的是，有家我以前常去的成衣店居然已经倒闭很久了。"
        },
        {
            "id": "735063005",
            "speaker": "丽莎",
            "text": "我本来还想多买些饰品和衣服，送给骑士团里的女孩子们的，嗯…有点可惜啊。",
            "choices": [
                {
                    "id": "735063006",
                    "text": "丽莎买了新衣服。",
                    "response": [
                        {
                            "id": "735063008",
                            "speaker": "丽莎",
                            "text": "我还在想小可爱什么时候才会注意到这件新衣服呢，怎么样，你觉得好看吗？",
                            "choices": [
                                {
                                    "id": "735063009",
                                    "text": "很显气质。",
                                    "response": [
                                        {
                                            "id": "735063011",
                                            "speaker": "丽莎",
                                            "text": "从别人嘴里听到称赞的话，果然让人开心，谢谢你哦，小可爱。"
                                        },
                                        {
                                            "id": "735063012",
                                            "speaker": "丽莎",
                                            "text": "这件衣服是我找到了那家成衣店的店主，请她特别定制的。"
                                        },
                                        {
                                            "id": "735063013",
                                            "speaker": "丽莎",
                                            "text": "穿上就想起了以前在教令院的时光，那时候可真是忙碌呀…"
                                        },
                                        {
                                            "id": "735063014",
                                            "speaker": "丽莎",
                                            "text": "不过我手下的研究人员也从来不敢偷懒，不像某些借书不还的家伙，只用雷元素力来惩罚他们是不是太宽容了呢…"
                                        }
                                    ]
                                },
                                {
                                    "id": "735063010",
                                    "text": "风格优雅。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735063007",
                    "text": "丽莎的新衣服很漂亮。"
                }
            ]
        }
    ]
}