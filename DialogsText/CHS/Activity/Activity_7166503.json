{
    "talkId": "7166503",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "兰吉特": 7
    },
    "dialogues": [
        {
            "id": "716650301",
            "speaker": "兰吉特",
            "text": "我已经准备万全了。还是说你想聊聊？",
            "choices": [
                {
                    "id": "716650302",
                    "text": "爆炎树和纳塔的龙哪里像了？",
                    "response": [
                        {
                            "id": "716650303",
                            "speaker": "兰吉特",
                            "text": "…哈哈，这你就不知道了吧，纳塔有能够吐出火球的龙呢！啊，那种过量的火元素扑面而来的感觉，就很有纳塔的味道！"
                        },
                        {
                            "id": "716650304",
                            "speaker": "兰吉特",
                            "text": "其实我是这么打算的，作为挑战的第一步，选个难度低一点的也是常理，对吧？"
                        },
                        {
                            "id": "716650305",
                            "speaker": "兰吉特",
                            "text": "爆炎树不躲也不藏，不用费劲去找，也不怕它逃跑，真是再合适不过了。"
                        },
                        {
                            "id": "716650306",
                            "speaker": "兰吉特",
                            "text": "而且就算不能和它交上朋友，爆炎树的果实也是不错的创意料理食材呢…"
                        }
                    ]
                },
                {
                    "id": "716650307",
                    "text": "说起来还没见过纳塔人…",
                    "response": [
                        {
                            "id": "716650308",
                            "speaker": "兰吉特",
                            "text": "这个嘛，纳塔的朋友对于离开纳塔这件事的确有许多顾忌，这事我一个外人也不好说三道四。"
                        },
                        {
                            "id": "716650309",
                            "speaker": "兰吉特",
                            "text": "什么规矩、禁忌之类的我也不太懂，不过我想应该不会是简单的水土不服吧，哈哈。"
                        }
                    ]
                },
                {
                    "id": "716650310",
                    "text": "没什么想聊的。"
                }
            ]
        }
    ]
}