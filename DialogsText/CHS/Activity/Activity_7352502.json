{
    "talkId": "7352502",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "沛休": 8
    },
    "dialogues": [
        {
            "id": "735250201",
            "speaker": "沛休",
            "text": "唔，这里也有几处需要勘定的地方…全是从山形轮廓上看不出来的小道…"
        },
        {
            "id": "735250202",
            "speaker": "沛休",
            "text": "#{NICKNAME}，怎么样，勘定工作还顺利吗？",
            "choices": [
                {
                    "id": "735250203",
                    "text": "关于测绘工作…",
                    "response": [
                        {
                            "id": "735250204",
                            "speaker": "沛休",
                            "text": "嗯，测绘工作很辛苦，但是对于依靠地图来回往来的人来说，对过去的路进行勘定，非常重要。"
                        },
                        {
                            "id": "735250205",
                            "speaker": "沛休",
                            "text": "以及，如果有什么危险之处，也可以让他们提前避开，保证来往行人的安全。"
                        },
                        {
                            "id": "735250206",
                            "speaker": "沛休",
                            "text": "不过果然，那些需要勘定、人迹罕至的地方，现在看上去都被各种魔物和蕈兽占据了…"
                        }
                    ]
                },
                {
                    "id": "735250207",
                    "text": "关于人手不足…",
                    "response": [
                        {
                            "id": "735250208",
                            "speaker": "沛休",
                            "text": "勘定的工作，当然是有越多人做越好…不仅仅是因为地势险要之处本来就有危险，说不定还会有各种奇怪的魔物…"
                        },
                        {
                            "id": "735250209",
                            "speaker": "沛休",
                            "text": "下次，下次还是让岚姐帮忙多安排点人手吧。"
                        }
                    ]
                },
                {
                    "id": "735250210",
                    "text": "还算顺利。",
                    "response": [
                        {
                            "id": "735250211",
                            "speaker": "沛休",
                            "text": "那就好那就好！不过，要是遇上什么问题，也可以和我说，我标注在地图上…"
                        }
                    ]
                }
            ]
        }
    ]
}