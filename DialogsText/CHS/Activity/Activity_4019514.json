    "dialogues": [
        {
            "id": "401951401",
            "speaker": "欧洛伦",
            "text": "♪~"
        },
        {
            "id": "401951402",
            "speaker": "伊法",
            "text": "心情不错？"
        },
        {
            "id": "401951403",
            "speaker": "欧洛伦",
            "text": "嗯！看到心爱的蔬菜们都有了各自的归宿，我感到十分欣慰。"
        },
        {
            "id": "401951404",
            "speaker": "伊法",
            "text": "你现在说话好像一位自豪的家长，我为你感到高兴。"
        },
        {
            "id": "401951405",
            "speaker": "伊法",
            "text": "但因为蔬菜的归宿是在锅里，我同时又感到有些害怕。"
        },
        {
            "id": "401951406",
            "speaker": "咔库库",
            "text": "幸会，哥们！"
        },
        {
            "id": "401951407",
            "speaker": "伊法",
            "text": "什么意思？现在是该说「幸会」的时候吗？"
        },
        {
            "id": "401951408",
            "speaker": "欧洛伦",
            "text": "我猜，咔库库应该是在指蔬菜与锅的「幸会」吧。"
        },
        {
            "id": "401951409",
            "speaker": "咔库库",
            "text": "说得好，哥们！"
        },
        {
            "id": "401951410",
            "speaker": "伊法",
            "text": "……"
        },
        {
            "id": "401951411",
            "speaker": "伊法",
            "text": "说实话，我不知道是该担心你们对幸运的定义，还是应该好奇你和咔库库是否心有灵犀。"
        }
    ]
}