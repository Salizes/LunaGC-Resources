{
    "talkId": "7265504",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "慕珍": 13
    },
    "dialogues": [
        {
            "id": "726550401",
            "speaker": "慕珍",
            "text": "哈啊——好困…岸上有什么好的…"
        },
        {
            "id": "726550402",
            "speaker": "慕珍",
            "text": "啊，旅行者，你好！这阵子辛苦你了。"
        },
        {
            "id": "726550403",
            "speaker": "慕珍",
            "text": "多亏了你的努力，旅行者！现在我们终于能够给大姐头交差了。",
            "choices": [
                {
                    "id": "726550404",
                    "text": "谁会想要这种东西…",
                    "response": [
                        {
                            "id": "726550406",
                            "speaker": "慕珍",
                            "text": "看起来很危险，对吧？"
                        },
                        {
                            "id": "726550407",
                            "speaker": "慕珍",
                            "text": "既然目的地是须弥，恐怕只有那些奇奇怪怪的「学者」会研究这种东西吧。"
                        },
                        {
                            "id": "726550408",
                            "speaker": "慕珍",
                            "text": "可不是那些天天在外面转悠的游学者。我想他们更类似我这种人，是些整天闷在学斋里研究物件的「技术员」。"
                        },
                        {
                            "id": "726550409",
                            "speaker": "慕珍",
                            "text": "而且我猜在那座遗迹里不止这几台机械…"
                        },
                        {
                            "id": "726550410",
                            "speaker": "慕珍",
                            "text": "如果你还有兴趣的话，可以继续探索那座遗迹，然后把取得的零件交给我们，报酬不会少的！"
                        },
                        {
                            "id": "726550411",
                            "speaker": "慕珍",
                            "text": "毕竟这种贵重商品不论对于我们，还是须弥的客户而言，都是多多益善嘛！",
                            "choices": [
                                {
                                    "id": "726550412",
                                    "text": "你还没有回船上？",
                                    "response": [
                                        {
                                            "id": "726550414",
                                            "speaker": "慕珍",
                                            "text": "是啊，属于我的工作基本完成了，等到货物分检完毕之后，才是我插手的时候。"
                                        },
                                        {
                                            "id": "726550415",
                                            "speaker": "慕珍",
                                            "text": "于是我就又被海龙大哥赶到岸上来咯。"
                                        },
                                        {
                                            "id": "726550416",
                                            "speaker": "慕珍",
                                            "text": "「别总是闷在船上，多吹吹海风对你身体有好处。」哼，什么人嘛！"
                                        },
                                        {
                                            "id": "726550417",
                                            "speaker": "慕珍",
                                            "text": "哈啊…没有别的事的话，请让我打会盹吧。实在不好意思…"
                                        }
                                    ]
                                },
                                {
                                    "id": "726550413",
                                    "text": "你还在这里？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "726550405",
                    "text": "这些零件有点邪门。"
                }
            ]
        }
    ]
}