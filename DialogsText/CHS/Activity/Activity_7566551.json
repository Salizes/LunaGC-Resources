{
    "talkId": "7566551",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 3,
        "薇内什": 5
    },
    "dialogues": [
        {
            "id": "756655101",
            "speaker": "薇内什",
            "text": "欢迎来到「龙龙远征队补给站」，我们正在为参加远征的小龙提供指导，要一起来吗？",
            "choices": [
                {
                    "id": "756655102",
                    "text": "指导小龙。"
                },
                {
                    "id": "756655103",
                    "text": "闲聊。",
                    "response": [
                        {
                            "id": "756655104",
                            "speaker": "薇内什",
                            "text": "我和哥哥正在伊法前辈的诊所实习哦，虽然实习的时间还很短，但每天都很充实。"
                        },
                        {
                            "id": "756655105",
                            "speaker": "薇内什",
                            "text": "伊法前辈和咔库库前辈都很厉害，是我和哥哥的榜样。我们也希望成为受龙欢迎的好医生。"
                        },
                        {
                            "id": "756655106",
                            "speaker": "薇内什",
                            "text": "我尤其喜欢咔库库前辈，嘿嘿。不过最近经常看到它和另外一只奇怪的黄色小龙吵架，让我有点担心。"
                        },
                        {
                            "id": "756655107",
                            "speaker": "薇内什",
                            "text": "那只小龙还自称什么「伟大圣龙」。千万不要把咔库库前辈带坏呀…"
                        }
                    ]
                },
                {
                    "id": "756655108",
                    "text": "离开。"
                }
            ]
        }
    ]
}