{
    "talkId": "7750407",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 11,
        "大喜儿": 22
    },
    "dialogues": [
        {
            "id": "775040701",
            "speaker": "大喜儿",
            "text": "你好啊，荣誉骑士杜麦尼，没想到还能在这里碰见你。",
            "choices": [
                {
                    "id": "775040702",
                    "text": "你这是在干什么？",
                    "response": [
                        {
                            "id": "775040703",
                            "speaker": "大喜儿",
                            "text": "「运气御寒」。"
                        },
                        {
                            "id": "775040704",
                            "speaker": "大喜儿",
                            "text": "通俗地讲，是在磨练自己的意志——"
                        },
                        {
                            "id": "775040705",
                            "speaker": "大喜儿",
                            "text": "只穿单薄的布衣，适应极寒环境，是传统武学的一门经典本领，我快初具神功了！"
                        },
                        {
                            "id": "775040706",
                            "speaker": "大喜儿",
                            "text": "不过，比起当年的霍大师，还是差了不少火候…",
                            "choices": [
                                {
                                    "id": "775040707",
                                    "text": "霍大师…是谁？",
                                    "response": [
                                        {
                                            "id": "775040709",
                                            "speaker": "大喜儿",
                                            "text": "我也只是从师父那里听说过他的威名啦。"
                                        },
                                        {
                                            "id": "775040710",
                                            "speaker": "大喜儿",
                                            "text": "他既是一名剑术大师，又懂得锻造兵刃。"
                                        },
                                        {
                                            "id": "775040711",
                                            "speaker": "大喜儿",
                                            "text": "霍大师凭借那柄名为「藏锋」的宝剑，斩除妖邪，在江湖上留下了不少佳话。"
                                        },
                                        {
                                            "id": "775040712",
                                            "speaker": "大喜儿",
                                            "text": "可最近坊间有人在复盘，说：随着名望增长，霍大师意识到自己变得心浮气躁，开始寻找幽冷的避世之地。"
                                        },
                                        {
                                            "id": "775040713",
                                            "speaker": "大喜儿",
                                            "text": "于是他向着提瓦特的北域不断挺进，最终消失在至冬呼啸的风雪之中…",
                                            "choices": [
                                                {
                                                    "id": "775040714",
                                                    "text": "听起来挺玄乎的。",
                                                    "response": [
                                                        {
                                                            "id": "775040716",
                                                            "speaker": "大喜儿",
                                                            "text": "话又说回来了，前两周，霍大师的妹妹出来澄清，她觉得这则故事被添油加醋得太夸张，让人别再谣传。"
                                                        },
                                                        {
                                                            "id": "775040717",
                                                            "speaker": "大喜儿",
                                                            "text": "考虑到十年前，我的师父成了她的手下败将，她最近也要来至冬，我就不多嘴啦。"
                                                        },
                                                        {
                                                            "id": "775040718",
                                                            "speaker": "大喜儿",
                                                            "text": "沉下心来习武，不断提升自我，才是正道…"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "775040715",
                                                    "text": "宝剑的名字有点耳熟。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "775040708",
                                    "text": "没见过这位高手。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775040719",
                    "text": "你像是璃月人，怎么这么叫我？",
                    "response": [
                        {
                            "id": "775040720",
                            "speaker": "大喜儿",
                            "text": "我妹妹在蒙德待了很多年嘛，每次和我们团聚的时候，都会给我们讲蒙德美食和骑士团的故事。"
                        },
                        {
                            "id": "775040721",
                            "speaker": "大喜儿",
                            "text": "之前参加龙脊雪山国际越野赛的时候，也远远看到了你，不过，你应该完全没注意到我。"
                        },
                        {
                            "id": "775040722",
                            "speaker": "大喜儿",
                            "text": "后来，我买了几车「邦邦滚石」的水果和颗粒果，被她邀请到纳塔玩，又听了一圈关于你的传说。"
                        },
                        {
                            "id": "775040723",
                            "speaker": "大喜儿",
                            "text": "两个威风的称号合在一起，听起来不就格外厉害了吗？这才配得上你传说级的江湖高手身份。",
                            "choices": [
                                {
                                    "id": "775040724",
                                    "text": "那你没告诉琪琪科娃吗？",
                                    "response": [
                                        {
                                            "id": "775040726",
                                            "speaker": "大喜儿",
                                            "text": "哎呀，亲眼见证江湖高手的厉害之处，可比从别人那里听说要有趣。"
                                        },
                                        {
                                            "id": "775040727",
                                            "speaker": "大喜儿",
                                            "text": "况且琪琪科娃也未必知道外地的传说，有时，就连到过某个国家的游客都会错漏一些情报。"
                                        },
                                        {
                                            "id": "775040728",
                                            "speaker": "大喜儿",
                                            "text": "比如，您听过我师父「飞叶斩鬼·黄衫」的事迹吗？",
                                            "choices": [
                                                {
                                                    "id": "775040729",
                                                    "text": "还真没听过…谁来着？",
                                                    "response": [
                                                        {
                                                            "id": "775040731",
                                                            "speaker": "大喜儿",
                                                            "text": "所以嘛，提瓦特这么大，到处都有高手，想认全很难的啦。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "775040730",
                                                    "text": "听说过，但没什么实感…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "775040725",
                                    "text": "你在配合我低调行事哦？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775040732",
                    "text": "下次再聊！",
                    "response": [
                        {
                            "id": "775040733",
                            "speaker": "大喜儿",
                            "text": "你且慢走，我继续运功了。"
                        }
                    ]
                }
            ]
        }
    ]
}