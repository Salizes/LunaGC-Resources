                                    "response": [
                                        {
                                            "id": "736962311",
                                            "speaker": "巴哈尔",
                                            "text": "佩迪姆为什么全身都湿透了？",
                                            "choices": [
                                                {
                                                    "id": "736962312",
                                                    "text": "佩迪姆喜欢淋雨。"
                                                },
                                                {
