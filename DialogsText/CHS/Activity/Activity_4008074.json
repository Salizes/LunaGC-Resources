{
    "talkId": "4008074",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "迪卢克": 16
    },
    "dialogues": [
        {
            "id": "400807401",
            "speaker": "迪卢克",
            "text": "佳酿节氛围如何？还喜欢吗？",
            "choices": [
                {
                    "id": "400807402",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400807405",
                            "speaker": "迪卢克",
                            "text": "有什么想知道的事？",
                            "choices": [
                                {
                                    "id": "400807406",
                                    "text": "关于雷泽…",
                                    "response": [
                                        {
                                            "id": "400807407",
                                            "speaker": "迪卢克",
                                            "text": "我能理解远离亲人的苦闷。"
                                        },
                                        {
                                            "id": "400807408",
                                            "speaker": "迪卢克",
                                            "text": "固然不幸，但也未尝不是一种成长。想要成为独当一面的男人…或许就要学着面对这些。"
                                        },
                                        {
                                            "id": "400807409",
                                            "speaker": "迪卢克",
                                            "text": "有同伴帮助，想必会过渡得更顺利。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807410",
                                    "text": "关于「声音」…",
                                    "response": [
                                        {
                                            "id": "400807411",
                                            "speaker": "迪卢克",
                                            "text": "…启封的陈酿里，似乎有父亲从前说过的话。"
                                        },
                                        {
                                            "id": "400807412",
                                            "speaker": "迪卢克",
                                            "text": "如果他见到我现在的样子，又不知会怎么想了。"
                                        },
                                        {
                                            "id": "400807413",
                                            "speaker": "迪卢克",
                                            "text": "总不会还抱有过去那种观点吧。"
                                        },
                                        {
                                            "id": "400807414",
                                            "speaker": "Player",
                                            "text": "一定会的。"
                                        },
                                        {
                                            "id": "400807415",
                                            "speaker": "迪卢克",
                                            "text": "……"
                                        },
                                        {
                                            "id": "400807416",
                                            "speaker": "迪卢克",
                                            "text": "是吗。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807417",
                                    "text": "关于「佳酿节」…",
                                    "response": [
                                        {
                                            "id": "400807418",
                                            "speaker": "迪卢克",
                                            "text": "对于蒙德人来说，酿造是沉淀情感的过程，也是铭记历史的方式。"
                                        },
                                        {
                                            "id": "400807419",
                                            "speaker": "迪卢克",
                                            "text": "如今战争远去，生活安宁了许多，我们才能酿出品质更为上乘的美酒。"
                                        },
                                        {
                                            "id": "400807420",
                                            "speaker": "迪卢克",
                                            "text": "就算不亲身汇入欢庆的人群，我也为此感到满足。"
                                        },
                                        {
                                            "id": "400807421",
                                            "speaker": "迪卢克",
                                            "text": "说起来，「假日果酿」…你尝过了吗？"
                                        },
                                        {
                                            "id": "400807422",
                                            "speaker": "迪卢克",
                                            "text": "如果有什么改进建议，我很乐意听。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807403",
                    "text": "先不打扰你了。",
                    "response": [
                        {
                            "id": "400807404",
                            "speaker": "迪卢克",
                            "text": "嗯，有空再聊。"
                        }
                    ]
                }
            ]
        }
    ]
}