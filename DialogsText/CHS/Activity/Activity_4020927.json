{
    "talkId": "4020927",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "志遥": 6
    },
    "dialogues": [
        {
            "id": "402092701",
            "speaker": "志遥",
            "text": "#哟！北斗大姐头的好{M#兄弟}{F#姐妹}，欢迎来到「南十字」船队的二号舰，请将这里当成自家的船！",
            "choices": [
                {
                    "id": "402092702",
                    "text": "这艘为什么是「二号舰」？",
                    "response": [
                        {
                            "id": "402092703",
                            "speaker": "志遥",
                            "text": "嗯，严格来说，这艘船是「死兆星」号同级的二号舰才对，船队里有许多船龄远大于她的姐姐。"
                        },
                        {
                            "id": "402092704",
                            "speaker": "志遥",
                            "text": "不过，本着便于记忆和管理的原则，大姐头定了个规矩——船队里的编号，需要按吨位从大到小排序。"
                        },
                        {
                            "id": "402092705",
                            "speaker": "志遥",
                            "text": "所以她在加入船队后，就顺理成章拿到了二号舰的位置，成了许多弟兄们努力转调的目标。"
                        },
                        {
                            "id": "402092706",
                            "speaker": "志遥",
                            "text": "当然，荣誉是责任的衍生品。之后，二号舰就会一直在最凶险的海域巡逻，处理那些海盗水匪和魔物，保证航道安全。"
                        }
                    ]
                },
                {
                    "id": "402092707",
                    "text": "我四处转转，不打扰了。",
                    "response": [
                        {
                            "id": "402092708",
                            "speaker": "志遥",
                            "text": "嗯嗯，请注意，不建议拆卸各种部件，还有，千万不要因为好奇，敲击弹药等危险品！"
                        }
                    ]
                }
            ]
        }
    ]
}