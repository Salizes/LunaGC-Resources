{
    "talkId": "4008071",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "丽莎": 17
    },
    "dialogues": [
        {
            "id": "400807101",
            "speaker": "丽莎",
            "text": "呵呵，还是这样悠闲的日子更适合我啊…",
            "choices": [
                {
                    "id": "400807102",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400807105",
                            "speaker": "丽莎",
                            "text": "好呀，小可爱。哎呀，可惜手边没有茶水招待你。",
                            "choices": [
                                {
                                    "id": "400807106",
                                    "text": "关于法尔伽…",
                                    "response": [
                                        {
                                            "id": "400807107",
                                            "speaker": "丽莎",
                                            "text": "知道大团长专门给我写了留言的时候，我也挺意外的。"
                                        },
                                        {
                                            "id": "400807108",
                                            "speaker": "丽莎",
                                            "text": "没想到他在外奔波那么久，心里还一直念着雷泽。"
                                        },
                                        {
                                            "id": "400807109",
                                            "speaker": "丽莎",
                                            "text": "明明他对琴就很严格呢…佳酿节的大小事务都留给了琴去伤脑筋，连句慰劳的话都没有。"
                                        },
                                        {
                                            "id": "400807110",
                                            "speaker": "丽莎",
                                            "text": "等他回来，我可得好好为琴出口气啊。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807111",
                                    "text": "关于雷泽…",
                                    "response": [
                                        {
                                            "id": "400807112",
                                            "speaker": "丽莎",
                                            "text": "说起来，「雷泽」这个名字，我一直以为是大团长为他取的…"
                                        },
                                        {
                                            "id": "400807113",
                                            "speaker": "丽莎",
                                            "text": "原来是他亲生父母早就想好的啊。"
                                        },
                                        {
                                            "id": "400807114",
                                            "speaker": "丽莎",
                                            "text": "……"
                                        },
                                        {
                                            "id": "400807115",
                                            "speaker": "丽莎",
                                            "text": "嗯，没错，雷泽和我说了，他听到了父母的声音。"
                                        },
                                        {
                                            "id": "400807116",
                                            "speaker": "丽莎",
                                            "text": "「像蹭到了被太阳照着的石头一样，又暖又重。」"
                                        },
                                        {
                                            "id": "400807117",
                                            "speaker": "丽莎",
                                            "text": "在他心中，他们一定是亲切而又厉害的人吧…"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807118",
                                    "text": "关于「佳酿节」…",
                                    "response": [
                                        {
                                            "id": "400807119",
                                            "speaker": "丽莎",
                                            "text": "本来想犒赏自己，只是小酌一杯的。"
                                        },
                                        {
                                            "id": "400807120",
                                            "speaker": "丽莎",
                                            "text": "但佳酿节限供的葡萄酒，风味确实独特…"
                                        },
                                        {
                                            "id": "400807121",
                                            "speaker": "丽莎",
                                            "text": "等我回过神来的时候，发现自己都已经有些醉意了，呵呵…"
                                        },
                                        {
                                            "id": "400807122",
                                            "speaker": "丽莎",
                                            "text": "小可爱，不要学我哦。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807103",
                    "text": "先不打扰你了。",
                    "response": [
                        {
                            "id": "400807104",
                            "speaker": "丽莎",
                            "text": "嗯，累了就歇一会儿吧。看你总是那么忙碌，还挺心疼的。"
                        }
                    ]
                }
            ]
        }
    ]
}