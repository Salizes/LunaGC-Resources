    "dialogues": [
        {
            "id": "410010401",
            "speaker": "立本",
            "text": "上次我们说到哪里了？啊，对了。物以稀为贵。"
        },
        {
            "id": "410010402",
            "speaker": "立本",
            "text": "你可知道，因为近来蒙德龙灾，果物减产。因此蒙德的酒价全大陆飞涨？"
        },
        {
            "id": "410010403",
            "speaker": "派蒙",
            "text": "龙灾的事情是知道的。"
        },
        {
            "id": "410010404",
            "speaker": "立本",
            "text": "那聪明的你，能不能猜到我为什么把奇货商的老底掏出来换日用百货呢？"
        },
        {
            "id": "410010405",
            "speaker": "派蒙",
            "text": "因为世界马上要毁灭了！"
        },
        {
            "id": "410010406",
            "speaker": "立本",
            "text": "哈哈哈哈。"
        }
    ]
}