{
    "talkId": "7565808",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 4,
        "赫卡": 6
    },
    "dialogues": [
        {
            "id": "756580801",
            "speaker": "赫卡",
            "text": "准备好挑战巨大机关怪物了吗？",
            "choices": [
                {
                    "id": "756580802",
                    "text": "现在准备一下。"
                },
                {
                    "id": "756580803",
                    "text": "想随便聊聊…",
                    "response": [
                        {
                            "id": "756580804",
                            "speaker": "赫卡",
                            "text": "和它风格类似的遗迹我在挪德卡莱见过，嗯，在「霜月之子」们聚集的那座岛上…"
                        },
                        {
                            "id": "756580805",
                            "speaker": "赫卡",
                            "text": "不过那些家伙都死气沉沉的，像这样会动的还是第一次见。真有趣，好好记录下来告诉玫熙吧。"
                        },
                        {
                            "id": "756580806",
                            "speaker": "Player",
                            "text": "关于「霜月之子」…"
                        },
                        {
                            "id": "756580807",
                            "speaker": "赫卡",
                            "text": "该怎么说呢，那是一群奇怪的人。和住在那夏镇里的人不一样，他们大部分时候都待在野外还有森林里面。"
                        },
                        {
                            "id": "756580808",
                            "speaker": "赫卡",
                            "text": "据说他们崇拜着月亮的神明，挪德卡莱各处都能见到他们制作的雕像。剩下的我也不知道了，卡嘉让我少打听他们的事。"
                        },
                        {
                            "id": "756580809",
                            "speaker": "赫卡",
                            "text": "不过我见过他们使用魔法哦，你要是看到了一定会很惊讶的。"
                        }
                    ]
                },
                {
                    "id": "756580810",
                    "text": "稍等。"
                }
            ]
        }
    ]
}