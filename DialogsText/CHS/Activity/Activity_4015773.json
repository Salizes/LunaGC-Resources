    "dialogues": [
        {
            "id": "401577301",
            "speaker": "Player",
            "text": "<color=#FFCC33FF>想邀请你去参加音乐庆典。</color>"
        },
        {
            "id": "401577302",
            "speaker": "芙萝拉",
            "text": "最近城里有音乐活动吗？可是芙萝拉只懂花，不懂音乐哦。"
        },
        {
            "id": "401577303",
            "speaker": "派蒙",
            "text": "是在稻妻的活动啦！不用懂音乐，只要有爱好就行了！你要是有喜欢的音乐，我们现在就可以弹给你听呢。"
        },
        {
            "id": "401577304",
            "speaker": "芙萝拉",
            "text": "倒是有一首曲子，不记得名字了，但可以把旋律哼出来，可以吗？"
        },
        {
            "id": "401577305",
            "speaker": "Player",
            "text": "我来试试。"
        },
        {
            "id": "401577306",
            "speaker": "芙萝拉",
            "text": "好耶，呼呼。"
        }
    ]
}