{
    "talkId": "4016521",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "绮良良": 10
    },
    "dialogues": [
        {
            "id": "401652101",
            "speaker": "绮良良",
            "text": "你们好呀，又见面了！",
            "choices": [
                {
                    "id": "401652102",
                    "text": "你的衣服…",
                    "response": [
                        {
                            "id": "401652103",
                            "speaker": "绮良良",
                            "text": "嘿嘿，很神奇吧？希穆兰卡的衣服居然能穿到提瓦特来！我还挺喜欢这套衣服的质感呢！虽然送快递的时候不太方便…"
                        },
                        {
                            "id": "401652104",
                            "speaker": "绮良良",
                            "text": "不论是枫丹警备队还是璃月千岩军…大家看到穿成这样的人手上还抱着个包裹在跑，八成会把我拦下来盘问一番…"
                        },
                        {
                            "id": "401652105",
                            "speaker": "绮良良",
                            "text": "哎…看来工作的时候只能穿回平时的衣服了…"
                        }
                    ]
                },
                {
                    "id": "401652106",
                    "text": "这次冒险…",
                    "response": [
                        {
                            "id": "401652107",
                            "speaker": "绮良良",
                            "text": "简直是太——美妙了！魔法的世界到处都是新奇的东西，风景又好，人也友善…哦对了，我在那之后还回过一趟赐福森林。"
                        },
                        {
                            "id": "401652108",
                            "speaker": "绮良良",
                            "text": "杏仁长老将我介绍给了森林的大家，说我绝对不会乱挠东西。我在森林的时候也乖乖收起了爪子，露都不敢露出来一下呢。"
                        },
                        {
                            "id": "401652109",
                            "speaker": "绮良良",
                            "text": "嘿嘿，经历了这么棒的冒险，简直都能换我给奶奶讲故事了。"
                        }
                    ]
                },
                {
                    "id": "401652110",
                    "text": "以后的打算…",
                    "response": [
                        {
                            "id": "401652111",
                            "speaker": "绮良良",
                            "text": "自从希穆兰卡迎来和平之后，好多人都说想要出来看看呢。但他们又有些担心在外面的安全。"
                        },
                        {
                            "id": "401652112",
                            "speaker": "绮良良",
                            "text": "我可以给他们当当向导，用快递箱带着大家在提瓦特到处走走。想去见识新鲜事物的心情，我可是最能理解了！"
                        }
                    ]
                },
                {
                    "id": "401652113",
                    "text": "改天再聊。",
                    "response": [
                        {
                            "id": "401652114",
                            "speaker": "绮良良",
                            "text": "嗯！每次和你们在一起的冒险都很开心呢！"
                        }
                    ]
                }
            ]
        }
    ]
}