{
    "talkId": "7567102",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 12,
        "拜希麦·五世": 25
    },
    "dialogues": [
        {
            "id": "756710201",
            "speaker": "拜希麦·五世",
            "text": "嗯哼哼~怎么样？体验过新版的「哐哐当当雀雀球」了吗？可爱团雀家族的新成员，朱羽古团雀~是不是很厉害？",
            "choices": [
                {
                    "id": "756710202",
                    "text": "来玩一局「雀雀球」！",
                    "response": [
                        {
                            "id": "756710203",
                            "speaker": "拜希麦·五世",
                            "text": "看来你也和我一样，喜欢看朱羽古团雀蹦蹦弹弹的模样！"
                        }
                    ]
                },
                {
                    "id": "756710204",
                    "text": "朱羽古团雀不怕疼吗？",
                    "response": [
                        {
                            "id": "756710205",
                            "speaker": "拜希麦·五世",
                            "text": "我刚开始也担心过哦！这次的弹球比以往更接近团雀本身，会不会让大家心疼？"
                        },
                        {
                            "id": "756710206",
                            "speaker": "拜希麦·五世",
                            "text": "我第一次来安饶之野时，犯了个错，身上没除掉的香辛料气味刺激到了一只棕鹿，让它生气地追打我…"
                        },
                        {
                            "id": "756710207",
                            "speaker": "拜希麦·五世",
                            "text": "结果，这只朱羽古团雀从路边跳了出来，撞了撞那只棕鹿，然后好像和它沟通了一番…"
                        },
                        {
                            "id": "756710208",
                            "speaker": "拜希麦·五世",
                            "text": "误会就这么解除了。",
                            "choices": [
                                {
                                    "id": "756710209",
                                    "text": "好强力的团雀！",
                                    "response": [
                                        {
                                            "id": "756710211",
                                            "speaker": "拜希麦·五世",
                                            "text": "嗯！我也非常意外，担心这位团雀受了伤，就试着和这位团雀交朋友，领着它去看了医生…"
                                        },
                                        {
                                            "id": "756710212",
                                            "speaker": "拜希麦·五世",
                                            "text": "检查结果是完全没事，它真是可爱又坚强！"
                                        },
                                        {
                                            "id": "756710213",
                                            "speaker": "拜希麦·五世",
                                            "text": "我不禁思考，我是不是犯了思维惯性的错误呢？"
                                        },
                                        {
                                            "id": "756710214",
                                            "speaker": "拜希麦·五世",
                                            "text": "下意识将「可爱」与「柔弱」紧密联系在一起，觉得可爱之物就需要无微不至的呵护，甚至将保护变成了限制…"
                                        },
                                        {
                                            "id": "756710215",
                                            "speaker": "拜希麦·五世",
                                            "text": "有着强大的力量，却性格温和，也可以是一种可爱嘛。",
                                            "choices": [
                                                {
                                                    "id": "756710216",
                                                    "text": "我懂我懂！",
                                                    "response": [
                                                        {
                                                            "id": "756710218",
                                                            "speaker": "拜希麦·五世",
                                                            "text": "嘿呀，我就知道你的思路和我合拍！"
                                                        },
                                                        {
                                                            "id": "756710219",
                                                            "speaker": "拜希麦·五世",
                                                            "text": "总而言之，朱羽古团雀启发我，找到了新的团雀可爱之道！"
                                                        },
                                                        {
                                                            "id": "756710220",
                                                            "speaker": "拜希麦·五世",
                                                            "text": "这次从挪德卡莱回到安饶之野后，我也第一时间和我的朱羽古团雀朋友会合啦！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756710217",
                                                    "text": "想起了很多例子！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756710210",
                                    "text": "好聪明的团雀！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756710221",
                    "text": "看起来，游戏开发得很顺利！",
                    "response": [
                        {
                            "id": "756710222",
                            "speaker": "拜希麦·五世",
                            "text": "是的！多亏之前在挪德卡莱得到了贵人相助，那位贵人给了我大量资金支持，新版本的雀雀球在很多效果上更灵动了！"
                        },
                        {
                            "id": "756710223",
                            "speaker": "拜希麦·五世",
                            "text": "那位贵人也只是要了几份新版雀雀球和适度改编的许可，甚至都不要求分红…真是太好心了！"
                        },
                        {
                            "id": "756710224",
                            "speaker": "拜希麦·五世",
                            "text": "不过，也有还没实现的目标。"
                        },
                        {
                            "id": "756710225",
                            "speaker": "拜希麦·五世",
                            "text": "原本施放「多多出击」的雀雀弹球，是要召唤两位小团雀伙伴来一起打击贼鸥…"
                        },
                        {
                            "id": "756710226",
                            "speaker": "拜希麦·五世",
                            "text": "负责加工弹球的工匠说她爆单了，完全忙不过来，请求延期两周。"
                        },
                        {
                            "id": "756710227",
                            "speaker": "拜希麦·五世",
                            "text": "我就暂时用一样的朱羽古团雀弹球来顶替，等到另一种小团雀完工后，再迭代版本啦。",
                            "choices": [
                                {
                                    "id": "756710228",
                                    "text": "看来是更丰富的表现效果？",
                                    "response": [
                                        {
                                            "id": "756710230",
                                            "speaker": "拜希麦·五世",
                                            "text": "两种都保留的意思是？",
                                            "choices": [
                                                {
                                                    "id": "756710231",
                                                    "text": "一种是不同团雀联手…",
                                                    "response": [
                                                        {
                                                            "id": "756710233",
                                                            "speaker": "拜希麦·五世",
                                                            "text": "好像也有道理…这样甚至能满足不同喜好的客人的需求，不愧是你！"
                                                        },
                                                        {
                                                            "id": "756710234",
                                                            "speaker": "拜希麦·五世",
                                                            "text": "如果以后，还有机会给你打工，还请允许我在不影响主要项目的情况下，向客人或工友们推荐我的雀雀球…"
                                                        },
                                                        {
                                                            "id": "756710235",
                                                            "speaker": "拜希麦·五世",
                                                            "text": "肯定能让大家的精神状态更加饱满，无比开心！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756710232",
                                                    "text": "一种是朱羽三联星合力？"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756710229",
                                    "text": "其实两个版本都可以保留？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756710236",
                    "text": "待会儿再来看团雀~",
                    "response": [
                        {
                            "id": "756710237",
                            "speaker": "拜希麦·五世",
                            "text": "好的呀~空闲下来了，就能彻底轻松地来玩游戏，更加快乐~"
                        }
                    ]
                }
            ]
        }
    ]
}