{
    "talkId": "4018939",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "「薄荷酱烤鱼王」": 4,
        "观察膨膨兽": 8
    },
    "dialogues": [
        {
            "id": "401893901",
            "speaker": "「薄荷酱烤鱼王」",
            "text": "嗷！",
            "choices": [
                {
                    "id": "401893902",
                    "text": "……",
                    "response": [
                        {
                            "id": "401893903",
                            "speaker": "观察膨膨兽",
                            "text": "（你开始认真思考，为什么自己选择雇佣一只膨膨兽来当员工…）"
                        },
                        {
                            "id": "401893904",
                            "speaker": "观察膨膨兽",
                            "text": "（是出于好奇心吗？还是想着「给娜维娅整点新花样」？）"
                        },
                        {
                            "id": "401893905",
                            "speaker": "观察膨膨兽",
                            "text": "（但…雇都雇了，这位膨膨兽员工也干得挺不错，好像没必要多想了？）"
                        },
                        {
                            "id": "401893906",
                            "speaker": "观察膨膨兽",
                            "text": "（甚至有不少游客被这位膨膨兽员工吸引，购买「悠悠慢庄园」的门票…）"
                        },
                        {
                            "id": "401893907",
                            "speaker": "观察膨膨兽",
                            "text": "（出于业绩考量，你甚至应该酌情给这位膨膨兽员工一些提成？）"
                        }
                    ]
                },
                {
                    "id": "401893908",
                    "text": "…嗷？",
                    "response": [
                        {
                            "id": "401893909",
                            "speaker": "「薄荷酱烤鱼王」",
                            "text": "！"
                        },
                        {
                            "id": "401893910",
                            "speaker": "「薄荷酱烤鱼王」",
                            "text": "嗷…呜呜嗷！嗷呜嗷嗷！呜嗷嗷，嗷嗷，呜嗷！"
                        },
                        {
                            "id": "401893911",
                            "speaker": "观察膨膨兽",
                            "text": "（你随口学膨膨兽叫了一声，似乎被对方误以为，你在用同族的语言和它交流，让这位膨膨兽员工异常兴奋…）"
                        },
                        {
                            "id": "401893912",
                            "speaker": "观察膨膨兽",
                            "text": "（不过，对于它热情的问候，你是半句都没听懂…）"
                        },
                        {
                            "id": "401893913",
                            "speaker": "观察膨膨兽",
                            "text": "（你开始严肃考虑，要不要寻找一位动物语言专家，稍稍学习和个别动物的交流方法…）"
                        }
                    ]
                },
                {
                    "id": "401893914",
                    "text": "好膨膨兽！下班奖励烤鱼！",
                    "response": [
                        {
                            "id": "401893915",
                            "speaker": "「薄荷酱烤鱼王」",
                            "text": "嗷嗷！"
                        }
                    ]
                }
            ]
        }
    ]
}