{
    "talkId": "7055409",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "伊莲": 7
    },
    "dialogues": [
        {
            "id": "705540901",
            "speaker": "伊莲",
            "text": "您好，我的前甲方…和您见面，我感到非常荣幸。",
            "choices": [
                {
                    "id": "705540902",
                    "text": "你怎么来了？",
                    "response": [
                        {
                            "id": "705540903",
                            "speaker": "伊莲",
                            "text": "啊，有个外包订单，让我到荆夫港帮忙维护一些精密器件…"
                        },
                        {
                            "id": "705540904",
                            "speaker": "伊莲",
                            "text": "我完成委托后，实在有些疲惫，就没有立刻动身回枫丹去。"
                        },
                        {
                            "id": "705540905",
                            "speaker": "伊莲",
                            "text": "能在蒙德城尝到您制作的饮品，我感觉，精力瞬间恢复了九成…再接三倍的订单都不会劳累！"
                        }
                    ]
                },
                {
                    "id": "705540906",
                    "text": "哪…哪位来着？",
                    "response": [
                        {
                            "id": "705540907",
                            "speaker": "伊莲",
                            "text": "只是一个不值一提的外包工程师…想不起来很正常。"
                        },
                        {
                            "id": "705540908",
                            "speaker": "伊莲",
                            "text": "等我再找到一份稳定的工作，说不定就有资格在您的记忆里留下一席之地了！"
                        }
                    ]
                },
                {
                    "id": "705540909",
                    "text": "你在此等等，我给你调杯喝的。",
                    "response": [
                        {
                            "id": "705540910",
                            "speaker": "伊莲",
                            "text": "好…实在感谢！"
                        }
                    ]
                }
            ]
        }
    ]
}