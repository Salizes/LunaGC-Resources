        {
            "id": "705340201",
            "speaker": "费恩",
            "text": "旅行者，您想体验一下「妙骰战法」吗？",
            "choices": [
                {
                    "id": "705340202",
                    "text": "想要试试。",
                    "response": [
                        {
                            "id": "705340203",
                            "speaker": "费恩",
                            "text": "没问题。呃…您看完那本规则书了吗？"
                        },
                        {
                            "id": "705340204",
                            "speaker": "费恩",
                            "text": "没事没事，看不看完都能玩，玩着玩着就熟悉了…"
                        }
                    ]
                },
                {
                    "id": "705340205",
                    "text": "还有别的事。",
                    "response": [
                        {
                            "id": "705340206",
                            "speaker": "费恩",
                            "text": "没空啊？行吧，等您想玩的时候，过来这边找我就行。反正只要「召唤王大奖赛」还没结束，我就不能收摊…"
                        }
                    ]
                }
            ]
        }
