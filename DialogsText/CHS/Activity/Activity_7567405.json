{
    "talkId": "7567405",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Player": 8,
        "妮露": 11,
        "派蒙": 7,
        "玛拉妮": 12
    },
    "dialogues": [
        {
            "id": "756740501",
            "speaker": "玛拉妮",
            "text": "妮露妮露，这次的点心是酸甜的莓果卷卷，参考了蒙德的苹果卷卷，不过加入了青蜜莓的果汁！"
        },
        {
            "id": "756740502",
            "speaker": "玛拉妮",
            "text": "我早就觉得，苹果的酸甜，和青蜜莓的甜酸能互补了，这次正好尝试一下。"
        },
        {
            "id": "756740503",
            "speaker": "玛拉妮",
            "text": "而且，还用到了挪德卡莱的酸奶油哦，口感应该很独特！"
        },
        {
            "id": "756740504",
            "speaker": "妮露",
            "text": "挪德卡莱？"
        },
        {
            "id": "756740505",
            "speaker": "妮露",
            "text": "多莉小姐之前提到过，挪德卡莱的很多食材既有至冬的风味，自身的特色又相当鲜明…"
        },
        {
            "id": "756740506",
            "speaker": "妮露",
            "text": "在多莉小姐的店里，上品酸奶油要十五万摩拉一罐呢。"
        },
        {
            "id": "756740507",
            "speaker": "玛拉妮",
            "text": "是芭芭拉带来的哦，她们家乡的骑士团引入了许多种挪德卡莱的食材，正好有些是我之前忘买的！"
        },
        {
            "id": "756740508",
            "speaker": "玛拉妮",
            "text": "不过，应该不至于那么贵吧？十五万摩拉一罐欸，能买多少水上用品了…",
            "choices": [
                {
                    "id": "756740509",
                    "text": "有好吃的？",
                    "response": [
                        {
                            "id": "756740511",
                            "speaker": "派蒙",
                            "text": "给我也掰点！"
                        },
                        {
                            "id": "756740512",
                            "speaker": "玛拉妮",
                            "text": "好呀好呀…咦！"
                        },
                        {
                            "id": "756740513",
                            "speaker": "妮露",
                            "text": "#{NICKNAME}和派蒙，什么时候来的？",
                            "choices": [
                                {
                                    "id": "756740514",
                                    "text": "从你们聊好吃的开始。",
                                    "response": [
                                        {
                                            "id": "756740516",
                                            "speaker": "派蒙",
                                            "text": "怎么感觉这是我的台词…算了，先让给你！"
                                        },
                                        {
                                            "id": "756740517",
                                            "speaker": "玛拉妮",
                                            "text": "那好呀，「亲卫队长」兼职甜点厨师，待会儿也给你来一盘新品！"
                                        },
                                        {
                                            "id": "756740518",
                                            "speaker": "派蒙",
                                            "text": "唔？「亲卫队长」？"
                                        },
                                        {
                                            "id": "756740519",
                                            "speaker": "派蒙",
                                            "text": "啊…想起来了，这个说法，是上次聚会时讨论的…",
                                            "choices": [
                                                {
                                                    "id": "756740520",
                                                    "text": "妮露是「邻家姐姐」。",
                                                    "response": [
                                                        {
                                                            "id": "756740522",
                                                            "speaker": "派蒙",
                                                            "text": "我也还记得！按玛拉妮的说法，妮露是「邻家姐姐魔法老师」。"
                                                        },
                                                        {
                                                            "id": "756740523",
                                                            "speaker": "派蒙",
                                                            "text": "会用温柔的方法，无形中给大家讲明白高深的道理！"
                                                        },
                                                        {
                                                            "id": "756740524",
                                                            "speaker": "妮露",
                                                            "text": "那这回，我要认真地扮演好这个角色…"
                                                        },
                                                        {
                                                            "id": "756740525",
                                                            "speaker": "妮露",
                                                            "text": "之前有一位叫瑟琪的客人，向我咨询了一些舞蹈音乐的问题，比如在听到新曲子的时候，怎么跟着跳。"
                                                        },
                                                        {
                                                            "id": "756740526",
                                                            "speaker": "妮露",
                                                            "text": "也就是音乐和舞蹈领域都有的「即兴」技巧。"
                                                        },
                                                        {
                                                            "id": "756740527",
                                                            "speaker": "妮露",
                                                            "text": "对我自己来说，这就像是一种本能，很快就能找到节拍和风格合适的舞步。"
                                                        },
                                                        {
                                                            "id": "756740528",
                                                            "speaker": "妮露",
                                                            "text": "但要教会…可能完全没有跳舞经验的朋友，我还是不知道如何下手。"
                                                        },
                                                        {
                                                            "id": "756740529",
                                                            "speaker": "玛拉妮",
                                                            "text": "不用太担心嘛，妮露，你想啊——"
                                                        },
                                                        {
                                                            "id": "756740530",
                                                            "speaker": "玛拉妮",
                                                            "text": "美露莘，说是水之国的精灵也没问题吧？"
                                                        },
                                                        {
                                                            "id": "756740531",
                                                            "speaker": "玛拉妮",
                                                            "text": "精灵，不都是很聪明的吗？"
                                                        },
                                                        {
                                                            "id": "756740532",
                                                            "speaker": "玛拉妮",
                                                            "text": "#我们的领舞{NICKNAME}已经来啦，瑟琪小姐和美露莘朋友们跟着{M#他}{F#她}的指引，肯定能找到很棒的节奏感。"
                                                        },
                                                        {
                                                            "id": "756740533",
                                                            "speaker": "玛拉妮",
                                                            "text": "要学其他跳舞的要领，也会顺顺利利！"
                                                        },
                                                        {
                                                            "id": "756740534",
                                                            "speaker": "妮露",
                                                            "text": "#的确哦…上次{NICKNAME} 就用精妙的引导，让小龙们卡准了很多复杂的节拍。"
                                                        },
                                                        {
                                                            "id": "756740535",
                                                            "speaker": "妮露",
                                                            "text": "我相信，美露莘们也能在你的指导下，了解舞蹈的诀窍。",
                                                            "choices": [
                                                                {
                                                                    "id": "756740536",
                                                                    "text": "那就看我的吧。",
                                                                    "response": [
                                                                        {
                                                                            "id": "756740538",
                                                                            "speaker": "派蒙",
                                                                            "text": "如果真的不难的话…我也想学学！"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "756740537",
                                                                    "text": "我来训练美露莘们！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756740521",
                                                    "text": "妮露是「魔法老师」。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756740515",
                                    "text": "从酸奶油的话题开始。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740510",
                    "text": "给我掰点？"
                }
            ]
        }
    ]
}