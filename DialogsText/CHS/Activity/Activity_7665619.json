        "茜涅特": 5
    },
    "dialogues": [
        {
            "id": "766561901",
            "speaker": "茜涅特",
            "text": "你们能帮我调试，非常感谢！",
            "choices": [
                {
                    "id": "766561903",
                    "text": "关于机器人。",
                    "response": [
                        {
                            "id": "766561904",
                            "speaker": "茜涅特",
                            "text": "我的机器人其实是用爱诺发明的显像机关改造的，利用月矩力这一点其实参考了她最近的作品，她真的是一个天才！"
                        },
                        {
                            "id": "766561905",
                            "speaker": "茜涅特",
                            "text": "但等到真的让我自己去实现这一点的时候，我才发现有多难…果然还是要向前辈虚心学习。"
                        }
                    ]
                },
                {
                    "id": "766561906",
                    "text": "关于故障。",
                    "response": [
                        {
                            "id": "766561907",
                            "speaker": "茜涅特",
                            "text": "说来惭愧，最初的故障都源自我的一些「创意」。我想实验一些新的东西，结果几乎都搞砸了。"
                        },
                        {
                            "id": "766561908",
                            "speaker": "茜涅特",
                            "text": "但是，如果有爱诺亲自制作的显像机关帮忙测试，这些「创意」却大多能顺利运行，真不知道这其中的原理是什么…"
                        }
                    ]
                }
            ]
        }
    ]
}