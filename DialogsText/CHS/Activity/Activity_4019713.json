{
    "talkId": "4019713",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 8,
        "派蒙": 4,
        "迪希雅": 16
    },
    "dialogues": [
        {
            "id": "401971301",
            "speaker": "迪希雅",
            "text": "#哟，{NICKNAME}和派蒙！"
        },
        {
            "id": "401971302",
            "speaker": "迪希雅",
            "text": "我们居然在这里见面了，真是奇妙的缘分啊！"
        },
        {
            "id": "401971303",
            "speaker": "派蒙",
            "text": "迪希雅？没想到会在这里遇到你！",
            "choices": [
                {
                    "id": "401971304",
                    "text": "是专程过来旅游的吗？",
                    "response": [
                        {
                            "id": "401971306",
                            "speaker": "迪希雅",
                            "text": "哈哈，这次过来，正事和休假对半开——"
                        },
                        {
                            "id": "401971307",
                            "speaker": "迪希雅",
                            "text": "不久前，我和「炽光猎兽」的几位队员受邀参演了一部枫丹的冒险映影。"
                        },
                        {
                            "id": "401971308",
                            "speaker": "迪希雅",
                            "text": "映影的成绩还挺漂亮，导演听说这个活动时，第一反应是邀请我们来当嘉宾。"
                        },
                        {
                            "id": "401971309",
                            "speaker": "迪希雅",
                            "text": "为了让观众们满意，导演特意还原了映影里的布景…"
                        },
                        {
                            "id": "401971310",
                            "speaker": "派蒙",
                            "text": "对枫丹人来说，确实是新鲜的异域风情？",
                            "choices": [
                                {
                                    "id": "401971311",
                                    "text": "迪希雅有出镜吗？",
                                    "response": [
                                        {
                                            "id": "401971313",
                                            "speaker": "迪希雅",
                                            "text": "我？啊哈哈…很遗憾，我因为假戏真打，不小心拆掉了半个摄影棚，被发了便当，去一边打杂了。"
                                        },
                                        {
                                            "id": "401971314",
                                            "speaker": "派蒙",
                                            "text": "怎么这样！打戏不应该越真实…越拳拳到肉，才越精彩嘛？"
                                        },
                                        {
                                            "id": "401971315",
                                            "speaker": "迪希雅",
                                            "text": "因为剧组不富裕，再重拍几次，摄影棚全塌了，就要破产了！"
                                        },
                                        {
                                            "id": "401971316",
                                            "speaker": "迪希雅",
                                            "text": "而且，就算剧组里拳脚功夫最强的演员——「弯刀大叔」，也没法和我认真过几招！",
                                            "choices": [
                                                {
                                                    "id": "401971317",
                                                    "text": "这位大叔的戏份如何…",
                                                    "response": [
                                                        {
                                                            "id": "401971319",
                                                            "speaker": "迪希雅",
                                                            "text": "那倒没有，他扮演了一个关键反派。在主角面前大耍刀舞，按照传统剧情，双方会打出非常精彩的动作戏…"
                                                        },
                                                        {
                                                            "id": "401971320",
                                                            "speaker": "迪希雅",
                                                            "text": "结果主演忙活一天，饿得不行，急着拍完这段，就临场发挥，掏出铳枪把他一下干掉了。"
                                                        },
                                                        {
                                                            "id": "401971321",
                                                            "speaker": "迪希雅",
                                                            "text": "导演再三思索，还是保留了这一段，没想到反响非常不错，「弯刀大叔」还因此成了小有名气的影星！",
                                                            "choices": [
                                                                {
                                                                    "id": "401971322",
                                                                    "text": "确实，好像在哪见过大叔…",
                                                                    "response": [
                                                                        {
                                                                            "id": "401971324",
                                                                            "speaker": "迪希雅",
                                                                            "text": "待会儿，「弯刀大叔」还要忙着给影迷签名，照理来说，我得帮忙打打下手。"
                                                                        },
                                                                        {
                                                                            "id": "401971325",
                                                                            "speaker": "迪希雅",
                                                                            "text": "但现在碰见了你们，不如，我和他们打个招呼，给我留个空，咱们出去转转，喝两杯？"
                                                                        },
                                                                        {
                                                                            "id": "401971326",
                                                                            "speaker": "派蒙",
                                                                            "text": "欸！没关系吗？"
                                                                        },
                                                                        {
                                                                            "id": "401971327",
                                                                            "speaker": "迪希雅",
                                                                            "text": "#哎，都是老熟人了，没那么多规矩！在异国和{NICKNAME}和派蒙相遇，才是今天最大的惊喜！"
                                                                        },
                                                                        {
                                                                            "id": "401971328",
                                                                            "speaker": "迪希雅",
                                                                            "text": "我听说，东南方向的海岸上，有个叫「锈舵」的酒吧，我们就在那里碰头吧！"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "401971323",
                                                                    "text": "我是不是也干过类似的事…"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "401971318",
                                                    "text": "有没有被你揍过…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401971312",
                                    "text": "想看有迪希雅的画面…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401971305",
                    "text": "是接到了什么委托？"
                }
            ]
        }
    ]
}