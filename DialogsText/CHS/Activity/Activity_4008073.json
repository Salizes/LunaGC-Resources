{
    "talkId": "4008073",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "雷泽": 19
    },
    "dialogues": [
        {
            "id": "400807301",
            "speaker": "雷泽",
            "text": "风，轻轻的，舒服…",
            "choices": [
                {
                    "id": "400807302",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400807305",
                            "speaker": "雷泽",
                            "text": "好。",
                            "choices": [
                                {
                                    "id": "400807306",
                                    "text": "关于法尔伽…",
                                    "response": [
                                        {
                                            "id": "400807307",
                                            "speaker": "雷泽",
                                            "text": "信，送来消息。想谢谢他。"
                                        },
                                        {
                                            "id": "400807308",
                                            "speaker": "雷泽",
                                            "text": "…我想他，卢皮卡也想他。"
                                        },
                                        {
                                            "id": "400807309",
                                            "speaker": "雷泽",
                                            "text": "我已经，大了。"
                                        },
                                        {
                                            "id": "400807310",
                                            "speaker": "雷泽",
                                            "text": "想听他说，人类的爸爸妈妈。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807311",
                                    "text": "关于父母…",
                                    "response": [
                                        {
                                            "id": "400807312",
                                            "speaker": "雷泽",
                                            "text": "我听到了，他们的声音。"
                                        },
                                        {
                                            "id": "400807313",
                                            "speaker": "雷泽",
                                            "text": "人类的爸爸妈妈…是冒险家…"
                                        },
                                        {
                                            "id": "400807314",
                                            "speaker": "雷泽",
                                            "text": "师父说，恐怕，没活下来…"
                                        },
                                        {
                                            "id": "400807315",
                                            "speaker": "Player",
                                            "text": "雷泽…"
                                        },
                                        {
                                            "id": "400807316",
                                            "speaker": "雷泽",
                                            "text": "我有一个木箱，里面是朋友送的，宝物。"
                                        },
                                        {
                                            "id": "400807317",
                                            "speaker": "雷泽",
                                            "text": "是我，最珍贵的东西。"
                                        },
                                        {
                                            "id": "400807318",
                                            "speaker": "雷泽",
                                            "text": "……"
                                        },
                                        {
                                            "id": "400807319",
                                            "speaker": "雷泽",
                                            "text": "人类爸爸妈妈的盒子里…都是我…"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807320",
                                    "text": "关于朋友…",
                                    "response": [
                                        {
                                            "id": "400807321",
                                            "speaker": "雷泽",
                                            "text": "很久以前，我以为，我一个人。只有卢皮卡。"
                                        },
                                        {
                                            "id": "400807322",
                                            "speaker": "雷泽",
                                            "text": "现在，好多人。"
                                        },
                                        {
                                            "id": "400807323",
                                            "speaker": "雷泽",
                                            "text": "大家都帮我，我也帮大家。"
                                        },
                                        {
                                            "id": "400807324",
                                            "speaker": "雷泽",
                                            "text": "人也可以，狼也可以。"
                                        },
                                        {
                                            "id": "400807325",
                                            "speaker": "雷泽",
                                            "text": "我是，城里和城外的，桥。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807303",
                    "text": "先不打扰你了。",
                    "response": [
                        {
                            "id": "400807304",
                            "speaker": "雷泽",
                            "text": "嗯，你也，吹风。"
                        }
                    ]
                }
            ]
        }
    ]
}