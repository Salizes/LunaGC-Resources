{
    "talkId": "7750121",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Player": 7,
        "莲塔": 31
    },
    "dialogues": [
        {
            "id": "775012101",
            "speaker": "莲塔",
            "text": "还是很糟心啊…比赛的表现也不太行，最近的倒霉程度就像锅里溢出来的抓饭…",
            "choices": [
                {
                    "id": "775012102",
                    "text": "碰见什么麻烦了？",
                    "response": [
                        {
                            "id": "775012103",
                            "speaker": "莲塔",
                            "text": "啊，正好来了位行家。"
                        },
                        {
                            "id": "775012104",
                            "speaker": "莲塔",
                            "text": "你觉得，我这发型如何？",
                            "choices": [
                                {
                                    "id": "775012105",
                                    "text": "中规中矩？",
                                    "response": [
                                        {
                                            "id": "775012106",
                                            "speaker": "莲塔",
                                            "text": "说得真委婉，你太有礼貌了。"
                                        },
                                        {
                                            "id": "775012109",
                                            "speaker": "莲塔",
                                            "text": "之前我路过枫丹，听奥菲利亚大力推荐，才去找她的发型师，做了个「时髦的款式」。"
                                        },
                                        {
                                            "id": "775012110",
                                            "speaker": "莲塔",
                                            "text": "在须弥，也只有阔绰的太太们才能找来行家，慢悠悠做出这个发型呢。"
                                        },
                                        {
                                            "id": "775012111",
                                            "speaker": "莲塔",
                                            "text": "后来我才发现，这发型和我这张脸，这身行头，全都不搭，真后悔…"
                                        },
                                        {
                                            "id": "775012112",
                                            "speaker": "莲塔",
                                            "text": "回须弥城以后，我得想办法折腾回原来的样子，不然会被艾维娜笑话的。",
                                            "choices": [
                                                {
                                                    "id": "775012113",
                                                    "text": "奥菲利亚？",
                                                    "response": [
                                                        {
                                                            "id": "775012114",
                                                            "speaker": "莲塔",
                                                            "text": "是个相当厉害的冒险家，整个枫丹分会的后勤物资都由她管理。"
                                                        },
                                                        {
                                                            "id": "775012115",
                                                            "speaker": "莲塔",
                                                            "text": "之前探索沙漠时，她和我之前所在的佣兵团起了误会，发生了冲突，打趴了我们七个人。"
                                                        },
                                                        {
                                                            "id": "775012116",
                                                            "speaker": "莲塔",
                                                            "text": "后来，在坎蒂丝大人的调停下，矛盾化解了。她居然补偿了我们一整年的水费，一整年啊…"
                                                        },
                                                        {
                                                            "id": "775012117",
                                                            "speaker": "莲塔",
                                                            "text": "那笔钱，我们佣兵团每年都要花三个月去赚呢，诚意有点超标了。"
                                                        },
                                                        {
                                                            "id": "775012118",
                                                            "speaker": "莲塔",
                                                            "text": "只可惜，听说她被一个失控的什么试验什么场力装置砸成重伤，痊愈后就只能退居二线了。"
                                                        },
                                                        {
                                                            "id": "775012119",
                                                            "speaker": "莲塔",
                                                            "text": "不然，她应该也会来参赛吧。"
                                                        },
                                                        {
                                                            "id": "775012127",
                                                            "speaker": "莲塔",
                                                            "text": "下次再有这种活动，带她来观赛也不错。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "775012120",
                                                    "text": "艾维娜？",
                                                    "response": [
                                                        {
                                                            "id": "775012121",
                                                            "speaker": "莲塔",
                                                            "text": "是我的雇主，需要保护的对象，一个天真烂漫的小姑娘。"
                                                        },
                                                        {
                                                            "id": "775012122",
                                                            "speaker": "莲塔",
                                                            "text": "当年，她以「一看就觉得投缘」为理由雇佣我当她的保镖，还说要推荐厉害的冒险家给我认识。"
                                                        },
                                                        {
                                                            "id": "775012123",
                                                            "speaker": "莲塔",
                                                            "text": "结果都是梦想远大，心地善良，但不知世事险恶的新人，其中一些的师父甚至是我的手下败将。"
                                                        },
                                                        {
                                                            "id": "775012124",
                                                            "speaker": "莲塔",
                                                            "text": "她给一整个团队出资，不计回报…慷慨得有点傻气。"
                                                        },
                                                        {
                                                            "id": "775012125",
                                                            "speaker": "莲塔",
                                                            "text": "所以我愿意一直给她拎包，我想看到这个团队成长起来…"
                                                        },
                                                        {
                                                            "id": "775012126",
                                                            "speaker": "莲塔",
                                                            "text": "前提是她别过早把自己的钱包掏空，花钱还是得注意基本的性价比…我得盯着她一点。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "775012107",
                                    "text": "不知为何，好像不适合你。",
                                    "response": [
                                        {
                                            "id": "775012108",
                                            "speaker": "莲塔",
                                            "text": "对吧？因为我以前不留这个发型。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775012128",
                    "text": "我有见过你吗？",
                    "response": [
                        {
                            "id": "775012129",
                            "speaker": "莲塔",
                            "text": "…应该吧？如果你去须弥城的冒险家协会交过委托，可能看见过我和我的雇主。"
                        },
                        {
                            "id": "775012130",
                            "speaker": "莲塔",
                            "text": "这些年来，我和我的雇主每次买完东西，都会在那边歇脚。"
                        },
                        {
                            "id": "775012131",
                            "speaker": "莲塔",
                            "text": "因为我总是帮雇主搞定一些…她自己都不清楚难度的委托。"
                        },
                        {
                            "id": "775012132",
                            "speaker": "莲塔",
                            "text": "卡玛尔分会长就给我也发了兼职冒险家的证明，倒也不错，可以多挣点摩拉。"
                        },
                        {
                            "id": "775012133",
                            "speaker": "莲塔",
                            "text": "如果不是因为分会长一时兴起，趁着假期去船上出海玩了，本来应该由他带须弥的队。"
                        },
                        {
                            "id": "775012134",
                            "speaker": "莲塔",
                            "text": "他倒也是心大，因为我帮过他四十几回，就把开会这种事也放心交给了我，这我怎么好辜负他嘛…"
                        },
                        {
                            "id": "775012135",
                            "speaker": "莲塔",
                            "text": "唔，偏题了…"
                        },
                        {
                            "id": "775012136",
                            "speaker": "莲塔",
                            "text": "话说回来，以后有机会，我们可以合作哦，我的雇主很阔绰的。"
                        }
                    ]
                },
                {
                    "id": "775012137",
                    "text": "那祝你今天开始好运。",
                    "response": [
                        {
                            "id": "775012138",
                            "speaker": "莲塔",
                            "text": "谢谢，你也是。"
                        }
                    ]
                }
            ]
        }
    ]
}