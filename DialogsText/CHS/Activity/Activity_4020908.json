{
    "talkId": "4020908",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "恩胡马": 3,
        "派蒙": 2,
        "雅珂达": 4
    },
    "dialogues": [
        {
            "id": "402090801",
            "speaker": "雅珂达",
            "text": "这个参展方的要求…"
        },
        {
            "id": "402090802",
            "speaker": "派蒙",
            "text": "怎么了？"
        },
        {
            "id": "402090803",
            "speaker": "雅珂达",
            "text": "这个参展方准备的货物似乎是某种来自纳塔的珍稀文物，因此他要求我们提供一种非常苛刻的存放环境。"
        },
        {
            "id": "402090804",
            "speaker": "雅珂达",
            "text": "虽说合同里确实要求我们为参展方的货物存储负责，但这个要求根本满足不了。"
        },
        {
            "id": "402090805",
            "speaker": "恩胡马",
            "text": "苛刻吗？那可是珍贵又脆弱的文物，你们想把它当成普通的杂物，随便堆放到仓库里？"
        },
        {
            "id": "402090806",
            "speaker": "Player",
            "text": "你是烟谜主部族的人？"
        },
        {
            "id": "402090807",
            "speaker": "恩胡马",
            "text": "杜麦尼！？"
        },
        {
            "id": "402090808",
            "speaker": "派蒙",
            "text": "对哦，这可是那位杜麦尼，你的要求具体是什么？"
        },
        {
            "id": "402090809",
            "speaker": "恩胡马",
            "text": "…看在您的面子上，我就姑且先用现在的仓库吧，您可千万不要把我的事说给黑曜石奶奶听啊。"
        },
        {
            "id": "402090810",
            "speaker": "Player",
            "text": "算你识相。"
        },
        {
            "id": "402090811",
            "speaker": "雅珂达",
            "text": "#（{NICKNAME}的这个名号怎么好像比奈姐的还有用…）"
        }
    ]
}