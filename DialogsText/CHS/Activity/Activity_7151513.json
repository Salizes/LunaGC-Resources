{
    "talkId": "7151513",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 3,
        "应公": 5
    },
    "dialogues": [
        {
            "id": "715151301",
            "speaker": "应公",
            "text": "放映已经结束咯，你怎么又折回来了？难道是还想再演一场？",
            "choices": [
                {
                    "id": "715151302",
                    "text": "想再看一次。",
                    "response": [
                        {
                            "id": "715151303",
                            "speaker": "应公",
                            "text": "哈哈，看来你是真喜欢啊，那就单独加映一场吧。"
                        }
                    ]
                },
                {
                    "id": "715151304",
                    "text": "关于云翰社…",
                    "response": [
                        {
                            "id": "715151305",
                            "speaker": "应公",
                            "text": "今年的海灯节倒确实没有特别的演出计划，连着好几年的海灯节都有演出，今年总算能好好休息了。"
                        },
                        {
                            "id": "715151306",
                            "speaker": "应公",
                            "text": "不过嘴上说着要休息，我最后还是闲不住，跑来给孩子们放纸映剧了哈哈。"
                        }
                    ]
                },
                {
                    "id": "715151307",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715151308",
                            "speaker": "应公",
                            "text": "那就再会了，下次有机会见面的话，再给你看看我做的行头。"
                        }
                    ]
                }
            ]
        }
    ]
}