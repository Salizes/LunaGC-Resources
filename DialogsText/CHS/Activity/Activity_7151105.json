{
    "talkId": "7151105",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "瑶瑶": 15
    },
    "dialogues": [
        {
            "id": "715110501",
            "speaker": "瑶瑶",
            "text": "真好真好，轻策庄的爷爷奶奶们也都很开心！",
            "choices": [
                {
                    "id": "715110502",
                    "text": "关于轻策庄…",
                    "response": [
                        {
                            "id": "715110503",
                            "speaker": "瑶瑶",
                            "text": "是问瑶瑶在这里做什么吗？我刚刚在给大家表演节目喔！"
                        },
                        {
                            "id": "715110504",
                            "speaker": "瑶瑶",
                            "text": "我不像师父能弹出那么优美的琴声，但唱唱歌，我还是会的啦。"
                        },
                        {
                            "id": "715110505",
                            "speaker": "瑶瑶",
                            "text": "若心奶奶都夸了我，还送了我好吃的糖果，嘿嘿。"
                        }
                    ]
                },
                {
                    "id": "715110506",
                    "text": "关于师父…",
                    "response": [
                        {
                            "id": "715110507",
                            "speaker": "瑶瑶",
                            "text": "师父从前和我讲过好多仙家往事！"
                        },
                        {
                            "id": "715110508",
                            "speaker": "瑶瑶",
                            "text": "有着大大鹿角的移霄叔叔，喜欢收集珍宝的鸣海叔叔…"
                        },
                        {
                            "id": "715110509",
                            "speaker": "瑶瑶",
                            "text": "师父讲啊讲啊，有时声音会变得有些悲伤。但她总在最后笑着告诉我，大家都爱着璃月…"
                        },
                        {
                            "id": "715110510",
                            "speaker": "瑶瑶",
                            "text": "我也爱璃月喔！"
                        },
                        {
                            "id": "715110511",
                            "speaker": "瑶瑶",
                            "text": "所以，我会替那些仙人叔叔阿姨，好好照顾璃月的大家！"
                        }
                    ]
                },
                {
                    "id": "715110512",
                    "text": "关于德沃沙克…",
                    "response": [
                        {
                            "id": "715110513",
                            "speaker": "瑶瑶",
                            "text": "德沃沙克叔叔找到了故事里的仙女，故事里的仙女就是师父…这两件事情，都很让我高兴。"
                        },
                        {
                            "id": "715110514",
                            "speaker": "瑶瑶",
                            "text": "而且，我这次也帮上了忙对吧，也算是…「不辱师门」？"
                        },
                        {
                            "id": "715110515",
                            "speaker": "瑶瑶",
                            "text": "对了对了，叔叔他还托朋友，给我带了个枫丹来的小玩具，我可喜欢了！"
                        },
                        {
                            "id": "715110516",
                            "speaker": "瑶瑶",
                            "text": "我…我一开始没想着要收！是师父说可以拿，我才拿着的…"
                        }
                    ]
                },
                {
                    "id": "715110517",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715110518",
                            "speaker": "瑶瑶",
                            "text": "再见啦再见啦，要好好照顾派蒙喔！"
                        },
                        {
                            "id": "715110519",
                            "speaker": "瑶瑶",
                            "text": "有机会的话，以后也来找瑶瑶玩吧！"
                        }
                    ]
                }
            ]
        }
    ]
}