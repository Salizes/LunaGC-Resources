{
    "talkId": "7352702",
    "total_dialogue_lines": 66,
    "speaker_counts": {
        "Player": 15,
        "沙蒂永": 38,
        "派蒙": 13
    },
    "dialogues": [
        {
            "id": "735270201",
            "speaker": "沙蒂永",
            "text": "两位顾客，现在就玩玩「飞迸湍流大作战」吗？",
            "choices": [
                {
                    "id": "735270202",
                    "text": "立即游玩「飞迸湍流大作战」！",
                    "response": [
                        {
                            "id": "735270203",
                            "speaker": "沙蒂永",
                            "text": "没问题！请尽情享受这个新奇的游乐项目吧！"
                        }
                    ]
                },
                {
                    "id": "735270204",
                    "text": "这个游戏还挺有感觉！",
                    "response": [
                        {
                            "id": "735270205",
                            "speaker": "派蒙",
                            "text": "没错！我们可以把自己想象成…战舰上的炮手！用大炮去轰击各种海上的目标…"
                        },
                        {
                            "id": "735270206",
                            "speaker": "派蒙",
                            "text": "不过，这么说来，战舰上的炮手难道也要在很短的时间内瞄准…上上下下好多目标吗？那还真是辛苦呢！"
                        },
                        {
                            "id": "735270207",
                            "speaker": "沙蒂永",
                            "text": "正是如此，你们理解了这台装置最初的设计目的！"
                        },
                        {
                            "id": "735270208",
                            "speaker": "沙蒂永",
                            "text": "炮弹飞出去的轨迹不是一条直线，打击远处的目标时，炮手们也需要抬高炮口…"
                        },
                        {
                            "id": "735270209",
                            "speaker": "沙蒂永",
                            "text": "而且船舶在海上航行的时候，会随着波浪不停摇晃，炮手也要适应船舶摇晃的节奏，上下调整大炮的角度。"
                        },
                        {
                            "id": "735270210",
                            "speaker": "沙蒂永",
                            "text": "综合以上原因，炮手需要好好锻炼垂直空间上的瞄准能力，才能应对各种作战需求。"
                        },
                        {
                            "id": "735270211",
                            "speaker": "沙蒂永",
                            "text": "当然，打击高速目标时所需要的提前量，也是必修科目。炮弹飞行的速度越慢，对炮手的预估能力要求越高。"
                        },
                        {
                            "id": "735270212",
                            "speaker": "沙蒂永",
                            "text": "所以我才开发出了「鳄型涡流聚引原理鳄式外甲海战用重型舰炮式训练水球发射炮」，它的射弹速度和每发弹药的成本都很低。"
                        },
                        {
                            "id": "735270213",
                            "speaker": "沙蒂永",
                            "text": "将这种水炮布置在不停摇晃的浮动平台上，配合气球靶标，就能更好地训练炮手的能力，强化整支舰队的作战能力。",
                            "choices": [
                                {
                                    "id": "735270214",
                                    "text": "训练？",
                                    "response": [
                                        {
                                            "id": "735270216",
                                            "speaker": "派蒙",
                                            "text": "原来这个游乐项目是用来训练炮手的吗！总感觉空气里突然多了一点…火药味！"
                                        },
                                        {
                                            "id": "735270217",
                                            "speaker": "派蒙",
                                            "text": "伊迪娅要是知道了「琉形蜃境」里有这么一个…军事用途的项目!会不会觉得很不安？"
                                        },
                                        {
                                            "id": "735270218",
                                            "speaker": "沙蒂永",
                                            "text": "放心吧！伊迪娅女士对我的底细一清二楚，我也没打算让「琉形蜃境」变成和战场有关的地方。"
                                        },
                                        {
                                            "id": "735270219",
                                            "speaker": "沙蒂永",
                                            "text": "请注意，我的用词是「最初」。现在鳄鳄炮炮的后缀也变成了「娱乐」而非「训练」。"
                                        },
                                        {
                                            "id": "735270220",
                                            "speaker": "沙蒂永",
                                            "text": "据我所知…枫丹舰队…已经不再需要我这种人了。或者说，枫丹已经没有，也不打算再重建以前那样的舰队了。"
                                        },
                                        {
                                            "id": "735270221",
                                            "speaker": "沙蒂永",
                                            "text": "我的发明也没有其他用处，干脆当成消遣的玩物好了。这样至少还能为大家带来愉快的心情。",
                                            "choices": [
                                                {
                                                    "id": "735270222",
                                                    "text": "还好还好…",
                                                    "response": [
                                                        {
                                                            "id": "735270224",
                                                            "speaker": "派蒙",
                                                            "text": "感觉…沙蒂永先生的语气突然变得沮丧了…那个什么枫丹舰队，好像让你想起了不开心的事…"
                                                        },
                                                        {
                                                            "id": "735270225",
                                                            "speaker": "沙蒂永",
                                                            "text": "啊哈，那倒不至于！千万不能影响你们的好心情！"
                                                        },
                                                        {
                                                            "id": "735270226",
                                                            "speaker": "沙蒂永",
                                                            "text": "伊迪娅女士给我的这份工作很珍贵，让我有了继续发挥自己的能力的机会，你们玩得开心，我就心满意足了！"
                                                        },
                                                        {
                                                            "id": "735270227",
                                                            "speaker": "沙蒂永",
                                                            "text": "之前谈的工作…都是往事了！请你们不要放在心上，继续操纵鳄鳄炮炮，尽情玩耍吧！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "735270223",
                                                    "text": "能放心了…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "735270215",
                                    "text": "作战？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735270228",
                    "text": "我可能会多玩几回…",
                    "response": [
                        {
                            "id": "735270229",
                            "speaker": "沙蒂永",
                            "text": "太好了，看来你们已经被这个游乐项目吸引了！"
                        },
                        {
                            "id": "735270230",
                            "speaker": "沙蒂永",
                            "text": "因为设计这个项目的原则是开心就好，所以目前没有特别困难的关卡…"
                        },
                        {
                            "id": "735270231",
                            "speaker": "沙蒂永",
                            "text": "假如你们玩得非常熟练，慢慢感觉这个项目的挑战性不够了，也请别心急，我会争取尽早做出新的关卡！"
                        }
                    ]
                },
                {
                    "id": "735270232",
                    "text": "要不聊聊你自己的事？",
                    "response": [
                        {
                            "id": "735270233",
                            "speaker": "派蒙",
                            "text": "对哦，我开始好奇沙蒂永先生以前的经历了…为什么会想到用水炮来做娱乐项目呢？"
                        },
                        {
                            "id": "735270234",
                            "speaker": "沙蒂永",
                            "text": "哦！原因很简单啊，因为我以前的工作和大炮有关！"
                        },
                        {
                            "id": "735270235",
                            "speaker": "沙蒂永",
                            "text": "很久以前，我曾在枫丹的舰队担任武器工程师，我的妻子和女儿都是出色的炮手，在舰队的主力战舰上服役…"
                        },
                        {
                            "id": "735270236",
                            "speaker": "沙蒂永",
                            "text": "可以说，我们一家子都对大炮很熟悉！"
                        },
                        {
                            "id": "735270237",
                            "speaker": "沙蒂永",
                            "text": "我的妻子和女儿经常向我反馈一线水手的意见，托她们的福，我成为了比较出色的工程师，参与了一些厉害的项目。"
                        },
                        {
                            "id": "735270238",
                            "speaker": "沙蒂永",
                            "text": "为了试验新的武器装备，我经常出差。正好，沙漠里有很多空旷的地方，很适合测试大炮和炸弹，所以我成了沙漠的常客。"
                        },
                        {
                            "id": "735270239",
                            "speaker": "沙蒂永",
                            "text": "只不过，在一次实验中，我们没有把炮弹和引信分离存放，导致了严重的殉爆事故…"
                        },
                        {
                            "id": "735270240",
                            "speaker": "沙蒂永",
                            "text": "我们的团队伤亡惨重，我走了大运才没有当场死掉，但也被炸飞到了很远以外，在一个陌生的地方昏迷了好几天！"
                        },
                        {
                            "id": "735270241",
                            "speaker": "派蒙",
                            "text": "这！这也太恐怖了！",
                            "choices": [
                                {
                                    "id": "735270242",
                                    "text": "为你的不幸遭遇难过…",
                                    "response": [
                                        {
                                            "id": "735270244",
                                            "speaker": "沙蒂永",
                                            "text": "对吧！所以以后如果你们也要使用火药相关的道具，一定要注意安全！"
                                        },
                                        {
                                            "id": "735270245",
                                            "speaker": "沙蒂永",
                                            "text": "在那之后，我拖着重伤的身子，好不容易找到了一些同伴，但我们在沙漠中迷失了方向，只能原地等待救援。"
                                        },
                                        {
                                            "id": "735270246",
                                            "speaker": "沙蒂永",
                                            "text": "就这样，我们被迫在沙漠中生活，不知道过了多久，救援都没有来。补给用光后，我们的生活也变得异常辛苦…"
                                        },
                                        {
                                            "id": "735270247",
                                            "speaker": "沙蒂永",
                                            "text": "还好我们遇见了伊迪娅女士！伊迪娅女士邀请我们来到了她的新家，也就是这个「琉形蜃境」，这里的生活条件好多了。"
                                        },
                                        {
                                            "id": "735270248",
                                            "speaker": "沙蒂永",
                                            "text": "伊迪娅小姐告诉了我们一些枫丹的消息，有的人非常着急，马上在她的支援下返回了枫丹，有的人则觉得回去也没什么意义了…"
                                        },
                                        {
                                            "id": "735270249",
                                            "speaker": "沙蒂永",
                                            "text": "我也消沉了一段时间…不过，为了报答伊迪娅小姐的救命之恩，我还是决定先用自己的力量，帮助她将这个乐园建设得更有趣！"
                                        },
                                        {
                                            "id": "735270250",
                                            "speaker": "沙蒂永",
                                            "text": "又是不知道多久过去了，我开始怀念自己的老本行，于是制作了这种鳄鳄炮炮，开始搭建一个新的游乐项目…"
                                        },
                                        {
                                            "id": "735270251",
                                            "speaker": "派蒙",
                                            "text": "也就是说，沙蒂永先生很早就来到了「琉形蜃境」吗？"
                                        },
                                        {
                                            "id": "735270252",
                                            "speaker": "派蒙",
                                            "text": "那为什么，你没有回去和你的妻子女儿团聚呢？伊迪娅小姐告诉了你们什么…",
                                            "choices": [
                                                {
                                                    "id": "735270253",
                                                    "text": "我的直觉提醒我…",
                                                    "response": [
                                                        {
                                                            "id": "735270255",
                                                            "speaker": "派蒙",
                                                            "text": "咦？啊！沙蒂永先生的眼神好像…变得有点黯淡了？"
                                                        },
                                                        {
                                                            "id": "735270256",
                                                            "speaker": "派蒙",
                                                            "text": "唔…虽然不知道发生了什么，但沙蒂永先生发明了很有意思的鳄鳄炮炮，带给了我们快乐，也一定会给其他游客带来笑容…"
                                                        },
                                                        {
                                                            "id": "735270257",
                                                            "speaker": "派蒙",
                                                            "text": "既然如此，沙蒂永先生也要开心一点，忘掉所有难过的事！"
                                                        },
                                                        {
                                                            "id": "735270258",
                                                            "speaker": "沙蒂永",
                                                            "text": "…说得很对！我要振作起来，要快乐一点，才对得起所有人！"
                                                        },
                                                        {
                                                            "id": "735270259",
                                                            "speaker": "沙蒂永",
                                                            "text": "每次看见鳄鳄炮炮运作，我都能想起女儿喜欢的那个鳄鱼玩偶…还有她长大后，和她母亲一起操作重炮时的飒爽身姿…"
                                                        },
                                                        {
                                                            "id": "735270260",
                                                            "speaker": "沙蒂永",
                                                            "text": "谢谢！很高兴你们来玩我的项目，还高度认可了鳄鳄炮炮！"
                                                        },
                                                        {
                                                            "id": "735270261",
                                                            "speaker": "沙蒂永",
                                                            "text": "我一定会让这个项目变得更有趣的！如果能将它推广开来，就会有更多人玩着鳄鳄炮炮，忘掉以前的忧愁！",
                                                            "choices": [
                                                                {
                                                                    "id": "735270262",
                                                                    "text": "虽然不了解详情…",
                                                                    "response": [
                                                                        {
                                                                            "id": "735270264",
                                                                            "speaker": "派蒙",
                                                                            "text": "加油哦，沙蒂永先生，你一定能成功的！"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "735270263",
                                                                    "text": "但祝你一切顺利！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "735270254",
                                                    "text": "我们不该追问了…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "735270243",
                                    "text": "还好你本人活了下来…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735270265",
                    "text": "下次再聊，回见！",
                    "response": [
                        {
                            "id": "735270266",
                            "speaker": "沙蒂永",
                            "text": "嗯，看来你们很忙，可以理解！我随时在这里等着你们！"
                        }
                    ]
                }
            ]
        }
    ]
}