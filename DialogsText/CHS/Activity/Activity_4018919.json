{
    "talkId": "4018919",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "爱可菲": 6
    },
    "dialogues": [
        {
            "id": "401891901",
            "speaker": "爱可菲",
            "text": "嗯…独特的香气萦绕着你。这次，你会为我的烹饪点亮怎样的灵感？",
            "choices": [
                {
                    "id": "401891902",
                    "text": "查看「主题料理」。",
                    "response": [
                        {
                            "id": "401891903",
                            "speaker": "爱可菲",
                            "text": "那我就自由发挥了，希望能给这座乐园带来不同的「味觉体验」。"
                        }
                    ]
                },
                {
                    "id": "401891904",
                    "text": "工作的感觉如何？",
                    "response": [
                        {
                            "id": "401891905",
                            "speaker": "爱可菲",
                            "text": "让我想想…在「海薇玛映影欢乐城」主题餐厅下厨的体验，与「灰河」的亲民餐馆有不少共通之处——"
                        },
                        {
                            "id": "401891906",
                            "speaker": "爱可菲",
                            "text": "直面食客，看着他们吃下料理后惊喜的表情，这种欣慰，待在大饭店的封闭后厨时，不太容易感知。"
                        },
                        {
                            "id": "401891907",
                            "speaker": "爱可菲",
                            "text": "下次还有类似的活动的话，依然可以叫上我。凭我们的关系，不用考虑什么出场费，一摩拉都不用付。"
                        }
                    ]
                },
                {
                    "id": "401891908",
                    "text": "辛苦了，爱可菲。",
                    "response": [
                        {
                            "id": "401891909",
                            "speaker": "爱可菲",
                            "text": "不在话下。倒是你，注意别太累着自己哦。"
                        }
                    ]
                }
            ]
        }
    ]
}