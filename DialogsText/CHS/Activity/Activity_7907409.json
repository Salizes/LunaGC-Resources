{
    "talkId": "7907409",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "克朗谢": 6
    },
    "dialogues": [
        {
            "id": "790740901",
            "speaker": "Player",
            "text": "（继续听下去。）"
        },
        {
            "id": "790740902",
            "speaker": "克朗谢",
            "text": "而是瞅准自己真正的目标——帮植物传递种子，帮树木卸下重担，传递雨水，提示人们加减衣物——为此而努力。"
        },
        {
            "id": "790740903",
            "speaker": "克朗谢",
            "text": "能如此完成工作的北风，才能被称之为勇敢。",
            "choices": [
                {
                    "id": "790740904",
                    "text": "这故事和你之前说的话有关系吗？",
                    "response": [
                        {
                            "id": "790740906",
                            "speaker": "克朗谢",
                            "text": "绝不是！现在王国里的飞鼠正是因为畏惧「错误」而不敢飞行！"
                        },
                        {
                            "id": "790740907",
                            "speaker": "克朗谢",
                            "text": "害怕丢脸，害怕做错动作，害怕失手撞在某处…就像那个因为害怕犯错而不敢吹拂的北风一样。"
                        },
                        {
                            "id": "790740908",
                            "speaker": "克朗谢",
                            "text": "可笑！他们唯一应该担心的，是自己无法掌握飞行技巧！"
                        },
                        {
                            "id": "790740909",
                            "speaker": "克朗谢",
                            "text": "唉，真该让他们重读这篇《勇敢的北风》…不然我等会就去印一些，发给大家好了。"
                        }
                    ]
                },
                {
                    "id": "790740905",
                    "text": "完全是两种「勇气」嘛。"
                }
            ]
        }
    ]
}