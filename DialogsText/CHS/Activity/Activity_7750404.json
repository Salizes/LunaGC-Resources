{
    "talkId": "7750404",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 5,
        "「小松果」": 11,
        "「燃爆木头人」": 13
    },
    "dialogues": [
        {
            "id": "775040401",
            "speaker": "「燃爆木头人」",
            "text": "杜杜杜杜杜杜杜杜麦尼！您是不是有什么秘密任务？不方便透露身份？"
        },
        {
            "id": "775040402",
            "speaker": "「小松果」",
            "text": "需要我们做什么吗？虽然我们本领不强，但您交待的任务，我们一定全力以赴！",
            "choices": [
                {
                    "id": "775040403",
                    "text": "任务是让大家一起变强。",
                    "response": [
                        {
                            "id": "775040404",
                            "speaker": "「燃爆木头人」",
                            "text": "那那那，我们已经开始锻炼了，不会让您失望的！"
                        },
                        {
                            "id": "775040405",
                            "speaker": "「小松果」",
                            "text": "琪琪科娃姐姐让我们用留影机观察各种小动物，我们就去找猎人学习，不惊动它们…"
                        },
                        {
                            "id": "775040406",
                            "speaker": "「小松果」",
                            "text": "这种本领，就是一些烟谜主勇士精通的「潜伏」吧？也可以用在竞技比赛里！"
                        },
                        {
                            "id": "775040407",
                            "speaker": "「燃爆木头人」",
                            "text": "还有还有，对着手册到处转悠，路上都会碰到厚厚的积雪，还有厉害的风雪…"
                        },
                        {
                            "id": "775040408",
                            "speaker": "「燃爆木头人」",
                            "text": "我们也要适应冷冷的环境，学会使用更多新鲜的冰雕！"
                        }
                    ]
                },
                {
                    "id": "775040409",
                    "text": "先说说你们的情况？",
                    "response": [
                        {
                            "id": "775040410",
                            "speaker": "「燃爆木头人」",
                            "text": "啊，我们…我们是来远游锻炼的。"
                        },
                        {
                            "id": "775040411",
                            "speaker": "「燃爆木头人」",
                            "text": "「小松果」的爸爸，也就是「塞提阿德的砂刃」阿姆鲁叔叔，教了我们很多战斗的本领。"
                        },
                        {
                            "id": "775040412",
                            "speaker": "「小松果」",
                            "text": "但是因为常年在纳塔待着，不了解其他地方的战士，也不太像话。"
                        },
                        {
                            "id": "775040413",
                            "speaker": "「小松果」",
                            "text": "所以，爸爸就给了我们一大笔旅费，让我们来至冬好好锻炼一番。",
                            "choices": [
                                {
                                    "id": "775040414",
                                    "text": "放你们两个小孩到国外玩吗…",
                                    "response": [
                                        {
                                            "id": "775040416",
                                            "speaker": "「燃爆木头人」",
                                            "text": "我，我们都不小了哦，我已经十二岁了，「小松果」也十岁了！"
                                        },
                                        {
                                            "id": "775040417",
                                            "speaker": "「燃爆木头人」",
                                            "text": "「沃陆之邦」的瓦雷莎姐姐在我们这么大的时候，好像都已经打败过几百只魔物了。"
                                        },
                                        {
                                            "id": "775040418",
                                            "speaker": "「燃爆木头人」",
                                            "text": "再过几年，我们也该像基尼奇哥哥和阿乔领主那样，成为部族的正式战士。"
                                        },
                                        {
                                            "id": "775040419",
                                            "speaker": "「燃爆木头人」",
                                            "text": "这回只是出国锻炼一下，跟着琪琪科娃姐姐，找了几只大白熊练了练拳击和摔跤而已。"
                                        },
                                        {
                                            "id": "775040420",
                                            "speaker": "「燃爆木头人」",
                                            "text": "完全没有招惹厉害的家伙，不会有事的！"
                                        },
                                        {
                                            "id": "775040421",
                                            "speaker": "「小松果」",
                                            "text": "爸爸说过，老是待在安逸的环境里，人会变呆变慢。"
                                        },
                                        {
                                            "id": "775040422",
                                            "speaker": "「小松果」",
                                            "text": "大喜儿姐姐也说，璃月人都抱着一种，怎么说的来着…那种心态，在努力锻炼。"
                                        },
                                        {
                                            "id": "775040423",
                                            "speaker": "「燃爆木头人」",
                                            "text": "…居安思危？"
                                        },
                                        {
                                            "id": "775040424",
                                            "speaker": "「小松果」",
                                            "text": "对的对的，居安思危！"
                                        },
                                        {
                                            "id": "775040425",
                                            "speaker": "「小松果」",
                                            "text": "随时做好坏家伙还会冒出来的准备，全力锻炼，碰见不妙的情况，就不会慌张。"
                                        },
                                        {
                                            "id": "775040426",
                                            "speaker": "「小松果」",
                                            "text": "等到下次，纳塔需要更多战士的时候，我和木头人都要站出来帮忙！"
                                        }
                                    ]
                                },
                                {
                                    "id": "775040415",
                                    "text": "这么看来，你爸也是真心大…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775040427",
                    "text": "没事，不打扰你们玩啦。",
                    "response": [
                        {
                            "id": "775040428",
                            "speaker": "「燃爆木头人」",
                            "text": "我我我，其实我还蛮想被杜麦尼打扰的…"
                        },
                        {
                            "id": "775040429",
                            "speaker": "「小松果」",
                            "text": "感觉…杜麦尼还有事？等你不那么忙了，请和我们一起玩吧！几分钟也好！"
                        }
                    ]
                }
            ]
        }
    ]
}