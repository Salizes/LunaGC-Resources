{
    "talkId": "4013525",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "夏沃蕾": 13
    },
    "dialogues": [
        {
            "id": "401352501",
            "speaker": "夏沃蕾",
            "text": "虽然有些迟了，但…谢谢你愿意陪我调查这个案件。"
        },
        {
            "id": "401352502",
            "speaker": "夏沃蕾",
            "text": "这次不是代表特巡队，而是代表我自己向你表达感谢。",
            "choices": [
                {
                    "id": "401352503",
                    "text": "关于你的家人…",
                    "response": [
                        {
                            "id": "401352504",
                            "speaker": "夏沃蕾",
                            "text": "还想听我和父亲的故事吗？"
                        },
                        {
                            "id": "401352505",
                            "speaker": "夏沃蕾",
                            "text": "其实我和他相处的也不算多。特巡队工作很忙，他那时经常很晚才回到家，有时根本不回家。"
                        },
                        {
                            "id": "401352506",
                            "speaker": "夏沃蕾",
                            "text": "有一次，他太久没回家了。可能有一个星期吧。"
                        },
                        {
                            "id": "401352507",
                            "speaker": "夏沃蕾",
                            "text": "当我去街上买东西时，才知道他成了人们口中的「罪人」，而我则成了「罪人的女儿」。"
                        },
                        {
                            "id": "401352508",
                            "speaker": "夏沃蕾",
                            "text": "不过…这个话题还是下次再说吧。"
                        }
                    ]
                },
                {
                    "id": "401352509",
                    "text": "关于案件…",
                    "response": [
                        {
                            "id": "401352510",
                            "speaker": "夏沃蕾",
                            "text": "我其实很同情薇若妮卡和她的哥哥。也能理解他们心中的仇恨…"
                        },
                        {
                            "id": "401352511",
                            "speaker": "夏沃蕾",
                            "text": "但这不代表我会纵容他们走上「罪恶」的路。尽管它或许通向另一种「正义」。"
                        }
                    ]
                },
                {
                    "id": "401352512",
                    "text": "关于映影…",
                    "response": [
                        {
                            "id": "401352513",
                            "speaker": "夏沃蕾",
                            "text": "映影和现实不同，它是艺术，是人们内心的向往。"
                        },
                        {
                            "id": "401352514",
                            "speaker": "夏沃蕾",
                            "text": "我喜欢《两个铳枪手》，也很高兴出演了其中的主角。"
                        },
                        {
                            "id": "401352515",
                            "speaker": "夏沃蕾",
                            "text": "等它上映的时候，我会去歌剧院看的，观众们一定也喜欢这部映影的结局。"
                        }
                    ]
                },
                {
                    "id": "401352516",
                    "text": "你多保重…",
                    "response": [
                        {
                            "id": "401352517",
                            "speaker": "夏沃蕾",
                            "text": "谢谢你的关心，我们颁奖典礼上见。我相信，这部映影一定会得奖的。"
                        }
                    ]
                }
            ]
        }
    ]
}