{
    "talkId": "7370510",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "哈贾娜德": 9
    },
    "dialogues": [
        {
            "id": "737051001",
            "speaker": "哈贾娜德",
            "text": "您好，我的恩人。接下来就由我来继续管理这个侦察伙伴的项目，并详尽记述资料。"
        },
        {
            "id": "737051002",
            "speaker": "哈贾娜德",
            "text": "有什么吩咐吗？",
            "choices": [
                {
                    "id": "737051003",
                    "text": "想要再试试侦察伙伴…",
                    "response": [
                        {
                            "id": "737051004",
                            "speaker": "哈贾娜德",
                            "text": "没问题！这次，我会用更加准确的模型来分析您提供的数据！"
                        }
                    ]
                },
                {
                    "id": "737051005",
                    "text": "你好像是悉般多摩学院的？",
                    "response": [
                        {
                            "id": "737051006",
                            "speaker": "哈贾娜德",
                            "text": "没错，我的学院并不直接参与机关研究。"
                        },
                        {
                            "id": "737051007",
                            "speaker": "哈贾娜德",
                            "text": "但是没关系，多亏你们之前完成了所有关键规则与操作手册的制定，只是管理摊位和继续运营，每个学者都能做到。"
                        },
                        {
                            "id": "737051008",
                            "speaker": "哈贾娜德",
                            "text": "在无需专门人力的地方，就做出一定的节省，也符合我们最新的原则。"
                        },
                        {
                            "id": "737051009",
                            "speaker": "哈贾娜德",
                            "text": "附近待命的学者中，不乏刹诃伐罗学院的优秀人士，如果侦察伙伴的机关需要调试，随时可以唤来他们。"
                        },
                        {
                            "id": "737051010",
                            "speaker": "哈贾娜德",
                            "text": "不过，目前看来，侦察伙伴们的状态都很好，完全无需担心！"
                        }
                    ]
                },
                {
                    "id": "737051011",
                    "text": "你加油！",
                    "response": [
                        {
                            "id": "737051012",
                            "speaker": "哈贾娜德",
                            "text": "当然，等我干出了漂亮的成绩，一定专程来答谢您！"
                        }
                    ]
                }
            ]
        }
    ]
}