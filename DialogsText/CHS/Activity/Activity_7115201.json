{
    "talkId": "7115201",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 8,
        "九条裟罗": 7
    },
    "dialogues": [
        {
            "id": "711520101",
            "speaker": "九条裟罗",
            "text": "#{NICKNAME}，呵…会在此时的璃月遇见你，倒也不算意外，祝你海灯节快乐。",
            "choices": [
                {
                    "id": "711520102",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711520104",
                            "speaker": "九条裟罗",
                            "text": "嗯。我看见了，稍后我也会去买几盏霄灯带回稻妻。挂在天领奉行的门口，应该也会很好看的。"
                        },
                        {
                            "id": "711520114",
                            "speaker": "九条裟罗",
                            "text": "有鹿野院同心在，想必贼匪也不敢对这几盏霄灯有贪念。"
                        },
                        {
                            "id": "711520103",
                            "speaker": "Player",
                            "text": "关于纪念留影…"
                        },
                        {
                            "id": "711520115",
                            "speaker": "九条裟罗",
                            "text": "是我向萍溪小姐申请的。看来她所说的专业留影师就是你了。"
                        },
                        {
                            "id": "711520116",
                            "speaker": "九条裟罗",
                            "text": "不错，我相信你能拍出很好的画片，那我们现在就开始吧。",
                            "choices": [
                                {
                                    "id": "711520117",
                                    "text": "没问题！",
                                    "response": [
                                        {
                                            "id": "711520120",
                                            "speaker": "九条裟罗",
                                            "text": "嗯，那也请你顺便给我一些有关留影动作的建议吧。",
                                            "choices": [
                                                {
                                                    "id": "711520121",
                                                    "text": "严肃一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711520123",
                                                            "speaker": "Player",
                                                            "text": "就这个动作吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711520122",
                                                    "text": "放松一点的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711520118",
                                    "text": "请稍等一会…",
                                    "response": [
                                        {
                                            "id": "711520119",
                                            "speaker": "九条裟罗",
                                            "text": "是有急事要处理么？无妨，我会在这里等着，你处理好后来找我就是。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711520103",
                    "text": "关于纪念留影…"
                }
            ]
        }
    ]
}