{
    "talkId": "7166502",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "兰吉特": 8
    },
    "dialogues": [
        {
            "id": "716650201",
            "speaker": "兰吉特",
            "text": "我们这就开始？",
            "choices": [
                {
                    "id": "716650202",
                    "text": "开始吧。"
                },
                {
                    "id": "716650203",
                    "text": "爆炎树和纳塔的龙哪里像了？",
                    "response": [
                        {
                            "id": "716650204",
                            "speaker": "兰吉特",
                            "text": "…哈哈，这你就不知道了吧，纳塔有能够吐出火球的龙呢！啊，那种过量的火元素扑面而来的感觉，就很有纳塔的味道！"
                        },
                        {
                            "id": "716650205",
                            "speaker": "兰吉特",
                            "text": "其实我是这么打算的，作为挑战的第一步，选个难度低一点的也是常理，对吧？"
                        },
                        {
                            "id": "716650206",
                            "speaker": "兰吉特",
                            "text": "爆炎树不躲也不藏，不用费劲去找，也不怕它逃跑，真是再合适不过了。"
                        },
                        {
                            "id": "716650207",
                            "speaker": "兰吉特",
                            "text": "而且就算不能和它交上朋友，爆炎树的果实也是不错的创意料理食材呢…"
                        }
                    ]
                },
                {
                    "id": "716650208",
                    "text": "说起来还没见过纳塔人…",
                    "response": [
                        {
                            "id": "716650209",
                            "speaker": "兰吉特",
                            "text": "这个嘛，纳塔的朋友对于离开纳塔这件事的确有许多顾忌，这事我一个外人也不好说三道四。"
                        },
                        {
                            "id": "716650210",
                            "speaker": "兰吉特",
                            "text": "什么规矩、禁忌之类的我也不太懂，不过我想应该不会是简单的水土不服吧，哈哈。"
                        }
                    ]
                },
                {
                    "id": "716650211",
                    "text": "还有别的事，稍候。",
                    "response": [
                        {
                            "id": "716650212",
                            "speaker": "兰吉特",
                            "text": "没问题，我就在这儿等你。"
                        }
                    ]
                }
            ]
        }
    ]
}