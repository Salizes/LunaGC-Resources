{
    "talkId": "7166671",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "「花角玉将」": 18
    },
    "dialogues": [
        {
            "id": "716667101",
            "speaker": "「花角玉将」",
            "text": "「鬼王的左膀右臂」殿下，有什么我能帮你们的事吗？",
            "choices": [
                {
                    "id": "716667102",
                    "text": "给我也整一只鬼兜虫！",
                    "response": [
                        {
                            "id": "716667103",
                            "speaker": "「花角玉将」",
                            "text": "好！完全不在话下！"
                        },
                        {
                            "id": "716667104",
                            "speaker": "「花角玉将」",
                            "text": "不过，斗虫强者和鬼兜虫之间的相性，还需要很长的时间来观察…"
                        },
                        {
                            "id": "716667105",
                            "speaker": "「花角玉将」",
                            "text": "凭借之前和您斗虫的经历，我大概能推测出最符合您斗虫风格的鬼兜虫。当然，对我而言也是一个重大的考验。"
                        },
                        {
                            "id": "716667106",
                            "speaker": "「花角玉将」",
                            "text": "我得好好想想了，要去什么样的地点，才能抓到那种鬼兜虫…"
                        },
                        {
                            "id": "716667107",
                            "speaker": "「花角玉将」",
                            "text": "就要麻烦您耐心等待了，希望下次见面时，我能给你一份完美的答卷！"
                        }
                    ]
                },
                {
                    "id": "716667108",
                    "text": "关于送礼的事…",
                    "response": [
                        {
                            "id": "716667109",
                            "speaker": "「花角玉将」",
                            "text": "啊呀，你是说我们要给那位大师的礼物吗？"
                        },
                        {
                            "id": "716667110",
                            "speaker": "「花角玉将」",
                            "text": "说实话，我一时还没有很好的点子…"
                        },
                        {
                            "id": "716667111",
                            "speaker": "「花角玉将」",
                            "text": "那位大师能制作出无比精妙的「花羽叶月神机」，或许，买些精密的机械加工设备，好好包装在礼盒中，能让那位大师满意…"
                        },
                        {
                            "id": "716667112",
                            "speaker": "「花角玉将」",
                            "text": "不过我手里只剩两百万摩拉了，怕是很难买到最顶尖的装置，入不了那位大师的法眼。"
                        },
                        {
                            "id": "716667113",
                            "speaker": "「花角玉将」",
                            "text": "而且我也不知道要在璃月待多久，自己吃住也要花费摩拉，得想想办法扩充行动资金了…",
                            "choices": [
                                {
                                    "id": "716667114",
                                    "text": "两百万好像也不少吧…",
                                    "response": [
                                        {
                                            "id": "716667116",
                                            "speaker": "「花角玉将」",
                                            "text": "小部分是我平常节省伙食费攒下来的，大部分是我祖父给我的。"
                                        },
                                        {
                                            "id": "716667117",
                                            "speaker": "「花角玉将」",
                                            "text": "我的祖父以前是很厉害的冒险家，每次带着他的鬼兜虫出远门，都会被好运眷顾，找到一大笔财宝。"
                                        },
                                        {
                                            "id": "716667118",
                                            "speaker": "「花角玉将」",
                                            "text": "所以他非常支持我的斗虫事业，每隔一段时间，都会给我一笔存款，我也没有乱花，总有一天要把这笔钱花在最重要的地方！"
                                        },
                                        {
                                            "id": "716667119",
                                            "speaker": "「花角玉将」",
                                            "text": "之前，我看荒泷派的经济情况实在不好，提出要支援鬼王一笔资金，鬼王每次都拒绝了，还说…"
                                        },
                                        {
                                            "id": "716667120",
                                            "speaker": "「花角玉将」",
                                            "text": "「哪有让盟友出钱的道理！本大爷和荒泷派可是有骨气的！」"
                                        },
                                        {
                                            "id": "716667121",
                                            "speaker": "「花角玉将」",
                                            "text": "我尊重鬼王的气节，所以，买到了送给那位大师的礼物后，我也会向鬼王报销的…不管需要几百万摩拉！"
                                        }
                                    ]
                                },
                                {
                                    "id": "716667115",
                                    "text": "这些钱都是你自己的？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "716667122",
                    "text": "回见了，玉将！",
                    "response": [
                        {
                            "id": "716667123",
                            "speaker": "「花角玉将」",
                            "text": "好啊，您先忙，「鬼王的左膀右臂」殿下！"
                        }
                    ]
                }
            ]
        }
    ]
}