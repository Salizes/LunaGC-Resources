            "id": "766800301",
            "speaker": "洋葱尾巴",
            "text": "？",
            "choices": [
                {
                    "id": "766800302",
                    "text": "好鼬鼬，乖！",
                    "response": [
                        {
                            "id": "766800303",
                            "speaker": "洋葱尾巴",
                            "text": "……"
                        },
                        {
                            "id": "766800304",
                            "speaker": "观察洋葱尾巴",
                            "text": "（这只鼬鼬似乎没被人这么夸过，眼神有些躲闪…）"
                        }
                    ]
                },
                {
                    "id": "766800305",
                    "text": "帅鼬鼬，一起加油！",
                    "response": [
                        {
                            "id": "766800306",
                            "speaker": "洋葱尾巴",
                            "text": "！！"
                        },
                        {
                            "id": "766800307",
                            "speaker": "观察洋葱尾巴",
                            "text": "（这只鼬鼬似乎很受鼓舞，眼里闪烁出充满干劲的光芒…）"
                        }
                    ]
                },
                {
                    "id": "766800308",
                    "text": "下次再见，鼬鼬！",
                    "response": [
                        {
                            "id": "766800309",
                            "speaker": "观察洋葱尾巴",
                            "text": "（鼬鼬表现得相当平静，只是一动不动地看着你离去…）"
                        }
                    ]
                }
            ]
        }
    ]
