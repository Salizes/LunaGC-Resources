{
    "talkId": "4020008",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 2,
        "丰克": 6,
        "科德": 4
    },
    "dialogues": [
        {
            "id": "402000801",
            "speaker": "丰克",
            "text": "怎么，腿在发抖啊？"
        },
        {
            "id": "402000802",
            "speaker": "丰克",
            "text": "干那些肮脏活，赚黑钱赚到手软的时候，也没见你发抖啊，"
        },
        {
            "id": "402000803",
            "speaker": "丰克",
            "text": "是因为那时你完全没想过自己洗白赃款的背后，有多少受害者，而现在不得不面对他们，不得不面对全体公民的怒火了?"
        },
        {
            "id": "402000804",
            "speaker": "丰克",
            "text": "到头来，还是个性格老掉牙的懦夫啊…"
        },
        {
            "id": "402000805",
            "speaker": "科德",
            "text": "……"
        },
        {
            "id": "402000806",
            "speaker": "科德",
            "text": "我会好好面对审判的。"
        },
        {
            "id": "402000807",
            "speaker": "Player",
            "text": "我会在观众席上朝你扔西红柿的。"
        },
        {
            "id": "402000808",
            "speaker": "科德",
            "text": "你！"
        },
        {
            "id": "402000809",
            "speaker": "Player",
            "text": "还是说，你想要臭鸡蛋？"
        },
        {
            "id": "402000810",
            "speaker": "科德",
            "text": "栽在你们手上，可能正是我命该绝吧。"
        },
        {
            "id": "402000811",
            "speaker": "丰克",
            "text": "哈哈！请帮我多扔一颗！"
        },
        {
            "id": "402000812",
            "speaker": "丰克",
            "text": "哦，还有借我一身便服的哥们，「康思戈的前左手」。他有事不能来看这场审判，就请帮他朝科德扔一颗…发霉的苹果吧。"
        }
    ]
}