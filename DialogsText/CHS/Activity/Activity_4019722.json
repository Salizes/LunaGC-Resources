{
    "talkId": "4019722",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 4,
        "派蒙": 6,
        "芙宁娜": 15
    },
    "dialogues": [
        {
            "id": "401972201",
            "speaker": "芙宁娜",
            "text": "#嗯哼~{NICKNAME}和派蒙，我远远就能感受到你们身上洋溢的热情。"
        },
        {
            "id": "401972202",
            "speaker": "芙宁娜",
            "text": "简直就像…正在诵唱美妙高音的歌剧演员！"
        },
        {
            "id": "401972203",
            "speaker": "派蒙",
            "text": "芙宁娜，总算等到你了！",
            "choices": [
                {
                    "id": "401972204",
                    "text": "关键明星登场~",
                    "response": [
                        {
                            "id": "401972206",
                            "speaker": "芙宁娜",
                            "text": "看见你们为我的到来而鼓舞，我也十分欣喜。"
                        },
                        {
                            "id": "401972207",
                            "speaker": "芙宁娜",
                            "text": "不过，这次的主角不是我，是你们，是热爱映影与创作，并用行动将这些乐趣分享给大家的人们。"
                        },
                        {
                            "id": "401972208",
                            "speaker": "芙宁娜",
                            "text": "说实话，最初被问到授权时，我以为这个活动最多只有一个小型展演的规模。"
                        },
                        {
                            "id": "401972209",
                            "speaker": "芙宁娜",
                            "text": "没想到，「海薇玛映影欢乐城」竟然能在短时间内建设到这种程度…"
                        },
                        {
                            "id": "401972210",
                            "speaker": "派蒙",
                            "text": "唔，想想刚开始来到这里的样子，好像…确实很快就建成了厉害的乐园！"
                        },
                        {
                            "id": "401972211",
                            "speaker": "芙宁娜",
                            "text": "按这种漂亮的势头继续发展，说不定，它能成为类似「千灵映影节」那样的重要庆典！"
                        },
                        {
                            "id": "401972212",
                            "speaker": "芙宁娜",
                            "text": "对此，你们可谓功勋卓著！"
                        },
                        {
                            "id": "401972213",
                            "speaker": "芙宁娜",
                            "text": "我正向多位知名导演提议，联合赠予你们「映影业界先锋」的荣誉。"
                        },
                        {
                            "id": "401972214",
                            "speaker": "芙宁娜",
                            "text": "相较于大众层面的「芙宁娜奖」，这项荣誉更偏向业内人士的认可，是绝对功劳与苦劳相融合的冠冕！",
                            "choices": [
                                {
                                    "id": "401972215",
                                    "text": "多谢鼓励！还有提升空间。",
                                    "response": [
                                        {
                                            "id": "401972217",
                                            "speaker": "派蒙",
                                            "text": "哇啊，你也正经起来了…"
                                        },
                                        {
                                            "id": "401972218",
                                            "speaker": "芙宁娜",
                                            "text": "不用严肃啦，放松放松，拿出轻快的心情！"
                                        },
                                        {
                                            "id": "401972219",
                                            "speaker": "芙宁娜",
                                            "text": "我准备一段时间，接下来，我们随机抽选一批客人，了解一下在「海薇玛映影欢乐城」游览的体验，如何？"
                                        },
                                        {
                                            "id": "401972220",
                                            "speaker": "派蒙",
                                            "text": "咦，用户调查这种事，也需要芙宁娜来做吗？"
                                        },
                                        {
                                            "id": "401972221",
                                            "speaker": "芙宁娜",
                                            "text": "怎么说，也是冠上了海薇玛夫人大名的活动，由我代她调查情况，很合理吧？"
                                        },
                                        {
                                            "id": "401972222",
                                            "speaker": "芙宁娜",
                                            "text": "而且，越是知名的明星，越应该务实点嘛。"
                                        },
                                        {
                                            "id": "401972223",
                                            "speaker": "芙宁娜",
                                            "text": "多听听大家对映影相关事物的看法，对提升自己的能力也很有帮助！"
                                        },
                                        {
                                            "id": "401972224",
                                            "speaker": "派蒙",
                                            "text": "原来明星不是我想的那样，所有事都有助手处理得妥妥当当…还是挺辛苦的呀。"
                                        },
                                        {
                                            "id": "401972225",
                                            "speaker": "派蒙",
                                            "text": "不对，说不定，是芙宁娜本来就不能用常理来考量？"
                                        }
                                    ]
                                },
                                {
                                    "id": "401972216",
                                    "text": "接了荣誉，还得继续努力！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401972205",
                    "text": "气氛达到最热点！"
                }
            ]
        }
    ]
}