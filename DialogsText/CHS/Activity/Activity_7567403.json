{
    "talkId": "7567403",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 4,
        "努斯妲": 17
    },
    "dialogues": [
        {
            "id": "756740301",
            "speaker": "努斯妲",
            "text": "#您已经轻车熟路了呀，{NICKNAME}！这次的舞者队伍，还有美露莘和阿夏加盟，看她们跳舞，非常惬意吧？",
            "choices": [
                {
                    "id": "756740302",
                    "text": "跳舞跳舞，现在开始！",
                    "response": [
                        {
                            "id": "756740303",
                            "speaker": "努斯妲",
                            "text": "啊哈哈！就是这样！释放热情，跟着节奏摇摆！"
                        }
                    ]
                },
                {
                    "id": "756740304",
                    "text": "先聊两句，努斯妲？",
                    "response": [
                        {
                            "id": "756740305",
                            "speaker": "努斯妲",
                            "text": "好呀好呀，我要先向你报喜——"
                        },
                        {
                            "id": "756740306",
                            "speaker": "努斯妲",
                            "text": "之前，我为了提升滞空拳法，加强基础力量的训练，去「沃陆之邦」旅居了一段时间…"
                        },
                        {
                            "id": "756740307",
                            "speaker": "努斯妲",
                            "text": "正好也借机练习了鼓术，现在鼓打得还算不错！"
                        },
                        {
                            "id": "756740308",
                            "speaker": "努斯妲",
                            "text": "按伊安珊大师的评价，再加强一下双踩和复合跳的律动感，我就能演奏比较前卫的曲目了。"
                        },
                        {
                            "id": "756740309",
                            "speaker": "努斯妲",
                            "text": "如果以后，您打算组建自己的乐队，一时间找不到鼓手…"
                        },
                        {
                            "id": "756740310",
                            "speaker": "努斯妲",
                            "text": "不嫌弃的话，我可以来帮忙！"
                        }
                    ]
                },
                {
                    "id": "756740311",
                    "text": "这次还有些朋友没来？",
                    "response": [
                        {
                            "id": "756740312",
                            "speaker": "努斯妲",
                            "text": "哦？您大概是指…塔拉内和「弯刀大叔」？"
                        },
                        {
                            "id": "756740313",
                            "speaker": "努斯妲",
                            "text": "他们最近忙得不可开交，确实有点遗憾！"
                        },
                        {
                            "id": "756740314",
                            "speaker": "努斯妲",
                            "text": "之前须弥好像发生了什么不得了的风波，举行了一场规模庞大的搬迁。"
                        },
                        {
                            "id": "756740315",
                            "speaker": "努斯妲",
                            "text": "好在，听说危险的问题已经被解决了…于是他们又要搬回原来的地方。"
                        },
                        {
                            "id": "756740316",
                            "speaker": "努斯妲",
                            "text": "搬家这种事情总是非常麻烦的嘛，何况是两次。整理东西，彻底打扫屋子什么的，都很费时间…"
                        },
                        {
                            "id": "756740317",
                            "speaker": "努斯妲",
                            "text": "以塔拉内和「弯刀大叔」的性格，自己搞定了最麻烦的事，肯定还会去帮邻居。"
                        },
                        {
                            "id": "756740318",
                            "speaker": "努斯妲",
                            "text": "所以这次，就只有一些相对清闲的「炽光猎兽」成员来玩了。"
                        },
                        {
                            "id": "756740319",
                            "speaker": "努斯妲",
                            "text": "不过我相信，下次他们肯定会第一时间到场，我已经准备好酒了！"
                        }
                    ]
                },
                {
                    "id": "756740320",
                    "text": "待会儿再来跳舞。",
                    "response": [
                        {
                            "id": "756740321",
                            "speaker": "努斯妲",
                            "text": "没问题！您可以先享受享受这次舞力聚会的美食，让心情和状态达到最棒的状态！"
                        }
                    ]
                }
            ]
        }
    ]
}