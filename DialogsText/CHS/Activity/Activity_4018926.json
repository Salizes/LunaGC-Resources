{
    "talkId": "4018926",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "「邦邦滚石」": 9
    },
    "dialogues": [
        {
            "id": "401892601",
            "speaker": "「邦邦滚石」",
            "text": "哟！大英雄兼我的好老板，本人随您差遣，请下令吧！",
            "choices": [
                {
                    "id": "401892602",
                    "text": "你是…",
                    "response": [
                        {
                            "id": "401892603",
                            "speaker": "「邦邦滚石」",
                            "text": "哎吔，就是个「沃陆之邦」的普通摔角手，不管我怎么介绍自己，您应该都想不起来…"
                        },
                        {
                            "id": "401892604",
                            "speaker": "「邦邦滚石」",
                            "text": "所以我还是用「瓦雷莎的手下败将」这个称呼比较好，至少有足够的辨识度！"
                        },
                        {
                            "id": "401892605",
                            "speaker": "「邦邦滚石」",
                            "text": "瓦雷莎只有几岁的时候，就把我揍趴下了呢，还单手拎着我从摔角台上走了下来！怎么样，这下就能记住我了吧？"
                        }
                    ]
                },
                {
                    "id": "401892606",
                    "text": "那我命你速速赚够一千万！",
                    "response": [
                        {
                            "id": "401892607",
                            "speaker": "「邦邦滚石」",
                            "text": "真看得起我！一个项目就能赚够一千万的话，那整个乐园的营收该有多少哇？"
                        },
                        {
                            "id": "401892608",
                            "speaker": "「邦邦滚石」",
                            "text": "我帮瓦雷莎送货也有好几年了，还真没见过这么大的生意！"
                        },
                        {
                            "id": "401892609",
                            "speaker": "「邦邦滚石」",
                            "text": "作为老板的您，应该也能拿到超多分红吧？"
                        },
                        {
                            "id": "401892610",
                            "speaker": "「邦邦滚石」",
                            "text": "要不，先在伊安珊教练的健身房买上个…十年的年卡？再买上全套的终极课程，稳赚不赔！"
                        }
                    ]
                },
                {
                    "id": "401892611",
                    "text": "认真完成工作就行。",
                    "response": [
                        {
                            "id": "401892612",
                            "speaker": "「邦邦滚石」",
                            "text": "遵命！您大可放心！"
                        }
                    ]
                }
            ]
        }
    ]
}