{
    "talkId": "7567408",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "玛拉妮": 18
    },
    "dialogues": [
        {
            "id": "756740801",
            "speaker": "玛拉妮",
            "text": "#哟哈！{NICKNAME}，你的「舞力聚会亲卫队长」向你报到！",
            "choices": [
                {
                    "id": "756740802",
                    "text": "这次太用心了，辛苦了！",
                    "response": [
                        {
                            "id": "756740803",
                            "speaker": "玛拉妮",
                            "text": "咦，是说邀请了芭芭拉吗？"
                        },
                        {
                            "id": "756740804",
                            "speaker": "玛拉妮",
                            "text": "哼哼，看见你在蒙德的老朋友，是不是很惊喜？",
                            "choices": [
                                {
                                    "id": "756740805",
                                    "text": "的确挺惊喜的。",
                                    "response": [
                                        {
                                            "id": "756740807",
                                            "speaker": "玛拉妮",
                                            "text": "要仔细盘算的话…还得多亏希诺宁和瓦雷莎？"
                                        },
                                        {
                                            "id": "756740808",
                                            "speaker": "玛拉妮",
                                            "text": "她们在蒙德有位朋友，给妮佩卡带来了画着偶像芭芭拉的明信片…"
                                        },
                                        {
                                            "id": "756740809",
                                            "speaker": "玛拉妮",
                                            "text": "希诺宁转交给我后，我一打听才知道，原来蒙德也有这么厉害的跳舞大师！"
                                        },
                                        {
                                            "id": "756740810",
                                            "speaker": "玛拉妮",
                                            "text": "必须邀请，必须邀请！"
                                        },
                                        {
                                            "id": "756740811",
                                            "speaker": "玛拉妮",
                                            "text": "不然，舞力聚会的拼图，总觉得少了无比重要的一块！"
                                        },
                                        {
                                            "id": "756740812",
                                            "speaker": "玛拉妮",
                                            "text": "以前就有「西风骑士团」的朋友造访过纳塔，他们作风豪爽，和「流泉之众」特别合得来。"
                                        },
                                        {
                                            "id": "756740813",
                                            "speaker": "玛拉妮",
                                            "text": "正好，这边就找了当时的骑士朋友，通过冒险家中转，把信送到了芭芭拉手里。"
                                        },
                                        {
                                            "id": "756740814",
                                            "speaker": "玛拉妮",
                                            "text": "要不是刚刚从须弥请来了妮露，筹备聚会和搭建场地的事务还没完成…"
                                        },
                                        {
                                            "id": "756740815",
                                            "speaker": "玛拉妮",
                                            "text": "我肯定要亲自去请芭芭拉，才足够有诚意。"
                                        },
                                        {
                                            "id": "756740816",
                                            "speaker": "玛拉妮",
                                            "text": "我本来也对蒙德很好奇嘛，感觉是非常好玩的国家！",
                                            "choices": [
                                                {
                                                    "id": "756740817",
                                                    "text": "你的感觉完全没错。",
                                                    "response": [
                                                        {
                                                            "id": "756740819",
                                                            "speaker": "玛拉妮",
                                                            "text": "总之，蒙德也要加入旅游目的地名单！"
                                                        },
                                                        {
                                                            "id": "756740820",
                                                            "speaker": "玛拉妮",
                                                            "text": "这次舞力聚会结束后，我还要帮阿米娜稍微管管部族新勇士们的训练…"
                                                        },
                                                        {
                                                            "id": "756740821",
                                                            "speaker": "玛拉妮",
                                                            "text": "不出意外的话，我就可以继续到处去玩啦。"
                                                        },
                                                        {
                                                            "id": "756740822",
                                                            "speaker": "玛拉妮",
                                                            "text": "哪天出现在你特别熟悉又想不到的地方，继续给你特大惊喜！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756740818",
                                                    "text": "我看不止是好玩喔…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756740806",
                                    "text": "甚至以为走错片场了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756740823",
                    "text": "待会儿再多聊聊。",
                    "response": [
                        {
                            "id": "756740824",
                            "speaker": "玛拉妮",
                            "text": "怎么？被音乐勾起了舞力之魂吗？那就去尽情释放热情吧！"
                        }
                    ]
                }
            ]
        }
    ]
}