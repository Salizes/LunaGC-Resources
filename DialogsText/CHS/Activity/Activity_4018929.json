{
    "talkId": "4018929",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "科斯唐坦": 6
    },
    "dialogues": [
        {
            "id": "401892901",
            "speaker": "科斯唐坦",
            "text": "优雅！精妙！这华丽的即兴表演项目，我愿为之沉醉！",
            "choices": [
                {
                    "id": "401892902",
                    "text": "那你干活卖力点哦。",
                    "response": [
                        {
                            "id": "401892903",
                            "speaker": "科斯唐坦",
                            "text": "不必担忧！我开工前已经喝过两杯咖啡了，一整天都充满动力！"
                        },
                        {
                            "id": "401892904",
                            "speaker": "科斯唐坦",
                            "text": "可惜，如果有员工陪同客人一同解开难题的项目就好了，只能旁观，在必要时提供帮助，还是不够尽兴啊…"
                        }
                    ]
                },
                {
                    "id": "401892905",
                    "text": "别沉醉过头，要集中精力。",
                    "response": [
                        {
                            "id": "401892906",
                            "speaker": "科斯唐坦",
                            "text": "这是当然！虽说没有紧张的战斗环节，但机关的挑战也不容小觑。"
                        },
                        {
                            "id": "401892907",
                            "speaker": "科斯唐坦",
                            "text": "我以「轻剑舞者」之名向您保证，定会让客人玩得刺激又安全，万无一失！"
                        }
                    ]
                },
                {
                    "id": "401892908",
                    "text": "好，精神不错！",
                    "response": [
                        {
                            "id": "401892909",
                            "speaker": "科斯唐坦",
                            "text": "我向来如此！"
                        }
                    ]
                }
            ]
        }
    ]
}