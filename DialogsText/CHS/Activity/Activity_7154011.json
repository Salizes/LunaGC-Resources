{
    "talkId": "7154011",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "甘雨": 10
    },
    "dialogues": [
        {
            "id": "715401101",
            "speaker": "甘雨",
            "text": "还好，璃月安然无虞…",
            "choices": [
                {
                    "id": "715401102",
                    "text": "甘雨，这封祝柬送你。",
                    "response": [
                        {
                            "id": "715401103",
                            "speaker": "甘雨",
                            "text": "#这祝柬真好看，谢谢你，{NICKNAME}。"
                        },
                        {
                            "id": "715401104",
                            "speaker": "甘雨",
                            "text": "这次的事，多亏了你们，璃月才能安然无虞。"
                        },
                        {
                            "id": "715401105",
                            "speaker": "Player",
                            "text": "是大家一起努力的成果。"
                        },
                        {
                            "id": "715401106",
                            "speaker": "甘雨",
                            "text": "呼…总而言之，平安就好。"
                        },
                        {
                            "id": "715401107",
                            "speaker": "甘雨",
                            "text": "对了，你身体还好吗？有没有哪里不舒服？"
                        },
                        {
                            "id": "715401108",
                            "speaker": "Player",
                            "text": "谢谢，都还好。"
                        },
                        {
                            "id": "715401109",
                            "speaker": "甘雨",
                            "text": "那就好，那晚胡堂主把昏迷的你背回不卜庐，我和刻晴收到消息后，立刻就过去了。"
                        },
                        {
                            "id": "715401110",
                            "speaker": "甘雨",
                            "text": "还好白术说你只是脱力，我们才安下心来，真是万幸。"
                        },
                        {
                            "id": "715401111",
                            "speaker": "甘雨",
                            "text": "但你也要多留心，如果这几天感到身体不适，请来找我，我带你去见留云真君。"
                        },
                        {
                            "id": "715401112",
                            "speaker": "甘雨",
                            "text": "她虽然不以医术见长，但仙人们总是有各种奇妙法子的，一定不会让你出问题。"
                        }
                    ]
                },
                {
                    "id": "715401113",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715401114",
                            "speaker": "甘雨",
                            "text": "再见，祝你海灯节快乐。"
                        }
                    ]
                }
            ]
        }
    ]
}