{
    "talkId": "7413750",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "基肖恩": 9
    },
    "dialogues": [
        {
            "id": "741375001",
            "speaker": "基肖恩",
            "text": "嘿，您回来了？回收「荧光紫水母」的事还顺利吗？",
            "choices": [
                {
                    "id": "741375002",
                    "text": "挺顺利的。",
                    "response": [
                        {
                            "id": "741375003",
                            "speaker": "基肖恩",
                            "text": "哦！那么想必您也见过它们喷出的「荧光粘液」了吧？"
                        },
                        {
                            "id": "741375004",
                            "speaker": "基肖恩",
                            "text": "水母在受惊时，偶尔会喷出液体，有的能加速逃生，有的能麻痹敌人…不过「荧光紫水母」是经过人工选育的物种，它们的粘液是无害的，还请放心去抓。"
                        },
                        {
                            "id": "741375005",
                            "speaker": "Player",
                            "text": "这些粘液好像会跟着我…"
                        },
                        {
                            "id": "741375006",
                            "speaker": "基肖恩",
                            "text": "是吗？唔，可能是吸附在您的装备上，或者被游动时的水流牵引了吧…真想好好研究研究…"
                        },
                        {
                            "id": "741375007",
                            "speaker": "基肖恩",
                            "text": "不过现在时间有限，还是先考虑把它们抓回来的事吧。"
                        }
                    ]
                },
                {
                    "id": "741375008",
                    "text": "不太顺利。",
                    "response": [
                        {
                            "id": "741375009",
                            "speaker": "基肖恩",
                            "text": "欸！是我没讲清楚要怎么抓吗…"
                        },
                        {
                            "id": "741375010",
                            "speaker": "基肖恩",
                            "text": "「荧光紫水母」在水下会发出亮光，应该相当醒目，您在放生区域游上一圈就能看到。"
                        },
                        {
                            "id": "741375011",
                            "speaker": "基肖恩",
                            "text": "只要游到「荧光紫水母」边上，趁它们没注意…再「嘿」地一下！"
                        },
                        {
                            "id": "741375012",
                            "speaker": "基肖恩",
                            "text": "这期限越来越近…我的人身自由可就全指望您了！"
                        }
                    ]
                }
            ]
        }
    ]
}