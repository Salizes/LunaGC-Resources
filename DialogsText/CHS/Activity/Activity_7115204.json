    "dialogues": [
        {
            "id": "711520401",
            "speaker": "九条裟罗",
            "text": "嗯，看来你已经准备好了，那我们就开始留影吧。",
            "choices": [
                {
                    "id": "711520411",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711520412",
                            "speaker": "九条裟罗",
                            "text": "嗯。我看见了，稍后我也会去买几盏霄灯带回稻妻。挂在天领奉行的门口，应该也会很好看的。"
                        },
                        {
                            "id": "711520413",
                            "speaker": "九条裟罗",
                            "text": "有鹿野院同心在，想必贼匪也不敢对这几盏霄灯有贪念。",
                            "choices": [
                                {
                                    "id": "711520402",
                                    "text": "没问题，那就开始留影吧。",
                                    "response": [
                                        {
                                            "id": "711520404",
                                            "speaker": "九条裟罗",
                                            "text": "嗯，那也请你顺便给我一些有关留影动作的建议吧。",
                                            "choices": [
                                                {
                                                    "id": "711520406",
                                                    "text": "严肃一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711520408",
                                                            "speaker": "Player",
                                                            "text": "就这个动作吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711520407",
                                                    "text": "放松一点的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711520403",
                                    "text": "请稍等一会…",
                                    "response": [
                                        {
                                            "id": "711520405",
                                            "speaker": "九条裟罗",
                                            "text": "是有急事要处理么？无妨，我会在这里等着，你处理好后来找我就是。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711520402",
                    "text": "没问题，那就开始留影吧。"
