{
    "talkId": "7053905",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "艾玛托": 16
    },
    "dialogues": [
        {
            "id": "705390501",
            "speaker": "艾玛托",
            "text": "呜呜，「大桔骑士」…你在哪啊…这得上哪儿去找啊…",
            "choices": [
                {
                    "id": "705390502",
                    "text": "你怎么了？",
                    "response": [
                        {
                            "id": "705390503",
                            "speaker": "艾玛托",
                            "text": "荣！荣誉骑士！"
                        },
                        {
                            "id": "705390504",
                            "speaker": "艾玛托",
                            "text": "报告荣誉骑士，我我我，我负责照顾的队猫…打晕了我，逃走了…",
                            "choices": [
                                {
                                    "id": "705390505",
                                    "text": "队猫？",
                                    "response": [
                                        {
                                            "id": "705390507",
                                            "speaker": "艾玛托",
                                            "text": "说出来有点丢人，但绝不能让荣誉骑士费心…"
                                        },
                                        {
                                            "id": "705390508",
                                            "speaker": "艾玛托",
                                            "text": "队长还在总部做近期的述职报告，已经很忙了…我一定得自己找到大桔骑士，不能给队长添麻烦！"
                                        }
                                    ]
                                },
                                {
                                    "id": "705390506",
                                    "text": "打晕？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705390509",
                    "text": "你还好吗？",
                    "response": [
                        {
                            "id": "705390510",
                            "speaker": "艾玛托",
                            "text": "多，多谢荣誉骑士关心！我只是头上挨了一爪子，现在有点晕…"
                        },
                        {
                            "id": "705390511",
                            "speaker": "艾玛托",
                            "text": "「大桔骑士」也没用多大的力气，就是有点不开心…都怪我自己太弱了…"
                        },
                        {
                            "id": "705390512",
                            "speaker": "艾玛托",
                            "text": "我不应该自作主张，把方妮雅的香粉洒在玩具上，递给「大桔骑士」的…"
                        },
                        {
                            "id": "705390513",
                            "speaker": "艾玛托",
                            "text": "我觉得好闻的气味，被「大桔骑士」当成了威胁信号…挨打也是我活该！"
                        },
                        {
                            "id": "705390514",
                            "speaker": "艾玛托",
                            "text": "而且，我确实该锻炼一下了，就算不用普通武器在一线战斗，扔炸弹也需要耗费很多体力…"
                        },
                        {
                            "id": "705390515",
                            "speaker": "艾玛托",
                            "text": "打不过野猪就算了，被大猫一爪拍晕，下次战斗能力考核，我肯定会过不了关的，必须恪守骑士的职责才行！"
                        },
                        {
                            "id": "705390516",
                            "speaker": "艾玛托",
                            "text": "或者…学习璃月的爆破装置和枫丹的铳枪，设计一种…口径超过筒身的弹药抛射装置，把炸弹打出去？"
                        },
                        {
                            "id": "705390517",
                            "speaker": "艾玛托",
                            "text": "呃咳，都是后话了…"
                        },
                        {
                            "id": "705390518",
                            "speaker": "艾玛托",
                            "text": "反正，反正都是我的错，无论如何都不能麻烦荣誉骑士！您是队长级的大人物一定还有超多事务要处理！"
                        },
                        {
                            "id": "705390519",
                            "speaker": "艾玛托",
                            "text": "不打扰您了！"
                        }
                    ]
                },
                {
                    "id": "705390520",
                    "text": "不知道出什么事了…但你加油！",
                    "response": [
                        {
                            "id": "705390521",
                            "speaker": "艾玛托",
                            "text": "荣荣荣荣荣荣誉骑士！我我我…好好好！我一定加油！"
                        }
                    ]
                }
            ]
        }
    ]
}