{
    "talkId": "7054702",
    "total_dialogue_lines": 50,
    "speaker_counts": {
        "Player": 10,
        "派蒙": 9,
        "瓦乐瑞娜": 31
    },
    "dialogues": [
        {
            "id": "705470201",
            "speaker": "瓦乐瑞娜",
            "text": "怎么样，猫猫救星和白猫魔法师？是不是觉得，嘟嘟可毛茸茸、软绵绵又蹦蹦弹弹，想抱抱！",
            "choices": [
                {
                    "id": "705470202",
                    "text": "你也成为嘟嘟可的粉丝了？",
                    "response": [
                        {
                            "id": "705470203",
                            "speaker": "瓦乐瑞娜",
                            "text": "对的对的！我现在的目标是支援艾玛托小姐，好好宣传火花骑士的厉害，还有伙伴嘟嘟可的可爱形象！"
                        },
                        {
                            "id": "705470204",
                            "speaker": "瓦乐瑞娜",
                            "text": "为此，我准备先投入一千万摩拉，试着量产这种桌上游戏，让它流行起来。"
                        },
                        {
                            "id": "705470205",
                            "speaker": "派蒙",
                            "text": "一…一上来就一千万吗？已经不是普通粉丝的级别了…"
                        },
                        {
                            "id": "705470206",
                            "speaker": "瓦乐瑞娜",
                            "text": "不过，量产要等到试玩结束，收集大家的反馈。"
                        },
                        {
                            "id": "705470207",
                            "speaker": "瓦乐瑞娜",
                            "text": "再由实际上的开发者艾玛托小姐进行改良，争取做到每个人都能快速上手，玩个开心！"
                        }
                    ]
                },
                {
                    "id": "705470208",
                    "text": "关于游戏中的嘟嘟可和对手…",
                    "response": [
                        {
                            "id": "705470209",
                            "speaker": "派蒙",
                            "text": "说得对哦，我也想知道，艾玛托小姐的灵感是怎么来的呢？"
                        },
                        {
                            "id": "705470210",
                            "speaker": "派蒙",
                            "text": "#参考可莉，凯亚，丽莎和{NICKNAME}的形象，让我感觉很亲切！"
                        },
                        {
                            "id": "705470211",
                            "speaker": "瓦乐瑞娜",
                            "text": "哎呀，其实开发者不是我，是艾玛托小姐哦。"
                        },
                        {
                            "id": "705470212",
                            "speaker": "瓦乐瑞娜",
                            "text": "我也问过她相同的问题，她的观点让我非常信服——"
                        },
                        {
                            "id": "705470213",
                            "speaker": "瓦乐瑞娜",
                            "text": "你和凯亚先生，还有丽莎小姐，都是蒙德城的大名人，骑士团的中流砥柱！"
                        },
                        {
                            "id": "705470214",
                            "speaker": "瓦乐瑞娜",
                            "text": "你们与火花骑士并肩作战了好多好多年，也该在桌上游戏的舞台中登场。"
                        },
                        {
                            "id": "705470215",
                            "speaker": "瓦乐瑞娜",
                            "text": "英雄的故事从来不是一个人的独角戏，而是伙伴们的意志、勇气和智慧的合奏！"
                        },
                        {
                            "id": "705470216",
                            "speaker": "瓦乐瑞娜",
                            "text": "所以，在讲火花骑士的故事的同时，也要给火花骑士的每个伙伴充足的戏份！"
                        },
                        {
                            "id": "705470217",
                            "speaker": "Player",
                            "text": "可莉的伙伴不止我们哦。"
                        },
                        {
                            "id": "705470218",
                            "speaker": "瓦乐瑞娜",
                            "text": "明白！目前的这些只是试玩版的玩偶，还有琴团长、白色小帮手、阿贝多先生、安柏和优菈小姐，等等等等…"
                        },
                        {
                            "id": "705470219",
                            "speaker": "派蒙",
                            "text": "咦，我也有份吗？"
                        },
                        {
                            "id": "705470220",
                            "speaker": "Player",
                            "text": "派蒙嘟嘟可化…期待！"
                        },
                        {
                            "id": "705470221",
                            "speaker": "瓦乐瑞娜",
                            "text": "至于这次的对手，都是艾玛托小姐根据远征队传回的情报设计的。"
                        },
                        {
                            "id": "705470222",
                            "speaker": "瓦乐瑞娜",
                            "text": "说是参考了挪德卡莱的魔物和敌人…"
                        },
                        {
                            "id": "705470223",
                            "speaker": "瓦乐瑞娜",
                            "text": "因为大家不熟的远方，总有一种神秘感，所以作为冒险的目标很不错嘛！"
                        },
                        {
                            "id": "705470224",
                            "speaker": "瓦乐瑞娜",
                            "text": "以后啊，嘟嘟可的故事，说不定会发展到…前往异世界冒险呢？"
                        },
                        {
                            "id": "705470225",
                            "speaker": "瓦乐瑞娜",
                            "text": "我一定要多多投资，多多见证这个桌上游戏的发展！"
                        }
                    ]
                },
                {
                    "id": "705470226",
                    "text": "我们以前见面的情况是…",
                    "response": [
                        {
                            "id": "705470227",
                            "speaker": "派蒙",
                            "text": "还有你叫我们的外号，我总觉得有点印象…"
                        },
                        {
                            "id": "705470228",
                            "speaker": "瓦乐瑞娜",
                            "text": "嗯，说来时间也好久好久了。"
                        },
                        {
                            "id": "705470229",
                            "speaker": "瓦乐瑞娜",
                            "text": "之前，我在经营一座流浪猫收容所的时候，遇上了困难…好在有你们和罗莎莉亚小姐支援我！"
                        },
                        {
                            "id": "705470230",
                            "speaker": "瓦乐瑞娜",
                            "text": "和白猫魔法师学了两招之后，猫猫们也不再凶我，一切都走上了正轨！"
                        },
                        {
                            "id": "705470231",
                            "speaker": "瓦乐瑞娜",
                            "text": "不过，收容所试营业后没多久，我就被老朋友的队伍指名，参加了一次长途冒险。"
                        },
                        {
                            "id": "705470232",
                            "speaker": "瓦乐瑞娜",
                            "text": "还好我加入了队伍，那次冒险中遇上了好多谜题，要是我不在的话，大概率会有人遭遇不测…"
                        },
                        {
                            "id": "705470233",
                            "speaker": "瓦乐瑞娜",
                            "text": "最近我才回到蒙德城，正打算拾掇拾掇，重新让收容所开张，继续好好干活。",
                            "choices": [
                                {
                                    "id": "705470234",
                                    "text": "想起来了！",
                                    "response": [
                                        {
                                            "id": "705470235",
                                            "speaker": "派蒙",
                                            "text": "是「猫茸茸城堡」吗？是「猫茸茸城堡」没错吧！"
                                        },
                                        {
                                            "id": "705470236",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "太好了，你们还记得！"
                                        },
                                        {
                                            "id": "705470237",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "「雪糕」、「兔叽」、「团团灰」和「阿呆」都很想你们呢！有空的话，要过来玩玩哦！"
                                        },
                                        {
                                            "id": "705470238",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "也请允许我问问看，「大桔骑士」最近怎么样？",
                                            "choices": [
                                                {
                                                    "id": "705470239",
                                                    "text": "非常棒喔！",
                                                    "response": [
                                                        {
                                                            "id": "705470240",
                                                            "speaker": "派蒙",
                                                            "text": "放心吧，瓦乐瑞娜小姐，在我们那儿，「大桔骑士」吃饱喝好，每天都能无忧无虑地玩耍！"
                                                        },
                                                        {
                                                            "id": "705470243",
                                                            "speaker": "瓦乐瑞娜",
                                                            "text": "好呀好呀！容我仔细想想，做点什么小点心，麻烦你们带给它！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "705470241",
                                                    "text": "还行还行！",
                                                    "response": [
                                                        {
                                                            "id": "705470242",
                                                            "speaker": "派蒙",
                                                            "text": "说起来，我好像有段时间没找「大桔骑士」玩了…下次回壶中洞天，我就去好好陪陪它！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "705470244",
                                    "text": "好像还是没印象…",
                                    "response": [
                                        {
                                            "id": "705470245",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "没事没事！你们太忙太忙了，估计每个礼拜见的陌生人比我两三年都多。"
                                        },
                                        {
                                            "id": "705470246",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "没能给你们留下印象，说明我还不够厉害，我会努力成为一名知名冒险家的。"
                                        },
                                        {
                                            "id": "705470247",
                                            "speaker": "瓦乐瑞娜",
                                            "text": "争取下次见面时，你一下子就记起来我是谁，和你们一起经历过什么样的开心时光！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705470248",
                    "text": "下次来详聊！",
                    "response": [
                        {
                            "id": "705470249",
                            "speaker": "派蒙",
                            "text": "我们还会回来的喔！"
                        },
                        {
                            "id": "705470250",
                            "speaker": "瓦乐瑞娜",
                            "text": "好！我会认认真真等着你们的！"
                        }
                    ]
                }
            ]
        }
    ]
}