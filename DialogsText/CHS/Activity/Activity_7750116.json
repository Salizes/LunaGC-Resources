{
    "talkId": "7750116",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 7,
        "尤维尔": 22
    },
    "dialogues": [
        {
            "id": "775011601",
            "speaker": "尤维尔",
            "text": "真难对付啊，不愧是专业的冒险家，个个都有五六把刷子。",
            "choices": [
                {
                    "id": "775011602",
                    "text": "璃月谚语不是这么用的。",
                    "response": [
                        {
                            "id": "775011603",
                            "speaker": "尤维尔",
                            "text": "啊，我记得原文，但…这些选手都超出常理了，说得夸张点也没事吧？"
                        },
                        {
                            "id": "775011604",
                            "speaker": "尤维尔",
                            "text": "另外，在这个语境下，我觉得纳蒂亚有十把刷子。"
                        },
                        {
                            "id": "775011605",
                            "speaker": "尤维尔",
                            "text": "论比拼射击，她不会输给任何人。"
                        },
                        {
                            "id": "775011606",
                            "speaker": "尤维尔",
                            "text": "只有那个至冬文员能仗着更熟悉铳枪型号，稍微对她有一点点优势。"
                        },
                        {
                            "id": "775011607",
                            "speaker": "尤维尔",
                            "text": "等我找到最厉害的医生，让纳蒂亚不那么健忘，她就能发挥全部实力了…"
                        },
                        {
                            "id": "775011608",
                            "speaker": "尤维尔",
                            "text": "然后我们赚大钱，用一两年攒够摩拉，再也不用每天辛辛苦苦打拼。"
                        }
                    ]
                },
                {
                    "id": "775011609",
                    "text": "你也是选手吗？",
                    "response": [
                        {
                            "id": "775011610",
                            "speaker": "尤维尔",
                            "text": "应该说，是枫丹S级冒险家纳蒂亚的随行人员，嗯，正式登记的身份是她的参谋。"
                        },
                        {
                            "id": "775011611",
                            "speaker": "尤维尔",
                            "text": "自从有次寻宝，和她一起救下了名气很大的冒险家潜水员，接到的委托就越来越多了。"
                        },
                        {
                            "id": "775011612",
                            "speaker": "尤维尔",
                            "text": "后来还被她抓住机会，抓住了漏网的一只什么…「伪装圣剑勒格里斯」。"
                        },
                        {
                            "id": "775011613",
                            "speaker": "尤维尔",
                            "text": "具体情况不太清楚，听说是极其稀有的帽子水母，九成九的潜水员都打不过呢。",
                            "choices": [
                                {
                                    "id": "775011614",
                                    "text": "有印象，是厉害的家伙",
                                    "response": [
                                        {
                                            "id": "775011616",
                                            "speaker": "尤维尔",
                                            "text": "连你也这么觉得吗？那就不奇怪了…"
                                        },
                                        {
                                            "id": "775011617",
                                            "speaker": "尤维尔",
                                            "text": "自那以后，有个叫奥菲利亚的冒险家就总来找纳蒂亚，给她「普通人根本拿不下的委托」。"
                                        },
                                        {
                                            "id": "775011618",
                                            "speaker": "尤维尔",
                                            "text": "纳蒂亚每次都轻轻松松搞定了，我在旁边看的时候，也不觉得有压力。"
                                        },
                                        {
                                            "id": "775011619",
                                            "speaker": "尤维尔",
                                            "text": "再然后，纳蒂亚获得了新的评价——有能力完成S级委托的冒险家，我也跟着沾了光。"
                                        },
                                        {
                                            "id": "775011620",
                                            "speaker": "尤维尔",
                                            "text": "这次来至冬的资金也是奥菲利亚发的，奥菲利亚还给了我一份「交涉原则」，写着枫丹分会很在意的事情。"
                                        },
                                        {
                                            "id": "775011621",
                                            "speaker": "尤维尔",
                                            "text": "之前开会的时候，我就按这个和他们据理力争了，从结果而言，感觉还不错。"
                                        },
                                        {
                                            "id": "775011622",
                                            "speaker": "尤维尔",
                                            "text": "如果最后这事，我和纳蒂亚办妥了，回去还有奖金呢。",
                                            "choices": [
                                                {
                                                    "id": "775011623",
                                                    "text": "这是好事啊。",
                                                    "response": [
                                                        {
                                                            "id": "775011625",
                                                            "speaker": "尤维尔",
                                                            "text": "嗯…但不知为何，我觉得有点不对劲。"
                                                        },
                                                        {
                                                            "id": "775011626",
                                                            "speaker": "尤维尔",
                                                            "text": "应该是我多努力工作，多赚摩拉才对，要让纳蒂亚过得更悠闲自在。"
                                                        },
                                                        {
                                                            "id": "775011627",
                                                            "speaker": "尤维尔",
                                                            "text": "总之，我在至冬看见了许多健壮的家伙，我要向他们请教锻炼的诀窍…"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "775011624",
                                                    "text": "恭喜你们啦。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "775011615",
                                    "text": "不认识，不过名字长应该就强。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011628",
                    "text": "加油喔。",
                    "response": [
                        {
                            "id": "775011629",
                            "speaker": "尤维尔",
                            "text": "啊…谢谢，我会坚持下去的。"
                        }
                    ]
                }
            ]
        }
    ]
}