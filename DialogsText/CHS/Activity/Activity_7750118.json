{
    "talkId": "7750118",
    "total_dialogue_lines": 42,
    "speaker_counts": {
        "Player": 11,
        "玉霞": 31
    },
    "dialogues": [
        {
            "id": "775011801",
            "speaker": "玉霞",
            "text": "冷啊，冷。早知如此，就该把塞琉斯那小子拉过来，让他再练两手。",
            "choices": [
                {
                    "id": "775011802",
                    "text": "比龙脊雪山还冷吗？",
                    "response": [
                        {
                            "id": "775011803",
                            "speaker": "玉霞",
                            "text": "性质不同。"
                        },
                        {
                            "id": "775011804",
                            "speaker": "玉霞",
                            "text": "多重蒸馏后的果酒也能达到和火水相同的度数，但醉人程度不可一概而论。"
                        },
                        {
                            "id": "775011805",
                            "speaker": "玉霞",
                            "text": "以前，我会叮嘱你，如果想去龙脊雪山冒险，要先做好万全的准备再进山。"
                        },
                        {
                            "id": "775011806",
                            "speaker": "玉霞",
                            "text": "你发现了吗？这句话有一个标志性的事件——进山。"
                        },
                        {
                            "id": "775011807",
                            "speaker": "玉霞",
                            "text": "以这个事件为界线，一切开始前，你还有喘口气的余地，做好各种准备的时间，尤其是心理准备。",
                            "choices": [
                                {
                                    "id": "775011808",
                                    "text": "好像还真是。",
                                    "response": [
                                        {
                                            "id": "775011810",
                                            "speaker": "玉霞",
                                            "text": "但至冬不同，踏入这里的第一秒开始，你就再也无法逃脱那种寒冷，而是每时每刻都要被它包裹。"
                                        },
                                        {
                                            "id": "775011811",
                                            "speaker": "玉霞",
                                            "text": "这是对身体和精神的双重考验。"
                                        },
                                        {
                                            "id": "775011812",
                                            "speaker": "玉霞",
                                            "text": "打个比方，蒙德人是下班过后才喝烈酒，酒再难以下喉，临时拼的一桌再无趣，咬咬牙忍过去就算了。"
                                        },
                                        {
                                            "id": "775011813",
                                            "speaker": "玉霞",
                                            "text": "但在至冬，就像每个人都在饮用水里加了火水，不管你喝什么，都会陷入眩晕。",
                                            "choices": [
                                                {
                                                    "id": "775011814",
                                                    "text": "这比喻挺有意思。",
                                                    "response": [
                                                        {
                                                            "id": "775011816",
                                                            "speaker": "玉霞",
                                                            "text": "不对…真有人这么干了。"
                                                        },
                                                        {
                                                            "id": "775011817",
                                                            "speaker": "玉霞",
                                                            "text": "我刚到海屑镇吃饭的时候，水里就有火水来着…"
                                                        },
                                                        {
                                                            "id": "775011818",
                                                            "speaker": "玉霞",
                                                            "text": "是他们自己搞错了，还是他们的待客之道当真如此？"
                                                        },
                                                        {
                                                            "id": "775011819",
                                                            "speaker": "玉霞",
                                                            "text": "不能再想了…特大失误！确实应该拉塞琉斯那小子过来狠狠历练的！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "775011815",
                                                    "text": "这比喻有点恐怖。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "775011809",
                                    "text": "以前没留意…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011820",
                    "text": "比赛状况如何？",
                    "response": [
                        {
                            "id": "775011821",
                            "speaker": "玉霞",
                            "text": "呃…老了，打不动，"
                        },
                        {
                            "id": "775011822",
                            "speaker": "玉霞",
                            "text": "只能看小霍最后的成绩了。"
                        },
                        {
                            "id": "775011823",
                            "speaker": "玉霞",
                            "text": "当然，她肯定是不如你的，但根据艾尔菲提供的综合情报来看，她应该能争个亚军。",
                            "choices": [
                                {
                                    "id": "775011824",
                                    "text": "小…小霍？",
                                    "response": [
                                        {
                                            "id": "775011826",
                                            "speaker": "玉霞",
                                            "text": "哦，也就是你们口中的岚姐。我比她大十…"
                                        },
                                        {
                                            "id": "775011827",
                                            "speaker": "玉霞",
                                            "text": "大那么几岁，所以叫她姐不太合适，还是叫小霍，或者小岚好了。"
                                        },
                                        {
                                            "id": "775011828",
                                            "speaker": "玉霞",
                                            "text": "她头一回来蒙德的时候，看起来和现在的你差不多年轻呢。"
                                        },
                                        {
                                            "id": "775011829",
                                            "speaker": "玉霞",
                                            "text": "那会儿的玛格丽特也是个莽撞的小姑娘，上错了酒，还被老板骂了一顿。"
                                        },
                                        {
                                            "id": "775011830",
                                            "speaker": "玉霞",
                                            "text": "玛格丽特就哇哇哭着说，我以后也要当老板，想骂谁就骂谁！"
                                        },
                                        {
                                            "id": "775011831",
                                            "speaker": "玉霞",
                                            "text": "小岚在旁边起哄，说那我以后成了知名冒险家，带一大队璃月的朋友来给你捧场！"
                                        },
                                        {
                                            "id": "775011832",
                                            "speaker": "玉霞",
                                            "text": "但，玛格丽特现在当上酒馆老板了，她还是那么开朗。"
                                        },
                                        {
                                            "id": "775011833",
                                            "speaker": "玉霞",
                                            "text": "小岚在她哥哥不知去向后，就再也没有那么笑过了。",
                                            "choices": [
                                                {
                                                    "id": "775011834",
                                                    "text": "那你们确实认识很久了。",
                                                    "response": [
                                                        {
                                                            "id": "775011835",
                                                            "speaker": "玉霞",
                                                            "text": "是吧，平常不怎么来往，但每隔半年多，有机会见面，都无话不谈，喝个天昏地暗…"
                                                        },
                                                        {
                                                            "id": "775011838",
                                                            "speaker": "玉霞",
                                                            "text": "咳咳，好像有些聊得太远了，先收住吧…"
                                                        },
                                                        {
                                                            "id": "775011839",
                                                            "speaker": "玉霞",
                                                            "text": "总之，这次来至冬，小岚反而给我一种感觉，她的心情好得出奇。"
                                                        },
                                                        {
                                                            "id": "775011840",
                                                            "speaker": "玉霞",
                                                            "text": "也不知道她遇见什么好事了，就祝她一直好运下去吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "775011836",
                                                    "text": "那岚姐其实也蛮老的啊。",
                                                    "response": [
                                                        {
                                                            "id": "775011837",
                                                            "speaker": "玉霞",
                                                            "text": "？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "775011825",
                                    "text": "谁…谁啊？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011841",
                    "text": "我支持。",
                    "response": [
                        {
                            "id": "775011842",
                            "speaker": "玉霞",
                            "text": "对吧？下次你去蒙德分会，直接打晕他扛过来，就说我同意的。"
                        }
                    ]
                }
            ]
        }
    ]
}