    "dialogues": [
        {
            "id": "705270201",
            "speaker": "娜扎法琳",
            "text": "噢，我的小吉祥草王啊。真是太感谢二位大人了。",
            "choices": [
                {
                    "id": "705270202",
                    "text": "能再说一遍这口锅的用法吗？",
                    "response": [
                        {
                            "id": "705270203",
                            "speaker": "娜扎法琳",
                            "text": "噢噢，是我考虑不周到了。您这样的大英雄，肯定非常忙碌，不记得也是理所当然的。"
                        },
                        {
                            "id": "705270204",
                            "speaker": "娜扎法琳",
                            "text": "其实非常简单，只要在正确的时机加入正确的配料就行。"
                        },
                        {
                            "id": "705270205",
                            "speaker": "娜扎法琳",
                            "text": "您那么优秀，肯定试一次就会了。"
                        }
                    ]
                },
                {
                    "id": "705270206",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "705270207",
                            "speaker": "娜扎法琳",
                            "text": "再见。再次感谢您，拯救娜扎法琳的大英雄！预祝您顺顺利利。"
                        }
                    ]
                }
            ]
        }
    ]
}