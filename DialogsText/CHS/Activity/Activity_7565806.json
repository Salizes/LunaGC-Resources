{
    "talkId": "7565806",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 4,
        "赫卡": 6
    },
    "dialogues": [
        {
            "id": "756580601",
            "speaker": "赫卡",
            "text": "准备好挑战巨大水团了吗？",
            "choices": [
                {
                    "id": "756580602",
                    "text": "现在准备一下。"
                },
                {
                    "id": "756580603",
                    "text": "想随便聊聊…",
                    "response": [
                        {
                            "id": "756580604",
                            "speaker": "赫卡",
                            "text": "水的意志也会以这样的形式显现…原来如此。真不可思议，它看起来并不像是没有灵魂的样子。"
                        },
                        {
                            "id": "756580605",
                            "speaker": "赫卡",
                            "text": "卡嘉讲过一个故事，一个渔夫爱上了纯水的精怪，但精怪是没有灵魂的，于是渔夫踏上旅途，只为舍弃他自己的灵魂…"
                        },
                        {
                            "id": "756580606",
                            "speaker": "Player",
                            "text": "关于卡嘉…"
                        },
                        {
                            "id": "756580607",
                            "speaker": "赫卡",
                            "text": "她以前也是很厉害的冒险者，走南闯北去过很多地方，后来因为伤病告别了冒险生涯，就在那夏镇定居下来。"
                        },
                        {
                            "id": "756580608",
                            "speaker": "赫卡",
                            "text": "她一直很照顾我们，在我出发之前也给了我很多实用的建议…我很敬佩她，也很感谢她。"
                        },
                        {
                            "id": "756580609",
                            "speaker": "赫卡",
                            "text": "对了，如果有机会，一定要尝尝她的手艺！"
                        }
                    ]
                },
                {
                    "id": "756580610",
                    "text": "稍等。"
                }
            ]
        }
    ]
}