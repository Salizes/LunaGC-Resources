    "dialogues": [
        {
            "id": "711570312",
            "speaker": "嘉明",
            "text": "哇…这编霄灯的手艺真是不简单…蓝砚平时到底怎么弄的…"
        },
        {
            "id": "711570313",
            "speaker": "嘉明",
            "text": "#{NICKNAME}？节日好呀，恭喜发财，恭喜发财啊。",
            "choices": [
                {
                    "id": "711570320",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711570321",
                            "speaker": "嘉明",
                            "text": "好漂亮的霄灯啊…哎哟，对了对了，等会我还要去给镖局里的兄弟们买几盏霄灯。"
                        },
                        {
                            "id": "711570322",
                            "speaker": "嘉明",
                            "text": "他们刚押了一趟急镖回来，肯定没空准备这些…",
                            "choices": [
                                {
                                    "id": "711570314",
                                    "text": "一起发财一起发财",
                                    "response": [
                                        {
                                            "id": "711570316",
                                            "speaker": "嘉明",
                                            "text": "是呀，花了我不少功夫，总算快做出来一盏好看的灯了。"
                                        },
                                        {
                                            "id": "711570317",
                                            "speaker": "嘉明",
                                            "text": "我还打算在上面画文仔呢，对了，还要给老爹也做一盏呢。"
                                        },
                                        {
                                            "id": "711570318",
                                            "speaker": "嘉明",
                                            "text": "唔，感觉差不多了…接下来就是把霄灯放飞出去了…"
                                        },
                                        {
                                            "id": "711570319",
                                            "speaker": "Black Screen",
                                            "text": "与嘉明一同放飞了霄灯…"
                                        }
                                    ]
                                },
                                {
                                    "id": "711570315",
                                    "text": "你也打算做霄灯？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711570314",
                    "text": "一起发财一起发财"
                },
                {
                    "id": "711570315",
                    "text": "你也打算做霄灯？"
                }
            ]
        }
