{
    "talkId": "7751104",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "莉琉": 8
    },
    "dialogues": [
        {
            "id": "775110401",
            "speaker": "莉琉",
            "text": "完全没有意外地败给你了，你的各种奖杯应该已经多到连长颈角犀都扛不动了吧…",
            "choices": [
                {
                    "id": "775110402",
                    "text": "再复盘一下解谜项目。",
                    "response": [
                        {
                            "id": "775110403",
                            "speaker": "莉琉",
                            "text": "没问题，我也跟着复习一下。"
                        }
                    ]
                },
                {
                    "id": "775110404",
                    "text": "接下来有什么打算？",
                    "response": [
                        {
                            "id": "775110405",
                            "speaker": "莉琉",
                            "text": "这边实在太冷，哪怕我是「烟谜主」的人，都有点吃不消，最多再待两周。"
                        },
                        {
                            "id": "775110406",
                            "speaker": "莉琉",
                            "text": "回去以后，要好好和莉莱、莎孚聊聊这边的趣闻。"
                        },
                        {
                            "id": "775110407",
                            "speaker": "莉琉",
                            "text": "还有那位神奇酒保的杰作…不知能打包吗？"
                        },
                        {
                            "id": "775110408",
                            "speaker": "莉琉",
                            "text": "哦，还有，我打算给奶奶和卡齐娜带点至冬最贵的甜点，你在这边的夸张表现，我也会告诉她们的。"
                        },
                        {
                            "id": "775110409",
                            "speaker": "莉琉",
                            "text": "当然，如果你想低调点，或者自己亲口和她们说，我绝对闭口不谈。"
                        }
                    ]
                },
                {
                    "id": "775110410",
                    "text": "不至于，我回去数数。",
                    "response": [
                        {
                            "id": "775110411",
                            "speaker": "莉琉",
                            "text": "那下次见面了，记得告诉我啊。"
                        }
                    ]
                }
            ]
        }
    ]
}