    "dialogues": [
        {
            "id": "401710801",
            "speaker": "欧洛伦",
            "text": "#{NICKNAME}，这几天还要继续辛苦你聚集游灵了，用这个香炉就好，奶奶在上面留下了法术。",
            "choices": [
                {
                    "id": "401710802",
                    "text": "关于灵性织机…",
                    "response": [
                        {
                            "id": "401710803",
                            "speaker": "欧洛伦",
                            "text": "噢，你喜欢玩那个吗？可以随时试试，里面应该有别的暝视记录。你可以把它们都拼接到织物上。还挺有趣的。"
                        },
                        {
                            "id": "401710804",
                            "speaker": "欧洛伦",
                            "text": "不用担心别的，既然奶奶把它留在这里，应该就有给你练手的意思。"
                        }
                    ]
                },
                {
                    "id": "401710805",
                    "text": "关于烬寂海…",
                    "response": [
                        {
                            "id": "401710806",
                            "speaker": "欧洛伦",
                            "text": "烬寂海？据我所知，那里不适合蔬菜生长。"
                        },
                        {
                            "id": "401710807",
                            "speaker": "欧洛伦",
                            "text": "我怎么知道的？是奶奶说的啦，要是你想了解更多，还是等奶奶来了问她比较好。"
                        },
                        {
                            "id": "401710808",
                            "speaker": "欧洛伦",
                            "text": "奶奶家里有一些相关的织卷，只是我对种不出蔬菜的地方实在提不起兴趣，所以一幅都没看过，真对不起。"
                        }
                    ]
                }
            ]
        }
    ]
}