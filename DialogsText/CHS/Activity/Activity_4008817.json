{
    "talkId": "4008817",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "伯恩哈德": 7
    },
    "dialogues": [
        {
            "id": "400881701",
            "speaker": "伯恩哈德",
            "text": "店铺的布置就交给我了，请你们放手去干，筹备开店所需的资金吧！",
            "choices": [
                {
                    "id": "400881702",
                    "text": "关于筹备资金的方式…",
                    "response": [
                        {
                            "id": "400881703",
                            "speaker": "伯恩哈德",
                            "text": "帮附近的客人向酒商们砍价下单，赚取辛苦费，或是向酒商们提供酿酒原料，赚取资金…"
                        },
                        {
                            "id": "400881704",
                            "speaker": "伯恩哈德",
                            "text": "这两种方法都没问题，请凭你们的习惯决定先后次序吧。"
                        }
                    ]
                },
                {
                    "id": "400881705",
                    "text": "关于抽签选取负责人…",
                    "response": [
                        {
                            "id": "400881706",
                            "speaker": "伯恩哈德",
                            "text": "嗯…负责人采取随机抽签机制，原本是为了给每个骑士机会…加强我们和民众的交流…"
                        },
                        {
                            "id": "400881707",
                            "speaker": "伯恩哈德",
                            "text": "要我干活还行。但要我决定方向，制定计划…我就生怕搞砸…"
                        },
                        {
                            "id": "400881708",
                            "speaker": "伯恩哈德",
                            "text": "还好有荣誉骑士你出面！可以说是拯救了义卖活动，拯救了我啊！"
                        }
                    ]
                },
                {
                    "id": "400881709",
                    "text": "那我先去试试！",
                    "response": [
                        {
                            "id": "400881710",
                            "speaker": "伯恩哈德",
                            "text": "好的！期待你的捷报！"
                        }
                    ]
                }
            ]
        }
    ]
}