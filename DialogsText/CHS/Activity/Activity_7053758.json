{
    "talkId": "7053758",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "哲俩阿": 15,
        "派蒙": 3
    },
    "dialogues": [
        {
            "id": "705375801",
            "speaker": "Player",
            "text": "又见面了…"
        },
        {
            "id": "705375802",
            "speaker": "哲俩阿",
            "text": "啊！是你们两位！"
        },
        {
            "id": "705375803",
            "speaker": "哲俩阿",
            "text": "对不起！我在说到放生的时候，就应该主动给你们跪下认错的…"
        },
        {
            "id": "705375804",
            "speaker": "哲俩阿",
            "text": "我完全没想到，我放生的那些「角鲀」在果酒湖里没有天敌，很快就繁衍了一大堆，差点把本地的生态给搞坏！"
        },
        {
            "id": "705375805",
            "speaker": "派蒙",
            "text": "咦…呃…嗯…虽然你确实做了对蒙德不利的事啦，但为什么要对我们两个认错？"
        },
        {
            "id": "705375806",
            "speaker": "哲俩阿",
            "text": "因为我给你们添了很大的麻烦啊！让你们跑到那么远的地方把我捉拿归案…扛着我走回蒙德城应该很累吧！"
        },
        {
            "id": "705375807",
            "speaker": "哲俩阿",
            "text": "如果我能早点醒悟，直接跟着你们走回蒙德城去自首…不对，应该是放生后就意识到问题，直接把自己打包送到骑士团去…"
        },
        {
            "id": "705375808",
            "speaker": "哲俩阿",
            "text": "那就不用让你们花费这么多心力了，也不至于让骑士团调动那么多人手来追查我。",
            "choices": [
                {
                    "id": "705375809",
                    "text": "认罪和后悔的态度就该这么诚恳！",
                    "response": [
                        {
                            "id": "705375811",
                            "speaker": "派蒙",
                            "text": "一开始就别相信那些传闻，别草率地放生，肯定也不会出现这么多问题了…"
                        },
                        {
                            "id": "705375812",
                            "speaker": "哲俩阿",
                            "text": "确实…"
                        },
                        {
                            "id": "705375813",
                            "speaker": "哲俩阿",
                            "text": "前不久，我才从骑士团总部出来，被罚了一大笔钱，还被教育了一顿…"
                        },
                        {
                            "id": "705375814",
                            "speaker": "哲俩阿",
                            "text": "还好蒙德的骑士们都特别可靠，及时控制住了事态，不然…不然我就成千古罪人了！"
                        },
                        {
                            "id": "705375815",
                            "speaker": "哲俩阿",
                            "text": "虽然骑士们没有凶我，只是在给我耐心地讲道理…"
                        },
                        {
                            "id": "705375816",
                            "speaker": "哲俩阿",
                            "text": "蒙德人也都特别友善，即便对于犯下了过错的我，也没有特别凶…"
                        },
                        {
                            "id": "705375817",
                            "speaker": "哲俩阿",
                            "text": "有个红色衣服的小女孩，看我在路边哭着走，还送了我好多点心安慰我…"
                        },
                        {
                            "id": "705375818",
                            "speaker": "哲俩阿",
                            "text": "但我自己心里非常过意不去，特别特别后悔！"
                        },
                        {
                            "id": "705375819",
                            "speaker": "派蒙",
                            "text": "唔，你能意识到错误就好，反正现在问题已经被解决了，你也不用太难过了！",
                            "choices": [
                                {
                                    "id": "705375820",
                                    "text": "以后不要再随便放生了哦。",
                                    "response": [
                                        {
                                            "id": "705375822",
                                            "speaker": "哲俩阿",
                                            "text": "我！我一定牢记这次的教训！"
                                        },
                                        {
                                            "id": "705375823",
                                            "speaker": "哲俩阿",
                                            "text": "要不然，还是再免费赠送一批货物给蒙德人好了…再去给那些受到影响的蒙德居民挨个道歉…"
                                        }
                                    ]
                                },
                                {
                                    "id": "705375821",
                                    "text": "也记得提醒你的朋友们哦。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705375810",
                    "text": "突然出手的我倒有点不好意思了…"
                }
            ]
        }
    ]
}