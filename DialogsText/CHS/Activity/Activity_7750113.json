{
    "talkId": "7750113",
    "total_dialogue_lines": 32,
    "speaker_counts": {
        "Player": 8,
        "莉琉": 24
    },
    "dialogues": [
        {
            "id": "775011301",
            "speaker": "莉琉",
            "text": "哎呀，我们闪耀的「杜麦尼」啊，居然都来参赛了，那赛况可要大洗牌啦，没准我就第一个被打出排行榜…",
            "choices": [
                {
                    "id": "775011302",
                    "text": "我先开始解谜挑战吧。",
                    "response": [
                        {
                            "id": "775011303",
                            "speaker": "莉琉",
                            "text": "这个我不太擅长，看你演示，和你学学。"
                        }
                    ]
                },
                {
                    "id": "775011304",
                    "text": "你有点面善…",
                    "response": [
                        {
                            "id": "775011305",
                            "speaker": "莉琉",
                            "text": "看来还真忘记我了…"
                        },
                        {
                            "id": "775011306",
                            "speaker": "莉琉",
                            "text": "之前最后一次「归火圣夜巡礼」的比赛上，你的徒弟卡齐娜就把我打败了。"
                        },
                        {
                            "id": "775011307",
                            "speaker": "莉琉",
                            "text": "最近每次见到卡齐娜，她都在念叨「听说师父又在别的国家变厉害了…」"
                        },
                        {
                            "id": "775011308",
                            "speaker": "莉琉",
                            "text": "有勇气是好事，但有时也要知道自己的斤两，别挑战自己连背影都望不到的强者。",
                            "choices": [
                                {
                                    "id": "775011309",
                                    "text": "你和卡齐娜见面了？",
                                    "response": [
                                        {
                                            "id": "775011311",
                                            "speaker": "莉琉",
                                            "text": "喂喂，放松点，杜麦尼大人。"
                                        },
                                        {
                                            "id": "775011312",
                                            "speaker": "莉琉",
                                            "text": "只是在楚汶市集巧遇，顺势请她吃了顿饭而已，难道还能把她掳走不成？"
                                        },
                                        {
                                            "id": "775011313",
                                            "speaker": "莉琉",
                                            "text": "被打败一次就要不停找别人茬的家伙，可不配成为部族战士啊。"
                                        },
                                        {
                                            "id": "775011314",
                                            "speaker": "莉琉",
                                            "text": "而且，我还在和卡齐娜学「回声之子」的舞步呢，现在我对卡齐娜只有敬重之心。"
                                        },
                                        {
                                            "id": "775011315",
                                            "speaker": "莉琉",
                                            "text": "如有半分心术不正，我就该吃火神大人一剑，去阿伽娅面前跪着忏悔，直到永远。"
                                        }
                                    ]
                                },
                                {
                                    "id": "775011310",
                                    "text": "你把我徒弟怎么了？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011316",
                    "text": "你有点谦虚了，老战士。",
                    "response": [
                        {
                            "id": "775011317",
                            "speaker": "莉琉",
                            "text": "做出合理的实力评估，及时知难而退，才是老战士应有的表现。"
                        },
                        {
                            "id": "775011318",
                            "speaker": "莉琉",
                            "text": "以前我仗着资历老，装备好，经验稍微多了那么一点，总是看不起年轻的对手。"
                        },
                        {
                            "id": "775011319",
                            "speaker": "莉琉",
                            "text": "结果被卡齐娜好好教训后，头都抬不起来，消沉了很久…"
                        },
                        {
                            "id": "775011320",
                            "speaker": "莉琉",
                            "text": "整场大战期间，我也只干掉了三百来只深渊魔物，实在丢人。"
                        },
                        {
                            "id": "775011321",
                            "speaker": "莉琉",
                            "text": "战后，黑曜石奶奶又狠狠教训了我一顿，我才真正打起精神来，开始承接冒险家协会的战斗委托，恢复身手，加强学习…",
                            "choices": [
                                {
                                    "id": "775011322",
                                    "text": "可你成了S级冒险家…",
                                    "response": [
                                        {
                                            "id": "775011324",
                                            "speaker": "莉琉",
                                            "text": "话不能这么说，冒险是一门综合性的技术，和正面战场有许多不同之处。"
                                        },
                                        {
                                            "id": "775011325",
                                            "speaker": "莉琉",
                                            "text": "这些日子以来，我将许多战斗技术交给协会的年轻冒险家们，换来了各种生活和探险的诀窍。"
                                        },
                                        {
                                            "id": "775011326",
                                            "speaker": "莉琉",
                                            "text": "像瓦乐瑞娜小姐这样的帮手，也让我找到了莉莱和莎孚一直想要的古早乐稿…"
                                        },
                                        {
                                            "id": "775011327",
                                            "speaker": "莉琉",
                                            "text": "多亏他们，我才深刻理解，每一代的年轻人里，都会涌现出资质如宝石般的人才。"
                                        },
                                        {
                                            "id": "775011328",
                                            "speaker": "莉琉",
                                            "text": "只要参考了我们这些前辈的经验和教训，年轻人的上限一直越来越高。"
                                        },
                                        {
                                            "id": "775011329",
                                            "speaker": "莉琉",
                                            "text": "那么…在你的教导下，还有一众古名持有者们影响下成长的卡齐娜…"
                                        },
                                        {
                                            "id": "775011330",
                                            "speaker": "莉琉",
                                            "text": "再过几年，就会成长得连我都需要仰望吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "775011323",
                                    "text": "不止是加强学习吧…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011331",
                    "text": "我也得认真比赛，好好表现。",
                    "response": [
                        {
                            "id": "775011332",
                            "speaker": "莉琉",
                            "text": "我支持，卡齐娜也深刻地教会了我，不管资历多老实力多悬殊，都该把尊重对手放在比赛的首位。"
                        }
                    ]
                }
            ]
        }
    ]
}