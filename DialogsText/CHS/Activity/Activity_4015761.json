            "speaker": "Player",
            "text": "<color=#FFCC33FF>想邀请你去参加音乐庆典。</color>"
        },
        {
            "id": "401576102",
            "speaker": "星稀",
            "text": "音乐庆典？谢谢，我确实有收集旋曜玉帛的习惯…"
        },
        {
            "id": "401576103",
            "speaker": "派蒙",
            "text": "那你一定有喜欢的音乐吧？我们可以弹给你听，我们是认真的音乐交流哦。"
        },
        {
            "id": "401576104",
            "speaker": "星稀",
            "text": "欸？真的嘛…那有一首曲子，我可以把旋律哼出来，可以弹给我听听看吗？"
        },
        {
            "id": "401576105",
            "speaker": "Player",
            "text": "我来试试。"
        },
        {
            "id": "401576106",
            "speaker": "星稀",
            "text": "劳您费神了。"
        }
    ]
