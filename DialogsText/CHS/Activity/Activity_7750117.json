{
    "talkId": "7750117",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 11,
        "塔拉利欣": 24
    },
    "dialogues": [
        {
            "id": "775011701",
            "speaker": "塔拉利欣",
            "text": "#您好，{NICKNAME}，再次感谢您参与「首届冒险家竞技大赛」。",
            "choices": [
                {
                    "id": "775011702",
                    "text": "再介绍一下自己？",
                    "response": [
                        {
                            "id": "775011703",
                            "speaker": "塔拉利欣",
                            "text": "啊，其实之前打招呼时所说的就是全部了…"
                        },
                        {
                            "id": "775011704",
                            "speaker": "塔拉利欣",
                            "text": "我叫塔拉利欣·果戈里，是冒险家协会总部的一名普通文员。",
                            "choices": [
                                {
                                    "id": "775011705",
                                    "text": "但你的排行榜分值不低啊？",
                                    "response": [
                                        {
                                            "id": "775011707",
                                            "speaker": "塔拉利欣",
                                            "text": "只是因为熟悉这方面的工作，被派来凑人头，然后运气好罢了。"
                                        },
                                        {
                                            "id": "775011708",
                                            "speaker": "塔拉利欣",
                                            "text": "另外，也有一些东道主的优势，毕竟这些竞技项目对于至冬冒险家而言，更容易上手。"
                                        }
                                    ]
                                },
                                {
                                    "id": "775011706",
                                    "text": "普通文员能打出这种名次？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011709",
                    "text": "你和岚姐很熟？",
                    "response": [
                        {
                            "id": "775011710",
                            "speaker": "塔拉利欣",
                            "text": "谈不上很熟，论资历，我是岚姐的后辈。"
                        },
                        {
                            "id": "775011711",
                            "speaker": "塔拉利欣",
                            "text": "但这回，我和岚姐要在赛场之外并肩作战。",
                            "choices": [
                                {
                                    "id": "775011712",
                                    "text": "怎么说？",
                                    "response": [
                                        {
                                            "id": "775011714",
                                            "speaker": "塔拉利欣",
                                            "text": "不知，您可曾记得「藏锋」这个剑名？"
                                        },
                                        {
                                            "id": "775011715",
                                            "speaker": "塔拉利欣",
                                            "text": "璃月分会长岚姐，担任璃月冒险家协会分会长后从未有过败绩的「青墟寻剑人」霍岚岭。"
                                        },
                                        {
                                            "id": "775011716",
                                            "speaker": "塔拉利欣",
                                            "text": "她此行的重要目的，还有一个人——「藏锋」的原主。",
                                            "choices": [
                                                {
                                                    "id": "775011717",
                                                    "text": "我不太了解岚姐的情况…",
                                                    "response": [
                                                        {
                                                            "id": "775011718",
                                                            "speaker": "塔拉利欣",
                                                            "text": "那，如果不介意的话，请容我占用您几分钟的时间，简单介绍一下。"
                                                        },
                                                        {
                                                            "id": "775011721",
                                                            "speaker": "塔拉利欣",
                                                            "text": "在找人这件事上，我与岚姐利益一致。"
                                                        },
                                                        {
                                                            "id": "775011722",
                                                            "speaker": "塔拉利欣",
                                                            "text": "因为…"
                                                        },
                                                        {
                                                            "id": "775011723",
                                                            "speaker": "塔拉利欣",
                                                            "text": "岚姐的兄长霍朝晖大师，曾与我的叔父一同驰骋在至冬的冰原上。"
                                                        },
                                                        {
                                                            "id": "775011724",
                                                            "speaker": "塔拉利欣",
                                                            "text": "他们想要找到「至坚之物」，锻造心目中最为完美的兵刃，练就武人与兵刃融为一体的战斗流派。"
                                                        },
                                                        {
                                                            "id": "775011725",
                                                            "speaker": "塔拉利欣",
                                                            "text": "结果，两人都被卷入一起「影域」的意外，至今不知所踪。",
                                                            "choices": [
                                                                {
                                                                    "id": "775011726",
                                                                    "text": "我第一次听说这件事…",
                                                                    "response": [
                                                                        {
                                                                            "id": "775011728",
                                                                            "speaker": "塔拉利欣",
                                                                            "text": "很正常，因为那起意外实在扑朔迷离，相关的调查报告比一本字典还厚。"
                                                                        },
                                                                        {
                                                                            "id": "775011729",
                                                                            "speaker": "塔拉利欣",
                                                                            "text": "最近，整份报告才被彻底核查，确认信息「相对准确」，由特殊任务营向冒险家协会共享。"
                                                                        },
                                                                        {
                                                                            "id": "775011730",
                                                                            "speaker": "塔拉利欣",
                                                                            "text": "这次大赛结束后，我还会根据协会的委托，汇总这些信息，制作一套模拟「影域」战斗的思维训练。"
                                                                        },
                                                                        {
                                                                            "id": "775011731",
                                                                            "speaker": "塔拉利欣",
                                                                            "text": "如果你有兴趣的话，到时也可以到总部附近找我。"
                                                                        },
                                                                        {
                                                                            "id": "775011732",
                                                                            "speaker": "塔拉利欣",
                                                                            "text": "无论从协会的发展，还是我个人的厉害角度出发，我都会尽力帮助岚姐，寻找她兄长的下落。"
                                                                        },
                                                                        {
                                                                            "id": "775011733",
                                                                            "speaker": "塔拉利欣",
                                                                            "text": "说不定，我也有望找回我的叔父，让我的整个家族摆脱持续几年的悲伤。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "775011727",
                                                                    "text": "岚姐以前不知道这件事？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "775011719",
                                                    "text": "我似乎与她寻找过这把剑…",
                                                    "response": [
                                                        {
                                                            "id": "775011720",
                                                            "speaker": "塔拉利欣",
                                                            "text": "看来您还有印象，最近她提起过与你合作寻剑的往事，情绪非常振奋。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "775011713",
                                    "text": "还有别的合作？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011734",
                    "text": "你也辛苦了。",
                    "response": [
                        {
                            "id": "775011735",
                            "speaker": "塔拉利欣",
                            "text": "多谢安慰，这是我的工作，我会尽力而为。"
                        }
                    ]
                }
            ]
        }
    ]
}