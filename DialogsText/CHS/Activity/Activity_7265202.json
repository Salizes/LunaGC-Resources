    "speaker_counts": {
        "Player": 2,
        "慕珍": 5
    },
    "dialogues": [
        {
            "id": "726520201",
            "speaker": "慕珍",
            "text": "唉，跟着北斗大姐头走遍七国，才觉得还是璃月老家好…"
        },
        {
            "id": "726520202",
            "speaker": "慕珍",
            "text": "嘿嘿，虽说我也没怎么下过船。"
        },
        {
            "id": "726520203",
            "speaker": "Player",
            "text": "关于北斗的下一段航程…"
        },
        {
            "id": "726520204",
            "speaker": "慕珍",
            "text": "抱歉，保密！我只能告诉你，我们接下来会去须弥。"
        },
        {
            "id": "726520205",
            "speaker": "慕珍",
            "text": "别的我就不多说啦，我也建议你别多问。"
        },
        {
            "id": "726520206",
            "speaker": "Player",
            "text": "再见。"
        },
        {
            "id": "726520207",
            "speaker": "慕珍",
            "text": "嗯嗯，一路顺风！"
        }
    ]
}