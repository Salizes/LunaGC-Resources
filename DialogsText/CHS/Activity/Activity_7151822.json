    "dialogues": [
        {
            "id": "715182201",
            "speaker": "嘉义",
            "text": "千岩牢固，重嶂不移。"
        },
        {
            "id": "715182202",
            "speaker": "嘉义",
            "text": "你看过音乐节的演出了吗？乐声真响亮啊，感觉比霄灯飘得更遥远。"
        },
        {
            "id": "715182203",
            "speaker": "嘉义",
            "text": "…也不知道站在轻策庄的山坡上，能不能听到乐声…"
        },
        {
            "id": "715182204",
            "speaker": "嘉义",
            "text": "唉…小六，爸爸好想你啊…"
        }
    ]
}