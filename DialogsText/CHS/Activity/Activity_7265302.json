    "speaker_counts": {
        "Player": 2,
        "慕珍": 7,
        "派蒙": 1
    },
    "dialogues": [
        {
            "id": "726530201",
            "speaker": "慕珍",
            "text": "现在的话，大致能够判断遗迹机械所在的范围…但还没办法确切定位。",
            "choices": [
                {
                    "id": "726530202",
                    "text": "岸上风景如何？",
                    "response": [
                        {
                            "id": "726530203",
                            "speaker": "慕珍",
                            "text": "你说这里吗？比起船舱里，视野倒是开阔了不少…挺不错的。"
                        },
                        {
                            "id": "726530204",
                            "speaker": "慕珍",
                            "text": "唔，不过我不太喜欢岸上的空气，比起船舱里的空气少了点「料」…让我脑袋都慢了半拍。"
                        },
                        {
                            "id": "726530205",
                            "speaker": "慕珍",
                            "text": "嗯…岸上适合观景，但不适合思考。"
                        },
                        {
                            "id": "726530208",
                            "speaker": "慕珍",
                            "text": "所以我才在这里无所事事嘛，接下来全看你的了！"
                        },
                        {
                            "id": "726530209",
                            "speaker": "派蒙",
                            "text": "这家伙，一点没有求人的自觉吗！"
                        },
                        {
                            "id": "726530210",
                            "speaker": "慕珍",
                            "text": "嘿嘿~"
                        }
                    ]
                },
                {
                    "id": "726530206",
                    "text": "研究进展如何？",
                    "response": [
                        {
                            "id": "726530207",
                            "speaker": "慕珍",
                            "text": "不太好。唔，准确点说，是停滞。"
                        }
                    ]
                }
            ]
        }
    ]
}