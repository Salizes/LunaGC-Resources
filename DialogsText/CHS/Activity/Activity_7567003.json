{
    "talkId": "7567003",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "克维库": 10
    },
    "dialogues": [
        {
            "id": "756700301",
            "speaker": "克维库",
            "text": "想来试试看吗？龙伙伴们都已经准备好了呢。",
            "choices": [
                {
                    "id": "756700302",
                    "text": "好呀，我也准备好了。",
                    "response": [
                        {
                            "id": "756700303",
                            "speaker": "克维库",
                            "text": "来吧！这体验不会让你失望的！"
                        }
                    ]
                },
                {
                    "id": "756700304",
                    "text": "有些不够玩。",
                    "response": [
                        {
                            "id": "756700305",
                            "speaker": "克维库",
                            "text": "真的吗？实不相瞒，在去「回声之子」前，我的心都还在打鼓，万一没有人愿意尝试…"
                        },
                        {
                            "id": "756700306",
                            "speaker": "克维库",
                            "text": "倒也不是担心其他的，我只是有时候看到那些小家伙们亮亮的眼睛，就总是觉得不得劲，这让我想起了我的老伙计…"
                        },
                        {
                            "id": "756700307",
                            "speaker": "克维库",
                            "text": "它是条好龙…噢，特别活泼，你不陪它玩的时候，它就围着你绕来绕去，就像一个好奇的小宝宝一样…"
                        },
                        {
                            "id": "756700308",
                            "speaker": "克维库",
                            "text": "还有科米娜小姐——有时候没有她，我都不知道下一步该怎么办好了。"
                        },
                        {
                            "id": "756700309",
                            "speaker": "克维库",
                            "text": "但现在有你的肯定，我就安心多啦，至少看在你的份上，都会有许多人愿意尝试吧。",
                            "choices": [
                                {
                                    "id": "756700310",
                                    "text": "没有我也是一样的。",
                                    "response": [
                                        {
                                            "id": "756700312",
                                            "speaker": "克维库",
                                            "text": "啊哈哈哈哈…不论如何，你还是帮我们大忙了。"
                                        },
                                        {
                                            "id": "756700313",
                                            "speaker": "克维库",
                                            "text": "等到下次我想出新的关卡，我一定邀请你来第一个尝试。"
                                        }
                                    ]
                                },
                                {
                                    "id": "756700311",
                                    "text": "与龙同游的魅力很难抵抗。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756700314",
                    "text": "我先热热身再来。",
                    "response": [
                        {
                            "id": "756700315",
                            "speaker": "克维库",
                            "text": "啊，在运动前进行适当的热身是正确的…总之，你想玩了就来找我，我随时都在。"
                        }
                    ]
                }
            ]
        }
    ]
}