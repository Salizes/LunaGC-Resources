    "dialogues": [
        {
            "id": "716680501",
            "speaker": "振尘",
            "text": "找到动物们了吗？",
            "choices": [
                {
                    "id": "716680502",
                    "text": "找到了。",
                    "response": [
                        {
                            "id": "716680503",
                            "speaker": "振尘",
                            "text": "哈哈，那你应该也收到认养人们准备的礼物和信了吧。"
                        },
                        {
                            "id": "716680504",
                            "speaker": "振尘",
                            "text": "这几位认养人非常热心，了解我们打算做的事之后，主动找到我们传达了支持。"
                        },
                        {
                            "id": "716680505",
                            "speaker": "振尘",
                            "text": "能得到你的回礼，我想他们也会开心的。"
                        }
                    ]
                },
                {
                    "id": "716680506",
                    "text": "还没有。",
                    "response": [
                        {
                            "id": "716680507",
                            "speaker": "拉米雅",
                            "text": "「铭随流镜」的影像信号还是足够清晰的，只不过得费点功夫分析环境画面。"
                        },
                        {
                            "id": "716680508",
                            "speaker": "拉米雅",
                            "text": "这些动物的活动范围不大，拿出点耐心找找看吧。"
                        }
                    ]
                }
            ]
        }
    ]
}