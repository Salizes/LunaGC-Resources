{
    "talkId": "7151005",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "胡塞尼": 16
    },
    "dialogues": [
        {
            "id": "715100501",
            "speaker": "胡塞尼",
            "text": "终于帮海迪夫解决了这次黑泥泛滥的问题…",
            "choices": [
                {
                    "id": "715100502",
                    "text": "你好。",
                    "response": [
                        {
                            "id": "715100503",
                            "speaker": "胡塞尼",
                            "text": "#…你好啊，{NICKNAME}，今天过得如何？"
                        },
                        {
                            "id": "715100504",
                            "speaker": "胡塞尼",
                            "text": "回想起来，算上这一次，每一次你都帮了我很大的忙"
                        },
                        {
                            "id": "715100505",
                            "speaker": "胡塞尼",
                            "text": "「导能圆盘」那次，在鹤观进行特殊遗迹重机观察的那次，还有这次在层岩巨渊。"
                        },
                        {
                            "id": "715100506",
                            "speaker": "胡塞尼",
                            "text": "每次都是些危急或者复杂的情况，但是正因为你出现，最后都能有一个好结果。"
                        },
                        {
                            "id": "715100507",
                            "speaker": "胡塞尼",
                            "text": "这么想，真不知道是你的运气好，还是每次都能遇到你的我运气好呀…"
                        }
                    ]
                },
                {
                    "id": "715100508",
                    "text": "关于自传…",
                    "response": [
                        {
                            "id": "715100509",
                            "speaker": "胡塞尼",
                            "text": "只是随口说说的，我现在离能够写自传的等级还远。"
                        },
                        {
                            "id": "715100510",
                            "speaker": "胡塞尼",
                            "text": "更何况，还有许多研究课题等着我去攻克，你想，要是我多攻克一个研究课题，自传就能多写上几页。"
                        },
                        {
                            "id": "715100511",
                            "speaker": "胡塞尼",
                            "text": "所以自传这个东西，肯定是越晚写越划算。"
                        }
                    ]
                },
                {
                    "id": "715100512",
                    "text": "关于海迪夫…",
                    "response": [
                        {
                            "id": "715100513",
                            "speaker": "胡塞尼",
                            "text": "你是想问为什么会接受海迪夫的委托，来层岩巨渊帮忙吗？"
                        },
                        {
                            "id": "715100514",
                            "speaker": "胡塞尼",
                            "text": "你知道「普尔比鲁尼」吗，海迪夫是「普尔比鲁尼」一门的学者。"
                        },
                        {
                            "id": "715100515",
                            "speaker": "胡塞尼",
                            "text": "在「教令院」的时候，我曾经接受过「普尔比鲁尼」一门很多的帮助，受他的委托前来，其实也算是一种报答。"
                        },
                        {
                            "id": "715100516",
                            "speaker": "胡塞尼",
                            "text": "算是正常的人情往来吧，单一领域的学者有的时候并没有办法解决所有的问题，所以需要不同的学者一起研究，"
                        },
                        {
                            "id": "715100517",
                            "speaker": "胡塞尼",
                            "text": "这也是一种构建学者之间关系的方式。"
                        }
                    ]
                },
                {
                    "id": "715100518",
                    "text": "祝你顺利，再见！",
                    "response": [
                        {
                            "id": "715100519",
                            "speaker": "胡塞尼",
                            "text": "谢谢你的祝福，再见！"
                        },
                        {
                            "id": "715100520",
                            "speaker": "胡塞尼",
                            "text": "希望真的能顺利一些吧…"
                        }
                    ]
                }
            ]
        }
    ]
}