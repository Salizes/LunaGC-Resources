{
    "talkId": "4018927",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "努斯妲": 9
    },
    "dialogues": [
        {
            "id": "401892701",
            "speaker": "努斯妲",
            "text": "尊敬的大英雄，很荣幸能为您工作。",
            "choices": [
                {
                    "id": "401892702",
                    "text": "我们好像见过？",
                    "response": [
                        {
                            "id": "401892703",
                            "speaker": "努斯妲",
                            "text": "没错，之前我有幸与您一同抗击过深渊。一切尘埃落定后，在圣火竞技场前，我们还合过影呢！"
                        },
                        {
                            "id": "401892704",
                            "speaker": "努斯妲",
                            "text": "说实话，我也没想到，这次来枫丹度假，也能遇上您。"
                        },
                        {
                            "id": "401892705",
                            "speaker": "努斯妲",
                            "text": "早知道，我就不点那些没试过的酒了，在「锈舵」喝个烂醉后，再出现在您面前，有点丢人…"
                        },
                        {
                            "id": "401892706",
                            "speaker": "努斯妲",
                            "text": "呃咳，不过请放心，现在酒劲已经消退了，我做事不会再有闪失。"
                        }
                    ]
                },
                {
                    "id": "401892707",
                    "text": "在这里干活还适应吗？",
                    "response": [
                        {
                            "id": "401892708",
                            "speaker": "努斯妲",
                            "text": "非常棒！扮演映影乐园的工作人员，这种体验很新奇…"
                        },
                        {
                            "id": "401892709",
                            "speaker": "努斯妲",
                            "text": "要是之前没有碰上…醉酒后体验潜水，结果搞丢钱包那档子事…我现在应该更享受才对！"
                        },
                        {
                            "id": "401892710",
                            "speaker": "努斯妲",
                            "text": "不过问题不大，只是损失了全部旅费而已。您开给我的薪水非常丰厚，认真干个几天就能赚回来！"
                        }
                    ]
                },
                {
                    "id": "401892711",
                    "text": "那你加油！",
                    "response": [
                        {
                            "id": "401892712",
                            "speaker": "努斯妲",
                            "text": "一定！这个冒险项目十分有趣，能让我拿出十成的干劲！"
                        }
                    ]
                }
            ]
        }
    ]
}