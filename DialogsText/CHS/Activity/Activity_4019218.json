    "dialogues": [
        {
            "id": "401921801",
            "speaker": "千织",
            "text": "#嗯？好久不见，{NICKNAME}。"
        },
        {
            "id": "401921802",
            "speaker": "Player",
            "text": "你是从枫丹赶来的吗？"
        },
        {
            "id": "401921803",
            "speaker": "千织",
            "text": "嗯，既属于妖也属于人的盛大祭典，即便我身在水之国度也有所耳闻。"
        },
        {
            "id": "401921804",
            "speaker": "千织",
            "text": "恰好绫华给我发了邀请，就试着回来看看了…稻妻如今的气氛，似乎比我出走时好了许多。"
        }
    ]
}