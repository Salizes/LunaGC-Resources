{
    "talkId": "7350636",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "丽莎": 4,
        "柯莱": 6
    },
    "dialogues": [
        {
            "id": "735063601",
            "speaker": "柯莱",
            "text": "放心吧，丽莎小姐，我现在很好。"
        },
        {
            "id": "735063602",
            "speaker": "Player",
            "text": "你们好。"
        },
        {
            "id": "735063603",
            "speaker": "柯莱",
            "text": "#是{NICKNAME}！你怎么来这儿啦。",
            "choices": [
                {
                    "id": "735063604",
                    "text": "来看看柯莱。",
                    "response": [
                        {
                            "id": "735063606",
                            "speaker": "丽莎",
                            "text": "小可爱经常来探望小柯莱吗？"
                        },
                        {
                            "id": "735063607",
                            "speaker": "柯莱",
                            "text": "#{NICKNAME}{M#他}{F#她}非常热心，之前在化城郭帮了我们不少忙呢。"
                        },
                        {
                            "id": "735063608",
                            "speaker": "Player",
                            "text": "我和柯莱是很好的朋友。"
                        },
                        {
                            "id": "735063609",
                            "speaker": "丽莎",
                            "text": "看样子，小柯莱在须弥认识了不少新朋友呢。"
                        },
                        {
                            "id": "735063610",
                            "speaker": "柯莱",
                            "text": "而且我也有努力认字，现在我已经能读一些简单的句子了！"
                        },
                        {
                            "id": "735063611",
                            "speaker": "柯莱",
                            "text": "师父和须弥的大家都很关照我，不过我从来没有忘记蒙德的朋友们，最近我一直想找个时间回去探望一次。"
                        },
                        {
                            "id": "735063612",
                            "speaker": "柯莱",
                            "text": "丽莎小姐，大家怎么样？都还好吗？安柏好吗？凯亚先生好吗？琴小姐…"
                        },
                        {
                            "id": "735063613",
                            "speaker": "丽莎",
                            "text": "哈哈，小柯莱不要着急哦，等我慢慢跟你说…"
                        },
                        {
                            "id": "735063614",
                            "speaker": "丽莎",
                            "text": "抱歉，小可爱，给我一点时间，让我和小柯莱好好说说蒙德的事吧。"
                        }
                    ]
                },
                {
                    "id": "735063605",
                    "text": "居然又遇到了丽莎。"
                }
            ]
        }
    ]
}