{
    "talkId": "4008808",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "马茨": 8
    },
    "dialogues": [
        {
            "id": "400880801",
            "speaker": "马茨",
            "text": "价格实惠的日用百货，快来看看吧！",
            "choices": [
                {
                    "id": "400880802",
                    "text": "你是？",
                    "response": [
                        {
                            "id": "400880803",
                            "speaker": "马茨",
                            "text": "哟，这不是荣誉骑士吗？幸会幸会！"
                        },
                        {
                            "id": "400880804",
                            "speaker": "马茨",
                            "text": "我以前在外地做生意，一般只在佳酿节期间回来开店，你没见过我很正常。"
                        },
                        {
                            "id": "400880805",
                            "speaker": "马茨",
                            "text": "如果有缘的话，我们以后还会在别的地方碰面的！"
                        }
                    ]
                },
                {
                    "id": "400880806",
                    "text": "生意怎么样？",
                    "response": [
                        {
                            "id": "400880807",
                            "speaker": "马茨",
                            "text": "挺不错的！"
                        },
                        {
                            "id": "400880808",
                            "speaker": "马茨",
                            "text": "如你所见，佳酿节上的客人太多了！在这里一天的店，就能赚到以前四五天的收入！"
                        },
                        {
                            "id": "400880809",
                            "speaker": "马茨",
                            "text": "真希望这种热闹的节日能多一点啊！"
                        }
                    ]
                },
                {
                    "id": "400880810",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "400880811",
                            "speaker": "马茨",
                            "text": "再见，有缘再见！"
                        }
                    ]
                }
            ]
        }
    ]
}