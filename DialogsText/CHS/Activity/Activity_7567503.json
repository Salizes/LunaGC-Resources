{
    "talkId": "7567503",
    "total_dialogue_lines": 41,
    "speaker_counts": {
        "Black Screen": 3,
        "Player": 6,
        "卡齐娜": 4,
        "妮露": 7,
        "派蒙": 6,
        "玛拉妮": 8,
        "芭芭拉": 7
    },
    "dialogues": [
        {
            "id": "756750301",
            "speaker": "妮露",
            "text": "…所以，在吃甜食之前，尝一点加了香辛料的豆泥，感觉就会非常不一样。"
        },
        {
            "id": "756750302",
            "speaker": "妮露",
            "text": "比如蔷薇奶糊，哪怕糖的用量减少到三分之一，尝起来也和之前差不多甜，花香甚至更浓郁。"
        },
        {
            "id": "756750303",
            "speaker": "芭芭拉",
            "text": "这么说来，格兰菲狄小姐从挪德卡莱带回来的那本医学书里好像也提到过——"
        },
        {
            "id": "756750304",
            "speaker": "芭芭拉",
            "text": "「微量辣味成分，可以激活一些味觉感官，一定程度上放大调料的作用。」"
        },
        {
            "id": "756750305",
            "speaker": "芭芭拉",
            "text": "而且，枫丹的研究好像还说过，如果摄入的辣味成分刚刚好，还有助于激活身体，快速消耗多余的能量。"
        },
        {
            "id": "756750306",
            "speaker": "芭芭拉",
            "text": "那我带来的那些辣味前菜…"
        },
        {
            "id": "756750307",
            "speaker": "妮露",
            "text": "可以把每条小鱼干再切成两三段，正好搭配少放糖的甜点呀。"
        },
        {
            "id": "756750308",
            "speaker": "派蒙",
            "text": "喔！看来芭芭拉和妮露慢慢聊得投机起来了嘛！",
            "choices": [
                {
                    "id": "756750309",
                    "text": "是从料理的话题展开的吗？",
                    "response": [
                        {
                            "id": "756750311",
                            "speaker": "妮露",
                            "text": "其实，一开始是在讨论我们共同的烦恼哦。"
                        },
                        {
                            "id": "756750312",
                            "speaker": "妮露",
                            "text": "米圆塔很美味，但总是让人沉醉在那种味道里，等到反应过来，空盘子就摆了好几个…"
                        },
                        {
                            "id": "756750313",
                            "speaker": "芭芭拉",
                            "text": "最近猎鹿人的饭菜加量了，每一盘都能让骑士吃得心满意足，但对于我这种教会的工作人员就…"
                        },
                        {
                            "id": "756750314",
                            "speaker": "妮露",
                            "text": "嗯。"
                        },
                        {
                            "id": "756750315",
                            "speaker": "芭芭拉",
                            "text": "咳咳…"
                        },
                        {
                            "id": "756750316",
                            "speaker": "派蒙",
                            "text": "就，就什么？",
                            "choices": [
                                {
                                    "id": "756750317",
                                    "text": "是我偶尔也会有的烦恼呀。",
                                    "response": [
                                        {
                                            "id": "756750319",
                                            "speaker": "玛拉妮",
                                            "text": "哈哈，聊得正好！"
                                        },
                                        {
                                            "id": "756750320",
                                            "speaker": "玛拉妮",
                                            "text": "本来我还想说，为防你们达成共识，说着「减肥什么的明天再开始努力吧…」"
                                        },
                                        {
                                            "id": "756750321",
                                            "speaker": "玛拉妮",
                                            "text": "我已经减少了蛋糕里的糖和奶油，还准备了这几天的健康晨练计划…"
                                        },
                                        {
                                            "id": "756750322",
                                            "speaker": "玛拉妮",
                                            "text": "没想到，你们已经找到了弥补的方法，简直天才！"
                                        },
                                        {
                                            "id": "756750323",
                                            "speaker": "玛拉妮",
                                            "text": "今天这顿晚饭，就用妮露的妙法，和芭芭拉的小鱼干，可以吃得完全没有遗憾和负担！"
                                        },
                                        {
                                            "id": "756750324",
                                            "speaker": "派蒙",
                                            "text": "这，这些都是给我们准备的吗？"
                                        },
                                        {
                                            "id": "756750325",
                                            "speaker": "卡齐娜",
                                            "text": "还有一盘给师父和派蒙的火山蛋糕，我参考了最新的食谱，调了调配方…"
                                        },
                                        {
                                            "id": "756750326",
                                            "speaker": "卡齐娜",
                                            "text": "…希望味道能让师父和派蒙满意！"
                                        },
                                        {
                                            "id": "756750327",
                                            "speaker": "派蒙",
                                            "text": "卡齐娜亲手烤的蛋糕？"
                                        },
                                        {
                                            "id": "756750328",
                                            "speaker": "派蒙",
                                            "text": "我我我，我要认认真真地吃！"
                                        },
                                        {
                                            "id": "756750329",
                                            "speaker": "派蒙",
                                            "text": "#不行不行，{NICKNAME}有没有什么厉害的道具，能留一小块存下来，当纪念品？"
                                        },
                                        {
                                            "id": "756750330",
                                            "speaker": "卡齐娜",
                                            "text": "完全可以吃完的！师父和派蒙想吃多少，我都可以再做嘛。",
                                            "choices": [
                                                {
                                                    "id": "756750331",
                                                    "text": "那我就要大快朵颐了。",
                                                    "response": [
                                                        {
                                                            "id": "756750333",
                                                            "speaker": "卡齐娜",
                                                            "text": "嗯！我给你们准备好饮料，吃得时候切小块一点哦，小心不要噎着…"
                                                        },
                                                        {
                                                            "id": "756750334",
                                                            "speaker": "芭芭拉",
                                                            "text": "不知不觉，这就是我们一起吃的第多少顿晚饭了来着？"
                                                        },
                                                        {
                                                            "id": "756750335",
                                                            "speaker": "妮露",
                                                            "text": "这段时间，过得又慢又快，又充实又梦幻…"
                                                        },
                                                        {
                                                            "id": "756750336",
                                                            "speaker": "玛拉妮",
                                                            "text": "嘿！我的台词还是那一句——"
                                                        },
                                                        {
                                                            "id": "756750337",
                                                            "speaker": "玛拉妮",
                                                            "text": "「快乐的时光并不短暂，我们要把这次这样的聚会变成常态！」"
                                                        },
                                                        {
                                                            "id": "756750338",
                                                            "speaker": "玛拉妮",
                                                            "text": "现在是最最开心的时候，以后一定还会有更开心的时候！"
                                                        },
                                                        {
                                                            "id": "756750339",
                                                            "speaker": "Black Screen",
                                                            "text": "与朋友们一起享受了大餐，或许是因为与朋友们这样轻松地聚会，心情格外美好，加之在领舞过程中运动得相当充分，每道料理的风味都无可挑剔…"
                                                        },
                                                        {
                                                            "id": "756750340",
                                                            "speaker": "Black Screen",
                                                            "text": "尤其是卡齐娜的蛋糕，名为「努力」的魔法，在甜味之外，平添了让人心中踏踏实实的感动。"
                                                        },
                                                        {
                                                            "id": "756750341",
                                                            "speaker": "Black Screen",
                                                            "text": "大家约定好——\\n「等到卡齐娜的蛋糕店开张了，我们要带上最好的礼物来，一起帮忙剪彩！」"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "756750332",
                                                    "text": "那我就要好好品尝了。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "756750318",
                                    "text": "是派蒙不用担心的烦恼喔。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "756750310",
                    "text": "居然是用这种方法解决的？"
                }
            ]
        }
    ]
}