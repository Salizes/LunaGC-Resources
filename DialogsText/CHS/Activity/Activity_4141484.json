{
    "talkId": "4141484",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "布鲁斯": 10
    },
    "dialogues": [
        {
            "id": "414148401",
            "speaker": "Player",
            "text": "你怎么垂头丧气的？"
        },
        {
            "id": "414148402",
            "speaker": "布鲁斯",
            "text": "我在感叹如今的蒙德，虽说和平吧，不过也太平静了…"
        },
        {
            "id": "414148403",
            "speaker": "布鲁斯",
            "text": "所以我就在想啊，如果我生活在旧蒙德，说不定能成为被人歌颂的英雄…"
        },
        {
            "id": "414148404",
            "speaker": "布鲁斯",
            "text": "唉，你说现在这个和平年代，怎么才能出人头地，成为英雄呢？",
            "choices": [
                {
                    "id": "414148405",
                    "text": "比如击退风魔龙？",
                    "response": [
                        {
                            "id": "414148406",
                            "speaker": "布鲁斯",
                            "text": "唔，这的确是一个机会，可我…"
                        },
                        {
                            "id": "414148407",
                            "speaker": "布鲁斯",
                            "text": "呃，你该不会是想问，龙灾发生的时候我在做什么吧？"
                        },
                        {
                            "id": "414148408",
                            "speaker": "布鲁斯",
                            "text": "我、我当时在…对，我在检查蒙德的安全死角！"
                        },
                        {
                            "id": "414148409",
                            "speaker": "布鲁斯",
                            "text": "咳咳，都是过去的事情了，就别提了，哈哈哈…"
                        }
                    ]
                },
                {
                    "id": "414148410",
                    "text": "比如单挑愚人众的执行官？",
                    "response": [
                        {
                            "id": "414148411",
                            "speaker": "布鲁斯",
                            "text": "我，这…对了，至冬国不管怎么说也是蒙德的盟友啊…"
                        },
                        {
                            "id": "414148412",
                            "speaker": "布鲁斯",
                            "text": "为、为了我们两国的外交关系，我也不能动手啊！"
                        },
                        {
                            "id": "414148413",
                            "speaker": "布鲁斯",
                            "text": "咳咳，总之还是再想想其他的出路吧…"
                        }
                    ]
                }
            ]
        }
    ]
}