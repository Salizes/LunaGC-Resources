    "speaker_counts": {
        "Player": 3,
        "「花里胡哨不如一刀」": 8
    },
    "dialogues": [
        {
            "id": "716665201",
            "speaker": "「花里胡哨不如一刀」",
            "text": "是你啊，要再和我切磋一局吗？",
            "choices": [
                {
                    "id": "716665202",
                    "text": "那就来斗虫吧！",
                    "response": [
                        {
                            "id": "716665203",
                            "speaker": "「花里胡哨不如一刀」",
                            "text": "很好，请赐教。"
                        }
                    ]
                },
                {
                    "id": "716665204",
                    "text": "会长居然也喜欢斗虫？",
                    "response": [
                        {
                            "id": "716665205",
                            "speaker": "「花里胡哨不如一刀」",
                            "text": "谈不上喜欢，只是觉得许多活动都有值得学习的内容，试试看总不亏。"
                        },
                        {
                            "id": "716665206",
                            "speaker": "「花里胡哨不如一刀」",
                            "text": "通常而言，各种高难度的委托里，也会有许多战斗以外的需求。"
                        },
                        {
                            "id": "716665207",
                            "speaker": "「花里胡哨不如一刀」",
                            "text": "比如解开机关的谜题，或是遵循线索寻找特定的物品…"
                        },
                        {
                            "id": "716665208",
                            "speaker": "「花里胡哨不如一刀」",
                            "text": "说不定哪天，就会碰见需要指挥其他生物达成某种目标的委托。"
                        },
                        {
                            "id": "716665209",
                            "speaker": "「花里胡哨不如一刀」",
                            "text": "凭你的实力和见闻，应该深有体会吧？"
                        }
                    ]
                },
                {
                    "id": "716665210",
                    "text": "先不打扰了…",
                    "response": [
                        {
                            "id": "716665211",
                            "speaker": "「花里胡哨不如一刀」",
                            "text": "嗯，去吧。"
                        }
                    ]
                }
            ]
        }
    ]
}