    "dialogues": [
        {
            "id": "736963201",
            "speaker": "巴哈尔",
            "text": "导师为什么对他发怒？",
            "choices": [
                {
                    "id": "736963202",
                    "text": "因为无法拿到信件。",
                    "response": [
                        {
                            "id": "736963206",
                            "speaker": "巴哈尔",
                            "text": "是谁最后接触了这封信件？",
                            "choices": [
                                {
                                    "id": "736963207",
                                    "text": "盗宝团在教令院内的内应。",
                                    "response": [
                                        {
                                            "id": "736963211",
                                            "speaker": "巴哈尔",
                                            "text": "信件目前所在的位置是哪里？",
                                            "choices": [
                                                {
                                                    "id": "736963212",
                                                    "text": "导师的办公室。",
                                                    "response": [
                                                        {
                                                            "id": "736963216",
                                                            "speaker": "巴哈尔",
                                                            "text": "信里的这个东西究竟是？",
                                                            "choices": [
                                                                {
                                                                    "id": "736963217",
                                                                    "text": "炼金药剂。"
                                                                },
                                                                {
                                                                    "id": "736963218",
                                                                    "text": "办公室的钥匙。"
                                                                },
                                                                {
                                                                    "id": "736963219",
                                                                    "text": "盗宝团的联络信。"
                                                                },
                                                                {
                                                                    "id": "736963220",
                                                                    "text": "账单。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "736963213",
                                                    "text": "被藏起来了。"
                                                },
                                                {
                                                    "id": "736963214",
                                                    "text": "风纪官手中。"
                                                },
                                                {
                                                    "id": "736963215",
                                                    "text": "已经被毁掉了。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "736963208",
                                    "text": "学院内负责分发信件的工作人员。"
                                },
                                {
                                    "id": "736963209",
                                    "text": "风纪官。"
                                },
                                {
                                    "id": "736963210",
                                    "text": "巴赫拉。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "736963203",
                    "text": "信件里的东西已经被损坏了。"
                },
                {
                    "id": "736963204",
                    "text": "自己的计划即将败露。"
                },
                {
                    "id": "736963205",
                    "text": "巴赫拉和盗宝团勾结。"
                }
            ]
        }
    ]
}