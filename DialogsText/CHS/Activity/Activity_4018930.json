{
    "talkId": "4018930",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "「弯刀大叔」": 9
    },
    "dialogues": [
        {
            "id": "401893001",
            "speaker": "「弯刀大叔」",
            "text": "哎，这不是迪希雅的朋友吗？这次轮到你当我的老板了？",
            "choices": [
                {
                    "id": "401893002",
                    "text": "合作愉快！",
                    "response": [
                        {
                            "id": "401893003",
                            "speaker": "「弯刀大叔」",
                            "text": "合作愉快——我也想这么说！不过，说不定我会因为个人习惯…不小心犯错。"
                        },
                        {
                            "id": "401893004",
                            "speaker": "「弯刀大叔」",
                            "text": "比如扮演反派时太投入，舞刀舞得张牙舞爪，让客人过度紧张…以前我哄小孩的时候，就给人家吓哭了。"
                        },
                        {
                            "id": "401893005",
                            "speaker": "「弯刀大叔」",
                            "text": "如果发生了这种事，还请多多包涵啊！"
                        }
                    ]
                },
                {
                    "id": "401893006",
                    "text": "我们好像见过…",
                    "response": [
                        {
                            "id": "401893007",
                            "speaker": "「弯刀大叔」",
                            "text": "是吗？是吧！"
                        },
                        {
                            "id": "401893008",
                            "speaker": "「弯刀大叔」",
                            "text": "你可是大名人，四处活动得相当勤快，我好几次看到过你，不过你应该没有特别留意过我。"
                        },
                        {
                            "id": "401893009",
                            "speaker": "「弯刀大叔」",
                            "text": "有一次，还不知道你是迪希雅的朋友时，和你过了两招，被你咔咔打趴下了，不知道那回有没有给你留下轻伤什么的…"
                        },
                        {
                            "id": "401893010",
                            "speaker": "「弯刀大叔」",
                            "text": "请别介意啊，现在我们是一边的了！"
                        }
                    ]
                },
                {
                    "id": "401893011",
                    "text": "一起发财！",
                    "response": [
                        {
                            "id": "401893012",
                            "speaker": "「弯刀大叔」",
                            "text": "好，我会勤勤恳恳上工的！"
                        }
                    ]
                }
            ]
        }
    ]
}