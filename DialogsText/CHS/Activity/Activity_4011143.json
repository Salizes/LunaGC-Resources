    "dialogues": [
        {
            "id": "401114301",
            "speaker": "珊瑚宫心海",
            "text": "#咦？{NICKNAME}，你是专程回来见我的吗？",
            "choices": [
                {
                    "id": "401114302",
                    "text": "关于「怪盗」…",
                    "response": [
                        {
                            "id": "401114303",
                            "speaker": "珊瑚宫心海",
                            "text": "原来谜底是这样…让人不知该以怎样的表情面对呢。"
                        },
                        {
                            "id": "401114304",
                            "speaker": "珊瑚宫心海",
                            "text": "谢谢你能告诉我这些。"
                        },
                        {
                            "id": "401114305",
                            "speaker": "珊瑚宫心海",
                            "text": "就像读完了小说的结尾，这下可以安心了。",
                            "choices": [
                                {
                                    "id": "401114306",
                                    "text": "关于「比赛」…",
                                    "response": [
                                        {
                                            "id": "401114307",
                                            "speaker": "珊瑚宫心海",
                                            "text": "「胜负不是最重要的。」「要打出风度。」——原本我一直这么想着。"
                                        },
                                        {
                                            "id": "401114308",
                                            "speaker": "珊瑚宫心海",
                                            "text": "可看着你们为我加油的样子，不知不觉就想以最认真的姿态面对了。"
                                        },
                                        {
                                            "id": "401114309",
                                            "speaker": "珊瑚宫心海",
                                            "text": "呵呵…这一想，能在比赛前见到你们真是太好了。"
                                        },
                                        {
                                            "id": "401114310",
                                            "speaker": "Player",
                                            "text": "能量值+5？"
                                        },
                                        {
                                            "id": "401114311",
                                            "speaker": "珊瑚宫心海",
                                            "text": "唔…！不，不要再提那个了啦！",
                                            "choices": [
                                                {
                                                    "id": "401114302",
                                                    "text": "关于「怪盗」…"
                                                },
                                                {
                                                    "id": "401114312",
                                                    "text": "先不打扰你了。",
                                                    "response": [
                                                        {
                                                            "id": "401114313",
                                                            "speaker": "珊瑚宫心海",
                                                            "text": "既然来了海祇岛，就多坐一会儿再走吧。"
                                                        },
                                                        {
                                                            "id": "401114314",
                                                            "speaker": "珊瑚宫心海",
                                                            "text": "希望这片风景能一直留在你的心中。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401114312",
                                    "text": "先不打扰你了。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401114306",
                    "text": "关于「比赛」…"
                },
                {
                    "id": "401114312",
                    "text": "先不打扰你了。"
                }
            ]
        }
    ]
}