{
    "talkId": "7115301",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 10,
        "希格雯": 9
    },
    "dialogues": [
        {
            "id": "711530102",
            "speaker": "希格雯",
            "text": "#{NICKNAME}，节日快乐呀。"
        },
        {
            "id": "711530103",
            "speaker": "希格雯",
            "text": "公爵说过，我们也许会在璃月遇见你，没想到咱们这么快就碰头了。",
            "choices": [
                {
                    "id": "711530101",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711530104",
                            "speaker": "希格雯",
                            "text": "嗯，你的霄灯很好看喔。之前我在梅洛彼得堡里治疗过的病人也提到过，自己想要放飞霄灯。"
                        },
                        {
                            "id": "711530105",
                            "speaker": "希格雯",
                            "text": "正好趁此机会，帮他放飞一下愿望吧。"
                        },
                        {
                            "id": "711530106",
                            "speaker": "Player",
                            "text": "希格雯是和莱欧斯利一起来的？"
                        },
                        {
                            "id": "711530119",
                            "speaker": "希格雯",
                            "text": "嗯，是公爵邀请我一起来体验一下璃月的海灯节，顺便…用掉我一直没有用过的公休假。"
                        },
                        {
                            "id": "711530120",
                            "speaker": "希格雯",
                            "text": "在港口我们还遇见了一位很热心的女士，她说我们如果愿意，会让一位专业的留影师为我们拍摄留影画片，带回枫丹做纪念。",
                            "choices": [
                                {
                                    "id": "711530107",
                                    "text": "那看来…",
                                    "response": [
                                        {
                                            "id": "711530109",
                                            "speaker": "希格雯",
                                            "text": "那太好了，我相信你一定能拍出一张很好看的纪念留影，到时候，我还可以捎给那维莱特先生看看呢。",
                                            "choices": [
                                                {
                                                    "id": "711530110",
                                                    "text": "那咱们就开始吧。",
                                                    "response": [
                                                        {
                                                            "id": "711530111",
                                                            "speaker": "希格雯",
                                                            "text": "好呀。那就请您这位「专业留影师」给我一些建议吧，什么动作适合拍纪念留影呢？",
                                                            "choices": [
                                                                {
                                                                    "id": "711530114",
                                                                    "text": "严肃一点的。",
                                                                    "response": [
                                                                        {
                                                                            "id": "711530116",
                                                                            "speaker": "Player",
                                                                            "text": "就这个动作吧。"
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "711530115",
                                                                    "text": "放松一点的。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711530112",
                                                    "text": "请稍等一会…",
                                                    "response": [
                                                        {
                                                            "id": "711530113",
                                                            "speaker": "希格雯",
                                                            "text": "是要去处理急事么？没关系，我正好去周围散散步，等你处理好之后，再为我拍摄纪念留影吧。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711530108",
                                    "text": "我就是那位「专业留影师」。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711530106",
                    "text": "希格雯是和莱欧斯利一起来的？"
                }
            ]
        }
    ]
}