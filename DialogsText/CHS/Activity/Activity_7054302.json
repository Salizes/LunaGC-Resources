{
    "talkId": "7054302",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 8,
        "派蒙": 9,
        "雷泽": 11
    },
    "dialogues": [
        {
            "id": "705430201",
            "speaker": "雷泽",
            "text": "见到卢皮卡，很高兴。",
            "choices": [
                {
                    "id": "705430202",
                    "text": "雷泽和「团团灰」好像很熟？",
                    "response": [
                        {
                            "id": "705430204",
                            "speaker": "雷泽",
                            "text": "它，城外睡觉，带我去。很舒服。"
                        },
                        {
                            "id": "705430205",
                            "speaker": "雷泽",
                            "text": "它的朋友很多，很多，在城外…饿肚子…"
                        },
                        {
                            "id": "705430206",
                            "speaker": "雷泽",
                            "text": "城里，有食物…我，捕猎，有食物。"
                        },
                        {
                            "id": "705430207",
                            "speaker": "派蒙",
                            "text": "原来雷泽之前就在城外和「团团灰」成为朋友了啊…"
                        },
                        {
                            "id": "705430208",
                            "speaker": "Player",
                            "text": "听起来好像还有很多同伴。"
                        },
                        {
                            "id": "705430209",
                            "speaker": "派蒙",
                            "text": "然后，他们从城里把食物送出去给外面的同伴们…"
                        },
                        {
                            "id": "705430210",
                            "speaker": "派蒙",
                            "text": "为什么那些小猫不直接进来城里呢？虽然周围的墙是有点高啦，但就不用被雨淋到，也有东西吃了呀。"
                        },
                        {
                            "id": "705430211",
                            "speaker": "雷泽",
                            "text": "它们喜欢，飞得高高的蝴蝶。不喜欢，没风的地方。"
                        },
                        {
                            "id": "705430212",
                            "speaker": "雷泽",
                            "text": "…「团团灰」不一样，更喜欢人。"
                        },
                        {
                            "id": "705430213",
                            "speaker": "雷泽",
                            "text": "他想把食物给朋友。他的朋友，喜欢人类食物。"
                        },
                        {
                            "id": "705430214",
                            "speaker": "派蒙",
                            "text": "喜欢人做的食物，却不想进城里住，那群小猫还真是任性啊…"
                        },
                        {
                            "id": "705430215",
                            "speaker": "雷泽",
                            "text": "它想把朋友，带进来。用食物，带进来。",
                            "choices": [
                                {
                                    "id": "705430216",
                                    "text": "用食物来说服小猫来这里啊…",
                                    "response": [
                                        {
                                            "id": "705430218",
                                            "speaker": "派蒙",
                                            "text": "但是，如果把野外的那些小猫们也带过来，「猫茸茸城堡」真的能撑住吗？"
                                        },
                                        {
                                            "id": "705430219",
                                            "speaker": "派蒙",
                                            "text": "要是这里真的塞满了各种小猫，虽然瓦乐瑞娜小姐会很开心啦，但资金上说不定会…"
                                        },
                                        {
                                            "id": "705430220",
                                            "speaker": "雷泽",
                                            "text": "猫好，食物好，饿肚子，不好。雷泽，帮忙！"
                                        },
                                        {
                                            "id": "705430221",
                                            "speaker": "Player",
                                            "text": "总之，先解决小猫饿肚子的问题。"
                                        },
                                        {
                                            "id": "705430222",
                                            "speaker": "派蒙",
                                            "text": "嗯，不管怎么说，先把食物送过去吧。要是能让那些小猫愿意进城里来就好了…"
                                        },
                                        {
                                            "id": "705430223",
                                            "speaker": "Player",
                                            "text": "还得向瓦乐瑞娜小姐说明一下…"
                                        },
                                        {
                                            "id": "705430224",
                                            "speaker": "派蒙",
                                            "text": "没错，毕竟这间「猫茸茸城堡」花费的都是瓦乐瑞娜的存款呢。"
                                        },
                                        {
                                            "id": "705430225",
                                            "speaker": "Player",
                                            "text": "雷泽，城外的小猫们现在还好吗？"
                                        },
                                        {
                                            "id": "705430226",
                                            "speaker": "雷泽",
                                            "text": "前几天，带了吃的给朋友。现在，它们不饿。"
                                        },
                                        {
                                            "id": "705430227",
                                            "speaker": "派蒙",
                                            "text": "呼…那就好，这样就不用担心小猫们现在正挨饿了，我们之后可以找瓦乐瑞娜再讨论这件事…"
                                        },
                                        {
                                            "id": "705430228",
                                            "speaker": "雷泽",
                                            "text": "谢谢，卢皮卡。和你们一起，很安心。"
                                        }
                                    ]
                                },
                                {
                                    "id": "705430217",
                                    "text": "也许还真能打动小猫…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "705430203",
                    "text": "感觉你们在这之前就交流过？"
                }
            ]
        }
    ]
}