{
    "talkId": "7154025",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "优菈": 11
    },
    "dialogues": [
        {
            "id": "715402501",
            "speaker": "优菈",
            "text": "这些就应该足够了…",
            "choices": [
                {
                    "id": "715402502",
                    "text": "这封祝柬送给你。",
                    "response": [
                        {
                            "id": "715402503",
                            "speaker": "优菈",
                            "text": "#这是…送给我的？谢谢你，{NICKNAME}，我还是第一次收到这个。"
                        },
                        {
                            "id": "715402504",
                            "speaker": "优菈",
                            "text": "没想到能在这里遇见你。我正在和安柏分头在街上买礼物，准备带回去送给骑士团的各位。"
                        },
                        {
                            "id": "715402505",
                            "speaker": "Player",
                            "text": "你都买了什么？"
                        },
                        {
                            "id": "715402506",
                            "speaker": "优菈",
                            "text": "主要是一些小摆件和玩具，还去翘英庄买了一些茶叶，准备带回去给琴。"
                        },
                        {
                            "id": "715402507",
                            "speaker": "优菈",
                            "text": "我听人说，茶水也有提神的功效，正好拿回去给琴换换口味。"
                        },
                        {
                            "id": "715402508",
                            "speaker": "优菈",
                            "text": "不过…这种茶叶的冲泡方法还真是复杂，翘英庄里那位茶商给我讲了好久。"
                        },
                        {
                            "id": "715402509",
                            "speaker": "优菈",
                            "text": "还好之前我也学过和茶有关的礼制，理解得也不算慢。"
                        },
                        {
                            "id": "715402510",
                            "speaker": "优菈",
                            "text": "这份茶糕给你，是我和安柏在翘英庄里买的。安柏特别喜欢，所以我们就多买了一些。"
                        },
                        {
                            "id": "715402511",
                            "speaker": "优菈",
                            "text": "稍后我们还要去那盏「明霄灯」附近看看。也许，还会找人帮我们留个影。"
                        },
                        {
                            "id": "715402512",
                            "speaker": "优菈",
                            "text": "可惜，我们都没带留影机过来，不然一定能拍下不少好画片。"
                        }
                    ]
                },
                {
                    "id": "715402513",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715402514",
                            "speaker": "优菈",
                            "text": "再见，祝你节日快乐。"
                        }
                    ]
                }
            ]
        }
    ]
}