    "dialogues": [
        {
            "id": "400881601",
            "speaker": "保琳",
            "text": "荣誉骑士，大家听说义卖活动收获颇丰，都在夸你、派蒙、伯恩哈德和马茨先生呢！"
        },
        {
            "id": "400881602",
            "speaker": "保琳",
            "text": "就连我也沾了光，收到了几封感谢信…",
            "choices": [
                {
                    "id": "400881603",
                    "text": "这是我们并肩努力的结果。",
                    "response": [
                        {
                            "id": "400881604",
                            "speaker": "保琳",
                            "text": "我做的工作还不够多，远不如你们辛苦。"
                        },
                        {
                            "id": "400881605",
                            "speaker": "保琳",
                            "text": "不过，听了你的经营策略后，我觉得自己学到了很多东西，变成了更稳重的商人！"
                        },
                        {
                            "id": "400881606",
                            "speaker": "保琳",
                            "text": "总之，万分感谢你！"
                        }
                    ]
                },
                {
                    "id": "400881607",
                    "text": "下次再合作吧！",
                    "response": [
                        {
                            "id": "400881608",
                            "speaker": "保琳",
                            "text": "有机会的话，请一定要叫上我啊。"
                        }
                    ]
                }
            ]
        }
    ]
}