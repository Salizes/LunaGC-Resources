    "dialogues": [
        {
            "id": "746740201",
            "speaker": "乌尔曼",
            "text": "怎么办呢…唉，我干脆就这样直接回蒙德好了…"
        },
        {
            "id": "746740202",
            "speaker": "乌尔曼",
            "text": "出来这么久，连蒲公英酒的味道都要忘了…",
            "choices": [
                {
                    "id": "746740203",
                    "text": "想看看你有什么货。",
                    "response": [
                        {
                            "id": "746740205",
                            "speaker": "乌尔曼",
                            "text": "行啊。随便看。"
                        }
                    ]
                },
                {
                    "id": "746740204",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "746740206",
                            "speaker": "乌尔曼",
                            "text": "下次再见！我有一种预感，咱们之后还会继续合作。到时候，还得拜托你了啊。"
                        }
                    ]
                }
            ]
