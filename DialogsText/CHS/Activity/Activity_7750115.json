{
    "talkId": "7750115",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 7,
        "纳蒂亚": 17
    },
    "dialogues": [
        {
            "id": "775011501",
            "speaker": "纳蒂亚",
            "text": "你怎么有点眼熟…你也要来射击竞赛吗？",
            "choices": [
                {
                    "id": "775011502",
                    "text": "那就开始吧。",
                    "response": [
                        {
                            "id": "775011503",
                            "speaker": "纳蒂亚",
                            "text": "你的手更适合握铳枪，应该会打得很漂亮。"
                        }
                    ]
                },
                {
                    "id": "775011504",
                    "text": "我们见过呀。",
                    "response": [
                        {
                            "id": "775011505",
                            "speaker": "纳蒂亚",
                            "text": "咦…是在枫丹吗？",
                            "choices": [
                                {
                                    "id": "775011506",
                                    "text": "在一个你会想起来的地方。",
                                    "response": [
                                        {
                                            "id": "775011507",
                                            "speaker": "纳蒂亚",
                                            "text": "那应该不久后就会想起来了。"
                                        },
                                        {
                                            "id": "775011510",
                                            "speaker": "纳蒂亚",
                                            "text": "尤维尔最近很厉害，完成了好多好多好多委托，还找到了厉害的宝藏，赚到了大钱。"
                                        },
                                        {
                                            "id": "775011511",
                                            "speaker": "纳蒂亚",
                                            "text": "尤维尔说，他要找到最厉害的医生，让我的记性变好。"
                                        }
                                    ]
                                },
                                {
                                    "id": "775011508",
                                    "text": "在锈舵酒吧旁边。",
                                    "response": [
                                        {
                                            "id": "775011509",
                                            "speaker": "纳蒂亚",
                                            "text": "我记起来了，是你，帮了我们很多很多的朋友。下次我一定要早早认出你来。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011512",
                    "text": "我们没见过吧？",
                    "response": [
                        {
                            "id": "775011513",
                            "speaker": "纳蒂亚",
                            "text": "那，现在就算是认识了。"
                        },
                        {
                            "id": "775011514",
                            "speaker": "纳蒂亚",
                            "text": "你给我一种，特别特别棒的感觉，和你待在一起，会有好事发生。"
                        },
                        {
                            "id": "775011515",
                            "speaker": "纳蒂亚",
                            "text": "以后去枫丹了，可以到一个叫「锈舵」的地方来。"
                        },
                        {
                            "id": "775011516",
                            "speaker": "纳蒂亚",
                            "text": "我请你喝汐藻海螺酿，前几个月做出来的，配方写在纸上了，不会忘。"
                        }
                    ]
                },
                {
                    "id": "775011517",
                    "text": "美露莘也来参赛吗？",
                    "response": [
                        {
                            "id": "775011518",
                            "speaker": "纳蒂亚",
                            "text": "嗯，我来认真比赛。"
                        },
                        {
                            "id": "775011519",
                            "speaker": "纳蒂亚",
                            "text": "有人说，我和尤维尔的组合很厉害，能代表他们，然后就塞给我们很多钱，和教我们说话的书。"
                        },
                        {
                            "id": "775011520",
                            "speaker": "纳蒂亚",
                            "text": "所以来这里比赛，是好事。"
                        },
                        {
                            "id": "775011521",
                            "speaker": "纳蒂亚",
                            "text": "这里的铳枪，以前没用过，但是原理差不多，所以握住就会用。"
                        },
                        {
                            "id": "775011522",
                            "speaker": "纳蒂亚",
                            "text": "如果没这么冷就好了，稍微呼一口气，眼睛前边就全是雾气…"
                        }
                    ]
                },
                {
                    "id": "775011523",
                    "text": "要好好休息哦。",
                    "response": [
                        {
                            "id": "775011524",
                            "speaker": "纳蒂亚",
                            "text": "我会的，我每天睡十个小时呢。"
                        }
                    ]
                }
            ]
        }
    ]
}