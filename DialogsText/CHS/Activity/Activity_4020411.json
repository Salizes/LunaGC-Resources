{
    "talkId": "4020411",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "达尔维什": 15
    },
    "dialogues": [
        {
            "id": "402041101",
            "speaker": "达尔维什",
            "text": "怎么样，要来进行「伙伴冒险大战记」的测试吗？",
            "choices": [
                {
                    "id": "402041102",
                    "text": "重新学习教程…",
                    "response": [
                        {
                            "id": "402041103",
                            "speaker": "达尔维什",
                            "text": "嗯，重新巩固已经学习的知识也是非常重要的事…那么，就让我打开一下教学用的地图和棋盘吧！"
                        }
                    ]
                },
                {
                    "id": "402041104",
                    "text": "关于「伙伴冒险大战记」…",
                    "response": [
                        {
                            "id": "402041105",
                            "speaker": "达尔维什",
                            "text": "哦，你是想问为什么产生了这样的想法？首先是因为做跨学科的课题研究本身已经很复杂了，不如做点有意思的。"
                        },
                        {
                            "id": "402041106",
                            "speaker": "达尔维什",
                            "text": "而且如果形式本身得到验证，以后引入更准确的信息和数据，即使是「模拟」出来的情况也能够当实际的战斗环境的参考。"
                        },
                        {
                            "id": "402041107",
                            "speaker": "达尔维什",
                            "text": "对「三十人团」应该也能够有帮助吧…"
                        },
                        {
                            "id": "402041108",
                            "speaker": "达尔维什",
                            "text": "这可不是个玩玩的项目，我还是很认真的哦。"
                        }
                    ]
                },
                {
                    "id": "402041109",
                    "text": "关于编纂的故事背景…",
                    "response": [
                        {
                            "id": "402041110",
                            "speaker": "达尔维什",
                            "text": "你是说编纂的冒险故事吗…哈哈，我们毕竟是教令院的学者，当然还是拿须弥的故事当原型比较有趣…"
                        },
                        {
                            "id": "402041111",
                            "speaker": "达尔维什",
                            "text": "而且，也有前两天，在院内和一位因论派的学弟聊天得到的灵感，我说说不定能够用到和他谈话里的内容…"
                        },
                        {
                            "id": "402041112",
                            "speaker": "达尔维什",
                            "text": "他就点头说「可以可以可以，到时候有成品了一定要拿来给我看看啊！」"
                        },
                        {
                            "id": "402041113",
                            "speaker": "达尔维什",
                            "text": "真是很有活力的人呢。"
                        }
                    ]
                },
                {
                    "id": "402041114",
                    "text": "关于阿塔希耶和法德瓦…",
                    "response": [
                        {
                            "id": "402041115",
                            "speaker": "达尔维什",
                            "text": "嗯，阿塔希耶和我是一辈的，法德瓦入学比我们要晚一些…"
                        },
                        {
                            "id": "402041116",
                            "speaker": "达尔维什",
                            "text": "别看阿塔希耶平时毛手毛脚，可一旦进入手工作业的领域，没人比他更可靠啦，你看，这些「模拟养成」用到的棋子和棋盘…"
                        },
                        {
                            "id": "402041117",
                            "speaker": "达尔维什",
                            "text": "说到法德瓦…唉，每次看到她的时候都在和别人争吵数字的细节，不过她不是个脾气坏的人，只是对待数字很认真。"
                        },
                        {
                            "id": "402041118",
                            "speaker": "达尔维什",
                            "text": "大概是因为她每次和人吵起来的时候我都愿意帮她调解…所以我们才能成为朋友吧。"
                        }
                    ]
                },
                {
                    "id": "402041119",
                    "text": "不，之后再说吧…",
                    "response": [
                        {
                            "id": "402041120",
                            "speaker": "达尔维什",
                            "text": "好吧，好吧。"
                        }
                    ]
                }
            ]
        }
    ]
}