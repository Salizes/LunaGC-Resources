{
    "talkId": "7350802",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "派蒙": 6,
        "贝尔福": 9
    },
    "dialogues": [
        {
            "id": "735080201",
            "speaker": "贝尔福",
            "text": "两位大英雄，要再玩几局「灵蕈棋阵」吗？"
        },
        {
            "id": "735080202",
            "speaker": "贝尔福",
            "text": "如果还有什么问题，也请趁现在提出来吧！",
            "choices": [
                {
                    "id": "735080203",
                    "text": "游玩「灵蕈棋阵」"
                },
                {
                    "id": "735080204",
                    "text": "关于之后的资金…",
                    "response": [
                        {
                            "id": "735080205",
                            "speaker": "派蒙",
                            "text": "#对哦！{NICKNAME}不说我都忘了，第一次驯兽师大赛的时候，我们就是被奖金…"
                        },
                        {
                            "id": "735080206",
                            "speaker": "派蒙",
                            "text": "呃咳咳…被奖金体现出来的超~大~的比赛规模给吸引的。"
                        },
                        {
                            "id": "735080207",
                            "speaker": "派蒙",
                            "text": "那下一次，我们也要准备一大笔奖金吧？每个名次靠前的选手都有拿到奖金的机会，才能让更多人有动力参赛。"
                        },
                        {
                            "id": "735080208",
                            "speaker": "派蒙",
                            "text": "还有租用场地，聘请工作人员…好多好多事都要花钱。这八位数级别的摩拉…难道都要我们自己来掏腰包吗？"
                        },
                        {
                            "id": "735080209",
                            "speaker": "贝尔福",
                            "text": "哈哈，你们问到我最有把握的问题了！"
                        },
                        {
                            "id": "735080210",
                            "speaker": "贝尔福",
                            "text": "不用担心，下次我会寻找许多赞助方，让好几十位商人一起出资，为大赛出资。"
                        },
                        {
                            "id": "735080211",
                            "speaker": "贝尔福",
                            "text": "作为回报，只需要为他们提供足够的「曝光度」就可以了。毕竟，许多商人都很看重热门赛事为自家生意带来的宣传效应！",
                            "choices": [
                                {
                                    "id": "735080212",
                                    "text": "可以理解。",
                                    "response": [
                                        {
                                            "id": "735080214",
                                            "speaker": "派蒙",
                                            "text": "好像有道理哦…如果不出意外，用这种方式筹集资金，应该对所有人都有好处！"
                                        },
                                        {
                                            "id": "735080215",
                                            "speaker": "贝尔福",
                                            "text": "这算是我最擅长的工作之一了，只要你们点头，我就可以放手去寻找赞助方。"
                                        },
                                        {
                                            "id": "735080216",
                                            "speaker": "贝尔福",
                                            "text": "当然，我会提前把所有赞助方的情况调查得清清楚楚，整理好一份列表，征求你们的意见。",
                                            "choices": [
                                                {
                                                    "id": "735080217",
                                                    "text": "确实要好好筛选一番。",
                                                    "response": [
                                                        {
                                                            "id": "735080219",
                                                            "speaker": "贝尔福",
                                                            "text": "明白！经历过之前的事，我一定会提高警惕的！"
                                                        },
                                                        {
                                                            "id": "735080220",
                                                            "speaker": "派蒙",
                                                            "text": "到时候就麻烦你啦，贝尔福先生！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "735080218",
                                                    "text": "防止出现不安好心的人。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "735080213",
                                    "text": "是个办法。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735080221",
                    "text": "暂时不用啦。",
                    "response": [
                        {
                            "id": "735080222",
                            "speaker": "贝尔福",
                            "text": "那就之后再见了，两位大英雄！"
                        }
                    ]
                }
            ]
        }
    ]
}