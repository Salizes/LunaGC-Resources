    "speaker_counts": {
        "Player": 2,
        "夏沃蕾": 7
    },
    "dialogues": [
        {
            "id": "401333001",
            "speaker": "夏沃蕾",
            "text": "怎么了？特巡队队长在灰河长大很奇怪吗？",
            "choices": [
                {
                    "id": "401333002",
                    "text": "感觉很意外…",
                    "response": [
                        {
                            "id": "401333003",
                            "speaker": "夏沃蕾",
                            "text": "我也很意外。有段时间，我还觉得自己再也没机会加入警备队了。"
                        },
                        {
                            "id": "401333006",
                            "speaker": "夏沃蕾",
                            "text": "但只要你实力够硬，功绩够多…总有一天会被认可。"
                        },
                        {
                            "id": "401333007",
                            "speaker": "夏沃蕾",
                            "text": "反过来说，灰河也造就了我，在某些方面。"
                        },
                        {
                            "id": "401333008",
                            "speaker": "夏沃蕾",
                            "text": "比如怎样同罪人交易，怎样同罪人一样思考…"
                        },
                        {
                            "id": "401333009",
                            "speaker": "夏沃蕾",
                            "text": "当然，这就当作我们之间的秘密吧。"
                        }
                    ]
                },
                {
                    "id": "401333004",
                    "text": "感觉很难…",
                    "response": [
                        {
                            "id": "401333005",
                            "speaker": "夏沃蕾",
                            "text": "爬上来的过程吗？的确很难。"
                        }
                    ]
                }
            ]
        }
    ]
}