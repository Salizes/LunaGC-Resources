{
    "talkId": "7114506",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "玄理": 6
    },
    "dialogues": [
        {
            "id": "711450601",
            "speaker": "玄理",
            "text": "奉行大人的贵客，在下归乡在即。近来见阁下事务繁忙，不敢随意叨扰。如有怠慢，还请见谅。",
            "choices": [
                {
                    "id": "711450602",
                    "text": "不必这么拘谨，你是来开会的！",
                    "response": [
                        {
                            "id": "711450603",
                            "speaker": "玄理",
                            "text": "在下是来学习的，理应以谦卑之姿面对在场每位武艺精湛之人。"
                        },
                        {
                            "id": "711450604",
                            "speaker": "玄理",
                            "text": "所幸在下不负奉行大人的期望，此行收获颇丰，记录了多本要点。"
                        },
                        {
                            "id": "711450605",
                            "speaker": "玄理",
                            "text": "幕府军今后便可以本次推演的收获，针对性改进战法，更为利落地应对游荡在各岛的浪人贼寇…"
                        },
                        {
                            "id": "711450606",
                            "speaker": "玄理",
                            "text": "但愿阁下能在机缘得当之时再访稻妻，验收我等精进的成果。"
                        }
                    ]
                },
                {
                    "id": "711450607",
                    "text": "别客气，请代我问候绫人和绫华！",
                    "response": [
                        {
                            "id": "711450608",
                            "speaker": "玄理",
                            "text": "阁下的气度深深影响了在下，在下定会将美言回呈奉行大人与神里大小姐！"
                        }
                    ]
                }
            ]
        }
    ]
}