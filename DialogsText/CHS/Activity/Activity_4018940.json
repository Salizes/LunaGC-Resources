{
    "talkId": "4018940",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "拜希麦·五世": 10
    },
    "dialogues": [
        {
            "id": "401894001",
            "speaker": "拜希麦·五世",
            "text": "团雀最可爱，大家也不赖~",
            "choices": [
                {
                    "id": "401894002",
                    "text": "那谁排第二~",
                    "response": [
                        {
                            "id": "401894003",
                            "speaker": "拜希麦·五世",
                            "text": "哎呀呀，这我得好好想想~"
                        },
                        {
                            "id": "401894004",
                            "speaker": "拜希麦·五世",
                            "text": "松鼠毛茸茸，蕈兽嫩弹弹…"
                        },
                        {
                            "id": "401894005",
                            "speaker": "拜希麦·五世",
                            "text": "还有没摸过的史莱姆，原来它们圆圆软软，慢慢憨憨！"
                        },
                        {
                            "id": "401894006",
                            "speaker": "拜希麦·五世",
                            "text": "要我来评价，一时真找不出个第二！"
                        }
                    ]
                },
                {
                    "id": "401894007",
                    "text": "你的心态也一样！",
                    "response": [
                        {
                            "id": "401894008",
                            "speaker": "拜希麦·五世",
                            "text": "啊呀，是在说我的心态「可爱」吗？谢谢夸奖…"
                        },
                        {
                            "id": "401894009",
                            "speaker": "拜希麦·五世",
                            "text": "没有你这么一说，我还意识不到，自己的心态有什么特别之处，完全成了习惯…"
                        },
                        {
                            "id": "401894010",
                            "speaker": "拜希麦·五世",
                            "text": "那，我要兢兢业业，把这样的心态传达给更多游客…"
                        },
                        {
                            "id": "401894011",
                            "speaker": "拜希麦·五世",
                            "text": "大家一起可可爱爱！"
                        }
                    ]
                },
                {
                    "id": "401894012",
                    "text": "享受工作的态度，简直棒呆！",
                    "response": [
                        {
                            "id": "401894013",
                            "speaker": "拜希麦·五世",
                            "text": "嘿嘿，谢谢你雇佣我，这么好的差事，下次也别忘了我！"
                        }
                    ]
                }
            ]
        }
    ]
}