{
    "talkId": "7350714",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 20,
        "百雷遮罗": 3,
        "转转悠悠兽": 3
    },
    "dialogues": [
        {
            "id": "735071401",
            "speaker": "派蒙",
            "text": "「转转悠悠兽」和「百雷遮罗」，你们好呀！还记得我们吗？"
        },
        {
            "id": "735071402",
            "speaker": "派蒙",
            "text": "它们都很开心的样子，一点都没有犹豫，太好了！"
        },
        {
            "id": "735071403",
            "speaker": "派蒙",
            "text": "唔，我们要陪蕈兽伙伴们做些什么好呢？",
            "choices": [
                {
                    "id": "735071404",
                    "text": "用不同的声音来交流？",
                    "response": [
                        {
                            "id": "735071405",
                            "speaker": "派蒙",
                            "text": "要模仿动物的声音吗？可以哦，也想知道「转转悠悠兽」和「百雷遮罗」和其他动物的关系！"
                        },
                        {
                            "id": "735071406",
                            "speaker": "派蒙",
                            "text": "嗯，快来试试看吧！",
                            "choices": [
                                {
                                    "id": "735071407",
                                    "text": "咕咕…",
                                    "response": [
                                        {
                                            "id": "735071408",
                                            "speaker": "转转悠悠兽",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071409",
                                            "speaker": "百雷遮罗",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071410",
                                            "speaker": "派蒙",
                                            "text": "唔，须弥好像没什么鸽子哦，蕈兽伙伴们都不明白是什么意思。"
                                        },
                                        {
                                            "id": "735071411",
                                            "speaker": "派蒙",
                                            "text": "要不然，还是模仿暝彩鸟吧？"
                                        },
                                        {
                                            "id": "735071412",
                                            "speaker": "派蒙",
                                            "text": "喳喳喳，喳~喳喳，喳喳~喳！"
                                        },
                                        {
                                            "id": "735071413",
                                            "speaker": "派蒙",
                                            "text": "噫…好像有点难！完全学不来暝彩鸟的节奏，蕈兽伙伴们会更疑惑的吧…"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071414",
                                    "text": "嗷呜！",
                                    "response": [
                                        {
                                            "id": "735071415",
                                            "speaker": "派蒙",
                                            "text": "咦？这个连我都听不出来啦！难道你在模仿长鬓虎吗？"
                                        },
                                        {
                                            "id": "735071416",
                                            "speaker": "派蒙",
                                            "text": "会吓到蕈兽伙伴们的啦！"
                                        },
                                        {
                                            "id": "735071417",
                                            "speaker": "转转悠悠兽",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071418",
                                            "speaker": "百雷遮罗",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071419",
                                            "speaker": "派蒙",
                                            "text": "等等，蕈兽伙伴们好像很有干劲的样子？"
                                        },
                                        {
                                            "id": "735071420",
                                            "speaker": "派蒙",
                                            "text": "难道「转转悠悠兽」和「百雷遮罗」…以前和长鬓虎交过朋友，一起打过架？"
                                        },
                                        {
                                            "id": "735071421",
                                            "speaker": "派蒙",
                                            "text": "有点想象不出那个画面呢，以后我们多观察一下野外的蕈兽吧！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071422",
                                    "text": "呃~嘎嘎嘎！",
                                    "response": [
                                        {
                                            "id": "735071423",
                                            "speaker": "派蒙",
                                            "text": "你怎么在学深渊法师的声音！就算不太像，也会吓到蕈兽伙伴们的啦！"
                                        },
                                        {
                                            "id": "735071424",
                                            "speaker": "转转悠悠兽",
                                            "text": "！"
                                        },
                                        {
                                            "id": "735071425",
                                            "speaker": "百雷遮罗",
                                            "text": "！"
                                        },
                                        {
                                            "id": "735071426",
                                            "speaker": "派蒙",
                                            "text": "呜！「转转悠悠兽」和「百雷遮罗」好像有点害怕！"
                                        },
                                        {
                                            "id": "735071427",
                                            "speaker": "派蒙",
                                            "text": "#没事的，没事的，{NICKNAME}在恶作剧啦，附近没有深渊法师哦。"
                                        },
                                        {
                                            "id": "735071428",
                                            "speaker": "派蒙",
                                            "text": "不过，难道有的深渊法师会带着丘丘人欺负蕈兽吗？"
                                        },
                                        {
                                            "id": "735071429",
                                            "speaker": "派蒙",
                                            "text": "可恶，这样一想就有点生气！如果以后在野外遇见了被欺负的蕈兽，我们可不能坐视不理！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071430",
                    "text": "待会儿再来和蕈兽伙伴们玩。",
                    "response": [
                        {
                            "id": "735071431",
                            "speaker": "派蒙",
                            "text": "唔，确实还有些事没办完呢…那我们加把劲，争取尽快收工，多陪「转转悠悠兽」和「百雷遮罗」一会儿！"
                        }
                    ]
                }
            ]
        }
    ]
}