    "dialogues": [
        {
            "id": "711530302",
            "speaker": "希格雯",
            "text": "急事已经处理好了？那我们就开始拍摄吧。",
            "choices": [
                {
                    "id": "711530301",
                    "text": "我也放好霄灯啦。",
                    "response": [
                        {
                            "id": "711530309",
                            "speaker": "希格雯",
                            "text": "嗯，你的霄灯很好看喔。之前我在梅洛彼得堡里治疗过的病人也提到过，自己想要放飞霄灯。"
                        },
                        {
                            "id": "711530310",
                            "speaker": "希格雯",
                            "text": "正好趁此机会，帮他放飞一下愿望吧。",
                            "choices": [
                                {
                                    "id": "711530303",
                                    "text": "没问题，那就开始留影吧。",
                                    "response": [
                                        {
                                            "id": "711530304",
                                            "speaker": "希格雯",
                                            "text": "好呀。那就请您这位「专业留影师」给我一些建议吧，什么动作适合拍纪念留影呢？",
                                            "choices": [
                                                {
                                                    "id": "711530307",
                                                    "text": "严肃一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711530311",
                                                            "speaker": "Player",
                                                            "text": "就这个动作吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711530308",
                                                    "text": "放松一点的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711530305",
                                    "text": "请稍等一会…",
                                    "response": [
                                        {
                                            "id": "711530306",
                                            "speaker": "希格雯",
                                            "text": "是要去处理急事么？没关系，我正好去周围散散步，等你处理好之后，再为我拍摄纪念留影吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711530303",
                    "text": "没问题，那就开始留影吧。"
                },
                {
                    "id": "711530305",
                    "text": "请稍等一会…"
                }
            ]
        }
    ]
