    "speaker_counts": {
        "Player": 3,
        "乌尔曼": 6,
        "派蒙": 1
    },
    "dialogues": [
        {
            "id": "746730201",
            "speaker": "乌尔曼",
            "text": "哟，你怎么就回来了？找到宝贝了吗？",
            "choices": [
                {
                    "id": "746730202",
                    "text": "想看看你有什么货。",
                    "response": [
                        {
                            "id": "746730210",
                            "speaker": "乌尔曼",
                            "text": "行啊。随便看。"
                        }
                    ]
                },
                {
                    "id": "746730203",
                    "text": "你为什么来枫丹？",
                    "response": [
                        {
                            "id": "746730204",
                            "speaker": "乌尔曼",
                            "text": "那当然是…呃，为了做一些生意嘛。我的几个合作伙伴都来了枫丹，我也只能过来了。"
                        },
                        {
                            "id": "746730205",
                            "speaker": "派蒙",
                            "text": "喂，你的那些合作伙伴，不会是…盗宝团一类的人吧？"
                        },
                        {
                            "id": "746730206",
                            "speaker": "乌尔曼",
                            "text": "怎么会！我可不会和那群人合作，风险也太大了…"
                        },
                        {
                            "id": "746730207",
                            "speaker": "乌尔曼",
                            "text": "呃…至少不会直接合作，就算非要合作，我也要去找一个中间人。"
                        }
                    ]
                },
                {
                    "id": "746730208",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "746730209",
                            "speaker": "乌尔曼",
                            "text": "再见，古铁钱的事就拜托你们了，找到的话就拿回来给我，我一定高价收购。"
                        }
                    ]
                }
            ]
        }
    ]
}