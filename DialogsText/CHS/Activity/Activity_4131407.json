{
    "talkId": "4131407",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "景明": 6
    },
    "dialogues": [
        {
            "id": "413140701",
            "speaker": "景明",
            "text": "你好，有什么可以为你效劳的？",
            "choices": [
                {
                    "id": "413140702",
                    "text": "关于「霄灯」…",
                    "response": [
                        {
                            "id": "413140703",
                            "speaker": "景明",
                            "text": "制作「霄灯」可是一门传统手艺，扎纸、入芯、置签、上漆…"
                        },
                        {
                            "id": "413140704",
                            "speaker": "景明",
                            "text": "…哈哈，你别打退堂鼓，如今活用「合成台」的话，「霄灯」的制作就方便很多。"
                        },
                        {
                            "id": "413140705",
                            "speaker": "景明",
                            "text": "但愿「霄灯」里的愿望不会因此变得廉价吧，哈哈。"
                        },
                        {
                            "id": "413140706",
                            "speaker": "景明",
                            "text": "「合成台」就在那边，不试试看吗？海灯节可是一年只有一次啊。"
                        }
                    ]
                },
                {
                    "id": "413140707",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "413140708",
                            "speaker": "景明",
                            "text": "愿薪火相传，美德不灭。"
                        }
                    ]
                }
            ]
        }
    ]
}