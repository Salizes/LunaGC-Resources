{
    "talkId": "7154205",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 7,
        "派蒙": 9,
        "闲云": 21
    },
    "dialogues": [
        {
            "id": "715420501",
            "speaker": "闲云",
            "text": "是你们啊。难得来一回，坐吧，喝茶。",
            "choices": [
                {
                    "id": "715420502",
                    "text": "您现在是师祖了？",
                    "response": [
                        {
                            "id": "715420503",
                            "speaker": "派蒙",
                            "text": "对喔，按仙人的时间观念，你收漱玉为徒应该是不久前的事？现在漱玉也有徒弟了！"
                        },
                        {
                            "id": "715420504",
                            "speaker": "闲云",
                            "text": "呵呵，是那小友太过讲礼，谁教他事理，他便认谁做师父。"
                        },
                        {
                            "id": "715420505",
                            "speaker": "闲云",
                            "text": "本仙的本意，是让漱玉有个玩伴。"
                        },
                        {
                            "id": "715420506",
                            "speaker": "闲云",
                            "text": "往常在璃月港转悠时，本仙也有察觉，漱玉的同龄人都有朋友，闲时有人聊聊天，遇见趣事有人同乐，自然是好事。"
                        },
                        {
                            "id": "715420507",
                            "speaker": "闲云",
                            "text": "但奥藏山毕竟不是市井之地，鲜有凡人近前，更不必说漱玉这个年纪的孩子。有时本仙也会担心，漱玉可曾被孤单困扰。"
                        },
                        {
                            "id": "715420508",
                            "speaker": "闲云",
                            "text": "那小友恭恭敬敬来访，与漱玉聊得还算投机，倒是令本仙欣喜。"
                        },
                        {
                            "id": "715420509",
                            "speaker": "闲云",
                            "text": "略有遗憾的是，那小友太过专注，从未主动谈及精进斗虫和机关术之外的事…"
                        },
                        {
                            "id": "715420510",
                            "speaker": "派蒙",
                            "text": "确实，除去斗虫，「花角玉将」能和我们聊的东西也不多吧，他就像是那种…「职业选手」？"
                        },
                        {
                            "id": "715420511",
                            "speaker": "闲云",
                            "text": "心无旁骛修习本领，值得褒扬，那便让漱玉领他入门，着眼于「花羽叶月神机」这类能在斗虫游艺派上用场的小机关。"
                        },
                        {
                            "id": "715420512",
                            "speaker": "闲云",
                            "text": "坊间有个说法是，教导他人，也是对自身学识的一种检验。如此一来，漱玉既有人闲聊，又能巩固所学本领，一举两得。"
                        },
                        {
                            "id": "715420513",
                            "speaker": "闲云",
                            "text": "我当这「师祖」倒也挺好。"
                        }
                    ]
                },
                {
                    "id": "715420514",
                    "text": "关于学习机关术…",
                    "response": [
                        {
                            "id": "715420515",
                            "speaker": "闲云",
                            "text": "怎么，你们也来兴趣了？"
                        },
                        {
                            "id": "715420516",
                            "speaker": "派蒙",
                            "text": "只是有些好奇，之前也见过不少你发明的机关嘛。想要学这种本领，难吗？"
                        },
                        {
                            "id": "715420517",
                            "speaker": "闲云",
                            "text": "仙家机关所循之理，所用之材，所需之能，皆有严苛要求。凡间工匠若想拟造，难如登天。"
                        },
                        {
                            "id": "715420518",
                            "speaker": "闲云",
                            "text": "见闻广博如你们，一时大概也难以理解…诸如「动源枢件」、「动力传导」、「机件循复」之类的概念。",
                            "choices": [
                                {
                                    "id": "715420519",
                                    "text": "术语听着就头疼…",
                                    "response": [
                                        {
                                            "id": "715420521",
                                            "speaker": "派蒙",
                                            "text": "两三个词就让我害怕了，果然关于机关的东西都很复杂！"
                                        },
                                        {
                                            "id": "715420522",
                                            "speaker": "闲云",
                                            "text": "无妨，术业有专攻，本仙尚未见过样样精通的全才。"
                                        },
                                        {
                                            "id": "715420523",
                                            "speaker": "闲云",
                                            "text": "不过，刚才正好提到了机关术的路线…那位小友也算是特例了。"
                                        },
                                        {
                                            "id": "715420524",
                                            "speaker": "闲云",
                                            "text": "他自然无法运用仙力，唯有先学凡间工匠的理论，打好基础，日后造出凡间尖端水准的机关后，再置入仙家的动力核心。"
                                        },
                                        {
                                            "id": "715420525",
                                            "speaker": "闲云",
                                            "text": "如此一来，或许能达成他追求的指标。"
                                        },
                                        {
                                            "id": "715420526",
                                            "speaker": "闲云",
                                            "text": "学习纯粹的仙术，若非奇才，定需百年起步。以凡间工匠之法，结合仙力核心，造出他所想的机关，也需三五十年的攻读。"
                                        },
                                        {
                                            "id": "715420527",
                                            "speaker": "派蒙",
                                            "text": "三五十年…三五十年？每天都学吗？"
                                        },
                                        {
                                            "id": "715420528",
                                            "speaker": "闲云",
                                            "text": "呵！唯有静心苦读之人，才能通悟真知灼见！"
                                        },
                                        {
                                            "id": "715420529",
                                            "speaker": "闲云",
                                            "text": "说来，本仙也无法想象，你们乖乖坐在学堂里，日复一日攻读课本的场景。",
                                            "choices": [
                                                {
                                                    "id": "715420530",
                                                    "text": "我现在暂时也没法想象…",
                                                    "response": [
                                                        {
                                                            "id": "715420532",
                                                            "speaker": "派蒙",
                                                            "text": "没错，世界上还有许多地方等着我们呢…制作机关这种复杂的事，就交给又厉害又有耐心的人吧！"
                                                        },
                                                        {
                                                            "id": "715420533",
                                                            "speaker": "派蒙",
                                                            "text": "至于「花角玉将」…希望他是个天才，快快学好机关术，别让一斗等到头发都白…"
                                                        },
                                                        {
                                                            "id": "715420534",
                                                            "speaker": "派蒙",
                                                            "text": "不对，一斗的头发不本来就是白的吗！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "715420531",
                                                    "text": "我还是喜欢旅行和冒险！"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "715420520",
                                    "text": "不造东西真不熟…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715420535",
                    "text": "好耶，是仙家好茶！",
                    "response": [
                        {
                            "id": "715420536",
                            "speaker": "派蒙",
                            "text": "嘿嘿，多谢留云仙人！"
                        },
                        {
                            "id": "715420537",
                            "speaker": "闲云",
                            "text": "呵呵，不必与本仙客气。"
                        },
                        {
                            "id": "715420538",
                            "speaker": "Black Screen",
                            "text": "和派蒙一同享用了闲云烹煮的好茶，只觉心旷神怡，疲惫一扫而空…"
                        }
                    ]
                }
            ]
        }
    ]
}