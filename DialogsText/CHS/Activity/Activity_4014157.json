{
    "talkId": "4014157",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "魈": 10
    },
    "dialogues": [
        {
            "id": "401415701",
            "speaker": "魈",
            "text": "#{NICKNAME}。"
        },
        {
            "id": "401415702",
            "speaker": "Player",
            "text": "你果然没进城。"
        },
        {
            "id": "401415703",
            "speaker": "魈",
            "text": "若你想问我是否见到海灯节的灯火与美景…你看，这座山后方便是璃月港。"
        },
        {
            "id": "401415704",
            "speaker": "魈",
            "text": "登高望远，能将夜幕下缓缓升起的风筝尽数收入眼底。"
        },
        {
            "id": "401415705",
            "speaker": "魈",
            "text": "…如此便好。"
        },
        {
            "id": "401415706",
            "speaker": "Player",
            "text": "好吧。"
        },
        {
            "id": "401415707",
            "speaker": "魈",
            "text": "早些时候邀请你来此地找我，是有一件事情想做。"
        },
        {
            "id": "401415708",
            "speaker": "魈",
            "text": "…陪我放一盏霄灯吧。"
        },
        {
            "id": "401415709",
            "speaker": "Player",
            "text": "是你亲手做的吗？"
        },
        {
            "id": "401415710",
            "speaker": "魈",
            "text": "嗯。"
        },
        {
            "id": "401415711",
            "speaker": "魈",
            "text": "技艺不精之处…莫要笑我。"
        },
        {
            "id": "401415712",
            "speaker": "Player",
            "text": "怎么会？很厉害哦。"
        },
        {
            "id": "401415713",
            "speaker": "魈",
            "text": "…嗯，你果然会这样说。"
        },
        {
            "id": "401415714",
            "speaker": "魈",
            "text": "那我便松手了。"
        }
    ]
}