{
    "talkId": "4019604",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "伊法": 4,
        "咔库库": 1,
        "基尼奇": 2,
        "欧洛伦": 4,
        "阿乔": 3
    },
    "dialogues": [
        {
            "id": "401960401",
            "speaker": "欧洛伦",
            "text": "之前，那位粉色头发的小姐给阿乔和咔库库照了合影。"
        },
        {
            "id": "401960402",
            "speaker": "伊法",
            "text": "听你这语气有些遗憾啊，难道也想加入吗？"
        },
        {
            "id": "401960403",
            "speaker": "欧洛伦",
            "text": "一开始是有点。"
        },
        {
            "id": "401960404",
            "speaker": "欧洛伦",
            "text": "但看到阿乔扭捏的样子，我又觉得自己可能无法融入它们。"
        },
        {
            "id": "401960405",
            "speaker": "阿乔",
            "text": "哈？！你不早说？"
        },
        {
            "id": "401960406",
            "speaker": "阿乔",
            "text": "我宁愿搂着你的脖子合影，也不想和那玩意儿出现在同一个画面上！"
        },
        {
            "id": "401960407",
            "speaker": "欧洛伦",
            "text": "真的吗？那你现在也有机会，来吧。"
        },
        {
            "id": "401960408",
            "speaker": "阿乔",
            "text": "稍等片刻，我的「怒火」马上到你脸上。"
        },
        {
            "id": "401960409",
            "speaker": "咔库库",
            "text": "我来保护，哥们！"
        },
        {
            "id": "401960410",
            "speaker": "伊法",
            "text": "……"
        },
        {
            "id": "401960411",
            "speaker": "伊法",
            "text": "基尼奇，你有没有想过永远把这帮家伙留在这片海域。"
        },
        {
            "id": "401960412",
            "speaker": "基尼奇",
            "text": "想过。但鉴于阿乔的特殊性，这可能会算作一种跨国走私行为。"
        },
        {
            "id": "401960413",
            "speaker": "基尼奇",
            "text": "我不能知法犯法。"
        },
        {
            "id": "401960414",
            "speaker": "伊法",
            "text": "哈哈，看来大家都有生活的难处呢。"
        }
    ]
}