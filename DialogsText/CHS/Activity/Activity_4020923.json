{
    "talkId": "4020923",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Black Screen": 2,
        "Player": 6,
        "克洛琳德": 13,
        "派蒙": 8
    },
    "dialogues": [
        {
            "id": "402092301",
            "speaker": "克洛琳德",
            "text": "#你们好，{NICKNAME}和派蒙。又在异国他乡见面了，真令人高兴…"
        },
        {
            "id": "402092302",
            "speaker": "克洛琳德",
            "text": "…想喝咖啡吗？",
            "choices": [
                {
                    "id": "402092303",
                    "text": "那就来一杯吧！",
                    "response": [
                        {
                            "id": "402092304",
                            "speaker": "派蒙",
                            "text": "克洛琳德好客气！"
                        },
                        {
                            "id": "402092305",
                            "speaker": "派蒙",
                            "text": "说起来…最强决斗代理人亲手调制的咖啡，放在枫丹，应该只有特别厉害的人，才能有幸喝到吧？"
                        },
                        {
                            "id": "402092306",
                            "speaker": "派蒙",
                            "text": "如果挂名在咖啡馆里出售，肯定会被炒上高价！"
                        },
                        {
                            "id": "402092307",
                            "speaker": "克洛琳德",
                            "text": "感谢派蒙的肯定。其实，不必把这杯咖啡看得很有分量。"
                        },
                        {
                            "id": "402092308",
                            "speaker": "克洛琳德",
                            "text": "#一方面是我看摊太久，有些困倦，本来也要自己调一杯，另一方面是回报{NICKNAME}那两杯杰出的饮品。"
                        },
                        {
                            "id": "402092309",
                            "speaker": "克洛琳德",
                            "text": "#之前，我有幸观察到了{NICKNAME}调饮的娴熟手法，就想自己也试试看。"
                        },
                        {
                            "id": "402092310",
                            "speaker": "克洛琳德",
                            "text": "于是，回到枫丹后，我在常去的咖啡馆学习了基本手法，目前也算有点经验了。"
                        },
                        {
                            "id": "402092311",
                            "speaker": "Black Screen",
                            "text": "克洛琳德从行李中取出器具，动作利落地调制了三杯咖啡…"
                        },
                        {
                            "id": "402092312",
                            "speaker": "Black Screen",
                            "text": "派蒙尝了一口后，瞪大眼睛惊叹两声，咕噜咕噜就将其喝完了。而你从中品出了有别于传统枫丹咖啡的风味…"
                        },
                        {
                            "id": "402092313",
                            "speaker": "派蒙",
                            "text": "神奇的感觉，焦香里有股甜味？换成苦苦的咖啡，我肯定喝不了这么痛快，克洛琳德的这杯完全不一样！"
                        },
                        {
                            "id": "402092314",
                            "speaker": "克洛琳德",
                            "text": "就像面对浊水幻灵和重甲蟹时，运用刺剑的方法需要做出区别，调制咖啡也是一个道理。"
                        },
                        {
                            "id": "402092315",
                            "speaker": "克洛琳德",
                            "text": "给派蒙的咖啡，特别选用了苦味较淡的品种，还加入了可可与甜牛奶调味。",
                            "choices": [
                                {
                                    "id": "402092316",
                                    "text": "而我的这杯结合了果汁。",
                                    "response": [
                                        {
                                            "id": "402092318",
                                            "speaker": "克洛琳德",
                                            "text": "是的，我想，适当的酸甜能与咖啡的功效结合，为你的身体带来更多活力，以便应对之后管理展会的麻烦事。"
                                        },
                                        {
                                            "id": "402092319",
                                            "speaker": "克洛琳德",
                                            "text": "单加桔汁反而会让咖啡的苦味更干涩，所以我就用苹果汁来适当调和。看你的反应，似乎还不错？",
                                            "choices": [
                                                {
                                                    "id": "402092320",
                                                    "text": "非常满意，是很棒的咖啡！",
                                                    "response": [
                                                        {
                                                            "id": "402092322",
                                                            "speaker": "派蒙",
                                                            "text": "喔哦哦！感觉克洛琳德的水平已经达到了专业级了！"
                                                        },
                                                        {
                                                            "id": "402092323",
                                                            "speaker": "克洛琳德",
                                                            "text": "论手法，咖啡师们还掌握着许多高深技巧，不过我觉得，不必投入太多时间，追求过高的技巧。"
                                                        },
                                                        {
                                                            "id": "402092324",
                                                            "speaker": "克洛琳德",
                                                            "text": "只要能应付日常的需求，比如，没空去店里慢慢享用咖啡时，自己调上一杯，快捷提神就好。"
                                                        },
                                                        {
                                                            "id": "402092325",
                                                            "speaker": "派蒙",
                                                            "text": "还真是克洛琳德的风格呢…"
                                                        },
                                                        {
                                                            "id": "402092326",
                                                            "speaker": "派蒙",
                                                            "text": "不过也有道理，毕竟克洛琳德不像我们，什么样的工作都会去尝试，点到即止就是最好的！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "402092321",
                                                    "text": "作为兴趣作品已经无可挑剔了。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "402092317",
                                    "text": "我的咖啡加入了苹果和桔汁？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "402092327",
                    "text": "不麻烦你了…",
                    "response": [
                        {
                            "id": "402092328",
                            "speaker": "派蒙",
                            "text": "谢谢克洛琳德！我们先去别的地方看看，不打扰你和娜维娅了！"
                        },
                        {
                            "id": "402092329",
                            "speaker": "克洛琳德",
                            "text": "嗯，其实我们不算很忙，你们空闲的话，随时可以过来。"
                        }
                    ]
                }
            ]
        }
    ]
}