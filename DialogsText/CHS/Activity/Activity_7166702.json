{
    "talkId": "7166702",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "兰吉特": 10
    },
    "dialogues": [
        {
            "id": "716670201",
            "speaker": "兰吉特",
            "text": "咱们这就下去？",
            "choices": [
                {
                    "id": "716670202",
                    "text": "走吧。"
                },
                {
                    "id": "716670203",
                    "text": "话说爆炎树的果实应该怎么吃？",
                    "response": [
                        {
                            "id": "716670204",
                            "speaker": "兰吉特",
                            "text": "在野外就用简单的料理方法吧。先修整一下果实的形状，小心不要烫伤。"
                        },
                        {
                            "id": "716670205",
                            "speaker": "兰吉特",
                            "text": "之后切开一小块，在果实中间挖出一块凹槽，放一两块黄油，加入骗骗花蜜和你喜欢的香料，再来点火烤一烤就好啦。"
                        },
                        {
                            "id": "716670206",
                            "speaker": "兰吉特",
                            "text": "相比苹果，爆炎树的果实显然风味更独特，真是令人灼伤的美味…"
                        }
                    ]
                },
                {
                    "id": "716670207",
                    "text": "关于嵴锋龙…",
                    "response": [
                        {
                            "id": "716670208",
                            "speaker": "兰吉特",
                            "text": "唉，小嵴锋龙真的很可爱，圆溜溜的眼睛，圆滚滚的肚皮…"
                        },
                        {
                            "id": "716670209",
                            "speaker": "兰吉特",
                            "text": "之前也说过，从须弥进入纳塔的话，多半会先遇到它们，纳塔东边的矿山是它们的栖息地。"
                        },
                        {
                            "id": "716670210",
                            "speaker": "兰吉特",
                            "text": "矿山也住着纳茨{RUBY#[D]回声之子}卡延的一族，他们擅长开采和挖掘，也懂得辨别宝石的价值。"
                        },
                        {
                            "id": "716670211",
                            "speaker": "兰吉特",
                            "text": "听起来很闷对吧？其实完全不是这样，那可是一群很愉快的家伙，特别是他们的族长…"
                        },
                        {
                            "id": "716670212",
                            "speaker": "兰吉特",
                            "text": "总之，如果你今后也有去纳塔的打算，千万别错过…我是说，千万别错过小嵴锋龙了！你一定会喜欢上那些小家伙的。"
                        }
                    ]
                },
                {
                    "id": "716670213",
                    "text": "还有别的事，稍候。",
                    "response": [
                        {
                            "id": "716670214",
                            "speaker": "兰吉特",
                            "text": "没问题，我就在这儿等你。"
                        }
                    ]
                }
            ]
        }
    ]
}