{
    "talkId": "7451402",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "朝雾": 10
    },
    "dialogues": [
        {
            "id": "745140201",
            "speaker": "朝雾",
            "text": "#{NICKNAME}，取材的事又要麻烦你啦。",
            "choices": [
                {
                    "id": "745140202",
                    "text": "你会在枫丹待多久？",
                    "response": [
                        {
                            "id": "745140203",
                            "speaker": "朝雾",
                            "text": "唔，我才刚到枫丹不久呢，还没想过这件事。"
                        },
                        {
                            "id": "745140204",
                            "speaker": "朝雾",
                            "text": "我都没去过枫丹的水下呢。我听说，枫丹的水下有好多壮观的景色。"
                        },
                        {
                            "id": "745140205",
                            "speaker": "朝雾",
                            "text": "就是…我还要专门去学习潜水。有好多东西要记住，太难了…"
                        },
                        {
                            "id": "745140206",
                            "speaker": "朝雾",
                            "text": "我还是先把枫丹的陆上景色都游览一遍吧。"
                        },
                        {
                            "id": "745140207",
                            "speaker": "朝雾",
                            "text": "对了，还要寄一封信回去。呜哇…我不会被骂吧…"
                        }
                    ]
                },
                {
                    "id": "745140208",
                    "text": "枫丹人喜欢你的画吗？",
                    "response": [
                        {
                            "id": "745140209",
                            "speaker": "朝雾",
                            "text": "看那几位约稿的作家老师反映，他们对我的画还挺满意的。"
                        },
                        {
                            "id": "745140210",
                            "speaker": "朝雾",
                            "text": "不过话说回来，枫丹的小说和稻妻的小说还真是不一样呢。"
                        },
                        {
                            "id": "745140211",
                            "speaker": "朝雾",
                            "text": "特别是人名！唉，对我来说实在是太难记了…"
                        }
                    ]
                },
                {
                    "id": "745140212",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "745140213",
                            "speaker": "朝雾",
                            "text": "嗯，再见。取材的事情就拜托你啦。"
                        }
                    ]
                }
            ]
        }
    ]
}