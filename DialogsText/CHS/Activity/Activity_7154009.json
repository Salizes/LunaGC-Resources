{
    "talkId": "7154009",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "刻晴": 10
    },
    "dialogues": [
        {
            "id": "715400901",
            "speaker": "刻晴",
            "text": "呼…吹吹风之后，总算清醒些了…",
            "choices": [
                {
                    "id": "715400902",
                    "text": "刻晴，这封祝柬送你。",
                    "response": [
                        {
                            "id": "715400903",
                            "speaker": "刻晴",
                            "text": "多谢。我原本还想着，快些写一封祝柬送你，别误了时间。"
                        },
                        {
                            "id": "715400904",
                            "speaker": "刻晴",
                            "text": "没想到…刚坐下不久，就被埋进了公山文海里，抬头一看，祝柬才起了个头…",
                            "choices": [
                                {
                                    "id": "715400905",
                                    "text": "心意领了。",
                                    "response": [
                                        {
                                            "id": "715400906",
                                            "speaker": "刻晴",
                                            "text": "心意也要落在实处才好。等我写好祝柬之后，再送给你。"
                                        },
                                        {
                                            "id": "715400908",
                                            "speaker": "刻晴",
                                            "text": "虽然边界之事已了结，凝光也用祭仪的名号，将这件事盖了过去，不至于让大家不安…"
                                        },
                                        {
                                            "id": "715400909",
                                            "speaker": "刻晴",
                                            "text": "但那晚阵法的动静还是有点大，引起了一些猎户和山中居士的注意。"
                                        },
                                        {
                                            "id": "715400910",
                                            "speaker": "刻晴",
                                            "text": "如果这些瞥见了大阵与死气，却又不知事情全貌的人，生造出些闲言碎语，那就不太好了…"
                                        },
                                        {
                                            "id": "715400911",
                                            "speaker": "刻晴",
                                            "text": "呼…大过节的，说这些做什么。你也奔波辛苦了很久，快，先吃些点心吧，我刚从新月轩买的。"
                                        },
                                        {
                                            "id": "715400912",
                                            "speaker": "刻晴",
                                            "text": "我稍后还要去和甘雨商讨一些事宜。等祝柬写完，我再去送给你。"
                                        }
                                    ]
                                },
                                {
                                    "id": "715400907",
                                    "text": "现在还在工作？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715400913",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715400914",
                            "speaker": "刻晴",
                            "text": "再见，祝你海灯节快乐。"
                        }
                    ]
                }
            ]
        }
    ]
}