{
    "talkId": "7451103",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 7,
        "谢妮": 16
    },
    "dialogues": [
        {
            "id": "745110301",
            "speaker": "谢妮",
            "text": "怎么样，前辈做的远程炮台如何？",
            "choices": [
                {
                    "id": "745110302",
                    "text": "挺好的。",
                    "response": [
                        {
                            "id": "745110304",
                            "speaker": "谢妮",
                            "text": "嗯，那就好。"
                        },
                        {
                            "id": "745110305",
                            "speaker": "Player",
                            "text": "感觉你好像兴致不高？"
                        },
                        {
                            "id": "745110306",
                            "speaker": "谢妮",
                            "text": "啊…抱歉。怎么说呢，并不是不喜欢啦，而是我一看设计图，就知道它做出来是什么样子了。"
                        },
                        {
                            "id": "745110307",
                            "speaker": "谢妮",
                            "text": "只是对弗雷瑞斯前辈来说应该稍微有些吃力。我看他有点紧张。其实没什么事，出意外的概率很低。"
                        },
                        {
                            "id": "745110308",
                            "speaker": "谢妮",
                            "text": "「扮演天才」真是一件吃力的事情，你说呢？"
                        },
                        {
                            "id": "745110309",
                            "speaker": "Player",
                            "text": "什么意思？"
                        },
                        {
                            "id": "745110310",
                            "speaker": "谢妮",
                            "text": "前辈不是真正的天才啦。要我评价的话，大概只能算思维比较活跃、有很多想法的普通人吧。"
                        },
                        {
                            "id": "745110311",
                            "speaker": "谢妮",
                            "text": "像什么拒绝枫丹科学院三次之类的，其实也是酒后说的大话而已。为了圆这个谎，他也真是费了好一番努力。"
                        },
                        {
                            "id": "745110312",
                            "speaker": "谢妮",
                            "text": "哦对了，这一点还请帮我保密，弗雷瑞斯前辈还以为我没看出来呢。"
                        },
                        {
                            "id": "745110313",
                            "speaker": "Player",
                            "text": "你是怎么发现的？"
                        },
                        {
                            "id": "745110314",
                            "speaker": "谢妮",
                            "text": "可能是因为我真的拒绝过枫丹科学院的邀请吧。所以我大概清楚那里的标准，弗雷瑞斯前辈…嗯…还差不少呢。"
                        },
                        {
                            "id": "745110315",
                            "speaker": "Player",
                            "text": "你在陪他演戏吗？"
                        },
                        {
                            "id": "745110316",
                            "speaker": "谢妮",
                            "text": "可以这么说啦。我来扮演一个什么都不懂的新人，问他各种各样的问题。"
                        },
                        {
                            "id": "745110317",
                            "speaker": "谢妮",
                            "text": "有时候我会故意问一些比较困难的问题，然后满怀期待地看着他，他就会竭尽全力掩饰自己窘迫的表情。"
                        },
                        {
                            "id": "745110318",
                            "speaker": "谢妮",
                            "text": "然后我再「不经意」地给他一点提示，他立刻背过身去咳嗽一声，装作早就知道的样子——"
                        },
                        {
                            "id": "745110319",
                            "speaker": "谢妮",
                            "text": "这个过程很好玩。所以我不打算戳穿弗雷瑞斯前辈，看他忙得团团转，是我现在最大的乐趣。"
                        },
                        {
                            "id": "745110320",
                            "speaker": "Player",
                            "text": "看来这场戏还会演下去。"
                        },
                        {
                            "id": "745110321",
                            "speaker": "谢妮",
                            "text": "嗯。大概会演很久、很久吧。"
                        },
                        {
                            "id": "745110322",
                            "speaker": "谢妮",
                            "text": "只要我不说破，他肯定看不出来。他还以为带新人聚餐那天是我们第一次见面，但其实很久前我就见过他了。"
                        },
                        {
                            "id": "745110323",
                            "speaker": "谢妮",
                            "text": "他这个人神经很大条，甚至不记得——或者说「不在意」当初那颗子弹是替谁挡的。"
                        }
                    ]
                },
                {
                    "id": "745110303",
                    "text": "比较新奇的体验。"
                }
            ]
        }
    ]
}