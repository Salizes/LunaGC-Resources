{
    "talkId": "7565805",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 4,
        "赫卡": 6
    },
    "dialogues": [
        {
            "id": "756580501",
            "speaker": "赫卡",
            "text": "准备好挑战巨大螃蟹了吗？",
            "choices": [
                {
                    "id": "756580502",
                    "text": "现在准备一下。"
                },
                {
                    "id": "756580503",
                    "text": "想随便聊聊…",
                    "response": [
                        {
                            "id": "756580504",
                            "speaker": "赫卡",
                            "text": "挪德卡莱也有蟹类，不过和它长得很不一样。唔，多拍几张画片好了，玫熙说不定会比较喜欢枫丹的螃蟹呢。"
                        },
                        {
                            "id": "756580505",
                            "speaker": "赫卡",
                            "text": "不过话说回来，究竟是因为有了热泉才演化出了这样的物种，还是帝皇的存在让泉水也为之沸腾呢？"
                        },
                        {
                            "id": "756580506",
                            "speaker": "Player",
                            "text": "关于挪德卡莱…"
                        },
                        {
                            "id": "756580507",
                            "speaker": "赫卡",
                            "text": "硬要说的话，是很危险但也生机勃勃的地方？不过从最近的动向来看，可能危险的部分更多一些。"
                        },
                        {
                            "id": "756580508",
                            "speaker": "赫卡",
                            "text": "在我离开之前，愚人众就运来了很多建筑材料，听说什么「执行官」也在，不知道是有什么打算。"
                        },
                        {
                            "id": "756580509",
                            "speaker": "赫卡",
                            "text": "而且听说北边的情况也不是很好，深渊的力量似乎在扩大影响…卡嘉也让我回程时不要从北边取道。"
                        }
                    ]
                },
                {
                    "id": "756580510",
                    "text": "稍等。"
                }
            ]
        }
    ]
}