{
    "talkId": "7750112",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 8,
        "岚姐": 20
    },
    "dialogues": [
        {
            "id": "775011201",
            "speaker": "岚姐",
            "text": "就靠你让这场比赛快速落幕了…不过，这次的战斗项目还是有些特殊的，稍微留个心眼。",
            "choices": [
                {
                    "id": "775011202",
                    "text": "那就开打吧。",
                    "response": [
                        {
                            "id": "775011203",
                            "speaker": "岚姐",
                            "text": "也不必太用力啊，到时候把秘境全拆了也不好。"
                        }
                    ]
                },
                {
                    "id": "775011204",
                    "text": "比赛间隙打算做什么？",
                    "response": [
                        {
                            "id": "775011205",
                            "speaker": "岚姐",
                            "text": "请玉霞喝两杯，答谢她在枫丹给我买的这副墨镜。"
                        },
                        {
                            "id": "775011206",
                            "speaker": "岚姐",
                            "text": "…喂，别用那种眼神看着我啊。"
                        },
                        {
                            "id": "775011207",
                            "speaker": "岚姐",
                            "text": "我还要在至冬待上很久呢，必须习惯用这里的火水取暖，先歇会儿。"
                        },
                        {
                            "id": "775011208",
                            "speaker": "岚姐",
                            "text": "得多请教请教玉霞，毕竟她常年待在龙脊雪山，这方面的经验都能写出一套系列丛书了。"
                        }
                    ]
                },
                {
                    "id": "775011209",
                    "text": "关于委托和冒险家等级…",
                    "response": [
                        {
                            "id": "775011210",
                            "speaker": "岚姐",
                            "text": "哦？怎么突然聊到这个？",
                            "choices": [
                                {
                                    "id": "775011211",
                                    "text": "因为平常没怎么在意委托等级。",
                                    "response": [
                                        {
                                            "id": "775011213",
                                            "speaker": "岚姐",
                                            "text": "不用特别计较，只是一种简单的叫法，冒险家能独立完成哪种水平的委托，目前就暂称。"
                                        },
                                        {
                                            "id": "775011214",
                                            "speaker": "岚姐",
                                            "text": "猜你还想问…平时给你派发的委托，都是什么水平。"
                                        },
                                        {
                                            "id": "775011215",
                                            "speaker": "岚姐",
                                            "text": "像是坊间有着「攀高危险」别称的丘丘哨站讨伐行动，属于B级委托的典例。"
                                        },
                                        {
                                            "id": "775011216",
                                            "speaker": "岚姐",
                                            "text": "按协会的标准，建议至少十六名普通冒险家与战士组成队伍行动，并且需要不低于六名射术精良的射手。"
                                        },
                                        {
                                            "id": "775011217",
                                            "speaker": "岚姐",
                                            "text": "其中六人牵制哨站中可能出现的丘丘暴徒，四人应对普通丘丘人。"
                                        },
                                        {
                                            "id": "775011218",
                                            "speaker": "岚姐",
                                            "text": "六名射手全速拿下哨塔上的丘丘弩手后，协助处理丘丘暴徒，直到使其力竭倒下，整支队伍再清扫营地。"
                                        },
                                        {
                                            "id": "775011219",
                                            "speaker": "岚姐",
                                            "text": "整场战斗可能持续三到五个小时，算是一场消耗战。"
                                        },
                                        {
                                            "id": "775011220",
                                            "speaker": "岚姐",
                                            "text": "如果有条件，最好配属随队行动的厨师，战后及时补充能量，防止丘丘人的援兵反扑。",
                                            "choices": [
                                                {
                                                    "id": "775011221",
                                                    "text": "对我来说好像没这么麻烦…",
                                                    "response": [
                                                        {
                                                            "id": "775011223",
                                                            "speaker": "岚姐",
                                                            "text": "所以说，别太计较这个评级。以现在的眼光看，它显得有点粗放。"
                                                        },
                                                        {
                                                            "id": "775011224",
                                                            "speaker": "岚姐",
                                                            "text": "玉霞也反馈过，同样是B级委托，在雪山处理一个丘丘营地，和普通地带的「攀高危险」完全不是一码事。"
                                                        },
                                                        {
                                                            "id": "775011225",
                                                            "speaker": "岚姐",
                                                            "text": "我们建议在等级后面加上具体的难度分值，比如B级是601到700分，这样才能让冒险家们更精准地评估任务难度。"
                                                        },
                                                        {
                                                            "id": "775011226",
                                                            "speaker": "岚姐",
                                                            "text": "这一点，等到赛事结束后的会议上，你就能听到讨论了。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "775011222",
                                                    "text": "平常随便打打就搞定了…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "775011212",
                                    "text": "因为这次听说了冒险家的评级。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "775011227",
                    "text": "我现在身经百战了，不怕。",
                    "response": [
                        {
                            "id": "775011228",
                            "speaker": "岚姐",
                            "text": "也对，纸面上的交锋也是交锋。那就尽情发挥吧，你这六边形战士。"
                        }
                    ]
                }
            ]
        }
    ]
}