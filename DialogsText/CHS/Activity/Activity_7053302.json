    "dialogues": [
        {
            "id": "705330201",
            "speaker": "菲利斯·尤格",
            "text": "旅行者，怎么样？你是想来尝试拼接一下这幅「械画」吗？",
            "choices": [
                {
                    "id": "705330202",
                    "text": "想要试试。",
                    "response": [
                        {
                            "id": "705330203",
                            "speaker": "菲利斯·尤格",
                            "text": "哈哈哈，好，我相信以您的聪明才智，这幅「械画」绝对难不倒您。"
                        },
                        {
                            "id": "705330204",
                            "speaker": "菲利斯·尤格",
                            "text": "「械画」就放在旁边，您可以直接去试试。"
                        }
                    ]
                },
                {
                    "id": "705330205",
                    "text": "还有别的事。",
                    "response": [
                        {
                            "id": "705330206",
                            "speaker": "菲利斯·尤格",
                            "text": "呃…没问题，等您有空了再来玩也行，反正我最近要一直呆在这…"
                        }
                    ]
                }
            ]
        }
    ]
}