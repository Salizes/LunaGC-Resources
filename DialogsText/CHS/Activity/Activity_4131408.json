{
    "talkId": "4131408",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "宜年": 6
    },
    "dialogues": [
        {
            "id": "413140801",
            "speaker": "宜年",
            "text": "嘿，客官，要来些海灯节特色小吃吗？错过了可就要等明年咯！",
            "choices": [
                {
                    "id": "413140802",
                    "text": "我想买些吃的。",
                    "response": [
                        {
                            "id": "413140803",
                            "speaker": "宜年",
                            "text": "好嘞！菜单上写的能做，你们想吃什么直接说，我也能做！"
                        }
                    ]
                },
                {
                    "id": "413140804",
                    "text": "生意怎么样？",
                    "response": [
                        {
                            "id": "413140805",
                            "speaker": "宜年",
                            "text": "哈哈，多谢关心，还挺红火的。"
                        },
                        {
                            "id": "413140806",
                            "speaker": "宜年",
                            "text": "果然我做的没错，比起整天动歪脑筋琢磨怎么打广告，把菜做好才是硬道理。"
                        },
                        {
                            "id": "413140807",
                            "speaker": "宜年",
                            "text": "总之，这是我的原则，好的东西不需要宣传，我是不会接受望雅那些无聊的营业建议的。"
                        }
                    ]
                },
                {
                    "id": "413140808",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "413140809",
                            "speaker": "宜年",
                            "text": "客官慢走，欢迎下次光临！"
                        }
                    ]
                }
            ]
        }
    ]
}