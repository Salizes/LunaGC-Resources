{
    "talkId": "7154033",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Black Screen": 1,
        "Player": 4,
        "提纳里": 11
    },
    "dialogues": [
        {
            "id": "715403301",
            "speaker": "提纳里",
            "text": "买些什么好呢…",
            "choices": [
                {
                    "id": "715403302",
                    "text": "这份祝柬送给你。",
                    "response": [
                        {
                            "id": "715403303",
                            "speaker": "提纳里",
                            "text": "#{NICKNAME}，没想到会在这里遇见你。谢谢你的祝柬，很漂亮。"
                        },
                        {
                            "id": "715403304",
                            "speaker": "Player",
                            "text": "海灯节玩得开心吗？"
                        },
                        {
                            "id": "715403305",
                            "speaker": "提纳里",
                            "text": "我和赛诺都玩得很开心，尝了不少好吃的，还买了不少礼物。"
                        },
                        {
                            "id": "715403306",
                            "speaker": "提纳里",
                            "text": "但是…这海灯节的璃月，人的确是太多了，在街上待太久，我的耳朵都有些疼。"
                        },
                        {
                            "id": "715403307",
                            "speaker": "提纳里",
                            "text": "所以，我就来这边稍微休息一下。"
                        },
                        {
                            "id": "715403308",
                            "speaker": "提纳里",
                            "text": "至于赛诺…他说自己要考虑一些事情，想去一个人呆一会。"
                        },
                        {
                            "id": "715403309",
                            "speaker": "Player",
                            "text": "他…又想到了新的笑话…"
                        },
                        {
                            "id": "715403310",
                            "speaker": "Black Screen",
                            "text": "将赛诺刚刚所讲的，有关于「祝柬」的冷笑话，告诉了提纳里…"
                        },
                        {
                            "id": "715403311",
                            "speaker": "提纳里",
                            "text": "……"
                        },
                        {
                            "id": "715403312",
                            "speaker": "提纳里",
                            "text": "唉…我就知道…"
                        },
                        {
                            "id": "715403313",
                            "speaker": "提纳里",
                            "text": "谢谢你告诉我。我等会去找赛诺的时候，至少能有点心理准备…"
                        },
                        {
                            "id": "715403314",
                            "speaker": "提纳里",
                            "text": "再次谢谢你的祝柬，很漂亮，我会收藏好的。"
                        }
                    ]
                },
                {
                    "id": "715403315",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715403316",
                            "speaker": "提纳里",
                            "text": "嗯，我等会也要去找赛诺了。唉…希望他今天的灵感，不是那么充沛…"
                        }
                    ]
                }
            ]
        }
    ]
}