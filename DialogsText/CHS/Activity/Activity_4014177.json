    "dialogues": [
        {
            "id": "401417701",
            "speaker": "永安",
            "text": "你好，我…你…猫…阿嚏！"
        },
        {
            "id": "401417702",
            "speaker": "永安",
            "text": "对不起…你知道今年的主题是风筝，偶尔会有人来码头试飞…"
        },
        {
            "id": "401417703",
            "speaker": "永安",
            "text": "有时风筝没飞起来，倒是被猫儿们叼走了…"
        },
        {
            "id": "401417704",
            "speaker": "永安",
            "text": "我得帮他们把丢失的风筝找回来…猫…阿、阿嚏！"
        }
    ]
