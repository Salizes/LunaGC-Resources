{
    "talkId": "7068309",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "艾玛托": 12
    },
    "dialogues": [
        {
            "id": "706830901",
            "speaker": "艾玛托",
            "text": "嗯嗯嗯，如果装上尾翼的话，稳定性说不定就能…哦哦，你好你好，荣誉骑士大人！第七小队武器官艾玛托报到！有什么指示吗？",
            "choices": [
                {
                    "id": "706830902",
                    "text": "你在做什么？",
                    "response": [
                        {
                            "id": "706830903",
                            "speaker": "艾玛托",
                            "text": "报告！和往常一样，我正在思考新的炸弹构造！以及…按照方妮雅的要求，正在「安安静静地进行推演，不要损伤她的耳朵」！",
                            "choices": [
                                {
                                    "id": "706830904",
                                    "text": "呃，炸弹的构造？",
                                    "response": [
                                        {
                                            "id": "706830905",
                                            "speaker": "艾玛托",
                                            "text": "是的！荣誉骑士大人，您应该也见证过火花骑士那优美而华丽的「蹦蹦炸弹」吧？"
                                        },
                                        {
                                            "id": "706830906",
                                            "speaker": "艾玛托",
                                            "text": "本人艾玛托，虽然只是个小小的、不值一提的普通炼金术士，但我依然有一个「梦想」！"
                                        },
                                        {
                                            "id": "706830907",
                                            "speaker": "艾玛托",
                                            "text": "不是钻研出「黄金与水银」化合的「构造」，而是钻研出能够接近「蹦蹦炸弹」二十分之一威力的「构造」！"
                                        },
                                        {
                                            "id": "706830908",
                                            "speaker": "艾玛托",
                                            "text": "所以，我一直在思考全新的设计方案！完美的爆速，猛烈的震波，简洁的工艺，宜人的成本…啊啊，光是想想就让我浑身颤抖…"
                                        },
                                        {
                                            "id": "706830909",
                                            "speaker": "艾玛托",
                                            "text": "啊，抱歉，一不小心又入迷了！总之，如果有什么炸弹…不对，如果有什么我能为您做的事，就请随时告诉我吧，荣誉骑士大人！"
                                        }
                                    ]
                                },
                                {
                                    "id": "706830910",
                                    "text": "好吧，那我不打扰你了…",
                                    "response": [
                                        {
                                            "id": "706830911",
                                            "speaker": "艾玛托",
                                            "text": "哦哦，好的好的！慢走，荣誉骑士大人！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "706830912",
                    "text": "推演有什么收获吗？",
                    "response": [
                        {
                            "id": "706830913",
                            "speaker": "艾玛托",
                            "text": "向您报告，荣誉骑士大人！我校准了几种炸弹的爆炸范围，并在假想环境中对爆破效果进行了测试！应该…也算是收获吧？"
                        },
                        {
                            "id": "706830914",
                            "speaker": "艾玛托",
                            "text": "就像之前说的，如果能将现实中的爆炸数据也上调十倍的话，就能达成最理想的效果了！"
                        },
                        {
                            "id": "706830915",
                            "speaker": "艾玛托",
                            "text": "毕竟我这么笨，搞不懂什么复杂的战术嘛。只要用心研究炸弹就好了！"
                        }
                    ]
                },
                {
                    "id": "706830916",
                    "text": "没事，你继续忙吧。",
                    "response": [
                        {
                            "id": "706830917",
                            "speaker": "艾玛托",
                            "text": "哦哦，好的好的！慢走，荣誉骑士大人！"
                        }
                    ]
                }
            ]
        }
    ]
}