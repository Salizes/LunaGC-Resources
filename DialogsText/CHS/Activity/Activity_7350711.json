{
    "talkId": "7350711",
    "total_dialogue_lines": 70,
    "speaker_counts": {
        "Player": 13,
        "咚咚小圆帽": 9,
        "派蒙": 39,
        "火一": 9
    },
    "dialogues": [
        {
            "id": "735071101",
            "speaker": "派蒙",
            "text": "「咚咚小圆帽」、「欢腾之火」，我们来陪你们玩啦！"
        },
        {
            "id": "735071102",
            "speaker": "派蒙",
            "text": "#{NICKNAME}，我们陪蕈兽伙伴们做些什么好呢？",
            "choices": [
                {
                    "id": "735071103",
                    "text": "投喂蕈兽伙伴？",
                    "response": [
                        {
                            "id": "735071104",
                            "speaker": "派蒙",
                            "text": "好！之前太开心了，还没注意到「妙妙琼脂」还有很多味道，这次我们留意一下两只蕈兽伙伴都喜欢什么口味吧！",
                            "choices": [
                                {
                                    "id": "735071105",
                                    "text": "投喂落落莓味的「妙妙琼脂」。",
                                    "response": [
                                        {
                                            "id": "735071106",
                                            "speaker": "咚咚小圆帽",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071107",
                                            "speaker": "火一",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071108",
                                            "speaker": "派蒙",
                                            "text": "喔！原来「咚咚小圆帽」喜欢落落莓的口感！"
                                        },
                                        {
                                            "id": "735071109",
                                            "speaker": "派蒙",
                                            "text": "以后也许可以用落落莓榨好多好多果汁，直接给「咚咚小圆帽」泡澡？"
                                        },
                                        {
                                            "id": "735071110",
                                            "speaker": "派蒙",
                                            "text": "倒是「欢腾之火」这边…它不喜欢甜食吗？好像也挺符合它帅气的作风呢！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071111",
                                    "text": "投喂薄荷味的「妙妙琼脂」。",
                                    "response": [
                                        {
                                            "id": "735071112",
                                            "speaker": "咚咚小圆帽",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071113",
                                            "speaker": "火一",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071114",
                                            "speaker": "派蒙",
                                            "text": "好欸！看来「咚咚小圆帽」喜欢薄荷的味道！"
                                        },
                                        {
                                            "id": "735071115",
                                            "speaker": "派蒙",
                                            "text": "如果种一片薄荷田，「咚咚小圆帽」会不会在里面玩得很开心？"
                                        },
                                        {
                                            "id": "735071116",
                                            "speaker": "派蒙",
                                            "text": "可是，冰冰凉凉的风味，好像不怎么能让「欢腾之火」满意？"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071117",
                                    "text": "投喂蟹黄味的「妙妙琼脂」。",
                                    "response": [
                                        {
                                            "id": "735071118",
                                            "speaker": "派蒙",
                                            "text": "哇啊，怎么还有这种口味？海妮耶的想法还真奇特呢…"
                                        },
                                        {
                                            "id": "735071119",
                                            "speaker": "咚咚小圆帽",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071120",
                                            "speaker": "火一",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071121",
                                            "speaker": "派蒙",
                                            "text": "咦？原来「咚咚小圆帽」连蟹黄的味道也喜欢！"
                                        },
                                        {
                                            "id": "735071122",
                                            "speaker": "派蒙",
                                            "text": "「欢腾之火」也开心起来了，看来蟹黄味就是两位蕈兽伙伴的最爱！"
                                        },
                                        {
                                            "id": "735071123",
                                            "speaker": "派蒙",
                                            "text": "虽然蟹黄制作起来有点麻烦，但为了两位蕈兽伙伴，也不算什么吧？我们以后多囤一些！"
                                        },
                                        {
                                            "id": "735071124",
                                            "speaker": "派蒙",
                                            "text": "等到知道了「妙妙琼脂」的制作方法，我们就可以亲手给它们做一顿大餐了！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071125",
                    "text": "向蕈兽伙伴比手势？",
                    "response": [
                        {
                            "id": "735071126",
                            "speaker": "派蒙",
                            "text": "哦？好像确实有人能用简单的手势让动物朋友领略自己的意思呢。"
                        },
                        {
                            "id": "735071127",
                            "speaker": "派蒙",
                            "text": "我觉得可以试试，以我们和蕈兽伙伴的默契，肯定没问题的！",
                            "choices": [
                                {
                                    "id": "735071128",
                                    "text": "向蕈兽伙伴们竖拇指。",
                                    "response": [
                                        {
                                            "id": "735071129",
                                            "speaker": "派蒙",
                                            "text": "好，我也竖拇指，夸夸乖乖的「咚咚小圆帽」和帅帅的「欢腾之火」。"
                                        },
                                        {
                                            "id": "735071130",
                                            "speaker": "咚咚小圆帽",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071131",
                                            "speaker": "火一",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071132",
                                            "speaker": "派蒙",
                                            "text": "嘿嘿，两位蕈兽伙伴都很开心，那以后我要多多给它们鼓励！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071133",
                                    "text": "竖起食指转圈圈。",
                                    "response": [
                                        {
                                            "id": "735071134",
                                            "speaker": "派蒙",
                                            "text": "是要让蕈兽伙伴们转圈的意思吗？会不会有点复杂？"
                                        },
                                        {
                                            "id": "735071135",
                                            "speaker": "咚咚小圆帽",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071136",
                                            "speaker": "火一",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071137",
                                            "speaker": "派蒙",
                                            "text": "蕈兽伙伴们居然真的开始打转了，好聪明！"
                                        },
                                        {
                                            "id": "735071138",
                                            "speaker": "派蒙",
                                            "text": "它们这样，好像在跳舞…如果我也会跳舞，说不定能让「咚咚小圆帽」当我的舞伴！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071139",
                                    "text": "右手指向派蒙，左手摸头。",
                                    "response": [
                                        {
                                            "id": "735071140",
                                            "speaker": "咚咚小圆帽",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071141",
                                            "speaker": "派蒙",
                                            "text": "呜啊，「咚咚小圆帽」好像真的要凑过来，让我摸它的头了！"
                                        },
                                        {
                                            "id": "735071142",
                                            "speaker": "派蒙",
                                            "text": "不过「欢腾之火」的意思是…"
                                        },
                                        {
                                            "id": "735071143",
                                            "speaker": "火一",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071144",
                                            "speaker": "派蒙",
                                            "text": "哇啊！「欢腾之火」好像要跳到我的脑袋上，快停下！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071145",
                    "text": "用不同的声音打招呼？",
                    "response": [
                        {
                            "id": "735071146",
                            "speaker": "派蒙",
                            "text": "你的意思是，模仿其他动物，看看蕈兽伙伴们会有什么反应吗？"
                        },
                        {
                            "id": "735071147",
                            "speaker": "派蒙",
                            "text": "嗯，我也很想知道，可以试试看！",
                            "choices": [
                                {
                                    "id": "735071148",
                                    "text": "吼吼！",
                                    "response": [
                                        {
                                            "id": "735071149",
                                            "speaker": "派蒙",
                                            "text": "这是什么声音啦，难道你在模仿驮兽吗？我都没有听出来…"
                                        },
                                        {
                                            "id": "735071150",
                                            "speaker": "咚咚小圆帽",
                                            "text": "♪~"
                                        },
                                        {
                                            "id": "735071151",
                                            "speaker": "火一",
                                            "text": "♫~"
                                        },
                                        {
                                            "id": "735071152",
                                            "speaker": "派蒙",
                                            "text": "咦，蕈兽伙伴们好像要凑过来了？"
                                        },
                                        {
                                            "id": "735071153",
                                            "speaker": "派蒙",
                                            "text": "难道它们也会有觉得冷的时候，还知道贴着驮兽取暖吗？"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071154",
                                    "text": "喵喵~",
                                    "response": [
                                        {
                                            "id": "735071155",
                                            "speaker": "派蒙",
                                            "text": "好耶，是猫猫，那我也来喵喵！"
                                        },
                                        {
                                            "id": "735071156",
                                            "speaker": "咚咚小圆帽",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071157",
                                            "speaker": "火一",
                                            "text": "？"
                                        },
                                        {
                                            "id": "735071158",
                                            "speaker": "派蒙",
                                            "text": "蕈兽伙伴们怎么一副好奇的样子？是不是没有见过猫，不熟悉？"
                                        },
                                        {
                                            "id": "735071159",
                                            "speaker": "派蒙",
                                            "text": "那以后，可以试着找几只小猫，和蕈兽伙伴们交朋友！"
                                        },
                                        {
                                            "id": "735071160",
                                            "speaker": "派蒙",
                                            "text": "说起来，能在雨林里生活的猫，是不是该叫「森林猫」？"
                                        },
                                        {
                                            "id": "735071161",
                                            "speaker": "派蒙",
                                            "text": "那和蕈兽伙伴们交了朋友的猫，就是「蘑菇猫」！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735071162",
                                    "text": "Ya！",
                                    "response": [
                                        {
                                            "id": "735071163",
                                            "speaker": "派蒙",
                                            "text": "喂喂，这个不是动物啦！而且说不定会让蕈兽伙伴们变得紧张！"
                                        },
                                        {
                                            "id": "735071164",
                                            "speaker": "咚咚小圆帽",
                                            "text": "！"
                                        },
                                        {
                                            "id": "735071165",
                                            "speaker": "火一",
                                            "text": "！"
                                        },
                                        {
                                            "id": "735071166",
                                            "speaker": "派蒙",
                                            "text": "果然，「咚咚小圆帽」和「欢腾之火」警惕起来了！"
                                        },
                                        {
                                            "id": "735071167",
                                            "speaker": "派蒙",
                                            "text": "#不要怕，不要怕，附近没有丘丘人哦，{NICKNAME}在和你们开玩笑啦。"
                                        },
                                        {
                                            "id": "735071168",
                                            "speaker": "派蒙",
                                            "text": "这样说来，就算我们睡着了，蕈兽伙伴们也可以帮我们放风，真可靠！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735071169",
                    "text": "待会儿再来和蕈兽伙伴们玩。",
                    "response": [
                        {
                            "id": "735071170",
                            "speaker": "派蒙",
                            "text": "唔，还有别的事要做吗？那我们动作快一点哦，早点回来陪「咚咚小圆帽」和「欢腾之火」玩！"
                        }
                    ]
                }
            ]
        }
    ]
}