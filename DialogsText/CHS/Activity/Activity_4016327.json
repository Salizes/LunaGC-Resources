{
    "talkId": "4016327",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "妮露": 4,
        "娜维娅": 4
    },
    "dialogues": [
        {
            "id": "401632701",
            "speaker": "娜维娅",
            "text": "妮露小姐，来，这边请，你先上车。"
        },
        {
            "id": "401632702",
            "speaker": "妮露",
            "text": "谢谢你，娜维娅小姐，但我就算不坐空中列车也没关系的…"
        },
        {
            "id": "401632703",
            "speaker": "娜维娅",
            "text": "妮露小姐你怕高吗？"
        },
        {
            "id": "401632704",
            "speaker": "妮露",
            "text": "欸？这倒还好…"
        },
        {
            "id": "401632705",
            "speaker": "娜维娅",
            "text": "那就没关系！害怕的话牵着我的手就好，再害怕的话两只手都给你牵。"
        },
        {
            "id": "401632706",
            "speaker": "娜维娅",
            "text": "别的地方可没有这种神奇的东西，不痛痛快快玩个过瘾怎么行？"
        },
        {
            "id": "401632707",
            "speaker": "妮露",
            "text": "你…你说得对！"
        },
        {
            "id": "401632708",
            "speaker": "妮露",
            "text": "大大的圆，呼…好，我做好准备了，我们走吧！"
        }
    ]
}