        {
            "id": "715182101",
            "speaker": "伊凡诺维奇",
            "text": "霄灯的光芒真是温暖…"
        },
        {
            "id": "715182102",
            "speaker": "伊凡诺维奇",
            "text": "而且不知道是不是因为音乐节的演出，舞台的灯光让霄灯更加明亮了。"
        },
        {
            "id": "715182103",
            "speaker": "伊凡诺维奇",
            "text": "这种炽热的温度，让人思念家乡的炉火啊…"
        }
