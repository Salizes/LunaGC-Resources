    "dialogues": [
        {
            "id": "735063101",
            "speaker": "丽莎",
            "text": "小可爱，我们又遇到了呀。"
        },
        {
            "id": "735063102",
            "speaker": "Player",
            "text": "丽莎在看什么？"
        },
        {
            "id": "735063103",
            "speaker": "丽莎",
            "text": "这家店的彩绘器皿做得非常精致，买几个放回去做装饰应该不错。"
        },
        {
            "id": "735063104",
            "speaker": "丽莎",
            "text": "还有那几个盘子，如果用它们来盛装茶点，就算是在工作的琴应该也会被吸引吧。",
            "choices": [
                {
                    "id": "735063105",
                    "text": "这些好像都不出售。",
                    "response": [
                        {
                            "id": "735063107",
                            "speaker": "丽莎",
                            "text": "不出售吗？哎呀，真是的，既然不出售，干嘛放在店里呢。"
                        },
                        {
                            "id": "735063108",
                            "speaker": "丽莎",
                            "text": "真让人失望，明明都这么漂亮…"
                        }
                    ]
                },
                {
                    "id": "735063106",
                    "text": "只是展示用的。"
                }
            ]
        }
    ]
}