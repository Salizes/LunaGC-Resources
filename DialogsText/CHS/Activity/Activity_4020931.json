{
    "talkId": "4020931",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 6,
        "石墩儿": 10
    },
    "dialogues": [
        {
            "id": "402093101",
            "speaker": "石墩儿",
            "text": "#这不是{NICKNAME}吗？我可真走运，刚来甲板上透气，就遇上了你…",
            "choices": [
                {
                    "id": "402093102",
                    "text": "平常你不在甲板上吗？",
                    "response": [
                        {
                            "id": "402093103",
                            "speaker": "石墩儿",
                            "text": "嗯，我是这艘船的轮机长，通俗点说，就是动力装置的负责人，所以一般闷在船舱里。",
                            "choices": [
                                {
                                    "id": "402093104",
                                    "text": "你要一直划桨吗？",
                                    "response": [
                                        {
                                            "id": "402093106",
                                            "speaker": "石墩儿",
                                            "text": "划桨？哈哈！看来工匠们的小巧思不仅骗过了外人，连自己人都被忽悠了，确实有效！"
                                        },
                                        {
                                            "id": "402093107",
                                            "speaker": "石墩儿",
                                            "text": "其实，「死兆星」级侧舷的桨是辅助性的部件，推动船体前进的主力，是由机关驱动的水上明轮和水下螺桨。"
                                        },
                                        {
                                            "id": "402093108",
                                            "speaker": "石墩儿",
                                            "text": "如果遇上了龙蜥之类灵巧的魔物，追不上，也逃不掉，可就尴尬了，只有明轮和螺桨带来的动力才能保证足够的航速。"
                                        },
                                        {
                                            "id": "402093109",
                                            "speaker": "石墩儿",
                                            "text": "侧舷的船桨其实也可直接连接动力机关，一般在海况极端恶劣时启动，用于提供力矩，辅助稳定船体，或是快速转向。"
                                        },
                                        {
                                            "id": "402093110",
                                            "speaker": "石墩儿",
                                            "text": "比如许久之前，迎战「跋掣」时，狂浪大作，「死兆星」号就按特别的规律差分驱动左右两舷的船桨，有效减轻了船体的横摇。"
                                        },
                                        {
                                            "id": "402093111",
                                            "speaker": "石墩儿",
                                            "text": "另外，如果有小型魔物接近船体的盲区，这些大力横挥的船桨也能拍击它们，避免它们贴上水线，爬上甲板。",
                                            "choices": [
                                                {
                                                    "id": "402093112",
                                                    "text": "还有这种事！",
                                                    "response": [
                                                        {
                                                            "id": "402093114",
                                                            "speaker": "石墩儿",
                                                            "text": "当然啊，船帆还是有用的，在狂风大作的外海，充分运用风能，可以节省不少开销！"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "402093113",
                                                    "text": "以前还真没留意…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "402093105",
                                    "text": "划桨可是个体力活…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "402093115",
                    "text": "那你先歇着。",
                    "response": [
                        {
                            "id": "402093116",
                            "speaker": "石墩儿",
                            "text": "好嘞，你慢走！"
                        }
                    ]
                }
            ]
        }
    ]
}