{
    "talkId": "4013614",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "神里绫华": 14
    },
    "dialogues": [
        {
            "id": "401361401",
            "speaker": "神里绫华",
            "text": "映影终于成功拍完了，我很高兴。这段时间…也承蒙你的关照。",
            "choices": [
                {
                    "id": "401361402",
                    "text": "绫华的演技很出色。",
                    "response": [
                        {
                            "id": "401361403",
                            "speaker": "神里绫华",
                            "text": "欸？谢谢…"
                        },
                        {
                            "id": "401361404",
                            "speaker": "神里绫华",
                            "text": "一开始，我抱着不能拖大家后腿的心情努力，想着如果是因为我的原因喊「停」就太丢人了。"
                        },
                        {
                            "id": "401361405",
                            "speaker": "神里绫华",
                            "text": "芙宁娜导演既专业又耐心，夏沃蕾和埃兰小姐也给了我很多细节上的帮助…这才渐渐得心应手起来。"
                        },
                        {
                            "id": "401361406",
                            "speaker": "神里绫华",
                            "text": "虽然这么说，但到了最后，大家…包括你也在夸奖我，我心里还是会有些不好意思的…"
                        }
                    ]
                },
                {
                    "id": "401361407",
                    "text": "最近玩得开心吗？",
                    "response": [
                        {
                            "id": "401361408",
                            "speaker": "神里绫华",
                            "text": "嗯，空下来的时候，我和宵宫一起逛了枫丹廷很多地方。"
                        },
                        {
                            "id": "401361409",
                            "speaker": "神里绫华",
                            "text": "优雅的街景，美丽的绿植与花卉，还有像身处梦中一般的海底世界…留下了闪闪发光的回忆。"
                        },
                        {
                            "id": "401361410",
                            "speaker": "神里绫华",
                            "text": "一想到在不久之前，或许你也曾恰好走过这些地方…就有些开心。"
                        }
                    ]
                },
                {
                    "id": "401361411",
                    "text": "绫华也辛苦了。",
                    "response": [
                        {
                            "id": "401361412",
                            "speaker": "神里绫华",
                            "text": "哪里。我平时…不太容易得到这样出门的机会。"
                        },
                        {
                            "id": "401361413",
                            "speaker": "神里绫华",
                            "text": "这次不仅交到了新朋友，还跟着大家学到了不少东西，非常有收获。我很珍惜。"
                        },
                        {
                            "id": "401361414",
                            "speaker": "神里绫华",
                            "text": "啊，对了，我还给社奉行的大家带了晶螺糕作为伴手礼。"
                        },
                        {
                            "id": "401361415",
                            "speaker": "神里绫华",
                            "text": "配着咖啡喝，呵呵…说不定就和现在在枫丹的感觉一样呢。"
                        }
                    ]
                },
                {
                    "id": "401361416",
                    "text": "回去路上慢点。",
                    "response": [
                        {
                            "id": "401361417",
                            "speaker": "神里绫华",
                            "text": "嗯，谢谢你的关心，你在冒险途中也要照顾好自己哦。"
                        },
                        {
                            "id": "401361418",
                            "speaker": "神里绫华",
                            "text": "有机会的话…我们稻妻再见。"
                        }
                    ]
                }
            ]
        }
    ]
}