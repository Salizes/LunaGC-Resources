{
    "talkId": "7154204",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "派蒙": 6,
        "漱玉": 10
    },
    "dialogues": [
        {
            "id": "715420401",
            "speaker": "漱玉",
            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}和派蒙，没想到你们也很擅长斗虫！",
            "choices": [
                {
                    "id": "715420402",
                    "text": "没错，我一直是斗虫高手。",
                    "response": [
                        {
                            "id": "715420403",
                            "speaker": "派蒙",
                            "text": "虽然以前大多是被放牛的拉着在斗虫啦…"
                        },
                        {
                            "id": "715420404",
                            "speaker": "漱玉",
                            "text": "这种游艺非常有趣！以后要是有机会去稻妻玩，我也想尝试一下原本的斗虫！"
                        },
                        {
                            "id": "715420405",
                            "speaker": "派蒙",
                            "text": "好啊好啊！我们两个在稻妻也有不少朋友，到时候，我们可以叫上大家一起快乐出游！"
                        }
                    ]
                },
                {
                    "id": "715420406",
                    "text": "我们也没想到你是机关术高手…",
                    "response": [
                        {
                            "id": "715420407",
                            "speaker": "派蒙",
                            "text": "对喔，你都能教别人机关术了，应该已经学会了不少硬本领！"
                        },
                        {
                            "id": "715420408",
                            "speaker": "漱玉",
                            "text": "还不至于啦，只是跟着师父打了一段时间的基础…"
                        },
                        {
                            "id": "715420409",
                            "speaker": "漱玉",
                            "text": "现在的师父不会隐居在山林里，也不打算让我过与世隔绝的生活。"
                        },
                        {
                            "id": "715420410",
                            "speaker": "漱玉",
                            "text": "所以师父教了我两派机关术，一派是仙家的，一派是普通人的。"
                        },
                        {
                            "id": "715420411",
                            "speaker": "漱玉",
                            "text": "师父说，要是以后，我想在璃月港里生活，掌握了普通机关术，就能谋一份很好的差事。"
                        },
                        {
                            "id": "715420412",
                            "speaker": "漱玉",
                            "text": "这也不耽误我继续学习仙家的机关术。"
                        },
                        {
                            "id": "715420413",
                            "speaker": "派蒙",
                            "text": "挺有道理的欸，没想到，那个女人考虑得这么周到！",
                            "choices": [
                                {
                                    "id": "715420414",
                                    "text": "漱玉想找个工作吗？",
                                    "response": [
                                        {
                                            "id": "715420416",
                                            "speaker": "漱玉",
                                            "text": "我…我还不知道。比起工作和赚钱什么的，我更想待在师父身边。"
                                        },
                                        {
                                            "id": "715420417",
                                            "speaker": "漱玉",
                                            "text": "如果师父需要摩拉了，我就帮师父赚钱！"
                                        },
                                        {
                                            "id": "715420418",
                                            "speaker": "派蒙",
                                            "text": "你的师父应该怎么都不会缺摩拉，她的小发明，随便一个放在璃月港都能卖出天价吧…"
                                        },
                                        {
                                            "id": "715420419",
                                            "speaker": "Player",
                                            "text": "甚至比某位客卿还富裕。"
                                        },
                                        {
                                            "id": "715420420",
                                            "speaker": "派蒙",
                                            "text": "那位是特例吧，不能用常理讨论！"
                                        }
                                    ]
                                },
                                {
                                    "id": "715420415",
                                    "text": "漱玉想赚大钱吗？"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715420421",
                    "text": "下次再来斗个痛快！",
                    "response": [
                        {
                            "id": "715420422",
                            "speaker": "漱玉",
                            "text": "#{NICKNAME}{M#哥哥}{F#姐姐}要去忙别的事了？那就下次再见啦！"
                        }
                    ]
                }
            ]
        }
    ]
}