{
    "talkId": "4008076",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "砂糖": 18
    },
    "dialogues": [
        {
            "id": "400807601",
            "speaker": "砂糖",
            "text": "你好，是来看我的摊位吗？有很多近期研发品哦。",
            "choices": [
                {
                    "id": "400807602",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400807605",
                            "speaker": "砂糖",
                            "text": "嗯，你说就好…",
                            "choices": [
                                {
                                    "id": "400807606",
                                    "text": "关于摊位…",
                                    "response": [
                                        {
                                            "id": "400807607",
                                            "speaker": "砂糖",
                                            "text": "你问这个啊。"
                                        },
                                        {
                                            "id": "400807608",
                                            "speaker": "砂糖",
                                            "text": "我提前把「生物炼金」产品的营养成分表和价格都写在纸上了，但顾客们还是喜欢直接问…"
                                        },
                                        {
                                            "id": "400807609",
                                            "speaker": "砂糖",
                                            "text": "于是我就只能…照着读…"
                                        },
                                        {
                                            "id": "400807610",
                                            "speaker": "砂糖",
                                            "text": "摆摊这种事，对我来说很有挑战性。"
                                        },
                                        {
                                            "id": "400807611",
                                            "speaker": "砂糖",
                                            "text": "是不是该请诺艾尔来负责接待的部分呢，唔，算了…她应该也挺忙的吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807612",
                                    "text": "关于「生物炼金」产品…",
                                    "response": [
                                        {
                                            "id": "400807613",
                                            "speaker": "砂糖",
                                            "text": "这里有「玖式冰雾花速效冷冻版」、「捌式甜甜花改贰壹号香气特化版」…"
                                        },
                                        {
                                            "id": "400807614",
                                            "speaker": "砂糖",
                                            "text": "还有「伍式日落果改陆叁号四倍甜度版」，都是我的得意作品！"
                                        },
                                        {
                                            "id": "400807615",
                                            "speaker": "砂糖",
                                            "text": "既然是你，我就不用照着读说明了吧。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807616",
                                    "text": "关于雷泽…",
                                    "response": [
                                        {
                                            "id": "400807617",
                                            "speaker": "砂糖",
                                            "text": "不好意思，那个时候逃走了…"
                                        },
                                        {
                                            "id": "400807618",
                                            "speaker": "砂糖",
                                            "text": "我觉得无论是你还是诺艾尔，都会表达得比我更好…"
                                        },
                                        {
                                            "id": "400807619",
                                            "speaker": "砂糖",
                                            "text": "你们后来还顺利吗？「伍式日落果改陆叁号四倍甜度版」和其他材料在混合过程中没出问题吧？"
                                        },
                                        {
                                            "id": "400807620",
                                            "speaker": "砂糖",
                                            "text": "还有，那个，雷泽他…"
                                        },
                                        {
                                            "id": "400807621",
                                            "speaker": "Player",
                                            "text": "放心，一切都好。"
                                        },
                                        {
                                            "id": "400807622",
                                            "speaker": "砂糖",
                                            "text": "呼…太好了。"
                                        },
                                        {
                                            "id": "400807623",
                                            "speaker": "砂糖",
                                            "text": "那…可以麻烦你帮我一个忙吗？我想把这次「千风佳酿」的配方完整地记录下来。"
                                        },
                                        {
                                            "id": "400807624",
                                            "speaker": "砂糖",
                                            "text": "哪怕在很久很久以后，未来的我们，也能再次还原出今天的味道。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807603",
                    "text": "先不打扰你了。",
                    "response": [
                        {
                            "id": "400807604",
                            "speaker": "砂糖",
                            "text": "哪里哪里，没关系的。"
                        }
                    ]
                }
            ]
        }
    ]
}