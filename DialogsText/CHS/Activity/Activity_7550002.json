{
    "talkId": "7550002",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Player": 10,
        "「炫彩呆子」": 25,
        "派蒙": 18
    },
    "dialogues": [
        {
            "id": "755000201",
            "speaker": "「炫彩呆子」",
            "text": "哟，两位涂鸦新星，还有什么想了解的吗？"
        },
        {
            "id": "755000202",
            "speaker": "「炫彩呆子」",
            "text": "要是你们没问题，准备出发了，我也动身去野外转一转，找找还没被涂鸦装点的好山崖。你们的节奏可不能输给我啊！",
            "choices": [
                {
                    "id": "755000203",
                    "text": "关于涂鸦这门艺术…",
                    "response": [
                        {
                            "id": "755000204",
                            "speaker": "派蒙",
                            "text": "嗯，感觉纳塔到处都是花花绿绿的涂鸦，屋子上，树上，山上，甚至人身上…"
                        },
                        {
                            "id": "755000205",
                            "speaker": "派蒙",
                            "text": "这好像是你们的习俗？你们是从什么时候开始画涂鸦的呢？"
                        },
                        {
                            "id": "755000206",
                            "speaker": "「炫彩呆子」",
                            "text": "哦呀，你们想要了解纳塔涂鸦的历史？问得好！"
                        },
                        {
                            "id": "755000207",
                            "speaker": "「炫彩呆子」",
                            "text": "现在我们这些普通人掌握的涂鸦技术，其实是「燃素刻录纹」泛化后的产物。"
                        },
                        {
                            "id": "755000208",
                            "speaker": "「炫彩呆子」",
                            "text": "你们或许已经听说过「燃素刻录纹」了，它是由专业的刻录师操刀，为强大的部族战士刻下的花纹。"
                        },
                        {
                            "id": "755000209",
                            "speaker": "「炫彩呆子」",
                            "text": "每个部族都有着不同的花纹，无论是在和龙伙伴们的交流中，还是战斗之中，「燃素刻录纹」都有大用处。"
                        },
                        {
                            "id": "755000210",
                            "speaker": "派蒙",
                            "text": "好像有点印象…原来那个叫「燃素刻录纹」吗？"
                        },
                        {
                            "id": "755000211",
                            "speaker": "Player",
                            "text": "感觉是很不一般的象征…"
                        },
                        {
                            "id": "755000212",
                            "speaker": "「炫彩呆子」",
                            "text": "没错，在我们这些普通人看来，「燃素刻录纹」是勇气、能力和荣誉的符号，没有比这更前卫的东西了。"
                        },
                        {
                            "id": "755000213",
                            "speaker": "「炫彩呆子」",
                            "text": "所以有人就会模仿刻录师们，在各种地方喷涂类似的花纹。"
                        },
                        {
                            "id": "755000214",
                            "speaker": "「炫彩呆子」",
                            "text": "当然，他们是强者，我们是凡人，不一样。我们的作品没有情绪表达之外的任何功用。"
                        },
                        {
                            "id": "755000215",
                            "speaker": "「炫彩呆子」",
                            "text": "久而久之，喷涂的内容就从「燃素刻录纹」扩展成了各种图形，主打一个随心所欲的表达，演变成了如今的涂鸦。"
                        },
                        {
                            "id": "755000216",
                            "speaker": "派蒙",
                            "text": "强者的象征啊，感觉还挺有道理的…原来涂鸦背后还有这么一段演化的历史。"
                        },
                        {
                            "id": "755000217",
                            "speaker": "派蒙",
                            "text": "这么说来，我们也可以在「尘歌壶」里找几座墙壁足够大的房子，画上我们旅途中遇见过的强者！",
                            "choices": [
                                {
                                    "id": "755000218",
                                    "text": "哈哈，那我先画某位吟游诗人！",
                                    "response": [
                                        {
                                            "id": "755000219",
                                            "speaker": "派蒙",
                                            "text": "感觉挺合适的呢，可不可以在卖唱的身边再画一群猫猫？"
                                        },
                                        {
                                            "id": "755000228",
                                            "speaker": "「炫彩呆子」",
                                            "text": "画，都可以画！"
                                        },
                                        {
                                            "id": "755000229",
                                            "speaker": "「炫彩呆子」",
                                            "text": "等到你们的技艺成熟了，把所有想画的同伴和事物用一幅涂鸦展现出来，都不成问题！"
                                        },
                                        {
                                            "id": "755000230",
                                            "speaker": "「炫彩呆子」",
                                            "text": "不过，在此之前，你们要先理解涂鸦的核心理念，好好练习一番。"
                                        },
                                        {
                                            "id": "755000231",
                                            "speaker": "派蒙",
                                            "text": "那是当然！你就等着好啦，我们学东西向来很快的！"
                                        }
                                    ]
                                },
                                {
                                    "id": "755000220",
                                    "text": "见多识广的客卿可担此重任。",
                                    "response": [
                                        {
                                            "id": "755000221",
                                            "speaker": "派蒙",
                                            "text": "可以喔，想想就感觉安心！不过阿圆会不会不敢再打盹了？"
                                        }
                                    ]
                                },
                                {
                                    "id": "755000222",
                                    "text": "御建鸣神主尊大御所大人像？",
                                    "response": [
                                        {
                                            "id": "755000223",
                                            "speaker": "派蒙",
                                            "text": "要画得威严一点吗？我们要不要多养一些团雀？"
                                        }
                                    ]
                                },
                                {
                                    "id": "755000224",
                                    "text": "摩诃善法大吉祥智慧主如何？",
                                    "response": [
                                        {
                                            "id": "755000225",
                                            "speaker": "派蒙",
                                            "text": "那我们再好好装点一下壶中洞天，多种些漂亮的花花草草！"
                                        }
                                    ]
                                },
                                {
                                    "id": "755000226",
                                    "text": "也有点想画枫丹第一的大明星。",
                                    "response": [
                                        {
                                            "id": "755000227",
                                            "speaker": "派蒙",
                                            "text": "好主意！那华丽的露天舞台必不可少，再研究研究漂亮的灯光方案…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "755000232",
                    "text": "关于前卫艺术理念…",
                    "response": [
                        {
                            "id": "755000233",
                            "speaker": "派蒙",
                            "text": "一提到前卫这个词，你就滔滔不绝，难道以前被很严格的老师教导过？"
                        },
                        {
                            "id": "755000234",
                            "speaker": "派蒙",
                            "text": "不过，你应该没有离开过纳塔才对，纳塔本地也有这种专门教艺术的学校吗？"
                        },
                        {
                            "id": "755000235",
                            "speaker": "「炫彩呆子」",
                            "text": "学校？我没去过那种地方。"
                        },
                        {
                            "id": "755000236",
                            "speaker": "「炫彩呆子」",
                            "text": "我说的这些东西，都是根据我自己的经历，结合冒险家们从外地带来的书籍，慢慢寻思出来的。"
                        },
                        {
                            "id": "755000237",
                            "speaker": "「炫彩呆子」",
                            "text": "真要说起来，应该是我来教别人才对？"
                        },
                        {
                            "id": "755000238",
                            "speaker": "「炫彩呆子」",
                            "text": "正好，我还准备在涂鸦联盟的总部留出一块培训新人的区域…"
                        },
                        {
                            "id": "755000239",
                            "speaker": "「炫彩呆子」",
                            "text": "如果这次成功让你们发掘出了涂鸦的才能，干脆之后的新人都由我来带好了。"
                        },
                        {
                            "id": "755000240",
                            "speaker": "派蒙",
                            "text": "总部？我以为涂鸦联盟就像七圣召唤牌手，是一种只存在于身份上的说法。"
                        },
                        {
                            "id": "755000241",
                            "speaker": "「炫彩呆子」",
                            "text": "我们好歹有着…追赶冒险家协会的远大志向，总部自然不能少，借钱凑钱也要建出来！"
                        },
                        {
                            "id": "755000242",
                            "speaker": "「炫彩呆子」",
                            "text": "按照计划，总部的建设应该花不了多少时间，有机会的话，一定要趁早来玩玩啊！"
                        }
                    ]
                },
                {
                    "id": "755000243",
                    "text": "关于你的名字…",
                    "response": [
                        {
                            "id": "755000244",
                            "speaker": "派蒙",
                            "text": "我之前就想问了，你真的就叫…「炫彩呆子」吗？你的本名呢？"
                        },
                        {
                            "id": "755000245",
                            "speaker": "「炫彩呆子」",
                            "text": "嗨呀，对于我们这些涂鸦画手来说，真名不重要，称号才是一切！"
                        },
                        {
                            "id": "755000246",
                            "speaker": "「炫彩呆子」",
                            "text": "我的这个称号可是来源于一个特别特别特别厉害的朋友…"
                        },
                        {
                            "id": "755000247",
                            "speaker": "「炫彩呆子」",
                            "text": "她说我擅长发现炫目的色彩，给人的感觉很厉害，别人说我调配涂鸦颜料时有点呆呆的，两者结合起来就是这个称号了！"
                        },
                        {
                            "id": "755000248",
                            "speaker": "「炫彩呆子」",
                            "text": "虽然我们认识以后并没有经常一起玩，但这个称号一直在鼓舞我！"
                        },
                        {
                            "id": "755000249",
                            "speaker": "派蒙",
                            "text": "特别厉害的朋友带来的外号…好像也可以理解？"
                        },
                        {
                            "id": "755000250",
                            "speaker": "派蒙",
                            "text": "不过「呆子」这个词…也许钻研「前卫理念」的人，已经不会在意个别词语的意思了吧…"
                        }
                    ]
                },
                {
                    "id": "755000251",
                    "text": "我们继续研究去了。",
                    "response": [
                        {
                            "id": "755000252",
                            "speaker": "派蒙",
                            "text": "嗯嗯，我们要按你的指引，继续去取材！"
                        },
                        {
                            "id": "755000253",
                            "speaker": "「炫彩呆子」",
                            "text": "好呀，记得用心看，仔细看！然后，尝试让自己的思维夸张地运转起来！"
                        }
                    ]
                }
            ]
        }
    ]
}