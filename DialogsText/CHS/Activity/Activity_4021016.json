    "dialogues": [
        {
            "id": "402101601",
            "speaker": "卡维",
            "text": "买这个吧？看着就很新鲜！"
        },
        {
            "id": "402101602",
            "speaker": "艾尔海森",
            "text": "好啊。"
        },
        {
            "id": "402101603",
            "speaker": "卡维",
            "text": "老板，打包一些这个。"
        },
        {
            "id": "402101604",
            "speaker": "沙瓦玛",
            "text": "好的好的，打包外带对吧。两位是要二人份？"
        },
        {
            "id": "402101605",
            "speaker": "卡维",
            "text": "欸？啊不不不！不是，不是的…"
        },
        {
            "id": "402101606",
            "speaker": "卡维",
            "text": "麻烦帮我们分开打包两个一人份！"
        },
        {
            "id": "402101607",
            "speaker": "沙瓦玛",
            "text": "……？"
        },
        {
            "id": "402101608",
            "speaker": "沙瓦玛",
            "text": "好的请稍等，马上就来哦。"
        },
        {
            "id": "402101609",
            "speaker": "卡维",
            "text": "咳…差点差点…"
        },
        {
            "id": "402101610",
            "speaker": "艾尔海森",
            "text": "老板，我那份酱料少一点。"
        },
        {
            "id": "402101611",
            "speaker": "沙瓦玛",
            "text": "没问题，这位先生的呢？"
        },
        {
            "id": "402101612",
            "speaker": "卡维",
            "text": "我的要多一点酱汁。"
        },
        {
            "id": "402101613",
            "speaker": "沙瓦玛",
            "text": "好嘞！"
        }
    ]
}