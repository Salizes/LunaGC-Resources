{
    "talkId": "7352902",
    "total_dialogue_lines": 33,
    "speaker_counts": {
        "Player": 6,
        "勒非尼": 20,
        "派蒙": 7
    },
    "dialogues": [
        {
            "id": "735290201",
            "speaker": "勒非尼",
            "text": "两位，你们身上的气息发生了些许变化，似乎能从中寻觅出…昭示战绩的自信，说明你们的剑舞演出极为顺利。",
            "choices": [
                {
                    "id": "735290202",
                    "text": "没错！我们还要再次试炼！",
                    "response": [
                        {
                            "id": "735290203",
                            "speaker": "勒非尼",
                            "text": "真是豪气万丈！那就请你们继续在战斗中起舞吧！"
                        }
                    ]
                },
                {
                    "id": "735290204",
                    "text": "其实我还没试过…",
                    "response": [
                        {
                            "id": "735290205",
                            "speaker": "勒非尼",
                            "text": "那也无妨！"
                        },
                        {
                            "id": "735290206",
                            "speaker": "勒非尼",
                            "text": "在开始剑舞之前，你们的气势就在不断攀升，那战胜敌人后，会有多强的威压，我完全无法想象！"
                        },
                        {
                            "id": "735290207",
                            "speaker": "派蒙",
                            "text": "威压这个词未免有些夸张了啦…我们不会用武力恐吓别人…除非是…警告一些坏家伙别再做错事！"
                        },
                        {
                            "id": "735290208",
                            "speaker": "派蒙",
                            "text": "#不管变得多强，{NICKNAME}一定都会和以前一样——和和气气，高高兴兴，超级耐心，还很有童趣！"
                        },
                        {
                            "id": "735290209",
                            "speaker": "派蒙",
                            "text": "除了你以外，几乎没什么人说过，从我们身上感觉到了…气势、威势之类的东西！"
                        },
                        {
                            "id": "735290210",
                            "speaker": "勒非尼",
                            "text": "竟是如此！我太肤浅了！我记得，我曾在璃月和稻妻的小说…呃咳！是战术资料中看到过类似的描述——"
                        },
                        {
                            "id": "735290211",
                            "speaker": "勒非尼",
                            "text": "你们的境界早就远远超过了「以杀气震慑潜在敌人，避免战斗」，而是达到了顶尖强者的位阶！"
                        },
                        {
                            "id": "735290212",
                            "speaker": "勒非尼",
                            "text": "正因为完全没有可以匹敌的对手，所以在平时的生活中，才表现得像是一点都没有威胁的普通人…甚至战斗力不如野猪。"
                        },
                        {
                            "id": "735290213",
                            "speaker": "勒非尼",
                            "text": "但只要遇上了心怀不轨之人，你们就会第一时间确认他们的威胁，以无比随意的姿态，坦然旁观对方徒劳的行动…"
                        },
                        {
                            "id": "735290214",
                            "speaker": "勒非尼",
                            "text": "「无所谓，只要你敢亮出武器，那就击败你。」",
                            "choices": [
                                {
                                    "id": "735290215",
                                    "text": "打住！别太离谱！",
                                    "response": [
                                        {
                                            "id": "735290217",
                                            "speaker": "派蒙",
                                            "text": "这都是什么乱七八糟的，我有点搞不明白你在说什么了，勒非尼先生…"
                                        },
                                        {
                                            "id": "735290218",
                                            "speaker": "勒非尼",
                                            "text": "无论如何，我对两位失敬了！还请给我一个机会，观瞻你们战斗时的华丽舞姿！"
                                        }
                                    ]
                                },
                                {
                                    "id": "735290216",
                                    "text": "嗯嗯！你说得对！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "735290219",
                    "text": "「轻剑舞者」为何会来到这里？",
                    "response": [
                        {
                            "id": "735290220",
                            "speaker": "派蒙",
                            "text": "对哦…看你的打扮，你应该是…蒙德人？"
                        },
                        {
                            "id": "735290221",
                            "speaker": "勒非尼",
                            "text": "你们会有这等疑问，说明我的伪装成效显著，是对我的肯定。"
                        },
                        {
                            "id": "735290222",
                            "speaker": "勒非尼",
                            "text": "其实我来自枫丹，主要的职业是小说…嗯，应该说，我在从事「轻剑舞者」的工作之余，也写英雄小说挣钱，补贴主业。"
                        },
                        {
                            "id": "735290223",
                            "speaker": "派蒙",
                            "text": "居然是枫丹人吗？完全看不出来呢…"
                        },
                        {
                            "id": "735290224",
                            "speaker": "勒非尼",
                            "text": "穿上蒙德平民的服装，只是因为我先前在蒙德游历过一段时间，发现这样的服装很轻便，还有利于隐藏身份…"
                        },
                        {
                            "id": "735290225",
                            "speaker": "勒非尼",
                            "text": "在无需以「剑舞」挫败强敌时，尽量收敛锐气，藏匿自己的兵器，才是明智的选择。"
                        },
                        {
                            "id": "735290226",
                            "speaker": "勒非尼",
                            "text": "否则特巡队，甚至是逐影庭…"
                        },
                        {
                            "id": "735290227",
                            "speaker": "勒非尼",
                            "text": "咳！否则就会有奇妙的执法者找上门来，收缴你的武装，确认你没有危害城市的打算。"
                        },
                        {
                            "id": "735290228",
                            "speaker": "勒非尼",
                            "text": "她们的身形小巧如猫，身姿迅捷如风，所过之处还会留下海洋与藻类的独特气息…"
                        },
                        {
                            "id": "735290229",
                            "speaker": "派蒙",
                            "text": "你在说什么…童话里的生物吗？听起来好像在为自己以前的失败找借口！"
                        },
                        {
                            "id": "735290230",
                            "speaker": "勒非尼",
                            "text": "总之，建议你们也不要在枫丹轻易招惹执法者，她们真的非常难对付…"
                        },
                        {
                            "id": "735290231",
                            "speaker": "勒非尼",
                            "text": "当然，如果有着不得不去贯彻的新信念…那就做好准备。在问心无愧时，离开枫丹，避免被她们追捕吧！"
                        }
                    ]
                },
                {
                    "id": "735290232",
                    "text": "（沉默，离去。）",
                    "response": [
                        {
                            "id": "735290233",
                            "speaker": "勒非尼",
                            "text": "你们两位…我明白了！你们已经进入了规划战斗之舞的最佳状态，我不该打扰你们…期待你们尽早回来，展示华丽的舞姿！"
                        }
                    ]
                }
            ]
        }
    ]
}