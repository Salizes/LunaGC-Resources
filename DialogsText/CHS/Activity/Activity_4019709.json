{
    "talkId": "4019709",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 10,
        "瓦雷莎": 19
    },
    "dialogues": [
        {
            "id": "401970901",
            "speaker": "瓦雷莎",
            "text": "#呜哇！是、是大英雄{NICKNAME}，还有派蒙！"
        },
        {
            "id": "401970902",
            "speaker": "瓦雷莎",
            "text": "欸…我好像不应该吃惊的，爱可菲小姐和我说过了，这次的大老板是你…"
        },
        {
            "id": "401970903",
            "speaker": "瓦雷莎",
            "text": "但一看到你，我好像就开心过头，忘了很多事…",
            "choices": [
                {
                    "id": "401970904",
                    "text": "我当大老板，真的假的？",
                    "response": [
                        {
                            "id": "401970906",
                            "speaker": "派蒙",
                            "text": "严格意义上，「海薇玛映影欢乐城」应该没有老板吧？"
                        },
                        {
                            "id": "401970907",
                            "speaker": "派蒙",
                            "text": "大家一起努力经营，把乐园办得红红火火，然后一起分红！"
                        },
                        {
                            "id": "401970908",
                            "speaker": "派蒙",
                            "text": "不过话说回来，瓦雷莎怎么会在这里？"
                        },
                        {
                            "id": "401970909",
                            "speaker": "瓦雷莎",
                            "text": "唔…用正经一点的说法，我是来做「品牌生意」的！"
                        },
                        {
                            "id": "401970910",
                            "speaker": "瓦雷莎",
                            "text": "前不久，爱可菲小姐的餐厅按照惯例，从我这里进货。"
                        },
                        {
                            "id": "401970911",
                            "speaker": "瓦雷莎",
                            "text": "她在联络信里提到，如果我家果园的产品能出现在这个大派对上，销量肯定很不错，还能提高知名度。"
                        },
                        {
                            "id": "401970912",
                            "speaker": "瓦雷莎",
                            "text": "和爸爸妈妈商量以后，我决定来试试。"
                        },
                        {
                            "id": "401970913",
                            "speaker": "瓦雷莎",
                            "text": "现在我给餐厅的食材订单已经完成了，准备向客人们零售水果，帮客人们解渴…"
                        },
                        {
                            "id": "401970914",
                            "speaker": "派蒙",
                            "text": "在枫丹品尝纳塔的原生态水果，好像确实很有吸引力…"
                        },
                        {
                            "id": "401970915",
                            "speaker": "派蒙",
                            "text": "不过，按这个客流量，一天到晚看管摊位，会不会太累了？"
                        },
                        {
                            "id": "401970916",
                            "speaker": "瓦雷莎",
                            "text": "咦，需要一直盯着摊位的吗？"
                        },
                        {
                            "id": "401970917",
                            "speaker": "瓦雷莎",
                            "text": "那边有个叫…「妙影名篇」的项目，听说，许多关卡参考了有名的映影。"
                        },
                        {
                            "id": "401970918",
                            "speaker": "瓦雷莎",
                            "text": "其中一些映影还有改编的漫画，我很喜欢！还想去试试看呢！"
                        },
                        {
                            "id": "401970919",
                            "speaker": "派蒙",
                            "text": "那你完全不做生意了吗？"
                        },
                        {
                            "id": "401970920",
                            "speaker": "瓦雷莎",
                            "text": "在「沃陆之邦」的时候，我把水果的价格标好，称重工具和结账钱罐摆在一边，大家自己往罐子里放摩拉就行…"
                        },
                        {
                            "id": "401970921",
                            "speaker": "瓦雷莎",
                            "text": "每天该收摊的时候，我差不多也睡醒了，对一遍账，从没有少过钱！"
                        },
                        {
                            "id": "401970922",
                            "speaker": "Player",
                            "text": "心好大！"
                        },
                        {
                            "id": "401970923",
                            "speaker": "派蒙",
                            "text": "该说不说，倒也挺自在的？「沃陆之邦」的人都非常守规矩，没有人赖账吃霸王餐…瓦雷莎没必要忙来忙去！"
                        },
                        {
                            "id": "401970924",
                            "speaker": "派蒙",
                            "text": "枫丹的客人肯定也很实在，但他们没有这种…「自助购物」的习惯？"
                        },
                        {
                            "id": "401970925",
                            "speaker": "派蒙",
                            "text": "加上你是纳塔来的商人，完全不管摊位的话，可能会让他们迷惑，以为摊位不在营业状态…"
                        },
                        {
                            "id": "401970926",
                            "speaker": "瓦雷莎",
                            "text": "那，那我还是扮演一个认真的商人比较好！"
                        },
                        {
                            "id": "401970927",
                            "speaker": "瓦雷莎",
                            "text": "趁着现在店还没正式营业，我想先去城里买些东西…"
                        },
                        {
                            "id": "401970928",
                            "speaker": "瓦雷莎",
                            "text": "之前我答应伊安珊老师，要帮她带些枫丹的发条机关回去。"
                        },
                        {
                            "id": "401970929",
                            "speaker": "瓦雷莎",
                            "text": "然后，然后我想先把几个「妙影名篇」的关卡都试试，接下来，就能一心一意做生意了！",
                            "choices": [
                                {
                                    "id": "401970930",
                                    "text": "我们陪你一起吧。",
                                    "response": [
                                        {
                                            "id": "401970932",
                                            "speaker": "派蒙",
                                            "text": "嗯！虽然比不上本地人，但我们对枫丹廷还是比较熟悉的，上上下下也逛过不少回！"
                                        },
                                        {
                                            "id": "401970933",
                                            "speaker": "瓦雷莎",
                                            "text": "那…请等我把之后一段时间的水果、报价板和收钱罐准备一下！"
                                        },
                                        {
                                            "id": "401970934",
                                            "speaker": "瓦雷莎",
                                            "text": "#欸嘿嘿，要和{NICKNAME}一起去买东西啦！"
                                        }
                                    ]
                                },
                                {
                                    "id": "401970931",
                                    "text": "买东西我们在行。"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401970905",
                    "text": "我只是个执行人员哦。"
                }
            ]
        }
    ]
}