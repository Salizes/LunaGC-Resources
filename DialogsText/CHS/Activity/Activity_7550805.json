{
    "talkId": "7550805",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "梦见月瑞希": 13
    },
    "dialogues": [
        {
            "id": "755080501",
            "speaker": "梦见月瑞希",
            "text": "嗯，我能感觉到，你在享受游艺的乐趣时，情绪中蕴含着温暖的色彩，相信你今晚会有个轻松舒畅的好梦。",
            "choices": [
                {
                    "id": "755080502",
                    "text": "瑞希也会听节奏很快的歌吗？",
                    "response": [
                        {
                            "id": "755080503",
                            "speaker": "梦见月瑞希",
                            "text": "这个问题的思路非常经典哦。"
                        },
                        {
                            "id": "755080504",
                            "speaker": "梦见月瑞希",
                            "text": "朋友推荐的音乐，不管我能否接受，都会好好听完，如此才不至于辜负朋友的好意。"
                        },
                        {
                            "id": "755080505",
                            "speaker": "梦见月瑞希",
                            "text": "我可以接受节奏特别快的音乐，不过更倾向于舒缓、优美的类型。乐器的种类不一定要很丰富，技巧也不用特别炫目。"
                        },
                        {
                            "id": "755080506",
                            "speaker": "梦见月瑞希",
                            "text": "只要主要的旋律足够动听，哪怕只是慢慢的独奏，或是人声清唱，也不会显得单薄，反而有种清静的美感。",
                            "choices": [
                                {
                                    "id": "755080507",
                                    "text": "我也一样。",
                                    "response": [
                                        {
                                            "id": "755080508",
                                            "speaker": "梦见月瑞希",
                                            "text": "那…等到你下回空闲时，我挑选几首不错的音乐，沏一壶好茶，准备些点心，一起慢慢欣赏吧？"
                                        }
                                    ]
                                },
                                {
                                    "id": "755080509",
                                    "text": "也可以试试新风格？",
                                    "response": [
                                        {
                                            "id": "755080510",
                                            "speaker": "梦见月瑞希",
                                            "text": "没问题哦，以你的审美，肯定能让我走出舒适区，找到些新的宝藏。下回空闲时，带我欣赏这些杰作吧？"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "755080511",
                    "text": "想看瑞希玩这个游戏。",
                    "response": [
                        {
                            "id": "755080512",
                            "speaker": "梦见月瑞希",
                            "text": "当然可以啦，不过有点犯规哦。"
                        },
                        {
                            "id": "755080513",
                            "speaker": "梦见月瑞希",
                            "text": "作为设计者之一的我了解每个关卡的细节，每一步都在预料中，难免显得有些无趣嘛。"
                        },
                        {
                            "id": "755080514",
                            "speaker": "梦见月瑞希",
                            "text": "游艺之中多一点惊喜才好，这对设计者的思维是一种考验，要尽可能跳出常规，避免每一步发展都被人一眼望穿。"
                        },
                        {
                            "id": "755080515",
                            "speaker": "梦见月瑞希",
                            "text": "在超出常理的领域里，你自然是最佳代表啦。"
                        },
                        {
                            "id": "755080516",
                            "speaker": "梦见月瑞希",
                            "text": "希望以后，你也能从头参与一些游艺的统筹架构，让我体验你设计的关卡~"
                        }
                    ]
                },
                {
                    "id": "755080517",
                    "text": "你也要好好休息哦。",
                    "response": [
                        {
                            "id": "755080518",
                            "speaker": "梦见月瑞希",
                            "text": "请别担心，这次成功邀请到你，我就心满意足了。心情舒畅的睡眠，一份时间，甚至抵得上平时的三倍~"
                        }
                    ]
                }
            ]
        }
    ]
}