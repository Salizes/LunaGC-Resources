{
    "talkId": "4019705",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 10,
        "希格雯": 16,
        "派蒙": 9
    },
    "dialogues": [
        {
            "id": "401970501",
            "speaker": "希格雯",
            "text": "#你们好呀，{NICKNAME}和派蒙~"
        },
        {
            "id": "401970502",
            "speaker": "派蒙",
            "text": "是希格雯！欢迎来到「海薇玛映影欢乐城」！",
            "choices": [
                {
                    "id": "401970503",
                    "text": "希格雯的消息很灵通嘛。",
                    "response": [
                        {
                            "id": "401970505",
                            "speaker": "希格雯",
                            "text": "都有哦！上次美容协会举办定期交流时，娜维娅就和我聊了聊欢乐城的计划，我期待了很久呢。"
                        },
                        {
                            "id": "401970506",
                            "speaker": "希格雯",
                            "text": "现在，连梅洛彼得堡里的大家都知道了这个主题乐园的事，许多工作人员都想请假过来玩！"
                        },
                        {
                            "id": "401970507",
                            "speaker": "派蒙",
                            "text": "嘿嘿，得到了护士长的鼓励，更有干劲了！",
                            "choices": [
                                {
                                    "id": "401970508",
                                    "text": "希格雯常看哪种映影？",
                                    "response": [
                                        {
                                            "id": "401970510",
                                            "speaker": "希格雯",
                                            "text": "我呀…我比较喜欢轻松有趣的动画映影。"
                                        },
                                        {
                                            "id": "401970511",
                                            "speaker": "希格雯",
                                            "text": "有一群工作者创造了可可爱爱的动物角色，专门讲神奇动物的故事，我每一部都没落下~"
                                        },
                                        {
                                            "id": "401970512",
                                            "speaker": "希格雯",
                                            "text": "根据最近的新规定，梅洛彼得堡里，表现良好的犯人，可以每周花费特许券看三次映影。"
                                        },
                                        {
                                            "id": "401970513",
                                            "speaker": "希格雯",
                                            "text": "现在还没有负责映影的专职人员，就由我在空闲的时候管理放映机了。"
                                        },
                                        {
                                            "id": "401970514",
                                            "speaker": "希格雯",
                                            "text": "于是我就给他们放了《邻家的花栗猫》之类的映影。"
                                        },
                                        {
                                            "id": "401970515",
                                            "speaker": "希格雯",
                                            "text": "还有一个很有名的《猫鼠战争》系列，好长好长，有好几百集，大家都百看不腻。",
                                            "choices": [
                                                {
                                                    "id": "401970516",
                                                    "text": "凶恶的罪犯聚在一起看猫猫…",
                                                    "response": [
                                                        {
                                                            "id": "401970518",
                                                            "speaker": "派蒙",
                                                            "text": "不过，有了映影看的话，一直闹腾不停的家伙，应该也会表现得安分一点？"
                                                        },
                                                        {
                                                            "id": "401970519",
                                                            "speaker": "派蒙",
                                                            "text": "欢乐城里也有一个动物主题的区域呢，就是被顾客们评为「最松弛」的「悠悠慢庄园」。"
                                                        },
                                                        {
                                                            "id": "401970520",
                                                            "speaker": "希格雯",
                                                            "text": "我去看过哦！去之前，没想到会那么有意思！"
                                                        },
                                                        {
                                                            "id": "401970521",
                                                            "speaker": "希格雯",
                                                            "text": "各种以前想都没想过的动物住在一起，甚至有了《欢腾动物城》的观感~",
                                                            "choices": [
                                                                {
                                                                    "id": "401970522",
                                                                    "text": "有空的话，要不每天都来？",
                                                                    "response": [
                                                                        {
                                                                            "id": "401970524",
                                                                            "speaker": "派蒙",
                                                                            "text": "啊，你的意思是，邀请希格雯来当「悠悠慢庄园」的顾问？"
                                                                        },
                                                                        {
                                                                            "id": "401970525",
                                                                            "speaker": "派蒙",
                                                                            "text": "这么一说，好像很有潜力呢，希格雯很擅长照顾人，又这么有亲和力，关照动物朋友们，应该也不在话下！"
                                                                        },
                                                                        {
                                                                            "id": "401970526",
                                                                            "speaker": "希格雯",
                                                                            "text": "顾问？"
                                                                        },
                                                                        {
                                                                            "id": "401970527",
                                                                            "speaker": "派蒙",
                                                                            "text": "就是帮忙出出主意的人，告诉游乐项目的员工，怎么做事更有效！"
                                                                        },
                                                                        {
                                                                            "id": "401970528",
                                                                            "speaker": "派蒙",
                                                                            "text": "工作量不大，但是非常关键，大部分时候，你都能开开心心和动物们玩耍。"
                                                                        },
                                                                        {
                                                                            "id": "401970529",
                                                                            "speaker": "希格雯",
                                                                            "text": "好呀好呀，我很有兴趣~"
                                                                        },
                                                                        {
                                                                            "id": "401970530",
                                                                            "speaker": "希格雯",
                                                                            "text": "正好这段时间，梅洛彼得堡里没什么急事要处理，如果之前知道了你们在招募这个职位，说不定，我还会主动来投简历呢。"
                                                                        },
                                                                        {
                                                                            "id": "401970531",
                                                                            "speaker": "希格雯",
                                                                            "text": "不过，我要布置好医务人员们的工作、从医生朋友那里借来相关的书籍，还有和动物朋友们打交道的礼物。"
                                                                        },
                                                                        {
                                                                            "id": "401970532",
                                                                            "speaker": "希格雯",
                                                                            "text": "如果方便的话，过段时间，我们在茉洁站附近再见？",
                                                                            "choices": [
                                                                                {
                                                                                    "id": "401970533",
                                                                                    "text": "这点小事，不在话下！",
                                                                                    "response": [
                                                                                        {
                                                                                            "id": "401970535",
                                                                                            "speaker": "派蒙",
                                                                                            "text": "嘿嘿，「悠悠慢庄园」有了希格雯的帮助，肯定会变得更有趣更稳定，一举拿下漂亮的营业额！"
                                                                                        }
                                                                                    ]
                                                                                },
                                                                                {
                                                                                    "id": "401970534",
                                                                                    "text": "那就达成合作！"
                                                                                }
                                                                            ]
                                                                        }
                                                                    ]
                                                                },
                                                                {
                                                                    "id": "401970523",
                                                                    "text": "一边玩耍，一边挣点摩拉？"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "401970517",
                                                    "text": "心情复杂，很难想象那种情景…"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401970509",
                                    "text": "好奇希格雯中意的映影类型…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401970504",
                    "text": "还是欢乐城的名气变大了？"
                }
            ]
        }
    ]
}