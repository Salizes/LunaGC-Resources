    "dialogues": [
        {
            "id": "400881501",
            "speaker": "马茨",
            "text": "哟，听说义卖大获成功了，恭喜你啊，荣誉骑士！",
            "choices": [
                {
                    "id": "400881502",
                    "text": "这是我们并肩努力的结果。",
                    "response": [
                        {
                            "id": "400881503",
                            "speaker": "马茨",
                            "text": "啊哈，说得好！"
                        },
                        {
                            "id": "400881504",
                            "speaker": "马茨",
                            "text": "这次活动让我精神焕发，明明没有赚钱，却比发了财还开心。"
                        },
                        {
                            "id": "400881505",
                            "speaker": "马茨",
                            "text": "这大概就是做好事的满足感吧。"
                        }
                    ]
                },
                {
                    "id": "400881506",
                    "text": "下次再合作吧！",
                    "response": [
                        {
                            "id": "400881507",
                            "speaker": "马茨",
                            "text": "好嘞！我也准备出发了。"
                        },
                        {
                            "id": "400881508",
                            "speaker": "马茨",
                            "text": "下次回来的时候，我肯定要多帮点忙！"
                        }
                    ]
                }
            ]
        }
    ]
