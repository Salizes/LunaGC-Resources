{
    "talkId": "4141465",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "玛文": 9
    },
    "dialogues": [
        {
            "id": "414146501",
            "speaker": "Player",
            "text": "你在烦恼什么？"
        },
        {
            "id": "414146502",
            "speaker": "玛文",
            "text": "我…我有个朋友！对，我朋友…"
        },
        {
            "id": "414146503",
            "speaker": "玛文",
            "text": "他喜欢上了一个女孩，不过那女孩的家境不太好，因此我朋友担心他父亲会反对这桩婚事。"
        },
        {
            "id": "414146504",
            "speaker": "玛文",
            "text": "不过他是真心喜欢那个女孩，想要娶那个女孩为妻。"
        },
        {
            "id": "414146505",
            "speaker": "玛文",
            "text": "因此我…他在盘算着要不要趁着这个机会，和他父亲挑明…",
            "choices": [
                {
                    "id": "414146506",
                    "text": "你说的那个朋友是不是你自己？",
                    "response": [
                        {
                            "id": "414146507",
                            "speaker": "玛文",
                            "text": "咳！咳咳，你、你不要乱说…"
                        },
                        {
                            "id": "414146508",
                            "speaker": "玛文",
                            "text": "等等，你该不会是我父亲派来试探我的吧？"
                        },
                        {
                            "id": "414146509",
                            "speaker": "玛文",
                            "text": "…哼，算了，当我什么都没说，快走吧。"
                        }
                    ]
                },
                {
                    "id": "414146510",
                    "text": "还是算了吧…",
                    "response": [
                        {
                            "id": "414146511",
                            "speaker": "玛文",
                            "text": "果然，还是不说会好一些吗…"
                        },
                        {
                            "id": "414146512",
                            "speaker": "玛文",
                            "text": "咳咳，刚、刚才的话，你就当没听见好了。"
                        }
                    ]
                }
            ]
        }
    ]
}