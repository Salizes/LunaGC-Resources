{
    "talkId": "4019718",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "林尼": 6,
        "派蒙": 2,
        "琳妮特": 5
    },
    "dialogues": [
        {
            "id": "401971801",
            "speaker": "琳妮特",
            "text": "林尼，我回来了。"
        },
        {
            "id": "401971802",
            "speaker": "琳妮特",
            "text": "「海薇玛映影欢乐城」很有趣哦，还有许多小动物，别再一直钻研恐怖映影了。"
        },
        {
            "id": "401971803",
            "speaker": "林尼",
            "text": "呼啊~乐园有意思就好，可我的当务之急是找到状态，拍好这部魔术映影，暂时就不考虑动物助手的事了…"
        },
        {
            "id": "401971804",
            "speaker": "林尼",
            "text": "容我再睡会儿，恢复精力…"
        },
        {
            "id": "401971805",
            "speaker": "林尼",
            "text": "不行！一闭眼就想到精彩的诡计，但又好困…睡不着，醒不来…",
            "choices": [
                {
                    "id": "401971806",
                    "text": "那不如散散心？",
                    "response": [
                        {
                            "id": "401971808",
                            "speaker": "派蒙",
                            "text": "对哦，林尼！出来转换下心情，就不会再胡思乱想啦！"
                        },
                        {
                            "id": "401971809",
                            "speaker": "林尼",
                            "text": "#等等…{NICKNAME}和派蒙也在吗！"
                        },
                        {
                            "id": "401971810",
                            "speaker": "琳妮特",
                            "text": "#{M#他们}{F#她们}是那座乐园的管理者，我也即将成为一个项目的顾问哦。"
                        },
                        {
                            "id": "401971811",
                            "speaker": "林尼",
                            "text": "那我确实要到场！不止为了自己，也是对两位好朋友的支持！"
                        },
                        {
                            "id": "401971812",
                            "speaker": "林尼",
                            "text": "请等我一段时间，我得好好整理仪容仪表…"
                        },
                        {
                            "id": "401971813",
                            "speaker": "琳妮特",
                            "text": "#果然，{NICKNAME}对林尼的吸引力毋庸置疑，处于最高等级呢。",
                            "choices": [
                                {
                                    "id": "401971814",
                                    "text": "那是当然！",
                                    "response": [
                                        {
                                            "id": "401971816",
                                            "speaker": "琳妮特",
                                            "text": "不知道哥哥洗漱穿戴需要多长时间，不如，我们就在会场碰头吧？"
                                        },
                                        {
                                            "id": "401971817",
                                            "speaker": "派蒙",
                                            "text": "嗯！能让林尼提起精神，找到来乐园逛逛的动力，就是我们这趟最大的收获！"
                                        }
                                    ]
                                },
                                {
                                    "id": "401971815",
                                    "text": "毕竟是我！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401971807",
                    "text": "可以和可爱动物一起玩~"
                }
            ]
        }
    ]
}