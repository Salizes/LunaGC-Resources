{
    "talkId": "4018932",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "「铁腹」": 8
    },
    "dialogues": [
        {
            "id": "401893201",
            "speaker": "「铁腹」",
            "text": "游客们还真入戏，我也兴奋起来了！",
            "choices": [
                {
                    "id": "401893202",
                    "text": "你穿的也是戏服？",
                    "response": [
                        {
                            "id": "401893203",
                            "speaker": "「铁腹」",
                            "text": "被你看破了，不愧是老板！"
                        },
                        {
                            "id": "401893204",
                            "speaker": "「铁腹」",
                            "text": "我之前在好几部映影里跑过龙套，有次，以梅洛彼得堡看守的形象参演时，得到了一个被大人物膝击的镜头…"
                        },
                        {
                            "id": "401893205",
                            "speaker": "「铁腹」",
                            "text": "亲友们都说，那个镜头是我的高光时刻，所以，我的形象就和这套看守服紧紧绑定在一起了。"
                        }
                    ]
                },
                {
                    "id": "401893206",
                    "text": "如果这样好评多，也好。",
                    "response": [
                        {
                            "id": "401893207",
                            "speaker": "「铁腹」",
                            "text": "看看这个游乐项目中的机关，惊险刺激，要是搞几个氛围阴森恐怖的迷宫场景，应该更有沉浸感！"
                        },
                        {
                            "id": "401893208",
                            "speaker": "「铁腹」",
                            "text": "可惜要照顾年龄小和胆子小的游客，加不得。"
                        },
                        {
                            "id": "401893209",
                            "speaker": "「铁腹」",
                            "text": "哎，那我是不是可以找个机会，单独开间…「鬼屋」之类的惊悚主题馆？"
                        }
                    ]
                },
                {
                    "id": "401893210",
                    "text": "工作还是冷静点比较好。",
                    "response": [
                        {
                            "id": "401893211",
                            "speaker": "「铁腹」",
                            "text": "我懂，我懂，不会疏忽大意的！"
                        }
                    ]
                }
            ]
        }
    ]
}