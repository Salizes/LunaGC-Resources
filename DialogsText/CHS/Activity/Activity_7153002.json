{
    "talkId": "7153002",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "遐庆": 10
    },
    "dialogues": [
        {
            "id": "715300201",
            "speaker": "遐庆",
            "text": "#大名人{M#大哥}{F#大姐}，看你容光焕发，意气风发，要玩一局「碰碰舞兽戏」吗？",
            "choices": [
                {
                    "id": "715300202",
                    "text": "那就玩一局「碰碰舞兽戏」！",
                    "response": [
                        {
                            "id": "715300203",
                            "speaker": "遐庆",
                            "text": "好哇，祝你玩得开心！"
                        }
                    ]
                },
                {
                    "id": "715300204",
                    "text": "关于「碰碰舞兽戏」的道具和场地…",
                    "response": [
                        {
                            "id": "715300205",
                            "speaker": "遐庆",
                            "text": "还不错吧？都是我改的！"
                        },
                        {
                            "id": "715300206",
                            "speaker": "遐庆",
                            "text": "我在舞兽戏的戏服里加入了几种特别的石粉，你一拉绳子，石粉混在一起，就放出许多气体，把戏服撑起来，结结实实。"
                        },
                        {
                            "id": "715300207",
                            "speaker": "遐庆",
                            "text": "所以不管你们怎么碰，都不会受伤，又好玩又安全！"
                        },
                        {
                            "id": "715300208",
                            "speaker": "遐庆",
                            "text": "这是早就用在船上的技术，水手们用它来保住货物，就算装货的箱子跟着波浪到处晃，里边的货也不会撞得稀巴烂。"
                        },
                        {
                            "id": "715300209",
                            "speaker": "遐庆",
                            "text": "然后吧，玩「碰碰舞兽戏」的场地是我向这家店租的。那么大的地下室，平常总是空着，正好派上用场。"
                        },
                        {
                            "id": "715300210",
                            "speaker": "遐庆",
                            "text": "这家店的老板人很好，我宣传舞兽戏也能帮他揽客，所以他没收我多少钱！"
                        },
                        {
                            "id": "715300211",
                            "speaker": "遐庆",
                            "text": "看情况，说不准以后我还能叫上嘉明，在这里表演！"
                        }
                    ]
                },
                {
                    "id": "715300212",
                    "text": "节日快乐！记得休息！",
                    "response": [
                        {
                            "id": "715300213",
                            "speaker": "遐庆",
                            "text": "好！你也要玩得开心，吃得痛快！"
                        }
                    ]
                }
            ]
        }
    ]
}