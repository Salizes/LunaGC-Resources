{
    "talkId": "4008075",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "罗莎莉亚": 14
    },
    "dialogues": [
        {
            "id": "400807501",
            "speaker": "罗莎莉亚",
            "text": "#{NICKNAME}，又见面了…",
            "choices": [
                {
                    "id": "400807502",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400807505",
                            "speaker": "罗莎莉亚",
                            "text": "也行吧。是有什么想问我的？",
                            "choices": [
                                {
                                    "id": "400807506",
                                    "text": "关于法尔伽…",
                                    "response": [
                                        {
                                            "id": "400807507",
                                            "speaker": "罗莎莉亚",
                                            "text": "哦。他写的信，芭芭拉已经拿给我看过了。"
                                        },
                                        {
                                            "id": "400807508",
                                            "speaker": "罗莎莉亚",
                                            "text": "她还在牵挂她父亲西蒙。「所有成员平安无事」那句，差点就要沾上泪痕了。"
                                        },
                                        {
                                            "id": "400807509",
                                            "speaker": "罗莎莉亚",
                                            "text": "嗯？你问我吗？"
                                        },
                                        {
                                            "id": "400807510",
                                            "speaker": "罗莎莉亚",
                                            "text": "法尔伽…你认为我应该把他当做父亲来看待，对吧？但我没法像别人家的女儿那样担心他。"
                                        },
                                        {
                                            "id": "400807511",
                                            "speaker": "罗莎莉亚",
                                            "text": "如果他拿不出足够的勇气和实力，就不配带领那么多人。这样的人，不需要我们太过操心。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807512",
                                    "text": "关于雷泽…",
                                    "response": [
                                        {
                                            "id": "400807513",
                                            "speaker": "罗莎莉亚",
                                            "text": "这么说，他最后想清楚了？"
                                        },
                                        {
                                            "id": "400807514",
                                            "speaker": "Player",
                                            "text": "至少不会迷茫了。"
                                        },
                                        {
                                            "id": "400807515",
                                            "speaker": "Player",
                                            "text": "算是有了方向。"
                                        },
                                        {
                                            "id": "400807516",
                                            "speaker": "罗莎莉亚",
                                            "text": "听上去离独立还有些距离。不过，每个人有每个人的活法。"
                                        },
                                        {
                                            "id": "400807517",
                                            "speaker": "罗莎莉亚",
                                            "text": "挺好的，也算你们的努力没有白费。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400807518",
                                    "text": "关于「佳酿节」…",
                                    "response": [
                                        {
                                            "id": "400807519",
                                            "speaker": "罗莎莉亚",
                                            "text": "原本以为熬到节日，总算可以在酒馆里泡一整天。结果哪边的工作都比平时更忙。"
                                        },
                                        {
                                            "id": "400807520",
                                            "speaker": "罗莎莉亚",
                                            "text": "就算溜到这种地方也不能放松，谁知道维多利亚和塔利雅会不会突然抓我去唱诗。"
                                        },
                                        {
                                            "id": "400807521",
                                            "speaker": "罗莎莉亚",
                                            "text": "唉，这节日还是早点过去吧。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400807503",
                    "text": "先不打扰你了。",
                    "response": [
                        {
                            "id": "400807504",
                            "speaker": "罗莎莉亚",
                            "text": "嗯。不过别和其他人提起我在这里，我暂时还不想换地方。"
                        }
                    ]
                }
            ]
        }
    ]
}