    "dialogues": [
        {
            "id": "715400501",
            "speaker": "重云",
            "text": "或许…我也该去深修一番…",
            "choices": [
                {
                    "id": "715400502",
                    "text": "重云，这封祝柬送你。",
                    "response": [
                        {
                            "id": "715400503",
                            "speaker": "重云",
                            "text": "祝柬？谢谢，我会收好的。"
                        },
                        {
                            "id": "715400504",
                            "speaker": "重云",
                            "text": "抱歉…最近有些忙，没来得及写祝柬…只能先口头祝你安康顺意了。",
                            "choices": [
                                {
                                    "id": "715400505",
                                    "text": "也祝你安康顺意。",
                                    "response": [
                                        {
                                            "id": "715400507",
                                            "speaker": "重云",
                                            "text": "嗯…说来惭愧，我虽出身方术世家，略懂驱邪捉妖的法术，却从没想到老太公的事与生死幽冥有关。"
                                        },
                                        {
                                            "id": "715400508",
                                            "speaker": "重云",
                                            "text": "假如我学艺再精进些，能早些发现不对，你和胡桃或许就不用冒那般风险。"
                                        },
                                        {
                                            "id": "715400509",
                                            "speaker": "重云",
                                            "text": "等过段时间…我也该去再深修一番了…"
                                        }
                                    ]
                                },
                                {
                                    "id": "715400506",
                                    "text": "没事，最近确实很忙…"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "715400510",
                    "text": "再见。",
                    "response": [
                        {
                            "id": "715400511",
                            "speaker": "重云",
                            "text": "嗯，再见。祝你安康顺意。"
                        }
                    ]
                }
            ]
        }
    ]
}