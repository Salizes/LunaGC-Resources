{
    "talkId": "7052906",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "莉兹": 8
    },
    "dialogues": [
        {
            "id": "705290601",
            "speaker": "莉兹",
            "text": "希望这次也能顺利举行啊…"
        },
        {
            "id": "705290602",
            "speaker": "Player",
            "text": "你在做什么？"
        },
        {
            "id": "705290603",
            "speaker": "莉兹",
            "text": "我正在这里准备招待客人呢，这次的风花节，我们准备了很多好玩的活动。"
        },
        {
            "id": "705290604",
            "speaker": "莉兹",
            "text": "但有些活动需要宽敞的场地，所以把举办地点选在了城外，如果没人告诉大家位置的话，也许会有人错过这些乐趣…"
        },
        {
            "id": "705290605",
            "speaker": "莉兹",
            "text": "所以，我莉兹就在这里，负责为大家介绍在这次风花节里举办的活动啦。",
            "choices": [
                {
                    "id": "705290606",
                    "text": "想要了解一下。",
                    "response": [
                        {
                            "id": "705290608",
                            "speaker": "莉兹",
                            "text": "这次预定举办的活动有三项，「风物之歌」，「万风逐花」，「风物留影」。"
                        },
                        {
                            "id": "705290609",
                            "speaker": "莉兹",
                            "text": "我所负责的活动是「风物之歌」，负责其他两项活动的人应该也已经就位了，正在做最后的一些准备工作。"
                        },
                        {
                            "id": "705290610",
                            "speaker": "莉兹",
                            "text": "大家都很有干劲，希望这次风花节能够一切顺利啊。"
                        },
                        {
                            "id": "705290611",
                            "speaker": "莉兹",
                            "text": "嘿嘿，也祝您度过一个愉快的风花节！"
                        }
                    ]
                },
                {
                    "id": "705290607",
                    "text": "有哪些活动？"
                }
            ]
        }
    ]
}