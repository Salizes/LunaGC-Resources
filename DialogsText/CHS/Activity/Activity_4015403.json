{
    "talkId": "4015403",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 6,
        "丽莎": 7,
        "派蒙": 4,
        "砂糖": 18
    },
    "dialogues": [
        {
            "id": "401540301",
            "speaker": "砂糖",
            "text": "#{NICKNAME}，派蒙，还有丽莎，你们好呀。"
        },
        {
            "id": "401540302",
            "speaker": "派蒙",
            "text": "砂糖，好久不见！"
        },
        {
            "id": "401540303",
            "speaker": "砂糖",
            "text": "刚才来的路上，听到不少人在讨论炼金药剂的事情呢。"
        },
        {
            "id": "401540304",
            "speaker": "砂糖",
            "text": "起初我还担心用于炼制的药材会不会出什么问题，但是听他们的说法，效果似乎很不错。"
        },
        {
            "id": "401540305",
            "speaker": "丽莎",
            "text": "呵呵，砂糖的生物炼金技术，用在药剂调配上可以说是恰到好处呢。"
        },
        {
            "id": "401540306",
            "speaker": "派蒙",
            "text": "是呀是呀，我们已经炼制了很多不同功效的药剂了。"
        },
        {
            "id": "401540307",
            "speaker": "砂糖",
            "text": "#这么短的时间内就上手了吗？不愧是{NICKNAME}。"
        },
        {
            "id": "401540308",
            "speaker": "丽莎",
            "text": "#假以时日，说不定{F#她}{M#他}也能成为药剂学的大师呢。",
            "choices": [
                {
                    "id": "401540309",
                    "text": "太夸张了…",
                    "response": [
                        {
                            "id": "401540311",
                            "speaker": "砂糖",
                            "text": "#不过，从{NICKNAME}的上手速度来看，药剂炼金技术的推广应该不成问题…"
                        },
                        {
                            "id": "401540312",
                            "speaker": "丽莎",
                            "text": "难道说，这也是琴的安排吗？"
                        },
                        {
                            "id": "401540313",
                            "speaker": "砂糖",
                            "text": "嗯，是琴和阿贝多先生讨论之后的结果…不仅仅是炼金的产物，我们希望将实用的炼金技术也向民间推广。"
                        },
                        {
                            "id": "401540314",
                            "speaker": "砂糖",
                            "text": "经过你们的开店售卖，民众对炼金药剂的了解程度变高了。将来大家或许能够自行炼制简单的药剂…"
                        },
                        {
                            "id": "401540315",
                            "speaker": "丽莎",
                            "text": "这样一来，药剂的安全性就成了问题吧？"
                        },
                        {
                            "id": "401540316",
                            "speaker": "砂糖",
                            "text": "#是的…{NICKNAME}有丽莎的指导，在炼制方法上不会出错，但是对于一般人来说，我们必须确保炼金药剂的安全性。"
                        },
                        {
                            "id": "401540317",
                            "speaker": "砂糖",
                            "text": "因此，阿贝多先生打算制定一套炼金等级标准，一般人要通过相应级别的考核，才能获得炼制药剂的许可。"
                        },
                        {
                            "id": "401540318",
                            "speaker": "丽莎",
                            "text": "让我猜猜…你想让我们也参与这个考核吧？"
                        },
                        {
                            "id": "401540319",
                            "speaker": "砂糖",
                            "text": "准确来说，是参与考核标准的制定…"
                        },
                        {
                            "id": "401540320",
                            "speaker": "砂糖",
                            "text": "#为了让正式考核的难度能够更加合理，需要收集足够的模拟考核数据，{NICKNAME}的完成情况会成为我们的重要参考。"
                        },
                        {
                            "id": "401540321",
                            "speaker": "砂糖",
                            "text": "当然，如果能顺利完成，我会给你们准备报酬的！"
                        },
                        {
                            "id": "401540322",
                            "speaker": "丽莎",
                            "text": "呵呵，听起来是不错的提议。我也想看看小可爱的炼金水平提升了多少。",
                            "choices": [
                                {
                                    "id": "401540323",
                                    "text": "可以一试。",
                                    "response": [
                                        {
                                            "id": "401540326",
                                            "speaker": "砂糖",
                                            "text": "那就让我来介绍一下考核的情况吧。考核一共分成四个等级，初级、中级、高级和特级。"
                                        },
                                        {
                                            "id": "401540327",
                                            "speaker": "砂糖",
                                            "text": "每一次考核，只要在限定时间内，炼制出来的药剂满足主要目标，就视为通过。"
                                        },
                                        {
                                            "id": "401540328",
                                            "speaker": "砂糖",
                                            "text": "如果同时满足了附加目标，还可以得到额外的奖励。"
                                        },
                                        {
                                            "id": "401540329",
                                            "speaker": "派蒙",
                                            "text": "哇，听起来好正式，一下子就有紧张感了呢。"
                                        },
                                        {
                                            "id": "401540330",
                                            "speaker": "砂糖",
                                            "text": "其实你们就像平时一样去操作就好了。就算失败了我也会安排重考，不用有心理负担的。"
                                        },
                                        {
                                            "id": "401540331",
                                            "speaker": "派蒙",
                                            "text": "嘿嘿，原来有补考机会，这样就安心多了！"
                                        },
                                        {
                                            "id": "401540332",
                                            "speaker": "砂糖",
                                            "text": "嗯！如果准备好了就和我说吧。",
                                            "choices": [
                                                {
                                                    "id": "401540333",
                                                    "text": "查看考核要求。"
                                                },
                                                {
                                                    "id": "401540334",
                                                    "text": "还需要时间。",
                                                    "response": [
                                                        {
                                                            "id": "401540335",
                                                            "speaker": "砂糖",
                                                            "text": "没关系，我会在这边等你的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "401540324",
                                    "text": "放马过来吧。",
                                    "response": [
                                        {
                                            "id": "401540325",
                                            "speaker": "丽莎",
                                            "text": "小可爱很有自信嘛，这是好事哦。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "401540310",
                    "text": "我只是初学者。"
                }
            ]
        }
    ]
}