{
    "talkId": "7154105",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 3,
        "瑶露": 14
    },
    "dialogues": [
        {
            "id": "715410501",
            "speaker": "瑶露",
            "text": "你好！想要试试「八奇乱斗」吗？",
            "choices": [
                {
                    "id": "715410502",
                    "text": "开始吧！"
                },
                {
                    "id": "715410503",
                    "text": "「八奇乱斗」是什么？",
                    "response": [
                        {
                            "id": "715410504",
                            "speaker": "瑶露",
                            "text": "简单来说，「八奇乱斗」是一种用小藤人互相拼斗的游戏，这种游戏其实在我们那边已经流传了很久。"
                        },
                        {
                            "id": "715410505",
                            "speaker": "瑶露",
                            "text": "在之前，大家会编制出属于自己的小藤人，然后操纵这些小藤人互相拼斗。"
                        },
                        {
                            "id": "715410506",
                            "speaker": "瑶露",
                            "text": "有些控制小藤条的高手，甚至能让它舞出一套真正的剑法呢。"
                        },
                        {
                            "id": "715410507",
                            "speaker": "瑶露",
                            "text": "不过之后嘛…大家都有了更好玩的东西，渐渐地就把这种游戏给放到了一旁，小藤人也只是单纯作为纪念品售卖。"
                        },
                        {
                            "id": "715410508",
                            "speaker": "瑶露",
                            "text": "但是，我小时候最喜欢玩小藤人了，经常缠着家里人，要他们陪我玩，或者是帮我编藤人。"
                        },
                        {
                            "id": "715410509",
                            "speaker": "瑶露",
                            "text": "我奶奶编的藤人可好看了，我给藤人上色的功夫，就是她教给我的。"
                        },
                        {
                            "id": "715410510",
                            "speaker": "瑶露",
                            "text": "爷爷的手很巧，会用木头削出各种武器，把我的小藤人武装得超级厉害。"
                        },
                        {
                            "id": "715410511",
                            "speaker": "瑶露",
                            "text": "还有爸爸妈妈，无论多忙，都会抽时间来陪我玩小藤人…"
                        },
                        {
                            "id": "715410512",
                            "speaker": "瑶露",
                            "text": "嘿嘿，也许是我经常把小藤人摆在座位上，让总务司注意到了吧…"
                        },
                        {
                            "id": "715410513",
                            "speaker": "瑶露",
                            "text": "今年的海灯节，总务司居然增设了一个和小藤人有关的摊位…就是这里的「八奇乱斗」啦。"
                        },
                        {
                            "id": "715410514",
                            "speaker": "瑶露",
                            "text": "我一听说，就自告奋勇地说，可以由我来负责这个摊位的相关事宜，总务司也答应了。"
                        },
                        {
                            "id": "715410515",
                            "speaker": "瑶露",
                            "text": "你想试试吗？可好玩了！而且每个小藤人都是由蓝砚师傅亲手编的，她编得可好看啦！"
                        }
                    ]
                },
                {
                    "id": "715410516",
                    "text": "还有别的事…",
                    "response": [
                        {
                            "id": "715410517",
                            "speaker": "瑶露",
                            "text": "嗯。你先忙去吧，想玩的话，就来摊位这边找我。"
                        }
                    ]
                }
            ]
        }
    ]
}