{
    "talkId": "4007705",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 10,
        "辛焱": 16
    },
    "dialogues": [
        {
            "id": "400770501",
            "speaker": "辛焱",
            "text": "又有了新的作曲灵感…",
            "choices": [
                {
                    "id": "400770502",
                    "text": "要不要聊聊天？",
                    "response": [
                        {
                            "id": "400770503",
                            "speaker": "辛焱",
                            "text": "好啊好啊，我非常乐意。",
                            "choices": [
                                {
                                    "id": "400770506",
                                    "text": "关于朋友…",
                                    "response": [
                                        {
                                            "id": "400770507",
                                            "speaker": "辛焱",
                                            "text": "回去之后，我要好好跟她们分享这次的冒险故事。说不定，还能给云堇的璃月戏创作增添点灵感呢。"
                                        },
                                        {
                                            "id": "400770508",
                                            "speaker": "辛焱",
                                            "text": "至于香菱嘛，在我说起做饭话题的时候，肯定就会帮着出主意了。"
                                        },
                                        {
                                            "id": "400770509",
                                            "speaker": "辛焱",
                                            "text": "你知道的，她最专业了，肯定懂很多…类似不用炖锅也能做出好菜的方法，我想向她学一点…"
                                        },
                                        {
                                            "id": "400770510",
                                            "speaker": "辛焱",
                                            "text": "在新朋友有空来玩之前，得多练会几道看家菜才行。哦，烤堇瓜也安排上！"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770511",
                                    "text": "关于音乐…",
                                    "response": [
                                        {
                                            "id": "400770512",
                                            "speaker": "辛焱",
                                            "text": "这次在幻境中没弹摇滚，是不是让你有点遗憾？"
                                        },
                                        {
                                            "id": "400770513",
                                            "speaker": "Player",
                                            "text": "怎么会呢。"
                                        },
                                        {
                                            "id": "400770514",
                                            "speaker": "辛焱",
                                            "text": "呼，听你这样说，我就放心了。"
                                        },
                                        {
                                            "id": "400770515",
                                            "speaker": "辛焱",
                                            "text": "摇滚是我的最爱，这一点从来不会改变。"
                                        },
                                        {
                                            "id": "400770516",
                                            "speaker": "辛焱",
                                            "text": "但音乐也是情感的载体。比起单纯抒发自己的感受，我判断那样的形式会更切合场合。"
                                        },
                                        {
                                            "id": "400770517",
                                            "speaker": "辛焱",
                                            "text": "嘿嘿，这样说来，你也是我的知音了。"
                                        }
                                    ]
                                },
                                {
                                    "id": "400770518",
                                    "text": "关于这次假期…",
                                    "response": [
                                        {
                                            "id": "400770519",
                                            "speaker": "辛焱",
                                            "text": "简直太充实，太快乐了！"
                                        },
                                        {
                                            "id": "400770520",
                                            "speaker": "辛焱",
                                            "text": "多亏有你，还有那位吟游诗人小哥的邀请。"
                                        },
                                        {
                                            "id": "400770521",
                                            "speaker": "辛焱",
                                            "text": "也不知道他的驻场演唱顺不顺利…欠了他那么大一个人情，回头得好好感谢人家。"
                                        },
                                        {
                                            "id": "400770522",
                                            "speaker": "Player",
                                            "text": "一起请他喝一杯吧。"
                                        },
                                        {
                                            "id": "400770523",
                                            "speaker": "辛焱",
                                            "text": "好！那就这么说定了！"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "400770504",
                    "text": "先不打扰你了。",
                    "response": [
                        {
                            "id": "400770505",
                            "speaker": "辛焱",
                            "text": "好，别累着自己了哦。",
                            "choices": [
                                {
                                    "id": "400770506",
                                    "text": "关于朋友…"
                                },
                                {
                                    "id": "400770511",
                                    "text": "关于音乐…"
                                },
                                {
                                    "id": "400770518",
                                    "text": "关于这次假期…"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}