{
    "talkId": "7650809",
    "total_dialogue_lines": 32,
    "speaker_counts": {
        "Player": 7,
        "玛拉妮": 25
    },
    "dialogues": [
        {
            "id": "765080901",
            "speaker": "玛拉妮",
            "text": "#呀吼！{NICKNAME}，带着大家跳舞的感觉怎么样？在「流泉之众」见到须弥的老朋友，是不是也很意外？",
            "choices": [
                {
                    "id": "765080902",
                    "text": "跳舞，快乐！",
                    "response": [
                        {
                            "id": "765080903",
                            "speaker": "玛拉妮",
                            "text": "嘿嘿，那就太好了！"
                        },
                        {
                            "id": "765080904",
                            "speaker": "玛拉妮",
                            "text": "这次开了个不错的头以后，我们和「镀金旅团」中的「炽光猎兽」，就成了友好同盟！"
                        },
                        {
                            "id": "765080905",
                            "speaker": "玛拉妮",
                            "text": "我希望，这样的交流活动固定下来，没多久就来上一次，大家在悠悠哉哉的氛围里一起跳跳舞，多好！"
                        },
                        {
                            "id": "765080906",
                            "speaker": "玛拉妮",
                            "text": "就像，就像…每个月和朋友的定期聚餐！不用搞得特别正式，隆重，主打一个随性和亲切，来了就玩！"
                        },
                        {
                            "id": "765080907",
                            "speaker": "玛拉妮",
                            "text": "用不了多久，说不定就能探索出纳塔与须弥的融合舞蹈——既有着纳塔原野的热情，又有着须弥风沙的狂野…"
                        },
                        {
                            "id": "765080908",
                            "speaker": "玛拉妮",
                            "text": "哦哦，这个比喻好像太猛烈了，更适合战舞！"
                        },
                        {
                            "id": "765080909",
                            "speaker": "玛拉妮",
                            "text": "那就…暖暖的温泉水汽，和深奥的雨林花香结合，既可以富有动感，又能优雅而柔美！",
                            "choices": [
                                {
                                    "id": "765080910",
                                    "text": "大家多多交流，我支持！",
                                    "response": [
                                        {
                                            "id": "765080912",
                                            "speaker": "玛拉妮",
                                            "text": "嘿嘿，其实这次我邀请了卡齐娜哦！"
                                        },
                                        {
                                            "id": "765080913",
                                            "speaker": "玛拉妮",
                                            "text": "有一点不巧的是，卡齐娜正在「闭关修炼」新本领，而且，还说要给你们准备一个神秘礼物…"
                                        },
                                        {
                                            "id": "765080914",
                                            "speaker": "玛拉妮",
                                            "text": "嘘~别告诉她我给你透露了一点点，一点点小道消息。"
                                        },
                                        {
                                            "id": "765080915",
                                            "speaker": "玛拉妮",
                                            "text": "等到下次你们见面的时候就知道啦！"
                                        },
                                        {
                                            "id": "765080916",
                                            "speaker": "玛拉妮",
                                            "text": "至于之后的「舞术交流」，就包在我身上了，我会好好准备的！"
                                        }
                                    ]
                                },
                                {
                                    "id": "765080911",
                                    "text": "下次叫上更多朋友好了！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "765080917",
                    "text": "妮露，惊喜！",
                    "response": [
                        {
                            "id": "765080918",
                            "speaker": "玛拉妮",
                            "text": "哼哼…原来你之前认识这么厉害的舞蹈专家…下次要早早介绍给我认识哦！"
                        },
                        {
                            "id": "765080919",
                            "speaker": "玛拉妮",
                            "text": "妮露的舞蹈，让我见识到了厉害的新世界…"
                        },
                        {
                            "id": "765080920",
                            "speaker": "玛拉妮",
                            "text": "以前，我熟悉的舞蹈，大多是为了让身体里的活力迸发出来。"
                        },
                        {
                            "id": "765080921",
                            "speaker": "玛拉妮",
                            "text": "除了带来满满的元气和好心情，还能让身体做好各种运动，甚至是战斗的准备。"
                        },
                        {
                            "id": "765080922",
                            "speaker": "玛拉妮",
                            "text": "看过妮露的舞蹈以后，我才知道，原来动作舒缓，音乐清静的舞蹈，也能这么真切地直击人心。"
                        },
                        {
                            "id": "765080923",
                            "speaker": "玛拉妮",
                            "text": "真是一种…想不出词来描述感觉，就好像…游隙灵道上边缘散发的那种光芒，我只能说「漂亮」和「还想再看」…"
                        },
                        {
                            "id": "765080924",
                            "speaker": "玛拉妮",
                            "text": "哪怕是妮露跳上一整天，我都能老老实实坐下来看一整天！"
                        },
                        {
                            "id": "765080925",
                            "speaker": "玛拉妮",
                            "text": "哈哈，不过那也太让妮露受累了，开玩笑的！",
                            "choices": [
                                {
                                    "id": "765080926",
                                    "text": "我还有好多厉害朋友呢！",
                                    "response": [
                                        {
                                            "id": "765080928",
                                            "speaker": "玛拉妮",
                                            "text": "怎么…你是想诱惑我时时刻刻跟着你吗？"
                                        },
                                        {
                                            "id": "765080929",
                                            "speaker": "玛拉妮",
                                            "text": "我承认…确实很有吸引力，不过，那样也会给你添麻烦，我还是有分寸的！"
                                        },
                                        {
                                            "id": "765080930",
                                            "speaker": "玛拉妮",
                                            "text": "所以，等你觉得时机不错了，你再来叫上我，或者带着朋友来「流泉之众」，我们认识认识！"
                                        }
                                    ]
                                },
                                {
                                    "id": "765080927",
                                    "text": "各方面的高手都有的哦！"
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "765080931",
                    "text": "好玩，爱玩！",
                    "response": [
                        {
                            "id": "765080932",
                            "speaker": "玛拉妮",
                            "text": "哈哈哈，那你多带着喜欢跳舞的大家一起玩！"
                        }
                    ]
                }
            ]
        }
    ]
}