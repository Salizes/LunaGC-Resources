    "speaker_counts": {
        "Player": 3,
        "莱依拉": 4
    },
    "dialogues": [
        {
            "id": "401663101",
            "speaker": "莱依拉",
            "text": "想要归纳星星相互作用产生的影响么…真是个棘手的课题。",
            "choices": [
                {
                    "id": "401663102",
                    "text": "节日愉快，另一个莱依拉。",
                    "response": [
                        {
                            "id": "401663104",
                            "speaker": "莱依拉",
                            "text": "被发现了呢…但如你所见，现在的「莱依拉」可愉快不起来。"
                        },
                        {
                            "id": "401663105",
                            "speaker": "莱依拉",
                            "text": "截稿日撞上花神诞祭，研究的又是颇为复杂的「星相问题」…难怪她最近的梦游症状又加重了。"
                        },
                        {
                            "id": "401663106",
                            "speaker": "Player",
                            "text": "有什么我能帮忙的吗？"
                        },
                        {
                            "id": "401663107",
                            "speaker": "莱依拉",
                            "text": "很遗憾，庞杂精密的计算无法假手他人。如果可以的话，请多来看看她吧，我想她见到你会很开心的。"
                        }
                    ]
                },
                {
                    "id": "401663103",
                    "text": "节日愉快，「星空的赐福」。"
                }
            ]
        }
    ]
}