    "dialogues": [
        {
            "id": "711500301",
            "speaker": "瓦雷莎",
            "text": "你回来啦？我也吃饱了，咱们开始留影吧！",
            "choices": [
                {
                    "id": "711500302",
                    "text": "关于我刚放的霄灯…",
                    "response": [
                        {
                            "id": "711500303",
                            "speaker": "瓦雷莎",
                            "text": "#哇…飞得好高喔。{NICKNAME}，霄灯能不能放很多盏啊，我想帮部族里的每个人都放一盏霄灯。"
                        },
                        {
                            "id": "711500304",
                            "speaker": "瓦雷莎",
                            "text": "大家想要放飞的那些愿望，我都记在笔记本上了，有好多呢，嘿嘿…得买好多盏才行。",
                            "choices": [
                                {
                                    "id": "711500305",
                                    "text": "那咱们就开始？",
                                    "response": [
                                        {
                                            "id": "711500306",
                                            "speaker": "瓦雷莎",
                                            "text": "好呀，我要做出一个帅气的动作…不过，会不会不太适合留影呢…"
                                        },
                                        {
                                            "id": "711500307",
                                            "speaker": "瓦雷莎",
                                            "text": "#{NICKNAME}，不然你给我一点建议？",
                                            "choices": [
                                                {
                                                    "id": "711500310",
                                                    "text": "帅气一点的。",
                                                    "response": [
                                                        {
                                                            "id": "711500312",
                                                            "speaker": "Player",
                                                            "text": "就这个动作吧。"
                                                        }
                                                    ]
                                                },
                                                {
                                                    "id": "711500311",
                                                    "text": "放松一点的。"
                                                }
                                            ]
                                        }
                                    ]
                                },
                                {
                                    "id": "711500308",
                                    "text": "稍等一会…",
                                    "response": [
                                        {
                                            "id": "711500309",
                                            "speaker": "瓦雷莎",
                                            "text": "是有其他的事要忙？好呀，嘿嘿…我先吃点东西…"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                {
                    "id": "711500305",
                    "text": "那咱们就开始？"
                },
                {
                    "id": "711500308",
                    "text": "稍等一会…"
                }
            ]
        }
    ]
}