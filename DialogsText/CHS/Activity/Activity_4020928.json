{
    "talkId": "4020928",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "海鹰": 9
    },
    "dialogues": [
        {
            "id": "402092801",
            "speaker": "海鹰",
            "text": "周边海域的情况目前稳定…没有魔物接近的迹象，也没有海盗水匪活动。",
            "choices": [
                {
                    "id": "402092802",
                    "text": "你在警戒吗？",
                    "response": [
                        {
                            "id": "402092803",
                            "speaker": "海鹰",
                            "text": "没错，我是本舰的「情报态势员」，负责综合各方信息，为本舰的行动规划提供支持。"
                        },
                        {
                            "id": "402092804",
                            "speaker": "海鹰",
                            "text": "之前听闻，挪德卡莱自由而混乱，我还担心，会不会有海盗船在附近游荡，需要我们动用主武装将其击沉？"
                        },
                        {
                            "id": "402092805",
                            "speaker": "海鹰",
                            "text": "或者…会不会有亡命徒趁着夜色摸上船来行窃，甚至是明抢？"
                        },
                        {
                            "id": "402092806",
                            "speaker": "海鹰",
                            "text": "由于本舰强调持久且低消耗地执勤，配置的舰员并不多，如果被拖入了跳帮甲板战，会相当麻烦。"
                        },
                        {
                            "id": "402092807",
                            "speaker": "海鹰",
                            "text": "几个月前，遇上一群擅长夜间登船偷袭的海盗时，我们几人被打得遍体鳞伤，还好最后将他们都击退了…"
                        },
                        {
                            "id": "402092808",
                            "speaker": "海鹰",
                            "text": "意外的是，经过确认，挪德卡莱的确存在一些危险的家伙，但他们都没敢接近这次的会场…"
                        },
                        {
                            "id": "402092809",
                            "speaker": "海鹰",
                            "text": "看来，主办方的手段相当了得啊！也不知道北斗大姐头有没有机会拉那位负责人入伙…确立长期合作的关系也不错！"
                        }
                    ]
                },
                {
                    "id": "402092810",
                    "text": "（他很投入啊，就不打扰他了。）",
                    "response": [
                        {
                            "id": "402092811",
                            "speaker": "海鹰",
                            "text": "太平静了…也不能放松警惕啊。"
                        }
                    ]
                }
            ]
        }
    ]
}