    "talks": [
        {
            "talkId": "7166101",
            "initDialog": "716580101",
            "dialogues": [
                {
                    "id": "716580101",
                    "speaker": "凝光",
                    "text": "又是一年海灯节。"
                },
                {
                    "id": "716580102",
                    "speaker": "凝光",
                    "text": "旅行者，璃月港是否会让你感到眷恋？",
                    "choices": [
                        {
                            "id": "716580103",
                            "text": "常有这样的感觉…",
                            "response": [
                                {
                                    "id": "716580104",
                                    "speaker": "凝光",
                                    "text": "是吗，你能这么说，我很欣慰。"
                                },
                                {
                                    "id": "716580107",
                                    "speaker": "凝光",
                                    "text": "岁月如梭，海灯节也已今非昔比。"
                                },
                                {
                                    "id": "716580108",
                                    "speaker": "凝光",
                                    "text": "今年的筹备工作花了不少时间。不论旁人喜欢与否，我自己对这片景色还是很满意的。"
                                },
                                {
                                    "id": "716580109",
                                    "speaker": "凝光",
                                    "text": "希望它也能成为你旅途中的一抹亮色。感到疲劳的时候，就回璃月来看看吧。"
                                }
                            ]
                        },
                        {
                            "id": "716580105",
                            "text": "我的使命，在于旅行。",
                            "response": [
                                {
                                    "id": "716580106",
                                    "speaker": "凝光",
                                    "text": "嗯，也是。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}