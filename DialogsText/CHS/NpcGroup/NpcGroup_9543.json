    "talks": [
        {
            "talkId": "6954301",
            "initDialog": "695430101",
            "dialogues": [
                {
                    "id": "695430101",
                    "speaker": "枫原万叶",
                    "text": "这酒馆里骰子落桌的声音连成一片，听起来就像一场正在泼洒的倾盆暴雨啊…"
                }
            ]
        },
        {
            "talkId": "6954302",
            "initDialog": "695430201",
            "dialogues": [
                {
                    "id": "695430201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954303",
            "initDialog": "695430301",
            "dialogues": [
                {
                    "id": "695430301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695430302",
                    "speaker": "枫原万叶",
                    "text": "嗯，再与人切磋几局后，我也得离开了…时间不早了。"
                }
            ]
        },
        {
            "talkId": "6954304",
            "initDialog": "695430401",
            "dialogues": [
                {
                    "id": "695430401",
                    "speaker": "枫原万叶",
                    "text": "别丧气啊，我这局只是赢在几手讨巧小招，再来一局，我未必能胜你。"
                }
            ]
        },
        {
            "talkId": "6954305",
            "initDialog": "695430501",
            "dialogues": [
                {
                    "id": "695430501",
                    "speaker": "枫原万叶",
                    "text": "是你赢了。我对这种牌戏的造诣，实不如你。"
                }
            ]
        },
        {
            "talkId": "6954306",
            "initDialog": "695430601",
            "dialogues": [
                {
                    "id": "695430601",
                    "speaker": "枫原万叶",
                    "text": "天晴日朗…正适合来场牌戏。"
                }
            ]
        },
        {
            "talkId": "6954308",
            "initDialog": "695430801",
            "dialogues": [
                {
                    "id": "695430801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954309",
            "initDialog": "695430901",
            "dialogues": [
                {
                    "id": "695430901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6954310",
            "initDialog": "695431001",
            "dialogues": [
                {
                    "id": "695431001",
                    "speaker": "枫原万叶",
                    "text": "专心致志，自然滴水不漏。"
                }
            ]
        },
        {
            "talkId": "6954311",
            "initDialog": "695431101",
            "dialogues": [
                {
                    "id": "695431101",
                    "speaker": "枫原万叶",
                    "text": "怎么会在这里疏漏，还是心不够静啊…"
                }
            ]
        },
        {
            "talkId": "6954312",
            "initDialog": "695431201",
            "dialogues": [
                {
                    "id": "695431201",
                    "speaker": "枫原万叶",
                    "text": "这牌戏颇有妙趣…我正有意再来几局。"
                }
            ]
        },
        {
            "talkId": "6954314",
            "initDialog": "695431401",
            "dialogues": [
                {
                    "id": "695431401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954315",
            "initDialog": "695431501",
            "dialogues": [
                {
                    "id": "695431501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6954316",
            "initDialog": "695431601",
            "dialogues": [
                {
                    "id": "695431601",
                    "speaker": "枫原万叶",
                    "text": "酣畅淋漓的对局，真让人心情愉快。"
                }
            ]
        },
        {
            "talkId": "6954317",
            "initDialog": "695431701",
            "dialogues": [
                {
                    "id": "695431701",
                    "speaker": "枫原万叶",
                    "text": "我已倾力对局，可谓虽败无憾。"
