{
    "groupId": "4421",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "纳杰特": 7
    },
    "talks": [
        {
            "talkId": "6442101",
            "initDialog": "644210101",
            "dialogues": [
                {
                    "id": "644210101",
                    "speaker": "纳杰特",
                    "text": "我想想，今天入库的东西…嗯，没问题，数量都对得上。"
                }
            ]
        },
        {
            "talkId": "6442102",
            "initDialog": "644210201",
            "dialogues": [
                {
                    "id": "644210201",
                    "speaker": "Player",
                    "text": "你是在…"
                },
                {
                    "id": "644210202",
                    "speaker": "纳杰特",
                    "text": "啊，抱歉，刚刚正在心里清点货物的数量，怠慢了你。"
                },
                {
                    "id": "644210203",
                    "speaker": "纳杰特",
                    "text": "这里是存放村中必需品的地方，每天都需要清点核对数量，保证万无一失。"
                },
                {
                    "id": "644210204",
                    "speaker": "纳杰特",
                    "text": "不过也不用紧张，哈巴奇先生虽然非常严肃，但我们是不会毫无缘由地对每个靠近仓库的人严加审问的啦。"
                }
            ]
        },
        {
            "talkId": "6442103",
            "initDialog": "644210301",
            "dialogues": [
                {
                    "id": "644210301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "644210302",
                    "speaker": "纳杰特",
                    "text": "欸？…啊，再见！"
                }
            ]
        },
        {
            "talkId": "6442104",
            "initDialog": "644210401",
            "dialogues": [
                {
                    "id": "644210401",
                    "speaker": "Player",
                    "text": "看来仓库真的很重要。"
                },
                {
                    "id": "644210402",
                    "speaker": "纳杰特",
                    "text": "嗯，这点明眼人都看得出来，所以我们也不会特意掩盖。"
                },
                {
                    "id": "644210403",
                    "speaker": "纳杰特",
                    "text": "一旦村子遇到危险，我们会第一时间停运白之梯，切断吊桥，固守仓库。"
                }
            ]
        }
    ]
}