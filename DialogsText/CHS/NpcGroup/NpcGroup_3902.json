    "talks": [
        {
            "talkId": "6390201",
            "initDialog": "639020101",
            "dialogues": [
                {
                    "id": "639020101",
                    "speaker": "（test）Override小孩$UNRELEASED",
                    "text": "（test）谁呀…啊，爸爸说要有礼貌一些…$UNRELEASED"
                },
                {
                    "id": "639020102",
                    "speaker": "（test）Override小孩$UNRELEASED",
                    "text": "（test）…你好？$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "6390202",
            "initDialog": "639020201",
            "dialogues": [
                {
                    "id": "639020201",
                    "speaker": "Player",
                    "text": "（test）你的爸爸？"
                },
                {
                    "id": "639020202",
                    "speaker": "（test）Override小孩$UNRELEASED",
                    "text": "（test）嗯，他是个冒险家。$UNRELEASED"
                },
                {
                    "id": "639020203",
                    "speaker": "（test）Override小孩$UNRELEASED",
                    "text": "（test）他说好了要接我来雪山看雪的，不过约定的日子到了，爸爸却一直没有来接我…$UNRELEASED"
                },
                {
                    "id": "639020204",
                    "speaker": "（test）Override小孩$UNRELEASED",
                    "text": "（test）我猜，他一定是发现了什么珍贵秘宝的藏宝图之类的，所以才没来找我的，一定是这样的。$UNRELEASED"
                },
                {
                    "id": "639020205",
                    "speaker": "（test）Override小孩$UNRELEASED",
                    "text": "（test）我就一个人来到雪山了。既然他没法来找我，我就来找他好了…$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "6390203",
            "initDialog": "639020301",
            "dialogues": [
                {
                    "id": "639020301",
                    "speaker": "Player",
                    "text": "（test）那你找到他了吗？"
                },
                {
                    "id": "639020302",
                    "speaker": "（test）Override小孩$UNRELEASED",
                    "text": "（test）没有…不过那位西风骑士叔叔说，看到他往山顶上走了。$UNRELEASED"
                },
                {
                    "id": "639020303",
                    "speaker": "（test）Override小孩$UNRELEASED",
                    "text": "（test）我、我想去找他，但西风骑士叔叔不让我去，我只好暂时住在这里等我爸爸了…$UNRELEASED"
                },
                {
                    "id": "639020304",
                    "speaker": "（test）Override小孩$UNRELEASED",
                    "text": "（test）我一定会见到他的，我们约好了一起看雪的，他会遵守约定的。$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "6390204",
            "initDialog": "639020401",
            "dialogues": [
                {
                    "id": "639020401",
                    "speaker": "Player",
                    "text": "（test）再见。"
                },
                {
                    "id": "639020402",
                    "speaker": "（test）Override小孩$UNRELEASED",
                    "text": "（test）再见。$UNRELEASED"
                }
            ]
        }
    ]
}