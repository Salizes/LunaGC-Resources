{
    "groupId": "2504",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "宜清": 10
    },
    "talks": [
        {
            "talkId": "6250401",
            "initDialog": "625040101",
            "dialogues": [
                {
                    "id": "625040101",
                    "speaker": "宜清",
                    "text": "再试试新的药方好了…"
                }
            ]
        },
        {
            "talkId": "6250402",
            "initDialog": "625040201",
            "dialogues": [
                {
                    "id": "625040201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "625040202",
                    "speaker": "宜清",
                    "text": "小老我是本地的郎中。若是小友身体不适，随时可以上我这儿来，让我瞧瞧。"
                },
                {
                    "id": "625040203",
                    "speaker": "宜清",
                    "text": "年轻人火气太旺，在这深山之中反倒更容易患病。"
                }
            ]
        },
        {
            "talkId": "6250403",
            "initDialog": "625040301",
            "dialogues": [
                {
                    "id": "625040301",
                    "speaker": "Player",
                    "text": "为什么要试新药方？"
                },
                {
                    "id": "625040302",
                    "speaker": "宜清",
                    "text": "这世上没有万能的药方，医者需要根据不同患者的实际情况对症下药。"
                },
                {
                    "id": "625040303",
                    "speaker": "宜清",
                    "text": "要是不巧遇上了疑难杂症，那就得翻箱倒柜，找出压箱底的药方了。"
                },
                {
                    "id": "625040304",
                    "speaker": "宜清",
                    "text": "前提是医者积累了足够的见闻，熟悉的药方足够多…"
                },
                {
                    "id": "625040305",
                    "speaker": "宜清",
                    "text": "而为了掌握不同药方的效果，小老我也必须多多试错才行。"
                }
            ]
        },
        {
            "talkId": "6250404",
            "initDialog": "625040401",
            "dialogues": [
                {
                    "id": "625040401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "625040402",
                    "speaker": "宜清",
                    "text": "注意锻炼，平衡饮食。"
                }
            ]
        },
        {
            "talkId": "7195501",
            "initDialog": "719550101",
            "dialogues": [
                {
                    "id": "719550101",
                    "speaker": "Player",
                    "text": "火气？"
                },
                {
                    "id": "719550102",
                    "speaker": "宜清",
                    "text": "火气便是人身体内的阳邪之症，年轻人身体亢奋，因此容易受其影响。"
                },
                {
                    "id": "719550103",
                    "speaker": "宜清",
                    "text": "小老我这里有几株清热祛火的药材，配合凉茶服下效果极佳，还请你收下。"
                }
            ]
        }
    ]
}