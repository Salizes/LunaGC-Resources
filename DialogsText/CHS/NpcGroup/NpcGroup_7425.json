{
    "groupId": "7425",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "万尼亚": 7
    },
    "talks": [
        {
            "talkId": "6742501",
            "initDialog": "674250101",
            "dialogues": [
                {
                    "id": "674250101",
                    "speaker": "万尼亚",
                    "text": "呜呃…等等，到底在哪来着…呃…"
                }
            ]
        },
        {
            "talkId": "6742502",
            "initDialog": "674250201",
            "dialogues": [
                {
                    "id": "674250201",
                    "speaker": "Player",
                    "text": "你又怎么了？"
                },
                {
                    "id": "674250202",
                    "speaker": "万尼亚",
                    "text": "我、我遭遇了很可怕的事…我，在地上捡到了上面画有符文的金饼…"
                },
                {
                    "id": "674250203",
                    "speaker": "万尼亚",
                    "text": "紧接着就有人…搂着我的肩膀，带我到了…一个人面前，他取走了我的金饼，递给了我奇怪的饮料…"
                },
                {
                    "id": "674250204",
                    "speaker": "万尼亚",
                    "text": "我喝了…一杯又一杯…现在我…忘记了很多事，甚至忘记了回家的路…"
                }
            ]
        },
        {
            "talkId": "6742503",
            "initDialog": "674250301",
            "dialogues": [
                {
                    "id": "674250301",
                    "speaker": "Player",
                    "text": "需要帮忙吗？"
                },
                {
                    "id": "674250302",
                    "speaker": "万尼亚",
                    "text": "不用帮忙，帮什么忙？我…我…还行，再给我…再给我一杯…"
                }
            ]
        },
        {
            "talkId": "6742504",
            "initDialog": "674250401",
            "dialogues": [
                {
                    "id": "674250401",
                    "speaker": "Player",
                    "text": "…你这不就是去酒馆买酒吗！"
                },
                {
                    "id": "674250402",
                    "speaker": "万尼亚",
                    "text": "哈哈…是、是吗？"
                }
            ]
        },
        {
            "talkId": "6742505",
            "initDialog": "674250501",
            "dialogues": [
                {
                    "id": "674250501",
                    "speaker": "Player",
                    "text": "你又喝多了！"
                },
                {
                    "id": "674250502",
                    "speaker": "万尼亚",
                    "text": "哦…可是，你看我…这次可没，醉倒在地上…我、我还能走…"
                }
            ]
        }
    ]
}