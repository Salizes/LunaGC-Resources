{
    "groupId": "7173",
    "total_dialogue_lines": 95,
    "speaker_counts": {
        "Black Screen": 6,
        "Player": 24,
        "嘉明": 12,
        "夏沃蕾": 10,
        "派蒙": 14,
        "爱可菲": 15,
        "艾梅莉埃": 14
    },
    "talks": [
        {
            "talkId": "6717301",
            "initDialog": "671730101",
            "dialogues": [
                {
                    "id": "671730101",
                    "speaker": "派蒙",
                    "text": "怎么柜台后面都没人，这上面怎么…"
                },
                {
                    "id": "671730102",
                    "speaker": "派蒙",
                    "text": "怎么贴着我的头像啊！"
                },
                {
                    "id": "671730103",
                    "speaker": "Player",
                    "text": "这留言板上还写着字呢…"
                },
                {
                    "id": "671730104",
                    "speaker": "派蒙",
                    "text": "#「{NICKNAME}和派蒙，拜托拜托拜托帮我值个班，我有急事要出去一趟…」"
                },
                {
                    "id": "671730105",
                    "speaker": "派蒙",
                    "text": "啊？但雅珂达怎么知道我们要来，要是我们不来，不就…"
                },
                {
                    "id": "671730106",
                    "speaker": "Player",
                    "text": "后面还有字呢。"
                },
                {
                    "id": "671730107",
                    "speaker": "派蒙",
                    "text": "「…因为我刚才看见你们进来了，所以才拜托你们帮忙，拜托拜托拜托——」",
                    "choices": [
                        {
                            "id": "671730108",
                            "text": "感觉整页纸上都写着拜托…",
                            "response": [
                                {
                                    "id": "671730110",
                                    "speaker": "派蒙",
                                    "text": "好吧，虽然雅珂达让我们帮她值班，但我们应该做什么呢？",
                                    "choices": [
                                        {
                                            "id": "671730111",
                                            "text": "不知道…"
                                        },
                                        {
                                            "id": "671730112",
                                            "text": "总之先等着吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "671730109",
                            "text": "就帮她这个忙吧…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6717302",
            "initDialog": "671730218",
            "dialogues": [
                {
                    "id": "671730218",
                    "speaker": "Black Screen",
                    "text": "在柜台后站定不久，就有一位客人来访…"
                },
                {
                    "id": "671730201",
                    "speaker": "嘉明",
                    "text": "#老板，我前些天找你订购的…哗！{NICKNAME}，派蒙，你们怎么在这里？",
                    "choices": [
                        {
                            "id": "671730202",
                            "text": "嘉明？",
                            "response": [
                                {
                                    "id": "671730204",
                                    "speaker": "嘉明",
                                    "text": "不得了不得了，你们怎么在这里都有朋友？人脉简直比我们走镖的都广呀。"
                                },
                                {
                                    "id": "671730205",
                                    "speaker": "派蒙",
                                    "text": "好了好了，接下来轮到我们问了。嘉明怎么来挪德卡莱了？璃月不是离这里超远吗？"
                                },
                                {
                                    "id": "671730206",
                                    "speaker": "嘉明",
                                    "text": "这个啊，因为我有一个认识的叔叔住在这里，正好他们家长辈过寿辰。"
                                },
                                {
                                    "id": "671730207",
                                    "speaker": "嘉明",
                                    "text": "老爷子很思念家乡，说不要金不要银，美味佳肴也不要，就想看一场璃月的舞兽戏。"
                                },
                                {
                                    "id": "671730219",
                                    "speaker": "嘉明",
                                    "text": "但叔叔和家里那位长辈的年纪都很大了，回璃月是不可能了…所以，就来拜托我来挪德卡莱，给老爷子演一段。"
                                },
                                {
                                    "id": "671730208",
                                    "speaker": "嘉明",
                                    "text": "正巧跑镖的兄弟们说，有一趟镖是送到挪德卡莱的，我就和他们一起过来了。"
                                },
                                {
                                    "id": "671730209",
                                    "speaker": "Player",
                                    "text": "路上没遇见危险吧？"
                                },
                                {
                                    "id": "671730210",
                                    "speaker": "嘉明",
                                    "text": "倒是遇见过几个劫道的小贼，被我们三两下就赶跑了，人和货都没事。"
                                },
                                {
                                    "id": "671730211",
                                    "speaker": "嘉明",
                                    "text": "哎，说正事，我来这里是想要拜托奈芙尔老板帮我联系一下供货的人，帮我找一批上好的木材。"
                                },
                                {
                                    "id": "671730212",
                                    "speaker": "嘉明",
                                    "text": "等木材到位，我就可以搭台子，开始演舞兽戏啦。",
                                    "choices": [
                                        {
                                            "id": "671730213",
                                            "text": "我记一下喔。",
                                            "response": [
                                                {
                                                    "id": "671730215",
                                                    "speaker": "嘉明",
                                                    "text": "#好嘞，谢啦{NICKNAME}，等回了璃月，我请你吃…咦？好像有人在叫我…"
                                                },
                                                {
                                                    "id": "671730216",
                                                    "speaker": "嘉明",
                                                    "text": "#哎呀，肯定是押镖的兄弟在找我，我先走了啊{NICKNAME}回头见！"
                                                },
                                                {
                                                    "id": "671730217",
                                                    "speaker": "嘉明",
                                                    "text": "来了！来了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "671730214",
                                            "text": "木材…嘉明…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "671730203",
                            "text": "帮朋友代班…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6717303",
            "initDialog": "671730322",
            "dialogues": [
                {
                    "id": "671730322",
                    "speaker": "Black Screen",
                    "text": "在柜台后站定不久，就有一位客人来访…"
                },
                {
                    "id": "671730301",
                    "speaker": "爱可菲",
                    "text": "这里应该就是「秘闻馆」…咦？"
                },
                {
                    "id": "671730302",
                    "speaker": "爱可菲",
                    "text": "#{NICKNAME}，派蒙？真是巧了，居然在这里遇见你们。"
                },
                {
                    "id": "671730303",
                    "speaker": "爱可菲",
                    "text": "你们这是在…",
                    "choices": [
                        {
                            "id": "671730304",
                            "text": "帮朋友代班啦。",
                            "response": [
                                {
                                    "id": "671730306",
                                    "speaker": "爱可菲",
                                    "text": "欸…你们也不容易啊。"
                                },
                                {
                                    "id": "671730307",
                                    "speaker": "爱可菲",
                                    "text": "对了，你们认识一个机器女孩么？她身上带着一股很浓郁的蛋卷味。"
                                },
                                {
                                    "id": "671730308",
                                    "speaker": "爱可菲",
                                    "text": "而且，这种蛋卷的香气非常的…单纯，闻起来并没有使用太多的复合香料。"
                                },
                                {
                                    "id": "671730309",
                                    "speaker": "爱可菲",
                                    "text": "在这个年头，单纯到这个地步的蛋卷可不常见，我还挺好奇这种蛋卷配方的。"
                                },
                                {
                                    "id": "671730310",
                                    "speaker": "爱可菲",
                                    "text": "可是，我还没来得及问她，这机器女孩就走远了。"
                                },
                                {
                                    "id": "671730311",
                                    "speaker": "派蒙",
                                    "text": "蛋卷…机器女孩…那肯定是伊涅芙啦。"
                                },
                                {
                                    "id": "671730312",
                                    "speaker": "爱可菲",
                                    "text": "你们认识？那太好了，她住在哪里？我想要去拜访一下。"
                                },
                                {
                                    "id": "671730313",
                                    "speaker": "爱可菲",
                                    "text": "那个机器人女孩喜欢吃…呃，她应该不吃普通的食物吧，我给她买点…机油？"
                                },
                                {
                                    "id": "671730314",
                                    "speaker": "Player",
                                    "text": "倒是可以给爱诺带点好吃的…"
                                },
                                {
                                    "id": "671730315",
                                    "speaker": "爱可菲",
                                    "text": "爱诺？这位是…"
                                },
                                {
                                    "id": "671730316",
                                    "speaker": "Black Screen",
                                    "text": "向爱可菲详细叙述了爱诺和伊涅芙的关系，还有她们的住所…"
                                },
                                {
                                    "id": "671730317",
                                    "speaker": "爱可菲",
                                    "text": "原来如此…小孩子吃太多甜的确实不太好。"
                                },
                                {
                                    "id": "671730318",
                                    "speaker": "派蒙",
                                    "text": "这不是重点吧我说…"
                                },
                                {
                                    "id": "671730319",
                                    "speaker": "爱可菲",
                                    "text": "不过，这可难不住我，我知道很多好吃且不甜的小零食。"
                                },
                                {
                                    "id": "671730320",
                                    "speaker": "爱可菲",
                                    "text": "嗯，我这就去借个厨房，等做好了零食，我再去那个工坊拜访。"
                                },
                                {
                                    "id": "671730321",
                                    "speaker": "爱可菲",
                                    "text": "真不错，这一趟挪德卡莱可算是没来错，不仅拿到了新食材，还能见识到特别的配方…"
                                }
                            ]
                        },
                        {
                            "id": "671730305",
                            "text": "在挪德卡莱工作。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6717304",
            "initDialog": "671730416",
            "dialogues": [
                {
                    "id": "671730416",
                    "speaker": "Black Screen",
                    "text": "在柜台后站定不久，就有一位客人来访…"
                },
                {
                    "id": "671730401",
                    "speaker": "夏沃蕾",
                    "text": "#你们好，{NICKNAME}，派蒙。",
                    "choices": [
                        {
                            "id": "671730402",
                            "text": "夏、夏沃蕾？",
                            "response": [
                                {
                                    "id": "671730404",
                                    "speaker": "派蒙",
                                    "text": "夏沃蕾怎么会来挪德卡莱？是…是来抓人的么？"
                                },
                                {
                                    "id": "671730405",
                                    "speaker": "夏沃蕾",
                                    "text": "不是，我只是来给特巡队物色一个特训地点。"
                                },
                                {
                                    "id": "671730406",
                                    "speaker": "夏沃蕾",
                                    "text": "各位特巡队员一直在枫丹作训，已经慢慢产生了训练惯性。"
                                },
                                {
                                    "id": "671730407",
                                    "speaker": "夏沃蕾",
                                    "text": "平时训练时，虽然手脚确实在动，但却不怎么动脑，只要完成了一天的训练量就行。"
                                },
                                {
                                    "id": "671730408",
                                    "speaker": "夏沃蕾",
                                    "text": "长此以往，特巡队一定会失去应对突发状况的能力。"
                                },
                                {
                                    "id": "671730409",
                                    "speaker": "夏沃蕾",
                                    "text": "所以，我打算定期把特巡队拉到枫丹外进行特训，以此来训练特巡队应对陌生任务地点与突发状况的能力。"
                                },
                                {
                                    "id": "671730410",
                                    "speaker": "夏沃蕾",
                                    "text": "奈芙尔老板已经帮我联系好了一处地点，我这次是来付钱的。"
                                },
                                {
                                    "id": "671730411",
                                    "speaker": "夏沃蕾",
                                    "text": "#{NICKNAME}，既然今天是你在代班，那就请你帮我这些钱转交给奈芙尔老板吧。",
                                    "choices": [
                                        {
                                            "id": "671730412",
                                            "text": "啊…行。",
                                            "response": [
                                                {
                                                    "id": "671730415",
                                                    "speaker": "夏沃蕾",
                                                    "text": "那么，我就先告辞了。我要尽快回枫丹，做一下准备工作了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "671730413",
                                            "text": "你就不担心我…",
                                            "response": [
                                                {
                                                    "id": "671730414",
                                                    "speaker": "夏沃蕾",
                                                    "text": "我相信你的品德。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "671730403",
                            "text": "我揉揉眼睛…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6717305",
            "initDialog": "671730521",
            "dialogues": [
                {
                    "id": "671730521",
                    "speaker": "Black Screen",
                    "text": "在柜台后站定不久，就有一位客人来访…"
                },
                {
                    "id": "671730501",
                    "speaker": "艾梅莉埃",
                    "text": "#{NICKNAME}，派蒙，好久不见，也久疏问候了。"
                },
                {
                    "id": "671730502",
                    "speaker": "派蒙",
                    "text": "艾梅莉埃！好久不见——"
                },
                {
                    "id": "671730503",
                    "speaker": "Player",
                    "text": "很高兴见到你。"
                },
                {
                    "id": "671730504",
                    "speaker": "派蒙",
                    "text": "#我和{NICKNAME}正在这里帮忙代班，有什么事要帮忙的话尽管说就是啦。"
                },
                {
                    "id": "671730505",
                    "speaker": "艾梅莉埃",
                    "text": "多谢二位。但我之所以来这里，并不是为了找人帮忙。而是…有人找我帮忙。"
                },
                {
                    "id": "671730506",
                    "speaker": "Player",
                    "text": "欸？难道是奈芙尔…"
                },
                {
                    "id": "671730507",
                    "speaker": "艾梅莉埃",
                    "text": "是的。我是应奈芙尔老板的邀请，来参与一桩案件的调查。"
                },
                {
                    "id": "671730508",
                    "speaker": "艾梅莉埃",
                    "text": "具体来说，是一个富豪突然身死家中，案件现场的痕迹也被人破坏殆尽。"
                },
                {
                    "id": "671730509",
                    "speaker": "艾梅莉埃",
                    "text": "唯一的线索，是屋子的一股奇异香味。"
                },
                {
                    "id": "671730510",
                    "speaker": "艾梅莉埃",
                    "text": "呵，因为那位富豪的死牵涉了巨量财产，所以他的家人花大价钱请奈芙尔老板寻找专业人士调查。"
                },
                {
                    "id": "671730511",
                    "speaker": "艾梅莉埃",
                    "text": "而神通广大的奈芙尔老板，则很快凑出了一支看起来还不错的队伍。"
                },
                {
                    "id": "671730512",
                    "speaker": "艾梅莉埃",
                    "text": "这支队伍里有一个力大无穷的枫丹拳手，一个聪明的须弥学者，一个精明的璃月商人，一个专业的稻妻侦探…"
                },
                {
                    "id": "671730513",
                    "speaker": "Player",
                    "text": "你也是其中一员？"
                },
                {
                    "id": "671730514",
                    "speaker": "艾梅莉埃",
                    "text": "没错。我则是「气味分析专家」。"
                },
                {
                    "id": "671730515",
                    "speaker": "艾梅莉埃",
                    "text": "不过，反正我正好打算来挪德卡莱寻找新的香精原料，参与这桩调查，也算是顺手为之。"
                },
                {
                    "id": "671730516",
                    "speaker": "艾梅莉埃",
                    "text": "#{NICKNAME}，请你帮我记一下吧。就说…"
                },
                {
                    "id": "671730517",
                    "speaker": "艾梅莉埃",
                    "text": "「艾梅莉埃已抵达挪德卡莱，静候调查开始。」"
                },
                {
                    "id": "671730518",
                    "speaker": "Player",
                    "text": "赶紧记一下…"
                },
                {
                    "id": "671730519",
                    "speaker": "艾梅莉埃",
                    "text": "多谢了。虽然还想与你闲谈两句，但…我还要回去整理工具。"
                },
                {
                    "id": "671730520",
                    "speaker": "艾梅莉埃",
                    "text": "如果有空的话，我们坐下来喝杯茶吧，我倒是有几个有趣的故事与你分享。"
                }
            ]
        },
        {
            "talkId": "6717306",
            "initDialog": "671730601",
            "dialogues": [
                {
                    "id": "671730601",
                    "speaker": "Black Screen",
                    "text": "今日并无太多客人来访，看起来，似乎已经可以下班了…"
                }
            ]
        },
        {
            "talkId": "6717307",
            "initDialog": "671730701",
            "dialogues": [
                {
                    "id": "671730701",
                    "speaker": "派蒙",
                    "text": "欸…怎么雅珂达又要我们帮忙代班啊，又是一整张纸的拜托…",
                    "choices": [
                        {
                            "id": "671730702",
                            "text": "她眼睛真够好的。",
                            "response": [
                                {
                                    "id": "671730704",
                                    "speaker": "派蒙",
                                    "text": "那我们去柜台后面吧，希望不要遇见麻烦事…"
                                }
                            ]
                        },
                        {
                            "id": "671730703",
                            "text": "那就帮帮她吧…"
                        }
                    ]
                }
            ]
        }
    ]
}