{
    "groupId": "6430",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "帕卡林": 14
    },
    "talks": [
        {
            "talkId": "6643002",
            "initDialog": "664300201",
            "dialogues": [
                {
                    "id": "664300201",
                    "speaker": "帕卡林",
                    "text": "…背好痛，我真是犯傻，干嘛给自己找麻烦。"
                },
                {
                    "id": "664300202",
                    "speaker": "帕卡林",
                    "text": "好心人，又碰上你了，要在我的农场里坐坐吗？"
                }
            ]
        },
        {
            "talkId": "6643003",
            "initDialog": "664300301",
            "dialogues": [
                {
                    "id": "664300301",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "664300302",
                    "speaker": "帕卡林",
                    "text": "背还没好利索…唉，我干嘛闲着没事去和部族里的勇士角力，我当时脑子里在想什么？"
                },
                {
                    "id": "664300303",
                    "speaker": "帕卡林",
                    "text": "怎么说呢，这件事告诉我们一个教训：不要在和兄弟角力的时候挠他咯吱窝。"
                }
            ]
        },
        {
            "talkId": "6643004",
            "initDialog": "664300401",
            "dialogues": [
                {
                    "id": "664300401",
                    "speaker": "Player",
                    "text": "农场怎么样了？"
                },
                {
                    "id": "664300402",
                    "speaker": "帕卡林",
                    "text": "大多数作物长得还行，这个阶段也不需要我天天翻地了，只要留心来偷菜的鼬鼠就好。"
                },
                {
                    "id": "664300403",
                    "speaker": "帕卡林",
                    "text": "虽然我因为背太痛，没法努力了，但我的小突角龙们还可以努力，全靠它们啦。"
                },
                {
                    "id": "664300404",
                    "speaker": "帕卡林",
                    "text": "等我的背不痛了，就去帮爸爸开垦新田。"
                },
                {
                    "id": "664300405",
                    "speaker": "帕卡林",
                    "text": "唉，这老头子太倔，这么大年纪了还不肯承认自己老了，拿他没办法。"
                }
            ]
        },
        {
            "talkId": "6643005",
            "initDialog": "664300501",
            "dialogues": [
                {
                    "id": "664300501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "664300502",
                    "speaker": "帕卡林",
                    "text": "再见，好心人。"
                }
            ]
        },
        {
            "talkId": "6643006",
            "initDialog": "664300601",
            "dialogues": [
                {
                    "id": "664300601",
                    "speaker": "Player",
                    "text": "为什么会干这种事？"
                },
                {
                    "id": "664300602",
                    "speaker": "帕卡林",
                    "text": "我力气没他大嘛。既然都去角力了，谁不想争个胜负，我又没他厉害，只好想点馊主意。"
                },
                {
                    "id": "664300603",
                    "speaker": "帕卡林",
                    "text": "那会儿在场上，我看他快赢了，有点急。"
                },
                {
                    "id": "664300604",
                    "speaker": "帕卡林",
                    "text": "我现在回过头来，也很难理解自己为什么要这么干，可能觉得好玩吧。"
                },
                {
                    "id": "664300605",
                    "speaker": "帕卡林",
                    "text": "总之我挠了一下他的咯吱窝，结果兄弟一个激灵，就把我摔出去了。"
                },
                {
                    "id": "664300606",
                    "speaker": "帕卡林",
                    "text": "…啊，我的背好疼…"
                }
            ]
        }
    ]
}