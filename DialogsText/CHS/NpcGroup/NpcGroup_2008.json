{
    "groupId": "2008",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 2,
        "强叔": 6,
        "阿伟": 12
    },
    "talks": [
        {
            "talkId": "6200801",
            "initDialog": "620080101",
            "dialogues": [
                {
                    "id": "620080101",
                    "speaker": "阿伟",
                    "text": "强叔，我想买一件防身兵器以备远行，您看看我适合什么样的武器？"
                },
                {
                    "id": "620080102",
                    "speaker": "强叔",
                    "text": "你呀…哼…步伐虚浮，下盘不稳，气虚腰弱，丹田无力，动不能攻，静不能守…"
                },
                {
                    "id": "620080103",
                    "speaker": "强叔",
                    "text": "我劝你还是别买武器了…真遇上了贼人，怕是辱没我店家牌匾。"
                },
                {
                    "id": "620080104",
                    "speaker": "阿伟",
                    "text": "…"
                },
                {
                    "id": "620080105",
                    "speaker": "强叔",
                    "text": "唉，算了算了，好刀好剑卖给你也是浪费。我劝你还是买把好点的弩。"
                },
                {
                    "id": "620080106",
                    "speaker": "阿伟",
                    "text": "听您这么说…莫非我有射击天赋？"
                },
                {
                    "id": "620080107",
                    "speaker": "强叔",
                    "text": "得了吧，别太高看自己了。前些日子我那六岁的孙孙跟着我进山，就拿这弩猎了头不大不小的野猪回来。"
                },
                {
                    "id": "620080108",
                    "speaker": "强叔",
                    "text": "你虽血脉和天赋不如他，还看起来笨手笨脚的，可用它背后偷袭，总归十次能得手一次吧？"
                },
                {
                    "id": "620080109",
                    "speaker": "阿伟",
                    "text": "…您这话也说得太伤人了吧？"
                },
                {
                    "id": "620080110",
                    "speaker": "强叔",
                    "text": "嫌我说话不中听了？习武之人当自强，别净幻想着从别人嘴里找自信…"
                },
                {
                    "id": "620080111",
                    "speaker": "阿伟",
                    "text": "可我也不是习武之人啊，我说了我就是想买把兵器防个身…"
                }
            ]
        },
        {
            "talkId": "6200802",
            "initDialog": "620080201",
            "dialogues": [
                {
                    "id": "620080201",
                    "speaker": "阿伟",
                    "text": "你好，你也是戏迷吗？"
                }
            ]
        },
        {
            "talkId": "6200803",
            "initDialog": "620080301",
            "dialogues": [
                {
                    "id": "620080301",
                    "speaker": "Player",
                    "text": "关于听戏。"
                },
                {
                    "id": "620080302",
                    "speaker": "阿伟",
                    "text": "你是外地人吧？很多人到和裕茶馆就是冲着听戏来的，尤其是当家名角儿云堇的戏！"
                },
                {
                    "id": "620080303",
                    "speaker": "阿伟",
                    "text": "那身段，那步伐，实在是稳啊…句句自丹田而出，动静自如…"
                },
                {
                    "id": "620080304",
                    "speaker": "阿伟",
                    "text": "可惜我就要出远门了，一段时间内听不到戏咯，唉…"
                }
            ]
        },
        {
            "talkId": "6200804",
            "initDialog": "620080401",
            "dialogues": [
                {
                    "id": "620080401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620080402",
                    "speaker": "阿伟",
                    "text": "欸别走啊，听了一半儿就走，那不是拆台吗？"
                }
            ]
        },
        {
            "talkId": "7200801",
            "initDialog": "720080101",
            "dialogues": [
                {
                    "id": "720080101",
                    "speaker": "阿伟",
                    "text": "感觉如何，好玩吗？"
                },
                {
                    "id": "720080102",
                    "speaker": "阿伟",
                    "text": "外地人的话记得到会场的摊位区转转，体验璃月美食的好机会。"
                }
            ]
        }
    ]
}