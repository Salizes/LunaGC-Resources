{
    "groupId": "6035",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 2,
        "瓦图妲": 11,
        "辛佳": 5
    },
    "talks": [
        {
            "talkId": "6603501",
            "initDialog": "660350101",
            "dialogues": [
                {
                    "id": "660350101",
                    "speaker": "瓦图妲",
                    "text": "先、先暂停一下！这些运动量对我这个读书人来说有些多了…"
                },
                {
                    "id": "660350102",
                    "speaker": "辛佳",
                    "text": "真的吗，只比上次多了一点点哦？量总要慢慢加上去的。"
                },
                {
                    "id": "660350103",
                    "speaker": "辛佳",
                    "text": "等你身体的基础素质提升上去，教练我才能真正教你怎么摔跤。"
                },
                {
                    "id": "660350104",
                    "speaker": "辛佳",
                    "text": "你不期待自己能够大展拳脚的那天吗？"
                },
                {
                    "id": "660350105",
                    "speaker": "瓦图妲",
                    "text": "倒也不需要那么专业啦…我只是，想稍微、稍微锻炼锻炼身体…"
                },
                {
                    "id": "660350106",
                    "speaker": "辛佳",
                    "text": "这样啊…真可惜，你长得这么可爱，打起架来应该也很好看的。"
                },
                {
                    "id": "660350107",
                    "speaker": "瓦图妲",
                    "text": "欸？！怎么突然…这是什么推销手段吗？"
                },
                {
                    "id": "660350108",
                    "speaker": "辛佳",
                    "text": "嗯？不是哦，本来也没准备收你钱。反正我闲着也要自己锻炼的，多带一个人又不麻烦。"
                },
                {
                    "id": "660350109",
                    "speaker": "瓦图妲",
                    "text": "那…那我再试一试？"
                }
            ]
        },
        {
            "talkId": "6603502",
            "initDialog": "660350201",
            "dialogues": [
                {
                    "id": "660350201",
                    "speaker": "瓦图妲",
                    "text": "我…我做得到吗？"
                }
            ]
        },
        {
            "talkId": "6603503",
            "initDialog": "660350301",
            "dialogues": [
                {
                    "id": "660350301",
                    "speaker": "Player",
                    "text": "遇到麻烦了？"
                },
                {
                    "id": "660350302",
                    "speaker": "瓦图妲",
                    "text": "呼…呼…还、还好。我的健身教练之前给我留了每日锻炼的作业，我正在努力完成。"
                },
                {
                    "id": "660350303",
                    "speaker": "瓦图妲",
                    "text": "但实不相瞒，练了这么久，虽然体能确实变好了些，但连续爬楼梯还是有些力不从心…"
                },
                {
                    "id": "660350304",
                    "speaker": "瓦图妲",
                    "text": "之前深渊入侵时，她返回自己的部族帮忙去了，不知道什么时候才能回来。"
                },
                {
                    "id": "660350305",
                    "speaker": "瓦图妲",
                    "text": "也不好意思因为这点小事麻烦讯使，我的体力也还有所欠缺…"
                },
                {
                    "id": "660350306",
                    "speaker": "瓦图妲",
                    "text": "既然与她给我定下的目标还有距离，那我就先继续坚持下去吧。"
                }
            ]
        },
        {
            "talkId": "6603504",
            "initDialog": "660350401",
            "dialogues": [
                {
                    "id": "660350401",
                    "speaker": "Player",
                    "text": "加油。"
                },
                {
                    "id": "660350402",
                    "speaker": "瓦图妲",
                    "text": "欸？…好！"
                }
            ]
        }
    ]
}