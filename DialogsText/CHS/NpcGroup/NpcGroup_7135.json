{
    "groupId": "7135",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Player": 1,
        "「少女」": 18,
        "哥伦比娅": 20
    },
    "talks": [
        {
            "talkId": "6713501",
            "initDialog": "671350101",
            "dialogues": [
                {
                    "id": "671350101",
                    "speaker": "「少女」",
                    "text": "……"
                },
                {
                    "id": "671350102",
                    "speaker": "Player",
                    "text": "（她好像在休息，还是不要打扰她了吧…）"
                }
            ]
        },
        {
            "talkId": "6713502",
            "initDialog": "671350201",
            "dialogues": [
                {
                    "id": "671350201",
                    "speaker": "「少女」",
                    "text": "被吓到了？"
                }
            ]
        },
        {
            "talkId": "6713503",
            "initDialog": "671350301",
            "dialogues": [
                {
                    "id": "671350301",
                    "speaker": "「少女」",
                    "text": "阿蕾奇诺以前经常和我玩这个游戏，但我只赢过一次。"
                },
                {
                    "id": "671350302",
                    "speaker": "「少女」",
                    "text": "唔…有机会再找她试试。"
                }
            ]
        },
        {
            "talkId": "6713504",
            "initDialog": "671350401",
            "dialogues": [
                {
                    "id": "671350401",
                    "speaker": "「少女」",
                    "text": "试着感知月矩力，说不定下次能提前发现我。"
                }
            ]
        },
        {
            "talkId": "6713505",
            "initDialog": "671350501",
            "dialogues": [
                {
                    "id": "671350501",
                    "speaker": "「少女」",
                    "text": "嘘…"
                },
                {
                    "id": "671350502",
                    "speaker": "「少女」",
                    "text": "它们睡着了。"
                }
            ]
        },
        {
            "talkId": "6713506",
            "initDialog": "671350601",
            "dialogues": [
                {
                    "id": "671350601",
                    "speaker": "「少女」",
                    "text": "你好像很累的样子，是这里太高了？"
                },
                {
                    "id": "671350602",
                    "speaker": "「少女」",
                    "text": "唔…是不是搭个梯子比较好？"
                }
            ]
        },
        {
            "talkId": "6713507",
            "initDialog": "671350701",
            "dialogues": [
                {
                    "id": "671350701",
                    "speaker": "「少女」",
                    "text": "我喜欢高处。你说…如果在高高的月亮上看提瓦特，会是什么样？"
                }
            ]
        },
        {
            "talkId": "6713508",
            "initDialog": "671350801",
            "dialogues": [
                {
                    "id": "671350801",
                    "speaker": "「少女」",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6713509",
            "initDialog": "671350901",
            "dialogues": [
                {
                    "id": "671350901",
                    "speaker": "「少女」",
                    "text": "听完了就去睡觉，不然你们要吵醒那只巨鲸了。"
                },
                {
                    "id": "671350902",
                    "speaker": "「少女」",
                    "text": "月灵们都很活泼，哄它们睡觉有时很不容易。"
                }
            ]
        },
        {
            "talkId": "6713510",
            "initDialog": "671351001",
            "dialogues": [
                {
                    "id": "671351001",
                    "speaker": "「少女」",
                    "text": "你也要听故事吗？"
                },
                {
                    "id": "671351002",
                    "speaker": "「少女」",
                    "text": "小心别被虚假的月亮骗了。"
                }
            ]
        },
        {
            "talkId": "6713511",
            "initDialog": "671351101",
            "dialogues": [
                {
                    "id": "671351101",
                    "speaker": "「少女」",
                    "text": "经常有人给月灵一些东西，祈求好运。"
                },
                {
                    "id": "671351102",
                    "speaker": "「少女」",
                    "text": "我在告诉它们要懂得「回报」。"
                }
            ]
        },
        {
            "talkId": "6713512",
            "initDialog": "671351201",
            "dialogues": [
                {
                    "id": "671351201",
                    "speaker": "哥伦比娅",
                    "text": "…♪"
                },
                {
                    "id": "671351202",
                    "speaker": "哥伦比娅",
                    "text": "看来我学会一点了。"
                }
            ]
        },
        {
            "talkId": "6713513",
            "initDialog": "671351301",
            "dialogues": [
                {
                    "id": "671351301",
                    "speaker": "哥伦比娅",
                    "text": "…♪"
                },
                {
                    "id": "671351302",
                    "speaker": "哥伦比娅",
                    "text": "我该准备些别的曲谱…"
                }
            ]
        },
        {
            "talkId": "6713514",
            "initDialog": "671351401",
            "dialogues": [
                {
                    "id": "671351401",
                    "speaker": "哥伦比娅",
                    "text": "…♪"
                },
                {
                    "id": "671351402",
                    "speaker": "哥伦比娅",
                    "text": "你们也想一起合奏吗？"
                }
            ]
        },
        {
            "talkId": "6713515",
            "initDialog": "671351501",
            "dialogues": [
                {
                    "id": "671351501",
                    "speaker": "哥伦比娅",
                    "text": "「故事的主角小魔女，却抽到了地狱级难度的题目——找到并带回『不熄灭的火』。」"
                },
                {
                    "id": "671351502",
                    "speaker": "哥伦比娅",
                    "text": "唔…的确很困难啊。「不熄灭的火」到底会是什么呢？好在意…"
                }
            ]
        },
        {
            "talkId": "6713516",
            "initDialog": "671351601",
            "dialogues": [
                {
                    "id": "671351601",
                    "speaker": "哥伦比娅",
                    "text": "「…『我想成为魔女的使魔。』少女说。」"
                },
                {
                    "id": "671351602",
                    "speaker": "哥伦比娅",
                    "text": "呵呵…知道啦。如果是在故事里的世界，我一定会选你们当使魔的。"
                },
                {
                    "id": "671351603",
                    "speaker": "哥伦比娅",
                    "text": "那我继续读下去了哦？"
                }
            ]
        },
        {
            "talkId": "6713517",
            "initDialog": "671351701",
            "dialogues": [
                {
                    "id": "671351701",
                    "speaker": "哥伦比娅",
                    "text": "「它和标准魔王同纲同总目但属于不同大目。花栗鼠魔王看起来很凶暴。」"
                },
                {
                    "id": "671351702",
                    "speaker": "哥伦比娅",
                    "text": "唔，想象不出花栗鼠魔王的样子吗？"
                },
                {
                    "id": "671351703",
                    "speaker": "「少女」",
                    "text": "或许该请梅拉帮帮我们。"
                }
            ]
        },
        {
            "talkId": "6713518",
            "initDialog": "671351801",
            "dialogues": [
                {
                    "id": "671351801",
                    "speaker": "哥伦比娅",
                    "text": "「『我是你的魔法课老师，试炼时间已结束，你未能取得魔女资格。』」"
                },
                {
                    "id": "671351802",
                    "speaker": "哥伦比娅",
                    "text": "欸？没了？这一卷的内容好短啊。"
                }
            ]
        },
        {
            "talkId": "6713519",
            "initDialog": "671351901",
            "dialogues": [
                {
                    "id": "671351901",
                    "speaker": "哥伦比娅",
                    "text": "「总之，故事就到这里吧…」"
                },
                {
                    "id": "671351902",
                    "speaker": "哥伦比娅",
                    "text": "别难过，就像书里说的那样：「小魔女的冒险还会继续。」"
                },
                {
                    "id": "671351903",
                    "speaker": "哥伦比娅",
                    "text": "下次也来给你们读新的故事吧？"
                }
            ]
        },
        {
            "talkId": "6713520",
            "initDialog": "671352001",
            "dialogues": [
                {
                    "id": "671352001",
                    "speaker": "哥伦比娅",
                    "text": "尼可小姐送来的「绝版又绝密」的故事快念完了…今天给你们读什么呢？"
                }
            ]
        },
        {
            "talkId": "6713521",
            "initDialog": "671352101",
            "dialogues": [
                {
                    "id": "671352101",
                    "speaker": "哥伦比娅",
                    "text": "我喜欢高处，也喜欢和你并肩坐在高处的感觉，就像那时我们在月亮上一样。"
                }
            ]
        }
    ]
}