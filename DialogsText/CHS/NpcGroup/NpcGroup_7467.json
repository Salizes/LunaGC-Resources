{
    "groupId": "7467",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 5,
        "伊莉雅娜": 9
    },
    "talks": [
        {
            "talkId": "6746701",
            "initDialog": "674670101",
            "dialogues": [
                {
                    "id": "674670101",
                    "speaker": "伊莉雅娜",
                    "text": "请注意站台与列车之间的间距！请小心手中的物品…不要掉到站台与列车的缝隙中…"
                }
            ]
        },
        {
            "talkId": "6746702",
            "initDialog": "674670201",
            "dialogues": [
                {
                    "id": "674670201",
                    "speaker": "Player",
                    "text": "东西掉进去会怎么样？"
                },
                {
                    "id": "674670202",
                    "speaker": "伊莉雅娜",
                    "text": "那就麻烦了，最好的情况就是得在列车出发前拿出来…"
                }
            ]
        },
        {
            "talkId": "6746703",
            "initDialog": "674670301",
            "dialogues": [
                {
                    "id": "674670301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "674670302",
                    "speaker": "伊莉雅娜",
                    "text": "我是新晋的运输局安全员。工作的职责，就是保证每一趟列车都能够安全行驶。"
                },
                {
                    "id": "674670303",
                    "speaker": "伊莉雅娜",
                    "text": "不过我也才刚刚上任，还有好多要学的东西呢！"
                }
            ]
        },
        {
            "talkId": "6746704",
            "initDialog": "674670401",
            "dialogues": [
                {
                    "id": "674670401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674670402",
                    "speaker": "伊莉雅娜",
                    "text": "再见，要小心手上的物品哦！"
                }
            ]
        },
        {
            "talkId": "6746705",
            "initDialog": "674670501",
            "dialogues": [
                {
                    "id": "674670501",
                    "speaker": "Player",
                    "text": "如果拿不出来？"
                },
                {
                    "id": "674670502",
                    "speaker": "伊莉雅娜",
                    "text": "就得保佑列车驶出站台的过程中，掉下缝隙的物件没有损坏…如果损坏了客人就得自己承担损失。"
                },
                {
                    "id": "674670503",
                    "speaker": "伊莉雅娜",
                    "text": "没有损坏的话，运输局的人员会帮忙从轨道旁取出。"
                }
            ]
        },
        {
            "talkId": "6746706",
            "initDialog": "674670601",
            "dialogues": [
                {
                    "id": "674670601",
                    "speaker": "Player",
                    "text": "你们下去拿吗？"
                },
                {
                    "id": "674670602",
                    "speaker": "伊莉雅娜",
                    "text": "当然了，我们总不能让乘客自己下去吧。"
                },
                {
                    "id": "674670603",
                    "speaker": "伊莉雅娜",
                    "text": "保证乘客们能安全拿回自己掉落的物品，也是安全员的职责嘛。"
                }
            ]
        }
    ]
}