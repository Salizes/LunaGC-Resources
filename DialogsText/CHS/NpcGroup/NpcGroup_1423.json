            "dialogues": [
                {
                    "id": "614230501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6142306",
            "initDialog": "614230601",
            "dialogues": [
                {
                    "id": "614230601",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6142307",
            "initDialog": "614230701",
            "dialogues": [
                {
                    "id": "614230701",
                    "speaker": "布兰琪",
                    "text": "…我还得去接待其他顾客，失陪了。"
                }
            ]
        },
        {
            "talkId": "6142308",
            "initDialog": "614230801",
            "dialogues": [
                {
                    "id": "614230801",
                    "speaker": "布兰琪",
                    "text": "抱歉了客人，这一局我赢了。"
                }
            ]
        },
        {
            "talkId": "6142309",
            "initDialog": "614230901",
            "dialogues": [
                {
                    "id": "614230901",
                    "speaker": "布兰琪",
                    "text": "还真是滴水不漏…我算是见识到你的技术了。"
                }
            ]
        },
        {
            "talkId": "6142310",
            "initDialog": "614231001",
            "dialogues": [
                {
                    "id": "614231001",
                    "speaker": "布兰琪",
                    "text": "太大意了就会落败啊，客人。"
                }
            ]
        },
        {
            "talkId": "40165",
            "initDialog": "4015142351",
            "dialogues": [
                {
                    "id": "4015142351",
                    "speaker": "布兰琪",
                    "text": "您好~我们的货物~货真价实~童叟无欺~"
                }
            ]
        },
        {
            "talkId": "41704",
            "initDialog": "4015142302",
            "dialogues": [
                {
                    "id": "4015142302",
                    "speaker": "Player",
                    "text": "这里卖什么？"
                },
                {
                    "id": "4015142306",
                    "speaker": "布兰琪",
                    "text": "请您~慢慢挑选~"
                }
            ]
        },
        {
            "talkId": "41705",
            "initDialog": "4015142313",
            "dialogues": [
                {
                    "id": "4015142313",
                    "speaker": "Player",
                    "text": "想了解些事情。"
                },
                {
                    "id": "4015142314",
                    "speaker": "布兰琪",
                    "text": "请说~我在听着呢~",
                    "choices": [
                        {
                            "id": "4015142303",
                            "text": "关于蒙德百货。",
                            "response": [
                                {
                                    "id": "4015142307",
                                    "speaker": "布兰琪",
                                    "text": "虽然看起来店面不大，但是我们在璃月港建有储货仓库~"
                                },
                                {
                                    "id": "4015142308",
                                    "speaker": "布兰琪",
                                    "text": "商品的种类~数量~供货速度，都是蒙德城第一哟。"
                                }
                            ]
                        },
                        {
                            "id": "4015142304",
                            "text": "关于蒙德城的特色…",
                            "response": [
                                {
                                    "id": "4015142309",
                                    "speaker": "布兰琪",
                                    "text": "蒙德城是以酒闻名的城市~最著名的特色当然是酒馆~"
                                },
                                {
                                    "id": "4015142310",
                                    "speaker": "布兰琪",
                                    "text": "在蒙德城，大部分人每天都会去遍布城内的酒馆~小酌几杯~放松自己~"
                                },
                                {
                                    "id": "4015142311",
                                    "speaker": "布兰琪",
                                    "text": "所以在晚上的酒馆里~经常能看见许多人展现截然不同的姿态呢~"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "41706",
            "initDialog": "4015142305",
            "dialogues": [
                {
                    "id": "4015142305",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "4015142312",
                    "speaker": "布兰琪",
                    "text": "谢谢惠顾蒙德百货，诚挚等候您下次光临~"
                }
            ]
        },
        {
