{
    "groupId": "9027",
    "total_dialogue_lines": 59,
    "speaker_counts": {
        "Player": 18,
        "凝光": 41
    },
    "talks": [
        {
            "talkId": "6902701",
            "initDialog": "690270101",
            "dialogues": [
                {
                    "id": "690270101",
                    "speaker": "凝光",
                    "text": "#{NICKNAME}，你好。"
                },
                {
                    "id": "690270102",
                    "speaker": "凝光",
                    "text": "可有要事要与我商量？"
                }
            ]
        },
        {
            "talkId": "6902702",
            "initDialog": "690270201",
            "dialogues": [
                {
                    "id": "690270201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690270202",
                    "speaker": "凝光",
                    "text": "嗯，这里环境舒适，能让人静下心来思考问题。"
                },
                {
                    "id": "690270203",
                    "speaker": "凝光",
                    "text": "就像在群玉阁上的那些日子…",
                    "choices": [
                        {
                            "id": "690270204",
                            "text": "这里…恐怕比不上群玉阁吧。",
                            "response": [
                                {
                                    "id": "690270205",
                                    "speaker": "凝光",
                                    "text": "哦，你不要误会。"
                                },
                                {
                                    "id": "690270208",
                                    "speaker": "凝光",
                                    "text": "地方好坏不应简单以大小奢简来衡量。"
                                },
                                {
                                    "id": "690270209",
                                    "speaker": "凝光",
                                    "text": "我感受到的，是你在此投入的心意，这让我想起自己当初建造群玉阁时的样子。"
                                },
                                {
                                    "id": "690270210",
                                    "speaker": "凝光",
                                    "text": "换句话说，这里是属于你的「群玉阁」。"
                                }
                            ]
                        },
                        {
                            "id": "690270206",
                            "text": "过奖了。",
                            "response": [
                                {
                                    "id": "690270207",
                                    "speaker": "凝光",
                                    "text": "我并不是在恭维你。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902703",
            "initDialog": "690270301",
            "dialogues": [
                {
                    "id": "690270301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690270302",
                    "speaker": "凝光",
                    "text": "聊天？你的意思是，有什么商业问题想同我探讨吗？"
                },
                {
                    "id": "690270303",
                    "speaker": "Player",
                    "text": "不…只是简单的聊天而已。"
                },
                {
                    "id": "690270304",
                    "speaker": "凝光",
                    "text": "有意思…那些富商巨贾，都为请我吃一顿饭而挤破头皮。"
                },
                {
                    "id": "690270305",
                    "speaker": "凝光",
                    "text": "而你，却只是想和我「简单」聊几句？",
                    "choices": [
                        {
                            "id": "690270306",
                            "text": "我没有那么多钱…",
                            "response": [
                                {
                                    "id": "690270307",
                                    "speaker": "凝光",
                                    "text": "哈，说笑了。"
                                },
                                {
                                    "id": "690270310",
                                    "speaker": "凝光",
                                    "text": "知道吗？他们送我的东西极尽奢华…"
                                },
                                {
                                    "id": "690270311",
                                    "speaker": "凝光",
                                    "text": "但那只不过是期待从我的只言片语中嗅到商界的动向罢了。"
                                },
                                {
                                    "id": "690270312",
                                    "speaker": "凝光",
                                    "text": "正因如此，与你在此轻松闲聊的时光，对我来说才显得弥足珍贵。"
                                },
                                {
                                    "id": "690270313",
                                    "speaker": "凝光",
                                    "text": "这是再多摩拉都换不到的。"
                                },
                                {
                                    "id": "690270314",
                                    "speaker": "凝光",
                                    "text": "所以，再这样陪我一会儿吧，聊聊那些在你看来「简单」的话题。什么都好。"
                                }
                            ]
                        },
                        {
                            "id": "690270308",
                            "text": "我们聊凝光喜欢的话题就好。",
                            "response": [
                                {
                                    "id": "690270309",
                                    "speaker": "凝光",
                                    "text": "…你果然和别人不太一样。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902704",
            "initDialog": "690270401",
            "dialogues": [
                {
                    "id": "690270401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690270402",
                    "speaker": "凝光",
                    "text": "嗯…有一件事我计划很久了。"
                },
                {
                    "id": "690270403",
                    "speaker": "凝光",
                    "text": "下次有大事要决策的时候，我想请你一同前往。",
                    "choices": [
                        {
                            "id": "690270404",
                            "text": "是去整理资料吗？",
                            "response": [
                                {
                                    "id": "690270406",
                                    "speaker": "凝光",
                                    "text": "不，我是想…说不定可以让你参与到「决策」中来。",
                                    "choices": [
                                        {
                                            "id": "690270407",
                                            "text": "我能处理好吗…",
                                            "response": [
                                                {
                                                    "id": "690270408",
                                                    "speaker": "凝光",
                                                    "text": "放心吧，我是不会看错的。"
                                                },
                                                {
                                                    "id": "690270409",
                                                    "speaker": "凝光",
                                                    "text": "你在旅途中所积累的学识与魄力，将会使决策更加富有远见。"
                                                },
                                                {
                                                    "id": "690270415",
                                                    "speaker": "凝光",
                                                    "text": "嗯，我相信你。"
                                                },
                                                {
                                                    "id": "690270416",
                                                    "speaker": "凝光",
                                                    "text": "哦，对了。"
                                                },
                                                {
                                                    "id": "690270417",
                                                    "speaker": "凝光",
                                                    "text": "在做出决策之后，你就替我将那墙上的资料碾碎吧。"
                                                },
                                                {
                                                    "id": "690270418",
                                                    "speaker": "凝光",
                                                    "text": "这摇撼商界的「碎雪」，下次就由你来洒落。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690270410",
                                            "text": "交给我吧。",
                                            "response": [
                                                {
                                                    "id": "690270411",
                                                    "speaker": "凝光",
                                                    "text": "嗯，我喜欢你的魄力。"
                                                },
                                                {
                                                    "id": "690270412",
                                                    "speaker": "凝光",
                                                    "text": "商界如战场，决策时需要的就是这样的自信与果断。"
                                                },
                                                {
                                                    "id": "690270413",
                                                    "speaker": "凝光",
                                                    "text": "你在旅途中所积累的见识，也会使决策更加富有远见。"
                                                },
                                                {
                                                    "id": "690270414",
                                                    "speaker": "Player",
                                                    "text": "我一定尽我所能。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690270405",
                            "text": "是想让我学习决策的思路吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902705",
            "initDialog": "690270501",
            "dialogues": [
                {
                    "id": "690270501",
                    "speaker": "Player",
                    "text": "早啊，凝光。"
                },
                {
                    "id": "690270502",
                    "speaker": "凝光",
                    "text": "#早，{NICKNAME}。"
                },
                {
                    "id": "690270503",
                    "speaker": "凝光",
                    "text": "旅途中如遇为难之处，与我但说无妨。"
                }
            ]
        },
        {
            "talkId": "6902706",
            "initDialog": "690270601",
            "dialogues": [
                {
                    "id": "690270601",
                    "speaker": "Player",
                    "text": "晚安，凝光。"
                },
                {
                    "id": "690270602",
                    "speaker": "凝光",
                    "text": "#嗯，晚安，{NICKNAME}。"
                },
                {
                    "id": "690270603",
                    "speaker": "凝光",
                    "text": "无须顾虑太多。好好休息吧。"
                }
            ]
        },
        {
            "talkId": "6902707",
            "initDialog": "690270701",
            "dialogues": [
                {
                    "id": "690270701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6902708",
            "initDialog": "690270801",
            "dialogues": [
                {
                    "id": "690270801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6902709",
            "initDialog": "690270901",
            "dialogues": [
                {
                    "id": "690270901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6902750",
            "initDialog": "690275001",
            "dialogues": [
                {
                    "id": "690275001",
                    "speaker": "凝光",
                    "text": "我常年从群玉阁观察璃月，每座楼阁，每片砖瓦的脉络，都已刻入我的眼底。"
                },
                {
                    "id": "690275002",
                    "speaker": "凝光",
                    "text": "而这条街道，没有半分「不谐」之感，实属难得。"
                },
                {
                    "id": "690275003",
                    "speaker": "凝光",
                    "text": "你的才能总是带给人惊喜…"
                }
            ]
        },
        {
            "talkId": "6902751",
            "initDialog": "690275101",
            "dialogues": [
                {
                    "id": "690275101",
                    "speaker": "凝光",
                    "text": "书房不错。"
                },
                {
                    "id": "690275102",
                    "speaker": "凝光",
                    "text": "藏书还算罕见，那几本蒙德带来的物产志…或许能转化成商战中的情报优势。"
                },
                {
                    "id": "690275103",
                    "speaker": "凝光",
                    "text": "只是布置稍显简约…不妨考虑一下，添置几件像样的家具吧。"
                }
            ]
        }
    ]
}