{
    "groupId": "9589",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "茜特菈莉": 10
    },
    "talks": [
        {
            "talkId": "6958901",
            "initDialog": "695890101",
            "dialogues": [
                {
                    "id": "695890101",
                    "speaker": "茜特菈莉",
                    "text": "这里的酒味道不错啊！老板，蒲公英酒再来两杯！"
                }
            ]
        },
        {
            "talkId": "6958902",
            "initDialog": "695890201",
            "dialogues": [
                {
                    "id": "695890201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958903",
            "initDialog": "695890301",
            "dialogues": [
                {
                    "id": "695890301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695890302",
                    "speaker": "茜特菈莉",
                    "text": "来来来，一起喝点啊，我点了好多杯饮料，冰的常温的都有，随便拿！"
                }
            ]
        },
        {
            "talkId": "6958904",
            "initDialog": "695890401",
            "dialogues": [
                {
                    "id": "695890401",
                    "speaker": "茜特菈莉",
                    "text": "赢了赢了，轻轻松松嘛…平时我玩得多不多？我…那个…偶尔玩一玩，还有很多正事要做呢，不会有那么多空的！"
                }
            ]
        },
        {
            "talkId": "6958905",
            "initDialog": "695890501",
            "dialogues": [
                {
                    "id": "695890501",
                    "speaker": "茜特菈莉",
                    "text": "唉，什么「命定的一抽」、「决斗者的心意」、「和卡组的羁绊」。在现实里打牌，抽不到好牌就是抽不到啊…"
                }
            ]
        },
        {
            "talkId": "6958906",
            "initDialog": "695890601",
            "dialogues": [
                {
                    "id": "695890601",
                    "speaker": "茜特菈莉",
                    "text": "打牌？行啊！我平时…咳，稍微研究了一点，还看了好多遍《召唤王》呢。"
                }
            ]
        },
        {
            "talkId": "6958908",
            "initDialog": "695890801",
            "dialogues": [
                {
                    "id": "695890801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958909",
            "initDialog": "695890901",
            "dialogues": [
                {
                    "id": "695890901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958910",
            "initDialog": "695891001",
            "dialogues": [
                {
                    "id": "695891001",
                    "speaker": "茜特菈莉",
                    "text": "你练习得还是不太够啊…失误？哼，那我再陪你来一局，让你输得心服口服。"
                }
            ]
        },
        {
            "talkId": "6958911",
            "initDialog": "695891101",
            "dialogues": [
                {
                    "id": "695891101",
                    "speaker": "茜特菈莉",
                    "text": "所、所以说是稍微研究了一点，练得也没多深入…"
                }
            ]
        },
        {
            "talkId": "6958912",
            "initDialog": "695891201",
            "dialogues": [
                {
                    "id": "695891201",
                    "speaker": "茜特菈莉",
                    "text": "哼哼，那就来吧，小心点，可别被我两三下就拿下了。"
                }
            ]
        },
        {
            "talkId": "6958914",
            "initDialog": "695891401",
            "dialogues": [
                {
                    "id": "695891401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958915",
            "initDialog": "695891501",
            "dialogues": [
                {
                    "id": "695891501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958916",
            "initDialog": "695891601",
            "dialogues": [
                {
                    "id": "695891601",
                    "speaker": "茜特菈莉",
                    "text": "你瞧，不听老人言，吃亏在眼前啊…那个，我可没有要欺负你的意思啊！再来一局吧。"
                }
            ]
        },
        {
            "talkId": "6958917",
            "initDialog": "695891701",
            "dialogues": [
                {
                    "id": "695891701",
                    "speaker": "茜特菈莉",
                    "text": "咳…先让你几局，再来再来，这次我要认真了。"
                }
            ]
        },
        {
            "talkId": "6958918",
            "initDialog": "695891801",
            "dialogues": [
                {
                    "id": "695891801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}