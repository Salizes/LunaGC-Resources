    "talks": [
        {
            "talkId": "6407701",
            "initDialog": "640770101",
            "dialogues": [
                {
                    "id": "640770101",
                    "speaker": "妮维妲",
                    "text": "您好，是找我有事吗？"
                }
            ]
        },
        {
            "talkId": "6407702",
            "initDialog": "640770201",
            "dialogues": [
                {
                    "id": "640770201",
                    "speaker": "Player",
                    "text": "你在工作吗？"
                },
                {
                    "id": "640770202",
                    "speaker": "妮维妲",
                    "text": "没错，「健康之家」及其附近的区域便是我的管辖范围。"
                },
                {
                    "id": "640770203",
                    "speaker": "妮维妲",
                    "text": "请不用紧张，我主要的监督对象是医师与病人，以免在医疗过程中有不必要的知识「意外」传入民间。"
                },
                {
                    "id": "640770204",
                    "speaker": "妮维妲",
                    "text": "教令院通过虚空终端将知识合理分配给需要的人，而额外的知识传播容易引发其他的问题。"
                },
                {
                    "id": "640770205",
                    "speaker": "妮维妲",
                    "text": "所以如果您愿意配合我们教令官的工作，或者能主动上报异常情况，就再好不过了。"
                }
            ]
        },
        {
            "talkId": "6407703",
            "initDialog": "640770301",
            "dialogues": [
                {
                    "id": "640770301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "640770302",
                    "speaker": "妮维妲",
                    "text": "没关系。"
                }
            ]
        },
        {
            "talkId": "6407704",
            "initDialog": "640770401",
            "dialogues": [
                {
                    "id": "640770401",
                    "speaker": "Player",
                    "text": "你在工作吗？"
                },
                {
                    "id": "640770402",
                    "speaker": "妮维妲",
                    "text": "没错，「健康之家」及其附近的区域便是我的管辖范围。"
                },
                {
                    "id": "640770403",
                    "speaker": "妮维妲",
                    "text": "请不用紧张，虚空关闭之后，我已经不再干涉医生和患者之间的知识交流了。"
                },
                {
                    "id": "640770404",
                    "speaker": "妮维妲",
                    "text": "我现在需要关注的是医生与患者之间的沟通是否顺畅有效，以及医疗资源有没有合理分配。"
                },
                {
                    "id": "640770405",
                    "speaker": "妮维妲",
                    "text": "所以如果您愿意配合我们教令官的工作，或者能主动上报异常情况，就再好不过了。"
                }
            ]
        }
    ]
}