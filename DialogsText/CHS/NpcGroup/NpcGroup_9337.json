{
    "groupId": "9337",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "九条裟罗": 9
    },
    "talks": [
        {
            "talkId": "6933701",
            "initDialog": "693370101",
            "dialogues": [
                {
                    "id": "693370101",
                    "speaker": "九条裟罗",
                    "text": "战斗于我，往往意味着使命与责任，不容推卸。"
                },
                {
                    "id": "693370102",
                    "speaker": "九条裟罗",
                    "text": "但每当战事暂时平息，我也会珍惜偶得的闲暇，在训练中磨砺自我。"
                },
                {
                    "id": "693370103",
                    "speaker": "九条裟罗",
                    "text": "现在，我要以五组深呼吸进行名为「休整」的修行。"
                }
            ]
        },
        {
            "talkId": "6933702",
            "initDialog": "693370201",
            "dialogues": [
                {
                    "id": "693370201",
                    "speaker": "九条裟罗",
                    "text": "身为将领，绝不能动摇。必须时刻保持冷静，根据战场上形势的变化，适时调整方针，谨慎调遣。"
                },
                {
                    "id": "693370202",
                    "speaker": "九条裟罗",
                    "text": "只要出战者齐心协力，即便是再艰难的战局，也未尝不可取胜。"
                },
                {
                    "id": "693370203",
                    "speaker": "九条裟罗",
                    "text": "如今由你统筹全局，我的经验，供你参考。"
                }
            ]
        },
        {
            "talkId": "6933703",
            "initDialog": "693370301",
            "dialogues": [
                {
                    "id": "693370301",
                    "speaker": "九条裟罗",
                    "text": "这里的藏书，不知将军大人是否喜爱…"
                },
                {
                    "id": "693370302",
                    "speaker": "九条裟罗",
                    "text": "出门远行，理应带些礼物。如此一来，将军大人恐怕不会拒绝。我便先以个人的名义购买五本带回去…"
                },
                {
                    "id": "693370303",
                    "speaker": "九条裟罗",
                    "text": "但前提是，这里的管理者能够答应我买书的请求啊。"
                }
            ]
        }
    ]
}