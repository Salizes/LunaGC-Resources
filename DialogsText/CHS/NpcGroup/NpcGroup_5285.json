{
    "groupId": "5285",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "佩尔曼雅": 9
    },
    "talks": [
        {
            "talkId": "6528501",
            "initDialog": "652850101",
            "dialogues": [
                {
                    "id": "652850101",
                    "speaker": "佩尔曼雅",
                    "text": "客人…嗯，看来您已经知道了所有的秘密，也拿到宝藏了。"
                }
            ]
        },
        {
            "talkId": "6528502",
            "initDialog": "652850201",
            "dialogues": [
                {
                    "id": "652850201",
                    "speaker": "Player",
                    "text": "你…真的要去收拾这地方？"
                },
                {
                    "id": "652850202",
                    "speaker": "佩尔曼雅",
                    "text": "是的。这是掌舵人为我安排的工作，我不能拒绝。"
                },
                {
                    "id": "652850203",
                    "speaker": "佩尔曼雅",
                    "text": "这就是「锈舵」酒馆里的规矩。因为…我们都处于掌舵人的「庇护」下。"
                }
            ]
        },
        {
            "talkId": "6528503",
            "initDialog": "652850301",
            "dialogues": [
                {
                    "id": "652850301",
                    "speaker": "Player",
                    "text": "庇护？这里不是酒馆吗？"
                },
                {
                    "id": "652850302",
                    "speaker": "佩尔曼雅",
                    "text": "「掌舵人」这个称号，并不是一个夸张的形容词，而是一个…客观的形容词。"
                },
                {
                    "id": "652850303",
                    "speaker": "佩尔曼雅",
                    "text": "皮托先生，曾经执掌…并且改变过许多人的「人生」。"
                },
                {
                    "id": "652850304",
                    "speaker": "佩尔曼雅",
                    "text": "对于那些自愿钻入深海的人来说，皮托先生是他们唯一能够倚靠的「掌舵人」。"
                },
                {
                    "id": "652850305",
                    "speaker": "佩尔曼雅",
                    "text": "直到某一天，皮托先生松开了掌舵的手，离开了那片深海…他也是为数不多，能够从那里全身而退的人。"
                },
                {
                    "id": "652850306",
                    "speaker": "佩尔曼雅",
                    "text": "…我能告诉您的所有事，就到此为止了。"
                },
                {
                    "id": "652850307",
                    "speaker": "佩尔曼雅",
                    "text": "祝您在「锈舵」度过愉快的一天，客人。"
                }
            ]
        }
    ]
}