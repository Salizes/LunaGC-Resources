{
    "groupId": "7650",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "科菲策": 10
    },
    "talks": [
        {
            "talkId": "6765001",
            "initDialog": "676500101",
            "dialogues": [
                {
                    "id": "676500101",
                    "speaker": "科菲策",
                    "text": "莫要小看这些角菌，异邦人。正如你们的灯火能驱散黑夜，用这些角菌研磨出的颜料，同样能抵御黑灾的侵扰…"
                }
            ]
        },
        {
            "talkId": "6765002",
            "initDialog": "676500201",
            "dialogues": [
                {
                    "id": "676500201",
                    "speaker": "Player",
                    "text": "让我看看你在卖什么。"
                },
                {
                    "id": "676500202",
                    "speaker": "科菲策",
                    "text": "请便。尽管我并非货商，夜风仍曾低语过你的名。我等的「杜麦{RUBY#[S]希望}尼」，若是你愿以物易物，那便请上前来。"
                }
            ]
        },
        {
            "talkId": "6765003",
            "initDialog": "676500301",
            "dialogues": [
                {
                    "id": "676500301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "676500302",
                    "speaker": "科菲策",
                    "text": "我名为科菲策，米克{RUBY#[D]烟谜主}特兰的祷告者，受大灵指引，为指引涅法{RUBY#[D]挪德卡莱}海姆的异邦勇士而来。"
                },
                {
                    "id": "676500303",
                    "speaker": "科菲策",
                    "text": "然而，那名唤莱沃蒂的守卫却将我称作行商，命我只得在此「做生意」。"
                },
                {
                    "id": "676500304",
                    "speaker": "科菲策",
                    "text": "智慧的言语岂能说给愚昧的人听呢？无妨，夜风终将让他们知晓我所传授的秘谕…这也是过去来自大灵的启示。"
                }
            ]
        },
        {
            "talkId": "6765004",
            "initDialog": "676500401",
            "dialogues": [
                {
                    "id": "676500401",
                    "speaker": "Player",
                    "text": "关于你的商品…"
                },
                {
                    "id": "676500402",
                    "speaker": "科菲策",
                    "text": "这并非商品，我也并非货商，我等的「杜麦{RUBY#[S]希望}尼」。"
                },
                {
                    "id": "676500403",
                    "speaker": "科菲策",
                    "text": "这些角菌乃是米克{RUBY#[D]烟谜主}特兰传承千年的奇物。纺秘的女主人将研磨的技艺授予我等的列祖，如无数典仪那般。"
                },
                {
                    "id": "676500404",
                    "speaker": "科菲策",
                    "text": "只需依循特定的步骤研磨，这些草药的微光便足以拟造出接近燃素的涂鸦纹，抵御如潮的漆黑。"
                },
                {
                    "id": "676500405",
                    "speaker": "科菲策",
                    "text": "涅法{RUBY#[D]挪德卡莱}海姆人用提灯驱散黑夜，我们用微光抵御黑潮，两者没有区别。"
                }
            ]
        },
        {
            "talkId": "6765005",
            "initDialog": "676500501",
            "dialogues": [
                {
                    "id": "676500501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "676500502",
                    "speaker": "科菲策",
                    "text": "夜风会指引我们再度相见，我等的「杜麦{RUBY#[S]希望}尼」。"
                }
            ]
        }
    ]
}