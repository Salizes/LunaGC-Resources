{
    "groupId": "6101",
    "total_dialogue_lines": 29,
    "speaker_counts": {
        "Player": 5,
        "米齐卡": 24
    },
    "talks": [
        {
            "talkId": "5900218",
            "initDialog": "590021801",
            "dialogues": [
                {
                    "id": "590021801",
                    "speaker": "米齐卡",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900219",
            "initDialog": "590021901",
            "dialogues": [
                {
                    "id": "590021901",
                    "speaker": "米齐卡",
                    "text": "什么，有包裹爆炸了吗？！"
                },
                {
                    "id": "590021902",
                    "speaker": "米齐卡",
                    "text": "…哦，不是啊。太好了…不，我是说，抱歉，是我太敏感了…"
                }
            ]
        },
        {
            "talkId": "6610101",
            "initDialog": "661010101",
            "dialogues": [
                {
                    "id": "661010101",
                    "speaker": "米齐卡",
                    "text": "从包裹里收来的违禁品，都够我开家小卖部了。"
                }
            ]
        },
        {
            "talkId": "6610102",
            "initDialog": "661010201",
            "dialogues": [
                {
                    "id": "661010201",
                    "speaker": "Player",
                    "text": "要换工作了吗？"
                },
                {
                    "id": "661010202",
                    "speaker": "米齐卡",
                    "text": "什么？开小卖部？"
                },
                {
                    "id": "661010203",
                    "speaker": "米齐卡",
                    "text": "没有，我不是那个意思，只是打个比方。"
                },
                {
                    "id": "661010204",
                    "speaker": "米齐卡",
                    "text": "在这里工作久了，真是什么东西都能见到。"
                },
                {
                    "id": "661010205",
                    "speaker": "米齐卡",
                    "text": "一个没注意，包裹里的不知道什么东西碎掉了。"
                },
                {
                    "id": "661010206",
                    "speaker": "米齐卡",
                    "text": "再一个没注意，收件地址也不见了——竟然是用温变墨水写的！"
                },
                {
                    "id": "661010207",
                    "speaker": "米齐卡",
                    "text": "…唉，算了，多说无益，以后有的是惊喜。"
                },
                {
                    "id": "661010208",
                    "speaker": "米齐卡",
                    "text": "抱歉让你听我发牢骚了，希望没耽搁你的时间。"
                }
            ]
        },
        {
            "talkId": "6610103",
            "initDialog": "661010301",
            "dialogues": [
                {
                    "id": "661010301",
                    "speaker": "Player",
                    "text": "可以卖给我吗？"
                },
                {
                    "id": "661010302",
                    "speaker": "米齐卡",
                    "text": "什么？违禁品吗？"
                },
                {
                    "id": "661010303",
                    "speaker": "米齐卡",
                    "text": "你这小家伙，想些什么呢！"
                },
                {
                    "id": "661010304",
                    "speaker": "米齐卡",
                    "text": "咳，刚刚那是玩笑话，我不可能真的把危险品拿去卖啦。"
                },
                {
                    "id": "661010305",
                    "speaker": "米齐卡",
                    "text": "你就当没听到，好吗？算我谢谢你。"
                }
            ]
        },
        {
            "talkId": "6610104",
            "initDialog": "661010401",
            "dialogues": [
                {
                    "id": "661010401",
                    "speaker": "Player",
                    "text": "安全第一。"
                },
                {
                    "id": "661010402",
                    "speaker": "米齐卡",
                    "text": "说得对。"
                }
            ]
        },
        {
            "talkId": "6610105",
            "initDialog": "661010501",
            "dialogues": [
                {
                    "id": "661010501",
                    "speaker": "Player",
                    "text": "最近还好吗？"
                },
                {
                    "id": "661010502",
                    "speaker": "米齐卡",
                    "text": "一般般，主要问题是人手不够。"
                },
                {
                    "id": "661010503",
                    "speaker": "米齐卡",
                    "text": "之前的大战影响范围太大，传递战报的讯使们累倒了不少，还有很多现在也依然忙着在各个营地之间奔走。"
                },
                {
                    "id": "661010504",
                    "speaker": "米齐卡",
                    "text": "我们会优先派送与深渊和重建情报有关的信息，可能会影响到其他包裹的传递效率，提前说声抱歉啦。"
                }
            ]
        },
        {
            "talkId": "6610106",
            "initDialog": "661010601",
            "dialogues": [
                {
                    "id": "661010601",
                    "speaker": "米齐卡",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6610107",
            "initDialog": "661010701",
            "dialogues": [
                {
                    "id": "661010701",
                    "speaker": "米齐卡",
                    "text": "感谢你，我的烦恼和牢骚消失了。"
                }
            ]
        },
        {
            "talkId": "6610108",
            "initDialog": "661010801",
            "dialogues": [
                {
                    "id": "661010801",
                    "speaker": "米齐卡",
                    "text": "唉，真难啊，我还是继续去检查包裹吧…"
                }
            ]
        },
        {
            "talkId": "7592401",
            "initDialog": "759240101",
            "dialogues": [
                {
                    "id": "759240101",
                    "speaker": "Player",
                    "text": "好吧…那，可以卖给我吗？"
                },
                {
                    "id": "759240102",
                    "speaker": "米齐卡",
                    "text": "…不，不是让你重复一遍对话的意思。"
                },
                {
                    "id": "759240103",
                    "speaker": "米齐卡",
                    "text": "不开玩笑了，就当我的牢骚已经被圣火燃尽，带着我的烦恼一起消失吧！"
                }
            ]
        }
    ]
}