{
    "groupId": "3100",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "平野": 11
    },
    "talks": [
        {
            "talkId": "6310001",
            "initDialog": "631000101",
            "dialogues": [
                {
                    "id": "631000101",
                    "speaker": "平野",
                    "text": "你好，有什么需要帮忙的吗？"
                }
            ]
        },
        {
            "talkId": "6310002",
            "initDialog": "631000201",
            "dialogues": [
                {
                    "id": "631000201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "631000202",
                    "speaker": "平野",
                    "text": "这里是社奉行神里家的府邸，同时也是奉行大人处理事务的地方，一般不会有闲杂人等出没。"
                },
                {
                    "id": "631000203",
                    "speaker": "平野",
                    "text": "不过我记得阁下好像是神里大小姐的客人来着…那请便吧。"
                }
            ]
        },
        {
            "talkId": "6310003",
            "initDialog": "631000301",
            "dialogues": [
                {
                    "id": "631000301",
                    "speaker": "Player",
                    "text": "这么宽松吗…"
                },
                {
                    "id": "631000302",
                    "speaker": "平野",
                    "text": "啊，这…咳咳，阁下说得对，我身为神里家府邸的护卫，的确不该如此放松警惕。"
                },
                {
                    "id": "631000303",
                    "speaker": "平野",
                    "text": "我有个在天领奉行当差的朋友，曾说自己经常提心吊胆，很怕会被受「眼狩令」影响的那些人报复。"
                },
                {
                    "id": "631000304",
                    "speaker": "平野",
                    "text": "这么一想，与树敌颇多的其他两家不同，在与世无争的神里家当差可是安全多了。"
                },
                {
                    "id": "631000305",
                    "speaker": "平野",
                    "text": "而且可能是因为托马先生实在太靠谱了，我从内心深处一直感觉十分安逸，哈哈哈…"
                }
            ]
        },
        {
            "talkId": "6310004",
            "initDialog": "631000401",
            "dialogues": [
                {
                    "id": "631000401",
                    "speaker": "Player",
                    "text": "关于托马…"
                },
                {
                    "id": "631000402",
                    "speaker": "平野",
                    "text": "听说，托马先生来到神里家之后，因为外国人的身份饱受怀疑。"
                },
                {
                    "id": "631000403",
                    "speaker": "平野",
                    "text": "但就我的观察，托马先生办事稳妥，待人友善，是非常可靠的人呢。"
                },
                {
                    "id": "631000404",
                    "speaker": "平野",
                    "text": "毕竟是奉行大人和神里小姐信赖的助手嘛，哈哈！"
                }
            ]
        },
        {
            "talkId": "6310005",
            "initDialog": "631000501",
            "dialogues": [
                {
                    "id": "631000501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631000502",
                    "speaker": "平野",
                    "text": "常道恢弘，鸣神永恒。"
                }
            ]
        }
    ]
}