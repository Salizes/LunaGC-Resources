{
    "groupId": "4467",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "阿迪尔": 15
    },
    "talks": [
        {
            "talkId": "6446701",
            "initDialog": "644670101",
            "dialogues": [
                {
                    "id": "644670101",
                    "speaker": "阿迪尔",
                    "text": "年轻人的模样，就像这些船帆，不管方向是哪，先把劲鼓满了再说…"
                }
            ]
        },
        {
            "talkId": "6446702",
            "initDialog": "644670201",
            "dialogues": [
                {
                    "id": "644670201",
                    "speaker": "Player",
                    "text": "你在看海吗？"
                },
                {
                    "id": "644670202",
                    "speaker": "阿迪尔",
                    "text": "看海？不不。我可是从教令院来的执法者，大家都喊我阿迪尔大人。"
                },
                {
                    "id": "644670203",
                    "speaker": "阿迪尔",
                    "text": "简单来说，港务官负责监察港口的动向，我负责监察港务官。"
                },
                {
                    "id": "644670204",
                    "speaker": "阿迪尔",
                    "text": "你可以理解成，我是他们的上级，就是这样。"
                }
            ]
        },
        {
            "talkId": "6446703",
            "initDialog": "644670301",
            "dialogues": [
                {
                    "id": "644670301",
                    "speaker": "Player",
                    "text": "出海的年轻人？"
                },
                {
                    "id": "644670302",
                    "speaker": "阿迪尔",
                    "text": "是啊！看他们的样子真是充满干劲。"
                },
                {
                    "id": "644670303",
                    "speaker": "阿迪尔",
                    "text": "我年轻的时候也以大海为家，跟着巡视船四处漂，连纳塔边境都去过…真想再出海看看哟！"
                }
            ]
        },
        {
            "talkId": "6446704",
            "initDialog": "644670401",
            "dialogues": [
                {
                    "id": "644670401",
                    "speaker": "Player",
                    "text": "我先走了。"
                },
                {
                    "id": "644670402",
                    "speaker": "阿迪尔",
                    "text": "看来能陪伴我的只有海浪和风声啊！"
                }
            ]
        },
        {
            "talkId": "6446705",
            "initDialog": "644670501",
            "dialogues": [
                {
                    "id": "644670501",
                    "speaker": "Player",
                    "text": "可你明明一直在看海…"
                },
                {
                    "id": "644670502",
                    "speaker": "阿迪尔",
                    "text": "咳咳，我是在监察出海的船只，看看港务官们有没有偷懒。"
                },
                {
                    "id": "644670503",
                    "speaker": "阿迪尔",
                    "text": "你可不要以为是我这个老家伙在这里无所事事啊！"
                }
            ]
        },
        {
            "talkId": "6446706",
            "initDialog": "644670601",
            "dialogues": [
                {
                    "id": "644670601",
                    "speaker": "Player",
                    "text": "你去过纳塔？"
                },
                {
                    "id": "644670602",
                    "speaker": "阿迪尔",
                    "text": "纳塔的年轻人和我们这里一样有活力…不，他们是另一种「有活力」。"
                },
                {
                    "id": "644670603",
                    "speaker": "阿迪尔",
                    "text": "简直就像…生来带着为战斗而铸造的灵魂。"
                },
                {
                    "id": "644670604",
                    "speaker": "阿迪尔",
                    "text": "别误解，他们倒也不是什么野蛮人啦！相反倒是很喜欢街头涂鸦、竞技这些时尚玩意…"
                },
                {
                    "id": "644670605",
                    "speaker": "阿迪尔",
                    "text": "是个色彩鲜明，矛盾又迷人的地方。"
                },
                {
                    "id": "644670606",
                    "speaker": "阿迪尔",
                    "text": "想一想，连我都要变年轻了，那位港口总务官却总借着「多休息」的名头让我赋闲。"
                },
                {
                    "id": "644670607",
                    "speaker": "阿迪尔",
                    "text": "咳咳…"
                }
            ]
        }
    ]
}