    "talks": [
        {
            "talkId": "6437401",
            "initDialog": "643740101",
            "dialogues": [
                {
                    "id": "643740101",
                    "speaker": "芝拉",
                    "text": "哎哟！我正想事情呢，你这一出现，吓我一跳。"
                },
                {
                    "id": "643740102",
                    "speaker": "芝拉",
                    "text": "完了，刚才想到哪了来着…"
                }
            ]
        },
        {
            "talkId": "6437402",
            "initDialog": "643740201",
            "dialogues": [
                {
                    "id": "643740201",
                    "speaker": "Player",
                    "text": "不是故意的…"
                },
                {
                    "id": "643740202",
                    "speaker": "芝拉",
                    "text": "没事，不是怪你的意思，请别放在心上。"
                },
                {
                    "id": "643740203",
                    "speaker": "芝拉",
                    "text": "还是怪我，最近记性越来越差了，不是忘了该送什么货进来，就是忘了该卖什么东西出去…"
                },
                {
                    "id": "643740204",
                    "speaker": "芝拉",
                    "text": "只能说幸好这里的主人家大业大，不在乎我手上的仨瓜俩枣。"
                },
                {
                    "id": "643740205",
                    "speaker": "芝拉",
                    "text": "哎不说了，我接着想事情吧。那么长一个单子，到底被我放哪去了呢…"
                }
            ]
        },
        {
            "talkId": "6437403",
            "initDialog": "643740301",
            "dialogues": [
                {
                    "id": "643740301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "643740302",
                    "speaker": "芝拉",
                    "text": "哎，再见，我再好好回忆回忆…"
                }
            ]
        }
    ]
}