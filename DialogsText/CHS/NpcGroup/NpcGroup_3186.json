{
    "groupId": "3186",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "阳介": 8
    },
    "talks": [
        {
            "talkId": "6318601",
            "initDialog": "631860101",
            "dialogues": [
                {
                    "id": "631860101",
                    "speaker": "阳介",
                    "text": "您好，请问有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6318602",
            "initDialog": "631860201",
            "dialogues": [
                {
                    "id": "631860201",
                    "speaker": "Player",
                    "text": "您就是阳介吗？"
                },
                {
                    "id": "631860202",
                    "speaker": "阳介",
                    "text": "您是…哦，您就是那位和泽维尔先生一起解决了「御影炉心」问题的旅行者吧。"
                },
                {
                    "id": "631860203",
                    "speaker": "阳介",
                    "text": "久仰大名，初次见面，我是阳介，目前正在负责「御影炉心」的维护工作。"
                },
                {
                    "id": "631860204",
                    "speaker": "阳介",
                    "text": "老实说，我除了工匠手艺外，对于那些文书工作实在是很不在行…"
                },
                {
                    "id": "631860205",
                    "speaker": "阳介",
                    "text": "但我会继续努力，尽量变得像范兵卫大人那样可靠的！"
                }
            ]
        },
        {
            "talkId": "6318603",
            "initDialog": "631860301",
            "dialogues": [
                {
                    "id": "631860301",
                    "speaker": "Player",
                    "text": "这倒是不必…"
                },
                {
                    "id": "631860302",
                    "speaker": "阳介",
                    "text": "咦？可是我听说，范兵卫大人很得大人们赏识，还被委以重任…"
                },
                {
                    "id": "631860303",
                    "speaker": "阳介",
                    "text": "不管怎样，我会努力工作的。再次感谢您为「御影炉心」所做的一切，旅行者！"
                }
            ]
        },
        {
            "talkId": "6318604",
            "initDialog": "631860401",
            "dialogues": [
                {
                    "id": "631860401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631860402",
                    "speaker": "阳介",
                    "text": "再见，请慢走。"
                }
            ]
        }
    ]
}