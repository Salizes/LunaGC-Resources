{
    "groupId": "1527",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 7,
        "埃泽": 28
    },
    "talks": [
        {
            "talkId": "2074301",
            "initDialog": "207430101",
            "dialogues": [
                {
                    "id": "207430101",
                    "speaker": "埃泽",
                    "text": "唉，这风暴真是烦人…"
                },
                {
                    "id": "207430102",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "207430103",
                    "speaker": "埃泽",
                    "text": "嗯？是旅行者啊，迪卢克老爷向我提起过您，他说您是位经验丰富的冒险家，身手也着实不凡…"
                },
                {
                    "id": "207430104",
                    "speaker": "埃泽",
                    "text": "咳…说远了，怎么，您今天是来我们「晨曦酒庄」选酒的吗？"
                },
                {
                    "id": "207430105",
                    "speaker": "埃泽",
                    "text": "抱歉，您来得实在不巧，因为之前的风暴，酒庄对外的三条路都不能走了。"
                },
                {
                    "id": "207430106",
                    "speaker": "埃泽",
                    "text": "虽然西风骑士团很快把暴风刮过去的障碍物给清除了，但是周围的怪物也不知道是发了什么疯，全都聚在了路上。"
                },
                {
                    "id": "207430107",
                    "speaker": "埃泽",
                    "text": "人是能从旁边绕着走，但是运货的车实在是走不了了，酒庄里的酒运不出去，订购的材料也运不进来，愁死人了…"
                },
                {
                    "id": "207430108",
                    "speaker": "埃泽",
                    "text": "对了…我对您的事迹有所耳闻，也知道您身手不凡，不然…"
                },
                {
                    "id": "207430109",
                    "speaker": "埃泽",
                    "text": "如果您愿意的话，能帮我去清理清理那三条路吗？"
                }
            ]
        },
        {
            "talkId": "2074302",
            "initDialog": "207430201",
            "dialogues": [
                {
                    "id": "207430201",
                    "speaker": "Player",
                    "text": "交给我吧。"
                },
                {
                    "id": "207430202",
                    "speaker": "埃泽",
                    "text": "太好了，谢谢您愿意帮忙，我把那三条商道要清理的地方标在您的地图上，就麻烦您了。"
                }
            ]
        },
        {
            "talkId": "2074304",
            "initDialog": "207430401",
            "dialogues": [
                {
                    "id": "207430401",
                    "speaker": "Player",
                    "text": "还有别的事…"
                },
                {
                    "id": "207430402",
                    "speaker": "埃泽",
                    "text": "是吗…那我只能自己想想办法了。"
                }
            ]
        },
        {
            "talkId": "6152701",
            "initDialog": "615270101",
            "dialogues": [
                {
                    "id": "615270101",
                    "speaker": "埃泽",
                    "text": "哦？贵客啊，敢问是来谈生意还是谈合作的呢？"
                }
            ]
        },
        {
            "talkId": "6152702",
            "initDialog": "615270201",
            "dialogues": [
                {
                    "id": "615270201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615270202",
                    "speaker": "埃泽",
                    "text": "我是埃泽，蒙抬爱，家主不在的时候一般由我主事。"
                },
                {
                    "id": "615270203",
                    "speaker": "埃泽",
                    "text": "迪卢克老爷他…一般不太关心酒庄的事。"
                },
                {
                    "id": "615270204",
                    "speaker": "埃泽",
                    "text": "所以，不论什么事宜直接与我商量就好。",
                    "choices": [
                        {
                            "id": "615270205",
                            "text": "关于身份。",
                            "response": [
                                {
                                    "id": "615270206",
                                    "speaker": "埃泽",
                                    "text": "哦？阁下还真是慧眼。"
                                },
                                {
                                    "id": "615270207",
                                    "speaker": "埃泽",
                                    "text": "「蒙德酒业行会执行主席」确实是我的另一个身份。"
                                },
                                {
                                    "id": "615270208",
                                    "speaker": "埃泽",
                                    "text": "不过这也不是在下故作谦虚，刻意要掩饰自己。"
                                },
                                {
                                    "id": "615270209",
                                    "speaker": "埃泽",
                                    "text": "而是以晨曦酒庄在蒙德酒业的地位…"
                                },
                                {
                                    "id": "615270210",
                                    "speaker": "埃泽",
                                    "text": "执掌酒庄的业务和执掌整个酒业行会也没有太大差别而已，呵呵。"
                                }
                            ]
                        },
                        {
                            "id": "615270211",
                            "text": "关于往事。",
                            "response": [
                                {
                                    "id": "615270212",
                                    "speaker": "埃泽",
                                    "text": "关于往事…倒是也可以跟您随便聊聊。"
                                },
                                {
                                    "id": "615270213",
                                    "speaker": "埃泽",
                                    "text": "您应该知道前老板克利普斯老爷吧，就是迪卢克老爷的父亲。"
                                },
                                {
                                    "id": "615270214",
                                    "speaker": "埃泽",
                                    "text": "对我来说…可能像是义父那样的存在吧。"
                                },
                                {
                                    "id": "615270215",
                                    "speaker": "埃泽",
                                    "text": "明明正是意气风发的年纪，却不幸被卷入了数年前的一场事故…"
                                },
                                {
                                    "id": "615270216",
                                    "speaker": "埃泽",
                                    "text": "迪卢克老爷消沉了很长一段时间，也正是那段时间开始，我习惯了打理酒庄的事务。"
                                },
                                {
                                    "id": "615270217",
                                    "speaker": "埃泽",
                                    "text": "比起一味悲伤，还不如为迪卢克老爷分担一些事情，这也是我唯一能做的。"
                                },
                                {
                                    "id": "615270218",
                                    "speaker": "埃泽",
                                    "text": "虽然有些自作主张，但我想这也是克利普斯老爷希望看到的吧。"
                                },
                                {
                                    "id": "615270219",
                                    "speaker": "埃泽",
                                    "text": "呵呵，真不好意思，聊起了些不是那么愉快的事。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6152703",
            "initDialog": "615270301",
            "dialogues": [
                {
                    "id": "615270301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615270302",
                    "speaker": "埃泽",
                    "text": "再见，我的贵宾，有空可以常来做客。"
                }
            ]
        }
    ]
}