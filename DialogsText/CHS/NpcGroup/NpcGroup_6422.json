{
    "groupId": "6422",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "萨米诺": 7
    },
    "talks": [
        {
            "talkId": "6642201",
            "initDialog": "664220101",
            "dialogues": [
                {
                    "id": "664220101",
                    "speaker": "萨米诺",
                    "text": "音乐是灵魂用以交流的语言。"
                },
                {
                    "id": "664220102",
                    "speaker": "萨米诺",
                    "text": "…嗯，即便交流不是很顺利，大灵也会同意我的观点的。"
                }
            ]
        },
        {
            "talkId": "6642202",
            "initDialog": "664220201",
            "dialogues": [
                {
                    "id": "664220201",
                    "speaker": "Player",
                    "text": "「语言」不通了吗？"
                },
                {
                    "id": "664220202",
                    "speaker": "萨米诺",
                    "text": "啊…嗯…把多种「语言」放在同一个情境中交流，确实需要费些功夫。"
                },
                {
                    "id": "664220203",
                    "speaker": "萨米诺",
                    "text": "毕竟乐器们也有不同的个性嘛。"
                },
                {
                    "id": "664220204",
                    "speaker": "萨米诺",
                    "text": "沉稳的、圆滑的、活泼的，还有那种格外喜欢抢戏的，想给它们找到一个可以和谐共处的舞台可不容易。"
                },
                {
                    "id": "664220205",
                    "speaker": "萨米诺",
                    "text": "我现在最感兴趣的，是名为「虹色巡回」的舞台。如果有机会可以和它的主办方们交流一番，一定能大有收获吧！"
                }
            ]
        },
        {
            "talkId": "6642203",
            "initDialog": "664220301",
            "dialogues": [
                {
                    "id": "664220301",
                    "speaker": "Player",
                    "text": "有机会帮你问问大灵。"
                },
                {
                    "id": "664220302",
                    "speaker": "萨米诺",
                    "text": "真的吗，朋友？别啊，这个是开玩笑的！"
                }
            ]
        }
    ]
}