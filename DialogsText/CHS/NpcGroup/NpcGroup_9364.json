{
    "groupId": "9364",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "卡维": 9
    },
    "talks": [
        {
            "talkId": "6936401",
            "initDialog": "693640101",
            "dialogues": [
                {
                    "id": "693640101",
                    "speaker": "卡维",
                    "text": "作为临时休息的场所，这里的室内设计很明显仔细考量过使用者的需求。"
                },
                {
                    "id": "693640102",
                    "speaker": "卡维",
                    "text": "不同功能区域迎合拥有不同兴趣偏好的来访者，色调与装饰的选择上也突出了「舒适感」的主题。"
                },
                {
                    "id": "693640103",
                    "speaker": "卡维",
                    "text": "想来杯热咖啡了。"
                }
            ]
        },
        {
            "talkId": "6936402",
            "initDialog": "693640201",
            "dialogues": [
                {
                    "id": "693640201",
                    "speaker": "卡维",
                    "text": "你还好吗？如果你已经感觉到疲惫，我会建议你稍微换换心情，尽量不要在头脑糟糕的时候做重要的决定。"
                },
                {
                    "id": "693640202",
                    "speaker": "卡维",
                    "text": "啊，别误会，我不是要劝你放弃。既然决定来这里闯闯，肯定希望探索到最后吧？"
                },
                {
                    "id": "693640203",
                    "speaker": "卡维",
                    "text": "这种规模的项目，挑战起来很考验耐力。我也会一起加油的。"
                }
            ]
        },
        {
            "talkId": "6936403",
            "initDialog": "693640301",
            "dialogues": [
                {
                    "id": "693640301",
                    "speaker": "卡维",
                    "text": "有种说法是，每一个故事都代表着写作者的一种理想。阅读故事，就是理解写作者。"
                },
                {
                    "id": "693640302",
                    "speaker": "卡维",
                    "text": "嗯？你说让我也写本自传？呃咳！！"
                },
                {
                    "id": "693640303",
                    "speaker": "卡维",
                    "text": "我的事写成书得是什么样…不合适吧，算了算了…"
                }
            ]
        }
    ]
}