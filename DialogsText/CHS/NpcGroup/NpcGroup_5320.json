{
    "groupId": "5320",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "艾伊丝": 11
    },
    "talks": [
        {
            "talkId": "6532001",
            "initDialog": "653200101",
            "dialogues": [
                {
                    "id": "653200101",
                    "speaker": "艾伊丝",
                    "text": "你好呀！我正在读航海日志呢，嗯，不愧是贝瑟船长，只是读日志就能够学习到很多。"
                },
                {
                    "id": "653200102",
                    "speaker": "艾伊丝",
                    "text": "虽然「斯彭西安号」已经…但是，能够通过这些记录触碰到她的过去，也让艾伊丝感到满足！"
                }
            ]
        },
        {
            "talkId": "6532002",
            "initDialog": "653200201",
            "dialogues": [
                {
                    "id": "653200201",
                    "speaker": "Player",
                    "text": "最近怎么样？"
                },
                {
                    "id": "653200202",
                    "speaker": "艾伊丝",
                    "text": "嗯，艾伊丝一直在整理贝瑟船长的航程图，虽然很辛苦，不过也很有趣！"
                },
                {
                    "id": "653200203",
                    "speaker": "艾伊丝",
                    "text": "以前在其他故事里读到的许多已经失落的港湾，也能通过贝瑟船长留下的记录和线索找到大概的位置。"
                },
                {
                    "id": "653200204",
                    "speaker": "艾伊丝",
                    "text": "不过，也有些暂时还不太明白的东西…"
                }
            ]
        },
        {
            "talkId": "6532003",
            "initDialog": "653200301",
            "dialogues": [
                {
                    "id": "653200301",
                    "speaker": "Player",
                    "text": "那就好…"
                },
                {
                    "id": "653200302",
                    "speaker": "艾伊丝",
                    "text": "嗯，说不定以后我也能有自己的船，就能像贝瑟船长那样，出发进行航海冒险。"
                }
            ]
        },
        {
            "talkId": "6532004",
            "initDialog": "653200401",
            "dialogues": [
                {
                    "id": "653200401",
                    "speaker": "Player",
                    "text": "不太明白的东西？"
                },
                {
                    "id": "653200402",
                    "speaker": "艾伊丝",
                    "text": "对，贝瑟船长的部分日志里，一直提到一处被称作「水仙十字院」的地方，而且还提到了「那里的孩子」…"
                },
                {
                    "id": "653200403",
                    "speaker": "艾伊丝",
                    "text": "艾伊丝觉得，那应该是个像学校一样，有很多孩子的地方。如果有更多的资料能够佐证这个猜想就好了。"
                }
            ]
        },
        {
            "talkId": "6532005",
            "initDialog": "653200501",
            "dialogues": [
                {
                    "id": "653200501",
                    "speaker": "Player",
                    "text": "希望修复顺利！"
                },
                {
                    "id": "653200502",
                    "speaker": "艾伊丝",
                    "text": "嗯！艾伊丝找「斯彭西安号」，找了她那么长的时间…"
                },
                {
                    "id": "653200503",
                    "speaker": "艾伊丝",
                    "text": "这些日志和航程图，是在你的帮助下好不容易才找到的！"
                },
                {
                    "id": "653200504",
                    "speaker": "艾伊丝",
                    "text": "虽然修复进度很缓慢，但我相信只要坚持下去，一定能够完成的。"
                }
            ]
        }
    ]
}