{
    "groupId": "5300",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "「敲钟人」": 10
    },
    "talks": [
        {
            "talkId": "6530001",
            "initDialog": "653000101",
            "dialogues": [
                {
                    "id": "653000101",
                    "speaker": "「敲钟人」",
                    "text": "你好，朋友…呃，我们之前有见过吗？"
                }
            ]
        },
        {
            "talkId": "6530002",
            "initDialog": "653000201",
            "dialogues": [
                {
                    "id": "653000201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "653000202",
                    "speaker": "「敲钟人」",
                    "text": "哦哦，忘了自我介绍。我是，是来佩特莉可镇取材的幻想小说作家。看你有点面熟，我还以为是来找我催稿的编辑呢。"
                }
            ]
        },
        {
            "talkId": "6530003",
            "initDialog": "653000301",
            "dialogues": [
                {
                    "id": "653000301",
                    "speaker": "Player",
                    "text": "或许在梦里见过？"
                },
                {
                    "id": "653000302",
                    "speaker": "「敲钟人」",
                    "text": "这说法倒是很有趣，看起来你也很有写作的天赋啊。"
                },
                {
                    "id": "653000303",
                    "speaker": "「敲钟人」",
                    "text": "不过我好像确实在梦里见到过长得和你很像的人，所以刚才才会觉得眼熟…"
                },
                {
                    "id": "653000304",
                    "speaker": "「敲钟人」",
                    "text": "#梦里那家伙可是个了不起的冒险家，我的新书就打算以{M#他}{F#她}为主角了！"
                }
            ]
        },
        {
            "talkId": "6530004",
            "initDialog": "653000401",
            "dialogues": [
                {
                    "id": "653000401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "653000402",
                    "speaker": "「敲钟人」",
                    "text": "再见，朋友。总感觉我们在哪里见过，或许我们以后还会再见的。"
                }
            ]
        },
        {
            "talkId": "6530005",
            "initDialog": "653000501",
            "dialogues": [
                {
                    "id": "653000501",
                    "speaker": "Player",
                    "text": "听起来写作不太顺利？"
                },
                {
                    "id": "653000502",
                    "speaker": "「敲钟人」",
                    "text": "本来确实是不太顺利啦，所以我才会躲到这个小镇上来，一般人可追不到这里。"
                },
                {
                    "id": "653000503",
                    "speaker": "「敲钟人」",
                    "text": "不过前两天我做了一个梦，那是个以辉煌的古代文明为舞台，像是宏大的歌剧一般的梦。"
                },
                {
                    "id": "653000504",
                    "speaker": "「敲钟人」",
                    "text": "所以我打算写一本关于年轻的冒险家追寻神秘的红宝石，最终发现了沉入水下的超古代文明的小说。"
                },
                {
                    "id": "653000505",
                    "speaker": "「敲钟人」",
                    "text": "哈哈，小说的名字就叫『红宝石之谜』好了。"
                }
            ]
        }
    ]
}