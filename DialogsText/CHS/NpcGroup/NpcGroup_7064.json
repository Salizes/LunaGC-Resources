{
    "groupId": "7064",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "涅米宁": 8
    },
    "talks": [
        {
            "talkId": "6706401",
            "initDialog": "670640101",
            "dialogues": [
                {
                    "id": "670640101",
                    "speaker": "涅米宁",
                    "text": "最近风声很紧，还是收敛一些比较好…"
                }
            ]
        },
        {
            "talkId": "6706402",
            "initDialog": "670640201",
            "dialogues": [
                {
                    "id": "670640201",
                    "speaker": "Player",
                    "text": "什么风声？"
                },
                {
                    "id": "670640202",
                    "speaker": "涅米宁",
                    "text": "你没听说吗？愚人众抓了不少闯进月矩力试验设计局的宝藏猎人…"
                },
                {
                    "id": "670640203",
                    "speaker": "涅米宁",
                    "text": "可恶！听说里面好东西不少，哪怕是零部件，随便顺一点儿就能卖上好价钱。"
                }
            ]
        },
        {
            "talkId": "6706403",
            "initDialog": "670640301",
            "dialogues": [
                {
                    "id": "670640301",
                    "speaker": "Player",
                    "text": "明白了。"
                },
                {
                    "id": "670640302",
                    "speaker": "涅米宁",
                    "text": "看来你也很有经验。这的确是个蹲点的好地方。不过，我劝你最好不要轻举妄动，毕竟是愚人众精英部队的驻地…"
                }
            ]
        },
        {
            "talkId": "6706404",
            "initDialog": "670640401",
            "dialogues": [
                {
                    "id": "670640401",
                    "speaker": "Player",
                    "text": "确实。"
                },
                {
                    "id": "670640402",
                    "speaker": "涅米宁",
                    "text": "你进去过？你是怎么进去的？我已经在这里盯了很久了，到现在都没有找到空隙。"
                },
                {
                    "id": "670640403",
                    "speaker": "涅米宁",
                    "text": "本来想找那个叫克鲁切的报个名然后趁机混进去的，但「旗舰」门口那个举牌子的家伙，似乎并不是空穴来风…还是谨慎些吧！"
                }
            ]
        },
        {
            "talkId": "6706405",
            "initDialog": "670640501",
            "dialogues": [
                {
                    "id": "670640501",
                    "speaker": "Player",
                    "text": "愚人众的东西嘛…"
                },
                {
                    "id": "670640502",
                    "speaker": "涅米宁",
                    "text": "没想到竟然会有连愚人众都不放在眼里的人…他们在看守的肯定是什么了不得的东西！否则哪会吸引那么多宝藏猎人往里闯…"
                },
                {
                    "id": "670640503",
                    "speaker": "涅米宁",
                    "text": "不过…像这样的好东西，也不是我涅米宁有本事弄到手的。思来想去，还是小命重要…"
                }
            ]
        }
    ]
}