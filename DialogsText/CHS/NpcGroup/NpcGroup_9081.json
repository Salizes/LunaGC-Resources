{
    "groupId": "9081",
    "total_dialogue_lines": 77,
    "speaker_counts": {
        "Player": 15,
        "卡维": 62
    },
    "talks": [
        {
            "talkId": "6908101",
            "initDialog": "690810101",
            "dialogues": [
                {
                    "id": "690810101",
                    "speaker": "卡维",
                    "text": "你好。"
                },
                {
                    "id": "690810102",
                    "speaker": "卡维",
                    "text": "唔？这地方…有点意思。"
                }
            ]
        },
        {
            "talkId": "6908102",
            "initDialog": "690810201",
            "dialogues": [
                {
                    "id": "690810201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690810202",
                    "speaker": "卡维",
                    "text": "哈哈，要是回答习惯反而有点奇怪吧？"
                },
                {
                    "id": "690810203",
                    "speaker": "卡维",
                    "text": "我是第一次见到能随心所欲布置的环境…你可能不知道这对我们这行意味着什么。"
                },
                {
                    "id": "690810204",
                    "speaker": "卡维",
                    "text": "真不可思议，居然有那么多自由空间可供设计，简直像是一本永远用不完的草稿本。"
                },
                {
                    "id": "690810205",
                    "speaker": "卡维",
                    "text": "与其说习不习惯，不如说，谢谢你邀请我来做客。"
                },
                {
                    "id": "690810206",
                    "speaker": "Player",
                    "text": "可以把这里当自己家，不用客气。"
                },
                {
                    "id": "690810207",
                    "speaker": "卡维",
                    "text": "这恐怕不太合适…"
                },
                {
                    "id": "690810208",
                    "speaker": "卡维",
                    "text": "说实话，一走进来我就感觉到某种东西在血液里燃烧。"
                },
                {
                    "id": "690810209",
                    "speaker": "卡维",
                    "text": "呃，应该说是乙方的本能？没办法，从事相关设计工作的都这样。"
                },
                {
                    "id": "690810210",
                    "speaker": "卡维",
                    "text": "看着你的这些草坪、房屋，脑子里全是结构啊立面之类的事，根本想不到别的。"
                },
                {
                    "id": "690810211",
                    "speaker": "卡维",
                    "text": "噢对，能看看你的花园和水池吗？或者喷泉？还有这里的设计思路，方便的话也跟我说一下吧！"
                },
                {
                    "id": "690810212",
                    "speaker": "卡维",
                    "text": "我想知道一下你是出于什么设计思路安排了这样的道路体系，还有这些房屋间距…",
                    "choices": [
                        {
                            "id": "690810213",
                            "text": "对不起，我随便放的。",
                            "response": [
                                {
                                    "id": "690810214",
                                    "speaker": "卡维",
                                    "text": "随便放的？随便…等等，为什么会随便放？这些不是建筑吗？"
                                },
                                {
                                    "id": "690810215",
                                    "speaker": "卡维",
                                    "text": "建筑…建筑不是该被随便放的东西吧…难道说环境太自由也会磨灭设计师的底线和原则？"
                                },
                                {
                                    "id": "690810216",
                                    "speaker": "卡维",
                                    "text": "仔细一看，间距诡异的摆设，还有许多不知为什么而存在的面…嗯…嗯…"
                                },
                                {
                                    "id": "690810217",
                                    "speaker": "卡维",
                                    "text": "唔…那、那…好吧，没关系，也是一种创意。"
                                }
                            ]
                        },
                        {
                            "id": "690810218",
                            "text": "是根据一直以来的旅行心得。",
                            "response": [
                                {
                                    "id": "690810219",
                                    "speaker": "卡维",
                                    "text": "原来是这样。把旅行中的见闻体会化用到设计里，非常好的思路。"
                                },
                                {
                                    "id": "690810220",
                                    "speaker": "卡维",
                                    "text": "你很有天赋。要不是做设计师太辛苦，我会推荐你去学学相关课程的。"
                                }
                            ]
                        },
                        {
                            "id": "690810221",
                            "text": "其实卡萨扎莱宫也就一般吧。",
                            "response": [
                                {
                                    "id": "690810222",
                                    "speaker": "卡维",
                                    "text": "你说什么？！"
                                },
                                {
                                    "id": "690810223",
                                    "speaker": "卡维",
                                    "text": "我…咳！咳…没关系，没关系，大家审美不一样…这种事勉强不来。没有一定美学基础无法理解我高深的设计。"
                                },
                                {
                                    "id": "690810224",
                                    "speaker": "卡维",
                                    "text": "哼！我不会生气的。哼。"
                                }
                            ]
                        },
                        {
                            "id": "690810225",
                            "text": "可是这里什么都没有啊。",
                            "response": [
                                {
                                    "id": "690810226",
                                    "speaker": "卡维",
                                    "text": "……"
                                },
                                {
                                    "id": "690810227",
                                    "speaker": "卡维",
                                    "text": "……"
                                },
                                {
                                    "id": "690810228",
                                    "speaker": "卡维",
                                    "text": "我都这么努力假装你认真装修过了，你就不知道装一装吗？"
                                },
                                {
                                    "id": "690810229",
                                    "speaker": "卡维",
                                    "text": "我是个建筑设计师！设计师啊！看到你一贫如洗一无所有的家园，非常…非常难过。"
                                },
                                {
                                    "id": "690810230",
                                    "speaker": "卡维",
                                    "text": "你能不能努力一下？别浪费了这么好的空间。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908103",
            "initDialog": "690810301",
            "dialogues": [
                {
                    "id": "690810301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690810302",
                    "speaker": "卡维",
                    "text": "好啊，聊些什么？"
                },
                {
                    "id": "690810303",
                    "speaker": "卡维",
                    "text": "话题…不要让我选比较好。以前有人说过我一旦挑起话题，很容易说到自己的专业上，没完没了。",
                    "choices": [
                        {
                            "id": "690810304",
                            "text": "聊聊你的生活吧。",
                            "response": [
                                {
                                    "id": "690810305",
                                    "speaker": "卡维",
                                    "text": "生活啊…好像有很多事可以讲，又不知从何说起…"
                                },
                                {
                                    "id": "690810306",
                                    "speaker": "卡维",
                                    "text": "不瞒你说…以前有段时间我过得很不好。破产导致了一些糟糕的事，而活在世上，没钱有时就无法拥有尊严。"
                                },
                                {
                                    "id": "690810307",
                                    "speaker": "卡维",
                                    "text": "我不喜欢那样，可也无法马上摆脱困境，每天都活在自尊和现实的挣扎中。"
                                },
                                {
                                    "id": "690810308",
                                    "speaker": "卡维",
                                    "text": "自以为是优秀设计师，就不愿意去做任何其他工作…后来才发现，很多事跟我想的完全不一样。"
                                },
                                {
                                    "id": "690810309",
                                    "speaker": "卡维",
                                    "text": "学生时代的我比现在更理想化。我不太愿意承认…但过分天真的人确实没有办法活下去。"
                                },
                                {
                                    "id": "690810310",
                                    "speaker": "卡维",
                                    "text": "啊，不好意思，这个话题太沉重了。当我没说过。"
                                }
                            ]
                        },
                        {
                            "id": "690810311",
                            "text": "聊聊你喜欢的东西吧。",
                            "response": [
                                {
                                    "id": "690810312",
                                    "speaker": "卡维",
                                    "text": "嗯，喜欢的东西…我最近买了一台磨咖啡豆的机器，那个很不错。"
                                },
                                {
                                    "id": "690810313",
                                    "speaker": "卡维",
                                    "text": "非常精巧！最重要的是每个零件都安排得恰到好处。"
                                },
                                {
                                    "id": "690810314",
                                    "speaker": "卡维",
                                    "text": "没有多余的小螺丝，机身上也没有任何无意义的配件。磨豆子的效率很高，声音也不响，我很满意。"
                                },
                                {
                                    "id": "690810315",
                                    "speaker": "卡维",
                                    "text": "啊，今天出门太急忘了拿…下次有机会的话，我带一些磨好的咖啡粉给你吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908104",
            "initDialog": "690810401",
            "dialogues": [
                {
                    "id": "690810401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690810402",
                    "speaker": "卡维",
                    "text": "想到最远的位置看看。你这只壶的功能太有趣了，我想知道特殊空间的边界大概会是什么样子。"
                },
                {
                    "id": "690810403",
                    "speaker": "卡维",
                    "text": "这种级别的技术绝不是随处可见的，要是有一天能复现在各种工程里该多好。"
                },
                {
                    "id": "690810404",
                    "speaker": "卡维",
                    "text": "须弥的建筑分为几大类，雨林地区大都采用木质结构，而石质建筑大多集中在须弥城和奥摩斯港。"
                },
                {
                    "id": "690810405",
                    "speaker": "卡维",
                    "text": "你应该去过奥摩斯港吧？那座灯塔就是典型代表，上一次翻修它的工程由我负责。"
                },
                {
                    "id": "690810406",
                    "speaker": "卡维",
                    "text": "石材老化可以重建，地面严重老化翻修难度就大得多…改建起来难免有上限。"
                },
                {
                    "id": "690810407",
                    "speaker": "卡维",
                    "text": "要是能有一个地面不会腐朽塌陷，视野又足够清晰的空间就好了，人们可以在那里实验改良灯塔的结构。"
                },
                {
                    "id": "690810408",
                    "speaker": "Player",
                    "text": "听起来你比我更需要尘歌壶。"
                },
                {
                    "id": "690810409",
                    "speaker": "卡维",
                    "text": "某种意义上，是的。"
                },
                {
                    "id": "690810410",
                    "speaker": "卡维",
                    "text": "不过我不会说什么有钱就能买下这个壶之类的话。这么伟大的东西，对你一定也很重要。"
                },
                {
                    "id": "690810411",
                    "speaker": "Player",
                    "text": "算是我的「家」吧。"
                },
                {
                    "id": "690810412",
                    "speaker": "卡维",
                    "text": "「家」啊…"
                },
                {
                    "id": "690810413",
                    "speaker": "卡维",
                    "text": "我经常为别人设计家园，但那些未必能算是真正的「家」。"
                },
                {
                    "id": "690810414",
                    "speaker": "卡维",
                    "text": "家园可以只是一个区块，「家」却必须为人而存在。人的存在决定了家的意义。"
                },
                {
                    "id": "690810415",
                    "speaker": "卡维",
                    "text": "听说你旅行是为了找回亲人。我不能完全体会那种心情，但思念家人的情感总是共通的。"
                },
                {
                    "id": "690810416",
                    "speaker": "卡维",
                    "text": "#祝你早日达成梦想，接回重要的亲人，和{M#她}{F#他}一起生活。"
                },
                {
                    "id": "690810417",
                    "speaker": "Player",
                    "text": "谢谢，届时能请你来做设计吗？"
                },
                {
                    "id": "690810418",
                    "speaker": "卡维",
                    "text": "哈哈哈，当然可以啦。真到那一天，你的快乐就足够感染我了。我不会收你设计费。"
                }
            ]
        },
        {
            "talkId": "6908105",
            "initDialog": "690810501",
            "dialogues": [
                {
                    "id": "690810501",
                    "speaker": "Player",
                    "text": "早啊，卡维。"
                },
                {
                    "id": "690810502",
                    "speaker": "卡维",
                    "text": "早上好。新的一天又有不少事。"
                },
                {
                    "id": "690810503",
                    "speaker": "卡维",
                    "text": "慢慢来吧，总会做完的。"
                }
            ]
        },
        {
            "talkId": "6908106",
            "initDialog": "690810601",
            "dialogues": [
                {
                    "id": "690810601",
                    "speaker": "Player",
                    "text": "晚安，卡维。"
                },
                {
                    "id": "690810602",
                    "speaker": "卡维",
                    "text": "忙碌一天，也该休息了。"
                },
                {
                    "id": "690810603",
                    "speaker": "卡维",
                    "text": "无论有什么烦恼，现在都尽情沉入睡眠吧，说不定明天一睁眼事情就会变得不一样。"
                }
            ]
        },
        {
            "talkId": "6908107",
            "initDialog": "690810701",
            "dialogues": [
                {
                    "id": "690810701",
                    "speaker": "卡维",
                    "text": "这种结构被广泛应用于须弥各处，你去教令院可以看到大量风格类似的建筑。"
                },
                {
                    "id": "690810702",
                    "speaker": "卡维",
                    "text": "如果要我选一种最值得推荐的须弥建筑风格，我会选这种。构成中的白色部分在整套设计里属于点睛之笔。"
                },
                {
                    "id": "690810703",
                    "speaker": "卡维",
                    "text": "非要说有什么美中不足的…可能是花型拱顶旁边多出来的部分特别容易积灰？应该会很不好打扫。"
                }
            ]
        },
        {
            "talkId": "6908108",
            "initDialog": "690810801",
            "dialogues": [
                {
                    "id": "690810801",
                    "speaker": "卡维",
                    "text": "剧场啊，真是个好地方。"
                },
                {
                    "id": "690810802",
                    "speaker": "卡维",
                    "text": "让人心情舒畅，倍感自由…"
                },
                {
                    "id": "690810803",
                    "speaker": "卡维",
                    "text": "我喜欢这个小喷泉。小是小了些，但很完整，周围的装饰也还不错。"
                }
            ]
        }
    ]
}