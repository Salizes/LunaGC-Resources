            "dialogues": [
                {
                    "id": "640590101",
                    "speaker": "法哈德",
                    "text": "等首次公演的时候，我一定第一个去买票。"
                }
            ]
        },
        {
            "talkId": "6405902",
            "initDialog": "640590201",
            "dialogues": [
                {
                    "id": "640590201",
                    "speaker": "Player",
                    "text": "什么公演？"
                },
                {
                    "id": "640590202",
                    "speaker": "法哈德",
                    "text": "就是谢赫祖拜尔先生正在创作的新话剧啊。"
                },
                {
                    "id": "640590203",
                    "speaker": "法哈德",
                    "text": "不出意外的话，一定会有妮露小姐参演的。"
                },
                {
                    "id": "640590204",
                    "speaker": "法哈德",
                    "text": "祖拜尔剧场的新戏从没让人失望过，每次一有新戏上演，不管研究什么的学者都要抢票抢破头哩。"
                },
                {
                    "id": "640590205",
                    "speaker": "法哈德",
                    "text": "你也一定要去看看。"
                }
            ]
        },
        {
            "talkId": "6405903",
            "initDialog": "640590301",
            "dialogues": [
                {
                    "id": "640590301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640590302",
                    "speaker": "法哈德",
                    "text": "再见啦。"
                }
            ]
        }
    ]
