    },
    "talks": [
        {
            "talkId": "6954901",
            "initDialog": "695490101",
            "dialogues": [
                {
                    "id": "695490101",
                    "speaker": "迪希雅",
                    "text": "这酒馆里的酒还挺好喝的，要不要带一点回去呢…"
                }
            ]
        },
        {
            "talkId": "6954902",
            "initDialog": "695490201",
            "dialogues": [
                {
                    "id": "695490201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954903",
            "initDialog": "695490301",
            "dialogues": [
                {
                    "id": "695490301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695490302",
                    "speaker": "迪希雅",
                    "text": "我等会也要回去了，团里还有很多事要处理。嗯…但在那之前，应该还有时间再打一把…"
                }
            ]
        },
        {
            "talkId": "6954904",
            "initDialog": "695490401",
            "dialogues": [
                {
                    "id": "695490401",
                    "speaker": "迪希雅",
                    "text": "哈哈哈，别灰心啊，我平时和团里的老佣兵打牌的时候，也是赢多输少，没几个人能赢我。"
                }
            ]
        },
        {
            "talkId": "6954905",
            "initDialog": "695490501",
            "dialogues": [
                {
                    "id": "695490501",
                    "speaker": "迪希雅",
                    "text": "今天我的牌运真是不济，难道是之前在团里打牌的时候赢太多钱了…"
                }
            ]
        },
        {
            "talkId": "6954906",
            "initDialog": "695490601",
            "dialogues": [
                {
                    "id": "695490601",
                    "speaker": "迪希雅",
                    "text": "行啊，让我看看你的牌技如何。"
                }
            ]
        },
        {
            "talkId": "6954908",
            "initDialog": "695490801",
            "dialogues": [
                {
                    "id": "695490801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954909",
            "initDialog": "695490901",
            "dialogues": [
                {
                    "id": "695490901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6954910",
            "initDialog": "695491001",
            "dialogues": [
                {
                    "id": "695491001",
                    "speaker": "迪希雅",
                    "text": "这局我赢得可真不轻松，你打牌的技术还不错啊，再练练，说不定就能赢我了。"
                }
            ]
        },
        {
            "talkId": "6954911",
            "initDialog": "695491101",
            "dialogues": [
                {
                    "id": "695491101",
                    "speaker": "迪希雅",
                    "text": "我认输了，没想到你的牌技比那些老佣兵都好，真是出乎预料。"
                }
            ]
        },
        {
            "talkId": "6954912",
            "initDialog": "695491201",
            "dialogues": [
                {
                    "id": "695491201",
                    "speaker": "迪希雅",
                    "text": "没问题，但我今天没带什么能做赌注的值钱货…咱们只能打场「便宜牌」了。"
                }
            ]
        },
        {
            "talkId": "6954914",
            "initDialog": "695491401",
            "dialogues": [
                {
                    "id": "695491401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954915",
            "initDialog": "695491501",
            "dialogues": [
                {
                    "id": "695491501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6954916",
            "initDialog": "695491601",
            "dialogues": [
                {
                    "id": "695491601",
                    "speaker": "迪希雅",
                    "text": "要什么牌就来什么牌，看来这局我运气不错啊。"
                }
            ]
        },
        {
            "talkId": "6954917",
            "initDialog": "695491701",
            "dialogues": [
                {
                    "id": "695491701",
                    "speaker": "迪希雅",
                    "text": "是你赢了。唉…真是的，我这一整局里就没抽到过想要的牌…"
                }
            ]
        },
        {
            "talkId": "6954918",
            "initDialog": "695491801",
            "dialogues": [
                {
                    "id": "695491801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}