{
    "groupId": "7591",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "蕾托娃": 9
    },
    "talks": [
        {
            "talkId": "6759101",
            "initDialog": "675910101",
            "dialogues": [
                {
                    "id": "675910101",
                    "speaker": "蕾托娃",
                    "text": "步伐错了！我再演示一遍！"
                }
            ]
        },
        {
            "talkId": "6759102",
            "initDialog": "675910201",
            "dialogues": [
                {
                    "id": "675910201",
                    "speaker": "Player",
                    "text": "练习情况怎么样？"
                },
                {
                    "id": "675910202",
                    "speaker": "蕾托娃",
                    "text": "#啊！你好，{NICKNAME}，我一直在练习，没有偷过懒的。"
                },
                {
                    "id": "675910203",
                    "speaker": "蕾托娃",
                    "text": "等奥黛塔姐姐下次过来检查的时候，我一定能跳得更好！"
                }
            ]
        },
        {
            "talkId": "6759103",
            "initDialog": "675910301",
            "dialogues": [
                {
                    "id": "675910301",
                    "speaker": "Player",
                    "text": "不打扰你练习啦。"
                },
                {
                    "id": "675910302",
                    "speaker": "蕾托娃",
                    "text": "嗯，等一下我也要继续开始指导大家跳舞了，呼…下一轮的步伐是…"
                }
            ]
        },
        {
            "talkId": "6759104",
            "initDialog": "675910401",
            "dialogues": [
                {
                    "id": "675910401",
                    "speaker": "Player",
                    "text": "也要劳逸结合啦…"
                },
                {
                    "id": "675910402",
                    "speaker": "蕾托娃",
                    "text": "我知道的，奥黛塔姐姐也说过了，过度练习会让身体疲劳，有可能导致后面的练习动作做不标准。"
                },
                {
                    "id": "675910403",
                    "speaker": "蕾托娃",
                    "text": "所以，刻苦的训练和充足的休息同等重要！还有合理的饮食和深度的睡眠！"
                },
                {
                    "id": "675910404",
                    "speaker": "蕾托娃",
                    "text": "奥黛塔姐姐还给我列了一份食谱，说这是她的健康食谱，按照这份食谱吃饭的话，既能吃好又能吃饱。"
                },
                {
                    "id": "675910405",
                    "speaker": "蕾托娃",
                    "text": "但…有些菜看起来，就和路边的草丛一样，真的能吃饱吗…"
                },
                {
                    "id": "675910406",
                    "speaker": "蕾托娃",
                    "text": "…我偷偷吃一点点小蛋糕，应该不会出问题吧…？"
                }
            ]
        }
    ]
}