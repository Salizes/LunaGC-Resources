{
    "groupId": "30946",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 2,
        "派蒙": 2,
        "砂糖": 8
    },
    "talks": [
        {
            "talkId": "4023161",
            "initDialog": "402316101",
            "dialogues": [
                {
                    "id": "402316101",
                    "speaker": "砂糖",
                    "text": "原来在这里啊，我找得好辛苦。"
                },
                {
                    "id": "402316102",
                    "speaker": "派蒙",
                    "text": "怎么了，砂糖？"
                },
                {
                    "id": "402316103",
                    "speaker": "砂糖",
                    "text": "是你们…哎，听我说，为了这个活动，我们需要找一些炼金术的设备。"
                },
                {
                    "id": "402316104",
                    "speaker": "砂糖",
                    "text": "阿贝多老师一向将成本控制得非常好，实验室的设备几乎都能派上用场，闲置下来的，往往都是老东西了。"
                },
                {
                    "id": "402316105",
                    "speaker": "砂糖",
                    "text": "比如这个，过去曾用过几次，但效率和运作方式都不太令人满意，后来很快就被淘汰掉了。",
                    "choices": [
                        {
                            "id": "402316106",
                            "text": "我好像有印象…",
                            "response": [
                                {
                                    "id": "402316108",
                                    "speaker": "砂糖",
                                    "text": "本来按照魔女的意思，是要放在蒙德城里的，结果在把它丢进魔法泡泡里面之后，它就不见了。"
                                },
                                {
                                    "id": "402316109",
                                    "speaker": "砂糖",
                                    "text": "幸好在这里找到了它…可是为什么在这里呢？"
                                },
                                {
                                    "id": "402316110",
                                    "speaker": "派蒙",
                                    "text": "没关系，既然找到了就是好事，等下我们告诉尼可，把它送回正确的地方吧。"
                                },
                                {
                                    "id": "402316111",
                                    "speaker": "砂糖",
                                    "text": "好的，太谢谢你们了！"
                                }
                            ]
                        },
                        {
                            "id": "402316107",
                            "text": "印象很模糊了…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4023178",
            "initDialog": "402317801",
            "dialogues": [
                {
                    "id": "402317801",
                    "speaker": "砂糖",
                    "text": "不管怎么样，总算是找到了，太好了。"
                }
            ]
        }
    ]
}