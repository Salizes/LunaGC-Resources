{
    "groupId": "4146",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "迪拉瓦尔": 6
    },
    "talks": [
        {
            "talkId": "6414601",
            "initDialog": "641460101",
            "dialogues": [
                {
                    "id": "641460101",
                    "speaker": "迪拉瓦尔",
                    "text": "来这做交易，不能只想着一夜暴富，还得做好一贫如洗的准备哦。"
                }
            ]
        },
        {
            "talkId": "6414602",
            "initDialog": "641460201",
            "dialogues": [
                {
                    "id": "641460201",
                    "speaker": "Player",
                    "text": "这么刺激？"
                },
                {
                    "id": "641460202",
                    "speaker": "迪拉瓦尔",
                    "text": "呵呵，这里可是维卡拉商栈，是港口贸易流通的枢纽所在。"
                },
                {
                    "id": "641460203",
                    "speaker": "迪拉瓦尔",
                    "text": "财富的总量是一定的，有人赚钱，就会有人赔钱。"
                },
                {
                    "id": "641460204",
                    "speaker": "迪拉瓦尔",
                    "text": "能在这里赚到钱的人，都不简单。"
                },
                {
                    "id": "641460205",
                    "speaker": "迪拉瓦尔",
                    "text": "你要是想得太简单了的话…嗯，要不还是去城里的卡里米交易所试试运气？"
                }
            ]
        },
        {
            "talkId": "6414603",
            "initDialog": "641460301",
            "dialogues": [
                {
                    "id": "641460301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641460302",
                    "speaker": "迪拉瓦尔",
                    "text": "呵呵，赚钱可不是那么容易的。"
                }
            ]
        }
    ]
}