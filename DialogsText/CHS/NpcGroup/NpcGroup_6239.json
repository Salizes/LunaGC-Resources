{
    "groupId": "6239",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "乌茨勒": 15
    },
    "talks": [
        {
            "talkId": "5900225",
            "initDialog": "590022501",
            "dialogues": [
                {
                    "id": "590022501",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900226",
            "initDialog": "590022601",
            "dialogues": [
                {
                    "id": "590022601",
                    "speaker": "乌茨勒",
                    "text": "一切都好，就是没什么人有空和我打牌…哦，不过转念一想，我现在也还在工作中呢。"
                }
            ]
        },
        {
            "talkId": "6623901",
            "initDialog": "662390101",
            "dialogues": [
                {
                    "id": "662390101",
                    "speaker": "乌茨勒",
                    "text": "嗯，下次这样去打，一定可以很帅地赢下来。"
                }
            ]
        },
        {
            "talkId": "6623902",
            "initDialog": "662390201",
            "dialogues": [
                {
                    "id": "662390201",
                    "speaker": "Player",
                    "text": "赢下什么？"
                },
                {
                    "id": "662390202",
                    "speaker": "乌茨勒",
                    "text": "当然是决斗的胜利！"
                },
                {
                    "id": "662390203",
                    "speaker": "乌茨勒",
                    "text": "集结所有被龙祝福的卡牌——我是说，所有和龙有关的卡牌——再加上龙羽在身的卡组——我是指，最新定制的卡背——"
                },
                {
                    "id": "662390204",
                    "speaker": "乌茨勒",
                    "text": "接下来的对决，我将无往不胜！胜利将百分百属于最骄傲的牌手——也就是说，我！"
                },
                {
                    "id": "662390205",
                    "speaker": "乌茨勒",
                    "text": "当然，需要特别鸣谢爱雅老师，正是她为我精心绘制了绒翼龙样式的卡背。衷心祝愿她在楚汶市集生意兴隆。"
                }
            ]
        },
        {
            "talkId": "6623903",
            "initDialog": "662390301",
            "dialogues": [
                {
                    "id": "662390301",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "662390302",
                    "speaker": "乌茨勒",
                    "text": "我会的，因为我有龙的保佑！"
                }
            ]
        },
        {
            "talkId": "6623904",
            "initDialog": "662390401",
            "dialogues": [
                {
                    "id": "662390401",
                    "speaker": "Player",
                    "text": "还以为是在说战斗的事情…"
                },
                {
                    "id": "662390402",
                    "speaker": "乌茨勒",
                    "text": "啊，战斗的话，重点不应该在帅不帅上吧？这和打牌这种桌面上的把戏可不一样啊。"
                },
                {
                    "id": "662390403",
                    "speaker": "乌茨勒",
                    "text": "我刚刚聊到七圣召唤的时候情绪可能有些激动，但请不要把我当成什么战争狂热者。"
                },
                {
                    "id": "662390404",
                    "speaker": "乌茨勒",
                    "text": "有些战士可能是蹒跚着走下战场的，但他战胜了敌人，活着回到了家乡，那他就是最后的赢家。"
                }
            ]
        },
        {
            "talkId": "6623905",
            "initDialog": "662390501",
            "dialogues": [
                {
                    "id": "662390501",
                    "speaker": "乌茨勒",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6623906",
            "initDialog": "662390601",
            "dialogues": [
                {
                    "id": "662390601",
                    "speaker": "乌茨勒",
                    "text": "怎么样，很帅吧？我方才战斗的英姿！"
                }
            ]
        },
        {
            "talkId": "6623907",
            "initDialog": "662390701",
            "dialogues": [
                {
                    "id": "662390701",
                    "speaker": "乌茨勒",
                    "text": "失败了吗？看起来我的帅气还不够啊…"
                }
            ]
        },
        {
            "talkId": "7593901",
            "initDialog": "759390101",
            "dialogues": [
                {
                    "id": "759390101",
                    "speaker": "Player",
                    "text": "这样也很帅。"
                },
                {
                    "id": "759390102",
                    "speaker": "乌茨勒",
                    "text": "…我想象了一下，你说的确实有道理。"
                },
                {
                    "id": "759390103",
                    "speaker": "乌茨勒",
                    "text": "不过我还是要说，不要为了耍帅上战场！赢才是最重要的。"
                }
            ]
        }
    ]
}