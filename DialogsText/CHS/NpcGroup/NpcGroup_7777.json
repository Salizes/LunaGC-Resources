{
    "groupId": "7777",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "瓦柳希娜": 11
    },
    "talks": [
        {
            "talkId": "6777701",
            "initDialog": "677770101",
            "dialogues": [
                {
                    "id": "677770101",
                    "speaker": "瓦柳希娜",
                    "text": "虽然喝酒的感觉很好，但喝少点…呵，也不错。"
                }
            ]
        },
        {
            "talkId": "6777702",
            "initDialog": "677770201",
            "dialogues": [
                {
                    "id": "677770201",
                    "speaker": "Player",
                    "text": "你很喜欢喝酒？"
                },
                {
                    "id": "677770202",
                    "speaker": "瓦柳希娜",
                    "text": "是啊，我很享受醉酒时候的感觉，怎么说来着…飘飘欲仙？当然啦，最重要的，还是它能让我暂时从忧愁中脱身而出。"
                },
                {
                    "id": "677770203",
                    "speaker": "瓦柳希娜",
                    "text": "无论烦心事再多，我的酒杯里也没有它们的容身之地。"
                },
                {
                    "id": "677770204",
                    "speaker": "瓦柳希娜",
                    "text": "就算忧愁来袭，烈酒也会将他们追剿殆尽，只留下轻飘飘的愉悦感伴我入眠…"
                },
                {
                    "id": "677770205",
                    "speaker": "瓦柳希娜",
                    "text": "呵呵，涅日达诺夫真该试试，偶尔喝一点也不成问题。"
                }
            ]
        },
        {
            "talkId": "6777703",
            "initDialog": "677770301",
            "dialogues": [
                {
                    "id": "677770301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "677770302",
                    "speaker": "瓦柳希娜",
                    "text": "再见。祝你喝得尽兴。"
                }
            ]
        },
        {
            "talkId": "6777704",
            "initDialog": "677770401",
            "dialogues": [
                {
                    "id": "677770401",
                    "speaker": "Player",
                    "text": "他怎么了？"
                },
                {
                    "id": "677770402",
                    "speaker": "瓦柳希娜",
                    "text": "想要一醉解千愁，却又担心自己酒后失态；想要纵心享乐，却又惦记着许多东西。"
                },
                {
                    "id": "677770403",
                    "speaker": "瓦柳希娜",
                    "text": "所以，就只能枫达浇愁愁更愁喽。啊，也可能是牛奶浇愁愁更愁，看他自己的选择。"
                }
            ]
        },
        {
            "talkId": "6777705",
            "initDialog": "677770501",
            "dialogues": [
                {
                    "id": "677770501",
                    "speaker": "Player",
                    "text": "少喝点酒倒也没错啦…"
                },
                {
                    "id": "677770502",
                    "speaker": "瓦柳希娜",
                    "text": "是啊。少喝点酒，身体就会更好，身体更好，就能喝更多的酒…"
                }
            ]
        },
        {
            "talkId": "6777706",
            "initDialog": "677770601",
            "dialogues": [
                {
                    "id": "677770601",
                    "speaker": "Player",
                    "text": "…感觉你有点喝多了。"
                },
                {
                    "id": "677770602",
                    "speaker": "瓦柳希娜",
                    "text": "哈哈哈哈哈，也许吧。但和我身边的那些酒鬼相比，我喝的算少的。"
                },
                {
                    "id": "677770603",
                    "speaker": "瓦柳希娜",
                    "text": "毕竟美酒虽好，但还有正事要干呢。"
                }
            ]
        }
    ]
}