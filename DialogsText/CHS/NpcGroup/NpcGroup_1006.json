{
    "groupId": "1006",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 9,
        "琴": 28
    },
    "talks": [
        {
            "talkId": "30903",
            "initDialog": "3090301",
            "dialogues": [
                {
                    "id": "3090301",
                    "speaker": "琴",
                    "text": "真的非常感谢你接受我们的邀请，旅行者。",
                    "choices": [
                        {
                            "id": "3090302",
                            "text": "有关风魔龙。",
                            "response": [
                                {
                                    "id": "3090303",
                                    "speaker": "琴",
                                    "text": "关于龙的体型和力量的异变，的确有很多疑点…"
                                },
                                {
                                    "id": "3090304",
                                    "speaker": "琴",
                                    "text": "不过，对于骑士团来说，当务之急是平息这次袭击的余波。"
                                },
                                {
                                    "id": "3090305",
                                    "speaker": "琴",
                                    "text": "既然团长离开前将骑士团交给我，我便绝不能辜负团长，和蒙德的人民。"
                                },
                                {
                                    "id": "3090306",
                                    "speaker": "琴",
                                    "text": "一定要弄清楚事情的真相…"
                                }
                            ]
                        },
                        {
                            "id": "3090307",
                            "text": "进城以前的事。",
                            "response": [
                                {
                                    "id": "3090308",
                                    "speaker": "琴",
                                    "text": "听说侦察骑士安柏之前误会你了。"
                                },
                                {
                                    "id": "3090309",
                                    "speaker": "琴",
                                    "text": "请原谅她吧，她只是在履行自己的职务。"
                                },
                                {
                                    "id": "3090310",
                                    "speaker": "琴",
                                    "text": "啊，可以的话和安柏多多交流吧，她会把她的活力也传递给你的。"
                                }
                            ]
                        },
                        {
                            "id": "3090311",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "3090312",
                                    "speaker": "琴",
                                    "text": "#嗯，再次感谢你的帮忙，{NICKNAME}。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "37312",
            "initDialog": "3730902",
            "dialogues": [
                {
                    "id": "3730902",
                    "speaker": "琴",
                    "text": "风魔龙事件的真相，依然存在隐情。一定还有我们未能掌握的事实…",
                    "choices": [
                        {
                            "id": "3730903",
                            "text": "有关风魔龙。",
                            "response": [
                                {
                                    "id": "3730904",
                                    "speaker": "琴",
                                    "text": "关于龙的体型和力量的异变，的确有很多疑点…"
                                },
                                {
                                    "id": "3730905",
                                    "speaker": "琴",
                                    "text": "不过，对于骑士团来说，当务之急是平息这次袭击的余波。"
                                },
                                {
                                    "id": "3730906",
                                    "speaker": "琴",
                                    "text": "既然团长离开前将骑士团交给我，我便绝不能辜负团长，和蒙德的人民。"
                                },
                                {
                                    "id": "3730907",
                                    "speaker": "琴",
                                    "text": "一定要弄清楚事情的真相…"
                                }
                            ]
                        },
                        {
                            "id": "3730908",
                            "text": "关于愚人众。",
                            "response": [
                                {
                                    "id": "3730909",
                                    "speaker": "琴",
                                    "text": "那些穿着奇怪制服的人…愚人众。"
                                },
                                {
                                    "id": "3730910",
                                    "speaker": "琴",
                                    "text": "是作为至冬国使团来到蒙德的。"
                                },
                                {
                                    "id": "3730911",
                                    "speaker": "琴",
                                    "text": "尽量避免和他们扯上关系，即使对于无关的旅者而言，与他们接触也是有风险的。"
                                }
                            ]
                        },
                        {
                            "id": "3730912",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "3730913",
                                    "speaker": "琴",
                                    "text": "听凭风引。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "38306",
            "initDialog": "3830514",
            "dialogues": [
                {
                    "id": "3830514",
                    "speaker": "琴",
                    "text": "即使是以私人身份行动，也偶尔会用那种语气说话…这就是，所谓的职业病？",
                    "choices": [
                        {
                            "id": "3830515",
                            "text": "关于骑士团。",
                            "response": [
                                {
                                    "id": "3830516",
                                    "speaker": "琴",
                                    "text": "说来有些惭愧，这次事件后，骑士团的大家都忙得焦头烂额。"
                                },
                                {
                                    "id": "3830517",
                                    "speaker": "琴",
                                    "text": "如果我是一个更有能力的团长的话…"
                                },
                                {
                                    "id": "3830518",
                                    "speaker": "琴",
                                    "text": "或者像大团长那样，给大家带来更多士气与力量的话…"
                                },
                                {
                                    "id": "3830519",
                                    "speaker": "琴",
                                    "text": "不行，不能泄气，早点解决问题才是最重要的。对吧？荣誉骑士。"
                                }
                            ]
                        },
                        {
                            "id": "3830520",
                            "text": "关于天空之琴。",
                            "response": [
                                {
                                    "id": "3830521",
                                    "speaker": "琴",
                                    "text": "巴巴托斯的圣物，蒙德的至宝…天空之琴。"
                                },
                                {
                                    "id": "3830522",
                                    "speaker": "琴",
                                    "text": "有净化污秽的力量也不足为奇呢。"
                                },
                                {
                                    "id": "3830523",
                                    "speaker": "琴",
                                    "text": "希望可以如温迪所说，靠它的力量拯救特瓦林。"
                                },
                                {
                                    "id": "3830524",
                                    "speaker": "琴",
                                    "text": "该说这是巴巴托斯大人留给我们的祝福吗？"
                                }
                            ]
                        },
                        {
                            "id": "3830525",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "3830526",
                                    "speaker": "琴",
                                    "text": "听凭风引，特瓦林一定会得救的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}