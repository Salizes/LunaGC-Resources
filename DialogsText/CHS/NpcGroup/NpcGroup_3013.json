{
    "groupId": "3013",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "平八": 12
    },
    "talks": [
        {
            "talkId": "6301301",
            "initDialog": "630130101",
            "dialogues": [
                {
                    "id": "630130101",
                    "speaker": "平八",
                    "text": "谁啊，瞅我干嘛，找茬？"
                }
            ]
        },
        {
            "talkId": "6301302",
            "initDialog": "630130201",
            "dialogues": [
                {
                    "id": "630130201",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "630130202",
                    "speaker": "平八",
                    "text": "你老盯着我干嘛？"
                },
                {
                    "id": "630130203",
                    "speaker": "平八",
                    "text": "茶难喝就是难喝，简直难喝死了，乌鸦的口水也就这样了。"
                },
                {
                    "id": "630130204",
                    "speaker": "平八",
                    "text": "不仅茶难喝，景色也差，明明是稻妻的店面却总有外国人晃悠。"
                },
                {
                    "id": "630130205",
                    "speaker": "平八",
                    "text": "还敢自称什么只接待上流人士的高端地界…哼，在我看来，不过一间茅草屋罢了。"
                },
                {
                    "id": "630130206",
                    "speaker": "平八",
                    "text": "要不是因为要务在身，我才不愿待在这。"
                }
            ]
        },
        {
            "talkId": "6301303",
            "initDialog": "630130301",
            "dialogues": [
                {
                    "id": "630130301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630130302",
                    "speaker": "平八",
                    "text": "快走吧。这鬼地方，茶不好喝，周围也不清净。"
                }
            ]
        },
        {
            "talkId": "6301304",
            "initDialog": "630130401",
            "dialogues": [
                {
                    "id": "630130401",
                    "speaker": "Player",
                    "text": "要务在身？"
                },
                {
                    "id": "630130402",
                    "speaker": "平八",
                    "text": "还不是因为你们这些外国人，整天坐享其成，吃喝玩乐，还总惹麻烦。"
                },
                {
                    "id": "630130403",
                    "speaker": "平八",
                    "text": "瞧瞧那边那个至冬人，每天逍遥自在，到处瞎打听事情，赖在稻妻不走。"
                },
                {
                    "id": "630130404",
                    "speaker": "平八",
                    "text": "要不是因为他一直在这个破茶室待着不出去，我早就…"
                },
                {
                    "id": "630130405",
                    "speaker": "平八",
                    "text": "哎我干嘛要跟你说这些，你算老几啊？"
                },
                {
                    "id": "630130406",
                    "speaker": "平八",
                    "text": "小心点，别有什么坏心思被我发现了。要是耽误我的好事，别怪我不客气。"
                }
            ]
        }
    ]
}