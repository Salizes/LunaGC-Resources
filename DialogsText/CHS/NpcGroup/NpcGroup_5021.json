{
    "groupId": "5021",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "洛薇": 10
    },
    "talks": [
        {
            "talkId": "6502101",
            "initDialog": "650210101",
            "dialogues": [
                {
                    "id": "650210101",
                    "speaker": "洛薇",
                    "text": "警卫机关好像一个巨大的发条玩具！可以拆开来看看吗？"
                }
            ]
        },
        {
            "talkId": "6502102",
            "initDialog": "650210201",
            "dialogues": [
                {
                    "id": "650210201",
                    "speaker": "Player",
                    "text": "你喜欢发条玩具？"
                },
                {
                    "id": "650210202",
                    "speaker": "洛薇",
                    "text": "嗯，我爸爸是枫丹科学院的大科学家，经常给我许多好玩的玩具。"
                },
                {
                    "id": "650210203",
                    "speaker": "洛薇",
                    "text": "我喜欢把它们从里到外都拆开，再一点点装回去。"
                },
                {
                    "id": "650210204",
                    "speaker": "洛薇",
                    "text": "虽然也有装不回去的情况，但有时根本不影响它们正常运转呢！"
                }
            ]
        },
        {
            "talkId": "6502103",
            "initDialog": "650210301",
            "dialogues": [
                {
                    "id": "650210301",
                    "speaker": "Player",
                    "text": "应该不能吧…"
                },
                {
                    "id": "650210302",
                    "speaker": "洛薇",
                    "text": "欸——不会又是什么大人们用来搪塞的说法吧。"
                },
                {
                    "id": "650210303",
                    "speaker": "洛薇",
                    "text": "「这个不能碰，不然你会被警备队的叔叔阿姨逮走的！」"
                },
                {
                    "id": "650210304",
                    "speaker": "洛薇",
                    "text": "大人们真没意思，还是我在「莱舒的发条工坊」认识的金发哥哥好。"
                },
                {
                    "id": "650210305",
                    "speaker": "洛薇",
                    "text": "他虽然不爱说话，但会允许我拆开他的发条企鹅来玩。"
                },
                {
                    "id": "650210306",
                    "speaker": "洛薇",
                    "text": "那只企鹅好可爱，里面的构造也好奇妙。好像是那位哥哥自己做的呢，真羡慕！"
                }
            ]
        },
        {
            "talkId": "6502104",
            "initDialog": "650210401",
            "dialogues": [
                {
                    "id": "650210401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650210402",
                    "speaker": "洛薇",
                    "text": "唔…什么时候我才能有这样的发条玩具呢？"
                }
            ]
        }
    ]
}