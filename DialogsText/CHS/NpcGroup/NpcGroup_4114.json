{
    "groupId": "4114",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "阿南德": 13
    },
    "talks": [
        {
            "talkId": "5900068",
            "initDialog": "590006801",
            "dialogues": [
                {
                    "id": "590006801",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900069",
            "initDialog": "590006901",
            "dialogues": [
                {
                    "id": "590006901",
                    "speaker": "阿南德",
                    "text": "好像没什么特别的…"
                },
                {
                    "id": "590006902",
                    "speaker": "阿南德",
                    "text": "船只正常往来，海面也很平静，是个好日子啊。"
                }
            ]
        },
        {
            "talkId": "6411401",
            "initDialog": "641140101",
            "dialogues": [
                {
                    "id": "641140101",
                    "speaker": "阿南德",
                    "text": "一定要认真维护港口来往的每一艘船。"
                }
            ]
        },
        {
            "talkId": "6411402",
            "initDialog": "641140201",
            "dialogues": [
                {
                    "id": "641140201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "641140202",
                    "speaker": "阿南德",
                    "text": "你好。你是乘船来的吗？"
                },
                {
                    "id": "641140203",
                    "speaker": "阿南德",
                    "text": "如果需要船只维护工作，请来找我吧。"
                },
                {
                    "id": "641140204",
                    "speaker": "阿南德",
                    "text": "我会认真对待港口来来往往的每一条船。"
                }
            ]
        },
        {
            "talkId": "6411403",
            "initDialog": "641140301",
            "dialogues": [
                {
                    "id": "641140301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641140302",
                    "speaker": "阿南德",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
            "talkId": "6411404",
            "initDialog": "641140401",
            "dialogues": [
                {
                    "id": "641140401",
                    "speaker": "Player",
                    "text": "辛苦了。"
                },
                {
                    "id": "641140402",
                    "speaker": "阿南德",
                    "text": "不辛苦，只是本职工作罢了。"
                },
                {
                    "id": "641140403",
                    "speaker": "阿南德",
                    "text": "唯一让我有些顾虑的…应该是人手问题吧。"
                },
                {
                    "id": "641140404",
                    "speaker": "阿南德",
                    "text": "因为商队之间的竞争，让我们这些工匠的收入越来越不稳定，导致了不少工人转行。"
                },
                {
                    "id": "641140405",
                    "speaker": "阿南德",
                    "text": "但我是不会离开的，因为我的爱人是远航商船的海员，所以我明白船舶安全的重要性。"
                },
                {
                    "id": "641140406",
                    "speaker": "阿南德",
                    "text": "听说璃月那边有一个叫「和记厅」的机构专门负责海运物流的调配工作。"
                },
                {
                    "id": "641140407",
                    "speaker": "阿南德",
                    "text": "你说，这样是不是就解决了恶性竞争的问题啊？"
                }
            ]
        }
    ]
}