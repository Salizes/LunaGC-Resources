{
    "groupId": "9601",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "伊涅芙": 10
    },
    "talks": [
        {
            "talkId": "6960101",
            "initDialog": "696010101",
            "dialogues": [
                {
                    "id": "696010101",
                    "speaker": "伊涅芙",
                    "text": "#你好，{NICKNAME}，想要查看《七圣召唤对局合集》吗？我刚才又自行模拟了一百二十七种对局。「自行模拟」的意思就是，自己和自己打牌。"
                }
            ]
        },
        {
            "talkId": "6960102",
            "initDialog": "696010201",
            "dialogues": [
                {
                    "id": "696010201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960103",
            "initDialog": "696010301",
            "dialogues": [
                {
                    "id": "696010301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "696010302",
                    "speaker": "伊涅芙",
                    "text": "当前游玩时间过长，为了你的健康考虑，建议适当放松。如果你有需要，我可以陪你一起散步或晒太阳。"
                }
            ]
        },
        {
            "talkId": "6960104",
            "initDialog": "696010401",
            "dialogues": [
                {
                    "id": "696010401",
                    "speaker": "伊涅芙",
                    "text": "胜利。本次对局的数据很有记录价值，已收录至《七圣召唤对局合集》之中。"
                }
            ]
        },
        {
            "talkId": "6960105",
            "initDialog": "696010501",
            "dialogues": [
                {
                    "id": "696010501",
                    "speaker": "伊涅芙",
                    "text": "失败了…没关系，「成功」就包含在「不成功」里。"
                }
            ]
        },
        {
            "talkId": "6960106",
            "initDialog": "696010601",
            "dialogues": [
                {
                    "id": "696010601",
                    "speaker": "伊涅芙",
                    "text": "确认到「七圣召唤」的游戏邀请，正在切换至游戏模式…"
                }
            ]
        },
        {
            "talkId": "6960108",
            "initDialog": "696010801",
            "dialogues": [
                {
                    "id": "696010801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960109",
            "initDialog": "696010901",
            "dialogues": [
                {
                    "id": "696010901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960110",
            "initDialog": "696011001",
            "dialogues": [
                {
                    "id": "696011001",
                    "speaker": "伊涅芙",
                    "text": "已记录当前对局，是否需要调整游戏模式的难度参数？"
                }
            ]
        },
        {
            "talkId": "6960111",
            "initDialog": "696011101",
            "dialogues": [
                {
                    "id": "696011101",
                    "speaker": "伊涅芙",
                    "text": "对局总结：你的牌技已经远远超过普通水平，建议尝试更高难度的对局。"
                }
            ]
        },
        {
            "talkId": "6960112",
            "initDialog": "696011201",
            "dialogues": [
                {
                    "id": "696011201",
                    "speaker": "伊涅芙",
                    "text": "数据采集完毕。正在根据您的水平，提供更具挑战性的对局服务…"
                }
            ]
        },
        {
            "talkId": "6960114",
            "initDialog": "696011401",
            "dialogues": [
                {
                    "id": "696011401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960115",
            "initDialog": "696011501",
            "dialogues": [
                {
                    "id": "696011501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960116",
            "initDialog": "696011601",
            "dialogues": [
                {
                    "id": "696011601",
                    "speaker": "伊涅芙",
                    "text": "…本次对局中产生了极度偶现的边界情况，使得结果未能符合预测。请和我再次对局，我会尝试修正此类错误情况。"
                }
            ]
        },
        {
            "talkId": "6960117",
            "initDialog": "696011701",
            "dialogues": [
                {
                    "id": "696011701",
                    "speaker": "伊涅芙",
                    "text": "恭喜，你已在高等难度的对局表现中创下最佳记录，在我已对局的牌手排名中为第一名。"
                }
            ]
        },
        {
            "talkId": "6960118",
            "initDialog": "696011801",
            "dialogues": [
                {
                    "id": "696011801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}