    "talks": [
        {
            "talkId": "6638501",
            "initDialog": "663850101",
            "dialogues": [
                {
                    "id": "663850101",
                    "speaker": "科勇基",
                    "text": "这位朋友，走在这附近，可要小心落石啊。"
                }
            ]
        },
        {
            "talkId": "6638502",
            "initDialog": "663850201",
            "dialogues": [
                {
                    "id": "663850201",
                    "speaker": "Player",
                    "text": "落石？这里不是部族内部吗？"
                },
                {
                    "id": "663850202",
                    "speaker": "科勇基",
                    "text": "哈哈，你抬头看一眼就知道啦。总之，还请小心落石。"
                }
            ]
        },
        {
            "talkId": "6638503",
            "initDialog": "663850301",
            "dialogues": [
                {
                    "id": "663850301",
                    "speaker": "Player",
                    "text": "关于火山…"
                },
                {
                    "id": "663850302",
                    "speaker": "科勇基",
                    "text": "喔，你是要到图兰大火山去吗？"
                },
                {
                    "id": "663850303",
                    "speaker": "科勇基",
                    "text": "哈哈，倒也不是什么珍奇的事情。毕竟，一直以来，龙遗迹协会的学者和冒险家都希望能找到进入火山内部的办法。"
                },
                {
                    "id": "663850304",
                    "speaker": "科勇基",
                    "text": "这位朋友，你应该也是冒险家吧？探索的时候，记得要小心火山突然喷发，以免被奇怪的东西砸到啦。"
                }
            ]
        },
        {
            "talkId": "6638504",
            "initDialog": "663850401",
            "dialogues": [
                {
                    "id": "663850401",
                    "speaker": "Player",
                    "text": "好，再见。"
                },
                {
                    "id": "663850402",
                    "speaker": "科勇基",
                    "text": "嗯，注意安全。"
                }
            ]
        }
    ]
}