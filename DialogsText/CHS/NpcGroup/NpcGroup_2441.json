    },
    "talks": [
        {
            "talkId": "6244104",
            "initDialog": "624410401",
            "dialogues": [
                {
                    "id": "624410401",
                    "speaker": "夙凌",
                    "text": "哎，旅行者你好啊！抱歉，我等下还要查看武器的整备情况…"
                }
            ]
        },
        {
            "talkId": "6244105",
            "initDialog": "624410501",
            "dialogues": [
                {
                    "id": "624410501",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "624410502",
                    "speaker": "夙凌",
                    "text": "我是「死兆星号」的首席铁匠，同时也负责管理船队的所有武器。"
                },
                {
                    "id": "624410503",
                    "speaker": "夙凌",
                    "text": "你要是想找铁匠就去「寒锋铁器」吧，那里的老板老章是我表哥，他的手艺是璃月港最顶尖的。"
                },
                {
                    "id": "624410504",
                    "speaker": "夙凌",
                    "text": "…打铁我确实不如他，但说起对武器的了解和认识，我自认为不会输给任何人。"
                },
                {
                    "id": "624410505",
                    "speaker": "夙凌",
                    "text": "我加入了北斗姐的船队，也是为了能去各地看看那些新奇、偏门的武器。"
                }
            ]
        },
        {
            "talkId": "6244106",
            "initDialog": "624410601",
            "dialogues": [
                {
                    "id": "624410601",
                    "speaker": "Player",
                    "text": "很忙的样子啊。"
                },
                {
                    "id": "624410602",
                    "speaker": "夙凌",
                    "text": "哈哈，现在其实还好啦。近期最忙的时候…应该是去稻妻的那会儿吧。当时大姐头可是吩咐我准备了不少过硬的装备呢。"
                },
                {
                    "id": "624410603",
                    "speaker": "夙凌",
                    "text": "话说从稻妻回来之后，船队的伙计们可是对你的身手赞不绝口。"
                },
                {
                    "id": "624410604",
                    "speaker": "夙凌",
                    "text": "要是你在武器方面也有什么改进意见的话，可要记得跟我说道说道啊！"
                }
            ]
        },
        {
            "talkId": "6244101",
            "initDialog": "624410101",
            "dialogues": [
                {
                    "id": "624410101",
                    "speaker": "夙凌",
                    "text": "抱歉，我等下还要查看武器的整备情况，不是重要的事情就不要打扰我了。"
                }
            ]
        },
        {
            "talkId": "6244102",
            "initDialog": "624410201",
            "dialogues": [
                {
                    "id": "624410201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624410202",
                    "speaker": "夙凌",
                    "text": "我是「死兆星号」的首席铁匠，同时也负责管理船队的所有武器。"
                },
                {
                    "id": "624410203",
                    "speaker": "夙凌",
                    "text": "你要是想找铁匠就去「寒锋铁器」吧，那里的老板老章是我表哥，他的手艺是璃月港最顶尖的。"
                },
                {
                    "id": "624410204",
                    "speaker": "夙凌",
                    "text": "…打铁我确实不如他，但说起对武器的了解和认识，我自认为不会输给任何人。"
                },
                {
                    "id": "624410205",
                    "speaker": "夙凌",
                    "text": "我加入了北斗姐的船队，也是为了能去各地看看那些新奇、偏门的武器。"
                }
            ]
        },
        {
            "talkId": "6244103",
            "initDialog": "624410301",
            "dialogues": [
                {
                    "id": "624410301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624410302",
                    "speaker": "夙凌",
                    "text": "你要是找到了什么新奇的武器，记得拿来给我看看。"
                }
            ]
        }
    ]
}