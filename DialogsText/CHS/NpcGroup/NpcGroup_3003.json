{
    "groupId": "3003",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 7,
        "御舆源一郎": 18
    },
    "talks": [
        {
            "talkId": "6300301",
            "initDialog": "630030101",
            "dialogues": [
                {
                    "id": "630030101",
                    "speaker": "御舆源一郎",
                    "text": "你好，看上什么工艺品了吗？如果在店里找不到现成的，我可以定做。"
                }
            ]
        },
        {
            "talkId": "6300302",
            "initDialog": "630030201",
            "dialogues": [
                {
                    "id": "630030201",
                    "speaker": "Player",
                    "text": "想选些纪念品。"
                },
                {
                    "id": "630030202",
                    "speaker": "御舆源一郎",
                    "text": "客人请便，看上了什么和我说就行。"
                }
            ]
        },
        {
            "talkId": "6300303",
            "initDialog": "630030301",
            "dialogues": [
                {
                    "id": "630030301",
                    "speaker": "Player",
                    "text": "关于「根付之源」…"
                },
                {
                    "id": "630030302",
                    "speaker": "御舆源一郎",
                    "text": "你是说，小店为什么叫这个名字？"
                },
                {
                    "id": "630030303",
                    "speaker": "御舆源一郎",
                    "text": "哈哈，看客人的样子，多半不是稻妻本地人吧。"
                },
                {
                    "id": "630030304",
                    "speaker": "御舆源一郎",
                    "text": "「根付」是稻妻人用来挂随身物品的一种小工艺品，圆润耐用，一般会根据主人的喜好，雕刻成各种样子。"
                },
                {
                    "id": "630030305",
                    "speaker": "御舆源一郎",
                    "text": "喏，像这样，绳子从腰带内侧穿过去，下面挂上钱袋、印笼之类的随身物品，绳头的根付便正好卡在腰带上了。是不是很方便？"
                },
                {
                    "id": "630030306",
                    "speaker": "御舆源一郎",
                    "text": "至于「源」字…哈哈，是取自在下的名字，让您见笑了。"
                }
            ]
        },
        {
            "talkId": "6300304",
            "initDialog": "630030401",
            "dialogues": [
                {
                    "id": "630030401",
                    "speaker": "Player",
                    "text": "能定做什么？"
                },
                {
                    "id": "630030402",
                    "speaker": "御舆源一郎",
                    "text": "客人想要什么？说说看，只要是我会做的都能安排。"
                },
                {
                    "id": "630030403",
                    "speaker": "御舆源一郎",
                    "text": "这爿小店虽然不像街上那些祖传的老商户一样出名，但在制作工艺品方面还是很有一手的。"
                },
                {
                    "id": "630030404",
                    "speaker": "御舆源一郎",
                    "text": "实不相瞒，在下其实是家中长子，不过从小就被人说性格木讷，怕是没那个本事继承家业。"
                },
                {
                    "id": "630030405",
                    "speaker": "御舆源一郎",
                    "text": "哈哈，倒不如在这里盘一家小店，凭手艺给邻里乡亲提供些便利。"
                }
            ]
        },
        {
            "talkId": "6300305",
            "initDialog": "630030501",
            "dialogues": [
                {
                    "id": "630030501",
                    "speaker": "Player",
                    "text": "谢谢，再见。"
                },
                {
                    "id": "630030502",
                    "speaker": "御舆源一郎",
                    "text": "客人慢走，有什么想要的下次再来。"
                }
            ]
        },
        {
            "talkId": "6300306",
            "initDialog": "630030601",
            "dialogues": [
                {
                    "id": "630030601",
                    "speaker": "Player",
                    "text": "想买些东西…"
                },
                {
                    "id": "630030602",
                    "speaker": "御舆源一郎",
                    "text": "让我看看客人的要求…"
                },
                {
                    "id": "630030603",
                    "speaker": "御舆源一郎",
                    "text": "啊，非常抱歉，客人需要的这些物品，鄙店还在筹备中。"
                },
                {
                    "id": "630030604",
                    "speaker": "御舆源一郎",
                    "text": "小店能力有限，有些商品需要一段时间才能进到货，麻烦客人等商品准备好之后再来吧。"
                }
            ]
        },
        {
            "talkId": "6300307",
            "initDialog": "630030701",
            "dialogues": [
                {
                    "id": "630030701",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6300308",
            "initDialog": "630030801",
            "dialogues": [
                {
                    "id": "630030801",
                    "speaker": "御舆源一郎",
                    "text": "哈哈，了不起，没想到客人的应对手段如此灵活…"
                }
            ]
        },
        {
            "talkId": "6300309",
            "initDialog": "630030901",
            "dialogues": [
                {
                    "id": "630030901",
                    "speaker": "御舆源一郎",
                    "text": "客人只是一些细节没有注意到而已…"
                }
            ]
        },
        {
            "talkId": "6300310",
            "initDialog": "630031001",
            "dialogues": [
                {
                    "id": "630031001",
                    "speaker": "Player",
                    "text": "有没有特别商品？"
                },
                {
                    "id": "630031002",
                    "speaker": "御舆源一郎",
                    "text": "我手上的确还有些别人寄卖的货物，不知是否合客人心意？"
                }
            ]
        }
    ]
}