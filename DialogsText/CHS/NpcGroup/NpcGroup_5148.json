{
    "groupId": "5148",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "谢里埃": 9
    },
    "talks": [
        {
            "talkId": "5900148",
            "initDialog": "590014801",
            "dialogues": [
                {
                    "id": "590014801",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900149",
            "initDialog": "590014901",
            "dialogues": [
                {
                    "id": "590014901",
                    "speaker": "谢里埃",
                    "text": "如果不是来乘船的话，确实没什么停留的必要，不如坐船去城里逛逛吧。"
                }
            ]
        },
        {
            "talkId": "6514801",
            "initDialog": "651480101",
            "dialogues": [
                {
                    "id": "651480101",
                    "speaker": "谢里埃",
                    "text": "那位须弥来的先生做事很细心，就算没有我做导游也不会有问题的。"
                }
            ]
        },
        {
            "talkId": "6514802",
            "initDialog": "651480201",
            "dialogues": [
                {
                    "id": "651480201",
                    "speaker": "Player",
                    "text": "须弥来的先生？"
                },
                {
                    "id": "651480202",
                    "speaker": "谢里埃",
                    "text": "嗯，他好像是在教令院工作的，趁着休假专程来枫丹旅游。"
                },
                {
                    "id": "651480203",
                    "speaker": "谢里埃",
                    "text": "听说是位对待研究和生活都很谨慎的人，通过层层关系联系到我，请我来为他做导游。"
                },
                {
                    "id": "651480204",
                    "speaker": "谢里埃",
                    "text": "这个没问题啦，我很有空闲，他想去哪我都可以奉陪。"
                },
                {
                    "id": "651480205",
                    "speaker": "谢里埃",
                    "text": "不过比起旅行本身，他似乎更喜欢制定旅行计划呢，连巡轨船要坐多长时间都要细细计算。"
                }
            ]
        },
        {
            "talkId": "6514803",
            "initDialog": "651480301",
            "dialogues": [
                {
                    "id": "651480301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651480302",
                    "speaker": "谢里埃",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "7490701",
            "initDialog": "749070101",
            "dialogues": [
                {
                    "id": "749070101",
                    "speaker": "Player",
                    "text": "我可以帮忙，让他快一点。"
                },
                {
                    "id": "749070102",
                    "speaker": "谢里埃",
                    "text": "不用不用，我没有要催他的意思，细心规划自己的人生，再慢慢享受，不是一件很好的事情嘛。"
                },
                {
                    "id": "749070103",
                    "speaker": "谢里埃",
                    "text": "就是他好像沉迷其中，顾不上吃我带来的面包了。我一个人可吃不完，您愿意赏光分享吗？"
                }
            ]
        }
    ]
}