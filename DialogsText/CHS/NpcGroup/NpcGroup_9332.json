{
    "groupId": "9332",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "优菈": 9
    },
    "talks": [
        {
            "talkId": "6933201",
            "initDialog": "693320101",
            "dialogues": [
                {
                    "id": "693320101",
                    "speaker": "优菈",
                    "text": "倒也不用急着立刻开始下一场战斗，充沛的精力是取得胜利的关键条件。"
                },
                {
                    "id": "693320102",
                    "speaker": "优菈",
                    "text": "不如抽时间审视一下敌情，优化自己的战术。"
                },
                {
                    "id": "693320103",
                    "speaker": "优菈",
                    "text": "我的经验是：谋划得越是周密，得手后获得的回味就越可口。"
                }
            ]
        },
        {
            "talkId": "6933202",
            "initDialog": "693320201",
            "dialogues": [
                {
                    "id": "693320201",
                    "speaker": "优菈",
                    "text": "即便敌人强大到足以拦住我的去路，对我来说，也不过是多了一个复仇对象而已。"
                },
                {
                    "id": "693320202",
                    "speaker": "优菈",
                    "text": "记下这个仇，将来必定让他们偿还。"
                },
                {
                    "id": "693320203",
                    "speaker": "优菈",
                    "text": "不过，有资格让你记仇的敌人应该没多少吧？"
                }
            ]
        },
        {
            "talkId": "6933203",
            "initDialog": "693320301",
            "dialogues": [
                {
                    "id": "693320301",
                    "speaker": "优菈",
                    "text": "被正义的骑士击败后，邪恶的「旧贵族」到底会怎样呢？"
                },
                {
                    "id": "693320302",
                    "speaker": "优菈",
                    "text": "是在举国欢庆时遁入阴暗的深林，自怨自艾？还是乞求活命后蜷缩在王城的一隅，打磨爪牙？"
                },
                {
                    "id": "693320303",
                    "speaker": "优菈",
                    "text": "童话从来不会写这些事情，仿佛坏人被击败以后，幸福就会自然地持续下去。"
                }
            ]
        }
    ]
}