            "initDialog": "42011601",
            "dialogues": [
                {
                    "id": "42011601",
                    "speaker": "奇怪的记事本",
                    "text": "「…前日新订『璃月风土志·迎神』已送至群玉阁，敬请凝光大人查收…」"
                },
                {
                    "id": "42011602",
                    "speaker": "奇怪的记事本",
                    "text": "「…句三，二；句七，八；句七，五；句四，四；句三，一…」"
                },
                {
                    "id": "42011603",
                    "speaker": "奇怪的记事本",
                    "text": "「…句七，廿三、廿四；句八，廿三；句二，一；句九，廿八…」"
                },
                {
                    "id": "42011604",
                    "speaker": "奇怪的记事本",
                    "text": "下面的落款被涂掉了，完全看不出写的是什么。"
                }
            ]
        }
    ]
}