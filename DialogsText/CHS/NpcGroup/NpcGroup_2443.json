{
    "groupId": "2443",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "关宏": 14
    },
    "talks": [
        {
            "talkId": "6244301",
            "initDialog": "624430101",
            "dialogues": [
                {
                    "id": "624430101",
                    "speaker": "关宏",
                    "text": "人生真是短暂啊，唉…"
                }
            ]
        },
        {
            "talkId": "6244302",
            "initDialog": "624430201",
            "dialogues": [
                {
                    "id": "624430201",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "624430202",
                    "speaker": "关宏",
                    "text": "我没事，只是前段时间我被查出得了不治之症，命不久矣…"
                },
                {
                    "id": "624430203",
                    "speaker": "关宏",
                    "text": "我总会想，我这一生究竟都做了些什么？"
                },
                {
                    "id": "624430204",
                    "speaker": "关宏",
                    "text": "努力了大半辈子，用健康换来了一堆生不带来死不带去的东西，哈哈…"
                },
                {
                    "id": "624430205",
                    "speaker": "关宏",
                    "text": "蓦然回首才发现，我这几十年甚至连一件值得自豪的事情都没做过，呵…"
                },
                {
                    "id": "624430206",
                    "speaker": "关宏",
                    "text": "可惜啊，我醒悟的太晚咯。"
                }
            ]
        },
        {
            "talkId": "6244303",
            "initDialog": "624430301",
            "dialogues": [
                {
                    "id": "624430301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624430302",
                    "speaker": "关宏",
                    "text": "让我一个人静静，谢谢…"
                }
            ]
        },
        {
            "talkId": "6244304",
            "initDialog": "624430401",
            "dialogues": [
                {
                    "id": "624430401",
                    "speaker": "关宏",
                    "text": "哈哈哈，你也是来享受的吧？"
                }
            ]
        },
        {
            "talkId": "6244305",
            "initDialog": "624430501",
            "dialogues": [
                {
                    "id": "624430501",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "624430502",
                    "speaker": "关宏",
                    "text": "做什么？那当然是享受人生啊！"
                },
                {
                    "id": "624430503",
                    "speaker": "关宏",
                    "text": "我以前总觉得工作才是最重要的事情，那叫一个废寝忘食，甚至一把年纪了还在打光棍呢。"
                },
                {
                    "id": "624430504",
                    "speaker": "关宏",
                    "text": "…直到前段时间我被白术先生查出已经病入膏肓，那时我才彻底想明白…什么工作、事业都是天上的浮云！"
                },
                {
                    "id": "624430505",
                    "speaker": "关宏",
                    "text": "幸好我前半辈子攒下的钱够多，够我在这「珠钿舫」逍遥到死了。"
                },
                {
                    "id": "624430506",
                    "speaker": "关宏",
                    "text": "这么一想，倒也没那么坏了，哈哈哈哈！"
                }
            ]
        },
        {
            "talkId": "6244306",
            "initDialog": "624430601",
            "dialogues": [
                {
                    "id": "624430601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624430602",
                    "speaker": "关宏",
                    "text": "欸，别急着走啊…"
                }
            ]
        }
    ]
}