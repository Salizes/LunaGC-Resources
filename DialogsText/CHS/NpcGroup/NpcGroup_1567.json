        "提米": 14
    },
    "talks": [
        {
            "talkId": "6156706",
            "initDialog": "615670601",
            "dialogues": [
                {
                    "id": "615670601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6156707",
            "initDialog": "615670701",
            "dialogues": [
                {
                    "id": "615670701",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6156708",
            "initDialog": "615670801",
            "dialogues": [
                {
                    "id": "615670801",
                    "speaker": "提米",
                    "text": "呜…怎么会输掉…"
                }
            ]
        },
        {
            "talkId": "6156709",
            "initDialog": "615670901",
            "dialogues": [
                {
                    "id": "615670901",
                    "speaker": "提米",
                    "text": "我赢啦！嘿嘿嘿！"
                }
            ]
        },
        {
            "talkId": "6156710",
            "initDialog": "615671001",
            "dialogues": [
                {
                    "id": "615671001",
                    "speaker": "提米",
                    "text": "呜…输掉了…鸽子也飞走了…"
                }
            ]
        },
        {
            "talkId": "6156711",
            "initDialog": "615671101",
            "dialogues": [
                {
                    "id": "615671101",
                    "speaker": "提米",
                    "text": "好欸！是我赢…咦，周围的鸽子呢…"
                }
            ]
        },
        {
            "talkId": "6156701",
            "initDialog": "615670101",
            "dialogues": [
                {
                    "id": "615670101",
                    "speaker": "提米",
                    "text": "你、你干嘛！鸽子都吓跑了！"
                }
            ]
        },
        {
            "talkId": "6156702",
            "initDialog": "615670201",
            "dialogues": [
                {
                    "id": "615670201",
                    "speaker": "Player",
                    "text": "我也没办法…"
                },
                {
                    "id": "615670202",
                    "speaker": "提米",
                    "text": "哼，怎么能说没办法呢！"
                },
                {
                    "id": "615670203",
                    "speaker": "提米",
                    "text": "妈妈说，只要爱着这个世界，就不会有小动物怕你的！"
                },
                {
                    "id": "615670204",
                    "speaker": "提米",
                    "text": "不然，鸽子为什么不怕我呢？"
                }
            ]
        },
        {
            "talkId": "6156703",
            "initDialog": "615670301",
            "dialogues": [
                {
                    "id": "615670301",
                    "speaker": "Player",
                    "text": "还会飞回来的。"
                },
                {
                    "id": "615670302",
                    "speaker": "提米",
                    "text": "一般来说是这样的…但万一有一天就不回来了呢？"
                },
                {
                    "id": "615670303",
                    "speaker": "提米",
                    "text": "就像爸爸那样…"
                }
            ]
        },
        {
            "talkId": "6156704",
            "initDialog": "615670401",
            "dialogues": [
                {
                    "id": "615670401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615670402",
                    "speaker": "提米",
                    "text": "呜…我要去告诉妈妈！"
                }
            ]
        },
        {
            "talkId": "6156705",
            "initDialog": "615670501",
            "dialogues": [
                {
                    "id": "615670501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "615670502",
                    "speaker": "提米",
                    "text": "我在想，风魔龙…会不会是鸽子变的呢？"
                },
                {
                    "id": "615670503",
                    "speaker": "提米",
                    "text": "就是因为你们老吓它们，所以它们变成了龙，回来报复人类！"
                },
                {
                    "id": "615670504",
                    "speaker": "提米",
                    "text": "它一定不会伤害像我这样善待它们的人，一定是这样的…"
                }
            ]
        }
    ]
}