{
    "groupId": "9375",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "娜维娅": 9
    },
    "talks": [
        {
            "talkId": "6937501",
            "initDialog": "693750101",
            "dialogues": [
                {
                    "id": "693750101",
                    "speaker": "娜维娅",
                    "text": "现在是休息时间，要不要品尝一些甜点？"
                },
                {
                    "id": "693750102",
                    "speaker": "娜维娅",
                    "text": "在这里的话，我推荐柠檬乳酪蛋糕哦！不像马卡龙那样纯粹的甜，柠檬的酸味能刺激味蕾，令人精神百倍。"
                },
                {
                    "id": "693750103",
                    "speaker": "娜维娅",
                    "text": "这样，看书就不会困了吧？"
                }
            ]
        },
        {
            "talkId": "6937502",
            "initDialog": "693750201",
            "dialogues": [
                {
                    "id": "693750201",
                    "speaker": "娜维娅",
                    "text": "要让秘境里的那些家伙乖乖让路，得拿出些真本事才行。"
                },
                {
                    "id": "693750202",
                    "speaker": "娜维娅",
                    "text": "这么一想，和在刺玫会的工作也差不多了。"
                },
                {
                    "id": "693750203",
                    "speaker": "娜维娅",
                    "text": "那些态度傲慢的人，总是要等吃了苦头之后才想起来礼节的含义呢。"
                }
            ]
        },
        {
            "talkId": "6937503",
            "initDialog": "693750301",
            "dialogues": [
                {
                    "id": "693750301",
                    "speaker": "娜维娅",
                    "text": "这里的书…是不是不能外借呀？"
                },
                {
                    "id": "693750302",
                    "speaker": "娜维娅",
                    "text": "那我得抓紧时间多看看，然后挑其中格外有趣的记下来，留着讲给白淞镇的孩子们听。"
                },
                {
                    "id": "693750303",
                    "speaker": "娜维娅",
                    "text": "另外一些虽然也是童话，但内容好像不太适合小孩子…哈哈，作者大概是个很有意思的大人吧！"
                }
            ]
        }
    ]
}