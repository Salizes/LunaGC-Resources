{
    "groupId": "6106",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 4,
        "帕恰": 17
    },
    "talks": [
        {
            "talkId": "6610601",
            "initDialog": "661060101",
            "dialogues": [
                {
                    "id": "661060101",
                    "speaker": "帕恰",
                    "text": "好想和花羽会的骑士们交朋友啊…还有绒翼龙…"
                }
            ]
        },
        {
            "talkId": "6610602",
            "initDialog": "661060201",
            "dialogues": [
                {
                    "id": "661060201",
                    "speaker": "Player",
                    "text": "想要就去争取。"
                },
                {
                    "id": "661060202",
                    "speaker": "帕恰",
                    "text": "哈哈，道理是这么说啦，但众所周知，花羽会的人大多喜欢骑着绒翼龙在天上飞。"
                },
                {
                    "id": "661060203",
                    "speaker": "帕恰",
                    "text": "别说见一面了，连根羽毛都很难碰到。"
                },
                {
                    "id": "661060204",
                    "speaker": "帕恰",
                    "text": "唔…但转念一想，我们「悬木人」和「花羽会」都喜欢待在高处，算是关系比较近的部族了。"
                },
                {
                    "id": "661060205",
                    "speaker": "帕恰",
                    "text": "那我应该不是完全没机会？"
                },
                {
                    "id": "661060206",
                    "speaker": "帕恰",
                    "text": "嗯，还好我没有恐高症。下次坐上热气球，往更高的地方去试试吧。"
                }
            ]
        },
        {
            "talkId": "6610603",
            "initDialog": "661060301",
            "dialogues": [
                {
                    "id": "661060301",
                    "speaker": "Player",
                    "text": "加油。"
                },
                {
                    "id": "661060302",
                    "speaker": "帕恰",
                    "text": "嗯，多谢了…"
                }
            ]
        },
        {
            "talkId": "6610604",
            "initDialog": "661060401",
            "dialogues": [
                {
                    "id": "661060401",
                    "speaker": "Player",
                    "text": "还没交到朋友吗？"
                },
                {
                    "id": "661060402",
                    "speaker": "帕恰",
                    "text": "哈哈，哪有那么容易呢！"
                },
                {
                    "id": "661060403",
                    "speaker": "帕恰",
                    "text": "之前在战场上倒是见过花羽会的战士们，但那时哪里顾得上闲聊。"
                },
                {
                    "id": "661060404",
                    "speaker": "帕恰",
                    "text": "绒翼龙飞得可真高啊，要是没有花羽会忙着到处救人，可能会有更多人牺牲吧。"
                },
                {
                    "id": "661060405",
                    "speaker": "帕恰",
                    "text": "靠我的能力大概没办法真的和他们并肩作战吧，经验最丰富的猎手们或许可以跳得和他们一样高。"
                },
                {
                    "id": "661060406",
                    "speaker": "帕恰",
                    "text": "不过能力越大风险越大…战争结束后到现在，我还没打听到关于辛奇的消息…"
                }
            ]
        },
        {
            "talkId": "6610605",
            "initDialog": "661060501",
            "dialogues": [
                {
                    "id": "661060501",
                    "speaker": "帕恰",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6610606",
            "initDialog": "661060601",
            "dialogues": [
                {
                    "id": "661060601",
                    "speaker": "帕恰",
                    "text": "哈哈，不好意思，这次是我赢啦！"
                }
            ]
        },
        {
            "talkId": "6610607",
            "initDialog": "661060701",
            "dialogues": [
                {
                    "id": "661060701",
                    "speaker": "帕恰",
                    "text": "嗯，这么厉害？看来除了交朋友的技术以外，我又有新的技能需要提高了…"
                }
            ]
        },
        {
            "talkId": "7592501",
            "initDialog": "759250101",
            "dialogues": [
                {
                    "id": "759250101",
                    "speaker": "Player",
                    "text": "人往高处走。"
                },
                {
                    "id": "759250102",
                    "speaker": "帕恰",
                    "text": "哦吼，这话说得好。"
                },
                {
                    "id": "759250103",
                    "speaker": "帕恰",
                    "text": "不断给自己挑战，也是一种和过去的自己的竞争吧。"
                }
            ]
        }
    ]
}