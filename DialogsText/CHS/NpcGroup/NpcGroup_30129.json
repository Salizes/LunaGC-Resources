    "talks": [
        {
            "talkId": "7165810",
            "initDialog": "716581001",
            "dialogues": [
                {
                    "id": "716581001",
                    "speaker": "重云",
                    "text": "总感觉…这一路忙来忙去，是不是忘了点什么…"
                },
                {
                    "id": "716581002",
                    "speaker": "行秋",
                    "text": "重云，你看轻策庄这青山绿水，是否当得起秀美二字？我认为…"
                },
                {
                    "id": "716581003",
                    "speaker": "重云",
                    "text": "啊想起来了！妖魔呢？"
                },
                {
                    "id": "716581004",
                    "speaker": "重云",
                    "text": "行秋，快把古籍拿出来好好看看，不可耽误大事。"
                },
                {
                    "id": "716581005",
                    "speaker": "行秋",
                    "text": "哎呀，莫要急躁。茶要一口一口喝，事要一件一件做。要是操之过急弄得自己腹背受敌，纵使你我二人武力超群也难应对啊。"
                },
                {
                    "id": "716581006",
                    "speaker": "重云",
                    "text": "唔…也有道理…行吧，就再信你一回。"
                },
                {
                    "id": "716581007",
                    "speaker": "行秋",
                    "text": "好，那刚才说到哪里来着…呃…有点记不起来了，快帮我想想。"
                },
                {
                    "id": "716581008",
                    "speaker": "重云",
                    "text": "呃…其实我也忘了…"
                }
            ]
        }
    ]
}