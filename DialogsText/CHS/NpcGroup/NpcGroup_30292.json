{
    "groupId": "30292",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Player": 11,
        "派蒙": 12,
        "荒谷": 30
    },
    "talks": [
        {
            "talkId": "4008118",
            "initDialog": "400811801",
            "dialogues": [
                {
                    "id": "400811801",
                    "speaker": "荒谷",
                    "text": "你们好呀，八重大人的贵客，将军大人的座上宾。",
                    "choices": [
                        {
                            "id": "400811802",
                            "text": "你是…",
                            "response": [
                                {
                                    "id": "400811803",
                                    "speaker": "荒谷",
                                    "text": "咦，居然不记得我了吗？"
                                },
                                {
                                    "id": "400811804",
                                    "speaker": "荒谷",
                                    "text": "我是八重堂的策划，「这本小说真厉害！」幕后的操办人，之前我还有幸见过你们。"
                                },
                                {
                                    "id": "400811805",
                                    "speaker": "派蒙",
                                    "text": "好像…有一点印象？"
                                },
                                {
                                    "id": "400811806",
                                    "speaker": "荒谷",
                                    "text": "这次偶遇后，你们应该就会记住我了。"
                                },
                                {
                                    "id": "400811807",
                                    "speaker": "荒谷",
                                    "text": "毕竟有了这次的经验，我会为八重堂的下一次活动注入超棒的创意，成为鼎鼎有名的策划…不愧是我！"
                                }
                            ]
                        },
                        {
                            "id": "400811808",
                            "text": "关于你们的游玩计划…",
                            "response": [
                                {
                                    "id": "400811809",
                                    "speaker": "荒谷",
                                    "text": "啊，计划就是尽可能走遍每个出名的地方。"
                                },
                                {
                                    "id": "400811810",
                                    "speaker": "荒谷",
                                    "text": "听说须弥有很多绝景，盘踞着各种神奇的动物。知性的学者和高尚的巡林员们来来往往，还有神秘、危险而诱人的佣兵团体。"
                                },
                                {
                                    "id": "400811811",
                                    "speaker": "荒谷",
                                    "text": "作家来这里找灵感，岂不是就像喝水一样容易？"
                                },
                                {
                                    "id": "400811812",
                                    "speaker": "荒谷",
                                    "text": "我原本建议八重大人带更多作者来取材，不过八重大人说，「重要的是质量而不是数量」，拿着名单随便翻翻，就选中了左右加。"
                                },
                                {
                                    "id": "400811813",
                                    "speaker": "荒谷",
                                    "text": "其实左右加还没有什么出名的作品呢，只是因为文笔不错，还有着很容易入戏的性格，才被我列入备选名单的。"
                                },
                                {
                                    "id": "400811814",
                                    "speaker": "派蒙",
                                    "text": "原来左右加小姐是这样被选中的吗…总感觉有点随便，但很符合神子的作风呢。"
                                },
                                {
                                    "id": "400811815",
                                    "speaker": "Player",
                                    "text": "也许神子想试试亲手培养新人。"
                                },
                                {
                                    "id": "400811816",
                                    "speaker": "荒谷",
                                    "text": "喔！居然猜的这么准！"
                                },
                                {
                                    "id": "400811817",
                                    "speaker": "荒谷",
                                    "text": "八重大人也说过，「向着最有趣的方向发掘出新人的潜力，是难得的体验。」"
                                },
                                {
                                    "id": "400811818",
                                    "speaker": "荒谷",
                                    "text": "当然，考虑到老派的作者们都有了自己习惯的写作风格，要把另一个国度的元素和谐地融会到小说里，新人反而可能更有优势。"
                                },
                                {
                                    "id": "400811819",
                                    "speaker": "荒谷",
                                    "text": "不愧是八重大人！现在看来，左右加确实是这次须弥之行的最佳人选！"
                                }
                            ]
                        },
                        {
                            "id": "400811820",
                            "text": "关于八重神子…",
                            "response": [
                                {
                                    "id": "400811821",
                                    "speaker": "荒谷",
                                    "text": "果然，你们更关注八重大人的去向。"
                                },
                                {
                                    "id": "400811822",
                                    "speaker": "荒谷",
                                    "text": "不过遗憾的是，八重大人只在特定的几天安排了我们的行程，余下的时间，我们都是自由行动的。"
                                },
                                {
                                    "id": "400811823",
                                    "speaker": "荒谷",
                                    "text": "比如我，就在这里考察驯兽师大赛的规划细节，真愉快。"
                                },
                                {
                                    "id": "400811824",
                                    "speaker": "荒谷",
                                    "text": "至于自由行动期间，八重大人究竟去了什么地方…这属于她的私人事宜，不是我这个一般策划有资格知道的事情哦。"
                                },
                                {
                                    "id": "400811825",
                                    "speaker": "派蒙",
                                    "text": "呃，想来也是，以神子的性格，应该不会喜欢那种满满当当的行程表吧。"
                                }
                            ]
                        },
                        {
                            "id": "400811826",
                            "text": "玩得开心！",
                            "response": [
                                {
                                    "id": "400811827",
                                    "speaker": "荒谷",
                                    "text": "你们也是哦，祝你们比赛顺利！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4008141",
            "initDialog": "400814101",
            "dialogues": [
                {
                    "id": "400814101",
                    "speaker": "荒谷",
                    "text": "真让人惊奇！你们以前研究过驯兽吗？如果刚刚上手，就能这么轻松地连胜三场，未免也太有天赋了！",
                    "choices": [
                        {
                            "id": "400814102",
                            "text": "恭喜我们呀。",
                            "response": [
                                {
                                    "id": "400814103",
                                    "speaker": "派蒙",
                                    "text": "#哈哈，{NICKNAME}学什么都很快哦！"
                                },
                                {
                                    "id": "400814104",
                                    "speaker": "派蒙",
                                    "text": "如果荒谷小姐跟着我们去冒险，就会接触到更多很新奇的事物了，但那些事物总是只给我们一丁点时间去适应！"
                                },
                                {
                                    "id": "400814105",
                                    "speaker": "荒谷",
                                    "text": "当真？"
                                },
                                {
                                    "id": "400814106",
                                    "speaker": "荒谷",
                                    "text": "原本我以为，这样的人只会在顺吉那种夸张的小说里出现…今天算是见识到了！"
                                },
                                {
                                    "id": "400814107",
                                    "speaker": "荒谷",
                                    "text": "以后我再也不会对顺吉那种「给角色突然增加能力」的设定发表负面评论了！"
                                }
                            ]
                        },
                        {
                            "id": "400814108",
                            "text": "这个先放在一边，左右加…",
                            "response": [
                                {
                                    "id": "400814109",
                                    "speaker": "派蒙",
                                    "text": "对哦，荒谷小姐在这里闲逛，左右加小姐去哪了呢？"
                                },
                                {
                                    "id": "400814110",
                                    "speaker": "荒谷",
                                    "text": "左右加啊？她好像很快就打起精神来了，说是规划好了新书的核心桥段，但还需要为日常的部分寻找灵感…"
                                },
                                {
                                    "id": "400814111",
                                    "speaker": "荒谷",
                                    "text": "所以她就去找熟悉本地环境的人了，正在规划接下来的旅途。"
                                },
                                {
                                    "id": "400814112",
                                    "speaker": "Player",
                                    "text": "还好还好。"
                                },
                                {
                                    "id": "400814113",
                                    "speaker": "派蒙",
                                    "text": "左右加小姐从失败的挫折里走出来了，我们也能松口气了呢。"
                                },
                                {
                                    "id": "400814114",
                                    "speaker": "Player",
                                    "text": "神子不也一样吗？"
                                },
                                {
                                    "id": "400814115",
                                    "speaker": "派蒙",
                                    "text": "就是啊，听说神子每次都把对手打得丢魂落魄！以神子悠哉的作风，肯定还没拿出全力！"
                                },
                                {
                                    "id": "400814116",
                                    "speaker": "荒谷",
                                    "text": "来了来了，进入了我熟悉的「商业互夸」环节！"
                                },
                                {
                                    "id": "400814117",
                                    "speaker": "荒谷",
                                    "text": "那么我就要提问了——旅行者和八重大人孰强？"
                                },
                                {
                                    "id": "400814118",
                                    "speaker": "荒谷",
                                    "text": "注意哦，我问的是这场比赛中的战斗力。假设你们和八重大人狭路相逢，谁会赢？"
                                },
                                {
                                    "id": "400814119",
                                    "speaker": "派蒙",
                                    "text": "欸？好突然！脑子一下子转不过来了…"
                                },
                                {
                                    "id": "400814120",
                                    "speaker": "派蒙",
                                    "text": "回答不知道，好像太敷衍了…现在就说我们会赢过神子，又属于大不敬的行为？那直接认输，又太软弱了，不甘心！",
                                    "choices": [
                                        {
                                            "id": "400814121",
                                            "text": "比较战斗力没有意义。",
                                            "response": [
                                                {
                                                    "id": "400814123",
                                                    "speaker": "派蒙",
                                                    "text": "有…有道理！差点就被荒谷小姐神子带偏了！神子自己也说过，她只是来体验一下驯兽罢了，根本没必要提这种问题嘛。"
                                                },
                                                {
                                                    "id": "400814124",
                                                    "speaker": "荒谷",
                                                    "text": "何等标准的答案！是「不会得罪任何人」级别的台词，直接让话题向着下一个阶段发展，收不回来了！"
                                                },
                                                {
                                                    "id": "400814125",
                                                    "speaker": "荒谷",
                                                    "text": "果然，你们才是被整个世界选中的「主角」吗！我开始期待了，你们两位的角色在左右加的新书里会有怎样一番表现！"
                                                },
                                                {
                                                    "id": "400814126",
                                                    "speaker": "派蒙",
                                                    "text": "怎么荒谷小姐也开始神神叨叨了，是左右加小姐的气质感染了她吗…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400814122",
                                            "text": "重要的是和伙伴们共处。"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}