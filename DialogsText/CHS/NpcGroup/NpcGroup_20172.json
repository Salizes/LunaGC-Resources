{
    "groupId": "20172",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "修斯": 13
    },
    "talks": [
        {
            "talkId": "4117001",
            "initDialog": "411700101",
            "dialogues": [
                {
                    "id": "411700101",
                    "speaker": "修斯",
                    "text": "嗯…嗯！这个地方不错…很适合起飞！"
                },
                {
                    "id": "411700102",
                    "speaker": "Player",
                    "text": "在哪起飞…？"
                },
                {
                    "id": "411700103",
                    "speaker": "修斯",
                    "text": "当然是要在合适的地方…啊，旅行者，初次见面，我叫修斯，是一位冒险家。"
                },
                {
                    "id": "411700104",
                    "speaker": "修斯",
                    "text": "不过…虽然说是冒险家，但我一直在外面研究风之翼的飞行方法，没有在协会待多长时间。"
                },
                {
                    "id": "411700105",
                    "speaker": "Player",
                    "text": "风之翼的飞行方法…"
                },
                {
                    "id": "411700106",
                    "speaker": "修斯",
                    "text": "没错，操纵风之翼可是一门大学问。"
                },
                {
                    "id": "411700107",
                    "speaker": "修斯",
                    "text": "同样的一架风之翼，有的人能操纵着和飞鸟同行，但有的人…飞不了多远就会摔下来。"
                },
                {
                    "id": "411700108",
                    "speaker": "修斯",
                    "text": "说到底，就是每个人对于风之翼使用技巧的掌握程度不同罢了。"
                },
                {
                    "id": "411700109",
                    "speaker": "修斯",
                    "text": "而想要磨练风之翼的使用技巧，那么最快捷的方法，就是去实地演练一番。"
                },
                {
                    "id": "411700110",
                    "speaker": "修斯",
                    "text": "旅行者，你应该也有风之翼吧？我正好找到了一处适合使用风之翼飞行的地点…"
                },
                {
                    "id": "411700111",
                    "speaker": "修斯",
                    "text": "怎么样，你有没有兴趣去那里「展翼高飞」一下？",
                    "choices": [
                        {
                            "id": "411700112",
                            "text": "我这就去。",
                            "response": [
                                {
                                    "id": "411700113",
                                    "speaker": "修斯",
                                    "text": "没问题，我这就把那里的位置标记在你的地图上…"
                                }
                            ]
                        },
                        {
                            "id": "411700114",
                            "text": "还有别的事…",
                            "response": [
                                {
                                    "id": "411700115",
                                    "speaker": "修斯",
                                    "text": "好吧，那你先忙你的事去吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4117002",
            "initDialog": "411700201",
            "dialogues": [
                {
                    "id": "411700201",
                    "speaker": "修斯",
                    "text": "怎么样？你准备好开始飞行挑战了吗？",
                    "choices": [
                        {
                            "id": "411700202",
                            "text": "开始飞行挑战"
                        },
                        {
                            "id": "411700203",
                            "text": "还没准备好…",
                            "response": [
                                {
                                    "id": "411700204",
                                    "speaker": "修斯",
                                    "text": "唔…那你去好好准备一下吧。准备好了之后，再来找我吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}