        {
            "talkId": "2101706",
            "initDialog": "210170601",
            "dialogues": [
                {
                    "id": "210170601",
                    "speaker": "丹迪",
                    "text": "想挑战自己速度的极限对吧？嗯嗯，我太明白你的想法了，毕竟我们的目标是星辰与深渊嘛！"
                }
