            "dialogues": [
                {
                    "id": "210170801",
                    "speaker": "丹迪",
                    "text": "这次的目标是在31秒内，抵达终点。"
                },
                {
                    "id": "210170802",
                    "speaker": "丹迪",
                    "text": "前进吧，别输给过去的自己咯~！"
