{
    "groupId": "9124",
    "total_dialogue_lines": 74,
    "speaker_counts": {
        "Player": 20,
        "雅珂达": 54
    },
    "talks": [
        {
            "talkId": "6912401",
            "initDialog": "691240101",
            "dialogues": [
                {
                    "id": "691240101",
                    "speaker": "雅珂达",
                    "text": "真厉害，这里就和奈姐讲的那个故事一样。"
                },
                {
                    "id": "691240102",
                    "speaker": "雅珂达",
                    "text": "隐藏在沙漠里，必须要口令才能打开的宝藏…"
                },
                {
                    "id": "691240103",
                    "speaker": "雅珂达",
                    "text": "嘿嘿，可惜这里只有我一个人，而且我也不是什么「大盗」。"
                }
            ]
        },
        {
            "talkId": "6912402",
            "initDialog": "691240201",
            "dialogues": [
                {
                    "id": "691240201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691240202",
                    "speaker": "雅珂达",
                    "text": "吃的好睡的好，住的也特别好，没有什么不习惯的。"
                },
                {
                    "id": "691240203",
                    "speaker": "Player",
                    "text": "但你怎么看着有点黑眼圈…"
                },
                {
                    "id": "691240204",
                    "speaker": "雅珂达",
                    "text": "咦？欸？真的，有这么明显？"
                },
                {
                    "id": "691240205",
                    "speaker": "雅珂达",
                    "text": "好吧，我承认，昨天晚上我失眠了，折腾了好久才勉强睡着。"
                },
                {
                    "id": "691240206",
                    "speaker": "雅珂达",
                    "text": "失眠的原因…是因为这里的环境有点太好了，床很软，被子很轻，周围也很安静…",
                    "choices": [
                        {
                            "id": "691240207",
                            "text": "太、太好了？",
                            "response": [
                                {
                                    "id": "691240209",
                                    "speaker": "雅珂达",
                                    "text": "是啊…这是我的老毛病了，越是待在舒适的地方，我就会越不适应，根本无法安心休息。"
                                },
                                {
                                    "id": "691240210",
                                    "speaker": "雅珂达",
                                    "text": "就算是勉强酝酿了一些睡意，但在入睡的前一个刹那，我总是会一下子清醒过来…"
                                },
                                {
                                    "id": "691240211",
                                    "speaker": "雅珂达",
                                    "text": "然后，我要么猛地从床上弹起来，本能地环顾四周；要么是把手伸进枕头底下，试图摸到什么东西。"
                                },
                                {
                                    "id": "691240212",
                                    "speaker": "雅珂达",
                                    "text": "当然啦，大部分情况下，房间里只有我一个人，枕头底下也什么都没有…然后，我就一身冷汗地重新睡下，开始享受失眠的感觉。"
                                },
                                {
                                    "id": "691240213",
                                    "speaker": "雅珂达",
                                    "text": "我刚到「秘闻馆」的时候，这种情况最严重，无论怎么样都睡不着，最后我只能悄悄跑去大厅，在沙发上躺下，这才算是睡着了…"
                                },
                                {
                                    "id": "691240214",
                                    "speaker": "雅珂达",
                                    "text": "当我醒过来的时候，只看见奈姐抱着阿舍鲁，笑眯眯地盯着我看。"
                                },
                                {
                                    "id": "691240215",
                                    "speaker": "雅珂达",
                                    "text": "唉，我当时魂都差点吓飞了…"
                                },
                                {
                                    "id": "691240216",
                                    "speaker": "Player",
                                    "text": "那现在你适应了么？"
                                },
                                {
                                    "id": "691240217",
                                    "speaker": "雅珂达",
                                    "text": "还没适应呢，但奈姐从稻妻弄来了一批…呃，我忘记叫什么了…总之是一批特殊的地垫吧…"
                                },
                                {
                                    "id": "691240218",
                                    "speaker": "雅珂达",
                                    "text": "她让人把地垫铺在我房间里的地板上，说如果以后睡不着，可以直接睡在那些地垫上，这样至少不会着凉。"
                                },
                                {
                                    "id": "691240219",
                                    "speaker": "雅珂达",
                                    "text": "嘿嘿，奈姐对我可好了，不愧是我最尊敬最亲爱，全世界最好最好的老板！"
                                },
                                {
                                    "id": "691240220",
                                    "speaker": "Player",
                                    "text": "那我也给你换张床吧。"
                                },
                                {
                                    "id": "691240221",
                                    "speaker": "雅珂达",
                                    "text": "没事没事，我现在已经学会如何习惯一张新床了，等我再适应适应就好，不用这么麻烦的。"
                                }
                            ]
                        },
                        {
                            "id": "691240208",
                            "text": "这也能导致失眠？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912403",
            "initDialog": "691240301",
            "dialogues": [
                {
                    "id": "691240301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691240302",
                    "speaker": "雅珂达",
                    "text": "行啊，你想听什么？或者说，你想要我教你什么？"
                },
                {
                    "id": "691240303",
                    "speaker": "雅珂达",
                    "text": "无论是开锁、潜泳、布置陷阱，调配泻药，甚至是…出老千，我都能教你，你就只管说吧。",
                    "choices": [
                        {
                            "id": "691240304",
                            "text": "你都是从哪学来的这些？",
                            "response": [
                                {
                                    "id": "691240306",
                                    "speaker": "雅珂达",
                                    "text": "这就和老板无关了，俗话说「尺有所短，寸有所长」嘛，这些小把戏是我的个人特长。"
                                },
                                {
                                    "id": "691240307",
                                    "speaker": "雅珂达",
                                    "text": "虽然奈姐在大事上确实手眼通天、实力超群、英明神武、深藏不露…"
                                },
                                {
                                    "id": "691240308",
                                    "speaker": "雅珂达",
                                    "text": "但她处理完大事后，留下来的那些小事，我也得好好处理才行。"
                                },
                                {
                                    "id": "691240309",
                                    "speaker": "雅珂达",
                                    "text": "嘿嘿，毕竟每一个厉害老板的背后，都要有一个可靠员工嘛。"
                                },
                                {
                                    "id": "691240310",
                                    "speaker": "雅珂达",
                                    "text": "要是没点特长，还怎么做「秘闻馆」的员工，就连阿舍鲁都会向客人招手，示意他们进来坐呢。"
                                },
                                {
                                    "id": "691240311",
                                    "speaker": "雅珂达",
                                    "text": "不过，这么大一个「秘闻馆」，居然只有我一个员工，也不知道奈姐怎么想的。"
                                },
                                {
                                    "id": "691240312",
                                    "speaker": "雅珂达",
                                    "text": "我最开始来的时候，还以为「秘闻馆」只是看起来没什么人手。"
                                },
                                {
                                    "id": "691240313",
                                    "speaker": "雅珂达",
                                    "text": "实际上，「秘闻馆」里真正厉害的角色都潜伏在黑暗里。"
                                },
                                {
                                    "id": "691240314",
                                    "speaker": "雅珂达",
                                    "text": "只要奈姐打个响指，他们就会唰地一下出现，然后…",
                                    "choices": [
                                        {
                                            "id": "691240315",
                                            "text": "还人人都有帅气称号？",
                                            "response": [
                                                {
                                                    "id": "691240317",
                                                    "speaker": "雅珂达",
                                                    "text": "对对对，你也看过那本轻小说啊！"
                                                },
                                                {
                                                    "id": "691240318",
                                                    "speaker": "雅珂达",
                                                    "text": "可惜，现实里的「秘闻馆」没有这种情节，事实上，确实就只有我一个员工。"
                                                },
                                                {
                                                    "id": "691240319",
                                                    "speaker": "雅珂达",
                                                    "text": "唉，老板啊老板，你就不能多招点人吗？天天就让我一个人出去跑腿，遇见事情太多的时候，你还要自己出面…"
                                                },
                                                {
                                                    "id": "691240320",
                                                    "speaker": "雅珂达",
                                                    "text": "你或许真的不累，但我真的很累…"
                                                },
                                                {
                                                    "id": "691240321",
                                                    "speaker": "雅珂达",
                                                    "text": "#{NICKNAME}，你有兴趣来「秘闻馆」工作吗？你这么厉害，奈姐肯定会…"
                                                },
                                                {
                                                    "id": "691240322",
                                                    "speaker": "雅珂达",
                                                    "text": "喔…不对…"
                                                },
                                                {
                                                    "id": "691240323",
                                                    "speaker": "Player",
                                                    "text": "哪里不对？"
                                                },
                                                {
                                                    "id": "691240324",
                                                    "speaker": "雅珂达",
                                                    "text": "按奈姐的风格，肯定会回答我："
                                                },
                                                {
                                                    "id": "691240325",
                                                    "speaker": "雅珂达",
                                                    "text": "#「与{NICKNAME}结识这么久，{M#他}{F#她}早就是我们『秘闻馆』的合作伙伴了，又何必再邀请一次呢？」",
                                                    "choices": [
                                                        {
                                                            "id": "691240326",
                                                            "text": "你已经很懂奈芙尔了。",
                                                            "response": [
                                                                {
                                                                    "id": "691240328",
                                                                    "speaker": "雅珂达",
                                                                    "text": "总是待在奈姐身边，我听也听会了。但是老板啊——你就再招个人吧，拜托嘛——"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "691240327",
                                                            "text": "很有奈芙尔的风格了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691240316",
                                            "text": "还有战力排行？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691240305",
                            "text": "难道是奈芙尔教的？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912404",
            "initDialog": "691240401",
            "dialogues": [
                {
                    "id": "691240401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691240402",
                    "speaker": "雅珂达",
                    "text": "我可以…摸摸那只叫做「阿圆」的团雀吗？她好大，也好可爱喔！"
                },
                {
                    "id": "691240403",
                    "speaker": "Player",
                    "text": "那你可能要去问问阿圆…"
                },
                {
                    "id": "691240404",
                    "speaker": "雅珂达",
                    "text": "阿圆能听懂我说话吗？哇…我还以为只有菈乌玛那样的人能听懂她说话呢。"
                },
                {
                    "id": "691240405",
                    "speaker": "雅珂达",
                    "text": "那、那阿嘟呢！就是那个偶尔才过来这边的团雀，我是不是也可以直接和他说话？",
                    "choices": [
                        {
                            "id": "691240406",
                            "text": "是吧…",
                            "response": [
                                {
                                    "id": "691240408",
                                    "speaker": "雅珂达",
                                    "text": "喔对，阿圆和阿嘟是壶灵，不是团雀…"
                                },
                                {
                                    "id": "691240409",
                                    "speaker": "雅珂达",
                                    "text": "总之，我回去洗点水果，带去给阿圆吃。"
                                },
                                {
                                    "id": "691240410",
                                    "speaker": "雅珂达",
                                    "text": "我还是第一次和壶灵说话呢，问点什么好呢…"
                                }
                            ]
                        },
                        {
                            "id": "691240407",
                            "text": "他们壶灵很厉害的。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912405",
            "initDialog": "691240501",
            "dialogues": [
                {
                    "id": "691240501",
                    "speaker": "Player",
                    "text": "早啊，雅珂达。"
                },
                {
                    "id": "691240502",
                    "speaker": "雅珂达",
                    "text": "早上…哈…早上好啊，昨天晚上我应该睡了…呃…"
                },
                {
                    "id": "691240503",
                    "speaker": "雅珂达",
                    "text": "…睡了多长时间来着？迷迷糊糊的，完全记不清了。"
                },
                {
                    "id": "691240504",
                    "speaker": "雅珂达",
                    "text": "但那张床真的太软了，我还是好难适应喔…"
                }
            ]
        },
        {
            "talkId": "6912406",
            "initDialog": "691240601",
            "dialogues": [
                {
                    "id": "691240601",
                    "speaker": "Player",
                    "text": "晚安，雅珂达。"
                },
                {
                    "id": "691240602",
                    "speaker": "雅珂达",
                    "text": "晚安，我等一下也去睡啦。唔…今天要不要试试直接睡在床板上呢…"
                }
            ]
        },
        {
            "talkId": "6912410",
            "initDialog": "691241001",
            "dialogues": [
                {
                    "id": "691241001",
                    "speaker": "雅珂达",
                    "text": "好、好熟悉的感觉…"
                },
                {
                    "id": "691241002",
                    "speaker": "雅珂达",
                    "text": "啊！有铁匠铺，可以用这个来修理武器吧，还有我的…"
                },
                {
                    "id": "691241003",
                    "speaker": "雅珂达",
                    "text": "呃，算了算了，我还是不自己折腾了…要是折腾坏了，爱诺又要念叨我…"
                }
            ]
        },
        {
            "talkId": "6912411",
            "initDialog": "691241101",
            "dialogues": [
                {
                    "id": "691241101",
                    "speaker": "雅珂达",
                    "text": "地图，书柜，还有这个标志…"
                },
                {
                    "id": "691241102",
                    "speaker": "雅珂达",
                    "text": "呜哇！怎么这里也有「秘闻馆」啊！"
                },
                {
                    "id": "691241103",
                    "speaker": "雅珂达",
                    "text": "不会是老板要你摆的吧，都到这里了，我还要值班吗——"
                }
            ]
        }
    ]
}