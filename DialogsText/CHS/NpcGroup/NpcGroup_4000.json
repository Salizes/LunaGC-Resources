{
    "groupId": "4000",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "恩忒卡": 13
    },
    "talks": [
        {
            "talkId": "6400001",
            "initDialog": "640000101",
            "dialogues": [
                {
                    "id": "640000101",
                    "speaker": "恩忒卡",
                    "text": "欢迎光临，一杯好的咖啡能让您全天精神充沛。"
                }
            ]
        },
        {
            "talkId": "6400002",
            "initDialog": "640000201",
            "dialogues": [
                {
                    "id": "640000201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "640000202",
                    "speaker": "恩忒卡",
                    "text": "这里是普斯帕咖啡馆，我是这里的代理店长。"
                },
                {
                    "id": "640000203",
                    "speaker": "恩忒卡",
                    "text": "如果您是初来乍到的新客人，不妨告诉我您的口味，这样我便可以为您推荐合适的咖啡了。"
                },
                {
                    "id": "640000204",
                    "speaker": "恩忒卡",
                    "text": "是想要甜一些，还是苦一些？是想要浓一些，还是淡一些？"
                },
                {
                    "id": "640000205",
                    "speaker": "恩忒卡",
                    "text": "无论是何种偏门的喜好，我都可以帮您调制。"
                }
            ]
        },
        {
            "talkId": "6400003",
            "initDialog": "640000301",
            "dialogues": [
                {
                    "id": "640000301",
                    "speaker": "Player",
                    "text": "关于店里的猫…"
                },
                {
                    "id": "640000302",
                    "speaker": "恩忒卡",
                    "text": "啊，您一定是见到了伽塔吧。"
                },
                {
                    "id": "640000303",
                    "speaker": "恩忒卡",
                    "text": "它还不到一岁，是一只好奇心强的小猫咪。每次我用咖啡渣为客人占卜时，它都会凑上来围观。"
                },
                {
                    "id": "640000304",
                    "speaker": "恩忒卡",
                    "text": "如果您愿意的话，可以摸摸伽塔的后脑。它会发出开心的呼呼声，而您也一定会享受到世界上最柔软的触感。"
                }
            ]
        },
        {
            "talkId": "6400004",
            "initDialog": "640000401",
            "dialogues": [
                {
                    "id": "640000401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640000402",
                    "speaker": "恩忒卡",
                    "text": "客人慢走，欢迎再来。"
                }
            ]
        },
        {
            "talkId": "6400005",
            "initDialog": "640000501",
            "dialogues": [
                {
                    "id": "640000501",
                    "speaker": "Player",
                    "text": "有什么吃的？"
                },
                {
                    "id": "640000502",
                    "speaker": "恩忒卡",
                    "text": "客人喜欢甜食吗？本店有一些适合搭配咖啡的甜品，欢迎品尝。"
                }
            ]
        },
        {
            "talkId": "7391901",
            "initDialog": "739190101",
            "dialogues": [
                {
                    "id": "739190101",
                    "speaker": "Player",
                    "text": "好耶，呼呼！"
                },
                {
                    "id": "739190102",
                    "speaker": "恩忒卡",
                    "text": "呵呵，看来您也是爱猫之人。"
                },
                {
                    "id": "739190103",
                    "speaker": "恩忒卡",
                    "text": "那就告诉您一个小技巧吧，比起鱼，伽塔更喜欢禽肉的味道。"
                },
                {
                    "id": "739190104",
                    "speaker": "恩忒卡",
                    "text": "如果它愿意吃您喂的禽肉，那一定会和您成为很好的朋友。"
                }
            ]
        }
    ]
}