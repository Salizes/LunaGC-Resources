{
    "groupId": "2515",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "孙桡": 13
    },
    "talks": [
        {
            "talkId": "6251501",
            "initDialog": "625150101",
            "dialogues": [
                {
                    "id": "625150101",
                    "speaker": "孙桡",
                    "text": "新竹做的船篙好像更顺手…客人要乘竹筏去翘英庄吗？"
                }
            ]
        },
        {
            "talkId": "6251502",
            "initDialog": "625150201",
            "dialogues": [
                {
                    "id": "625150201",
                    "speaker": "Player",
                    "text": "竹子？船篙？"
                },
                {
                    "id": "625150202",
                    "speaker": "孙桡",
                    "text": "制作船篙的竹子，有新竹和老竹之分，关联着艄公的习惯。"
                },
                {
                    "id": "625150203",
                    "speaker": "孙桡",
                    "text": "严格来说，轻策庄的老竹和新竹，只要在正常的时间段砍伐，经过正常的工序处理，强度都差不多。"
                },
                {
                    "id": "625150204",
                    "speaker": "孙桡",
                    "text": "不过，每个艄公的手都不一样，自然也会有不同的选择。"
                },
                {
                    "id": "625150205",
                    "speaker": "孙桡",
                    "text": "教我歌谣的老艄公说，就像同一种茶叶被不同的茶匠加工后，会焕发出不同的风味。"
                },
                {
                    "id": "625150206",
                    "speaker": "孙桡",
                    "text": "惯用新竹船篙和老竹船篙的艄公，行舟时的节奏，哼唱歌谣的音律，也有着各自的独特之处…"
                }
            ]
        },
        {
            "talkId": "6251503",
            "initDialog": "625150301",
            "dialogues": [
                {
                    "id": "625150301",
                    "speaker": "Player",
                    "text": "歌谣？"
                },
                {
                    "id": "625150302",
                    "speaker": "孙桡",
                    "text": "沉玉谷的每位艄公都会在行舟之时哼唱歌谣，歌谣都是老人们教给年轻人的。"
                },
                {
                    "id": "625150303",
                    "speaker": "孙桡",
                    "text": "没人知道这些歌谣是谁在多少年前创作的，它们在潜移默化中刻入了沉玉谷大多居民的记忆中…"
                },
                {
                    "id": "625150304",
                    "speaker": "孙桡",
                    "text": "而令我感触最深的一句是——"
                },
                {
                    "id": "625150305",
                    "speaker": "孙桡",
                    "text": "「…乾阳临坤自相隔，长流涡不转，美玉藏其间…」"
                }
            ]
        },
        {
            "talkId": "6251504",
            "initDialog": "625150401",
            "dialogues": [
                {
                    "id": "625150401",
                    "speaker": "Player",
                    "text": "暂时不用！下次再说！"
                },
                {
                    "id": "625150402",
                    "speaker": "孙桡",
                    "text": "没关系，沉玉谷的河道旁总会有艄公等着你。"
                }
            ]
        },
        {
            "talkId": "6251505",
            "initDialog": "625150501",
            "dialogues": [
                {
                    "id": "625150501",
                    "speaker": "孙桡",
                    "text": "客人，已经到翘英庄了。若是有缘，下次再见。"
                }
            ]
        },
        {
            "talkId": "7112303",
            "initDialog": "711230301",
            "dialogues": [
                {
                    "id": "711230301",
                    "speaker": "Player",
                    "text": "乘坐竹筏前往翘英庄"
                },
                {
                    "id": "711230302",
                    "speaker": "孙桡",
                    "text": "还请坐稳了，我们这就出航。"
                }
            ]
        }
    ]
}