{
    "groupId": "6064",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 8,
        "卡胡那": 22
    },
    "talks": [
        {
            "talkId": "6606401",
            "initDialog": "660640101",
            "dialogues": [
                {
                    "id": "660640101",
                    "speaker": "Player",
                    "text": "找你帮忙的人多吗？"
                },
                {
                    "id": "660640102",
                    "speaker": "卡胡那",
                    "text": "平常也不算少，但战后的寻人委托明显变多了，你知道的…"
                },
                {
                    "id": "660640103",
                    "speaker": "卡胡那",
                    "text": "也不全是坏消息吧，能帮大家找到失散的亲朋好友，看到他们重聚时的兴奋，我也挺开心的。"
                },
                {
                    "id": "660640104",
                    "speaker": "卡胡那",
                    "text": "其他的就…先不提了吧。有些人只是暂时没有消息，没准哪天就回家了呢。"
                }
            ]
        },
        {
            "talkId": "6606405",
            "initDialog": "660640501",
            "dialogues": [
                {
                    "id": "660640501",
                    "speaker": "卡胡那",
                    "text": "你好你好，想找什么？人，还是失物？"
                }
            ]
        },
        {
            "talkId": "6606406",
            "initDialog": "660640601",
            "dialogues": [
                {
                    "id": "660640601",
                    "speaker": "Player",
                    "text": "嗯？"
                },
                {
                    "id": "660640602",
                    "speaker": "卡胡那",
                    "text": "哎呀，原来不是委托人啊，失礼失礼。"
                },
                {
                    "id": "660640603",
                    "speaker": "卡胡那",
                    "text": "因为我认识的人多，所以久而久之，大家在需要找人或者找东西的时候都习惯先来找我。"
                },
                {
                    "id": "660640604",
                    "speaker": "卡胡那",
                    "text": "如果你以后需要雇旅行家，也可以来联系我，我白天基本都在这附近。"
                },
                {
                    "id": "660640605",
                    "speaker": "卡胡那",
                    "text": "不用担心费用，顺手帮忙的事情。"
                }
            ]
        },
        {
            "talkId": "6606407",
            "initDialog": "660640701",
            "dialogues": [
                {
                    "id": "660640701",
                    "speaker": "Player",
                    "text": "谢谢，但还不需要。"
                },
                {
                    "id": "660640702",
                    "speaker": "卡胡那",
                    "text": "没事，那以后再说。"
                }
            ]
        },
        {
            "talkId": "6606408",
            "initDialog": "660640801",
            "dialogues": [
                {
                    "id": "660640801",
                    "speaker": "Player",
                    "text": "旅行家是？"
                },
                {
                    "id": "660640802",
                    "speaker": "卡胡那",
                    "text": "就是一帮喜欢在纳塔四处探索的流泉之众成员啦。"
                },
                {
                    "id": "660640803",
                    "speaker": "卡胡那",
                    "text": "细究起来，其实和冒险家们做的事情差不多，但他们更喜欢自称「旅行家」。"
                },
                {
                    "id": "660640804",
                    "speaker": "卡胡那",
                    "text": "你也知道，纳塔有很多高温地区，我们部族的人借助鳍游龙可以比较自由地在那些地方探索。"
                },
                {
                    "id": "660640805",
                    "speaker": "卡胡那",
                    "text": "所以会有很多其他部族的人或者外国游客，为了行动方便，请「旅行家」领航或者探路。"
                }
            ]
        },
        {
            "talkId": "6606409",
            "initDialog": "660640901",
            "dialogues": [
                {
                    "id": "660640901",
                    "speaker": "卡胡那",
                    "text": "可恶，答应和那小子换夜班简直是上了贼船…"
                }
            ]
        },
        {
            "talkId": "6606410",
            "initDialog": "660641001",
            "dialogues": [
                {
                    "id": "660641001",
                    "speaker": "Player",
                    "text": "关于我在「流泉之众」的声望…"
                },
                {
                    "id": "660641002",
                    "speaker": "卡胡那",
                    "text": "原来是来帮忙的朋友啊，辛苦你了。"
                }
            ]
        },
        {
            "talkId": "6606411",
            "initDialog": "660641101",
            "dialogues": [
                {
                    "id": "660641101",
                    "speaker": "Player",
                    "text": "你好，这里是…"
                },
                {
                    "id": "660641102",
                    "speaker": "卡胡那",
                    "text": "这是「曜石图腾柱」。你可能已经在别的部族见过类似的圣物了，这个呢，就是「流泉之众」的。"
                },
                {
                    "id": "660641103",
                    "speaker": "卡胡那",
                    "text": "在你完成了部族的委托任务后，曜石图腾柱将给你相应的回馈。我先代表「流泉之众」感谢你的帮忙啦。"
                },
                {
                    "id": "660641104",
                    "speaker": "卡胡那",
                    "text": "至于其他的东西，还是去问白天值班的卡拉穆鲁吧！那小子才是第一负责人，可不能让他什么都不干！"
                }
            ]
        },
        {
            "talkId": "6606412",
            "initDialog": "660641201",
            "dialogues": [
                {
                    "id": "660641201",
                    "speaker": "Player",
                    "text": "不能换回来吗？"
                },
                {
                    "id": "660641202",
                    "speaker": "卡胡那",
                    "text": "嗯…换了也没什么区别，不是白天上班就是晚上上班。"
                },
                {
                    "id": "660641203",
                    "speaker": "卡胡那",
                    "text": "这里是很重要的地方，总得有个人看着才行。"
                },
                {
                    "id": "660641204",
                    "speaker": "卡胡那",
                    "text": "虽然很想给卡拉穆鲁一个头槌，但我是比他更有责任心的人啊！"
                }
            ]
        },
        {
            "talkId": "6606413",
            "initDialog": "660641301",
            "dialogues": [
                {
                    "id": "660641301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "660641302",
                    "speaker": "卡胡那",
                    "text": "哦没关系，是我自己的事情，请不用在意。"
                }
            ]
        }
    ]
}