    "talks": [
        {
            "talkId": "4001225",
            "initDialog": "400122501",
            "dialogues": [
                {
                    "id": "400122501",
                    "speaker": "琴",
                    "text": "夜晚的海面真漂亮…",
                    "choices": [
                        {
                            "id": "400122502",
                            "text": "要不要聊聊天？",
                            "response": [
                                {
                                    "id": "400122503",
                                    "speaker": "琴",
                                    "text": "好啊，旅行者，你想聊些什么？",
                                    "choices": [
                                        {
                                            "id": "400122504",
                                            "text": "关于骑士团的工作…",
                                            "response": [
                                                {
                                                    "id": "400122505",
                                                    "speaker": "琴",
                                                    "text": "工作的话，有丽莎在就没问题。她认真起来比谁都尽责尽力。"
                                                },
                                                {
                                                    "id": "400122506",
                                                    "speaker": "琴",
                                                    "text": "不过，这次给她添了不少麻烦，我总有些过意不去…"
                                                },
                                                {
                                                    "id": "400122507",
                                                    "speaker": "琴",
                                                    "text": "嗯，果然还是应该送些礼物给她。幸好，丽莎的喜好我还是很了解的。",
                                                    "choices": [
                                                        {
                                                            "id": "400122504",
                                                            "text": "关于骑士团的工作…"
                                                        },
                                                        {
                                                            "id": "400122508",
                                                            "text": "关于海岛…",
                                                            "response": [
                                                                {
                                                                    "id": "400122509",
                                                                    "speaker": "琴",
                                                                    "text": "我是第一次来到这样的岛屿。这一带给我的感觉十分奇特…明明存在着未知与危险，却因为神秘而显得美丽。"
                                                                },
                                                                {
                                                                    "id": "400122510",
                                                                    "speaker": "琴",
                                                                    "text": "那是种难以言说的魔力。来到这里以后，我逐渐理解那些追求未知之地的冒险家们了。"
                                                                },
                                                                {
                                                                    "id": "400122511",
                                                                    "speaker": "琴",
                                                                    "text": "旅行者，你也是冒险家，一定能明白此刻我的心情吧？"
                                                                },
                                                                {
                                                                    "id": "400122512",
                                                                    "speaker": "琴",
                                                                    "text": "当然了，无论如何都请注意安全。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "400122504",
                                                                            "text": "关于骑士团的工作…"
                                                                        },
                                                                        {
                                                                            "id": "400122508",
                                                                            "text": "关于海岛…"
                                                                        },
                                                                        {
                                                                            "id": "400122513",
                                                                            "text": "关于琴自己…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "400122514",
                                                                                    "speaker": "琴",
                                                                                    "text": "其实，我刚刚发现…我好像有些…缺乏娱乐精神？"
                                                                                },
                                                                                {
                                                                                    "id": "400122515",
                                                                                    "speaker": "琴",
                                                                                    "text": "抱歉，我不知道该怎么说…旅行者，我想问你一个问题。"
                                                                                },
                                                                                {
                                                                                    "id": "400122516",
                                                                                    "speaker": "Player",
                                                                                    "text": "好的。"
                                                                                },
                                                                                {
                                                                                    "id": "400122517",
                                                                                    "speaker": "琴",
                                                                                    "text": "我这个人，是不是太严肃了？"
                                                                                },
                                                                                {
                                                                                    "id": "400122518",
                                                                                    "speaker": "琴",
                                                                                    "text": "所以大家才会希望我多休息、多放松吧…实在是非常抱歉。"
                                                                                },
                                                                                {
                                                                                    "id": "400122519",
                                                                                    "speaker": "Player",
                                                                                    "text": "不，琴就是这点最可爱。"
                                                                                },
                                                                                {
                                                                                    "id": "400122520",
                                                                                    "speaker": "琴",
                                                                                    "text": "哎？我…我这样的性格也能被称为可爱吗…"
                                                                                },
                                                                                {
                                                                                    "id": "400122521",
                                                                                    "speaker": "琴",
                                                                                    "text": "谢谢你总是用温柔的话安慰我，旅行者。"
                                                                                },
                                                                                {
                                                                                    "id": "400122522",
                                                                                    "speaker": "琴",
                                                                                    "text": "不管怎么说，大家的意思我明白了。我会努力调整自己。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "400122504",
                                                                                            "text": "关于骑士团的工作…"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122508",
                                                                                            "text": "关于海岛…"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122513",
                                                                                            "text": "关于琴自己…"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122523",
                                                                                            "text": "关于今天发生的事…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "400122524",
                                                                                                    "speaker": "琴",
                                                                                                    "text": "确实没想到大家都到这里来了…"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122525",
                                                                                                    "speaker": "琴",
                                                                                                    "text": "我不知道这样想是否正确，但…我觉得可莉会很开心。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122526",
                                                                                                    "speaker": "琴",
                                                                                                    "text": "她喜欢热闹，乐意与人交往。玩乐的事就交给她了，我来负责大家的安全。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122527",
                                                                                                    "speaker": "琴",
                                                                                                    "text": "呼…景色真美啊。但愿每个人都能在大海的陪伴下寻得快乐与平静。",
                                                                                                    "choices": [
                                                                                                        {
                                                                                                            "id": "400122504",
                                                                                                            "text": "关于骑士团的工作…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122508",
                                                                                                            "text": "关于海岛…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122513",
                                                                                                            "text": "关于琴自己…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122523",
                                                                                                            "text": "关于今天发生的事…"
                                                                                                        },
                                                                                                        {
                                                                                                            "id": "400122528",
                                                                                                            "text": "先不打扰你了。",
                                                                                                            "response": [
                                                                                                                {
                                                                                                                    "id": "400122529",
                                                                                                                    "speaker": "琴",
                                                                                                                    "text": "好的，晚安。"
                                                                                                                }
                                                                                                            ]
                                                                                                        }
                                                                                                    ]
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "400122528",
                                                                                            "text": "先不打扰你了。"
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "400122523",
                                                                            "text": "关于今天发生的事…"
                                                                        },
                                                                        {
                                                                            "id": "400122528",
                                                                            "text": "先不打扰你了。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "400122513",
                                                            "text": "关于琴自己…"
                                                        },
                                                        {
                                                            "id": "400122523",
                                                            "text": "关于今天发生的事…"
                                                        },
                                                        {
                                                            "id": "400122528",
                                                            "text": "先不打扰你了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400122508",
                                            "text": "关于海岛…"
                                        },
                                        {
                                            "id": "400122513",
                                            "text": "关于琴自己…"
                                        },
                                        {
                                            "id": "400122523",
                                            "text": "关于今天发生的事…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400122528",
                            "text": "先不打扰你了。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4001309",
            "initDialog": "400130901",
            "dialogues": [
                {
                    "id": "400130901",
                    "speaker": "琴",
                    "text": "没想到这里的一切都是艾莉丝女士的布置。"
                },
                {
                    "id": "400130902",
                    "speaker": "琴",
                    "text": "知道真相之后…似乎连周围的景色也变得可爱了呢。"
                },
                {
                    "id": "400130903",
                    "speaker": "琴",
                    "text": "如此美妙的夏天，真是再好不过的礼物了。"
                },
                {
                    "id": "400130904",
                    "speaker": "琴",
                    "text": "啊！说起来，我也该兑现诺言陪可莉炸鱼了。"
                },
                {
                    "id": "400130905",
                    "speaker": "琴",
                    "text": "旅行者，你愿意参加我们的小小娱乐活动吗？"
                }
            ]
        }
    ]
}