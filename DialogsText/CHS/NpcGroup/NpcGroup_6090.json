    "total_dialogue_lines": 11,
    "speaker_counts": {
        "伊涅芙": 1,
        "塔诺": 4,
        "波蒂莉": 6
    },
    "talks": [
        {
            "talkId": "600673",
            "initDialog": "60067301",
            "dialogues": [
                {
                    "id": "60067301",
                    "speaker": "波蒂莉",
                    "text": "刚才在大舞台上充满震感和力量感的动作…简直闻所未闻！太强了！能不能再表演一遍？"
                },
                {
                    "id": "60067302",
                    "speaker": "伊涅芙",
                    "text": "关节冷却中…请稍后再试…"
                },
                {
                    "id": "60067303",
                    "speaker": "塔诺",
                    "text": "这难道…就是传说中的「机械舞」？"
                }
            ]
        },
        {
            "talkId": "6608901",
            "initDialog": "660890101",
            "dialogues": [
                {
                    "id": "660890101",
                    "speaker": "塔诺",
                    "text": "这个音色，听起来真不错。那位老兄搓碟的手法是不是越来越娴熟了？"
                },
                {
                    "id": "660890102",
                    "speaker": "波蒂莉",
                    "text": "他的技术一直不错，但这次要归功于新唱片的压制工艺。"
                },
                {
                    "id": "660890103",
                    "speaker": "塔诺",
                    "text": "哦哦，是我们上次聊过的，液态燃素的新用法吗？已经实现了？"
                },
                {
                    "id": "660890104",
                    "speaker": "波蒂莉",
                    "text": "当然，小看我？"
                },
                {
                    "id": "660890105",
                    "speaker": "塔诺",
                    "text": "哪有，这是为你高兴啊。"
                },
                {
                    "id": "660890106",
                    "speaker": "波蒂莉",
                    "text": "还在试验阶段啦。我这不是在一边看演出，一边收集反馈嘛。"
                },
                {
                    "id": "660890107",
                    "speaker": "波蒂莉",
                    "text": "嗯…碟片在回拉的时候，速度不是很好把控啊…"
                },
                {
                    "id": "660890108",
                    "speaker": "波蒂莉",
                    "text": "看来还有改进空间。"
                }
            ]
        }
    ]
}