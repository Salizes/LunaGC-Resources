{
    "groupId": "4125",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "娜斯米儿": 15
    },
    "talks": [
        {
            "talkId": "6412501",
            "initDialog": "641250101",
            "dialogues": [
                {
                    "id": "641250101",
                    "speaker": "娜斯米儿",
                    "text": "今天店里新到了美酒，客人要来一杯吗？"
                }
            ]
        },
        {
            "talkId": "6412502",
            "initDialog": "641250201",
            "dialogues": [
                {
                    "id": "641250201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "641250202",
                    "speaker": "娜斯米儿",
                    "text": "这里是迪亚法饭店，也是奥摩斯港最棒的酒馆！无论什么好酒，老板都能搞到！"
                },
                {
                    "id": "641250203",
                    "speaker": "娜斯米儿",
                    "text": "所以附近的商人、游客、水手…还有我以前在镀金旅团的老朋友们，都经常来这里大喝特喝。"
                },
                {
                    "id": "641250204",
                    "speaker": "娜斯米儿",
                    "text": "当然除了酒以外，下酒菜也都很美味。我个人觉得，就算不配酒，直接当正餐来吃也可以哦！"
                }
            ]
        },
        {
            "talkId": "6412503",
            "initDialog": "641250301",
            "dialogues": [
                {
                    "id": "641250301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641250302",
                    "speaker": "娜斯米儿",
                    "text": "客人慢走，下次再来哦！"
                }
            ]
        },
        {
            "talkId": "6412504",
            "initDialog": "641250401",
            "dialogues": [
                {
                    "id": "641250401",
                    "speaker": "Player",
                    "text": "镀金旅团的老朋友？"
                },
                {
                    "id": "641250402",
                    "speaker": "娜斯米儿",
                    "text": "嘿嘿，不好意思，我看起来不像是曾经在镀金旅团待过的人吧？"
                },
                {
                    "id": "641250403",
                    "speaker": "娜斯米儿",
                    "text": "但我确实是哦——货真价实的前·镀金旅团佣兵！一拳揍飞海兽的那种！"
                },
                {
                    "id": "641250404",
                    "speaker": "娜斯米儿",
                    "text": "哈哈，玩笑玩笑。揍飞海兽是困难了些，但拖走几个酒鬼还是小菜一碟。"
                },
                {
                    "id": "641250405",
                    "speaker": "娜斯米儿",
                    "text": "而且就算出现了我搞不定的情况，也有美丽又动人、温柔又强大…的罗莎娜姐姐在呢。"
                },
                {
                    "id": "641250406",
                    "speaker": "娜斯米儿",
                    "text": "谁要是惹怒了她，一定不会有好下场。"
                }
            ]
        },
        {
            "talkId": "7390901",
            "initDialog": "739090101",
            "dialogues": [
                {
                    "id": "739090101",
                    "speaker": "Player",
                    "text": "美丽…温柔…"
                },
                {
                    "id": "739090102",
                    "speaker": "娜斯米儿",
                    "text": "嘘，小声点！可别让她听见了。"
                },
                {
                    "id": "739090103",
                    "speaker": "娜斯米儿",
                    "text": "每次我一说这些话，她就嫌我啰嗦，然后一整天不理我，我可不要。"
                },
                {
                    "id": "739090104",
                    "speaker": "娜斯米儿",
                    "text": "实不相瞒，我就是因为罗莎娜姐姐才离开镀金旅团来这里工作的。"
                },
                {
                    "id": "739090105",
                    "speaker": "娜斯米儿",
                    "text": "罗莎娜姐姐果然英明决断。在这里工作，确实比接教令院的委托自由多了！"
                },
                {
                    "id": "739090106",
                    "speaker": "娜斯米儿",
                    "text": "咳咳…这些话你都不许跟她讲哦。给你做点好吃的，当作封口费！"
                }
            ]
        }
    ]
}