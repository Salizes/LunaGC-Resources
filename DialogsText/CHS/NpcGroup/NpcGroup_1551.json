{
    "groupId": "1551",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "怀尔德": 12
    },
    "talks": [
        {
            "talkId": "6155101",
            "initDialog": "615510101",
            "dialogues": [
                {
                    "id": "615510101",
                    "speaker": "怀尔德",
                    "text": "请、请问你捡到了一个钱袋吗？"
                }
            ]
        },
        {
            "talkId": "6155102",
            "initDialog": "615510201",
            "dialogues": [
                {
                    "id": "615510201",
                    "speaker": "Player",
                    "text": "钱袋？"
                },
                {
                    "id": "615510202",
                    "speaker": "怀尔德",
                    "text": "一个麻布做的袋子，里面大概有1000摩拉。"
                },
                {
                    "id": "615510203",
                    "speaker": "怀尔德",
                    "text": "都是刚刚结的工钱，得带回去上交给老婆的。"
                },
                {
                    "id": "615510204",
                    "speaker": "怀尔德",
                    "text": "如果找不到就麻烦了…"
                }
            ]
        },
        {
            "talkId": "6155103",
            "initDialog": "615510301",
            "dialogues": [
                {
                    "id": "615510301",
                    "speaker": "Player",
                    "text": "记得丢在哪里了吗？"
                },
                {
                    "id": "615510302",
                    "speaker": "怀尔德",
                    "text": "老实说，完全没有印象…只知道半夜路过了这里。"
                },
                {
                    "id": "615510303",
                    "speaker": "怀尔德",
                    "text": "那天发了工钱很开心，就去喝了几杯，醉醺醺地回到家里，第二天醒来就发现钱袋不见了。"
                },
                {
                    "id": "615510304",
                    "speaker": "怀尔德",
                    "text": "肯定很难找回来吧。钱袋丢了本身没什么，更恐怖的是…咿呀——！"
                },
                {
                    "id": "615510305",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "615510306",
                    "speaker": "怀尔德",
                    "text": "想起我老婆生气的样子我就打了个寒颤…"
                },
                {
                    "id": "615510307",
                    "speaker": "怀尔德",
                    "text": "她肯定会觉得我把钱拿去给小情人买礼物了！"
                },
                {
                    "id": "615510308",
                    "speaker": "怀尔德",
                    "text": "根本不可能啊，我每期工钱都老实上交，想找小情人也没有摩拉啊……"
                },
                {
                    "id": "615510309",
                    "speaker": "怀尔德",
                    "text": "怎么办，怎么办，我不想罚跪，也不想被揪耳朵啊…"
                }
            ]
        },
        {
            "talkId": "6155104",
            "initDialog": "615510401",
            "dialogues": [
                {
                    "id": "615510401",
                    "speaker": "Player",
                    "text": "再见…祝你好运。"
                },
                {
                    "id": "615510402",
                    "speaker": "怀尔德",
                    "text": "拜托你了，如果你之后看到了请还给我，我会酬谢你的！"
                }
            ]
        }
    ]
}