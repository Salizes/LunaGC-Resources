{
    "groupId": "7886",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "里亚布夫": 12
    },
    "talks": [
        {
            "talkId": "6788601",
            "initDialog": "678860101",
            "dialogues": [
                {
                    "id": "678860101",
                    "speaker": "里亚布夫",
                    "text": "至冬特色，百年古法，妖精酿造，都来瞧一瞧——"
                }
            ]
        },
        {
            "talkId": "6788602",
            "initDialog": "678860201",
            "dialogues": [
                {
                    "id": "678860201",
                    "speaker": "Player",
                    "text": "这里都卖些什么？"
                },
                {
                    "id": "678860202",
                    "speaker": "里亚布夫",
                    "text": "当然是咱们至冬最有名、最不容错过的特产，喝了让人热乎乎的好酒！"
                },
                {
                    "id": "678860203",
                    "speaker": "里亚布夫",
                    "text": "最重要的是，我这里的酒啊，用的是妖精酿酒世家传承百年的独门古法。"
                },
                {
                    "id": "678860204",
                    "speaker": "里亚布夫",
                    "text": "由百岁妖精酿酒师亲手拣选原料、发酵、蒸馏，调配…"
                },
                {
                    "id": "678860205",
                    "speaker": "里亚布夫",
                    "text": "价格虽然稍有些贵，却别有岁月沉淀之味，您在至冬其他地方买不到。怎么样，试一试？"
                }
            ]
        },
        {
            "talkId": "6788603",
            "initDialog": "678860301",
            "dialogues": [
                {
                    "id": "678860301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "678860302",
                    "speaker": "里亚布夫",
                    "text": "再见，下次再来！"
                }
            ]
        },
        {
            "talkId": "6788604",
            "initDialog": "678860401",
            "dialogues": [
                {
                    "id": "678860401",
                    "speaker": "Player",
                    "text": "百年传承？妖精本就能活几百年吧。"
                },
                {
                    "id": "678860402",
                    "speaker": "里亚布夫",
                    "text": "哦…您竟然知道，见笑、见笑。我还以为您是没来过至冬、对妖精毫无了解的游客呢。"
                },
                {
                    "id": "678860403",
                    "speaker": "里亚布夫",
                    "text": "唉，这年头生意难做。从前我正常叫卖，但好多外国游客第一次来至冬，看我不是人类，都不敢来买酒。"
                },
                {
                    "id": "678860404",
                    "speaker": "里亚布夫",
                    "text": "没办法，为了生计，我只能另辟蹊径…谁成想，这么叫卖，反倒真的吸引了不少顾客。"
                },
                {
                    "id": "678860405",
                    "speaker": "里亚布夫",
                    "text": "反正我早过了百岁，说这酒是百年古法酿造，也算不上说谎，您说对吧？"
                },
                {
                    "id": "678860406",
                    "speaker": "里亚布夫",
                    "text": "您是懂行的人，我敬您三分。下次来我这里买酒，我多送您一杯！"
                }
            ]
        },
        {
            "talkId": "6788605",
            "initDialog": "678860501",
            "dialogues": [
                {
                    "id": "678860501",
                    "speaker": "Player",
                    "text": "不了。"
                },
                {
                    "id": "678860502",
                    "speaker": "里亚布夫",
                    "text": "哎呀，真可惜。"
                }
            ]
        }
    ]
}