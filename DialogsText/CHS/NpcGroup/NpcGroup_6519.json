            "dialogues": [
                {
                    "id": "665190301",
                    "speaker": "赫马基",
                    "text": "年轻人，要来试试一下冲浪吗？老头子像你这么年轻的时候，能挑战一百米高的巨浪！"
                },
                {
                    "id": "665190303",
                    "speaker": "赫马基",
                    "text": "有兴趣的话，在旁边就可以开始了。"
                }
            ]
        },
        {
            "talkId": "6651904",
            "initDialog": "665190401",
            "dialogues": [
                {
                    "id": "665190401",
                    "speaker": "赫马基",
                    "text": "年轻人，你的冲浪天赋很不错啊，有没有兴趣以后把老头子的事业接过去？"
                },
                {
                    "id": "665190402",
                    "speaker": "Player",
                    "text": "谢谢，我还有事。"
                },
                {
                    "id": "665190403",
                    "speaker": "赫马基",
                    "text": "哦，好，要是改变主意了可以回来找我。"
                }
            ]
        }
    ]
