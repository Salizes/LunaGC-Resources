{
    "groupId": "4001",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "乃亚卜": 13
    },
    "talks": [
        {
            "talkId": "6400101",
            "initDialog": "640010101",
            "dialogues": [
                {
                    "id": "640010101",
                    "speaker": "乃亚卜",
                    "text": "一定…一定要赢一次。"
                }
            ]
        },
        {
            "talkId": "6400102",
            "initDialog": "640010201",
            "dialogues": [
                {
                    "id": "640010201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640010202",
                    "speaker": "乃亚卜",
                    "text": "如果是说职业的话，我是教令院的风纪官。不过你不用紧张，现在并非我的工作时间。"
                },
                {
                    "id": "640010203",
                    "speaker": "乃亚卜",
                    "text": "在大风纪官大人的严格监督下，教令院的违法知识传播与学术腐败现象大大减少。托赛诺大人的福，我们下属的假期也变多了。"
                },
                {
                    "id": "640010204",
                    "speaker": "乃亚卜",
                    "text": "这个咖啡馆里虽然经常有学生聚餐，但大部分都只是闲聊罢了。"
                },
                {
                    "id": "640010205",
                    "speaker": "乃亚卜",
                    "text": "风纪官虽然要管很多事情，但并不负责收集学生们对导师的评价与意见。"
                },
                {
                    "id": "640010206",
                    "speaker": "乃亚卜",
                    "text": "所以现在，我只是一个一边享受咖啡，一边研究打牌技巧的普通须弥人罢了。"
                }
            ]
        },
        {
            "talkId": "6400103",
            "initDialog": "640010301",
            "dialogues": [
                {
                    "id": "640010301",
                    "speaker": "Player",
                    "text": "赢什么？"
                },
                {
                    "id": "640010302",
                    "speaker": "乃亚卜",
                    "text": "你不知道吗？当然是全须弥——甚至全提瓦特都在为之痴狂的《七圣召唤》啊！"
                },
                {
                    "id": "640010303",
                    "speaker": "乃亚卜",
                    "text": "多变的牌组，莫测的局势…这一切，都令人欲罢不能。"
                },
                {
                    "id": "640010304",
                    "speaker": "乃亚卜",
                    "text": "所以不知不觉之间，全部的假期不是用来打牌，就是用来思考怎么打牌了。"
                }
            ]
        },
        {
            "talkId": "6400104",
            "initDialog": "640010401",
            "dialogues": [
                {
                    "id": "640010401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640010402",
                    "speaker": "乃亚卜",
                    "text": "再见，我已经有想法了…"
                }
            ]
        },
        {
            "talkId": "7392001",
            "initDialog": "739200101",
            "dialogues": [
                {
                    "id": "739200101",
                    "speaker": "Player",
                    "text": "有趣。"
                },
                {
                    "id": "739200102",
                    "speaker": "乃亚卜",
                    "text": "你也这么认为？那可一定要常来普斯帕咖啡馆啊，这里可是天天都有人打得热火朝天呢！"
                },
                {
                    "id": "739200103",
                    "speaker": "乃亚卜",
                    "text": "——当然，我是说打《七圣召唤》。如果有人在这打架，在我动手之前，代理店长就会先发飙的。"
                },
                {
                    "id": "739200104",
                    "speaker": "乃亚卜",
                    "text": "话说，你有空吗？我跟你说说我新开发的牌组和一直以来积累的经验，你也帮我一起想想如何用这个牌组稳赢吧？"
                }
            ]
        }
    ]
}