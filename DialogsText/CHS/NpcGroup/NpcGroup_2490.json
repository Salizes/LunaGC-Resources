{
    "groupId": "2490",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "洪分": 13
    },
    "talks": [
        {
            "talkId": "6249001",
            "initDialog": "624900101",
            "dialogues": [
                {
                    "id": "624900101",
                    "speaker": "洪分",
                    "text": "两箱茶叶，然后又是好几箱玉器和杂货？最近的生意还不错啊…"
                }
            ]
        },
        {
            "talkId": "6249002",
            "initDialog": "624900201",
            "dialogues": [
                {
                    "id": "624900201",
                    "speaker": "Player",
                    "text": "你是商人吗？"
                },
                {
                    "id": "624900202",
                    "speaker": "洪分",
                    "text": "少侠说笑了，我只是个搬货的工人，偶尔接几单镖师的工作。"
                },
                {
                    "id": "624900203",
                    "speaker": "洪分",
                    "text": "经商这种事太复杂，我做不来。比起心神受累，我宁愿选择身体的劳累。"
                }
            ]
        },
        {
            "talkId": "6249003",
            "initDialog": "624900301",
            "dialogues": [
                {
                    "id": "624900301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624900302",
                    "speaker": "洪分",
                    "text": "再见，下次等我搬完茶叶再聊！"
                }
            ]
        },
        {
            "talkId": "6249004",
            "initDialog": "624900401",
            "dialogues": [
                {
                    "id": "624900401",
                    "speaker": "Player",
                    "text": "镖师还能兼职？"
                },
                {
                    "id": "624900402",
                    "speaker": "洪分",
                    "text": "咳咳，毕竟我刚入行不久，又是自学的武艺，很难接到单，完全不像「剑匣镖局」的那些高手…"
                },
                {
                    "id": "624900403",
                    "speaker": "洪分",
                    "text": "所以，我只能先干干搬货这种简单的工作，攒他个三五年的钱。"
                },
                {
                    "id": "624900404",
                    "speaker": "洪分",
                    "text": "等到手头的摩拉够了，我再报个班，好好习武，把拳脚功夫练扎实点。"
                },
                {
                    "id": "624900405",
                    "speaker": "洪分",
                    "text": "到时再专职跑镖，就不怕被玄文兽一口吃掉了…"
                }
            ]
        },
        {
            "talkId": "6249005",
            "initDialog": "624900501",
            "dialogues": [
                {
                    "id": "624900501",
                    "speaker": "Player",
                    "text": "玄文兽有这么可怕吗？"
                },
                {
                    "id": "624900502",
                    "speaker": "洪分",
                    "text": "我可是亲眼所见，这位少侠千万别大意了！"
                },
                {
                    "id": "624900503",
                    "speaker": "洪分",
                    "text": "玄文兽几乎刀枪不入，之前有位前辈用上好的「铁尖枪」对付它…"
                },
                {
                    "id": "624900504",
                    "speaker": "洪分",
                    "text": "结果狠狠刺了好几枪，像是在给它挠痒。"
                },
                {
                    "id": "624900505",
                    "speaker": "洪分",
                    "text": "要是换我上阵，只怕半个回合都招架不住，就成了它的腹中餐！"
                },
                {
                    "id": "624900506",
                    "speaker": "洪分",
                    "text": "少侠要是见到了那些凶兽，还是绕着走为妙！"
                }
            ]
        }
    ]
}