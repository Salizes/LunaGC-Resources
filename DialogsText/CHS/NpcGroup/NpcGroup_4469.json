{
    "groupId": "4469",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "扎娅": 18
    },
    "talks": [
        {
            "talkId": "6446901",
            "initDialog": "644690101",
            "dialogues": [
                {
                    "id": "644690101",
                    "speaker": "扎娅",
                    "text": "不错，不错，这是个好商机…俗话说，没有商机就要创造商机。"
                }
            ]
        },
        {
            "talkId": "6446902",
            "initDialog": "644690201",
            "dialogues": [
                {
                    "id": "644690201",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "644690202",
                    "speaker": "扎娅",
                    "text": "嗯哼？我叫扎娅，来自大名鼎鼎的桑歌玛哈巴依商会。"
                },
                {
                    "id": "644690203",
                    "speaker": "扎娅",
                    "text": "我正在奉「桑歌玛哈巴依老爷」之命，来开拓新商机。"
                },
                {
                    "id": "644690204",
                    "speaker": "扎娅",
                    "text": "一切为了摩拉，即使做奸商也在所不辞…"
                },
                {
                    "id": "644690205",
                    "speaker": "扎娅",
                    "text": "唔…当然！明面上当然还是遵守拜达港的规则，这地方的港务官抓走私抓得可严了…"
                },
                {
                    "id": "644690206",
                    "speaker": "扎娅",
                    "text": "跟璃月人做点简单的美食生意总可以吧！"
                }
            ]
        },
        {
            "talkId": "6446903",
            "initDialog": "644690301",
            "dialogues": [
                {
                    "id": "644690301",
                    "speaker": "Player",
                    "text": "什么商机？"
                },
                {
                    "id": "644690302",
                    "speaker": "扎娅",
                    "text": "拜达港和枫丹太近了，大家对枫丹的新鲜玩意已经见怪不怪了。"
                },
                {
                    "id": "644690303",
                    "speaker": "扎娅",
                    "text": "可他们对璃月还知之甚少啊！"
                },
                {
                    "id": "644690304",
                    "speaker": "扎娅",
                    "text": "商人的嗅觉不会出错，嗯，如果把璃月美食引进拜达港，比如…"
                }
            ]
        },
        {
            "talkId": "6446904",
            "initDialog": "644690401",
            "dialogues": [
                {
                    "id": "644690401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "644690402",
                    "speaker": "扎娅",
                    "text": "哇！竟然对商机不感兴趣，可惜…"
                }
            ]
        },
        {
            "talkId": "6446905",
            "initDialog": "644690501",
            "dialogues": [
                {
                    "id": "644690501",
                    "speaker": "Player",
                    "text": "茶叶？"
                },
                {
                    "id": "644690502",
                    "speaker": "扎娅",
                    "text": "你怎么知道？那个叫博言的璃月商人告诉我，沉玉谷的茶叶最出名。"
                },
                {
                    "id": "644690503",
                    "speaker": "扎娅",
                    "text": "嗯，把「沉玉仙茗」推销给桑歌玛哈巴依商会的那位大客户，他一定会心动的，最少也要订购十箱…"
                }
            ]
        },
        {
            "talkId": "6446906",
            "initDialog": "644690601",
            "dialogues": [
                {
                    "id": "644690601",
                    "speaker": "Player",
                    "text": "比如…"
                },
                {
                    "id": "644690602",
                    "speaker": "扎娅",
                    "text": "吃虎鱼，腌笃鲜，蟹黄豆腐…都是须弥难得一见的美食。"
                }
            ]
        },
        {
            "talkId": "6446907",
            "initDialog": "644690701",
            "dialogues": [
                {
                    "id": "644690701",
                    "speaker": "Player",
                    "text": "这些你都吃过吗？"
                },
                {
                    "id": "644690702",
                    "speaker": "扎娅",
                    "text": "都在我的待品尝名单里。"
                },
                {
                    "id": "644690703",
                    "speaker": "扎娅",
                    "text": "上次博言那家伙说「沉玉仙茗」滋味上佳，忽悠我进了一大批货，全砸在手里，气死我了。"
                },
                {
                    "id": "644690704",
                    "speaker": "扎娅",
                    "text": "他又说，只是那一批茶叶有问题，现在水土治理好了，茶叶的品质也回来了。"
                },
                {
                    "id": "644690705",
                    "speaker": "扎娅",
                    "text": "谁知道他的话是真是假？上过的当，吃过的亏，我扎娅才不会跌倒第二次。"
                },
                {
                    "id": "644690706",
                    "speaker": "扎娅",
                    "text": "我要亲自去璃月走走，用我的舌头把美味带回来。"
                }
            ]
        }
    ]
}