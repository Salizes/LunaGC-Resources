{
    "groupId": "5083",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "洛耶茨": 13
    },
    "talks": [
        {
            "talkId": "6508301",
            "initDialog": "650830101",
            "dialogues": [
                {
                    "id": "650830101",
                    "speaker": "洛耶茨",
                    "text": "工作上的事情，无过就是功。"
                }
            ]
        },
        {
            "talkId": "6508302",
            "initDialog": "650830201",
            "dialogues": [
                {
                    "id": "650830201",
                    "speaker": "Player",
                    "text": "一切都还好吗？"
                },
                {
                    "id": "650830202",
                    "speaker": "洛耶茨",
                    "text": "托您的福，除了「自动盖章机」那边时不时有些响动，其他都不错。"
                },
                {
                    "id": "650830203",
                    "speaker": "洛耶茨",
                    "text": "塞勒先生不在的时候，那个机器反而安静许多，像被主人拴在咖啡店前的小狗一样。"
                },
                {
                    "id": "650830204",
                    "speaker": "洛耶茨",
                    "text": "你看，就连最有精神的小动物也都知道适度休息才能保证第二天跑得更远，对吧？"
                }
            ]
        },
        {
            "talkId": "6508303",
            "initDialog": "650830301",
            "dialogues": [
                {
                    "id": "650830301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650830302",
                    "speaker": "洛耶茨",
                    "text": "请慢走。"
                }
            ]
        },
        {
            "talkId": "6508304",
            "initDialog": "650830401",
            "dialogues": [
                {
                    "id": "650830401",
                    "speaker": "洛耶茨",
                    "text": "年轻人来了之后白天总是那么热闹，更显得晚上清净了。"
                }
            ]
        },
        {
            "talkId": "6508305",
            "initDialog": "650830501",
            "dialogues": [
                {
                    "id": "650830501",
                    "speaker": "Player",
                    "text": "晚上好。"
                },
                {
                    "id": "650830502",
                    "speaker": "洛耶茨",
                    "text": "晚上好，旅行者。看你的样子，又是忙碌的一天？就像艾尤恩先生一样。"
                },
                {
                    "id": "650830503",
                    "speaker": "洛耶茨",
                    "text": "不过你看起来比他开朗多了。"
                },
                {
                    "id": "650830504",
                    "speaker": "洛耶茨",
                    "text": "他疲惫的原因在于太热情，这在年轻人身上很常见，需要一定的时间去调整。"
                },
                {
                    "id": "650830505",
                    "speaker": "洛耶茨",
                    "text": "我和瑟米安先生会看好他的，放心吧。"
                }
            ]
        },
        {
            "talkId": "6508306",
            "initDialog": "650830601",
            "dialogues": [
                {
                    "id": "650830601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650830602",
                    "speaker": "洛耶茨",
                    "text": "再见啦，明天又是美好的一天。"
                }
            ]
        },
        {
            "talkId": "7491901",
            "initDialog": "749190101",
            "dialogues": [
                {
                    "id": "749190101",
                    "speaker": "Player",
                    "text": "「劳逸结合」，我懂。"
                },
                {
                    "id": "749190102",
                    "speaker": "洛耶茨",
                    "text": "说得好，这句话可以当成座右铭了。"
                },
                {
                    "id": "749190103",
                    "speaker": "洛耶茨",
                    "text": "正好柯妮莉娅小姐刚刚拿了茶歇的点心来，请取一些走吧，不用客气。"
                }
            ]
        }
    ]
}