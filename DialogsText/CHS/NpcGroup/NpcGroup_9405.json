{
    "groupId": "9405",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "杜林": 9
    },
    "talks": [
        {
            "talkId": "6940501",
            "initDialog": "694050101",
            "dialogues": [
                {
                    "id": "694050101",
                    "speaker": "杜林",
                    "text": "我的话，会建议选一个靠墙的地方休息。"
                },
                {
                    "id": "694050102",
                    "speaker": "杜林",
                    "text": "像那边靠墙的小角落就很有安全感。"
                },
                {
                    "id": "694050103",
                    "speaker": "杜林",
                    "text": "不过这种地方的空气一般不是很流通，如果你介意的话，我用翅膀给你扇扇风吧？"
                }
            ]
        },
        {
            "talkId": "6940502",
            "initDialog": "694050201",
            "dialogues": [
                {
                    "id": "694050201",
                    "speaker": "杜林",
                    "text": "你没有受伤吧？我也还好，几轮战斗下来，我好像比自己想象中厉害…"
                },
                {
                    "id": "694050202",
                    "speaker": "杜林",
                    "text": "所以不用顾虑我的安全，最重要的是不要为了我让自己陷入困境！"
                },
                {
                    "id": "694050203",
                    "speaker": "杜林",
                    "text": "请相信我可以保护自己，保护你。"
                }
            ]
        },
        {
            "talkId": "6940503",
            "initDialog": "694050301",
            "dialogues": [
                {
                    "id": "694050301",
                    "speaker": "杜林",
                    "text": "我想找找看，这里会不会有母亲写的书。"
                },
                {
                    "id": "694050302",
                    "speaker": "杜林",
                    "text": "虽然她写的每一本书我都认真读过了…"
                },
                {
                    "id": "694050303",
                    "speaker": "杜林",
                    "text": "但每次经过书架，还是会下意识地想找找她留下的痕迹…"
                }
            ]
        }
    ]
}