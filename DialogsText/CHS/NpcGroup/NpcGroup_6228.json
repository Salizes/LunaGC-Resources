{
    "groupId": "6228",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "穆托塔": 15
    },
    "talks": [
        {
            "talkId": "6622801",
            "initDialog": "662280101",
            "dialogues": [
                {
                    "id": "662280101",
                    "speaker": "穆托塔",
                    "text": "解决问题的秘诀是耐心…保障安全的也是。"
                }
            ]
        },
        {
            "talkId": "6622802",
            "initDialog": "662280201",
            "dialogues": [
                {
                    "id": "662280201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "662280202",
                    "speaker": "穆托塔",
                    "text": "你好，欢迎来到「花羽会」。"
                },
                {
                    "id": "662280203",
                    "speaker": "穆托塔",
                    "text": "作为首领，我不想显得自己过于死板或者制定太多规则，但在花羽会行动，确实需要一些细心和耐心。"
                },
                {
                    "id": "662280204",
                    "speaker": "穆托塔",
                    "text": "绒翼龙是纳塔最心高气傲的龙，很多骑龙的人也是。"
                },
                {
                    "id": "662280205",
                    "speaker": "穆托塔",
                    "text": "但一旦踏上战场，人们就会发现，傲气是没办法帮你取胜的。"
                },
                {
                    "id": "662280206",
                    "speaker": "穆托塔",
                    "text": "伤疤可能是战士的勋章，但也是对失误的警醒。"
                },
                {
                    "id": "662280207",
                    "speaker": "穆托塔",
                    "text": "…抱歉，我是不是太啰嗦了？我的意思是想说，请务必注意安全，嗯。"
                }
            ]
        },
        {
            "talkId": "6622803",
            "initDialog": "662280301",
            "dialogues": [
                {
                    "id": "662280301",
                    "speaker": "Player",
                    "text": "又见面了。"
                },
                {
                    "id": "662280302",
                    "speaker": "穆托塔",
                    "text": "原来是你们，欢迎欢迎。身体状态如何？没有受深渊影响留下什么后遗症吧？"
                },
                {
                    "id": "662280303",
                    "speaker": "穆托塔",
                    "text": "多谢你之前在人手不够的时候出手相助，如果不是你的出现，花羽会也不会恢复得这样快。"
                },
                {
                    "id": "662280304",
                    "speaker": "穆托塔",
                    "text": "虽然深渊的威胁告一段落，但这个世界永远不缺险境。"
                },
                {
                    "id": "662280305",
                    "speaker": "穆托塔",
                    "text": "可不能因为自己的能力够强就不惜代价地冒进哦？这可是战士们最容易犯的错误。"
                }
            ]
        },
        {
            "talkId": "6622804",
            "initDialog": "662280401",
            "dialogues": [
                {
                    "id": "662280401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "662280402",
                    "speaker": "穆托塔",
                    "text": "一路顺风。"
                }
            ]
        },
        {
            "talkId": "7593601",
            "initDialog": "759360101",
            "dialogues": [
                {
                    "id": "759360101",
                    "speaker": "Player",
                    "text": "多谢提醒。"
                },
                {
                    "id": "759360102",
                    "speaker": "穆托塔",
                    "text": "客气了。"
                },
                {
                    "id": "759360103",
                    "speaker": "穆托塔",
                    "text": "学习飞翔需要足够的勇气，但也得有明亮的眼睛才行。"
                },
                {
                    "id": "759360104",
                    "speaker": "穆托塔",
                    "text": "盲目，可是飞行最大的敌人啊。"
                }
            ]
        }
    ]
}