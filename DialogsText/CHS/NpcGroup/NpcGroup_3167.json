{
    "groupId": "3167",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "柴门克巳": 6
    },
    "talks": [
        {
            "talkId": "6316701",
            "initDialog": "631670101",
            "dialogues": [
                {
                    "id": "631670101",
                    "speaker": "柴门克巳",
                    "text": "哈哈，是你啊年轻人，多谢你帮我找回二郎，那小子最近也算是安稳起来了。"
                }
            ]
        },
        {
            "talkId": "6316702",
            "initDialog": "631670201",
            "dialogues": [
                {
                    "id": "631670201",
                    "speaker": "Player",
                    "text": "关于二郎…"
                },
                {
                    "id": "631670202",
                    "speaker": "柴门克巳",
                    "text": "他呀，最近天天念叨着想耕田种地的…罢了罢了，也不是什么坏事。"
                },
                {
                    "id": "631670203",
                    "speaker": "柴门克巳",
                    "text": "总归是因祸得福吧，这小子离家转了一圈，吃了不少苦头，才知道家里的好。"
                },
                {
                    "id": "631670204",
                    "speaker": "柴门克巳",
                    "text": "我啊，都这把年纪了，也不指望那臭小子能成什么大器。他只要平平安安，脚踏实地地过活，就算万事大吉了。"
                }
            ]
        },
        {
            "talkId": "6316703",
            "initDialog": "631670301",
            "dialogues": [
                {
                    "id": "631670301",
                    "speaker": "Player",
                    "text": "谢谢你送的宝刀。"
                },
                {
                    "id": "631670302",
                    "speaker": "柴门克巳",
                    "text": "不客气不客气。我们柴门家的传世名刀，能被你这样出众的年轻人握在手中，闯荡四方，才算是物尽其用啊。"
                },
                {
                    "id": "631670303",
                    "speaker": "柴门克巳",
                    "text": "你跟犬子不同，我相信你一定会做出一番事业的…加油吧，年轻人。"
                }
            ]
        }
    ]
}