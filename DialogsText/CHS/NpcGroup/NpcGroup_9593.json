{
    "groupId": "9593",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "梦见月瑞希": 10
    },
    "talks": [
        {
            "talkId": "6959301",
            "initDialog": "695930101",
            "dialogues": [
                {
                    "id": "695930101",
                    "speaker": "梦见月瑞希",
                    "text": "大家玩得很投入呢。从他们的笑容来看，一定是真心热爱着「七圣召唤」吧。"
                }
            ]
        },
        {
            "talkId": "6959302",
            "initDialog": "695930201",
            "dialogues": [
                {
                    "id": "695930201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959303",
            "initDialog": "695930301",
            "dialogues": [
                {
                    "id": "695930301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695930302",
                    "speaker": "梦见月瑞希",
                    "text": "嗯，我稍后也会离开，还有几场诊疗需要做点安排…"
                }
            ]
        },
        {
            "talkId": "6959304",
            "initDialog": "695930401",
            "dialogues": [
                {
                    "id": "695930401",
                    "speaker": "梦见月瑞希",
                    "text": "呵呵，这次你皱眉的幅度，略微小了一些，这也算是一种小小进步吧，做得很好哦。"
                }
            ]
        },
        {
            "talkId": "6959305",
            "initDialog": "695930501",
            "dialogues": [
                {
                    "id": "695930501",
                    "speaker": "梦见月瑞希",
                    "text": "输得不太好看呢。不过…也算是又累积了一些情绪感受，或许在之后的诊疗里能用得上。"
                }
            ]
        },
        {
            "talkId": "6959306",
            "initDialog": "695930601",
            "dialogues": [
                {
                    "id": "695930601",
                    "speaker": "梦见月瑞希",
                    "text": "好呀。偶尔玩玩游戏，也有助于舒缓精神。"
                }
            ]
        },
        {
            "talkId": "6959308",
            "initDialog": "695930801",
            "dialogues": [
                {
                    "id": "695930801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959309",
            "initDialog": "695930901",
            "dialogues": [
                {
                    "id": "695930901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959310",
            "initDialog": "695931001",
            "dialogues": [
                {
                    "id": "695931001",
                    "speaker": "梦见月瑞希",
                    "text": "你刚才出牌的时候，眼神有些恍惚，是昨晚又熬夜了？唉…稍等，我去拿点喝的给你。"
                }
            ]
        },
        {
            "talkId": "6959311",
            "initDialog": "695931101",
            "dialogues": [
                {
                    "id": "695931101",
                    "speaker": "梦见月瑞希",
                    "text": "虽说是游戏…但输了之后，多少还是有些懊恼啊…"
                }
            ]
        },
        {
            "talkId": "6959312",
            "initDialog": "695931201",
            "dialogues": [
                {
                    "id": "695931201",
                    "speaker": "梦见月瑞希",
                    "text": "好，我们来玩一局吧。但…记得控制住自己的情绪，别被游戏的胜负左右了心情。"
                }
            ]
        },
        {
            "talkId": "6959314",
            "initDialog": "695931401",
            "dialogues": [
                {
                    "id": "695931401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959315",
            "initDialog": "695931501",
            "dialogues": [
                {
                    "id": "695931501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959316",
            "initDialog": "695931601",
            "dialogues": [
                {
                    "id": "695931601",
                    "speaker": "梦见月瑞希",
                    "text": "你又皱眉了，来，闭上眼，深呼吸，放松…这只是一场游戏，不要太过紧张。"
                }
            ]
        },
        {
            "talkId": "6959317",
            "initDialog": "695931701",
            "dialogues": [
                {
                    "id": "695931701",
                    "speaker": "梦见月瑞希",
                    "text": "看来，这种游戏我确实玩得不如你…玩得开心的话，要再来一局么？"
                }
            ]
        },
        {
            "talkId": "6959318",
            "initDialog": "695931801",
            "dialogues": [
                {
                    "id": "695931801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}