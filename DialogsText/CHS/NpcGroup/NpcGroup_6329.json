            "dialogues": [
                {
                    "id": "663290101",
                    "speaker": "卢施",
                    "text": "如此强大的「烈度」，令人雀跃，令人雀跃啊！",
                    "choices": [
                        {
                            "id": "663290102",
                            "text": "在说我么？",
                            "response": [
                                {
                                    "id": "663290103",
                                    "speaker": "卢施",
                                    "text": "正是，正是啊！怎么样，要不要来试试「勇士挑战」，只要在大师处报名即可，我很看好你的！",
                                    "choices": [
                                        {
                                            "id": "663290106",
                                            "text": "一会儿就去！",
                                            "response": [
                                                {
                                                    "id": "663290107",
                                                    "speaker": "卢施",
                                                    "text": "甚好！甚好！终于能看见传说中的战士的身姿了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "663290108",
                                            "text": "让我考虑一下…",
                                            "response": [
                                                {
                                                    "id": "663290109",
                                                    "speaker": "卢施",
                                                    "text": "可惜，可惜啊，不能一饱眼福了。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "663290104",
                            "text": "打扰了，再见。",
                            "response": [
                                {
                                    "id": "663290105",
                                    "speaker": "卢施",
                                    "text": "慢走，慢走。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}