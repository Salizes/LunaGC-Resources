{
    "groupId": "4160",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 4,
        "阿米": 17
    },
    "talks": [
        {
            "talkId": "6416001",
            "initDialog": "641600101",
            "dialogues": [
                {
                    "id": "641600101",
                    "speaker": "阿米",
                    "text": "为什么大家都喜欢露天做饭呢…"
                }
            ]
        },
        {
            "talkId": "6416002",
            "initDialog": "641600201",
            "dialogues": [
                {
                    "id": "641600201",
                    "speaker": "Player",
                    "text": "可能是因为好玩。"
                },
                {
                    "id": "641600202",
                    "speaker": "阿米",
                    "text": "真的好玩吗？露天做饭的乐趣在哪啊？"
                },
                {
                    "id": "641600203",
                    "speaker": "阿米",
                    "text": "我不明白。"
                },
                {
                    "id": "641600204",
                    "speaker": "阿米",
                    "text": "而且万一有虫虫掉进锅里，那岂不是一点都不好玩了…"
                },
                {
                    "id": "641600205",
                    "speaker": "阿米",
                    "text": "掉进锅里的虫虫很可怜，吃到虫虫的大人也很可怜…一点都不值得嘛。"
                }
            ]
        },
        {
            "talkId": "6416003",
            "initDialog": "641600301",
            "dialogues": [
                {
                    "id": "641600301",
                    "speaker": "Player",
                    "text": "可能是因为没办法…"
                },
                {
                    "id": "641600302",
                    "speaker": "阿米",
                    "text": "什么样的人只能在外面做饭呀？是因为没有家吗？"
                },
                {
                    "id": "641600303",
                    "speaker": "阿米",
                    "text": "那的确没办法了，好可怜啊。"
                },
                {
                    "id": "641600304",
                    "speaker": "阿米",
                    "text": "但爸爸明明有家啊，为什么还要在外面搭锅子呢？"
                },
                {
                    "id": "641600305",
                    "speaker": "阿米",
                    "text": "难道是为了那些没有家的人吗？"
                },
                {
                    "id": "641600306",
                    "speaker": "阿米",
                    "text": "唔，我好像有点理解了…"
                },
                {
                    "id": "641600307",
                    "speaker": "阿米",
                    "text": "欸不对，那爸爸自己为什么也要在露天的锅子里做饭啊？"
                },
                {
                    "id": "641600308",
                    "speaker": "阿米",
                    "text": "我又不懂了！"
                }
            ]
        },
        {
            "talkId": "6416004",
            "initDialog": "641600401",
            "dialogues": [
                {
                    "id": "641600401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641600402",
                    "speaker": "阿米",
                    "text": "希望不要再有虫虫飞过来了…"
                }
            ]
        },
        {
            "talkId": "7391401",
            "initDialog": "739140101",
            "dialogues": [
                {
                    "id": "739140101",
                    "speaker": "Player",
                    "text": "眼睛不要离开锅子就好了。"
                },
                {
                    "id": "739140102",
                    "speaker": "阿米",
                    "text": "要一直盯着看吗？"
                },
                {
                    "id": "739140103",
                    "speaker": "阿米",
                    "text": "唔…也有道理，如果做饭的时候不看着点的话，就算没有虫虫，也会烧糊的。"
                },
                {
                    "id": "739140104",
                    "speaker": "阿米",
                    "text": "哎呀，做饭真的好麻烦啊。大家为什么不直接吃新鲜的水果呢？又甜又好吃！"
                },
                {
                    "id": "739140105",
                    "speaker": "阿米",
                    "text": "那样就不用做饭，也不用担心烧糊的虫虫了。"
                }
            ]
        }
    ]
}