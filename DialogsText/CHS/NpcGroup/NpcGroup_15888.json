{
    "groupId": "15888",
    "total_dialogue_lines": 40,
    "speaker_counts": {
        "Player": 7,
        "旁白": 2,
        "派蒙": 13,
        "流浪猫": 8,
        "箱子里的猫": 2,
        "长颈鹿国王": 3,
        "飞鼠仙子": 4,
        "？？？": 1
    },
    "talks": [
        {
            "talkId": "1600225",
            "initDialog": "160022501",
            "dialogues": [
                {
                    "id": "160022501",
                    "speaker": "旁白",
                    "text": "故事的见证者来到了高墙之中的一处隐秘之地，那是被小龙珍视的回忆之一。"
                },
                {
                    "id": "160022502",
                    "speaker": "旁白",
                    "text": "这些回忆里，有他在城堡里交到的朋友。"
                },
                {
                    "id": "160022503",
                    "speaker": "派蒙",
                    "text": "大家还在这里啊…在希穆兰卡认识的朋友对于杜林来说果然很重要。"
                },
                {
                    "id": "160022504",
                    "speaker": "飞鼠仙子",
                    "text": "你好啊，金发的旅者还有银色的精灵，小龙的旅途还顺利吗？",
                    "choices": [
                        {
                            "id": "160022505",
                            "text": "发生了一些意外情况…",
                            "response": [
                                {
                                    "id": "160022507",
                                    "speaker": "飞鼠仙子",
                                    "text": "怎么会？我还记得他。"
                                },
                                {
                                    "id": "160022508",
                                    "speaker": "长颈鹿国王",
                                    "text": "本王也没有忘记他。"
                                },
                                {
                                    "id": "160022509",
                                    "speaker": "箱子里的猫",
                                    "text": "箱子里的猫也还记得小龙。"
                                },
                                {
                                    "id": "160022510",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，好消息是小龙的朋友们都还记得他，我和金发的旅者会想办法让别人也记起他！"
                                },
                                {
                                    "id": "160022511",
                                    "speaker": "派蒙",
                                    "text": "话说回来，是不是缺了谁？"
                                },
                                {
                                    "id": "160022512",
                                    "speaker": "长颈鹿国王",
                                    "text": "你们是指那只流浪猫吗？他不想见小龙，一直躲着大家。",
                                    "choices": [
                                        {
                                            "id": "160022513",
                                            "text": "流浪猫…",
                                            "response": [
                                                {
                                                    "id": "160022515",
                                                    "speaker": "派蒙",
                                                    "text": "这家伙到底在搞什么？现实里的他藏着心事不跟杜林讲，故事里的他直接躲起来了…"
                                                },
                                                {
                                                    "id": "160022516",
                                                    "speaker": "飞鼠仙子",
                                                    "text": "他就藏在那边，一直不肯跟我们讲话，或许你们可以找他聊一聊？"
                                                },
                                                {
                                                    "id": "160022517",
                                                    "speaker": "Player",
                                                    "text": "交给我们吧。"
                                                },
                                                {
                                                    "id": "160022518",
                                                    "speaker": "派蒙",
                                                    "text": "喂，流浪猫先生，你为什么不肯见小龙呢？"
                                                },
                                                {
                                                    "id": "160022519",
                                                    "speaker": "？？？",
                                                    "text": "…这个问题需要专门来问我吗？"
                                                },
                                                {
                                                    "id": "160022520",
                                                    "speaker": "派蒙",
                                                    "text": "呀，真的说话了。"
                                                },
                                                {
                                                    "id": "160022521",
                                                    "speaker": "流浪猫",
                                                    "text": "你们刚刚说过的吧？很多人都不记得他了。"
                                                },
                                                {
                                                    "id": "160022522",
                                                    "speaker": "派蒙",
                                                    "text": "对啊，所以呢？"
                                                },
                                                {
                                                    "id": "160022523",
                                                    "speaker": "流浪猫",
                                                    "text": "所以不要让他再靠近我了。"
                                                },
                                                {
                                                    "id": "160022524",
                                                    "speaker": "派蒙",
                                                    "text": "你在说什么啊？喂…又不回话了…"
                                                },
                                                {
                                                    "id": "160022525",
                                                    "speaker": "流浪猫",
                                                    "text": "不要在背后议论别人，我当然也还记得他。"
                                                },
                                                {
                                                    "id": "160022526",
                                                    "speaker": "派蒙",
                                                    "text": "哇，你这家伙不要搞突然出现啊。"
                                                },
                                                {
                                                    "id": "160022527",
                                                    "speaker": "流浪猫",
                                                    "text": "哼…"
                                                },
                                                {
                                                    "id": "160022528",
                                                    "speaker": "派蒙",
                                                    "text": "噗…他这副样子果然还是很滑稽…"
                                                },
                                                {
                                                    "id": "160022529",
                                                    "speaker": "流浪猫",
                                                    "text": "嗯？这就是我本来的样子，无论你怎么看。"
                                                },
                                                {
                                                    "id": "160022530",
                                                    "speaker": "派蒙",
                                                    "text": "他竟然接受了…",
                                                    "choices": [
                                                        {
                                                            "id": "160022531",
                                                            "text": "应该是故事里的「角色」。",
                                                            "response": [
                                                                {
                                                                    "id": "160022533",
                                                                    "speaker": "派蒙",
                                                                    "text": "确实…话说回来，之前大家帮小龙许愿的时候，只有你不在。"
                                                                },
                                                                {
                                                                    "id": "160022534",
                                                                    "speaker": "流浪猫",
                                                                    "text": "许愿这种过家家的事，用不着我帮他。等他遇到解决不了的难题，再找我也不迟。"
                                                                },
                                                                {
                                                                    "id": "160022535",
                                                                    "speaker": "派蒙",
                                                                    "text": "以他为原型的故事角色果然也是这个样子…"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "160022532",
                                                            "text": "不是他本人扮演的。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "160022514",
                                            "text": "就是他吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "160022506",
                            "text": "很多人都不记得他了…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "1600228",
            "initDialog": "160022801",
            "dialogues": [
                {
                    "id": "160022801",
                    "speaker": "飞鼠仙子",
                    "text": "为什么其他人会忘记小龙呢？难道他需要新的祝福？"
                },
                {
                    "id": "160022802",
                    "speaker": "长颈鹿国王",
                    "text": "城堡外总会遇到新的挑战，不然的话，旅途就有些无聊啦。"
                },
                {
                    "id": "160022803",
                    "speaker": "箱子里的猫",
                    "text": "在我看来，旅途还是安逸些更好…"
                },
                {
                    "id": "160022804",
                    "speaker": "流浪猫",
                    "text": "……"
                },
                {
                    "id": "160022805",
                    "speaker": "流浪猫",
                    "text": "等他遇到解决不了的难题，再找我也不迟。"
                }
            ]
        }
    ]
}