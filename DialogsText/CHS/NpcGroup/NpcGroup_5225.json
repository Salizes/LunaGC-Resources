{
    "groupId": "5225",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "布里科勒": 11
    },
    "talks": [
        {
            "talkId": "6522501",
            "initDialog": "652250101",
            "dialogues": [
                {
                    "id": "652250101",
                    "speaker": "布里科勒",
                    "text": "哦！你又回来了。"
                }
            ]
        },
        {
            "talkId": "6522502",
            "initDialog": "652250201",
            "dialogues": [
                {
                    "id": "652250201",
                    "speaker": "Player",
                    "text": "关于库特罗…"
                },
                {
                    "id": "652250202",
                    "speaker": "布里科勒",
                    "text": "之前只是将他从枫丹科学院除名看来没有起到警醒的效果，真是冥顽不灵啊。"
                },
                {
                    "id": "652250203",
                    "speaker": "布里科勒",
                    "text": "不过这次可没人替他担保了，所以你放心好了，他不会再有机会作恶了。"
                }
            ]
        },
        {
            "talkId": "6522503",
            "initDialog": "652250301",
            "dialogues": [
                {
                    "id": "652250301",
                    "speaker": "Player",
                    "text": "关于这里的装置…"
                },
                {
                    "id": "652250302",
                    "speaker": "布里科勒",
                    "text": "很令人费解对吧？看得出来他对这里进行了，呃，各种方面的改造。"
                },
                {
                    "id": "652250303",
                    "speaker": "布里科勒",
                    "text": "感觉现在这样反而比较符合废墟旅游的选址要求呢…这么说好像有点不太谨慎。"
                },
                {
                    "id": "652250304",
                    "speaker": "布里科勒",
                    "text": "咳，刚才的发言只是我个人的见解，不代表枫丹科学院的意见。"
                }
            ]
        },
        {
            "talkId": "6522504",
            "initDialog": "652250401",
            "dialogues": [
                {
                    "id": "652250401",
                    "speaker": "Player",
                    "text": "你忙吧。"
                },
                {
                    "id": "652250402",
                    "speaker": "布里科勒",
                    "text": "这就走吗？好吧…"
                },
                {
                    "id": "652250403",
                    "speaker": "布里科勒",
                    "text": "唉，这地方一个人呆久了真有点毛骨悚然的感觉…"
                }
            ]
        },
        {
            "talkId": "6522505",
            "initDialog": "652250501",
            "dialogues": [
                {
                    "id": "652250501",
                    "speaker": "Player",
                    "text": "话说回来，奎瑟尔是谁？"
                },
                {
                    "id": "652250502",
                    "speaker": "布里科勒",
                    "text": "我也不知道。在我印象中枫丹科学院应该没有叫这个名字的…也许对他来说，没有叫这个名字的人更好？"
                },
                {
                    "id": "652250503",
                    "speaker": "布里科勒",
                    "text": "就像他自己说的，奎瑟尔只是一个方便的角色，和他本人的区别越大越好，这样就能减少被认出的可能性…我乱猜的。"
                },
                {
                    "id": "652250504",
                    "speaker": "布里科勒",
                    "text": "唉，不过要我说，他本人就和过去差别够大了。一开始我都没认出来是他呢。"
                }
            ]
        }
    ]
}