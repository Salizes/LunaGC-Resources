{
    "groupId": "5027",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "卡嘉妮": 15
    },
    "talks": [
        {
            "talkId": "6502701",
            "initDialog": "650270101",
            "dialogues": [
                {
                    "id": "650270101",
                    "speaker": "卡嘉妮",
                    "text": "您可以轻易拥有时间，但无法轻易拥有一款艾梅莉埃小姐调制的香水。"
                }
            ]
        },
        {
            "talkId": "6502702",
            "initDialog": "650270201",
            "dialogues": [
                {
                    "id": "650270201",
                    "speaker": "Player",
                    "text": "关于香水…"
                },
                {
                    "id": "650270202",
                    "speaker": "卡嘉妮",
                    "text": "芳香不仅仅是气味，也是一种生活态度，是人生行走过后留下的痕迹。"
                },
                {
                    "id": "650270203",
                    "speaker": "卡嘉妮",
                    "text": "您认为香水最易消散吗？我并不否认。"
                },
                {
                    "id": "650270204",
                    "speaker": "卡嘉妮",
                    "text": "但为何那看不见的香气常令人魂牵梦绕呢？"
                }
            ]
        },
        {
            "talkId": "6502703",
            "initDialog": "650270301",
            "dialogues": [
                {
                    "id": "650270301",
                    "speaker": "Player",
                    "text": "关于艾梅莉埃…"
                },
                {
                    "id": "650270302",
                    "speaker": "卡嘉妮",
                    "text": "这位小姐的行踪更是像香水一般，无法触及，也无从挽留。"
                },
                {
                    "id": "650270303",
                    "speaker": "卡嘉妮",
                    "text": "她并不受雇于卡布里埃商会，也并不与任何品牌固定合作。"
                },
                {
                    "id": "650270304",
                    "speaker": "卡嘉妮",
                    "text": "但她却是枫丹当下最知名的香水设计师，优雅的上流女士们甚至会为了她调制的一滴香水付出一颗宝石。"
                },
                {
                    "id": "650270305",
                    "speaker": "卡嘉妮",
                    "text": "我说得太夸张了？"
                },
                {
                    "id": "650270306",
                    "speaker": "卡嘉妮",
                    "text": "嗯…那您就当我已经加上了「据说」二字吧。"
                }
            ]
        },
        {
            "talkId": "6502704",
            "initDialog": "650270401",
            "dialogues": [
                {
                    "id": "650270401",
                    "speaker": "Player",
                    "text": "关于艾梅莉埃…"
                },
                {
                    "id": "650270402",
                    "speaker": "卡嘉妮",
                    "text": "这位小姐的行踪更是像香水一般，无法触及，也无从挽留。"
                },
                {
                    "id": "650270403",
                    "speaker": "卡嘉妮",
                    "text": "她并不受雇于本店，也并不与任何品牌固定合作。"
                },
                {
                    "id": "650270404",
                    "speaker": "卡嘉妮",
                    "text": "但她却是枫丹当下最知名的香水设计师，优雅的上流女士们甚至会为了她调制的一滴香水付出一颗宝石。"
                },
                {
                    "id": "650270405",
                    "speaker": "卡嘉妮",
                    "text": "我说得太夸张了？"
                },
                {
                    "id": "650270406",
                    "speaker": "卡嘉妮",
                    "text": "嗯…那您就当我已经加上了「据说」二字吧。"
                }
            ]
        },
        {
            "talkId": "6502705",
            "initDialog": "650270501",
            "dialogues": [
                {
                    "id": "650270501",
                    "speaker": "Player",
                    "text": "暂时用不上…"
                },
                {
                    "id": "650270502",
                    "speaker": "卡嘉妮",
                    "text": "流行瞬息万变，还请留住那缕芳香。"
                }
            ]
        }
    ]
}