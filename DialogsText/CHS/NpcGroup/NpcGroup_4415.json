{
    "groupId": "4415",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "莎塔": 8
    },
    "talks": [
        {
            "talkId": "6441501",
            "initDialog": "644150101",
            "dialogues": [
                {
                    "id": "644150101",
                    "speaker": "莎塔",
                    "text": "你好。天色不早了，建议尽快回家休息哦。"
                }
            ]
        },
        {
            "talkId": "6441502",
            "initDialog": "644150201",
            "dialogues": [
                {
                    "id": "644150201",
                    "speaker": "Player",
                    "text": "你呢？"
                },
                {
                    "id": "644150202",
                    "speaker": "莎塔",
                    "text": "我？…啊，你可能是第一次见我值夜，所以不了解情况吧。"
                },
                {
                    "id": "644150203",
                    "speaker": "莎塔",
                    "text": "之前村子里发生了一起守村人绑架案，所以村长特意在这附近多加派了巡逻的人手，而我就是这个幸运儿。"
                }
            ]
        },
        {
            "talkId": "6441503",
            "initDialog": "644150301",
            "dialogues": [
                {
                    "id": "644150301",
                    "speaker": "Player",
                    "text": "明白了。"
                },
                {
                    "id": "644150302",
                    "speaker": "莎塔",
                    "text": "嗯。晚上什么事情都可能发生，注意安全哦。"
                }
            ]
        },
        {
            "talkId": "6441504",
            "initDialog": "644150401",
            "dialogues": [
                {
                    "id": "644150401",
                    "speaker": "Player",
                    "text": "关于绑架案…"
                },
                {
                    "id": "644150402",
                    "speaker": "莎塔",
                    "text": "听说这起绑架案的起因和教令院有关…哼，我以前在城里做「三十人团」佣兵的时候就看清他们的嘴脸了。"
                },
                {
                    "id": "644150403",
                    "speaker": "莎塔",
                    "text": "这些狗屁学者就像消失前还要爆炸的飘浮灵一样恶心，至今还在做着见不得人的勾当。"
                },
                {
                    "id": "644150404",
                    "speaker": "莎塔",
                    "text": "…当然了，那些听信「赤王复活」这类鬼话的沙漠傻子也没好到哪去。"
                },
                {
                    "id": "644150405",
                    "speaker": "莎塔",
                    "text": "有些甚至还是以前我做佣兵时的同胞。真不想承认我和这群傻蘑菇共事过。"
                }
            ]
        }
    ]
}