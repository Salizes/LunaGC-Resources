{
    "groupId": "6069",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "塔洛娜": 16
    },
    "talks": [
        {
            "talkId": "6606901",
            "initDialog": "660690101",
            "dialogues": [
                {
                    "id": "660690101",
                    "speaker": "塔洛娜",
                    "text": "要不要去玛拉妮的店里看看新的冲浪板呢…"
                }
            ]
        },
        {
            "talkId": "6606902",
            "initDialog": "660690201",
            "dialogues": [
                {
                    "id": "660690201",
                    "speaker": "Player",
                    "text": "不能去看吗？"
                },
                {
                    "id": "660690202",
                    "speaker": "塔洛娜",
                    "text": "能，也不能。"
                },
                {
                    "id": "660690203",
                    "speaker": "塔洛娜",
                    "text": "你问我想不想去看呢，那当然是想了。"
                },
                {
                    "id": "660690204",
                    "speaker": "塔洛娜",
                    "text": "但是你问一问我的钱包，它大约是不建议的。"
                },
                {
                    "id": "660690205",
                    "speaker": "塔洛娜",
                    "text": "再问一问家里的房子呢，呃，它说可能需要再买一间仓库。"
                },
                {
                    "id": "660690206",
                    "speaker": "塔洛娜",
                    "text": "我…我应该尊重它们的意见，对吧？"
                }
            ]
        },
        {
            "talkId": "6606903",
            "initDialog": "660690301",
            "dialogues": [
                {
                    "id": "660690301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660690302",
                    "speaker": "塔洛娜",
                    "text": "慢走，我再好好想想…"
                }
            ]
        },
        {
            "talkId": "6606904",
            "initDialog": "660690401",
            "dialogues": [
                {
                    "id": "660690401",
                    "speaker": "Player",
                    "text": "不如再问问你的「工作」。"
                },
                {
                    "id": "660690402",
                    "speaker": "塔洛娜",
                    "text": "哦，对！一旦去了店里就走不动了，这样就没法工作了，的确如此。"
                },
                {
                    "id": "660690403",
                    "speaker": "塔洛娜",
                    "text": "…但，你要是这么讲的话，公平起见，我是不是也应该问问我的「爱好」呢？"
                },
                {
                    "id": "660690404",
                    "speaker": "塔洛娜",
                    "text": "我的「爱好」成员可多了，有冲浪、划艇、水球、游泳…"
                },
                {
                    "id": "660690405",
                    "speaker": "塔洛娜",
                    "text": "一旦问过它们的意见，那票数可就不一样了。"
                },
                {
                    "id": "660690406",
                    "speaker": "塔洛娜",
                    "text": "嗯…等会儿我再认真算算票数吧…等会儿再去…"
                }
            ]
        },
        {
            "talkId": "6606905",
            "initDialog": "660690501",
            "dialogues": [
                {
                    "id": "660690501",
                    "speaker": "Player",
                    "text": "在巡逻吗？"
                },
                {
                    "id": "660690502",
                    "speaker": "塔洛娜",
                    "text": "对啊。部族内的重建工作已经安排得差不多了，首领就安排我来附近巡逻了。"
                },
                {
                    "id": "660690503",
                    "speaker": "塔洛娜",
                    "text": "按照火神大人的说法，这次深渊被重伤，短时间内应该不会有大动静，但它是个狡猾的敌人，不可掉以轻心。"
                },
                {
                    "id": "660690504",
                    "speaker": "塔洛娜",
                    "text": "所以爱好什么的就先放在一边吧。玛拉妮小姐作为「古名」的持有者，估计也有好多要忙的呢！"
                }
            ]
        },
        {
            "talkId": "6606906",
            "initDialog": "660690601",
            "dialogues": [
                {
                    "id": "660690601",
                    "speaker": "Player",
                    "text": "以后会有机会的。"
                },
                {
                    "id": "660690602",
                    "speaker": "塔洛娜",
                    "text": "你说的对！"
                }
            ]
        }
    ]
}