{
    "groupId": "9557",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "五郎": 10
    },
    "talks": [
        {
            "talkId": "6955701",
            "initDialog": "695570101",
            "dialogues": [
                {
                    "id": "695570101",
                    "speaker": "五郎",
                    "text": "这里都是卡牌游戏好手吗？居然有如此多…唔，该找人切磋了。"
                }
            ]
        },
        {
            "talkId": "6955702",
            "initDialog": "695570201",
            "dialogues": [
                {
                    "id": "695570201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955703",
            "initDialog": "695570301",
            "dialogues": [
                {
                    "id": "695570301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695570302",
                    "speaker": "五郎",
                    "text": "嗯，我稍后也会离开，但在那之前…我想要与人再多切磋几局。"
                }
            ]
        },
        {
            "talkId": "6955704",
            "initDialog": "695570401",
            "dialogues": [
                {
                    "id": "695570401",
                    "speaker": "五郎",
                    "text": "好，取胜了！看来我平时的卡牌练习没有白费。"
                }
            ]
        },
        {
            "talkId": "6955705",
            "initDialog": "695570501",
            "dialogues": [
                {
                    "id": "695570501",
                    "speaker": "五郎",
                    "text": "终究还是练习不够…等我再锻炼一番卡牌功夫，再来向你请教。"
                }
            ]
        },
        {
            "talkId": "6955706",
            "initDialog": "695570601",
            "dialogues": [
                {
                    "id": "695570601",
                    "speaker": "五郎",
                    "text": "那就开始吧，让你瞧瞧我的本事。"
                }
            ]
        },
        {
            "talkId": "6955708",
            "initDialog": "695570801",
            "dialogues": [
                {
                    "id": "695570801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955709",
            "initDialog": "695570901",
            "dialogues": [
                {
                    "id": "695570901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6955710",
            "initDialog": "695571001",
            "dialogues": [
                {
                    "id": "695571001",
                    "speaker": "五郎",
                    "text": "呼…赢得真是惊险，还好略胜一份运气。要再来一局吗？"
                }
            ]
        },
        {
            "talkId": "6955711",
            "initDialog": "695571101",
            "dialogues": [
                {
                    "id": "695571101",
                    "speaker": "五郎",
                    "text": "虽说胜败乃兵家常事…但输的感觉，还是不太好啊…"
                }
            ]
        },
        {
            "talkId": "6955712",
            "initDialog": "695571201",
            "dialogues": [
                {
                    "id": "695571201",
                    "speaker": "五郎",
                    "text": "没问题，我会倾力以对。"
                }
            ]
        },
        {
            "talkId": "6955714",
            "initDialog": "695571401",
            "dialogues": [
                {
                    "id": "695571401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955715",
            "initDialog": "695571501",
            "dialogues": [
                {
                    "id": "695571501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6955716",
            "initDialog": "695571601",
            "dialogues": [
                {
                    "id": "695571601",
                    "speaker": "五郎",
                    "text": "今日，看来我的运势不错。但依靠运势终究不能常胜…我还需要再做磨炼才行。"
                }
            ]
        },
        {
            "talkId": "6955717",
            "initDialog": "695571701",
            "dialogues": [
                {
                    "id": "695571701",
                    "speaker": "五郎",
                    "text": "是我牌力不支了…这局，我输得心服口服！你比我厉害。"
                }
            ]
        },
        {
            "talkId": "6955718",
            "initDialog": "695571801",
            "dialogues": [
                {
                    "id": "695571801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}