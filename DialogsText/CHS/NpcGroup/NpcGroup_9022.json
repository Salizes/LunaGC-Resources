{
    "groupId": "9022",
    "total_dialogue_lines": 67,
    "speaker_counts": {
        "Player": 18,
        "温迪": 49
    },
    "talks": [
        {
            "talkId": "6902201",
            "initDialog": "690220101",
            "dialogues": [
                {
                    "id": "690220101",
                    "speaker": "温迪",
                    "text": "#{NICKNAME}！你总算来了呀。"
                },
                {
                    "id": "690220102",
                    "speaker": "温迪",
                    "text": "等你的这段时间里，我都快写出好几首诗了。"
                }
            ]
        },
        {
            "talkId": "6902202",
            "initDialog": "690220201",
            "dialogues": [
                {
                    "id": "690220201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690220202",
                    "speaker": "温迪",
                    "text": "那是当然的喽。"
                },
                {
                    "id": "690220203",
                    "speaker": "温迪",
                    "text": "我知道这里一草一木都来自你的汗水，我正怀着感激的心情和它们相处呢！",
                    "choices": [
                        {
                            "id": "690220204",
                            "text": "温迪喜欢就最好了。",
                            "response": [
                                {
                                    "id": "690220205",
                                    "speaker": "温迪",
                                    "text": "嗯，喜欢！"
                                },
                                {
                                    "id": "690220208",
                                    "speaker": "温迪",
                                    "text": "哎呀，虽然你征询我的意见，我很开心。"
                                },
                                {
                                    "id": "690220209",
                                    "speaker": "温迪",
                                    "text": "但你也要对自己的品位更加自信一点嘛！"
                                },
                                {
                                    "id": "690220210",
                                    "speaker": "温迪",
                                    "text": "在这里，你就是真正的主角呀！"
                                },
                                {
                                    "id": "690220211",
                                    "speaker": "温迪",
                                    "text": "大胆尝试，把自己的想法变成现实…遇到困难的时候，我也会来帮你的！"
                                }
                            ]
                        },
                        {
                            "id": "690220206",
                            "text": "温迪有什么想要的吗？",
                            "response": [
                                {
                                    "id": "690220207",
                                    "speaker": "温迪",
                                    "text": "我想要的，这里都已经有了哟！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902203",
            "initDialog": "690220301",
            "dialogues": [
                {
                    "id": "690220301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690220302",
                    "speaker": "温迪",
                    "text": "好啊！咳咳…我最亲爱的朋友啊，是有什么要对我倾诉的吗？",
                    "choices": [
                        {
                            "id": "690220303",
                            "text": "其实，最近感觉很累…",
                            "response": [
                                {
                                    "id": "690220304",
                                    "speaker": "温迪",
                                    "text": "嘿嘿…我的勇者，辛苦了。"
                                },
                                {
                                    "id": "690220305",
                                    "speaker": "温迪",
                                    "text": "我明白你说的感觉！"
                                },
                                {
                                    "id": "690220306",
                                    "speaker": "温迪",
                                    "text": "…提不起精神，嚼在嘴里的苹果也没有味道。"
                                },
                                {
                                    "id": "690220307",
                                    "speaker": "温迪",
                                    "text": "这种时候，如果能够舒舒服服地睡上一觉，醒来就会轻松很多。"
                                },
                                {
                                    "id": "690220308",
                                    "speaker": "温迪",
                                    "text": "来，肩膀借给你哦。"
                                },
                                {
                                    "id": "690220316",
                                    "speaker": "温迪",
                                    "text": "欸嘿嘿…"
                                },
                                {
                                    "id": "690220317",
                                    "speaker": "温迪",
                                    "text": "总之，放心吧！"
                                },
                                {
                                    "id": "690220318",
                                    "speaker": "温迪",
                                    "text": "当你需要我的时候，我永远都会在你身边。"
                                }
                            ]
                        },
                        {
                            "id": "690220309",
                            "text": "感觉有些迷失方向…",
                            "response": [
                                {
                                    "id": "690220310",
                                    "speaker": "温迪",
                                    "text": "嗯，嗯…"
                                },
                                {
                                    "id": "690220311",
                                    "speaker": "温迪",
                                    "text": "这也是常有的事情嘛。毕竟不可能所有事情都顺遂自己的心意。"
                                },
                                {
                                    "id": "690220312",
                                    "speaker": "温迪",
                                    "text": "这种时候，可以试着问自己最重要的事情是什么哦！"
                                },
                                {
                                    "id": "690220313",
                                    "speaker": "温迪",
                                    "text": "即使是一团乱麻，只要有一缕风就能理清头绪。"
                                },
                                {
                                    "id": "690220314",
                                    "speaker": "温迪",
                                    "text": "——别怕，我在这里呢。"
                                },
                                {
                                    "id": "690220315",
                                    "speaker": "Player",
                                    "text": "温迪正经的样子…有点罕见。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902204",
            "initDialog": "690220401",
            "dialogues": [
                {
                    "id": "690220401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690220402",
                    "speaker": "温迪",
                    "text": "嗯…来举办一场宴会吧！"
                },
                {
                    "id": "690220403",
                    "speaker": "温迪",
                    "text": "叫上和你关系要好的朋友，我也贡献出我珍藏的最棒的酒。"
                },
                {
                    "id": "690220404",
                    "speaker": "温迪",
                    "text": "地点的话…"
                },
                {
                    "id": "690220405",
                    "speaker": "温迪",
                    "text": "干脆就在这里办吧，找一片空地，装饰上长椅、围廊和漂亮的鲜花！",
                    "choices": [
                        {
                            "id": "690220406",
                            "text": "那么…庆祝的主题呢？",
                            "response": [
                                {
                                    "id": "690220407",
                                    "speaker": "温迪",
                                    "text": "欸…还需要主题吗？那你等我现想一个哦。"
                                },
                                {
                                    "id": "690220408",
                                    "speaker": "温迪",
                                    "text": "「干杯——」「砰——」…有了！「祝幸福」，怎么样怎么样？"
                                },
                                {
                                    "id": "690220412",
                                    "speaker": "温迪",
                                    "text": "哦，对了！能再麻烦你准备一个拿手菜吗？"
                                },
                                {
                                    "id": "690220413",
                                    "speaker": "温迪",
                                    "text": "什么都行，我喜欢吃你做的菜！",
                                    "choices": [
                                        {
                                            "id": "690220414",
                                            "text": "嗯，感觉会很开心。",
                                            "response": [
                                                {
                                                    "id": "690220415",
                                                    "speaker": "温迪",
                                                    "text": "对吧对吧，一定会很热闹。"
                                                },
                                                {
                                                    "id": "690220420",
                                                    "speaker": "温迪",
                                                    "text": "好，那就算正式开始筹办了！"
                                                },
                                                {
                                                    "id": "690220421",
                                                    "speaker": "温迪",
                                                    "text": "真是个开心的日子…今天也值得喝一杯来庆祝呢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690220416",
                                            "text": "嗯…感觉场面会很混乱。",
                                            "response": [
                                                {
                                                    "id": "690220417",
                                                    "speaker": "温迪",
                                                    "text": "嘿嘿…「乱」中作乐，也是宴会的特色嘛。"
                                                },
                                                {
                                                    "id": "690220418",
                                                    "speaker": "温迪",
                                                    "text": "放心吧，我会安排好的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690220419",
                                            "text": "我也会出力的。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690220409",
                            "text": "温迪会表演节目吗？",
                            "response": [
                                {
                                    "id": "690220410",
                                    "speaker": "温迪",
                                    "text": "可以啊，那我就久违地来一个组曲连唱吧！"
                                },
                                {
                                    "id": "690220411",
                                    "speaker": "温迪",
                                    "text": "你有什么想听的歌吗？我可以预先练习一下，当然，这用不了多久。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902205",
            "initDialog": "690220501",
            "dialogues": [
                {
                    "id": "690220501",
                    "speaker": "Player",
                    "text": "早啊，温迪。"
                },
                {
                    "id": "690220502",
                    "speaker": "温迪",
                    "text": "#早哦，{NICKNAME}，嘿嘿。"
                },
                {
                    "id": "690220503",
                    "speaker": "温迪",
                    "text": "今天要去哪里玩呢？我有很多想去的地方，要给你推荐推荐吗？"
                }
            ]
        },
        {
            "talkId": "6902206",
            "initDialog": "690220601",
            "dialogues": [
                {
                    "id": "690220601",
                    "speaker": "Player",
                    "text": "晚安，温迪。"
                },
                {
                    "id": "690220602",
                    "speaker": "温迪",
                    "text": "#哎呀，我还不想睡呢，{NICKNAME}。"
                },
                {
                    "id": "690220603",
                    "speaker": "温迪",
                    "text": "要不要再陪陪我？或者…我再陪陪你？"
                }
            ]
        },
        {
            "talkId": "6902207",
            "initDialog": "690220701",
            "dialogues": [
                {
                    "id": "690220701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6902208",
            "initDialog": "690220801",
            "dialogues": [
                {
                    "id": "690220801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6902209",
            "initDialog": "690220901",
            "dialogues": [
                {
                    "id": "690220901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6902250",
            "initDialog": "690225001",
            "dialogues": [
                {
                    "id": "690225001",
                    "speaker": "温迪",
                    "text": "公园啊，公园可是城里最惬意的地方之一。"
                },
                {
                    "id": "690225002",
                    "speaker": "温迪",
                    "text": "在公园休息的人们，大多心情舒畅，愿意静下心来，听我小唱一曲。"
                },
                {
                    "id": "690225003",
                    "speaker": "温迪",
                    "text": "欸嘿，我来和你一起，把这座公园建造得更漂亮吧。"
                }
            ]
        },
        {
            "talkId": "6902251",
            "initDialog": "690225101",
            "dialogues": [
                {
                    "id": "690225101",
                    "speaker": "温迪",
                    "text": "哦！这片果园闻起来好香，果子一定又大又甜！"
                },
                {
                    "id": "690225102",
                    "speaker": "温迪",
                    "text": "还有茂密的葡萄藤，上面沉甸甸的葡萄串，可都是将来的美酒啊…"
                },
                {
                    "id": "690225103",
                    "speaker": "温迪",
                    "text": "要不…我们先把将来的美酒享受一点？享受一点又没事。来，张嘴——"
                }
            ]
        }
    ]
}