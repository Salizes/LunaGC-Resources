    },
    "talks": [
        {
            "talkId": "6404901",
            "initDialog": "640490101",
            "dialogues": [
                {
                    "id": "640490101",
                    "speaker": "萨哈尔",
                    "text": "你好，是来大巴扎购物的游客吗？我推荐你去朱特的店哦。"
                }
            ]
        },
        {
            "talkId": "6404902",
            "initDialog": "640490201",
            "dialogues": [
                {
                    "id": "640490201",
                    "speaker": "Player",
                    "text": "为什么？"
                },
                {
                    "id": "640490202",
                    "speaker": "萨哈尔",
                    "text": "在须弥，香辛料可是必买品，而朱特的店就是这附近最好的香料商店。"
                },
                {
                    "id": "640490203",
                    "speaker": "萨哈尔",
                    "text": "不仅品质优秀，价格实惠，在他家甚至还能买到稀有的帕蒂沙兰！"
                },
                {
                    "id": "640490204",
                    "speaker": "萨哈尔",
                    "text": "他还经常会给客人赠送小礼品，所以来大巴扎的话，最不能错过的就是他家的店啦。"
                }
            ]
        },
        {
            "talkId": "6404903",
            "initDialog": "640490301",
            "dialogues": [
                {
                    "id": "640490301",
                    "speaker": "Player",
                    "text": "谢谢推荐。"
                },
                {
                    "id": "640490302",
                    "speaker": "萨哈尔",
                    "text": "不用客气，你一定会喜欢的。"
                }
            ]
        }
    ]
}