    },
    "talks": [
        {
            "talkId": "6958801",
            "initDialog": "695880101",
            "dialogues": [
                {
                    "id": "695880101",
                    "speaker": "玛薇卡",
                    "text": "这家酒馆的氛围真不错。热热闹闹，有吃有喝。嗯…我也去买几杯酒喝吧。"
                }
            ]
        },
        {
            "talkId": "6958802",
            "initDialog": "695880201",
            "dialogues": [
                {
                    "id": "695880201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958803",
            "initDialog": "695880301",
            "dialogues": [
                {
                    "id": "695880301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695880302",
                    "speaker": "玛薇卡",
                    "text": "要走了？我还要再待一会，唔…这酒的味道真不错…"
                }
            ]
        },
        {
            "talkId": "6958804",
            "initDialog": "695880401",
            "dialogues": [
                {
                    "id": "695880401",
                    "speaker": "玛薇卡",
                    "text": "真是一场不错的对局，很尽兴！战术？哈哈哈，我的战术早就用光了，打到后面，我都是凭借经验和直觉出牌。看来，这两者还算有用。"
                }
            ]
        },
        {
            "talkId": "6958805",
            "initDialog": "695880501",
            "dialogues": [
                {
                    "id": "695880501",
                    "speaker": "玛薇卡",
                    "text": "你赢得很漂亮。不过…「七圣召唤」的牌组居然还有这种构筑，可以的话，能让我看看你的牌组吗？"
                }
            ]
        },
        {
            "talkId": "6958806",
            "initDialog": "695880601",
            "dialogues": [
                {
                    "id": "695880601",
                    "speaker": "玛薇卡",
                    "text": "打牌？好啊，我对「七圣召唤」也算是有点研究。"
                }
            ]
        },
        {
            "talkId": "6958808",
            "initDialog": "695880801",
            "dialogues": [
                {
                    "id": "695880801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958809",
            "initDialog": "695880901",
            "dialogues": [
                {
                    "id": "695880901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958810",
            "initDialog": "695881001",
            "dialogues": [
                {
                    "id": "695881001",
                    "speaker": "玛薇卡",
                    "text": "我赢了，看来我打牌的思路还没有过时啊。"
                }
            ]
        },
        {
            "talkId": "6958811",
            "initDialog": "695881101",
            "dialogues": [
                {
                    "id": "695881101",
                    "speaker": "玛薇卡",
                    "text": "我输了。好吧，看来我的出牌思路还是有些过时了。"
                }
            ]
        },
        {
            "talkId": "6958812",
            "initDialog": "695881201",
            "dialogues": [
                {
                    "id": "695881201",
                    "speaker": "玛薇卡",
                    "text": "没问题，来痛痛快快地玩一局牌吧，无需忧心胜负，享受牌局就好。"
                }
            ]
        },
        {
            "talkId": "6958814",
            "initDialog": "695881401",
            "dialogues": [
                {
                    "id": "695881401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958815",
            "initDialog": "695881501",
            "dialogues": [
                {
                    "id": "695881501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958816",
            "initDialog": "695881601",
            "dialogues": [
                {
                    "id": "695881601",
                    "speaker": "玛薇卡",
                    "text": "哈哈哈，我玩得很痛快，要再来一局的话，我随时奉陪。"
                }
            ]
        },
        {
            "talkId": "6958817",
            "initDialog": "695881701",
            "dialogues": [
                {
                    "id": "695881701",
                    "speaker": "玛薇卡",
                    "text": "赢得很漂亮，怎么样，玩得还开心么？稍后想再来一局的话，我可以奉陪。"
                }
            ]
        },
        {
            "talkId": "6958818",
            "initDialog": "695881801",
            "dialogues": [
                {
                    "id": "695881801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
