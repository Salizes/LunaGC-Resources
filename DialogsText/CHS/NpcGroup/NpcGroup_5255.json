{
    "groupId": "5255",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "孔雅": 12
    },
    "talks": [
        {
            "talkId": "5900154",
            "initDialog": "590015401",
            "dialogues": [
                {
                    "id": "590015401",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900155",
            "initDialog": "590015501",
            "dialogues": [
                {
                    "id": "590015501",
                    "speaker": "孔雅",
                    "text": "您想参观那个浮在空中的「中央实验室」吗？不想去的话，嗯…好像也没别的什么了。"
                }
            ]
        },
        {
            "talkId": "6525501",
            "initDialog": "652550101",
            "dialogues": [
                {
                    "id": "652550101",
                    "speaker": "孔雅",
                    "text": "真的会有人愿意来这里参观吗…"
                }
            ]
        },
        {
            "talkId": "6525502",
            "initDialog": "652550201",
            "dialogues": [
                {
                    "id": "652550201",
                    "speaker": "Player",
                    "text": "关于参观…"
                },
                {
                    "id": "652550202",
                    "speaker": "孔雅",
                    "text": "您好，荣誉高级研究员。您是想问「这里有什么可参观的」吗？"
                },
                {
                    "id": "652550203",
                    "speaker": "孔雅",
                    "text": "如果非要说具体参观地点…那应该就是那个浮在空中的「中央实验室」了吧。"
                },
                {
                    "id": "652550204",
                    "speaker": "孔雅",
                    "text": "根据雷蒙多和舒瓦瑟尔先生的说法，之后科学院会将「中央实验室」的废墟重建为「安全展览院」。"
                },
                {
                    "id": "652550205",
                    "speaker": "孔雅",
                    "text": "并且在里面展示科学院之前的各种科研项目画片…"
                },
                {
                    "id": "652550206",
                    "speaker": "孔雅",
                    "text": "但是…科研项目画片和「安全展览院」又有什么关系呢…"
                },
                {
                    "id": "652550207",
                    "speaker": "孔雅",
                    "text": "而且，这样的展览真的有人会愿意来参观吗…"
                }
            ]
        },
        {
            "talkId": "6525503",
            "initDialog": "652550301",
            "dialogues": [
                {
                    "id": "652550301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652550302",
                    "speaker": "孔雅",
                    "text": "再见，我也要继续工作了…"
                }
            ]
        },
        {
            "talkId": "6525504",
            "initDialog": "652550401",
            "dialogues": [
                {
                    "id": "652550401",
                    "speaker": "Player",
                    "text": "还有其他参观地点吗？"
                },
                {
                    "id": "652550402",
                    "speaker": "孔雅",
                    "text": "舒瓦瑟尔先生说，之后会把「学术会堂」整饬一遍，将其重新启用，定时展示科学院的科研产品。"
                },
                {
                    "id": "652550403",
                    "speaker": "孔雅",
                    "text": "但是，现在能够展示的产品，应该也只有奇械舞者一类的发条人偶了吧…"
                },
                {
                    "id": "652550404",
                    "speaker": "孔雅",
                    "text": "实在不行，就只能去重新整修一下玛丽安纪念公园了，那边的风景至少还算不错…"
                }
            ]
        }
    ]
}