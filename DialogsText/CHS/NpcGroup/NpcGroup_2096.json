{
    "groupId": "2096",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "甜甜": 16
    },
    "talks": [
        {
            "talkId": "6209601",
            "initDialog": "620960101",
            "dialogues": [
                {
                    "id": "620960101",
                    "speaker": "甜甜",
                    "text": "嗨，对冒险感兴趣吗？"
                },
                {
                    "id": "620960102",
                    "speaker": "甜甜",
                    "text": "如果喜欢野外生存、潜水、风之翼极限竞速的话，那就来冒险家协会吧！"
                }
            ]
        },
        {
            "talkId": "6209602",
            "initDialog": "620960201",
            "dialogues": [
                {
                    "id": "620960201",
                    "speaker": "甜甜",
                    "text": "你是？"
                },
                {
                    "id": "620960202",
                    "speaker": "甜甜",
                    "text": "我是冒险家协会新来的宣传员！"
                },
                {
                    "id": "620960203",
                    "speaker": "甜甜",
                    "text": "根据上面的要求来拉些新人入会！"
                },
                {
                    "id": "620960204",
                    "speaker": "甜甜",
                    "text": "…哦，另外要是你对野外探险、登山之类的也有兴趣的话，也可以来加入我们哦！"
                }
            ]
        },
        {
            "talkId": "6209603",
            "initDialog": "620960301",
            "dialogues": [
                {
                    "id": "620960301",
                    "speaker": "甜甜",
                    "text": "冒险家协会是做这些的吗？"
                },
                {
                    "id": "620960302",
                    "speaker": "甜甜",
                    "text": "当然了，要不然为什么叫「冒险」家协会呢？"
                },
                {
                    "id": "620960303",
                    "speaker": "甜甜",
                    "text": "哼哼，别看我这样，实际上我可是冒险的内行！"
                },
                {
                    "id": "620960304",
                    "speaker": "甜甜",
                    "text": "…因为我已经把万文集舍所有关于「冒险」的书都看过了！绝不会弄错的！"
                },
                {
                    "id": "620960305",
                    "speaker": "甜甜",
                    "text": "冒险家不是该完成委托吗？"
                },
                {
                    "id": "620960306",
                    "speaker": "甜甜",
                    "text": "委托…我懂了，是那种害怕出意外、又想要体验危险的有钱人，出钱雇佣我们一起去野外生活的委托吧？"
                },
                {
                    "id": "620960307",
                    "speaker": "甜甜",
                    "text": "相信我，只要给我一把小刀，我有自信能在无论任何环境生存下去！"
                },
                {
                    "id": "620960308",
                    "speaker": "甜甜",
                    "text": "如果你加入冒险家协会的话，一定可以变得像我一样厉害的！委托什么的自然不在话下！"
                }
            ]
        },
        {
            "talkId": "6209604",
            "initDialog": "620960401",
            "dialogues": [
                {
                    "id": "620960401",
                    "speaker": "甜甜",
                    "text": "再见。"
                },
                {
                    "id": "620960402",
                    "speaker": "甜甜",
                    "text": "感兴趣就来加入我们吧！很好玩的！"
                }
            ]
        }
    ]
}