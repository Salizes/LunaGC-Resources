{
    "groupId": "2116",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "一阔": 9
    },
    "talks": [
        {
            "talkId": "7194401",
            "initDialog": "719440101",
            "dialogues": [
                {
                    "id": "719440101",
                    "speaker": "Player",
                    "text": "你说的也不是没有道理…"
                },
                {
                    "id": "719440102",
                    "speaker": "一阔",
                    "text": "对吧？而且人生苦短，每天都那么拼命也不是不行…但这一切值得吗？"
                },
                {
                    "id": "719440103",
                    "speaker": "一阔",
                    "text": "与其像我的同僚那样把一切都奉献给工作，这样忙里偷闲才更好吧？"
                },
                {
                    "id": "719440104",
                    "speaker": "一阔",
                    "text": "人生何其漫长，何必忙忙碌碌、奋力追赶？"
                },
                {
                    "id": "719440105",
                    "speaker": "一阔",
                    "text": "所以啊，你也不用那么着急，坐下休息休息，喝喝茶、尝尝这炸萝卜丸子…知足常乐，何必庸人自扰？"
                }
            ]
        },
        {
            "talkId": "6211601",
            "initDialog": "621160101",
            "dialogues": [
                {
                    "id": "621160101",
                    "speaker": "一阔",
                    "text": "啊？有事吗？"
                }
            ]
        },
        {
            "talkId": "6211602",
            "initDialog": "621160201",
            "dialogues": [
                {
                    "id": "621160201",
                    "speaker": "Player",
                    "text": "你是在偷懒吗？"
                },
                {
                    "id": "621160202",
                    "speaker": "一阔",
                    "text": "怎么能这么说呢，是忙里偷闲，忙里偷闲而已。"
                },
                {
                    "id": "621160203",
                    "speaker": "一阔",
                    "text": "我忙的时候你又没看到，你说不是么？"
                }
            ]
        },
        {
            "talkId": "6211603",
            "initDialog": "621160301",
            "dialogues": [
                {
                    "id": "621160301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621160302",
                    "speaker": "一阔",
                    "text": "嗯，千岩牢固，重嶂不移，快去吧。"
                },
                {
                    "id": "621160303",
                    "speaker": "一阔",
                    "text": "哦对了，见到教头的话可别说我在这儿啊。"
                }
            ]
        }
    ]
}