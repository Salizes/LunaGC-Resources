{
    "groupId": "4341",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "达纳": 15
    },
    "talks": [
        {
            "talkId": "6434101",
            "initDialog": "643410101",
            "dialogues": [
                {
                    "id": "643410101",
                    "speaker": "达纳",
                    "text": "等待这件事，真令人度日如年啊…"
                }
            ]
        },
        {
            "talkId": "6434102",
            "initDialog": "643410201",
            "dialogues": [
                {
                    "id": "643410201",
                    "speaker": "Player",
                    "text": "你在等什么？"
                },
                {
                    "id": "643410202",
                    "speaker": "达纳",
                    "text": "在等待一个决定我毕生命运的结果！"
                },
                {
                    "id": "643410203",
                    "speaker": "达纳",
                    "text": "…就是我的毕业留校申请啦。"
                },
                {
                    "id": "643410204",
                    "speaker": "达纳",
                    "text": "听说最近加入教令院的竞争越来越激烈了，每天都有人给齐米娅老师推荐简历，我还能有机会吗…"
                },
                {
                    "id": "643410205",
                    "speaker": "达纳",
                    "text": "不行，要自信一点。从我毕业论文的研究成果上来看，还是很有优势的。"
                }
            ]
        },
        {
            "talkId": "6434103",
            "initDialog": "643410301",
            "dialogues": [
                {
                    "id": "643410301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643410302",
                    "speaker": "达纳",
                    "text": "树王大人保佑，请让我的申请顺利通过吧…"
                }
            ]
        },
        {
            "talkId": "6434104",
            "initDialog": "643410401",
            "dialogues": [
                {
                    "id": "643410401",
                    "speaker": "Player",
                    "text": "关于你的成果…"
                },
                {
                    "id": "643410402",
                    "speaker": "达纳",
                    "text": "是关于帕蒂沙兰的课题。"
                },
                {
                    "id": "643410403",
                    "speaker": "达纳",
                    "text": "你知道，帕蒂沙兰因为生长条件苛刻，目前只有少数地方能够人工培育。"
                },
                {
                    "id": "643410404",
                    "speaker": "达纳",
                    "text": "如果有办法研究出生长更稳定的品种，就能大大提高帕蒂沙兰的培育效率。"
                },
                {
                    "id": "643410405",
                    "speaker": "达纳",
                    "text": "在我的毕业论文中已经提出了一种颇见成效的方案。如果能在毕业后继续留校研究的话，我相信一定会得到更大的突破。"
                }
            ]
        },
        {
            "talkId": "6434105",
            "initDialog": "643410501",
            "dialogues": [
                {
                    "id": "643410501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643410502",
                    "speaker": "达纳",
                    "text": "草神大人保佑，请让我的申请顺利通过吧…"
                }
            ]
        },
        {
            "talkId": "7395501",
            "initDialog": "739550101",
            "dialogues": [
                {
                    "id": "739550101",
                    "speaker": "Player",
                    "text": "听着靠谱。"
                },
                {
                    "id": "739550102",
                    "speaker": "达纳",
                    "text": "听你这么说，我安心了一些。"
                },
                {
                    "id": "739550103",
                    "speaker": "达纳",
                    "text": "总之我已尽人事，现在只等命运的安排。"
                },
                {
                    "id": "739550104",
                    "speaker": "达纳",
                    "text": "对了，你看，这些就是我在研究过程中培育出的帕蒂沙兰。"
                },
                {
                    "id": "739550105",
                    "speaker": "达纳",
                    "text": "香味十分迷人，对吧？这些就赠与你吧，希望我们都能得偿所愿。"
                }
            ]
        }
    ]
}