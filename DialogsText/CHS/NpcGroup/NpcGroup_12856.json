{
    "groupId": "12856",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "埃尔欣根": 6,
        "派蒙": 3
    },
    "talks": [
        {
            "talkId": "4008416",
            "initDialog": "400841601",
            "dialogues": [
                {
                    "id": "400841601",
                    "speaker": "埃尔欣根",
                    "text": "哦，是你们两位？"
                },
                {
                    "id": "400841602",
                    "speaker": "派蒙",
                    "text": "没想到能在这里碰见埃尔欣根先生！"
                },
                {
                    "id": "400841603",
                    "speaker": "埃尔欣根",
                    "text": "恭喜你们进入决赛，你们和海妮耶的对决，还有之后的最终考验，将是本次大赛最精彩的环节。"
                },
                {
                    "id": "400841604",
                    "speaker": "埃尔欣根",
                    "text": "备战之余四处走走，保持良好的状态，的确是很有效的调节手段。",
                    "choices": [
                        {
                            "id": "400841605",
                            "text": "你在忙什么？",
                            "response": [
                                {
                                    "id": "400841607",
                                    "speaker": "埃尔欣根",
                                    "text": "只是想静一静，思考你们带给我的启示罢了。"
                                },
                                {
                                    "id": "400841608",
                                    "speaker": "埃尔欣根",
                                    "text": "现在我更加确信了——主人和仆从的关系，会因为仆从表现良好而急剧升温…"
                                },
                                {
                                    "id": "400841609",
                                    "speaker": "派蒙",
                                    "text": "主人？仆从？这和我们有什么关系…",
                                    "choices": [
                                        {
                                            "id": "400841610",
                                            "text": "那就先不打扰你了。",
                                            "response": [
                                                {
                                                    "id": "400841612",
                                                    "speaker": "派蒙",
                                                    "text": "咦？唔…没错！下次见面的时候，我们有很重要的事要告诉你！"
                                                },
                                                {
                                                    "id": "400841613",
                                                    "speaker": "埃尔欣根",
                                                    "text": "好啊，我恭候着你们的到来，祝你们备战顺利。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400841611",
                                            "text": "下次见面再长谈吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400841606",
                            "text": "一个人待在这里…"
                        }
                    ]
                }
            ]
        }
    ]
}