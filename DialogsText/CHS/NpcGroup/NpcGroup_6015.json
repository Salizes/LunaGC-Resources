{
    "groupId": "6015",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "蒂索克": 10
    },
    "talks": [
        {
            "talkId": "6601501",
            "initDialog": "660150101",
            "dialogues": [
                {
                    "id": "660150101",
                    "speaker": "蒂索克",
                    "text": "哎呀，一直这样，怪不好意思的…"
                }
            ]
        },
        {
            "talkId": "6601502",
            "initDialog": "660150201",
            "dialogues": [
                {
                    "id": "660150201",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "660150202",
                    "speaker": "蒂索克",
                    "text": "啊，是这样的，我是定期来给夏安卡大姐送食材的供应商。"
                },
                {
                    "id": "660150203",
                    "speaker": "蒂索克",
                    "text": "只是因为偶尔帮忙搬搬货物，大姐就坚持要留我吃饭。"
                },
                {
                    "id": "660150204",
                    "speaker": "蒂索克",
                    "text": "我这个人呢，食量还挺大的…总是不花钱在这里吃东西，怪不好意思的…"
                }
            ]
        },
        {
            "talkId": "6601503",
            "initDialog": "660150301",
            "dialogues": [
                {
                    "id": "660150301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660150302",
                    "speaker": "蒂索克",
                    "text": "哎，慢走。"
                }
            ]
        },
        {
            "talkId": "6601504",
            "initDialog": "660150401",
            "dialogues": [
                {
                    "id": "660150401",
                    "speaker": "Player",
                    "text": "老板人不错哦。"
                },
                {
                    "id": "660150402",
                    "speaker": "蒂索克",
                    "text": "是啊，夏安卡大姐是这样的。"
                },
                {
                    "id": "660150403",
                    "speaker": "蒂索克",
                    "text": "你知道吗，她以前可是在归火圣夜巡礼上名列前茅的名战士呢！"
                },
                {
                    "id": "660150404",
                    "speaker": "蒂索克",
                    "text": "只是后来在巡夜者战争里腿受了重伤，之后就只能离开战场了。"
                },
                {
                    "id": "660150405",
                    "speaker": "蒂索克",
                    "text": "以前有不少人因为大姐的名气来这里吃饭呢，不过大姐不是很喜欢人们对她的事迹侃侃而谈…"
                },
                {
                    "id": "660150406",
                    "speaker": "蒂索克",
                    "text": "哎呀，我也不多说了吧。总之，这里有个很可靠的老板，是个好地方。"
                }
            ]
        }
    ]
}