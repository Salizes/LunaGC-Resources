{
    "groupId": "6102",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "汉扎": 11
    },
    "talks": [
        {
            "talkId": "6610201",
            "initDialog": "661020101",
            "dialogues": [
                {
                    "id": "661020101",
                    "speaker": "汉扎",
                    "text": "呼…终于换上新衣服了，舒服！"
                }
            ]
        },
        {
            "talkId": "6610202",
            "initDialog": "661020201",
            "dialogues": [
                {
                    "id": "661020201",
                    "speaker": "Player",
                    "text": "之前的衣服怎么了？"
                },
                {
                    "id": "661020202",
                    "speaker": "汉扎",
                    "text": "坏掉了呗。"
                },
                {
                    "id": "661020203",
                    "speaker": "汉扎",
                    "text": "很正常啦，挑战极限总是要付出代价的！只是一身衣服而已，我还是付得起的。"
                },
                {
                    "id": "661020204",
                    "speaker": "汉扎",
                    "text": "不过的确得承认，不带防具在不足半米宽的山脊上踩滑板是有点离谱。"
                },
                {
                    "id": "661020205",
                    "speaker": "汉扎",
                    "text": "幸好当时身边有我最最最亲爱的龙朋友！加塔力可是一直跟着我的…欸，加塔力？去哪了？"
                },
                {
                    "id": "661020206",
                    "speaker": "汉扎",
                    "text": "奇怪，刚刚还在身边的…"
                }
            ]
        },
        {
            "talkId": "6610203",
            "initDialog": "661020301",
            "dialogues": [
                {
                    "id": "661020301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "661020302",
                    "speaker": "汉扎",
                    "text": "再见，你的衣服也很好看！"
                }
            ]
        },
        {
            "talkId": "6610204",
            "initDialog": "661020401",
            "dialogues": [
                {
                    "id": "661020401",
                    "speaker": "Player",
                    "text": "没准去休息了。"
                },
                {
                    "id": "661020402",
                    "speaker": "汉扎",
                    "text": "噢，有可能。不过我记得它体力没有那么差的啊？"
                },
                {
                    "id": "661020403",
                    "speaker": "汉扎",
                    "text": "…哈哈，也可能是害羞了吧？"
                },
                {
                    "id": "661020404",
                    "speaker": "汉扎",
                    "text": "匿叶龙是这样的，它们不太习惯和人类一直待在一起，可能因为我们太热情了吧。"
                },
                {
                    "id": "661020405",
                    "speaker": "汉扎",
                    "text": "没关系，给它一点时间，总有一天它也会变得和我一样开朗的！"
                }
            ]
        }
    ]
}