{
    "groupId": "5304",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "卡莉珀丝": 12
    },
    "talks": [
        {
            "talkId": "6530401",
            "initDialog": "653040101",
            "dialogues": [
                {
                    "id": "653040101",
                    "speaker": "卡莉珀丝",
                    "text": "哼哼，「真视药剂」大获成功，感觉还能改出好几个配方…嗯，具体的配比就交给薇蕾去试吧。"
                },
                {
                    "id": "653040102",
                    "speaker": "卡莉珀丝",
                    "text": "哎呀，怎么了，难道是有想要委托本人制作的药剂吗？"
                }
            ]
        },
        {
            "talkId": "6530402",
            "initDialog": "653040201",
            "dialogues": [
                {
                    "id": "653040201",
                    "speaker": "Player",
                    "text": "关于药剂制作…"
                },
                {
                    "id": "653040202",
                    "speaker": "卡莉珀丝",
                    "text": "哦，居然对药剂制作感兴趣，看来你也是个沉醉于「可能性」的家伙呢，不错不错。"
                },
                {
                    "id": "653040203",
                    "speaker": "卡莉珀丝",
                    "text": "你看，所谓的制药啊…"
                },
                {
                    "id": "653040204",
                    "speaker": "卡莉珀丝",
                    "text": "就是把本来没有什么效果的材料处理完，加到一起，却能一下变成有各种效果的药剂！"
                },
                {
                    "id": "653040205",
                    "speaker": "卡莉珀丝",
                    "text": "就像是以记忆中各种事物的印象为材料，结合了梦一般闪过的奇思，创造出了新的「真实」。"
                },
                {
                    "id": "653040206",
                    "speaker": "卡莉珀丝",
                    "text": "而且，具体能做出什么样的药剂，连本人自己都不知道！这就是「药剂师」的刺激之处了，很有趣吧。"
                }
            ]
        },
        {
            "talkId": "6530403",
            "initDialog": "653040301",
            "dialogues": [
                {
                    "id": "653040301",
                    "speaker": "Player",
                    "text": "关于助手…"
                },
                {
                    "id": "653040302",
                    "speaker": "卡莉珀丝",
                    "text": "助手，哎呀，你是说薇蕾啊。薇蕾做事特别认真，药剂的配比和实验有她来跟进真是太好了。"
                },
                {
                    "id": "653040303",
                    "speaker": "卡莉珀丝",
                    "text": "能够协助完成本人药剂试验的人只有她了…"
                },
                {
                    "id": "653040304",
                    "speaker": "卡莉珀丝",
                    "text": "啊，还有，有些药剂的名字也是她帮忙取的，比如「真视药剂」就是。"
                },
                {
                    "id": "653040305",
                    "speaker": "卡莉珀丝",
                    "text": "不过「真视药剂」的名字我觉得稍微有一点点死板，哎呀，果然还是本人取的「暖洋洋药水」比较可爱…"
                }
            ]
        },
        {
            "talkId": "6530404",
            "initDialog": "653040401",
            "dialogues": [
                {
                    "id": "653040401",
                    "speaker": "Player",
                    "text": "不，只是偶然路过。"
                },
                {
                    "id": "653040402",
                    "speaker": "卡莉珀丝",
                    "text": "我还以为你又来试药了呢，真可惜…啊，我是说，这里永远欢迎你再来哦。"
                }
            ]
        }
    ]
}