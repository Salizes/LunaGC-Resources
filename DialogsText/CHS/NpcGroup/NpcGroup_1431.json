{
    "groupId": "1431",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 10,
        "玛格丽特": 27
    },
    "talks": [
        {
            "talkId": "7091001",
            "initDialog": "709100101",
            "dialogues": [
                {
                    "id": "709100101",
                    "speaker": "Player",
                    "text": "最近有什么活动吗？"
                },
                {
                    "id": "709100102",
                    "speaker": "玛格丽特",
                    "text": "是呢，最近「天使的馈赠」在赠送野菇鸡肉串呢，为了应对我们也在搞活动哦。"
                },
                {
                    "id": "709100103",
                    "speaker": "玛格丽特",
                    "text": "既然是「猫尾酒馆」，那我们的主打下酒菜自然就是蒙德烤鱼啦！"
                },
                {
                    "id": "709100104",
                    "speaker": "玛格丽特",
                    "text": "总之这些烤鱼你就收下吧，有空欢迎来我们那边坐坐哦。"
                }
            ]
        },
        {
            "talkId": "40170",
            "initDialog": "4015143101",
            "dialogues": [
                {
                    "id": "4015143101",
                    "speaker": "玛格丽特",
                    "text": "哎呀，现在才来搭话呢，我早就注意到你了——在广场里乱晃的外乡人可是很显眼的。"
                }
            ]
        },
        {
            "talkId": "41721",
            "initDialog": "4015143103",
            "dialogues": [
                {
                    "id": "4015143103",
                    "speaker": "Player",
                    "text": "那个…关于你自己…"
                },
                {
                    "id": "4015143108",
                    "speaker": "玛格丽特",
                    "text": "我？只是一个普通的酒馆老板而已。"
                },
                {
                    "id": "4015143109",
                    "speaker": "玛格丽特",
                    "text": "你是从那边走过来的话，肯定有注意到我的猫尾酒馆吧。"
                }
            ]
        },
        {
            "talkId": "41722",
            "initDialog": "4015143104",
            "dialogues": [
                {
                    "id": "4015143104",
                    "speaker": "Player",
                    "text": "关于酒馆。"
                },
                {
                    "id": "4015143110",
                    "speaker": "玛格丽特",
                    "text": "虽然很不甘心，但是蒙德城里最好的酒馆当然是「天使的馈赠」啦——"
                },
                {
                    "id": "4015143111",
                    "speaker": "玛格丽特",
                    "text": "不过自从雇了可爱的小迪奥娜来当酒保，「猫尾酒馆」的生意倒是比原来好了很多。"
                },
                {
                    "id": "4015143112",
                    "speaker": "玛格丽特",
                    "text": "不管那些客人的目标到底是酒还是酒保…至少我都可以坐着数钱了呢，呵呵。"
                }
            ]
        },
        {
            "talkId": "6143101",
            "initDialog": "614310101",
            "dialogues": [
                {
                    "id": "614310101",
                    "speaker": "玛格丽特",
                    "text": "又按捺不住…想来找我搭话了么？"
                },
                {
                    "id": "614310102",
                    "speaker": "玛格丽特",
                    "text": "…呵呵，倒也没关系，毕竟上次「小王子」的事多亏了你的帮忙呢。"
                }
            ]
        },
        {
            "talkId": "6143102",
            "initDialog": "614310201",
            "dialogues": [
                {
                    "id": "614310201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "614310202",
                    "speaker": "玛格丽特",
                    "text": "在等人邀请我去酒馆小酌几杯呢，你愿意邀请我去么？"
                },
                {
                    "id": "614310203",
                    "speaker": "玛格丽特",
                    "text": "开个玩笑啦，别这么拘谨，蒙德可是浪漫的牧歌之城呢。"
                }
            ]
        },
        {
            "talkId": "6143103",
            "initDialog": "614310301",
            "dialogues": [
                {
                    "id": "614310301",
                    "speaker": "Player",
