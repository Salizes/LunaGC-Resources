{
    "groupId": "9308",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "行秋": 9
    },
    "talks": [
        {
            "talkId": "6930801",
            "initDialog": "693080101",
            "dialogues": [
                {
                    "id": "693080101",
                    "speaker": "行秋",
                    "text": "这里藏书甚多，刚刚我粗略浏览了一番，发现有不少值得一品。"
                },
                {
                    "id": "693080102",
                    "speaker": "行秋",
                    "text": "如果你没有别的紧要事，不妨先落座，待我找几本合适的书推荐给你。"
                },
                {
                    "id": "693080103",
                    "speaker": "行秋",
                    "text": "品读佳作，也算是一种「忙里偷闲」吧。"
                }
            ]
        },
        {
            "talkId": "6930802",
            "initDialog": "693080201",
            "dialogues": [
                {
                    "id": "693080201",
                    "speaker": "行秋",
                    "text": "我时常遭逢恶敌。来者兵刃锐利，气焰乖张，此时如若心生退意，只会让对方更加嚣张。"
                },
                {
                    "id": "693080202",
                    "speaker": "行秋",
                    "text": "行侠之人，哪怕身陷苦战，也要在险中力求一胜。"
                },
                {
                    "id": "693080203",
                    "speaker": "行秋",
                    "text": "但现在我并非单枪匹马…我们就互相照应喽？"
                }
            ]
        },
        {
            "talkId": "6930803",
            "initDialog": "693080301",
            "dialogues": [
                {
                    "id": "693080301",
                    "speaker": "行秋",
                    "text": "这本小书着实有趣。且不说它的情节如何生动，就连人物也丝毫不落俗套。"
                },
                {
                    "id": "693080302",
                    "speaker": "行秋",
                    "text": "#{NICKNAME}，多谢你邀请我来这样的好地方。"
                },
                {
                    "id": "693080303",
                    "speaker": "行秋",
                    "text": "下回我若是见到了什么有趣的小说，一定也给你多带一份。"
                }
            ]
        }
    ]
}