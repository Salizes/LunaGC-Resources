{
    "groupId": "7580",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "塔佩兹尼科夫": 9
    },
    "talks": [
        {
            "talkId": "6758001",
            "initDialog": "675800101",
            "dialogues": [
                {
                    "id": "675800101",
                    "speaker": "塔佩兹尼科夫",
                    "text": "白沙皇在位期间，到底从影域中挖掘出了多少科技造物？"
                }
            ]
        },
        {
            "talkId": "6758002",
            "initDialog": "675800201",
            "dialogues": [
                {
                    "id": "675800201",
                    "speaker": "Player",
                    "text": "关于权限卡…"
                },
                {
                    "id": "675800202",
                    "speaker": "塔佩兹尼科夫",
                    "text": "我对于这种权限卡也不是完全了解，目前可以确认的是，在很多类似的遗迹中，它都能派上大用场，无论是启动机关还是解除屏障。"
                },
                {
                    "id": "675800203",
                    "speaker": "塔佩兹尼科夫",
                    "text": "另外，从影域中收集到的资源可以被用来升级它的权限等级。很显然，要想解锁更多的用途，就需要获得更高的权限。"
                }
            ]
        },
        {
            "talkId": "6758003",
            "initDialog": "675800301",
            "dialogues": [
                {
                    "id": "675800301",
                    "speaker": "Player",
                    "text": "白沙皇？"
                },
                {
                    "id": "675800302",
                    "speaker": "塔佩兹尼科夫",
                    "text": "这是个十分有名的传言——白沙皇在位期间，他手下有个神秘组织经常从影域中发掘科技造物，并加以利用。"
                },
                {
                    "id": "675800303",
                    "speaker": "塔佩兹尼科夫",
                    "text": "据说，这种发掘行动到现在也没有停止，只是主导这种行动的已经变成了某些组织的野心。"
                }
            ]
        },
        {
            "talkId": "6758004",
            "initDialog": "675800401",
            "dialogues": [
                {
                    "id": "675800401",
                    "speaker": "Player",
                    "text": "关于你…"
                },
                {
                    "id": "675800402",
                    "speaker": "塔佩兹尼科夫",
                    "text": "我经常会被别人称作「书呆子」，为了一些研究资料，把买晶矿的钱花掉了…多亏了呼啸社的接济，我才没有被冻成冰棍。"
                },
                {
                    "id": "675800403",
                    "speaker": "塔佩兹尼科夫",
                    "text": "但是我对于影域科技的好奇心还是改不了啊，所以希望能在这方面帮到大家。"
                }
            ]
        },
        {
            "talkId": "6758005",
            "initDialog": "675800501",
            "dialogues": [
                {
                    "id": "675800501",
                    "speaker": "Player",
                    "text": "感谢你的帮助。"
                },
                {
                    "id": "675800502",
                    "speaker": "塔佩兹尼科夫",
                    "text": "哪里的话，我才需要感谢你呢。"
                },
                {
                    "id": "675800503",
                    "speaker": "塔佩兹尼科夫",
                    "text": "这种获得一手资料的机会，可不是天天都有。"
                }
            ]
        }
    ]
}