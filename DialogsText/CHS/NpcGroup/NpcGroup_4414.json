{
    "groupId": "4414",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "法加娜": 16
    },
    "talks": [
        {
            "talkId": "6441401",
            "initDialog": "644140101",
            "dialogues": [
                {
                    "id": "644140101",
                    "speaker": "法加娜",
                    "text": "云彩…就像天上的画框。"
                },
                {
                    "id": "644140102",
                    "speaker": "法加娜",
                    "text": "如果有足以匹敌神明的智慧…就能在天上画画了吗？"
                }
            ]
        },
        {
            "talkId": "6441402",
            "initDialog": "644140201",
            "dialogues": [
                {
                    "id": "644140201",
                    "speaker": "Player",
                    "text": "你好…？"
                },
                {
                    "id": "644140202",
                    "speaker": "法加娜",
                    "text": "呜…大概也不行吧。"
                },
                {
                    "id": "644140203",
                    "speaker": "法加娜",
                    "text": "神明之上，还有高天…高天之上，还有星辰…"
                },
                {
                    "id": "644140204",
                    "speaker": "法加娜",
                    "text": "…没有什么是万能的。"
                }
            ]
        },
        {
            "talkId": "6441403",
            "initDialog": "644140301",
            "dialogues": [
                {
                    "id": "644140301",
                    "speaker": "Player",
                    "text": "（好像没法沟通，还是算了。）"
                },
                {
                    "id": "644140302",
                    "speaker": "法加娜",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6441404",
            "initDialog": "644140401",
            "dialogues": [
                {
                    "id": "644140401",
                    "speaker": "法加娜",
                    "text": "你好，请问是塞塔蕾派来的信使吗？"
                }
            ]
        },
        {
            "talkId": "6441405",
            "initDialog": "644140501",
            "dialogues": [
                {
                    "id": "644140501",
                    "speaker": "Player",
                    "text": "塞塔蕾？"
                },
                {
                    "id": "644140502",
                    "speaker": "法加娜",
                    "text": "欸？"
                },
                {
                    "id": "644140503",
                    "speaker": "法加娜",
                    "text": "…抱歉，我是最近才从阿如村回到教令院的。会和我搭话的人不多，我就下意识地以为你是塞塔蕾的朋友了。"
                }
            ]
        },
        {
            "talkId": "6441406",
            "initDialog": "644140601",
            "dialogues": [
                {
                    "id": "644140601",
                    "speaker": "Player",
                    "text": "你可能认错人了。"
                },
                {
                    "id": "644140602",
                    "speaker": "法加娜",
                    "text": "啊，对不起！是我冒昧了…"
                }
            ]
        },
        {
            "talkId": "6441407",
            "initDialog": "644140701",
            "dialogues": [
                {
                    "id": "644140701",
                    "speaker": "Player",
                    "text": "阿如村…"
                },
                {
                    "id": "644140702",
                    "speaker": "法加娜",
                    "text": "我曾经是阿如村的「守村人」…至少村民们是这么告诉我的。"
                },
                {
                    "id": "644140703",
                    "speaker": "法加娜",
                    "text": "所谓的「守村人」，就是曾经被流放到阿如村的学者。但说实话，我不太记得自己在那边的经历了。"
                },
                {
                    "id": "644140704",
                    "speaker": "法加娜",
                    "text": "就好像做了一场梦，醒来后什么都不记得，但是头脑却十分清醒。"
                },
                {
                    "id": "644140705",
                    "speaker": "法加娜",
                    "text": "后来一位叫塞塔蕾的小姐托人帮我办理了回到教令院的手续，过程有些繁琐，所以我很感谢她。"
                },
                {
                    "id": "644140706",
                    "speaker": "法加娜",
                    "text": "她现在应该在阿如村忙着进行教育工作吧，我也会在这边帮她找些需要的资料，比如关于基础建设之类的书籍…"
                },
                {
                    "id": "644140707",
                    "speaker": "法加娜",
                    "text": "等我整理好了，再和她联系吧。"
                }
            ]
        }
    ]
}