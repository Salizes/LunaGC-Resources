    "talks": [
        {
            "talkId": "6959501",
            "initDialog": "695950101",
            "dialogues": [
                {
                    "id": "695950101",
                    "speaker": "伊法",
                    "text": "喂，咔库库，你觉得这张牌怎么样，要不要加入牌组？"
                },
                {
                    "id": "695950102",
                    "speaker": "咔库库",
                    "text": "厉害啊，哥们！"
                }
            ]
        },
        {
            "talkId": "6959502",
            "initDialog": "695950201",
            "dialogues": [
                {
                    "id": "695950201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959503",
            "initDialog": "695950301",
            "dialogues": [
                {
                    "id": "695950301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695950302",
                    "speaker": "伊法",
                    "text": "哦呀，时间不早，我也该回去了，下次再和你玩牌。走了，咔库库。"
                },
                {
                    "id": "695950303",
                    "speaker": "咔库库",
                    "text": "真的假的，哥们，你在胡说什么…"
                }
            ]
        },
        {
            "talkId": "6959504",
            "initDialog": "695950401",
            "dialogues": [
                {
                    "id": "695950401",
                    "speaker": "伊法",
                    "text": "今天难道是我的幸运日？来，吃点我带的零食，也分享一点我的好运，我们再来一把。"
                }
            ]
        },
        {
            "talkId": "6959505",
            "initDialog": "695950501",
            "dialogues": [
                {
                    "id": "695950501",
                    "speaker": "伊法",
                    "text": "虽说输赢都是牌桌上的常事，但输了总归有点不甘心…怎么样？再来一把？"
                }
            ]
        },
        {
            "talkId": "6959506",
            "initDialog": "695950601",
            "dialogues": [
                {
                    "id": "695950601",
                    "speaker": "伊法",
                    "text": "行啊，我还是很擅长玩这种游戏的。"
                },
                {
                    "id": "695950602",
                    "speaker": "咔库库",
                    "text": "厉害，哥们！"
                }
            ]
        },
        {
            "talkId": "6959508",
            "initDialog": "695950801",
            "dialogues": [
                {
                    "id": "695950801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959509",
            "initDialog": "695950901",
            "dialogues": [
                {
                    "id": "695950901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959510",
            "initDialog": "695951001",
            "dialogues": [
                {
                    "id": "695951001",
                    "speaker": "伊法",
                    "text": "还好还好，算是赢了，差一点就输了…"
                }
            ]
        },
        {
            "talkId": "6959511",
            "initDialog": "695951101",
            "dialogues": [
                {
                    "id": "695951101",
                    "speaker": "伊法",
                    "text": "手气不太好啊…不然，下一盘换咔库库帮我抽牌吧。"
                }
            ]
        },
        {
            "talkId": "6959512",
            "initDialog": "695951201",
            "dialogues": [
                {
                    "id": "695951201",
                    "speaker": "伊法",
                    "text": "没问题，那就…哎，咔库库，别扇翅膀，把卡牌掀飞就不好了。"
                },
                {
                    "id": "695951202",
                    "speaker": "咔库库",
                    "text": "看看牌，哥们！"
                }
            ]
        },
        {
            "talkId": "6959514",
            "initDialog": "695951401",
            "dialogues": [
                {
                    "id": "695951401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959515",
            "initDialog": "695951501",
            "dialogues": [
                {
                    "id": "695951501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959516",
            "initDialog": "695951601",
            "dialogues": [
                {
                    "id": "695951601",
                    "speaker": "伊法",
                    "text": "#哈哈哈，咔库库，看来今天是你的幸运日啊，抓到的都是好牌，谢啦。下一轮你去帮{NICKNAME}抓牌吧。"
                },
                {
                    "id": "695951602",
                    "speaker": "咔库库",
                    "text": "没问题，哥们！"
                }
            ]
        },
        {
            "talkId": "6959517",
            "initDialog": "695951701",
            "dialogues": [
                {
                    "id": "695951701",
                    "speaker": "伊法",
                    "text": "怪了，怎么我和咔库库今天的手气都不太好…唔，稍等啊，我俩去洗一洗手和爪子。"
                },
                {
                    "id": "695951702",
                    "speaker": "咔库库",
                    "text": "不是吧，哥们…"
                }
            ]
        },
        {
            "talkId": "6959518",
            "initDialog": "695951801",
            "dialogues": [
                {
                    "id": "695951801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}