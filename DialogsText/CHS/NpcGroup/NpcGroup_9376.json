{
    "groupId": "9376",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "嘉明": 9
    },
    "talks": [
        {
            "talkId": "6937601",
            "initDialog": "693760101",
            "dialogues": [
                {
                    "id": "693760101",
                    "speaker": "嘉明",
                    "text": "我们跑镖前都会吃好睡好，做足准备功夫先出发，才能在路上保持最好状态的嘛。"
                },
                {
                    "id": "693760102",
                    "speaker": "嘉明",
                    "text": "连文仔都知道噢！会乖乖吃多几口再走。"
                },
                {
                    "id": "693760103",
                    "speaker": "嘉明",
                    "text": "所以你也不用急，慢慢来，饮杯茶先啦。"
                }
            ]
        },
        {
            "talkId": "6937602",
            "initDialog": "693760201",
            "dialogues": [
                {
                    "id": "693760201",
                    "speaker": "嘉明",
                    "text": "秘境里面不是开玩笑的，打架都是来真的！"
                },
                {
                    "id": "693760202",
                    "speaker": "嘉明",
                    "text": "不过我对你很有信心，就算让这些家伙两招，我都觉得你赢定了。"
                },
                {
                    "id": "693760203",
                    "speaker": "嘉明",
                    "text": "不如这样，你放放水，给个机会我大展拳脚咯？"
                }
            ]
        },
        {
            "talkId": "6937603",
            "initDialog": "693760301",
            "dialogues": [
                {
                    "id": "693760301",
                    "speaker": "嘉明",
                    "text": "讲出来不怕你笑，我每次打开书不到十分钟就会睡着…"
                },
                {
                    "id": "693760302",
                    "speaker": "嘉明",
                    "text": "相反，舞兽的话，练通宵都不觉得困，第二天还能龙精虎猛地去喝早茶…"
                },
                {
                    "id": "693760303",
                    "speaker": "嘉明",
                    "text": "欸，你说…如果我一边舞兽一边看书…会怎样咧？"
                }
            ]
        }
    ]
}