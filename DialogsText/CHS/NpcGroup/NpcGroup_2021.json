{
    "groupId": "2021",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 2,
        "卉卉": 13,
        "浩仔": 3
    },
    "talks": [
        {
            "talkId": "6202101",
            "initDialog": "620210101",
            "dialogues": [
                {
                    "id": "620210101",
                    "speaker": "卉卉",
                    "text": "你们喜欢月菜的为什么总是辱没璃菜？"
                },
                {
                    "id": "620210102",
                    "speaker": "浩仔",
                    "text": "是你们璃菜爱好者先说月菜难吃的！"
                },
                {
                    "id": "620210103",
                    "speaker": "卉卉",
                    "text": "月菜确实不好吃嘛！感觉就像生吞了一条没处理过的鱼！说是海味，却只有腥味，味道完全没有层次感…"
                },
                {
                    "id": "620210104",
                    "speaker": "浩仔",
                    "text": "那、那璃菜就像…一大坨盐块腌制三天的绝云椒椒！说是山珍，却又咸又辣难以下咽…"
                },
                {
                    "id": "620210105",
                    "speaker": "卉卉",
                    "text": "你怎么能这么说…是你太没有品味了！月菜的糟糕已经毁掉了你的味蕾！"
                },
                {
                    "id": "620210106",
                    "speaker": "浩仔",
                    "text": "哼，你那么说是你没有好好品味过月菜，或者你根本没有吃过「新月轩」的月菜！"
                },
                {
                    "id": "620210107",
                    "speaker": "卉卉",
                    "text": "你…要是尝过「琉璃亭」的璃菜的话就绝不会这么说了！"
                }
            ]
        },
        {
            "talkId": "6202102",
            "initDialog": "620210201",
            "dialogues": [
                {
                    "id": "620210201",
                    "speaker": "卉卉",
                    "text": "哼，这个汤，淡得像白水。这个鱼，一夹就散，没有嚼劲！"
                }
            ]
        },
        {
            "talkId": "6202103",
            "initDialog": "620210301",
            "dialogues": [
                {
                    "id": "620210301",
                    "speaker": "Player",
                    "text": "你好像吃得很开心呢。"
                },
                {
                    "id": "620210302",
                    "speaker": "卉卉",
                    "text": "开心？怎么会开心！我又不是喜欢才来吃的，我是为了给我们璃菜争面子！"
                },
                {
                    "id": "620210303",
                    "speaker": "卉卉",
                    "text": "所以才要细细品味月菜，把它的所有缺点都历数一遍，我已经连续来了…一年？唉算了已经记不清了。"
                },
                {
                    "id": "620210304",
                    "speaker": "卉卉",
                    "text": "唔嗯…无论什么菜都使用清淡的做法，只能用海味提鲜，正说明了这个菜系的无能！"
                }
            ]
        },
        {
            "talkId": "6202104",
            "initDialog": "620210401",
            "dialogues": [
                {
                    "id": "620210401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620210402",
                    "speaker": "卉卉",
                    "text": "再见！"
                },
                {
                    "id": "620210403",
                    "speaker": "卉卉",
                    "text": "唔…这个也没味道…"
                }
            ]
        },
        {
            "talkId": "7202101",
            "initDialog": "720210101",
            "dialogues": [
                {
                    "id": "720210101",
                    "speaker": "卉卉",
                    "text": "我一直以为只有「琉璃亭」的璃菜可以称得上美味…"
                },
                {
                    "id": "720210102",
                    "speaker": "卉卉",
                    "text": "可偶尔吃吃大排档的大众料理，居然意外地还不错？"
                },
                {
                    "id": "720210103",
                    "speaker": "卉卉",
                    "text": "感觉「中原杂碎」还要再来两份…"
                }
            ]
        }
    ]
}