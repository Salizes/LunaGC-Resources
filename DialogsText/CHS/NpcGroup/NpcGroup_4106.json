    "talks": [
        {
            "talkId": "6410601",
            "initDialog": "641060101",
            "dialogues": [
                {
                    "id": "641060101",
                    "speaker": "莫孜甘",
                    "text": "嗯…家里的储备应该还够。"
                }
            ]
        },
        {
            "talkId": "6410602",
            "initDialog": "641060201",
            "dialogues": [
                {
                    "id": "641060201",
                    "speaker": "Player",
                    "text": "储备什么？"
                },
                {
                    "id": "641060202",
                    "speaker": "莫孜甘",
                    "text": "须弥蔷薇、薄荷、月莲什么的。"
                },
                {
                    "id": "641060203",
                    "speaker": "莫孜甘",
                    "text": "可不要小看这些小花小草，要是你懂得如何使用它们，将会得到额外的收获。"
                },
                {
                    "id": "641060204",
                    "speaker": "莫孜甘",
                    "text": "比如将须弥蔷薇捣碎加水，再敷在脸上，就能美白养颜，精神焕发！"
                },
                {
                    "id": "641060205",
                    "speaker": "莫孜甘",
                    "text": "所以听我的，家中一定要常备须弥蔷薇。"
                }
            ]
        },
        {
            "talkId": "6410603",
            "initDialog": "641060301",
            "dialogues": [
                {
                    "id": "641060301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641060302",
                    "speaker": "莫孜甘",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
            "talkId": "7394501",
            "initDialog": "739450101",
            "dialogues": [
                {
                    "id": "739450101",
                    "speaker": "Player",
                    "text": "真的有效吗？"
                },
                {
                    "id": "739450102",
                    "speaker": "莫孜甘",
                    "text": "唔…至少从我的经验来看，多少管点用吧？"
                },
                {
                    "id": "739450103",
                    "speaker": "莫孜甘",
                    "text": "反正试试呗，也没什么坏处，只要起效就是赚到。"
                }
            ]
        }
    ]
}