{
    "groupId": "4012",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "阿克拉姆": 7
    },
    "talks": [
        {
            "talkId": "6401201",
            "initDialog": "640120101",
            "dialogues": [
                {
                    "id": "640120101",
                    "speaker": "阿克拉姆",
                    "text": "知己知彼，才能百战百胜，你说对不对。"
                }
            ]
        },
        {
            "talkId": "6401202",
            "initDialog": "640120201",
            "dialogues": [
                {
                    "id": "640120201",
                    "speaker": "Player",
                    "text": "你指什么？"
                },
                {
                    "id": "640120202",
                    "speaker": "阿克拉姆",
                    "text": "如你所见，我是「三十人团」中的一员，自然需要负责维护须弥城的治安。"
                },
                {
                    "id": "640120203",
                    "speaker": "阿克拉姆",
                    "text": "而偷盗，则是城里人多的地方最常见的犯罪行为。"
                },
                {
                    "id": "640120204",
                    "speaker": "阿克拉姆",
                    "text": "我如果不熟悉小偷们怎么偷东西，又怎么能好好识别他们呢？"
                },
                {
                    "id": "640120205",
                    "speaker": "阿克拉姆",
                    "text": "但我弟弟见我偶尔…极偶尔啊！去模拟小偷偷盗时，就一定会当面戳穿我的技法。"
                },
                {
                    "id": "640120206",
                    "speaker": "阿克拉姆",
                    "text": "这叫人怎么进步嘛！"
                }
            ]
        },
        {
            "talkId": "6401203",
            "initDialog": "640120301",
            "dialogues": [
                {
                    "id": "640120301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640120302",
                    "speaker": "阿克拉姆",
                    "text": "嗯，回见。"
                }
            ]
        }
    ]
}