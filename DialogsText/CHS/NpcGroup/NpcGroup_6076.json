{
    "groupId": "6076",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "蒂尔妲": 12
    },
    "talks": [
        {
            "talkId": "6607601",
            "initDialog": "660760101",
            "dialogues": [
                {
                    "id": "660760101",
                    "speaker": "蒂尔妲",
                    "text": "有时我会想，是不是自己出生在了错误的部族…"
                }
            ]
        },
        {
            "talkId": "6607602",
            "initDialog": "660760201",
            "dialogues": [
                {
                    "id": "660760201",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "660760202",
                    "speaker": "蒂尔妲",
                    "text": "是恐高症，我天生就有恐高症。"
                },
                {
                    "id": "660760203",
                    "speaker": "蒂尔妲",
                    "text": "这对绒翼龙骑士预备役来说，根本就是天降的诅咒吧。"
                },
                {
                    "id": "660760204",
                    "speaker": "蒂尔妲",
                    "text": "那么在骑士考核中屡屡失败也是意料之中的事情了…"
                }
            ]
        },
        {
            "talkId": "6607603",
            "initDialog": "660760301",
            "dialogues": [
                {
                    "id": "660760301",
                    "speaker": "Player",
                    "text": "抱歉，帮不上忙…"
                },
                {
                    "id": "660760302",
                    "speaker": "蒂尔妲",
                    "text": "没关系，又不是你的错。"
                }
            ]
        },
        {
            "talkId": "6607604",
            "initDialog": "660760401",
            "dialogues": [
                {
                    "id": "660760401",
                    "speaker": "Player",
                    "text": "真遗憾…"
                },
                {
                    "id": "660760402",
                    "speaker": "蒂尔妲",
                    "text": "是啊。不过即便不像我这样有天生的问题，也不是每一个部族成员都能顺利成为骑士的。"
                },
                {
                    "id": "660760403",
                    "speaker": "蒂尔妲",
                    "text": "不少像我这样「失翼」的人离开了花羽会。"
                },
                {
                    "id": "660760404",
                    "speaker": "蒂尔妲",
                    "text": "有的人虽然不善飞行，但战斗技术过硬，被其他部族接纳为额外的常驻战力了。"
                },
                {
                    "id": "660760405",
                    "speaker": "蒂尔妲",
                    "text": "而像我这样武艺也不够精湛的人，就只能凭借歌喉，在这里做做餐厅的驻唱了…"
                }
            ]
        },
        {
            "talkId": "7593201",
            "initDialog": "759320101",
            "dialogues": [
                {
                    "id": "759320101",
                    "speaker": "Player",
                    "text": "英雄总有用武之地。"
                },
                {
                    "id": "759320102",
                    "speaker": "蒂尔妲",
                    "text": "意思是说，我的歌唱技巧也有它存在的意义吗？"
                },
                {
                    "id": "759320103",
                    "speaker": "蒂尔妲",
                    "text": "或许的确是这个道理，能让大家感到轻松、快乐，也是一种天赋…"
                },
                {
                    "id": "759320104",
                    "speaker": "蒂尔妲",
                    "text": "听完你的话我感觉好多了，送你花吧，也谢谢你为我带来了轻松与快乐。"
                }
            ]
        }
    ]
}