{
    "groupId": "6548",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "乌奎奇": 7
    },
    "talks": [
        {
            "talkId": "6654801",
            "initDialog": "665480101",
            "dialogues": [
                {
                    "id": "665480101",
                    "speaker": "乌奎奇",
                    "text": "朋友们，请走这边！"
                },
                {
                    "id": "665480102",
                    "speaker": "乌奎奇",
                    "text": "欸？这位客人，是你啊，上次在览彩漂游我见过你。"
                },
                {
                    "id": "665480103",
                    "speaker": "Player",
                    "text": "你怎么在提提岛。"
                },
                {
                    "id": "665480104",
                    "speaker": "乌奎奇",
                    "text": "因为这边需要人手嘛。为了搭建这个热舞乐台，费了不少人力物力呢。"
                },
                {
                    "id": "665480105",
                    "speaker": "乌奎奇",
                    "text": "我敢说，纳塔其它地方很难再见到一样的东西。"
                },
                {
                    "id": "665480106",
                    "speaker": "Player",
                    "text": "为什么？"
                },
                {
                    "id": "665480107",
                    "speaker": "乌奎奇",
                    "text": "你看见那些会发光的招牌和灯了吗？光凭我们的荧光涂鸦还达不到这种效果，后来是使用了一些挪德卡莱运过来的材料才完工。"
                },
                {
                    "id": "665480108",
                    "speaker": "乌奎奇",
                    "text": "听说是一支来自伏尼契商会的商队过来做生意。这名字还挺有异国风情呢。"
                },
                {
                    "id": "665480109",
                    "speaker": "乌奎奇",
                    "text": "等到了我的假期，我也打算去挪德卡莱那边看看。"
                }
            ]
        }
    ]
}