{
    "groupId": "2117",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "万货通": 16
    },
    "talks": [
        {
            "talkId": "7194501",
            "initDialog": "719450101",
            "dialogues": [
                {
                    "id": "719450101",
                    "speaker": "Player",
                    "text": "你这招牌果然是骗人的…"
                },
                {
                    "id": "719450102",
                    "speaker": "万货通",
                    "text": "这、这话说的，我这招牌可不能砸在你手里啊…"
                },
                {
                    "id": "719450103",
                    "speaker": "万货通",
                    "text": "对了！食物肯定需要吧？不管你是什么人，肯定都会有需求的吧！"
                },
                {
                    "id": "719450104",
                    "speaker": "万货通",
                    "text": "来，这个「松茸酿肉卷」你就收下吧——你看，我这里果然有你需要的吧！"
                },
                {
                    "id": "719450105",
                    "speaker": "万货通",
                    "text": "…哦，这个是我带的饭，仅此一份，而且不要你的钱，所以你也别为难我了…"
                }
            ]
        },
        {
            "talkId": "6211701",
            "initDialog": "621170101",
            "dialogues": [
                {
                    "id": "621170101",
                    "speaker": "万货通",
                    "text": "是旅行者吧，要买些日用品吗？"
                },
                {
                    "id": "621170102",
                    "speaker": "万货通",
                    "text": "只要是日用品，我这里只有你想不到的，没有你买不到的。"
                }
            ]
        },
        {
            "talkId": "6211702",
            "initDialog": "621170201",
            "dialogues": [
                {
                    "id": "621170201",
                    "speaker": "Player",
                    "text": "请问圣遗物卖吗？"
                },
                {
                    "id": "621170202",
                    "speaker": "万货通",
                    "text": "唔…不好意思，不卖。"
                },
                {
                    "id": "621170203",
                    "speaker": "万货通",
                    "text": "那种应该放在博物馆或者教堂里的东西，能称得上是日用品吗？"
                }
            ]
        },
        {
            "talkId": "6211703",
            "initDialog": "621170301",
            "dialogues": [
                {
                    "id": "621170301",
                    "speaker": "Player",
                    "text": "请问神兵利器卖吗？"
                },
                {
                    "id": "621170302",
                    "speaker": "万货通",
                    "text": "唔…不好意思，不卖。"
                },
                {
                    "id": "621170303",
                    "speaker": "万货通",
                    "text": "带一把匕首或者短剑防身的旅行者倒是很常见…拿着神兵利器的话，真的只是旅行而已吗？"
                }
            ]
        },
        {
            "talkId": "6211704",
            "initDialog": "621170401",
            "dialogues": [
                {
                    "id": "621170401",
                    "speaker": "Player",
                    "text": "请问毒药卖吗？"
                },
                {
                    "id": "621170402",
                    "speaker": "万货通",
                    "text": "唔…不好意思，不敢…"
                },
                {
                    "id": "621170403",
                    "speaker": "万货通",
                    "text": "难道你帮我去千岩军那里打点关系吗？卖这种东西可不是闹着玩的…"
                }
            ]
        },
        {
            "talkId": "6211705",
            "initDialog": "621170501",
            "dialogues": [
                {
                    "id": "621170501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621170502",
                    "speaker": "万货通",
                    "text": "欢迎下次再来光顾，请记住我们的招牌「天下日用，无奇不卖」！"
                }
            ]
        },
        {
            "talkId": "6211706",
            "initDialog": "621170204",
            "dialogues": [
                {
                    "id": "621170204",
                    "speaker": "Player",
                    "text": "不是说什么都有吗？"
                },
                {
                    "id": "621170205",
                    "speaker": "万货通",
                    "text": "可、可是…你的「日用品」需求也太刁钻了吧！"
                },
                {
                    "id": "621170206",
                    "speaker": "万货通",
                    "text": "我只卖「一般」旅行者的日用品…"
                },
                {
                    "id": "621170207",
                    "speaker": "万货通",
                    "text": "话说回来，你到底在进行着什么样的旅行啊？"
                }
            ]
        }
    ]
}