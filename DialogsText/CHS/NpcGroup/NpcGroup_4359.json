{
    "groupId": "4359",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "莎菲": 10
    },
    "talks": [
        {
            "talkId": "6435901",
            "initDialog": "643590101",
            "dialogues": [
                {
                    "id": "643590101",
                    "speaker": "莎菲",
                    "text": "你好！你要前往须弥城吗？需要保镖吗？之前戈哈尔姐姐进城的时候就是我护送的！"
                }
            ]
        },
        {
            "talkId": "6435902",
            "initDialog": "643590201",
            "dialogues": [
                {
                    "id": "643590201",
                    "speaker": "Player",
                    "text": "抱歉，用不上。"
                },
                {
                    "id": "643590202",
                    "speaker": "莎菲",
                    "text": "哇哦，很自信嘛。这么厉害的话，不如加入我们镀金旅团？"
                },
                {
                    "id": "643590203",
                    "speaker": "莎菲",
                    "text": "只要你能胜任保安啦护送啦之类的工作，就能过得不错哦。"
                },
                {
                    "id": "643590204",
                    "speaker": "莎菲",
                    "text": "阿巴克大哥似乎是为了大家的安全着想，总是分给我们些不需要进城，又没什么风险的工作。"
                },
                {
                    "id": "643590205",
                    "speaker": "莎菲",
                    "text": "容易是容易，但就是太无聊了！还不如在这边逛街数香辛果有意思呢。"
                }
            ]
        },
        {
            "talkId": "6435903",
            "initDialog": "643590301",
            "dialogues": [
                {
                    "id": "643590301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643590302",
                    "speaker": "莎菲",
                    "text": "再见，如果有须弥城的委托可以介绍给我啊！"
                }
            ]
        },
        {
            "talkId": "6435904",
            "initDialog": "643590401",
            "dialogues": [
                {
                    "id": "643590401",
                    "speaker": "Player",
                    "text": "戈哈尔姐姐？"
                },
                {
                    "id": "643590402",
                    "speaker": "莎菲",
                    "text": "哦，抱歉抱歉，我忘了外人是不知道戈哈尔姐姐的。"
                },
                {
                    "id": "643590403",
                    "speaker": "莎菲",
                    "text": "她是喀万驿这边人见人爱的好看姐姐。任何人见到她，都会忍不住夸上几句。"
                },
                {
                    "id": "643590404",
                    "speaker": "莎菲",
                    "text": "可惜你看不到啦，几周前她收到了一封暝彩鸟传来的信，接着就让我送她去须弥城。"
                },
                {
                    "id": "643590405",
                    "speaker": "莎菲",
                    "text": "那次玩儿的可开心了…不…我是说，真是一次难忘的工作经历！"
                }
            ]
        }
    ]
}