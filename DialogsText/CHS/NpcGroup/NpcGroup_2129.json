{
    "groupId": "2129",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "茉莉": 5,
        "荷尔德林": 5
    },
    "talks": [
        {
            "talkId": "6212901",
            "initDialog": "621290101",
            "dialogues": [
                {
                    "id": "621290101",
                    "speaker": "荷尔德林",
                    "text": "这酒啊，就是比茶更好，活血暖胃…"
                },
                {
                    "id": "621290102",
                    "speaker": "茉莉",
                    "text": "酒比茶好？呵，我看你就是酒喝多了，开始说胡话了。"
                },
                {
                    "id": "621290103",
                    "speaker": "荷尔德林",
                    "text": "就说你不懂吧，一杯小酒入肚，那感觉仿佛升天了一般，啧啧…"
                },
                {
                    "id": "621290104",
                    "speaker": "荷尔德林",
                    "text": "反观你们璃月人的茶，那么苦，简直不是给人喝的。"
                },
                {
                    "id": "621290105",
                    "speaker": "茉莉",
                    "text": "升天？如果是出现幻觉了，就赶紧去「不卜庐」求医吧。"
                },
                {
                    "id": "621290106",
                    "speaker": "茉莉",
                    "text": "茶的美妙恰恰就在于那苦中带甜的味道，恰如人生一般，有苦有甜…"
                },
                {
                    "id": "621290107",
                    "speaker": "荷尔德林",
                    "text": "喝个茶还喝出人生感悟来了？"
                },
                {
                    "id": "621290108",
                    "speaker": "茉莉",
                    "text": "怎么了？喝茶就是比喝酒健康。"
                },
                {
                    "id": "621290109",
                    "speaker": "荷尔德林",
                    "text": "你这每天茶不离口的，牙都黄了，我也没觉得有多健康啊？"
                },
                {
                    "id": "621290110",
                    "speaker": "茉莉",
                    "text": "嘿！你——"
                }
            ]
        }
    ]
}