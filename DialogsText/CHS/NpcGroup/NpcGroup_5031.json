{
    "groupId": "5031",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 10,
        "凯瑟琳": 24
    },
    "talks": [
        {
            "talkId": "6503101",
            "initDialog": "650310101",
            "dialogues": [
                {
                    "id": "650310101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。"
                }
            ]
        },
        {
            "talkId": "6503102",
            "initDialog": "650310201",
            "dialogues": [
                {
                    "id": "650310201",
                    "speaker": "Player",
                    "text": "领取「冒险等阶」奖励"
                }
            ]
        },
        {
            "talkId": "6503103",
            "initDialog": "650310301",
            "dialogues": [
                {
                    "id": "650310301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「冒险等阶」奖励</color>"
                }
            ]
        },
        {
            "talkId": "6503104",
            "initDialog": "650310401",
            "dialogues": [
                {
                    "id": "650310401",
                    "speaker": "Player",
                    "text": "又见面了，凯瑟琳。"
                },
                {
                    "id": "650310402",
                    "speaker": "凯瑟琳",
                    "text": "你好，很高兴与你见面。"
                },
                {
                    "id": "650310403",
                    "speaker": "凯瑟琳",
                    "text": "我是冒险家协会的接待员凯瑟琳，负责为冒险家们提供任务发布和情报支援工作。"
                },
                {
                    "id": "650310404",
                    "speaker": "凯瑟琳",
                    "text": "希望我的服务能帮到你，也祝愿你在枫丹度过一段难忘的旅途。"
                }
            ]
        },
        {
            "talkId": "6503105",
            "initDialog": "650310501",
            "dialogues": [
                {
                    "id": "650310501",
                    "speaker": "Player",
                    "text": "难道凯瑟琳也是发条人偶？"
                },
                {
                    "id": "650310502",
                    "speaker": "凯瑟琳",
                    "text": "呵呵，我到底是不是呢？"
                },
                {
                    "id": "650310503",
                    "speaker": "凯瑟琳",
                    "text": "难道有人觉得我是枫丹科学院的杰作？"
                }
            ]
        },
        {
            "talkId": "6503106",
            "initDialog": "650310601",
            "dialogues": [
                {
                    "id": "650310601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650310602",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，冒险家。"
                }
            ]
        },
        {
            "talkId": "6503107",
            "initDialog": "650310701",
            "dialogues": [
                {
                    "id": "650310701",
                    "speaker": "凯瑟琳",
                    "text": "查看「豪斗旅纪」信息"
                }
            ]
        },
        {
            "talkId": "6503108",
            "initDialog": "650310801",
            "dialogues": [
                {
                    "id": "650310801",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>查看「豪斗旅纪」信息</color>"
                }
            ]
        },
        {
            "talkId": "6503109",
            "initDialog": "650310901",
            "dialogues": [
                {
                    "id": "650310901",
                    "speaker": "凯瑟琳",
                    "text": "欢迎来到冒险家协会，「木偶」大人。有什么我能为您做的吗？"
                }
            ]
        },
        {
            "talkId": "6503110",
            "initDialog": "650311001",
            "dialogues": [
                {
                    "id": "650311001",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650311002",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，「木偶」大人。"
                }
            ]
        },
        {
            "talkId": "7068805",
            "initDialog": "706880501",
            "dialogues": [
                {
                    "id": "706880501",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么厉害的委托吗？</color>"
                },
                {
                    "id": "706880502",
                    "speaker": "凯瑟琳",
                    "text": "您来的正巧，有一份协会共享给资深冒险家的手册要交给您。",
                    "choices": [
                        {
                            "id": "706880503",
                            "text": "是提瓦特美食大全吗？",
                            "response": [
                                {
                                    "id": "706880504",
                                    "speaker": "凯瑟琳",
                                    "text": "很遗憾，并不是。"
                                },
                                {
                                    "id": "706880507",
                                    "speaker": "凯瑟琳",
                                    "text": "如您所见，手册记录了值得挑战的强敌的信息。"
                                },
                                {
                                    "id": "706880508",
                                    "speaker": "凯瑟琳",
                                    "text": "若能合理利用，想必会为您的冒险旅途增加许多助益。之后如果需要查阅相关信息，也随时欢迎您来。"
                                },
                                {
                                    "id": "706880509",
                                    "speaker": "凯瑟琳",
                                    "text": "那么，就祝您旗开得胜。"
                                }
                            ]
                        },
                        {
                            "id": "706880505",
                            "text": "难道又是新的任务…",
                            "response": [
                                {
                                    "id": "706880506",
                                    "speaker": "凯瑟琳",
                                    "text": "挑战与否，选择权当然在您。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "2010136",
            "initDialog": "201013601",
            "dialogues": [
                {
                    "id": "201013601",
                    "speaker": "凯瑟琳",
                    "text": "领取「每日委托」奖励"
                },
                {
                    "id": "201013602",
                    "speaker": "凯瑟琳",
                    "text": "很抱歉，今天你完成的委托数量还不够呢。"
                }
            ]
        },
        {
            "talkId": "2010137",
            "initDialog": "201013701",
            "dialogues": [
                {
                    "id": "201013701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013702",
                    "speaker": "凯瑟琳",
                    "text": "感谢你完成了今天的委托，这是给你的奖励。"
                }
            ]
        },
        {
            "talkId": "2010138",
            "initDialog": "201013801",
            "dialogues": [
                {
                    "id": "201013801",
                    "speaker": "凯瑟琳",
                    "text": "<color=#999999FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013802",
                    "speaker": "凯瑟琳",
                    "text": "你已经领取过今天的奖励了，希望你明天也能继续承接协会的委托。"
                }
            ]
        },
        {
            "talkId": "2010141",
            "initDialog": "201014101",
            "dialogues": [
                {
                    "id": "201014101",
                    "speaker": "凯瑟琳",
                    "text": "探索派遣"
                }
            ]
        },
        {
            "talkId": "2010142",
            "initDialog": "201014201",
            "dialogues": [
                {
                    "id": "201014201",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>探索派遣</color>"
                }
            ]
        }
    ]
}