{
    "groupId": "5066",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "阿蕾妲": 9
    },
    "talks": [
        {
            "talkId": "6506601",
            "initDialog": "650660101",
            "dialogues": [
                {
                    "id": "650660101",
                    "speaker": "阿蕾妲",
                    "text": "多晒太阳有助于身体健康哦。"
                }
            ]
        },
        {
            "talkId": "6506602",
            "initDialog": "650660201",
            "dialogues": [
                {
                    "id": "650660201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "650660202",
                    "speaker": "阿蕾妲",
                    "text": "我是医生，货真价实的那种。医师凭证完备，还有教令院的毕业证书。"
                }
            ]
        },
        {
            "talkId": "6506603",
            "initDialog": "650660301",
            "dialogues": [
                {
                    "id": "650660301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650660302",
                    "speaker": "阿蕾妲",
                    "text": "再见，祝你身体健康。"
                }
            ]
        },
        {
            "talkId": "6506604",
            "initDialog": "650660401",
            "dialogues": [
                {
                    "id": "650660401",
                    "speaker": "Player",
                    "text": "为什么会在这边看病？"
                },
                {
                    "id": "650660402",
                    "speaker": "阿蕾妲",
                    "text": "我当初很穷，自己根本拿不出留学的学费和路费，是在刺玫会的资助下才得到的机会。"
                },
                {
                    "id": "650660403",
                    "speaker": "阿蕾妲",
                    "text": "当然，条件就是在教令院学成之后，能考虑到这边来当医生。工资由刺玫会按正规标准来发。"
                },
                {
                    "id": "650660404",
                    "speaker": "阿蕾妲",
                    "text": "我觉得这是笔不错的交易，也理解刺玫会的用意。所以我这里看病只需要缴纳最基本的药费。"
                }
            ]
        },
        {
            "talkId": "7493301",
            "initDialog": "749330101",
            "dialogues": [
                {
                    "id": "749330101",
                    "speaker": "Player",
                    "text": "这里需要你。"
                },
                {
                    "id": "749330102",
                    "speaker": "阿蕾妲",
                    "text": "这里需要的是阳光。"
                },
                {
                    "id": "749330103",
                    "speaker": "阿蕾妲",
                    "text": "但灰河的人已经习惯这种生活了，没什么必要的话不会往上面跑。"
                },
                {
                    "id": "749330104",
                    "speaker": "阿蕾妲",
                    "text": "哎，不说这些了。你也一样，多晒太阳，多吃蔬菜水果，对身体好。"
                }
            ]
        }
    ]
}