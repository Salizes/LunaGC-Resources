{
    "groupId": "2032",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 3,
        "碧波": 23
    },
    "talks": [
        {
            "talkId": "6203205",
            "initDialog": "620320501",
            "dialogues": [
                {
                    "id": "620320501",
                    "speaker": "碧波",
                    "text": "嘿，是来看货的吗？新的货还没到，可能得再等等…"
                },
                {
                    "id": "620320502",
                    "speaker": "碧波",
                    "text": "不过等待绝对是有价值的，我的货既「干净」又「新鲜」！"
                }
            ]
        },
        {
            "talkId": "6203206",
            "initDialog": "620320601",
            "dialogues": [
                {
                    "id": "620320601",
                    "speaker": "Player",
                    "text": "你是卖鱼的吗？"
                },
                {
                    "id": "620320602",
                    "speaker": "碧波",
                    "text": "鱼？如果你是想试探我的话，那大可不必，让我们打开天窗说亮话吧——"
                },
                {
                    "id": "620320603",
                    "speaker": "碧波",
                    "text": "这么说吧，无论是什么货物、在哪里，只要报酬合适我都可以帮你搞来…"
                },
                {
                    "id": "620320604",
                    "speaker": "碧波",
                    "text": "就算是稻妻的也没问题！"
                }
            ]
        },
        {
            "talkId": "6203207",
            "initDialog": "620320701",
            "dialogues": [
                {
                    "id": "620320701",
                    "speaker": "Player",
                    "text": "关于稻妻…"
                },
                {
                    "id": "620320702",
                    "speaker": "碧波",
                    "text": "之前一般人想要进出稻妻简直难如登天，就算侥幸穿过了汹涌的大海，在岸边也还有严防死守。"
                },
                {
                    "id": "620320703",
                    "speaker": "碧波",
                    "text": "不过现在就没问题了，商路畅通之后，想要什么稻妻的新鲜玩意儿，我都能搞定！"
                }
            ]
        },
        {
            "talkId": "6203208",
            "initDialog": "620320801",
            "dialogues": [
                {
                    "id": "620320801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620320802",
                    "speaker": "碧波",
                    "text": "不买就快走开，可别让千岩军盯上了…"
                }
            ]
        },
        {
            "talkId": "6203201",
            "initDialog": "620320101",
            "dialogues": [
                {
                    "id": "620320101",
                    "speaker": "碧波",
                    "text": "嘿，是来看货的吗？新的货还没到，可能得再等等…"
                },
                {
                    "id": "620320102",
                    "speaker": "碧波",
                    "text": "不过等待绝对是有价值的，我的货既「干净」又「新鲜」！"
                },
                {
                    "id": "620320103",
                    "speaker": "碧波",
                    "text": "…不过，事先说好，稻妻的货可没有啊。"
                }
            ]
        },
        {
            "talkId": "6203202",
            "initDialog": "620320201",
            "dialogues": [
                {
                    "id": "620320201",
                    "speaker": "碧波",
                    "text": "你是卖鱼的吗？"
                },
                {
                    "id": "620320202",
                    "speaker": "碧波",
                    "text": "鱼？如果你是想试探我的话，那大可不必，让我们打开天窗说亮话吧——"
                },
                {
                    "id": "620320203",
                    "speaker": "碧波",
                    "text": "这么说吧，无论是什么货物、在哪里，只要报酬合适我都可以帮你搞来…"
                },
                {
                    "id": "620320204",
                    "speaker": "碧波",
                    "text": "…不过稻妻就算了，不是钱的问题，那可是赌命的活计啊。"
                }
            ]
        },
        {
            "talkId": "6203203",
            "initDialog": "620320301",
            "dialogues": [
                {
                    "id": "620320301",
                    "speaker": "碧波",
                    "text": "关于稻妻…"
                },
                {
                    "id": "620320302",
                    "speaker": "碧波",
                    "text": "一般人想要进出稻妻简直难如登天！"
                },
                {
                    "id": "620320303",
                    "speaker": "碧波",
                    "text": "就算侥幸穿过了汹涌的大海，在岸边也还有严防死守。"
                },
                {
                    "id": "620320304",
                    "speaker": "碧波",
                    "text": "真是不懂他们国家管事的人在想些什么，画地为牢么…"
                },
                {
                    "id": "620320305",
                    "speaker": "碧波",
                    "text": "我前一段时间救了一个从稻妻逃出来的女孩…她是我这些年见过唯一的私自离开稻妻的人。"
                },
                {
                    "id": "620320306",
                    "speaker": "碧波",
                    "text": "所以，如果你是想要稻妻的新鲜玩意儿，那我劝你还是放弃这个念头吧…"
                }
            ]
        },
        {
            "talkId": "6203204",
            "initDialog": "620320401",
            "dialogues": [
                {
                    "id": "620320401",
                    "speaker": "碧波",
                    "text": "再见。"
                },
                {
                    "id": "620320402",
                    "speaker": "碧波",
                    "text": "不买就快走开，可别让千岩军盯上了…"
                }
            ]
        }
    ]
}