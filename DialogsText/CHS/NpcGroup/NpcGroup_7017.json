{
    "groupId": "7017",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "约霍": 9
    },
    "talks": [
        {
            "talkId": "6701701",
            "initDialog": "670170101",
            "dialogues": [
                {
                    "id": "670170101",
                    "speaker": "约霍",
                    "text": "别急，问题正在处理中…"
                }
            ]
        },
        {
            "talkId": "6701702",
            "initDialog": "670170201",
            "dialogues": [
                {
                    "id": "670170201",
                    "speaker": "Player",
                    "text": "这么多人在排队入港？"
                },
                {
                    "id": "670170202",
                    "speaker": "约霍",
                    "text": "噢，朋友，毕竟等待入港的人总是太多，而最近的入港时间都有些…你看，有时慢，有时候更慢。"
                },
                {
                    "id": "670170203",
                    "speaker": "约霍",
                    "text": "更何况，雪上加霜，传送带坏了，得等人来修，麻绳专挑细处断啊。"
                }
            ]
        },
        {
            "talkId": "6701703",
            "initDialog": "670170301",
            "dialogues": [
                {
                    "id": "670170301",
                    "speaker": "Player",
                    "text": "你在处理什么问题呢？"
                },
                {
                    "id": "670170302",
                    "speaker": "约霍",
                    "text": "我在处理「一大堆」问题，遗失的或是损坏的货物、出现的没进行申报的人员、未登记也未检疫的新物种…"
                },
                {
                    "id": "670170303",
                    "speaker": "约霍",
                    "text": "唉，这个世界的其他地方平时也这么混乱吗？"
                }
            ]
        },
        {
            "talkId": "6701704",
            "initDialog": "670170401",
            "dialogues": [
                {
                    "id": "670170401",
                    "speaker": "Player",
                    "text": "打扰了，你慢慢处理吧。"
                },
                {
                    "id": "670170402",
                    "speaker": "约霍",
                    "text": "再会…"
                }
            ]
        },
        {
            "talkId": "6701705",
            "initDialog": "670170501",
            "dialogues": [
                {
                    "id": "670170501",
                    "speaker": "约霍",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6701706",
            "initDialog": "670170601",
            "dialogues": [
                {
                    "id": "670170601",
                    "speaker": "约霍",
                    "text": "赢了啊…噢，朋友，你想要再来一局吗？"
                }
            ]
        },
        {
            "talkId": "6701707",
            "initDialog": "670170701",
            "dialogues": [
                {
                    "id": "670170701",
                    "speaker": "约霍",
                    "text": "不仅工作做不完，就连牌也玩不明白了吗，问题真是一个接一个啊…"
                }
            ]
        }
    ]
}