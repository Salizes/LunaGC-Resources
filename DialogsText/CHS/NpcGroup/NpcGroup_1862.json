        {
            "talkId": "6186201",
            "initDialog": "618620101",
            "dialogues": [
                {
                    "id": "618620101",
                    "speaker": "「原海异种·膨膨兽」",
                    "text": "「圆圆的，很可爱。」"
                },
                {
                    "id": "618620102",
                    "speaker": "「原海异种·膨膨兽」",
                    "text": "「不过，仔细想想，这种『慵懒而堕落的低等动物』（借用雷穆利亚人的说法）在海中遨游的时间甚至比雷穆利亚的整个文明史还长。」"
                },
                {
                    "id": "618620103",
                    "speaker": "「原海异种·膨膨兽」",
                    "text": "「某种意义上，膨膨兽要比世上的一切帝国都更接近永恒——也更接近完美的球形。」"
                }
            ]
        }
    ]
}