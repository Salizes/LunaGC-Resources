{
    "groupId": "7005",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 6,
        "歌尔琴娜": 12
    },
    "talks": [
        {
            "talkId": "6700501",
            "initDialog": "670050101",
            "dialogues": [
                {
                    "id": "670050101",
                    "speaker": "歌尔琴娜",
                    "text": "都不是什么稀奇的玩意，随意挑选吧。"
                }
            ]
        },
        {
            "talkId": "6700503",
            "initDialog": "670050301",
            "dialogues": [
                {
                    "id": "670050301",
                    "speaker": "Player",
                    "text": "关于这些机关…"
                },
                {
                    "id": "670050302",
                    "speaker": "歌尔琴娜",
                    "text": "怎么？你对这些小东西感兴趣？先说清楚，这些可是没办法改装成军用型号的。"
                }
            ]
        },
        {
            "talkId": "6700504",
            "initDialog": "670050401",
            "dialogues": [
                {
                    "id": "670050401",
                    "speaker": "Player",
                    "text": "你是至冬人？"
                },
                {
                    "id": "670050402",
                    "speaker": "歌尔琴娜",
                    "text": "听口音听出来的，还是什么人告诉你的？呵，如果是前者，那你耳朵还挺尖。"
                },
                {
                    "id": "670050403",
                    "speaker": "歌尔琴娜",
                    "text": "没错，我来自至冬。但我现在就只是生活在那夏镇的店主，仅此而已。"
                },
                {
                    "id": "670050404",
                    "speaker": "歌尔琴娜",
                    "text": "比起冰天雪地的故乡，我更习惯这里的气候…和人。至少这里的人没那么多弯弯绕绕的心思，就连说谎都显得格外…质朴。"
                }
            ]
        },
        {
            "talkId": "6700505",
            "initDialog": "670050501",
            "dialogues": [
                {
                    "id": "670050501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670050502",
                    "speaker": "歌尔琴娜",
                    "text": "慢走。需要什么再来。"
                }
            ]
        },
        {
            "talkId": "6700506",
            "initDialog": "670050601",
            "dialogues": [
                {
                    "id": "670050601",
                    "speaker": "Player",
                    "text": "军用型号？"
                },
                {
                    "id": "670050602",
                    "speaker": "歌尔琴娜",
                    "text": "就是那些被愚人众塞满武器的型号。把原本服务人的技术用于作恶…真是暴殄天物，愚不可及，和他们组织的名字正相配。"
                },
                {
                    "id": "670050603",
                    "speaker": "歌尔琴娜",
                    "text": "这些机关做不了那种改装，或者说改装需要的成本比重新做一个还高。只能用作处理家务的仆役，所以买之前请想清楚。"
                }
            ]
        },
        {
            "talkId": "6700507",
            "initDialog": "670050701",
            "dialogues": [
                {
                    "id": "670050701",
                    "speaker": "Player",
                    "text": "只是有些好奇。"
                },
                {
                    "id": "670050702",
                    "speaker": "歌尔琴娜",
                    "text": "没事。需要的话就挑一个，不需要的话就看看别的。"
                }
            ]
        },
        {
            "talkId": "6700508",
            "initDialog": "670050801",
            "dialogues": [
                {
                    "id": "670050801",
                    "speaker": "Player",
                    "text": "关于愚人众…"
                },
                {
                    "id": "670050802",
                    "speaker": "歌尔琴娜",
                    "text": "问我干什么？我和那些庶…我是说，我和那些一天到晚戴着面具、鬼鬼祟祟的家伙可不是一路人。"
                },
                {
                    "id": "670050803",
                    "speaker": "歌尔琴娜",
                    "text": "还是说，你听到了什么无聊透顶的流言蜚语，告诉你说我是至冬的密探？那你未免太小看至冬的情报机构了，也太小看我了。"
                },
                {
                    "id": "670050804",
                    "speaker": "歌尔琴娜",
                    "text": "总之，他们做他们的脏事，我做我的生意，仅此而已。请不要再把我同他们相提并论了。"
                }
            ]
        }
    ]
}