{
    "groupId": "1846",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "茜尔丝汀": 10
    },
    "talks": [
        {
            "talkId": "6184601",
            "initDialog": "618460101",
            "dialogues": [
                {
                    "id": "618460101",
                    "speaker": "茜尔丝汀",
                    "text": "有趣的织卷…嗯？你好呀，新来的朋友，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6184602",
            "initDialog": "618460201",
            "dialogues": [
                {
                    "id": "618460201",
                    "speaker": "Player",
                    "text": "关于你的时代…"
                },
                {
                    "id": "618460202",
                    "speaker": "茜尔丝汀",
                    "text": "呵呵，与这里的其他朋友们相比，我的时代显得过于平淡了。"
                },
                {
                    "id": "618460203",
                    "speaker": "茜尔丝汀",
                    "text": "雷穆利亚与纯水骑士对我们来说是剧中的传说，而后世那些精妙的机械装置也还要上千年才能被发明出来。"
                },
                {
                    "id": "618460204",
                    "speaker": "茜尔丝汀",
                    "text": "所以，若是您想问我，我的时代有什么有趣的事，那您也许就要失望了。"
                },
                {
                    "id": "618460205",
                    "speaker": "茜尔丝汀",
                    "text": "我，茜尔丝汀·德·潘瑟赫，也不过是平凡的子爵之女。哪怕是在我的时代，也无法与德·佩特莉可或是兰道夫这种豪族相比。"
                }
            ]
        },
        {
            "talkId": "6184603",
            "initDialog": "618460301",
            "dialogues": [
                {
                    "id": "618460301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "618460302",
                    "speaker": "茜尔丝汀",
                    "text": "嗯，再见啦。"
                }
            ]
        },
        {
            "talkId": "6184604",
            "initDialog": "618460401",
            "dialogues": [
                {
                    "id": "618460401",
                    "speaker": "Player",
                    "text": "关于这里的展品…"
                },
                {
                    "id": "618460402",
                    "speaker": "茜尔丝汀",
                    "text": "据说是古代的纳塔人编织出的书卷来着。虽然我是看不太懂啦，但是很漂亮。"
                },
                {
                    "id": "618460403",
                    "speaker": "茜尔丝汀",
                    "text": "说起来，他们究竟为什么会有这样的传统呢？您瞧，在我们可爱的枫丹，「图画书」的出现反而要比文字更晚…"
                },
                {
                    "id": "618460404",
                    "speaker": "茜尔丝汀",
                    "text": "薇恩狄娅小姐…那位「雪翅雁夫人」，甚至没有听说过图画书。在她那个时代，颜料似乎只能用作军事用途。"
                },
                {
                    "id": "618460405",
                    "speaker": "茜尔丝汀",
                    "text": "纳塔…真是不可思议的地方呀。"
                }
            ]
        }
    ]
}