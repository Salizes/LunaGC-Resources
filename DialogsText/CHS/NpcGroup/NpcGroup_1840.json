{
    "groupId": "1840",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "虞黄衣": 9
    },
    "talks": [
        {
            "talkId": "6184001",
            "initDialog": "618400101",
            "dialogues": [
                {
                    "id": "618400101",
                    "speaker": "虞黄衣",
                    "text": "「待到你一脚踏碎混沌窍，方向是道…」"
                }
            ]
        },
        {
            "talkId": "6184002",
            "initDialog": "618400201",
            "dialogues": [
                {
                    "id": "618400201",
                    "speaker": "Player",
                    "text": "说说你的时代吧。"
                },
                {
                    "id": "618400202",
                    "speaker": "虞黄衣",
                    "text": "我的时代，似乎也没有什么特别的。"
                },
                {
                    "id": "618400203",
                    "speaker": "虞黄衣",
                    "text": "当时大家都围着天衡山住，有力气的锤金打铁。身手好的去山上猎肉采菇。"
                },
                {
                    "id": "618400204",
                    "speaker": "虞黄衣",
                    "text": "摩拉克斯——哈，那时既不是帝君，也不是岩王——他自称莫先生。"
                },
                {
                    "id": "618400205",
                    "speaker": "虞黄衣",
                    "text": "「神器未失，风云不起。四方泰平，且居这浮世一隅。」"
                },
                {
                    "id": "618400206",
                    "speaker": "虞黄衣",
                    "text": "我听人说了后来的事情。天下大乱，莫先生的「一隅」变大了不少啊。"
                }
            ]
        },
        {
            "talkId": "6184003",
            "initDialog": "618400301",
            "dialogues": [
                {
                    "id": "618400301",
                    "speaker": "Player",
                    "text": "为什么你们这么喜欢盘战斗力？"
                },
                {
                    "id": "618400302",
                    "speaker": "虞黄衣",
                    "text": "谁不喜欢呢？"
                },
                {
                    "id": "618400303",
                    "speaker": "虞黄衣",
                    "text": "我们只是有闲又有足够的见识去盘战斗力罢了。"
                }
            ]
        },
        {
            "talkId": "6184004",
            "initDialog": "618400401",
            "dialogues": [
                {
                    "id": "618400401",
                    "speaker": "Player",
                    "text": "再见！"
                },
                {
                    "id": "618400402",
                    "speaker": "虞黄衣",
                    "text": "再见。「纷纷世事无穷尽，茫茫天意不可逃。」"
                }
            ]
        }
    ]
}