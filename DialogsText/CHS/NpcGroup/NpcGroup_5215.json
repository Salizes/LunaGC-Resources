{
    "groupId": "5215",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "罗索里诺": 8
    },
    "talks": [
        {
            "talkId": "6521501",
            "initDialog": "652150101",
            "dialogues": [
                {
                    "id": "652150101",
                    "speaker": "罗索里诺",
                    "text": "我的左手边是发信室，右手边是医务室，别走错了。"
                }
            ]
        },
        {
            "talkId": "6521502",
            "initDialog": "652150201",
            "dialogues": [
                {
                    "id": "652150201",
                    "speaker": "Player",
                    "text": "关于发信室…"
                },
                {
                    "id": "652150202",
                    "speaker": "罗索里诺",
                    "text": "支付特许券，讲清楚收信人和地址，我们的人会帮你把信送到，仅限枫丹境内。信不能太长，信的内容…你自己掂量一下。"
                },
                {
                    "id": "652150203",
                    "speaker": "罗索里诺",
                    "text": "至于其他的，我劝你别多问。"
                }
            ]
        },
        {
            "talkId": "6521503",
            "initDialog": "652150301",
            "dialogues": [
                {
                    "id": "652150301",
                    "speaker": "Player",
                    "text": "关于医务室…"
                },
                {
                    "id": "652150302",
                    "speaker": "罗索里诺",
                    "text": "阿德纳医生如果不在医务室，多半是去生产区了。其他的我不知道。"
                }
            ]
        },
        {
            "talkId": "6521504",
            "initDialog": "652150401",
            "dialogues": [
                {
                    "id": "652150401",
                    "speaker": "Player",
                    "text": "好的，谢谢。"
                },
                {
                    "id": "652150402",
                    "speaker": "罗索里诺",
                    "text": "不客气。"
                }
            ]
        },
        {
            "talkId": "6521505",
            "initDialog": "652150501",
            "dialogues": [
                {
                    "id": "652150501",
                    "speaker": "罗索里诺",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6521506",
            "initDialog": "652150601",
            "dialogues": [
                {
                    "id": "652150601",
                    "speaker": "罗索里诺",
                    "text": "没事，你还有很多时间练牌。虽然我待在这梅洛彼得堡…时间更加用不完。"
                }
            ]
        },
        {
            "talkId": "6521507",
            "initDialog": "652150701",
            "dialogues": [
                {
                    "id": "652150701",
                    "speaker": "罗索里诺",
                    "text": "不错！明明看起来这么年轻，打牌却很老道！"
                }
            ]
        }
    ]
}