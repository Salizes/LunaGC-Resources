    "talks": [
        {
            "talkId": "6785301",
            "initDialog": "678530101",
            "dialogues": [
                {
                    "id": "678530101",
                    "speaker": "韦特洛娃",
                    "text": "连顿像样的晚餐都吃不上…这日子啊，是越来越难过了。"
                }
            ]
        },
        {
            "talkId": "6785302",
            "initDialog": "678530201",
            "dialogues": [
                {
                    "id": "678530201",
                    "speaker": "Player",
                    "text": "以前的日子是什么样的？"
                },
                {
                    "id": "678530202",
                    "speaker": "韦特洛娃",
                    "text": "以前？以前的凝露镇…虽不是至冬堡，但也有着自己的格调。好比说，天气虽然寒冷，可我们的家中还是常有鲜花。"
                },
                {
                    "id": "678530203",
                    "speaker": "韦特洛娃",
                    "text": "餐桌上铺着流苏桌布，茶炊总是嘶嘶作响。我们用银勺品尝枫丹运来的茶点，往琥珀色的热茶里加入牛乳和蜜糖。"
                },
                {
                    "id": "678530204",
                    "speaker": "韦特洛娃",
                    "text": "那时还有舞会，您知道吗，舞会，我们准备最漂亮的礼服，薄纱，或者丝绒…年轻女孩们戴着花冠…"
                },
                {
                    "id": "678530205",
                    "speaker": "韦特洛娃",
                    "text": "可如今，什么都没有了。我们没有钱，也买不到晶矿…"
                }
            ]
        },
        {
            "talkId": "6785303",
            "initDialog": "678530301",
