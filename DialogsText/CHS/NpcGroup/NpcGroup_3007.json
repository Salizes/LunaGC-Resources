{
    "groupId": "3007",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 7,
        "冈崎陆斗": 24
    },
    "talks": [
        {
            "talkId": "4006317",
            "initDialog": "400631701",
            "dialogues": [
                {
                    "id": "400631701",
                    "speaker": "冈崎陆斗",
                    "text": "年轻人，你好啊。有没有参加最近社奉行和八重堂在离岛举办的祭典呀？"
                },
                {
                    "id": "400631702",
                    "speaker": "冈崎陆斗",
                    "text": "听说办得不错，很受年轻人的欢迎，就连我这老头子开的店也接待了不少从祭典那过来的游客呢。"
                },
                {
                    "id": "400631703",
                    "speaker": "冈崎陆斗",
                    "text": "大家都穿得花花绿绿，热情高涨的。"
                },
                {
                    "id": "400631704",
                    "speaker": "冈崎陆斗",
                    "text": "不错不错，稻妻也该重新年轻起来了，哈哈。"
                }
            ]
        },
        {
            "talkId": "6300701",
            "initDialog": "630070101",
            "dialogues": [
                {
                    "id": "630070101",
                    "speaker": "冈崎陆斗",
                    "text": "年轻人，饿了吧？来尝尝绘里香的好手艺！"
                }
            ]
        },
        {
            "talkId": "6300702",
            "initDialog": "630070201",
            "dialogues": [
                {
                    "id": "630070201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630070202",
                    "speaker": "冈崎陆斗",
                    "text": "我么，是这家居酒屋的老板。"
                },
                {
                    "id": "630070203",
                    "speaker": "冈崎陆斗",
                    "text": "想吃什么随便点，找绘里香点菜就行。在我看来，她的手艺在稻妻城可算数一数二。"
                }
            ]
        },
        {
            "talkId": "6300703",
            "initDialog": "630070301",
            "dialogues": [
                {
                    "id": "630070301",
                    "speaker": "Player",
                    "text": "听说你是大人物？"
                },
                {
                    "id": "630070302",
                    "speaker": "冈崎陆斗",
                    "text": "嗯？你听谁说的？"
                },
                {
                    "id": "630070303",
                    "speaker": "冈崎陆斗",
                    "text": "哈哈，一定又是绘里香在夸我了。"
                },
                {
                    "id": "630070304",
                    "speaker": "冈崎陆斗",
                    "text": "实不相瞒，当年我在天领奉行的名望甚高。即便现在隐退，也有不少与力、同心来找我商谈事宜。"
                },
                {
                    "id": "630070305",
                    "speaker": "冈崎陆斗",
                    "text": "最近偶尔就连常常出入奉行府的大人物也会屈尊莅临本店…看来当下的稻妻确实暗流涌动啊…"
                }
            ]
        },
        {
            "talkId": "6300704",
            "initDialog": "630070401",
            "dialogues": [
                {
                    "id": "630070401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630070402",
                    "speaker": "冈崎陆斗",
                    "text": "嗯，欢迎再来。"
                }
            ]
        },
        {
            "talkId": "6300705",
            "initDialog": "630070501",
            "dialogues": [
                {
                    "id": "630070501",
                    "speaker": "Player",
                    "text": "身为老板却在喝酒吗？"
                },
                {
                    "id": "630070502",
                    "speaker": "冈崎陆斗",
                    "text": "有何不可？清酒在手，佳肴常伴，不来一杯怎么对得起奔波的一生。"
                },
                {
                    "id": "630070503",
                    "speaker": "冈崎陆斗",
                    "text": "加油，有朝一日你当了老板，也能像我一样。"
                }
            ]
        },
        {
            "talkId": "6300706",
            "initDialog": "630070601",
            "dialogues": [
                {
                    "id": "630070601",
                    "speaker": "Player",
                    "text": "稻妻现在…"
                },
                {
                    "id": "630070602",
                    "speaker": "冈崎陆斗",
                    "text": "哎呀，这位客人年纪轻轻，也关心稻妻时政？"
                },
                {
                    "id": "630070603",
                    "speaker": "冈崎陆斗",
                    "text": "也难怪，你毕竟是异乡的旅客嘛，如果被困在稻妻没法回家，可是件麻烦事。"
                },
                {
                    "id": "630070604",
                    "speaker": "冈崎陆斗",
                    "text": "要我说的话…天领奉行永远相信将军大人的神力，将军大人的选择也一定有其含义吧。"
                }
            ]
        },
        {
            "talkId": "6300707",
            "initDialog": "630070701",
            "dialogues": [
                {
                    "id": "630070701",
                    "speaker": "Player",
                    "text": "关于势至丸…"
                },
                {
                    "id": "630070702",
                    "speaker": "冈崎陆斗",
                    "text": "哦？年轻人，你对这个故事很感兴趣呀。"
                },
                {
                    "id": "630070703",
                    "speaker": "冈崎陆斗",
                    "text": "不瞒你说，势至丸原本是我家族中的亲戚。"
                },
                {
                    "id": "630070704",
                    "speaker": "冈崎陆斗",
                    "text": "他的事也曾经闹得沸沸扬扬，只是现在年轻人们都不知道这些旧事了。"
                },
                {
                    "id": "630070705",
                    "speaker": "冈崎陆斗",
                    "text": "我也活了几十年，看了几十年，世上真实发生过的事总是比故事精彩啊呵呵。"
                }
            ]
        },
        {
            "talkId": "7293401",
            "initDialog": "729340101",
            "dialogues": [
                {
                    "id": "729340101",
                    "speaker": "Player",
                    "text": "我还喝不了酒哦。"
                },
                {
                    "id": "729340102",
                    "speaker": "冈崎陆斗",
                    "text": "那是因为你还年轻嘛。"
                },
                {
                    "id": "729340103",
                    "speaker": "冈崎陆斗",
                    "text": "不喝酒也有不喝酒的好处啊，年轻人可不要急功近利。"
                },
                {
                    "id": "729340104",
                    "speaker": "冈崎陆斗",
                    "text": "来，一起吃点炸串吧。没有了酒的下酒菜，也是美味的食物呀。"
                }
            ]
        }
    ]
}