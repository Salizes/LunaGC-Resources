    "talks": [
        {
            "talkId": "34704",
            "initDialog": "3470401",
            "dialogues": [
                {
                    "id": "3470401",
                    "speaker": "图书馆使用规范",
                    "text": "「图书馆使用规范·第七版」"
                },
                {
                    "id": "3470402",
                    "speaker": "图书馆使用规范",
                    "text": "「以前也写过很多版使用规范，但效果总不好。」"
                },
                {
                    "id": "3470403",
                    "speaker": "图书馆使用规范",
                    "text": "「这一版索性去掉了所有不必要的条例。但凡使用图书馆的人，只需要记住以下规则：」"
                },
                {
                    "id": "3470404",
                    "speaker": "图书馆使用规范",
                    "text": "「一、图书馆内请保持安静；」"
                },
                {
                    "id": "3470405",
                    "speaker": "图书馆使用规范",
                    "text": "「二、请勿损害馆藏；」"
                },
                {
                    "id": "3470406",
                    "speaker": "图书馆使用规范",
                    "text": "「三、出借的情况，请借书者记住约定的归还时间，并依此履行。」"
                },
                {
                    "id": "3470407",
                    "speaker": "图书馆使用规范",
                    "text": "「对违反规范者的处理方法，大家都很清楚吧？此处不必赘叙。」"
                },
                {
                    "id": "3470408",
                    "speaker": "图书馆使用规范",
                    "text": "「以上。希望大家愉快合理地使用图书馆。」"
                }
            ]
        }
    ]
}