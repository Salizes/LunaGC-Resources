{
    "groupId": "3004",
    "total_dialogue_lines": 80,
    "speaker_counts": {
        "Player": 20,
        "凯瑟琳": 60
    },
    "talks": [
        {
            "talkId": "6300401",
            "initDialog": "630040101",
            "dialogues": [
                {
                    "id": "630040101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。"
                }
            ]
        },
        {
            "talkId": "6300402",
            "initDialog": "630040201",
            "dialogues": [
                {
                    "id": "630040201",
                    "speaker": "Player",
                    "text": "你好…？"
                },
                {
                    "id": "630040202",
                    "speaker": "凯瑟琳",
                    "text": "你好，我是冒险家协会的接待员凯瑟琳，负责为冒险家们提供任务发布和情报支援工作。"
                },
                {
                    "id": "630040203",
                    "speaker": "凯瑟琳",
                    "text": "这项服务全年无休，还请不必担心。"
                }
            ]
        },
        {
            "talkId": "6300403",
            "initDialog": "630040301",
            "dialogues": [
                {
                    "id": "630040301",
                    "speaker": "Player",
                    "text": "又一个凯瑟琳…"
                },
                {
                    "id": "630040302",
                    "speaker": "凯瑟琳",
                    "text": "又一个？呵呵，你可曾同时见过很多个凯瑟琳？"
                },
                {
                    "id": "630040303",
                    "speaker": "凯瑟琳",
                    "text": "没有的话，那你见到的应该都是同一个我。为了满足各地冒险家们的需求，我会使用特殊的工具瞬移，多地同时办公。"
                }
            ]
        },
        {
            "talkId": "6300404",
            "initDialog": "630040401",
            "dialogues": [
                {
                    "id": "630040401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630040402",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，冒险家。"
                }
            ]
        },
        {
            "talkId": "6300405",
            "initDialog": "630040501",
            "dialogues": [
                {
                    "id": "630040501",
                    "speaker": "Player",
                    "text": "我也想瞬移！"
                },
                {
                    "id": "630040502",
                    "speaker": "凯瑟琳",
                    "text": "哎呀，你相信了？"
                },
                {
                    "id": "630040503",
                    "speaker": "凯瑟琳",
                    "text": "抱歉，瞬移的事情是在开玩笑，还请不要放在心上。"
                },
                {
                    "id": "630040504",
                    "speaker": "凯瑟琳",
                    "text": "再说，你应该会用传送锚点的吧？"
                }
            ]
        },
        {
            "talkId": "6300406",
            "initDialog": "630040601",
            "dialogues": [
                {
                    "id": "630040601",
                    "speaker": "凯瑟琳",
                    "text": "领取「冒险等阶」奖励"
                }
            ]
        },
        {
            "talkId": "6300407",
            "initDialog": "630040701",
            "dialogues": [
                {
                    "id": "630040701",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>领取「冒险等阶」奖励</color>"
                }
            ]
        },
        {
            "talkId": "6300408",
            "initDialog": "630040801",
            "dialogues": [
                {
                    "id": "630040801",
                    "speaker": "凯瑟琳",
                    "text": "查看「豪斗旅纪」信息"
                }
            ]
        },
        {
            "talkId": "6300409",
            "initDialog": "630040901",
            "dialogues": [
                {
                    "id": "630040901",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>查看「豪斗旅纪」信息</color>"
                }
            ]
        },
        {
            "talkId": "6300410",
            "initDialog": "630041001",
            "dialogues": [
                {
                    "id": "630041001",
                    "speaker": "凯瑟琳",
                    "text": "欢迎来到冒险家协会，「木偶」大人。有什么我能为您做的吗？"
                }
            ]
        },
        {
            "talkId": "6300411",
            "initDialog": "630041101",
            "dialogues": [
                {
                    "id": "630041101",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630041102",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，「木偶」大人。"
                }
            ]
        },
        {
            "talkId": "7068803",
            "initDialog": "706880301",
            "dialogues": [
                {
                    "id": "706880301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么厉害的委托吗？</color>"
                },
                {
                    "id": "706880302",
                    "speaker": "凯瑟琳",
                    "text": "您来的正巧，有一份协会共享给资深冒险家的手册要交给您。",
                    "choices": [
                        {
                            "id": "706880303",
                            "text": "是提瓦特美食大全吗？",
                            "response": [
                                {
                                    "id": "706880304",
                                    "speaker": "凯瑟琳",
                                    "text": "很遗憾，并不是。"
                                },
                                {
                                    "id": "706880307",
                                    "speaker": "凯瑟琳",
                                    "text": "如您所见，手册记录了值得挑战的强敌的信息。"
                                },
                                {
                                    "id": "706880308",
                                    "speaker": "凯瑟琳",
                                    "text": "若能合理利用，想必会为您的冒险旅途增加许多助益。之后如果需要查阅相关信息，也随时欢迎您来。"
                                },
                                {
                                    "id": "706880309",
                                    "speaker": "凯瑟琳",
                                    "text": "那么，就祝您旗开得胜。"
                                }
                            ]
                        },
                        {
                            "id": "706880305",
                            "text": "难道又是新的任务…",
                            "response": [
                                {
                                    "id": "706880306",
                                    "speaker": "凯瑟琳",
                                    "text": "挑战与否，选择权当然在您。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7165601",
            "initDialog": "716560101",
            "dialogues": [
                {
                    "id": "716560101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！感谢你的到来，冒险家。",
                    "choices": [
                        {
                            "id": "716560102",
                            "text": "有新的委托吗？",
                            "response": [
                                {
                                    "id": "716560103",
                                    "speaker": "凯瑟琳",
                                    "text": "是的，我们准备展开新一轮的生态调查。"
                                },
                                {
                                    "id": "716560106",
                                    "speaker": "凯瑟琳",
                                    "text": "总之，还是由我先解释一下情况吧。"
                                },
                                {
                                    "id": "716560107",
                                    "speaker": "凯瑟琳",
                                    "text": "近些日子，有关「飘浮灵」的目击报告激增，状况很不寻常。"
                                },
                                {
                                    "id": "716560108",
                                    "speaker": "凯瑟琳",
                                    "text": "这本来是一种很少见的元素生物，它们突然大量出现，背后多半有什么原因。"
                                },
                                {
                                    "id": "716560109",
                                    "speaker": "凯瑟琳",
                                    "text": "由于对这种生物了解甚少，冒险家协会正在组织全方位的调查行动。",
                                    "choices": [
                                        {
                                            "id": "716560110",
                                            "text": "是这么厉害的怪物吗？",
                                            "response": [
                                                {
                                                    "id": "716560112",
                                                    "speaker": "凯瑟琳",
                                                    "text": "由于情况反常，又事出突然，所以它们现在性情如何，是否有很强的攻击性，这些我们都还难以确定。"
                                                },
                                                {
                                                    "id": "716560115",
                                                    "speaker": "Player",
                                                    "text": "好吧，我接受了。"
                                                },
                                                {
                                                    "id": "716560117",
                                                    "speaker": "凯瑟琳",
                                                    "text": "感谢你能答应，需要你帮忙的其实很简单，就是和同伴一起走访稻妻各处，观察「飘浮灵」的异状。"
                                                },
                                                {
                                                    "id": "716560118",
                                                    "speaker": "凯瑟琳",
                                                    "text": "形式类似于之前你执行过的「探索派遣」，我已经将各地的「飘浮灵」目击情报整理好了。"
                                                },
                                                {
                                                    "id": "716560119",
                                                    "speaker": "凯瑟琳",
                                                    "text": "事不宜迟，由我来为你展示一下。"
                                                },
                                                {
                                                    "id": "716560120",
                                                    "speaker": "凯瑟琳",
                                                    "text": "由于「飘浮灵」是元素生物，如果能够按照协会所推荐的元素类型安排人手，应该就能取得事半功倍的效果。"
                                                },
                                                {
                                                    "id": "716560121",
                                                    "speaker": "凯瑟琳",
                                                    "text": "其中会有一项比较特殊的委托，由于协会收集的信息不足，需要麻烦你先去现场调查，完成后再由我来安排派遣事宜。"
                                                },
                                                {
                                                    "id": "716560122",
                                                    "speaker": "Player",
                                                    "text": "简单来说就是前期准备吧。"
                                                },
                                                {
                                                    "id": "716560123",
                                                    "speaker": "凯瑟琳",
                                                    "text": "嗯，这种委托往往有一些难度，但交给你我非常放心。"
                                                },
                                                {
                                                    "id": "716560124",
                                                    "speaker": "凯瑟琳",
                                                    "text": "我会每天更新关于「飘浮灵」的情报，尽全力为你和你的同伴做好支援工作。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "716560111",
                                            "text": "太兴师动众了吧。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "716560104",
                            "text": "我大概知道要做什么…",
                            "response": [
                                {
                                    "id": "716560105",
                                    "speaker": "凯瑟琳",
                                    "text": "欸？以前你处理过这样的委托吗？那太好了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7165701",
            "initDialog": "716570101",
            "dialogues": [
                {
                    "id": "716570101",
                    "speaker": "凯瑟琳",
                    "text": "感谢你这段时间的努力，冒险家，现在我们已经收集到足够多的关于「飘浮灵」的情报了。",
                    "choices": [
                        {
                            "id": "716570102",
                            "text": "帮上忙就好。",
                            "response": [
                                {
                                    "id": "716570103",
                                    "speaker": "凯瑟琳",
                                    "text": "嗯，你提供的观察情报非常重要，太感谢了。"
                                },
                                {
                                    "id": "716570106",
                                    "speaker": "凯瑟琳",
                                    "text": "之后就不用太担心「飘浮灵」威胁到普通人的安全了，这次的情报我也会整理起来，交给专业的学者去研究。"
                                },
                                {
                                    "id": "716570107",
                                    "speaker": "凯瑟琳",
                                    "text": "对了，不要忘记领取协会提供的报酬哦！"
                                },
                                {
                                    "id": "716570108",
                                    "speaker": "凯瑟琳",
                                    "text": "向着星辰与深渊！冒险家协会感谢你所做的一切！"
                                }
                            ]
                        },
                        {
                            "id": "716570104",
                            "text": "想要更多奖励。",
                            "response": [
                                {
                                    "id": "716570105",
                                    "speaker": "凯瑟琳",
                                    "text": "哈哈，没问题，那请不要错过冒险家协会之后的委托。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7280801",
            "initDialog": "728080101",
            "dialogues": [
                {
                    "id": "728080101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。"
                },
                {
                    "id": "728080102",
                    "speaker": "凯瑟琳",
                    "text": "你终于来了，我已经等候多时了，冒险家。"
                },
                {
                    "id": "728080103",
                    "speaker": "Player",
                    "text": "又、又一个凯瑟琳小姐…"
                },
                {
                    "id": "728080104",
                    "speaker": "凯瑟琳",
                    "text": "又一个？呵呵，你什么时候同时见过很多凯瑟琳吗？"
                },
                {
                    "id": "728080105",
                    "speaker": "凯瑟琳",
                    "text": "没有的话，你见到的应该都是同一个我。"
                },
                {
                    "id": "728080106",
                    "speaker": "凯瑟琳",
                    "text": "作为冒险家协会里唯一一个全年无休的接待员，我会使用一种特殊的工具在全世界各处瞬间移动，处理各项重要的事务…"
                },
                {
                    "id": "728080107",
                    "speaker": "凯瑟琳",
                    "text": "等为你办好了这边的事务，我还要继续瞬移前往枫丹呢，那边的冒险家可是出了名的锱铢必较，必须要好好接待才行。",
                    "choices": [
                        {
                            "id": "728080108",
                            "text": "真、真的吗？",
                            "response": [
                                {
                                    "id": "728080110",
                                    "speaker": "凯瑟琳",
                                    "text": "哎呀…你相信了？抱歉，瞬移的事是开玩笑，还请不要放在心上。"
                                },
                                {
                                    "id": "728080111",
                                    "speaker": "凯瑟琳",
                                    "text": "再说了，说到瞬移，你不是也会使用「传送锚点」吗？"
                                },
                                {
                                    "id": "728080112",
                                    "speaker": "凯瑟琳",
                                    "text": "好了，先不说这些耽误你的冒险行动了，来吧，我为你办理稻妻冒险家协会的事务。"
                                },
                                {
                                    "id": "728080113",
                                    "speaker": "凯瑟琳",
                                    "text": "等办理好了之后，你就可以在稻妻冒险家协会这里继续接取委托，和享受其他服务了。"
                                },
                                {
                                    "id": "728080114",
                                    "speaker": "凯瑟琳",
                                    "text": "向着星辰与深渊，冒险家。"
                                }
                            ]
                        },
                        {
                            "id": "728080109",
                            "text": "我也想瞬移！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "2010136",
            "initDialog": "201013601",
            "dialogues": [
                {
                    "id": "201013601",
                    "speaker": "凯瑟琳",
                    "text": "领取「每日委托」奖励"
                },
                {
                    "id": "201013602",
                    "speaker": "凯瑟琳",
                    "text": "很抱歉，今天你完成的委托数量还不够呢。"
                }
            ]
        },
        {
            "talkId": "2010137",
            "initDialog": "201013701",
            "dialogues": [
                {
                    "id": "201013701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013702",
                    "speaker": "凯瑟琳",
                    "text": "感谢你完成了今天的委托，这是给你的奖励。"
                }
            ]
        },
        {
            "talkId": "2010138",
            "initDialog": "201013801",
            "dialogues": [
                {
                    "id": "201013801",
                    "speaker": "凯瑟琳",
                    "text": "<color=#999999FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013802",
                    "speaker": "凯瑟琳",
                    "text": "你已经领取过今天的奖励了，希望你明天也能继续承接协会的委托。"
                }
            ]
        },
        {
            "talkId": "2010141",
            "initDialog": "201014101",
            "dialogues": [
                {
                    "id": "201014101",
                    "speaker": "凯瑟琳",
                    "text": "探索派遣"
                }
            ]
        },
        {
            "talkId": "2010142",
            "initDialog": "201014201",
            "dialogues": [
                {
                    "id": "201014201",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>探索派遣</color>"
                }
            ]
        }
    ]
}