{
    "groupId": "9067",
    "total_dialogue_lines": 69,
    "speaker_counts": {
        "Player": 21,
        "柯莱": 48
    },
    "talks": [
        {
            "talkId": "6906701",
            "initDialog": "690670101",
            "dialogues": [
                {
                    "id": "690670101",
                    "speaker": "柯莱",
                    "text": "#最近都还好吗，{NICKNAME}。"
                },
                {
                    "id": "690670102",
                    "speaker": "柯莱",
                    "text": "如果有哪里不舒服，千万不要勉强自己啊。"
                }
            ]
        },
        {
            "talkId": "6906702",
            "initDialog": "690670201",
            "dialogues": [
                {
                    "id": "690670201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690670202",
                    "speaker": "柯莱",
                    "text": "嗯，感觉不错，很适合放松休养。"
                },
                {
                    "id": "690670203",
                    "speaker": "柯莱",
                    "text": "其实作为巡林员，在野外露宿都很正常。"
                },
                {
                    "id": "690670204",
                    "speaker": "柯莱",
                    "text": "我以前流浪的时候，有个可以挡风的帐篷就已经很不错了。"
                },
                {
                    "id": "690670205",
                    "speaker": "柯莱",
                    "text": "不过要说的话…我还是喜欢待在草木茂盛些的地方吧，感觉到处都是「生迹」呢！"
                },
                {
                    "id": "690670206",
                    "speaker": "Player",
                    "text": "你是想说「生机」吗…"
                },
                {
                    "id": "690670207",
                    "speaker": "柯莱",
                    "text": "欸！欸…原来是「生机」吗！"
                },
                {
                    "id": "690670208",
                    "speaker": "柯莱",
                    "text": "抱歉，我就只听师父说过一遍…说是有「生机」的地方会对身体好。"
                },
                {
                    "id": "690670209",
                    "speaker": "Player",
                    "text": "那要不要我再多栽些树？"
                },
                {
                    "id": "690670210",
                    "speaker": "柯莱",
                    "text": "不用麻烦你啦，现在这样就很好。"
                },
                {
                    "id": "690670211",
                    "speaker": "柯莱",
                    "text": "要在一个地方住得久，最重要的还是「心情」吧。"
                },
                {
                    "id": "690670212",
                    "speaker": "柯莱",
                    "text": "我很喜欢这个地方，多谢你的邀请。"
                }
            ]
        },
        {
            "talkId": "6906703",
            "initDialog": "690670301",
            "dialogues": [
                {
                    "id": "690670301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690670302",
                    "speaker": "柯莱",
                    "text": "好的！"
                },
                {
                    "id": "690670303",
                    "speaker": "柯莱",
                    "text": "……"
                },
                {
                    "id": "690670304",
                    "speaker": "柯莱",
                    "text": "…抱歉，我还以为你会先开口。"
                },
                {
                    "id": "690670305",
                    "speaker": "柯莱",
                    "text": "我没怎么主动和朋友聊过天…不知道这种时候该找什么话题。"
                },
                {
                    "id": "690670306",
                    "speaker": "Player",
                    "text": "没事，我正好有事想告诉你。"
                },
                {
                    "id": "690670307",
                    "speaker": "柯莱",
                    "text": "唔…嗯，来吧！我已经准备好了。",
                    "choices": [
                        {
                            "id": "690670308",
                            "text": "安柏和我说了一些你的情况…",
                            "response": [
                                {
                                    "id": "690670309",
                                    "speaker": "柯莱",
                                    "text": "——安柏？她提到我了吗？她是怎么说的？稍等，我去找个本子记录一下！",
                                    "choices": [
                                        {
                                            "id": "690670310",
                                            "text": "看到你阳光的样子…",
                                            "response": [
                                                {
                                                    "id": "690670312",
                                                    "speaker": "柯莱",
                                                    "text": "哪里，我还差得远呢…还有吗？",
                                                    "choices": [
                                                        {
                                                            "id": "690670313",
                                                            "text": "说起你最近的来信…",
                                                            "response": [
                                                                {
                                                                    "id": "690670315",
                                                                    "speaker": "柯莱",
                                                                    "text": "唔…我，我已经尽力了…"
                                                                },
                                                                {
                                                                    "id": "690670320",
                                                                    "speaker": "柯莱",
                                                                    "text": "最近我又学了一些新词，想着要多熟悉熟悉，就全都用到信里了。"
                                                                },
                                                                {
                                                                    "id": "690670321",
                                                                    "speaker": "柯莱",
                                                                    "text": "如果已经影响到阅读的话，还是我太心急了吗。"
                                                                },
                                                                {
                                                                    "id": "690670322",
                                                                    "speaker": "柯莱",
                                                                    "text": "得小心一点用，少用一点，新的和旧的混在一起…"
                                                                },
                                                                {
                                                                    "id": "690670323",
                                                                    "speaker": "Player",
                                                                    "text": "我可以帮你检查拼写哦。"
                                                                },
                                                                {
                                                                    "id": "690670324",
                                                                    "speaker": "柯莱",
                                                                    "text": "真的吗？那就拜托你了！而且，还要叫你一声「师父」才行！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690670314",
                                                            "text": "错字稍微有点多…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690670311",
                                            "text": "她也感到非常高兴。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690670316",
                            "text": "凯亚和我说了一些你的情况…",
                            "response": [
                                {
                                    "id": "690670317",
                                    "speaker": "柯莱",
                                    "text": "凯、凯亚吗…抱歉，我突然有点胃痛…"
                                },
                                {
                                    "id": "690670318",
                                    "speaker": "Player",
                                    "text": "说你最近的来信错字很多。"
                                },
                                {
                                    "id": "690670319",
                                    "speaker": "柯莱",
                                    "text": "啊，原来是这件事吗。我还以为肯定会…咳，没什么。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906704",
            "initDialog": "690670401",
            "dialogues": [
                {
                    "id": "690670401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690670402",
                    "speaker": "柯莱",
                    "text": "嗯，我正想着要不要约你一起去露营呢。"
                },
                {
                    "id": "690670403",
                    "speaker": "柯莱",
                    "text": "我这几天的精神不错，又刚好考完试，师父说可以适当出去放松一下。"
                },
                {
                    "id": "690670404",
                    "speaker": "柯莱",
                    "text": "我们可以找个视野开阔的地方看风景，还可以准备一些食材野炊。",
                    "choices": [
                        {
                            "id": "690670405",
                            "text": "大概什么时候？",
                            "response": [
                                {
                                    "id": "690670407",
                                    "speaker": "柯莱",
                                    "text": "嗯…要不然，今天就出发？"
                                },
                                {
                                    "id": "690670408",
                                    "speaker": "Player",
                                    "text": "这么着急吗！"
                                },
                                {
                                    "id": "690670409",
                                    "speaker": "柯莱",
                                    "text": "唔…其实我只是刚交了测试卷，师父说忙完手头的事情再来批改…"
                                },
                                {
                                    "id": "690670410",
                                    "speaker": "柯莱",
                                    "text": "可万一改完发现我的进度不如预期，就又得开始补课了。"
                                },
                                {
                                    "id": "690670411",
                                    "speaker": "柯莱",
                                    "text": "难得你答应了，我不太想放弃这个机会…"
                                },
                                {
                                    "id": "690670412",
                                    "speaker": "柯莱",
                                    "text": "但仔细想想…就算食材可以就地取用，合适的地点一下子也想不出来。"
                                },
                                {
                                    "id": "690670413",
                                    "speaker": "柯莱",
                                    "text": "况且在野外露营要注意的事项还有很多…唔…"
                                },
                                {
                                    "id": "690670414",
                                    "speaker": "Player",
                                    "text": "要不直接在这里露营？"
                                },
                                {
                                    "id": "690670415",
                                    "speaker": "柯莱",
                                    "text": "欸！在这里吗…对呀，我怎么没想到！"
                                },
                                {
                                    "id": "690670416",
                                    "speaker": "柯莱",
                                    "text": "地势开阔，风景也很不错，还不会有什么危险…"
                                },
                                {
                                    "id": "690670417",
                                    "speaker": "Player",
                                    "text": "就当做正式露营前的演练吧。"
                                },
                                {
                                    "id": "690670418",
                                    "speaker": "柯莱",
                                    "text": "好！真不愧是你，一下子就想出了那么好的点子。"
                                },
                                {
                                    "id": "690670419",
                                    "speaker": "柯莱",
                                    "text": "哎呀，阿圆不会有意见吧？"
                                }
                            ]
                        },
                        {
                            "id": "690670406",
                            "text": "我去做点准备？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906705",
            "initDialog": "690670501",
            "dialogues": [
                {
                    "id": "690670501",
                    "speaker": "Player",
                    "text": "早啊，柯莱。"
                },
                {
                    "id": "690670502",
                    "speaker": "柯莱",
                    "text": "#早上好，{NICKNAME}！"
                },
                {
                    "id": "690670503",
                    "speaker": "柯莱",
                    "text": "感觉今天的状态很不错，希望我能够保持下去。"
                }
            ]
        },
        {
            "talkId": "6906706",
            "initDialog": "690670601",
            "dialogues": [
                {
                    "id": "690670601",
                    "speaker": "Player",
                    "text": "晚安，柯莱。"
                },
                {
                    "id": "690670602",
                    "speaker": "柯莱",
                    "text": "#早点休息，{NICKNAME}，希望明天也是美好的一天。"
                },
                {
                    "id": "690670603",
                    "speaker": "柯莱",
                    "text": "嗯？我吗？唔…我做完今天的课题就去睡觉…"
                }
            ]
        },
        {
            "talkId": "6906710",
            "initDialog": "690671001",
            "dialogues": [
                {
                    "id": "690671001",
                    "speaker": "柯莱",
                    "text": "呼，好棒的小屋。要是在这读书的话，时间一定很快就会过去吧。"
                },
                {
                    "id": "690671002",
                    "speaker": "柯莱",
                    "text": "当然…也有可能因为生字太多，总是向你提问，破坏了那么好的气氛…"
                },
                {
                    "id": "690671003",
                    "speaker": "柯莱",
                    "text": "那…那我还是温习一下之前看过的故事书吧。"
                }
            ]
        },
        {
            "talkId": "6906711",
            "initDialog": "690671101",
            "dialogues": [
                {
                    "id": "690671101",
                    "speaker": "柯莱",
                    "text": "棚屋的材料用的是木桩和绳索，缠好之后也很牢固…"
                },
                {
                    "id": "690671102",
                    "speaker": "柯莱",
                    "text": "看来你很有一套嘛！我都提不出什么建议啦。"
                },
                {
                    "id": "690671103",
                    "speaker": "柯莱",
                    "text": "下次露营的时候，我们也要试着亲手搭出那么结实的帐篷。"
                }
            ]
        }
    ]
}