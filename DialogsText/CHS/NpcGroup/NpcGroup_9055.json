{
    "groupId": "9055",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Player": 16,
        "五郎": 55
    },
    "talks": [
        {
            "talkId": "6905501",
            "initDialog": "690550101",
            "dialogues": [
                {
                    "id": "690550101",
                    "speaker": "五郎",
                    "text": "#你回来了！{NICKNAME}！"
                },
                {
                    "id": "690550102",
                    "speaker": "五郎",
                    "text": "怎么样，一切都好吗？"
                }
            ]
        },
        {
            "talkId": "6905502",
            "initDialog": "690550201",
            "dialogues": [
                {
                    "id": "690550201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690550202",
                    "speaker": "五郎",
                    "text": "嗯，当然！放心吧，我的适应力是很强的。"
                },
                {
                    "id": "690550203",
                    "speaker": "五郎",
                    "text": "以前在军营里，哪怕枕着石头，或者躺在路边草地里都能休息。",
                    "choices": [
                        {
                            "id": "690550204",
                            "text": "会觉得这里的生活太松懈吗？",
                            "response": [
                                {
                                    "id": "690550205",
                                    "speaker": "五郎",
                                    "text": "哈哈，不要这么说！"
                                },
                                {
                                    "id": "690550206",
                                    "speaker": "五郎",
                                    "text": "一直紧绷着弓弦的话，它就会变得容易断裂。"
                                },
                                {
                                    "id": "690550207",
                                    "speaker": "五郎",
                                    "text": "适当的放松，是为了更好地战斗。对我而言，这里的生活就是最好的调剂！"
                                },
                                {
                                    "id": "690550211",
                                    "speaker": "五郎",
                                    "text": "对了，正好借这个机会，我想认真地向你表达我的感激，谢谢你！"
                                },
                                {
                                    "id": "690550212",
                                    "speaker": "五郎",
                                    "text": "你对我那么真诚，让我心里特别温暖。"
                                },
                                {
                                    "id": "690550213",
                                    "speaker": "五郎",
                                    "text": "不过，我也不会怠惰，随时都可以切换到备战和上阵的状态。不必担心！"
                                }
                            ]
                        },
                        {
                            "id": "690550208",
                            "text": "现在不用那么艰苦了…",
                            "response": [
                                {
                                    "id": "690550209",
                                    "speaker": "五郎",
                                    "text": "唔，是啊…"
                                },
                                {
                                    "id": "690550210",
                                    "speaker": "五郎",
                                    "text": "现在的轻松来之不易，我会好好珍惜的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905503",
            "initDialog": "690550301",
            "dialogues": [
                {
                    "id": "690550301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690550302",
                    "speaker": "五郎",
                    "text": "好啊！"
                },
                {
                    "id": "690550303",
                    "speaker": "五郎",
                    "text": "就和你讲讲反抗军里的趣事吧？你在别的地方不一定会遇到哦。"
                },
                {
                    "id": "690550304",
                    "speaker": "Player",
                    "text": "我很有兴趣…"
                },
                {
                    "id": "690550305",
                    "speaker": "五郎",
                    "text": "嗯！反抗军的将士们并非每个人都经过专业训练，新兵难免会犯些小错误。"
                },
                {
                    "id": "690550306",
                    "speaker": "五郎",
                    "text": "比如远征训练期间，没有考虑到口粮的保存条件，只好吃了半个月的白萝卜。"
                },
                {
                    "id": "690550307",
                    "speaker": "五郎",
                    "text": "侦察时，把动物留下的痕迹当成敌军的线索，和野林猪斗智斗勇三天三夜…"
                },
                {
                    "id": "690550308",
                    "speaker": "五郎",
                    "text": "这些小错没有造成严重的后果，倒是变成了我们茶余饭后的笑谈。"
                },
                {
                    "id": "690550309",
                    "speaker": "五郎",
                    "text": "但仔细想想，确实可以通过调整编制来避免…"
                },
                {
                    "id": "690550310",
                    "speaker": "五郎",
                    "text": "应该把反抗军中的老兵编制打散，尽可能分散到新兵的团队中去，让他们和新兵分享经验。"
                },
                {
                    "id": "690550311",
                    "speaker": "五郎",
                    "text": "啊，抱歉，是我不好！不知不觉就开始思考了！"
                },
                {
                    "id": "690550312",
                    "speaker": "五郎",
                    "text": "调整编制的事，以后再想！既然是陪你聊天，还是说点轻松的事情吧。比如，最近啊…"
                },
                {
                    "id": "690550313",
                    "speaker": "Player",
                    "text": "想听「常胜将军」自己的故事…"
                },
                {
                    "id": "690550314",
                    "speaker": "五郎",
                    "text": "…我自己的事？"
                },
                {
                    "id": "690550315",
                    "speaker": "五郎",
                    "text": "唔…"
                },
                {
                    "id": "690550316",
                    "speaker": "五郎",
                    "text": "虽然将士们经常向别人夸耀我的战绩。但总觉得，亲口说自己的经历，像是在自吹自擂。",
                    "choices": [
                        {
                            "id": "690550317",
                            "text": "想听想听！",
                            "response": [
                                {
                                    "id": "690550319",
                                    "speaker": "五郎",
                                    "text": "你该不会是看准了我不会违背你的想法…才这么说的吧。"
                                },
                                {
                                    "id": "690550320",
                                    "speaker": "五郎",
                                    "text": "咳咳…真拿你没办法…"
                                },
                                {
                                    "id": "690550321",
                                    "speaker": "五郎",
                                    "text": "那就聊一聊…我在名椎滩北部独自侦察的惊险经历吧…"
                                },
                                {
                                    "id": "690550322",
                                    "speaker": "五郎",
                                    "text": "当天的情况是这样的…"
                                }
                            ]
                        },
                        {
                            "id": "690550318",
                            "text": "我不会觉得是「自吹自擂」哦。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905504",
            "initDialog": "690550401",
            "dialogues": [
                {
                    "id": "690550401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690550402",
                    "speaker": "五郎",
                    "text": "嗯！我听管家阿圆说，她能依照你的想法改变这里的地形。"
                },
                {
                    "id": "690550403",
                    "speaker": "五郎",
                    "text": "能不能请你搭建出高耸的山体呢？最好险峻一些，让攀登起来有足够的难度。"
                },
                {
                    "id": "690550404",
                    "speaker": "五郎",
                    "text": "然后，我们一起向顶峰发起挑战吧！"
                },
                {
                    "id": "690550405",
                    "speaker": "Player",
                    "text": "没问题。"
                },
                {
                    "id": "690550406",
                    "speaker": "五郎",
                    "text": "答应得好爽快！谢谢你！"
                },
                {
                    "id": "690550407",
                    "speaker": "五郎",
                    "text": "以前，我经常和反抗军的同伴们一起登山。大家边流汗，边谈笑，是我十分宝贵的回忆与财富。"
                },
                {
                    "id": "690550408",
                    "speaker": "五郎",
                    "text": "我总有一种「直觉」。和你一起登山，会比和其他任何人登山都开心。"
                },
                {
                    "id": "690550409",
                    "speaker": "五郎",
                    "text": "我也想要…和你分享每一个我觉得开心的时刻。",
                    "choices": [
                        {
                            "id": "690550410",
                            "text": "我明白了。",
                            "response": [
                                {
                                    "id": "690550412",
                                    "speaker": "五郎",
                                    "text": "嗯。对了…我们再选一段相对比较安全的山路，比试登山速度，如何！"
                                },
                                {
                                    "id": "690550413",
                                    "speaker": "五郎",
                                    "text": "输了的人就请对方吃大餐，吃甜点…",
                                    "choices": [
                                        {
                                            "id": "690550414",
                                            "text": "想要摸摸尾巴…",
                                            "response": [
                                                {
                                                    "id": "690550415",
                                                    "speaker": "五郎",
                                                    "text": "欸？好奇怪的心愿…"
                                                },
                                                {
                                                    "id": "690550416",
                                                    "speaker": "五郎",
                                                    "text": "但…没问题，我答应你！"
                                                },
                                                {
                                                    "id": "690550419",
                                                    "speaker": "五郎",
                                                    "text": "我…我…好吧，我知道了！"
                                                },
                                                {
                                                    "id": "690550420",
                                                    "speaker": "五郎",
                                                    "text": "为了尾巴…我会拿出全力的！但事先说好，要赢过我可不容易。"
                                                },
                                                {
                                                    "id": "690550421",
                                                    "speaker": "五郎",
                                                    "text": "我们就提前一点…开始热身吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690550417",
                                            "text": "想要枕着尾巴睡觉…",
                                            "response": [
                                                {
                                                    "id": "690550418",
                                                    "speaker": "五郎",
                                                    "text": "欸？！尾巴…睡觉…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690550411",
                            "text": "五郎，也谢谢你。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905505",
            "initDialog": "690550501",
            "dialogues": [
                {
                    "id": "690550501",
                    "speaker": "Player",
                    "text": "早啊，五郎。"
                },
                {
                    "id": "690550502",
                    "speaker": "五郎",
                    "text": "#早！{NICKNAME}。"
                },
                {
                    "id": "690550503",
                    "speaker": "五郎",
                    "text": "我已经完成今天的训练了哦。你要是打算现在出发，我就来陪你！"
                }
            ]
        },
        {
            "talkId": "6905506",
            "initDialog": "690550601",
            "dialogues": [
                {
                    "id": "690550601",
                    "speaker": "Player",
                    "text": "晚安，五郎。"
                },
                {
                    "id": "690550602",
                    "speaker": "五郎",
                    "text": "#{NICKNAME}，晚安。"
                },
                {
                    "id": "690550603",
                    "speaker": "五郎",
                    "text": "好好休息，把所有的烦恼都抛在脑后吧。"
                },
                {
                    "id": "690550604",
                    "speaker": "五郎",
                    "text": "「常胜将军」…会保护你的。"
                }
            ]
        },
        {
            "talkId": "6905507",
            "initDialog": "690550701",
            "dialogues": [
                {
                    "id": "690550701",
                    "speaker": "五郎",
                    "text": "乡野的村庄，承担着提供兵源、隐藏物资，辅助侦察等功能…也是反抗军开展行动的重要支点。"
                },
                {
                    "id": "690550702",
                    "speaker": "五郎",
                    "text": "这座村庄的布置相当正统，让人看不出破绽，说明你详尽地考察过稻妻的环境。"
                },
                {
                    "id": "690550703",
                    "speaker": "五郎",
                    "text": "你的才能，真让我钦佩啊！"
                }
            ]
        },
        {
            "talkId": "6905508",
            "initDialog": "690550801",
            "dialogues": [
                {
                    "id": "690550801",
                    "speaker": "五郎",
                    "text": "暖乎乎的温泉，真不错啊…"
                },
                {
                    "id": "690550802",
                    "speaker": "五郎",
                    "text": "只要在温泉里泡上半小时，训练和战斗时积累的疲劳就都会消散了。"
                },
                {
                    "id": "690550803",
                    "speaker": "五郎",
                    "text": "我现在能用这里的温泉吗？你也要一起来吗？"
                }
            ]
        }
    ]
}