{
    "groupId": "1512",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 8,
        "凯瑟琳": 27
    },
    "talks": [
        {
            "talkId": "7068801",
            "initDialog": "706880101",
            "dialogues": [
                {
                    "id": "706880101",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么厉害的委托吗？</color>"
                },
                {
                    "id": "706880102",
                    "speaker": "凯瑟琳",
                    "text": "您来的正巧，有一份协会共享给资深冒险家的手册要交给您。",
                    "choices": [
                        {
                            "id": "706880103",
                            "text": "是提瓦特美食大全吗？",
                            "response": [
                                {
                                    "id": "706880104",
                                    "speaker": "凯瑟琳",
                                    "text": "很遗憾，并不是。"
                                },
                                {
                                    "id": "706880107",
                                    "speaker": "凯瑟琳",
                                    "text": "如您所见，手册记录了值得挑战的强敌的信息。"
                                },
                                {
                                    "id": "706880108",
                                    "speaker": "凯瑟琳",
                                    "text": "若能合理利用，想必会为您的冒险旅途增加许多助益。之后如果需要查阅相关信息，也随时欢迎您来。"
                                },
                                {
                                    "id": "706880109",
                                    "speaker": "凯瑟琳",
                                    "text": "那么，就祝您旗开得胜。"
                                }
                            ]
                        },
                        {
                            "id": "706880105",
                            "text": "难道又是新的任务…",
                            "response": [
                                {
                                    "id": "706880106",
                                    "speaker": "凯瑟琳",
                                    "text": "挑战与否，选择权当然在您。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "2010136",
            "initDialog": "201013601",
            "dialogues": [
                {
                    "id": "201013601",
                    "speaker": "凯瑟琳",
                    "text": "领取「每日委托」奖励"
                },
                {
                    "id": "201013602",
                    "speaker": "凯瑟琳",
                    "text": "很抱歉，今天你完成的委托数量还不够呢。"
                }
            ]
        },
        {
            "talkId": "2010137",
            "initDialog": "201013701",
            "dialogues": [
                {
                    "id": "201013701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013702",
                    "speaker": "凯瑟琳",
                    "text": "感谢你完成了今天的委托，这是给你的奖励。"
                }
            ]
        },
        {
            "talkId": "2010138",
            "initDialog": "201013801",
            "dialogues": [
                {
                    "id": "201013801",
                    "speaker": "凯瑟琳",
                    "text": "<color=#999999FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013802",
                    "speaker": "凯瑟琳",
                    "text": "你已经领取过今天的奖励了，希望你明天也能继续承接协会的委托。"
                }
            ]
        },
        {
            "talkId": "2010139",
            "initDialog": "201013901",
            "dialogues": [
                {
                    "id": "201013901",
                    "speaker": "凯瑟琳",
                    "text": "领取「冒险等阶」奖励"
                }
            ]
        },
        {
            "talkId": "2010140",
            "initDialog": "201014001",
            "dialogues": [
                {
                    "id": "201014001",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>领取「冒险等阶」奖励</color>"
                }
            ]
        },
        {
            "talkId": "2010141",
            "initDialog": "201014101",
            "dialogues": [
                {
                    "id": "201014101",
                    "speaker": "凯瑟琳",
                    "text": "探索派遣"
                }
            ]
        },
        {
            "talkId": "2010142",
            "initDialog": "201014201",
            "dialogues": [
                {
                    "id": "201014201",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>探索派遣</color>"
                }
            ]
        },
        {
            "talkId": "6151201",
            "initDialog": "615120101",
            "dialogues": [
                {
                    "id": "615120101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！\\n欢迎来到冒险家协会。"
                }
            ]
        },
        {
            "talkId": "6151202",
            "initDialog": "615120201",
            "dialogues": [
                {
                    "id": "615120201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615120202",
                    "speaker": "凯瑟琳",
                    "text": "我吗？我是冒险家协会的接待员凯瑟琳。"
                },
                {
                    "id": "615120203",
                    "speaker": "凯瑟琳",
                    "text": "专门负责为蒙德的冒险家们提供任务发布和情报支援工作。"
                },
                {
                    "id": "615120204",
                    "speaker": "凯瑟琳",
                    "text": "顺带一提，冒险家协会的服务全年无休喔。"
                },
                {
                    "id": "615120205",
                    "speaker": "Player",
                    "text": "冒险家协会是做什么的？"
                },
                {
                    "id": "615120206",
                    "speaker": "凯瑟琳",
                    "text": "冒险家协会是为了七国各地的冒险家们所设立的支援组织。"
                },
                {
                    "id": "615120207",
                    "speaker": "凯瑟琳",
                    "text": "为了让新手冒险家们更好地适应冒险生活，老手冒险家们能够更自由地进行冒险…"
                },
                {
                    "id": "615120208",
                    "speaker": "凯瑟琳",
                    "text": "…协会负责整合起冒险家们口口相传的繁杂信息，将合适的冒险任务分配到冒险家的手中。"
                }
            ]
        },
        {
            "talkId": "6151203",
            "initDialog": "615120301",
            "dialogues": [
                {
                    "id": "615120301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615120302",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，冒险家。"
                }
            ]
        },
        {
            "talkId": "6151204",
            "initDialog": "615120401",
            "dialogues": [
                {
                    "id": "615120401",
                    "speaker": "凯瑟琳",
                    "text": "查看「豪斗旅纪」信息"
                }
            ]
        },
        {
            "talkId": "6151205",
            "initDialog": "615120501",
            "dialogues": [
                {
                    "id": "615120501",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>查看「豪斗旅纪」信息</color>"
                }
            ]
        },
        {
            "talkId": "6151206",
            "initDialog": "615120601",
            "dialogues": [
                {
                    "id": "615120601",
                    "speaker": "凯瑟琳",
                    "text": "欢迎来到冒险家协会，「木偶」大人。有什么我能为您做的吗？"
                }
            ]
        },
        {
            "talkId": "6151208",
            "initDialog": "615120801",
            "dialogues": [
                {
                    "id": "615120801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615120802",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，「木偶」大人。"
                }
            ]
        }
    ]
}