{
    "groupId": "3099",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "宏达": 7
    },
    "talks": [
        {
            "talkId": "6309901",
            "initDialog": "630990101",
            "dialogues": [
                {
                    "id": "630990101",
                    "speaker": "宏达",
                    "text": "阁下有什么事吗？如果是有事要拜见奉行大人或者大小姐的话，请找斑目先生吧。"
                }
            ]
        },
        {
            "talkId": "6309902",
            "initDialog": "630990201",
            "dialogues": [
                {
                    "id": "630990201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "630990202",
                    "speaker": "宏达",
                    "text": "在下宏达，是社奉行所的一员，奉命令保护大小姐和这座宅邸。"
                }
            ]
        },
        {
            "talkId": "6309903",
            "initDialog": "630990301",
            "dialogues": [
                {
                    "id": "630990301",
                    "speaker": "Player",
                    "text": "关于社奉行…"
                },
                {
                    "id": "630990302",
                    "speaker": "宏达",
                    "text": "哦？是有事要见奉行大人吗？"
                },
                {
                    "id": "630990303",
                    "speaker": "宏达",
                    "text": "他可是位大忙人啊，光是管理社奉行的诸多事宜就已让他分身乏术了，还要同另外两奉行斡旋…"
                },
                {
                    "id": "630990304",
                    "speaker": "宏达",
                    "text": "我和我的师父信盛大人都受过奉行大人不少照顾，所以我要尽我所能为他分忧。"
                },
                {
                    "id": "630990305",
                    "speaker": "宏达",
                    "text": "但我现在能做的就只有看家护院…所以我一定要保护好宅邸和大小姐，这样才对得起奉行大人的厚恩！"
                }
            ]
        },
        {
            "talkId": "6309904",
            "initDialog": "630990401",
            "dialogues": [
                {
                    "id": "630990401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630990402",
                    "speaker": "宏达",
                    "text": "嗯，阁下保重。"
                }
            ]
        }
    ]
}