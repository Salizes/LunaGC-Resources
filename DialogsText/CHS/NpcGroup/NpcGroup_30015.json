    "talks": [
        {
            "talkId": "4111501",
            "initDialog": "411150101",
            "dialogues": [
                {
                    "id": "411150101",
                    "speaker": "莫娜",
                    "text": "是你啊，是想和我聊聊关于那个的事情吗？"
                }
            ]
        },
        {
            "talkId": "4111502",
            "initDialog": "411150201",
            "dialogues": [
                {
                    "id": "411150201",
                    "speaker": "Player",
                    "text": "占卜位置"
                },
                {
                    "id": "411150202",
                    "speaker": "莫娜",
                    "text": "哼哼…连接大地与星天的智慧已经揭示了未来。这些地方将会有坠落的天星。正如毕加特里斯奥秘的预言。"
                }
            ]
        },
        {
            "talkId": "4111503",
            "initDialog": "411150301",
            "dialogues": [
                {
                    "id": "411150301",
                    "speaker": "Player",
                    "text": "查看结果"
                },
                {
                    "id": "411150302",
                    "speaker": "莫娜",
                    "text": "虽然只是占卜结果，不过应该和事实没有出入。"
                }
            ]
        },
        {
            "talkId": "4111504",
            "initDialog": "411150401",
            "dialogues": [
                {
                    "id": "411150401",
                    "speaker": "Player",
                    "text": "我们需要做什么来着？"
                },
                {
                    "id": "411150402",
                    "speaker": "莫娜",
                    "text": "我还在持续占察事件的走向，在这之后还会发生更大的事情。"
                },
                {
                    "id": "411150403",
                    "speaker": "莫娜",
                    "text": "你负责去查看验证目前的推演结果。你越努力，一切就能越快地尘埃落定。"
                },
                {
                    "id": "411150404",
                    "speaker": "Player",
                    "text": "问些别的…"
                },
                {
                    "id": "411150405",
                    "speaker": "莫娜",
                    "text": "有什么别的想知道的？"
                }
            ]
        },
        {
            "talkId": "4111505",
            "initDialog": "411150501",
            "dialogues": [
                {
                    "id": "411150501",
                    "speaker": "Player",
                    "text": "再见"
                },
                {
                    "id": "411150502",
                    "speaker": "莫娜",
                    "text": "虽说命运是既定之事，不过…祝你好运。"
                }
            ]
        }
    ]
}