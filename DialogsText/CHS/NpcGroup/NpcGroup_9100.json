{
    "groupId": "9100",
    "total_dialogue_lines": 80,
    "speaker_counts": {
        "Player": 21,
        "卡齐娜": 59
    },
    "talks": [
        {
            "talkId": "6910001",
            "initDialog": "691000101",
            "dialogues": [
                {
                    "id": "691000101",
                    "speaker": "卡齐娜",
                    "text": "你的脚步声刚才就传到我的耳朵里了，嘿嘿。"
                },
                {
                    "id": "691000102",
                    "speaker": "卡齐娜",
                    "text": "然后我就站在这里等你啦。"
                }
            ]
        },
        {
            "talkId": "6910002",
            "initDialog": "691000201",
            "dialogues": [
                {
                    "id": "691000201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691000202",
                    "speaker": "卡齐娜",
                    "text": "当然…当然，不用担心我的，我能照顾好我自己。",
                    "choices": [
                        {
                            "id": "691000203",
                            "text": "不会是在逞强吧？",
                            "response": [
                                {
                                    "id": "691000204",
                                    "speaker": "卡齐娜",
                                    "text": "欸？没有吧…！"
                                },
                                {
                                    "id": "691000205",
                                    "speaker": "卡齐娜",
                                    "text": "你是从哪里看出来的？耳朵？还是…我的表情，或者肢体动作？"
                                },
                                {
                                    "id": "691000206",
                                    "speaker": "Player",
                                    "text": "都有点僵硬哦…"
                                },
                                {
                                    "id": "691000207",
                                    "speaker": "卡齐娜",
                                    "text": "对不起！可能是突然来到一个全新的环境，身体还不太适应。"
                                },
                                {
                                    "id": "691000208",
                                    "speaker": "卡齐娜",
                                    "text": "谢谢你的关心，但我没事的…是真的。"
                                },
                                {
                                    "id": "691000209",
                                    "speaker": "卡齐娜",
                                    "text": "这里天气一直很好，氛围也很平和安宁。我很喜欢！"
                                },
                                {
                                    "id": "691000219",
                                    "speaker": "卡齐娜",
                                    "text": "为了尽快适应，也为了让你不用再担心我…"
                                },
                                {
                                    "id": "691000220",
                                    "speaker": "卡齐娜",
                                    "text": "可以让我多在这里待一会儿吗？我会安安静静的。"
                                }
                            ]
                        },
                        {
                            "id": "691000210",
                            "text": "可以更放松一点。",
                            "response": [
                                {
                                    "id": "691000211",
                                    "speaker": "卡齐娜",
                                    "text": "嗯——谢谢你邀请我到这里来玩…我会努力让自己更加放松的！"
                                },
                                {
                                    "id": "691000212",
                                    "speaker": "Player",
                                    "text": "或许…放松是不用努力的。"
                                },
                                {
                                    "id": "691000213",
                                    "speaker": "卡齐娜",
                                    "text": "对、对哦！"
                                },
                                {
                                    "id": "691000214",
                                    "speaker": "卡齐娜",
                                    "text": "你的家很好…你的邀请更是让我开心得不知道怎么办才好…"
                                },
                                {
                                    "id": "691000215",
                                    "speaker": "卡齐娜",
                                    "text": "只、只是，可能我还需要一点时间来适应新环境。"
                                },
                                {
                                    "id": "691000216",
                                    "speaker": "卡齐娜",
                                    "text": "我…我不怎么出远门，这里又全都是我从没见过的事物…！光是一件件看过来就快让我忘记呼吸了。"
                                },
                                {
                                    "id": "691000217",
                                    "speaker": "Player",
                                    "text": "没事的，你可以在这里做任何事情。"
                                },
                                {
                                    "id": "691000218",
                                    "speaker": "卡齐娜",
                                    "text": "谢谢你，呜…你对我真好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910003",
            "initDialog": "691000301",
            "dialogues": [
                {
                    "id": "691000301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691000302",
                    "speaker": "卡齐娜",
                    "text": "当然可以，不过我可能不像玛拉妮那么擅长找各类话题…这样没关系吗？"
                },
                {
                    "id": "691000303",
                    "speaker": "卡齐娜",
                    "text": "但…嗯…就是，无论你想说什么，我都会好好听着的！"
                },
                {
                    "id": "691000304",
                    "speaker": "Player",
                    "text": "卡齐娜是不是很容易紧张？"
                },
                {
                    "id": "691000305",
                    "speaker": "卡齐娜",
                    "text": "唔…被你发现了。"
                },
                {
                    "id": "691000306",
                    "speaker": "卡齐娜",
                    "text": "因为之前失败过很多次，我一直很担心接下来是不是又会搞砸什么事情…"
                },
                {
                    "id": "691000307",
                    "speaker": "卡齐娜",
                    "text": "我很希望自己能把每一件事情都做好，不…不说是像英雄那样了，至少也得对得起大家的期待吧…"
                },
                {
                    "id": "691000308",
                    "speaker": "卡齐娜",
                    "text": "啊！对了，你有那么多传奇经历…"
                },
                {
                    "id": "691000309",
                    "speaker": "卡齐娜",
                    "text": "面对新的环境、新的对手，你会紧张吗？",
                    "choices": [
                        {
                            "id": "691000310",
                            "text": "当然会，紧张是很常见的情绪。",
                            "response": [
                                {
                                    "id": "691000311",
                                    "speaker": "卡齐娜",
                                    "text": "欸？即使是你也会吗？我还以为是因为我太弱小的原因…"
                                },
                                {
                                    "id": "691000312",
                                    "speaker": "卡齐娜",
                                    "text": "听你这么说，感觉突然就松了一口气。原来过去是我太自己吓自己了？"
                                },
                                {
                                    "id": "691000313",
                                    "speaker": "卡齐娜",
                                    "text": "啊，还是说…我不该这么想的。你说的「紧张」说不定与我身上的紧张不同，而是成为了「强者的谦逊」？"
                                },
                                {
                                    "id": "691000314",
                                    "speaker": "Player",
                                    "text": "没那么夸张，有时顺其自然就好。"
                                },
                                {
                                    "id": "691000315",
                                    "speaker": "卡齐娜",
                                    "text": "顺其自然…嘿嘿，这个词从你嘴中说出来的时候，好像也变得简单了不少。"
                                },
                                {
                                    "id": "691000316",
                                    "speaker": "卡齐娜",
                                    "text": "对我来说，感到紧张才是自然的常态呢。"
                                },
                                {
                                    "id": "691000317",
                                    "speaker": "卡齐娜",
                                    "text": "不过…我隐约能够明白你的意思。或许，有一天我也能像你这样，和自己的紧张和平共处呢。"
                                },
                                {
                                    "id": "691000324",
                                    "speaker": "卡齐娜",
                                    "text": "哎呀，说是聊天，结果又是我从你身上学到了许多…有点不好意思…"
                                },
                                {
                                    "id": "691000325",
                                    "speaker": "卡齐娜",
                                    "text": "如果有什么是我能为你做的，一定要告诉我哦！"
                                }
                            ]
                        },
                        {
                            "id": "691000318",
                            "text": "不会，我已经习惯了。",
                            "response": [
                                {
                                    "id": "691000319",
                                    "speaker": "卡齐娜",
                                    "text": "果然呢，传奇英雄不管面对什么，都能克制好自己的情绪，按理性而富有智慧的方式行动下去。"
                                },
                                {
                                    "id": "691000320",
                                    "speaker": "卡齐娜",
                                    "text": "看来我还需要多多习惯，像跳舞那样加以日积月累的练习！"
                                },
                                {
                                    "id": "691000321",
                                    "speaker": "Player",
                                    "text": "可以按自己的「节奏」来。"
                                },
                                {
                                    "id": "691000322",
                                    "speaker": "卡齐娜",
                                    "text": "嗯！只要能再多经历一些冒险…还有…成功的经验，我应该就不会那么容易紧张了。"
                                },
                                {
                                    "id": "691000323",
                                    "speaker": "卡齐娜",
                                    "text": "你还能带上我吗？或者…在闲暇的时候与我分享更多心得…我一定会尽我所能学习并回报你的！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910004",
            "initDialog": "691000401",
            "dialogues": [
                {
                    "id": "691000401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691000402",
                    "speaker": "卡齐娜",
                    "text": "我想想哦，嗯…暂时没想到什么特别值得一提的心愿。"
                },
                {
                    "id": "691000403",
                    "speaker": "卡齐娜",
                    "text": "现在的生活让我很满足，简直称得上是「幸福」了。"
                },
                {
                    "id": "691000404",
                    "speaker": "Player",
                    "text": "这回不是逞强？"
                },
                {
                    "id": "691000405",
                    "speaker": "卡齐娜",
                    "text": "嘿嘿，当然不是。我们已经是要好的朋友啦，我知道我骗不过你。"
                },
                {
                    "id": "691000406",
                    "speaker": "卡齐娜",
                    "text": "主要是因为我很喜欢这里。在适应你家的环境之后，我发现它梦幻得像是存在于故事中的世界。"
                },
                {
                    "id": "691000407",
                    "speaker": "卡齐娜",
                    "text": "美丽的风景就不说了，室外还有宽敞到可以乘着冲天转转四处闲逛的超大空间！"
                },
                {
                    "id": "691000408",
                    "speaker": "卡齐娜",
                    "text": "生活节奏舒适安逸，怎么都待不够。"
                },
                {
                    "id": "691000409",
                    "speaker": "Player",
                    "text": "卡齐娜喜欢就好。"
                },
                {
                    "id": "691000410",
                    "speaker": "卡齐娜",
                    "text": "嗯，请收下我双倍认真的感谢，很高兴能收到你的邀请…家人告诉过我，感激的话说多少次都不嫌多的。"
                },
                {
                    "id": "691000411",
                    "speaker": "卡齐娜",
                    "text": "对了，你要不要来我家做客？"
                },
                {
                    "id": "691000412",
                    "speaker": "卡齐娜",
                    "text": "…啊！"
                },
                {
                    "id": "691000413",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "691000414",
                    "speaker": "卡齐娜",
                    "text": "没…没什么，刚刚突然想起来房间里面堆了好多好多东西。但在你来之前，我一定会把它们收好的。"
                },
                {
                    "id": "691000415",
                    "speaker": "卡齐娜",
                    "text": "床底下的箱子还有几个…最上层的柜子也空着…嗯，应该够放。",
                    "choices": [
                        {
                            "id": "691000416",
                            "text": "不费心收拾也没关系。",
                            "response": [
                                {
                                    "id": "691000418",
                                    "speaker": "卡齐娜",
                                    "text": "呜…谢谢你能这么说！我…我心里好像一下子鼓满了勇气。"
                                },
                                {
                                    "id": "691000419",
                                    "speaker": "Player",
                                    "text": "放心吧。"
                                },
                                {
                                    "id": "691000420",
                                    "speaker": "卡齐娜",
                                    "text": "嘿嘿，那就说好了哦？我会细心安放好每块石头的位置，等你来的！"
                                },
                                {
                                    "id": "691000421",
                                    "speaker": "卡齐娜",
                                    "text": "我保证！就算拥挤，也会是最好看的拥挤。"
                                }
                            ]
                        },
                        {
                            "id": "691000417",
                            "text": "拥挤感也是一种特色。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910005",
            "initDialog": "691000501",
            "dialogues": [
                {
                    "id": "691000501",
                    "speaker": "Player",
                    "text": "早啊，卡齐娜。"
                },
                {
                    "id": "691000502",
                    "speaker": "卡齐娜",
                    "text": "#早上好，{NICKNAME}，准备出发去冒险了吗？"
                },
                {
                    "id": "691000503",
                    "speaker": "卡齐娜",
                    "text": "今天也可以带上我吗？我还有很多想向你学习的地方呢！"
                }
            ]
        },
        {
            "talkId": "6910006",
            "initDialog": "691000601",
            "dialogues": [
                {
                    "id": "691000601",
                    "speaker": "Player",
                    "text": "晚安，卡齐娜。"
                },
                {
                    "id": "691000602",
                    "speaker": "卡齐娜",
                    "text": "#晚安，{NICKNAME}。我打算再整理一下今天发生的事情就去睡觉。"
                },
                {
                    "id": "691000603",
                    "speaker": "卡齐娜",
                    "text": "别…别盯着我看呀，这次不会再偷偷躲起来哭的，我保证。"
                }
            ]
        },
        {
            "talkId": "6910010",
            "initDialog": "691001001",
            "dialogues": [
                {
                    "id": "691001001",
                    "speaker": "卡齐娜",
                    "text": "哇啊！你搭建的这个大舞台也太完美了…"
                },
                {
                    "id": "691001002",
                    "speaker": "卡齐娜",
                    "text": "唔…呃…我、我跳舞跳得还可以，所以能让我在这里试着跳一下吗？"
                },
                {
                    "id": "691001003",
                    "speaker": "卡齐娜",
                    "text": "真、真的吗？你愿意当我的观众？太好了！我不会让你失望的…应该不会的吧…"
                }
            ]
        },
        {
            "talkId": "6910011",
            "initDialog": "691001101",
            "dialogues": [
                {
                    "id": "691001101",
                    "speaker": "卡齐娜",
                    "text": "我刚刚发现这里所有家具都放得非常整齐。"
                },
                {
                    "id": "691001102",
                    "speaker": "卡齐娜",
                    "text": "你一定花了很多功夫吧？会不会很累？下次可以喊上我来帮忙哦。"
                },
                {
                    "id": "691001103",
                    "speaker": "卡齐娜",
                    "text": "其他事情我不敢打包票，但在收纳和整理方面，我还算有点心得，不会帮倒忙的！"
                }
            ]
        }
    ]
}