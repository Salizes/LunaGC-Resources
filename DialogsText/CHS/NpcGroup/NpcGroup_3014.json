{
    "groupId": "3014",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "信盛": 12
    },
    "talks": [
        {
            "talkId": "6301401",
            "initDialog": "630140101",
            "dialogues": [
                {
                    "id": "630140101",
                    "speaker": "信盛",
                    "text": "悠闲自在，又是平静的一天啊。"
                }
            ]
        },
        {
            "talkId": "6301402",
            "initDialog": "630140201",
            "dialogues": [
                {
                    "id": "630140201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630140202",
                    "speaker": "信盛",
                    "text": "你好，欢迎光临「木漏茶室」。我是神里家的门客，在这里工作。"
                },
                {
                    "id": "630140203",
                    "speaker": "信盛",
                    "text": "虽说如此，但这里整日清闲，我除了喝茶也没什么事情可做…比拥有神之眼的时候轻松多啦，甚好甚好。"
                }
            ]
        },
        {
            "talkId": "6301403",
            "initDialog": "630140301",
            "dialogues": [
                {
                    "id": "630140301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630140302",
                    "speaker": "信盛",
                    "text": "再见，慢走啊。"
                }
            ]
        },
        {
            "talkId": "6301404",
            "initDialog": "630140401",
            "dialogues": [
                {
                    "id": "630140401",
                    "speaker": "Player",
                    "text": "你的神之眼…？"
                },
                {
                    "id": "630140402",
                    "speaker": "信盛",
                    "text": "啊，别误会，虽然失去了神之眼，但我并不是眼狩令的受害者。我的神之眼是在公平竞技里输掉的。"
                },
                {
                    "id": "630140403",
                    "speaker": "信盛",
                    "text": "以前我做长枪教头的时候，曾提出与神里绫人大人进行长枪对决。当时的我得益于喜多院流长枪之术的奥传，自以为天下无敌。"
                },
                {
                    "id": "630140404",
                    "speaker": "信盛",
                    "text": "但结果可想而知，凭我那点功夫，怎么可能赢得过神里绫人大人呢？落败之后，我便上交了神之眼。"
                },
                {
                    "id": "630140405",
                    "speaker": "信盛",
                    "text": "奇怪的是，没了神之眼的我反而觉得肩上的担子一下轻了，以前的那些执念也都不见了。我也就不再踏入神里家的府邸，做起了「门外客」。"
                },
                {
                    "id": "630140406",
                    "speaker": "信盛",
                    "text": "神里绫人大人不仅剑术一流，枪术也十分了得，在下能做个普通门客继续为他效命，实属荣幸。"
                },
                {
                    "id": "630140407",
                    "speaker": "信盛",
                    "text": "更何况，现在平静的生活来之不易，我也终于不必再为了一颗发光的小球继续奔波啦。"
                }
            ]
        },
        {
            "talkId": "7293201",
            "initDialog": "729320101",
            "dialogues": [
                {
                    "id": "729320101",
                    "speaker": "Player",
                    "text": "能和神里绫人比试…"
                },
                {
                    "id": "729320102",
                    "speaker": "信盛",
                    "text": "唉，是我年轻气盛不懂事…还是忘了这事吧。"
                },
                {
                    "id": "729320103",
                    "speaker": "信盛",
                    "text": "现在我的工作大概用不上舞枪弄剑了，这些枪术经验也就没什么用了。你若不嫌弃的话，就收下吧。"
                }
            ]
        }
    ]
}