{
    "groupId": "7470",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 5,
        "维多梅克": 9
    },
    "talks": [
        {
            "talkId": "6747001",
            "initDialog": "674700101",
            "dialogues": [
                {
                    "id": "674700101",
                    "speaker": "维多梅克",
                    "text": "还真是本不错的书啊…可惜了…"
                }
            ]
        },
        {
            "talkId": "6747002",
            "initDialog": "674700201",
            "dialogues": [
                {
                    "id": "674700201",
                    "speaker": "Player",
                    "text": "可惜什么？"
                },
                {
                    "id": "674700202",
                    "speaker": "维多梅克",
                    "text": "这本书好则好已，一读进去就令人沉醉其中，若是我在家也就算了，可惜此处是火车站…"
                },
                {
                    "id": "674700203",
                    "speaker": "维多梅克",
                    "text": "为了读完这个章节，我已经错过了两列我应该搭乘的列车了。"
                }
            ]
        },
        {
            "talkId": "6747003",
            "initDialog": "674700301",
            "dialogues": [
                {
                    "id": "674700301",
                    "speaker": "Player",
                    "text": "不打扰你看书了。"
                },
                {
                    "id": "674700302",
                    "speaker": "维多梅克",
                    "text": "没事没事…嗯我看看，之前看到哪里来着…"
                }
            ]
        },
        {
            "talkId": "6747004",
            "initDialog": "674700401",
            "dialogues": [
                {
                    "id": "674700401",
                    "speaker": "Player",
                    "text": "还是先别看书了吧！"
                },
                {
                    "id": "674700402",
                    "speaker": "维多梅克",
                    "text": "唉，您说的确实是正理，可是好看的书就在手头，不看实在是教人为难。"
                },
                {
                    "id": "674700403",
                    "speaker": "维多梅克",
                    "text": "这样，我再看一章，再看一章就安心等车。"
                }
            ]
        },
        {
            "talkId": "6747005",
            "initDialog": "674700501",
            "dialogues": [
                {
                    "id": "674700501",
                    "speaker": "Player",
                    "text": "什么书这么好看？"
                },
                {
                    "id": "674700502",
                    "speaker": "维多梅克",
                    "text": "这是一本讲述古老精灵后裔与卢契烬初代帮主恩怨情仇的悬疑小说。"
                },
                {
                    "id": "674700503",
                    "speaker": "维多梅克",
                    "text": "情节酣畅，描写生动，令人不忍释卷啊。"
                }
            ]
        },
        {
            "talkId": "6747006",
            "initDialog": "674700601",
            "dialogues": [
                {
                    "id": "674700601",
                    "speaker": "Player",
                    "text": "不如看看爱情诗集…"
                },
                {
                    "id": "674700602",
                    "speaker": "维多梅克",
                    "text": "哎，爱情诗集有什么好看的，不看不看。"
                }
            ]
        }
    ]
}