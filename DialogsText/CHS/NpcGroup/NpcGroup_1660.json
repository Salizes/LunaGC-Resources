    "talks": [
        {
            "talkId": "6166001",
            "initDialog": "616600101",
            "dialogues": [
                {
                    "id": "616600101",
                    "speaker": "萨基",
                    "text": "你好！"
                }
            ]
        },
        {
            "talkId": "6166002",
            "initDialog": "616600201",
            "dialogues": [
                {
                    "id": "616600201",
                    "speaker": "Player",
                    "text": "你好呀，小朋友。"
                },
                {
                    "id": "616600202",
                    "speaker": "萨基",
                    "text": "嗯！你听说过「蒲公英海」吗？"
                }
            ]
        },
        {
            "talkId": "6166003",
            "initDialog": "616600301",
            "dialogues": [
                {
                    "id": "616600301",
                    "speaker": "Player",
                    "text": "蒲公英海？"
                },
                {
                    "id": "616600302",
                    "speaker": "萨基",
                    "text": "嗯！我看的故事书里说，在蒙德的某处，有一片很大~很大的蒲公英海!"
                },
                {
                    "id": "616600303",
                    "speaker": "萨基",
                    "text": "里面还有会说话的小狐狸喔！"
                }
            ]
        },
        {
            "talkId": "6166004",
            "initDialog": "616600401",
            "dialogues": [
                {
                    "id": "616600401",
                    "speaker": "Player",
                    "text": "再见啦，小朋友。"
                },
                {
                    "id": "616600402",
                    "speaker": "萨基",
                    "text": "再见啦~！"
                },
                {
                    "id": "616600403",
                    "speaker": "萨基",
                    "text": "如果看到「蒲公英海」的话，要回来告诉我喔~！"
                }
            ]
        },
        {
            "talkId": "6166005",
            "initDialog": "616600501",
            "dialogues": [
                {
                    "id": "616600501",
                    "speaker": "Player",
                    "text": "会说话的小狐狸？"
                },
                {
                    "id": "616600502",
                    "speaker": "萨基",
                    "text": "是啊！我好想知道跟小动物说话是什么感觉喔！"
                },
                {
                    "id": "616600503",
                    "speaker": "萨基",
                    "text": "唔…我只见过一个绿衣服白袜子的哥哥跟动物说过话，碰巧看到的。"
                },
                {
                    "id": "616600504",
                    "speaker": "萨基",
                    "text": "我跟妈妈说那个哥哥好厉害，但是哥哥却说是我听错了…"
                }
            ]
        }
    ]
}