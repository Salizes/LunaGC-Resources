{
    "groupId": "1531",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 7,
        "派蒙": 1,
        "爱德琳": 19
    },
    "talks": [
        {
            "talkId": "7051609",
            "initDialog": "705160901",
            "dialogues": [
                {
                    "id": "705160901",
                    "speaker": "爱德琳",
                    "text": "你们回来了。"
                },
                {
                    "id": "705160902",
                    "speaker": "爱德琳",
                    "text": "鹰翔海滩那边的情况怎么样？"
                },
                {
                    "id": "705160903",
                    "speaker": "派蒙",
                    "text": "唔，感觉一下子解释不清楚呢。",
                    "choices": [
                        {
                            "id": "705160904",
                            "text": "我们也没法下定论。",
                            "response": [
                                {
                                    "id": "705160906",
                                    "speaker": "爱德琳",
                                    "text": "也对，我不太熟悉战斗相关的事，就不麻烦两位多说了。"
                                },
                                {
                                    "id": "705160907",
                                    "speaker": "爱德琳",
                                    "text": "如果你们有什么需要的，请直接告诉我，我会尽力安排。"
                                },
                                {
                                    "id": "705160908",
                                    "speaker": "爱德琳",
                                    "text": "我会一直在这里等候。"
                                }
                            ]
                        },
                        {
                            "id": "705160905",
                            "text": "还需要观察一段时间。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7091801",
            "initDialog": "709180101",
            "dialogues": [
                {
                    "id": "709180101",
                    "speaker": "Player",
                    "text": "真的是这样吗…"
                },
                {
                    "id": "709180102",
                    "speaker": "爱德琳",
                    "text": "您多虑了，那些真的是无稽之谈，呵呵呵…"
                },
                {
                    "id": "709180103",
                    "speaker": "爱德琳",
                    "text": "…对了，您最近胃口如何呢？"
                },
                {
                    "id": "709180104",
                    "speaker": "爱德琳",
                    "text": "我今天做肉排时多做了一些，如果不嫌弃的话就请收下吧。"
                },
                {
                    "id": "709180105",
                    "speaker": "爱德琳",
                    "text": "请您不要想太多，这些都是用普通的兽肉做成的，绝对没有任何问题，呵呵呵…"
                }
            ]
        },
        {
            "talkId": "6153101",
            "initDialog": "615310101",
            "dialogues": [
                {
                    "id": "615310101",
                    "speaker": "爱德琳",
                    "text": "贵安，欢迎来到晨曦酒庄。"
                }
            ]
        },
        {
            "talkId": "6153102",
            "initDialog": "615310201",
            "dialogues": [
                {
                    "id": "615310201",
                    "speaker": "Player",
                    "text": "凯亚少爷？"
                },
                {
                    "id": "615310202",
                    "speaker": "爱德琳",
                    "text": "你认识凯亚少爷？他最近过得还不错吧。"
                },
                {
                    "id": "615310203",
                    "speaker": "爱德琳",
                    "text": "嗯，是说这个称呼吗？都是过去的事了……"
                },
                {
                    "id": "615310204",
                    "speaker": "爱德琳",
                    "text": "抱歉，我失言了……请无须在意。"
                }
            ]
        },
        {
            "talkId": "6153103",
            "initDialog": "615310301",
            "dialogues": [
                {
                    "id": "615310301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615310302",
                    "speaker": "爱德琳",
                    "text": "我是这里的女仆长。在酒庄内若是需要帮助，随时可以来找我。"
                },
                {
                    "id": "615310303",
                    "speaker": "爱德琳",
                    "text": "工作吗？不过是些内务，平时只要打扫宅邸，清理杂务，已经很轻松了。"
                },
                {
                    "id": "615310304",
                    "speaker": "Player",
                    "text": "关于传闻…"
                },
                {
                    "id": "615310305",
                    "speaker": "爱德琳",
                    "text": "是摩可和海莉那里听来的吗？唉……她们是不是又给客人说了奇怪的话。"
                },
                {
                    "id": "615310306",
                    "speaker": "爱德琳",
                    "text": "不必放在心上，她们说什么都不要在意，不要深思，也不要细想。"
                },
                {
                    "id": "615310307",
                    "speaker": "爱德琳",
                    "text": "怎么会有这样那样的事嘛，呵呵呵…"
                }
            ]
        },
        {
            "talkId": "6153104",
            "initDialog": "615310401",
            "dialogues": [
                {
                    "id": "615310401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615310402",
                    "speaker": "爱德琳",
                    "text": "再见，愿晨曦能为您带来片刻休憩。"
                }
            ]
        }
    ]
}