            "dialogues": [
                {
                    "id": "617700101",
                    "speaker": "马萨欧斯",
                    "text": "至冬的火水！质量上佳的新货！"
                }
            ]
        },
        {
            "talkId": "6177002",
            "initDialog": "617700201",
            "dialogues": [
                {
                    "id": "617700201",
                    "speaker": "Player",
                    "text": "火水？"
                },
                {
                    "id": "617700202",
                    "speaker": "马萨欧斯",
                    "text": "嘿嘿，我刚刚从至冬做完生意回来，进了很多质量上佳的至冬火水呢！"
                },
                {
                    "id": "617700203",
                    "speaker": "马萨欧斯",
                    "text": "这批火水味道辛辣、有力量感，又有丝丝微妙的柑橘、蜂蜜香气…"
                },
                {
                    "id": "617700204",
                    "speaker": "马萨欧斯",
                    "text": "哪怕自己不喝，也可以买下来送给朋友嘛！都是新基捷城妖精酿的名酒，怎么样，要不要来一点？"
                }
            ]
        },
        {
            "talkId": "6177003",
            "initDialog": "617700301",
            "dialogues": [
                {
                    "id": "617700301",
                    "speaker": "Player",
                    "text": "还是改日吧。"
                },
                {
                    "id": "617700302",
                    "speaker": "马萨欧斯",
                    "text": "哈哈，那欢迎改日再来！"
                }
            ]
        }
    ]
}