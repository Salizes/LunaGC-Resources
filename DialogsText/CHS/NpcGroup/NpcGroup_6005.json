{
    "groupId": "6005",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "曼萨": 11
    },
    "talks": [
        {
            "talkId": "6600501",
            "initDialog": "660050101",
            "dialogues": [
                {
                    "id": "660050101",
                    "speaker": "曼萨",
                    "text": "你好，冒险家协会纳塔分会欢迎你。"
                }
            ]
        },
        {
            "talkId": "6600502",
            "initDialog": "660050201",
            "dialogues": [
                {
                    "id": "660050201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "660050202",
                    "speaker": "曼萨",
                    "text": "很高兴认识你，我是这里的分会长。"
                },
                {
                    "id": "660050203",
                    "speaker": "曼萨",
                    "text": "如果你是刚来纳塔的冒险家，我推荐带一位当地的向导，或者跟着经验丰富的前辈出发比较好哦。"
                }
            ]
        },
        {
            "talkId": "6600503",
            "initDialog": "660050301",
            "dialogues": [
                {
                    "id": "660050301",
                    "speaker": "Player",
                    "text": "谢谢，再见。"
                },
                {
                    "id": "660050302",
                    "speaker": "曼萨",
                    "text": "祝你好运。"
                }
            ]
        },
        {
            "talkId": "6600504",
            "initDialog": "660050401",
            "dialogues": [
                {
                    "id": "660050401",
                    "speaker": "Player",
                    "text": "可以找你吗？"
                },
                {
                    "id": "660050402",
                    "speaker": "曼萨",
                    "text": "理论上来讲当然可以，但大部分时候我需要在这里帮助前来咨询的冒险家们。"
                },
                {
                    "id": "660050403",
                    "speaker": "曼萨",
                    "text": "凯瑟琳小姐当然非常可靠，但纳塔本地的事情还是我们自己更清楚。"
                },
                {
                    "id": "660050404",
                    "speaker": "曼萨",
                    "text": "而且，从能力上来看，悬木人或者流泉之众的朋友都比我更适合当导游啦。"
                },
                {
                    "id": "660050405",
                    "speaker": "曼萨",
                    "text": "我嘛…如果需要的话，倒是可以在你出发之前为你算算运势。"
                }
            ]
        },
        {
            "talkId": "6600505",
            "initDialog": "660050501",
            "dialogues": [
                {
                    "id": "660050501",
                    "speaker": "Player",
                    "text": "有什么委托吗？"
                },
                {
                    "id": "660050502",
                    "speaker": "曼萨",
                    "text": "需要帮忙的人总是有的，战后就更多了。"
                },
                {
                    "id": "660050503",
                    "speaker": "曼萨",
                    "text": "不过在凯瑟琳小姐和各位冒险家们的合作安排下，待办事项已经变少了很多。"
                },
                {
                    "id": "660050504",
                    "speaker": "曼萨",
                    "text": "听说甚至还有愚人众士兵帮忙完成了一些，以前可是很少见的，真是怪事。"
                }
            ]
        }
    ]
}