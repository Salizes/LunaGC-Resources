    "talks": [
        {
            "talkId": "6754501",
            "initDialog": "675450101",
            "dialogues": [
                {
                    "id": "675450101",
                    "speaker": "刻莱诺",
                    "text": "哼…还是一如既往地吵闹…"
                }
            ]
        },
        {
            "talkId": "6754502",
            "initDialog": "675450201",
            "dialogues": [
                {
                    "id": "675450201",
                    "speaker": "Player",
                    "text": "刻莱诺？你在做什么？"
                },
                {
                    "id": "675450202",
                    "speaker": "刻莱诺",
                    "text": "#…是你啊，{NICKNAME}。"
                },
                {
                    "id": "675450203",
                    "speaker": "刻莱诺",
                    "text": "不过是被父母使唤，把他们疼爱的人类女儿带回乡下，接受定期治疗而已。"
                },
                {
                    "id": "675450204",
                    "speaker": "刻莱诺",
                    "text": "启程的日子还没到，所以我打算再顺路去极星区买点东西。"
                },
                {
                    "id": "675450205",
                    "speaker": "刻莱诺",
                    "text": "莉奈娅来至冬堡的机会不多。给她和她的霜精带几件纪念品，也是理所应当的事情。"
                },
                {
                    "id": "675450206",
                    "speaker": "刻莱诺",
                    "text": "…话说回来，皇都还真是吵得让人静不下心。她不常来是对的。"
                }
            ]
        },
        {
            "talkId": "6754503",
            "initDialog": "675450301",
            "dialogues": [
                {
                    "id": "675450301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675450302",
                    "speaker": "刻莱诺",
                    "text": "#嗯，再见，{NICKNAME}。"
                }
            ]
        }
    ]
}