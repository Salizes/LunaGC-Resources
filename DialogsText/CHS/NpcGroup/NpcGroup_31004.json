{
    "groupId": "31004",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "特雷斯": 16
    },
    "talks": [
        {
            "talkId": "7055803",
            "initDialog": "705580301",
            "dialogues": [
                {
                    "id": "705580301",
                    "speaker": "特雷斯",
                    "text": "您好，荣誉骑士，现在就开始「测绘寻物」吗？",
                    "choices": [
                        {
                            "id": "705580302",
                            "text": "没错，正想来试试呢。",
                            "response": [
                                {
                                    "id": "705580303",
                                    "speaker": "特雷斯",
                                    "text": "好，那边已经准备好了…如果有什么问题，请务必和我说。"
                                }
                            ]
                        },
                        {
                            "id": "705580304",
                            "text": "不，只是想来闲聊一下。",
                            "response": [
                                {
                                    "id": "705580305",
                                    "speaker": "特雷斯",
                                    "text": "哦哦…好…嗯？现在是应该由我来找一个话题吗…咳咳，那还是先聊聊我自己吧。"
                                },
                                {
                                    "id": "705580306",
                                    "speaker": "特雷斯",
                                    "text": "我隶属于远程小队，常被分配到洛恩副队长手下干活，负责在主队前方及前侧翼率先接触敌情…"
                                },
                                {
                                    "id": "705580307",
                                    "speaker": "特雷斯",
                                    "text": "概括一下的话，就是先探明前方的地形情况，在地图上标出危险地带和大概的敌情，再回去告诉大家。"
                                },
                                {
                                    "id": "705580308",
                                    "speaker": "特雷斯",
                                    "text": "以前，这样的工作都由安柏长官和米卡教官负责，不过，他们毕竟不能分身，没法同时照顾所有小队。"
                                },
                                {
                                    "id": "705580309",
                                    "speaker": "特雷斯",
                                    "text": "洛恩副队长就推荐我来米卡教官这里，好好学习测绘技术，争取能勘测和标注得更准确…"
                                },
                                {
                                    "id": "705580310",
                                    "speaker": "特雷斯",
                                    "text": "为了加强我的换位思考能力，理解普通人员看地图时的思路，米卡教官才带着我，出了这个「测绘寻物」的考题。"
                                },
                                {
                                    "id": "705580311",
                                    "speaker": "特雷斯",
                                    "text": "观察您解开谜题的过程，我也能积累经验，结合米卡教官教我的知识，在小队里带出更多测绘员！"
                                }
                            ]
                        },
                        {
                            "id": "705580312",
                            "text": "想知道你和大家相处得如何。",
                            "response": [
                                {
                                    "id": "705580313",
                                    "speaker": "特雷斯",
                                    "text": "相处吗？大家都很好啦…至少我遇到的都是能力又强、工作又负责的好战友。"
                                },
                                {
                                    "id": "705580314",
                                    "speaker": "特雷斯",
                                    "text": "要举个例子的话，我最敬佩的还是洛恩副队长…"
                                },
                                {
                                    "id": "705580315",
                                    "speaker": "特雷斯",
                                    "text": "虽然许多时候跟不上他的思路，但他总是能出现在地图上最危险的地方，然后轻松解决那里的隐患…"
                                },
                                {
                                    "id": "705580316",
                                    "speaker": "特雷斯",
                                    "text": "另外，还有一位第七小队的信号官，耶嘉·格蕾特小姐。她与经受过训练的飞鹰一起工作哦！"
                                },
                                {
                                    "id": "705580317",
                                    "speaker": "特雷斯",
                                    "text": "虽然飞鹰看起来有点凶，但耶嘉是个做事踏实，又很随和的人，听说也经常跟着安柏长官去游击小队的营地…"
                                },
                                {
                                    "id": "705580318",
                                    "speaker": "特雷斯",
                                    "text": "对了，她和埃洛雯比较熟，还夸过埃洛雯做的饭很好吃呢。搞得我也想尝尝埃洛雯做的饭了…"
                                }
                            ]
                        },
                        {
                            "id": "705580319",
                            "text": "暂时不了。",
                            "response": [
                                {
                                    "id": "705580320",
                                    "speaker": "特雷斯",
                                    "text": "好的，如果您想来试试随时和我说，我时刻在这儿。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}