{
    "groupId": "4147",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "秋蔚": 10
    },
    "talks": [
        {
            "talkId": "6414701",
            "initDialog": "641470101",
            "dialogues": [
                {
                    "id": "641470101",
                    "speaker": "秋蔚",
                    "text": "你好，欢迎光临。"
                }
            ]
        },
        {
            "talkId": "6414702",
            "initDialog": "641470201",
            "dialogues": [
                {
                    "id": "641470201",
                    "speaker": "Player",
                    "text": "这里卖什么？"
                },
                {
                    "id": "641470202",
                    "speaker": "秋蔚",
                    "text": "珠宝与丝绸需要预定，现货商品只有部分原料，欢迎选购。"
                }
            ]
        },
        {
            "talkId": "6414703",
            "initDialog": "641470301",
            "dialogues": [
                {
                    "id": "641470301",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "641470302",
                    "speaker": "秋蔚",
                    "text": "这里是璃月「飞云商会」的直属授权店，也就是说，本店拥有「飞云商会」的行商许可。"
                },
                {
                    "id": "641470303",
                    "speaker": "秋蔚",
                    "text": "客人可以在这里买到璃月宝石制作的珠宝，与璃月特产的丝绸制品。"
                },
                {
                    "id": "641470304",
                    "speaker": "秋蔚",
                    "text": "珠宝与丝绸需要制作时间，如果需要的话欢迎预定。"
                },
                {
                    "id": "641470305",
                    "speaker": "秋蔚",
                    "text": "除此之外，客人也可以直接购置部分原料。"
                }
            ]
        },
        {
            "talkId": "6414704",
            "initDialog": "641470401",
            "dialogues": [
                {
                    "id": "641470401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641470402",
                    "speaker": "秋蔚",
                    "text": "客人慢走，欢迎再来。"
                }
            ]
        },
        {
            "talkId": "6414705",
            "initDialog": "641470501",
            "dialogues": [
                {
                    "id": "641470501",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "641470502",
                    "speaker": "秋蔚",
                    "text": "非常不错，须弥人虽然有着自己独特的纺织风格，但似乎也很喜欢这些璃月特色的商品。"
                },
                {
                    "id": "641470503",
                    "speaker": "秋蔚",
                    "text": "须弥本地的织锦十分有趣，「飞云商会」最近正试着将须弥纺织品的特色融入自己的产品之中。"
                },
                {
                    "id": "641470504",
                    "speaker": "秋蔚",
                    "text": "嗯…幸好这种民间手工艺品在教令院的眼中似乎不算是禁止出口的知识产物，不然我们想要运回样品可就难了。"
                }
            ]
        }
    ]
}