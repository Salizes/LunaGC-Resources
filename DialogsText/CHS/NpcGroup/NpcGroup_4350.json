{
    "groupId": "4350",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "希琳": 8
    },
    "talks": [
        {
            "talkId": "6435001",
            "initDialog": "643500101",
            "dialogues": [
                {
                    "id": "643500101",
                    "speaker": "希琳",
                    "text": "真幸运，又发现了一处月莲生长的区域。"
                }
            ]
        },
        {
            "talkId": "6435002",
            "initDialog": "643500201",
            "dialogues": [
                {
                    "id": "643500201",
                    "speaker": "Player",
                    "text": "你在采集月莲吗？"
                },
                {
                    "id": "643500202",
                    "speaker": "希琳",
                    "text": "暂时还不需要采摘，只是在标记有月莲生长的位置。"
                },
                {
                    "id": "643500203",
                    "speaker": "希琳",
                    "text": "月莲是常见的药用植物，但需要趁新鲜入药才能更好地发挥效果。"
                },
                {
                    "id": "643500204",
                    "speaker": "希琳",
                    "text": "我作为巡林队的队医，需要尽可能地将草药富集的区域做上标记，这样就能方便用时采摘了。"
                },
                {
                    "id": "643500205",
                    "speaker": "希琳",
                    "text": "雨林虽然看上去静谧，但其中潜藏的危险也不容小觑。你在林中行走的话，请尽量走大路，并留意身边的动静。"
                }
            ]
        },
        {
            "talkId": "6435003",
            "initDialog": "643500301",
            "dialogues": [
                {
                    "id": "643500301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643500302",
                    "speaker": "希琳",
                    "text": "再见，祝你一路平安。"
                }
            ]
        },
        {
            "talkId": "7396401",
            "initDialog": "739640101",
            "dialogues": [
                {
                    "id": "739640101",
                    "speaker": "Player",
                    "text": "我会的。"
                },
                {
                    "id": "739640102",
                    "speaker": "希琳",
                    "text": "嗯。另外，除了常备应急药物之外，最好再准备一把趁手的武器。"
                },
                {
                    "id": "739640103",
                    "speaker": "希琳",
                    "text": "既能用来打猎，也能应对魔物的袭击。弓箭这种远程武器就很不错，也是我们巡林队中的常见之选。"
                }
            ]
        }
    ]
}