{
    "groupId": "4333",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 5,
        "班卡": 17
    },
    "talks": [
        {
            "talkId": "6433301",
            "initDialog": "643330101",
            "dialogues": [
                {
                    "id": "643330101",
                    "speaker": "班卡",
                    "text": "身体可是一切的本钱啊，唉…"
                }
            ]
        },
        {
            "talkId": "6433302",
            "initDialog": "643330201",
            "dialogues": [
                {
                    "id": "643330201",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "643330202",
                    "speaker": "班卡",
                    "text": "我？我没什么问题，一切都好。"
                },
                {
                    "id": "643330203",
                    "speaker": "班卡",
                    "text": "是库马，也就是我的弟弟…他身体虚弱，需要在树林茂密的地方静养。"
                },
                {
                    "id": "643330204",
                    "speaker": "班卡",
                    "text": "在他生病以前，我会把猎获所得拿去城里卖钱。但现在我需要照顾他，除了去城里拿药，就很少离开村子了。"
                },
                {
                    "id": "643330205",
                    "speaker": "班卡",
                    "text": "有时候，得不得病并不是我们自己能选择的事情啊…他还那么年轻，我只希望他能早日康复。"
                }
            ]
        },
        {
            "talkId": "6433303",
            "initDialog": "643330301",
            "dialogues": [
                {
                    "id": "643330301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643330302",
                    "speaker": "班卡",
                    "text": "嗯…再见。"
                }
            ]
        },
        {
            "talkId": "6433304",
            "initDialog": "643330401",
            "dialogues": [
                {
                    "id": "643330401",
                    "speaker": "班卡",
                    "text": "你觉得，是在城里生活更好，还是留在维摩庄更好呢？"
                }
            ]
        },
        {
            "talkId": "6433305",
            "initDialog": "643330501",
            "dialogues": [
                {
                    "id": "643330501",
                    "speaker": "Player",
                    "text": "你准备搬进城里吗？"
                },
                {
                    "id": "643330502",
                    "speaker": "班卡",
                    "text": "我？我的话，留在这里就好。"
                },
                {
                    "id": "643330503",
                    "speaker": "班卡",
                    "text": "是库马，也就是我的弟弟…众所周知，草神大人治愈了所有的魔鳞病患者，我的弟弟就是其中之一。"
                },
                {
                    "id": "643330504",
                    "speaker": "班卡",
                    "text": "既然他的身体好转，也该为今后做些打算了。"
                },
                {
                    "id": "643330505",
                    "speaker": "班卡",
                    "text": "他想尝试的东西有很多，但我觉得比起留在这里或是外出冒险，还是进城读书更有前途。"
                },
                {
                    "id": "643330506",
                    "speaker": "班卡",
                    "text": "如果能在教令院当个学者什么的，以后就不用为生活发愁了。"
                }
            ]
        },
        {
            "talkId": "7395301",
            "initDialog": "739530101",
            "dialogues": [
                {
                    "id": "739530101",
                    "speaker": "Player",
                    "text": "会好起来的。"
                },
                {
                    "id": "739530102",
                    "speaker": "班卡",
                    "text": "哈哈，虽然知道是客气话，但听人这么说，还是能让我感到一些安慰。"
                },
                {
                    "id": "739530103",
                    "speaker": "班卡",
                    "text": "希望就像我弟弟整天念叨的那样，小草神大人会听到我们的祈愿的。"
                }
            ]
        },
        {
            "talkId": "7395302",
            "initDialog": "739530201",
            "dialogues": [
                {
                    "id": "739530201",
                    "speaker": "Player",
                    "text": "问问他的想法吧。"
                },
                {
                    "id": "739530202",
                    "speaker": "班卡",
                    "text": "嗯，你说的对。毕竟是他的人生，还是应该由他自己决定。"
                },
                {
                    "id": "739530203",
                    "speaker": "班卡",
                    "text": "反正时间多得很，慢慢打算就是了。"
                },
                {
                    "id": "739530204",
                    "speaker": "班卡",
                    "text": "你看，这是他最近带回来的。这种花大多长在高处，他能摘到这些放在以前可是想都不敢想的事情啊。"
                }
            ]
        }
    ]
}