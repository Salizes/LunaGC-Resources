{
    "groupId": "1449",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "麦尔斯": 8
    },
    "talks": [
        {
            "talkId": "6144901",
            "initDialog": "614490101",
            "dialogues": [
                {
                    "id": "614490101",
                    "speaker": "麦尔斯",
                    "text": "遇到什么困难了吗？"
                }
            ]
        },
        {
            "talkId": "6144902",
            "initDialog": "614490201",
            "dialogues": [
                {
                    "id": "614490201",
                    "speaker": "Player",
                    "text": "您在这里干什么呢？"
                },
                {
                    "id": "614490202",
                    "speaker": "麦尔斯",
                    "text": "正如您所见，我是蒙德城的卫兵。"
                },
                {
                    "id": "614490203",
                    "speaker": "麦尔斯",
                    "text": "保护蒙德城的商贾，居民和旅客，就是我的使命。"
                }
            ]
        },
        {
            "talkId": "6144903",
            "initDialog": "614490301",
            "dialogues": [
                {
                    "id": "614490301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614490302",
                    "speaker": "麦尔斯",
                    "text": "再见，旅行者。"
                },
                {
                    "id": "614490303",
                    "speaker": "麦尔斯",
                    "text": "注意安全。"
                }
            ]
        },
        {
            "talkId": "6144904",
            "initDialog": "614490401",
            "dialogues": [
                {
                    "id": "614490401",
                    "speaker": "麦尔斯",
                    "text": "现在气候异常，外面很危险，一般民众请找安全的地方避难。"
                }
            ]
        },
        {
            "talkId": "6144905",
            "initDialog": "614490501",
            "dialogues": [
                {
                    "id": "614490501",
                    "speaker": "麦尔斯",
                    "text": "那条龙随时可能回来，我们西风骑士会盯着的，请抓紧避难。"
                }
            ]
        },
        {
            "talkId": "6144906",
            "initDialog": "614490601",
            "dialogues": [
                {
                    "id": "614490601",
                    "speaker": "麦尔斯",
                    "text": "现在是紧急事态，请相信我们西风骑士会保障大家的安全。"
                }
            ]
        }
    ]
}