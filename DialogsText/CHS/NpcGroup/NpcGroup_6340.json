{
    "groupId": "6340",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "奥罗卢柯": 13
    },
    "talks": [
        {
            "talkId": "6634001",
            "initDialog": "663400101",
            "dialogues": [
                {
                    "id": "663400101",
                    "speaker": "奥罗卢柯",
                    "text": "你好呀，你也是来和可爱的鱼鱼们互动的吗？需不需要我和钓鱼协会的帮助？"
                }
            ]
        },
        {
            "talkId": "6634002",
            "initDialog": "663400201",
            "dialogues": [
                {
                    "id": "663400201",
                    "speaker": "Player",
                    "text": "需要钓鱼用品…"
                },
                {
                    "id": "663400202",
                    "speaker": "奥罗卢柯",
                    "text": "嗯哼，我这里的货品不多，但质量还行，请随意挑选~"
                }
            ]
        },
        {
            "talkId": "6634003",
            "initDialog": "663400301",
            "dialogues": [
                {
                    "id": "663400301",
                    "speaker": "Player",
                    "text": "可爱？"
                },
                {
                    "id": "663400302",
                    "speaker": "奥罗卢柯",
                    "text": "对呀，在河里湖里海里悠悠哉哉地来回游动，尾巴摆呀摆…"
                },
                {
                    "id": "663400303",
                    "speaker": "奥罗卢柯",
                    "text": "嗯，我自己是觉得挺可爱的啦，你如果没什么感觉，那也没关系！"
                },
                {
                    "id": "663400304",
                    "speaker": "奥罗卢柯",
                    "text": "我为了看到、钓到和养到更多可爱的鱼，才加入了钓鱼协会。"
                },
                {
                    "id": "663400305",
                    "speaker": "奥罗卢柯",
                    "text": "不过，也有人只是为了鲜美的鱼肉，或者把鱼卖掉赚钱来钓鱼。"
                },
                {
                    "id": "663400306",
                    "speaker": "奥罗卢柯",
                    "text": "我理解他们，不干涉他们。大部分钓鱼协会的朋友也很尊重我。"
                },
                {
                    "id": "663400307",
                    "speaker": "奥罗卢柯",
                    "text": "当然，我也希望更多人能认识到鱼鱼的可爱~"
                }
            ]
        },
        {
            "talkId": "6634004",
            "initDialog": "663400401",
            "dialogues": [
                {
                    "id": "663400401",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "663400402",
                    "speaker": "奥罗卢柯",
                    "text": "你好哦，我叫奥罗卢柯，是纳塔钓鱼协会的员工。"
                },
                {
                    "id": "663400403",
                    "speaker": "奥罗卢柯",
                    "text": "如果想买纳塔特色的渔具，鱼饵，委托我跑腿就好了！"
                },
                {
                    "id": "663400404",
                    "speaker": "奥罗卢柯",
                    "text": "要是觉得这里有点偏远，可以在「奥特华的渔网」留言，我是店主的朋友，也经常去那边买东西！"
                },
                {
                    "id": "663400405",
                    "speaker": "奥罗卢柯",
                    "text": "不过，谈到钓鱼技术，我就只是普普通通的水平啦，我会不断练习，努力变强的！"
                }
            ]
        },
        {
            "talkId": "6634005",
            "initDialog": "663400501",
            "dialogues": [
                {
                    "id": "663400501",
                    "speaker": "Player",
                    "text": "回见了！"
                },
                {
                    "id": "663400502",
                    "speaker": "奥罗卢柯",
                    "text": "好呀，我有种感觉，你是个钓鱼高手…那就下次再见了！"
                }
            ]
        }
    ]
}