{
    "groupId": "5185",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "雅拉德": 11
    },
    "talks": [
        {
            "talkId": "6518501",
            "initDialog": "651850101",
            "dialogues": [
                {
                    "id": "651850101",
                    "speaker": "雅拉德",
                    "text": "不能再待在柔灯港里了，海露港怎么样？嗯…"
                }
            ]
        },
        {
            "talkId": "6518502",
            "initDialog": "651850201",
            "dialogues": [
                {
                    "id": "651850201",
                    "speaker": "Player",
                    "text": "为什么不能待在柔灯港里？"
                },
                {
                    "id": "651850202",
                    "speaker": "雅拉德",
                    "text": "唉，你不在这里工作，肯定不知道。"
                },
                {
                    "id": "651850203",
                    "speaker": "雅拉德",
                    "text": "这里的位置离枫丹廷很远，周围也没什么商店啦之类可以购物的地方，只有一个酒馆，但我又不喜欢喝酒…"
                }
            ]
        },
        {
            "talkId": "6518503",
            "initDialog": "651850301",
            "dialogues": [
                {
                    "id": "651850301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651850302",
                    "speaker": "雅拉德",
                    "text": "再见。无论如何…祝您在柔灯港过得愉快。"
                }
            ]
        },
        {
            "talkId": "6518504",
            "initDialog": "651850401",
            "dialogues": [
                {
                    "id": "651850401",
                    "speaker": "Player",
                    "text": "那你准备去哪里？"
                },
                {
                    "id": "651850402",
                    "speaker": "雅拉德",
                    "text": "我…我也没想好。"
                },
                {
                    "id": "651850403",
                    "speaker": "雅拉德",
                    "text": "总不能去海露港吧，那边靠着沙漠，听我在那边工作的朋友说，有时候吹进港口的风里都带着沙子呢。"
                },
                {
                    "id": "651850404",
                    "speaker": "雅拉德",
                    "text": "要是被那种风吹久了，我的皮肤肯定都要坏掉了。"
                },
                {
                    "id": "651850405",
                    "speaker": "雅拉德",
                    "text": "唉，实在不行…还是回城里找份工作吧…"
                }
            ]
        },
        {
            "talkId": "6518505",
            "initDialog": "651850501",
            "dialogues": [
                {
                    "id": "651850501",
                    "speaker": "Player",
                    "text": "关于杜泰…"
                },
                {
                    "id": "651850502",
                    "speaker": "雅拉德",
                    "text": "杜泰先生是个好人，既勤奋，又友好。总是为了他人打算。"
                },
                {
                    "id": "651850503",
                    "speaker": "雅拉德",
                    "text": "但他实在是太喜欢报表、数据单和会议记录了。"
                },
                {
                    "id": "651850504",
                    "speaker": "雅拉德",
                    "text": "我觉得他之所以会提出扩建柔灯港的计划，就是因为这项工程能让他每天尽情且合理地沉浸在会议的海洋里…"
                }
            ]
        }
    ]
}