{
    "groupId": "6050",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "奥西": 10
    },
    "talks": [
        {
            "talkId": "6605001",
            "initDialog": "660500101",
            "dialogues": [
                {
                    "id": "660500101",
                    "speaker": "奥西",
                    "text": "年纪大了记性不好了…不过转念一想，我年轻时记性也挺差的，哈哈。"
                }
            ]
        },
        {
            "talkId": "6605002",
            "initDialog": "660500201",
            "dialogues": [
                {
                    "id": "660500201",
                    "speaker": "Player",
                    "text": "有故事？"
                },
                {
                    "id": "660500202",
                    "speaker": "奥西",
                    "text": "哪有什么故事，记性好还是差不都是一样生活嘛。"
                },
                {
                    "id": "660500203",
                    "speaker": "奥西",
                    "text": "要说记忆力不好给我带来的麻烦…大概只有演出时会忘歌词了吧。"
                },
                {
                    "id": "660500204",
                    "speaker": "奥西",
                    "text": "不过都是年轻时的事情了。你别说，有次在归火圣夜巡礼的赛间表演时忘了下一句该唱什么，还挺刺激的…"
                },
                {
                    "id": "660500205",
                    "speaker": "奥西",
                    "text": "还好烟谜主他们写的歌词都特别「古典」，有时你也不知道它到底是什么意思，乱唱一气大伙也听不出来，嘿嘿。"
                }
            ]
        },
        {
            "talkId": "6605003",
            "initDialog": "660500301",
            "dialogues": [
                {
                    "id": "660500301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660500302",
                    "speaker": "奥西",
                    "text": "再见！希望下次见面我还能记得你。"
                }
            ]
        },
        {
            "talkId": "6605004",
            "initDialog": "660500401",
            "dialogues": [
                {
                    "id": "660500401",
                    "speaker": "Player",
                    "text": "确实是「珍贵」回忆。"
                },
                {
                    "id": "660500402",
                    "speaker": "奥西",
                    "text": "或者说是珍贵的「失忆」吧，哈哈。"
                },
                {
                    "id": "660500403",
                    "speaker": "奥西",
                    "text": "听我说，人记忆力不好未必是坏事，记住的东西越少，就越不容易有执念。"
                },
                {
                    "id": "660500404",
                    "speaker": "奥西",
                    "text": "你看看那个「黑曜石奶奶」茜特菈莉，都过去多少年了，还惦记着那本没更新完的连载小说呢！"
                },
                {
                    "id": "660500405",
                    "speaker": "奥西",
                    "text": "欸，那小说叫什么来着…忘了嘿…"
                }
            ]
        }
    ]
}