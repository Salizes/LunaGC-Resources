{
    "groupId": "7001",
    "total_dialogue_lines": 37,
    "speaker_counts": {
        "Player": 10,
        "柳佳": 23,
        "爱诺": 4
    },
    "talks": [
        {
            "talkId": "5900255",
            "initDialog": "590025501",
            "dialogues": [
                {
                    "id": "590025501",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900256",
            "initDialog": "590025601",
            "dialogues": [
                {
                    "id": "590025601",
                    "speaker": "柳佳",
                    "text": "欸，值得留意的事？有哦，比方说那边的云朵就特别适合盯着发呆…毕竟是这种吵吵闹闹的地方，偶尔闲下来发发呆不也挺好嘛。"
                }
            ]
        },
        {
            "talkId": "6700101",
            "initDialog": "670010101",
            "dialogues": [
                {
                    "id": "670010101",
                    "speaker": "柳佳",
                    "text": "如果能把这个发现应用于新的装置…"
                }
            ]
        },
        {
            "talkId": "6700102",
            "initDialog": "670010201",
            "dialogues": [
                {
                    "id": "670010201",
                    "speaker": "Player",
                    "text": "想买些武器。"
                },
                {
                    "id": "670010202",
                    "speaker": "柳佳",
                    "text": "欸？好喔，随便看看吧。"
                }
            ]
        },
        {
            "talkId": "6700103",
            "initDialog": "670010301",
            "dialogues": [
                {
                    "id": "670010301",
                    "speaker": "Player",
                    "text": "委托锻造…"
                },
                {
                    "id": "670010302",
                    "speaker": "柳佳",
                    "text": "嗯…需要什么呢？只要有图纸，不管什么都能打造出来喔。"
                }
            ]
        },
        {
            "talkId": "6700104",
            "initDialog": "670010401",
            "dialogues": [
                {
                    "id": "670010401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33>委托锻造…</color>"
                },
                {
                    "id": "670010402",
                    "speaker": "柳佳",
                    "text": "之前的委托已经完成了喔。还需要什么别的东西吗？"
                }
            ]
        },
        {
            "talkId": "6700105",
            "initDialog": "670010501",
            "dialogues": [
                {
                    "id": "670010501",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "670010502",
                    "speaker": "柳佳",
                    "text": "嗯？啊…没什么，只是在想月矩力的新应用而已。要是能进一步改造这台锻造机器的话…"
                },
                {
                    "id": "670010503",
                    "speaker": "柳佳",
                    "text": "当然，现在的挪德卡莱也没几个比「它」还要厉害的锻造师啦。除了爱诺…嗯，除了爱诺。"
                }
            ]
        },
        {
            "talkId": "6700106",
            "initDialog": "670010601",
            "dialogues": [
                {
                    "id": "670010601",
                    "speaker": "Player",
                    "text": "不打扰了，再见。"
                },
                {
                    "id": "670010602",
                    "speaker": "柳佳",
                    "text": "哦…拜拜。"
                }
            ]
        },
        {
            "talkId": "6700107",
            "initDialog": "670010701",
            "dialogues": [
                {
                    "id": "670010701",
                    "speaker": "Player",
                    "text": "你是铁匠吗？"
                },
                {
                    "id": "670010702",
                    "speaker": "柳佳",
                    "text": "铁匠？嗯…你觉得我算吗？我觉得应该不算，毕竟和老爹不一样，我连锤子都拎不起来嘛。"
                },
                {
                    "id": "670010703",
                    "speaker": "柳佳",
                    "text": "是研究员啦，研究员…虽然研究的经费基本都来自打铁的收入就是了。"
                }
            ]
        },
        {
            "talkId": "6700108",
            "initDialog": "670010801",
            "dialogues": [
                {
                    "id": "670010801",
                    "speaker": "Player",
                    "text": "关于这台机器…"
                },
                {
                    "id": "670010802",
                    "speaker": "柳佳",
                    "text": "哼哼，怎么样，看上去就很厉害吧？这可是爱诺和我的得意之作，罗素姆工坊的万能锻造机关喔。"
                },
                {
                    "id": "670010803",
                    "speaker": "柳佳",
                    "text": "只要投入原材料，无论是日常使用的工具还是兵器，都可以按照标准制造模板快速生产出来。"
                },
                {
                    "id": "670010804",
                    "speaker": "柳佳",
                    "text": "之前听奈芙尔大姐说，那些北方人好像也有类似的东西…不过没有月矩力的话，他们的机器又是靠什么驱动的呢？"
                }
            ]
        },
        {
            "talkId": "6700109",
            "initDialog": "670010901",
            "dialogues": [
                {
                    "id": "670010901",
                    "speaker": "Player",
                    "text": "关于月矩力…"
                },
                {
                    "id": "670010902",
                    "speaker": "柳佳",
                    "text": "月矩力就是…嗯…解释起来很麻烦，所以你就当成一种很厉害的能量吧。这里的机关基本上都是靠着这个运行的。"
                },
                {
                    "id": "670010903",
                    "speaker": "柳佳",
                    "text": "霜月之子的家伙还会管这个叫祝福什么的…听听就好，听听就好啦。"
                }
            ]
        },
        {
            "talkId": "6700110",
            "initDialog": "670011001",
            "dialogues": [
                {
                    "id": "670011001",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想买些武器。</color>"
                },
                {
                    "id": "670011002",
                    "speaker": "柳佳",
                    "text": "欸？好喔，随便看看吧。"
                }
            ]
        },
        {
            "talkId": "6700111",
            "initDialog": "670011101",
            "dialogues": [
                {
                    "id": "670011101",
                    "speaker": "柳佳",
                    "text": "爱诺？今天怎么有空来我这边？"
                },
                {
                    "id": "670011102",
                    "speaker": "爱诺",
                    "text": "和伊涅芙一起来买东西，路过这边，就顺便过来玩啦。"
                },
                {
                    "id": "670011103",
                    "speaker": "柳佳",
                    "text": "这样啊，我还以为你又是来给我出难题的，你那些设计图，我可是看不懂的。"
                },
                {
                    "id": "670011104",
                    "speaker": "柳佳",
                    "text": "哦对了，上次你帮我改造的设备挺好用的，谢啦。"
                },
                {
                    "id": "670011105",
                    "speaker": "柳佳",
                    "text": "你看，锻造出来的矿石很纯净，而且对原矿的利用率也很高。"
                },
                {
                    "id": "670011106",
                    "speaker": "爱诺",
                    "text": "那当然了，你也不看看，到底是谁帮你亲手改造的设备。"
                },
                {
                    "id": "670011107",
                    "speaker": "柳佳",
                    "text": "是你是你，大大天才爱诺师傅。喏，我刚买了点零食，趁你家伊涅芙不在，赶紧尝尝？"
                },
                {
                    "id": "670011108",
                    "speaker": "爱诺",
                    "text": "又用零食收买我，这次又要我帮你什么？先说好，无聊的东西我可不做，力气活你去找伊涅芙。"
                },
                {
                    "id": "670011109",
                    "speaker": "柳佳",
                    "text": "哎呀，都说了是为了感谢你上次的帮忙。"
                },
                {
                    "id": "670011110",
                    "speaker": "爱诺",
                    "text": "你上次也这么说，每一次都是为了感谢上一次，你是认定了一定还会有「下一次」么？"
                },
                {
                    "id": "670011111",
                    "speaker": "柳佳",
                    "text": "咳，不说这个！来来来，吃糖吃糖，还有巧克力和蛋卷呢。"
                }
            ]
        }
    ]
}