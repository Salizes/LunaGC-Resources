{
    "groupId": "2101",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 1,
        "蔡寻": 12
    },
    "talks": [
        {
            "talkId": "6210101",
            "initDialog": "621010101",
            "dialogues": [
                {
                    "id": "621010101",
                    "speaker": "蔡寻",
                    "text": "欢迎来到璃月港。千岩军有什么能帮得上你的吗？"
                }
            ]
        },
        {
            "talkId": "6210102",
            "initDialog": "621010201",
            "dialogues": [
                {
                    "id": "621010201",
                    "speaker": "蔡寻",
                    "text": "关于千岩军…"
                },
                {
                    "id": "621010202",
                    "speaker": "蔡寻",
                    "text": "「千岩牢固，重嶂不移。干城戎甲，靖妖闲邪」。"
                },
                {
                    "id": "621010203",
                    "speaker": "蔡寻",
                    "text": "我们千岩军听从璃月「七星」的调遣，你可以把我们视为璃月的公安勤务人员。"
                },
                {
                    "id": "621010204",
                    "speaker": "蔡寻",
                    "text": "盗窃斗殴一类的小事可以找我们处理，魔物来袭时，我们也是璃月最坚实的护盾。"
                },
                {
                    "id": "621010205",
                    "speaker": "蔡寻",
                    "text": "有需要的话尽管向我们千岩军求助吧。"
                }
            ]
        },
        {
            "talkId": "6210103",
            "initDialog": "621010301",
            "dialogues": [
                {
                    "id": "621010301",
                    "speaker": "蔡寻",
                    "text": "再见。"
                },
                {
                    "id": "621010302",
                    "speaker": "蔡寻",
                    "text": "千岩牢固，重嶂不移。"
                }
            ]
        },
        {
            "talkId": "6210104",
            "initDialog": "621010401",
            "dialogues": [
                {
                    "id": "621010401",
                    "speaker": "Player",
                    "text": "你见过长得和我很像的人吗？"
                },
                {
                    "id": "621010402",
                    "speaker": "蔡寻",
                    "text": "唔，这个问题还真有些不好回答。"
                },
                {
                    "id": "621010403",
                    "speaker": "蔡寻",
                    "text": "倒不是说我偷懒、没有仔细盘查来往的行人，只是…"
                },
                {
                    "id": "621010404",
                    "speaker": "蔡寻",
                    "text": "…璃月港作为七国中最繁华的城市，每天来来往往的人实在是太多了，我也不可能记住所有人啊…"
                },
                {
                    "id": "621010405",
                    "speaker": "蔡寻",
                    "text": "我会帮你留意的，不过你也不要抱太大的希望…"
                }
            ]
        }
    ]
}