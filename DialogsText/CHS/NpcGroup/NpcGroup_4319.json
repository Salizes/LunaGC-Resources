{
    "groupId": "4319",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 2,
        "安普叔": 4,
        "贝尔卡塞姆": 12
    },
    "talks": [
        {
            "talkId": "6431705",
            "initDialog": "643170501",
            "dialogues": [
                {
                    "id": "643170501",
                    "speaker": "安普叔",
                    "text": "老友啊，你说，等有一天我们都老到记不清事了，应该会有年轻人来接替我们的工作吧。"
                },
                {
                    "id": "643170502",
                    "speaker": "贝尔卡塞姆",
                    "text": "那当然了，你这是说的什么丧气话。"
                },
                {
                    "id": "643170503",
                    "speaker": "贝尔卡塞姆",
                    "text": "咱们村子虽然小，但像样的年轻人还是很多的。"
                },
                {
                    "id": "643170504",
                    "speaker": "贝尔卡塞姆",
                    "text": "不要说那些从镀金旅团回来的人，就连卡齐姆那个心大的儿子也在认真工作呢。"
                },
                {
                    "id": "643170505",
                    "speaker": "安普叔",
                    "text": "哎，哎，你说的对，是我又在胡思乱想了。"
                },
                {
                    "id": "643170506",
                    "speaker": "安普叔",
                    "text": "村子里一定会出现更多像坎蒂丝这样可靠的接班人的。"
                },
                {
                    "id": "643170507",
                    "speaker": "贝尔卡塞姆",
                    "text": "可不是吗。说起来，坎蒂丝可是我们从小看着长大的。"
                },
                {
                    "id": "643170508",
                    "speaker": "贝尔卡塞姆",
                    "text": "还记得吗？她小时候因为视力不好认错了家门的那次…"
                },
                {
                    "id": "643170509",
                    "speaker": "安普叔",
                    "text": "好像确实有这么回事。呵呵，还是你的记性好啊…"
                }
            ]
        },
        {
            "talkId": "6431901",
            "initDialog": "643190101",
            "dialogues": [
                {
                    "id": "643190101",
                    "speaker": "贝尔卡塞姆",
                    "text": "你好，有什么需要帮助的吗？"
                }
            ]
        },
        {
            "talkId": "6431902",
            "initDialog": "643190201",
            "dialogues": [
                {
                    "id": "643190201",
                    "speaker": "Player",
                    "text": "一切都好。"
                },
                {
                    "id": "643190202",
                    "speaker": "贝尔卡塞姆",
                    "text": "嗯，那就好。有事记得找卫兵。"
                },
                {
                    "id": "643190203",
                    "speaker": "贝尔卡塞姆",
                    "text": "虽然安普那个老家伙一定会说「有什么问题跟我说，我来帮忙」，但其实不需要事事都劳烦他。"
                },
                {
                    "id": "643190204",
                    "speaker": "贝尔卡塞姆",
                    "text": "我小时候就认识他。后来我出村闯荡，做过生意、当过佣兵、干过体力活…什么都尝试过。"
                },
                {
                    "id": "643190205",
                    "speaker": "贝尔卡塞姆",
                    "text": "结果回家后发现他变成了什么事都要亲力亲为的啰嗦老头子了，真是没想到。"
                },
                {
                    "id": "643190206",
                    "speaker": "贝尔卡塞姆",
                    "text": "所以我就自愿做起了卫兵。除了巡逻以外，能帮他分担点事务也好。"
                }
            ]
        },
        {
            "talkId": "6431903",
            "initDialog": "643190301",
            "dialogues": [
                {
                    "id": "643190301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643190302",
                    "speaker": "贝尔卡塞姆",
                    "text": "再见。注意安全，留心脚下。"
                }
            ]
        }
    ]
}