{
    "groupId": "3134",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "桃子": 15
    },
    "talks": [
        {
            "talkId": "6313401",
            "initDialog": "631340101",
            "dialogues": [
                {
                    "id": "631340101",
                    "speaker": "桃子",
                    "text": "清子小姐卖的东西是不是太便宜了…"
                }
            ]
        },
        {
            "talkId": "6313402",
            "initDialog": "631340201",
            "dialogues": [
                {
                    "id": "631340201",
                    "speaker": "Player",
                    "text": "便宜不好吗？"
                },
                {
                    "id": "631340202",
                    "speaker": "桃子",
                    "text": "对于我们这些要靠清子小姐才能买到日用品的居民来说，当然东西卖得越便宜越好啦。"
                },
                {
                    "id": "631340203",
                    "speaker": "桃子",
                    "text": "最开始的时候，因为售价过于低廉，大家还怀疑过清子小姐别有用意…现在想想真是不应该。"
                },
                {
                    "id": "631340204",
                    "speaker": "桃子",
                    "text": "清子小姐热情善良，只是为了方便这里的居民，才主动放弃更高的利润，让大家都能生活得更好。"
                },
                {
                    "id": "631340205",
                    "speaker": "桃子",
                    "text": "多亏了清子小姐，村里的大家才能方便地购物，有时还能买到岛上少见的新鲜东西呢。"
                },
                {
                    "id": "631340206",
                    "speaker": "桃子",
                    "text": "说起来我之前买了一些新的布料，等丈夫回家就可以给他做新衣服了…"
                }
            ]
        },
        {
            "talkId": "6313403",
            "initDialog": "631340301",
            "dialogues": [
                {
                    "id": "631340301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631340302",
                    "speaker": "桃子",
                    "text": "嗯，再见。"
                }
            ]
        },
        {
            "talkId": "6313404",
            "initDialog": "631340401",
            "dialogues": [
                {
                    "id": "631340401",
                    "speaker": "Player",
                    "text": "关于你的丈夫…"
                },
                {
                    "id": "631340402",
                    "speaker": "桃子",
                    "text": "我的丈夫是珊瑚宫军的一名士兵，正在八酝岛附近出征。"
                },
                {
                    "id": "631340403",
                    "speaker": "桃子",
                    "text": "我对于战争的事情不是很懂，丈夫寄回家的信也完全不提战场上的情况，内容全是报平安和安慰我的话…"
                },
                {
                    "id": "631340404",
                    "speaker": "桃子",
                    "text": "但说实话，作为妻子，我怎么可能不担心自己的丈夫呢？"
                },
                {
                    "id": "631340405",
                    "speaker": "桃子",
                    "text": "唉，真怀念我们以前无忧无虑，忙时一起奔波，闲时观景赏花的日子啊…"
                },
                {
                    "id": "631340406",
                    "speaker": "桃子",
                    "text": "愿「海祇大御神」保佑，我的丈夫能平安回家。"
                }
            ]
        },
        {
            "talkId": "7292801",
            "initDialog": "729280101",
            "dialogues": [
                {
                    "id": "729280101",
                    "speaker": "Player",
                    "text": "祝你们早日团聚。"
                },
                {
                    "id": "729280102",
                    "speaker": "桃子",
                    "text": "借你吉言。"
                },
                {
                    "id": "729280103",
                    "speaker": "桃子",
                    "text": "啊对了，这里有些我做的料理，本来是要拿去送给清子小姐的，也分给你一些吧。"
                },
                {
                    "id": "729280104",
                    "speaker": "桃子",
                    "text": "只是一些家常菜，不嫌弃的话请尝尝看。"
                }
            ]
        }
    ]
}