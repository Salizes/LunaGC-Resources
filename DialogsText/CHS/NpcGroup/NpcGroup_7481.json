{
    "groupId": "7481",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "马蒙托夫": 9
    },
    "talks": [
        {
            "talkId": "6748101",
            "initDialog": "674810101",
            "dialogues": [
                {
                    "id": "674810101",
                    "speaker": "马蒙托夫",
                    "text": "还没到我吗？还要等多久…不会误点吧…"
                }
            ]
        },
        {
            "talkId": "6748102",
            "initDialog": "674810201",
            "dialogues": [
                {
                    "id": "674810201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "674810202",
                    "speaker": "马蒙托夫",
                    "text": "欸？你认出我了？是我的读者吗？原来我已经这么出名了…"
                }
            ]
        },
        {
            "talkId": "6748103",
            "initDialog": "674810301",
            "dialogues": [
                {
                    "id": "674810301",
                    "speaker": "Player",
                    "text": "看样子还要等很久吧。"
                },
                {
                    "id": "674810302",
                    "speaker": "马蒙托夫",
                    "text": "是啊。刚才有对年轻夫妇在这儿大吵了一架，列车员也不管管…可能管也管不动吧。"
                },
                {
                    "id": "674810303",
                    "speaker": "马蒙托夫",
                    "text": "我看他们吵完就各奔东西了，留在这儿的好像是他们的孩子，家庭不幸啊，怪可怜的。"
                },
                {
                    "id": "674810304",
                    "speaker": "马蒙托夫",
                    "text": "不过售票员要是再不快点解决他的问题，可怜的就是我了。排了这么久的队还误了列车的点，上哪儿说理去。"
                }
            ]
        },
        {
            "talkId": "6748104",
            "initDialog": "674810401",
            "dialogues": [
                {
                    "id": "674810401",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "674810402",
                    "speaker": "马蒙托夫",
                    "text": "你等的车已经到了吗？祝你一路顺风。"
                }
            ]
        },
        {
            "talkId": "6748105",
            "initDialog": "674810501",
            "dialogues": [
                {
                    "id": "674810501",
                    "speaker": "Player",
                    "text": "什么读者？"
                },
                {
                    "id": "674810502",
                    "speaker": "马蒙托夫",
                    "text": "当然是《先驱报》的读者…等等，说起来报上没有刊过我本人的画片…抱歉，看来是我弄错了。"
                },
                {
                    "id": "674810503",
                    "speaker": "马蒙托夫",
                    "text": "实不相瞒，我在给《先驱报》的一个小板块供稿，编辑说近来这个板块很受读者欢迎，我还以为自己这就出名了呢。"
                },
                {
                    "id": "674810504",
                    "speaker": "马蒙托夫",
                    "text": "仔细研究查证写出来的列车研究屡遭拒稿，随手写的半真半假的列车故事却反响热烈，真是世事难料啊。"
                }
            ]
        }
    ]
}