{
    "groupId": "5009",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "希尔维娅": 9
    },
    "talks": [
        {
            "talkId": "6500901",
            "initDialog": "650090101",
            "dialogues": [
                {
                    "id": "650090101",
                    "speaker": "希尔维娅",
                    "text": "您好，请问我可以为您做些什么？"
                }
            ]
        },
        {
            "talkId": "6500902",
            "initDialog": "650090201",
            "dialogues": [
                {
                    "id": "650090201",
                    "speaker": "Player",
                    "text": "关于枫丹廷…"
                },
                {
                    "id": "650090202",
                    "speaker": "希尔维娅",
                    "text": "您第一次来枫丹廷吗？那我来推荐一些热门景点吧。"
                },
                {
                    "id": "650090203",
                    "speaker": "希尔维娅",
                    "text": "如果您对新闻时论感兴趣，想要借此了解枫丹，我推荐您朝蒸汽鸟报社的方向走一走。"
                },
                {
                    "id": "650090204",
                    "speaker": "希尔维娅",
                    "text": "您路上可以买一份《蒸汽鸟报》，运气好的话，说不定还能遇到记者采访现场呢。"
                },
                {
                    "id": "650090205",
                    "speaker": "希尔维娅",
                    "text": "如果您对购物或者枫丹时尚感兴趣，可以逛逛纳博内区的达莫维百货。"
                },
                {
                    "id": "650090206",
                    "speaker": "希尔维娅",
                    "text": "引领全枫丹时尚潮流的香水店和成衣店也在这个区域哦，好多游客刚下船就奔着那里去了，哈哈。"
                }
            ]
        },
        {
            "talkId": "6500903",
            "initDialog": "650090301",
            "dialogues": [
                {
                    "id": "650090301",
                    "speaker": "Player",
                    "text": "关于巡轨船…"
                },
                {
                    "id": "650090302",
                    "speaker": "希尔维娅",
                    "text": "卡雷斯线通往枫丹廷北方的枫丹科学院方向，娜维娅线通往东方的伊黎耶岛，克莱门汀线则通往南方的海露港。"
                },
                {
                    "id": "650090303",
                    "speaker": "希尔维娅",
                    "text": "船上会有美露莘导游为您介绍枫丹特色景点，敬请期待吧。"
                }
            ]
        },
        {
            "talkId": "6500904",
            "initDialog": "650090401",
            "dialogues": [
                {
                    "id": "650090401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650090402",
                    "speaker": "希尔维娅",
                    "text": "很高兴为您服务，祝您生活愉快。再会！"
                }
            ]
        }
    ]
}