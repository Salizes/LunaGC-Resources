{
    "groupId": "4104",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "弥诺": 10
    },
    "talks": [
        {
            "talkId": "6410401",
            "initDialog": "641040101",
            "dialogues": [
                {
                    "id": "641040101",
                    "speaker": "弥诺",
                    "text": "只有那些长不大的小孩，才会相信兰那罗的故事呢。"
                }
            ]
        },
        {
            "talkId": "6410402",
            "initDialog": "641040201",
            "dialogues": [
                {
                    "id": "641040201",
                    "speaker": "Player",
                    "text": "关于兰那罗…"
                },
                {
                    "id": "641040202",
                    "speaker": "弥诺",
                    "text": "是一种童话故事中的幻想生物，这一点你一定要记住哦。"
                },
                {
                    "id": "641040203",
                    "speaker": "弥诺",
                    "text": "如果你还相信兰那罗的故事，那你就还没有长大。"
                }
            ]
        },
        {
            "talkId": "6410403",
            "initDialog": "641040301",
            "dialogues": [
                {
                    "id": "641040301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641040302",
                    "speaker": "弥诺",
                    "text": "从此以后，弥诺就是勇敢的大人了。"
                }
            ]
        },
        {
            "talkId": "6410404",
            "initDialog": "641040401",
            "dialogues": [
                {
                    "id": "641040401",
                    "speaker": "Player",
                    "text": "都有什么故事？"
                },
                {
                    "id": "641040402",
                    "speaker": "弥诺",
                    "text": "有很多哦，你没听说过吗？"
                },
                {
                    "id": "641040403",
                    "speaker": "弥诺",
                    "text": "比如「勇敢的兰那罗」。兰那罗虽然个子小小，但是勇气大大。"
                },
                {
                    "id": "641040404",
                    "speaker": "弥诺",
                    "text": "如此怕火的兰那罗，也会为了保护森林…呜…与森林中的孩子，用身体扑灭山火…"
                },
                {
                    "id": "641040405",
                    "speaker": "弥诺",
                    "text": "呜呜…兰那罗…"
                },
                {
                    "id": "641040406",
                    "speaker": "弥诺",
                    "text": "啊不对，这个，这个只是童话故事罢了！而弥诺已经长大，不再相信这些了…"
                },
                {
                    "id": "641040407",
                    "speaker": "弥诺",
                    "text": "呜…"
                }
            ]
        }
    ]
}