{
    "groupId": "2036",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 5,
        "观海": 26
    },
    "talks": [
        {
            "talkId": "4003724",
            "initDialog": "400372401",
            "dialogues": [
                {
                    "id": "400372401",
                    "speaker": "观海",
                    "text": "唉，今天特意早出门了一会儿，结果还是没赶上船…"
                },
                {
                    "id": "400372402",
                    "speaker": "观海",
                    "text": "怎么感觉今年的海灯节格外的忙啊？"
                }
            ]
        },
        {
            "talkId": "4003725",
            "initDialog": "400372501",
            "dialogues": [
                {
                    "id": "400372501",
                    "speaker": "观海",
                    "text": "嘿，朋友！你也是来享受夜晚的吗？"
                },
                {
                    "id": "400372502",
                    "speaker": "观海",
                    "text": "瞧这灯火通明的，让人打起牌来也更带劲了！"
                },
                {
                    "id": "400372503",
                    "speaker": "观海",
                    "text": "话说，要和我来一局不？"
                }
            ]
        },
        {
            "talkId": "6203601",
            "initDialog": "620360101",
            "dialogues": [
                {
                    "id": "620360101",
                    "speaker": "观海",
                    "text": "唉，又没赶上船…"
                }
            ]
        },
        {
            "talkId": "6203602",
            "initDialog": "620360201",
            "dialogues": [
                {
                    "id": "620360201",
                    "speaker": "Player",
                    "text": "你怎么了？"
                },
                {
                    "id": "620360202",
                    "speaker": "观海",
                    "text": "我吗？我是个水手，在船上工作，就是刚开走的那艘船…唉…"
                },
                {
                    "id": "620360203",
                    "speaker": "观海",
                    "text": "早起真是我最大的敌人，根本不够睡啊。"
                },
                {
                    "id": "620360204",
                    "speaker": "观海",
                    "text": "难道要我浪费掉美妙的夜生活去睡觉吗？哈哈哈…不可能的，早睡早起的那种生活对我来说和死了一样。"
                },
                {
                    "id": "620360205",
                    "speaker": "观海",
                    "text": "唉…船长该不会已经把我忘了吧？算了，明天一定要努力早起了。"
                }
            ]
        },
        {
            "talkId": "6203603",
            "initDialog": "620360301",
            "dialogues": [
                {
                    "id": "620360301",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620360302",
                    "speaker": "观海",
                    "text": "是啊，岩王爷都走了，璃月是不是要完了呢…"
                },
                {
                    "id": "620360303",
                    "speaker": "观海",
                    "text": "每当想起这件事，我就完全提不起工作的热情了，沉浸在迷茫中不能自拔…"
                },
                {
                    "id": "620360304",
                    "speaker": "观海",
                    "text": "嗯？你说我本来就这样？"
                },
                {
                    "id": "620360305",
                    "speaker": "观海",
                    "text": "唔，那只能说明我已经颓废到了不能再颓废的地步…"
                },
                {
                    "id": "620360306",
                    "speaker": "观海",
                    "text": "嗯…"
                },
                {
                    "id": "620360307",
                    "speaker": "观海",
                    "text": "我真厉害啊。"
                }
            ]
        },
        {
            "talkId": "6203604",
            "initDialog": "620360401",
            "dialogues": [
                {
                    "id": "620360401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620360402",
                    "speaker": "观海",
                    "text": "嗯你走吧，让我一个人再待一会儿。"
                }
            ]
        },
        {
            "talkId": "6203605",
            "initDialog": "620360501",
            "dialogues": [
                {
                    "id": "620360501",
                    "speaker": "观海",
                    "text": "要玩牌吗朋友？好好享受夜晚吧！"
                }
            ]
        },
        {
            "talkId": "6203606",
            "initDialog": "620360601",
            "dialogues": [
                {
                    "id": "620360601",
                    "speaker": "Player",
                    "text": "我不会…"
                },
                {
                    "id": "620360602",
                    "speaker": "观海",
                    "text": "这都不会？你的人生少了一半乐趣啊。"
                },
                {
                    "id": "620360603",
                    "speaker": "观海",
                    "text": "好在你还知道半夜出来转转，不然可就少了九成的乐趣。"
                },
                {
                    "id": "620360604",
                    "speaker": "观海",
                    "text": "打打牌，听听戏，感受下这璃月夜里的万家灯火，只有这一刻，让我觉得自己就像这世界的主角一样。"
                },
                {
                    "id": "620360605",
                    "speaker": "观海",
                    "text": "听到了吗，这一刻我是主角，不是你，哈哈！"
                }
            ]
        },
        {
            "talkId": "6203607",
            "initDialog": "620360701",
            "dialogues": [
                {
                    "id": "620360701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620360702",
                    "speaker": "观海",
                    "text": "再见，你该不会是那种要早睡的人吧？"
                }
            ]
        },
        {
            "talkId": "7203601",
            "initDialog": "720360101",
            "dialogues": [
                {
                    "id": "720360101",
                    "speaker": "观海",
                    "text": "呼…「明霄灯」全力建造中！"
                },
                {
                    "id": "720360102",
                    "speaker": "观海",
                    "text": "「海灯节」从小就是我最期待的日子，想不到能有机会亲手帮忙造「明霄灯」啊！"
                },
                {
                    "id": "720360103",
                    "speaker": "观海",
                    "text": "要加把劲儿了，偷懒可对不起儿时的自己，哈哈。"
                }
            ]
        }
    ]
}