{
    "groupId": "9576",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "罗莎莉亚": 10
    },
    "talks": [
        {
            "talkId": "6957601",
            "initDialog": "695760101",
            "dialogues": [
                {
                    "id": "695760101",
                    "speaker": "罗莎莉亚",
                    "text": "修女们应该找不到这里来吧，总算可以安心偷个懒了…"
                }
            ]
        },
        {
            "talkId": "6957602",
            "initDialog": "695760201",
            "dialogues": [
                {
                    "id": "695760201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957603",
            "initDialog": "695760301",
            "dialogues": [
                {
                    "id": "695760301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695760302",
                    "speaker": "罗莎莉亚",
                    "text": "要走了？我还要再等一会，现在回教堂的话，说不定又要被支使着到处忙活了…"
                }
            ]
        },
        {
            "talkId": "6957604",
            "initDialog": "695760401",
            "dialogues": [
                {
                    "id": "695760401",
                    "speaker": "罗莎莉亚",
                    "text": "这回算了。下局你再输的话，是不是该考虑请我一杯蒲公英酒？"
                }
            ]
        },
        {
            "talkId": "6957605",
            "initDialog": "695760501",
            "dialogues": [
                {
                    "id": "695760501",
                    "speaker": "罗莎莉亚",
                    "text": "只是走了个神，就把这局游戏输掉了…算你厉害，要喝什么？我请你。"
                }
            ]
        },
        {
            "talkId": "6957606",
            "initDialog": "695760601",
            "dialogues": [
                {
                    "id": "695760601",
                    "speaker": "罗莎莉亚",
                    "text": "啊？要和我打牌？行啊，反正不在教堂里，也不是工作时间。"
                }
            ]
        },
        {
            "talkId": "6957608",
            "initDialog": "695760801",
            "dialogues": [
                {
                    "id": "695760801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957609",
            "initDialog": "695760901",
            "dialogues": [
                {
                    "id": "695760901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957610",
            "initDialog": "695761001",
            "dialogues": [
                {
                    "id": "695761001",
                    "speaker": "罗莎莉亚",
                    "text": "我怎么这么会打牌？业余的一点爱好罢了，修女的工作那么无聊，我也要自己找点事做啊。"
                }
            ]
        },
        {
            "talkId": "6957611",
            "initDialog": "695761101",
            "dialogues": [
                {
                    "id": "695761101",
                    "speaker": "罗莎莉亚",
                    "text": "手法不错啊，没看出来，你还挺擅长打牌的…以后有空的话，我们多切磋一下吧。"
                }
            ]
        },
        {
            "talkId": "6957612",
            "initDialog": "695761201",
            "dialogues": [
                {
                    "id": "695761201",
                    "speaker": "罗莎莉亚",
                    "text": "还要再来一局？上一局是谁输了来着？按规矩是输家洗牌…算了，我来洗，你坐好吧。"
                }
            ]
        },
        {
            "talkId": "6957614",
            "initDialog": "695761401",
            "dialogues": [
                {
                    "id": "695761401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957615",
            "initDialog": "695761501",
            "dialogues": [
                {
                    "id": "695761501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957616",
            "initDialog": "695761601",
            "dialogues": [
                {
                    "id": "695761601",
                    "speaker": "罗莎莉亚",
                    "text": "喔，看来下一局归你洗牌了，辛苦你了啊。"
                }
            ]
        },
        {
            "talkId": "6957617",
            "initDialog": "695761701",
            "dialogues": [
                {
                    "id": "695761701",
                    "speaker": "罗莎莉亚",
                    "text": "怪了，我是哪里出错了牌…我先洗牌，我们稍后再来一场。"
                }
            ]
        },
        {
            "talkId": "6957618",
            "initDialog": "695761801",
            "dialogues": [
                {
                    "id": "695761801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}