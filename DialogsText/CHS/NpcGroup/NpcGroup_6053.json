{
    "groupId": "6053",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "索莉马娜": 12
    },
    "talks": [
        {
            "talkId": "6605301",
            "initDialog": "660530101",
            "dialogues": [
                {
                    "id": "660530101",
                    "speaker": "索莉马娜",
                    "text": "你好，需要帮助吗？没有被路过的龙撞翻吧？"
                }
            ]
        },
        {
            "talkId": "6605302",
            "initDialog": "660530201",
            "dialogues": [
                {
                    "id": "660530201",
                    "speaker": "Player",
                    "text": "常有这样的事故发生吗？"
                },
                {
                    "id": "660530202",
                    "speaker": "索莉马娜",
                    "text": "按道理来讲应该不常见的…虽然有些龙不太亲近人类，但也不至于主动攻击。"
                },
                {
                    "id": "660530203",
                    "speaker": "索莉马娜",
                    "text": "只是在我经常放置物资的地方，经常有龙撞到人的传闻。"
                },
                {
                    "id": "660530204",
                    "speaker": "索莉马娜",
                    "text": "顺便一提，我是「讯使长屋」的工作人员，会定期在讯使们常做停留的地方留下食物之类的补给品。"
                },
                {
                    "id": "660530205",
                    "speaker": "索莉马娜",
                    "text": "有一些是给人准备的，还有一些则是专门为他们的龙伙伴们用的。"
                }
            ]
        },
        {
            "talkId": "6605303",
            "initDialog": "660530301",
            "dialogues": [
                {
                    "id": "660530301",
                    "speaker": "Player",
                    "text": "一切都好。"
                },
                {
                    "id": "660530302",
                    "speaker": "索莉马娜",
                    "text": "好欸。"
                }
            ]
        },
        {
            "talkId": "6605304",
            "initDialog": "660530401",
            "dialogues": [
                {
                    "id": "660530401",
                    "speaker": "Player",
                    "text": "很可能是食物吸引了它们…"
                },
                {
                    "id": "660530402",
                    "speaker": "索莉马娜",
                    "text": "…啊！对哦！"
                },
                {
                    "id": "660530403",
                    "speaker": "索莉马娜",
                    "text": "如果龙或者野生动物知道某些地方会定期出现食物，的确有可能聚集过来…"
                },
                {
                    "id": "660530404",
                    "speaker": "索莉马娜",
                    "text": "饿昏了头时，冲撞到其他人也不是不可能…"
                },
                {
                    "id": "660530405",
                    "speaker": "索莉马娜",
                    "text": "谢谢你！让我意识到了有这种可能性，我得想个办法验证一下…"
                }
            ]
        },
        {
            "talkId": "7592201",
            "initDialog": "759220101",
            "dialogues": [
                {
                    "id": "759220101",
                    "speaker": "Player",
                    "text": "怎么验证呢？"
                },
                {
                    "id": "759220102",
                    "speaker": "索莉马娜",
                    "text": "唔…这样如何，你拿着这些，多在野外走走，看看会不会有龙撞…呃，接近你？"
                },
                {
                    "id": "759220103",
                    "speaker": "索莉马娜",
                    "text": "看你身手不错的样子，应该可以躲过的吧，对吧？"
                }
            ]
        }
    ]
}