    },
    "talks": [
        {
            "talkId": "6756601",
            "initDialog": "675660101",
            "dialogues": [
                {
                    "id": "675660101",
                    "speaker": "卢戈夫斯科",
                    "text": "小心，慢慢过来，可别把这家伙激怒了…"
                }
            ]
        },
        {
            "talkId": "6756602",
            "initDialog": "675660201",
            "dialogues": [
                {
                    "id": "675660201",
                    "speaker": "Player",
                    "text": "这是你养的熊？"
                },
                {
                    "id": "675660202",
                    "speaker": "卢戈夫斯科",
                    "text": "哦…饲养和被饲养可不是这么简单的关系，小家伙。在很多人眼里，是我在饲养这头熊…"
                },
                {
                    "id": "675660203",
                    "speaker": "卢戈夫斯科",
                    "text": "可或许在这头熊眼里，是他在养护我呢…在面对那些偷鸡摸狗的家伙的时候，他可比狗要可靠多了。"
                }
            ]
        },
        {
            "talkId": "6756603",
            "initDialog": "675660301",
            "dialogues": [
                {
                    "id": "675660301",
                    "speaker": "Player",
                    "text": "你是一名…？"
                },
                {
                    "id": "675660302",
                    "speaker": "卢戈夫斯科",
                    "text": "猎人…我在森林里猎熊，好不容易杀死了那只熊，发现那是只母熊，而它的孩子…"
                },
                {
                    "id": "675660303",
                    "speaker": "卢戈夫斯科",
                    "text": "喏，就是它，那时候还是只小家伙。"
                },
                {
                    "id": "675660304",
                    "speaker": "卢戈夫斯科",
                    "text": "按照猎人的习俗我把它带了回来…我杀死了它的母亲，或许等我再老一些，老到也没法扣动扳机…"
                },
                {
                    "id": "675660305",
                    "speaker": "卢戈夫斯科",
                    "text": "它就会吃掉我，就像那句谚语…「猎杀熊的猎人最后总会被熊杀死。」"
                }
            ]
        },
        {
            "talkId": "6756604",
            "initDialog": "675660401",
            "dialogues": [
                {
                    "id": "675660401",
                    "speaker": "Player",
                    "text": "再见！"
                },
                {
                    "id": "675660402",
                    "speaker": "卢戈夫斯科",
                    "text": "再见，小心，别踩到那家伙的爪子…"
                }
            ]
        },
        {
