{
    "groupId": "7068",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "泽兹米尔": 9,
        "雅珂达": 3
    },
    "talks": [
        {
            "talkId": "6706801",
            "initDialog": "670680101",
            "dialogues": [
                {
                    "id": "670680101",
                    "speaker": "泽兹米尔",
                    "text": "嗯…还是买绵驮兽吧！驮运到至冬去还能顺便卖点儿毛。"
                }
            ]
        },
        {
            "talkId": "6706802",
            "initDialog": "670680201",
            "dialogues": [
                {
                    "id": "670680201",
                    "speaker": "Player",
                    "text": "那样的话绵驮兽会冷吧？"
                },
                {
                    "id": "670680202",
                    "speaker": "泽兹米尔",
                    "text": "嘶…有道理。如果在纳塔都会长出像这样又软又密的卷毛，跑到至冬却被剃光了的话…大概会感冒的。"
                },
                {
                    "id": "670680203",
                    "speaker": "泽兹米尔",
                    "text": "要是在路上病倒了，损失可就大了！这么看来果然还是买骆骆驮兽比较好嘛…好难选！"
                }
            ]
        },
        {
            "talkId": "6706803",
            "initDialog": "670680301",
            "dialogues": [
                {
                    "id": "670680301",
                    "speaker": "Player",
                    "text": "请慢慢挑…"
                },
                {
                    "id": "670680302",
                    "speaker": "泽兹米尔",
                    "text": "好吧。到底是买骆骆驮兽还是绵驮兽呢…本来还想听听你的意见的。"
                }
            ]
        },
        {
            "talkId": "6706804",
            "initDialog": "670680401",
            "dialogues": [
                {
                    "id": "670680401",
                    "speaker": "Player",
                    "text": "也可以选择不剃毛的…"
                },
                {
                    "id": "670680402",
                    "speaker": "泽兹米尔",
                    "text": "嘶…有道理。不剃毛的话，驮运的路上可以埋进绵绵软软的绒毛里，说不定还可以省下一件冬衣…"
                },
                {
                    "id": "670680403",
                    "speaker": "泽兹米尔",
                    "text": "骆骆驮兽能驮运的物资会比绵驮兽多一些。那这件冬衣的成本或许很快就可以赚回来？果然还是各有各的好啊…太难了！"
                }
            ]
        },
        {
            "talkId": "6706805",
            "initDialog": "670680501",
            "dialogues": [
                {
                    "id": "670680501",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>雅珂达</color>似乎有所思考…）"
                },
                {
                    "id": "670680502",
                    "speaker": "泽兹米尔",
                    "text": "雅珂达小姐！我上次拜托您这边找的那条近路，您有头绪了吗？"
                },
                {
                    "id": "670680503",
                    "speaker": "雅珂达",
                    "text": "没呢没呢，这事情很复杂，不是一时半会能解决的。"
                },
                {
                    "id": "670680504",
                    "speaker": "雅珂达",
                    "text": "（嘁，有这种情报，我还能交给你？早就自己拿着发财去了…）"
                },
                {
                    "id": "670680505",
                    "speaker": "雅珂达",
                    "text": "（呃，不对不对，是和奈姐一起发财，还有阿舍鲁！）"
                },
                {
                    "id": "670680506",
                    "speaker": "泽兹米尔",
                    "text": "好吧，那就拜托您了，一定要找到啊！"
                },
                {
                    "id": "670680507",
                    "speaker": "泽兹米尔",
                    "text": "只要找到这条近路，我一定能赚一大笔…"
                }
            ]
        }
    ]
}