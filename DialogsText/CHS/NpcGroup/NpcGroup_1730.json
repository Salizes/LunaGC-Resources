{
    "groupId": "1730",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "温柔的守卫": 6
    },
    "talks": [
        {
            "talkId": "7907902",
            "initDialog": "790790201",
            "dialogues": [
                {
                    "id": "790790201",
                    "speaker": "温柔的守卫",
                    "text": "星空下的王城，瑰丽壮阔…悬星摇曳、海水静谧…"
                },
                {
                    "id": "790790202",
                    "speaker": "温柔的守卫",
                    "text": "这里早晨会传来一声声发条拧紧的音响，夜晚会飘来一阵阵植物油混合着木屑的清香…"
                },
                {
                    "id": "790790203",
                    "speaker": "温柔的守卫",
                    "text": "每当我感受到这些的时候，都会觉得这个世界是如此美好，幸福得像一页故事…"
                },
                {
                    "id": "790790204",
                    "speaker": "温柔的守卫",
                    "text": "…旅者啊，你会记得这片星空下发生的故事吗？",
                    "choices": [
                        {
                            "id": "790790205",
                            "text": "可能吧…",
                            "response": [
                                {
                                    "id": "790790207",
                                    "speaker": "温柔的守卫",
                                    "text": "没关系，至少星空会记得。我也会记得。"
                                }
                            ]
                        },
                        {
                            "id": "790790206",
                            "text": "一定会的。",
                            "response": [
                                {
                                    "id": "790790208",
                                    "speaker": "温柔的守卫",
                                    "text": "哈哈…希望你回想起这片星空时，也能感受到那份恬静的幸福。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}