{
    "groupId": "7460",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "奥克佳布里斯卡娅": 10
    },
    "talks": [
        {
            "talkId": "6746001",
            "initDialog": "674600101",
            "dialogues": [
                {
                    "id": "674600101",
                    "speaker": "奥克佳布里斯卡娅",
                    "text": "前来就诊的朋友们，请提前登记简要病况…"
                }
            ]
        },
        {
            "talkId": "6746002",
            "initDialog": "674600201",
            "dialogues": [
                {
                    "id": "674600201",
                    "speaker": "Player",
                    "text": "你是医生？"
                },
                {
                    "id": "674600202",
                    "speaker": "奥克佳布里斯卡娅",
                    "text": "算半个，我的本职是战斗军医。"
                },
                {
                    "id": "674600203",
                    "speaker": "奥克佳布里斯卡娅",
                    "text": "现在大家都在节衣缩食，能省就省。"
                },
                {
                    "id": "674600204",
                    "speaker": "奥克佳布里斯卡娅",
                    "text": "我们没任务的时候，也会帮市民们看病，为市民们提供更充足的医疗服务。"
                },
                {
                    "id": "674600205",
                    "speaker": "奥克佳布里斯卡娅",
                    "text": "不过，每周只有固定的时间才开放面对市民的医疗服务，请别记错了时间。"
                }
            ]
        },
        {
            "talkId": "6746003",
            "initDialog": "674600301",
            "dialogues": [
                {
                    "id": "674600301",
                    "speaker": "Player",
                    "text": "如果手脚发酸，头晕脖子僵呢…"
                },
                {
                    "id": "674600302",
                    "speaker": "奥克佳布里斯卡娅",
                    "text": "不是明显的皮外伤啊，也没有发烧之类的症状？"
                },
                {
                    "id": "674600303",
                    "speaker": "奥克佳布里斯卡娅",
                    "text": "目前我这里设备有限，以治疗外伤和感冒为主。我建议你移步专门的诊疗机构，做更全面的检查。"
                },
                {
                    "id": "674600304",
                    "speaker": "奥克佳布里斯卡娅",
                    "text": "你所说的，也有可能是过度劳累，或坐姿不当引发的恶果。"
                },
                {
                    "id": "674600305",
                    "speaker": "奥克佳布里斯卡娅",
                    "text": "过量压力和不良习惯都有可能导致身体不适…请你千万注意，谨慎对待！"
                }
            ]
        },
        {
            "talkId": "6746004",
            "initDialog": "674600401",
            "dialogues": [
                {
                    "id": "674600401",
                    "speaker": "Player",
                    "text": "我没事，不用看病。"
                },
                {
                    "id": "674600402",
                    "speaker": "奥克佳布里斯卡娅",
                    "text": "很好，那你要争取一直保持健康。"
                }
            ]
        }
    ]
}