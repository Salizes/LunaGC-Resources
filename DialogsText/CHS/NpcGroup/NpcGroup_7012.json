    "talks": [
        {
            "talkId": "6701201",
            "initDialog": "670120101",
            "dialogues": [
                {
                    "id": "670120101",
                    "speaker": "勒塞克",
                    "text": "赏金多少没有商量的余地。"
                }
            ]
        },
        {
            "talkId": "6701202",
            "initDialog": "670120201",
            "dialogues": [
                {
                    "id": "670120201",
                    "speaker": "Player",
                    "text": "关于悬赏目标…"
                },
                {
                    "id": "670120202",
                    "speaker": "勒塞克",
                    "text": "「裂颚」哈尔克。数月之前在空寂走廊附近有人目击到他，但自那之后再也没有他的消息。或许在什么地方潜伏起来了。"
                },
                {
                    "id": "670120203",
                    "speaker": "勒塞克",
                    "text": "目前让他伏法的希望不大，除非有更多情报。"
                }
            ]
        },
        {
            "talkId": "6701203",
            "initDialog": "670120301",
            "dialogues": [
                {
                    "id": "670120301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670120302",
                    "speaker": "勒塞克",
                    "text": "不送。"
                }
            ]
        },
        {
            "talkId": "6701204",
            "initDialog": "670120401",
            "dialogues": [
                {
                    "id": "670120401",
                    "speaker": "Player",
                    "text": "关于悬赏目标…"
                },
                {
                    "id": "670120402",
                    "speaker": "勒塞克",
                    "text": "先前的目标都已经被解决了，现在还没有新的悬赏，再耐心等等吧。"
                },
                {
                    "id": "670120403",
                    "speaker": "勒塞克",
                    "text": "话虽如此，若是从此以后再也没有悬赏，倒也算是好事。悬赏的目的原本便是震慑那些凶犯，能实现自然再好不过。"
                }
            ]
        }
    ]
}