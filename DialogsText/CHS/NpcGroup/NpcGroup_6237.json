{
    "groupId": "6237",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 3,
        "穆基": 14
    },
    "talks": [
        {
            "talkId": "6623701",
            "initDialog": "662370101",
            "dialogues": [
                {
                    "id": "662370101",
                    "speaker": "穆基",
                    "text": "是不是该做些新的龙哨了…"
                }
            ]
        },
        {
            "talkId": "6623702",
            "initDialog": "662370201",
            "dialogues": [
                {
                    "id": "662370201",
                    "speaker": "Player",
                    "text": "龙哨？"
                },
                {
                    "id": "662370202",
                    "speaker": "穆基",
                    "text": "是一种用于人和龙之间沟通的乐器的统称。"
                },
                {
                    "id": "662370203",
                    "speaker": "穆基",
                    "text": "它们没有统一的样式，全看使用者和龙们的喜好。"
                },
                {
                    "id": "662370204",
                    "speaker": "穆基",
                    "text": "只要能用来交流，无论是口琴、哨子，还是什么别的发声装置，只要使用者管它叫龙哨，那它就是龙哨。"
                },
                {
                    "id": "662370205",
                    "speaker": "穆基",
                    "text": "部族里一直有新的幼龙出生，我在想，是不是得提前做些准备。"
                },
                {
                    "id": "662370206",
                    "speaker": "穆基",
                    "text": "又或者，等龙们长大一些，让它们自己选择喜欢的声音也行。"
                }
            ]
        },
        {
            "talkId": "6623703",
            "initDialog": "662370301",
            "dialogues": [
                {
                    "id": "662370301",
                    "speaker": "Player",
                    "text": "绒翼龙们都还好吗？"
                },
                {
                    "id": "662370302",
                    "speaker": "穆基",
                    "text": "多谢关心，它们有时比人要坚强多了。"
                },
                {
                    "id": "662370303",
                    "speaker": "穆基",
                    "text": "绒翼龙是非常高傲的龙，所以它们就更不会忘记自己做出的决定。"
                },
                {
                    "id": "662370304",
                    "speaker": "穆基",
                    "text": "只要还能展翅飞到天上，绒翼龙就不会丢下它们承认过的人类同伴。"
                },
                {
                    "id": "662370305",
                    "speaker": "穆基",
                    "text": "花羽会就是这样靠着人和龙的合作留存至今的，这一点在今后也不会发生改变。"
                }
            ]
        },
        {
            "talkId": "6623704",
            "initDialog": "662370401",
            "dialogues": [
                {
                    "id": "662370401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "662370402",
                    "speaker": "穆基",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6623705",
            "initDialog": "662370501",
            "dialogues": [
                {
                    "id": "662370501",
                    "speaker": "穆基",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6623706",
            "initDialog": "662370601",
            "dialogues": [
                {
                    "id": "662370601",
                    "speaker": "穆基",
                    "text": "我赢了，多谢指教。"
                }
            ]
        },
        {
            "talkId": "6623707",
            "initDialog": "662370701",
            "dialogues": [
                {
                    "id": "662370701",
                    "speaker": "穆基",
                    "text": "我输了，看来我尚未获得牌组的认可。"
                }
            ]
        }
    ]
}