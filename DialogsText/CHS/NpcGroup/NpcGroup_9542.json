        },
        {
            "talkId": "6954212",
            "initDialog": "695421201",
            "dialogues": [
                {
                    "id": "695421201",
                    "speaker": "坎蒂丝",
                    "text": "偶尔来几局这样的游戏，应该不会耽误正事。"
