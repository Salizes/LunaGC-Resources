{
    "groupId": "4126",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "罗莎娜": 11
    },
    "talks": [
        {
            "talkId": "6412601",
            "initDialog": "641260101",
            "dialogues": [
                {
                    "id": "641260101",
                    "speaker": "罗莎娜",
                    "text": "想喝东西？跟酒保说吧。"
                }
            ]
        },
        {
            "talkId": "6412602",
            "initDialog": "641260201",
            "dialogues": [
                {
                    "id": "641260201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641260202",
                    "speaker": "罗莎娜",
                    "text": "如你所见，是个店员。"
                },
                {
                    "id": "641260203",
                    "speaker": "罗莎娜",
                    "text": "不过我既不会调酒，也不会招呼客人。"
                },
                {
                    "id": "641260204",
                    "speaker": "罗莎娜",
                    "text": "毕竟，这里不是还有酒保和娜斯米儿吗。娜斯米儿一个人就能把事情做得七七八八了。"
                },
                {
                    "id": "641260205",
                    "speaker": "罗莎娜",
                    "text": "酒保…其实就是这个饭店的老板啦。"
                },
                {
                    "id": "641260206",
                    "speaker": "罗莎娜",
                    "text": "老板最怕的就是得罪客人，所以无论你提什么要求，他都会满足的。"
                }
            ]
        },
        {
            "talkId": "6412603",
            "initDialog": "641260301",
            "dialogues": [
                {
                    "id": "641260301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641260302",
                    "speaker": "罗莎娜",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6412604",
            "initDialog": "641260401",
            "dialogues": [
                {
                    "id": "641260401",
                    "speaker": "Player",
                    "text": "你不喜欢这的工作吗？"
                },
                {
                    "id": "641260402",
                    "speaker": "罗莎娜",
                    "text": "谈不上喜欢，也不讨厌吧。"
                },
                {
                    "id": "641260403",
                    "speaker": "罗莎娜",
                    "text": "整体来说，比以前在镀金旅团的日子要好，因为不用和那些死板的学者们打交道。"
                },
                {
                    "id": "641260404",
                    "speaker": "罗莎娜",
                    "text": "哈，说来好笑，就连酒的力量都比知识要强大。"
                },
                {
                    "id": "641260405",
                    "speaker": "罗莎娜",
                    "text": "不信你看，在酒的面前，那些学者们也都抛弃条条框框了。"
                }
            ]
        }
    ]
}