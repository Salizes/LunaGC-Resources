{
    "groupId": "2454",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "东升": 13
    },
    "talks": [
        {
            "talkId": "6245401",
            "initDialog": "624540101",
            "dialogues": [
                {
                    "id": "624540101",
                    "speaker": "东升",
                    "text": "客官您好，欢迎光临「荣发商铺」，今日可是想买些什么？"
                }
            ]
        },
        {
            "talkId": "6245402",
            "initDialog": "624540201",
            "dialogues": [
                {
                    "id": "624540201",
                    "speaker": "Player",
                    "text": "我想买些东西。"
                },
                {
                    "id": "624540202",
                    "speaker": "东升",
                    "text": "来，这边请，您随便挑。"
                }
            ]
        },
        {
            "talkId": "6245403",
            "initDialog": "624540301",
            "dialogues": [
                {
                    "id": "624540301",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "624540302",
                    "speaker": "东升",
                    "text": "不过是个卖日用品的小铺子…店名有些特殊，我是想纪念一下过去的经历。"
                },
                {
                    "id": "624540303",
                    "speaker": "东升",
                    "text": "客官可有兴趣听一听这店名的来历？"
                }
            ]
        },
        {
            "talkId": "6245404",
            "initDialog": "624540401",
            "dialogues": [
                {
                    "id": "624540401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624540402",
                    "speaker": "东升",
                    "text": "嗯，客官慢走，以后常来啊。"
                }
            ]
        },
        {
            "talkId": "6245405",
            "initDialog": "624540501",
            "dialogues": [
                {
                    "id": "624540501",
                    "speaker": "Player",
                    "text": "请和我讲讲吧。"
                },
                {
                    "id": "624540502",
                    "speaker": "东升",
                    "text": "我曾是个冒险家，五湖四海哪里都闯荡过。"
                },
                {
                    "id": "624540503",
                    "speaker": "东升",
                    "text": "…可惜好景不长，有一次在荻花洲冒险时我遭遇了意外，身负重伤…"
                },
                {
                    "id": "624540504",
                    "speaker": "东升",
                    "text": "所幸，一位戴着面具的仙人出手相救，我这才勉强捡回了一条命。"
                },
                {
                    "id": "624540505",
                    "speaker": "东升",
                    "text": "自那之后我就不再冒险了。这条命可以说是仙人赐给我的，可不能那么轻易就丢了。"
                },
                {
                    "id": "624540506",
                    "speaker": "东升",
                    "text": "璃月古语云「枯木发荣」，意为重获新生，这与我的经历一样…"
                },
                {
                    "id": "624540507",
                    "speaker": "东升",
                    "text": "因此我就取了后两个字作为我的店名，来纪念我这段经历。"
                }
            ]
        },
        {
            "talkId": "6245406",
            "initDialog": "624540601",
            "dialogues": [
                {
                    "id": "624540601",
                    "speaker": "Player",
                    "text": "不好意思，我还有事。"
                },
                {
                    "id": "624540602",
                    "speaker": "东升",
                    "text": "也好，过去的事了，不提也罢…"
                },
                {
                    "id": "624540603",
                    "speaker": "东升",
                    "text": "…平平淡淡才是真啊。"
                }
            ]
        }
    ]
}