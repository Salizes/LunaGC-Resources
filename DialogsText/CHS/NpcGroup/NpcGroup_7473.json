    "talks": [
        {
            "talkId": "6747101",
            "initDialog": "674710101",
            "dialogues": [
                {
                    "id": "674710101",
                    "speaker": "安德烈维奇",
                    "text": "准备好出发了吗，我的好宝贝，这次我们一家人可以去海屑镇好好玩一玩，听说那边有家烧烤特别好吃…"
                },
                {
                    "id": "674710102",
                    "speaker": "茨韦特科夫",
                    "text": "好耶，我还要坐雪橇，听说那边还有雪地犬拉雪橇。"
                },
                {
                    "id": "674710103",
                    "speaker": "柳廖娜",
                    "text": "好的我的宝贝，我们这下总算能一起好好休息几天了…"
                },
                {
                    "id": "674710104",
                    "speaker": "安德烈维奇",
                    "text": "是啊…"
                },
                {
                    "id": "674710105",
                    "speaker": "茨韦特科夫",
                    "text": "这次爸爸不会…又玩到一半，就因为「能源协会出事了！」跑回来吧…"
                },
                {
                    "id": "674710106",
                    "speaker": "安德烈维奇",
                    "text": "不会的，上次…唉，上次是因为特殊原因。这次绝对不会这样，爸爸向你保证，好吗？"
                }
            ]
        }
    ]
}