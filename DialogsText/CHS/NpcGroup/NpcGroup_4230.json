{
    "groupId": "4230",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 8,
        "兰玛尼": 14
    },
    "talks": [
        {
            "talkId": "6423001",
            "initDialog": "642300101",
            "dialogues": [
                {
                    "id": "642300101",
                    "speaker": "兰玛尼",
                    "text": "都是「精选货物」，快来看一看吧，「物美价廉」，「欲购从速」！"
                }
            ]
        },
        {
            "talkId": "6423002",
            "initDialog": "642300201",
            "dialogues": [
                {
                    "id": "642300201",
                    "speaker": "Player",
                    "text": "来点兰那罗特产。"
                },
                {
                    "id": "642300202",
                    "speaker": "兰玛尼",
                    "text": "「特产」？不明白…但是有「精选货物」。"
                }
            ]
        },
        {
            "talkId": "6423003",
            "initDialog": "642300301",
            "dialogues": [
                {
                    "id": "642300301",
                    "speaker": "Player",
                    "text": "兰那罗…商人？"
                },
                {
                    "id": "642300302",
                    "speaker": "兰玛尼",
                    "text": "咦…为什么那菈朋友的表情这么奇怪？"
                },
                {
                    "id": "642300303",
                    "speaker": "兰玛尼",
                    "text": "那菈商人就是这么说话的呢…"
                },
                {
                    "id": "642300304",
                    "speaker": "兰玛尼",
                    "text": "还是说，这里不可以「欲购从速」？"
                },
                {
                    "id": "642300305",
                    "speaker": "兰玛尼",
                    "text": "不明白，那菈商人，说话太奇怪。"
                }
            ]
        },
        {
            "talkId": "6423004",
            "initDialog": "642300401",
            "dialogues": [
                {
                    "id": "642300401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642300402",
                    "speaker": "兰玛尼",
                    "text": "再见，那菈朋友。「欢迎您下次光临」？"
                }
            ]
        },
        {
            "talkId": "6423005",
            "initDialog": "642300501",
            "dialogues": [
                {
                    "id": "642300501",
                    "speaker": "兰玛尼",
                    "text": "无忧节「赚」了「盆满钵满」，还想要更多的快乐，所以下一步…"
                }
            ]
        },
        {
            "talkId": "6423006",
            "initDialog": "642300601",
            "dialogues": [
                {
                    "id": "642300601",
                    "speaker": "Player",
                    "text": "来点精选货物。"
                },
                {
                    "id": "642300602",
                    "speaker": "兰玛尼",
                    "text": "现在不叫「精选货物」了，现在兰玛尼卖的是「特产」。"
                }
            ]
        },
        {
            "talkId": "6423008",
            "initDialog": "642300801",
            "dialogues": [
                {
                    "id": "642300801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642300802",
                    "speaker": "兰玛尼",
                    "text": "再见，那菈朋友。希望你也「盆满钵满」。"
                }
            ]
        },
        {
            "talkId": "6423009",
            "initDialog": "642300901",
            "dialogues": [
                {
                    "id": "642300901",
                    "speaker": "兰玛尼",
                    "text": "节日！快活！「客人」很多，可以「大卖」，「走过路过，千万不要错过」！"
                }
            ]
        },
        {
            "talkId": "6423010",
            "initDialog": "642301001",
            "dialogues": [
                {
                    "id": "642301001",
                    "speaker": "Player",
                    "text": "有什么卖的东西？"
                },
                {
                    "id": "642301002",
                    "speaker": "兰玛尼",
                    "text": "现在最「大卖」的是无忧节的快乐！那菈朋友，要快乐吗？"
                }
            ]
        },
        {
            "talkId": "6423011",
            "initDialog": "642301101",
            "dialogues": [
                {
                    "id": "642301101",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642301102",
                    "speaker": "兰玛尼",
                    "text": "再见，那菈朋友。希望你快乐多多，能「大卖」！"
                }
            ]
        },
        {
            "talkId": "6423012",
            "initDialog": "642301201",
            "dialogues": [
                {
                    "id": "642301201",
                    "speaker": "Player",
                    "text": "「快乐」是什么？"
                },
                {
                    "id": "642301202",
                    "speaker": "兰玛尼",
                    "text": "「快乐」看不见，摸不着，但充满了无忧节的桓那兰那…我明白了，快乐是那菈朋友带来的！"
                }
            ]
        }
    ]
}