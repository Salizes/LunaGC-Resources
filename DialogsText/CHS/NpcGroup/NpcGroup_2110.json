{
    "groupId": "2110",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "醉今朝": 12
    },
    "talks": [
        {
            "talkId": "7194101",
            "initDialog": "719410101",
            "dialogues": [
                {
                    "id": "719410101",
                    "speaker": "Player",
                    "text": "你的饰品上…有血迹？"
                },
                {
                    "id": "719410102",
                    "speaker": "醉今朝",
                    "text": "血？嗝…你不说我还没注意到。"
                },
                {
                    "id": "719410103",
                    "speaker": "醉今朝",
                    "text": "没想到那个人的东西我居然忘记处理掉了…"
                },
                {
                    "id": "719410104",
                    "speaker": "醉今朝",
                    "text": "…你就拿走吧，如此一来，我与那个人的恩怨才能彻底了断。"
                },
                {
                    "id": "719410105",
                    "speaker": "醉今朝",
                    "text": "对现在的我来说什么都比不上一壶浊酒来的重要，哈哈哈哈…"
                }
            ]
        },
        {
            "talkId": "6211001",
            "initDialog": "621100101",
            "dialogues": [
                {
                    "id": "621100101",
                    "speaker": "醉今朝",
                    "text": "醉生…梦死…"
                },
                {
                    "id": "621100102",
                    "speaker": "醉今朝",
                    "text": "这种日子真是…嗝，看不到尽头啊…"
                }
            ]
        },
        {
            "talkId": "6211002",
            "initDialog": "621100201",
            "dialogues": [
                {
                    "id": "621100201",
                    "speaker": "Player",
                    "text": "你喝醉了？"
                },
                {
                    "id": "621100202",
                    "speaker": "醉今朝",
                    "text": "你…你想说我是醉鬼？哈哈哈…嗝，那还真是抬举我了。"
                },
                {
                    "id": "621100203",
                    "speaker": "醉今朝",
                    "text": "…我不过是个剑客…剑客就是除了舞枪弄棒外，什么本事都没有的废物罢了…"
                },
                {
                    "id": "621100204",
                    "speaker": "醉今朝",
                    "text": "每、每天不是被别人追杀，就是杀别人，这种日子…还不如醉死了之。"
                }
            ]
        },
        {
            "talkId": "6211003",
            "initDialog": "621100301",
            "dialogues": [
                {
                    "id": "621100301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621100302",
                    "speaker": "醉今朝",
                    "text": "…和我就别说再见了。"
                },
                {
                    "id": "621100303",
                    "speaker": "醉今朝",
                    "text": "等到了晚上，我就又要回到那个打打杀杀的世界去了…嗝…"
                },
                {
                    "id": "621100304",
                    "speaker": "醉今朝",
                    "text": "很可能明天你就再也见不到我了，哈哈哈哈…"
                }
            ]
        }
    ]
}