{
    "groupId": "7453",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "阿芙蕾莉亚": 12
    },
    "talks": [
        {
            "talkId": "6745301",
            "initDialog": "674530101",
            "dialogues": [
                {
                    "id": "674530101",
                    "speaker": "阿芙蕾莉亚",
                    "text": "罗捷那家伙，又跑到什么地方去鬼混了…啊，您好，外乡人。请问有什么我能效劳的吗？"
                }
            ]
        },
        {
            "talkId": "6745302",
            "initDialog": "674530201",
            "dialogues": [
                {
                    "id": "674530201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "674530202",
                    "speaker": "阿芙蕾莉亚",
                    "text": "冬契军卫官阿芙蕾莉亚，向您问候。我正在执行巡视与监督的任务。"
                },
                {
                    "id": "674530203",
                    "speaker": "阿芙蕾莉亚",
                    "text": "如果您遇到了麻烦，比如遭到了某些行事粗暴之人的刁难，尽可以向我求助。"
                },
                {
                    "id": "674530204",
                    "speaker": "阿芙蕾莉亚",
                    "text": "作为陛下最忠诚的剑与盾，冬契军绝不会坐视不管。这也是为了维护至冬的体面——毕竟，愚人众的同僚们可从不在乎这些。"
                }
            ]
        },
        {
            "talkId": "6745303",
            "initDialog": "674530301",
            "dialogues": [
                {
                    "id": "674530301",
                    "speaker": "Player",
                    "text": "罗捷？"
                },
                {
                    "id": "674530302",
                    "speaker": "阿芙蕾莉亚",
                    "text": "唉…让您见笑了。罗捷丹斯基准尉是我的未…呃，从小就相识的朋友。"
                },
                {
                    "id": "674530303",
                    "speaker": "阿芙蕾莉亚",
                    "text": "分明是贵族出身，还凭借天赋加入了冬契军，却一天到晚不务正业、毫无纪律、游手好闲…！"
                },
                {
                    "id": "674530304",
                    "speaker": "阿芙蕾莉亚",
                    "text": "只要视线稍稍离开一会儿，他就能惹出让人头疼的乱子来！不是去和年轻的姑娘搭讪，就是跑去跟城外那群家伙喝酒…"
                },
                {
                    "id": "674530305",
                    "speaker": "阿芙蕾莉亚",
                    "text": "要是我不时刻盯着他，都不知道他能把军纪败坏成什么样子…！"
                },
                {
                    "id": "674530306",
                    "speaker": "阿芙蕾莉亚",
                    "text": "啊…抱歉，我不该向您抱怨这些。请您权当没有听见吧。"
                }
            ]
        },
        {
            "talkId": "6745304",
            "initDialog": "674530401",
            "dialogues": [
                {
                    "id": "674530401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674530402",
                    "speaker": "阿芙蕾莉亚",
                    "text": "嗯，再见。如果遇到麻烦，请您随时来找我。"
                }
            ]
        },
        {
            "talkId": "6745305",
            "initDialog": "674530501",
            "dialogues": [
                {
                    "id": "674530501",
                    "speaker": "Player",
                    "text": "你对愚人众有意见？"
                },
                {
                    "id": "674530502",
                    "speaker": "阿芙蕾莉亚",
                    "text": "绝无此事。同为效命于陛下的仆从，自然应当同心协力。况且如今危机将临，何谈前怨。"
                },
                {
                    "id": "674530503",
                    "speaker": "阿芙蕾莉亚",
                    "text": "至于愚人众的同僚们是否明白这个道理，那就不是我能决定的了。如您所见，我只能约束自己，并且永远忠于陛下。"
                }
            ]
        }
    ]
}