{
    "groupId": "1599",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "莉莉": 8,
        "鲁道夫": 7
    },
    "talks": [
        {
            "talkId": "6159902",
            "initDialog": "615990201",
            "dialogues": [
                {
                    "id": "615990201",
                    "speaker": "莉莉",
                    "text": "把拔，那个蜀黍还会回来吗？"
                },
                {
                    "id": "615990202",
                    "speaker": "鲁道夫",
                    "text": "应该不会了吧。"
                },
                {
                    "id": "615990203",
                    "speaker": "莉莉",
                    "text": "把拔…那个驴人众蜀黍，真的是很坏很坏的人吗？"
                },
                {
                    "id": "615990204",
                    "speaker": "莉莉",
                    "text": "他给窝讲故事，也给我带了好多好次的…"
                },
                {
                    "id": "615990205",
                    "speaker": "莉莉",
                    "text": "窝觉得，坏人不是介样的…"
                },
                {
                    "id": "615990206",
                    "speaker": "鲁道夫",
                    "text": "莉莉…好人和坏人，不是这么简单就能分开的…"
                },
                {
                    "id": "615990207",
                    "speaker": "鲁道夫",
                    "text": "这是一件很复杂的事，等你再长大一些就明白了。"
                },
                {
                    "id": "615990208",
                    "speaker": "莉莉",
                    "text": "喔…"
                }
            ]
        },
        {
            "talkId": "6159901",
            "initDialog": "615990101",
            "dialogues": [
                {
                    "id": "615990101",
                    "speaker": "莉莉",
                    "text": "把拔，麻麻在桌什么？"
                },
                {
                    "id": "615990102",
                    "speaker": "鲁道夫",
                    "text": "妈妈是信仰巴巴托斯的修女，她会帮助和引导每一个同样信仰巴巴托斯的人。"
                },
                {
                    "id": "615990103",
                    "speaker": "莉莉",
                    "text": "把拔，把拔托斯是谁，他很厉害吗？"
                },
                {
                    "id": "615990104",
                    "speaker": "鲁道夫",
                    "text": "巴巴托斯是伟大的风神，当然厉害了。"
                },
                {
                    "id": "615990105",
                    "speaker": "鲁道夫",
                    "text": "莉莉能和爸爸妈妈过得这样幸福，多亏了巴巴托斯大人的守护。"
                },
                {
                    "id": "615990106",
                    "speaker": "莉莉",
                    "text": "把拔，可是，种么感觉那边的蜀黍在缩把拔托斯的坏话呀。"
                },
                {
                    "id": "615990107",
                    "speaker": "鲁道夫",
                    "text": "小孩子不可以听愚人众的叔叔讲话。"
                }
            ]
        }
    ]
}