{
    "groupId": "4408",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "阿提亚": 14
    },
    "talks": [
        {
            "talkId": "6440801",
            "initDialog": "644080101",
            "dialogues": [
                {
                    "id": "644080101",
                    "speaker": "阿提亚",
                    "text": "这位朋友请留步！一看你就身手不凡，有没有加入镀金旅团的打算？"
                }
            ]
        },
        {
            "talkId": "6440802",
            "initDialog": "644080201",
            "dialogues": [
                {
                    "id": "644080201",
                    "speaker": "Player",
                    "text": "有什么好处吗？"
                },
                {
                    "id": "644080202",
                    "speaker": "阿提亚",
                    "text": "多得是！"
                },
                {
                    "id": "644080203",
                    "speaker": "阿提亚",
                    "text": "首先，加入镀金旅团可是为数不多可以走出村子的办法之一。"
                },
                {
                    "id": "644080204",
                    "speaker": "阿提亚",
                    "text": "只要出了这个荒芜的小地方，世界就摆在你面前。稍微有点追求的年轻人，哪个不想去外边见见世面呢？"
                },
                {
                    "id": "644080205",
                    "speaker": "阿提亚",
                    "text": "而且别看团里都是沙漠人，我们可是会从住树上的家伙手里赚钱的！"
                },
                {
                    "id": "644080206",
                    "speaker": "阿提亚",
                    "text": "教令院是全须弥钱包最鼓的地方，他们付酬金从不讲价，也不拖欠。"
                },
                {
                    "id": "644080207",
                    "speaker": "阿提亚",
                    "text": "只要你接过一次这样的委托，就能发大财。"
                },
                {
                    "id": "644080208",
                    "speaker": "阿提亚",
                    "text": "这种赚钱的办法，你在别处可找不到的。"
                }
            ]
        },
        {
            "talkId": "6440803",
            "initDialog": "644080301",
            "dialogues": [
                {
                    "id": "644080301",
                    "speaker": "Player",
                    "text": "有别的差事。"
                },
                {
                    "id": "644080302",
                    "speaker": "阿提亚",
                    "text": "真的？还有比佣兵更好的工作吗？"
                },
                {
                    "id": "644080303",
                    "speaker": "阿提亚",
                    "text": "可惜了啊。等你回心转意了，再来找我吧？"
                }
            ]
        },
        {
            "talkId": "6440804",
            "initDialog": "644080401",
            "dialogues": [
                {
                    "id": "644080401",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6440805",
            "initDialog": "644080501",
            "dialogues": [
                {
                    "id": "644080501",
                    "speaker": "阿提亚",
                    "text": "嚯，我只是侥幸占了上风！请你不要介意啊！"
                }
            ]
        },
        {
            "talkId": "6440806",
            "initDialog": "644080601",
            "dialogues": [
                {
                    "id": "644080601",
                    "speaker": "阿提亚",
                    "text": "好强好强好强…这位朋友，像你这样的强者，在「镀金旅团」里肯定能找到更多对手，混得如鱼得水！"
                }
            ]
        },
        {
            "talkId": "7397301",
            "initDialog": "739730101",
            "dialogues": [
                {
                    "id": "739730101",
                    "speaker": "Player",
                    "text": "我考虑考虑。"
                },
                {
                    "id": "739730102",
                    "speaker": "阿提亚",
                    "text": "…除了我刚才说的那些以外，镀金旅团的伙食也是一绝哦！不信的话尝尝这个。"
                },
                {
                    "id": "739730103",
                    "speaker": "阿提亚",
                    "text": "我们旅团给同伴的待遇，无论从哪方面讲都没得挑。"
                }
            ]
        }
    ]
}