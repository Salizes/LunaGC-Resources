{
    "groupId": "7065",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "泽伊采娃": 7
    },
    "talks": [
        {
            "talkId": "5900271",
            "initDialog": "590027101",
            "dialogues": [
                {
                    "id": "590027101",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900272",
            "initDialog": "590027201",
            "dialogues": [
                {
                    "id": "590027201",
                    "speaker": "泽伊采娃",
                    "text": "值得留意的…我想想哦。今天的天气也很好，风吹着很舒服，远处的大海也很漂亮。像这样的景色，我觉得就很值得留意了呢。"
                }
            ]
        },
        {
            "talkId": "6706501",
            "initDialog": "670650101",
            "dialogues": [
                {
                    "id": "670650101",
                    "speaker": "泽伊采娃",
                    "text": "这才是艺术！真该拿去拍卖会上让那些老爷们瞧瞧…"
                }
            ]
        },
        {
            "talkId": "6706502",
            "initDialog": "670650201",
            "dialogues": [
                {
                    "id": "670650201",
                    "speaker": "Player",
                    "text": "我也觉得很棒！"
                },
                {
                    "id": "670650202",
                    "speaker": "泽伊采娃",
                    "text": "是吧！构图粗粝却精致，形式混乱却有秩序，爱诺用她独有的语法，重新定义了废弃之物的存在意义！"
                },
                {
                    "id": "670650203",
                    "speaker": "泽伊采娃",
                    "text": "唉，要是这个世界，是由我们这样的人掌控的就好了！可惜，都是些审美贫瘠的俗物大行其道…"
                }
            ]
        },
        {
            "talkId": "6706503",
            "initDialog": "670650301",
            "dialogues": [
                {
                    "id": "670650301",
                    "speaker": "Player",
                    "text": "唔，可能有些过于前卫了…"
                },
                {
                    "id": "670650302",
                    "speaker": "泽伊采娃",
                    "text": "…好吧，爱诺的作品本就不是为了取悦所有人的，就像我也懒得取悦随便哪个过路的人一样。再见！"
                }
            ]
        },
        {
            "talkId": "6706504",
            "initDialog": "670650401",
            "dialogues": [
                {
                    "id": "670650401",
                    "speaker": "Player",
                    "text": "倒也没有想掌控世界…"
                },
                {
                    "id": "670650402",
                    "speaker": "泽伊采娃",
                    "text": "我明白的。光是跟那些没品味的家伙解释「什么才是美」就很累了。"
                },
                {
                    "id": "670650403",
                    "speaker": "泽伊采娃",
                    "text": "要是爱诺的艺术真的被那种随大流的人追捧起来…啊，好可怕！真正的艺术，果然还是应该留给像我们这样的人悄悄欣赏才是。"
                }
            ]
        }
    ]
}