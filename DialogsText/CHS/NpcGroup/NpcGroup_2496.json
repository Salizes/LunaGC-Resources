{
    "groupId": "2496",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "莫妍": 18
    },
    "talks": [
        {
            "talkId": "6249601",
            "initDialog": "624960101",
            "dialogues": [
                {
                    "id": "624960101",
                    "speaker": "莫妍",
                    "text": "你好啊，远道而来的客人！如果你要去翘英庄，沿着这条路一直往北走就好了。"
                }
            ]
        },
        {
            "talkId": "6249602",
            "initDialog": "624960201",
            "dialogues": [
                {
                    "id": "624960201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "624960202",
                    "speaker": "莫妍",
                    "text": "我是莫妍，翘英庄的会计，有时也会帮庄里的父老乡亲们干点杂活。"
                },
                {
                    "id": "624960203",
                    "speaker": "莫妍",
                    "text": "庄里的商人经常路过这里，我每天都会向他们咨询经营的状况。"
                },
                {
                    "id": "624960204",
                    "speaker": "莫妍",
                    "text": "加上我每个月都会上门探访庄里的每户人家，对庄里的经济形势还算了解…"
                }
            ]
        },
        {
            "talkId": "6249603",
            "initDialog": "624960301",
            "dialogues": [
                {
                    "id": "624960301",
                    "speaker": "Player",
                    "text": "关于翘英庄…"
                },
                {
                    "id": "624960302",
                    "speaker": "莫妍",
                    "text": "这里就已经是翘英庄的地界了，欢迎来到闻名璃月的茶叶之乡！"
                },
                {
                    "id": "624960303",
                    "speaker": "莫妍",
                    "text": "翘英庄虽不如遗珑埠繁华，但气氛更清净、更悠闲。"
                },
                {
                    "id": "624960304",
                    "speaker": "莫妍",
                    "text": "如果你喜欢品茶，请务必试试本庄的松萝仙芽与游韵单丛，包你满意。"
                }
            ]
        },
        {
            "talkId": "6249604",
            "initDialog": "624960401",
            "dialogues": [
                {
                    "id": "624960401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624960402",
                    "speaker": "莫妍",
                    "text": "请慢走。"
                }
            ]
        },
        {
            "talkId": "6249605",
            "initDialog": "624960501",
            "dialogues": [
                {
                    "id": "624960501",
                    "speaker": "Player",
                    "text": "听起来很辛苦…"
                },
                {
                    "id": "624960502",
                    "speaker": "莫妍",
                    "text": "啊，谢谢客人关心！"
                },
                {
                    "id": "624960503",
                    "speaker": "莫妍",
                    "text": "其实这份差事不算累，庄里最累的还得是照看茶树、晒茶炒茶的茶农们，毕竟翘英庄的命脉就是茶叶…"
                },
                {
                    "id": "624960504",
                    "speaker": "莫妍",
                    "text": "茶农们起早贪黑，一年到头忙个没停，就是为了让各地的人们喝到实惠的好茶。"
                },
                {
                    "id": "624960505",
                    "speaker": "莫妍",
                    "text": "不过，我从来没听见他们抱怨过工作太苦太累。"
                },
                {
                    "id": "624960506",
                    "speaker": "莫妍",
                    "text": "他们热爱茶叶，每天都过得很充实，我的心态也被他们影响，大多时候都很积极！"
                }
            ]
        },
        {
            "talkId": "6249606",
            "initDialog": "624960601",
            "dialogues": [
                {
                    "id": "624960601",
                    "speaker": "Player",
                    "text": "最近情况如何呢？"
                },
                {
                    "id": "624960602",
                    "speaker": "莫妍",
                    "text": "这就说来话长了…"
                },
                {
                    "id": "624960603",
                    "speaker": "莫妍",
                    "text": "不知怎么，今年头茬茶叶有些泛黄，估计卖出去的价钱有点不妙。"
                },
                {
                    "id": "624960604",
                    "speaker": "莫妍",
                    "text": "庄子里大半的人都指望着茶叶糊口，这个问题还得快点解决才行…"
                }
            ]
        },
        {
            "talkId": "6249607",
            "initDialog": "624960701",
            "dialogues": [
                {
                    "id": "624960701",
                    "speaker": "Player",
                    "text": "关于收入…"
                },
                {
                    "id": "624960702",
                    "speaker": "莫妍",
                    "text": "还好还好，虽然头茬茶叶卖的不理想，但二茬多少正常了一些。"
                },
                {
                    "id": "624960703",
                    "speaker": "莫妍",
                    "text": "种茶叶难免会遇到歉收，但愿明年的收成会更好一些吧！"
                }
            ]
        }
    ]
}