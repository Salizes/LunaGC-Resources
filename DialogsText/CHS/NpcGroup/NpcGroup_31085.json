{
    "groupId": "31085",
    "total_dialogue_lines": 40,
    "speaker_counts": {
        "Player": 4,
        "夏沃蕾": 8,
        "昂吉安妮": 10,
        "蒂蕾娜": 18
    },
    "talks": [
        {
            "talkId": "7668307",
            "initDialog": "766830701",
            "dialogues": [
                {
                    "id": "766830701",
                    "speaker": "蒂蕾娜",
                    "text": "真的不再打一场了吗，教官？"
                },
                {
                    "id": "766830702",
                    "speaker": "昂吉安妮",
                    "text": "我已经打出最佳成绩了，你也看到了嘛，我有点打不动了，在花哨的新推演面前，只能勉强及格…"
                },
                {
                    "id": "766830703",
                    "speaker": "蒂蕾娜",
                    "text": "但及格线是夏沃蕾队长的成绩的六成呀！除了你，大家全都不及格了呀，哪有什么打不动…",
                    "choices": [
                        {
                            "id": "766830704",
                            "text": "（继续听听…）",
                            "response": [
                                {
                                    "id": "766830705",
                                    "speaker": "蒂蕾娜",
                                    "text": "你现在不打的话，以后就再也看不到你拿铳枪的样子了。"
                                },
                                {
                                    "id": "766830706",
                                    "speaker": "蒂蕾娜",
                                    "text": "我都完全没感觉，时间过得这么快…"
                                },
                                {
                                    "id": "766830707",
                                    "speaker": "蒂蕾娜",
                                    "text": "呜…呜呜…"
                                },
                                {
                                    "id": "766830708",
                                    "speaker": "昂吉安妮",
                                    "text": "哎？你这小妞，哭什么？"
                                },
                                {
                                    "id": "766830709",
                                    "speaker": "昂吉安妮",
                                    "text": "只是退役了而已，又不是再也不见面了！"
                                },
                                {
                                    "id": "766830710",
                                    "speaker": "昂吉安妮",
                                    "text": "想见我还不容易，找个店，每周请我吃顿饭。"
                                },
                                {
                                    "id": "766830711",
                                    "speaker": "蒂蕾娜",
                                    "text": "好好好，不止黄油汐藻，你想吃德波大饭店都行！"
                                },
                                {
                                    "id": "766830712",
                                    "speaker": "蒂蕾娜",
                                    "text": "但…不能每周…每个月一次吧？"
                                },
                                {
                                    "id": "766830713",
                                    "speaker": "昂吉安妮",
                                    "text": "无所谓啦，你安排什么，我都能接受。"
                                },
                                {
                                    "id": "766830714",
                                    "speaker": "昂吉安妮",
                                    "text": "不过，说正经的…以后我们这一拨的新人，全都交给你了。"
                                },
                                {
                                    "id": "766830715",
                                    "speaker": "昂吉安妮",
                                    "text": "要好好看住玛因和萝克珊，防止她们工作得太忘我。"
                                },
                                {
                                    "id": "766830716",
                                    "speaker": "昂吉安妮",
                                    "text": "也别让新人输给当年的你自己啊，但凡他们有一点怠惰，就狠狠踢他们的屁股！"
                                },
                                {
                                    "id": "766830717",
                                    "speaker": "蒂蕾娜",
                                    "text": "我会的！狠狠踢他们的屁股！"
                                },
                                {
                                    "id": "766830718",
                                    "speaker": "昂吉安妮",
                                    "text": "那好哦，我的妹妹们叫我去纳塔度假，可能之后有那么两个月不在枫丹…"
                                },
                                {
                                    "id": "766830719",
                                    "speaker": "昂吉安妮",
                                    "text": "度假一回来，我就要来检查你的成果！"
                                },
                                {
                                    "id": "766830720",
                                    "speaker": "蒂蕾娜",
                                    "text": "一定不会让你失望的，教官！"
                                }
                            ]
                        },
                        {
                            "id": "766830721",
                            "text": "（还是让她们单独聊吧…）"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7668403",
            "initDialog": "766840301",
            "dialogues": [
                {
                    "id": "766840301",
                    "speaker": "蒂蕾娜",
                    "text": "队长，你刚刚说的是认真的吗？",
                    "choices": [
                        {
                            "id": "766840302",
                            "text": "（继续听听看…）",
                            "response": [
                                {
                                    "id": "766840303",
                                    "speaker": "蒂蕾娜",
                                    "text": "我也要被绒翼龙抓着在天上飞吗？"
                                },
                                {
                                    "id": "766840304",
                                    "speaker": "夏沃蕾",
                                    "text": "对。"
                                },
                                {
                                    "id": "766840305",
                                    "speaker": "蒂蕾娜",
                                    "text": "我还要练习在天上操纵铳枪，在高速移动中射击地面的目标？"
                                },
                                {
                                    "id": "766840306",
                                    "speaker": "夏沃蕾",
                                    "text": "对。"
                                },
                                {
                                    "id": "766840307",
                                    "speaker": "蒂蕾娜",
                                    "text": "那…加薪吗？"
                                },
                                {
                                    "id": "766840308",
                                    "speaker": "夏沃蕾",
                                    "text": "加。"
                                },
                                {
                                    "id": "766840309",
                                    "speaker": "蒂蕾娜",
                                    "text": "我干！"
                                },
                                {
                                    "id": "766840310",
                                    "speaker": "蒂蕾娜",
                                    "text": "其实就算不加薪，我也会干。钱从来不是问题，特巡队员的尊严才是。"
                                },
                                {
                                    "id": "766840311",
                                    "speaker": "蒂蕾娜",
                                    "text": "「花羽会」的龙骑士们能做到，我也不想认输！"
                                },
                                {
                                    "id": "766840312",
                                    "speaker": "夏沃蕾",
                                    "text": "其实我知道，不加薪你也会答应，但我不想亏待任何一个队员。所以，除了加薪，还会有一系列额外保险措施和津贴。"
                                },
                                {
                                    "id": "766840313",
                                    "speaker": "夏沃蕾",
                                    "text": "为了保证你们拥有充足的体力，应对更恶劣的作战环境，我会给你们再增加针对性的体能训练。"
                                },
                                {
                                    "id": "766840314",
                                    "speaker": "夏沃蕾",
                                    "text": "先从十万步的负重跑开始吧。"
                                },
                                {
                                    "id": "766840315",
                                    "speaker": "蒂蕾娜",
                                    "text": "我…我跑，我一定好好跑。"
                                },
                                {
                                    "id": "766840316",
                                    "speaker": "蒂蕾娜",
                                    "text": "在天上挂着，确实很消耗体能吧？那这次的十万步，我就背五十单位的负重？"
                                },
                                {
                                    "id": "766840317",
                                    "speaker": "夏沃蕾",
                                    "text": "…我本来想说三十五单位的。"
                                },
                                {
                                    "id": "766840318",
                                    "speaker": "夏沃蕾",
                                    "text": "但你既然主动提出五十单位，那勒泰利埃也按这个标准来好了，然后再看看其他人承不承受得了。"
                                }
                            ]
                        },
                        {
                            "id": "766840319",
                            "text": "（还是不听了…）"
                        }
                    ]
                }
            ]
        }
    ]
}