{
    "groupId": "9604",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "塔利雅": 10
    },
    "talks": [
        {
            "talkId": "6960401",
            "initDialog": "696040101",
            "dialogues": [
                {
                    "id": "696040101",
                    "speaker": "塔利雅",
                    "text": "#你好，{NICKNAME}，看你的架势，是想要和我来一局「七圣召唤」？啊，放心，我不会拜托咱们的风神帮忙抓牌的，毕竟这里窗户关得严严实实，一丝风也透不进来啊。"
                }
            ]
        },
        {
            "talkId": "6960402",
            "initDialog": "696040201",
            "dialogues": [
                {
                    "id": "696040201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960403",
            "initDialog": "696040301",
            "dialogues": [
                {
                    "id": "696040301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "696040302",
                    "speaker": "塔利雅",
                    "text": "要走了？嗯，我也差不多该出去了。这地方不通风，也该出去聆听一下风的声音了，总不能让某人一直找不着我吧。"
                }
            ]
        },
        {
            "talkId": "6960404",
            "initDialog": "696040401",
            "dialogues": [
                {
                    "id": "696040401",
                    "speaker": "塔利雅",
                    "text": "我赢了。嗯…等我下次再组牌的时候，一定还得敞开窗户，让我们的风神可以用风来帮我选牌。嗯，风神保佑。"
                }
            ]
        },
        {
            "talkId": "6960405",
            "initDialog": "696040501",
            "dialogues": [
                {
                    "id": "696040501",
                    "speaker": "塔利雅",
                    "text": "厉害，如果有打牌之神的话，你肯定是他唯一的传道者。"
                }
            ]
        },
        {
            "talkId": "6960406",
            "initDialog": "696040601",
            "dialogues": [
                {
                    "id": "696040601",
                    "speaker": "塔利雅",
                    "text": "「七圣召唤」？当然可以！说不定我们还能顺便聆听一下周围牌友们的烦恼呢。风神保佑他们，愿他们多抽几张好牌。"
                }
            ]
        },
        {
            "talkId": "6960408",
            "initDialog": "696040801",
            "dialogues": [
                {
                    "id": "696040801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960409",
            "initDialog": "696040901",
            "dialogues": [
                {
                    "id": "696040901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960410",
            "initDialog": "696041001",
            "dialogues": [
                {
                    "id": "696041001",
                    "speaker": "塔利雅",
                    "text": "我赢了。真是一场收获颇丰的对局。"
                }
            ]
        },
        {
            "talkId": "6960411",
            "initDialog": "696041101",
            "dialogues": [
                {
                    "id": "696041101",
                    "speaker": "塔利雅",
                    "text": "哎呀，我竟然输了吗？看来打牌果然不能随便分心呢。"
                }
            ]
        },
        {
            "talkId": "6960412",
            "initDialog": "696041201",
            "dialogues": [
                {
                    "id": "696041201",
                    "speaker": "塔利雅",
                    "text": "想要跟我全力对战？哈哈，好啊，正愁有点无聊了呢。凭你的实力，我相信这场对局一定会变得有趣起来吧？"
                }
            ]
        },
        {
            "talkId": "6960414",
            "initDialog": "696041401",
            "dialogues": [
                {
                    "id": "696041401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960415",
            "initDialog": "696041501",
            "dialogues": [
                {
                    "id": "696041501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960416",
            "initDialog": "696041601",
            "dialogues": [
                {
                    "id": "696041601",
                    "speaker": "塔利雅",
                    "text": "呼…差一点就输了。你真是一个不可小觑的对手啊。"
                }
            ]
        },
        {
            "talkId": "6960417",
            "initDialog": "696041701",
            "dialogues": [
                {
                    "id": "696041701",
                    "speaker": "塔利雅",
                    "text": "不错啊，很有意思的出牌方式。不愧是我的好搭子，每次都能帮我找到新鲜事。"
                }
            ]
        },
        {
            "talkId": "6960418",
            "initDialog": "696041801",
            "dialogues": [
                {
                    "id": "696041801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}