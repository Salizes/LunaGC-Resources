{
    "groupId": "2480",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "笃勤": 13
    },
    "talks": [
        {
            "talkId": "6248001",
            "initDialog": "624800101",
            "dialogues": [
                {
                    "id": "624800101",
                    "speaker": "笃勤",
                    "text": "客人需要帮工吗？按时辰计费，价格好说，我们能提供大量「城内镖师」的人力支援。"
                }
            ]
        },
        {
            "talkId": "6248002",
            "initDialog": "624800201",
            "dialogues": [
                {
                    "id": "624800201",
                    "speaker": "Player",
                    "text": "帮工都做些什么？"
                },
                {
                    "id": "624800202",
                    "speaker": "笃勤",
                    "text": "主要是打包和封装散件货物，搬运行李和大件货物！效率肯定不会让您失望！"
                },
                {
                    "id": "624800203",
                    "speaker": "笃勤",
                    "text": "有的外国客人不知该如何将茶叶和玉器妥善装入行李箱，导致运输过程中出现磕碰…"
                },
                {
                    "id": "624800204",
                    "speaker": "笃勤",
                    "text": "要么就是对遗珑埠的道路不熟，没选好路，被台阶挡住去路，累死累活…"
                },
                {
                    "id": "624800205",
                    "speaker": "笃勤",
                    "text": "提前雇佣我们这样的帮工，就能避开不少麻烦！"
                }
            ]
        },
        {
            "talkId": "6248003",
            "initDialog": "624800301",
            "dialogues": [
                {
                    "id": "624800301",
                    "speaker": "Player",
                    "text": "为什么是按时辰计费？"
                },
                {
                    "id": "624800302",
                    "speaker": "笃勤",
                    "text": "哦！因为这是我们的兼职！"
                },
                {
                    "id": "624800303",
                    "speaker": "笃勤",
                    "text": "我们主要的工作是帮镖局的弟兄把长途送来的货物拆散，分发到每个客户手中。"
                },
                {
                    "id": "624800304",
                    "speaker": "笃勤",
                    "text": "不过，长途货物也是有限的，送完这些货，我们闲着也是闲着，不如就来打点零工，帮帮外国来的客人。"
                },
                {
                    "id": "624800305",
                    "speaker": "笃勤",
                    "text": "每个人对下一单长途货物抵达的时间都心里有数，只接一到两个时辰的单，工作安排起来就很灵活！"
                }
            ]
        },
        {
            "talkId": "6248004",
            "initDialog": "624800401",
            "dialogues": [
                {
                    "id": "624800401",
                    "speaker": "Player",
                    "text": "有机会再请你们帮忙！"
                },
                {
                    "id": "624800402",
                    "speaker": "笃勤",
                    "text": "那客人走好！说不定来年你就发了大财，买一堆好货，到时我们就来帮忙！"
                }
            ]
        },
        {
            "talkId": "6248005",
            "initDialog": "624800501",
            "dialogues": [
                {
                    "id": "624800501",
                    "speaker": "Player",
                    "text": "听起来很辛苦…"
                },
                {
                    "id": "624800502",
                    "speaker": "笃勤",
                    "text": "还好还好，相比长途跑镖的兄弟们，我们只是在城内搬货，工作强度小了不少，而且更安全。"
                },
                {
                    "id": "624800503",
                    "speaker": "笃勤",
                    "text": "当然，也有些兄弟是功夫还不过关，没能成为正式的镖师，先来当帮工练练本事。"
                },
                {
                    "id": "624800504",
                    "speaker": "笃勤",
                    "text": "从璃月港到遗珑埠的这条线路，对于跑镖的人是个天大的考验，没两把刷子可应付不来！"
                }
            ]
        }
    ]
}