    "talks": [
        {
            "talkId": "6157701",
            "initDialog": "615770101",
            "dialogues": [
                {
                    "id": "615770101",
                    "speaker": "冒失的帕拉德",
                    "text": "你看起来很闲啊，我可不一样。"
                }
            ]
        },
        {
            "talkId": "6157702",
            "initDialog": "615770201",
            "dialogues": [
                {
                    "id": "615770201",
                    "speaker": "Player",
                    "text": "你不是在休息吗？"
                },
                {
                    "id": "615770202",
                    "speaker": "冒失的帕拉德",
                    "text": "休息也是寻宝所必须的过程，不吃好休息好，宝贝也会躲着我走的。"
                },
                {
                    "id": "615770203",
                    "speaker": "冒失的帕拉德",
                    "text": "所以我正在忙着休息。"
                }
            ]
        },
        {
            "talkId": "6157703",
            "initDialog": "615770301",
            "dialogues": [
                {
                    "id": "615770301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615770302",
                    "speaker": "冒失的帕拉德",
                    "text": "你也歇会儿吧。"
                }
            ]
        },
        {
            "talkId": "6157704",
            "initDialog": "615770401",
            "dialogues": [
                {
                    "id": "615770401",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "615770402",
                    "speaker": "冒失的帕拉德",
                    "text": "比起龙灾…嘿，你说风魔龙的那个废墟里会不会藏着什么大宝藏呢？"
                },
                {
                    "id": "615770403",
                    "speaker": "冒失的帕拉德",
                    "text": "要是能从里面拿走一两件值钱的东西，说不定下辈子都吃喝不愁了，嘿嘿…"
                },
                {
                    "id": "615770404",
                    "speaker": "冒失的帕拉德",
                    "text": "…我就是说说啊，虽然现在风魔龙已经不在了，不过我可没有胆子去那里…"
                }
            ]
        }
    ]
}