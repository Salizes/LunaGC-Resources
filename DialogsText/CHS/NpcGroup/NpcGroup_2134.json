{
    "groupId": "2134",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "星辰君": 10
    },
    "talks": [
        {
            "talkId": "6213401",
            "initDialog": "621340101",
            "dialogues": [
                {
                    "id": "621340101",
                    "speaker": "星辰君",
                    "text": "嗯？在下乃「掇星攫辰天君」…"
                },
                {
                    "id": "621340102",
                    "speaker": "星辰君",
                    "text": "…呃…的信众。你找我什么事？"
                }
            ]
        },
        {
            "talkId": "6213402",
            "initDialog": "621340201",
            "dialogues": [
                {
                    "id": "621340201",
                    "speaker": "Player",
                    "text": "你的面具…"
                },
                {
                    "id": "621340202",
                    "speaker": "星辰君",
                    "text": "眼熟吧？我是客栈楼下捡到的，应该是当初「掇星攫辰天君」一直戴着的那款。"
                },
                {
                    "id": "621340203",
                    "speaker": "星辰君",
                    "text": "不过这个面具应该是备用的吧？我从没想过星辰天君他会摘掉面具…"
                },
                {
                    "id": "621340204",
                    "speaker": "星辰君",
                    "text": "你说该不会是我们犯了什么错，被星辰天君抛弃了吧？确实有很久没见到星辰天君大人了…"
                }
            ]
        },
        {
            "talkId": "6213403",
            "initDialog": "621340301",
            "dialogues": [
                {
                    "id": "621340301",
                    "speaker": "Player",
                    "text": "「掇星攫辰天君」其实是骗子…"
                },
                {
                    "id": "621340302",
                    "speaker": "星辰君",
                    "text": "说什么呢，说什么呢！"
                },
                {
                    "id": "621340303",
                    "speaker": "星辰君",
                    "text": "你敢在信众面前诬蔑星辰天君？你这人，你这人简直…"
                },
                {
                    "id": "621340304",
                    "speaker": "星辰君",
                    "text": "…哼，仙家教导不能说粗话，何况我还戴着星辰天君大人的面具。"
                },
                {
                    "id": "621340305",
                    "speaker": "星辰君",
                    "text": "快走吧走吧，不想和你说话，我看你才是骗子。"
                }
            ]
        },
        {
            "talkId": "6213404",
            "initDialog": "621340401",
            "dialogues": [
                {
                    "id": "621340401",
                    "speaker": "Player",
                    "text": "没事，再见。"
                },
                {
                    "id": "621340402",
                    "speaker": "星辰君",
                    "text": "哦，你该不会也是星辰天君的信徒吧？要是什么时候再有幸见到他，记得给我个消息。"
                }
            ]
        }
    ]
}