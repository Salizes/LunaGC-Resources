    "talks": [
        {
            "talkId": "6957401",
            "initDialog": "695740101",
            "dialogues": [
                {
                    "id": "695740101",
                    "speaker": "菲米尼",
                    "text": "人好多，声音也有点太过响亮了…要是现在能戴上头盔就好了…"
                }
            ]
        },
        {
            "talkId": "6957402",
            "initDialog": "695740201",
            "dialogues": [
                {
                    "id": "695740201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957403",
            "initDialog": "695740301",
            "dialogues": [
                {
                    "id": "695740301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695740302",
                    "speaker": "菲米尼",
                    "text": "要走了吗？我也想跟你一起离开。然后…去水里安静一下…"
                }
            ]
        },
        {
            "talkId": "6957404",
            "initDialog": "695740401",
            "dialogues": [
                {
                    "id": "695740401",
                    "speaker": "菲米尼",
                    "text": "谢谢你愿意和我玩，下次…如果你还想玩牌的话，可以直接叫上我。"
                }
            ]
        },
        {
            "talkId": "6957405",
            "initDialog": "695740501",
            "dialogues": [
                {
                    "id": "695740501",
                    "speaker": "菲米尼",
                    "text": "还是你比较厉害！要是之后还想玩卡牌的话，我愿意继续做你的对手。"
                }
            ]
        },
        {
            "talkId": "6957406",
            "initDialog": "695740601",
            "dialogues": [
                {
                    "id": "695740601",
                    "speaker": "菲米尼",
                    "text": "欸？你要和我玩牌？好的，如果这是你的要求…"
                }
            ]
        },
        {
            "talkId": "6957408",
            "initDialog": "695740801",
            "dialogues": [
                {
                    "id": "695740801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957409",
            "initDialog": "695740901",
            "dialogues": [
                {
                    "id": "695740901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957410",
            "initDialog": "695741001",
            "dialogues": [
                {
                    "id": "695741001",
                    "speaker": "菲米尼",
                    "text": "赢了…那些练习总算没有白做…"
                }
            ]
        },
        {
            "talkId": "6957411",
            "initDialog": "695741101",
            "dialogues": [
                {
                    "id": "695741101",
                    "speaker": "菲米尼",
                    "text": "还是…赢不了么…"
                }
            ]
        },
        {
            "talkId": "6957412",
            "initDialog": "695741201",
            "dialogues": [
                {
                    "id": "695741201",
                    "speaker": "菲米尼",
                    "text": "好呀。我练习了很久…应该不会让你失望。"
                }
            ]
        },
        {
            "talkId": "6957414",
            "initDialog": "695741401",
            "dialogues": [
                {
                    "id": "695741401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957415",
            "initDialog": "695741501",
            "dialogues": [
                {
                    "id": "695741501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957416",
            "initDialog": "695741601",
            "dialogues": [
                {
                    "id": "695741601",
                    "speaker": "菲米尼",
                    "text": "呼…还好，至少把之前练习的成果都展示出来了。"
                }
            ]
        },
        {
            "talkId": "6957417",
            "initDialog": "695741701",
            "dialogues": [
                {
                    "id": "695741701",
                    "speaker": "菲米尼",
                    "text": "抱歉，我不知道是不是没给你充足的挑战性…"
                }
            ]
        },
        {
            "talkId": "6957418",
            "initDialog": "695741801",
            "dialogues": [
                {
                    "id": "695741801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}