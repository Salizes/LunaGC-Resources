{
    "groupId": "2005",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 5,
        "李锤子": 22
    },
    "talks": [
        {
            "talkId": "4003728",
            "initDialog": "400372801",
            "dialogues": [
                {
                    "id": "400372801",
                    "speaker": "李锤子",
                    "text": "过节吗…过节好啊，张灯结彩，比平时热闹多了。"
                },
                {
                    "id": "400372802",
                    "speaker": "李锤子",
                    "text": "但转念一想，好像和我也没什么关系…"
                }
            ]
        },
        {
            "talkId": "6200501",
            "initDialog": "620050101",
            "dialogues": [
                {
                    "id": "620050101",
                    "speaker": "李锤子",
                    "text": "你好，有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "6200502",
            "initDialog": "620050201",
            "dialogues": [
                {
                    "id": "620050201",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "620050202",
                    "speaker": "李锤子",
                    "text": "…我？你是说我吗…？我就是个苦力，叫我李锤子就好。"
                },
                {
                    "id": "620050203",
                    "speaker": "李锤子",
                    "text": "这是我自己起的外号，谁叫我一天到晚只能拿着锤子叮叮咣咣呢…"
                },
                {
                    "id": "620050204",
                    "speaker": "李锤子",
                    "text": "唉，假如什么时候老天开眼，让我也拥有神之眼就好了…",
                    "choices": [
                        {
                            "id": "620050205",
                            "text": "关于工作…",
                            "response": [
                                {
                                    "id": "620050206",
                                    "speaker": "李锤子",
                                    "text": "工作…？工作挺好啊，没什么可说的…无非拿着锤子敲敲这里，敲敲那里，时不时被枭老头子骂一顿…"
                                },
                                {
                                    "id": "620050207",
                                    "speaker": "李锤子",
                                    "text": "我也老大不小了，反正这样干再久也成不了家，也买不起属于自己的船和宅子，我对未来是没啥指望了…"
                                }
                            ]
                        },
                        {
                            "id": "620050208",
                            "text": "神之眼？",
                            "response": [
                                {
                                    "id": "620050209",
                                    "speaker": "李锤子",
                                    "text": "怎么？你也对神之眼感兴趣吗？"
                                },
                                {
                                    "id": "620050210",
                                    "speaker": "李锤子",
                                    "text": "我听说，只要心里对某件东西存在强烈的渴望，「神之眼」就会出现在他身边，供他驱使。"
                                },
                                {
                                    "id": "620050211",
                                    "speaker": "李锤子",
                                    "text": "神奇吧？至于我…我就是单纯渴望神之眼。我从小到大，每天做梦都想得到一颗。但是至今还没有那个福气…"
                                },
                                {
                                    "id": "620050212",
                                    "speaker": "李锤子",
                                    "text": "假如我有了神之眼，一定也能像故事传说中的那些大侠客一样，擒风使雨、掣雷驱电吧。"
                                },
                                {
                                    "id": "620050213",
                                    "speaker": "李锤子",
                                    "text": "唉…神之眼啊…我已经一把岁数了，你在哪儿呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6200503",
            "initDialog": "620050301",
            "dialogues": [
                {
                    "id": "620050301",
                    "speaker": "Player",
                    "text": "再见，请振作一点。"
                },
                {
                    "id": "620050302",
                    "speaker": "李锤子",
                    "text": "唉…谢谢，再见。"
                }
            ]
        },
        {
            "talkId": "6200504",
            "initDialog": "620050401",
            "dialogues": [
                {
                    "id": "620050401",
                    "speaker": "Player",
                    "text": "关于岩王帝君"
                },
                {
                    "id": "620050402",
                    "speaker": "李锤子",
                    "text": "…有什么好说的？「请仙典仪」我也在场，可把我吓得不轻…"
                },
                {
                    "id": "620050403",
                    "speaker": "李锤子",
                    "text": "不过，这事之后，我还以为天衡山要垮了，璃月就这么完了。"
                },
                {
                    "id": "620050404",
                    "speaker": "李锤子",
                    "text": "但是看到大家仍然像平常一样过日子，也依然对明天抱有希望…我想我也该反思一下自己了。"
                },
                {
                    "id": "620050405",
                    "speaker": "李锤子",
                    "text": "这样乐观一想的话，岩王爷肯定不是真的离开我们了，你说是吧？"
                }
            ]
        },
        {
            "talkId": "7200501",
            "initDialog": "720050101",
            "dialogues": [
                {
                    "id": "720050101",
                    "speaker": "李锤子",
                    "text": "材料的供应源源不断…真的能如期完工吗，唉…"
                },
                {
                    "id": "720050102",
                    "speaker": "李锤子",
                    "text": "不过转念想想，神会记住我帮忙建造「明霄灯」的功劳吧？"
                },
                {
                    "id": "720050103",
                    "speaker": "李锤子",
                    "text": "等放飞的时候，我一定要许愿一枚「神之眼」！"
                },
                {
                    "id": "720050104",
                    "speaker": "李锤子",
                    "text": "稍微期待起来了…"
                }
            ]
        }
    ]
}