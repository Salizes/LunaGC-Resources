{
    "groupId": "7528",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "德洛菲娅": 12,
        "阿克维莉娜": 3
    },
    "talks": [
        {
            "talkId": "6752801",
            "initDialog": "675280101",
            "dialogues": [
                {
                    "id": "675280101",
                    "speaker": "德洛菲娅",
                    "text": "呵呵，现在的孩子们还真是光彩照人…连我都要忍不住成为她们的倾慕者了呢。"
                }
            ]
        },
        {
            "talkId": "6752802",
            "initDialog": "675280201",
            "dialogues": [
                {
                    "id": "675280201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "675280202",
                    "speaker": "德洛菲娅",
                    "text": "哎呀…能被您问出这样的问题，证明我已经彻底过气了呢。"
                },
                {
                    "id": "675280203",
                    "speaker": "德洛菲娅",
                    "text": "我叫德洛菲娅，曾经在科洛列夫茨基剧团唱过几年歌。"
                },
                {
                    "id": "675280204",
                    "speaker": "德洛菲娅",
                    "text": "如今算是早早隐退，靠着丈夫的领地和一点薄产，做个清闲的观众而已。"
                },
                {
                    "id": "675280205",
                    "speaker": "德洛菲娅",
                    "text": "能像现在这样站在台下，为耀眼的后辈们鼓掌，也是一种幸福呢。"
                }
            ]
        },
        {
            "talkId": "6752803",
            "initDialog": "675280301",
            "dialogues": [
                {
                    "id": "675280301",
                    "speaker": "Player",
                    "text": "回见。"
                },
                {
                    "id": "675280302",
                    "speaker": "德洛菲娅",
                    "text": "呵呵，再会。有空记得多去剧院坐坐哦。"
                }
            ]
        },
        {
            "talkId": "6752804",
            "initDialog": "675280401",
            "dialogues": [
                {
                    "id": "675280401",
                    "speaker": "Player",
                    "text": "你原先也是演员？"
                },
                {
                    "id": "675280402",
                    "speaker": "德洛菲娅",
                    "text": "呵呵…是呀。您也许看不出来，但我当年也在舞台上担任过好几年的主役，收获过无数花束哦。"
                },
                {
                    "id": "675280403",
                    "speaker": "德洛菲娅",
                    "text": "不过——您瞧，青春与美貌都是些短暂而虚幻的东西。"
                },
                {
                    "id": "675280404",
                    "speaker": "德洛菲娅",
                    "text": "歌手只要失去光彩，所有那些崇拜她的贵族与富有的追求者，都会瞬间消失得无影无踪。"
                },
                {
                    "id": "675280405",
                    "speaker": "德洛菲娅",
                    "text": "他们爱的是舞台上那个完美的幻象，而不是幻象下的真人。我从小在炉灰区街头流浪，靠乞讨残羹剩饭谋生，对此心知肚明。"
                },
                {
                    "id": "675280406",
                    "speaker": "德洛菲娅",
                    "text": "所以我选在最巅峰的时候离开了舞台。幸运的是，我丈夫是位死板却真诚的贵族…您知道，贵族的真心向来很难得。"
                }
            ]
        },
        {
            "talkId": "6752805",
            "initDialog": "675280501",
            "dialogues": [
                {
                    "id": "675280501",
                    "speaker": "Player",
                    "text": "关于现在的演员…"
                },
                {
                    "id": "675280502",
                    "speaker": "德洛菲娅",
                    "text": "优秀的后辈可太多啦。先不提沃雅妮莎前辈这样的老资历，最近相当引人注目的奥黛塔小姐就很棒。"
                },
                {
                    "id": "675280503",
                    "speaker": "阿克维莉娜",
                    "text": "维奥莱塔…啊，就是她母亲，当初与我合作过。她的天赋虽然比不上维奥莱塔那种几乎可谓是怪物的芭蕾舞者，但…"
                },
                {
                    "id": "675280504",
                    "speaker": "阿克维莉娜",
                    "text": "那孩子跳舞的时候，总是有一种——嗯，怎么说呢？带着对芭蕾纯粹又热烈的爱，再加上她毫不顾身的倔强，真是独一无二呢。"
                },
                {
                    "id": "675280505",
                    "speaker": "阿克维莉娜",
                    "text": "大家都在拼尽全力地发光呢，真好啊。"
                }
            ]
        }
    ]
}