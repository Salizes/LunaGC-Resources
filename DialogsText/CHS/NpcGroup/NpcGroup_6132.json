{
    "groupId": "6132",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "提佐科": 10
    },
    "talks": [
        {
            "talkId": "7509603",
            "initDialog": "750960201",
            "dialogues": [
                {
                    "id": "750960201",
                    "speaker": "提佐科",
                    "text": "「山王火榴」终于成熟了，真是让人松了口气。"
                },
                {
                    "id": "750960202",
                    "speaker": "提佐科",
                    "text": "咦，是你啊，怎么了，如果要进去的话就速去速回，别被部族的人发现了！",
                    "choices": [
                        {
                            "id": "750960203",
                            "text": "关于「山王」…",
                            "response": [
                                {
                                    "id": "750960204",
                                    "speaker": "提佐科",
                                    "text": "哦，是想问关于「山王」的事吗…"
                                },
                                {
                                    "id": "750960205",
                                    "speaker": "提佐科",
                                    "text": "「山王」康加玛托，是从前与英杰一起对抗深渊的了不起的龙，部族里的所有人都很尊敬它。"
                                },
                                {
                                    "id": "750960206",
                                    "speaker": "提佐科",
                                    "text": "「山王火榴」其实也会有专人采摘献给它食用。不过也有说法，其他的匿叶龙也会偷偷给「山王」大人喂吃的…"
                                },
                                {
                                    "id": "750960207",
                                    "speaker": "提佐科",
                                    "text": "所以「山王」大人才会比别的匿叶龙…呃，健硕那么多？"
                                }
                            ]
                        },
                        {
                            "id": "750960208",
                            "text": "关于火榴果…",
                            "response": [
                                {
                                    "id": "750960209",
                                    "speaker": "提佐科",
                                    "text": "这你就问对人啦，火榴果是很了不起的燃素植物，哎，能够把自己的根系伸入液态燃素，对于植物来说很有勇气吧。"
                                },
                                {
                                    "id": "750960210",
                                    "speaker": "提佐科",
                                    "text": "而且，结出来的果子里也满含燃素，多吃吃对匿叶龙也有好处…只要它们别扔出去…"
                                },
                                {
                                    "id": "750960211",
                                    "speaker": "提佐科",
                                    "text": "毕竟剧烈碰撞，火榴果就会爆裂开来嘛…"
                                }
                            ]
                        },
                        {
                            "id": "750960212",
                            "text": "只是路过啦…",
                            "response": [
                                {
                                    "id": "750960213",
                                    "speaker": "提佐科",
                                    "text": "是嘛…真的不进去看一眼「山王火榴」吗？多看看「山王火榴」，就觉得心情也变好了…如果觉得烦恼，一定得来看看哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}