{
    "groupId": "6020",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 8,
        "阿隆": 13
    },
    "talks": [
        {
            "talkId": "5900186",
            "initDialog": "590018601",
            "dialogues": [
                {
                    "id": "590018601",
                    "speaker": "Player",
                    "text": "关于纳塔的矿产…"
                }
            ]
        },
        {
            "talkId": "5900187",
            "initDialog": "590018701",
            "dialogues": [
                {
                    "id": "590018701",
                    "speaker": "阿隆",
                    "text": "抱歉，最近没有什么成色好的矿点情报，可能都被人采光了吧。"
                },
                {
                    "id": "590018702",
                    "speaker": "阿隆",
                    "text": "你不如过段时间再来，我有消息就跟你分享。"
                }
            ]
        },
        {
            "talkId": "6602001",
            "initDialog": "660200101",
            "dialogues": [
                {
                    "id": "660200101",
                    "speaker": "阿隆",
                    "text": "二、四、五…哦，我好像又打错拍子了。"
                }
            ]
        },
        {
            "talkId": "6602002",
            "initDialog": "660200201",
            "dialogues": [
                {
                    "id": "660200201",
                    "speaker": "Player",
                    "text": "想买些武器。"
                },
                {
                    "id": "660200202",
                    "speaker": "阿隆",
                    "text": "请便。"
                }
            ]
        },
        {
            "talkId": "6602003",
            "initDialog": "660200301",
            "dialogues": [
                {
                    "id": "660200301",
                    "speaker": "Player",
                    "text": "委托锻造…"
                },
                {
                    "id": "660200302",
                    "speaker": "阿隆",
                    "text": "需要什么？我看看能不能帮你打个更结实的。"
                }
            ]
        },
        {
            "talkId": "6602004",
            "initDialog": "660200401",
            "dialogues": [
                {
                    "id": "660200401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>委托锻造…</color>"
                },
                {
                    "id": "660200402",
                    "speaker": "阿隆",
                    "text": "之前的委托已经完工了，还有其他需要吗？"
                }
            ]
        },
        {
            "talkId": "6602005",
            "initDialog": "660200501",
            "dialogues": [
                {
                    "id": "660200501",
                    "speaker": "Player",
                    "text": "什么拍子？"
                },
                {
                    "id": "660200502",
                    "speaker": "阿隆",
                    "text": "哦，不用在意，是我心里正在播放激情澎湃的音乐，正适合在打铁的时候听。"
                },
                {
                    "id": "660200503",
                    "speaker": "阿隆",
                    "text": "你应该听不到。可惜我也五音不全，不能唱给你听。"
                },
                {
                    "id": "660200504",
                    "speaker": "阿隆",
                    "text": "不过你可以在边上听一听我打铁的节奏，就当是在听歌了吧。"
                }
            ]
        },
        {
            "talkId": "6602006",
            "initDialog": "660200601",
            "dialogues": [
                {
                    "id": "660200601",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "660200602",
                    "speaker": "阿隆",
                    "text": "慢走。"
                }
            ]
        },
        {
            "talkId": "6602007",
            "initDialog": "660200701",
            "dialogues": [
                {
                    "id": "660200701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想买些武器。</color>"
                },
                {
                    "id": "660200702",
                    "speaker": "阿隆",
                    "text": "请便。"
                }
            ]
        },
        {
            "talkId": "7591101",
            "initDialog": "759110101",
            "dialogues": [
                {
                    "id": "759110101",
                    "speaker": "Player",
                    "text": "很有节奏感。"
                },
                {
                    "id": "759110102",
                    "speaker": "阿隆",
                    "text": "不知为何，这种节奏感会缓解重复劳动的疲劳，让我更有干劲。"
                },
                {
                    "id": "759110103",
                    "speaker": "阿隆",
                    "text": "嗯，石头有时也是一种乐器呢。"
                }
            ]
        }
    ]
}