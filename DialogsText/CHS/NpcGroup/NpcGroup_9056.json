{
    "groupId": "9056",
    "total_dialogue_lines": 68,
    "speaker_counts": {
        "Player": 16,
        "九条裟罗": 52
    },
    "talks": [
        {
            "talkId": "6905601",
            "initDialog": "690560101",
            "dialogues": [
                {
                    "id": "690560101",
                    "speaker": "九条裟罗",
                    "text": "#{NICKNAME}，又见面了。"
                },
                {
                    "id": "690560102",
                    "speaker": "九条裟罗",
                    "text": "这个地方看起来不错。"
                }
            ]
        },
        {
            "talkId": "6905602",
            "initDialog": "690560201",
            "dialogues": [
                {
                    "id": "690560201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690560202",
                    "speaker": "九条裟罗",
                    "text": "虽然没有九条家的宅邸宽阔，但住下来，还算舒心。"
                },
                {
                    "id": "690560203",
                    "speaker": "九条裟罗",
                    "text": "这里的一切都是按照你的意思建造的吗？没想到你还有这种才能。"
                },
                {
                    "id": "690560204",
                    "speaker": "九条裟罗",
                    "text": "如果九条家要扩建，我会优先来找你的。",
                    "choices": [
                        {
                            "id": "690560205",
                            "text": "大可不必…",
                            "response": [
                                {
                                    "id": "690560206",
                                    "speaker": "九条裟罗",
                                    "text": "怎么？你不乐意吗？"
                                },
                                {
                                    "id": "690560209",
                                    "speaker": "九条裟罗",
                                    "text": "呵呵，放心吧，我不会强人所难。"
                                },
                                {
                                    "id": "690560210",
                                    "speaker": "九条裟罗",
                                    "text": "事实上，九条家也不可能有什么改变了，至少不可能改造成这里的样子。"
                                },
                                {
                                    "id": "690560211",
                                    "speaker": "九条裟罗",
                                    "text": "因为这里存在的生机与乐趣，是我此前从未感受过的…"
                                }
                            ]
                        },
                        {
                            "id": "690560207",
                            "text": "交给我吧！",
                            "response": [
                                {
                                    "id": "690560208",
                                    "speaker": "九条裟罗",
                                    "text": "我还没说要求呢，你就一口答应了吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905603",
            "initDialog": "690560301",
            "dialogues": [
                {
                    "id": "690560301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690560302",
                    "speaker": "九条裟罗",
                    "text": "闲来无事…既然你主动要求，当然可以。"
                },
                {
                    "id": "690560303",
                    "speaker": "九条裟罗",
                    "text": "只是我多数时候都习惯独处，很少跟别人聊天，最好是你问我答。"
                },
                {
                    "id": "690560304",
                    "speaker": "九条裟罗",
                    "text": "那就开始吧。",
                    "choices": [
                        {
                            "id": "690560305",
                            "text": "感觉像在考试，有点紧张。",
                            "response": [
                                {
                                    "id": "690560306",
                                    "speaker": "九条裟罗",
                                    "text": "嗯？"
                                },
                                {
                                    "id": "690560307",
                                    "speaker": "九条裟罗",
                                    "text": "你现在的表情，怎么跟我的部下汇报公务时一样…"
                                },
                                {
                                    "id": "690560308",
                                    "speaker": "九条裟罗",
                                    "text": "不过我要提醒你，我从未将你当作部下。"
                                },
                                {
                                    "id": "690560312",
                                    "speaker": "Player",
                                    "text": "唔…"
                                },
                                {
                                    "id": "690560313",
                                    "speaker": "九条裟罗",
                                    "text": "唉，跟我聊天…是不是真的很困难。"
                                },
                                {
                                    "id": "690560314",
                                    "speaker": "九条裟罗",
                                    "text": "其实，我最近也在学习与人相处的技巧，想着也许可以改变一下我严肃的形象。"
                                },
                                {
                                    "id": "690560315",
                                    "speaker": "九条裟罗",
                                    "text": "但人与人之间的情感太过微妙和纤细，我很难在一时半会参透这些。"
                                },
                                {
                                    "id": "690560316",
                                    "speaker": "九条裟罗",
                                    "text": "如果这种事情也像弓道一样，只要勤加练习，就能有所长进，那我还有些动力…"
                                },
                                {
                                    "id": "690560317",
                                    "speaker": "Player",
                                    "text": "其实就是这样的。"
                                },
                                {
                                    "id": "690560318",
                                    "speaker": "九条裟罗",
                                    "text": "唔…真的吗？"
                                },
                                {
                                    "id": "690560319",
                                    "speaker": "九条裟罗",
                                    "text": "那么…就选你为我的练习对象吧！以后你就多来跟我聊聊天，应该没问题吧？"
                                }
                            ]
                        },
                        {
                            "id": "690560309",
                            "text": "你就没有想问我的吗？",
                            "response": [
                                {
                                    "id": "690560310",
                                    "speaker": "九条裟罗",
                                    "text": "有是有…不过如果我问了，你就应该回答。"
                                },
                                {
                                    "id": "690560311",
                                    "speaker": "九条裟罗",
                                    "text": "倘若你回答不出来，那就要接受相应的惩罚。做好觉悟了吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905604",
            "initDialog": "690560401",
            "dialogues": [
                {
                    "id": "690560401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690560402",
                    "speaker": "九条裟罗",
                    "text": "从小到大，我已经习惯了一个人做各种事情了…"
                },
                {
                    "id": "690560403",
                    "speaker": "九条裟罗",
                    "text": "我曾经有过养宠物的念头，但因为种种原因，最后还是不了了之…"
                },
                {
                    "id": "690560404",
                    "speaker": "Player",
                    "text": "想养什么宠物？"
                },
                {
                    "id": "690560405",
                    "speaker": "九条裟罗",
                    "text": "没有想过具体的种类。只是「想要一个玩伴」罢了。"
                },
                {
                    "id": "690560406",
                    "speaker": "九条裟罗",
                    "text": "奉行所里人多事杂，我经常又要外出执行任务…"
                },
                {
                    "id": "690560407",
                    "speaker": "九条裟罗",
                    "text": "每当想到这些，我就能断定我肯定没有时间陪宠物玩，所以还是算了。"
                },
                {
                    "id": "690560408",
                    "speaker": "九条裟罗",
                    "text": "缺少陪伴的成长是不会快乐的，宠物也是，人也是，天狗也是…"
                },
                {
                    "id": "690560409",
                    "speaker": "Player",
                    "text": "现在就可以养，养在这吧？"
                },
                {
                    "id": "690560410",
                    "speaker": "九条裟罗",
                    "text": "哈哈…说得也对。"
                },
                {
                    "id": "690560411",
                    "speaker": "九条裟罗",
                    "text": "既然要养在这里，当然也要征询你的意见，你觉得养什么好呢？"
                },
                {
                    "id": "690560412",
                    "speaker": "九条裟罗",
                    "text": "红角蜥怎么样？总是形单影只，不需要人陪。",
                    "choices": [
                        {
                            "id": "690560413",
                            "text": "还是养猫吧…",
                            "response": [
                                {
                                    "id": "690560414",
                                    "speaker": "九条裟罗",
                                    "text": "猫吗…猫的话，我该怎么区分它们心情的好坏？"
                                },
                                {
                                    "id": "690560417",
                                    "speaker": "九条裟罗",
                                    "text": "我没有什么经验，不知道能不能胜任「主人」这个身份。"
                                },
                                {
                                    "id": "690560418",
                                    "speaker": "九条裟罗",
                                    "text": "但既然这是你我共同做下的决定，你也要尽好你的责任才是。"
                                },
                                {
                                    "id": "690560419",
                                    "speaker": "九条裟罗",
                                    "text": "呼…为了体谅你，我可以承担最难的部分，也就是陪伴。"
                                },
                                {
                                    "id": "690560420",
                                    "speaker": "Player",
                                    "text": "意思就是我…"
                                },
                                {
                                    "id": "690560421",
                                    "speaker": "九条裟罗",
                                    "text": "没错，你只需要把最基础的喂食和清洁工作做好就行了。"
                                },
                                {
                                    "id": "690560422",
                                    "speaker": "九条裟罗",
                                    "text": "啊，在此之前，得给它取个有纪念意义的名字…"
                                },
                                {
                                    "id": "690560423",
                                    "speaker": "九条裟罗",
                                    "text": "不用着急，有想法的时候我们再一起商量也不迟。"
                                }
                            ]
                        },
                        {
                            "id": "690560415",
                            "text": "还是养狗吧…",
                            "response": [
                                {
                                    "id": "690560416",
                                    "speaker": "九条裟罗",
                                    "text": "狗吗…好像观察尾巴就能知道它们的想法了吧？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905605",
            "initDialog": "690560501",
            "dialogues": [
                {
                    "id": "690560501",
                    "speaker": "Player",
                    "text": "早啊，裟罗！"
                },
                {
                    "id": "690560502",
                    "speaker": "九条裟罗",
                    "text": "#早，{NICKNAME}。"
                },
                {
                    "id": "690560503",
                    "speaker": "九条裟罗",
                    "text": "我已经做完五组素引练习了，如果你也想要活动一下筋骨，我不介意陪你再做五组。"
                }
            ]
        },
        {
            "talkId": "6905606",
            "initDialog": "690560601",
            "dialogues": [
                {
                    "id": "690560601",
                    "speaker": "Player",
                    "text": "晚安，裟罗。"
                },
                {
                    "id": "690560602",
                    "speaker": "九条裟罗",
                    "text": "这个点睡觉，是有什么心事吗？"
                },
                {
                    "id": "690560603",
                    "speaker": "九条裟罗",
                    "text": "有的话可以跟我直说无妨。如果没有，那就最好，我也不希望你有烦心事。"
                },
                {
                    "id": "690560604",
                    "speaker": "九条裟罗",
                    "text": "#晚安，{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6905610",
            "initDialog": "690561001",
            "dialogues": [
                {
                    "id": "690561001",
                    "speaker": "九条裟罗",
                    "text": "嗯，单论气势，这间庭院并不逊色于天领奉行府。"
                },
                {
                    "id": "690561002",
                    "speaker": "九条裟罗",
                    "text": "井然有序的庭院会给人一种暗示，让人恪守规则。"
                },
                {
                    "id": "690561003",
                    "speaker": "九条裟罗",
                    "text": "你居然独自参透了这个道理，值得敬佩。"
                }
            ]
        },
        {
            "talkId": "6905611",
            "initDialog": "690561101",
            "dialogues": [
                {
                    "id": "690561101",
                    "speaker": "九条裟罗",
                    "text": "这座营地的布置乍一看随意，细细想来却有些门道，甚至给了我不小的启发。"
                },
                {
                    "id": "690561102",
                    "speaker": "九条裟罗",
                    "text": "是你无意中促成的吗？还是说…你深入研究过兵法呢？"
                },
                {
                    "id": "690561103",
                    "speaker": "九条裟罗",
                    "text": "总之，按照军中惯例，这般才识卓越之人，理应得到犒赏。"
                }
            ]
        }
    ]
}