{
    "groupId": "4101",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "妮基娜": 8
    },
    "talks": [
        {
            "talkId": "6410101",
            "initDialog": "641010101",
            "dialogues": [
                {
                    "id": "641010101",
                    "speaker": "妮基娜",
                    "text": "不知道孩子们在教令院的生活还习惯吗…"
                }
            ]
        },
        {
            "talkId": "6410102",
            "initDialog": "641010201",
            "dialogues": [
                {
                    "id": "641010201",
                    "speaker": "Player",
                    "text": "关于孩子们…"
                },
                {
                    "id": "641010202",
                    "speaker": "妮基娜",
                    "text": "他们都去教令院啦，成为了正式的学者，工作可忙了，一年也回不了家里几次。"
                },
                {
                    "id": "641010203",
                    "speaker": "妮基娜",
                    "text": "所以这里就只剩我这个老婆子咯…"
                },
                {
                    "id": "641010204",
                    "speaker": "妮基娜",
                    "text": "孩子们都有远大的前程，我没什么好抱怨的，就是有点担心他们过得怎么样。"
                }
            ]
        },
        {
            "talkId": "6410103",
            "initDialog": "641010301",
            "dialogues": [
                {
                    "id": "641010301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641010302",
                    "speaker": "妮基娜",
                    "text": "再见啦…"
                }
            ]
        },
        {
            "talkId": "7394401",
            "initDialog": "739440101",
            "dialogues": [
                {
                    "id": "739440101",
                    "speaker": "Player",
                    "text": "孩子都会成长的。"
                },
                {
                    "id": "739440102",
                    "speaker": "妮基娜",
                    "text": "是咯，是咯，你说得对，我也相信他们的能力，一定能照顾好自己的。"
                },
                {
                    "id": "739440103",
                    "speaker": "妮基娜",
                    "text": "只是一个人做饭总是控制不好量，每次都会做多。不嫌弃的话，你拿一点走吧。"
                },
                {
                    "id": "739440104",
                    "speaker": "妮基娜",
                    "text": "是须弥的家常菜，希望你喜欢。"
                }
            ]
        }
    ]
}