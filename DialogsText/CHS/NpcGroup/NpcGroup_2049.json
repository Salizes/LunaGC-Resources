{
    "groupId": "2049",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 1,
        "独孤朔": 16
    },
    "talks": [
        {
            "talkId": "6204901",
            "initDialog": "620490101",
            "dialogues": [
                {
                    "id": "620490101",
                    "speaker": "独孤朔",
                    "text": "嗯？找本大侠有什么事？"
                }
            ]
        },
        {
            "talkId": "6204902",
            "initDialog": "620490201",
            "dialogues": [
                {
                    "id": "620490201",
                    "speaker": "独孤朔",
                    "text": "大侠…？"
                },
                {
                    "id": "620490202",
                    "speaker": "独孤朔",
                    "text": "干嘛这么看着我！"
                },
                {
                    "id": "620490203",
                    "speaker": "独孤朔",
                    "text": "你的眼睛分明在说「身高还没有剑高的小豆丁怎么可能会是大侠」，你心里一定是这么想的！"
                },
                {
                    "id": "620490204",
                    "speaker": "独孤朔",
                    "text": "哼，有了铁匠叔叔给的这把剑，本大侠已经不怕任何坏蛋了！"
                },
                {
                    "id": "620490205",
                    "speaker": "独孤朔",
                    "text": "等以后再得到岩元素的神之眼，本大侠就是天下第一侠客了！"
                },
                {
                    "id": "620490206",
                    "speaker": "独孤朔",
                    "text": "为什么是岩元素？"
                },
                {
                    "id": "620490207",
                    "speaker": "独孤朔",
                    "text": "那还用说！"
                },
                {
                    "id": "620490208",
                    "speaker": "独孤朔",
                    "text": "要是有了岩元素的神之眼，本大侠就可以操控元素立起一个高高的石柱，然后本大侠就站在上面！"
                },
                {
                    "id": "620490209",
                    "speaker": "独孤朔",
                    "text": "到那时，所有的人都得仰视本大侠，哈哈哈哈…"
                }
            ]
        },
        {
            "talkId": "6204903",
            "initDialog": "620490301",
            "dialogues": [
                {
                    "id": "620490301",
                    "speaker": "Player",
                    "text": "你的匕首…"
                },
                {
                    "id": "620490302",
                    "speaker": "独孤朔",
                    "text": "哪儿有匕首？你说的是我身上这把吗？明明是剑！"
                },
                {
                    "id": "620490303",
                    "speaker": "独孤朔",
                    "text": "这把剑叫「独孤宝剑」，是铁匠大叔帮本大侠打的。"
                },
                {
                    "id": "620490304",
                    "speaker": "独孤朔",
                    "text": "大叔还帮本大侠想了一个口号，就是那句「长剑在我手，天下任我游」！"
                },
                {
                    "id": "620490305",
                    "speaker": "独孤朔",
                    "text": "而且大叔还怕我忘了，特意把这句话刻在了剑身上，大叔真是个好人！"
                }
            ]
        },
        {
            "talkId": "6204904",
            "initDialog": "620490401",
            "dialogues": [
                {
                    "id": "620490401",
                    "speaker": "独孤朔",
                    "text": "再见。"
                },
                {
                    "id": "620490402",
                    "speaker": "独孤朔",
                    "text": "哼，江湖再会！"
                }
            ]
        }
    ]
}