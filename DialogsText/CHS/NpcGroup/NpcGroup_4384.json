    "talks": [
        {
            "talkId": "6438401",
            "initDialog": "643840101",
            "dialogues": [
                {
                    "id": "643840101",
                    "speaker": "索瑞",
                    "text": "你好，找风纪官有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6438402",
            "initDialog": "643840201",
            "dialogues": [
                {
                    "id": "643840201",
                    "speaker": "Player",
                    "text": "风纪官？"
                },
                {
                    "id": "643840202",
                    "speaker": "索瑞",
                    "text": "哦？原来你不知道我的身份啊。"
                },
                {
                    "id": "643840203",
                    "speaker": "索瑞",
                    "text": "没关系，找我聊公务的人越少，就说明这里的学术环境越好。"
                },
                {
                    "id": "643840204",
                    "speaker": "索瑞",
                    "text": "被书本包围的生活啊…想想还挺不错的。如果一个人每天只需要读书的话，可以说是过着最简单的生活了，对吧？"
                },
                {
                    "id": "643840205",
                    "speaker": "索瑞",
                    "text": "有时我看着智慧宫里这些摆放整齐的书，都想借一两本来看了。"
                },
                {
                    "id": "643840206",
                    "speaker": "索瑞",
                    "text": "不过还是算了吧，我没那个耐心。想了解大意的话，只要去虚空申请就可以了。"
                }
            ]
        },
        {
            "talkId": "6438403",
            "initDialog": "643840301",
            "dialogues": [
                {
                    "id": "643840301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "643840302",
                    "speaker": "索瑞",
                    "text": "哦，再见。"
                }
            ]
        },
