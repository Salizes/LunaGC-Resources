    },
    "talks": [
        {
            "talkId": "6444101",
            "initDialog": "644410101",
            "dialogues": [
                {
                    "id": "644410101",
                    "speaker": "瑟法娜",
                    "text": "请…请别和我说话！我现在好担心好害怕，思维乱乱的…对不起了！"
                }
            ]
        },
        {
            "talkId": "6444102",
            "initDialog": "644410201",
            "dialogues": [
                {
                    "id": "644410201",
                    "speaker": "瑟法娜",
                    "text": "是斯露莎姐姐的「谒颂主」！我还有什么可以帮到你的吗？"
                }
            ]
        },
        {
            "talkId": "6444103",
            "initDialog": "644410301",
            "dialogues": [
                {
                    "id": "644410301",
                    "speaker": "Player",
                    "text": "关于净觉花…"
                },
                {
                    "id": "644410302",
                    "speaker": "瑟法娜",
                    "text": "现在的「净觉花」已经彻底恢复健康啦。"
                },
                {
                    "id": "644410303",
                    "speaker": "瑟法娜",
                    "text": "经常待在「净觉花」身边的话，或许你也能听见它的歌声！"
                }
            ]
        },
        {
            "talkId": "6444104",
            "initDialog": "644410401",
            "dialogues": [
                {
                    "id": "644410401",
                    "speaker": "Player",
                    "text": "关于斯露莎…"
                },
                {
                    "id": "644410402",
                    "speaker": "瑟法娜",
                    "text": "其实我还有好多斯露莎姐姐的趣事想和你们分享。"
                },
                {
                    "id": "644410403",
                    "speaker": "瑟法娜",
                    "text": "不过，不可以背着斯露莎姐姐悄悄和你们说…以后肯定有机会的！"
                },
                {
                    "id": "644410404",
                    "speaker": "瑟法娜",
                    "text": "请多多和斯露莎姐姐一起来玩哦！"
                }
            ]
        },
        {
            "talkId": "6444105",
            "initDialog": "644410501",
            "dialogues": [
                {
                    "id": "644410501",
                    "speaker": "Player",
                    "text": "不麻烦你啦，再见！"
                },
                {
                    "id": "644410502",
                    "speaker": "瑟法娜",
                    "text": "那就再见了，期待你下次和斯露莎姐姐一起回来！"
                }
            ]
        },
        {
            "talkId": "7332206",
            "initDialog": "733220601",
            "dialogues": [
                {
                    "id": "733220601",
                    "speaker": "瑟法娜",
                    "text": "唉…这就是黯色的力量吗？"
                },
                {
                    "id": "733220602",
                    "speaker": "瑟法娜",
                    "text": "太可怕了，再怎么抵抗也无济于事…"
                },
                {
                    "id": "733220603",
                    "speaker": "斯露莎",
                    "text": "瑟法娜，怎么还是一副战战兢兢的样子？振作起来！"
                },
                {
                    "id": "733220604",
                    "speaker": "瑟法娜",
                    "text": "等等，我没看错吧…是斯露莎姐姐？你居然回来了！"
                },
                {
                    "id": "733220605",
                    "speaker": "瑟法娜",
                    "text": "呜啊…「净觉花」有救了…我苦等这么久，总算看到希望了！"
                },
                {
                    "id": "733220606",
                    "speaker": "瑟法娜",
                    "text": "你不会再突然离开吧？不会一去就是好久好久吧？不会的吧？"
                },
                {
                    "id": "733220607",
                    "speaker": "斯露莎",
                    "text": "#无须惊慌，瑟法娜，吾的去留不是重点！这次，吾与「谒颂主」{NICKNAME}将弥补汝的过失。"
                },
                {
                    "id": "733220608",
                    "speaker": "斯露莎",
                    "text": "吾正遂行熄灭「焚真之天象」的伟业，必将祓除黯色的侵蚀，解救所有花池。但汝务必牢记，这是汝的失职！"
                },
                {
                    "id": "733220609",
                    "speaker": "瑟法娜",
                    "text": "是…我明白自己的过错了…"
                },
                {
                    "id": "733220610",
                    "speaker": "派蒙",
                    "text": "瑟法娜居然管斯露莎叫姐姐呢，这个姐姐未免也太严厉了，根本让人喜欢不起来嘛…"
                },
                {
                    "id": "733220611",
                    "speaker": "斯露莎",
                    "text": "何等幼稚！前辈对于后辈，自然是要多加提点的，怎么能看着她们犯错，还温声细语！"
                },
                {
                    "id": "733220612",
                    "speaker": "瑟法娜",
                    "text": "没…没错！以前斯露莎姐姐可是很照顾我的！"
                },
                {
                    "id": "733220613",
                    "speaker": "瑟法娜",
                    "text": "斯露莎姐姐在「净觉花」前，发出「目标是比肩西摩格」的宣言时…比什么心得都能鼓舞我。"
                },
                {
                    "id": "733220614",
                    "speaker": "瑟法娜",
                    "text": "从那时起，我就觉得，斯露莎姐姐的意志真可敬。"
                },
                {
                    "id": "733220615",
                    "speaker": "瑟法娜",
                    "text": "所以我才学着人类对同辈长者的称谓，如此称呼她，这代表着我的敬意！"
                },
                {
                    "id": "733220616",
                    "speaker": "派蒙",
                    "text": "真是个性格和善的花灵啊…完全想象不出斯露莎被其他花灵严厉管教后，还亲切地叫对方「姐姐」的场景…"
                },
                {
                    "id": "733220617",
                    "speaker": "斯露莎",
                    "text": "多…多嘴！",
                    "choices": [
                        {
                            "id": "733220618",
                            "text": "先聊聊正题吧…",
                            "response": [
                                {
                                    "id": "733220620",
                                    "speaker": "瑟法娜",
                                    "text": "对哦，斯露莎姐姐的「谒颂主」或许不怎么了解「净觉花」？那我就借前辈们的话介绍一下…"
                                },
                                {
                                    "id": "733220621",
                                    "speaker": "瑟法娜",
                                    "text": "曾有一位花灵如此诵唱——"
                                },
                                {
                                    "id": "733220622",
                                    "speaker": "瑟法娜",
                                    "text": "「这凝明的色彩，是生命之泉流转的灵迹」…"
                                },
                                {
                                    "id": "733220623",
                                    "speaker": "瑟法娜",
                                    "text": "「伴我长存，与我妙舞清歌，编织悠久的欢欣」…"
                                },
                                {
                                    "id": "733220624",
                                    "speaker": "瑟法娜",
                                    "text": "…后边忘了。"
                                },
                                {
                                    "id": "733220625",
                                    "speaker": "瑟法娜",
                                    "text": "这段时间一直在抵抗污秽的侵袭，太累了，意识有点模糊。"
                                },
                                {
                                    "id": "733220626",
                                    "speaker": "派蒙",
                                    "text": "不用勉强自己哦，典故什么的记不起来也没关系，就用轻松一点的说法嘛！"
                                },
                                {
                                    "id": "733220627",
                                    "speaker": "瑟法娜",
                                    "text": "那我想想…「净觉花」虽不是「甘露花海」中最为珍贵之物，但确是我们花灵极为重视的「伴侣」。"
                                },
                                {
                                    "id": "733220628",
                                    "speaker": "瑟法娜",
                                    "text": "许多花灵在完成了每天应尽的职责后，就会与「净觉花」为伴。"
                                },
                                {
                                    "id": "733220629",
                                    "speaker": "瑟法娜",
                                    "text": "在人类眼中就像…自小就一直陪着他们成长的…歌声是「喵喵」和「汪汪」的生灵。"
                                },
                                {
                                    "id": "733220630",
                                    "speaker": "Player",
                                    "text": "猫猫和狗狗？"
                                },
                                {
                                    "id": "733220631",
                                    "speaker": "派蒙",
                                    "text": "原来是这样，如果陪着我长大的猫猫狗狗生病了，我也会很难过吧。"
                                },
                                {
                                    "id": "733220632",
                                    "speaker": "派蒙",
                                    "text": "更别说，生活中只有猫猫狗狗当朋友了…"
                                },
                                {
                                    "id": "733220633",
                                    "speaker": "派蒙",
                                    "text": "瑟法娜这么一描述，我就能理解你的急切了，「净觉花」的健康确实超级重要！"
                                },
                                {
                                    "id": "733220634",
                                    "speaker": "斯露莎",
                                    "text": "真是粗浅的比喻，其实「净觉花」的重要性远在这之上，瑟法娜还是需要修习言辞的门道啊。"
                                },
                                {
                                    "id": "733220635",
                                    "speaker": "派蒙",
                                    "text": "反正我们能理解瑟法娜的意思啦，斯露莎不用那么挑剔嘛…事态紧急，我们赶快出发吧！",
                                    "choices": [
                                        {
                                            "id": "733220636",
                                            "text": "拯救漂亮的花花！",
                                            "response": [
                                                {
                                                    "id": "733220638",
                                                    "speaker": "斯露莎",
                                                    "text": "汝就静候吾等的佳音吧，瑟法娜。"
                                                },
                                                {
                                                    "id": "733220639",
                                                    "speaker": "斯露莎",
                                                    "text": "不消片刻，吾就能尽显威能，让「净觉花」挣脱黯色的魔爪。"
                                                },
                                                {
                                                    "id": "733220640",
                                                    "speaker": "瑟法娜",
                                                    "text": "太，太感谢你们了！"
                                                },
                                                {
                                                    "id": "733220641",
                                                    "speaker": "瑟法娜",
                                                    "text": "不仅劳烦了斯露莎姐姐，还有第一次见面的「谒颂主」大人，我得好好准备给你们的谢礼…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "733220637",
                                            "text": "拯救花灵的猫猫和狗狗！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "733220619",
                            "text": "关于「净觉花」…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7332207",
            "initDialog": "733220701",
            "dialogues": [
                {
                    "id": "733220701",
                    "speaker": "瑟法娜",
                    "text": "唉…这就是黯色侵蚀的余威吗？"
                },
