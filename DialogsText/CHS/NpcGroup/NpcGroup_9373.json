{
    "groupId": "9373",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "芙宁娜": 9
    },
    "talks": [
        {
            "talkId": "6937301",
            "initDialog": "693730101",
            "dialogues": [
                {
                    "id": "693730101",
                    "speaker": "芙宁娜",
                    "text": "真是怠慢啊，接待枫丹大明星的地方，难道不应该更加热闹一些吗？"
                },
                {
                    "id": "693730102",
                    "speaker": "芙宁娜",
                    "text": "算了，就当是休整一下吧。"
                },
                {
                    "id": "693730103",
                    "speaker": "芙宁娜",
                    "text": "为了展现出我的最佳状态，补充糖分也是必要的嘛。"
                }
            ]
        },
        {
            "talkId": "6937302",
            "initDialog": "693730201",
            "dialogues": [
                {
                    "id": "693730201",
                    "speaker": "芙宁娜",
                    "text": "只是一些挡路的魔物而已，应该不需要我本人出手吧…"
                },
                {
                    "id": "693730202",
                    "speaker": "芙宁娜",
                    "text": "嗯…咳咳，我刚刚看到你给的情报，该说确实不好对付还是…我今天有点提不起精神…"
                },
                {
                    "id": "693730203",
                    "speaker": "芙宁娜",
                    "text": "倒不是怕了他们！如果你执意邀请我共演的话，我也不会拒绝你的就是了。"
                }
            ]
        },
        {
            "talkId": "6937303",
            "initDialog": "693730301",
            "dialogues": [
                {
                    "id": "693730301",
                    "speaker": "芙宁娜",
                    "text": "阅读故事书的时候，我常常会在脑海内构想出画面。"
                },
                {
                    "id": "693730302",
                    "speaker": "芙宁娜",
                    "text": "人物的神情，场景的颜色，空气中流动的韵律…我把文字改编成精彩的演出，期待着戏中人能走向何方。"
                },
                {
                    "id": "693730303",
                    "speaker": "芙宁娜",
                    "text": "你看，不止是大明星，我连「导演」一职也能担任得足够完美！"
                }
            ]
        }
    ]
}