{
    "groupId": "7000",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Player": 13,
        "凯瑟琳": 25
    },
    "talks": [
        {
            "talkId": "6700001",
            "initDialog": "670000101",
            "dialogues": [
                {
                    "id": "670000101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。"
                }
            ]
        },
        {
            "talkId": "6700002",
            "initDialog": "670000201",
            "dialogues": [
                {
                    "id": "670000201",
                    "speaker": "Player",
                    "text": "领取「冒险等阶」奖励"
                }
            ]
        },
        {
            "talkId": "6700003",
            "initDialog": "670000301",
            "dialogues": [
                {
                    "id": "670000301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「冒险等阶」奖励</color>"
                }
            ]
        },
        {
            "talkId": "6700004",
            "initDialog": "670000401",
            "dialogues": [
                {
                    "id": "670000401",
                    "speaker": "Player",
                    "text": "你好，凯瑟琳。"
                },
                {
                    "id": "670000402",
                    "speaker": "凯瑟琳",
                    "text": "很高兴见到你。"
                },
                {
                    "id": "670000403",
                    "speaker": "凯瑟琳",
                    "text": "我是冒险家协会的接待员凯瑟琳，负责为冒险家们提供任务发布和情报支援工作。"
                },
                {
                    "id": "670000404",
                    "speaker": "凯瑟琳",
                    "text": "挪德卡莱边疆区是一片充满机遇的土地，希望你在这里也能经历令人兴奋的冒险。"
                }
            ]
        },
        {
            "talkId": "6700005",
            "initDialog": "670000501",
            "dialogues": [
                {
                    "id": "670000501",
                    "speaker": "Player",
                    "text": "关于挪德卡莱…"
                },
                {
                    "id": "670000502",
                    "speaker": "凯瑟琳",
                    "text": "对各位冒险家而言，至冬广袤的土地应该是大展身手的优秀舞台。"
                },
                {
                    "id": "670000503",
                    "speaker": "凯瑟琳",
                    "text": "只不过，最近汇聚在边疆区的势力实在是有些太多了。作为冒险家，行动时还请注意安全。"
                }
            ]
        },
        {
            "talkId": "6700006",
            "initDialog": "670000601",
            "dialogues": [
                {
                    "id": "670000601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670000602",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，冒险家。"
                }
            ]
        },
        {
            "talkId": "6700007",
            "initDialog": "670000701",
            "dialogues": [
                {
                    "id": "670000701",
                    "speaker": "凯瑟琳",
                    "text": "查看「豪斗旅纪」信息"
                }
            ]
        },
        {
            "talkId": "6700008",
            "initDialog": "670000801",
            "dialogues": [
                {
                    "id": "670000801",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>查看「豪斗旅纪」信息</color>"
                }
            ]
        },
        {
            "talkId": "6700009",
            "initDialog": "670000901",
            "dialogues": [
                {
                    "id": "670000901",
                    "speaker": "Player",
                    "text": "情报交易"
                }
            ]
        },
        {
            "talkId": "6700010",
            "initDialog": "670001001",
            "dialogues": [
                {
                    "id": "670001001",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>情报交易</color>"
                }
            ]
        },
        {
            "talkId": "6700011",
            "initDialog": "670001101",
            "dialogues": [
                {
                    "id": "670001101",
                    "speaker": "凯瑟琳",
                    "text": "情报交易"
                },
                {
                    "id": "670001102",
                    "speaker": "Player",
                    "text": "（似乎只有与「秘闻馆」相关之人才能进行交易…）"
                }
            ]
        },
        {
            "talkId": "6700012",
            "initDialog": "670001201",
            "dialogues": [
                {
                    "id": "670001201",
                    "speaker": "凯瑟琳",
                    "text": "欢迎来到冒险家协会，「木偶」大人。有什么我能为您做的吗？"
                }
            ]
        },
        {
            "talkId": "6700013",
            "initDialog": "670001301",
            "dialogues": [
                {
                    "id": "670001301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670001302",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，「木偶」大人。"
                }
            ]
        },
        {
            "talkId": "7068807",
            "initDialog": "706880701",
            "dialogues": [
                {
                    "id": "706880701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么厉害的委托吗？</color>"
                },
                {
                    "id": "706880702",
                    "speaker": "凯瑟琳",
                    "text": "您来的正巧，有一份协会共享给资深冒险家的手册要交给您。",
                    "choices": [
                        {
                            "id": "706880703",
                            "text": "是提瓦特美食大全吗？",
                            "response": [
                                {
                                    "id": "706880704",
                                    "speaker": "凯瑟琳",
                                    "text": "很遗憾，并不是。"
                                },
                                {
                                    "id": "706880707",
                                    "speaker": "凯瑟琳",
                                    "text": "如您所见，手册记录了值得挑战的强敌的信息。"
                                },
                                {
                                    "id": "706880708",
                                    "speaker": "凯瑟琳",
                                    "text": "若能合理利用，想必会为您的冒险旅途增加许多助益。之后如果需要查阅相关信息，也随时欢迎您来。"
                                },
                                {
                                    "id": "706880709",
                                    "speaker": "凯瑟琳",
                                    "text": "那么，就祝您旗开得胜。"
                                }
                            ]
                        },
                        {
                            "id": "706880705",
                            "text": "难道又是新的任务…",
                            "response": [
                                {
                                    "id": "706880706",
                                    "speaker": "凯瑟琳",
                                    "text": "挑战与否，选择权当然在您。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "2010136",
            "initDialog": "201013601",
            "dialogues": [
                {
                    "id": "201013601",
                    "speaker": "凯瑟琳",
                    "text": "领取「每日委托」奖励"
                },
                {
                    "id": "201013602",
                    "speaker": "凯瑟琳",
                    "text": "很抱歉，今天你完成的委托数量还不够呢。"
                }
            ]
        },
        {
            "talkId": "2010137",
            "initDialog": "201013701",
            "dialogues": [
                {
                    "id": "201013701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013702",
                    "speaker": "凯瑟琳",
                    "text": "感谢你完成了今天的委托，这是给你的奖励。"
                }
            ]
        },
        {
            "talkId": "2010138",
            "initDialog": "201013801",
            "dialogues": [
                {
                    "id": "201013801",
                    "speaker": "凯瑟琳",
                    "text": "<color=#999999FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013802",
                    "speaker": "凯瑟琳",
                    "text": "你已经领取过今天的奖励了，希望你明天也能继续承接协会的委托。"
                }
            ]
        },
        {
            "talkId": "2010141",
            "initDialog": "201014101",
            "dialogues": [
                {
                    "id": "201014101",
                    "speaker": "凯瑟琳",
                    "text": "探索派遣"
                }
            ]
        },
        {
            "talkId": "2010142",
            "initDialog": "201014201",
            "dialogues": [
                {
                    "id": "201014201",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>探索派遣</color>"
                }
            ]
        }
    ]
}