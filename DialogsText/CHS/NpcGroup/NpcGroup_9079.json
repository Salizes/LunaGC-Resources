{
    "groupId": "9079",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Player": 12,
        "迪希雅": 41
    },
    "talks": [
        {
            "talkId": "6907901",
            "initDialog": "690790101",
            "dialogues": [
                {
                    "id": "690790101",
                    "speaker": "迪希雅",
                    "text": "这地方虽然舒坦，但也没什么事可干。实在有些无聊啊…"
                },
                {
                    "id": "690790102",
                    "speaker": "迪希雅",
                    "text": "#哦？{NICKNAME}，你总算来了，是拿到什么好委托了吗？"
                }
            ]
        },
        {
            "talkId": "6907902",
            "initDialog": "690790201",
            "dialogues": [
                {
                    "id": "690790201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690790202",
                    "speaker": "迪希雅",
                    "text": "哈哈哈，这里比沙漠可好多了。气温不会忽冷忽热，没有沙暴和狂风…"
                },
                {
                    "id": "690790203",
                    "speaker": "迪希雅",
                    "text": "地里不会突然钻出魔物，天上没有那些时刻想飞下来抢食吃的赤鹫。"
                },
                {
                    "id": "690790204",
                    "speaker": "Player",
                    "text": "沙漠里也太难生存了吧？！"
                },
                {
                    "id": "690790205",
                    "speaker": "迪希雅",
                    "text": "如果想要在沙漠生存，这些都是必须解决的问题。"
                },
                {
                    "id": "690790206",
                    "speaker": "迪希雅",
                    "text": "除了这些问题之外，还要提防着那些不怀好意的人…"
                },
                {
                    "id": "690790207",
                    "speaker": "迪希雅",
                    "text": "哎呀，你怎么皱着眉，不会是被我说的这些事给吓住了吧？"
                },
                {
                    "id": "690790208",
                    "speaker": "迪希雅",
                    "text": "放心吧，你还有我这个帮手啊。如果你之后要进沙漠办事的话，叫上我就行。所有事情都包在我身上。"
                }
            ]
        },
        {
            "talkId": "6907903",
            "initDialog": "690790301",
            "dialogues": [
                {
                    "id": "690790301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690790302",
                    "speaker": "迪希雅",
                    "text": "行啊，我正闲着无聊呢。"
                },
                {
                    "id": "690790303",
                    "speaker": "迪希雅",
                    "text": "你知道沙漠里有一种「淤湖」吗？"
                },
                {
                    "id": "690790304",
                    "speaker": "Player",
                    "text": "类似丰饶绿洲里的那种湖？"
                },
                {
                    "id": "690790305",
                    "speaker": "迪希雅",
                    "text": "唔，那可有些不一样。"
                },
                {
                    "id": "690790306",
                    "speaker": "迪希雅",
                    "text": "这种「淤湖」一般出现在沙漠的深处，在一些神神叨叨的传说里，这种「淤湖」是阿赫玛尔的恩赐。"
                },
                {
                    "id": "690790307",
                    "speaker": "迪希雅",
                    "text": "当他的子民在沙漠中受困时，阿赫玛尔就会命令地下的水源溢出地表，形成这种湖供人解渴…"
                },
                {
                    "id": "690790308",
                    "speaker": "迪希雅",
                    "text": "不过，这种说法也就仅仅是传说而已啦。"
                },
                {
                    "id": "690790309",
                    "speaker": "迪希雅",
                    "text": "虽然「淤湖」的水源确实是沙漠底部的地下水，但这种湖水的味道又苦又涩，根本无法入口，也没法解渴。"
                },
                {
                    "id": "690790310",
                    "speaker": "迪希雅",
                    "text": "而且，这种「淤湖」通常在一段时间后就会被风沙掩埋，也没法起到地标的作用。",
                    "choices": [
                        {
                            "id": "690790311",
                            "text": "那这种湖有什么用？",
                            "response": [
                                {
                                    "id": "690790313",
                                    "speaker": "迪希雅",
                                    "text": "你别说。我之前听说冒险家协会曾经真的接受过一次和「淤湖」有关的委托。"
                                },
                                {
                                    "id": "690790314",
                                    "speaker": "迪希雅",
                                    "text": "委托的具体内容…大概就是一群来须弥旅游的外国人想去沙漠里看看这种「淤湖」。"
                                },
                                {
                                    "id": "690790315",
                                    "speaker": "迪希雅",
                                    "text": "于是冒险家协会就挑选了一群经验比较丰富的冒险家，护送着他们进了沙漠。"
                                },
                                {
                                    "id": "690790316",
                                    "speaker": "迪希雅",
                                    "text": "然后…据说冒险家协会就再也没有接受过类似的委托了。"
                                }
                            ]
                        },
                        {
                            "id": "690790312",
                            "text": "那不只能看一看了…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907904",
            "initDialog": "690790401",
            "dialogues": [
                {
                    "id": "690790401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690790402",
                    "speaker": "迪希雅",
                    "text": "在这里？唔，一时半会我也想不出什么特别想做的事…"
                },
                {
                    "id": "690790403",
                    "speaker": "迪希雅",
                    "text": "非要说的话，就是把这个地方先逛个遍吧。"
                },
                {
                    "id": "690790404",
                    "speaker": "迪希雅",
                    "text": "我还是第一次进到一盏壶里呢，说出去应该都没人相信。"
                },
                {
                    "id": "690790405",
                    "speaker": "Player",
                    "text": "你平时休息的时候会做什么？"
                },
                {
                    "id": "690790406",
                    "speaker": "迪希雅",
                    "text": "那当然是保养一下武器，看看下份要解决的委托，再抓紧时间睡一觉。"
                },
                {
                    "id": "690790407",
                    "speaker": "迪希雅",
                    "text": "最多也就是去城里的酒馆喝几杯放松…虽然说出来很好笑，但我基本上没有闲下来过这么长时间。",
                    "choices": [
                        {
                            "id": "690790408",
                            "text": "真是辛苦…",
                            "response": [
                                {
                                    "id": "690790410",
                                    "speaker": "迪希雅",
                                    "text": "想要生活下去就得这样，每个人都有各自不同的压力，这也是没有办法的事。"
                                },
                                {
                                    "id": "690790411",
                                    "speaker": "迪希雅",
                                    "text": "特别是佣兵这行，一般在上一份委托没有结束时，我们就要去找下一份委托了。"
                                },
                                {
                                    "id": "690790412",
                                    "speaker": "迪希雅",
                                    "text": "在这行讨生活的人这么多，如果干活不积极，那就要吃了上顿没下顿喽。"
                                },
                                {
                                    "id": "690790413",
                                    "speaker": "迪希雅",
                                    "text": "哈哈哈，行了行了，先别说这种话题了，好不容易托你的福能闲下来，我可得抓紧时间放松一下。"
                                },
                                {
                                    "id": "690790414",
                                    "speaker": "迪希雅",
                                    "text": "不然，等会你领着我去周围逛逛？再给我介绍一下这壶的其他住客。"
                                },
                                {
                                    "id": "690790415",
                                    "speaker": "迪希雅",
                                    "text": "特别是那只叫做阿圆的小鸟，看起来，她也有一盏壶？"
                                }
                            ]
                        },
                        {
                            "id": "690790409",
                            "text": "也太拼命了…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907905",
            "initDialog": "690790501",
            "dialogues": [
                {
                    "id": "690790501",
                    "speaker": "Player",
                    "text": "早啊，迪希雅。"
                },
                {
                    "id": "690790502",
                    "speaker": "迪希雅",
                    "text": "你看着很精神嘛，这里的环境确实不错，昨晚上我睡得很好。"
                },
                {
                    "id": "690790503",
                    "speaker": "迪希雅",
                    "text": "而且我早上居然是自然醒来的，而不是被什么响动吵醒…说实话，还是有点不太习惯。"
                }
            ]
        },
        {
            "talkId": "6907906",
            "initDialog": "690790601",
            "dialogues": [
                {
                    "id": "690790601",
                    "speaker": "Player",
                    "text": "晚安，迪希雅。"
                },
                {
                    "id": "690790602",
                    "speaker": "迪希雅",
                    "text": "你要休息了吗？嗯，安心睡觉去吧，我再去周围逛逛。"
                },
                {
                    "id": "690790603",
                    "speaker": "迪希雅",
                    "text": "虽然按你的说法，这盏壶是绝对安全的。但睡觉时连个值守的人都没有…我还是有点不放心。"
                }
            ]
        },
        {
            "talkId": "6907907",
            "initDialog": "690790701",
            "dialogues": [
                {
                    "id": "690790701",
                    "speaker": "迪希雅",
                    "text": "旗帜和武器架，是佣兵在外扎营时的两大自保手段。"
                },
                {
                    "id": "690790702",
                    "speaker": "迪希雅",
                    "text": "一般来说，只要竖起代表自己佣兵团的旗帜，稍微有点眼力的佣兵就不会过来自讨不痛快。"
                },
                {
                    "id": "690790703",
                    "speaker": "迪希雅",
                    "text": "如果有人不顾这种警告，依然过来找麻烦…这个时候，就该武器架派上用场了。"
                }
            ]
        },
        {
            "talkId": "6907908",
            "initDialog": "690790801",
            "dialogues": [
                {
                    "id": "690790801",
                    "speaker": "迪希雅",
                    "text": "你是把整座烤肉店都搬过来了吗？烤肉的工具这么齐全，而且连桌椅炉台都是整套的。"
                },
                {
                    "id": "690790802",
                    "speaker": "迪希雅",
                    "text": "既然你都准备得这么好了…那我必须让你见识一下我烤肉的手艺。"
                },
                {
                    "id": "690790803",
                    "speaker": "迪希雅",
                    "text": "什么？这里的动物都不能猎？行吧，我先出去一趟，带点新鲜的肉回来…"
                }
            ]
        }
    ]
}