    "talks": [
        {
            "talkId": "6305101",
            "initDialog": "630510101",
            "dialogues": [
                {
                    "id": "630510101",
                    "speaker": "宏一",
                    "text": "小绿，小绿，再来讲讲外面的世界吧！"
                },
                {
                    "id": "630510102",
                    "speaker": "小绿",
                    "text": "嘻嘻，又来了吗，真拿你没办法…"
                },
                {
                    "id": "630510103",
                    "speaker": "小绿",
                    "text": "看你这可怜样，今天就再讲些你不知道的！说吧，想听什么？"
                },
                {
                    "id": "630510104",
                    "speaker": "宏一",
                    "text": "海对岸的璃月，是什么样子的？"
                },
                {
                    "id": "630510105",
                    "speaker": "小绿",
                    "text": "璃月的石头最出名，你也知道吧？"
                },
                {
                    "id": "630510106",
                    "speaker": "小绿",
                    "text": "但你肯定不知道，璃月的石头都是小动物，会跑、会叫、会大跳！"
                },
                {
                    "id": "630510107",
                    "speaker": "宏一",
                    "text": "哇！这么有趣…枫丹呢？"
                },
                {
                    "id": "630510108",
                    "speaker": "小绿",
                    "text": "枫丹的道路都建在空中，人们坐的马车像白鹭一样飞行，从村子一头到另一头，一瞬间就到了~！"
                },
                {
                    "id": "630510109",
                    "speaker": "宏一",
                    "text": "好厉害！那…那须弥呢？"
                },
                {
                    "id": "630510110",
                    "speaker": "小绿",
                    "text": "须弥人过得就很辛苦了，毕竟地上全是草。"
                },
                {
                    "id": "630510111",
                    "speaker": "小绿",
                    "text": "吃的是草叶，喝的是草汁。没有鸟蛋烧，也没有三彩团子。"
                },
                {
                    "id": "630510112",
                    "speaker": "宏一",
                    "text": "须弥人好可怜哦…"
                },
                {
                    "id": "630510113",
                    "speaker": "宏一",
                    "text": "要不是因为不能出国，我现在已经在海的对岸了吧…"
                },
                {
                    "id": "630510114",
                    "speaker": "宏一",
                    "text": "呜呜，石头动物、飞行马车，等我…"
                }
            ]
        },
        {
