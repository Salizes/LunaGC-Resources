{
    "groupId": "4310",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "鲁达贝": 18
    },
    "talks": [
        {
            "talkId": "6431001",
            "initDialog": "643100101",
            "dialogues": [
                {
                    "id": "643100101",
                    "speaker": "鲁达贝",
                    "text": "你好，请问…你也是林行者吗？"
                },
                {
                    "id": "643100102",
                    "speaker": "鲁达贝",
                    "text": "介意我问你几个问题吗？"
                }
            ]
        },
        {
            "talkId": "6431002",
            "initDialog": "643100201",
            "dialogues": [
                {
                    "id": "643100201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "643100202",
                    "speaker": "鲁达贝",
                    "text": "哎呀，抱歉忘了先自我介绍。"
                },
                {
                    "id": "643100203",
                    "speaker": "鲁达贝",
                    "text": "我是来自教令院的生论派学者，正在进行关于雨林的学术考察。"
                },
                {
                    "id": "643100204",
                    "speaker": "鲁达贝",
                    "text": "说来惭愧…因为囊中羞涩，我还没能雇到合适的保镖，所以暂时只能在有巡林员看守的地方做小范围的采访调查。"
                }
            ]
        },
        {
            "talkId": "6431003",
            "initDialog": "643100301",
            "dialogues": [
                {
                    "id": "643100301",
                    "speaker": "Player",
                    "text": "我不是哦。"
                },
                {
                    "id": "643100302",
                    "speaker": "鲁达贝",
                    "text": "唔…真遗憾。"
                },
                {
                    "id": "643100303",
                    "speaker": "鲁达贝",
                    "text": "不过其他人的观点…似乎也不是不能参考？"
                },
                {
                    "id": "643100304",
                    "speaker": "鲁达贝",
                    "text": "只是不知道你对道成林的情况了解吗？"
                },
                {
                    "id": "643100305",
                    "speaker": "鲁达贝",
                    "text": "关于大慈树王大人在雨林中留下的踪迹，又见到过多少呢？"
                },
                {
                    "id": "643100306",
                    "speaker": "鲁达贝",
                    "text": "…啊，抱歉，拖着你讲了这么久。你如果不介意的话，可以抽空找我聊聊哦。"
                }
            ]
        },
        {
            "talkId": "6431004",
            "initDialog": "643100401",
            "dialogues": [
                {
                    "id": "643100401",
                    "speaker": "Player",
                    "text": "抱歉，帮不上忙。"
                },
                {
                    "id": "643100402",
                    "speaker": "鲁达贝",
                    "text": "唉，是我冒昧了…没关系，还是谢谢你。"
                }
            ]
        },
        {
            "talkId": "6431005",
            "initDialog": "643100501",
            "dialogues": [
                {
                    "id": "643100501",
                    "speaker": "Player",
                    "text": "我不是哦。"
                },
                {
                    "id": "643100502",
                    "speaker": "鲁达贝",
                    "text": "唔…真遗憾。"
                },
                {
                    "id": "643100503",
                    "speaker": "鲁达贝",
                    "text": "不过其他人的观点…似乎也不是不能参考？"
                },
                {
                    "id": "643100504",
                    "speaker": "鲁达贝",
                    "text": "只是不知道你对道成林的情况了解吗？"
                },
                {
                    "id": "643100505",
                    "speaker": "鲁达贝",
                    "text": "关于草神大人曾在雨林中留下的踪迹，又见到过多少呢？"
                },
                {
                    "id": "643100506",
                    "speaker": "鲁达贝",
                    "text": "…啊，抱歉，拖着你讲了这么久。你如果不介意的话，可以抽空找我聊聊哦。"
                }
            ]
        },
        {
            "talkId": "6431006",
            "initDialog": "643100601",
            "dialogues": [
                {
                    "id": "643100601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6431007",
            "initDialog": "643100701",
            "dialogues": [
                {
                    "id": "643100701",
                    "speaker": "鲁达贝",
                    "text": "…不玩了不玩了，是时候继续进行采访和调查了。"
                }
            ]
        },
        {
            "talkId": "6431008",
            "initDialog": "643100801",
            "dialogues": [
                {
                    "id": "643100801",
                    "speaker": "鲁达贝",
                    "text": "虽然生论派不太擅长计算，不过因为大家私底下经常玩这个…所以比较熟练…"
                }
            ]
        }
    ]
}