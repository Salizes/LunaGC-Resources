{
    "groupId": "9093",
    "total_dialogue_lines": 80,
    "speaker_counts": {
        "Player": 23,
        "闲云": 57
    },
    "talks": [
        {
            "talkId": "6909301",
            "initDialog": "690930101",
            "dialogues": [
                {
                    "id": "690930101",
                    "speaker": "闲云",
                    "text": "这地方风景宜人，又无人打扰，饮食起居所需一应俱全。很适合闭门研究机关嘛。"
                },
                {
                    "id": "690930102",
                    "speaker": "闲云",
                    "text": "难不成从本仙的洞府中得到了灵感吗？"
                }
            ]
        },
        {
            "talkId": "6909302",
            "initDialog": "690930201",
            "dialogues": [
                {
                    "id": "690930201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690930202",
                    "speaker": "闲云",
                    "text": "嗯，这里仙力充盈，视野开阔，不错不错。"
                },
                {
                    "id": "690930203",
                    "speaker": "闲云",
                    "text": "说来，这外景之能，并非常人所能掌握。你是从何处得到这个法宝？"
                },
                {
                    "id": "690930204",
                    "speaker": "Player",
                    "text": "这是萍姥姥所赠。"
                },
                {
                    "id": "690930205",
                    "speaker": "闲云",
                    "text": "噢，原来如此。"
                },
                {
                    "id": "690930206",
                    "speaker": "闲云",
                    "text": "歌尘以前就喜爱游山玩水，又常感叹四时风景皆不相同，一段时间不见，这山水便已变了模样…"
                },
                {
                    "id": "690930207",
                    "speaker": "闲云",
                    "text": "想来她也是运用外景之能，将自己喜欢的景象放入小小的茶壶之中…"
                },
                {
                    "id": "690930208",
                    "speaker": "闲云",
                    "text": "想不到，经你布置，这壶中倒是增加了不少生活气息，成了一个适合起居的好地方。"
                },
                {
                    "id": "690930209",
                    "speaker": "闲云",
                    "text": "下回本仙不想出门觅食的时候，索性跑来你这里蹭饭吧。",
                    "choices": [
                        {
                            "id": "690930210",
                            "text": "自然欢迎。",
                            "response": [
                                {
                                    "id": "690930211",
                                    "speaker": "闲云",
                                    "text": "哦？你倒是很爽快嘛。"
                                },
                                {
                                    "id": "690930212",
                                    "speaker": "闲云",
                                    "text": "那就一言为定。本仙开始期待你会做出怎样的菜肴了。"
                                }
                            ]
                        },
                        {
                            "id": "690930213",
                            "text": "我不一定想下厨…",
                            "response": [
                                {
                                    "id": "690930214",
                                    "speaker": "闲云",
                                    "text": "既然是本仙不请自来，做饭的事情就交给本仙…新改进的烹饪神机吧。"
                                },
                                {
                                    "id": "690930215",
                                    "speaker": "闲云",
                                    "text": "至于要吃什么菜，你就尽管发挥想象力吧。本仙为你实现。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909303",
            "initDialog": "690930301",
            "dialogues": [
                {
                    "id": "690930301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690930302",
                    "speaker": "闲云",
                    "text": "哦？有意思。这可是本仙最擅长的事。"
                },
                {
                    "id": "690930303",
                    "speaker": "闲云",
                    "text": "不过，本仙正在思考一个重要的技术问题…闲聊恐怕还得往后放放。"
                },
                {
                    "id": "690930304",
                    "speaker": "Player",
                    "text": "是什么样的技术问题？"
                },
                {
                    "id": "690930305",
                    "speaker": "闲云",
                    "text": "本仙从前研制过一个「杂务扫理神机」，用于扫地和整理杂物。"
                },
                {
                    "id": "690930306",
                    "speaker": "闲云",
                    "text": "本仙曾为它置入了一些「应声机巧」，只要发出特定声响，就能隔空驱使这机关。"
                },
                {
                    "id": "690930307",
                    "speaker": "闲云",
                    "text": "但没想到，这「应声机巧」还是有些缺陷。若是站得略远，它就无法捕捉声响，也就不能隔空驱使了…"
                },
                {
                    "id": "690930308",
                    "speaker": "闲云",
                    "text": "关于这点…你可有建议？"
                },
                {
                    "id": "690930309",
                    "speaker": "Player",
                    "text": "大声喊叫如何？"
                },
                {
                    "id": "690930310",
                    "speaker": "闲云",
                    "text": "嗯…不可谓不可行，只是略显不雅。"
                },
                {
                    "id": "690930311",
                    "speaker": "闲云",
                    "text": "但经你一提，倒是给了本仙新的灵感。本仙不妨再制作一个…「传波扩声神机」。"
                },
                {
                    "id": "690930312",
                    "speaker": "闲云",
                    "text": "只要神机集采仙力，千里传音，再行驱动其他神机…本仙便连走动的时间都可以省下了。妙！",
                    "choices": [
                        {
                            "id": "690930313",
                            "text": "仙力真是方便啊…",
                            "response": [
                                {
                                    "id": "690930315",
                                    "speaker": "闲云",
                                    "text": "好了，本仙的难题已解大半，该说回正题了。"
                                },
                                {
                                    "id": "690930316",
                                    "speaker": "闲云",
                                    "text": "你说要与本仙聊天，是想听本仙讲故事吗？",
                                    "choices": [
                                        {
                                            "id": "690930317",
                                            "text": "对！我会带上好茶。",
                                            "response": [
                                                {
                                                    "id": "690930318",
                                                    "speaker": "闲云",
                                                    "text": "你倒是懂事。有好茶润喉，本仙的故事…当然也会讲得更流利了。"
                                                },
                                                {
                                                    "id": "690930321",
                                                    "speaker": "闲云",
                                                    "text": "不过…咳，有些故事本仙还得先去征询老友的意见，才好和你细讲。"
                                                },
                                                {
                                                    "id": "690930322",
                                                    "speaker": "闲云",
                                                    "text": "与你熟识的那几个小辈，唉，本仙一谈起她们的童年趣事，这些孩子就皱眉耷眼的…"
                                                },
                                                {
                                                    "id": "690930323",
                                                    "speaker": "闲云",
                                                    "text": "还是与你聊天时，本仙最为舒适。不过…你倒是没怎么和本仙提起，你与派蒙先前经历的事。",
                                                    "choices": [
                                                        {
                                                            "id": "690930324",
                                                            "text": "那个，我还有事…",
                                                            "response": [
                                                                {
                                                                    "id": "690930326",
                                                                    "speaker": "闲云",
                                                                    "text": "哼…小小心思，你不想说，本仙也不问。"
                                                                },
                                                                {
                                                                    "id": "690930327",
                                                                    "speaker": "闲云",
                                                                    "text": "去吧，想说的时候再来找本仙，本仙保证守口如瓶。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690930325",
                                                            "text": "我去拿茶，您在这稍等！"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690930319",
                                            "text": "对！想听好故事。",
                                            "response": [
                                                {
                                                    "id": "690930320",
                                                    "speaker": "闲云",
                                                    "text": "本仙的故事…当然全是好故事。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690930314",
                            "text": "不愧是机关术…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909304",
            "initDialog": "690930401",
            "dialogues": [
                {
                    "id": "690930401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690930402",
                    "speaker": "闲云",
                    "text": "倒也没什么特别想做的事。尘世凡人忙碌奔波，皆是因光阴苦短，生怕虚度了少许，就被旁人抛在后面。"
                },
                {
                    "id": "690930403",
                    "speaker": "闲云",
                    "text": "本仙…从未如此想过。"
                },
                {
                    "id": "690930404",
                    "speaker": "闲云",
                    "text": "仙家本就不入红尘，弹指光阴百年，本仙又专心研究机关，对身外之事无所挂碍。"
                },
                {
                    "id": "690930405",
                    "speaker": "闲云",
                    "text": "可能…或许…嗯…除了那几个孩子。"
                },
                {
                    "id": "690930406",
                    "speaker": "Player",
                    "text": "那就…干脆休息休息？"
                },
                {
                    "id": "690930407",
                    "speaker": "闲云",
                    "text": "呵呵…你倒是又提了一件本仙擅长的事。"
                },
                {
                    "id": "690930408",
                    "speaker": "闲云",
                    "text": "言已至此，本仙不如分享你一些新奇的休憩方法吧。"
                },
                {
                    "id": "690930409",
                    "speaker": "Player",
                    "text": "休憩也有方法？"
                },
                {
                    "id": "690930410",
                    "speaker": "闲云",
                    "text": "正是。你来瞧瞧本仙写的这些。"
                },
                {
                    "id": "690930411",
                    "speaker": "闲云",
                    "text": "「找陌生人打牌」，「去琥牢山敲琥珀」…当本仙想要休憩，又不知道做什么时，就会从中抽选。",
                    "choices": [
                        {
                            "id": "690930412",
                            "text": "听起来像是…奇怪的抽签。",
                            "response": [
                                {
                                    "id": "690930413",
                                    "speaker": "闲云",
                                    "text": "怪又有何干，只要寻些乐趣，放松身心就好。"
                                },
                                {
                                    "id": "690930416",
                                    "speaker": "闲云",
                                    "text": "当然，你若是有什么其他有效的休憩方法，也尽管说给本仙听。",
                                    "choices": [
                                        {
                                            "id": "690930417",
                                            "text": "今日只想走神。",
                                            "response": [
                                                {
                                                    "id": "690930419",
                                                    "speaker": "闲云",
                                                    "text": "唔，偶尔神游天外也不错，说不定会捕到一些寻常劳碌中捉不到的灵光。"
                                                },
                                                {
                                                    "id": "690930420",
                                                    "speaker": "闲云",
                                                    "text": "只是，不知道你这盏茶壶里，究竟哪里适合做这件事…"
                                                },
                                                {
                                                    "id": "690930421",
                                                    "speaker": "闲云",
                                                    "text": "这里的风景能够跟随你的心意而动吧？不如…造个绝云间出来？"
                                                },
                                                {
                                                    "id": "690930422",
                                                    "speaker": "闲云",
                                                    "text": "不，无须如此劳烦。咱们就回绝云间去。本仙使点腾云的本事，带你遨游云间怎么样？"
                                                },
                                                {
                                                    "id": "690930423",
                                                    "speaker": "Player",
                                                    "text": "好像也不错。"
                                                },
                                                {
                                                    "id": "690930424",
                                                    "speaker": "闲云",
                                                    "text": "就这么办。待本仙稍作规划，带上神机一二，我们这就出发！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690930418",
                                            "text": "今天适合发呆。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690930414",
                            "text": "这类事情已经做过不少了。",
                            "response": [
                                {
                                    "id": "690930415",
                                    "speaker": "闲云",
                                    "text": "哦？不妨说说感想？本仙颇有兴趣。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909305",
            "initDialog": "690930501",
            "dialogues": [
                {
                    "id": "690930501",
                    "speaker": "Player",
                    "text": "早安，闲云。"
                },
                {
                    "id": "690930502",
                    "speaker": "闲云",
                    "text": "早啊，你起得还挺早的嘛。"
                },
                {
                    "id": "690930503",
                    "speaker": "闲云",
                    "text": "忙着去行侠仗义，还是肚子饿了起来吃早餐？多穿些衣服，别凉着了。"
                }
            ]
        },
        {
            "talkId": "6909306",
            "initDialog": "690930601",
            "dialogues": [
                {
                    "id": "690930601",
                    "speaker": "Player",
                    "text": "晚安，闲云。"
                },
                {
                    "id": "690930602",
                    "speaker": "闲云",
                    "text": "晚安。夜里清净，正是研究机关术的良机。"
                },
                {
                    "id": "690930603",
                    "speaker": "闲云",
                    "text": "你也有兴趣？那么，要来当本仙的临时助手吗？"
                }
            ]
        },
        {
            "talkId": "6909307",
            "initDialog": "690930701",
            "dialogues": [
                {
                    "id": "690930701",
                    "speaker": "闲云",
                    "text": "哦？仿效人间村落，打造出如此幽静的地方…"
                },
                {
                    "id": "690930702",
                    "speaker": "闲云",
                    "text": "很适合坐下来静思冥想…"
                },
                {
                    "id": "690930703",
                    "speaker": "闲云",
                    "text": "难不成…本仙捣鼓机关整晚没睡的事情被你发现了？"
                }
            ]
        },
        {
            "talkId": "6909308",
            "initDialog": "690930801",
            "dialogues": [
                {
                    "id": "690930801",
                    "speaker": "闲云",
                    "text": "特意带本仙来小吃摊位吗？看起来做法都不复杂，本仙在家也能给你做。又何须外出！"
                },
                {
                    "id": "690930802",
                    "speaker": "闲云",
                    "text": "嗯？这个香味是…"
                },
                {
                    "id": "690930803",
                    "speaker": "闲云",
                    "text": "咳…既然来了，快找个位置坐下来点菜吧！"
                }
            ]
        }
    ]
}