{
    "groupId": "1799",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 8,
        "艾玛托": 26
    },
    "talks": [
        {
            "talkId": "6179901",
            "initDialog": "617990101",
            "dialogues": [
                {
                    "id": "617990101",
                    "speaker": "艾玛托",
                    "text": "新的炸药更稳定了…只要能把成本压下来，安定性提上去，就大功告成了。"
                }
            ]
        },
        {
            "talkId": "6179902",
            "initDialog": "617990201",
            "dialogues": [
                {
                    "id": "617990201",
                    "speaker": "Player",
                    "text": "在干嘛呢？"
                },
                {
                    "id": "617990202",
                    "speaker": "艾玛托",
                    "text": "啊啊，是荣誉骑士！你好你好！"
                },
                {
                    "id": "617990203",
                    "speaker": "艾玛托",
                    "text": "调查小队武器官艾玛托报告，我的新型炸药已经试制成功了！"
                },
                {
                    "id": "617990204",
                    "speaker": "艾玛托",
                    "text": "目前看来，爆速的理想值，已经达到火花骑士蹦蹦炸弹五分之一的水准。"
                },
                {
                    "id": "617990205",
                    "speaker": "艾玛托",
                    "text": "量产后的综合效能有望进一步提高到十分之一的水准…"
                },
                {
                    "id": "617990206",
                    "speaker": "艾玛托",
                    "text": "…前提是火花骑士大人的炸药水平，一直保持在我之前观测到的水准…",
                    "choices": [
                        {
                            "id": "617990207",
                            "text": "等等，这不矛盾吗？",
                            "response": [
                                {
                                    "id": "617990210",
                                    "speaker": "艾玛托",
                                    "text": "因为威力越大，成本越高，但量产炸药又必须注意价钱和生产性，以及运输和携带过程中的安全。"
                                },
                                {
                                    "id": "617990211",
                                    "speaker": "艾玛托",
                                    "text": "一般来说，最终使用的炸药，不会是爆速最高的单一成分，必须要加入钝化和安定剂…"
                                },
                                {
                                    "id": "617990212",
                                    "speaker": "艾玛托",
                                    "text": "这又会影响到加工难度，生产速度，进而作用于产量和性价比，也就是综合评估的「效能」之上。"
                                },
                                {
                                    "id": "617990213",
                                    "speaker": "艾玛托",
                                    "text": "所以，炸药的基础威力越大，效能不一定越高，还需要好好平衡各种成分！",
                                    "choices": [
                                        {
                                            "id": "617990214",
                                            "text": "好苛刻的评估…",
                                            "response": [
                                                {
                                                    "id": "617990216",
                                                    "speaker": "艾玛托",
                                                    "text": "嗯，其实谈不上复杂和严苛，对于想要战胜魔物的人，谁不追求强劲的破坏力呢？"
                                                },
                                                {
                                                    "id": "617990217",
                                                    "speaker": "艾玛托",
                                                    "text": "根据大团长的说法，以及情报官们从纳塔友军那里获得的信息…"
                                                },
                                                {
                                                    "id": "617990218",
                                                    "speaker": "艾玛托",
                                                    "text": "愚人众那位…能用火花骑士的蜡笔，轻松击毁遗迹守卫的执行官「队长」，能…能…能…能…"
                                                },
                                                {
                                                    "id": "617990219",
                                                    "speaker": "艾玛托",
                                                    "text": "能单手一挥，就轻松向两百步外投射十名骑士背负的炸药当量，成片清扫魔物！"
                                                },
                                                {
                                                    "id": "617990220",
                                                    "speaker": "艾玛托",
                                                    "text": "目前根本想象不出，要达成这个等级的破坏力，需要开发出什么样的火器才足够…"
                                                },
                                                {
                                                    "id": "617990221",
                                                    "speaker": "艾玛托",
                                                    "text": "战力的进步，永无止境啊…必须不断努力才行！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "617990215",
                                            "text": "真是严格的追求…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "617990208",
                            "text": "为什么威力是五分之一…"
                        },
                        {
                            "id": "617990209",
                            "text": "效能却是十分之一？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6179903",
            "initDialog": "617990301",
            "dialogues": [
                {
                    "id": "617990301",
                    "speaker": "Player",
                    "text": "先别管炸药了，最近怎么样？"
                },
                {
                    "id": "617990302",
                    "speaker": "艾玛托",
                    "text": "呜啊…这…突然被荣誉骑士关心，好荣幸！"
                },
                {
                    "id": "617990303",
                    "speaker": "艾玛托",
                    "text": "请放心！我、方妮雅和「团团灰」每天都吃饱喝足，睡到满足…"
                },
                {
                    "id": "617990304",
                    "speaker": "艾玛托",
                    "text": "乌苏拉也被部署在荆夫港了，能经常一起吃大餐！"
                },
                {
                    "id": "617990305",
                    "speaker": "艾玛托",
                    "text": "除了没法再看见火花骑士炸鱼的壮观场景，有点遗憾…"
                },
                {
                    "id": "617990306",
                    "speaker": "艾玛托",
                    "text": "还有偶尔要回蒙德，参加开发和学术会议，几乎没什么可挑剔的！"
                },
                {
                    "id": "617990307",
                    "speaker": "艾玛托",
                    "text": "现在，我就是调查小队在荆夫港的门面，要打起精神好好干活。"
                },
                {
                    "id": "617990308",
                    "speaker": "艾玛托",
                    "text": "以我个人的追求，荆夫港也是个超棒的舞台——"
                },
                {
                    "id": "617990309",
                    "speaker": "艾玛托",
                    "text": "在这里，我能和远程小队的同僚们紧密合作，尝试把炸药和铳枪结合起来…"
                },
                {
                    "id": "617990310",
                    "speaker": "艾玛托",
                    "text": "很多以前的设想，说不定能慢慢落地，变为现实了，真兴奋！"
                }
            ]
        },
        {
            "talkId": "6179904",
            "initDialog": "617990401",
            "dialogues": [
                {
                    "id": "617990401",
                    "speaker": "Player",
                    "text": "加油呀，艾玛托。"
                },
                {
                    "id": "617990402",
                    "speaker": "艾玛托",
                    "text": "多，多谢荣誉骑士鼓励！"
                }
            ]
        }
    ]
}