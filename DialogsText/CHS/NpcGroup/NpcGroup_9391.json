{
    "groupId": "9391",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "玛薇卡": 9
    },
    "talks": [
        {
            "talkId": "6939101",
            "initDialog": "693910101",
            "dialogues": [
                {
                    "id": "693910101",
                    "speaker": "玛薇卡",
                    "text": "如何，还能适应这里的战斗吗？"
                },
                {
                    "id": "693910102",
                    "speaker": "玛薇卡",
                    "text": "我觉得是个很有趣的地方，处处都是惊喜，也没有什么紧张的氛围。"
                },
                {
                    "id": "693910103",
                    "speaker": "玛薇卡",
                    "text": "稍作休息，就准备迎接下一场挑战吧。"
                }
            ]
        },
        {
            "talkId": "6939102",
            "initDialog": "693910201",
            "dialogues": [
                {
                    "id": "693910201",
                    "speaker": "玛薇卡",
                    "text": "这真是个奇妙的空间，总是有新的未知挑战出现，呵呵…"
                },
                {
                    "id": "693910202",
                    "speaker": "玛薇卡",
                    "text": "嗯？我看上去很兴奋吗？毕竟挑战就是我最大的爱好。"
                },
                {
                    "id": "693910203",
                    "speaker": "玛薇卡",
                    "text": "对我来说，这个地方更像是「乐园」，我很喜欢。"
                }
            ]
        },
        {
            "talkId": "6939103",
            "initDialog": "693910301",
            "dialogues": [
                {
                    "id": "693910301",
                    "speaker": "玛薇卡",
                    "text": "好像这里发生的所有事，会被以「剧目」的形式记录下来。"
                },
                {
                    "id": "693910302",
                    "speaker": "玛薇卡",
                    "text": "究竟是谁在背后做这件事呢？他也很看重事迹的传承吗…"
                },
                {
                    "id": "693910303",
                    "speaker": "玛薇卡",
                    "text": "无论如何，这些记录都由我们共享，待到未来回看的时候，可能会有不一样的感受吧。"
                }
            ]
        }
    ]
}