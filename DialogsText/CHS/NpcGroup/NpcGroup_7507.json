    "talks": [
        {
            "talkId": "6750701",
            "initDialog": "675070101",
            "dialogues": [
                {
                    "id": "675070101",
                    "speaker": "波洛维科娃",
                    "text": "沃雅妮莎大人，今天会不会登台演出呢…"
                }
            ]
        },
        {
            "talkId": "6750702",
            "initDialog": "675070201",
            "dialogues": [
                {
                    "id": "675070201",
                    "speaker": "Player",
                    "text": "你在等演出吗？"
                },
                {
                    "id": "675070202",
                    "speaker": "波洛维科娃",
                    "text": "没错！您一定也听说过沃雅妮莎大人的名字吧？…啊，请原谅，您当然听说过！她可是这里最耀眼的明星…"
                },
                {
                    "id": "675070203",
                    "speaker": "波洛维科娃",
                    "text": "不仅歌声如月光般清澈，容颜也像月下的溪水一般璀璨迷人…"
                },
                {
                    "id": "675070204",
                    "speaker": "波洛维科娃",
                    "text": "啊啊，光是回想起来，我就又要沉醉了…"
                }
            ]
        },
        {
            "talkId": "6750703",
            "initDialog": "675070301",
            "dialogues": [
                {
                    "id": "675070301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675070302",
                    "speaker": "波洛维科娃",
                    "text": "唉，真想每天都能听到沃雅妮莎大人的歌声…"
                }
            ]
        }
    ]
}