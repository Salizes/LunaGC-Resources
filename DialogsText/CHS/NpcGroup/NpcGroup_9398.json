{
    "groupId": "9398",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "丝柯克": 9
    },
    "talks": [
        {
            "talkId": "6939801",
            "initDialog": "693980101",
            "dialogues": [
                {
                    "id": "693980101",
                    "speaker": "丝柯克",
                    "text": "和深渊一样，这里的时间流速也和外界不同。"
                },
                {
                    "id": "693980102",
                    "speaker": "丝柯克",
                    "text": "以自己的体感为准吧。"
                },
                {
                    "id": "693980103",
                    "speaker": "丝柯克",
                    "text": "累了就休息，调整好状态再出发。"
                }
            ]
        },
        {
            "talkId": "6939802",
            "initDialog": "693980201",
            "dialogues": [
                {
                    "id": "693980201",
                    "speaker": "丝柯克",
                    "text": "挑战强者的过程总是痛苦的，可能会经历许多次失败，有的伤口要很久才能愈合。"
                },
                {
                    "id": "693980202",
                    "speaker": "丝柯克",
                    "text": "但回看这段旅程，必然有其价值。"
                },
                {
                    "id": "693980203",
                    "speaker": "丝柯克",
                    "text": "当有一天你的眼前再无敌手，等待你的就只剩下孤独。"
                }
            ]
        },
        {
            "talkId": "6939803",
            "initDialog": "693980301",
            "dialogues": [
                {
                    "id": "693980301",
                    "speaker": "丝柯克",
                    "text": "人类喜欢用各种方式记录历史，或许我们所在的地方也是其中一页篇章。"
                },
                {
                    "id": "693980302",
                    "speaker": "丝柯克",
                    "text": "但历史终归是死物，它不会诉说自己。灾难与抗争、遗憾与痛苦，后世回看时只剩下寥寥数语。"
                },
                {
                    "id": "693980303",
                    "speaker": "丝柯克",
                    "text": "所以你要记得沿途的风景，那是无数人活过的痕迹。"
                }
            ]
        }
    ]
}