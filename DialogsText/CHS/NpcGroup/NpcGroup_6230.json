{
    "groupId": "6230",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "阿邦迪": 12
    },
    "talks": [
        {
            "talkId": "6623001",
            "initDialog": "662300101",
            "dialogues": [
                {
                    "id": "662300101",
                    "speaker": "阿邦迪",
                    "text": "你好。是来提供物资的帮手，还是需要我们帮助的同伴呢？"
                }
            ]
        },
        {
            "talkId": "6623002",
            "initDialog": "662300201",
            "dialogues": [
                {
                    "id": "662300201",
                    "speaker": "Player",
                    "text": "关于我在「花羽会」的声望…"
                },
                {
                    "id": "662300202",
                    "speaker": "阿邦迪",
                    "text": "感谢你的物资和帮助，我们会提供相应的报酬的。"
                }
            ]
        },
        {
            "talkId": "6623003",
            "initDialog": "662300301",
            "dialogues": [
                {
                    "id": "662300301",
                    "speaker": "Player",
                    "text": "你好，这里是…"
                },
                {
                    "id": "662300302",
                    "speaker": "阿邦迪",
                    "text": "这个就是花羽会的「曜石图腾柱」啦。"
                },
                {
                    "id": "662300303",
                    "speaker": "阿邦迪",
                    "text": "如果你已经去过其他部族，那可能已经见过类似的石柱了。"
                },
                {
                    "id": "662300304",
                    "speaker": "阿邦迪",
                    "text": "这根图腾柱在我小时候就是这个样子，现在也没有变过，一直见证着花羽会的兴衰起落。"
                },
                {
                    "id": "662300305",
                    "speaker": "阿邦迪",
                    "text": "我想，只要它还存在一天，花羽会就能继续翱翔。"
                }
            ]
        },
        {
            "talkId": "6623004",
            "initDialog": "662300401",
            "dialogues": [
                {
                    "id": "662300401",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "662300402",
                    "speaker": "阿邦迪",
                    "text": "我是负责打理部族物资的帮手，请多关照啦。"
                },
                {
                    "id": "662300403",
                    "speaker": "阿邦迪",
                    "text": "无论是部落的日常事务，还是最最重要的飞行队，都需要各方各面的支持。"
                },
                {
                    "id": "662300404",
                    "speaker": "阿邦迪",
                    "text": "我年轻时是飞行队中的一员，对这一块的需要再清楚不过。"
                },
                {
                    "id": "662300405",
                    "speaker": "阿邦迪",
                    "text": "虽然现在年纪大了，一到龙背上就开始头晕，但还是闲不住啊。"
                },
                {
                    "id": "662300406",
                    "speaker": "阿邦迪",
                    "text": "能在这里给大家帮忙，算是非常适合我的工作了。"
                }
            ]
        },
        {
            "talkId": "6623005",
            "initDialog": "662300501",
            "dialogues": [
                {
                    "id": "662300501",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "662300502",
                    "speaker": "阿邦迪",
                    "text": "请慢走，要注意安全哦。"
                }
            ]
        }
    ]
}