{
    "groupId": "3064",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "毅": 8
    },
    "talks": [
        {
            "talkId": "6306401",
            "initDialog": "630640101",
            "dialogues": [
                {
                    "id": "630640101",
                    "speaker": "毅",
                    "text": "此处乃禁地，未经许可，禁止入内。"
                }
            ]
        },
        {
            "talkId": "6306402",
            "initDialog": "630640201",
            "dialogues": [
                {
                    "id": "630640201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "630640202",
                    "speaker": "毅",
                    "text": "我身居「奥诘众」一职，只听从将军大人的直接命令。"
                }
            ]
        },
        {
            "talkId": "6306403",
            "initDialog": "630640301",
            "dialogues": [
                {
                    "id": "630640301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630640302",
                    "speaker": "毅",
                    "text": "嗯，速速离开吧。"
                }
            ]
        },
        {
            "talkId": "6306404",
            "initDialog": "630640401",
            "dialogues": [
                {
                    "id": "630640401",
                    "speaker": "Player",
                    "text": "「奥诘众」？"
                },
                {
                    "id": "630640402",
                    "speaker": "毅",
                    "text": "通俗来说，就是将军大人的贴身护卫。"
                },
                {
                    "id": "630640403",
                    "speaker": "毅",
                    "text": "「奥诘众」存在的意义，就是保证将军身边随时都有能够无条件信任并调用的力量。"
                },
                {
                    "id": "630640404",
                    "speaker": "毅",
                    "text": "所以对我们而言最重要的东西，就是忠诚。"
                }
            ]
        },
        {
            "talkId": "6306405",
            "initDialog": "630640501",
            "dialogues": [
                {
                    "id": "630640501",
                    "speaker": "Player",
                    "text": "将军也需要有人守门？"
                },
                {
                    "id": "630640502",
                    "speaker": "毅",
                    "text": "将军大人自然不需要我等守护，我在这里保护的是普通人。"
                },
                {
                    "id": "630640503",
                    "speaker": "毅",
                    "text": "如果有人擅闯禁地，将军大人可不会管他有什么理由。"
                }
            ]
        }
    ]
}