{
    "groupId": "4112",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "纳里曼": 14
    },
    "talks": [
        {
            "talkId": "6411201",
            "initDialog": "641120101",
            "dialogues": [
                {
                    "id": "641120101",
                    "speaker": "纳里曼",
                    "text": "你好，要聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6411202",
            "initDialog": "641120201",
            "dialogues": [
                {
                    "id": "641120201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641120202",
                    "speaker": "纳里曼",
                    "text": "我是这附近的搬运工，正好做完了一批活，正在这休息呢。"
                },
                {
                    "id": "641120203",
                    "speaker": "纳里曼",
                    "text": "我从小在港口长大，你要是想打听这附近有什么新鲜事，找我可算找对人了。"
                }
            ]
        },
        {
            "talkId": "6411203",
            "initDialog": "641120301",
            "dialogues": [
                {
                    "id": "641120301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641120302",
                    "speaker": "纳里曼",
                    "text": "再见，我再歇会儿。"
                }
            ]
        },
        {
            "talkId": "6411204",
            "initDialog": "641120401",
            "dialogues": [
                {
                    "id": "641120401",
                    "speaker": "Player",
                    "text": "这附近…"
                },
                {
                    "id": "641120402",
                    "speaker": "纳里曼",
                    "text": "长住在奥摩斯港的，大部分都是土生土长的本地商贩和工人。"
                },
                {
                    "id": "641120403",
                    "speaker": "纳里曼",
                    "text": "来自外地的旅客和商人虽多，但基本上只会住上一阵，等差事忙完就走了。"
                },
                {
                    "id": "641120404",
                    "speaker": "纳里曼",
                    "text": "你要是想找地方住的话，可以去海边高地那的旅馆。坐升降机就能上去了，可千万别爬远路。"
                },
                {
                    "id": "641120405",
                    "speaker": "纳里曼",
                    "text": "还有的话…啊，就是教令院派来的那些公务员和镀金旅团的佣兵了。"
                },
                {
                    "id": "641120406",
                    "speaker": "纳里曼",
                    "text": "我对他们的了解不多，一般人也不会闲着没事去招惹他们吧。有那功夫还不如去迪亚法饭店喝两杯呢！"
                }
            ]
        },
        {
            "talkId": "6411205",
            "initDialog": "641120501",
            "dialogues": [
                {
                    "id": "641120501",
                    "speaker": "Player",
                    "text": "新鲜事…"
                },
                {
                    "id": "641120502",
                    "speaker": "纳里曼",
                    "text": "呃，实话说最近还真没有，大家就这样安安稳稳过日子也不坏吧。"
                },
                {
                    "id": "641120503",
                    "speaker": "纳里曼",
                    "text": "非要说有什么是没见过的，大概就是前几天海兽预警时见到了几个怪人。"
                },
                {
                    "id": "641120504",
                    "speaker": "纳里曼",
                    "text": "大伙正打算收工呢，几个镀金旅团的大哥拥一个衣服有点破的学者，闹着要出海。"
                },
                {
                    "id": "641120505",
                    "speaker": "纳里曼",
                    "text": "见过躲海兽的，没见过奔着海兽去的，听他们的意思，好像是什么研究海洋生物。"
                },
                {
                    "id": "641120506",
                    "speaker": "纳里曼",
                    "text": "唉，也不知道他们能不能活着回来，混口饭吃而已，至于这么拼命吗…"
                }
            ]
        }
    ]
}