{
    "groupId": "6382",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "图娜卡": 13
    },
    "talks": [
        {
            "talkId": "6638201",
            "initDialog": "663820101",
            "dialogues": [
                {
                    "id": "663820101",
                    "speaker": "图娜卡",
                    "text": "没错没错，就该这么打！不，应该说只能这么…嗯？哦哦，抱歉抱歉，刚才没留神，你好呀，朋友！有什么需要帮忙的吗？"
                }
            ]
        },
        {
            "talkId": "6638202",
            "initDialog": "663820201",
            "dialogues": [
                {
                    "id": "663820201",
                    "speaker": "Player",
                    "text": "关于我在「沃陆之邦」的声望…"
                },
                {
                    "id": "663820202",
                    "speaker": "图娜卡",
                    "text": "哎呀，原来是来帮忙的朋友吗？呵呵，那就辛苦你啦。我们也会准备好相应的报酬来答谢你的。"
                }
            ]
        },
        {
            "talkId": "6638203",
            "initDialog": "663820301",
            "dialogues": [
                {
                    "id": "663820301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "663820302",
                    "speaker": "图娜卡",
                    "text": "我吗？呵呵，我是三届摔角…咳，不对，现在是工作日。嗯，我是负责统筹部族物资的管理人，也负责安排一些日常事务。"
                },
                {
                    "id": "663820303",
                    "speaker": "图娜卡",
                    "text": "如果有什么需要帮忙的事情，或者你想要帮助大家解决生活上的困扰，来这里找我就好啦。"
                }
            ]
        },
        {
            "talkId": "6638204",
            "initDialog": "663820401",
            "dialogues": [
                {
                    "id": "663820401",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "663820402",
                    "speaker": "图娜卡",
                    "text": "喔，你应该是第一次来吧！这里就是我们引以为傲的大摔角场——至于我身后这个，就是部族的「曜石图腾柱」啦。"
                },
                {
                    "id": "663820403",
                    "speaker": "图娜卡",
                    "text": "呵呵，观看摔角比赛的可不止我们这些人哦。夜神之国的大灵也会透过图腾柱，将战士们的英姿映在眼中呢。"
                },
                {
                    "id": "663820404",
                    "speaker": "图娜卡",
                    "text": "唉，说着说着就想亲自上场了！要是能早点到周末就好了…"
                }
            ]
        },
        {
            "talkId": "6638205",
            "initDialog": "663820501",
            "dialogues": [
                {
                    "id": "663820501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "663820502",
                    "speaker": "图娜卡",
                    "text": "嗯，再见啦！要是在沃陆之邦遇到什么困难的话，记得要来找我喔。"
                }
            ]
        },
        {
            "talkId": "7594801",
            "initDialog": "759480101",
            "dialogues": [
                {
                    "id": "759480101",
                    "speaker": "Player",
                    "text": "上场？"
                },
                {
                    "id": "759480102",
                    "speaker": "图娜卡",
                    "text": "是呀，毕竟我也是现役摔角手嘛。"
                },
                {
                    "id": "759480103",
                    "speaker": "图娜卡",
                    "text": "不过，我平时需要管理后勤工作，只有到了周末，才能开开心心去摔角。"
                },
                {
                    "id": "759480104",
                    "speaker": "图娜卡",
                    "text": "我们沃陆之邦啊，可是整个纳塔农业最发达的部族喔。所以，物资的统筹管理自然也就成了重中之重。"
                },
                {
                    "id": "759480105",
                    "speaker": "图娜卡",
                    "text": "要确保大家都能想吃多少就吃多少，同时还不可以浪费食物。这就是我的工作内容啦。"
                },
                {
                    "id": "759480106",
                    "speaker": "图娜卡",
                    "text": "听我说了这么多，先吃点东西吧。我看你也正是长身体的时候，可不能饿着啦！"
                }
            ]
        }
    ]
}