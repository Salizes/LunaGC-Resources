{
    "groupId": "1854",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "巴克豪斯": 8
    },
    "talks": [
        {
            "talkId": "6185401",
            "initDialog": "618540101",
            "dialogues": [
                {
                    "id": "618540101",
                    "speaker": "巴克豪斯",
                    "text": "奇怪，是从来没有见过的…要是能靠近一点看看…"
                }
            ]
        },
        {
            "talkId": "6185402",
            "initDialog": "618540201",
            "dialogues": [
                {
                    "id": "618540201",
                    "speaker": "Player",
                    "text": "你是谁？"
                },
                {
                    "id": "618540202",
                    "speaker": "巴克豪斯",
                    "text": "我…啊，我是一名学者，研究的对象其实就是丘丘人…"
                },
                {
                    "id": "618540203",
                    "speaker": "巴克豪斯",
                    "text": "只不过这还是我第一次独立出来做课题，要是我的老师在就好了。"
                }
            ]
        },
        {
            "talkId": "6185403",
            "initDialog": "618540301",
            "dialogues": [
                {
                    "id": "618540301",
                    "speaker": "Player",
                    "text": "你在这干什么？"
                },
                {
                    "id": "618540302",
                    "speaker": "巴克豪斯",
                    "text": "我…我在观察丘丘人，实不相瞒，我在这里发现了一只特殊的丘丘人萨满。"
                },
                {
                    "id": "618540303",
                    "speaker": "巴克豪斯",
                    "text": "这里的丘丘人的生态似乎都是以它为核心建立的，虽然是萨满，但是却又有着几乎是「王者」的地位。"
                },
                {
                    "id": "618540304",
                    "speaker": "巴克豪斯",
                    "text": "如果真的是之前从未发现过的生态的话…说不定做出的研究还能让我的老师大吃一惊…"
                }
            ]
        },
        {
            "talkId": "6185404",
            "initDialog": "618540401",
            "dialogues": [
                {
                    "id": "618540401",
                    "speaker": "Player",
                    "text": "不打扰你了…"
                },
                {
                    "id": "618540402",
                    "speaker": "巴克豪斯",
                    "text": "好的，我还得…再写点观察笔记…"
                }
            ]
        },
        {
            "talkId": "6185405",
            "initDialog": "618540501",
            "dialogues": [
                {
                    "id": "618540501",
                    "speaker": "Player",
                    "text": "居然还有老师吗…"
                },
                {
                    "id": "618540502",
                    "speaker": "巴克豪斯",
                    "text": "嗯，我的老师名叫「利文斯通」，是研究丘丘人的大学者，也还是了不起的冒险家，说不定她能找到什么头绪…"
                }
            ]
        }
    ]
}