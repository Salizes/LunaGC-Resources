{
    "groupId": "4196",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 7,
        "兰伊舍": 21
    },
    "talks": [
        {
            "talkId": "6419601",
            "initDialog": "641960101",
            "dialogues": [
                {
                    "id": "641960101",
                    "speaker": "兰伊舍",
                    "text": "在无忧节到来之前，要准备更多好吃的谜语才行，现在还不够…"
                }
            ]
        },
        {
            "talkId": "6419602",
            "initDialog": "641960201",
            "dialogues": [
                {
                    "id": "641960201",
                    "speaker": "Player",
                    "text": "你有什么烦恼？"
                },
                {
                    "id": "641960202",
                    "speaker": "兰伊舍",
                    "text": "啊，是那菈朋友。"
                },
                {
                    "id": "641960203",
                    "speaker": "兰伊舍",
                    "text": "那菈朋友不知道无忧节，所以也不会知道兰伊舍的烦恼。"
                },
                {
                    "id": "641960204",
                    "speaker": "兰伊舍",
                    "text": "无忧节开始的时候，所有兰那罗都会回到桓那兰那，会有许多兰那罗找兰伊舍猜谜…"
                },
                {
                    "id": "641960205",
                    "speaker": "兰伊舍",
                    "text": "可是现在谜题还不够，这样大家就会不够吃…"
                }
            ]
        },
        {
            "talkId": "6419603",
            "initDialog": "641960301",
            "dialogues": [
                {
                    "id": "641960301",
                    "speaker": "Player",
                    "text": "关于谜题…"
                },
                {
                    "id": "641960302",
                    "speaker": "兰伊舍",
                    "text": "看到兰那罗猜不中兰伊舍的谜语，兰伊舍会很快活。"
                },
                {
                    "id": "641960303",
                    "speaker": "兰伊舍",
                    "text": "要是兰那罗猜中了兰伊舍的谜语，兰那罗会很快活。"
                },
                {
                    "id": "641960304",
                    "speaker": "兰伊舍",
                    "text": "所以猜谜是很快活的事。"
                },
                {
                    "id": "641960305",
                    "speaker": "兰伊舍",
                    "text": "不过还没有那菈猜过兰伊舍的谜语，需要再想一想，那菈喜欢什么样的快活谜语。"
                }
            ]
        },
        {
            "talkId": "6419604",
            "initDialog": "641960401",
            "dialogues": [
                {
                    "id": "641960401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "641960402",
                    "speaker": "兰伊舍",
                    "text": "再见，那菈朋友，记得来吃谜语。"
                }
            ]
        },
        {
            "talkId": "6419605",
            "initDialog": "641960501",
            "dialogues": [
                {
                    "id": "641960501",
                    "speaker": "兰伊舍",
                    "text": "那菈猜中了兰伊舍的所有谜语，那菈们的谜语一定也鲜嫩。"
                }
            ]
        },
        {
            "talkId": "6419606",
            "initDialog": "641960601",
            "dialogues": [
                {
                    "id": "641960601",
                    "speaker": "Player",
                    "text": "你在想什么？"
                },
                {
                    "id": "641960602",
                    "speaker": "兰伊舍",
                    "text": "#啊，是聪明的那菈{NICKNAME}。"
                },
                {
                    "id": "641960603",
                    "speaker": "兰伊舍",
                    "text": "#无忧节的时候，那菈{NICKNAME}猜中了兰伊舍的所有的好吃的谜语。"
                },
                {
                    "id": "641960604",
                    "speaker": "兰伊舍",
                    "text": "兰伊舍的谜语不够吃了。"
                },
                {
                    "id": "641960605",
                    "speaker": "兰伊舍",
                    "text": "#那菈{NICKNAME}猜谜这么厉害，一定是因为那菈们的谜题都很鲜嫩吧。"
                }
            ]
        },
        {
            "talkId": "6419607",
            "initDialog": "641960701",
            "dialogues": [
                {
                    "id": "641960701",
                    "speaker": "Player",
                    "text": "是的，非常好吃。"
                },
                {
                    "id": "641960702",
                    "speaker": "兰伊舍",
                    "text": "#果然，那菈{NICKNAME}吃了许多鲜嫩的谜语，所以把兰伊舍的谜语吃光了。"
                },
                {
                    "id": "641960703",
                    "speaker": "兰伊舍",
                    "text": "想去和小那菈比赛谜语。"
                }
            ]
        },
        {
            "talkId": "6419608",
            "initDialog": "641960801",
            "dialogues": [
                {
                    "id": "641960801",
                    "speaker": "Player",
                    "text": "不，很难吃。"
                },
                {
                    "id": "641960802",
                    "speaker": "兰伊舍",
                    "text": "#这样吗…看来是因为那菈{NICKNAME}聪明。"
                },
                {
                    "id": "641960803",
                    "speaker": "兰伊舍",
                    "text": "兰伊舍的谜语才会被吃光…"
                }
            ]
        },
        {
            "talkId": "6419609",
            "initDialog": "641960901",
            "dialogues": [
                {
                    "id": "641960901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641960902",
                    "speaker": "兰伊舍",
                    "text": "#再见，聪明的那菈{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6419610",
            "initDialog": "641961001",
            "dialogues": [
                {
                    "id": "641961001",
                    "speaker": "兰伊舍",
                    "text": "唔唔…那菈真的好聪明，果然！长得越高，就越聪明！"
                }
            ]
        }
    ]
}