{
    "groupId": "4192",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "兰茶荼": 19
    },
    "talks": [
        {
            "talkId": "6419201",
            "initDialog": "641920101",
            "dialogues": [
                {
                    "id": "641920101",
                    "speaker": "兰茶荼",
                    "text": "妹妹生气了，所以我要留下一片「一头菇」，直到日落果成熟十次。"
                }
            ]
        },
        {
            "talkId": "6419202",
            "initDialog": "641920201",
            "dialogues": [
                {
                    "id": "641920201",
                    "speaker": "Player",
                    "text": "留下一片？"
                },
                {
                    "id": "641920202",
                    "speaker": "兰茶荼",
                    "text": "#原本打算把采到的「一头菇」全部用来招待那菈{NICKNAME}，可是妹妹说，在日落果成熟十次之前，不许再采蘑菇了。"
                },
                {
                    "id": "641920203",
                    "speaker": "兰茶荼",
                    "text": "闻不到蘑菇的芬芳，兰茶荼一定会很难受的，说不定在日落果成熟第九次的时候，就会偷偷采蘑菇。"
                },
                {
                    "id": "641920204",
                    "speaker": "兰茶荼",
                    "text": "所以我偷偷留下了小小小的一片，比树叶还要薄，让它陪着我。"
                },
                {
                    "id": "641920205",
                    "speaker": "兰茶荼",
                    "text": "实在惭愧…"
                }
            ]
        },
        {
            "talkId": "6419203",
            "initDialog": "641920301",
            "dialogues": [
                {
                    "id": "641920301",
                    "speaker": "Player",
                    "text": "要等好久…"
                },
                {
                    "id": "641920302",
                    "speaker": "兰茶荼",
                    "text": "呜呜…"
                },
                {
                    "id": "641920303",
                    "speaker": "兰茶荼",
                    "text": "不过，说不定那时候，桓那中的「一头菇」就变得更大，味道更加醇厚。"
                },
                {
                    "id": "641920304",
                    "speaker": "兰茶荼",
                    "text": "说不定…会变成「超级三头菇」。"
                },
                {
                    "id": "641920305",
                    "speaker": "兰茶荼",
                    "text": "一想到这里，就会快乐一点。"
                }
            ]
        },
        {
            "talkId": "6419204",
            "initDialog": "641920401",
            "dialogues": [
                {
                    "id": "641920401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641920402",
                    "speaker": "兰茶荼",
                    "text": "呜呜…"
                }
            ]
        },
        {
            "talkId": "6419205",
            "initDialog": "641920501",
            "dialogues": [
                {
                    "id": "641920501",
                    "speaker": "兰茶荼",
                    "text": "无忧节大家都很快乐，我更快乐，只要日落果再成熟一次就可以去找新的蘑菇了。"
                }
            ]
        },
        {
            "talkId": "6419206",
            "initDialog": "641920601",
            "dialogues": [
                {
                    "id": "641920601",
                    "speaker": "Player",
                    "text": "再成熟一次？"
                },
                {
                    "id": "641920602",
                    "speaker": "兰茶荼",
                    "text": "嗯！兰帕卡提说「一头菇」给那菈带来了快乐。"
                },
                {
                    "id": "641920603",
                    "speaker": "兰茶荼",
                    "text": "所以她不生气了，也不用等日落果成熟那么多次才能摘蘑菇了。"
                },
                {
                    "id": "641920604",
                    "speaker": "兰茶荼",
                    "text": "我要找到滋味更好的蘑菇，希望这次，不要再让兰帕卡提生气了，否则她一定要让我等日落果成熟一百次、或者一百个一百次。"
                }
            ]
        },
        {
            "talkId": "6419207",
            "initDialog": "641920701",
            "dialogues": [
                {
                    "id": "641920701",
                    "speaker": "Player",
                    "text": "新的蘑菇？"
                },
                {
                    "id": "641920702",
                    "speaker": "兰茶荼",
                    "text": "听说在很远很远的地方，有一种落叶颜色的蘑菇，长在松树的脚掌上。"
                },
                {
                    "id": "641920703",
                    "speaker": "兰茶荼",
                    "text": "还有一种蘑菇，颜色和天空一样蓝蓝的，在月亮升起的时候还会发光。"
                },
                {
                    "id": "641920704",
                    "speaker": "兰茶荼",
                    "text": "不知道它们和「一头菇」比起来，哪个更美味一些。"
                },
                {
                    "id": "641920705",
                    "speaker": "兰茶荼",
                    "text": "#这次「特别烹饪修行」，我想要找到这两种蘑菇，用它们做成「至上珍馐」，招待那菈{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6419208",
            "initDialog": "641920801",
            "dialogues": [
                {
                    "id": "641920801",
                    "speaker": "Player",
                    "text": "再见，祝你顺利。"
                },
                {
                    "id": "641920802",
                    "speaker": "兰茶荼",
                    "text": "#一定会找到更醇厚的蘑菇的！到那个时候，那菈{NICKNAME}要来一起享用！"
                }
            ]
        }
    ]
}