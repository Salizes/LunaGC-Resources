{
    "groupId": "1761",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "艾萝蒂": 6
    },
    "talks": [
        {
            "talkId": "6176101",
            "initDialog": "617610101",
            "dialogues": [
                {
                    "id": "617610101",
                    "speaker": "艾萝蒂",
                    "text": "您好！您想来一朵花吗？"
                }
            ]
        },
        {
            "talkId": "6176102",
            "initDialog": "617610201",
            "dialogues": [
                {
                    "id": "617610201",
                    "speaker": "艾萝蒂",
                    "text": "相当特别的味道呢…是花的香氛吗？"
                }
            ]
        },
        {
            "talkId": "6176103",
            "initDialog": "617610301",
            "dialogues": [
                {
                    "id": "617610301",
                    "speaker": "Player",
                    "text": "这些花是…"
                },
                {
                    "id": "617610302",
                    "speaker": "艾萝蒂",
                    "text": "除了蒙德常见的花以外，还有些是莉莲小姐选育的新品花卉哦。"
                },
                {
                    "id": "617610303",
                    "speaker": "艾萝蒂",
                    "text": "因为是风车镇特有的花，蒙德城的芙萝拉小姐有时也会来我们这里采购…嗯，说起来，下次风花节的时候，果然还是应该再给她送些…"
                },
                {
                    "id": "617610304",
                    "speaker": "艾萝蒂",
                    "text": "呵呵，总之，在屋子附近放些花的话，心情也会变得很好呢。美丽的颜色与馥郁的香气…一定能让您更轻松一些吧？"
                }
            ]
        },
        {
            "talkId": "6176104",
            "initDialog": "617610401",
            "dialogues": [
                {
                    "id": "617610401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617610402",
                    "speaker": "艾萝蒂",
                    "text": "慢走呀。想来一朵花的话，可以随时来找我。"
                }
            ]
        }
    ]
}