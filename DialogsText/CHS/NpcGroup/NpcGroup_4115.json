{
    "groupId": "4115",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "晓东": 9
    },
    "talks": [
        {
            "talkId": "6411501",
            "initDialog": "641150101",
            "dialogues": [
                {
                    "id": "641150101",
                    "speaker": "晓东",
                    "text": "都等这么久了，怎么还没到啊…"
                }
            ]
        },
        {
            "talkId": "6411502",
            "initDialog": "641150201",
            "dialogues": [
                {
                    "id": "641150201",
                    "speaker": "Player",
                    "text": "你在等什么？"
                },
                {
                    "id": "641150202",
                    "speaker": "晓东",
                    "text": "我在等一批之前就定好的货物。"
                },
                {
                    "id": "641150203",
                    "speaker": "晓东",
                    "text": "我这不是早就把带来的茶叶和矿石卖完了嘛，就等着赶紧在船上装满须弥的毛毯和香料，然后回璃月港做生意。"
                },
                {
                    "id": "641150204",
                    "speaker": "晓东",
                    "text": "结果早早定好的香料不知怎么回事现在还没运来…"
                },
                {
                    "id": "641150205",
                    "speaker": "晓东",
                    "text": "问联系人也只能得到「在路上了」的回答，我看他什么都不清楚，只是在糊弄我吧。"
                },
                {
                    "id": "641150206",
                    "speaker": "晓东",
                    "text": "我看啊，还是亲自在码头等着比较靠谱。"
                }
            ]
        },
        {
            "talkId": "6411503",
            "initDialog": "641150301",
            "dialogues": [
                {
                    "id": "641150301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641150302",
                    "speaker": "晓东",
                    "text": "嗯，希望我的货能早点来啊。"
                }
            ]
        },
        {
            "talkId": "7390501",
            "initDialog": "739050101",
            "dialogues": [
                {
                    "id": "739050101",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "739050102",
                    "speaker": "晓东",
                    "text": "好，借你吉言。"
                },
                {
                    "id": "739050103",
                    "speaker": "晓东",
                    "text": "这次做完生意还剩一些边角料。不是质量不好，只是量多出来了而已，你不嫌弃的话就收下吧。"
                }
            ]
        }
    ]
}