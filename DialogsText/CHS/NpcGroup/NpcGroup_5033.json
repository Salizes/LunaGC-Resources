{
    "groupId": "5033",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 9,
        "伊丝黛莱": 18
    },
    "talks": [
        {
            "talkId": "5900122",
            "initDialog": "590012201",
            "dialogues": [
                {
                    "id": "590012201",
                    "speaker": "Player",
                    "text": "关于枫丹的矿产…"
                }
            ]
        },
        {
            "talkId": "5900123",
            "initDialog": "590012301",
            "dialogues": [
                {
                    "id": "590012301",
                    "speaker": "伊丝黛莱",
                    "text": "矿材的供应商刚刚来过，听说附近的矿点似乎没什么剩余了。抱歉，过一阵有了新情报我再告诉你吧。"
                }
            ]
        },
        {
            "talkId": "6503301",
            "initDialog": "650330101",
            "dialogues": [
                {
                    "id": "650330101",
                    "speaker": "伊丝黛莱",
                    "text": "你好，有什么需要的吗？"
                }
            ]
        },
        {
            "talkId": "6503302",
            "initDialog": "650330201",
            "dialogues": [
                {
                    "id": "650330201",
                    "speaker": "Player",
                    "text": "委托锻造…"
                },
                {
                    "id": "650330202",
                    "speaker": "伊丝黛莱",
                    "text": "请告诉我具体的需求，我这就安排机器开工。"
                }
            ]
        },
        {
            "talkId": "6503303",
            "initDialog": "650330301",
            "dialogues": [
                {
                    "id": "650330301",
                    "speaker": "Player",
                    "text": "想买些武器。"
                },
                {
                    "id": "650330302",
                    "speaker": "伊丝黛莱",
                    "text": "您慢慢挑，这里的都是精密打造出的作品。"
                }
            ]
        },
        {
            "talkId": "6503304",
            "initDialog": "650330401",
            "dialogues": [
                {
                    "id": "650330401",
                    "speaker": "Player",
                    "text": "这是用来锻造武器的机器吗？"
                },
                {
                    "id": "650330402",
                    "speaker": "伊丝黛莱",
                    "text": "没错，正是我的得意之作。"
                },
                {
                    "id": "650330403",
                    "speaker": "伊丝黛莱",
                    "text": "机械能够更精准地控制力度与温度，难道不是最适合用来处理锻造这类费力费时的工作的吗？"
                },
                {
                    "id": "650330404",
                    "speaker": "伊丝黛莱",
                    "text": "哪怕是身体素质很一般的我，也能和那些强壮的铁匠们一样，做出精美锐利的武器呢。"
                }
            ]
        },
        {
            "talkId": "6503305",
            "initDialog": "650330501",
            "dialogues": [
                {
                    "id": "650330501",
                    "speaker": "Player",
                    "text": "暂时不用。"
                },
                {
                    "id": "650330502",
                    "speaker": "伊丝黛莱",
                    "text": "那请慢走。"
                }
            ]
        },
        {
            "talkId": "6503306",
            "initDialog": "650330601",
            "dialogues": [
                {
                    "id": "650330601",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>委托锻造…</color>"
                },
                {
                    "id": "650330602",
                    "speaker": "伊丝黛莱",
                    "text": "之前的委托已经完工了，还有其他需要吗？"
                }
            ]
        },
        {
            "talkId": "6503307",
            "initDialog": "650330701",
            "dialogues": [
                {
                    "id": "650330701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想买些武器。</color>"
                },
                {
                    "id": "650330702",
                    "speaker": "伊丝黛莱",
                    "text": "您慢慢挑，这里的都是精密打造出的作品。"
                }
            ]
        },
        {
            "talkId": "6503308",
            "initDialog": "650330801",
            "dialogues": [
                {
                    "id": "650330801",
                    "speaker": "Player",
                    "text": "关于「预言」…"
                },
                {
                    "id": "650330802",
                    "speaker": "伊丝黛莱",
                    "text": "啊，说起涨水这事，你那位魔术师先生送的口袋帮大忙了呢。"
                },
                {
                    "id": "650330803",
                    "speaker": "伊丝黛莱",
                    "text": "我本来不太相信「预言」的，但保险起见还是把很多零件工具装进了袋子里。"
                },
                {
                    "id": "650330804",
                    "speaker": "伊丝黛莱",
                    "text": "真当是有备无患，要是都被水冲跑了，想把它们全部回收可就难了。"
                },
                {
                    "id": "650330805",
                    "speaker": "伊丝黛莱",
                    "text": "看样子你和你的朋友们应该也没什么大碍吧？太好了，传说中危机重重的「预言」终于算是过去了。"
                }
            ]
        },
        {
            "talkId": "6503309",
            "initDialog": "650330901",
            "dialogues": [
                {
                    "id": "650330901",
                    "speaker": "Player",
                    "text": "关于「预言」…"
                },
                {
                    "id": "650330902",
                    "speaker": "伊丝黛莱",
                    "text": "啊，你帮那位魔术师先生发放完魔术口袋了吧，辛苦了。"
                },
                {
                    "id": "650330903",
                    "speaker": "伊丝黛莱",
                    "text": "说实话，受他的影响，我自己也忍不住给亲朋好友们送了一些魔术口袋。"
                },
                {
                    "id": "650330904",
                    "speaker": "伊丝黛莱",
                    "text": "我本来可是就职于枫丹科学院的知名科学家呢，不该相信这个莫须有的「预言」的。"
                },
                {
                    "id": "650330905",
                    "speaker": "伊丝黛莱",
                    "text": "不过人们也常说有备无患，作为严谨的科研人员，应当将各种可能性纳入考虑范围内。"
                }
            ]
        }
    ]
}