{
    "groupId": "9058",
    "total_dialogue_lines": 72,
    "speaker_counts": {
        "Player": 19,
        "八重神子": 53
    },
    "talks": [
        {
            "talkId": "6905801",
            "initDialog": "690580101",
            "dialogues": [
                {
                    "id": "690580101",
                    "speaker": "八重神子",
                    "text": "哦？小家伙，今天怎么有空来看我了？"
                },
                {
                    "id": "690580102",
                    "speaker": "八重神子",
                    "text": "要是有什么烦恼，可以跟我聊聊。我一定会开心…开始用心地帮你解答。"
                }
            ]
        },
        {
            "talkId": "6905802",
            "initDialog": "690580201",
            "dialogues": [
                {
                    "id": "690580201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690580202",
                    "speaker": "八重神子",
                    "text": "不必担心，小家伙，我在哪里都很习惯。"
                },
                {
                    "id": "690580203",
                    "speaker": "八重神子",
                    "text": "这里…应该叫「仙人洞天」吧。和我想象的不太一样，不过倒很有趣。"
                },
                {
                    "id": "690580204",
                    "speaker": "八重神子",
                    "text": "将如此广袤的空间收入一盏小小的壶中，乍一看与心象空间有些相似，但原理却又完全不同。"
                },
                {
                    "id": "690580205",
                    "speaker": "Player",
                    "text": "居然是在研究尘歌壶…"
                },
                {
                    "id": "690580206",
                    "speaker": "八重神子",
                    "text": "作为神社的宫司，我需要掌握更多的知识和力量，才能应对各种情况。"
                },
                {
                    "id": "690580207",
                    "speaker": "八重神子",
                    "text": "而且，如果我学会了这个术法，就可以随身携带数不清的酒和点心…"
                },
                {
                    "id": "690580208",
                    "speaker": "Player",
                    "text": "这才是你的真实目的吧！"
                },
                {
                    "id": "690580209",
                    "speaker": "八重神子",
                    "text": "呵呵…不管怎么说，在壶里的这段时间就麻烦你多多关照了，小家伙。"
                }
            ]
        },
        {
            "talkId": "6905803",
            "initDialog": "690580301",
            "dialogues": [
                {
                    "id": "690580301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690580302",
                    "speaker": "八重神子",
                    "text": "哦？突然想找我聊天，莫非是感觉寂寞了？"
                },
                {
                    "id": "690580303",
                    "speaker": "八重神子",
                    "text": "正好我今天心情不错，给你讲一个很久以前的故事吧。",
                    "choices": [
                        {
                            "id": "690580304",
                            "text": "真让人期待。",
                            "response": [
                                {
                                    "id": "690580306",
                                    "speaker": "八重神子",
                                    "text": "很久以前的某一天，神社里忽然来了一个小孩。"
                                },
                                {
                                    "id": "690580307",
                                    "speaker": "八重神子",
                                    "text": "她抱着一只奄奄一息的狐狸，跪在狐斋宫的身前，请求狐斋宫救救她的这位朋友。"
                                },
                                {
                                    "id": "690580308",
                                    "speaker": "八重神子",
                                    "text": "据她所说，这只狐狸被她某次投喂了油豆腐之后，就经常出现在村子里。"
                                },
                                {
                                    "id": "690580309",
                                    "speaker": "八重神子",
                                    "text": "但好景不长，卸下防备的狐狸被村里的恶犬咬伤，生命垂危。小孩又伤心又自责，于是便来了神社。"
                                },
                                {
                                    "id": "690580310",
                                    "speaker": "八重神子",
                                    "text": "狐斋宫答应了她的请求，帮她治疗那只小狐狸。同时担心她会寂寞，就让同为狐狸的我去陪一陪她。"
                                },
                                {
                                    "id": "690580311",
                                    "speaker": "Player",
                                    "text": "然后呢？"
                                },
                                {
                                    "id": "690580312",
                                    "speaker": "八重神子",
                                    "text": "然后嘛…像我这样美丽的狐狸，和她相处没多久，就把她迷得神魂颠倒。"
                                },
                                {
                                    "id": "690580313",
                                    "speaker": "八重神子",
                                    "text": "不但给我买来了各种好吃的点心，更是一整天都腻在我的身旁，连睡觉都不肯离远一点。"
                                },
                                {
                                    "id": "690580314",
                                    "speaker": "八重神子",
                                    "text": "两天后她的小狐狸痊愈，我跟她一起来到了神社。狐斋宫就问她，你喜欢自己的小狐狸，还是新的小狐狸呀？"
                                },
                                {
                                    "id": "690580315",
                                    "speaker": "八重神子",
                                    "text": "她看看我，又看看自己的那位朋友，眼神中充满了苦恼。"
                                },
                                {
                                    "id": "690580316",
                                    "speaker": "Player",
                                    "text": "确实很难抉择…"
                                },
                                {
                                    "id": "690580317",
                                    "speaker": "八重神子",
                                    "text": "不过最后，当她的小狐狸跑到她面前，朝她呜呜叫了两声时，她还是放下了怀里的我。"
                                },
                                {
                                    "id": "690580318",
                                    "speaker": "八重神子",
                                    "text": "「虽然巫女大人的狐狸很好看，但我还是更喜欢我的老朋友呢！」"
                                },
                                {
                                    "id": "690580319",
                                    "speaker": "八重神子",
                                    "text": "最后那孩子奉上油豆腐，来感谢我的陪伴，然后带着自己的小狐狸离开了。",
                                    "choices": [
                                        {
                                            "id": "690580320",
                                            "text": "真是个好故事。",
                                            "response": [
                                                {
                                                    "id": "690580322",
                                                    "speaker": "八重神子",
                                                    "text": "等等，小家伙，你不会打算就这么离开吧？"
                                                },
                                                {
                                                    "id": "690580323",
                                                    "speaker": "八重神子",
                                                    "text": "世事都讲究一个互利互惠，听了我的故事，你是不是也应该有所表示呢？",
                                                    "choices": [
                                                        {
                                                            "id": "690580324",
                                                            "text": "那我也讲讲我的故事…",
                                                            "response": [
                                                                {
                                                                    "id": "690580325",
                                                                    "speaker": "八重神子",
                                                                    "text": "嗯，这还差不多。"
                                                                },
                                                                {
                                                                    "id": "690580326",
                                                                    "speaker": "八重神子",
                                                                    "text": "可要讲得有趣一些哦？最好是那种写出来放到八重堂，能够拿到销量冠军的程度。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690580327",
                                                            "text": "我现在就去买油豆腐…",
                                                            "response": [
                                                                {
                                                                    "id": "690580328",
                                                                    "speaker": "八重神子",
                                                                    "text": "很上道嘛。"
                                                                },
                                                                {
                                                                    "id": "690580329",
                                                                    "speaker": "八重神子",
                                                                    "text": "那我就在这里等你了，快去快回。等你回来，我可以再给你讲讲别的故事。"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690580321",
                                            "text": "谢谢你的故事…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690580305",
                            "text": "我想听！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905804",
            "initDialog": "690580401",
            "dialogues": [
                {
                    "id": "690580401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690580402",
                    "speaker": "八重神子",
                    "text": "没有哦。"
                },
                {
                    "id": "690580403",
                    "speaker": "八重神子",
                    "text": "呵呵…这个回答是不是让你有些意外？看到你吃惊的样子，真让人开心。"
                },
                {
                    "id": "690580404",
                    "speaker": "Player",
                    "text": "原来是开玩笑…"
                },
                {
                    "id": "690580405",
                    "speaker": "八重神子",
                    "text": "并不是玩笑哦。"
                },
                {
                    "id": "690580406",
                    "speaker": "八重神子",
                    "text": "从某种角度来说，这就是我想做的事。"
                },
                {
                    "id": "690580407",
                    "speaker": "八重神子",
                    "text": "观察人类的反应，阅读他们的人生，在我眼中是尘世间最有趣的事情了。"
                },
                {
                    "id": "690580408",
                    "speaker": "八重神子",
                    "text": "原则上我应该只是旁观，不过因为你实在太有意思了，难免会让我想捉弄一番。"
                },
                {
                    "id": "690580409",
                    "speaker": "Player",
                    "text": "原来是我的问题吗！"
                },
                {
                    "id": "690580410",
                    "speaker": "八重神子",
                    "text": "那当然了。"
                },
                {
                    "id": "690580411",
                    "speaker": "八重神子",
                    "text": "如果把人生比作轻小说的话，每本轻小说都有亮点，但也难免会有许多雷同的地方。"
                },
                {
                    "id": "690580412",
                    "speaker": "八重神子",
                    "text": "站在旁观者的角度，见多了「相似」，自然就渴望看到一些「不同」。"
                },
                {
                    "id": "690580413",
                    "speaker": "八重神子",
                    "text": "你的出现让我眼前一亮，我对你可是很期待的。要好好努力哦，小家伙。",
                    "choices": [
                        {
                            "id": "690580414",
                            "text": "我的「人生」吗…",
                            "response": [
                                {
                                    "id": "690580416",
                                    "speaker": "八重神子",
                                    "text": "放心吧，属于你的旅程还很长，你的故事才刚刚开始。"
                                },
                                {
                                    "id": "690580417",
                                    "speaker": "八重神子",
                                    "text": "而且，不是还有我这个「编辑」在吗？"
                                },
                                {
                                    "id": "690580418",
                                    "speaker": "八重神子",
                                    "text": "误入歧途的时候，我会帮忙「订正」；停滞不前的时候，就由我来「催稿」。"
                                },
                                {
                                    "id": "690580419",
                                    "speaker": "八重神子",
                                    "text": "这样就可以了吧？"
                                }
                            ]
                        },
                        {
                            "id": "690580415",
                            "text": "我不确定能否回应你的期待。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905805",
            "initDialog": "690580501",
            "dialogues": [
                {
                    "id": "690580501",
                    "speaker": "Player",
                    "text": "早啊，八重神子。"
                },
                {
                    "id": "690580502",
                    "speaker": "八重神子",
                    "text": "#早上好，{NICKNAME}。看你的气色，昨晚应该做了个好梦吧？"
                },
                {
                    "id": "690580503",
                    "speaker": "八重神子",
                    "text": "状态不错，运势也不错，去做你喜欢的事情吧，说不定会有什么意外收获。"
                }
            ]
        },
        {
            "talkId": "6905806",
            "initDialog": "690580601",
            "dialogues": [
                {
                    "id": "690580601",
                    "speaker": "Player",
                    "text": "晚安，八重神子。"
                },
                {
                    "id": "690580602",
                    "speaker": "八重神子",
                    "text": "#早点休息吧，{NICKNAME}，年轻人就是要早睡早起。"
                },
                {
                    "id": "690580603",
                    "speaker": "八重神子",
                    "text": "至于我嘛，就再去喝点酒，读两本有趣的轻小说…"
                },
                {
                    "id": "690580604",
                    "speaker": "八重神子",
                    "text": "该不会…想缠在我身边吧？"
                }
            ]
        },
        {
            "talkId": "6905807",
            "initDialog": "690580701",
            "dialogues": [
                {
                    "id": "690580701",
                    "speaker": "八重神子",
                    "text": "这神社的摆放，倒也还算讲究。"
                },
                {
                    "id": "690580702",
                    "speaker": "八重神子",
                    "text": "摆件的方位、相隔的距离，并没有明显的不妥。"
                },
                {
                    "id": "690580703",
                    "speaker": "八重神子",
                    "text": "嗯…在这方面，你倒是很细心嘛。"
                }
            ]
        },
        {
            "talkId": "6905808",
            "initDialog": "690580801",
            "dialogues": [
                {
                    "id": "690580801",
                    "speaker": "八重神子",
                    "text": "居然有我喜欢的温泉，那我就不客气地借用了哦？"
                },
                {
                    "id": "690580802",
                    "speaker": "八重神子",
                    "text": "泡在热气腾腾的温泉里，本就是涤净污秽、舒缓身心的好方式。"
                },
                {
                    "id": "690580803",
                    "speaker": "八重神子",
                    "text": "若是身前再有一壶清酒，那可真是再好不过。"
                }
            ]
        }
    ]
}