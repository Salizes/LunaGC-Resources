{
    "groupId": "9565",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "珐露珊": 10
    },
    "talks": [
        {
            "talkId": "6956501",
            "initDialog": "695650101",
            "dialogues": [
                {
                    "id": "695650101",
                    "speaker": "珐露珊",
                    "text": "这游戏是哪个学院琢磨出来的？玩起来要算来算去…说不定是梨多梵谛的小崽子们做的？"
                }
            ]
        },
        {
            "talkId": "6956502",
            "initDialog": "695650201",
            "dialogues": [
                {
                    "id": "695650201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956503",
            "initDialog": "695650301",
            "dialogues": [
                {
                    "id": "695650301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695650302",
                    "speaker": "珐露珊",
                    "text": "要走了？风风火火的年轻人…忙去吧，我还想再待一会。"
                }
            ]
        },
        {
            "talkId": "6956504",
            "initDialog": "695650401",
            "dialogues": [
                {
                    "id": "695650401",
                    "speaker": "珐露珊",
                    "text": "这么简单的计算。我看一眼就能马上算明白。"
                }
            ]
        },
        {
            "talkId": "6956505",
            "initDialog": "695650501",
            "dialogues": [
                {
                    "id": "695650501",
                    "speaker": "珐露珊",
                    "text": "玩得不错。看得出来你在七圣召唤上花了不少心思，考不考虑把这些心思集结起来写篇论文？作为前辈，我可以指导你。"
                }
            ]
        },
        {
            "talkId": "6956506",
            "initDialog": "695650601",
            "dialogues": [
                {
                    "id": "695650601",
                    "speaker": "珐露珊",
                    "text": "好吧…就陪陪年轻人。"
                }
            ]
        },
        {
            "talkId": "6956508",
            "initDialog": "695650801",
            "dialogues": [
                {
                    "id": "695650801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956509",
            "initDialog": "695650901",
            "dialogues": [
                {
                    "id": "695650901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956510",
            "initDialog": "695651001",
            "dialogues": [
                {
                    "id": "695651001",
                    "speaker": "珐露珊",
                    "text": "看来我还是能赶上一些潮流的嘛。"
                }
            ]
        },
        {
            "talkId": "6956511",
            "initDialog": "695651101",
            "dialogues": [
                {
                    "id": "695651101",
                    "speaker": "珐露珊",
                    "text": "这年轻人的游戏，真是复杂过头了…"
                }
            ]
        },
        {
            "talkId": "6956512",
            "initDialog": "695651201",
            "dialogues": [
                {
                    "id": "695651201",
                    "speaker": "珐露珊",
                    "text": "行啊，我正巧在外出散心呢。看那些古文看得我头晕眼花…用其他事情打发时间也不错。"
                }
            ]
        },
        {
            "talkId": "6956514",
            "initDialog": "695651401",
            "dialogues": [
                {
                    "id": "695651401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956515",
            "initDialog": "695651501",
            "dialogues": [
                {
                    "id": "695651501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956516",
            "initDialog": "695651601",
            "dialogues": [
                {
                    "id": "695651601",
                    "speaker": "珐露珊",
                    "text": "呼…心情放松了不少，你想再来几局的话…也不是不行。"
                }
            ]
        },
        {
            "talkId": "6956517",
            "initDialog": "695651701",
            "dialogues": [
                {
                    "id": "695651701",
                    "speaker": "珐露珊",
                    "text": "唉，这些牌花花绿绿的，看得我眼睛都花了…有没有茶水？我得喝一口提提神…"
                }
            ]
        },
        {
            "talkId": "6956518",
            "initDialog": "695651801",
            "dialogues": [
                {
                    "id": "695651801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}