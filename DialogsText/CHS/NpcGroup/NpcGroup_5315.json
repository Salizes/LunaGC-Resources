{
    "groupId": "5315",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "柯莎": 8
    },
    "talks": [
        {
            "talkId": "6531501",
            "initDialog": "653150101",
            "dialogues": [
                {
                    "id": "653150101",
                    "speaker": "柯莎",
                    "text": "啊，你今天也来看柯莎的花圃吗？"
                }
            ]
        },
        {
            "talkId": "6531502",
            "initDialog": "653150201",
            "dialogues": [
                {
                    "id": "653150201",
                    "speaker": "Player",
                    "text": "异国的花还好吗？"
                },
                {
                    "id": "653150202",
                    "speaker": "柯莎",
                    "text": "在丑丑的机关被挖出来以后，就再也没有坏坏隙境原体来捣乱啦。"
                },
                {
                    "id": "653150203",
                    "speaker": "柯莎",
                    "text": "珍贵的异国的花，正在柯莎的精心照料下健康生长！"
                }
            ]
        },
        {
            "talkId": "6531503",
            "initDialog": "653150301",
            "dialogues": [
                {
                    "id": "653150301",
                    "speaker": "Player",
                    "text": "新的花培育顺利吗？"
                },
                {
                    "id": "653150302",
                    "speaker": "柯莎",
                    "text": "嗯，柯莎暂时还没有什么头绪。"
                },
                {
                    "id": "653150303",
                    "speaker": "柯莎",
                    "text": "但是，如果能让花的叶子，长出汐藻那样的形状，说不定能在「园艺会」上，让大家大吃一惊呢！"
                }
            ]
        },
        {
            "talkId": "6531504",
            "initDialog": "653150401",
            "dialogues": [
                {
                    "id": "653150401",
                    "speaker": "Player",
                    "text": "只是凑巧路过。"
                },
                {
                    "id": "653150402",
                    "speaker": "柯莎",
                    "text": "嗯，给路过的人好心情就是花圃存在的理由之一。看到花圃的你今天也一定要有好心情哦！"
                }
            ]
        },
        {
            "talkId": "6531505",
            "initDialog": "653150501",
            "dialogues": [
                {
                    "id": "653150501",
                    "speaker": "Player",
                    "text": "关于刚才的地震…"
                },
                {
                    "id": "653150502",
                    "speaker": "柯莎",
                    "text": "呜啊，幸好花圃没事，刚才真的好可怕呀…"
                },
                {
                    "id": "653150503",
                    "speaker": "柯莎",
                    "text": "#还以为又有坏东西要弄坏柯莎的花圃呢…好不容易才和{NICKNAME}一起种出来的，一定要保护好才行！"
                }
            ]
        }
    ]
}