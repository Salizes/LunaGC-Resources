{
    "groupId": "2091",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "秀华": 14
    },
    "talks": [
        {
            "talkId": "6209101",
            "initDialog": "620910101",
            "dialogues": [
                {
                    "id": "620910101",
                    "speaker": "秀华",
                    "text": "请问贵客是用餐还是投宿呢？"
                }
            ]
        },
        {
            "talkId": "6209102",
            "initDialog": "620910201",
            "dialogues": [
                {
                    "id": "620910201",
                    "speaker": "Player",
                    "text": "请问你是…？"
                },
                {
                    "id": "620910202",
                    "speaker": "秀华",
                    "text": "我是秀华，是白驹逆旅的服务员。请问客人有什么需求吗？"
                },
                {
                    "id": "620910203",
                    "speaker": "Player",
                    "text": "关于身份…"
                },
                {
                    "id": "620910204",
                    "speaker": "秀华",
                    "text": "您问我身份吗？我只是一个服务员而已，没…没什么特别的。"
                },
                {
                    "id": "620910205",
                    "speaker": "秀华",
                    "text": "不过…我的双胞胎姐姐偶尔会和我互换岗位，请您千万不要见怪…"
                }
            ]
        },
        {
            "talkId": "6209103",
            "initDialog": "620910301",
            "dialogues": [
                {
                    "id": "620910301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620910302",
                    "speaker": "秀华",
                    "text": "白驹逆旅永远欢迎您，有空常来。"
                }
            ]
        },
        {
            "talkId": "6209104",
            "initDialog": "620910401",
            "dialogues": [
                {
                    "id": "620910401",
                    "speaker": "秀华",
                    "text": "请问贵客是用餐还是投宿呢？"
                }
            ]
        },
        {
            "talkId": "6209105",
            "initDialog": "620910501",
            "dialogues": [
                {
                    "id": "620910501",
                    "speaker": "Player",
                    "text": "请问你是…？"
                },
                {
                    "id": "620910502",
                    "speaker": "秀华",
                    "text": "我是毓…秀华！是白驹逆旅的跑堂，客人您有什么要求尽管找我就好！"
                },
                {
                    "id": "620910503",
                    "speaker": "Player",
                    "text": "关于身份…"
                },
                {
                    "id": "620910504",
                    "speaker": "秀华",
                    "text": "…欸，客人为什么突然问起这个？难道被看穿了！"
                },
                {
                    "id": "620910505",
                    "speaker": "秀华",
                    "text": "嘿嘿，其实我是秀华的姐姐毓华，一成不变的生活太无聊了，难得老天给我们双胞胎这样的机会…"
                },
                {
                    "id": "620910506",
                    "speaker": "秀华",
                    "text": "还请客人千万要帮忙保守这个秘密~！"
                }
            ]
        },
        {
            "talkId": "6209106",
            "initDialog": "620910601",
            "dialogues": [
                {
                    "id": "620910601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620910602",
                    "speaker": "秀华",
                    "text": "望舒…啊不，白驹客栈永远欢迎您，欢迎再来。"
                }
            ]
        },
        {
            "talkId": "7209101",
            "initDialog": "720910101",
            "dialogues": [
                {
                    "id": "720910101",
                    "speaker": "秀华",
                    "text": "望舒客栈居然在这么大的日子里也不放假…"
                },
                {
                    "id": "720910102",
                    "speaker": "秀华",
                    "text": "姐姐在那边做女侍，已经好几年没有和我一起过海灯节了。"
                },
                {
                    "id": "720910103",
                    "speaker": "秀华",
                    "text": "应该向总务司反映一下这件事…"
                }
            ]
        }
    ]
}