        {
            "talkId": "6436002",
            "initDialog": "643600201",
            "dialogues": [
                {
                    "id": "643600201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "643600202",
                    "speaker": "贝哈姆",
                    "text": "我是教令院外派的工作人员，负责监督和维护沙漠边缘的防沙工程，平时就驻扎在驿站这里。"
                },
                {
                    "id": "643600203",
                    "speaker": "贝哈姆",
                    "text": "对须弥人的生活来说，雨林至关重要，一定不能被沙漠侵蚀。"
                },
                {
                    "id": "643600204",
                    "speaker": "贝哈姆",
                    "text": "防沙壁是阻挡沙暴的关键手段，必须严防死守。"
                }
            ]
        },
        {
            "talkId": "6436003",
