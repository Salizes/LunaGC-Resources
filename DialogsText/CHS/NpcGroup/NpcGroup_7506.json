{
    "groupId": "7506",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "季莫菲": 10,
        "派蒙": 4
    },
    "talks": [
        {
            "talkId": "6750601",
            "initDialog": "675060101",
            "dialogues": [
                {
                    "id": "675060101",
                    "speaker": "季莫菲",
                    "text": "内部票要不要？科列洛夫茨基剧团的，都是高雅艺术——"
                }
            ]
        },
        {
            "talkId": "6750602",
            "initDialog": "675060201",
            "dialogues": [
                {
                    "id": "675060201",
                    "speaker": "Player",
                    "text": "内部票？"
                },
                {
                    "id": "675060202",
                    "speaker": "季莫菲",
                    "text": "对对，来一张？保证比您上剧院里头买便宜。"
                },
                {
                    "id": "675060203",
                    "speaker": "季莫菲",
                    "text": "人们都说，至冬堡最优美的，莫过于奥黛塔的高歌。要是没见着沃雅妮莎的舞蹈，等于没来至冬堡。"
                },
                {
                    "id": "675060204",
                    "speaker": "季莫菲",
                    "text": "什么「歌唱剧」呀、「蕾芭舞」啦，我这里全都有！剧团专供，童叟无欺。"
                }
            ]
        },
        {
            "talkId": "6750603",
            "initDialog": "675060301",
            "dialogues": [
                {
                    "id": "675060301",
                    "speaker": "Player",
                    "text": "还是算了。"
                },
                {
                    "id": "675060302",
                    "speaker": "季莫菲",
                    "text": "您慢走。"
                }
            ]
        },
        {
            "talkId": "6750604",
            "initDialog": "675060401",
            "dialogues": [
                {
                    "id": "675060401",
                    "speaker": "Player",
                    "text": "是「歌剧」和「芭蕾舞」吧…"
                },
                {
                    "id": "675060402",
                    "speaker": "季莫菲",
                    "text": "哦哦，哦哦…看来您是内行啊！"
                },
                {
                    "id": "675060403",
                    "speaker": "季莫菲",
                    "text": "实不相瞒，我虽然手上有票，但确实没欣赏过这些演出。唉，都是生计所迫。"
                },
                {
                    "id": "675060404",
                    "speaker": "季莫菲",
                    "text": "见笑，见笑。总之，如果您想要内部票，可别忘了来找我。"
                }
            ]
        },
        {
            "talkId": "6750605",
            "initDialog": "675060501",
            "dialogues": [
                {
                    "id": "675060501",
                    "speaker": "派蒙",
                    "text": ""
                },
                {
                    "id": "675060502",
                    "speaker": "派蒙",
                    "text": ""
                },
                {
                    "id": "675060503",
                    "speaker": "派蒙",
                    "text": ""
                },
                {
                    "id": "675060504",
                    "speaker": "派蒙",
                    "text": ""
                }
            ]
        },
        {
            "talkId": "6750606",
            "initDialog": "675060601",
            "dialogues": [
                {
                    "id": "675060601",
                    "speaker": "Player",
                    "text": "这票靠谱吗？"
                },
                {
                    "id": "675060602",
                    "speaker": "季莫菲",
                    "text": "瞧您说的！做生意嘛，讲究的是个彼此信任。"
                },
                {
                    "id": "675060603",
                    "speaker": "季莫菲",
                    "text": "您要是不放心，那就算了。等您想清楚了，咱们再谈。"
                }
            ]
        }
    ]
}