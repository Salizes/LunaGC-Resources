{
    "groupId": "7003",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "卡嘉": 8
    },
    "talks": [
        {
            "talkId": "6700301",
            "initDialog": "670030101",
            "dialogues": [
                {
                    "id": "670030101",
                    "speaker": "卡嘉",
                    "text": "欢迎，想吃点什么？热乎的菜肴，爽口的饮料，咱们这儿都有。"
                }
            ]
        },
        {
            "talkId": "6700302",
            "initDialog": "670030201",
            "dialogues": [
                {
                    "id": "670030201",
                    "speaker": "Player",
                    "text": "看看菜单。"
                },
                {
                    "id": "670030202",
                    "speaker": "卡嘉",
                    "text": "请看。"
                }
            ]
        },
        {
            "talkId": "6700303",
            "initDialog": "670030301",
            "dialogues": [
                {
                    "id": "670030301",
                    "speaker": "Player",
                    "text": "店员看起来年纪都不大呢。"
                },
                {
                    "id": "670030302",
                    "speaker": "卡嘉",
                    "text": "这些孩子啊，大都没人照料，原本在街头生活。我看不过眼，起码给他们一个能遮风避雨的住处和热乎的餐食吧。"
                },
                {
                    "id": "670030303",
                    "speaker": "卡嘉",
                    "text": "不过吃了饭就得劳动，好在孩子们也都乐意，咱们这小店就这么开起来啦。"
                }
            ]
        },
        {
            "talkId": "6700304",
            "initDialog": "670030401",
            "dialogues": [
                {
                    "id": "670030401",
                    "speaker": "Player",
                    "text": "有什么有趣的消息吗？"
                },
                {
                    "id": "670030402",
                    "speaker": "卡嘉",
                    "text": "那你可走错地方了，我已经不干宝藏猎人很久了，去「旗舰」打听打听吧，准能找到你想听的。"
                },
                {
                    "id": "670030403",
                    "speaker": "卡嘉",
                    "text": "或者去问问孩子们吧，消息在孩子们之间总是传得很快的。"
                },
                {
                    "id": "670030404",
                    "speaker": "卡嘉",
                    "text": "不过不准向他们打听危险的事喔，他们会输给好奇心，最后弄得自己身陷险境，我可不允许这种事情发生。"
                }
            ]
        },
        {
            "talkId": "6700305",
            "initDialog": "670030501",
            "dialogues": [
                {
                    "id": "670030501",
                    "speaker": "Player",
                    "text": "还不饿，先算了。"
                },
                {
                    "id": "670030502",
                    "speaker": "卡嘉",
                    "text": "慢走。"
                }
            ]
        }
    ]
}