{
    "groupId": "6234",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "卡图马": 13
    },
    "talks": [
        {
            "talkId": "6623401",
            "initDialog": "662340101",
            "dialogues": [
                {
                    "id": "662340101",
                    "speaker": "卡图马",
                    "text": "其他地方…会不会有我能抓住的机会呢…"
                }
            ]
        },
        {
            "talkId": "6623402",
            "initDialog": "662340201",
            "dialogues": [
                {
                    "id": "662340201",
                    "speaker": "Player",
                    "text": "遇到麻烦了？"
                },
                {
                    "id": "662340202",
                    "speaker": "卡图马",
                    "text": "简单来说，「飞行试炼」失败了。真糟糕，没能熟练地飞上天空，连云彩的边也没摸到。"
                },
                {
                    "id": "662340203",
                    "speaker": "卡图马",
                    "text": "这是第二次了吧…说实话有点受打击。"
                },
                {
                    "id": "662340204",
                    "speaker": "卡图马",
                    "text": "我知道，才两次尝试，虽然对部族里的很多骑士来说并不算多，但这不是个好兆头。"
                },
                {
                    "id": "662340205",
                    "speaker": "卡图马",
                    "text": "一想到部族里有不少尝试了大半辈子都没成功的人，把人生都浪费在了飞行练习上，有点害怕自己也变成那样。"
                },
                {
                    "id": "662340206",
                    "speaker": "卡图马",
                    "text": "或许…就这样接受自己是「失翼者」的事实，离开这里…"
                }
            ]
        },
        {
            "talkId": "6623403",
            "initDialog": "662340301",
            "dialogues": [
                {
                    "id": "662340301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "662340302",
                    "speaker": "卡图马",
                    "text": "希望我能做出正确的决定…你也一样。"
                }
            ]
        },
        {
            "talkId": "6623404",
            "initDialog": "662340401",
            "dialogues": [
                {
                    "id": "662340401",
                    "speaker": "Player",
                    "text": "可你还没离开。"
                },
                {
                    "id": "662340402",
                    "speaker": "卡图马",
                    "text": "啊，是啊，因为我并没有完全失去信心。"
                },
                {
                    "id": "662340403",
                    "speaker": "卡图马",
                    "text": "不然，也不会一直在这里徘徊了，对吧？"
                },
                {
                    "id": "662340404",
                    "speaker": "卡图马",
                    "text": "我真的适合当骑士吗？自己真的有天赋吗？不会一步走错步步走错吧？"
                },
                {
                    "id": "662340405",
                    "speaker": "卡图马",
                    "text": "我知道这种想法在长辈眼里可能很幼稚很浪费时间，但人还是要为自己的人生负责。"
                }
            ]
        },
        {
            "talkId": "7593701",
            "initDialog": "759370101",
            "dialogues": [
                {
                    "id": "759370101",
                    "speaker": "Player",
                    "text": "话也没错。"
                },
                {
                    "id": "759370102",
                    "speaker": "卡图马",
                    "text": "哈哈，多谢你愿意听我说这些丧气话，希望没有耽误你的时间。"
                },
                {
                    "id": "759370103",
                    "speaker": "卡图马",
                    "text": "虽然我可能会离开，但「花羽会」是个很不错的地方，希望你在这里过得愉快。"
                }
            ]
        }
    ]
}