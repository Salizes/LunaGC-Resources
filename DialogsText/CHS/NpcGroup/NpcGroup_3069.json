{
    "groupId": "3069",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 7,
        "小林": 19
    },
    "talks": [
        {
            "talkId": "4006312",
            "initDialog": "400631201",
            "dialogues": [
                {
                    "id": "400631201",
                    "speaker": "小林",
                    "text": "你好，你是来参加祭典的吧？"
                },
                {
                    "id": "400631202",
                    "speaker": "小林",
                    "text": "难得见离岛这么热闹，还有这么多形色各异的外国人出现，真稀奇！"
                },
                {
                    "id": "400631203",
                    "speaker": "小林",
                    "text": "等工作结束，我也去逛逛吧。我运气一直很好，没准能在活动里抽个大奖呢。"
                }
            ]
        },
        {
            "talkId": "6306901",
            "initDialog": "630690101",
            "dialogues": [
                {
                    "id": "630690101",
                    "speaker": "小林",
                    "text": "嗯？什么事？"
                }
            ]
        },
        {
            "talkId": "6306902",
            "initDialog": "630690201",
            "dialogues": [
                {
                    "id": "630690201",
                    "speaker": "Player",
                    "text": "这条路是？"
                },
                {
                    "id": "630690202",
                    "speaker": "小林",
                    "text": "往前面走是个叫绀田村的村庄。"
                },
                {
                    "id": "630690203",
                    "speaker": "小林",
                    "text": "…出村后顺着大道走，就离稻妻城不远了。"
                },
                {
                    "id": "630690204",
                    "speaker": "小林",
                    "text": "对了，你有进出离岛的许可吗？"
                }
            ]
        },
        {
            "talkId": "6306903",
            "initDialog": "630690301",
            "dialogues": [
                {
                    "id": "630690301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630690302",
                    "speaker": "小林",
                    "text": "没有通行证可不许乱跑啊！"
                }
            ]
        },
        {
            "talkId": "6306904",
            "initDialog": "630690401",
            "dialogues": [
                {
                    "id": "630690401",
                    "speaker": "Player",
                    "text": "许可？"
                },
                {
                    "id": "630690402",
                    "speaker": "小林",
                    "text": "就是「通行凭证」，是由天领奉行或勘定奉行下发的文件，可以在稻妻境内自由通行。"
                },
                {
                    "id": "630690403",
                    "speaker": "小林",
                    "text": "…你该不会没有吧？"
                },
                {
                    "id": "630690404",
                    "speaker": "小林",
                    "text": "要是没有的话，就在离岛老实待着吧。"
                }
            ]
        },
        {
            "talkId": "6306905",
            "initDialog": "630690501",
            "dialogues": [
                {
                    "id": "630690501",
                    "speaker": "Player",
                    "text": "「通行凭证」…是这个吗？"
                },
                {
                    "id": "630690502",
                    "speaker": "小林",
                    "text": "给我看看…嗯，确实没错。那就没事了，你可以通过这里。"
                }
            ]
        },
        {
            "talkId": "6306906",
            "initDialog": "630690601",
            "dialogues": [
                {
                    "id": "630690601",
                    "speaker": "Player",
                    "text": "这条路是？"
                },
                {
                    "id": "630690602",
                    "speaker": "小林",
                    "text": "往前面走是个叫绀田村的村庄。"
                },
                {
                    "id": "630690603",
                    "speaker": "小林",
                    "text": "…出村后顺着大道走，就离稻妻城不远了。"
                },
                {
                    "id": "630690604",
                    "speaker": "小林",
                    "text": "对了，你没带什么非法物品吧？"
                }
            ]
        },
        {
            "talkId": "6306907",
            "initDialog": "630690701",
            "dialogues": [
                {
                    "id": "630690701",
                    "speaker": "Player",
                    "text": "非法物品？"
                },
                {
                    "id": "630690702",
                    "speaker": "小林",
                    "text": "呃…比如…比如会自动寻宝的罗盘、让人原地起飞的瓶子、能发射大炮的船只…之类的？"
                },
                {
                    "id": "630690703",
                    "speaker": "小林",
                    "text": "只是猜测啦，其实我也不太懂，哈哈。"
                },
                {
                    "id": "630690704",
                    "speaker": "小林",
                    "text": "就算有什么危险分子，到了城里也有天领奉行等着他们呢！"
                }
            ]
        },
        {
            "talkId": "6306908",
            "initDialog": "630690801",
            "dialogues": [
                {
                    "id": "630690801",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630690802",
                    "speaker": "小林",
                    "text": "一路顺风哦！"
                }
            ]
        }
    ]
}