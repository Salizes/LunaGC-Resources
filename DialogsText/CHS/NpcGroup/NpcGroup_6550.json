    },
    "talks": [
        {
            "talkId": "6655001",
            "initDialog": "665500101",
            "dialogues": [
                {
                    "id": "665500101",
                    "speaker": "欧库夏",
                    "text": "请初次登岛的客人在我这边登记住处，目前「呼呼丘」的海景小屋还有一些空余…"
                },
                {
                    "id": "665500102",
                    "speaker": "欧库夏",
                    "text": "咦？是您啊客人，这段时间玩得怎么样？"
                },
                {
                    "id": "665500103",
                    "speaker": "Player",
                    "text": "你还记得我呢。"
                },
                {
                    "id": "665500104",
                    "speaker": "欧库夏",
                    "text": "当然，我还记得您的一位伙伴刚刚登岛就得到了一只阿夏的青睐呢，他们相处的应该还不错吧？"
                },
                {
                    "id": "665500105",
                    "speaker": "Player",
                    "text": "他们相处的很好。"
                },
                {
                    "id": "665500106",
                    "speaker": "欧库夏",
                    "text": "那我就放心了，虽然阿夏通常都会比较亲近人，但初次见面就这么亲近，可不是常有的事。"
                },
                {
                    "id": "665500107",
                    "speaker": "欧库夏",
                    "text": "不管怎么说，祝您和您的朋友能够享受一个美好的夏天。"
                }
            ]
        }
    ]
}