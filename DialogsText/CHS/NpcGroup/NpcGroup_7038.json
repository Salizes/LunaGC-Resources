{
    "groupId": "7038",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "科洛曼": 9
    },
    "talks": [
        {
            "talkId": "6703801",
            "initDialog": "670380101",
            "dialogues": [
                {
                    "id": "670380101",
                    "speaker": "科洛曼",
                    "text": "回家的路途这么遥远，真是叫人难以忍受，一天几乎一半的时间都要花在来回上了！"
                }
            ]
        },
        {
            "talkId": "6703802",
            "initDialog": "670380201",
            "dialogues": [
                {
                    "id": "670380201",
                    "speaker": "Player",
                    "text": "听起来真是糟透了。"
                },
                {
                    "id": "670380202",
                    "speaker": "科洛曼",
                    "text": "没错，给不了几个摩拉，又得早出晚归，早上走的时候孩子睡着，晚上回去的时候孩子也睡着。"
                },
                {
                    "id": "670380203",
                    "speaker": "科洛曼",
                    "text": "说不定再过个几年，孩子长大了，连我这个老爸都不认识咯。"
                }
            ]
        },
        {
            "talkId": "6703803",
            "initDialog": "670380301",
            "dialogues": [
                {
                    "id": "670380301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670380302",
                    "speaker": "科洛曼",
                    "text": "再见，唉…希望明天能早点到家。"
                }
            ]
        },
        {
            "talkId": "6703804",
            "initDialog": "670380401",
            "dialogues": [
                {
                    "id": "670380401",
                    "speaker": "Player",
                    "text": "你当年…"
                },
                {
                    "id": "670380402",
                    "speaker": "科洛曼",
                    "text": "哼，那也不是什么好营生，以前觉得那样刀口舔血的生活刺激，但你要真的看到你认识的人倒在你面前…算了，不提了。"
                },
                {
                    "id": "670380403",
                    "speaker": "科洛曼",
                    "text": "现在，我只想和我家的老母鸡和小鸡仔安安稳稳地过日子。"
                }
            ]
        },
        {
            "talkId": "6703805",
            "initDialog": "670380501",
            "dialogues": [
                {
                    "id": "670380501",
                    "speaker": "科洛曼",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6703806",
            "initDialog": "670380601",
            "dialogues": [
                {
                    "id": "670380601",
                    "speaker": "科洛曼",
                    "text": "咦？竟然是我赢了吗？"
                }
            ]
        },
        {
            "talkId": "6703807",
            "initDialog": "670380701",
            "dialogues": [
                {
                    "id": "670380701",
                    "speaker": "科洛曼",
                    "text": "唔，厉害。这张牌原来还可以这么用啊…"
                }
            ]
        }
    ]
}