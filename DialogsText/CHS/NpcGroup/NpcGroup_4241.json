{
    "groupId": "4241",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "兰迦鲁": 13
    },
    "talks": [
        {
            "talkId": "6424101",
            "initDialog": "642410101",
            "dialogues": [
                {
                    "id": "642410101",
                    "speaker": "兰迦鲁",
                    "text": "金色的那菈收到了许多花，是桓那兰那的朋友，也是我的朋友。"
                }
            ]
        },
        {
            "talkId": "6424102",
            "initDialog": "642410201",
            "dialogues": [
                {
                    "id": "642410201",
                    "speaker": "Player",
                    "text": "你好…"
                },
                {
                    "id": "642410202",
                    "speaker": "兰迦鲁",
                    "text": "你好，金色的那菈…"
                },
                {
                    "id": "642410203",
                    "speaker": "兰迦鲁",
                    "text": "你会像那菈法留纳一样，成为兰那罗们不会忘记的故事，兰迦鲁觉得。"
                }
            ]
        },
        {
            "talkId": "6424103",
            "initDialog": "642410301",
            "dialogues": [
                {
                    "id": "642410301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "642410302",
                    "speaker": "兰迦鲁",
                    "text": "再见，金色的那菈…"
                }
            ]
        },
        {
            "talkId": "6424104",
            "initDialog": "642410401",
            "dialogues": [
                {
                    "id": "642410401",
                    "speaker": "兰迦鲁",
                    "text": "#那菈{NICKNAME}是新朋友，但是原来早就收到过花了，兰迦鲁的。"
                }
            ]
        },
        {
            "talkId": "6424105",
            "initDialog": "642410501",
            "dialogues": [
                {
                    "id": "642410501",
                    "speaker": "Player",
                    "text": "关于花…"
                },
                {
                    "id": "642410502",
                    "speaker": "兰迦鲁",
                    "text": "#无忧节很开心，那菈{NICKNAME}也收到了许多花。"
                },
                {
                    "id": "642410503",
                    "speaker": "兰迦鲁",
                    "text": "兰迦鲁很好奇。为什么金色的那菈像是汇聚雨水的河流一样地，收到大家的花朵。"
                },
                {
                    "id": "642410504",
                    "speaker": "兰迦鲁",
                    "text": "原来在故事里，兰迦鲁更早就送过花了。"
                }
            ]
        },
        {
            "talkId": "6424106",
            "initDialog": "642410601",
            "dialogues": [
                {
                    "id": "642410601",
                    "speaker": "Player",
                    "text": "关于坏蛋那菈…"
                },
                {
                    "id": "642410602",
                    "speaker": "兰迦鲁",
                    "text": "坏蛋那菈的花，是兰迦鲁送的。不过不知道是谁，不记得了。"
                },
                {
                    "id": "642410603",
                    "speaker": "兰迦鲁",
                    "text": "但是那时候，坏蛋那菈肯定还不坏。"
                },
                {
                    "id": "642410604",
                    "speaker": "兰迦鲁",
                    "text": "有的时候，明明月亮升起的时候，那菈还是好孩子，但是到了太阳再升起的时候，那菈就变坏了，不明白…"
                },
                {
                    "id": "642410605",
                    "speaker": "兰迦鲁",
                    "text": "#不过，不管太阳与月亮升落多少次，那菈{NICKNAME}也一定都会和那菈法留纳那样，金灿灿的。"
                }
            ]
        },
        {
            "talkId": "6424107",
            "initDialog": "642410701",
            "dialogues": [
                {
                    "id": "642410701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642410702",
                    "speaker": "兰迦鲁",
                    "text": "#再见，金灿灿的那菈{NICKNAME}。"
                }
            ]
        }
    ]
}