{
    "groupId": "6046",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "埃文苏": 8
    },
    "talks": [
        {
            "talkId": "6604601",
            "initDialog": "660460101",
            "dialogues": [
                {
                    "id": "660460101",
                    "speaker": "埃文苏",
                    "text": "你来得正好。我现在手上没有工作，先到先得哦。"
                }
            ]
        },
        {
            "talkId": "6604602",
            "initDialog": "660460201",
            "dialogues": [
                {
                    "id": "660460201",
                    "speaker": "Player",
                    "text": "啊？得什么？"
                },
                {
                    "id": "660460202",
                    "speaker": "埃文苏",
                    "text": "哦哦，我以为你是听说过我的「代理」工作才找过来的呢。"
                },
                {
                    "id": "660460203",
                    "speaker": "埃文苏",
                    "text": "见面就是有缘，让我给你介绍一下吧！这位朋友，你想不想在最佳的视角、最近的距离观赏战士们的英姿？"
                },
                {
                    "id": "660460204",
                    "speaker": "埃文苏",
                    "text": "那找我就没错了！我可以在狂暴的人流中，为你在圣火竞技场占据最棒的观众位置！"
                },
                {
                    "id": "660460205",
                    "speaker": "埃文苏",
                    "text": "当然，火神大人的位置没法帮你占哈…其他的都好说！"
                },
                {
                    "id": "660460206",
                    "speaker": "埃文苏",
                    "text": "哦对了，这个名额也极其珍贵，每次只能帮一个人占位置。"
                },
                {
                    "id": "660460207",
                    "speaker": "埃文苏",
                    "text": "毕竟，我就只有一个人嘛。"
                }
            ]
        },
        {
            "talkId": "6604603",
            "initDialog": "660460301",
            "dialogues": [
                {
                    "id": "660460301",
                    "speaker": "Player",
                    "text": "先不用了。"
                },
                {
                    "id": "660460302",
                    "speaker": "埃文苏",
                    "text": "真的吗？要放弃这个珍贵的机会吗？"
                }
            ]
        }
    ]
}