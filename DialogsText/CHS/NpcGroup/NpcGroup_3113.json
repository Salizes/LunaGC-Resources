{
    "groupId": "3113",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "几原凯": 14
    },
    "talks": [
        {
            "talkId": "5900019",
            "initDialog": "590001901",
            "dialogues": [
                {
                    "id": "590001901",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900020",
            "initDialog": "590002001",
            "dialogues": [
                {
                    "id": "590002001",
                    "speaker": "几原凯",
                    "text": "这里可是军营，到处都得留意。"
                },
                {
                    "id": "590002002",
                    "speaker": "几原凯",
                    "text": "不过最近还算太平，没什么特别的动乱，希望以后也别有。"
                }
            ]
        },
        {
            "talkId": "6311301",
            "initDialog": "631130101",
            "dialogues": [
                {
                    "id": "631130101",
                    "speaker": "几原凯",
                    "text": "唉，你看看，这种破铜烂铁，怎么能锻出好刀呢？真是枉费我一身几原流锻刀术的好功夫！"
                }
            ]
        },
        {
            "talkId": "6311302",
            "initDialog": "631130201",
            "dialogues": [
                {
                    "id": "631130201",
                    "speaker": "Player",
                    "text": "关于几原流…"
                },
                {
                    "id": "631130202",
                    "speaker": "几原凯",
                    "text": "几原流是新晋锻刀流派，开创者么，正是在下。"
                },
                {
                    "id": "631130203",
                    "speaker": "几原凯",
                    "text": "我以前是在踏鞴砂锻刀的匠人。后来「御影炉心」发生了事故，不少一起锻刀的同伴们都离开了。"
                },
                {
                    "id": "631130204",
                    "speaker": "几原凯",
                    "text": "我还不想走，于是便加入了常驻在这里的幕府军，一边为幕府效力，一边顺便观察踏鞴砂的状况。"
                },
                {
                    "id": "631130205",
                    "speaker": "几原凯",
                    "text": "毕竟最适合锻刀的玉钢是产自踏鞴砂的啊…就算有再好的锻造技术，如果没有与之相衬的好材料，锻出来的刀剑也难成极品。"
                }
            ]
        },
        {
            "talkId": "6311303",
            "initDialog": "631130301",
            "dialogues": [
                {
                    "id": "631130301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631130302",
                    "speaker": "几原凯",
                    "text": "再见，我还是再去找找好材料吧。"
                }
            ]
        },
        {
            "talkId": "6311304",
            "initDialog": "631130401",
            "dialogues": [
                {
                    "id": "631130401",
                    "speaker": "Player",
                    "text": "非要踏鞴砂的玉钢不可吗？"
                },
                {
                    "id": "631130402",
                    "speaker": "几原凯",
                    "text": "这是说的什么话！…罢了，你是外乡人，不懂也正常。"
                },
                {
                    "id": "631130403",
                    "speaker": "几原凯",
                    "text": "稻妻的刀剑如此出名，正是因为那里生产的玉钢。用玉钢锻造的刀剑，强韧耐用，锐锋无影。"
                },
                {
                    "id": "631130404",
                    "speaker": "几原凯",
                    "text": "稻妻史上的诸多武士剑客，都是挥动玉钢制出的武器成名立业的。"
                },
                {
                    "id": "631130405",
                    "speaker": "几原凯",
                    "text": "总有一天，我也要用最好的玉钢，再加上几原流的锻刀秘术，锻造出名垂青史的宝刀。"
                }
            ]
        },
        {
            "talkId": "7292901",
            "initDialog": "729290101",
            "dialogues": [
                {
                    "id": "729290101",
                    "speaker": "Player",
                    "text": "祝你成功。"
                },
                {
                    "id": "729290102",
                    "speaker": "几原凯",
                    "text": "借你吉言，我不会放弃的。"
                },
                {
                    "id": "729290103",
                    "speaker": "几原凯",
                    "text": "我最近倒是搜集到了些成色尚可的普通矿石，还有些剩余。你如果需要的话，就拿去吧。"
                }
            ]
        }
    ]
}