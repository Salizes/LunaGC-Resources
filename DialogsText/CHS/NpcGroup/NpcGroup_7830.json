{
    "groupId": "7830",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "阿尔马佐娃": 6
    },
    "talks": [
        {
            "talkId": "6783001",
            "initDialog": "678300101",
            "dialogues": [
                {
                    "id": "678300101",
                    "speaker": "阿尔马佐娃",
                    "text": "嗯嗯…不用去总部的日子，真是连坐车都觉得惬意…"
                }
            ]
        },
        {
            "talkId": "6783002",
            "initDialog": "678300201",
            "dialogues": [
                {
                    "id": "678300201",
                    "speaker": "Player",
                    "text": "总部？"
                },
                {
                    "id": "678300202",
                    "speaker": "阿尔马佐娃",
                    "text": "啊，对。您看，我是能源协会的外派人员，负责考察各地区的…嗯，总之是与能源相关的事务。"
                },
                {
                    "id": "678300203",
                    "speaker": "阿尔马佐娃",
                    "text": "既不用按时定点上班，工作负担也没那么重，只要把外派任务做完就行了。"
                },
                {
                    "id": "678300204",
                    "speaker": "阿尔马佐娃",
                    "text": "您再看看总部那边——为了维护克什尼克之炬，现在几乎是全员三班倒，连休息的时间都没有。"
                },
                {
                    "id": "678300205",
                    "speaker": "阿尔马佐娃",
                    "text": "不过我也好久都没去过总部了，上次回去的时候还差点被当成企图混入总部的骗子，叫门卫给赶出去…"
                }
            ]
        },
        {
            "talkId": "6783003",
            "initDialog": "678300301",
            "dialogues": [
                {
                    "id": "678300301",
                    "speaker": "Player",
                    "text": "祝你旅途愉快。"
                },
                {
                    "id": "678300302",
                    "speaker": "阿尔马佐娃",
                    "text": "谢谢。也祝您旅途愉快。"
                }
            ]
        }
    ]
}