{
    "groupId": "1435",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 8,
        "玛乔丽": 26
    },
    "talks": [
        {
            "talkId": "6143505",
            "initDialog": "614350501",
            "dialogues": [
                {
                    "id": "614350501",
                    "speaker": "Player",
                    "text": "想找些特别的纪念品。"
                },
                {
                    "id": "614350502",
                    "speaker": "玛乔丽",
                    "text": "那你可是来对地方了！请看看这些合不合心意？"
                }
            ]
        },
        {
            "talkId": "6143506",
            "initDialog": "614350601",
            "dialogues": [
                {
                    "id": "614350601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6143507",
            "initDialog": "614350701",
            "dialogues": [
                {
                    "id": "614350701",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6143508",
            "initDialog": "614350801",
            "dialogues": [
                {
                    "id": "614350801",
                    "speaker": "玛乔丽",
                    "text": "欸，你打牌的技术比那些酒客好多了呀…"
                }
            ]
        },
        {
            "talkId": "6143509",
            "initDialog": "614350901",
            "dialogues": [
                {
                    "id": "614350901",
                    "speaker": "玛乔丽",
                    "text": "唔，看来你还得多多练习呢。"
                }
            ]
        },
        {
            "talkId": "6143510",
            "initDialog": "614351001",
            "dialogues": [
                {
                    "id": "614351001",
                    "speaker": "玛乔丽",
                    "text": "呼…看来你平时也没少打牌呢…"
                }
            ]
        },
        {
            "talkId": "6143511",
            "initDialog": "614351101",
            "dialogues": [
                {
                    "id": "614351101",
                    "speaker": "玛乔丽",
                    "text": "抱歉，这局是我赢了喔。"
                }
            ]
        },
        {
            "talkId": "40172",
            "initDialog": "4015143501",
            "dialogues": [
                {
                    "id": "4015143501",
                    "speaker": "玛乔丽",
                    "text": "欢迎光临，这里宝物每个都独一无二，所以拒不还价，概不退换哦。",
                    "choices": [
                        {
                            "id": "4015143516",
                            "text": "想了解些事情。",
                            "response": [
                                {
                                    "id": "4015143517",
                                    "speaker": "玛乔丽",
                                    "text": "哦？看样子你很感兴趣嘛。"
                                }
                            ]
                        },
                        {
                            "id": "4015143505",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "4015143515",
                                    "speaker": "玛乔丽",
                                    "text": "哦！下次来的时候记得带点宝贝给我啊！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "40192",
            "initDialog": "4015143551",
            "dialogues": [
                {
                    "id": "4015143551",
                    "speaker": "玛乔丽",
                    "text": "欢迎光临，这里宝物每个都独一无二，所以拒不还价，概不退换哦。"
                }
            ]
        },
        {
            "talkId": "41707",
            "initDialog": "4015143502",
            "dialogues": [
                {
                    "id": "4015143502",
                    "speaker": "玛乔丽",
                    "text": "挑选商品。"
                },
                {
                    "id": "4015143506",
                    "speaker": "玛乔丽",
                    "text": "请自己看吧，对哪个感兴趣可以直接跟我说哦。"
                }
            ]
        },
        {
            "talkId": "6143501",
            "initDialog": "614350101",
            "dialogues": [
                {
                    "id": "614350101",
                    "speaker": "玛乔丽",
                    "text": "挑选商品。"
                },
                {
                    "id": "614350102",
                    "speaker": "玛乔丽",
                    "text": "哦呀哦呀，真是不巧，店里最近正在翻修…"
                },
                {
                    "id": "614350103",
                    "speaker": "玛乔丽",
                    "text": "记得下次再来看看吧，本店的货品绝对不会让你失望！"
                }
            ]
        },
        {
            "talkId": "6143502",
            "initDialog": "4015143503",
            "dialogues": [
                {
                    "id": "4015143503",
                    "speaker": "Player",
                    "text": "关于货物。"
                },
                {
                    "id": "4015143507",
                    "speaker": "玛乔丽",
                    "text": "看上哪个宝贝了？别这么犹豫嘛，这些纪念品可都是独一无二的，客人你带走哪一个都不会吃亏啦！"
                },
                {
                    "id": "4015143508",
                    "speaker": "玛乔丽",
                    "text": "它们可都是从冒险家手里收购的，里面饱含着冒险家的热血和勇气——"
                },
                {
                    "id": "4015143509",
                    "speaker": "玛乔丽",
                    "text": "所以不要问折扣了，热血和勇气从不打折！"
                }
            ]
        },
        {
            "talkId": "6143503",
            "initDialog": "4015143504",
            "dialogues": [
                {
                    "id": "4015143504",
                    "speaker": "Player",
                    "text": "关于这家店。"
                },
                {
                    "id": "4015143510",
                    "speaker": "玛乔丽",
                    "text": "你问来历？是因为我老爹啦。"
                },
                {
                    "id": "4015143511",
                    "speaker": "玛乔丽",
                    "text": "就是那位冒险家协会蒙德分会的会长，每次探险后都会带着很多宝物回家来。"
                },
                {
                    "id": "4015143512",
                    "speaker": "玛乔丽",
                    "text": "然后给我讲每一件宝物的故事…小时候的我很崇拜他。"
                },
                {
                    "id": "4015143513",
                    "speaker": "玛乔丽",
                    "text": "我想把这些故事讲给其他人听，就开了这家店——"
                },
                {
                    "id": "4015143514",
                    "speaker": "玛乔丽",
                    "text": "但是我开了这家店之后，老爹就变成了个自说自话的老头子…真没办法。"
                }
            ]
        },
        {
            "talkId": "6143504",
            "initDialog": "4015143518",
            "dialogues": [
                {
                    "id": "4015143518",
                    "speaker": "Player",
                    "text": "我好像听到你在说奔狼领？"
                },
                {
                    "id": "4015143519",
                    "speaker": "玛乔丽",
                    "text": "嗯，我前段时间在奔狼领看到过一个奇怪的身影。"
                },
                {
                    "id": "4015143520",
                    "speaker": "玛乔丽",
                    "text": "从背影来看，应该是个男孩，可是他却和狼群在一起，还很亲密的样子…"
                },
                {
                    "id": "4015143521",
                    "speaker": "玛乔丽",
                    "text": "或许是我看错了吧，毕竟我也只是远远地瞥了一眼。"
                },
                {
                    "id": "4015143522",
                    "speaker": "玛乔丽",
                    "text": "人怎么可能和狼生活在一起呢？太奇怪了…"
                }
            ]
        }
    ]
}