    "talks": [
        {
            "talkId": "6408001",
            "initDialog": "640800101",
            "dialogues": [
                {
                    "id": "640800101",
                    "speaker": "古尔根",
                    "text": "你好，需要药草吗？"
                }
            ]
        },
        {
            "talkId": "6408002",
            "initDialog": "640800201",
            "dialogues": [
                {
                    "id": "640800201",
                    "speaker": "Player",
                    "text": "药草？"
                },
                {
                    "id": "640800202",
                    "speaker": "古尔根",
                    "text": "我的父亲是药农，我从海难中幸存之后，也回家帮忙种田了。"
                },
                {
                    "id": "640800203",
                    "speaker": "古尔根",
                    "text": "因为海难留下了后遗症，所以我不能再出海，便从虚空终端中重新申请了培育药草的技术知识。"
                },
                {
                    "id": "640800204",
                    "speaker": "古尔根",
                    "text": "因为及时的急救我才活了下来，所以当父亲决定要为「健康之家」提供免费药草时，我十分支持。"
                },
                {
                    "id": "640800205",
                    "speaker": "古尔根",
                    "text": "如果可以的话，我还想参加考核，争取能够进入教令院学习医术。"
                }
            ]
        },
        {
            "talkId": "6408003",
            "initDialog": "640800301",
            "dialogues": [
                {
                    "id": "640800301",
                    "speaker": "Player",
                    "text": "不用，多谢。"
                },
                {
                    "id": "640800302",
                    "speaker": "古尔根",
                    "text": "好，有需要就来找我吧，不收费的。"
                }
            ]
        },
        {
            "talkId": "6408004",
            "initDialog": "640800401",
            "dialogues": [
                {
                    "id": "640800401",
                    "speaker": "Player",
                    "text": "药草？"
                },
                {
                    "id": "640800402",
                    "speaker": "古尔根",
                    "text": "我的父亲是药农，我从海难中幸存之后，也回家帮忙种田了。"
                },
                {
                    "id": "640800403",
                    "speaker": "古尔根",
                    "text": "因为及时的急救我才活了下来，所以当父亲决定要为「健康之家」提供免费药草时，我十分支持。"
                },
                {
                    "id": "640800404",
                    "speaker": "古尔根",
                    "text": "虽然不能再出海，但如果可以的话，我想去禅那园那边参观看看。"
                },
                {
                    "id": "640800405",
                    "speaker": "古尔根",
                    "text": "听说现在有不少讲座对外开放了，我如果自学些草药知识，然后参加考核，没准能有机会进入教令院学习医术呢。"
                }
            ]
        }
    ]
}