{
    "groupId": "20284",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "(test)鲸井小弟$UNRELEASED": 18,
        "Player": 8,
        "派蒙": 1
    },
    "talks": [
        {
            "talkId": "7216001",
            "initDialog": "721600101",
            "dialogues": [
                {
                    "id": "721600101",
                    "speaker": "(test)鲸井小弟$UNRELEASED",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，要玩手鞠吗？$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "7216002",
            "initDialog": "721600201",
            "dialogues": [
                {
                    "id": "721600201",
                    "speaker": "Player",
                    "text": "来玩手鞠吧。"
                },
                {
                    "id": "721600202",
                    "speaker": "(test)鲸井小弟$UNRELEASED",
                    "text": "好耶！目标是在限制时间内，找到手鞠哦！$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "7216003",
            "initDialog": "721600301",
            "dialogues": [
                {
                    "id": "721600301",
                    "speaker": "Player",
                    "text": "现在不太方便…"
                },
                {
                    "id": "721600302",
                    "speaker": "(test)鲸井小弟$UNRELEASED",
                    "text": "嗯嗯，我明白了。下次再来陪我玩哦！$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "7216020",
            "initDialog": "721602001",
            "dialogues": [
                {
                    "id": "721602001",
                    "speaker": "(test)鲸井小弟$UNRELEASED",
                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}真厉害，连我们鲸井兄弟的「鲸井御殿流手鞠术」都被破解了。$UNRELEASED",
                    "choices": [
                        {
                            "id": "721602002",
                            "text": "关于手鞠的玩法…$UNRELEASED",
                            "response": [
                                {
                                    "id": "721602003",
                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                    "text": "找手鞠的话，需要在限定时间内找到别人藏的手鞠就赢了。$UNRELEASED"
                                },
                                {
                                    "id": "721602004",
                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                    "text": "要藏手鞠的话，也要在同样的限定时间内，把手鞠藏起来。这样对找的人才公平嘛。冒险家大姐姐说过，游戏公平很重要！$UNRELEASED"
                                }
                            ]
                        },
                        {
                            "id": "721602005",
                            "text": "关于你自己…$UNRELEASED",
                            "response": [
                                {
                                    "id": "721602006",
                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                    "text": "嗯，怎么了吗？$UNRELEASED",
                                    "choices": [
                                        {
                                            "id": "721602007",
                                            "text": "「鲸井御殿流手鞠术」？$UNRELEASED",
                                            "response": [
                                                {
                                                    "id": "721602008",
                                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                                    "text": "啊，是我们在涉川爷爷的提点下，自创的流派。目的是用手鞠开发出无敌的武术。$UNRELEASED"
                                                },
                                                {
                                                    "id": "721602009",
                                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                                    "text": "如果能用各种办法把会爆炸的手鞠送到敌人身边，那我们就能不战而胜！$UNRELEASED"
                                                },
                                                {
                                                    "id": "721602010",
                                                    "speaker": "派蒙",
                                                    "text": "我很确信手鞠不是这么玩的…$UNRELEASED"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721602011",
                                            "text": "鲸井家到底有多少人？$UNRELEASED",
                                            "response": [
                                                {
                                                    "id": "721602012",
                                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                                    "text": "唔…我想想…$UNRELEASED"
                                                },
                                                {
                                                    "id": "721602013",
                                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                                    "text": "除了爸爸妈妈以外，我们最上面有一个姐姐，叫椛。以前她经常陪我们玩。$UNRELEASED"
                                                },
                                                {
                                                    "id": "721602014",
                                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                                    "text": "但自从她迷上钓鱼以后，就不愿意陪我们玩了。还说我们会把鱼吓跑！$UNRELEASED"
                                                },
                                                {
                                                    "id": "721602015",
                                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                                    "text": "然后…我们几兄弟到底有多少人呢？说实话我也分不清楚…$UNRELEASED"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "721602016",
                                            "text": "之前说的冒险家…$UNRELEASED",
                                            "response": [
                                                {
                                                    "id": "721602017",
                                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                                    "text": "是个很厉害的冒险家姐姐！$UNRELEASED"
                                                },
                                                {
                                                    "id": "721602018",
                                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                                    "text": "她教我们怎么玩手鞠、怎么唱手鞠歌，还教我们用手鞠把坏人「轰」地炸飞！$UNRELEASED"
                                                },
                                                {
                                                    "id": "721602019",
                                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                                    "text": "最后她走的时候说，自己要去好远好远的地方，做很重要的事情。$UNRELEASED"
                                                },
                                                {
                                                    "id": "721602020",
                                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                                    "text": "所以我们要研究「手鞠术」，以后给她帮忙！$UNRELEASED"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "721602021",
                            "text": "再见。$UNRELEASED",
                            "response": [
                                {
                                    "id": "721602022",
                                    "speaker": "(test)鲸井小弟$UNRELEASED",
                                    "text": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}再见！如果遇到我的兄弟和姐姐，帮我打个招呼噢！$UNRELEASED"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}