{
    "groupId": "4369",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "古思塔斯普": 9
    },
    "talks": [
        {
            "talkId": "6436901",
            "initDialog": "643690101",
            "dialogues": [
                {
                    "id": "643690101",
                    "speaker": "古思塔斯普",
                    "text": "哎呦，您好您好，快请坐。"
                },
                {
                    "id": "643690102",
                    "speaker": "古思塔斯普",
                    "text": "等老爷回来，我就为您通报。"
                }
            ]
        },
        {
            "talkId": "6436902",
            "initDialog": "643690201",
            "dialogues": [
                {
                    "id": "643690201",
                    "speaker": "Player",
                    "text": "这哪有座位啊？"
                },
                {
                    "id": "643690202",
                    "speaker": "古思塔斯普",
                    "text": "您说的是，是我们招待不周了。"
                },
                {
                    "id": "643690203",
                    "speaker": "古思塔斯普",
                    "text": "也不知我们老爷是怎么想的，找人建了这么大一个宫殿，大门前却连个给客人等候的地方都没准备。"
                },
                {
                    "id": "643690204",
                    "speaker": "古思塔斯普",
                    "text": "您等着，等老爷回来，我一定跟她好好反映反映这个问题。"
                }
            ]
        },
        {
            "talkId": "6436903",
            "initDialog": "643690301",
            "dialogues": [
                {
                    "id": "643690301",
                    "speaker": "Player",
                    "text": "「老爷」是…"
                },
                {
                    "id": "643690302",
                    "speaker": "古思塔斯普",
                    "text": "哎呦，原来您不知道这里住着谁啊？"
                },
                {
                    "id": "643690303",
                    "speaker": "古思塔斯普",
                    "text": "这就说笑了呀，既然不知道这的主人是哪位，那您过来到底是要找谁呢？"
                },
                {
                    "id": "643690304",
                    "speaker": "古思塔斯普",
                    "text": "您都不知道要找谁，那我就更帮不上忙了呀。您明月入怀，还请多担待。"
                }
            ]
        },
        {
            "talkId": "6436904",
            "initDialog": "643690401",
            "dialogues": [
                {
                    "id": "643690401",
                    "speaker": "Player",
                    "text": "告辞。"
                },
                {
                    "id": "643690402",
                    "speaker": "古思塔斯普",
                    "text": "哎，好嘞，您慢走。"
                }
            ]
        }
    ]
}