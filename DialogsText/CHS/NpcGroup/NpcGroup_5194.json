{
    "groupId": "5194",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "「缇拉」": 16
    },
    "talks": [
        {
            "talkId": "6519401",
            "initDialog": "651940101",
            "dialogues": [
                {
                    "id": "651940101",
                    "speaker": "「缇拉」",
                    "text": "这酒味道不错，来一杯？我请客。"
                }
            ]
        },
        {
            "talkId": "6519402",
            "initDialog": "651940201",
            "dialogues": [
                {
                    "id": "651940201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "651940202",
                    "speaker": "「缇拉」",
                    "text": "啊，失礼。向您自我介绍。"
                },
                {
                    "id": "651940203",
                    "speaker": "「缇拉」",
                    "text": "我是「缇拉」，一个微不足道的「传话人」。"
                },
                {
                    "id": "651940204",
                    "speaker": "「缇拉」",
                    "text": "很高兴和您见面。您和传闻中一样，看上去就是一位值得信任的好人。"
                }
            ]
        },
        {
            "talkId": "6519403",
            "initDialog": "651940301",
            "dialogues": [
                {
                    "id": "651940301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651940302",
                    "speaker": "「缇拉」",
                    "text": "祝您愉快。我相信，咱们很快就会再见的。"
                }
            ]
        },
        {
            "talkId": "6519404",
            "initDialog": "651940401",
            "dialogues": [
                {
                    "id": "651940401",
                    "speaker": "Player",
                    "text": "你认识我？"
                },
                {
                    "id": "651940402",
                    "speaker": "「缇拉」",
                    "text": "您瞧，我怎么可能没听过您的大名呢？您的事迹在我们之中，可是流传甚广啊。"
                },
                {
                    "id": "651940403",
                    "speaker": "「缇拉」",
                    "text": "我的好几位同行都准备向您发出邀请，进行一场…友好的会谈，并且期待着和您达成一些…双赢的协议。"
                }
            ]
        },
        {
            "talkId": "6519405",
            "initDialog": "651940501",
            "dialogues": [
                {
                    "id": "651940501",
                    "speaker": "Player",
                    "text": "「传话人」是什么？"
                },
                {
                    "id": "651940502",
                    "speaker": "「缇拉」",
                    "text": "别在意，别在意。这只是一份帮人解愁的无聊工作而已。"
                },
                {
                    "id": "651940503",
                    "speaker": "「缇拉」",
                    "text": "某个人想要找人帮忙，我们就去帮他找，某个人想要传递信息，那我们去帮他传递。"
                },
                {
                    "id": "651940504",
                    "speaker": "「缇拉」",
                    "text": "无论如何，就工作本身而言，和渔夫、厨师、船员、搬运工没有任何区别。"
                },
                {
                    "id": "651940505",
                    "speaker": "「缇拉」",
                    "text": "要我说，从某些方面来说，「传话人」这份工作甚至更具有…公益性，嘿嘿嘿。"
                }
            ]
        },
        {
            "talkId": "6519406",
            "initDialog": "651940601",
            "dialogues": [
                {
                    "id": "651940601",
                    "speaker": "Player",
                    "text": "什么协议？"
                },
                {
                    "id": "651940602",
                    "speaker": "「缇拉」",
                    "text": "喔！生意还能是什么，赚钱！拿好处！捞点油水！无论如何，总不可能白白消耗生命。"
                },
                {
                    "id": "651940603",
                    "speaker": "「缇拉」",
                    "text": "嘿嘿嘿，如果您感兴趣，那我万分荣幸，等我拟好了合作协议后，会挑一个合适的时机拜访您的。"
                },
                {
                    "id": "651940604",
                    "speaker": "「缇拉」",
                    "text": "希望，到时候咱们合作愉快。"
                }
            ]
        },
        {
            "talkId": "7494701",
            "initDialog": "749470101",
            "dialogues": [
                {
                    "id": "749470101",
                    "speaker": "Player",
                    "text": "我觉得我们没有合作的机会。"
                },
                {
                    "id": "749470102",
                    "speaker": "「缇拉」",
                    "text": "别这么说，未来的事谁能明白？请您拿着这个，算是我的一点…小小「诚意」。"
                },
                {
                    "id": "749470103",
                    "speaker": "「缇拉」",
                    "text": "祝您今天和明天愉快。嘿嘿嘿…"
                }
            ]
        }
    ]
}