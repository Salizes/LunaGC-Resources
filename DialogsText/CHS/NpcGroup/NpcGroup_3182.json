{
    "groupId": "3182",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 3,
        "大岛纯平": 14
    },
    "talks": [
        {
            "talkId": "6318201",
            "initDialog": "631820101",
            "dialogues": [
                {
                    "id": "631820101",
                    "speaker": "大岛纯平",
                    "text": "总算是又找到工作了…太好了…"
                }
            ]
        },
        {
            "talkId": "6318202",
            "initDialog": "631820201",
            "dialogues": [
                {
                    "id": "631820201",
                    "speaker": "Player",
                    "text": "关于工作…"
                },
                {
                    "id": "631820202",
                    "speaker": "大岛纯平",
                    "text": "喔！是你啊，谢谢你帮我介绍的这份工作，旅行者。"
                },
                {
                    "id": "631820203",
                    "speaker": "大岛纯平",
                    "text": "和之前约定的一样，这座神社的维修工作以后都会由我来负责啦。"
                },
                {
                    "id": "631820204",
                    "speaker": "大岛纯平",
                    "text": "报酬什么的…代宫司大人说自己会想办法解决，嘿嘿，我就只用照顾好神社就行了。"
                },
                {
                    "id": "631820205",
                    "speaker": "大岛纯平",
                    "text": "闲下来的时候，我还在尝试雕刻一些木雕呢。"
                }
            ]
        },
        {
            "talkId": "6318203",
            "initDialog": "631820301",
            "dialogues": [
                {
                    "id": "631820301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631820302",
                    "speaker": "大岛纯平",
                    "text": "再见！可要努力工作啊！"
                }
            ]
        },
        {
            "talkId": "6318204",
            "initDialog": "631820401",
            "dialogues": [
                {
                    "id": "631820401",
                    "speaker": "Player",
                    "text": "你还会木雕？"
                },
                {
                    "id": "631820402",
                    "speaker": "大岛纯平",
                    "text": "那是当然了！我会的手艺可是很多的。"
                },
                {
                    "id": "631820403",
                    "speaker": "大岛纯平",
                    "text": "这些木雕都是我依据代宫司大人的各种姿势来雕刻的。"
                },
                {
                    "id": "631820404",
                    "speaker": "大岛纯平",
                    "text": "这种木雕尺寸很小，可以很方便地拿在手里玩，或者是摆在屋子里做装饰。"
                },
                {
                    "id": "631820405",
                    "speaker": "大岛纯平",
                    "text": "我想，在我雕得再好一些之后，就拜托人带着这些木雕去鸣神岛，看看有没有人愿意买这种小雕像。"
                },
                {
                    "id": "631820406",
                    "speaker": "大岛纯平",
                    "text": "如果真有人愿意买的话，说不定这也是一桩好生意呢。"
                },
                {
                    "id": "631820407",
                    "speaker": "大岛纯平",
                    "text": "要是能赚到点钱的话…我就把这个神社整修一下，让它更气派！"
                },
                {
                    "id": "631820408",
                    "speaker": "大岛纯平",
                    "text": "这样的话，代宫司大人也会很高兴吧。"
                },
                {
                    "id": "631820409",
                    "speaker": "大岛纯平",
                    "text": "至于整修的款项…呃…就等那位叫做「阿响」的人回来，再一起结给我吧。"
                }
            ]
        }
    ]
}