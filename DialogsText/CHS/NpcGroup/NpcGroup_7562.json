{
    "groupId": "7562",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "普威则": 7
    },
    "talks": [
        {
            "talkId": "6756201",
            "initDialog": "675620101",
            "dialogues": [
                {
                    "id": "675620101",
                    "speaker": "普威则",
                    "text": "哇喔，这可真是个了不起的大家伙…这章鱼看上去比部族里的龙还大…"
                }
            ]
        },
        {
            "talkId": "6756202",
            "initDialog": "675620201",
            "dialogues": [
                {
                    "id": "675620201",
                    "speaker": "Player",
                    "text": "哇喔，纳塔人！"
                },
                {
                    "id": "675620202",
                    "speaker": "普威则",
                    "text": "倒也不用这么惊讶吧…咦，说起来，这里人说不定常常能从海里捞到这么大的家伙…"
                },
                {
                    "id": "675620203",
                    "speaker": "普威则",
                    "text": "反而是身为纳塔人的我在这里比较少见？"
                }
            ]
        },
        {
            "talkId": "6756203",
            "initDialog": "675620301",
            "dialogues": [
                {
                    "id": "675620301",
                    "speaker": "Player",
                    "text": "咦，在这不觉得冷吗？"
                },
                {
                    "id": "675620302",
                    "speaker": "普威则",
                    "text": "稍微有点冷啦，不过我刚才有在那里坐了一会儿蹲起…现在好了很多。"
                },
                {
                    "id": "675620303",
                    "speaker": "普威则",
                    "text": "觉得冷，就得用运动让自己的身子热起来。"
                },
                {
                    "id": "675620304",
                    "speaker": "普威则",
                    "text": "下次你要是觉得冷的话，也稍微运动一下试试看吧！"
                }
            ]
        },
        {
            "talkId": "6756204",
            "initDialog": "675620401",
            "dialogues": [
                {
                    "id": "675620401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675620402",
                    "speaker": "普威则",
                    "text": "再见…哎，他们什么时候会把这个章鱼做成菜呢…"
                }
            ]
        }
    ]
}