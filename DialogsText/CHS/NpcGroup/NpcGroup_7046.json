{
    "groupId": "7046",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 5,
        "奈芙尔": 4,
        "祖潘科": 18
    },
    "talks": [
        {
            "talkId": "6704601",
            "initDialog": "670460101",
            "dialogues": [
                {
                    "id": "670460101",
                    "speaker": "祖潘科",
                    "text": "真是…真是热火朝天，这里的氛围比起帕克斯神庙那边的锻造台也不遑多让啊！"
                }
            ]
        },
        {
            "talkId": "6704602",
            "initDialog": "670460201",
            "dialogues": [
                {
                    "id": "670460201",
                    "speaker": "Player",
                    "text": "龙遗物研究协会的成员？"
                },
                {
                    "id": "670460202",
                    "speaker": "祖潘科",
                    "text": "是的，哈哈，没想到在这儿居然会被认出来…不过，啊！龙遗物，完了，我又忘了去调查…"
                },
                {
                    "id": "670460203",
                    "speaker": "祖潘科",
                    "text": "本来是听说挪德卡莱有龙遗物相关的遗迹才过来的，但是，新奇的东西也太多了。"
                },
                {
                    "id": "670460204",
                    "speaker": "祖潘科",
                    "text": "唉…申请的经费是调查用的，祖潘科，不能再买那些奇怪的小机关了…"
                }
            ]
        },
        {
            "talkId": "6704603",
            "initDialog": "670460301",
            "dialogues": [
                {
                    "id": "670460301",
                    "speaker": "Player",
                    "text": "你在看什么呢？"
                },
                {
                    "id": "670460302",
                    "speaker": "祖潘科",
                    "text": "当然是这个烧着火的大家伙啦！真是了不起的机关。跟我们那边利用液态燃素的皈礼熔炉不太一样，该怎么说呢…"
                },
                {
                    "id": "670460303",
                    "speaker": "祖潘科",
                    "text": "自动运行，还有着复杂「结构」的机关，跟我们那边完全是两种风格，真是让人大开眼界…"
                },
                {
                    "id": "670460304",
                    "speaker": "祖潘科",
                    "text": "即使站在这里，都能感受到炉火熊熊燃烧散发的热浪，真是舒服啊。"
                },
                {
                    "id": "670460305",
                    "speaker": "祖潘科",
                    "text": "真奇怪，这么舒服的地方当地人却不喜欢，还问我有没有被烫伤…"
                }
            ]
        },
        {
            "talkId": "6704604",
            "initDialog": "670460401",
            "dialogues": [
                {
                    "id": "670460401",
                    "speaker": "Player",
                    "text": "不打扰你了。"
                },
                {
                    "id": "670460402",
                    "speaker": "祖潘科",
                    "text": "嗯…好，我再在这儿站一会儿，再站一会儿就去调查龙遗物…"
                }
            ]
        },
        {
            "talkId": "6704605",
            "initDialog": "670460501",
            "dialogues": [
                {
                    "id": "670460501",
                    "speaker": "Player",
                    "text": "原来是在烤火！"
                },
                {
                    "id": "670460502",
                    "speaker": "祖潘科",
                    "text": "是在做调查…咳咳，调查研究。顺便暖和一下身子，这里实在是有点冷…"
                }
            ]
        },
        {
            "talkId": "6704606",
            "initDialog": "670460601",
            "dialogues": [
                {
                    "id": "670460601",
                    "speaker": "祖潘科",
                    "text": "（<color=#FFCC33FF>奈芙尔</color>似乎有所思考…）"
                },
                {
                    "id": "670460602",
                    "speaker": "奈芙尔",
                    "text": "怎么样，还习惯挪德卡莱么？"
                },
                {
                    "id": "670460603",
                    "speaker": "祖潘科",
                    "text": "奈芙尔老板，您好。习惯当然是不可能习惯的，毕竟温度实在差太多了。"
                },
                {
                    "id": "670460604",
                    "speaker": "祖潘科",
                    "text": "但这里还挺暖和，我觉得待着挺好。那个…上次我拜托您，帮我联系向导的事…"
                },
                {
                    "id": "670460605",
                    "speaker": "奈芙尔",
                    "text": "本来有一个合适的人选，可惜她最近有点忙，过段时间，我再为你安排。"
                },
                {
                    "id": "670460606",
                    "speaker": "祖潘科",
                    "text": "太感谢您了！唉，这里实在太冷，我得再暖和一下…"
                }
            ]
        },
        {
            "talkId": "6704607",
            "initDialog": "670460701",
            "dialogues": [
                {
                    "id": "670460701",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>奈芙尔</color>似乎有所思考…）"
                },
                {
                    "id": "670460702",
                    "speaker": "奈芙尔",
                    "text": "怎么样，问题解决了么？"
                },
                {
                    "id": "670460703",
                    "speaker": "祖潘科",
                    "text": "解决了！多谢奈芙尔老板，报酬我还是会照常支付的，之后说不定还要麻烦您帮其他的忙…"
                },
                {
                    "id": "670460704",
                    "speaker": "奈芙尔",
                    "text": "好。那希望我们后面也，合作愉快。"
                }
            ]
        },
        {
            "talkId": "6704608",
            "initDialog": "670460801",
            "dialogues": [
                {
                    "id": "670460801",
                    "speaker": "祖潘科",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6704609",
            "initDialog": "670460901",
            "dialogues": [
                {
                    "id": "670460901",
                    "speaker": "祖潘科",
                    "text": "承让了！哈哈，看来这次是我的运气更好！"
                }
            ]
        },
        {
            "talkId": "6704610",
            "initDialog": "670461001",
            "dialogues": [
                {
                    "id": "670461001",
                    "speaker": "祖潘科",
                    "text": "打得好！好久没打得这么痛快了！"
                }
            ]
        }
    ]
}