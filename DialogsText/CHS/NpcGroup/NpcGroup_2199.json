{
    "groupId": "2199",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "阿昊": 7
    },
    "talks": [
        {
            "talkId": "6219901",
            "initDialog": "621990101",
            "dialogues": [
                {
                    "id": "621990101",
                    "speaker": "阿昊",
                    "text": "啊，原来你就是传闻中的那位大英雄旅行者，可多亏了你，这下又能采矿攒钱了。"
                },
                {
                    "id": "621990102",
                    "speaker": "阿昊",
                    "text": "就是听不到老图吹牛，总觉得少了些什么，也不知道他最近又在琢磨些什么。"
                }
            ]
        },
        {
            "talkId": "6219902",
            "initDialog": "621990201",
            "dialogues": [
                {
                    "id": "621990201",
                    "speaker": "Player",
                    "text": "老图离得不远。"
                },
                {
                    "id": "621990202",
                    "speaker": "阿昊",
                    "text": "我知道，前两天还和他打了一照面呢。可是距离近归近，他有他要忙的，我有我要忙的，也顾不上说几句话。"
                },
                {
                    "id": "621990203",
                    "speaker": "阿昊",
                    "text": "不过也多亏沐宁总管好心，让他干些杂活，否则啊，他也无处可去了。"
                }
            ]
        },
        {
            "talkId": "6219903",
            "initDialog": "621990301",
            "dialogues": [
                {
                    "id": "621990301",
                    "speaker": "Player",
                    "text": "攒钱？"
                },
                {
                    "id": "621990302",
                    "speaker": "阿昊",
                    "text": "是呀，等我攒够路费，就和老图一起去璃月港转悠转悠，我觉得吧，他好像挺适合说书的…说不定以后能靠这个吃饭呢。"
                },
                {
                    "id": "621990303",
                    "speaker": "阿昊",
                    "text": "嘿嘿，我反正是习惯赚苦力钱了，这种事情还是说不准呀。"
                }
            ]
        },
        {
            "talkId": "6219904",
            "initDialog": "621990401",
            "dialogues": [
                {
                    "id": "621990401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621990402",
                    "speaker": "阿昊",
                    "text": "再见，帮我给老图问个好！"
                }
            ]
        }
    ]
}