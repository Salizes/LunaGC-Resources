{
    "groupId": "1664",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "哈里斯": 10
    },
    "talks": [
        {
            "talkId": "6166405",
            "initDialog": "616640501",
            "dialogues": [
                {
                    "id": "616640501",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6166406",
            "initDialog": "616640601",
            "dialogues": [
                {
                    "id": "616640601",
                    "speaker": "哈里斯",
                    "text": "虽然你输了，但可别气馁！来喝口热汤吧！"
                }
            ]
        },
        {
            "talkId": "6166407",
            "initDialog": "616640701",
            "dialogues": [
                {
                    "id": "616640701",
                    "speaker": "哈里斯",
                    "text": "恭喜你赢了！为了庆祝你的又一场胜利，来吃顿大餐吧！"
                }
            ]
        },
        {
            "talkId": "6166401",
            "initDialog": "616640101",
            "dialogues": [
                {
                    "id": "616640101",
                    "speaker": "哈里斯",
                    "text": "嘿，冻坏了吧？赶紧买些吃的，暖和暖和身子！"
                }
            ]
        },
        {
            "talkId": "6166402",
            "initDialog": "616640201",
            "dialogues": [
                {
                    "id": "616640201",
                    "speaker": "Player",
                    "text": "我想买些食物…"
                },
                {
                    "id": "616640202",
                    "speaker": "哈里斯",
                    "text": "想吃什么就跟我说说吧，别客气！这种天气就是得吃些热乎的！"
                }
            ]
        },
        {
            "talkId": "6166403",
            "initDialog": "616640301",
            "dialogues": [
                {
                    "id": "616640301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "616640302",
                    "speaker": "哈里斯",
                    "text": "我叫哈里斯，是个厨师，也是建了这个营地的人。"
                },
                {
                    "id": "616640303",
                    "speaker": "哈里斯",
                    "text": "我的初衷是希望能帮助在这附近活动的冒险家们，让他们能在旅途归来时喝上一碗热汤。"
                },
                {
                    "id": "616640304",
                    "speaker": "哈里斯",
                    "text": "…毕竟没有什么能比快冻僵时喝上一碗热汤更幸福的了。"
                },
                {
                    "id": "616640305",
                    "speaker": "哈里斯",
                    "text": "厨艺的精髓就是给人们带来满足和幸福，不是吗？"
                },
                {
                    "id": "616640306",
                    "speaker": "哈里斯",
                    "text": "可惜很多厨师都忘记了这一点…这简单的道理还是我以前在璃月旅行时，偶遇的一位厨娘告诉我的。"
                }
            ]
        },
        {
            "talkId": "6166404",
            "initDialog": "616640401",
            "dialogues": [
                {
                    "id": "616640401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "616640402",
                    "speaker": "哈里斯",
                    "text": "哦！要是累了，记得来我这里买些吃的、歇歇脚！"
                }
            ]
        }
    ]
}