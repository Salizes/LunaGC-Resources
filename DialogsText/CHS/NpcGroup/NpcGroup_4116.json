{
    "groupId": "4116",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "艾莲娜": 10
    },
    "talks": [
        {
            "talkId": "6411601",
            "initDialog": "641160101",
            "dialogues": [
                {
                    "id": "641160101",
                    "speaker": "艾莲娜",
                    "text": "和老家比起来，还是这里繁忙的生活适合我。"
                }
            ]
        },
        {
            "talkId": "6411602",
            "initDialog": "641160201",
            "dialogues": [
                {
                    "id": "641160201",
                    "speaker": "Player",
                    "text": "关于老家…"
                },
                {
                    "id": "641160202",
                    "speaker": "艾莲娜",
                    "text": "我的老家在须弥城，家里人也都在城里。我为了方便照看商船，就搬来奥摩斯港了。"
                },
                {
                    "id": "641160203",
                    "speaker": "艾莲娜",
                    "text": "城里的人啊，尤其是那些教令院的学者，走路都慢悠悠的，我都怕撞到他们！"
                },
                {
                    "id": "641160204",
                    "speaker": "艾莲娜",
                    "text": "还是这里的生活忙碌又充实，还容易赚到钱，比在老家好多了。"
                },
                {
                    "id": "641160205",
                    "speaker": "艾莲娜",
                    "text": "就连下班后那一顿热乎乎的咖喱，都比以前吃着香。"
                }
            ]
        },
        {
            "talkId": "6411603",
            "initDialog": "641160301",
            "dialogues": [
                {
                    "id": "641160301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641160302",
                    "speaker": "艾莲娜",
                    "text": "再见，人一定要过充实的生活。"
                }
            ]
        },
        {
            "talkId": "7390601",
            "initDialog": "739060101",
            "dialogues": [
                {
                    "id": "739060101",
                    "speaker": "Player",
                    "text": "咖喱…"
                },
                {
                    "id": "739060102",
                    "speaker": "艾莲娜",
                    "text": "嗯，咖喱可是须弥人人都会做的美食。"
                },
                {
                    "id": "739060103",
                    "speaker": "艾莲娜",
                    "text": "每家每户搭配香料的方法都不一样，所以咖喱吃起来也有不同的味道。"
                },
                {
                    "id": "739060104",
                    "speaker": "艾莲娜",
                    "text": "但，基本都很好吃啦。"
                },
                {
                    "id": "739060105",
                    "speaker": "艾莲娜",
                    "text": "怎么样，要试试看我家的咖喱不？"
                }
            ]
        }
    ]
}