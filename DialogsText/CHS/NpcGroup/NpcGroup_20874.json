            "dialogues": [
                {
                    "id": "732280701",
                    "speaker": "神秘的纪事",
                    "text": "「…白鹄骑士海杜菈，『金殿卫士』…」"
                },
                {
                    "id": "732280702",
                    "speaker": "神秘的纪事",
                    "text": "「…因背叛行为，造成一台机械不可逆损伤报废，被骑士元帅安弗塔斯处决…」"
                },
                {
                    "id": "732280703",
                    "speaker": "神秘的纪事",
                    "text": "「…尽管损失巨大，骑士元帅大人亦在此事中失去左眼，但既然身为最后的同胞，仍准许予以骑士规格葬礼…」"
                }
            ]
        }
    ]
}