    "talks": [
        {
            "talkId": "6956801",
            "initDialog": "695680101",
            "dialogues": [
                {
                    "id": "695680101",
                    "speaker": "辛焱",
                    "text": "喔，大家都很有热情啊。我要不要来弹一曲，给观众们助助兴呢？"
                }
            ]
        },
        {
            "talkId": "6956802",
            "initDialog": "695680201",
            "dialogues": [
                {
                    "id": "695680201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956803",
            "initDialog": "695680301",
            "dialogues": [
                {
                    "id": "695680301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695680302",
                    "speaker": "辛焱",
                    "text": "再见，我等会要去找老板聊聊。看能不能在这里办一场小小的演出…"
                }
            ]
        },
        {
            "talkId": "6956804",
            "initDialog": "695680401",
            "dialogues": [
                {
                    "id": "695680401",
                    "speaker": "辛焱",
                    "text": "你怎么看起来有点走神了？刚才还一副发呆的样子…来来，我给你弹首曲子，打起精神来，我们再来一局！"
                }
            ]
        },
        {
            "talkId": "6956805",
            "initDialog": "695680501",
            "dialogues": [
                {
                    "id": "695680501",
                    "speaker": "辛焱",
                    "text": "啊，我输了…嘿嘿，不过玩得真痛快，气氛也不错！下次咱们再好好玩几局，怎么样？"
                }
            ]
        },
        {
            "talkId": "6956806",
            "initDialog": "695680601",
            "dialogues": [
                {
                    "id": "695680601",
                    "speaker": "辛焱",
                    "text": "好呀，我早想找个好手试试牌组了。"
                }
            ]
        },
        {
            "talkId": "6956808",
            "initDialog": "695680801",
            "dialogues": [
                {
                    "id": "695680801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956809",
            "initDialog": "695680901",
            "dialogues": [
                {
                    "id": "695680901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956810",
            "initDialog": "695681001",
            "dialogues": [
                {
                    "id": "695681001",
                    "speaker": "辛焱",
                    "text": "嘿嘿，我的状态不错吧？"
                }
            ]
        },
        {
            "talkId": "6956811",
            "initDialog": "695681101",
            "dialogues": [
                {
                    "id": "695681101",
                    "speaker": "辛焱",
                    "text": "总觉得，这一局我打得缺了点激情…"
                }
            ]
        },
        {
            "talkId": "6956812",
            "initDialog": "695681201",
            "dialogues": [
                {
                    "id": "695681201",
                    "speaker": "辛焱",
                    "text": "没问题，痛痛快快地玩一场牌吧！"
                }
            ]
        },
        {
            "talkId": "6956814",
            "initDialog": "695681401",
            "dialogues": [
                {
                    "id": "695681401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956815",
            "initDialog": "695681501",
            "dialogues": [
                {
                    "id": "695681501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956816",
            "initDialog": "695681601",
            "dialogues": [
                {
                    "id": "695681601",
                    "speaker": "辛焱",
                    "text": "嘿嘿，收了一个好尾。"
                }
            ]
        },
        {
            "talkId": "6956817",
            "initDialog": "695681701",
            "dialogues": [
                {
                    "id": "695681701",
                    "speaker": "辛焱",
                    "text": "唉，节奏到底是从哪里开始乱的呢…"
                }
            ]
        },
