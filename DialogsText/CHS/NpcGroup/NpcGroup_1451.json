{
    "groupId": "1451",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 1,
        "门罗": 10
    },
    "talks": [
        {
            "talkId": "6145101",
            "initDialog": "4015145101",
            "dialogues": [
                {
                    "id": "4015145101",
                    "speaker": "门罗",
                    "text": "不来加入我们的祈祷吗，朋友？"
                }
            ]
        },
        {
            "talkId": "6145102",
            "initDialog": "4015145102",
            "dialogues": [
                {
                    "id": "4015145102",
                    "speaker": "门罗",
                    "text": "你在做什么？"
                },
                {
                    "id": "4015145105",
                    "speaker": "门罗",
                    "text": "这样的日子里，教堂的修女会来组织祷告活动。"
                },
                {
                    "id": "4015145106",
                    "speaker": "门罗",
                    "text": "这样的机会我从来不会错过，比起闲在家里，至少感觉是做了有意义的事。"
                },
                {
                    "id": "4015145107",
                    "speaker": "门罗",
                    "text": "心地虔诚总是没有坏处，你说对吧？"
                }
            ]
        },
        {
            "talkId": "6145103",
            "initDialog": "4015145104",
            "dialogues": [
                {
                    "id": "4015145104",
                    "speaker": "门罗",
                    "text": "再见。"
                },
                {
                    "id": "4015145111",
                    "speaker": "门罗",
                    "text": "再见，只要心地虔诚，巴巴托斯大人一定会祝福你的。"
                }
            ]
        },
        {
            "talkId": "6145104",
            "initDialog": "614510401",
            "dialogues": [
                {
                    "id": "614510401",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614510402",
                    "speaker": "门罗",
                    "text": "唉，要是龙灾再这么闹下去，我也要考虑搬到清泉镇避难了…"
                },
                {
                    "id": "614510403",
                    "speaker": "门罗",
                    "text": "我相信巴巴托斯大人一定会理解我的，无论在哪里祈祷，只要心诚就一定会得到回应的。"
                },
                {
                    "id": "614510404",
                    "speaker": "门罗",
                    "text": "…不过能不离开的话当然是最好的，所以巴巴托斯大人啊，请一定要护佑您虔诚的子民啊！"
                }
            ]
        }
    ]
}