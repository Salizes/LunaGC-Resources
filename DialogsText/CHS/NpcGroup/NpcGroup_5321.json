{
    "groupId": "5321",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "伊雅蕾": 7
    },
    "talks": [
        {
            "talkId": "6532101",
            "initDialog": "653210101",
            "dialogues": [
                {
                    "id": "653210101",
                    "speaker": "伊雅蕾",
                    "text": "是老师！今天也要教给我美丽的捕捞技巧吗？"
                }
            ]
        },
        {
            "talkId": "6532102",
            "initDialog": "653210201",
            "dialogues": [
                {
                    "id": "653210201",
                    "speaker": "Player",
                    "text": "最近有什么成果吗？"
                },
                {
                    "id": "653210202",
                    "speaker": "伊雅蕾",
                    "text": "嗯，学着上次你教授的钓鱼的方法，撒了很多的饵料，学会了吸引鱼的办法。"
                },
                {
                    "id": "653210203",
                    "speaker": "伊雅蕾",
                    "text": "虽然钓鱼还是很难，没有钓上来多少，但是至少周围水里的鱼有变得胖胖了一点，唔，也能算是成果吧。"
                }
            ]
        },
        {
            "talkId": "6532103",
            "initDialog": "653210301",
            "dialogues": [
                {
                    "id": "653210301",
                    "speaker": "Player",
                    "text": "只是路过而已…"
                },
                {
                    "id": "653210302",
                    "speaker": "伊雅蕾",
                    "text": "好吧，不过，下次还请和我一起钓鱼，这样，不仅能学习钓鱼技巧，还能一起分老师钓上来的鱼。"
                }
            ]
        },
        {
            "talkId": "6532104",
            "initDialog": "653210401",
            "dialogues": [
                {
                    "id": "653210401",
                    "speaker": "Player",
                    "text": "关于刚才的地震…"
                },
                {
                    "id": "653210402",
                    "speaker": "伊雅蕾",
                    "text": "哇啊，刚才突然晃得好厉害，鱼都被吓跑了！"
                },
                {
                    "id": "653210403",
                    "speaker": "伊雅蕾",
                    "text": "咦？仔细想想的话，难道是像德拉萝诗说的那样，出现了足以撼动整个海沫村的、超级强壮的鱼斗士…"
                },
                {
                    "id": "653210404",
                    "speaker": "伊雅蕾",
                    "text": "既然这样的话，我也必须坚守在鱼点旁，用坚强的意志打败它才行！"
                }
            ]
        }
    ]
}