{
    "groupId": "7417",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 6,
        "雅洛维娅": 10
    },
    "talks": [
        {
            "talkId": "6741701",
            "initDialog": "674170101",
            "dialogues": [
                {
                    "id": "674170101",
                    "speaker": "雅洛维娅",
                    "text": "该死的影域，就不能消停一点吗…还有一堆事要做，人手实在是不足啊…"
                }
            ]
        },
        {
            "talkId": "6741702",
            "initDialog": "674170201",
            "dialogues": [
                {
                    "id": "674170201",
                    "speaker": "Player",
                    "text": "查看「特殊招募计划」…"
                }
            ]
        },
        {
            "talkId": "6741703",
            "initDialog": "674170301",
            "dialogues": [
                {
                    "id": "674170301",
                    "speaker": "Player",
                    "text": "冬契军需要处理影域吗…"
                },
                {
                    "id": "674170302",
                    "speaker": "雅洛维娅",
                    "text": "那当然了，冬契军的职责本就是为了让女皇陛下视线所至之处都能安全稳定。"
                },
                {
                    "id": "674170303",
                    "speaker": "雅洛维娅",
                    "text": "影域可以说是最不安定的…一种灾害了，每次能源协会发来发现影域的报告，都是我们处理的…"
                }
            ]
        },
        {
            "talkId": "6741704",
            "initDialog": "674170401",
            "dialogues": [
                {
                    "id": "674170401",
                    "speaker": "Player",
                    "text": "不打扰你了。"
                },
                {
                    "id": "674170402",
                    "speaker": "雅洛维娅",
                    "text": "好的，请自便。啊，如果发现影域，请及时联系冬契军。"
                }
            ]
        },
        {
            "talkId": "6741705",
            "initDialog": "674170501",
            "dialogues": [
                {
                    "id": "674170501",
                    "speaker": "Player",
                    "text": "能源协会？"
                },
                {
                    "id": "674170502",
                    "speaker": "雅洛维娅",
                    "text": "我们冬契军哪有空到处跑，反而是能源协会那种每天都要到各处去维护克什尼克之炬的组织更灵活…"
                },
                {
                    "id": "674170503",
                    "speaker": "雅洛维娅",
                    "text": "虽然说起来也有点奇怪…有的时候觉得他们掌握了什么和影域有关的情报…"
                },
                {
                    "id": "674170504",
                    "speaker": "雅洛维娅",
                    "text": "不过只要他们能及时发现影域就行。"
                }
            ]
        },
        {
            "talkId": "6741706",
            "initDialog": "674170601",
            "dialogues": [
                {
                    "id": "674170601",
                    "speaker": "Player",
                    "text": "你们一般怎么处理？"
                },
                {
                    "id": "674170602",
                    "speaker": "雅洛维娅",
                    "text": "组织探查的部队，如果能够检测到影域的能量核心就处理掉，不能就封锁。"
                },
                {
                    "id": "674170603",
                    "speaker": "雅洛维娅",
                    "text": "大多数时候影域会自然消去…只要没有人误入，就没有太大的关系。"
                }
            ]
        },
        {
            "talkId": "6741707",
            "initDialog": "674170701",
            "dialogues": [
                {
                    "id": "674170701",
                    "speaker": "Player",
                    "text": "辛苦了。"
                },
                {
                    "id": "674170702",
                    "speaker": "雅洛维娅",
                    "text": "都是职责所系。"
                }
            ]
        }
    ]
}