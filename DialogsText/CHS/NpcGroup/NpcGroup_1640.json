{
    "groupId": "1640",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "石榴": 17
    },
    "talks": [
        {
            "talkId": "6164001",
            "initDialog": "616400101",
            "dialogues": [
                {
                    "id": "616400101",
                    "speaker": "石榴",
                    "text": "还真是完全卖不出去呢…"
                }
            ]
        },
        {
            "talkId": "6164002",
            "initDialog": "616400201",
            "dialogues": [
                {
                    "id": "616400201",
                    "speaker": "石榴",
                    "text": "什么卖不出去？"
                },
                {
                    "id": "616400202",
                    "speaker": "石榴",
                    "text": "珠宝啊，这些可都是我从璃月港带来的，百年老字号「明星斋」的货品，瞧瞧这成色！"
                },
                {
                    "id": "616400203",
                    "speaker": "石榴",
                    "text": "…看你的打扮，是旅行者吗？好吧，你想说这些对旅行没用的东西，买来也没必要是吧？"
                },
                {
                    "id": "616400204",
                    "speaker": "石榴",
                    "text": "唉…我还真是失算了，本以为来到蒙德可以拓展销路…"
                },
                {
                    "id": "616400205",
                    "speaker": "石榴",
                    "text": "可没想到这里的人，宁愿把口袋里的钱全都拿去买酒也不愿看上一眼…"
                },
                {
                    "id": "616400206",
                    "speaker": "石榴",
                    "text": "莫非其实是买不起？唔…确实不是所有的城市都像璃月那么富足…"
                }
            ]
        },
        {
            "talkId": "6164003",
            "initDialog": "616400301",
            "dialogues": [
                {
                    "id": "616400301",
                    "speaker": "石榴",
                    "text": "关于璃月港。"
                },
                {
                    "id": "616400302",
                    "speaker": "石榴",
                    "text": "哦~你对我的家乡感兴趣啊。"
                },
                {
                    "id": "616400303",
                    "speaker": "石榴",
                    "text": "璃月有着全提瓦特最繁华的商港，在那里汇集着各个国家的商人，我也是从小耳濡目染才选择经商的，嘿嘿。"
                },
                {
                    "id": "616400304",
                    "speaker": "石榴",
                    "text": "听说过摩拉克斯大人吗，那位守护着璃月的神明？"
                },
                {
                    "id": "616400305",
                    "speaker": "石榴",
                    "text": "那你至少应该知道，你手里的摩拉就是以他的名字命名的！"
                },
                {
                    "id": "616400306",
                    "speaker": "石榴",
                    "text": "唉，好久没回去了，莫非我就是离摩拉克斯大人太远了，所以才赚不到钱？"
                }
            ]
        },
        {
            "talkId": "6164004",
            "initDialog": "616400401",
            "dialogues": [
                {
                    "id": "616400401",
                    "speaker": "石榴",
                    "text": "再见。"
                },
                {
                    "id": "616400402",
                    "speaker": "石榴",
                    "text": "果然你也不买吗！"
                }
            ]
        },
        {
            "talkId": "6164005",
            "initDialog": "616400501",
            "dialogues": [
                {
                    "id": "616400501",
                    "speaker": "石榴",
                    "text": "你这里卖什么？"
                },
                {
                    "id": "616400502",
                    "speaker": "石榴",
                    "text": "请您随便选！都是从璃月来的上好货色，实惠又好看！"
                }
            ]
        }
    ]
}