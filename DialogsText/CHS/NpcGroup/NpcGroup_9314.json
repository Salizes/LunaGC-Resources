{
    "groupId": "9314",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "砂糖": 9
    },
    "talks": [
        {
            "talkId": "6931401",
            "initDialog": "693140101",
            "dialogues": [
                {
                    "id": "693140101",
                    "speaker": "砂糖",
                    "text": "我在想，能不能将我制作好的药剂运用在之后的战斗中…"
                },
                {
                    "id": "693140102",
                    "speaker": "砂糖",
                    "text": "啊！我明白，这里不是做实验的好地方…贸然行动可能会引起其他麻烦。"
                },
                {
                    "id": "693140103",
                    "speaker": "砂糖",
                    "text": "但有这么多问题装在脑袋里，根本没办法好好休息…唉。"
                }
            ]
        },
        {
            "talkId": "6931402",
            "initDialog": "693140201",
            "dialogues": [
                {
                    "id": "693140201",
                    "speaker": "砂糖",
                    "text": "秘境的尽头到底是什么？对于这个命题，我心中有许多假设。"
                },
                {
                    "id": "693140202",
                    "speaker": "砂糖",
                    "text": "但从遇到的怪物来看，探寻答案之路肯定不轻松。"
                },
                {
                    "id": "693140203",
                    "speaker": "砂糖",
                    "text": "不过，只要最终能得到答案，一切都是值得的。嗯…至少我是这么认为的。"
                }
            ]
        },
        {
            "talkId": "6931403",
            "initDialog": "693140301",
            "dialogues": [
                {
                    "id": "693140301",
                    "speaker": "砂糖",
                    "text": "我曾经在书中读到过关于「仙境」的故事。后来，又是书本启蒙了我研习炼金术。"
                },
                {
                    "id": "693140302",
                    "speaker": "砂糖",
                    "text": "在我床头柜的书架上，「仙境」的故事与炼金术教材互为邻居…"
                },
                {
                    "id": "693140303",
                    "speaker": "砂糖",
                    "text": "有朝一日，我想打通书页的隔阂，用「生物炼金」的技术创造「仙境」。"
                }
            ]
        }
    ]
}