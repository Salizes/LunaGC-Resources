{
    "groupId": "4176",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "鲁梅拉": 10
    },
    "talks": [
        {
            "talkId": "6417601",
            "initDialog": "641760101",
            "dialogues": [
                {
                    "id": "641760101",
                    "speaker": "鲁梅拉",
                    "text": "原来钓鱼就是我的拉希德。"
                }
            ]
        },
        {
            "talkId": "6417602",
            "initDialog": "641760201",
            "dialogues": [
                {
                    "id": "641760201",
                    "speaker": "Player",
                    "text": "我需要一些钓鱼用品。"
                },
                {
                    "id": "641760202",
                    "speaker": "鲁梅拉",
                    "text": "随便挑吧！价格都很便宜，放心，我赚钱的地方可不在这里，嘻嘻。"
                }
            ]
        },
        {
            "talkId": "6417603",
            "initDialog": "641760301",
            "dialogues": [
                {
                    "id": "641760301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "641760302",
                    "speaker": "鲁梅拉",
                    "text": "我是鲁梅拉·阿提夫·艾布·拉希德，须弥的渔师。"
                },
                {
                    "id": "641760303",
                    "speaker": "鲁梅拉",
                    "text": "别看我很擅长钓鱼，告诉你，我可是出生在沙漠的家伙哦。沙漠虽然有绿洲，但里面几乎没有鱼，我小时候都不知道鱼是什么东西。"
                },
                {
                    "id": "641760304",
                    "speaker": "鲁梅拉",
                    "text": "直到后面来了港里，才发现我居然这么擅长钓鱼，干这行，我一年能挣人家三年的钱呢！"
                },
                {
                    "id": "641760305",
                    "speaker": "鲁梅拉",
                    "text": "照这个速度，要不了多久，我就可以把爸爸妈妈接来一起生活了，哈哈，原来这就是我的拉希德。"
                }
            ]
        },
        {
            "talkId": "6417604",
            "initDialog": "641760401",
            "dialogues": [
                {
                    "id": "641760401",
                    "speaker": "Player",
                    "text": "拉希德是什么？"
                },
                {
                    "id": "641760402",
                    "speaker": "鲁梅拉",
                    "text": "拉希德？拉希德就是正确的指引，正确的指引就是拉希德！这是我家乡那边的含义，也是我的名字哦。"
                },
                {
                    "id": "641760403",
                    "speaker": "鲁梅拉",
                    "text": "我相信万物都有拉希德，比如我的就是钓鱼，鱼的就是被我钓。"
                },
                {
                    "id": "641760404",
                    "speaker": "鲁梅拉",
                    "text": "嘻嘻，你找到自己的拉希德了吗？"
                }
            ]
        },
        {
            "talkId": "6417605",
            "initDialog": "641760501",
            "dialogues": [
                {
                    "id": "641760501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641760502",
                    "speaker": "鲁梅拉",
                    "text": "再见，祝你早日找到自己的拉希德。"
                }
            ]
        }
    ]
}