{
    "groupId": "7009",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "库德拉托夫": 6
    },
    "talks": [
        {
            "talkId": "6700901",
            "initDialog": "670090101",
            "dialogues": [
                {
                    "id": "670090101",
                    "speaker": "库德拉托夫",
                    "text": "真倒霉啊，挪德卡莱的债务真是太难缠了…"
                }
            ]
        },
        {
            "talkId": "6700902",
            "initDialog": "670090201",
            "dialogues": [
                {
                    "id": "670090201",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "670090202",
                    "speaker": "库德拉托夫",
                    "text": "唉，你是不知道啊，朋友。这鬼地方的水深得很，表面上风平浪静，底下全是暗流。"
                },
                {
                    "id": "670090203",
                    "speaker": "库德拉托夫",
                    "text": "上次讨债惹到了灰河的黑帮，差点把命搭进去。上上次讨债，到最后发现罩着那家伙的其实是我的顶头上司…"
                },
                {
                    "id": "670090204",
                    "speaker": "库德拉托夫",
                    "text": "你说我一个没背景没靠山的年轻人，怎么就被派到这种地方来了呢？真要出了什么事，讨债的薪水说不定还不够我的医药费。"
                },
                {
                    "id": "670090205",
                    "speaker": "库德拉托夫",
                    "text": "唉，我现在就想早点回海屑镇养驯鹿，至少驯鹿不会突然变成愚人众的执行官把我痛骂一顿…大概吧。"
                }
            ]
        },
        {
            "talkId": "6700903",
            "initDialog": "670090301",
            "dialogues": [
                {
                    "id": "670090301",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "670090302",
                    "speaker": "库德拉托夫",
                    "text": "多谢，但愿吧。唉，你也多加小心呀。"
                }
            ]
        }
    ]
}