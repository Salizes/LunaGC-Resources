        },
        {
            "talkId": "6952802",
            "initDialog": "695280201",
            "dialogues": [
                {
                    "id": "695280201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6952803",
            "initDialog": "695280301",
            "dialogues": [
                {
                    "id": "695280301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695280302",
                    "speaker": "优菈",
                    "text": "你这就要走了？唔…我还能找谁测试牌组呢？…没什么。"
                }
