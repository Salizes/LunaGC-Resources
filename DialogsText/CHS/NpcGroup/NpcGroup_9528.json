        },
        {
            "talkId": "6952804",
            "initDialog": "695280401",
            "dialogues": [
                {
                    "id": "695280401",
                    "speaker": "优菈",
                    "text": "哈哈哈，是我赢了。不服的话，我也给你个复仇的机会…如何？"
                }
            ]
        },
        {
            "talkId": "6952805",
            "initDialog": "695280501",
            "dialogues": [
                {
                    "id": "695280501",
                    "speaker": "优菈",
                    "text": "行啊，赢得干净利落。有空的话…我们再来几局？"
                }
            ]
        },
        {
            "talkId": "6952806",
            "initDialog": "695280601",
            "dialogues": [
                {
                    "id": "695280601",
                    "speaker": "优菈",
                    "text": "想挑战我？行啊，我接受了。"
                }
            ]
        },
        {
            "talkId": "6952808",
            "initDialog": "695280801",
            "dialogues": [
                {
                    "id": "695280801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6952809",
            "initDialog": "695280901",
            "dialogues": [
                {
                    "id": "695280901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6952810",
            "initDialog": "695281001",
            "dialogues": [
                {
                    "id": "695281001",
                    "speaker": "优菈",
                    "text": "这一局…赢得马马虎虎吧。"
                }
            ]
        },
        {
            "talkId": "6952811",
            "initDialog": "695281101",
            "dialogues": [
                {
                    "id": "695281101",
                    "speaker": "优菈",
                    "text": "哼，这个仇我记下了。"
                }
            ]
        },
        {
            "talkId": "6952812",
            "initDialog": "695281201",
            "dialogues": [
                {
                    "id": "695281201",
                    "speaker": "优菈",
                    "text": "要是你输给我…哈哈哈，我也允许你记我的仇。"
                }
            ]
        },
        {
            "talkId": "6952814",
            "initDialog": "695281401",
            "dialogues": [
                {
                    "id": "695281401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
