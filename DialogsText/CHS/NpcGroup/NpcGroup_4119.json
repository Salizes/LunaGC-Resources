{
    "groupId": "4119",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "奇拉": 7
    },
    "talks": [
        {
            "talkId": "6411901",
            "initDialog": "641190101",
            "dialogues": [
                {
                    "id": "641190101",
                    "speaker": "奇拉",
                    "text": "按照教令院的指导，最近的海洋情况…"
                }
            ]
        },
        {
            "talkId": "6411902",
            "initDialog": "641190201",
            "dialogues": [
                {
                    "id": "641190201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641190202",
                    "speaker": "奇拉",
                    "text": "我是附近的渔民，除了捕鱼以外，还负责与教令院派遣的学者联络。"
                },
                {
                    "id": "641190203",
                    "speaker": "奇拉",
                    "text": "教令院会以征收部分渔获为条件，来帮助我们渔民运算海洋生物的出没规律，制定捕鱼期与休渔期的规划。"
                },
                {
                    "id": "641190204",
                    "speaker": "奇拉",
                    "text": "以小部分收获换取捕鱼数量和出海安全的双重保障，大家都觉得十分划算。"
                },
                {
                    "id": "641190205",
                    "speaker": "奇拉",
                    "text": "我还记得有次海上风平浪静，但路过的书记官却提出这种沉闷的平静十分反常，才避免了我们贸然出海遇到风暴。"
                },
                {
                    "id": "641190206",
                    "speaker": "奇拉",
                    "text": "从此大家对教令院的指导更加信服了，希望这样的合作能一直继续下去。"
                }
            ]
        },
        {
            "talkId": "6411903",
            "initDialog": "641190301",
            "dialogues": [
                {
                    "id": "641190301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641190302",
                    "speaker": "奇拉",
                    "text": "再见。只有读懂大海，才能收到回报啊。"
                }
            ]
        }
    ]
}