    "talks": [
        {
            "talkId": "6660901",
            "initDialog": "666090101",
            "dialogues": [
                {
                    "id": "666090101",
                    "speaker": "贾尤巴",
                    "text": "啊，上次坐这种小游船，还是尤娜怀着小夸米蒂的时候。真是令人怀念的时光。"
                },
                {
                    "id": "666090102",
                    "speaker": "贾尤巴",
                    "text": "如果尤娜也在的话，她应该也很愿意坐一坐吧。"
                },
                {
                    "id": "666090103",
                    "speaker": "贾尤巴",
                    "text": "可惜这个项目看起来还没准备好。"
                }
            ]
        },
        {
            "talkId": "6660902",
            "initDialog": "666090201",
            "dialogues": [
                {
                    "id": "666090201",
                    "speaker": "贾尤巴",
                    "text": "啊，船可以动了。"
                },
                {
                    "id": "666090202",
                    "speaker": "Player",
                    "text": "不上去试试吗？"
                },
                {
                    "id": "666090203",
                    "speaker": "贾尤巴",
                    "text": "哈哈，不用了。"
                },
                {
                    "id": "666090204",
                    "speaker": "贾尤巴",
                    "text": "我的脑袋里有一条紫色的小船，我每天都会去坐一坐呢。"
                }
            ]
        }
    ]
}