{
    "groupId": "4336",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "纳巴提": 12
    },
    "talks": [
        {
            "talkId": "6433601",
            "initDialog": "643360101",
            "dialogues": [
                {
                    "id": "643360101",
                    "speaker": "纳巴提",
                    "text": "民间信仰的研究课题…这东西有什么搞头吗？"
                }
            ]
        },
        {
            "talkId": "6433602",
            "initDialog": "643360201",
            "dialogues": [
                {
                    "id": "643360201",
                    "speaker": "Player",
                    "text": "什么课题？"
                },
                {
                    "id": "643360202",
                    "speaker": "纳巴提",
                    "text": "就是关于维摩庄附近存在的森之子信仰…"
                },
                {
                    "id": "643360203",
                    "speaker": "纳巴提",
                    "text": "根据我的推测，一定是因为这里盛产野菜，将野菜人格化…才有了所谓的森之子的说法。"
                },
                {
                    "id": "643360204",
                    "speaker": "纳巴提",
                    "text": "唉，玩笑归玩笑，这课题，远没有研究人体有趣…"
                }
            ]
        },
        {
            "talkId": "6433603",
            "initDialog": "643360301",
            "dialogues": [
                {
                    "id": "643360301",
                    "speaker": "Player",
                    "text": "我不知道啊。"
                },
                {
                    "id": "643360302",
                    "speaker": "纳巴提",
                    "text": "巧了，我也是。"
                }
            ]
        },
        {
            "talkId": "6433604",
            "initDialog": "643360401",
            "dialogues": [
                {
                    "id": "643360401",
                    "speaker": "Player",
                    "text": "研究人体…？"
                },
                {
                    "id": "643360402",
                    "speaker": "纳巴提",
                    "text": "不是，没有你想象的那么可怕，只不过是一些关于格斗术的延展课题。"
                },
                {
                    "id": "643360403",
                    "speaker": "纳巴提",
                    "text": "人要如何控制身体，才能爆发出那种难以想象的力量…大家对此难道不好奇吗？"
                },
                {
                    "id": "643360404",
                    "speaker": "纳巴提",
                    "text": "但这课题我都提了三四次了，没有一个导师愿意给我通过…"
                },
                {
                    "id": "643360405",
                    "speaker": "纳巴提",
                    "text": "我只能服从分配，去研究这么一个民间信仰相关的课题…"
                },
                {
                    "id": "643360406",
                    "speaker": "纳巴提",
                    "text": "我觉得这样下去不行，必须要有人让教令院知道，世界上有许多更值得关注的研究方向。"
                }
            ]
        },
        {
            "talkId": "7395401",
            "initDialog": "739540101",
            "dialogues": [
                {
                    "id": "739540101",
                    "speaker": "Player",
                    "text": "加油。"
                },
                {
                    "id": "739540102",
                    "speaker": "纳巴提",
                    "text": "谢谢你的鼓励，看到还有人认同我的想法，这让我又有了信心。"
                },
                {
                    "id": "739540103",
                    "speaker": "纳巴提",
                    "text": "做学者，就应该有直言不讳的勇气和决心！"
                }
            ]
        }
    ]
}