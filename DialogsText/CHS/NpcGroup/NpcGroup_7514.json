{
    "groupId": "7514",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "罗斯季斯拉夫": 10
    },
    "talks": [
        {
            "talkId": "6751401",
            "initDialog": "675140101",
            "dialogues": [
                {
                    "id": "675140101",
                    "speaker": "罗斯季斯拉夫",
                    "text": "哎呦，我得坐会…"
                }
            ]
        },
        {
            "talkId": "6751402",
            "initDialog": "675140201",
            "dialogues": [
                {
                    "id": "675140201",
                    "speaker": "Player",
                    "text": "需要我帮忙吗？"
                },
                {
                    "id": "675140202",
                    "speaker": "罗斯季斯拉夫",
                    "text": "哦，是个小年轻。走吧，我不需要帮忙，只是需要一个人安安静静地休息一下。"
                },
                {
                    "id": "675140203",
                    "speaker": "罗斯季斯拉夫",
                    "text": "这条路我太熟悉了，我天天走…过会我就会继续往上爬。"
                }
            ]
        },
        {
            "talkId": "6751403",
            "initDialog": "675140301",
            "dialogues": [
                {
                    "id": "675140301",
                    "speaker": "Player",
                    "text": "您看起来精神真好。"
                },
                {
                    "id": "675140302",
                    "speaker": "罗斯季斯拉夫",
                    "text": "啊哈，多谢夸奖，我只是比很多这个年纪的其他人，要更为健壮一点。"
                },
                {
                    "id": "675140303",
                    "speaker": "罗斯季斯拉夫",
                    "text": "这条路，很多年轻人走着都气喘吁吁，但是我一天要爬上五六遍，还不累，不知道你有没有看过「健康卫士」的版块——"
                },
                {
                    "id": "675140304",
                    "speaker": "罗斯季斯拉夫",
                    "text": "「40岁之后，每天多走1小时，寿命增加100分钟…」"
                },
                {
                    "id": "675140305",
                    "speaker": "罗斯季斯拉夫",
                    "text": "真是至理名言啊…年轻人，你要不要以后每天来和我一起走一走？"
                }
            ]
        },
        {
            "talkId": "6751404",
            "initDialog": "675140401",
            "dialogues": [
                {
                    "id": "675140401",
                    "speaker": "Player",
                    "text": "抱歉，打扰了。"
                },
                {
                    "id": "675140402",
                    "speaker": "罗斯季斯拉夫",
                    "text": "没事，我刚要坐下来休息呢…"
                }
            ]
        },
        {
            "talkId": "6751405",
            "initDialog": "675140501",
            "dialogues": [
                {
                    "id": "675140501",
                    "speaker": "Player",
                    "text": "我可能没有那么多时间…"
                },
                {
                    "id": "675140502",
                    "speaker": "罗斯季斯拉夫",
                    "text": "嗐，以后你们就明白了，有些时间可以省，有些时间可不能省…"
                }
            ]
        },
        {
            "talkId": "6751406",
            "initDialog": "675140601",
            "dialogues": [
                {
                    "id": "675140601",
                    "speaker": "Player",
                    "text": "我的每日运动量已足够。"
                },
                {
                    "id": "675140602",
                    "speaker": "罗斯季斯拉夫",
                    "text": "真遗憾，但容老头子我再啰嗦一句，走路真是最好的锻炼方式，还有，记得关注一下「健康卫士」版块…"
                }
            ]
        }
    ]
}