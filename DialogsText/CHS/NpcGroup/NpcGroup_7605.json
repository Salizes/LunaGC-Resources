{
    "groupId": "7605",
    "total_dialogue_lines": 35,
    "speaker_counts": {
        "Player": 9,
        "法尔伽": 5,
        "温弗里德": 1,
        "艾克贝特": 1,
        "莱夫赫姆": 19
    },
    "talks": [
        {
            "talkId": "6760501",
            "initDialog": "676050101",
            "dialogues": [
                {
                    "id": "676050101",
                    "speaker": "莱夫赫姆",
                    "text": "最强的战士，还得说是「团长级」的那两位…"
                }
            ]
        },
        {
            "talkId": "6760502",
            "initDialog": "676050201",
            "dialogues": [
                {
                    "id": "676050201",
                    "speaker": "Player",
                    "text": "最强的战士？"
                },
                {
                    "id": "676050202",
                    "speaker": "莱夫赫姆",
                    "text": "是荣誉骑士啊，我按照战力高低，把远征途中遇见过的强者们大致分成了五个等级。"
                },
                {
                    "id": "676050203",
                    "speaker": "莱夫赫姆",
                    "text": "从低到高依次是准队长级、队长级、超队长级、准团长级跟团长级。"
                }
            ]
        },
        {
            "talkId": "6760503",
            "initDialog": "676050301",
            "dialogues": [
                {
                    "id": "676050301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "676050302",
                    "speaker": "莱夫赫姆",
                    "text": "还得继续精进啊…"
                }
            ]
        },
        {
            "talkId": "6760504",
            "initDialog": "676050401",
            "dialogues": [
                {
                    "id": "676050401",
                    "speaker": "Player",
                    "text": "没有更高级的吗？"
                },
                {
                    "id": "676050402",
                    "speaker": "莱夫赫姆",
                    "text": "咳，再往上排的话就都是什么魔神啊古龙啊有着奇怪力量的家伙啊…之类的了！"
                },
                {
                    "id": "676050403",
                    "speaker": "莱夫赫姆",
                    "text": "做这个分类是为了给自己设立榜样跟目标，又不是要编啥战力榜，排这些进来有什么意义？"
                },
                {
                    "id": "676050404",
                    "speaker": "莱夫赫姆",
                    "text": "而且决定战斗胜负的要素有很多，敌我的优劣势跟战术的运用都很重要…只有不懂战斗的人，才会成天没事就乱排榜吧？"
                }
            ]
        },
        {
            "talkId": "6760505",
            "initDialog": "676050501",
            "dialogues": [
                {
                    "id": "676050501",
                    "speaker": "Player",
                    "text": "团长级的都有谁？"
                },
                {
                    "id": "676050502",
                    "speaker": "莱夫赫姆",
                    "text": "那我们的法尔伽大团长当然得算一个！至于别人嘛…"
                },
                {
                    "id": "676050503",
                    "speaker": "莱夫赫姆",
                    "text": "我们一路远征到挪德卡莱，也就只有愚人众执行官的第一席有过这个实力了。"
                },
                {
                    "id": "676050504",
                    "speaker": "莱夫赫姆",
                    "text": "但他的称号偏偏又是「队长」…每次讨论战力的时候都容易跟「队长级」混淆！唉！"
                }
            ]
        },
        {
            "talkId": "6760506",
            "initDialog": "676050601",
            "dialogues": [
                {
                    "id": "676050601",
                    "speaker": "Player",
                    "text": "那我是什么级？"
                },
                {
                    "id": "676050602",
                    "speaker": "莱夫赫姆",
                    "text": "欸！欸？欸…"
                },
                {
                    "id": "676050603",
                    "speaker": "莱夫赫姆",
                    "text": "这么一说我还真没考虑过…抱歉，可能是因为荣誉骑士平时给人的印象太不显山不露水了。"
                },
                {
                    "id": "676050604",
                    "speaker": "莱夫赫姆",
                    "text": "#要较起真来…感觉得单开一个「{NICKNAME}级」？"
                }
            ]
        },
        {
            "talkId": "6760507",
            "initDialog": "676050701",
            "dialogues": [
                {
                    "id": "676050701",
                    "speaker": "Player",
                    "text": "你、你说得对…"
                },
                {
                    "id": "676050702",
                    "speaker": "莱夫赫姆",
                    "text": "…但话又说回来，提瓦特这么大，听说也有以人类之身登上神座的战士。"
                },
                {
                    "id": "676050703",
                    "speaker": "莱夫赫姆",
                    "text": "可惜大团长去纳塔的时候没带上我…不然这「超团长级」的位置没准就有着落了…"
                }
            ]
        },
        {
            "talkId": "6760508",
            "initDialog": "676050801",
            "dialogues": [
                {
                    "id": "676050801",
                    "speaker": "Player",
                    "text": "可以当对敌参考。"
                },
                {
                    "id": "676050802",
                    "speaker": "莱夫赫姆",
                    "text": "嗯…你说的也有道理，改天我再排一个「假想敌榜」吧。"
                },
                {
                    "id": "676050803",
                    "speaker": "莱夫赫姆",
                    "text": "「北风王狼」跟「高塔孤王」应该怎么都算「强魔神级」…那「猎月人」就得有「超超强魔神级」了吧！"
                },
                {
                    "id": "676050804",
                    "speaker": "莱夫赫姆",
                    "text": "哦，顺便一提，这一带好像有不少「狼」活动过的痕迹。听说荣誉骑士也是赫赫有名的冒险家，我猜你应该挺感兴趣？"
                }
            ]
        },
        {
            "talkId": "7667715",
            "initDialog": "766771501",
            "dialogues": [
                {
                    "id": "766771501",
                    "speaker": "法尔伽",
                    "text": "向左转…向右转！",
                    "choices": [
                        {
                            "id": "766772301",
                            "text": "他们还没醒酒吗？",
                            "response": [
                                {
                                    "id": "766772401",
                                    "speaker": "法尔伽",
                                    "text": "…荣誉骑士，能请你来整肃他们吗？只要<color=#00E1FFFF>一边喊口号，一边找出里面犯错最多的人</color>就行。"
                                }
                            ]
                        },
                        {
                            "id": "766772201",
                            "text": "法尔伽，你们这是在？",
                            "response": [
                                {
                                    "id": "766772202",
                                    "speaker": "法尔伽",
                                    "text": "哦，这是骑士团里的队列训练。他们三个昨晚有点喝高了，我在给他们醒酒。"
                                },
                                {
                                    "id": "766772203",
                                    "speaker": "法尔伽",
                                    "text": "…顺便找出醉得最厉害的，罚跑二十圈。虽然远征军没有禁酒，但什么时候喝、每次喝多少也都是有规矩的。"
                                },
                                {
                                    "id": "766772204",
                                    "speaker": "温弗里德",
                                    "text": "我…我只喝了一点点！"
                                },
                                {
                                    "id": "766772205",
                                    "speaker": "艾克贝特",
                                    "text": "我…我也是！"
                                },
                                {
                                    "id": "766772206",
                                    "speaker": "法尔伽",
                                    "text": "…与其用言语，不如用行动来证明吧！ 给我拿出就算喝醉了也能完美应付的气势来！"
                                },
                                {
                                    "id": "766772207",
                                    "speaker": "莱夫赫姆",
                                    "text": "是…是！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}