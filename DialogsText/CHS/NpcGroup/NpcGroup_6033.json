{
    "groupId": "6033",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "巴亚吉达": 8
    },
    "talks": [
        {
            "talkId": "6603301",
            "initDialog": "660330101",
            "dialogues": [
                {
                    "id": "660330101",
                    "speaker": "巴亚吉达",
                    "text": "你好，需要帮助吗？"
                }
            ]
        },
        {
            "talkId": "6603302",
            "initDialog": "660330201",
            "dialogues": [
                {
                    "id": "660330201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "660330202",
                    "speaker": "巴亚吉达",
                    "text": "我是圣火竞技场的志愿者，负责在比赛期间维护场地秩序、接引选手之类的工作。"
                },
                {
                    "id": "660330203",
                    "speaker": "巴亚吉达",
                    "text": "没比赛的时候我也会在周围转转，看看有没有需要帮助的人。"
                },
                {
                    "id": "660330204",
                    "speaker": "巴亚吉达",
                    "text": "反正我最近很清闲，有什么需要帮忙的就说啊！"
                },
                {
                    "id": "660330205",
                    "speaker": "巴亚吉达",
                    "text": "哦对了，想要加入志愿者队伍的话也可以找我，一句话的事！"
                }
            ]
        },
        {
            "talkId": "6603303",
            "initDialog": "660330301",
            "dialogues": [
                {
                    "id": "660330301",
                    "speaker": "Player",
                    "text": "没什么需要的。"
                },
                {
                    "id": "660330302",
                    "speaker": "巴亚吉达",
                    "text": "那就好。"
                }
            ]
        },
        {
            "talkId": "7591701",
            "initDialog": "759170101",
            "dialogues": [
                {
                    "id": "759170101",
                    "speaker": "Player",
                    "text": "好，等我有空就来。"
                },
                {
                    "id": "759170102",
                    "speaker": "巴亚吉达",
                    "text": "那就多谢啦！"
                },
                {
                    "id": "759170103",
                    "speaker": "巴亚吉达",
                    "text": "从志愿者的视角享受精彩的竞技，也是一种很不错的体验呢。"
                }
            ]
        }
    ]
}