{
    "groupId": "6421",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "哈尔乔": 12
    },
    "talks": [
        {
            "talkId": "6642101",
            "initDialog": "664210101",
            "dialogues": [
                {
                    "id": "664210101",
                    "speaker": "哈尔乔",
                    "text": "你好，朋友！今天锻炼身体了吗？"
                }
            ]
        },
        {
            "talkId": "6642102",
            "initDialog": "664210201",
            "dialogues": [
                {
                    "id": "664210201",
                    "speaker": "Player",
                    "text": "托您的福，身体健康。"
                },
                {
                    "id": "664210202",
                    "speaker": "哈尔乔",
                    "text": "吼吼，很自信啊。那你能打过枫丹这的「机关人」吗？"
                },
                {
                    "id": "664210203",
                    "speaker": "哈尔乔",
                    "text": "之前听来纳塔旅游的枫丹人说，这个国家有能打架的机器人，我还将信将疑呢。"
                },
                {
                    "id": "664210204",
                    "speaker": "哈尔乔",
                    "text": "不过比起怀疑，更多的还是兴奋吧。我当时就有种预感，总有一天，我要亲自来枫丹和它们比试比试。"
                },
                {
                    "id": "664210205",
                    "speaker": "哈尔乔",
                    "text": "这不，时机总算到了！"
                },
                {
                    "id": "664210206",
                    "speaker": "哈尔乔",
                    "text": "听说最厉害的警卫机关都在一个叫「梅洛彼得堡」的地方。嗯，得想个办法去看看。"
                }
            ]
        },
        {
            "talkId": "6642103",
            "initDialog": "664210301",
            "dialogues": [
                {
                    "id": "664210301",
                    "speaker": "Player",
                    "text": "我会的。"
                },
                {
                    "id": "664210302",
                    "speaker": "哈尔乔",
                    "text": "加油！"
                }
            ]
        },
        {
            "talkId": "6642104",
            "initDialog": "664210401",
            "dialogues": [
                {
                    "id": "664210401",
                    "speaker": "Player",
                    "text": "请不要犯罪。"
                },
                {
                    "id": "664210402",
                    "speaker": "哈尔乔",
                    "text": "啊哈哈，这个当然，当然！不过为什么突然说起这个？"
                },
                {
                    "id": "664210403",
                    "speaker": "哈尔乔",
                    "text": "…啊？什么，那里其实是罪人流放处吗？那不就是监狱！"
                },
                {
                    "id": "664210404",
                    "speaker": "哈尔乔",
                    "text": "哦…怪不得告诉我这件事的复律官表情十分严肃…"
                },
                {
                    "id": "664210405",
                    "speaker": "哈尔乔",
                    "text": "我明白，请放心吧。我虽然看起来很随便，但在荣誉一事上是不会马虎的。"
                },
                {
                    "id": "664210406",
                    "speaker": "哈尔乔",
                    "text": "纷争的战场也有高尚与卑劣之分，通过不正当的理由引起争斗，可是要被火烧屁股的。"
                }
            ]
        }
    ]
}