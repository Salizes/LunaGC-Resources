{
    "groupId": "9132",
    "total_dialogue_lines": 81,
    "speaker_counts": {
        "Player": 22,
        "布伦妮": 59
    },
    "talks": [
        {
            "talkId": "6913201",
            "initDialog": "691320101",
            "dialogues": [
                {
                    "id": "691320101",
                    "speaker": "布伦妮",
                    "text": "这就是传说中的尘歌壶？没想到里面是这样的构造…"
                },
                {
                    "id": "691320102",
                    "speaker": "布伦妮",
                    "text": "不止尘歌壶，我还听说过很多其他奇妙的法宝和机关，哼哼。"
                }
            ]
        },
        {
            "talkId": "6913202",
            "initDialog": "691320201",
            "dialogues": [
                {
                    "id": "691320201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691320202",
                    "speaker": "布伦妮",
                    "text": "不用担心，我又不是小孩子了，不会因为认床睡不着的。"
                },
                {
                    "id": "691320203",
                    "speaker": "布伦妮",
                    "text": "即便是跟着商队在路上居无定所的日子里，我也没有过水土不服的状况哦。"
                },
                {
                    "id": "691320204",
                    "speaker": "Player",
                    "text": "话说，布伦妮住在蒙德哪里？"
                },
                {
                    "id": "691320205",
                    "speaker": "布伦妮",
                    "text": "我住在蒙德的远房亲戚家里，虽说是亲戚，其实是爷爷的表妹的儿子的…"
                },
                {
                    "id": "691320206",
                    "speaker": "布伦妮",
                    "text": "算了，关系太复杂了。总之就是那种「年纪比我大但按辈分应该叫我一声小姑」的关系。"
                },
                {
                    "id": "691320207",
                    "speaker": "布伦妮",
                    "text": "就因为爸妈在信里专门委托了她要「看紧点」，每天还有门禁时间…这对吗？哪有给小姑设置门禁的道理。"
                },
                {
                    "id": "691320208",
                    "speaker": "Player",
                    "text": "那在我这里玩没关系吗？"
                },
                {
                    "id": "691320209",
                    "speaker": "布伦妮",
                    "text": "哦，完全没问题，我报备过了。"
                },
                {
                    "id": "691320210",
                    "speaker": "布伦妮",
                    "text": "顺便一问，在这里有什么规矩吗？门禁啊，不能去的区域啊，不能动的家具啊…"
                },
                {
                    "id": "691320211",
                    "speaker": "Player",
                    "text": "没有，那是大人才喜欢定的东西。"
                },
                {
                    "id": "691320212",
                    "speaker": "布伦妮",
                    "text": "这么好？！"
                },
                {
                    "id": "691320213",
                    "speaker": "布伦妮",
                    "text": "我是说，这么好的度假胜地，大家对你家的评价一定很高。"
                },
                {
                    "id": "691320214",
                    "speaker": "布伦妮",
                    "text": "我也一样！"
                }
            ]
        },
        {
            "talkId": "6913203",
            "initDialog": "691320301",
            "dialogues": [
                {
                    "id": "691320301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691320302",
                    "speaker": "布伦妮",
                    "text": "既然你提到了，我们就来聊聊那个「终极反派」——艾莉丝吧。"
                },
                {
                    "id": "691320303",
                    "speaker": "Player",
                    "text": "你们俩都是我的朋友…"
                },
                {
                    "id": "691320304",
                    "speaker": "布伦妮",
                    "text": "别误会，不是要你现在就站队。魔女蛊惑人心的花样非常多，就算暂时被蒙蔽了也是可以被理解的。"
                },
                {
                    "id": "691320305",
                    "speaker": "布伦妮",
                    "text": "我相信你的眼睛是雪亮的，谁对谁错你迟早会明辨！"
                },
                {
                    "id": "691320306",
                    "speaker": "布伦妮",
                    "text": "只是我最近在反思，为什么每一次明面上是我「战胜」了她，结果却总是变成「按照她的剧本演完了下一幕」？"
                },
                {
                    "id": "691320307",
                    "speaker": "布伦妮",
                    "text": "好不甘心！我需要一个熟悉魔女的人帮我复盘！"
                },
                {
                    "id": "691320308",
                    "speaker": "布伦妮",
                    "text": "你说艾莉丝的「算盘」里到底有什么逻辑？"
                },
                {
                    "id": "691320309",
                    "speaker": "布伦妮",
                    "text": "你这么聪明，能帮我想想怎么才能扳回一城吗？让她也尝尝「失算」的滋味！"
                },
                {
                    "id": "691320310",
                    "speaker": "Player",
                    "text": "有没有可能，她根本不讲逻辑…"
                },
                {
                    "id": "691320311",
                    "speaker": "布伦妮",
                    "text": "……！"
                },
                {
                    "id": "691320312",
                    "speaker": "布伦妮",
                    "text": "你说得对。那个邪恶巫婆，做事总是随心所欲，借着什么「有趣」的名义肆意妄为…"
                },
                {
                    "id": "691320313",
                    "speaker": "布伦妮",
                    "text": "那我该怎么对付她？",
                    "choices": [
                        {
                            "id": "691320314",
                            "text": "那就当个撒泼打滚的小孩…",
                            "response": [
                                {
                                    "id": "691320316",
                                    "speaker": "布伦妮",
                                    "text": "谁会故意干那种又吵又闹，还会被人讨厌的事情啊！"
                                },
                                {
                                    "id": "691320317",
                                    "speaker": "布伦妮",
                                    "text": "等等…你不对劲。我有理由怀疑你是魔女假扮的。"
                                },
                                {
                                    "id": "691320318",
                                    "speaker": "布伦妮",
                                    "text": "难道你是…让我看看你的真面目——",
                                    "choices": [
                                        {
                                            "id": "691320319",
                                            "text": "其实是想让你不要想太多…",
                                            "response": [
                                                {
                                                    "id": "691320321",
                                                    "speaker": "布伦妮",
                                                    "text": "唔…突然这么说，也不可能马上就做得到吧…"
                                                },
                                                {
                                                    "id": "691320322",
                                                    "speaker": "布伦妮",
                                                    "text": "至少得从可莉她们身上稍微学一学…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691320320",
                                            "text": "你也可以像孩子般随心所欲。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691320315",
                            "text": "用「魔法」打败「魔法」！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6913204",
            "initDialog": "691320401",
            "dialogues": [
                {
                    "id": "691320401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691320402",
                    "speaker": "布伦妮",
                    "text": "问得好，我决定采取你的建议，做一个实验。"
                },
                {
                    "id": "691320403",
                    "speaker": "布伦妮",
                    "text": "只是实验哦！试、试着当一天无忧无虑的普通的小孩…"
                },
                {
                    "id": "691320404",
                    "speaker": "布伦妮",
                    "text": "就一天！"
                },
                {
                    "id": "691320405",
                    "speaker": "Player",
                    "text": "一天也可以哦。"
                },
                {
                    "id": "691320406",
                    "speaker": "布伦妮",
                    "text": "所以我昨晚提前做了「热身」。"
                },
                {
                    "id": "691320407",
                    "speaker": "布伦妮",
                    "text": "把书合上，把文具收起来，还不断提醒自己——今天不需要得出任何结论。"
                },
                {
                    "id": "691320408",
                    "speaker": "Player",
                    "text": "然后呢？"
                },
                {
                    "id": "691320409",
                    "speaker": "布伦妮",
                    "text": "从睡觉前我就开始想：普通小孩现在应该在做什么？听故事？画画？喝睡前牛奶？该不会已经睡着了吧！"
                },
                {
                    "id": "691320410",
                    "speaker": "布伦妮",
                    "text": "想了很久，我都忘了怎么睡着的了，还差点错过自然醒的最佳时间。"
                },
                {
                    "id": "691320411",
                    "speaker": "Player",
                    "text": "你还是有点想太多了！"
                },
                {
                    "id": "691320412",
                    "speaker": "布伦妮",
                    "text": "唔…我也察觉到了。所以今天我决定执行「小孩要做的事情清单」。"
                },
                {
                    "id": "691320413",
                    "speaker": "Player",
                    "text": "这又是什么东西？"
                },
                {
                    "id": "691320414",
                    "speaker": "布伦妮",
                    "text": "第一项，睡醒先在床上打滚和翻身。然后被催起床，由于没有人催我，所以我装模作样地对着空气说了几句话。"
                },
                {
                    "id": "691320415",
                    "speaker": "布伦妮",
                    "text": "勉勉强强，算完成吧。"
                },
                {
                    "id": "691320416",
                    "speaker": "布伦妮",
                    "text": "第二项，挑食。我认真考虑过，但还是全吃了。"
                },
                {
                    "id": "691320417",
                    "speaker": "布伦妮",
                    "text": "所以在备注里写了失败。"
                },
                {
                    "id": "691320418",
                    "speaker": "布伦妮",
                    "text": "第三项是毫无节制地吃零食，这个最简单，我最喜欢这个任务。"
                },
                {
                    "id": "691320419",
                    "speaker": "布伦妮",
                    "text": "…吃到一半我突然意识到，这项任务根本不合理！"
                },
                {
                    "id": "691320420",
                    "speaker": "布伦妮",
                    "text": "除了做梦，小孩子哪会有机会无节制吃零食啊？肯定会被大人阻止吧。"
                },
                {
                    "id": "691320421",
                    "speaker": "布伦妮",
                    "text": "第四项就更难了，玩没有实际意义的游戏。"
                },
                {
                    "id": "691320422",
                    "speaker": "布伦妮",
                    "text": "结果我的注意力，全跑去找游戏规则的漏洞了…"
                },
                {
                    "id": "691320423",
                    "speaker": "Player",
                    "text": "听上去很不顺利…"
                },
                {
                    "id": "691320424",
                    "speaker": "布伦妮",
                    "text": "对。所以现在我要开始闹情绪了！"
                },
                {
                    "id": "691320425",
                    "speaker": "布伦妮",
                    "text": "我要把清单收起来，然后宣布实验大失败！虽然失败了，但是我一点都不想管！"
                },
                {
                    "id": "691320426",
                    "speaker": "布伦妮",
                    "text": "不想找原因，不想听道理，就这样！"
                },
                {
                    "id": "691320427",
                    "speaker": "Player",
                    "text": "「闹情绪」也是清单里的一项吧？"
                },
                {
                    "id": "691320428",
                    "speaker": "布伦妮",
                    "text": "欸…你怎么知道的？！",
                    "choices": [
                        {
                            "id": "691320429",
                            "text": "因为不讲道理就是小孩子的特权。",
                            "response": [
                                {
                                    "id": "691320431",
                                    "speaker": "布伦妮",
                                    "text": "哼。"
                                }
                            ]
                        },
                        {
                            "id": "691320430",
                            "text": "你已经抓到精髓喽。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6913205",
            "initDialog": "691320501",
            "dialogues": [
                {
                    "id": "691320501",
                    "speaker": "Player",
                    "text": "早啊，布伦妮。"
                },
                {
                    "id": "691320502",
                    "speaker": "布伦妮",
                    "text": "早上好。今天要出门吗？"
                },
                {
                    "id": "691320503",
                    "speaker": "布伦妮",
                    "text": "我的建议是，先把最难办的事情办了，否则拖到晚上，就不想做了…"
                }
            ]
        },
        {
            "talkId": "6913206",
            "initDialog": "691320601",
            "dialogues": [
                {
                    "id": "691320601",
                    "speaker": "Player",
                    "text": "晚安，布伦妮。"
                },
                {
                    "id": "691320602",
                    "speaker": "布伦妮",
                    "text": "已经这个点了吗。再清醒的人也需要睡觉。晚安。"
                },
                {
                    "id": "691320603",
                    "speaker": "布伦妮",
                    "text": "你也早点睡吧，大人们最喜欢在晚上胡思乱想了。"
                }
            ]
        },
        {
            "talkId": "6913210",
            "initDialog": "691321001",
            "dialogues": [
                {
                    "id": "691321001",
                    "speaker": "布伦妮",
                    "text": "嗯…这个布局，很专业。"
                },
                {
                    "id": "691321002",
                    "speaker": "布伦妮",
                    "text": "桌面够大，能同时摊开三本书。书架的高度…"
                },
                {
                    "id": "691321003",
                    "speaker": "布伦妮",
                    "text": "没事，有凳子，我够得着。"
                }
            ]
        },
        {
            "talkId": "6913211",
            "initDialog": "691321101",
            "dialogues": [
                {
                    "id": "691321101",
                    "speaker": "布伦妮",
                    "text": "在那夏镇的时候，我喜欢找个角落待着，一边看书一边观察来来往往的人。"
                },
                {
                    "id": "691321102",
                    "speaker": "布伦妮",
                    "text": "我发现，书上写的规则不会变，但人会随时随地违反规则。"
                },
                {
                    "id": "691321103",
                    "speaker": "布伦妮",
                    "text": "你布置得很还原，让我想起了不少奇人轶事。有空吗？我可以慢慢讲给你听。"
                }
            ]
        }
    ]
}