{
    "groupId": "1845",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "乌苏拉": 1,
        "君特": 1,
        "洛恩": 6
    },
    "talks": [
        {
            "talkId": "6180105",
            "initDialog": "618010501",
            "dialogues": [
                {
                    "id": "618010501",
                    "speaker": "洛恩",
                    "text": "哟，你好啊，荣誉骑士。"
                },
                {
                    "id": "618010502",
                    "speaker": "Player",
                    "text": "你这是在…"
                },
                {
                    "id": "618010503",
                    "speaker": "洛恩",
                    "text": "如你所见——射击训练。我好歹也是远程小队的副队长。"
                },
                {
                    "id": "618010504",
                    "speaker": "洛恩",
                    "text": "虽然我自己最喜欢的还是冲到敌人跟前去干一架…不过远程小队的看家本事还是不能落下。"
                },
                {
                    "id": "618010505",
                    "speaker": "Player",
                    "text": "那你举着个苹果是在…？"
                },
                {
                    "id": "618010506",
                    "speaker": "洛恩",
                    "text": "哦，要训练的不是我，是他俩——喂！还没瞄准好吗！"
                },
                {
                    "id": "618010507",
                    "speaker": "乌苏拉",
                    "text": "唔…手…手在发抖！"
                },
                {
                    "id": "618010508",
                    "speaker": "君特",
                    "text": "呃…眼…眼在打颤！",
                    "choices": [
                        {
                            "id": "618010509",
                            "text": "合着你是在当靶子啊！",
                            "response": [
                                {
                                    "id": "618010511",
                                    "speaker": "洛恩",
                                    "text": "哈，有压力才有动力嘛。再说，他们的弹药也伤不了我。"
                                },
                                {
                                    "id": "618010512",
                                    "speaker": "Player",
                                    "text": "那他们为什么这么害怕？"
                                },
                                {
                                    "id": "618010513",
                                    "speaker": "洛恩",
                                    "text": "因为要是真射偏了…后面就得接受我的「特别训练」了，呵呵。"
                                }
                            ]
                        },
                        {
                            "id": "618010510",
                            "text": "这要是射偏了怎么办！"
                        }
                    ]
                }
            ]
        }
    ]
}