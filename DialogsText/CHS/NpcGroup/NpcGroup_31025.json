{
    "groupId": "31025",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 5,
        "「减七琶音」": 20
    },
    "talks": [
        {
            "talkId": "7651112",
            "initDialog": "765111201",
            "dialogues": [
                {
                    "id": "765111201",
                    "speaker": "「减七琶音」",
                    "text": "#想吃蛋糕吗，{NICKNAME}大人？",
                    "choices": [
                        {
                            "id": "765111202",
                            "text": "大…大人？",
                            "response": [
                                {
                                    "id": "765111203",
                                    "speaker": "「减七琶音」",
                                    "text": "您是「仆人」大人的朋友，我上司所尊敬的强者，我自然需要对您致以最高的尊重。"
                                },
                                {
                                    "id": "765111204",
                                    "speaker": "Player",
                                    "text": "那你怎么从枫丹跑过来了？"
                                },
                                {
                                    "id": "765111205",
                                    "speaker": "「减七琶音」",
                                    "text": "请别在意，是正常的人事调动。"
                                },
                                {
                                    "id": "765111206",
                                    "speaker": "「减七琶音」",
                                    "text": "之前的变故中，「木偶」大人的部队遭受了一定的损失，短时间内难以恢复战力…"
                                },
                                {
                                    "id": "765111207",
                                    "speaker": "「减七琶音」",
                                    "text": "除去本土的支援，「仆人」大人也向挪德卡莱派遣了多支连队，以增强试验设计局等区域的防御。"
                                },
                                {
                                    "id": "765111208",
                                    "speaker": "「减七琶音」",
                                    "text": "如今，挪德卡莱的状况已然稳定，连队也准备撤回原位了。我也因此放了长假，有幸参与这场赛事，开开眼界。"
                                }
                            ]
                        },
                        {
                            "id": "765111209",
                            "text": "有饭不吃没道理，当然要吃。",
                            "response": [
                                {
                                    "id": "765111210",
                                    "speaker": "「减七琶音」",
                                    "text": "啊，才发现都吃完了…实在抱歉。"
                                },
                                {
                                    "id": "765111211",
                                    "speaker": "「减七琶音」",
                                    "text": "之后我会多准备一些枫丹甜点，以便哪天意外再见您时，留着足量的礼物。"
                                }
                            ]
                        },
                        {
                            "id": "765111212",
                            "text": "愚人众役人不是这样的！",
                            "response": [
                                {
                                    "id": "765111213",
                                    "speaker": "「减七琶音」",
                                    "text": "我应该说着「恭候多时了」，上来就给您一剑吗？"
                                },
                                {
                                    "id": "765111214",
                                    "speaker": "「减七琶音」",
                                    "text": "如果你想，也不是不行。"
                                },
                                {
                                    "id": "765111215",
                                    "speaker": "「减七琶音」",
                                    "text": "但，如果我在那夏镇的地界向您动武，「仆人」大人知道了，会惩罚我的。"
                                },
                                {
                                    "id": "765111216",
                                    "speaker": "「减七琶音」",
                                    "text": "而且我也不是那么不自量力的类型，要是没有规则约束，我怎么配和您较量呢？"
                                },
                                {
                                    "id": "765111217",
                                    "speaker": "「减七琶音」",
                                    "text": "据我学生们的评价来看，我两三下就会被您打倒，还是不要主动献丑啦。"
                                }
                            ]
                        },
                        {
                            "id": "765111218",
                            "text": "下次再说。",
                            "response": [
                                {
                                    "id": "765111219",
                                    "speaker": "「减七琶音」",
                                    "text": "我随时恭候。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7651113",
            "initDialog": "765111301",
            "dialogues": [
                {
                    "id": "765111301",
                    "speaker": "「减七琶音」",
                    "text": "#多谢招待，{NICKNAME}大人。"
                },
                {
                    "id": "765111302",
                    "speaker": "「减七琶音」",
                    "text": "我真想说，「如果您也加入愚人众，应当扮演教官们的教官」。"
                },
                {
                    "id": "765111303",
                    "speaker": "「减七琶音」",
                    "text": "可惜，您是世界级的强者，应该没有任何组织能长久留住你吧。"
                }
            ]
        },
        {
            "talkId": "7651205",
            "initDialog": "765120501",
            "dialogues": [
                {
                    "id": "765120501",
                    "speaker": "「减七琶音」",
                    "text": "哎呀，比赛结果让大家都很满意，我也要回去继续上班了。"
                },
                {
                    "id": "765120502",
                    "speaker": "「减七琶音」",
                    "text": "世事无常，谁也说不准将来会发生的事…或许哪天，您有了自己的队伍，我也被愚人众解雇了…就来投奔您？"
                },
                {
                    "id": "765120503",
                    "speaker": "「减七琶音」",
                    "text": "到时候，还请别嫌弃我太弱。"
                }
            ]
        }
    ]
}