{
    "groupId": "3144",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "小山": 15
    },
    "talks": [
        {
            "talkId": "6314401",
            "initDialog": "631440101",
            "dialogues": [
                {
                    "id": "631440101",
                    "speaker": "小山",
                    "text": "那边的桥看起来好高啊，真的没问题吗…"
                }
            ]
        },
        {
            "talkId": "6314402",
            "initDialog": "631440201",
            "dialogues": [
                {
                    "id": "631440201",
                    "speaker": "Player",
                    "text": "你没事吧？"
                },
                {
                    "id": "631440202",
                    "speaker": "小山",
                    "text": "我吗？呃，现在…现在还好啦，毕竟还没有走上那座桥，哈哈。"
                },
                {
                    "id": "631440203",
                    "speaker": "小山",
                    "text": "果然还是平稳的土地令人安心…"
                }
            ]
        },
        {
            "talkId": "6314403",
            "initDialog": "631440301",
            "dialogues": [
                {
                    "id": "631440301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631440302",
                    "speaker": "小山",
                    "text": "再见，那边的路可高了，你要小心啊…"
                }
            ]
        },
        {
            "talkId": "6314404",
            "initDialog": "631440401",
            "dialogues": [
                {
                    "id": "631440401",
                    "speaker": "Player",
                    "text": "你莫不是怕高？"
                },
                {
                    "id": "631440402",
                    "speaker": "小山",
                    "text": "哎呀，被你发现啦，哈哈…"
                },
                {
                    "id": "631440403",
                    "speaker": "小山",
                    "text": "我是珊瑚宫军的士兵，以前都是做些普通的巡逻或者跟班工作，一直很顺利。"
                },
                {
                    "id": "631440404",
                    "speaker": "小山",
                    "text": "结果因为外派驻扎的军士变多了，我转被安排过来守那条通往珊瑚宫的路。"
                },
                {
                    "id": "631440405",
                    "speaker": "小山",
                    "text": "我不好意思说自己怕高，只好硬着头皮接下来，本来以为自己能顶住的…"
                },
                {
                    "id": "631440406",
                    "speaker": "小山",
                    "text": "但实际过来一看，天哪，这也太高了，我连踏近一步都不敢，还谈何看守啊！"
                },
                {
                    "id": "631440407",
                    "speaker": "小山",
                    "text": "要是工作都像以前那样简单，随便跟在外人身后盯盯梢啥的就好了…"
                }
            ]
        },
        {
            "talkId": "6314405",
            "initDialog": "631440501",
            "dialogues": [
                {
                    "id": "631440501",
                    "speaker": "Player",
                    "text": "盯梢？"
                },
                {
                    "id": "631440502",
                    "speaker": "小山",
                    "text": "哦，这个啊，是以前的事情了。"
                },
                {
                    "id": "631440503",
                    "speaker": "小山",
                    "text": "之前曾经有天领奉行的人来过这里，不去找珊瑚宫大人或是五郎大将谈正事，却只是在岛上闲逛。"
                },
                {
                    "id": "631440504",
                    "speaker": "小山",
                    "text": "珊瑚宫大人摸不透他的底细，就派了几个人跟着他，怕他做出什么对我们不利的事情。"
                },
                {
                    "id": "631440505",
                    "speaker": "小山",
                    "text": "结果发现，那位穿着天领奉行制服的小哥并没有打探的意思，倒像是来这边郊游的。"
                },
                {
                    "id": "631440506",
                    "speaker": "小山",
                    "text": "我记得他还自称是什么侦探…难道侦探都是像他那样的怪人吗？"
                }
            ]
        }
    ]
}