        {
            "talkId": "6654701",
            "initDialog": "665470101",
            "dialogues": [
                {
                    "id": "665470101",
                    "speaker": "提可菈",
                    "text": "#欸，是您啊，{M#救星先生}{F#救星小姐}！"
                }
            ]
        },
        {
            "talkId": "6654702",
            "initDialog": "665470201",
            "dialogues": [
                {
                    "id": "665470201",
                    "speaker": "Player",
                    "text": "你好，「飘飘巡风阿夏小姐」。"
                },
                {
                    "id": "665470202",
                    "speaker": "提可菈",
                    "text": "哈哈，您就别打趣我了，是有什么需要吗？还是对我们的「飘飘巡风阿夏」念念不忘啦？"
                },
                {
                    "id": "665470203",
                    "speaker": "提可菈",
                    "text": "如果您想的话，不论是观赏美景，还是进行一次「再创作」，我都可以带您乘热气球上去哦。"
                }
            ]
        },
        {
            "talkId": "6654703",
            "initDialog": "665470301",
            "dialogues": [
                {
                    "id": "665470301",
                    "speaker": "Player",
                    "text": "那就麻烦你了。"
                },
                {
                    "id": "665470302",
                    "speaker": "提可菈",
                    "text": "没问题，我带您上去。"
                }
            ]
        },
        {
            "talkId": "6654704",
            "initDialog": "665470401",
            "dialogues": [
                {
                    "id": "665470401",
                    "speaker": "Player",
                    "text": "算了吧，谢谢。"
                },
                {
                    "id": "665470402",
                    "speaker": "提可菈",
                    "text": "随时欢迎您再来！"
                }
            ]
        }
    ]
}