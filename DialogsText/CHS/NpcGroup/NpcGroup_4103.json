    "talks": [
        {
            "talkId": "6410301",
            "initDialog": "641030101",
            "dialogues": [
                {
                    "id": "641030101",
                    "speaker": "尼姆",
                    "text": "那那罗，那那罗，什么时候再来看我~！"
                }
            ]
        },
        {
            "talkId": "6410302",
            "initDialog": "641030201",
            "dialogues": [
                {
                    "id": "641030201",
                    "speaker": "Player",
                    "text": "你在唱什么？"
                },
                {
                    "id": "641030202",
                    "speaker": "尼姆",
                    "text": "是我自己编的歌曲哦！"
                },
                {
                    "id": "641030203",
                    "speaker": "尼姆",
                    "text": "如果那那罗能听到我唱的歌，也许就会再来看我啦。"
                }
            ]
        },
        {
            "talkId": "6410303",
            "initDialog": "641030301",
            "dialogues": [
                {
                    "id": "641030301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641030302",
                    "speaker": "尼姆",
                    "text": "那那罗，那那罗，什么时候再见到你~！"
                }
            ]
        },
        {
            "talkId": "6410304",
            "initDialog": "641030401",
            "dialogues": [
                {
                    "id": "641030401",
                    "speaker": "Player",
                    "text": "「那那罗」是…"
                },
                {
                    "id": "641030402",
                    "speaker": "尼姆",
                    "text": "是小小的、圆圆的朋友。"
                },
                {
                    "id": "641030403",
                    "speaker": "尼姆",
                    "text": "那那罗会趁着大人们不在的时候在附近偷偷出现，就像偷懒不做农活的我一样。"
                },
                {
                    "id": "641030404",
                    "speaker": "尼姆",
                    "text": "虽然弥诺总是笑话我，说我是长不大的小屁孩，竟然相信那那罗的故事，还因为我叫错了名字跟我生气。"
                },
                {
                    "id": "641030405",
                    "speaker": "尼姆",
                    "text": "但是…但是我亲眼见过那那罗啊，就是那些小草人嘛，所以那那罗一定是真实存在的。"
                }
            ]
        }
    ]
}