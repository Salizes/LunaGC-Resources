{
    "groupId": "1539",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "艾伦": 16
    },
    "talks": [
        {
            "talkId": "4111532",
            "initDialog": "411153201",
            "dialogues": [
                {
                    "id": "411153201",
                    "speaker": "艾伦",
                    "text": "有你们来帮忙处理陨石的事，真是帮了大忙了。"
                },
                {
                    "id": "411153202",
                    "speaker": "艾伦",
                    "text": "不过那些陨石到底是什么来头…唉，果然还是好在意。"
                }
            ]
        },
        {
            "talkId": "7092001",
            "initDialog": "709200101",
            "dialogues": [
                {
                    "id": "709200101",
                    "speaker": "Player",
                    "text": "关于狩猎的技巧…"
                },
                {
                    "id": "709200102",
                    "speaker": "艾伦",
                    "text": "杜拉夫先生真的很有经验，教会了我很多技巧，譬如狩猎时要注意风向，不要让猎物注意到气味之类的…"
                },
                {
                    "id": "709200103",
                    "speaker": "艾伦",
                    "text": "他还一眼就看出了我之前用的猎弓已经不符合我现在的水平了，然后亲手做了一张猎弓给我…"
                },
                {
                    "id": "709200104",
                    "speaker": "艾伦",
                    "text": "…谢谢你陪我聊了这么多，我以前用的那张弓就送给你吧，我已经用不到了。"
                }
            ]
        },
        {
            "talkId": "6153901",
            "initDialog": "615390101",
            "dialogues": [
                {
                    "id": "615390101",
                    "speaker": "艾伦",
                    "text": "你好，假如是想要找人去狩猎，还是去找其他猎手比较好…"
                }
            ]
        },
        {
            "talkId": "6153902",
            "initDialog": "615390201",
            "dialogues": [
                {
                    "id": "615390201",
                    "speaker": "Player",
                    "text": "你是谁？"
                },
                {
                    "id": "615390202",
                    "speaker": "艾伦",
                    "text": "啊，我叫艾伦，是一名…嗯，想要成为一名猎人。"
                },
                {
                    "id": "615390203",
                    "speaker": "艾伦",
                    "text": "现在还在努力向杜拉夫先生学习狩猎的技巧。"
                }
            ]
        },
        {
            "talkId": "6153903",
            "initDialog": "615390301",
            "dialogues": [
                {
                    "id": "615390301",
                    "speaker": "Player",
                    "text": "你看起来精神不好…"
                },
                {
                    "id": "615390302",
                    "speaker": "艾伦",
                    "text": "不用担心，是我昨天狩猎的时候又迷路了…"
                },
                {
                    "id": "615390303",
                    "speaker": "艾伦",
                    "text": "差点撞到丘丘人营地里面去，好不容易才跑了出来…",
                    "choices": [
                        {
                            "id": "615390304",
                            "text": "真是危险…",
                            "response": [
                                {
                                    "id": "615390305",
                                    "speaker": "艾伦",
                                    "text": "还好是安全回来了，但又是空手而归…"
                                },
                                {
                                    "id": "615390306",
                                    "speaker": "艾伦",
                                    "text": "不过…唉，算了，我都习惯了…"
                                }
                            ]
                        },
                        {
                            "id": "615390307",
                            "text": "辛苦你了。",
                            "response": [
                                {
                                    "id": "615390308",
                                    "speaker": "艾伦",
                                    "text": "我倒是还好，只是经常会被路过的侦察骑士安柏小姐搭救…"
                                },
                                {
                                    "id": "615390309",
                                    "speaker": "艾伦",
                                    "text": "真是太不好意思了。"
                                },
                                {
                                    "id": "615390310",
                                    "speaker": "艾伦",
                                    "text": "她真的很厉害，不愧是拥有神之眼的人呐…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6153904",
            "initDialog": "615390401",
            "dialogues": [
                {
                    "id": "615390401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615390402",
                    "speaker": "艾伦",
                    "text": "嗯，下次再见。"
                }
            ]
        }
    ]
}