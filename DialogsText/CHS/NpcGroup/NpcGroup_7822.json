{
    "groupId": "7822",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "布尔加科夫": 8
    },
    "talks": [
        {
            "talkId": "6782201",
            "initDialog": "678220101",
            "dialogues": [
                {
                    "id": "678220101",
                    "speaker": "布尔加科夫",
                    "text": "唉，早知道，就不当什么乡村医生了，还要在这跑来跑去…"
                }
            ]
        },
        {
            "talkId": "6782202",
            "initDialog": "678220201",
            "dialogues": [
                {
                    "id": "678220201",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "678220202",
                    "speaker": "布尔加科夫",
                    "text": "没…没什么，哦，看得出来您是位愿意倾听他人烦恼的品德高尚的人士…"
                },
                {
                    "id": "678220203",
                    "speaker": "布尔加科夫",
                    "text": "我只是，工作上有些烦恼，我好不容易以优等成绩从医学部毕业，现在却不得不乘着列车到各个乡镇里给人诊疗…"
                },
                {
                    "id": "678220204",
                    "speaker": "布尔加科夫",
                    "text": "乡镇里的条件差，有的时候还付不出相应的诊费，唉…但病人们躺在那里…能怎么办呢…"
                }
            ]
        },
        {
            "talkId": "6782203",
            "initDialog": "678220301",
            "dialogues": [
                {
                    "id": "678220301",
                    "speaker": "Player",
                    "text": "或许可以换个工作？"
                },
                {
                    "id": "678220302",
                    "speaker": "布尔加科夫",
                    "text": "要是换了工作…那我在皇家军事学院花了那么多年学习的医学知识，那些行医的经验…岂不都打了水漂…"
                },
                {
                    "id": "678220303",
                    "speaker": "布尔加科夫",
                    "text": "而且，我的父亲，唉…他一直希望我当个医生，体面，有足够的摩拉…"
                },
                {
                    "id": "678220304",
                    "speaker": "布尔加科夫",
                    "text": "该如何是好呢…"
                }
            ]
        },
        {
            "talkId": "6782204",
            "initDialog": "678220401",
            "dialogues": [
                {
                    "id": "678220401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "678220402",
                    "speaker": "布尔加科夫",
                    "text": "再见…唉…前途未卜啊…"
                }
            ]
        }
    ]
}