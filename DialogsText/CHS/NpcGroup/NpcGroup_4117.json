{
    "groupId": "4117",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "法里芭": 14
    },
    "talks": [
        {
            "talkId": "6411701",
            "initDialog": "641170101",
            "dialogues": [
                {
                    "id": "641170101",
                    "speaker": "法里芭",
                    "text": "欢迎光临。"
                }
            ]
        },
        {
            "talkId": "6411702",
            "initDialog": "641170201",
            "dialogues": [
                {
                    "id": "641170201",
                    "speaker": "Player",
                    "text": "你家卖什么？"
                },
                {
                    "id": "641170202",
                    "speaker": "法里芭",
                    "text": "嗯…我也不是每样商品都了解。都在店里放着了，客人自己看吧。"
                },
                {
                    "id": "641170203",
                    "speaker": "法里芭",
                    "text": "还有的就是…一些大家平常会用的东西啦。"
                },
                {
                    "id": "641170204",
                    "speaker": "法里芭",
                    "text": "毛毯、锅铲、雨伞、水杯…什么的。"
                }
            ]
        },
        {
            "talkId": "6411703",
            "initDialog": "641170301",
            "dialogues": [
                {
                    "id": "641170301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641170302",
                    "speaker": "法里芭",
                    "text": "慢走哦。"
                }
            ]
        },
        {
            "talkId": "6411704",
            "initDialog": "641170401",
            "dialogues": [
                {
                    "id": "641170401",
                    "speaker": "Player",
                    "text": "雨伞怎么卖？"
                },
                {
                    "id": "641170402",
                    "speaker": "法里芭",
                    "text": "欸，上面没有写价格吗？"
                },
                {
                    "id": "641170403",
                    "speaker": "法里芭",
                    "text": "嗯，雨伞…雨伞…"
                },
                {
                    "id": "641170404",
                    "speaker": "法里芭",
                    "text": "哎，我也想不起价格了。"
                },
                {
                    "id": "641170405",
                    "speaker": "法里芭",
                    "text": "要不客人再看看别的吧？"
                }
            ]
        },
        {
            "talkId": "6411705",
            "initDialog": "641170501",
            "dialogues": [
                {
                    "id": "641170501",
                    "speaker": "Player",
                    "text": "…这样卖得出去吗？"
                },
                {
                    "id": "641170502",
                    "speaker": "法里芭",
                    "text": "好像还…行吧？我不负责记账，所以不清楚啦。"
                },
                {
                    "id": "641170503",
                    "speaker": "法里芭",
                    "text": "每天倒是会有几个客人光顾本店，但都没有熟面孔。"
                },
                {
                    "id": "641170504",
                    "speaker": "法里芭",
                    "text": "我只记得一个面熟的人——偶尔会有个小个子女孩来找店长谈生意。"
                },
                {
                    "id": "641170505",
                    "speaker": "法里芭",
                    "text": "…但我不知道她都送了些什么商品过来。"
                },
                {
                    "id": "641170506",
                    "speaker": "法里芭",
                    "text": "店长好像对她态度很恭敬，但从不把她送的货品摆出来。"
                }
            ]
        }
    ]
}