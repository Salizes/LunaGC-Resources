{
    "groupId": "2078",
    "total_dialogue_lines": 72,
    "speaker_counts": {
        "Player": 18,
        "凯瑟琳": 54
    },
    "talks": [
        {
            "talkId": "7065301",
            "initDialog": "706530101",
            "dialogues": [
                {
                    "id": "706530101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎你，冒险家，我一直在等待你的到来。",
                    "choices": [
                        {
                            "id": "706530102",
                            "text": "最近过得还好吗？",
                            "response": [
                                {
                                    "id": "706530103",
                                    "speaker": "凯瑟琳",
                                    "text": "谢谢关心，我一切都好。不过协会这边，又遇到了紧急的突发事件…"
                                },
                                {
                                    "id": "706530106",
                                    "speaker": "凯瑟琳",
                                    "text": "近些日子，冒险家协会收到了很多「岩龙蜥」的目击情报。"
                                },
                                {
                                    "id": "706530107",
                                    "speaker": "凯瑟琳",
                                    "text": "「岩龙蜥」原本只出现在古书的记载中，不知为什么会突然出现。"
                                },
                                {
                                    "id": "706530108",
                                    "speaker": "凯瑟琳",
                                    "text": "它们虽与幼岩龙蜥形态相似，但性情凶暴，破坏力也高了好几个档次。"
                                },
                                {
                                    "id": "706530109",
                                    "speaker": "凯瑟琳",
                                    "text": "最近不少人喜欢去僻静的野外观景和放灯，如果正巧遇上了「岩龙蜥」，那后果不堪设想。"
                                },
                                {
                                    "id": "706530110",
                                    "speaker": "凯瑟琳",
                                    "text": "然而不巧的是，有很多冒险家都去走亲访友了，璃月协会正处于人手严重不足的情况…",
                                    "choices": [
                                        {
                                            "id": "706530111",
                                            "text": "拜托千岩军怎么样？",
                                            "response": [
                                                {
                                                    "id": "706530112",
                                                    "speaker": "凯瑟琳",
                                                    "text": "缺人手的情况，千岩军也是一样，维护治安也是同等重要的事。"
                                                },
                                                {
                                                    "id": "706530115",
                                                    "speaker": "凯瑟琳",
                                                    "text": "想到你近期在协会中的活跃表现，我觉得能够圆满解决这件事的人，只有你了。",
                                                    "choices": [
                                                        {
                                                            "id": "706530116",
                                                            "text": "好吧，既然是要紧事。",
                                                            "response": [
                                                                {
                                                                    "id": "706530118",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "谢谢你能答应，首先需要做的，是调查「岩龙蜥」的痕迹，追踪它们的位置。"
                                                                },
                                                                {
                                                                    "id": "706530119",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "想必你已经尝试过协会的「探索派遣」委托，我已经将「岩龙蜥」的线索整理成相似的形式了。"
                                                                },
                                                                {
                                                                    "id": "706530120",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "事不宜迟，我们先来看一看吧。"
                                                                },
                                                                {
                                                                    "id": "706530121",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "和一般的「探索派遣」不同的是，这次协会已经进行了一些初期调查，如果根据已有的情报进行准备，就能获得事半功倍的效果。"
                                                                },
                                                                {
                                                                    "id": "706530122",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "根据需要花费的时间和可能存在的风险，协会将这些探索派遣分为了不同的等级，等级越高，奖励也会越丰厚。"
                                                                },
                                                                {
                                                                    "id": "706530123",
                                                                    "speaker": "凯瑟琳",
                                                                    "text": "将收获的线索整理起来，相信就可以找到「岩龙蜥」的出没位置了。",
                                                                    "choices": [
                                                                        {
                                                                            "id": "706530124",
                                                                            "text": "然后解决掉它就行了吧。",
                                                                            "response": [
                                                                                {
                                                                                    "id": "706530126",
                                                                                    "speaker": "凯瑟琳",
                                                                                    "text": "对了，协会的情报每天都会更新。在你和你的伙伴调查的时候，我会尽力做好支援工作的。"
                                                                                },
                                                                                {
                                                                                    "id": "706530127",
                                                                                    "speaker": "凯瑟琳",
                                                                                    "text": "那么，调查「岩龙蜥」一事就拜托你了。加油，向着星辰与深渊！"
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "706530125",
                                                                            "text": "战斗的事，我最擅长。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706530117",
                                                            "text": "我应该怎么做？"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706530113",
                                            "text": "从其他地区的协会请求支援？",
                                            "response": [
                                                {
                                                    "id": "706530114",
                                                    "speaker": "凯瑟琳",
                                                    "text": "其他地区的情况…也比较复杂，虽然获得了一些支援，但还是完全不够。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706530104",
                            "text": "又出什么事了吗？",
                            "response": [
                                {
                                    "id": "706530105",
                                    "speaker": "凯瑟琳",
                                    "text": "嗯，是紧急的突发事件。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7068802",
            "initDialog": "706880201",
            "dialogues": [
                {
                    "id": "706880201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么厉害的委托吗？</color>"
                },
                {
                    "id": "706880202",
                    "speaker": "凯瑟琳",
                    "text": "您来的正巧，有一份协会共享给资深冒险家的手册要交给您。",
                    "choices": [
                        {
                            "id": "706880203",
                            "text": "是提瓦特美食大全吗？",
                            "response": [
                                {
                                    "id": "706880204",
                                    "speaker": "凯瑟琳",
                                    "text": "很遗憾，并不是。"
                                },
                                {
                                    "id": "706880207",
                                    "speaker": "凯瑟琳",
                                    "text": "如您所见，手册记录了值得挑战的强敌的信息。"
                                },
                                {
                                    "id": "706880208",
                                    "speaker": "凯瑟琳",
                                    "text": "若能合理利用，想必会为您的冒险旅途增加许多助益。之后如果需要查阅相关信息，也随时欢迎您来。"
                                },
                                {
                                    "id": "706880209",
                                    "speaker": "凯瑟琳",
                                    "text": "那么，就祝您旗开得胜。"
                                }
                            ]
                        },
                        {
                            "id": "706880205",
                            "text": "难道又是新的任务…",
                            "response": [
                                {
                                    "id": "706880206",
                                    "speaker": "凯瑟琳",
                                    "text": "挑战与否，选择权当然在您。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7165101",
            "initDialog": "716510101",
            "dialogues": [
                {
                    "id": "716510101",
                    "speaker": "凯瑟琳",
                    "text": "冒险家，感谢你这些日子的努力，委托你「岩龙蜥」的调查的事，终于可以告一段落了。",
                    "choices": [
                        {
                            "id": "716510102",
                            "text": "终于结束了…",
                            "response": [
                                {
                                    "id": "716510103",
                                    "speaker": "凯瑟琳",
                                    "text": "辛苦你了，解了协会的燃眉之急。"
                                },
                                {
                                    "id": "716510106",
                                    "speaker": "凯瑟琳",
                                    "text": "去探亲的冒险家们已经陆续回协会报到了，你已经做了很多贡献，收尾的工作就交给我们吧。"
                                },
                                {
                                    "id": "716510107",
                                    "speaker": "凯瑟琳",
                                    "text": "至于为什么「岩龙蜥」这种古老生物会突然出现，我们也会继续调查的。"
                                },
                                {
                                    "id": "716510108",
                                    "speaker": "凯瑟琳",
                                    "text": "对了，不要忘记领取这次调查的报酬哦。"
                                },
                                {
                                    "id": "716510109",
                                    "speaker": "凯瑟琳",
                                    "text": "冒险家协会期待你今后的活跃表现！向着星辰与深渊！"
                                }
                            ]
                        },
                        {
                            "id": "716510104",
                            "text": "还没尽兴呢。",
                            "response": [
                                {
                                    "id": "716510105",
                                    "speaker": "凯瑟琳",
                                    "text": "哈哈，看来你乐在其中的样子，这再好不过了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "2010136",
            "initDialog": "201013601",
            "dialogues": [
                {
                    "id": "201013601",
                    "speaker": "凯瑟琳",
                    "text": "领取「每日委托」奖励"
                },
                {
                    "id": "201013602",
                    "speaker": "凯瑟琳",
                    "text": "很抱歉，今天你完成的委托数量还不够呢。"
                }
            ]
        },
        {
            "talkId": "2010137",
            "initDialog": "201013701",
            "dialogues": [
                {
                    "id": "201013701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013702",
                    "speaker": "凯瑟琳",
                    "text": "感谢你完成了今天的委托，这是给你的奖励。"
                }
            ]
        },
        {
            "talkId": "2010138",
            "initDialog": "201013801",
            "dialogues": [
                {
                    "id": "201013801",
                    "speaker": "凯瑟琳",
                    "text": "<color=#999999FF>领取「每日委托」奖励</color>"
                },
                {
                    "id": "201013802",
                    "speaker": "凯瑟琳",
                    "text": "你已经领取过今天的奖励了，希望你明天也能继续承接协会的委托。"
                }
            ]
        },
        {
            "talkId": "2010141",
            "initDialog": "201014101",
            "dialogues": [
                {
                    "id": "201014101",
                    "speaker": "凯瑟琳",
                    "text": "探索派遣"
                }
            ]
        },
        {
            "talkId": "2010142",
            "initDialog": "201014201",
            "dialogues": [
                {
                    "id": "201014201",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>探索派遣</color>"
                }
            ]
        },
        {
            "talkId": "6207801",
            "initDialog": "620780101",
            "dialogues": [
                {
                    "id": "620780101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！欢迎来到冒险家协会。"
                }
            ]
        },
        {
            "talkId": "6207802",
            "initDialog": "620780201",
            "dialogues": [
                {
                    "id": "620780201",
                    "speaker": "Player",
                    "text": "凯瑟琳…？"
                },
                {
                    "id": "620780202",
                    "speaker": "凯瑟琳",
                    "text": "没错，我是冒险家协会的接待员凯瑟琳。"
                },
                {
                    "id": "620780203",
                    "speaker": "凯瑟琳",
                    "text": "负责为冒险家们提供任务发布和情报支援工作，而且这份服务全年无休喔。"
                },
                {
                    "id": "620780204",
                    "speaker": "凯瑟琳",
                    "text": "话说回来，为什么感觉冒险家您这么见外？"
                },
                {
                    "id": "620780205",
                    "speaker": "Player",
                    "text": "你为什么会在这里？"
                },
                {
                    "id": "620780206",
                    "speaker": "凯瑟琳",
                    "text": "抱歉，我不是很明白您的疑惑。"
                },
                {
                    "id": "620780207",
                    "speaker": "凯瑟琳",
                    "text": "协会的所有人都知道，凯瑟琳是冒险家协会的接待员，璃月分部也需要一位接待员…"
                },
                {
                    "id": "620780208",
                    "speaker": "凯瑟琳",
                    "text": "所以凯瑟琳出现在了这里。"
                },
                {
                    "id": "620780209",
                    "speaker": "凯瑟琳",
                    "text": "…有什么问题吗？"
                }
            ]
        },
        {
            "talkId": "6207803",
            "initDialog": "620780301",
            "dialogues": [
                {
                    "id": "620780301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620780302",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，冒险家。"
                }
            ]
        },
        {
            "talkId": "6207804",
            "initDialog": "620780401",
            "dialogues": [
                {
                    "id": "620780401",
                    "speaker": "凯瑟琳",
                    "text": "领取「冒险等阶」奖励"
                }
            ]
        },
        {
            "talkId": "6207805",
            "initDialog": "620780501",
            "dialogues": [
                {
                    "id": "620780501",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>领取「冒险等阶」奖励</color>"
                }
            ]
        },
        {
            "talkId": "6207806",
            "initDialog": "620780601",
            "dialogues": [
                {
                    "id": "620780601",
                    "speaker": "凯瑟琳",
                    "text": "查看「豪斗旅纪」信息"
                }
            ]
        },
        {
            "talkId": "6207807",
            "initDialog": "620780701",
            "dialogues": [
                {
                    "id": "620780701",
                    "speaker": "凯瑟琳",
                    "text": "<color=#FFCC33FF>查看「豪斗旅纪」信息</color>"
                }
            ]
        },
        {
            "talkId": "6207808",
            "initDialog": "620780801",
            "dialogues": [
                {
                    "id": "620780801",
                    "speaker": "凯瑟琳",
                    "text": "欢迎来到冒险家协会，「木偶」大人。有什么我能为您做的吗？"
                }
            ]
        },
        {
            "talkId": "6207809",
            "initDialog": "620780901",
            "dialogues": [
                {
                    "id": "620780901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620780902",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，「木偶」大人。"
                }
            ]
        }
    ]
}