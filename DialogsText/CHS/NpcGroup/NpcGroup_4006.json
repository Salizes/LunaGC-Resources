    "talks": [
        {
            "talkId": "6400601",
            "initDialog": "640060101",
            "dialogues": [
                {
                    "id": "640060101",
                    "speaker": "哈桑",
                    "text": "那家伙啊，要是不想出点新故事来，可是吃不饱饭的哦。"
                }
            ]
        },
        {
            "talkId": "6400602",
            "initDialog": "640060201",
            "dialogues": [
                {
                    "id": "640060201",
                    "speaker": "Player",
                    "text": "那家伙？"
                },
                {
                    "id": "640060202",
                    "speaker": "哈桑",
                    "text": "就是那个在咖啡馆整天念叨同一个故事的家伙。"
                },
                {
                    "id": "640060203",
                    "speaker": "哈桑",
                    "text": "他啊，以前曾和我一起学习理发的手艺，结果中途退出，说是要去当什么「咖啡馆特邀驻场说书人」，用伟大的英雄故事征服所有看客。"
                },
                {
                    "id": "640060204",
                    "speaker": "哈桑",
                    "text": "我看他现在也没混出什么名堂，只能算个「咖啡馆驻场失业人」，每天用老一套的说辞从好心的客人手里换一杯咖啡喝。"
                }
            ]
        },
        {
            "talkId": "6400603",
            "initDialog": "640060301",
            "dialogues": [
                {
                    "id": "640060301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640060302",
                    "speaker": "哈桑",
                    "text": "再见。讲故事和理发一样，都得有点新意才能招揽顾客啊。"
                }
            ]
        }
    ]
}