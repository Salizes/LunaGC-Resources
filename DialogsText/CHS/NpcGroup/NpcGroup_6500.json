{
    "groupId": "6500",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "穆托莉娜": 10
    },
    "talks": [
        {
            "talkId": "6650001",
            "initDialog": "665000101",
            "dialogues": [
                {
                    "id": "665000101",
                    "speaker": "穆托莉娜",
                    "text": "醅幽花的花语是难以预料的命运。依照占卜的结果，想必你是来寻求「花」的指引的吧…"
                }
            ]
        },
        {
            "talkId": "6650002",
            "initDialog": "665000201",
            "dialogues": [
                {
                    "id": "665000201",
                    "speaker": "Player",
                    "text": "让我看看「花」。"
                },
                {
                    "id": "665000202",
                    "speaker": "穆托莉娜",
                    "text": "愿你在此寻找到你的命运。"
                }
            ]
        },
        {
            "talkId": "6650003",
            "initDialog": "665000301",
            "dialogues": [
                {
                    "id": "665000301",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "665000302",
                    "speaker": "穆托莉娜",
                    "text": "我?我是穆托莉娜，阐释「花」之言语的人。用俗世的话语来说，我是花草商店的老板。"
                }
            ]
        },
        {
            "talkId": "6650004",
            "initDialog": "665000401",
            "dialogues": [
                {
                    "id": "665000401",
                    "speaker": "Player",
                    "text": "「花」也会说话吗？"
                },
                {
                    "id": "665000402",
                    "speaker": "穆托莉娜",
                    "text": "会，但也不会，「花」不会言语，但它的一切均是言语。它的形貌会诠释命运，它的花粉会倾诉情绪，而它的骨朵会研判结局。"
                },
                {
                    "id": "665000403",
                    "speaker": "穆托莉娜",
                    "text": "而你需要做的，便是与之相伴，并侧耳静听…"
                }
            ]
        },
        {
            "talkId": "6650005",
            "initDialog": "665000501",
            "dialogues": [
                {
                    "id": "665000501",
                    "speaker": "Player",
                    "text": "有没有推荐购买的花？"
                },
                {
                    "id": "665000502",
                    "speaker": "穆托莉娜",
                    "text": "炽烈的灵魂会吸引坚强的花，或许像「灼灼彩菊」这样能傲立于风中的花朵，更为适合陪伴在你的左右。"
                }
            ]
        },
        {
            "talkId": "6650007",
            "initDialog": "665000701",
            "dialogues": [
                {
                    "id": "665000701",
                    "speaker": "Player",
                    "text": "不好意思，下次再说。"
                },
                {
                    "id": "665000702",
                    "speaker": "穆托莉娜",
                    "text": "慢走，一切均是「花」的指引，我们终将再度相遇…"
                }
            ]
        },
        {
            "talkId": "6650008",
            "initDialog": "665000801",
            "dialogues": [
                {
                    "id": "665000801",
                    "speaker": "穆托莉娜",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6650009",
            "initDialog": "665000901",
            "dialogues": [
                {
                    "id": "665000901",
                    "speaker": "穆托莉娜",
                    "text": "一切都是「花」的指引…"
                }
            ]
        },
        {
            "talkId": "6650010",
            "initDialog": "665001001",
            "dialogues": [
                {
                    "id": "665001001",
                    "speaker": "穆托莉娜",
                    "text": "为什么？难道是我的占卜出错了？"
                }
            ]
        }
    ]
}