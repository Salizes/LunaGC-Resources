{
    "groupId": "4099",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "希拉非": 7
    },
    "talks": [
        {
            "talkId": "6409901",
            "initDialog": "640990101",
            "dialogues": [
                {
                    "id": "640990101",
                    "speaker": "希拉非",
                    "text": "别看我手上只是些简单的货物，但都是大名鼎鼎的「卡萨扎莱宫」出品。"
                }
            ]
        },
        {
            "talkId": "6409902",
            "initDialog": "640990201",
            "dialogues": [
                {
                    "id": "640990201",
                    "speaker": "Player",
                    "text": "关于「卡萨扎莱宫」…"
                },
                {
                    "id": "640990202",
                    "speaker": "希拉非",
                    "text": "即便你没听说过这个名字，应该也不会忽视须弥北部的那座巨大的宫殿吧？"
                },
                {
                    "id": "640990203",
                    "speaker": "希拉非",
                    "text": "没错，那就是「卡萨扎莱宫」，主人便是我的雇主。"
                },
                {
                    "id": "640990204",
                    "speaker": "希拉非",
                    "text": "从她手上经过的商品，哪怕品类再普通，也有着不一样的价值！"
                }
            ]
        },
        {
            "talkId": "6409903",
            "initDialog": "640990301",
            "dialogues": [
                {
                    "id": "640990301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640990302",
                    "speaker": "希拉非",
                    "text": "保证货真价实！"
                }
            ]
        },
        {
            "talkId": "7394301",
            "initDialog": "739430101",
            "dialogues": [
                {
                    "id": "739430101",
                    "speaker": "Player",
                    "text": "这么厉害？"
                },
                {
                    "id": "739430102",
                    "speaker": "希拉非",
                    "text": "不信？那让你看看我的货品质量，自己判断吧。"
                },
                {
                    "id": "739430103",
                    "speaker": "希拉非",
                    "text": "这些你拿走就好，「卡萨扎莱宫」不在乎这点支出。"
                }
            ]
        }
    ]
}