{
    "groupId": "6420",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "佩尤特莉": 6
    },
    "talks": [
        {
            "talkId": "6642001",
            "initDialog": "664200101",
            "dialogues": [
                {
                    "id": "664200101",
                    "speaker": "佩尤特莉",
                    "text": "在纳塔，这种生物是绝不会被称作龙的…但一想到是在须弥，好像也算合理。"
                }
            ]
        },
        {
            "talkId": "6642002",
            "initDialog": "664200201",
            "dialogues": [
                {
                    "id": "664200201",
                    "speaker": "Player",
                    "text": "龙什么？什么龙？"
                },
                {
                    "id": "664200202",
                    "speaker": "佩尤特莉",
                    "text": "确切来讲，是沙虫，不是龙。"
                },
                {
                    "id": "664200203",
                    "speaker": "佩尤特莉",
                    "text": "不过在这里的一些研究流派认为，沙虫也是龙类的形态之一，只是生物在沙漠中逐渐适应，或者说「进化」后的形态。"
                },
                {
                    "id": "664200204",
                    "speaker": "佩尤特莉",
                    "text": "说实话，我虽然并不认同，但可以理解这种说辞的逻辑。"
                },
                {
                    "id": "664200205",
                    "speaker": "佩尤特莉",
                    "text": "就像某些植物会根据温度、光照等环境因素呈现出差异很大的样貌，依靠「龙」的适应性，这种改变只会更大吧。"
                }
            ]
        },
        {
            "talkId": "6642003",
            "initDialog": "664200301",
            "dialogues": [
                {
                    "id": "664200301",
                    "speaker": "Player",
                    "text": "对、对吗？"
                },
                {
                    "id": "664200302",
                    "speaker": "佩尤特莉",
                    "text": "呵呵，错误的理论也有存在的价值。"
                }
            ]
        }
    ]
}