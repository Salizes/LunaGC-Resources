{
    "groupId": "2137",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "江城": 16
    },
    "talks": [
        {
            "talkId": "6213701",
            "initDialog": "621370101",
            "dialogues": [
                {
                    "id": "621370101",
                    "speaker": "江城",
                    "text": "唉…好久没下地了，也不知道收成怎么样…"
                },
                {
                    "id": "621370102",
                    "speaker": "江城",
                    "text": "老婆子，老婆子…？"
                }
            ]
        },
        {
            "talkId": "6213702",
            "initDialog": "621370201",
            "dialogues": [
                {
                    "id": "621370201",
                    "speaker": "Player",
                    "text": "你好？"
                },
                {
                    "id": "621370202",
                    "speaker": "江城",
                    "text": "老婆子，你来啦…"
                },
                {
                    "id": "621370203",
                    "speaker": "江城",
                    "text": "正念叨着你呢…你说咱家女儿也不小了…该考虑婚事了，对吧？"
                },
                {
                    "id": "621370204",
                    "speaker": "江城",
                    "text": "唉…可不要找那些个游手好闲的小流氓…"
                },
                {
                    "id": "621370205",
                    "speaker": "江城",
                    "text": "话说回来，她要是自己看上了谁，咱们得好好帮她参谋参谋…",
                    "choices": [
                        {
                            "id": "621370206",
                            "text": "恐怕你认错人了…",
                            "response": [
                                {
                                    "id": "621370207",
                                    "speaker": "江城",
                                    "text": "什么…你怕我看错人？"
                                },
                                {
                                    "id": "621370208",
                                    "speaker": "江城",
                                    "text": "笑话！你跟我过这么多年了，我的眼力出过错吗？"
                                },
                                {
                                    "id": "621370209",
                                    "speaker": "江城",
                                    "text": "而且是你跟我说的，就算我瞎了，你也会当我的另一双眼睛的，不记得了？"
                                },
                                {
                                    "id": "621370210",
                                    "speaker": "江城",
                                    "text": "我怎么会认不出你嘛，我可满脑子都是你呀，哈哈哈…"
                                }
                            ]
                        },
                        {
                            "id": "621370211",
                            "text": "女儿…？",
                            "response": [
                                {
                                    "id": "621370212",
                                    "speaker": "江城",
                                    "text": "咱们女儿也不小了，出落的亭亭玉立…"
                                },
                                {
                                    "id": "621370213",
                                    "speaker": "江城",
                                    "text": "长得可真…嗯…咱女儿长什么样来着？我咋记不起来了…"
                                },
                                {
                                    "id": "621370214",
                                    "speaker": "江城",
                                    "text": "…啊，对啊，是我没见过她长大的样子啊…"
                                },
                                {
                                    "id": "621370215",
                                    "speaker": "江城",
                                    "text": "要是那天晚上风雨小一点…要是我回来早半个时辰…"
                                },
                                {
                                    "id": "621370216",
                                    "speaker": "江城",
                                    "text": "…我们的女儿…还有你，老婆子…我们就…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6213703",
            "initDialog": "621370301",
            "dialogues": [
                {
                    "id": "621370301",
                    "speaker": "Player",
                    "text": "…再见。"
                },
                {
                    "id": "621370302",
                    "speaker": "江城",
                    "text": "欸，好，老婆子…别忘了看看咱家的地…"
                }
            ]
        }
    ]
}