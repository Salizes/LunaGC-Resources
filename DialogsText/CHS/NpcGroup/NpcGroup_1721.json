{
    "groupId": "1721",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "派蒙": 10
    },
    "talks": [
        {
            "talkId": "7067651",
            "initDialog": "706765101",
            "dialogues": [
                {
                    "id": "706765101",
                    "speaker": "派蒙",
                    "text": "呜哇，这幅画上的人…在动？"
                },
                {
                    "id": "706765102",
                    "speaker": "派蒙",
                    "text": "#那个，你好！我是派蒙，{M#他}{F#她}是{NICKNAME}，请问这里是什么地方呀？",
                    "choices": [
                        {
                            "id": "706765103",
                            "text": "你好！",
                            "response": [
                                {
                                    "id": "706765105",
                                    "speaker": "派蒙",
                                    "text": "呃，完全没有反应呢，她好像根本听不到我们说话…",
                                    "choices": [
                                        {
                                            "id": "706765106",
                                            "text": "说不定是打招呼的方式太没礼貌了？",
                                            "response": [
                                                {
                                                    "id": "706765107",
                                                    "speaker": "派蒙",
                                                    "text": "「啊，这位高贵而美丽的小姐，可否请您聆听我们的问题？」"
                                                },
                                                {
                                                    "id": "706765108",
                                                    "speaker": "派蒙",
                                                    "text": "果然，只要像这样优雅地打招呼，她就会回应我们——才怪啦！这应该就只是会动的画而已吧？"
                                                },
                                                {
                                                    "id": "706765109",
                                                    "speaker": "派蒙",
                                                    "text": "#虽然不知道为什么画会动，但等下去也找不到答案。{NICKNAME}，我们还是先去其他地方看看吧？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706765110",
                                            "text": "派蒙，进画里看看吧。",
                                            "response": [
                                                {
                                                    "id": "706765111",
                                                    "speaker": "派蒙",
                                                    "text": "嗯嗯，原来如此，只要进入「画中的世界」就好了——才怪啦！怎么想我都进不去吧？！"
                                                },
                                                {
                                                    "id": "706765112",
                                                    "speaker": "派蒙",
                                                    "text": "#倒不如说这已经不是进得去进不去的问题了，{NICKNAME}，你到底在想些什么啦！"
                                                },
                                                {
                                                    "id": "706765113",
                                                    "speaker": "派蒙",
                                                    "text": "唉，算了，虽然还是不知道为什么画会动，但等下去也找不到答案，我们还是先去其他地方看看吧？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706765104",
                            "text": "我是西风骑士团荣誉骑士！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7067652",
            "initDialog": "706765201",
            "dialogues": [
                {
                    "id": "706765201",
                    "speaker": "派蒙",
                    "text": "话说回来，这幅画上的角色，我好像在哪本童话书的插图里见到过…"
                }
            ]
        }
    ]
}