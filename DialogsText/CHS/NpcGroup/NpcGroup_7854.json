        {
            "talkId": "6785401",
            "initDialog": "678540101",
            "dialogues": [
                {
                    "id": "678540101",
                    "speaker": "奥布连斯基",
                    "text": "再熬一熬，我相信没什么大不了的！"
                }
            ]
        },
        {
            "talkId": "6785402",
            "initDialog": "678540201",
            "dialogues": [
                {
                    "id": "678540201",
                    "speaker": "Player",
                    "text": "熬一熬？"
                },
                {
                    "id": "678540202",
                    "speaker": "奥布连斯基",
                    "text": "对！日子都是这么过来的，不是吗？"
                },
                {
                    "id": "678540203",
                    "speaker": "奥布连斯基",
                    "text": "我啊，来自一个小小的村庄，那地方偏远得不得了，河面常年封冻，一年里头没几天吃得饱。"
                },
                {
                    "id": "678540204",
                    "speaker": "奥布连斯基",
                    "text": "那样的日子，我也忍耐着、忍耐着。终于，我熬出了头，找到机会来到了凝露镇，在这里留下。"
                },
                {
                    "id": "678540206",
                    "speaker": "奥布连斯基",
                    "text": "现在的日子虽然困难，但凝露镇的情况，怕是总比我的家乡要强。我还有什么不知足的呢？"
                },
                {
                    "id": "678540207",
                    "speaker": "奥布连斯基",
                    "text": "再熬一熬吧！生活总是这样，只要我们学会忍耐、辛勤耕耘，总是能够熬出头的。"
                }
            ]
        },
        {
