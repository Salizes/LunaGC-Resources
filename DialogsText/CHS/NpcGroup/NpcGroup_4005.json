{
    "groupId": "4005",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "伊泽姆": 9
    },
    "talks": [
        {
            "talkId": "6400501",
            "initDialog": "640050101",
            "dialogues": [
                {
                    "id": "640050101",
                    "speaker": "伊泽姆",
                    "text": "今天的咖啡…也和昨天一样啊。"
                }
            ]
        },
        {
            "talkId": "6400502",
            "initDialog": "640050201",
            "dialogues": [
                {
                    "id": "640050201",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "640050202",
                    "speaker": "伊泽姆",
                    "text": "还不错。按照这里人的说法，应该是相当不错。"
                },
                {
                    "id": "640050203",
                    "speaker": "伊泽姆",
                    "text": "大家都如此喜爱安稳的生活，我虽然不怎么习惯，但也没什么可抱怨的。"
                },
                {
                    "id": "640050204",
                    "speaker": "伊泽姆",
                    "text": "每天喝喝咖啡，发发呆，一天慢慢过去，感觉日子也比以前在「三十人团」里时过得长了。"
                },
                {
                    "id": "640050205",
                    "speaker": "伊泽姆",
                    "text": "代理店长每天都给我泡同一种咖啡，说我也该和附近的居民一样，熟悉平静的气味了。"
                },
                {
                    "id": "640050206",
                    "speaker": "伊泽姆",
                    "text": "大概，以后总会有那么一天吧。"
                }
            ]
        },
        {
            "talkId": "6400503",
            "initDialog": "640050301",
            "dialogues": [
                {
                    "id": "640050301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640050302",
                    "speaker": "伊泽姆",
                    "text": "是啊，再见了，以前的生活。"
                }
            ]
        },
        {
            "talkId": "7392301",
            "initDialog": "739230101",
            "dialogues": [
                {
                    "id": "739230101",
                    "speaker": "Player",
                    "text": "退休也挺好的。"
                },
                {
                    "id": "739230102",
                    "speaker": "伊泽姆",
                    "text": "嗯，我也慢慢体会到了。"
                },
                {
                    "id": "739230103",
                    "speaker": "伊泽姆",
                    "text": "也许是时候和以前那些充满争斗的生活告别了。"
                }
            ]
        }
    ]
}