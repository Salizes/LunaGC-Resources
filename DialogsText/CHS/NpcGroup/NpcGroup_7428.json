{
    "groupId": "7428",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "布洛维诺夫": 7
    },
    "talks": [
        {
            "talkId": "6742801",
            "initDialog": "674280101",
            "dialogues": [
                {
                    "id": "674280101",
                    "speaker": "布洛维诺夫",
                    "text": "嗯…最新的期刊在哪里呢…"
                }
            ]
        },
        {
            "talkId": "6742802",
            "initDialog": "674280201",
            "dialogues": [
                {
                    "id": "674280201",
                    "speaker": "Player",
                    "text": "你在干什么？"
                },
                {
                    "id": "674280202",
                    "speaker": "布洛维诺夫",
                    "text": "哇，小声点，小声点，我在找最新的机关研究刊物…"
                },
                {
                    "id": "674280203",
                    "speaker": "布洛维诺夫",
                    "text": "我看完枫丹科学院最新的机关研究就走，别告诉老板，他总嫌我看了不买…"
                }
            ]
        },
        {
            "talkId": "6742803",
            "initDialog": "674280301",
            "dialogues": [
                {
                    "id": "674280301",
                    "speaker": "Player",
                    "text": "什么期刊？"
                },
                {
                    "id": "674280302",
                    "speaker": "布洛维诺夫",
                    "text": "和机关或者机械相关的研究期刊…嘿嘿，上次我写给他们的读者来信还被刊载了呢…"
                },
                {
                    "id": "674280303",
                    "speaker": "布洛维诺夫",
                    "text": "要是、要是我有足够的摩拉就好了，就能把那一期买下来了。"
                },
                {
                    "id": "674280304",
                    "speaker": "布洛维诺夫",
                    "text": "但是摩拉总有更重要的用途…对吧？"
                }
            ]
        },
        {
            "talkId": "6742804",
            "initDialog": "674280401",
            "dialogues": [
                {
                    "id": "674280401",
                    "speaker": "Player",
                    "text": "你慢慢找。"
                },
                {
                    "id": "674280402",
                    "speaker": "布洛维诺夫",
                    "text": "好的，好的，嘘，记得小声点…"
                }
            ]
        }
    ]
}