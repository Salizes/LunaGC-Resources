{
    "groupId": "6041",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "阿格莫": 9
    },
    "talks": [
        {
            "talkId": "6604101",
            "initDialog": "660410101",
            "dialogues": [
                {
                    "id": "660410101",
                    "speaker": "阿格莫",
                    "text": "你好！现在不是比赛时间，要点外卖请去找西帕克先生，我只负责跑腿。"
                }
            ]
        },
        {
            "talkId": "6604102",
            "initDialog": "660410201",
            "dialogues": [
                {
                    "id": "660410201",
                    "speaker": "Player",
                    "text": "你是外卖员？"
                },
                {
                    "id": "660410202",
                    "speaker": "阿格莫",
                    "text": "嗯，不过严格来讲，我差不多只在圣火竞技场有比赛的时候上班。"
                },
                {
                    "id": "660410203",
                    "speaker": "阿格莫",
                    "text": "有的观众看比赛时跳累了、喊累了，就很容易想要吃点喝点什么。"
                },
                {
                    "id": "660410204",
                    "speaker": "阿格莫",
                    "text": "于是我就穿梭在观众席里，帮他们把想吃的东西记下，再给他们买回来。"
                },
                {
                    "id": "660410205",
                    "speaker": "阿格莫",
                    "text": "观众不用多付我什么钱，西帕克先生会定期给我结算报酬的。"
                },
                {
                    "id": "660410206",
                    "speaker": "阿格莫",
                    "text": "而像现在这种没有比赛的时候呢，就是我的休息时间啦。"
                }
            ]
        },
        {
            "talkId": "6604103",
            "initDialog": "660410301",
            "dialogues": [
                {
                    "id": "660410301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "660410302",
                    "speaker": "阿格莫",
                    "text": "回见。"
                }
            ]
        },
        {
            "talkId": "7592001",
            "initDialog": "759200101",
            "dialogues": [
                {
                    "id": "759200101",
                    "speaker": "Player",
                    "text": "听起来是体力活。"
                },
                {
                    "id": "759200102",
                    "speaker": "阿格莫",
                    "text": "可不是嘛。为了防止食物变凉变软，每天都在和时间赛跑。"
                },
                {
                    "id": "759200103",
                    "speaker": "阿格莫",
                    "text": "不过还好我认路技术不错，从没送错过。"
                }
            ]
        }
    ]
}