{
    "groupId": "9312",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "诺艾尔": 9
    },
    "talks": [
        {
            "talkId": "6931201",
            "initDialog": "693120101",
            "dialogues": [
                {
                    "id": "693120101",
                    "speaker": "诺艾尔",
                    "text": "地板需要打扫，地毯也需要重新洗涤和更换，还有书架上的书籍…看上去也该重新整理整理了。"
                },
                {
                    "id": "693120102",
                    "speaker": "诺艾尔",
                    "text": "你去休息就好，这些请交给我来做吧！"
                },
                {
                    "id": "693120103",
                    "speaker": "诺艾尔",
                    "text": "嗯？我没有在勉强自己！这就是我的休息方式。"
                }
            ]
        },
        {
            "talkId": "6931202",
            "initDialog": "693120201",
            "dialogues": [
                {
                    "id": "693120201",
                    "speaker": "诺艾尔",
                    "text": "#{NICKNAME}，谢谢你让我加入这支探索秘境的队伍。"
                },
                {
                    "id": "693120202",
                    "speaker": "诺艾尔",
                    "text": "为了成为一名骑士，我必须要锻炼出对抗强敌的实力才行。"
                },
                {
                    "id": "693120203",
                    "speaker": "诺艾尔",
                    "text": "出战的时候，我会全力以赴的！"
                }
            ]
        },
        {
            "talkId": "6931203",
            "initDialog": "693120301",
            "dialogues": [
                {
                    "id": "693120301",
                    "speaker": "诺艾尔",
                    "text": "打扫工作处理完毕，没有其他人需要我提供帮助…"
                },
                {
                    "id": "693120302",
                    "speaker": "诺艾尔",
                    "text": "餐具已经清洗过一遍，作为回礼的咖啡和点心也全都准备好了…"
                },
                {
                    "id": "693120303",
                    "speaker": "诺艾尔",
                    "text": "#{NICKNAME}，不耽误你时间的话，能请你为我做一些剑术上的指导吗？"
                }
            ]
        }
    ]
}