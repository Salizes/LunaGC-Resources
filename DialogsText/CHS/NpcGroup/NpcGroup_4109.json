    "talks": [
        {
            "talkId": "6410901",
            "initDialog": "641090101",
            "dialogues": [
                {
                    "id": "641090101",
                    "speaker": "奥乌兹",
                    "text": "你好，有什么需要帮助的吗？"
                }
            ]
        },
        {
            "talkId": "6410902",
            "initDialog": "641090201",
            "dialogues": [
                {
                    "id": "641090201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641090202",
                    "speaker": "奥乌兹",
                    "text": "我来自「镀金旅团」，受教令院雇佣在这里做卫兵。"
                },
                {
                    "id": "641090203",
                    "speaker": "奥乌兹",
                    "text": "我自己是谁并不重要，重要的是「镀金旅团」的职责——整个须弥的佣兵行业都由我们「镀金旅团」承接，绝无二家。"
                },
                {
                    "id": "641090204",
                    "speaker": "奥乌兹",
                    "text": "请你一定牢记这一点，避免被来头不明的人骗取佣金。"
                },
                {
                    "id": "641090205",
                    "speaker": "奥乌兹",
                    "text": "在奥摩斯港，如果你需要身手好又靠谱的保镖或者守卫，就请找我们的队长费罗兹吧。"
                },
                {
                    "id": "641090206",
                    "speaker": "奥乌兹",
                    "text": "他虽然说话有点粗，但会给你介绍个好人手的。"
                }
            ]
        },
        {
            "talkId": "6410903",
            "initDialog": "641090301",
            "dialogues": [
                {
                    "id": "641090301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641090302",
                    "speaker": "奥乌兹",
                    "text": "再见。"
                }
            ]
        }
    ]
}