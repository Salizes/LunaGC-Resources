        {
            "talkId": "6508801",
            "initDialog": "650880101",
            "dialogues": [
                {
                    "id": "650880101",
                    "speaker": "伊梅娜",
                    "text": "文件都整理得很清晰，不需要我费功夫了。"
                }
            ]
        },
        {
            "talkId": "6508802",
            "initDialog": "650880201",
            "dialogues": [
                {
                    "id": "650880201",
                    "speaker": "Player",
                    "text": "什么文件？"
                },
                {
                    "id": "650880202",
                    "speaker": "伊梅娜",
                    "text": "啊…是一些梅洛彼得堡和沫芒宫之间的沟通信息，我负责整理并转交给最高审判官大人。"
                },
                {
                    "id": "650880203",
                    "speaker": "伊梅娜",
                    "text": "不过梅洛彼得堡交上来的书面文件一直很完美，我基本只需要下去、上来、再递交就可以了。"
                },
                {
                    "id": "650880204",
                    "speaker": "伊梅娜",
                    "text": "偶尔还能在那边的特许食堂抽到一顿好吃的饭，难怪上一任退休的前辈说这是份怎么都不会出错的工作呢。"
                }
            ]
        },
        {
            "talkId": "6508804",
            "initDialog": "650880401",
            "dialogues": [
                {
                    "id": "650880401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650880402",
                    "speaker": "伊梅娜",
                    "text": "再见，祝你也一切顺利。"
                }
            ]
        }
    ]
}