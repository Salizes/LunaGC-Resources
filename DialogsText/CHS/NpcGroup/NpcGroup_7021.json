            "initDialog": "670210101",
            "dialogues": [
                {
                    "id": "670210101",
                    "speaker": "契切林",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6702102",
            "initDialog": "670210201",
            "dialogues": [
                {
                    "id": "670210201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "670210202",
                    "speaker": "契切林",
                    "text": "看门的。"
                }
            ]
        },
        {
            "talkId": "6702103",
            "initDialog": "670210301",
            "dialogues": [
                {
                    "id": "670210301",
                    "speaker": "Player",
                    "text": "这里是仓库吗？"
                },
                {
                    "id": "670210302",
                    "speaker": "契切林",
                    "text": "是。"
                }
            ]
        },
        {
            "talkId": "6702104",
            "initDialog": "670210401",
            "dialogues": [
                {
                    "id": "670210401",
                    "speaker": "Player",
                    "text": "不打扰了…"
                },
                {
                    "id": "670210402",
                    "speaker": "契切林",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6702105",
            "initDialog": "670210501",
            "dialogues": [
                {
                    "id": "670210501",
                    "speaker": "Player",
                    "text": "你不太像是个看门的…"
                },
                {
                    "id": "670210502",
                    "speaker": "契切林",
                    "text": "没人长得像是看门的。"
                },
                {
                    "id": "670210503",
                    "speaker": "契切林",
                    "text": "这里没什么好看的，请去别处吧。"
                }
            ]
        },
        {
            "talkId": "6702106",
            "initDialog": "670210601",
            "dialogues": [
                {
                    "id": "670210601",
                    "speaker": "Player",
                    "text": "仓库里是什么？"
                },
                {
                    "id": "670210602",
                    "speaker": "契切林",
                    "text": "无可奉告。"
                },
                {
                    "id": "670210603",
                    "speaker": "契切林",
                    "text": "这里没什么好看的，请去别处吧。"
                }
            ]
        },
        {
            "talkId": "6702107",
            "initDialog": "670210701",
            "dialogues": [
                {
                    "id": "670210701",
                    "speaker": "Player",
                    "text": "周围…好像也没发生什么事…"
                },
                {
                    "id": "670210702",
                    "speaker": "契切林",
                    "text": "…是的，这里不靠海，就不会翻起特别的浪，请去别处吧。"
                }
            ]
        },
        {
            "talkId": "6702108",
            "initDialog": "670210801",
            "dialogues": [
                {
                    "id": "670210801",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>奈芙尔</color>似乎有话要说…？）"
                },
                {
                    "id": "670210802",
                    "speaker": "奈芙尔",
                    "text": "契切林先生，最近还好么？"
                },
                {
                    "id": "670210803",
                    "speaker": "契切林",
                    "text": "奈芙尔老板。一切都好，劳你费心了。"
                },
                {
                    "id": "670210804",
                    "speaker": "契切林",
                    "text": "只是…和往常一样，偶尔还会梦到西格德。"
                },
                {
                    "id": "670210805",
                    "speaker": "奈芙尔",
                    "text": "要是实在太过痛苦，我可以想办法让您忘却那段记忆。"
                },
                {
                    "id": "670210806",
                    "speaker": "契切林",
                    "text": "感谢你的好意。但西格德安息前，或是死亡抢先一步带走我，我不打算将任何事忘记。"
                },
                {
                    "id": "670210807",
                    "speaker": "契切林",
                    "text": "我会找到他，我会让他安眠。如果你担心的是我会因此把自己的力量出卖给那些宝藏猎人，不，我向你保证，我不会做那种事。"
                },
                {
                    "id": "670210808",
                    "speaker": "奈芙尔",
                    "text": "那样最好。那么我就告辞了，祝您今后安好，契切林先生。"
                }
            ]
        },
        {
            "talkId": "6702109",
            "initDialog": "670210901",
            "dialogues": [
                {
                    "id": "670210901",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>奈芙尔</color>似乎有所思考…）"
                },
                {
                    "id": "670210902",
                    "speaker": "契切林",
                    "text": "……"
                },
                {
                    "id": "670210903",
                    "speaker": "奈芙尔",
                    "text": "契切林先生，最近过得怎么样？"
                },
                {
                    "id": "670210904",
                    "speaker": "契切林",
                    "text": "奈芙尔老板，多谢关心。一切如常。"
                },
                {
                    "id": "670210905",
                    "speaker": "奈芙尔",
                    "text": "嗯，一切如常，就是最好的。"
                },
                {
                    "id": "670210906",
                    "speaker": "奈芙尔",
                    "text": "祝你生活顺利，契切林先生。"
                }
            ]
        },
        {
            "talkId": "6702110",
            "initDialog": "670211001",
            "dialogues": [
                {
                    "id": "670211001",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>雅珂达</color>似乎有话要说…？）"
                },
                {
                    "id": "670211009",
                    "speaker": "雅珂达",
                    "text": "契切林，最近如何？"
                },
                {
                    "id": "670211002",
                    "speaker": "契切林",
                    "text": "你要是给奈芙尔老板传话，就直接说吧，没必要寒暄。看你们「海钩帮」的人搞这一套，总让我不舒服。"
                },
                {
                    "id": "670211003",
                    "speaker": "雅珂达",
                    "text": "你…！你再敢提一次那个名字，我就撕烂你的嘴，打断你的手脚，再绑上两块石头，丢进海里喂鱼——"
                },
                {
                    "id": "670211004",
                    "speaker": "契切林",
                    "text": "对，这种风格才更适合你们。你也是，齐娜伊达也是。"
                },
                {
                    "id": "670211005",
                    "speaker": "雅珂达",
                    "text": "呜…要不是奈姐说，只要你老老实实待着，我就不能动你，我早就…我早就…"
                },
                {
                    "id": "670211006",
                    "speaker": "契切林",
                    "text": "好了，有话直说吧，小姑娘。奈芙尔老板要我办什么事？"
                },
                {
                    "id": "670211007",
                    "speaker": "雅珂达",
                    "text": "嘁…总之，老东西，奈姐让我给你带个话，说是找到了你需要的线索，作为交换，希望你能帮忙解决帕哈岛东边的狂猎威胁。"
                },
                {
                    "id": "670211008",
                    "speaker": "契切林",
                    "text": "明白了。替我感谢奈芙尔老板，这委托我接了。"
                }
            ]
        }
    ]
}