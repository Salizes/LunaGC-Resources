{
    "groupId": "2407",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "滑头鬼": 11
    },
    "talks": [
        {
            "talkId": "6240701",
            "initDialog": "624070101",
            "dialogues": [
                {
                    "id": "624070101",
                    "speaker": "滑头鬼",
                    "text": "你好，你好！旅行者！"
                }
            ]
        },
        {
            "talkId": "6240702",
            "initDialog": "624070201",
            "dialogues": [
                {
                    "id": "624070201",
                    "speaker": "Player",
                    "text": "你在这里做什么呢？"
                },
                {
                    "id": "624070202",
                    "speaker": "滑头鬼",
                    "text": "我原本是这里的矿工，因为几年前这里的矿采空了…所以大家都搬走了。"
                },
                {
                    "id": "624070203",
                    "speaker": "滑头鬼",
                    "text": "我最近突然想起老家还有一笔财物忘了取回…可是现在山谷里已经被魔物占据了…"
                },
                {
                    "id": "624070204",
                    "speaker": "Player",
                    "text": "我可以帮你。"
                },
                {
                    "id": "624070205",
                    "speaker": "滑头鬼",
                    "text": "谢谢，谢谢，果真是侠肝义胆啊！"
                },
                {
                    "id": "624070206",
                    "speaker": "滑头鬼",
                    "text": "…对了，顺便一提…只是顺便一提，你要是在里面发现了什么宝物，别忘了通知我一声…咱们三七开…算了，对半分！"
                },
                {
                    "id": "624070207",
                    "speaker": "Player",
                    "text": "宝物？"
                },
                {
                    "id": "624070208",
                    "speaker": "滑头鬼",
                    "text": "这座矿区废弃多年，又被魔物占据。谁知道里面会藏着什么好东西呢？"
                },
                {
                    "id": "624070209",
                    "speaker": "滑头鬼",
                    "text": "如果恰巧被咱们找到了，发家致富指日可待！"
                }
            ]
        },
        {
            "talkId": "6240703",
            "initDialog": "624070301",
            "dialogues": [
                {
                    "id": "624070301",
                    "speaker": "Player",
                    "text": "这是什么地方？"
                },
                {
                    "id": "624070302",
                    "speaker": "滑头鬼",
                    "text": "这里是瑶光滩，这片地区曾经是璃月主要的矿产区。"
                },
                {
                    "id": "624070303",
                    "speaker": "滑头鬼",
                    "text": "但是因为过度开采，现在已经不剩什么矿物了…"
                },
                {
                    "id": "624070304",
                    "speaker": "滑头鬼",
                    "text": "也正因如此，这周边的镇子早已无人居住了。"
                }
            ]
        },
        {
            "talkId": "6240704",
            "initDialog": "624070401",
            "dialogues": [
                {
                    "id": "624070401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624070402",
                    "speaker": "滑头鬼",
                    "text": "再见！"
                }
            ]
        }
    ]
}