        "迪奥娜": 8
    },
    "talks": [
        {
            "talkId": "4023154",
            "initDialog": "402315401",
            "dialogues": [
                {
                    "id": "402315401",
                    "speaker": "迪奥娜",
                    "text": "原来它在这里啊。"
                },
                {
                    "id": "402315402",
                    "speaker": "派蒙",
                    "text": "迪奥娜？你怎么在这里？"
                },
                {
                    "id": "402315403",
                    "speaker": "Player",
                    "text": "居然还有暝视龙…"
                },
                {
                    "id": "402315404",
                    "speaker": "迪奥娜",
                    "text": "我也是第一次见这样的小家伙，听说是纳塔来的，真可爱啊。"
                },
                {
                    "id": "402315405",
                    "speaker": "迪奥娜",
                    "text": "艾莉丝让我到这里开一个休息处，「猫尾酒馆」的布置已经原封不动放了进来，我只需要准备饮料就行了。"
                },
                {
                    "id": "402315406",
                    "speaker": "迪奥娜",
                    "text": "趁此难得的机会，我还能把店里的酒全都换成最怪最怪的那种，保证每个人都不感兴趣。"
                },
                {
                    "id": "402315407",
                    "speaker": "派蒙",
                    "text": "原来你的抗争延续到了这里…"
                },
                {
                    "id": "402315408",
                    "speaker": "迪奥娜",
                    "text": "没错，只是猫猫们没有跟过来，它们还是更喜欢现实里的那个「猫尾酒馆」。"
                },
                {
                    "id": "402315409",
                    "speaker": "迪奥娜",
                    "text": "猫猫们对生活环境可敏感了，就算是一模一样的地方，哪怕是周围的氛围发生了变化，就会特别不适应。"
                },
                {
                    "id": "402315410",
                    "speaker": "迪奥娜",
                    "text": "于是艾莉丝对我说：「是时候找一批新的店员了！」然后这些小龙就出现了。"
                },
                {
                    "id": "402315411",
                    "speaker": "迪奥娜",
                    "text": "班尼特教会了我怎么和它们打交道，熟悉了之后感觉和猫猫狗狗也差不多嘛。"
                },
                {
                    "id": "402315412",
                    "speaker": "派蒙",
                    "text": "那这里就可以叫「龙尾酒馆」了！"
                },
                {
                    "id": "402315413",
                    "speaker": "暝视龙",
                    "text": "——♪"
                }
            ]
        }
    ]
}