    "talks": [
        {
            "talkId": "6202701",
            "initDialog": "620270101",
            "dialogues": [
                {
                    "id": "620270101",
                    "speaker": "沉香",
                    "text": "豆豆乖，我们去抓药，吃了药病才能好。"
                },
                {
                    "id": "620270102",
                    "speaker": "红豆",
                    "text": "可是不卜庐的药太苦了嘛，不去不去！"
                },
                {
                    "id": "620270103",
                    "speaker": "沉香",
                    "text": "听话，去抓药的话，你可以见到不卜庐的白术哥哥哦？"
                },
                {
                    "id": "620270104",
                    "speaker": "红豆",
                    "text": "啊白术哥哥…我、我只要看看温柔的白术哥哥，病一定就会好的！不用吃药！"
                },
                {
                    "id": "620270105",
                    "speaker": "沉香",
                    "text": "可是你不喜欢他的药，白术哥哥讨厌你了怎么办？"
                },
                {
                    "id": "620270106",
                    "speaker": "红豆",
                    "text": "那…那只抓药不吃药呢…？"
                }
            ]
        },
        {
            "talkId": "6202702",
            "initDialog": "620270201",
            "dialogues": [
                {
                    "id": "620270201",
                    "speaker": "沉香",
                    "text": "豆豆乖，我们去抓药，吃了药病才能好。"
                },
                {
                    "id": "620270202",
                    "speaker": "红豆",
                    "text": "吃了上次的药，我已经好了！不去不去！"
                },
                {
                    "id": "620270203",
                    "speaker": "沉香",
                    "text": "稍微好了一点就不吃药，病情会反复的。而且，去抓药的话，你还能见到白术哥哥哦？"
                },
                {
                    "id": "620270204",
                    "speaker": "红豆",
                    "text": "啊白术哥哥…我、我只要看看温柔的白术哥哥，病一定就会好的！药那么苦，不要吃药！"
                },
                {
                    "id": "620270205",
                    "speaker": "沉香",
                    "text": "可是你不喜欢他的药，白术哥哥讨厌你了怎么办？"
                },
                {
                    "id": "620270206",
                    "speaker": "红豆",
                    "text": "那…那只抓药不吃药呢…？"
                }
            ]
        },
        {
            "talkId": "7202701",
            "initDialog": "720270101",
            "dialogues": [
                {
                    "id": "720270101",
                    "speaker": "沉香",
                    "text": "你用霄灯许愿了吗？"
                },
                {
                    "id": "720270102",
                    "speaker": "沉香",
                    "text": "今年我的愿望还是想要女儿红豆可以健健康康…"
                },
                {
                    "id": "720270103",
                    "speaker": "沉香",
                    "text": "她实在太体弱多病了唉…"
                }
            ]
        }
    ]
}