{
    "groupId": "13356",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "拉米雅": 12
    },
    "talks": [
        {
            "talkId": "7370302",
            "initDialog": "737030201",
            "dialogues": [
                {
                    "id": "737030201",
                    "speaker": "拉米雅",
                    "text": "又多了两个「铭随流镜」使用者的数据，呵呵，如果测试数据又多又好，那么很快就能进行发布…"
                },
                {
                    "id": "737030202",
                    "speaker": "拉米雅",
                    "text": "#嗯？{NICKNAME}，怎么了，有什么和实验…和挑战游戏有关的问题要问吗？"
                }
            ]
        },
        {
            "talkId": "7370303",
            "initDialog": "737030301",
            "dialogues": [
                {
                    "id": "737030301",
                    "speaker": "Player",
                    "text": "既然运用了虚空…"
                },
                {
                    "id": "737030302",
                    "speaker": "拉米雅",
                    "text": "哦？你是想问，明明已经是用虚空的技术，为什么还要使用「铭随流镜」，是吧。"
                },
                {
                    "id": "737030303",
                    "speaker": "拉米雅",
                    "text": "因为动物的思考能力和人的思考能力不太一致，现阶段直接利用虚空接入的话会有较高的风险。"
                },
                {
                    "id": "737030304",
                    "speaker": "拉米雅",
                    "text": "而且，因为接入的也只有视觉，眼前是小动物们看到的场景，但是活动起来的仍然是自己的手脚…"
                },
                {
                    "id": "737030305",
                    "speaker": "拉米雅",
                    "text": "你想，如果接入的是鸟类视觉，飞行视角中，很难控制自己本体看到高空情境时的下意识动作，一定会造成一些事故…"
                },
                {
                    "id": "737030306",
                    "speaker": "拉米雅",
                    "text": "呵呵，所以现阶段还是利用镜子会比较好吧。"
                }
            ]
        },
        {
            "talkId": "7370304",
            "initDialog": "737030401",
            "dialogues": [
                {
                    "id": "737030401",
                    "speaker": "Player",
                    "text": "关于「铭随流镜」的使用…"
                },
                {
                    "id": "737030402",
                    "speaker": "拉米雅",
                    "text": "嗯，首先得把「铭随流镜」拿在手上，触发装置的反应。"
                },
                {
                    "id": "737030403",
                    "speaker": "拉米雅",
                    "text": "镜子上也能够显现出动物视角的画面了。"
                },
                {
                    "id": "737030404",
                    "speaker": "拉米雅",
                    "text": "不过当然是经过修正的，并不是每种动物眼中的世界都会和我们一样…但毕竟还是要供人使用的，所以画面也经过了调整。"
                },
                {
                    "id": "737030405",
                    "speaker": "拉米雅",
                    "text": "呵呵，妙论派的人就不用考虑这些事，真好呢…"
                }
            ]
        },
        {
            "talkId": "7370305",
            "initDialog": "737030501",
            "dialogues": [
                {
                    "id": "737030501",
                    "speaker": "Player",
                    "text": "不，没有什么问题。"
                },
                {
                    "id": "737030502",
                    "speaker": "拉米雅",
                    "text": "呵呵，那就希望你们能顺利完成挑战游戏…不，为了测试的数据，请你们务必完成挑战游戏！"
                }
            ]
        }
    ]
}