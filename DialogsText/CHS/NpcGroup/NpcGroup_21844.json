{
    "groupId": "21844",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 4,
        "温迪": 3,
        "班尼特": 19
    },
    "talks": [
        {
            "talkId": "1504453",
            "initDialog": "150445303",
            "dialogues": [
                {
                    "id": "150445303",
                    "speaker": "班尼特",
                    "text": "既没有遇见倒霉事，也没有碰见太大的麻烦…吃的好，玩的也好…"
                },
                {
                    "id": "150445304",
                    "speaker": "班尼特",
                    "text": "最重要的是，还认识了很多好朋友。"
                },
                {
                    "id": "150445305",
                    "speaker": "班尼特",
                    "text": "嘿嘿，我要回去把这些都告诉老爹们，他们肯定会被吓一跳的！"
                }
            ]
        },
        {
            "talkId": "1504558",
            "initDialog": "150455801",
            "dialogues": [
                {
                    "id": "150455801",
                    "speaker": "班尼特",
                    "text": "温迪老师，我终于明白了…"
                },
                {
                    "id": "150455802",
                    "speaker": "温迪",
                    "text": "噢？明白什么？"
                },
                {
                    "id": "150455803",
                    "speaker": "班尼特",
                    "text": "你的诗歌。自天幕降下的恒久光芒，指的并不是星光…"
                },
                {
                    "id": "150455804",
                    "speaker": "温迪",
                    "text": "嘘…把它藏在你心中吧。比起谜题或者答案，诗歌更像是风。只要你体会得到它，它就一直存在。"
                },
                {
                    "id": "150455805",
                    "speaker": "班尼特",
                    "text": "嗯…谢谢你为我做的一切。"
                },
                {
                    "id": "150455806",
                    "speaker": "温迪",
                    "text": "期待你写出更棒的诗噢，班尼特同学。"
                }
            ]
        },
        {
            "talkId": "1504560",
            "initDialog": "150456001",
            "dialogues": [
                {
                    "id": "150456001",
                    "speaker": "班尼特",
                    "text": "#{NICKNAME}，谢谢你和我一同经历了这场冒险。",
                    "choices": [
                        {
                            "id": "150456002",
                            "text": "关于悠悠度假村…",
                            "response": [
                                {
                                    "id": "150456003",
                                    "speaker": "班尼特",
                                    "text": "温暖的海岛，迷人的篝火，有趣的游乐项目和无忧无虑的派对…"
                                },
                                {
                                    "id": "150456004",
                                    "speaker": "班尼特",
                                    "text": "这里太神奇了，美好得就像一场梦。"
                                },
                                {
                                    "id": "150456005",
                                    "speaker": "班尼特",
                                    "text": "但因为我知道它是真实发生的事，鼻子又会一酸…哈哈，这一定就是「幸福」的感觉吧。"
                                },
                                {
                                    "id": "150456006",
                                    "speaker": "班尼特",
                                    "text": "我遇见了最亲的人和最好的朋友们，度过了一个不想结束的夏天…"
                                },
                                {
                                    "id": "150456007",
                                    "speaker": "班尼特",
                                    "text": "我真是天底下最幸运的人。"
                                }
                            ]
                        },
                        {
                            "id": "150456008",
                            "text": "关于返程的计划…",
                            "response": [
                                {
                                    "id": "150456009",
                                    "speaker": "班尼特",
                                    "text": "我给老爹们和蒙德的大家选好了礼物，原本以为包裹够塞，结果新买了一个大拎包才勉强装下…"
                                },
                                {
                                    "id": "150456010",
                                    "speaker": "班尼特",
                                    "text": "我还买了一瓶浓缩蜜露，打算回蒙德后，请迪奥娜制成蒲公英风味的饮品，送给温迪老师。"
                                },
                                {
                                    "id": "150456011",
                                    "speaker": "班尼特",
                                    "text": "…迪奥娜，杜拉夫先生！我怎么把杜拉夫先生的礼物给漏了…哎呀，我得再去一次悠悠集市。"
                                }
                            ]
                        },
                        {
                            "id": "150456012",
                            "text": "关于欧洛伦和伊法…",
                            "response": [
                                {
                                    "id": "150456013",
                                    "speaker": "班尼特",
                                    "text": "噢，你说他们呀！伊法先生请我帮忙时我还担心了半天，说我学不来莫娜小姐水占术的那套，真要演会演出破绽的。"
                                },
                                {
                                    "id": "150456014",
                                    "speaker": "班尼特",
                                    "text": "结果他说「会转树枝就行」，剩下的交给他来圆…"
                                },
                                {
                                    "id": "150456015",
                                    "speaker": "班尼特",
                                    "text": "听说后来玩得特别热闹，我也为他们还有咔库库开心！"
                                }
                            ]
                        },
                        {
                            "id": "150456016",
                            "text": "祝你好运。",
                            "response": [
                                {
                                    "id": "150456017",
                                    "speaker": "班尼特",
                                    "text": "嗯，也祝你旅途顺利。我会期待着，某天能和你在新的冒险路上偶遇！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}