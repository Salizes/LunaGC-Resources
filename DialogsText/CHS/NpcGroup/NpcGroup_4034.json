{
    "groupId": "4034",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 2,
        "哈尔瓦": 10,
        "沙班达尔": 5
    },
    "talks": [
        {
            "talkId": "6403301",
            "initDialog": "640330101",
            "dialogues": [
                {
                    "id": "640330101",
                    "speaker": "沙班达尔",
                    "text": "哈尔瓦，你是不是又放宽对商户们的税收标准了？"
                },
                {
                    "id": "640330102",
                    "speaker": "沙班达尔",
                    "text": "我说过，不要怕那些商人们提出异议。对付他们一定要有耐心，软硬兼施…"
                },
                {
                    "id": "640330103",
                    "speaker": "哈尔瓦",
                    "text": "呃，恕我直言，我认为不是这个问题…"
                },
                {
                    "id": "640330104",
                    "speaker": "哈尔瓦",
                    "text": "我们征收的税费大多成为了学者们的研究经费，而教令院其实并不缺钱。"
                },
                {
                    "id": "640330105",
                    "speaker": "哈尔瓦",
                    "text": "但对商人们逼得太紧反而不利于商业的正常流动，所以税收宽泛一点并没有坏处…"
                },
                {
                    "id": "640330106",
                    "speaker": "沙班达尔",
                    "text": "幼稚的想法！你的工作是什么？是征收税费，而不是推动商业。"
                },
                {
                    "id": "640330107",
                    "speaker": "沙班达尔",
                    "text": "至于商业的事情，自有其他的调节办法，不是我们港务官该操心的。"
                },
                {
                    "id": "640330108",
                    "speaker": "沙班达尔",
                    "text": "你还在实习，要先把本职工作做好，明白了吗？"
                },
                {
                    "id": "640330109",
                    "speaker": "哈尔瓦",
                    "text": "好、好的…"
                }
            ]
        },
        {
            "talkId": "6403401",
            "initDialog": "640340101",
            "dialogues": [
                {
                    "id": "640340101",
                    "speaker": "哈尔瓦",
                    "text": "哼哼，今天店里又到了什么新货呢~？"
                }
            ]
        },
        {
            "talkId": "6403402",
            "initDialog": "640340201",
            "dialogues": [
                {
                    "id": "640340201",
                    "speaker": "Player",
                    "text": "你在挑选珠宝？"
                },
                {
                    "id": "640340202",
                    "speaker": "哈尔瓦",
                    "text": "啊，没有没有。与其说是挑选，我只是在欣赏啦，欣赏。"
                },
                {
                    "id": "640340203",
                    "speaker": "哈尔瓦",
                    "text": "虽然我还只是个实习税务员，买不起这些，但能看看这些亮晶晶的漂亮东西，也会心情愉快的。"
                },
                {
                    "id": "640340204",
                    "speaker": "哈尔瓦",
                    "text": "呼…每天上班都在被上司训斥不成熟，令人怀疑自我…"
                },
                {
                    "id": "640340205",
                    "speaker": "哈尔瓦",
                    "text": "所以不工作的时候，就让我看看喜欢的东西，放空一下吧。"
                }
            ]
        },
        {
            "talkId": "6403403",
            "initDialog": "640340301",
            "dialogues": [
                {
                    "id": "640340301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640340302",
                    "speaker": "哈尔瓦",
                    "text": "再见，我还要再逛一会儿。"
                }
            ]
        }
    ]
}