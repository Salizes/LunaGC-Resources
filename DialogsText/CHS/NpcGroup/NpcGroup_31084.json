{
    "groupId": "31084",
    "total_dialogue_lines": 52,
    "speaker_counts": {
        "Player": 12,
        "夏沃蕾": 31,
        "蒂蕾娜": 9
    },
    "talks": [
        {
            "talkId": "7668303",
            "initDialog": "766830301",
            "dialogues": [
                {
                    "id": "766830301",
                    "speaker": "夏沃蕾",
                    "text": "#感觉怎么样，{NICKNAME}？找到充分利用每发弹药的灵感了吗？",
                    "choices": [
                        {
                            "id": "766830302",
                            "text": "好像有，但平时不太用得到？",
                            "response": [
                                {
                                    "id": "766830303",
                                    "speaker": "夏沃蕾",
                                    "text": "多一项技能，就多一项选择，说不定，之后你偶尔会遇到特殊的环境，导致习惯的战斗技巧受到限制。"
                                },
                                {
                                    "id": "766830304",
                                    "speaker": "夏沃蕾",
                                    "text": "到时候，使用铳枪这类远程投射武器战斗，不失为一种选择。",
                                    "choices": [
                                        {
                                            "id": "766830305",
                                            "text": "好像也有道理。",
                                            "response": [
                                                {
                                                    "id": "766830307",
                                                    "speaker": "夏沃蕾",
                                                    "text": "不，不必用「请教」这种字眼，应该说交流心得。"
                                                },
                                                {
                                                    "id": "766830308",
                                                    "speaker": "夏沃蕾",
                                                    "text": "蒂蕾娜向我描述过你以前射击的表现，我觉得，你也完全能成为全提瓦特最顶尖的射手，打出新的远射记录。"
                                                },
                                                {
                                                    "id": "766830309",
                                                    "speaker": "夏沃蕾",
                                                    "text": "当然，实战射击、城区战斗和靶场挑战，有着截然不同的特性。"
                                                },
                                                {
                                                    "id": "766830310",
                                                    "speaker": "夏沃蕾",
                                                    "text": "你多用几回铳枪，找到其中的奥秘，绝对不在话下。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766830306",
                                            "text": "那我要多来请教你。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766830311",
                            "text": "先说说和纳塔朋友相处得如何？",
                            "response": [
                                {
                                    "id": "766830312",
                                    "speaker": "夏沃蕾",
                                    "text": "那我直言不讳了。"
                                },
                                {
                                    "id": "766830313",
                                    "speaker": "夏沃蕾",
                                    "text": "我想招募恰斯卡小姐，目前预期的底薪是每年六千万摩拉。",
                                    "choices": [
                                        {
                                            "id": "766830314",
                                            "text": "多少？",
                                            "response": [
                                                {
                                                    "id": "766830316",
                                                    "speaker": "夏沃蕾",
                                                    "text": "没口误，就是这个数字。"
                                                },
                                                {
                                                    "id": "766830317",
                                                    "speaker": "夏沃蕾",
                                                    "text": "以执律庭的经验来看，想要打造一种机关，拥有与恰斯卡小姐相当的机动性与火力…"
                                                },
                                                {
                                                    "id": "766830318",
                                                    "speaker": "夏沃蕾",
                                                    "text": "可能需要上百亿摩拉的预算，分属多家机构的数千名工程师，以及十年以上的技术攻关、研发与测试过程，还未必能成功。"
                                                },
                                                {
                                                    "id": "766830319",
                                                    "speaker": "夏沃蕾",
                                                    "text": "恰斯卡小姐和她的灵枪，说是「飞在天上的摩拉保险箱」，都不为过。"
                                                },
                                                {
                                                    "id": "766830320",
                                                    "speaker": "夏沃蕾",
                                                    "text": "看她打击标靶时，我会自动把她开的每一枪，换算成普通铳枪和火炮的成本…"
                                                },
                                                {
                                                    "id": "766830321",
                                                    "speaker": "夏沃蕾",
                                                    "text": "从效能来说，可以用，开这个年薪的话，我们实在太赚了。划算程度甚至要让黑心商人叹为观止。",
                                                    "choices": [
                                                        {
                                                            "id": "766830322",
                                                            "text": "这好像也不是摩拉的问题了…",
                                                            "response": [
                                                                {
                                                                    "id": "766830324",
                                                                    "speaker": "夏沃蕾",
                                                                    "text": "我明白。她还是纳塔的「古名」持有者，纳塔整个国家的重要人物之一。"
                                                                },
                                                                {
                                                                    "id": "766830325",
                                                                    "speaker": "夏沃蕾",
                                                                    "text": "所以我也只能和你表达一下意愿。"
                                                                },
                                                                {
                                                                    "id": "766830326",
                                                                    "speaker": "夏沃蕾",
                                                                    "text": "我会思考其他的方法，尽可能向恰斯卡小姐借用力量，让特巡队的能力发展得更为全面。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766830323",
                                                            "text": "她有在「花羽会」的职责哦。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766830315",
                                            "text": "是不是把百说成了千？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766830327",
                            "text": "有没有什么工作外的话题？",
                            "response": [
                                {
                                    "id": "766830328",
                                    "speaker": "夏沃蕾",
                                    "text": "问得好。"
                                },
                                {
                                    "id": "766830329",
                                    "speaker": "夏沃蕾",
                                    "text": "我觉得，恰斯卡小姐十分适合出演犯罪题材的映影，而且绝对要在女主角的位置上…"
                                },
                                {
                                    "id": "766830330",
                                    "speaker": "夏沃蕾",
                                    "text": "嗯，带有悬疑色彩的超常冒险也挺不错。比如探查遗迹，发掘古老的力量，与神秘势力开展周旋…"
                                },
                                {
                                    "id": "766830331",
                                    "speaker": "夏沃蕾",
                                    "text": "下次再见到泽维尔导演的时候，我要和他简单说说这个想法。"
                                }
                            ]
                        },
                        {
                            "id": "766830332",
                            "text": "我再去找找。",
                            "response": [
                                {
                                    "id": "766830333",
                                    "speaker": "夏沃蕾",
                                    "text": "嗯，切勿心急。仔细感受铳枪机件的运转，观察曳光弹道和命中的信号…灵光闪烁的那一瞬间迟早会找上你的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7668403",
            "initDialog": "766840301",
            "dialogues": [
                {
                    "id": "766840301",
                    "speaker": "蒂蕾娜",
                    "text": "队长，你刚刚说的是认真的吗？",
                    "choices": [
                        {
                            "id": "766840302",
                            "text": "（继续听听看…）",
                            "response": [
                                {
                                    "id": "766840303",
                                    "speaker": "蒂蕾娜",
                                    "text": "我也要被绒翼龙抓着在天上飞吗？"
                                },
                                {
                                    "id": "766840304",
                                    "speaker": "夏沃蕾",
                                    "text": "对。"
                                },
                                {
                                    "id": "766840305",
                                    "speaker": "蒂蕾娜",
                                    "text": "我还要练习在天上操纵铳枪，在高速移动中射击地面的目标？"
                                },
                                {
                                    "id": "766840306",
                                    "speaker": "夏沃蕾",
                                    "text": "对。"
                                },
                                {
                                    "id": "766840307",
                                    "speaker": "蒂蕾娜",
                                    "text": "那…加薪吗？"
                                },
                                {
                                    "id": "766840308",
                                    "speaker": "夏沃蕾",
                                    "text": "加。"
                                },
                                {
                                    "id": "766840309",
                                    "speaker": "蒂蕾娜",
                                    "text": "我干！"
                                },
                                {
                                    "id": "766840310",
                                    "speaker": "蒂蕾娜",
                                    "text": "其实就算不加薪，我也会干。钱从来不是问题，特巡队员的尊严才是。"
                                },
                                {
                                    "id": "766840311",
                                    "speaker": "蒂蕾娜",
                                    "text": "「花羽会」的龙骑士们能做到，我也不想认输！"
                                },
                                {
                                    "id": "766840312",
                                    "speaker": "夏沃蕾",
                                    "text": "其实我知道，不加薪你也会答应，但我不想亏待任何一个队员。所以，除了加薪，还会有一系列额外保险措施和津贴。"
                                },
                                {
                                    "id": "766840313",
                                    "speaker": "夏沃蕾",
                                    "text": "为了保证你们拥有充足的体力，应对更恶劣的作战环境，我会给你们再增加针对性的体能训练。"
                                },
                                {
                                    "id": "766840314",
                                    "speaker": "夏沃蕾",
                                    "text": "先从十万步的负重跑开始吧。"
                                },
                                {
                                    "id": "766840315",
                                    "speaker": "蒂蕾娜",
                                    "text": "我…我跑，我一定好好跑。"
                                },
                                {
                                    "id": "766840316",
                                    "speaker": "蒂蕾娜",
                                    "text": "在天上挂着，确实很消耗体能吧？那这次的十万步，我就背五十单位的负重？"
                                },
                                {
                                    "id": "766840317",
                                    "speaker": "夏沃蕾",
                                    "text": "…我本来想说三十五单位的。"
                                },
                                {
                                    "id": "766840318",
                                    "speaker": "夏沃蕾",
                                    "text": "但你既然主动提出五十单位，那勒泰利埃也按这个标准来好了，然后再看看其他人承不承受得了。"
                                }
                            ]
                        },
                        {
                            "id": "766840319",
                            "text": "（还是不听了…）"
                        }
                    ]
                }
            ]
        }
    ]
}