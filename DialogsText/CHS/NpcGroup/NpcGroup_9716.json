    "talks": [
        {
            "talkId": "6971601",
            "initDialog": "697160101",
            "dialogues": [
                {
                    "id": "697160101",
                    "speaker": "小六",
                    "text": "看起来很像冒险家的人…你也是牌手吗？"
                },
                {
                    "id": "697160102",
                    "speaker": "小六",
                    "text": "那就来和我比一比，看看谁更厉害吧！"
                }
            ]
        },
        {
            "talkId": "6971602",
            "initDialog": "697160201",
            "dialogues": [
                {
                    "id": "697160201",
                    "speaker": "Player",
                    "text": "来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6971603",
            "initDialog": "697160301",
            "dialogues": [
                {
                    "id": "697160301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "697160302",
                    "speaker": "小六",
                    "text": "好吧，那我再去找其他人练一练。反正要成为世界第一牌手，迟早要打遍所有人！"
                }
            ]
        },
        {
            "talkId": "6971604",
            "initDialog": "697160401",
            "dialogues": [
                {
                    "id": "697160401",
                    "speaker": "小六",
                    "text": "嘿呀！我离世界第一牌手的距离更近了！不过，你也不要丧气哦！"
                }
            ]
        },
        {
            "talkId": "6971605",
            "initDialog": "697160501",
            "dialogues": [
                {
                    "id": "697160501",
                    "speaker": "小六",
                    "text": "没什么了不起的！你只是…打牌的时间比我长罢了！"
                }
            ]
        }
    ]
}