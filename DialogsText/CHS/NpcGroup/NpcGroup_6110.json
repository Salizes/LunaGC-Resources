{
    "groupId": "6110",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "亚瓦尔": 11
    },
    "talks": [
        {
            "talkId": "6611001",
            "initDialog": "661100101",
            "dialogues": [
                {
                    "id": "661100101",
                    "speaker": "亚瓦尔",
                    "text": "站在高处的人总是盯着脚下，反而容易忽略头顶呢。要小心哦。"
                }
            ]
        },
        {
            "talkId": "6611002",
            "initDialog": "661100201",
            "dialogues": [
                {
                    "id": "661100201",
                    "speaker": "Player",
                    "text": "这里是事故高发区？"
                },
                {
                    "id": "661100202",
                    "speaker": "亚瓦尔",
                    "text": "对，是这个意思。"
                },
                {
                    "id": "661100203",
                    "speaker": "亚瓦尔",
                    "text": "你看这附近的悬崖，几乎没什么围栏。"
                },
                {
                    "id": "661100204",
                    "speaker": "亚瓦尔",
                    "text": "我们本地的居民还好，已经习惯了被匿叶龙捞来捞去了。"
                },
                {
                    "id": "661100205",
                    "speaker": "亚瓦尔",
                    "text": "你要是听到有人砰的一声踩空，紧接着又开始哇哇乱叫，那多半就是外面来的朋友了。"
                }
            ]
        },
        {
            "talkId": "6611003",
            "initDialog": "661100301",
            "dialogues": [
                {
                    "id": "661100301",
                    "speaker": "Player",
                    "text": "多谢提醒。"
                },
                {
                    "id": "661100302",
                    "speaker": "亚瓦尔",
                    "text": "不用客气。"
                }
            ]
        },
        {
            "talkId": "6611004",
            "initDialog": "661100401",
            "dialogues": [
                {
                    "id": "661100401",
                    "speaker": "Player",
                    "text": "会受伤吗？"
                },
                {
                    "id": "661100402",
                    "speaker": "亚瓦尔",
                    "text": "一般来说，也就是一些细小的擦伤吧。"
                },
                {
                    "id": "661100403",
                    "speaker": "亚瓦尔",
                    "text": "真正会受重伤的，反而是我们这里最喜欢搞极限运动、挑战自我的那些人。"
                },
                {
                    "id": "661100404",
                    "speaker": "亚瓦尔",
                    "text": "哎，悄悄跟你说，要是看到有人受了严重的伤又没有别的去处，可以先送到我这来。"
                },
                {
                    "id": "661100405",
                    "speaker": "亚瓦尔",
                    "text": "我懂一些急救技巧。但请不要告诉其他人哦！"
                },
                {
                    "id": "661100406",
                    "speaker": "亚瓦尔",
                    "text": "那些喜欢乱来的人要是知道有人能救他们，一定会玩得更疯的。"
                }
            ]
        }
    ]
}