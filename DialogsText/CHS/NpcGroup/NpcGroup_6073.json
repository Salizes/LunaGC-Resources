{
    "groupId": "6073",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 2,
        "库珀·努伊": 10,
        "瓦凯·努伊": 4
    },
    "talks": [
        {
            "talkId": "6607206",
            "initDialog": "660720601",
            "dialogues": [
                {
                    "id": "660720601",
                    "speaker": "瓦凯·努伊",
                    "text": "老妈，这么多年来，您就没有过劝大家一起把家族事业做大的想法吗？"
                },
                {
                    "id": "660720602",
                    "speaker": "库珀·努伊",
                    "text": "嗯？孩子，你为什么会有这样的疑问呢，大家都有自己的事情要做，难道不算是事业吗？"
                },
                {
                    "id": "660720603",
                    "speaker": "瓦凯·努伊",
                    "text": "不，我不是指现在各自为营的这种，我是说，大家齐心协力，共同进步…"
                },
                {
                    "id": "660720604",
                    "speaker": "库珀·努伊",
                    "text": "哦哦。那你如果有什么想法的话，可以跟大家提嘛。"
                },
                {
                    "id": "660720605",
                    "speaker": "瓦凯·努伊",
                    "text": "唉…我的号召力，还是差了一点…好像，大伙儿都挺满意现状的…"
                },
                {
                    "id": "660720606",
                    "speaker": "库珀·努伊",
                    "text": "哦哦，这样啊。那你应该为他们开心呀。"
                },
                {
                    "id": "660720607",
                    "speaker": "瓦凯·努伊",
                    "text": "可是，我有些难过啊…我的跨国旅游公司，什么时候才能有第二个成员加入呢…"
                }
            ]
        },
        {
            "talkId": "6607301",
            "initDialog": "660730101",
            "dialogues": [
                {
                    "id": "660730101",
                    "speaker": "库珀·努伊",
                    "text": "欢迎光临「黄金傍晚」。"
                }
            ]
        },
        {
            "talkId": "6607302",
            "initDialog": "660730201",
            "dialogues": [
                {
                    "id": "660730201",
                    "speaker": "Player",
                    "text": "关于「黄金傍晚」…"
                },
                {
                    "id": "660730202",
                    "speaker": "库珀·努伊",
                    "text": "这里啊，地理位置很不错吧？"
                },
                {
                    "id": "660730203",
                    "speaker": "库珀·努伊",
                    "text": "以前只是我家的一间老房子，后来阿米娜首领建议我把这个风景绝佳的地方改作餐厅。"
                },
                {
                    "id": "660730204",
                    "speaker": "库珀·努伊",
                    "text": "真是个好主意。餐厅开业后生意一直不错，无论是本地人还是游客，都喜欢坐在海边喝一杯。"
                },
                {
                    "id": "660730205",
                    "speaker": "库珀·努伊",
                    "text": "唯一美中不足的就是，虽然我家人数不少，但愿意留在店里帮忙的不多。"
                },
                {
                    "id": "660730206",
                    "speaker": "库珀·努伊",
                    "text": "所以我很推荐大家自助就餐，自己带食材来烹饪都可以，不收取任何额外费用哦。"
                }
            ]
        },
        {
            "talkId": "6607303",
            "initDialog": "660730301",
            "dialogues": [
                {
                    "id": "660730301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660730302",
                    "speaker": "库珀·努伊",
                    "text": "慢走，小心脚下。"
                }
            ]
        }
    ]
}