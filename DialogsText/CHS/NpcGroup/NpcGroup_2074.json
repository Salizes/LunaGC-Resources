{
    "groupId": "2074",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "小蒙": 3,
        "璐璐": 7,
        "阿飞": 8
    },
    "talks": [
        {
            "talkId": "6207402",
            "initDialog": "620740201",
            "dialogues": [
                {
                    "id": "620740201",
                    "speaker": "阿飞",
                    "text": "小蒙为什么突然想去须弥旅行了…"
                },
                {
                    "id": "620740202",
                    "speaker": "璐璐",
                    "text": "说不定他只是想出去逛逛呢。"
                },
                {
                    "id": "620740203",
                    "speaker": "阿飞",
                    "text": "欸？是这样吗？真好啊…我也想出去玩…"
                }
            ]
        },
        {
            "talkId": "6207401",
            "initDialog": "620740101",
            "dialogues": [
                {
                    "id": "620740101",
                    "speaker": "璐璐",
                    "text": "万里波涛号，扬帆起航！"
                },
                {
                    "id": "620740102",
                    "speaker": "小蒙",
                    "text": "风浪好大哇！我的货物和金子都要翻进海里啦！服务生，服务生！"
                },
                {
                    "id": "620740103",
                    "speaker": "璐璐",
                    "text": "服务生，服务生！快去帮忙，不然…不然我…就把你踢进海里去！"
                },
                {
                    "id": "620740104",
                    "speaker": "阿飞",
                    "text": "…"
                },
                {
                    "id": "620740105",
                    "speaker": "璐璐",
                    "text": "服务生，服务生！"
                },
                {
                    "id": "620740106",
                    "speaker": "阿飞",
                    "text": "…我不想玩了，每次都是我扮服务生…"
                },
                {
                    "id": "620740107",
                    "speaker": "璐璐",
                    "text": "那你要扮什么？"
                },
                {
                    "id": "620740108",
                    "speaker": "阿飞",
                    "text": "…我要扮北斗大人…"
                },
                {
                    "id": "620740109",
                    "speaker": "阿飞",
                    "text": "帅气的北斗大人每次都是璐璐扮，我也想扮一次！"
                },
                {
                    "id": "620740110",
                    "speaker": "璐璐",
                    "text": "那是因为我是女孩子，而且年纪最大！"
                },
                {
                    "id": "620740111",
                    "speaker": "阿飞",
                    "text": "我…我个子最高！而且不管男孩子女孩子…盖上一只眼不都一样！"
                },
                {
                    "id": "620740112",
                    "speaker": "小蒙",
                    "text": "哪里能一样啦，你都没有那个…气质！"
                },
                {
                    "id": "620740113",
                    "speaker": "阿飞",
                    "text": "呜呜…"
                },
                {
                    "id": "620740114",
                    "speaker": "小蒙",
                    "text": "哇，阿飞又哭鼻子了…"
                },
                {
                    "id": "620740115",
                    "speaker": "璐璐",
                    "text": "好啦好啦…就让你扮一次吧？"
                }
            ]
        }
    ]
}