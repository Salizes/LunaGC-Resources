{
    "groupId": "4057",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "胡尚": 7
    },
    "talks": [
        {
            "talkId": "6405701",
            "initDialog": "640570101",
            "dialogues": [
                {
                    "id": "640570101",
                    "speaker": "胡尚",
                    "text": "要是我可以打入璃月市场…"
                }
            ]
        },
        {
            "talkId": "6405702",
            "initDialog": "640570201",
            "dialogues": [
                {
                    "id": "640570201",
                    "speaker": "Player",
                    "text": "你在计划什么？"
                },
                {
                    "id": "640570202",
                    "speaker": "胡尚",
                    "text": "是关于玩具销售的事情。听人说至冬的玩具在璃月卖得很好，令我有些懊悔。"
                },
                {
                    "id": "640570203",
                    "speaker": "胡尚",
                    "text": "如果我能抓住先机，将我的手工儿童玩具带到璃月，现在一定可以比至冬货更受欢迎！"
                },
                {
                    "id": "640570204",
                    "speaker": "胡尚",
                    "text": "那个冷冰冰的地方，能懂什么孩子的童心啊。"
                }
            ]
        },
        {
            "talkId": "6405703",
            "initDialog": "640570301",
            "dialogues": [
                {
                    "id": "640570301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640570302",
                    "speaker": "胡尚",
                    "text": "悔不当初啊！"
                }
            ]
        },
        {
            "talkId": "6405704",
            "initDialog": "640570401",
            "dialogues": [
                {
                    "id": "640570401",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6405705",
            "initDialog": "640570501",
            "dialogues": [
                {
                    "id": "640570501",
                    "speaker": "胡尚",
                    "text": "唉…牌有什么好玩的，来，客人，看看我制作的玩具吧…"
                }
            ]
        },
        {
            "talkId": "6405706",
            "initDialog": "640570601",
            "dialogues": [
                {
                    "id": "640570601",
                    "speaker": "胡尚",
                    "text": "赢了！不是我说，像我这种制作玩具的人和做牌的也算半个同行，更能理解他们的思路！"
                }
            ]
        }
    ]
}