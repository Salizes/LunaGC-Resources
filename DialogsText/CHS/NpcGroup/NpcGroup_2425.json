{
    "groupId": "2425",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 5,
        "阿卜": 18
    },
    "talks": [
        {
            "talkId": "7193901",
            "initDialog": "719390101",
            "dialogues": [
                {
                    "id": "719390101",
                    "speaker": "Player",
                    "text": "这个传说是真的吗？"
                },
                {
                    "id": "719390102",
                    "speaker": "阿卜",
                    "text": "与其问我，不如亲自体验一下如何？"
                },
                {
                    "id": "719390103",
                    "speaker": "阿卜",
                    "text": "这「星螺」你拿走吧，你一个人的时候可以把这个放到耳边…"
                },
                {
                    "id": "719390104",
                    "speaker": "阿卜",
                    "text": "…或许，真的能听到什么哦，呵呵…"
                }
            ]
        },
        {
            "talkId": "6242501",
            "initDialog": "624250101",
            "dialogues": [
                {
                    "id": "624250101",
                    "speaker": "阿卜",
                    "text": "你看上去像是在找人的样子…我没说错吧？"
                },
                {
                    "id": "624250102",
                    "speaker": "阿卜",
                    "text": "还是说…你是循着那个传说而来？"
                }
            ]
        },
        {
            "talkId": "6242502",
            "initDialog": "624250201",
            "dialogues": [
                {
                    "id": "624250201",
                    "speaker": "Player",
                    "text": "确实在找人…"
                },
                {
                    "id": "624250202",
                    "speaker": "阿卜",
                    "text": "欸嘿！这就对了，这只是本占卜师「阿卜」的一点基本功。"
                },
                {
                    "id": "624250203",
                    "speaker": "阿卜",
                    "text": "像你这样的家伙，很容易就被看穿的…啊不，很容易就能看清你的命运的。"
                },
                {
                    "id": "624250204",
                    "speaker": "阿卜",
                    "text": "比如——你的内心还藏着一些秘密，偶尔会感觉到孤单，心底有一个无比重要的人…"
                },
                {
                    "id": "624250205",
                    "speaker": "Player",
                    "text": "所有人都是这样的吧喂！"
                },
                {
                    "id": "624250206",
                    "speaker": "阿卜",
                    "text": "怎么会呢！我可是看清了你的命运才讲的这些「判词」…"
                },
                {
                    "id": "624250207",
                    "speaker": "阿卜",
                    "text": "……"
                },
                {
                    "id": "624250208",
                    "speaker": "阿卜",
                    "text": "…莫非是一口气说太多了么。"
                },
                {
                    "id": "624250209",
                    "speaker": "阿卜",
                    "text": "吸取教训，下次我会注意的。"
                }
            ]
        },
        {
            "talkId": "6242503",
            "initDialog": "624250301",
            "dialogues": [
                {
                    "id": "624250301",
                    "speaker": "Player",
                    "text": "什么传说？"
                },
                {
                    "id": "624250302",
                    "speaker": "阿卜",
                    "text": "这个海螺屋的传说哦，在璃月的年轻人之间还蛮流行的。"
                },
                {
                    "id": "624250303",
                    "speaker": "阿卜",
                    "text": "…海螺可以传递来自大海的声音，这座海螺屋也是一样…"
                },
                {
                    "id": "624250304",
                    "speaker": "阿卜",
                    "text": "可它传递的声音却并非来自眼前的大海，而是…「灵魂之海」，是灵魂的传声筒。"
                },
                {
                    "id": "624250305",
                    "speaker": "阿卜",
                    "text": "如果有人听到海螺中传来的声音的话，那可能意味着……"
                },
                {
                    "id": "624250306",
                    "speaker": "阿卜",
                    "text": "欸嘿，吓到你了吗？"
                }
            ]
        },
        {
            "talkId": "6242504",
            "initDialog": "624250401",
            "dialogues": [
                {
                    "id": "624250401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624250402",
                    "speaker": "阿卜",
                    "text": "居然无视我吗！真是无趣的人。"
                }
            ]
        }
    ]
}