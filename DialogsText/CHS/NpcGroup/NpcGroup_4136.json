{
    "groupId": "4136",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "莎莉": 15
    },
    "talks": [
        {
            "talkId": "6413601",
            "initDialog": "641360101",
            "dialogues": [
                {
                    "id": "641360101",
                    "speaker": "莎莉",
                    "text": "欢迎下榻本店，有任何需要请随时叫我。"
                }
            ]
        },
        {
            "talkId": "6413602",
            "initDialog": "641360201",
            "dialogues": [
                {
                    "id": "641360201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "641360202",
                    "speaker": "莎莉",
                    "text": "这里是家父开的旅店，而我便是这里的掌柜和招待。"
                },
                {
                    "id": "641360203",
                    "speaker": "莎莉",
                    "text": "您如果需要入住的话，请在我这里登记姓名、人数、来由和入住天数。"
                },
                {
                    "id": "641360204",
                    "speaker": "莎莉",
                    "text": "…啊当然，如果您不愿留下信息也是可以的。登记只是为了让本店为您提供更好的服务。"
                },
                {
                    "id": "641360205",
                    "speaker": "莎莉",
                    "text": "顺便一提，无论客人与否，都可以随意使用本店门前的升降机，这样就不用爬那条长长的坡道了。"
                },
                {
                    "id": "641360206",
                    "speaker": "莎莉",
                    "text": "但如果您有恐高症的话，那就没有办法了…"
                },
                {
                    "id": "641360207",
                    "speaker": "莎莉",
                    "text": "对了，你在来这里的路上有见过一个头发乱糟糟，衣服脏兮兮的学者吗？"
                }
            ]
        },
        {
            "talkId": "6413603",
            "initDialog": "641360301",
            "dialogues": [
                {
                    "id": "641360301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641360302",
                    "speaker": "莎莉",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6413604",
            "initDialog": "641360401",
            "dialogues": [
                {
                    "id": "641360401",
                    "speaker": "Player",
                    "text": "没见过…"
                },
                {
                    "id": "641360402",
                    "speaker": "莎莉",
                    "text": "喔…好吧，那他可能已经离开奥摩斯港了。"
                },
                {
                    "id": "641360403",
                    "speaker": "莎莉",
                    "text": "他叫阿曼迪普，是一个在这里住了很久的学者，靠指导年轻的学者写论文过活。"
                },
                {
                    "id": "641360404",
                    "speaker": "莎莉",
                    "text": "前几天，好像是闹海兽的那一天，他出了门后就没回来，还欠着些房费。"
                },
                {
                    "id": "641360405",
                    "speaker": "莎莉",
                    "text": "找他倒不是真想让他结清房费，而是看他一声不吭走了，担心他是不是遇上了什么麻烦。"
                },
                {
                    "id": "641360406",
                    "speaker": "莎莉",
                    "text": "奥摩斯港里我都托人找遍了，就是没有他的下落。"
                }
            ]
        },
        {
            "talkId": "6413605",
            "initDialog": "641360501",
            "dialogues": [
                {
                    "id": "641360501",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6413606",
            "initDialog": "641360601",
            "dialogues": [
                {
                    "id": "641360601",
                    "speaker": "莎莉",
                    "text": "…遇到更强的牌手，输也是没办法的事。"
                }
            ]
        },
        {
            "talkId": "6413607",
            "initDialog": "641360701",
            "dialogues": [
                {
                    "id": "641360701",
                    "speaker": "莎莉",
                    "text": "下榻在此的旅客经常玩「七圣召唤」，看得多了，自然也比较会玩。"
                }
            ]
        }
    ]
}