{
    "groupId": "7049",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "奈芙尔": 4,
        "爱莱莎": 7
    },
    "talks": [
        {
            "talkId": "6704901",
            "initDialog": "670490101",
            "dialogues": [
                {
                    "id": "670490101",
                    "speaker": "爱莱莎",
                    "text": "那家伙到底在哪里…"
                }
            ]
        },
        {
            "talkId": "6704902",
            "initDialog": "670490201",
            "dialogues": [
                {
                    "id": "670490201",
                    "speaker": "Player",
                    "text": "你在找人吗？"
                },
                {
                    "id": "670490202",
                    "speaker": "爱莱莎",
                    "text": "嗯？是哦，我在找一个叫蒂昂日的男人，从遗珑埠一路追查到…呃，一路找到那夏镇来了。"
                },
                {
                    "id": "670490203",
                    "speaker": "爱莱莎",
                    "text": "他是…嗯，是我的朋友呢，无话不谈的朋友。因为要谈的话太多了，所以最好还是把他带回枫丹慢慢谈…"
                },
                {
                    "id": "670490204",
                    "speaker": "爱莱莎",
                    "text": "按理来说，那家伙现在应该就在镇子里才对，怎么会找不到呢？"
                }
            ]
        },
        {
            "talkId": "6704903",
            "initDialog": "670490301",
            "dialogues": [
                {
                    "id": "670490301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "670490302",
                    "speaker": "爱莱莎",
                    "text": "好，再见。"
                }
            ]
        },
        {
            "talkId": "6704904",
            "initDialog": "670490401",
            "dialogues": [
                {
                    "id": "670490401",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>奈芙尔</color>似乎有所思考…）"
                },
                {
                    "id": "670490402",
                    "speaker": "奈芙尔",
                    "text": "哎呀，爱莱莎小姐。您今天的调查结果如何？"
                },
                {
                    "id": "670490403",
                    "speaker": "爱莱莎",
                    "text": "啊，奈芙尔老板，您好呀！我的那位「朋友」一定就藏在镇子里，只要我再找找，就一定能找到他！"
                },
                {
                    "id": "670490404",
                    "speaker": "奈芙尔",
                    "text": "呵呵，真是努力呢。需要帮助的话，也可以随时来「秘闻馆」喔。"
                },
                {
                    "id": "670490405",
                    "speaker": "奈芙尔",
                    "text": "毕竟，莱斯托克先生也经常为我们提供珍贵的「螺{RUBY#[D]情报}钉」，枫丹的{RUBY#[S]逐影庭探员}游客遇到困难，我们自然也愿意协助。"
                },
                {
                    "id": "670490406",
                    "speaker": "爱莱莎",
                    "text": "嗯嗯，非常感谢您的好意，奈芙尔老板！但这毕竟是我和那位「朋友」的私事啦，还是不能麻烦外{RUBY#[D]逐影庭之外的人}人的！"
                },
                {
                    "id": "670490407",
                    "speaker": "奈芙尔",
                    "text": "我理解。那么，祝您早日找到那位「朋友」，爱莱莎小姐。"
                }
            ]
        }
    ]
}