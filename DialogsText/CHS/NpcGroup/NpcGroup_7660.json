{
    "groupId": "7660",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "伊捷莉": 9,
        "叶洛亚": 4
    },
    "talks": [
        {
            "talkId": "6766001",
            "initDialog": "676600101",
            "dialogues": [
                {
                    "id": "676600101",
                    "speaker": "伊捷莉",
                    "text": "真是令人担心，希望大家都能平安回来…"
                }
            ]
        },
        {
            "talkId": "6766002",
            "initDialog": "676600201",
            "dialogues": [
                {
                    "id": "676600201",
                    "speaker": "Player",
                    "text": "一定可以的。"
                },
                {
                    "id": "676600202",
                    "speaker": "伊捷莉",
                    "text": "谢谢，其实我也知道这只是我的一厢情愿。毕竟作为执灯士，就是要为了保护家园流血牺牲的。"
                },
                {
                    "id": "676600203",
                    "speaker": "伊捷莉",
                    "text": "从小生活在皮拉米达城周围耳濡目染，我原本以为自己早就习惯了生离死别。"
                },
                {
                    "id": "676600204",
                    "speaker": "伊捷莉",
                    "text": "但直到加入执灯人后，我才意识到「牺牲」二字有多么沉重…"
                }
            ]
        },
        {
            "talkId": "6766003",
            "initDialog": "676600301",
            "dialogues": [
                {
                    "id": "676600301",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>叶洛亚</color>似乎有话要说…？）"
                },
                {
                    "id": "676600302",
                    "speaker": "叶洛亚",
                    "text": "伊捷莉，最近营地的情况如何？"
                },
                {
                    "id": "676600303",
                    "speaker": "伊捷莉",
                    "text": "你回来了，队长。你不在的这段时间营地一切正常，周围也没有发现敌袭的迹象。"
                },
                {
                    "id": "676600304",
                    "speaker": "叶洛亚",
                    "text": "那我就放心了。看你心事重重的，我还以为出什么事情了。"
                },
                {
                    "id": "676600305",
                    "speaker": "伊捷莉",
                    "text": "没有啦，可能是我还不太习惯这里紧张的气氛，总是会担心外出执行任务的大家…"
                },
                {
                    "id": "676600306",
                    "speaker": "叶洛亚",
                    "text": "刚成为执灯士的时候，我也经常这样。不过可别因此影响了休息啊。"
                },
                {
                    "id": "676600307",
                    "speaker": "伊捷莉",
                    "text": "我知道啦。倒是队长你自己，刚回来就开始整理报告，一刻也没见你停下来。"
                },
                {
                    "id": "676600308",
                    "speaker": "伊捷莉",
                    "text": "你要是倒下了，整个调查分队的作战都会因此耽搁。就算是为了队伍考虑，也多少休息会吧。"
                },
                {
                    "id": "676600309",
                    "speaker": "叶洛亚",
                    "text": "哈哈，我会注意的…"
                }
            ]
        },
        {
            "talkId": "6766004",
            "initDialog": "676600401",
            "dialogues": [
                {
                    "id": "676600401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "676600402",
                    "speaker": "伊捷莉",
                    "text": "嗯，要注意安全啊。"
                }
            ]
        }
    ]
}