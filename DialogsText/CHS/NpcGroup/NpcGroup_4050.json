    },
    "talks": [
        {
            "talkId": "6405001",
            "initDialog": "640500101",
            "dialogues": [
                {
                    "id": "640500101",
                    "speaker": "苏莱卡",
                    "text": "君子爱财，取之有道，这点我可是很明白的。"
                },
                {
                    "id": "640500102",
                    "speaker": "苏莱卡",
                    "text": "所以客人们啊，嘿嘿，可以放心地在我这里买东西哦。"
                }
            ]
        },
        {
            "talkId": "6405002",
            "initDialog": "640500201",
            "dialogues": [
                {
                    "id": "640500201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640500202",
                    "speaker": "苏莱卡",
                    "text": "我是世界上最棒的毛毯销售员，没有之一。"
                },
                {
                    "id": "640500203",
                    "speaker": "苏莱卡",
                    "text": "哼哼，就算不是毛毯，换成玩具、首饰、厨具，我也一定是最棒的。"
                },
                {
                    "id": "640500204",
                    "speaker": "苏莱卡",
                    "text": "…哦当然，书本可能不行，因为这里是须弥嘛。"
                }
            ]
        },
        {
            "talkId": "6405003",
            "initDialog": "640500301",
            "dialogues": [
                {
                    "id": "640500301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640500302",
                    "speaker": "苏莱卡",
                    "text": "嗯嗯，不买东西也欢迎再来哦。"
                }
            ]
        },
        {
            "talkId": "6405004",
            "initDialog": "640500401",
            "dialogues": [
                {
                    "id": "640500401",
                    "speaker": "Player",
                    "text": "书本不行？"
                },
                {
                    "id": "640500402",
                    "speaker": "苏莱卡",
                    "text": "嗯嗯，书本不可以哦。我是遵纪守法的好公民，就算走私知识能赚大钱，我也绝对不会去碰的哦。"
                },
                {
                    "id": "640500403",
                    "speaker": "苏莱卡",
                    "text": "毕竟想要一直赚钱，还是得先留得青山在。"
                },
                {
                    "id": "640500404",
                    "speaker": "苏莱卡",
                    "text": "更何况赚钱又不是什么难事。哪怕只有我一半的本事，也至少能赚到呼玛伊家那种程度吧？"
                },
                {
                    "id": "640500405",
                    "speaker": "苏莱卡",
                    "text": "哼哼，如果教令院当年拉我去上学的说辞，能有我推销商品时的一半好，我也不至于当场回绝他们嘛。"
                }
            ]
        },
        {
            "talkId": "6405005",
            "initDialog": "640500501",
            "dialogues": [
                {
