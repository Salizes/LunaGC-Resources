{
    "groupId": "9097",
    "total_dialogue_lines": 83,
    "speaker_counts": {
        "Player": 18,
        "赛索斯": 65
    },
    "talks": [
        {
            "talkId": "6909701",
            "initDialog": "690970101",
            "dialogues": [
                {
                    "id": "690970101",
                    "speaker": "赛索斯",
                    "text": "你好你好，又见面了。"
                },
                {
                    "id": "690970102",
                    "speaker": "赛索斯",
                    "text": "这里环境真不错，感谢你邀请我来。"
                }
            ]
        },
        {
            "talkId": "6909702",
            "initDialog": "690970201",
            "dialogues": [
                {
                    "id": "690970201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690970202",
                    "speaker": "赛索斯",
                    "text": "当然，非常好。"
                },
                {
                    "id": "690970203",
                    "speaker": "赛索斯",
                    "text": "我向来随遇而安，什么环境都能适应，就更不用说这样优美宜人的地方了。",
                    "choices": [
                        {
                            "id": "690970204",
                            "text": "我用心布置过了。",
                            "response": [
                                {
                                    "id": "690970205",
                                    "speaker": "赛索斯",
                                    "text": "嗯，看得出来。"
                                },
                                {
                                    "id": "690970206",
                                    "speaker": "赛索斯",
                                    "text": "有人喜欢出门游玩，有人则喜欢把自家整理得温馨舒适，独享清净。"
                                },
                                {
                                    "id": "690970207",
                                    "speaker": "赛索斯",
                                    "text": "在我看来，形式不同，但都是热爱生活的表现。"
                                },
                                {
                                    "id": "690970211",
                                    "speaker": "赛索斯",
                                    "text": "说起来，这里真是宽敞，不仅有房屋建筑，还有大片的空地…"
                                },
                                {
                                    "id": "690970212",
                                    "speaker": "赛索斯",
                                    "text": "如果能按照不同风貌设计一番，岂不是每天都能换着地方露营玩耍了？"
                                },
                                {
                                    "id": "690970213",
                                    "speaker": "赛索斯",
                                    "text": "你想的话，可以叫我来帮忙。"
                                },
                                {
                                    "id": "690970214",
                                    "speaker": "赛索斯",
                                    "text": "我脑子里已经出现不少合适的摆设了。"
                                }
                            ]
                        },
                        {
                            "id": "690970208",
                            "text": "久疏打理，见笑了。",
                            "response": [
                                {
                                    "id": "690970209",
                                    "speaker": "赛索斯",
                                    "text": "不不不，别这样说。"
                                },
                                {
                                    "id": "690970210",
                                    "speaker": "赛索斯",
                                    "text": "我也是个喜欢出门冒险的人，家中布置得就比较简单了，可能还没有你这整洁呢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909703",
            "initDialog": "690970301",
            "dialogues": [
                {
                    "id": "690970301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690970302",
                    "speaker": "赛索斯",
                    "text": "好好好，我正觉得有些安静呢。"
                },
                {
                    "id": "690970303",
                    "speaker": "赛索斯",
                    "text": "刚巧有事想向你请教。以你的经验来看，探访沙漠里新挖出的遗迹，应该提前做好哪些准备呢？"
                },
                {
                    "id": "690970304",
                    "speaker": "Player",
                    "text": "是有新的发现吗？"
                },
                {
                    "id": "690970305",
                    "speaker": "赛索斯",
                    "text": "暂时没有，只是先假设一下。"
                },
                {
                    "id": "690970306",
                    "speaker": "赛索斯",
                    "text": "缄默之殿的成员们大部分时间都在驻地研究和管理古老文明技术，但偶尔也会出现需要外出调查的情况。"
                },
                {
                    "id": "690970307",
                    "speaker": "赛索斯",
                    "text": "一般来说，我不会错过这些机会。",
                    "choices": [
                        {
                            "id": "690970308",
                            "text": "我不常去沙漠，你应该比我有经验。",
                            "response": [
                                {
                                    "id": "690970309",
                                    "speaker": "赛索斯",
                                    "text": "真的吗？那看来是我的情报有误？"
                                },
                                {
                                    "id": "690970310",
                                    "speaker": "赛索斯",
                                    "text": "不过，就算是长期生活在沙漠里的人，也无法窥探它的全貌。"
                                },
                                {
                                    "id": "690970311",
                                    "speaker": "赛索斯",
                                    "text": "有时连遗迹正门都还没进去呢，就已经被三四个机关拦下来啦。"
                                },
                                {
                                    "id": "690970314",
                                    "speaker": "赛索斯",
                                    "text": "那就拿赤王陵附近举例好了。"
                                },
                                {
                                    "id": "690970315",
                                    "speaker": "赛索斯",
                                    "text": "那里是赤王遗迹最密集的区域，调查队伍会遇到的难题也最多。"
                                },
                                {
                                    "id": "690970316",
                                    "speaker": "赛索斯",
                                    "text": "明明面前是空无一物的沙地，走近了却会一头撞上看不见的墙壁。"
                                },
                                {
                                    "id": "690970317",
                                    "speaker": "赛索斯",
                                    "text": "等我们好不容易摸清了那片废墟占地多大，才发现高度更难观测。"
                                },
                                {
                                    "id": "690970318",
                                    "speaker": "赛索斯",
                                    "text": "后来有个同伴提议，要不要拆几块那些看不见的材料搬回去…"
                                },
                                {
                                    "id": "690970319",
                                    "speaker": "赛索斯",
                                    "text": "用它们在缄默之殿门口造个迷宫，这样就可以防范外人入侵了。"
                                },
                                {
                                    "id": "690970320",
                                    "speaker": "Player",
                                    "text": "你说的这个同伴，是不是你自己？"
                                },
                                {
                                    "id": "690970321",
                                    "speaker": "赛索斯",
                                    "text": "嘿，我是这样的人吗？"
                                },
                                {
                                    "id": "690970322",
                                    "speaker": "赛索斯",
                                    "text": "但你别说，我和他确实想到一块去了。"
                                },
                                {
                                    "id": "690970323",
                                    "speaker": "赛索斯",
                                    "text": "只不过我觉得，我们自己人也可能通不过那样的迷宫，就没说出来。"
                                },
                                {
                                    "id": "690970324",
                                    "speaker": "赛索斯",
                                    "text": "事实证明，我的担忧是对的，这件事最终没能实现。"
                                },
                                {
                                    "id": "690970325",
                                    "speaker": "Player",
                                    "text": "我代表冒险家们感谢你。"
                                },
                                {
                                    "id": "690970326",
                                    "speaker": "赛索斯",
                                    "text": "别客气别客气。"
                                },
                                {
                                    "id": "690970327",
                                    "speaker": "赛索斯",
                                    "text": "但就算没有这个迷宫，也不要小看沙漠里的神秘力量哦。"
                                }
                            ]
                        },
                        {
                            "id": "690970312",
                            "text": "沙漠啊，我熟，你随便选一片。",
                            "response": [
                                {
                                    "id": "690970313",
                                    "speaker": "赛索斯",
                                    "text": "哎呀，这就是冒险家老手的自信吗，连不同沙漠区域的气候差异都想到了？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909704",
            "initDialog": "690970401",
            "dialogues": [
                {
                    "id": "690970401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690970402",
                    "speaker": "赛索斯",
                    "text": "有有有，有好多呢。"
                },
                {
                    "id": "690970403",
                    "speaker": "赛索斯",
                    "text": "考虑到这里是你的住处，我没敢贸然动手。"
                },
                {
                    "id": "690970404",
                    "speaker": "Player",
                    "text": "你、你要做什么？"
                },
                {
                    "id": "690970405",
                    "speaker": "赛索斯",
                    "text": "嗯…可能…也许…在这里建一处营地？"
                },
                {
                    "id": "690970406",
                    "speaker": "Player",
                    "text": "听上去还好。"
                },
                {
                    "id": "690970407",
                    "speaker": "赛索斯",
                    "text": "真的？那就太好了。"
                },
                {
                    "id": "690970408",
                    "speaker": "赛索斯",
                    "text": "我想想，首先，至少要有两座帐篷。"
                },
                {
                    "id": "690970409",
                    "speaker": "赛索斯",
                    "text": "一处用于休息，要配最厚实的布料，才能保证隔音效果。"
                },
                {
                    "id": "690970410",
                    "speaker": "赛索斯",
                    "text": "除了用来睡觉，在里面做做研究、整理资料也不错。"
                },
                {
                    "id": "690970411",
                    "speaker": "赛索斯",
                    "text": "另一处用于闲聊和游戏，门口摆放成套的野餐用具和躺椅。"
                },
                {
                    "id": "690970412",
                    "speaker": "赛索斯",
                    "text": "你这里天气一直不错，倒是不太需要遮风挡雨…"
                },
                {
                    "id": "690970413",
                    "speaker": "赛索斯",
                    "text": "那，接下来就是游戏机关了。"
                },
                {
                    "id": "690970414",
                    "speaker": "Player",
                    "text": "欸？"
                },
                {
                    "id": "690970415",
                    "speaker": "赛索斯",
                    "text": "再好的风景，干看着也有些无聊，对吧？"
                },
                {
                    "id": "690970416",
                    "speaker": "赛索斯",
                    "text": "更重要的，是人在其中做些什么。"
                },
                {
                    "id": "690970417",
                    "speaker": "赛索斯",
                    "text": "如果有用来跳高、跑步或者攀岩、飞行的装置，那就有意思多了。"
                },
                {
                    "id": "690970418",
                    "speaker": "赛索斯",
                    "text": "有了那些东西，你也可以呼一下上去，哗一下下来，唰一下远去…"
                },
                {
                    "id": "690970419",
                    "speaker": "Player",
                    "text": "或许可以问问阿圆。"
                },
                {
                    "id": "690970420",
                    "speaker": "赛索斯",
                    "text": "哦？是说那位笑容很和蔼的团雀小姐吗？"
                },
                {
                    "id": "690970421",
                    "speaker": "赛索斯",
                    "text": "这个好办，我跟她聊过啦。她好厉害，懂得很多管家的好办法。"
                },
                {
                    "id": "690970422",
                    "speaker": "赛索斯",
                    "text": "就是有些机关技术我摸索不透。不过我能理解，缄默之殿也是这样，每个组织都会保留一些不能外传的秘密。"
                },
                {
                    "id": "690970423",
                    "speaker": "赛索斯",
                    "text": "没关系，我也有我的办法。",
                    "choices": [
                        {
                            "id": "690970424",
                            "text": "我家要变成游乐场咯。",
                            "response": [
                                {
                                    "id": "690970426",
                                    "speaker": "赛索斯",
                                    "text": "嗯！有你的首肯我就满足了！"
                                },
                                {
                                    "id": "690970427",
                                    "speaker": "赛索斯",
                                    "text": "等我先设计一下，出了图纸之后再找你商量。"
                                },
                                {
                                    "id": "690970428",
                                    "speaker": "赛索斯",
                                    "text": "如果能邀请其他朋友来玩，应该会更热闹吧。"
                                }
                            ]
                        },
                        {
                            "id": "690970425",
                            "text": "我家很大，你玩得开心就好。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909705",
            "initDialog": "690970501",
            "dialogues": [
                {
                    "id": "690970501",
                    "speaker": "Player",
                    "text": "早啊，赛索斯。"
                },
                {
                    "id": "690970502",
                    "speaker": "赛索斯",
                    "text": "早啊，又要开始新一天的生活咯。"
                },
                {
                    "id": "690970503",
                    "speaker": "赛索斯",
                    "text": "是选条新路线出去徒步，还是就在这附近找地方露营呢…嗯，我想想。"
                }
            ]
        },
        {
            "talkId": "6909706",
            "initDialog": "690970601",
            "dialogues": [
                {
                    "id": "690970601",
                    "speaker": "Player",
                    "text": "晚安，赛索斯。"
                },
                {
                    "id": "690970602",
                    "speaker": "赛索斯",
                    "text": "晚上好！这么晚不睡，难道还有安排？"
                },
                {
                    "id": "690970603",
                    "speaker": "赛索斯",
                    "text": "我也还不困，我们一起去吧？我来保护你。不乐意的话，你保护我！"
                }
            ]
        },
        {
            "talkId": "6909710",
            "initDialog": "690971001",
            "dialogues": [
                {
                    "id": "690971001",
                    "speaker": "赛索斯",
                    "text": "我每次去大巴扎都会先直奔小吃摊，买几样零食饮料，再慢慢吃慢慢逛。"
                },
                {
                    "id": "690971002",
                    "speaker": "赛索斯",
                    "text": "但有时候吧，手里拿着东西，像毛毯店之类的地方就不方便去了…"
                },
                {
                    "id": "690971003",
                    "speaker": "赛索斯",
                    "text": "不如这样，小吃分你一半，我们赶快吃完一起去逛。"
                }
            ]
        },
        {
            "talkId": "6909711",
            "initDialog": "690971101",
            "dialogues": [
                {
                    "id": "690971101",
                    "speaker": "赛索斯",
                    "text": "竟然配备了如此专业的烤肉炉，温度和转速都很好控制。"
                },
                {
                    "id": "690971102",
                    "speaker": "赛索斯",
                    "text": "嗯，想到了！"
                },
                {
                    "id": "690971103",
                    "speaker": "赛索斯",
                    "text": "今天就用这几样香料，烤些适合搭配卷饼的肉排吧。"
                }
            ]
        }
    ]
}