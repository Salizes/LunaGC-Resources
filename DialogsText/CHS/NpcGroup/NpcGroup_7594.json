{
    "groupId": "7594",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 2,
        "赫鲁塔廖夫": 9
    },
    "talks": [
        {
            "talkId": "6759401",
            "initDialog": "675940101",
            "dialogues": [
                {
                    "id": "675940101",
                    "speaker": "赫鲁塔廖夫",
                    "text": "怎么听来听去就是这么几个故事，一点新意也没有…不然还是去实地取材吧…"
                }
            ]
        },
        {
            "talkId": "6759402",
            "initDialog": "675940201",
            "dialogues": [
                {
                    "id": "675940201",
                    "speaker": "Player",
                    "text": "什么故事？"
                },
                {
                    "id": "675940202",
                    "speaker": "赫鲁塔廖夫",
                    "text": "灵异故事啊。嗨，别提了，最近的灵异故事一点新意也没有，说来说去都是那几个范式。"
                },
                {
                    "id": "675940203",
                    "speaker": "赫鲁塔廖夫",
                    "text": "什么半夜突然开过来的空列车啦，列车上非要说你偷自己东西然后拉着你下车，最后说你刚才没发现吗？列车上的人都没有脚啊！"
                },
                {
                    "id": "675940204",
                    "speaker": "赫鲁塔廖夫",
                    "text": "要么就是什么误入空医院，空古堡，空屋子，空教室…然后遇见什么乱七八糟的响动，仔细一听，发现是一个早就逝世的人在嘀嘀咕咕…"
                },
                {
                    "id": "675940205",
                    "speaker": "赫鲁塔廖夫",
                    "text": "现在的读者都已经对这种故事毫无感觉了！别说被吓着了，被逗笑都不可能啊！"
                },
                {
                    "id": "675940206",
                    "speaker": "赫鲁塔廖夫",
                    "text": "事到如今，我也只能自己实地取材了，真希望能找到一点好素材，不然我的故事又要被退稿了…"
                },
                {
                    "id": "675940207",
                    "speaker": "赫鲁塔廖夫",
                    "text": "但总是在这里上班卖票，我也没什么空自己去取材啊。"
                },
                {
                    "id": "675940208",
                    "speaker": "赫鲁塔廖夫",
                    "text": "唉，实在不行，什么时候就偷偷跳上车去吧…"
                }
            ]
        },
        {
            "talkId": "6759403",
            "initDialog": "675940301",
            "dialogues": [
                {
                    "id": "675940301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675940302",
                    "speaker": "赫鲁塔廖夫",
                    "text": "嗯，再见…唉，干脆直接偷偷跳上车吧…"
                }
            ]
        }
    ]
}