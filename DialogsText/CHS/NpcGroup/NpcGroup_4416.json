{
    "groupId": "4416",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "纳瓦兹": 15
    },
    "talks": [
        {
            "talkId": "6441601",
            "initDialog": "644160101",
            "dialogues": [
                {
                    "id": "644160101",
                    "speaker": "纳瓦兹",
                    "text": "圣金虫~圣金虫~你们在哪里~？"
                }
            ]
        },
        {
            "talkId": "6441602",
            "initDialog": "644160201",
            "dialogues": [
                {
                    "id": "644160201",
                    "speaker": "Player",
                    "text": "圣金虫？"
                },
                {
                    "id": "644160202",
                    "speaker": "纳瓦兹",
                    "text": "什么，你不知道吗？圣金虫是世界上最酷——的虫子啦！"
                },
                {
                    "id": "644160203",
                    "speaker": "纳瓦兹",
                    "text": "它有着最酷的甲壳，和最酷的花纹，在阳光下闪着最酷的金光。"
                },
                {
                    "id": "644160204",
                    "speaker": "纳瓦兹",
                    "text": "听大人们讲，圣金虫里被赤王放进了很厉害的东西，所以它能一直保护我们。"
                },
                {
                    "id": "644160205",
                    "speaker": "纳瓦兹",
                    "text": "听上去好厉害哦！"
                }
            ]
        },
        {
            "talkId": "6441603",
            "initDialog": "644160301",
            "dialogues": [
                {
                    "id": "644160301",
                    "speaker": "Player",
                    "text": "在哪里呢？"
                },
                {
                    "id": "644160302",
                    "speaker": "纳瓦兹",
                    "text": "在哪里呢~？♪"
                }
            ]
        },
        {
            "talkId": "6441604",
            "initDialog": "644160401",
            "dialogues": [
                {
                    "id": "644160401",
                    "speaker": "Player",
                    "text": "关于赤王…"
                },
                {
                    "id": "644160402",
                    "speaker": "纳瓦兹",
                    "text": "说实话，这个我也有点搞不清楚。有些大人说应该相信草神，有些大人说应该相信赤王…"
                },
                {
                    "id": "644160403",
                    "speaker": "纳瓦兹",
                    "text": "神与神之间也有关系不好的吗？"
                },
                {
                    "id": "644160404",
                    "speaker": "纳瓦兹",
                    "text": "虽然赤王有着最酷的圣金虫，但是那些叫我信赤王的大人说话都好讨厌…我不喜欢。"
                },
                {
                    "id": "644160405",
                    "speaker": "纳瓦兹",
                    "text": "我之前听人说，赤王以前有好多要好的动物朋友呢！有羊，有狼，还有…什么来着…"
                },
                {
                    "id": "644160406",
                    "speaker": "纳瓦兹",
                    "text": "所以我一直觉得赤王能和这么多小动物搞好关系，应该是很友善的神吧？"
                },
                {
                    "id": "644160407",
                    "speaker": "纳瓦兹",
                    "text": "但为什么那些相信他的人，看上去都不太亲切呢…"
                }
            ]
        },
        {
            "talkId": "7397501",
            "initDialog": "739750101",
            "dialogues": [
                {
                    "id": "739750101",
                    "speaker": "Player",
                    "text": "要做友善的人哦。"
                },
                {
                    "id": "739750102",
                    "speaker": "纳瓦兹",
                    "text": "嗯，我也是这么认为的！"
                },
                {
                    "id": "739750103",
                    "speaker": "纳瓦兹",
                    "text": "要做友善的人，也要有最酷的虫！"
                },
                {
                    "id": "739750104",
                    "speaker": "纳瓦兹",
                    "text": "你还没有圣金虫吧？那给你几只，希望它们能好好保护你和身边的朋友们！"
                }
            ]
        }
    ]
}