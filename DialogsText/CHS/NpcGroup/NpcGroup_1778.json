{
    "groupId": "1778",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "秋特切娃": 13
    },
    "talks": [
        {
            "talkId": "6177801",
            "initDialog": "617780101",
            "dialogues": [
                {
                    "id": "617780101",
                    "speaker": "秋特切娃",
                    "text": "嗯？这是…花的芬芳？层次分明，余韵悠长…看来您也是一位懂行的人呢。"
                }
            ]
        },
        {
            "talkId": "6177802",
            "initDialog": "617780201",
            "dialogues": [
                {
                    "id": "617780201",
                    "speaker": "秋特切娃",
                    "text": "啊…抱歉，我在构思香水的配方。如果没有什么急事的话，还请您别打断我的思绪。"
                }
            ]
        },
        {
            "talkId": "6177803",
            "initDialog": "617780301",
            "dialogues": [
                {
                    "id": "617780301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "617780302",
                    "speaker": "秋特切娃",
                    "text": "我是秋特切娃，来自至冬堡的调香师。"
                },
                {
                    "id": "617780303",
                    "speaker": "秋特切娃",
                    "text": "我从北国来到这里，一方面是为了度假，另一方面也是希望寻找一些清冽的松香。"
                },
                {
                    "id": "617780304",
                    "speaker": "秋特切娃",
                    "text": "只是没想到，同为北大陆，蒙德居然会这么…温暖，与我最初的想象全然不同。"
                },
                {
                    "id": "617780305",
                    "speaker": "秋特切娃",
                    "text": "不过，这也能为我提供不错的灵感。依据不同的地域，调配不同的香水，原本就是调香师的必修课之一。"
                },
                {
                    "id": "617780306",
                    "speaker": "秋特切娃",
                    "text": "嗯，就当是某种修心养性的试炼吧。"
                }
            ]
        },
        {
            "talkId": "6177804",
            "initDialog": "617780401",
            "dialogues": [
                {
                    "id": "617780401",
                    "speaker": "Player",
                    "text": "关于香水…"
                },
                {
                    "id": "617780402",
                    "speaker": "秋特切娃",
                    "text": "嗯…既然您也是懂行的人，那我便对您说吧。"
                },
                {
                    "id": "617780403",
                    "speaker": "秋特切娃",
                    "text": "我正在尝试复原《沃尔霍编年史》中，最初的风仙大公「丝翠维莎」用过的奢贵香调。"
                },
                {
                    "id": "617780404",
                    "speaker": "秋特切娃",
                    "text": "传说就连白沙皇陛下也曾被她使用的那种香水短暂吸引，将其称作「胜过冰原上所有芳香的芳香」…"
                },
                {
                    "id": "617780405",
                    "speaker": "秋特切娃",
                    "text": "可惜，就算是现在的风仙…比如冬契军的薇斯纳小姐，也不清楚那么古老的配方。"
                },
                {
                    "id": "617780406",
                    "speaker": "秋特切娃",
                    "text": "所以，我也只能想办法从零开始调配，看看能不能用北大陆的花卉，再现出那种轻盈而寒冷的气息。"
                }
            ]
        },
        {
            "talkId": "6177805",
            "initDialog": "617780501",
            "dialogues": [
                {
                    "id": "617780501",
                    "speaker": "Player",
                    "text": "祝你早日成功。"
                },
                {
                    "id": "617780502",
                    "speaker": "秋特切娃",
                    "text": "借您吉言。"
                }
            ]
        }
    ]
}