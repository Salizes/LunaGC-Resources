{
    "groupId": "9086",
    "total_dialogue_lines": 69,
    "speaker_counts": {
        "Player": 18,
        "莱欧斯利": 51
    },
    "talks": [
        {
            "talkId": "6908601",
            "initDialog": "690860101",
            "dialogues": [
                {
                    "id": "690860101",
                    "speaker": "莱欧斯利",
                    "text": "#你好啊，{NICKNAME}。"
                },
                {
                    "id": "690860102",
                    "speaker": "莱欧斯利",
                    "text": "正想着若是你没事找我，我要不要去找块草坪躺一会儿呢。"
                }
            ]
        },
        {
            "talkId": "6908602",
            "initDialog": "690860201",
            "dialogues": [
                {
                    "id": "690860201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690860202",
                    "speaker": "莱欧斯利",
                    "text": "嗯，环境很好，温度和湿度都无可挑剔，是适合悠闲度日的地方。"
                },
                {
                    "id": "690860203",
                    "speaker": "莱欧斯利",
                    "text": "有这样舒适的庇护所还愿意在外面闯荡，你确实不一般。",
                    "choices": [
                        {
                            "id": "690860204",
                            "text": "我有必须要做的事。",
                            "response": [
                                {
                                    "id": "690860205",
                                    "speaker": "莱欧斯利",
                                    "text": "语气如此坚定，看来是生命中至关重要的大事。"
                                },
                                {
                                    "id": "690860206",
                                    "speaker": "莱欧斯利",
                                    "text": "执着于某项目标是好事，能避免人生陷入迷茫。"
                                },
                                {
                                    "id": "690860207",
                                    "speaker": "莱欧斯利",
                                    "text": "但千万不要因为被执念掌控而步入险途，好吗？"
                                },
                                {
                                    "id": "690860208",
                                    "speaker": "莱欧斯利",
                                    "text": "毕竟还有这样一个美妙的地方等你回来呢。"
                                }
                            ]
                        },
                        {
                            "id": "690860209",
                            "text": "生命在于运动。",
                            "response": [
                                {
                                    "id": "690860210",
                                    "speaker": "莱欧斯利",
                                    "text": "哦，很有说服力的一句话，我可以记下来写进梅洛彼得堡的什么守则里。"
                                },
                                {
                                    "id": "690860211",
                                    "speaker": "莱欧斯利",
                                    "text": "需要给你署名吗？"
                                },
                                {
                                    "id": "690860212",
                                    "speaker": "Player",
                                    "text": "休想推卸责任。"
                                },
                                {
                                    "id": "690860213",
                                    "speaker": "莱欧斯利",
                                    "text": "哎呀，被你看穿了。"
                                },
                                {
                                    "id": "690860214",
                                    "speaker": "莱欧斯利",
                                    "text": "放心吧，我只是开玩笑而已。"
                                },
                                {
                                    "id": "690860215",
                                    "speaker": "莱欧斯利",
                                    "text": "就算真要定什么规矩，我也会亲自负责的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908603",
            "initDialog": "690860301",
            "dialogues": [
                {
                    "id": "690860301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690860302",
                    "speaker": "莱欧斯利",
                    "text": "好啊，有什么想聊的话题吗？"
                },
                {
                    "id": "690860303",
                    "speaker": "莱欧斯利",
                    "text": "谈论天气是个打开话匣的好办法，不过这里的气候好像始终如一。"
                },
                {
                    "id": "690860304",
                    "speaker": "Player",
                    "text": "都是壶灵阿圆的功劳。"
                },
                {
                    "id": "690860305",
                    "speaker": "莱欧斯利",
                    "text": "原来如此，那位管家是壶灵啊…"
                },
                {
                    "id": "690860306",
                    "speaker": "莱欧斯利",
                    "text": "我刚到这里时，远远看去还误以为你养了只大型青冠雀一类的宠物。"
                },
                {
                    "id": "690860307",
                    "speaker": "Player",
                    "text": "不可貌相哦。"
                },
                {
                    "id": "690860308",
                    "speaker": "莱欧斯利",
                    "text": "嗯，没错。"
                },
                {
                    "id": "690860309",
                    "speaker": "莱欧斯利",
                    "text": "说起来，我小时候也犯过类似的错误，以为美露莘就是天使海兔跳上岸以后的形态。"
                },
                {
                    "id": "690860310",
                    "speaker": "莱欧斯利",
                    "text": "后来读了些书，被狠狠上了一课。"
                },
                {
                    "id": "690860311",
                    "speaker": "莱欧斯利",
                    "text": "你应该知道，根据法律规定，美露莘是枫丹的正式公民，严禁被当作宠物或怪物对待。",
                    "choices": [
                        {
                            "id": "690860312",
                            "text": "略知一二。",
                            "response": [
                                {
                                    "id": "690860313",
                                    "speaker": "莱欧斯利",
                                    "text": "那就没什么问题了，至少你陷入法律纠纷的原因又少了一个。"
                                },
                                {
                                    "id": "690860317",
                                    "speaker": "莱欧斯利",
                                    "text": "虽然能到水下干活的人多多益善，但我并没有教唆犯罪的癖好。"
                                },
                                {
                                    "id": "690860318",
                                    "speaker": "莱欧斯利",
                                    "text": "希望大家尽量通过正规途径入职梅洛彼得堡，不要给沫芒宫的女士先生们添麻烦。"
                                }
                            ]
                        },
                        {
                            "id": "690860314",
                            "text": "第一次听说…",
                            "response": [
                                {
                                    "id": "690860315",
                                    "speaker": "莱欧斯利",
                                    "text": "那你可要感谢我了。"
                                },
                                {
                                    "id": "690860316",
                                    "speaker": "莱欧斯利",
                                    "text": "对美露莘不敬的犯人，刑期可能会不太好看哦？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908604",
            "initDialog": "690860401",
            "dialogues": [
                {
                    "id": "690860401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690860402",
                    "speaker": "莱欧斯利",
                    "text": "我想在这里到处转转，你不介意吧？",
                    "choices": [
                        {
                            "id": "690860403",
                            "text": "没关系，反正我也没法一直盯着你。",
                            "response": [
                                {
                                    "id": "690860404",
                                    "speaker": "莱欧斯利",
                                    "text": "且不谈武力强弱，如果你拒绝，我肯定不会四处乱逛。"
                                },
                                {
                                    "id": "690860405",
                                    "speaker": "莱欧斯利",
                                    "text": "不过你也算是对我有些了解了，我的确不习惯在自己不熟悉的地方久留。"
                                },
                                {
                                    "id": "690860408",
                                    "speaker": "莱欧斯利",
                                    "text": "但这里是你家，应该不会有什么危险的，对吧？"
                                },
                                {
                                    "id": "690860409",
                                    "speaker": "莱欧斯利",
                                    "text": "我只是出于好奇，想在这片似乎无边无际的神奇天地里闲逛一番，就像旅游一样。"
                                },
                                {
                                    "id": "690860410",
                                    "speaker": "Player",
                                    "text": "还可以切换其他地区的景色哦。"
                                },
                                {
                                    "id": "690860411",
                                    "speaker": "莱欧斯利",
                                    "text": "这么厉害？"
                                },
                                {
                                    "id": "690860412",
                                    "speaker": "莱欧斯利",
                                    "text": "也就是说，只要你想，就能足不出壶地周游各国？",
                                    "choices": [
                                        {
                                            "id": "690860413",
                                            "text": "你想试试吗？",
                                            "response": [
                                                {
                                                    "id": "690860415",
                                                    "speaker": "莱欧斯利",
                                                    "text": "哈哈，这对我来说肯定是难能可贵的机会。"
                                                },
                                                {
                                                    "id": "690860416",
                                                    "speaker": "莱欧斯利",
                                                    "text": "如果有想要的东西就该去争取，不是吗？"
                                                },
                                                {
                                                    "id": "690860417",
                                                    "speaker": "Player",
                                                    "text": "我可以切换给你看哦。"
                                                },
                                                {
                                                    "id": "690860418",
                                                    "speaker": "莱欧斯利",
                                                    "text": "衷心感谢。"
                                                },
                                                {
                                                    "id": "690860419",
                                                    "speaker": "莱欧斯利",
                                                    "text": "当然，我也知道世上不应当有白拿的午餐。"
                                                },
                                                {
                                                    "id": "690860420",
                                                    "speaker": "莱欧斯利",
                                                    "text": "所以需要我帮忙的时候无需顾虑，水下永远欢迎你的到访。"
                                                },
                                                {
                                                    "id": "690860421",
                                                    "speaker": "莱欧斯利",
                                                    "text": "——当然，不作为犯人下来的话最好。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690860414",
                                            "text": "兴趣已经写在脸上了哦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690860406",
                            "text": "还以为你肯定已经探索过了。",
                            "response": [
                                {
                                    "id": "690860407",
                                    "speaker": "莱欧斯利",
                                    "text": "如果换个地方的话…的确，我至少要先确保周边是安全的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908605",
            "initDialog": "690860501",
            "dialogues": [
                {
                    "id": "690860501",
                    "speaker": "Player",
                    "text": "早啊，公爵。"
                },
                {
                    "id": "690860502",
                    "speaker": "莱欧斯利",
                    "text": "难得不在水下碰面，就不用叫得这么正式了。"
                },
                {
                    "id": "690860503",
                    "speaker": "莱欧斯利",
                    "text": "早安，祝你度过美好的一天。"
                }
            ]
        },
        {
            "talkId": "6908606",
            "initDialog": "690860601",
            "dialogues": [
                {
                    "id": "690860601",
                    "speaker": "Player",
                    "text": "晚安，莱欧斯利。"
                },
                {
                    "id": "690860602",
                    "speaker": "莱欧斯利",
                    "text": "晚安了。"
                },
                {
                    "id": "690860603",
                    "speaker": "莱欧斯利",
                    "text": "白天总是很嘈杂，所以我习惯把那些需要安静思考的事务留到晚上处理。"
                },
                {
                    "id": "690860604",
                    "speaker": "莱欧斯利",
                    "text": "不过…在这就算了，让我再发会儿呆吧。"
                }
            ]
        },
        {
            "talkId": "6908610",
            "initDialog": "690861001",
            "dialogues": [
                {
                    "id": "690861001",
                    "speaker": "莱欧斯利",
                    "text": "还挺像模像样的。"
                },
                {
                    "id": "690861002",
                    "speaker": "莱欧斯利",
                    "text": "能被你邀请参赛的人一定实力不凡。"
                },
                {
                    "id": "690861003",
                    "speaker": "莱欧斯利",
                    "text": "我就不上去献丑了，当观众也挺适合我的。"
                }
            ]
        },
        {
            "talkId": "6908611",
            "initDialog": "690861101",
            "dialogues": [
                {
                    "id": "690861101",
                    "speaker": "莱欧斯利",
                    "text": "不会是想让我在你家办公，然后趁机窥探梅洛彼得堡的机密吧？"
                },
                {
                    "id": "690861102",
                    "speaker": "莱欧斯利",
                    "text": "那可能要让你失望了，因为大部分工作都是枯燥的账目。"
                },
                {
                    "id": "690861103",
                    "speaker": "莱欧斯利",
                    "text": "还是说，你愿意帮我算数学题？"
                }
            ]
        }
    ]
}