            "dialogues": [
                {
                    "id": "640150201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640150202",
                    "speaker": "法莉哈",
                    "text": "我是尼扎姆先生的秘书官，负责记录维齐尔相关的工作纪要。"
                },
                {
                    "id": "640150203",
                    "speaker": "法莉哈",
                    "text": "如果你看到尼扎姆先生板着个脸或者唉声叹气的，请不用在意，这只是他的常态罢了。"
                },
                {
                    "id": "640150204",
                    "speaker": "法莉哈",
                    "text": "你只需提出自己的诉求就好，他会安排处理的。"
                }
            ]
        },
        {
            "talkId": "6401503",
            "initDialog": "640150301",
            "dialogues": [
                {
                    "id": "640150301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640150302",
