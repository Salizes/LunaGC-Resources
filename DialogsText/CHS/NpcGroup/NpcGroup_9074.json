{
    "groupId": "9074",
    "total_dialogue_lines": 64,
    "speaker_counts": {
        "Player": 16,
        "莱依拉": 48
    },
    "talks": [
        {
            "talkId": "6907401",
            "initDialog": "690740101",
            "dialogues": [
                {
                    "id": "690740101",
                    "speaker": "莱依拉",
                    "text": "我还有几篇报告没写来着？嗯…四、不对…五篇…"
                },
                {
                    "id": "690740102",
                    "speaker": "莱依拉",
                    "text": "不行不行，总是这样担心来担心去，就失去了特意请假来这里休息的初衷了！"
                },
                {
                    "id": "690740103",
                    "speaker": "莱依拉",
                    "text": "#{NICKNAME}？你什么时候回来的？"
                }
            ]
        },
        {
            "talkId": "6907402",
            "initDialog": "690740201",
            "dialogues": [
                {
                    "id": "690740201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690740202",
                    "speaker": "莱依拉",
                    "text": "你放心，这里的陈设完全能满足我的日常需要，一点可抱怨的都没有。"
                },
                {
                    "id": "690740203",
                    "speaker": "莱依拉",
                    "text": "一般来说，我很在意住的地方有没有小飞虫之类的。"
                },
                {
                    "id": "690740204",
                    "speaker": "莱依拉",
                    "text": "你知道的，就是那种四处乱飞，发出嗡嗡声，还会时不时骚扰你的飞虫。",
                    "choices": [
                        {
                            "id": "690740205",
                            "text": "是说飞萤吧？",
                            "response": [
                                {
                                    "id": "690740206",
                                    "speaker": "莱依拉",
                                    "text": "对对，就是那一类小虫子。"
                                },
                                {
                                    "id": "690740209",
                                    "speaker": "莱依拉",
                                    "text": "别看它们小小的，但一到晚上夜深人静的时候，它们就会对着你的耳朵嗡嗡个不停，真的很烦人。"
                                },
                                {
                                    "id": "690740210",
                                    "speaker": "莱依拉",
                                    "text": "我之前常被这种小虫子折腾得睡不着，但在你这里就完全没有这种困扰。"
                                },
                                {
                                    "id": "690740211",
                                    "speaker": "莱依拉",
                                    "text": "又整洁又安静，真是失眠症患者的宝地！"
                                }
                            ]
                        },
                        {
                            "id": "690740207",
                            "text": "是说萤火虫吧？",
                            "response": [
                                {
                                    "id": "690740208",
                                    "speaker": "莱依拉",
                                    "text": "不对啦，就算我的专业不是昆虫研究，也知道萤火虫和那种小虫子，肯定不是一个种类。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907403",
            "initDialog": "690740301",
            "dialogues": [
                {
                    "id": "690740301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690740302",
                    "speaker": "莱依拉",
                    "text": "好呀，正好转换一下心情。"
                },
                {
                    "id": "690740303",
                    "speaker": "莱依拉",
                    "text": "唔…我想想有没有什么值得跟你分享的事…啊，有了！"
                },
                {
                    "id": "690740304",
                    "speaker": "莱依拉",
                    "text": "你知道那个吗？「研究室的叹息之灵」。"
                },
                {
                    "id": "690740305",
                    "speaker": "Player",
                    "text": "那是什么？"
                },
                {
                    "id": "690740306",
                    "speaker": "莱依拉",
                    "text": "#嘿嘿，看来消息灵通的{NICKNAME}还没听说过呀。"
                },
                {
                    "id": "690740307",
                    "speaker": "莱依拉",
                    "text": "我跟你说，我们学院里有一间特别的研究室，里面总是会发生怪事。"
                },
                {
                    "id": "690740308",
                    "speaker": "莱依拉",
                    "text": "有人晚上路过那间研究室的时候，听见里面有人在叹气。"
                },
                {
                    "id": "690740309",
                    "speaker": "莱依拉",
                    "text": "但是打开门一看，明明房间里没有亮光，也没有人。"
                },
                {
                    "id": "690740310",
                    "speaker": "莱依拉",
                    "text": "这种情况隔上三五天就发生一次，而且碰到过它的人，下次考试一定会考砸。",
                    "choices": [
                        {
                            "id": "690740311",
                            "text": "真的假的？",
                            "response": [
                                {
                                    "id": "690740313",
                                    "speaker": "莱依拉",
                                    "text": "欸，你不相信吗？我周围的同学里还是相信的人居多。"
                                },
                                {
                                    "id": "690740314",
                                    "speaker": "莱依拉",
                                    "text": "就算是不相信的，碰到那间研究室大多也会绕着走。"
                                },
                                {
                                    "id": "690740315",
                                    "speaker": "莱依拉",
                                    "text": "毕竟，大家都不想自己的考试运受到什么影响嘛。"
                                }
                            ]
                        },
                        {
                            "id": "690740312",
                            "text": "感觉是迷信…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907404",
            "initDialog": "690740401",
            "dialogues": [
                {
                    "id": "690740401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690740402",
                    "speaker": "莱依拉",
                    "text": "想做的事吗？那还挺多的呢。"
                },
                {
                    "id": "690740403",
                    "speaker": "莱依拉",
                    "text": "嗯…想好好睡上一觉，想把这么漂亮的地方逛个遍…能随随便便想出一大堆。"
                },
                {
                    "id": "690740404",
                    "speaker": "莱依拉",
                    "text": "但是要说当下、在这里，我最想做的事情是什么的话，那就是安心地「什么都不做」吧。",
                    "choices": [
                        {
                            "id": "690740405",
                            "text": "什么都不做？",
                            "response": [
                                {
                                    "id": "690740407",
                                    "speaker": "莱依拉",
                                    "text": "啊！你对我非常好，这里的环境也很让我自在…"
                                },
                                {
                                    "id": "690740408",
                                    "speaker": "莱依拉",
                                    "text": "我没有觉得哪里不好的意思，你千万不要误会！"
                                },
                                {
                                    "id": "690740409",
                                    "speaker": "Player",
                                    "text": "没事，慢慢说就好。"
                                },
                                {
                                    "id": "690740410",
                                    "speaker": "莱依拉",
                                    "text": "唔，好的…谢谢你。"
                                },
                                {
                                    "id": "690740411",
                                    "speaker": "莱依拉",
                                    "text": "呼…你看我，平时做事总是没有底气，会因为各种各样的事情着急或焦虑。"
                                },
                                {
                                    "id": "690740412",
                                    "speaker": "莱依拉",
                                    "text": "我有好多压力、好多苦恼…不知道自己够不够努力，不知道自己的未来什么样…"
                                },
                                {
                                    "id": "690740413",
                                    "speaker": "莱依拉",
                                    "text": "我没把握的东西太多了，学业也好，生活也好。"
                                },
                                {
                                    "id": "690740414",
                                    "speaker": "莱依拉",
                                    "text": "…总害怕自己不知不觉中错过了什么重要的东西，如果是这样的话，将来的我一定会后悔！"
                                },
                                {
                                    "id": "690740415",
                                    "speaker": "莱依拉",
                                    "text": "这样很累，恐怕也被你看出来了。所以你才会建议我请假，好好休息对吧？"
                                },
                                {
                                    "id": "690740416",
                                    "speaker": "Player",
                                    "text": "是有这种考虑。"
                                },
                                {
                                    "id": "690740417",
                                    "speaker": "莱依拉",
                                    "text": "嘿嘿，那我还是聪明的嘛…"
                                },
                                {
                                    "id": "690740418",
                                    "speaker": "莱依拉",
                                    "text": "所以，我就想着，得好好收下你的好意。彻彻底底地休息一会儿好了！"
                                },
                                {
                                    "id": "690740419",
                                    "speaker": "莱依拉",
                                    "text": "既然决定了要让自己的心也跟着放松，那就什么都不干、什么都不去担心。",
                                    "choices": [
                                        {
                                            "id": "690740420",
                                            "text": "干脆跟我来吧…",
                                            "response": [
                                                {
                                                    "id": "690740422",
                                                    "speaker": "莱依拉",
                                                    "text": "好呀！那我们就一起悠闲地发发呆吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690740421",
                                            "text": "陪你找片草坪躺一会儿。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690740406",
                            "text": "为什么这么说？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907405",
            "initDialog": "690740501",
            "dialogues": [
                {
                    "id": "690740501",
                    "speaker": "Player",
                    "text": "早啊，莱依拉。"
                },
                {
                    "id": "690740502",
                    "speaker": "莱依拉",
                    "text": "哦，早…嗯，早？怎么就天亮了啊？"
                },
                {
                    "id": "690740503",
                    "speaker": "莱依拉",
                    "text": "没有机会再努力一下了吗？我都还没怎么睡着呢…呜。"
                }
            ]
        },
        {
            "talkId": "6907406",
            "initDialog": "690740601",
            "dialogues": [
                {
                    "id": "690740601",
                    "speaker": "Player",
                    "text": "晚安，莱依拉。"
                },
                {
                    "id": "690740602",
                    "speaker": "莱依拉",
                    "text": "#嗯，晚安，{NICKNAME}，接下来就是一天中最重要的时间了。"
                },
                {
                    "id": "690740603",
                    "speaker": "莱依拉",
                    "text": "今天我再集中精神、努力尝试一下，心里什么都不要想，不想、不想…"
                },
                {
                    "id": "690740604",
                    "speaker": "莱依拉",
                    "text": "拜托了，今晚别再失眠了，拜托了拜托了。"
                }
            ]
        },
        {
            "talkId": "6907407",
            "initDialog": "690740701",
            "dialogues": [
                {
                    "id": "690740701",
                    "speaker": "莱依拉",
                    "text": "这里给人的感觉…嗯，和我自己的住所很像，温馨又熟悉。"
                },
                {
                    "id": "690740702",
                    "speaker": "莱依拉",
                    "text": "在这里休息的话，肯定很快就能放松下来。"
                },
                {
                    "id": "690740703",
                    "speaker": "莱依拉",
                    "text": "本来我还有点担心，万一自己不习惯你这里的床铺，万一…总之，我的担心是多余的。"
                }
            ]
        },
        {
            "talkId": "6907408",
            "initDialog": "690740801",
            "dialogues": [
                {
                    "id": "690740801",
                    "speaker": "莱依拉",
                    "text": "白色的小房子，各种须弥城里见不到的沙漠植物…嗯…我有答案了。"
                },
                {
                    "id": "690740802",
                    "speaker": "莱依拉",
                    "text": "是阿如村，对吗？让我回想起第一次去阿如村野外实践的日子了。"
                },
                {
                    "id": "690740803",
                    "speaker": "莱依拉",
                    "text": "有时间我给你说说当时发生的事吧，有不少有意思的呢。"
                }
            ]
        }
    ]
}