{
    "groupId": "6530",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "波波豪": 8
    },
    "talks": [
        {
            "talkId": "6653001",
            "initDialog": "665300101",
            "dialogues": [
                {
                    "id": "665300101",
                    "speaker": "波波豪",
                    "text": "悠悠纳塔，悠悠夏天！这位客人，欢迎来到特诺奇兹托克，欢迎来到悠悠度假村！登记入住请沿着沙滩往里走。"
                }
            ]
        },
        {
            "talkId": "6653002",
            "initDialog": "665300201",
            "dialogues": [
                {
                    "id": "665300201",
                    "speaker": "Player",
                    "text": "特诺奇兹托克…？"
                },
                {
                    "id": "665300202",
                    "speaker": "波波豪",
                    "text": "特诺奇兹托克就是这片岛屿的名字，也就是我们现在站的地方。"
                },
                {
                    "id": "665300203",
                    "speaker": "波波豪",
                    "text": "在本地语言里，这个名字的意思是「岩石与刺梨的洞穴」。"
                },
                {
                    "id": "665300204",
                    "speaker": "波波豪",
                    "text": "可惜刺梨现在已经不再生长了，不管是诺奇特梨还是娜娜丝梨，大概是土地的营养发生了变化吧。"
                }
            ]
        },
        {
            "talkId": "6653003",
            "initDialog": "665300301",
            "dialogues": [
                {
                    "id": "665300301",
                    "speaker": "Player",
                    "text": "悠悠度假村…？"
                },
                {
                    "id": "665300302",
                    "speaker": "波波豪",
                    "text": "欸？您难道不是收到了度假村的邀请函才过来的吗？那就让我为您再解答一下。"
                },
                {
                    "id": "665300303",
                    "speaker": "波波豪",
                    "text": "悠悠度假村是话事处兴建的一座大型夏日滨海度假区，内部还有分为多个不同的附属区域。它的选址就在纳塔最西边的特诺奇兹托克。"
                },
                {
                    "id": "665300304",
                    "speaker": "波波豪",
                    "text": "现在您只要顺着沙滩往里走可以办理入住，领取度假村纪念手册，然后开始您的夏日休闲之旅啦。"
                }
            ]
        },
        {
            "talkId": "6653004",
            "initDialog": "665300401",
            "dialogues": [
                {
                    "id": "665300401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "665300402",
                    "speaker": "波波豪",
                    "text": "别忘了去接待处领取纪念手册噢。"
                }
            ]
        }
    ]
}