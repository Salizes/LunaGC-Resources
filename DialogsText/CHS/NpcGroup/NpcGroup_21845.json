{
    "groupId": "21845",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "玛拉妮": 11
    },
    "talks": [
        {
            "talkId": "1504451",
            "initDialog": "150445101",
            "dialogues": [
                {
                    "id": "150445101",
                    "speaker": "玛拉妮",
                    "text": "蒙德的诗歌和纳塔的风格完全不一样呢，感觉细腻又温柔。"
                },
                {
                    "id": "150445102",
                    "speaker": "玛拉妮",
                    "text": "就像是…有一股环绕在身边的风。"
                },
                {
                    "id": "150445103",
                    "speaker": "玛拉妮",
                    "text": "…他的诗歌到底想表达什么呢？"
                }
            ]
        },
        {
            "talkId": "1504554",
            "initDialog": "150455401",
            "dialogues": [
                {
                    "id": "150455401",
                    "speaker": "玛拉妮",
                    "text": "来得正好！能帮我拍张照吗？"
                }
            ]
        },
        {
            "talkId": "1504581",
            "initDialog": "150458101",
            "dialogues": [
                {
                    "id": "150458101",
                    "speaker": "Player",
                    "text": "好呀。"
                },
                {
                    "id": "150458102",
                    "speaker": "玛拉妮",
                    "text": "谢谢，那我要摆出这个姿势！"
                },
                {
                    "id": "150458103",
                    "speaker": "Player",
                    "text": "我拍咯。"
                },
                {
                    "id": "150458104",
                    "speaker": "玛拉妮",
                    "text": "我看看…哇，真不错。角度和构图都很完美，谢谢你！"
                },
                {
                    "id": "150458105",
                    "speaker": "玛拉妮",
                    "text": "我要把它摆在床头…或者挂在墙上也行？"
                },
                {
                    "id": "150458106",
                    "speaker": "玛拉妮",
                    "text": "折些粉色和蓝色的彩纸，再捡些贝壳来装饰相框。哈哈，感觉一定很棒！"
                },
                {
                    "id": "150458107",
                    "speaker": "玛拉妮",
                    "text": "谢谢你还专程陪我满足了心愿，我会一直记得这个夏天的…"
                },
                {
                    "id": "150458108",
                    "speaker": "玛拉妮",
                    "text": "实在太开心啦——！"
                }
            ]
        },
        {
            "talkId": "1504582",
            "initDialog": "150458201",
            "dialogues": [
                {
                    "id": "150458201",
                    "speaker": "Player",
                    "text": "或许下次？"
                },
                {
                    "id": "150458202",
                    "speaker": "玛拉妮",
                    "text": "噢噢，没关系的！现在可是自由活动时间，你也要玩得开心哦！"
                }
            ]
        }
    ]
}