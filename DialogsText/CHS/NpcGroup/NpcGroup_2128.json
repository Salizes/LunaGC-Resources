{
    "groupId": "2128",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "秦夫人": 7
    },
    "talks": [
        {
            "talkId": "6212801",
            "initDialog": "621280101",
            "dialogues": [
                {
                    "id": "621280101",
                    "speaker": "秦夫人",
                    "text": "什么行李都不带，还是这样的旅行舒心啊…"
                },
                {
                    "id": "621280102",
                    "speaker": "秦夫人",
                    "text": "…呵呵，年轻人要趁着年轻加把劲啊，这样老了才能实现自己的梦想啊。"
                }
            ]
        },
        {
            "talkId": "6212802",
            "initDialog": "621280201",
            "dialogues": [
                {
                    "id": "621280201",
                    "speaker": "Player",
                    "text": "梦想？"
                },
                {
                    "id": "621280202",
                    "speaker": "秦夫人",
                    "text": "是啊，我年轻的时候就想要去四处旅游了，可是那时什么都想带上，实在是太麻烦了…"
                },
                {
                    "id": "621280203",
                    "speaker": "秦夫人",
                    "text": "当时我还在幻想要是能得到风元素的神之眼，到时候操控风元素托着房子四处旅行也是挺浪漫的，呵呵…"
                },
                {
                    "id": "621280204",
                    "speaker": "秦夫人",
                    "text": "不过后来我虽然没得到神之眼，但我终于醒悟了，最好的旅行啊，就是除了钱什么都不带。"
                },
                {
                    "id": "621280205",
                    "speaker": "秦夫人",
                    "text": "所以我攒了一辈子钱，就是为了这场旅行，缺什么直接买就好了，呵呵…"
                }
            ]
        },
        {
            "talkId": "6212803",
            "initDialog": "621280301",
            "dialogues": [
                {
                    "id": "621280301",
                    "speaker": "Player",
                    "text": "祝您旅途顺利。"
                },
                {
                    "id": "621280302",
                    "speaker": "秦夫人",
                    "text": "谢谢你，好孩子，也祝你顺利。"
                }
            ]
        }
    ]
}