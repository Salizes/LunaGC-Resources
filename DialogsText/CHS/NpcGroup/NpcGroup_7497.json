{
    "groupId": "7497",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "维赫洛夫": 8
    },
    "talks": [
        {
            "talkId": "6749701",
            "initDialog": "674970101",
            "dialogues": [
                {
                    "id": "674970101",
                    "speaker": "维赫洛夫",
                    "text": "嗯，怎么找不到呢…"
                }
            ]
        },
        {
            "talkId": "6749702",
            "initDialog": "674970201",
            "dialogues": [
                {
                    "id": "674970201",
                    "speaker": "Player",
                    "text": "你在找什么？"
                },
                {
                    "id": "674970202",
                    "speaker": "维赫洛夫",
                    "text": "呀！你、你好。没、没什么。"
                },
                {
                    "id": "674970203",
                    "speaker": "维赫洛夫",
                    "text": "就是一些、一些不重要的小信息，路线图什么的…"
                },
                {
                    "id": "674970204",
                    "speaker": "维赫洛夫",
                    "text": "我第一次来至冬堡，不太熟悉…没事，我、我自己找。"
                }
            ]
        },
        {
            "talkId": "6749703",
            "initDialog": "674970301",
            "dialogues": [
                {
                    "id": "674970301",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "674970302",
                    "speaker": "维赫洛夫",
                    "text": "谢、谢谢，好…"
                }
            ]
        },
        {
            "talkId": "6749704",
            "initDialog": "674970401",
            "dialogues": [
                {
                    "id": "674970401",
                    "speaker": "Player",
                    "text": "有问题的话，可以问问工作人员。"
                },
                {
                    "id": "674970402",
                    "speaker": "维赫洛夫",
                    "text": "啊，没事、没事…我自己来就好。"
                },
                {
                    "id": "674970403",
                    "speaker": "维赫洛夫",
                    "text": "这里工作人员…他们都很忙吧，拿这样的小事去问他们，会不会被笑话呢…"
                },
                {
                    "id": "674970404",
                    "speaker": "维赫洛夫",
                    "text": "父亲说过，至冬堡的一切，都不比在我们小镇，我得万事谨慎，不要让人瞧不上…还是不打扰他们了。"
                }
            ]
        }
    ]
}