{
    "groupId": "6394",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "豪特利": 10
    },
    "talks": [
        {
            "talkId": "6639401",
            "initDialog": "663940101",
            "dialogues": [
                {
                    "id": "663940101",
                    "speaker": "豪特利",
                    "text": "先把这些收拾一下，再把粮食搬进去吧…"
                }
            ]
        },
        {
            "talkId": "6639402",
            "initDialog": "663940201",
            "dialogues": [
                {
                    "id": "663940201",
                    "speaker": "Player",
                    "text": "需要帮忙吗？"
                },
                {
                    "id": "663940202",
                    "speaker": "豪特利",
                    "text": "嗯？哈哈，多谢你的热心！但这点小事就不用麻烦你啦，我自己来就好。"
                },
                {
                    "id": "663940203",
                    "speaker": "豪特利",
                    "text": "我和阿麦…哦，阿麦就是这头突角龙。我们原本是来送粮食的，没想到谷仓被一头暴走的龙撞到了…"
                },
                {
                    "id": "663940204",
                    "speaker": "豪特利",
                    "text": "算了算了，也不是什么大事，我来收拾一下就行。"
                }
            ]
        },
        {
            "talkId": "6639403",
            "initDialog": "663940301",
            "dialogues": [
                {
                    "id": "663940301",
                    "speaker": "Player",
                    "text": "你是谷仓的管理人吗？"
                },
                {
                    "id": "663940302",
                    "speaker": "豪特利",
                    "text": "啊，我不是管理人，只是个种地的。要是有什么作物育种、良种繁育、栽培与耕作方面的问题，倒是可以随时找我。"
                },
                {
                    "id": "663940303",
                    "speaker": "豪特利",
                    "text": "况且我们沃陆之邦的谷仓其实没有正式的管理人——或者换一种说法，人人都是管理人。"
                },
                {
                    "id": "663940304",
                    "speaker": "豪特利",
                    "text": "要是想吃什么的话，直接向负责统筹后勤的图娜卡说一声就好。"
                }
            ]
        },
        {
            "talkId": "6639404",
            "initDialog": "663940401",
            "dialogues": [
                {
                    "id": "663940401",
                    "speaker": "Player",
                    "text": "你的龙伙伴看上去好像有点迷茫？"
                },
                {
                    "id": "663940402",
                    "speaker": "豪特利",
                    "text": "嗯？让我看看…"
                },
                {
                    "id": "663940403",
                    "speaker": "豪特利",
                    "text": "哈哈，不用担心，这一看就是饿了。等我收拾完这些菜，就给阿麦多喂点吃的。"
                }
            ]
        },
        {
            "talkId": "6639405",
            "initDialog": "663940501",
            "dialogues": [
                {
                    "id": "663940501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "663940502",
                    "speaker": "豪特利",
                    "text": "嗯，再见。"
                }
            ]
        }
    ]
}