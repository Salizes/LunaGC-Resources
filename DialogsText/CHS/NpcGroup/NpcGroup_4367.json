{
    "groupId": "4367",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "寅杰": 10
    },
    "talks": [
        {
            "talkId": "6436701",
            "initDialog": "643670101",
            "dialogues": [
                {
                    "id": "643670101",
                    "speaker": "寅杰",
                    "text": "准备前往沙漠冒险的朋友，可以来我这里补充物资哦。"
                }
            ]
        },
        {
            "talkId": "6436702",
            "initDialog": "643670201",
            "dialogues": [
                {
                    "id": "643670201",
                    "speaker": "Player",
                    "text": "没想到能在这见到璃月人。"
                },
                {
                    "id": "643670202",
                    "speaker": "寅杰",
                    "text": "哈哈，说实话，我也没想到自己会在这里停留这么久！"
                },
                {
                    "id": "643670203",
                    "speaker": "寅杰",
                    "text": "我本来打算去沙漠淘金，看看能不能赚上一笔，结果发现和我有同样想法的人还挺多。"
                },
                {
                    "id": "643670204",
                    "speaker": "寅杰",
                    "text": "但他们很多人到了这个驿站后，却发现自己不是忘带了这个，就是没准备那个。"
                },
                {
                    "id": "643670205",
                    "speaker": "寅杰",
                    "text": "我转念一想，不如就在喀万驿做起生意来吧，专门为这些沙漠冒险家们提供查缺补漏的机会。"
                }
            ]
        },
        {
            "talkId": "6436703",
            "initDialog": "643670301",
            "dialogues": [
                {
                    "id": "643670301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643670302",
                    "speaker": "寅杰",
                    "text": "再见，预祝旅途顺利！"
                }
            ]
        },
        {
            "talkId": "6436704",
            "initDialog": "643670401",
            "dialogues": [
                {
                    "id": "643670401",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "643670402",
                    "speaker": "寅杰",
                    "text": "除了偶尔会被一种叫「沙尘滚滚中·包你不死·补给包」的神秘商品抢去一些生意以外，还挺不错的。"
                },
                {
                    "id": "643670403",
                    "speaker": "寅杰",
                    "text": "幸好售卖这种商品的百货商人神出鬼没，不常出现，所以不会太影响我的收入。"
                },
                {
                    "id": "643670404",
                    "speaker": "寅杰",
                    "text": "现在想想，当初放弃去沙漠冒险的决定非常正确。"
                },
                {
                    "id": "643670405",
                    "speaker": "寅杰",
                    "text": "虽说风险越大收益越高，但也不能完全忽视风险的存在啊，你说对吧。"
                }
            ]
        }
    ]
}