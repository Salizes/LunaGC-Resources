{
    "groupId": "5123",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "伊薇特": 17
    },
    "talks": [
        {
            "talkId": "6512301",
            "initDialog": "651230101",
            "dialogues": [
                {
                    "id": "651230101",
                    "speaker": "伊薇特",
                    "text": "小心，注意磕碰！工具不是活人，它们可不长眼。"
                }
            ]
        },
        {
            "talkId": "6512302",
            "initDialog": "651230201",
            "dialogues": [
                {
                    "id": "651230201",
                    "speaker": "Player",
                    "text": "您好。"
                },
                {
                    "id": "651230202",
                    "speaker": "伊薇特",
                    "text": "哎呦，好有礼貌的年轻人，看来不是那些刚加入刺玫会的愣头青。"
                },
                {
                    "id": "651230203",
                    "speaker": "伊薇特",
                    "text": "经常和那些冒失鬼打交道，搞得我脾气越来越暴了…当然，本来也没有好到哪里去吧。"
                }
            ]
        },
        {
            "talkId": "6512303",
            "initDialog": "651230301",
            "dialogues": [
                {
                    "id": "651230301",
                    "speaker": "Player",
                    "text": "感谢。"
                },
                {
                    "id": "651230302",
                    "speaker": "伊薇特",
                    "text": "不用客气，你别受伤就算是帮大忙了。"
                }
            ]
        },
        {
            "talkId": "6512304",
            "initDialog": "651230401",
            "dialogues": [
                {
                    "id": "651230401",
                    "speaker": "Player",
                    "text": "您是…"
                },
                {
                    "id": "651230402",
                    "speaker": "伊薇特",
                    "text": "忘了自我介绍，我是刺玫会的技术顾问。别看我一把年纪，脑子和手都还是好使的。"
                },
                {
                    "id": "651230403",
                    "speaker": "伊薇特",
                    "text": "虽然总是搞坏东西的新家伙们让人头疼，但别误会，我对刺玫会的这份工作是很满意的。"
                },
                {
                    "id": "651230404",
                    "speaker": "伊薇特",
                    "text": "以前在枫丹科学院，我因为脾气不好没法和人共事，最后索性辞职了。"
                },
                {
                    "id": "651230405",
                    "speaker": "伊薇特",
                    "text": "现在看来真是正确的决定，不然这把老骨头可能早就沉到海里去了。"
                },
                {
                    "id": "651230406",
                    "speaker": "伊薇特",
                    "text": "这边就不一样了，只要你有能力，无论是八岁还是八十岁，总能找到自己的用武之地。"
                }
            ]
        },
        {
            "talkId": "6512305",
            "initDialog": "651230501",
            "dialogues": [
                {
                    "id": "651230501",
                    "speaker": "伊薇特",
                    "text": "小心，注意磕碰！现在一片狼藉，别怪我没警告你。"
                }
            ]
        },
        {
            "talkId": "6512306",
            "initDialog": "651230601",
            "dialogues": [
                {
                    "id": "651230601",
                    "speaker": "Player",
                    "text": "您这是…"
                },
                {
                    "id": "651230602",
                    "speaker": "伊薇特",
                    "text": "嗯？是不是看我年纪大了，以为我会跟着其他人一起在避难所乖乖等这一切修好吗？"
                },
                {
                    "id": "651230603",
                    "speaker": "伊薇特",
                    "text": "哼，想得美！只要我还能用榔头敲碎鱼脑壳，那就还有力气干活。"
                },
                {
                    "id": "651230604",
                    "speaker": "伊薇特",
                    "text": "更何况现在正是需要技术顾问的时候，他们休想把我赶走。"
                }
            ]
        },
        {
            "talkId": "6512307",
            "initDialog": "651230701",
            "dialogues": [
                {
                    "id": "651230701",
                    "speaker": "Player",
                    "text": "感谢。"
                },
                {
                    "id": "651230702",
                    "speaker": "伊薇特",
                    "text": "不用客气，你别受伤就算是帮大忙了。"
                }
            ]
        },
        {
            "talkId": "7490801",
            "initDialog": "749080101",
            "dialogues": [
                {
                    "id": "749080101",
                    "speaker": "Player",
                    "text": "真幸运啊。"
                },
                {
                    "id": "749080102",
                    "speaker": "伊薇特",
                    "text": "是啊，也许这就是命运在告诉我：「这才是你正确的人生道路。」"
                },
                {
                    "id": "749080103",
                    "speaker": "伊薇特",
                    "text": "不过作为一名曾经的科研工作者，我这话说得太虚幻了。"
                },
                {
                    "id": "749080104",
                    "speaker": "伊薇特",
                    "text": "换种说法：有能力的人会得到认可，才是合理秩序下应当引导出的道路吧。"
                }
            ]
        }
    ]
}