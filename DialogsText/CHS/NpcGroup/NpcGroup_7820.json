    "talks": [
        {
            "talkId": "6782001",
            "initDialog": "678200101",
            "dialogues": [
                {
                    "id": "678200101",
                    "speaker": "柯察金",
                    "text": "列车怎么开得那么慢…这样还怎么及时赶到…"
                }
            ]
        },
        {
            "talkId": "6782002",
            "initDialog": "678200201",
            "dialogues": [
                {
                    "id": "678200201",
                    "speaker": "Player",
                    "text": "愚人众也坐列车？"
                },
                {
                    "id": "678200202",
                    "speaker": "柯察金",
                    "text": "愚人众为什么就不能坐列车了…愚人众就不是至冬人了？"
                },
                {
                    "id": "678200203",
                    "speaker": "柯察金",
                    "text": "而且，除了一些特殊情况，我们还报销不了买列车票的钱，我这还是自费的呢！"
                }
            ]
        },
        {
            "talkId": "6782003",
            "initDialog": "678200301",
            "dialogues": [
                {
                    "id": "678200301",
                    "speaker": "Player",
                    "text": "没有什么更快的办法？"
                },
                {
                    "id": "678200302",
                    "speaker": "柯察金",
                    "text": "没啦，从一个地方到另一个地方，在至冬，只有列车是最快的…"
                },
                {
                    "id": "678200303",
                    "speaker": "柯察金",
                    "text": "除非有人能…能顺着地脉嗖一下到达目的地！…不过世上哪有那样的人啊，哈哈。"
                }
            ]
        },
        {
            "talkId": "6782004",
            "initDialog": "678200401",
            "dialogues": [
                {
                    "id": "678200401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "678200402",
                    "speaker": "柯察金",
                    "text": "再见…唉，还要多久才能到啊…"
                }
            ]
        }
    ]
}