    },
    "talks": [
        {
            "talkId": "6314601",
            "initDialog": "631460101",
            "dialogues": [
                {
                    "id": "631460101",
                    "speaker": "大久保大介",
                    "text": "不愧是五郎大将，真是可靠…"
                }
            ]
        },
        {
            "talkId": "6314602",
            "initDialog": "631460201",
            "dialogues": [
                {
                    "id": "631460201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "631460202",
                    "speaker": "大久保大介",
                    "text": "我是珊瑚宫军队的武士，在五郎大将不在的时候，这里由我负责。"
                },
                {
                    "id": "631460203",
                    "speaker": "大久保大介",
                    "text": "你也听说了吧，我们可是在前线顶住了幕府大军的攻势！"
                },
                {
                    "id": "631460204",
                    "speaker": "大久保大介",
                    "text": "必须得说，正是因为有了五郎大将的领导，我们珊瑚宫军才能获得现在的成果！"
                }
            ]
        },
        {
            "talkId": "6314603",
            "initDialog": "631460301",
            "dialogues": [
                {
                    "id": "631460301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631460302",
                    "speaker": "大久保大介",
                    "text": "再见，要是我也能像五郎大将一样厉害…说笑了，哈哈！"
                }
            ]
        },
        {
            "talkId": "6314604",
            "initDialog": "631460401",
            "dialogues": [
                {
                    "id": "631460401",
                    "speaker": "Player",
                    "text": "关于五郎…"
                },
                {
                    "id": "631460402",
                    "speaker": "大久保大介",
                    "text": "五郎大将可以说是我最崇拜的人了，不仅在战场上有勇有谋，私下里还非常体恤手下，视我们为同生共死的手足。"
                },
                {
                    "id": "631460403",
                    "speaker": "大久保大介",
                    "text": "就连平常兄弟们生活里遇到的各种小事，五郎大将也都会耐心对待，帮我们排忧解难。"
                },
                {
                    "id": "631460404",
                    "speaker": "大久保大介",
                    "text": "这样好的将领，我敢说没有别的地方可以找到了！"
                }
            ]
        }
    ]
}