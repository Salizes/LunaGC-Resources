{
    "groupId": "30056",
    "total_dialogue_lines": 47,
    "speaker_counts": {
        "Player": 22,
        "阿贝多": 25
    },
    "talks": [
        {
            "talkId": "4001228",
            "initDialog": "400122801",
            "dialogues": [
                {
                    "id": "400122801",
                    "speaker": "阿贝多",
                    "text": "嗯？是你啊。来这里散步吗？",
                    "choices": [
                        {
                            "id": "400122802",
                            "text": "要不要聊聊天？",
                            "response": [
                                {
                                    "id": "400122803",
                                    "speaker": "阿贝多",
                                    "text": "可以，选话题就交给你了。",
                                    "choices": [
                                        {
                                            "id": "400122804",
                                            "text": "关于骑龙旅行的感受…",
                                            "response": [
                                                {
                                                    "id": "400122805",
                                                    "speaker": "阿贝多",
                                                    "text": "我做过各式各样的研究，但像这样骑着龙从蒙德飞到海岛…确实是第一次。"
                                                },
                                                {
                                                    "id": "400122806",
                                                    "speaker": "阿贝多",
                                                    "text": "不错的体验。人在空中时，由于四周风力太强，说话必须竭尽全力。"
                                                },
                                                {
                                                    "id": "400122807",
                                                    "speaker": "阿贝多",
                                                    "text": "难得大声跟别人交流，虽然话题我不怎么感兴趣，但方式很有趣。"
                                                },
                                                {
                                                    "id": "400122808",
                                                    "speaker": "阿贝多",
                                                    "text": "算得上是一段难忘的回忆。",
                                                    "choices": [
                                                        {
                                                            "id": "400122804",
                                                            "text": "关于骑龙旅行的感受…"
                                                        },
                                                        {
                                                            "id": "400122809",
                                                            "text": "关于海岛…",
                                                            "response": [
                                                                {
                                                                    "id": "400122810",
                                                                    "speaker": "阿贝多",
                                                                    "text": "这片群岛情况十分特殊，就像是一片封闭的秘境，只在特定时间开放。"
                                                                },
                                                                {
                                                                    "id": "400122811",
                                                                    "speaker": "阿贝多",
                                                                    "text": "即便如此，岛上却还是有人类存在过的痕迹。"
                                                                },
                                                                {
                                                                    "id": "400122812",
                                                                    "speaker": "阿贝多",
                                                                    "text": "此外，这里也有着各式各样的生命形式…"
                                                                },
                                                                {
                                                                    "id": "400122813",
                                                                    "speaker": "阿贝多",
                                                                    "text": "自从来到这里，我就一直在思考，生命的极限是什么？无论多孤独的地方，都会存在生命吗？",
                                                                    "choices": [
                                                                        {
                                                                            "id": "400122804",
                                                                            "text": "关于骑龙旅行的感受…"
                                                                        },
                                                                        {
                                                                            "id": "400122809",
                                                                            "text": "关于海岛…"
                                                                        },
                                                                        {
                                                                            "id": "400122814",
                                                                            "text": "关于阿贝多自己…",
                                                                            "response": [
                                                                                {
                                                                                    "id": "400122815",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "我？我在这里很好，谢谢你的关心。"
                                                                                },
                                                                                {
                                                                                    "id": "400122816",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "倒是你，在这里感觉如何？"
                                                                                },
                                                                                {
                                                                                    "id": "400122817",
                                                                                    "speaker": "Player",
                                                                                    "text": "还不错。"
                                                                                },
                                                                                {
                                                                                    "id": "400122818",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "嗯，那就好。"
                                                                                },
                                                                                {
                                                                                    "id": "400122819",
                                                                                    "speaker": "阿贝多",
                                                                                    "text": "这里有许多值得一画的景色。如果你想看，我可以带你去。",
                                                                                    "choices": [
                                                                                        {
                                                                                            "id": "400122804",
                                                                                            "text": "关于骑龙旅行的感受…"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122809",
                                                                                            "text": "关于海岛…"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122814",
                                                                                            "text": "关于阿贝多自己…"
                                                                                        },
                                                                                        {
                                                                                            "id": "400122820",
                                                                                            "text": "关于今天发生的事…",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "400122821",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "今天的事，好像没什么特别吧。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122822",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "唔？你是指，我一个人先离开之类的事吗？"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122823",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "那只是个人选择罢了。别在意，我有时会喜欢一个人待着。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122824",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "与人交流是件费神的事…如果让我选择一个聊天对象，我应该会选你。"
                                                                                                },
                                                                                                {
                                                                                                    "id": "400122825",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "你是聪明人，我喜欢和聪明的人对话。"
                                                                                                }
                                                                                            ]
                                                                                        },
                                                                                        {
                                                                                            "id": "400122826",
                                                                                            "text": "先不打扰你了。",
                                                                                            "response": [
                                                                                                {
                                                                                                    "id": "400122827",
                                                                                                    "speaker": "阿贝多",
                                                                                                    "text": "嗯。晚安。"
                                                                                                }
                                                                                            ]
                                                                                        }
                                                                                    ]
                                                                                }
                                                                            ]
                                                                        },
                                                                        {
                                                                            "id": "400122820",
                                                                            "text": "关于今天发生的事…"
                                                                        },
                                                                        {
                                                                            "id": "400122826",
                                                                            "text": "先不打扰你了。"
                                                                        }
                                                                    ]
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "400122814",
                                                            "text": "关于阿贝多自己…"
                                                        },
                                                        {
                                                            "id": "400122820",
                                                            "text": "关于今天发生的事…"
                                                        },
                                                        {
                                                            "id": "400122826",
                                                            "text": "先不打扰你了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "400122809",
                                            "text": "关于海岛…"
                                        },
                                        {
                                            "id": "400122814",
                                            "text": "关于阿贝多自己…"
                                        },
                                        {
                                            "id": "400122820",
                                            "text": "关于今天发生的事…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "400122826",
                            "text": "先不打扰你了。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "4001312",
            "initDialog": "400131201",
            "dialogues": [
                {
                    "id": "400131201",
                    "speaker": "阿贝多",
                    "text": "请不要用这种表情看着我。"
                },
                {
                    "id": "400131202",
                    "speaker": "阿贝多",
                    "text": "一开始就泄露谜底的话，游戏岂不是毫无乐趣了？"
                },
                {
                    "id": "400131203",
                    "speaker": "阿贝多",
                    "text": "这座岛适合可莉，也适合你。"
                },
                {
                    "id": "400131204",
                    "speaker": "阿贝多",
                    "text": "不觉得吗？夏天、岛屿、大海…虽然只是小小的海上乐园，却会全力服务于在此休憩的旅人。"
                },
                {
                    "id": "400131205",
                    "speaker": "阿贝多",
                    "text": "你可以在这里过一个美好的夏天。"
                }
            ]
        }
    ]
}