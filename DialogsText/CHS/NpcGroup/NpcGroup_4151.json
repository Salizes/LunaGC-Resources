{
    "groupId": "4151",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "巴巴尔": 6
    },
    "talks": [
        {
            "talkId": "6415101",
            "initDialog": "641510101",
            "dialogues": [
                {
                    "id": "641510101",
                    "speaker": "巴巴尔",
                    "text": "我要是有钱的话，就把全须弥的香料都买下来，哈哈！"
                }
            ]
        },
        {
            "talkId": "6415102",
            "initDialog": "641510201",
            "dialogues": [
                {
                    "id": "641510201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641510202",
                    "speaker": "巴巴尔",
                    "text": "像我这样从沙漠来的商人，其实很少做香料买卖。"
                },
                {
                    "id": "641510203",
                    "speaker": "巴巴尔",
                    "text": "既然有出入沙漠的能耐，大家肯定要做特产生意。"
                },
                {
                    "id": "641510204",
                    "speaker": "巴巴尔",
                    "text": "但我实在很喜欢须弥的香料。不同的搭配，和不同比例…每次都能呈现出新的美味！"
                },
                {
                    "id": "641510205",
                    "speaker": "巴巴尔",
                    "text": "这种美味，可是你在须弥以外的地方见不到的哦？"
                }
            ]
        },
        {
            "talkId": "6415103",
            "initDialog": "641510301",
            "dialogues": [
                {
                    "id": "641510301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641510302",
                    "speaker": "巴巴尔",
                    "text": "再见，祝你早日染上须弥的香气！"
                }
            ]
        }
    ]
}