{
    "groupId": "2200",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "仲林": 12
    },
    "talks": [
        {
            "talkId": "7192801",
            "initDialog": "719280101",
            "dialogues": [
                {
                    "id": "719280101",
                    "speaker": "Player",
                    "text": "须弥的蘑菇很特别吗？"
                },
                {
                    "id": "719280102",
                    "speaker": "仲林",
                    "text": "唔…你这个问题，我也不太好回答你啊，毕竟我也不是植物学家什么的…"
                },
                {
                    "id": "719280103",
                    "speaker": "仲林",
                    "text": "光是看表面，似乎也没什么特别的…可能口感会不太一样？"
                },
                {
                    "id": "719280104",
                    "speaker": "仲林",
                    "text": "要不这蘑菇你拿回去做些料理试试，如果好吃的话，帮我给身边的人宣传宣传就是了，哈哈哈哈！"
                }
            ]
        },
        {
            "talkId": "6220001",
            "initDialog": "622000101",
            "dialogues": [
                {
                    "id": "622000101",
                    "speaker": "仲林",
                    "text": "您好您好。这位置没人，我不介意拼桌。"
                }
            ]
        },
        {
            "talkId": "6220002",
            "initDialog": "622000201",
            "dialogues": [
                {
                    "id": "622000201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "622000202",
                    "speaker": "仲林",
                    "text": "我叫仲林，是个游商。家住…不知道算轻策庄还是算城里。"
                }
            ]
        },
        {
            "talkId": "6220003",
            "initDialog": "622000301",
            "dialogues": [
                {
                    "id": "622000301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622000302",
                    "speaker": "仲林",
                    "text": "再见。下次遇到还请惠顾惠顾啊。"
                }
            ]
        },
        {
            "talkId": "6220004",
            "initDialog": "622000203",
            "dialogues": [
                {
                    "id": "622000203",
                    "speaker": "Player",
                    "text": "关于生意…"
                },
                {
                    "id": "622000204",
                    "speaker": "仲林",
                    "text": "我的生意？当然小买卖啦。在七星的手腕下面捡点漏下的生意。"
                },
                {
                    "id": "622000205",
                    "speaker": "仲林",
                    "text": "不过游商嘛，奈何百货卖不赢大手，那当然就是奇货啦。"
                },
                {
                    "id": "622000206",
                    "speaker": "仲林",
                    "text": "给你瞧瞧，须弥的蘑菇，没见过吧。"
                }
            ]
        },
        {
            "talkId": "6220005",
            "initDialog": "622000207",
            "dialogues": [
                {
                    "id": "622000207",
                    "speaker": "Player",
                    "text": "关于老家…"
                },
                {
                    "id": "622000208",
                    "speaker": "仲林",
                    "text": "老婆在城里，家里老人和女儿在轻策山住。"
                },
                {
                    "id": "622000209",
                    "speaker": "仲林",
                    "text": "所以你说我算什么人？我也不知道我算什么人了。"
                },
                {
                    "id": "622000210",
                    "speaker": "仲林",
                    "text": "这么说来，您是哪里人啊？"
                }
            ]
        }
    ]
}