{
    "groupId": "7063",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "帕霍": 8
    },
    "talks": [
        {
            "talkId": "6706301",
            "initDialog": "670630101",
            "dialogues": [
                {
                    "id": "670630101",
                    "speaker": "帕霍",
                    "text": "我们家的推荐饮品嘛…我推荐您少喝一点！"
                }
            ]
        },
        {
            "talkId": "6706302",
            "initDialog": "670630201",
            "dialogues": [
                {
                    "id": "670630201",
                    "speaker": "Player",
                    "text": "竟然会有服务员劝大家不要消费的…"
                },
                {
                    "id": "670630202",
                    "speaker": "帕霍",
                    "text": "嘿嘿，所以我肯定是值得信赖的好人！听我的推荐没错的，不如试试我们家的食物和软饮？都很棒哦！"
                }
            ]
        },
        {
            "talkId": "6706303",
            "initDialog": "670630301",
            "dialogues": [
                {
                    "id": "670630301",
                    "speaker": "Player",
                    "text": "要是被老板知道了，会有麻烦吧？"
                },
                {
                    "id": "670630302",
                    "speaker": "帕霍",
                    "text": "正相反！客人要是喝醉了会有臭烘烘的味道，脾气也会变得很坏，还会跟人动起手来，到时候酒瓶板凳满天飞！"
                },
                {
                    "id": "670630303",
                    "speaker": "帕霍",
                    "text": "只有像我这样的好员工，才会替老板提前考虑。您说是不是！"
                }
            ]
        },
        {
            "talkId": "6706304",
            "initDialog": "670630401",
            "dialogues": [
                {
                    "id": "670630401",
                    "speaker": "Player",
                    "text": "暂时不需要，多谢。"
                },
                {
                    "id": "670630402",
                    "speaker": "帕霍",
                    "text": "嗯！如果您有什么事，请随时招呼我。"
                }
            ]
        },
        {
            "talkId": "6706305",
            "initDialog": "670630501",
            "dialogues": [
                {
                    "id": "670630501",
                    "speaker": "Player",
                    "text": "那，有没有值得信赖的情报呢？"
                },
                {
                    "id": "670630502",
                    "speaker": "帕霍",
                    "text": "啊，原来您是这种类型的客人呐。情报的话没有，毕竟，谁会对服务员说这种重要的事呢？但八卦嘛…"
                },
                {
                    "id": "670630503",
                    "speaker": "帕霍",
                    "text": "你看到那边褐色头发的小哥了么？对，就是那个宝藏猎人，他是——「斯佩兰扎」老板的儿子呢！"
                }
            ]
        },
        {
            "talkId": "6706306",
            "initDialog": "670630601",
            "dialogues": [
                {
                    "id": "670630601",
                    "speaker": "Player",
                    "text": "好吧…"
                },
                {
                    "id": "670630602",
                    "speaker": "帕霍",
                    "text": "噢！所以您是要打听「那种」八卦吗？也有哦！不过，那都是餐后附赠的。八卦嘛，得配点美食才更有味！"
                }
            ]
        }
    ]
}