{
    "groupId": "6098",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "霍娅": 13
    },
    "talks": [
        {
            "talkId": "6609801",
            "initDialog": "660980101",
            "dialogues": [
                {
                    "id": "660980101",
                    "speaker": "霍娅",
                    "text": "你好，朋友，需要送信吗？"
                }
            ]
        },
        {
            "talkId": "6609802",
            "initDialog": "660980201",
            "dialogues": [
                {
                    "id": "660980201",
                    "speaker": "Player",
                    "text": "你是邮差吗？"
                },
                {
                    "id": "660980202",
                    "speaker": "霍娅",
                    "text": "差不多吧。我们悬木人擅长在树林中高速穿梭，所以承担起了大部分的信使工作。"
                },
                {
                    "id": "660980203",
                    "speaker": "霍娅",
                    "text": "我们会在各地建立「讯使长屋」，帮不同部族的人运送信件、包裹之类的东西。"
                },
                {
                    "id": "660980204",
                    "speaker": "霍娅",
                    "text": "有时也会帮他们拉拉人头，协助合作。"
                }
            ]
        },
        {
            "talkId": "6609803",
            "initDialog": "660980301",
            "dialogues": [
                {
                    "id": "660980301",
                    "speaker": "Player",
                    "text": "暂时不用。"
                },
                {
                    "id": "660980302",
                    "speaker": "霍娅",
                    "text": "那不打扰了。"
                }
            ]
        },
        {
            "talkId": "6609804",
            "initDialog": "660980401",
            "dialogues": [
                {
                    "id": "660980401",
                    "speaker": "Player",
                    "text": "什么样的合作？"
                },
                {
                    "id": "660980402",
                    "speaker": "霍娅",
                    "text": "还挺多的呢，我想想…"
                },
                {
                    "id": "660980403",
                    "speaker": "霍娅",
                    "text": "有时冒险家们会请流泉之众的人做向导，或者请烟谜主的医生出诊，如果自己联系不到人脉，倒是可以让我帮忙传个信。"
                },
                {
                    "id": "660980404",
                    "speaker": "霍娅",
                    "text": "大伙儿都有自己擅长或不擅长的事情嘛，互相帮助是应该的。"
                }
            ]
        },
        {
            "talkId": "6609805",
            "initDialog": "660980501",
            "dialogues": [
                {
                    "id": "660980501",
                    "speaker": "Player",
                    "text": "什么样的合作？"
                },
                {
                    "id": "660980502",
                    "speaker": "霍娅",
                    "text": "还挺多的呢，我想想…"
                },
                {
                    "id": "660980503",
                    "speaker": "霍娅",
                    "text": "有时冒险家们会请流泉之众的人做向导，或者请烟谜主的医生出诊，如果自己联系不到人脉，倒是可以让我帮忙传个信。"
                },
                {
                    "id": "660980504",
                    "speaker": "霍娅",
                    "text": "大伙儿都有自己擅长或不擅长的事情嘛，互相帮助是应该的。"
                },
                {
                    "id": "660980505",
                    "speaker": "霍娅",
                    "text": "就像之前应对深渊的时候，需要送的信源源不断，我忙了好一阵，后来还休息了很长一段时间。"
                },
                {
                    "id": "660980506",
                    "speaker": "霍娅",
                    "text": "不过多谢诸位英雄，今后应该不会再有类似的战争了吧。"
                }
            ]
        }
    ]
}