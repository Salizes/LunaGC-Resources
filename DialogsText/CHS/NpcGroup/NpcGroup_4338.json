{
    "groupId": "4338",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "哈兹姆": 11
    },
    "talks": [
        {
            "talkId": "6433801",
            "initDialog": "643380101",
            "dialogues": [
                {
                    "id": "643380101",
                    "speaker": "哈兹姆",
                    "text": "现在的学生，真是越来越静不下心来了。"
                }
            ]
        },
        {
            "talkId": "6433802",
            "initDialog": "643380201",
            "dialogues": [
                {
                    "id": "643380201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "643380202",
                    "speaker": "哈兹姆",
                    "text": "唉…你好，请说吧。"
                },
                {
                    "id": "643380203",
                    "speaker": "哈兹姆",
                    "text": "嗯？原来不是来找我问问题的学生吗？"
                },
                {
                    "id": "643380204",
                    "speaker": "哈兹姆",
                    "text": "那太好了。"
                }
            ]
        },
        {
            "talkId": "6433803",
            "initDialog": "643380301",
            "dialogues": [
                {
                    "id": "643380301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643380302",
                    "speaker": "哈兹姆",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6433804",
            "initDialog": "643380401",
            "dialogues": [
                {
                    "id": "643380401",
                    "speaker": "Player",
                    "text": "不可以问问题吗？"
                },
                {
                    "id": "643380402",
                    "speaker": "哈兹姆",
                    "text": "当然可以问，但关键要看是什么样的问题。"
                },
                {
                    "id": "643380403",
                    "speaker": "哈兹姆",
                    "text": "现在的学生啊，连书本上的字都还没读全，就忙着问东问西。先把已有的基础知识了解透彻，难道很难做到吗？"
                },
                {
                    "id": "643380404",
                    "speaker": "哈兹姆",
                    "text": "被这些小混账们天天骚扰，时间长了，我这脾气也越来越差了。"
                },
                {
                    "id": "643380405",
                    "speaker": "哈兹姆",
                    "text": "不过后来我学着以前的老同学提纳里的样子教训了几句：「别动，别碰，不懂就别问！」"
                },
                {
                    "id": "643380406",
                    "speaker": "哈兹姆",
                    "text": "在那之后，他们好像摸出了些门道，不再拿那些蠢问题来烦我了。"
                },
                {
                    "id": "643380407",
                    "speaker": "哈兹姆",
                    "text": "办法虽然粗暴了点，但总之让他们学会独立思考了吧。"
                }
            ]
        }
    ]
}