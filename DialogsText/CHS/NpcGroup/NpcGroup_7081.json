{
    "groupId": "7081",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 4,
        "奈芙尔": 2,
        "维贾米": 17
    },
    "talks": [
        {
            "talkId": "5900279",
            "initDialog": "590027901",
            "dialogues": [
                {
                    "id": "590027901",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900280",
            "initDialog": "590028001",
            "dialogues": [
                {
                    "id": "590028001",
                    "speaker": "维贾米",
                    "text": "处处皆是，也处处皆无。能在安稳的日常中找到内心的平静，才是最值得留意的珍宝。莫要执着于外物，知足才能常乐呀，朋友。"
                }
            ]
        },
        {
            "talkId": "6708101",
            "initDialog": "670810101",
            "dialogues": [
                {
                    "id": "670810101",
                    "speaker": "维贾米",
                    "text": "在这里，能在早晨平安苏醒以迎接新的一日，能在夜晚安眠并步入梦中…这一切对我来说都已经足够了。"
                }
            ]
        },
        {
            "talkId": "6708102",
            "initDialog": "670810201",
            "dialogues": [
                {
                    "id": "670810201",
                    "speaker": "Player",
                    "text": "或许应该有更高的要求？"
                },
                {
                    "id": "670810202",
                    "speaker": "维贾米",
                    "text": "或许人本来就不应该有更高的要求，得到让你能够安稳度日的所有之后，又为什么需要苛求更多呢。"
                },
                {
                    "id": "670810203",
                    "speaker": "维贾米",
                    "text": "曾经我也是个野心勃勃的人，可不合时宜的野心摧毁了一切…我失去了曾经拥有的财富，因走私而被追捕，因海难妻离子散。"
                },
                {
                    "id": "670810204",
                    "speaker": "维贾米",
                    "text": "回过头来，现在，我什么都未拥有，但也不会再失去了。"
                },
                {
                    "id": "670810205",
                    "speaker": "维贾米",
                    "text": "这样不好吗？"
                }
            ]
        },
        {
            "talkId": "6708103",
            "initDialog": "670810301",
            "dialogues": [
                {
                    "id": "670810301",
                    "speaker": "Player",
                    "text": "这样也挺不错的。"
                },
                {
                    "id": "670810302",
                    "speaker": "维贾米",
                    "text": "是啊，人总想得到更多，但人的能力是有限的。而大多数人的欲望总是会膨胀得远超其能力所能拥有…"
                },
                {
                    "id": "670810303",
                    "speaker": "维贾米",
                    "text": "这就是野心和欲望的可怕之处。"
                },
                {
                    "id": "670810304",
                    "speaker": "维贾米",
                    "text": "想想吧，如果你在攀登一座没有顶峰的山，那无论如何…你要么死在山上，要么你终究会从高处跌落。"
                },
                {
                    "id": "670810305",
                    "speaker": "维贾米",
                    "text": "知足才能常乐，孩子。"
                }
            ]
        },
        {
            "talkId": "6708104",
            "initDialog": "670810401",
            "dialogues": [
                {
                    "id": "670810401",
                    "speaker": "Player",
                    "text": "再见，希望今天也是安稳的一天。"
                },
                {
                    "id": "670810402",
                    "speaker": "维贾米",
                    "text": "希望一切如你所说，孩子。"
                }
            ]
        },
        {
            "talkId": "6708105",
            "initDialog": "670810501",
            "dialogues": [
                {
                    "id": "670810501",
                    "speaker": "维贾米",
                    "text": "（<color=#FFCC33FF>奈芙尔</color>似乎有所思考…）"
                },
                {
                    "id": "670810502",
                    "speaker": "维贾米",
                    "text": "奈芙尔老板，您怎么来了。我已经没了筹码，上不了您的牌桌了。"
                },
                {
                    "id": "670810503",
                    "speaker": "奈芙尔",
                    "text": "就算上不了牌桌，您也依旧是高明的牌手，不是吗？"
                },
                {
                    "id": "670810504",
                    "speaker": "维贾米",
                    "text": "……"
                },
                {
                    "id": "670810505",
                    "speaker": "维贾米",
                    "text": "抱歉，奈芙尔老板。我已经不再希求那些…我曾经想要拥有的东西了。"
                },
                {
                    "id": "670810506",
                    "speaker": "维贾米",
                    "text": "我只想安静的生活，知足常乐。"
                },
                {
                    "id": "670810507",
                    "speaker": "奈芙尔",
                    "text": "嗯，那我就祝您能找到真正的安宁吧，维贾米先生。"
                },
                {
                    "id": "670810508",
                    "speaker": "维贾米",
                    "text": "呵呵，真正的安宁…我会找到它的，我们每个人，最终都会找到它。"
                }
            ]
        }
    ]
}