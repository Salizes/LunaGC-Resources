{
    "groupId": "5223",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "瑟维妮": 12
    },
    "talks": [
        {
            "talkId": "6522301",
            "initDialog": "652230101",
            "dialogues": [
                {
                    "id": "652230101",
                    "speaker": "瑟维妮",
                    "text": "您好。有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6522302",
            "initDialog": "652230201",
            "dialogues": [
                {
                    "id": "652230201",
                    "speaker": "Player",
                    "text": "关于试验机…"
                },
                {
                    "id": "652230202",
                    "speaker": "瑟维妮",
                    "text": "在那之后已经顺利回收了，把它们运出去可真费了一番工夫呢。"
                },
                {
                    "id": "652230203",
                    "speaker": "瑟维妮",
                    "text": "而且检查之后发现，这两台试验机应该是彻底报废了，毕竟很长一段时间都没人维护，再加上…"
                },
                {
                    "id": "652230204",
                    "speaker": "瑟维妮",
                    "text": "哦，我没有指责您的意思，毕竟有了新玩具的梅雅德前辈本人也已经将试验机的事抛在脑后了。"
                },
                {
                    "id": "652230205",
                    "speaker": "瑟维妮",
                    "text": "就连回收和检查工作也委托给他人，唉，我原以为能够趁这个机会和他见上一面呢。看来只能我自己找机会去伊黎耶岛见他了…"
                }
            ]
        },
        {
            "talkId": "6522303",
            "initDialog": "652230301",
            "dialogues": [
                {
                    "id": "652230301",
                    "speaker": "Player",
                    "text": "关于肖像画…"
                },
                {
                    "id": "652230302",
                    "speaker": "瑟维妮",
                    "text": "那个呀…博絮埃先生居然没把它带回佩特莉可镇，这点确实让我很意外。"
                },
                {
                    "id": "652230303",
                    "speaker": "瑟维妮",
                    "text": "毕竟留在这里的话，说不准哪天就会被人泼上墨水或者其他更难清洁的涂料…"
                },
                {
                    "id": "652230304",
                    "speaker": "瑟维妮",
                    "text": "我心中倒是有几个嫌疑人的人选，不过最后被选中去梅洛彼得堡的大概会是希塞蕾前辈吧。"
                },
                {
                    "id": "652230305",
                    "speaker": "瑟维妮",
                    "text": "哎呀哎呀，在这种职场，真心话还是不要挂在嘴边为妙。"
                }
            ]
        },
        {
            "talkId": "6522304",
            "initDialog": "652230401",
            "dialogues": [
                {
                    "id": "652230401",
                    "speaker": "Player",
                    "text": "没事，打扰了。"
                },
                {
                    "id": "652230402",
                    "speaker": "瑟维妮",
                    "text": "那就祝您今天也度过愉快的一天。"
                }
            ]
        },
        {
            "talkId": "6522305",
            "initDialog": "652230501",
            "dialogues": [
                {
                    "id": "652230501",
                    "speaker": "Player",
                    "text": "关于梅雅德…"
                },
                {
                    "id": "652230502",
                    "speaker": "瑟维妮",
                    "text": "客观地说，「冰风组曲」的商业价值当然是比不上枫达了，毕竟原方案是由博絮埃先生提出的…"
                },
                {
                    "id": "652230503",
                    "speaker": "瑟维妮",
                    "text": "由前辈接手之后又加入了他独特的感性…但是在我看来，这个项目就和他本人一样，该怎么说呢？有发展潜力？"
                }
            ]
        }
    ]
}