{
    "groupId": "4195",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "兰非拉": 13
    },
    "talks": [
        {
            "talkId": "6419501",
            "initDialog": "641950101",
            "dialogues": [
                {
                    "id": "641950101",
                    "speaker": "兰非拉",
                    "text": "好可怕，还以为要被兰帕卡提煮成杂烩粥了…还好摘了许多果子。"
                }
            ]
        },
        {
            "talkId": "6419502",
            "initDialog": "641950201",
            "dialogues": [
                {
                    "id": "641950201",
                    "speaker": "Player",
                    "text": "关于兰帕卡提…"
                },
                {
                    "id": "641950202",
                    "speaker": "兰非拉",
                    "text": "刚刚给了妹妹几颗「鲜嫩无朋之果」，她吃了果子，不那么生气了。"
                },
                {
                    "id": "641950203",
                    "speaker": "兰非拉",
                    "text": "她上一次生气还是因为我们在桓那兰那弄出了许多烟。"
                },
                {
                    "id": "641950204",
                    "speaker": "兰非拉",
                    "text": "等到下次，我再给她几颗「鲜嫩无朋之果」…"
                },
                {
                    "id": "641950205",
                    "speaker": "兰非拉",
                    "text": "不对，还是不要有下次。"
                }
            ]
        },
        {
            "talkId": "6419503",
            "initDialog": "641950301",
            "dialogues": [
                {
                    "id": "641950301",
                    "speaker": "Player",
                    "text": "关于果子…"
                },
                {
                    "id": "641950302",
                    "speaker": "兰非拉",
                    "text": "#因为那菈{NICKNAME}的帮助，我带了许多「鲜嫩无朋之果」回来。"
                },
                {
                    "id": "641950303",
                    "speaker": "兰非拉",
                    "text": "等到无忧节，一定让大家见识一下我修行的成果。"
                }
            ]
        },
        {
            "talkId": "6419504",
            "initDialog": "641950401",
            "dialogues": [
                {
                    "id": "641950401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641950402",
                    "speaker": "兰非拉",
                    "text": "嗯！"
                }
            ]
        },
        {
            "talkId": "6419505",
            "initDialog": "641950501",
            "dialogues": [
                {
                    "id": "641950501",
                    "speaker": "兰非拉",
                    "text": "「鲜嫩无朋之果」是强壮的树的恩惠…而莎兰树和觉王树是最强壮的树…"
                }
            ]
        },
        {
            "talkId": "6419506",
            "initDialog": "641950601",
            "dialogues": [
                {
                    "id": "641950601",
                    "speaker": "Player",
                    "text": "关于莎兰树…"
                },
                {
                    "id": "641950602",
                    "speaker": "兰非拉",
                    "text": "莎兰树那么强壮的树，结出的恒素果是什么样的滋味呢…"
                }
            ]
        },
        {
            "talkId": "6419507",
            "initDialog": "641950701",
            "dialogues": [
                {
                    "id": "641950701",
                    "speaker": "Player",
                    "text": "关于觉王树…"
                },
                {
                    "id": "641950702",
                    "speaker": "兰非拉",
                    "text": "惟耶之实是最强壮最强壮，可以成为觉王树的莎兰树才能结出的果子。味道一定很好。"
                },
                {
                    "id": "641950703",
                    "speaker": "兰非拉",
                    "text": "如果有那菈吃了惟耶之实，以后一定会不喜欢其他果子，因为已经吃过森林里最厉害最厉害的果实了。"
                }
            ]
        },
        {
            "talkId": "6419508",
            "initDialog": "641950801",
            "dialogues": [
                {
                    "id": "641950801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641950802",
                    "speaker": "兰非拉",
                    "text": "是什么味道呢…"
                }
            ]
        }
    ]
}