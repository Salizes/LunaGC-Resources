{
    "groupId": "7546",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "伊娜": 14
    },
    "talks": [
        {
            "talkId": "6754601",
            "initDialog": "675460101",
            "dialogues": [
                {
                    "id": "675460101",
                    "speaker": "伊娜",
                    "text": "来试试「雪巷飞渡」吧！马上就热起来了！"
                }
            ]
        },
        {
            "talkId": "6754602",
            "initDialog": "675460201",
            "dialogues": [
                {
                    "id": "675460201",
                    "speaker": "Player",
                    "text": "想来试试！"
                },
                {
                    "id": "675460202",
                    "speaker": "伊娜",
                    "text": "路线我已经规划好了，你只需在我设定的地方，跟随指引，就能顺利完成「雪巷飞渡」！"
                },
                {
                    "id": "675460203",
                    "speaker": "伊娜",
                    "text": "完成后，你将获得我准备的小礼物。"
                },
                {
                    "id": "675460204",
                    "speaker": "伊娜",
                    "text": "当然，如果你还愿意帮我宣传宣传这项运动，就再好不过了…"
                }
            ]
        },
        {
            "talkId": "6754603",
            "initDialog": "675460301",
            "dialogues": [
                {
                    "id": "675460301",
                    "speaker": "Player",
                    "text": "「雪巷飞渡」是什么？"
                },
                {
                    "id": "675460302",
                    "speaker": "伊娜",
                    "text": "哈哈，这是一项我自创的运动，不需要太多技巧，只要你会跑，就能参加。"
                },
                {
                    "id": "675460303",
                    "speaker": "伊娜",
                    "text": "这冰天雪地的，我的头发都快冻成冰碴子咯…但如果跑完一趟「雪巷飞渡」，效果比喝上一壶烈酒还要好。"
                }
            ]
        },
        {
            "talkId": "6754604",
            "initDialog": "675460401",
            "dialogues": [
                {
                    "id": "675460401",
                    "speaker": "Player",
                    "text": "浑身都是暖暖的…"
                },
                {
                    "id": "675460402",
                    "speaker": "伊娜",
                    "text": "太好了！我相信，你已经充分体会到了这项运动的妙处——"
                },
                {
                    "id": "675460403",
                    "speaker": "伊娜",
                    "text": "要是你四肢麻木、关节僵硬就出门，肯定会在雪地里摔一跤的！"
                }
            ]
        },
        {
            "talkId": "6754605",
            "initDialog": "675460501",
            "dialogues": [
                {
                    "id": "675460501",
                    "speaker": "Player",
                    "text": "现在暂时没空…"
                },
                {
                    "id": "675460502",
                    "speaker": "伊娜",
                    "text": "真可惜啊…等你有空再来试试吧！"
                }
            ]
        },
        {
            "talkId": "6754606",
            "initDialog": "675460601",
            "dialogues": [
                {
                    "id": "675460601",
                    "speaker": "伊娜",
                    "text": "完成了「雪巷飞渡」啊！有感觉身体热起来了吗？"
                }
            ]
        },
        {
            "talkId": "6754607",
            "initDialog": "675460701",
            "dialogues": [
                {
                    "id": "675460701",
                    "speaker": "伊娜",
                    "text": "帮忙宣传「雪巷飞渡」吧！一项让人马上就热起来的运动！"
                }
            ]
        },
        {
            "talkId": "6754608",
            "initDialog": "675460801",
            "dialogues": [
                {
                    "id": "675460801",
                    "speaker": "Player",
                    "text": "「雪巷飞渡」是什么？"
                },
                {
                    "id": "675460802",
                    "speaker": "伊娜",
                    "text": "哈哈，这是一项我自创的运动，不需要太多技巧，只要你会跑，就能参加。"
                },
                {
                    "id": "675460803",
                    "speaker": "伊娜",
                    "text": "这冰天雪地的，我的头发都快冻成冰碴子咯…但如果跑完一趟「雪巷飞渡」，效果比喝上一壶烈酒还要好。"
                }
            ]
        },
        {
            "talkId": "6754609",
            "initDialog": "675460901",
            "dialogues": [
                {
                    "id": "675460901",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "675460902",
                    "speaker": "伊娜",
                    "text": "再见。"
                }
            ]
        }
    ]
}