{
    "groupId": "1837",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "长孙继璟": 7
    },
    "talks": [
        {
            "talkId": "6183701",
            "initDialog": "618370101",
            "dialogues": [
                {
                    "id": "618370101",
                    "speaker": "长孙继璟",
                    "text": "此处云气虽盛，却为何迟迟不降甘霖…"
                }
            ]
        },
        {
            "talkId": "6183702",
            "initDialog": "618370201",
            "dialogues": [
                {
                    "id": "618370201",
                    "speaker": "Player",
                    "text": "你在等什么？"
                },
                {
                    "id": "618370202",
                    "speaker": "长孙继璟",
                    "text": "我在等雨。"
                },
                {
                    "id": "618370203",
                    "speaker": "长孙继璟",
                    "text": "在下长孙继璟，人称「凝雨剑」。想当年，恩师传我古华团绝学「裁雨」——剑承凝雨，势法飘华…"
                },
                {
                    "id": "618370204",
                    "speaker": "长孙继璟",
                    "text": "依在下所观，正是要将雨凝于剑上，因此必须要在雨天修习。"
                },
                {
                    "id": "618370205",
                    "speaker": "长孙继璟",
                    "text": "只可惜此地万世如一，虽有流云，却从未见雨点落下。"
                },
                {
                    "id": "618370206",
                    "speaker": "长孙继璟",
                    "text": "没有雨，我要如何裁？岁月悠悠，我的剑术竟是寸步难行…"
                }
            ]
        },
        {
            "talkId": "6183703",
            "initDialog": "618370301",
            "dialogues": [
                {
                    "id": "618370301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "618370302",
                    "speaker": "长孙继璟",
                    "text": "慢走。"
                }
            ]
        }
    ]
}