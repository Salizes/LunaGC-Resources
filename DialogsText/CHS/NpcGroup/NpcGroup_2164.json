{
    "groupId": "2164",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "王平安": 11
    },
    "talks": [
        {
            "talkId": "6216401",
            "initDialog": "621640101",
            "dialogues": [
                {
                    "id": "621640101",
                    "speaker": "王平安",
                    "text": "您好，您今天是来这边上香的吗？"
                }
            ]
        },
        {
            "talkId": "6216402",
            "initDialog": "621640201",
            "dialogues": [
                {
                    "id": "621640201",
                    "speaker": "Player",
                    "text": "能给我几支香吗？"
                },
                {
                    "id": "621640202",
                    "speaker": "王平安",
                    "text": "没问题，您稍等…"
                },
                {
                    "id": "621640203",
                    "speaker": "王平安",
                    "text": "您拿好了，香炉就在那边，直接过去就行。"
                }
            ]
        },
        {
            "talkId": "6216403",
            "initDialog": "621640301",
            "dialogues": [
                {
                    "id": "621640301",
                    "speaker": "Player",
                    "text": "平时有其他人来上香吗？"
                },
                {
                    "id": "621640302",
                    "speaker": "王平安",
                    "text": "有一些，但是不多。"
                },
                {
                    "id": "621640303",
                    "speaker": "王平安",
                    "text": "毕竟这里太过偏僻，根本没多少人知道这里还有一座庙嘛。"
                },
                {
                    "id": "621640304",
                    "speaker": "王平安",
                    "text": "我是不是该找个机会，对外宣传一下这座庙呢…"
                }
            ]
        },
        {
            "talkId": "6216404",
            "initDialog": "621640401",
            "dialogues": [
                {
                    "id": "621640401",
                    "speaker": "Player",
                    "text": "你的那本书编好了吗？"
                },
                {
                    "id": "621640402",
                    "speaker": "王平安",
                    "text": "还没呢。呃，不如说…还早呢…"
                },
                {
                    "id": "621640403",
                    "speaker": "王平安",
                    "text": "我之前虽然搜集了不少资料，但其中有些故事根本没有多少实证。"
                },
                {
                    "id": "621640404",
                    "speaker": "王平安",
                    "text": "光是为了考据这些故事的可靠性，我就已经花了不知道多长时间了。"
                },
                {
                    "id": "621640405",
                    "speaker": "王平安",
                    "text": "至于那本书…唉，说实话，就连我自己都不知道会编多久了…"
                }
            ]
        },
        {
            "talkId": "6216405",
            "initDialog": "621640501",
            "dialogues": [
                {
                    "id": "621640501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621640502",
                    "speaker": "王平安",
                    "text": "行，您走好。出去的时候小心点，外面的路可不太好走。"
                }
            ]
        }
    ]
}