    "talks": [
        {
            "talkId": "6972401",
            "initDialog": "697240101",
            "dialogues": [
                {
                    "id": "697240101",
                    "speaker": "莱克图尔",
                    "text": "蒙德也是个很适合悠闲生活的国家，不过首选当然是定居纳塔…"
                },
                {
                    "id": "697240102",
                    "speaker": "莱克图尔",
                    "text": "跑题了…辛苦你拿出最强的牌技，好好测试一下我的牌组！"
                }
            ]
        },
        {
            "talkId": "6972402",
            "initDialog": "697240201",
            "dialogues": [
                {
                    "id": "697240201",
                    "speaker": "Player",
                    "text": "来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6972403",
            "initDialog": "697240301",
            "dialogues": [
                {
                    "id": "697240301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "697240302",
                    "speaker": "莱克图尔",
                    "text": "可惜了，下次不知什么时候才能跟你这么友善的朋友玩牌！"
                }
            ]
        },
        {
            "talkId": "6972404",
            "initDialog": "697240401",
            "dialogues": [
                {
                    "id": "697240401",
                    "speaker": "莱克图尔",
                    "text": "多谢你！看来我这副牌组还是可圈可点的…"
                }
            ]
        },
        {
            "talkId": "6972405",
            "initDialog": "697240501",
            "dialogues": [
                {
                    "id": "697240501",
                    "speaker": "莱克图尔",
                    "text": "哎呀！原来我的牌组还有很大的提升空间？"
                }
            ]
        }
    ]
}