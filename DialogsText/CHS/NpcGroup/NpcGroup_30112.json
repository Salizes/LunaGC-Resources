    "talks": [
        {
            "talkId": "7051001",
            "initDialog": "705100101",
            "dialogues": [
                {
                    "id": "705100101",
                    "speaker": "卢卡",
                    "text": "啊，美好的一天！你好，准备好体验酒保生活了吗？"
                }
            ]
        },
        {
            "talkId": "7051002",
            "initDialog": "705100201",
            "dialogues": [
                {
                    "id": "705100201",
                    "speaker": "Player",
                    "text": "现在开始吧。"
                },
                {
                    "id": "705100202",
                    "speaker": "卢卡",
                    "text": "欢迎欢迎，今天也祝你好运。"
                }
            ]
        },
        {
            "talkId": "7051003",
            "initDialog": "705100301",
            "dialogues": [
                {
                    "id": "705100301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "705100302",
                    "speaker": "卢卡",
                    "text": "没关系。等你有空了，随时来找我就行。"
                }
            ]
        },
        {
            "talkId": "7051005",
            "initDialog": "705100501",
            "dialogues": [
                {
                    "id": "705100501",
                    "speaker": "Player",
                    "text": "关于「酒保体验周」…"
                },
                {
                    "id": "705100502",
                    "speaker": "卢卡",
                    "text": "嗯，说起活动初衷啊…其实是为了给酒馆储备人才。"
                },
                {
                    "id": "705100503",
                    "speaker": "卢卡",
                    "text": "想喝酒的人多，会调酒的人少，一年到头，查尔斯想请个假都难…"
                },
                {
                    "id": "705100504",
                    "speaker": "卢卡",
                    "text": "所以，我们就筹划了这个活动，想要培养大家对于酒保职业的兴趣！"
                },
                {
                    "id": "705100505",
                    "speaker": "卢卡",
                    "text": "怎么样，大名鼎鼎的旅行者，你感受如何？"
                }
            ]
        },
        {
            "talkId": "7051006",
            "initDialog": "705100601",
            "dialogues": [
                {
                    "id": "705100601",
                    "speaker": "Player",
                    "text": "确实有点兴趣。"
                },
                {
                    "id": "705100602",
                    "speaker": "卢卡",
                    "text": "嘿，就为了你这句话，已经值了！没有白忙一场！"
                },
                {
                    "id": "705100603",
                    "speaker": "卢卡",
                    "text": "总之，你已经把咱们酒馆的气氛带动起来了。最近街角来来往往的，都是客人…"
                },
                {
                    "id": "705100604",
                    "speaker": "卢卡",
                    "text": "虽然和初衷不太一样，但效果好就是好活动，你说对吧。"
                }
            ]
        },
        {
            "talkId": "7051007",
            "initDialog": "705100701",
            "dialogues": [
                {
                    "id": "705100701",
                    "speaker": "Player",
                    "text": "还是有点辛苦…"
                },
                {
                    "id": "705100702",
                    "speaker": "卢卡",
                    "text": "是嘛，看来工作强度高了点啊。"
                },
                {
                    "id": "705100703",
                    "speaker": "卢卡",
                    "text": "总之，你已经把咱们酒馆的气氛带动起来了。最近街角来来往往的，都是客人…"
                },
                {
                    "id": "705100704",
                    "speaker": "卢卡",
                    "text": "虽然和初衷不太一样，但效果好就是好活动，你说对吧。"
                }
            ]
        }
    ]
}