{
    "groupId": "9099",
    "total_dialogue_lines": 67,
    "speaker_counts": {
        "Player": 15,
        "艾梅莉埃": 52
    },
    "talks": [
        {
            "talkId": "6909901",
            "initDialog": "690990101",
            "dialogues": [
                {
                    "id": "690990101",
                    "speaker": "艾梅莉埃",
                    "text": "你好。很荣幸能参观你的住处。"
                }
            ]
        },
        {
            "talkId": "6909902",
            "initDialog": "690990201",
            "dialogues": [
                {
                    "id": "690990201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690990202",
                    "speaker": "艾梅莉埃",
                    "text": "比想的更好。"
                },
                {
                    "id": "690990203",
                    "speaker": "艾梅莉埃",
                    "text": "能像这样欣赏一处兼具个人审美与流行美学的宅邸，我很惊喜。",
                    "choices": [
                        {
                            "id": "690990204",
                            "text": "有没有装潢方面的建议？",
                            "response": [
                                {
                                    "id": "690990205",
                                    "speaker": "艾梅莉埃",
                                    "text": "以我的特长，恐怕不适合就这方面发表意见。不过，如果你需要通风布设方面的建议，我愿意提供一些参考。"
                                },
                                {
                                    "id": "690990206",
                                    "speaker": "艾梅莉埃",
                                    "text": "我现在使用的制香室，里面的排风系统就是我自己构建的。区别于普通房屋，制香室对这方面要求更高。"
                                },
                                {
                                    "id": "690990207",
                                    "speaker": "艾梅莉埃",
                                    "text": "另外，门窗的位置也很有讲究。当然，建议终究只是建议。如果你有更专业的朋友，也可以咨询他们。"
                                }
                            ]
                        },
                        {
                            "id": "690990208",
                            "text": "能推荐一些适合这里的香氛吗？",
                            "response": [
                                {
                                    "id": "690990209",
                                    "speaker": "艾梅莉埃",
                                    "text": "依照你这里的情况，我会推荐草本香调。"
                                },
                                {
                                    "id": "690990210",
                                    "speaker": "艾梅莉埃",
                                    "text": "符合整体开阔的印象，又带有来自大地的气味。与你本身的职业定位也很符合。"
                                },
                                {
                                    "id": "690990211",
                                    "speaker": "Player",
                                    "text": "职业定位？是指旅行吗？"
                                },
                                {
                                    "id": "690990212",
                                    "speaker": "艾梅莉埃",
                                    "text": "是的。至少在我看来，这是你最显著也最重要的职业特征。"
                                },
                                {
                                    "id": "690990213",
                                    "speaker": "艾梅莉埃",
                                    "text": "据我所知，长年在外旅行的人，他们所记住的气味类型很可能多于一般人。"
                                },
                                {
                                    "id": "690990214",
                                    "speaker": "艾梅莉埃",
                                    "text": "而大地、土壤…这些最踏实的要素，正是旅行的起与终，也是你每日踏足的根本。"
                                },
                                {
                                    "id": "690990215",
                                    "speaker": "艾梅莉埃",
                                    "text": "草本是大地的精华，适合走遍最多土地的人。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909903",
            "initDialog": "690990301",
            "dialogues": [
                {
                    "id": "690990301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690990302",
                    "speaker": "艾梅莉埃",
                    "text": "当然。如果你也有闲暇就再好不过了。"
                },
                {
                    "id": "690990303",
                    "speaker": "艾梅莉埃",
                    "text": "不如由你来开启话题吧。"
                },
                {
                    "id": "690990304",
                    "speaker": "Player",
                    "text": "这里有资格成为你的制香室吗？"
                },
                {
                    "id": "690990305",
                    "speaker": "艾梅莉埃",
                    "text": "如果你这么说…请恕我直言，这里风景很好，是适合居住的地方，可作为制香的工作室还欠缺了不少必要的布置。"
                },
                {
                    "id": "690990306",
                    "speaker": "艾梅莉埃",
                    "text": "香料存放条件大多很严苛，必须单独安排器具。"
                },
                {
                    "id": "690990307",
                    "speaker": "艾梅莉埃",
                    "text": "不过，要是能备齐条件，自然可以在这里搭建出一间合适又专业的工坊。",
                    "choices": [
                        {
                            "id": "690990308",
                            "text": "感觉你很擅长集中精神。",
                            "response": [
                                {
                                    "id": "690990309",
                                    "speaker": "艾梅莉埃",
                                    "text": "关于这一点，我得说，是的，就像你想的一样。"
                                },
                                {
                                    "id": "690990310",
                                    "speaker": "艾梅莉埃",
                                    "text": "我所从事的工作对作业精度要求很高。好在我也比较擅长集中精力。"
                                },
                                {
                                    "id": "690990311",
                                    "speaker": "艾梅莉埃",
                                    "text": "保持极度专注的状态三五个小时，对我来说并不困难。"
                                }
                            ]
                        },
                        {
                            "id": "690990312",
                            "text": "有什么提高集中力的建议吗？",
                            "response": [
                                {
                                    "id": "690990313",
                                    "speaker": "艾梅莉埃",
                                    "text": "以前也有人问过我类似的问题。甚至还有人觉得使用香水能提神醒脑，有助于作业进程。"
                                },
                                {
                                    "id": "690990314",
                                    "speaker": "艾梅莉埃",
                                    "text": "很遗憾，这种浪漫的想法也仅仅只是美好的幻想。"
                                },
                                {
                                    "id": "690990315",
                                    "speaker": "艾梅莉埃",
                                    "text": "香氛确实可以使人短暂放松，但持续高浓度的气味环境反而会影响脑部。"
                                },
                                {
                                    "id": "690990316",
                                    "speaker": "艾梅莉埃",
                                    "text": "而我个人觉得，想要集中精力，除了保持头脑清醒，更重要的是减少外界影响。"
                                },
                                {
                                    "id": "690990317",
                                    "speaker": "艾梅莉埃",
                                    "text": "开始一件事之前，先排除干扰因素，再将环境整理成适合长时间停留的样子。"
                                },
                                {
                                    "id": "690990318",
                                    "speaker": "艾梅莉埃",
                                    "text": "没有这两个外因，再好的状态也持续不了多久。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909904",
            "initDialog": "690990401",
            "dialogues": [
                {
                    "id": "690990401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690990402",
                    "speaker": "艾梅莉埃",
                    "text": "你的这间庭院环境非常巧妙，适合多种作物生长。"
                },
                {
                    "id": "690990403",
                    "speaker": "艾梅莉埃",
                    "text": "如果能得到允许，我想我会试着在这里培养一些植物样本。"
                },
                {
                    "id": "690990404",
                    "speaker": "Player",
                    "text": "要种很香的花草吗？"
                },
                {
                    "id": "690990405",
                    "speaker": "艾梅莉埃",
                    "text": "不全是。"
                },
                {
                    "id": "690990406",
                    "speaker": "艾梅莉埃",
                    "text": "带香味的植物很重要，没什么香味的植物也一样有用。"
                },
                {
                    "id": "690990407",
                    "speaker": "艾梅莉埃",
                    "text": "有一些植物，它们本身不具有明显气味，但能中和或改变其他香气。通过它们，我们就能控制气味的方向和浓度。"
                },
                {
                    "id": "690990408",
                    "speaker": "Player",
                    "text": "听起来像什么实验一样呢…"
                },
                {
                    "id": "690990409",
                    "speaker": "艾梅莉埃",
                    "text": "调配香水确实算一种实验。而各色原料都有可能成为变量。"
                },
                {
                    "id": "690990410",
                    "speaker": "艾梅莉埃",
                    "text": "所以，寻找合适的培植空间非常重要。"
                },
                {
                    "id": "690990411",
                    "speaker": "艾梅莉埃",
                    "text": "矿石、动物分泌物、植物…同一品种的香料在不同环境可能呈现不同性状。"
                },
                {
                    "id": "690990412",
                    "speaker": "艾梅莉埃",
                    "text": "而你的这座神奇庭院似乎能调整环境参数。有了它，各种动植物都可以自然地变化。"
                },
                {
                    "id": "690990413",
                    "speaker": "艾梅莉埃",
                    "text": "可以说是最理想的培养皿，甚至可以做一些其他试验，比如与鉴识、清洁相关的。"
                },
                {
                    "id": "690990414",
                    "speaker": "艾梅莉埃",
                    "text": "但那些试验终归不适合在民居进行，我也不想破坏这里宜人的环境。"
                },
                {
                    "id": "690990415",
                    "speaker": "Player",
                    "text": "有点想见识下…"
                },
                {
                    "id": "690990416",
                    "speaker": "艾梅莉埃",
                    "text": "呵呵，那有机会的话，请你来专门的实验室参观吧。"
                },
                {
                    "id": "690990417",
                    "speaker": "艾梅莉埃",
                    "text": "听说你对炼金术也有所研究，我们可以互通有无。"
                },
                {
                    "id": "690990418",
                    "speaker": "Player",
                    "text": "好！这里也欢迎你常来。"
                },
                {
                    "id": "690990419",
                    "speaker": "艾梅莉埃",
                    "text": "非常感谢，我会记得这份邀请。"
                },
                {
                    "id": "690990420",
                    "speaker": "艾梅莉埃",
                    "text": "这里汇聚了你的旅行、你的生活，和你所见到的一切生命之息…"
                },
                {
                    "id": "690990421",
                    "speaker": "艾梅莉埃",
                    "text": "或许未来某天，世界上将会诞生出一瓶独属于这个庭院的香水。"
                }
            ]
        },
        {
            "talkId": "6909905",
            "initDialog": "690990501",
            "dialogues": [
                {
                    "id": "690990501",
                    "speaker": "Player",
                    "text": "早啊，艾梅莉埃。"
                },
                {
                    "id": "690990502",
                    "speaker": "艾梅莉埃",
                    "text": "#早安，{NICKNAME}，已经准备开启今天的行程了？"
                },
                {
                    "id": "690990503",
                    "speaker": "艾梅莉埃",
                    "text": "那我便不多耽误你的时间，预祝一切顺利。"
                }
            ]
        },
        {
            "talkId": "6909906",
            "initDialog": "690990601",
            "dialogues": [
                {
                    "id": "690990601",
                    "speaker": "Player",
                    "text": "晚安，艾梅莉埃。"
                },
                {
                    "id": "690990602",
                    "speaker": "艾梅莉埃",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690990603",
                    "speaker": "艾梅莉埃",
                    "text": "看来今日收获不错，请好好休息吧。"
                }
            ]
        },
        {
            "talkId": "6909910",
            "initDialog": "690991001",
            "dialogues": [
                {
                    "id": "690991001",
                    "speaker": "艾梅莉埃",
                    "text": "枫丹郊外有很多类似的民居与花圃。"
                },
                {
                    "id": "690991002",
                    "speaker": "艾梅莉埃",
                    "text": "明丽的色彩和阵阵花香，可以轻易洗去旅人奔波的疲惫。"
                },
                {
                    "id": "690991003",
                    "speaker": "艾梅莉埃",
                    "text": "每每采风路遇，我都会驻足欣赏一阵。"
                }
            ]
        },
        {
            "talkId": "6909911",
            "initDialog": "690991101",
            "dialogues": [
                {
                    "id": "690991101",
                    "speaker": "艾梅莉埃",
                    "text": "你有没有听说过这样一种说法，「露景泉是枫丹一切源流汇集之地」？"
                },
                {
                    "id": "690991102",
                    "speaker": "艾梅莉埃",
                    "text": "有时我会想，那些洗净污物的水，没准会带着逝者的不甘，融入其中…"
                },
                {
                    "id": "690991103",
                    "speaker": "艾梅莉埃",
                    "text": "不过你这里不太一样。因为少了那些用来许愿的硬币，池水看起来更加干净透亮。"
                }
            ]
        }
    ]
}