{
    "groupId": "2523",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "迭跃": 8
    },
    "talks": [
        {
            "talkId": "6252301",
            "initDialog": "625230101",
            "dialogues": [
                {
                    "id": "625230101",
                    "speaker": "迭跃",
                    "text": "哎呀…扎马真累啊…顶住啊顶住啊！扎多三个钟！"
                }
            ]
        },
        {
            "talkId": "6252302",
            "initDialog": "625230201",
            "dialogues": [
                {
                    "id": "625230201",
                    "speaker": "Player",
                    "text": "你怎么了？"
                },
                {
                    "id": "625230202",
                    "speaker": "迭跃",
                    "text": "累死我了…不过我会咬紧牙关继续练！"
                },
                {
                    "id": "625230203",
                    "speaker": "迭跃",
                    "text": "学嘉明话斋，台上一秒钟台下十年功。"
                },
                {
                    "id": "625230204",
                    "speaker": "迭跃",
                    "text": "不这样练，拳打不出劲，刀枪也舞不动，到时哭都没眼泪咯！"
                }
            ]
        },
        {
            "talkId": "6252303",
            "initDialog": "625230301",
            "dialogues": [
                {
                    "id": "625230301",
                    "speaker": "Player",
                    "text": "你是这里的镖师吗？"
                },
                {
                    "id": "625230302",
                    "speaker": "迭跃",
                    "text": "对啊！实不相瞒，刚来镖局，功夫还上不了台面啊我。还是得慢慢练…"
                },
                {
                    "id": "625230303",
                    "speaker": "迭跃",
                    "text": "噢，运镖之余，我也是「威水舞兽队」的鼓手，放心，嘉明交待过，基本功天天都练的…"
                },
                {
                    "id": "625230304",
                    "speaker": "迭跃",
                    "text": "有时间一定要来看看我们表演啊你！街坊看过都说好！"
                }
            ]
        },
        {
            "talkId": "6252304",
            "initDialog": "625230401",
            "dialogues": [
                {
                    "id": "625230401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "625230402",
                    "speaker": "迭跃",
                    "text": "真累啊，他到底怎样坚持的…"
                }
            ]
        }
    ]
}