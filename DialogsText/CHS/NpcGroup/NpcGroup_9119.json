{
    "groupId": "9119",
    "total_dialogue_lines": 58,
    "speaker_counts": {
        "Player": 14,
        "菈乌玛": 44
    },
    "talks": [
        {
            "talkId": "6911901",
            "initDialog": "691190101",
            "dialogues": [
                {
                    "id": "691190101",
                    "speaker": "菈乌玛",
                    "text": "环境相当宜人，风中也有好闻的气味…住在这里的体验一定很好吧。"
                },
                {
                    "id": "691190102",
                    "speaker": "菈乌玛",
                    "text": "衷心感谢你的邀请。"
                }
            ]
        },
        {
            "talkId": "6911902",
            "initDialog": "691190201",
            "dialogues": [
                {
                    "id": "691190201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691190202",
                    "speaker": "菈乌玛",
                    "text": "是的。"
                },
                {
                    "id": "691190203",
                    "speaker": "菈乌玛",
                    "text": "空气纯净，通风良好，绿植的比例也恰到好处。"
                },
                {
                    "id": "691190204",
                    "speaker": "菈乌玛",
                    "text": "动物们看了也会喜欢这个地方的。它们会说，只有心地善良的人能布置出这么富有亲切感的居所。"
                },
                {
                    "id": "691190205",
                    "speaker": "Player",
                    "text": "菈乌玛家乡的森林也给我这种感觉。"
                },
                {
                    "id": "691190206",
                    "speaker": "菈乌玛",
                    "text": "真的吗？很荣幸听到你这么说。"
                },
                {
                    "id": "691190207",
                    "speaker": "菈乌玛",
                    "text": "我知道在大部分人看来，霜月之子这个团体还是有些特殊的…我们比一般人更在意气味、温度和环境。"
                },
                {
                    "id": "691190208",
                    "speaker": "菈乌玛",
                    "text": "诚然，我们比一般人更接近自然与动物，但换个角度想，这也意味着我们的感知力更敏锐。"
                },
                {
                    "id": "691190209",
                    "speaker": "菈乌玛",
                    "text": "这样的我们选择接纳你当朋友，多少也证明了一些事情。"
                },
                {
                    "id": "691190210",
                    "speaker": "菈乌玛",
                    "text": "趋利避害是生物的天性，你对我们而言，是非常安全的存在呢。"
                },
                {
                    "id": "691190211",
                    "speaker": "菈乌玛",
                    "text": "这很重要，无论何时都请不要忘记。"
                }
            ]
        },
        {
            "talkId": "6911903",
            "initDialog": "691190301",
            "dialogues": [
                {
                    "id": "691190301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691190302",
                    "speaker": "菈乌玛",
                    "text": "当然好。需要我来甄选话题吗？"
                },
                {
                    "id": "691190303",
                    "speaker": "菈乌玛",
                    "text": "唔…不过，我应该不能算是个擅长聊天的人吧…我自己是这么认为的。",
                    "choices": [
                        {
                            "id": "691190304",
                            "text": "不会呀，菈乌玛很擅长聊天。",
                            "response": [
                                {
                                    "id": "691190305",
                                    "speaker": "菈乌玛",
                                    "text": "恐怕要让你失望了…职能所致，我必须说些安抚人心、鼓励他人的话语。"
                                },
                                {
                                    "id": "691190306",
                                    "speaker": "菈乌玛",
                                    "text": "语言带有奇妙的力量，所以人们谨慎地使用最为合适的语言，我也一样。"
                                },
                                {
                                    "id": "691190310",
                                    "speaker": "菈乌玛",
                                    "text": "但非要说的话，我确实想变得更擅长沟通一些…"
                                },
                                {
                                    "id": "691190311",
                                    "speaker": "Player",
                                    "text": "可以学学身边的朋友。"
                                },
                                {
                                    "id": "691190312",
                                    "speaker": "菈乌玛",
                                    "text": "…第一时间想到了那几位。奈芙尔小姐，法尔伽先生，还有菲林斯先生。"
                                },
                                {
                                    "id": "691190313",
                                    "speaker": "菈乌玛",
                                    "text": "都是精明又聪慧的人呢。大家来自不同的环境，也就拥有了不同的谈吐。"
                                },
                                {
                                    "id": "691190314",
                                    "speaker": "菈乌玛",
                                    "text": "遇见他们让我知道自己的局限。需要学习的地方还很多。"
                                },
                                {
                                    "id": "691190315",
                                    "speaker": "Player",
                                    "text": "你也可以反过来教他们一些事哦。"
                                },
                                {
                                    "id": "691190316",
                                    "speaker": "菈乌玛",
                                    "text": "嗯…或许是可以的。"
                                },
                                {
                                    "id": "691190317",
                                    "speaker": "菈乌玛",
                                    "text": "至少在与动物交流这方面，我有着绝对优势。"
                                }
                            ]
                        },
                        {
                            "id": "691190307",
                            "text": "没关系，我也不擅长这方面。",
                            "response": [
                                {
                                    "id": "691190308",
                                    "speaker": "菈乌玛",
                                    "text": "真的？在我看来你已经做得很好了呢。"
                                },
                                {
                                    "id": "691190309",
                                    "speaker": "菈乌玛",
                                    "text": "虽然派蒙经常代替你说几句，你自己的发言倒也很有意思，我一直注意着。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6911904",
            "initDialog": "691190401",
            "dialogues": [
                {
                    "id": "691190401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691190402",
                    "speaker": "菈乌玛",
                    "text": "有是有，不过不是现在。"
                },
                {
                    "id": "691190403",
                    "speaker": "菈乌玛",
                    "text": "挪德卡莱有些人迹罕至的美丽林区，闲暇时我经常去那里休息。"
                },
                {
                    "id": "691190404",
                    "speaker": "菈乌玛",
                    "text": "大概因为我身体里流淌着一些非同常人的血脉吧…我总是很在意周围的水是否洁净，风是否轻柔。"
                },
                {
                    "id": "691190405",
                    "speaker": "菈乌玛",
                    "text": "也因此，能彻底放松下来的时间会比普通人少一些。"
                },
                {
                    "id": "691190406",
                    "speaker": "菈乌玛",
                    "text": "唯独在那些地方，我能忘记正在忙碌的事。泡在水潭里发呆，一不小心就从四肢变成六肢了。"
                },
                {
                    "id": "691190407",
                    "speaker": "Player",
                    "text": "好稀奇的场面。"
                },
                {
                    "id": "691190408",
                    "speaker": "菈乌玛",
                    "text": "嗯。多了两肢，生活多少也能便利一些。"
                },
                {
                    "id": "691190409",
                    "speaker": "菈乌玛",
                    "text": "不好意思，这个话题会不会太小众了？",
                    "choices": [
                        {
                            "id": "691190410",
                            "text": "没关系，我觉得还是挺稀奇的！",
                            "response": [
                                {
                                    "id": "691190411",
                                    "speaker": "菈乌玛",
                                    "text": "你能这么说我就放心了。"
                                },
                                {
                                    "id": "691190412",
                                    "speaker": "菈乌玛",
                                    "text": "果然，交朋友还是要多交一些见识广的。"
                                }
                            ]
                        },
                        {
                            "id": "691190413",
                            "text": "六肢的感觉会很奇怪吗？",
                            "response": [
                                {
                                    "id": "691190414",
                                    "speaker": "菈乌玛",
                                    "text": "不会，我已经习惯了。而且，四足奔跑的速度优势太大，体验过绝对放弃不了。"
                                },
                                {
                                    "id": "691190415",
                                    "speaker": "Player",
                                    "text": "难怪菈乌玛有时会不顾一切向前进取…"
                                },
                                {
                                    "id": "691190416",
                                    "speaker": "菈乌玛",
                                    "text": "是的。如你所说，这确实也是高速奔跑的惯性。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6911905",
            "initDialog": "691190501",
            "dialogues": [
                {
                    "id": "691190501",
                    "speaker": "Player",
                    "text": "早啊，菈乌玛。"
                },
                {
                    "id": "691190502",
                    "speaker": "菈乌玛",
                    "text": "#早安，{NICKNAME}。"
                },
                {
                    "id": "691190503",
                    "speaker": "菈乌玛",
                    "text": "森林将护佑善良的你。自由地冒险吧。"
                }
            ]
        },
        {
            "talkId": "6911906",
            "initDialog": "691190601",
            "dialogues": [
                {
                    "id": "691190601",
                    "speaker": "Player",
                    "text": "晚安，菈乌玛。"
                },
                {
                    "id": "691190602",
                    "speaker": "菈乌玛",
                    "text": "群星守望着旅人的归途与梦想。"
                },
                {
                    "id": "691190603",
                    "speaker": "菈乌玛",
                    "text": "好好休息，晚安。"
                }
            ]
        },
        {
            "talkId": "6911910",
            "initDialog": "691191001",
            "dialogues": [
                {
                    "id": "691191001",
                    "speaker": "菈乌玛",
                    "text": "唔…这里没有外人，可以偷偷跟你说句心里话吗？"
                },
                {
                    "id": "691191002",
                    "speaker": "菈乌玛",
                    "text": "有时我会想，霜月之子是否对鹿角和月亮的意象过于痴迷…"
                },
                {
                    "id": "691191003",
                    "speaker": "菈乌玛",
                    "text": "这样的摆设的确很好看，不过使用的时候，得注意别勾到头发或衣角哦。"
                }
            ]
        },
        {
            "talkId": "6911911",
            "initDialog": "691191101",
            "dialogues": [
                {
                    "id": "691191101",
                    "speaker": "菈乌玛",
                    "text": "如家一般温暖的光…我喜欢这里。"
                },
                {
                    "id": "691191102",
                    "speaker": "菈乌玛",
                    "text": "在这安宁的时刻，最适合取来一本书静静阅读。"
                },
                {
                    "id": "691191103",
                    "speaker": "菈乌玛",
                    "text": "不过今天就不读霜月之子的书了。悄悄地，我们找些有趣的来看吧。"
                }
            ]
        }
    ]
}