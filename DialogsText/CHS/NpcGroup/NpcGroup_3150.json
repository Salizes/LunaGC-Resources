{
    "groupId": "3150",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "博彦": 8
    },
    "talks": [
        {
            "talkId": "6315001",
            "initDialog": "631500101",
            "dialogues": [
                {
                    "id": "631500101",
                    "speaker": "博彦",
                    "text": "你好，请问有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6315002",
            "initDialog": "631500201",
            "dialogues": [
                {
                    "id": "631500201",
                    "speaker": "Player",
                    "text": "你在担心什么？"
                },
                {
                    "id": "631500202",
                    "speaker": "博彦",
                    "text": "我是社奉行派来在这里看管活动场地的守卫，最关心的自然是这附近的安全了。"
                },
                {
                    "id": "631500203",
                    "speaker": "博彦",
                    "text": "这里每次举办祭典或者烟花会的时候都会格外热闹，但热闹之余，也容易滋生问题。"
                },
                {
                    "id": "631500204",
                    "speaker": "博彦",
                    "text": "场地的维护、易燃物的防火防盗…这些都是社奉行需要操心的事情。"
                },
                {
                    "id": "631500205",
                    "speaker": "博彦",
                    "text": "…啊，我并不是讨厌这类活动啦，灿烂美丽的烟花有谁不喜欢呢？只是人多的地方，总归不好管理。"
                },
                {
                    "id": "631500206",
                    "speaker": "博彦",
                    "text": "如果像边上那位活动管理人小姐所期望的，全提瓦特的人都被吸引来稻妻围观烟花会的话，社奉行可就要头疼死啦。"
                },
                {
                    "id": "631500207",
                    "speaker": "博彦",
                    "text": "总之，活动虽然好玩，但一切得以安全为第一要务。"
                }
            ]
        },
        {
            "talkId": "6315003",
            "initDialog": "631500301",
            "dialogues": [
                {
                    "id": "631500301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631500302",
                    "speaker": "博彦",
                    "text": "再见，慢走。"
                }
            ]
        }
    ]
}