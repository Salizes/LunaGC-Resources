{
    "groupId": "5055",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "贡托雷": 10
    },
    "talks": [
        {
            "talkId": "6505501",
            "initDialog": "650550101",
            "dialogues": [
                {
                    "id": "650550101",
                    "speaker": "贡托雷",
                    "text": "唉，这可怎么办啊…"
                }
            ]
        },
        {
            "talkId": "6505502",
            "initDialog": "650550201",
            "dialogues": [
                {
                    "id": "650550201",
                    "speaker": "Player",
                    "text": "你怎么了？"
                },
                {
                    "id": "650550202",
                    "speaker": "贡托雷",
                    "text": "枫丹出了大问题！现状必须要得到改变，在这一点上，我们每个人都有责任！必须团结起来，为我们自己争取利益！"
                }
            ]
        },
        {
            "talkId": "6505503",
            "initDialog": "650550301",
            "dialogues": [
                {
                    "id": "650550301",
                    "speaker": "Player",
                    "text": "你不工作吗？"
                },
                {
                    "id": "650550302",
                    "speaker": "贡托雷",
                    "text": "工作？我现在做的是比工作重要得多的事情！"
                },
                {
                    "id": "650550303",
                    "speaker": "贡托雷",
                    "text": "人一直工作，就会变成只会工作不会思考的发条机器；只有不断质疑和提问，才能开拓出新的道路！"
                },
                {
                    "id": "650550304",
                    "speaker": "贡托雷",
                    "text": "我们的历史，我们的现在，无不在印证这个道理。"
                },
                {
                    "id": "650550305",
                    "speaker": "贡托雷",
                    "text": "要是你请我一杯咖啡的话，我也可以再跟你展开说说。"
                }
            ]
        },
        {
            "talkId": "6505504",
            "initDialog": "650550401",
            "dialogues": [
                {
                    "id": "650550401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650550402",
                    "speaker": "贡托雷",
                    "text": "…这就走了吗？"
                }
            ]
        },
        {
            "talkId": "6505505",
            "initDialog": "650550501",
            "dialogues": [
                {
                    "id": "650550501",
                    "speaker": "Player",
                    "text": "你在说些什么？"
                },
                {
                    "id": "650550502",
                    "speaker": "贡托雷",
                    "text": "枫丹！我在说枫丹！沫芒宫、能源模式、这自上而下的机制体系…枫丹存在那么多问题，你看不见吗？"
                },
                {
                    "id": "650550503",
                    "speaker": "贡托雷",
                    "text": "不瞒你说，这些问题，我跟阿鲁埃也聊过好几次，他非常赞同我的观点，还请我喝了好几次咖啡。"
                },
                {
                    "id": "650550504",
                    "speaker": "贡托雷",
                    "text": "只是最近…越来越不管用，我是说，我的观点好像不像原先那么吸引他了。"
                }
            ]
        }
    ]
}