{
    "groupId": "4284",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 9,
        "祖尔宛": 27
    },
    "talks": [
        {
            "talkId": "6428401",
            "initDialog": "642840101",
            "dialogues": [
                {
                    "id": "642840101",
                    "speaker": "祖尔宛",
                    "text": "无礼之人，这里可不是寻常人类可以随意造访的所在。"
                }
            ]
        },
        {
            "talkId": "6428402",
            "initDialog": "642840201",
            "dialogues": [
                {
                    "id": "642840201",
                    "speaker": "祖尔宛",
                    "text": "那么斯露莎就拜托了。"
                }
            ]
        },
        {
            "talkId": "6428403",
            "initDialog": "642840301",
            "dialogues": [
                {
                    "id": "642840301",
                    "speaker": "Player",
                    "text": "关于「焚真之天象」…"
                },
                {
                    "id": "642840302",
                    "speaker": "祖尔宛",
                    "text": "「焚真之天象」的出现是污秽力量不断增长的结果。"
                },
                {
                    "id": "642840303",
                    "speaker": "祖尔宛",
                    "text": "上次出现这样的情况还是几百年前，那时我曾与人类的勇士共同将其熄灭。"
                },
                {
                    "id": "642840304",
                    "speaker": "祖尔宛",
                    "text": "倘若任由其侵蚀母树的御体，一旦镇压污秽的灵光之力无法维持，荼泥黑渊的那个裂隙说不定真的会重现于世。"
                }
            ]
        },
        {
            "talkId": "6428404",
            "initDialog": "642840401",
            "dialogues": [
                {
                    "id": "642840401",
                    "speaker": "Player",
                    "text": "关于花灵…"
                },
                {
                    "id": "642840402",
                    "speaker": "祖尔宛",
                    "text": "花灵是为了抵御灾厄、祓除污秽而存在的族群。"
                },
                {
                    "id": "642840403",
                    "speaker": "祖尔宛",
                    "text": "神鸟西摩格饮下「甘露活水」，将自己所拥有的灵光之力与其融合，而创造出了灵光百种。"
                },
                {
                    "id": "642840404",
                    "speaker": "祖尔宛",
                    "text": "在灵光百种之中，得以拥有智性的便是我们花灵。"
                },
                {
                    "id": "642840405",
                    "speaker": "祖尔宛",
                    "text": "我们的力量来源于原初的甘露之水，因而终有一天也会回归其中。"
                }
            ]
        },
        {
            "talkId": "6428405",
            "initDialog": "642840501",
            "dialogues": [
                {
                    "id": "642840501",
                    "speaker": "Player",
                    "text": "关于斯露莎…"
                },
                {
                    "id": "642840502",
                    "speaker": "祖尔宛",
                    "text": "别看她嘴上那样，本质上其实是个好孩子呢。"
                },
                {
                    "id": "642840503",
                    "speaker": "祖尔宛",
                    "text": "斯露莎诞生于上次灾厄平息之后，并未亲见古时的争战，因此才会对其有着诸多幻想。"
                },
                {
                    "id": "642840504",
                    "speaker": "祖尔宛",
                    "text": "不过每个花灵都有命定的职责，从这一点上来说她的确是特别的，毕竟灵光的秘密就算是我也没办法完全参透…"
                }
            ]
        },
        {
            "talkId": "6428406",
            "initDialog": "642840601",
            "dialogues": [
                {
                    "id": "642840601",
                    "speaker": "Player",
                    "text": "没事了。"
                },
                {
                    "id": "642840602",
                    "speaker": "祖尔宛",
                    "text": "既然这样那就辛苦了，我可期待你们的好消息呢！"
                }
            ]
        },
        {
            "talkId": "6428407",
            "initDialog": "642840701",
            "dialogues": [
                {
                    "id": "642840701",
                    "speaker": "祖尔宛",
                    "text": "哎呀，我们又见面了，是想我了吗？"
                }
            ]
        },
        {
            "talkId": "6428408",
            "initDialog": "642840801",
            "dialogues": [
                {
                    "id": "642840801",
                    "speaker": "Player",
                    "text": "关于「焚真之天象」…"
                },
                {
                    "id": "642840802",
                    "speaker": "祖尔宛",
                    "text": "多亏了你们，「焚真之天象」已经完全熄灭了。"
                },
                {
                    "id": "642840803",
                    "speaker": "祖尔宛",
                    "text": "虽然污秽的力量不可能彻底消除，但它们若想要再度侵蚀这里，也还需要相当长的一段时间。"
                },
                {
                    "id": "642840804",
                    "speaker": "祖尔宛",
                    "text": "趁此机会，我们花灵也可以好好休养一下了。"
                }
            ]
        },
        {
            "talkId": "6428409",
            "initDialog": "642840901",
            "dialogues": [
                {
                    "id": "642840901",
                    "speaker": "Player",
                    "text": "关于花灵…"
                },
                {
                    "id": "642840902",
                    "speaker": "祖尔宛",
                    "text": "花灵是为了抵御灾厄、祓除污秽而存在的族群。"
                },
                {
                    "id": "642840903",
                    "speaker": "祖尔宛",
                    "text": "神鸟西摩格饮下「甘露活水」，将自己所拥有的灵光之力与其融合，而创造出了灵光百种。"
                },
                {
                    "id": "642840904",
                    "speaker": "祖尔宛",
                    "text": "在灵光百种之中，得以拥有智性的便是我们花灵。"
                },
                {
                    "id": "642840905",
                    "speaker": "祖尔宛",
                    "text": "我们的力量来源于原初的甘露之水，因而终有一天也会回归其中。"
                }
            ]
        },
        {
            "talkId": "6428410",
            "initDialog": "642841001",
            "dialogues": [
                {
                    "id": "642841001",
                    "speaker": "Player",
                    "text": "关于斯露莎…"
                },
                {
                    "id": "642841002",
                    "speaker": "祖尔宛",
                    "text": "那孩子也成长了不少呢，已经算是名副其实的「勇者」了。当然这也是多亏了你们的缘故。"
                },
                {
                    "id": "642841003",
                    "speaker": "祖尔宛",
                    "text": "接下来也请继续好好教导她吧。"
                }
            ]
        },
        {
            "talkId": "6428411",
            "initDialog": "642841101",
            "dialogues": [
                {
                    "id": "642841101",
                    "speaker": "Player",
                    "text": "关于矫论团的先辈…"
                },
                {
                    "id": "642841102",
                    "speaker": "祖尔宛",
                    "text": "他们自称是曾与荼诃人的勇士并肩作战之人。"
                },
                {
                    "id": "642841103",
                    "speaker": "祖尔宛",
                    "text": "虽然我没有见过除那位剑士之外的荼诃人，但曾与漆黑的魔物作战之人皆可谓是我们的战友。"
                },
                {
                    "id": "642841104",
                    "speaker": "祖尔宛",
                    "text": "我们与污秽之间的战争将会永远持续下去，在这场争斗的面前，人类的评价是没有意义的。"
                }
            ]
        },
        {
            "talkId": "6428412",
            "initDialog": "642841201",
            "dialogues": [
                {
                    "id": "642841201",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642841202",
                    "speaker": "祖尔宛",
                    "text": "嗯，我们还会见面的。"
                }
            ]
        }
    ]
}