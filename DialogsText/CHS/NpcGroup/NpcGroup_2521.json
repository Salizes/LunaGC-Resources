    "talks": [
        {
            "talkId": "6252101",
            "initDialog": "625210101",
            "dialogues": [
                {
                    "id": "625210101",
                    "speaker": "礼信",
                    "text": "欢迎各位与「飞云商会」合作，我们正在拓展多种经营领域！"
                }
            ]
        },
        {
            "talkId": "6252102",
            "initDialog": "625210201",
            "dialogues": [
                {
                    "id": "625210201",
                    "speaker": "Player",
                    "text": "关于商业合作…"
                },
                {
                    "id": "625210202",
                    "speaker": "礼信",
                    "text": "哦？您也是商人吗？"
                },
                {
                    "id": "625210203",
                    "speaker": "礼信",
                    "text": "飞云商会正在探索新的经营领域，包括将织物和玉器结合，在织物染色期间加入茶叶调香…"
                },
                {
                    "id": "625210204",
                    "speaker": "礼信",
                    "text": "如有合作意向，随时可以找我聊聊，我定将您的想法准确转述给商会！"
                }
            ]
        },
        {
            "talkId": "6252103",
            "initDialog": "625210301",
            "dialogues": [
                {
                    "id": "625210301",
                    "speaker": "Player",
                    "text": "你们家小少爷会来吗？"
                },
                {
                    "id": "625210302",
                    "speaker": "礼信",
                    "text": "这…我就不清楚了！我来飞云商会好些日子了，还没见过行秋少爷呢！"
                },
                {
                    "id": "625210303",
                    "speaker": "礼信",
                    "text": "但听说这沉玉谷有古华派的旧址，说不定哪天，行秋少爷一时兴起，就会过来看看！"
                },
                {
                    "id": "625210304",
                    "speaker": "礼信",
                    "text": "听说行秋少爷见多识广，说不定来了沉玉谷后，灵感大发，会给我们提些好点子！"
                }
            ]
        },
        {
            "talkId": "6252104",
            "initDialog": "625210401",
            "dialogues": [
                {
                    "id": "625210401",
                    "speaker": "Player",
                    "text": "下次再说…"
                },
                {
                    "id": "625210402",
                    "speaker": "礼信",
                    "text": "好的！期待与您正式合作的那天！"
                }
            ]
        }
    ]
}