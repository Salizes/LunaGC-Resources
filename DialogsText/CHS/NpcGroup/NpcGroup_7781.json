{
    "groupId": "7781",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "切尔卡斯基": 12
    },
    "talks": [
        {
            "talkId": "6778101",
            "initDialog": "677810101",
            "dialogues": [
                {
                    "id": "677810101",
                    "speaker": "切尔卡斯基",
                    "text": "怪了，怎么还是没有回复…"
                }
            ]
        },
        {
            "talkId": "6778102",
            "initDialog": "677810201",
            "dialogues": [
                {
                    "id": "677810201",
                    "speaker": "Player",
                    "text": "你在看什么呢？"
                },
                {
                    "id": "677810202",
                    "speaker": "切尔卡斯基",
                    "text": "留言板啊，我上次的留言，怎么一条回复都没有？"
                },
                {
                    "id": "677810203",
                    "speaker": "切尔卡斯基",
                    "text": "怪了，留言还在啊，为什么没有人回复呢？难道是被管理留言板的时候不小心清除掉了？"
                },
                {
                    "id": "677810204",
                    "speaker": "切尔卡斯基",
                    "text": "算了，还是先回复一些其他的留言吧…"
                }
            ]
        },
        {
            "talkId": "6778103",
            "initDialog": "677810301",
            "dialogues": [
                {
                    "id": "677810301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "677810302",
                    "speaker": "切尔卡斯基",
                    "text": "再见。怪了，真的没有回复…"
                }
            ]
        },
        {
            "talkId": "6778104",
            "initDialog": "677810401",
            "dialogues": [
                {
                    "id": "677810401",
                    "speaker": "Player",
                    "text": "这上面都写了什么？"
                },
                {
                    "id": "677810402",
                    "speaker": "切尔卡斯基",
                    "text": "有很多啊，比如最近发生的怪事，有趣的经历，各种问题…还有寻找兴趣相同的朋友，或者是寻找失物的。"
                },
                {
                    "id": "677810403",
                    "speaker": "切尔卡斯基",
                    "text": "每天的留言板上都会有很多信息，大家也很喜欢这种交流方式。"
                },
                {
                    "id": "677810404",
                    "speaker": "切尔卡斯基",
                    "text": "不过！使用留言板有一则铁律——呃，或者说，是我自己的一条铁律。"
                },
                {
                    "id": "677810405",
                    "speaker": "切尔卡斯基",
                    "text": "绝对，绝对不可以轻易和只交流过几条留言的人在现实里见面。"
                },
                {
                    "id": "677810406",
                    "speaker": "切尔卡斯基",
                    "text": "否则，有可能既交不到新朋友，同时还失去了一个会回复你留言的人啊…"
                }
            ]
        },
        {
            "talkId": "6778105",
            "initDialog": "677810501",
            "dialogues": [
                {
                    "id": "677810501",
                    "speaker": "Player",
                    "text": "总觉得你经历了什么…"
                },
                {
                    "id": "677810502",
                    "speaker": "切尔卡斯基",
                    "text": "我？没有啊！我能经历什么，哈哈…我的留言都没人回呢…"
                },
                {
                    "id": "677810503",
                    "speaker": "切尔卡斯基",
                    "text": "咳咳，我先去回复留言了。回复哪一条好呢…"
                }
            ]
        }
    ]
}