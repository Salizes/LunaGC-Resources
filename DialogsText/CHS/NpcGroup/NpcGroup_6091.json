    "talks": [
        {
            "talkId": "6609101",
            "initDialog": "660910101",
            "dialogues": [
                {
                    "id": "660910101",
                    "speaker": "卡安",
                    "text": "看到了吗，刚刚那个动作，好厉害！"
                }
            ]
        },
        {
            "talkId": "6609102",
            "initDialog": "660910201",
            "dialogues": [
                {
                    "id": "660910201",
                    "speaker": "Player",
                    "text": "你也想学？"
                },
                {
                    "id": "660910202",
                    "speaker": "卡安",
                    "text": "当然了，你不想吗？很帅欸！"
                },
                {
                    "id": "660910203",
                    "speaker": "卡安",
                    "text": "特佩利舞台上每天都有人比赛跳舞，大家会为优胜的一方欢呼，我长大以后也要加入！"
                },
                {
                    "id": "660910204",
                    "speaker": "卡安",
                    "text": "等我，等我多多锻炼，长得比舞台还高，比打碟的叔叔还壮，就能赢过所有人了！"
                }
            ]
        },
        {
            "talkId": "6609103",
            "initDialog": "660910301",
            "dialogues": [
                {
                    "id": "660910301",
                    "speaker": "Player",
                    "text": "是很厉害。"
                },
                {
                    "id": "660910302",
                    "speaker": "卡安",
                    "text": "对吧！我也要学！"
                }
            ]
        },
        {
            "talkId": "6609104",
            "initDialog": "660910401",
            "dialogues": [
                {
                    "id": "660910401",
                    "speaker": "Player",
                    "text": "练习前记得先做拉伸。"
                },
                {
                    "id": "660910402",
                    "speaker": "卡安",
                    "text": "知道啦，我妈妈也这么说。我会注意身体的！"
                },
                {
                    "id": "660910403",
                    "speaker": "卡安",
                    "text": "毕竟，我不仅要成为优秀的舞者，也要成为英勇的战士。"
                },
                {
                    "id": "660910404",
                    "speaker": "卡安",
                    "text": "就像…就像卡齐娜姐姐一样！"
                },
                {
                    "id": "660910405",
                    "speaker": "卡安",
                    "text": "对了，她上次教我的动作，我还没练熟呢…"
                }
            ]
        }
    ]
}