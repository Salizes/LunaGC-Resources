        "贾瓦德": 7
    },
    "talks": [
        {
            "talkId": "6407501",
            "initDialog": "640750101",
            "dialogues": [
                {
                    "id": "640750101",
                    "speaker": "贾瓦德",
                    "text": "哎呦，痛…"
                }
            ]
        },
        {
            "talkId": "6407502",
            "initDialog": "640750201",
            "dialogues": [
                {
                    "id": "640750201",
                    "speaker": "Player",
                    "text": "你很难受？"
                },
                {
                    "id": "640750202",
                    "speaker": "贾瓦德",
                    "text": "确实难受，但已经习惯了。"
                },
                {
                    "id": "640750203",
                    "speaker": "贾瓦德",
                    "text": "我这个病啊，连最好的医生看了也摇头，我是不抱什么希望咯。"
                },
                {
                    "id": "640750204",
                    "speaker": "贾瓦德",
                    "text": "与其唉声叹气，活得畏畏缩缩，我觉得还是及时行乐比较值得。"
                }
            ]
        },
        {
            "talkId": "6407503",
            "initDialog": "640750301",
            "dialogues": [
                {
                    "id": "640750301",
                    "speaker": "Player",
                    "text": "你多保重。"
                },
                {
                    "id": "640750302",
                    "speaker": "贾瓦德",
                    "text": "好哦。"
                }
            ]
        },
        {
            "talkId": "7393901",
            "initDialog": "739390101",
            "dialogues": [
                {
                    "id": "739390101",
                    "speaker": "Player",
                    "text": "好好休息吧。"
                },
                {
                    "id": "739390102",
                    "speaker": "贾瓦德",
                    "text": "多谢你的好意，我心领了，但生活还要继续。"
                },
                {
                    "id": "739390103",
                    "speaker": "贾瓦德",
                    "text": "一想到以后每天都要喝这么苦的药，还不如让我少活几年呢！"
                }
            ]
        }
    ]
}