            "dialogues": [
                {
                    "id": "614590101",
                    "speaker": "波尔托",
                    "text": "…欢迎。"
                }
            ]
        },
        {
            "talkId": "6145902",
            "initDialog": "614590201",
            "dialogues": [
                {
                    "id": "614590201",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "614590202",
                    "speaker": "波尔托",
                    "text": "骑士团总部，看你不像可疑人，直接进去吧。"
                }
            ]
        },
        {
            "talkId": "6145903",
            "initDialog": "614590301",
            "dialogues": [
                {
                    "id": "614590301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614590302",
                    "speaker": "波尔托",
                    "text": "祝顺利。"
                }
            ]
        },
        {
            "talkId": "6145904",
            "initDialog": "614590401",
            "dialogues": [
                {
                    "id": "614590401",
                    "speaker": "波尔托",
                    "text": "现在气候异常，外面很危险，一般民众请找安全的地方避难。"
                }
            ]
        },
        {
            "talkId": "6145905",
            "initDialog": "614590501",
            "dialogues": [
                {
                    "id": "614590501",
                    "speaker": "波尔托",
                    "text": "那条龙随时可能回来，我们西风骑士会盯着的，请抓紧避难。"
                }
            ]
        },
        {
            "talkId": "6145906",
            "initDialog": "614590601",
            "dialogues": [
                {
                    "id": "614590601",
                    "speaker": "波尔托",
                    "text": "现在是紧急事态，请相信我们西风骑士会保障大家的安全。"
                }
            ]
        }
    ]
}