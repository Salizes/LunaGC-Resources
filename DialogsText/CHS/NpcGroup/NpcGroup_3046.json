        {
            "talkId": "6304602",
            "initDialog": "630460201",
            "dialogues": [
                {
                    "id": "630460201",
                    "speaker": "Player",
                    "text": "关于将军大人…"
                },
                {
                    "id": "630460202",
                    "speaker": "天野",
                    "text": "将军大人的威名震慑四方，守护稻妻永恒的和平。"
                },
                {
                    "id": "630460203",
                    "speaker": "天野",
                    "text": "虽然锁国令…不，没什么，对此我没有疑问。"
                },
                {
                    "id": "630460204",
                    "speaker": "天野",
                    "text": "外人来的当然越少越好。你这样的人既然来到了稻妻，就要注意遵守这里的规矩。"
                }
            ]
        },
        {
            "talkId": "6304603",
            "initDialog": "630460301",
            "dialogues": [
                {
                    "id": "630460301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630460302",
                    "speaker": "天野",
                    "text": "再见，异乡人。"
                }
            ]
        },
        {
            "talkId": "6304604",
            "initDialog": "630460401",
            "dialogues": [
                {
                    "id": "630460401",
                    "speaker": "Player",
                    "text": "关于将军大人…"
                },
                {
                    "id": "630460402",
                    "speaker": "天野",
                    "text": "将军大人的威名震慑四方，守护稻妻永恒的和平。"
                },
                {
                    "id": "630460403",
                    "speaker": "天野",
                    "text": "对于将军大人的任何决定，我都没有疑问。"
                },
                {
                    "id": "630460404",
                    "speaker": "天野",
                    "text": "就算锁国令解除了，来到稻妻的外国人也还是要遵守这里的规矩。"
                }
            ]
        }
    ]
