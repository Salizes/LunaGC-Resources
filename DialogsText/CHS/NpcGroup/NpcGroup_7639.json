{
    "groupId": "7639",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "柳别尔齐": 7
    },
    "talks": [
        {
            "talkId": "6763901",
            "initDialog": "676390101",
            "dialogues": [
                {
                    "id": "676390101",
                    "speaker": "柳别尔齐",
                    "text": "不管什么任务，出发前都得先做好万全的准备。"
                }
            ]
        },
        {
            "talkId": "6763902",
            "initDialog": "676390201",
            "dialogues": [
                {
                    "id": "676390201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "676390202",
                    "speaker": "柳别尔齐",
                    "text": "负责安排杂务与基础工作的普通执灯士。您也可以将我视为这里的接待员。"
                },
                {
                    "id": "676390203",
                    "speaker": "柳别尔齐",
                    "text": "如果您遇到了什么需要执灯人处理的危险，就请直接告诉我吧，我会安排人手解决。"
                }
            ]
        },
        {
            "talkId": "6763903",
            "initDialog": "676390301",
            "dialogues": [
                {
                    "id": "676390301",
                    "speaker": "Player",
                    "text": "有什么需要帮忙的吗？"
                },
                {
                    "id": "676390302",
                    "speaker": "柳别尔齐",
                    "text": "谢谢您的好意。不过，我手头的工作都是些确保驻地不出差错的琐事，就不劳烦您帮忙了。"
                },
                {
                    "id": "676390303",
                    "speaker": "柳别尔齐",
                    "text": "如果您想帮忙的话…我想想，您也许可以去找叶洛亚问问看——就是「魇夜之莺」调查分队的队长。"
                },
                {
                    "id": "676390304",
                    "speaker": "柳别尔齐",
                    "text": "年轻人总是想着把所有责任都担在自己身上，长此以往只会…抱歉，是我啰嗦了。总之那边应该还缺人手，您可以去看看情况。"
                }
            ]
        },
        {
            "talkId": "6763904",
            "initDialog": "676390401",
            "dialogues": [
                {
                    "id": "676390401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "676390402",
                    "speaker": "柳别尔齐",
                    "text": "嗯，无论何时，都请您务必注意安全。"
                }
            ]
        }
    ]
}