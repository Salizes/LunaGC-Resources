{
    "groupId": "2300",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "凯叔": 9
    },
    "talks": [
        {
            "talkId": "4111547",
            "initDialog": "411154701",
            "dialogues": [
                {
                    "id": "411154701",
                    "speaker": "凯叔",
                    "text": "来喝茶吗？快坐快坐。唉，这陨石的事闹得人心惶惶的，来我这聊天的人更少了。"
                }
            ]
        },
        {
            "talkId": "6230001",
            "initDialog": "623000101",
            "dialogues": [
                {
                    "id": "623000101",
                    "speaker": "凯叔",
                    "text": "是来喝茶的吧，快坐快坐，这边请。"
                }
            ]
        },
        {
            "talkId": "6230002",
            "initDialog": "623000201",
            "dialogues": [
                {
                    "id": "623000201",
                    "speaker": "Player",
                    "text": "关于茶铺。"
                },
                {
                    "id": "623000202",
                    "speaker": "凯叔",
                    "text": "看大家每天做农活没个歇息的地方，我就支了这么个铺子，方便方便老友和过路人。"
                },
                {
                    "id": "623000203",
                    "speaker": "凯叔",
                    "text": "只不过你也看到了，生意不太好，哈哈。"
                },
                {
                    "id": "623000204",
                    "speaker": "凯叔",
                    "text": "但每次有人来我这儿点碗茶聊两句的时候，我就觉得，果然开这么个铺子是值得的。"
                }
            ]
        },
        {
            "talkId": "6230003",
            "initDialog": "623000301",
            "dialogues": [
                {
                    "id": "623000301",
                    "speaker": "Player",
                    "text": "店里就你一个人吗？"
                },
                {
                    "id": "623000302",
                    "speaker": "凯叔",
                    "text": "是啊，我儿子和儿媳都在外面闯生活，就我和孙子孙女留在村子里。"
                },
                {
                    "id": "623000303",
                    "speaker": "凯叔",
                    "text": "唉，要是多个帮手的话，下田的时候这铺子就能继续开着了。"
                }
            ]
        },
        {
            "talkId": "6230004",
            "initDialog": "623000401",
            "dialogues": [
                {
                    "id": "623000401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "623000402",
                    "speaker": "凯叔",
                    "text": "这就要走了吗？好吧，路上小心。"
                }
            ]
        },
        {
            "talkId": "6230005",
            "initDialog": "623000501",
            "dialogues": [
                {
                    "id": "623000501",
                    "speaker": "Player",
                    "text": "您这里卖什么？"
                },
                {
                    "id": "623000502",
                    "speaker": "凯叔",
                    "text": "坐下歇歇脚吧，来尝尝我们轻策庄的茶水。"
                }
            ]
        }
    ]
}