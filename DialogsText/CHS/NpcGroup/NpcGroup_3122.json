{
    "groupId": "3122",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "寺田": 15
    },
    "talks": [
        {
            "talkId": "6312201",
            "initDialog": "631220101",
            "dialogues": [
                {
                    "id": "631220101",
                    "speaker": "寺田",
                    "text": "欸！你是哪里来的？"
                },
                {
                    "id": "631220102",
                    "speaker": "寺田",
                    "text": "军事重地岂能容闲人乱逛，还不速速离去！"
                }
            ]
        },
        {
            "talkId": "6312202",
            "initDialog": "631220201",
            "dialogues": [
                {
                    "id": "631220201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "631220202",
                    "speaker": "寺田",
                    "text": "看我的行头还看不出来吗？本大人可是官兵，身受特殊任务来此岛上。"
                },
                {
                    "id": "631220203",
                    "speaker": "寺田",
                    "text": "哼哼，你这个外国人可要小心点，不要惹麻烦，不然我必将你绳之以法。"
                }
            ]
        },
        {
            "talkId": "6312203",
            "initDialog": "631220301",
            "dialogues": [
                {
                    "id": "631220301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "631220302",
                    "speaker": "寺田",
                    "text": "快走快走！"
                }
            ]
        },
        {
            "talkId": "6312204",
            "initDialog": "631220401",
            "dialogues": [
                {
                    "id": "631220401",
                    "speaker": "Player",
                    "text": "你有什么任务？"
                },
                {
                    "id": "631220402",
                    "speaker": "寺田",
                    "text": "什么任务…你说在这种地方还能有什么任务啊！"
                },
                {
                    "id": "631220403",
                    "speaker": "寺田",
                    "text": "当然就是…呃，惩奸除恶…斩杀…「寻歼逆贼」！"
                },
                {
                    "id": "631220404",
                    "speaker": "寺田",
                    "text": "嗯，你这么理解就可以了！说多了你也不懂。"
                }
            ]
        },
        {
            "talkId": "6312205",
            "initDialog": "631220501",
            "dialogues": [
                {
                    "id": "631220501",
                    "speaker": "Player",
                    "text": "只有你一个吗？"
                },
                {
                    "id": "631220502",
                    "speaker": "寺田",
                    "text": "这不是还有我的跟班吗？"
                },
                {
                    "id": "631220503",
                    "speaker": "寺田",
                    "text": "像我这种精英，不需要那么多人跟着就能完成任务。"
                },
                {
                    "id": "631220504",
                    "speaker": "寺田",
                    "text": "无论什么奸臣乱贼，只要我一刀就能解决，犯不上要其他人帮忙。"
                }
            ]
        },
        {
            "talkId": "6312206",
            "initDialog": "631220601",
            "dialogues": [
                {
                    "id": "631220601",
                    "speaker": "Player",
                    "text": "看起来好可疑，我要上报。"
                },
                {
                    "id": "631220602",
                    "speaker": "寺田",
                    "text": "欸！等等等等，这是做什么，有话好好说…"
                },
                {
                    "id": "631220603",
                    "speaker": "寺田",
                    "text": "我在这一没碍着别人，二没做什么坏事，你老揪着我不放干嘛。"
                },
                {
                    "id": "631220604",
                    "speaker": "寺田",
                    "text": "我只是一个奉命在此巡逻的武士，仅此而已。咱井水不犯河水，饶了我吧。"
                },
                {
                    "id": "631220605",
                    "speaker": "寺田",
                    "text": "你这外国人再找茬的话，我还要把你上报呢！小心上头给你抓起来。"
                }
            ]
        }
    ]
}