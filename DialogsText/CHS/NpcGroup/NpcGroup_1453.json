{
    "groupId": "1453",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "苏西": 11
    },
    "talks": [
        {
            "talkId": "6145301",
            "initDialog": "4015145301",
            "dialogues": [
                {
                    "id": "4015145301",
                    "speaker": "苏西",
                    "text": "愿蒙德的风一直护佑着你！"
                }
            ]
        },
        {
            "talkId": "6145302",
            "initDialog": "4015145302",
            "dialogues": [
                {
                    "id": "4015145302",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "4015145306",
                    "speaker": "苏西",
                    "text": "我跟你一样，都是受到风神巴巴托斯护佑的人。"
                },
                {
                    "id": "4015145307",
                    "speaker": "苏西",
                    "text": "我们都应该为这和风与温暖向巴巴托斯献上感谢，不是吗？"
                },
                {
                    "id": "4015145303",
                    "speaker": "Player",
                    "text": "蒙德的风？"
                },
                {
                    "id": "4015145308",
                    "speaker": "苏西",
                    "text": "蒙德，是受到风神巴巴托斯护佑的城市。"
                },
                {
                    "id": "4015145309",
                    "speaker": "苏西",
                    "text": "这吹过蒙德的和风，就是巴巴托斯对蒙德人民的祝福哦。"
                }
            ]
        },
        {
            "talkId": "6145303",
            "initDialog": "4015145304",
            "dialogues": [
                {
                    "id": "4015145304",
                    "speaker": "Player",
                    "text": "城里有什么值得一去的地方吗？"
                },
                {
                    "id": "4015145310",
                    "speaker": "苏西",
                    "text": "如果您对巴巴托斯大人感兴趣的话，请一定要到蒙德城的大教堂来看一看！"
                },
                {
                    "id": "4015145311",
                    "speaker": "苏西",
                    "text": "据说巴巴托斯大人的神器，传说中的天空之琴就收藏在教堂里面！"
                }
            ]
        },
        {
            "talkId": "6145304",
            "initDialog": "4015145305",
            "dialogues": [
                {
                    "id": "4015145305",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "4015145312",
                    "speaker": "苏西",
                    "text": "再见，风神庇护的人，愿蒙德的风一直护佑着你。"
                }
            ]
        },
        {
            "talkId": "6145305",
            "initDialog": "614530501",
            "dialogues": [
                {
                    "id": "614530501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614530502",
                    "speaker": "苏西",
                    "text": "为什么蒙德会出现这样的事情呢…"
                },
                {
                    "id": "614530503",
                    "speaker": "苏西",
                    "text": "难道是我祈祷得不够真诚？"
                },
                {
                    "id": "614530504",
                    "speaker": "苏西",
                    "text": "…不，一定是其他人的问题，我祈祷的时候可是在全心全意地祈祷啊…"
                }
            ]
        }
    ]
}