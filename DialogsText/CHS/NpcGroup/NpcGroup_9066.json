{
    "groupId": "9066",
    "total_dialogue_lines": 73,
    "speaker_counts": {
        "Player": 19,
        "神里绫人": 54
    },
    "talks": [
        {
            "talkId": "6906601",
            "initDialog": "690660101",
            "dialogues": [
                {
                    "id": "690660101",
                    "speaker": "神里绫人",
                    "text": "#{NICKNAME}，你好。"
                },
                {
                    "id": "690660102",
                    "speaker": "神里绫人",
                    "text": "来得正是时候，这里有一件只有你出面才能处理的任务。"
                },
                {
                    "id": "690660103",
                    "speaker": "神里绫人",
                    "text": "…呵呵，只是想这样说说看。"
                }
            ]
        },
        {
            "talkId": "6906602",
            "initDialog": "690660201",
            "dialogues": [
                {
                    "id": "690660201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690660202",
                    "speaker": "神里绫人",
                    "text": "当然。"
                },
                {
                    "id": "690660203",
                    "speaker": "神里绫人",
                    "text": "虽说摆设我多数见过，但布局却又与我平日里见的不同。"
                },
                {
                    "id": "690660204",
                    "speaker": "神里绫人",
                    "text": "如此巧妙的构思，处处皆有新奇…着实不错。"
                },
                {
                    "id": "690660205",
                    "speaker": "神里绫人",
                    "text": "不如我差人把社奉行府也改成这种风格吧。"
                },
                {
                    "id": "690660206",
                    "speaker": "神里绫人",
                    "text": "你来当监工，如何？",
                    "choices": [
                        {
                            "id": "690660207",
                            "text": "该不是说笑的吧…",
                            "response": [
                                {
                                    "id": "690660208",
                                    "speaker": "神里绫人",
                                    "text": "啊，被看出来了吗？看来我的演技有所退步啊。"
                                },
                                {
                                    "id": "690660212",
                                    "speaker": "神里绫人",
                                    "text": "话又说回来，这里的确让我很有新鲜感。"
                                },
                                {
                                    "id": "690660213",
                                    "speaker": "神里绫人",
                                    "text": "就请允许我多来拜访吧。"
                                }
                            ]
                        },
                        {
                            "id": "690660209",
                            "text": "呃…不太合适吧…",
                            "response": [
                                {
                                    "id": "690660210",
                                    "speaker": "神里绫人",
                                    "text": "呵呵，怎么露出这么为难的表情呢？"
                                },
                                {
                                    "id": "690660211",
                                    "speaker": "神里绫人",
                                    "text": "既然如此，那就不好勉强了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906603",
            "initDialog": "690660301",
            "dialogues": [
                {
                    "id": "690660301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690660302",
                    "speaker": "神里绫人",
                    "text": "你想聊天自然可以。想说些什么？",
                    "choices": [
                        {
                            "id": "690660303",
                            "text": "关心一下社奉行的工作…",
                            "response": [
                                {
                                    "id": "690660304",
                                    "speaker": "神里绫人",
                                    "text": "我还以为会让你主动问起的，是更私人的话题。"
                                },
                                {
                                    "id": "690660305",
                                    "speaker": "神里绫人",
                                    "text": "不用担心我在工作上操劳过度。"
                                },
                                {
                                    "id": "690660306",
                                    "speaker": "神里绫人",
                                    "text": "你看，我还有余力像这样说笑呢，呵呵。",
                                    "choices": [
                                        {
                                            "id": "690660307",
                                            "text": "不觉得辛苦吗？",
                                            "response": [
                                                {
                                                    "id": "690660308",
                                                    "speaker": "神里绫人",
                                                    "text": "觉得辛苦，多半是尚未发现自己想守护的东西吧。"
                                                },
                                                {
                                                    "id": "690660309",
                                                    "speaker": "神里绫人",
                                                    "text": "对于我而言，不会有这种困扰。"
                                                },
                                                {
                                                    "id": "690660313",
                                                    "speaker": "Player",
                                                    "text": "真厉害…"
                                                },
                                                {
                                                    "id": "690660314",
                                                    "speaker": "神里绫人",
                                                    "text": "能得到你的赞美和关心，真是不胜荣幸。"
                                                },
                                                {
                                                    "id": "690660315",
                                                    "speaker": "神里绫人",
                                                    "text": "也请你放心吧。现如今，没有人比我更适合社奉行这个位置了。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690660310",
                                            "text": "不觉得事情太多吗？",
                                            "response": [
                                                {
                                                    "id": "690660311",
                                                    "speaker": "神里绫人",
                                                    "text": "工作量庞大吗？也是，但这是无法避免的。"
                                                },
                                                {
                                                    "id": "690660312",
                                                    "speaker": "神里绫人",
                                                    "text": "那就尽量用聪明些的方法一件件处理吧。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690660316",
                            "text": "关心一下社奉行的生活…",
                            "response": [
                                {
                                    "id": "690660317",
                                    "speaker": "神里绫人",
                                    "text": "生活吗…公务之余，能够自由支配的时间确实不多。"
                                },
                                {
                                    "id": "690660318",
                                    "speaker": "神里绫人",
                                    "text": "既然你想关心我的生活，不如直接一点，任命你做我的近侍吧。"
                                },
                                {
                                    "id": "690660319",
                                    "speaker": "神里绫人",
                                    "text": "饮食起居，就交给你负责了。"
                                },
                                {
                                    "id": "690660320",
                                    "speaker": "神里绫人",
                                    "text": "啊…餐饮方面我没有忌口，生活上的怪癖，嗯…也应该没有。"
                                },
                                {
                                    "id": "690660321",
                                    "speaker": "神里绫人",
                                    "text": "要是有什么口味新奇的东西，可以给我带一份。",
                                    "choices": [
                                        {
                                            "id": "690660322",
                                            "text": "比如奇怪的料理？",
                                            "response": [
                                                {
                                                    "id": "690660323",
                                                    "speaker": "神里绫人",
                                                    "text": "哦？你可以试试看哦。"
                                                },
                                                {
                                                    "id": "690660326",
                                                    "speaker": "Player",
                                                    "text": "原来这次是认真的…"
                                                },
                                                {
                                                    "id": "690660327",
                                                    "speaker": "神里绫人",
                                                    "text": "啊，当然。"
                                                },
                                                {
                                                    "id": "690660328",
                                                    "speaker": "神里绫人",
                                                    "text": "没关系。我会多给你一些考虑的时间，我们从长计议吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690660324",
                                            "text": "比如新奇的奶茶？",
                                            "response": [
                                                {
                                                    "id": "690660325",
                                                    "speaker": "神里绫人",
                                                    "text": "嗯，我还挺期待的。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906604",
            "initDialog": "690660401",
            "dialogues": [
                {
                    "id": "690660401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690660402",
                    "speaker": "神里绫人",
                    "text": "#{NICKNAME}，不知你此前是否遛过狗呢？"
                },
                {
                    "id": "690660403",
                    "speaker": "Player",
                    "text": "遛…遛狗？"
                },
                {
                    "id": "690660404",
                    "speaker": "神里绫人",
                    "text": "嗯，就是陪狗一起散步。"
                },
                {
                    "id": "690660405",
                    "speaker": "神里绫人",
                    "text": "狗生性忠诚。但就算它们再乖巧，总在一个地方憋着也是会不太愉快的。"
                },
                {
                    "id": "690660406",
                    "speaker": "神里绫人",
                    "text": "和它们一起出门，看它们腾飞四肢，肆意奔跑玩耍的样子，心情也会放松下来。"
                },
                {
                    "id": "690660407",
                    "speaker": "神里绫人",
                    "text": "不想试试吗？",
                    "choices": [
                        {
                            "id": "690660408",
                            "text": "我有点紧张…",
                            "response": [
                                {
                                    "id": "690660409",
                                    "speaker": "神里绫人",
                                    "text": "没关系。我会差人准备好性格温顺的狗。"
                                },
                                {
                                    "id": "690660410",
                                    "speaker": "神里绫人",
                                    "text": "或者…就请太郎丸出马吧。"
                                },
                                {
                                    "id": "690660411",
                                    "speaker": "Player",
                                    "text": "那就试试吧。"
                                },
                                {
                                    "id": "690660414",
                                    "speaker": "神里绫人",
                                    "text": "总之，如果刚开始你有所顾虑的话，我们可以先在这里，权当练习。"
                                },
                                {
                                    "id": "690660415",
                                    "speaker": "神里绫人",
                                    "text": "等你也能享受这种乐趣之后，就一起去町街吧。"
                                },
                                {
                                    "id": "690660416",
                                    "speaker": "神里绫人",
                                    "text": "边喝奶茶边遛狗…似乎会引发不小的轰动。"
                                },
                                {
                                    "id": "690660417",
                                    "speaker": "神里绫人",
                                    "text": "呵呵，但也不坏。"
                                }
                            ]
                        },
                        {
                            "id": "690660412",
                            "text": "好呀。",
                            "response": [
                                {
                                    "id": "690660413",
                                    "speaker": "神里绫人",
                                    "text": "呵呵，答应得这么干脆么。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906605",
            "initDialog": "690660501",
            "dialogues": [
                {
                    "id": "690660501",
                    "speaker": "Player",
                    "text": "早啊，绫人。"
                },
                {
                    "id": "690660502",
                    "speaker": "神里绫人",
                    "text": "#早，{NICKNAME}。"
                },
                {
                    "id": "690660503",
                    "speaker": "神里绫人",
                    "text": "一起吃早饭吗？我让家仆们多备了一份。"
                }
            ]
        },
        {
            "talkId": "6906606",
            "initDialog": "690660601",
            "dialogues": [
                {
                    "id": "690660601",
                    "speaker": "Player",
                    "text": "晚安，绫人。"
                },
                {
                    "id": "690660602",
                    "speaker": "神里绫人",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690660603",
                    "speaker": "神里绫人",
                    "text": "放心睡吧，不会有人敢来打扰的。"
                }
            ]
        },
        {
            "talkId": "6906607",
            "initDialog": "690660701",
            "dialogues": [
                {
                    "id": "690660701",
                    "speaker": "神里绫人",
                    "text": "这里…倒是让我想起来，绫华小时候和我一起逛祭典的场景了…"
                },
                {
                    "id": "690660702",
                    "speaker": "神里绫人",
                    "text": "嗯，你布置的街市，就算是身为社奉行的我，也挑不出毛病。"
                },
                {
                    "id": "690660703",
                    "speaker": "神里绫人",
                    "text": "现下这里只有你我二人倒也不错，不如陪我走走？"
                }
            ]
        },
        {
            "talkId": "6906608",
            "initDialog": "690660801",
            "dialogues": [
                {
                    "id": "690660801",
                    "speaker": "神里绫人",
                    "text": "这里的布置确实巧妙，外形上取了三奉行府第的特征，布景上又兼顾了美感。"
                },
                {
                    "id": "690660802",
                    "speaker": "神里绫人",
                    "text": "熟悉的环境令人惬意，身边同行之人也不乏雅趣。"
                },
                {
                    "id": "690660803",
                    "speaker": "神里绫人",
                    "text": "呵呵，真是愉快。"
                }
            ]
        }
    ]
}