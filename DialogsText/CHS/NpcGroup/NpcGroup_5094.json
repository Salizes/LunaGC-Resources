{
    "groupId": "5094",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "蕾欧妮": 8
    },
    "talks": [
        {
            "talkId": "6509401",
            "initDialog": "650940101",
            "dialogues": [
                {
                    "id": "650940101",
                    "speaker": "蕾欧妮",
                    "text": "欢迎光临！今天天气真不错，有什么需要帮助的吗？"
                }
            ]
        },
        {
            "talkId": "6509402",
            "initDialog": "650940201",
            "dialogues": [
                {
                    "id": "650940201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "650940202",
                    "speaker": "蕾欧妮",
                    "text": "您好，这里是「德波大饭店」，美食与艺术交融的舞台。"
                },
                {
                    "id": "650940203",
                    "speaker": "蕾欧妮",
                    "text": "愿您在这里既能享受美食，也能观赏到最精彩的艺术表演。"
                }
            ]
        },
        {
            "talkId": "6509403",
            "initDialog": "650940301",
            "dialogues": [
                {
                    "id": "650940301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650940302",
                    "speaker": "蕾欧妮",
                    "text": "请慢走。"
                }
            ]
        },
        {
            "talkId": "6509404",
            "initDialog": "650940401",
            "dialogues": [
                {
                    "id": "650940401",
                    "speaker": "Player",
                    "text": "关于演出…"
                },
                {
                    "id": "650940402",
                    "speaker": "蕾欧妮",
                    "text": "如果要我推荐的话，当然是大魔术师林尼与琳妮特的魔术秀了。"
                },
                {
                    "id": "650940403",
                    "speaker": "蕾欧妮",
                    "text": "他们的魔术精妙绝伦，还经常有很多意想不到的创意。"
                },
                {
                    "id": "650940404",
                    "speaker": "蕾欧妮",
                    "text": "不过他们的演出时间也和他们的魔术一样，令人难以预测…"
                },
                {
                    "id": "650940405",
                    "speaker": "蕾欧妮",
                    "text": "如果客人有机会碰到的话，可以说是非常幸运了。"
                }
            ]
        }
    ]
}