{
    "groupId": "4232",
    "total_dialogue_lines": 72,
    "speaker_counts": {
        "Player": 12,
        "派蒙": 13,
        "赛芭": 44,
        "齐亚德": 3
    },
    "talks": [
        {
            "talkId": "6423201",
            "initDialog": "642320101",
            "dialogues": [
                {
                    "id": "642320101",
                    "speaker": "赛芭",
                    "text": "我们种下的须弥蔷薇，还有阿凡老先生苗圃里的金蔷薇，都长得很好，这都得谢谢你。"
                }
            ]
        },
        {
            "talkId": "6423203",
            "initDialog": "642320301",
            "dialogues": [
                {
                    "id": "642320301",
                    "speaker": "Player",
                    "text": "你是哪个学派的学者？"
                },
                {
                    "id": "642320302",
                    "speaker": "赛芭",
                    "text": "想聊聊我的学派？我能说上三天三夜都不停，哈哈。"
                },
                {
                    "id": "642320303",
                    "speaker": "赛芭",
                    "text": "我以前属于生论派，专攻植物演化，算是一门实证研究学科吧。"
                },
                {
                    "id": "642320304",
                    "speaker": "赛芭",
                    "text": "这意味着没有新材料就很难发现新结论，你可以简单理解成：要考察过去的植物，历史标本是研究基础。"
                },
                {
                    "id": "642320305",
                    "speaker": "赛芭",
                    "text": "但是便于搜集的标本就那么多，它们基本上都被搜罗得差不多了，教令院能提供的新标本有限。"
                },
                {
                    "id": "642320306",
                    "speaker": "赛芭",
                    "text": "客观条件就是这样，但院内还是在不断要求研究指标。"
                },
                {
                    "id": "642320307",
                    "speaker": "赛芭",
                    "text": "有人就把以前的研究成果拿出来，改一改凑一凑，也算交差了。你肯定也觉得这样很没意思对吧？"
                }
            ]
        },
        {
            "talkId": "6423204",
            "initDialog": "642320401",
            "dialogues": [
                {
                    "id": "642320401",
                    "speaker": "Player",
                    "text": "阿如村的生活怎么样？"
                },
                {
                    "id": "642320402",
                    "speaker": "赛芭",
                    "text": "谢谢你的关心，我很好。"
                },
                {
                    "id": "642320403",
                    "speaker": "赛芭",
                    "text": "邻居们都很关照我，阿凡老先生也经常来找我聊天，比起之前…寂寞的时候已经少很多了。"
                },
                {
                    "id": "642320404",
                    "speaker": "赛芭",
                    "text": "虽然作为被放逐的人，没办法奢求藏书和研究器材，不过只要向智之心还在，在哪里都可以求知。"
                }
            ]
        },
        {
            "talkId": "6423205",
            "initDialog": "642320501",
            "dialogues": [
                {
                    "id": "642320501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642320502",
                    "speaker": "赛芭",
                    "text": "再见，祝你旅途顺利。"
                }
            ]
        },
        {
            "talkId": "6423206",
            "initDialog": "642320601",
            "dialogues": [
                {
                    "id": "642320601",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "642320602",
                    "speaker": "赛芭",
                    "text": "其实我们完全可以尝试从历史地理的角度，找一找新材料，这样一定能有新发现。"
                },
                {
                    "id": "642320603",
                    "speaker": "赛芭",
                    "text": "一些不受生论派重视的文学材料也是可以利用的。不过这样的话，难免要涉及因论派和知论派的领域了。"
                },
                {
                    "id": "642320604",
                    "speaker": "赛芭",
                    "text": "我并不具备那些领域的知识，申请相关「知识」的手续又太麻烦，和相关领域的学者合作更是难上加难…"
                },
                {
                    "id": "642320605",
                    "speaker": "赛芭",
                    "text": "但是我相信，如果我们能做到跨学科合作的话，过去的很多问题就可以得到突破性进展。"
                },
                {
                    "id": "642320606",
                    "speaker": "赛芭",
                    "text": "只是可惜这样的尝试没能进行下去，因论派和知论派的怪人们讨论事情的角度特别…嗯…奇妙。"
                },
                {
                    "id": "642320607",
                    "speaker": "赛芭",
                    "text": "我交给他们的提案里，所有的措辞都得仔细斟酌，要不然就会出现误会。"
                },
                {
                    "id": "642320608",
                    "speaker": "赛芭",
                    "text": "被赶出教令院之前，我还在跟一个知论派的家伙吵架。现在好了，想找他们吵架也难了…"
                }
            ]
        },
        {
            "talkId": "7319301",
            "initDialog": "731930101",
            "dialogues": [
                {
                    "id": "731930101",
                    "speaker": "齐亚德",
                    "text": "♪蔷薇啊蔷薇，实现我的愿望。"
                },
                {
                    "id": "731930102",
                    "speaker": "齐亚德",
                    "text": "♪花从石头中绽放，金蔷薇对我歌唱。"
                },
                {
                    "id": "731930103",
                    "speaker": "齐亚德",
                    "text": "♪她唱…"
                },
                {
                    "id": "731930104",
                    "speaker": "派蒙",
                    "text": "这是须弥本地的童谣吧。会唱歌的蔷薇，嗯，是首可爱的歌呢。"
                },
                {
                    "id": "731930105",
                    "speaker": "派蒙",
                    "text": "可惜那个男孩唱到一半就跑开了，本来我还想听完再打个招呼的。"
                },
                {
                    "id": "731930106",
                    "speaker": "赛芭",
                    "text": "是生面孔啊，两位客人是第一次来阿如村吗？",
                    "choices": [
                        {
                            "id": "731930107",
                            "text": "是的。",
                            "response": [
                                {
                                    "id": "731930108",
                                    "speaker": "赛芭",
                                    "text": "这就对了，难怪你们没听过蔷薇歌谣。"
                                },
                                {
                                    "id": "731930111",
                                    "speaker": "赛芭",
                                    "text": "你们是从其他国家来须弥求学的学者吧，我记得教令院里有很多异国学者。"
                                },
                                {
                                    "id": "731930112",
                                    "speaker": "派蒙",
                                    "text": "虽然我们是认识很多学者没错，但要说我们自己…哎呀，还算不上啦。"
                                },
                                {
                                    "id": "731930113",
                                    "speaker": "派蒙",
                                    "text": "#严格来说，我们是冒险家哦，周游世界的冒险家二人组——派蒙和{NICKNAME}。"
                                },
                                {
                                    "id": "731930114",
                                    "speaker": "赛芭",
                                    "text": "周游世界吗？哈哈哈哈…"
                                },
                                {
                                    "id": "731930115",
                                    "speaker": "派蒙",
                                    "text": "怎么嘛？有什么好笑的啦，我们可是很有名的冒险家，你别不信。"
                                },
                                {
                                    "id": "731930116",
                                    "speaker": "赛芭",
                                    "text": "啊，两位远道来的客人，我并不是在嘲笑你们。正相反，听到周游世界这种让人振奋的话，我很开心。"
                                },
                                {
                                    "id": "731930117",
                                    "speaker": "赛芭",
                                    "text": "跟世界脱节太久，突然听到这样的豪言壮语，还有些惊讶。"
                                },
                                {
                                    "id": "731930118",
                                    "speaker": "赛芭",
                                    "text": "这才一时做出了冒犯的行为，我叫作赛芭，向两位道歉，同时也欢迎你们来到阿如村。"
                                },
                                {
                                    "id": "731930119",
                                    "speaker": "赛芭",
                                    "text": "对了，你们刚才是在讨论齐亚德唱的蔷薇歌谣吗？",
                                    "choices": [
                                        {
                                            "id": "731930120",
                                            "text": "没错。",
                                            "response": [
                                                {
                                                    "id": "731930122",
                                                    "speaker": "赛芭",
                                                    "text": "既然你们感兴趣，我们可以聊聊蔷薇歌谣，希望这些闲聊能点缀你们的旅程。"
                                                },
                                                {
                                                    "id": "731930123",
                                                    "speaker": "派蒙",
                                                    "text": "赛芭小姐打算给我们唱歌听吗？好啊好啊，刚才那首歌谣特别好听，我正想听完呢。"
                                                },
                                                {
                                                    "id": "731930124",
                                                    "speaker": "赛芭",
                                                    "text": "抱歉，我不太擅长唱歌…不过我们倒是可以谈谈蔷薇歌谣的内容。"
                                                },
                                                {
                                                    "id": "731930125",
                                                    "speaker": "派蒙",
                                                    "text": "嗯，记得刚才那个孩子唱到「蔷薇能实现愿望」来着…"
                                                },
                                                {
                                                    "id": "731930126",
                                                    "speaker": "赛芭",
                                                    "text": "是的，我们这样的小村子里，没有教令院那样的大图书馆，所有的歌都是口口相传的。"
                                                },
                                                {
                                                    "id": "731930127",
                                                    "speaker": "赛芭",
                                                    "text": "我一直认为，歌谣中能实现愿望的花朵，应该是先民们的集体想象。"
                                                },
                                                {
                                                    "id": "731930128",
                                                    "speaker": "赛芭",
                                                    "text": "在沙漠这种极端环境下，水是一种极其重要的生存资源，先民们非常重视能储水的植物。"
                                                },
                                                {
                                                    "id": "731930129",
                                                    "speaker": "赛芭",
                                                    "text": "所以越是地理条件苛刻的地方，越是多植物的传说，这里面蕴含着先民对美好生活的向往。"
                                                },
                                                {
                                                    "id": "731930130",
                                                    "speaker": "赛芭",
                                                    "text": "同时，它们也是先民与沙漠生物之间共生关系的例证。"
                                                },
                                                {
                                                    "id": "731930131",
                                                    "speaker": "赛芭",
                                                    "text": "不过就这个例子而言…阿如村是一个建立在沙地上的村落，这里的土壤并不适合须弥蔷薇。"
                                                },
                                                {
                                                    "id": "731930132",
                                                    "speaker": "赛芭",
                                                    "text": "我自己栽种的须弥蔷薇就始终无法生长，所以我想，歌谣中的金蔷薇可能是想象出的物种…"
                                                },
                                                {
                                                    "id": "731930133",
                                                    "speaker": "派蒙",
                                                    "text": "唔，等一下…我越来越跟不上了。"
                                                },
                                                {
                                                    "id": "731930134",
                                                    "speaker": "派蒙",
                                                    "text": "赛芭小姐，你们闲聊的时候都会讨论这种话题吗？"
                                                },
                                                {
                                                    "id": "731930135",
                                                    "speaker": "赛芭",
                                                    "text": "…啊！对不起，我以为两位是从外面来的，比起天气和收成，可能更想听这种话题。"
                                                },
                                                {
                                                    "id": "731930136",
                                                    "speaker": "派蒙",
                                                    "text": "前面的那些共生关系、集体想象什么的…我的确是不明白，不过最后那句我听懂了。"
                                                },
                                                {
                                                    "id": "731930137",
                                                    "speaker": "派蒙",
                                                    "text": "你是说这里的土地不适合种须弥蔷薇对吧？的确，我们也只在土壤更湿润的地方见过须弥蔷薇呢。",
                                                    "choices": [
                                                        {
                                                            "id": "731930138",
                                                            "text": "毕竟是沙地。",
                                                            "response": [
                                                                {
                                                                    "id": "731930140",
                                                                    "speaker": "赛芭",
                                                                    "text": "讲起蔷薇，有件事我刚才就在想了，既然两位是冒险家，说不定能接受我的委托…"
                                                                },
                                                                {
                                                                    "id": "731930141",
                                                                    "speaker": "派蒙",
                                                                    "text": "#哈哈，说这个可就有得聊了。{NICKNAME}和我是见过大风大浪的冒险家，什么委托都能解决。"
                                                                },
                                                                {
                                                                    "id": "731930142",
                                                                    "speaker": "Player",
                                                                    "text": "所以遇到了什么困难？"
                                                                },
                                                                {
                                                                    "id": "731930143",
                                                                    "speaker": "赛芭",
                                                                    "text": "我知道，非要求本不属于这里的蔷薇开出花来实在勉强，但无论如何，我还是希望看到它们开放的样子。"
                                                                },
                                                                {
                                                                    "id": "731930144",
                                                                    "speaker": "赛芭",
                                                                    "text": "说起来有点不好意思，这算是我的一点心结吧。"
                                                                },
                                                                {
                                                                    "id": "731930145",
                                                                    "speaker": "赛芭",
                                                                    "text": "按我对蔷薇的了解，如果能使用草元素含量高的肥料，就算是沙地上，它们还是能发芽的。"
                                                                },
                                                                {
                                                                    "id": "731930146",
                                                                    "speaker": "赛芭",
                                                                    "text": "不过这里很难弄到那样的肥料，所以我想拜托两位看看，能不能买到草元素含量高的肥料…"
                                                                },
                                                                {
                                                                    "id": "731930147",
                                                                    "speaker": "Player",
                                                                    "text": "草元素？"
                                                                },
                                                                {
                                                                    "id": "731930148",
                                                                    "speaker": "赛芭",
                                                                    "text": "是的，草元素对生物的生长有很大促进作用，对长势不佳的作物尤其有效。"
                                                                },
                                                                {
                                                                    "id": "731930149",
                                                                    "speaker": "赛芭",
                                                                    "text": "但我是个普通人，没有草元素神之眼，高效的肥料又买不到，真是没有办法。"
                                                                },
                                                                {
                                                                    "id": "731930150",
                                                                    "speaker": "派蒙",
                                                                    "text": "只要<color=#00E1FFFF>草元素</color>的话，那反而简单了，看我们的吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "731930139",
                                                            "text": "蔷薇真娇气。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731930121",
                                            "text": "蔷薇歌谣？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731930109",
                            "text": "不是。",
                            "response": [
                                {
                                    "id": "731930110",
                                    "speaker": "赛芭",
                                    "text": "哦？我猜错了吗…让我想想。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}