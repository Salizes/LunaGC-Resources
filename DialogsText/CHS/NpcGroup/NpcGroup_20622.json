    "talks": [
        {
            "talkId": "7902321",
            "initDialog": "790232101",
            "dialogues": [
                {
                    "id": "790232101",
                    "speaker": "叶夫卡",
                    "text": "#唉，雅科夫，雅科夫该怎么办啊…怎么了，{NICKNAME}，还有什么事吗…",
                    "choices": [
                        {
                            "id": "790232102",
                            "text": "你是怎么成为愚人众的…",
                            "response": [
                                {
                                    "id": "790232103",
                                    "speaker": "叶夫卡",
                                    "text": "怎么成为愚人众，你是说我吗…"
                                },
                                {
                                    "id": "790232104",
                                    "speaker": "叶夫卡",
                                    "text": "那当然是为了实现女皇大人的夙愿…以及为了我的家族能获得更多的荣誉，我从小就被教导要为女皇大人而战。"
                                }
                            ]
                        },
                        {
                            "id": "790232105",
                            "text": "关于雅科夫…",
                            "response": [
                                {
                                    "id": "790232106",
                                    "speaker": "叶夫卡",
                                    "text": "唉，雅科夫好像没有清醒过来的迹象…"
                                }
                            ]
                        },
                        {
                            "id": "790232107",
                            "text": "没什么事。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902332",
            "initDialog": "790233201",
            "dialogues": [
                {
                    "id": "790233201",
                    "speaker": "雷锤前锋军",
                    "text": "不行，我得把…我得把徽记找回来给他…得把徽记找回来…",
                    "choices": [
                        {
                            "id": "790233202",
                            "text": "（没法沟通…）"
                        },
                        {
                            "id": "790233203",
                            "text": "（还是先别管他了…）"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7902429",
            "initDialog": "790242901",
            "dialogues": [
                {
                    "id": "790242901",
                    "speaker": "叶夫卡",
                    "text": "嘿嘿，那个叫佩尔西科夫的研究员，对我们颐指气使，让我们做那么多苦力活…"
                },
                {
                    "id": "790242902",
                    "speaker": "叶夫卡",
                    "text": "这次实验失败，回去以后说不定就有好戏看了。"
                }
            ]
        }
    ]
}