    "talks": [
        {
            "talkId": "6954501",
            "initDialog": "695450101",
            "dialogues": [
                {
                    "id": "695450101",
                    "speaker": "丽莎",
                    "text": "这么好的天气…唔，再打几局，就回去补觉吧。"
                }
            ]
        },
        {
            "talkId": "6954502",
            "initDialog": "695450201",
            "dialogues": [
                {
                    "id": "695450201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954503",
            "initDialog": "695450301",
            "dialogues": [
                {
                    "id": "695450301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695450302",
                    "speaker": "丽莎",
                    "text": "小可爱这就要走了？嗯，光这么一想，困意就涌上来了啊…"
                }
            ]
        },
        {
            "talkId": "6954504",
            "initDialog": "695450401",
            "dialogues": [
                {
                    "id": "695450401",
                    "speaker": "丽莎",
                    "text": "小可爱，你的牌技还得再磨炼磨炼呢。要不然…让姐姐来指导你两手？"
                }
            ]
        },
        {
            "talkId": "6954505",
            "initDialog": "695450501",
            "dialogues": [
                {
                    "id": "695450501",
                    "speaker": "丽莎",
                    "text": "哎呀，还真是不留情…你不会专门针对我，设计过战术吧？"
                }
            ]
        },
        {
            "talkId": "6954506",
            "initDialog": "695450601",
            "dialogues": [
                {
                    "id": "695450601",
                    "speaker": "丽莎",
                    "text": "好呀，正好陪姐姐打发打发时间吧。"
                }
            ]
        },
        {
            "talkId": "6954508",
            "initDialog": "695450801",
            "dialogues": [
                {
                    "id": "695450801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954509",
            "initDialog": "695450901",
            "dialogues": [
                {
                    "id": "695450901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6954510",
            "initDialog": "695451001",
            "dialogues": [
                {
                    "id": "695451001",
                    "speaker": "丽莎",
                    "text": "你有些大意了？还是想讨我开心？那我们再玩一局怎么样？"
                }
            ]
        },
        {
            "talkId": "6954511",
            "initDialog": "695451101",
            "dialogues": [
                {
                    "id": "695451101",
                    "speaker": "丽莎",
                    "text": "有点出乎意料，呼~看来我真是困了…"
                }
            ]
        },
        {
            "talkId": "6954512",
            "initDialog": "695451201",
            "dialogues": [
                {
                    "id": "695451201",
                    "speaker": "丽莎",
                    "text": "小可爱连打牌也如此努力呢，那就看看你的成果吧。"
                }
            ]
        },
        {
            "talkId": "6954514",
            "initDialog": "695451401",
            "dialogues": [
                {
                    "id": "695451401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6954515",
            "initDialog": "695451501",
            "dialogues": [
                {
                    "id": "695451501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6954516",
            "initDialog": "695451601",
            "dialogues": [
                {
                    "id": "695451601",
                    "speaker": "丽莎",
                    "text": "嗯，有些进步。但是…还不足以打败姐姐我呢。"
                }
            ]
        },
        {
            "talkId": "6954517",
            "initDialog": "695451701",
            "dialogues": [
                {
                    "id": "695451701",
                    "speaker": "丽莎",
                    "text": "真不错，让我想想，要给你什么奖励呢？"
                }
            ]
        },
        {
            "talkId": "6954518",
            "initDialog": "695451801",
            "dialogues": [
                {
                    "id": "695451801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
