{
    "groupId": "1656",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "男子汉杰克": 13
    },
    "talks": [
        {
            "talkId": "6165601",
            "initDialog": "616560101",
            "dialogues": [
                {
                    "id": "616560101",
                    "speaker": "男子汉杰克",
                    "text": "啊！别过来别过来…！"
                },
                {
                    "id": "616560102",
                    "speaker": "男子汉杰克",
                    "text": "哦…什么嘛，原来是个旅行者而已，人家还以为是丘丘人呢。"
                }
            ]
        },
        {
            "talkId": "6165602",
            "initDialog": "616560201",
            "dialogues": [
                {
                    "id": "616560201",
                    "speaker": "男子汉杰克",
                    "text": "你在干嘛？"
                },
                {
                    "id": "616560202",
                    "speaker": "男子汉杰克",
                    "text": "嘿，你听说过「男子汉的试炼」吗？"
                },
                {
                    "id": "616560203",
                    "speaker": "男子汉杰克",
                    "text": "冒险家协会的那个杰克说呀，打败过一万只丘丘人的家伙，就会作为男子汉得到大家的认可呢。"
                },
                {
                    "id": "616560204",
                    "speaker": "男子汉杰克",
                    "text": "为了证明人家才是真正的男子汉，人家正在做准备呢！"
                },
                {
                    "id": "616560205",
                    "speaker": "男子汉杰克",
                    "text": "现在要去挑战了吗？"
                },
                {
                    "id": "616560206",
                    "speaker": "男子汉杰克",
                    "text": "欸，你着什么急嘛！怕不是想看人家出丑哦！"
                },
                {
                    "id": "616560207",
                    "speaker": "男子汉杰克",
                    "text": "丘丘人可是特别，特别可怕的家伙呢，不精心做好准备怎么行！"
                },
                {
                    "id": "616560208",
                    "speaker": "男子汉杰克",
                    "text": "比如，先把指甲修修齐啦，把刘海好好拨到一边啦…"
                }
            ]
        },
        {
            "talkId": "6165603",
            "initDialog": "616560301",
            "dialogues": [
                {
                    "id": "616560301",
                    "speaker": "男子汉杰克",
                    "text": "我先走了…"
                },
                {
                    "id": "616560302",
                    "speaker": "男子汉杰克",
                    "text": "嗯~拜拜哦！"
                },
                {
                    "id": "616560303",
                    "speaker": "男子汉杰克",
                    "text": "成为男子汉的路到底有多长呢…"
                }
            ]
        }
    ]
}