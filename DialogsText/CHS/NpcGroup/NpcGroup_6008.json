{
    "groupId": "6008",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "爱雅": 9
    },
    "talks": [
        {
            "talkId": "6600801",
            "initDialog": "660080101",
            "dialogues": [
                {
                    "id": "660080101",
                    "speaker": "爱雅",
                    "text": "欢迎。鉴于大部分人都描述不清自己想要什么颜色，我建议直接带着参考过来。"
                }
            ]
        },
        {
            "talkId": "6600802",
            "initDialog": "660080201",
            "dialogues": [
                {
                    "id": "660080201",
                    "speaker": "Player",
                    "text": "颜色？"
                },
                {
                    "id": "660080202",
                    "speaker": "爱雅",
                    "text": "对啊。你不会走错了吧？这里是卖颜料的商店，不是五颜六色的饮品店哦。"
                },
                {
                    "id": "660080203",
                    "speaker": "爱雅",
                    "text": "如果你拿着样品过来，我就能帮你调配出颜色一模一样的颜料来。"
                },
                {
                    "id": "660080204",
                    "speaker": "爱雅",
                    "text": "唔，好像说话尽量不要那么绝对比较好…那，我差不多能帮你调配出相似度百分之九十九的颜料来。"
                }
            ]
        },
        {
            "talkId": "6600803",
            "initDialog": "660080301",
            "dialogues": [
                {
                    "id": "660080301",
                    "speaker": "Player",
                    "text": "以后有需要的话。"
                },
                {
                    "id": "660080302",
                    "speaker": "爱雅",
                    "text": "喔，没问题。"
                }
            ]
        },
        {
            "talkId": "6600804",
            "initDialog": "660080401",
            "dialogues": [
                {
                    "id": "660080401",
                    "speaker": "Player",
                    "text": "厉害，有什么诀窍吗？"
                },
                {
                    "id": "660080402",
                    "speaker": "爱雅",
                    "text": "有啊，靠天分。"
                },
                {
                    "id": "660080403",
                    "speaker": "爱雅",
                    "text": "就像有的人哪怕去一个全新的地方也不会迷路一样，我对颜色也有着这样的天赋。"
                },
                {
                    "id": "660080404",
                    "speaker": "爱雅",
                    "text": "在我眼里没有难看的颜色，只有难看的搭配。就算是烂水果一样的颜料，也有着能大放异彩的地方。"
                },
                {
                    "id": "660080405",
                    "speaker": "爱雅",
                    "text": "说起来，你眼睛的颜色就很不错…等会儿我要配下试试看。"
                }
            ]
        }
    ]
}