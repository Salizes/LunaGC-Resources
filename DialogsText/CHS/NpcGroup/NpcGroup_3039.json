{
    "groupId": "3039",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "佐藤": 5,
        "武田": 5
    },
    "talks": [
        {
            "talkId": "6303901",
            "initDialog": "630390101",
            "dialogues": [
                {
                    "id": "630390101",
                    "speaker": "佐藤",
                    "text": "呼~真舒服…结束一段冒险的最佳去处，就是泡温泉了。冒险时受的伤，泡上一轮就全都不见啦。"
                },
                {
                    "id": "630390102",
                    "speaker": "武田",
                    "text": "真的这么有用吗？"
                },
                {
                    "id": "630390103",
                    "speaker": "佐藤",
                    "text": "你没听老板说，温泉里有治愈的魔法吗？可以让你的身体保持健康，更加强韧。"
                },
                {
                    "id": "630390104",
                    "speaker": "佐藤",
                    "text": "想必就是因为这种魔法，我每次泡完都觉得身心舒畅、焕然一新，可以再去来上一百次冒险！"
                },
                {
                    "id": "630390105",
                    "speaker": "佐藤",
                    "text": "怎么，你泡得不舒服吗？"
                },
                {
                    "id": "630390106",
                    "speaker": "武田",
                    "text": "只是用热水洗个澡而已，太夸张了吧。"
                },
                {
                    "id": "630390107",
                    "speaker": "武田",
                    "text": "说实话，感觉和我家的热水没什么区别…你说的疗效，纯粹是心理作用吧。"
                },
                {
                    "id": "630390108",
                    "speaker": "武田",
                    "text": "而且不知怎么回事，每次在这泡澡都觉得被人盯着，浑身不自在…"
                },
                {
                    "id": "630390109",
                    "speaker": "佐藤",
                    "text": "想多了吧，来泡温泉的人这么多，谁没事盯着你啊。你这才是心理作用呢。"
                },
                {
                    "id": "630390110",
                    "speaker": "武田",
                    "text": "唔…下次还是别来了…"
                }
            ]
        }
    ]
}