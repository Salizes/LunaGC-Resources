{
    "groupId": "9002",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Player": 17,
        "神里绫华": 54
    },
    "talks": [
        {
            "talkId": "6900201",
            "initDialog": "690020101",
            "dialogues": [
                {
                    "id": "690020101",
                    "speaker": "神里绫华",
                    "text": "#{NICKNAME}，你好。"
                },
                {
                    "id": "690020102",
                    "speaker": "神里绫华",
                    "text": "请，请稍等…"
                },
                {
                    "id": "690020103",
                    "speaker": "神里绫华",
                    "text": "如果知道你会在这个时候前来，我应该多花些时间做些打扮才是…"
                }
            ]
        },
        {
            "talkId": "6900202",
            "initDialog": "690020201",
            "dialogues": [
                {
                    "id": "690020201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690020202",
                    "speaker": "神里绫华",
                    "text": "呵呵，敬请放心。"
                },
                {
                    "id": "690020203",
                    "speaker": "神里绫华",
                    "text": "这里有别于神里家的布景，移步之间，处处都有新奇感。"
                },
                {
                    "id": "690020204",
                    "speaker": "神里绫华",
                    "text": "因为是你的居所，意义就更加不同。",
                    "choices": [
                        {
                            "id": "690020205",
                            "text": "不必拘束，当作自己家也可以。",
                            "response": [
                                {
                                    "id": "690020206",
                                    "speaker": "神里绫华",
                                    "text": "啊…"
                                },
                                {
                                    "id": "690020207",
                                    "speaker": "神里绫华",
                                    "text": "那样的话就太失礼了…"
                                },
                                {
                                    "id": "690020208",
                                    "speaker": "神里绫华",
                                    "text": "不过…你的好意…我拜领了。"
                                },
                                {
                                    "id": "690020212",
                                    "speaker": "Player",
                                    "text": "绫华客气了。"
                                },
                                {
                                    "id": "690020213",
                                    "speaker": "神里绫华",
                                    "text": "呵呵…谢谢你那么为我着想，但请你也不要因此勉强自己。"
                                },
                                {
                                    "id": "690020214",
                                    "speaker": "神里绫华",
                                    "text": "如果有我能相助之处，希望我也能帮上你。"
                                }
                            ]
                        },
                        {
                            "id": "690020209",
                            "text": "希望绫华能够放下包袱，随意休息。",
                            "response": [
                                {
                                    "id": "690020210",
                                    "speaker": "神里绫华",
                                    "text": "嗯…你的好意我拜领了。"
                                },
                                {
                                    "id": "690020211",
                                    "speaker": "神里绫华",
                                    "text": "「随意休息」愧不敢当，不过能在这里小憩片刻，对我来说的确是非常值得感谢的事情。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900203",
            "initDialog": "690020301",
            "dialogues": [
                {
                    "id": "690020301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690020302",
                    "speaker": "神里绫华",
                    "text": "嗯，我很乐意。不过，话题的话…",
                    "choices": [
                        {
                            "id": "690020303",
                            "text": "就聊绫华喜欢的「雅乐诗词」吧。",
                            "response": [
                                {
                                    "id": "690020304",
                                    "speaker": "神里绫华",
                                    "text": "嗯，对风雅之物的喜爱，最初是因为家教的缘故。"
                                },
                                {
                                    "id": "690020305",
                                    "speaker": "神里绫华",
                                    "text": "每当细细揣摩之时，我常常能够感受到作者的情思。"
                                },
                                {
                                    "id": "690020306",
                                    "speaker": "神里绫华",
                                    "text": "借由作者的眼睛，就能身临其境地看见世间万景。即使是熟悉的风物，也会萌生更深一层的感触。"
                                },
                                {
                                    "id": "690020311",
                                    "speaker": "Player",
                                    "text": "我也有同感。"
                                },
                                {
                                    "id": "690020312",
                                    "speaker": "神里绫华",
                                    "text": "「山茶落花，零落于昨日旧雨。」"
                                },
                                {
                                    "id": "690020313",
                                    "speaker": "神里绫华",
                                    "text": "……"
                                },
                                {
                                    "id": "690020314",
                                    "speaker": "神里绫华",
                                    "text": "仅仅读着就会感伤，这大概就是人们所说的「艺术的感染力」吧。"
                                },
                                {
                                    "id": "690020315",
                                    "speaker": "神里绫华",
                                    "text": "啊…一不留神都在聊我的事情。"
                                },
                                {
                                    "id": "690020316",
                                    "speaker": "神里绫华",
                                    "text": "明明还想趁着跟你聊天的机会，多了解你一些的…"
                                },
                                {
                                    "id": "690020317",
                                    "speaker": "神里绫华",
                                    "text": "拜托了，再占用你一点时间，和我聊聊你喜欢的东西吧。"
                                },
                                {
                                    "id": "690020318",
                                    "speaker": "神里绫华",
                                    "text": "…可以吗？"
                                }
                            ]
                        },
                        {
                            "id": "690020307",
                            "text": "就聊绫华喜欢的「风花雪月」吧。",
                            "response": [
                                {
                                    "id": "690020308",
                                    "speaker": "神里绫华",
                                    "text": "若说起自然之景，就不得不提起，稻妻的人们相信万物有灵。"
                                },
                                {
                                    "id": "690020309",
                                    "speaker": "神里绫华",
                                    "text": "风花雪月，虽然作为我们熟知的事物存在于世界之中，但也应有属于它们自己的「感情」。"
                                },
                                {
                                    "id": "690020310",
                                    "speaker": "神里绫华",
                                    "text": "我觉得，至少这是一种很浪漫的想法。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900204",
            "initDialog": "690020401",
            "dialogues": [
                {
                    "id": "690020401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690020402",
                    "speaker": "神里绫华",
                    "text": "嗯…要来交流茶艺心得吗？"
                },
                {
                    "id": "690020403",
                    "speaker": "神里绫华",
                    "text": "或者…换一种说法，要来尝尝我亲手做的抹茶吗？"
                },
                {
                    "id": "690020404",
                    "speaker": "神里绫华",
                    "text": "我曾在书中学习过，蒙德和璃月都有着独特的茶文化。"
                },
                {
                    "id": "690020405",
                    "speaker": "神里绫华",
                    "text": "但说起对茶的研习，稻妻人也有一番心得。"
                },
                {
                    "id": "690020406",
                    "speaker": "神里绫华",
                    "text": "我想让你尝一尝纯正的稻妻抹茶，随后听听你的评价！"
                },
                {
                    "id": "690020407",
                    "speaker": "神里绫华",
                    "text": "…想必也会加深我对茶道的理解吧。",
                    "choices": [
                        {
                            "id": "690020408",
                            "text": "绫华这样的身份，不应该由你来泡茶…",
                            "response": [
                                {
                                    "id": "690020409",
                                    "speaker": "神里绫华",
                                    "text": "请不要这样说。"
                                },
                                {
                                    "id": "690020410",
                                    "speaker": "神里绫华",
                                    "text": "你是远渡重天，创造诸多伟业之人。"
                                },
                                {
                                    "id": "690020411",
                                    "speaker": "神里绫华",
                                    "text": "与你的经历相比，「社奉行神里家的大小姐」才是不足挂齿的名号…"
                                },
                                {
                                    "id": "690020412",
                                    "speaker": "神里绫华",
                                    "text": "更重要的是…我也希望，你我之间可以不用拘泥这些身份…"
                                },
                                {
                                    "id": "690020413",
                                    "speaker": "神里绫华",
                                    "text": "我只是把你当作…最重要的人。"
                                },
                                {
                                    "id": "690020418",
                                    "speaker": "Player",
                                    "text": "（最重要的人…）"
                                },
                                {
                                    "id": "690020419",
                                    "speaker": "神里绫华",
                                    "text": "……"
                                },
                                {
                                    "id": "690020420",
                                    "speaker": "神里绫华",
                                    "text": "我可以…牵着你的手吗？"
                                }
                            ]
                        },
                        {
                            "id": "690020414",
                            "text": "那我来做搭配茶一起享用的甜点心吧。",
                            "response": [
                                {
                                    "id": "690020415",
                                    "speaker": "神里绫华",
                                    "text": "…真的吗？！"
                                },
                                {
                                    "id": "690020416",
                                    "speaker": "神里绫华",
                                    "text": "咳咳…不好意思，我有些太过开心了。"
                                },
                                {
                                    "id": "690020417",
                                    "speaker": "神里绫华",
                                    "text": "能和最重要的人共享茶艺的乐趣，像发生在梦里一样…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6900205",
            "initDialog": "690020501",
            "dialogues": [
                {
                    "id": "690020501",
                    "speaker": "Player",
                    "text": "早啊，绫华。"
                },
                {
                    "id": "690020502",
                    "speaker": "神里绫华",
                    "text": "#早，{NICKNAME}。"
                },
                {
                    "id": "690020503",
                    "speaker": "神里绫华",
                    "text": "今日碧空如洗，鸟声啁啾。你的旅途一定也会平安顺遂。"
                }
            ]
        },
        {
            "talkId": "6900206",
            "initDialog": "690020601",
            "dialogues": [
                {
                    "id": "690020601",
                    "speaker": "Player",
                    "text": "晚安，绫华。"
                },
                {
                    "id": "690020602",
                    "speaker": "神里绫华",
                    "text": "真是个令人心情平和的夜晚呢。"
                },
                {
                    "id": "690020603",
                    "speaker": "神里绫华",
                    "text": "…或许是因为，有你在我身边吧。"
                },
                {
                    "id": "690020604",
                    "speaker": "神里绫华",
                    "text": "#晚安，{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6900207",
            "initDialog": "690020701",
            "dialogues": [
                {
                    "id": "690020701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                }
            ]
        },
        {
            "talkId": "6900208",
            "initDialog": "690020801",
            "dialogues": [
                {
                    "id": "690020801",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                }
            ]
        },
        {
            "talkId": "6900209",
            "initDialog": "690020901",
            "dialogues": [
                {
                    "id": "690020901",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                }
            ]
        },
        {
            "talkId": "6900210",
            "initDialog": "690021001",
            "dialogues": [
                {
                    "id": "690021001",
                    "speaker": "神里绫华",
                    "text": "这些摊位布置得相当用心呢。"
                },
                {
                    "id": "690021002",
                    "speaker": "神里绫华",
                    "text": "虽说有些冷清，但只有我们两人的话，反而可以放下负担，轻松地享受另一种风味的「祭典」了。"
                },
                {
                    "id": "690021003",
                    "speaker": "神里绫华",
                    "text": "谢谢你，我真的很开心。"
                }
            ]
        },
        {
            "talkId": "6900211",
            "initDialog": "690021101",
            "dialogues": [
                {
                    "id": "690021101",
                    "speaker": "神里绫华",
                    "text": "宅邸中的道场，就像摆放在茶桌边的佩剑，时刻提醒着我，不能怠懈。"
                },
                {
                    "id": "690021102",
                    "speaker": "神里绫华",
                    "text": "神里流太刀术的要义之一，在于不断锤炼自己的「剑心」。"
                },
                {
                    "id": "690021103",
                    "speaker": "神里绫华",
                    "text": "啊，趁这个机会，要不要一起练习一番呢？"
                }
            ]
        }
    ]
}