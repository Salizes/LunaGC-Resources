{
    "groupId": "3028",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 7,
        "阿创": 12
    },
    "talks": [
        {
            "talkId": "5900001",
            "initDialog": "590000101",
            "dialogues": [
                {
                    "id": "590000101",
                    "speaker": "Player",
                    "text": "关于稻妻的矿产…"
                }
            ]
        },
        {
            "talkId": "5900002",
            "initDialog": "590000201",
            "dialogues": [
                {
                    "id": "590000201",
                    "speaker": "阿创",
                    "text": "抱歉，附近的矿点似乎都被采掘过了。现在还没有什么新的矿石情报，请过段时间再来吧。"
                }
            ]
        },
        {
            "talkId": "6302801",
            "initDialog": "630280101",
            "dialogues": [
                {
                    "id": "630280101",
                    "speaker": "阿创",
                    "text": "抱歉啊，手上事情太多，只能边干活边招呼你了。请问客人是想买武器还是委托锻造？"
                }
            ]
        },
        {
            "talkId": "6302802",
            "initDialog": "630280201",
            "dialogues": [
                {
                    "id": "630280201",
                    "speaker": "Player",
                    "text": "想挑些趁手的武器。"
                },
                {
                    "id": "630280202",
                    "speaker": "阿创",
                    "text": "都是师父认可的「天目流」手艺，请吧。"
                }
            ]
        },
        {
            "talkId": "6302803",
            "initDialog": "630280301",
            "dialogues": [
                {
                    "id": "630280301",
                    "speaker": "Player",
                    "text": "委托锻造…"
                },
                {
                    "id": "630280302",
                    "speaker": "阿创",
                    "text": "材料给我，这就开工。"
                }
            ]
        },
        {
            "talkId": "6302804",
            "initDialog": "630280401",
            "dialogues": [
                {
                    "id": "630280401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>委托锻造…</color>"
                },
                {
                    "id": "630280402",
                    "speaker": "阿创",
                    "text": "之前的委托已经完成了，请试试合不合手。顺便，还有别的委托吗？"
                }
            ]
        },
        {
            "talkId": "6302805",
            "initDialog": "630280501",
            "dialogues": [
                {
                    "id": "630280501",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "630280502",
                    "speaker": "阿创",
                    "text": "我？只是一个普通的刀匠学徒罢了，师父说什么便做什么。"
                },
                {
                    "id": "630280503",
                    "speaker": "阿创",
                    "text": "如你所见，每天都忙着修习锻造，拿着微不足道的工钱，听着师父十年如一日的训诫…"
                },
                {
                    "id": "630280504",
                    "speaker": "阿创",
                    "text": "虽说我是大徒弟，但师父不会真的指望我继承「天目流」吧？"
                },
                {
                    "id": "630280505",
                    "speaker": "阿创",
                    "text": "…唉，也不是不行，就是工钱如果能多点就好了。"
                }
            ]
        },
        {
            "talkId": "6302806",
            "initDialog": "630280601",
            "dialogues": [
                {
                    "id": "630280601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630280602",
                    "speaker": "阿创",
                    "text": "嗯，下次委托再见。"
                }
            ]
        },
        {
            "talkId": "7291601",
            "initDialog": "729160101",
            "dialogues": [
                {
                    "id": "729160101",
                    "speaker": "Player",
                    "text": "学徒的工作很辛苦呢。"
                },
                {
                    "id": "729160102",
                    "speaker": "阿创",
                    "text": "哎，可不是嘛…不过，发牢骚的时候可不能让师父听到，不然又要被他念上一整天。"
                },
                {
                    "id": "729160103",
                    "speaker": "阿创",
                    "text": "多谢客人的关心啦。看你也是在外奔波的旅者，这些矿石送给你，万一武器出了问题，没准能解燃眉之急。"
                }
            ]
        }
    ]
}