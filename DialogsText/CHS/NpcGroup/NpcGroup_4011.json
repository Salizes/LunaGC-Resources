            "dialogues": [
                {
                    "id": "640110101",
                    "speaker": "莱斯",
                    "text": "雨林气候对我真是太不友好了…"
                }
            ]
        },
        {
            "talkId": "6401102",
            "initDialog": "640110201",
            "dialogues": [
                {
                    "id": "640110201",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "640110202",
                    "speaker": "莱斯",
                    "text": "我的旧伤在潮湿的天气中经常隐隐作痛，放在须弥城，差不多就是一直在疼。"
                },
                {
                    "id": "640110203",
                    "speaker": "莱斯",
                    "text": "同时因为有伤在身，我也只能在城里做些简单的工作。"
                },
                {
                    "id": "640110204",
                    "speaker": "莱斯",
                    "text": "这下真是两难了…"
                }
            ]
        },
        {
            "talkId": "6401103",
            "initDialog": "640110301",
            "dialogues": [
                {
                    "id": "640110301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640110302",
                    "speaker": "莱斯",
                    "text": "什么时候才能退休呢…"
                }
            ]
        }
    ]
}