{
    "groupId": "9590",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "蓝砚": 10
    },
    "talks": [
        {
            "talkId": "6959001",
            "initDialog": "695900101",
            "dialogues": [
                {
                    "id": "695900101",
                    "speaker": "蓝砚",
                    "text": "这里可真热闹，这么多人都在玩牌…哎呀，我得去周围看看。"
                }
            ]
        },
        {
            "talkId": "6959002",
            "initDialog": "695900201",
            "dialogues": [
                {
                    "id": "695900201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959003",
            "initDialog": "695900301",
            "dialogues": [
                {
                    "id": "695900301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695900302",
                    "speaker": "蓝砚",
                    "text": "要走了？我也差不多该回家了，不然爷爷又该念叨我了。"
                }
            ]
        },
        {
            "talkId": "6959004",
            "initDialog": "695900401",
            "dialogues": [
                {
                    "id": "695900401",
                    "speaker": "蓝砚",
                    "text": "嘿嘿，赢下来啦。怎么样，要不要再来一把？你输了的话…就要把这串碳烤小昆虫吃掉，哎，别往后躲呀，这个可好吃啦。"
                }
            ]
        },
        {
            "talkId": "6959005",
            "initDialog": "695900501",
            "dialogues": [
                {
                    "id": "695900501",
                    "speaker": "蓝砚",
                    "text": "好啦，说好了谁输谁吃这串碳烤小昆虫的，我吃就是了。真的挺好吃的，你要尝尝么？"
                }
            ]
        },
        {
            "talkId": "6959006",
            "initDialog": "695900601",
            "dialogues": [
                {
                    "id": "695900601",
                    "speaker": "蓝砚",
                    "text": "要玩牌？好呀，平日里我也会和朋友们玩上一两把，技术不算差，你可要小心喽。"
                }
            ]
        },
        {
            "talkId": "6959008",
            "initDialog": "695900801",
            "dialogues": [
                {
                    "id": "695900801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959009",
            "initDialog": "695900901",
            "dialogues": [
                {
                    "id": "695900901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959010",
            "initDialog": "695901001",
            "dialogues": [
                {
                    "id": "695901001",
                    "speaker": "蓝砚",
                    "text": "你瞧，我的牌打得还算不错吧？"
                }
            ]
        },
        {
            "talkId": "6959011",
            "initDialog": "695901101",
            "dialogues": [
                {
                    "id": "695901101",
                    "speaker": "蓝砚",
                    "text": "哎呀，我的牌…还是打得没你好…"
                }
            ]
        },
        {
            "talkId": "6959012",
            "initDialog": "695901201",
            "dialogues": [
                {
                    "id": "695901201",
                    "speaker": "蓝砚",
                    "text": "好呀，我也正好想玩牌了…这次要用哪套牌组好呢，随手选一套吧！"
                }
            ]
        },
        {
            "talkId": "6959014",
            "initDialog": "695901401",
            "dialogues": [
                {
                    "id": "695901401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959015",
            "initDialog": "695901501",
            "dialogues": [
                {
                    "id": "695901501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959016",
            "initDialog": "695901601",
            "dialogues": [
                {
                    "id": "695901601",
                    "speaker": "蓝砚",
                    "text": "唔，牌局前起一卦，果然有用啊…好啦，我是开玩笑的。要是爷爷知道我打牌也要占卦，非得敲我脑袋不可…"
                }
            ]
        },
        {
            "talkId": "6959017",
            "initDialog": "695901701",
            "dialogues": [
                {
                    "id": "695901701",
                    "speaker": "蓝砚",
                    "text": "唉，你打牌也太厉害了，真为你开心！等我多练练，我们下次再比过吧。"
                }
            ]
        },
        {
            "talkId": "6959018",
            "initDialog": "695901801",
            "dialogues": [
                {
                    "id": "695901801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}