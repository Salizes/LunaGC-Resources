    "talks": [
        {
            "talkId": "6941201",
            "initDialog": "694120101",
            "dialogues": [
                {
                    "id": "694120101",
                    "speaker": "尼可",
                    "text": "休息？为什么要说休息。"
                },
                {
                    "id": "694120102",
                    "speaker": "尼可",
                    "text": "我在这里就和回家逛家里的健身房一样。"
                },
                {
                    "id": "694120103",
                    "speaker": "尼可",
                    "text": "当然，你们确实应该休息一下。"
                }
            ]
        },
        {
            "talkId": "6941202",
            "initDialog": "694120201",
            "dialogues": [
                {
                    "id": "694120201",
                    "speaker": "尼可",
                    "text": "这里有些挑战还是得认真对待的。"
                },
                {
                    "id": "694120202",
                    "speaker": "尼可",
                    "text": "毕竟魔女会除了我都是混沌的大魔王。就算我能轻松通关自己的考题，其他人出的题目也是需要全力以赴的。"
                },
                {
                    "id": "694120203",
                    "speaker": "尼可",
                    "text": "你也知道，魔女会的大家都是怎么样的一群人…"
                }
            ]
        },
        {
            "talkId": "6941203",
            "initDialog": "694120301",
            "dialogues": [
                {
                    "id": "694120301",
                    "speaker": "尼可",
                    "text": "小狼说的故事？"
                },
                {
                    "id": "694120302",
                    "speaker": "尼可",
                    "text": "嗯，确实是暗喻一类的东西。我相信你差不多也明白说的是什么了吧。"
                },
                {
                    "id": "694120303",
                    "speaker": "尼可",
                    "text": "欸，这个挑战完了之后和你细说。现在还是做好准备，以完全的精神面对演出比较好。"
                }
            ]
        }
    ]
}