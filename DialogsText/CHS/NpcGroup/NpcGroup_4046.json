{
    "groupId": "4046",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "费雷斯特": 11
    },
    "talks": [
        {
            "talkId": "6404601",
            "initDialog": "640460101",
            "dialogues": [
                {
                    "id": "640460101",
                    "speaker": "费雷斯特",
                    "text": "总有一天，我会继承家业，并且比父亲大人做得更好！"
                }
            ]
        },
        {
            "talkId": "6404602",
            "initDialog": "640460201",
            "dialogues": [
                {
                    "id": "640460201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640460202",
                    "speaker": "费雷斯特",
                    "text": "请叫我宝物鉴定大师·准古董收藏家·未来的杰出商人·费雷斯特。"
                },
                {
                    "id": "640460203",
                    "speaker": "费雷斯特",
                    "text": "在宝物鉴定和古董收藏方面，我唯一的目标就是父亲大人。只要能超过他，我就是最厉害的人了。"
                },
                {
                    "id": "640460204",
                    "speaker": "费雷斯特",
                    "text": "至于在做生意方面，我还有两个强敌需要打败…"
                }
            ]
        },
        {
            "talkId": "6404603",
            "initDialog": "640460301",
            "dialogues": [
                {
                    "id": "640460301",
                    "speaker": "Player",
                    "text": "加油吧。"
                },
                {
                    "id": "640460302",
                    "speaker": "费雷斯特",
                    "text": "我会的！"
                }
            ]
        },
        {
            "talkId": "6404604",
            "initDialog": "640460401",
            "dialogues": [
                {
                    "id": "640460401",
                    "speaker": "Player",
                    "text": "哪两个强敌？"
                },
                {
                    "id": "640460402",
                    "speaker": "费雷斯特",
                    "text": "一个是狡猾的苏莱卡。她巧舌如簧，哪怕是毛毯那种便宜东西都能卖出大价钱，我不服气！"
                },
                {
                    "id": "640460403",
                    "speaker": "费雷斯特",
                    "text": "还有一个，就是父亲大人常常提到的「桑歌玛哈巴依老爷」了。"
                },
                {
                    "id": "640460404",
                    "speaker": "费雷斯特",
                    "text": "虽然我还不知道这个人是谁，但听父亲大人的口吻，似乎是个更厉害的家伙！"
                },
                {
                    "id": "640460405",
                    "speaker": "费雷斯特",
                    "text": "没关系，强大的敌人更值得挑战，等着吧！"
                }
            ]
        },
        {
            "talkId": "6404605",
            "initDialog": "640460501",
            "dialogues": [
                {
                    "id": "640460501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6404606",
            "initDialog": "640460601",
            "dialogues": [
                {
                    "id": "640460601",
                    "speaker": "费雷斯特",
                    "text": "呜…虽然被破解了，但是没关系，我以后肯定能想出更难的！"
                }
            ]
        },
        {
            "talkId": "6404607",
            "initDialog": "640460701",
            "dialogues": [
                {
                    "id": "640460701",
                    "speaker": "费雷斯特",
                    "text": "怎么样，这就是宝物鉴定大师的牌局，可没有那么简单！"
                }
            ]
        }
    ]
}