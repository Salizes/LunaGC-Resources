{
    "groupId": "5002",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "布吕诺": 10
    },
    "talks": [
        {
            "talkId": "6500201",
            "initDialog": "650020101",
            "dialogues": [
                {
                    "id": "650020101",
                    "speaker": "布吕诺",
                    "text": "您好，请问有什么事？"
                }
            ]
        },
        {
            "talkId": "6500202",
            "initDialog": "650020201",
            "dialogues": [
                {
                    "id": "650020201",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "650020202",
                    "speaker": "布吕诺",
                    "text": "这里是沫芒宫，处理所有公务的议事处，也是为大家提供社会服务的地方。"
                },
                {
                    "id": "650020203",
                    "speaker": "布吕诺",
                    "text": "——当然，也是水神芙宁娜大人的住处所在。"
                },
                {
                    "id": "650020204",
                    "speaker": "布吕诺",
                    "text": "但如果想面见芙宁娜大人，必须提前预约，还请您遵守规定，不要擅闯，否则后果自负。"
                }
            ]
        },
        {
            "talkId": "6500203",
            "initDialog": "650020301",
            "dialogues": [
                {
                    "id": "650020301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "650020302",
                    "speaker": "布吕诺",
                    "text": "没关系，再见。"
                }
            ]
        },
        {
            "talkId": "6500204",
            "initDialog": "650020401",
            "dialogues": [
                {
                    "id": "650020401",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "650020402",
                    "speaker": "布吕诺",
                    "text": "这里是沫芒宫，处理所有公务的议事处，也是为大家提供社会服务的地方。"
                },
                {
                    "id": "650020403",
                    "speaker": "布吕诺",
                    "text": "——当然，也是最高审判官那维莱特大人的办公室所在地。"
                },
                {
                    "id": "650020404",
                    "speaker": "布吕诺",
                    "text": "如果您对枫丹的各类公共事务有所疑问，都可以来此地咨询。但还请您遵守规定，不要擅闯，否则后果自负。"
                }
            ]
        },
        {
            "talkId": "7491401",
            "initDialog": "749140101",
            "dialogues": [
                {
                    "id": "749140101",
                    "speaker": "Player",
                    "text": "可以参观公共区域吗？"
                },
                {
                    "id": "749140102",
                    "speaker": "布吕诺",
                    "text": "嗯…理论上来说，这里是办公场所，不过每天来办事的非办公人员也有很多。"
                },
                {
                    "id": "749140103",
                    "speaker": "布吕诺",
                    "text": "我们并不会驱赶遵守秩序的来客，所以只要您在参观时轻声细语，不要打扰他人工作，就没有问题。"
                }
            ]
        }
    ]
}