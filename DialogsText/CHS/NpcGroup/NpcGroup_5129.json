{
    "groupId": "5129",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "卡瓦": 19
    },
    "talks": [
        {
            "talkId": "5900142",
            "initDialog": "590014201",
            "dialogues": [
                {
                    "id": "590014201",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900143",
            "initDialog": "590014301",
            "dialogues": [
                {
                    "id": "590014301",
                    "speaker": "卡瓦",
                    "text": "嗯…你指哪方面？我没看到什么奇怪的东西…"
                }
            ]
        },
        {
            "talkId": "6512901",
            "initDialog": "651290101",
            "dialogues": [
                {
                    "id": "651290101",
                    "speaker": "卡瓦",
                    "text": "等会儿做些什么好呢？要不要从镇头一口气跑到大船上，比比我们谁跑得快？"
                }
            ]
        },
        {
            "talkId": "6512902",
            "initDialog": "651290201",
            "dialogues": [
                {
                    "id": "651290201",
                    "speaker": "Player",
                    "text": "暂时没有空…"
                },
                {
                    "id": "651290202",
                    "speaker": "卡瓦",
                    "text": "噢，我知道了，你是那些「有事情干的人」之一，就像老爸老妈一样。"
                },
                {
                    "id": "651290203",
                    "speaker": "卡瓦",
                    "text": "爷爷说，遇到「有事情干的人」，不能一直缠着人家，所以不麻烦你了，我自己去玩吧。"
                },
                {
                    "id": "651290204",
                    "speaker": "卡瓦",
                    "text": "我很厉害的！靠自己也可以玩得很开心！"
                },
                {
                    "id": "651290205",
                    "speaker": "卡瓦",
                    "text": "…嗯，应该说是「第二开心」吧，想要「第一开心」，还是得等娜维娅姐姐来的时候。"
                }
            ]
        },
        {
            "talkId": "6512903",
            "initDialog": "651290301",
            "dialogues": [
                {
                    "id": "651290301",
                    "speaker": "Player",
                    "text": "你加油。"
                },
                {
                    "id": "651290302",
                    "speaker": "卡瓦",
                    "text": "嗯？不想和我比赛吗？好吧。"
                }
            ]
        },
        {
            "talkId": "6512904",
            "initDialog": "651290401",
            "dialogues": [
                {
                    "id": "651290401",
                    "speaker": "Player",
                    "text": "关于娜维娅姐姐…"
                },
                {
                    "id": "651290402",
                    "speaker": "卡瓦",
                    "text": "就是大人们嘴里说的老板啦。"
                },
                {
                    "id": "651290403",
                    "speaker": "卡瓦",
                    "text": "「老板」听上去太严肃了，像那些会敲桌子吼人的大叔，我觉得一点都不适合娜维娅姐姐。"
                },
                {
                    "id": "651290404",
                    "speaker": "卡瓦",
                    "text": "娜维娅姐姐在时镇上可热闹了，总是板着脸的大人们也都欢声笑语的。"
                },
                {
                    "id": "651290405",
                    "speaker": "卡瓦",
                    "text": "有时她还会带奇妙的发条玩具回来让伊薇特奶奶鉴赏。"
                },
                {
                    "id": "651290406",
                    "speaker": "卡瓦",
                    "text": "伊薇特奶奶看了后一副欲言又止的样子，可好玩了。"
                }
            ]
        },
        {
            "talkId": "6512905",
            "initDialog": "651290501",
            "dialogues": [
                {
                    "id": "651290501",
                    "speaker": "Player",
                    "text": "关于之前的水灾…"
                },
                {
                    "id": "651290502",
                    "speaker": "卡瓦",
                    "text": "那个啊，水涨上来的时候可吓人了！不过还没等我反应过来，艾琪诺姐姐就冲过来一下把我抱走了。"
                },
                {
                    "id": "651290503",
                    "speaker": "卡瓦",
                    "text": "事后我按照爷爷说的，跟她道了三次谢呢！"
                },
                {
                    "id": "651290504",
                    "speaker": "卡瓦",
                    "text": "我想，大概只有身体足够强壮，才能变成艾琪诺姐姐那样的英雄吧？"
                },
                {
                    "id": "651290505",
                    "speaker": "卡瓦",
                    "text": "我要抓紧时间锻炼，多跑多跳多游泳！"
                }
            ]
        },
        {
            "talkId": "7491001",
            "initDialog": "749100101",
            "dialogues": [
                {
                    "id": "749100101",
                    "speaker": "Player",
                    "text": "需要我转告她吗？"
                },
                {
                    "id": "749100102",
                    "speaker": "卡瓦",
                    "text": "你认识娜维娅姐姐？真厉害！"
                },
                {
                    "id": "749100103",
                    "speaker": "卡瓦",
                    "text": "嗯，我想想…还是先不用了，娜维娅姐姐现在也是「有事情干的人」，打扰她的话爷爷又要和我讲大道理了。"
                },
                {
                    "id": "749100104",
                    "speaker": "卡瓦",
                    "text": "不过，既然你是娜维娅姐姐的朋友，那也就是我卡瓦的朋友了。这个送你，不许不收！"
                }
            ]
        }
    ]
}