        "豁牙子": 7
    },
    "talks": [
        {
            "talkId": "6210601",
            "initDialog": "621060101",
            "dialogues": [
                {
                    "id": "621060101",
                    "speaker": "豁牙子",
                    "text": "这附近是黑岩厂的警戒范围，注意举止。"
                }
            ]
        },
        {
            "talkId": "6210602",
            "initDialog": "621060201",
            "dialogues": [
                {
                    "id": "621060201",
                    "speaker": "Player",
                    "text": "关于黑岩厂。"
                },
                {
                    "id": "621060202",
                    "speaker": "豁牙子",
                    "text": "对黑岩厂感兴趣？我还真是挺了解的。"
                },
                {
                    "id": "621060203",
                    "speaker": "豁牙子",
                    "text": "毕竟之前我也在这黑岩厂里做工，可后来身体受不了里面的劳动强度，靠着一点运气成功入伍千岩军了。"
                },
                {
                    "id": "621060204",
                    "speaker": "豁牙子",
                    "text": "总得来说，黑岩厂里其实就是一群一边挖洞一边炼矿的矿工们。"
                },
                {
                    "id": "621060205",
                    "speaker": "豁牙子",
                    "text": "当然为了安全着想，还会做一系列隧道加固和厂房建设的工作。"
                },
                {
                    "id": "621060206",
                    "speaker": "豁牙子",
                    "text": "岩王爷赐给璃月的财富都在这一座座矿山里，直接将工厂建在山体之中想必的确是最有效率的开采方式吧。"
                }
            ]
        },
        {
            "talkId": "6210603",
            "initDialog": "621060301",
            "dialogues": [
                {
                    "id": "621060301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621060302",
                    "speaker": "豁牙子",
                    "text": "千岩牢固，重嶂不移。"
                }
            ]
        }
    ]
}