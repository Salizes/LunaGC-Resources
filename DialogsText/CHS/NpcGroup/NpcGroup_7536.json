{
    "groupId": "7536",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "维洛拉": 9
    },
    "talks": [
        {
            "talkId": "6753601",
            "initDialog": "675360101",
            "dialogues": [
                {
                    "id": "675360101",
                    "speaker": "维洛拉",
                    "text": "区…区区体能考核而已，无论重来多少次我都绝不会放弃的！"
                }
            ]
        },
        {
            "talkId": "6753602",
            "initDialog": "675360201",
            "dialogues": [
                {
                    "id": "675360201",
                    "speaker": "Player",
                    "text": "体能考核？"
                },
                {
                    "id": "675360202",
                    "speaker": "维洛拉",
                    "text": "是呀！只有通过体能考核，才能加入冬契军…"
                },
                {
                    "id": "675360203",
                    "speaker": "维洛拉",
                    "text": "唉，您是不知道现在的考官有多严格！甚至要考核跑步…淑女怎么会学过跑步呢！"
                },
                {
                    "id": "675360204",
                    "speaker": "维洛拉",
                    "text": "妈妈说，要是放在以前，血脉纯正的风仙贵族想要加入冬契军，只要一封推荐信就够了…现在的考核简直是不讲理嘛！"
                }
            ]
        },
        {
            "talkId": "6753603",
            "initDialog": "675360301",
            "dialogues": [
                {
                    "id": "675360301",
                    "speaker": "Player",
                    "text": "祝你好运。"
                },
                {
                    "id": "675360302",
                    "speaker": "维洛拉",
                    "text": "谢谢！这一次，我一定会成功的…大概会！"
                }
            ]
        },
        {
            "talkId": "6753604",
            "initDialog": "675360401",
            "dialogues": [
                {
                    "id": "675360401",
                    "speaker": "Player",
                    "text": "为什么一定要加入冬契军？"
                },
                {
                    "id": "675360402",
                    "speaker": "维洛拉",
                    "text": "那当然是因为薇——咳，不是，那当然是为了护卫陛下的荣耀！"
                },
                {
                    "id": "675360403",
                    "speaker": "维洛拉",
                    "text": "您看，冬契军可是我国的仪仗与门面！您难道没有见过薇斯纳大人巡查时优雅的身姿吗？"
                },
                {
                    "id": "675360404",
                    "speaker": "维洛拉",
                    "text": "那修身的制服，精致的绶带，还有帅气的佩剑…呜啊…"
                },
                {
                    "id": "675360405",
                    "speaker": "维洛拉",
                    "text": "所以，哪怕是为了…不对，没有哪怕！为了陛下的荣耀，我一定要通过考核！"
                }
            ]
        }
    ]
}