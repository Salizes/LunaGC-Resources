            "dialogues": [
                {
                    "id": "662480101",
                    "speaker": "丁戈内克",
                    "text": "（在此地休息的龙，看起来若有所思。）"
                }
            ]
        },
        {
            "talkId": "6624802",
            "initDialog": "662480201",
            "dialogues": [
                {
                    "id": "662480201",
                    "speaker": "丁戈内克",
                    "text": "那两个人又在争吵了。"
                },
                {
                    "id": "662480202",
                    "speaker": "丁戈内克",
                    "text": "又或许不是在争吵？那个年纪大的人看起来心情不错，但年轻点的那位看起来一直很丧气。"
                },
                {
                    "id": "662480203",
                    "speaker": "丁戈内克",
                    "text": "真是，从没见过这么没有激情的对话，也难怪一直讨论不出结果来。"
                },
                {
                    "id": "662480204",
                    "speaker": "丁戈内克",
                    "text": "一旦没了激情，就算是最强壮的龙也飞不高的！"
                }
            ]
        }
    ]
}