{
    "groupId": "1473",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 4,
        "吉丽安娜": 16
    },
    "talks": [
        {
            "talkId": "6147301",
            "initDialog": "614730101",
            "dialogues": [
                {
                    "id": "614730101",
                    "speaker": "吉丽安娜",
                    "text": "啊，您好。"
                },
                {
                    "id": "614730102",
                    "speaker": "吉丽安娜",
                    "text": "愿巴巴托斯的和风与您同在。"
                }
            ]
        },
        {
            "talkId": "6147302",
            "initDialog": "614730201",
            "dialogues": [
                {
                    "id": "614730201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "614730202",
                    "speaker": "吉丽安娜",
                    "text": "你也是来祈祷的吗？"
                },
                {
                    "id": "614730203",
                    "speaker": "吉丽安娜",
                    "text": "如果坚持向巴巴托斯诚心诚意地祈祷，那么巴巴托斯也一定会回应我们的期待。"
                }
            ]
        },
        {
            "talkId": "6147303",
            "initDialog": "614730301",
            "dialogues": [
                {
                    "id": "614730301",
                    "speaker": "Player",
                    "text": "莉莉是你的女儿吗？"
                },
                {
                    "id": "614730302",
                    "speaker": "吉丽安娜",
                    "text": "是我祈祷的时候不留神说了什么吗？"
                },
                {
                    "id": "614730303",
                    "speaker": "吉丽安娜",
                    "text": "…看来祈祷还是要专心才行呢。"
                },
                {
                    "id": "614730304",
                    "speaker": "吉丽安娜",
                    "text": "莉莉是我的女儿，是巴巴托斯赐予我的希望。"
                },
                {
                    "id": "614730305",
                    "speaker": "吉丽安娜",
                    "text": "…唔，其实只是莉莉早上缠着我要礼物的原因吧。"
                },
                {
                    "id": "614730306",
                    "speaker": "Player",
                    "text": "你很爱护你的女儿呢。"
                },
                {
                    "id": "614730307",
                    "speaker": "吉丽安娜",
                    "text": "嗯，是啊。"
                },
                {
                    "id": "614730308",
                    "speaker": "吉丽安娜",
                    "text": "…我以前经历过很多…错误的事情。"
                },
                {
                    "id": "614730309",
                    "speaker": "吉丽安娜",
                    "text": "幸好最后走了出来，有了家庭，最重要的是…有了莉莉。"
                },
                {
                    "id": "614730310",
                    "speaker": "吉丽安娜",
                    "text": "只要你不停下脚步，总有一天神会听到你，认可你的意志。"
                },
                {
                    "id": "614730311",
                    "speaker": "吉丽安娜",
                    "text": "有些人在展现了愿望之后，得到了梦寐以求的「神之眼」…"
                },
                {
                    "id": "614730312",
                    "speaker": "吉丽安娜",
                    "text": "…而莉莉对我来说，也是像「神之眼」一样的心愿的结晶吧，或许还要更加宝贵。"
                }
            ]
        },
        {
            "talkId": "6147304",
            "initDialog": "614730401",
            "dialogues": [
                {
                    "id": "614730401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614730402",
                    "speaker": "吉丽安娜",
                    "text": "嗯，再见。"
                },
                {
                    "id": "614730403",
                    "speaker": "吉丽安娜",
                    "text": "不论如何，祝愿你和你的家人都过得幸福。"
                }
            ]
        }
    ]
}