{
    "groupId": "2203",
    "total_dialogue_lines": 48,
    "speaker_counts": {
        "Player": 9,
        "兰达": 39
    },
    "talks": [
        {
            "talkId": "4111538",
            "initDialog": "411153801",
            "dialogues": [
                {
                    "id": "411153801",
                    "speaker": "兰达",
                    "text": "看来璃月这边也和蒙德一样，出现奇怪的陨石了呢…"
                },
                {
                    "id": "411153802",
                    "speaker": "兰达",
                    "text": "有什么事吗？我不过是个从蒙德来的商人，做酒业生意的。"
                }
            ]
        },
        {
            "talkId": "6220304",
            "initDialog": "622030401",
            "dialogues": [
                {
                    "id": "622030401",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6220305",
            "initDialog": "622030501",
            "dialogues": [
                {
                    "id": "622030501",
                    "speaker": "兰达",
                    "text": "谢谢了！你的牌艺启发了我，让我明白了接下来该怎么去和棘手的家伙博弈…"
                }
            ]
        },
        {
            "talkId": "6220306",
            "initDialog": "622030601",
            "dialogues": [
                {
                    "id": "622030601",
                    "speaker": "兰达",
                    "text": "失算了失算了，下次我不会如此失态！"
                }
            ]
        },
        {
            "talkId": "2102401",
            "initDialog": "210240101",
            "dialogues": [
                {
                    "id": "210240101",
                    "speaker": "兰达",
                    "text": "这下可糟糕了…"
                },
                {
                    "id": "210240102",
                    "speaker": "Player",
                    "text": "发生什么了？"
                },
                {
                    "id": "210240103",
                    "speaker": "兰达",
                    "text": "啊？是旅行者啊…是这样，我是个商人，一直在蒙德城和璃月港之间跑生意。"
                },
                {
                    "id": "210240104",
                    "speaker": "兰达",
                    "text": "我刚在蒙德城做了笔大生意，正准备把货单带回去给老板…"
                },
                {
                    "id": "210240105",
                    "speaker": "兰达",
                    "text": "但是没想到，刚走到这附近，就被一群怪物袭击了。"
                },
                {
                    "id": "210240106",
                    "speaker": "兰达",
                    "text": "我又打不过这群怪物，只能掉头就跑，跌跌撞撞一直跑到了这客栈里面。"
                },
                {
                    "id": "210240107",
                    "speaker": "兰达",
                    "text": "但是我人跑掉了，货单却全部弄丢了…您能帮我找回来吗？",
                    "choices": [
                        {
                            "id": "210240108",
                            "text": "我知道了。",
                            "response": [
                                {
                                    "id": "210240109",
                                    "speaker": "兰达",
                                    "text": "太好了，我大概能记得我跑过的地方，这就给您标上…"
                                },
                                {
                                    "id": "210240110",
                                    "speaker": "兰达",
                                    "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
                                }
                            ]
                        },
                        {
                            "id": "210240111",
                            "text": "什么货单？",
                            "response": [
                                {
                                    "id": "210240112",
                                    "speaker": "兰达",
                                    "text": "当然是酒啊，从蒙德还能跑什么生意。"
                                },
                                {
                                    "id": "210240113",
                                    "speaker": "兰达",
                                    "text": "这可是笔大生意，要是出了问题，老板准要怪罪我。"
                                },
                                {
                                    "id": "210240114",
                                    "speaker": "兰达",
                                    "text": "您就帮帮我吧。我把记得的大概位置都给标好了。"
                                },
                                {
                                    "id": "210240115",
                                    "speaker": "兰达",
                                    "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
                                }
                            ]
                        },
                        {
                            "id": "210240116",
                            "text": "你老板是谁？",
                            "response": [
                                {
                                    "id": "210240117",
                                    "speaker": "兰达",
                                    "text": "我老板？啊…那个，是璃月港里一个很有钱的商人，很有钱。"
                                },
                                {
                                    "id": "210240118",
                                    "speaker": "兰达",
                                    "text": "哎呀，你就别多问了，我就是个跑腿的，老板的事我也不清楚。"
                                },
                                {
                                    "id": "210240119",
                                    "speaker": "兰达",
                                    "text": "但我要是把这笔生意给弄黄了，估计连跑腿的工作都没了。"
                                },
                                {
                                    "id": "210240120",
                                    "speaker": "兰达",
                                    "text": "您就帮帮我吧。我把记得的大概位置都给标好了。"
                                },
                                {
                                    "id": "210240121",
                                    "speaker": "兰达",
                                    "text": "那些货单我都放在盒子里了，应该也不难找，就拜托您了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220301",
            "initDialog": "622030101",
            "dialogues": [
                {
                    "id": "622030101",
                    "speaker": "兰达",
                    "text": "找我有什么事情吗？如你所见，我就是个蒙德来的商人，做酒业生意的。"
                },
                {
                    "id": "622030102",
                    "speaker": "兰达",
                    "text": "…干、干什么用这种眼神看着我？我说的可是实话…"
                }
            ]
        },
        {
            "talkId": "6220302",
            "initDialog": "622030201",
            "dialogues": [
                {
                    "id": "622030201",
                    "speaker": "Player",
                    "text": "请问你是？"
                },
                {
                    "id": "622030202",
                    "speaker": "兰达",
                    "text": "我叫兰达，做酒业生意的。那边跑来跑去的是我的女儿，蒂雅。"
                },
                {
                    "id": "622030203",
                    "speaker": "兰达",
                    "text": "你知道，蒙德的酒要流通到璃月才能卖给全大陆。"
                },
                {
                    "id": "622030204",
                    "speaker": "兰达",
                    "text": "明曦酒庄你知道吗？就是从那里来的。"
                },
                {
                    "id": "622030205",
                    "speaker": "兰达",
                    "text": "啊，对对，晨曦晨曦。",
                    "choices": [
                        {
                            "id": "622030206",
                            "text": "有些可疑啊…",
                            "response": [
                                {
                                    "id": "622030207",
                                    "speaker": "兰达",
                                    "text": "欸，离开蒙德太久了会这样的。"
                                },
                                {
                                    "id": "622030208",
                                    "speaker": "兰达",
                                    "text": "我可是这里老熟人了，这条商道跑了好多年了。"
                                },
                                {
                                    "id": "622030209",
                                    "speaker": "兰达",
                                    "text": "掌柜和老板娘，他们都可以给我担保的。"
                                },
                                {
                                    "id": "622030210",
                                    "speaker": "兰达",
                                    "text": "是不是啊，淮安、戈黛特，啊哈哈哈。"
                                },
                                {
                                    "id": "622030211",
                                    "speaker": "兰达",
                                    "text": "你们别不说话啊…"
                                }
                            ]
                        },
                        {
                            "id": "622030212",
                            "text": "越看越可疑…",
                            "response": [
                                {
                                    "id": "622030213",
                                    "speaker": "兰达",
                                    "text": "怎、怎么能这么说。"
                                },
                                {
                                    "id": "622030214",
                                    "speaker": "兰达",
                                    "text": "那，我来告诉你一个只有在酒行才知道的秘密吧。"
                                },
                                {
                                    "id": "622030215",
                                    "speaker": "兰达",
                                    "text": "「天使的馈赠」其实说的是「天使的一份」。"
                                },
                                {
                                    "id": "622030216",
                                    "speaker": "兰达",
                                    "text": "也就是酿酒时，被空气带走的一部分。"
                                },
                                {
                                    "id": "622030217",
                                    "speaker": "兰达",
                                    "text": "怎么样，学习到了吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220303",
            "initDialog": "622030301",
            "dialogues": [
                {
                    "id": "622030301",
                    "speaker": "Player",
                    "text": "先算了，再见。"
                },
                {
                    "id": "622030302",
                    "speaker": "兰达",
                    "text": "什、什么叫先算了。我是清白的啊。"
                },
                {
                    "id": "622030303",
                    "speaker": "兰达",
                    "text": "下次看到我在蒙德进货你们就相信我了！"
                }
            ]
        }
    ]
}