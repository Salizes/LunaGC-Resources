{
    "groupId": "5236",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "格兰维尔": 7
    },
    "talks": [
        {
            "talkId": "6523601",
            "initDialog": "652360101",
            "dialogues": [
                {
                    "id": "652360101",
                    "speaker": "格兰维尔",
                    "text": "在生产区需要遵守劳动纪律，安全第一。有什么问题吗？"
                }
            ]
        },
        {
            "talkId": "6523602",
            "initDialog": "652360201",
            "dialogues": [
                {
                    "id": "652360201",
                    "speaker": "Player",
                    "text": "关于劳动纪律…"
                },
                {
                    "id": "652360202",
                    "speaker": "格兰维尔",
                    "text": "首先是禁止携带与生产无关的杂物进入生产区，包括七圣召唤卡牌和小说等。还有捕兽夹，到底是谁会想到在这里设置捕兽夹…"
                },
                {
                    "id": "652360203",
                    "speaker": "格兰维尔",
                    "text": "其次是按时完成生产任务，并且保证生产质量，必要时接受技术指导。这点没什么可说的吧。"
                },
                {
                    "id": "652360204",
                    "speaker": "格兰维尔",
                    "text": "最后是爱护设施，禁止偷拿生产材料，禁止对发条机关进行改装。你也不想去禁闭室看着墙壁发呆吧？"
                }
            ]
        },
        {
            "talkId": "6523603",
            "initDialog": "652360301",
            "dialogues": [
                {
                    "id": "652360301",
                    "speaker": "Player",
                    "text": "关于扩音机…"
                },
                {
                    "id": "652360302",
                    "speaker": "格兰维尔",
                    "text": "为了让大家打起精神来，这是有必要的。什么声音太大，根本不是问题。"
                },
                {
                    "id": "652360303",
                    "speaker": "格兰维尔",
                    "text": "唯一的问题应该是频繁出故障…以前用力拍个一两次就能好，最近这招好像也不太管用了。看来得找人大修一下…"
                }
            ]
        },
        {
            "talkId": "6523604",
            "initDialog": "652360401",
            "dialogues": [
                {
                    "id": "652360401",
                    "speaker": "Player",
                    "text": "没问题。"
                },
                {
                    "id": "652360402",
                    "speaker": "格兰维尔",
                    "text": "没问题就好。"
                }
            ]
        }
    ]
}