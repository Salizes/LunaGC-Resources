    "talks": [
        {
            "talkId": "6432901",
            "initDialog": "643290101",
            "dialogues": [
                {
                    "id": "643290101",
                    "speaker": "巴兰",
                    "text": "在这里卖东西啊，就图个悠闲自在。"
                }
            ]
        },
        {
            "talkId": "6432902",
            "initDialog": "643290201",
            "dialogues": [
                {
                    "id": "643290201",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "643290202",
                    "speaker": "巴兰",
                    "text": "还可以，足够我养活自己了。"
                },
                {
                    "id": "643290203",
                    "speaker": "巴兰",
                    "text": "这里可是须弥水路的关键地带，每年来往的商队可不少。"
                },
                {
                    "id": "643290204",
                    "speaker": "巴兰",
                    "text": "不过呢，顺着水路就能到奥摩斯港，所以在这儿驻扎的商人也没几个。"
                },
                {
                    "id": "643290205",
                    "speaker": "巴兰",
                    "text": "但人少有人少的好处，竞争没那么激烈嘛。"
                }
            ]
        },
        {
            "talkId": "6432903",
            "initDialog": "643290301",
            "dialogues": [
                {
                    "id": "643290301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643290302",
                    "speaker": "巴兰",
                    "text": "您慢走。"
                }
            ]
        }
    ]
}