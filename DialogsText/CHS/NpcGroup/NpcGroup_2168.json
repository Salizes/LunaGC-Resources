{
    "groupId": "2168",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "尤骏": 8
    },
    "talks": [
        {
            "talkId": "6216801",
            "initDialog": "621680101",
            "dialogues": [
                {
                    "id": "621680101",
                    "speaker": "尤骏",
                    "text": "#{M#嘘…！嘘！咳咳…他来了！他来了！「金发的旅行者」！}{F#嘘…！嘘！咳咳…她来了！她来了！「金发的旅行者」！}嗯，应该和塔列辛老师的歌唱没有区别。"
                }
            ]
        },
        {
            "talkId": "6216802",
            "initDialog": "621680201",
            "dialogues": [
                {
                    "id": "621680201",
                    "speaker": "Player",
                    "text": "你怎么说话像是吟游诗人？"
                },
                {
                    "id": "621680202",
                    "speaker": "尤骏",
                    "text": "不是像，很快，我就会成为真正的吟游诗人了。"
                },
                {
                    "id": "621680203",
                    "speaker": "尤骏",
                    "text": "多亏了你，这里已经不需要那么多千岩军。"
                },
                {
                    "id": "621680204",
                    "speaker": "尤骏",
                    "text": "本来我应该调任回璃月港，但是我找到了我应该做的事。"
                },
                {
                    "id": "621680205",
                    "speaker": "尤骏",
                    "text": "那就是，跟着塔列辛老师一起，让诗歌随着风吹遍璃月。"
                }
            ]
        },
        {
            "talkId": "6216803",
            "initDialog": "621680301",
            "dialogues": [
                {
                    "id": "621680301",
                    "speaker": "Player",
                    "text": "塔列辛老师…？"
                },
                {
                    "id": "621680302",
                    "speaker": "尤骏",
                    "text": "是的，他的「老派史诗」感动了我，所以我成为了他在璃月的第一位弟子。我想，我也应当为岩王帝君创造一首史诗。"
                }
            ]
        },
        {
            "talkId": "6216804",
            "initDialog": "621680401",
            "dialogues": [
                {
                    "id": "621680401",
                    "speaker": "Player",
                    "text": "再见…黑发的尤骏。"
                },
                {
                    "id": "621680402",
                    "speaker": "尤骏",
                    "text": "再会了，「金发的旅行者」！"
                }
            ]
        },
        {
            "talkId": "6216805",
            "initDialog": "621680501",
            "dialogues": [
                {
                    "id": "621680501",
                    "speaker": "Player",
                    "text": "有点不太搭。"
                },
                {
                    "id": "621680502",
                    "speaker": "尤骏",
                    "text": "嗯，我也觉得…不过我会和塔列辛老师一起努力的！"
                }
            ]
        }
    ]
}