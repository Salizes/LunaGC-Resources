{
    "groupId": "1765",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "埃斯特拉冈": 7
    },
    "talks": [
        {
            "talkId": "6176501",
            "initDialog": "617650101",
            "dialogues": [
                {
                    "id": "617650101",
                    "speaker": "埃斯特拉冈",
                    "text": "他究竟什么时候才能来啊…"
                }
            ]
        },
        {
            "talkId": "6176502",
            "initDialog": "617650201",
            "dialogues": [
                {
                    "id": "617650201",
                    "speaker": "Player",
                    "text": "你在等人吗？"
                },
                {
                    "id": "617650202",
                    "speaker": "埃斯特拉冈",
                    "text": "是的。狄米特列夫，我在等他来拿货。"
                },
                {
                    "id": "617650203",
                    "speaker": "埃斯特拉冈",
                    "text": "我仿佛已经在这里等待了一辈子了，可是我又不敢离开此处去找他。"
                },
                {
                    "id": "617650204",
                    "speaker": "埃斯特拉冈",
                    "text": "说不定他只是在路上遇到了什么问题，再耐心些吧。他应该马上就到了。"
                }
            ]
        },
        {
            "talkId": "6176503",
            "initDialog": "617650301",
            "dialogues": [
                {
                    "id": "617650301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617650302",
                    "speaker": "埃斯特拉冈",
                    "text": "再见。我再在这里等一会儿。"
                }
            ]
        },
        {
            "talkId": "6176504",
            "initDialog": "617650401",
            "dialogues": [
                {
                    "id": "617650401",
                    "speaker": "Player",
                    "text": "所以…你们是定在这里见面了吗？"
                },
                {
                    "id": "617650402",
                    "speaker": "埃斯特拉冈",
                    "text": "我们当然要在这见面，一如往常。"
                },
                {
                    "id": "617650403",
                    "speaker": "埃斯特拉冈",
                    "text": "他告诉过我，他会来，让我在这里等他。我答应他，要在这里等他。所以我会等到他来，一如往常。"
                }
            ]
        }
    ]
}