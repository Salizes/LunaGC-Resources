{
    "groupId": "4120",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "伊娜姆": 14
    },
    "talks": [
        {
            "talkId": "6412001",
            "initDialog": "641200101",
            "dialogues": [
                {
                    "id": "641200101",
                    "speaker": "伊娜姆",
                    "text": "看守的工作可真无聊…现在还不能换班了…"
                },
                {
                    "id": "641200102",
                    "speaker": "伊娜姆",
                    "text": "你好，想聊天吗？"
                }
            ]
        },
        {
            "talkId": "6412002",
            "initDialog": "641200201",
            "dialogues": [
                {
                    "id": "641200201",
                    "speaker": "Player",
                    "text": "聊什么？"
                },
                {
                    "id": "641200202",
                    "speaker": "伊娜姆",
                    "text": "你说，人的运气是不是天生的啊？"
                },
                {
                    "id": "641200203",
                    "speaker": "伊娜姆",
                    "text": "小妹迪希雅比我加入镀金旅团要晚，但接到的单子可比我的强多了。"
                },
                {
                    "id": "641200204",
                    "speaker": "伊娜姆",
                    "text": "给富家千金做保镖，不仅工作环境好，赚的肯定也多。"
                },
                {
                    "id": "641200205",
                    "speaker": "伊娜姆",
                    "text": "我呢，就只能成天在这边上巡逻，还得时不时去处理各个旅团之间争来争去的麻烦事。"
                },
                {
                    "id": "641200206",
                    "speaker": "伊娜姆",
                    "text": "镀金旅团的生活，可真没有其他人想象的那么刺激啊。"
                }
            ]
        },
        {
            "talkId": "6412003",
            "initDialog": "641200301",
            "dialogues": [
                {
                    "id": "641200301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641200302",
                    "speaker": "伊娜姆",
                    "text": "唉，那我接着做这份无聊的工作吧…"
                }
            ]
        },
        {
            "talkId": "6412004",
            "initDialog": "641200401",
            "dialogues": [
                {
                    "id": "641200401",
                    "speaker": "Player",
                    "text": "不能换班？"
                },
                {
                    "id": "641200402",
                    "speaker": "伊娜姆",
                    "text": "对呀，本来我们在码头干活的佣兵们是可以随便换班的，心情不好了，就换个班喝个酒。"
                },
                {
                    "id": "641200403",
                    "speaker": "伊娜姆",
                    "text": "可是现在监察官大人不让了…"
                }
            ]
        },
        {
            "talkId": "6412005",
            "initDialog": "641200501",
            "dialogues": [
                {
                    "id": "641200501",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "641200502",
                    "speaker": "伊娜姆",
                    "text": "前几天，有个才来没多久的小兄弟找玛塔莉换班，结果撞上了海兽预警。"
                },
                {
                    "id": "641200503",
                    "speaker": "伊娜姆",
                    "text": "预警解除后，监察官大人来码头巡视，问那位小兄弟预警期间的情况，他支支吾吾答不上来。"
                },
                {
                    "id": "641200504",
                    "speaker": "伊娜姆",
                    "text": "监察官大人又查了排班表，才知道是换班。所以她现在特别在意这个，没人敢犯她的忌讳。"
                },
                {
                    "id": "641200505",
                    "speaker": "伊娜姆",
                    "text": "唉…想早点下班喝点酒。"
                }
            ]
        }
    ]
}