{
    "groupId": "1826",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "曾我隅田流左近重衡": 12
    },
    "talks": [
        {
            "talkId": "6182602",
            "initDialog": "618260201",
            "dialogues": [
                {
                    "id": "618260201",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "「漆夜如乌玉，夜半云居绽明花，身似水间沫；须臾一刹终归寂，星离雨散落片空…」嗟乎，何等风雅…"
                }
            ]
        },
        {
            "talkId": "6182603",
            "initDialog": "618260301",
            "dialogues": [
                {
                    "id": "618260301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "618260302",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "某乃曾我氏之末叶，幸得御建鸣神主尊大御所大人御许，原任左近卫中将，是名隅田重衡。"
                },
                {
                    "id": "618260303",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "本于八酝岛主阵谋策夜讨敌军之事，待回过神来，竟已身在此处。"
                },
                {
                    "id": "618260304",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "两军阵头，大将行方不明…某之郎党，定会思忖是恶王麾下的曚云巫女施展外法，使某遭了神隐。"
                },
                {
                    "id": "618260305",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "大御所大人之御威光自是无碍，然而如此一来，恐怕又要让那位东山王妄受不白之冤了。"
                },
                {
                    "id": "618260306",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "虽为我等之敌，若此般令其人蒙羞，绝非仕者所为。"
                }
            ]
        },
        {
            "talkId": "6182604",
            "initDialog": "618260401",
            "dialogues": [
                {
                    "id": "618260401",
                    "speaker": "Player",
                    "text": "关于之前的烟花…"
                },
                {
                    "id": "618260402",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "轰响炫目如斯，某本以为是御建鸣神主尊大御所大人的御雷…未曾想，竟是名为「烟花」的璃月细工。"
                },
                {
                    "id": "618260403",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "不为讨敌，只为饰点夜空，便让火之花绽放…何等醉狂，又是何等泰平的盛世啊。"
                },
                {
                    "id": "618260404",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "倘若有朝一日，我等故乡的绯樱之上，也能绽开这般清丽的花朵…那便是恐悦至极之事了。"
                }
            ]
        },
        {
            "talkId": "6182605",
            "initDialog": "618260501",
            "dialogues": [
                {
                    "id": "618260501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "618260502",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "#嗯。愿{M#贵殿}{F#御方}武运长久。"
                }
            ]
        },
        {
            "talkId": "6182606",
            "initDialog": "618260601",
            "dialogues": [
                {
                    "id": "618260601",
                    "speaker": "Player",
                    "text": "你很喜欢吗？"
                },
                {
                    "id": "618260602",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "然。一刹花咲，一刹花散。所谓仕者之本怀，亦当如是。"
                },
                {
                    "id": "618260603",
                    "speaker": "曾我隅田流左近重衡",
                    "text": "…话虽如此，某如今却难遂愿，只得遭囚于有常之刻…何等可叹…"
                }
            ]
        }
    ]
}