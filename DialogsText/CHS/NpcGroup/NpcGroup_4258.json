{
    "groupId": "4258",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 4,
        "海亚姆": 18
    },
    "talks": [
        {
            "talkId": "6425801",
            "initDialog": "642580101",
            "dialogues": [
                {
                    "id": "642580101",
                    "speaker": "海亚姆",
                    "text": "孩子，你好！请问有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "6425802",
            "initDialog": "642580201",
            "dialogues": [
                {
                    "id": "642580201",
                    "speaker": "Player",
                    "text": "关于伊尔凡…"
                },
                {
                    "id": "642580202",
                    "speaker": "海亚姆",
                    "text": "啊，他呀…我们是从小玩大的朋友。他去奥摩斯港做了商人，再后来成家立业，过上了不错的日子…"
                },
                {
                    "id": "642580203",
                    "speaker": "海亚姆",
                    "text": "很久没有和他一起喝酒谈天了…直到前些年他去世，我们也没能见上一面。"
                }
            ]
        },
        {
            "talkId": "6425803",
            "initDialog": "642580301",
            "dialogues": [
                {
                    "id": "642580301",
                    "speaker": "Player",
                    "text": "关于熙蔓…"
                },
                {
                    "id": "642580302",
                    "speaker": "海亚姆",
                    "text": "……"
                },
                {
                    "id": "642580303",
                    "speaker": "海亚姆",
                    "text": "嗯…？啊，她啊…"
                },
                {
                    "id": "642580304",
                    "speaker": "海亚姆",
                    "text": "「群沙之中出生的孩子，比任何人都珍爱绿色。」这句话或许就是在说她吧…"
                },
                {
                    "id": "642580305",
                    "speaker": "海亚姆",
                    "text": "她本来应该像她父亲一样，成为一个佣兵，在广袤的沙漠冒险的…但她选择了学者的道路。"
                },
                {
                    "id": "642580306",
                    "speaker": "海亚姆",
                    "text": "但是她终究是做佣兵的料，不惜代价，不计后果，连自己的生命都不重视…"
                },
                {
                    "id": "642580307",
                    "speaker": "海亚姆",
                    "text": "我试过理解她，但那时我太年轻了，闹得很不愉快…所以，如你所见，我们分开已经有很多年了…好几十年了。"
                },
                {
                    "id": "642580308",
                    "speaker": "海亚姆",
                    "text": "希望她过得还好。"
                }
            ]
        },
        {
            "talkId": "6425804",
            "initDialog": "642580401",
            "dialogues": [
                {
                    "id": "642580401",
                    "speaker": "Player",
                    "text": "关于病历…"
                },
                {
                    "id": "642580402",
                    "speaker": "海亚姆",
                    "text": "病历？病历…"
                },
                {
                    "id": "642580403",
                    "speaker": "海亚姆",
                    "text": "哦！你看到了？我的病历？"
                },
                {
                    "id": "642580404",
                    "speaker": "海亚姆",
                    "text": "哈哈…你看到了呀…你看到了。"
                },
                {
                    "id": "642580405",
                    "speaker": "海亚姆",
                    "text": "他们说我最后会忘掉一切，忘掉毕生所学的知识，忘掉最好的朋友…什么也留不下。"
                },
                {
                    "id": "642580406",
                    "speaker": "海亚姆",
                    "text": "到那时候，我会失去记忆，失去一切，失去活着的知觉，然后忘记自己是否存在。总会这样的，总会这样的…"
                },
                {
                    "id": "642580407",
                    "speaker": "海亚姆",
                    "text": "所以在那之前，至少在那之前…我想做一点自己想做的事，就这样待在自己想要死去的地方。"
                },
                {
                    "id": "642580408",
                    "speaker": "海亚姆",
                    "text": "遗忘阻拦不了我的脚步，熙蔓也不能…"
                }
            ]
        },
        {
            "talkId": "6425805",
            "initDialog": "642580501",
            "dialogues": [
                {
                    "id": "642580501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642580502",
                    "speaker": "海亚姆",
                    "text": "哈哈，别让我留你太久啦，孩子！"
                }
            ]
        }
    ]
}