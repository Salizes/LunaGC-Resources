            "dialogues": [
                {
                    "id": "697140101",
                    "speaker": "鲁达贝",
                    "text": "嗯，玩「七圣召唤」也是种休息，有的时候需要将思路从课题中抽离…"
                },
                {
                    "id": "697140102",
                    "speaker": "鲁达贝",
                    "text": "之后才能更加投入，要是太过「疲惫」了也不行。如何，要来一局吗？"
                }
            ]
        },
        {
            "talkId": "6971402",
            "initDialog": "697140201",
            "dialogues": [
                {
                    "id": "697140201",
                    "speaker": "Player",
                    "text": "来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6971403",
            "initDialog": "697140301",
            "dialogues": [
                {
                    "id": "697140301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "697140302",
                    "speaker": "鲁达贝",
                    "text": "没关系没关系，那就之后，之后等你空闲下来了，我们再来玩牌吧。"
                }
            ]
        },
        {
            "talkId": "6971404",
            "initDialog": "697140401",
            "dialogues": [
                {
                    "id": "697140401",
                    "speaker": "鲁达贝",
                    "text": "赢了…啊，虽然我是生论派的，但是毕竟也是学者，可别小看我哦。"
                }
            ]
        },
        {
            "talkId": "6971405",
            "initDialog": "697140501",
            "dialogues": [
                {
                    "id": "697140501",
                    "speaker": "鲁达贝",
                    "text": "欸呀，居然被破解了…好强…"
                }
            ]
        }
    ]
