        {
            "talkId": "6955902",
            "initDialog": "695590201",
            "dialogues": [
                {
                    "id": "695590201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955903",
            "initDialog": "695590301",
            "dialogues": [
                {
                    "id": "695590301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695590302",
                    "speaker": "早柚",
                    "text": "要走了吗？我也该回去了…呼…"
