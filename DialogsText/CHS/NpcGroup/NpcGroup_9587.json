{
    "groupId": "9587",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "恰斯卡": 10
    },
    "talks": [
        {
            "talkId": "6958701",
            "initDialog": "695870101",
            "dialogues": [
                {
                    "id": "695870101",
                    "speaker": "恰斯卡",
                    "text": "没想到这家酒馆里的氛围还挺好的，大家都安安稳稳坐着玩牌，就连争论也很少。想想之前部族里搞卡牌竞赛时，那个氛围…咳…确实是火热过头了…"
                }
            ]
        },
        {
            "talkId": "6958702",
            "initDialog": "695870201",
            "dialogues": [
                {
                    "id": "695870201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958703",
            "initDialog": "695870301",
            "dialogues": [
                {
                    "id": "695870301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695870302",
                    "speaker": "恰斯卡",
                    "text": "要走了？我打算挑几张漂亮的卡牌带回去，也许「妈妈」会很喜欢的，嗯…牌面上最好还要带上那种亮闪闪的碎光。"
                }
            ]
        },
        {
            "talkId": "6958704",
            "initDialog": "695870401",
            "dialogues": [
                {
                    "id": "695870401",
                    "speaker": "恰斯卡",
                    "text": "苦战良久，勉强取胜。这场胜利可算是得来不易了，必须要庆祝一下，想喝什么？我请你。"
                }
            ]
        },
        {
            "talkId": "6958705",
            "initDialog": "695870501",
            "dialogues": [
                {
                    "id": "695870501",
                    "speaker": "恰斯卡",
                    "text": "是你赢了。我只是略微心急了一下，就被你抓住了漏洞。再来一局？这次我不会再失误了。"
                }
            ]
        },
        {
            "talkId": "6958706",
            "initDialog": "695870601",
            "dialogues": [
                {
                    "id": "695870601",
                    "speaker": "恰斯卡",
                    "text": "要打牌？来吧，我可不会放水的。"
                }
            ]
        },
        {
            "talkId": "6958708",
            "initDialog": "695870801",
            "dialogues": [
                {
                    "id": "695870801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958709",
            "initDialog": "695870901",
            "dialogues": [
                {
                    "id": "695870901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958710",
            "initDialog": "695871001",
            "dialogues": [
                {
                    "id": "695871001",
                    "speaker": "恰斯卡",
                    "text": "嗯，这一局我的牌运不错。"
                }
            ]
        },
        {
            "talkId": "6958711",
            "initDialog": "695871101",
            "dialogues": [
                {
                    "id": "695871101",
                    "speaker": "恰斯卡",
                    "text": "输掉了，没办法，胜败都是常事。"
                }
            ]
        },
        {
            "talkId": "6958712",
            "initDialog": "695871201",
            "dialogues": [
                {
                    "id": "695871201",
                    "speaker": "恰斯卡",
                    "text": "行啊，好好玩一把。部族里可没多少人能赢我。"
                }
            ]
        },
        {
            "talkId": "6958714",
            "initDialog": "695871401",
            "dialogues": [
                {
                    "id": "695871401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6958715",
            "initDialog": "695871501",
            "dialogues": [
                {
                    "id": "695871501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6958716",
            "initDialog": "695871601",
            "dialogues": [
                {
                    "id": "695871601",
                    "speaker": "恰斯卡",
                    "text": "呼…算是险胜。看来，你平时也没少打牌？"
                }
            ]
        },
        {
            "talkId": "6958717",
            "initDialog": "695871701",
            "dialogues": [
                {
                    "id": "695871701",
                    "speaker": "恰斯卡",
                    "text": "你赢了。牌技不错啊，比部族里的大部分人都要厉害。"
                }
            ]
        },
        {
            "talkId": "6958718",
            "initDialog": "695871801",
            "dialogues": [
                {
                    "id": "695871801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}