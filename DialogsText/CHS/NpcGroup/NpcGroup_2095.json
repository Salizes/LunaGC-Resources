{
    "groupId": "2095",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 1,
        "思妤": 17
    },
    "talks": [
        {
            "talkId": "6209501",
            "initDialog": "620950101",
            "dialogues": [
                {
                    "id": "620950101",
                    "speaker": "思妤",
                    "text": "你好，怎么了？"
                },
                {
                    "id": "620950102",
                    "speaker": "思妤",
                    "text": "啊…你这么一搭话，我又算不清楚钱了。"
                }
            ]
        },
        {
            "talkId": "6209502",
            "initDialog": "620950201",
            "dialogues": [
                {
                    "id": "620950201",
                    "speaker": "思妤",
                    "text": "你在做什么？"
                },
                {
                    "id": "620950202",
                    "speaker": "思妤",
                    "text": "哦，我正打算买鱼呢。"
                },
                {
                    "id": "620950203",
                    "speaker": "思妤",
                    "text": "看了老高的鱼之后，再看老孙家的鱼，就感觉真是又便宜又新鲜呢！"
                },
                {
                    "id": "620950204",
                    "speaker": "思妤",
                    "text": "本想借机多买几条回去给老公吃，可太多自己又搬不动…唉，要是扳子哥在就好了…"
                },
                {
                    "id": "620950205",
                    "speaker": "思妤",
                    "text": "扳子哥是…？"
                },
                {
                    "id": "620950206",
                    "speaker": "思妤",
                    "text": "对呀，就是造船厂的王扳子。他的力气特别大，肯定能帮我扛回家去的。"
                },
                {
                    "id": "620950207",
                    "speaker": "思妤",
                    "text": "他从小就对我可好了，有什么好吃的都愿意分我一半，还会很耐心地教我算术…他就跟我的亲哥哥一样！"
                },
                {
                    "id": "620950208",
                    "speaker": "思妤",
                    "text": "不过不知道为什么，他好像不喜欢我老公，总是瞪着他…"
                },
                {
                    "id": "620950209",
                    "speaker": "思妤",
                    "text": "唉，怎么才能让他们好好相处呢？好苦恼啊…"
                }
            ]
        },
        {
            "talkId": "6209503",
            "initDialog": "620950301",
            "dialogues": [
                {
                    "id": "620950301",
                    "speaker": "思妤",
                    "text": "再见。"
                },
                {
                    "id": "620950302",
                    "speaker": "思妤",
                    "text": "再见…"
                },
                {
                    "id": "620950303",
                    "speaker": "思妤",
                    "text": "欸？我刚才算到哪了？"
                }
            ]
        },
        {
            "talkId": "6209504",
            "initDialog": "620950401",
            "dialogues": [
                {
                    "id": "620950401",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "620950402",
                    "speaker": "思妤",
                    "text": "我叫思妤，从小在这海边长大的，但港口捕到的这些鱼，我从来都吃不腻。"
                },
                {
                    "id": "620950403",
                    "speaker": "思妤",
                    "text": "前两年我才刚成亲，多亏了岩王爷的神谕，这两年丈夫的生意顺风顺水…"
                },
                {
                    "id": "620950404",
                    "speaker": "思妤",
                    "text": "虽然积攒了些小小的财富，但作为一个新任家庭主妇，还是要多注意节俭才是…"
                }
            ]
        }
    ]
}