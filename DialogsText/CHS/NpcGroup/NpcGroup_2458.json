{
    "groupId": "2458",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "佑旭": 13
    },
    "talks": [
        {
            "talkId": "6245801",
            "initDialog": "624580101",
            "dialogues": [
                {
                    "id": "624580101",
                    "speaker": "佑旭",
                    "text": "此处是重地「黄金屋」，请注意自己的举止，不然我会紧张。"
                }
            ]
        },
        {
            "talkId": "6245802",
            "initDialog": "624580201",
            "dialogues": [
                {
                    "id": "624580201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624580202",
                    "speaker": "佑旭",
                    "text": "我叫佑旭，迄今为止都平凡无奇的一名千岩军。"
                },
                {
                    "id": "624580203",
                    "speaker": "佑旭",
                    "text": "如果你去过玉京台，可能见到过我的哥哥逢岩在那里巡逻。"
                },
                {
                    "id": "624580204",
                    "speaker": "佑旭",
                    "text": "他是现任千岩军的教官，也是我的榜样。不过我相信，那个位置迟早也会是我的，呵呵。"
                }
            ]
        },
        {
            "talkId": "6245803",
            "initDialog": "624580301",
            "dialogues": [
                {
                    "id": "624580301",
                    "speaker": "Player",
                    "text": "关于「黄金屋」…"
                },
                {
                    "id": "624580302",
                    "speaker": "佑旭",
                    "text": "这里是整个大陆的造币厂，说是璃月最重要的地方也完全不为过。"
                },
                {
                    "id": "624580303",
                    "speaker": "佑旭",
                    "text": "作为一个璃月子民，我期望这里千世万代安宁，但作为一个千岩军…"
                },
                {
                    "id": "624580304",
                    "speaker": "佑旭",
                    "text": "我希望它能给我一个建功立业的机会，我相信一定会有胆大包天的家伙们正在打这里的主意的。"
                }
            ]
        },
        {
            "talkId": "6245804",
            "initDialog": "624580401",
            "dialogues": [
                {
                    "id": "624580401",
                    "speaker": "Player",
                    "text": "关于「黄金屋」…"
                },
                {
                    "id": "624580402",
                    "speaker": "佑旭",
                    "text": "唉，我到现在都还在懊恼…上次仙人「来访」璃月港的时候，我们的军力被集中调遣到城内加强防卫了…"
                },
                {
                    "id": "624580403",
                    "speaker": "佑旭",
                    "text": "后来接到报告才知道「黄金屋」遭袭的事…明明我早就预想到会有这一天的。"
                },
                {
                    "id": "624580404",
                    "speaker": "佑旭",
                    "text": "虽说听从指挥的我本身没什么错，但、但是…这可是扬名立万的好机会啊，就被我这么放过去了…"
                },
                {
                    "id": "624580405",
                    "speaker": "佑旭",
                    "text": "我现在感觉似乎白白在这里守了好多年，唉…凭我的武艺，一定可以阻止那个擅闯「黄金屋」的家伙的…"
                },
                {
                    "id": "624580406",
                    "speaker": "佑旭",
                    "text": "嗯？你的表情是什么意思，不相信吗？"
                }
            ]
        },
        {
            "talkId": "6245805",
            "initDialog": "624580501",
            "dialogues": [
                {
                    "id": "624580501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624580502",
                    "speaker": "佑旭",
                    "text": "千岩牢固，重嶂不移。"
                }
            ]
        }
    ]
}