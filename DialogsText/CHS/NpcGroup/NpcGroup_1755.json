    "talks": [
        {
            "talkId": "6175501",
            "initDialog": "617550101",
            "dialogues": [
                {
                    "id": "617550101",
                    "speaker": "赫恩",
                    "text": "那个…你有看到杜拉夫叔叔的鸽子吗？"
                }
            ]
        },
        {
            "talkId": "6175502",
            "initDialog": "617550201",
            "dialogues": [
                {
                    "id": "617550201",
                    "speaker": "Player",
                    "text": "鸽子？"
                },
                {
                    "id": "617550202",
                    "speaker": "赫恩",
                    "text": "唉…是啊，我在等杜拉夫叔叔的信鸽。"
                },
                {
                    "id": "617550203",
                    "speaker": "赫恩",
                    "text": "我之前写信问他，应不应该去纳塔冒险。他应该早就给我回信了，可我却一直没收到…"
                },
                {
                    "id": "617550204",
                    "speaker": "赫恩",
                    "text": "唔，说不定这也是一种暗示呢？杜拉夫叔叔的意思其实是，就连鸽子都有可能在路上失踪，更别说我这样的年轻人了…"
                }
            ]
        },
        {
            "talkId": "6175503",
            "initDialog": "617550301",
            "dialogues": [
                {
                    "id": "617550301",
                    "speaker": "Player",
                    "text": "没看到，再见。"
                },
                {
                    "id": "617550302",
                    "speaker": "赫恩",
                    "text": "唉…好吧，那我只能再等等了。"
                }
            ]
        }
    ]
}