{
    "groupId": "3073",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 4,
        "婷婷": 4,
        "笹野": 19
    },
    "talks": [
        {
            "talkId": "4006301",
            "initDialog": "400630101",
            "dialogues": [
                {
                    "id": "400630101",
                    "speaker": "婷婷",
                    "text": "我们一起买的这本同人小说，你读完了吗？"
                },
                {
                    "id": "400630102",
                    "speaker": "笹野",
                    "text": "嗯嗯，大致读完了…"
                },
                {
                    "id": "400630103",
                    "speaker": "婷婷",
                    "text": "是不是很棒？我很喜欢女主角最后坚定信念，走向新生活的结尾。"
                },
                {
                    "id": "400630104",
                    "speaker": "笹野",
                    "text": "虽然前面的剧情都很精彩，但是我记得原作的结局似乎不是这样的…"
                },
                {
                    "id": "400630105",
                    "speaker": "婷婷",
                    "text": "哎，所以这就是同人作品的自由之处啦。"
                },
                {
                    "id": "400630106",
                    "speaker": "婷婷",
                    "text": "能在同人中见到多种多样的角色故事，正是乐趣所在啊。"
                },
                {
                    "id": "400630107",
                    "speaker": "笹野",
                    "text": "啊，是，是，你说得有道理…"
                },
                {
                    "id": "400630108",
                    "speaker": "笹野",
                    "text": "那个，我听说那边有新的绘本开启贩售了，要一起去看看吗？"
                }
            ]
        },
        {
            "talkId": "6307301",
            "initDialog": "630730101",
            "dialogues": [
                {
                    "id": "630730101",
                    "speaker": "笹野",
                    "text": "唉…为了她，我是不是应该…"
                }
            ]
        },
        {
            "talkId": "6307302",
            "initDialog": "630730201",
            "dialogues": [
                {
                    "id": "630730201",
                    "speaker": "Player",
                    "text": "你好像很忧愁？"
                },
                {
                    "id": "630730202",
                    "speaker": "笹野",
                    "text": "这位异乡的朋友，你有没有过这样的经历，当你遇见了一个人之后，便感觉整个世界都被点亮？"
                },
                {
                    "id": "630730203",
                    "speaker": "笹野",
                    "text": "啊…不好意思，是我太肉麻了…"
                },
                {
                    "id": "630730204",
                    "speaker": "笹野",
                    "text": "但是，这确实是我的真实感受。"
                },
                {
                    "id": "630730205",
                    "speaker": "笹野",
                    "text": "在遇见她之后，我甚至想要离开我的家乡，追随她到未知的远方…"
                }
            ]
        },
        {
            "talkId": "6307303",
            "initDialog": "630730301",
            "dialogues": [
                {
                    "id": "630730301",
                    "speaker": "Player",
                    "text": "「她」？"
                },
                {
                    "id": "630730302",
                    "speaker": "笹野",
                    "text": "嗯，她来自璃月，是我不久前邂逅的命中之人。"
                },
                {
                    "id": "630730303",
                    "speaker": "笹野",
                    "text": "她性格开朗洒脱，自由不羁，与一直都生活在稻妻的我完全不同。和她在一起的时候，世界都变得不一样了。"
                },
                {
                    "id": "630730304",
                    "speaker": "笹野",
                    "text": "最近我常常想，是不是应该跟她离开稻妻，踏上我从未设想过的旅途…"
                },
                {
                    "id": "630730305",
                    "speaker": "笹野",
                    "text": "但头疼的是，我作为家业的继承人，实在很难放下家中的职责离开…"
                },
                {
                    "id": "630730306",
                    "speaker": "笹野",
                    "text": "唉，该如何是好呢…"
                }
            ]
        },
        {
            "talkId": "6307304",
            "initDialog": "630730401",
            "dialogues": [
                {
                    "id": "630730401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630730402",
                    "speaker": "笹野",
                    "text": "再见…我得好好想想…"
                }
            ]
        },
        {
            "talkId": "6307305",
            "initDialog": "630730501",
            "dialogues": [
                {
                    "id": "630730501",
                    "speaker": "Player",
                    "text": "「她」？"
                },
                {
                    "id": "630730502",
                    "speaker": "笹野",
                    "text": "嗯，她来自璃月，是我不久前邂逅的命中之人。"
                },
                {
                    "id": "630730503",
                    "speaker": "笹野",
                    "text": "她性格开朗洒脱，自由不羁，与一直都生活在稻妻的我完全不同。和她在一起的时候，世界都变得不一样了。"
                },
                {
                    "id": "630730504",
                    "speaker": "笹野",
                    "text": "她总有一天会踏上新的旅途，到时候…我是不是也该迈出新的一步，随她一起离开呢？"
                },
                {
                    "id": "630730505",
                    "speaker": "笹野",
                    "text": "留在稻妻继承家业固然是最保险的选择，但扪心自问的话，如果我放弃了她，以后一定会后悔的…"
                }
            ]
        }
    ]
}