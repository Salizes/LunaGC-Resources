{
    "groupId": "9383",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "艾梅莉埃": 9
    },
    "talks": [
        {
            "talkId": "6938301",
            "initDialog": "693830101",
            "dialogues": [
                {
                    "id": "693830101",
                    "speaker": "艾梅莉埃",
                    "text": "看你有些疲惫，是否需要休息？"
                },
                {
                    "id": "693830102",
                    "speaker": "艾梅莉埃",
                    "text": "转移注意力是放松精神的有效方法之一，我们可以聊聊今天报纸上的新闻。"
                },
                {
                    "id": "693830103",
                    "speaker": "艾梅莉埃",
                    "text": "其他话题也可以，请吧。"
                }
            ]
        },
        {
            "talkId": "6938302",
            "initDialog": "693830201",
            "dialogues": [
                {
                    "id": "693830201",
                    "speaker": "艾梅莉埃",
                    "text": "没想到你需要面对如此强大的敌人…"
                },
                {
                    "id": "693830202",
                    "speaker": "艾梅莉埃",
                    "text": "你邀请我来，一定是相信我的能力可以为你所用。"
                },
                {
                    "id": "693830203",
                    "speaker": "艾梅莉埃",
                    "text": "无需客套，我定会尽力相助。"
                }
            ]
        },
        {
            "talkId": "6938303",
            "initDialog": "693830301",
            "dialogues": [
                {
                    "id": "693830301",
                    "speaker": "艾梅莉埃",
                    "text": "我一直觉得，图书馆中陈列的书籍，就像架子上的一瓶瓶香水。"
                },
                {
                    "id": "693830302",
                    "speaker": "艾梅莉埃",
                    "text": "每样都值得细细品味，直到访客找到最适合自己的那款。"
                },
                {
                    "id": "693830303",
                    "speaker": "艾梅莉埃",
                    "text": "在寻找的过程中保持期待，是种值得珍惜的体验。"
                }
            ]
        }
    ]
}