{
    "groupId": "7030",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "亚洛辛斯基": 8
    },
    "talks": [
        {
            "talkId": "6703001",
            "initDialog": "670300101",
            "dialogues": [
                {
                    "id": "670300101",
                    "speaker": "亚洛辛斯基",
                    "text": "您好，需要办理贷款业务吗？要不要试试我们最新推出的「合家欢乐贷」，前三期零利率哦。"
                }
            ]
        },
        {
            "talkId": "6703002",
            "initDialog": "670300201",
            "dialogues": [
                {
                    "id": "670300201",
                    "speaker": "Player",
                    "text": "贷款需要什么条件。"
                },
                {
                    "id": "670300202",
                    "speaker": "亚洛辛斯基",
                    "text": "有兴趣的话我们谈一谈？根据贷款的不同用途，我们也有不同的套餐以供选择。"
                },
                {
                    "id": "670300203",
                    "speaker": "亚洛辛斯基",
                    "text": "只需留下您的姓名、住址、担保人…以及三个月以来的行程记录，越详细越好。"
                },
                {
                    "id": "670300204",
                    "speaker": "亚洛辛斯基",
                    "text": "别多想，这都是为了给您定制更专业的还款计划。"
                }
            ]
        },
        {
            "talkId": "6703003",
            "initDialog": "670300301",
            "dialogues": [
                {
                    "id": "670300301",
                    "speaker": "Player",
                    "text": "这里的人不像会老实还钱。"
                },
                {
                    "id": "670300302",
                    "speaker": "亚洛辛斯基",
                    "text": "最开始的时候我也像您这样想，不过事实上本行的还款率比枫丹的分行还要高。"
                },
                {
                    "id": "670300303",
                    "speaker": "亚洛辛斯基",
                    "text": "或许是因为我告诉他们，北国银行会为无法偿还债务的人提供「合适」的工作，帮助他们早日回归正常生活。"
                },
                {
                    "id": "670300304",
                    "speaker": "亚洛辛斯基",
                    "text": "呵呵，也不知道为什么，他们听完之后，总是过不了几天就把拖欠的债务如数偿还了。"
                }
            ]
        },
        {
            "talkId": "6703004",
            "initDialog": "670300401",
            "dialogues": [
                {
                    "id": "670300401",
                    "speaker": "Player",
                    "text": "不需要了，谢谢。"
                },
                {
                    "id": "670300402",
                    "speaker": "亚洛辛斯基",
                    "text": "好的，需要的时候可以随时找我。"
                }
            ]
        }
    ]
}