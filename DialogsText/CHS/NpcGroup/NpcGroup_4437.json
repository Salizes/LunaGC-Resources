            "dialogues": [
                {
                    "id": "733380401",
                    "speaker": "Player",
                    "text": "（挑战牌盒上有动物爪印的套牌…）"
                }
            ]
        },
        {
            "talkId": "7333805",
            "initDialog": "733380501",
            "dialogues": [
                {
                    "id": "733380501",
                    "speaker": "Player",
                    "text": "不，还是算了吧…"
                },
                {
                    "id": "733380502",
                    "speaker": "坦吉",
                    "text": "嗯…好吧，那等你有心情了再说…"
                }
            ]
        },
        {
            "talkId": "7333806",
            "initDialog": "733380601",
            "dialogues": [
                {
                    "id": "733380601",
                    "speaker": "Player",
                    "text": "我不介意。"
                },
                {
                    "id": "733380602",
                    "speaker": "坦吉",
                    "text": "哈哈，那我们开始吧！我看看，这里一共有三套牌…怎么样，你想挑战哪一套？先说好，我水平可是很高的。"
                }
            ]
        },
        {
            "talkId": "7333807",
            "initDialog": "733380701",
            "dialogues": [
                {
                    "id": "733380701",
                    "speaker": "Player",
                    "text": "抱歉，我没心情…"
                },
                {
                    "id": "733380702",
                    "speaker": "坦吉",
                    "text": "啊…嗯，我能理解，抱歉…那你保重。"
                }
            ]
        }
    ]
}