{
    "groupId": "4437",
    "total_dialogue_lines": 36,
    "speaker_counts": {
        "Player": 15,
        "坦吉": 21
    },
    "talks": [
        {
            "talkId": "6443701",
            "initDialog": "644370101",
            "dialogues": [
                {
                    "id": "644370101",
                    "speaker": "坦吉",
                    "text": "啊，是你！没想到你还会回到这里来！"
                }
            ]
        },
        {
            "talkId": "6443702",
            "initDialog": "644370201",
            "dialogues": [
                {
                    "id": "644370201",
                    "speaker": "Player",
                    "text": "你还留在这里？"
                },
                {
                    "id": "644370202",
                    "speaker": "坦吉",
                    "text": "哈哈，是啊。向教令院报告了我发现的一切，申请了新的项目…"
                },
                {
                    "id": "644370203",
                    "speaker": "坦吉",
                    "text": "现在呢，我要搞清楚这个地方究竟发生了什么…"
                },
                {
                    "id": "644370204",
                    "speaker": "坦吉",
                    "text": "嗯，也算是给我的历史研究添上一笔。"
                },
                {
                    "id": "644370205",
                    "speaker": "坦吉",
                    "text": "不必担心我的安全，大风纪官很关注这里，他承诺对派来这里的学者提供充足物资和保护。"
                }
            ]
        },
        {
            "talkId": "6443703",
            "initDialog": "644370301",
            "dialogues": [
                {
                    "id": "644370301",
                    "speaker": "Player",
                    "text": "来局牌吧。"
                },
                {
                    "id": "644370302",
                    "speaker": "坦吉",
                    "text": "哈哈，能在这种地方遇到牌友，真是太好了！"
                },
                {
                    "id": "644370303",
                    "speaker": "坦吉",
                    "text": "这里一共有三套牌…怎么样，你想挑战哪一套？先说好，我水平可是很高的。"
                }
            ]
        },
        {
            "talkId": "6443704",
            "initDialog": "644370401",
            "dialogues": [
                {
                    "id": "644370401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "644370402",
                    "speaker": "坦吉",
                    "text": "祝你一路平安！"
                }
            ]
        },
        {
            "talkId": "6443705",
            "initDialog": "644370501",
            "dialogues": [
                {
                    "id": "644370501",
                    "speaker": "Player",
                    "text": "历史研究…？"
                },
                {
                    "id": "644370502",
                    "speaker": "坦吉",
                    "text": "嗯，很奇怪吗？"
                },
                {
                    "id": "644370503",
                    "speaker": "坦吉",
                    "text": "神王的故事是历史，帕维兹拉万的内室是历史…而塔尼特的神秘惨案也是历史。"
                },
                {
                    "id": "644370504",
                    "speaker": "坦吉",
                    "text": "简而言之…哈哈，真相的碎片要如何拼合？"
                },
                {
                    "id": "644370505",
                    "speaker": "坦吉",
                    "text": "记录旧事的人在写下文字时，他的目的是什么？他可能在想什么？"
                },
                {
                    "id": "644370506",
                    "speaker": "坦吉",
                    "text": "…这就是历史。"
                }
            ]
        },
        {
            "talkId": "6443706",
            "initDialog": "644370601",
            "dialogues": [
                {
                    "id": "644370601",
                    "speaker": "Player",
                    "text": "有什么新的发现？"
                },
                {
                    "id": "644370602",
                    "speaker": "坦吉",
                    "text": "新发现？嗯…比如，尚未灭亡的花神信仰？呃…恐怕现在已经灭亡了吧。"
                },
                {
                    "id": "644370603",
                    "speaker": "坦吉",
                    "text": "还有…很多从教令院走私来的书籍，嗯，很多，非常多。"
                },
                {
                    "id": "644370604",
                    "speaker": "坦吉",
                    "text": "有一些甚至我也闻所未闻…呃，比如…「映影」，他们了解这些知识干什么？"
                },
                {
                    "id": "644370605",
                    "speaker": "坦吉",
                    "text": "不过显然，这些沙漠人不是我们一般印象中对知识嗤之以鼻的文盲…真是了不得。"
                }
            ]
        },
        {
            "talkId": "6443707",
            "initDialog": "644370701",
            "dialogues": [
                {
                    "id": "644370701",
                    "speaker": "Player",
                    "text": "（挑战牌盒上有黑色污渍的套牌…）"
                }
            ]
        },
        {
            "talkId": "6443708",
            "initDialog": "644370801",
            "dialogues": [
                {
                    "id": "644370801",
                    "speaker": "Player",
                    "text": "（挑战牌盒上有刀刃划痕的套牌…）"
                }
            ]
        },
        {
            "talkId": "6443709",
            "initDialog": "644370901",
            "dialogues": [
                {
                    "id": "644370901",
                    "speaker": "Player",
                    "text": "（挑战牌盒上有动物爪印的套牌…）"
                }
            ]
        },
        {
            "talkId": "6443710",
            "initDialog": "644371001",
            "dialogues": [
                {
                    "id": "644371001",
                    "speaker": "Player",
                    "text": "不，还是算了吧…"
                },
                {
                    "id": "644371002",
                    "speaker": "坦吉",
                    "text": "嗯…好吧，那等你有心情了再说…"
                }
            ]
        },
        {
            "talkId": "7333802",
            "initDialog": "733380201",
            "dialogues": [
                {
                    "id": "733380201",
                    "speaker": "Player",
                    "text": "（挑战牌盒上有黑色污渍的套牌…）"
                }
            ]
        },
