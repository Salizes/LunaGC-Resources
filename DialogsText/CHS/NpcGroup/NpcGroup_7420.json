    },
    "talks": [
        {
            "talkId": "6742001",
            "initDialog": "674200101",
            "dialogues": [
                {
                    "id": "674200101",
                    "speaker": "纳费多夫",
                    "text": "这个单子好了，好，还有这道菜，上菜了，一号桌！嗯？…怎么了？客人。"
                }
            ]
        },
        {
            "talkId": "6742002",
            "initDialog": "674200201",
            "dialogues": [
                {
                    "id": "674200201",
                    "speaker": "Player",
                    "text": "你是这家店的老板？"
                },
                {
                    "id": "674200202",
                    "speaker": "纳费多夫",
                    "text": "是的，这家由兽怪搭建，兽怪经营，为整个至冬所有食客服务的餐厅…的老板，就是我。"
                },
                {
                    "id": "674200203",
                    "speaker": "纳费多夫",
                    "text": "好了，您要来这儿只为了问这个，那恕我不能奉陪了，还有好多事要做呢。"
                }
            ]
        },
        {
            "talkId": "6742003",
            "initDialog": "674200301",
            "dialogues": [
                {
                    "id": "674200301",
                    "speaker": "Player",
                    "text": "毛会不会掉进菜里…"
                },
                {
                    "id": "674200302",
                    "speaker": "纳费多夫",
                    "text": "当然不会，我们的厨师会清理完浮毛再上厨，也尽可能保证料理烹饪期间不会抖落不该进去的东西…"
                },
                {
                    "id": "674200303",
                    "speaker": "纳费多夫",
                    "text": "如果您…真的遇到了类似的情况，可以让侍者把菜撤走，我们重新为您做一份。"
                }
            ]
        },
        {
            "talkId": "6742004",
            "initDialog": "674200401",
            "dialogues": [
                {
                    "id": "674200401",
                    "speaker": "Player",
                    "text": "没什么事。"
                },
                {
                    "id": "674200402",
                    "speaker": "纳费多夫",
                    "text": "那祝您用餐愉快，客人。"
                }
            ]
        },
        {
