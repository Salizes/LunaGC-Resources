{
    "groupId": "4301",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 7,
        "阿米尔": 21
    },
    "talks": [
        {
            "talkId": "6430101",
            "initDialog": "643010101",
            "dialogues": [
                {
                    "id": "643010101",
                    "speaker": "阿米尔",
                    "text": "这些家伙啊…不工作的时候就知道乱跑。"
                },
                {
                    "id": "643010102",
                    "speaker": "阿米尔",
                    "text": "希望它们能盯紧那个小姑娘的状况，如有异常及时汇报吧。"
                }
            ]
        },
        {
            "talkId": "6430102",
            "initDialog": "643010201",
            "dialogues": [
                {
                    "id": "643010201",
                    "speaker": "Player",
                    "text": "这些家伙？"
                },
                {
                    "id": "643010202",
                    "speaker": "阿米尔",
                    "text": "是啊，就是这些毛茸茸的家伙们，每天都不安生，转着圈地跑，吵吵闹闹的。"
                },
                {
                    "id": "643010203",
                    "speaker": "阿米尔",
                    "text": "但还好在工作的时候都很认真，不然我要再给它们好好上一课了。"
                }
            ]
        },
        {
            "talkId": "6430103",
            "initDialog": "643010301",
            "dialogues": [
                {
                    "id": "643010301",
                    "speaker": "Player",
                    "text": "那个小姑娘是…"
                },
                {
                    "id": "643010302",
                    "speaker": "阿米尔",
                    "text": "哦…哦，她是我们这里的见习巡林员啦。"
                },
                {
                    "id": "643010303",
                    "speaker": "阿米尔",
                    "text": "她…身体不是很好，来我们这里既是在学习，也是在养病。"
                },
                {
                    "id": "643010304",
                    "speaker": "阿米尔",
                    "text": "看她年纪这么小却这么要强，我还是挺担心她的身体状况的。"
                },
                {
                    "id": "643010305",
                    "speaker": "阿米尔",
                    "text": "所以我特别叮嘱搜救犬们，要多多注意她的情况。如果有问题一定要马上告诉我，这样才能及时帮到她啊。"
                }
            ]
        },
        {
            "talkId": "6430104",
            "initDialog": "643010401",
            "dialogues": [
                {
                    "id": "643010401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643010402",
                    "speaker": "阿米尔",
                    "text": "再见，祝你旅途顺利。"
                }
            ]
        },
        {
            "talkId": "6430105",
            "initDialog": "643010501",
            "dialogues": [
                {
                    "id": "643010501",
                    "speaker": "Player",
                    "text": "毛茸茸的…巡林官？"
                },
                {
                    "id": "643010502",
                    "speaker": "阿米尔",
                    "text": "哈哈，你是不是误会了什么？我说的不是我的同事啦，而是这些狗狗们。"
                },
                {
                    "id": "643010503",
                    "speaker": "阿米尔",
                    "text": "别看它们平时乱七八糟的，但实际上都是顶顶可靠的搜救犬，是我们巡林工作中的好朋友、好助手。"
                },
                {
                    "id": "643010504",
                    "speaker": "阿米尔",
                    "text": "我呢，就是负责管理和训练搜救犬的人啦。"
                },
                {
                    "id": "643010505",
                    "speaker": "阿米尔",
                    "text": "萨古是我最出色的学生，所以被我任命为搜救犬小队队长。万一找不到巡林官或者巡林员的话，大家找它帮忙也可以啦。"
                }
            ]
        },
        {
            "talkId": "6430106",
            "initDialog": "643010601",
            "dialogues": [
                {
                    "id": "643010601",
                    "speaker": "Player",
                    "text": "那个小姑娘是…"
                },
                {
                    "id": "643010602",
                    "speaker": "阿米尔",
                    "text": "哦…哦，她是我们这里的见习巡林员啦。"
                },
                {
                    "id": "643010603",
                    "speaker": "阿米尔",
                    "text": "她大病初愈，最近好像有些努力过头了。"
                },
                {
                    "id": "643010604",
                    "speaker": "阿米尔",
                    "text": "看她每天忙上忙下，我还是会有些担心她的状况，怕她又独自跑进大雨里去救人。"
                },
                {
                    "id": "643010605",
                    "speaker": "阿米尔",
                    "text": "所以我特别叮嘱搜救犬们，要多多注意她的情况。如果有问题一定要马上告诉我，这样才能及时帮到她啊。"
                }
            ]
        },
        {
            "talkId": "6430107",
            "initDialog": "643010701",
            "dialogues": [
                {
                    "id": "643010701",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6430108",
            "initDialog": "643010801",
            "dialogues": [
                {
                    "id": "643010801",
                    "speaker": "阿米尔",
                    "text": "啊，我还以为我能赢呢，看来是我想多啦，哈哈…"
                }
            ]
        },
        {
            "talkId": "6430109",
            "initDialog": "643010901",
            "dialogues": [
                {
                    "id": "643010901",
                    "speaker": "阿米尔",
                    "text": "哈哈，真是一场险胜啊…"
                }
            ]
        },
        {
            "talkId": "7390101",
            "initDialog": "739010101",
            "dialogues": [
                {
                    "id": "739010101",
                    "speaker": "Player",
                    "text": "我也可以帮忙。"
                },
                {
                    "id": "739010102",
                    "speaker": "阿米尔",
                    "text": "多谢啦。真希望能有更多像你一样的热心人加入巡林队。"
                },
                {
                    "id": "739010103",
                    "speaker": "阿米尔",
                    "text": "说起来，你这是准备前往道成林吗？那也送你一些常用的药草吧，关键时候总能派上用场的。"
                }
            ]
        }
    ]
}