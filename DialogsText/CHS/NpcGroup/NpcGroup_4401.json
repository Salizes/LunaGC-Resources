{
    "groupId": "4401",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "卡里尔": 11
    },
    "talks": [
        {
            "talkId": "6440101",
            "initDialog": "644010101",
            "dialogues": [
                {
                    "id": "644010101",
                    "speaker": "卡里尔",
                    "text": "草木…即将枯萎…"
                },
                {
                    "id": "644010102",
                    "speaker": "卡里尔",
                    "text": "但他们不是在拯救…而是毁灭！"
                },
                {
                    "id": "644010103",
                    "speaker": "卡里尔",
                    "text": "神的灵知…神的灵知…救救…"
                }
            ]
        },
        {
            "talkId": "6440102",
            "initDialog": "644010201",
            "dialogues": [
                {
                    "id": "644010201",
                    "speaker": "Player",
                    "text": "（难以沟通，默默离开吧。）"
                },
                {
                    "id": "644010202",
                    "speaker": "卡里尔",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "6440103",
            "initDialog": "644010301",
            "dialogues": [
                {
                    "id": "644010301",
                    "speaker": "卡里尔",
                    "text": "你好，欢迎回到阿如村。"
                }
            ]
        },
        {
            "talkId": "6440104",
            "initDialog": "644010401",
            "dialogues": [
                {
                    "id": "644010401",
                    "speaker": "Player",
                    "text": "您认得我？"
                },
                {
                    "id": "644010402",
                    "speaker": "卡里尔",
                    "text": "呵呵，伊萨克不止一次和我提起你，所以我一眼就认出来了。"
                },
                {
                    "id": "644010403",
                    "speaker": "卡里尔",
                    "text": "我之前一直头脑混沌，还没正式向你道过谢，实在羞愧。多亏有你，我才能继续和伊萨克在这里生活。"
                },
                {
                    "id": "644010404",
                    "speaker": "卡里尔",
                    "text": "虽然有位叫塞塔蕾的小姐问过我要不要回教令院去，但我想了想，还是决定留在阿如村。"
                },
                {
                    "id": "644010405",
                    "speaker": "卡里尔",
                    "text": "一来是因为放心不下独自生活的伊萨克，二来阿如村帮过我许多，就这么离开的话，我心中也过意不去。"
                },
                {
                    "id": "644010406",
                    "speaker": "卡里尔",
                    "text": "我虽然年纪很大了，但毕竟以前是学者，应该也能为村子的发展尽些绵薄之力吧。"
                }
            ]
        },
        {
            "talkId": "6440105",
            "initDialog": "644010501",
            "dialogues": [
                {
                    "id": "644010501",
                    "speaker": "Player",
                    "text": "谢谢。"
                },
                {
                    "id": "644010502",
                    "speaker": "卡里尔",
                    "text": "慢走啊。"
                }
            ]
        }
    ]
}