{
    "groupId": "2071",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "逢岩": 15
    },
    "talks": [
        {
            "talkId": "7191901",
            "initDialog": "719190101",
            "dialogues": [
                {
                    "id": "719190101",
                    "speaker": "Player",
                    "text": "教头？"
                },
                {
                    "id": "719190102",
                    "speaker": "逢岩",
                    "text": "只是虚名罢了，在下的拳脚功夫比同僚好些，因此在军中负责给新兵传授拳法。"
                },
                {
                    "id": "719190103",
                    "speaker": "逢岩",
                    "text": "你的眼神…让我想起了曾经教过的一个士兵，本来他应该会接替我的位置…"
                },
                {
                    "id": "719190104",
                    "speaker": "逢岩",
                    "text": "…可后来他因为一场意外丧生了，我也再没机会在他升任教头那天，亲自为他佩戴上这朵胸花了…"
                },
                {
                    "id": "719190105",
                    "speaker": "逢岩",
                    "text": "不好意思，自说自话说了许多，这个送给你吧，也算是弥补了我的遗憾。"
                }
            ]
        },
        {
            "talkId": "6207101",
            "initDialog": "620710101",
            "dialogues": [
                {
                    "id": "620710101",
                    "speaker": "逢岩",
                    "text": "何事？请讲。"
                }
            ]
        },
        {
            "talkId": "6207102",
            "initDialog": "620710201",
            "dialogues": [
                {
                    "id": "620710201",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "620710202",
                    "speaker": "逢岩",
                    "text": "逢岩，千岩军的一员，位居教头。"
                }
            ]
        },
        {
            "talkId": "6207103",
            "initDialog": "620710301",
            "dialogues": [
                {
                    "id": "620710301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620710302",
                    "speaker": "逢岩",
                    "text": "保重。"
                }
            ]
        },
        {
            "talkId": "6207104",
            "initDialog": "620710401",
            "dialogues": [
                {
                    "id": "620710401",
                    "speaker": "Player",
                    "text": "关于千岩军。"
                },
                {
                    "id": "620710402",
                    "speaker": "逢岩",
                    "text": "「千岩牢固，重嶂不移。干城戎甲，靖妖闲邪」。"
                },
                {
                    "id": "620710403",
                    "speaker": "逢岩",
                    "text": "我们千岩军的前身，是千年前在魔神级的战争中活跃的「千岩团」。"
                },
                {
                    "id": "620710404",
                    "speaker": "逢岩",
                    "text": "如今确实没有什么「靖妖闲邪」的机会，可「千岩团」的意志一如磐石般延续下来。"
                },
                {
                    "id": "620710405",
                    "speaker": "逢岩",
                    "text": "即使平时一些兵士表现得有些散漫，但如果大敌当前，他们都会成为璃月最坚实的护盾。"
                }
            ]
        },
        {
            "talkId": "6207105",
            "initDialog": "620710501",
            "dialogues": [
                {
                    "id": "620710501",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "620710502",
                    "speaker": "逢岩",
                    "text": "我在倚岩殿这一带负责巡逻，这附近是「请仙典仪」的举办地，安全举措应该尤为注意。"
                },
                {
                    "id": "620710503",
                    "speaker": "逢岩",
                    "text": "我年幼时候也随父亲来参加过几次「请仙典仪」，就为了一睹岩王帝君的真容。"
                },
                {
                    "id": "620710504",
                    "speaker": "逢岩",
                    "text": "仪式上帝君的威严与神武令我十分震撼，甚至影响了我的一生…包括我的个性与人生道路的选择…"
                },
                {
                    "id": "620710505",
                    "speaker": "逢岩",
                    "text": "…唔，一不留神有些多言了。如果注意到什么异常状况，请随时告知我。"
                }
            ]
        }
    ]
}