{
    "groupId": "3416",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "涅斯捷洛娃": 7
    },
    "talks": [
        {
            "talkId": "6341601",
            "initDialog": "634160101",
            "dialogues": [
                {
                    "id": "634160101",
                    "speaker": "涅斯捷洛娃",
                    "text": "哦！您好…是新鲜的客人！"
                }
            ]
        },
        {
            "talkId": "6341602",
            "initDialog": "634160201",
            "dialogues": [
                {
                    "id": "634160201",
                    "speaker": "Player",
                    "text": "是的，今天刚打捞出来的！"
                },
                {
                    "id": "634160202",
                    "speaker": "涅斯捷洛娃",
                    "text": "哈哈哈真是幽默，抱歉，我说您新鲜是因为…我还没怎么看到过公馆外的人呢！"
                },
                {
                    "id": "634160203",
                    "speaker": "涅斯捷洛娃",
                    "text": "从小我就出生在公馆内，有好几次想要偷偷溜出去，都被哥哥姐姐们抓了回来…"
                },
                {
                    "id": "634160204",
                    "speaker": "涅斯捷洛娃",
                    "text": "所以真的有点好奇…"
                }
            ]
        },
        {
            "talkId": "6341603",
            "initDialog": "634160301",
            "dialogues": [
                {
                    "id": "634160301",
                    "speaker": "Player",
                    "text": "你们不能随意出这个公馆吗？"
                },
                {
                    "id": "634160302",
                    "speaker": "涅斯捷洛娃",
                    "text": "能倒是能，不过得帕芙琳娜大人许可…不过她已经很久没发出这种许可了…"
                }
            ]
        },
        {
            "talkId": "6341604",
            "initDialog": "634160401",
            "dialogues": [
                {
                    "id": "634160401",
                    "speaker": "Player",
                    "text": "好哦…"
                },
                {
                    "id": "634160402",
                    "speaker": "涅斯捷洛娃",
                    "text": "嘿嘿，客人，有空的时候，多和我说些外面的故事吧！"
                }
            ]
        },
        {
            "talkId": "6341605",
            "initDialog": "634160501",
            "dialogues": [
                {
                    "id": "634160501",
                    "speaker": "Player",
                    "text": "再见，新鲜的雪孃！"
                },
                {
                    "id": "634160502",
                    "speaker": "涅斯捷洛娃",
                    "text": "哈哈好吧，再见。如果有空的话请来聊聊天，客人！"
                }
            ]
        }
    ]
}