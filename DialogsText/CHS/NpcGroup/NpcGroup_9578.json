    "talks": [
        {
            "talkId": "6957801",
            "initDialog": "695780101",
            "dialogues": [
                {
                    "id": "695780101",
                    "speaker": "玛拉妮",
                    "text": "这里真热闹，这么多人都是来玩牌的？嗯…等我整理一下牌组，找几个人切磋一下！"
                }
            ]
        },
        {
            "talkId": "6957802",
            "initDialog": "695780201",
            "dialogues": [
                {
                    "id": "695780201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957803",
            "initDialog": "695780301",
            "dialogues": [
                {
                    "id": "695780301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695780302",
                    "speaker": "玛拉妮",
                    "text": "这就要走了？我还想再玩两把呢。唔…要是能见识到全新的战术就好了…"
                }
            ]
        },
        {
            "talkId": "6957804",
            "initDialog": "695780401",
            "dialogues": [
                {
                    "id": "695780401",
                    "speaker": "玛拉妮",
                    "text": "我赢啦！这款牌套的颜色，果然是好运款！"
                }
            ]
        },
        {
            "talkId": "6957805",
            "initDialog": "695780501",
            "dialogues": [
                {
                    "id": "695780501",
                    "speaker": "玛拉妮",
                    "text": "咦？难道我选错颜色了？这款牌套的配色，应该就是幸运款呀…"
                }
            ]
        },
        {
            "talkId": "6957806",
            "initDialog": "695780601",
            "dialogues": [
                {
                    "id": "695780601",
                    "speaker": "玛拉妮",
                    "text": "来吧，我的牌组可是很强的喔。"
                }
            ]
        },
        {
            "talkId": "6957808",
            "initDialog": "695780801",
            "dialogues": [
                {
                    "id": "695780801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957809",
            "initDialog": "695780901",
            "dialogues": [
                {
                    "id": "695780901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957810",
            "initDialog": "695781001",
            "dialogues": [
                {
                    "id": "695781001",
                    "speaker": "玛拉妮",
                    "text": "赢啦！嘿嘿，我玩得还不错吧？等会把我打牌的诀窍告诉你。"
                }
            ]
        },
        {
            "talkId": "6957811",
            "initDialog": "695781101",
            "dialogues": [
                {
                    "id": "695781101",
                    "speaker": "玛拉妮",
                    "text": "奇怪，之前和部族里的人打牌时，明明都能赢呀…"
                }
            ]
        },
        {
            "talkId": "6957812",
            "initDialog": "695781201",
            "dialogues": [
                {
                    "id": "695781201",
                    "speaker": "玛拉妮",
                    "text": "要玩牌么？快来快来，我都准备好啦。"
                }
            ]
        },
        {
            "talkId": "6957814",
            "initDialog": "695781401",
            "dialogues": [
                {
                    "id": "695781401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957815",
            "initDialog": "695781501",
            "dialogues": [
                {
                    "id": "695781501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957816",
            "initDialog": "695781601",
            "dialogues": [
                {
                    "id": "695781601",
                    "speaker": "玛拉妮",
                    "text": "是我赢啦！我今天的运势，果然还是很好嘛。"
                }
            ]
        },
        {
            "talkId": "6957817",
            "initDialog": "695781701",
            "dialogues": [
                {
                    "id": "695781701",
                    "speaker": "玛拉妮",
                    "text": "不对不对，难道今天不是我的幸运日？或者说…不是「卡牌游戏幸运日」…？"
                }
            ]
        },
        {
            "talkId": "6957818",
            "initDialog": "695781801",
            "dialogues": [
                {
                    "id": "695781801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}