{
    "groupId": "5045",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "缪妮": 12
    },
    "talks": [
        {
            "talkId": "6504501",
            "initDialog": "650450101",
            "dialogues": [
                {
                    "id": "650450101",
                    "speaker": "缪妮",
                    "text": "你好，你也是来高处看海的吗？"
                }
            ]
        },
        {
            "talkId": "6504502",
            "initDialog": "650450201",
            "dialogues": [
                {
                    "id": "650450201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "650450202",
                    "speaker": "缪妮",
                    "text": "我叫缪妮，叫我缪妮就好。"
                },
                {
                    "id": "650450203",
                    "speaker": "缪妮",
                    "text": "对不起，好像说了句重复的话，嘿嘿…"
                },
                {
                    "id": "650450204",
                    "speaker": "缪妮",
                    "text": "一看海，心中就会想到很多事，脑子也运转得慢了许多。"
                }
            ]
        },
        {
            "talkId": "6504503",
            "initDialog": "650450301",
            "dialogues": [
                {
                    "id": "650450301",
                    "speaker": "Player",
                    "text": "可以加入你吗？"
                },
                {
                    "id": "650450302",
                    "speaker": "缪妮",
                    "text": "欢迎，这里视野很好呢。"
                }
            ]
        },
        {
            "talkId": "6504504",
            "initDialog": "650450401",
            "dialogues": [
                {
                    "id": "650450401",
                    "speaker": "Player",
                    "text": "你在想什么？"
                },
                {
                    "id": "650450402",
                    "speaker": "缪妮",
                    "text": "什么都有哦。有时候越想越多，站得也越来越久。"
                },
                {
                    "id": "650450403",
                    "speaker": "缪妮",
                    "text": "有一次，那维莱特大人见我看着大海，也在我身旁驻足沉思。"
                },
                {
                    "id": "650450404",
                    "speaker": "缪妮",
                    "text": "然后渐渐地，我们后面站的人越来越多。"
                },
                {
                    "id": "650450405",
                    "speaker": "缪妮",
                    "text": "大家都踮着脚看向大海，小声议论着：「海上是发生了什么吗？」"
                },
                {
                    "id": "650450406",
                    "speaker": "缪妮",
                    "text": "人类真可爱呢。"
                },
                {
                    "id": "650450407",
                    "speaker": "缪妮",
                    "text": "其实，我那时思考的问题很简单，是大家每天都会考虑的事情——等会儿吃什么好呢？"
                }
            ]
        },
        {
            "talkId": "7491701",
            "initDialog": "749170101",
            "dialogues": [
                {
                    "id": "749170101",
                    "speaker": "Player",
                    "text": "我也开始思考了…"
                },
                {
                    "id": "749170102",
                    "speaker": "缪妮",
                    "text": "既然说到吃饭的话题，我就把这个送给你吧。这样，你就不需要烦恼了。"
                }
            ]
        }
    ]
}