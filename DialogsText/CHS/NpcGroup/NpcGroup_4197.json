{
    "groupId": "4197",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 5,
        "兰犍多": 11
    },
    "talks": [
        {
            "talkId": "6419701",
            "initDialog": "641970101",
            "dialogues": [
                {
                    "id": "641970101",
                    "speaker": "兰犍多",
                    "text": "兰犍多还没有和那菈比试过脚程…"
                }
            ]
        },
        {
            "talkId": "6419702",
            "initDialog": "641970201",
            "dialogues": [
                {
                    "id": "641970201",
                    "speaker": "Player",
                    "text": "关于无忧节…"
                },
                {
                    "id": "641970202",
                    "speaker": "兰犍多",
                    "text": "无忧节是快乐的节日，许多兰那罗会在桓那兰那跑来跑去，兰犍多要跑在最前面。"
                }
            ]
        },
        {
            "talkId": "6419703",
            "initDialog": "641970301",
            "dialogues": [
                {
                    "id": "641970301",
                    "speaker": "Player",
                    "text": "关于比试…"
                },
                {
                    "id": "641970302",
                    "speaker": "兰犍多",
                    "text": "我听兰拉娜说过，小那菈们也都喜欢比试脚程。"
                },
                {
                    "id": "641970303",
                    "speaker": "兰犍多",
                    "text": "不知道他们的脚程和兰犍多比起来，哪个慢，哪个快。"
                },
                {
                    "id": "641970304",
                    "speaker": "兰犍多",
                    "text": "那菈朋友进入桓那兰那，脚程也一定很好，等到无忧节的时候，来比试。"
                }
            ]
        },
        {
            "talkId": "6419704",
            "initDialog": "641970401",
            "dialogues": [
                {
                    "id": "641970401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641970402",
                    "speaker": "兰犍多",
                    "text": "再见，兰犍多继续跑来跑去。"
                }
            ]
        },
        {
            "talkId": "6419705",
            "initDialog": "641970501",
            "dialogues": [
                {
                    "id": "641970501",
                    "speaker": "兰犍多",
                    "text": "只要能够比试脚程，不管是赢还是不赢，兰犍多都很快乐。"
                }
            ]
        },
        {
            "talkId": "6419706",
            "initDialog": "641970601",
            "dialogues": [
                {
                    "id": "641970601",
                    "speaker": "Player",
                    "text": "关于比试…"
                },
                {
                    "id": "641970602",
                    "speaker": "兰犍多",
                    "text": "兰犍多想要和所有兰那罗比试，可是兰罗摩已经变成了觉王树，兰犍多一定能赢。"
                },
                {
                    "id": "641970603",
                    "speaker": "兰犍多",
                    "text": "不过，兰犍多也会回到沙恒，兰罗摩也会回到沙恒。到时候，我们就在沙恒中比试吧！"
                }
            ]
        },
        {
            "talkId": "6419707",
            "initDialog": "641970701",
            "dialogues": [
                {
                    "id": "641970701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641970702",
                    "speaker": "兰犍多",
                    "text": "#再见，那菈{NICKNAME}，愿你的脚程能够赢过所有那菈。"
                }
            ]
        },
        {
            "talkId": "6419708",
            "initDialog": "641970801",
            "dialogues": [
                {
                    "id": "641970801",
                    "speaker": "兰犍多",
                    "text": "无忧节这就结束了吗？时间真快！比兰犍多快得多！还想再和那菈朋友比试…"
                }
            ]
        }
    ]
}