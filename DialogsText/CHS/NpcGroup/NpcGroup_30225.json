{
    "groupId": "30225",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "贾米": 9
    },
    "talks": [
        {
            "talkId": "7365003",
            "initDialog": "736500301",
            "dialogues": [
                {
                    "id": "736500301",
                    "speaker": "贾米",
                    "text": "唉…早知如此，当初报考学院的时候就该去悉般多摩！"
                },
                {
                    "id": "736500302",
                    "speaker": "贾米",
                    "text": "#怎么了，{NICKNAME}，实验进展得还顺利吗…"
                }
            ]
        },
        {
            "talkId": "7365004",
            "initDialog": "736500401",
            "dialogues": [
                {
                    "id": "736500401",
                    "speaker": "Player",
                    "text": "关于导师…"
                },
                {
                    "id": "736500402",
                    "speaker": "贾米",
                    "text": "我的导师就是个混蛋，我已经决定了，这次研究要是能完成，我就拿着手稿站在他桌子上，用稿纸扇他的耳光！"
                },
                {
                    "id": "736500403",
                    "speaker": "贾米",
                    "text": "…虽然想这么说，但是我内心还是挺感激他的，他很严厉是没错啦，但说到底也是为了我们好…"
                }
            ]
        },
        {
            "talkId": "7365005",
            "initDialog": "736500501",
            "dialogues": [
                {
                    "id": "736500501",
                    "speaker": "Player",
                    "text": "关于「溢神剂」…"
                },
                {
                    "id": "736500502",
                    "speaker": "贾米",
                    "text": "没啦，只有给你的这么多，这个药剂做出来可麻烦了…"
                },
                {
                    "id": "736500503",
                    "speaker": "贾米",
                    "text": "我之前就觉得制药过程中是不是有两个步骤多余了，这次做的时候就把这两个步骤省略，结果成品似乎还变得更好了一点…"
                },
                {
                    "id": "736500504",
                    "speaker": "贾米",
                    "text": "咦，你说为什么不把这个当做发表报告的课题…咦，欸？？"
                },
                {
                    "id": "736500505",
                    "speaker": "贾米",
                    "text": "啊，可恶，可惜现在已经没有更换课题的余地了…"
                }
            ]
        },
        {
            "talkId": "7365006",
            "initDialog": "736500601",
            "dialogues": [
                {
                    "id": "736500601",
                    "speaker": "Player",
                    "text": "实验还在进行中…"
                },
                {
                    "id": "736500602",
                    "speaker": "贾米",
                    "text": "那就不打扰你了，加油啊！"
                }
            ]
        }
    ]
}