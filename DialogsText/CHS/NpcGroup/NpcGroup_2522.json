{
    "groupId": "2522",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "知贵": 10
    },
    "talks": [
        {
            "talkId": "6252201",
            "initDialog": "625220101",
            "dialogues": [
                {
                    "id": "625220101",
                    "speaker": "知贵",
                    "text": "工作越来越繁杂了，还是要谨慎应对啊…"
                },
                {
                    "id": "625220102",
                    "speaker": "知贵",
                    "text": "嗯？你好啊，欢迎欢迎！"
                }
            ]
        },
        {
            "talkId": "6252202",
            "initDialog": "625220201",
            "dialogues": [
                {
                    "id": "625220201",
                    "speaker": "Player",
                    "text": "在忙什么呢？"
                },
                {
                    "id": "625220202",
                    "speaker": "知贵",
                    "text": "多谢关心！简单说来，我是负责「和记厅」合辙驿与千岩军、茶庄和镖局等单位对接的员工。"
                },
                {
                    "id": "625220203",
                    "speaker": "知贵",
                    "text": "如果遇上了等待发镖的镖头，我就从合辙驿取单子来。"
                },
                {
                    "id": "625220204",
                    "speaker": "知贵",
                    "text": "如果遇上了茶庄派来确认茶叶运单的代表，我会引导对方去和港务人员详谈。"
                },
                {
                    "id": "625220205",
                    "speaker": "知贵",
                    "text": "如果是有大批货物需要运往海外的商人，需要先进行检查和登记，我就引导对方去合辙驿找专员…"
                }
            ]
        },
        {
            "talkId": "6252203",
            "initDialog": "625220301",
            "dialogues": [
                {
                    "id": "625220301",
                    "speaker": "Player",
                    "text": "那事还挺多的…"
                },
                {
                    "id": "625220302",
                    "speaker": "知贵",
                    "text": "没办法，毕竟遗珑埠的港口人来人往，总得有人协调对接各项事务，不然就容易乱套。"
                },
                {
                    "id": "625220303",
                    "speaker": "知贵",
                    "text": "有时嘉明回来了，我都没空带他去喝壶好茶…他自己也忙个没停。"
                },
                {
                    "id": "625220304",
                    "speaker": "知贵",
                    "text": "还好嘉明在本地朋友多，也不用我担心。"
                }
            ]
        },
        {
            "talkId": "6252204",
            "initDialog": "625220401",
            "dialogues": [
                {
                    "id": "625220401",
                    "speaker": "Player",
                    "text": "不打扰你了，再见！"
                },
                {
                    "id": "625220402",
                    "speaker": "知贵",
                    "text": "客气了，那就下次再见！"
                }
            ]
        }
    ]
}