{
    "groupId": "1521",
    "total_dialogue_lines": 43,
    "speaker_counts": {
        "Player": 10,
        "葛罗丽": 33
    },
    "talks": [
        {
            "talkId": "6152101",
            "initDialog": "615210101",
            "dialogues": [
                {
                    "id": "615210101",
                    "speaker": "葛罗丽",
                    "text": "没听过的嗓音呢…是外来的旅行者吗？"
                },
                {
                    "id": "615210102",
                    "speaker": "葛罗丽",
                    "text": "虽然我看不见，但有什么能帮忙的事可以说给我听。"
                }
            ]
        },
        {
            "talkId": "6152102",
            "initDialog": "615210201",
            "dialogues": [
                {
                    "id": "615210201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615210202",
                    "speaker": "葛罗丽",
                    "text": "啊…失礼了，应该先自我介绍的，我是葛罗丽。"
                },
                {
                    "id": "615210203",
                    "speaker": "葛罗丽",
                    "text": "我经常会在这里等古德温，祈祷他回来的路上能够避开那些缠人的丘丘人或者深渊教团…早日和我相聚。"
                },
                {
                    "id": "615210204",
                    "speaker": "葛罗丽",
                    "text": "啊我又在自说自话了…能有你陪我聊天，真是令人高兴。",
                    "choices": [
                        {
                            "id": "615210205",
                            "text": "古德温是？",
                            "response": [
                                {
                                    "id": "615210206",
                                    "speaker": "葛罗丽",
                                    "text": "是我的恋人，他跟随骑士团大团长法尔伽的远征队出城了。"
                                },
                                {
                                    "id": "615210207",
                                    "speaker": "葛罗丽",
                                    "text": "他离开的时候，我虽然有些舍不得，但能加入法尔伽大人的队伍始终是件值得为他高兴的事儿吧。"
                                },
                                {
                                    "id": "615210208",
                                    "speaker": "葛罗丽",
                                    "text": "…可惜我也不知道远征什么时候才结束，所以就只好这样等待了。"
                                }
                            ]
                        },
                        {
                            "id": "615210209",
                            "text": "关于丘丘人和深渊教团。",
                            "response": [
                                {
                                    "id": "615210210",
                                    "speaker": "葛罗丽",
                                    "text": "你也会觉得他们很烦吧？每天都在添麻烦的家伙们。"
                                },
                                {
                                    "id": "615210211",
                                    "speaker": "葛罗丽",
                                    "text": "听说大多数丘丘人是数百年前忽然出现在提瓦特的，深渊教团…好像也是差不多的时期。"
                                },
                                {
                                    "id": "615210212",
                                    "speaker": "葛罗丽",
                                    "text": "有人说是他们诞生于一场提瓦特的大灾难…可我更怀疑他们是从天空以外的地方来的…"
                                },
                                {
                                    "id": "615210213",
                                    "speaker": "葛罗丽",
                                    "text": "…唔抱歉，我因为看不见，所以经常会一个人想些无聊的事情，请不要在意。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6152103",
            "initDialog": "615210301",
            "dialogues": [
                {
                    "id": "615210301",
                    "speaker": "Player",
                    "text": "你的眼睛…会很不方便吗？"
                },
                {
                    "id": "615210302",
                    "speaker": "葛罗丽",
                    "text": "嗯…一开始确实是挺不习惯的。"
                },
                {
                    "id": "615210303",
                    "speaker": "葛罗丽",
                    "text": "但是看不到也让耳朵变得敏感，风从耳边掠过的时候，我就感觉我似乎也能「看见」一些东西…"
                },
                {
                    "id": "615210304",
                    "speaker": "葛罗丽",
                    "text": "自从信仰巴巴托斯之后，偶尔还会听到很温柔的声音在风中低语。"
                },
                {
                    "id": "615210305",
                    "speaker": "葛罗丽",
                    "text": "正如我的母亲葛瑞丝修女所说，果然蒙德是被风神护佑着的城市呢。"
                }
            ]
        },
        {
            "talkId": "6152104",
            "initDialog": "615210401",
            "dialogues": [
                {
                    "id": "615210401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615210402",
                    "speaker": "葛罗丽",
                    "text": "好的，再见。"
                },
                {
                    "id": "615210403",
                    "speaker": "葛罗丽",
                    "text": "希望你在蒙德过得愉快。"
                }
            ]
        },
        {
            "talkId": "6152105",
            "initDialog": "615210501",
            "dialogues": [
                {
                    "id": "615210501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "615210502",
                    "speaker": "葛罗丽",
                    "text": "我看不到蒙德城内龙灾出现后的具体情况，因此只能听别人跟我说发生了什么。"
                },
                {
                    "id": "615210503",
                    "speaker": "葛罗丽",
                    "text": "那段时间周围人的声音中总是带着忧愁，不过最近大家叹气的声音终于少了起来。"
                },
                {
                    "id": "615210504",
                    "speaker": "葛罗丽",
                    "text": "而蒙德的风，也终于平静下来了…"
                }
            ]
        },
        {
            "talkId": "6152106",
            "initDialog": "615210601",
            "dialogues": [
                {
                    "id": "615210601",
                    "speaker": "葛罗丽",
                    "text": "风神啊，请护佑古德温早日回来。"
                }
            ]
        },
        {
            "talkId": "6152107",
            "initDialog": "615210701",
            "dialogues": [
                {
                    "id": "615210701",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "615210702",
                    "speaker": "葛罗丽",
                    "text": "啊…失礼了。听这个嗓音…是旅行者吗？"
                },
                {
                    "id": "615210703",
                    "speaker": "葛罗丽",
                    "text": "我最近还是会在这里等古德温，祈祷他回来的路上能够避开那些缠人的丘丘人或者深渊教团…早日和我相聚。"
                },
                {
                    "id": "615210704",
                    "speaker": "葛罗丽",
                    "text": "啊我又在自说自话了…能有你陪我聊天，真是令人高兴。",
                    "choices": [
                        {
                            "id": "615210705",
                            "text": "关于古德温…",
                            "response": [
                                {
                                    "id": "615210706",
                                    "speaker": "葛罗丽",
                                    "text": "大团长法尔伽告诉我，古德温的「远征」还没有结束，他会在挪德卡莱继续自己的战斗…"
                                },
                                {
                                    "id": "615210707",
                                    "speaker": "葛罗丽",
                                    "text": "我最近收到了许多古德温的来信。他的信总是写得很长，就像是有什么话想说却说不出口，只能一直绕着那句话打转。"
                                },
                                {
                                    "id": "615210708",
                                    "speaker": "葛罗丽",
                                    "text": "…其实他不用说那么多，我也能明白他想说什么。你一定也体会过这种感觉吧？"
                                },
                                {
                                    "id": "615210709",
                                    "speaker": "Player",
                                    "text": "…嗯。我明白。"
                                },
                                {
                                    "id": "615210710",
                                    "speaker": "葛罗丽",
                                    "text": "所以我愿意相信…这一次，他会信守诺言的。"
                                }
                            ]
                        },
                        {
                            "id": "615210711",
                            "text": "关于丘丘人和深渊教团。",
                            "response": [
                                {
                                    "id": "615210712",
                                    "speaker": "葛罗丽",
                                    "text": "你也会觉得他们很烦吧？每天都在添麻烦的家伙们。"
                                },
                                {
                                    "id": "615210713",
                                    "speaker": "葛罗丽",
                                    "text": "听说大多数丘丘人是数百年前忽然出现在提瓦特的，深渊教团…好像也是差不多的时期。"
                                },
                                {
                                    "id": "615210714",
                                    "speaker": "葛罗丽",
                                    "text": "有人说是他们诞生于一场提瓦特的大灾难…可我更怀疑他们是从天空以外的地方来的…"
                                },
                                {
                                    "id": "615210715",
                                    "speaker": "葛罗丽",
                                    "text": "…唔抱歉，我因为看不见，所以经常会一个人想些无聊的事情，请不要在意。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}