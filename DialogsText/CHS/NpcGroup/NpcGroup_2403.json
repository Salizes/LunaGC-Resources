{
    "groupId": "2403",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "铁块儿": 17
    },
    "talks": [
        {
            "talkId": "6240306",
            "initDialog": "624030601",
            "dialogues": [
                {
                    "id": "624030601",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "624030602",
                    "speaker": "铁块儿",
                    "text": "啊，层岩巨渊的矿井还没完全开放，我这段时间没什么事做…"
                },
                {
                    "id": "624030603",
                    "speaker": "铁块儿",
                    "text": "所以就来跟这位姐姐学学天文，涨涨知识…"
                },
                {
                    "id": "624030604",
                    "speaker": "铁块儿",
                    "text": "你看…从这个角度看，多好看…"
                }
            ]
        },
        {
            "talkId": "7193401",
            "initDialog": "719340101",
            "dialogues": [
                {
                    "id": "719340101",
                    "speaker": "Player",
                    "text": "你说的不是星座吧。"
                },
                {
                    "id": "719340102",
                    "speaker": "铁块儿",
                    "text": "喂，你好烦啊！没看到我正在聚精会神地…观星吗！"
                },
                {
                    "id": "719340103",
                    "speaker": "铁块儿",
                    "text": "难道，你也想跟这位姐姐…咳咳，是跟这位姐姐学习天文学？"
                },
                {
                    "id": "719340104",
                    "speaker": "铁块儿",
                    "text": "去去去，先来后到懂不懂！真是的，这些矿石你拿走吧，别打扰我们看星星了！"
                }
            ]
        },
        {
            "talkId": "6240301",
            "initDialog": "624030101",
            "dialogues": [
                {
                    "id": "624030101",
                    "speaker": "铁块儿",
                    "text": "你好，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6240302",
            "initDialog": "624030201",
            "dialogues": [
                {
                    "id": "624030201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "624030202",
                    "speaker": "铁块儿",
                    "text": "啊，层岩巨渊的矿井被封锁了，我这段时间没什么事做…"
                },
                {
                    "id": "624030203",
                    "speaker": "铁块儿",
                    "text": "所以就来跟这位姐姐学学天文，涨涨知识…"
                },
                {
                    "id": "624030204",
                    "speaker": "铁块儿",
                    "text": "你看…从这个角度看，多好看…"
                }
            ]
        },
        {
            "talkId": "6240303",
            "initDialog": "624030301",
            "dialogues": [
                {
                    "id": "624030301",
                    "speaker": "Player",
                    "text": "…再见。"
                },
                {
                    "id": "624030302",
                    "speaker": "铁块儿",
                    "text": "再见，注意安全！"
                },
                {
                    "id": "624030303",
                    "speaker": "铁块儿",
                    "text": "…真好看啊…"
                }
            ]
        },
        {
            "talkId": "6240304",
            "initDialog": "624030205",
            "dialogues": [
                {
                    "id": "624030205",
                    "speaker": "Player",
                    "text": "你也喜欢观星吗？"
                },
                {
                    "id": "624030206",
                    "speaker": "铁块儿",
                    "text": "对啊，你别看我是个矿工，没学过多少知识…可我对天象的好奇不输于你！"
                },
                {
                    "id": "624030207",
                    "speaker": "铁块儿",
                    "text": "你看这个…玲珑有致，窈窕可爱…还有这个…真好啊…"
                }
            ]
        },
        {
            "talkId": "6240305",
            "initDialog": "624030208",
            "dialogues": [
                {
                    "id": "624030208",
                    "speaker": "Player",
                    "text": "你在说星座吗？"
                },
                {
                    "id": "624030209",
                    "speaker": "铁块儿",
                    "text": "不是，那星座谁看啊…"
                },
                {
                    "id": "624030210",
                    "speaker": "铁块儿",
                    "text": "啊，我是说，没错！看的就是星座！"
                },
                {
                    "id": "624030211",
                    "speaker": "铁块儿",
                    "text": "你看看那个「九天玄罗仙人漫天飞座」，它就是那个…它多像啊！"
                }
            ]
        }
    ]
}