    },
    "talks": [
        {
            "talkId": "6432401",
            "initDialog": "643240101",
            "dialogues": [
                {
                    "id": "643240101",
                    "speaker": "卡乌斯",
                    "text": "#{M#大哥哥}{F#大姐姐}，你什么时候有空呀，我还想听你讲故事！"
                }
            ]
        },
        {
            "talkId": "6432402",
            "initDialog": "643240201",
            "dialogues": [
                {
                    "id": "643240201",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643240202",
                    "speaker": "卡乌斯",
                    "text": "拉娜姐姐每次从森林里回来，都会给我们讲森林里的故事。不过比起森林，我还是更喜欢海里的故事…"
                },
                {
                    "id": "643240203",
                    "speaker": "卡乌斯",
                    "text": "我以后，一定要当一个了不起的大船长！"
                }
            ]
        },
        {
            "talkId": "6432403",
            "initDialog": "643240301",
            "dialogues": [
                {
                    "id": "643240301",
                    "speaker": "Player",
                    "text": "关于兰那罗…"
                },
                {
                    "id": "643240302",
                    "speaker": "卡乌斯",
                    "text": "#嗯…不行不行…这个我们说好了，不能告诉大人，就算是{M#大哥哥}{F#大姐姐}，也不能说。"
                }
            ]
        },
        {
            "talkId": "6432404",
            "initDialog": "643240401",
            "dialogues": [
                {
                    "id": "643240401",
                    "speaker": "Player",
                    "text": "关于大海蛇的故事…"
                },
                {
                    "id": "643240402",
                    "speaker": "卡乌斯",
                    "text": "#嗯嗯，{M#大哥哥}{F#大姐姐}故事里的大海蛇听上去真了不起，不过已经被人打倒了就没有办法了。"
                },
                {
                    "id": "643240403",
                    "speaker": "卡乌斯",
                    "text": "真不知道有没有其他的大海蛇…等到那个时候，就是船长卡乌斯出场的时候啦！"
                }
            ]
        },
        {
            "talkId": "6432405",
            "initDialog": "643240501",
            "dialogues": [
                {
                    "id": "643240501",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "643240502",
                    "speaker": "卡乌斯",
                    "text": "是嘛…"
                }
            ]
        },
        {
            "talkId": "6432406",
            "initDialog": "643240601",
            "dialogues": [
                {
                    "id": "643240601",
                    "speaker": "卡乌斯",
                    "text": "这次拉娜姐姐怎么出去了那么久，还没有回来呀…"
                }
            ]
        },
        {
            "talkId": "6432407",
            "initDialog": "643240701",
            "dialogues": [
                {
                    "id": "643240701",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643240702",
                    "speaker": "卡乌斯",
                    "text": "拉娜姐姐每次从森林里回来，都会给我们讲森林里的故事。不过比起森林，我还是更喜欢海里的故事…"
                },
                {
                    "id": "643240703",
                    "speaker": "卡乌斯",
                    "text": "我以后，一定要当一个了不起的大船长！"
                }
            ]
        },
        {
            "talkId": "6432408",
            "initDialog": "643240801",
            "dialogues": [
                {
                    "id": "643240801",
                    "speaker": "Player",
                    "text": "关于大海蛇的故事…"
                },
                {
                    "id": "643240802",
                    "speaker": "卡乌斯",
                    "text": "#嗯嗯，{M#大哥哥}{F#大姐姐}故事里的大海蛇听上去真了不起，不过已经被人打倒了就没有办法了。"
                },
                {
                    "id": "643240803",
                    "speaker": "卡乌斯",
                    "text": "真不知道有没有其他的大海蛇…等到那个时候，就是船长卡乌斯出场的时候啦！"
                }
            ]
        },
        {
            "talkId": "6432409",
            "initDialog": "643240901",
            "dialogues": [
                {
                    "id": "643240901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643240902",
                    "speaker": "卡乌斯",
                    "text": "嗯，记得经常来玩哦！"
                }
            ]
        },
        {
            "talkId": "6432410",
            "initDialog": "643241001",
            "dialogues": [
                {
                    "id": "643241001",
                    "speaker": "卡乌斯",
                    "text": "这次拉娜姐姐，还会回来吗…"
                }
            ]
        },
        {
            "talkId": "6432411",
            "initDialog": "643241101",
            "dialogues": [
                {
                    "id": "643241101",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643241102",
                    "speaker": "卡乌斯",
                    "text": "拉娜姐姐说她去旅行了，好像要离开很久，比之前还要久的样子…"
                },
                {
                    "id": "643241103",
                    "speaker": "卡乌斯",
                    "text": "不过，因为我比素达蓓和优丹大，所以我会代替拉娜姐姐照顾他们！"
                },
                {
                    "id": "643241104",
                    "speaker": "卡乌斯",
                    "text": "等拉娜姐姐回来了，我们就一起跟她玩！"
                }
            ]
        },
        {
            "talkId": "6432412",
            "initDialog": "643241201",
            "dialogues": [
                {
                    "id": "643241201",
                    "speaker": "Player",
                    "text": "关于兰那罗…"
                },
                {
                    "id": "643241202",
                    "speaker": "卡乌斯",
                    "text": "拉娜姐姐去旅行了，森林里的朋友也好久没见了…"
                }
            ]
        },
        {
            "talkId": "6432413",
            "initDialog": "643241301",
            "dialogues": [
                {
                    "id": "643241301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643241302",
                    "speaker": "卡乌斯",
                    "text": "#嗯，{M#大哥哥}{F#大姐姐}，要经常来维摩庄玩哦…"
                }
            ]
        },
        {
            "talkId": "7394801",
            "initDialog": "739480101",
            "dialogues": [
                {
                    "id": "739480101",
                    "speaker": "Player",
                    "text": "要好好照顾素达蓓和优丹哦。"
                },
                {
                    "id": "739480102",
                    "speaker": "卡乌斯",
                    "text": "嗯，我知道。我要当个好哥哥，不会丢下他们不管的！不然，拉娜姐姐肯定会批评我不好。"
                },
                {
                    "id": "739480103",
                    "speaker": "卡乌斯",
                    "text": "#不过，总有一天，我一定要成为最自由的船长卡乌斯，所以，最近我在和爸爸一起钓鱼。这些鱼送给{M#大哥哥}{F#大姐姐}！"
                },
                {
                    "id": "739480104",
                    "speaker": "卡乌斯",
                    "text": "#呃…对了，素达蓓最近好像说，为了快点长大，在自己学做饭。如果她给{M#大哥哥}{F#大姐姐}吃了奇怪的东西，嗯…拜托{M#大哥哥}{F#大姐姐}不要批评她！"
                }
            ]
        }
    ]
}