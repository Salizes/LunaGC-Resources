{
    "groupId": "7570",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "克利姆": 3,
        "扎列斯卡娅": 5
    },
    "talks": [
        {
            "talkId": "6757101",
            "initDialog": "675710101",
            "dialogues": [
                {
                    "id": "675710101",
                    "speaker": "扎列斯卡娅",
                    "text": "克利姆奇卡，我们差不多该回家了哦。外面这么冷，万一着凉了，又要吃那种苦苦的药了哦。"
                },
                {
                    "id": "675710102",
                    "speaker": "克利姆",
                    "text": "再等等嘛，妈妈。马上就好了！你看，有「雪人爸爸」陪着我呢！我一点都不冷！"
                },
                {
                    "id": "675710103",
                    "speaker": "扎列斯卡娅",
                    "text": "欸？原来这是爸爸呀？"
                },
                {
                    "id": "675710104",
                    "speaker": "克利姆",
                    "text": "对！明天我还要堆妈妈和我，这样我们家就能一直在一起了！"
                },
                {
                    "id": "675710105",
                    "speaker": "克利姆",
                    "text": "妈妈，你说…爸爸在下面能看到吗？"
                },
                {
                    "id": "675710106",
                    "speaker": "扎列斯卡娅",
                    "text": "唔，你说爸爸啊…我想他一定能看到的吧…"
                },
                {
                    "id": "675710107",
                    "speaker": "扎列斯卡娅",
                    "text": "毕竟那个混蛋今晚加完班，是一定会路过这里的。"
                },
                {
                    "id": "675710108",
                    "speaker": "扎列斯卡娅",
                    "text": "放心，如果他敢装作没看到…妈妈会揪着他的领子，把他一路拖过来看的，克利姆奇卡。"
                }
            ]
        }
    ]
}