{
    "groupId": "7057",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "奥梅索夫": 12
    },
    "talks": [
        {
            "talkId": "6705701",
            "initDialog": "670570101",
            "dialogues": [
                {
                    "id": "670570101",
                    "speaker": "奥梅索夫",
                    "text": "该不会是想在这里找工作吧？听我一句劝，还是快逃…"
                }
            ]
        },
        {
            "talkId": "6705702",
            "initDialog": "670570201",
            "dialogues": [
                {
                    "id": "670570201",
                    "speaker": "Player",
                    "text": "你是指「旗舰」的工作？"
                },
                {
                    "id": "670570202",
                    "speaker": "奥梅索夫",
                    "text": "啊不，我说的是「旗舰」里的愚人众招募官，那个叫克鲁切的家伙。他在里面招工，可千万别上当！"
                },
                {
                    "id": "670570203",
                    "speaker": "奥梅索夫",
                    "text": "这是我的切身经历，报酬低也就算了，我有朋友去了之后就失踪了，我再也没见过他们。"
                }
            ]
        },
        {
            "talkId": "6705703",
            "initDialog": "670570301",
            "dialogues": [
                {
                    "id": "670570301",
                    "speaker": "Player",
                    "text": "多谢提醒。"
                },
                {
                    "id": "670570302",
                    "speaker": "奥梅索夫",
                    "text": "愚人众！愚弄人！大家可千万别被骗了！"
                }
            ]
        },
        {
            "talkId": "6705704",
            "initDialog": "670570401",
            "dialogues": [
                {
                    "id": "670570401",
                    "speaker": "Player",
                    "text": "你之前干过？"
                },
                {
                    "id": "670570402",
                    "speaker": "奥梅索夫",
                    "text": "呃…嗯，虽然不是很想承认…当时我手头紧嘛，愚人众的摩拉也是摩拉，所以我就报名了。"
                },
                {
                    "id": "670570403",
                    "speaker": "奥梅索夫",
                    "text": "结果帮他们没日没夜干了整整一个月，就被他们以「违约」的名义开除了，竟然一个子儿都没有给我！"
                },
                {
                    "id": "670570404",
                    "speaker": "奥梅索夫",
                    "text": "唉！我还从来没被人开除过呢…感觉好丢脸…"
                }
            ]
        },
        {
            "talkId": "6705705",
            "initDialog": "670570501",
            "dialogues": [
                {
                    "id": "670570501",
                    "speaker": "Player",
                    "text": "已经是过去的事了，就别计较了。"
                },
                {
                    "id": "670570502",
                    "speaker": "奥梅索夫",
                    "text": "但我还是咽不下这口气，既然不发工钱给我，我可不能就这样算了。"
                },
                {
                    "id": "670570503",
                    "speaker": "奥梅索夫",
                    "text": "哼，只要有我在这里，他们就休想再骗人！"
                }
            ]
        },
        {
            "talkId": "6705706",
            "initDialog": "670570601",
            "dialogues": [
                {
                    "id": "670570601",
                    "speaker": "Player",
                    "text": "愚人众的资金很充裕，居然赖账？"
                },
                {
                    "id": "670570602",
                    "speaker": "奥梅索夫",
                    "text": "我也没想到。他们说我泄露了他们的机密——其实压根也不是什么机密，不就是试验设计局里藏有雷德·米勒的宝藏嘛！"
                },
                {
                    "id": "670570603",
                    "speaker": "奥梅索夫",
                    "text": "有可能是我喝多了的时候不小心说漏嘴的，我也不记得了。不过那之后，听说有不少宝藏猎人对雷德·米勒的宝藏打起了主意。"
                },
                {
                    "id": "670570604",
                    "speaker": "奥梅索夫",
                    "text": "好多人都试图闯进戒备森严的月矩力试验设计局，给愚人众他们造成了不少麻烦。嘿嘿，真是活该！"
                }
            ]
        }
    ]
}