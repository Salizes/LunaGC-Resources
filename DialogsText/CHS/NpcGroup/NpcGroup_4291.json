    },
    "talks": [
        {
            "talkId": "7318650",
            "initDialog": "731865001",
            "dialogues": [
                {
                    "id": "731865001",
                    "speaker": "芭别尔",
                    "text": "抱歉，部落事情繁杂…请问有什么事情吗？",
                    "choices": [
                        {
                            "id": "731865002",
                            "text": "关于叛徒…",
                            "response": [
                                {
                                    "id": "731865003",
                                    "speaker": "芭别尔",
                                    "text": "啊，真是丢人…让你看到了家贼作乱的麻烦。"
                                },
                                {
                                    "id": "731865004",
                                    "speaker": "芭别尔",
                                    "text": "不过请你放心，有婕德帮忙，阿德菲一定会很快束手就擒的。",
                                    "choices": [
                                        {
                                            "id": "731865005",
                                            "text": "阿德菲真的是叛徒吗…？",
                                            "response": [
                                                {
                                                    "id": "731865006",
                                                    "speaker": "芭别尔",
                                                    "text": "他已经玷污了部族的名字…这就意味着他忘记了母亲的名字，应当接受惩罚。"
                                                },
                                                {
                                                    "id": "731865007",
                                                    "speaker": "芭别尔",
                                                    "text": "就像国家、城邦一样，部族也需要严格的法度。我想你一定理解。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "731865008",
                                            "text": "我担心证据并不充分…",
                                            "response": [
                                                {
                                                    "id": "731865009",
                                                    "speaker": "芭别尔",
                                                    "text": "嗯…你是城里人，自然会更注重「证据」、「疑点」，我可以理解。"
                                                },
                                                {
                                                    "id": "731865010",
                                                    "speaker": "芭别尔",
                                                    "text": "但在塔尼特，他已经玷污了部族的名字…这就意味着他忘记了母亲的名字，应当接受惩罚。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "731865011",
                            "text": "关于婕德…",
                            "response": [
                                {
                                    "id": "731865012",
                                    "speaker": "芭别尔",
                                    "text": "婕德吗？她是个好孩子。在部落学得很快，也很能吃苦…从没见她抱怨过。"
                                },
                                {
                                    "id": "731865013",
                                    "speaker": "芭别尔",
                                    "text": "呵呵，说起来，塔尼特部族和她的父亲还有过一些小小的过节。真的是很遗憾…"
                                },
                                {
                                    "id": "731865014",
                                    "speaker": "芭别尔",
                                    "text": "但我很高兴婕德回来了，虽然那孩子的父亲…唉，这也算是迟来的和解吧。"
                                },
                                {
                                    "id": "731865015",
                                    "speaker": "芭别尔",
                                    "text": "那孩子也很喜欢你，我看得出来。"
                                },
                                {
                                    "id": "731865016",
                                    "speaker": "芭别尔",
                                    "text": "所以…请不要辜负她的友谊。"
                                }
                            ]
                        },
                        {
                            "id": "731865017",
                            "text": "关于阿萨里格…",
                            "response": [
                                {
                                    "id": "731865018",
                                    "speaker": "芭别尔",
                                    "text": "他是我的「儿子」，虽然不是亲生的…我很信赖他。"
                                },
                                {
                                    "id": "731865019",
                                    "speaker": "芭别尔",
                                    "text": "聪明，忠诚，强壮，道德上从不挑剔，又懂得讨好任何人。像狼一样，从来没有让我失望过。"
                                },
                                {
                                    "id": "731865020",
                                    "speaker": "芭别尔",
                                    "text": "只是可惜了…他是个男人。"
                                },
                                {
                                    "id": "731865021",
                                    "speaker": "芭别尔",
                                    "text": "如果他是个女人，或许就可以接替我的位子了吧…那样的话我也终于可以退休，带着孩子们去经营驮兽商队了。"
                                },
                                {
                                    "id": "731865022",
                                    "speaker": "芭别尔",
                                    "text": "呵呵…不过还好，我还有婕德。"
                                }
                            ]
                        },
                        {
                            "id": "731865023",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "731865024",
                                    "speaker": "芭别尔",
                                    "text": "再见，希望这次探险你们能够一路平安。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7322053",
            "initDialog": "732205301",
            "dialogues": [
                {
                    "id": "732205301",
                    "speaker": "芭别尔",
                    "text": "抱歉，部落事情繁杂…请问有什么事情吗？",
                    "choices": [
                        {
                            "id": "732205302",
                            "text": "关于叛徒…",
                            "response": [
                                {
                                    "id": "732205303",
                                    "speaker": "芭别尔",
                                    "text": "你是在说阿德菲和阿萨里格吗…真是让你看到了塔尼特不堪的一面…"
                                },
                                {
                                    "id": "732205304",
                                    "speaker": "芭别尔",
                                    "text": "他们和那些「北方人」接触得太久了，忘记了自己本来是塔尼特的子女，应该遵照部落的规矩成活。"
                                },
                                {
                                    "id": "732205305",
                                    "speaker": "芭别尔",
                                    "text": "但好在我还有婕德…她没有辜负我的期望。"
                                }
                            ]
                        },
                        {
                            "id": "732205306",
                            "text": "关于婕德…",
                            "response": [
                                {
                                    "id": "732205307",
                                    "speaker": "芭别尔",
                                    "text": "婕德吗？她是个好孩子。在部落学得很快，也很能吃苦…从没见她抱怨过。"
                                },
                                {
                                    "id": "732205308",
                                    "speaker": "芭别尔",
                                    "text": "呵呵，说起来，塔尼特部族和她的父亲还有过一些小小的过节。真的是很遗憾…"
                                },
                                {
                                    "id": "732205309",
                                    "speaker": "芭别尔",
                                    "text": "但我很高兴婕德回来了，虽然那孩子的父亲…唉，这也算是迟来的和解吧。"
                                },
                                {
                                    "id": "732205310",
                                    "speaker": "芭别尔",
                                    "text": "那孩子也很喜欢你，我看得出来。"
                                },
                                {
                                    "id": "732205311",
                                    "speaker": "芭别尔",
                                    "text": "所以…请不要辜负她的友谊。"
                                }
                            ]
                        },
                        {
                            "id": "732205312",
                            "text": "关于利露帕尔…",
                            "response": [
                                {
                                    "id": "732205313",
                                    "speaker": "芭别尔",
                                    "text": "尊贵的「镇灵之母」自然有她的看法，之前引起她的不快是因为我们的行事令她产生了误解…"
                                },
                                {
                                    "id": "732205314",
                                    "speaker": "芭别尔",
                                    "text": "但是要让沙漠复兴，要让土壤肥沃，要让部落的子民过上安定的生活，必须仰赖利露帕尔的垂青。"
                                },
                                {
                                    "id": "732205315",
                                    "speaker": "芭别尔",
                                    "text": "希望在这点上，我们最终能与她达成共识吧…"
                                }
                            ]
                        },
                        {
                            "id": "732205316",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "732205317",
                                    "speaker": "芭别尔",
                                    "text": "再见，希望这次探险你们能够一路平安。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7322057",
            "initDialog": "732205701",
            "dialogues": [
                {
                    "id": "732205701",
                    "speaker": "芭别尔",
                    "text": "#是你啊，{NICKNAME}，从探险中回来了吗？",
                    "choices": [
                        {
