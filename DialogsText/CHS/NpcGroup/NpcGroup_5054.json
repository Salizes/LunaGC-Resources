{
    "groupId": "5054",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "夏特莱": 10
    },
    "talks": [
        {
            "talkId": "6505401",
            "initDialog": "650540101",
            "dialogues": [
                {
                    "id": "650540101",
                    "speaker": "夏特莱",
                    "text": "一成不变的生活，搭配一如既往的咖啡…"
                }
            ]
        },
        {
            "talkId": "6505402",
            "initDialog": "650540201",
            "dialogues": [
                {
                    "id": "650540201",
                    "speaker": "Player",
                    "text": "听上去有些无聊。"
                },
                {
                    "id": "650540202",
                    "speaker": "夏特莱",
                    "text": "从工作的角度来讲，的确，那些琐事甚至没法成为谈资。"
                },
                {
                    "id": "650540203",
                    "speaker": "夏特莱",
                    "text": "我是沫芒宫的复律官，算是阿鲁埃店长的老同事吧。"
                },
                {
                    "id": "650540204",
                    "speaker": "夏特莱",
                    "text": "阿鲁埃的观点在办公室里有些偏激，但在咖啡厅里呢，只能算普通水准。"
                },
                {
                    "id": "650540205",
                    "speaker": "夏特莱",
                    "text": "我得说，他调制咖啡的手艺无可挑剔，辞职来开咖啡厅是他这辈子做过的最正确的决定之一了。"
                }
            ]
        },
        {
            "talkId": "6505403",
            "initDialog": "650540301",
            "dialogues": [
                {
                    "id": "650540301",
                    "speaker": "Player",
                    "text": "听上去有些安逸。"
                },
                {
                    "id": "650540302",
                    "speaker": "夏特莱",
                    "text": "没错。咖啡的香气十分美妙，我希望阿鲁埃调制咖啡的水平能够一直保持下去。"
                },
                {
                    "id": "650540303",
                    "speaker": "夏特莱",
                    "text": "但对于他常说的「咖啡才是生命之源」，我持保留意见。"
                },
                {
                    "id": "650540304",
                    "speaker": "夏特莱",
                    "text": "你知道，很多人并不真的享受咖啡的酸或苦，他们喝咖啡只是为了提神。"
                },
                {
                    "id": "650540305",
                    "speaker": "夏特莱",
                    "text": "我工作的地方已经在替很多人为他们无法控制的事做决定了，所以至少把对咖啡的意见留给他们吧。"
                }
            ]
        },
        {
            "talkId": "6505404",
            "initDialog": "650540401",
            "dialogues": [
                {
                    "id": "650540401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650540402",
                    "speaker": "夏特莱",
                    "text": "再见，祝你开心。"
                }
            ]
        }
    ]
}