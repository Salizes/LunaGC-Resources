{
    "groupId": "4095",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "达莉亚": 15
    },
    "talks": [
        {
            "talkId": "6409501",
            "initDialog": "640950101",
            "dialogues": [
                {
                    "id": "640950101",
                    "speaker": "达莉亚",
                    "text": "教令院得以不断发展的基础，难道不是对未来学者的培养吗…"
                },
                {
                    "id": "640950102",
                    "speaker": "达莉亚",
                    "text": "真要等到后继无人的时候，可就晚了，总不能真从那伽朱那团那里引进学者吧。"
                }
            ]
        },
        {
            "talkId": "6409502",
            "initDialog": "640950201",
            "dialogues": [
                {
                    "id": "640950201",
                    "speaker": "Player",
                    "text": "你是指…"
                },
                {
                    "id": "640950202",
                    "speaker": "达莉亚",
                    "text": "最近教令院削减了部分教育经费，让我有些不满。"
                },
                {
                    "id": "640950203",
                    "speaker": "达莉亚",
                    "text": "为了能够更好地发展科研，教令院会挖掘天资聪慧的孩子们早早入学。"
                },
                {
                    "id": "640950204",
                    "speaker": "达莉亚",
                    "text": "我是那些孩子们的导师，能指导这些小小的学生一路成长成材，让我感到非常快乐。"
                },
                {
                    "id": "640950205",
                    "speaker": "达莉亚",
                    "text": "但教令院如果一直削减教育经费的话，就势必会影响到孩子们的发展…"
                },
                {
                    "id": "640950206",
                    "speaker": "达莉亚",
                    "text": "哪怕是从培养未来学者的功利角度来看，我也觉得这样做是不对的。"
                }
            ]
        },
        {
            "talkId": "6409503",
            "initDialog": "640950301",
            "dialogues": [
                {
                    "id": "640950301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640950302",
                    "speaker": "达莉亚",
                    "text": "再见，总要有人提出反对的意见。"
                }
            ]
        },
        {
            "talkId": "6409504",
            "initDialog": "640950401",
            "dialogues": [
                {
                    "id": "640950401",
                    "speaker": "Player",
                    "text": "那伽朱那团？"
                },
                {
                    "id": "640950402",
                    "speaker": "达莉亚",
                    "text": "那伽朱那团是很久以前教令院的一个旁支学派。"
                },
                {
                    "id": "640950403",
                    "speaker": "达莉亚",
                    "text": "据说他们主张「为了守护知识的传承应当不惜身命啊」、「争战才是提瓦特秩序」之类的奇谈怪论。"
                },
                {
                    "id": "640950404",
                    "speaker": "达莉亚",
                    "text": "总之神神叨叨的，早就和其他学派分道扬镳，不在同一根枝桠上。"
                },
                {
                    "id": "640950405",
                    "speaker": "达莉亚",
                    "text": "虽然他们现在好像还存在于沙漠深处，不过一般人要么根本没听说过，要么当做荒诞不经的传说。"
                },
                {
                    "id": "640950406",
                    "speaker": "达莉亚",
                    "text": "所以我这只是气话，别当真，我相信教令院迟早会重视起孩子们的未来…"
                }
            ]
        },
        {
            "talkId": "7394101",
            "initDialog": "739410101",
            "dialogues": [
                {
                    "id": "739410101",
                    "speaker": "Player",
                    "text": "有什么解决办法吗？"
                },
                {
                    "id": "739410102",
                    "speaker": "达莉亚",
                    "text": "如果教令院执意继续削减经费的话，我就要直言进谏了。"
                },
                {
                    "id": "739410103",
                    "speaker": "达莉亚",
                    "text": "我和维克拉姆聊过，他也觉得，为了保证孩子们的学习条件，这是必须要做的事情。"
                }
            ]
        }
    ]
}