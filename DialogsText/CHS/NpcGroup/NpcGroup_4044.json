            "dialogues": [
                {
                    "id": "640440101",
                    "speaker": "法里德",
                    "text": "人多的地方，有时反而更安全。"
                }
            ]
        },
        {
            "talkId": "6404402",
            "initDialog": "640440201",
            "dialogues": [
                {
                    "id": "640440201",
                    "speaker": "Player",
                    "text": "你在巡逻？"
                },
                {
                    "id": "640440202",
                    "speaker": "法里德",
                    "text": "对啊，巡逻是我的工作嘛。"
                },
                {
                    "id": "640440203",
                    "speaker": "法里德",
                    "text": "这附近没什么危险，可以放心大胆地走。"
                },
                {
                    "id": "640440204",
                    "speaker": "法里德",
                    "text": "不过，也不一定。前几天，有两帮学者不知道为了什么，打了群架，我差点被卷进去。"
                },
                {
                    "id": "640440205",
                    "speaker": "法里德",
                    "text": "可见哪怕是须弥城里，面对着看起来温和的学者们，也有可能遇到危险，需要时刻警惕才是。"
                }
            ]
        },
        {
            "talkId": "6404403",
            "initDialog": "640440301",
            "dialogues": [
                {
                    "id": "640440301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640440302",
                    "speaker": "法里德",
                    "text": "再见。"
                }
            ]
        }
    ]
