{
    "groupId": "9024",
    "total_dialogue_lines": 61,
    "speaker_counts": {
        "Player": 15,
        "北斗": 46
    },
    "talks": [
        {
            "talkId": "6902401",
            "initDialog": "690240101",
            "dialogues": [
                {
                    "id": "690240101",
                    "speaker": "北斗",
                    "text": "#哟！是你啊，{NICKNAME}。"
                },
                {
                    "id": "690240102",
                    "speaker": "北斗",
                    "text": "身子骨还硬朗着吗？"
                }
            ]
        },
        {
            "talkId": "6902402",
            "initDialog": "690240201",
            "dialogues": [
                {
                    "id": "690240201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690240202",
                    "speaker": "北斗",
                    "text": "挺好挺好！来这种鸟语花香的地方坐坐也不错！"
                },
                {
                    "id": "690240203",
                    "speaker": "北斗",
                    "text": "不过嘛…",
                    "choices": [
                        {
                            "id": "690240204",
                            "text": "不过？",
                            "response": [
                                {
                                    "id": "690240205",
                                    "speaker": "北斗",
                                    "text": "不过你也知道，还是大海的波涛更适合我！"
                                },
                                {
                                    "id": "690240206",
                                    "speaker": "北斗",
                                    "text": "翻腾的海浪才是这世上最好的摇篮曲。"
                                },
                                {
                                    "id": "690240210",
                                    "speaker": "北斗",
                                    "text": "哦，你别误会，你请我来我很开心。"
                                },
                                {
                                    "id": "690240211",
                                    "speaker": "北斗",
                                    "text": "有来有往，下次就该轮到你到我的船上做客了！"
                                }
                            ]
                        },
                        {
                            "id": "690240207",
                            "text": "还是想念航海的日子？",
                            "response": [
                                {
                                    "id": "690240208",
                                    "speaker": "北斗",
                                    "text": "哈哈！还是你懂我！"
                                },
                                {
                                    "id": "690240209",
                                    "speaker": "北斗",
                                    "text": "那种穿越风暴、征服巨浪的日子才叫一个痛快啊！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902403",
            "initDialog": "690240301",
            "dialogues": [
                {
                    "id": "690240301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690240302",
                    "speaker": "北斗",
                    "text": "好啊！想聊什么都行！"
                },
                {
                    "id": "690240303",
                    "speaker": "北斗",
                    "text": "不过，我海上的故事你恐怕都从别人那儿听烦了吧？"
                },
                {
                    "id": "690240304",
                    "speaker": "北斗",
                    "text": "不如咱们换换，说说你的冒险故事吧！",
                    "choices": [
                        {
                            "id": "690240305",
                            "text": "嗯…我打过龙哟。",
                            "response": [
                                {
                                    "id": "690240306",
                                    "speaker": "北斗",
                                    "text": "哟，可以呀！那龙多大？"
                                },
                                {
                                    "id": "690240308",
                                    "speaker": "北斗",
                                    "text": "啧啧啧，厉害呀！"
                                },
                                {
                                    "id": "690240309",
                                    "speaker": "北斗",
                                    "text": "我揍过海里的，你打过天上的。"
                                },
                                {
                                    "id": "690240310",
                                    "speaker": "北斗",
                                    "text": "咱们一起出去冒险，那岂不所向披靡了！"
                                },
                                {
                                    "id": "690240311",
                                    "speaker": "Player",
                                    "text": "我基本都是在打丘丘人…"
                                },
                                {
                                    "id": "690240312",
                                    "speaker": "北斗",
                                    "text": "丘丘人怎么了？我在海上想见还见不到一只呢！"
                                },
                                {
                                    "id": "690240313",
                                    "speaker": "北斗",
                                    "text": "冒险不在于你遇到了多少风浪，而在于你知道还有更多未知的风浪在等着你！"
                                },
                                {
                                    "id": "690240314",
                                    "speaker": "北斗",
                                    "text": "嚯，我好像说了句了不起的话嘛。"
                                },
                                {
                                    "id": "690240315",
                                    "speaker": "北斗",
                                    "text": "哈哈哈！快活！值得为这个干上一杯！"
                                }
                            ]
                        },
                        {
                            "id": "690240307",
                            "text": "大概比北斗的船还大。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902404",
            "initDialog": "690240401",
            "dialogues": [
                {
                    "id": "690240401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690240402",
                    "speaker": "北斗",
                    "text": "那还用问？当然是想带你一起出海冒险喽！"
                },
                {
                    "id": "690240403",
                    "speaker": "北斗",
                    "text": "你要是对掌舵有兴趣，我也可以教你。"
                },
                {
                    "id": "690240404",
                    "speaker": "北斗",
                    "text": "要知道，海上的每个浪花都不会打出第二次…"
                },
                {
                    "id": "690240405",
                    "speaker": "北斗",
                    "text": "不趁你有空的时候多带你到处转转，那岂不是太浪费了。",
                    "choices": [
                        {
                            "id": "690240406",
                            "text": "我需要做些准备。",
                            "response": [
                                {
                                    "id": "690240407",
                                    "speaker": "北斗",
                                    "text": "行啊，一句话的事。"
                                },
                                {
                                    "id": "690240408",
                                    "speaker": "北斗",
                                    "text": "哦…如果你有什么事要办的话，你就忙完再叫我。"
                                },
                                {
                                    "id": "690240409",
                                    "speaker": "北斗",
                                    "text": "这出船一趟就是一年半载的，没个定数。"
                                },
                                {
                                    "id": "690240410",
                                    "speaker": "北斗",
                                    "text": "还是把该结的事都结了再走的好！"
                                },
                                {
                                    "id": "690240416",
                                    "speaker": "北斗",
                                    "text": "等你准备好了咱就选个日子出发吧！"
                                },
                                {
                                    "id": "690240417",
                                    "speaker": "北斗",
                                    "text": "和你一起征服大海的景象，我都等不及了！"
                                }
                            ]
                        },
                        {
                            "id": "690240411",
                            "text": "我担心自己会晕船。",
                            "response": [
                                {
                                    "id": "690240412",
                                    "speaker": "北斗",
                                    "text": "不用怕，别有什么心理负担。"
                                },
                                {
                                    "id": "690240413",
                                    "speaker": "北斗",
                                    "text": "晕船这个事得先多适应一下。真要不行，我这还有药草。"
                                },
                                {
                                    "id": "690240414",
                                    "speaker": "北斗",
                                    "text": "我给你打包票没问题，你就放心了吧。"
                                },
                                {
                                    "id": "690240415",
                                    "speaker": "北斗",
                                    "text": "因为这个就错过了海上风光，那简直是人生一大憾事！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902405",
            "initDialog": "690240501",
            "dialogues": [
                {
                    "id": "690240501",
                    "speaker": "Player",
                    "text": "早啊，北斗。"
                },
                {
                    "id": "690240502",
                    "speaker": "北斗",
                    "text": "嗯，气势不错，还算有干劲。"
                },
                {
                    "id": "690240503",
                    "speaker": "北斗",
                    "text": "#早，{NICKNAME}，好好干啊。"
                }
            ]
        },
        {
            "talkId": "6902406",
            "initDialog": "690240601",
            "dialogues": [
                {
                    "id": "690240601",
                    "speaker": "Player",
                    "text": "晚安，北斗。"
                },
                {
                    "id": "690240602",
                    "speaker": "北斗",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690240603",
                    "speaker": "北斗",
                    "text": "脑袋里少想点事情，休息得好点。"
                },
                {
                    "id": "690240604",
                    "speaker": "北斗",
                    "text": "改天见啊。"
                }
            ]
        },
        {
            "talkId": "6902407",
            "initDialog": "690240701",
            "dialogues": [
                {
                    "id": "690240701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6902408",
            "initDialog": "690240801",
            "dialogues": [
                {
                    "id": "690240801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6902409",
            "initDialog": "690240901",
            "dialogues": [
                {
                    "id": "690240901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6902450",
            "initDialog": "690245001",
            "dialogues": [
                {
                    "id": "690245001",
                    "speaker": "北斗",
                    "text": "有这么好的地方怎么不早告诉我。"
                },
                {
                    "id": "690245002",
                    "speaker": "北斗",
                    "text": "哈哈哈，既有好酒，又有新鲜的吃食，畅快！"
                },
                {
                    "id": "690245003",
                    "speaker": "北斗",
                    "text": "你也一起来点吧？再跟我聊聊你的冒险故事。"
                }
            ]
        },
        {
            "talkId": "6902451",
            "initDialog": "690245101",
            "dialogues": [
                {
                    "id": "690245101",
                    "speaker": "北斗",
                    "text": "虽然粗糙了点，但是武器和场地应有尽有。"
                },
                {
                    "id": "690245102",
                    "speaker": "北斗",
                    "text": "在这儿活动筋骨，不用担心施展不开了。"
                },
                {
                    "id": "690245103",
                    "speaker": "北斗",
                    "text": "这地方不错，我喜欢。"
                }
            ]
        }
    ]
}