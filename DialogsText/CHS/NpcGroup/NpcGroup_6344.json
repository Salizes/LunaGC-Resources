        {
            "talkId": "6634401",
            "initDialog": "663440101",
            "dialogues": [
                {
                    "id": "663440101",
                    "speaker": "？？？",
                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，你们好啊…",
                    "choices": [
                        {
                            "id": "663440102",
                            "text": "怎么无精打采的？",
                            "response": [
                                {
                                    "id": "663440103",
                                    "speaker": "？？？",
                                    "text": "其实…相比之前，温泉的水温好像还是有点冷…这次我闯了好大的祸，回去以后该怎么办啊…"
                                },
                                {
                                    "id": "663440104",
                                    "speaker": "Player",
                                    "text": "别担心，再等等看。"
                                },
                                {
                                    "id": "663440105",
                                    "speaker": "？？？",
                                    "text": "嗯，我知道了…"
                                }
                            ]
                        },
                        {
                            "id": "663440106",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "663440107",
                                    "speaker": "？？？",
                                    "text": "#唔…路上小心，{NICKNAME}{M#哥哥}{F#姐姐}。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6634402",
            "initDialog": "663440201",
            "dialogues": [
                {
                    "id": "663440201",
                    "speaker": "？？？",
                    "text": "#是{NICKNAME}{M#哥哥}{F#姐姐}！嘿嘿，好久不见啊！你们还好吗？",
                    "choices": [
                        {
                            "id": "663440202",
                            "text": "发生什么好事了？",
                            "response": [
                                {
                                    "id": "663440203",
                                    "speaker": "？？？",
                                    "text": "嘿嘿，偷偷告诉你哦，我发现温泉的水温恢复正常了！这下好啦，小鳍游龙们可以开心地玩耍，我也不用提心吊胆了！"
                                },
                                {
                                    "id": "663440204",
                                    "speaker": "？？？",
                                    "text": "接下来我要开开心心地玩！好好享受温泉和火山！"
                                },
                                {
                                    "id": "663440205",
                                    "speaker": "Player",
                                    "text": "祝你开心！"
                                },
                                {
                                    "id": "663440206",
                                    "speaker": "？？？",
                                    "text": "#嗯嗯，{NICKNAME}{M#哥哥}{F#姐姐}也要开心哦！"
                                }
                            ]
                        },
                        {
                            "id": "663440207",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "663440208",
                                    "speaker": "？？？",
                                    "text": "#{NICKNAME}{M#哥哥}{F#姐姐}，一路顺风！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}