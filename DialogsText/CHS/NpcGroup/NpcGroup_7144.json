    "talks": [
        {
            "talkId": "6714401",
            "initDialog": "671440101",
            "dialogues": [
                {
                    "id": "671440101",
                    "speaker": "字迹幼稚的告示",
                    "text": "「拨动转盘，转盘停下的时候，『热狗』就会算出你今天的运势啦。」"
                }
            ]
        },
        {
            "talkId": "6714402",
            "initDialog": "671440201",
            "dialogues": [
                {
                    "id": "671440201",
                    "speaker": "Player",
                    "text": "（拨动转盘。）"
                },
                {
                    "id": "671440202",
                    "speaker": "今日运势",
                    "text": "「『牝鹿引路，旅途顺利。』\\n就是今天不管做什么都会很顺利的意思！」"
                }
            ]
        },
        {
            "talkId": "6714403",
            "initDialog": "671440301",
            "dialogues": [
                {
                    "id": "671440301",
                    "speaker": "Player",
                    "text": "（拨动转盘。）"
                },
                {
                    "id": "671440302",
                    "speaker": "今日运势",
                    "text": "「『晨露凝珠，浆果丰盛。』\\n就是今天会有收获的意思！」"
                }
            ]
        },
        {
            "talkId": "6714404",
            "initDialog": "671440401",
            "dialogues": [
                {
                    "id": "671440401",
                    "speaker": "Player",
                    "text": "（拨动转盘。）"
                },
                {
                    "id": "671440402",
                    "speaker": "今日运势",
                    "text": "「『灯火长明，指引前路。』\\n就是之前不知道该怎么办的事今天会找到出路的意思！」"
                }
            ]
        },
        {
            "talkId": "6714405",
            "initDialog": "671440501",
            "dialogues": [
                {
                    "id": "671440501",
                    "speaker": "Player",
                    "text": "（拨动转盘。）"
                },
                {
                    "id": "671440502",
                    "speaker": "今日运势",
                    "text": "「『旭日曈曈，驱散迷雾。』\\n就是遇到困难也没关系，一定会得到帮助的意思！」"
                }
            ]
        },
        {
            "talkId": "6714406",
            "initDialog": "671440601",
            "dialogues": [
                {
                    "id": "671440601",
                    "speaker": "Player",
                    "text": "（拨动转盘。）"
                },
                {
                    "id": "671440602",
                    "speaker": "今日运势",
                    "text": "「『层云蔽月，大地沉睡。』\\n就是现在不是好时机，条件还没有凑齐的意思。」"
                }
            ]
        },
        {
            "talkId": "6714407",
            "initDialog": "671440701",
            "dialogues": [
                {
                    "id": "671440701",
                    "speaker": "Player",
                    "text": "（拨动转盘。）"
                },
                {
                    "id": "671440702",
                    "speaker": "今日运势",
                    "text": "「『海蛇翻腾，风暴肆虐。』\\n就是不管做什么都会遇到阻碍的意思。」"
                }
            ]
        },
        {
            "talkId": "6714408",
            "initDialog": "671440801",
            "dialogues": [
                {
                    "id": "671440801",
                    "speaker": "Player",
                    "text": "（拨动转盘。）"
                },
                {
                    "id": "671440802",
                    "speaker": "今日运势",
                    "text": "「『林狼啸月，魔物环伺。』\\n就是要小心有人给你使绊子的意思。」"
                }
            ]
        },
        {
            "talkId": "6714409",
            "initDialog": "671440901",
            "dialogues": [
                {
                    "id": "671440901",
                    "speaker": "Player",
                    "text": "（拨动转盘。）"
                },
                {
                    "id": "671440902",
                    "speaker": "今日运势",
                    "text": "「『雷鸣风骤，摧枯拉朽。』\\n就是之前的成果有可能被糟蹋掉的意思。」"
                }
            ]
        },
        {
            "talkId": "6714410",
            "initDialog": "671441001",
            "dialogues": [
                {
                    "id": "671441001",
                    "speaker": "Player",
                    "text": "（继续读…）"
                },
                {
                    "id": "671441002",
                    "speaker": "字迹幼稚的告示",
                    "text": "「卡嘉说，不用一定得是客人才能玩转盘，哪怕只是路过，都可以转一下试试看的。」"
                },
                {
                    "id": "671441003",
                    "speaker": "字迹幼稚的告示",
                    "text": "「但是这里的东西都是『斯佩兰扎』的，不要随便拿走，有巴甫洛夫帮我们看着呢！」"
                }
            ]
        },
        {
            "talkId": "6714415",
            "initDialog": "671441501",
            "dialogues": [
                {
                    "id": "671441501",
                    "speaker": "Player",
                    "text": "（还是离开吧。）"
                }
            ]
        }
    ]
}