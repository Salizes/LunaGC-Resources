{
    "groupId": "21846",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "恰斯卡": 8
    },
    "talks": [
        {
            "talkId": "1504452",
            "initDialog": "150445201",
            "dialogues": [
                {
                    "id": "150445201",
                    "speaker": "恰斯卡",
                    "text": "放在以前，「游乐」这词对我来说意味着刺激与挑战…"
                },
                {
                    "id": "150445202",
                    "speaker": "恰斯卡",
                    "text": "但像现在这样安安稳稳地度过游乐时光也不错…"
                }
            ]
        },
        {
            "talkId": "1504552",
            "initDialog": "150455201",
            "dialogues": [
                {
                    "id": "150455201",
                    "speaker": "恰斯卡",
                    "text": "有兴趣再来点「争斗」吗？"
                }
            ]
        },
        {
            "talkId": "1504583",
            "initDialog": "150458301",
            "dialogues": [
                {
                    "id": "150458301",
                    "speaker": "Player",
                    "text": "不如帮你拍张照？"
                },
                {
                    "id": "150458302",
                    "speaker": "恰斯卡",
                    "text": "好，那就这样。"
                },
                {
                    "id": "150458303",
                    "speaker": "恰斯卡",
                    "text": "本来想拿去送给「妈妈」，但她看到只怕要举起翅膀，问我留画片算什么意思，怎么平时不多去看看她…"
                },
                {
                    "id": "150458304",
                    "speaker": "恰斯卡",
                    "text": "我还是自己留作纪念吧。"
                }
            ]
        },
        {
            "talkId": "1504584",
            "initDialog": "150458401",
            "dialogues": [
                {
                    "id": "150458401",
                    "speaker": "Player",
                    "text": "求之不得。"
                },
                {
                    "id": "150458402",
                    "speaker": "恰斯卡",
                    "text": "不错。让我们全力以赴吧。"
                }
            ]
        },
        {
            "talkId": "1504585",
            "initDialog": "150458501",
            "dialogues": [
                {
                    "id": "150458501",
                    "speaker": "Player",
                    "text": "或许下次？"
                },
                {
                    "id": "150458502",
                    "speaker": "恰斯卡",
                    "text": "好，有时间再说。"
                }
            ]
        }
    ]
}