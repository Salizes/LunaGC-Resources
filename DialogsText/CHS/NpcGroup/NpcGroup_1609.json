{
    "groupId": "1609",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "玛拉": 4,
        "玛文": 5
    },
    "talks": [
        {
            "talkId": "6160901",
            "initDialog": "616090101",
            "dialogues": [
                {
                    "id": "616090101",
                    "speaker": "玛文",
                    "text": "你果然又来了，我亲爱的玛拉。"
                },
                {
                    "id": "616090102",
                    "speaker": "玛拉",
                    "text": "哦，玛文！我怎么可能弃你不顾，不管你的父亲怎么看待我们的事，我的爱…都好像清泉镇源头上的坚冰…"
                },
                {
                    "id": "616090103",
                    "speaker": "玛文",
                    "text": "不，玛拉，你的爱不应该那样冰冷啊…"
                },
                {
                    "id": "616090104",
                    "speaker": "玛拉",
                    "text": "不，我是说，我的爱会化作甘冽的泉水滋润着你，不论千年…还是万年…"
                },
                {
                    "id": "616090105",
                    "speaker": "玛文",
                    "text": "哦，玛拉！那我对你的爱，就像鹰翔海滩上猎鹰的双眸…"
                },
                {
                    "id": "616090106",
                    "speaker": "玛拉",
                    "text": "不，玛文，你的爱不应该那样冷酷无情啊…"
                },
                {
                    "id": "616090107",
                    "speaker": "玛文",
                    "text": "不，我是说，哪怕片刻我都不愿你从我的视野中消失，若是谁要将你夺走，我定会让他尝尝我的尖爪与利喙…"
                },
                {
                    "id": "616090108",
                    "speaker": "玛拉",
                    "text": "哦，玛文！"
                },
                {
                    "id": "616090109",
                    "speaker": "玛文",
                    "text": "哦，玛拉！"
                }
            ]
        }
    ]
}