{
    "groupId": "9091",
    "total_dialogue_lines": 63,
    "speaker_counts": {
        "Player": 16,
        "娜维娅": 47
    },
    "talks": [
        {
            "talkId": "6909101",
            "initDialog": "690910101",
            "dialogues": [
                {
                    "id": "690910101",
                    "speaker": "娜维娅",
                    "text": "哎呀呀，你好啊！"
                },
                {
                    "id": "690910102",
                    "speaker": "娜维娅",
                    "text": "这地方真不错，你和派蒙两个人住这么大的地方吗？会不会有点太空了，我可以经常来玩吗？"
                }
            ]
        },
        {
            "talkId": "6909102",
            "initDialog": "690910201",
            "dialogues": [
                {
                    "id": "690910201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690910202",
                    "speaker": "娜维娅",
                    "text": "很不错，我喜欢这里。"
                },
                {
                    "id": "690910203",
                    "speaker": "娜维娅",
                    "text": "风景好，室内布设也很有品味，不愧是你家。"
                },
                {
                    "id": "690910204",
                    "speaker": "Player",
                    "text": "跟你家比还是差了一点。"
                },
                {
                    "id": "690910205",
                    "speaker": "娜维娅",
                    "text": "哪有，不可以这么说哦。"
                },
                {
                    "id": "690910206",
                    "speaker": "娜维娅",
                    "text": "人们家里总是会留下只有主人才能布置出的感觉，来别人家看的不是别的，是性格。"
                },
                {
                    "id": "690910207",
                    "speaker": "娜维娅",
                    "text": "嗯嗯，我概括得真好。对，就是性格！"
                },
                {
                    "id": "690910208",
                    "speaker": "娜维娅",
                    "text": "好比这里…嗯，能感觉到呢，是你和派蒙的家。",
                    "choices": [
                        {
                            "id": "690910209",
                            "text": "你喜欢什么风格的家？",
                            "response": [
                                {
                                    "id": "690910210",
                                    "speaker": "娜维娅",
                                    "text": "唔…温馨实用就好？我才没有那么挑剔啦。"
                                },
                                {
                                    "id": "690910211",
                                    "speaker": "娜维娅",
                                    "text": "我家的布置很多都是迈勒斯安排的，我喜欢那种感觉。一旦习惯，就很难突然变更布设了。"
                                }
                            ]
                        },
                        {
                            "id": "690910212",
                            "text": "喜欢这里的话，请务必常来！",
                            "response": [
                                {
                                    "id": "690910213",
                                    "speaker": "娜维娅",
                                    "text": "真的？我真的会经常来哦？没问题吧？"
                                },
                                {
                                    "id": "690910214",
                                    "speaker": "娜维娅",
                                    "text": "放心，我会带点心来的，手工饼干，小蛋糕…你喜欢哪种都可以。"
                                },
                                {
                                    "id": "690910215",
                                    "speaker": "娜维娅",
                                    "text": "派蒙的份也一起！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909103",
            "initDialog": "690910301",
            "dialogues": [
                {
                    "id": "690910301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690910302",
                    "speaker": "娜维娅",
                    "text": "当然啦，来这里就是找你们玩的嘛。"
                },
                {
                    "id": "690910303",
                    "speaker": "娜维娅",
                    "text": "嗯~从什么开始呢？你最近有感兴趣的事吗？"
                },
                {
                    "id": "690910304",
                    "speaker": "Player",
                    "text": "或许我们可以聊聊帽子？"
                },
                {
                    "id": "690910305",
                    "speaker": "娜维娅",
                    "text": "啊，说到这个，你可以考虑买顶帽子。"
                },
                {
                    "id": "690910306",
                    "speaker": "娜维娅",
                    "text": "倒不是因为在外旅行需要遮风挡雨之类的原因…我单纯是觉得你的发型很适合戴帽子啦。"
                },
                {
                    "id": "690910307",
                    "speaker": "Player",
                    "text": "有机会的话，一起去买衣服吧。"
                },
                {
                    "id": "690910308",
                    "speaker": "娜维娅",
                    "text": "好啊，我带你去枫丹最好的服装店。我想想…你和派蒙可能需要出席正式场合的服装，还有帽子和新皮鞋…"
                },
                {
                    "id": "690910309",
                    "speaker": "娜维娅",
                    "text": "这么说来，你们以前出席正式场合的时候会怎么打扮呢？"
                },
                {
                    "id": "690910310",
                    "speaker": "Player",
                    "text": "基本也都是现在这身。"
                },
                {
                    "id": "690910311",
                    "speaker": "娜维娅",
                    "text": "欸？居然是这样…有意思，你果然是很想得开的人呢。"
                },
                {
                    "id": "690910312",
                    "speaker": "娜维娅",
                    "text": "你知道吗，能做到这种事的人大多非常洒脱哦。"
                },
                {
                    "id": "690910313",
                    "speaker": "娜维娅",
                    "text": "不论世界是什么样子，就以最基本的姿态去面对。我觉得这样也挺好的。"
                },
                {
                    "id": "690910314",
                    "speaker": "娜维娅",
                    "text": "这就是到处旅行的人的底气，对吧？啊当然，有机会还是要给你买点帽子皮鞋的！"
                }
            ]
        },
        {
            "talkId": "6909104",
            "initDialog": "690910401",
            "dialogues": [
                {
                    "id": "690910401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690910402",
                    "speaker": "娜维娅",
                    "text": "一起玩吧！爬山、爬树、逗猫、遛狗…什么都好。"
                },
                {
                    "id": "690910403",
                    "speaker": "Player",
                    "text": "娜维娅要穿成这样去爬树？"
                },
                {
                    "id": "690910404",
                    "speaker": "娜维娅",
                    "text": "对呀，别看我这个裙摆大，行动不会受影响的。"
                },
                {
                    "id": "690910405",
                    "speaker": "娜维娅",
                    "text": "我就是考虑到这点，才要求服装设计师在一般的礼服裙基础上做了改良。"
                },
                {
                    "id": "690910406",
                    "speaker": "Player",
                    "text": "娜维娅养过宠物吗？"
                },
                {
                    "id": "690910407",
                    "speaker": "娜维娅",
                    "text": "很久以前养过一条小狗，后来它因病去世了，我就没再养新的小狗了。"
                },
                {
                    "id": "690910408",
                    "speaker": "娜维娅",
                    "text": "它叫「贝贝壳」，名字是老爹起的，没什么特别的意思，就是捡到它那天刚去过海边而已。"
                },
                {
                    "id": "690910409",
                    "speaker": "娜维娅",
                    "text": "我也很喜欢贝贝壳，小时候经常和它一起出去，它还会带我钻那些废弃的管道，很聪明的。"
                },
                {
                    "id": "690910410",
                    "speaker": "Player",
                    "text": "你会想它吗？"
                },
                {
                    "id": "690910411",
                    "speaker": "娜维娅",
                    "text": "会啊，还梦到过它。梦里总是和它玩得很开心，不过醒来之后也不会特别特别留恋…"
                },
                {
                    "id": "690910412",
                    "speaker": "娜维娅",
                    "text": "贝贝壳也不希望我总是被一件事困住，对吧？它肯定也希望我今后交到更多的好朋友。",
                    "choices": [
                        {
                            "id": "690910413",
                            "text": "我是娜维娅的好朋友吧？",
                            "response": [
                                {
                                    "id": "690910414",
                                    "speaker": "娜维娅",
                                    "text": "这是什么话呀！我们不只是好朋友，还是一起经历过生死关头的好朋友！"
                                },
                                {
                                    "id": "690910415",
                                    "speaker": "娜维娅",
                                    "text": "人一辈子可遇不到多少这样的朋友，我当然要好好珍惜你了。"
                                },
                                {
                                    "id": "690910419",
                                    "speaker": "娜维娅",
                                    "text": "对了，我作为好朋友，是不是应该烤一个写着你我和派蒙名字的蛋糕，端到这里来？"
                                },
                                {
                                    "id": "690910420",
                                    "speaker": "娜维娅",
                                    "text": "总觉得派蒙会很想要那种东西…也不是不行！"
                                }
                            ]
                        },
                        {
                            "id": "690910416",
                            "text": "娜维娅能做我的好朋友吗？",
                            "response": [
                                {
                                    "id": "690910417",
                                    "speaker": "娜维娅",
                                    "text": "哈哈，听听你在说什么呀，我们早就是了。"
                                },
                                {
                                    "id": "690910418",
                                    "speaker": "娜维娅",
                                    "text": "不是好朋友，怎么会愿意经常来你家玩呢？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909105",
            "initDialog": "690910501",
            "dialogues": [
                {
                    "id": "690910501",
                    "speaker": "Player",
                    "text": "早啊，娜维娅。"
                },
                {
                    "id": "690910502",
                    "speaker": "娜维娅",
                    "text": "早上好，今天一定会是很好的一天。"
                },
                {
                    "id": "690910503",
                    "speaker": "娜维娅",
                    "text": "要出去逛逛吗？去哪里都可以，带好你的小包裹，马上出发！"
                }
            ]
        },
        {
            "talkId": "6909106",
            "initDialog": "690910601",
            "dialogues": [
                {
                    "id": "690910601",
                    "speaker": "Player",
                    "text": "晚安，娜维娅。"
                },
                {
                    "id": "690910602",
                    "speaker": "娜维娅",
                    "text": "呼啊——晚安晚安，我有点困了，你也早点睡吧。"
                },
                {
                    "id": "690910603",
                    "speaker": "娜维娅",
                    "text": "唔…希望能梦到开心的事…"
                }
            ]
        },
        {
            "talkId": "6909107",
            "initDialog": "690910701",
            "dialogues": [
                {
                    "id": "690910701",
                    "speaker": "娜维娅",
                    "text": "哎呀，我还以为这种铁皮房子很难在其他地方建起来呢！"
                },
                {
                    "id": "690910702",
                    "speaker": "娜维娅",
                    "text": "真厉害，不愧是你。"
                },
                {
                    "id": "690910703",
                    "speaker": "娜维娅",
                    "text": "既然氛围都到了，要不要一起去钓鱼玩？"
                }
            ]
        },
        {
            "talkId": "6909108",
            "initDialog": "690910801",
            "dialogues": [
                {
                    "id": "690910801",
                    "speaker": "娜维娅",
                    "text": "唔…枫丹餐饮业的装潢都大同小异呢。"
                },
                {
                    "id": "690910802",
                    "speaker": "娜维娅",
                    "text": "要评价一家饭店的好坏，可不能看桌椅是否奢华，还是要看端上桌的餐点是否美味。"
                },
                {
                    "id": "690910803",
                    "speaker": "娜维娅",
                    "text": "对于你的手艺和品味，我放一百个心！"
                }
            ]
        }
    ]
}