{
    "groupId": "6229",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "皮希加": 7
    },
    "talks": [
        {
            "talkId": "6622901",
            "initDialog": "662290101",
            "dialogues": [
                {
                    "id": "662290101",
                    "speaker": "皮希加",
                    "text": "客人想要挑战「游靶气球」吗？无需多么精湛的飞行技巧，谁都可以参加！"
                }
            ]
        },
        {
            "talkId": "6622902",
            "initDialog": "662290201",
            "dialogues": [
                {
                    "id": "662290201",
                    "speaker": "Player",
                    "text": "不需要飞行执照之类的东西吗？"
                },
                {
                    "id": "662290202",
                    "speaker": "皮希加",
                    "text": "不用不用，哪怕像我这样没能通过飞行试炼的人也能轻松完成。"
                },
                {
                    "id": "662290203",
                    "speaker": "皮希加",
                    "text": "比起飞行技术，「游靶气球」更多是在考验客人们射击技术。"
                },
                {
                    "id": "662290204",
                    "speaker": "皮希加",
                    "text": "最重要的是专注！请心无旁骛地瞄准目标吧。"
                },
                {
                    "id": "662290205",
                    "speaker": "皮希加",
                    "text": "在体验过程中，扎安娅小姐会保障你的安全，有时还能看见绒翼龙在一旁巡逻哦！"
                },
                {
                    "id": "662290206",
                    "speaker": "皮希加",
                    "text": "热气球…真是伟大的发明啊，让大家都离天空更近了。"
                }
            ]
        },
        {
            "talkId": "6622903",
            "initDialog": "662290301",
            "dialogues": [
                {
                    "id": "662290301",
                    "speaker": "Player",
                    "text": "下次再说。"
                },
                {
                    "id": "662290302",
                    "speaker": "皮希加",
                    "text": "没问题，随时欢迎。"
                }
            ]
        }
    ]
}