{
    "groupId": "3077",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "小畑": 19
    },
    "talks": [
        {
            "talkId": "6307701",
            "initDialog": "630770101",
            "dialogues": [
                {
                    "id": "630770101",
                    "speaker": "小畑",
                    "text": "嘿，要来些新鲜的水产吗？稻妻的鱼，可是全提瓦特最新鲜的！"
                }
            ]
        },
        {
            "talkId": "6307702",
            "initDialog": "630770201",
            "dialogues": [
                {
                    "id": "630770201",
                    "speaker": "Player",
                    "text": "我想买些鱼。"
                },
                {
                    "id": "630770202",
                    "speaker": "小畑",
                    "text": "欢迎欢迎，各种水产一应俱全，来挑挑看吧。"
                }
            ]
        },
        {
            "talkId": "6307703",
            "initDialog": "630770301",
            "dialogues": [
                {
                    "id": "630770301",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "630770302",
                    "speaker": "小畑",
                    "text": "这座岛是我的故乡，我家祖祖辈辈都是渔夫，我自然而然也成了渔夫。"
                },
                {
                    "id": "630770303",
                    "speaker": "小畑",
                    "text": "…不过如今啊，渔夫也成了稀有职业了。"
                },
                {
                    "id": "630770304",
                    "speaker": "小畑",
                    "text": "「锁国令」除了限制外人来稻妻，同时也限制了我们出海的范围。"
                },
                {
                    "id": "630770305",
                    "speaker": "小畑",
                    "text": "不少渔夫都转行去做别的了，我是因为这片大海留在了这里。"
                },
                {
                    "id": "630770306",
                    "speaker": "小畑",
                    "text": "因为我每时每刻都能听到，这片大海在呼唤我…"
                }
            ]
        },
        {
            "talkId": "6307704",
            "initDialog": "630770401",
            "dialogues": [
                {
                    "id": "630770401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630770402",
                    "speaker": "小畑",
                    "text": "哦！如果想要新鲜的鱼，欢迎再来啊！"
                }
            ]
        },
        {
            "talkId": "6307705",
            "initDialog": "630770501",
            "dialogues": [
                {
                    "id": "630770501",
                    "speaker": "Player",
                    "text": "关于锁国令…"
                },
                {
                    "id": "630770502",
                    "speaker": "小畑",
                    "text": "我是个粗人，不懂那么多大道理，反正在我看来，这是个令人不快的决策。"
                },
                {
                    "id": "630770503",
                    "speaker": "小畑",
                    "text": "锁国令不但让顾客变少了，限制出海范围更是让打渔变得困难重重。"
                },
                {
                    "id": "630770504",
                    "speaker": "小畑",
                    "text": "唉，不能自由出海的渔民，跟在沙滩上晾着的咸鱼有什么区别…真搞不懂上面的大人物是怎么想的…"
                }
            ]
        },
        {
            "talkId": "6307706",
            "initDialog": "630770601",
            "dialogues": [
                {
                    "id": "630770601",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "630770602",
                    "speaker": "小畑",
                    "text": "这座岛是我的故乡，我家祖祖辈辈都是渔夫，我自然而然也成了渔夫。"
                },
                {
                    "id": "630770603",
                    "speaker": "小畑",
                    "text": "之前因为锁国令对出海范围的限制，渔夫一度成为了稀有职业…"
                },
                {
                    "id": "630770604",
                    "speaker": "小畑",
                    "text": "但现在已经没有问题了！锁国令解除后，不仅出海打渔的限制没有了，离岛的顾客也变多了！"
                },
                {
                    "id": "630770605",
                    "speaker": "小畑",
                    "text": "现在，我终于可以自由地回应大海的呼唤了，哈哈哈！"
                }
            ]
        },
        {
            "talkId": "7290401",
            "initDialog": "729040101",
            "dialogues": [
                {
                    "id": "729040101",
                    "speaker": "Player",
                    "text": "大海的呼唤？"
                },
                {
                    "id": "729040102",
                    "speaker": "小畑",
                    "text": "嗯！你听，海浪打在砂岸的声音、游鱼穿过洋流的声音…"
                },
                {
                    "id": "729040103",
                    "speaker": "小畑",
                    "text": "欸？还是不能理解吗？"
                },
                {
                    "id": "729040104",
                    "speaker": "小畑",
                    "text": "…哈哈哈哈，你是外国人吧，不怪你！"
                },
                {
                    "id": "729040105",
                    "speaker": "小畑",
                    "text": "这些新鲜的稻妻海鱼就送给你吧。等你再多在海边生活一阵，就能理解大海的浪漫了！"
                }
            ]
        }
    ]
}