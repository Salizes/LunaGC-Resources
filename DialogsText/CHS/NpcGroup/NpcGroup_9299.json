{
    "groupId": "9299",
    "total_dialogue_lines": 83,
    "speaker_counts": {
        "Player": 18,
        "基尼奇": 45,
        "阿乔": 20
    },
    "talks": [
        {
            "talkId": "6910102",
            "initDialog": "691010201",
            "dialogues": [
                {
                    "id": "691010201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691010202",
                    "speaker": "基尼奇",
                    "text": "嗯。环境不错，待着也舒适。"
                },
                {
                    "id": "691010203",
                    "speaker": "阿乔",
                    "text": "我说基尼奇，你的衡量标准会不会低了一点？"
                },
                {
                    "id": "691010204",
                    "speaker": "阿乔",
                    "text": "要我说，这陋室虽然也算有可圈可点之处，但比起我统辖的烈焰之国可就相形见绌喽。"
                },
                {
                    "id": "691010205",
                    "speaker": "阿乔",
                    "text": "想当年，我库胡勒阿乔的城堡建在举国最高的地方，光是前来拜谒的仆从就不计其数。"
                },
                {
                    "id": "691010206",
                    "speaker": "阿乔",
                    "text": "鲜红的果实被制成佳酿，财宝堆满华贵的宝匣…这还不过是我收到的万千进贡品中最寻常的两种。",
                    "choices": [
                        {
                            "id": "691010207",
                            "text": "那还真是了不起。",
                            "response": [
                                {
                                    "id": "691010209",
                                    "speaker": "基尼奇",
                                    "text": "既然是伟大圣龙、至高领主，想必知道为客的礼仪？"
                                },
                                {
                                    "id": "691010210",
                                    "speaker": "阿乔",
                                    "text": "哼…"
                                },
                                {
                                    "id": "691010211",
                                    "speaker": "基尼奇",
                                    "text": "#{NICKNAME}，感谢你邀请我做客。"
                                },
                                {
                                    "id": "691010212",
                                    "speaker": "基尼奇",
                                    "text": "餐风露宿的时候，我只需要一堆篝火，或是一处栖身的山洞。这里提供的不仅是安全，还有别处难以寻得的温馨。"
                                },
                                {
                                    "id": "691010213",
                                    "speaker": "基尼奇",
                                    "text": "我应该给你怎样的回报？"
                                },
                                {
                                    "id": "691010214",
                                    "speaker": "Player",
                                    "text": "不用客气的。"
                                },
                                {
                                    "id": "691010215",
                                    "speaker": "基尼奇",
                                    "text": "这不是客气。我不想无偿接受你的好意，这是我的坚持。"
                                },
                                {
                                    "id": "691010216",
                                    "speaker": "基尼奇",
                                    "text": "如果你对我有所期望，希望你能直言。我会根据情况考虑如何完成你的委托，那样事情更简单。"
                                },
                                {
                                    "id": "691010217",
                                    "speaker": "Player",
                                    "text": "但我也没想好…"
                                },
                                {
                                    "id": "691010218",
                                    "speaker": "基尼奇",
                                    "text": "好吧，我理解…那就先欠着。"
                                },
                                {
                                    "id": "691010219",
                                    "speaker": "基尼奇",
                                    "text": "等你想好要什么，请随时和我说。"
                                },
                                {
                                    "id": "691010220",
                                    "speaker": "基尼奇",
                                    "text": "当然，万一「价格」不合适，我会立刻告诉你的。"
                                }
                            ]
                        },
                        {
                            "id": "691010208",
                            "text": "让您屈尊了。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910103",
            "initDialog": "691010301",
            "dialogues": [
                {
                    "id": "691010301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691010302",
                    "speaker": "基尼奇",
                    "text": "你想打听什么？"
                },
                {
                    "id": "691010303",
                    "speaker": "Player",
                    "text": "不会内容不同，价格也不同吧？"
                },
                {
                    "id": "691010304",
                    "speaker": "基尼奇",
                    "text": "嗯，情报的价格由多方因素决定。"
                },
                {
                    "id": "691010305",
                    "speaker": "基尼奇",
                    "text": "但看你不紧不慢的态度，不像有急事…只是闲聊？"
                },
                {
                    "id": "691010306",
                    "speaker": "Player",
                    "text": "想听你聊聊猎龙的事。"
                },
                {
                    "id": "691010307",
                    "speaker": "基尼奇",
                    "text": "这不是有趣而轻松的话题。"
                },
                {
                    "id": "691010308",
                    "speaker": "阿乔",
                    "text": "#啊哈，怎么了呀基尼奇？你是怕自己的冷酷吓到人家，还是怕残忍的细节让{M#他}{F#她}睡不着觉呀？",
                    "choices": [
                        {
                            "id": "691010309",
                            "text": "我倒不在意。",
                            "response": [
                                {
                                    "id": "691010311",
                                    "speaker": "基尼奇",
                                    "text": "别听阿乔胡说，没那么可怕。"
                                },
                                {
                                    "id": "691010312",
                                    "speaker": "基尼奇",
                                    "text": "龙是纳塔人的伙伴。但如果龙被深渊侵蚀到了极点，无法净化；或是受到他人蛊惑，无恶不作…"
                                },
                                {
                                    "id": "691010313",
                                    "speaker": "基尼奇",
                                    "text": "这些情况下，为了避免灾害蔓延，只能人为终结它们的生命。"
                                },
                                {
                                    "id": "691010314",
                                    "speaker": "基尼奇",
                                    "text": "绝境中，连丛林里的野兽都会奋力挣扎，何况凶恶的龙？"
                                },
                                {
                                    "id": "691010315",
                                    "speaker": "基尼奇",
                                    "text": "因此，我一般先靠箭毒麻木龙的知觉，配合陷阱限制行动范围，最后趁对方虚弱时送它上路。",
                                    "choices": [
                                        {
                                            "id": "691010316",
                                            "text": "好像还是挺危险的…",
                                            "response": [
                                                {
                                                    "id": "691010317",
                                                    "speaker": "基尼奇",
                                                    "text": "我不否认。但只要经验充足，准备齐全，「危险」也能被驯服。"
                                                },
                                                {
                                                    "id": "691010318",
                                                    "speaker": "基尼奇",
                                                    "text": "如果你对猎龙感兴趣，下次接到合适的委托，我来喊你。"
                                                },
                                                {
                                                    "id": "691010319",
                                                    "speaker": "基尼奇",
                                                    "text": "我们可以一起采摘有毒的浆果，合力布置陷阱…嗯，酬劳也会分给你的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691010320",
                                            "text": "你遇到最难对付的龙是怎样的？",
                                            "response": [
                                                {
                                                    "id": "691010321",
                                                    "speaker": "基尼奇",
                                                    "text": "是阿乔。"
                                                },
                                                {
                                                    "id": "691010322",
                                                    "speaker": "阿乔",
                                                    "text": "嗯嗯嗯？哪个不要命的二脚直立爬虫居然在当面议论我？"
                                                },
                                                {
                                                    "id": "691010323",
                                                    "speaker": "基尼奇",
                                                    "text": "贪婪与自负往往是恶龙的通病，容易利用。"
                                                },
                                                {
                                                    "id": "691010324",
                                                    "speaker": "基尼奇",
                                                    "text": "针对动作粗笨、空有力气的对象，则可以靠敏捷躲过前期攻势，寻找进攻机会。"
                                                },
                                                {
                                                    "id": "691010325",
                                                    "speaker": "基尼奇",
                                                    "text": "但阿乔不仅邪恶、强大，还保持着清醒的头脑，难能可贵。"
                                                },
                                                {
                                                    "id": "691010326",
                                                    "speaker": "阿乔",
                                                    "text": "哼，现在才想歌颂我来为自己捞好处？你算错了，我伟大圣龙可不吃这一套！"
                                                },
                                                {
                                                    "id": "691010327",
                                                    "speaker": "基尼奇",
                                                    "text": "收回我的话。你要是真的清醒，就会知道我不是在夸你。"
                                                },
                                                {
                                                    "id": "691010328",
                                                    "speaker": "阿乔",
                                                    "text": "别不好意思。都说了多少次，光是你们这些低劣生物的存在，就是对我此等高贵圣龙的衬托。我随时接受你们的奉承。"
                                                },
                                                {
                                                    "id": "691010329",
                                                    "speaker": "基尼奇",
                                                    "text": "#唉…{NICKNAME}你看，是挺难对付吧？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691010310",
                            "text": "呃…可以省略残酷的细节？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910104",
            "initDialog": "691010401",
            "dialogues": [
                {
                    "id": "691010401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691010402",
                    "speaker": "基尼奇",
                    "text": "我无所谓。现在手边没委托，做什么都行。"
                },
                {
                    "id": "691010403",
                    "speaker": "基尼奇",
                    "text": "你想喝点东西吗？比如青蜜莓苦种果汁。"
                },
                {
                    "id": "691010404",
                    "speaker": "阿乔",
                    "text": "#哇！别管{M#他}{F#她}要不要了，把我的份先呈上来！",
                    "choices": [
                        {
                            "id": "691010405",
                            "text": "什么价格？",
                            "response": [
                                {
                                    "id": "691010406",
                                    "speaker": "基尼奇",
                                    "text": "呵，这杯不收你钱。"
                                },
                                {
                                    "id": "691010409",
                                    "speaker": "基尼奇",
                                    "text": "在纳塔，苦种主要被用于制作巧克力和苦水，最有价值的部分是发酵后的种子。"
                                },
                                {
                                    "id": "691010410",
                                    "speaker": "基尼奇",
                                    "text": "但万物皆有其用。如果将它白色的果肉部分挤榨成汁，经过恰当调味，同样能够制成可口的饮品。"
                                },
                                {
                                    "id": "691010411",
                                    "speaker": "阿乔",
                                    "text": "介绍够了没？快点快点，我已经等不及了！"
                                },
                                {
                                    "id": "691010412",
                                    "speaker": "基尼奇",
                                    "text": "起初，我用的是维茨特兰当地的火榴果，它能够为人和龙提供丰富的燃素。"
                                },
                                {
                                    "id": "691010413",
                                    "speaker": "基尼奇",
                                    "text": "后来，考虑到获取上的难度，我将它改成青蜜莓，相应调整了饮品中各材料的配比。"
                                },
                                {
                                    "id": "691010414",
                                    "speaker": "阿乔",
                                    "text": "基尼奇！你故意的吧？平时怎么没见到你话那么多、解释起来那么啰嗦！"
                                },
                                {
                                    "id": "691010415",
                                    "speaker": "阿乔",
                                    "text": "你要不要从维茨特兰的起源和世界上的第一棵火榴果树开始讲起啊？"
                                },
                                {
                                    "id": "691010416",
                                    "speaker": "基尼奇",
                                    "text": "这是为了让我的朋友能对这道饮品有更多的了解，从而更好地享用它。"
                                },
                                {
                                    "id": "691010417",
                                    "speaker": "基尼奇",
                                    "text": "反正你也尝不出果汁口感上的好坏，平时和你说你也不懂。"
                                },
                                {
                                    "id": "691010418",
                                    "speaker": "阿乔",
                                    "text": "你…！"
                                },
                                {
                                    "id": "691010419",
                                    "speaker": "Player",
                                    "text": "那个…我被你们说得想尝尝了！"
                                },
                                {
                                    "id": "691010420",
                                    "speaker": "基尼奇",
                                    "text": "好。那我现在就为二位调配果汁。"
                                }
                            ]
                        },
                        {
                            "id": "691010407",
                            "text": "那是什么？",
                            "response": [
                                {
                                    "id": "691010408",
                                    "speaker": "基尼奇",
                                    "text": "一种由我自创的混合燃素果汁。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910105",
            "initDialog": "691010501",
            "dialogues": [
                {
                    "id": "691010501",
                    "speaker": "Player",
                    "text": "早啊，基尼奇。"
                },
                {
                    "id": "691010502",
                    "speaker": "基尼奇",
                    "text": "#早，{NICKNAME}，祝你冒险顺利。"
                },
                {
                    "id": "691010503",
                    "speaker": "阿乔",
                    "text": "等等等等你们两个目无尊长的家伙，竟然没人向至高领主致以清晨的问候？这等罪行可是要…喂，你们有没有在听！"
                }
            ]
        },
        {
            "talkId": "6910106",
            "initDialog": "691010601",
            "dialogues": [
                {
                    "id": "691010601",
                    "speaker": "Player",
                    "text": "晚安，基尼奇。"
                },
                {
                    "id": "691010602",
                    "speaker": "基尼奇",
                    "text": "嗯。放下负担，安心休息吧，晚安。"
                },
                {
                    "id": "691010603",
                    "speaker": "阿乔",
                    "text": "哈哈，卑怯的生灵才畏惧黑暗，疲弱的爬虫才需要休眠，汝等凡人之躯真是羸弱。"
                },
                {
                    "id": "691010604",
                    "speaker": "基尼奇",
                    "text": "神圣如领主大人，想必也无需进食？"
                },
                {
                    "id": "691010605",
                    "speaker": "阿乔",
                    "text": "区区仆从竟敢威胁我！你就等着噩梦缠身吧！"
                }
            ]
        },
        {
            "talkId": "6910110",
            "initDialog": "691011001",
            "dialogues": [
                {
                    "id": "691011001",
                    "speaker": "基尼奇",
                    "text": "你的观察力很出色，从布局到屋边摆设，都能看出你对我们部族深有了解…来看这些色彩各异的火榴果壳。"
                },
                {
                    "id": "691011002",
                    "speaker": "基尼奇",
                    "text": "它们质地坚硬，常被「悬木人」当作容器，运送信件和物品，必要时还可防身。喏，就像这样——"
                },
                {
                    "id": "691011003",
                    "speaker": "阿乔",
                    "text": "别拿神圣的领主来示范！你、你不要命啦！"
                }
            ]
        },
        {
            "talkId": "6910111",
            "initDialog": "691011101",
            "dialogues": [
                {
                    "id": "691011101",
                    "speaker": "阿乔",
                    "text": "哎哟哟，瞧瞧这花、树，像模像样的。不说我还以为是回到你家了呢。"
                },
                {
                    "id": "691011102",
                    "speaker": "阿乔",
                    "text": "怀念吗？激动吗？感慨得快要热泪盈眶了吧！小小基尼奇，快求求你这朋友再为你挪一座山来，枕着脑袋美滋滋地住下吧！"
                },
                {
                    "id": "691011103",
                    "speaker": "基尼奇",
                    "text": "还得给你找个地方。对于即将被关禁闭的龙来说，这里显然太过舒适了。"
                }
            ]
        }
    ]
}