{
    "groupId": "6045",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "巴加约": 8
    },
    "talks": [
        {
            "talkId": "6604501",
            "initDialog": "660450101",
            "dialogues": [
                {
                    "id": "660450101",
                    "speaker": "巴加约",
                    "text": "糟糕…我刚刚是不是来过这里了？"
                }
            ]
        },
        {
            "talkId": "6604502",
            "initDialog": "660450201",
            "dialogues": [
                {
                    "id": "660450201",
                    "speaker": "Player",
                    "text": "迷路了？"
                },
                {
                    "id": "660450202",
                    "speaker": "巴加约",
                    "text": "对！呃…不，不对！不是我迷路了！"
                },
                {
                    "id": "660450203",
                    "speaker": "巴加约",
                    "text": "唉，抱歉，看我急得，连话都说不清了。"
                },
                {
                    "id": "660450204",
                    "speaker": "巴加约",
                    "text": "我没有迷路，但是我和女儿阿坎蒂不小心走散了。"
                },
                {
                    "id": "660450207",
                    "speaker": "巴加约",
                    "text": "…或者也不是不小心吧，因为她总是乱跑，她很可能是故意的！这个调皮蛋…"
                },
                {
                    "id": "660450205",
                    "speaker": "巴加约",
                    "text": "你要是见到一个聊艺术聊得前言不搭后语的小姑娘，那大概就是她了！"
                },
                {
                    "id": "660450206",
                    "speaker": "巴加约",
                    "text": "唉，她就是喜欢在路边找人闲聊，等聊痛快了就会回来了吧…"
                }
            ]
        },
        {
            "talkId": "6604503",
            "initDialog": "660450301",
            "dialogues": [
                {
                    "id": "660450301",
                    "speaker": "Player",
                    "text": "你先别急。"
                },
                {
                    "id": "660450302",
                    "speaker": "巴加约",
                    "text": "话是这么说，但我也控制不了啊…"
                }
            ]
        }
    ]
}