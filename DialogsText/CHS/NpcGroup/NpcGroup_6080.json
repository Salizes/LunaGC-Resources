{
    "groupId": "6080",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "Player": 2,
        "梅内娅": 5
    },
    "talks": [
        {
            "talkId": "6608001",
            "initDialog": "660800101",
            "dialogues": [
                {
                    "id": "660800101",
                    "speaker": "梅内娅",
                    "text": "不能乱喝水哦，很会游泳的龙也不行。"
                }
            ]
        },
        {
            "talkId": "6608002",
            "initDialog": "660800201",
            "dialogues": [
                {
                    "id": "660800201",
                    "speaker": "Player",
                    "text": "温泉水的确不适合饮用。"
                },
                {
                    "id": "660800202",
                    "speaker": "梅内娅",
                    "text": "对吧，你也这样认为？"
                },
                {
                    "id": "660800203",
                    "speaker": "梅内娅",
                    "text": "我把来这边旅行的见闻写在信里寄回去，被回信叮嘱说「温泉水太热，要记得放凉再喝」。"
                },
                {
                    "id": "660800204",
                    "speaker": "梅内娅",
                    "text": "可是那维莱特大人啊…温泉水本来就不是用来喝的吧？"
                }
            ]
        },
        {
            "talkId": "6608003",
            "initDialog": "660800301",
            "dialogues": [
                {
                    "id": "660800301",
                    "speaker": "Player",
                    "text": "我会注意的。"
                },
                {
                    "id": "660800302",
                    "speaker": "梅内娅",
                    "text": "嗯，不仅仅是温度的问题，胃也会受不了的。"
                }
            ]
        }
    ]
}