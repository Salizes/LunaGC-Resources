{
    "groupId": "2102",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 3,
        "楚仪": 18,
        "淮安": 1
    },
    "talks": [
        {
            "talkId": "6210204",
            "initDialog": "621020401",
            "dialogues": [
                {
                    "id": "621020401",
                    "speaker": "楚仪",
                    "text": "这里是「岩上茶室」。"
                },
                {
                    "id": "621020402",
                    "speaker": "楚仪",
                    "text": "新东家说，来即是客，不妨上楼来喝一杯茶。"
                }
            ]
        },
        {
            "talkId": "6210205",
            "initDialog": "621020501",
            "dialogues": [
                {
                    "id": "621020501",
                    "speaker": "Player",
                    "text": "新东家…？"
                },
                {
                    "id": "621020502",
                    "speaker": "楚仪",
                    "text": "因债务问题，上一任东家抛售了产业。"
                },
                {
                    "id": "621020503",
                    "speaker": "楚仪",
                    "text": "新东家接手茶室后，对主营业务进行了一些调整…"
                },
                {
                    "id": "621020504",
                    "speaker": "楚仪",
                    "text": "咳，说多了你也听不懂。总之把这里当成普通的「茶室」即可，呵呵。"
                }
            ]
        },
        {
            "talkId": "6210206",
            "initDialog": "621020601",
            "dialogues": [
                {
                    "id": "621020601",
                    "speaker": "Player",
                    "text": "不会被「送客」吗？"
                },
                {
                    "id": "621020602",
                    "speaker": "楚仪",
                    "text": "瞧你说的，当然不会。"
                },
                {
                    "id": "621020603",
                    "speaker": "楚仪",
                    "text": "那位也希望来茶室的人多一些…总之只要规矩点，喝茶聊天什么的，我们可是很欢迎的。"
                }
            ]
        },
        {
            "talkId": "6210207",
            "initDialog": "621020701",
            "dialogues": [
                {
                    "id": "621020701",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6210208",
            "initDialog": "621020801",
            "dialogues": [
                {
                    "id": "621020801",
                    "speaker": "淮安",
                    "text": "这样居然都输了，这可真是少见…对了，客人，不去楼上坐坐吗？"
                }
            ]
        },
        {
            "talkId": "6210209",
            "initDialog": "621020901",
            "dialogues": [
                {
                    "id": "621020901",
                    "speaker": "楚仪",
                    "text": "可别忘了，我可是「岩上茶室」的招待，会玩牌本就是应有之义…"
                }
            ]
        },
        {
            "talkId": "6210201",
            "initDialog": "621020101",
            "dialogues": [
                {
                    "id": "621020101",
                    "speaker": "楚仪",
                    "text": "这里是「岩上茶室」。"
                },
                {
                    "id": "621020102",
                    "speaker": "楚仪",
                    "text": "既然来了，你有心理准备吧？带了多少钱来？"
                }
            ]
        },
        {
            "talkId": "6210202",
            "initDialog": "621020201",
            "dialogues": [
                {
                    "id": "621020201",
                    "speaker": "楚仪",
                    "text": "这里的茶难道很贵…"
                },
                {
                    "id": "621020202",
                    "speaker": "楚仪",
                    "text": "谁跟你说「茶室」一定是卖茶的了？"
                },
                {
                    "id": "621020203",
                    "speaker": "楚仪",
                    "text": "你这样的愣头青就不要满城乱撞了，有闲工夫不如去听个戏，下下馆子。"
                },
                {
                    "id": "621020204",
                    "speaker": "楚仪",
                    "text": "有些浑水不要趟，多你一个不多，少你一个不少。"
                },
                {
                    "id": "621020205",
                    "speaker": "楚仪",
                    "text": "……再不走，我可要叫保镖「送客」了。"
                }
            ]
        },
        {
            "talkId": "6210203",
            "initDialog": "621020301",
            "dialogues": [
                {
                    "id": "621020301",
                    "speaker": "楚仪",
                    "text": "不了谢谢，再见。"
                },
                {
                    "id": "621020302",
                    "speaker": "楚仪",
                    "text": "嚯，很懂礼貌啊。"
                },
                {
                    "id": "621020303",
                    "speaker": "楚仪",
                    "text": "那我也客气点，不叫保镖「送客」了，走好。"
                }
            ]
        }
    ]
}