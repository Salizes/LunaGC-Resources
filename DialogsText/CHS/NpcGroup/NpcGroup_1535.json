{
    "groupId": "1535",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "恩内斯特": 10
    },
    "talks": [
        {
            "talkId": "6153501",
            "initDialog": "615350101",
            "dialogues": [
                {
                    "id": "615350101",
                    "speaker": "恩内斯特",
                    "text": "嗯？你从哪儿来，找我啥事？"
                }
            ]
        },
        {
            "talkId": "6153502",
            "initDialog": "615350201",
            "dialogues": [
                {
                    "id": "615350201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "615350202",
                    "speaker": "恩内斯特",
                    "text": "我是这儿的仓库看守，偶尔负责运运货什么的。"
                },
                {
                    "id": "615350203",
                    "speaker": "恩内斯特",
                    "text": "这活计倒是挺闲的，酒庄老板也阔气，给不少钱。"
                },
                {
                    "id": "615350204",
                    "speaker": "恩内斯特",
                    "text": "别的不说，单单跟这边价值连城的窖藏做伴，就是件顶舒服的事儿。"
                },
                {
                    "id": "615350205",
                    "speaker": "恩内斯特",
                    "text": "你想，有多少人一辈子也没见过值这么多钱的玩意儿啊。"
                }
            ]
        },
        {
            "talkId": "6153503",
            "initDialog": "615350301",
            "dialogues": [
                {
                    "id": "615350301",
                    "speaker": "Player",
                    "text": "那边是？"
                },
                {
                    "id": "615350302",
                    "speaker": "恩内斯特",
                    "text": "晨曦酒庄的酒窖啊，不然我站这儿干啥？"
                },
                {
                    "id": "615350303",
                    "speaker": "恩内斯特",
                    "text": "先跟你说，别想打这儿的酒的主意…"
                },
                {
                    "id": "615350304",
                    "speaker": "恩内斯特",
                    "text": "打主意也还轮不到你……"
                },
                {
                    "id": "615350305",
                    "speaker": "恩内斯特",
                    "text": "不，不，没什么。"
                }
            ]
        },
        {
            "talkId": "6153504",
            "initDialog": "615350401",
            "dialogues": [
                {
                    "id": "615350401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615350402",
                    "speaker": "恩内斯特",
                    "text": "走吧，路上慢点儿。"
                }
            ]
        }
    ]
}