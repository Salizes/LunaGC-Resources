{
    "groupId": "1591",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "杜兰": 13
    },
    "talks": [
        {
            "talkId": "6159101",
            "initDialog": "615910101",
            "dialogues": [
                {
                    "id": "615910101",
                    "speaker": "杜兰",
                    "text": "别再往神殿里面走了，很危险的。"
                }
            ]
        },
        {
            "talkId": "6159102",
            "initDialog": "615910201",
            "dialogues": [
                {
                    "id": "615910201",
                    "speaker": "Player",
                    "text": "发生什么了？"
                },
                {
                    "id": "615910202",
                    "speaker": "杜兰",
                    "text": "本来是一些遗迹探索的问题，这是我的专长，但现在已经无所谓了，它变得更深邃，更不可捉摸。"
                },
                {
                    "id": "615910203",
                    "speaker": "杜兰",
                    "text": "你明白这种感觉吗？就是柳暗花明，峰回路转，完全意料之外，就在眼前，如梦似幻。"
                },
                {
                    "id": "615910204",
                    "speaker": "杜兰",
                    "text": "那比探险更加微妙和暧昧，洋溢着浪漫的香味，以及一点点的危险…",
                    "choices": [
                        {
                            "id": "615910205",
                            "text": "…你在说什么？",
                            "response": [
                                {
                                    "id": "615910206",
                                    "speaker": "杜兰",
                                    "text": "抱歉抱歉，我是个冒险家，按理来说冒险和邂逅是相似的事情，但我好像不太能驾驭。"
                                },
                                {
                                    "id": "615910207",
                                    "speaker": "杜兰",
                                    "text": "帕琪小姐很鲁莽，和她行动风险很高，我害怕她会受伤。"
                                },
                                {
                                    "id": "615910208",
                                    "speaker": "杜兰",
                                    "text": "但更重要的是冒险和邂逅都没有永恒，把握不住就只有错过。"
                                },
                                {
                                    "id": "615910209",
                                    "speaker": "杜兰",
                                    "text": "她太执着了，除了延长这段邂逅的时间，我也无可奈何。"
                                }
                            ]
                        },
                        {
                            "id": "615910210",
                            "text": "感觉你很可疑。",
                            "response": [
                                {
                                    "id": "615910211",
                                    "speaker": "杜兰",
                                    "text": "当你在旅途中遇到突如其来的命运的时候，你可能会比我还要可疑。"
                                },
                                {
                                    "id": "615910212",
                                    "speaker": "杜兰",
                                    "text": "冒险是浪漫的事，我拒绝了冒险家协会因为他们的衣服太丑，诸如此类，都是浪漫。"
                                },
                                {
                                    "id": "615910213",
                                    "speaker": "杜兰",
                                    "text": "唉，看来你和她一样，需要更长的时间才能理解这须臾又迷离的情愫啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6159103",
            "initDialog": "615910301",
            "dialogues": [
                {
                    "id": "615910301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615910302",
                    "speaker": "杜兰",
                    "text": "冒险不只有一个终点哦，旅行者。"
                }
            ]
        },
        {
            "talkId": "8159101",
            "initDialog": "815910101",
            "dialogues": [
                {
                    "id": "815910101",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "8159102",
            "initDialog": "815910201",
            "dialogues": [
                {
                    "id": "815910201",
                    "speaker": "杜兰",
                    "text": "附近好像没有什么值得留意…一定要说有什么的话，那就是帕琪小姐最近换了新发型吧。"
                }
            ]
        }
    ]
}