{
    "groupId": "5121",
    "total_dialogue_lines": 39,
    "speaker_counts": {
        "Player": 14,
        "安特曼": 25
    },
    "talks": [
        {
            "talkId": "5900136",
            "initDialog": "590013601",
            "dialogues": [
                {
                    "id": "590013601",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "5900137",
            "initDialog": "590013701",
            "dialogues": [
                {
                    "id": "590013701",
                    "speaker": "安特曼",
                    "text": "抱歉，我忙着打理鱼摊，没怎么注意。"
                }
            ]
        },
        {
            "talkId": "6512101",
            "initDialog": "651210101",
            "dialogues": [
                {
                    "id": "651210101",
                    "speaker": "安特曼",
                    "text": "我这的鱼种类齐全，客人需要哪种？"
                }
            ]
        },
        {
            "talkId": "6512102",
            "initDialog": "651210201",
            "dialogues": [
                {
                    "id": "651210201",
                    "speaker": "Player",
                    "text": "看看鱼。"
                },
                {
                    "id": "651210202",
                    "speaker": "安特曼",
                    "text": "请。"
                }
            ]
        },
        {
            "talkId": "6512103",
            "initDialog": "651210301",
            "dialogues": [
                {
                    "id": "651210301",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "651210302",
                    "speaker": "安特曼",
                    "text": "欢迎来到白淞镇，一个渔民们生活的小地方。"
                },
                {
                    "id": "651210303",
                    "speaker": "安特曼",
                    "text": "风景大概比不上城里那么华贵，但镇上的居民过得都很悠闲。"
                },
                {
                    "id": "651210304",
                    "speaker": "安特曼",
                    "text": "对了，这里地形不太好走，路面很滑。如果客人是来旅游的，还请小心脚下。"
                }
            ]
        },
        {
            "talkId": "6512104",
            "initDialog": "651210401",
            "dialogues": [
                {
                    "id": "651210401",
                    "speaker": "Player",
                    "text": "先不用了。"
                },
                {
                    "id": "651210402",
                    "speaker": "安特曼",
                    "text": "您慢走。"
                }
            ]
        },
        {
            "talkId": "6512105",
            "initDialog": "651210501",
            "dialogues": [
                {
                    "id": "651210501",
                    "speaker": "安特曼",
                    "text": "哎呀，这不是老板的朋友吗，欢迎。"
                }
            ]
        },
        {
            "talkId": "6512106",
            "initDialog": "651210601",
            "dialogues": [
                {
                    "id": "651210601",
                    "speaker": "Player",
                    "text": "可以买鱼吗？"
                },
                {
                    "id": "651210602",
                    "speaker": "安特曼",
                    "text": "没想到您真是来买鱼的，请随意挑选。"
                }
            ]
        },
        {
            "talkId": "6512107",
            "initDialog": "651210701",
            "dialogues": [
                {
                    "id": "651210701",
                    "speaker": "Player",
                    "text": "最近镇上还好吗？"
                },
                {
                    "id": "651210702",
                    "speaker": "安特曼",
                    "text": "就像娜维娅老板的热情一样，一切照常。"
                },
                {
                    "id": "651210703",
                    "speaker": "安特曼",
                    "text": "多谢您的关心。若您再见到老板的话，也请多关照下她吧。"
                }
            ]
        },
        {
            "talkId": "6512108",
            "initDialog": "651210801",
            "dialogues": [
                {
                    "id": "651210801",
                    "speaker": "Player",
                    "text": "回见。"
                },
                {
                    "id": "651210802",
                    "speaker": "安特曼",
                    "text": "嗯，多谢您的关照。"
                }
            ]
        },
        {
            "talkId": "6512109",
            "initDialog": "651210901",
            "dialogues": [
                {
                    "id": "651210901",
                    "speaker": "安特曼",
                    "text": "这不是老板的朋友吗。最近白淞镇的环境不太好，我知道您不是本地人，但还是不建议您久留啊。"
                }
            ]
        },
        {
            "talkId": "6512110",
            "initDialog": "651211001",
            "dialogues": [
                {
                    "id": "651211001",
                    "speaker": "Player",
                    "text": "这么严重…"
                },
                {
                    "id": "651211002",
                    "speaker": "安特曼",
                    "text": "唉，水涨得快退得也快，虽然现在看上去水位下去了，但谁知道还会不会再来一次。"
                }
            ]
        },
        {
            "talkId": "6512111",
            "initDialog": "651211101",
            "dialogues": [
                {
                    "id": "651211101",
                    "speaker": "Player",
                    "text": "你多小心。"
                },
                {
                    "id": "651211102",
                    "speaker": "安特曼",
                    "text": "嗯，我会的。"
                },
                {
                    "id": "651211103",
                    "speaker": "安特曼",
                    "text": "不过这里还离不开人，总得有人留在这里警戒，不能让无关人员误入这里再次遇难了。"
                }
            ]
        },
        {
            "talkId": "6512112",
            "initDialog": "651211201",
            "dialogues": [
                {
                    "id": "651211201",
                    "speaker": "安特曼",
                    "text": "哎呀，这不是老板的朋友吗，欢迎。不过白淞镇现在的环境还不太好，可能要怠慢您了。"
                }
            ]
        },
        {
            "talkId": "6512113",
            "initDialog": "651211301",
            "dialogues": [
                {
                    "id": "651211301",
                    "speaker": "Player",
                    "text": "情况如何？"
                },
                {
                    "id": "651211302",
                    "speaker": "安特曼",
                    "text": "老板说「预言」中的危机已经过去，所以镇上回来了不少人。大家一起忙活，重建的进度快了不少。"
                },
                {
                    "id": "651211303",
                    "speaker": "安特曼",
                    "text": "不过总归还是有些混乱，人们不注意的话难免摔倒受伤。所以我在此处警戒，防止镇外的人误入这里。"
                }
            ]
        },
        {
            "talkId": "6512114",
            "initDialog": "651211401",
            "dialogues": [
                {
                    "id": "651211401",
                    "speaker": "Player",
                    "text": "没关系，我来看看。"
                },
                {
                    "id": "651211402",
                    "speaker": "安特曼",
                    "text": "那您多留意脚下，注意不要受伤哦。"
                }
            ]
        },
        {
            "talkId": "6512115",
            "initDialog": "651211501",
            "dialogues": [
                {
                    "id": "651211501",
                    "speaker": "安特曼",
                    "text": "哎呀，这不是老板的朋友吗，欢迎。"
                }
            ]
        },
        {
            "talkId": "6512116",
            "initDialog": "651211601",
            "dialogues": [
                {
                    "id": "651211601",
                    "speaker": "Player",
                    "text": "可以买鱼吗？"
                },
                {
                    "id": "651211602",
                    "speaker": "安特曼",
                    "text": "没想到您真是来买鱼的，请随意挑选。"
                }
            ]
        },
        {
            "talkId": "6512117",
            "initDialog": "651211701",
            "dialogues": [
                {
                    "id": "651211701",
                    "speaker": "Player",
                    "text": "最近镇上还好吗？"
                },
                {
                    "id": "651211702",
                    "speaker": "安特曼",
                    "text": "稳步向好，大部分镇上的居民已经基本恢复原本的生活了。"
                },
                {
                    "id": "651211703",
                    "speaker": "安特曼",
                    "text": "多谢您的关心。若您再见到老板的话，也请多关照下她吧。她…实在是经历了太多事情了。"
                }
            ]
        },
        {
            "talkId": "6512118",
            "initDialog": "651211801",
            "dialogues": [
                {
                    "id": "651211801",
                    "speaker": "Player",
                    "text": "回见。"
                },
                {
                    "id": "651211802",
                    "speaker": "安特曼",
                    "text": "嗯，多谢您的关照。"
                }
            ]
        }
    ]
}