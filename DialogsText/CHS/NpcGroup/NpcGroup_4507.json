    "talks": [
        {
            "talkId": "6450701",
            "initDialog": "645070101",
            "dialogues": [
                {
                    "id": "645070101",
                    "speaker": "维尼皮",
                    "text": "#你好啊，{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6450702",
            "initDialog": "645070201",
            "dialogues": [
                {
                    "id": "645070201",
                    "speaker": "Player",
                    "text": "说说你的时代吧。"
                },
                {
                    "id": "645070202",
                    "speaker": "维尼皮",
                    "text": "我的时代？"
                },
                {
                    "id": "645070203",
                    "speaker": "维尼皮",
                    "text": "我只是个名义上的学徒，实际上的运砖工人。"
                },
                {
                    "id": "645070204",
                    "speaker": "维尼皮",
                    "text": "一定要说些什么的话…"
                },
                {
                    "id": "645070205",
                    "speaker": "维尼皮",
                    "text": "我们那个时代，所有参与赤王陵修建的工人，每天都提供两杯啤酒。"
                },
                {
                    "id": "645070206",
                    "speaker": "维尼皮",
                    "text": "真怀念啊。虽然我已经忘记那个味道了。"
                }
            ]
        },
        {
            "talkId": "6450703",
            "initDialog": "645070301",
            "dialogues": [
                {
                    "id": "645070301",
                    "speaker": "Player",
                    "text": "柯莎玛呢？"
                },
                {
                    "id": "645070302",
                    "speaker": "维尼皮",
                    "text": "柯莎玛她去统计建筑解剖损坏情况了。"
                },
                {
                    "id": "645070303",
                    "speaker": "维尼皮",
                    "text": "不用管她，这里已经安全了。"
                }
            ]
        },
        {
            "talkId": "6450704",
            "initDialog": "645070401",
            "dialogues": [
                {
                    "id": "645070401",
                    "speaker": "Player",
                    "text": "关于战斗力评级…"
                },
                {
                    "id": "645070402",
                    "speaker": "维尼皮",
                    "text": "直接给到一个顶级。"
                }
            ]
        },
        {
            "talkId": "6450705",
            "initDialog": "645070501",
            "dialogues": [
                {
                    "id": "645070501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "645070502",
                    "speaker": "维尼皮",
                    "text": "再见！"
                }
            ]
        }
    ]
}