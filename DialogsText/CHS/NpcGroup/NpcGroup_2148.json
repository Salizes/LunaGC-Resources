        "田铁嘴": 13
    },
    "talks": [
        {
            "talkId": "6214804",
            "initDialog": "621480401",
            "dialogues": [
                {
                    "id": "621480401",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6214805",
            "initDialog": "621480501",
            "dialogues": [
                {
                    "id": "621480501",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6214806",
            "initDialog": "621480601",
            "dialogues": [
                {
                    "id": "621480601",
                    "speaker": "田铁嘴",
                    "text": "精彩精彩，真是精彩的一场，让我大开眼界。"
                }
            ]
        },
        {
            "talkId": "6214807",
            "initDialog": "621480701",
            "dialogues": [
                {
                    "id": "621480701",
                    "speaker": "田铁嘴",
                    "text": "看来您还得多算算啊…"
                }
            ]
        },
        {
            "talkId": "6214808",
            "initDialog": "621480801",
            "dialogues": [
                {
                    "id": "621480801",
                    "speaker": "田铁嘴",
                    "text": "棋差一招啊，今儿真是长眼了，没想到牌还能有这种打法…"
                }
            ]
        },
        {
            "talkId": "6214809",
            "initDialog": "621480901",
            "dialogues": [
                {
                    "id": "621480901",
                    "speaker": "田铁嘴",
                    "text": "哈哈，见好就收见好就收，先就打到这儿吧！"
                }
            ]
        },
        {
            "talkId": "6214801",
            "initDialog": "621480101",
            "dialogues": [
                {
                    "id": "621480101",
                    "speaker": "田铁嘴",
                    "text": "那「茶博士刘苏」他本是我的师兄，他好讲那高雅的，登庙堂的。"
                },
                {
                    "id": "621480102",
                    "speaker": "田铁嘴",
                    "text": "而我可不屑跟他同流装什么文雅人，俗人就不配听评书了么？"
                }
            ]
        },
        {
            "talkId": "6214802",
            "initDialog": "621480201",
            "dialogues": [
                {
                    "id": "621480201",
                    "speaker": "Player",
                    "text": "（听听评书）"
                },
                {
                    "id": "621480202",
                    "speaker": "田铁嘴",
                    "text": "我就不稀罕他那讲法，这评书本就是街巷文化。"
                },
                {
                    "id": "621480203",
                    "speaker": "田铁嘴",
                    "text": "好比油盐杂碎，你若一味求雅，就好比往这杂碎里可劲儿地加什么仙露灵芝…不对味儿呀！"
                },
                {
                    "id": "621480204",
                    "speaker": "田铁嘴",
                    "text": "不懂行的可能听着过瘾，可是啊，在座的老主顾都明白，这还哪有评书的原汁原味了！"
                },
                {
                    "id": "621480205",
                    "speaker": "Player",
                    "text": "（继续听）"
                },
                {
                    "id": "621480206",
                    "speaker": "田铁嘴",
                    "text": "所以呀，我可一点都不酸这个师兄名气大、赚钱多。"
                },
                {
                    "id": "621480207",
                    "speaker": "田铁嘴",
                    "text": "当着各位老主顾的面，我就敢夸这个口——"
                },
                {
                    "id": "621480208",
                    "speaker": "田铁嘴",
                    "text": "我要是去了那什么和裕茶馆，给大家说一场书…大家还不定喜欢听谁的呢！"
                }
            ]
        },
        {
            "talkId": "6214803",
            "initDialog": "621480301",
            "dialogues": [
                {
                    "id": "621480301",
                    "speaker": "Player",
                    "text": "（不听了）"
                },
                {
                    "id": "621480302",
                    "speaker": "田铁嘴",
                    "text": "您老别不服，我要是去了那和裕茶馆，给玉京台的诸位大人说书…"
                }
            ]
        }
    ]
}