        },
        {
            "talkId": "2000005",
            "initDialog": "200000501",
            "dialogues": [
                {
                    "id": "200000501",
                    "speaker": "丹迪",
                    "text": "我是冒险家丹迪。主要活动范围是高山和险境。"
                },
                {
                    "id": "200000502",
                    "speaker": "丹迪",
                    "text": "地下世界不适合我啦，我战斗力不太行，那里又不太好爬。"
                }
            ]
        },
        {
            "talkId": "2000006",
            "initDialog": "200000601",
            "dialogues": [
                {
                    "id": "200000601",
                    "speaker": "丹迪",
                    "text": "想挑战自己速度的极限对吧？嗯嗯，我太明白你的想法了，毕竟我们的目标是星辰与深渊嘛！"
                }
            ]
        },
        {
            "talkId": "2000007",
            "initDialog": "200000701",
            "dialogues": [
                {
                    "id": "200000701",
                    "speaker": "Player",
                    "text": "开始挑战！"
                }
            ]
        },
        {
            "talkId": "2000008",
            "initDialog": "200000801",
            "dialogues": [
                {
                    "id": "200000801",
                    "speaker": "丹迪",
                    "text": "这次的目标是在100秒内，抵达终点。"
                },
                {
                    "id": "200000802",
                    "speaker": "丹迪",
                    "text": "前进吧，别输给过去的自己咯~！"
                }
            ]
        },
        {
            "talkId": "2000009",
            "initDialog": "200000901",
            "dialogues": [
                {
                    "id": "200000901",
                    "speaker": "丹迪",
                    "text": "这次的目标是在90秒内，抵达终点。"
                }
            ]
        },
        {
            "talkId": "2000010",
            "initDialog": "200001001",
            "dialogues": [
                {
                    "id": "200001001",
                    "speaker": "丹迪",
                    "text": "这次的目标是在60秒内，抵达终点。"
                }
            ]
        },
        {
            "talkId": "2000011",
            "initDialog": "200001101",
            "dialogues": [
                {
                    "id": "200001101",
                    "speaker": "丹迪",
                    "text": "你之前的成绩还不错嘛…不过伟大的冒险家，就是要学会自己突破自己。"
                },
                {
                    "id": "200001102",
                    "speaker": "丹迪",
                    "text": "我想想，这次的目标是在60秒内，抵达终点。"
                }
            ]
        },
        {
            "talkId": "2000012",
            "initDialog": "200001201",
            "dialogues": [
                {
                    "id": "200001201",
                    "speaker": "Player",
                    "text": "我的最佳成绩…"
                }
            ]
        },
        {
            "talkId": "2000013",
            "initDialog": "200001301",
            "dialogues": [
                {
                    "id": "200001301",
                    "speaker": "丹迪",
                    "text": "你的最好成绩吗，我当然还记得，是…"
                },
                {
                    "id": "200001302",
                    "speaker": "丹迪",
                    "text": "{ChallengeIndex10}"
                }
            ]
        },
        {
            "talkId": "2000014",
            "initDialog": "200001401",
            "dialogues": [
                {
                    "id": "200001401",
                    "speaker": "Player",
                    "text": "还是算了…"
                }
            ]
        },
        {
            "talkId": "2000015",
            "initDialog": "200001501",
            "dialogues": [
                {
                    "id": "200001501",
                    "speaker": "丹迪",
                    "text": "怎么啦，今天状态不好吗？那下次吧。"
                }
            ]
        },
        {
            "talkId": "2000016",
            "initDialog": "200001601",
            "dialogues": [
                {
                    "id": "200001601",
                    "speaker": "丹迪",
                    "text": "再见！祝你拥有战胜困难的勇气！"
