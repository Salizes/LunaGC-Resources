{
    "groupId": "3148",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "望月": 13
    },
    "talks": [
        {
            "talkId": "6314801",
            "initDialog": "631480101",
            "dialogues": [
                {
                    "id": "631480101",
                    "speaker": "望月",
                    "text": "现在的学者，做研究时都是如此不谨慎的吗…"
                }
            ]
        },
        {
            "talkId": "6314802",
            "initDialog": "631480201",
            "dialogues": [
                {
                    "id": "631480201",
                    "speaker": "Player",
                    "text": "你好像很苦恼。"
                },
                {
                    "id": "631480202",
                    "speaker": "望月",
                    "text": "这是因为有个须弥过来的学者，一直在传播不实的历史假说。"
                },
                {
                    "id": "631480203",
                    "speaker": "望月",
                    "text": "我也不明白他的学术理论是什么体系的，总之他研究得出的结论都是天方夜谭，歪曲事实…"
                },
                {
                    "id": "631480204",
                    "speaker": "望月",
                    "text": "他似乎还很不愿意查证，只喜欢自说自话地假设些不存在的故事，真让人头疼！"
                },
                {
                    "id": "631480205",
                    "speaker": "望月",
                    "text": "希望大家不要被他说的话误解，忘记珊瑚宫真实的历史啊…"
                }
            ]
        },
        {
            "talkId": "6314803",
            "initDialog": "631480301",
            "dialogues": [
                {
                    "id": "631480301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631480302",
                    "speaker": "望月",
                    "text": "再见，希望大家都不要被误导了啊…"
                }
            ]
        },
        {
            "talkId": "6314804",
            "initDialog": "631480401",
            "dialogues": [
                {
                    "id": "631480401",
                    "speaker": "Player",
                    "text": "关于真正的历史…"
                },
                {
                    "id": "631480402",
                    "speaker": "望月",
                    "text": "其实，海祇岛最初的神社并不在珊瑚宫，而是在岛屿西方七天神像的所在位置。"
                },
                {
                    "id": "631480403",
                    "speaker": "望月",
                    "text": "后来「海祇大御神」被雷神斩杀后，珊瑚宫便成了我们供奉「海祇大御神」的圣地。"
                },
                {
                    "id": "631480404",
                    "speaker": "望月",
                    "text": "很久以前，在我们的祖先还在海底艰难生存的时候，正是「海祇大御神」击败深海龙蜥，将我们带到了阳光普照的陆地上…"
                },
                {
                    "id": "631480405",
                    "speaker": "望月",
                    "text": "珊瑚宫上面的巨大珊瑚，便是「海祇大御神」从自己身上取下来的，珊瑚宫也因此得名。"
                }
            ]
        },
        {
            "talkId": "7294001",
            "initDialog": "729400101",
            "dialogues": [
                {
                    "id": "729400101",
                    "speaker": "Player",
                    "text": "我觉得你的说法很可信。"
                },
                {
                    "id": "729400102",
                    "speaker": "望月",
                    "text": "呼…那真是太好了。"
                },
                {
                    "id": "729400103",
                    "speaker": "望月",
                    "text": "我记得珊瑚宫大人说过，人的智慧应如真珠一般，即便在时间的作用下，光泽也耐久而不消。"
                },
                {
                    "id": "729400104",
                    "speaker": "望月",
                    "text": "这些就请你收下吧。"
                }
            ]
        }
    ]
}