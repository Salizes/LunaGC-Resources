{
    "groupId": "4194",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 6,
        "兰阿帕斯": 14
    },
    "talks": [
        {
            "talkId": "6419401",
            "initDialog": "641940101",
            "dialogues": [
                {
                    "id": "641940101",
                    "speaker": "兰阿帕斯",
                    "text": "用桓那兰那的水做的汤，香味与「活源水」炖的那锅汤差不多…"
                }
            ]
        },
        {
            "talkId": "6419402",
            "initDialog": "641940201",
            "dialogues": [
                {
                    "id": "641940201",
                    "speaker": "Player",
                    "text": "因为都是好水…"
                },
                {
                    "id": "641940202",
                    "speaker": "兰阿帕斯",
                    "text": "#那菈{NICKNAME}这话说得不错，那菈{NICKNAME}聪明，就像是一直喝着桓那兰那的水一样。"
                },
                {
                    "id": "641940203",
                    "speaker": "兰阿帕斯",
                    "text": "#这次就用桓那兰那的水做成汤招待那菈{NICKNAME}，下次一定要找到更好的水。"
                }
            ]
        },
        {
            "talkId": "6419403",
            "initDialog": "641940301",
            "dialogues": [
                {
                    "id": "641940301",
                    "speaker": "Player",
                    "text": "关键是味道…"
                },
                {
                    "id": "641940302",
                    "speaker": "兰阿帕斯",
                    "text": "味道…嗯…"
                },
                {
                    "id": "641940303",
                    "speaker": "兰阿帕斯",
                    "text": "#听说顺着河流奔腾的方向一直走呀走，面前会出现一大片味道很强烈的水，那菈{NICKNAME}是想用那种水做汤吗？"
                }
            ]
        },
        {
            "talkId": "6419404",
            "initDialog": "641940401",
            "dialogues": [
                {
                    "id": "641940401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641940402",
                    "speaker": "兰阿帕斯",
                    "text": "#再见，希望那菈{NICKNAME}能够一直喝到美味的水。"
                }
            ]
        },
        {
            "talkId": "6419405",
            "initDialog": "641940501",
            "dialogues": [
                {
                    "id": "641940501",
                    "speaker": "Player",
                    "text": "听起来强烈过头了…"
                },
                {
                    "id": "641940502",
                    "speaker": "兰阿帕斯",
                    "text": "#这样吗？那菈{NICKNAME}真奇怪，明明说有味道的水更好喝，却又不喜欢太有味道的水。"
                },
                {
                    "id": "641940503",
                    "speaker": "兰阿帕斯",
                    "text": "看来还是清澈凛冽的水更适合做汤。"
                }
            ]
        },
        {
            "talkId": "6419406",
            "initDialog": "641940601",
            "dialogues": [
                {
                    "id": "641940601",
                    "speaker": "兰阿帕斯",
                    "text": "无忧节做出的汤…很有「冲击力」，所以要去北方找更好的水。"
                }
            ]
        },
        {
            "talkId": "6419407",
            "initDialog": "641940701",
            "dialogues": [
                {
                    "id": "641940701",
                    "speaker": "Player",
                    "text": "去北方…？"
                },
                {
                    "id": "641940702",
                    "speaker": "兰阿帕斯",
                    "text": "听说北方有流淌过桓那的河流的源头的源头，那里的水比月光还要透明，盛在锅里也像是什么都没有一样。"
                },
                {
                    "id": "641940703",
                    "speaker": "兰阿帕斯",
                    "text": "#如果是这种水炖出的汤，一定会让那菈{NICKNAME}和兰那罗都很喜欢。"
                },
                {
                    "id": "641940704",
                    "speaker": "兰阿帕斯",
                    "text": "所以我的「特别烹饪修行」就是要去大树影子指向的方向，找到比桓那兰那的水更好的水。"
                }
            ]
        },
        {
            "talkId": "6419408",
            "initDialog": "641940801",
            "dialogues": [
                {
                    "id": "641940801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641940802",
                    "speaker": "兰阿帕斯",
                    "text": "#希望在北方也能遇见那菈{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6419409",
            "initDialog": "641940901",
            "dialogues": [
                {
                    "id": "641940901",
                    "speaker": "兰阿帕斯",
                    "text": "桓那兰那的水好，但是，听说，在北方，有更加甜更加清的水…"
                }
            ]
        }
    ]
}