{
    "groupId": "9035",
    "total_dialogue_lines": 64,
    "speaker_counts": {
        "Player": 20,
        "七七": 44
    },
    "talks": [
        {
            "talkId": "6903501",
            "initDialog": "690350101",
            "dialogues": [
                {
                    "id": "690350101",
                    "speaker": "七七",
                    "text": "#你好…啊，{NICKNAME}，是你。"
                },
                {
                    "id": "690350102",
                    "speaker": "七七",
                    "text": "我记得你。"
                }
            ]
        },
        {
            "talkId": "6903502",
            "initDialog": "690350201",
            "dialogues": [
                {
                    "id": "690350201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690350202",
                    "speaker": "七七",
                    "text": "嗯，这里很好。很安静。"
                },
                {
                    "id": "690350203",
                    "speaker": "七七",
                    "text": "白天也能做柔软体操，不会被人看见。"
                },
                {
                    "id": "690350204",
                    "speaker": "七七",
                    "text": "需要记住的事情，不多。",
                    "choices": [
                        {
                            "id": "690350205",
                            "text": "笔记有好好带在身边吧？",
                            "response": [
                                {
                                    "id": "690350206",
                                    "speaker": "七七",
                                    "text": "笔记？笔记…"
                                },
                                {
                                    "id": "690350207",
                                    "speaker": "七七",
                                    "text": "笔记…是什么来着？"
                                },
                                {
                                    "id": "690350211",
                                    "speaker": "Player",
                                    "text": "（糟糕…）"
                                },
                                {
                                    "id": "690350213",
                                    "speaker": "七七",
                                    "text": "没事哦。不会有问题的。"
                                },
                                {
                                    "id": "690350214",
                                    "speaker": "七七",
                                    "text": "因为七七，很厉害。"
                                }
                            ]
                        },
                        {
                            "id": "690350208",
                            "text": "七七不会忘记采药的方法吧？",
                            "response": [
                                {
                                    "id": "690350209",
                                    "speaker": "七七",
                                    "text": "采药？采药…"
                                },
                                {
                                    "id": "690350210",
                                    "speaker": "七七",
                                    "text": "采药…是什么来着？"
                                },
                                {
                                    "id": "690350212",
                                    "speaker": "Player",
                                    "text": "我会帮你想起来的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903503",
            "initDialog": "690350301",
            "dialogues": [
                {
                    "id": "690350301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690350302",
                    "speaker": "七七",
                    "text": "聊天…聊天…"
                },
                {
                    "id": "690350303",
                    "speaker": "七七",
                    "text": "跟你聊天，是一件很舒服的事情。"
                },
                {
                    "id": "690350304",
                    "speaker": "七七",
                    "text": "但是…"
                },
                {
                    "id": "690350305",
                    "speaker": "Player",
                    "text": "怎么了吗？"
                },
                {
                    "id": "690350306",
                    "speaker": "七七",
                    "text": "…会忘记。"
                },
                {
                    "id": "690350307",
                    "speaker": "七七",
                    "text": "聊天的内容，会忘记。"
                },
                {
                    "id": "690350308",
                    "speaker": "七七",
                    "text": "声音的语调，会忘记。"
                },
                {
                    "id": "690350309",
                    "speaker": "七七",
                    "text": "开心的感觉…会忘记…",
                    "choices": [
                        {
                            "id": "690350310",
                            "text": "只要这一刻的七七是开心的就好。",
                            "response": [
                                {
                                    "id": "690350311",
                                    "speaker": "七七",
                                    "text": "啊…是这样吗。"
                                },
                                {
                                    "id": "690350312",
                                    "speaker": "七七",
                                    "text": "嗯…如果我现在难过的话，你也会难过的。"
                                },
                                {
                                    "id": "690350316",
                                    "speaker": "七七",
                                    "text": "嗯，七七要，笑一个。"
                                },
                                {
                                    "id": "690350317",
                                    "speaker": "Player",
                                    "text": "七七笑起来很可爱。"
                                },
                                {
                                    "id": "690350318",
                                    "speaker": "七七",
                                    "text": "啊…"
                                },
                                {
                                    "id": "690350319",
                                    "speaker": "七七",
                                    "text": "…因为有你，在我身边。"
                                }
                            ]
                        },
                        {
                            "id": "690350313",
                            "text": "我会天天都来跟七七聊天。",
                            "response": [
                                {
                                    "id": "690350314",
                                    "speaker": "七七",
                                    "text": "天天…都来。"
                                },
                                {
                                    "id": "690350315",
                                    "speaker": "七七",
                                    "text": "那我，天天都会是…开心的？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903504",
            "initDialog": "690350401",
            "dialogues": [
                {
                    "id": "690350401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690350402",
                    "speaker": "七七",
                    "text": "想要养…小团雀。"
                },
                {
                    "id": "690350403",
                    "speaker": "七七",
                    "text": "和你一起，在这个家里，养小团雀。"
                },
                {
                    "id": "690350404",
                    "speaker": "七七",
                    "text": "你找来小谷子。我来喂小团雀。"
                },
                {
                    "id": "690350405",
                    "speaker": "七七",
                    "text": "给它也搭一个窝，风吹不断，雨打不坏。"
                },
                {
                    "id": "690350406",
                    "speaker": "七七",
                    "text": "白天，我陪它散步。睡前，一起做柔软体操。",
                    "choices": [
                        {
                            "id": "690350407",
                            "text": "七七就像姐姐一样呢。",
                            "response": [
                                {
                                    "id": "690350409",
                                    "speaker": "七七",
                                    "text": "嗯！我会做好榜样。"
                                },
                                {
                                    "id": "690350410",
                                    "speaker": "七七",
                                    "text": "我会保护它，也会保护你。",
                                    "choices": [
                                        {
                                            "id": "690350411",
                                            "text": "保护你们也是我的责任哦。",
                                            "response": [
                                                {
                                                    "id": "690350413",
                                                    "speaker": "七七",
                                                    "text": "嗯！"
                                                },
                                                {
                                                    "id": "690350414",
                                                    "speaker": "七七",
                                                    "text": "你，七七，小团雀…"
                                                },
                                                {
                                                    "id": "690350415",
                                                    "speaker": "七七",
                                                    "text": "太好啦…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690350412",
                                            "text": "那就要辛苦七七啦。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690350408",
                            "text": "一定会健康长大的。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903505",
            "initDialog": "690350501",
            "dialogues": [
                {
                    "id": "690350501",
                    "speaker": "Player",
                    "text": "早啊，七七。"
                },
                {
                    "id": "690350502",
                    "speaker": "七七",
                    "text": "#早哦，{NICKNAME}。"
                },
                {
                    "id": "690350503",
                    "speaker": "七七",
                    "text": "别忘记，带东西。"
                }
            ]
        },
        {
            "talkId": "6903506",
            "initDialog": "690350601",
            "dialogues": [
                {
                    "id": "690350601",
                    "speaker": "Player",
                    "text": "晚安，七七。"
                },
                {
                    "id": "690350602",
                    "speaker": "七七",
                    "text": "晚安，梦里我也会保护你。"
                }
            ]
        },
        {
            "talkId": "6903507",
            "initDialog": "690350701",
            "dialogues": [
                {
                    "id": "690350701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6903508",
            "initDialog": "690350801",
            "dialogues": [
                {
                    "id": "690350801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6903509",
            "initDialog": "690350901",
            "dialogues": [
                {
                    "id": "690350901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6903550",
            "initDialog": "690355001",
            "dialogues": [
                {
                    "id": "690355001",
                    "speaker": "七七",
                    "text": "感觉…很熟悉，让我看看笔记。"
                },
                {
                    "id": "690355002",
                    "speaker": "七七",
                    "text": "对，采药的时候，也是在这样的地方，休息。"
                },
                {
                    "id": "690355003",
                    "speaker": "七七",
                    "text": "确认安全，谢谢。"
                }
            ]
        },
        {
            "talkId": "6903551",
            "initDialog": "690355101",
            "dialogues": [
                {
                    "id": "690355101",
                    "speaker": "七七",
                    "text": "笔记上，没有记录这里。"
                },
                {
                    "id": "690355102",
                    "speaker": "七七",
                    "text": "但是这里很安静，喜欢，以后可以经常来吗？"
                },
                {
                    "id": "690355103",
                    "speaker": "七七",
                    "text": "记在笔记上了，谢谢你。"
                }
            ]
        }
    ]
}