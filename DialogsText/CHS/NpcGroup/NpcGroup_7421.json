{
    "groupId": "7421",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "格罗莫夫": 9
    },
    "talks": [
        {
            "talkId": "6742101",
            "initDialog": "674210101",
            "dialogues": [
                {
                    "id": "674210101",
                    "speaker": "格罗莫夫",
                    "text": "呃，下一步是什么来着？"
                }
            ]
        },
        {
            "talkId": "6742102",
            "initDialog": "674210201",
            "dialogues": [
                {
                    "id": "674210201",
                    "speaker": "Player",
                    "text": "你在干什么？"
                },
                {
                    "id": "674210202",
                    "speaker": "格罗莫夫",
                    "text": "…喔，天哪，您吓了我一跳，客人。"
                },
                {
                    "id": "674210203",
                    "speaker": "格罗莫夫",
                    "text": "我、我在想菜单上的一道菜要怎么做，我…我之前只是个学徒，不过最近带我的老师傅因为腰痛休息了…"
                },
                {
                    "id": "674210204",
                    "speaker": "格罗莫夫",
                    "text": "说不定之后酒店里大菜的活会交给我，我得认真想一遍这道菜的所有细节，等到开工的时候，才不会手忙脚乱…"
                }
            ]
        },
        {
            "talkId": "6742103",
            "initDialog": "674210301",
            "dialogues": [
                {
                    "id": "674210301",
                    "speaker": "Player",
                    "text": "现在忙吗？"
                },
                {
                    "id": "674210302",
                    "speaker": "格罗莫夫",
                    "text": "还、还好…有点忙，但是每天都差不多。我们的老板是个好人，从不会为了多赚点钱而让我们多干活…"
                },
                {
                    "id": "674210303",
                    "speaker": "格罗莫夫",
                    "text": "前段时间还有客人说：「为什么不能外送订单！蒙德那边就能这样干！」"
                },
                {
                    "id": "674210304",
                    "speaker": "格罗莫夫",
                    "text": "真要接外送订单，那我的尾巴都要拿起菜刀了，幸好老板拒绝了…老板说：「真想吃！就该到店里来吃热乎的！」"
                },
                {
                    "id": "674210305",
                    "speaker": "格罗莫夫",
                    "text": "…嘿嘿，说这话的老板还挺帅气的。"
                }
            ]
        },
        {
            "talkId": "6742104",
            "initDialog": "674210401",
            "dialogues": [
                {
                    "id": "674210401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674210402",
                    "speaker": "格罗莫夫",
                    "text": "再见，嗯…师傅怎么说的来着，让我再想清楚一些…"
                }
            ]
        }
    ]
}