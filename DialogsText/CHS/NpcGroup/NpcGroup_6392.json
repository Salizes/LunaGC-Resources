{
    "groupId": "6392",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "厄达尔夫": 10
    },
    "talks": [
        {
            "talkId": "6639201",
            "initDialog": "663920101",
            "dialogues": [
                {
                    "id": "663920101",
                    "speaker": "厄达尔夫",
                    "text": "呃啊…明明是第一次品尝到沃陆之邦的美食，明明是很美味的餐点，但是，为什么，会变成这样呢…"
                }
            ]
        },
        {
            "talkId": "6639202",
            "initDialog": "663920201",
            "dialogues": [
                {
                    "id": "663920201",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "663920202",
                    "speaker": "厄达尔夫",
                    "text": "啊，你好！事情是这样的，我是厄达尔夫，来自蒙德，是个冒险家。"
                },
                {
                    "id": "663920203",
                    "speaker": "厄达尔夫",
                    "text": "我听说沃陆之邦的食物不仅无比美味，而且特别健康，就特意点了他们的招牌单人套餐…"
                },
                {
                    "id": "663920204",
                    "speaker": "厄达尔夫",
                    "text": "可是你看——这份量，也太过分了吧！"
                },
                {
                    "id": "663920205",
                    "speaker": "厄达尔夫",
                    "text": "这怎么可能是一个人吃得完的嘛！难道当地人平时都是这样「冒险」的吗？"
                }
            ]
        },
        {
            "talkId": "6639203",
            "initDialog": "663920301",
            "dialogues": [
                {
                    "id": "663920301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "663920302",
                    "speaker": "厄达尔夫",
                    "text": "嗯，再见，祝你有个好胃口，也祝我下次能点个合适的分量吧。"
                }
            ]
        },
        {
            "talkId": "6639204",
            "initDialog": "663920401",
            "dialogues": [
                {
                    "id": "663920401",
                    "speaker": "Player",
                    "text": "打包带走不就好了嘛。"
                },
                {
                    "id": "663920402",
                    "speaker": "厄达尔夫",
                    "text": "是呀，我也这么想，但总觉得有点失礼，毕竟店家这么热情，还特地介绍说「吃完就能成为像突角龙一样强壮的战士」…"
                },
                {
                    "id": "663920403",
                    "speaker": "厄达尔夫",
                    "text": "不过，要是实在吃不完的话，应该就只能打包了，再怎么说也不能浪费嘛…"
                }
            ]
        },
        {
            "talkId": "6639205",
            "initDialog": "663920501",
            "dialogues": [
                {
                    "id": "663920501",
                    "speaker": "Player",
                    "text": "为什么不直接告诉他们吃不完呢？"
                },
                {
                    "id": "663920502",
                    "speaker": "厄达尔夫",
                    "text": "嗯，这我也想过，可当地人似乎觉得，食物是用来传递友谊的，剩下太多说不定会像是在拒绝他们的好意…"
                },
                {
                    "id": "663920503",
                    "speaker": "厄达尔夫",
                    "text": "唉，算了，下次一定记得只点半份！"
                }
            ]
        }
    ]
}