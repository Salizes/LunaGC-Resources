{
    "groupId": "5070",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "薇托维娅": 9
    },
    "talks": [
        {
            "talkId": "6507001",
            "initDialog": "650700101",
            "dialogues": [
                {
                    "id": "650700101",
                    "speaker": "薇托维娅",
                    "text": "有什么法律代理方面的内容能帮到您吗？"
                }
            ]
        },
        {
            "talkId": "6507002",
            "initDialog": "650700201",
            "dialogues": [
                {
                    "id": "650700201",
                    "speaker": "Player",
                    "text": "你是…代理人？"
                },
                {
                    "id": "650700202",
                    "speaker": "薇托维娅",
                    "text": "不…虽说曾经想过要当决斗代理人，但我这辈子都当不上了…"
                },
                {
                    "id": "650700203",
                    "speaker": "薇托维娅",
                    "text": "我不会打架，真的一窍不通，剑收在鞘里都能敲到自己脑袋那种…"
                },
                {
                    "id": "650700204",
                    "speaker": "薇托维娅",
                    "text": "不过我有一个天赋，就是擅长检索。只要案件清晰，我就能快速找到与之有关的所有法律条文。"
                }
            ]
        },
        {
            "talkId": "6507003",
            "initDialog": "650700301",
            "dialogues": [
                {
                    "id": "650700301",
                    "speaker": "Player",
                    "text": "这是…法律咨询？"
                },
                {
                    "id": "650700302",
                    "speaker": "薇托维娅",
                    "text": "准确来说，是「如何跳脱法律」的咨询。"
                },
                {
                    "id": "650700303",
                    "speaker": "薇托维娅",
                    "text": "我的目标，就是不让客户和决斗代理人面对面，也无需进入歌剧院——看演出除外。"
                },
                {
                    "id": "650700304",
                    "speaker": "薇托维娅",
                    "text": "这不难办到，任何法律都有其不足所在，我熟悉它们就像熟悉自己袜子上破了几个洞一样。"
                },
                {
                    "id": "650700305",
                    "speaker": "薇托维娅",
                    "text": "呃…这么说来，是该花钱买双新袜子了…"
                }
            ]
        },
        {
            "talkId": "6507004",
            "initDialog": "650700401",
            "dialogues": [
                {
                    "id": "650700401",
                    "speaker": "Player",
                    "text": "没有。"
                },
                {
                    "id": "650700402",
                    "speaker": "薇托维娅",
                    "text": "真遗憾…啊不，我是说，真幸运！"
                }
            ]
        }
    ]
}