{
    "groupId": "4043",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "曼苏尔": 11
    },
    "talks": [
        {
            "talkId": "6404301",
            "initDialog": "640430101",
            "dialogues": [
                {
                    "id": "640430101",
                    "speaker": "曼苏尔",
                    "text": "没想到啊，打铁比写论文有意思多了…"
                }
            ]
        },
        {
            "talkId": "6404302",
            "initDialog": "640430201",
            "dialogues": [
                {
                    "id": "640430201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640430202",
                    "speaker": "曼苏尔",
                    "text": "我是教令院生论派的学者，因为正在憋…呃，我是说写空气污染相关课题的论文，专门来铁匠铺考察。"
                },
                {
                    "id": "640430203",
                    "speaker": "曼苏尔",
                    "text": "结果没想到看着看着，竟然对打铁产生了兴趣，一不小心就成了阿汉格尔先生的学徒…"
                },
                {
                    "id": "640430204",
                    "speaker": "曼苏尔",
                    "text": "现在说退出好像有点晚了。阿汉格尔先生虽然收养了很多孩子，但他们不是去当了学者，就是加入了镀金旅团。"
                },
                {
                    "id": "640430205",
                    "speaker": "曼苏尔",
                    "text": "而我，一个整天为论文烦心的研究员，竟然成为了他打铁手艺的唯一继承人…"
                },
                {
                    "id": "640430206",
                    "speaker": "曼苏尔",
                    "text": "不过你别说，打铁倒确实比写论文有趣多了。我不仅体力变好了，连头发也不怎么掉了。"
                }
            ]
        },
        {
            "talkId": "6404303",
            "initDialog": "640430301",
            "dialogues": [
                {
                    "id": "640430301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640430302",
                    "speaker": "曼苏尔",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6404304",
            "initDialog": "640430401",
            "dialogues": [
                {
                    "id": "640430401",
                    "speaker": "Player",
                    "text": "以后准备怎么办？"
                },
                {
                    "id": "640430402",
                    "speaker": "曼苏尔",
                    "text": "总之我现在一边在教令院面前瞒住铁匠铺严重的空气污染问题，一边在阿汉格尔先生这里拖延实习的时间…"
                },
                {
                    "id": "640430403",
                    "speaker": "曼苏尔",
                    "text": "反正有了学徒之后，阿汉格尔先生看上去挺高兴的。我的工钱也还够吃饭，就先这样吧，走一步看一步了。"
                }
            ]
        },
        {
            "talkId": "7393201",
            "initDialog": "739320101",
            "dialogues": [
                {
                    "id": "739320101",
                    "speaker": "Player",
                    "text": "那论文呢？"
                },
                {
                    "id": "739320102",
                    "speaker": "曼苏尔",
                    "text": "可以了可以了…"
                },
                {
                    "id": "739320103",
                    "speaker": "曼苏尔",
                    "text": "给你这个，当作…呃，封口费！请不要再问论文的事情了。一听这个我就头秃…"
                }
            ]
        }
    ]
}