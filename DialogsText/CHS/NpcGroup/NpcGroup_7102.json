{
    "groupId": "7102",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "欧西安": 8
    },
    "talks": [
        {
            "talkId": "6710201",
            "initDialog": "671020101",
            "dialogues": [
                {
                    "id": "671020101",
                    "speaker": "欧西安",
                    "text": "留在这种地方，简直是浪费我的青春…"
                }
            ]
        },
        {
            "talkId": "6710202",
            "initDialog": "671020201",
            "dialogues": [
                {
                    "id": "671020201",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "671020202",
                    "speaker": "欧西安",
                    "text": "呜哇！你、你是谁啊？突然出声！…咳，没什么，我就是自言自语而已啦！"
                },
                {
                    "id": "671020203",
                    "speaker": "欧西安",
                    "text": "不过，天天待在这种遗迹里，不是背无聊的祷歌，就是帮我姐整理那些永远也整理不完的旧书…这样下去，我的青春要毁了！"
                }
            ]
        },
        {
            "talkId": "6710203",
            "initDialog": "671020301",
            "dialogues": [
                {
                    "id": "671020301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "671020302",
                    "speaker": "欧西安",
                    "text": "唉，再见。要是我也能出去冒险就好了…"
                }
            ]
        },
        {
            "talkId": "6710204",
            "initDialog": "671020401",
            "dialogues": [
                {
                    "id": "671020401",
                    "speaker": "Player",
                    "text": "那你想干什么？"
                },
                {
                    "id": "671020402",
                    "speaker": "欧西安",
                    "text": "我？我当然想去冒险啊！就像那些自由自在的宝藏猎人，或者传说中的大盗雷德·米勒那样！"
                },
                {
                    "id": "671020403",
                    "speaker": "欧西安",
                    "text": "探索未知的秘境，寻找传说中的宝藏，和温馨又迷人的美丽少女们一起冒险…这才是我应该做的事嘛！"
                }
            ]
        },
        {
            "talkId": "6710205",
            "initDialog": "671020501",
            "dialogues": [
                {
                    "id": "671020501",
                    "speaker": "Player",
                    "text": "你姐姐是…"
                },
                {
                    "id": "671020502",
                    "speaker": "欧西安",
                    "text": "安洛丝，就是「咏月使」大人的副手…呃，刚才说的那些话，还请千万不要告诉她。"
                },
                {
                    "id": "671020503",
                    "speaker": "欧西安",
                    "text": "要是被她知道我又在抱怨不想待在这里，肯定又要抓着我说教好几个小时了…"
                }
            ]
        }
    ]
}