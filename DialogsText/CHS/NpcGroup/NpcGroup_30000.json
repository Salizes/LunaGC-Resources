{
    "groupId": "30000",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "阿祇": 8
    },
    "talks": [
        {
            "talkId": "4004801",
            "initDialog": "400480101",
            "dialogues": [
                {
                    "id": "400480101",
                    "speaker": "阿祇",
                    "text": "清除黑雾之事，进行得怎么样了？"
                }
            ]
        },
        {
            "talkId": "4004805",
            "initDialog": "400480102",
            "dialogues": [
                {
                    "id": "400480102",
                    "speaker": "Player",
                    "text": "关于三座塔…"
                },
                {
                    "id": "400480103",
                    "speaker": "阿祇",
                    "text": "三座塔都建设在地脉节点上，用来平衡龙蜥、深渊和人类的力量。"
                },
                {
                    "id": "400480104",
                    "speaker": "阿祇",
                    "text": "被那个人改造之后，他们正在强化深渊的力量。"
                }
            ]
        },
        {
            "talkId": "4004806",
            "initDialog": "400480105",
            "dialogues": [
                {
                    "id": "400480105",
                    "speaker": "Player",
                    "text": "关于阿祇…"
                },
                {
                    "id": "400480106",
                    "speaker": "阿祇",
                    "text": "我并不值得一提。"
                },
                {
                    "id": "400480107",
                    "speaker": "阿祇",
                    "text": "也是芸芸众生的一员吧，现在想的是怎么活下去。怎么帮助同胞。"
                }
            ]
        },
        {
            "talkId": "4004807",
            "initDialog": "400480108",
            "dialogues": [
                {
                    "id": "400480108",
                    "speaker": "Player",
                    "text": "关于千灯…"
                },
                {
                    "id": "400480109",
                    "speaker": "阿祇",
                    "text": "千灯的仪式以前被人们拿来驱逐龙蜥。这是人界力量和龙蜥界力量的对抗。"
                },
                {
                    "id": "400480110",
                    "speaker": "阿祇",
                    "text": "这个灯塔修好之后，千灯仪式就用得少了。不过作为人界秘法，对抗虚界黑雾也很有效果。"
                }
            ]
        },
        {
            "talkId": "4004808",
            "initDialog": "400480111",
            "dialogues": [
                {
                    "id": "400480111",
                    "speaker": "Player",
                    "text": "还在努力解决中。"
                },
                {
                    "id": "400480112",
                    "speaker": "阿祇",
                    "text": "期待你的好消息。"
                }
            ]
        }
    ]
}