{
    "groupId": "4124",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "艾依曼": 13
    },
    "talks": [
        {
            "talkId": "6412401",
            "initDialog": "641240101",
            "dialogues": [
                {
                    "id": "641240101",
                    "speaker": "艾依曼",
                    "text": "你好啊！欢迎光临迪亚法饭店，快请坐。"
                }
            ]
        },
        {
            "talkId": "6412402",
            "initDialog": "641240201",
            "dialogues": [
                {
                    "id": "641240201",
                    "speaker": "Player",
                    "text": "关于迪亚法饭店…"
                },
                {
                    "id": "641240202",
                    "speaker": "艾依曼",
                    "text": "客人在奥摩斯港，来我这迪亚法饭店吃饭，可真是选对地方了。"
                },
                {
                    "id": "641240203",
                    "speaker": "艾依曼",
                    "text": "最棒的美酒，最好的美食，还有最热情的招待，在我们店里都能找到。"
                },
                {
                    "id": "641240204",
                    "speaker": "艾依曼",
                    "text": "来者是客，无论客人是从哪来的，要做什么，只要坐下来喝酒吃肉，便不论出处，都是朋友！"
                }
            ]
        },
        {
            "talkId": "6412403",
            "initDialog": "641240301",
            "dialogues": [
                {
                    "id": "641240301",
                    "speaker": "Player",
                    "text": "好久不见咯。"
                },
                {
                    "id": "641240302",
                    "speaker": "艾依曼",
                    "text": "哎呀哎呀…这不是我的老主顾吗。"
                },
                {
                    "id": "641240303",
                    "speaker": "艾依曼",
                    "text": "不瞒您说，我以前是行走沙漠的旅行商人，好不容易攒了钱才在这开了这家店。"
                },
                {
                    "id": "641240304",
                    "speaker": "艾依曼",
                    "text": "沙漠里的生活不好过啊，我那时曾经受了不少镀金旅团的照顾，这才一时鬼迷心窍，帮了那些不法分子的忙。"
                },
                {
                    "id": "641240305",
                    "speaker": "艾依曼",
                    "text": "现在我已经不和那些坏家伙联系了，您大人有大量，就忘了那些事吧。"
                }
            ]
        },
        {
            "talkId": "6412404",
            "initDialog": "641240401",
            "dialogues": [
                {
                    "id": "641240401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641240402",
                    "speaker": "艾依曼",
                    "text": "好酒不等人，欢迎下次再来！"
                }
            ]
        },
        {
            "talkId": "7390801",
            "initDialog": "739080101",
            "dialogues": [
                {
                    "id": "739080101",
                    "speaker": "Player",
                    "text": "还有什么要交代的？"
                },
                {
                    "id": "739080102",
                    "speaker": "艾依曼",
                    "text": "还有…还有…就是为了饭店的生意，偶尔去弄些「好酒」罢了。"
                },
                {
                    "id": "739080103",
                    "speaker": "艾依曼",
                    "text": "您要是喜欢的话，要不拿些酒回去？就当是之前的赔礼了。"
                },
                {
                    "id": "739080104",
                    "speaker": "艾依曼",
                    "text": "不要酒啊？那…我这有把镀金旅团的人留给我的好剑，送给您吧。"
                },
                {
                    "id": "739080105",
                    "speaker": "艾依曼",
                    "text": "奥摩斯港确实人员混杂，有个能拿来防身的东西比较好。"
                }
            ]
        }
    ]
}