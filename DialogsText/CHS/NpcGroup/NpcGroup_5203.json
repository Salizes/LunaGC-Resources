{
    "groupId": "5203",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 2,
        "恩肖": 2,
        "莉诺尔": 10
    },
    "talks": [
        {
            "talkId": "6520301",
            "initDialog": "652030101",
            "dialogues": [
                {
                    "id": "652030101",
                    "speaker": "莉诺尔",
                    "text": "真可惜，如果卡特哥哥也在的话，就可以一起分享了。"
                },
                {
                    "id": "652030102",
                    "speaker": "恩肖",
                    "text": "哪怕卡特哥哥在这里，今天也不能再喝枫达了。"
                },
                {
                    "id": "652030103",
                    "speaker": "莉诺尔",
                    "text": "欸——可是卡特哥哥说过，和大家分享，快乐才会变多！"
                },
                {
                    "id": "652030104",
                    "speaker": "恩肖",
                    "text": "卡特哥哥肯定还说过，甜食不要吃太多，吃完记得刷牙。"
                },
                {
                    "id": "652030105",
                    "speaker": "莉诺尔",
                    "text": "唔…他的确这么说过…"
                }
            ]
        },
        {
            "talkId": "6520302",
            "initDialog": "652030201",
            "dialogues": [
                {
                    "id": "652030201",
                    "speaker": "莉诺尔",
                    "text": "不知道卡特哥哥喜欢什么样的蛋糕呢…"
                }
            ]
        },
        {
            "talkId": "6520303",
            "initDialog": "652030301",
            "dialogues": [
                {
                    "id": "652030301",
                    "speaker": "Player",
                    "text": "蛋糕？"
                },
                {
                    "id": "652030302",
                    "speaker": "莉诺尔",
                    "text": "喔，我在想，等卡特哥哥生日，要做什么样的生日蛋糕！"
                },
                {
                    "id": "652030303",
                    "speaker": "莉诺尔",
                    "text": "…因为仔细想想，他老是把吃的东西让给我，我都不知道卡特哥哥喜欢吃什么。"
                },
                {
                    "id": "652030304",
                    "speaker": "莉诺尔",
                    "text": "他喜欢吃泡泡桔吗？还是日落果？唔，既然他的颜色是那样的，可能喜欢薄荷？"
                },
                {
                    "id": "652030305",
                    "speaker": "莉诺尔",
                    "text": "#不过，更重要的是，要找到卡特哥哥。{NICKNAME}{M#哥哥}{F#姐姐}要等我长大，一起去找卡特哥哥。"
                }
            ]
        },
        {
            "talkId": "6520304",
            "initDialog": "652030401",
            "dialogues": [
                {
                    "id": "652030401",
                    "speaker": "Player",
                    "text": "加油，莉诺尔。"
                },
                {
                    "id": "652030402",
                    "speaker": "莉诺尔",
                    "text": "嗯！我一定要做出最好吃的生日蛋糕。"
                },
                {
                    "id": "652030403",
                    "speaker": "莉诺尔",
                    "text": "#啊，不知道{NICKNAME}{M#哥哥}{F#姐姐}和派蒙姐姐什么时候生日…"
                }
            ]
        }
    ]
}