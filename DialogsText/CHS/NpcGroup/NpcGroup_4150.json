    "talks": [
        {
            "talkId": "6415001",
            "initDialog": "641500101",
            "dialogues": [
                {
                    "id": "641500101",
                    "speaker": "萨蒂",
                    "text": "大家说得果然没错，跟着老爷做生意，一定稳赚不赔！"
                }
            ]
        },
        {
            "talkId": "6415002",
            "initDialog": "641500201",
            "dialogues": [
                {
                    "id": "641500201",
                    "speaker": "Player",
                    "text": "老爷？"
                },
                {
                    "id": "641500202",
                    "speaker": "萨蒂",
                    "text": "你没听说过吗？就是在我们商人之中名声显赫的桑歌玛哈巴依老爷！"
                },
                {
                    "id": "641500203",
                    "speaker": "萨蒂",
                    "text": "虽然很多人都没见过老爷本人，但只要是老爷透露的商业情报，信就完事了，跟着做一定能赚钱！"
                },
                {
                    "id": "641500204",
                    "speaker": "萨蒂",
                    "text": "你看我这批毛毯，因为质量好造价高，本来还怕没销路折在手里。"
                },
                {
                    "id": "641500205",
                    "speaker": "萨蒂",
                    "text": "但老爷说了，放心，一定赚！我就大胆开价了。"
                },
                {
                    "id": "641500206",
                    "speaker": "萨蒂",
                    "text": "结果果然卖得不错，就算付了一大笔中介费，仍旧稳赚不赔！"
                }
            ]
        },
        {
            "talkId": "6415003",
            "initDialog": "641500301",
            "dialogues": [
                {
                    "id": "641500301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641500302",
                    "speaker": "萨蒂",
                    "text": "再见！相信老爷，大家都能赚大钱！"
                }
            ]
        }
    ]
}