{
    "groupId": "1469",
    "total_dialogue_lines": 47,
    "speaker_counts": {
        "Player": 11,
        "艾尔菲": 36
    },
    "talks": [
        {
            "talkId": "40173",
            "initDialog": "4015146901",
            "dialogues": [
                {
                    "id": "4015146901",
                    "speaker": "艾尔菲",
                    "text": "欸~冒险家协会情报部的艾尔菲在此~！"
                },
                {
                    "id": "4015146902",
                    "speaker": "艾尔菲",
                    "text": "有什么能提供给我的情报吗？"
                }
            ]
        },
        {
            "talkId": "40198",
            "initDialog": "4015146961",
            "dialogues": [
                {
                    "id": "4015146961",
                    "speaker": "艾尔菲",
                    "text": "风声似乎有点大，请大声一点说话哦。",
                    "choices": [
                        {
                            "id": "4015146962",
                            "text": "我想要调整队伍成员。",
                            "response": [
                                {
                                    "id": "4015146963",
                                    "speaker": "Player",
                                    "text": "在这样的天气下吗…简直像是天生的冒险家一样呢~！"
                                },
                                {
                                    "id": "4015146964",
                                    "speaker": "艾尔菲",
                                    "text": "没问题，艾尔菲这就为你召集伙伴！"
                                }
                            ]
                        },
                        {
                            "id": "4015146965",
                            "text": "关于你自己。",
                            "response": [
                                {
                                    "id": "4015146967",
                                    "speaker": "艾尔菲",
                                    "text": "现在不是自我介绍的时候，快点进屋里避难吧。"
                                },
                                {
                                    "id": "4015146968",
                                    "speaker": "艾尔菲",
                                    "text": "我没问题的，作为冒险家，在大风天的室外生存可是基本功呢！"
                                }
                            ]
                        },
                        {
                            "id": "4015146966",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "4015146969",
                                    "speaker": "艾尔菲",
                                    "text": "别被大风吹跑了哦~~~~！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "41601",
            "initDialog": "4015146903",
            "dialogues": [
                {
                    "id": "4015146903",
                    "speaker": "Player",
                    "text": "我想要调整队伍成员。"
                },
                {
                    "id": "4015146907",
                    "speaker": "艾尔菲",
                    "text": "没问题！马上帮你召集伙伴~！"
                }
            ]
        },
        {
            "talkId": "41602",
            "initDialog": "4015146930",
            "dialogues": [
                {
                    "id": "4015146930",
                    "speaker": "艾尔菲",
                    "text": "我想了解冒险情报。"
                },
                {
                    "id": "4015146970",
                    "speaker": "艾尔菲",
                    "text": "冒险情报啊，根据不同的冒险等阶，协会对冒险区域有不同的推荐哦。"
                },
                {
                    "id": "4015146931",
                    "speaker": "艾尔菲",
                    "text": "你想知道哪个级别的情报呢？"
                },
                {
                    "id": "4015146932",
                    "speaker": "艾尔菲",
                    "text": "等阶1-5"
                },
                {
                    "id": "4015146937",
                    "speaker": "艾尔菲",
                    "text": "新手冒险家的话，<color=#00E1FFFF>风起地</color>可能会很合适哦。"
                },
                {
                    "id": "4015146938",
                    "speaker": "艾尔菲",
                    "text": "从蒙德的正门出去，过了桥，面前的大平原就是<color=#00E1FFFF>风起地</color>。"
                },
                {
                    "id": "4015146939",
                    "speaker": "艾尔菲",
                    "text": "你还想了解哪个阶段的情报呢？"
                }
            ]
        },
        {
            "talkId": "41603",
            "initDialog": "4015146920",
            "dialogues": [
                {
                    "id": "4015146920",
                    "speaker": "Player",
                    "text": "想了解些事情。"
                },
                {
                    "id": "4015146921",
                    "speaker": "艾尔菲",
                    "text": "那就尽管问吧，为协会成员解答疑惑也是情报部的职责呀，嘿嘿。",
                    "choices": [
                        {
                            "id": "4015146904",
                            "text": "关于冒险家协会。",
                            "response": [
                                {
                                    "id": "4015146908",
                                    "speaker": "艾尔菲",
                                    "text": "向着星辰与深渊~！"
                                },
                                {
                                    "id": "4015146909",
                                    "speaker": "艾尔菲",
                                    "text": "大体上就是喜欢冒险的朋友们的聚集地啦，帮助民众或者组织解决各种麻烦。"
                                },
                                {
                                    "id": "4015146910",
                                    "speaker": "艾尔菲",
                                    "text": "当然冒险家也是要吃饭的嘛，完成各种「委托」还会有奖励拿哦。"
                                },
                                {
                                    "id": "4015146911",
                                    "speaker": "艾尔菲",
                                    "text": "前台接待是凯瑟琳小姐负责哦。"
                                },
                                {
                                    "id": "4015146912",
                                    "speaker": "艾尔菲",
                                    "text": "既然你感兴趣，请一定要过去看看~！"
                                }
                            ]
                        },
                        {
                            "id": "4015146905",
                            "text": "关于你自己…",
                            "response": [
                                {
                                    "id": "4015146913",
                                    "speaker": "艾尔菲",
                                    "text": "我吗？没什么大不了的啦。"
                                },
                                {
                                    "id": "4015146914",
                                    "speaker": "艾尔菲",
                                    "text": "硬要说的话，大概就是…全提瓦特没有我不认识的人吧。"
                                },
                                {
                                    "id": "4015146915",
                                    "speaker": "艾尔菲",
                                    "text": "哦？这很了不起吗…其实还是依靠冒险家协会情报部的资源。"
                                },
                                {
                                    "id": "4015146916",
                                    "speaker": "艾尔菲",
                                    "text": "顺便我也是情报部的成员，除了帮忙联络和引导的工作外，时刻竖起耳朵收集情报也是我的任务哦。"
                                },
                                {
                                    "id": "4015146917",
                                    "speaker": "艾尔菲",
                                    "text": "你看我们已经聊了这么多，我们可以说是朋友了吧？"
                                },
                                {
                                    "id": "4015146918",
                                    "speaker": "艾尔菲",
                                    "text": "来来，快讲讲你的事情给我听吧！"
                                }
                            ]
                        },
                        {
                            "id": "4015146922",
                            "text": "关于情报部…",
                            "response": [
                                {
                                    "id": "4015146923",
                                    "speaker": "艾尔菲",
                                    "text": "情报部的大多数情况都不会直接参与委托，而是通过提供情报的方式来支援执行委托的冒险家。"
                                },
                                {
                                    "id": "4015146924",
                                    "speaker": "艾尔菲",
                                    "text": "简单来说，我们情报部的运作可以分为「收集」和「整理」两个部分。"
                                },
                                {
                                    "id": "4015146925",
                                    "speaker": "艾尔菲",
                                    "text": "收集情报主要由被称为「调查员」的外勤人员来负责，例如菲谢尔，她就是一位极为优秀的调查员。"
                                },
                                {
                                    "id": "4015146926",
                                    "speaker": "艾尔菲",
                                    "text": "而像我这样在后方工作的人则负责将收集到的情报整理好，再提供给冒险家们…"
                                },
                                {
                                    "id": "4015146927",
                                    "speaker": "艾尔菲",
                                    "text": "所以说冒险家们的成功，和我们情报部背后的努力是脱不开关系的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "41604",
            "initDialog": "4015146906",
            "dialogues": [
                {
                    "id": "4015146906",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "4015146919",
                    "speaker": "艾尔菲",
                    "text": "咦？原来不需要我帮忙吗？"
                }
            ]
        },
        {
            "talkId": "41605",
            "initDialog": "4015146972",
            "dialogues": [
                {
                    "id": "4015146972",
                    "speaker": "Player",
                    "text": "你见过长得和我很像的人吗？"
                },
                {
                    "id": "4015146973",
                    "speaker": "艾尔菲",
                    "text": "我知道你的事情，你是那位近期才来到蒙德的异乡人吧？从你一进城我就注意到你了。"
                },
                {
                    "id": "4015146974",
                    "speaker": "艾尔菲",
                    "text": "你是说还有一个和你很像的人？也是从异乡来的旅行者吗？"
                },
                {
                    "id": "4015146975",
                    "speaker": "艾尔菲",
                    "text": "…太奇怪了，提瓦特大陆居然会有我不认识的人…"
                }
            ]
        }
    ]
}