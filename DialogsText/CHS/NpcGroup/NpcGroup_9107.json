{
    "groupId": "9107",
    "total_dialogue_lines": 73,
    "speaker_counts": {
        "Player": 17,
        "茜特菈莉": 56
    },
    "talks": [
        {
            "talkId": "6910701",
            "initDialog": "691070101",
            "dialogues": [
                {
                    "id": "691070101",
                    "speaker": "茜特菈莉",
                    "text": "#你好啊，{NICKNAME}，这里就是你住的地方吗？"
                },
                {
                    "id": "691070102",
                    "speaker": "茜特菈莉",
                    "text": "就是…现在方便参观吗？以我个人情况来说，房间没收拾好不能见人的时间在九成以上…"
                }
            ]
        },
        {
            "talkId": "6910702",
            "initDialog": "691070201",
            "dialogues": [
                {
                    "id": "691070201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691070202",
                    "speaker": "茜特菈莉",
                    "text": "挺好的挺好的。"
                },
                {
                    "id": "691070203",
                    "speaker": "茜特菈莉",
                    "text": "就是让我过来住我可能还习惯不了。"
                },
                {
                    "id": "691070204",
                    "speaker": "茜特菈莉",
                    "text": "房间太大了，躺床上看小说累了还得走好多步拿喝的。",
                    "choices": [
                        {
                            "id": "691070205",
                            "text": "这个…确实不方便…",
                            "response": [
                                {
                                    "id": "691070206",
                                    "speaker": "茜特菈莉",
                                    "text": "是啊。"
                                },
                                {
                                    "id": "691070207",
                                    "speaker": "茜特菈莉",
                                    "text": "你心中该没想着是因为我年纪大吧？这种习惯我可是从年轻人那里学的！"
                                },
                                {
                                    "id": "691070208",
                                    "speaker": "茜特菈莉",
                                    "text": "不对，我就是年轻人啊。"
                                }
                            ]
                        },
                        {
                            "id": "691070209",
                            "text": "床边拿个椅子放零食饮料不就好了…",
                            "response": [
                                {
                                    "id": "691070210",
                                    "speaker": "茜特菈莉",
                                    "text": "天才啊！"
                                },
                                {
                                    "id": "691070211",
                                    "speaker": "茜特菈莉",
                                    "text": "不对，你在这里住了这么久，当然立刻能想到这个方法了。"
                                },
                                {
                                    "id": "691070212",
                                    "speaker": "茜特菈莉",
                                    "text": "确实是这样。那样我还是喜欢大房间的，看起来宽敞，让人心情愉悦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910703",
            "initDialog": "691070301",
            "dialogues": [
                {
                    "id": "691070301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691070302",
                    "speaker": "茜特菈莉",
                    "text": "好的呀。有什么想说的吗？"
                },
                {
                    "id": "691070303",
                    "speaker": "Player",
                    "text": "为什么没有看到你的那些…"
                },
                {
                    "id": "691070304",
                    "speaker": "茜特菈莉",
                    "text": "你是说「星魔」吗？确实，我也感到奇怪。"
                },
                {
                    "id": "691070305",
                    "speaker": "茜特菈莉",
                    "text": "现在想想应该是你这片天地很不一般吧。它最大程度隔绝了外面的天地，所以来自星空的恶意被削弱了很多。"
                },
                {
                    "id": "691070306",
                    "speaker": "茜特菈莉",
                    "text": "这才让「星魔」们看起来没有什么精神。",
                    "choices": [
                        {
                            "id": "691070307",
                            "text": "看起来有点可怜。",
                            "response": [
                                {
                                    "id": "691070308",
                                    "speaker": "茜特菈莉",
                                    "text": "你真好心。"
                                },
                                {
                                    "id": "691070309",
                                    "speaker": "茜特菈莉",
                                    "text": "确实它们诞生自世界对人的恶意。但是这部分邪恶的力量已经在做坏事之前被修正掉了。"
                                },
                                {
                                    "id": "691070310",
                                    "speaker": "茜特菈莉",
                                    "text": "现在它们只是吉祥物罢了。"
                                },
                                {
                                    "id": "691070314",
                                    "speaker": "茜特菈莉",
                                    "text": "话说回来，这片天地有如此遮蔽天机的「造化神工」，难道这里是洞天福地吗？"
                                },
                                {
                                    "id": "691070315",
                                    "speaker": "Player",
                                    "text": "你是怎么知道的…"
                                },
                                {
                                    "id": "691070316",
                                    "speaker": "茜特菈莉",
                                    "text": "从小说里看来的啊。"
                                },
                                {
                                    "id": "691070317",
                                    "speaker": "茜特菈莉",
                                    "text": "《蜃楼战记》的超古代诸侯们上承三圣时代，许多古代科技和魔法并没有丢失，其中就有洞天技术。"
                                },
                                {
                                    "id": "691070318",
                                    "speaker": "茜特菈莉",
                                    "text": "噢！原来小说里的是真的啊！"
                                },
                                {
                                    "id": "691070319",
                                    "speaker": "Player",
                                    "text": "假的假的…"
                                },
                                {
                                    "id": "691070320",
                                    "speaker": "茜特菈莉",
                                    "text": "那，那换个说法吧。果然好小说都是很考究的。"
                                },
                                {
                                    "id": "691070321",
                                    "speaker": "茜特菈莉",
                                    "text": "你说有没有可能，写《蜃楼战记》的人就是你说的仙人呢？"
                                },
                                {
                                    "id": "691070322",
                                    "speaker": "茜特菈莉",
                                    "text": "而猫头的「东之王公」和「西之王母」就是他们的自我投射？"
                                },
                                {
                                    "id": "691070323",
                                    "speaker": "Player",
                                    "text": "你别说，你还真别说…"
                                },
                                {
                                    "id": "691070324",
                                    "speaker": "茜特菈莉",
                                    "text": "你认识什么猫类的仙人吗？"
                                },
                                {
                                    "id": "691070325",
                                    "speaker": "茜特菈莉",
                                    "text": "不、不对。我想了一下，作者或许不是仙人。"
                                },
                                {
                                    "id": "691070326",
                                    "speaker": "茜特菈莉",
                                    "text": "《蜃楼战记》我一路看连载下来，已经换了两次作者了。如果是仙人应该会比我坚持更久吧…"
                                }
                            ]
                        },
                        {
                            "id": "691070311",
                            "text": "这样看起来比较安全。",
                            "response": [
                                {
                                    "id": "691070312",
                                    "speaker": "茜特菈莉",
                                    "text": "唔，这么说也没错。它们是诞生自世界恶意的灵。"
                                },
                                {
                                    "id": "691070313",
                                    "speaker": "茜特菈莉",
                                    "text": "不过它们在做坏事之前就被我阻止了。不会有危险的。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6910704",
            "initDialog": "691070401",
            "dialogues": [
                {
                    "id": "691070401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691070402",
                    "speaker": "茜特菈莉",
                    "text": "什么也不做不也挺好吗？"
                },
                {
                    "id": "691070403",
                    "speaker": "Player",
                    "text": "确实。"
                },
                {
                    "id": "691070404",
                    "speaker": "茜特菈莉",
                    "text": "人生苦短不足百年，所以不要担忧那种千年大问题。"
                },
                {
                    "id": "691070405",
                    "speaker": "茜特菈莉",
                    "text": "活得太久就会知道，重要的事情实在不多。"
                },
                {
                    "id": "691070406",
                    "speaker": "茜特菈莉",
                    "text": "就算拿出十分之一的时间去筹备水火、秣马厉兵，剩下的时间还是得想办法打发的。"
                },
                {
                    "id": "691070407",
                    "speaker": "茜特菈莉",
                    "text": "当然，我不是说我年纪大的意思！"
                },
                {
                    "id": "691070408",
                    "speaker": "Player",
                    "text": "但是我感觉我人生很波澜壮阔啊。"
                },
                {
                    "id": "691070409",
                    "speaker": "茜特菈莉",
                    "text": "嗯，这也确实，或许是我见识浅薄了。"
                },
                {
                    "id": "691070410",
                    "speaker": "茜特菈莉",
                    "text": "就像是枫丹侦探小说，主角不管走到哪里都能惹一大堆事情上身。"
                },
                {
                    "id": "691070411",
                    "speaker": "茜特菈莉",
                    "text": "或许现实中真的有这种体质吧。"
                },
                {
                    "id": "691070412",
                    "speaker": "Player",
                    "text": "现实中我们叫这种体质「倒霉」。"
                },
                {
                    "id": "691070413",
                    "speaker": "茜特菈莉",
                    "text": "不过侦探小说也只写了侦探们的一部分人生。"
                },
                {
                    "id": "691070414",
                    "speaker": "茜特菈莉",
                    "text": "他们身上的案件，根据小说来看，也就持续几天而已。"
                },
                {
                    "id": "691070415",
                    "speaker": "茜特菈莉",
                    "text": "说不定除此以外的大部分时间都是在打发时间呢？"
                },
                {
                    "id": "691070416",
                    "speaker": "Player",
                    "text": "说不定其余时间在消化案件的心理创伤…"
                },
                {
                    "id": "691070417",
                    "speaker": "茜特菈莉",
                    "text": "那我什么也不做，也是在消化生活带来的创伤啊。"
                },
                {
                    "id": "691070418",
                    "speaker": "茜特菈莉",
                    "text": "……"
                },
                {
                    "id": "691070419",
                    "speaker": "茜特菈莉",
                    "text": "好吧，求求你，别用这种眼神看着我。我已经听到你心里在说什么了。"
                },
                {
                    "id": "691070420",
                    "speaker": "茜特菈莉",
                    "text": "「茜特菈莉又有些自暴自弃了。」"
                },
                {
                    "id": "691070421",
                    "speaker": "茜特菈莉",
                    "text": "别这样想啊！那样岂不是显得我明明一把年纪了还要让人替我担忧吗？…而且我再次强调我年纪也不是很大。"
                },
                {
                    "id": "691070422",
                    "speaker": "茜特菈莉",
                    "text": "拿你没办法…走吧，我带你去外面转转。好久没有和你一起吃饭了。"
                },
                {
                    "id": "691070423",
                    "speaker": "茜特菈莉",
                    "text": "还愣着干嘛呢？走啦…快走啦！"
                }
            ]
        },
        {
            "talkId": "6910705",
            "initDialog": "691070501",
            "dialogues": [
                {
                    "id": "691070501",
                    "speaker": "Player",
                    "text": "早啊，茜特菈莉。"
                },
                {
                    "id": "691070502",
                    "speaker": "茜特菈莉",
                    "text": "#早啊，{NICKNAME}。要不是我通宵了，都不知道你起这么早。"
                }
            ]
        },
        {
            "talkId": "6910706",
            "initDialog": "691070601",
            "dialogues": [
                {
                    "id": "691070601",
                    "speaker": "Player",
                    "text": "晚安，茜特菈莉。"
                },
                {
                    "id": "691070602",
                    "speaker": "茜特菈莉",
                    "text": "晚安。我再四处逛逛吧，看不到星星的夜空有点不习惯。"
                }
            ]
        },
        {
            "talkId": "6910710",
            "initDialog": "691071001",
            "dialogues": [
                {
                    "id": "691071001",
                    "speaker": "茜特菈莉",
                    "text": "这种看起来就很安静的布置我很喜欢。"
                },
                {
                    "id": "691071002",
                    "speaker": "茜特菈莉",
                    "text": "不仅和我平常住的房子一样没人打扰，而且还更整洁。"
                },
                {
                    "id": "691071003",
                    "speaker": "茜特菈莉",
                    "text": "你放心，不从门口拿快递的话，是不会弄乱的！"
                }
            ]
        },
        {
            "talkId": "6910711",
            "initDialog": "691071101",
            "dialogues": [
                {
                    "id": "691071101",
                    "speaker": "茜特菈莉",
                    "text": "倒是也不用弄这种风格，我没有什么思乡之情的。不过你好奇的话，我倒是可以和你说一下这些东西的讲究和神秘传统。"
                },
                {
                    "id": "691071102",
                    "speaker": "茜特菈莉",
                    "text": "一些东西不太好放男孩子房间里，有些不适合放女孩子房间…"
                },
                {
                    "id": "691071103",
                    "speaker": "茜特菈莉",
                    "text": "不过你不必在意。你的命太硬，「盟友」太强大。震慑一切妖魔鬼怪。"
                }
            ]
        }
    ]
}