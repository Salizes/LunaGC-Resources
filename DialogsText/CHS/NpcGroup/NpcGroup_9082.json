{
    "groupId": "9082",
    "total_dialogue_lines": 68,
    "speaker_counts": {
        "Player": 15,
        "白术": 46,
        "长生": 7
    },
    "talks": [
        {
            "talkId": "6908201",
            "initDialog": "690820101",
            "dialogues": [
                {
                    "id": "690820101",
                    "speaker": "白术",
                    "text": "有个说法叫「住所是主人性情的忠实反映」，我觉得挺有道理。"
                },
                {
                    "id": "690820102",
                    "speaker": "白术",
                    "text": "今天亲眼见到了这壶中洞天，嗯，你果然是个有意思的人。"
                }
            ]
        },
        {
            "talkId": "6908202",
            "initDialog": "690820201",
            "dialogues": [
                {
                    "id": "690820201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690820202",
                    "speaker": "白术",
                    "text": "我的生活习惯和别人略有不同，但你不用太在意这种事。"
                },
                {
                    "id": "690820203",
                    "speaker": "白术",
                    "text": "重要的东西我都随身备好了，毕竟是个大夫，要是连自己都照顾不好就太不像话了。"
                },
                {
                    "id": "690820204",
                    "speaker": "Player",
                    "text": "重要的东西？"
                },
                {
                    "id": "690820205",
                    "speaker": "白术",
                    "text": "其实也没什么特别的，因为我身体不好，有些毛病一旦发作起来必须得及时吃药，这才带了一个药箱。"
                },
                {
                    "id": "690820206",
                    "speaker": "白术",
                    "text": "除了药之外，还有些其他瓶瓶罐罐，又重又占地方，我也就没多带。",
                    "choices": [
                        {
                            "id": "690820207",
                            "text": "可以放心带来。",
                            "response": [
                                {
                                    "id": "690820209",
                                    "speaker": "白术",
                                    "text": "谢谢你，我的东西…有点多。"
                                },
                                {
                                    "id": "690820210",
                                    "speaker": "白术",
                                    "text": "原本就是来做客的，占了主人太多地方就不好意思了…"
                                },
                                {
                                    "id": "690820211",
                                    "speaker": "长生",
                                    "text": "哎呀，瞧他这又惦记又含蓄的样子，我来说好了。"
                                },
                                {
                                    "id": "690820212",
                                    "speaker": "长生",
                                    "text": "那些瓶瓶罐罐啊，不能说是有点多，得说是很多，特别多！"
                                },
                                {
                                    "id": "690820213",
                                    "speaker": "长生",
                                    "text": "#如果都搬来的话，恐怕一间屋子都不够放。{NICKNAME}，你得考虑好哦。"
                                },
                                {
                                    "id": "690820214",
                                    "speaker": "Player",
                                    "text": "没、没关系。"
                                },
                                {
                                    "id": "690820215",
                                    "speaker": "白术",
                                    "text": "那…我来写个单子吧，请阿桂帮忙把那些东西送来。"
                                },
                                {
                                    "id": "690820216",
                                    "speaker": "长生",
                                    "text": "不，他一个人肯定是拿不下的，就算叫上七七，也拿不了许多。"
                                },
                                {
                                    "id": "690820217",
                                    "speaker": "白术",
                                    "text": "还是我回去一趟，把所有东西装好箱再分批送进来…"
                                },
                                {
                                    "id": "690820218",
                                    "speaker": "Player",
                                    "text": "这么多吗？"
                                },
                                {
                                    "id": "690820219",
                                    "speaker": "白术",
                                    "text": "抱歉，我这人是有些麻烦…"
                                }
                            ]
                        },
                        {
                            "id": "690820208",
                            "text": "这里地方很大。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908203",
            "initDialog": "690820301",
            "dialogues": [
                {
                    "id": "690820301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690820302",
                    "speaker": "白术",
                    "text": "不知道你对什么感兴趣？说药学怕你觉得无聊，和你谈养生大概也不切实际。"
                },
                {
                    "id": "690820303",
                    "speaker": "长生",
                    "text": "你不是一直念叨那些瓶瓶罐罐吗？说那个就是了。"
                },
                {
                    "id": "690820304",
                    "speaker": "Player",
                    "text": "瓶瓶罐罐？"
                },
                {
                    "id": "690820305",
                    "speaker": "白术",
                    "text": "…没错，除了煎服的汤剂之外，我也会给病人开些外用药。"
                },
                {
                    "id": "690820306",
                    "speaker": "白术",
                    "text": "外用药多是药膏与药液，成分复杂，混合比例有讲究，炮制过程也麻烦一些。"
                },
                {
                    "id": "690820307",
                    "speaker": "白术",
                    "text": "病人当然是不懂如何制药的，一般都是我自己动手。"
                },
                {
                    "id": "690820308",
                    "speaker": "白术",
                    "text": "制药时需要用到处理过的药材，就是那些瓶瓶罐罐里泡着的东西了。"
                },
                {
                    "id": "690820309",
                    "speaker": "长生",
                    "text": "没错没错，那里面泡着不少好东西哪。"
                },
                {
                    "id": "690820310",
                    "speaker": "Player",
                    "text": "有什么好东西？"
                },
                {
                    "id": "690820311",
                    "speaker": "白术",
                    "text": "就是些药草罢了，其中有些毒性比较大，不处理一下是无法入药的。"
                },
                {
                    "id": "690820312",
                    "speaker": "白术",
                    "text": "说到这个，我觉得有必要提醒你一下，是药三分毒。"
                },
                {
                    "id": "690820313",
                    "speaker": "白术",
                    "text": "不仅只有我那里的药材有毒性，哪怕是些温和的药，如果不对症，长期吃着也对身体不好。"
                },
                {
                    "id": "690820314",
                    "speaker": "白术",
                    "text": "没生病的时候一定不要乱吃药，有些身体上的不适症状，不用药也能好。"
                },
                {
                    "id": "690820315",
                    "speaker": "白术",
                    "text": "这时候就不要想着先吃药，最好是先来问我。"
                },
                {
                    "id": "690820316",
                    "speaker": "Player",
                    "text": "知道了，大夫。"
                },
                {
                    "id": "690820317",
                    "speaker": "白术",
                    "text": "小心驶得万年船，就算你嫌啰嗦我也得说。"
                }
            ]
        },
        {
            "talkId": "6908204",
            "initDialog": "690820401",
            "dialogues": [
                {
                    "id": "690820401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690820402",
                    "speaker": "白术",
                    "text": "想做的吗？人生在世几十年，往往是想做的太多，而活着的时间太短。"
                },
                {
                    "id": "690820403",
                    "speaker": "白术",
                    "text": "…我们平时闲聊也不必说得太远，只谈谈最近想做的事好了。"
                },
                {
                    "id": "690820404",
                    "speaker": "白术",
                    "text": "璃月港这么大，偶尔有人猝然间受了重伤无法行动，或者有口难言不好求救。"
                },
                {
                    "id": "690820405",
                    "speaker": "白术",
                    "text": "等大夫赶到现场的时候，有可能会耽误救治的时机。"
                },
                {
                    "id": "690820406",
                    "speaker": "白术",
                    "text": "人们平时总想着让大夫掐紧时间，但我自问没办法瞬息移动，要是到晚了不就错失良机了吗？"
                },
                {
                    "id": "690820407",
                    "speaker": "白术",
                    "text": "遇到这种情况，病患还是应该先努力自救。"
                },
                {
                    "id": "690820408",
                    "speaker": "白术",
                    "text": "自救的方法很多，但并不是所有人都知道。"
                },
                {
                    "id": "690820409",
                    "speaker": "白术",
                    "text": "从这里开始就是我作为一个大夫能做的事了，我得想点主意把自救的方法教给大家。",
                    "choices": [
                        {
                            "id": "690820410",
                            "text": "是很有意义的想法。",
                            "response": [
                                {
                                    "id": "690820411",
                                    "speaker": "白术",
                                    "text": "医者的责任重大，既然做了大夫这些就是我份内的事。"
                                },
                                {
                                    "id": "690820414",
                                    "speaker": "白术",
                                    "text": "你愿意听我唠叨就已经是莫大的帮助了。"
                                },
                                {
                                    "id": "690820415",
                                    "speaker": "白术",
                                    "text": "以后我有了更成熟的方案，一定会再和你商量的。"
                                },
                                {
                                    "id": "690820416",
                                    "speaker": "白术",
                                    "text": "届时，多半还要再麻烦你了。"
                                }
                            ]
                        },
                        {
                            "id": "690820412",
                            "text": "需要我帮忙吗？",
                            "response": [
                                {
                                    "id": "690820413",
                                    "speaker": "白术",
                                    "text": "我现在的确有了些方向，但还没想清楚如何做最迅速有效。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908205",
            "initDialog": "690820501",
            "dialogues": [
                {
                    "id": "690820501",
                    "speaker": "Player",
                    "text": "早啊，白术。"
                },
                {
                    "id": "690820502",
                    "speaker": "白术",
                    "text": "#早上好，{NICKNAME}。"
                },
                {
                    "id": "690820503",
                    "speaker": "白术",
                    "text": "早晨空气清新，人也为之精神振奋，如果有什么要紧事，放到这时候做正好。"
                },
                {
                    "id": "690820504",
                    "speaker": "长生",
                    "text": "哈…看起来你们都不困，那你们先聊，我眯一会儿。"
                }
            ]
        },
        {
            "talkId": "6908206",
            "initDialog": "690820601",
            "dialogues": [
                {
                    "id": "690820601",
                    "speaker": "Player",
                    "text": "晚安，白术。"
                },
                {
                    "id": "690820602",
                    "speaker": "白术",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690820603",
                    "speaker": "白术",
                    "text": "夜晚是身体休眠的时间，这时候睡觉是自然规律。不能总想着晚上不睡，白天补觉，这样不好。"
                },
                {
                    "id": "690820604",
                    "speaker": "白术",
                    "text": "啊…不好意思，我没有指责你的意思。平时总跟病人说这些，成习惯了，你别在意。"
                }
            ]
        },
        {
            "talkId": "6908207",
            "initDialog": "690820701",
            "dialogues": [
                {
                    "id": "690820701",
                    "speaker": "白术",
                    "text": "我看得出来，你在书斋的布置上下了功夫。"
                },
                {
                    "id": "690820702",
                    "speaker": "白术",
                    "text": "盆景尤其挑得好，既有清雅的姿态又不乏野趣，长期伏案的人正需要靠它放松精神。"
                },
                {
                    "id": "690820703",
                    "speaker": "白术",
                    "text": "养生中关键的一步就是养心，这件书斋的陈设很符合个中之道。"
                }
            ]
        },
        {
            "talkId": "6908208",
            "initDialog": "690820801",
            "dialogues": [
                {
                    "id": "690820801",
                    "speaker": "白术",
                    "text": "这地方不仅能生火做饭，也便于制药…让你费心了。"
                },
                {
                    "id": "690820802",
                    "speaker": "白术",
                    "text": "嗯…就用这个小号的炉灶煎药，其余的器具我正好都带着。"
                },
                {
                    "id": "690820803",
                    "speaker": "白术",
                    "text": "这样一来就不至于耽误急等着用药的病患了，我心安了许多，谢谢你。"
                }
            ]
        }
    ]
}