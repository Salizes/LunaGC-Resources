{
    "groupId": "3187",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "阿妮萨": 15
    },
    "talks": [
        {
            "talkId": "6318701",
            "initDialog": "631870101",
            "dialogues": [
                {
                    "id": "631870101",
                    "speaker": "阿妮萨",
                    "text": "你好呀！"
                }
            ]
        },
        {
            "talkId": "6318702",
            "initDialog": "631870201",
            "dialogues": [
                {
                    "id": "631870201",
                    "speaker": "Player",
                    "text": "近来怎样？"
                },
                {
                    "id": "631870202",
                    "speaker": "阿妮萨",
                    "text": "哈哈，不错不错！谢谢关心！"
                },
                {
                    "id": "631870203",
                    "speaker": "阿妮萨",
                    "text": "这边气候也好，环境也不差，食物更美味。而且多亏了久美阿妹照顾，这段时间我每天都能打起精神一头钻进课题里！"
                },
                {
                    "id": "631870204",
                    "speaker": "阿妮萨",
                    "text": "只不过…可能到处乱跑的我，有时也会让她担心吧。"
                },
                {
                    "id": "631870205",
                    "speaker": "阿妮萨",
                    "text": "嘿嘿…还怪不好意思的。"
                }
            ]
        },
        {
            "talkId": "6318703",
            "initDialog": "631870301",
            "dialogues": [
                {
                    "id": "631870301",
                    "speaker": "Player",
                    "text": "很高兴又看见你。"
                },
                {
                    "id": "631870302",
                    "speaker": "阿妮萨",
                    "text": "我也是，看见拯救了我学术生涯的恩人真是开心！"
                },
                {
                    "id": "631870303",
                    "speaker": "阿妮萨",
                    "text": "说起来，我最近正在通过分析海祇岛周边海域的鱼类种群，来推定昆谛罗的后代可能的活动范围。"
                },
                {
                    "id": "631870304",
                    "speaker": "阿妮萨",
                    "text": "而在这个过程中，我发现海洋生物种群本身就拥有异常丰富的多样性，哈哈！意外之喜！"
                },
                {
                    "id": "631870305",
                    "speaker": "阿妮萨",
                    "text": "咳咳，抱歉…有点得意忘形了。无论如何，多谢你的帮助。"
                }
            ]
        },
        {
            "talkId": "6318704",
            "initDialog": "631870401",
            "dialogues": [
                {
                    "id": "631870401",
                    "speaker": "Player",
                    "text": "关于久美…"
                },
                {
                    "id": "631870402",
                    "speaker": "阿妮萨",
                    "text": "多亏你的帮助啦。这段时间里，久美阿妹开朗了许多。"
                },
                {
                    "id": "631870403",
                    "speaker": "阿妮萨",
                    "text": "只是呀，她把许多活计都揽在了自己身上…看着她忙忙碌碌的样子，我也希望多少能帮上些忙吧…"
                },
                {
                    "id": "631870404",
                    "speaker": "阿妮萨",
                    "text": "啊，说起这个呀…我跟久美阿妹学着做了些这边的料理，顺便加了些专属于故乡的味道。"
                },
                {
                    "id": "631870405",
                    "speaker": "阿妮萨",
                    "text": "嘿嘿，你一定会喜欢的！"
                },
                {
                    "id": "631870406",
                    "speaker": "阿妮萨",
                    "text": "下次有机会赏光品尝一下，如何？"
                }
            ]
        },
        {
            "talkId": "6318705",
            "initDialog": "631870501",
            "dialogues": [
                {
                    "id": "631870501",
                    "speaker": "Player",
                    "text": "再见！"
                },
                {
                    "id": "631870502",
                    "speaker": "阿妮萨",
                    "text": "旅途平安！"
                }
            ]
        }
    ]
}