    "talks": [
        {
            "talkId": "6438301",
            "initDialog": "643830101",
            "dialogues": [
                {
                    "id": "643830101",
                    "speaker": "纳吉斯",
                    "text": "我的那些同事们哟，现在一定又在精心撰写项目申请了吧。"
                }
            ]
        },
        {
            "talkId": "6438302",
            "initDialog": "643830201",
            "dialogues": [
                {
                    "id": "643830201",
                    "speaker": "Player",
                    "text": "项目申请？"
                },
                {
                    "id": "643830202",
                    "speaker": "纳吉斯",
                    "text": "嗯，就是大家都知道的嘛，能申请到科研项目意味着教令院会拨出经费，而有了经费和项目的由头之后，就能招揽更多学生。"
                },
                {
                    "id": "643830203",
                    "speaker": "纳吉斯",
                    "text": "有了为自己工作的学生，再加上源源不断的公费，未来一片光明呢。"
                },
                {
                    "id": "643830204",
                    "speaker": "纳吉斯",
                    "text": "不过我是觉得没有必要啦。为了申请项目争个头破血流，实在是太累了。"
                },
                {
                    "id": "643830205",
                    "speaker": "纳吉斯",
                    "text": "而且最近听说教令院的经费都被机密项目占走了，谁也拿不到。呵呵，这下竹篮打水一场空咯。"
                }
            ]
        },
        {
            "talkId": "6438303",
            "initDialog": "643830301",
            "dialogues": [
                {
                    "id": "643830301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643830302",
                    "speaker": "纳吉斯",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6438304",
            "initDialog": "643830401",
            "dialogues": [
                {
                    "id": "643830401",
                    "speaker": "Player",
                    "text": "项目申请？"
                },
                {
                    "id": "643830402",
                    "speaker": "纳吉斯",
                    "text": "嗯，就是大家都知道的嘛，能申请到科研项目意味着教令院会拨出经费，而有了经费和项目的由头之后，就能招揽更多学生。"
                },
                {
                    "id": "643830403",
                    "speaker": "纳吉斯",
                    "text": "有了为自己工作的学生，再加上源源不断的公费，未来一片光明呢。"
                },
                {
                    "id": "643830404",
                    "speaker": "纳吉斯",
                    "text": "不过我是觉得没有必要啦。为了申请项目争个头破血流，实在是太累了。"
                },
                {
                    "id": "643830405",
                    "speaker": "纳吉斯",
                    "text": "而且你听说了吗？之前阿扎尔在大项目上投入了那么多，结果不仅竹篮打水一场空，还把自己的地位都搞没了。"
                },
                {
                    "id": "643830406",
                    "speaker": "纳吉斯",
                    "text": "真是可笑至极。"
                }
            ]
        }
    ]
