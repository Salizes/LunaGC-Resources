{
    "groupId": "2487",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "有规": 12
    },
    "talks": [
        {
            "talkId": "6248701",
            "initDialog": "624870101",
            "dialogues": [
                {
                    "id": "624870101",
                    "speaker": "有规",
                    "text": "如果能少爬点台阶就好了…真想快点把货送到客人手里。"
                }
            ]
        },
        {
            "talkId": "6248702",
            "initDialog": "624870201",
            "dialogues": [
                {
                    "id": "624870201",
                    "speaker": "Player",
                    "text": "台阶？"
                },
                {
                    "id": "624870202",
                    "speaker": "有规",
                    "text": "遗珑埠的上下落差太大，那座以水力驱动的升降机一般用来运送大件货物，不会频繁启动。"
                },
                {
                    "id": "624870203",
                    "speaker": "有规",
                    "text": "有时，我们收到了镖物，要迅速派发到客户手中，就只能从下层爬台阶上来了。"
                },
                {
                    "id": "624870204",
                    "speaker": "有规",
                    "text": "为了防止台阶过于陡峭，遗珑埠上下层之间的通路比较曲折，这就平添了不少脚程。"
                },
                {
                    "id": "624870205",
                    "speaker": "有规",
                    "text": "听说和记厅有新建几座小型升降机的计划…到时候，情况应该会好转！"
                }
            ]
        },
        {
            "talkId": "6248703",
            "initDialog": "624870301",
            "dialogues": [
                {
                    "id": "624870301",
                    "speaker": "Player",
                    "text": "送货的时间很紧吗？"
                },
                {
                    "id": "624870302",
                    "speaker": "有规",
                    "text": "这不是我们说了算的，也不是客户能决定的。"
                },
                {
                    "id": "624870303",
                    "speaker": "有规",
                    "text": "长途跑镖的过程中，遭遇意外是家常便饭，走着走着就会被一些东西耽搁…"
                },
                {
                    "id": "624870304",
                    "speaker": "有规",
                    "text": "有时，镖物送达时，就晚了好几天。要是珍贵的食材，怕是都要放坏了。"
                },
                {
                    "id": "624870305",
                    "speaker": "有规",
                    "text": "我们看着也心疼，只能尽快给客户送过去。"
                },
                {
                    "id": "624870306",
                    "speaker": "有规",
                    "text": "但你说这事能怪罪长途跑镖的兄弟们吗？"
                },
                {
                    "id": "624870307",
                    "speaker": "有规",
                    "text": "也不能，没办法呀，谁让路途又艰险又漫长呢。"
                }
            ]
        },
        {
            "talkId": "6248704",
            "initDialog": "624870401",
            "dialogues": [
                {
                    "id": "624870401",
                    "speaker": "Player",
                    "text": "加油！"
                },
                {
                    "id": "624870402",
                    "speaker": "有规",
                    "text": "好，我再咬咬牙，还能多送几单！"
                }
            ]
        }
    ]
}