{
    "groupId": "2448",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "秋歌": 11
    },
    "talks": [
        {
            "talkId": "6244801",
            "initDialog": "624480101",
            "dialogues": [
                {
                    "id": "624480101",
                    "speaker": "秋歌",
                    "text": "咳，唔，嗯…"
                },
                {
                    "id": "624480102",
                    "speaker": "秋歌",
                    "text": "您是来听戏的吗？不好意思，我的喉咙不太舒服…"
                }
            ]
        },
        {
            "talkId": "6244802",
            "initDialog": "624480201",
            "dialogues": [
                {
                    "id": "624480201",
                    "speaker": "Player",
                    "text": "你的喉咙怎么了？"
                },
                {
                    "id": "624480202",
                    "speaker": "秋歌",
                    "text": "咳，我是个刚出道的唱戏人，前段时间演出把嗓子唱伤了。"
                },
                {
                    "id": "624480203",
                    "speaker": "秋歌",
                    "text": "唔嗯…这没什么，师傅说这对唱戏人来说是家常便饭的事儿。"
                },
                {
                    "id": "624480204",
                    "speaker": "秋歌",
                    "text": "幸亏这段时间戏班因为某些原因暂停演出了，能让我休息嗓子，咳咳…"
                },
                {
                    "id": "624480205",
                    "speaker": "秋歌",
                    "text": "…唉，我还得唱伤多少次嗓子，才能成为云堇那样的名角儿啊…"
                }
            ]
        },
        {
            "talkId": "6244803",
            "initDialog": "624480301",
            "dialogues": [
                {
                    "id": "624480301",
                    "speaker": "Player",
                    "text": "关于唱戏…"
                },
                {
                    "id": "624480302",
                    "speaker": "秋歌",
                    "text": "咳咳，虽然成名之前的日子不那么好过，还经常会被师父打板子…"
                },
                {
                    "id": "624480303",
                    "speaker": "秋歌",
                    "text": "不过对我来说，只要能站到戏台上成为全场最瞩目的焦点，那么一切付出都是值得的…"
                },
                {
                    "id": "624480304",
                    "speaker": "秋歌",
                    "text": "…所有观众都会因为我的一举一动、一颦一笑而感动落泪或开怀大笑…"
                },
                {
                    "id": "624480305",
                    "speaker": "秋歌",
                    "text": "唔嗯…如果你曾体会过这种感觉，就一定能理解我在说什么。"
                }
            ]
        },
        {
            "talkId": "6244804",
            "initDialog": "624480401",
            "dialogues": [
                {
                    "id": "624480401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624480402",
                    "speaker": "秋歌",
                    "text": "唔嗯哼…客官慢走，等我嗓子好了，请一定来听我的戏。"
                }
            ]
        }
    ]
}