    },
    "talks": [
        {
            "talkId": "6400401",
            "initDialog": "640040101",
            "dialogues": [
                {
                    "id": "640040101",
                    "speaker": "哈特姆",
                    "text": "与其相信这些交易所专家对期货的预测，我还不如去弄点招财的料理吃吃呢。"
                }
            ]
        },
        {
            "talkId": "6400402",
            "initDialog": "640040201",
            "dialogues": [
                {
                    "id": "640040201",
                    "speaker": "Player",
                    "text": "关于交易所…"
                },
                {
                    "id": "640040202",
                    "speaker": "哈特姆",
                    "text": "喏，就是这个，卡里米交易所，能够见证人们底蕴与胆识的地方。"
                },
                {
                    "id": "640040203",
                    "speaker": "哈特姆",
                    "text": "如果你有足够的资产与财富，以及英明的判断力，那这里就会成为你大赚特赚的地方。"
                },
                {
                    "id": "640040204",
                    "speaker": "哈特姆",
                    "text": "足够的财富么，像我这样的老贵族自然不在话下。和我家相比，呼玛伊家根本不算什么！"
                },
                {
                    "id": "640040205",
                    "speaker": "哈特姆",
                    "text": "现在就是缺少一个机遇…让我的家产能够更加充盈。这样，我的孩子们就可以高枕无忧，不用再去跑商了！"
                }
            ]
        },
        {
            "talkId": "6400403",
            "initDialog": "640040301",
            "dialogues": [
                {
                    "id": "640040301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640040302",
                    "speaker": "哈特姆",
                    "text": "唉，这帮外行人，一个靠谱的都没有！"
                }
            ]
        },
        {
            "talkId": "6400404",
            "initDialog": "640040401",
            "dialogues": [
                {
                    "id": "640040401",
                    "speaker": "哈特姆",
                    "text": "只要有钱，什么事情都会变得简单！"
                }
            ]
        },
        {
            "talkId": "6400405",
            "initDialog": "640040501",
            "dialogues": [
                {
                    "id": "640040501",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640040502",
                    "speaker": "哈特姆",
                    "text": "我，身为最古老的沙漠贵族的后裔，就是财富的代名词。"
                },
                {
                    "id": "640040503",
                    "speaker": "哈特姆",
                    "text": "可惜，不是因论派的学者，是不懂得这个身份的含金量的，现在的城里人哦…"
                },
                {
                    "id": "640040504",
                    "speaker": "哈特姆",
                    "text": "这不仅仅是钱的问题，也伴随着智慧与胆识。"
                },
                {
                    "id": "640040505",
                    "speaker": "哈特姆",
                    "text": "无论是树王大人的遗产，还是赤王的古迹，在我家的宝库中都能找到。"
                },
                {
                    "id": "640040506",
                    "speaker": "哈特姆",
                    "text": "祖辈留下的基业，将会在我的手中继续发扬光大。"
                }
            ]
        },
        {
            "talkId": "6400406",
            "initDialog": "640040601",
            "dialogues": [
                {
                    "id": "640040601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640040602",
                    "speaker": "哈特姆",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6400407",
            "initDialog": "640040701",
            "dialogues": [
                {
                    "id": "640040701",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640040702",
                    "speaker": "哈特姆",
                    "text": "我，身为最古老的沙漠贵族的后裔，就是财富的代名词。"
                },
                {
                    "id": "640040703",
                    "speaker": "哈特姆",
                    "text": "可惜，不是因论派的学者，是不懂得这个身份的含金量的，现在的城里人哦…"
                },
                {
                    "id": "640040704",
                    "speaker": "哈特姆",
                    "text": "这不仅仅是钱的问题，也伴随着智慧与胆识。"
                },
                {
                    "id": "640040705",
                    "speaker": "哈特姆",
                    "text": "无论是草神大人的旧物，还是赤王的古迹，在我家的宝库中都能找到。"
                },
                {
                    "id": "640040706",
                    "speaker": "哈特姆",
                    "text": "祖辈留下的基业，将会在我的手中继续发扬光大。"
                }
            ]
        },
        {
            "talkId": "7392201",
            "initDialog": "739220101",
            "dialogues": [
                {
                    "id": "739220101",
                    "speaker": "Player",
                    "text": "小心坐吃山空。"
                },
                {
                    "id": "739220102",
                    "speaker": "哈特姆",
                    "text": "没关系，不用担心，我的家产，岂是这么容易被挥霍掉的吗？"
                },
                {
                    "id": "739220103",
                    "speaker": "哈特姆",
                    "text": "就算只剩一半，也仍然能在交易所里转上三圈！"
                },
                {
                    "id": "739220104",
                    "speaker": "哈特姆",
                    "text": "看见这件古董了吗？只是我家的一粒米罢了。拿去拿去，不用客气！"
                }
            ]
        }
    ]
}