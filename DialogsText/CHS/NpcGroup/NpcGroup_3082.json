{
    "groupId": "3082",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 7,
        "枫": 23
    },
    "talks": [
        {
            "talkId": "4006307",
            "initDialog": "400630701",
            "dialogues": [
                {
                    "id": "400630701",
                    "speaker": "枫",
                    "text": "真没想到，离岛上竟然会出现八重堂主办的祭典，而且还有这么多人参加。"
                },
                {
                    "id": "400630702",
                    "speaker": "枫",
                    "text": "托容彩祭的福，本店的稻妻特产和玩偶，即使不是本次祭典限量发售新商品，也卖得非常好呢。"
                }
            ]
        },
        {
            "talkId": "4006363",
            "initDialog": "400636301",
            "dialogues": [
                {
                    "id": "400636301",
                    "speaker": "枫",
                    "text": "没想到容彩祭还没开幕，离岛上的人就已经这么多了…"
                },
                {
                    "id": "400636302",
                    "speaker": "枫",
                    "text": "这位客人，「御建鸣神主尊大御所大人像」要等到容彩祭开幕后才会发售哦！"
                },
                {
                    "id": "400636303",
                    "speaker": "枫",
                    "text": "哦哦…您不是来问将军人偶的啊。抱歉，因为最近来问的人实在是太多了。"
                }
            ]
        },
        {
            "talkId": "6308201",
            "initDialog": "630820101",
            "dialogues": [
                {
                    "id": "630820101",
                    "speaker": "枫",
                    "text": "嗯？主动来搭话…莫非是顾客？"
                }
            ]
        },
        {
            "talkId": "6308202",
            "initDialog": "630820201",
            "dialogues": [
                {
                    "id": "630820201",
                    "speaker": "Player",
                    "text": "关于这家店…"
                },
                {
                    "id": "630820202",
                    "speaker": "枫",
                    "text": "本店主要贩卖一些旅游纪念品，例如稻妻的小说、狸猫玩偶什么的。"
                },
                {
                    "id": "630820203",
                    "speaker": "枫",
                    "text": "以前…好像还卖过将军大人的塑像什么的。"
                },
                {
                    "id": "630820204",
                    "speaker": "枫",
                    "text": "可惜锁国后，除了那些为了糊弄家人的至冬国商人光顾以外，就没什么客人了…"
                }
            ]
        },
        {
            "talkId": "6308203",
            "initDialog": "630820301",
            "dialogues": [
                {
                    "id": "630820301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630820302",
                    "speaker": "枫",
                    "text": "唔，果然不是来买东西的啊…"
                }
            ]
        },
        {
            "talkId": "6308204",
            "initDialog": "630820401",
            "dialogues": [
                {
                    "id": "630820401",
                    "speaker": "Player",
                    "text": "有哪些玩偶？"
                },
                {
                    "id": "630820402",
                    "speaker": "枫",
                    "text": "我们家主打有狐仙刻像和狸猫陶瓷玩偶，呃…狸猫玩偶销量更好一些吧。"
                },
                {
                    "id": "630820403",
                    "speaker": "枫",
                    "text": "这种玩偶在我们稻妻象征着好运哦，不少商家都会买上一只摆在店里，以求财运亨通。"
                },
                {
                    "id": "630820404",
                    "speaker": "枫",
                    "text": "再加上模样可爱，送给心仪的女孩子或者家里的小孩子也不错。"
                }
            ]
        },
        {
            "talkId": "6308205",
            "initDialog": "630820501",
            "dialogues": [
                {
                    "id": "630820501",
                    "speaker": "Player",
                    "text": "将军的…塑像？"
                },
                {
                    "id": "630820502",
                    "speaker": "枫",
                    "text": "嗯，将军大人是一位宽宏大量的人，并不在意别人出于什么样的理由购买自己的塑像。"
                },
                {
                    "id": "630820503",
                    "speaker": "枫",
                    "text": "唔，本来这还是本店最热销的产品来着呢…"
                },
                {
                    "id": "630820504",
                    "speaker": "枫",
                    "text": "可惜因为锁国，没有游客就没有客源，再加上这样精致的物件造价不菲，所以只好下架了。"
                }
            ]
        },
        {
            "talkId": "6308206",
            "initDialog": "630820601",
            "dialogues": [
                {
                    "id": "630820601",
                    "speaker": "枫",
                    "text": "啊，又来了吗…不，我是说，你好，欢迎。"
                }
            ]
        },
        {
            "talkId": "6308207",
            "initDialog": "630820701",
            "dialogues": [
                {
                    "id": "630820701",
                    "speaker": "Player",
                    "text": "关于这家店…"
                },
                {
                    "id": "630820702",
                    "speaker": "枫",
                    "text": "本店主要贩卖一些旅游纪念品，例如稻妻的小说、狸猫玩偶什么的。"
                },
                {
                    "id": "630820703",
                    "speaker": "枫",
                    "text": "如果遇到特别的时段，比如节日或者庆典…还会售卖将军大人的塑像什么的。"
                }
            ]
        },
        {
            "talkId": "6308208",
            "initDialog": "630820801",
            "dialogues": [
                {
                    "id": "630820801",
                    "speaker": "Player",
                    "text": "将军的…塑像？"
                },
                {
                    "id": "630820802",
                    "speaker": "枫",
                    "text": "嗯，将军大人是一位宽宏大量的人，并不在意别人出于什么样的理由购买自己的塑像。"
                },
                {
                    "id": "630820803",
                    "speaker": "枫",
                    "text": "唔，本来在锁国令实施之前，这还是本店最热销的商品来着呢…但现在旧版的那种早就停产了，换成了重新设计的新版本。"
                }
            ]
        },
        {
            "talkId": "6308209",
            "initDialog": "630820901",
            "dialogues": [
                {
                    "id": "630820901",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6308210",
            "initDialog": "630821001",
            "dialogues": [
                {
                    "id": "630821001",
                    "speaker": "枫",
                    "text": "呜…怎么会，居然是因为这种原因输掉的…"
                }
            ]
        },
        {
            "talkId": "6308211",
            "initDialog": "630821101",
            "dialogues": [
                {
                    "id": "630821101",
                    "speaker": "枫",
                    "text": "啊，客人，不如买只玩偶吧，说不定运气能变好一点…"
                }
            ]
        }
    ]
}