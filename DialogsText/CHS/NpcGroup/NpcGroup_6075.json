{
    "groupId": "6075",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "帕莉西娅": 11
    },
    "talks": [
        {
            "talkId": "6607501",
            "initDialog": "660750101",
            "dialogues": [
                {
                    "id": "660750101",
                    "speaker": "帕莉西娅",
                    "text": "大海啊，就像一块巨大的蓝宝石。"
                }
            ]
        },
        {
            "talkId": "6607502",
            "initDialog": "660750201",
            "dialogues": [
                {
                    "id": "660750201",
                    "speaker": "Player",
                    "text": "那应该能卖不少钱。"
                },
                {
                    "id": "660750202",
                    "speaker": "帕莉西娅",
                    "text": "那肯定能卖相当多的钱。"
                },
                {
                    "id": "660750203",
                    "speaker": "帕莉西娅",
                    "text": "而且不同的海域有着不同的形状，颜色也千变万化，如果顺着水流的方向切割…或者逆向…"
                },
                {
                    "id": "660750204",
                    "speaker": "帕莉西娅",
                    "text": "哎呀，抱歉，思绪越跑越远了，要怪就怪我是个宝石商人吧。"
                },
                {
                    "id": "660750205",
                    "speaker": "帕莉西娅",
                    "text": "我对宝石的爱和对大海的爱势均力敌，想要在二者之间取得平衡还挺难的呢。"
                },
                {
                    "id": "660750206",
                    "speaker": "帕莉西娅",
                    "text": "还好我在这边有固定的合作商，方便我常来做客。"
                }
            ]
        },
        {
            "talkId": "6607503",
            "initDialog": "660750301",
            "dialogues": [
                {
                    "id": "660750301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660750302",
                    "speaker": "帕莉西娅",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6607504",
            "initDialog": "660750401",
            "dialogues": [
                {
                    "id": "660750401",
                    "speaker": "Player",
                    "text": "生意如何？"
                },
                {
                    "id": "660750402",
                    "speaker": "帕莉西娅",
                    "text": "最近的「成交量」很不错哦，但并不是金钱往来。"
                },
                {
                    "id": "660750403",
                    "speaker": "帕莉西娅",
                    "text": "你知道，回声之子那边盛产宝石，但其他物资就有些匮乏了。"
                },
                {
                    "id": "660750404",
                    "speaker": "帕莉西娅",
                    "text": "这次正好靠着做生意时攒下的人脉，用宝石、武器、工具什么的帮部族里换到了不少有用的东西。"
                },
                {
                    "id": "660750405",
                    "speaker": "帕莉西娅",
                    "text": "把这些事情都安排好，比赚笔大的还能让人安心看海。"
                }
            ]
        }
    ]
}