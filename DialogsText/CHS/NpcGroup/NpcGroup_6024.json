    "talks": [
        {
            "talkId": "6602401",
            "initDialog": "660240101",
            "dialogues": [
                {
                    "id": "660240101",
                    "speaker": "薇尔恰",
                    "text": "下次可以换质地更柔软的鬃毛梳…"
                }
            ]
        },
        {
            "talkId": "6602402",
            "initDialog": "660240201",
            "dialogues": [
                {
                    "id": "660240201",
                    "speaker": "Player",
                    "text": "鬃毛梳？"
                },
                {
                    "id": "660240202",
                    "speaker": "薇尔恰",
                    "text": "嗯，比一般的木齿梳质地更柔软，适合保养毛发。"
                },
                {
                    "id": "660240203",
                    "speaker": "薇尔恰",
                    "text": "不过有些龙喜欢梳毛并不是为了整理毛发，而是喜欢梳齿按摩的感觉吧。"
                },
                {
                    "id": "660240204",
                    "speaker": "薇尔恰",
                    "text": "那种情况下，换成宽齿梳更好。"
                },
                {
                    "id": "660240205",
                    "speaker": "薇尔恰",
                    "text": "相信我，如果有龙和你关系不好，你可以试着给它梳梳毛哦！没准能有奇效。"
                },
                {
                    "id": "660240206",
                    "speaker": "薇尔恰",
                    "text": "当然，前提是，你得先梳得到它的毛。"
                }
            ]
        },
        {
            "talkId": "6602403",
            "initDialog": "660240301",
            "dialogues": [
                {
                    "id": "660240301",
                    "speaker": "Player",
                    "text": "我也试试。"
                },
                {
                    "id": "660240302",
                    "speaker": "薇尔恰",
                    "text": "欸？…唔，也不是不行。"
                }
            ]
        }
    ]
}