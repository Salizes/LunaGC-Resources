{
    "groupId": "2034",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "老孙": 4,
        "老高": 18
    },
    "talks": [
        {
            "talkId": "4003722",
            "initDialog": "400372201",
            "dialogues": [
                {
                    "id": "400372201",
                    "speaker": "老高",
                    "text": "买鱼吗？"
                },
                {
                    "id": "400372202",
                    "speaker": "老高",
                    "text": "海灯节的鱼，就和平常一样新鲜。"
                },
                {
                    "id": "400372203",
                    "speaker": "老高",
                    "text": "价格也跟平常一样，一条三百摩拉，三条一千摩拉。"
                }
            ]
        },
        {
            "talkId": "6203401",
            "initDialog": "620340101",
            "dialogues": [
                {
                    "id": "620340101",
                    "speaker": "老高",
                    "text": "买鱼吗？"
                },
                {
                    "id": "620340102",
                    "speaker": "老高",
                    "text": "一条三百摩拉，三条一千摩拉。"
                }
            ]
        },
        {
            "talkId": "6203402",
            "initDialog": "620340201",
            "dialogues": [
                {
                    "id": "620340201",
                    "speaker": "老高",
                    "text": "怎么买多了还贵了？"
                },
                {
                    "id": "620340202",
                    "speaker": "老高",
                    "text": "我的鱼，我乐意！"
                },
                {
                    "id": "620340203",
                    "speaker": "老高",
                    "text": "你看看这鱼多新鲜，买一条你小赚，买两条我小亏，买三条我都亏本了！多买多赚你懂吗！"
                },
                {
                    "id": "620340204",
                    "speaker": "老高",
                    "text": "而且我的鱼卖一条少一条，越少越贵不是很正常，没听说过那什么…「稀缺性」吗，你居然还嫌弃价格？"
                },
                {
                    "id": "620340205",
                    "speaker": "老高",
                    "text": "对你这种人，我就只有四个字——爱买不买！"
                }
            ]
        },
        {
            "talkId": "6203403",
            "initDialog": "620340301",
            "dialogues": [
                {
                    "id": "620340301",
                    "speaker": "老高",
                    "text": "不买，再见。"
                },
                {
                    "id": "620340302",
                    "speaker": "老高",
                    "text": "不买就看看？那你可亏大了啊！"
                }
            ]
        },
        {
            "talkId": "6203404",
            "initDialog": "620340401",
            "dialogues": [
                {
                    "id": "620340401",
                    "speaker": "老高",
                    "text": "买新鲜的鱼。"
                },
                {
                    "id": "620340402",
                    "speaker": "老高",
                    "text": "行啊，算你捡了个大便宜！不过可不能退货啊！"
                }
            ]
        },
        {
            "talkId": "6203405",
            "initDialog": "620340501",
            "dialogues": [
                {
                    "id": "620340501",
                    "speaker": "老高",
                    "text": "孙弟，今天赚了不少吧？"
                },
                {
                    "id": "620340502",
                    "speaker": "老孙",
                    "text": "来，这是小弟孝敬您的，全靠高兄的妙计啊！"
                },
                {
                    "id": "620340503",
                    "speaker": "老高",
                    "text": "哼哼，那帮人肯定想不到，这一切都在我的计划之内！"
                },
                {
                    "id": "620340504",
                    "speaker": "老孙",
                    "text": "高兄就是高！肯定没人能想到咱们是一伙的，别人一看您的价格，再看我这边的价格，肯定就觉得自己赚到了！"
                },
                {
                    "id": "620340505",
                    "speaker": "老高",
                    "text": "哈哈哈哈，孙弟，喝酒喝酒！"
                },
                {
                    "id": "620340506",
                    "speaker": "老孙",
                    "text": "来，高兄，我给你满上！"
                },
                {
                    "id": "620340507",
                    "speaker": "老高",
                    "text": "好！今晚我们一定要一醉方休，哈哈哈哈！"
                },
                {
                    "id": "620340508",
                    "speaker": "老孙",
                    "text": "不说了，都在酒里！"
                }
            ]
        }
    ]
}