{
    "groupId": "2264",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 7,
        "寒泉": 19
    },
    "talks": [
        {
            "talkId": "6226401",
            "initDialog": "622640101",
            "dialogues": [
                {
                    "id": "622640101",
                    "speaker": "寒泉",
                    "text": "区区七品的小卒，也敢如此飞扬跋扈…"
                }
            ]
        },
        {
            "talkId": "6226402",
            "initDialog": "622640201",
            "dialogues": [
                {
                    "id": "622640201",
                    "speaker": "Player",
                    "text": "七品小卒？"
                },
                {
                    "id": "622640202",
                    "speaker": "寒泉",
                    "text": "这世间习武之人分为九品，其中一品最高九品最低。"
                },
                {
                    "id": "622640203",
                    "speaker": "寒泉",
                    "text": "前两日，我护送岩上茶室的采办来翘英庄时，中途遇见了个口出狂言的蟊贼。"
                },
                {
                    "id": "622640204",
                    "speaker": "寒泉",
                    "text": "我技痒难耐，就跟他出手过了几招，结果发现他不过只有七品的实力，不值一哂。"
                },
                {
                    "id": "622640205",
                    "speaker": "寒泉",
                    "text": "说到底，武艺高强之人，都大隐隐于市，也不知这些跳梁小丑凭什么如此嚣张。"
                }
            ]
        },
        {
            "talkId": "6226403",
            "initDialog": "622640301",
            "dialogues": [
                {
                    "id": "622640301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622640302",
                    "speaker": "寒泉",
                    "text": "后会有期。"
                }
            ]
        },
        {
            "talkId": "6226404",
            "initDialog": "622640401",
            "dialogues": [
                {
                    "id": "622640401",
                    "speaker": "Player",
                    "text": "这是谁分的高低？"
                },
                {
                    "id": "622640402",
                    "speaker": "寒泉",
                    "text": "当然是我了，我见识过不少武林中人，绝不会看走眼。"
                },
                {
                    "id": "622640403",
                    "speaker": "寒泉",
                    "text": "这么说吧，璃月蒙德商道上有一好手，名为黄衫，她勉强算个三品。"
                },
                {
                    "id": "622640404",
                    "speaker": "寒泉",
                    "text": "古华派弟子孙宇，使得一手凌厉快剑，已入二品之列。"
                },
                {
                    "id": "622640405",
                    "speaker": "寒泉",
                    "text": "至于一品强者嘛，肯定是能登堂入室的武学大师。"
                },
                {
                    "id": "622640406",
                    "speaker": "寒泉",
                    "text": "要我说的话，我看冒险家协会的分会长岚姐可为代表。"
                }
            ]
        },
        {
            "talkId": "6226405",
            "initDialog": "622640501",
            "dialogues": [
                {
                    "id": "622640501",
                    "speaker": "Player",
                    "text": "你是什么品阶？"
                },
                {
                    "id": "622640502",
                    "speaker": "寒泉",
                    "text": "在下不才，姑且算个三品强者。"
                }
            ]
        },
        {
            "talkId": "6226406",
            "initDialog": "622640601",
            "dialogues": [
                {
                    "id": "622640601",
                    "speaker": "Player",
                    "text": "夜兰是什么品阶？"
                },
                {
                    "id": "622640602",
                    "speaker": "寒泉",
                    "text": "奇怪，你怎么知道我们老板的名字？"
                },
                {
                    "id": "622640603",
                    "speaker": "寒泉",
                    "text": "在我的印象里，老板温文尔雅，几句话就能解决问题，从没见她动过武。"
                },
                {
                    "id": "622640604",
                    "speaker": "寒泉",
                    "text": "没动过武的人，应该连九品都不算吧…"
                }
            ]
        },
        {
            "talkId": "6226407",
            "initDialog": "622640701",
            "dialogues": [
                {
                    "id": "622640701",
                    "speaker": "Player",
                    "text": "我是什么品阶？"
                },
                {
                    "id": "622640702",
                    "speaker": "寒泉",
                    "text": "你的武名，说实话我在道上还没有听说过…"
                },
                {
                    "id": "622640703",
                    "speaker": "寒泉",
                    "text": "不过，我看你目光炯炯，呼吸绵长，想来最起码也是个二品强者。"
                }
            ]
        },
        {
            "talkId": "6226408",
            "initDialog": "622640801",
            "dialogues": [
                {
                    "id": "622640801",
                    "speaker": "Player",
                    "text": "我起码一品喔！"
                },
                {
                    "id": "622640802",
                    "speaker": "寒泉",
                    "text": "你还真是不客气…"
                },
                {
                    "id": "622640803",
                    "speaker": "寒泉",
                    "text": "要是来日有缘，还望看你露上两手。"
                }
            ]
        }
    ]
}