{
    "groupId": "4042",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 9,
        "阿汉格尔": 17
    },
    "talks": [
        {
            "talkId": "5900064",
            "initDialog": "590006401",
            "dialogues": [
                {
                    "id": "590006401",
                    "speaker": "Player",
                    "text": "关于须弥的矿产…"
                }
            ]
        },
        {
            "talkId": "5900065",
            "initDialog": "590006501",
            "dialogues": [
                {
                    "id": "590006501",
                    "speaker": "阿汉格尔",
                    "text": "抱歉，目前没什么消息。你可以过段时间再来。"
                }
            ]
        },
        {
            "talkId": "6404201",
            "initDialog": "640420101",
            "dialogues": [
                {
                    "id": "640420101",
                    "speaker": "阿汉格尔",
                    "text": "有事请直说。"
                }
            ]
        },
        {
            "talkId": "6404202",
            "initDialog": "640420201",
            "dialogues": [
                {
                    "id": "640420201",
                    "speaker": "Player",
                    "text": "委托锻造…"
                },
                {
                    "id": "640420202",
                    "speaker": "阿汉格尔",
                    "text": "好。"
                }
            ]
        },
        {
            "talkId": "6404203",
            "initDialog": "640420301",
            "dialogues": [
                {
                    "id": "640420301",
                    "speaker": "Player",
                    "text": "想买武器。"
                },
                {
                    "id": "640420302",
                    "speaker": "阿汉格尔",
                    "text": "纹钢兵器需要预定，现成的只有这些。"
                }
            ]
        },
        {
            "talkId": "6404204",
            "initDialog": "640420401",
            "dialogues": [
                {
                    "id": "640420401",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640420402",
                    "speaker": "阿汉格尔",
                    "text": "我是专门为镀金旅团打造金属武器的铁匠，偶尔也为其他人做一些工具、饰品或家具之类的东西。"
                },
                {
                    "id": "640420403",
                    "speaker": "阿汉格尔",
                    "text": "须弥是崇尚草元素的地方，学者们不习惯佩戴武装，又信奉树王大人，似乎大多对金属兵器有些抵触。"
                },
                {
                    "id": "640420404",
                    "speaker": "阿汉格尔",
                    "text": "木刀木剑什么的，我也能做。但订单最多的，还是佣兵们需要的纹钢兵器。"
                }
            ]
        },
        {
            "talkId": "6404205",
            "initDialog": "640420501",
            "dialogues": [
                {
                    "id": "640420501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640420502",
                    "speaker": "阿汉格尔",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6404206",
            "initDialog": "640420601",
            "dialogues": [
                {
                    "id": "640420601",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>委托锻造…</color>"
                },
                {
                    "id": "640420602",
                    "speaker": "阿汉格尔",
                    "text": "之前的委托已完成。还有吗？"
                }
            ]
        },
        {
            "talkId": "6404207",
            "initDialog": "640420701",
            "dialogues": [
                {
                    "id": "640420701",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640420702",
                    "speaker": "阿汉格尔",
                    "text": "我是专门为镀金旅团打造金属武器的铁匠，偶尔也为其他人做一些工具、饰品或家具之类的东西。"
                },
                {
                    "id": "640420703",
                    "speaker": "阿汉格尔",
                    "text": "须弥是崇尚草元素的地方，学者们不习惯佩戴武装，又信奉草神大人，似乎大多对金属兵器有些抵触。"
                },
                {
                    "id": "640420704",
                    "speaker": "阿汉格尔",
                    "text": "木刀木剑什么的，我也能做。但订单最多的，还是佣兵们需要的纹钢兵器。"
                }
            ]
        },
        {
            "talkId": "6404208",
            "initDialog": "640420801",
            "dialogues": [
                {
                    "id": "640420801",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6404209",
            "initDialog": "640420901",
            "dialogues": [
                {
                    "id": "640420901",
                    "speaker": "阿汉格尔",
                    "text": "是你赢了，不得不说，你确实很厉害。"
                }
            ]
        },
        {
            "talkId": "6404210",
            "initDialog": "640421001",
            "dialogues": [
                {
                    "id": "640421001",
                    "speaker": "阿汉格尔",
                    "text": "你很了不起，只是我更强。"
                }
            ]
        },
        {
            "talkId": "7393101",
            "initDialog": "739310101",
            "dialogues": [
                {
                    "id": "739310101",
                    "speaker": "Player",
                    "text": "我都不挑。"
                },
                {
                    "id": "739310102",
                    "speaker": "阿汉格尔",
                    "text": "那说明你对自己的身手很有自信。"
                },
                {
                    "id": "739310103",
                    "speaker": "阿汉格尔",
                    "text": "不过下雨最容易淋湿打伞的人，你最好也不要太大意了。"
                },
                {
                    "id": "739310104",
                    "speaker": "阿汉格尔",
                    "text": "定期维护趁手的武器，才能随时应对危机。"
                }
            ]
        }
    ]
}