{
    "groupId": "4460",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "佐西摩斯": 9
    },
    "talks": [
        {
            "talkId": "6446001",
            "initDialog": "644600101",
            "dialogues": [
                {
                    "id": "644600101",
                    "speaker": "佐西摩斯",
                    "text": "哦，有段时间没见了，哈哈，怎么样，在这里还玩得开心吗？"
                },
                {
                    "id": "644600102",
                    "speaker": "佐西摩斯",
                    "text": "多亏你们的帮忙，琉形蜃境恢复运转之后，原来缺失的部分也被一点一点补足，也逐渐恢复了以前的生气。"
                }
            ]
        },
        {
            "talkId": "6446002",
            "initDialog": "644600201",
            "dialogues": [
                {
                    "id": "644600201",
                    "speaker": "Player",
                    "text": "关于演出…"
                },
                {
                    "id": "644600202",
                    "speaker": "佐西摩斯",
                    "text": "啊，多谢你的帮忙，我才能第一次看到自己的演出。也收集到了很有益的意见。"
                },
                {
                    "id": "644600203",
                    "speaker": "佐西摩斯",
                    "text": "我一定会在此过程中精进自己讲故事的方法，一定能够成为真正的「导演」的。"
                }
            ]
        },
        {
            "talkId": "6446003",
            "initDialog": "644600301",
            "dialogues": [
                {
                    "id": "644600301",
                    "speaker": "Player",
                    "text": "关于水形幻灵…"
                },
                {
                    "id": "644600302",
                    "speaker": "佐西摩斯",
                    "text": "哦，你是问它们的事啊，虽然它们不能说话，不过…「我们」有特殊的互相沟通的办法。"
                },
                {
                    "id": "644600303",
                    "speaker": "佐西摩斯",
                    "text": "对我来说，它们都是很可靠的工作伙伴。"
                },
                {
                    "id": "644600304",
                    "speaker": "佐西摩斯",
                    "text": "实际上，这里有一些外景的舞台，都是靠它们维持运转的，如果你有空的话，可以去逛逛看。"
                },
                {
                    "id": "644600305",
                    "speaker": "佐西摩斯",
                    "text": "至于故事嘛，哈哈，大部分是我写的。如果觉得哪里有问题，还请不吝赐教。"
                }
            ]
        },
        {
            "talkId": "6446004",
            "initDialog": "644600401",
            "dialogues": [
                {
                    "id": "644600401",
                    "speaker": "Player",
                    "text": "我先离开了。"
                },
                {
                    "id": "644600402",
                    "speaker": "佐西摩斯",
                    "text": "哈哈，好，请尽情四处逛逛吧，这里可是个好地方。啊，对我的舞台有什么意见的话，可以随时来找我。"
                }
            ]
        }
    ]
}