    "speaker_counts": {
        "Player": 4,
        "依扎娜": 10
    },
    "talks": [
        {
            "talkId": "6600201",
            "initDialog": "660020101",
            "dialogues": [
                {
                    "id": "660020101",
                    "speaker": "依扎娜",
                    "text": "欢迎光临。"
                }
            ]
        },
        {
            "talkId": "6600202",
            "initDialog": "660020201",
            "dialogues": [
                {
                    "id": "660020201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "660020202",
                    "speaker": "依扎娜",
                    "text": "是可以买到各个部族风格面具的地方，有看上的款式就跟我说。"
                },
                {
                    "id": "660020203",
                    "speaker": "依扎娜",
                    "text": "如果，我是说万一，没有你喜欢的样式的话，这里有现成的材料，你可以自己上手制作。"
                },
                {
                    "id": "660020204",
                    "speaker": "依扎娜",
                    "text": "你自己做的话，我就只收材料费。"
                }
            ]
        },
        {
            "talkId": "6600203",
            "initDialog": "660020301",
            "dialogues": [
                {
                    "id": "660020301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660020302",
                    "speaker": "依扎娜",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6600204",
            "initDialog": "660020401",
            "dialogues": [
                {
                    "id": "660020401",
                    "speaker": "Player",
                    "text": "一般什么时候会戴面具？"
                },
                {
                    "id": "660020402",
                    "speaker": "依扎娜",
                    "text": "看你喜欢，想戴随时可以戴。"
                },
                {
                    "id": "660020403",
                    "speaker": "依扎娜",
                    "text": "不过一般来说，节假日的时候，佩戴面具的人会更多一些。"
                },
                {
                    "id": "660020404",
                    "speaker": "依扎娜",
                    "text": "还有就是有比赛时，很多人会戴上自己支持的部族的面具，为战士们加油鼓劲。"
                },
                {
                    "id": "660020405",
                    "speaker": "依扎娜",
                    "text": "平时的话，你就当是个好看的装饰就行。"
                }
            ]
        },
        {
            "talkId": "6600205",
            "initDialog": "660020501",
            "dialogues": [
                {
                    "id": "660020501",
                    "speaker": "Player",
                    "text": "那我想要「飞行矮堇瓜」。"
                },
                {
                    "id": "660020502",
                    "speaker": "依扎娜",
                    "text": "…啊？那是什么？"
                }
            ]
        }
    ]
}