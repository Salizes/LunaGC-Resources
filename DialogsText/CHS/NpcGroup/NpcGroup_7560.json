{
    "groupId": "7560",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "戈尔什科夫": 8
    },
    "talks": [
        {
            "talkId": "6756001",
            "initDialog": "675600101",
            "dialogues": [
                {
                    "id": "675600101",
                    "speaker": "戈尔什科夫",
                    "text": "今天的海风也挺不错的…说明海上不会有大浪，真好啊，待会儿整杯火水庆祝一下吧…"
                }
            ]
        },
        {
            "talkId": "6756002",
            "initDialog": "675600201",
            "dialogues": [
                {
                    "id": "675600201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "675600202",
                    "speaker": "戈尔什科夫",
                    "text": "我吗？我只是一个小小的事务官罢了，虽然同期都已经要么进皇都评议会要么进至冬宫…"
                },
                {
                    "id": "675600203",
                    "speaker": "戈尔什科夫",
                    "text": "但是在那边工作可就辛苦了，哪有在这里悠闲自在啊…"
                }
            ]
        },
        {
            "talkId": "6756003",
            "initDialog": "675600301",
            "dialogues": [
                {
                    "id": "675600301",
                    "speaker": "Player",
                    "text": "天气好也值得庆祝？"
                },
                {
                    "id": "675600302",
                    "speaker": "戈尔什科夫",
                    "text": "天气好就说明不会有特别大的风浪，不会有特别大的风浪就说明渔民们能够安然回家。"
                },
                {
                    "id": "675600303",
                    "speaker": "戈尔什科夫",
                    "text": "虽然大多数渔民都以与海浪搏斗为荣，但是我发自内心地希望他们不需要经历那么多的风浪。"
                },
                {
                    "id": "675600304",
                    "speaker": "戈尔什科夫",
                    "text": "父母能迎回他们的孩子，而孩子们能够迎回他们的父母…这就值得今天喝上一杯啦？"
                }
            ]
        },
        {
            "talkId": "6756004",
            "initDialog": "675600401",
            "dialogues": [
                {
                    "id": "675600401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675600402",
                    "speaker": "戈尔什科夫",
                    "text": "再见，祝您旅途愉快。"
                }
            ]
        },
        {
            "talkId": "6756005",
            "initDialog": "675600501",
            "dialogues": [
                {
                    "id": "675600501",
                    "speaker": "Player",
                    "text": "附近有什么值得留意的吗？"
                }
            ]
        },
        {
            "talkId": "6756006",
            "initDialog": "675600601",
            "dialogues": [
                {
                    "id": "675600601",
                    "speaker": "戈尔什科夫",
                    "text": "这附近？唯一应该留意的应该是老杜佐洛夫养的熊吧…虽然看上去好像很和善，但毕竟是熊…"
                }
            ]
        }
    ]
}