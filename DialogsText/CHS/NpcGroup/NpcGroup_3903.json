{
    "groupId": "3903",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "（test）Override老人$UNRELEASED": 9
    },
    "talks": [
        {
            "talkId": "6390301",
            "initDialog": "639030101",
            "dialogues": [
                {
                    "id": "639030101",
                    "speaker": "（test）Override老人$UNRELEASED",
                    "text": "（test）你好，如果是想上雪山的话，请多加小心。$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "6390302",
            "initDialog": "639030201",
            "dialogues": [
                {
                    "id": "639030201",
                    "speaker": "Player",
                    "text": "（test）你在这里做什么？"
                },
                {
                    "id": "639030202",
                    "speaker": "（test）Override老人$UNRELEASED",
                    "text": "（test）我奉代理团长大人的命令在这里驻守，警告蒙德的居民不要上雪山。$UNRELEASED"
                },
                {
                    "id": "639030203",
                    "speaker": "（test）Override老人$UNRELEASED",
                    "text": "（test）前段时间我就拦下过想要上山野营的一家三口、几个想去山顶打雪仗的小孩子什么的。$UNRELEASED"
                },
                {
                    "id": "639030204",
                    "speaker": "（test）Override老人$UNRELEASED",
                    "text": "（test）不过也不能怪他们缺少警惕性，如今蒙德城的生活真是太过安逸了，以至于大多数人都无法想象雪山的环境是何等的恶劣…$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "6390303",
            "initDialog": "639030301",
            "dialogues": [
                {
                    "id": "639030301",
                    "speaker": "Player",
                    "text": "（test）这里的环境…"
                },
                {
                    "id": "639030302",
                    "speaker": "（test）Override老人$UNRELEASED",
                    "text": "（test）说到这个，在这里活动一定要多穿些，可别被冻到了。$UNRELEASED"
                },
                {
                    "id": "639030303",
                    "speaker": "（test）Override老人$UNRELEASED",
                    "text": "（test）像我的不少同僚来过一次之后便再也不敢来了。$UNRELEASED"
                },
                {
                    "id": "639030304",
                    "speaker": "（test）Override老人$UNRELEASED",
                    "text": "（test）嗯？你问我为什么不怕冷？$UNRELEASED"
                },
                {
                    "id": "639030305",
                    "speaker": "（test）Override老人$UNRELEASED",
                    "text": "（test）因为我有如钢铁般坚毅的意志和不惧寒风的坚强体魄…以及我还在铠甲里套了三四层衣服，绝对保暖。$UNRELEASED"
                }
            ]
        },
        {
            "talkId": "6390304",
            "initDialog": "639030401",
            "dialogues": [
                {
                    "id": "639030401",
                    "speaker": "Player",
                    "text": "（test）谢谢你的提醒，再见。"
                },
                {
                    "id": "639030402",
                    "speaker": "（test）Override老人$UNRELEASED",
                    "text": "（test）愿巴巴托斯大人的风护佑你。$UNRELEASED"
                }
            ]
        }
    ]
}