{
    "groupId": "9348",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "久岐忍": 9
    },
    "talks": [
        {
            "talkId": "6934801",
            "initDialog": "693480101",
            "dialogues": [
                {
                    "id": "693480101",
                    "speaker": "久岐忍",
                    "text": "休息时，如果你偶尔看到我把面铠摘下来，不要奇怪，我就是透透气而已。"
                },
                {
                    "id": "693480102",
                    "speaker": "久岐忍",
                    "text": "这地方太清闲了，待久了总感觉人也会跟着散漫下来…不做个深呼吸可不行。"
                },
                {
                    "id": "693480103",
                    "speaker": "久岐忍",
                    "text": "不急，没有催你的意思，我会等你做好准备的。"
                }
            ]
        },
        {
            "talkId": "6934802",
            "initDialog": "693480201",
            "dialogues": [
                {
                    "id": "693480201",
                    "speaker": "久岐忍",
                    "text": "敌人比较棘手的话，不妨交给我来处理。"
                },
                {
                    "id": "693480202",
                    "speaker": "久岐忍",
                    "text": "既然我接受邀请来到这里，自然愿意为你的目标出一份力。"
                },
                {
                    "id": "693480203",
                    "speaker": "久岐忍",
                    "text": "至于具体要负责哪一部分，台前还是幕后，就交给你来安排了。我都能应付。"
                }
            ]
        },
        {
            "talkId": "6934803",
            "initDialog": "693480301",
            "dialogues": [
                {
                    "id": "693480301",
                    "speaker": "久岐忍",
                    "text": "我很期待读到一个叛逆的公主的故事。比如脱去碍事的长裙，去学习骑马、舞剑…或许还有药理学。"
                },
                {
                    "id": "693480302",
                    "speaker": "久岐忍",
                    "text": "过真正自由的生活，等邪恶势力来了就亲手打跑对方，用自己的力量保护人民与王国。"
                },
                {
                    "id": "693480303",
                    "speaker": "久岐忍",
                    "text": "…要不我动手写一个算了。"
                }
            ]
        }
    ]
}