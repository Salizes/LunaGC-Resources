            "dialogues": [
                {
                    "id": "675270401",
                    "speaker": "Player",
                    "text": "你这酒保证是妖精酿的吗？"
                },
                {
                    "id": "675270402",
                    "speaker": "萨瓦",
                    "text": "是啊。这都是新基捷的妖精老爷们酿出来的好东西，你嫌贵，我还嫌贵呢。"
                },
                {
                    "id": "675270403",
                    "speaker": "萨瓦",
                    "text": "放在白沙皇的时代，这种纯度的佳酿只有那些高高在上的妖精贵族才能享用。"
                },
                {
                    "id": "675270404",
                    "speaker": "萨瓦",
                    "text": "至于如今嘛，只要口袋里有足够的摩拉，谁都能买来喝个痛快。"
                }
            ]
        },
        {
            "talkId": "6752705",
            "initDialog": "675270501",
            "dialogues": [
                {
                    "id": "675270501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675270502",
                    "speaker": "萨瓦",
                    "text": "慢走。如果想要驱寒，随时欢迎来照顾我的生意。"
                }
            ]
        }
    ]
