    },
    "talks": [
        {
            "talkId": "6243705",
            "initDialog": "624370501",
            "dialogues": [
                {
                    "id": "624370501",
                    "speaker": "芙蓉",
                    "text": "旅行者，你来啦！那个…如果有空的话，能请你上去看看吗？"
                }
            ]
        },
        {
            "talkId": "6243706",
            "initDialog": "624370601",
            "dialogues": [
                {
                    "id": "624370601",
                    "speaker": "Player",
                    "text": "还是老样子啊。"
                },
                {
                    "id": "624370602",
                    "speaker": "芙蓉",
                    "text": "是啦，毕竟我是「死兆星号」的水手，主要负责打架。"
                },
                {
                    "id": "624370603",
                    "speaker": "芙蓉",
                    "text": "…别看我瞧着瘦弱，大副重佐的力气都没我大，他和我掰手腕可是一次都没赢过，哼哼！"
                },
                {
                    "id": "624370604",
                    "speaker": "芙蓉",
                    "text": "顺带一提，我择偶的标准也很简单，只要能在掰手腕上赢过我就行了，就这么简单。"
                },
                {
                    "id": "624370605",
                    "speaker": "芙蓉",
                    "text": "可惜，截止目前赢过我的人就只有一个人…当然，是北斗大姐头啦。"
                },
                {
                    "id": "624370606",
                    "speaker": "芙蓉",
                    "text": "不过…如果你愿意和我比试一下的话，结果就说不定了，嘿嘿。"
                }
            ]
        },
        {
            "talkId": "6243701",
            "initDialog": "624370101",
            "dialogues": [
                {
                    "id": "624370101",
                    "speaker": "芙蓉",
                    "text": "旅行者，如果有空的话能上去看看吗？"
                }
            ]
        },
        {
            "talkId": "6243702",
            "initDialog": "624370201",
            "dialogues": [
                {
                    "id": "624370201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624370202",
                    "speaker": "芙蓉",
                    "text": "我是「死兆星号」的水手，主要负责打架。"
                },
                {
                    "id": "624370203",
                    "speaker": "芙蓉",
                    "text": "…别看我瞧着瘦弱，大副重佐的力气都没我大，他和我掰手腕可是一次都没赢过，哼哼！"
                },
                {
                    "id": "624370204",
                    "speaker": "芙蓉",
                    "text": "顺带一提，我择偶的标准也很简单，只要能在掰手腕上赢过我就行了，就这么简单。"
                },
                {
                    "id": "624370205",
                    "speaker": "芙蓉",
                    "text": "可惜，截止目前赢过我的人就只有一个人…当然，是北斗大姐头啦。"
                }
            ]
        },
        {
            "talkId": "6243703",
            "initDialog": "624370301",
            "dialogues": [
                {
                    "id": "624370301",
                    "speaker": "Player",
                    "text": "上面？"
                },
                {
                    "id": "624370302",
                    "speaker": "芙蓉",
                    "text": "我是指桅杆上的瞭望台，不知道六石那边有没有发现什么情况。"
                },
                {
                    "id": "624370303",
                    "speaker": "芙蓉",
                    "text": "我喊了好久都没有人回应，可能是最近海风太大了，他没听清吧。"
                },
                {
                    "id": "624370304",
                    "speaker": "芙蓉",
                    "text": "我有点恐高，所以不敢上去…咳咳，你有空就上去看看吧。"
                }
            ]
        },
        {
            "talkId": "6243704",
            "initDialog": "624370401",
            "dialogues": [
                {
                    "id": "624370401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624370402",
                    "speaker": "芙蓉",
                    "text": "嗯，再见。"
                }
            ]
        }
    ]
