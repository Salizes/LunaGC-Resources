    "talks": [
        {
            "talkId": "7350050",
            "initDialog": "735005001",
            "dialogues": [
                {
                    "id": "735005001",
                    "speaker": "马姆杜",
                    "text": "我们阿折罗造像之前每次发售新玩具，都能吸引到全奥摩斯港的小朋友。"
                },
                {
                    "id": "735005002",
                    "speaker": "马姆杜",
                    "text": "本来以为这次的兰那罗木刻也会大受欢迎，谁知道…"
                }
            ]
        },
        {
            "talkId": "7350057",
            "initDialog": "735005701",
            "dialogues": [
                {
                    "id": "735005701",
                    "speaker": "马姆杜",
                    "text": "有了拉齐的点子，我们终于可以开工了，希望这下小朋友们能高兴起来。"
                }
            ]
        },
        {
            "talkId": "7350110",
            "initDialog": "735011001",
            "dialogues": [
                {
                    "id": "735011001",
                    "speaker": "马姆杜",
                    "text": "没想到木刻这么受欢迎，手都刻酸了。"
                },
                {
                    "id": "735011002",
                    "speaker": "马姆杜",
                    "text": "接下来一段时间我们暂时不考虑开发新玩具了，先做到让奥摩斯港每一位小朋友都能拥有自己的兰那罗木刻再说。"
                }
            ]
        }
    ]
}