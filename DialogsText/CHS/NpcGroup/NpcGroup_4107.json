{
    "groupId": "4107",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "雷萨": 14
    },
    "talks": [
        {
            "talkId": "6410701",
            "initDialog": "641070101",
            "dialogues": [
                {
                    "id": "641070101",
                    "speaker": "雷萨",
                    "text": "有时真的是心有余而力不足啊…"
                }
            ]
        },
        {
            "talkId": "6410702",
            "initDialog": "641070201",
            "dialogues": [
                {
                    "id": "641070201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641070202",
                    "speaker": "雷萨",
                    "text": "你好，我是奥摩斯港的港务主管，负责港口贸易的各项事务，例如征收税费、出入港检查等等。"
                },
                {
                    "id": "641070203",
                    "speaker": "雷萨",
                    "text": "如果有什么关于贸易的问题，来找我或者我的秘书官都可以。"
                },
                {
                    "id": "641070204",
                    "speaker": "雷萨",
                    "text": "遇到违规行为时，也请务必立即上报，大家都会感谢你的…除了违法分子以外。"
                }
            ]
        },
        {
            "talkId": "6410703",
            "initDialog": "641070301",
            "dialogues": [
                {
                    "id": "641070301",
                    "speaker": "Player",
                    "text": "需要帮助吗？"
                },
                {
                    "id": "641070302",
                    "speaker": "雷萨",
                    "text": "多谢关心，不过有些问题由来已久，不是你我能轻易改变的。"
                },
                {
                    "id": "641070303",
                    "speaker": "雷萨",
                    "text": "按照须弥现行的规定，对外贸易只能在奥摩斯港开展，但有不少很久很久以前就在城里做生意的人…"
                },
                {
                    "id": "641070304",
                    "speaker": "雷萨",
                    "text": "想要遏止他们手上从古时传到现在的交易方式，还是太难了。"
                },
                {
                    "id": "641070305",
                    "speaker": "雷萨",
                    "text": "所以有些问题呢，不是我们不想解决，是实在无从下手啊。"
                }
            ]
        },
        {
            "talkId": "6410704",
            "initDialog": "641070401",
            "dialogues": [
                {
                    "id": "641070401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641070402",
                    "speaker": "雷萨",
                    "text": "再见，祝你一路顺风。"
                }
            ]
        },
        {
            "talkId": "6410705",
            "initDialog": "641070501",
            "dialogues": [
                {
                    "id": "641070501",
                    "speaker": "Player",
                    "text": "违规行为…"
                },
                {
                    "id": "641070502",
                    "speaker": "雷萨",
                    "text": "奥摩斯港是须弥进出口贸易的关键节点，所以这边出现最多的违规行为就是走私。"
                },
                {
                    "id": "641070503",
                    "speaker": "雷萨",
                    "text": "如果看到鬼鬼祟祟、偷偷摸摸运货的家伙，多半就是走私犯。"
                },
                {
                    "id": "641070504",
                    "speaker": "雷萨",
                    "text": "为了您自己的财务安全，请务必不要因为贪便宜而和可疑分子做交易。"
                },
                {
                    "id": "641070505",
                    "speaker": "雷萨",
                    "text": "另外…偶尔，我是说极偶尔啊，也会有逃犯试图从港口离开。"
                },
                {
                    "id": "641070506",
                    "speaker": "雷萨",
                    "text": "万一碰上了，千万别试图亲自阻拦，还是大声向附近巡逻的镀金旅团佣兵呼救吧。"
                }
            ]
        }
    ]
}