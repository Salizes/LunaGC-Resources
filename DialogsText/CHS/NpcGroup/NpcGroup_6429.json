{
    "groupId": "6429",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "卡布林": 10
    },
    "talks": [
        {
            "talkId": "6642901",
            "initDialog": "664290101",
            "dialogues": [
                {
                    "id": "664290101",
                    "speaker": "卡布林",
                    "text": "来来来，朋友！要不要试试我的秘制健康饮品？保证你是喝一瓶想两瓶，精神抖擞，神足气盈，连着打十个敌人都不费劲！"
                }
            ]
        },
        {
            "talkId": "6642902",
            "initDialog": "664290201",
            "dialogues": [
                {
                    "id": "664290201",
                    "speaker": "Player",
                    "text": "这是在卖什么？"
                },
                {
                    "id": "664290202",
                    "speaker": "卡布林",
                    "text": "嘿嘿，当然是健康饮料啦！这位朋友一看气色就不错，容光焕发，但还可以更好嘛！"
                },
                {
                    "id": "664290203",
                    "speaker": "卡布林",
                    "text": "咱这饮料可不是一般的果汁，是古老配方和现代创新的结晶，货真价实，没有半点虚假宣传！"
                },
                {
                    "id": "664290204",
                    "speaker": "卡布林",
                    "text": "连瓶带药，连工带料，您喝了我的健康饮料，保证您是跑得比盗宝鼬快，跳得比林猪高，锻炼起来更是卓有成效！"
                },
                {
                    "id": "664290205",
                    "speaker": "卡布林",
                    "text": "怎么样，来一瓶试试？"
                }
            ]
        },
        {
            "talkId": "6642903",
            "initDialog": "664290301",
            "dialogues": [
                {
                    "id": "664290301",
                    "speaker": "Player",
                    "text": "不要。"
                },
                {
                    "id": "664290302",
                    "speaker": "卡布林",
                    "text": "没关系，这趟街我天天都在，您要是有需要，随时回来找我！"
                }
            ]
        },
        {
            "talkId": "6642904",
            "initDialog": "664290401",
            "dialogues": [
                {
                    "id": "664290401",
                    "speaker": "Player",
                    "text": "林猪会跳吗！"
                },
                {
                    "id": "664290402",
                    "speaker": "卡布林",
                    "text": "哈哈，那就是跳得比绒翼龙高！不对，绒翼龙好像也不会跳是吧？那就是跳得比松鼠高！"
                },
                {
                    "id": "664290403",
                    "speaker": "卡布林",
                    "text": "真材实料，真材实料！您一试就知道，再怎么宣传都比不上实效！"
                }
            ]
        },
        {
            "talkId": "6642905",
            "initDialog": "664290501",
            "dialogues": [
                {
                    "id": "664290501",
                    "speaker": "Player",
                    "text": "仔细一看，不就是营养粉嘛…"
                },
                {
                    "id": "664290502",
                    "speaker": "卡布林",
                    "text": "哎呀，营养粉和营养粉也是有区别的嘛！您想，我卡布林做生意可全靠信誉，东西不顶用，我能站在这儿吹牛？"
                },
                {
                    "id": "664290503",
                    "speaker": "卡布林",
                    "text": "您瞧那些老客户，个个都是活招牌！咱们向来不坑人，您要是买了以后对效果不满意，明儿我把摊子拆了都成！"
                }
            ]
        }
    ]
}