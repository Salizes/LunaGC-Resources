{
    "groupId": "4236",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "兰加惟": 16
    },
    "talks": [
        {
            "talkId": "6423601",
            "initDialog": "642360101",
            "dialogues": [
                {
                    "id": "642360101",
                    "speaker": "兰加惟",
                    "text": "无忧节近了，不知道这次的无忧节会唱出什么样的旋律。"
                }
            ]
        },
        {
            "talkId": "6423602",
            "initDialog": "642360201",
            "dialogues": [
                {
                    "id": "642360201",
                    "speaker": "Player",
                    "text": "关于无忧节…"
                },
                {
                    "id": "642360202",
                    "speaker": "兰加惟",
                    "text": "#在无忧节的时候，那菈{NICKNAME}和兰那罗要一起歌唱。"
                },
                {
                    "id": "642360203",
                    "speaker": "兰加惟",
                    "text": "#不用担心，那菈{NICKNAME}的歌声，一定也是金色的，温暖的。"
                }
            ]
        },
        {
            "talkId": "6423603",
            "initDialog": "642360301",
            "dialogues": [
                {
                    "id": "642360301",
                    "speaker": "Player",
                    "text": "关于采歌者…"
                },
                {
                    "id": "642360302",
                    "speaker": "兰加惟",
                    "text": "#采歌者们因为那菈{NICKNAME}帮助，学会了许多个太阳升起之前就已经被遗忘的歌。"
                },
                {
                    "id": "642360303",
                    "speaker": "兰加惟",
                    "text": "这些歌，对于兰那罗来说，就像是那菈的「宝藏」。"
                },
                {
                    "id": "642360304",
                    "speaker": "兰加惟",
                    "text": "#采歌者都和那菈{NICKNAME}一起找过宝藏，都是好朋友。"
                }
            ]
        },
        {
            "talkId": "6423604",
            "initDialog": "642360401",
            "dialogues": [
                {
                    "id": "642360401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642360402",
                    "speaker": "兰加惟",
                    "text": "再见，兰那罗的好朋友。"
                }
            ]
        },
        {
            "talkId": "6423605",
            "initDialog": "642360501",
            "dialogues": [
                {
                    "id": "642360501",
                    "speaker": "兰加惟",
                    "text": "金色的那菈与兰罗摩击败了无留陀，与觉王树一起带来了新的故事，新的歌…"
                }
            ]
        },
        {
            "talkId": "6423606",
            "initDialog": "642360601",
            "dialogues": [
                {
                    "id": "642360601",
                    "speaker": "Player",
                    "text": "关于觉王树…"
                },
                {
                    "id": "642360602",
                    "speaker": "兰加惟",
                    "text": "很久很久以后，一定也会有新的那菈朋友来到桓那兰那。"
                },
                {
                    "id": "642360603",
                    "speaker": "兰加惟",
                    "text": "不过，以后的那菈不用再去到觉王树前寻找现在的旋律。"
                },
                {
                    "id": "642360604",
                    "speaker": "兰加惟",
                    "text": "因为所有兰那罗还有桓那的树叶和土壤都会记住这次的无忧节，记住金色的歌。"
                }
            ]
        },
        {
            "talkId": "6423607",
            "initDialog": "642360701",
            "dialogues": [
                {
                    "id": "642360701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642360702",
                    "speaker": "兰加惟",
                    "text": "再见，金色的那菈，兰那罗不会忘记你。"
                }
            ]
        },
        {
            "talkId": "6423608",
            "initDialog": "642360801",
            "dialogues": [
                {
                    "id": "642360801",
                    "speaker": "兰加惟",
                    "text": "#那菈{NICKNAME}，我们不会忘记你的。就算我们不在了，森林也不会忘记。就算森林有一天消失了，大地也会记住。"
                }
            ]
        },
        {
            "talkId": "7396701",
            "initDialog": "739670101",
            "dialogues": [
                {
                    "id": "739670101",
                    "speaker": "Player",
                    "text": "无忧节的歌…"
                },
                {
                    "id": "739670102",
                    "speaker": "兰加惟",
                    "text": "那是如同阳光一样金灿灿的歌，能成为歌里的一部分是我的骄傲。你作为「金色的那菈」，会永远留在我的记忆、桓那兰那的记忆里。"
                },
                {
                    "id": "739670103",
                    "speaker": "兰加惟",
                    "text": "这个孩子就交给你吧。这是歌之铃兰花，喜欢温暖的歌声，在过去，也是我们采歌者的象征。和她一样的花已经在桓那兰那毁灭的时候一同灭绝了，只剩下一颗种子。"
                },
                {
                    "id": "739670104",
                    "speaker": "兰加惟",
                    "text": "原本我们以为这颗种子永远不能生长、开花…应该是无忧节的歌为她注入了新生的力量吧。希望你将她带在身边，给她许多温暖、许多光明。"
                }
            ]
        }
    ]
}