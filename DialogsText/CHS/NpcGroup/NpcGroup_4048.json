{
    "groupId": "4048",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "塔希尔": 6
    },
    "talks": [
        {
            "talkId": "6404801",
            "initDialog": "640480101",
            "dialogues": [
                {
                    "id": "640480101",
                    "speaker": "塔希尔",
                    "text": "做生意真这么有意思吗？"
                }
            ]
        },
        {
            "talkId": "6404802",
            "initDialog": "640480201",
            "dialogues": [
                {
                    "id": "640480201",
                    "speaker": "Player",
                    "text": "也许吧。"
                },
                {
                    "id": "640480202",
                    "speaker": "塔希尔",
                    "text": "我反正不太理解买这些没用的花哨玩意儿有什么意义，可能因为我是从沙漠来的大老粗吧。"
                },
                {
                    "id": "640480203",
                    "speaker": "塔希尔",
                    "text": "而且我看这些做买卖的城里人啊，也不是很开心的样子。"
                },
                {
                    "id": "640480204",
                    "speaker": "塔希尔",
                    "text": "从交易所里出来的人，十有八九愁眉苦脸，最后一个哭天抢地。"
                },
                {
                    "id": "640480205",
                    "speaker": "塔希尔",
                    "text": "听说还有自以为学了点东西就能大赚一笔的学生来碰运气，结果把一学年的生活费都搭进去了。你可不要学他们啊。"
                }
            ]
        },
        {
            "talkId": "6404803",
            "initDialog": "640480301",
            "dialogues": [
                {
                    "id": "640480301",
                    "speaker": "Player",
                    "text": "不清楚。"
                },
                {
                    "id": "640480302",
                    "speaker": "塔希尔",
                    "text": "算了，我也没兴趣去理解他们。"
                }
            ]
        }
    ]
}