{
    "groupId": "6265",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "妮佩卡": 13
    },
    "talks": [
        {
            "talkId": "6626501",
            "initDialog": "662650101",
            "dialogues": [
                {
                    "id": "662650101",
                    "speaker": "妮佩卡",
                    "text": "唔…今天要上什么课来着？"
                }
            ]
        },
        {
            "talkId": "6626502",
            "initDialog": "662650201",
            "dialogues": [
                {
                    "id": "662650201",
                    "speaker": "Player",
                    "text": "最近过得怎么样？"
                },
                {
                    "id": "662650202",
                    "speaker": "妮佩卡",
                    "text": "我在这里过得可开心啦。每天都可以学到很多东西，也能吃到好吃的…"
                },
                {
                    "id": "662650203",
                    "speaker": "妮佩卡",
                    "text": "虽然在锻打东西的时候被火星溅到手很痛，但我不怕痛。"
                },
                {
                    "id": "662650204",
                    "speaker": "妮佩卡",
                    "text": "希诺宁姐姐说，她已经在帮我查身世了，虽然现在还没有消息…但我相信希诺宁姐姐！"
                },
                {
                    "id": "662650205",
                    "speaker": "妮佩卡",
                    "text": "我现在每天都会写日记，把经历过的有趣事情都记下来。"
                },
                {
                    "id": "662650206",
                    "speaker": "妮佩卡",
                    "text": "等到再梦见妮赫佳姐姐的时候，就把这些事情都告诉她，她一定会很高兴的。"
                },
                {
                    "id": "662650207",
                    "speaker": "妮佩卡",
                    "text": "我还要告诉妮赫佳姐姐，我现在很努力地在学习、吃饭和长大，她不用担心我。"
                },
                {
                    "id": "662650208",
                    "speaker": "妮佩卡",
                    "text": "唉，可是我一直都没有梦见妮赫佳姐姐，难道…她真的走了吗…"
                }
            ]
        },
        {
            "talkId": "6626503",
            "initDialog": "662650301",
            "dialogues": [
                {
                    "id": "662650301",
                    "speaker": "Player",
                    "text": "关于未来的事…"
                },
                {
                    "id": "662650302",
                    "speaker": "妮佩卡",
                    "text": "我…也想和希诺宁姐姐一样，做一名「铸名师」。"
                },
                {
                    "id": "662650303",
                    "speaker": "妮佩卡",
                    "text": "虽然我现在还看不懂那些书，也…也有点害怕炉子里的火…"
                },
                {
                    "id": "662650304",
                    "speaker": "妮佩卡",
                    "text": "我会努力的！等我长大了，一定要变得很厉害…"
                },
                {
                    "id": "662650305",
                    "speaker": "妮佩卡",
                    "text": "至少…不能让大家一直为我担心。"
                }
            ]
        },
        {
            "talkId": "6626504",
            "initDialog": "662650401",
            "dialogues": [
                {
                    "id": "662650401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "662650402",
                    "speaker": "妮佩卡",
                    "text": "再见！咦？我的课本在哪呢…"
                }
            ]
        }
    ]
}