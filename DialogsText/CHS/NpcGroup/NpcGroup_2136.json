{
    "groupId": "2136",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "罗小妹": 10
    },
    "talks": [
        {
            "talkId": "6213601",
            "initDialog": "621360101",
            "dialogues": [
                {
                    "id": "621360101",
                    "speaker": "罗小妹",
                    "text": "今天也想遇到仙人哥哥，可是仙人哥哥好像不喜欢我…"
                }
            ]
        },
        {
            "talkId": "6213602",
            "initDialog": "621360201",
            "dialogues": [
                {
                    "id": "621360201",
                    "speaker": "Player",
                    "text": "仙人哥哥？"
                },
                {
                    "id": "621360202",
                    "speaker": "罗小妹",
                    "text": "有一天我在林子里，遇上了一个帅气的仙人哥哥，长得和故事书里面一模一样！"
                },
                {
                    "id": "621360203",
                    "speaker": "罗小妹",
                    "text": "我对他笑，可是他却不对我笑…"
                },
                {
                    "id": "621360204",
                    "speaker": "罗小妹",
                    "text": "只是把我被丘丘人抢走的娃娃还给了我…你说他是不是不喜欢我？",
                    "choices": [
                        {
                            "id": "621360205",
                            "text": "或许吧…",
                            "response": [
                                {
                                    "id": "621360206",
                                    "speaker": "罗小妹",
                                    "text": "好伤心…"
                                },
                                {
                                    "id": "621360207",
                                    "speaker": "罗小妹",
                                    "text": "怎么才能让他喜欢我呢…以前从没遇上过这样的烦恼呀…"
                                }
                            ]
                        },
                        {
                            "id": "621360208",
                            "text": "其实他很喜欢你。",
                            "response": [
                                {
                                    "id": "621360209",
                                    "speaker": "罗小妹",
                                    "text": "真的吗？"
                                },
                                {
                                    "id": "621360210",
                                    "speaker": "罗小妹",
                                    "text": "…我也想过是不是那个哥哥只是不爱笑呀？"
                                },
                                {
                                    "id": "621360211",
                                    "speaker": "罗小妹",
                                    "text": "如果再见到他，我一定要想办法逗笑他，嘿嘿…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6213603",
            "initDialog": "621360301",
            "dialogues": [
                {
                    "id": "621360301",
                    "speaker": "Player",
                    "text": "注意安全。"
                },
                {
                    "id": "621360302",
                    "speaker": "罗小妹",
                    "text": "没事！如果有危险，仙人哥哥一定会来保护我的！"
                }
            ]
        }
    ]
}