{
    "groupId": "4498",
    "total_dialogue_lines": 46,
    "speaker_counts": {
        "Player": 9,
        "咚咚小圆帽": 6,
        "欢腾之火": 6,
        "派蒙": 25
    },
    "talks": [
        {
            "talkId": "6449801",
            "initDialog": "644980101",
            "dialogues": [
                {
                    "id": "644980101",
                    "speaker": "派蒙",
                    "text": "「咚咚小圆帽」、「欢腾之火」，我们来陪你们玩啦！以后可以经常这样轻轻松松待在一起！"
                },
                {
                    "id": "644980102",
                    "speaker": "派蒙",
                    "text": "#{NICKNAME}，我们陪蕈兽伙伴们做些什么好呢？"
                }
            ]
        },
        {
            "talkId": "6449802",
            "initDialog": "644980201",
            "dialogues": [
                {
                    "id": "644980201",
                    "speaker": "Player",
                    "text": "老规矩，投喂蕈兽伙伴？"
                },
                {
                    "id": "644980202",
                    "speaker": "派蒙",
                    "text": "好呀好呀，海妮耶和左右加好像根据自己的见闻，给「妙妙琼脂」新增了许多口味呢，可以试试看！"
                }
            ]
        },
        {
            "talkId": "6449803",
            "initDialog": "644980301",
            "dialogues": [
                {
                    "id": "644980301",
                    "speaker": "Player",
                    "text": "再来玩…向蕈兽伙伴比手势！"
                },
                {
                    "id": "644980302",
                    "speaker": "派蒙",
                    "text": "好呀，以我们现在和蕈兽伙伴的默契，应该能用更复杂的手势来沟通？"
                },
                {
                    "id": "644980303",
                    "speaker": "派蒙",
                    "text": "就算是带有一点点专业知识的信号，都可以试试看了！"
                }
            ]
        },
        {
            "talkId": "6449804",
            "initDialog": "644980401",
            "dialogues": [
                {
                    "id": "644980401",
                    "speaker": "Player",
                    "text": "待会儿再来和蕈兽伙伴们玩。"
                },
                {
                    "id": "644980402",
                    "speaker": "派蒙",
                    "text": "那就回头见哦，「咚咚小圆帽」和「欢腾之火」！以后我们一起玩的时间还很多！"
                }
            ]
        },
        {
            "talkId": "6449805",
            "initDialog": "644980501",
            "dialogues": [
                {
                    "id": "644980501",
                    "speaker": "Player",
                    "text": "投喂泡泡桔味的「妙妙琼脂」。"
                },
                {
                    "id": "644980502",
                    "speaker": "咚咚小圆帽",
                    "text": "♪♫~"
                },
                {
                    "id": "644980503",
                    "speaker": "欢腾之火",
                    "text": "！"
                },
                {
                    "id": "644980504",
                    "speaker": "派蒙",
                    "text": "嗯，两位伙伴都喜欢泡泡桔，不过反应出来的情绪好像有点不同！"
                },
                {
                    "id": "644980505",
                    "speaker": "派蒙",
                    "text": "「咚咚小圆帽」感到非常满足，像是吃饱甜食后，要慢慢飘到云朵里去了…"
                },
                {
                    "id": "644980506",
                    "speaker": "派蒙",
                    "text": "「欢腾之火」现在好像也能接受甜食了，而且更加振奋！作风一如既往帅气！"
                }
            ]
        },
        {
            "talkId": "6449806",
            "initDialog": "644980601",
            "dialogues": [
                {
                    "id": "644980601",
                    "speaker": "Player",
                    "text": "投喂白灵果味的「妙妙琼脂」。"
                },
                {
                    "id": "644980602",
                    "speaker": "咚咚小圆帽",
                    "text": "……"
                },
                {
                    "id": "644980603",
                    "speaker": "欢腾之火",
                    "text": "……"
                },
                {
                    "id": "644980604",
                    "speaker": "派蒙",
                    "text": "唔？好神奇…挪德卡莱进口水果风味的琼脂，让伙伴们都陷入了沉思？"
                },
                {
                    "id": "644980605",
                    "speaker": "派蒙",
                    "text": "可能是以前从没接触过这种味道，伙伴们开始想象那里的景象了？"
                },
                {
                    "id": "644980606",
                    "speaker": "派蒙",
                    "text": "如果能像去枫丹的那次，解决外来物种的问题…说不定可以带着蕈兽伙伴们去低调地游览一番？"
                }
            ]
        },
        {
            "talkId": "6449807",
            "initDialog": "644980701",
            "dialogues": [
                {
                    "id": "644980701",
                    "speaker": "Player",
                    "text": "投喂咖啡味的「妙妙琼脂」。"
                },
                {
                    "id": "644980702",
                    "speaker": "派蒙",
                    "text": "说起来，咖啡一般是工作的人加班提神用的吧？蕈兽伙伴们需要加班吗…"
                },
                {
                    "id": "644980703",
                    "speaker": "咚咚小圆帽",
                    "text": "♪~"
                },
                {
                    "id": "644980704",
                    "speaker": "欢腾之火",
                    "text": "♫~"
                },
                {
                    "id": "644980705",
                    "speaker": "派蒙",
                    "text": "咦？咖啡的味道好像让伙伴们更开心了？"
                },
                {
                    "id": "644980706",
                    "speaker": "派蒙",
                    "text": "嗯…还是不要把咖啡和上班关联起来比较好！"
                },
                {
                    "id": "644980707",
                    "speaker": "派蒙",
                    "text": "如果吃下了含有咖啡的东西，能让蕈兽伙伴们痛痛快快玩不累，就最好了！"
                },
                {
                    "id": "644980708",
                    "speaker": "派蒙",
                    "text": "当然，也要注意，不能让伙伴们玩得太过火，累到自己！"
                }
            ]
        },
        {
            "talkId": "6449808",
            "initDialog": "644980801",
            "dialogues": [
                {
                    "id": "644980801",
                    "speaker": "Player",
                    "text": "比个「留影机」拍摄的手势。"
                },
                {
                    "id": "644980802",
                    "speaker": "派蒙",
                    "text": "哦，这是注意留影时机的意思吗？现在的蕈兽伙伴肯定能理解了！"
                },
                {
                    "id": "644980803",
                    "speaker": "咚咚小圆帽",
                    "text": "♪！"
                },
                {
                    "id": "644980804",
                    "speaker": "欢腾之火",
                    "text": "♫！"
                },
                {
                    "id": "644980805",
                    "speaker": "派蒙",
                    "text": "果然，两位蕈兽伙伴的反应都很快，说不定以后都能成为留影专家！"
                }
            ]
        },
        {
            "talkId": "6449809",
            "initDialog": "644980901",
            "dialogues": [
                {
                    "id": "644980901",
                    "speaker": "Player",
                    "text": "手放在耳朵旁，倾听状。"
                },
                {
                    "id": "644980902",
                    "speaker": "派蒙",
                    "text": "是让蕈兽伙伴们注意聆听动静吗？嗯…在野外一起行动的时候，确实很关键！"
                },
                {
                    "id": "644980903",
                    "speaker": "咚咚小圆帽",
                    "text": "……"
                },
                {
                    "id": "644980904",
                    "speaker": "欢腾之火",
                    "text": "……"
                },
                {
                    "id": "644980905",
                    "speaker": "派蒙",
                    "text": "不愧是「咚咚小圆帽」和「欢腾之火」，马上就安静下来了，好像在用小脚感受地面的振动…"
                },
                {
                    "id": "644980906",
                    "speaker": "派蒙",
                    "text": "凭我们现在的合作，在野外，八成能立刻感知到附近的危险，早早做好准备了！"
                }
            ]
        },
        {
            "talkId": "6449810",
            "initDialog": "644981001",
            "dialogues": [
                {
                    "id": "644981001",
                    "speaker": "Player",
                    "text": "右手指向派蒙，左手摸头。"
                },
                {
                    "id": "644981002",
                    "speaker": "咚咚小圆帽",
                    "text": "♪~"
                },
                {
                    "id": "644981003",
                    "speaker": "派蒙",
                    "text": "嘿嘿，这个动作，我和「咚咚小圆帽」都还记得，「咚咚小圆帽」随时可以让我摸它的头！"
                },
                {
                    "id": "644981004",
                    "speaker": "派蒙",
                    "text": "这次「欢腾之火」的反应是…"
                },
                {
                    "id": "644981005",
                    "speaker": "欢腾之火",
                    "text": "♫~"
                },
                {
                    "id": "644981006",
                    "speaker": "派蒙",
                    "text": "嗯！现在「欢腾之火」也知道了，不能跳到我的脑袋上，「欢腾之火」也有进步！"
                }
            ]
        }
    ]
}