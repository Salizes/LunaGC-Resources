{
    "groupId": "10409",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Player": 7,
        "云叔": 25,
        "派蒙": 6
    },
    "talks": [
        {
            "talkId": "200005",
            "initDialog": "20000501",
            "dialogues": [
                {
                    "id": "20000501",
                    "speaker": "派蒙",
                    "text": "你好，请问你是来参加「南十字武斗会」的吗？"
                },
                {
                    "id": "20000502",
                    "speaker": "云叔",
                    "text": "对啊，你们已经报过名了吗？",
                    "choices": [
                        {
                            "id": "20000503",
                            "text": "还没有。",
                            "response": [
                                {
                                    "id": "20000505",
                                    "speaker": "云叔",
                                    "text": "那我觉得你们还是先去了解一下报名规则吧，因为「南十字武斗会」不是任何人都可以参加的。"
                                },
                                {
                                    "id": "20000506",
                                    "speaker": "云叔",
                                    "text": "武斗会需要比划拳脚，舞刀弄枪，要是报名的人没有本事只想凑热闹，那到最后肯定会受伤。"
                                },
                                {
                                    "id": "20000507",
                                    "speaker": "云叔",
                                    "text": "谁都不希望这种事出现，对吧？"
                                },
                                {
                                    "id": "20000508",
                                    "speaker": "派蒙",
                                    "text": "嗯嗯，这个规则之前就听说了。不过，我想知道你有什么响亮的名头呢？"
                                },
                                {
                                    "id": "20000509",
                                    "speaker": "云叔",
                                    "text": "哈哈哈，我嘛，是之前「吃虎岩自由搏击赛」的第二名。",
                                    "choices": [
                                        {
                                            "id": "20000510",
                                            "text": "吃虎岩…",
                                            "response": [
                                                {
                                                    "id": "20000512",
                                                    "speaker": "派蒙",
                                                    "text": "听起来好像不太正规的样子。"
                                                },
                                                {
                                                    "id": "20000513",
                                                    "speaker": "云叔",
                                                    "text": "怎么会！难道你们没听说过吗？这是经常会举办的比赛，我参加的那一次，有好几十个人参加呢！"
                                                },
                                                {
                                                    "id": "20000514",
                                                    "speaker": "云叔",
                                                    "text": "除了比赛的荣誉，我还帮千岩军抓过盗宝团，有两个逍遥法外的家伙，都是被我收拾的。"
                                                },
                                                {
                                                    "id": "20000515",
                                                    "speaker": "云叔",
                                                    "text": "哼，他们居然趁着夜深偷到我的头上来了，真是不知道厉害。"
                                                },
                                                {
                                                    "id": "20000516",
                                                    "speaker": "云叔",
                                                    "text": "那时候，我一个左勾拳就打在瘦子的脸上，他踉跄着退了两步，结果旁边那个胖子，居然直接掏出了刀！"
                                                },
                                                {
                                                    "id": "20000517",
                                                    "speaker": "云叔",
                                                    "text": "可我一点都没有退缩，反身一腿，那刀就朝上飞去，插进了房梁！",
                                                    "choices": [
                                                        {
                                                            "id": "20000518",
                                                            "text": "真、真是厉害…",
                                                            "response": [
                                                                {
                                                                    "id": "20000520",
                                                                    "speaker": "云叔",
                                                                    "text": "哈哈哈，对啊，就算是空手以一敌二，我也全然没落下风。"
                                                                },
                                                                {
                                                                    "id": "20000521",
                                                                    "speaker": "云叔",
                                                                    "text": "虽然最后受了不轻的伤，但还是把他们两个制服，扭送千岩军了，我也因此获了嘉奖！"
                                                                },
                                                                {
                                                                    "id": "20000522",
                                                                    "speaker": "派蒙",
                                                                    "text": "但对我们来说，同时应付四五个盗宝团，也是家常便饭了…"
                                                                },
                                                                {
                                                                    "id": "20000523",
                                                                    "speaker": "Player",
                                                                    "text": "谢谢你告诉我们这些。"
                                                                },
                                                                {
                                                                    "id": "20000524",
                                                                    "speaker": "派蒙",
                                                                    "text": "嗯嗯，我们再去其他地方转转。"
                                                                },
                                                                {
                                                                    "id": "20000525",
                                                                    "speaker": "云叔",
                                                                    "text": "我们赛场上再见吧，我是不会输给年轻人的！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "20000519",
                                                            "text": "真、真是危险…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "20000511",
                                            "text": "自由搏击…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "20000504",
                            "text": "想先在这附近看看。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "200023",
            "initDialog": "20002301",
            "dialogues": [
                {
                    "id": "20002301",
                    "speaker": "云叔",
                    "text": "#我们赛场上再见吧，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_GIRLE]}！"
                },
                {
                    "id": "20002302",
                    "speaker": "云叔",
                    "text": "有机会的话，我就给你展示一下我引以为傲的鞭腿！"
                }
            ]
        },
        {
            "talkId": "200107",
            "initDialog": "20010701",
            "dialogues": [
                {
                    "id": "20010701",
                    "speaker": "云叔",
                    "text": "是你啊，哈哈哈，我看到你的比赛了，打得非常精彩啊！"
                },
                {
                    "id": "20010702",
                    "speaker": "云叔",
                    "text": "我第三轮就被淘汰了，唉，可惜了，要是能再坚持一轮就好了…"
                },
                {
                    "id": "20010703",
                    "speaker": "派蒙",
                    "text": "你知道是谁最后进了决赛吗？"
                },
                {
                    "id": "20010704",
                    "speaker": "云叔",
                    "text": "就是当时淘汰我的那个人啊，他挺厉害的，身手敏捷，知道怎么抓人破绽。"
                },
                {
                    "id": "20010705",
                    "speaker": "云叔",
                    "text": "我只是失误了一下，就被放倒在地了。"
                },
                {
                    "id": "20010706",
                    "speaker": "云叔",
                    "text": "我这个体格，要和我拼力气我不会怕，但要比灵敏，我可就没什么办法了…"
                },
                {
                    "id": "20010707",
                    "speaker": "云叔",
                    "text": "但我觉得，他还是跟你差远了，哈哈哈！"
                }
            ]
        },
        {
            "talkId": "200120",
            "initDialog": "20012001",
            "dialogues": [
                {
                    "id": "20012001",
                    "speaker": "云叔",
                    "text": "不用太紧张了，无论是谁，也不是你的对手！"
                }
            ]
        },
        {
            "talkId": "200220",
            "initDialog": "20022001",
            "dialogues": [
                {
                    "id": "20022001",
                    "speaker": "云叔",
                    "text": "看了这么多场比赛，才知道山外有山，天外有天…"
                },
                {
                    "id": "20022002",
                    "speaker": "云叔",
                    "text": "总之，决赛加油啊，我会支持你的！"
                }
            ]
        },
        {
            "talkId": "200226",
            "initDialog": "20022601",
            "dialogues": [
                {
                    "id": "20022601",
                    "speaker": "云叔",
                    "text": "神之眼被偷了？光天化日之下，怎么可能？"
                }
            ]
        }
    ]
}