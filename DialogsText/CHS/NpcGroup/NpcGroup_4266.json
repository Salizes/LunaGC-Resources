    "talks": [
        {
            "talkId": "7323603",
            "initDialog": "732360301",
            "dialogues": [
                {
                    "id": "732360301",
                    "speaker": "「紧急通知」",
                    "text": "「病患阿巴斯，男，二十三岁。额头左侧有痣，惯用左手。在病症依然极其严重的情况下…」"
                },
                {
                    "id": "732360302",
                    "speaker": "「紧急通知」",
                    "text": "「…难以生存，在没有专业医师照顾的情况下，病人的生命安全…」"
                },
                {
                    "id": "732360303",
                    "speaker": "「紧急通知」",
                    "text": "「…一旦发现，请立刻通知…」"
                },
                {
                    "id": "732360304",
                    "speaker": "「紧急通知」",
                    "text": "「…不要自弃，保持乐观。须知众生皆在神明注视之下，万不可放弃。」"
                },
                {
                    "id": "732360305",
                    "speaker": "「紧急通知」",
                    "text": "（其余的文本已经因为年岁风化残缺，无法解读了。）"
                }
            ]
        }
    ]
}