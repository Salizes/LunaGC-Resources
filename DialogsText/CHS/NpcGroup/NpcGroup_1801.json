{
    "groupId": "1801",
    "total_dialogue_lines": 91,
    "speaker_counts": {
        "Player": 21,
        "乌苏拉": 1,
        "内田幸太郎": 10,
        "君特": 1,
        "汉娜洛蕾": 8,
        "洛恩": 49,
        "派蒙": 1
    },
    "talks": [
        {
            "talkId": "6180101",
            "initDialog": "618010101",
            "dialogues": [
                {
                    "id": "618010101",
                    "speaker": "汉娜洛蕾",
                    "text": "洛恩先生，我觉得有必要跟您谈谈告解的事…"
                },
                {
                    "id": "618010102",
                    "speaker": "洛恩",
                    "text": "嗯？我做了什么需要告解的事吗？我怎么不记得？"
                },
                {
                    "id": "618010103",
                    "speaker": "汉娜洛蕾",
                    "text": "您还记得史图维尔他们吗？"
                },
                {
                    "id": "618010104",
                    "speaker": "洛恩",
                    "text": "那三个吵吵嚷嚷的坏小子吧，记得。"
                },
                {
                    "id": "618010105",
                    "speaker": "汉娜洛蕾",
                    "text": "前些天他们突然哭着喊着要来告解，说是要承认自己的恶作剧。"
                },
                {
                    "id": "618010106",
                    "speaker": "洛恩",
                    "text": "哦？有点意思，他们干什么了？"
                },
                {
                    "id": "618010107",
                    "speaker": "汉娜洛蕾",
                    "text": "…溜进了玛莎婆婆的屋子，想把奶油涂到她脸上。"
                },
                {
                    "id": "618010108",
                    "speaker": "汉娜洛蕾",
                    "text": "但莫里兹提尔在望风的时候，头顶的铃铛突然被风吹响，吓得他立刻逃远了。"
                },
                {
                    "id": "618010109",
                    "speaker": "汉娜洛蕾",
                    "text": "麦克斯打算偷偷溜进里屋的时候，一阵风把脚边的蜂蜜罐吹倒了，直接惊醒了玛莎奶奶。"
                },
                {
                    "id": "618010110",
                    "speaker": "汉娜洛蕾",
                    "text": "最后史图维尔拼命往外逃的时候，背后又是一阵风，直到跑回了朋友身边才发现身上多了一张纸…"
                },
                {
                    "id": "618010111",
                    "speaker": "洛恩",
                    "text": "——是不是写着「风神一直在看着你」？"
                },
                {
                    "id": "618010112",
                    "speaker": "洛恩",
                    "text": "呵呵，这不是挺好的嘛？世上少了三个捣蛋鬼，多了三个虔诚的风神信徒…虽然顶多撑个两天吧。"
                },
                {
                    "id": "618010113",
                    "speaker": "汉娜洛蕾",
                    "text": "咳，洛恩先生，不管出于什么目的，吓唬小孩子都得适可而止…还有冒用风神大人的名字也是！"
                }
            ]
        },
        {
            "talkId": "6180102",
            "initDialog": "618010201",
            "dialogues": [
                {
                    "id": "618010201",
                    "speaker": "洛恩",
                    "text": "…下次要去突袭哪里的倒霉蛋呢？"
                },
                {
                    "id": "618010202",
                    "speaker": "Player",
                    "text": "你又在打什么主意？"
                },
                {
                    "id": "618010203",
                    "speaker": "洛恩",
                    "text": "啊，你来得正好，荣誉骑士，能不能帮我参谋参谋。"
                },
                {
                    "id": "618010204",
                    "speaker": "洛恩",
                    "text": "火烤雷史莱姆，跟冰封水史莱姆…你觉得哪边打起来更能放松心情？"
                },
                {
                    "id": "618010205",
                    "speaker": "洛恩",
                    "text": "雷史莱姆一下子被炸飞出去的声音确实不错，但往冰坨里一扎到底的手感也让人心动啊。",
                    "choices": [
                        {
                            "id": "618010206",
                            "text": "不如先把水史莱姆冻住…",
                            "response": [
                                {
                                    "id": "618010208",
                                    "speaker": "洛恩",
                                    "text": "哦？这想法不错嘛，改天要不要一起？"
                                }
                            ]
                        },
                        {
                            "id": "618010207",
                            "text": "再在边上火烤雷史莱姆。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6180103",
            "initDialog": "618010301",
            "dialogues": [
                {
                    "id": "618010301",
                    "speaker": "洛恩",
                    "text": "呵…这下就天衣无缝了…"
                },
                {
                    "id": "618010302",
                    "speaker": "Player",
                    "text": "洛恩你这是在…写报告？"
                },
                {
                    "id": "618010303",
                    "speaker": "派蒙",
                    "text": "真意外，我还以为你会比法尔伽更讨厌这些文书工作…"
                },
                {
                    "id": "618010304",
                    "speaker": "洛恩",
                    "text": "怎么会呢，这也是一队之长应尽的责任啊，虽然我还只是副队长。"
                },
                {
                    "id": "618010305",
                    "speaker": "洛恩",
                    "text": "这份报告关系到远征军回归后的人事安排，还需要远征时主管行政的西蒙枢机卿过目。"
                },
                {
                    "id": "618010306",
                    "speaker": "洛恩",
                    "text": "对了，你要是刚好有空回蒙德城一趟，干脆顺手帮我捎过去？",
                    "choices": [
                        {
                            "id": "618010307",
                            "text": "可以倒是可以…",
                            "response": [
                                {
                                    "id": "618010309",
                                    "speaker": "洛恩",
                                    "text": "哈哈，就是因为很重要，所以才想托付给你嘛，「荣誉骑士」。"
                                }
                            ]
                        },
                        {
                            "id": "618010308",
                            "text": "但这不是很重要的文件吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6180105",
            "initDialog": "618010501",
            "dialogues": [
                {
                    "id": "618010501",
                    "speaker": "洛恩",
                    "text": "哟，你好啊，荣誉骑士。"
                },
                {
                    "id": "618010502",
                    "speaker": "Player",
                    "text": "你这是在…"
                },
                {
                    "id": "618010503",
                    "speaker": "洛恩",
                    "text": "如你所见——射击训练。我好歹也是远程小队的副队长。"
                },
                {
                    "id": "618010504",
                    "speaker": "洛恩",
                    "text": "虽然我自己最喜欢的还是冲到敌人跟前去干一架…不过远程小队的看家本事还是不能落下。"
                },
                {
                    "id": "618010505",
                    "speaker": "Player",
                    "text": "那你举着个苹果是在…？"
                },
                {
                    "id": "618010506",
                    "speaker": "洛恩",
                    "text": "哦，要训练的不是我，是他俩——喂！还没瞄准好吗！"
                },
                {
                    "id": "618010507",
                    "speaker": "乌苏拉",
                    "text": "唔…手…手在发抖！"
                },
                {
                    "id": "618010508",
                    "speaker": "君特",
                    "text": "呃…眼…眼在打颤！",
                    "choices": [
                        {
                            "id": "618010509",
                            "text": "合着你是在当靶子啊！",
                            "response": [
                                {
                                    "id": "618010511",
                                    "speaker": "洛恩",
                                    "text": "哈，有压力才有动力嘛。再说，他们的弹药也伤不了我。"
                                },
                                {
                                    "id": "618010512",
                                    "speaker": "Player",
                                    "text": "那他们为什么这么害怕？"
                                },
                                {
                                    "id": "618010513",
                                    "speaker": "洛恩",
                                    "text": "因为要是真射偏了…后面就得接受我的「特别训练」了，呵呵。"
                                }
                            ]
                        },
                        {
                            "id": "618010510",
                            "text": "这要是射偏了怎么办！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6180106",
            "initDialog": "618010601",
            "dialogues": [
                {
                    "id": "618010601",
                    "speaker": "洛恩",
                    "text": "哟，你也来这儿吃饭啦？品味不错嘛，这儿的菜品在荆夫港也算小有名气了。"
                }
            ]
        },
        {
            "talkId": "6180107",
            "initDialog": "618010701",
            "dialogues": [
                {
                    "id": "618010701",
                    "speaker": "Player",
                    "text": "关于这里的菜品…"
                },
                {
                    "id": "618010702",
                    "speaker": "洛恩",
                    "text": "嗯…都是些蒙德常见的菜，不过我今天想换换口味。"
                },
                {
                    "id": "618010703",
                    "speaker": "洛恩",
                    "text": "从前在挪德卡莱尝到过一道「奶油鲑鱼汤」，不知道回了蒙德，还有没有这口福啊。"
                }
            ]
        },
        {
            "talkId": "6180108",
            "initDialog": "618010801",
            "dialogues": [
                {
                    "id": "618010801",
                    "speaker": "Player",
                    "text": "关于这里的菜品…"
                },
                {
                    "id": "618010802",
                    "speaker": "洛恩",
                    "text": "嗯…都是些蒙德常见的菜，不过今天我点了一道「奶油鲑鱼汤」。"
                },
                {
                    "id": "618010803",
                    "speaker": "洛恩",
                    "text": "真没想到，店家还真能端上连我都挑不出毛病的菜品…呵，会不会是换厨子了？"
                }
            ]
        },
        {
            "talkId": "6180109",
            "initDialog": "618010901",
            "dialogues": [
                {
                    "id": "618010901",
                    "speaker": "Player",
                    "text": "关于这里的菜品…"
                },
                {
                    "id": "618010902",
                    "speaker": "洛恩",
                    "text": "上次在这吃到了一道连我都挑不出毛病的「奶油鲑鱼汤」…之后我就经常来了。"
                },
                {
                    "id": "618010903",
                    "speaker": "洛恩",
                    "text": "不过不管来多少次，都没再尝到过那一次的味道…呵，估计是厨子又换了吧。"
                }
            ]
        },
        {
            "talkId": "6180110",
            "initDialog": "618011001",
            "dialogues": [
                {
                    "id": "618011001",
                    "speaker": "洛恩",
                    "text": "嗯…该从哪下手呢？"
                },
                {
                    "id": "618011002",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "618011003",
                    "speaker": "洛恩",
                    "text": "啊，骑士团最近接到消息，有个乔装打扮的小偷在集市上行窃，我是来捉他归案的。",
                    "choices": [
                        {
                            "id": "618011004",
                            "text": "你连这种小贼也会管？",
                            "response": [
                                {
                                    "id": "618011006",
                                    "speaker": "洛恩",
                                    "text": "哈哈，最近和平太久了嘛。也不知道为什么，自从我驻扎在荆夫港，附近的盗宝团都不愿意来了…"
                                },
                                {
                                    "id": "618011007",
                                    "speaker": "洛恩",
                                    "text": "好不容易有个不长眼…呵，有胆识的送上门，当然得好好「款待」他一下。"
                                },
                                {
                                    "id": "618011008",
                                    "speaker": "洛恩",
                                    "text": "那么，荣誉骑士，你最近有在这儿遇到过什么可疑的人吗？",
                                    "choices": [
                                        {
                                            "id": "618011009",
                                            "text": "遇是遇到过…",
                                            "response": [
                                                {
                                                    "id": "618011011",
                                                    "speaker": "洛恩",
                                                    "text": "哦，该不会是上哪躲起来了吧？有点意思。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "618011010",
                                            "text": "现在没影了。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "618011005",
                            "text": "你连这种小贼也不放过？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6180111",
            "initDialog": "618011101",
            "dialogues": [
                {
                    "id": "618011101",
                    "speaker": "洛恩",
                    "text": "集市出入口都有我们的人在看着，附近我也都盘查过了…那他会不会是躲到了什么平时看不见的地方？"
                }
            ]
        },
        {
            "talkId": "6180113",
            "initDialog": "618011301",
            "dialogues": [
                {
                    "id": "618011301",
                    "speaker": "洛恩",
                    "text": "嗨，荣誉骑士，是哪阵风把你吹来这儿的？"
                }
            ]
        },
        {
            "talkId": "6180114",
            "initDialog": "618011401",
            "dialogues": [
                {
                    "id": "618011401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "618011402",
                    "speaker": "洛恩",
                    "text": "不愧是你，还是那么忙碌。那就回头再见咯。"
                }
            ]
        },
        {
            "talkId": "6180115",
            "initDialog": "618011501",
            "dialogues": [
                {
                    "id": "618011501",
                    "speaker": "内田幸太郎",
                    "text": "…骑士先生！那真的就只是一个小说里的点子而已！不是什么「犯罪计划」。"
                },
                {
                    "id": "618011502",
                    "speaker": "洛恩",
                    "text": "嗯嗯我明白，不必那么激动，内田先生，先喝杯茶冷静一下吧。"
                },
                {
                    "id": "618011503",
                    "speaker": "洛恩",
                    "text": "根据重要线人提供的情报…你的手稿确实不像「犯罪计划」，毕竟那要实施起来可太不现实了。"
                },
                {
                    "id": "618011505",
                    "speaker": "内田幸太郎",
                    "text": "什么——哪…哪里不现实了！你倒是说说啊？"
                },
                {
                    "id": "618011506",
                    "speaker": "洛恩",
                    "text": "条件太多，环节太杂，既要有符合你需求的毒药，又得有符合你需求的建筑…"
                },
                {
                    "id": "618011507",
                    "speaker": "内田幸太郎",
                    "text": "呃…唔…"
                },
                {
                    "id": "618011508",
                    "speaker": "洛恩",
                    "text": "哪一步出了纰漏都会马上败露，不是么？更别说还掺了这么多设定，理解起来都困难。"
                },
                {
                    "id": "618011509",
                    "speaker": "内田幸太郎",
                    "text": "…你这么一说，还真有点道理？那该怎么完善这个手法呢？"
                },
                {
                    "id": "618011510",
                    "speaker": "洛恩",
                    "text": "嗯，我碰巧也对药物有点兴趣，不如就这样…再那样…"
                },
                {
                    "id": "618011511",
                    "speaker": "内田幸太郎",
                    "text": "…哦哦！您当骑士可真是屈才了！骑士先生！"
                }
            ]
        },
        {
            "talkId": "6180116",
            "initDialog": "618011602",
            "dialogues": [
                {
                    "id": "618011602",
                    "speaker": "内田幸太郎",
                    "text": "…骑士先生！那真的就只是一个小说里的点子而已！不是什么「犯罪计划」。"
                },
                {
