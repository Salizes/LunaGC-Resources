{
    "groupId": "5251",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "尼扎米": 13
    },
    "talks": [
        {
            "talkId": "6525101",
            "initDialog": "652510101",
            "dialogues": [
                {
                    "id": "652510101",
                    "speaker": "尼扎米",
                    "text": "有没有硬骨头的对手…"
                }
            ]
        },
        {
            "talkId": "6525102",
            "initDialog": "652510201",
            "dialogues": [
                {
                    "id": "652510201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "652510202",
                    "speaker": "尼扎米",
                    "text": "我是保镖。你见过我的雇主了吗？他很显眼，在这个没有多少绿色的地方。"
                },
                {
                    "id": "652510203",
                    "speaker": "尼扎米",
                    "text": "在这里有什么可担忧的呢？我现在无事可做，为了不让自己懈怠，有机会就参加「拳力斗技」。但是不够过瘾，真不够过瘾啊。"
                }
            ]
        },
        {
            "talkId": "6525103",
            "initDialog": "652510301",
            "dialogues": [
                {
                    "id": "652510301",
                    "speaker": "Player",
                    "text": "关于梅洛彼得堡…"
                },
                {
                    "id": "652510302",
                    "speaker": "尼扎米",
                    "text": "在赛场之外的地方禁止私斗真是件麻烦事。这里几乎也没有魔物…拳脚无处施展。"
                }
            ]
        },
        {
            "talkId": "6525104",
            "initDialog": "652510401",
            "dialogues": [
                {
                    "id": "652510401",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "652510402",
                    "speaker": "尼扎米",
                    "text": "再会。"
                }
            ]
        },
        {
            "talkId": "6525105",
            "initDialog": "652510501",
            "dialogues": [
                {
                    "id": "652510501",
                    "speaker": "尼扎米",
                    "text": "是你，好对手！"
                }
            ]
        },
        {
            "talkId": "6525106",
            "initDialog": "652510601",
            "dialogues": [
                {
                    "id": "652510601",
                    "speaker": "Player",
                    "text": "最近过得怎么样？"
                },
                {
                    "id": "652510602",
                    "speaker": "尼扎米",
                    "text": "挺不错的！除了我现在无事可做…为了不让自己懈怠，我偶尔会去和罗西莫夫过招，不过还是不够过瘾！"
                },
                {
                    "id": "652510603",
                    "speaker": "尼扎米",
                    "text": "和你对打很过瘾，尤其是打输的时候。"
                },
                {
                    "id": "652510604",
                    "speaker": "尼扎米",
                    "text": "打输才知道自己弱在哪里，知道自己的弱点才能继续变强，打输也是为了打赢，这道理没错吧？"
                }
            ]
        },
        {
            "talkId": "6525107",
            "initDialog": "652510701",
            "dialogues": [
                {
                    "id": "652510701",
                    "speaker": "Player",
                    "text": "关于梅洛彼得堡…"
                },
                {
                    "id": "652510702",
                    "speaker": "尼扎米",
                    "text": "在赛场之外的地方禁止私斗真是件麻烦事。这里几乎也没有魔物…拳脚无处施展。"
                },
                {
                    "id": "652510703",
                    "speaker": "尼扎米",
                    "text": "关于梅洛彼得堡最强，我的心中是有人选的，不过他看来忙得很，不常见他身影。"
                },
                {
                    "id": "652510704",
                    "speaker": "尼扎米",
                    "text": "而且要和他切磋，我还不够格。唔，在离开枫丹之前，会有机会吗？"
                }
            ]
        },
        {
            "talkId": "6525108",
            "initDialog": "652510801",
            "dialogues": [
                {
                    "id": "652510801",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "652510802",
                    "speaker": "尼扎米",
                    "text": "再会。我会继续变强，你也不要懈怠。"
                }
            ]
        }
    ]
}