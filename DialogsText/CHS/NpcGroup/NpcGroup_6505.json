    "talks": [
        {
            "talkId": "6650501",
            "initDialog": "665050101",
            "dialogues": [
                {
                    "id": "665050101",
                    "speaker": "奥胡帝亚",
                    "text": "悠悠纳塔，悠悠夏天！欢迎光临奥胡帝亚旅行社！快来看看我社最新推出的观景留影服务！"
                },
                {
                    "id": "665050102",
                    "speaker": "奥胡帝亚",
                    "text": "远眺彩彩崖，合影飘飘巡风阿夏，点亮心底的盛夏！"
                }
            ]
        },
        {
            "talkId": "6650502",
            "initDialog": "665050201",
            "dialogues": [
                {
                    "id": "665050201",
                    "speaker": "Player",
                    "text": "这次不会有奇怪的人了吧。"
                },
                {
                    "id": "665050202",
                    "speaker": "奥胡帝亚",
                    "text": "哎呀，瞧您说的，之前都是比赛需要，是误会啦。这次一定会让您感到宾至如归的，您放一百个心！"
                },
                {
                    "id": "665050203",
                    "speaker": "Player",
                    "text": "态度变化得好快…"
                },
                {
                    "id": "665050204",
                    "speaker": "奥胡帝亚",
                    "text": "嘿嘿，如此方才能被称为销售冠军嘛！"
                }
            ]
        },
        {
            "talkId": "6650503",
            "initDialog": "665050301",
            "dialogues": [
                {
                    "id": "665050301",
                    "speaker": "Player",
                    "text": "那我来试试。"
                },
                {
                    "id": "665050302",
                    "speaker": "奥胡帝亚",
                    "text": "好好好！请您站在这边，我们马上开始！"
                }
            ]
        },
        {
            "talkId": "6650504",
            "initDialog": "665050401",
            "dialogues": [
                {
                    "id": "665050401",
                    "speaker": "Player",
                    "text": "以后再说。"
                },
                {
                    "id": "665050402",
                    "speaker": "奥胡帝亚",
                    "text": "没问题没问题，期待您下次再来。"
                }
            ]
        }
    ]
}