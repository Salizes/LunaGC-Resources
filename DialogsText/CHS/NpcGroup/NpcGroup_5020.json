{
    "groupId": "5020",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "伊斯梅诺": 10
    },
    "talks": [
        {
            "talkId": "6502001",
            "initDialog": "650200101",
            "dialogues": [
                {
                    "id": "650200101",
                    "speaker": "伊斯梅诺",
                    "text": "晚上好，你也是出来散步的吗？"
                }
            ]
        },
        {
            "talkId": "6502002",
            "initDialog": "650200201",
            "dialogues": [
                {
                    "id": "650200201",
                    "speaker": "Player",
                    "text": "夜景不错。"
                },
                {
                    "id": "650200202",
                    "speaker": "伊斯梅诺",
                    "text": "哈哈，难得有年轻人跟我这个退了休的老家伙品味一致。"
                },
                {
                    "id": "650200203",
                    "speaker": "伊斯梅诺",
                    "text": "小伙子小姑娘们，一个一个都像广场中间这个停不下来的雕塑一样。"
                },
                {
                    "id": "650200204",
                    "speaker": "伊斯梅诺",
                    "text": "虽然精力充沛，但有时并不知道自己在为了什么运转呢。"
                },
                {
                    "id": "650200205",
                    "speaker": "伊斯梅诺",
                    "text": "抱歉啊，老家伙我说了些悲观的话呢。可能因为我以前是决斗代理人吧，请你见谅。"
                }
            ]
        },
        {
            "talkId": "6502003",
            "initDialog": "650200301",
            "dialogues": [
                {
                    "id": "650200301",
                    "speaker": "Player",
                    "text": "关于决斗代理人…"
                },
                {
                    "id": "650200302",
                    "speaker": "伊斯梅诺",
                    "text": "为了维护尊严而存在的职业，但总是伴随着争斗出现。"
                },
                {
                    "id": "650200303",
                    "speaker": "伊斯梅诺",
                    "text": "那些认为自己不该走上审判庭的嫌疑犯，会在庭审前发起「决斗」，以维护自己的「名誉」。"
                },
                {
                    "id": "650200304",
                    "speaker": "伊斯梅诺",
                    "text": "只有认输或死亡才能结束决斗，而能够胜过官方决斗代理人的少之又少。"
                },
                {
                    "id": "650200305",
                    "speaker": "伊斯梅诺",
                    "text": "所以你不难猜到，那些嫌疑犯最后迎来了怎样的结果。"
                }
            ]
        },
        {
            "talkId": "6502004",
            "initDialog": "650200401",
            "dialogues": [
                {
                    "id": "650200401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650200402",
                    "speaker": "伊斯梅诺",
                    "text": "再会。"
                }
            ]
        }
    ]
}