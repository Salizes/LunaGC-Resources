    "talks": [
        {
            "talkId": "6765901",
            "initDialog": "676590101",
            "dialogues": [
                {
                    "id": "676590101",
                    "speaker": "安莱夫",
                    "text": "不管发生什么，也要守好这座前哨！"
                }
            ]
        },
        {
            "talkId": "6765902",
            "initDialog": "676590201",
            "dialogues": [
                {
                    "id": "676590201",
                    "speaker": "Player",
                    "text": "辛苦了。"
                },
                {
                    "id": "676590202",
                    "speaker": "安莱夫",
                    "text": "哦，谢了！不过跟队长比起来，我这算什么辛苦。"
                },
                {
                    "id": "676590203",
                    "speaker": "安莱夫",
                    "text": "唔，这么说起来，他还是长身体的时候呢，下次晚饭得让他别光顾着张罗，自己要多吃点才是。"
                }
            ]
        },
        {
            "talkId": "6765903",
            "initDialog": "676590301",
            "dialogues": [
                {
                    "id": "676590301",
                    "speaker": "Player",
                    "text": "（<color=#FFCC33FF>叶洛亚</color>似乎有话要说…？）"
                },
                {
                    "id": "676590302",
                    "speaker": "叶洛亚",
                    "text": "辛苦了，有什么异常情况吗？"
                },
                {
                    "id": "676590303",
                    "speaker": "安莱夫",
                    "text": "队长，你来了啊。暂时没有未知的异常情况，我会提高警惕的，你放心好了。"
                },
                {
                    "id": "676590304",
                    "speaker": "叶洛亚",
                    "text": "嗯，有情况一定要及时汇报。"
                },
                {
                    "id": "676590305",
                    "speaker": "安莱夫",
                    "text": "明白，队长！"
                }
            ]
        },
        {
            "talkId": "6765904",
            "initDialog": "676590401",
            "dialogues": [
                {
                    "id": "676590401",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "676590402",
                    "speaker": "安莱夫",
                    "text": "没事，我就不送了。"
                }
            ]
        }
    ]
}