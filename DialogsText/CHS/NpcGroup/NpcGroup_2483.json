{
    "groupId": "2483",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "永赞": 12
    },
    "talks": [
        {
            "talkId": "6248301",
            "initDialog": "624830101",
            "dialogues": [
                {
                    "id": "624830101",
                    "speaker": "永赞",
                    "text": "别太卖力啦，歇一歇好不好？都这个点了，该饮茶啦~"
                }
            ]
        },
        {
            "talkId": "6248302",
            "initDialog": "624830201",
            "dialogues": [
                {
                    "id": "624830201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624830202",
                    "speaker": "永赞",
                    "text": "我？一个不足挂齿的小镖师罢了。"
                },
                {
                    "id": "624830203",
                    "speaker": "永赞",
                    "text": "要是想聊生意，可以去我们「剑匣镖局」找小韩。"
                },
                {
                    "id": "624830204",
                    "speaker": "永赞",
                    "text": "喝茶的时间快到了，吃什么比较好呢…"
                },
                {
                    "id": "624830205",
                    "speaker": "永赞",
                    "text": "你帮我想想？算了…你好像不是本地人。"
                }
            ]
        },
        {
            "talkId": "6248303",
            "initDialog": "624830301",
            "dialogues": [
                {
                    "id": "624830301",
                    "speaker": "Player",
                    "text": "你怎么这么悠哉？"
                },
                {
                    "id": "624830302",
                    "speaker": "永赞",
                    "text": "半年的镖跑完了，当然要悠哉点。"
                },
                {
                    "id": "624830303",
                    "speaker": "永赞",
                    "text": "现在跑镖和以前不一样啦，和记厅不想一家独大，要让每个镖局都有镖走。"
                },
                {
                    "id": "624830304",
                    "speaker": "永赞",
                    "text": "所以嘛，比如我以前半年能跑十单大的，现在就只能跑两单啦，余下八单都给了别家。"
                },
                {
                    "id": "624830305",
                    "speaker": "永赞",
                    "text": "不过也不打紧，我少赚八单还是能吃香喝辣，这八单不分出去，有的后生就吃不上饭了…"
                },
                {
                    "id": "624830306",
                    "speaker": "永赞",
                    "text": "我还是个庸才的时候，可没人这么照顾我，就当卖和记厅和后生们一个人情好了。"
                },
                {
                    "id": "624830307",
                    "speaker": "永赞",
                    "text": "总是抢人生意，得罪人多了，老来也会活得不舒坦嘛，哈哈！"
                }
            ]
        },
        {
            "talkId": "6248304",
            "initDialog": "624830401",
            "dialogues": [
                {
                    "id": "624830401",
                    "speaker": "Player",
                    "text": "那我也去饮茶了。"
                },
                {
                    "id": "624830402",
                    "speaker": "永赞",
                    "text": "这才对嘛，快去吧。"
                }
            ]
        }
    ]
}