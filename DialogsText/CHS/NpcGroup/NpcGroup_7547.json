{
    "groupId": "7547",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "阿尔秋姆": 13
    },
    "talks": [
        {
            "talkId": "6754701",
            "initDialog": "675470101",
            "dialogues": [
                {
                    "id": "675470101",
                    "speaker": "阿尔秋姆",
                    "text": "我要进行更多的训练…我还想拿更高的分数…"
                }
            ]
        },
        {
            "talkId": "6754702",
            "initDialog": "675470201",
            "dialogues": [
                {
                    "id": "675470201",
                    "speaker": "Player",
                    "text": "我想来试试…"
                },
                {
                    "id": "675470202",
                    "speaker": "阿尔秋姆",
                    "text": "啊？好！我等了半天，终于有人愿意来玩了…一项完美的竞技项目，值得所有人不断训练，来追求更高的目标。"
                },
                {
                    "id": "675470203",
                    "speaker": "阿尔秋姆",
                    "text": "来试试吧，万一，你能超过我的分数呢？"
                }
            ]
        },
        {
            "talkId": "6754703",
            "initDialog": "675470301",
            "dialogues": [
                {
                    "id": "675470301",
                    "speaker": "Player",
                    "text": "如此多标靶…"
                },
                {
                    "id": "675470302",
                    "speaker": "阿尔秋姆",
                    "text": "是啊，这些都是我特别定制的飞镖和标靶，漂亮吧？每一样都用了我从各地搜罗来的珍稀材料进行制作。"
                },
                {
                    "id": "675470303",
                    "speaker": "阿尔秋姆",
                    "text": "更为坚硬的镖尖、特别定制的镖身还有我亲手打造的标靶，每当我迭代装备时，都许愿能扔出更高的分数…"
                },
                {
                    "id": "675470304",
                    "speaker": "阿尔秋姆",
                    "text": "可惜，我的分数总是岿然不动…我只好想办法，再度迭代我的装备。"
                },
                {
                    "id": "675470305",
                    "speaker": "阿尔秋姆",
                    "text": "…令人生气的是，有些人居然能用地摊上随手买的入门级飞镖，随便一扔就是高分，我无法接受！"
                }
            ]
        },
        {
            "talkId": "6754704",
            "initDialog": "675470401",
            "dialogues": [
                {
                    "id": "675470401",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "675470402",
                    "speaker": "阿尔秋姆",
                    "text": "无妨，我要继续练习了。"
                }
            ]
        },
        {
            "talkId": "6754705",
            "initDialog": "675470501",
            "dialogues": [
                {
                    "id": "675470501",
                    "speaker": "Player",
                    "text": "关于分数…"
                },
                {
                    "id": "675470502",
                    "speaker": "阿尔秋姆",
                    "text": "竟然真的超过了我的分数…太强了，以后你就是我的偶像！不，我飞镖竞技道路上的方向标！"
                },
                {
                    "id": "675470503",
                    "speaker": "阿尔秋姆",
                    "text": "这些东西你收下吧，算是我对偶像献上的小小敬意。"
                }
            ]
        },
        {
            "talkId": "6754706",
            "initDialog": "675470601",
            "dialogues": [
                {
                    "id": "675470601",
                    "speaker": "Player",
                    "text": "关于分数…"
                },
                {
                    "id": "675470602",
                    "speaker": "阿尔秋姆",
                    "text": "好高的分数…我从来没有得过…"
                },
                {
                    "id": "675470603",
                    "speaker": "阿尔秋姆",
                    "text": "如果你有什么特殊技巧，请务必传授传授我啊！"
                }
            ]
        },
        {
            "talkId": "6754707",
            "initDialog": "675470701",
            "dialogues": [
                {
                    "id": "675470701",
                    "speaker": "Player",
                    "text": "关于分数…"
                },
                {
                    "id": "675470702",
                    "speaker": "阿尔秋姆",
                    "text": "不要气馁，哈哈，毕竟我也扔出过数不胜数的低分，才成为了飞镖竞技项目的职业玩家！"
                }
            ]
        }
    ]
}