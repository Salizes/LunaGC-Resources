{
    "groupId": "21854",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 4,
        "温迪": 4,
        "玛薇卡": 17
    },
    "talks": [
        {
            "talkId": "1504550",
            "initDialog": "150455001",
            "dialogues": [
                {
                    "id": "150455001",
                    "speaker": "玛薇卡",
                    "text": "#{NICKNAME}，来喝一杯吗？",
                    "choices": [
                        {
                            "id": "150455002",
                            "text": "没想到大家都来了…",
                            "response": [
                                {
                                    "id": "150455003",
                                    "speaker": "玛薇卡",
                                    "text": "哈哈，是不是声势太大？但事先告知你的话，就不能算作「惊喜」了。"
                                },
                                {
                                    "id": "150455004",
                                    "speaker": "玛薇卡",
                                    "text": "看拍照时的表情，大家都对度假时光充满了期待啊。"
                                }
                            ]
                        },
                        {
                            "id": "150455005",
                            "text": "接下去有什么打算？",
                            "response": [
                                {
                                    "id": "150455006",
                                    "speaker": "玛薇卡",
                                    "text": "尽管时间不会很长，但趁这个难得的机会，我也想放松一下。"
                                },
                                {
                                    "id": "150455007",
                                    "speaker": "玛薇卡",
                                    "text": "那么…度假村里难度最高的项目是什么？你有推荐吗？"
                                }
                            ]
                        },
                        {
                            "id": "150455008",
                            "text": "关于风…",
                            "response": [
                                {
                                    "id": "150455009",
                                    "speaker": "玛薇卡",
                                    "text": "噢，是天气的话题？"
                                },
                                {
                                    "id": "150455010",
                                    "speaker": "玛薇卡",
                                    "text": "度假村里最近吹着一阵既凉爽又舒适的风…很是难得。"
                                },
                                {
                                    "id": "150455011",
                                    "speaker": "玛薇卡",
                                    "text": "如果这阵风能够在纳塔多停留几日，就再好不过了。"
                                }
                            ]
                        },
                        {
                            "id": "150455012",
                            "text": "祝玛薇卡也享受假期。",
                            "response": [
                                {
                                    "id": "150455013",
                                    "speaker": "玛薇卡",
                                    "text": "谢谢你的祝福，也祝你和朋友们玩得畅怀。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "1504561",
            "initDialog": "150456101",
            "dialogues": [
                {
                    "id": "150456101",
                    "speaker": "玛薇卡",
                    "text": "如何？事情办完，这次能放开喝了吧？"
                },
                {
                    "id": "150456102",
                    "speaker": "温迪",
                    "text": "啊哈，可不是我有所保留。"
                },
                {
                    "id": "150456103",
                    "speaker": "温迪",
                    "text": "真要和你比赛喝酒的话，只怕度假村的蜜虫要忙到筋疲力尽，一个个都变成打瞌睡的懒虫咯。"
                },
                {
                    "id": "150456104",
                    "speaker": "玛薇卡",
                    "text": "不愧是吟游诗人，说出来的话总是那么有趣，噢，刚才那段即兴的祝酒词也是。"
                },
                {
                    "id": "150456105",
                    "speaker": "玛薇卡",
                    "text": "「为了自由而快乐的生活。」说得真好，正是大家现在需要的。"
                },
                {
                    "id": "150456106",
                    "speaker": "玛薇卡",
                    "text": "你在蒙德没少参与宴会吧？"
                },
                {
                    "id": "150456107",
                    "speaker": "温迪",
                    "text": "当然。毕竟是「诗与酒的城邦」，如果一位吟游诗人讲不好祝酒词，要怎么换到免费的蒲公英酒呢？"
                },
                {
                    "id": "150456108",
                    "speaker": "玛薇卡",
                    "text": "哈哈，等你有时间，欢迎你加入各部族的宴会，大家一定抢着请客。"
                },
                {
                    "id": "150456109",
                    "speaker": "玛薇卡",
                    "text": "不过，喝得高兴时，大家一般会拍着桌子，跺着脚，一起唱起也不知道是什么调子的歌…不会介意吧？"
                },
                {
                    "id": "150456110",
                    "speaker": "温迪",
                    "text": "怎么会呢，听起来很棒啊！哎呀…要是蒙德和纳塔能办一场联谊酒会就好了。"
                },
                {
                    "id": "150456111",
                    "speaker": "玛薇卡",
                    "text": "好啊，到时候我可要多带几桶蜜酿过去。"
                },
                {
                    "id": "150456112",
                    "speaker": "玛薇卡",
                    "text": "之前「沃陆之邦」还新推出了一款「火山青蜜莓暖饮」…也带给你和你的朋友们尝尝。"
                }
            ]
        }
    ]
}