{
    "groupId": "9068",
    "total_dialogue_lines": 65,
    "speaker_counts": {
        "Player": 14,
        "多莉": 51
    },
    "talks": [
        {
            "talkId": "6906801",
            "initDialog": "690680101",
            "dialogues": [
                {
                    "id": "690680101",
                    "speaker": "多莉",
                    "text": "#你好呀，{NICKNAME}，想和我说话，请先给摩拉喔。"
                },
                {
                    "id": "690680102",
                    "speaker": "多莉",
                    "text": "嘿嘿，开玩笑的啦。只是想试试看你的反应。"
                }
            ]
        },
        {
            "talkId": "6906802",
            "initDialog": "690680201",
            "dialogues": [
                {
                    "id": "690680201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690680202",
                    "speaker": "多莉",
                    "text": "咳咳，虽然比不过艾尔卡萨扎莱宫…"
                },
                {
                    "id": "690680203",
                    "speaker": "多莉",
                    "text": "但作为我的第二据点来说，合格了！",
                    "choices": [
                        {
                            "id": "690680204",
                            "text": "只是合格而已吗？",
                            "response": [
                                {
                                    "id": "690680205",
                                    "speaker": "多莉",
                                    "text": "拜托，能让见多识广的桑歌玛哈巴依老爷给出这样子的评价…"
                                },
                                {
                                    "id": "690680206",
                                    "speaker": "多莉",
                                    "text": "已经算是有两把刷子了！"
                                },
                                {
                                    "id": "690680207",
                                    "speaker": "多莉",
                                    "text": "你可是比那些没有艺术细胞的呆头菇高出一大截了呢！"
                                },
                                {
                                    "id": "690680212",
                                    "speaker": "多莉",
                                    "text": "只是呢，如果要请博闻强识的桑歌玛哈巴依老爷来当这里的改造顾问的话…"
                                },
                                {
                                    "id": "690680213",
                                    "speaker": "多莉",
                                    "text": "摩拉，也需要很多很多…"
                                },
                                {
                                    "id": "690680214",
                                    "speaker": "多莉",
                                    "text": "不用着急喔，多多攒起来吧。"
                                },
                                {
                                    "id": "690680215",
                                    "speaker": "多莉",
                                    "text": "既然有大生意，我也会一直留在这里的，嘿嘿。"
                                }
                            ]
                        },
                        {
                            "id": "690680208",
                            "text": "那怎样才能算「优秀」呢？",
                            "response": [
                                {
                                    "id": "690680209",
                                    "speaker": "多莉",
                                    "text": "喔？难道说难道说，你想让它打败艾尔卡萨扎莱宫，变成我的第一据点？"
                                },
                                {
                                    "id": "690680210",
                                    "speaker": "多莉",
                                    "text": "不错嘛，看来我的小跟班很有上进心。"
                                },
                                {
                                    "id": "690680211",
                                    "speaker": "多莉",
                                    "text": "我很欣赏喔！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906803",
            "initDialog": "690680301",
            "dialogues": [
                {
                    "id": "690680301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690680302",
                    "speaker": "多莉",
                    "text": "好呀好呀。"
                },
                {
                    "id": "690680303",
                    "speaker": "多莉",
                    "text": "那摩拉你准备好了吗？",
                    "choices": [
                        {
                            "id": "690680304",
                            "text": "为什么这么喜欢摩拉呢？",
                            "response": [
                                {
                                    "id": "690680305",
                                    "speaker": "多莉",
                                    "text": "第一，当然是因为我是商人。"
                                },
                                {
                                    "id": "690680306",
                                    "speaker": "多莉",
                                    "text": "第二，因为摩拉亮晶晶圆滚滚非常漂亮！"
                                },
                                {
                                    "id": "690680307",
                                    "speaker": "多莉",
                                    "text": "第三，只有真心喜欢摩拉，摩拉才会源源不断地跑向你身边。"
                                },
                                {
                                    "id": "690680313",
                                    "speaker": "多莉",
                                    "text": "所以你也要努力赚摩拉爱摩拉喔。"
                                },
                                {
                                    "id": "690680314",
                                    "speaker": "多莉",
                                    "text": "这样子我就可以一直待在你身边，从你手上赚摩拉了。"
                                },
                                {
                                    "id": "690680315",
                                    "speaker": "多莉",
                                    "text": "小跟班，加油加油喔！"
                                }
                            ]
                        },
                        {
                            "id": "690680308",
                            "text": "多莉为什么要赚那么多摩拉呢？",
                            "response": [
                                {
                                    "id": "690680309",
                                    "speaker": "多莉",
                                    "text": "因为摩拉是世界上最可爱的东西！"
                                },
                                {
                                    "id": "690680310",
                                    "speaker": "多莉",
                                    "text": "而且我再也不想因为摩拉不够，而失去些什么了…"
                                },
                                {
                                    "id": "690680311",
                                    "speaker": "多莉",
                                    "text": "咳咳，总之摩拉能解决世界上的大部分烦恼。"
                                },
                                {
                                    "id": "690680312",
                                    "speaker": "多莉",
                                    "text": "如果有什么是摩拉解决不了的，那么翻倍的摩拉一定就能解决了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906804",
            "initDialog": "690680401",
            "dialogues": [
                {
                    "id": "690680401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690680402",
                    "speaker": "多莉",
                    "text": "我们一起来做个金灿灿的雕塑吧！放在这里最显眼的地方！"
                },
                {
                    "id": "690680403",
                    "speaker": "Player",
                    "text": "这就是「改造顾问」的建议？"
                },
                {
                    "id": "690680404",
                    "speaker": "多莉",
                    "text": "没错，我想了很久这里缺什么…"
                },
                {
                    "id": "690680405",
                    "speaker": "多莉",
                    "text": "哼哼，原来是缺少了金灿灿的感觉！",
                    "choices": [
                        {
                            "id": "690680406",
                            "text": "那…金灿灿的多莉雕塑？",
                            "response": [
                                {
                                    "id": "690680407",
                                    "speaker": "多莉",
                                    "text": "如果你这么想要多莉雕塑的话，也不是不可以！"
                                },
                                {
                                    "id": "690680408",
                                    "speaker": "多莉",
                                    "text": "不过等你能给我一大——笔肖像权使用费之后再说吧。"
                                },
                                {
                                    "id": "690680409",
                                    "speaker": "多莉",
                                    "text": "现在，先来做个摩拉雕塑！"
                                },
                                {
                                    "id": "690680413",
                                    "speaker": "多莉",
                                    "text": "既然这里也是我的据点，那么自然是要符合我的品味！"
                                },
                                {
                                    "id": "690680414",
                                    "speaker": "多莉",
                                    "text": "#不过我先提醒你喔，这毕竟是名声赫赫的桑歌玛哈巴依老爷和{NICKNAME}的共同作品。"
                                },
                                {
                                    "id": "690680415",
                                    "speaker": "多莉",
                                    "text": "你得拿出足够的干劲才行。"
                                },
                                {
                                    "id": "690680416",
                                    "speaker": "多莉",
                                    "text": "制作工具和金灿灿的材料，我前几天已经都准备好了。总之这次我出钱，你出力！",
                                    "choices": [
                                        {
                                            "id": "690680417",
                                            "text": "多莉…出钱？",
                                            "response": [
                                                {
                                                    "id": "690680419",
                                                    "speaker": "多莉",
                                                    "text": "哼，少啰嗦少啰嗦。"
                                                },
                                                {
                                                    "id": "690680420",
                                                    "speaker": "多莉",
                                                    "text": "等你准备好了，就来和我说吧。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690680418",
                                            "text": "我没有听错吧？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690680410",
                            "text": "那…金灿灿的摩拉雕塑？",
                            "response": [
                                {
                                    "id": "690680411",
                                    "speaker": "多莉",
                                    "text": "哎呀哎呀，跟了我这么长时间，小跟班的品味也变好了不少嘛！"
                                },
                                {
                                    "id": "690680412",
                                    "speaker": "多莉",
                                    "text": "没错，就是摩拉雕塑！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906805",
            "initDialog": "690680501",
            "dialogues": [
                {
                    "id": "690680501",
                    "speaker": "Player",
                    "text": "早啊，多莉。"
                },
                {
                    "id": "690680502",
                    "speaker": "多莉",
                    "text": "早呀，小跟班。"
                },
                {
                    "id": "690680503",
                    "speaker": "多莉",
                    "text": "一日之计在于晨，前方摩拉不等人。"
                },
                {
                    "id": "690680504",
                    "speaker": "多莉",
                    "text": "我们快行动起来吧。"
                }
            ]
        },
        {
            "talkId": "6906806",
            "initDialog": "690680601",
            "dialogues": [
                {
                    "id": "690680601",
                    "speaker": "Player",
                    "text": "晚安，多莉。"
                },
                {
                    "id": "690680602",
                    "speaker": "多莉",
                    "text": "晚安，小跟班。"
                },
                {
                    "id": "690680603",
                    "speaker": "多莉",
                    "text": "祝你做个金灿灿的摩拉梦。"
                }
            ]
        },
        {
            "talkId": "6906810",
            "initDialog": "690681001",
            "dialogues": [
                {
                    "id": "690681001",
                    "speaker": "多莉",
                    "text": "嚯嚯，虽然比不过世界上最可爱的摩拉，但这里的珠宝也是亮晶晶的，很漂亮嘛。"
                },
                {
                    "id": "690681002",
                    "speaker": "多莉",
                    "text": "我的小跟班跟着我，品味也变得越来越好了嘛。我很欣慰很欣慰喔。"
                },
                {
                    "id": "690681003",
                    "speaker": "多莉",
                    "text": "乐善好施的桑歌玛哈巴依老爷决定在这里多待一会儿，你不用道谢，只需要感到荣幸就行。"
                }
            ]
        },
        {
            "talkId": "6906811",
            "initDialog": "690681101",
            "dialogues": [
                {
                    "id": "690681101",
                    "speaker": "多莉",
                    "text": "哎呀哎呀，这熟悉的氛围环境和巧妙的商铺布局。"
                },
                {
                    "id": "690681102",
                    "speaker": "多莉",
                    "text": "不错嘛，难道我的小跟班还是一个颇有天赋的商业奇才？"
                },
                {
                    "id": "690681103",
                    "speaker": "多莉",
                    "text": "下次闻名遐迩的桑歌玛哈巴依老爷出去谈大生意的时候，你记得要跟上来喔。"
                }
            ]
        }
    ]
}