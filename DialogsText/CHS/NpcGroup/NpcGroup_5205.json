            "dialogues": [
                {
                    "id": "652050101",
                    "speaker": "埃尔瓦德",
                    "text": "「破烂骨头商店」，各类货品，应有尽有！"
                }
            ]
        },
        {
            "talkId": "6520502",
            "initDialog": "652050201",
            "dialogues": [
                {
                    "id": "652050201",
                    "speaker": "Player",
                    "text": "我要购物。"
                },
                {
                    "id": "652050202",
                    "speaker": "埃尔瓦德",
                    "text": "你的特许券够用吗？"
                }
            ]
        },
        {
            "talkId": "6520503",
            "initDialog": "652050301",
            "dialogues": [
                {
                    "id": "652050301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "652050302",
                    "speaker": "埃尔瓦德",
                    "text": "走好。"
                }
            ]
        },
        {
            "talkId": "6520504",
            "initDialog": "652050401",
            "dialogues": [
                {
                    "id": "652050401",
                    "speaker": "Player",
                    "text": "我随便看看…"
                },
                {
                    "id": "652050402",
                    "speaker": "埃尔瓦德",
                    "text": "这间的东西都可以随便看。不过有些是别人预订的货品，可别碰坏了。"
                }
            ]
        },
        {
            "talkId": "6520505",
            "initDialog": "652050501",
            "dialogues": [
                {
                    "id": "652050501",
                    "speaker": "Player",
                    "text": "有免费的货品可以拿吗？"
                },
                {
                    "id": "652050502",
                    "speaker": "埃尔瓦德",
                    "text": "哈哈，你可真会说笑。"
                },
                {
                    "id": "652050503",
                    "speaker": "埃尔瓦德",
                    "text": "去找韦尔赛吧，如果你今天还没领过福利餐。在他那儿你能拿到免费的饭和免费的微笑，我这里嘛，免费的只有空气。"
                }
            ]
        },
        {
            "talkId": "6520506",
            "initDialog": "652050601",
            "dialogues": [
                {
                    "id": "652050601",
                    "speaker": "埃尔瓦德",
                    "text": "「破烂骨头商店」，各类货品，应有尽有！"
                }
            ]
        },
        {
            "talkId": "6520507",
            "initDialog": "652050701",
            "dialogues": [
                {
                    "id": "652050701",
                    "speaker": "Player",
                    "text": "我要购物。"
                },
                {
                    "id": "652050702",
                    "speaker": "埃尔瓦德",
                    "text": "随意挑选。"
                }
            ]
        },
        {
            "talkId": "6520508",
            "initDialog": "652050801",
            "dialogues": [
                {
                    "id": "652050801",
                    "speaker": "Player",
                    "text": "你的货是从哪儿来的？"
                },
                {
                    "id": "652050802",
                    "speaker": "埃尔瓦德",
                    "text": "无可奉告。"
                },
                {
                    "id": "652050803",
                    "speaker": "埃尔瓦德",
                    "text": "我只能说货品是安全的，途径是正规的，定价是合理的。至于其他的，我没什么可说的。"
                }
            ]
        },
        {
            "talkId": "6520509",
            "initDialog": "652050901",
            "dialogues": [
                {
                    "id": "652050901",
                    "speaker": "Player",
                    "text": "接受预订吗？"
                },
                {
                    "id": "652050902",
                    "speaker": "埃尔瓦德",
                    "text": "视买家和预订内容而定。有些话不方便明说，你应该理解吧。"
                }
            ]
        },
        {
            "talkId": "6520510",
            "initDialog": "652051001",
            "dialogues": [
                {
                    "id": "652051001",
                    "speaker": "埃尔瓦德",
                    "text": "「破烂骨头商店」，各类货品，应有尽有！"
                }
            ]
        },
        {
            "talkId": "6520511",
            "initDialog": "652051101",
            "dialogues": [
                {
                    "id": "652051101",
                    "speaker": "Player",
                    "text": "我要购物。"
                },
                {
                    "id": "652051102",
                    "speaker": "埃尔瓦德",
                    "text": "现在可没什么值得一看的稀罕玩意儿。"
                }
            ]
        },
        {
            "talkId": "6520512",
            "initDialog": "652051201",
            "dialogues": [
                {
                    "id": "652051201",
                    "speaker": "Player",
                    "text": "让我购物！"
                },
                {
                    "id": "652051202",
                    "speaker": "埃尔瓦德",
                    "text": "现在没什么值得一看的稀罕玩意儿！"
                },
                {
                    "id": "652051203",
                    "speaker": "埃尔瓦德",
                    "text": "上次小云雀和你们一起把东西全买完了，后续补货又出了些意外，好几个老主顾想来买瓶枫达我都拿不出来，本店的声誉啊…"
                },
                {
                    "id": "652051204",
                    "speaker": "埃尔瓦德",
                    "text": "总之我这儿现在没什么值得你出手的货品，不如去别处看看吧。"
                }
            ]
        },
        {
            "talkId": "6520513",
            "initDialog": "652051301",
            "dialogues": [
                {
                    "id": "652051301",
                    "speaker": "Player",
                    "text": "那好吧…"
                },
                {
                    "id": "652051302",
                    "speaker": "埃尔瓦德",
                    "text": "对不住了。走好。"
                }
            ]
        }
    ]
}