{
    "groupId": "1766",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "本瑟姆": 8
    },
    "talks": [
        {
            "talkId": "6176602",
            "initDialog": "617660201",
            "dialogues": [
                {
                    "id": "617660201",
                    "speaker": "Player",
                    "text": "关于墙上的涂鸦…"
                },
                {
                    "id": "617660204",
                    "speaker": "本瑟姆",
                    "text": "哦？你也注意到了附近的涂鸦吗？是前阵两个小孩玩「拆弹游戏」后留下的，是不是还挺可爱的？"
                },
                {
                    "id": "617660205",
                    "speaker": "Player",
                    "text": "只是涂鸦吗？没有炸弹吧？"
                },
                {
                    "id": "617660206",
                    "speaker": "本瑟姆",
                    "text": "哈哈，怎么可能。小孩子怎么会有炸弹这种东西啊。"
                },
                {
                    "id": "617660207",
                    "speaker": "本瑟姆",
                    "text": "那个穿着又紫又粉衣服的小孩，看着像姐姐吧，对穿着红色衣服的小孩说「只能用蜡笔哦」。"
                },
                {
                    "id": "617660208",
                    "speaker": "本瑟姆",
                    "text": "于是她们一个画炸弹，一个画箭头，就这么玩到了天黑。"
                },
                {
                    "id": "617660202",
                    "speaker": "本瑟姆",
                    "text": "说起来，小时候我也爱在家里的墙面上涂涂画画，果然游历过这么多地方后，最怀念的还是那段时光啊…"
                }
            ]
        },
        {
            "talkId": "6176603",
            "initDialog": "617660301",
            "dialogues": [
                {
                    "id": "617660301",
                    "speaker": "本瑟姆",
                    "text": "瞧一瞧，看一看！今天有新鲜的鹿肉！"
                }
            ]
        },
        {
            "talkId": "6176604",
            "initDialog": "617660401",
            "dialogues": [
                {
                    "id": "617660401",
                    "speaker": "Player",
                    "text": "让我看看菜单。"
                },
                {
                    "id": "617660402",
                    "speaker": "本瑟姆",
                    "text": "好嘞！您看看想吃什么！"
                }
            ]
        },
        {
            "talkId": "6176605",
            "initDialog": "617660501",
            "dialogues": [
                {
                    "id": "617660501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617660502",
                    "speaker": "本瑟姆",
                    "text": "哈哈，没事。有空再来！"
                }
            ]
        }
    ]
}