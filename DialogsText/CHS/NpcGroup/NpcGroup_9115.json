{
    "groupId": "9115",
    "total_dialogue_lines": 76,
    "speaker_counts": {
        "Player": 20,
        "塔利雅": 56
    },
    "talks": [
        {
            "talkId": "6911501",
            "initDialog": "691150101",
            "dialogues": [
                {
                    "id": "691150101",
                    "speaker": "塔利雅",
                    "text": "#你好啊，{NICKNAME}，这就是你平时的居所吗？"
                },
                {
                    "id": "691150102",
                    "speaker": "塔利雅",
                    "text": "地方很大，不如多喊一些人进来？太冷清了可不好。"
                }
            ]
        },
        {
            "talkId": "6911502",
            "initDialog": "691150201",
            "dialogues": [
                {
                    "id": "691150201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691150202",
                    "speaker": "塔利雅",
                    "text": "还不错，这里是个适合祷告的地方。"
                },
                {
                    "id": "691150203",
                    "speaker": "塔利雅",
                    "text": "不过，我一直没有找到适合喝酒的场所，要不要考虑建一个吧台？",
                    "choices": [
                        {
                            "id": "691150204",
                            "text": "教职人员这么喜欢喝酒合适吗？",
                            "response": [
                                {
                                    "id": "691150205",
                                    "speaker": "塔利雅",
                                    "text": "巴巴托斯的风带来了甘霖和种子，我们才得以酿制美酒。"
                                },
                                {
                                    "id": "691150206",
                                    "speaker": "塔利雅",
                                    "text": "美酒既是风神降下的诸多赐福，也是蒙德的标志之一。"
                                },
                                {
                                    "id": "691150207",
                                    "speaker": "塔利雅",
                                    "text": "作为西风教会成员，厌弃美酒才是对风神的亵渎。不是吗？"
                                }
                            ]
                        },
                        {
                            "id": "691150208",
                            "text": "好主意！",
                            "response": [
                                {
                                    "id": "691150209",
                                    "speaker": "塔利雅",
                                    "text": "太好了，我正好认识很多酒馆老板，采购酒水的事就交给我吧。"
                                },
                                {
                                    "id": "691150210",
                                    "speaker": "塔利雅",
                                    "text": "对了，再请一位驻唱吧？我有一位推荐的吟游诗人。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6911503",
            "initDialog": "691150301",
            "dialogues": [
                {
                    "id": "691150301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691150302",
                    "speaker": "塔利雅",
                    "text": "当然可以，我最近有个有趣的见闻，正好可以和你分享一下。"
                },
                {
                    "id": "691150303",
                    "speaker": "Player",
                    "text": "请讲。"
                },
                {
                    "id": "691150304",
                    "speaker": "塔利雅",
                    "text": "作为教会的助祭，我也承担了一部分为信众解忧的工作。不久前，一对夫妻曾先后找到我，向我寻求建议。"
                },
                {
                    "id": "691150305",
                    "speaker": "塔利雅",
                    "text": "丈夫是一名英俊的骑士，他剑术精湛，有一柄珍贵的家传宝剑。这柄剑锋利无比，他十分珍视。"
                },
                {
                    "id": "691150306",
                    "speaker": "塔利雅",
                    "text": "只可惜他没有适配的剑鞘，平时只能用麻布把剑刃包裹起来。"
                },
                {
                    "id": "691150307",
                    "speaker": "塔利雅",
                    "text": "妻子是一位美丽的园丁，她耕耘数年，终于培育出了一种珍稀而又美丽的花朵。"
                },
                {
                    "id": "691150308",
                    "speaker": "塔利雅",
                    "text": "只可惜她没有私人温室，平时只能将这株娇贵的花朵寄养在别处。"
                },
                {
                    "id": "691150309",
                    "speaker": "塔利雅",
                    "text": "而佳节将至，深爱彼此的夫妻两人都想向对方送出一份足够表达心意的礼物，作为节日的惊喜。"
                },
                {
                    "id": "691150310",
                    "speaker": "塔利雅",
                    "text": "正如你料想的那样，丈夫想要为妻子搭建一座私人温室，但苦于财力不足，唯一可行的方法就是把那柄家传宝剑卖掉…"
                },
                {
                    "id": "691150311",
                    "speaker": "塔利雅",
                    "text": "妻子想要委托铁匠为丈夫打造一副配得上那柄宝剑的剑鞘，但这同样是笔巨大的开销，只有卖掉那株珍贵的花朵才能实现…"
                },
                {
                    "id": "691150312",
                    "speaker": "塔利雅",
                    "text": "夫妻两人都向我询问是否应该坚持自己的想法，你觉得更应该让哪边放手去做呢？",
                    "choices": [
                        {
                            "id": "691150313",
                            "text": "丈夫？",
                            "response": [
                                {
                                    "id": "691150314",
                                    "speaker": "塔利雅",
                                    "text": "嗯，对于一名骑士来说，精湛的剑术确实比一柄宝剑更重要。那就丢掉这份缺憾，帮助爱人圆梦。"
                                },
                                {
                                    "id": "691150315",
                                    "speaker": "塔利雅",
                                    "text": "不过，如果妻子知道了丈夫的选择，她是否能心安理得地接受这份馈赠呢？"
                                },
                                {
                                    "id": "691150316",
                                    "speaker": "塔利雅",
                                    "text": "毕竟，她可以培育出更多的珍稀品种，但丈夫的这柄家传宝剑可是独此一份啊。"
                                },
                                {
                                    "id": "691150322",
                                    "speaker": "塔利雅",
                                    "text": "反之亦然，无论同意哪一边，对这份爱情都相当不负责啊。"
                                },
                                {
                                    "id": "691150323",
                                    "speaker": "Player",
                                    "text": "那就都不同意？"
                                },
                                {
                                    "id": "691150324",
                                    "speaker": "塔利雅",
                                    "text": "保留两人的缺憾，隐瞒彼此的心意，用一成不变的日常毁掉这对情侣的节日氛围？"
                                },
                                {
                                    "id": "691150325",
                                    "speaker": "Player",
                                    "text": "那你是怎么做的？"
                                },
                                {
                                    "id": "691150326",
                                    "speaker": "塔利雅",
                                    "text": "当然是两边都同意咯！",
                                    "choices": [
                                        {
                                            "id": "691150327",
                                            "text": "怎么能这样？",
                                            "response": [
                                                {
                                                    "id": "691150328",
                                                    "speaker": "塔利雅",
                                                    "text": "你是觉得我把两边的缺憾变成了更大的缺憾？"
                                                },
                                                {
                                                    "id": "691150329",
                                                    "speaker": "塔利雅",
                                                    "text": "不不，如果两边的初衷是表达彼此的心意，那么家传宝剑和珍稀苗株其实都不重要。"
                                                },
                                                {
                                                    "id": "691150332",
                                                    "speaker": "塔利雅",
                                                    "text": "想象一下他们交换礼物时的情景吧，这个节日对他们来说注定是一个值得铭记的日子。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691150330",
                                            "text": "真是个天才的办法！",
                                            "response": [
                                                {
                                                    "id": "691150331",
                                                    "speaker": "塔利雅",
                                                    "text": "你也懂的吧？明确彼此的心意，可比什么家传宝剑和珍稀苗株都更重要。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691150317",
                            "text": "妻子？",
                            "response": [
                                {
                                    "id": "691150318",
                                    "speaker": "塔利雅",
                                    "text": "哦，虽然转让了自己多年的心血，但只要买方也是行家，她心爱的花株仍旧可以茁壮成长。"
                                },
                                {
                                    "id": "691150319",
                                    "speaker": "塔利雅",
                                    "text": "不如就为它谋一个更好的去处，顺便帮爱人补全这多年的缺憾。"
                                },
                                {
                                    "id": "691150320",
                                    "speaker": "塔利雅",
                                    "text": "但是，如果丈夫知道了妻子的选择，他是否能心安理得地接受这份馈赠呢？"
                                },
                                {
                                    "id": "691150321",
                                    "speaker": "塔利雅",
                                    "text": "妻子放弃的可是实打实的心血结晶，而那柄剑是从父亲那里继承而来，他并没有为了得到它而付出过什么。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6911504",
            "initDialog": "691150401",
            "dialogues": [
                {
                    "id": "691150401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691150402",
                    "speaker": "塔利雅",
                    "text": "不如跟我一起练习合唱吧。",
                    "choices": [
                        {
                            "id": "691150403",
                            "text": "这个我有信心！",
                            "response": [
                                {
                                    "id": "691150404",
                                    "speaker": "塔利雅",
                                    "text": "合唱并不是为了展现个人的才华哦，唱诗班的大家都会尝试让自己融入和声，就像万物的声响都被融入风声那样。"
                                },
                                {
                                    "id": "691150405",
                                    "speaker": "塔利雅",
                                    "text": "不过，自信确实很重要，有不少新加入唱诗班的人因为害羞开不了口呢。"
                                },
                                {
                                    "id": "691150409",
                                    "speaker": "塔利雅",
                                    "text": "先来试试嗓音吧，啊…",
                                    "choices": [
                                        {
                                            "id": "691150410",
                                            "text": "真好听。",
                                            "response": [
                                                {
                                                    "id": "691150412",
                                                    "speaker": "塔利雅",
                                                    "text": "我确实认真地考虑过这种可能，但最终还是放弃了。"
                                                },
                                                {
                                                    "id": "691150413",
                                                    "speaker": "Player",
                                                    "text": "为什么？"
                                                },
                                                {
                                                    "id": "691150414",
                                                    "speaker": "塔利雅",
                                                    "text": "作为偶像，需要足够的热情去面对大量的粉丝，芭芭拉心地善良…"
                                                },
                                                {
                                                    "id": "691150415",
                                                    "speaker": "塔利雅",
                                                    "text": "但对我来说，有趣的灵魂寥寥无几，无趣的灵魂比比皆是。"
                                                },
                                                {
                                                    "id": "691150416",
                                                    "speaker": "塔利雅",
                                                    "text": "对于自己不感兴趣的人，我恐怕只有力气维持基本的礼节。"
                                                },
                                                {
                                                    "id": "691150417",
                                                    "speaker": "塔利雅",
                                                    "text": "所以我还是更想做一个旁观者，观察芭芭拉如何处理偶像身份带来的麻烦。"
                                                },
                                                {
                                                    "id": "691150418",
                                                    "speaker": "塔利雅",
                                                    "text": "不瞒你说，这样的体验比亲自当偶像有趣多了。"
                                                },
                                                {
                                                    "id": "691150419",
                                                    "speaker": "塔利雅",
                                                    "text": "对了，你想不想出道？骑士团还没出过偶像呢！荣誉骑士摇身一变，成为了骑士团的新锐偶像…这个设想很有意思！"
                                                },
                                                {
                                                    "id": "691150420",
                                                    "speaker": "塔利雅",
                                                    "text": "正好，跟我练习美声吧，我保证能帮你出道！"
                                                },
                                                {
                                                    "id": "691150421",
                                                    "speaker": "Player",
                                                    "text": "还是别了吧…"
                                                },
                                                {
                                                    "id": "691150422",
                                                    "speaker": "塔利雅",
                                                    "text": "先试一试总可以嘛，来，跟我学，啊…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691150411",
                                            "text": "考虑过像芭芭拉那样出道吗？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691150406",
                            "text": "五音不全怎么办？",
                            "response": [
                                {
                                    "id": "691150407",
                                    "speaker": "塔利雅",
                                    "text": "哈哈，无妨无妨。"
                                },
                                {
                                    "id": "691150408",
                                    "speaker": "塔利雅",
                                    "text": "唱诗班负责的颂歌当中并没有多少炫技的内容，只要感情足够真挚，绝大多数人都可以融入和声。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6911505",
            "initDialog": "691150501",
            "dialogues": [
                {
                    "id": "691150501",
                    "speaker": "Player",
                    "text": "早啊，塔利雅。"
                },
                {
                    "id": "691150502",
                    "speaker": "塔利雅",
                    "text": "#早啊，{NICKNAME}。我要准备去主持晨祷了，想不想旁观一下？今天我为巴巴托斯准备的问题可是相当有趣呢。"
                }
            ]
        },
        {
            "talkId": "6911506",
            "initDialog": "691150601",
            "dialogues": [
                {
                    "id": "691150601",
                    "speaker": "Player",
                    "text": "晚安，塔利雅。"
                },
                {
                    "id": "691150602",
                    "speaker": "塔利雅",
                    "text": "晚安，我刚刚结束祷告，愿你有个好梦。"
                }
            ]
        },
        {
            "talkId": "6911510",
            "initDialog": "691151001",
            "dialogues": [
                {
                    "id": "691151001",
                    "speaker": "塔利雅",
                    "text": "这处庭院的布景真的很不错，让我想起了在蒙德城寻找偶遇的时光。不过，总觉得还是缺了些什么…"
                },
                {
                    "id": "691151002",
                    "speaker": "塔利雅",
                    "text": "对了，一位在人群前弹唱的吟游诗人，一个偷偷向水池里扔炸弹的女孩儿，还有一名靠在长椅上偷懒的骑士。"
                },
                {
                    "id": "691151003",
                    "speaker": "塔利雅",
                    "text": "凑齐这些，气氛就对了。"
                }
            ]
        },
        {
            "talkId": "6911511",
            "initDialog": "691151101",
            "dialogues": [
                {
                    "id": "691151101",
                    "speaker": "塔利雅",
                    "text": "教会为我准备的房间里也有这样的一套家具，感觉就像回家了一样。"
                },
                {
                    "id": "691151102",
                    "speaker": "塔利雅",
                    "text": "#感谢伟大的{NICKNAME}为装点这方天地而付出的心血，我愿为您撰写一首颂歌，歌颂您！"
                },
                {
                    "id": "691151103",
                    "speaker": "塔利雅",
                    "text": "怎么了，太夸张了吗？"
                }
            ]
        }
    ]
}