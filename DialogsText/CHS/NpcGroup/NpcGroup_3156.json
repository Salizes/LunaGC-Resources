    "talks": [
        {
            "talkId": "6315601",
            "initDialog": "631560101",
            "dialogues": [
                {
                    "id": "631560101",
                    "speaker": "石川",
                    "text": "咦，你这样的旅者不该出现在这里，是迷路了吗？"
                }
            ]
        },
        {
            "talkId": "6315602",
            "initDialog": "631560201",
            "dialogues": [
                {
                    "id": "631560201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "631560202",
                    "speaker": "石川",
                    "text": "我啊，只是一个不起眼的新兵罢了。不想打仗，也不想当兵，但因为出身武士世家，出于家族荣誉不得不参军出征。"
                },
                {
                    "id": "631560203",
                    "speaker": "石川",
                    "text": "现在最烦心的就是这场持续了很久的战争一直没有结果…战场可不像平常的训练，是真刀真枪比拼的地方啊。"
                }
            ]
        },
        {
            "talkId": "6315603",
            "initDialog": "631560301",
            "dialogues": [
                {
                    "id": "631560301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631560302",
                    "speaker": "石川",
                    "text": "再见，希望这场战争早日结束啊…"
                }
            ]
        },
        {
            "talkId": "6315604",
            "initDialog": "631560401",
            "dialogues": [
                {
                    "id": "631560401",
                    "speaker": "石川",
                    "text": "咦，你这样的旅者不该出现在这里，是迷路了吗？"
                }
            ]
        },
        {
            "talkId": "6315605",
            "initDialog": "631560501",
            "dialogues": [
                {
                    "id": "631560501",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "631560502",
                    "speaker": "石川",
                    "text": "我啊，只是一个不起眼的新兵罢了。不想打仗，也不想当兵，但因为家族传承不得不参军出征。"
                },
                {
                    "id": "631560503",
                    "speaker": "石川",
                    "text": "现在最开心的就是听说幕府和珊瑚宫休战了，哈哈。"
                },
                {
                    "id": "631560504",
                    "speaker": "石川",
                    "text": "毕竟，战场可不像平常的训练，是真刀真枪比拼的地方啊。"
                },
                {
                    "id": "631560505",
                    "speaker": "石川",
                    "text": "说来可笑，我身为一个武士却有晕血的毛病，之前好几次差点走不出战场…"
                },
                {
                    "id": "631560506",
                    "speaker": "石川",
                    "text": "只希望雷神保佑，幕府与反抗军之间的休战协议能够长久地保持下去。"
                }
            ]
        },
        {
            "talkId": "6315606",
            "initDialog": "631560601",
            "dialogues": [
                {
                    "id": "631560601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631560602",
                    "speaker": "石川",
                    "text": "再见，希望休战的时间再长一点…"
                }
            ]
        }
    ]
