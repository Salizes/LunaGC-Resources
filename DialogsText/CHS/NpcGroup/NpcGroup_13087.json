{
    "groupId": "13087",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 3,
        "「怪力三十三」": 16,
        "派蒙": 6
    },
    "talks": [
        {
            "talkId": "7273001",
            "initDialog": "727300101",
            "dialogues": [
                {
                    "id": "727300101",
                    "speaker": "「怪力三十三」",
                    "text": "#不愧是举手投足间散发着无敌气势的{M#大哥哥}{F#大姐姐}！你真的好强！我斗得很过瘾！",
                    "choices": [
                        {
                            "id": "727300102",
                            "text": "还想再来一场吗？",
                            "response": [
                                {
                                    "id": "727300103",
                                    "speaker": "「怪力三十三」",
                                    "text": "咦？你居然不介意和同一个人反复切磋？真有耐心！"
                                },
                                {
                                    "id": "727300104",
                                    "speaker": "「怪力三十三」",
                                    "text": "那就请多指教了！"
                                }
                            ]
                        },
                        {
                            "id": "727300105",
                            "text": "关于「花角玉将」…",
                            "response": [
                                {
                                    "id": "727300106",
                                    "speaker": "「怪力三十三」",
                                    "text": "突然这么问，是想从我这里套出「花角玉将」的情报吗？"
                                },
                                {
                                    "id": "727300107",
                                    "speaker": "「怪力三十三」",
                                    "text": "那我就都告诉你好了，反正我和他也只是商业合作的关系，不算特别熟。"
                                },
                                {
                                    "id": "727300108",
                                    "speaker": "派蒙",
                                    "text": "商业合作？你们看起来都只是小孩而已嘛，这个说法好正式！"
                                },
                                {
                                    "id": "727300109",
                                    "speaker": "「怪力三十三」",
                                    "text": "话不能这么说，我给「九十九物」供过好几十次货。比如抓鬼兜虫的时候，顺手拔出来的小树和石头…"
                                },
                                {
                                    "id": "727300110",
                                    "speaker": "「怪力三十三」",
                                    "text": "这些东西做成盆栽和假山后，放在店里还挺有份量的！而且会不定期限量贩卖，加上葵姐姐的宣传后，听起来就很厉害！"
                                },
                                {
                                    "id": "727300111",
                                    "speaker": "「怪力三十三」",
                                    "text": "葵姐姐都夸过我，说我的货很神奇，有着许多珍宝三分之一的价值！"
                                },
                                {
                                    "id": "727300112",
                                    "speaker": "「怪力三十三」",
                                    "text": "「花角玉将」每次都出高价买下它们，说要把它们放置在斗虫的本阵，搭建庭院和假山，做鬼兜虫的大营。"
                                },
                                {
                                    "id": "727300113",
                                    "speaker": "「怪力三十三」",
                                    "text": "所以，我帮「花角玉将」和你们斗虫，也是照顾了葵姐姐和我自己的生意。"
                                },
                                {
                                    "id": "727300114",
                                    "speaker": "派蒙",
                                    "text": "好，好像明白你的名字是怎么来的了…"
                                },
                                {
                                    "id": "727300115",
                                    "speaker": "派蒙",
                                    "text": "话说回来，「花角玉将」原来是个很有钱的人吗？他的家人难道也是什么不知名的富豪？"
                                },
                                {
                                    "id": "727300116",
                                    "speaker": "「怪力三十三」",
                                    "text": "这我就不清楚了呢。我只听说，他每次买下我的假山，出的价钱都能买下好几份「绯樱虾仙贝」！"
                                },
                                {
                                    "id": "727300117",
                                    "speaker": "派蒙",
                                    "text": "原来只是几份「绯樱虾仙贝」？好像也不是很富有的样子…"
                                },
                                {
                                    "id": "727300118",
                                    "speaker": "「怪力三十三」",
                                    "text": "咦？难道这还不算富人吗…那你肯定很能挣钱吧！"
                                },
                                {
                                    "id": "727300119",
                                    "speaker": "「怪力三十三」",
                                    "text": "要不，以后我就跟着你混了，你出钱雇我当斗虫的干将吧！"
                                },
                                {
                                    "id": "727300120",
                                    "speaker": "「怪力三十三」",
                                    "text": "#这样我也能每天和{M#大哥哥}{F#大姐姐}斗虫了！"
                                },
                                {
                                    "id": "727300121",
                                    "speaker": "派蒙",
                                    "text": "钱钱钱钱钱…钱的事情不重要！你不要那么激动啦！"
                                },
                                {
                                    "id": "727300122",
                                    "speaker": "派蒙",
                                    "text": "#而且…{NICKNAME}也不是斗虫专业户，你跟着我们，不一定有那么多工作的机会哦！"
                                },
                                {
                                    "id": "727300123",
                                    "speaker": "「怪力三十三」",
                                    "text": "这样吗…那就算了！反正…以后我的盆栽和假山开卖了，你们要记得来买哦！"
                                }
                            ]
                        },
                        {
                            "id": "727300124",
                            "text": "后会有期！",
                            "response": [
                                {
                                    "id": "727300125",
                                    "speaker": "「怪力三十三」",
                                    "text": "#那就下次再见了，{M#大哥哥}{F#大姐姐}和「破空白铁小堇瓜」！如果不嫌弃的话，还要和我斗虫哦！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}