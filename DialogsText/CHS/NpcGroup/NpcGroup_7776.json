{
    "groupId": "7776",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "涅日达诺夫": 9
    },
    "talks": [
        {
            "talkId": "6777601",
            "initDialog": "677760101",
            "dialogues": [
                {
                    "id": "677760101",
                    "speaker": "涅日达诺夫",
                    "text": "吃这些好像没用啊，但其他的又不太健康…"
                }
            ]
        },
        {
            "talkId": "6777602",
            "initDialog": "677760201",
            "dialogues": [
                {
                    "id": "677760201",
                    "speaker": "Player",
                    "text": "你打算吃什么？"
                },
                {
                    "id": "677760202",
                    "speaker": "涅日达诺夫",
                    "text": "呃，喝点牛奶，吃点水果什么的，或许再来点薯条…要是能来点枫达就更好了。"
                },
                {
                    "id": "677760203",
                    "speaker": "涅日达诺夫",
                    "text": "…好吧，这些东西听起来就不太能疏解坏心情啊，谁会用牛奶和水果疏解坏心情呢，听着也太健康了…"
                }
            ]
        },
        {
            "talkId": "6777603",
            "initDialog": "677760301",
            "dialogues": [
                {
                    "id": "677760301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "677760302",
                    "speaker": "涅日达诺夫",
                    "text": "再见。祝你健康，呃，心情也健康。"
                }
            ]
        },
        {
            "talkId": "6777604",
            "initDialog": "677760401",
            "dialogues": [
                {
                    "id": "677760401",
                    "speaker": "Player",
                    "text": "一般都是…借酒浇愁？"
                },
                {
                    "id": "677760402",
                    "speaker": "涅日达诺夫",
                    "text": "我知道。但…你也知道，喝太多酒了容易误事，对身体也不太好。"
                },
                {
                    "id": "677760403",
                    "speaker": "涅日达诺夫",
                    "text": "为了解决一时的坏心情，反而让身体长期处于不良状态，实在不是一个明智的选择。"
                },
                {
                    "id": "677760404",
                    "speaker": "涅日达诺夫",
                    "text": "否则的话，即使我现在没了坏心情，将来反而会有一具坏身体，这有点得不偿失，对不对？"
                },
                {
                    "id": "677760405",
                    "speaker": "涅日达诺夫",
                    "text": "不过，这些东西真的越吃越清醒啊…这样真的有助于疏解坏心情吗？不能吧…"
                },
                {
                    "id": "677760406",
                    "speaker": "涅日达诺夫",
                    "text": "但为了身体健康，我还是别喝酒了，就吃这些吧…"
                }
            ]
        }
    ]
}