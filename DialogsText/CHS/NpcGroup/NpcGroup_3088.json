{
    "groupId": "3088",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 9,
        "广海": 18
    },
    "talks": [
        {
            "talkId": "6308801",
            "initDialog": "630880101",
            "dialogues": [
                {
                    "id": "630880101",
                    "speaker": "广海",
                    "text": "你好，外国人。请不要在街上停留太久。"
                }
            ]
        },
        {
            "talkId": "6308802",
            "initDialog": "630880201",
            "dialogues": [
                {
                    "id": "630880201",
                    "speaker": "Player",
                    "text": "为什么？"
                },
                {
                    "id": "630880202",
                    "speaker": "广海",
                    "text": "因为「锁国令」的缘故，最近离岛不太景气…小偷小摸的案件也多起来了。"
                },
                {
                    "id": "630880203",
                    "speaker": "广海",
                    "text": "假如在街上停留太久的话，很容易被人找麻烦的。"
                }
            ]
        },
        {
            "talkId": "6308803",
            "initDialog": "630880301",
            "dialogues": [
                {
                    "id": "630880301",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "630880302",
                    "speaker": "广海",
                    "text": "我叫广海，如你所见，是奉行府的役职。"
                },
                {
                    "id": "630880303",
                    "speaker": "广海",
                    "text": "在离岛请遵纪守法，否则会让我很难办的。"
                }
            ]
        },
        {
            "talkId": "6308804",
            "initDialog": "630880401",
            "dialogues": [
                {
                    "id": "630880401",
                    "speaker": "Player",
                    "text": "谢谢提醒。"
                },
                {
                    "id": "630880402",
                    "speaker": "广海",
                    "text": "不必客气，外国人。"
                }
            ]
        },
        {
            "talkId": "6308805",
            "initDialog": "630880501",
            "dialogues": [
                {
                    "id": "630880501",
                    "speaker": "广海",
                    "text": "你好，旅行者。有什么需要帮忙的吗？"
                }
            ]
        },
        {
            "talkId": "6308806",
            "initDialog": "630880601",
            "dialogues": [
                {
                    "id": "630880601",
                    "speaker": "Player",
                    "text": "你好！"
                },
                {
                    "id": "630880602",
                    "speaker": "广海",
                    "text": "之前的事情，实在是太感谢你了。"
                },
                {
                    "id": "630880603",
                    "speaker": "广海",
                    "text": "在离岛遇到什么问题的话请尽管找我，我一定会尽力帮忙的！"
                }
            ]
        },
        {
            "talkId": "6308807",
            "initDialog": "630880701",
            "dialogues": [
                {
                    "id": "630880701",
                    "speaker": "Player",
                    "text": "关于「大姐」…"
                },
                {
                    "id": "630880702",
                    "speaker": "广海",
                    "text": "她吗…还没有来。不过既然她和我约好了要在乌有亭见面，我相信她一定会来的。"
                },
                {
                    "id": "630880703",
                    "speaker": "广海",
                    "text": "无论如何，再次感谢你的帮忙，这次我会好好把握机会的。"
                }
            ]
        },
        {
            "talkId": "6308808",
            "initDialog": "630880801",
            "dialogues": [
                {
                    "id": "630880801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630880802",
                    "speaker": "广海",
                    "text": "再见，祝你好运！"
                }
            ]
        },
        {
            "talkId": "6308809",
            "initDialog": "630880901",
            "dialogues": [
                {
                    "id": "630880901",
                    "speaker": "广海",
                    "text": "你好。在离岛闲逛时请务必注意随身物品的安全。"
                }
            ]
        },
        {
            "talkId": "6308810",
            "initDialog": "630881001",
            "dialogues": [
                {
                    "id": "630881001",
                    "speaker": "Player",
                    "text": "为什么？"
                },
                {
                    "id": "630881002",
                    "speaker": "广海",
                    "text": "因为锁国令解除的缘故，最近离岛的人流量大大增加…小偷小摸的案件也多起来了。"
                },
                {
                    "id": "630881003",
                    "speaker": "广海",
                    "text": "所以我一遇到闲逛的人，就会叮嘱他们看好随身物品。"
                }
            ]
        },
        {
            "talkId": "6308811",
            "initDialog": "630881101",
            "dialogues": [
                {
                    "id": "630881101",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "630881102",
                    "speaker": "广海",
                    "text": "我叫广海，如你所见，是奉行府的役职。"
                },
                {
                    "id": "630881103",
                    "speaker": "广海",
                    "text": "在离岛请遵纪守法，否则会让我很难办的。"
                }
            ]
        },
        {
            "talkId": "6308812",
            "initDialog": "630881201",
            "dialogues": [
                {
                    "id": "630881201",
                    "speaker": "Player",
                    "text": "谢谢提醒。"
                },
                {
                    "id": "630881202",
                    "speaker": "广海",
                    "text": "不必客气。"
                }
            ]
        }
    ]
}