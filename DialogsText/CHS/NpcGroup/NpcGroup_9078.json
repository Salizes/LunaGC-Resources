{
    "groupId": "9078",
    "total_dialogue_lines": 55,
    "speaker_counts": {
        "Player": 13,
        "艾尔海森": 42
    },
    "talks": [
        {
            "talkId": "6907801",
            "initDialog": "690780101",
            "dialogues": [
                {
                    "id": "690780101",
                    "speaker": "艾尔海森",
                    "text": "你好。"
                },
                {
                    "id": "690780102",
                    "speaker": "艾尔海森",
                    "text": "这里很清净，谢谢你的邀请。"
                }
            ]
        },
        {
            "talkId": "6907802",
            "initDialog": "690780201",
            "dialogues": [
                {
                    "id": "690780201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690780202",
                    "speaker": "艾尔海森",
                    "text": "还可以。"
                },
                {
                    "id": "690780203",
                    "speaker": "艾尔海森",
                    "text": "能看出装饰风格很多样。"
                },
                {
                    "id": "690780204",
                    "speaker": "艾尔海森",
                    "text": "不完全符合我的使用习惯，不过也无所谓。"
                },
                {
                    "id": "690780205",
                    "speaker": "Player",
                    "text": "有什么建议吗？"
                },
                {
                    "id": "690780206",
                    "speaker": "艾尔海森",
                    "text": "很难归纳。"
                },
                {
                    "id": "690780207",
                    "speaker": "艾尔海森",
                    "text": "我比较看重实用性，美学要素不是我必须考虑的事。"
                },
                {
                    "id": "690780208",
                    "speaker": "艾尔海森",
                    "text": "所以我的方案只适合我，对你不一定有用。"
                },
                {
                    "id": "690780209",
                    "speaker": "艾尔海森",
                    "text": "毕竟，我也不了解你的生活细节。"
                },
                {
                    "id": "690780210",
                    "speaker": "Player",
                    "text": "确实。"
                },
                {
                    "id": "690780211",
                    "speaker": "艾尔海森",
                    "text": "布置家装，最重要的是让家的主人觉得舒适。"
                },
                {
                    "id": "690780212",
                    "speaker": "艾尔海森",
                    "text": "其他都是次要的。"
                }
            ]
        },
        {
            "talkId": "6907803",
            "initDialog": "690780301",
            "dialogues": [
                {
                    "id": "690780301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690780302",
                    "speaker": "艾尔海森",
                    "text": "可以啊，如果你做好心理准备的话。"
                },
                {
                    "id": "690780303",
                    "speaker": "艾尔海森",
                    "text": "话说在前面，我对娱乐性话题兴趣不大。如果你需要帮助可以直说。"
                },
                {
                    "id": "690780304",
                    "speaker": "艾尔海森",
                    "text": "我会视情况判断是否帮你这个忙。",
                    "choices": [
                        {
                            "id": "690780305",
                            "text": "这是工作中得出的经验吗？",
                            "response": [
                                {
                                    "id": "690780306",
                                    "speaker": "艾尔海森",
                                    "text": "也可以当做是我的生活经验。"
                                },
                                {
                                    "id": "690780307",
                                    "speaker": "艾尔海森",
                                    "text": "假如你想悠闲度日，可以学学我这种方式。"
                                }
                            ]
                        },
                        {
                            "id": "690780308",
                            "text": "这是人际交往中得出的经验吗？",
                            "response": [
                                {
                                    "id": "690780309",
                                    "speaker": "艾尔海森",
                                    "text": "是吗？我不觉得一般的人际交往能带来这么有价值的经验。"
                                },
                                {
                                    "id": "690780310",
                                    "speaker": "艾尔海森",
                                    "text": "现在你也收获了价值，恭喜。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6907804",
            "initDialog": "690780401",
            "dialogues": [
                {
                    "id": "690780401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690780402",
                    "speaker": "艾尔海森",
                    "text": "我每天都在做想做的事，突然被这么问到，好像没什么值得一说的。"
                },
                {
                    "id": "690780403",
                    "speaker": "艾尔海森",
                    "text": "保持这个状态就可以了。"
                },
                {
                    "id": "690780404",
                    "speaker": "Player",
                    "text": "似乎很少见你匆忙的样子。"
                },
                {
                    "id": "690780405",
                    "speaker": "艾尔海森",
                    "text": "哦？给你这种印象吗？"
                },
                {
                    "id": "690780406",
                    "speaker": "艾尔海森",
                    "text": "那很好，我不喜欢匆忙的感觉。会打扰我思考问题。"
                },
                {
                    "id": "690780407",
                    "speaker": "艾尔海森",
                    "text": "不过你提醒我了，我要经常假装忙碌，这样就能避开不想做的事和不想接触的人。"
                },
                {
                    "id": "690780408",
                    "speaker": "艾尔海森",
                    "text": "你的交际圈很广，很容易遇到死缠烂打的对手吧。"
                },
                {
                    "id": "690780409",
                    "speaker": "Player",
                    "text": "有什么解决办法吗？"
                },
                {
                    "id": "690780410",
                    "speaker": "艾尔海森",
                    "text": "建议你多向对方提一些永远找不出准确答案的问题。"
                },
                {
                    "id": "690780411",
                    "speaker": "艾尔海森",
                    "text": "转移他的注意，占用他的精力，让他无计可施。"
                },
                {
                    "id": "690780412",
                    "speaker": "Player",
                    "text": "谢谢，学到许多。"
                },
                {
                    "id": "690780413",
                    "speaker": "艾尔海森",
                    "text": "不用谢。"
                },
                {
                    "id": "690780414",
                    "speaker": "艾尔海森",
                    "text": "某种意义上来说，我希望每个人都能过上自己想要的生活。"
                },
                {
                    "id": "690780415",
                    "speaker": "艾尔海森",
                    "text": "这样，就不会互相增加烦恼了。"
                },
                {
                    "id": "690780416",
                    "speaker": "Player",
                    "text": "你的想法有些特别。"
                },
                {
                    "id": "690780417",
                    "speaker": "艾尔海森",
                    "text": "还以为大家都会这么想呢。"
                },
                {
                    "id": "690780418",
                    "speaker": "艾尔海森",
                    "text": "一个没有麻烦事的世界，不是很好吗？"
                }
            ]
        },
        {
            "talkId": "6907805",
            "initDialog": "690780501",
            "dialogues": [
                {
                    "id": "690780501",
                    "speaker": "Player",
                    "text": "早啊，艾尔海森。"
                },
                {
                    "id": "690780502",
                    "speaker": "艾尔海森",
                    "text": "早上好。看来你已经想好今天要做什么了。"
                },
                {
                    "id": "690780503",
                    "speaker": "艾尔海森",
                    "text": "有事做说明生活充实，没事做说明生活清闲。"
                },
                {
                    "id": "690780504",
                    "speaker": "艾尔海森",
                    "text": "都不错，祝你顺利。"
                }
            ]
        },
        {
            "talkId": "6907806",
            "initDialog": "690780601",
            "dialogues": [
                {
                    "id": "690780601",
                    "speaker": "Player",
                    "text": "晚安，艾尔海森。"
                },
                {
                    "id": "690780602",
                    "speaker": "艾尔海森",
                    "text": "晚安。"
                },
                {
                    "id": "690780603",
                    "speaker": "艾尔海森",
                    "text": "就算睡不着也没关系，明天总会到来的。"
                }
            ]
        },
        {
            "talkId": "6907807",
            "initDialog": "690780701",
            "dialogues": [
                {
                    "id": "690780701",
                    "speaker": "艾尔海森",
                    "text": "烤肉看起来简单，却不容易做得出彩。"
                },
                {
                    "id": "690780702",
                    "speaker": "艾尔海森",
                    "text": "这里设备很齐全了，你可以自己试试。"
                },
                {
                    "id": "690780703",
                    "speaker": "艾尔海森",
                    "text": "说不定就能成为烤肉大师了。"
                }
            ]
        },
        {
            "talkId": "6907808",
            "initDialog": "690780801",
            "dialogues": [
                {
                    "id": "690780801",
                    "speaker": "艾尔海森",
                    "text": "本该拿来阅读的书籍，实际上在许多人家中起着其他作用。"
                },
                {
                    "id": "690780802",
                    "speaker": "艾尔海森",
                    "text": "——装饰。"
                },
                {
                    "id": "690780803",
                    "speaker": "艾尔海森",
                    "text": "有些人缺的不是读书的头脑，而是耐心。"
                }
            ]
        }
    ]
}