{
    "groupId": "4290",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 7,
        "米希尔": 15
    },
    "talks": [
        {
            "talkId": "6429001",
            "initDialog": "642900101",
            "dialogues": [
                {
                    "id": "642900101",
                    "speaker": "米希尔",
                    "text": "甘露花海的水与风，都和从前一样。对人类来说应该也算是非常舒适的吧？"
                }
            ]
        },
        {
            "talkId": "6429002",
            "initDialog": "642900201",
            "dialogues": [
                {
                    "id": "642900201",
                    "speaker": "Player",
                    "text": "关于责任…"
                },
                {
                    "id": "642900202",
                    "speaker": "米希尔",
                    "text": "对于花灵来说是理所当然的事，并不觉得辛苦。"
                }
            ]
        },
        {
            "talkId": "6429003",
            "initDialog": "642900301",
            "dialogues": [
                {
                    "id": "642900301",
                    "speaker": "Player",
                    "text": "关于斯露莎…"
                },
                {
                    "id": "642900302",
                    "speaker": "米希尔",
                    "text": "斯露莎也在努力尽到自己作为花灵的责任。"
                },
                {
                    "id": "642900303",
                    "speaker": "米希尔",
                    "text": "虽然方法…还有改进的余地。但她非常努力，你们应该了解。"
                }
            ]
        },
        {
            "talkId": "6429004",
            "initDialog": "642900401",
            "dialogues": [
                {
                    "id": "642900401",
                    "speaker": "Player",
                    "text": "先不打扰了。"
                },
                {
                    "id": "642900402",
                    "speaker": "米希尔",
                    "text": "嗯。我还会在这里停留一阵。"
                }
            ]
        },
        {
            "talkId": "6429005",
            "initDialog": "642900501",
            "dialogues": [
                {
                    "id": "642900501",
                    "speaker": "米希尔",
                    "text": "暂时恢复了宁静…友善的人类，为什么还在这里逗留？"
                }
            ]
        },
        {
            "talkId": "6429006",
            "initDialog": "642900601",
            "dialogues": [
                {
                    "id": "642900601",
                    "speaker": "Player",
                    "text": "还有些事…"
                },
                {
                    "id": "642900602",
                    "speaker": "米希尔",
                    "text": "如果是这样，可以理解。"
                },
                {
                    "id": "642900603",
                    "speaker": "米希尔",
                    "text": "我也有许多事…在暂时的休息后，需要完成。"
                }
            ]
        },
        {
            "talkId": "6429007",
            "initDialog": "642900701",
            "dialogues": [
                {
                    "id": "642900701",
                    "speaker": "Player",
                    "text": "关于斯露莎…"
                },
                {
                    "id": "642900702",
                    "speaker": "米希尔",
                    "text": "用人类的话来说，经过这些事，她「成熟」了。"
                },
                {
                    "id": "642900703",
                    "speaker": "米希尔",
                    "text": "花灵无所谓成长的过程，不过想到斯露莎原本就…"
                },
                {
                    "id": "642900704",
                    "speaker": "米希尔",
                    "text": "嗯。对她来说是好事，这样就足够了。"
                }
            ]
        },
        {
            "talkId": "6429008",
            "initDialog": "642900801",
            "dialogues": [
                {
                    "id": "642900801",
                    "speaker": "Player",
                    "text": "关于「焚真之天象」…"
                },
                {
                    "id": "642900802",
                    "speaker": "米希尔",
                    "text": "虽然发生了很多意料之外的事…应该说是斯露莎意料之外的事。"
                },
                {
                    "id": "642900803",
                    "speaker": "米希尔",
                    "text": "但总算是熄灭了倒悬头顶的天象，斯露莎也从花冠中学到了许多吧。"
                },
                {
                    "id": "642900804",
                    "speaker": "米希尔",
                    "text": "不过争斗本身是不会消失的，作为花灵，我们的责任并没有因此而被解除…"
                }
            ]
        },
        {
            "talkId": "6429009",
            "initDialog": "642900901",
            "dialogues": [
                {
                    "id": "642900901",
                    "speaker": "Player",
                    "text": "没什么，先不打扰了。"
                },
                {
                    "id": "642900902",
                    "speaker": "米希尔",
                    "text": "再见，友善的人类。"
                }
            ]
        }
    ]
}