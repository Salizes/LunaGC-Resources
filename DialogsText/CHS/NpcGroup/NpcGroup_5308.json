{
    "groupId": "5308",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 7,
        "露菲娜": 17
    },
    "talks": [
        {
            "talkId": "6530801",
            "initDialog": "653080101",
            "dialogues": [
                {
                    "id": "653080101",
                    "speaker": "露菲娜",
                    "text": "欸，从来没在这见过你，是从外面来的新面孔！正常人也很少来这…咦，难道你是冒险家吗？"
                },
                {
                    "id": "653080102",
                    "speaker": "露菲娜",
                    "text": "听说冒险家就会像你这样，跑到各种各样的地方去，是真的吗？"
                }
            ]
        },
        {
            "talkId": "6530802",
            "initDialog": "653080201",
            "dialogues": [
                {
                    "id": "653080201",
                    "speaker": "Player",
                    "text": "确实去过许多地方啦。"
                },
                {
                    "id": "653080202",
                    "speaker": "露菲娜",
                    "text": "呜哇，真好，我以后也要加入冒险家协会，到不同的地方去看看。"
                },
                {
                    "id": "653080203",
                    "speaker": "露菲娜",
                    "text": "好，决定了，我一定要成为了不起的美露莘冒险家！"
                }
            ]
        },
        {
            "talkId": "6530803",
            "initDialog": "653080301",
            "dialogues": [
                {
                    "id": "653080301",
                    "speaker": "Player",
                    "text": "是的，但我现在要离开了。"
                },
                {
                    "id": "653080302",
                    "speaker": "露菲娜",
                    "text": "好吧，等你有空的时候，跟我说说你见过的风景嘛，冒险家！"
                }
            ]
        },
        {
            "talkId": "6530804",
            "initDialog": "653080401",
            "dialogues": [
                {
                    "id": "653080401",
                    "speaker": "Player",
                    "text": "会遇上危险哦？"
                },
                {
                    "id": "653080402",
                    "speaker": "露菲娜",
                    "text": "唔，确实，故事书里经常也会出现很多很危急的情况。"
                },
                {
                    "id": "653080403",
                    "speaker": "露菲娜",
                    "text": "姐姐也会对我说，「随便跑出去，小心被外面的大大怪物吃掉！」不过我知道她只是在吓唬我。"
                },
                {
                    "id": "653080404",
                    "speaker": "露菲娜",
                    "text": "哼，等我准备好了，不惧怕任何危险之后，我一定要去外面看一看！"
                }
            ]
        },
        {
            "talkId": "6530805",
            "initDialog": "653080501",
            "dialogues": [
                {
                    "id": "653080501",
                    "speaker": "Player",
                    "text": "好喔！美露莘冒险家！"
                },
                {
                    "id": "653080502",
                    "speaker": "露菲娜",
                    "text": "听上去就很了不起！偷偷告诉你，其实我有的时候也会溜出村子玩啦。"
                },
                {
                    "id": "653080503",
                    "speaker": "露菲娜",
                    "text": "不过我都只玩一小会儿，在姐姐发现之前就会跑回来，啊，这件事可不许告诉姐姐哦！"
                }
            ]
        },
        {
            "talkId": "6530806",
            "initDialog": "653080601",
            "dialogues": [
                {
                    "id": "653080601",
                    "speaker": "露菲娜",
                    "text": "原来是你，嘿嘿，你救出姐姐的事，我都听姐姐说了，真厉害！"
                }
            ]
        },
        {
            "talkId": "6530807",
            "initDialog": "653080701",
            "dialogues": [
                {
                    "id": "653080701",
                    "speaker": "Player",
                    "text": "一般般厉害吧…"
                },
                {
                    "id": "653080702",
                    "speaker": "露菲娜",
                    "text": "听姐姐说，你不仅干脆利落地救出了姐姐，就连坏人见到你也不得不求饶…就像大冒险家斯坦利一样！"
                },
                {
                    "id": "653080703",
                    "speaker": "露菲娜",
                    "text": "我以后也要像斯坦利，不，像你一样，成为了不起的冒险家！"
                }
            ]
        },
        {
            "talkId": "6530808",
            "initDialog": "653080801",
            "dialogues": [
                {
                    "id": "653080801",
                    "speaker": "Player",
                    "text": "谢谢，再见。"
                },
                {
                    "id": "653080802",
                    "speaker": "露菲娜",
                    "text": "再见，再见！等你有空的时候，跟我说说你自己的冒险故事吧！"
                }
            ]
        },
        {
            "talkId": "6530809",
            "initDialog": "653080901",
            "dialogues": [
                {
                    "id": "653080901",
                    "speaker": "Player",
                    "text": "关于刚才的地震…"
                },
                {
                    "id": "653080902",
                    "speaker": "露菲娜",
                    "text": "听到刚才的动静了吗？一定发生了什么不得了的大事！"
                },
                {
                    "id": "653080903",
                    "speaker": "露菲娜",
                    "text": "说不定是什么秘宝被人挖了出来，这才晃得这么厉害——故事里都是这样说的啦！"
                },
                {
                    "id": "653080904",
                    "speaker": "露菲娜",
                    "text": "可惜，姐姐不让我随便出村子…要不然的话，我一定能成为秘宝的第一发现者，开始我的冒险故事！"
                }
            ]
        }
    ]
}