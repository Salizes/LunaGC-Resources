{
    "groupId": "3124",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "雄三": 10
    },
    "talks": [
        {
            "talkId": "6312401",
            "initDialog": "631240101",
            "dialogues": [
                {
                    "id": "631240101",
                    "speaker": "雄三",
                    "text": "你好，你也是来给珊瑚宫帮忙的吗？"
                },
                {
                    "id": "631240102",
                    "speaker": "雄三",
                    "text": "要是能帮我找些好的材料就好了，这边装备上需要提升的东西还有很多。"
                }
            ]
        },
        {
            "talkId": "6312402",
            "initDialog": "631240201",
            "dialogues": [
                {
                    "id": "631240201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "631240202",
                    "speaker": "雄三",
                    "text": "我是珊瑚宫军从踏鞴砂御影炉心废墟里救出的工人，现在为军营工作。"
                },
                {
                    "id": "631240203",
                    "speaker": "雄三",
                    "text": "毕竟眼狩令让那么多人受苦，踏鞴砂工人们也曾经庇护了不少神之眼的持有者，自然对幕府多有怨言。"
                },
                {
                    "id": "631240204",
                    "speaker": "雄三",
                    "text": "和幕府的军队相比，珊瑚宫的反抗军虽然看起来弱小，但还是比冷漠无情的幕府强上百倍。"
                },
                {
                    "id": "631240205",
                    "speaker": "雄三",
                    "text": "虽然力量微薄，但我还是想为反抗军出一份力，让幕府受些教训。"
                }
            ]
        },
        {
            "talkId": "6312403",
            "initDialog": "631240301",
            "dialogues": [
                {
                    "id": "631240301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631240302",
                    "speaker": "雄三",
                    "text": "再见，若是有了好的材料可以拿给我看看。"
                }
            ]
        },
        {
            "talkId": "6312404",
            "initDialog": "631240401",
            "dialogues": [
                {
                    "id": "631240401",
                    "speaker": "Player",
                    "text": "关于反抗军…"
                },
                {
                    "id": "631240402",
                    "speaker": "雄三",
                    "text": "听说反抗军的统领——珊瑚宫心海大人深谋远略，是用兵奇才。"
                },
                {
                    "id": "631240403",
                    "speaker": "雄三",
                    "text": "在之前的几次交战中，反抗军都靠着珊瑚宫大人的锦囊妙计，再加上五郎大将对战场风向的敏锐感知，没有让幕府占去优势。"
                },
                {
                    "id": "631240404",
                    "speaker": "雄三",
                    "text": "多亏他们，珊瑚宫军才一直撑到了现在啊。"
                }
            ]
        }
    ]
}