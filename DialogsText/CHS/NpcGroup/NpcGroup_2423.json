{
    "groupId": "2423",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "淑之": 10
    },
    "talks": [
        {
            "talkId": "6242301",
            "initDialog": "624230101",
            "dialogues": [
                {
                    "id": "624230101",
                    "speaker": "淑之",
                    "text": "年轻人，要买东西吗？"
                },
                {
                    "id": "624230102",
                    "speaker": "淑之",
                    "text": "…算了，爱买不买吧，烦着呢。"
                }
            ]
        },
        {
            "talkId": "6242302",
            "initDialog": "624230201",
            "dialogues": [
                {
                    "id": "624230201",
                    "speaker": "Player",
                    "text": "您在等客人吗？"
                },
                {
                    "id": "624230202",
                    "speaker": "淑之",
                    "text": "等客人？"
                },
                {
                    "id": "624230203",
                    "speaker": "淑之",
                    "text": "呵呵，客人什么的，等得久一点总是会来的。"
                },
                {
                    "id": "624230204",
                    "speaker": "淑之",
                    "text": "可有些人呢，等一辈子也不一定等得到了，呵呵。"
                }
            ]
        },
        {
            "talkId": "6242303",
            "initDialog": "624230301",
            "dialogues": [
                {
                    "id": "624230301",
                    "speaker": "Player",
                    "text": "关于小卖部…"
                },
                {
                    "id": "624230302",
                    "speaker": "淑之",
                    "text": "这一带人烟稀少，货不是很好卖，不过我也没那么在乎了。"
                },
                {
                    "id": "624230303",
                    "speaker": "淑之",
                    "text": "实际上我早就到了退休的年纪，还在这里只是为了等一个人…"
                },
                {
                    "id": "624230304",
                    "speaker": "淑之",
                    "text": "反正我已经等了他大半辈子了，也不差这几天了。"
                },
                {
                    "id": "624230305",
                    "speaker": "淑之",
                    "text": "也不知道入土之前能不能等到那个榆木脑袋开窍，呵呵。"
                }
            ]
        },
        {
            "talkId": "6242304",
            "initDialog": "624230401",
            "dialogues": [
                {
                    "id": "624230401",
                    "speaker": "Player",
                    "text": "再见"
                },
                {
                    "id": "624230402",
                    "speaker": "淑之",
                    "text": "走吧走吧，要走就干脆点，我已经被耽误得够多了。"
                }
            ]
        }
    ]
}