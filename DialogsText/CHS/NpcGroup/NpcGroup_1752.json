{
    "groupId": "1752",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "莉莲": 9
    },
    "talks": [
        {
            "talkId": "6175201",
            "initDialog": "617520101",
            "dialogues": [
                {
                    "id": "617520101",
                    "speaker": "莉莲",
                    "text": "欸？这株是不是刚才浇过了来着？"
                }
            ]
        },
        {
            "talkId": "6175202",
            "initDialog": "617520201",
            "dialogues": [
                {
                    "id": "617520201",
                    "speaker": "莉莲",
                    "text": "欸？这是…您的香氛吗？"
                }
            ]
        },
        {
            "talkId": "6175203",
            "initDialog": "617520301",
            "dialogues": [
                {
                    "id": "617520301",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "617520302",
                    "speaker": "莉莲",
                    "text": "我在尝试培育具有不同香气的花朵喔。这样一来，就可以用它们萃取出不同的香氛啦。"
                },
                {
                    "id": "617520303",
                    "speaker": "莉莲",
                    "text": "比如说，这株「玛丽小姐」呢，可以调配出轻雨般清新的前调，而那边那株「吉尔丹女士」则是作为沉稳浓郁的中调过渡…"
                },
                {
                    "id": "617520304",
                    "speaker": "莉莲",
                    "text": "只不过…唔，后调应该是什么味道呢？"
                }
            ]
        },
        {
            "talkId": "6175204",
            "initDialog": "617520401",
            "dialogues": [
                {
                    "id": "617520401",
                    "speaker": "Player",
                    "text": "关于香氛…"
                },
                {
                    "id": "617520402",
                    "speaker": "莉莲",
                    "text": "呵呵，我的嗅觉可是很灵敏的。您用的香氛，应该是出自安妮克小姐的手笔吧？"
                },
                {
                    "id": "617520403",
                    "speaker": "莉莲",
                    "text": "香调丰富，层次变化清晰，以及谐奏般的讯息…就像是冬日正午时分的暖阳，明亮却温柔。"
                },
                {
                    "id": "617520404",
                    "speaker": "莉莲",
                    "text": "谢谢您。闻到您的香氛，我也获得了新的灵感呢。"
                }
            ]
        },
        {
            "talkId": "6175205",
            "initDialog": "617520501",
            "dialogues": [
                {
                    "id": "617520501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617520502",
                    "speaker": "莉莲",
                    "text": "嗯嗯，慢走。"
                }
            ]
        }
    ]
}