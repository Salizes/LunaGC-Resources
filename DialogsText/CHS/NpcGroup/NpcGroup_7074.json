{
    "groupId": "7074",
    "total_dialogue_lines": 7,
    "speaker_counts": {
        "Player": 2,
        "鲁兹茨基": 5
    },
    "talks": [
        {
            "talkId": "6707401",
            "initDialog": "670740101",
            "dialogues": [
                {
                    "id": "670740101",
                    "speaker": "鲁兹茨基",
                    "text": "请注意安全！竟然爬到这么高的地方来了…"
                }
            ]
        },
        {
            "talkId": "6707402",
            "initDialog": "670740201",
            "dialogues": [
                {
                    "id": "670740201",
                    "speaker": "Player",
                    "text": "传送带怎么了？"
                },
                {
                    "id": "670740202",
                    "speaker": "鲁兹茨基",
                    "text": "噢，也不是什么大问题，只是动能核心过载、传动模块卡死、主阀门锁死故障…等等问题而已。"
                },
                {
                    "id": "670740203",
                    "speaker": "鲁兹茨基",
                    "text": "已经有专人在处理了，倒也不用太担心什么时候能修好。"
                },
                {
                    "id": "670740204",
                    "speaker": "鲁兹茨基",
                    "text": "唉，你还是赶紧回到平稳的地面上吧，务必要小心啊。"
                }
            ]
        },
        {
            "talkId": "6707403",
            "initDialog": "670740301",
            "dialogues": [
                {
                    "id": "670740301",
                    "speaker": "Player",
                    "text": "谢谢，我会注意安全的。"
                },
                {
                    "id": "670740302",
                    "speaker": "鲁兹茨基",
                    "text": "嗯，不管什么时候，安全都得放在第一位。"
                }
            ]
        }
    ]
}