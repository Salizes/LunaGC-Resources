{
    "groupId": "31074",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 5,
        "科赫": 2,
        "赫得蔚格": 17
    },
    "talks": [
        {
            "talkId": "7668306",
            "initDialog": "766830601",
            "dialogues": [
                {
                    "id": "766830601",
                    "speaker": "赫得蔚格",
                    "text": "其实真没想到，荣誉骑士也会来参加这次推演，阵仗还挺大的…",
                    "choices": [
                        {
                            "id": "766830602",
                            "text": "朋友，你还做什么别的工作？",
                            "response": [
                                {
                                    "id": "766830603",
                                    "speaker": "赫得蔚格",
                                    "text": "…「负责背黑锅」…"
                                },
                                {
                                    "id": "766830604",
                                    "speaker": "赫得蔚格",
                                    "text": "开玩笑的！其实是各种经典的文员工作。无论什么事，都由我在骑士团、沫芒宫和纳塔勇士之间负责交涉。"
                                },
                                {
                                    "id": "766830605",
                                    "speaker": "赫得蔚格",
                                    "text": "这样可以避免中间太多人来回讨论的摩擦成本。"
                                },
                                {
                                    "id": "766830606",
                                    "speaker": "赫得蔚格",
                                    "text": "合作过程中的一些流程问题，也由我跑腿。还要管理交流队伍的整体出差费用…",
                                    "choices": [
                                        {
                                            "id": "766830607",
                                            "text": "那蛮辛苦的。",
                                            "response": [
                                                {
                                                    "id": "766830609",
                                                    "speaker": "赫得蔚格",
                                                    "text": "这不是见到你了吗？还有传奇射手，千步距离上打出一角分之内散布的夏沃蕾特巡队长…"
                                                },
                                                {
                                                    "id": "766830610",
                                                    "speaker": "赫得蔚格",
                                                    "text": "以及不能用常理来评估的龙骑士恰斯卡，射击技术离谱得像是给双手装上了稳定机关。"
                                                },
                                                {
                                                    "id": "766830611",
                                                    "speaker": "赫得蔚格",
                                                    "text": "工作再杂再累，我都赚大了，让我倒贴工资我都值呀！"
                                                },
                                                {
                                                    "id": "766830612",
                                                    "speaker": "赫得蔚格",
                                                    "text": "而且，我发现铳枪还蛮适合我的。之前我受了伤，再也没希望用佩剑战斗了…"
                                                },
                                                {
                                                    "id": "766830613",
                                                    "speaker": "赫得蔚格",
                                                    "text": "结果推演里，我拿着科赫的铳枪上去试了几场，成绩还不错，以后说不定能用这武器重返一线！"
                                                },
                                                {
                                                    "id": "766830614",
                                                    "speaker": "Player",
                                                    "text": "人好像也不算多？"
                                                },
                                                {
                                                    "id": "766830615",
                                                    "speaker": "赫得蔚格",
                                                    "text": "以早期技术交流会的标准来看，很厉害了！远程、支援和综务三支小队的人手混编呢！"
                                                },
                                                {
                                                    "id": "766830616",
                                                    "speaker": "赫得蔚格",
                                                    "text": "要不是第五小队副队长以奇特的理由推脱，光这里的骑士团兵力，就能剿灭一大支魔物部队了吧。"
                                                },
                                                {
                                                    "id": "766830617",
                                                    "speaker": "赫得蔚格",
                                                    "text": "更不用说那位枫丹队长，和纳塔龙骑士们的兵力了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766830608",
                                            "text": "那祝你顺利。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766830618",
                            "text": "你忙你的，我先走了。",
                            "response": [
                                {
                                    "id": "766830619",
                                    "speaker": "赫得蔚格",
                                    "text": "你才是大忙人，和我这么客气，我受宠若惊！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7668404",
            "initDialog": "766840401",
            "dialogues": [
                {
                    "id": "766840401",
                    "speaker": "科赫",
                    "text": "快要收工了…去那边的「锈舵」喝两杯？"
                },
                {
                    "id": "766840402",
                    "speaker": "赫得蔚格",
                    "text": "喝什么喝！你们自己掏腰包喔？我一摩拉都不会给你们批的。"
                },
                {
                    "id": "766840403",
                    "speaker": "科赫",
                    "text": "没事，我们自己出钱，再带几瓶好的回去给霍肯、乌苏拉和君特！噢，还有凯亚队长和大团长！"
                },
                {
                    "id": "766840404",
                    "speaker": "赫得蔚格",
                    "text": "反正我就免了，我要好好整理这次推演的记录，远程小队得留个人下来帮我！"
                },
                {
                    "id": "766840405",
                    "speaker": "赫得蔚格",
                    "text": "还有特巡队给团长的书面文件，进修计划…无意之间，又开了个好头啊！"
                }
            ]
        }
    ]
}