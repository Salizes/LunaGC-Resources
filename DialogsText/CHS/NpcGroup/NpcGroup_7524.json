{
    "groupId": "7524",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "季宾娜": 10
    },
    "talks": [
        {
            "talkId": "6752401",
            "initDialog": "675240101",
            "dialogues": [
                {
                    "id": "675240101",
                    "speaker": "季宾娜",
                    "text": "唉，会长…老爷子…怎么会走得那么突然呢…还有，我一个人怎么干得了这么多活！"
                }
            ]
        },
        {
            "talkId": "6752402",
            "initDialog": "675240201",
            "dialogues": [
                {
                    "id": "675240201",
                    "speaker": "Player",
                    "text": "你看起来不是很高兴…"
                },
                {
                    "id": "675240202",
                    "speaker": "季宾娜",
                    "text": "没有人会在上班的时候觉得高兴…不过我伤心是因为前会长，前会长老爷子…突然就去世了…"
                },
                {
                    "id": "675240203",
                    "speaker": "季宾娜",
                    "text": "我从入职开始就跟着前会长啦，有的时候工作出了岔子，还是前会长帮忙摆平的。"
                },
                {
                    "id": "675240204",
                    "speaker": "季宾娜",
                    "text": "呜呜…前会长明明是长寿的妖精，我还以为我死了他还不会死呢…"
                }
            ]
        },
        {
            "talkId": "6752403",
            "initDialog": "675240301",
            "dialogues": [
                {
                    "id": "675240301",
                    "speaker": "Player",
                    "text": "关于这个会长…"
                },
                {
                    "id": "675240302",
                    "speaker": "季宾娜",
                    "text": "其、其实是前任会长啦，毕竟已经去世了…不过我还是习惯叫他会长…"
                },
                {
                    "id": "675240303",
                    "speaker": "季宾娜",
                    "text": "伊兹梅洛老爷子活了很久，有的时候还能听到他说从前至冬发生的故事呢。"
                },
                {
                    "id": "675240304",
                    "speaker": "季宾娜",
                    "text": "…可惜，这些故事以后也没有人讲了。"
                }
            ]
        },
        {
            "talkId": "6752404",
            "initDialog": "675240401",
            "dialogues": [
                {
                    "id": "675240401",
                    "speaker": "Player",
                    "text": "没有人可以帮忙吗？"
                },
                {
                    "id": "675240402",
                    "speaker": "季宾娜",
                    "text": "原本倒是有个技术顾问…那位先生在的时候，处理技术问题比现在有效率多啦。"
                },
                {
                    "id": "675240403",
                    "speaker": "季宾娜",
                    "text": "不过那位先生似乎外派到了其他地方，很少在这儿露面，我也只能一个人处理这些技术问题了。"
                }
            ]
        },
        {
            "talkId": "6752405",
            "initDialog": "675240501",
            "dialogues": [
                {
                    "id": "675240501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675240502",
                    "speaker": "季宾娜",
                    "text": "唉，再见…"
                }
            ]
        }
    ]
}