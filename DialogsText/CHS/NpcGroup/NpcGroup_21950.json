    "talks": [
        {
            "talkId": "1504557",
            "initDialog": "150455701",
            "dialogues": [
                {
                    "id": "150455701",
                    "speaker": "阿乔",
                    "text": "这个项目看着很适合你啊，基尼奇，我们一起来挑战吧？"
                },
                {
                    "id": "150455702",
                    "speaker": "基尼奇",
                    "text": "我知道你想趁我起跳的时候，往我背上踢一脚。"
                },
                {
                    "id": "150455703",
                    "speaker": "基尼奇",
                    "text": "说少了。你好像还在盘算要拆掉一两块木板…让我踩空掉下去。"
                },
                {
                    "id": "150455704",
                    "speaker": "阿乔",
                    "text": "……"
                },
                {
                    "id": "150455705",
                    "speaker": "基尼奇",
                    "text": "同样的把戏你在「悬木人」的地盘用过了…我有什么理由上当？"
                },
                {
                    "id": "150455706",
                    "speaker": "阿乔",
                    "text": "谁度假的时候会那么警惕啊！气死我了！"
                }
            ]
        }
    ]
}