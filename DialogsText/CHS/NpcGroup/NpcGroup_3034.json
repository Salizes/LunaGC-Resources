{
    "groupId": "3034",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 7,
        "土门": 23
    },
    "talks": [
        {
            "talkId": "6303401",
            "initDialog": "630340101",
            "dialogues": [
                {
                    "id": "630340101",
                    "speaker": "土门",
                    "text": "从前的我，是这样的人吗…当初为什么执意要挥剑呢…"
                },
                {
                    "id": "630340102",
                    "speaker": "土门",
                    "text": "师父…师兄…我…"
                },
                {
                    "id": "630340103",
                    "speaker": "土门",
                    "text": "好吧！你们如果想要复仇的话，就动手吧！…哈哈哈…"
                }
            ]
        },
        {
            "talkId": "6303402",
            "initDialog": "630340201",
            "dialogues": [
                {
                    "id": "630340201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630340202",
                    "speaker": "土门",
                    "text": "极致的剑道，究竟是什么呢…击败所有人，就是「天下第一」了吗？"
                },
                {
                    "id": "630340203",
                    "speaker": "土门",
                    "text": "可是「天下第一」…「天下第一」的话…"
                },
                {
                    "id": "630340204",
                    "speaker": "土门",
                    "text": "如果我是「天下第一」，那我还会如此纠结于过去吗？"
                },
                {
                    "id": "630340205",
                    "speaker": "土门",
                    "text": "可如果我还不是「天下第一」，那师父…和师兄…岂不是白白…"
                }
            ]
        },
        {
            "talkId": "6303403",
            "initDialog": "630340301",
            "dialogues": [
                {
                    "id": "630340301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "630340302",
                    "speaker": "土门",
                    "text": "过去的我，到底在想些什么呢…"
                }
            ]
        },
        {
            "talkId": "6303404",
            "initDialog": "630340401",
            "dialogues": [
                {
                    "id": "630340401",
                    "speaker": "土门",
                    "text": "你好，若是想拜师习武，请…啊，原来是你，旅行者。"
                },
                {
                    "id": "630340402",
                    "speaker": "土门",
                    "text": "好久不见，在稻妻的旅行还顺利吗？"
                }
            ]
        },
        {
            "talkId": "6303405",
            "initDialog": "630340501",
            "dialogues": [
                {
                    "id": "630340501",
                    "speaker": "Player",
                    "text": "你看起来好多了。"
                },
                {
                    "id": "630340502",
                    "speaker": "土门",
                    "text": "哈哈，一旦解开了心结，就知道自己下一步该做什么了。"
                },
                {
                    "id": "630340503",
                    "speaker": "土门",
                    "text": "虽然没了神之眼，以前的愿望是无法实现了…但只要还有弟子们的传承，「明镜止水流」就不会失落，「天下第一」的梦想就还有希望。"
                }
            ]
        },
        {
            "talkId": "6303406",
            "initDialog": "630340601",
            "dialogues": [
                {
                    "id": "630340601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630340602",
                    "speaker": "土门",
                    "text": "谢谢你，再见。"
                }
            ]
        },
        {
            "talkId": "6303407",
            "initDialog": "630340701",
            "dialogues": [
                {
                    "id": "630340701",
                    "speaker": "Player",
                    "text": "你还好吗…？"
                },
                {
                    "id": "630340702",
                    "speaker": "土门",
                    "text": "好…好？如果我有好的剑术，应该就会好了吧…"
                },
                {
                    "id": "630340703",
                    "speaker": "土门",
                    "text": "但是神之眼…"
                },
                {
                    "id": "630340704",
                    "speaker": "土门",
                    "text": "没有了神之眼，我再也无法成为「天下第一」了…那么过去做的事情，就全部…就连我的弟子们，也…"
                },
                {
                    "id": "630340705",
                    "speaker": "土门",
                    "text": "师父，师兄…你们不要只是看着，也说些什么吧…"
                }
            ]
        },
        {
            "talkId": "6303408",
            "initDialog": "630340801",
            "dialogues": [
                {
                    "id": "630340801",
                    "speaker": "Player",
                    "text": "你看起来好多了。"
                },
                {
                    "id": "630340802",
                    "speaker": "土门",
                    "text": "哈哈，一旦解开了心结，就知道自己下一步该做什么了。"
                },
                {
                    "id": "630340803",
                    "speaker": "土门",
                    "text": "虽然神之眼已经回来了，但我已不是原来的自己了…「天下第一」的梦想，还是交给弟子们吧。"
                },
                {
                    "id": "630340804",
                    "speaker": "土门",
                    "text": "只要有这些年轻的希望，「明镜止水流」就不会失落。"
                }
            ]
        },
        {
            "talkId": "7292501",
            "initDialog": "729250101",
            "dialogues": [
                {
                    "id": "729250101",
                    "speaker": "Player",
                    "text": "祝你们早日实现愿望。"
                },
                {
                    "id": "729250102",
                    "speaker": "土门",
                    "text": "哈哈，谢谢你。"
                },
                {
                    "id": "729250103",
                    "speaker": "土门",
                    "text": "这里有些我多年以来的剑道心得，虽然你不是我门弟子，但却是我的恩人，所以分享给你。"
                },
                {
                    "id": "729250104",
                    "speaker": "土门",
                    "text": "前路漫漫，遥祝平安。"
                }
            ]
        }
    ]
}