{
    "groupId": "7412",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 5,
        "布图琳娜": 10
    },
    "talks": [
        {
            "talkId": "6741201",
            "initDialog": "674120101",
            "dialogues": [
                {
                    "id": "674120101",
                    "speaker": "布图琳娜",
                    "text": "欢迎，欢迎光临「老庭院餐厅」，如果您有什么需要，请随时和我说。"
                }
            ]
        },
        {
            "talkId": "6741202",
            "initDialog": "674120201",
            "dialogues": [
                {
                    "id": "674120201",
                    "speaker": "Player",
                    "text": "让我看看菜单…"
                },
                {
                    "id": "674120202",
                    "speaker": "布图琳娜",
                    "text": "好的，您请，有需要点单就和我说。"
                }
            ]
        },
        {
            "talkId": "6741203",
            "initDialog": "674120301",
            "dialogues": [
                {
                    "id": "674120301",
                    "speaker": "Player",
                    "text": "老庭院…有多老？"
                },
                {
                    "id": "674120302",
                    "speaker": "布图琳娜",
                    "text": "那可真的很老了，毕竟在这里供职的全都是长生的妖精嘛…不过具体的年份，就连我也不是很清楚。"
                },
                {
                    "id": "674120303",
                    "speaker": "布图琳娜",
                    "text": "如果您是在担心吃到的不是正宗的老味道，那大可不必，我们现在的老板…从很久以前开始就在这掌勺啦。"
                },
                {
                    "id": "674120304",
                    "speaker": "布图琳娜",
                    "text": "他当上老板的时候，我都还是在雪原上滚来滚去的毛球呢。"
                }
            ]
        },
        {
            "talkId": "6741204",
            "initDialog": "674120401",
            "dialogues": [
                {
                    "id": "674120401",
                    "speaker": "Player",
                    "text": "可以预订座位吗？"
                },
                {
                    "id": "674120402",
                    "speaker": "布图琳娜",
                    "text": "按店里的规矩，不行，但是如果您真的需要，可以提前和我说…"
                },
                {
                    "id": "674120403",
                    "speaker": "布图琳娜",
                    "text": "您看，偶尔也会有忘了安排客人的桌子，遇上了凑巧来就餐的您，这不是皆大欢喜的好事嘛。"
                }
            ]
        },
        {
            "talkId": "6741205",
            "initDialog": "674120501",
            "dialogues": [
                {
                    "id": "674120501",
                    "speaker": "Player",
                    "text": "有什么推荐菜吗？"
                },
                {
                    "id": "674120502",
                    "speaker": "布图琳娜",
                    "text": "「老庭院」的每道菜都是推荐菜哦，每道能在漫长岁月里留在菜单里的佳肴都有各自的可取之处。"
                },
                {
                    "id": "674120503",
                    "speaker": "布图琳娜",
                    "text": "是否喜欢，就得看客人您自己的口味了，而我的建议是…多做些尝试吧！"
                }
            ]
        },
        {
            "talkId": "6741206",
            "initDialog": "674120601",
            "dialogues": [
                {
                    "id": "674120601",
                    "speaker": "Player",
                    "text": "呃，没什么需要…"
                },
                {
                    "id": "674120602",
                    "speaker": "布图琳娜",
                    "text": "那期待您下次的光临，客人。"
                }
            ]
        }
    ]
}