{
    "groupId": "6491",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 6,
        "「特特尔特特尔」": 13
    },
    "talks": [
        {
            "talkId": "6649101",
            "initDialog": "664910101",
            "dialogues": [
                {
                    "id": "664910101",
                    "speaker": "「特特尔特特尔」",
                    "text": "悠悠纳塔，悠悠夏天！我的朋友，欢迎来到悠悠集市。"
                }
            ]
        },
        {
            "talkId": "6649102",
            "initDialog": "664910201",
            "dialogues": [
                {
                    "id": "664910201",
                    "speaker": "Player",
                    "text": "你是…？"
                },
                {
                    "id": "664910202",
                    "speaker": "「特特尔特特尔」",
                    "text": "我是您忠诚的朋友「特特尔特特尔」，「特特尔特特尔」曾是特诺奇兹托克的迎礼人，如今也是悠悠度假村的迎礼人。"
                },
                {
                    "id": "664910203",
                    "speaker": "Player",
                    "text": "你的衣服很特别。"
                },
                {
                    "id": "664910204",
                    "speaker": "「特特尔特特尔」",
                    "text": "哦嗬嗬，这是娜娜丝梨服装，娜娜丝梨是一种刺梨，曾是本地的特产，可惜现在已经消失在五百年的时光里了。"
                },
                {
                    "id": "664910205",
                    "speaker": "「特特尔特特尔」",
                    "text": "如果您继续往前走，应该还会碰上穿着诺奇特梨服装的家伙，那是另一种刺梨。"
                },
                {
                    "id": "664910206",
                    "speaker": "「特特尔特特尔」",
                    "text": "没记错的话，他们通常都待在刺梨镇上。"
                }
            ]
        },
        {
            "talkId": "6649103",
            "initDialog": "664910301",
            "dialogues": [
                {
                    "id": "664910301",
                    "speaker": "Player",
                    "text": "在悠悠集市能干什么？"
                },
                {
                    "id": "664910302",
                    "speaker": "「特特尔特特尔」",
                    "text": "休憩，获取妙趣横生的货物，品尝特色美食，欣赏色彩缤纷的街道，躺在椅子上挥霍时光。"
                },
                {
                    "id": "664910303",
                    "speaker": "「特特尔特特尔」",
                    "text": "或者让「特特尔特特尔」陪您聊一整天。"
                },
                {
                    "id": "664910304",
                    "speaker": "Player",
                    "text": "谢谢，下次吧。"
                },
                {
                    "id": "664910305",
                    "speaker": "「特特尔特特尔」",
                    "text": "哦嗬嗬，愿您能享受这个心旷神怡的夏天。"
                }
            ]
        },
        {
            "talkId": "6649104",
            "initDialog": "664910401",
            "dialogues": [
                {
                    "id": "664910401",
                    "speaker": "Player",
                    "text": "还有哪里可以玩？"
                },
                {
                    "id": "664910402",
                    "speaker": "「特特尔特特尔」",
                    "text": "往深处走，洋流拍打沙滩的乐园是浪浪湾，它的东边是刺梨岩与刺梨镇，那里有一些奇特的居民。"
                },
                {
                    "id": "664910403",
                    "speaker": "「特特尔特特尔」",
                    "text": "刺梨岩的南边，孩子们用天地的绚烂绘制出了彩彩崖。"
                },
                {
                    "id": "664910404",
                    "speaker": "「特特尔特特尔」",
                    "text": "最后，在最北边，还有传说埋藏着丘丘人无尽黄金宝藏的帕依提提等待着您。"
                },
                {
                    "id": "664910405",
                    "speaker": "「特特尔特特尔」",
                    "text": "这一切的奥秘就等着您去发掘。"
                }
            ]
        },
        {
            "talkId": "6649105",
            "initDialog": "664910501",
            "dialogues": [
                {
                    "id": "664910501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "664910502",
                    "speaker": "「特特尔特特尔」",
                    "text": "哦嗬嗬，愿您能享受这个心旷神怡的夏天。"
                }
            ]
        }
    ]
}