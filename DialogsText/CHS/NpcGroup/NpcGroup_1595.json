{
    "groupId": "1595",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "摩可": 9,
        "海莉": 4
    },
    "talks": [
        {
            "talkId": "6159501",
            "initDialog": "615950101",
            "dialogues": [
                {
                    "id": "615950101",
                    "speaker": "摩可",
                    "text": "你有没有注意过…"
                },
                {
                    "id": "615950102",
                    "speaker": "海莉",
                    "text": "注意过什么？"
                },
                {
                    "id": "615950103",
                    "speaker": "摩可",
                    "text": "我们的钥匙都比爱德琳小姐少一把。"
                },
                {
                    "id": "615950104",
                    "speaker": "海莉",
                    "text": "欸…那也就是说…有秘密房间？"
                },
                {
                    "id": "615950105",
                    "speaker": "摩可",
                    "text": "对吧！对吧！你果然很懂！"
                },
                {
                    "id": "615950106",
                    "speaker": "摩可",
                    "text": "然后…那天我在给地板上蜡的时候，偶然发现二楼走廊的深处里还有一个隐藏房间！"
                },
                {
                    "id": "615950107",
                    "speaker": "海莉",
                    "text": "真的吗！那房间果然就是…？"
                },
                {
                    "id": "615950108",
                    "speaker": "摩可",
                    "text": "我靠近房门，只听到里面越来越近的「哒哒，哒哒…」的声音。"
                },
                {
                    "id": "615950109",
                    "speaker": "摩可",
                    "text": "我感到很害怕…就要离开的时候，发现爱德琳小姐就在我身后！"
                },
                {
                    "id": "615950110",
                    "speaker": "海莉",
                    "text": "呀——！"
                },
                {
                    "id": "615950111",
                    "speaker": "摩可",
                    "text": "可没想到，她不仅没有责骂我，还客客气气地让我回去…"
                },
                {
                    "id": "615950112",
                    "speaker": "摩可",
                    "text": "可等我回到房间才忽然想起——"
                },
                {
                    "id": "615950113",
                    "speaker": "摩可",
                    "text": "那个「哒哒」的声音，和爱德琳小姐穿靴子的脚步声…不是一模一样的吗？"
                }
            ]
        }
    ]
}