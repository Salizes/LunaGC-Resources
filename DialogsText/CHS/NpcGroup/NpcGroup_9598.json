    },
    "talks": [
        {
            "talkId": "6959801",
            "initDialog": "695980101",
            "dialogues": [
                {
                    "id": "695980101",
                    "speaker": "嘉明",
                    "text": "这游戏玩起来真有意思，怪不得这么多人都爱玩这种牌。唔，要不然…我也勤练一下？"
                }
            ]
        },
        {
            "talkId": "6959802",
            "initDialog": "695980201",
            "dialogues": [
                {
                    "id": "695980201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959803",
            "initDialog": "695980301",
            "dialogues": [
                {
                    "id": "695980301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695980302",
                    "speaker": "嘉明",
                    "text": "哇！都这个点了，还有镖要跑，我得走了！"
                }
            ]
        },
        {
            "talkId": "6959804",
            "initDialog": "695980401",
            "dialogues": [
                {
                    "id": "695980401",
                    "speaker": "嘉明",
                    "text": "喂喂，你怎么眼神都在晃，莫不是早起没吃饱？快快，把这碗糖水喝了先。"
                }
            ]
        },
        {
            "talkId": "6959805",
            "initDialog": "695980501",
            "dialogues": [
                {
                    "id": "695980501",
                    "speaker": "嘉明",
                    "text": "哎唷，还是你比较厉害。这打牌的技术，比镖局的兄弟们都强呀。"
                }
            ]
        },
        {
            "talkId": "6959806",
            "initDialog": "695980601",
            "dialogues": [
                {
                    "id": "695980601",
                    "speaker": "嘉明",
                    "text": "打牌？好哇，我打牌的功夫可是有一手的。"
                }
            ]
        },
        {
            "talkId": "6959808",
            "initDialog": "695980801",
            "dialogues": [
                {
                    "id": "695980801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959809",
            "initDialog": "695980901",
            "dialogues": [
                {
                    "id": "695980901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959810",
            "initDialog": "695981001",
            "dialogues": [
                {
                    "id": "695981001",
                    "speaker": "嘉明",
                    "text": "承让，这局我先拿下啦。"
                }
            ]
        },
        {
            "talkId": "6959811",
            "initDialog": "695981101",
            "dialogues": [
                {
                    "id": "695981101",
                    "speaker": "嘉明",
                    "text": "早上没喝早茶，头脑都不清醒了…"
                }
            ]
        },
        {
            "talkId": "6959812",
            "initDialog": "695981201",
            "dialogues": [
                {
                    "id": "695981201",
                    "speaker": "嘉明",
                    "text": "你都开了口，我当然要应啦，来来来，上桌上桌。"
                }
            ]
        },
        {
            "talkId": "6959814",
            "initDialog": "695981401",
            "dialogues": [
                {
                    "id": "695981401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959815",
            "initDialog": "695981501",
            "dialogues": [
                {
                    "id": "695981501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959816",
            "initDialog": "695981601",
            "dialogues": [
                {
                    "id": "695981601",
                    "speaker": "嘉明",
                    "text": "嘿嘿，失礼失礼，这局我的牌运太红火啦。"
                }
            ]
        },
        {
            "talkId": "6959817",
            "initDialog": "695981701",
            "dialogues": [
                {
                    "id": "695981701",
                    "speaker": "嘉明",
                    "text": "这…怎么…唉，是我急了，忙中出错啊…"
                }
            ]
        },
        {
            "talkId": "6959818",
            "initDialog": "695981801",
            "dialogues": [
                {
                    "id": "695981801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}