{
    "groupId": "1750",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "奥多夫": 9
    },
    "talks": [
        {
            "talkId": "6175001",
            "initDialog": "617500101",
            "dialogues": [
                {
                    "id": "617500101",
                    "speaker": "奥多夫",
                    "text": "嗯，啤酒还是蒙德的好啊，至冬那边的啤酒味道还是不如蒙德…"
                }
            ]
        },
        {
            "talkId": "6175002",
            "initDialog": "617500201",
            "dialogues": [
                {
                    "id": "617500201",
                    "speaker": "Player",
                    "text": "至冬那边怎么样？"
                },
                {
                    "id": "617500202",
                    "speaker": "奥多夫",
                    "text": "很冷，要冻死人的那种冷…一些没有铁路的路线，还是得请至冬当地的人或者妖精做向导。"
                },
                {
                    "id": "617500203",
                    "speaker": "奥多夫",
                    "text": "真是羡慕，啊呀，有些妖精倒…毛绒得很…不用穿得那么暖和。"
                }
            ]
        },
        {
            "talkId": "6175003",
            "initDialog": "617500301",
            "dialogues": [
                {
                    "id": "617500301",
                    "speaker": "Player",
                    "text": "关于温斯洛…"
                },
                {
                    "id": "617500302",
                    "speaker": "奥多夫",
                    "text": "恕我直言，我们本地人一直都不是很喜欢他，但是也没到讨厌的程度…"
                },
                {
                    "id": "617500303",
                    "speaker": "奥多夫",
                    "text": "只不过，骑士团的事不一样，我小的时候就想加入骑士团来着，后来是接了自家老爹商会的摊子，去不成了…"
                },
                {
                    "id": "617500304",
                    "speaker": "奥多夫",
                    "text": "那些骑士抗击深渊，倒在那底下的遗迹里，都是英雄，英雄不该受到那样的对待。"
                },
                {
                    "id": "617500305",
                    "speaker": "奥多夫",
                    "text": "要说看到他因为「幽灵作祟」的事瑟瑟发抖我不觉得爽快，那也是假话，但是，正常人不该变成那样…"
                },
                {
                    "id": "617500306",
                    "speaker": "奥多夫",
                    "text": "不过最近…他变得稍微好说话了一点，有的时候也会来找我们商量一些事了，这应该也算是歪打正着吧。"
                }
            ]
        },
        {
            "talkId": "6175004",
            "initDialog": "617500401",
            "dialogues": [
                {
                    "id": "617500401",
                    "speaker": "Player",
                    "text": "再见，你继续喝吧…"
                },
                {
                    "id": "617500402",
                    "speaker": "奥多夫",
                    "text": "好的，朋友…"
                }
            ]
        }
    ]
}