{
    "groupId": "7598",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "杜斯塔娅": 8
    },
    "talks": [
        {
            "talkId": "6759801",
            "initDialog": "675980101",
            "dialogues": [
                {
                    "id": "675980101",
                    "speaker": "杜斯塔娅",
                    "text": "欢迎光临！想吃点什么，喝点什么？尽管点吧！"
                }
            ]
        },
        {
            "talkId": "6759802",
            "initDialog": "675980201",
            "dialogues": [
                {
                    "id": "675980201",
                    "speaker": "Player",
                    "text": "想看看菜谱…"
                },
                {
                    "id": "675980202",
                    "speaker": "杜斯塔娅",
                    "text": "没问题，请您看这边——"
                }
            ]
        },
        {
            "talkId": "6759803",
            "initDialog": "675980301",
            "dialogues": [
                {
                    "id": "675980301",
                    "speaker": "Player",
                    "text": "这餐厅看着确实不错…"
                },
                {
                    "id": "675980302",
                    "speaker": "杜斯塔娅",
                    "text": "那当然了，这可是沃雅妮莎小姐，奥黛塔小姐和阿罗夏先生和…"
                },
                {
                    "id": "675980303",
                    "speaker": "杜斯塔娅",
                    "text": "#…啊！您、您是{NICKNAME}，对吧？沃雅妮莎小姐对我提起过你。"
                },
                {
                    "id": "675980304",
                    "speaker": "杜斯塔娅",
                    "text": "她说您的审美品味很棒，人也非常好，这间餐厅能看起来多亏了您帮忙呢。"
                }
            ]
        },
        {
            "talkId": "6759804",
            "initDialog": "675980401",
            "dialogues": [
                {
                    "id": "675980401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675980402",
                    "speaker": "杜斯塔娅",
                    "text": "再见。期待您的下次光临——"
                }
            ]
        },
        {
            "talkId": "6759805",
            "initDialog": "675980501",
            "dialogues": [
                {
                    "id": "675980501",
                    "speaker": "Player",
                    "text": "没有没有，也没有那么厉害——"
                },
                {
                    "id": "675980502",
                    "speaker": "杜斯塔娅",
                    "text": "您真谦虚！这也是沃雅妮莎小姐告诉我的，果然和她说的一模一样。"
                },
                {
                    "id": "675980503",
                    "speaker": "杜斯塔娅",
                    "text": "您来这边是想点东西吃么？如果想的话，就请看看菜单吧，我绝对会用最好的食材的！"
                }
            ]
        }
    ]
}