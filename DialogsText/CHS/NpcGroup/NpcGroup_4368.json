{
    "groupId": "4368",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "哈瓦德": 14
    },
    "talks": [
        {
            "talkId": "6436801",
            "initDialog": "643680101",
            "dialogues": [
                {
                    "id": "643680101",
                    "speaker": "哈瓦德",
                    "text": "呼…等做完这趟生意，先在驿站附近休息一阵吧。"
                },
                {
                    "id": "643680102",
                    "speaker": "哈瓦德",
                    "text": "可惜见不到那束花朵了…"
                }
            ]
        },
        {
            "talkId": "6436802",
            "initDialog": "643680201",
            "dialogues": [
                {
                    "id": "643680201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "643680202",
                    "speaker": "哈瓦德",
                    "text": "你好，我是专门经营沙漠特产的行商。只是不巧，这次带来的货物数量不多，已经都被人订走了。"
                },
                {
                    "id": "643680203",
                    "speaker": "哈瓦德",
                    "text": "不过客人要是有兴趣的话，可以先了解一下。"
                }
            ]
        },
        {
            "talkId": "6436803",
            "initDialog": "643680301",
            "dialogues": [
                {
                    "id": "643680301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643680302",
                    "speaker": "哈瓦德",
                    "text": "再见啦。"
                }
            ]
        },
        {
            "talkId": "6436804",
            "initDialog": "643680401",
            "dialogues": [
                {
                    "id": "643680401",
                    "speaker": "Player",
                    "text": "哪些卖得比较好？"
                },
                {
                    "id": "643680402",
                    "speaker": "哈瓦德",
                    "text": "最近需求量最大的应该就是枣椰了。"
                },
                {
                    "id": "643680403",
                    "speaker": "哈瓦德",
                    "text": "枣椰是以前沙漠人种植的常见作物，因为含糖量高，拿来做甜点或者糖果都很不错。"
                },
                {
                    "id": "643680404",
                    "speaker": "哈瓦德",
                    "text": "吃甜食就是能让人心情愉快呀，也难怪大家都喜欢。"
                },
                {
                    "id": "643680405",
                    "speaker": "哈瓦德",
                    "text": "听说还有教令院的人专门研究什么样的光照能种出更甜的枣椰，真令人期待。"
                }
            ]
        },
        {
            "talkId": "6436805",
            "initDialog": "643680501",
            "dialogues": [
                {
                    "id": "643680501",
                    "speaker": "Player",
                    "text": "花朵？"
                },
                {
                    "id": "643680502",
                    "speaker": "哈瓦德",
                    "text": "啊…是在说这里的一个女孩子啦，她就是这里的花朵。我只要远远看着她的笑容，就会被治愈。"
                },
                {
                    "id": "643680503",
                    "speaker": "哈瓦德",
                    "text": "只不过听说她去了须弥城里，找她的恋人去了。"
                },
                {
                    "id": "643680504",
                    "speaker": "哈瓦德",
                    "text": "可惜…我都不知道她的姓名…"
                }
            ]
        },
        {
            "talkId": "6436806",
            "initDialog": "643680601",
            "dialogues": [
                {
                    "id": "643680601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6436807",
            "initDialog": "643680701",
            "dialogues": [
                {
                    "id": "643680701",
                    "speaker": "哈瓦德",
                    "text": "我赢了？这…该说什么好呢？多…多谢客人没拿出全力？"
                }
            ]
        },
        {
            "talkId": "6436808",
            "initDialog": "643680801",
            "dialogues": [
                {
                    "id": "643680801",
                    "speaker": "哈瓦德",
                    "text": "客人你好厉害！如果我也有你的牌技，和别人聊生意都更有底气！"
                }
            ]
        }
    ]
}