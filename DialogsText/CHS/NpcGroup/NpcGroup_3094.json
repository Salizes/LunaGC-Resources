{
    "groupId": "3094",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 7,
        "今谷三郎": 18
    },
    "talks": [
        {
            "talkId": "6309401",
            "initDialog": "630940101",
            "dialogues": [
                {
                    "id": "630940101",
                    "speaker": "今谷三郎",
                    "text": "你们好啊，是来村子里做客的吗？"
                }
            ]
        },
        {
            "talkId": "6309402",
            "initDialog": "630940201",
            "dialogues": [
                {
                    "id": "630940201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "630940202",
                    "speaker": "今谷三郎",
                    "text": "看你的样子，是外面来的人吧。外人就是客，不着急的话，就在我这里喝喝茶，歇歇脚。"
                },
                {
                    "id": "630940203",
                    "speaker": "今谷三郎",
                    "text": "绀田村是个很好的地方，环境优美，又比较安静，很适合居住。"
                },
                {
                    "id": "630940204",
                    "speaker": "今谷三郎",
                    "text": "我和老婆子都在这里住了几十年了，还是很喜欢这里啊。"
                }
            ]
        },
        {
            "talkId": "6309403",
            "initDialog": "630940301",
            "dialogues": [
                {
                    "id": "630940301",
                    "speaker": "Player",
                    "text": "确实是个好地方。"
                },
                {
                    "id": "630940302",
                    "speaker": "今谷三郎",
                    "text": "是啊，当年和老婆子旅行到这里，一眼就相中了这个地方，从此住了下来。"
                },
                {
                    "id": "630940303",
                    "speaker": "今谷三郎",
                    "text": "种果子，养花，织布，日子过得很安宁，完全不会单调。有了孩子之后，就更热闹啦。"
                },
                {
                    "id": "630940304",
                    "speaker": "今谷三郎",
                    "text": "听起来有点随性，对吧？但随性也没什么不好，不是说一定要四处奔走，匆匆忙忙，才算过了充实的一辈子啊。"
                }
            ]
        },
        {
            "talkId": "6309404",
            "initDialog": "630940401",
            "dialogues": [
                {
                    "id": "630940401",
                    "speaker": "Player",
                    "text": "听过最近的怪事吗？"
                },
                {
                    "id": "630940402",
                    "speaker": "今谷三郎",
                    "text": "好像是听到有人在讨论怪谈之类的传闻，不过我对这样的话题一直都不太关心，所以也不知道什么有用的东西。"
                },
                {
                    "id": "630940403",
                    "speaker": "今谷三郎",
                    "text": "有时候啊，事情不是知道得越多就越好。消息越多，烦恼就越多，烦恼一多，就没办法开开心心的了…"
                }
            ]
        },
        {
            "talkId": "6309405",
            "initDialog": "630940501",
            "dialogues": [
                {
                    "id": "630940501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630940502",
                    "speaker": "今谷三郎",
                    "text": "多来看看吧，这儿是个好地方。"
                }
            ]
        },
        {
            "talkId": "6309406",
            "initDialog": "630940601",
            "dialogues": [
                {
                    "id": "630940601",
                    "speaker": "今谷三郎",
                    "text": "哎，这不是宵宫的朋友嘛，快进来坐坐！"
                }
            ]
        },
        {
            "talkId": "6309407",
            "initDialog": "630940701",
            "dialogues": [
                {
                    "id": "630940701",
                    "speaker": "Player",
                    "text": "来看望你了。"
                },
                {
                    "id": "630940702",
                    "speaker": "今谷三郎",
                    "text": "谢谢，谢谢啊，没想到你还能想着我。"
                },
                {
                    "id": "630940703",
                    "speaker": "今谷三郎",
                    "text": "家里正好有些点心，一起吃吧，是宵宫那孩子之前送过来的。"
                },
                {
                    "id": "630940704",
                    "speaker": "今谷三郎",
                    "text": "送了好多好多，我和老婆子根本吃不完。"
                }
            ]
        },
        {
            "talkId": "6309408",
            "initDialog": "630940801",
            "dialogues": [
                {
                    "id": "630940801",
                    "speaker": "Player",
                    "text": "佳祐最近怎么样？"
                },
                {
                    "id": "630940802",
                    "speaker": "今谷三郎",
                    "text": "他回来了一趟，告诉我们他和朔次郎的矛盾终于解决了。但怎么解决的，朔次郎去了哪里，他没有细说。"
                },
                {
                    "id": "630940803",
                    "speaker": "今谷三郎",
                    "text": "无论如何，解决了就好吧，我和老婆子，真心为他高兴。"
                },
                {
                    "id": "630940804",
                    "speaker": "今谷三郎",
                    "text": "其他东西失去了都可以找回来，童年的友情就只有那么一段，丢掉了就回不来了。"
                }
            ]
        },
        {
            "talkId": "6309409",
            "initDialog": "630940901",
            "dialogues": [
                {
                    "id": "630940901",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630940902",
                    "speaker": "今谷三郎",
                    "text": "一路顺风，要开开心心的啊。"
                }
            ]
        }
    ]
}