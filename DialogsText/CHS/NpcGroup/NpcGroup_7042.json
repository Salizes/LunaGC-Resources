{
    "groupId": "7042",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "佩彻娜": 10
    },
    "talks": [
        {
            "talkId": "6704201",
            "initDialog": "670420101",
            "dialogues": [
                {
                    "id": "670420101",
                    "speaker": "佩彻娜",
                    "text": "这本之前看过吗…唔，想不起来了。"
                }
            ]
        },
        {
            "talkId": "6704202",
            "initDialog": "670420201",
            "dialogues": [
                {
                    "id": "670420201",
                    "speaker": "Player",
                    "text": "你在看什么？"
                },
                {
                    "id": "670420202",
                    "speaker": "佩彻娜",
                    "text": "呃…书？我看不懂太难的书，就看些娱乐小说，故事情节精彩的那种。"
                },
                {
                    "id": "670420203",
                    "speaker": "佩彻娜",
                    "text": "不过新书我已经看得差不多了，在想要不要找点老书看看。"
                }
            ]
        },
        {
            "talkId": "6704203",
            "initDialog": "670420301",
            "dialogues": [
                {
                    "id": "670420301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "670420302",
                    "speaker": "佩彻娜",
                    "text": "嗯？啊，没关系。"
                }
            ]
        },
        {
            "talkId": "6704204",
            "initDialog": "670420401",
            "dialogues": [
                {
                    "id": "670420401",
                    "speaker": "Player",
                    "text": "有什么推荐的书吗？"
                },
                {
                    "id": "670420402",
                    "speaker": "佩彻娜",
                    "text": "推荐…抱歉，其实我不太知道好坏，也记不清书里的情节了。只是打发时间，没有很认真地看。"
                },
                {
                    "id": "670420403",
                    "speaker": "佩彻娜",
                    "text": "一定要说的话…那就《大盗雷德·米勒传奇》吧，老板说这本卖得最好。"
                },
                {
                    "id": "670420404",
                    "speaker": "佩彻娜",
                    "text": "既然卖得最好，如果它不是最烂的那本，应该就是还值得一看吧。"
                }
            ]
        },
        {
            "talkId": "6704205",
            "initDialog": "670420501",
            "dialogues": [
                {
                    "id": "670420501",
                    "speaker": "佩彻娜",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6704206",
            "initDialog": "670420601",
            "dialogues": [
                {
                    "id": "670420601",
                    "speaker": "佩彻娜",
                    "text": "嗯？我赢了？啊，谢谢你。"
                }
            ]
        },
        {
            "talkId": "6704207",
            "initDialog": "670420701",
            "dialogues": [
                {
                    "id": "670420701",
                    "speaker": "佩彻娜",
                    "text": "我输了，看来书里的情节果然不能当真呢…"
                }
            ]
        }
    ]
}