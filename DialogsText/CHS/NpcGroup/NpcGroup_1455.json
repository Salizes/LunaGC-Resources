            "dialogues": [
                {
                    "id": "614550101",
                    "speaker": "诺玛",
                    "text": "嗯？怎么啦？"
                }
            ]
        },
        {
            "talkId": "6145502",
            "initDialog": "614550201",
            "dialogues": [
                {
                    "id": "614550201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "614550202",
                    "speaker": "诺玛",
                    "text": "嗯？我正准备去买些吃的。"
                },
                {
                    "id": "614550203",
                    "speaker": "诺玛",
                    "text": "不是食材，而是准备打包些菜肴回家，反正老公他早就吃腻了我做的菜了吧…"
                },
                {
                    "id": "614550204",
                    "speaker": "诺玛",
                    "text": "你是旅行者吗？真好啊…"
                },
                {
                    "id": "614550205",
                    "speaker": "诺玛",
                    "text": "听说璃月那边的饭菜，花样多到要分好几个菜系呢…"
                },
                {
                    "id": "614550206",
                    "speaker": "诺玛",
                    "text": "有空真想去那边旅游一次啊。"
                }
            ]
        },
        {
            "talkId": "6145503",
            "initDialog": "614550301",
            "dialogues": [
                {
                    "id": "614550301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "614550302",
                    "speaker": "诺玛",
                    "text": "嗯，拜拜。"
                }
            ]
        }
    ]
