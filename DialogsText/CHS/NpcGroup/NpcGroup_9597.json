{
    "groupId": "9597",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "爱可菲": 10
    },
    "talks": [
        {
            "talkId": "6959701",
            "initDialog": "695970101",
            "dialogues": [
                {
                    "id": "695970101",
                    "speaker": "爱可菲",
                    "text": "原来「七圣召唤」真的这么火…唔，这么一想，能不能把「七圣召唤」的主题蛋糕做成一个系列呢，每一种蛋糕，对应一组卡牌…"
                }
            ]
        },
        {
            "talkId": "6959702",
            "initDialog": "695970201",
            "dialogues": [
                {
                    "id": "695970201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959703",
            "initDialog": "695970301",
            "dialogues": [
                {
                    "id": "695970301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695970302",
                    "speaker": "爱可菲",
                    "text": "要走了？我再取一会材，等会再离开…什么材？多买几张牌，有几张的牌面还挺好看的。"
                }
            ]
        },
        {
            "talkId": "6959704",
            "initDialog": "695970401",
            "dialogues": [
                {
                    "id": "695970401",
                    "speaker": "爱可菲",
                    "text": "这场对局不错啊…对了，最近又有人找我订做「七圣召唤」的主题蛋糕了，但他指定的那张卡牌我没收藏，你有的话，借我看看？"
                }
            ]
        },
        {
            "talkId": "6959705",
            "initDialog": "695970501",
            "dialogues": [
                {
                    "id": "695970501",
                    "speaker": "爱可菲",
                    "text": "输掉了…看来以后要多练练才行。嗯…找谁去练一下呢，后厨的学生们？不行不行，不能让她们再分心了…"
                }
            ]
        },
        {
            "talkId": "6959706",
            "initDialog": "695970601",
            "dialogues": [
                {
                    "id": "695970601",
                    "speaker": "爱可菲",
                    "text": "要打「七圣召唤」，好啊，我对它也…算是有一点了解。"
                }
            ]
        },
        {
            "talkId": "6959708",
            "initDialog": "695970801",
            "dialogues": [
                {
                    "id": "695970801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959709",
            "initDialog": "695970901",
            "dialogues": [
                {
                    "id": "695970901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959710",
            "initDialog": "695971001",
            "dialogues": [
                {
                    "id": "695971001",
                    "speaker": "爱可菲",
                    "text": "赢了，轻轻松松，看来之前看过的对局示例，还算有用嘛。"
                }
            ]
        },
        {
            "talkId": "6959711",
            "initDialog": "695971101",
            "dialogues": [
                {
                    "id": "695971101",
                    "speaker": "爱可菲",
                    "text": "果然不能光看对局示例啊…遇见题外招都不知道怎么应对了。"
                }
            ]
        },
        {
            "talkId": "6959712",
            "initDialog": "695971201",
            "dialogues": [
                {
                    "id": "695971201",
                    "speaker": "爱可菲",
                    "text": "我之前为了给人做蛋糕，还特意去了解过「七圣召唤」…结果？至少客人还挺喜欢那一份蛋糕的。"
                }
            ]
        },
        {
            "talkId": "6959714",
            "initDialog": "695971401",
            "dialogues": [
                {
                    "id": "695971401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959715",
            "initDialog": "695971501",
            "dialogues": [
                {
                    "id": "695971501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959716",
            "initDialog": "695971601",
            "dialogues": [
                {
                    "id": "695971601",
                    "speaker": "爱可菲",
                    "text": "嗯，看来之前的练习没白练。为什么练习？当然是为了做蛋糕了。"
                }
            ]
        },
        {
            "talkId": "6959717",
            "initDialog": "695971701",
            "dialogues": [
                {
                    "id": "695971701",
                    "speaker": "爱可菲",
                    "text": "…咳，看来我体验的…还是有点不足啊。"
                }
            ]
        },
        {
            "talkId": "6959718",
            "initDialog": "695971801",
            "dialogues": [
                {
                    "id": "695971801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}