{
    "groupId": "9121",
    "total_dialogue_lines": 67,
    "speaker_counts": {
        "Player": 20,
        "爱诺": 47
    },
    "talks": [
        {
            "talkId": "6912101",
            "initDialog": "691210101",
            "dialogues": [
                {
                    "id": "691210101",
                    "speaker": "爱诺",
                    "text": "#{NICKNAME}！原来你也有一个大工坊呀！你的主营业务是什么呢？"
                },
                {
                    "id": "691210102",
                    "speaker": "爱诺",
                    "text": "不急着告诉我，在那之前，还要先谢谢你愿意带我来玩。"
                }
            ]
        },
        {
            "talkId": "6912102",
            "initDialog": "691210201",
            "dialogues": [
                {
                    "id": "691210201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "691210202",
                    "speaker": "爱诺",
                    "text": "嗯…刚刚阿圆陪我聊了一会儿天。"
                },
                {
                    "id": "691210203",
                    "speaker": "爱诺",
                    "text": "她的全名比「轰隆隆月矩力能量炮」难记多了，「真君」什么的，我也不是很理解其中的意思。"
                },
                {
                    "id": "691210204",
                    "speaker": "Player",
                    "text": "她是璃月仙人的一员。"
                },
                {
                    "id": "691210205",
                    "speaker": "爱诺",
                    "text": "啊…总之是那种用科学和机械原理解释不清的群体对吧？"
                },
                {
                    "id": "691210206",
                    "speaker": "爱诺",
                    "text": "没想到一离开挪德卡莱，这样的情况反倒更多了啊。"
                },
                {
                    "id": "691210207",
                    "speaker": "爱诺",
                    "text": "我听她说，在这里造东西很容易，有图纸就行。"
                },
                {
                    "id": "691210208",
                    "speaker": "爱诺",
                    "text": "于是我翻出下一件打算制作的大型机械设计图，拿出我随身带的工具和零件，刚准备开工…她却说用不上这些。"
                },
                {
                    "id": "691210209",
                    "speaker": "Player",
                    "text": "的确是要靠仙术…"
                },
                {
                    "id": "691210210",
                    "speaker": "爱诺",
                    "text": "所以啊，说是说容易，但其实完全不是我擅长的领域！根本就没有发挥空间嘛…",
                    "choices": [
                        {
                            "id": "691210211",
                            "text": "没事，爱诺来提要求就好。",
                            "response": [
                                {
                                    "id": "691210213",
                                    "speaker": "爱诺",
                                    "text": "唉…好吧！"
                                },
                                {
                                    "id": "691210214",
                                    "speaker": "爱诺",
                                    "text": "虽然还是有一点点不甘心，但毕竟在这里我才是客人，得遵守做客时的礼仪…"
                                },
                                {
                                    "id": "691210215",
                                    "speaker": "爱诺",
                                    "text": "那…就麻烦你先造一台蛋卷机？"
                                },
                                {
                                    "id": "691210216",
                                    "speaker": "爱诺",
                                    "text": "至少我们可以先吃起来！"
                                }
                            ]
                        },
                        {
                            "id": "691210212",
                            "text": "制作就交给我来吧。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912103",
            "initDialog": "691210301",
            "dialogues": [
                {
                    "id": "691210301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "691210302",
                    "speaker": "爱诺",
                    "text": "好呀。不过…你能一起帮我找找看我的精密机械用六角螺母吗？"
                },
                {
                    "id": "691210303",
                    "speaker": "Player",
                    "text": "上次见到时在哪里？"
                },
                {
                    "id": "691210304",
                    "speaker": "爱诺",
                    "text": "嘿嘿…记不得了。"
                },
                {
                    "id": "691210305",
                    "speaker": "Player",
                    "text": "上回用是什么时候？"
                },
                {
                    "id": "691210306",
                    "speaker": "爱诺",
                    "text": "几小时？半天前？还是一天来着…我的时间概念没有那么清楚啦，一旦忙碌起来，就没有余力观察天色了嘛。"
                },
                {
                    "id": "691210307",
                    "speaker": "Player",
                    "text": "以前是怎么解决的？"
                },
                {
                    "id": "691210308",
                    "speaker": "爱诺",
                    "text": "嗯…找不到东西，或者不小心弄乱房间了之后，我会习惯性地喊一声：伊涅芙——"
                },
                {
                    "id": "691210309",
                    "speaker": "爱诺",
                    "text": "虽然很有可能会被伊涅芙数落，但更有可能得到有效解决！"
                },
                {
                    "id": "691210310",
                    "speaker": "爱诺",
                    "text": "对了！你身边没有人帮忙，你是怎么避免这些问题出现的呢？",
                    "choices": [
                        {
                            "id": "691210311",
                            "text": "我会花一些时间打理…",
                            "response": [
                                {
                                    "id": "691210313",
                                    "speaker": "爱诺",
                                    "text": "可是我在机械制作上已经花了很多时间…如果还要为收拾东西花额外时间的话，还哪里有时间吃点心呢？",
                                    "choices": [
                                        {
                                            "id": "691210314",
                                            "text": "原来问题是出在点心上…",
                                            "response": [
                                                {
                                                    "id": "691210316",
                                                    "speaker": "爱诺",
                                                    "text": "欸？！不行呀！你要和爱诺统一战线！我们可是点心同盟！"
                                                },
                                                {
                                                    "id": "691210317",
                                                    "speaker": "爱诺",
                                                    "text": "你一定是太久没吃到香香脆脆的饼干，忘记了它的滋味。正好我带着多的，我来分给…"
                                                },
                                                {
                                                    "id": "691210318",
                                                    "speaker": "爱诺",
                                                    "text": "欸！我的六角螺母！原来是藏在袖子里了！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "691210315",
                                            "text": "突然更加理解伊涅芙了…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "691210312",
                            "text": "养成习惯就还好…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912104",
            "initDialog": "691210401",
            "dialogues": [
                {
                    "id": "691210401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "691210402",
                    "speaker": "爱诺",
                    "text": "嗯…我想帮你改造那台蛋卷机的外观！"
                },
                {
                    "id": "691210403",
                    "speaker": "爱诺",
                    "text": "现在它的出品很标准，但我还想让它变得再特别一点。"
                },
                {
                    "id": "691210404",
                    "speaker": "爱诺",
                    "text": "你喜欢什么形状的？机器人？或者小鸭子会不会更可爱一点？"
                },
                {
                    "id": "691210405",
                    "speaker": "爱诺",
                    "text": "#名字我倒是想好大概的了！就叫咯吱咔啦{NICKNAME}专用款蛋卷机！"
                },
                {
                    "id": "691210406",
                    "speaker": "Player",
                    "text": "机器人模样的是？"
                },
                {
                    "id": "691210407",
                    "speaker": "爱诺",
                    "text": "由机械臂负责操作，在胸口装载上烤箱。"
                },
                {
                    "id": "691210408",
                    "speaker": "爱诺",
                    "text": "等一阵咯吱咔啦声响起后，蛋卷就会从胸口烤箱里弹出来了，嘴里还会吹出糖霜！"
                },
                {
                    "id": "691210409",
                    "speaker": "Player",
                    "text": "那小鸭子形状的呢？"
                },
                {
                    "id": "691210410",
                    "speaker": "爱诺",
                    "text": "在鸭背上放入原料，按一按小鸭子翅膀上的开关。"
                },
                {
                    "id": "691210411",
                    "speaker": "爱诺",
                    "text": "等一阵咯吱咔啦声响起后…锵锵！就能从鸭嘴里拿到它含着的蛋卷了！拿完一卷自动接上下一卷！",
                    "choices": [
                        {
                            "id": "691210412",
                            "text": "感觉都不错啊…",
                            "response": [
                                {
                                    "id": "691210413",
                                    "speaker": "爱诺",
                                    "text": "犹豫的话，不如两个全做了吧！"
                                },
                                {
                                    "id": "691210414",
                                    "speaker": "爱诺",
                                    "text": "反正结构和原理都不算很复杂，有了想法之后，实现它的过程对于爱诺来说小菜一碟。"
                                },
                                {
                                    "id": "691210418",
                                    "speaker": "爱诺",
                                    "text": "可惜这台蛋卷机拆不出对我有用的材料，还是得回一趟家找点东西…"
                                },
                                {
                                    "id": "691210419",
                                    "speaker": "爱诺",
                                    "text": "我马上就回来！说话算话的，你一定要等我哦！"
                                }
                            ]
                        },
                        {
                            "id": "691210415",
                            "text": "哇，真好玩！",
                            "response": [
                                {
                                    "id": "691210416",
                                    "speaker": "爱诺",
                                    "text": "是吧是吧，我就知道你肯定会欣赏的！"
                                },
                                {
                                    "id": "691210417",
                                    "speaker": "爱诺",
                                    "text": "那我两个都做出来送给你好了！机械也需要有懂它的人陪伴才行。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6912105",
            "initDialog": "691210501",
            "dialogues": [
                {
                    "id": "691210501",
                    "speaker": "Player",
                    "text": "早啊，爱诺。"
                },
                {
                    "id": "691210502",
                    "speaker": "爱诺",
                    "text": "#早，伊涅…欸？{NICKNAME}！"
                },
                {
                    "id": "691210503",
                    "speaker": "爱诺",
                    "text": "嘿嘿，你一大早来找我，是来陪我玩的吗？"
                }
            ]
        },
        {
            "talkId": "6912106",
            "initDialog": "691210601",
            "dialogues": [
                {
                    "id": "691210601",
                    "speaker": "Player",
                    "text": "晚安，爱诺。"
                },
                {
                    "id": "691210602",
                    "speaker": "爱诺",
                    "text": "欸？这么快就到该说晚安的时间了吗？我还想和你多玩一会儿呢！"
                },
                {
                    "id": "691210603",
                    "speaker": "爱诺",
                    "text": "#好吧，晚安，{NICKNAME}。明天记得要早点来陪我哦！"
                }
            ]
        },
        {
            "talkId": "6912110",
            "initDialog": "691211001",
            "dialogues": [
                {
                    "id": "691211001",
                    "speaker": "爱诺",
                    "text": "哇…这熟悉的椅子和地毯，真不错！但是呢，还缺了一点点。"
                },
                {
                    "id": "691211002",
                    "speaker": "爱诺",
                    "text": "猜到了吗？没错，就是缺了爱诺呀！嘿嘿。"
                },
                {
                    "id": "691211003",
                    "speaker": "爱诺",
                    "text": "所以为了让你的作品变得完美，我会经常来这里。你要记得陪我玩哦！"
                }
            ]
        },
        {
            "talkId": "6912111",
            "initDialog": "691211101",
            "dialogues": [
                {
                    "id": "691211101",
                    "speaker": "爱诺",
                    "text": "你也喜欢用铁皮搭建东西吗？喔！这里有片空着的墙…"
                },
                {
                    "id": "691211102",
                    "speaker": "爱诺",
                    "text": "要不我来画个涂鸦？就画你、我，还有伊涅芙手拉手好了！"
                },
                {
                    "id": "691211103",
                    "speaker": "爱诺",
                    "text": "嘿嘿，那样就更像叮铃哐啷蛋卷工坊的风格了。"
                }
            ]
        }
    ]
}