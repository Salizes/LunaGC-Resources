{
    "groupId": "1430",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 7,
        "葛瑞丝": 20
    },
    "talks": [
        {
            "talkId": "7090701",
            "initDialog": "709070101",
            "dialogues": [
                {
                    "id": "709070101",
                    "speaker": "Player",
                    "text": "关于不安的气息…"
                },
                {
                    "id": "709070102",
                    "speaker": "葛瑞丝",
                    "text": "无论是因为什么原因，我们能做的也就只有祈祷了。"
                },
                {
                    "id": "709070103",
                    "speaker": "葛瑞丝",
                    "text": "我最近托冒险家帮忙采集了一些塞西莉亚花，想要分发给大家…"
                },
                {
                    "id": "709070104",
                    "speaker": "葛瑞丝",
                    "text": "这种花生长在山崖之上，长期与蒙德的风为伴…"
                },
                {
                    "id": "709070105",
                    "speaker": "葛瑞丝",
                    "text": "…这散发着巴巴托斯大人气息的花朵，或许能为大家带来些许安心…"
                },
                {
                    "id": "709070106",
                    "speaker": "葛瑞丝",
                    "text": "你也拿一些吧，愿巴巴托斯大人护佑蒙德。"
                }
            ]
        },
        {
            "talkId": "40169",
            "initDialog": "4015143001",
            "dialogues": [
                {
                    "id": "4015143001",
                    "speaker": "葛瑞丝",
                    "text": "您好，想要向巴巴托斯大人祈祷的话，在这里就可以了。"
                }
            ]
        },
        {
            "talkId": "41719",
            "initDialog": "4015142903",
            "dialogues": [
                {
                    "id": "4015142903",
                    "speaker": "Player",
                    "text": "关于巴巴托斯。"
                },
                {
                    "id": "4015142908",
                    "speaker": "葛瑞丝",
                    "text": "巴巴托斯大人是一位很温柔的神。"
                },
                {
                    "id": "4015142909",
                    "speaker": "葛瑞丝",
                    "text": "神明的风既能把快乐传播到全城，也能为伤心的人悄悄擦去泪水。"
                }
            ]
        },
        {
            "talkId": "41720",
            "initDialog": "4015142904",
            "dialogues": [
                {
                    "id": "4015142904",
                    "speaker": "Player",
                    "text": "关于向巴巴托斯祈祷。"
                },
                {
                    "id": "4015142910",
                    "speaker": "葛瑞丝",
                    "text": "想要向巴巴托斯大人祈祷的话，只要在起风的时候悄悄说出愿望…"
                },
                {
                    "id": "4015142911",
                    "speaker": "葛瑞丝",
                    "text": "风就会把你的愿望带给巴巴托斯大人了。"
                }
            ]
        },
        {
            "talkId": "6143001",
            "initDialog": "4015143002",
            "dialogues": [
                {
                    "id": "4015143002",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "4015143006",
                    "speaker": "葛瑞丝",
                    "text": "最近蒙德城的风里带上了不安的气息，所以我在向巴巴托斯大人祈祷。"
                },
                {
                    "id": "4015143007",
                    "speaker": "葛瑞丝",
                    "text": "请放心吧，巴巴托斯大人一定会帮助大家的。"
                }
            ]
        },
        {
            "talkId": "6143002",
            "initDialog": "4015143005",
            "dialogues": [
                {
                    "id": "4015143005",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "4015143012",
                    "speaker": "葛瑞丝",
                    "text": "再见，愿巴巴托斯大人温柔的风与您同在。"
                }
            ]
        },
        {
            "talkId": "6143003",
            "initDialog": "614300301",
            "dialogues": [
                {
                    "id": "614300301",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614300302",
                    "speaker": "葛瑞丝",
                    "text": "恐怕这就是大家内心不安的其中一个根源吧…"
                },
                {
                    "id": "614300303",
                    "speaker": "葛瑞丝",
                    "text": "我不是西风骑士团的骑士，所以能做的就只有对风祈祷。"
                },
                {
                    "id": "614300304",
                    "speaker": "葛瑞丝",
                    "text": "愿巴巴托斯大人护佑蒙德的子民…"
                }
            ]
        },
        {
            "talkId": "6143004",
            "initDialog": "614300401",
            "dialogues": [
                {
                    "id": "614300401",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614300402",
                    "speaker": "葛瑞丝",
                    "text": "巴巴托斯大人果然听到了我们的祈祷，蒙德城也平安无事了。"
                },
                {
                    "id": "614300403",
                    "speaker": "葛瑞丝",
                    "text": "虽说结束了，不过特瓦林造成的影响还会持续一段时间吧…"
                },
                {
                    "id": "614300404",
                    "speaker": "葛瑞丝",
                    "text": "不过我相信只要蒙德的风不停息，巴巴托斯大人就永远与我们在一起。"
                },
                {
                    "id": "614300405",
                    "speaker": "葛瑞丝",
                    "text": "…也许，巴巴托斯大人已经在我们身边了也说不定。"
                }
            ]
        }
    ]
}