{
    "groupId": "9064",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Player": 18,
        "云堇": 53
    },
    "talks": [
        {
            "talkId": "6906401",
            "initDialog": "690640101",
            "dialogues": [
                {
                    "id": "690640101",
                    "speaker": "云堇",
                    "text": "#{NICKNAME}，你来了呀。看你最近来去匆忙…"
                },
                {
                    "id": "690640102",
                    "speaker": "云堇",
                    "text": "要是能偶尔坐下来听戏饮茶，享受闲适的趣味，会更有益身心哦。"
                }
            ]
        },
        {
            "talkId": "6906402",
            "initDialog": "690640201",
            "dialogues": [
                {
                    "id": "690640201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690640202",
                    "speaker": "云堇",
                    "text": "放心。这里的一切布置得当，风景也好，住起来很舒服。"
                },
                {
                    "id": "690640203",
                    "speaker": "云堇",
                    "text": "我有个习惯，每天清晨都要找个空旷的地方，遛一遛嗓子。"
                },
                {
                    "id": "690640204",
                    "speaker": "云堇",
                    "text": "璃月港内，空旷无人的地方可不好找。但在这里就方便得多了。",
                    "choices": [
                        {
                            "id": "690640205",
                            "text": "「遛嗓子」？",
                            "response": [
                                {
                                    "id": "690640206",
                                    "speaker": "云堇",
                                    "text": "是呀，每天练声练气是我们这行的基本功。"
                                },
                                {
                                    "id": "690640207",
                                    "speaker": "云堇",
                                    "text": "一天不练，自己知道，三天不练，观众知道。基本功啊，是绝对不能怠慢的。"
                                },
                                {
                                    "id": "690640208",
                                    "speaker": "云堇",
                                    "text": "你看你，满脸写着「听起来好辛苦」，我可不这么觉得哦。"
                                },
                                {
                                    "id": "690640209",
                                    "speaker": "云堇",
                                    "text": "坚持做好每件小事，演好每个细节，才能将璃月戏中细腻优美的一面传达给观众。"
                                },
                                {
                                    "id": "690640210",
                                    "speaker": "云堇",
                                    "text": "做这些事，我向来是乐在其中。"
                                },
                                {
                                    "id": "690640215",
                                    "speaker": "Player",
                                    "text": "我明白了。"
                                },
                                {
                                    "id": "690640216",
                                    "speaker": "云堇",
                                    "text": "嗯，感谢理解，也谢谢你的关心。"
                                }
                            ]
                        },
                        {
                            "id": "690640211",
                            "text": "需要我陪你吗？",
                            "response": [
                                {
                                    "id": "690640212",
                                    "speaker": "云堇",
                                    "text": "真体贴啊，这份好意我心领了。"
                                },
                                {
                                    "id": "690640213",
                                    "speaker": "云堇",
                                    "text": "不过我练习起来，一会儿念一会儿唱，一会儿扮哭腔一会儿学笑声，起伏太大，别吓到你才好。"
                                },
                                {
                                    "id": "690640214",
                                    "speaker": "云堇",
                                    "text": "对你，我更想献上一台准备完全的演出。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906403",
            "initDialog": "690640301",
            "dialogues": [
                {
                    "id": "690640301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690640302",
                    "speaker": "云堇",
                    "text": "正合我意。我憋了许多问题，早就想向你请教了。",
                    "choices": [
                        {
                            "id": "690640303",
                            "text": "云堇太谦虚了。",
                            "response": [
                                {
                                    "id": "690640304",
                                    "speaker": "云堇",
                                    "text": "你走南闯北，见识比我广博得多。"
                                },
                                {
                                    "id": "690640305",
                                    "speaker": "云堇",
                                    "text": "向你请教，当然得抱有敬意。"
                                },
                                {
                                    "id": "690640309",
                                    "speaker": "云堇",
                                    "text": "咳咳…其实，我偶尔也想放下戏曲，找一段空闲日子远游各国。但戏社内事务繁忙，总是没有机会。"
                                },
                                {
                                    "id": "690640310",
                                    "speaker": "云堇",
                                    "text": "你去过那么多地方，一定十分了解各地风俗。能和我讲讲吗？"
                                },
                                {
                                    "id": "690640311",
                                    "speaker": "云堇",
                                    "text": "嗯…比方说，蒙德骑士们舞起剑来是什么样子，跟我们璃月的武师有何不同？"
                                },
                                {
                                    "id": "690640312",
                                    "speaker": "云堇",
                                    "text": "我还听说，稻妻制造的刀剑也很锋利，稻妻人又是如何铸剑的呢？",
                                    "choices": [
                                        {
                                            "id": "690640313",
                                            "text": "蒙德骑士擅长西风剑术…",
                                            "response": [
                                                {
                                                    "id": "690640314",
                                                    "speaker": "云堇",
                                                    "text": "像风一样的剑术？难道他们舞剑时能吹起风来？"
                                                },
                                                {
                                                    "id": "690640317",
                                                    "speaker": "云堇",
                                                    "text": "听你说这些真是太有意思了！"
                                                },
                                                {
                                                    "id": "690640318",
                                                    "speaker": "云堇",
                                                    "text": "好，回头我再多准备一些问题。"
                                                },
                                                {
                                                    "id": "690640319",
                                                    "speaker": "云堇",
                                                    "text": "当然啦，不会让你白白费时给我讲这些。回答问题的谢礼，我也会准备最高规格的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690640315",
                                            "text": "稻妻的师傅会用「玉钢」锻剑…",
                                            "response": [
                                                {
                                                    "id": "690640316",
                                                    "speaker": "云堇",
                                                    "text": "特殊的材料？难怪听说稻妻人在锻造兵器方面很有自信…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690640306",
                            "text": "云堇见外了。",
                            "response": [
                                {
                                    "id": "690640307",
                                    "speaker": "云堇",
                                    "text": "哈哈，你的这份幽默，是走南闯北时历练出来的吗？"
                                },
                                {
                                    "id": "690640308",
                                    "speaker": "云堇",
                                    "text": "那我也不拐弯抹角了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906404",
            "initDialog": "690640401",
            "dialogues": [
                {
                    "id": "690640401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690640402",
                    "speaker": "云堇",
                    "text": "说起来，有件事我一直记在心里。"
                },
                {
                    "id": "690640403",
                    "speaker": "云堇",
                    "text": "小时候，父亲给我讲过许多仙人传说。其中一则，说的是绝云间里有仙府。"
                },
                {
                    "id": "690640404",
                    "speaker": "Player",
                    "text": "仙府？"
                },
                {
                    "id": "690640405",
                    "speaker": "云堇",
                    "text": "没错。传说中仙人们能乘光倚电，奔入云霄，一直飞进那座仙府里去。"
                },
                {
                    "id": "690640406",
                    "speaker": "云堇",
                    "text": "「在那里，他们俯瞰山川河流，与天地同游，不知俗世红尘为何物。」"
                },
                {
                    "id": "690640407",
                    "speaker": "云堇",
                    "text": "每次说到这儿，父亲都会露出沉醉的表情。"
                },
                {
                    "id": "690640408",
                    "speaker": "云堇",
                    "text": "故事流传至今，谁也没见过传说中的仙府…"
                },
                {
                    "id": "690640409",
                    "speaker": "云堇",
                    "text": "但我总是念念不忘，好想去那里看一看。"
                },
                {
                    "id": "690640410",
                    "speaker": "云堇",
                    "text": "想到那里唱上一曲，请天地人神都听一听我们的声音。",
                    "choices": [
                        {
                            "id": "690640411",
                            "text": "我可能知道类似的地方。",
                            "response": [
                                {
                                    "id": "690640413",
                                    "speaker": "云堇",
                                    "text": "嗯？真的？"
                                },
                                {
                                    "id": "690640414",
                                    "speaker": "云堇",
                                    "text": "不不…你的话肯定不会有假。但…答案来得太突然，我还没想好到时候该唱什么，又要怎么打扮才好…",
                                    "choices": [
                                        {
                                            "id": "690640415",
                                            "text": "慢慢想也没关系。",
                                            "response": [
                                                {
                                                    "id": "690640417",
                                                    "speaker": "云堇",
                                                    "text": "多谢！实在是太感谢你了。"
                                                },
                                                {
                                                    "id": "690640418",
                                                    "speaker": "云堇",
                                                    "text": "……"
                                                },
                                                {
                                                    "id": "690640419",
                                                    "speaker": "云堇",
                                                    "text": "唔…好，我大概有想法了。这出戏，不如就唱你与仙家打交道的选段…"
                                                },
                                                {
                                                    "id": "690640420",
                                                    "speaker": "云堇",
                                                    "text": "至于行头，就想请你帮着参谋参谋。"
                                                },
                                                {
                                                    "id": "690640421",
                                                    "speaker": "Player",
                                                    "text": "一言为定。"
                                                },
                                                {
                                                    "id": "690640422",
                                                    "speaker": "云堇",
                                                    "text": "嗯，说好了。我从今天，啊…从现在就开始练习吧！一定要拿出最完美的成果。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690640416",
                                            "text": "想好再陪你一起去。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690640412",
                            "text": "如果是庆云顶上空的话…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906405",
            "initDialog": "690640501",
            "dialogues": [
                {
                    "id": "690640501",
                    "speaker": "Player",
                    "text": "早啊，云堇。"
                },
                {
                    "id": "690640502",
                    "speaker": "云堇",
                    "text": "早上好，你今天也要出远门吗？"
                },
                {
                    "id": "690640503",
                    "speaker": "云堇",
                    "text": "希望今天能有好天气，不下雨也不打雷，免得你赶路辛苦。"
                }
            ]
        },
        {
            "talkId": "6906406",
            "initDialog": "690640601",
            "dialogues": [
                {
                    "id": "690640601",
                    "speaker": "Player",
                    "text": "晚安，云堇。"
                },
                {
                    "id": "690640602",
                    "speaker": "云堇",
                    "text": "#嗯，{NICKNAME}，晚安，早点休息也好。"
                },
                {
                    "id": "690640603",
                    "speaker": "云堇",
                    "text": "夜市固然有趣…还是等明天再一起逛吧。"
                }
            ]
        },
        {
            "talkId": "6906407",
            "initDialog": "690640701",
            "dialogues": [
                {
                    "id": "690640701",
                    "speaker": "云堇",
                    "text": "你看这书斋的名字…「绯云文斋」。"
                },
                {
                    "id": "690640702",
                    "speaker": "云堇",
                    "text": "名字里都带云，我和它的关系真是不一般。"
                },
                {
                    "id": "690640703",
                    "speaker": "云堇",
                    "text": "哈哈，开个玩笑。这里桌案文玩一应俱全，非常合我心意。谢谢你。"
                }
            ]
        },
        {
            "talkId": "6906408",
            "initDialog": "690640801",
            "dialogues": [
                {
                    "id": "690640801",
                    "speaker": "云堇",
                    "text": "每次唱完戏散场之后，我都爱去夜市逛逛。"
                },
                {
                    "id": "690640802",
                    "speaker": "云堇",
                    "text": "这里的街道和璃月街巷有八九分相似，感觉就像还在璃月一样。"
                },
                {
                    "id": "690640803",
                    "speaker": "云堇",
                    "text": "今天晚上就和我一起在这里转转，怎么样？"
                }
            ]
        }
    ]
}