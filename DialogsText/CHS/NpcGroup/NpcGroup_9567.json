{
    "groupId": "9567",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "莱欧斯利": 10
    },
    "talks": [
        {
            "talkId": "6956701",
            "initDialog": "695670101",
            "dialogues": [
                {
                    "id": "695670101",
                    "speaker": "莱欧斯利",
                    "text": "我见过某些玩牌的地方会把窗户封上，不让一点光透进来，以此削弱客人对于时间流逝的感知，从而让他们玩个没完。这一家倒是没这么做，老板对自己的生意还挺有自信的。"
                }
            ]
        },
        {
            "talkId": "6956702",
            "initDialog": "695670201",
            "dialogues": [
                {
                    "id": "695670201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956703",
            "initDialog": "695670301",
            "dialogues": [
                {
                    "id": "695670301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695670302",
                    "speaker": "莱欧斯利",
                    "text": "嗯，过一会我也要走了。"
                }
            ]
        },
        {
            "talkId": "6956704",
            "initDialog": "695670401",
            "dialogues": [
                {
                    "id": "695670401",
                    "speaker": "莱欧斯利",
                    "text": "看来我准备得比你充足一点。什么准备？当然是阅读对局规则，查看过往对局经历…你以为是什么？"
                }
            ]
        },
        {
            "talkId": "6956705",
            "initDialog": "695670501",
            "dialogues": [
                {
                    "id": "695670501",
                    "speaker": "莱欧斯利",
                    "text": "赢得很有说服力，我相信你也没耍盘外招。但话又说回来，耍了花招却没被发现的话，也行。"
                }
            ]
        },
        {
            "talkId": "6956706",
            "initDialog": "695670601",
            "dialogues": [
                {
                    "id": "695670601",
                    "speaker": "莱欧斯利",
                    "text": "一定要现在吗？行吧。"
                }
            ]
        },
        {
            "talkId": "6956708",
            "initDialog": "695670801",
            "dialogues": [
                {
                    "id": "695670801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956709",
            "initDialog": "695670901",
            "dialogues": [
                {
                    "id": "695670901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956710",
            "initDialog": "695671001",
            "dialogues": [
                {
                    "id": "695671001",
                    "speaker": "莱欧斯利",
                    "text": "唔，用这套牌和你对局的确没错。我的判断还算准确。"
                }
            ]
        },
        {
            "talkId": "6956711",
            "initDialog": "695671101",
            "dialogues": [
                {
                    "id": "695671101",
                    "speaker": "莱欧斯利",
                    "text": "没做足准备，就贸然接受挑战，确实不太明智。"
                }
            ]
        },
        {
            "talkId": "6956712",
            "initDialog": "695671201",
            "dialogues": [
                {
                    "id": "695671201",
                    "speaker": "莱欧斯利",
                    "text": "要对局？来吧。我已经注意到你脸上必胜的表情了。"
                }
            ]
        },
        {
            "talkId": "6956714",
            "initDialog": "695671401",
            "dialogues": [
                {
                    "id": "695671401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956715",
            "initDialog": "695671501",
            "dialogues": [
                {
                    "id": "695671501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956716",
            "initDialog": "695671601",
            "dialogues": [
                {
                    "id": "695671601",
                    "speaker": "莱欧斯利",
                    "text": "这套牌还挺厉害的，我们交换牌组，再来一局？"
                }
            ]
        },
        {
            "talkId": "6956717",
            "initDialog": "695671701",
            "dialogues": [
                {
                    "id": "695671701",
                    "speaker": "莱欧斯利",
                    "text": "这些牌不太好配合啊。下次换几张。"
                }
            ]
        },
        {
            "talkId": "6956718",
            "initDialog": "695671801",
            "dialogues": [
                {
                    "id": "695671801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}