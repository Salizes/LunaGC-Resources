{
    "groupId": "1585",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 4,
        "快腿罗斯": 18
    },
    "talks": [
        {
            "talkId": "6158501",
            "initDialog": "615850101",
            "dialogues": [
                {
                    "id": "615850101",
                    "speaker": "快腿罗斯",
                    "text": "啊，是过路的旅行者吗？"
                },
                {
                    "id": "615850102",
                    "speaker": "快腿罗斯",
                    "text": "一起坐下吧，这里风景真不错呢…"
                }
            ]
        },
        {
            "talkId": "6158502",
            "initDialog": "615850201",
            "dialogues": [
                {
                    "id": "615850201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615850202",
                    "speaker": "快腿罗斯",
                    "text": "我…?"
                },
                {
                    "id": "615850203",
                    "speaker": "快腿罗斯",
                    "text": "他们都叫我「快腿罗斯」。"
                },
                {
                    "id": "615850204",
                    "speaker": "快腿罗斯",
                    "text": "尤其是一直以来想抓住我的人。"
                }
            ]
        },
        {
            "talkId": "6158503",
            "initDialog": "615850301",
            "dialogues": [
                {
                    "id": "615850301",
                    "speaker": "Player",
                    "text": "你在这里做什么？"
                },
                {
                    "id": "615850302",
                    "speaker": "快腿罗斯",
                    "text": "是啊…我在这里做什么呢…"
                },
                {
                    "id": "615850303",
                    "speaker": "快腿罗斯",
                    "text": "先是迷了路，然后又被野猪追了一路，最后是丘丘人…"
                },
                {
                    "id": "615850304",
                    "speaker": "快腿罗斯",
                    "text": "当我筋疲力尽的时候，忽然看到了这片湖水…"
                },
                {
                    "id": "615850305",
                    "speaker": "快腿罗斯",
                    "text": "恍惚间我意识到，我这辈子就只是在毫无意义的跑啊跑。"
                },
                {
                    "id": "615850306",
                    "speaker": "快腿罗斯",
                    "text": "不管怎样，我现在要休息一下。任务什么的，去他的吧。"
                },
                {
                    "id": "615850307",
                    "speaker": "快腿罗斯",
                    "text": "虽说不赶紧向「团里」汇报的话，根据团规…要罚款八万四千…几百摩拉来着？"
                },
                {
                    "id": "615850308",
                    "speaker": "快腿罗斯",
                    "text": "…算了，「盗宝团」什么的，也去他的吧。"
                },
                {
                    "id": "615850309",
                    "speaker": "Player",
                    "text": "你、你是「盗宝团」的？！"
                },
                {
                    "id": "615850310",
                    "speaker": "快腿罗斯",
                    "text": "…唔，你说是也算是吧。"
                },
                {
                    "id": "615850311",
                    "speaker": "快腿罗斯",
                    "text": "我本来的任务，是要去找一个叫「废都遗迹」的地方来着。"
                },
                {
                    "id": "615850312",
                    "speaker": "快腿罗斯",
                    "text": "…那么久没向团里汇报任务进展，我大概已经被「自动退团」了吧。"
                },
                {
                    "id": "615850313",
                    "speaker": "快腿罗斯",
                    "text": "不过如果你真的要举报我的话，我也不会跑啦…"
                },
                {
                    "id": "615850314",
                    "speaker": "快腿罗斯",
                    "text": "…总之，先让我再看几眼这湖水吧。"
                }
            ]
        },
        {
            "talkId": "6158504",
            "initDialog": "615850401",
            "dialogues": [
                {
                    "id": "615850401",
                    "speaker": "Player",
                    "text": "…再见。"
                },
                {
                    "id": "615850402",
                    "speaker": "快腿罗斯",
                    "text": "唔…好吧，再见了。"
                }
            ]
        }
    ]
}