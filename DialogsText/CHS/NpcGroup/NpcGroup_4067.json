{
    "groupId": "4067",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "塞库菈": 12
    },
    "talks": [
        {
            "talkId": "6406701",
            "initDialog": "640670101",
            "dialogues": [
                {
                    "id": "640670101",
                    "speaker": "塞库菈",
                    "text": "有了更多暝彩鸟之后，工作虽然变轻松了，但回家的机会也变少了…"
                }
            ]
        },
        {
            "talkId": "6406702",
            "initDialog": "640670201",
            "dialogues": [
                {
                    "id": "640670201",
                    "speaker": "Player",
                    "text": "暝彩鸟…"
                },
                {
                    "id": "640670202",
                    "speaker": "塞库菈",
                    "text": "暝彩鸟多用来送信，是我作为信使「飞燕」的工作中必不可少的伙伴。"
                },
                {
                    "id": "640670203",
                    "speaker": "塞库菈",
                    "text": "不过跑来跑去的工作变少了之后，驻扎在城里的时间反而变多了。"
                },
                {
                    "id": "640670204",
                    "speaker": "塞库菈",
                    "text": "我的老家在阿如村，是沙漠边缘的一座小村庄。"
                },
                {
                    "id": "640670205",
                    "speaker": "塞库菈",
                    "text": "好想回阿如村看看啊…距离上次见到坎蒂丝已经好久了，下次见面一定要和她好好聊聊。"
                },
                {
                    "id": "640670206",
                    "speaker": "塞库菈",
                    "text": "比如城里的生活，雨林的故事，还有掌旗官鲁克沙…"
                }
            ]
        },
        {
            "talkId": "6406703",
            "initDialog": "640670301",
            "dialogues": [
                {
                    "id": "640670301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640670302",
                    "speaker": "塞库菈",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6406704",
            "initDialog": "640670401",
            "dialogues": [
                {
                    "id": "640670401",
                    "speaker": "Player",
                    "text": "关于鲁克沙…"
                },
                {
                    "id": "640670402",
                    "speaker": "塞库菈",
                    "text": "别看鲁克沙这么沉稳可靠，他可是「三十人团」史上最年轻的掌旗官！"
                },
                {
                    "id": "640670403",
                    "speaker": "塞库菈",
                    "text": "而且据说他出身雨林，不是沙漠的子民。"
                },
                {
                    "id": "640670404",
                    "speaker": "塞库菈",
                    "text": "你要知道，加入镀金旅团的雨林人本来就少，更不要提当上掌旗官了。"
                },
                {
                    "id": "640670405",
                    "speaker": "塞库菈",
                    "text": "不过他很厉害，不仅和沙漠的兄弟姐妹们聊得来，也能和教令院的学者们顺畅沟通。"
                },
                {
                    "id": "640670406",
                    "speaker": "塞库菈",
                    "text": "也许，关于他曾经是学者的传言也是真的呢…"
                }
            ]
        }
    ]
}