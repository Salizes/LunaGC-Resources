{
    "groupId": "9572",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "夏沃蕾": 10
    },
    "talks": [
        {
            "talkId": "6957201",
            "initDialog": "695720101",
            "dialogues": [
                {
                    "id": "695720101",
                    "speaker": "夏沃蕾",
                    "text": "在特巡队里，这种卡牌游戏也颇受欢迎。不少人一直在购买和交换卡牌…我不会阻拦队员们进行正常的娱乐消遣。但我也会告诫他们，游玩需适度。"
                }
            ]
        },
        {
            "talkId": "6957202",
            "initDialog": "695720201",
            "dialogues": [
                {
                    "id": "695720201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957203",
            "initDialog": "695720301",
            "dialogues": [
                {
                    "id": "695720301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695720302",
                    "speaker": "夏沃蕾",
                    "text": "再见，稍后我也要回队里了。我离开了这么一段时间，应该积压了不少事务需要处理…"
                }
            ]
        },
        {
            "talkId": "6957204",
            "initDialog": "695720401",
            "dialogues": [
                {
                    "id": "695720401",
                    "speaker": "夏沃蕾",
                    "text": "侥幸获胜。我只是沾了点好运，绝算不上掌握对局。"
                }
            ]
        },
        {
            "talkId": "6957205",
            "initDialog": "695720501",
            "dialogues": [
                {
                    "id": "695720501",
                    "speaker": "夏沃蕾",
                    "text": "…我果然不擅长这类游戏。呼…休息时间也该结束了。"
                }
            ]
        },
        {
            "talkId": "6957206",
            "initDialog": "695720601",
            "dialogues": [
                {
                    "id": "695720601",
                    "speaker": "夏沃蕾",
                    "text": "开始吧。我随时都能应战。"
                }
            ]
        },
        {
            "talkId": "6957208",
            "initDialog": "695720801",
            "dialogues": [
                {
                    "id": "695720801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957209",
            "initDialog": "695720901",
            "dialogues": [
                {
                    "id": "695720901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957210",
            "initDialog": "695721001",
            "dialogues": [
                {
                    "id": "695721001",
                    "speaker": "夏沃蕾",
                    "text": "还好准备充足，不然就要败在你手下了。"
                }
            ]
        },
        {
            "talkId": "6957211",
            "initDialog": "695721101",
            "dialogues": [
                {
                    "id": "695721101",
                    "speaker": "夏沃蕾",
                    "text": "…我输了。你的战术，我实在琢磨不透。"
                }
            ]
        },
        {
            "talkId": "6957212",
            "initDialog": "695721201",
            "dialogues": [
                {
                    "id": "695721201",
                    "speaker": "夏沃蕾",
                    "text": "没问题。来加练吧。"
                }
            ]
        },
        {
            "talkId": "6957214",
            "initDialog": "695721401",
            "dialogues": [
                {
                    "id": "695721401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957215",
            "initDialog": "695721501",
            "dialogues": [
                {
                    "id": "695721501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957216",
            "initDialog": "695721601",
            "dialogues": [
                {
                    "id": "695721601",
                    "speaker": "夏沃蕾",
                    "text": "想要纠正错误的话，我可以陪你再来一局。"
                }
            ]
        },
        {
            "talkId": "6957217",
            "initDialog": "695721701",
            "dialogues": [
                {
                    "id": "695721701",
                    "speaker": "夏沃蕾",
                    "text": "你赢了。是我犯错太多，错失了这一局。"
                }
            ]
        },
        {
            "talkId": "6957218",
            "initDialog": "695721801",
            "dialogues": [
                {
                    "id": "695721801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}