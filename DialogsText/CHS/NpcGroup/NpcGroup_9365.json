{
    "groupId": "9365",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "白术": 6,
        "长生": 3
    },
    "talks": [
        {
            "talkId": "6936501",
            "initDialog": "693650101",
            "dialogues": [
                {
                    "id": "693650101",
                    "speaker": "白术",
                    "text": "#{NICKNAME}，此地险象环生，你一路过来，身上可有什么暗伤？"
                },
                {
                    "id": "693650102",
                    "speaker": "白术",
                    "text": "嗯，我知道你身手不凡。但就算表面无恙，疲惫感也可能在暗中积累，需要适时舒筋活络，行气化瘀…"
                },
                {
                    "id": "693650103",
                    "speaker": "长生",
                    "text": "——说白了就是担心你，快点躺下让我们检查检查！"
                }
            ]
        },
        {
            "talkId": "6936502",
            "initDialog": "693650201",
            "dialogues": [
                {
                    "id": "693650201",
                    "speaker": "白术",
                    "text": "咳…咳！"
                },
                {
                    "id": "693650202",
                    "speaker": "长生",
                    "text": "喂，还要继续深入吗？要不再缓缓？"
                },
                {
                    "id": "693650203",
                    "speaker": "白术",
                    "text": "…不妨事。若是稍遇牵掣就踯躅不前，我可走不到今天。"
                }
            ]
        },
        {
            "talkId": "6936503",
            "initDialog": "693650301",
            "dialogues": [
                {
                    "id": "693650301",
                    "speaker": "白术",
                    "text": "这里的藏书相当丰富，不知有没有失传的古方、医书一类…"
                },
                {
                    "id": "693650302",
                    "speaker": "长生",
                    "text": "你怕是白期待了，我刚刚绕了一圈，差不多都是给小孩子看的书嘛。"
                },
                {
                    "id": "693650303",
                    "speaker": "白术",
                    "text": "是么，不过童话之于一些心病，也可当作心药了。"
                }
            ]
        }
    ]
}