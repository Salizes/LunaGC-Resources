{
    "groupId": "2050",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "大邋遢": 12
    },
    "talks": [
        {
            "talkId": "6205001",
            "initDialog": "620500101",
            "dialogues": [
                {
                    "id": "620500101",
                    "speaker": "大邋遢",
                    "text": "啊，你好，旅行者。"
                },
                {
                    "id": "620500102",
                    "speaker": "大邋遢",
                    "text": "这一带治安由我负责，我在巡逻…顺便找些东西。"
                }
            ]
        },
        {
            "talkId": "6205002",
            "initDialog": "620500201",
            "dialogues": [
                {
                    "id": "620500201",
                    "speaker": "Player",
                    "text": "你在找什么？"
                },
                {
                    "id": "620500202",
                    "speaker": "大邋遢",
                    "text": "不知道你在附近有没有看到一把千岩军制式长枪呢？"
                },
                {
                    "id": "620500203",
                    "speaker": "大邋遢",
                    "text": "奇怪啊，应该就在这附近才对啊…"
                },
                {
                    "id": "620500204",
                    "speaker": "大邋遢",
                    "text": "唉，要是被其他同伴知道了，又该给我起新的外号了…"
                },
                {
                    "id": "620500205",
                    "speaker": "Player",
                    "text": "为什么士兵会丢了武器？"
                },
                {
                    "id": "620500206",
                    "speaker": "大邋遢",
                    "text": "嘘…可别让我们教头听见了…发生这种事我也不想的啊。"
                },
                {
                    "id": "620500207",
                    "speaker": "大邋遢",
                    "text": "唉，之前就是因为我懒，有些不修边幅，所以同伴们给我起了一个「大邋遢」的外号…"
                },
                {
                    "id": "620500208",
                    "speaker": "大邋遢",
                    "text": "我好不容易把懒惰克服了，结果又多了个丢三落四的毛病。"
                },
                {
                    "id": "620500209",
                    "speaker": "大邋遢",
                    "text": "刚才我在那边的大排档休息，愣了愣神儿，等回来的时候就发现手里握着的是晒衣杆，而长枪不知道哪儿去了…"
                },
                {
                    "id": "620500210",
                    "speaker": "大邋遢",
                    "text": "…要是被同伴们知道了我把枪丢了，估计我又得多个新外号了…"
                }
            ]
        },
        {
            "talkId": "6205003",
            "initDialog": "620500301",
            "dialogues": [
                {
                    "id": "620500301",
                    "speaker": "Player",
                    "text": "不好意思，现在很忙。"
                },
                {
                    "id": "620500302",
                    "speaker": "大邋遢",
                    "text": "好吧，如果看到一把长枪的话，麻烦提醒我一下哈…我会给你酬谢的。"
                },
                {
                    "id": "620500303",
                    "speaker": "大邋遢",
                    "text": "等等，我钱包哪儿去了…"
                }
            ]
        }
    ]
}