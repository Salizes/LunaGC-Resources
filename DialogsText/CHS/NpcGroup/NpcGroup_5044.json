{
    "groupId": "5044",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "莉雅丝": 12
    },
    "talks": [
        {
            "talkId": "6504401",
            "initDialog": "650440101",
            "dialogues": [
                {
                    "id": "650440101",
                    "speaker": "莉雅丝",
                    "text": "天气真好，你也这么觉得吧？"
                }
            ]
        },
        {
            "talkId": "6504402",
            "initDialog": "650440201",
            "dialogues": [
                {
                    "id": "650440201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "650440202",
                    "speaker": "莉雅丝",
                    "text": "我在巡逻，顺便享受这份好天气。"
                },
                {
                    "id": "650440203",
                    "speaker": "莉雅丝",
                    "text": "无论晴天还是雨季，都是令美露莘开心的日子。"
                }
            ]
        },
        {
            "talkId": "6504403",
            "initDialog": "650440301",
            "dialogues": [
                {
                    "id": "650440301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "650440302",
                    "speaker": "莉雅丝",
                    "text": "没关系，一起享受好天气吧。"
                }
            ]
        },
        {
            "talkId": "6504404",
            "initDialog": "650440401",
            "dialogues": [
                {
                    "id": "650440401",
                    "speaker": "Player",
                    "text": "关于美露莘…"
                },
                {
                    "id": "650440402",
                    "speaker": "莉雅丝",
                    "text": "想知道关于我们的问题吗？"
                },
                {
                    "id": "650440403",
                    "speaker": "莉雅丝",
                    "text": "唔…我们是从巨兽「厄里那斯」的血肉中诞生的物种。"
                },
                {
                    "id": "650440404",
                    "speaker": "莉雅丝",
                    "text": "请不要被这种说法吓到，厄里那斯是温柔的母亲，像对待孩子一样教会了我们如何在这个世界上生存。"
                },
                {
                    "id": "650440405",
                    "speaker": "莉雅丝",
                    "text": "但后来厄里那斯不再说话，我们便请求那维莱特大人带我们进入枫丹廷生活。"
                },
                {
                    "id": "650440406",
                    "speaker": "莉雅丝",
                    "text": "所以，你才能见到这样穿着制服巡逻的我。我们美露莘受到了很多关照，算是非常幸运的种族呢。"
                }
            ]
        },
        {
            "talkId": "7491501",
            "initDialog": "749150101",
            "dialogues": [
                {
                    "id": "749150101",
                    "speaker": "Player",
                    "text": "关于这件制服…"
                },
                {
                    "id": "749150102",
                    "speaker": "莉雅丝",
                    "text": "我们和人类合作，共同保护枫丹——这就是那维莱特大人交给我们的使命。"
                },
                {
                    "id": "749150103",
                    "speaker": "莉雅丝",
                    "text": "尽管那维莱特大人对我们多加关照，但我们依旧和人类一样，需要经过考核与培训才能加入逐影庭。"
                },
                {
                    "id": "749150104",
                    "speaker": "莉雅丝",
                    "text": "这就是那些沫芒厅里的人口中常说的「公平」吧？"
                }
            ]
        }
    ]
}