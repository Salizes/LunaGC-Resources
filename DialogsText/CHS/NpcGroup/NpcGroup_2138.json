{
    "groupId": "2138",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 7,
        "小白": 14
    },
    "talks": [
        {
            "talkId": "6213807",
            "initDialog": "621380701",
            "dialogues": [
                {
                    "id": "621380701",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6213808",
            "initDialog": "621380801",
            "dialogues": [
                {
                    "id": "621380801",
                    "speaker": "小白",
                    "text": "我的牌组还不错吧？我可是拿出了管理磨坊的干劲在管理它哦。"
                }
            ]
        },
        {
            "talkId": "6213809",
            "initDialog": "621380901",
            "dialogues": [
                {
                    "id": "621380901",
                    "speaker": "小白",
                    "text": "从没见过这种打法！难道…城市里有很多和你一样强的牌手吗？"
                }
            ]
        },
        {
            "talkId": "7192701",
            "initDialog": "719270101",
            "dialogues": [
                {
                    "id": "719270101",
                    "speaker": "Player",
                    "text": "挺不错的。"
                },
                {
                    "id": "719270102",
                    "speaker": "小白",
                    "text": "谢谢你的夸奖，不只是磨坊，我家的豆腐也绝对是璃月最好的！"
                },
                {
                    "id": "719270103",
                    "speaker": "小白",
                    "text": "虽然听上去有些像是自夸，但连璃月港的很多餐馆、甚至连望舒客栈都会来我这里进货呢！"
                },
                {
                    "id": "719270104",
                    "speaker": "小白",
                    "text": "当然，说得再好听也不如亲自尝尝，这些豆腐就送给你好了，如果觉得不错就来再买些吧。"
                }
            ]
        },
        {
            "talkId": "6213801",
            "initDialog": "621380101",
            "dialogues": [
                {
                    "id": "621380101",
                    "speaker": "小白",
                    "text": "呀，你好！像你这样的年轻人近来很少见呢。"
                }
            ]
        },
        {
            "talkId": "6213802",
            "initDialog": "621380201",
            "dialogues": [
                {
                    "id": "621380201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "621380202",
                    "speaker": "小白",
                    "text": "叫我小白就好，这是我的磨坊…嘿嘿，准确来说，是我管理的磨坊。"
                },
                {
                    "id": "621380203",
                    "speaker": "小白",
                    "text": "怎么样，很不错吧？"
                }
            ]
        },
        {
            "talkId": "6213803",
            "initDialog": "621380301",
            "dialogues": [
                {
                    "id": "621380301",
                    "speaker": "Player",
                    "text": "年轻人？"
                },
                {
                    "id": "621380302",
                    "speaker": "小白",
                    "text": "嗯，是啊。年轻人大多出去打工，不再回来了。外来的年轻游客也很少见呢。"
                },
                {
                    "id": "621380303",
                    "speaker": "小白",
                    "text": "果然还是城市里的生活更吸引人吧…"
                }
            ]
        },
        {
            "talkId": "6213804",
            "initDialog": "621380401",
            "dialogues": [
                {
                    "id": "621380401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "621380402",
                    "speaker": "小白",
                    "text": "再见，一路平安！"
                }
            ]
        },
        {
            "talkId": "6213805",
            "initDialog": "621380501",
            "dialogues": [
                {
                    "id": "621380501",
                    "speaker": "Player",
                    "text": "你这里卖什么？"
                },
                {
                    "id": "621380502",
                    "speaker": "小白",
                    "text": "要来些豆腐吗？我家的豆腐保您满意！"
                }
            ]
        },
        {
            "talkId": "6213806",
            "initDialog": "621380204",
            "dialogues": [
                {
                    "id": "621380204",
                    "speaker": "Player",
                    "text": "关于磨坊。"
                },
                {
                    "id": "621380205",
                    "speaker": "小白",
                    "text": "怎么样？这是我父亲留下来的，我一回来就把它整饬一新，每天都在维护它。"
                },
                {
                    "id": "621380206",
                    "speaker": "小白",
                    "text": "或许父亲曾经也是过着这样平静的生活吧…每次听着水车的声音，总让我想起童年的很多往事…"
                }
            ]
        }
    ]
}