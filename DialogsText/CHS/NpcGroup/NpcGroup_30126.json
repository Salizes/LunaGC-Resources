    "talks": [
        {
            "talkId": "7165807",
            "initDialog": "716580701",
            "dialogues": [
                {
                    "id": "716580701",
                    "speaker": "甘雨",
                    "text": "#{NICKNAME}，海灯节快乐呀，最近过得还好吗？"
                },
                {
                    "id": "716580702",
                    "speaker": "甘雨",
                    "text": "希望你一切顺利，不要像我一样犯愁…"
                },
                {
                    "id": "716580703",
                    "speaker": "甘雨",
                    "text": "啊…也没别的，就是…如你所见，海灯节诸事繁杂，我本应回玉京台帮着一同处理…"
                },
                {
                    "id": "716580704",
                    "speaker": "甘雨",
                    "text": "凝光小姐却劝我再多休息几天，说是工作不急于一时，佳节期间还该和亲友聚聚…"
                },
                {
                    "id": "716580705",
                    "speaker": "甘雨",
                    "text": "可真要待在留云真君身边，不出几句话，她一定会问我，今年工作怎么样，有没有心上人…",
                    "choices": [
                        {
                            "id": "716580706",
                            "text": "可以想象…",
                            "response": [
                                {
                                    "id": "716580707",
                                    "speaker": "甘雨",
                                    "text": "是啊，还不如回去加班呢…"
                                },
                                {
                                    "id": "716580710",
                                    "speaker": "甘雨",
                                    "text": "不过…说出口之后，感觉已经轻松一些了。嗯…谢谢你能来陪我。"
                                }
                            ]
                        },
                        {
                            "id": "716580708",
                            "text": "那有没有心上人？",
                            "response": [
                                {
                                    "id": "716580709",
                                    "speaker": "甘雨",
                                    "text": "咦？怎么连你也…！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}