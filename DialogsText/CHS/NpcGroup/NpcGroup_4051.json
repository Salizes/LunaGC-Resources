{
    "groupId": "4051",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "优素福": 12
    },
    "talks": [
        {
            "talkId": "6405101",
            "initDialog": "640510101",
            "dialogues": [
                {
                    "id": "640510101",
                    "speaker": "优素福",
                    "text": "今天的我…也做得很棒！"
                }
            ]
        },
        {
            "talkId": "6405102",
            "initDialog": "640510201",
            "dialogues": [
                {
                    "id": "640510201",
                    "speaker": "Player",
                    "text": "很自信啊。"
                },
                {
                    "id": "640510202",
                    "speaker": "优素福",
                    "text": "这可不是自信，而是事实。"
                },
                {
                    "id": "640510203",
                    "speaker": "优素福",
                    "text": "年纪轻轻的我，已经如此能干，可以自己养活自己了！"
                },
                {
                    "id": "640510204",
                    "speaker": "优素福",
                    "text": "只要跟着苏莱卡老板，做好每日的登记工作，就能在晚上拿到一天的工钱。"
                },
                {
                    "id": "640510205",
                    "speaker": "优素福",
                    "text": "所以只要我一直做下去，就可以一辈子有钱拿，然后每天吃兰巴德叔叔的鱼卷了。"
                }
            ]
        },
        {
            "talkId": "6405103",
            "initDialog": "640510301",
            "dialogues": [
                {
                    "id": "640510301",
                    "speaker": "Player",
                    "text": "你真棒。"
                },
                {
                    "id": "640510302",
                    "speaker": "优素福",
                    "text": "谢谢！我也这么觉得。"
                }
            ]
        },
        {
            "talkId": "6405104",
            "initDialog": "640510401",
            "dialogues": [
                {
                    "id": "640510401",
                    "speaker": "Player",
                    "text": "目光…很长远。"
                },
                {
                    "id": "640510402",
                    "speaker": "优素福",
                    "text": "那当然！你可能不知道，苏莱卡老板可是天才，之前一直有教令院的人邀请她去上学呢。"
                },
                {
                    "id": "640510403",
                    "speaker": "优素福",
                    "text": "不过那些死板的大人们，都被老板用「学习哪有赚钱好玩」打发走了。"
                },
                {
                    "id": "640510404",
                    "speaker": "优素福",
                    "text": "而且苏莱卡老板还告诉我说，积累财富的最大秘诀，就是「远离卡里米交易所」。"
                },
                {
                    "id": "640510405",
                    "speaker": "优素福",
                    "text": "跟着这样天才又关心下属的老板，我肯定一辈子都不愁吃喝啦。"
                }
            ]
        },
        {
            "talkId": "7393301",
            "initDialog": "739330101",
            "dialogues": [
                {
                    "id": "739330101",
                    "speaker": "Player",
                    "text": "鱼卷好吃吗？"
                },
                {
                    "id": "739330102",
                    "speaker": "优素福",
                    "text": "我每天吃都吃不腻，你说能不好吃吗？"
                },
                {
                    "id": "739330103",
                    "speaker": "优素福",
                    "text": "不信的话就亲自尝尝吧！兰巴德叔叔的自创鱼卷，一定会让你折服的！"
                }
            ]
        }
    ]
}