    },
    "talks": [
        {
            "talkId": "7223601",
            "initDialog": "722360101",
            "dialogues": [
                {
                    "id": "722360101",
                    "speaker": "？？？",
                    "text": "哼，渊下宫最后一天，你们都来了三波人了。"
                },
                {
                    "id": "722360102",
                    "speaker": "？？？",
                    "text": "你要是想回收实验记录，那我无可奉告。你让厄伯斯派和珊瑚宫派先吵完架再说这事吧。"
                },
                {
                    "id": "722360103",
                    "speaker": "？？？",
                    "text": "我反正站珊瑚宫派。这些实验记录永远埋葬在黑暗里比较好。"
                },
                {
                    "id": "722360104",
                    "speaker": "派蒙",
                    "text": "实验记录…"
                },
                {
                    "id": "722360105",
                    "speaker": "？？？",
                    "text": "哦？你们不是来回收实验记录的啊。那快点离开吧。"
                },
                {
                    "id": "722360106",
                    "speaker": "？？？",
                    "text": "不过一般人哪有本事闲逛到这个地方。你们难道是地走官吗，是珊瑚宫想要灭我们的口来保密了吗？"
                },
                {
                    "id": "722360107",
                    "speaker": "派蒙",
                    "text": "不是啦不是！我们只是…"
                },
                {
                    "id": "722360108",
                    "speaker": "Player",
                    "text": "你，觉悟不错啊。"
                },
                {
                    "id": "722360109",
                    "speaker": "？？？",
                    "text": "什么意思？"
                },
                {
                    "id": "722360110",
                    "speaker": "Player",
                    "text": "我们是来检视你工作的。"
                },
                {
                    "id": "722360111",
                    "speaker": "？？？",
                    "text": "哼…"
                },
                {
                    "id": "722360112",
                    "speaker": "Player",
                    "text": "我们前来检查记录的密保措施。"
                },
                {
                    "id": "722360113",
                    "speaker": "？？？",
                    "text": "…反正你们能来到此地，料想也不是泛泛之辈。但我不管你究竟是哪边的人，还是离这里远点比较好。"
                },
                {
                    "id": "722360114",
                    "speaker": "？？？",
                    "text": "记录被我放在了所内深处，打开通路需要激活元素方碑。换句话说，需要释放强大的元素力。"
                },
                {
                    "id": "722360115",
                    "speaker": "？？？",
                    "text": "所有人离开白夜国后，这里的深海龙蜥就会被放出来。而它们被培养成了对特定元素起反应的体质。"
                },
                {
                    "id": "722360116",
                    "speaker": "？？？",
                    "text": "这里的深海龙蜥可都是强化品种，而且特征遗传给子代的概率很高。数载之后，这里将常年盘踞强大的深海龙蜥族群。"
                },
                {
                    "id": "722360117",
                    "speaker": "？？？",
                    "text": "因此，实验记录安全得很。"
                },
                {
                    "id": "722360118",
                    "speaker": "Player",
                    "text": "把它烧了不是更加安全？"
                },
                {
                    "id": "722360119",
                    "speaker": "？？？",
                    "text": "我是赞成这么做的，但是研究人员里面也分派系。我也不是不能理解另一派人的想法。"
                },
                {
                    "id": "722360120",
                    "speaker": "？？？",
                    "text": "「我们是拯救海祇的英雄了！」、「我们这下变成混蛋了…」——确实都有道理。"
                },
                {
                    "id": "722360121",
                    "speaker": "？？？",
                    "text": "把真相留到一个可以原谅我们的时代，也是一个我可以接受的方案。"
                },
                {
                    "id": "722360122",
                    "speaker": "？？？",
                    "text": "看你也不是一般人，就算不是地走官也是什么珊瑚宫近臣了。"
                },
                {
                    "id": "722360123",
                    "speaker": "宫地",
                    "text": "帮我给大人物们带个话吧：宫地他会在禁区里待到离开的前一刻，确保再也没有人出现在附近。"
                },
                {
                    "id": "722360124",
                    "speaker": "派蒙",
                    "text": "所以你就是宫地对吧？"
                },
                {
                    "id": "722360125",
                    "speaker": "宫地",
                    "text": "嗯哼，不过到海面之上就要换个名字开始新生活了。不过，罪孽是没办法和老名字一样轻易抛弃的。"
                }
            ]
        },
        {
            "talkId": "7223602",
            "initDialog": "722360201",
            "dialogues": [
                {
                    "id": "722360201",
                    "speaker": "？？？",
                    "text": "哼，渊下宫最后一天，你们都来了三波人了。"
                },
                {
                    "id": "722360202",
                    "speaker": "？？？",
                    "text": "你要是想回收实验记录，那我无可奉告。你让厄伯斯派和珊瑚宫派先吵完架再说这事吧。"
                },
                {
                    "id": "722360203",
                    "speaker": "？？？",
                    "text": "渊下宫这种夜里到处都是过去残影的地方，「过去」、「记录」、「历史」什么的…"
                },
                {
                    "id": "722360204",
                    "speaker": "？？？",
                    "text": "根本没必要，还很危险。"
                },
                {
                    "id": "722360205",
                    "speaker": "派蒙",
                    "text": "（这个人似乎还不知道自己也是残影哦。）"
                },
                {
                    "id": "722360206",
                    "speaker": "派蒙",
                    "text": "我们不是来回收实验记录的。"
                },
                {
                    "id": "722360207",
                    "speaker": "？？？",
                    "text": "哦，这样啊。那快点离开吧。"
                },
                {
                    "id": "722360208",
                    "speaker": "？？？",
                    "text": "不对…一般人哪有本事闲逛到这个地方。你们难道是地走官吗，是珊瑚宫想要灭我们的口来保密了吗？"
                },
                {
                    "id": "722360209",
                    "speaker": "派蒙",
                    "text": "不是啦不是！我们只是…"
                },
                {
                    "id": "722360210",
                    "speaker": "Player",
                    "text": "我们前来清点物资。"
                },
                {
                    "id": "722360211",
                    "speaker": "？？？",
                    "text": "哼。这是什么没同步到我这里的暗号吗？不过罢了，你既然能来这里，靠我想拦你也是拦不住的。"
                },
                {
                    "id": "722360212",
                    "speaker": "派蒙",
                    "text": "啊哈哈，你看，今天是渊下宫最后一天嘛。提前来看看，估算一下搬运需要多少人手。"
                },
                {
                    "id": "722360213",
                    "speaker": "？？？",
                    "text": "请便吧。但是注意不要把方碑激活了。"
                },
                {
                    "id": "722360214",
                    "speaker": "？？？",
                    "text": "所有人离开白夜国后，我会把这里的深海龙蜥放出来。它们被培养成了对特定元素力起反应的体质。"
                },
                {
                    "id": "722360215",
                    "speaker": "？？？",
                    "text": "这里的深海龙蜥可都是强化品种，而且特征遗传给子代的概率很高。数载之后，这里将常年盘踞强大的深海龙蜥族群。"
                },
                {
                    "id": "722360216",
                    "speaker": "？？？",
                    "text": "虽然它们现在还关着，但是察觉到元素力，躁动起来的话我还是很头疼的。"
                },
                {
                    "id": "722360217",
                    "speaker": "派蒙",
                    "text": "你这是想干什么。"
                },
                {
                    "id": "722360218",
                    "speaker": "？？？",
                    "text": "用来把守实验记录啊。可能还有一些稀奇古怪的资材吧，那些都不需要你们搬运。不用在意。"
                },
                {
                    "id": "722360219",
                    "speaker": "？？？",
                    "text": "看你也不是一般人，就算不是地走官也是什么珊瑚宫近臣了。"
                },
                {
                    "id": "722360220",
                    "speaker": "宫地",
                    "text": "帮我给大人物们带个话吧：宫地他会在禁区里待到离开的前一刻，确保再也没有人出现在附近。"
                },
                {
                    "id": "722360221",
                    "speaker": "派蒙",
                    "text": "所以你就是宫地对吧？"
                },
                {
                    "id": "722360222",
                    "speaker": "宫地",
                    "text": "嗯哼，不过到海面之上就要换个名字开始新生活了。不过，罪孽是没办法和老名字一样轻易抛弃的。"
                }
            ]
        },
        {
            "talkId": "7223603",
            "initDialog": "722360301",
            "dialogues": [
                {
                    "id": "722360301",
                    "speaker": "宫地",
                    "text": "哼，其他的事情我无可奉告。"
                }
            ]
        }
    ]
}