{
    "groupId": "7061",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 5,
        "索洛尼娅": 9
    },
    "talks": [
        {
            "talkId": "6706101",
            "initDialog": "670610101",
            "dialogues": [
                {
                    "id": "670610101",
                    "speaker": "索洛尼娅",
                    "text": "只有在这群宝藏猎人中间，才觉得人生总算有点儿意思了。生活果然还是需要来点儿刺激！"
                }
            ]
        },
        {
            "talkId": "6706102",
            "initDialog": "670610201",
            "dialogues": [
                {
                    "id": "670610201",
                    "speaker": "Player",
                    "text": "看来你的生活很惬意。"
                },
                {
                    "id": "670610202",
                    "speaker": "索洛尼娅",
                    "text": "惬意？明明是无聊才对！不过要说惬意好像也没错…管他呢，总之现在的生活并不是我想要的！"
                }
            ]
        },
        {
            "talkId": "6706103",
            "initDialog": "670610301",
            "dialogues": [
                {
                    "id": "670610301",
                    "speaker": "Player",
                    "text": "冒险家的生活已经够刺激了，告辞…"
                },
                {
                    "id": "670610302",
                    "speaker": "索洛尼娅",
                    "text": "虽然我只是在慨叹而已，不是对你说的。不过，拥有这种令人羡慕的生活，还真是幸运呢。祝你一路顺风！"
                }
            ]
        },
        {
            "talkId": "6706104",
            "initDialog": "670610401",
            "dialogues": [
                {
                    "id": "670610401",
                    "speaker": "Player",
                    "text": "我有时候也会这样想。"
                },
                {
                    "id": "670610402",
                    "speaker": "索洛尼娅",
                    "text": "那你可来对地方了！这里是宝藏猎人们的聚集地，他们有太多有意思的经历了！"
                },
                {
                    "id": "670610403",
                    "speaker": "索洛尼娅",
                    "text": "果然，要想摆脱无聊的生活，唯一的办法就是——成为一名宝藏猎人！"
                },
                {
                    "id": "670610404",
                    "speaker": "索洛尼娅",
                    "text": "唉，要是有什么门路就好了…"
                }
            ]
        },
        {
            "talkId": "6706105",
            "initDialog": "670610501",
            "dialogues": [
                {
                    "id": "670610501",
                    "speaker": "Player",
                    "text": "我好像从来没有这种感觉。"
                },
                {
                    "id": "670610502",
                    "speaker": "索洛尼娅",
                    "text": "真是幸运！那么年轻就已经找到了自己想要的生活了么…没办法，这个世界永远都会有像你这种让人羡慕的家伙呢！"
                }
            ]
        },
        {
            "talkId": "6706106",
            "initDialog": "670610601",
            "dialogues": [
                {
                    "id": "670610601",
                    "speaker": "Player",
                    "text": "或许只要开始找宝藏就可以了？"
                },
                {
                    "id": "670610602",
                    "speaker": "索洛尼娅",
                    "text": "欸？那怎么行！没有罗盘、没有领路人、没有趁手的武器就踏上旅途的话，不就只是在闲逛而已么…"
                },
                {
                    "id": "670610603",
                    "speaker": "索洛尼娅",
                    "text": "出发之前，得把所有的东西都准备好才行啊！所以才要尽可能多地从有经验的老手们这里问出点情报嘛。"
                }
            ]
        }
    ]
}