    "talks": [
        {
            "talkId": "6407601",
            "initDialog": "640760101",
            "dialogues": [
                {
                    "id": "640760101",
                    "speaker": "塔玛拉",
                    "text": "你好。看病的话请找扎卡里亚医师。"
                }
            ]
        },
        {
            "talkId": "6407602",
            "initDialog": "640760201",
            "dialogues": [
                {
                    "id": "640760201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640760202",
                    "speaker": "塔玛拉",
                    "text": "我是一名见习医师，负责也仅负责记录病人的资料与病情。"
                },
                {
                    "id": "640760203",
                    "speaker": "塔玛拉",
                    "text": "除此之外，就不是我的职责范围了。"
                }
            ]
        },
        {
            "talkId": "6407603",
            "initDialog": "640760301",
            "dialogues": [
                {
                    "id": "640760301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640760302",
                    "speaker": "塔玛拉",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6407604",
            "initDialog": "640760401",
            "dialogues": [
                {
                    "id": "640760401",
                    "speaker": "Player",
                    "text": "有很多生病的人吗？"
                },
                {
                    "id": "640760402",
                    "speaker": "塔玛拉",
                    "text": "抱歉，受教令官的指示，我们不能透露病人的相关情况，包含病症、人数等内容。"
                },
                {
                    "id": "640760403",
                    "speaker": "塔玛拉",
                    "text": "请见谅。"
                }
            ]
        }
    ]
}