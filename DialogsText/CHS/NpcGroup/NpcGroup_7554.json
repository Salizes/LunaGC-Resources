{
    "groupId": "7554",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "拉祖莫夫斯基": 7
    },
    "talks": [
        {
            "talkId": "6755401",
            "initDialog": "675540101",
            "dialogues": [
                {
                    "id": "675540101",
                    "speaker": "拉祖莫夫斯基",
                    "text": "稍等，你们要的我都心里有数…这一份是您的，下一份是这位的…"
                }
            ]
        },
        {
            "talkId": "6755402",
            "initDialog": "675540201",
            "dialogues": [
                {
                    "id": "675540201",
                    "speaker": "Player",
                    "text": "有什么好吃的吗？"
                },
                {
                    "id": "675540202",
                    "speaker": "拉祖莫夫斯基",
                    "text": "什么都好吃，客人，不过肉没有鱼好吃，鱼没有我们独家秘制的酱料好吃。"
                },
                {
                    "id": "675540203",
                    "speaker": "拉祖莫夫斯基",
                    "text": "这酱料涂在什么东西上，什么东西都好吃嘞客人。"
                }
            ]
        },
        {
            "talkId": "6755403",
            "initDialog": "675540301",
            "dialogues": [
                {
                    "id": "675540301",
                    "speaker": "Player",
                    "text": "看上去很受欢迎…"
                },
                {
                    "id": "675540302",
                    "speaker": "拉祖莫夫斯基",
                    "text": "受欢迎也不是什么好事嘞，以前我这摊子，一天能卖出去二十单了不起，悠闲自在，中午还能打个小盹。"
                },
                {
                    "id": "675540303",
                    "speaker": "拉祖莫夫斯基",
                    "text": "不知道是哪个人吃完在《先驱报》上一阵夸，这下好了，吃的人排着长队来嘞。"
                },
                {
                    "id": "675540304",
                    "speaker": "拉祖莫夫斯基",
                    "text": "现在别说打盹了，坐在椅子上坐一会儿都被人催着起来烤肉…要让我知道是哪个家伙写的什么报道…"
                }
            ]
        },
        {
            "talkId": "6755404",
            "initDialog": "675540401",
            "dialogues": [
                {
                    "id": "675540401",
                    "speaker": "Player",
                    "text": "不打扰你了。"
                },
                {
                    "id": "675540402",
                    "speaker": "拉祖莫夫斯基",
                    "text": "好，要有想吃的和我说，单子虽然多，顺序我都记得的嘞。"
                }
            ]
        }
    ]
}