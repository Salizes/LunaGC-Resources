    "talks": [
        {
            "talkId": "7165809",
            "initDialog": "716580901",
            "dialogues": [
                {
                    "id": "716580901",
                    "speaker": "魈",
                    "text": "#…{NICKNAME}。"
                },
                {
                    "id": "716580902",
                    "speaker": "魈",
                    "text": "你来了啊。"
                },
                {
                    "id": "716580903",
                    "speaker": "魈",
                    "text": "我猜，今年的海灯节也一如既往。"
                },
                {
                    "id": "716580904",
                    "speaker": "魈",
                    "text": "妖魔退却，人民安康。铜雀若能知道，也算是夙愿得偿了。"
                },
                {
                    "id": "716580905",
                    "speaker": "Player",
                    "text": "魈…"
                },
                {
                    "id": "716580906",
                    "speaker": "魈",
                    "text": "来这里，总不会是要请我去城里看烟花吧。"
                },
                {
                    "id": "716580907",
                    "speaker": "Player",
                    "text": "原来你心里有数啊。"
                },
                {
                    "id": "716580908",
                    "speaker": "魈",
                    "text": "我待在这里就好。"
                },
                {
                    "id": "716580909",
                    "speaker": "魈",
                    "text": "烟花飞得足够高，无论身处何处都能看见。想找我的人，也都会过来。"
                },
                {
                    "id": "716580910",
                    "speaker": "魈",
                    "text": "在这里跟在城里，本也没有什么分别。"
                }
            ]
        }
    ]
}