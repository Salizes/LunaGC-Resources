{
    "groupId": "9061",
    "total_dialogue_lines": 71,
    "speaker_counts": {
        "Player": 19,
        "绮良良": 52
    },
    "talks": [
        {
            "talkId": "6906101",
            "initDialog": "690610101",
            "dialogues": [
                {
                    "id": "690610101",
                    "speaker": "绮良良",
                    "text": "#{NICKNAME}！今天天气真好。"
                },
                {
                    "id": "690610102",
                    "speaker": "绮良良",
                    "text": "唔…仔细想想，这里的天气总是一个样呢。"
                }
            ]
        },
        {
            "talkId": "6906102",
            "initDialog": "690610201",
            "dialogues": [
                {
                    "id": "690610201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690610202",
                    "speaker": "绮良良",
                    "text": "欸，那么快就到「用户回访」环节了吗？咳咳，那我可要认真作答。"
                },
                {
                    "id": "690610203",
                    "speaker": "绮良良",
                    "text": "环境分，五星！这里风景优美，难能一见，好像还存在着某种我看不透的妖力…"
                },
                {
                    "id": "690610204",
                    "speaker": "绮良良",
                    "text": "舒适度，五星！晚上我在箱子里睡得可安稳了！"
                },
                {
                    "id": "690610205",
                    "speaker": "绮良良",
                    "text": "没有噪音，没有强光，完全可以给满分！"
                },
                {
                    "id": "690610206",
                    "speaker": "绮良良",
                    "text": "最后…服务分也是五星，无可挑剔。",
                    "choices": [
                        {
                            "id": "690610207",
                            "text": "好高的评价…",
                            "response": [
                                {
                                    "id": "690610208",
                                    "speaker": "绮良良",
                                    "text": "这是你应得的，我才该多谢谢你。"
                                },
                                {
                                    "id": "690610211",
                                    "speaker": "Player",
                                    "text": "还有其他感想吗？"
                                },
                                {
                                    "id": "690610212",
                                    "speaker": "绮良良",
                                    "text": "噢噢，我懂，是最后的简答部分，好大一个空格子对吧！"
                                },
                                {
                                    "id": "690610213",
                                    "speaker": "绮良良",
                                    "text": "唔…我想想啊。"
                                },
                                {
                                    "id": "690610214",
                                    "speaker": "绮良良",
                                    "text": "我对那只个头大大的碧团雀挺感兴趣的。看上去胖墩墩、毛茸茸的，模样很悠闲，警惕性也低…",
                                    "choices": [
                                        {
                                            "id": "690610215",
                                            "text": "那是壶灵阿圆。",
                                            "response": [
                                                {
                                                    "id": "690610216",
                                                    "speaker": "绮良良",
                                                    "text": "壶灵？跟付丧神类似吗？难道说她的本体是个茶壶？"
                                                },
                                                {
                                                    "id": "690610217",
                                                    "speaker": "绮良良",
                                                    "text": "还是说…现在的样子正是她原本的形态，而她也像我一样，能变成一名少女？"
                                                },
                                                {
                                                    "id": "690610218",
                                                    "speaker": "绮良良",
                                                    "text": "哎呀，太让人好奇了！请介绍我跟她认识认识吧！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690610219",
                                            "text": "她可不能吃。",
                                            "response": [
                                                {
                                                    "id": "690610220",
                                                    "speaker": "绮良良",
                                                    "text": "啊！不会的，不会的。"
                                                },
                                                {
                                                    "id": "690610221",
                                                    "speaker": "绮良良",
                                                    "text": "我只是有一点点好奇而已，想知道她是怎么来的，平时会想些什么、做点什么…说不定还能交上朋友。"
                                                },
                                                {
                                                    "id": "690610222",
                                                    "speaker": "绮良良",
                                                    "text": "有机会的话，请介绍我跟她认识认识吧！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690610209",
                            "text": "好认真的回答…",
                            "response": [
                                {
                                    "id": "690610210",
                                    "speaker": "绮良良",
                                    "text": "你做了那么多，有这个机会，我当然要好好表达自己的心情。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906103",
            "initDialog": "690610301",
            "dialogues": [
                {
                    "id": "690610301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690610302",
                    "speaker": "绮良良",
                    "text": "好呀，有什么想问我的吗？"
                },
                {
                    "id": "690610303",
                    "speaker": "Player",
                    "text": "聊聊快递工作？"
                },
                {
                    "id": "690610304",
                    "speaker": "绮良良",
                    "text": "噢，这个话题好！"
                },
                {
                    "id": "690610305",
                    "speaker": "绮良良",
                    "text": "接单量对我来说不是难事，妖怪的腿脚天生跑得就快。"
                },
                {
                    "id": "690610306",
                    "speaker": "绮良良",
                    "text": "但好评率就没那么容易维持了。怕麻烦，不想多费周折是人之常情…"
                },
                {
                    "id": "690610307",
                    "speaker": "绮良良",
                    "text": "奇怪…为什么是只猫的时候，路过的人会花时间来看我晒太阳，但变成人后就没人愿意多花些时间给个好评呢？",
                    "choices": [
                        {
                            "id": "690610308",
                            "text": "不辛苦吗？",
                            "response": [
                                {
                                    "id": "690610309",
                                    "speaker": "绮良良",
                                    "text": "可能会有一点吧，尤其在筹备祭典的时候，加急件总会像墩墩桃那样挤在一堆。"
                                },
                                {
                                    "id": "690610310",
                                    "speaker": "绮良良",
                                    "text": "真想妖力变得更强些。这样说不定能跑得更快，或者变出好多个自己。",
                                    "choices": [
                                        {
                                            "id": "690610311",
                                            "text": "一只猫又两条尾巴…",
                                            "response": [
                                                {
                                                    "id": "690610313",
                                                    "speaker": "绮良良",
                                                    "text": "停停停！再数下去感觉尾巴都要打结了！"
                                                },
                                                {
                                                    "id": "690610317",
                                                    "speaker": "Player",
                                                    "text": "听上去你很热爱工作。"
                                                },
                                                {
                                                    "id": "690610318",
                                                    "speaker": "绮良良",
                                                    "text": "是啊。多亏了它，我才能这样融入人类的城市。"
                                                },
                                                {
                                                    "id": "690610319",
                                                    "speaker": "绮良良",
                                                    "text": "负责一点…才能算「报恩」？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690610312",
                                            "text": "三只猫又六条尾巴…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690610314",
                            "text": "收效如何？",
                            "response": [
                                {
                                    "id": "690610315",
                                    "speaker": "绮良良",
                                    "text": "嘿嘿，我现在是唯一一位，「狛荷屋」金牌级快递员。"
                                },
                                {
                                    "id": "690610316",
                                    "speaker": "绮良良",
                                    "text": "之前老板还想给我一笔特别奖励呢！但我也说了，还是公费出游…啊不，还是多给我些接跨国件的机会更好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906104",
            "initDialog": "690610401",
            "dialogues": [
                {
                    "id": "690610401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690610402",
                    "speaker": "绮良良",
                    "text": "啊，我有个事情早就想问你了。"
                },
                {
                    "id": "690610403",
                    "speaker": "绮良良",
                    "text": "#{M#你知道人类女孩子喜欢些什么打扮吗？}{F#你喜欢怎样打扮自己呀？}"
                },
                {
                    "id": "690610404",
                    "speaker": "Player",
                    "text": "这个…"
                },
                {
                    "id": "690610405",
                    "speaker": "绮良良",
                    "text": "太突然了吗？抱歉抱歉！那我从头讲好了。"
                },
                {
                    "id": "690610406",
                    "speaker": "绮良良",
                    "text": "你知道，我虽然是个妖怪，但从小时候起，就一直受到人类奶奶的照顾。"
                },
                {
                    "id": "690610407",
                    "speaker": "绮良良",
                    "text": "人的故事，比妖的故事，听得多的多了。温暖又多彩的人类社会，我非常向往！"
                },
                {
                    "id": "690610408",
                    "speaker": "绮良良",
                    "text": "于是，我好不容易才用妖力变出了现在的外貌，可新的问题又来了。如果打扮和举止太像「猫又」，也不太好…"
                },
                {
                    "id": "690610409",
                    "speaker": "绮良良",
                    "text": "所以，我偷偷观察了人类女孩子的打扮，大家似乎都很喜欢蝴蝶结和花朵…"
                },
                {
                    "id": "690610410",
                    "speaker": "绮良良",
                    "text": "我就给自己的衣服加了不少！",
                    "choices": [
                        {
                            "id": "690610411",
                            "text": "的确很可爱。",
                            "response": [
                                {
                                    "id": "690610412",
                                    "speaker": "绮良良",
                                    "text": "真的吗？那太好啦。"
                                },
                                {
                                    "id": "690610415",
                                    "speaker": "绮良良",
                                    "text": "那个…等你什么时候有空，可以陪我逛逛商店吗？"
                                },
                                {
                                    "id": "690610416",
                                    "speaker": "绮良良",
                                    "text": "我想买些好看的小饰品，有你提供意见，肯定会更顺利！"
                                }
                            ]
                        },
                        {
                            "id": "690610413",
                            "text": "不如再搭配点别的。",
                            "response": [
                                {
                                    "id": "690610414",
                                    "speaker": "绮良良",
                                    "text": "哇，你很懂行呀？我果然没有问错人！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6906105",
            "initDialog": "690610501",
            "dialogues": [
                {
                    "id": "690610501",
                    "speaker": "Player",
                    "text": "早啊，绮良良。"
                },
                {
                    "id": "690610502",
                    "speaker": "绮良良",
                    "text": "#早，{NICKNAME}！我今天看起来还不错吧？"
                },
                {
                    "id": "690610503",
                    "speaker": "绮良良",
                    "text": "你放心，这里的团雀我一只都不会碰的！"
                }
            ]
        },
        {
            "talkId": "6906106",
            "initDialog": "690610601",
            "dialogues": [
                {
                    "id": "690610601",
                    "speaker": "Player",
                    "text": "晚安，绮良良。"
                },
                {
                    "id": "690610602",
                    "speaker": "绮良良",
                    "text": "晚安。梦里要是听到嘎吱嘎吱声的话，可不要觉得奇怪。"
                },
                {
                    "id": "690610603",
                    "speaker": "绮良良",
                    "text": "我…我尽量不在半夜吃东西。"
                }
            ]
        },
        {
            "talkId": "6906107",
            "initDialog": "690610701",
            "dialogues": [
                {
                    "id": "690610701",
                    "speaker": "绮良良",
                    "text": "我喜欢这样的街景！既热闹又漂亮。"
                },
                {
                    "id": "690610702",
                    "speaker": "绮良良",
                    "text": "尤其是爬上房顶，从上往下看着人们来来往往的时候，特别有意思！"
                },
                {
                    "id": "690610703",
                    "speaker": "绮良良",
                    "text": "欸对了，机会难得，不如和我一起试试吧！"
                }
            ]
        },
        {
            "talkId": "6906108",
            "initDialog": "690610801",
            "dialogues": [
                {
                    "id": "690610801",
                    "speaker": "绮良良",
                    "text": "这两颗大树看起来好结实啊！树叶也好密实。"
                },
                {
                    "id": "690610802",
                    "speaker": "绮良良",
                    "text": "要是爬到上面睡觉的话，一定很舒服吧！"
                },
                {
                    "id": "690610803",
                    "speaker": "绮良良",
                    "text": "微风吹拂树叶的声音，再加上喷泉的流水声…啊——我已经困了…"
                }
            ]
        }
    ]
}