{
    "groupId": "5133",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "奥格劳": 13
    },
    "talks": [
        {
            "talkId": "6513301",
            "initDialog": "651330101",
            "dialogues": [
                {
                    "id": "651330101",
                    "speaker": "奥格劳",
                    "text": "你好，请问需要帮助吗？"
                }
            ]
        },
        {
            "talkId": "6513302",
            "initDialog": "651330201",
            "dialogues": [
                {
                    "id": "651330201",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "651330202",
                    "speaker": "奥格劳",
                    "text": "我是负责维护海露港治安的警备队员，遇到麻烦请不用不好意思，大声叫我吧。"
                },
                {
                    "id": "651330203",
                    "speaker": "奥格劳",
                    "text": "我的眼神很好，跑得也快，就算有被通缉的嫌疑犯想从这里逃去国外，也要先过我这关。"
                },
                {
                    "id": "651330204",
                    "speaker": "奥格劳",
                    "text": "哈哈，开个玩笑，说得夸张了。"
                },
                {
                    "id": "651330205",
                    "speaker": "奥格劳",
                    "text": "这里虽然看起来人来船往，但大部分工作都是由机械完成的，一切井然有序。"
                }
            ]
        },
        {
            "talkId": "6513303",
            "initDialog": "651330301",
            "dialogues": [
                {
                    "id": "651330301",
                    "speaker": "Player",
                    "text": "关于「预言」…"
                },
                {
                    "id": "651330302",
                    "speaker": "奥格劳",
                    "text": "对于这种很玄的东西，我都是宁可信其有的啦。"
                },
                {
                    "id": "651330303",
                    "speaker": "奥格劳",
                    "text": "然后结果就是，不同的传言之间会产生冲突。若我对它们都过分执着呢，就要过上整日纠结的生活了。"
                },
                {
                    "id": "651330304",
                    "speaker": "奥格劳",
                    "text": "我觉得都可以相信，但没必要想得太深。我只是一个在人类中能力也算普通的人，没有改变命运的野心。"
                },
                {
                    "id": "651330305",
                    "speaker": "奥格劳",
                    "text": "无论是哪种传言成真，我都会欣然接受的。"
                }
            ]
        },
        {
            "talkId": "6513304",
            "initDialog": "651330401",
            "dialogues": [
                {
                    "id": "651330401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651330402",
                    "speaker": "奥格劳",
                    "text": "注意安全，一路顺风。"
                }
            ]
        },
        {
            "talkId": "6513305",
            "initDialog": "651330501",
            "dialogues": [
                {
                    "id": "651330501",
                    "speaker": "Player",
                    "text": "关于「预言」…"
                },
                {
                    "id": "651330502",
                    "speaker": "奥格劳",
                    "text": "没想到「预言」真的发生了！虽然实现得和预期不太一样吧…"
                },
                {
                    "id": "651330503",
                    "speaker": "奥格劳",
                    "text": "倒不是说我为此失落啦，不如说是庆幸吧！毕竟虽然水灾造成了一些麻烦，但我们枫丹人并没有真的溶解呢。"
                },
                {
                    "id": "651330504",
                    "speaker": "奥格劳",
                    "text": "而且灾害之前沫芒宫就给我们布置了应急预案，所以没有造成特别大的损失，真是谢天谢地啦。"
                }
            ]
        }
    ]
}