    },
    "talks": [
        {
            "talkId": "6607001",
            "initDialog": "660700101",
            "dialogues": [
                {
                    "id": "660700101",
                    "speaker": "叶莱菲",
                    "text": "欢迎光临「奥特华的渔网」！"
                }
            ]
        },
        {
            "talkId": "6607002",
            "initDialog": "660700201",
            "dialogues": [
                {
                    "id": "660700201",
                    "speaker": "Player",
                    "text": "这里都卖什么？"
                },
                {
                    "id": "660700202",
                    "speaker": "叶莱菲",
                    "text": "主要是渔具啦。有水就有鱼嘛，来流泉之众垂钓的人可多了。"
                },
                {
                    "id": "660700203",
                    "speaker": "叶莱菲",
                    "text": "托大家的福，这里生意不错哦，鱼竿坏了也可以找我来修！"
                },
                {
                    "id": "660700204",
                    "speaker": "叶莱菲",
                    "text": "我很会做手工，所以小徽章、小摆件什么的，店里也有卖。"
                },
                {
                    "id": "660700205",
                    "speaker": "叶莱菲",
                    "text": "有不少游客想带些纪念品回去，我也可以帮忙定制，刻个名字或者标志什么的，很简单的！"
                }
            ]
        },
        {
            "talkId": "6607003",
            "initDialog": "660700301",
            "dialogues": [
                {
                    "id": "660700301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660700302",
                    "speaker": "叶莱菲",
                    "text": "慢走，下次再来呀！"
                }
            ]
        },
        {
            "talkId": "6607004",
            "initDialog": "660700401",
            "dialogues": [
                {
                    "id": "660700401",
                    "speaker": "叶莱菲",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6607005",
            "initDialog": "660700501",
            "dialogues": [
                {
                    "id": "660700501",
                    "speaker": "叶莱菲",
                    "text": "不好意思，这次是我赢了！"
                }
            ]
        },
        {
            "talkId": "6607006",
            "initDialog": "660700601",
            "dialogues": [
                {
                    "id": "660700601",
                    "speaker": "叶莱菲",
                    "text": "嘿嘿，输了。下次再一起来玩呀！"
                }
            ]
        }
    ]
}