{
    "groupId": "6074",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "马西娜·努伊": 11
    },
    "talks": [
        {
            "talkId": "6607401",
            "initDialog": "660740101",
            "dialogues": [
                {
                    "id": "660740101",
                    "speaker": "马西娜·努伊",
                    "text": "你好，欢迎光临！有什么需要请跟我讲吧。"
                }
            ]
        },
        {
            "talkId": "6607402",
            "initDialog": "660740201",
            "dialogues": [
                {
                    "id": "660740201",
                    "speaker": "Player",
                    "text": "有什么推荐？"
                },
                {
                    "id": "660740202",
                    "speaker": "马西娜·努伊",
                    "text": "冷饮，我亲手调配的冷饮！"
                },
                {
                    "id": "660740203",
                    "speaker": "马西娜·努伊",
                    "text": "虽然种类上和烟谜主那边的不能比，但重在清爽、凉快。"
                },
                {
                    "id": "660740204",
                    "speaker": "马西娜·努伊",
                    "text": "你看，这边泡温泉的人这么多，大家从热乎乎的水里出来，脸都红透了。"
                },
                {
                    "id": "660740205",
                    "speaker": "马西娜·努伊",
                    "text": "这时如果能来一杯冰牛奶或者薄荷饮，一定很舒服吧！"
                }
            ]
        },
        {
            "talkId": "6607403",
            "initDialog": "660740301",
            "dialogues": [
                {
                    "id": "660740301",
                    "speaker": "Player",
                    "text": "暂时不用。"
                },
                {
                    "id": "660740302",
                    "speaker": "马西娜·努伊",
                    "text": "想喝冷饮就来找我吧！"
                }
            ]
        },
        {
            "talkId": "6607404",
            "initDialog": "660740401",
            "dialogues": [
                {
                    "id": "660740401",
                    "speaker": "马西娜·努伊",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6607405",
            "initDialog": "660740501",
            "dialogues": [
                {
                    "id": "660740501",
                    "speaker": "马西娜·努伊",
                    "text": "别灰心！先来点薄荷提提神！然后我们再战！"
                }
            ]
        },
        {
            "talkId": "6607406",
            "initDialog": "660740601",
            "dialogues": [
                {
                    "id": "660740601",
                    "speaker": "马西娜·努伊",
                    "text": "打得好！要不要喝一杯冰牛奶来庆祝一下？"
                }
            ]
        },
        {
            "talkId": "7593101",
            "initDialog": "759310101",
            "dialogues": [
                {
                    "id": "759310101",
                    "speaker": "Player",
                    "text": "平时喝也挺不错的。"
                },
                {
                    "id": "759310102",
                    "speaker": "马西娜·努伊",
                    "text": "啊，确实！"
                },
                {
                    "id": "759310103",
                    "speaker": "马西娜·努伊",
                    "text": "这里天气一直很热嘛，大家都容易晕乎乎的，需要一些薄荷提神！"
                }
            ]
        }
    ]
}