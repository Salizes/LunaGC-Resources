            "initDialog": "642450101",
            "dialogues": [
                {
                    "id": "642450101",
                    "speaker": "索赫尔",
                    "text": "年轻学者怎么都这么浮躁…"
                }
            ]
        },
        {
            "talkId": "6424502",
            "initDialog": "642450201",
            "dialogues": [
                {
                    "id": "642450201",
                    "speaker": "Player",
                    "text": "还在烦恼？"
                },
                {
                    "id": "642450202",
                    "speaker": "索赫尔",
                    "text": "是啊，现在依然有年轻学者费尽心思往沙漠里钻。"
                },
                {
                    "id": "642450203",
                    "speaker": "索赫尔",
                    "text": "搞得我每天都要带着哈尔瓦尼在附近转上几圈，脑袋昏昏双脚疼，也没空研究你们辛苦找来的石板。"
                },
                {
                    "id": "642450204",
                    "speaker": "索赫尔",
                    "text": "唉，不知道什么时候才能回教令院。"
                }
            ]
        },
        {
            "talkId": "6424503",
            "initDialog": "642450301",
            "dialogues": [
                {
                    "id": "642450301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642450302",
                    "speaker": "索赫尔",
                    "text": "再见，祝你们旅途顺利。"
                }
            ]
        }
    ]
}