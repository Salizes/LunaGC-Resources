            "dialogues": [
                {
                    "id": "726642101",
                    "speaker": "琳阳",
                    "text": "喔！这个啊，我看看…"
                },
                {
                    "id": "726642102",
                    "speaker": "琳阳",
                    "text": "璃月地区的宝箱和逐月符，是由甜甜来负责布置的…我把你帮一部分宝箱和逐月符的位置标记好。"
                },
                {
