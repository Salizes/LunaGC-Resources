{
    "groupId": "1779",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 5,
        "洛森莎尔": 16
    },
    "talks": [
        {
            "talkId": "6177901",
            "initDialog": "617790101",
            "dialogues": [
                {
                    "id": "617790101",
                    "speaker": "洛森莎尔",
                    "text": "风神保佑，希望远征一切顺利…"
                }
            ]
        },
        {
            "talkId": "6177902",
            "initDialog": "617790201",
            "dialogues": [
                {
                    "id": "617790201",
                    "speaker": "洛森莎尔",
                    "text": "安塞姆回来前，可得好好打扫一番才行…"
                }
            ]
        },
        {
            "talkId": "6177903",
            "initDialog": "617790301",
            "dialogues": [
                {
                    "id": "617790301",
                    "speaker": "Player",
                    "text": "远征？"
                },
                {
                    "id": "617790302",
                    "speaker": "洛森莎尔",
                    "text": "是啊，我丈夫安塞姆，现在正跟随法尔伽团长远征呢。"
                },
                {
                    "id": "617790303",
                    "speaker": "洛森莎尔",
                    "text": "他之前寄回来的信中说，西蒙枢机卿被调去别处以后，他就被提拔成了新的副官…"
                },
                {
                    "id": "617790304",
                    "speaker": "洛森莎尔",
                    "text": "虽说是荣誉，但一想到那可是灾害肆虐的挪德卡莱，我就忍不住担心…他一个负责后勤的，要是真遇上了魔物，该怎么办呀…"
                }
            ]
        },
        {
            "talkId": "6177904",
            "initDialog": "617790401",
            "dialogues": [
                {
                    "id": "617790401",
                    "speaker": "Player",
                    "text": "愿风神保佑。"
                },
                {
                    "id": "617790402",
                    "speaker": "洛森莎尔",
                    "text": "谢谢你，愿风神也保佑你的旅途。"
                }
            ]
        },
        {
            "talkId": "6177905",
            "initDialog": "617790501",
            "dialogues": [
                {
                    "id": "617790501",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "617790502",
                    "speaker": "洛森莎尔",
                    "text": "呵呵，这可是名为扫除的战斗！"
                },
                {
                    "id": "617790503",
                    "speaker": "洛森莎尔",
                    "text": "自从远征队实行了轮换值守制度，安塞姆那个死鬼终于能经常回家看看了。"
                },
                {
                    "id": "617790504",
                    "speaker": "洛森莎尔",
                    "text": "虽然只是短暂的休整，但我可不能让他看见家里乱糟糟的样子。"
                },
                {
                    "id": "617790505",
                    "speaker": "洛森莎尔",
                    "text": "要是让他看见窗台上有灰，指不定又要像在营地里教训新兵那样念叨我咯。"
                },
                {
                    "id": "617790506",
                    "speaker": "洛森莎尔",
                    "text": "哼，他敢念叨，我就敢让他睡地板。"
                }
            ]
        },
        {
            "talkId": "6177906",
            "initDialog": "617790601",
            "dialogues": [
                {
                    "id": "617790601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617790602",
                    "speaker": "洛森莎尔",
                    "text": "慢走啊，有空常来这儿坐坐。"
                }
            ]
        },
        {
            "talkId": "6177907",
            "initDialog": "617790701",
            "dialogues": [
                {
                    "id": "617790701",
                    "speaker": "Player",
                    "text": "相信西风骑士团吧。"
                },
                {
                    "id": "617790702",
                    "speaker": "洛森莎尔",
                    "text": "唉，我当然相信咱们的西风骑士团，我只是信不过安塞姆那个身子骨。"
                },
                {
                    "id": "617790703",
                    "speaker": "洛森莎尔",
                    "text": "家家都有难念的经吧。喏，隔壁倒是没人去远征，可我亲爱的邻居还是对他们的闺女放心不下。"
                },
                {
                    "id": "617790704",
                    "speaker": "洛森莎尔",
                    "text": "那小姑娘…我记得好像是叫莫娜？听说是在蒙德城里租了房子，给人算命赚钱。"
                },
                {
                    "id": "617790705",
                    "speaker": "洛森莎尔",
                    "text": "明明家里这么有钱，还是不肯和父母住，非得一天到晚奔波…各有各的追求啊。"
                }
            ]
        }
    ]
}