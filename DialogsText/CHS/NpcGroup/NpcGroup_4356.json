{
    "groupId": "4356",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "阿巴克": 14
    },
    "talks": [
        {
            "talkId": "6435601",
            "initDialog": "643560101",
            "dialogues": [
                {
                    "id": "643560101",
                    "speaker": "阿巴克",
                    "text": "莎菲小妹…好像又不见了。"
                }
            ]
        },
        {
            "talkId": "6435602",
            "initDialog": "643560201",
            "dialogues": [
                {
                    "id": "643560201",
                    "speaker": "Player",
                    "text": "你在找人？"
                },
                {
                    "id": "643560202",
                    "speaker": "阿巴克",
                    "text": "对。"
                },
                {
                    "id": "643560203",
                    "speaker": "阿巴克",
                    "text": "…啊，请不要误会，莎菲并非我的亲妹妹，只是团里的大家彼此间都很熟悉，所以经常互称兄弟姐妹。"
                },
                {
                    "id": "643560204",
                    "speaker": "阿巴克",
                    "text": "最近团里接到一些新的委托，本来有很适合她的任务，结果她人不在…大概又是去哪里闲逛了吧。"
                }
            ]
        },
        {
            "talkId": "6435603",
            "initDialog": "643560301",
            "dialogues": [
                {
                    "id": "643560301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643560302",
                    "speaker": "阿巴克",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6435604",
            "initDialog": "643560401",
            "dialogues": [
                {
                    "id": "643560401",
                    "speaker": "Player",
                    "text": "要不你亲自上？"
                },
                {
                    "id": "643560402",
                    "speaker": "阿巴克",
                    "text": "哈哈，倒不必，我们还没有缺人到那个地步。"
                },
                {
                    "id": "643560403",
                    "speaker": "阿巴克",
                    "text": "我是驻守在喀万驿的镀金旅团的领头人，最好还是留在这里盯着附近的治安，以及防沙壁的维护工作。"
                },
                {
                    "id": "643560404",
                    "speaker": "阿巴克",
                    "text": "这些都是教令院下达的基本命令，由我来对付就好。"
                },
                {
                    "id": "643560405",
                    "speaker": "阿巴克",
                    "text": "至于其他的委托，就让兄弟姐妹们去办吧。大家都有钱赚，才能一起过得开心。"
                }
            ]
        },
        {
            "talkId": "6435605",
            "initDialog": "643560501",
            "dialogues": [
                {
                    "id": "643560501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6435606",
            "initDialog": "643560601",
            "dialogues": [
                {
                    "id": "643560601",
                    "speaker": "阿巴克",
                    "text": "哈哈哈！别灰心！打牌和冒险一样，有成功也有失败，都很正常！"
                }
            ]
        },
        {
            "talkId": "6435607",
            "initDialog": "643560701",
            "dialogues": [
                {
                    "id": "643560701",
                    "speaker": "阿巴克",
                    "text": "好强的掌控力！看来你是个打牌的天才啊，我输得不冤！"
                }
            ]
        },
        {
            "talkId": "7395801",
            "initDialog": "739580101",
            "dialogues": [
                {
                    "id": "739580101",
                    "speaker": "Player",
                    "text": "要我帮忙吗？"
                },
                {
                    "id": "739580102",
                    "speaker": "阿巴克",
                    "text": "不用，并非什么急事，不需要劳动外人。"
                },
                {
                    "id": "739580103",
                    "speaker": "阿巴克",
                    "text": "而且凭小妹的本事，她应该也能照顾好自己。"
                },
                {
                    "id": "739580104",
                    "speaker": "阿巴克",
                    "text": "倒是你，在这附近可要多注意安全啊。这里人来人往…你懂的。"
                }
            ]
        }
    ]
}