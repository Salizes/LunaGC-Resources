{
    "groupId": "2120",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "富贵": 17
    },
    "talks": [
        {
            "talkId": "6212001",
            "initDialog": "621200101",
            "dialogues": [
                {
                    "id": "621200101",
                    "speaker": "富贵",
                    "text": "这好的茶啊，就会久久回甘，而差的茶叶则像是吞了一块石头一样，锁喉…"
                },
                {
                    "id": "621200102",
                    "speaker": "富贵",
                    "text": "你来找我做什么，莫非…你也是来找我看相的？"
                }
            ]
        },
        {
            "talkId": "6212002",
            "initDialog": "621200201",
            "dialogues": [
                {
                    "id": "621200201",
                    "speaker": "Player",
                    "text": "看相？"
                },
                {
                    "id": "621200202",
                    "speaker": "富贵",
                    "text": "不是我吹，只要我定睛一看，不但能看出你的吉凶祸福，还能一眼看出谁心里有鬼、谁是坏人！"
                },
                {
                    "id": "621200203",
                    "speaker": "富贵",
                    "text": "最近我在帮路过的人免费看相，怎么样，有兴趣吗？"
                },
                {
                    "id": "621200204",
                    "speaker": "Player",
                    "text": "能帮我看看吗？"
                },
                {
                    "id": "621200205",
                    "speaker": "富贵",
                    "text": "行啊！让我看看…"
                },
                {
                    "id": "621200206",
                    "speaker": "富贵",
                    "text": "天庭饱满、地阁方圆，五官端正，眉清目秀，气色红润…"
                },
                {
                    "id": "621200207",
                    "speaker": "富贵",
                    "text": "嗯？你脸上…好像有点儿红。",
                    "choices": [
                        {
                            "id": "621200208",
                            "text": "精神焕发！",
                            "response": [
                                {
                                    "id": "621200209",
                                    "speaker": "富贵",
                                    "text": "…答得底气十足、字正腔圆，不像是心里有鬼的样子，看样子是个好人…"
                                },
                                {
                                    "id": "621200210",
                                    "speaker": "富贵",
                                    "text": "…嗯，我可以看得出你未来命中有一笔大财，只是按照你现在的趋势很可能会与其擦肩而过。"
                                },
                                {
                                    "id": "621200211",
                                    "speaker": "富贵",
                                    "text": "所以，不要贪图享乐、好逸恶劳，好好努力，你在未来一定会有所收获，明白了吗。"
                                }
                            ]
                        },
                        {
                            "id": "621200212",
                            "text": "刚才战斗时候磕的…",
                            "response": [
                                {
                                    "id": "621200213",
                                    "speaker": "富贵",
                                    "text": "…能磕的这么对称吗，不过你的面相，看着也不像是坏人…"
                                },
                                {
                                    "id": "621200214",
                                    "speaker": "富贵",
                                    "text": "…嗯，我可以看得出你未来命中必有一劫，但是如果好好努力、脚踏实地，你就能逢凶化吉。"
                                },
                                {
                                    "id": "621200215",
                                    "speaker": "富贵",
                                    "text": "所以，不要好高骛远、投机取巧，也许不是大富大贵的命，但一定会平安无事，明白了吗。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6212003",
            "initDialog": "621200301",
            "dialogues": [
                {
                    "id": "621200301",
                    "speaker": "Player",
                    "text": "能分我一杯茶吗？"
                },
                {
                    "id": "621200302",
                    "speaker": "富贵",
                    "text": "那可不行！我这可是上好的茶叶，你就别想了。"
                }
            ]
        },
        {
            "talkId": "6212004",
            "initDialog": "621200401",
            "dialogues": [
                {
                    "id": "621200401",
                    "speaker": "Player",
                    "text": "你见过长得和我很像的人吗？"
                },
                {
                    "id": "621200402",
                    "speaker": "富贵",
                    "text": "这你算是问对人了，我经常在这里帮别人看相，阅人无数，让我先看看你的脸…"
                },
                {
                    "id": "621200403",
                    "speaker": "富贵",
                    "text": "我看阁下，天庭饱满、地阁方圆，五官端正，眉清目秀，气色红润，莫非…"
                },
                {
                    "id": "621200404",
                    "speaker": "富贵",
                    "text": "…不，像阁下这般气宇轩昂、英姿焕发的人，怎么可能有第二个？"
                }
            ]
        }
    ]
}