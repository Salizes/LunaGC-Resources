{
    "groupId": "2445",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "骆丰": 10
    },
    "talks": [
        {
            "talkId": "6244501",
            "initDialog": "624450101",
            "dialogues": [
                {
                    "id": "624450101",
                    "speaker": "骆丰",
                    "text": "幸会，敢问阁下尊姓大名？"
                }
            ]
        },
        {
            "talkId": "6244502",
            "initDialog": "624450201",
            "dialogues": [
                {
                    "id": "624450201",
                    "speaker": "Player",
                    "text": "我只是个普通的旅行者。"
                },
                {
                    "id": "624450202",
                    "speaker": "骆丰",
                    "text": "阁下实在是太谦虚了！"
                },
                {
                    "id": "624450203",
                    "speaker": "骆丰",
                    "text": "我看阁下年纪轻轻、一表人才，日后前途不可限量啊！"
                },
                {
                    "id": "624450204",
                    "speaker": "骆丰",
                    "text": "在下骆丰，乃是一介商人，如是日后有用得上在下的地方，阁下尽管开口…"
                },
                {
                    "id": "624450205",
                    "speaker": "骆丰",
                    "text": "…当然，礼尚往来，若是以后在下有求于您，也请您一定要鼎力相助啊！"
                }
            ]
        },
        {
            "talkId": "6244503",
            "initDialog": "624450301",
            "dialogues": [
                {
                    "id": "624450301",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "624450302",
                    "speaker": "骆丰",
                    "text": "那当然是拓展人脉了！"
                },
                {
                    "id": "624450303",
                    "speaker": "骆丰",
                    "text": "很多人都没意识到，其实这「珠钿舫」最有价值的是船上的客人啊！"
                },
                {
                    "id": "624450304",
                    "speaker": "骆丰",
                    "text": "能到这里的，哪个不是达官显贵？倘若能结交到一两位大人物，那才是真的不虚此行…"
                },
                {
                    "id": "624450305",
                    "speaker": "骆丰",
                    "text": "嘿嘿，不多聊了，我得抓紧时间多认识些人，争取混个脸熟。"
                }
            ]
        },
        {
            "talkId": "6244504",
            "initDialog": "624450401",
            "dialogues": [
                {
                    "id": "624450401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624450402",
                    "speaker": "骆丰",
                    "text": "与您一见，三生有幸！"
                }
            ]
        }
    ]
}