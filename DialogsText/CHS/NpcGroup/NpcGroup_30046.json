{
    "groupId": "30046",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 7,
        "莉兹": 8
    },
    "talks": [
        {
            "talkId": "7065401",
            "initDialog": "706540101",
            "dialogues": [
                {
                    "id": "706540101",
                    "speaker": "莉兹",
                    "text": "你好，之前推荐给你的活动，玩得还开心吗？",
                    "choices": [
                        {
                            "id": "706540102",
                            "text": "还不错。",
                            "response": [
                                {
                                    "id": "706540105",
                                    "speaker": "莉兹",
                                    "text": "哈哈哈。总之，我想给你推荐一个新的活动——「风中万花」！"
                                },
                                {
                                    "id": "706540106",
                                    "speaker": "莉兹",
                                    "text": "这个活动很刺激，如果你平时热爱冒险的话，肯定很适合你！"
                                },
                                {
                                    "id": "706540107",
                                    "speaker": "莉兹",
                                    "text": "从高高的地方跳下来，飞翔在空中，放声呐喊，呀吼——！",
                                    "choices": [
                                        {
                                            "id": "706540108",
                                            "text": "我也喜欢。",
                                            "response": [
                                                {
                                                    "id": "706540110",
                                                    "speaker": "莉兹",
                                                    "text": "嘿嘿，要不是我在这里招待客人，我已经去玩个痛快了。"
                                                },
                                                {
                                                    "id": "706540111",
                                                    "speaker": "莉兹",
                                                    "text": "和之前一样，只要得分够高，你就能获得奖品。",
                                                    "choices": [
                                                        {
                                                            "id": "706540112",
                                                            "text": "我去看看。",
                                                            "response": [
                                                                {
                                                                    "id": "706540114",
                                                                    "speaker": "莉兹",
                                                                    "text": "嗯嗯，快去试试看吧！接下来的活动，我还会为你介绍的。"
                                                                },
                                                                {
                                                                    "id": "706540115",
                                                                    "speaker": "莉兹",
                                                                    "text": "祝你玩得愉快！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "706540113",
                                                            "text": "不打扰你了。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "706540109",
                                            "text": "看起来你比我更感兴趣。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "706540103",
                            "text": "没有想象中有趣。"
                        },
                        {
                            "id": "706540104",
                            "text": "等下我就去试试…"
                        }
                    ]
                }
            ]
        }
    ]
}