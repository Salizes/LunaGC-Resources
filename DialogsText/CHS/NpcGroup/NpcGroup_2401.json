{
    "groupId": "2401",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "霹雳闪雷真君": 14
    },
    "talks": [
        {
            "talkId": "6240101",
            "initDialog": "624010101",
            "dialogues": [
                {
                    "id": "624010101",
                    "speaker": "霹雳闪雷真君",
                    "text": "「天下武功，唯快不破」。"
                },
                {
                    "id": "624010102",
                    "speaker": "霹雳闪雷真君",
                    "text": "怎么，这位道友也是来求仙问道的？"
                }
            ]
        },
        {
            "talkId": "6240102",
            "initDialog": "624010201",
            "dialogues": [
                {
                    "id": "624010201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624010202",
                    "speaker": "霹雳闪雷真君",
                    "text": "嘿嘿，也不瞒你，老夫便是隐居此处的仙人。"
                },
                {
                    "id": "624010203",
                    "speaker": "霹雳闪雷真君",
                    "text": "进得绝云间的凡人，个个筋骨惊奇、神采非凡…"
                },
                {
                    "id": "624010204",
                    "speaker": "霹雳闪雷真君",
                    "text": "老夫看了心中是喜不自胜，故在此地开坛收徒传道。"
                }
            ]
        },
        {
            "talkId": "6240103",
            "initDialog": "624010301",
            "dialogues": [
                {
                    "id": "624010301",
                    "speaker": "Player",
                    "text": "求仙问道？"
                },
                {
                    "id": "624010302",
                    "speaker": "霹雳闪雷真君",
                    "text": "对喽！有道是「先贤大能寻不得，便入破庙拜老仙」！"
                },
                {
                    "id": "624010303",
                    "speaker": "霹雳闪雷真君",
                    "text": "这您就要问了，求的什么仙？便是老夫。问的什么道？便是老夫的绝世武功之道。",
                    "choices": [
                        {
                            "id": "624010304",
                            "text": "这都什么乱七八糟的…",
                            "response": [
                                {
                                    "id": "624010305",
                                    "speaker": "霹雳闪雷真君",
                                    "text": "去！去！你这是对仙人不敬你知道吗！"
                                },
                                {
                                    "id": "624010306",
                                    "speaker": "霹雳闪雷真君",
                                    "text": "错过了向老夫求道的机会，你就一辈子后悔去吧！"
                                }
                            ]
                        },
                        {
                            "id": "624010307",
                            "text": "你都教些什么？",
                            "response": [
                                {
                                    "id": "624010308",
                                    "speaker": "霹雳闪雷真君",
                                    "text": "我呀，我教…不对，仙人的「道」，那能随便说吗！"
                                },
                                {
                                    "id": "624010309",
                                    "speaker": "霹雳闪雷真君",
                                    "text": "你也不能说「教」，那叫「传」，这都有讲究的。"
                                },
                                {
                                    "id": "624010310",
                                    "speaker": "霹雳闪雷真君",
                                    "text": "你要想知道，那这样：一个月七千摩拉，我传你武功秘籍，保你拳脚快如流星，轻若蝴蝶！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6240104",
            "initDialog": "624010401",
            "dialogues": [
                {
                    "id": "624010401",
                    "speaker": "Player",
                    "text": "…再见。"
                },
                {
                    "id": "624010402",
                    "speaker": "霹雳闪雷真君",
                    "text": "欸，欢迎再来。"
                },
                {
                    "id": "624010403",
                    "speaker": "霹雳闪雷真君",
                    "text": "那个有道是，「真拳师打不过乱披风，琉璃瓦拍死老师傅」…徒儿，记着这个！"
                }
            ]
        }
    ]
}