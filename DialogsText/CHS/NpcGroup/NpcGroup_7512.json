{
    "groupId": "7512",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 3,
        "梅金采夫": 7
    },
    "talks": [
        {
            "talkId": "6751201",
            "initDialog": "675120101",
            "dialogues": [
                {
                    "id": "675120101",
                    "speaker": "梅金采夫",
                    "text": "资金没问题，计划也很周全，市场调研也做好了…嗯，这次一定能行！"
                }
            ]
        },
        {
            "talkId": "6751202",
            "initDialog": "675120201",
            "dialogues": [
                {
                    "id": "675120201",
                    "speaker": "Player",
                    "text": "什么计划？"
                },
                {
                    "id": "675120202",
                    "speaker": "梅金采夫",
                    "text": "发大财的计划！朋友，你知道在至冬，什么东西最不愁卖吗？没错，是酒！尤其是烈酒！"
                },
                {
                    "id": "675120203",
                    "speaker": "梅金采夫",
                    "text": "我想过了，只要把蒙德的酒大批买来运到至冬，再花重金提纯，直到它变得和火水一样烈！绝对能大卖特卖！"
                }
            ]
        },
        {
            "talkId": "6751203",
            "initDialog": "675120301",
            "dialogues": [
                {
                    "id": "675120301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "675120302",
                    "speaker": "梅金采夫",
                    "text": "好的好的，再见啊！"
                }
            ]
        },
        {
            "talkId": "6751204",
            "initDialog": "675120401",
            "dialogues": [
                {
                    "id": "675120401",
                    "speaker": "Player",
                    "text": "…那为什么不直接卖火水呢？"
                },
                {
                    "id": "675120402",
                    "speaker": "梅金采夫",
                    "text": "呃…嘶，你说得好像有点道理…"
                },
                {
                    "id": "675120403",
                    "speaker": "梅金采夫",
                    "text": "说得对！我应该把火水拉去蒙德！稍微兑点水稀释一番，当成低度酒卖给他们，这样更妥帖更好赚！"
                },
                {
                    "id": "675120404",
                    "speaker": "梅金采夫",
                    "text": "等到那时，老爹肯定会对我的商业头脑刮目相看，家里产业的经营权也会归我了，哈哈哈哈！"
                }
            ]
        }
    ]
}