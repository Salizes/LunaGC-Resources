{
    "groupId": "1427",
    "total_dialogue_lines": 34,
    "speaker_counts": {
        "Player": 7,
        "唐娜": 27
    },
    "talks": [
        {
            "talkId": "6142704",
            "initDialog": "614270401",
            "dialogues": [
                {
                    "id": "614270401",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6142705",
            "initDialog": "614270501",
            "dialogues": [
                {
                    "id": "614270501",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6142706",
            "initDialog": "614270601",
            "dialogues": [
                {
                    "id": "614270601",
                    "speaker": "唐娜",
                    "text": "还是输掉了…"
                }
            ]
        },
        {
            "talkId": "6142707",
            "initDialog": "614270701",
            "dialogues": [
                {
                    "id": "614270701",
                    "speaker": "唐娜",
                    "text": "呼…吓死我了，我还以为赢不下来了呢…"
                }
            ]
        },
        {
            "talkId": "6142708",
            "initDialog": "614270801",
            "dialogues": [
                {
                    "id": "614270801",
                    "speaker": "唐娜",
                    "text": "唉，倒也不意外…"
                }
            ]
        },
        {
            "talkId": "6142709",
            "initDialog": "614270901",
            "dialogues": [
                {
                    "id": "614270901",
                    "speaker": "唐娜",
                    "text": "还好还好，我还以为拿不下来了呢…"
                }
            ]
        },
        {
            "talkId": "40167",
            "initDialog": "4015142701",
            "dialogues": [
                {
                    "id": "4015142701",
                    "speaker": "唐娜",
                    "text": "您好…请问您是要买花吗？"
                }
            ]
        },
        {
            "talkId": "6142701",
            "initDialog": "614270101",
            "dialogues": [
                {
                    "id": "614270101",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614270102",
                    "speaker": "唐娜",
                    "text": "一想到我们身边发生了这种事，我就从心底感到害怕…"
                },
                {
                    "id": "614270103",
                    "speaker": "唐娜",
                    "text": "（如果我要是被风魔龙抓走了，迪卢克大人一定会来救我的吧…）"
                },
                {
                    "id": "614270104",
                    "speaker": "唐娜",
                    "text": "（这、这难道不就是白马王子和被掳走的公主的经典情节吗？）"
                },
                {
                    "id": "614270105",
                    "speaker": "唐娜",
                    "text": "（那…说不定我和迪卢克大人的故事会被写成童话书…不对，都这种时候了我在想什么呢！）"
                },
                {
                    "id": "614270106",
                    "speaker": "唐娜",
                    "text": "总、总之，实在是太恐怖了，愿巴巴托斯大人的风护佑蒙德…"
                }
            ]
        },
        {
            "talkId": "6142702",
            "initDialog": "4015142702",
            "dialogues": [
                {
                    "id": "4015142702",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "4015142706",
                    "speaker": "唐娜",
                    "text": "欸？！"
                },
                {
                    "id": "4015142707",
                    "speaker": "唐娜",
                    "text": "我…我是这家花店的帮工。只是一个…普普通通的女孩子。"
                },
                {
                    "id": "4015142708",
                    "speaker": "唐娜",
                    "text": "（啊，我是不是脸红了。）"
                },
                {
                    "id": "4015142709",
                    "speaker": "唐娜",
                    "text": "（刚刚幻想着迪卢克大人送我花的事情，是不是已经被发现了…）"
                },
                {
                    "id": "4015142710",
                    "speaker": "唐娜",
                    "text": "啊…请不要那样看着我，真的没有什么特别的。",
                    "choices": [
                        {
                            "id": "4015142703",
                            "text": "迪卢克？",
                            "response": [
                                {
                                    "id": "4015142711",
                                    "speaker": "唐娜",
                                    "text": "啊，我…不小心，说出口了？"
                                },
                                {
                                    "id": "4015142712",
                                    "speaker": "唐娜",
                                    "text": "对不起…"
                                },
                                {
                                    "id": "4015142713",
                                    "speaker": "唐娜",
                                    "text": "我一直想着能够在这里偶遇迪卢克大人的事情，不自觉就…唔！"
                                },
                                {
                                    "id": "4015142714",
                                    "speaker": "唐娜",
                                    "text": "不，我没有…"
                                },
                                {
                                    "id": "4015142715",
                                    "speaker": "唐娜",
                                    "text": "（呜呜，怎么办，真的好喜欢迪卢克大人啊。）"
                                }
                            ]
                        },
                        {
                            "id": "4015142704",
                            "text": "月亮派？",
                            "response": [
                                {
                                    "id": "4015142716",
                                    "speaker": "唐娜",
                                    "text": "您是问…月亮派吗。"
                                },
                                {
                                    "id": "4015142717",
                                    "speaker": "唐娜",
                                    "text": "这是蒙德城很有名的特产，是一种扎实又香甜的肉派。"
                                },
                                {
                                    "id": "4015142718",
                                    "speaker": "唐娜",
                                    "text": "（要是我做了好吃的月亮派，送给迪卢克大人的话…）"
                                },
                                {
                                    "id": "4015142719",
                                    "speaker": "唐娜",
                                    "text": "（快，快打住啊唐娜！）"
                                },
                                {
                                    "id": "4015142720",
                                    "speaker": "唐娜",
                                    "text": "要要要是有机会，推荐您一定去店里尝一尝。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6142703",
            "initDialog": "4015142705",
            "dialogues": [
                {
                    "id": "4015142705",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "4015142721",
                    "speaker": "唐娜",
                    "text": "这，这样啊…"
                },
                {
                    "id": "4015142722",
                    "speaker": "唐娜",
                    "text": "愿您度过美好的一天。"
                }
            ]
        }
    ]
}