{
    "groupId": "5095",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "艾嘉莉亚": 12
    },
    "talks": [
        {
            "talkId": "6509501",
            "initDialog": "650950101",
            "dialogues": [
                {
                    "id": "650950101",
                    "speaker": "艾嘉莉亚",
                    "text": "需不需要再重新规划下餐具的收纳呢…"
                }
            ]
        },
        {
            "talkId": "6509502",
            "initDialog": "650950201",
            "dialogues": [
                {
                    "id": "650950201",
                    "speaker": "Player",
                    "text": "关于餐具…"
                },
                {
                    "id": "650950202",
                    "speaker": "艾嘉莉亚",
                    "text": "嗯，我正在思考饭店里各类用具的整理计划。"
                },
                {
                    "id": "650950203",
                    "speaker": "艾嘉莉亚",
                    "text": "之前餐具都是随意摆在比较靠外的架子上，方便取用。"
                },
                {
                    "id": "650950204",
                    "speaker": "艾嘉莉亚",
                    "text": "不过有一次被来这边演出的琳妮特小姐碰到，哗啦啦地碎了一地。"
                },
                {
                    "id": "650950205",
                    "speaker": "艾嘉莉亚",
                    "text": "还好没有伤到琳妮特小姐，要是那张可爱的面庞出了意外，大家都会伤心的…"
                }
            ]
        },
        {
            "talkId": "6509503",
            "initDialog": "650950301",
            "dialogues": [
                {
                    "id": "650950301",
                    "speaker": "Player",
                    "text": "咦？又一个…"
                },
                {
                    "id": "650950302",
                    "speaker": "艾嘉莉亚",
                    "text": "啊，您一定是在楼下见到了我的姐姐吧！"
                },
                {
                    "id": "650950303",
                    "speaker": "艾嘉莉亚",
                    "text": "我们是双胞胎哦，只论外表的话的确常被认错，但因为声音不同，一说话就会露馅啦。"
                },
                {
                    "id": "650950304",
                    "speaker": "艾嘉莉亚",
                    "text": "姐姐说话慢悠悠的，但是人很细心。如果在饭店一层有什么需要帮助的，请都交给她吧。"
                }
            ]
        },
        {
            "talkId": "6509504",
            "initDialog": "650950401",
            "dialogues": [
                {
                    "id": "650950401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650950402",
                    "speaker": "艾嘉莉亚",
                    "text": "欢迎再来。"
                }
            ]
        },
        {
            "talkId": "6509505",
            "initDialog": "650950501",
            "dialogues": [
                {
                    "id": "650950501",
                    "speaker": "Player",
                    "text": "深有同感。"
                },
                {
                    "id": "650950502",
                    "speaker": "艾嘉莉亚",
                    "text": "对吧？"
                },
                {
                    "id": "650950503",
                    "speaker": "艾嘉莉亚",
                    "text": "当时琳妮特不仅不怪我们没有收好餐具，还主动道歉，说自己经常这样…"
                },
                {
                    "id": "650950504",
                    "speaker": "艾嘉莉亚",
                    "text": "可能是因为怕我们尴尬，才这样说的吧。她看上去有些冷淡，但其实很谦虚，也非常有礼貌呢。"
                }
            ]
        }
    ]
}