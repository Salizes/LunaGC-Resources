{
    "groupId": "7784",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "伊格纳托夫": 14
    },
    "talks": [
        {
            "talkId": "6778401",
            "initDialog": "677840101",
            "dialogues": [
                {
                    "id": "677840101",
                    "speaker": "伊格纳托夫",
                    "text": "「善于欺骗自己的人，生活得最快活…」"
                }
            ]
        },
        {
            "talkId": "6778402",
            "initDialog": "677840201",
            "dialogues": [
                {
                    "id": "677840201",
                    "speaker": "Player",
                    "text": "…什么？"
                },
                {
                    "id": "677840202",
                    "speaker": "伊格纳托夫",
                    "text": "啊…！对不起，打扰到您用餐了么？我不小心又把书上的句子念出来了…"
                },
                {
                    "id": "677840203",
                    "speaker": "伊格纳托夫",
                    "text": "您需要我帮什么忙？是点餐，还是清理桌子？"
                }
            ]
        },
        {
            "talkId": "6778403",
            "initDialog": "677840301",
            "dialogues": [
                {
                    "id": "677840301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "677840302",
                    "speaker": "伊格纳托夫",
                    "text": "啊…好、好的。再见…"
                }
            ]
        },
        {
            "talkId": "6778404",
            "initDialog": "677840401",
            "dialogues": [
                {
                    "id": "677840401",
                    "speaker": "Player",
                    "text": "这倒是没有…你在看什么书？"
                },
                {
                    "id": "677840402",
                    "speaker": "伊格纳托夫",
                    "text": "是哲列兹诺夫先生给我的《惩罚》。唉，请您别告诉杜斯塔娅，否则她又要叹气了。"
                },
                {
                    "id": "677840403",
                    "speaker": "伊格纳托夫",
                    "text": "但请您也别误会，杜斯塔娅是我最好的朋友，多亏了她说服了我的父母，我才能在这里工作…"
                },
                {
                    "id": "677840404",
                    "speaker": "伊格纳托夫",
                    "text": "否则，以我父母的性格，是绝对不会容许我待在这里的…不、不过，我的父母也不是坏人，他们对我也很好…"
                }
            ]
        },
        {
            "talkId": "6778405",
            "initDialog": "677840501",
            "dialogues": [
                {
                    "id": "677840501",
                    "speaker": "Player",
                    "text": "怎么感觉每个人都很好…"
                },
                {
                    "id": "677840502",
                    "speaker": "伊格纳托夫",
                    "text": "…我父母不想我出来工作，是因为我身体太弱，不愿我生病。"
                },
                {
                    "id": "677840503",
                    "speaker": "伊格纳托夫",
                    "text": "杜斯塔娅想让我看点别的书，是因为她觉得…呵，这些书让我的心情越来越忧郁。"
                },
                {
                    "id": "677840504",
                    "speaker": "伊格纳托夫",
                    "text": "她们的确在关心着我，呵护着我，我非常感谢她们。但…抱歉，或许真的是因为我这个人性情古怪吧…"
                },
                {
                    "id": "677840505",
                    "speaker": "伊格纳托夫",
                    "text": "我总想着出去，想着跨出这一潭柔和的温泉，自己探入刺骨的冰窟里去。"
                },
                {
                    "id": "677840506",
                    "speaker": "伊格纳托夫",
                    "text": "哲列兹诺夫先生说，这是我自己正渴求着独属于自我的成长，并且又塞给了我一堆厚厚的书，说或许我能在这些书里找到答案…"
                },
                {
                    "id": "677840507",
                    "speaker": "伊格纳托夫",
                    "text": "然后…呵呵，他就被杜斯塔娅叉着腰请出去了。走的时候还又朝着我扮了个鬼脸。"
                },
                {
                    "id": "677840508",
                    "speaker": "伊格纳托夫",
                    "text": "…啊！我、我不能再聊下去了，我得去工作了，抱歉，如果您需要帮忙的话，直接叫我就行。"
                }
            ]
        }
    ]
}