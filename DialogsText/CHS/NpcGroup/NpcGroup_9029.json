{
    "groupId": "9029",
    "total_dialogue_lines": 70,
    "speaker_counts": {
        "Player": 21,
        "可莉": 49
    },
    "talks": [
        {
            "talkId": "6902901",
            "initDialog": "690290101",
            "dialogues": [
                {
                    "id": "690290101",
                    "speaker": "可莉",
                    "text": "#啊，是荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！"
                },
                {
                    "id": "690290102",
                    "speaker": "可莉",
                    "text": "太好了！可莉又见到你了。"
                }
            ]
        },
        {
            "talkId": "6902902",
            "initDialog": "690290201",
            "dialogues": [
                {
                    "id": "690290201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690290202",
                    "speaker": "可莉",
                    "text": "这里很有趣！"
                },
                {
                    "id": "690290203",
                    "speaker": "可莉",
                    "text": "有大大的房子，大大的空地。"
                },
                {
                    "id": "690290204",
                    "speaker": "可莉",
                    "text": "有很多对可莉来说很新鲜的东西，从路的一头跑到另一头也要好久好久。",
                    "choices": [
                        {
                            "id": "690290205",
                            "text": "听上去可莉玩得很开心。",
                            "response": [
                                {
                                    "id": "690290206",
                                    "speaker": "可莉",
                                    "text": "非常开心——"
                                },
                                {
                                    "id": "690290207",
                                    "speaker": "可莉",
                                    "text": "#要是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}也有时间的话，可莉可以带你一起玩！"
                                },
                                {
                                    "id": "690290212",
                                    "speaker": "可莉",
                                    "text": "抓蜥蜴、追青蛙、画画、做手工、捉迷藏…好玩的事情多着呢！"
                                }
                            ]
                        },
                        {
                            "id": "690290208",
                            "text": "可莉没有偷偷做坏事吧？",
                            "response": [
                                {
                                    "id": "690290209",
                                    "speaker": "可莉",
                                    "text": "没有！绝对没有！"
                                },
                                {
                                    "id": "690290210",
                                    "speaker": "可莉",
                                    "text": "#琴团长再三叮嘱可莉，说不能毁坏荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}的家。"
                                },
                                {
                                    "id": "690290211",
                                    "speaker": "可莉",
                                    "text": "可莉就干脆什么宝物都不带啦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902903",
            "initDialog": "690290301",
            "dialogues": [
                {
                    "id": "690290301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690290302",
                    "speaker": "可莉",
                    "text": "好耶！要来！可莉喜欢聊天。"
                },
                {
                    "id": "690290303",
                    "speaker": "可莉",
                    "text": "啊…趁着这个机会，把我最近发现的好东西分享给你。",
                    "choices": [
                        {
                            "id": "690290304",
                            "text": "又有好东西啦？",
                            "response": [
                                {
                                    "id": "690290306",
                                    "speaker": "可莉",
                                    "text": "看这个！超棒的捞鱼网！"
                                },
                                {
                                    "id": "690290307",
                                    "speaker": "可莉",
                                    "text": "我来教你哦！只需要像这样把网伸到湖里…看准时机…"
                                },
                                {
                                    "id": "690290308",
                                    "speaker": "可莉",
                                    "text": "一挑！就能把鱼捞出来啦。"
                                },
                                {
                                    "id": "690290309",
                                    "speaker": "可莉",
                                    "text": "一定要悄悄地埋伏好，一下子出动哦！",
                                    "choices": [
                                        {
                                            "id": "690290310",
                                            "text": "挺厉害的嘛。",
                                            "response": [
                                                {
                                                    "id": "690290311",
                                                    "speaker": "可莉",
                                                    "text": "嘿嘿，可莉把秘诀都告诉了你。你也会变得像可莉一样厉害的！"
                                                },
                                                {
                                                    "id": "690290314",
                                                    "speaker": "可莉",
                                                    "text": "这种方法…虽然比起平时用炸弹的方法稍微麻烦了一点。"
                                                },
                                                {
                                                    "id": "690290315",
                                                    "speaker": "可莉",
                                                    "text": "捞出来的鱼是滑溜溜的，还活蹦乱跳，不握紧一点就会又蹦回湖里。"
                                                },
                                                {
                                                    "id": "690290316",
                                                    "speaker": "可莉",
                                                    "text": "不过…和鱼这样玩也很有乐趣！",
                                                    "choices": [
                                                        {
                                                            "id": "690290317",
                                                            "text": "有我在身边的时候，可以放心用炸弹玩哦。",
                                                            "response": [
                                                                {
                                                                    "id": "690290318",
                                                                    "speaker": "可莉",
                                                                    "text": "欸！真的吗？"
                                                                },
                                                                {
                                                                    "id": "690290319",
                                                                    "speaker": "可莉",
                                                                    "text": "那你等等我哦，我马上就可以做出好多炸弹，原材料早就准备好啦！"
                                                                },
                                                                {
                                                                    "id": "690290323",
                                                                    "speaker": "可莉",
                                                                    "text": "嘻嘻，太开心啦！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "690290320",
                                                            "text": "下次一起来比赛捞鱼吧。",
                                                            "response": [
                                                                {
                                                                    "id": "690290321",
                                                                    "speaker": "可莉",
                                                                    "text": "好！"
                                                                },
                                                                {
                                                                    "id": "690290322",
                                                                    "speaker": "可莉",
                                                                    "text": "#如果{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}输了的话，晚饭就要拜托你来做哦！"
                                                                }
                                                            ]
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690290312",
                                            "text": "怎么不用「炸」的方法了呢？",
                                            "response": [
                                                {
                                                    "id": "690290313",
                                                    "speaker": "可莉",
                                                    "text": "#因为这是{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}的家，不能炸坏了…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690290305",
                            "text": "是什么呢？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902904",
            "initDialog": "690290401",
            "dialogues": [
                {
                    "id": "690290401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690290402",
                    "speaker": "可莉",
                    "text": "#嗯！我有一件事情需要{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}帮忙！"
                },
                {
                    "id": "690290403",
                    "speaker": "可莉",
                    "text": "我想组建蹦蹦军团！",
                    "choices": [
                        {
                            "id": "690290404",
                            "text": "…蹦蹦什么？",
                            "response": [
                                {
                                    "id": "690290405",
                                    "speaker": "可莉",
                                    "text": "蹦蹦军团！就是…好多好多蹦蹦的那种。"
                                },
                                {
                                    "id": "690290406",
                                    "speaker": "可莉",
                                    "text": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，拜托拜托。"
                                },
                                {
                                    "id": "690290407",
                                    "speaker": "Player",
                                    "text": "好吧…"
                                },
                                {
                                    "id": "690290410",
                                    "speaker": "可莉",
                                    "text": "那我们现在就开工吧！"
                                },
                                {
                                    "id": "690290411",
                                    "speaker": "可莉",
                                    "text": "#我负责做蹦蹦，{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}就来给蹦蹦分配角色吧。"
                                },
                                {
                                    "id": "690290412",
                                    "speaker": "可莉",
                                    "text": "需要有售货员、大厨、画家、马戏团成员…",
                                    "choices": [
                                        {
                                            "id": "690290413",
                                            "text": "听上去不是军团里会有的人物…",
                                            "response": [
                                                {
                                                    "id": "690290414",
                                                    "speaker": "可莉",
                                                    "text": "没关系！大家都是来过羽球节的。"
                                                },
                                                {
                                                    "id": "690290417",
                                                    "speaker": "可莉",
                                                    "text": "#有了蹦蹦军团，就可以每天——都可以和{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}一起过羽球节了！"
                                                },
                                                {
                                                    "id": "690290418",
                                                    "speaker": "可莉",
                                                    "text": "#有{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}的羽球节，就是最棒的羽球节！"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690290415",
                                            "text": "好像有点复杂。",
                                            "response": [
                                                {
                                                    "id": "690290416",
                                                    "speaker": "可莉",
                                                    "text": "没事的，只要戴上小配饰就能区分大家的身份了！"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690290408",
                            "text": "行啊，我可以帮忙。",
                            "response": [
                                {
                                    "id": "690290409",
                                    "speaker": "可莉",
                                    "text": "#{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}最好了！"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902905",
            "initDialog": "690290501",
            "dialogues": [
                {
                    "id": "690290501",
                    "speaker": "Player",
                    "text": "早啊，可莉。"
                },
                {
                    "id": "690290502",
                    "speaker": "可莉",
                    "text": "#早！荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！"
                },
                {
                    "id": "690290503",
                    "speaker": "可莉",
                    "text": "要带可莉去大冒险吗？可莉已经等不及啦。"
                }
            ]
        },
        {
            "talkId": "6902906",
            "initDialog": "690290601",
            "dialogues": [
                {
                    "id": "690290601",
                    "speaker": "Player",
                    "text": "晚安，可莉。"
                },
                {
                    "id": "690290602",
                    "speaker": "可莉",
                    "text": "可莉还不想睡觉…"
                },
                {
                    "id": "690290603",
                    "speaker": "可莉",
                    "text": "#但是…可莉答应过你要做好孩子，就先和{NICKNAME}{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}说晚安啦。"
                }
            ]
        },
        {
            "talkId": "6902907",
            "initDialog": "690290701",
            "dialogues": [
                {
                    "id": "690290701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6902908",
            "initDialog": "690290801",
            "dialogues": [
                {
                    "id": "690290801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6902909",
            "initDialog": "690290901",
            "dialogues": [
                {
                    "id": "690290901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6902950",
            "initDialog": "690295001",
            "dialogues": [
                {
                    "id": "690295001",
                    "speaker": "可莉",
                    "text": "这个工坊，可莉知道该怎么用！"
                },
                {
                    "id": "690295002",
                    "speaker": "可莉",
                    "text": "虽然有的东西长得不太一样，但用几次就会熟悉了！"
                },
                {
                    "id": "690295003",
                    "speaker": "可莉",
                    "text": "#嘻嘻，谢谢荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}！"
                }
            ]
        },
        {
            "talkId": "6902951",
            "initDialog": "690295101",
            "dialogues": [
                {
                    "id": "690295101",
                    "speaker": "可莉",
                    "text": "好眼熟的地方，感觉以前炸过…不对…是看到过这样的屋子！"
                },
                {
                    "id": "690295102",
                    "speaker": "可莉",
                    "text": "总之，这里的场地好宽好宽，感觉能玩得很开心！"
                },
                {
                    "id": "690295103",
                    "speaker": "可莉",
                    "text": "#荣誉骑士{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTERA]}，你也来陪可莉一起玩吧！"
                }
            ]
        }
    ]
}