            "dialogues": [
                {
                    "id": "210160501",
                    "speaker": "丹迪",
                    "text": "我是冒险家丹迪。主要活动范围是高山和险境。"
                },
                {
                    "id": "210160502",
                    "speaker": "丹迪",
                    "text": "地下世界不适合我啦，我战斗力不太行，那里又不太好爬。"
