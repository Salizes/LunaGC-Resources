            ]
        },
        {
            "talkId": "2101606",
            "initDialog": "210160601",
            "dialogues": [
                {
                    "id": "210160601",
                    "speaker": "丹迪",
                    "text": "想挑战自己速度的极限对吧？嗯嗯，我太明白你的想法了，毕竟我们的目标是星辰与深渊嘛！"
                }
            ]
        },
        {
            "talkId": "2101607",
