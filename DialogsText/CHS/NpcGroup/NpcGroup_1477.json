{
    "groupId": "1477",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 1,
        "尼尔森": 13
    },
    "talks": [
        {
            "talkId": "6147701",
            "initDialog": "4015147701",
            "dialogues": [
                {
                    "id": "4015147701",
                    "speaker": "尼尔森",
                    "text": "一起喝一杯？来来，坐坐坐。"
                }
            ]
        },
        {
            "talkId": "6147702",
            "initDialog": "4015147702",
            "dialogues": [
                {
                    "id": "4015147702",
                    "speaker": "尼尔森",
                    "text": "好喝吗？"
                },
                {
                    "id": "4015147705",
                    "speaker": "尼尔森",
                    "text": "那还用说？果酒湖酿出来的酒，放在全提瓦特都是赫赫有名的。"
                },
                {
                    "id": "4015147706",
                    "speaker": "尼尔森",
                    "text": "尝一口你就…哦，是吗，还不能喝酒啊，真可惜。"
                }
            ]
        },
        {
            "talkId": "6147703",
            "initDialog": "4015147703",
            "dialogues": [
                {
                    "id": "4015147703",
                    "speaker": "尼尔森",
                    "text": "蒙德怎么样？"
                },
                {
                    "id": "4015147707",
                    "speaker": "尼尔森",
                    "text": "这可是一个好地方。"
                },
                {
                    "id": "4015147708",
                    "speaker": "尼尔森",
                    "text": "至于什么北境的明冠啊，浪漫的牧歌之城啊，那都是文化人整出来的说法。"
                },
                {
                    "id": "4015147709",
                    "speaker": "尼尔森",
                    "text": "要我说，风景好，酒好，足够了！"
                },
                {
                    "id": "4015147710",
                    "speaker": "尼尔森",
                    "text": "嗝，别地的酒都没这儿的好！不去不去。"
                }
            ]
        },
        {
            "talkId": "6147704",
            "initDialog": "4015147704",
            "dialogues": [
                {
                    "id": "4015147704",
                    "speaker": "尼尔森",
                    "text": "再见。"
                },
                {
                    "id": "4015147711",
                    "speaker": "尼尔森",
                    "text": "再见！下回一起来喝酒啊！"
                }
            ]
        },
        {
            "talkId": "6147705",
            "initDialog": "614770501",
            "dialogues": [
                {
                    "id": "614770501",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614770502",
                    "speaker": "尼尔森",
                    "text": "感想？那就是龙灾终于结束了，我也可以再次骄傲地说出「蒙德是个好地方」了！"
                },
                {
                    "id": "614770503",
                    "speaker": "尼尔森",
                    "text": "风景好，酒好，而且就算有危险也还有西风骑士团能够保护我们，真是太好了！"
                }
            ]
        }
    ]
}