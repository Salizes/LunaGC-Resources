{
    "groupId": "7020",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 4,
        "蒂昂日": 9
    },
    "talks": [
        {
            "talkId": "6702001",
            "initDialog": "670200101",
            "dialogues": [
                {
                    "id": "670200101",
                    "speaker": "蒂昂日",
                    "text": "真麻烦，这入港流程和枫丹比真是有过之而无不及…"
                }
            ]
        },
        {
            "talkId": "6702002",
            "initDialog": "670200201",
            "dialogues": [
                {
                    "id": "670200201",
                    "speaker": "Player",
                    "text": "怎么了？"
                },
                {
                    "id": "670200202",
                    "speaker": "蒂昂日",
                    "text": "还能怎么了！你看这看不到头的队伍，还有那边一大摞要填的表格，简直比枫丹科学院的项目申请表还夸张！"
                },
                {
                    "id": "670200203",
                    "speaker": "蒂昂日",
                    "text": "每一个步骤都要反复核对，像是生怕放了什么不该进来的人或者货物一样…"
                }
            ]
        },
        {
            "talkId": "6702003",
            "initDialog": "670200301",
            "dialogues": [
                {
                    "id": "670200301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670200302",
                    "speaker": "蒂昂日",
                    "text": "哦，好…你快走吧，别打扰后面的人排队。"
                }
            ]
        },
        {
            "talkId": "6702004",
            "initDialog": "670200401",
            "dialogues": [
                {
                    "id": "670200401",
                    "speaker": "Player",
                    "text": "不该进来的人？"
                },
                {
                    "id": "670200402",
                    "speaker": "蒂昂日",
                    "text": "啊？我、我就是打个比方！"
                },
                {
                    "id": "670200403",
                    "speaker": "蒂昂日",
                    "text": "比如…走私客？或者别的什么…违反规定的人？谁知道呢！反正肯定不是我！你看我这样子像坏人吗？！"
                },
                {
                    "id": "670200404",
                    "speaker": "蒂昂日",
                    "text": "我这种只想本本分分过日子的普通水手，办个入境都这么费劲，真不知道他们在防什么…"
                }
            ]
        },
        {
            "talkId": "6702005",
            "initDialog": "670200501",
            "dialogues": [
                {
                    "id": "670200501",
                    "speaker": "Player",
                    "text": "你好像有点紧张…"
                },
                {
                    "id": "670200502",
                    "speaker": "蒂昂日",
                    "text": "紧、紧张？谁紧张了！我…我只是有点晕船！对，就是有点晕！我只想赶紧进城，找个地方好好休息一下！"
                },
                {
                    "id": "670200503",
                    "speaker": "蒂昂日",
                    "text": "毕竟，长途跋涉之后，谁不想快点安顿下来呢？特别是…像我这种只想安稳度日的人！"
                }
            ]
        }
    ]
}