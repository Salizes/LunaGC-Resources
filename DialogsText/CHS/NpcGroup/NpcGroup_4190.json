{
    "groupId": "4190",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "兰贡迪": 10
    },
    "talks": [
        {
            "talkId": "6419001",
            "initDialog": "641900101",
            "dialogues": [
                {
                    "id": "641900101",
                    "speaker": "兰贡迪",
                    "text": "制作菜肴的声音~准备谜题的声音~追逐的声音~听起来杂乱，但是是无忧节的声音~"
                }
            ]
        },
        {
            "talkId": "6419002",
            "initDialog": "641900201",
            "dialogues": [
                {
                    "id": "641900201",
                    "speaker": "Player",
                    "text": "关于无忧节…"
                },
                {
                    "id": "641900202",
                    "speaker": "兰贡迪",
                    "text": "#我们又相见了，那菈{NICKNAME}。"
                },
                {
                    "id": "641900203",
                    "speaker": "兰贡迪",
                    "text": "#那菈{NICKNAME}要在无忧节唱歌吧，那一定是和太阳和月亮的光亮交织、天空与湖水重叠、露珠与雨水握手一样的旋律。"
                },
                {
                    "id": "641900204",
                    "speaker": "兰贡迪",
                    "text": "#派蒙也要和那菈{NICKNAME}一起唱，不要偷懒。"
                }
            ]
        },
        {
            "talkId": "6419003",
            "initDialog": "641900301",
            "dialogues": [
                {
                    "id": "641900301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641900302",
                    "speaker": "兰贡迪",
                    "text": "#再见，那菈{NICKNAME}。"
                }
            ]
        },
        {
            "talkId": "6419004",
            "initDialog": "641900401",
            "dialogues": [
                {
                    "id": "641900401",
                    "speaker": "兰贡迪",
                    "text": "#那菈{NICKNAME}的歌是金灿灿的，像是太阳一样，暖暖的，兰贡迪记在心底。"
                }
            ]
        },
        {
            "talkId": "6419005",
            "initDialog": "641900501",
            "dialogues": [
                {
                    "id": "641900501",
                    "speaker": "Player",
                    "text": "关于歌声…"
                },
                {
                    "id": "641900502",
                    "speaker": "兰贡迪",
                    "text": "#兰贡迪听到了那菈{NICKNAME}的旋律，勇敢，充满希望。"
                },
                {
                    "id": "641900503",
                    "speaker": "兰贡迪",
                    "text": "和故事里的那菈法留纳一样。"
                },
                {
                    "id": "641900504",
                    "speaker": "兰贡迪",
                    "text": "#可是故事里的那菈法留纳没有再回到桓那兰那，那菈{NICKNAME}要经常回来。"
                }
            ]
        },
        {
            "talkId": "6419006",
            "initDialog": "641900601",
            "dialogues": [
                {
                    "id": "641900601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641900602",
                    "speaker": "兰贡迪",
                    "text": "#嗯…一定要回来，那菈{NICKNAME}。"
                }
            ]
        }
    ]
}