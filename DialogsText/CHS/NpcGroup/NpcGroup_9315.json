{
    "groupId": "9315",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "琴": 9
    },
    "talks": [
        {
            "talkId": "6931501",
            "initDialog": "693150101",
            "dialogues": [
                {
                    "id": "693150101",
                    "speaker": "琴",
                    "text": "我正在考虑，是不是应该把公文一并搬过来，这样休息的时候还能顺便看一看…"
                },
                {
                    "id": "693150102",
                    "speaker": "琴",
                    "text": "不必那么努力？嗯…说得也是。"
                },
                {
                    "id": "693150103",
                    "speaker": "琴",
                    "text": "那就沏杯咖啡好了，正好也请你喝一杯。"
                }
            ]
        },
        {
            "talkId": "6931502",
            "initDialog": "693150201",
            "dialogues": [
                {
                    "id": "693150201",
                    "speaker": "琴",
                    "text": "#{NICKNAME}，你看上去在为即将遭遇的敌人烦恼？"
                },
                {
                    "id": "693150202",
                    "speaker": "琴",
                    "text": "嗯…看来是我的失职呢，既然接受邀请加入了你的队伍，我理应为你分忧。"
                },
                {
                    "id": "693150203",
                    "speaker": "琴",
                    "text": "「蒲公英骑士」的剑随时为你挥舞。我们前进吧。"
                }
            ]
        },
        {
            "talkId": "6931503",
            "initDialog": "693150301",
            "dialogues": [
                {
                    "id": "693150301",
                    "speaker": "琴",
                    "text": "之前读过的那本小说，不知道还能不能在这借到…"
                },
                {
                    "id": "693150302",
                    "speaker": "琴",
                    "text": "并不是我特别喜欢那本小说。只是没读完全本，难免会挂念后续的剧情…"
                },
                {
                    "id": "693150303",
                    "speaker": "琴",
                    "text": "真希望故事有个好结局啊。"
                }
            ]
        }
    ]
}