{
    "groupId": "2410",
    "total_dialogue_lines": 8,
    "speaker_counts": {
        "Player": 2,
        "伯桓子": 6
    },
    "talks": [
        {
            "talkId": "6241001",
            "initDialog": "624100101",
            "dialogues": [
                {
                    "id": "624100101",
                    "speaker": "伯桓子",
                    "text": "…嗯？抱歉，刚刚太出神了。有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6241002",
            "initDialog": "624100201",
            "dialogues": [
                {
                    "id": "624100201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "624100202",
                    "speaker": "伯桓子",
                    "text": "我见碧水涓涓，流而不返，望景触情。故而在此陶冶心性，吟诵诗行。"
                },
                {
                    "id": "624100203",
                    "speaker": "伯桓子",
                    "text": "旅行者，你看，这碧水河在荻花洲分为两支，一支向北化作醴泉，滋润了蒙德酒乡，一支向南入海，注入无穷浩渺…"
                },
                {
                    "id": "624100204",
                    "speaker": "伯桓子",
                    "text": "豁达之意油然而起，怎不令人心生敬意。"
                }
            ]
        },
        {
            "talkId": "6241003",
            "initDialog": "624100301",
            "dialogues": [
                {
                    "id": "624100301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "624100302",
                    "speaker": "伯桓子",
                    "text": "我劝相思应趁早…山月常在，但红颜易消…"
                },
                {
                    "id": "624100303",
                    "speaker": "伯桓子",
                    "text": "我劝少年多壮志…浮萍一生，莫抱憾告老…"
                }
            ]
        }
    ]
}