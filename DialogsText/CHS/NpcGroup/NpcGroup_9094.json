{
    "groupId": "9094",
    "total_dialogue_lines": 77,
    "speaker_counts": {
        "Player": 16,
        "千织": 61
    },
    "talks": [
        {
            "talkId": "6909401",
            "initDialog": "690940101",
            "dialogues": [
                {
                    "id": "690940101",
                    "speaker": "千织",
                    "text": "#{NICKNAME}，你来了啊，还以为你平时不常回家。"
                },
                {
                    "id": "690940102",
                    "speaker": "千织",
                    "text": "旅行如何？有什么精彩的事发生了吗？说不定能为我提供灵感。"
                }
            ]
        },
        {
            "talkId": "6909402",
            "initDialog": "690940201",
            "dialogues": [
                {
                    "id": "690940201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690940202",
                    "speaker": "千织",
                    "text": "挺不错，安静惬意，风景怡人。是个疗愈身心的好地方。"
                },
                {
                    "id": "690940203",
                    "speaker": "千织",
                    "text": "在枫丹廷待腻了，偶尔就想出来旅游一趟。没有不守规矩的顾客，也没有胡说八道的报纸。",
                    "choices": [
                        {
                            "id": "690940204",
                            "text": "千织去过什么地方旅游？",
                            "response": [
                                {
                                    "id": "690940205",
                                    "speaker": "千织",
                                    "text": "那多了去了。当时从稻妻到枫丹，可不是几天就能走完的路程。"
                                },
                                {
                                    "id": "690940206",
                                    "speaker": "千织",
                                    "text": "唱诗饮酒的蒙德城、商业繁荣的璃月港，还有须弥热闹的大巴扎和怎么都望不到头的沙漠…"
                                },
                                {
                                    "id": "690940207",
                                    "speaker": "千织",
                                    "text": "我当时喜欢到最热闹的地方，找个椅子，就这么坐一天。观察人们的衣装、感受那里的氛围、猜想他们的故事…"
                                },
                                {
                                    "id": "690940208",
                                    "speaker": "千织",
                                    "text": "有时我会觉得，现在做衣服的很多灵感，就是那时在旅途中储存下来的。你应该能理解这种感受。"
                                },
                                {
                                    "id": "690940213",
                                    "speaker": "千织",
                                    "text": "说了半天，还是绕回了我的工作上。"
                                },
                                {
                                    "id": "690940214",
                                    "speaker": "千织",
                                    "text": "唔…恐怕在生活中汲取灵感，已经成为我的习惯了。"
                                },
                                {
                                    "id": "690940215",
                                    "speaker": "千织",
                                    "text": "总之，我喜欢旅游。说不定以后有机会的话，也会在旅途中与你相见。"
                                }
                            ]
                        },
                        {
                            "id": "690940209",
                            "text": "千织想去什么地方旅游？",
                            "response": [
                                {
                                    "id": "690940210",
                                    "speaker": "千织",
                                    "text": "去之前没去过的地方。这样才能酝酿出新的灵感。"
                                },
                                {
                                    "id": "690940211",
                                    "speaker": "千织",
                                    "text": "这么说的话，纳塔和至冬我都没去过…是不是该计划计划了。"
                                },
                                {
                                    "id": "690940212",
                                    "speaker": "千织",
                                    "text": "每个国家的服饰文化都有很大区别，不断吸收与接纳、融合与创新…这才是「千织屋」能引领时尚的秘诀。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909403",
            "initDialog": "690940301",
            "dialogues": [
                {
                    "id": "690940301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690940302",
                    "speaker": "千织",
                    "text": "哟，真是稀奇。很多人觉得我说话不好听，都不会主动来找我聊天。"
                },
                {
                    "id": "690940303",
                    "speaker": "千织",
                    "text": "我其实只是不喜欢绕弯子而已，有这点相互顾及的时间，正事早就做完了。"
                },
                {
                    "id": "690940304",
                    "speaker": "千织",
                    "text": "你呢？你喜欢哪种？",
                    "choices": [
                        {
                            "id": "690940305",
                            "text": "我也喜欢直来直去。",
                            "response": [
                                {
                                    "id": "690940306",
                                    "speaker": "千织",
                                    "text": "真好，这样能省去很多不必要的麻烦。"
                                },
                                {
                                    "id": "690940310",
                                    "speaker": "千织",
                                    "text": "我想起来有一次，一位客人在米色和灰色的布料间踌躇不定。"
                                },
                                {
                                    "id": "690940311",
                                    "speaker": "千织",
                                    "text": "我说米色适合你，能凸显身材，和你的发色也很搭。结果她嘟着嘴，说觉得灰色更耐脏。"
                                },
                                {
                                    "id": "690940312",
                                    "speaker": "千织",
                                    "text": "我说没问题，灰色的话我帮你调整一下版型，会显得更加大气。结果她又嘟着嘴，说灰色恐怕太沉闷了。"
                                },
                                {
                                    "id": "690940313",
                                    "speaker": "千织",
                                    "text": "这么一来二去，一下午就过去了。最后她选了款红色的…"
                                },
                                {
                                    "id": "690940314",
                                    "speaker": "千织",
                                    "text": "我倒不是不能理解，但要我说的话，这些人思考的时候都缺少了「最重要的是什么」这个前提。"
                                },
                                {
                                    "id": "690940315",
                                    "speaker": "千织",
                                    "text": "最在意的是身形就选米色、最在意的是耐用就选灰色…"
                                },
                                {
                                    "id": "690940316",
                                    "speaker": "千织",
                                    "text": "但如果你最在意的，是暗恋的人在宴会上能一眼找到你，那拜托进店门的时候就告诉我这点！"
                                },
                                {
                                    "id": "690940317",
                                    "speaker": "千织",
                                    "text": "呼…光是想想都来气，让我缓缓。"
                                },
                                {
                                    "id": "690940318",
                                    "speaker": "Player",
                                    "text": "可能那人害羞…"
                                },
                                {
                                    "id": "690940319",
                                    "speaker": "千织",
                                    "text": "你说得对，她有所顾虑。但明明直接说出来的话，能省下更多时间，也能让我更好地依照她的需求进行定制。"
                                },
                                {
                                    "id": "690940320",
                                    "speaker": "千织",
                                    "text": "这种事见得多了，我就越发告诫自己说话不要藏着掖着。"
                                },
                                {
                                    "id": "690940321",
                                    "speaker": "千织",
                                    "text": "这或许不是最聪明的做法，但对我来说，是效率最高的做法。"
                                },
                                {
                                    "id": "690940322",
                                    "speaker": "千织",
                                    "text": "所以我不会对你隐瞒自己的感受与想法，希望你也如此。"
                                },
                                {
                                    "id": "690940323",
                                    "speaker": "千织",
                                    "text": "当然，你要是对我说「千织屋的衣服真难看」，那记得附上你的理由和见解，我会作为参考。"
                                },
                                {
                                    "id": "690940324",
                                    "speaker": "千织",
                                    "text": "单纯的「无理取闹」，我想你是做不出来的。除非你好奇地板的触感。"
                                }
                            ]
                        },
                        {
                            "id": "690940307",
                            "text": "还是委婉一点好…",
                            "response": [
                                {
                                    "id": "690940308",
                                    "speaker": "千织",
                                    "text": "是吗？但这对我来说还挺困难。"
                                },
                                {
                                    "id": "690940309",
                                    "speaker": "千织",
                                    "text": "可能我从没有过模棱两可的时候吧，要么就是喜欢，要么就是不喜欢。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909404",
            "initDialog": "690940401",
            "dialogues": [
                {
                    "id": "690940401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690940402",
                    "speaker": "千织",
                    "text": "你这儿有羽子板吗？想和你来打几场。"
                },
                {
                    "id": "690940403",
                    "speaker": "千织",
                    "text": "你脸上的表情是怎么回事？该不会在你心中，我只会坐在工作台前缝衣服吧？"
                },
                {
                    "id": "690940404",
                    "speaker": "Player",
                    "text": "只是没想到是羽子板…"
                },
                {
                    "id": "690940405",
                    "speaker": "千织",
                    "text": "小时候在稻妻常玩，当时可没几个孩子能赢我。"
                },
                {
                    "id": "690940406",
                    "speaker": "千织",
                    "text": "结果到了枫丹之后没人会玩，教新手打又觉得像在欺负人。"
                },
                {
                    "id": "690940407",
                    "speaker": "千织",
                    "text": "你在稻妻的时候应该玩过这种游艺吧？想必身手不赖。"
                },
                {
                    "id": "690940408",
                    "speaker": "千织",
                    "text": "怎么？难不成你怕了？",
                    "choices": [
                        {
                            "id": "690940409",
                            "text": "接受挑战！",
                            "response": [
                                {
                                    "id": "690940410",
                                    "speaker": "千织",
                                    "text": "嗯，有气势。不愧是人们交口称赞的旅行者。"
                                },
                                {
                                    "id": "690940411",
                                    "speaker": "千织",
                                    "text": "先说好，要是输了，可别指望我帮你保密。"
                                },
                                {
                                    "id": "690940416",
                                    "speaker": "千织",
                                    "text": "准备好就开始，我用自己的两支羽子板。",
                                    "choices": [
                                        {
                                            "id": "690940417",
                                            "text": "…二板流？",
                                            "response": [
                                                {
                                                    "id": "690940419",
                                                    "speaker": "千织",
                                                    "text": "规则没说不能用两支呀。我平时用双刀，现在用两支羽子板也很正常吧？"
                                                },
                                                {
                                                    "id": "690940420",
                                                    "speaker": "千织",
                                                    "text": "你要是想的话，用四支来和我打都行。我没意见。"
                                                },
                                                {
                                                    "id": "690940421",
                                                    "speaker": "千织",
                                                    "text": "还是说，这就已经准备认输了？"
                                                },
                                                {
                                                    "id": "690940422",
                                                    "speaker": "Player",
                                                    "text": "…输了别不认！"
                                                },
                                                {
                                                    "id": "690940423",
                                                    "speaker": "千织",
                                                    "text": "放心，虽然「千织」这个品牌的理念是永不认输。但对朋友，我可不会耍赖。"
                                                },
                                                {
                                                    "id": "690940424",
                                                    "speaker": "千织",
                                                    "text": "前提是你能赢过我。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690940418",
                                            "text": "…是不是有些不公平？"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690940412",
                            "text": "输了的人怎么办？",
                            "response": [
                                {
                                    "id": "690940413",
                                    "speaker": "千织",
                                    "text": "哦？来认真的？好呀，有点代价才好玩。"
                                },
                                {
                                    "id": "690940414",
                                    "speaker": "千织",
                                    "text": "要是你输了，就来我店里打几天工吧。打扫店铺、整理衣服，偶尔当当模特…"
                                },
                                {
                                    "id": "690940415",
                                    "speaker": "千织",
                                    "text": "要是我输了，就随你开一个差不多的条件，打扫你的家，或者做点好看的东西帮你装点一下什么的…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6909405",
            "initDialog": "690940501",
            "dialogues": [
                {
                    "id": "690940501",
                    "speaker": "Player",
                    "text": "早安，千织。"
                },
                {
                    "id": "690940502",
                    "speaker": "千织",
                    "text": "早。但我现在的头脑远称不上清醒，得先给自己泡一杯咖啡。"
                },
                {
                    "id": "690940503",
                    "speaker": "千织",
                    "text": "不介意我借用你的餐具吧？我会洗好擦干水渍的。"
                }
            ]
        },
        {
            "talkId": "6909406",
            "initDialog": "690940601",
            "dialogues": [
                {
                    "id": "690940601",
                    "speaker": "Player",
                    "text": "晚安，千织。"
                },
                {
                    "id": "690940602",
                    "speaker": "千织",
                    "text": "又一天过去了啊…时间总是过得那么快。"
                },
                {
                    "id": "690940603",
                    "speaker": "千织",
                    "text": "我再检查一下衣片。你先休息吧，不用等我。"
                }
            ]
        },
        {
            "talkId": "6909407",
            "initDialog": "690940701",
            "dialogues": [
                {
                    "id": "690940701",
                    "speaker": "千织",
                    "text": "自从我离开稻妻之后，就没见过这么精致的汤泉了。真是怀念。"
                },
                {
                    "id": "690940702",
                    "speaker": "千织",
                    "text": "我在稻妻养成了工作结束后泡澡的习惯，现在依旧没变。可惜枫丹的家里只有小小的浴缸。"
                },
                {
                    "id": "690940703",
                    "speaker": "千织",
                    "text": "那我就不客气了。衣服脱在哪儿？还是说叠好了放地上就行？"
                }
            ]
        },
        {
            "talkId": "6909408",
            "initDialog": "690940801",
            "dialogues": [
                {
                    "id": "690940801",
                    "speaker": "千织",
                    "text": "这是我刚到枫丹时最喜欢的街景，也是我现在每天走过的街景。"
                },
                {
                    "id": "690940802",
                    "speaker": "千织",
                    "text": "如此纷繁夺目，络绎不绝的街道上，有着「千织」这个时尚王国的第一块领土。"
                },
                {
                    "id": "690940803",
                    "speaker": "千织",
                    "text": "我会继续延展它的版图。在此期间，也随时欢迎你来做客。"
                }
            ]
        }
    ]
}