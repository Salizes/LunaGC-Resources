{
    "groupId": "1437",
    "total_dialogue_lines": 42,
    "speaker_counts": {
        "Player": 10,
        "斯万": 32
    },
    "talks": [
        {
            "talkId": "6143709",
            "initDialog": "614370901",
            "dialogues": [
                {
                    "id": "614370901",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6143710",
            "initDialog": "614371001",
            "dialogues": [
                {
                    "id": "614371001",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6143711",
            "initDialog": "614371101",
            "dialogues": [
                {
                    "id": "614371101",
                    "speaker": "斯万",
                    "text": "漂亮的获胜方式，我受教了。"
                }
            ]
        },
        {
            "talkId": "6143712",
            "initDialog": "614371201",
            "dialogues": [
                {
                    "id": "614371201",
                    "speaker": "斯万",
                    "text": "很精彩的对局，承让了。"
                }
            ]
        },
        {
            "talkId": "6143713",
            "initDialog": "614371301",
            "dialogues": [
                {
                    "id": "614371301",
                    "speaker": "斯万",
                    "text": "干净利落的战术，真是让人佩服。"
                }
            ]
        },
        {
            "talkId": "6143714",
            "initDialog": "614371401",
            "dialogues": [
                {
                    "id": "614371401",
                    "speaker": "斯万",
                    "text": "真是惊险…谢谢您手下留情。"
                }
            ]
        },
        {
            "talkId": "7080101",
            "initDialog": "708010101",
            "dialogues": [
                {
                    "id": "708010101",
                    "speaker": "斯万",
                    "text": "哎，荣誉骑士！等等！"
                },
                {
                    "id": "708010102",
                    "speaker": "Player",
                    "text": "你…叫我？"
                },
                {
                    "id": "708010103",
                    "speaker": "斯万",
                    "text": "哈哈哈，看您说的，现在蒙德城里最有名的「荣誉骑士」不就是您了吗？"
                },
                {
                    "id": "708010104",
                    "speaker": "斯万",
                    "text": "不过，您应该没有拿到《骑士团指导手册》吧？这本手册里包含了大部分西风骑士应当遵守的原则，还有一些日常的知识。"
                },
                {
                    "id": "708010105",
                    "speaker": "斯万",
                    "text": "您是「荣誉骑士」，多少也应该了解一些这方面的知识。"
                },
                {
                    "id": "708010106",
                    "speaker": "斯万",
                    "text": "我特意从骑士团里领了一本给您，请您先读一读吧。"
                },
                {
                    "id": "708010107",
                    "speaker": "斯万",
                    "text": "等您读完了，我会问您几个小问题。这些问题包括了一些这本手册上记载的条目，还有一些常识性的问题。"
                },
                {
                    "id": "708010108",
                    "speaker": "斯万",
                    "text": "根据您答题的情况，我还会送您一些小礼物。"
                }
            ]
        },
        {
            "talkId": "6143701",
            "initDialog": "614370101",
            "dialogues": [
                {
                    "id": "614370101",
                    "speaker": "斯万",
                    "text": "你好，有什么需要骑士团效劳的吗？"
                }
            ]
        },
        {
            "talkId": "6143702",
            "initDialog": "614370201",
            "dialogues": [
                {
                    "id": "614370201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "614370202",
                    "speaker": "斯万",
                    "text": "我是负责站岗的西风骑士斯万。"
                },
                {
                    "id": "614370203",
                    "speaker": "斯万",
                    "text": "同时根据《骑士团指导手册》负责为客商提供必要的帮助。",
                    "choices": [
                        {
                            "id": "614370204",
                            "text": "《骑士团指导手册》？",
                            "response": [
                                {
                                    "id": "614370205",
                                    "speaker": "斯万",
                                    "text": "是的，《骑士团指导手册》是西风骑士团共同的指导纲领，也是蒙德和平与安全的基石…"
                                }
                            ]
                        },
                        {
                            "id": "614370206",
                            "text": "蒙德有什么好地方吗？",
                            "response": [
                                {
                                    "id": "614370207",
                                    "speaker": "斯万",
                                    "text": "……"
                                },
                                {
                                    "id": "614370208",
                                    "speaker": "Player",
                                    "text": "……"
                                },
                                {
                                    "id": "614370209",
                                    "speaker": "斯万",
                                    "text": "……"
                                },
                                {
                                    "id": "614370210",
                                    "speaker": "斯万",
                                    "text": "……"
                                },
                                {
                                    "id": "614370211",
                                    "speaker": "斯万",
                                    "text": "……这个问题《骑士团指导手册》里没写…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6143703",
            "initDialog": "614370301",
            "dialogues": [
                {
                    "id": "614370301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614370302",
                    "speaker": "斯万",
                    "text": "再见！"
                },
                {
                    "id": "614370303",
                    "speaker": "斯万",
                    "text": "愿巴巴托斯的和风护佑着您！"
                }
            ]
        },
        {
            "talkId": "6143704",
            "initDialog": "614370401",
            "dialogues": [
                {
                    "id": "614370401",
                    "speaker": "斯万",
                    "text": "现在气候异常，外面很危险，一般民众请找安全的地方避难。"
                }
            ]
        },
        {
            "talkId": "6143705",
            "initDialog": "614370501",
            "dialogues": [
                {
                    "id": "614370501",
                    "speaker": "斯万",
                    "text": "那条龙随时可能回来，我们西风骑士会盯着的，请抓紧避难。"
                }
            ]
        },
        {
            "talkId": "6143706",
            "initDialog": "614370601",
            "dialogues": [
                {
                    "id": "614370601",
                    "speaker": "斯万",
                    "text": "现在是紧急事态，请相信我们西风骑士会保障大家的安全。"
                }
            ]
        },
        {
            "talkId": "6143707",
            "initDialog": "614370701",
            "dialogues": [
                {
                    "id": "614370701",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614370702",
                    "speaker": "斯万",
                    "text": "龙灾？请稍等，让我回想一下《骑士团指导手册》…"
                },
                {
                    "id": "614370703",
                    "speaker": "斯万",
                    "text": "不好意思，里面好像没有提到面对巨龙应该怎么做啊…"
                },
                {
                    "id": "614370704",
                    "speaker": "斯万",
                    "text": "我想起来了，不过里面有提及该如何面对突发的危机："
                },
                {
                    "id": "614370705",
                    "speaker": "斯万",
                    "text": "「面对危险时不要慌张，可以双手抱头并蹲下、护住要害部位」…"
                },
                {
                    "id": "614370706",
                    "speaker": "斯万",
                    "text": "…总之，请参考这个吧。"
                }
            ]
        },
        {
            "talkId": "6143708",
            "initDialog": "614370801",
            "dialogues": [
                {
                    "id": "614370801",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614370802",
                    "speaker": "斯万",
                    "text": "总算是结束了，可以松口气了…"
                },
                {
                    "id": "614370803",
                    "speaker": "斯万",
                    "text": "嗯，是时候给上面反映一下，应该把巨龙出现时该怎么应对也写进《骑士团指导手册》了。"
                },
                {
                    "id": "614370804",
                    "speaker": "斯万",
                    "text": "不过，这种事情应该也不会发生第二次了吧。"
                }
            ]
        }
    ]
}