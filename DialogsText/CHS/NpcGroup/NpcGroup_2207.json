{
    "groupId": "2207",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 7,
        "黄衫": 20
    },
    "talks": [
        {
            "talkId": "4111539",
            "initDialog": "411153901",
            "dialogues": [
                {
                    "id": "411153901",
                    "speaker": "黄衫",
                    "text": "是想请我走镖吗？现在是特殊时期，价钱要加倍。"
                },
                {
                    "id": "411153902",
                    "speaker": "黄衫",
                    "text": "谁知道除了陨石之外，天上还会不会掉下些什么别的东西下来，这风险可大着呢。"
                }
            ]
        },
        {
            "talkId": "4111548",
            "initDialog": "622070201",
            "dialogues": [
                {
                    "id": "622070201",
                    "speaker": "Player",
                    "text": "请问你是？"
                },
                {
                    "id": "622070202",
                    "speaker": "黄衫",
                    "text": "我是个镖师，也就是运输货物的保镖。不是我自夸，走镖这么久，还从来没有失手过。"
                }
            ]
        },
        {
            "talkId": "4111549",
            "initDialog": "411154901",
            "dialogues": [
                {
                    "id": "411154901",
                    "speaker": "Player",
                    "text": "那个…敢问大名？"
                },
                {
                    "id": "411154902",
                    "speaker": "黄衫",
                    "text": "哈哈，忘了先说名字了。"
                },
                {
                    "id": "411154903",
                    "speaker": "黄衫",
                    "text": "我叫黄衫。"
                },
                {
                    "id": "411154904",
                    "speaker": "黄衫",
                    "text": "璃月蒙德商道我应该还挺有名气的。毕竟干活仔细，有口皆碑嘛。"
                }
            ]
        },
        {
            "talkId": "6220705",
            "initDialog": "622070501",
            "dialogues": [
                {
                    "id": "622070501",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6220706",
            "initDialog": "622070601",
            "dialogues": [
                {
                    "id": "622070601",
                    "speaker": "黄衫",
                    "text": "承让了！但我感觉你还没拿出真本事，不必和我客气！"
                }
            ]
        },
        {
            "talkId": "6220707",
            "initDialog": "622070701",
            "dialogues": [
                {
                    "id": "622070701",
                    "speaker": "黄衫",
                    "text": "漂亮！我输得心服口服！"
                }
            ]
        },
        {
            "talkId": "7192901",
            "initDialog": "719290101",
            "dialogues": [
                {
                    "id": "719290101",
                    "speaker": "Player",
                    "text": "关于镖师…"
                },
                {
                    "id": "719290102",
                    "speaker": "黄衫",
                    "text": "你理解成专门保护货物的雇佣兵就好了，这应该是雇佣兵在璃月的特殊称呼吧？"
                },
                {
                    "id": "719290103",
                    "speaker": "黄衫",
                    "text": "毕竟璃月人以商为重，行商难免要四处奔波，而我们镖师的职责便是对付那些强抢货物的贼人。"
                },
                {
                    "id": "719290104",
                    "speaker": "黄衫",
                    "text": "走镖这些年，倒是积累了不少经验，分享给你看看也无妨。"
                }
            ]
        },
        {
            "talkId": "6220701",
            "initDialog": "622070101",
            "dialogues": [
                {
                    "id": "622070101",
                    "speaker": "黄衫",
                    "text": "客套话寒暄就免了吧。有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "6220703",
            "initDialog": "622070301",
            "dialogues": [
                {
                    "id": "622070301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622070302",
                    "speaker": "黄衫",
                    "text": "再见。看样子你对自己的本事挺自信啊。有空一起合作。"
                }
            ]
        },
        {
            "talkId": "6220704",
            "initDialog": "622070203",
            "dialogues": [
                {
                    "id": "622070203",
                    "speaker": "Player",
                    "text": "那个…敢问大名？"
                },
                {
                    "id": "622070204",
                    "speaker": "黄衫",
                    "text": "哈哈，忘了先说名字了。"
                },
                {
                    "id": "622070205",
                    "speaker": "黄衫",
                    "text": "我叫黄衫。"
                },
                {
                    "id": "622070206",
                    "speaker": "黄衫",
                    "text": "璃月蒙德商道我应该还挺有名气的。毕竟干活仔细，有口皆碑嘛。"
                },
                {
                    "id": "622070207",
                    "speaker": "Player",
                    "text": "关于商路传闻…"
                },
                {
                    "id": "622070208",
                    "speaker": "黄衫",
                    "text": "前些日子蒙德闹了龙灾，所以我暂停了一段时间。"
                },
                {
                    "id": "622070209",
                    "speaker": "黄衫",
                    "text": "毕竟我对付山鬼、野兽、贼人有手段，对付龙可不行。"
                },
                {
                    "id": "622070210",
                    "speaker": "黄衫",
                    "text": "说来，这里就是两地传闻的交汇点。听说这里的员工都是七星的情报探子噢。"
                },
                {
                    "id": "622070211",
                    "speaker": "黄衫",
                    "text": "看你一脸严肃，难道你真的信了？哈哈哈。"
                }
            ]
        }
    ]
}