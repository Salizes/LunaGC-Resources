{
    "groupId": "9053",
    "total_dialogue_lines": 62,
    "speaker_counts": {
        "Player": 17,
        "早柚": 45
    },
    "talks": [
        {
            "talkId": "6905301",
            "initDialog": "690530101",
            "dialogues": [
                {
                    "id": "690530101",
                    "speaker": "早柚",
                    "text": "#…呼啊，{NICKNAME}。"
                },
                {
                    "id": "690530102",
                    "speaker": "早柚",
                    "text": "…你好…"
                }
            ]
        },
        {
            "talkId": "6905302",
            "initDialog": "690530201",
            "dialogues": [
                {
                    "id": "690530201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690530202",
                    "speaker": "早柚",
                    "text": "嗯，睡得非常舒服。"
                },
                {
                    "id": "690530203",
                    "speaker": "早柚",
                    "text": "而且不用担心突然被抓去工作。"
                },
                {
                    "id": "690530204",
                    "speaker": "早柚",
                    "text": "就算是一直睡下去也没关系。",
                    "choices": [
                        {
                            "id": "690530205",
                            "text": "早柚能喜欢这里，太好了。",
                            "response": [
                                {
                                    "id": "690530206",
                                    "speaker": "早柚",
                                    "text": "嗯，这里也没有狸猫。"
                                },
                                {
                                    "id": "690530207",
                                    "speaker": "早柚",
                                    "text": "我很喜欢。"
                                }
                            ]
                        },
                        {
                            "id": "690530208",
                            "text": "那早柚可以经常来玩。",
                            "response": [
                                {
                                    "id": "690530209",
                                    "speaker": "早柚",
                                    "text": "好呀，谢谢你。"
                                },
                                {
                                    "id": "690530210",
                                    "speaker": "早柚",
                                    "text": "那我下次旷…呃，休息的时候，首选地就是这里了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905303",
            "initDialog": "690530301",
            "dialogues": [
                {
                    "id": "690530301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690530302",
                    "speaker": "早柚",
                    "text": "好呀。"
                },
                {
                    "id": "690530303",
                    "speaker": "早柚",
                    "text": "我会努力不睡着的…",
                    "choices": [
                        {
                            "id": "690530304",
                            "text": "早柚今天睡饱了吗？",
                            "response": [
                                {
                                    "id": "690530305",
                                    "speaker": "早柚",
                                    "text": "这么一说，我又有点困了…"
                                },
                                {
                                    "id": "690530306",
                                    "speaker": "早柚",
                                    "text": "呼啊…"
                                },
                                {
                                    "id": "690530307",
                                    "speaker": "早柚",
                                    "text": "不行，我要忍住…"
                                },
                                {
                                    "id": "690530311",
                                    "speaker": "早柚",
                                    "text": "和你在一起的时候，我睡着了的话…就太浪费了。"
                                },
                                {
                                    "id": "690530312",
                                    "speaker": "Player",
                                    "text": "早柚的工作没关系吗？"
                                },
                                {
                                    "id": "690530313",
                                    "speaker": "早柚",
                                    "text": "没关系哦…"
                                },
                                {
                                    "id": "690530314",
                                    "speaker": "早柚",
                                    "text": "工作都是些没有意义的小事情。"
                                },
                                {
                                    "id": "690530315",
                                    "speaker": "早柚",
                                    "text": "不如待在这里有意义。"
                                },
                                {
                                    "id": "690530316",
                                    "speaker": "早柚",
                                    "text": "可以睡觉，也可以和你聊天…"
                                }
                            ]
                        },
                        {
                            "id": "690530308",
                            "text": "早柚困的话就睡吧。",
                            "response": [
                                {
                                    "id": "690530309",
                                    "speaker": "早柚",
                                    "text": "唔，没事的…"
                                },
                                {
                                    "id": "690530310",
                                    "speaker": "早柚",
                                    "text": "呼啊…我还不想睡觉…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905304",
            "initDialog": "690530401",
            "dialogues": [
                {
                    "id": "690530401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690530402",
                    "speaker": "早柚",
                    "text": "如果你方便的话…"
                },
                {
                    "id": "690530403",
                    "speaker": "早柚",
                    "text": "可不可以和我一起种一棵树？"
                },
                {
                    "id": "690530404",
                    "speaker": "Player",
                    "text": "种树？"
                },
                {
                    "id": "690530405",
                    "speaker": "早柚",
                    "text": "嗯，种一棵大树吧！"
                },
                {
                    "id": "690530406",
                    "speaker": "早柚",
                    "text": "比外面的那些树都要大。"
                },
                {
                    "id": "690530407",
                    "speaker": "早柚",
                    "text": "我可以教你一些借助树叶的忍术哦。"
                },
                {
                    "id": "690530408",
                    "speaker": "早柚",
                    "text": "虽然，都是些逃跑用的…"
                },
                {
                    "id": "690530409",
                    "speaker": "早柚",
                    "text": "但是，但是！遇到强敌的时候，逃跑也是很重要的！"
                },
                {
                    "id": "690530410",
                    "speaker": "早柚",
                    "text": "我不希望看到你受伤…"
                },
                {
                    "id": "690530411",
                    "speaker": "Player",
                    "text": "那到时候就拜托早柚了。"
                },
                {
                    "id": "690530412",
                    "speaker": "早柚",
                    "text": "交给我吧。"
                },
                {
                    "id": "690530413",
                    "speaker": "早柚",
                    "text": "然后，我们还可以爬上树休息。"
                },
                {
                    "id": "690530414",
                    "speaker": "早柚",
                    "text": "坐在树干上吹风…"
                },
                {
                    "id": "690530415",
                    "speaker": "早柚",
                    "text": "呼啊…这么一想…真的有点困了。",
                    "choices": [
                        {
                            "id": "690530416",
                            "text": "晚安，早柚。",
                            "response": [
                                {
                                    "id": "690530418",
                                    "speaker": "早柚",
                                    "text": "#{NICKNAME}，你也是。"
                                },
                                {
                                    "id": "690530419",
                                    "speaker": "早柚",
                                    "text": "…希望每次睡着都能梦见你…"
                                }
                            ]
                        },
                        {
                            "id": "690530417",
                            "text": "做个好梦吧，早柚。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6905305",
            "initDialog": "690530501",
            "dialogues": [
                {
                    "id": "690530501",
                    "speaker": "Player",
                    "text": "早啊，早柚。"
                },
                {
                    "id": "690530502",
                    "speaker": "早柚",
                    "text": "…早、早上了吗？"
                },
                {
                    "id": "690530503",
                    "speaker": "早柚",
                    "text": "呜，我还没睡醒。"
                }
            ]
        },
        {
            "talkId": "6905306",
            "initDialog": "690530601",
            "dialogues": [
                {
                    "id": "690530601",
                    "speaker": "Player",
                    "text": "晚安，早柚。"
                },
                {
                    "id": "690530602",
                    "speaker": "早柚",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690530603",
                    "speaker": "早柚",
                    "text": "你也要和早柚一样，睡个好觉。"
                }
            ]
        },
        {
            "talkId": "6905307",
            "initDialog": "690530701",
            "dialogues": [
                {
                    "id": "690530701",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                }
            ]
        },
        {
            "talkId": "6905308",
            "initDialog": "690530801",
            "dialogues": [
                {
                    "id": "690530801",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                }
            ]
        },
        {
            "talkId": "6905309",
            "initDialog": "690530901",
            "dialogues": [
                {
                    "id": "690530901",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                }
            ]
        },
        {
            "talkId": "6905310",
            "initDialog": "690531001",
            "dialogues": [
                {
                    "id": "690531001",
                    "speaker": "早柚",
                    "text": "这里似乎很适合作为安全屋。"
                },
                {
                    "id": "690531002",
                    "speaker": "早柚",
                    "text": "不被人发现，可以尽情睡个够。"
                },
                {
                    "id": "690531003",
                    "speaker": "早柚",
                    "text": "我非常喜欢这里，谢谢你！"
                }
            ]
        },
        {
            "talkId": "6905311",
            "initDialog": "690531101",
            "dialogues": [
                {
                    "id": "690531101",
                    "speaker": "早柚",
                    "text": "村子里的地形很复杂。藏在这里睡觉，应该不会被找到吧？"
                },
                {
                    "id": "690531102",
                    "speaker": "早柚",
                    "text": "屋子不高不低，还可以用来练习逃跑。"
                },
                {
                    "id": "690531103",
                    "speaker": "早柚",
                    "text": "真是个好地方呀…"
                }
            ]
        }
    ]
}