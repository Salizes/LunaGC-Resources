        "阿罗夏": 5
    },
    "talks": [
        {
            "talkId": "6741401",
            "initDialog": "674140101",
            "dialogues": [
                {
                    "id": "674140101",
                    "speaker": "格里戈里",
                    "text": "来看看新进的商品吧！不过注意了，离开柜台钱货两讫，然后…原则上不接受赊账！"
                }
            ]
        },
        {
            "talkId": "6741402",
            "initDialog": "674140201",
            "dialogues": [
                {
                    "id": "674140201",
                    "speaker": "Player",
                    "text": "让我看看有什么…"
                },
                {
                    "id": "674140202",
                    "speaker": "格里戈里",
                    "text": "看看吧，都是些刚进的好东西！"
                }
            ]
        },
        {
            "talkId": "6741403",
            "initDialog": "674140301",
            "dialogues": [
                {
                    "id": "674140301",
                    "speaker": "Player",
                    "text": "我要赊账！"
                },
                {
                    "id": "674140302",
                    "speaker": "格里戈里",
                    "text": "哈哈，客人你看上去也不是什么穷酸人，还是算了吧，小店本就是成本经营…"
                },
                {
                    "id": "674140303",
                    "speaker": "格里戈里",
                    "text": "说正经的，名为赊账，其实大多也就是帮帮实在过不去的乡里乡亲，像您这样的，就不是「赊账」服务提供的对象啦。"
                }
            ]
        },
        {
            "talkId": "6741404",
            "initDialog": "674140401",
            "dialogues": [
                {
                    "id": "674140401",
                    "speaker": "Player",
                    "text": "有很多人赊账吗？"
                },
                {
                    "id": "674140402",
                    "speaker": "格里戈里",
                    "text": "…以前偶尔有，只不过最近数量多了起来。"
                },
                {
                    "id": "674140403",
                    "speaker": "格里戈里",
                    "text": "家家都有本难念的经，来我们「布莱茨卡」这儿买东西的也大多是居住在附近的居民，总有生活突遭变故，难以为继的时候…"
                },
                {
                    "id": "674140404",
                    "speaker": "格里戈里",
                    "text": "说是赊账，其实大部分赊的账呢，钱款也讨不回来，权当帮衬了。"
                }
            ]
        },
        {
            "talkId": "6741405",
            "initDialog": "674140501",
            "dialogues": [
                {
                    "id": "674140501",
                    "speaker": "Player",
                    "text": "没什么想看的…"
                },
                {
                    "id": "674140502",
                    "speaker": "格里戈里",
                    "text": "是嘛，那等到了新货，你再看看，说不定有你想要的呢！"
                }
            ]
        },
