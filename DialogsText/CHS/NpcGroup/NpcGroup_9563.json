{
    "groupId": "9563",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "绮良良": 10
    },
    "talks": [
        {
            "talkId": "6956301",
            "initDialog": "695630101",
            "dialogues": [
                {
                    "id": "695630101",
                    "speaker": "绮良良",
                    "text": "好多人喔！看服饰像是来自不同的地方…他们都是专程过来玩牌的吗？"
                }
            ]
        },
        {
            "talkId": "6956302",
            "initDialog": "695630201",
            "dialogues": [
                {
                    "id": "695630201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956303",
            "initDialog": "695630301",
            "dialogues": [
                {
                    "id": "695630301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695630302",
                    "speaker": "绮良良",
                    "text": "你已经要走了吗？我等会也要出去工作啦，既然来一趟蒙德，正好去周围看看，有没有人想拜托我送快递。"
                }
            ]
        },
        {
            "talkId": "6956304",
            "initDialog": "695630401",
            "dialogues": [
                {
                    "id": "695630401",
                    "speaker": "绮良良",
                    "text": "居然这么顺利？不知道是我打牌很厉害，还是我搜集来的牌很厉害…要再来一局吗？"
                }
            ]
        },
        {
            "talkId": "6956305",
            "initDialog": "695630501",
            "dialogues": [
                {
                    "id": "695630501",
                    "speaker": "绮良良",
                    "text": "喵…到底哪里出错了呢？尾巴呀尾巴，你们就不能帮我找到一张好牌吗？"
                }
            ]
        },
        {
            "talkId": "6956306",
            "initDialog": "695630601",
            "dialogues": [
                {
                    "id": "695630601",
                    "speaker": "绮良良",
                    "text": "要和我打牌吗？好呀，等我把牌盒拿出来哦，我整理得可整齐啦！"
                }
            ]
        },
        {
            "talkId": "6956308",
            "initDialog": "695630801",
            "dialogues": [
                {
                    "id": "695630801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956309",
            "initDialog": "695630901",
            "dialogues": [
                {
                    "id": "695630901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956310",
            "initDialog": "695631001",
            "dialogues": [
                {
                    "id": "695631001",
                    "speaker": "绮良良",
                    "text": "赢了！神子大人教我的出牌方式果然有用，不愧是厉害的大妖怪！"
                }
            ]
        },
        {
            "talkId": "6956311",
            "initDialog": "695631101",
            "dialogues": [
                {
                    "id": "695631101",
                    "speaker": "绮良良",
                    "text": "输掉了…人类的游戏好复杂。"
                }
            ]
        },
        {
            "talkId": "6956312",
            "initDialog": "695631201",
            "dialogues": [
                {
                    "id": "695631201",
                    "speaker": "绮良良",
                    "text": "不知道自己下一张究竟会抽到什么牌，这点很让人期待！我们快点开始吧。"
                }
            ]
        },
        {
            "talkId": "6956314",
            "initDialog": "695631401",
            "dialogues": [
                {
                    "id": "695631401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6956315",
            "initDialog": "695631501",
            "dialogues": [
                {
                    "id": "695631501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6956316",
            "initDialog": "695631601",
            "dialogues": [
                {
                    "id": "695631601",
                    "speaker": "绮良良",
                    "text": "打牌好开心！唔…或者是，打牌赢了很开心？嘿嘿，下一局就换你开心啦！"
                }
            ]
        },
        {
            "talkId": "6956317",
            "initDialog": "695631701",
            "dialogues": [
                {
                    "id": "695631701",
                    "speaker": "绮良良",
                    "text": "呜哇，脑子变成毛线团了，完全不知道怎么出牌啦…"
                }
            ]
        },
        {
            "talkId": "6956318",
            "initDialog": "695631801",
            "dialogues": [
                {
                    "id": "695631801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}