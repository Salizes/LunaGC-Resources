{
    "groupId": "5029",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "利弗": 12
    },
    "talks": [
        {
            "talkId": "6502901",
            "initDialog": "650290101",
            "dialogues": [
                {
                    "id": "650290101",
                    "speaker": "利弗",
                    "text": "你好，莱舒的发条工坊就在这里。你是来选购发条工艺品的吗？还有许多有趣的玩具哦。"
                }
            ]
        },
        {
            "talkId": "6502902",
            "initDialog": "650290201",
            "dialogues": [
                {
                    "id": "650290201",
                    "speaker": "Player",
                    "text": "发条工艺品？"
                },
                {
                    "id": "650290202",
                    "speaker": "利弗",
                    "text": "没错，本店的特色机械装置，依靠发条进行驱动。"
                },
                {
                    "id": "650290203",
                    "speaker": "利弗",
                    "text": "小到玩具鸟，大到发条人偶，应有尽有。"
                },
                {
                    "id": "650290204",
                    "speaker": "利弗",
                    "text": "个个性能优秀、款式新颖，呃…就是发条人偶的对话听多了可能稍微会有点吵。"
                },
                {
                    "id": "650290205",
                    "speaker": "利弗",
                    "text": "你对发条动物感兴趣吗？店里有会奔跑的发条马、会吹喇叭的发条膨膨兽，还有会原地摇摆的发条企鹅。"
                }
            ]
        },
        {
            "talkId": "6502903",
            "initDialog": "650290301",
            "dialogues": [
                {
                    "id": "650290301",
                    "speaker": "Player",
                    "text": "枫丹还有企鹅？"
                },
                {
                    "id": "650290302",
                    "speaker": "利弗",
                    "text": "呃…你这样问，我倒是有点说不准了。"
                },
                {
                    "id": "650290303",
                    "speaker": "利弗",
                    "text": "一般来说，企鹅生活在寒冷的北方，不过也听说其中一些会在气候炎热的地带出没。"
                },
                {
                    "id": "650290304",
                    "speaker": "利弗",
                    "text": "店里的发条企鹅不是我做的，都是一个叫菲米尼的小伙子寄售在这的。"
                },
                {
                    "id": "650290305",
                    "speaker": "利弗",
                    "text": "他的手艺很不错，让我想起小时候的弟弟…"
                },
                {
                    "id": "650290306",
                    "speaker": "利弗",
                    "text": "我曾想邀请菲米尼先生来这里专职研发发条玩具，不过看他一副沉默寡言的样子，还是不强求了。"
                }
            ]
        },
        {
            "talkId": "6502904",
            "initDialog": "650290401",
            "dialogues": [
                {
                    "id": "650290401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650290402",
                    "speaker": "利弗",
                    "text": "有空再来玩啊。"
                }
            ]
        },
        {
            "talkId": "6502905",
            "initDialog": "650290501",
            "dialogues": [
                {
                    "id": "650290501",
                    "speaker": "Player",
                    "text": "发条企鹅？"
                },
                {
                    "id": "650290502",
                    "speaker": "利弗",
                    "text": "是一个叫菲米尼的小伙子寄售在这的。别说，他的手艺算是有两下子。要不是看他还有自己的追求，我差点就准备雇他专职研发发条玩具了。"
                }
            ]
        }
    ]
}