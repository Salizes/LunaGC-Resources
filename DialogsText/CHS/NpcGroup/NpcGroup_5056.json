{
    "groupId": "5056",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 6,
        "欧仁妮": 10
    },
    "talks": [
        {
            "talkId": "6505601",
            "initDialog": "650560101",
            "dialogues": [
                {
                    "id": "650560101",
                    "speaker": "欧仁妮",
                    "text": "要来看看新鲜蔬果吗？"
                }
            ]
        },
        {
            "talkId": "6505602",
            "initDialog": "650560201",
            "dialogues": [
                {
                    "id": "650560201",
                    "speaker": "Player",
                    "text": "看看。"
                },
                {
                    "id": "650560202",
                    "speaker": "欧仁妮",
                    "text": "我这的蔬菜水果个个饱满水灵，请您随意挑选！"
                }
            ]
        },
        {
            "talkId": "6505603",
            "initDialog": "650560301",
            "dialogues": [
                {
                    "id": "650560301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "650560302",
                    "speaker": "欧仁妮",
                    "text": "您好，我是这里的摊主。"
                },
                {
                    "id": "650560303",
                    "speaker": "欧仁妮",
                    "text": "如果我的叫卖声不小心吵到了您，还请多多包涵！一会儿我给您偷偷多塞几颗水果，嘿嘿。"
                }
            ]
        },
        {
            "talkId": "6505604",
            "initDialog": "650560401",
            "dialogues": [
                {
                    "id": "650560401",
                    "speaker": "Player",
                    "text": "关于蔬果…"
                },
                {
                    "id": "650560402",
                    "speaker": "欧仁妮",
                    "text": "枫丹本地盛产泡泡桔，但依靠发达的水路，也会引进很多国外的水果，只是价格会略高一些。"
                },
                {
                    "id": "650560403",
                    "speaker": "欧仁妮",
                    "text": "但请您放心，我欧仁妮绝不做亏心生意，保证客人买到的蔬果从头美味到根，绝不会有一个坏果。"
                }
            ]
        },
        {
            "talkId": "6505605",
            "initDialog": "650560501",
            "dialogues": [
                {
                    "id": "650560501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "650560502",
                    "speaker": "欧仁妮",
                    "text": "有空再来哦！我会准备好最甜的水果等着您的。"
                }
            ]
        },
        {
            "talkId": "6505606",
            "initDialog": "650560601",
            "dialogues": [
                {
                    "id": "650560601",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6505607",
            "initDialog": "650560701",
            "dialogues": [
                {
                    "id": "650560701",
                    "speaker": "欧仁妮",
                    "text": "新鲜的牌组，比钩钩果还少见，不好对付吧！"
                }
            ]
        },
        {
            "talkId": "6505608",
            "initDialog": "650560801",
            "dialogues": [
                {
                    "id": "650560801",
                    "speaker": "欧仁妮",
                    "text": "怎么这样！你的打法就像枣椰…我完全不知道该怎么应对！"
                }
            ]
        },
        {
            "talkId": "7492901",
            "initDialog": "749290101",
            "dialogues": [
                {
                    "id": "749290101",
                    "speaker": "Player",
                    "text": "真的吗？"
                },
                {
                    "id": "749290102",
                    "speaker": "欧仁妮",
                    "text": "当然！这一批果子是今早刚从蒙德进来的，特别甜哦！请您尽管尝尝，不用客气，好吃再来。"
                }
            ]
        }
    ]
}