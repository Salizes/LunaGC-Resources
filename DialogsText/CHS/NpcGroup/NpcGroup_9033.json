{
    "groupId": "9033",
    "total_dialogue_lines": 53,
    "speaker_counts": {
        "Player": 14,
        "达达利亚": 39
    },
    "talks": [
        {
            "talkId": "6903301",
            "initDialog": "690330101",
            "dialogues": [
                {
                    "id": "690330101",
                    "speaker": "达达利亚",
                    "text": "#好久不见，{NICKNAME}。"
                },
                {
                    "id": "690330102",
                    "speaker": "达达利亚",
                    "text": "我又变强了不少哦，要来切磋一下吗？"
                },
                {
                    "id": "690330103",
                    "speaker": "达达利亚",
                    "text": "…开玩笑的。嗯，来找我是有话想说吧。"
                }
            ]
        },
        {
            "talkId": "6903302",
            "initDialog": "690330201",
            "dialogues": [
                {
                    "id": "690330201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690330202",
                    "speaker": "达达利亚",
                    "text": "嗯，这里太适合居家生活了。"
                },
                {
                    "id": "690330203",
                    "speaker": "达达利亚",
                    "text": "美丽、僻静…也温馨。"
                },
                {
                    "id": "690330204",
                    "speaker": "达达利亚",
                    "text": "真想把冬妮娅、安东和托克他们都叫来住…",
                    "choices": [
                        {
                            "id": "690330205",
                            "text": "我这住不下那么多人…",
                            "response": [
                                {
                                    "id": "690330207",
                                    "speaker": "达达利亚",
                                    "text": "哈哈哈哈，抱歉，我不是那个意思。"
                                },
                                {
                                    "id": "690330208",
                                    "speaker": "达达利亚",
                                    "text": "我只是想到，冬妮娅他们有你陪的话，一定会很开心的。"
                                }
                            ]
                        },
                        {
                            "id": "690330206",
                            "text": "其实我没有你想得那么擅长照顾孩子…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903303",
            "initDialog": "690330301",
            "dialogues": [
                {
                    "id": "690330301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690330302",
                    "speaker": "达达利亚",
                    "text": "好，我很乐意。"
                },
                {
                    "id": "690330303",
                    "speaker": "达达利亚",
                    "text": "在至冬，有一种烈酒叫做「火水」。"
                },
                {
                    "id": "690330304",
                    "speaker": "达达利亚",
                    "text": "一边在冰天雪地里喝着「火水」一边聊天的两人，基本就已经要好到了能上战场的关系。"
                },
                {
                    "id": "690330305",
                    "speaker": "达达利亚",
                    "text": "现在，我可以和你这样自在地聊着天。"
                },
                {
                    "id": "690330306",
                    "speaker": "达达利亚",
                    "text": "在战场上，我也能将后背托付给你。",
                    "choices": [
                        {
                            "id": "690330307",
                            "text": "你不怕我会先袭击你吗？",
                            "response": [
                                {
                                    "id": "690330308",
                                    "speaker": "达达利亚",
                                    "text": "这就是我对你的信任了。"
                                },
                                {
                                    "id": "690330311",
                                    "speaker": "达达利亚",
                                    "text": "征服世界的道路上，如果有你相伴，我们可就是最强的组合了。"
                                },
                                {
                                    "id": "690330312",
                                    "speaker": "达达利亚",
                                    "text": "你愿意接受我的邀请吗？"
                                }
                            ]
                        },
                        {
                            "id": "690330309",
                            "text": "你不怕我会先倒下吗？",
                            "response": [
                                {
                                    "id": "690330310",
                                    "speaker": "达达利亚",
                                    "text": "那你可就对自己的实力太不自信了。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903304",
            "initDialog": "690330401",
            "dialogues": [
                {
                    "id": "690330401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690330402",
                    "speaker": "达达利亚",
                    "text": "嗯…你什么时候能抽出几周的闲暇呢。"
                },
                {
                    "id": "690330403",
                    "speaker": "达达利亚",
                    "text": "我想带你看看老家的风景。"
                },
                {
                    "id": "690330404",
                    "speaker": "达达利亚",
                    "text": "看看漫天的风雪，站上去踩几脚都不会碎开的冰湖湖面。"
                },
                {
                    "id": "690330405",
                    "speaker": "达达利亚",
                    "text": "有的人家会做大型的冰雕作品…"
                },
                {
                    "id": "690330406",
                    "speaker": "达达利亚",
                    "text": "如果你喜欢打雪仗的话，我可以和你一队，让弟弟妹妹们一起上。"
                },
                {
                    "id": "690330407",
                    "speaker": "达达利亚",
                    "text": "哦，对了！我还可以用老家的特产给你做地道的甜菜汤。"
                },
                {
                    "id": "690330408",
                    "speaker": "达达利亚",
                    "text": "…还能冰钓钓鱼！比池子里养的鱼可大多了。",
                    "choices": [
                        {
                            "id": "690330409",
                            "text": "听起来很棒。",
                            "response": [
                                {
                                    "id": "690330411",
                                    "speaker": "达达利亚",
                                    "text": "好，那就说好了！"
                                },
                                {
                                    "id": "690330412",
                                    "speaker": "达达利亚",
                                    "text": "哈…看来我得先跟家里知会一声。"
                                },
                                {
                                    "id": "690330413",
                                    "speaker": "达达利亚",
                                    "text": "我都想象得到，他们围在一起读信时，脸上开心的表情啦。"
                                }
                            ]
                        },
                        {
                            "id": "690330410",
                            "text": "我很期待！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903305",
            "initDialog": "690330501",
            "dialogues": [
                {
                    "id": "690330501",
                    "speaker": "Player",
                    "text": "早啊，达达利亚。"
                },
                {
                    "id": "690330500",
                    "speaker": "达达利亚",
                    "text": "早啊，伙伴。"
                },
                {
                    "id": "690330502",
                    "speaker": "达达利亚",
                    "text": "要是遇上连你也感到棘手的战斗，别忘了叫我。"
                },
                {
                    "id": "690330503",
                    "speaker": "达达利亚",
                    "text": "我也想…活动活动筋骨了。"
                }
            ]
        },
        {
            "talkId": "6903306",
            "initDialog": "690330601",
            "dialogues": [
                {
                    "id": "690330601",
                    "speaker": "Player",
                    "text": "晚安，达达利亚。"
                },
                {
                    "id": "690330602",
                    "speaker": "达达利亚",
                    "text": "已经到说晚安的时间了吗…"
                },
                {
                    "id": "690330603",
                    "speaker": "达达利亚",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690330604",
                    "speaker": "达达利亚",
                    "text": "不知道下一次见到你…又是什么时候呢。"
                }
            ]
        },
        {
            "talkId": "6903307",
            "initDialog": "690330701",
            "dialogues": [
                {
                    "id": "690330701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6903308",
            "initDialog": "690330801",
            "dialogues": [
                {
                    "id": "690330801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6903309",
            "initDialog": "690330901",
            "dialogues": [
                {
                    "id": "690330901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6903350",
            "initDialog": "690335001",
            "dialogues": [
                {
                    "id": "690335001",
                    "speaker": "达达利亚",
                    "text": "厨房？有意思，那我就来露一手吧，以前我可是经常下厨的！"
                },
                {
                    "id": "690335002",
                    "speaker": "达达利亚",
                    "text": "食物和武器有着相同的价值，品尝对手做的饭菜，也是一种战斗。"
                },
                {
                    "id": "690335003",
                    "speaker": "达达利亚",
                    "text": "不知道你…敢不敢接受我的挑战啊？"
                }
            ]
        },
        {
            "talkId": "6903351",
            "initDialog": "690335101",
            "dialogues": [
                {
                    "id": "690335101",
                    "speaker": "达达利亚",
                    "text": "浓郁的香气，真是让人心情畅快。"
                },
                {
                    "id": "690335102",
                    "speaker": "达达利亚",
                    "text": "之前我尝过「琉璃亭」、「新月轩」的菜肴，但异国美食，只去华贵酒家肯定也领略不全。"
                },
                {
                    "id": "690335103",
                    "speaker": "达达利亚",
                    "text": "带我尝尝当地特色小吃的工作，就交给你了哦？"
                }
            ]
        }
    ]
}