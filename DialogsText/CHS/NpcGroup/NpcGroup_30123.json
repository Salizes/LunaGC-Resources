    "talks": [
        {
            "talkId": "7165804",
            "initDialog": "716580401",
            "dialogues": [
                {
                    "id": "716580401",
                    "speaker": "胡桃",
                    "text": "#哎呀哎呀，{NICKNAME}，海灯节快乐呀！"
                },
                {
                    "id": "716580402",
                    "speaker": "胡桃",
                    "text": "大好的日子跑我这里来，嗯嗯…肯定不是来办业务吧。怎么了？有事要我帮忙吗？",
                    "choices": [
                        {
                            "id": "716580403",
                            "text": "只是来看看你。",
                            "response": [
                                {
                                    "id": "716580405",
                                    "speaker": "胡桃",
                                    "text": "哦——！原来只是单纯想我了？你呀…突然这么贴心，我都不好意思编故事吓你了。"
                                },
                                {
                                    "id": "716580406",
                                    "speaker": "胡桃",
                                    "text": "其实，海灯节期间我也很忙的。我问香菱要了几份菜谱，正在试做呢，你来都来了，不如试试…"
                                },
                                {
                                    "id": "716580407",
                                    "speaker": "胡桃",
                                    "text": "欸——干嘛，干嘛这个表情？不会是要走吧，别这样，保证不难吃！"
                                }
                            ]
                        },
                        {
                            "id": "716580404",
                            "text": "来找你聊聊天。"
                        }
                    ]
                }
            ]
        }
    ]
}