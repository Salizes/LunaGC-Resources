{
    "groupId": "13090",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 3,
        "「千日喧哗大飞车」": 13,
        "派蒙": 3
    },
    "talks": [
        {
            "talkId": "7273008",
            "initDialog": "727300801",
            "dialogues": [
                {
                    "id": "727300801",
                    "speaker": "「千日喧哗大飞车」",
                    "text": "搞什么…那个鬼族的男人可真强！还满口大义凛然的话…世界上居然还有这种人！",
                    "choices": [
                        {
                            "id": "727300802",
                            "text": "我们也要教训你！",
                            "response": [
                                {
                                    "id": "727300803",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "怎么回事！你们可别小看我啊！如果拿不出那家伙的豪气，你们是战胜不了我的！"
                                }
                            ]
                        },
                        {
                            "id": "727300804",
                            "text": "关于「花角玉将」…",
                            "response": [
                                {
                                    "id": "727300805",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "大将？突然问这个做什么？"
                                },
                                {
                                    "id": "727300806",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "我劝你们不要和他作对！讲道理，你们讲不过他，斗虫也未必是他的对手。"
                                },
                                {
                                    "id": "727300807",
                                    "speaker": "派蒙",
                                    "text": "未必？你的语气没有以前那么嚣张了嘛，看来是放牛的狠狠地给了你一个教训！"
                                },
                                {
                                    "id": "727300808",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "男子汉之间的比拼，能叫教训吗？输了就是输了，耍嘴皮子不认账，可就是死不要脸了！"
                                },
                                {
                                    "id": "727300809",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "我「千日喧哗大飞车」在气势上输给了「真剑斗虫大鬼王」，就算他要我把称号里的「大」字改成「小」字，我也认栽！"
                                },
                                {
                                    "id": "727300810",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "既然你们是他的伙伴，那说不定也能以我没想过的方法，让大将陷入苦战…"
                                },
                                {
                                    "id": "727300811",
                                    "speaker": "派蒙",
                                    "text": "嘿嘿，这么一听，你还蛮机灵的嘛，不是那种死脑筋的坏人。"
                                },
                                {
                                    "id": "727300812",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "这都是大将教给我的道理。"
                                },
                                {
                                    "id": "727300813",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "以前我还是个没人留意的，只会和人吵架的混混，看不起这个看不起那个…"
                                },
                                {
                                    "id": "727300814",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "大将让我玩了这种小孩才喜欢的游戏，告诉我，只有傲气和狠劲是不够的，如果连斗虫这种事都做不好，那就证明我连小孩都不如。"
                                },
                                {
                                    "id": "727300815",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "所以一直以来，我都把斗虫当成证明自己的途径。"
                                },
                                {
                                    "id": "727300816",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "不过，「真剑斗虫大鬼王」和你们出现了，让我觉得，以前自己是不是有点浮躁，对斗虫这件事有什么误解…"
                                },
                                {
                                    "id": "727300817",
                                    "speaker": "派蒙",
                                    "text": "好啊，你就用力反省吧！证明自己是一回事，享受游戏的真谛也很重要哦！"
                                }
                            ]
                        },
                        {
                            "id": "727300818",
                            "text": "再见！",
                            "response": [
                                {
                                    "id": "727300819",
                                    "speaker": "「千日喧哗大飞车」",
                                    "text": "呃…那就以后再说吧！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}