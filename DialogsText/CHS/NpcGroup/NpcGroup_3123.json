{
    "groupId": "3123",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "玄三": 11
    },
    "talks": [
        {
            "talkId": "6312301",
            "initDialog": "631230101",
            "dialogues": [
                {
                    "id": "631230101",
                    "speaker": "玄三",
                    "text": "你是谁，来这做什么？"
                },
                {
                    "id": "631230102",
                    "speaker": "玄三",
                    "text": "是平民的话就赶紧离开这里，要是等我的上司来赶你走的话，你的麻烦就大了。"
                }
            ]
        },
        {
            "talkId": "6312302",
            "initDialog": "631230201",
            "dialogues": [
                {
                    "id": "631230201",
                    "speaker": "Player",
                    "text": "关于你自己…"
                },
                {
                    "id": "631230202",
                    "speaker": "玄三",
                    "text": "我只是一介幕府的小兵，跟着上司在这里执行任务。"
                },
                {
                    "id": "631230203",
                    "speaker": "玄三",
                    "text": "和我的上司寺田大人比起来，我根本不算什么，不足为提，哈哈。"
                }
            ]
        },
        {
            "talkId": "6312303",
            "initDialog": "631230301",
            "dialogues": [
                {
                    "id": "631230301",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "631230302",
                    "speaker": "玄三",
                    "text": "赶紧离开，别惹麻烦。"
                }
            ]
        },
        {
            "talkId": "6312304",
            "initDialog": "631230401",
            "dialogues": [
                {
                    "id": "631230401",
                    "speaker": "Player",
                    "text": "关于你的上司…"
                },
                {
                    "id": "631230402",
                    "speaker": "玄三",
                    "text": "你这种怀疑的语气是怎么回事，难道以为我们是假冒的？"
                },
                {
                    "id": "631230403",
                    "speaker": "玄三",
                    "text": "幕府官兵在此，这是我的证件，货真价实，你这种闲杂人等休得无礼！"
                },
                {
                    "id": "631230404",
                    "speaker": "玄三",
                    "text": "至于寺田大人，他身份地位都在我之上，怎么能随便给你看凭证。"
                },
                {
                    "id": "631230405",
                    "speaker": "玄三",
                    "text": "寺田大人战功累累，身手不凡，又宅心仁厚，体恤下属，值得尊敬。"
                },
                {
                    "id": "631230406",
                    "speaker": "玄三",
                    "text": "我自从跟着寺田大人，既不用整天辛苦维持纪律，也不必冒着生命危险打仗，走到哪里都不会饿肚子，再也不用为了生活发愁。"
                },
                {
                    "id": "631230407",
                    "speaker": "玄三",
                    "text": "这样好的上司哪里都找不到，你可不许给我搞事情，听到了没。"
                }
            ]
        }
    ]
}