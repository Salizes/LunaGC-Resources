{
    "groupId": "1796",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 7,
        "莱奥诺拉": 21
    },
    "talks": [
        {
            "talkId": "6179601",
            "initDialog": "617960101",
            "dialogues": [
                {
                    "id": "617960101",
                    "speaker": "莱奥诺拉",
                    "text": "还得再提升准确度啊…改进工作一时半会儿还完成不了。"
                }
            ]
        },
        {
            "talkId": "6179602",
            "initDialog": "617960201",
            "dialogues": [
                {
                    "id": "617960201",
                    "speaker": "Player",
                    "text": "准确度？"
                },
                {
                    "id": "617960202",
                    "speaker": "莱奥诺拉",
                    "text": "唔…确切地说，是骑士们的两大能力——"
                },
                {
                    "id": "617960203",
                    "speaker": "莱奥诺拉",
                    "text": "无论是远距离辨识敌人的准确度，还是铳枪、野战火炮和弓弩打击敌人时的准确度，都有进步空间。"
                },
                {
                    "id": "617960204",
                    "speaker": "莱奥诺拉",
                    "text": "提升这两项指标后，就能留足反应的时间，和有效杀伤的距离，掌握战斗的主动权。",
                    "choices": [
                        {
                            "id": "617960205",
                            "text": "远程作战也不能拦住一切吧？",
                            "response": [
                                {
                                    "id": "617960207",
                                    "speaker": "莱奥诺拉",
                                    "text": "那就拔剑举盾，打场传统的格斗战。"
                                },
                                {
                                    "id": "617960208",
                                    "speaker": "莱奥诺拉",
                                    "text": "和枫丹特巡队的朋友们不同，西风骑士们必须先牢牢掌握剑术，再修习其他武器。"
                                },
                                {
                                    "id": "617960209",
                                    "speaker": "莱奥诺拉",
                                    "text": "即便是如今铳枪训练占比最高的远程小队，在每年一度的考核中，也逃不过剑术这一科目。"
                                },
                                {
                                    "id": "617960210",
                                    "speaker": "莱奥诺拉",
                                    "text": "至少要在三剑内有效打击丘丘人打手，将对方击退，等待其他骑士的支援。"
                                },
                                {
                                    "id": "617960211",
                                    "speaker": "莱奥诺拉",
                                    "text": "而对联兵小队中混编的骑士，标准就更严苛些。"
                                },
                                {
                                    "id": "617960212",
                                    "speaker": "莱奥诺拉",
                                    "text": "总之，训练的目标很明确——让敌人远打近打，都吃不了兜着走！"
                                }
                            ]
                        },
                        {
                            "id": "617960206",
                            "text": "要是敌人冲到面前了怎么办？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6179603",
            "initDialog": "617960301",
            "dialogues": [
                {
                    "id": "617960301",
                    "speaker": "Player",
                    "text": "这事完了后也会有新工作的。"
                },
                {
                    "id": "617960302",
                    "speaker": "莱奥诺拉",
                    "text": "也是，你倒看得透彻。"
                },
                {
                    "id": "617960303",
                    "speaker": "莱奥诺拉",
                    "text": "所以，需要给自己树立一个准确的界碑，干完这票就收手！"
                },
                {
                    "id": "617960304",
                    "speaker": "莱奥诺拉",
                    "text": "和方妮雅一起完善信号官的条令后，我就去找芙蕾德莉卡队长提退休！"
                }
            ]
        },
        {
            "talkId": "6179605",
            "initDialog": "617960501",
            "dialogues": [
                {
                    "id": "617960501",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "617960502",
                    "speaker": "莱奥诺拉",
                    "text": "如你所见，只是个普通的风车维护员…"
                },
                {
                    "id": "617960503",
                    "speaker": "莱奥诺拉",
                    "text": "哈哈，不开玩笑了。说不定以后还有与你并肩作战的机会，荣誉骑士。"
                },
                {
                    "id": "617960504",
                    "speaker": "莱奥诺拉",
                    "text": "在下莱奥诺拉，「联兵小队」的信号官，距离退休还有个几年，还能发挥发挥余热。"
                },
                {
                    "id": "617960505",
                    "speaker": "莱奥诺拉",
                    "text": "当然，更有可能是我的学员，正跟着安柏深造的耶嘉·格蕾特与你们继续合作。"
                },
                {
                    "id": "617960506",
                    "speaker": "Player",
                    "text": "你的学员…跟着安柏？"
                },
                {
                    "id": "617960507",
                    "speaker": "莱奥诺拉",
                    "text": "嗯，信号官的核心任务是侦察，在这个领域，安柏有着全骑士团断档领先的经验。"
                },
                {
                    "id": "617960508",
                    "speaker": "莱奥诺拉",
                    "text": "虽然作为「先导力量」，独自一人前出侦察，和作为小队先锋带着分组侦察，也并非完全相同…"
                },
                {
                    "id": "617960509",
                    "speaker": "莱奥诺拉",
                    "text": "但在路线规划，阵位选择和保持隐蔽等方面，耶嘉要向安柏学的东西还多着呢！"
                }
            ]
        },
        {
            "talkId": "6179606",
            "initDialog": "617960601",
            "dialogues": [
                {
                    "id": "617960601",
                    "speaker": "Player",
                    "text": "你忙你的，我不打扰了。"
                },
                {
                    "id": "617960602",
                    "speaker": "莱奥诺拉",
                    "text": "真客气…那再见了。"
                }
            ]
        }
    ]
}