{
    "groupId": "4506",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "玛卡尼哈冈": 6
    },
    "talks": [
        {
            "talkId": "6450601",
            "initDialog": "645060101",
            "dialogues": [
                {
                    "id": "645060101",
                    "speaker": "玛卡尼哈冈",
                    "text": "孤乃统领七域的大哈冈，赤土之主玛卡尼大王，今日得以觐见孤是你的荣幸。"
                }
            ]
        },
        {
            "talkId": "6450602",
            "initDialog": "645060201",
            "dialogues": [
                {
                    "id": "645060201",
                    "speaker": "Player",
                    "text": "呃，历史上有这个王吗？"
                },
                {
                    "id": "645060202",
                    "speaker": "玛卡尼哈冈",
                    "text": "什么？难道你从没有在刻在方尖碑上的铭文中读到过孤的名号吗？该不会在历史上留下姓名的，反而是孤的手下败将呼玛云吧？"
                },
                {
                    "id": "645060203",
                    "speaker": "玛卡尼哈冈",
                    "text": "哼，我早该知道我豢养的那些个诗人和书记官都是骗吃骗喝的饭桶，当初就应该把他们全部处死。"
                }
            ]
        },
        {
            "talkId": "6450603",
            "initDialog": "645060301",
            "dialogues": [
                {
                    "id": "645060301",
                    "speaker": "Player",
                    "text": "微臣告退。"
                },
                {
                    "id": "645060302",
                    "speaker": "玛卡尼哈冈",
                    "text": "哈，你倒挺有礼貌，孤很欣赏你。"
                }
            ]
        },
        {
            "talkId": "6450604",
            "initDialog": "645060401",
            "dialogues": [
                {
                    "id": "645060401",
                    "speaker": "Player",
                    "text": "沙漠历史那么乱，这倒也很正常。"
                },
                {
                    "id": "645060402",
                    "speaker": "玛卡尼哈冈",
                    "text": "可惜你没见过孤麾下那如黑云般的军势，赤霞般的旌旗，还有那些被孤的马蹄踏碎的王座。"
                },
                {
                    "id": "645060403",
                    "speaker": "玛卡尼哈冈",
                    "text": "没想到那样的霸业也不过是过眼云烟，被世人所遗忘，不像图莱杜拉的那些文弱之主，反而有人给他们歌功颂德。"
                }
            ]
        }
    ]
}