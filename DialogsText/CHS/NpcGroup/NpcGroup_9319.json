{
    "groupId": "9319",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "刻晴": 9
    },
    "talks": [
        {
            "talkId": "6931901",
            "initDialog": "693190101",
            "dialogues": [
                {
                    "id": "693190101",
                    "speaker": "刻晴",
                    "text": "从前我一向认为，一旦决定了要做某件事，就要立刻动身，尽快完成。"
                },
                {
                    "id": "693190102",
                    "speaker": "刻晴",
                    "text": "然而，协助我工作的人很少能坚持超过三个月，频繁调换人员反倒让整个体系变得更低效了。"
                },
                {
                    "id": "693190103",
                    "speaker": "刻晴",
                    "text": "后来我也就明白，如果把目光放得长远些，适当的休息更能提高整体效率。"
                }
            ]
        },
        {
            "talkId": "6931902",
            "initDialog": "693190201",
            "dialogues": [
                {
                    "id": "693190201",
                    "speaker": "刻晴",
                    "text": "敌人越来越强，并不完全是坏事。"
                },
                {
                    "id": "693190202",
                    "speaker": "刻晴",
                    "text": "一成不变的情势，会把你的判断力和执行力都消磨干净，也无法为你提供更多经验。"
                },
                {
                    "id": "693190203",
                    "speaker": "刻晴",
                    "text": "今日你我携手，不妨大胆尝试。"
                }
            ]
        },
        {
            "talkId": "6931903",
            "initDialog": "693190301",
            "dialogues": [
                {
                    "id": "693190301",
                    "speaker": "刻晴",
                    "text": "想要开创未来，就不该迷信古人的经验。"
                },
                {
                    "id": "693190302",
                    "speaker": "刻晴",
                    "text": "但古籍中所论述的道理往往具有泛用性。所谓温故知新，大抵如此。"
                },
                {
                    "id": "693190303",
                    "speaker": "刻晴",
                    "text": "如今我做重要决定前会参考一下古籍中的记载，这样一来，往往能想到一些不错的点子。"
                }
            ]
        }
    ]
}