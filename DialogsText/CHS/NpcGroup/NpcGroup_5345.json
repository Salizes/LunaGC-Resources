{
    "groupId": "5345",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "巴比斯": 19
    },
    "talks": [
        {
            "talkId": "6534501",
            "initDialog": "653450101",
            "dialogues": [
                {
                    "id": "653450101",
                    "speaker": "巴比斯",
                    "text": "必须想办法解决这些结构问题才行…"
                }
            ]
        },
        {
            "talkId": "6534502",
            "initDialog": "653450201",
            "dialogues": [
                {
                    "id": "653450201",
                    "speaker": "Player",
                    "text": "什么问题？"
                },
                {
                    "id": "653450202",
                    "speaker": "巴比斯",
                    "text": "我设计了一艘可以高速行驶的巡轨船，但问题是…"
                },
                {
                    "id": "653450203",
                    "speaker": "巴比斯",
                    "text": "只要高速行进时间超过一个阶段，它的内部结构就会开始高强度振动，内部元件也随之损坏…"
                },
                {
                    "id": "653450204",
                    "speaker": "巴比斯",
                    "text": "我换了许多材料，却都无法解决这个问题。到底是我的设计有问题，还是我采用的材料有问题？"
                }
            ]
        },
        {
            "talkId": "6534503",
            "initDialog": "653450301",
            "dialogues": [
                {
                    "id": "653450301",
                    "speaker": "Player",
                    "text": "能看看那艘巡轨船吗？"
                },
                {
                    "id": "653450302",
                    "speaker": "巴比斯",
                    "text": "欸？目前的试做版都放在我的研究室里了，我出来是为了…"
                },
                {
                    "id": "653450303",
                    "speaker": "巴比斯",
                    "text": "为了…呃，为了…寻找…材料…"
                },
                {
                    "id": "653450304",
                    "speaker": "巴比斯",
                    "text": "神王还为我…为我指派了一支护卫队，能在神王的光辉下进行研究，实在是一种幸福…"
                }
            ]
        },
        {
            "talkId": "6534504",
            "initDialog": "653450401",
            "dialogues": [
                {
                    "id": "653450401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "653450402",
                    "speaker": "巴比斯",
                    "text": "再见。外来者…再见。"
                }
            ]
        },
        {
            "talkId": "6534505",
            "initDialog": "653450501",
            "dialogues": [
                {
                    "id": "653450501",
                    "speaker": "巴比斯",
                    "text": "说到炮弹，最重要的就是够大！你说对吗？"
                }
            ]
        },
        {
            "talkId": "6534506",
            "initDialog": "653450601",
            "dialogues": [
                {
                    "id": "653450601",
                    "speaker": "Player",
                    "text": "你要那么大炮弹做什么？"
                },
                {
                    "id": "653450602",
                    "speaker": "巴比斯",
                    "text": "当然是坐在那枚炮弹里，借助那门大炮的推力，飞到天上去！"
                },
                {
                    "id": "653450603",
                    "speaker": "巴比斯",
                    "text": "按照我的设计，这枚炮弹是中空的，里面要能坐上两…三个人。"
                },
                {
                    "id": "653450604",
                    "speaker": "巴比斯",
                    "text": "在周围还要垫上厚垫子，免得发射的时候，我们被撞在炮弹壁上受伤。"
                },
                {
                    "id": "653450605",
                    "speaker": "巴比斯",
                    "text": "当然了，还要准备食物、水、留影机等等东西…"
                }
            ]
        },
        {
            "talkId": "6534507",
            "initDialog": "653450701",
            "dialogues": [
                {
                    "id": "653450701",
                    "speaker": "Player",
                    "text": "等等等等，这么大的炮弹用什么做？"
                },
                {
                    "id": "653450702",
                    "speaker": "巴比斯",
                    "text": "呃…这正是我打算解决的问题。"
                },
                {
                    "id": "653450703",
                    "speaker": "巴比斯",
                    "text": "我已经准备了好几种实验材料，我准备将这些材料分别做成炮弹，然后在里面放上一些小动物作为…乘客。"
                },
                {
                    "id": "653450704",
                    "speaker": "巴比斯",
                    "text": "唉，说到这里，还得多谢那位先生的「高速巡轨船」，这艘船的设计给了我许多启发。"
                },
                {
                    "id": "653450705",
                    "speaker": "巴比斯",
                    "text": "虽然那艘巡轨船和炮弹的「高速」并不是同一层级，但依然有许多设计思路可以参考。"
                }
            ]
        },
        {
            "talkId": "6534508",
            "initDialog": "653450801",
            "dialogues": [
                {
                    "id": "653450801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "653450802",
                    "speaker": "巴比斯",
                    "text": "再见。这炮弹的外壳，到底该用什么材料呢…"
                }
            ]
        },
        {
            "talkId": "6534509",
            "initDialog": "653450901",
            "dialogues": [
                {
                    "id": "653450901",
                    "speaker": "巴比斯",
                    "text": "你们得…我们得仰头看天，别总瞅着摩拉和高楼，空无一物的地方才是研究者的归宿…"
                }
            ]
        }
    ]
}