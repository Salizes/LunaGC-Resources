{
    "groupId": "6145",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "卡卡妈妈": 10,
        "瓦兰卡": 3
    },
    "talks": [
        {
            "talkId": "7502117",
            "initDialog": "750211701",
            "dialogues": [
                {
                    "id": "750211701",
                    "speaker": "瓦兰卡",
                    "text": "他胆大的性格就和他母亲一样…唉…"
                },
                {
                    "id": "750211702",
                    "speaker": "卡卡妈妈",
                    "text": "那孩子机灵得很，再说了，毕竟还是小孩子，不会跑去太远的地方，你也不要太担心了。"
                },
                {
                    "id": "750211703",
                    "speaker": "瓦兰卡",
                    "text": "一想到如果他也有可能遭遇那样的…"
                },
                {
                    "id": "750211704",
                    "speaker": "卡卡妈妈",
                    "text": "不会的！你别在这儿自己吓自己了，凡事要往好处想。"
                },
                {
                    "id": "750211705",
                    "speaker": "卡卡妈妈",
                    "text": "待会儿我去帮你找他，他肯定没事的，说不定又跟谁家的孩子一起在外边玩，忘记了时间而已。"
                },
                {
                    "id": "750211706",
                    "speaker": "瓦兰卡",
                    "text": "谢谢…"
                }
            ]
        },
        {
            "talkId": "7502119",
            "initDialog": "750211901",
            "dialogues": [
                {
                    "id": "750211901",
                    "speaker": "卡卡妈妈",
                    "text": "严厉一点才是为孩子着想，你说是吧？",
                    "choices": [
                        {
                            "id": "750211902",
                            "text": "关于奥尔科…",
                            "response": [
                                {
                                    "id": "750211903",
                                    "speaker": "卡卡妈妈",
                                    "text": "我说的就是那孩子。就是因为他家那个情况，才更需要他快些自立。他父母的遭遇的确是个悲剧，但事情毕竟已经发生了…"
                                },
                                {
                                    "id": "750211904",
                                    "speaker": "卡卡妈妈",
                                    "text": "老是陷在过去的事里也没有用，人还是得向前看。那孩子今后就只有靠他自己了。"
                                }
                            ]
                        },
                        {
                            "id": "750211905",
                            "text": "关于从天上掉下来的星星…",
                            "response": [
                                {
                                    "id": "750211906",
                                    "speaker": "卡卡妈妈",
                                    "text": "你是说那块奇怪的石头吧？那的确是从天上掉下来的东西。虽然怪得很，但似乎也没什么害处。"
                                },
                                {
                                    "id": "750211907",
                                    "speaker": "卡卡妈妈",
                                    "text": "不过奥尔科说的故事应该和那块怪石头没什么联系。毕竟故事已经流传了很久，而且讲的是「烟谜主」的事。"
                                },
                                {
                                    "id": "750211908",
                                    "speaker": "卡卡妈妈",
                                    "text": "唉，也不是不能体谅瓦兰卡的心情，但孩子迟早有一天要面对事实，或许早一点反而更好。"
                                }
                            ]
                        },
                        {
                            "id": "750211909",
                            "text": "先告辞了。",
                            "response": [
                                {
                                    "id": "750211910",
                                    "speaker": "卡卡妈妈",
                                    "text": "路上小心！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}