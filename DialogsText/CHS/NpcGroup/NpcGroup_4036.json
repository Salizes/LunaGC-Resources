    "talks": [
        {
            "talkId": "6403601",
            "initDialog": "640360101",
            "dialogues": [
                {
                    "id": "640360101",
                    "speaker": "清涟",
                    "text": "这种用宝石制作化妆品的手艺，没准在璃月也能有销路…"
                }
            ]
        },
        {
            "talkId": "6403602",
            "initDialog": "640360201",
            "dialogues": [
                {
                    "id": "640360201",
                    "speaker": "Player",
                    "text": "宝石？化妆品？"
                },
                {
                    "id": "640360202",
                    "speaker": "清涟",
                    "text": "对，须弥人会用研磨后的宝石粉末制作化妆品，据说对皮肤有着保养的功效。"
                },
                {
                    "id": "640360203",
                    "speaker": "清涟",
                    "text": "好像还有学者专门研究宝石粉末对不同肤质的保养效果的差异。"
                },
                {
                    "id": "640360204",
                    "speaker": "清涟",
                    "text": "不过因为所用的宝石十分昂贵，有不少需要从璃月进口，所以在须弥这是有钱人才用得起的奢侈品。"
                },
                {
                    "id": "640360205",
                    "speaker": "清涟",
                    "text": "我在想，璃月盛产珍奇的矿石，如果能把这种手艺带回去的话，是不是能打开新的市场呢…"
                }
            ]
        },
        {
            "talkId": "6403603",
            "initDialog": "640360301",
            "dialogues": [
                {
                    "id": "640360301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640360302",
                    "speaker": "清涟",
                    "text": "再见，我要好好研究一下…"
                }
            ]
        }
    ]
}