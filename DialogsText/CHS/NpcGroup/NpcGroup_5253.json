{
    "groupId": "5253",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 3,
        "德斯诺斯": 6
    },
    "talks": [
        {
            "talkId": "6525301",
            "initDialog": "652530101",
            "dialogues": [
                {
                    "id": "652530101",
                    "speaker": "德斯诺斯",
                    "text": "我到底什么时候才能回科学院去办公…"
                }
            ]
        },
        {
            "talkId": "6525302",
            "initDialog": "652530201",
            "dialogues": [
                {
                    "id": "652530201",
                    "speaker": "Player",
                    "text": "你还在这里办公吗？"
                },
                {
                    "id": "652530202",
                    "speaker": "德斯诺斯",
                    "text": "荣誉高级研究员！很高兴见到您。坐下吧，我给您泡杯咖啡…喔，我的咖啡已经喝完了，看来只能给您倒杯水了。"
                },
                {
                    "id": "652530203",
                    "speaker": "德斯诺斯",
                    "text": "没错，如您所见，我还在这里继续履行着我「资质审核」的职责。但…还是和之前一样，根本没多少冒险家前来应聘。"
                }
            ]
        },
        {
            "talkId": "6525303",
            "initDialog": "652530301",
            "dialogues": [
                {
                    "id": "652530301",
                    "speaker": "Player",
                    "text": "不打扰你工作了。"
                },
                {
                    "id": "652530302",
                    "speaker": "德斯诺斯",
                    "text": "哪里的话，请您慢走。"
                }
            ]
        },
        {
            "talkId": "6525304",
            "initDialog": "652530401",
            "dialogues": [
                {
                    "id": "652530401",
                    "speaker": "Player",
                    "text": "你居然还有咖啡喝？"
                },
                {
                    "id": "652530402",
                    "speaker": "德斯诺斯",
                    "text": "当然，这里算是枫丹科学院的正式外驻办公室，一切办公耗材都是按照正式办公室的标准供应。"
                },
                {
                    "id": "652530403",
                    "speaker": "德斯诺斯",
                    "text": "再说了，我这间四面透风的办公室至少还有一个天花板，比那些办公室整个灰飞烟灭的项目组可好多啦。"
                }
            ]
        }
    ]
}