{
    "groupId": "6034",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "莎娜": 12
    },
    "talks": [
        {
            "talkId": "6603401",
            "initDialog": "660340101",
            "dialogues": [
                {
                    "id": "660340101",
                    "speaker": "莎娜",
                    "text": "薄荷酱烤鱼的味道…薄荷酱…"
                }
            ]
        },
        {
            "talkId": "6603402",
            "initDialog": "660340201",
            "dialogues": [
                {
                    "id": "660340201",
                    "speaker": "Player",
                    "text": "我也喜欢烤鱼。"
                },
                {
                    "id": "660340202",
                    "speaker": "莎娜",
                    "text": "哦吼…撕开焦脆的鱼皮，里面闪亮的鱼肉就像新造好的比赛设备…"
                },
                {
                    "id": "660340203",
                    "speaker": "莎娜",
                    "text": "而我这个工程师，就是第一个体验它们的人！"
                },
                {
                    "id": "660340204",
                    "speaker": "莎娜",
                    "text": "…当然，试用设备是为了安全检测，和烤鱼是不一样的。"
                }
            ]
        },
        {
            "talkId": "6603403",
            "initDialog": "660340301",
            "dialogues": [
                {
                    "id": "660340301",
                    "speaker": "Player",
                    "text": "我也喜欢薄荷。"
                },
                {
                    "id": "660340302",
                    "speaker": "莎娜",
                    "text": "哦吼…清新的回味，和冰凉的口感，就像把手放在了刚擦拭干净的机械上…"
                },
                {
                    "id": "660340303",
                    "speaker": "莎娜",
                    "text": "钢铁的味道，也和薄荷的青涩如出一辙！"
                },
                {
                    "id": "660340304",
                    "speaker": "莎娜",
                    "text": "…当然，薄荷可以吃，但冰凉的铁块我不推荐大家去舔。"
                }
            ]
        },
        {
            "talkId": "6603404",
            "initDialog": "660340401",
            "dialogues": [
                {
                    "id": "660340401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660340402",
                    "speaker": "莎娜",
                    "text": "再见…有机会一起吃烤鱼！"
                }
            ]
        },
        {
            "talkId": "7591801",
            "initDialog": "759180101",
            "dialogues": [
                {
                    "id": "759180101",
                    "speaker": "Player",
                    "text": "烤鱼也要讲究安全吧？"
                },
                {
                    "id": "759180102",
                    "speaker": "莎娜",
                    "text": "真是给我问住了。"
                },
                {
                    "id": "759180103",
                    "speaker": "莎娜",
                    "text": "的确，用火、用料都要注意，要是吃到有毒的鱼就糟糕了！就像用到了有裂痕的零件！"
                }
            ]
        },
        {
            "talkId": "7591901",
            "initDialog": "759190101",
            "dialogues": [
                {
                    "id": "759190101",
                    "speaker": "Player",
                    "text": "谢谢提醒。"
                },
                {
                    "id": "759190102",
                    "speaker": "莎娜",
                    "text": "嗯。当然，你在纳塔是不太容易见到冰凉的金属的。"
                },
                {
                    "id": "759190103",
                    "speaker": "莎娜",
                    "text": "或者简单点，大家直接用加工好的材料吧。"
                }
            ]
        }
    ]
}