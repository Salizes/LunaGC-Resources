        {
            "talkId": "420120",
            "initDialog": "42012001",
            "dialogues": [
                {
                    "id": "42012001",
                    "speaker": "观察木板",
                    "text": "（这好像是往生堂的木板，上面挂着很多空白的木牌…唔，要怎么用呢？）"
                },
                {
                    "id": "42012002",
                    "speaker": "观察木板",
                    "text": "（算了，感觉我也不需要知道。）"
                }
            ]
        },
        {
            "talkId": "420121",
            "initDialog": "42012101",
            "dialogues": [
                {
                    "id": "42012101",
                    "speaker": "观察木板",
                    "text": "（往生堂用来接取委托的木板，委托人会取下木牌，写上内容，再塞进往生堂的门缝里。）"
                },
                {
                    "id": "42012102",
                    "speaker": "观察木板",
                    "text": "（木牌背后还写上了很有胡桃风格的广告词，「凭此木牌，购一送一」。）"
                }
            ]
        }
    ]
}