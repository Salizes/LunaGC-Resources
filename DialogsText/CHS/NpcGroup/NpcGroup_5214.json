{
    "groupId": "5214",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "嘉维娅": 10
    },
    "talks": [
        {
            "talkId": "6521401",
            "initDialog": "652140101",
            "dialogues": [
                {
                    "id": "652140101",
                    "speaker": "嘉维娅",
                    "text": "姐姐下一次休息是…抱歉，我走神了。有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6521402",
            "initDialog": "652140201",
            "dialogues": [
                {
                    "id": "652140201",
                    "speaker": "Player",
                    "text": "关于管道…"
                },
                {
                    "id": "652140202",
                    "speaker": "嘉维娅",
                    "text": "我不懂这些复杂的事情…但是管道的通路好长，把我和姐姐隔开得好远。要是没有这些管道就好了。"
                }
            ]
        },
        {
            "talkId": "6521403",
            "initDialog": "652140301",
            "dialogues": [
                {
                    "id": "652140301",
                    "speaker": "Player",
                    "text": "关于扩音机…"
                },
                {
                    "id": "652140302",
                    "speaker": "嘉维娅",
                    "text": "的确帮我们节省了一些饮用水…但是用它来恶作剧的人越来越多了，其中甚至包括部分看守。得想想办法整治一下…"
                }
            ]
        },
        {
            "talkId": "6521404",
            "initDialog": "652140401",
            "dialogues": [
                {
                    "id": "652140401",
                    "speaker": "Player",
                    "text": "和你长得一样的人…"
                },
                {
                    "id": "652140402",
                    "speaker": "嘉维娅",
                    "text": "你该不会惹了什么麻烦让姐姐给你善后吧？如果因为你惹出的麻烦害姐姐加班…那我就只好陪她一起了。"
                }
            ]
        },
        {
            "talkId": "6521405",
            "initDialog": "652140501",
            "dialogues": [
                {
                    "id": "652140501",
                    "speaker": "Player",
                    "text": "没事。"
                },
                {
                    "id": "652140502",
                    "speaker": "嘉维娅",
                    "text": "嗯，没事就是好事。"
                }
            ]
        },
        {
            "talkId": "6521406",
            "initDialog": "652140601",
            "dialogues": [
                {
                    "id": "652140601",
                    "speaker": "嘉维娅",
                    "text": "是你呀，怎么啦？"
                }
            ]
        },
        {
            "talkId": "6521407",
            "initDialog": "652140701",
            "dialogues": [
                {
                    "id": "652140701",
                    "speaker": "Player",
                    "text": "关于看守的工作…"
                },
                {
                    "id": "652140702",
                    "speaker": "嘉维娅",
                    "text": "其实大部分时间都是在处理一些无关紧要的小事呢。不过没有大事说明一切顺利，对吧？"
                }
            ]
        },
        {
            "talkId": "6521408",
            "initDialog": "652140801",
            "dialogues": [
                {
                    "id": "652140801",
                    "speaker": "Player",
                    "text": "关于嘉维娜…"
                },
                {
                    "id": "652140802",
                    "speaker": "嘉维娅",
                    "text": "总觉得姐姐和我最近有些疏远…为什么呢？我们原本不是一直十分亲密吗？总不会是有人从中作梗吧…"
                }
            ]
        },
        {
            "talkId": "6521409",
            "initDialog": "652140901",
            "dialogues": [
                {
                    "id": "652140901",
                    "speaker": "Player",
                    "text": "关于克兰茨…"
                },
                {
                    "id": "652140902",
                    "speaker": "嘉维娅",
                    "text": "他就是人们常说的那种怪人吧。明明可以离开这里在外面谋个职业，却说什么也不愿意走。"
                },
                {
                    "id": "652140903",
                    "speaker": "嘉维娅",
                    "text": "他能帮我们修理一些东西是很好，可是我总觉得他是不是偷偷动了坏心思，在我们不知道的时候给我们增加了工作量…"
                }
            ]
        }
    ]
}