{
    "groupId": "2208",
    "total_dialogue_lines": 38,
    "speaker_counts": {
        "Player": 11,
        "菲尔戈黛特": 27
    },
    "talks": [
        {
            "talkId": "4111536",
            "initDialog": "411153601",
            "dialogues": [
                {
                    "id": "411153601",
                    "speaker": "菲尔戈黛特",
                    "text": "您好啊。那些会令人昏睡的陨石的事，你们也听说了吧？"
                },
                {
                    "id": "411153602",
                    "speaker": "菲尔戈黛特",
                    "text": "现在店里分出了很多客房，用来收留那些不幸的昏睡者。所以空房的数量有些紧张，要订房间还请从速哦。"
                }
            ]
        },
        {
            "talkId": "6220808",
            "initDialog": "622080801",
            "dialogues": [
                {
                    "id": "622080801",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6220809",
            "initDialog": "622080901",
            "dialogues": [
                {
                    "id": "622080901",
                    "speaker": "菲尔戈黛特",
                    "text": "不愧是您呢，之前就听说您牌技精湛，今日终于是领教了一番。"
                }
            ]
        },
        {
            "talkId": "6220810",
            "initDialog": "622081001",
            "dialogues": [
                {
                    "id": "622081001",
                    "speaker": "菲尔戈黛特",
                    "text": "哎呀，一不小心就赢了…"
                }
            ]
        },
        {
            "talkId": "6220811",
            "initDialog": "622081101",
            "dialogues": [
                {
                    "id": "622081101",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6220812",
            "initDialog": "622081201",
            "dialogues": [
                {
                    "id": "622081201",
                    "speaker": "菲尔戈黛特",
                    "text": "呵呵，可别小瞧客栈老板啊~我可是经常和客人们玩牌的。"
                }
            ]
        },
        {
            "talkId": "6220813",
            "initDialog": "622081301",
            "dialogues": [
                {
                    "id": "622081301",
                    "speaker": "菲尔戈黛特",
                    "text": "还好你没有提出「打赢就免单」的要求，不然，我的面子可就挂不住了…"
                }
            ]
        },
        {
            "talkId": "6220801",
            "initDialog": "622080101",
            "dialogues": [
                {
                    "id": "622080101",
                    "speaker": "菲尔戈黛特",
                    "text": "您好啊。打扮、面庞…还有奇怪的伙伴小精灵。猜不出来了呢…"
                }
            ]
        },
        {
            "talkId": "6220802",
            "initDialog": "622080201",
            "dialogues": [
                {
                    "id": "622080201",
                    "speaker": "Player",
                    "text": "请问你是？"
                },
                {
                    "id": "622080202",
                    "speaker": "菲尔戈黛特",
                    "text": "我叫戈黛特，来自蒙德。是望舒客栈的老板。"
                },
                {
                    "id": "622080203",
                    "speaker": "菲尔戈黛特",
                    "text": "不是老板娘。"
                },
                {
                    "id": "622080204",
                    "speaker": "菲尔戈黛特",
                    "text": "是、老、板。",
                    "choices": [
                        {
                            "id": "622080205",
                            "text": "有些传闻…",
                            "response": [
                                {
                                    "id": "622080206",
                                    "speaker": "菲尔戈黛特",
                                    "text": "哈哈哈，能在这里开店，怎么可能和七星没有关系呢。"
                                },
                                {
                                    "id": "622080207",
                                    "speaker": "菲尔戈黛特",
                                    "text": "我意思是，肯定需要他们同意嘛。"
                                },
                                {
                                    "id": "622080208",
                                    "speaker": "菲尔戈黛特",
                                    "text": "其他一些有的没的，那当然都是谣言啦。"
                                },
                                {
                                    "id": "622080209",
                                    "speaker": "菲尔戈黛特",
                                    "text": "这么说来，您听到过什么有意思的事情吗？"
                                }
                            ]
                        },
                        {
                            "id": "622080210",
                            "text": "关于这猫…",
                            "response": [
                                {
                                    "id": "622080211",
                                    "speaker": "菲尔戈黛特",
                                    "text": "唉…这猫是自己跟来的，不过看着挺可爱的就留下了。"
                                },
                                {
                                    "id": "622080212",
                                    "speaker": "菲尔戈黛特",
                                    "text": "名字吗，叫阿伟，随便起的。"
                                },
                                {
                                    "id": "622080213",
                                    "speaker": "菲尔戈黛特",
                                    "text": "它可能会捣蛋一下，猫嘛，是这样的。您可千万别和它一般见识。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220803",
            "initDialog": "622080301",
            "dialogues": [
                {
                    "id": "622080301",
                    "speaker": "Player",
                    "text": "关于你丈夫？"
                },
                {
                    "id": "622080302",
                    "speaker": "菲尔戈黛特",
                    "text": "他就在那边，是客栈的掌柜。"
                },
                {
                    "id": "622080303",
                    "speaker": "菲尔戈黛特",
                    "text": "别看他笑嘻嘻的，其实拳脚功夫很厉害的。"
                },
                {
                    "id": "622080304",
                    "speaker": "菲尔戈黛特",
                    "text": "我也是，我们的厨子也是，都是这么招进来的。"
                },
                {
                    "id": "622080305",
                    "speaker": "菲尔戈黛特",
                    "text": "不会功夫还怎么招待好客人呢，你说是不是这个道理。"
                }
            ]
        },
        {
            "talkId": "6220804",
            "initDialog": "622080401",
            "dialogues": [
                {
                    "id": "622080401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622080402",
                    "speaker": "菲尔戈黛特",
                    "text": "祝您旅途平安。"
                }
            ]
        },
        {
            "talkId": "6220805",
            "initDialog": "622080501",
            "dialogues": [
                {
                    "id": "622080501",
                    "speaker": "菲尔戈黛特",
                    "text": "您好啊，您也算回头客了吧，欢迎欢迎。"
                }
            ]
        },
        {
            "talkId": "6220806",
            "initDialog": "622080601",
            "dialogues": [
                {
                    "id": "622080601",
                    "speaker": "Player",
                    "text": "你好老板娘。"
                },
                {
                    "id": "622080602",
                    "speaker": "菲尔戈黛特",
                    "text": "唉…说了多少次了，不是老板娘。"
                },
                {
                    "id": "622080603",
                    "speaker": "菲尔戈黛特",
                    "text": "我是这家望舒客栈的老板哦。"
                },
                {
                    "id": "622080604",
                    "speaker": "菲尔戈黛特",
                    "text": "是、老、板。",
                    "choices": [
                        {
                            "id": "622080205",
                            "text": "有些传闻…"
                        },
                        {
                            "id": "622080210",
                            "text": "关于这猫…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6220807",
            "initDialog": "622080701",
            "dialogues": [
                {
                    "id": "622080701",
                    "speaker": "Player",
                    "text": "我想买些吃的。"
                },
                {
                    "id": "622080702",
                    "speaker": "菲尔戈黛特",
                    "text": "请点单吧，蒙德和璃月的料理都有哦，另外「杏仁豆腐」可是我们的招牌菜。"
                }
            ]
        }
    ]
}