{
    "groupId": "7461",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "塞雷达": 11
    },
    "talks": [
        {
            "talkId": "6746101",
            "initDialog": "674610101",
            "dialogues": [
                {
                    "id": "674610101",
                    "speaker": "塞雷达",
                    "text": "今天又找到了便宜可口的食材，给小伙子们多做两道好菜！"
                }
            ]
        },
        {
            "talkId": "6746102",
            "initDialog": "674610201",
            "dialogues": [
                {
                    "id": "674610201",
                    "speaker": "Player",
                    "text": "都有什么吃的？"
                },
                {
                    "id": "674610202",
                    "speaker": "塞雷达",
                    "text": "不瞒你说，受了潮的黑麦，冻成石头的土豆，价格只有平常的五分之一。"
                },
                {
                    "id": "674610203",
                    "speaker": "塞雷达",
                    "text": "对于餐费有限的部队来说，「填饱肚子」和「吃了不会中毒」最重要。"
                },
                {
                    "id": "674610204",
                    "speaker": "塞雷达",
                    "text": "但，战斗厨师的职责，就是用最便宜普通的材料，做出让战士们满意的菜肴。"
                },
                {
                    "id": "674610205",
                    "speaker": "塞雷达",
                    "text": "所以，我采购的主粮品质没那么好，突出一个量大优先。"
                },
                {
                    "id": "674610206",
                    "speaker": "塞雷达",
                    "text": "余下的经费都用来买调节口味的食材，比如格外入味的腌肉和醋栗。"
                },
                {
                    "id": "674610207",
                    "speaker": "塞雷达",
                    "text": "最近，我要试着制作新的腌肉面包，最好省事又美味，方便长期驻守在一线的士兵们食用…"
                }
            ]
        },
        {
            "talkId": "6746103",
            "initDialog": "674610301",
            "dialogues": [
                {
                    "id": "674610301",
                    "speaker": "Player",
                    "text": "给我也来两份？"
                },
                {
                    "id": "674610302",
                    "speaker": "塞雷达",
                    "text": "如果我还在以前的小餐馆工作，肯定要为你做几道拿手好菜。"
                },
                {
                    "id": "674610303",
                    "speaker": "塞雷达",
                    "text": "不过，我现在要先管好军队里那些小伙子们的饭。"
                },
                {
                    "id": "674610304",
                    "speaker": "塞雷达",
                    "text": "等我退役了，还请再光顾我那家小餐馆啊！"
                }
            ]
        },
        {
            "talkId": "6746104",
            "initDialog": "674610401",
            "dialogues": [
                {
                    "id": "674610401",
                    "speaker": "Player",
                    "text": "恭喜你！"
                },
                {
                    "id": "674610402",
                    "speaker": "塞雷达",
                    "text": "谢谢，希望你也能找到满意的食材，吃到最可口的饭菜！"
                }
            ]
        }
    ]
}