{
    "groupId": "1429",
    "total_dialogue_lines": 48,
    "speaker_counts": {
        "Player": 14,
        "葛瑞丝": 34
    },
    "talks": [
        {
            "talkId": "2074101",
            "initDialog": "207410101",
            "dialogues": [
                {
                    "id": "207410101",
                    "speaker": "葛瑞丝",
                    "text": "感谢风神大人…"
                },
                {
                    "id": "207410102",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "207410103",
                    "speaker": "葛瑞丝",
                    "text": "我正在向巴巴托斯大人祈祷呢，多亏了他的护佑，蒙德城才得以度过灾难。"
                },
                {
                    "id": "207410104",
                    "speaker": "葛瑞丝",
                    "text": "还有西风骑士团和冒险家协会的各位，感谢风神，他们都平安无事。"
                },
                {
                    "id": "207410105",
                    "speaker": "葛瑞丝",
                    "text": "感谢您，巴巴托斯大人…",
                    "choices": [
                        {
                            "id": "207410106",
                            "text": "感谢您，巴巴托斯大人…",
                            "response": [
                                {
                                    "id": "207410108",
                                    "speaker": "葛瑞丝",
                                    "text": "我不敢自己揣测巴巴托斯大人具体为我们做了什么。"
                                },
                                {
                                    "id": "207410109",
                                    "speaker": "葛瑞丝",
                                    "text": "但是，仅仅是意识到有这样一位勤恳的神明在护佑着蒙德城，也足够让人安心了。"
                                },
                                {
                                    "id": "207410110",
                                    "speaker": "葛瑞丝",
                                    "text": "对了，如果您有空的话，能帮我一个忙吗？"
                                },
                                {
                                    "id": "207410111",
                                    "speaker": "葛瑞丝",
                                    "text": "我想请您帮我去搜集一份蒲公英籽，然后到风神像上将它们播撒到远方…"
                                }
                            ]
                        },
                        {
                            "id": "207410107",
                            "text": "…那还真是辛苦他了。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "2074102",
            "initDialog": "207410201",
            "dialogues": [
                {
                    "id": "207410201",
                    "speaker": "Player",
                    "text": "好像之前听说过…"
                },
                {
                    "id": "207410202",
                    "speaker": "葛瑞丝",
                    "text": "您看，之前您不是也帮葛罗丽这样播撒过蒲公英籽吗？难道您已经忘记了？"
                }
            ]
        },
        {
            "talkId": "2074103",
            "initDialog": "207410301",
            "dialogues": [
                {
                    "id": "207410301",
                    "speaker": "Player",
                    "text": "为什么要这么做？"
                }
            ]
        },
        {
            "talkId": "2074104",
            "initDialog": "207410401",
            "dialogues": [
                {
                    "id": "207410401",
                    "speaker": "葛瑞丝",
                    "text": "随风而去的蒲公英籽，能够传递人们心中的心意，无论是思念，还是感激。"
                },
                {
                    "id": "207410402",
                    "speaker": "葛瑞丝",
                    "text": "巴巴托斯大人是风之神，用能随风而动的蒲公英籽来向他表达感激再适合不过了。"
                }
            ]
        },
        {
            "talkId": "2074105",
            "initDialog": "207410501",
            "dialogues": [
                {
                    "id": "207410501",
                    "speaker": "Player",
                    "text": "交给我吧。"
                },
                {
                    "id": "207410502",
                    "speaker": "葛瑞丝",
                    "text": "那就拜托您了。"
                }
            ]
        },
        {
            "talkId": "2074106",
            "initDialog": "207410601",
            "dialogues": [
                {
                    "id": "207410601",
                    "speaker": "Player",
                    "text": "只要蒲公英就够了吗？"
                },
                {
                    "id": "207410602",
                    "speaker": "葛瑞丝",
                    "text": "有蒲公英就足够了。而且…蒙德的其他花卉，也很难「播撒」到远方呢。"
                },
                {
                    "id": "207410603",
                    "speaker": "葛瑞丝",
                    "text": "所以，请您帮我去采一份蒲公英吧，我就在这等着您。"
                }
            ]
        },
        {
            "talkId": "7090701",
            "initDialog": "709070101",
            "dialogues": [
                {
                    "id": "709070101",
                    "speaker": "Player",
                    "text": "关于不安的气息…"
                },
                {
                    "id": "709070102",
                    "speaker": "葛瑞丝",
                    "text": "无论是因为什么原因，我们能做的也就只有祈祷了。"
                },
                {
                    "id": "709070103",
                    "speaker": "葛瑞丝",
                    "text": "我最近托冒险家帮忙采集了一些塞西莉亚花，想要分发给大家…"
                },
                {
                    "id": "709070104",
                    "speaker": "葛瑞丝",
                    "text": "这种花生长在山崖之上，长期与蒙德的风为伴…"
                },
                {
                    "id": "709070105",
                    "speaker": "葛瑞丝",
                    "text": "…这散发着巴巴托斯大人气息的花朵，或许能为大家带来些许安心…"
                },
                {
                    "id": "709070106",
                    "speaker": "葛瑞丝",
                    "text": "你也拿一些吧，愿巴巴托斯大人护佑蒙德。"
                }
            ]
        },
        {
            "talkId": "40168",
            "initDialog": "4015142901",
            "dialogues": [
                {
                    "id": "4015142901",
                    "speaker": "葛瑞丝",
                    "text": "您好，想要向巴巴托斯大人祈祷的话，在这里就可以了。"
                }
            ]
        },
        {
            "talkId": "41719",
            "initDialog": "4015142903",
            "dialogues": [
                {
                    "id": "4015142903",
                    "speaker": "Player",
                    "text": "关于巴巴托斯。"
                },
                {
                    "id": "4015142908",
                    "speaker": "葛瑞丝",
                    "text": "巴巴托斯大人是一位很温柔的神。"
                },
                {
                    "id": "4015142909",
                    "speaker": "葛瑞丝",
                    "text": "神明的风既能把快乐传播到全城，也能为伤心的人悄悄擦去泪水。"
                }
            ]
        },
        {
            "talkId": "41720",
            "initDialog": "4015142904",
            "dialogues": [
                {
                    "id": "4015142904",
                    "speaker": "Player",
                    "text": "关于向巴巴托斯祈祷。"
                },
                {
                    "id": "4015142910",
                    "speaker": "葛瑞丝",
                    "text": "想要向巴巴托斯大人祈祷的话，只要在起风的时候悄悄说出愿望…"
                },
                {
                    "id": "4015142911",
                    "speaker": "葛瑞丝",
                    "text": "风就会把你的愿望带给巴巴托斯大人了。"
                }
            ]
        },
        {
            "talkId": "6142901",
            "initDialog": "4015142902",
            "dialogues": [
                {
                    "id": "4015142902",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "4015142906",
                    "speaker": "葛瑞丝",
                    "text": "最近蒙德城的风里带上了不安的气息，所以我在向巴巴托斯大人祈祷。"
                },
                {
                    "id": "4015142907",
                    "speaker": "葛瑞丝",
                    "text": "请放心吧，巴巴托斯大人一定会帮助大家的。"
                }
            ]
        },
        {
            "talkId": "6142902",
            "initDialog": "4015142905",
            "dialogues": [
                {
                    "id": "4015142905",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "4015142912",
                    "speaker": "葛瑞丝",
                    "text": "再见，愿巴巴托斯大人温柔的风与您同在。"
                }
            ]
        },
        {
            "talkId": "6142903",
            "initDialog": "614290301",
            "dialogues": [
                {
                    "id": "614290301",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614290302",
                    "speaker": "葛瑞丝",
                    "text": "恐怕这就是大家内心不安的其中一个根源吧…"
                },
                {
                    "id": "614290303",
                    "speaker": "葛瑞丝",
                    "text": "我不是西风骑士团的骑士，所以能做的就只有对风祈祷。"
                },
                {
                    "id": "614290304",
                    "speaker": "葛瑞丝",
                    "text": "愿巴巴托斯大人护佑蒙德的子民…"
                }
            ]
        },
        {
            "talkId": "6142904",
            "initDialog": "614290401",
            "dialogues": [
                {
                    "id": "614290401",
                    "speaker": "Player",
                    "text": "关于龙灾…"
                },
                {
                    "id": "614290402",
                    "speaker": "葛瑞丝",
                    "text": "巴巴托斯大人果然听到了我们的祈祷，蒙德城也平安无事了。"
                },
                {
                    "id": "614290403",
                    "speaker": "葛瑞丝",
                    "text": "虽说结束了，不过特瓦林造成的影响还会持续一段时间吧…"
                },
                {
                    "id": "614290404",
                    "speaker": "葛瑞丝",
                    "text": "不过我相信只要蒙德的风不停息，巴巴托斯大人就永远与我们在一起。"
                },
                {
                    "id": "614290405",
                    "speaker": "葛瑞丝",
                    "text": "…也许，巴巴托斯大人已经在我们身边了也说不定。"
                }
            ]
        }
    ]
}