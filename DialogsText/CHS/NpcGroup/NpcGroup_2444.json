{
    "groupId": "2444",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "马克西姆": 7
    },
    "talks": [
        {
            "talkId": "6244401",
            "initDialog": "624440101",
            "dialogues": [
                {
                    "id": "624440101",
                    "speaker": "马克西姆",
                    "text": "这「珠钿舫」真是名不虚传，男的英俊帅气，女的闭月羞花…"
                },
                {
                    "id": "624440102",
                    "speaker": "马克西姆",
                    "text": "哪怕只是看看，也算是不虚此行了啊！"
                }
            ]
        },
        {
            "talkId": "6244402",
            "initDialog": "624440201",
            "dialogues": [
                {
                    "id": "624440201",
                    "speaker": "Player",
                    "text": "这里是什么地方？"
                },
                {
                    "id": "624440202",
                    "speaker": "马克西姆",
                    "text": "嘿嘿，这可是整个璃月最值得一来的地方。"
                },
                {
                    "id": "624440203",
                    "speaker": "马克西姆",
                    "text": "…按我们至冬国的气候和环境，可造不出这种饭店呐，啧啧。"
                },
                {
                    "id": "624440204",
                    "speaker": "马克西姆",
                    "text": "咳咳，虽然我来璃月的初衷是做生意赚钱，但现在我已经彻底没心思经商了…"
                },
                {
                    "id": "624440205",
                    "speaker": "马克西姆",
                    "text": "…哪怕是凝光大人请我到群玉阁谈生意我都不想去。"
                }
            ]
        },
        {
            "talkId": "6244403",
            "initDialog": "624440301",
            "dialogues": [
                {
                    "id": "624440301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624440302",
                    "speaker": "马克西姆",
                    "text": "别害羞啊，有空一起吃一杯，我认识个乐师弹琴可是一绝…"
                }
            ]
        }
    ]
}