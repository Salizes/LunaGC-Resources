{
    "groupId": "6250",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "庇兰": 13
    },
    "talks": [
        {
            "talkId": "6625001",
            "initDialog": "662500101",
            "dialogues": [
                {
                    "id": "662500101",
                    "speaker": "庇兰",
                    "text": "谕示所指，皆有其兆，但并非所有问题都能马上得到答案…你好。"
                }
            ]
        },
        {
            "talkId": "6625002",
            "initDialog": "662500201",
            "dialogues": [
                {
                    "id": "662500201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "662500202",
                    "speaker": "庇兰",
                    "text": "欢迎来到「烟谜主」之域，我是部族首领庇兰。"
                },
                {
                    "id": "662500203",
                    "speaker": "庇兰",
                    "text": "前来此地拜访的人大多怀揣待解答的问题，但我倾向于让他们在提问前再深思熟虑一些。"
                },
                {
                    "id": "662500204",
                    "speaker": "庇兰",
                    "text": "探求秘密和揭示预言，都会引发某种结果，而这些结果又何尝不是预言所示的内容呢。"
                },
                {
                    "id": "662500205",
                    "speaker": "庇兰",
                    "text": "容易知晓秘密的人天生就有额外的责任在身。"
                },
                {
                    "id": "662500206",
                    "speaker": "庇兰",
                    "text": "直言不讳地讲，守口如瓶的人更容易健康长寿，这也是世间规则之一。"
                }
            ]
        },
        {
            "talkId": "6625003",
            "initDialog": "662500301",
            "dialogues": [
                {
                    "id": "662500301",
                    "speaker": "Player",
                    "text": "又见面了。"
                },
                {
                    "id": "662500302",
                    "speaker": "庇兰",
                    "text": "是你啊，能够辨别「色彩」的人。"
                },
                {
                    "id": "662500303",
                    "speaker": "庇兰",
                    "text": "彩虹有七种颜色，但仍旧不够编织织卷所用。"
                },
                {
                    "id": "662500304",
                    "speaker": "庇兰",
                    "text": "你的故事，应该会为历史染上更多色彩吧。"
                }
            ]
        },
        {
            "talkId": "6625004",
            "initDialog": "662500401",
            "dialogues": [
                {
                    "id": "662500401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "662500402",
                    "speaker": "庇兰",
                    "text": "再见，望你心无疑虑。"
                }
            ]
        },
        {
            "talkId": "7594101",
            "initDialog": "759410101",
            "dialogues": [
                {
                    "id": "759410101",
                    "speaker": "Player",
                    "text": "就像这里的火焰一样？"
                },
                {
                    "id": "759410102",
                    "speaker": "庇兰",
                    "text": "就像这里的火焰一样。"
                },
                {
                    "id": "759410103",
                    "speaker": "庇兰",
                    "text": "不是为了毁灭而焚尽，而是为了光芒而灼烧。"
                },
                {
                    "id": "759410104",
                    "speaker": "庇兰",
                    "text": "看看火苗舞蹈的样子吧，或许会带来新的启示呢。"
                }
            ]
        }
    ]
}