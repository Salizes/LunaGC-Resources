{
    "groupId": "31024",
    "total_dialogue_lines": 27,
    "speaker_counts": {
        "Player": 6,
        "「缟玛瑙」": 21
    },
    "talks": [
        {
            "talkId": "7651110",
            "initDialog": "765111001",
            "dialogues": [
                {
                    "id": "765111001",
                    "speaker": "「缟玛瑙」",
                    "text": "#你好，{NICKNAME}。听说之后要由你来考验我，希望我们双方都能享受这场战斗。",
                    "choices": [
                        {
                            "id": "765111002",
                            "text": "…好有礼貌？",
                            "response": [
                                {
                                    "id": "765111003",
                                    "speaker": "「缟玛瑙」",
                                    "text": "「礼貌是文明人的空气，它存在时我们习以为常，它缺位时，我们很快就会察觉到不妙…」"
                                },
                                {
                                    "id": "765111004",
                                    "speaker": "「缟玛瑙」",
                                    "text": "我刚入役时，瓦列里长官就如此教导过我…原话不这样，意思差不多。"
                                },
                                {
                                    "id": "765111005",
                                    "speaker": "「缟玛瑙」",
                                    "text": "瓦列里长官是我最尊敬的人之一，在本土的兵营里，我绝不说粗鄙之语。"
                                },
                                {
                                    "id": "765111006",
                                    "speaker": "「缟玛瑙」",
                                    "text": "被指派到「木偶」大人麾下后，哪怕不幸和「霜月之子」起了摩擦，被他们扔鸟蛋在脸上…"
                                },
                                {
                                    "id": "765111007",
                                    "speaker": "「缟玛瑙」",
                                    "text": "我也不会骂人或动手，而是尽量想办法把道理讲清楚。",
                                    "choices": [
                                        {
                                            "id": "765111008",
                                            "text": "那你脾气还蛮好的。",
                                            "response": [
                                                {
                                                    "id": "765111010",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "嗯…最近几年唯一骂人的一次，是得知「木偶」大人遭遇不测。"
                                                },
                                                {
                                                    "id": "765111011",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "虽说没有直接接到过「木偶」大人的命令，但她的「博西柯」系列巡陆艇无比可靠，坚固耐用。"
                                                },
                                                {
                                                    "id": "765111012",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "成为「博西柯」这种坚定不移的战争机器，是我毕生的追求。"
                                                },
                                                {
                                                    "id": "765111013",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "「狂猎」大军和那个不可理喻的怪物打进试验设计局时，我的刀都砍得卷刃了，还是拦不下它们。"
                                                },
                                                {
                                                    "id": "765111014",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "要不是有一台「博西柯」巡陆艇帮我突围，我就死在码头上了。"
                                                },
                                                {
                                                    "id": "765111015",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "啊，虽然之后也差点死在另一位执行官大人降下的界域中…那就是别的话题了。"
                                                },
                                                {
                                                    "id": "765111016",
                                                    "speaker": "「缟玛瑙」",
                                                    "text": "在病床上得知了那个消息后…我感到非常震惊和恐慌。",
                                                    "choices": [
                                                        {
                                                            "id": "765111017",
                                                            "text": "事情已经告一段落了…",
                                                            "response": [
                                                                {
                                                                    "id": "765111019",
                                                                    "speaker": "「缟玛瑙」",
                                                                    "text": "嗯…谨以我个人的立场，向你致以最高的敬意。"
                                                                },
                                                                {
                                                                    "id": "765111020",
                                                                    "speaker": "「缟玛瑙」",
                                                                    "text": "现在，我的编制已经移回瓦列里少校麾下，再过不久，或许就会返回至冬本土。"
                                                                },
                                                                {
                                                                    "id": "765111021",
                                                                    "speaker": "「缟玛瑙」",
                                                                    "text": "能在离开挪德卡莱前得到你的指导，我的挪德卡莱部署之旅也算是充满了荣光。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "765111018",
                                                            "text": "我和伙伴们把元凶打败了…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "765111009",
                                            "text": "你这样的愚人众不多见。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "765111022",
                            "text": "那我待会儿可不会留手。",
                            "response": [
                                {
                                    "id": "765111023",
                                    "speaker": "「缟玛瑙」",
                                    "text": "把我打得满地乱爬都没事，正合我意。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7651111",
            "initDialog": "765111101",
            "dialogues": [
                {
                    "id": "765111101",
                    "speaker": "「缟玛瑙」",
                    "text": "#打得非常尽兴，{NICKNAME}。你给了我许多启发…"
                },
                {
                    "id": "765111102",
                    "speaker": "「缟玛瑙」",
                    "text": "运用巧劲和把握时机的重要性，完全不输纯粹的力量。"
                }
            ]
        },
        {
            "talkId": "7651204",
            "initDialog": "765120401",
            "dialogues": [
                {
                    "id": "765120401",
                    "speaker": "「缟玛瑙」",
                    "text": "#这下，我可以和战友们说，我跟{NICKNAME}痛痛快快打了一场，让他们羡慕到抱头嚎叫…"
                },
                {
                    "id": "765120402",
                    "speaker": "「缟玛瑙」",
                    "text": "假设以后有幸在至冬再见，还想和你切磋一番。"
                }
            ]
        }
    ]
}