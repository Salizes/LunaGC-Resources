{
    "groupId": "30249",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "莱妮": 9
    },
    "talks": [
        {
            "talkId": "7368202",
            "initDialog": "736820201",
            "dialogues": [
                {
                    "id": "736820201",
                    "speaker": "莱妮",
                    "text": "需要我做点什么吗？抗击风魔龙的空战豪杰，不倦执勤的委托粉碎机，隐秘宝箱的寻踪人和未知迷雾的破除者…",
                    "choices": [
                        {
                            "id": "736820202",
                            "text": "不必每次都用这么多称号…",
                            "response": [
                                {
                                    "id": "736820203",
                                    "speaker": "莱妮",
                                    "text": "那可不行，作为成就远不如您的冒险家，我必须时时刻刻对您拿出最高的敬意。"
                                },
                                {
                                    "id": "736820204",
                                    "speaker": "莱妮",
                                    "text": "协会里肯定不止我一个人这么想，您就心安理得地收下我们的尊重吧！"
                                }
                            ]
                        },
                        {
                            "id": "736820205",
                            "text": "感觉你好有热情啊。",
                            "response": [
                                {
                                    "id": "736820206",
                                    "speaker": "莱妮",
                                    "text": "哈哈哈！那是当然！因为我很享受这份工作！"
                                },
                                {
                                    "id": "736820207",
                                    "speaker": "莱妮",
                                    "text": "在我看来，冒险家应该不断尝试更困难的挑战，持续向着更强的境界前进。"
                                },
                                {
                                    "id": "736820208",
                                    "speaker": "莱妮",
                                    "text": "无论是我自己得到提升，还是帮助别人变强，我都觉得很开心！"
                                }
                            ]
                        },
                        {
                            "id": "736820209",
                            "text": "你自己不试试挑战吗？",
                            "response": [
                                {
                                    "id": "736820210",
                                    "speaker": "莱妮",
                                    "text": "啊哈！不瞒您说，我在踩点的时候就打了个痛快！"
                                },
                                {
                                    "id": "736820211",
                                    "speaker": "莱妮",
                                    "text": "可惜附近的魔物不是无穷无尽的，我这个办活动的不能只顾着取悦自己。"
                                },
                                {
                                    "id": "736820212",
                                    "speaker": "莱妮",
                                    "text": "您也要手下留情，留一些目标给新人们练手啊。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}