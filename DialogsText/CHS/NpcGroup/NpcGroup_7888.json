{
    "groupId": "7888",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "弗约尔斯卡娅": 13
    },
    "talks": [
        {
            "talkId": "6788801",
            "initDialog": "678880101",
            "dialogues": [
                {
                    "id": "678880101",
                    "speaker": "弗约尔斯卡娅",
                    "text": "要是没人来车站，就是小镇好时节。"
                }
            ]
        },
        {
            "talkId": "6788802",
            "initDialog": "678880201",
            "dialogues": [
                {
                    "id": "678880201",
                    "speaker": "Player",
                    "text": "好时节？"
                },
                {
                    "id": "678880202",
                    "speaker": "弗约尔斯卡娅",
                    "text": "是啊，好时节。没人来车站，就没有无穷无尽的工作。"
                },
                {
                    "id": "678880203",
                    "speaker": "弗约尔斯卡娅",
                    "text": "每天拿一样的工钱，未来的道路一眼就能望到头。而工作嘛，做得多了，没人欣赏；做得少了，没人在乎。"
                },
                {
                    "id": "678880204",
                    "speaker": "弗约尔斯卡娅",
                    "text": "既然如此，人少当然比人多好了——来到车站的旅客越少，活计就越少；活越少，我的责任就越小。您说对吧？"
                }
            ]
        },
        {
            "talkId": "6788803",
            "initDialog": "678880301",
            "dialogues": [
                {
                    "id": "678880301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "678880302",
                    "speaker": "弗约尔斯卡娅",
                    "text": "再见！"
                }
            ]
        },
        {
            "talkId": "6788804",
            "initDialog": "678880401",
            "dialogues": [
                {
                    "id": "678880401",
                    "speaker": "Player",
                    "text": "这不对吧…"
                },
                {
                    "id": "678880402",
                    "speaker": "弗约尔斯卡娅",
                    "text": "再年轻个十岁，像莎戈娃那么大的时候，我也觉得这不对。"
                },
                {
                    "id": "678880403",
                    "speaker": "弗约尔斯卡娅",
                    "text": "莎戈娃…那个年轻的傻姑娘，还以为只要努力，就能出人头地。"
                },
                {
                    "id": "678880404",
                    "speaker": "弗约尔斯卡娅",
                    "text": "想当初，我年年都是凝露镇优秀列车员。人人都说，年轻的弗约尔斯卡娅是最有希望调任到至冬堡去的。"
                },
                {
                    "id": "678880405",
                    "speaker": "弗约尔斯卡娅",
                    "text": "可结果呢？年年我都在这车站，眼睁睁看着那些镇长亲戚家出来的、要么就是认识站长的列车员…看着他们一一升迁。"
                },
                {
                    "id": "678880406",
                    "speaker": "弗约尔斯卡娅",
                    "text": "从那以后，我就知道了。与其相信那些不着调的好话，不如舒舒服服过好自己的每一天。"
                }
            ]
        },
        {
            "talkId": "6788805",
            "initDialog": "678880501",
            "dialogues": [
                {
                    "id": "678880501",
                    "speaker": "Player",
                    "text": "对！"
                },
                {
                    "id": "678880502",
                    "speaker": "弗约尔斯卡娅",
                    "text": "英雄所见略同，看来您也深谙工作之道。"
                },
                {
                    "id": "678880503",
                    "speaker": "弗约尔斯卡娅",
                    "text": "那个傻姑娘…您见着了吗？那边有个叫莎戈娃的列车员。她还想着，只要做得够多，就一定能被看见、被赏识，然后被提拔。"
                },
                {
                    "id": "678880504",
                    "speaker": "弗约尔斯卡娅",
                    "text": "提拔？哈…她不知道。在这个地方，做得越多，就只会得到更多的工作。"
                }
            ]
        }
    ]
}