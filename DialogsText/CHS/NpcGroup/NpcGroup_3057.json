    "talks": [
        {
            "talkId": "6305701",
            "initDialog": "630570101",
            "dialogues": [
                {
                    "id": "630570101",
                    "speaker": "大河原五右卫门",
                    "text": "……"
                },
                {
                    "id": "630570102",
                    "speaker": "大河原五右卫门",
                    "text": "……"
                },
                {
                    "id": "630570103",
                    "speaker": "大河原五右卫门",
                    "text": "怎么，有事？"
                }
            ]
        },
        {
            "talkId": "6305702",
            "initDialog": "630570201",
            "dialogues": [
                {
                    "id": "630570201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "630570202",
                    "speaker": "大河原五右卫门",
                    "text": "连我的大名都不知道？真是见识短浅的异乡人。"
                },
                {
                    "id": "630570203",
                    "speaker": "大河原五右卫门",
                    "text": "我是天领奉行的武士头领，现在正负责着保护九条家安全的重任。"
                },
                {
                    "id": "630570204",
                    "speaker": "大河原五右卫门",
                    "text": "众所周知，我是稻妻第一的剑客。在我面前的话，劝你不要动什么歪心思。"
                }
            ]
        },
        {
            "talkId": "6305703",
            "initDialog": "630570301",
            "dialogues": [
                {
                    "id": "630570301",
                    "speaker": "Player",
                    "text": "……"
                },
                {
                    "id": "630570302",
                    "speaker": "大河原五右卫门",
                    "text": "…莫名其妙。"
                }
            ]
        },
        {
            "talkId": "6305704",
            "initDialog": "630570401",
            "dialogues": [
                {
                    "id": "630570401",
                    "speaker": "Player",
                    "text": "稻妻第一？"
                },
                {
                    "id": "630570402",
                    "speaker": "大河原五右卫门",
                    "text": "没错。我崇尚极致的剑术，现在也达到了极致的境界。"
                },
                {
                    "id": "630570403",
                    "speaker": "大河原五右卫门",
                    "text": "在我看来，至高的剑术就是要靠自己的力量，而不是什么旁门左道的神之眼。"
                },
                {
                    "id": "630570404",
                    "speaker": "大河原五右卫门",
                    "text": "与我师出同门的人，就算靠元素力也无法伤我分毫，还被我反手夺去了神之眼，实在是好笑。"
                },
                {
                    "id": "630570405",
                    "speaker": "大河原五右卫门",
                    "text": "哦？你也是没有神之眼的剑客吗。不错，多多修行，假以时日能及我千分之一的话，也算是不错的结果了。"
                }
            ]
        }
    ]
}