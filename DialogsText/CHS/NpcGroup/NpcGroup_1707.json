            "dialogues": [
                {
                    "id": "617070101",
                    "speaker": "阿特拉",
                    "text": "你也想成为牌手吗，如果你也想成为牌手的话，就一定要记得，最后成为「七圣召唤」之王的人，一定是我！"
                }
