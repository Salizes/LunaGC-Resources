{
    "groupId": "4327",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 9,
        "艾方索": 19
    },
    "talks": [
        {
            "talkId": "6432701",
            "initDialog": "643270101",
            "dialogues": [
                {
                    "id": "643270101",
                    "speaker": "艾方索",
                    "text": "上边的任务…不想处理…怎么办才好…要是孩子们…拉娜…"
                }
            ]
        },
        {
            "talkId": "6432702",
            "initDialog": "643270201",
            "dialogues": [
                {
                    "id": "643270201",
                    "speaker": "Player",
                    "text": "（悄悄离开吧。）"
                },
                {
                    "id": "643270202",
                    "speaker": "艾方索",
                    "text": "没办法了…不做不行…"
                }
            ]
        },
        {
            "talkId": "6432703",
            "initDialog": "643270301",
            "dialogues": [
                {
                    "id": "643270301",
                    "speaker": "艾方索",
                    "text": "维摩庄真是好地方…只要你在这里生活一段时间，一定会像我一样爱上这里的。"
                }
            ]
        },
        {
            "talkId": "6432704",
            "initDialog": "643270401",
            "dialogues": [
                {
                    "id": "643270401",
                    "speaker": "Player",
                    "text": "为什么留在维摩庄…"
                },
                {
                    "id": "643270402",
                    "speaker": "艾方索",
                    "text": "该从哪里说起呢…嗯…我本来只是跟着老师来须弥参加教令院的讨论会，偶尔路过了这里，不知为何就想留下来了…"
                },
                {
                    "id": "643270403",
                    "speaker": "艾方索",
                    "text": "维摩庄可比枫丹舒服许多了，无论是环境，还是氛围。"
                }
            ]
        },
        {
            "talkId": "6432705",
            "initDialog": "643270501",
            "dialogues": [
                {
                    "id": "643270501",
                    "speaker": "Player",
                    "text": "关于孩子们…"
                },
                {
                    "id": "643270502",
                    "speaker": "艾方索",
                    "text": "卡乌斯，素达蓓和优丹，都是好孩子，也很有活力。"
                },
                {
                    "id": "643270503",
                    "speaker": "艾方索",
                    "text": "不过，森林里的一些地方实在太危险了，每次找不到孩子的时候我都宁愿他们别那么有好奇心。"
                }
            ]
        },
        {
            "talkId": "6432706",
            "initDialog": "643270601",
            "dialogues": [
                {
                    "id": "643270601",
                    "speaker": "Player",
                    "text": "关于拉娜…"
                },
                {
                    "id": "643270602",
                    "speaker": "艾方索",
                    "text": "拉娜既有责任心，又讨那群「小老虎」的喜欢…"
                },
                {
                    "id": "643270603",
                    "speaker": "艾方索",
                    "text": "不过，她经常在森林里奔波。真希望她能多休息一会儿。"
                }
            ]
        },
        {
            "talkId": "6432707",
            "initDialog": "643270701",
            "dialogues": [
                {
                    "id": "643270701",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643270702",
                    "speaker": "艾方索",
                    "text": "嗯，希望你喜欢这里。"
                }
            ]
        },
        {
            "talkId": "6432708",
            "initDialog": "643270801",
            "dialogues": [
                {
                    "id": "643270801",
                    "speaker": "艾方索",
                    "text": "唉，这样下去该怎么办，拉娜…"
                }
            ]
        },
        {
            "talkId": "6432709",
            "initDialog": "643270901",
            "dialogues": [
                {
                    "id": "643270901",
                    "speaker": "Player",
                    "text": "拉娜不会有事的。"
                },
                {
                    "id": "643270902",
                    "speaker": "艾方索",
                    "text": "……"
                },
                {
                    "id": "643270903",
                    "speaker": "艾方索",
                    "text": "既然你这么说了，那我就姑且相信你吧。"
                }
            ]
        },
        {
            "talkId": "6432710",
            "initDialog": "643271001",
            "dialogues": [
                {
                    "id": "643271001",
                    "speaker": "Player",
                    "text": "关于优丹…"
                },
                {
                    "id": "643271002",
                    "speaker": "艾方索",
                    "text": "优丹没受什么伤，真是不幸中的万幸，只是…拉娜的事似乎给了他很大的打击。"
                },
                {
                    "id": "643271003",
                    "speaker": "艾方索",
                    "text": "不过正所谓：「不要输给风，不要输给雨。不输给冬雪，也不输给炎夏…」"
                },
                {
                    "id": "643271004",
                    "speaker": "艾方索",
                    "text": "人正因被打击所以才会变得坚强。希望优丹也能得到成长吧。"
                }
            ]
        },
        {
            "talkId": "6432711",
            "initDialog": "643271101",
            "dialogues": [
                {
                    "id": "643271101",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643271102",
                    "speaker": "艾方索",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6432712",
            "initDialog": "643271201",
            "dialogues": [
                {
                    "id": "643271201",
                    "speaker": "艾方索",
                    "text": "要怎么应对任务才行呢…"
                }
            ]
        },
        {
            "talkId": "6432713",
            "initDialog": "643271301",
            "dialogues": [
                {
                    "id": "643271301",
                    "speaker": "Player",
                    "text": "（悄悄离开吧。）"
                },
                {
                    "id": "643271302",
                    "speaker": "艾方索",
                    "text": "该怎么办才好…"
                }
            ]
        }
    ]
}