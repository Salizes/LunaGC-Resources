{
    "groupId": "9338",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "影": 9
    },
    "talks": [
        {
            "talkId": "6933801",
            "initDialog": "693380101",
            "dialogues": [
                {
                    "id": "693380101",
                    "speaker": "影",
                    "text": "在彻底结束战斗之前驻足小憩，这种事对我来说并不常有。"
                },
                {
                    "id": "693380102",
                    "speaker": "影",
                    "text": "「已经到可以稍憩片刻的时候了吗？」我会反复询问自己。如果魔物还未斩尽，那我也不该就此停下。"
                },
                {
                    "id": "693380103",
                    "speaker": "影",
                    "text": "你想先随我冥想片刻？唔，好吧。那你便闭上双眼，与我一同观照内心…"
                }
            ]
        },
        {
            "talkId": "6933802",
            "initDialog": "693380201",
            "dialogues": [
                {
                    "id": "693380201",
                    "speaker": "影",
                    "text": "我知道你武艺高强，但此秘境的魔物层见叠出，不容小觑。"
                },
                {
                    "id": "693380202",
                    "speaker": "影",
                    "text": "无须担心。我既然回应你的邀请，便会与你穷究此地奥秘。"
                },
                {
                    "id": "693380203",
                    "speaker": "影",
                    "text": "就让我以此刀，斩灭来敌。"
                }
            ]
        },
        {
            "talkId": "6933803",
            "initDialog": "693380301",
            "dialogues": [
                {
                    "id": "693380301",
                    "speaker": "影",
                    "text": "要与我进行歌牌对决吗？作为闲暇时分的调剂，能帮你我二人放松心情，也能助我保持进取之姿。"
                },
                {
                    "id": "693380302",
                    "speaker": "影",
                    "text": "只是…这作为最终奖品的糕点，也不知能否从外面带进来…"
                },
                {
                    "id": "693380303",
                    "speaker": "影",
                    "text": "嗯，既然如此…庆祝之地，就选在神樱树下吧。现在，做好觉悟了吗？"
                }
            ]
        }
    ]
}