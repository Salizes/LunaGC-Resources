{
    "groupId": "7098",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "莎莱卡": 10
    },
    "talks": [
        {
            "talkId": "6709801",
            "initDialog": "670980101",
            "dialogues": [
                {
                    "id": "670980101",
                    "speaker": "莎莱卡",
                    "text": "来吧，孩子们，该向月神大人祷告了…"
                }
            ]
        },
        {
            "talkId": "6709802",
            "initDialog": "670980201",
            "dialogues": [
                {
                    "id": "670980201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "670980202",
                    "speaker": "莎莱卡",
                    "text": "我是霜月的侍仆，领受月秩的大执祭，月下世界的凡名为莎莱卡，前任「咏月使」的胞妹。"
                },
                {
                    "id": "670980203",
                    "speaker": "莎莱卡",
                    "text": "若是你想要一同向库塔{RUBY#[S]月之少女}尔大人祷告，旅人，我们也随时欢迎。"
                }
            ]
        },
        {
            "talkId": "6709803",
            "initDialog": "670980301",
            "dialogues": [
                {
                    "id": "670980301",
                    "speaker": "Player",
                    "text": "祷告？"
                },
                {
                    "id": "670980302",
                    "speaker": "莎莱卡",
                    "text": "没错，我们是在向仁慈的库塔{RUBY#[S]月之少女}尔大人祷告，旅者。"
                },
                {
                    "id": "670980303",
                    "speaker": "莎莱卡",
                    "text": "是她赐予了我们在这片阴恶的土地上生存的智慧与力量，我们的一切都源于她的慷慨。"
                },
                {
                    "id": "670980304",
                    "speaker": "莎莱卡",
                    "text": "所以，孩子们也应该清楚，无论遇到什么困难，库塔{RUBY#[S]月之少女}尔大人始终倾听着我们的歌声，只要足够虔诚，她便会回应我们的心愿。"
                }
            ]
        },
        {
            "talkId": "6709804",
            "initDialog": "670980401",
            "dialogues": [
                {
                    "id": "670980401",
                    "speaker": "Player",
                    "text": "祷告？"
                },
                {
                    "id": "670980402",
                    "speaker": "莎莱卡",
                    "text": "没错，我们是在向仁慈的库塔{RUBY#[S]月之少女}尔大人祷告，旅者。"
                },
                {
                    "id": "670980403",
                    "speaker": "莎莱卡",
                    "text": "菈乌玛的决定自有她的道理，信仰原本就不应当是以物易物的交易。然而向月神祷告也是我等自古以来的传统，不可轻易抛弃。"
                },
                {
                    "id": "670980404",
                    "speaker": "莎莱卡",
                    "text": "孩子们也应该清楚，即使库塔{RUBY#[S]月之少女}尔大人不会直接回应每一个愿望，也要让内心如月光那般澄澈无垢。"
                }
            ]
        },
        {
            "talkId": "6709805",
            "initDialog": "670980501",
            "dialogues": [
                {
                    "id": "670980501",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "670980502",
                    "speaker": "莎莱卡",
                    "text": "去吧，旅者。愿你心中常有库塔{RUBY#[S]月之少女}尔大人的柔光。"
                }
            ]
        }
    ]
}