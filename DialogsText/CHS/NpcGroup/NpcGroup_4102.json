    "talks": [
        {
            "talkId": "6410201",
            "initDialog": "641020101",
            "dialogues": [
                {
                    "id": "641020101",
                    "speaker": "萨拉尔",
                    "text": "你好，是来领肥料的吗？请报下名字。"
                }
            ]
        },
        {
            "talkId": "6410202",
            "initDialog": "641020201",
            "dialogues": [
                {
                    "id": "641020201",
                    "speaker": "Player",
                    "text": "只有名单上的人才能领吗？"
                },
                {
                    "id": "641020202",
                    "speaker": "萨拉尔",
                    "text": "是的，我受教令院的学者委托，按照名单为农户们免费分发肥料。"
                },
                {
                    "id": "641020203",
                    "speaker": "萨拉尔",
                    "text": "「丰沃之惠」是草神的恩赐与贤者大人们的智慧结晶，效果卓越，用法简单。"
                },
                {
                    "id": "641020204",
                    "speaker": "萨拉尔",
                    "text": "农民们只要按照说明定期使用就能保证作物丰收，很方便吧？"
                }
            ]
        },
        {
            "talkId": "6410203",
            "initDialog": "641020301",
            "dialogues": [
                {
                    "id": "641020301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "641020302",
                    "speaker": "萨拉尔",
                    "text": "不在名单上的话就不能领取了，抱歉。"
                }
            ]
        }
    ]
}