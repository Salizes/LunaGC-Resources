{
    "groupId": "1447",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "雷蒙德": 8
    },
    "talks": [
        {
            "talkId": "6144701",
            "initDialog": "614470101",
            "dialogues": [
                {
                    "id": "614470101",
                    "speaker": "雷蒙德",
                    "text": "发现什么情况，都可以跟我报告。"
                }
            ]
        },
        {
            "talkId": "6144702",
            "initDialog": "614470201",
            "dialogues": [
                {
                    "id": "614470201",
                    "speaker": "Player",
                    "text": "蒙德城内有什么值得一看的吗？"
                },
                {
                    "id": "614470202",
                    "speaker": "雷蒙德",
                    "text": "如果您是第一次来，我推荐您到蒙德城大教堂看一看。"
                },
                {
                    "id": "614470203",
                    "speaker": "雷蒙德",
                    "text": "当您感觉疲劳的时候，不妨去「天使的馈赠」酒馆尝尝蒙德闻名的好酒。"
                }
            ]
        },
        {
            "talkId": "6144703",
            "initDialog": "614470301",
            "dialogues": [
                {
                    "id": "614470301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "614470302",
                    "speaker": "雷蒙德",
                    "text": "再见，旅行者。"
                },
                {
                    "id": "614470303",
                    "speaker": "雷蒙德",
                    "text": "愿风神护佑您。"
                }
            ]
        },
        {
            "talkId": "6144704",
            "initDialog": "614470401",
            "dialogues": [
                {
                    "id": "614470401",
                    "speaker": "雷蒙德",
                    "text": "现在气候异常，外面很危险，一般民众请找安全的地方避难。"
                }
            ]
        },
        {
            "talkId": "6144705",
            "initDialog": "614470501",
            "dialogues": [
                {
                    "id": "614470501",
                    "speaker": "雷蒙德",
                    "text": "那条龙随时可能回来，我们西风骑士会盯着的，请抓紧避难。"
                }
            ]
        },
        {
            "talkId": "6144706",
            "initDialog": "614470601",
            "dialogues": [
                {
                    "id": "614470601",
                    "speaker": "雷蒙德",
                    "text": "现在是紧急事态，请相信我们西风骑士会保障大家的安全。"
                }
            ]
        }
    ]
}