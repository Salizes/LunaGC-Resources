                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7291901",
            "initDialog": "729190101",
            "dialogues": [
                {
                    "id": "729190101",
                    "speaker": "Player",
                    "text": "祝你的手艺越来越精进。"
                },
                {
                    "id": "729190102",
                    "speaker": "木南杏奈",
                    "text": "嘿嘿，多谢啦。"
                },
                {
                    "id": "729190103",
                    "speaker": "木南杏奈",
                    "text": "对了，今天正好有新到的鱼鲜，请你尝尝看新鲜的金枪鱼寿司吧！是我亲手做的哦。"
                },
                {
                    "id": "729190104",
                    "speaker": "木南杏奈",
                    "text": "如果有什么建议也请不要客气地告诉我，这样我才能进步呀。"
                }
            ]
        }
    ]
}