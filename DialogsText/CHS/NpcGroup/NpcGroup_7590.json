{
    "groupId": "7590",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 3,
        "派蒙": 12,
        "迈斯卡娅": 11
    },
    "talks": [
        {
            "talkId": "6759001",
            "initDialog": "675900101",
            "dialogues": [
                {
                    "id": "675900101",
                    "speaker": "迈斯卡娅",
                    "text": "欢迎光临，您可以在这里游玩最新的「哐哐当当雀雀球」，团雀很可爱的，请试试吧。"
                }
            ]
        },
        {
            "talkId": "6759002",
            "initDialog": "675900201",
            "dialogues": [
                {
                    "id": "675900201",
                    "speaker": "Player",
                    "text": "好、好的…我想试试。"
                },
                {
                    "id": "675900202",
                    "speaker": "迈斯卡娅",
                    "text": "准备区在这边，游玩须知手册在桌上，请您自行查阅。"
                },
                {
                    "id": "675900203",
                    "speaker": "迈斯卡娅",
                    "text": "祝您玩得开心。相信我，团雀很可爱。"
                }
            ]
        },
        {
            "talkId": "6759003",
            "initDialog": "675900301",
            "dialogues": [
                {
                    "id": "675900301",
                    "speaker": "Player",
                    "text": "欸？我还以为会是拜希麦…"
                },
                {
                    "id": "675900302",
                    "speaker": "迈斯卡娅",
                    "text": "拜希麦正在设计新的雀雀球，暂时无法亲自过来，这边的摊位就由我代管。"
                },
                {
                    "id": "675900303",
                    "speaker": "迈斯卡娅",
                    "text": "…如果我的表情让您不安，请谅解。我并没有不高兴，也没有心情不好，只是…习惯了没有表情。"
                },
                {
                    "id": "675900304",
                    "speaker": "迈斯卡娅",
                    "text": "之前我也试着强行挤出过微笑，但是，似乎把想来玩「哐哐当当雀雀球」莎茨卡娅吓了一跳。"
                },
                {
                    "id": "675900305",
                    "speaker": "迈斯卡娅",
                    "text": "从那之后，我想，我还是保持着没有表情的状态比较好吧…"
                },
                {
                    "id": "675900306",
                    "speaker": "迈斯卡娅",
                    "text": "拜希麦说，我摸团雀时会露出很自然的微笑，但我自己并没有发觉。"
                },
                {
                    "id": "675900307",
                    "speaker": "迈斯卡娅",
                    "text": "不过，摸到团雀这么可爱的生物，露出愉悦的微笑也是情理之中，如果有条件的话，请您也多和团雀多亲近一下。"
                },
                {
                    "id": "675900308",
                    "speaker": "迈斯卡娅",
                    "text": "毕竟，团雀最可爱。"
                }
            ]
        },
        {
            "talkId": "6759004",
            "initDialog": "675900401",
            "dialogues": [
                {
                    "id": "675900401",
                    "speaker": "Player",
                    "text": "再见…"
                },
                {
                    "id": "675900402",
                    "speaker": "迈斯卡娅",
                    "text": "再见。如果想玩「哐哐当当雀雀球」的话，随时都可以过来。"
                }
            ]
        },
