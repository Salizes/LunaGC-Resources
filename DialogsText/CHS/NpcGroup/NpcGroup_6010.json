{
    "groupId": "6010",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "夏安卡": 19
    },
    "talks": [
        {
            "talkId": "6601001",
            "initDialog": "660100101",
            "dialogues": [
                {
                    "id": "660100101",
                    "speaker": "夏安卡",
                    "text": "想要吃得饱、睡得好？那你来对地方了。"
                }
            ]
        },
        {
            "talkId": "6601002",
            "initDialog": "660100201",
            "dialogues": [
                {
                    "id": "660100201",
                    "speaker": "Player",
                    "text": "有什么好吃的？"
                },
                {
                    "id": "660100202",
                    "speaker": "夏安卡",
                    "text": "来，给你菜单。"
                }
            ]
        },
        {
            "talkId": "6601003",
            "initDialog": "660100301",
            "dialogues": [
                {
                    "id": "660100301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "660100302",
                    "speaker": "夏安卡",
                    "text": "我是「倦意之屋」的老板，顺便在门口摆摆小吃摊。"
                },
                {
                    "id": "660100303",
                    "speaker": "夏安卡",
                    "text": "哎呀，说起这家店，以前我当选手的时候还来免费住过呢，没想到现在换我来管它了。"
                },
                {
                    "id": "660100304",
                    "speaker": "夏安卡",
                    "text": "你有认识的朋友参加过归火圣夜巡礼吗？"
                },
                {
                    "id": "660100305",
                    "speaker": "夏安卡",
                    "text": "有的话就方便了，可以叫他带你来留宿，餐饮也是免费的，吃到你满意为止！"
                }
            ]
        },
        {
            "talkId": "6601004",
            "initDialog": "660100401",
            "dialogues": [
                {
                    "id": "660100401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660100402",
                    "speaker": "夏安卡",
                    "text": "欢迎再来。"
                }
            ]
        },
        {
            "talkId": "6601005",
            "initDialog": "660100501",
            "dialogues": [
                {
                    "id": "660100501",
                    "speaker": "Player",
                    "text": "近况如何？"
                },
                {
                    "id": "660100502",
                    "speaker": "夏安卡",
                    "text": "多谢关心，一切都好。"
                },
                {
                    "id": "660100503",
                    "speaker": "夏安卡",
                    "text": "战后有不少老战友来我这里聚餐，虽然大家各有各的伤，但看起来都挺开心的。"
                },
                {
                    "id": "660100504",
                    "speaker": "夏安卡",
                    "text": "…当然，也可能是不想在我面前展现出不开心的样子吧。"
                },
                {
                    "id": "660100505",
                    "speaker": "夏安卡",
                    "text": "因为旧伤，我已经帮不上他们的忙了，只好请他们多吃几顿了。"
                }
            ]
        },
        {
            "talkId": "6601006",
            "initDialog": "660100601",
            "dialogues": [
                {
                    "id": "660100601",
                    "speaker": "Player",
                    "text": "近况如何？"
                },
                {
                    "id": "660100602",
                    "speaker": "夏安卡",
                    "text": "多谢关心，一切都好。"
                },
                {
                    "id": "660100603",
                    "speaker": "夏安卡",
                    "text": "战后有不少老战友来我这里聚餐，虽然大家各有各的伤，但看起来都挺开心的。"
                },
                {
                    "id": "660100604",
                    "speaker": "夏安卡",
                    "text": "…当然，也可能是不想在我面前展现出不开心的样子吧。"
                },
                {
                    "id": "660100605",
                    "speaker": "夏安卡",
                    "text": "「和平」的喜悦与「失去」的伤痛是两回事，我们都知道的。只希望他们能多来我这吃吃饭、喝喝酒，我请客！"
                }
            ]
        },
        {
            "talkId": "7590701",
            "initDialog": "759070101",
            "dialogues": [
                {
                    "id": "759070101",
                    "speaker": "Player",
                    "text": "有什么推荐吗？"
                },
                {
                    "id": "759070102",
                    "speaker": "夏安卡",
                    "text": "那当然是我的拿手菜，塔塔可了。"
                },
                {
                    "id": "759070103",
                    "speaker": "夏安卡",
                    "text": "不过这个菜做起来很简单，纳塔这边几乎人人都会。"
                },
                {
                    "id": "759070104",
                    "speaker": "夏安卡",
                    "text": "来，伸出手来。"
                },
                {
                    "id": "759070105",
                    "speaker": "夏安卡",
                    "text": "呵呵，以为我会给你成品吗？不，我要亲自教你！"
                }
            ]
        }
    ]
}