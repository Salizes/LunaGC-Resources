{
    "groupId": "4309",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "约哈南": 12
    },
    "talks": [
        {
            "talkId": "6430901",
            "initDialog": "643090101",
            "dialogues": [
                {
                    "id": "643090101",
                    "speaker": "约哈南",
                    "text": "这些巡林员讲话能不能更明白一点啊…你说什么「孢子」「授粉」啥的，谁能懂啊！"
                }
            ]
        },
        {
            "talkId": "6430902",
            "initDialog": "643090201",
            "dialogues": [
                {
                    "id": "643090201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "643090202",
                    "speaker": "约哈南",
                    "text": "我是镀金旅团的。"
                },
                {
                    "id": "643090203",
                    "speaker": "约哈南",
                    "text": "呃…还有什么…"
                },
                {
                    "id": "643090204",
                    "speaker": "约哈南",
                    "text": "对了，你需要保镖吗？"
                }
            ]
        },
        {
            "talkId": "6430903",
            "initDialog": "643090301",
            "dialogues": [
                {
                    "id": "643090301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643090302",
                    "speaker": "约哈南",
                    "text": "嗯？哦。"
                }
            ]
        },
        {
            "talkId": "6430904",
            "initDialog": "643090401",
            "dialogues": [
                {
                    "id": "643090401",
                    "speaker": "Player",
                    "text": "不必，我很强。"
                },
                {
                    "id": "643090402",
                    "speaker": "约哈南",
                    "text": "什么啊，这么臭屁。"
                },
                {
                    "id": "643090403",
                    "speaker": "约哈南",
                    "text": "但愿你很强，能在雨林里生存下来哦。"
                },
                {
                    "id": "643090404",
                    "speaker": "约哈南",
                    "text": "不然就只能像边上那个学者一样，因为出不起佣兵费，整天在人多的地方打转。"
                },
                {
                    "id": "643090405",
                    "speaker": "约哈南",
                    "text": "唉，我之前听说来雨林考察的学者多，所以赚钱的机会也多，但怎么就一直轮不到我呢？"
                },
                {
                    "id": "643090406",
                    "speaker": "约哈南",
                    "text": "真羡慕「炽鬃之狮」，听说她在城里接了个大单子呢。等回城了，可得让她好好请我一顿酒！"
                }
            ]
        },
        {
            "talkId": "6430905",
            "initDialog": "643090501",
            "dialogues": [
                {
                    "id": "643090501",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6430906",
            "initDialog": "643090601",
            "dialogues": [
                {
                    "id": "643090601",
                    "speaker": "约哈南",
                    "text": "什么啊，你这不就是仗着牌组强嘛…"
                }
            ]
        },
        {
            "talkId": "6430907",
            "initDialog": "643090701",
            "dialogues": [
                {
                    "id": "643090701",
                    "speaker": "约哈南",
                    "text": "哈哈，赢了！我跟你说，就连一些学者都没法在我这里赢牌！"
                }
            ]
        }
    ]
}