    },
    "talks": [
        {
            "talkId": "6520201",
            "initDialog": "652020101",
            "dialogues": [
                {
                    "id": "652020101",
                    "speaker": "莫莱妮",
                    "text": "先填表格吧。"
                }
            ]
        },
        {
            "talkId": "6520202",
            "initDialog": "652020201",
            "dialogues": [
                {
                    "id": "652020201",
                    "speaker": "Player",
                    "text": "什么表格？"
                },
                {
                    "id": "652020202",
                    "speaker": "莫莱妮",
                    "text": "不知道自己要填什么表格的话就找知道的人问清楚了再来吧。"
                }
            ]
        },
        {
            "talkId": "6520203",
            "initDialog": "652020301",
            "dialogues": [
                {
                    "id": "652020301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "652020302",
                    "speaker": "莫莱妮",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6520204",
            "initDialog": "652020401",
            "dialogues": [
                {
                    "id": "652020401",
                    "speaker": "莫莱妮",
                    "text": "你好。"
                }
            ]
        },
        {
            "talkId": "6520205",
            "initDialog": "652020501",
            "dialogues": [
                {
                    "id": "652020501",
                    "speaker": "Player",
                    "text": "我有些问题…"
                },
                {
                    "id": "652020502",
                    "speaker": "莫莱妮",
                    "text": "不管你有什么问题，先登记在这份表格上吧。在我们分类筛选之后，会对其中可以回答的问题择日进行集中解答。"
                }
            ]
        },
        {
            "talkId": "6520206",
            "initDialog": "652020601",
            "dialogues": [
                {
                    "id": "652020601",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "652020602",
                    "speaker": "莫莱妮",
                    "text": "嗯。"
                }
            ]
        },
        {
            "talkId": "6520207",
            "initDialog": "652020701",
            "dialogues": [
                {
                    "id": "652020701",
                    "speaker": "Player",
                    "text": "你不能直接回答吗？"
                },
                {
                    "id": "652020702",
                    "speaker": "莫莱妮",
                    "text": "我无法判断你的问题是否在我可回答的范围内，所以对于你的这个问题，我也无法给出明确的解答。"
                },
                {
                    "id": "652020703",
                    "speaker": "莫莱妮",
                    "text": "如果你愿意的话，可以把这个问题也记录在表格上。"
                }
            ]
        },
        {
            "talkId": "6520208",
            "initDialog": "652020801",
            "dialogues": [
                {
                    "id": "652020801",
                    "speaker": "Player",
                    "text": "可我不想填表了。"
                },
                {
                    "id": "652020802",
                    "speaker": "莫莱妮",
                    "text": "我也不想。"
                },
                {
                    "id": "652020803",
                    "speaker": "莫莱妮",
                    "text": "但是你知道吗，在这种地方，表格就是秩序，就是唯一能为你带来慰藉的东西。"
                },
                {
                    "id": "652020804",
                    "speaker": "莫莱妮",
                    "text": "如果你还是拒绝填写表格的话，就四处走走吧。"
                },
                {
                    "id": "652020805",
                    "speaker": "莫莱妮",
                    "text": "规则不仅写在纸上，也在人们的举手投足间。通过观察，应该也能得到你想知道的解答吧。"
                }
            ]
        },
        {
            "talkId": "6520209",
            "initDialog": "652020901",
            "dialogues": [
                {
                    "id": "652020901",
                    "speaker": "Player",
                    "text": "好吧，先不打扰了。"
                },
                {
                    "id": "652020902",
                    "speaker": "莫莱妮",
                    "text": "嗯。"
                }
            ]
        }
    ]
}