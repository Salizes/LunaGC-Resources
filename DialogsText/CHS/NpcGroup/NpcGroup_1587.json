{
    "groupId": "1587",
    "total_dialogue_lines": 41,
    "speaker_counts": {
        "Player": 11,
        "蒂玛乌斯": 30
    },
    "talks": [
        {
            "talkId": "6158707",
            "initDialog": "615870701",
            "dialogues": [
                {
                    "id": "615870701",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6158708",
            "initDialog": "615870801",
            "dialogues": [
                {
                    "id": "615870801",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6158709",
            "initDialog": "615870901",
            "dialogues": [
                {
                    "id": "615870901",
                    "speaker": "蒂玛乌斯",
                    "text": "可恶，难道我哪里算错了吗…"
                }
            ]
        },
        {
            "talkId": "6158710",
            "initDialog": "615871001",
            "dialogues": [
                {
                    "id": "615871001",
                    "speaker": "蒂玛乌斯",
                    "text": "在我预料之中的胜利。"
                }
            ]
        },
        {
            "talkId": "6158711",
            "initDialog": "615871101",
            "dialogues": [
                {
                    "id": "615871101",
                    "speaker": "蒂玛乌斯",
                    "text": "我怎么会犯这种低级失误…"
                }
            ]
        },
        {
            "talkId": "6158712",
            "initDialog": "615871201",
            "dialogues": [
                {
                    "id": "615871201",
                    "speaker": "蒂玛乌斯",
                    "text": "和我预想的场面相差不多。"
                }
            ]
        },
        {
            "talkId": "7092901",
            "initDialog": "709290101",
            "dialogues": [
                {
                    "id": "709290101",
                    "speaker": "Player",
                    "text": "你的研究进展如何？"
                },
                {
                    "id": "709290102",
                    "speaker": "蒂玛乌斯",
                    "text": "还不错，只是最近运气不太好，我的时钟因为慢了几分钟，导致实验失败好几次了…"
                },
                {
                    "id": "709290103",
                    "speaker": "蒂玛乌斯",
                    "text": "虽说作为时钟的话它确实不好用了…"
                },
                {
                    "id": "709290104",
                    "speaker": "蒂玛乌斯",
                    "text": "但在多次炼金实验中，它似乎沾染上了一些对这个世界本质和规律的认知…说不定产生了什么神奇的变化…"
                },
                {
                    "id": "709290105",
                    "speaker": "蒂玛乌斯",
                    "text": "不如你就收下它吧，或许会对你的冒险有所帮助。"
                }
            ]
        },
        {
            "talkId": "41739",
            "initDialog": "615870305",
            "dialogues": [
                {
                    "id": "615870305",
                    "speaker": "Player",
                    "text": "听上去很复杂。"
                },
                {
                    "id": "615870306",
                    "speaker": "蒂玛乌斯",
                    "text": "没事的，至少操作上并不复杂。你有兴趣的话我可以教你最基础的部分。"
                },
                {
                    "id": "615870307",
                    "speaker": "蒂玛乌斯",
                    "text": "会使用风之翼的人是不需要知道它是怎么制作出来的，炼金术也是一个道理。"
                },
                {
                    "id": "615870308",
                    "speaker": "蒂玛乌斯",
                    "text": "这个过程非常精妙，相信你在使用过之后也会赞叹古代文明的智慧的。"
                }
            ]
        },
        {
            "talkId": "6158701",
            "initDialog": "615870101",
            "dialogues": [
                {
                    "id": "615870101",
                    "speaker": "蒂玛乌斯",
                    "text": "你好，你也对炼金术有兴趣吗？"
                }
            ]
        },
        {
            "talkId": "6158702",
            "initDialog": "615870201",
            "dialogues": [
                {
                    "id": "615870201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615870202",
                    "speaker": "蒂玛乌斯",
                    "text": "我叫蒂玛乌斯，是蒙德的炼金学者，可能你没有听过我的名字…"
                },
                {
                    "id": "615870203",
                    "speaker": "蒂玛乌斯",
                    "text": "但对阿贝多和砂糖这两个名字，你一定有所耳闻吧。"
                },
                {
                    "id": "615870204",
                    "speaker": "蒂玛乌斯",
                    "text": "阿贝多是难得一见的炼金天才，还有他的助手砂糖，年纪轻轻也有不错的造诣。"
                },
                {
                    "id": "615870205",
                    "speaker": "蒂玛乌斯",
                    "text": "和他们相比起来，我只是会一些雕虫小技罢了。",
                    "choices": [
                        {
                            "id": "615870206",
                            "text": "关于阿贝多…",
                            "response": [
                                {
                                    "id": "615870207",
                                    "speaker": "蒂玛乌斯",
                                    "text": "阿贝多是被人们称为「白垩之子」的天才，蒙德首屈一指的炼金大师。"
                                },
                                {
                                    "id": "615870208",
                                    "speaker": "蒂玛乌斯",
                                    "text": "据说忽然有一天从国外来到蒙德，并迅速被骑士团接纳为「首席炼金术士」，还兼任了调查小队队长。"
                                },
                                {
                                    "id": "615870209",
                                    "speaker": "蒂玛乌斯",
                                    "text": "…他的炼金理论就当前的学术发展而言，简直像天马行空一样，却又在实践中可以处处得到证实。"
                                },
                                {
                                    "id": "615870210",
                                    "speaker": "蒂玛乌斯",
                                    "text": "在他眼里，我的研究恐怕就像小孩子在摆弄玩具吧，唉…"
                                }
                            ]
                        },
                        {
                            "id": "615870211",
                            "text": "关于砂糖…",
                            "response": [
                                {
                                    "id": "615870212",
                                    "speaker": "蒂玛乌斯",
                                    "text": "砂糖小姐是阿贝多唯一的助手，能被阿贝多赏识可真是个幸运的孩子。"
                                },
                                {
                                    "id": "615870213",
                                    "speaker": "蒂玛乌斯",
                                    "text": "作为土生土长的蒙德人，砂糖小姐在炼金方面的贡献值得我们自豪…"
                                },
                                {
                                    "id": "615870214",
                                    "speaker": "蒂玛乌斯",
                                    "text": "可是她的研究方向和兴趣上都有些…古怪，以致于能够真正应用的成果少之又少。"
                                },
                                {
                                    "id": "615870215",
                                    "speaker": "蒂玛乌斯",
                                    "text": "唉，如果我能有那么好的研究资源的话，究竟又会如何呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6158703",
            "initDialog": "615870301",
            "dialogues": [
                {
                    "id": "615870301",
                    "speaker": "Player",
                    "text": "炼金术？"
                },
                {
                    "id": "615870302",
                    "speaker": "蒂玛乌斯",
                    "text": "这是一种从古代流传下来的技术，目前我们还对它了解甚少。"
                },
                {
                    "id": "615870303",
                    "speaker": "蒂玛乌斯",
                    "text": "它的规则神秘而奇妙，和我们所知的创造物体的原理完全不同。"
                },
                {
                    "id": "615870304",
                    "speaker": "蒂玛乌斯",
                    "text": "要是能掌握这门技术，应该能造出很不得了的东西，也能丰富我们对古代文明的认知。"
                }
            ]
        },
        {
            "talkId": "6158704",
            "initDialog": "615870401",
            "dialogues": [
                {
                    "id": "615870401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615870402",
                    "speaker": "蒂玛乌斯",
                    "text": "再见，那我继续我的研究了。"
                }
            ]
        },
        {
            "talkId": "6158705",
            "initDialog": "615870501",
            "dialogues": [
                {
                    "id": "615870501",
                    "speaker": "Player",
                    "text": "炼金合成"
                },
                {
                    "id": "615870502",
                    "speaker": "蒂玛乌斯",
                    "text": "准备亲手体会炼金技术的伟大了么，我会在旁边指导你的。"
                }
            ]
        },
        {
            "talkId": "6158706",
            "initDialog": "615870601",
            "dialogues": [
                {
                    "id": "615870601",
                    "speaker": "Player",
                    "text": "想要借用合成台。"
                },
                {
                    "id": "615870602",
                    "speaker": "蒂玛乌斯",
                    "text": "当然可以，请便。"
                }
            ]
        }
    ]
}