{
    "groupId": "4323",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 5,
        "耶沙法特": 12
    },
    "talks": [
        {
            "talkId": "6432301",
            "initDialog": "643230101",
            "dialogues": [
                {
                    "id": "643230101",
                    "speaker": "耶沙法特",
                    "text": "哦，你是别处来的客人吗？要是以前没试过钓鱼，我强烈推荐你尝试一下！"
                }
            ]
        },
        {
            "talkId": "6432302",
            "initDialog": "643230201",
            "dialogues": [
                {
                    "id": "643230201",
                    "speaker": "Player",
                    "text": "已经钓够了。"
                },
                {
                    "id": "643230202",
                    "speaker": "耶沙法特",
                    "text": "哈哈，看你这表情，要么是不喜欢钓鱼，要么就是太擅长钓鱼了。"
                },
                {
                    "id": "643230203",
                    "speaker": "耶沙法特",
                    "text": "反正啊，人总要有点爱好，消磨下闲散的时光，我看钓鱼就不错。"
                }
            ]
        },
        {
            "talkId": "6432303",
            "initDialog": "643230301",
            "dialogues": [
                {
                    "id": "643230301",
                    "speaker": "Player",
                    "text": "下次吧。"
                },
                {
                    "id": "643230302",
                    "speaker": "耶沙法特",
                    "text": "好啊，有空一起来钓鱼！"
                }
            ]
        },
        {
            "talkId": "6432304",
            "initDialog": "643230401",
            "dialogues": [
                {
                    "id": "643230401",
                    "speaker": "耶沙法特",
                    "text": "这不是拉娜带来的客人嘛，怎么了，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6432305",
            "initDialog": "643230501",
            "dialogues": [
                {
                    "id": "643230501",
                    "speaker": "Player",
                    "text": "关于孩子们…"
                },
                {
                    "id": "643230502",
                    "speaker": "耶沙法特",
                    "text": "哎呀，这群「小老虎」，每天都想着往森林里钻，不过小孩子就得有这样的活力才行。"
                },
                {
                    "id": "643230503",
                    "speaker": "耶沙法特",
                    "text": "素达蓓和卡乌斯，简直就和我小的时候一模一样，哈哈…"
                },
                {
                    "id": "643230504",
                    "speaker": "耶沙法特",
                    "text": "不过，还是希望他们能多注意一下安全，之前就是，一下子失踪了好几天，整个维摩庄的人都提心吊胆的…"
                },
                {
                    "id": "643230505",
                    "speaker": "耶沙法特",
                    "text": "唉，要是我的妻子在就好了，她一定能把孩子们治得服服帖帖。"
                },
                {
                    "id": "643230506",
                    "speaker": "耶沙法特",
                    "text": "但她是学者，正在教令院进行什么研究，可忙了…"
                }
            ]
        },
        {
            "talkId": "6432306",
            "initDialog": "643230601",
            "dialogues": [
                {
                    "id": "643230601",
                    "speaker": "Player",
                    "text": "关于阿玛兹亚爷爷…"
                },
                {
                    "id": "643230602",
                    "speaker": "耶沙法特",
                    "text": "哦，你是说我的父亲呀，虽然他视力变得有些差，不过毕竟年轻时想当冒险家，身子骨可硬朗啦。"
                }
            ]
        },
        {
            "talkId": "6432307",
            "initDialog": "643230701",
            "dialogues": [
                {
                    "id": "643230701",
                    "speaker": "Player",
                    "text": "没有什么事…"
                },
                {
                    "id": "643230702",
                    "speaker": "耶沙法特",
                    "text": "哈哈，是嘛…对了，有空一起来钓鱼啊！"
                }
            ]
        }
    ]
}