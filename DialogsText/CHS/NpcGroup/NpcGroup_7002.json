    "talks": [
        {
            "talkId": "6700201",
            "initDialog": "670020101",
            "dialogues": [
                {
                    "id": "670020101",
                    "speaker": "阿尔希普",
                    "text": "让年轻人做自己想做的事也好…"
                }
            ]
        },
        {
            "talkId": "6700202",
            "initDialog": "670020201",
            "dialogues": [
                {
                    "id": "670020201",
                    "speaker": "Player",
                    "text": "年轻人？"
                },
                {
                    "id": "670020202",
                    "speaker": "阿尔希普",
                    "text": "哈哈，自言自语而已，说的是我女儿柳佳。一天到晚捣鼓她那些月矩力小玩意儿，到现在连我的工坊都给借去了。"
                },
                {
                    "id": "670020203",
                    "speaker": "阿尔希普",
                    "text": "她那些研究我也搞不懂，但看她那么投入，做老爹的还能说什么呢？随她去吧。"
                }
            ]
        },
        {
            "talkId": "6700203",
            "initDialog": "670020301",
            "dialogues": [
                {
                    "id": "670020301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "670020302",
                    "speaker": "阿尔希普",
                    "text": "嗯，路上小心。"
                }
            ]
        }
    ]
}