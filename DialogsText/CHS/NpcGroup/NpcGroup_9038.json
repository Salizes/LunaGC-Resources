{
    "groupId": "9038",
    "total_dialogue_lines": 67,
    "speaker_counts": {
        "Player": 17,
        "阿贝多": 50
    },
    "talks": [
        {
            "talkId": "6903801",
            "initDialog": "690380101",
            "dialogues": [
                {
                    "id": "690380101",
                    "speaker": "阿贝多",
                    "text": "#你好，{NICKNAME}。"
                },
                {
                    "id": "690380102",
                    "speaker": "阿贝多",
                    "text": "远远听到了脚步声，嗯，果然是你。"
                }
            ]
        },
        {
            "talkId": "6903802",
            "initDialog": "690380201",
            "dialogues": [
                {
                    "id": "690380201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690380202",
                    "speaker": "阿贝多",
                    "text": "嗯，我想，书中说的「世外桃源」，大概就是这样的地方。"
                },
                {
                    "id": "690380203",
                    "speaker": "阿贝多",
                    "text": "幽静又安逸，全身心投入实验之后，甚至能够忘记时间。",
                    "choices": [
                        {
                            "id": "690380204",
                            "text": "要记得按时吃饭哦。",
                            "response": [
                                {
                                    "id": "690380205",
                                    "speaker": "阿贝多",
                                    "text": "……"
                                },
                                {
                                    "id": "690380206",
                                    "speaker": "阿贝多",
                                    "text": "嗯，那是当然的。"
                                },
                                {
                                    "id": "690380207",
                                    "speaker": "阿贝多",
                                    "text": "哦，对了…"
                                },
                                {
                                    "id": "690380210",
                                    "speaker": "阿贝多",
                                    "text": "有时我会随处写生，你在「洞天」之内的布设，也是我的灵感源泉。"
                                },
                                {
                                    "id": "690380211",
                                    "speaker": "阿贝多",
                                    "text": "…谢谢你。"
                                }
                            ]
                        },
                        {
                            "id": "690380208",
                            "text": "有什么需要可以和我说。",
                            "response": [
                                {
                                    "id": "690380209",
                                    "speaker": "阿贝多",
                                    "text": "嗯…尽情发挥你的创意就好。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903803",
            "initDialog": "690380301",
            "dialogues": [
                {
                    "id": "690380301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690380302",
                    "speaker": "阿贝多",
                    "text": "当然。"
                },
                {
                    "id": "690380303",
                    "speaker": "阿贝多",
                    "text": "啊…话题就交给你来决定吧。",
                    "choices": [
                        {
                            "id": "690380304",
                            "text": "阿贝多很喜欢画画呢…",
                            "response": [
                                {
                                    "id": "690380305",
                                    "speaker": "阿贝多",
                                    "text": "嗯，这是很久以前养成的习惯了。"
                                },
                                {
                                    "id": "690380306",
                                    "speaker": "阿贝多",
                                    "text": "最初为了研究需要，我尝试过将事物用类似拓印的手法复现在纸上。"
                                },
                                {
                                    "id": "690380307",
                                    "speaker": "阿贝多",
                                    "text": "不过那样效果不好，也缺乏灵魂。"
                                },
                                {
                                    "id": "690380308",
                                    "speaker": "阿贝多",
                                    "text": "后来，就试着学习了绘画。"
                                },
                                {
                                    "id": "690380309",
                                    "speaker": "阿贝多",
                                    "text": "掌握绘画技巧的同时，不知不觉已经沉浸其中了。"
                                },
                                {
                                    "id": "690380316",
                                    "speaker": "阿贝多",
                                    "text": "唔，除此之外的话…"
                                },
                                {
                                    "id": "690380317",
                                    "speaker": "阿贝多",
                                    "text": "大概是你吧。"
                                },
                                {
                                    "id": "690380318",
                                    "speaker": "阿贝多",
                                    "text": "一开始是因为你身上星海的气息…"
                                },
                                {
                                    "id": "690380319",
                                    "speaker": "阿贝多",
                                    "text": "但现在…似乎不止是这样子。"
                                },
                                {
                                    "id": "690380320",
                                    "speaker": "阿贝多",
                                    "text": "这是为什么呢？再给我多一些时间，我肯定能研究明白的。"
                                }
                            ]
                        },
                        {
                            "id": "690380310",
                            "text": "阿贝多很喜欢实验呢…",
                            "response": [
                                {
                                    "id": "690380311",
                                    "speaker": "阿贝多",
                                    "text": "嗯，对我来说，世界是一座没有边界的书库。"
                                },
                                {
                                    "id": "690380312",
                                    "speaker": "阿贝多",
                                    "text": "在实验中研究各种各样的课题…"
                                },
                                {
                                    "id": "690380313",
                                    "speaker": "阿贝多",
                                    "text": "亲手揭开未知的秘密，最后掌握新的知识。"
                                },
                                {
                                    "id": "690380314",
                                    "speaker": "阿贝多",
                                    "text": "这种感觉，令人着迷。"
                                }
                            ]
                        },
                        {
                            "id": "690380315",
                            "text": "阿贝多还有什么感兴趣的吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903804",
            "initDialog": "690380401",
            "dialogues": [
                {
                    "id": "690380401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690380402",
                    "speaker": "阿贝多",
                    "text": "嗯，细说的话有不少。"
                },
                {
                    "id": "690380403",
                    "speaker": "阿贝多",
                    "text": "有你的陪伴，灵感总是源源不断。",
                    "choices": [
                        {
                            "id": "690380404",
                            "text": "是指画画吗？",
                            "response": [
                                {
                                    "id": "690380406",
                                    "speaker": "阿贝多",
                                    "text": "不管是画画也好，还是实验也好。"
                                },
                                {
                                    "id": "690380407",
                                    "speaker": "阿贝多",
                                    "text": "除开这些之外，还有很多。"
                                },
                                {
                                    "id": "690380408",
                                    "speaker": "阿贝多",
                                    "text": "说来…以前我时常觉得，人际交往很浪费时间。"
                                },
                                {
                                    "id": "690380409",
                                    "speaker": "阿贝多",
                                    "text": "但在遇见你之后，比起其他事项，我更愿意把时间花在你身上。"
                                },
                                {
                                    "id": "690380410",
                                    "speaker": "阿贝多",
                                    "text": "这是一种很独特的现象，我想我大概能理解它的原因。"
                                },
                                {
                                    "id": "690380411",
                                    "speaker": "阿贝多",
                                    "text": "所以，你也可以多给我一些…你的时间吗？",
                                    "choices": [
                                        {
                                            "id": "690380412",
                                            "text": "那就陪你去写生吧。",
                                            "response": [
                                                {
                                                    "id": "690380413",
                                                    "speaker": "阿贝多",
                                                    "text": "谢谢。那今天的题材——"
                                                },
                                                {
                                                    "id": "690380414",
                                                    "speaker": "阿贝多",
                                                    "text": "就画「你与洞天」吧。"
                                                },
                                                {
                                                    "id": "690380418",
                                                    "speaker": "阿贝多",
                                                    "text": "另外，结束之后，我能有幸邀请你一起去吃个甜点吗？"
                                                },
                                                {
                                                    "id": "690380419",
                                                    "speaker": "阿贝多",
                                                    "text": "作为意义的延续，还有对你陪伴的感谢。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690380415",
                                            "text": "那就陪你做实验吧。",
                                            "response": [
                                                {
                                                    "id": "690380416",
                                                    "speaker": "阿贝多",
                                                    "text": "谢谢。我会确保好你的安全，就像往常一样。"
                                                },
                                                {
                                                    "id": "690380417",
                                                    "speaker": "阿贝多",
                                                    "text": "我们已经很默契了，不是吗？"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690380405",
                            "text": "是指实验吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6903805",
            "initDialog": "690380501",
            "dialogues": [
                {
                    "id": "690380501",
                    "speaker": "Player",
                    "text": "早啊，阿贝多。"
                },
                {
                    "id": "690380502",
                    "speaker": "阿贝多",
                    "text": "#早，{NICKNAME}。下一阶段的研究目标，我已经梳理好了。"
                },
                {
                    "id": "690380503",
                    "speaker": "阿贝多",
                    "text": "不过如果你另有安排的话，我并不介意改变计划。"
                }
            ]
        },
        {
            "talkId": "6903806",
            "initDialog": "690380601",
            "dialogues": [
                {
                    "id": "690380601",
                    "speaker": "Player",
                    "text": "晚安，阿贝多。"
                },
                {
                    "id": "690380602",
                    "speaker": "阿贝多",
                    "text": "晚安，愿你有个好梦。"
                },
                {
                    "id": "690380603",
                    "speaker": "阿贝多",
                    "text": "…应该不需要我给你读睡前故事吧？"
                }
            ]
        },
        {
            "talkId": "6903807",
            "initDialog": "690380701",
            "dialogues": [
                {
                    "id": "690380701",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6903808",
            "initDialog": "690380801",
            "dialogues": [
                {
                    "id": "690380801",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6903809",
            "initDialog": "690380901",
            "dialogues": [
                {
                    "id": "690380901",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6903850",
            "initDialog": "690385001",
            "dialogues": [
                {
                    "id": "690385001",
                    "speaker": "阿贝多",
                    "text": "不错的工坊，看来在这里我也能继续研究了。"
                },
                {
                    "id": "690385002",
                    "speaker": "阿贝多",
                    "text": "我想，你是得到了某种秘术，能将现存于世的事物「描摹」下来吧？"
                },
                {
                    "id": "690385003",
                    "speaker": "阿贝多",
                    "text": "不介意的话我想和你进一步做些探讨，也许能给你带来帮助。"
                }
            ]
        },
        {
            "talkId": "6903851",
            "initDialog": "690385101",
            "dialogues": [
                {
                    "id": "690385101",
                    "speaker": "阿贝多",
                    "text": "有趣的摹本，照顾了各项细节，还有亲临野外探索才能找到的荒野气息。"
                },
                {
                    "id": "690385102",
                    "speaker": "阿贝多",
                    "text": "好，现在就来画一张写生吧。"
                },
                {
                    "id": "690385103",
                    "speaker": "阿贝多",
                    "text": "不知…你是否愿意成为我描摹的对象呢？"
                }
            ]
        }
    ]
}