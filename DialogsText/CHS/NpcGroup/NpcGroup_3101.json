{
    "groupId": "3101",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "古田": 15
    },
    "talks": [
        {
            "talkId": "6310101",
            "initDialog": "631010101",
            "dialogues": [
                {
                    "id": "631010101",
                    "speaker": "古田",
                    "text": "是客人啊，欢迎欢迎，呵呵…"
                }
            ]
        },
        {
            "talkId": "6310102",
            "initDialog": "631010201",
            "dialogues": [
                {
                    "id": "631010201",
                    "speaker": "Player",
                    "text": "您是…"
                },
                {
                    "id": "631010202",
                    "speaker": "古田",
                    "text": "别看老婆子我现在这个样子，以前也亲身随侍过宫司大人呢…"
                },
                {
                    "id": "631010203",
                    "speaker": "古田",
                    "text": "我和我的老朋友中西，从前前代奉行大人还在位时就为神里家效力了。"
                },
                {
                    "id": "631010204",
                    "speaker": "古田",
                    "text": "后来年纪大了、手脚不利索了，我们便退休啦。"
                },
                {
                    "id": "631010205",
                    "speaker": "古田",
                    "text": "我嘛…承蒙大小姐不嫌弃，还能在这座宅邸当个管家，平时做些杂活，顺便也带带小春这样的年轻人，呵呵。"
                },
                {
                    "id": "631010206",
                    "speaker": "古田",
                    "text": "希望小春这孩子可以多学学托马的那些家政诀窍，我也就能放心啦…"
                }
            ]
        },
        {
            "talkId": "6310103",
            "initDialog": "631010301",
            "dialogues": [
                {
                    "id": "631010301",
                    "speaker": "Player",
                    "text": "家政诀窍？"
                },
                {
                    "id": "631010302",
                    "speaker": "古田",
                    "text": "是啦，说到打理家务，这个宅邸中最擅长的人应该就是托马了。"
                },
                {
                    "id": "631010303",
                    "speaker": "古田",
                    "text": "无论是修整庭院、收纳摆设、做饭补衣，托马都能又快又好地完成。"
                },
                {
                    "id": "631010304",
                    "speaker": "古田",
                    "text": "只可惜他还要侍奉奉行大人和神里大小姐，不能包揽所有的家务。"
                },
                {
                    "id": "631010305",
                    "speaker": "古田",
                    "text": "不然有他在的话，神里家的家仆都要没事做了，哈哈哈…"
                }
            ]
        },
        {
            "talkId": "6310104",
            "initDialog": "631010401",
            "dialogues": [
                {
                    "id": "631010401",
                    "speaker": "Player",
                    "text": "再见，老婆婆。"
                },
                {
                    "id": "631010402",
                    "speaker": "古田",
                    "text": "好啊，慢走啊…"
                }
            ]
        },
        {
            "talkId": "7228613",
            "initDialog": "722861301",
            "dialogues": [
                {
                    "id": "722861301",
                    "speaker": "古田",
                    "text": "小春是个倔脾气，要是她实在忍不住动了手…"
                },
                {
                    "id": "722861302",
                    "speaker": "古田",
                    "text": "希望我平时的训练没有白费，希望没有。"
                }
            ]
        },
        {
            "talkId": "7292601",
            "initDialog": "729260101",
            "dialogues": [
                {
                    "id": "729260101",
                    "speaker": "Player",
                    "text": "您以前一定很厉害吧。"
                },
                {
                    "id": "729260102",
                    "speaker": "古田",
                    "text": "哈哈哈，不敢当，不敢当。我现在只是神里家的一位普通家仆罢了，顶多徒有一些早年的经验…"
                },
                {
                    "id": "729260103",
                    "speaker": "古田",
                    "text": "…哎，不如就送给你吧。客人出门在外，这些老婆子的经验之谈，没准能派上用场呢。"
                }
            ]
        }
    ]
}