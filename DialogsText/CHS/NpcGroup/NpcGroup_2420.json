{
    "groupId": "2420",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 5,
        "花初": 8
    },
    "talks": [
        {
            "talkId": "6242001",
            "initDialog": "624200101",
            "dialogues": [
                {
                    "id": "624200101",
                    "speaker": "花初",
                    "text": "唉…早安，请问有什么事情吗？"
                }
            ]
        },
        {
            "talkId": "6242002",
            "initDialog": "624200201",
            "dialogues": [
                {
                    "id": "624200201",
                    "speaker": "Player",
                    "text": "你在烦恼什么？"
                },
                {
                    "id": "624200202",
                    "speaker": "花初",
                    "text": "我…没事，只是初次出门，偶有不适。"
                },
                {
                    "id": "624200203",
                    "speaker": "花初",
                    "text": "这里的茶…也和府中味道不同…"
                }
            ]
        },
        {
            "talkId": "6242003",
            "initDialog": "624200301",
            "dialogues": [
                {
                    "id": "624200301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624200302",
                    "speaker": "花初",
                    "text": "失礼了…我是明华商行掌柜的次女，今日特出行远游。"
                },
                {
                    "id": "624200303",
                    "speaker": "花初",
                    "text": "不过因为是第一次远行…还是不太适应呢…",
                    "choices": [
                        {
                            "id": "624200304",
                            "text": "只有你们两个人吗？",
                            "response": [
                                {
                                    "id": "624200305",
                                    "speaker": "花初",
                                    "text": "是的，因为…生意上的考虑，我只带了一人随行。"
                                }
                            ]
                        },
                        {
                            "id": "624200306",
                            "text": "你们要去哪里？",
                            "response": [
                                {
                                    "id": "624200307",
                                    "speaker": "花初",
                                    "text": "抱歉，这是商业机密，不便透露。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6242004",
            "initDialog": "624200401",
            "dialogues": [
                {
                    "id": "624200401",
                    "speaker": "Player",
                    "text": "一路平安。"
                },
                {
                    "id": "624200402",
                    "speaker": "花初",
                    "text": "谢谢，你也一样。"
                }
            ]
        }
    ]
}