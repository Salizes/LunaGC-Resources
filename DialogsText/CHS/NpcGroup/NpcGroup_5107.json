{
    "groupId": "5107",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "布瓦洛": 10
    },
    "talks": [
        {
            "talkId": "6510701",
            "initDialog": "651070101",
            "dialogues": [
                {
                    "id": "651070101",
                    "speaker": "布瓦洛",
                    "text": "如果把案件也都算作「戏剧」的话…这里的故事，多半都达不成美好的结局呢。"
                }
            ]
        },
        {
            "talkId": "6510702",
            "initDialog": "651070201",
            "dialogues": [
                {
                    "id": "651070201",
                    "speaker": "Player",
                    "text": "毕竟发生了「案件」。"
                },
                {
                    "id": "651070202",
                    "speaker": "布瓦洛",
                    "text": "是啊，有案件就会有受害者，真令人悲伤。"
                },
                {
                    "id": "651070203",
                    "speaker": "布瓦洛",
                    "text": "即便犯人被送去服刑，也很难说是个圆满的结局呢。"
                },
                {
                    "id": "651070204",
                    "speaker": "布瓦洛",
                    "text": "我因为喜爱悲剧故事，之前一直泡在歌剧院，只要有庭审或者有以悲剧结尾的戏剧演出，我都来者不拒。"
                },
                {
                    "id": "651070205",
                    "speaker": "布瓦洛",
                    "text": "时间长了，甚至有点分不清，我究竟是为了真实的同胞悲伤，还是在为戏剧的剧情难过呢？"
                },
                {
                    "id": "651070206",
                    "speaker": "布瓦洛",
                    "text": "唉，真是不应该。"
                }
            ]
        },
        {
            "talkId": "6510703",
            "initDialog": "651070301",
            "dialogues": [
                {
                    "id": "651070301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "651070302",
                    "speaker": "布瓦洛",
                    "text": "悲剧也有悲剧的美…"
                }
            ]
        },
        {
            "talkId": "7490101",
            "initDialog": "749010101",
            "dialogues": [
                {
                    "id": "749010101",
                    "speaker": "Player",
                    "text": "不能像儿戏一样看待案件。"
                },
                {
                    "id": "749010102",
                    "speaker": "布瓦洛",
                    "text": "没错，您说的很对。"
                },
                {
                    "id": "749010103",
                    "speaker": "布瓦洛",
                    "text": "都说枫丹是正义的国度，我觉得也不能只凭神明的名号。"
                },
                {
                    "id": "749010104",
                    "speaker": "布瓦洛",
                    "text": "枫丹人心中应该也要有自己的正义才对。"
                }
            ]
        }
    ]
}