            "dialogues": [
                {
                    "id": "697200101",
                    "speaker": "萨尼娅",
                    "text": "成为了知名的牌手后，一定就能接到广告，赢到奖金…"
                },
                {
                    "id": "697200102",
                    "speaker": "萨尼娅",
                    "text": "你就是我的下一个对手吗？"
                }
            ]
        },
        {
            "talkId": "6972002",
            "initDialog": "697200201",
            "dialogues": [
                {
                    "id": "697200201",
                    "speaker": "Player",
                    "text": "来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6972003",
            "initDialog": "697200301",
            "dialogues": [
                {
                    "id": "697200301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "697200302",
                    "speaker": "萨尼娅",
                    "text": "好吧，以后再说…前提是我能赚够本钱，还没收拾行李回家。"
                }
            ]
        },
        {
            "talkId": "6972004",
            "initDialog": "697200401",
            "dialogues": [
                {
                    "id": "697200401",
                    "speaker": "萨尼娅",
                    "text": "对不起，为了我家未来的摩拉，我只能这样了！"
                }
            ]
        },
        {
            "talkId": "6972005",
            "initDialog": "697200501",
            "dialogues": [
                {
                    "id": "697200501",
                    "speaker": "萨尼娅",
                    "text": "怎么会…难道我在这方面也没能力…不能靠「七圣召唤」挣钱吗？"
                }
            ]
        }
    ]
