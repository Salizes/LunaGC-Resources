{
    "groupId": "6231",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "亚蕾琪": 12
    },
    "talks": [
        {
            "talkId": "6623101",
            "initDialog": "662310101",
            "dialogues": [
                {
                    "id": "662310101",
                    "speaker": "亚蕾琪",
                    "text": "呃…该用什么口吻对龙说话呢…明明老师讲起来就很顺利…"
                }
            ]
        },
        {
            "talkId": "6623102",
            "initDialog": "662310201",
            "dialogues": [
                {
                    "id": "662310201",
                    "speaker": "Player",
                    "text": "发生什么事了？"
                },
                {
                    "id": "662310202",
                    "speaker": "亚蕾琪",
                    "text": "唉，是这样的，你应该知道，这里之前被深渊搞得一团糟，梅兹莉老师因为受伤回家休养了。"
                },
                {
                    "id": "662310203",
                    "speaker": "亚蕾琪",
                    "text": "于是，老师就把这些小龙们托付给了我，唉…"
                },
                {
                    "id": "662310204",
                    "speaker": "亚蕾琪",
                    "text": "抱歉，请不要误会，我不是不喜欢它们，只是不知道应该如何跟它们交流。"
                },
                {
                    "id": "662310205",
                    "speaker": "亚蕾琪",
                    "text": "为什么老师就能很容易地对着它们讲话呢，明明语言不通的…"
                }
            ]
        },
        {
            "talkId": "6623103",
            "initDialog": "662310301",
            "dialogues": [
                {
                    "id": "662310301",
                    "speaker": "Player",
                    "text": "多练，加油！"
                },
                {
                    "id": "662310302",
                    "speaker": "亚蕾琪",
                    "text": "唔…好！"
                }
            ]
        },
        {
            "talkId": "6623104",
            "initDialog": "662310401",
            "dialogues": [
                {
                    "id": "662310401",
                    "speaker": "Player",
                    "text": "把它们当成小猫小狗试试。"
                },
                {
                    "id": "662310402",
                    "speaker": "亚蕾琪",
                    "text": "欸，你怎么知道，老师也是这么教我的。"
                },
                {
                    "id": "662310403",
                    "speaker": "亚蕾琪",
                    "text": "但，即便我会模仿猫叫，猫也根本听不懂我在说什么啊…"
                },
                {
                    "id": "662310404",
                    "speaker": "亚蕾琪",
                    "text": "难道，可以单靠语气就能交流的吗？"
                },
                {
                    "id": "662310405",
                    "speaker": "亚蕾琪",
                    "text": "就像老师在我控制不好飞行高度时在半空中对我大声说话，即便迎着强风听不清她在说什么，我也能理解她的意思…"
                },
                {
                    "id": "662310406",
                    "speaker": "亚蕾琪",
                    "text": "啊，对不起！我开始自言自语了！"
                },
                {
                    "id": "662310407",
                    "speaker": "亚蕾琪",
                    "text": "…又难道说，和龙讲话，其实和自言自语没区别吗？"
                }
            ]
        }
    ]
}