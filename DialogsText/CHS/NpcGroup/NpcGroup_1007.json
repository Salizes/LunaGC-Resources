{
    "groupId": "1007",
    "total_dialogue_lines": 25,
    "speaker_counts": {
        "Player": 6,
        "丽莎": 19
    },
    "talks": [
        {
            "talkId": "30803",
            "initDialog": "3080301",
            "dialogues": [
                {
                    "id": "3080301",
                    "speaker": "丽莎",
                    "text": "我是管理书籍资料的丽莎，有什么想问我的吗，小可爱？",
                    "choices": [
                        {
                            "id": "3080302",
                            "text": "有关怪物。",
                            "response": [
                                {
                                    "id": "3080303",
                                    "speaker": "丽莎",
                                    "text": "关于荒野上那些怪物的资料？图书馆里有不少呢。"
                                },
                                {
                                    "id": "3080304",
                                    "speaker": "丽莎",
                                    "text": "灵活运用元素反应的优势，是轻松取胜的诀窍。"
                                },
                                {
                                    "id": "3080305",
                                    "speaker": "丽莎",
                                    "text": "对了，你考虑过来图书馆找份兼职工作吗？"
                                },
                                {
                                    "id": "3080306",
                                    "speaker": "丽莎",
                                    "text": "最近打杂…不，跑腿…不，支援的人手有些不足…"
                                }
                            ]
                        },
                        {
                            "id": "3080307",
                            "text": "有关风魔龙。",
                            "response": [
                                {
                                    "id": "3080308",
                                    "speaker": "丽莎",
                                    "text": "对抗风魔龙的办法啊…"
                                },
                                {
                                    "id": "3080309",
                                    "speaker": "丽莎",
                                    "text": "很遗憾，一个人是做不到的。"
                                },
                                {
                                    "id": "3080310",
                                    "speaker": "丽莎",
                                    "text": "从它身上庞大的风之魔力来看，绝不是随随便便就能应付的生物。"
                                },
                                {
                                    "id": "3080311",
                                    "speaker": "丽莎",
                                    "text": "有空我可以教你一点元素魔法基础。想必你就会对那股力量有些概念了吧。"
                                }
                            ]
                        },
                        {
                            "id": "3080312",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "3080313",
                                    "speaker": "丽莎",
                                    "text": "要出发了吗？一会儿见哦。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "37314",
            "initDialog": "3730926",
            "dialogues": [
                {
                    "id": "3730926",
                    "speaker": "丽莎",
                    "text": "最近和不熟的人打招呼变得困难了，「今天天气不错」这种万能的招式，居然失效了…",
                    "choices": [
                        {
                            "id": "3730927",
                            "text": "关于图书馆。",
                            "response": [
                                {
                                    "id": "3730928",
                                    "speaker": "丽莎",
                                    "text": "无论想要查阅什么资料，都可以来图书馆。"
                                },
                                {
                                    "id": "3730929",
                                    "speaker": "丽莎",
                                    "text": "图书馆自然是免费开放的哦。"
                                },
                                {
                                    "id": "3730930",
                                    "speaker": "丽莎",
                                    "text": "只是记得借阅的图书一定要按时归还，不然…姐姐我可是会很为难的。"
                                }
                            ]
                        },
                        {
                            "id": "3730931",
                            "text": "有关怪物。",
                            "response": [
                                {
                                    "id": "3730932",
                                    "speaker": "丽莎",
                                    "text": "关于荒野上那些怪物的资料？图书馆里有不少呢。"
                                },
                                {
                                    "id": "3730933",
                                    "speaker": "丽莎",
                                    "text": "灵活运用元素带来的优势，是轻松取胜的诀窍。"
                                },
                                {
                                    "id": "3730934",
                                    "speaker": "丽莎",
                                    "text": "对了，你考虑过来图书馆找份兼职工作吗？"
                                },
                                {
                                    "id": "3730935",
                                    "speaker": "丽莎",
                                    "text": "最近打杂…不，跑腿…不，支援的人手有些不足…"
                                }
                            ]
                        },
                        {
                            "id": "3730936",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "3730937",
                                    "speaker": "丽莎",
                                    "text": "要走了吗？记得有空的时候回来看看喔。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}