            "dialogues": [
                {
                    "id": "400400201",
                    "speaker": "元蓉",
                    "text": "各位，走过路过来开开眼呀！欢迎试看「藏影灯」！",
                    "choices": [
                        {
                            "id": "400400202",
                            "text": "「藏影灯」是什么？",
                            "response": [
                                {
                                    "id": "400400203",
                                    "speaker": "元蓉",
                                    "text": "这是我的新发明啦，只要用正确的方式转动「藏影灯」内的物件，让它们的影子彼此拼合，就能看到不可思议的影像。"
                                },
                                {
                                    "id": "400400204",
                                    "speaker": "元蓉",
                                    "text": "你要是感兴趣的话，不妨亲自尝试一次。装置就在这里，请试着使用吧。"
                                }
                            ]
                        },
                        {
                            "id": "400400205",
                            "text": "我想试试看！",
                            "response": [
                                {
                                    "id": "400400206",
                                    "speaker": "元蓉",
                                    "text": "没问题！希望「藏影灯」也能让你看到奇妙的影像。"
                                }
                            ]
                        },
                        {
                            "id": "400400207",
                            "text": "再见。",
                            "response": [
                                {
                                    "id": "400400208",
                                    "speaker": "元蓉",
                                    "text": "嗯，有空的话，就过来试看一下「藏影灯」吧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}