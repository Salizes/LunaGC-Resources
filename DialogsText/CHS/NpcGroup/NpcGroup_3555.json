    "talks": [
        {
            "talkId": "6355501",
            "initDialog": "635550101",
            "dialogues": [
                {
                    "id": "635550101",
                    "speaker": "凯瑟琳",
                    "text": "向着星辰与深渊！\\n欢迎来到冒险家协会总部。"
                }
            ]
        },
        {
            "talkId": "6355502",
            "initDialog": "635550201",
            "dialogues": [
                {
                    "id": "635550201",
                    "speaker": "凯瑟琳",
                    "text": "欢迎来到冒险家协会，「木偶」大人。有什么我能为您做的吗？"
                }
            ]
        },
        {
            "talkId": "6741004",
            "initDialog": "674100401",
            "dialogues": [
                {
                    "id": "674100401",
                    "speaker": "Player",
                    "text": "你好，凯瑟琳。"
                },
                {
                    "id": "674100402",
                    "speaker": "凯瑟琳",
                    "text": "很高兴见到你。"
                },
                {
                    "id": "674100403",
                    "speaker": "凯瑟琳",
                    "text": "我是冒险家协会的接待员凯瑟琳，负责为冒险家们提供任务发布和情报支援工作。"
                },
                {
                    "id": "674100404",
                    "speaker": "凯瑟琳",
                    "text": "这里是冒险家协会总部，如果您在其他国家与地区遇到什么当地冒险家协会没法解决的问题，可以来总部进行咨询。"
                }
            ]
        },
        {
            "talkId": "6741005",
            "initDialog": "674100501",
            "dialogues": [
                {
                    "id": "674100501",
                    "speaker": "Player",
                    "text": "关于至冬…"
                },
                {
                    "id": "674100502",
                    "speaker": "凯瑟琳",
                    "text": "对各位冒险家来说，至冬幅员辽阔，想必是个能够大展拳脚的好地方…"
                },
                {
                    "id": "674100503",
                    "speaker": "凯瑟琳",
                    "text": "只不过，要小心冻原上的严寒和影域产生的灾害，一定要注意探索与冒险时自身的安全。"
                }
            ]
        },
        {
            "talkId": "6741006",
            "initDialog": "674100601",
            "dialogues": [
                {
                    "id": "674100601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674100602",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，冒险家。"
                }
            ]
        },
        {
            "talkId": "6741008",
            "initDialog": "674100801",
            "dialogues": [
                {
                    "id": "674100801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674100802",
                    "speaker": "凯瑟琳",
                    "text": "再见，感谢您对协会做出的贡献，「木偶」大人。"
                }
            ]
        },
        {
            "talkId": "6741009",
            "initDialog": "674100902",
            "dialogues": [
                {
                    "id": "674100902",
                    "speaker": "凯瑟琳",
                    "text": "查看「豪斗旅纪」信息"
                }
            ]
        },
        {
            "talkId": "6741010",
