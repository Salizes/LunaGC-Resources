{
    "groupId": "7559",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 5,
        "派蒙": 13,
        "？？？": 12
    },
    "talks": [
        {
            "talkId": "6755901",
            "initDialog": "675590101",
            "dialogues": [
                {
                    "id": "675590101",
                    "speaker": "？？？",
                    "text": "要是、要是他能多回来几次就好了！"
                }
            ]
        },
        {
            "talkId": "6755902",
            "initDialog": "675590201",
            "dialogues": [
                {
                    "id": "675590201",
                    "speaker": "Player",
                    "text": "在想念哥哥吗…"
                },
                {
                    "id": "675590202",
                    "speaker": "？？？",
                    "text": "是的！托克在想大哥和二哥，可是他们每隔几天都会回家，所以没有那么想…"
                },
                {
                    "id": "675590203",
                    "speaker": "？？？",
                    "text": "托克最想念的还是阿贾克斯哥哥…他可是了不起的玩具推销员，每次回家都会带回来很多新的玩具！"
                },
                {
                    "id": "675590204",
                    "speaker": "？？？",
                    "text": "就算有的时候不回家，也会写信给冬妮娅姐姐…还会随信附赠很多好吃的好玩的。"
                },
                {
                    "id": "675590205",
                    "speaker": "？？？",
                    "text": "好吃的和好玩的都很好，不过还是哥哥回家，能和托克一起玩更好…"
                }
            ]
        },
        {
            "talkId": "6755903",
            "initDialog": "675590301",
            "dialogues": [
                {
                    "id": "675590301",
                    "speaker": "Player",
                    "text": "你在干什么？"
                },
                {
                    "id": "675590302",
                    "speaker": "？？？",
                    "text": "托克在和「独眼小宝」一起冒险…嗯，托克也是「独眼小宝」的冒险伙伴…"
                },
                {
                    "id": "675590303",
                    "speaker": "？？？",
                    "text": "「独眼小宝」打败了海之…软猬兽，打败了火之软猬兽和草之软猬兽，「咻咻——」"
                }
            ]
        },
        {
            "talkId": "6755904",
            "initDialog": "675590401",
            "dialogues": [
                {
                    "id": "675590401",
                    "speaker": "Player",
                    "text": "再见，托克。"
                },
                {
                    "id": "675590402",
                    "speaker": "？？？",
                    "text": "再见！再见！"
                }
            ]
        },
        {
            "talkId": "6755905",
            "initDialog": "675590501",
            "dialogues": [
                {
                    "id": "675590501",
                    "speaker": "Player",
                    "text": "为什么全是软猬兽…"
                },
                {
                    "id": "675590502",
                    "speaker": "？？？",
                    "text": "因为小的时候去森林里冒险，要不是有哥哥保护我，托克就差点被软猬兽咬到啦…"
                },
                {
                    "id": "675590503",
                    "speaker": "？？？",
                    "text": "所以软猬兽是坏东西…"
                }
            ]
        },
        {
            "talkId": "6755906",
            "initDialog": "675590601",
            "dialogues": [
                {
                    "id": "675590601",
                    "speaker": "Player",
                    "text": "不会还有岩雷冰风软猬兽吧…"
                },
                {
                    "id": "675590602",
                    "speaker": "？？？",
                    "text": "？"
                },
                {
                    "id": "675590603",
                    "speaker": "？？？",
                    "text": "托克不知道，但是有那么多不同的软猬兽，下次「独眼小宝」冒险，说不定就会遇到你说的…眼泪冰封软猬兽了！"
                }
            ]
        },
