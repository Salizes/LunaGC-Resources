{
    "groupId": "6071",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 4,
        "乌米": 11
    },
    "talks": [
        {
            "talkId": "6607101",
            "initDialog": "660710101",
            "dialogues": [
                {
                    "id": "660710101",
                    "speaker": "乌米",
                    "text": "俗话说得好，越会游泳的人越容易呛水。"
                }
            ]
        },
        {
            "talkId": "6607102",
            "initDialog": "660710201",
            "dialogues": [
                {
                    "id": "660710201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "660710202",
                    "speaker": "乌米",
                    "text": "啊，我是这边的救生员，很高兴在岸上和你见面，安全又放心。"
                },
                {
                    "id": "660710203",
                    "speaker": "乌米",
                    "text": "一般来讲，我如果是在水里和一个人认识，那他的状况可就不好说了。"
                }
            ]
        },
        {
            "talkId": "6607103",
            "initDialog": "660710301",
            "dialogues": [
                {
                    "id": "660710301",
                    "speaker": "Player",
                    "text": "有道理。"
                },
                {
                    "id": "660710302",
                    "speaker": "乌米",
                    "text": "对吧？要注意安全哦。"
                }
            ]
        },
        {
            "talkId": "6607104",
            "initDialog": "660710401",
            "dialogues": [
                {
                    "id": "660710401",
                    "speaker": "Player",
                    "text": "你们本地人也会溺水吗？"
                },
                {
                    "id": "660710402",
                    "speaker": "乌米",
                    "text": "多的是！越是本地居民越喜欢胡闹。"
                },
                {
                    "id": "660710403",
                    "speaker": "乌米",
                    "text": "比如在温泉里泡晕的，在浅水区跳水磕了一头血的…啊，还有龙，被游客喂了酒之后在池子里横冲直闯的…"
                },
                {
                    "id": "660710404",
                    "speaker": "乌米",
                    "text": "一个比一个难缠。"
                },
                {
                    "id": "660710405",
                    "speaker": "乌米",
                    "text": "我建议那些说流泉之众的「古名」应该叫「懒散」的人，来做一天我的工作试试。"
                }
            ]
        },
        {
            "talkId": "7593001",
            "initDialog": "759300101",
            "dialogues": [
                {
                    "id": "759300101",
                    "speaker": "Player",
                    "text": "辛苦了。"
                },
                {
                    "id": "759300102",
                    "speaker": "乌米",
                    "text": "多谢理解。"
                },
                {
                    "id": "759300103",
                    "speaker": "乌米",
                    "text": "不过话虽如此，我的骨子里应该也刻着懒散的印记吧…"
                },
                {
                    "id": "759300104",
                    "speaker": "乌米",
                    "text": "唉，好想不受干扰地痛快泡温泉啊…"
                }
            ]
        }
    ]
}