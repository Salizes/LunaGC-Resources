{
    "groupId": "7486",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "巴热诺夫": 14
    },
    "talks": [
        {
            "talkId": "6748601",
            "initDialog": "674860101",
            "dialogues": [
                {
                    "id": "674860101",
                    "speaker": "巴热诺夫",
                    "text": "为了至冬的安全，绝不能容忍一丝纰漏…"
                }
            ]
        },
        {
            "talkId": "6748602",
            "initDialog": "674860201",
            "dialogues": [
                {
                    "id": "674860201",
                    "speaker": "Player",
                    "text": "你在做什么？"
                },
                {
                    "id": "674860202",
                    "speaker": "巴热诺夫",
                    "text": "我在视察这里的安全情况，旅客。要知道，列车总站是至冬堡的命脉，而至冬堡更是至冬的心脏。"
                },
                {
                    "id": "674860203",
                    "speaker": "巴热诺夫",
                    "text": "我所守卫的这块区域，您瞧瞧吧——出站口，这难道不是车站最要紧的关隘吗？"
                },
                {
                    "id": "674860204",
                    "speaker": "巴热诺夫",
                    "text": "为了至冬的安全和未来，必须及时注意到所有潜在的危机，发现每一个可疑的人，然后立刻上报。"
                }
            ]
        },
        {
            "talkId": "6748603",
            "initDialog": "674860301",
            "dialogues": [
                {
                    "id": "674860301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "674860302",
                    "speaker": "巴热诺夫",
                    "text": "再见了，旅客。"
                }
            ]
        },
        {
            "talkId": "6748604",
            "initDialog": "674860401",
            "dialogues": [
                {
                    "id": "674860401",
                    "speaker": "Player",
                    "text": "这里看上去很安全…"
                },
                {
                    "id": "674860402",
                    "speaker": "巴热诺夫",
                    "text": "这叫防患于未然，旅客。"
                },
                {
                    "id": "674860403",
                    "speaker": "巴热诺夫",
                    "text": "要知道，宁静的雪山会在人们意料不到的时刻开始崩塌，没有波纹的水面也有可能骤然掀起海啸。"
                },
                {
                    "id": "674860404",
                    "speaker": "巴热诺夫",
                    "text": "越是平静的地方，越有可能暗流涌动，危机四伏。所以，我们必须始终保持警惕。"
                }
            ]
        },
        {
            "talkId": "6748605",
            "initDialog": "674860501",
            "dialogues": [
                {
                    "id": "674860501",
                    "speaker": "Player",
                    "text": "可疑的人？"
                },
                {
                    "id": "674860502",
                    "speaker": "巴热诺夫",
                    "text": "您想想，万一有人走私晶矿呢？万一有暗探想要从这里进入至冬堡，打听女皇陛下的去向呢？"
                },
                {
                    "id": "674860503",
                    "speaker": "巴热诺夫",
                    "text": "万一有人进城倒卖剧院门票，扰乱市场秩序；或者来了些什么想要加入运输局的外国人，最后把我们至冬人的名额全挤占了呢？"
                },
                {
                    "id": "674860504",
                    "speaker": "巴热诺夫",
                    "text": "如果让他们从出站口进入了至冬堡，将会有多少危机降临到至冬头上…"
                },
                {
                    "id": "674860505",
                    "speaker": "巴热诺夫",
                    "text": "哦…这其中的可能性是在太多，不能再想下去了，我得把精力用到正事上。"
                }
            ]
        },
        {
            "talkId": "6748606",
            "initDialog": "674860601",
            "dialogues": [
                {
                    "id": "674860601",
                    "speaker": "Player",
                    "text": "这是你的工作要求吗？"
                },
                {
                    "id": "674860602",
                    "speaker": "巴热诺夫",
                    "text": "瞧您说的…就算这份工作只要求我引导旅客出站，但身为至冬的公民，守护国土安全难道不是我们的分内之责吗？"
                },
                {
                    "id": "674860603",
                    "speaker": "巴热诺夫",
                    "text": "不能再多说了，我必须时刻关注出站口的情况，请您谅解。"
                }
            ]
        }
    ]
}