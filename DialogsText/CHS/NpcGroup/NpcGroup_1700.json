{
    "groupId": "1700",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 3,
        "安东尼": 8,
        "安娜": 12
    },
    "talks": [
        {
            "talkId": "6170001",
            "initDialog": "617000101",
            "dialogues": [
                {
                    "id": "617000101",
                    "speaker": "安娜",
                    "text": "怎么又是护送委托，我都做了多少次了…"
                },
                {
                    "id": "617000102",
                    "speaker": "安娜",
                    "text": "就没有那种…那种能让我展现实力的委托吗？"
                },
                {
                    "id": "617000103",
                    "speaker": "安东尼",
                    "text": "做事要循序渐进，你别这么着急啊。"
                }
            ]
        },
        {
            "talkId": "6170002",
            "initDialog": "617000201",
            "dialogues": [
                {
                    "id": "617000201",
                    "speaker": "Player",
                    "text": "最近怎么样？"
                },
                {
                    "id": "617000202",
                    "speaker": "安娜",
                    "text": "啊，旅行者！是你啊。"
                },
                {
                    "id": "617000203",
                    "speaker": "安娜",
                    "text": "我…正在「循序渐进」地开展冒险活动呢。"
                },
                {
                    "id": "617000204",
                    "speaker": "安娜",
                    "text": "已经完成了「护送委托」，「护送委托」和「护送委托」。"
                },
                {
                    "id": "617000205",
                    "speaker": "安东尼",
                    "text": "没错，安娜对于这种委托已经做得很好了。"
                },
                {
                    "id": "617000206",
                    "speaker": "安东尼",
                    "text": "就我所见，她已经可以称得上是精通「护送委托」了。"
                },
                {
                    "id": "617000207",
                    "speaker": "安娜",
                    "text": "哥！我都做了多少天这种委托了，我想要一场轰轰烈烈的冒险啦！"
                },
                {
                    "id": "617000208",
                    "speaker": "安东尼",
                    "text": "所以说，做事要循序渐进。"
                },
                {
                    "id": "617000209",
                    "speaker": "安娜",
                    "text": "呜…"
                }
            ]
        },
        {
            "talkId": "6170003",
            "initDialog": "617000301",
            "dialogues": [
                {
                    "id": "617000301",
                    "speaker": "Player",
                    "text": "你的身体还好吗？"
                },
                {
                    "id": "617000302",
                    "speaker": "安娜",
                    "text": "我？我身体可好啦！感觉像是有使不完的力气。"
                },
                {
                    "id": "617000303",
                    "speaker": "安东尼",
                    "text": "没错，从食量上来看也确实如此。"
                },
                {
                    "id": "617000304",
                    "speaker": "安娜",
                    "text": "哥！我就…我就是吃多了一点点啦！"
                },
                {
                    "id": "617000306",
                    "speaker": "安娜",
                    "text": "谁叫你做的菜那么好吃，不能全怪我嘛！"
                },
                {
                    "id": "617000307",
                    "speaker": "安东尼",
                    "text": "那你今天晚上想吃什么？"
                },
                {
                    "id": "617000308",
                    "speaker": "安娜",
                    "text": "甜甜花酿鸡！烤松饼，还有那个…野菇鸡肉串！还有，还有我想想啊…"
                }
            ]
        },
        {
            "talkId": "6170004",
            "initDialog": "617000401",
            "dialogues": [
                {
                    "id": "617000401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617000402",
                    "speaker": "安娜",
                    "text": "嗯，再见。"
                },
                {
                    "id": "617000403",
                    "speaker": "安东尼",
                    "text": "再见。呃，还有…"
                },
                {
                    "id": "617000404",
                    "speaker": "安东尼",
                    "text": "谢了，旅行者。"
                }
            ]
        }
    ]
}