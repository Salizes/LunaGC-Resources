    "talks": [
        {
            "talkId": "6957001",
            "initDialog": "695700101",
            "dialogues": [
                {
                    "id": "695700101",
                    "speaker": "卡维",
                    "text": "嗯，这里的室内设计不错啊。"
                }
            ]
        },
        {
            "talkId": "6957002",
            "initDialog": "695700201",
            "dialogues": [
                {
                    "id": "695700201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957003",
            "initDialog": "695700301",
            "dialogues": [
                {
                    "id": "695700301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695700302",
                    "speaker": "卡维",
                    "text": "好，下回见。我多坐一会儿再走，我想趁这次机会了解一下蒙德的人文。"
                }
            ]
        },
        {
            "talkId": "6957004",
            "initDialog": "695700401",
            "dialogues": [
                {
                    "id": "695700401",
                    "speaker": "卡维",
                    "text": "赢了赢了。呼…这局牌打得好紧张。"
                }
            ]
        },
        {
            "talkId": "6957005",
            "initDialog": "695700501",
            "dialogues": [
                {
                    "id": "695700501",
                    "speaker": "卡维",
                    "text": "这…这就完了？我还有牌没打出去呢。唉…"
                }
            ]
        },
        {
            "talkId": "6957006",
            "initDialog": "695700601",
            "dialogues": [
                {
                    "id": "695700601",
                    "speaker": "卡维",
                    "text": "好啊，见识一下我好看又实用的牌组吧！"
                }
            ]
        },
        {
            "talkId": "6957008",
            "initDialog": "695700801",
            "dialogues": [
                {
                    "id": "695700801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957009",
            "initDialog": "695700901",
            "dialogues": [
                {
                    "id": "695700901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957010",
            "initDialog": "695701001",
            "dialogues": [
                {
                    "id": "695701001",
                    "speaker": "卡维",
                    "text": "打牌对我来说也就是业余中的业余，但经验嘛，还是有一点的。怎么样？我打得不错吧？"
                }
            ]
        },
        {
            "talkId": "6957011",
            "initDialog": "695701101",
            "dialogues": [
                {
                    "id": "695701101",
                    "speaker": "卡维",
                    "text": "预先设计好的战术都没用出来，唉…只能留给下一局了。"
                }
            ]
        },
        {
            "talkId": "6957012",
            "initDialog": "695701201",
            "dialogues": [
                {
                    "id": "695701201",
                    "speaker": "卡维",
                    "text": "没问题。等我把牌拿出来，上次专门去挑了个卡盒呢。"
                }
            ]
        },
        {
            "talkId": "6957014",
            "initDialog": "695701401",
            "dialogues": [
                {
                    "id": "695701401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6957015",
            "initDialog": "695701501",
            "dialogues": [
                {
                    "id": "695701501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6957016",
            "initDialog": "695701601",
            "dialogues": [
                {
                    "id": "695701601",
                    "speaker": "卡维",
                    "text": "怎么说也是我努力研究出来的牌组，果然很能打。不枉我请教了那么多人。"
                }
            ]
        },
        {
            "talkId": "6957017",
            "initDialog": "695701701",
            "dialogues": [
                {
                    "id": "695701701",
                    "speaker": "卡维",
                    "text": "唔，看来这副牌还得再重新组，但是…怎么组才好呢？"
                }
            ]
        },
        {
            "talkId": "6957018",
            "initDialog": "695701801",
            "dialogues": [
                {
                    "id": "695701801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}