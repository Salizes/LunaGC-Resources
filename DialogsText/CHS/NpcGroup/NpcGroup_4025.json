{
    "groupId": "4025",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 4,
        "诚二": 15
    },
    "talks": [
        {
            "talkId": "6402501",
            "initDialog": "640250101",
            "dialogues": [
                {
                    "id": "640250101",
                    "speaker": "诚二",
                    "text": "今天范兵卫大人也没吩咐什么特别的工作，我要不要去哪里转转呢？"
                }
            ]
        },
        {
            "talkId": "6402502",
            "initDialog": "640250201",
            "dialogues": [
                {
                    "id": "640250201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "640250202",
                    "speaker": "诚二",
                    "text": "你好！我是跟随稻妻幕府官员范兵卫大人来须弥出差的，请多指教。"
                },
                {
                    "id": "640250203",
                    "speaker": "诚二",
                    "text": "嘿嘿，说起来有点不好意思，我来这之前还挺紧张的呢，毕竟第一次出国办事，不能丢上司的脸。"
                },
                {
                    "id": "640250204",
                    "speaker": "诚二",
                    "text": "但上司似乎还在做准备工作，所以没有什么重要的事情吩咐给我。"
                },
                {
                    "id": "640250205",
                    "speaker": "诚二",
                    "text": "所以我时不时就到这附近转转，看看须弥的风土人情。"
                }
            ]
        },
        {
            "talkId": "6402503",
            "initDialog": "640250301",
            "dialogues": [
                {
                    "id": "640250301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640250302",
                    "speaker": "诚二",
                    "text": "再见，今天就去那边找人聊天吧。"
                }
            ]
        },
        {
            "talkId": "6402504",
            "initDialog": "640250401",
            "dialogues": [
                {
                    "id": "640250401",
                    "speaker": "Player",
                    "text": "感觉如何？"
                },
                {
                    "id": "640250402",
                    "speaker": "诚二",
                    "text": "和稻妻大不一样，可新鲜了！"
                },
                {
                    "id": "640250403",
                    "speaker": "诚二",
                    "text": "就说他们的神明吧。我老是听须弥人说树王长、树王短的，还以为大慈树王就是草神呢。"
                },
                {
                    "id": "640250404",
                    "speaker": "诚二",
                    "text": "结果听了半天，原来大慈树王是前代的草神哪。"
                },
                {
                    "id": "640250405",
                    "speaker": "诚二",
                    "text": "我们稻妻人世代信奉大御所大人，还真不太能体会神明变更这件事。"
                },
                {
                    "id": "640250406",
                    "speaker": "诚二",
                    "text": "还有哇，这里的咖喱，几乎没有甜味呢！真神奇…"
                }
            ]
        },
        {
            "talkId": "6402505",
            "initDialog": "640250501",
            "dialogues": [
                {
                    "id": "640250501",
                    "speaker": "Player",
                    "text": "感觉如何？"
                },
                {
                    "id": "640250502",
                    "speaker": "诚二",
                    "text": "和稻妻大不一样，可新鲜了！"
                },
                {
                    "id": "640250503",
                    "speaker": "诚二",
                    "text": "就说他们的神明吧，听说之前失忆了好——久，最近才重新开始管理教令院！"
                },
                {
                    "id": "640250504",
                    "speaker": "诚二",
                    "text": "我们稻妻人世代信奉大御所大人，还真不能想象神明会被人类冷落呢。"
                },
                {
                    "id": "640250505",
                    "speaker": "诚二",
                    "text": "还有哇，这里的咖喱，几乎没有甜味呢！真神奇…"
                }
            ]
        }
    ]
}