{
    "groupId": "30224",
    "total_dialogue_lines": 21,
    "speaker_counts": {
        "Player": 4,
        "残存的记录·三": 7,
        "派蒙": 10
    },
    "talks": [
        {
            "talkId": "7051704",
            "initDialog": "705170401",
            "dialogues": [
                {
                    "id": "705170401",
                    "speaker": "残存的记录·三",
                    "text": "这些记录是怎么回事？"
                },
                {
                    "id": "705170402",
                    "speaker": "残存的记录·三",
                    "text": "我不记得我写过这些东西啊？"
                },
                {
                    "id": "705170403",
                    "speaker": "残存的记录·三",
                    "text": "待在这附近有点头疼，奇怪…是被什么东西影响了吗。"
                },
                {
                    "id": "705170404",
                    "speaker": "残存的记录·三",
                    "text": "好像做了一个很可怕的梦，受到了很大的刺激，忘掉了最近的事。"
                },
                {
                    "id": "705170405",
                    "speaker": "残存的记录·三",
                    "text": "以防万一，还是销毁这些记录，尽快撤离吧。"
                },
                {
                    "id": "705170406",
                    "speaker": "残存的记录·三",
                    "text": "不对，既然要销毁记录，我还写什么…"
                },
                {
                    "id": "705170407",
                    "speaker": "残存的记录·三",
                    "text": "……"
                },
                {
                    "id": "705170408",
                    "speaker": "派蒙",
                    "text": "…难道说，他逃走了?",
                    "choices": [
                        {
                            "id": "705170409",
                            "text": "他被可怕的遭遇吓倒了。",
                            "response": [
                                {
                                    "id": "705170411",
                                    "speaker": "派蒙",
                                    "text": "明明我们开启机关后，并没有发生可怕事的啊？为什么呢？"
                                },
                                {
                                    "id": "705170412",
                                    "speaker": "派蒙",
                                    "text": "他在逃走前还把大部分记录都销毁了，像是要掩盖什么事情一样…"
                                },
                                {
                                    "id": "705170413",
                                    "speaker": "Player",
                                    "text": "也许心境不同，就会看到不同的东西？"
                                },
                                {
                                    "id": "705170414",
                                    "speaker": "派蒙",
                                    "text": "好差劲哦。"
                                },
                                {
                                    "id": "705170415",
                                    "speaker": "派蒙",
                                    "text": "虽然他留下了这些记录，给了我们一点有用的情报…"
                                },
                                {
                                    "id": "705170416",
                                    "speaker": "派蒙",
                                    "text": "但总觉得他太不负责了，还是给他起个难听的外号吧，就叫「呆子逃兵」好了。"
                                },
                                {
                                    "id": "705170417",
                                    "speaker": "Player",
                                    "text": "话说回来，谜团已经解开了。"
                                },
                                {
                                    "id": "705170418",
                                    "speaker": "派蒙",
                                    "text": "确实呢，事情的来龙去脉并不复杂。"
                                },
                                {
                                    "id": "705170419",
                                    "speaker": "派蒙",
                                    "text": "那个埋在海滩下面的设备，好像也没什么危险的嘛，过段时间就会停止运转了吧。"
                                },
                                {
                                    "id": "705170420",
                                    "speaker": "派蒙",
                                    "text": "#机会难得，{NICKNAME}，你还想继续尝试这里的挑战吗？"
                                },
                                {
                                    "id": "705170421",
                                    "speaker": "派蒙",
                                    "text": "如果你还有兴趣，就尽情享受吧，之后我们再去找食材也不迟！"
                                }
                            ]
                        },
                        {
                            "id": "705170410",
                            "text": "他被设备的力量影响了。"
                        }
                    ]
                }
            ]
        }
    ]
}