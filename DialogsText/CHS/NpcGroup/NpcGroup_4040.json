    "talks": [
        {
            "talkId": "6404001",
            "initDialog": "640400101",
            "dialogues": [
                {
                    "id": "640400101",
                    "speaker": "妲卡玛忒",
                    "text": "最近往来的商船好像变多了，不知道有没有卖武器的呢…"
                }
            ]
        },
        {
            "talkId": "6404002",
            "initDialog": "640400201",
            "dialogues": [
                {
                    "id": "640400201",
                    "speaker": "Player",
                    "text": "你想买武器吗？"
                },
                {
                    "id": "640400202",
                    "speaker": "妲卡玛忒",
                    "text": "我自己还好啦，已经有了趁手的家伙。是我的义兄伊拉杰有次跟我念叨着想要一把双手剑，要我帮忙留意。"
                },
                {
                    "id": "640400203",
                    "speaker": "妲卡玛忒",
                    "text": "真怪，哪有买剑不仅要求好用，还得外形好看的？问他为什么想要，他还支支吾吾地讲不清…"
                },
                {
                    "id": "640400204",
                    "speaker": "妲卡玛忒",
                    "text": "啊！难道是在为哪里的女孩子买礼物吗？但…哪有女孩子喜欢大剑当礼物啊？"
                }
            ]
        },
        {
            "talkId": "6404003",
            "initDialog": "640400301",
            "dialogues": [
                {
                    "id": "640400301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640400302",
                    "speaker": "妲卡玛忒",
                    "text": "嗯，再见。"
                }
            ]
        }
    ]
}