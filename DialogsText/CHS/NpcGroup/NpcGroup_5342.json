{
    "groupId": "5342",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 3,
        "玛莎": 9
    },
    "talks": [
        {
            "talkId": "6534201",
            "initDialog": "653420101",
            "dialogues": [
                {
                    "id": "653420101",
                    "speaker": "玛莎",
                    "text": "那个可疑的须弥人…唉，不行不行，得让莫塞离他远点…"
                }
            ]
        },
        {
            "talkId": "6534202",
            "initDialog": "653420201",
            "dialogues": [
                {
                    "id": "653420201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "653420202",
                    "speaker": "玛莎",
                    "text": "欸？啊，你好呀，远道而来的客人！我是玛莎·帕斯夸莱，帕斯夸莱乐器工坊的女主人。"
                },
                {
                    "id": "653420203",
                    "speaker": "玛莎",
                    "text": "如果需要订购乐器的话，可以直接找我的丈夫乔瓦尼喔。"
                }
            ]
        },
        {
            "talkId": "6534203",
            "initDialog": "653420301",
            "dialogues": [
                {
                    "id": "653420301",
                    "speaker": "Player",
                    "text": "可疑的须弥人？"
                },
                {
                    "id": "653420302",
                    "speaker": "玛莎",
                    "text": "啊，就是那边那个人，名字是叫…是叫犍什么来着？他的名字发音很奇怪，我完全记不住。"
                },
                {
                    "id": "653420303",
                    "speaker": "玛莎",
                    "text": "他是前阵子到镇子上来的，自称是什么须弥教令院的学者。但我从来没见他做过什么正经研究，一天到晚都在和督治阁下的孙女打牌…"
                },
                {
                    "id": "653420304",
                    "speaker": "玛莎",
                    "text": "他平时念叨的事情也让人半懂不懂的，什么「会动的石像」，什么「墙中的声音」…唉，果然还是应该让康塔莉妮小姐去调查一下…"
                }
            ]
        },
        {
            "talkId": "6534204",
            "initDialog": "653420401",
            "dialogues": [
                {
                    "id": "653420401",
                    "speaker": "Player",
                    "text": "莫塞是…"
                },
                {
                    "id": "653420402",
                    "speaker": "玛莎",
                    "text": "唉，让你见笑了。莫塞是我家那个调皮的儿子。"
                },
                {
                    "id": "653420403",
                    "speaker": "玛莎",
                    "text": "自从乔瓦尼给他讲了他叔叔当年出海去须弥的事情，他就一天也没有安生过，满脑子想着什么冒险和远征…"
                },
                {
                    "id": "653420404",
                    "speaker": "玛莎",
                    "text": "要是他被那个可疑的须弥人吸引，然后，然后…啊啊，我都不敢想下去了！"
                }
            ]
        }
    ]
}