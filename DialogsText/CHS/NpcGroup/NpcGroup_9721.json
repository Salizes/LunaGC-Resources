    "talks": [
        {
            "talkId": "6972101",
            "initDialog": "697210101",
            "dialogues": [
                {
                    "id": "697210101",
                    "speaker": "马鲁夫",
                    "text": "看着酒馆里的各位喜笑颜开，我更加确定了——这「七圣召唤」是让人心情愉快的秘方。"
                },
                {
                    "id": "697210102",
                    "speaker": "马鲁夫",
                    "text": "我要好好研究，怎么让这一剂药方对病人发挥最大的功效…"
                }
            ]
        },
        {
            "talkId": "6972102",
            "initDialog": "697210201",
            "dialogues": [
                {
                    "id": "697210201",
                    "speaker": "Player",
                    "text": "来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6972103",
            "initDialog": "697210301",
            "dialogues": [
                {
                    "id": "697210301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "697210302",
                    "speaker": "马鲁夫",
                    "text": "那就祝你身体健康，心情愉快！"
                }
            ]
        },
        {
            "talkId": "6972104",
            "initDialog": "697210401",
            "dialogues": [
                {
                    "id": "697210401",
                    "speaker": "马鲁夫",
                    "text": "谢谢你，这是一次愉快的对局！"
                }
            ]
        },
        {
            "talkId": "6972105",
            "initDialog": "697210501",
            "dialogues": [
                {
                    "id": "697210501",
                    "speaker": "马鲁夫",
                    "text": "我从你的牌路中感觉到了一股畅快和热情…希望病人们也能玩得这样开心！"
                }
            ]
        }
    ]
}