{
    "groupId": "2308",
    "total_dialogue_lines": 23,
    "speaker_counts": {
        "Player": 6,
        "小六": 17
    },
    "talks": [
        {
            "talkId": "6230806",
            "initDialog": "623080601",
            "dialogues": [
                {
                    "id": "623080601",
                    "speaker": "Player",
                    "text": "决斗对局"
                }
            ]
        },
        {
            "talkId": "6230807",
            "initDialog": "623080701",
            "dialogues": [
                {
                    "id": "623080701",
                    "speaker": "小六",
                    "text": "嘿嘿，我赢了！就算是大人，打牌也没什么了不起的！"
                }
            ]
        },
        {
            "talkId": "6230808",
            "initDialog": "623080801",
            "dialogues": [
                {
                    "id": "623080801",
                    "speaker": "小六",
                    "text": "呜…这次不算，下次我会赢的！"
                }
            ]
        },
        {
            "talkId": "7192401",
            "initDialog": "719240101",
            "dialogues": [
                {
                    "id": "719240101",
                    "speaker": "Player",
                    "text": "没有神之眼也可以冒险的。"
                },
                {
                    "id": "719240102",
                    "speaker": "小六",
                    "text": "你是想说侠客之类吗？我才不要呢！"
                },
                {
                    "id": "719240103",
                    "speaker": "小六",
                    "text": "庄里的老人听说我喜欢冒险的故事，给我找了很多侠客的书…"
                },
                {
                    "id": "719240104",
                    "speaker": "小六",
                    "text": "但我看过才发现，主人公全都是些臭男人嘛！我才不喜欢这种故事呢！"
                },
                {
                    "id": "719240105",
                    "speaker": "小六",
                    "text": "…你没看过？那就拿走吧，反正我可不想当侠客！"
                }
            ]
        },
        {
            "talkId": "6230801",
            "initDialog": "623080101",
            "dialogues": [
                {
                    "id": "623080101",
                    "speaker": "小六",
                    "text": "喂，看起来很像冒险家的人，你有神之眼吗？"
                }
            ]
        },
        {
            "talkId": "6230802",
            "initDialog": "623080201",
            "dialogues": [
                {
                    "id": "623080201",
                    "speaker": "Player",
                    "text": "没有。"
                },
                {
                    "id": "623080202",
                    "speaker": "小六",
                    "text": "那就麻烦了，没有神之眼的冒险者是没办法被人记住的。"
                },
                {
                    "id": "623080203",
                    "speaker": "小六",
                    "text": "要问为什么的话，有神之眼才能使用元素的力量，才能惩奸除恶，才能高人一等！"
                },
                {
                    "id": "623080204",
                    "speaker": "小六",
                    "text": "反正好处可多了，书上都写着的，书里记下来的著名冒险家都有神之眼。"
                },
                {
                    "id": "623080205",
                    "speaker": "小六",
                    "text": "你连神之眼都没有，就别做什么英雄梦了吧。"
                }
            ]
        },
        {
            "talkId": "6230803",
            "initDialog": "623080301",
            "dialogues": [
                {
                    "id": "623080301",
                    "speaker": "Player",
                    "text": "为什么在乎神之眼？"
                },
                {
                    "id": "623080302",
                    "speaker": "小六",
                    "text": "因为我也想得到神之眼啊。"
                },
                {
                    "id": "623080303",
                    "speaker": "小六",
                    "text": "有了神之眼就能有地位和钱，有了钱爸爸妈妈就会回村子，不用留在璃月港了。"
                },
                {
                    "id": "623080304",
                    "speaker": "小六",
                    "text": "我把神之眼的事告诉其他小朋友以后，他们都很想要呢。"
                }
            ]
        },
        {
            "talkId": "6230804",
            "initDialog": "623080401",
            "dialogues": [
                {
                    "id": "623080401",
                    "speaker": "Player",
                    "text": "不告诉你。"
                },
                {
                    "id": "623080402",
                    "speaker": "小六",
                    "text": "哼，什么嘛，又不是没见过。"
                }
            ]
        },
        {
            "talkId": "6230805",
            "initDialog": "623080206",
            "dialogues": [
                {
                    "id": "623080206",
                    "speaker": "Player",
                    "text": "但我能操控元素。"
                },
                {
                    "id": "623080207",
                    "speaker": "小六",
                    "text": "不可能，少骗人了，我读了这么多的书也没有听说过有这种事。"
                },
                {
                    "id": "623080208",
                    "speaker": "小六",
                    "text": "别以为我是小孩子，你就可以骗我…"
                }
            ]
        }
    ]
}