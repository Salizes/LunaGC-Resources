    },
    "talks": [
        {
            "talkId": "6782401",
            "initDialog": "678240101",
            "dialogues": [
                {
                    "id": "678240101",
                    "speaker": "韦杰涅耶夫",
                    "text": "报纸，最新的报纸！来一份看看吧，最新的消息…虽然不是最有趣的消息…"
                }
            ]
        },
        {
            "talkId": "6782402",
            "initDialog": "678240201",
            "dialogues": [
                {
                    "id": "678240201",
                    "speaker": "Player",
                    "text": "那什么才是最有趣的消息？"
                },
                {
                    "id": "678240202",
                    "speaker": "韦杰涅耶夫",
                    "text": "最有趣的消息，那就要说炉灰区有人用绳子抓住了一只背上长出克什尼克晶矿的虫子的事啦。"
                },
                {
                    "id": "678240203",
                    "speaker": "韦杰涅耶夫",
                    "text": "抓到虫子的家伙牵着虫子在炉灰区逛了好几圈，大家都想看看呢…"
                }
            ]
        },
        {
            "talkId": "6782403",
            "initDialog": "678240301",
            "dialogues": [
                {
                    "id": "678240301",
                    "speaker": "Player",
                    "text": "有什么新消息？"
                },
                {
                    "id": "678240302",
                    "speaker": "韦杰涅耶夫",
                    "text": "呃有关于…这个皇都评蚁会的最新决策…也许他们发现了什么新的蚂蚁…"
                },
                {
                    "id": "678240303",
                    "speaker": "韦杰涅耶夫",
                    "text": "还有…还有这个，这个铁路运书局的标志，一定是他们又从哪里运了很多书…"
                }
            ]
        },
        {
            "talkId": "6782404",
            "initDialog": "678240401",
            "dialogues": [
                {
                    "id": "678240401",
                    "speaker": "Player",
                    "text": "不用了…"
                },
                {
                    "id": "678240402",
                    "speaker": "韦杰涅耶夫",
                    "text": "好吧…其实我也不知道报纸有什么好看的…"
                }
            ]
        }
    ]
}