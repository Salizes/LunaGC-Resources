    "talks": [
        {
            "talkId": "4006354",
            "initDialog": "400635401",
            "dialogues": [
                {
                    "id": "400635401",
                    "speaker": "画像板",
                    "text": "（用来绘制五歌仙画像的空白画板，不久后就将被绘制上精美的画像。）"
                }
            ]
        },
        {
            "talkId": "4006355",
            "initDialog": "400635501",
            "dialogues": [
                {
                    "id": "400635501",
                    "speaker": "黑主像",
                    "text": "（阿贝多绘制的黑主画像，但现在画面却被布遮住了。）"
                },
                {
                    "id": "400635502",
                    "speaker": "黑主像",
                    "text": "（看来只有等到揭幕式的时候，才能看到上面的内容了。）"
                }
            ]
        },
        {
            "talkId": "4006358",
            "initDialog": "400635801",
            "dialogues": [
                {
                    "id": "400635801",
                    "speaker": "黑主像",
                    "text": "（阿贝多绘制的黑主画像，但画面上却只绘制了背景，并没有人物。）"
                },
                {
                    "id": "400635802",
                    "speaker": "黑主像",
                    "text": "（阿贝多说希望将这份想象留给大家。或许在你心里，也存在着一个清晰的形象…）"
                }
            ]
        },
        {
            "talkId": "4006359",
            "initDialog": "400635901",
            "dialogues": [
                {
                    "id": "400635901",
                    "speaker": "黑主像",
                    "text": "（阿贝多绘制的黑主画像。）"
                },
                {
                    "id": "400635902",
                    "speaker": "黑主像",
                    "text": "（上面用特殊的墨水绘制了「国崩」的形象，只有在画面沾水时才能看到。）"
                },
                {
                    "id": "400635903",
                    "speaker": "黑主像",
                    "text": "（听绫人的意思，曾经鬼鬼祟祟前来寻找秘密的人是愚人众的密探。但究竟是「谁」在试图隐藏他的过去？）"
                },
                {
                    "id": "400635904",
                    "speaker": "黑主像",
                    "text": "（他的「秘密」，也会对你的命运产生影响吗…）"
                }
            ]
        }
    ]
}