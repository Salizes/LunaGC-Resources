{
    "groupId": "9085",
    "total_dialogue_lines": 69,
    "speaker_counts": {
        "Player": 18,
        "菲米尼": 51
    },
    "talks": [
        {
            "talkId": "6908501",
            "initDialog": "690850101",
            "dialogues": [
                {
                    "id": "690850101",
                    "speaker": "菲米尼",
                    "text": "……"
                },
                {
                    "id": "690850102",
                    "speaker": "菲米尼",
                    "text": "我在。"
                }
            ]
        },
        {
            "talkId": "6908502",
            "initDialog": "690850201",
            "dialogues": [
                {
                    "id": "690850201",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                },
                {
                    "id": "690850202",
                    "speaker": "菲米尼",
                    "text": "嗯。"
                },
                {
                    "id": "690850203",
                    "speaker": "菲米尼",
                    "text": "……"
                },
                {
                    "id": "690850204",
                    "speaker": "菲米尼",
                    "text": "我是说…我很习惯，一切都好，不用为我担心。",
                    "choices": [
                        {
                            "id": "690850205",
                            "text": "你不用那么拘谨。",
                            "response": [
                                {
                                    "id": "690850206",
                                    "speaker": "菲米尼",
                                    "text": "对不起…"
                                },
                                {
                                    "id": "690850207",
                                    "speaker": "菲米尼",
                                    "text": "我怕什么想法都往外说的话，会让听的人产生不必要的误解。"
                                },
                                {
                                    "id": "690850210",
                                    "speaker": "菲米尼",
                                    "text": "……"
                                },
                                {
                                    "id": "690850211",
                                    "speaker": "菲米尼",
                                    "text": "…好吧，那我遵从你的意愿。"
                                },
                                {
                                    "id": "690850212",
                                    "speaker": "菲米尼",
                                    "text": "其实，我…我有点想家。"
                                },
                                {
                                    "id": "690850213",
                                    "speaker": "菲米尼",
                                    "text": "虽然住得很舒适，环境无可挑剔，但我暂时还没法…彻底融入这里的生活。"
                                },
                                {
                                    "id": "690850214",
                                    "speaker": "菲米尼",
                                    "text": "这是我自己的问题…请你不要误会成我对你或这个地方有任何的不满。"
                                },
                                {
                                    "id": "690850215",
                                    "speaker": "菲米尼",
                                    "text": "…也请你原谅我。"
                                }
                            ]
                        },
                        {
                            "id": "690850208",
                            "text": "你可以实话实说。",
                            "response": [
                                {
                                    "id": "690850209",
                                    "speaker": "菲米尼",
                                    "text": "哈…你希望我如此吗？"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908503",
            "initDialog": "690850301",
            "dialogues": [
                {
                    "id": "690850301",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                },
                {
                    "id": "690850302",
                    "speaker": "菲米尼",
                    "text": "嗯…请说吧。"
                },
                {
                    "id": "690850303",
                    "speaker": "Player",
                    "text": "聊聊佩伊怎么样？"
                },
                {
                    "id": "690850304",
                    "speaker": "菲米尼",
                    "text": "…谢谢你，能够记住它的名字。",
                    "choices": [
                        {
                            "id": "690850305",
                            "text": "它的名字有什么来历吗？",
                            "response": [
                                {
                                    "id": "690850307",
                                    "speaker": "菲米尼",
                                    "text": "要解释的话…就得提到很久很久以前，我在绘本上读到的故事了。"
                                },
                                {
                                    "id": "690850308",
                                    "speaker": "Player",
                                    "text": "想听！"
                                },
                                {
                                    "id": "690850309",
                                    "speaker": "菲米尼",
                                    "text": "嗯…说在遥远的海滨小镇，生活着一只黑白相间的海鸟。"
                                },
                                {
                                    "id": "690850310",
                                    "speaker": "菲米尼",
                                    "text": "它生来就不会飞翔，走路歪歪扭扭，说话结结巴巴，因此遭到了其他海鸟的排挤。"
                                },
                                {
                                    "id": "690850311",
                                    "speaker": "菲米尼",
                                    "text": "直到后来有一天，贪婪的海盗从水下宫殿偷走了镶满珍珠和黄金的冠冕…"
                                },
                                {
                                    "id": "690850312",
                                    "speaker": "菲米尼",
                                    "text": "转眼间，电闪雷鸣，眼看海啸即将吞灭陆地…"
                                },
                                {
                                    "id": "690850313",
                                    "speaker": "菲米尼",
                                    "text": "黑白的海鸟纵身一跃，却依旧无法飞翔…舍命之举使它撞断了桅杆，连同破船一起沉入海中。"
                                },
                                {
                                    "id": "690850314",
                                    "speaker": "菲米尼",
                                    "text": "盘旋的海鸟都以为它会就此溺于水中，却没想到，在海里，它游得比谁都快。"
                                },
                                {
                                    "id": "690850315",
                                    "speaker": "菲米尼",
                                    "text": "它游啊游，一直游到筋疲力尽。它终于将冠冕归还了原处。顷刻间风平浪静，仿佛一切都不曾发生。"
                                },
                                {
                                    "id": "690850316",
                                    "speaker": "菲米尼",
                                    "text": "恐怕你已经猜到了…故事里的海鸟就叫「佩伊」，它是一只意外来到小镇的企鹅。",
                                    "choices": [
                                        {
                                            "id": "690850317",
                                            "text": "真是个不错的故事。",
                                            "response": [
                                                {
                                                    "id": "690850320",
                                                    "speaker": "菲米尼",
                                                    "text": "我很崇敬故事里的「佩伊」，但读完之后，却深切地感到…它很孤独…"
                                                },
                                                {
                                                    "id": "690850321",
                                                    "speaker": "菲米尼",
                                                    "text": "所以，我想跟它相互依偎，相互取暖…"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690850318",
                                            "text": "原来你是英雄的同伴！",
                                            "response": [
                                                {
                                                    "id": "690850319",
                                                    "speaker": "菲米尼",
                                                    "text": "…哈，是啊。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690850306",
                            "text": "它为什么是这个外形呢？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908504",
            "initDialog": "690850401",
            "dialogues": [
                {
                    "id": "690850401",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                },
                {
                    "id": "690850402",
                    "speaker": "菲米尼",
                    "text": "嗯…等你有空，可以请你陪我去几个地方吗？"
                },
                {
                    "id": "690850403",
                    "speaker": "菲米尼",
                    "text": "勒波特钟表店、博蒙特工坊还有瓦萨里回廊…",
                    "choices": [
                        {
                            "id": "690850404",
                            "text": "当然可以啊。",
                            "response": [
                                {
                                    "id": "690850406",
                                    "speaker": "菲米尼",
                                    "text": "嗯…我想去看看发条工艺品，还有各式各样的机械装置。"
                                },
                                {
                                    "id": "690850407",
                                    "speaker": "菲米尼",
                                    "text": "平日里我常去的是莱舒的发条工坊，但路过其他店的时候，总免不了好奇…"
                                },
                                {
                                    "id": "690850408",
                                    "speaker": "菲米尼",
                                    "text": "深处的橱柜藏着怎样的商品？会不会有什么既新鲜又精巧的设计？"
                                },
                                {
                                    "id": "690850409",
                                    "speaker": "菲米尼",
                                    "text": "真想一件不落地看下来！可是…唉…"
                                },
                                {
                                    "id": "690850410",
                                    "speaker": "菲米尼",
                                    "text": "我不太擅长和人打交道…如果闷声看了半天却是只看不买，肯定会被店家讨厌的。"
                                },
                                {
                                    "id": "690850411",
                                    "speaker": "菲米尼",
                                    "text": "那个时候，就需要麻烦你…",
                                    "choices": [
                                        {
                                            "id": "690850412",
                                            "text": "帮你解释？",
                                            "response": [
                                                {
                                                    "id": "690850413",
                                                    "speaker": "菲米尼",
                                                    "text": "嗯…对的。我知道这样很为难…但…"
                                                },
                                                {
                                                    "id": "690850417",
                                                    "speaker": "菲米尼",
                                                    "text": "我会报答你的！只要我力所能及…"
                                                },
                                                {
                                                    "id": "690850418",
                                                    "speaker": "Player",
                                                    "text": "没问题。"
                                                },
                                                {
                                                    "id": "690850419",
                                                    "speaker": "菲米尼",
                                                    "text": "太好了！…简直像做梦一样。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690850414",
                                            "text": "帮你买下来？",
                                            "response": [
                                                {
                                                    "id": "690850415",
                                                    "speaker": "菲米尼",
                                                    "text": "欸？！当、当然不是这个意思…"
                                                },
                                                {
                                                    "id": "690850416",
                                                    "speaker": "菲米尼",
                                                    "text": "你只要帮我解释两句就好了…"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690850405",
                            "text": "是有什么想逛的吗？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6908505",
            "initDialog": "690850501",
            "dialogues": [
                {
                    "id": "690850501",
                    "speaker": "Player",
                    "text": "早啊，菲米尼。"
                },
                {
                    "id": "690850502",
                    "speaker": "菲米尼",
                    "text": "早。"
                },
                {
                    "id": "690850503",
                    "speaker": "菲米尼",
                    "text": "没有特殊指派的话，我就原地待命了。"
                }
            ]
        },
        {
            "talkId": "6908506",
            "initDialog": "690850601",
            "dialogues": [
                {
                    "id": "690850601",
                    "speaker": "Player",
                    "text": "晚安，菲米尼。"
                },
                {
                    "id": "690850602",
                    "speaker": "菲米尼",
                    "text": "#晚安，{NICKNAME}。"
                },
                {
                    "id": "690850603",
                    "speaker": "菲米尼",
                    "text": "「愿你的梦境如海上星空般璀璨绮丽，而无梦之夜唯有安详。」"
                }
            ]
        },
        {
            "talkId": "6908510",
            "initDialog": "690851001",
            "dialogues": [
                {
                    "id": "690851001",
                    "speaker": "菲米尼",
                    "text": "这种建筑，还有这些圆圆的小灯，都是海沫村的风格吧？我在画册上见过。"
                },
                {
                    "id": "690851002",
                    "speaker": "菲米尼",
                    "text": "我一直相信那个传说：美露莘的家乡是位于水底的一座小村庄，那里与世无争，就像童话里的村落一样。"
                },
                {
                    "id": "690851003",
                    "speaker": "菲米尼",
                    "text": "那个…还请不要对别人讲。这种想法…可能其他人听了会觉得幼稚吧…"
                }
            ]
        },
        {
            "talkId": "6908511",
            "initDialog": "690851101",
            "dialogues": [
                {
                    "id": "690851101",
                    "speaker": "菲米尼",
                    "text": "这种储能炉其实可以再加装一层炉芯，比商家宣传的更耐用。"
                },
                {
                    "id": "690851102",
                    "speaker": "菲米尼",
                    "text": "还有这种风扇，它的电机一直在以临界转速工作，这样不够安全…"
                },
                {
                    "id": "690851103",
                    "speaker": "菲米尼",
                    "text": "抱歉！一说到这些，我就变得忘乎所以。如果你允许，我…我保证可以把它们调整得更加合适！尽我所能…"
                }
            ]
        }
    ]
}