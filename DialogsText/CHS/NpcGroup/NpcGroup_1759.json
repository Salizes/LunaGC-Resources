{
    "groupId": "1759",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "杨轸": 8
    },
    "talks": [
        {
            "talkId": "6175901",
            "initDialog": "617590101",
            "dialogues": [
                {
                    "id": "617590101",
                    "speaker": "杨轸",
                    "text": "好想吃万民堂的烤吃虎鱼啊…"
                }
            ]
        },
        {
            "talkId": "6175902",
            "initDialog": "617590201",
            "dialogues": [
                {
                    "id": "617590201",
                    "speaker": "Player",
                    "text": "万民堂？"
                },
                {
                    "id": "617590202",
                    "speaker": "杨轸",
                    "text": "看您的装束…应该是位旅行者吧。不知道您有没有去过万民堂…"
                },
                {
                    "id": "617590203",
                    "speaker": "杨轸",
                    "text": "实不相瞒，我实在是想念家乡的口味。唉，可惜啊，我目前回不去喽。"
                }
            ]
        },
        {
            "talkId": "6175903",
            "initDialog": "617590301",
            "dialogues": [
                {
                    "id": "617590301",
                    "speaker": "Player",
                    "text": "希望你早日吃上。"
                },
                {
                    "id": "617590302",
                    "speaker": "杨轸",
                    "text": "借您吉言。"
                }
            ]
        },
        {
            "talkId": "6175904",
            "initDialog": "617590401",
            "dialogues": [
                {
                    "id": "617590401",
                    "speaker": "Player",
                    "text": "为什么回不去？"
                },
                {
                    "id": "617590402",
                    "speaker": "杨轸",
                    "text": "唉…说来惭愧，我是璃月的茶叶商人，平日里做些海运的生意。"
                },
                {
                    "id": "617590403",
                    "speaker": "杨轸",
                    "text": "未曾想，先前在海上遭了风暴，货物损失大半…待运到荆夫港的时候，连成本都没能收回来。"
                },
                {
                    "id": "617590404",
                    "speaker": "杨轸",
                    "text": "我不想就这么灰溜溜地回去，所以想在这地方先做些别的买卖，至少先赚回本钱。只是…"
                },
                {
                    "id": "617590405",
                    "speaker": "杨轸",
                    "text": "罢了。不过是无用的牢骚，我也不过是馋烤吃虎鱼罢了。让您见笑了。"
                }
            ]
        }
    ]
}