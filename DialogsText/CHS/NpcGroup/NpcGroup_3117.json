{
    "groupId": "3117",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "大泉": 14
    },
    "talks": [
        {
            "talkId": "6311701",
            "initDialog": "631170101",
            "dialogues": [
                {
                    "id": "631170101",
                    "speaker": "大泉",
                    "text": "你…你不是幕府的人吧？"
                },
                {
                    "id": "631170102",
                    "speaker": "大泉",
                    "text": "嗯，看起来也不像。"
                },
                {
                    "id": "631170103",
                    "speaker": "大泉",
                    "text": "你如果是幕府的走狗，我绝不会手下留情。"
                }
            ]
        },
        {
            "talkId": "6311702",
            "initDialog": "631170201",
            "dialogues": [
                {
                    "id": "631170201",
                    "speaker": "Player",
                    "text": "你很讨厌幕府？"
                },
                {
                    "id": "631170202",
                    "speaker": "大泉",
                    "text": "当然了。如果不恨幕府，怎么会加入反抗军呢？"
                },
                {
                    "id": "631170203",
                    "speaker": "大泉",
                    "text": "我早就看不惯幕府的各种行径了，正事不干，就只知道高额收税，压迫老百姓的生活。「眼狩令」只是导火索罢了，大家对他们的怨念绝不止于此。"
                },
                {
                    "id": "631170204",
                    "speaker": "大泉",
                    "text": "自从开战以来，总是打上几次就要修整一番，也不知什么时候才能取得胜利。"
                },
                {
                    "id": "631170205",
                    "speaker": "大泉",
                    "text": "因为不能违抗军令，即便我想把幕府一口气干掉也没用。现在只能作为前线的侦察兵，持续观察幕府军的动向了。"
                }
            ]
        },
        {
            "talkId": "6311703",
            "initDialog": "631170301",
            "dialogues": [
                {
                    "id": "631170301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631170302",
                    "speaker": "大泉",
                    "text": "嗯，要小心幕府的人哦。"
                }
            ]
        },
        {
            "talkId": "6311704",
            "initDialog": "631170401",
            "dialogues": [
                {
                    "id": "631170401",
                    "speaker": "大泉",
                    "text": "唉，你也听说了幕府和珊瑚宫谈和的事情吧。"
                },
                {
                    "id": "631170402",
                    "speaker": "大泉",
                    "text": "说实话，对这样的结果，我很失望…"
                }
            ]
        },
        {
            "talkId": "6311705",
            "initDialog": "631170501",
            "dialogues": [
                {
                    "id": "631170501",
                    "speaker": "Player",
                    "text": "为什么？"
                },
                {
                    "id": "631170502",
                    "speaker": "大泉",
                    "text": "幕府压迫民众的种种行径历历在目，怎么能就这样算了？"
                },
                {
                    "id": "631170503",
                    "speaker": "大泉",
                    "text": "锁国令、眼狩令…哪一件不让大家痛苦万分。不能为了祈求短暂的和平，就忘记幕府的所作所为啊。"
                },
                {
                    "id": "631170504",
                    "speaker": "大泉",
                    "text": "更何况以我对幕府的了解，他们也不会善罢甘休的。所以我们也一定要保持警惕，有朝一日必须让幕府付出代价。"
                }
            ]
        },
        {
            "talkId": "6311706",
            "initDialog": "631170601",
            "dialogues": [
                {
                    "id": "631170601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "631170602",
                    "speaker": "大泉",
                    "text": "嗯，还是要小心幕府啊。"
                }
            ]
        }
    ]
}