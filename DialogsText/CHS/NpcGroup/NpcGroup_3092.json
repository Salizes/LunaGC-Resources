{
    "groupId": "3092",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "中野": 12
    },
    "talks": [
        {
            "talkId": "6309201",
            "initDialog": "630920101",
            "dialogues": [
                {
                    "id": "630920101",
                    "speaker": "中野",
                    "text": "啊，你好，有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6309202",
            "initDialog": "630920201",
            "dialogues": [
                {
                    "id": "630920201",
                    "speaker": "Player",
                    "text": "在看风景吗？"
                },
                {
                    "id": "630920202",
                    "speaker": "中野",
                    "text": "是啊。这片大海，和照耀着海面的阳光，都是我每日看惯的景色。"
                },
                {
                    "id": "630920203",
                    "speaker": "中野",
                    "text": "看你年轻，可能还不知道，四十岁时看到的景象和二十岁相比，其实没有多少差别…"
                },
                {
                    "id": "630920204",
                    "speaker": "中野",
                    "text": "每天看着太阳东升西落，海浪奔流，似乎能理解将军大人所追寻的「永恒」了…"
                }
            ]
        },
        {
            "talkId": "6309203",
            "initDialog": "630920301",
            "dialogues": [
                {
                    "id": "630920301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630920302",
                    "speaker": "中野",
                    "text": "嗯，再见，好好享受生活吧。"
                }
            ]
        },
        {
            "talkId": "6309204",
            "initDialog": "630920401",
            "dialogues": [
                {
                    "id": "630920401",
                    "speaker": "Player",
                    "text": "「永恒」…"
                },
                {
                    "id": "630920402",
                    "speaker": "中野",
                    "text": "我一介平民，妄图体会将军大人心中的「永恒」，似乎有些僭越了。"
                },
                {
                    "id": "630920403",
                    "speaker": "中野",
                    "text": "只是我已年近半百，仍和年轻时一样还是一个普普通通的武士，不免为这平庸的生活心生感慨啊。"
                },
                {
                    "id": "630920404",
                    "speaker": "中野",
                    "text": "现在看来，年轻气盛时的那些争斗真是毫无意义，还不如就这么望着大海，度过这短暂又平凡的一生…"
                }
            ]
        },
        {
            "talkId": "7291001",
            "initDialog": "729100101",
            "dialogues": [
                {
                    "id": "729100101",
                    "speaker": "Player",
                    "text": "但我还不能停下。"
                },
                {
                    "id": "729100102",
                    "speaker": "中野",
                    "text": "哦哦，年轻人，看起来你心中还有未尽的愿望啊。"
                },
                {
                    "id": "729100103",
                    "speaker": "中野",
                    "text": "嗯…能为了自己的心愿勇往直前，也不错。"
                },
                {
                    "id": "729100104",
                    "speaker": "中野",
                    "text": "这把弓，是我年轻时的友人赠与我的礼物…结果直到今天也没能等到拉开的机会。"
                },
                {
                    "id": "729100105",
                    "speaker": "中野",
                    "text": "留在我手上也没什么用处，不如送给你吧。如果能祝你一臂之力，也算是物尽其用了。"
                }
            ]
        }
    ]
}