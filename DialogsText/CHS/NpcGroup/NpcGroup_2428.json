{
    "groupId": "2428",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 4,
        "星火": 7
    },
    "talks": [
        {
            "talkId": "6242801",
            "initDialog": "624280101",
            "dialogues": [
                {
                    "id": "624280101",
                    "speaker": "星火",
                    "text": "…唉，嗯？你好，旅行者，请问需要帮助吗？"
                }
            ]
        },
        {
            "talkId": "6242802",
            "initDialog": "624280201",
            "dialogues": [
                {
                    "id": "624280201",
                    "speaker": "Player",
                    "text": "你在困扰什么？"
                },
                {
                    "id": "624280202",
                    "speaker": "星火",
                    "text": "…唉，你自己看不出来吗？"
                },
                {
                    "id": "624280203",
                    "speaker": "星火",
                    "text": "旁边那位总是学我说话，快把我烦死了。",
                    "choices": [
                        {
                            "id": "624280204",
                            "text": "他是你的朋友吗？",
                            "response": [
                                {
                                    "id": "624280205",
                                    "speaker": "星火",
                                    "text": "唔…算是吧。我们认识挺久了。"
                                }
                            ]
                        },
                        {
                            "id": "624280206",
                            "text": "他为什么学你说话？",
                            "response": [
                                {
                                    "id": "624280207",
                                    "speaker": "星火",
                                    "text": "原来他只是说话结巴，但前些年来了一个叫艾莉丝的旅行家，给他了一瓶药水…"
                                },
                                {
                                    "id": "624280208",
                                    "speaker": "星火",
                                    "text": "然后结巴治好了，但他开始不受控制地学别人说话了…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6242803",
            "initDialog": "624280301",
            "dialogues": [
                {
                    "id": "624280301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624280302",
                    "speaker": "星火",
                    "text": "再见，旅行者。"
                }
            ]
        }
    ]
}