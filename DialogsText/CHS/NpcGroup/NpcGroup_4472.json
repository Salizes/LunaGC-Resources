    "talks": [
        {
            "talkId": "6447201",
            "initDialog": "644720101",
            "dialogues": [
                {
                    "id": "644720101",
                    "speaker": "肯莎",
                    "text": "不知你是否听说过，「缄默之殿」这一机构最初是赫曼努比斯大人建立的。"
                },
                {
                    "id": "644720102",
                    "speaker": "肯莎",
                    "text": "他是赤王阿赫玛尔大人的祭司。"
                },
                {
                    "id": "644720103",
                    "speaker": "肯莎",
                    "text": "而在当时，祭司这一职务大多由提纳勒人担任，这也是为什么后来祭司们都佩戴那种形式的帽子。"
                },
                {
                    "id": "644720104",
                    "speaker": "肯莎",
                    "text": "缅怀与纪念对我们而言…非常重要。"
                }
            ]
        }
    ]
}