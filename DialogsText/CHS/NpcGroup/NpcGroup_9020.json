{
    "groupId": "9020",
    "total_dialogue_lines": 62,
    "speaker_counts": {
        "Player": 18,
        "雷泽": 44
    },
    "talks": [
        {
            "talkId": "6902001",
            "initDialog": "690200101",
            "dialogues": [
                {
                    "id": "690200101",
                    "speaker": "雷泽",
                    "text": "#{NICKNAME}，你好。"
                },
                {
                    "id": "690200102",
                    "speaker": "雷泽",
                    "text": "是在，找我吗？"
                }
            ]
        },
        {
            "talkId": "6902002",
            "initDialog": "690200201",
            "dialogues": [
                {
                    "id": "690200201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690200701",
                    "speaker": "雷泽",
                    "text": "习惯。"
                },
                {
                    "id": "690200702",
                    "speaker": "雷泽",
                    "text": "这里的气味，你的气味。"
                },
                {
                    "id": "690200703",
                    "speaker": "雷泽",
                    "text": "很安全。很好。",
                    "choices": [
                        {
                            "id": "690200704",
                            "text": "我的气味是怎样的？",
                            "response": [
                                {
                                    "id": "690200705",
                                    "speaker": "雷泽",
                                    "text": "星星…大海…风车菊…"
                                },
                                {
                                    "id": "690200708",
                                    "speaker": "雷泽",
                                    "text": "跟你一起，在这个家，开心。"
                                }
                            ]
                        },
                        {
                            "id": "690200706",
                            "text": "雷泽适应就好。",
                            "response": [
                                {
                                    "id": "690200707",
                                    "speaker": "雷泽",
                                    "text": "适…应…？嗯…适应。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902003",
            "initDialog": "690200301",
            "dialogues": [
                {
                    "id": "690200301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690200801",
                    "speaker": "雷泽",
                    "text": "对不起，我不太会，聊天。"
                },
                {
                    "id": "690200802",
                    "speaker": "雷泽",
                    "text": "说话，很难。找到意思，很难。",
                    "choices": [
                        {
                            "id": "690200803",
                            "text": "没关系，我能理解雷泽的意思。",
                            "response": [
                                {
                                    "id": "690200804",
                                    "speaker": "雷泽",
                                    "text": "嗯…你很强。"
                                },
                                {
                                    "id": "690200807",
                                    "speaker": "雷泽",
                                    "text": "好。我会努力多说话。"
                                },
                                {
                                    "id": "690200808",
                                    "speaker": "雷泽",
                                    "text": "……"
                                },
                                {
                                    "id": "690200809",
                                    "speaker": "雷泽",
                                    "text": "比起地板，喜欢草坪。"
                                },
                                {
                                    "id": "690200810",
                                    "speaker": "雷泽",
                                    "text": "地板，很大，但是很硬。草坪，更大。但是好闻。",
                                    "choices": [
                                        {
                                            "id": "690200811",
                                            "text": "这里要用「而且」…",
                                            "response": [
                                                {
                                                    "id": "690200813",
                                                    "speaker": "雷泽",
                                                    "text": "嗯！而且好闻…"
                                                },
                                                {
                                                    "id": "690200814",
                                                    "speaker": "雷泽",
                                                    "text": "比起生的肉，喜欢你做的肉。"
                                                },
                                                {
                                                    "id": "690200815",
                                                    "speaker": "雷泽",
                                                    "text": "生的肉，有时候，拉肚子。你做的肉，很香，好吃。"
                                                },
                                                {
                                                    "id": "690200816",
                                                    "speaker": "雷泽",
                                                    "text": "想要…一直吃到你做的肉。"
                                                },
                                                {
                                                    "id": "690200817",
                                                    "speaker": "雷泽",
                                                    "text": "这样说，对吗？"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690200812",
                                            "text": "「而且好闻」…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690200805",
                            "text": "我来陪你一起练习。",
                            "response": [
                                {
                                    "id": "690200806",
                                    "speaker": "雷泽",
                                    "text": "练习？谢谢你。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902004",
            "initDialog": "690200401",
            "dialogues": [
                {
                    "id": "690200401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690200901",
                    "speaker": "雷泽",
                    "text": "我想，帮你看守。",
                    "choices": [
                        {
                            "id": "690200902",
                            "text": "是要看守我吗？",
                            "response": [
                                {
                                    "id": "690200903",
                                    "speaker": "雷泽",
                                    "text": "不对…你很强。不用看守。"
                                },
                                {
                                    "id": "690200904",
                                    "speaker": "雷泽",
                                    "text": "我想，看守。「家」。"
                                },
                                {
                                    "id": "690200907",
                                    "speaker": "雷泽",
                                    "text": "这里，一开始是你的家。"
                                },
                                {
                                    "id": "690200908",
                                    "speaker": "雷泽",
                                    "text": "我只是来，做客。"
                                },
                                {
                                    "id": "690200909",
                                    "speaker": "雷泽",
                                    "text": "但是，你是我的「卢皮卡」。"
                                },
                                {
                                    "id": "690200910",
                                    "speaker": "雷泽",
                                    "text": "这里也是我的家。"
                                },
                                {
                                    "id": "690200911",
                                    "speaker": "雷泽",
                                    "text": "我想为你看家。",
                                    "choices": [
                                        {
                                            "id": "690200912",
                                            "text": "这里不用看守也行哦。",
                                            "response": [
                                                {
                                                    "id": "690200914",
                                                    "speaker": "雷泽",
                                                    "text": "唔…你说行。就行。"
                                                },
                                                {
                                                    "id": "690200915",
                                                    "speaker": "雷泽",
                                                    "text": "那我，看守你。"
                                                },
                                                {
                                                    "id": "690200916",
                                                    "speaker": "雷泽",
                                                    "text": "不管你到哪里。如果有危险。"
                                                },
                                                {
                                                    "id": "690200917",
                                                    "speaker": "雷泽",
                                                    "text": "我会，冲过来，保护你。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690200913",
                                            "text": "我更想让雷泽来「看守」我。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690200905",
                            "text": "是要看守家吗？",
                            "response": [
                                {
                                    "id": "690200906",
                                    "speaker": "雷泽",
                                    "text": "对的。看守。「家」。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6902005",
            "initDialog": "690200501",
            "dialogues": [
                {
                    "id": "690200501",
                    "speaker": "Player",
                    "text": "早啊，雷泽。"
                },
                {
                    "id": "690201001",
                    "speaker": "雷泽",
                    "text": "嗯…早…"
                },
                {
                    "id": "690201002",
                    "speaker": "雷泽",
                    "text": "狩猎…奔跑。想我，就叫我。"
                }
            ]
        },
        {
            "talkId": "6902006",
            "initDialog": "690200601",
            "dialogues": [
                {
                    "id": "690200601",
                    "speaker": "Player",
                    "text": "晚安，雷泽。"
                },
                {
                    "id": "690201101",
                    "speaker": "雷泽",
                    "text": "#嗯…{NICKNAME}，晚安。"
                },
                {
                    "id": "690201102",
                    "speaker": "雷泽",
                    "text": "如果，睡不着，你可以叫我。"
                }
            ]
        },
        {
            "talkId": "6902012",
            "initDialog": "690201201",
            "dialogues": [
                {
                    "id": "690201201",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6902013",
            "initDialog": "690201301",
            "dialogues": [
                {
                    "id": "690201301",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6902014",
            "initDialog": "690201401",
            "dialogues": [
                {
                    "id": "690201401",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6902050",
            "initDialog": "690205001",
            "dialogues": [
                {
                    "id": "690205001",
                    "speaker": "雷泽",
                    "text": "村庄，属于人。"
                },
                {
                    "id": "690205002",
                    "speaker": "雷泽",
                    "text": "有的时候，想去看看，而且，有你在，不怕。"
                },
                {
                    "id": "690205003",
                    "speaker": "雷泽",
                    "text": "谢谢你，带我来。"
                }
            ]
        },
        {
            "talkId": "6902051",
            "initDialog": "690205101",
            "dialogues": [
                {
                    "id": "690205101",
                    "speaker": "雷泽",
                    "text": "厨房、食材…复杂，在林子里，我们不用这些。"
                },
                {
                    "id": "690205102",
                    "speaker": "雷泽",
                    "text": "但是我想学，土豆饼以外的，可以教我吗？"
                },
                {
                    "id": "690205103",
                    "speaker": "雷泽",
                    "text": "做出来，给你和「卢皮卡」吃。"
                }
            ]
        }
    ]
}