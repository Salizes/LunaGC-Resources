{
    "groupId": "21235",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "第一封信": 4,
        "第三封信": 6,
        "第二封信": 5
    },
    "talks": [
        {
            "talkId": "7400013",
            "initDialog": "740001301",
            "dialogues": [
                {
                    "id": "740001301",
                    "speaker": "Player",
                    "text": "（桌上有几封拆开的信…）",
                    "choices": [
                        {
                            "id": "740001302",
                            "text": "（读第一封信。）",
                            "response": [
                                {
                                    "id": "740001303",
                                    "speaker": "第一封信",
                                    "text": "「亲爱的恩肖先生，抱歉很久未能与您联络，出于某些原因，我搬到了『梅洛彼得堡』，并且已经在这里生活了很长时间。」"
                                },
                                {
                                    "id": "740001304",
                                    "speaker": "第一封信",
                                    "text": "「这里的生活也没那么糟！除了塔塞斯杂烩不如家里的好吃，也没有可爱动物的陪伴。」"
                                },
                                {
                                    "id": "740001305",
                                    "speaker": "第一封信",
                                    "text": "「但是有更棒的宝贝在我身边和我一起生活！说到这里，过一段时间我或许就能回家了。」"
                                },
                                {
                                    "id": "740001306",
                                    "speaker": "第一封信",
                                    "text": "「若您还愿意为我开门，请给我回一封短信吧！一句话就好，让我知道您的消息。」"
                                }
                            ]
                        },
                        {
                            "id": "740001307",
                            "text": "（读第二封信。）",
                            "response": [
                                {
                                    "id": "740001308",
                                    "speaker": "第二封信",
                                    "text": "「您没有给我回信，是还在生气吗？爸爸，听我说，不要生气，为什么要用别人的过错惩罚自己呢？」"
                                },
                                {
                                    "id": "740001309",
                                    "speaker": "第二封信",
                                    "text": "「您瞧，有错的是我，我知道自己有做得不对的地方。但这些都过去了，让我们重归于好吧。」"
                                },
                                {
                                    "id": "740001310",
                                    "speaker": "第二封信",
                                    "text": "「最近我的老毛病又犯了，这才又知道健康的日子有多幸福。希望您一切都好。」"
                                },
                                {
                                    "id": "740001311",
                                    "speaker": "第二封信",
                                    "text": "「如果您实在不愿意向我透露您的近况，至少给我讲讲王子、公主，还有勇士，它们都还好吗？」"
                                },
                                {
                                    "id": "740001312",
                                    "speaker": "第二封信",
                                    "text": "「期待您的来信。」"
                                }
                            ]
                        },
                        {
                            "id": "740001313",
                            "text": "（读第三封信。）",
                            "response": [
                                {
                                    "id": "740001314",
                                    "speaker": "第三封信",
                                    "text": "「爸爸，您可真是顽固。我决定现在就告诉您这个消息，原本是打算和您见面时再揭晓的。」"
                                },
                                {
                                    "id": "740001315",
                                    "speaker": "第三封信",
                                    "text": "「我的宝贝，她叫莉诺尔。她可爱极了，像岩缝里长出的小花，在没有阳光和雨露的地方也自顾自地顽强生长。」"
                                },
                                {
                                    "id": "740001316",
                                    "speaker": "第三封信",
                                    "text": "「我想带她回家，您一定也会喜欢她的！如果您还是不愿意为我开门，也请至少看看她，哪怕就一眼。」"
                                },
                                {
                                    "id": "740001317",
                                    "speaker": "第三封信",
                                    "text": "「之后我会带她去枫丹廷，我会努力工作！」"
                                },
                                {
                                    "id": "740001318",
                                    "speaker": "第三封信",
                                    "text": "「她还没有好好看过这个世界，所以等我们离开梅洛彼得堡，我要把全世界的阳光都送给她！」"
                                },
                                {
                                    "id": "740001319",
                                    "speaker": "第三封信",
                                    "text": "「卢茨不让我写太多，就先说到这里了。祝您身体健康！」"
                                }
                            ]
                        },
                        {
                            "id": "740001320",
                            "text": "（还是离开吧…）"
                        }
                    ]
                }
            ]
        }
    ]
}