{
    "groupId": "3175",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "直江久政": 12
    },
    "talks": [
        {
            "talkId": "6317501",
            "initDialog": "631750101",
            "dialogues": [
                {
                    "id": "631750101",
                    "speaker": "直江久政",
                    "text": "你好，如无要事，请不要在天守附近逗留闲逛。"
                }
            ]
        },
        {
            "talkId": "6317502",
            "initDialog": "631750201",
            "dialogues": [
                {
                    "id": "631750201",
                    "speaker": "Player",
                    "text": "这里是…"
                },
                {
                    "id": "631750202",
                    "speaker": "直江久政",
                    "text": "这里是天守，如你所见，位于稻妻城的至高之处，是最为尊崇的将军大人的居所。"
                },
                {
                    "id": "631750203",
                    "speaker": "直江久政",
                    "text": "将军大人位高权重，普治稻妻众生，闲杂人等不得叨扰。"
                }
            ]
        },
        {
            "talkId": "6317503",
            "initDialog": "631750301",
            "dialogues": [
                {
                    "id": "631750301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "631750302",
                    "speaker": "直江久政",
                    "text": "我负责天守及其附近的治安管理，维护将军大人居所的安定。"
                },
                {
                    "id": "631750303",
                    "speaker": "直江久政",
                    "text": "我和我所带领的将士只听命于将军大人一人，若你有什么诉求的话，还请去找三奉行的那些人吧。"
                }
            ]
        },
        {
            "talkId": "6317504",
            "initDialog": "631750401",
            "dialogues": [
                {
                    "id": "631750401",
                    "speaker": "Player",
                    "text": "关于三奉行…"
                },
                {
                    "id": "631750402",
                    "speaker": "直江久政",
                    "text": "你应该知道稻妻议事的三大奉行所吧。"
                },
                {
                    "id": "631750403",
                    "speaker": "直江久政",
                    "text": "勘定奉行，稻妻的财务中枢，为了让国家财政盆满钵满而不辞劳苦。"
                },
                {
                    "id": "631750404",
                    "speaker": "直江久政",
                    "text": "社奉行，稻妻的文化代表，负责祭祀活动和庆典娱乐，表面上看是与将军大人关系最近的一派，也自然是最深入民众的一门。"
                },
                {
                    "id": "631750405",
                    "speaker": "直江久政",
                    "text": "天领奉行，稻妻的治安主管，除了按部就班地执行政令之外…就只剩下和珊瑚宫的叛军们整日拉锯了吧。"
                },
                {
                    "id": "631750406",
                    "speaker": "直江久政",
                    "text": "幸好旗本的兵力不是他们可以随意调遣的，不然也免不了被一起拖去神无冢浪费时间。"
                },
                {
                    "id": "631750407",
                    "speaker": "直江久政",
                    "text": "总之…呵，哪怕是为了稻妻的未来吧，希望他们一切顺利。"
                }
            ]
        },
        {
            "talkId": "6317505",
            "initDialog": "631750501",
            "dialogues": [
                {
                    "id": "631750501",
                    "speaker": "Player",
                    "text": "不打扰了…"
                },
                {
                    "id": "631750502",
                    "speaker": "直江久政",
                    "text": "嗯，再见。"
                }
            ]
        }
    ]
}