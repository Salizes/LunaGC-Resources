            "dialogues": [
                {
                    "id": "697230101",
                    "speaker": "帕班",
                    "text": "蒙德的新闻也很多，不过这猫尾酒馆里的信息应该更好卖…"
                },
                {
                    "id": "697230102",
                    "speaker": "帕班",
                    "text": "你也要打牌吗？太好了，希望你能给我带来「超强牌手的独家消息」！"
                }
            ]
        },
        {
            "talkId": "6972302",
            "initDialog": "697230201",
            "dialogues": [
                {
                    "id": "697230201",
                    "speaker": "Player",
                    "text": "来进行「七圣召唤」吧！"
                }
            ]
        },
        {
            "talkId": "6972303",
            "initDialog": "697230301",
            "dialogues": [
                {
                    "id": "697230301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "697230302",
                    "speaker": "帕班",
                    "text": "没问题，以后有的是机会打牌！"
                }
            ]
        },
        {
            "talkId": "6972304",
            "initDialog": "697230401",
            "dialogues": [
                {
                    "id": "697230401",
                    "speaker": "帕班",
                    "text": "好！我已经得到「超强牌手的独家消息」了！"
                }
            ]
        },
        {
            "talkId": "6972305",
            "initDialog": "697230501",
            "dialogues": [
                {
                    "id": "697230501",
                    "speaker": "帕班",
                    "text": "我好像明白了，在猫尾酒馆和人对局是这种感觉…这消息也算值钱！"
                }
            ]
        }
    ]
