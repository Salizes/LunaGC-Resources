    },
    "talks": [
        {
            "talkId": "6955501",
            "initDialog": "695550101",
            "dialogues": [
                {
                    "id": "695550101",
                    "speaker": "林尼",
                    "text": "前后左右都有人啊，唔…看来我要挑一个巧妙的手法来玩牌了…对了，就用上次给琳妮特演示的那一手吧。"
                }
            ]
        },
        {
            "talkId": "6955502",
            "initDialog": "695550201",
            "dialogues": [
                {
                    "id": "695550201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955503",
            "initDialog": "695550301",
            "dialogues": [
                {
                    "id": "695550301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695550302",
                    "speaker": "林尼",
                    "text": "要走了？不如再坐下来玩一会吧，我有一个全新的手法想展示给你看。"
                }
            ]
        },
        {
            "talkId": "6955504",
            "initDialog": "695550401",
            "dialogues": [
                {
                    "id": "695550401",
                    "speaker": "林尼",
                    "text": "唔，我之所以会赢…其实是因为，我能预知到你手里有什么牌。不相信？那就从这一叠牌里挑一张吧，我再展示一次。"
                }
            ]
        },
        {
            "talkId": "6955505",
            "initDialog": "695550501",
            "dialogues": [
                {
                    "id": "695550501",
                    "speaker": "林尼",
                    "text": "糟糕糟糕，输掉了…在你面前打牌，我总会光顾着看你的表情，连自己的关键手牌都忘了出呢。"
                }
            ]
        },
        {
            "talkId": "6955506",
            "initDialog": "695550601",
            "dialogues": [
                {
                    "id": "695550601",
                    "speaker": "林尼",
                    "text": "卡牌游戏？哈哈哈，这可是魔术师的必修课啊。"
                }
            ]
        },
        {
            "talkId": "6955508",
            "initDialog": "695550801",
            "dialogues": [
                {
                    "id": "695550801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955509",
            "initDialog": "695550901",
            "dialogues": [
                {
                    "id": "695550901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6955510",
            "initDialog": "695551001",
            "dialogues": [
                {
                    "id": "695551001",
                    "speaker": "林尼",
                    "text": "哈哈哈，别灰心呀。不然…下一局我来帮你切牌吧？让你有个好开局。"
                }
            ]
        },
        {
            "talkId": "6955511",
            "initDialog": "695551101",
            "dialogues": [
                {
                    "id": "695551101",
                    "speaker": "林尼",
                    "text": "还是你比较厉害，是我输啦。"
                }
            ]
        },
        {
            "talkId": "6955512",
            "initDialog": "695551201",
            "dialogues": [
                {
                    "id": "695551201",
                    "speaker": "林尼",
                    "text": "好呀。不过…你要猜猜我会用什么手法吗？"
                }
            ]
        },
        {
            "talkId": "6955514",
            "initDialog": "695551401",
            "dialogues": [
                {
                    "id": "695551401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6955515",
            "initDialog": "695551501",
            "dialogues": [
                {
                    "id": "695551501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6955516",
            "initDialog": "695551601",
            "dialogues": [
                {
                    "id": "695551601",
                    "speaker": "林尼",
                    "text": "看来你没看穿呢。没关系，我来为你讲解，首先呢…这张牌放在这边…"
                }
            ]
        },
        {
            "talkId": "6955517",
            "initDialog": "695551701",
            "dialogues": [
                {
                    "id": "695551701",
                    "speaker": "林尼",
                    "text": "完全被你看穿了，真是厉害！唔，看来下次我得换一种手法了…"
                }
            ]
        },
        {
            "talkId": "6955518",
            "initDialog": "695551801",
            "dialogues": [
                {
                    "id": "695551801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}