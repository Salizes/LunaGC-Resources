{
    "groupId": "9325",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "钟离": 9
    },
    "talks": [
        {
            "talkId": "6932501",
            "initDialog": "693250101",
            "dialogues": [
                {
                    "id": "693250101",
                    "speaker": "钟离",
                    "text": "此地甚为有趣，它允许人们不停挑战，也给予人们休憩的空间。"
                },
                {
                    "id": "693250102",
                    "speaker": "钟离",
                    "text": "嗯，说明建立这里的人对来访者抱有期待。"
                },
                {
                    "id": "693250103",
                    "speaker": "钟离",
                    "text": "再漫长的争斗也终有停歇之日，这里的战斗又会持续到哪一刻呢。"
                }
            ]
        },
        {
            "talkId": "6932502",
            "initDialog": "693250201",
            "dialogues": [
                {
                    "id": "693250201",
                    "speaker": "钟离",
                    "text": "战斗并非目的，而是过程。我猜，这里或许藏有某种你想要的东西。"
                },
                {
                    "id": "693250202",
                    "speaker": "钟离",
                    "text": "不妨一同走走，遇到什么也可并肩应对。"
                },
                {
                    "id": "693250203",
                    "speaker": "钟离",
                    "text": "无妨，你要是觉得害怕，就走在我身后。"
                }
            ]
        },
        {
            "talkId": "6932503",
            "initDialog": "693250301",
            "dialogues": [
                {
                    "id": "693250301",
                    "speaker": "钟离",
                    "text": "这处空间里备有长桌与茶具，嗯，人够多倒是可以聚个会。"
                },
                {
                    "id": "693250302",
                    "speaker": "钟离",
                    "text": "如何？你也一起吗？"
                },
                {
                    "id": "693250303",
                    "speaker": "钟离",
                    "text": "许久没有一同饮茶闲谈了，趁此机会与我说说近来发生的事吧。"
                }
            ]
        }
    ]
}