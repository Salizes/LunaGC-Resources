    },
    "talks": [
        {
            "talkId": "6649201",
            "initDialog": "664920101",
            "dialogues": [
                {
                    "id": "664920101",
                    "speaker": "特乌兹特利",
                    "text": "悠悠纳塔，悠悠夏天！欢迎来到「鱼群之家」餐厅！小店有着每天现捕、保证新鲜的渔获和料理，客人一定要试试。"
                }
            ]
        },
        {
            "talkId": "6649202",
            "initDialog": "664920201",
            "dialogues": [
                {
                    "id": "664920201",
                    "speaker": "Player",
                    "text": "让我看看你的货。"
                },
                {
                    "id": "664920202",
                    "speaker": "特乌兹特利",
                    "text": "这将会是您见过最新鲜的。"
                }
            ]
        },
        {
            "talkId": "6649203",
            "initDialog": "664920301",
            "dialogues": [
                {
                    "id": "664920301",
                    "speaker": "Player",
                    "text": "拉威亚说你卖隔夜的鱼。"
                },
                {
                    "id": "664920302",
                    "speaker": "特乌兹特利",
                    "text": "客人说什么？我没听清。"
                }
            ]
        },
        {
            "talkId": "6649204",
            "initDialog": "664920401",
            "dialogues": [
                {
                    "id": "664920401",
                    "speaker": "Player",
                    "text": "拉威亚说你卖隔夜的鱼。"
                },
                {
                    "id": "664920402",
                    "speaker": "特乌兹特利",
                    "text": "好小子，我说怎么店里营业额和成本对不上。原来这家伙在捣鬼，不能让他再留在店里了。"
                },
                {
                    "id": "664920403",
                    "speaker": "特乌兹特利",
                    "text": "客人您真是正义使者，市场上要是您这种人再多一点也不会这么乌烟瘴气！这些是我的谢意，感谢您。"
                }
            ]
        },
        {
            "talkId": "6649205",
            "initDialog": "664920501",
            "dialogues": [
                {
                    "id": "664920501",
                    "speaker": "Player",
                    "text": "拉威亚说你的鱼很新鲜。"
                },
                {
                    "id": "664920502",
                    "speaker": "特乌兹特利",
                    "text": "哈哈，那小子还是很有眼光的啊，就跟我招了他一样有眼光。"
                },
                {
                    "id": "664920503",
                    "speaker": "特乌兹特利",
                    "text": "客人您也是识货的人，选择小店绝对没错，这些就送给您了吧。"
                }
            ]
        },
        {
            "talkId": "6649206",
            "initDialog": "664920601",
            "dialogues": [
                {
                    "id": "664920601",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "664920602",
                    "speaker": "特乌兹特利",
                    "text": "再见。"
                }
            ]
        }
    ]
}