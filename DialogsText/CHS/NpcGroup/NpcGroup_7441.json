{
    "groupId": "7441",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "雅古任斯基": 8
    },
    "talks": [
        {
            "talkId": "6744101",
            "initDialog": "674410101",
            "dialogues": [
                {
                    "id": "674410101",
                    "speaker": "雅古任斯基",
                    "text": "拍照可以，但是要合影的话请保持距离…"
                }
            ]
        },
        {
            "talkId": "6744102",
            "initDialog": "674410201",
            "dialogues": [
                {
                    "id": "674410201",
                    "speaker": "Player",
                    "text": "有很多人在这里拍照吗？"
                },
                {
                    "id": "674410202",
                    "speaker": "雅古任斯基",
                    "text": "是啊，不知道为什么，这里都快成来至冬堡旅游必经的打卡点了。"
                },
                {
                    "id": "674410203",
                    "speaker": "雅古任斯基",
                    "text": "甚至有些游客还想让我摆出指定的姿势，方便他们合影。"
                },
                {
                    "id": "674410204",
                    "speaker": "雅古任斯基",
                    "text": "再这样下去，迟早我要在旅行手册上看到自己…真是令人困扰。"
                },
                {
                    "id": "674410205",
                    "speaker": "雅古任斯基",
                    "text": "所以你不是来合影对吧？那请麻烦离我远一点。"
                }
            ]
        },
        {
            "talkId": "6744103",
            "initDialog": "674410301",
            "dialogues": [
                {
                    "id": "674410301",
                    "speaker": "Player",
                    "text": "摆个动作吧。"
                },
                {
                    "id": "674410302",
                    "speaker": "雅古任斯基",
                    "text": "呃…抱歉，我是守卫这里的卫兵，无法提供你要求的服务。"
                },
                {
                    "id": "674410303",
                    "speaker": "雅古任斯基",
                    "text": "而且要我说多少遍，这个地方是冬契军驻扎的军事重地，可不是什么旅游景点啊！"
                }
            ]
        },
        {
            "talkId": "6744104",
            "initDialog": "674410401",
            "dialogues": [
                {
                    "id": "674410401",
                    "speaker": "Player",
                    "text": "没事…"
                },
                {
                    "id": "674410402",
                    "speaker": "雅古任斯基",
                    "text": "嗯，别靠太近。"
                }
            ]
        }
    ]
}