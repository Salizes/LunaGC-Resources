{
    "groupId": "7522",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "叶拉吉娜": 8
    },
    "talks": [
        {
            "talkId": "6752201",
            "initDialog": "675220101",
            "dialogues": [
                {
                    "id": "675220101",
                    "speaker": "叶拉吉娜",
                    "text": "克什尼克之炬的运作一切如常，开始今天的记录吧…"
                }
            ]
        },
        {
            "talkId": "6752202",
            "initDialog": "675220201",
            "dialogues": [
                {
                    "id": "675220201",
                    "speaker": "Player",
                    "text": "这个炉子和别处的炉子不太一样…"
                },
                {
                    "id": "675220202",
                    "speaker": "叶拉吉娜",
                    "text": "是的，当然了，这是至冬最核心的克什尼克之炬。"
                },
                {
                    "id": "675220203",
                    "speaker": "叶拉吉娜",
                    "text": "白沙皇陛下在白冕宫完成实验之后，就立刻令人着手搭建，至今已经在此处矗立…不知道多少年了。"
                },
                {
                    "id": "675220204",
                    "speaker": "叶拉吉娜",
                    "text": "这期间，有无数人为这巨大机器的运作付出了努力。"
                }
            ]
        },
        {
            "talkId": "6752203",
            "initDialog": "675220301",
            "dialogues": [
                {
                    "id": "675220301",
                    "speaker": "Player",
                    "text": "它烧的是…矿？"
                },
                {
                    "id": "675220302",
                    "speaker": "叶拉吉娜",
                    "text": "克什尼克晶矿。正是因此才叫克什尼克之炬…"
                },
                {
                    "id": "675220303",
                    "speaker": "叶拉吉娜",
                    "text": "很多人会以为先有克什尼克之炬的名字才有晶矿的名字，不过仔细想想就知道，肯定是晶矿出现的时间比较早吧，哈哈。"
                },
                {
                    "id": "675220304",
                    "speaker": "叶拉吉娜",
                    "text": "这些矿都是通过列车，从新基捷城运来的。"
                }
            ]
        },
        {
            "talkId": "6752204",
            "initDialog": "675220401",
            "dialogues": [
                {
                    "id": "675220401",
                    "speaker": "Player",
                    "text": "不打扰你工作了。"
                },
                {
                    "id": "675220402",
                    "speaker": "叶拉吉娜",
                    "text": "好的。"
                }
            ]
        }
    ]
}