{
    "groupId": "1529",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 3,
        "康纳": 13
    },
    "talks": [
        {
            "talkId": "6152901",
            "initDialog": "615290101",
            "dialogues": [
                {
                    "id": "615290101",
                    "speaker": "康纳",
                    "text": "欢迎来到晨曦酒庄，您也是来参观的吗？"
                }
            ]
        },
        {
            "talkId": "6152902",
            "initDialog": "615290201",
            "dialogues": [
                {
                    "id": "615290201",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "615290202",
                    "speaker": "康纳",
                    "text": "我是康纳，晨曦酒庄里的一名酿酒师，从克利普斯老爷还在执掌酒庄生意时，我就在这里酿酒了。"
                },
                {
                    "id": "615290203",
                    "speaker": "康纳",
                    "text": "哦，克利普斯老爷是迪卢克老爷的父亲，也是这座酒庄的前老板。"
                },
                {
                    "id": "615290204",
                    "speaker": "康纳",
                    "text": "可惜，克利普斯老爷英年早逝，现在酒庄的担子都压在了迪卢克老爷的身上，唉…",
                    "choices": [
                        {
                            "id": "615290205",
                            "text": "关于酿酒…",
                            "response": [
                                {
                                    "id": "615290206",
                                    "speaker": "康纳",
                                    "text": "蒲公英酒是我们晨曦酒庄的招牌酒品，有着独特的清凉微甜口感和浓厚谷物香气。"
                                },
                                {
                                    "id": "615290207",
                                    "speaker": "康纳",
                                    "text": "关于制作方法，我建议您去找来《啤酒酿制漫谈》和《蒸馏技术泛论》这两本书看看。"
                                },
                                {
                                    "id": "615290208",
                                    "speaker": "康纳",
                                    "text": "内容论述的很详细，也很容易在图书馆翻到。但是迪卢克老爷一次都没有去看过…"
                                }
                            ]
                        },
                        {
                            "id": "615290209",
                            "text": "关于迪卢克…",
                            "response": [
                                {
                                    "id": "615290210",
                                    "speaker": "康纳",
                                    "text": "虽然迪卢克老爷似乎并不怎么喜欢酒…"
                                },
                                {
                                    "id": "615290211",
                                    "speaker": "康纳",
                                    "text": "但是我相信他也应该有着和他父亲一样的酿酒天赋，只不过需要一个契机来启发。"
                                },
                                {
                                    "id": "615290212",
                                    "speaker": "康纳",
                                    "text": "但是这个契机到底什么时候会来呢…"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6152903",
            "initDialog": "615290301",
            "dialogues": [
                {
                    "id": "615290301",
                    "speaker": "康纳",
                    "text": "再见。"
                },
                {
                    "id": "615290302",
                    "speaker": "康纳",
                    "text": "要走了吗？要是看见迪卢克老爷的话…"
                },
                {
                    "id": "615290303",
                    "speaker": "康纳",
                    "text": "算了…请您享受在晨曦酒庄中的时光。"
                }
            ]
        }
    ]
}