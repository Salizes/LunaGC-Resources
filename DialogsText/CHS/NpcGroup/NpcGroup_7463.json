{
    "groupId": "7463",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "斯捷潘尼扬": 12
    },
    "talks": [
        {
            "talkId": "6746301",
            "initDialog": "674630101",
            "dialogues": [
                {
                    "id": "674630101",
                    "speaker": "斯捷潘尼扬",
                    "text": "必须不断磨练自己的意志力，直到成为可靠的连队指挥…"
                },
                {
                    "id": "674630102",
                    "speaker": "斯捷潘尼扬",
                    "text": "嗯？是你啊…居然有幸再见面了。"
                }
            ]
        },
        {
            "talkId": "6746302",
            "initDialog": "674630201",
            "dialogues": [
                {
                    "id": "674630201",
                    "speaker": "Player",
                    "text": "意志力？连队指挥？"
                },
                {
                    "id": "674630202",
                    "speaker": "斯捷潘尼扬",
                    "text": "嗯，最近上头安排我主管一支连队的所有事务，任务瞬间复杂了起来。"
                },
                {
                    "id": "674630203",
                    "speaker": "斯捷潘尼扬",
                    "text": "搞定繁杂而冗长的文书工作，让一支部队稳定运转，和在前线战斗有着本质区别。"
                },
                {
                    "id": "674630204",
                    "speaker": "斯捷潘尼扬",
                    "text": "战斗技巧退居到了次要位置，全局意识和任务排期的能力显得更关键。"
                },
                {
                    "id": "674630205",
                    "speaker": "斯捷潘尼扬",
                    "text": "果然，我还是喜欢在一线战斗啊…"
                },
                {
                    "id": "674630206",
                    "speaker": "斯捷潘尼扬",
                    "text": "但，想要成为合格的战争机器，必须面面俱到才行。"
                }
            ]
        },
        {
            "talkId": "6746303",
            "initDialog": "674630301",
            "dialogues": [
                {
                    "id": "674630301",
                    "speaker": "Player",
                    "text": "你加油。"
                },
                {
                    "id": "674630302",
                    "speaker": "斯捷潘尼扬",
                    "text": "多谢鼓励，我每天都会全力以赴。"
                }
            ]
        },
        {
            "talkId": "6746304",
            "initDialog": "674630401",
            "dialogues": [
                {
                    "id": "674630401",
                    "speaker": "Player",
                    "text": "我们见过？"
                },
                {
                    "id": "674630402",
                    "speaker": "斯捷潘尼扬",
                    "text": "是的，以前我被部署在挪德卡莱试验设计局一带，还有幸和你过了几招，被您打得落花流水。"
                },
                {
                    "id": "674630403",
                    "speaker": "斯捷潘尼扬",
                    "text": "当然，你不记得我也是理所当然。"
                },
                {
                    "id": "674630404",
                    "speaker": "斯捷潘尼扬",
                    "text": "毕竟，考取了「火刃突击队员」资格章的愚人众士兵，少说也有三位数败在了你的手下。"
                },
                {
                    "id": "674630405",
                    "speaker": "斯捷潘尼扬",
                    "text": "把我当成路边随处可见的普通士兵就行。"
                }
            ]
        }
    ]
}