{
    "groupId": "4170",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 4,
        "塔拉内": 14
    },
    "talks": [
        {
            "talkId": "6417001",
            "initDialog": "641700101",
            "dialogues": [
                {
                    "id": "641700101",
                    "speaker": "塔拉内",
                    "text": "你好！今天过得如何？"
                }
            ]
        },
        {
            "talkId": "6417002",
            "initDialog": "641700201",
            "dialogues": [
                {
                    "id": "641700201",
                    "speaker": "Player",
                    "text": "一般般…"
                },
                {
                    "id": "641700202",
                    "speaker": "塔拉内",
                    "text": "看来有情况发生呀…"
                },
                {
                    "id": "641700203",
                    "speaker": "塔拉内",
                    "text": "原来大家都一样，总会遇到不那么顺心的事情。"
                },
                {
                    "id": "641700204",
                    "speaker": "塔拉内",
                    "text": "不过没关系！生活就是这样啦，一边受伤，一边歌唱。"
                },
                {
                    "id": "641700205",
                    "speaker": "塔拉内",
                    "text": "我之前被一个国外来的负心汉水手伤透了心，但你看我现在，还是可以继续跳舞！"
                },
                {
                    "id": "641700206",
                    "speaker": "塔拉内",
                    "text": "啊，忘了说，我是附近的街头艺人。你要是心情不好的话，可以来看我跳舞！"
                }
            ]
        },
        {
            "talkId": "6417003",
            "initDialog": "641700301",
            "dialogues": [
                {
                    "id": "641700301",
                    "speaker": "Player",
                    "text": "还不错！"
                },
                {
                    "id": "641700302",
                    "speaker": "塔拉内",
                    "text": "太好了，为你开心！"
                },
                {
                    "id": "641700303",
                    "speaker": "塔拉内",
                    "text": "厄运只是一时，好运则会延续，加油吧！"
                }
            ]
        },
        {
            "talkId": "6417004",
            "initDialog": "641700401",
            "dialogues": [
                {
                    "id": "641700401",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6417005",
            "initDialog": "641700501",
            "dialogues": [
                {
                    "id": "641700501",
                    "speaker": "塔拉内",
                    "text": "居、居然…不行，我下次一定要重新设置一个牌局…"
                }
            ]
        },
        {
            "talkId": "6417006",
            "initDialog": "641700601",
            "dialogues": [
                {
                    "id": "641700601",
                    "speaker": "塔拉内",
                    "text": "哼哼，看来你还要更细心一些才行。"
                }
            ]
        },
        {
            "talkId": "7391701",
            "initDialog": "739170101",
            "dialogues": [
                {
                    "id": "739170101",
                    "speaker": "Player",
                    "text": "我可以帮你教育他。"
                },
                {
                    "id": "739170102",
                    "speaker": "塔拉内",
                    "text": "多谢你的好意，不过还是容我拒绝。"
                },
                {
                    "id": "739170103",
                    "speaker": "塔拉内",
                    "text": "不是怀疑你的身手，而是我更想亲自去给他一顿教训！"
                },
                {
                    "id": "739170104",
                    "speaker": "塔拉内",
                    "text": "等我靠表演攒够了钱，就雇最好的镀金旅团佣兵，教我最厉害的格斗术。"
                },
                {
                    "id": "739170105",
                    "speaker": "塔拉内",
                    "text": "然后我就能坐船去璃月，结结实实地给那个负心汉来上一巴掌了！"
                }
            ]
        }
    ]
}