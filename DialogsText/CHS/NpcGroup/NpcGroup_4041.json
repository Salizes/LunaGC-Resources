    "talks": [
        {
            "talkId": "6404101",
            "initDialog": "640410101",
            "dialogues": [
                {
                    "id": "640410101",
                    "speaker": "沙扬",
                    "text": "你好，有事吗？"
                },
                {
                    "id": "640410102",
                    "speaker": "沙扬",
                    "text": "如果遇到走私犯，请注意不要上当受骗，并及时上报。"
                }
            ]
        },
        {
            "talkId": "6404102",
            "initDialog": "640410201",
            "dialogues": [
                {
                    "id": "640410201",
                    "speaker": "Player",
                    "text": "走私情况多吗？"
                },
                {
                    "id": "640410202",
                    "speaker": "沙扬",
                    "text": "这里是须弥城的小港口，因为就在教令院的眼皮底下，还有我们「三十人团」驻守，所以在解决走私问题方面比奥摩斯港要好上很多。"
                },
                {
                    "id": "640410203",
                    "speaker": "沙扬",
                    "text": "但也难免有些脑子拎不清的人，想要在这搞事情。"
                },
                {
                    "id": "640410204",
                    "speaker": "沙扬",
                    "text": "哼，我劝他们还是再好好想想吧。"
                }
            ]
        },
        {
            "talkId": "6404103",
            "initDialog": "640410301",
            "dialogues": [
                {
                    "id": "640410301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "640410302",
                    "speaker": "沙扬",
                    "text": "再见，如果遇到走私行为请立即告诉我。"
                }
            ]
        }
    ]
}