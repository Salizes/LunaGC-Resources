{
    "groupId": "6235",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "科帕": 10
    },
    "talks": [
        {
            "talkId": "6623501",
            "initDialog": "662350101",
            "dialogues": [
                {
                    "id": "662350101",
                    "speaker": "科帕",
                    "text": "要珍惜年轻的时光啊…"
                }
            ]
        },
        {
            "talkId": "6623502",
            "initDialog": "662350201",
            "dialogues": [
                {
                    "id": "662350201",
                    "speaker": "Player",
                    "text": "你看起来还很年轻呀。"
                },
                {
                    "id": "662350202",
                    "speaker": "科帕",
                    "text": "啊，从年龄上来说，总会有比我年长的人，也会有比我年轻的人。"
                },
                {
                    "id": "662350203",
                    "speaker": "科帕",
                    "text": "我的确并不老，也不是为了自己的时光感叹。你见过那个叫卡图马的年轻人了吗？"
                },
                {
                    "id": "662350204",
                    "speaker": "科帕",
                    "text": "他比我小几岁，算算亲属关系，我算是他的表哥吧。"
                },
                {
                    "id": "662350205",
                    "speaker": "科帕",
                    "text": "这小子，最近一段时间过得不是很顺啊。"
                }
            ]
        },
        {
            "talkId": "6623503",
            "initDialog": "662350301",
            "dialogues": [
                {
                    "id": "662350301",
                    "speaker": "Player",
                    "text": "好。"
                },
                {
                    "id": "662350302",
                    "speaker": "科帕",
                    "text": "哦？那共勉吧。"
                }
            ]
        },
        {
            "talkId": "6623504",
            "initDialog": "662350401",
            "dialogues": [
                {
                    "id": "662350401",
                    "speaker": "Player",
                    "text": "在担心他？"
                },
                {
                    "id": "662350402",
                    "speaker": "科帕",
                    "text": "…是。不过从某种角度上来说，也是我单方面的烦恼吧。"
                },
                {
                    "id": "662350403",
                    "speaker": "科帕",
                    "text": "一方面，我希望他不要轻易放弃飞行试炼，毕竟他还年轻，也不算毫无天赋。"
                },
                {
                    "id": "662350404",
                    "speaker": "科帕",
                    "text": "另一方面，我也不想他在失败中浪费太多时间，能尽快找到让自己获得满足和成就感的事业才好。"
                },
                {
                    "id": "662350405",
                    "speaker": "科帕",
                    "text": "你看，这种人生选择，就连我自己也想不明白。等哪天我想清楚后，再去开导他吧。"
                }
            ]
        }
    ]
}