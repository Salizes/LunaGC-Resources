{
    "groupId": "2442",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 3,
        "落霞": 11
    },
    "talks": [
        {
            "talkId": "6244201",
            "initDialog": "624420101",
            "dialogues": [
                {
                    "id": "624420101",
                    "speaker": "落霞",
                    "text": "欢迎莅临「珠钿舫」，尊驾就是那位旅行者吧。"
                },
                {
                    "id": "624420102",
                    "speaker": "落霞",
                    "text": "不知今日前来，可是受哪位「贵客」邀请？"
                }
            ]
        },
        {
            "talkId": "6244202",
            "initDialog": "624420201",
            "dialogues": [
                {
                    "id": "624420201",
                    "speaker": "Player",
                    "text": "这里是？"
                },
                {
                    "id": "624420202",
                    "speaker": "落霞",
                    "text": "这里是「珠钿舫」，是一个能让您忘记所有忧愁和烦恼的地方…"
                },
                {
                    "id": "624420203",
                    "speaker": "落霞",
                    "text": "请您不必心怀顾虑，这里的一切都是璃月七星默许的。"
                },
                {
                    "id": "624420204",
                    "speaker": "落霞",
                    "text": "总之在这里，您只要放心享受即可，呵呵…"
                }
            ]
        },
        {
            "talkId": "6244203",
            "initDialog": "624420301",
            "dialogues": [
                {
                    "id": "624420301",
                    "speaker": "Player",
                    "text": "你是？"
                },
                {
                    "id": "624420302",
                    "speaker": "落霞",
                    "text": "奴家名唤落霞，负责处理船上的诸多事物…请您不要误会，我不是这里的老板。"
                },
                {
                    "id": "624420303",
                    "speaker": "落霞",
                    "text": "我们老板叫做柔然，能有幸得到老板亲自接见的客人是少之又少…"
                },
                {
                    "id": "624420304",
                    "speaker": "落霞",
                    "text": "容我多嘴提醒您一句，倘若您有幸见到老板，请一定注意言辞举止。"
                },
                {
                    "id": "624420305",
                    "speaker": "落霞",
                    "text": "我们老板看似弱不禁风，可单论手段狠辣的话，放眼整个璃月港都是数一数二的…"
                },
                {
                    "id": "624420306",
                    "speaker": "落霞",
                    "text": "…言尽于此，请您务必牢记在心。"
                }
            ]
        },
        {
            "talkId": "6244204",
            "initDialog": "624420401",
            "dialogues": [
                {
                    "id": "624420401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "624420402",
                    "speaker": "落霞",
                    "text": "哦，无妨…请您自便，愿您开心。"
                }
            ]
        }
    ]
}