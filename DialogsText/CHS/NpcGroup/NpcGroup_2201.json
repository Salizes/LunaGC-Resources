{
    "groupId": "2201",
    "total_dialogue_lines": 19,
    "speaker_counts": {
        "Player": 5,
        "江雪": 14
    },
    "talks": [
        {
            "talkId": "7193001",
            "initDialog": "719300101",
            "dialogues": [
                {
                    "id": "719300101",
                    "speaker": "Player",
                    "text": "你是渔夫吗？"
                },
                {
                    "id": "719300102",
                    "speaker": "江雪",
                    "text": "你误会了，我并不是以捕鱼为生的渔人。"
                },
                {
                    "id": "719300103",
                    "speaker": "江雪",
                    "text": "钓鱼的过程与结果对我来说都没有意义，只是钓鱼会让时间过得更快一些，仅此而已。"
                },
                {
                    "id": "719300104",
                    "speaker": "江雪",
                    "text": "若是想要鱼，那你拿去便是了。"
                }
            ]
        },
        {
            "talkId": "6220101",
            "initDialog": "622010101",
            "dialogues": [
                {
                    "id": "622010101",
                    "speaker": "江雪",
                    "text": "上客栈的路在那边。嗯，来找我说话的？那就小声一点，别把鱼吓走了。"
                }
            ]
        },
        {
            "talkId": "6220102",
            "initDialog": "622010201",
            "dialogues": [
                {
                    "id": "622010201",
                    "speaker": "Player",
                    "text": "请问你是？"
                },
                {
                    "id": "622010202",
                    "speaker": "江雪",
                    "text": "我就是个普通钓客罢了。"
                },
                {
                    "id": "622010203",
                    "speaker": "江雪",
                    "text": "一定要问名字吗…名字已经丢了。"
                },
                {
                    "id": "622010204",
                    "speaker": "江雪",
                    "text": "嗯…叫我江雪吧。"
                }
            ]
        },
        {
            "talkId": "6220103",
            "initDialog": "622010301",
            "dialogues": [
                {
                    "id": "622010301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "622010302",
                    "speaker": "江雪",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6220104",
            "initDialog": "622010205",
            "dialogues": [
                {
                    "id": "622010205",
                    "speaker": "Player",
                    "text": "我也想钓鱼！"
                },
                {
                    "id": "622010206",
                    "speaker": "江雪",
                    "text": "你还有更有意义的事情要去做。"
                },
                {
                    "id": "622010207",
                    "speaker": "江雪",
                    "text": "不要学我。我只是在等，什么时候这条命走到头罢了。"
                },
                {
                    "id": "622010208",
                    "speaker": "江雪",
                    "text": "因为我该干的事情，已经做完了。"
                },
                {
                    "id": "622010209",
                    "speaker": "Player",
                    "text": "该做的事情？"
                },
                {
                    "id": "622010210",
                    "speaker": "江雪",
                    "text": "能感受出来。因为我也是曾经被世界选中的人。"
                },
                {
                    "id": "622010211",
                    "speaker": "江雪",
                    "text": "只不过，我把这个力量拿去做了不正确的事。"
                },
                {
                    "id": "622010212",
                    "speaker": "江雪",
                    "text": "我的「神之眼」已经收起来了。我不配再用它了，也不再需要了。"
                }
            ]
        }
    ]
}