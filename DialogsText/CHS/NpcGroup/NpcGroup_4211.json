{
    "groupId": "4211",
    "total_dialogue_lines": 22,
    "speaker_counts": {
        "Player": 6,
        "兰卑浮": 16
    },
    "talks": [
        {
            "talkId": "6421101",
            "initDialog": "642110101",
            "dialogues": [
                {
                    "id": "642110101",
                    "speaker": "兰卑浮",
                    "text": "无忧节快要来了，可修行不能停下，应该，更加努力…"
                }
            ]
        },
        {
            "talkId": "6421102",
            "initDialog": "642110201",
            "dialogues": [
                {
                    "id": "642110201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "642110202",
                    "speaker": "兰卑浮",
                    "text": "你好，那菈朋友。"
                },
                {
                    "id": "642110203",
                    "speaker": "兰卑浮",
                    "text": "听说你要和兰罗摩一起准备无忧节，大家都很高兴。"
                }
            ]
        },
        {
            "talkId": "6421103",
            "initDialog": "642110301",
            "dialogues": [
                {
                    "id": "642110301",
                    "speaker": "Player",
                    "text": "关于修行…"
                },
                {
                    "id": "642110302",
                    "speaker": "兰卑浮",
                    "text": "兰那罗们越是高兴，就越注意不到黑色的泥浆与雨水。"
                },
                {
                    "id": "642110303",
                    "speaker": "兰卑浮",
                    "text": "无忧节开始之前，兰卑浮要更加努力修行，保护桓那兰那。"
                }
            ]
        },
        {
            "talkId": "6421104",
            "initDialog": "642110401",
            "dialogues": [
                {
                    "id": "642110401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642110402",
                    "speaker": "兰卑浮",
                    "text": "小心，不要迷路，桓那现在很危险。"
                }
            ]
        },
        {
            "talkId": "6421105",
            "initDialog": "642110501",
            "dialogues": [
                {
                    "id": "642110501",
                    "speaker": "兰卑浮",
                    "text": "兰罗摩修行之后，有了没有见过的兰迦拉梨，我也要努力，才能接近兰帝裟。"
                }
            ]
        },
        {
            "talkId": "6421106",
            "initDialog": "642110601",
            "dialogues": [
                {
                    "id": "642110601",
                    "speaker": "Player",
                    "text": "关于兰帝裟…"
                },
                {
                    "id": "642110602",
                    "speaker": "兰卑浮",
                    "text": "兰卑浮想要成为兰帝裟那样的故事。"
                },
                {
                    "id": "642110603",
                    "speaker": "兰卑浮",
                    "text": "面前是大铁块，背后是桓那兰那。"
                },
                {
                    "id": "642110604",
                    "speaker": "兰卑浮",
                    "text": "为了能够像兰帝裟那样，眨一下眼睛就把大铁块拆得粉粉碎。"
                },
                {
                    "id": "642110605",
                    "speaker": "兰卑浮",
                    "text": "兰卑浮要继续修炼兰迦拉梨。"
                }
            ]
        },
        {
            "talkId": "6421107",
            "initDialog": "642110701",
            "dialogues": [
                {
                    "id": "642110701",
                    "speaker": "Player",
                    "text": "关于修行…"
                },
                {
                    "id": "642110702",
                    "speaker": "兰卑浮",
                    "text": "兰卑浮的修行目标是打倒桓那吉。"
                },
                {
                    "id": "642110703",
                    "speaker": "兰卑浮",
                    "text": "虽然一想到桓那吉喷出的火焰还是会发抖…但是一定有办法…"
                }
            ]
        },
        {
            "talkId": "6421108",
            "initDialog": "642110801",
            "dialogues": [
                {
                    "id": "642110801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642110802",
                    "speaker": "兰卑浮",
                    "text": "再见，金色的那菈，森林会为你指引方向。"
                }
            ]
        },
        {
            "talkId": "6421109",
            "initDialog": "642110901",
            "dialogues": [
                {
                    "id": "642110901",
                    "speaker": "兰卑浮",
                    "text": "无忧节，是高兴的日子！兰迦拉梨的修行就…"
                },
                {
                    "id": "642110902",
                    "speaker": "兰卑浮",
                    "text": "就要更加努力才行！"
                }
            ]
        }
    ]
}