{
    "groupId": "2013",
    "total_dialogue_lines": 28,
    "speaker_counts": {
        "Player": 6,
        "博来": 22
    },
    "talks": [
        {
            "talkId": "7191601",
            "initDialog": "719160101",
            "dialogues": [
                {
                    "id": "719160101",
                    "speaker": "Player",
                    "text": "日落果？"
                },
                {
                    "id": "719160102",
                    "speaker": "博来",
                    "text": "嘘，别看我这日落果看似稀松平常，实际上暗藏玄机…"
                },
                {
                    "id": "719160103",
                    "speaker": "博来",
                    "text": "…只要你尝上一口就会知道，这味道可比一般的日落果要甜多了。"
                },
                {
                    "id": "719160104",
                    "speaker": "博来",
                    "text": "要不这几个你拿去尝一下，信我准没错…"
                }
            ]
        },
        {
            "talkId": "6201301",
            "initDialog": "620130101",
            "dialogues": [
                {
                    "id": "620130101",
                    "speaker": "博来",
                    "text": "你干嘛！不知道小点声吗？"
                }
            ]
        },
        {
            "talkId": "6201302",
            "initDialog": "620130201",
            "dialogues": [
                {
                    "id": "620130201",
                    "speaker": "Player",
                    "text": "有什么卖的？"
                },
                {
                    "id": "620130202",
                    "speaker": "博来",
                    "text": "要看货啊，哼哼，好说好说…"
                }
            ]
        },
        {
            "talkId": "6201303",
            "initDialog": "620130301",
            "dialogues": [
                {
                    "id": "620130301",
                    "speaker": "Player",
                    "text": "为什么偷偷摸摸的？"
                },
                {
                    "id": "620130302",
                    "speaker": "博来",
                    "text": "本来看你也像个懂行的人，怎么还问这样的问题。"
                },
                {
                    "id": "620130303",
                    "speaker": "博来",
                    "text": "做我们这种生意的，可高调不得…"
                },
                {
                    "id": "620130304",
                    "speaker": "博来",
                    "text": "来来来，给你看…"
                },
                {
                    "id": "620130305",
                    "speaker": "博来",
                    "text": "新鲜的日落果！保证行价…"
                }
            ]
        },
        {
            "talkId": "6201304",
            "initDialog": "620130401",
            "dialogues": [
                {
                    "id": "620130401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620130402",
                    "speaker": "博来",
                    "text": "这就走了吗，不买也捧个人场啊。"
                }
            ]
        },
        {
            "talkId": "6201305",
            "initDialog": "620130501",
            "dialogues": [
                {
                    "id": "620130501",
                    "speaker": "博来",
                    "text": "喂！小点声，要不要货？"
                },
                {
                    "id": "620130502",
                    "speaker": "博来",
                    "text": "欸，原来是你啊，老主顾就不讲究那么多了，想要点儿什么？"
                }
            ]
        },
        {
            "talkId": "6201306",
            "initDialog": "620130601",
            "dialogues": [
                {
                    "id": "620130601",
                    "speaker": "Player",
                    "text": "不都是很普通的货物吗？"
                },
                {
                    "id": "620130602",
                    "speaker": "博来",
                    "text": "没错啊，我卖的就是日常百货，不然你想买什么？"
                },
                {
                    "id": "620130603",
                    "speaker": "博来",
                    "text": "你难道没听过「沉默是金」这句话吗，沉默是金，那小声儿说话怎么说也是银吧？"
                },
                {
                    "id": "620130604",
                    "speaker": "博来",
                    "text": "做生意的就该这么低声细语，金啊银啊什么的才能滚滚而来！"
                },
                {
                    "id": "620130605",
                    "speaker": "博来",
                    "text": "你这人才是，年纪轻轻，歪心思倒是动得挺多…"
                }
            ]
        },
        {
            "talkId": "6201307",
            "initDialog": "620130701",
            "dialogues": [
                {
                    "id": "620130701",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620130702",
                    "speaker": "博来",
                    "text": "唉，没想到岩王爷离世的传言竟然是真的…"
                },
                {
                    "id": "620130703",
                    "speaker": "博来",
                    "text": "…旅行者，我听说你是从蒙德而来，那你应该能感受到璃月和蒙德的不同了吧？"
                },
                {
                    "id": "620130704",
                    "speaker": "博来",
                    "text": "在璃月，哪怕是像我这样的小人物也都或多或少受到过岩王爷的恩惠。"
                },
                {
                    "id": "620130705",
                    "speaker": "博来",
                    "text": "那些霓裳花能为岩王爷的送仙典仪派上些用场，是我的荣幸。"
                },
                {
                    "id": "620130706",
                    "speaker": "博来",
                    "text": "…我既不是七星，也没有神之眼，也就只能在这方面尽些绵薄之力了…"
                },
                {
                    "id": "620130707",
                    "speaker": "博来",
                    "text": "唉，不聊了，我还得做生意呢，老是丧着脸可不行啊…"
                }
            ]
        }
    ]
}