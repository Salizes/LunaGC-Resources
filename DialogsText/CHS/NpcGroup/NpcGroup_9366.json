{
    "groupId": "9366",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "绮良良": 9
    },
    "talks": [
        {
            "talkId": "6936601",
            "initDialog": "693660101",
            "dialogues": [
                {
                    "id": "693660101",
                    "speaker": "绮良良",
                    "text": "这里有没有箱子呀？就是四四方方的，还能闻到纸浆香气的那种…"
                },
                {
                    "id": "693660102",
                    "speaker": "绮良良",
                    "text": "反正现在没什么事做，我想稍微打个盹…可以吗？"
                },
                {
                    "id": "693660103",
                    "speaker": "绮良良",
                    "text": "我会很爱护它的！就像爱护我经手的每一个包裹！"
                }
            ]
        },
        {
            "talkId": "6936602",
            "initDialog": "693660201",
            "dialogues": [
                {
                    "id": "693660201",
                    "speaker": "绮良良",
                    "text": "你是在思考打倒那些怪物的办法吗？我来给你出个主意吧！"
                },
                {
                    "id": "693660202",
                    "speaker": "绮良良",
                    "text": "只要悄悄绕到它们身后，趴低一些，趁它们不注意，猛地扑过去！"
                },
                {
                    "id": "693660203",
                    "speaker": "绮良良",
                    "text": "哎？你觉得不合适？可是这一招用来对付最狡猾的松鼠也管用啊…"
                }
            ]
        },
        {
            "talkId": "6936603",
            "initDialog": "693660301",
            "dialogues": [
                {
                    "id": "693660301",
                    "speaker": "绮良良",
                    "text": "比起自己动手翻开那些摸着沙沙的纸张，我还是更喜欢直接听人念故事。"
                },
                {
                    "id": "693660302",
                    "speaker": "绮良良",
                    "text": "趴在又软又暖和的腿上，闭上眼睛，蜷起身子，一小会儿就能钻进故事里的世界…"
                },
                {
                    "id": "693660303",
                    "speaker": "绮良良",
                    "text": "没、没有…！我没有在盯着你看…"
                }
            ]
        }
    ]
}