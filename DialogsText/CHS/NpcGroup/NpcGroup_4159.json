{
    "groupId": "4159",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "贾汉吉尔": 8
    },
    "talks": [
        {
            "talkId": "6415901",
            "initDialog": "641590101",
            "dialogues": [
                {
                    "id": "641590101",
                    "speaker": "贾汉吉尔",
                    "text": "欢迎光临，想吃点啥？"
                },
                {
                    "id": "641590102",
                    "speaker": "贾汉吉尔",
                    "text": "想自己动手做也行，锅随便用。"
                }
            ]
        },
        {
            "talkId": "6415902",
            "initDialog": "641590201",
            "dialogues": [
                {
                    "id": "641590201",
                    "speaker": "Player",
                    "text": "饿了。"
                },
                {
                    "id": "641590202",
                    "speaker": "贾汉吉尔",
                    "text": "哈哈哈，那可得多吃点！"
                }
            ]
        },
        {
            "talkId": "6415903",
            "initDialog": "641590301",
            "dialogues": [
                {
                    "id": "641590301",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641590302",
                    "speaker": "贾汉吉尔",
                    "text": "我是食品店的老板，顾名思义，就是帮大家填饱肚子的人。"
                },
                {
                    "id": "641590303",
                    "speaker": "贾汉吉尔",
                    "text": "想买现成的，或者借我的锅自己做饭，都行！吃饭嘛，就是要大家一起才开心，你说对不对？"
                },
                {
                    "id": "641590304",
                    "speaker": "贾汉吉尔",
                    "text": "尤其是那些来来往往的行商、水手，平时饥一顿饱一顿的，在我这至少能做一口热饭吃。"
                },
                {
                    "id": "641590305",
                    "speaker": "贾汉吉尔",
                    "text": "托他们的福，我还跟着蹭了不少各国各地的美味呢，哈哈哈！"
                }
            ]
        },
        {
            "talkId": "6415904",
            "initDialog": "641590401",
            "dialogues": [
                {
                    "id": "641590401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "641590402",
                    "speaker": "贾汉吉尔",
                    "text": "慢走，下次再来啊！"
                }
            ]
        }
    ]
}