    },
    "talks": [
        {
            "talkId": "6429401",
            "initDialog": "642940101",
            "dialogues": [
                {
                    "id": "642940101",
                    "speaker": "尤夫腾",
                    "text": "你、你好，陌生人。有、有什么事吗？"
                }
            ]
        },
        {
            "talkId": "6429402",
            "initDialog": "642940201",
            "dialogues": [
                {
                    "id": "642940201",
                    "speaker": "Player",
                    "text": "这些鳄鱼…"
                },
                {
                    "id": "642940202",
                    "speaker": "尤夫腾",
                    "text": "这、这些鳄鱼，都、都是部族饲养的，很肥壮，也、也很温顺…"
                },
                {
                    "id": "642940203",
                    "speaker": "尤夫腾",
                    "text": "鳄鱼好养，而且能收获很多皮和肉，正、正好这里有四季不竭的干净泉水，所以…"
                }
            ]
        },
        {
            "talkId": "6429403",
            "initDialog": "642940301",
            "dialogues": [
                {
                    "id": "642940301",
                    "speaker": "Player",
                    "text": "不打扰了。"
                },
                {
                    "id": "642940302",
                    "speaker": "尤夫腾",
                    "text": "嗯，愿、愿你一路平安，陌生人。"
                }
            ]
        },
        {
            "talkId": "7318651",
            "initDialog": "731865101",
            "dialogues": [
                {
                    "id": "731865101",
                    "speaker": "尤夫腾",
                    "text": "你、你、你好。唉…"
                },
                {
                    "id": "731865102",
                    "speaker": "Player",
                    "text": "你的心情不好吗？"
                },
                {
                    "id": "731865103",
                    "speaker": "尤夫腾",
                    "text": "唉…毕竟…阿德菲他、他、他…抱歉，他是我的朋、朋友。"
                },
                {
                    "id": "731865104",
                    "speaker": "Player",
                    "text": "我为你的朋友感到抱歉…"
                },
                {
                    "id": "731865105",
                    "speaker": "尤夫腾",
                    "text": "希望芭别尔主母这次能开、开、开恩…"
                },
                {
                    "id": "731865106",
                    "speaker": "尤夫腾",
                    "text": "不然的话，鳄鱼会、会、会消化不良…"
                },
                {
                    "id": "731865107",
                    "speaker": "Player",
                    "text": "……"
                }
            ]
        },
        {
            "talkId": "7321910",
            "initDialog": "732191001",
            "dialogues": [
                {
                    "id": "732191001",
                    "speaker": "尤夫腾",
                    "text": "你好，塔尼特的…客人。"
                },
                {
                    "id": "732191002",
                    "speaker": "尤夫腾",
                    "text": "常听婕、婕、婕德提起你，好孩子。",
                    "choices": [
                        {
                            "id": "732191003",
                            "text": "你在忙什么？",
                            "response": [
                                {
                                    "id": "732191004",
                                    "speaker": "尤夫腾",
                                    "text": "种地，喂、喂鳄鱼。有时候也做屠、屠、屠夫，鳄鱼的皮和肉，很有用。"
                                },
                                {
                                    "id": "732191008",
                                    "speaker": "尤夫腾",
                                    "text": "因为这、这里有四季不竭的干净泉水，正适合养殖鳄鱼。所、所以我们围起了这里。"
                                },
                                {
                                    "id": "732191009",
                                    "speaker": "尤夫腾",
                                    "text": "鳄鱼好养，而且能收获很多皮和肉。但耕、耕地可就太、太难了…"
                                },
                                {
                                    "id": "732191010",
                                    "speaker": "Player",
                                    "text": "你们还有耕地？"
                                },
                                {
                                    "id": "732191011",
                                    "speaker": "尤夫腾",
                                    "text": "只是…试验田。芭别尔主母她请了些外人来、来、来为我们输送「丰沃之惠」，又从城里搞来许多旧书…"
                                },
                                {
                                    "id": "732191012",
                                    "speaker": "尤夫腾",
                                    "text": "我们就、就、就照着书上写的东西，在这里尝试种地。"
                                },
                                {
                                    "id": "732191013",
                                    "speaker": "尤夫腾",
                                    "text": "但峡谷中的绿洲还是太、太、太狭窄贫瘠了，必须想办法让土地更加肥、肥沃才行。"
                                },
                                {
                                    "id": "732191014",
                                    "speaker": "Player",
                                    "text": "关于「丰沃之惠」…"
                                },
                                {
                                    "id": "732191015",
                                    "speaker": "尤夫腾",
                                    "text": "外人不愿意透露它的配方，所以我们想要让土地肥、肥沃，就必须依赖提供它的人，这不好。"
                                },
                                {
                                    "id": "732191016",
                                    "speaker": "尤夫腾",
                                    "text": "所、所以，芭别尔主母要我在、在这里研究，如何才能反向做、做出我们自己的…「丰沃之惠」。"
                                },
                                {
                                    "id": "732191017",
                                    "speaker": "Player",
                                    "text": "不打扰了。"
                                },
                                {
                                    "id": "732191018",
                                    "speaker": "尤夫腾",
                                    "text": "没、没关系，请随便拿些鳄鱼肉干吧，客人。就在我身边…"
                                }
                            ]
                        },
                        {
                            "id": "732191005",
                            "text": "哇，鳄鱼！",
                            "response": [
                                {
                                    "id": "732191006",
                                    "speaker": "尤夫腾",
                                    "text": "呵呵，是的。它们都是由我、我在照顾。这几条很肥壮，很听话。"
                                },
                                {
                                    "id": "732191007",
                                    "speaker": "尤夫腾",
                                    "text": "那条叫、叫、叫塞提姆，很凶很强，皮色很鲜艳，会是不错的挎包。还有那条，喀龙，小但肥，性格乖巧。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
