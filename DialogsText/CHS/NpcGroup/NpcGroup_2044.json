{
    "groupId": "2044",
    "total_dialogue_lines": 31,
    "speaker_counts": {
        "Player": 7,
        "快刀陈": 24
    },
    "talks": [
        {
            "talkId": "4003730",
            "initDialog": "400373001",
            "dialogues": [
                {
                    "id": "400373001",
                    "speaker": "快刀陈",
                    "text": "哟，客官是来逛街游玩的吗？饿了的话，要不要来两条刚烤好的吃虎鱼？"
                },
                {
                    "id": "400373002",
                    "speaker": "快刀陈",
                    "text": "新鲜热乎，就连璃月的仙人们都爱吃！"
                }
            ]
        },
        {
            "talkId": "7190501",
            "initDialog": "719050101",
            "dialogues": [
                {
                    "id": "719050101",
                    "speaker": "Player",
                    "text": "关于古华派…"
                },
                {
                    "id": "719050102",
                    "speaker": "快刀陈",
                    "text": "唉，提起师门，多少还是会有些怀念的，也不知道师父和师弟、师妹他们现在在做什么…"
                },
                {
                    "id": "719050103",
                    "speaker": "快刀陈",
                    "text": "…不过现在能用刀法和厨艺为大家做一道热乎乎的烤吃虎鱼，我就已经很满足了。"
                },
                {
                    "id": "719050104",
                    "speaker": "快刀陈",
                    "text": "谢谢你的关心，好久没和别人聊这么多了…"
                },
                {
                    "id": "719050105",
                    "speaker": "快刀陈",
                    "text": "这是我以前用的剑，反正我以后也不再会与人厮杀了，这剑便赠与你吧。"
                }
            ]
        },
        {
            "talkId": "6204401",
            "initDialog": "620440101",
            "dialogues": [
                {
                    "id": "620440101",
                    "speaker": "快刀陈",
                    "text": "新鲜热乎的吃虎鱼！尝尝吧，便宜！"
                }
            ]
        },
        {
            "talkId": "6204402",
            "initDialog": "620440201",
            "dialogues": [
                {
                    "id": "620440201",
                    "speaker": "Player",
                    "text": "鱼卖得怎么样？"
                },
                {
                    "id": "620440202",
                    "speaker": "快刀陈",
                    "text": "千八百条吧大概，拍着胸脯说，我家的吃虎鱼绝对是璃月最地道的…"
                },
                {
                    "id": "620440203",
                    "speaker": "快刀陈",
                    "text": "…因为城里至少一半的烤鱼都是从我这儿买的，我家不地道谁地道呢？哈哈哈…"
                },
                {
                    "id": "620440204",
                    "speaker": "快刀陈",
                    "text": "要说怎么卖的了这么多，还是得提起我这古华派的刀法…去鳞开膛，手起刀落，分分钟的事。"
                },
                {
                    "id": "620440205",
                    "speaker": "快刀陈",
                    "text": "没错！我是古华派出身，曾经闭门苦练十余年…等出关时候，第一口吃的就是这烤吃虎鱼…"
                },
                {
                    "id": "620440206",
                    "speaker": "快刀陈",
                    "text": "有人说我在这儿卖鱼是颓废了功夫，哪儿有的事。"
                },
                {
                    "id": "620440207",
                    "speaker": "快刀陈",
                    "text": "祖师爷教训过，行利民之事乃头等「武德」，只要我这手艺好，在这儿杀鱼也是件值得自豪的事儿吧？"
                }
            ]
        },
        {
            "talkId": "6204403",
            "initDialog": "620440301",
            "dialogues": [
                {
                    "id": "620440301",
                    "speaker": "Player",
                    "text": "关于岩王帝君的死…"
                },
                {
                    "id": "620440302",
                    "speaker": "快刀陈",
                    "text": "唉，说起来还是不敢相信啊。"
                },
                {
                    "id": "620440303",
                    "speaker": "快刀陈",
                    "text": "岩王爷就这么走了，要是我爹和我爷爷他们还在世，不知道他们得有多大反应。"
                },
                {
                    "id": "620440304",
                    "speaker": "快刀陈",
                    "text": "可惜等我以后也有了子子孙孙，威风的岩王爷就只能存在于故事里了…"
                }
            ]
        },
        {
            "talkId": "6204404",
            "initDialog": "620440401",
            "dialogues": [
                {
                    "id": "620440401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "620440402",
                    "speaker": "快刀陈",
                    "text": "下次再来！我摊位一直在这儿。"
                }
            ]
        },
        {
            "talkId": "6204405",
            "initDialog": "620440501",
            "dialogues": [
                {
                    "id": "620440501",
                    "speaker": "Player",
                    "text": "我想买些小吃。"
                },
                {
                    "id": "620440502",
                    "speaker": "快刀陈",
                    "text": "好嘞！新鲜又热乎嘞，小心别烫到舌头！"
                }
            ]
        },
        {
            "talkId": "7204401",
            "initDialog": "720440101",
            "dialogues": [
                {
                    "id": "720440101",
                    "speaker": "快刀陈",
                    "text": "逛了半天也饿了吧，刚烤好的吃虎鱼，要吃吗？"
                },
                {
                    "id": "720440102",
                    "speaker": "快刀陈",
                    "text": "跟你说，今年「明霄灯」造型纪念的那位，「移霄导天真君」当年最爱吃的就是烤吃虎鱼。"
                },
                {
                    "id": "720440103",
                    "speaker": "快刀陈",
                    "text": "不买两条吃的话，这个节算是白过啦。"
                }
            ]
        },
        {
            "talkId": "7204402",
            "initDialog": "720440201",
            "dialogues": [
                {
                    "id": "720440201",
                    "speaker": "Player",
                    "text": "你该不会年年都这么说吧？"
                },
                {
                    "id": "720440202",
                    "speaker": "快刀陈",
                    "text": "哈哈…是啊，我确实年年都这么说，但我可没骗人啊。"
                },
                {
                    "id": "720440203",
                    "speaker": "快刀陈",
                    "text": "因为《璃月风物志》里写了，千年前的仙人们都爱吃烤吃虎鱼…"
                }
            ]
        },
        {
            "talkId": "7204403",
            "initDialog": "720440301",
            "dialogues": [
                {
                    "id": "720440301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "720440302",
                    "speaker": "快刀陈",
                    "text": "那等你逛「霄市」逛饿了，再回来也成。"
                }
            ]
        }
    ]
}