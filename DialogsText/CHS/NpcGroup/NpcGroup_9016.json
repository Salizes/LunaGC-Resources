{
    "groupId": "9016",
    "total_dialogue_lines": 65,
    "speaker_counts": {
        "Player": 20,
        "迪卢克": 45
    },
    "talks": [
        {
            "talkId": "6901601",
            "initDialog": "690160101",
            "dialogues": [
                {
                    "id": "690160101",
                    "speaker": "迪卢克",
                    "text": "#你来了，{NICKNAME}。"
                },
                {
                    "id": "690160102",
                    "speaker": "迪卢克",
                    "text": "嗯，看你的状态似乎还不错。"
                }
            ]
        },
        {
            "talkId": "6901602",
            "initDialog": "690160201",
            "dialogues": [
                {
                    "id": "690160201",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>在这里还习惯吗？</color>"
                },
                {
                    "id": "690160701",
                    "speaker": "迪卢克",
                    "text": "还行吧。",
                    "choices": [
                        {
                            "id": "690160702",
                            "text": "原来只是「还行」的程度。",
                            "response": [
                                {
                                    "id": "690160704",
                                    "speaker": "迪卢克",
                                    "text": "……"
                                },
                                {
                                    "id": "690160705",
                                    "speaker": "迪卢克",
                                    "text": "抱歉，我并不是贬低这处家园。"
                                },
                                {
                                    "id": "690160706",
                                    "speaker": "迪卢克",
                                    "text": "也没有想让你失望的意思。"
                                },
                                {
                                    "id": "690160707",
                                    "speaker": "迪卢克",
                                    "text": "我想说的是…如果要适应在这边居住生活的话，对我而言需要一点时间。"
                                },
                                {
                                    "id": "690160708",
                                    "speaker": "迪卢克",
                                    "text": "希望你不会介意。"
                                }
                            ]
                        },
                        {
                            "id": "690160703",
                            "text": "果然迪卢克的品位名不虚传…"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901603",
            "initDialog": "690160301",
            "dialogues": [
                {
                    "id": "690160301",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>想一起聊聊天吗？</color>"
                },
                {
                    "id": "690160801",
                    "speaker": "迪卢克",
                    "text": "只是闲聊吗…",
                    "choices": [
                        {
                            "id": "690160802",
                            "text": "忘记迪卢克不喜欢闲聊了…",
                            "response": [
                                {
                                    "id": "690160803",
                                    "speaker": "迪卢克",
                                    "text": "不。不用那么在意。"
                                },
                                {
                                    "id": "690160804",
                                    "speaker": "迪卢克",
                                    "text": "在你身上花些时间，也是应该的事情。"
                                },
                                {
                                    "id": "690160810",
                                    "speaker": "迪卢克",
                                    "text": "嗯。你还是一如既往地敏锐啊。"
                                },
                                {
                                    "id": "690160811",
                                    "speaker": "迪卢克",
                                    "text": "无论是人的暗中觊觎，还是非人集团的秘密谋划。"
                                },
                                {
                                    "id": "690160812",
                                    "speaker": "迪卢克",
                                    "text": "威胁无孔不入，只要有机可乘。"
                                },
                                {
                                    "id": "690160813",
                                    "speaker": "迪卢克",
                                    "text": "……"
                                },
                                {
                                    "id": "690160814",
                                    "speaker": "迪卢克",
                                    "text": "这应该不是你想听的聊天内容。",
                                    "choices": [
                                        {
                                            "id": "690160815",
                                            "text": "没关系。",
                                            "response": [
                                                {
                                                    "id": "690160816",
                                                    "speaker": "迪卢克",
                                                    "text": "嗯…"
                                                },
                                                {
                                                    "id": "690160817",
                                                    "speaker": "迪卢克",
                                                    "text": "我得反思一下自己了…"
                                                },
                                                {
                                                    "id": "690160821",
                                                    "speaker": "迪卢克",
                                                    "text": "你所感兴趣的闲聊话题，我也会找到的。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690160818",
                                            "text": "知道你这样守护着蒙德，我就放心了。",
                                            "response": [
                                                {
                                                    "id": "690160819",
                                                    "speaker": "迪卢克",
                                                    "text": "嗯…"
                                                },
                                                {
                                                    "id": "690160820",
                                                    "speaker": "迪卢克",
                                                    "text": "我会的。"
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690160805",
                            "text": "因为看你一直不太开心的样子？",
                            "response": [
                                {
                                    "id": "690160806",
                                    "speaker": "迪卢克",
                                    "text": "我吗…？我并没有不开心。"
                                },
                                {
                                    "id": "690160807",
                                    "speaker": "迪卢克",
                                    "text": "我只是在思考，在观察，或者在计划着一些事情。"
                                },
                                {
                                    "id": "690160808",
                                    "speaker": "迪卢克",
                                    "text": "不过…我明白你是在关照我。让你担心了。"
                                }
                            ]
                        },
                        {
                            "id": "690160809",
                            "text": "最近还是在关心着「蒙德」的安全？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901604",
            "initDialog": "690160401",
            "dialogues": [
                {
                    "id": "690160401",
                    "speaker": "Player",
                    "text": "<color=#FFCC33FF>有什么想做的吗？</color>"
                },
                {
                    "id": "690160901",
                    "speaker": "迪卢克",
                    "text": "嗯，请尝一下这个。"
                },
                {
                    "id": "690160902",
                    "speaker": "迪卢克",
                    "text": "无酒精饮料，基底是祖上的配方。但我在调制的时候，也融入了一些自己的想法。",
                    "choices": [
                        {
                            "id": "690160903",
                            "text": "很清新的口感。",
                            "response": [
                                {
                                    "id": "690160905",
                                    "speaker": "迪卢克",
                                    "text": "看你的表情，你是喜欢的。"
                                },
                                {
                                    "id": "690160906",
                                    "speaker": "迪卢克",
                                    "text": "那就好。我根据你的口味进行过一些调整，看来方向没有错。"
                                },
                                {
                                    "id": "690160907",
                                    "speaker": "迪卢克",
                                    "text": "接下来还有一件事情要拜托你。"
                                },
                                {
                                    "id": "690160908",
                                    "speaker": "迪卢克",
                                    "text": "这款饮料需要一个名字。既然配方改动过，原先的名字就已经不适合了。"
                                },
                                {
                                    "id": "690160909",
                                    "speaker": "Player",
                                    "text": "是希望我来想吗？"
                                },
                                {
                                    "id": "690160910",
                                    "speaker": "迪卢克",
                                    "text": "嗯，这是按你口味调制的，我觉得用你起的名字才更妥帖。"
                                },
                                {
                                    "id": "690160911",
                                    "speaker": "迪卢克",
                                    "text": "还是说…你希望直接用你的名字？",
                                    "choices": [
                                        {
                                            "id": "690160912",
                                            "text": "感觉怪怪的。",
                                            "response": [
                                                {
                                                    "id": "690160914",
                                                    "speaker": "迪卢克",
                                                    "text": "…说得也是。"
                                                },
                                                {
                                                    "id": "690160915",
                                                    "speaker": "迪卢克",
                                                    "text": "没关系，你可以慢慢想。如果忘了味道，我也可以再调制一杯给你。"
                                                },
                                                {
                                                    "id": "690160916",
                                                    "speaker": "迪卢克",
                                                    "text": "随时随地。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "690160913",
                                            "text": "我还是再想想…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "690160904",
                            "text": "很浓烈的回味！"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6901605",
            "initDialog": "690160501",
            "dialogues": [
                {
                    "id": "690160501",
                    "speaker": "Player",
                    "text": "早啊，迪卢克。"
                },
                {
                    "id": "690161001",
                    "speaker": "迪卢克",
                    "text": "嗯，一切顺利。"
                },
                {
                    "id": "690161002",
                    "speaker": "迪卢克",
                    "text": "如果有需要我出面的场合，不用顾虑什么。叫我就行。"
                }
            ]
        },
        {
            "talkId": "6901606",
            "initDialog": "690160601",
            "dialogues": [
                {
                    "id": "690160601",
                    "speaker": "Player",
                    "text": "晚安，迪卢克。"
                },
                {
                    "id": "690161101",
                    "speaker": "迪卢克",
                    "text": "晚安…"
                },
                {
                    "id": "690161102",
                    "speaker": "迪卢克",
                    "text": "没什么。你去吧。"
                }
            ]
        },
        {
            "talkId": "6901612",
            "initDialog": "690161201",
            "dialogues": [
                {
                    "id": "690161201",
                    "speaker": "Player",
                    "text": "想一起聊聊天吗？"
                }
            ]
        },
        {
            "talkId": "6901613",
            "initDialog": "690161301",
            "dialogues": [
                {
                    "id": "690161301",
                    "speaker": "Player",
                    "text": "有什么想做的吗？"
                }
            ]
        },
        {
            "talkId": "6901614",
            "initDialog": "690161401",
            "dialogues": [
                {
                    "id": "690161401",
                    "speaker": "Player",
                    "text": "在这里还习惯吗？"
                }
            ]
        },
        {
            "talkId": "6901650",
            "initDialog": "690165001",
            "dialogues": [
                {
                    "id": "690165001",
                    "speaker": "迪卢克",
                    "text": "管理果园需要顾及诸多因素，不比战斗或对弈简单。"
                },
                {
                    "id": "690165002",
                    "speaker": "迪卢克",
                    "text": "铲除杂草的时间稍晚，都有可能干扰果实的品质，进一步影响酒的口感。"
                },
                {
                    "id": "690165003",
                    "speaker": "迪卢克",
                    "text": "如有需要，我会协助你的。试着成为合格的管理者吧。"
                }
            ]
        },
        {
            "talkId": "6901651",
            "initDialog": "690165101",
            "dialogues": [
                {
                    "id": "690165101",
                    "speaker": "迪卢克",
                    "text": "刀剑是最朴素的力量，每一位战士都不可或缺。"
                },
                {
                    "id": "690165102",
                    "speaker": "迪卢克",
                    "text": "维护刀剑，则是铸造前行的基石。"
                },
                {
                    "id": "690165103",
                    "speaker": "迪卢克",
                    "text": "所以对铁匠铺的投入，不必吝啬。"
                }
            ]
        }
    ]
}