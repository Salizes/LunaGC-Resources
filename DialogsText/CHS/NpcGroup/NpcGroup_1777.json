{
    "groupId": "1777",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "安德烈亚斯": 8
    },
    "talks": [
        {
            "talkId": "6177701",
            "initDialog": "617770101",
            "dialogues": [
                {
                    "id": "617770101",
                    "speaker": "安德烈亚斯",
                    "text": "新鲜的鱼！有新鲜的鱼！"
                }
            ]
        },
        {
            "talkId": "6177702",
            "initDialog": "617770201",
            "dialogues": [
                {
                    "id": "617770201",
                    "speaker": "安德烈亚斯",
                    "text": "令人怀念的馥郁香气啊…我年轻时，也曾闻过类似的味道…"
                }
            ]
        },
        {
            "talkId": "6177703",
            "initDialog": "617770301",
            "dialogues": [
                {
                    "id": "617770301",
                    "speaker": "Player",
                    "text": "让我看看。"
                },
                {
                    "id": "617770302",
                    "speaker": "安德烈亚斯",
                    "text": "好嘞！都是新鲜的鱼！"
                }
            ]
        },
        {
            "talkId": "6177704",
            "initDialog": "617770401",
            "dialogues": [
                {
                    "id": "617770401",
                    "speaker": "Player",
                    "text": "类似的味道？"
                },
                {
                    "id": "617770402",
                    "speaker": "安德烈亚斯",
                    "text": "哈哈…都是过去的事儿了。老头子我年轻的时候，遇到过一个从至冬来的姑娘…她的香氛和你用的有些像。"
                },
                {
                    "id": "617770403",
                    "speaker": "安德烈亚斯",
                    "text": "那时我们相信…算了，所谓相信，大抵都没什么意义。"
                },
                {
                    "id": "617770404",
                    "speaker": "安德烈亚斯",
                    "text": "古老的贵族家系出身的她，终究还是不能与我在一起的。浪底的珍珠不会伴着海鱼同游…世间的道理就是如此。"
                },
                {
                    "id": "617770405",
                    "speaker": "安德烈亚斯",
                    "text": "唉，上了年岁，就是喜欢啰嗦。让你见笑了。"
                }
            ]
        },
        {
            "talkId": "6177705",
            "initDialog": "617770501",
            "dialogues": [
                {
                    "id": "617770501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617770502",
                    "speaker": "安德烈亚斯",
                    "text": "好嘞，要买鱼记得找我！"
                }
            ]
        }
    ]
}