{
    "groupId": "2518",
    "total_dialogue_lines": 15,
    "speaker_counts": {
        "Player": 3,
        "文四爷": 4,
        "若松": 8
    },
    "talks": [
        {
            "talkId": "6251801",
            "initDialog": "625180101",
            "dialogues": [
                {
                    "id": "625180101",
                    "speaker": "若松",
                    "text": "看来，我就到此为止了…"
                }
            ]
        },
        {
            "talkId": "6251802",
            "initDialog": "625180201",
            "dialogues": [
                {
                    "id": "625180201",
                    "speaker": "Player",
                    "text": "你还好吗？"
                },
                {
                    "id": "625180202",
                    "speaker": "若松",
                    "text": "我…我，我躲过了幕府走狗的堵截，跨越了数百光年的星海，没想到竟败在了这座山的手下…"
                }
            ]
        },
        {
            "talkId": "6251803",
            "initDialog": "625180301",
            "dialogues": [
                {
                    "id": "625180301",
                    "speaker": "Player",
                    "text": "加油，再见。"
                },
                {
                    "id": "625180302",
                    "speaker": "若松",
                    "text": "唔，无念…"
                }
            ]
        },
        {
            "talkId": "6251804",
            "initDialog": "625180401",
            "dialogues": [
                {
                    "id": "625180401",
                    "speaker": "Player",
                    "text": "太夸张了吧…"
                },
                {
                    "id": "625180402",
                    "speaker": "若松",
                    "text": "枕玉老师，前往武学殿堂的路，原来这么漫长啊…"
                }
            ]
        },
        {
            "talkId": "6251805",
            "initDialog": "625180501",
            "dialogues": [
                {
                    "id": "625180501",
                    "speaker": "若松",
                    "text": "求求您了大师，您就收我为徒吧！"
                },
                {
                    "id": "625180502",
                    "speaker": "文四爷",
                    "text": "只要你能保证勤加练习的话…"
                },
                {
                    "id": "625180503",
                    "speaker": "若松",
                    "text": "您放心，我保证一定努力练习！"
                },
                {
                    "id": "625180504",
                    "speaker": "若松",
                    "text": "无论是举平拎着水桶的双臂，还是在瀑布下扎马步，我都愿意！"
                },
                {
                    "id": "625180505",
                    "speaker": "文四爷",
                    "text": "小伙子，这个世界上根本就不存在这种练武的方法。"
                },
                {
                    "id": "625180506",
                    "speaker": "若松",
                    "text": "哈哈，等我学会了这些，我可要好好给那群人炫耀一下！"
                },
                {
                    "id": "625180507",
                    "speaker": "文四爷",
                    "text": "唉，小伙子，你到底有没有在听我说话啊…"
                },
                {
                    "id": "625180508",
                    "speaker": "文四爷",
                    "text": "还是要扎扎实实练习基本功，像演武场那位非入门弟子一样，先拿木桩当对手…"
                }
            ]
        }
    ]
}