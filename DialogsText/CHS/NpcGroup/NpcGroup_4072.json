            "dialogues": [
                {
                    "id": "640720101",
                    "speaker": "戈尔珊",
                    "text": "草神保佑，希望病人们都能早日康复。"
                }
            ]
        },
        {
            "talkId": "6407202",
            "initDialog": "640720201",
            "dialogues": [
                {
                    "id": "640720201",
                    "speaker": "Player",
                    "text": "你是医生？"
                },
                {
                    "id": "640720202",
                    "speaker": "戈尔珊",
                    "text": "只是一名见习医师，还有很多需要学习的东西。"
                },
                {
                    "id": "640720203",
                    "speaker": "戈尔珊",
                    "text": "守护和救助弱者既是我的工作，也是我的愿望。"
                },
                {
                    "id": "640720204",
                    "speaker": "戈尔珊",
                    "text": "人们大多把目光聚焦于强者，而我们医师更应当将关注放在弱势的病患身上。"
                },
                {
                    "id": "640720205",
                    "speaker": "戈尔珊",
                    "text": "当年树王大人带领学者们建立阿弥利多学院并展开医学研究时，应该也怀抱着同样的愿景吧。"
                }
            ]
        },
        {
            "talkId": "6407203",
            "initDialog": "640720301",
            "dialogues": [
                {
                    "id": "640720301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "640720302",
                    "speaker": "戈尔珊",
                    "text": "草神保佑，祝你身体健康。"
                }
            ]
        },
