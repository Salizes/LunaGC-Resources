    "talks": [
        {
            "talkId": "6756401",
            "initDialog": "675640101",
            "dialogues": [
                {
                    "id": "675640101",
                    "speaker": "亚济科夫",
                    "text": "是要站在这个位置吗？"
                }
            ]
        },
        {
            "talkId": "6756402",
            "initDialog": "675640201",
            "dialogues": [
                {
                    "id": "675640201",
                    "speaker": "Player",
                    "text": "你在干嘛？"
                },
                {
                    "id": "675640202",
                    "speaker": "亚济科夫",
                    "text": "我？我在接受那位记者的采访和拍摄…好吧，说是采访，其实根本就是折磨…"
                },
                {
                    "id": "675640203",
                    "speaker": "亚济科夫",
                    "text": "他恨不得把抓到这条章鱼那天的所有细节都挖出来…天空的颜色，海上空气的湿度…"
                },
                {
                    "id": "675640204",
                    "speaker": "亚济科夫",
                    "text": "还有我泡水太久产生的指尖褶皱…好像这对拉住渔网有帮助似的…"
                }
            ]
        },
        {
            "talkId": "6756403",
            "initDialog": "675640301",
            "dialogues": [
                {
                    "id": "675640301",
                    "speaker": "Player",
                    "text": "不打扰你了…"
                },
                {
                    "id": "675640302",
                    "speaker": "亚济科夫",
                    "text": "我倒是希望有人能来阻止一下，唉…"
                }
            ]
        }
    ]
}