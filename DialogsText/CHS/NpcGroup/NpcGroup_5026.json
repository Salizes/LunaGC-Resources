{
    "groupId": "5026",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "布希柯": 8
    },
    "talks": [
        {
            "talkId": "6502601",
            "initDialog": "650260101",
            "dialogues": [
                {
                    "id": "650260101",
                    "speaker": "布希柯",
                    "text": "客人需要什么？只要您开口，我都有渠道帮您搞到手。"
                }
            ]
        },
        {
            "talkId": "6502602",
            "initDialog": "650260201",
            "dialogues": [
                {
                    "id": "650260201",
                    "speaker": "Player",
                    "text": "想看看商品。"
                },
                {
                    "id": "650260202",
                    "speaker": "布希柯",
                    "text": "您放心，我这里什么都有。"
                }
            ]
        },
        {
            "talkId": "6502603",
            "initDialog": "650260301",
            "dialogues": [
                {
                    "id": "650260301",
                    "speaker": "Player",
                    "text": "你认识很多人吗？"
                },
                {
                    "id": "650260302",
                    "speaker": "布希柯",
                    "text": "没错，而且不仅仅是枫丹的人，国外的人我也认识。"
                },
                {
                    "id": "650260303",
                    "speaker": "布希柯",
                    "text": "我年轻时是个旅行商人，但旅行久了，就觉得还是在家乡安稳过日子更适合我。"
                }
            ]
        },
        {
            "talkId": "6502604",
            "initDialog": "650260401",
            "dialogues": [
                {
                    "id": "650260401",
                    "speaker": "Player",
                    "text": "具体是什么渠道？"
                },
                {
                    "id": "650260402",
                    "speaker": "布希柯",
                    "text": "嘿嘿，如果把这些渠道都讲出来，那我不是要平添很多竞争对手嘛。"
                },
                {
                    "id": "650260403",
                    "speaker": "布希柯",
                    "text": "总之，各种地方，总会有一两个我的熟人。"
                },
                {
                    "id": "650260404",
                    "speaker": "布希柯",
                    "text": "不过请放心，这些地方都是安全的，也并不包括梅洛彼得堡。我只想安稳度日，肯定不会违法乱纪。"
                }
            ]
        },
        {
            "talkId": "6502605",
            "initDialog": "650260501",
            "dialogues": [
                {
                    "id": "650260501",
                    "speaker": "Player",
                    "text": "先不看了。"
                },
                {
                    "id": "650260502",
                    "speaker": "布希柯",
                    "text": "嗯，希望这里成为一家不必再让你四处奔波的店。"
                }
            ]
        }
    ]
}