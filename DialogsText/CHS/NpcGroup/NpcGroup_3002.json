{
    "groupId": "3002",
    "total_dialogue_lines": 12,
    "speaker_counts": {
        "Player": 4,
        "葵": 8
    },
    "talks": [
        {
            "talkId": "6300201",
            "initDialog": "630020101",
            "dialogues": [
                {
                    "id": "630020101",
                    "speaker": "葵",
                    "text": "「九十九物」，为满足你的心愿而在。"
                }
            ]
        },
        {
            "talkId": "6300202",
            "initDialog": "630020201",
            "dialogues": [
                {
                    "id": "630020201",
                    "speaker": "Player",
                    "text": "我有想买的东西。"
                },
                {
                    "id": "630020202",
                    "speaker": "葵",
                    "text": "你的愿望，就交给我了。请随意挑选。"
                }
            ]
        },
        {
            "talkId": "6300203",
            "initDialog": "630020301",
            "dialogues": [
                {
                    "id": "630020301",
                    "speaker": "Player",
                    "text": "无所不有？"
                },
                {
                    "id": "630020302",
                    "speaker": "葵",
                    "text": "没错。「九十九物」意为「几乎什么都有」，是以满足所有客人的心愿为宗旨的店铺。"
                },
                {
                    "id": "630020303",
                    "speaker": "葵",
                    "text": "也就是说，只要能开得出相应的价码，就什么都买得到。"
                },
                {
                    "id": "630020304",
                    "speaker": "葵",
                    "text": "呵呵…至于进货的渠道，恕小女不能相告。"
                }
            ]
        },
        {
            "talkId": "6300204",
            "initDialog": "630020401",
            "dialogues": [
                {
                    "id": "630020401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "630020402",
                    "speaker": "葵",
                    "text": "再见，「九十九物」随时为你服务。"
                }
            ]
        },
        {
            "talkId": "6300205",
            "initDialog": "630020501",
            "dialogues": [
                {
                    "id": "630020501",
                    "speaker": "Player",
                    "text": "想买个新的派蒙。"
                },
                {
                    "id": "630020502",
                    "speaker": "葵",
                    "text": "派…蒙？这是什么，会飞的发声玩偶？是…是掺杂了幻术的古董吗…"
                },
                {
                    "id": "630020503",
                    "speaker": "葵",
                    "text": "抱歉，这个现在确实…请客人稍安，容小女再去多方打听…"
                }
            ]
        }
    ]
}