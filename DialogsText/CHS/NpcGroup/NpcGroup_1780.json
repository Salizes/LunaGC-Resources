{
    "groupId": "1780",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "Player": 2,
        "曼恩": 7
    },
    "talks": [
        {
            "talkId": "6178001",
            "initDialog": "617800101",
            "dialogues": [
                {
                    "id": "617800101",
                    "speaker": "曼恩",
                    "text": "上山，上山…就是上了山，也找不着疗养院咯…"
                }
            ]
        },
        {
            "talkId": "6178002",
            "initDialog": "617800201",
            "dialogues": [
                {
                    "id": "617800201",
                    "speaker": "Player",
                    "text": "关于山上的疗养院…"
                },
                {
                    "id": "617800202",
                    "speaker": "曼恩",
                    "text": "早就拆咯。"
                },
                {
                    "id": "617800203",
                    "speaker": "曼恩",
                    "text": "哪怕没有什么闹鬼的事，你上去也找不着什么宝藏，还是早点回家吧。"
                },
                {
                    "id": "617800204",
                    "speaker": "曼恩",
                    "text": "我在那儿住了整整七年。山上的寒冷仿佛能连时间与风一块儿封住，七年就跟七天似的，一眨眼就过去咯。"
                },
                {
                    "id": "617800205",
                    "speaker": "曼恩",
                    "text": "但人总是要下山的。哪怕被风推着走，也是在往前走。"
                },
                {
                    "id": "617800206",
                    "speaker": "曼恩",
                    "text": "没什么可看的，也没什么可找的。要是上去以后对着一片废墟大失所望，可别怨老头子我没提醒过你。"
                }
            ]
        },
        {
            "talkId": "6178003",
            "initDialog": "617800301",
            "dialogues": [
                {
                    "id": "617800301",
                    "speaker": "Player",
                    "text": "保重。"
                },
                {
                    "id": "617800302",
                    "speaker": "曼恩",
                    "text": "谢谢。山边湿气重，你也注意身体。"
                }
            ]
        }
    ]
}