{
    "groupId": "6251",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "卡胡鲁": 10
    },
    "talks": [
        {
            "talkId": "6625101",
            "initDialog": "662510101",
            "dialogues": [
                {
                    "id": "662510101",
                    "speaker": "卡胡鲁",
                    "text": "你好，我是烟谜主的大祭司。请问是需要帮助吗？"
                }
            ]
        },
        {
            "talkId": "6625102",
            "initDialog": "662510201",
            "dialogues": [
                {
                    "id": "662510201",
                    "speaker": "Player",
                    "text": "「大祭司」…"
                },
                {
                    "id": "662510202",
                    "speaker": "卡胡鲁",
                    "text": "啊，请不要对这个称号有过分的期待。在这里，大祭司只是指经验稍微多一些的祭司罢了。"
                },
                {
                    "id": "662510203",
                    "speaker": "卡胡鲁",
                    "text": "大祭司也不止一位，「大」并不是地位最高，或者能力最强的意思。"
                },
                {
                    "id": "662510204",
                    "speaker": "卡胡鲁",
                    "text": "…抱歉，说这话并不是想要逃避责任的意思，只是希望来访者都能对烟谜主的祭司们有一个大概的认知。"
                },
                {
                    "id": "662510205",
                    "speaker": "卡胡鲁",
                    "text": "那么，言归正传。如果有什么需要烟谜主帮忙的地方，可以来找我。"
                }
            ]
        },
        {
            "talkId": "6625103",
            "initDialog": "662510301",
            "dialogues": [
                {
                    "id": "662510301",
                    "speaker": "Player",
                    "text": "又见面了。"
                },
                {
                    "id": "662510302",
                    "speaker": "卡胡鲁",
                    "text": "原来是谕示所向之人，欢迎再次来到「曜石祭场」。"
                },
                {
                    "id": "662510303",
                    "speaker": "卡胡鲁",
                    "text": "请不必拘谨，四处转转吧，就像你在四处旅行时做的一样。"
                },
                {
                    "id": "662510304",
                    "speaker": "卡胡鲁",
                    "text": "烟谜主的族人不经常主动和外人交流，所以你可能会收获很多好奇的目光。"
                },
                {
                    "id": "662510305",
                    "speaker": "卡胡鲁",
                    "text": "但请无需担忧，我们虽然会一些在外人看来难以琢磨的「把戏」，但还不至于仅靠视线就能施法。"
                }
            ]
        },
        {
            "talkId": "6625104",
            "initDialog": "662510401",
            "dialogues": [
                {
                    "id": "662510401",
                    "speaker": "Player",
                    "text": "暂时不用。"
                },
                {
                    "id": "662510402",
                    "speaker": "卡胡鲁",
                    "text": "那就好，那就好。"
                }
            ]
        }
    ]
}