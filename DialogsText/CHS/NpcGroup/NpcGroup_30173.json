{
    "groupId": "30173",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 1,
        "大伴": 6,
        "莱内": 6
    },
    "talks": [
        {
            "talkId": "7269110",
            "initDialog": "726911001",
            "dialogues": [
                {
                    "id": "726911001",
                    "speaker": "大伴",
                    "text": "#画片的事情就麻烦{M#小哥}{F#姑娘}你了，能在容彩祭上遇到莱内先生和你这样通晓风雅的人，真是幸运啊。"
                },
                {
                    "id": "726911002",
                    "speaker": "莱内",
                    "text": "哈哈的确，那么这位朋友，请问你的名字是什么呢？我和大伴先生都还不知道呢。"
                },
                {
                    "id": "726911003",
                    "speaker": "Player",
                    "text": "#{NICKNAME}。"
                },
                {
                    "id": "726911004",
                    "speaker": "莱内",
                    "text": "是个不常见的名字啊，不过与众不同也不一定是坏事，我记住这个名字了。"
                },
                {
                    "id": "726911005",
                    "speaker": "大伴",
                    "text": "#嗯，{NICKNAME}，{NICKNAME}，我也记住了。"
                }
            ]
        },
        {
            "talkId": "7269208",
            "initDialog": "726920801",
            "dialogues": [
                {
                    "id": "726920801",
                    "speaker": "莱内",
                    "text": "稻妻的诗歌对每一句的字数有要求，所以会注重词汇的长度，写出的诗歌看起来很规整，也别具风味。"
                },
                {
                    "id": "726920802",
                    "speaker": "大伴",
                    "text": "除了词汇长度以外，稻妻的诗人们都喜欢雪、月、花这样的自然景色。"
                },
                {
                    "id": "726920803",
                    "speaker": "大伴",
                    "text": "不过，倒真是少有人会去描写自由与风那样的事物。"
                },
                {
                    "id": "726920804",
                    "speaker": "大伴",
                    "text": "我打算今后也尝试拓展一下写作内容，说不定能够在稻妻的诗坛上掀起一阵新风。"
                },
                {
                    "id": "726920805",
                    "speaker": "莱内",
                    "text": "真的吗？真恨不得现在就能读到大伴先生的新作。"
                }
            ]
        },
        {
            "talkId": "7269308",
            "initDialog": "726930801",
            "dialogues": [
                {
                    "id": "726930801",
                    "speaker": "莱内",
                    "text": "一想到这次稻妻之旅很快就要结束，大家不能再像现在这样畅谈诗歌，心里还真是有点伤感。"
                },
                {
                    "id": "726930802",
                    "speaker": "大伴",
                    "text": "虽说天下没有不散的筵席，但失落却是在所难免。莱内先生，之后我们就以书信来交流创作心得怎样？"
                },
                {
                    "id": "726930803",
                    "speaker": "莱内",
                    "text": "那真是太好了！"
                }
            ]
        }
    ]
}