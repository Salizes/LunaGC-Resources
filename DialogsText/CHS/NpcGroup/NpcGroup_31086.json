{
    "groupId": "31086",
    "total_dialogue_lines": 41,
    "speaker_counts": {
        "Player": 11,
        "恰斯卡": 30
    },
    "talks": [
        {
            "talkId": "7668304",
            "initDialog": "766830401",
            "dialogues": [
                {
                    "id": "766830401",
                    "speaker": "恰斯卡",
                    "text": "#总算又见面了，{NICKNAME}，近来可好？",
                    "choices": [
                        {
                            "id": "766830402",
                            "text": "谢谢关心！你在枫丹玩得如何？",
                            "response": [
                                {
                                    "id": "766830403",
                                    "speaker": "恰斯卡",
                                    "text": "实话说，有好有坏，坏的放在前头——"
                                },
                                {
                                    "id": "766830404",
                                    "speaker": "恰斯卡",
                                    "text": "乘着灵枪越过开阔水域时，我太过靠近射击训练区，特巡队员们误以为我是浮空靶标，对我打了两轮齐射…"
                                },
                                {
                                    "id": "766830405",
                                    "speaker": "恰斯卡",
                                    "text": "还好当时空速够快，他们没有拿准提前量，一发未中，夏沃蕾队长也及时赶到，叫停了她们。",
                                    "choices": [
                                        {
                                            "id": "766830406",
                                            "text": "挺倒霉的…",
                                            "response": [
                                                {
                                                    "id": "766830408",
                                                    "speaker": "恰斯卡",
                                                    "text": "然后就只有好事了——"
                                                },
                                                {
                                                    "id": "766830409",
                                                    "speaker": "恰斯卡",
                                                    "text": "我在城里逛了几圈，悠悠哉哉地欣赏了人造的精美建筑，华丽的机关与饰品，还有漂亮复杂的服饰。"
                                                },
                                                {
                                                    "id": "766830410",
                                                    "speaker": "恰斯卡",
                                                    "text": "原本我还在担心，枫丹廷是座石材围堵着的城塞，视野不够开阔，会不会很压抑？"
                                                },
                                                {
                                                    "id": "766830411",
                                                    "speaker": "恰斯卡",
                                                    "text": "实际上，和「花羽会」的居住体验截然相反，被高大的建筑包围时，不知怎么，有种奇妙的安全感。"
                                                },
                                                {
                                                    "id": "766830412",
                                                    "speaker": "恰斯卡",
                                                    "text": "等到演习结束了，我还想再去城里转两圈。"
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766830407",
                                            "text": "没有误会和冲突就好…"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766830413",
                            "text": "先聊聊你和特巡队的合作感受？",
                            "response": [
                                {
                                    "id": "766830414",
                                    "speaker": "恰斯卡",
                                    "text": "高于预期，还不止一星半点。"
                                },
                                {
                                    "id": "766830415",
                                    "speaker": "恰斯卡",
                                    "text": "他们的纪律性非常强，虽然我已经可以预想到，一些部族勇士会嫌他们太死板，打起仗来就不该束手束脚…"
                                },
                                {
                                    "id": "766830416",
                                    "speaker": "恰斯卡",
                                    "text": "但，训练过基础水平参差不齐的新手后，我就慢慢明白了。"
                                },
                                {
                                    "id": "766830417",
                                    "speaker": "恰斯卡",
                                    "text": "在个体没有足够强横的实力时，合作与纪律是保证稳定战力的最后手段。"
                                },
                                {
                                    "id": "766830418",
                                    "speaker": "恰斯卡",
                                    "text": "因此，我有个不一定能实现的想法——"
                                },
                                {
                                    "id": "766830419",
                                    "speaker": "恰斯卡",
                                    "text": "带夏沃蕾队长回纳塔去，拉拢她加入「花羽会」战士的队伍。"
                                },
                                {
                                    "id": "766830420",
                                    "speaker": "恰斯卡",
                                    "text": "摩拉的问题不好说，毕竟枫丹这边的薪酬和消费水平都很高…我会尽可能想办法开出…摩拉以外，让她满意的价码。",
                                    "choices": [
                                        {
                                            "id": "766830421",
                                            "text": "你觉得特巡队比龙骑士厉害？",
                                            "response": [
                                                {
                                                    "id": "766830423",
                                                    "speaker": "恰斯卡",
                                                    "text": "不，这不是实力谁高谁低的问题，重点在于取长补短。"
                                                },
                                                {
                                                    "id": "766830424",
                                                    "speaker": "恰斯卡",
                                                    "text": "我为「花羽会」的战士们骄傲，始终相信龙骑士们能击败任何魔物。"
                                                },
                                                {
                                                    "id": "766830425",
                                                    "speaker": "恰斯卡",
                                                    "text": "可正是因为了解与信任，我很清楚我们的短板。每场战斗中，我们都不可避免会承受一定的伤亡。"
                                                },
                                                {
                                                    "id": "766830426",
                                                    "speaker": "恰斯卡",
                                                    "text": "以前，我们以部族的形式团结在一起，战斗中各司其事，有着看起来还算不错的配合。"
                                                },
                                                {
                                                    "id": "766830427",
                                                    "speaker": "恰斯卡",
                                                    "text": "但论及把「应对损失」、「高效训练」、「补充战力」等流程组合起来，使得战士们的队伍更有韧性…"
                                                },
                                                {
                                                    "id": "766830428",
                                                    "speaker": "恰斯卡",
                                                    "text": "枫丹的朋友们显然有着丰富的经验，值得我们深入学习，让自己变得更强大。",
                                                    "choices": [
                                                        {
                                                            "id": "766830429",
                                                            "text": "好像理解你的意思了…",
                                                            "response": [
                                                                {
                                                                    "id": "766830431",
                                                                    "speaker": "恰斯卡",
                                                                    "text": "管理队伍，安排训练，进行精准的指挥…这几方面，夏沃蕾队长是枫丹数一数二的专家了吧？"
                                                                },
                                                                {
                                                                    "id": "766830432",
                                                                    "speaker": "恰斯卡",
                                                                    "text": "她的专业技能对于追求团队力量的战士而言…就像饿鬼眼中，炉火上冒着油的烤肉。"
                                                                },
                                                                {
                                                                    "id": "766830433",
                                                                    "speaker": "Player",
                                                                    "text": "她对枫丹确实很重要哦。"
                                                                },
                                                                {
                                                                    "id": "766830434",
                                                                    "speaker": "Player",
                                                                    "text": "完全称得上是灵魂人物之一。"
                                                                },
                                                                {
                                                                    "id": "766830435",
                                                                    "speaker": "恰斯卡",
                                                                    "text": "嗯…可惜，枫丹肯定不会放她走的。"
                                                                },
                                                                {
                                                                    "id": "766830436",
                                                                    "speaker": "恰斯卡",
                                                                    "text": "挖友军的墙角，也不是堂堂正正的部族勇士该干的事。"
                                                                },
                                                                {
                                                                    "id": "766830437",
                                                                    "speaker": "恰斯卡",
                                                                    "text": "就当我开了个不怎么恰当的玩笑吧。"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "766830430",
                                                            "text": "不是很明白，你继续…"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "766830422",
                                            "text": "我以为你会觉得勇士们更强。"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "766830438",
                            "text": "一切都好，待会儿再聊。",
                            "response": [
                                {
                                    "id": "766830439",
                                    "speaker": "恰斯卡",
                                    "text": "看来还是老样子啊，忙得不可开交。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7668405",
            "initDialog": "766840501",
            "dialogues": [
                {
                    "id": "766840501",
                    "speaker": "恰斯卡",
                    "text": "作为代表派到枫丹长期进修的人选啊…"
                },
                {
                    "id": "766840502",
                    "speaker": "恰斯卡",
                    "text": "首选有朱南和因卡纳克，她们两人一起来，应该相当不错。"
                }
            ]
        }
    ]
}