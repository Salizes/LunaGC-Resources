{
    "groupId": "1598",
    "total_dialogue_lines": 16,
    "speaker_counts": {
        "Player": 4,
        "小威": 12
    },
    "talks": [
        {
            "talkId": "7093601",
            "initDialog": "709360101",
            "dialogues": [
                {
                    "id": "709360101",
                    "speaker": "Player",
                    "text": "海滩好玩吗？"
                },
                {
                    "id": "709360102",
                    "speaker": "小威",
                    "text": "嗯，和蒙德城里的风景完全不一样。"
                },
                {
                    "id": "709360103",
                    "speaker": "小威",
                    "text": "我还抓到了鱼呢，鳞片滑滑的好难抓哦…起码比小吉的螃蟹难抓多了。"
                },
                {
                    "id": "709360104",
                    "speaker": "小威",
                    "text": "不过我也没地方能养着它，就送给你吧。"
                }
            ]
        },
        {
            "talkId": "6159801",
            "initDialog": "615980101",
            "dialogues": [
                {
                    "id": "615980101",
                    "speaker": "小威",
                    "text": "咦？你好！"
                }
            ]
        },
        {
            "talkId": "6159802",
            "initDialog": "615980201",
            "dialogues": [
                {
                    "id": "615980201",
                    "speaker": "Player",
                    "text": "在沙滩玩要注意安全哦。"
                },
                {
                    "id": "615980202",
                    "speaker": "小威",
                    "text": "我是没问题啦…"
                },
                {
                    "id": "615980203",
                    "speaker": "小威",
                    "text": "不过那个奇怪的卫兵叔叔一直跟着我们，小吉都要吓坏了。"
                },
                {
                    "id": "615980204",
                    "speaker": "小威",
                    "text": "他会不会是那种…嗯…专门逼着小朋友读书写字的，坏家伙呀？"
                },
                {
                    "id": "615980205",
                    "speaker": "小威",
                    "text": "本来想去风起地找艾迪丝老师玩…现在只好躲在这边了。"
                }
            ]
        },
        {
            "talkId": "6159803",
            "initDialog": "615980301",
            "dialogues": [
                {
                    "id": "615980301",
                    "speaker": "Player",
                    "text": "关于鹰翔海滩。"
                },
                {
                    "id": "615980302",
                    "speaker": "小威",
                    "text": "说起鹰翔海滩…"
                },
                {
                    "id": "615980303",
                    "speaker": "小威",
                    "text": "我从很小的时候祖母就带我来玩…"
                },
                {
                    "id": "615980304",
                    "speaker": "小威",
                    "text": "欸，你的头发看起来就像海边最软的沙子一样，我能摸摸吗？"
                }
            ]
        },
        {
            "talkId": "6159804",
            "initDialog": "615980401",
            "dialogues": [
                {
                    "id": "615980401",
                    "speaker": "Player",
                    "text": "小心别迷路了。"
                },
                {
                    "id": "615980402",
                    "speaker": "小威",
                    "text": "嘿嘿！"
                }
            ]
        }
    ]
}