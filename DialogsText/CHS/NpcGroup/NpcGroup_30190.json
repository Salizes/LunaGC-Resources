{
    "groupId": "30190",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "阿晃": 8
    },
    "talks": [
        {
            "talkId": "7268471",
            "initDialog": "726847101",
            "dialogues": [
                {
                    "id": "726847101",
                    "speaker": "阿晃",
                    "text": "我是荒泷豪鼓祭反馈大使阿晃，您有什么要反馈的吗？",
                    "choices": [
                        {
                            "id": "726847102",
                            "text": "我觉得还不错。",
                            "response": [
                                {
                                    "id": "726847105",
                                    "speaker": "阿晃",
                                    "text": "好的，您的反馈我收到了。"
                                },
                                {
                                    "id": "726847106",
                                    "speaker": "阿晃",
                                    "text": "欸？您问别的？我没有别的话要说了。"
                                },
                                {
                                    "id": "726847107",
                                    "speaker": "阿晃",
                                    "text": "啊…老大的意思是，我的工作只要说，「您有什么要反馈的吗？」，「您的反馈我们收到了」这两句话就可以了。"
                                },
                                {
                                    "id": "726847108",
                                    "speaker": "阿晃",
                                    "text": "如果客人还要追问什么时候反馈才有消息，那就再加一句，「请您耐心等待」。"
                                },
                                {
                                    "id": "726847109",
                                    "speaker": "阿晃",
                                    "text": "他说他在其他地方参加的活动都是这样的，想必是借鉴了一下优秀的经验吧？"
                                },
                                {
                                    "id": "726847110",
                                    "speaker": "阿晃",
                                    "text": "不过后来忍姐说这样实在太敷衍了啦，所以又给我准备了一个小本子。"
                                },
                                {
                                    "id": "726847111",
                                    "speaker": "阿晃",
                                    "text": "瞧，您的意见我已经记下来了，等忍姐回来了再给她看看。"
                                }
                            ]
                        },
                        {
                            "id": "726847103",
                            "text": "我觉得一般般。"
                        },
                        {
                            "id": "726847104",
                            "text": "我觉得不太行。"
                        }
                    ]
                }
            ]
        }
    ]
}