{
    "groupId": "4157",
    "total_dialogue_lines": 24,
    "speaker_counts": {
        "Player": 6,
        "罗因贾": 18
    },
    "talks": [
        {
            "talkId": "6415701",
            "initDialog": "641570101",
            "dialogues": [
                {
                    "id": "641570101",
                    "speaker": "罗因贾",
                    "text": "你好，是有鉴定古董的委托吗？"
                }
            ]
        },
        {
            "talkId": "6415702",
            "initDialog": "641570201",
            "dialogues": [
                {
                    "id": "641570201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641570202",
                    "speaker": "罗因贾",
                    "text": "我是开古董店的，也是奥摩斯港最可靠的古董鉴定专家。"
                },
                {
                    "id": "641570203",
                    "speaker": "罗因贾",
                    "text": "我的祖父是著名的历史学者，所以我家在鉴定各种宝物方面很有家学渊源。"
                },
                {
                    "id": "641570204",
                    "speaker": "罗因贾",
                    "text": "你绝对可以相信我这双眼睛。"
                },
                {
                    "id": "641570205",
                    "speaker": "罗因贾",
                    "text": "无论是树王大人的遗物，还是花神大人的饰品，甚至是赤王遗留在沙海中的古迹，我都能一眼鉴定真伪。"
                }
            ]
        },
        {
            "talkId": "6415703",
            "initDialog": "641570301",
            "dialogues": [
                {
                    "id": "641570301",
                    "speaker": "Player",
                    "text": "暂时没有。"
                },
                {
                    "id": "641570302",
                    "speaker": "罗因贾",
                    "text": "那等下次再来找我吧。"
                }
            ]
        },
        {
            "talkId": "6415704",
            "initDialog": "641570401",
            "dialogues": [
                {
                    "id": "641570401",
                    "speaker": "Player",
                    "text": "关于树王大人…"
                },
                {
                    "id": "641570402",
                    "speaker": "罗因贾",
                    "text": "唉…虽然树王大人早已离去，但她永远是须弥最伟大的神明。"
                },
                {
                    "id": "641570403",
                    "speaker": "罗因贾",
                    "text": "她守护须弥扛下了大大小小的灾祸，逝后也为我们留下了取之不竭的智慧与宝藏。"
                },
                {
                    "id": "641570404",
                    "speaker": "罗因贾",
                    "text": "所以一般遇见与树王大人相关的古董，我都会尽我所能买下来收藏。"
                }
            ]
        },
        {
            "talkId": "6415705",
            "initDialog": "641570501",
            "dialogues": [
                {
                    "id": "641570501",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "641570502",
                    "speaker": "罗因贾",
                    "text": "我是开古董店的，也是奥摩斯港最可靠的古董鉴定专家。"
                },
                {
                    "id": "641570503",
                    "speaker": "罗因贾",
                    "text": "我的祖父是著名的历史学者，所以我家在鉴定各种宝物方面很有家学渊源。"
                },
                {
                    "id": "641570504",
                    "speaker": "罗因贾",
                    "text": "你绝对可以相信我这双眼睛。"
                },
                {
                    "id": "641570505",
                    "speaker": "罗因贾",
                    "text": "无论是花神大人的饰品，还是草神大人的神迹，甚至是赤王遗留在沙海中的古迹，我都能一眼鉴定真伪。"
                }
            ]
        },
        {
            "talkId": "6415706",
            "initDialog": "641570601",
            "dialogues": [
                {
                    "id": "641570601",
                    "speaker": "Player",
                    "text": "关于草神大人…"
                },
                {
                    "id": "641570602",
                    "speaker": "罗因贾",
                    "text": "唉…草神大人永远是须弥最伟大的神明，教令院此前的行为实在令人愤慨。"
                },
                {
                    "id": "641570603",
                    "speaker": "罗因贾",
                    "text": "她守护须弥扛下了大大小小的灾祸，为我们提供了取之不竭的智慧与宝藏。"
                },
                {
                    "id": "641570604",
                    "speaker": "罗因贾",
                    "text": "所以一般遇见与草神大人相关的古董，我都会尽我所能买下来收藏。"
                }
            ]
        },
        {
            "talkId": "6415707",
            "initDialog": "641570701",
            "dialogues": [
                {
                    "id": "641570701",
                    "speaker": "Player",
                    "text": "冒险挑战"
                }
            ]
        },
        {
            "talkId": "6415708",
            "initDialog": "641570801",
            "dialogues": [
                {
                    "id": "641570801",
                    "speaker": "罗因贾",
                    "text": "啊，居然让你赢了，还真有点本事。"
                }
            ]
        },
        {
            "talkId": "6415709",
            "initDialog": "641570901",
            "dialogues": [
                {
                    "id": "641570901",
                    "speaker": "罗因贾",
                    "text": "哈哈，打牌和古董鉴定都是一样，一不小心就会被骗，所以要擦亮眼睛…"
                }
            ]
        }
    ]
}