    "talks": [
        {
            "talkId": "6601201",
            "initDialog": "660120101",
            "dialogues": [
                {
                    "id": "660120101",
                    "speaker": "维图索夫",
                    "text": "三倍分量的「山与海与天空」，半个小时内吃完，你觉得有可能吗？"
                }
            ]
        },
        {
            "talkId": "6601202",
            "initDialog": "660120201",
            "dialogues": [
                {
                    "id": "660120201",
                    "speaker": "Player",
                    "text": "试一下，试一下。"
                },
                {
                    "id": "660120202",
                    "speaker": "维图索夫",
                    "text": "我也是这么想的！"
                },
                {
                    "id": "660120203",
                    "speaker": "维图索夫",
                    "text": "来纳塔之前我还有些担心，自己会不会不适应当地的饮食。"
                },
                {
                    "id": "660120204",
                    "speaker": "维图索夫",
                    "text": "现在看来完全是多虑了！大份管饱的高热量食物，不正是我需要的嘛。"
                },
                {
                    "id": "660120205",
                    "speaker": "维图索夫",
                    "text": "稍等，我酝酿一下…是时候挑战下这个限时空盘活动了。"
                }
            ]
        },
        {
            "talkId": "6601203",
            "initDialog": "660120301",
            "dialogues": [
                {
                    "id": "660120301",
                    "speaker": "Player",
                    "text": "请量力而行。"
                },
                {
                    "id": "660120302",
                    "speaker": "维图索夫",
                    "text": "嗯，明白的。"
                }
            ]
        }
    ]
}