{
    "groupId": "6068",
    "total_dialogue_lines": 13,
    "speaker_counts": {
        "Player": 3,
        "米卢·努伊": 10
    },
    "talks": [
        {
            "talkId": "6606801",
            "initDialog": "660680101",
            "dialogues": [
                {
                    "id": "660680101",
                    "speaker": "米卢·努伊",
                    "text": "帕卡那小子，不会又把我的唱片放到儿歌区了吧！"
                }
            ]
        },
        {
            "talkId": "6606802",
            "initDialog": "660680201",
            "dialogues": [
                {
                    "id": "660680201",
                    "speaker": "Player",
                    "text": "帕卡是谁？"
                },
                {
                    "id": "660680202",
                    "speaker": "米卢·努伊",
                    "text": "「花歌唱片店」里那位。"
                },
                {
                    "id": "660680203",
                    "speaker": "米卢·努伊",
                    "text": "你…你去过那家店了吗？虽然帕卡这小子不太靠谱，但品味不错，里面还有我的音乐唱片卖呢。"
                },
                {
                    "id": "660680204",
                    "speaker": "米卢·努伊",
                    "text": "可以试听，不要错过！"
                },
                {
                    "id": "660680205",
                    "speaker": "米卢·努伊",
                    "text": "…而且，听完麻烦跟我讲讲感受，我的音乐…真的很像儿歌吗？"
                }
            ]
        },
        {
            "talkId": "6606803",
            "initDialog": "660680301",
            "dialogues": [
                {
                    "id": "660680301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660680302",
                    "speaker": "米卢·努伊",
                    "text": "要走了吗？好吧。"
                }
            ]
        },
        {
            "talkId": "6606804",
            "initDialog": "660680401",
            "dialogues": [
                {
                    "id": "660680401",
                    "speaker": "Player",
                    "text": "我没听过，其他人怎么说？"
                },
                {
                    "id": "660680402",
                    "speaker": "米卢·努伊",
                    "text": "唉…唉…就是因为好多顾客这样说，帕卡才老是把我的唱片从流行区换到儿歌区去。"
                },
                {
                    "id": "660680403",
                    "speaker": "米卢·努伊",
                    "text": "音乐究竟是什么风格，我这个作者说了不算吗？"
                },
                {
                    "id": "660680404",
                    "speaker": "米卢·努伊",
                    "text": "而且帕卡那小子，从辈分上来说应该管我叫一声叔叔！这小混账…"
                },
                {
                    "id": "660680405",
                    "speaker": "米卢·努伊",
                    "text": "哎算了算了，不骂他了。虽然他不怎么听话，开店倒是挺有天赋。"
                }
            ]
        }
    ]
}