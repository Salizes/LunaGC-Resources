                {
                    "id": "640780101",
                    "speaker": "尼达尔",
                    "text": "…你是教令官？"
                }
            ]
        },
        {
            "talkId": "6407802",
            "initDialog": "640780201",
            "dialogues": [
                {
                    "id": "640780201",
                    "speaker": "Player",
                    "text": "有什么区别？"
                },
                {
                    "id": "640780202",
                    "speaker": "尼达尔",
                    "text": "如果你是，那就出示证明，下达命令，我立即执行。"
                },
                {
                    "id": "640780203",
                    "speaker": "尼达尔",
                    "text": "如果你不是，那就遵纪守法，勿要造次。"
                },
                {
                    "id": "640780204",
                    "speaker": "尼达尔",
                    "text": "很简单的道理，没有人能在我面前用「不明白」来搪塞过去。"
                }
            ]
        },
        {
            "talkId": "6407803",
            "initDialog": "640780301",
            "dialogues": [
                {
                    "id": "640780301",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "640780302",
                    "speaker": "尼达尔",
                    "text": "哼。"
                }
            ]
        }
