{
    "groupId": "13019",
    "total_dialogue_lines": 20,
    "speaker_counts": {
        "Player": 5,
        "「花角玉将」": 9,
        "派蒙": 6
    },
    "talks": [
        {
            "talkId": "7273009",
            "initDialog": "727300901",
            "dialogues": [
                {
                    "id": "727300901",
                    "speaker": "派蒙",
                    "text": "呜哇，他们两好像还在琢磨斗虫的细节，准备进行下一场比试呢…都没注意到我们来了。"
                },
                {
                    "id": "727300902",
                    "speaker": "派蒙",
                    "text": "#怎么办，{NICKNAME}？我们还是不要打扰他们比较好？",
                    "choices": [
                        {
                            "id": "727300903",
                            "text": "观摩一斗再战对手！"
                        },
                        {
                            "id": "727300904",
                            "text": "派蒙说得对，我们悄悄离开吧。"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7273010",
            "initDialog": "727301001",
            "dialogues": [
                {
                    "id": "727301001",
                    "speaker": "「花角玉将」",
                    "text": "哦，你们还在这里啊？看来你们对斗虫的热情已经彻底被激发出来了呢…",
                    "choices": [
                        {
                            "id": "727301002",
                            "text": "关于你和荒泷一斗的斗虫胜负…",
                            "response": [
                                {
                                    "id": "727301003",
                                    "speaker": "「花角玉将」",
                                    "text": "哈哈，你们很好学嘛！那就让我来给你们复盘一下，我和「真剑斗虫大鬼王」诸多较量之中，最精彩的几场…"
                                }
                            ]
                        },
                        {
                            "id": "727301004",
                            "text": "你不是走了吗？",
                            "response": [
                                {
                                    "id": "727301005",
                                    "speaker": "派蒙",
                                    "text": "对哦，你不是和放牛的…咳咳！和「真剑斗虫大鬼王」去你的主场继续切磋去了吗？"
                                },
                                {
                                    "id": "727301006",
                                    "speaker": "派蒙",
                                    "text": "怎么一个人悄悄溜回来了？难道你终于被他打败了吗？"
                                },
                                {
                                    "id": "727301007",
                                    "speaker": "「花角玉将」",
                                    "text": "啊哈！打败我有那么容易吗？"
                                },
                                {
                                    "id": "727301008",
                                    "speaker": "「花角玉将」",
                                    "text": "抵达我的本阵后，「真剑斗虫大鬼王」见到了我的祖父大人，对祖父大人培养鬼兜虫的秘诀很感兴趣。"
                                },
                                {
                                    "id": "727301009",
                                    "speaker": "「花角玉将」",
                                    "text": "他正和祖父大人热切交流，讨论鬼兜虫的食谱和训练鬼兜虫的场地，看样子还要聊上好一会儿。"
                                },
                                {
                                    "id": "727301010",
                                    "speaker": "「花角玉将」",
                                    "text": "让「真剑斗虫大鬼王」和他的「赤红一杵」稍事休整，也对之后的公平较量有益，所以我就先回这边来看看了。"
                                },
                                {
                                    "id": "727301011",
                                    "speaker": "派蒙",
                                    "text": "唔…我好像明白了。那个什么本阵其实就是你家，你那些厉害的鬼兜虫，都是你的爷爷帮你照顾的，所以才很大很强？"
                                },
                                {
                                    "id": "727301012",
                                    "speaker": "「花角玉将」",
                                    "text": "基本正确！不过我的本阵还有很多玄机，比如影响鬼兜虫习性的小秘宝…"
                                },
                                {
                                    "id": "727301013",
                                    "speaker": "「花角玉将」",
                                    "text": "有机会的话，你们也可以来看看！"
                                },
                                {
                                    "id": "727301014",
                                    "speaker": "派蒙",
                                    "text": "说得这么神秘，我也开始好奇了呢…就先答应你好了！"
                                }
                            ]
                        },
                        {
                            "id": "727301015",
                            "text": "后会有期！",
                            "response": [
                                {
                                    "id": "727301016",
                                    "speaker": "「花角玉将」",
                                    "text": "后会有期，「鬼王的左膀右臂」和「破空白铁小堇瓜」！"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}