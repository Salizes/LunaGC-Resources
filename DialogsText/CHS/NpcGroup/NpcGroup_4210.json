{
    "groupId": "4210",
    "total_dialogue_lines": 26,
    "speaker_counts": {
        "Player": 8,
        "兰随尼": 18
    },
    "talks": [
        {
            "talkId": "6421001",
            "initDialog": "642100101",
            "dialogues": [
                {
                    "id": "642100101",
                    "speaker": "兰随尼",
                    "text": "那菈朋友，想要听兰那罗的故事吗？兰随尼知道许多，但是要用新故事交换。"
                }
            ]
        },
        {
            "talkId": "6421002",
            "initDialog": "642100201",
            "dialogues": [
                {
                    "id": "642100201",
                    "speaker": "Player",
                    "text": "讲述与兰那罗的冒险。"
                },
                {
                    "id": "642100202",
                    "speaker": "兰随尼",
                    "text": "那菈朋友带来什么样的故事呢？能不能让古老的树惊落叶片上的露珠？"
                }
            ]
        },
        {
            "talkId": "6421003",
            "initDialog": "642100301",
            "dialogues": [
                {
                    "id": "642100301",
                    "speaker": "Player",
                    "text": "关于过去的故事…"
                },
                {
                    "id": "642100302",
                    "speaker": "兰随尼",
                    "text": "过去许多的故事，都是在那菈法留纳到达桓那兰那后，才开始被讲述的。"
                },
                {
                    "id": "642100303",
                    "speaker": "兰随尼",
                    "text": "新的那菈朋友和那菈法留纳一样都是金灿灿的，一定也能够带来许多新故事。"
                }
            ]
        },
        {
            "talkId": "6421004",
            "initDialog": "642100401",
            "dialogues": [
                {
                    "id": "642100401",
                    "speaker": "Player",
                    "text": "关于手中的杖…"
                },
                {
                    "id": "642100402",
                    "speaker": "兰随尼",
                    "text": "兰随尼的「杖」，是听过许多故事的宝杖。"
                },
                {
                    "id": "642100403",
                    "speaker": "兰随尼",
                    "text": "杖的纹路就像是树的年轮一样不断增长。听过越多的故事，就会越强壮。"
                },
                {
                    "id": "642100404",
                    "speaker": "兰随尼",
                    "text": "总有一天，能够长成充满了故事的大树。"
                },
                {
                    "id": "642100405",
                    "speaker": "兰随尼",
                    "text": "如果那菈朋友是兰那罗的话，一定能够明白。"
                }
            ]
        },
        {
            "talkId": "6421005",
            "initDialog": "642100501",
            "dialogues": [
                {
                    "id": "642100501",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "642100502",
                    "speaker": "兰随尼",
                    "text": "嗯。兰随尼明白，你是充满了故事的那菈。如果有好的故事，我们就分享吧。"
                }
            ]
        },
        {
            "talkId": "6421006",
            "initDialog": "642100601",
            "dialogues": [
                {
                    "id": "642100601",
                    "speaker": "兰随尼",
                    "text": "#那菈{NICKNAME}带来了许多新故事，兰随尼的故事讲完了，新故事都没有结束。"
                }
            ]
        },
        {
            "talkId": "6421007",
            "initDialog": "642100701",
            "dialogues": [
                {
                    "id": "642100701",
                    "speaker": "Player",
                    "text": "讲述与兰那罗的冒险。"
                },
                {
                    "id": "642100702",
                    "speaker": "兰随尼",
                    "text": "原来这就是兰罗摩的故事…新的觉王树的故事…"
                }
            ]
        },
        {
            "talkId": "6421008",
            "initDialog": "642100801",
            "dialogues": [
                {
                    "id": "642100801",
                    "speaker": "Player",
                    "text": "关于新故事…"
                },
                {
                    "id": "642100802",
                    "speaker": "兰随尼",
                    "text": "#那菈{NICKNAME}与兰罗摩的新故事像是惟耶之实那样饱满。"
                },
                {
                    "id": "642100803",
                    "speaker": "兰随尼",
                    "text": "不管太阳再升起多少次，你们的故事不会被遗忘，桓那会永远记住你们。"
                }
            ]
        },
        {
