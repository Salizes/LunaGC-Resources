{
    "groupId": "6629",
    "total_dialogue_lines": 10,
    "speaker_counts": {
        "Player": 2,
        "「阿楚帕拉」": 7,
        "阿楚": 1
    },
    "talks": [
        {
            "talkId": "6661201",
            "initDialog": "666120101",
            "dialogues": [
                {
                    "id": "666120101",
                    "speaker": "「阿楚帕拉」",
                    "text": "哎呀，这位客人，多亏你救我下来。我可从没想过有一天我会被阿楚困住…"
                },
                {
                    "id": "666120102",
                    "speaker": "「阿楚帕拉」",
                    "text": "它一定是青春期到了，现在见到红色就会变得很激动。"
                },
                {
                    "id": "666120103",
                    "speaker": "Player",
                    "text": "跟青春期没关系吧…"
                },
                {
                    "id": "666120104",
                    "speaker": "「阿楚帕拉」",
                    "text": "欸？那难道还有别的原因吗？"
                },
                {
                    "id": "666120105",
                    "speaker": "Player",
                    "text": "最近有什么异常吗？"
                },
                {
                    "id": "666120106",
                    "speaker": "「阿楚帕拉」",
                    "text": "度假村怎么会有什么异常呢…啊！"
                },
                {
                    "id": "666120107",
                    "speaker": "「阿楚帕拉」",
                    "text": "真要说的话，最近我确实见到了两个怪人…一个光头大哥！一个眼罩大哥！"
                },
                {
                    "id": "666120108",
                    "speaker": "「阿楚帕拉」",
                    "text": "他们好像在沙滩上打起来了…该不会是见血了，给阿楚看见了，它才对红色这么敏感吧？"
                },
                {
                    "id": "666120109",
                    "speaker": "「阿楚帕拉」",
                    "text": "这可不太对劲，我得上报一下才行，客人你也要留心呀。要是看见这两个家伙最好离远些。"
                },
                {
                    "id": "666120110",
                    "speaker": "阿楚",
                    "text": "哼呜…"
                }
            ]
        }
    ]
}