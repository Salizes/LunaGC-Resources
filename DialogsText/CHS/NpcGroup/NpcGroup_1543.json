{
    "groupId": "1543",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 9,
        "神奇的霍普金斯": 21
    },
    "talks": [
        {
            "talkId": "7092201",
            "initDialog": "709220101",
            "dialogues": [
                {
                    "id": "709220101",
                    "speaker": "Player",
                    "text": "三百摩拉…"
                },
                {
                    "id": "709220102",
                    "speaker": "神奇的霍普金斯",
                    "text": "呃，莫非你是嫌贵？"
                },
                {
                    "id": "709220103",
                    "speaker": "神奇的霍普金斯",
                    "text": "这、这样吧，现在如果购入圣水的话，还会附赠一个神奇的杯子。"
                },
                {
                    "id": "709220104",
                    "speaker": "神奇的霍普金斯",
                    "text": "如果使用这个杯子饮用圣水，还会让圣水的效果大增！"
                },
                {
                    "id": "709220105",
                    "speaker": "神奇的霍普金斯",
                    "text": "所以，赶紧来买些圣水吧！"
                }
            ]
        },
        {
            "talkId": "41733",
            "initDialog": "615430305",
            "dialogues": [
                {
                    "id": "615430305",
                    "speaker": "Player",
                    "text": "打扰了。"
                },
                {
                    "id": "615430306",
                    "speaker": "神奇的霍普金斯",
                    "text": "就三百摩拉，等等，喂！别走啊！"
                }
            ]
        },
        {
            "talkId": "6154301",
            "initDialog": "615430101",
            "dialogues": [
                {
                    "id": "615430101",
                    "speaker": "神奇的霍普金斯",
                    "text": "旅行者，你有没有因为自己实力不够而烦恼，想不想拥有更强大的力量？"
                }
            ]
        },
        {
            "talkId": "6154302",
            "initDialog": "615430201",
            "dialogues": [
                {
                    "id": "615430201",
                    "speaker": "Player",
                    "text": "你是…"
                },
                {
                    "id": "615430202",
                    "speaker": "神奇的霍普金斯",
                    "text": "我是谁？是被泉水之神授予了神圣职务的人，专门为人们带来奇迹。"
                },
                {
                    "id": "615430203",
                    "speaker": "神奇的霍普金斯",
                    "text": "你可以叫我——神奇的霍普金斯。"
                }
            ]
        },
        {
            "talkId": "6154303",
            "initDialog": "615430301",
            "dialogues": [
                {
                    "id": "615430301",
                    "speaker": "Player",
                    "text": "如何拥有更强的力量…？"
                },
                {
                    "id": "615430302",
                    "speaker": "神奇的霍普金斯",
                    "text": "只要喝下这瓶被神祝福过的泉水，你就能得到来自神的启示！"
                },
                {
                    "id": "615430303",
                    "speaker": "神奇的霍普金斯",
                    "text": "说不定…直接获得神之眼也有可能喔！"
                },
                {
                    "id": "615430304",
                    "speaker": "神奇的霍普金斯",
                    "text": "你肯定想拥有神之眼对吧，只要三百摩拉…"
                }
            ]
        },
        {
            "talkId": "6154304",
            "initDialog": "615430401",
            "dialogues": [
                {
                    "id": "615430401",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615430402",
                    "speaker": "神奇的霍普金斯",
                    "text": "你这就走了？这可是千载难逢的机会啊！听我说完啊…"
                }
            ]
        },
        {
            "talkId": "6154305",
            "initDialog": "615430501",
            "dialogues": [
                {
                    "id": "615430501",
                    "speaker": "神奇的霍普金斯",
                    "text": "啊啊啊啊啊啊！！！…呼…呼呼…吓死我了！"
                }
            ]
        },
        {
            "talkId": "6154306",
            "initDialog": "615430601",
            "dialogues": [
                {
                    "id": "615430601",
                    "speaker": "Player",
                    "text": "你在做什么呢？"
                },
                {
                    "id": "615430602",
                    "speaker": "神奇的霍普金斯",
                    "text": "啊…那个，我、我在感受泉水之神的启示！"
                },
                {
                    "id": "615430603",
                    "speaker": "神奇的霍普金斯",
                    "text": "这是我神奇的霍普金斯与泉水之神的宝贵独处时间，你快一边儿去！"
                }
            ]
        },
        {
            "talkId": "6154307",
            "initDialog": "615430701",
            "dialogues": [
                {
                    "id": "615430701",
                    "speaker": "Player",
                    "text": "你在灌普通泉水吧？"
                },
                {
                    "id": "615430702",
                    "speaker": "神奇的霍普金斯",
                    "text": "哈？你、你胡说什么呢。"
                },
                {
                    "id": "615430703",
                    "speaker": "神奇的霍普金斯",
                    "text": "你看到的都是表象，经由我神奇的霍普金斯之手，怎么会普通嘛！"
                },
                {
                    "id": "615430704",
                    "speaker": "神奇的霍普金斯",
                    "text": "不信你买了这瓶泉水亲身试试看！"
                }
            ]
        },
        {
            "talkId": "6154308",
            "initDialog": "615430801",
            "dialogues": [
                {
                    "id": "615430801",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "615430802",
                    "speaker": "神奇的霍普金斯",
                    "text": "嗯…今天你看到的事儿千万不能说出去，不然会激怒泉水之神的！"
                },
                {
                    "id": "615430803",
                    "speaker": "神奇的霍普金斯",
                    "text": "…你、你不说的话，下次你来买神奇泉水，我给你打折如何？"
                }
            ]
        },
        {
            "talkId": "6154309",
            "initDialog": "615430901",
            "dialogues": [
                {
                    "id": "615430901",
                    "speaker": "Player",
                    "text": "如何才能获得强大的力量？"
                },
                {
                    "id": "615430902",
                    "speaker": "神奇的霍普金斯",
                    "text": "我这里有些圣水，保证您喝完神清气爽、力气倍增！…就是见效可能会慢一些。"
                }
            ]
        }
    ]
}