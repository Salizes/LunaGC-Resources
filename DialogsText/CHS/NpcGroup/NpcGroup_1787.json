    "talks": [
        {
            "talkId": "6178701",
            "initDialog": "617870101",
            "dialogues": [
                {
                    "id": "617870101",
                    "speaker": "罗丝薇莎",
                    "text": "风神大人，求您保佑他平安回家…"
                }
            ]
        },
        {
            "talkId": "6178702",
            "initDialog": "617870201",
            "dialogues": [
                {
                    "id": "617870201",
                    "speaker": "Player",
                    "text": "你在等人？"
                },
                {
                    "id": "617870202",
                    "speaker": "罗丝薇莎",
                    "text": "是的，我在等我的父亲…他是往返于蒙德和至冬的商人。"
                },
                {
                    "id": "617870203",
                    "speaker": "罗丝薇莎",
                    "text": "虽然每隔一段时间都会有家书寄回来，信里也总是在报平安…但没亲眼见到他从寒冷的北方回来，我总是有些不安心…"
                },
                {
                    "id": "617870204",
                    "speaker": "罗丝薇莎",
                    "text": "毕竟，那位女皇治下的国度…对商人来说，并不总是那么友善。"
                }
            ]
        },
        {
            "talkId": "6178703",
            "initDialog": "617870301",
            "dialogues": [
                {
                    "id": "617870301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "617870302",
                    "speaker": "罗丝薇莎",
                    "text": "再见，愿信风带给你好消息。"
                }
            ]
        }
    ]
}