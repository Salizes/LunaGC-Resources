{
    "groupId": "6018",
    "total_dialogue_lines": 11,
    "speaker_counts": {
        "Player": 3,
        "阿斯基娅": 8
    },
    "talks": [
        {
            "talkId": "6601801",
            "initDialog": "660180101",
            "dialogues": [
                {
                    "id": "660180101",
                    "speaker": "阿斯基娅",
                    "text": "愿炽热的果实永不落下枝头。"
                }
            ]
        },
        {
            "talkId": "6601802",
            "initDialog": "660180201",
            "dialogues": [
                {
                    "id": "660180201",
                    "speaker": "Player",
                    "text": "你好。"
                },
                {
                    "id": "660180202",
                    "speaker": "阿斯基娅",
                    "text": "你好，你也是来看这圣火的吗？"
                },
                {
                    "id": "660180203",
                    "speaker": "阿斯基娅",
                    "text": "像悬挂在树梢的苹果，是战争胜利后取得的初始之火…也是能将侵蚀灼烧的终结之火…"
                },
                {
                    "id": "660180204",
                    "speaker": "阿斯基娅",
                    "text": "圣火碑是天空赐予纳塔的祝福。来吧，朋友，和我一起祈祷。"
                },
                {
                    "id": "660180205",
                    "speaker": "阿斯基娅",
                    "text": "愿圣火永不掉落，愿胜利的果实长存。"
                }
            ]
        },
        {
            "talkId": "6601803",
            "initDialog": "660180301",
            "dialogues": [
                {
                    "id": "660180301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "660180302",
                    "speaker": "阿斯基娅",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "7591001",
            "initDialog": "759100101",
            "dialogues": [
                {
                    "id": "759100101",
                    "speaker": "Player",
                    "text": "（默默祈祷。）"
                },
                {
                    "id": "759100102",
                    "speaker": "阿斯基娅",
                    "text": "请伸出手来。"
                },
                {
                    "id": "759100103",
                    "speaker": "阿斯基娅",
                    "text": "别紧张，没什么特殊的含义，只是觉得你很适合黑曜石。"
                }
            ]
        }
    ]
}