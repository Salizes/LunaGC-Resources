{
    "groupId": "9591",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "鹿野院平藏": 10
    },
    "talks": [
        {
            "talkId": "6959101",
            "initDialog": "695910101",
            "dialogues": [
                {
                    "id": "695910101",
                    "speaker": "鹿野院平藏",
                    "text": "这么多人玩牌？嗯…不会有人借玩牌为名，做些不法勾当吧…咳，我开玩笑的，开玩笑的。"
                }
            ]
        },
        {
            "talkId": "6959102",
            "initDialog": "695910201",
            "dialogues": [
                {
                    "id": "695910201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959103",
            "initDialog": "695910301",
            "dialogues": [
                {
                    "id": "695910301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "695910302",
                    "speaker": "鹿野院平藏",
                    "text": "行啊，那一起走吧，我要是再不回去，案件卷宗只怕又要堆成山了。"
                }
            ]
        },
        {
            "talkId": "6959104",
            "initDialog": "695910401",
            "dialogues": [
                {
                    "id": "695910401",
                    "speaker": "鹿野院平藏",
                    "text": "总算赢下来了，呼啊…我得承认，在「七圣召唤」这游戏里，有时候运气确实是一条重要的制胜条件…"
                }
            ]
        },
        {
            "talkId": "6959105",
            "initDialog": "695910501",
            "dialogues": [
                {
                    "id": "695910501",
                    "speaker": "鹿野院平藏",
                    "text": "好吧，我输了。唉…一直抽不到那张关键牌，我的直觉和推理都派不上用场，可惜可惜。"
                }
            ]
        },
        {
            "talkId": "6959106",
            "initDialog": "695910601",
            "dialogues": [
                {
                    "id": "695910601",
                    "speaker": "鹿野院平藏",
                    "text": "行啊，我正好有空，就陪你玩两局吧。"
                }
            ]
        },
        {
            "talkId": "6959108",
            "initDialog": "695910801",
            "dialogues": [
                {
                    "id": "695910801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959109",
            "initDialog": "695910901",
            "dialogues": [
                {
                    "id": "695910901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959110",
            "initDialog": "695911001",
            "dialogues": [
                {
                    "id": "695911001",
                    "speaker": "鹿野院平藏",
                    "text": "没想到，我自己琢磨出的卡组，还挺厉害的。想看看？行啊，我们俩交换牌组，再来一局。"
                }
            ]
        },
        {
            "talkId": "6959111",
            "initDialog": "695911101",
            "dialogues": [
                {
                    "id": "695911101",
                    "speaker": "鹿野院平藏",
                    "text": "唉，我自己琢磨出来的这个卡组，怎么感觉乱七八糟的…啊！我知道问题出在哪里了…"
                }
            ]
        },
        {
            "talkId": "6959112",
            "initDialog": "695911201",
            "dialogues": [
                {
                    "id": "695911201",
                    "speaker": "鹿野院平藏",
                    "text": "好啊，许久不打牌，我正好也手痒了。不过，玩牌归玩牌，我们就不挂「彩头」了，免得玩得不开心。"
                }
            ]
        },
        {
            "talkId": "6959114",
            "initDialog": "695911401",
            "dialogues": [
                {
                    "id": "695911401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6959115",
            "initDialog": "695911501",
            "dialogues": [
                {
                    "id": "695911501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6959116",
            "initDialog": "695911601",
            "dialogues": [
                {
                    "id": "695911601",
                    "speaker": "鹿野院平藏",
                    "text": "看来我打牌的技艺还没有生疏嘛。想要再来一把吗？我随时陪你。"
                }
            ]
        },
        {
            "talkId": "6959117",
            "initDialog": "695911701",
            "dialogues": [
                {
                    "id": "695911701",
                    "speaker": "鹿野院平藏",
                    "text": "许久不打牌，我的牌技还是生疏了。下次办完案子之后，我也多花点时间在「七圣召唤」上吧…"
                }
            ]
        },
        {
            "talkId": "6959118",
            "initDialog": "695911801",
            "dialogues": [
                {
                    "id": "695911801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}