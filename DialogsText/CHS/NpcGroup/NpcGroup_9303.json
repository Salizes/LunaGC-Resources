{
    "groupId": "9303",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "丽莎": 9
    },
    "talks": [
        {
            "talkId": "6930301",
            "initDialog": "693030101",
            "dialogues": [
                {
                    "id": "693030101",
                    "speaker": "丽莎",
                    "text": "能舒舒服服地偷懒，不去挂念那些打打杀杀的事情，这样的时光十分难得。"
                },
                {
                    "id": "693030102",
                    "speaker": "丽莎",
                    "text": "不过，一个人发呆也会无聊呢。"
                },
                {
                    "id": "693030103",
                    "speaker": "丽莎",
                    "text": "小可爱，要不要陪姐姐一会儿？我可以给你讲故事哦。"
                }
            ]
        },
        {
            "talkId": "6930302",
            "initDialog": "693030201",
            "dialogues": [
                {
                    "id": "693030201",
                    "speaker": "丽莎",
                    "text": "小可爱，要继续深入秘境吗？只怕会遇到越来越烦人的怪物哟。"
                },
                {
                    "id": "693030202",
                    "speaker": "丽莎",
                    "text": "倒也不用太担心，姐姐看过的书很多，对怪物的弱点了如指掌。"
                },
                {
                    "id": "693030203",
                    "speaker": "丽莎",
                    "text": "想要管教它们的话，就叫我帮忙吧。"
                }
            ]
        },
        {
            "talkId": "6930303",
            "initDialog": "693030301",
            "dialogues": [
                {
                    "id": "693030301",
                    "speaker": "丽莎",
                    "text": "被浓缩成文字的「知识」，受限于撰写者本身的视野和偏好。"
                },
                {
                    "id": "693030302",
                    "speaker": "丽莎",
                    "text": "想要获得关于这片奇妙空间的「真相」，最后还是得麻烦自己。"
                },
                {
                    "id": "693030303",
                    "speaker": "丽莎",
                    "text": "但话说回来，能和小可爱共同在此探索，已经是姐姐我的幸运了哦。"
                }
            ]
        }
    ]
}