{
    "groupId": "2154",
    "total_dialogue_lines": 54,
    "speaker_counts": {
        "Player": 21,
        "塔列辛": 26,
        "派蒙": 7
    },
    "talks": [
        {
            "talkId": "6215401",
            "initDialog": "621540101",
            "dialogues": [
                {
                    "id": "621540101",
                    "speaker": "塔列辛",
                    "text": "抱歉…我有点头晕，不过我还能挺得住的！欸哟…嘶…"
                }
            ]
        },
        {
            "talkId": "6215402",
            "initDialog": "621540201",
            "dialogues": [
                {
                    "id": "621540201",
                    "speaker": "Player",
                    "text": "你来这里做什么？"
                },
                {
                    "id": "621540202",
                    "speaker": "塔列辛",
                    "text": "我是老派吟游诗人嘛，当然是来这里寻找灵感。"
                },
                {
                    "id": "621540203",
                    "speaker": "塔列辛",
                    "text": "不过，我又没下过矿…再加上…就是之前来的时候急匆匆的，有点…抻着筋了。"
                },
                {
                    "id": "621540204",
                    "speaker": "塔列辛",
                    "text": "嗨呀好痛…"
                }
            ]
        },
        {
            "talkId": "6215403",
            "initDialog": "621540301",
            "dialogues": [
                {
                    "id": "621540301",
                    "speaker": "Player",
                    "text": "不打扰你了…"
                },
                {
                    "id": "621540302",
                    "speaker": "塔列辛",
                    "text": "啊，慢走，有新故事的话还请告诉我！"
                }
            ]
        },
        {
            "talkId": "7104115",
            "initDialog": "710411501",
            "dialogues": [
                {
                    "id": "710411501",
                    "speaker": "塔列辛",
                    "text": "#我们又重逢了！「金发的{NICKNAME}！」",
                    "choices": [
                        {
                            "id": "710411502",
                            "text": "塔列辛，你是要与我决斗吗？",
                            "response": [
                                {
                                    "id": "710411503",
                                    "speaker": "派蒙",
                                    "text": "你突然在犯什么病呀！"
                                },
                                {
                                    "id": "710411505",
                                    "speaker": "塔列辛",
                                    "text": "哈哈，我是来寻求灵感的！咳咳，你看…失去了过去、从未有族名的英雄！和忠诚的精灵侍从！"
                                },
                                {
                                    "id": "710411506",
                                    "speaker": "派蒙",
                                    "text": "谁呀…？"
                                },
                                {
                                    "id": "710411507",
                                    "speaker": "Player",
                                    "text": "谁啊…？"
                                },
                                {
                                    "id": "710411508",
                                    "speaker": "塔列辛",
                                    "text": "哦，看呐，看呐，谦逊的英雄，不要向遥远的山边投去迷惘的目光，在这黑暗的地下，你自盛放灼目的光芒！"
                                },
                                {
                                    "id": "710411509",
                                    "speaker": "派蒙",
                                    "text": "啊…？"
                                },
                                {
                                    "id": "710411510",
                                    "speaker": "Player",
                                    "text": "啥…？"
                                },
                                {
                                    "id": "710411511",
                                    "speaker": "塔列辛",
                                    "text": "就是你呀，我现成的写作模板。"
                                },
                                {
                                    "id": "710411512",
                                    "speaker": "Player",
                                    "text": "哦…"
                                },
                                {
                                    "id": "710411513",
                                    "speaker": "派蒙",
                                    "text": "什么嘛…原来这家伙是会说人话的呀。"
                                },
                                {
                                    "id": "710411514",
                                    "speaker": "Player",
                                    "text": "再见。"
                                },
                                {
                                    "id": "710411515",
                                    "speaker": "塔列辛",
                                    "text": "#再会了，「金发的{NICKNAME}！」"
                                }
                            ]
                        },
                        {
                            "id": "710411504",
                            "text": "你在这里做什么？"
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "7108019",
            "initDialog": "710801901",
            "dialogues": [
                {
                    "id": "710801901",
                    "speaker": "Player",
                    "text": "抱歉，暂时没有新的故事。"
                },
                {
                    "id": "710801902",
                    "speaker": "塔列辛",
                    "text": "这样啊…嗯，没关系的，接下来的冒险中如果有什么新的故事，还请告诉我吧！"
                }
            ]
        },
        {
            "talkId": "7108020",
            "initDialog": "710802001",
            "dialogues": [
                {
                    "id": "710802001",
                    "speaker": "Player",
                    "text": "抱歉，暂时没有新的故事。"
                },
                {
                    "id": "710802002",
                    "speaker": "塔列辛",
                    "text": "这样啊…没关系啦，冒险的旅程无穷无尽，故事也是不会有尽头的。"
                }
            ]
        },
        {
            "talkId": "7108801",
            "initDialog": "710880101",
            "dialogues": [
                {
                    "id": "710880101",
                    "speaker": "塔列辛",
                    "text": "…不对，不应该是这样…按照族谱来讲的话…"
                },
                {
                    "id": "710880102",
                    "speaker": "塔列辛",
                    "text": "啊？哦！抱歉，刚刚没有注意到你在这里！",
                    "choices": [
                        {
                            "id": "710880103",
                            "text": "你…",
                            "response": [
                                {
                                    "id": "710880105",
                                    "speaker": "塔列辛",
                                    "text": "#{M#嘘…！嘘！咳咳…他来了！他来了！宝剑锃亮如银月，脚步坚定胜万军！他就是——}{F#嘘…！嘘！咳咳…她来了！她来了！明眸闪闪如满月，兵甲坚利毋可敌！她就是——}"
                                },
                                {
                                    "id": "710880106",
                                    "speaker": "派蒙",
                                    "text": "金——毛——人——！",
                                    "choices": [
                                        {
                                            "id": "710880107",
                                            "text": "喂！",
                                            "response": [
                                                {
                                                    "id": "710880109",
                                                    "speaker": "派蒙",
                                                    "text": "嘿嘿…出于惯性就不小心脱口而出了嘛…",
                                                    "choices": [
                                                        {
                                                            "id": "710880110",
                                                            "text": "这是哪门子惯性…",
                                                            "response": [
                                                                {
                                                                    "id": "710880112",
                                                                    "speaker": "派蒙",
                                                                    "text": "对哦…不够难听呢…"
                                                                },
                                                                {
                                                                    "id": "710880113",
                                                                    "speaker": "Player",
                                                                    "text": "喂——"
                                                                },
                                                                {
                                                                    "id": "710880114",
                                                                    "speaker": "塔列辛",
                                                                    "text": "哈哈哈哈哈！派蒙说得好！"
                                                                },
                                                                {
                                                                    "id": "710880115",
                                                                    "speaker": "塔列辛",
                                                                    "text": "#…{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_MALE_PRONOUN_SHE]}就是——「金发的{NICKNAME}」！"
                                                                },
                                                                {
                                                                    "id": "710880116",
                                                                    "speaker": "Player",
                                                                    "text": "请不要擅自给我起难听的绰号。"
                                                                },
                                                                {
                                                                    "id": "710880117",
                                                                    "speaker": "塔列辛",
                                                                    "text": "抱歉，抱歉…我完全没有冒犯的意思。只是…比较「老派」的蒙德诗人都是这样的。"
                                                                },
                                                                {
                                                                    "id": "710880118",
                                                                    "speaker": "Player",
                                                                    "text": "「老派」…？"
                                                                },
                                                                {
                                                                    "id": "710880119",
                                                                    "speaker": "塔列辛",
                                                                    "text": "哈哈，当然不是《蒲公英牧歌》那种老派民谣，也不是《婚姻的骗子我恨你》那种老派爱情诗…"
                                                                },
                                                                {
                                                                    "id": "710880120",
                                                                    "speaker": "塔列辛",
                                                                    "text": "我说的是，老派吟游史诗。"
                                                                },
                                                                {
                                                                    "id": "710880121",
                                                                    "speaker": "Player",
                                                                    "text": "那是什么？"
                                                                },
                                                                {
                                                                    "id": "710880122",
                                                                    "speaker": "塔列辛",
                                                                    "text": "简单来说，就是以英雄族谱为基准，在历史的坚实骨架上添加肌肉与皮肤的创作。"
                                                                },
                                                                {
                                                                    "id": "710880123",
                                                                    "speaker": "塔列辛",
                                                                    "text": "用长篇叙事诗歌来歌咏历史，唤醒人们对历史的认识。你看，这就是史诗的价值所在。"
                                                                },
                                                                {
                                                                    "id": "710880124",
                                                                    "speaker": "塔列辛",
                                                                    "text": "而唤醒历史意识的作用，也正是千百年前大贵族们禁止诗歌的原因。"
                                                                },
                                                                {
                                                                    "id": "710880125",
                                                                    "speaker": "塔列辛",
                                                                    "text": "因为他们害怕我们记忆起曾经自由，曾经抗争的过去。"
                                                                },
                                                                {
                                                                    "id": "710880126",
                                                                    "speaker": "塔列辛",
                                                                    "text": "而这，也是我蔑视如今的流行诗歌，意图复兴「老派史诗」的理由。"
                                                                },
                                                                {
                                                                    "id": "710880127",
                                                                    "speaker": "Player",
                                                                    "text": "哦，再见。"
                                                                },
                                                                {
                                                                    "id": "710880128",
                                                                    "speaker": "塔列辛",
                                                                    "text": "#呃…好，嗯…再会了，「金发的{NICKNAME}」！"
                                                                }
                                                            ]
                                                        },
                                                        {
                                                            "id": "710880111",
                                                            "text": "况且一点也没有创意。"
                                                        }
                                                    ]
                                                }
                                            ]
                                        },
                                        {
                                            "id": "710880108",
                                            "text": "派蒙！"
                                        }
                                    ]
                                }
                            ]
                        },
                        {
                            "id": "710880104",
                            "text": "我是…"
                        }
                    ]
                }
            ]
        }
    ]
}