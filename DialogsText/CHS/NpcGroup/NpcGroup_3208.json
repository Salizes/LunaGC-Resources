{
    "groupId": "3208",
    "total_dialogue_lines": 30,
    "speaker_counts": {
        "Player": 10,
        "千世": 20
    },
    "talks": [
        {
            "talkId": "6320801",
            "initDialog": "632080101",
            "dialogues": [
                {
                    "id": "632080101",
                    "speaker": "千世",
                    "text": "啧。走私的管道也没什么情报吗…"
                },
                {
                    "id": "632080102",
                    "speaker": "千世",
                    "text": "你有什么事？游客的话，找远国监司的人去。"
                }
            ]
        },
        {
            "talkId": "6320802",
            "initDialog": "632080201",
            "dialogues": [
                {
                    "id": "632080201",
                    "speaker": "Player",
                    "text": "百代小姐？"
                },
                {
                    "id": "632080202",
                    "speaker": "千世",
                    "text": "谁？你认错人了。"
                }
            ]
        },
        {
            "talkId": "6320803",
            "initDialog": "632080301",
            "dialogues": [
                {
                    "id": "632080301",
                    "speaker": "Player",
                    "text": "好的，再见。"
                },
                {
                    "id": "632080302",
                    "speaker": "千世",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6320804",
            "initDialog": "632080401",
            "dialogues": [
                {
                    "id": "632080401",
                    "speaker": "Player",
                    "text": "不好意思，我认错人了。再见。"
                },
                {
                    "id": "632080402",
                    "speaker": "千世",
                    "text": "再见。"
                }
            ]
        },
        {
            "talkId": "6320805",
            "initDialog": "632080501",
            "dialogues": [
                {
                    "id": "632080501",
                    "speaker": "Player",
                    "text": "不好意思。你现在叫什么？"
                },
                {
                    "id": "632080502",
                    "speaker": "千世",
                    "text": "你什么意思…"
                },
                {
                    "id": "632080503",
                    "speaker": "千世",
                    "text": "……"
                },
                {
                    "id": "632080504",
                    "speaker": "千世",
                    "text": "…真是的，果然还是瞒不过你啊。现在叫我「千世」就好。"
                }
            ]
        },
        {
            "talkId": "6320806",
            "initDialog": "632080601",
            "dialogues": [
                {
                    "id": "632080601",
                    "speaker": "Player",
                    "text": "千世小姐，有新任务吗？"
                },
                {
                    "id": "632080602",
                    "speaker": "千世",
                    "text": "…也罢，就告诉你吧，当还你一个人情。哼，毕竟你也四处与愚人众为敌，留个心眼也好。"
                },
                {
                    "id": "632080603",
                    "speaker": "千世",
                    "text": "我还在调查那个「老师」的事情。我们在海祇岛抓到了他的亲信，经过「说服」之后，他提供了一些有趣的情报。"
                },
                {
                    "id": "632080604",
                    "speaker": "千世",
                    "text": "「老师」原本是「壁炉之家」的教官。在「仆人」换代以后，他带领一些不知情的手下脱离，依照前任的方针继续行动。"
                }
            ]
        },
        {
            "talkId": "6320807",
            "initDialog": "632080701",
            "dialogues": [
                {
                    "id": "632080701",
                    "speaker": "Player",
                    "text": "关于柳达希卡…"
                },
                {
                    "id": "632080702",
                    "speaker": "千世",
                    "text": "「柳达希卡」？我可不记得那种名字。「玄冬林檎」才对吧。"
                },
                {
                    "id": "632080703",
                    "speaker": "千世",
                    "text": "那些破纸片儿的事情，她处理得还好吧？"
                }
            ]
        },
        {
            "talkId": "6320808",
            "initDialog": "632080801",
            "dialogues": [
                {
                    "id": "632080801",
                    "speaker": "Player",
                    "text": "换代？"
                },
                {
                    "id": "632080802",
                    "speaker": "千世",
                    "text": "几年前，前任「仆人」与「壁炉之家」的某个孩子之间似乎爆发了很严重的冲突。结果就是被那个后来者取而代之了。"
                },
                {
                    "id": "632080803",
                    "speaker": "千世",
                    "text": "当然，这是假定我们抓到的人供述属实的情况。愚人众说的话，哪有一句能信的。"
                }
            ]
        },
        {
            "talkId": "6320809",
            "initDialog": "632080901",
            "dialogues": [
                {
                    "id": "632080901",
                    "speaker": "Player",
                    "text": "不知情？"
                },
                {
                    "id": "632080902",
                    "speaker": "千世",
                    "text": "「老师」一边假借「仆人」之名稳住手下，一边在各国活动。但他的目的与当前的所属关系并不明朗。"
                },
                {
                    "id": "632080903",
                    "speaker": "千世",
                    "text": "他在稻妻应该还留下了一些「钉子」。我现在的目标就是找出剩下的钉子，一个不剩全部拔掉。"
                }
            ]
        },
        {
            "talkId": "6320810",
            "initDialog": "632081001",
            "dialogues": [
                {
                    "id": "632081001",
                    "speaker": "Player",
                    "text": "神社的工作，她做得很好。"
                },
                {
                    "id": "632081002",
                    "speaker": "千世",
                    "text": "哼。那就好。她比我适合多了。"
                },
                {
                    "id": "632081003",
                    "speaker": "千世",
                    "text": "倒是你，照顾好自己，还有那个白色的小东西。别总卷进危险的事情里。要不然，「玄冬林檎」会伤心的。"
                }
            ]
        },
        {
            "talkId": "6320811",
            "initDialog": "632081101",
            "dialogues": [
                {
                    "id": "632081101",
                    "speaker": "Player",
                    "text": "希望一切顺利。"
                },
                {
                    "id": "632081102",
                    "speaker": "千世",
                    "text": "哼，与其祝福我，你还是照顾好自己再说吧。别总一头扎进危险的事情里。要不然，有人会伤心的。"
                }
            ]
        }
    ]
}