{
    "groupId": "2303",
    "total_dialogue_lines": 18,
    "speaker_counts": {
        "Player": 5,
        "小星": 13
    },
    "talks": [
        {
            "talkId": "6230301",
            "initDialog": "623030101",
            "dialogues": [
                {
                    "id": "623030101",
                    "speaker": "小星",
                    "text": "你知道想成为冒险家最重要的是什么吗？"
                }
            ]
        },
        {
            "talkId": "6230302",
            "initDialog": "623030201",
            "dialogues": [
                {
                    "id": "623030201",
                    "speaker": "Player",
                    "text": "让我想想…"
                },
                {
                    "id": "623030202",
                    "speaker": "小星",
                    "text": "嗯！冒险家最需要什么呢？",
                    "choices": [
                        {
                            "id": "623030203",
                            "text": "勇气。",
                            "response": [
                                {
                                    "id": "623030204",
                                    "speaker": "小星",
                                    "text": "果然是勇气，冒险家永远不知道自己会面对什么，勇气肯定是不能少的。"
                                },
                                {
                                    "id": "623030205",
                                    "speaker": "小星",
                                    "text": "我还没有一个人出过村子，但我已经是男子汉了，我…我一点都不害怕。"
                                },
                                {
                                    "id": "623030206",
                                    "speaker": "小星",
                                    "text": "要成为伟大的冒险家这是必须迈出去的一步，嗯！"
                                }
                            ]
                        },
                        {
                            "id": "623030207",
                            "text": "神之眼。",
                            "response": [
                                {
                                    "id": "623030208",
                                    "speaker": "小星",
                                    "text": "和小六说的一样，果然神之眼是必不可少的啊。"
                                },
                                {
                                    "id": "623030209",
                                    "speaker": "小星",
                                    "text": "只要拥有了神之眼就无所不能，不仅能战胜很强大的怪物，还能有很多很多钱…"
                                },
                                {
                                    "id": "623030210",
                                    "speaker": "小星",
                                    "text": "那样的话爸爸妈妈就不用出去工作，大家都能留在村子里，村子就会变得和以前一样热闹了，就像小六讲的那样！"
                                }
                            ]
                        },
                        {
                            "id": "623030211",
                            "text": "派蒙。",
                            "response": [
                                {
                                    "id": "623030212",
                                    "speaker": "小星",
                                    "text": "派蒙？派蒙是什么，没人告诉过我。"
                                },
                                {
                                    "id": "623030213",
                                    "speaker": "小星",
                                    "text": "我是很认真问的，你不是在敷衍我吧？"
                                },
                                {
                                    "id": "623030214",
                                    "speaker": "小星",
                                    "text": "哦，难道说…是一种吃的？"
                                },
                                {
                                    "id": "623030215",
                                    "speaker": "小星",
                                    "text": "确实呢，冒险路上可不能饿着肚子。"
                                }
                            ]
                        }
                    ]
                }
            ]
        },
        {
            "talkId": "6230303",
            "initDialog": "623030301",
            "dialogues": [
                {
                    "id": "623030301",
                    "speaker": "Player",
                    "text": "我也不知道。"
                },
                {
                    "id": "623030302",
                    "speaker": "小星",
                    "text": "唉，好吧，看来还是小六知道得更多……"
                }
            ]
        }
    ]
}