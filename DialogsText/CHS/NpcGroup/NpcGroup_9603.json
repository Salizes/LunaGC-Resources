{
    "groupId": "9603",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 7,
        "爱诺": 10
    },
    "talks": [
        {
            "talkId": "6960301",
            "initDialog": "696030101",
            "dialogues": [
                {
                    "id": "696030101",
                    "speaker": "爱诺",
                    "text": "…如果能有更多数据的话，我可以试着给伊涅芙升级一下卡牌游戏对战模块…嗯——不过身为开明的家长，首先我还是先去问问伊涅芙需不需要这方面的升级好了…"
                }
            ]
        },
        {
            "talkId": "6960302",
            "initDialog": "696030201",
            "dialogues": [
                {
                    "id": "696030201",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960303",
            "initDialog": "696030301",
            "dialogues": [
                {
                    "id": "696030301",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                },
                {
                    "id": "696030302",
                    "speaker": "爱诺",
                    "text": "欸…？你这就要走了吗…？那好吧…下次我们工坊再见吧！我又发明了一些新的机械，都很有意思！你肯定也会觉得好玩的，所以一定要来哦！"
                }
            ]
        },
        {
            "talkId": "6960304",
            "initDialog": "696030401",
            "dialogues": [
                {
                    "id": "696030401",
                    "speaker": "爱诺",
                    "text": "好欸！赢了！本次对战给胜利者的奖品是——铛铛！蛋卷一碟！我开动了！"
                }
            ]
        },
        {
            "talkId": "6960305",
            "initDialog": "696030501",
            "dialogues": [
                {
                    "id": "696030501",
                    "speaker": "爱诺",
                    "text": "唔，是我输了。想要的牌都没能抽到…运气好差呀。我刚刚是不是该让咔哒咔哒帮我抽卡？或者做个全自动抽卡机，是不是就能避免掉手气差的问题了？"
                }
            ]
        },
        {
            "talkId": "6960306",
            "initDialog": "696030601",
            "dialogues": [
                {
                    "id": "696030601",
                    "speaker": "爱诺",
                    "text": "上次淘金小弟们帮忙在废旧物品堆中找到了一些卡牌，听说这游戏现在很流行，所以我也凑了一个卡组。太好了，现在就派上用场了！"
                }
            ]
        },
        {
            "talkId": "6960308",
            "initDialog": "696030801",
            "dialogues": [
                {
                    "id": "696030801",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960309",
            "initDialog": "696030901",
            "dialogues": [
                {
                    "id": "696030901",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960310",
            "initDialog": "696031001",
            "dialogues": [
                {
                    "id": "696031001",
                    "speaker": "爱诺",
                    "text": "#胜利者是——爱诺！现在是奖励时间！爱诺决定奖励自己再和{NICKNAME}玩一局！"
                }
            ]
        },
        {
            "talkId": "6960311",
            "initDialog": "696031101",
            "dialogues": [
                {
                    "id": "696031101",
                    "speaker": "爱诺",
                    "text": "输、输掉了？没事！机械都是在拆拆装装中完成的，所以卡牌技术肯定也是在输输赢赢中提高的~"
                }
            ]
        },
        {
            "talkId": "6960312",
            "initDialog": "696031201",
            "dialogues": [
                {
                    "id": "696031201",
                    "speaker": "爱诺",
                    "text": "哇！你又来陪我玩啦！我又收集到了几张旧的卡牌，不管新旧，只要能凑成卡组，就是好牌！"
                }
            ]
        },
        {
            "talkId": "6960314",
            "initDialog": "696031401",
            "dialogues": [
                {
                    "id": "696031401",
                    "speaker": "Player",
                    "text": "进行「七圣召唤」的对局吧。"
                }
            ]
        },
        {
            "talkId": "6960315",
            "initDialog": "696031501",
            "dialogues": [
                {
                    "id": "696031501",
                    "speaker": "Player",
                    "text": "先调整一下卡组…"
                }
            ]
        },
        {
            "talkId": "6960316",
            "initDialog": "696031601",
            "dialogues": [
                {
                    "id": "696031601",
                    "speaker": "爱诺",
                    "text": "赢了？太好啦！其实我来之前和伊涅芙打赌了，如果我赢了今晚就有两份饭后甜点！反之我就要吃两份蔬菜杯了。嘿嘿，我分你一份甜点吧！"
                }
            ]
        },
        {
            "talkId": "6960317",
            "initDialog": "696031701",
            "dialogues": [
                {
                    "id": "696031701",
                    "speaker": "爱诺",
                    "text": "欸？居然输了…一定是今天吃的蛋卷太少了，所以爱诺脑子转不动了！待会儿我们一起去找伊涅芙要蛋卷吧！嗯——就当是你获胜的奖励，还有我落败的安慰啦。"
                }
            ]
        },
        {
            "talkId": "6960318",
            "initDialog": "696031801",
            "dialogues": [
                {
                    "id": "696031801",
                    "speaker": "Player",
                    "text": "暂时有别的事…"
                }
            ]
        }
    ]
}