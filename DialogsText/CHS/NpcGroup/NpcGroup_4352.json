{
    "groupId": "4352",
    "total_dialogue_lines": 14,
    "speaker_counts": {
        "Player": 4,
        "阿布丁": 10
    },
    "talks": [
        {
            "talkId": "6435201",
            "initDialog": "643520101",
            "dialogues": [
                {
                    "id": "643520101",
                    "speaker": "阿布丁",
                    "text": "只要能避开巡林员…"
                }
            ]
        },
        {
            "talkId": "6435202",
            "initDialog": "643520201",
            "dialogues": [
                {
                    "id": "643520201",
                    "speaker": "Player",
                    "text": "你在计划什么？"
                },
                {
                    "id": "643520202",
                    "speaker": "阿布丁",
                    "text": "身为冒险家，最大的计划肯定就是踏遍脚下的每一寸土地，探索这个世界的每一个秘密啦！"
                },
                {
                    "id": "643520203",
                    "speaker": "阿布丁",
                    "text": "所以从眼下的目标来看，我决定第一个来征服道成林！"
                }
            ]
        },
        {
            "talkId": "6435203",
            "initDialog": "643520301",
            "dialogues": [
                {
                    "id": "643520301",
                    "speaker": "Player",
                    "text": "再见。"
                },
                {
                    "id": "643520302",
                    "speaker": "阿布丁",
                    "text": "再见！下次再见面，没准就是在别的地方咯！"
                }
            ]
        },
        {
            "talkId": "6435204",
            "initDialog": "643520401",
            "dialogues": [
                {
                    "id": "643520401",
                    "speaker": "Player",
                    "text": "第一个…"
                },
                {
                    "id": "643520402",
                    "speaker": "阿布丁",
                    "text": "咳咳，怎么啦！我承认，我还只是个初出茅庐的新人，但新人总要迈出第一步的，对不对？"
                },
                {
                    "id": "643520403",
                    "speaker": "阿布丁",
                    "text": "听人说，雨林中有好多可爱的蕈兽，还有小巧的林猫，还有神秘的宝藏…"
                },
                {
                    "id": "643520404",
                    "speaker": "阿布丁",
                    "text": "嘿嘿嘿，听上去就很有意思！"
                },
                {
                    "id": "643520405",
                    "speaker": "阿布丁",
                    "text": "现在拦在我和伟大冒险面前的唯一阻拦，就是那些烦人的巡林员了。只要能避开他们，我就可以…"
                }
            ]
        },
        {
            "talkId": "7396501",
            "initDialog": "739650101",
            "dialogues": [
                {
                    "id": "739650101",
                    "speaker": "Player",
                    "text": "劝你放弃…"
                },
                {
                    "id": "739650102",
                    "speaker": "阿布丁",
                    "text": "你要是这样想，可就太不「冒险家」。"
                },
                {
                    "id": "739650103",
                    "speaker": "阿布丁",
                    "text": "听好，一定要心怀梦想，勇于尝试，才能成为最伟大的冒险家！"
                }
            ]
        }
    ]
}