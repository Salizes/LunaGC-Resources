{
    "groupId": "9390",
    "total_dialogue_lines": 9,
    "speaker_counts": {
        "蓝砚": 9
    },
    "talks": [
        {
            "talkId": "6939001",
            "initDialog": "693900101",
            "dialogues": [
                {
                    "id": "693900101",
                    "speaker": "蓝砚",
                    "text": "你知道吗？太阳出来前的八个小时是第二好的休息时机。"
                },
                {
                    "id": "693900102",
                    "speaker": "蓝砚",
                    "text": "嗯？最好时机？"
                },
                {
                    "id": "693900103",
                    "speaker": "蓝砚",
                    "text": "当然是感到累的时候啊！无论何时何地，累了就马上休息吧，我就是这么做的。"
                }
            ]
        },
        {
            "talkId": "6939002",
            "initDialog": "693900201",
            "dialogues": [
                {
                    "id": "693900201",
                    "speaker": "蓝砚",
                    "text": "里边的魔物太狡猾了，好麻烦…要不要试着打破原先的战术，让它们措手不及？"
                },
                {
                    "id": "693900202",
                    "speaker": "蓝砚",
                    "text": "至于怎么调整嘛，你经验最多，我全听你安排！"
                },
                {
                    "id": "693900203",
                    "speaker": "蓝砚",
                    "text": "放心，我会配合你的策略…保证跟飞燕那样灵巧，绝不拖泥带水。"
                }
            ]
        },
        {
            "talkId": "6939003",
            "initDialog": "693900301",
            "dialogues": [
                {
                    "id": "693900301",
                    "speaker": "蓝砚",
                    "text": "尽管没有翻到想看的志怪小说，却有不少意外收获呢。"
                },
                {
                    "id": "693900302",
                    "speaker": "蓝砚",
                    "text": "你看啊，这些话本不管是插图还是行文风格都像是给小孩子看的…"
                },
                {
                    "id": "693900303",
                    "speaker": "蓝砚",
                    "text": "可是读完总觉得…唔，说不上来…不行，我要多读两遍…"
                }
            ]
        }
    ]
}