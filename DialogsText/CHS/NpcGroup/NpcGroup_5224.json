{
    "groupId": "5224",
    "total_dialogue_lines": 17,
    "speaker_counts": {
        "Player": 4,
        "布罗意": 13
    },
    "talks": [
        {
            "talkId": "6522401",
            "initDialog": "652240101",
            "dialogues": [
                {
                    "id": "652240101",
                    "speaker": "布罗意",
                    "text": "啊，您好！请问有什么事情是我可以帮您的吗？"
                }
            ]
        },
        {
            "talkId": "6522402",
            "initDialog": "652240201",
            "dialogues": [
                {
                    "id": "652240201",
                    "speaker": "Player",
                    "text": "关于水文研究…"
                },
                {
                    "id": "652240202",
                    "speaker": "布罗意",
                    "text": "不瞒您说，我和我那些令人敬佩的同事们已经以一种…呃…"
                },
                {
                    "id": "652240203",
                    "speaker": "布罗意",
                    "text": "连我们自己都感到惊讶的效率完成了数据的整理工作，报告也已经交上去了。"
                },
                {
                    "id": "652240204",
                    "speaker": "布罗意",
                    "text": "我们的部门主管非常爽快地同意了，看都没看就在我们的报告上画了一个圈，表示圈阅同意，提请上级酌定…"
                },
                {
                    "id": "652240205",
                    "speaker": "布罗意",
                    "text": "毕竟这种东西的审批，也不是主管一个人能够决定的嘛。"
                }
            ]
        },
        {
            "talkId": "6522403",
            "initDialog": "652240301",
            "dialogues": [
                {
                    "id": "652240301",
                    "speaker": "Player",
                    "text": "祝你顺利…"
                },
                {
                    "id": "652240302",
                    "speaker": "布罗意",
                    "text": "嗯嗯，也祝您一路顺风。"
                }
            ]
        },
        {
            "talkId": "6522404",
            "initDialog": "652240401",
            "dialogues": [
                {
                    "id": "652240401",
                    "speaker": "Player",
                    "text": "大概要多久？"
                },
                {
                    "id": "652240402",
                    "speaker": "布罗意",
                    "text": "嗯，如果快的话，大概要三个月左右吧？至于说，要是在这个过程中，不出意外地出了什么意外的话…那就不好说了。"
                },
                {
                    "id": "652240403",
                    "speaker": "布罗意",
                    "text": "您看，这样的申请，最后还是要拿到复律庭去盖章的。而那些先生们的效率…您应该也有所耳闻吧？"
                }
            ]
        },
        {
            "talkId": "6522405",
            "initDialog": "652240501",
            "dialogues": [
                {
                    "id": "652240501",
                    "speaker": "Player",
                    "text": "那你这是在…"
                },
                {
                    "id": "652240502",
                    "speaker": "布罗意",
                    "text": "如您所见，我正在认真履行自己的工作职责。"
                },
                {
                    "id": "652240503",
                    "speaker": "布罗意",
                    "text": "您看，部门主管已经批准了我的调任申请，那么从原则上来说…"
                },
                {
                    "id": "652240504",
                    "speaker": "布罗意",
                    "text": "我就不是「水文与水生物种综合保护科」的研究员了，自然也就不用再去办公室了。"
                },
                {
                    "id": "652240505",
                    "speaker": "布罗意",
                    "text": "另一方面，因为复律庭的审批结果还没下来，我现在也不能算是驻外水文观测站的工作人员…连部门都已经解散了嘛。"
                },
                {
                    "id": "652240506",
                    "speaker": "布罗意",
                    "text": "所以，由于客观条件限制，我现在就只能自己安排自己的工作了。唉，真是没办法…"
                }
            ]
        }
    ]
}